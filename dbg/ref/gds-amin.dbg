        1   DEFINE BUFFER x-gds-obj FOR gds-obj.
        2   DEFINE BUFFER x-gds-obj-prop FOR gds-obj-prop.
        3   DEFINE BUFFER x-goods FOR goods.
        4   define input parameter parParentProc AS WIDGET-HANDLE NO-UNDO.
        5   define input  parameter p-obj-type like ub.clients.obj-type no-undo .
        6   define input  parameter p-obj-code like ub.clients.obj-code no-undo .
        7   define input  parameter p-mode as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Ассортиментный минимум".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   procedure proc-alt-shift-f2:
       84     if not ibs.th.gbl.gbl-var:rcode
       85   then
       86     run gbl\inidebug.p .
       87   end.
       88   procedure proc-alt-shift-f3:
       89     run gbl/prvssinf.p
       90       ( input this-procedure
       91       ) .
       92   end.
       93   define variable v-inform-launched as logical no-undo initial false .
       94   procedure proc-alt-shift-f4:
       95     define variable v-action as character no-undo .
       96     if v-inform-launched = false then do:
       97       assign
       98         v-inform-launched = true
       99       .
      100       run gbl/d-inform.w
      101         (  input self
      102         ,  input this-procedure
      103         , output v-action
      104         ) no-error .
      105       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      106       assign
      107         v-inform-launched = false
      108       .
      109     end.
      110   end.
      111   procedure proc-alt-f1:
      112     run gbl/corrhelp.p
      113       (input this-procedure
      114       ) .
      115   end .
      116   on alt-shift-f2 anywhere do:
      117     run proc-alt-shift-f2.
      118   end.
      119   on alt-shift-f3 anywhere do:
      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      130   define new shared variable RepPathName        as character no-undo .
      131   define new shared variable PrintRubl          as logical   no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define variable v-waitfram-action01         as character   no-undo .
      134   define variable v-waitfram-action02         as character   no-undo .
      135   define variable v-waitfram-action03         as character   no-undo .
      136   define variable mWaitFramTextBeg            as character   no-undo.
      137   define variable mWaitFramTextEnd            as character   no-undo.
      138   define variable mWaitFramView               as logical     no-undo.
      139   define variable mWaitProcEvent              as logical     no-undo init yes.
      140   define variable mWaitFramInterval           as integer     no-undo init 1 .
      141   define variable mWaitFramStop               as logical     no-undo.
      142   define variable mWaitFramStopUser           as logical     no-undo.
      143   define variable mWaitFramStopTimeOut        as logical     no-undo.
      144   define variable mWaitFramStartProc          as datetime-tz no-undo.
      145   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      146   define button B-WaitFramStop auto-end-key
      147        label "Стоп"
      148        size 10 by 1 tooltip "Остоновить процесс".
      149   define button B-viewProcInfo
      150        label "Информация"
      151        size 15 by 1 tooltip "Информация о процесс".
      152   define frame waitfram
      153     v-waitfram-action01 format "x(72)" no-label skip
      154     v-waitfram-action02 format "x(72)" no-label skip
      155     v-waitfram-action03 format "x(72)" no-label skip
      156     B-viewProcInfo
      157     B-WaitFramStop at row 4 col 30
      158     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      159     .
      160   define new global shared variable mBatchMode as logical no-undo init ?.
      161   define variable mFramBachModHandle as handle no-undo.
      162   mFramBachModHandle = frame waitfram:handle.
      163   define variable mFameOldVis as logical no-undo.
      164   define variable mVisCUrentVin as logical no-undo.
      165   if session:batch-mode
      166   then
      167      mBatchMode = yes.
      168   if mBatchMode = ? then do:
      169     mVisCUrentVin = current-window:visible.
      170     mFameOldVis = mFramBachModHandle:visible.
      171     mFramBachModHandle:visible  = yes.
      172     mBatchMode = mFramBachModHandle:visible ne yes.
      173     mFramBachModHandle:visible = mFameOldVis.
      174     current-window:visible = mVisCUrentVin.
      175   end.
      176    if  log-manager:logfile-name ne ?
      177     then DO:
      178         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      179         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      180         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      181     end.
      182   on choose of B-WaitFramStop in frame waitfram
      183   do:
      184     mWaitFramStop = yes.
      185     mWaitFramStopUser = yes.
      186   end.
      187   function waitfram-check-timeout returns logical():
      188      define variable vtime as int64 no-undo.
      189      if mWaitFramStopTimeOut
      190      then
      191         return yes.
      192      vtime = ( now - mWaitFramStartProc ) / 1000 .
      193      if     mWaitFramTimeOut ne ?
      194         and mWaitFramTimeOut ne 0
      195         and mWaitFramTimeOut lt vtime
      196      then do:
      197         mWaitFramStopTimeOut = yes.
      198      end.
      199      return mWaitFramStopTimeOut.
      200   end.
      201   procedure waitfram-hide :
      202     if not session:batch-mode
      203     then do
      204     on error undo, return error return-value
      205     :
      206       pause 0 before-hide .
      207       if not mBatchMode then
      208         hide frame waitfram .
      209     if     not mWaitFramView
      210        and mWaitProcEvent
      211     then
      212       process events .
      213     end.
      214   end procedure.
      215   procedure waitfram-show :
      216     define input  parameter p-message as character no-undo .
      217     define variable v-left-margin as integer   no-undo .
      218     if not session:batch-mode
      219     then do
      220     on error undo, return error return-value
      221     :
      222       if length(p-message) <= 70 then do:
      223         assign
      224           v-left-margin = integer((70 - length(p-message)) / 2)
      225         .
      226         assign
      227           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      228         .
      229         assign
      230           v-waitfram-action01 = " "
      231           v-waitfram-action02 = " "
      232                                    + fill(" ", v-left-margin)
      233                                    + p-message
      234           v-waitfram-action03 = " "
      235         .
      236       end.
      237       else do:
      238         define variable vRindex1 as integer no-undo.
      239         define variable vRindex2 as integer no-undo.
      240         vRindex1 = r-index(p-message," ",70).
      241         if vRindex1 = 0
      242         then
      243            vRindex1 = 70.
      244         if length(p-message)  <= vRindex1 + 70 then do:
      245           assign
      246             v-waitfram-action01 = " "
      247             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      248             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      249           .
      250         end.
      251         else do:
      252           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      253           if vRindex2 <= vRindex1
      254           then
      255              vRindex2 = vRindex1 + 70.
      256           assign
      257             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      258             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      259             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      260           .
      261         end.
      262       end.
      263       B-viewProcInfo:visible   in frame waitfram = no.
      264       B-viewProcInfo:sensitive in frame waitfram = no.
      265       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      266       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      267       if  (   mWaitFramView
      268          or  mWaitProcEvent)
      269          and not mBatchMode
      270       then
      271          display
      272             v-waitfram-action01 skip
      273             v-waitfram-action02 skip
      274             v-waitfram-action03 skip
      275          with frame waitfram .
      276       if     mWaitFramView
      277          then do:
      278             if     mWaitFramInterval ne ?
      279                and not mBatchMode
      280             then
      281                wait-for go of frame waitfram pause mWaitFramInterval.
      282          end.
      283          else
      284             if     mWaitProcEvent
      285                and not mBatchMode
      286             then
      287                process events .
      288     end.
      289   end procedure.
      290      procedure waitfram-show-this:
      291         define input  parameter iInterval as int64 no-undo.
      292         define variable vtime as int64 no-undo.
      293         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      294         mWaitFramInterval = iInterval.
      295         run waitfram-show (substitute("&1&2 &3&4" ,
      296                                       mWaitFramTextBeg ,
      297                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      298                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      299                                       mWaitFramTextEnd
      300                                      )
      301                           ).
      302      end.
      303      procedure WaitFramRunPause:
      304         define input  parameter iInterval as dec no-undo.
      305         define variable vStart  as datetime-tz no-undo.
      306         define variable vend    as datetime-tz no-undo.
      307         define variable vint as int64 no-undo.
      308         define variable vOk as logical no-undo.
      309         vStart = now.
      310         vend   = vStart.
      311         publish "WaitFramPause" (iInterval,output vOk).
      312         vend   =  now.
      313         vint = vend - vStart.
      314         vint = iInterval - vint / 1000.
      315         if     not mWaitFramStop
      316            and (   vint > 0
      317                 or (    not vOk
      318                     and iInterval eq ?
      319                     )
      320                 )
      321         then
      322            run waitfram-show-this (iInterval).
      323         vend   =  now.
      324         vint = vend - vStart.
      325         vint = iInterval - vint / 1000.
      326         if     not mWaitFramStop
      327            and vint > 0
      328         then do:
      329            run gbl/pause.p (vint * 1000).
      330         end.
      331         if iInterval ne ?
      332         then
      333            publish "WaitFramStop".
      334         waitfram-check-timeout().
      335      end.
      336      procedure WaitFramWaitFor:
      337         define input  parameter iInterval as dec no-undo.
      338         assign
      339            mWaitFramStartProc   = now
      340            mWaitFramStopUser    = no
      341            mWaitFramStopTimeOut = no
      342         .
      343         block-wait:
      344         do while not mWaitFramStop:
      345            run WaitFramRunPause (iInterval).
      346            if  waitfram-check-timeout()
      347            then do:
      348               leave block-wait.
      349            end.
      350         end.
      351         run waitfram-hide.
      352      end.
      353   procedure waitfram-join :
      354     define input  parameter p-line-1  as character no-undo .
      355     define input  parameter p-line-2  as character no-undo .
      356     define input  parameter p-line-3  as character no-undo .
      357     define output parameter p-message as character no-undo .
      358     do
      359     on error undo, return error return-value
      360     :
      361       assign
      362         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      363                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      364                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      365       .
      366     end.
      367   end procedure.
      368   function waitfram-join-function returns character
      369     (input p-line-1 as character
      370     ,input p-line-2 as character
      371     ,input p-line-3 as character
      372     ).
      373     define variable v-message as character no-undo .
      374     run waitfram-join in this-procedure
      375       (input  p-line-1
      376       ,input  p-line-2
      377       ,input  p-line-3
      378       ,output v-message
      379       ) .
      380     return v-message .
      381   end function .
      382   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   define  stream PrnLibStream.
      384   procedure prn-lib-prn-file :
      385     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      386     define input parameter p-DIsabledoptions as integer no-undo .
      387     define variable v-report-name as character no-undo .
      388     define variable v-user-action as character no-undo .
      389     define variable v-printed     as logical   no-undo .
      390     define variable v-exist       as logical   no-undo .
      391     do
      392       on error undo, return error
      393       :
      394       run prn-lib-get-report-name  in this-procedure (
      395         input parParentProc
      396         ,output v-report-name
      397         ).
      398   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      400     (input  v-report-name
      401     ,input  2
      402     ,output v-exist
      403     )  .
      404       if NOT v-exist then
      405       DO:
      406         Message
      407           "Нет заданий на печать ! "
      408           view-as alert-box .
      409         Return  .
      410       End.
      411       run gbl/prnfilen.w
      412         (input  ""
      413         ,input  p-DisabledOptions
      414         ,input  string(v-report-name )
      415         ,input  7
      416         ,output v-user-action
      417         ,output v-printed
      418         ) .
      419       if v-printed then
      420       do:
      421         return "YES" .
      422       end.
      423       else
      424       do:
      425         return "NO" .
      426       end.
      427     end.
      428   end procedure.
      429   procedure prn-lib-open-stream :
      430     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      431     define input parameter p-page-size    as integer no-undo .
      432     define input parameter p-is-stream    as logical no-undo .
      433     define input parameter p-append       as logical no-undo .
      434     define variable v-report-name as character no-undo .
      435     do
      436       on error undo, return error
      437       :
      438       run prn-lib-get-report-name  in this-procedure (
      439         input parParentProc
      440         ,output v-report-name
      441         ).
      442       if p-is-stream then
      443       do:
      444         if p-append then
      445         do:
      446           output stream PrnLibStream to value( v-report-name )
      447             page-size value(p-page-size) append .
      448         end.
      449         if not p-append then
      450         do:
      451           output stream PrnLibStream to value( v-report-name )
      452             page-size value(p-page-size) .
      453         end.
      454       end.
      455       if not p-is-stream then
      456       do:
      457         if p-append then
      458         do:
      459           output to value( v-report-name )
      460             page-size value(p-page-size) append .
      461         end.
      462         if not p-append then
      463         do:
      464           output to value( v-report-name )
      465             page-size value(p-page-size) .
      466         end.
      467       end.
      468     end.
      469   end procedure.
      470   procedure prn-lib-open-exp :
      471     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      472     define input parameter p-is-stream    as logical no-undo .
      473     define input parameter p-is-append    as logical no-undo .
      474     define output parameter p-ReportFileName as char init "report" no-undo.
      475     define output parameter p-process as logical no-undo .
      476     define variable glog as logical no-undo .
      477     do
      478       on error undo, return error
      479       :
      480       SYSTEM-DIALOG GET-FILE p-ReportFileName
      481         TITLE      "Укажите путь"
      482         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      483         ASK-OVERWRITE
      484         CREATE-TEST-FILE
      485         SAVE-AS
      486         USE-FILENAME
      487         DEFAULT-EXTENSION "txt"
      488         UPDATE glog
      489         .
      490       if not glog then  return.
      491       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      492       if p-is-stream then
      493       do:
      494         if p-is-append then
      495         do:
      496           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      497         end.
      498         else
      499         do:
      500           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      501         end.
      502       end.
      503       else
      504       do:
      505         if p-is-append then
      506         do:
      507           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      508         end.
      509         else
      510         do:
      511           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      512         end.
      513       end.
      514       p-process = yes.
      515     end.
      516   end procedure.
      517   procedure prn-lib-get-report-name :
      518     define input parameter parParentProc  as widget-handle no-undo.
      519     define output parameter p-report-name as character no-undo .
      520     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      521   end procedure.
      522   procedure prn-lib-reportviewer-report-name :
      523     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      524     define input parameter p-report-name-html as character no-undo .
      525     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      526   end procedure.
      527   procedure prn-lib-reportviewer :
      528     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      529     define input parameter p-report-name-html as character no-undo .
      530     define input parameter p-param        as character no-undo .
      531     define variable v-excel           as character no-undo init 'TRUE' .
      532     define variable v-value-character as character no-undo .
      533     define variable v-value-integer   as character no-undo .
      534     define variable v-value-date      as date      no-undo .
      535     define variable v-value-decimal   as decimal   no-undo .
      536     define variable rep-excel         as logical   no-undo .
      537     define variable excel-string      as character no-undo .
      538     define variable v-param-type      as character no-undo .
      539     define variable v-tth             as handle    no-undo .
      540     run adm/shattri.p (
      541       input "get":U
      542       ,input  ""
      543       ,input  0
      544       ,input  'report-glob':U
      545       ,input  'rep-excel':U
      546       ,output v-value-character
      547       ,output v-value-date
      548       ,output v-value-decimal
      549       ,output v-value-integer
      550       ,output rep-excel
      551       ,output v-param-type
      552       ,INPUT-OUTPUT table-handle v-tth
      553       )  .
      554     if rep-excel then v-excel = "TRUE" .
      555     else v-excel = "FALSE" .
      556     if p-param eq ""
      557     then
      558        p-param = "EXCEL:" + v-excel.
      559     else
      560        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      561     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      562   end procedure.
      563   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      564   procedure cur-time :
      565      define output parameter p-today as date      no-undo .
      566      define output parameter p-time  as integer   no-undo .
      567     do
      568     on error undo, return error
      569     :
      570       define variable v-date1 as date      no-undo .
      571       define variable v-date2 as date      no-undo .
      572       define variable v-time  as integer   no-undo .
      573       assign
      574         v-date1 = today
      575         v-time  = time
      576         v-date2 = today
      577       .
      578       if v-date1 <> v-date2
      579       then do:
      580         assign
      581           v-date1 = today
      582           v-time  = v-time
      583         .
      584       end.
      585       assign
      586         p-today = v-date1
      587         p-time  = v-time
      588       .
      589     end.
      590   end.
      591   function cur-time-date returns character
      592   :
      593     return string(today, '99/99/9999':U) .
      594   end.
      595   function cur-time-mjd returns decimal
      596   :
      597     define variable v-date as date      no-undo .
      598     define variable v-time as integer   no-undo .
      599     run cur-time in this-procedure
      600       (output v-date
      601       ,output v-time
      602       ) .
      603     return integer(v-date) - 2400002 + (v-time / 86400) .
      604   end.
      605   function cur-time-get-ending-index returns integer
      606   (input p-number as integer
      607   )
      608   :
      609     if p-number < 0
      610     or p-number = ?
      611     then do:
      612       return 1 .
      613     end.
      614     define variable v-rest as integer   no-undo .
      615     assign
      616       p-number = p-number modulo 100
      617     .
      618     if p-number < 20
      619     then do:
      620       assign
      621         v-rest = p-number
      622       .
      623     end.
      624     else do:
      625       assign
      626         v-rest = p-number modulo 10
      627       .
      628     end.
      629     case v-rest :
      630       when 1
      631       then do:
      632         return 2 .
      633       end.
      634       when 2 or
      635       when 3 or
      636       when 4
      637       then do:
      638         return 3 .
      639       end.
      640       otherwise do:
      641         return 1 .
      642       end.
      643     end case .
      644   end.
      645   procedure cur-time-mjd-to-date :
      646      define input  parameter i-mjd-diff as decimal no-undo.
      647      define output parameter o-Date     as date    no-undo.
      648      define output parameter o-Time     as integer no-undo.
      649      define variable v-day-number as integer   no-undo .
      650      if    i-mjd-diff < 0
      651         or i-mjd-diff = ?
      652      then do:
      653         return "?" .
      654      end.
      655      assign
      656         v-day-number = truncate(i-mjd-diff,0).
      657         o-Date = date(v-day-number + 2400002).
      658         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      659     .
      660   end.
      661   function cur-time-mjd-to-string returns character
      662   (input p-mjd-diff as decimal
      663   )
      664   :
      665     define variable v-day-number as integer   no-undo .
      666     define variable v-seconds    as integer   no-undo .
      667     define variable v-hour       as integer   no-undo .
      668     define variable v-min        as integer   no-undo .
      669     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      670     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      671     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      672     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      673     if p-mjd-diff < 0
      674     or p-mjd-diff = ?
      675     then do:
      676       return "?" .
      677     end.
      678     assign
      679       v-day-number = integer(truncate(p-mjd-diff,0))
      680       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      681     .
      682     if v-seconds > 86400
      683     then do:
      684       assign
      685         v-seconds = 86400 - 1
      686       .
      687     end.
      688     if v-seconds < 0
      689     then do:
      690       assign
      691         v-seconds = 0
      692       .
      693     end.
      694     assign
      695       v-hour = truncate(v-seconds / 3600, 0)
      696     .
      697     assign
      698       v-seconds = v-seconds modulo 3600
      699     .
      700     assign
      701       v-min = truncate(v-seconds / 60, 0)
      702     .
      703     assign
      704       v-seconds = v-seconds modulo 60
      705     .
      706     return
      707         (if v-day-number <> 0
      708           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      709           else ""
      710         )
      711       + (if v-day-number <> 0 or v-hour <> 0
      712           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      713           else ""
      714         )
      715       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      716           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      717           else ""
      718         )
      719       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      720       .
      721   end.
      722   function cur-time-string returns character
      723   :
      724     define variable v-date as date      no-undo .
      725     define variable v-time as integer   no-undo .
      726     run cur-time in this-procedure
      727       (output v-date
      728       ,output v-time
      729       ) .
      730     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      731   end.
      732   function cur-time-string-sec returns character
      733   :
      734     define variable v-date as date      no-undo .
      735     define variable v-time as integer   no-undo .
      736     run cur-time in this-procedure
      737       (output v-date
      738       ,output v-time
      739       ) .
      740     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      741   end.
      742   function cur-time-custom  returns character
      743   (input p-prefix as character
      744   ,input p-date-format as character
      745   ,input p-delimiter as character
      746   ,input p-time-format as character
      747   ,input p-suffix as character
      748   )
      749   :
      750     define variable v-date as date      no-undo .
      751     define variable v-time as integer   no-undo .
      752     run cur-time in this-procedure
      753       (output v-date
      754       ,output v-time
      755       ) .
      756     return
      757       p-prefix
      758       + string(v-date, p-date-format)
      759       + p-delimiter
      760       + string(v-time, p-time-format)
      761       + p-suffix
      762       .
      763   end.
      764   function cur-time-print  returns character
      765   :
      766     define variable v-date as date      no-undo .
      767     define variable v-time as integer   no-undo .
      768     run cur-time in this-procedure
      769       (output v-date
      770       ,output v-time
      771       ) .
      772     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      773   end.
      774   function cur-time-datetime returns datetime
      775   :
      776     define variable v-char as character no-undo .
      777     define variable v-datetime as datetime no-undo .
      778     v-char = cur-time-string().
      779     v-datetime = datetime(v-char).
      780     return  v-datetime.
      781   end.
      782   function cur-time-string-msec returns character
      783   :
      784     define variable v-date as datetime  no-undo .
      785     v-date = now.
      786     return string(v-date) .
      787   end.
      788   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      790   procedure fltopend_fltopend :
      791   define input parameter p-parent-handle as handle no-undo .
      792   define input parameter p-qh as handle no-undo .
      793   define input parameter p-flt-open-open-query  as character no-undo .
      794   define input parameter p-where-cond as character no-undo .
      795   define input parameter p-use-indFIRST-query-tail as character no-undo .
      796   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      797   define input parameter p-indexed-reposition as character no-undo .
      798     do
      799     on error undo, return error
      800     :
      801   define variable v-prepare-string as character no-undo .
      802   define variable glog as logical no-undo .
      803   assign
      804   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      805                      p-where-cond + chr(32)  +
      806                      p-use-indFIRST-query-tail + chr(32) +
      807                      p-use-ind-sort-clmn-by + chr(32) +
      808                      p-indexed-reposition
      809   .
      810   assign
      811   glog = p-qh:query-prepare(v-prepare-string) no-error .
      812   if not glog
      813   or error-status:error then do:
      814     message error-status:get-message(1) view-as alert-box .
      815     undo, return error .
      816   end.
      817   assign
      818   glog = p-qh:query-open no-error .
      819   if not glog
      820   or error-status:error then do:
      821     message error-status:get-message(1) view-as alert-box .
      822     undo, return error .
      823   end.
      824     end.
      825   end procedure.
      826   procedure fltopend_fltfindd :
      827   define input parameter p-parent-handle as handle no-undo .
      828   define input parameter p-qh as handle no-undo .
      829   define input parameter p-rowid as rowid no-undo .
      830   define input parameter p-next as logical no-undo .
      831   define input parameter p-lock as integer no-undo .
      832   define input parameter p-bh as handle no-undo .
      833   define input parameter p-where-cond as character no-undo .
      834   define input parameter p-use-index-phrase as character no-undo .
      835   define variable glog as logical no-undo .
      836   define variable v-qh as handle no-undo .
      837   define variable v-bh as handle no-undo .
      838   define variable v-recid as recid no-undo .
      839   define variable v-prepare-string as character no-undo .
      840   do
      841   on error undo, return error
      842   on stop undo, return error
      843   :
      844     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      845     create buffer v-bh for table p-bh buffer-name p-bh:name.
      846     create query v-qh.
      847     v-qh:set-buffers(v-bh).
      848     v-prepare-string = substitute("for each &1 &2 &3"
      849                                     ,v-bh:name
      850                                     ,p-where-cond
      851                                     ,p-use-index-phrase).
      852     glog = v-qh:query-prepare(v-prepare-string) no-error.
      853     if not glog then do:
      854       delete object v-qh.
      855       delete object v-bh.
      856       undo, return error .
      857     end.
      858     glog = v-qh:query-open no-error .
      859     if not glog then do:
      860       delete object v-qh.
      861       delete object v-bh.
      862       undo, return error .
      863     end.
      864     if p-next then do:
      865       v-qh:reposition-to-rowid(p-rowid) no-error .
      866       glog = v-qh:get-next( p-lock) no-error .
      867       glog = v-qh:get-next( p-lock) no-error .
      868       if not glog or v-qh:query-off-end = yes then do:
      869         glog = v-qh:get-first( p-lock) no-error .
      870       end.
      871     end.
      872     else do:
      873       glog = v-qh:get-first( p-lock) no-error .
      874     end.
      875     v-recid = v-bh:recid no-error .
      876     delete object v-qh.
      877     delete object v-bh.
      878     return string(v-recid) .
      879   end.
      880   end procedure.
      881   procedure fltopend_fltfindq :
      882   define input parameter p-parent-handle as handle no-undo .
      883   define input parameter p-qh as handle no-undo .
      884   define input parameter p-next as logical no-undo .
      885   define input parameter p-lock as integer no-undo .
      886   define input parameter p-flt-open-open-query  as character no-undo .
      887   define input parameter p-where-cond as character no-undo .
      888   define input parameter p-use-indFIRST-query-tail as character no-undo .
      889   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      890   define input parameter p-indexed-reposition as character no-undo .
      891   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      892   define variable glog as logical no-undo .
      893   define variable v-qh as handle no-undo .
      894   define variable v-bh as handle no-undo extent 18.
      895   define variable v-rowid as rowid no-undo extent 18.
      896   define variable v-ii as integer no-undo .
      897   define variable v-prepare-string as character no-undo .
      898   do
      899   on error undo, return error
      900   on stop undo, return error
      901   :
      902     create query v-qh.
      903     do v-ii = 1 to p-qh:num-buffers:
      904       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      905       assign
      906       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      907       no-error.
      908       v-qh:add-buffer(v-bh[v-ii]).
      909     end.
      910     assign
      911     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      912                       p-where-cond + chr(32)  +
      913                       p-use-indFIRST-query-tail + chr(32) +
      914                       p-use-ind-sort-clmn-by + chr(32) +
      915                       p-indexed-reposition
      916     .
      917     glog = v-qh:query-prepare( v-prepare-string) no-error .
      918     if not glog then do:
      919       delete object v-qh.
      920       do v-ii = 1 to p-qh:num-buffers:
      921         delete object v-bh[v-ii].
      922       end.
      923       undo, return error .
      924     end.
      925     glog = v-qh:query-open no-error .
      926     if not glog then do:
      927       delete object v-qh.
      928       do v-ii = 1 to p-qh:num-buffers:
      929         delete object v-bh[v-ii].
      930       end.
      931       undo, return error .
      932     end.
      933     if p-next then do:
      934       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      935       glog = v-qh:get-next( p-lock) no-error .
      936       glog = v-qh:get-next( p-lock) no-error .
      937       if not glog or v-qh:query-off-end = yes then do:
      938         glog = v-qh:get-first( p-lock) no-error .
      939       end.
      940     end.
      941     else do:
      942       glog = v-qh:get-first( p-lock) no-error .
      943     end.
      944     do v-ii = 1 to p-qh:num-buffers:
      945       assign
      946       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      947       no-error.
      948     end.
      949     delete object v-qh.
      950     do v-ii = 1 to p-qh:num-buffers:
      951       delete object v-bh[v-ii].
      952     end.
      953   end.
      954   end procedure.
      955   define variable filter-point as character no-undo init "Ассортиментный минимум" .
      956   define variable filter-point0 as character no-undo init "Ассортиментный минимум" .
      957   define variable sort-column-name as character no-undo .
      958   define variable gds-rec as recid no-undo .
      959   define buffer X_curr_clients for ub.clients.
      960     find first X_curr_clients no-lock where
      961               X_curr_clients.obj-type = p-obj-type
      962          AND X_curr_clients.obj-code = p-obj-code no-error.
      963     if not available X_curr_clients then do:
      964       message
      965       vss-workfile vss-revision vss-description skip
      966       "Неверное значение параметра вызова p-obj-type p-obj-code"
      967       p-obj-type p-obj-code
      968       view-as alert-box ERROR.
      969       return error .
      970     end.
      971   DEFINE BUTTON B-Help
      972        LABEL "Помо&щь"
      973        SIZE 10 BY 1
      974        BGCOLOR 8 .
      975   DEFINE BUTTON B-print
      976        LABEL "Пе&чать"
      977        SIZE 10 BY 1.
      978   DEFINE BUTTON b-quit AUTO-END-KEY
      979        LABEL "&Выход"
      980        SIZE 10 BY 1
      981        BGCOLOR 8 .
      982   DEFINE VARIABLE ED_asmg-des AS CHARACTER
      983        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      984        SIZE 98 BY 2.54 NO-UNDO.
      985   DEFINE VARIABLE f-name LIKE assortment-matrix.asmt-name
      986        LABEL "Ассортиментная матрица"
      987         VIEW-AS TEXT
      988        SIZE 72 BY .67
      989        FGCOLOR 4  NO-UNDO.
      990   DEFINE VARIABLE RS-hard AS CHARACTER
      991        VIEW-AS RADIO-SET HORIZONTAL
      992        RADIO-BUTTONS
      993             "Все", "all",
      994   "Ниже минимального остатка", "min"
      995        SIZE 36 BY 1 NO-UNDO.
      996   DEFINE QUERY AMin FOR
      997                   x-gds-obj-prop,
      998                   x-gds-obj,
      999                   x-goods SCROLLING.
     1000   DEFINE BROWSE AMin
     1001     QUERY AMin NO-LOCK DISPLAY
     1002         x-goods.artic FORMAT "X(16)":U
     1003         x-goods.gds-name  COLUMN-LABEL 'Наименование'    FORMAT "X(30)":U
     1004         x-gds-obj-prop.gdop-min-stock COLUMN-LABEL "MIN!остаток" FORMAT "->>>>>>>9.<<<":U
     1005         x-gds-obj.fact-qnty COLUMN-LABEL "Факт!(кол-во)" FORMAT "->>>>>>>9.<<<":U
     1006         x-gds-obj.free-qnty COLUMN-LABEL "Свободно!(кол-во)" FORMAT "->>>>>>>9.<<<":U
     1007         x-gds-obj-prop.grop-max-stock COLUMN-LABEL "MAX!остаток" FORMAT "->>>>>>>9.<<<":U
     1008         x-gds-obj-prop.gdop-igt COLUMN-LABEL "ИЖТ" FORMAT "x(20)":U        WIDTH 8
     1009        (x-goods.prod-type + ' ' + STRING (x-goods.prod-code)) COLUMN-LABEL "Производитель" FORMAT "x(13)":U
     1010         x-goods.unit-base COLUMN-LABEL "Ед.!изм." FORMAT "X(3)":U
     1011         ENABLE
     1012         x-goods.artic
     1013       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.38 BY 17 FIT-LAST-COLUMN.
     1014   DEFINE FRAME Dialog-Frame
     1015        b-quit AT ROW 1 COL 1
     1016        B-print AT ROW 1 COL 79
     1017        B-Help AT ROW 1 COL 89
     1018        RS-hard AT ROW 2 COL 11.5 NO-LABEL
     1019        AMin AT ROW 3 COL 1
     1020        ED_asmg-des AT ROW 21 COL 1 NO-LABEL
     1021        f-name AT ROW 20.25 COL 23.5 COLON-ALIGNED HELP
     1022             ""
     1023             LABEL "Ассортиментная матрица"
     1024             FGCOLOR 4
     1025        SPACE(1.88) SKIP(2.62)
     1026       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1027            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1028            TITLE "Ассортиментный минимум".
     1029   ASSIGN
     1030          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1031          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1032   ASSIGN
     1033          ED_asmg-des:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1034   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1035   DO:
     1036     APPLY "END-ERROR":U TO SELF.
     1037   END.
     1038   ON ROW-DISPLAY OF AMin IN FRAME Dialog-Frame
     1039   DO:
     1040         if available x-gds-obj-prop then do:
     1041           case x-gds-obj-prop.gdop-igt :
     1042               when 'Новинка':U then do:
     1043                 x-gds-obj-prop.gdop-igt:bgcolor  in browse AMin   = 14 .
     1044               end.
     1045               when 'На вывод из ассортимента':U then do:
     1046                 x-gds-obj-prop.gdop-igt:bgcolor  in browse AMin   = 12 .
     1047               end.
     1048               when 'Нештатный':U then do:
     1049                 x-gds-obj-prop.gdop-igt:bgcolor  in browse AMin   = 8  .
     1050               end.
     1051           end case.
     1052           if x-goods.stts <> 0 then x-gds-obj-prop.gdop-igt:fgcolor  in browse AMin   = 12 .
     1053       end.
     1054   END.
     1055   ON VALUE-CHANGED OF AMin IN FRAME Dialog-Frame
     1056   DO:
     1057   define buffer buf_Matrix-goods for ub.assortment-matrix-goods.
     1058   define buffer buf_Matrix       for ub.assortment-Matrix .
     1059            f-name = " " .
     1060            ED_asmg-des = " " .
     1061       IF AVAILABLE x-gds-obj-prop THEN DO:
     1062          find first buf_Matrix no-lock where
     1063                     buf_Matrix.asmt-status   = 0 and
     1064                     buf_Matrix.obj-type = x-gds-obj-prop.obj-type and
     1065                     buf_Matrix.obj-code = x-gds-obj-prop.obj-code
     1066                     no-error .
     1067            if available buf_Matrix then do:
     1068                 find first  buf_Matrix-goods no-lock  where
     1069                            buf_Matrix-goods.asmt-id   = buf_Matrix.asmt-id and
     1070                            buf_Matrix-goods.db-num    = buf_Matrix.db-num and
     1071                            buf_Matrix-goods.asmg-status   = 0 and
     1072                            buf_Matrix-goods.gds-code  = x-gds-obj-prop.gds-code no-error .
     1073                  if available buf_Matrix-goods then do:
     1074                     f-name = buf_Matrix.asmt-name .
     1075                     ED_asmg-des = buf_Matrix-goods.asmg-des .
     1076                  end.
     1077            end.
     1078        END.
     1079        DISPLAY ED_asmg-des f-name WITH FRAME Dialog-Frame.
     1080   END.
     1081   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1082   DO:
     1083     run proc-b-print in this-procedure no-error.
     1084     if error-status:error then do:
     1085       return no-apply.
     1086     end.
     1087   END.
     1088   ON VALUE-CHANGED OF RS-hard IN FRAME Dialog-Frame
     1089   DO:
     1090     run openbr in this-procedure no-error.
     1091     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1092   END.
     1093   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1094   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1095   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   on help of frame Dialog-Frame
     1097   do:
     1098     run gbl/app_help.p
     1099       (input this-procedure :file-name
     1100       ,input ''
     1101       ,input ?
     1102       ) no-error.
     1103     if error-status :error then do:
     1104       message
     1105         "Ошибка при вызове помощи"
     1106         error-status :get-message(1)
     1107         view-as alert-box .
     1108     end.
     1109   end.
     1110   run minbtn-set in this-procedure .
     1111   on choose of b-help in frame Dialog-Frame
     1112   do:
     1113     apply "help":u to frame Dialog-Frame .
     1114   end.
     1115   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1116   procedure minbtn-set :
     1117       do
     1118           on error undo, return error return-value
     1119           :
     1120           define variable ii              as integer       no-undo .
     1121           define variable fh              as widget-handle no-undo .
     1122           define variable hh              as widget-handle no-undo .
     1123           define variable v-h             as handle        extent 4 no-undo .
     1124           define variable v-name-button   as character     no-undo .
     1125           define variable v-help-old-x    as decimal       no-undo .
     1126           define variable v-help-old-y    as decimal       no-undo .
     1127           define variable v-help-old-size as decimal       no-undo .
     1128           define variable v-frame-width   as decimal       no-undo .
     1129           define variable jj              as integer       no-undo .
     1130           do
     1131               on error undo, return error
     1132               :
     1133               assign
     1134                   v-frame-width = frame Dialog-Frame:width - 0.3
     1135                   fh            = frame Dialog-Frame:first-child
     1136                   hh            = fh:first-child
     1137                   ii            = 1
     1138                   .
     1139               do while valid-handle(hh):
     1140                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1141                   do:
     1142                       case lc(hh:name) :
     1143                           when "b-help" then
     1144                               do:
     1145                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1146                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1147                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1148                                   hh:TOOLTIP = "Помощь" .
     1149                                   v-help-old-x = hh:column .
     1150                                   v-help-old-y = hh:row    .
     1151                                   v-help-old-size = hh:width .
     1152                                   hh:width-chars = 2.5 .
     1153                               end.
     1154                           when "b-print" then
     1155                               do:
     1156                                   hh:load-image("cmp/b-print.bmp":u) .
     1157                                   hh:TOOLTIP = "Печать" .
     1158                                   v-h[ii] = hh:handle .
     1159                                   ii = ii + 1 .
     1160                                   hh:width-chars = 3 .
     1161                               end.
     1162                           when "b-history" or
     1163                           when "b-hist" then
     1164                               do:
     1165                                   hh:load-image("cmp/b-hist.bmp":u) .
     1166                                   hh:TOOLTIP = "История" .
     1167                                   v-h[ii] = hh:handle .
     1168                                   ii = ii + 1 .
     1169                                   hh:width-chars = 3 .
     1170                               end.
     1171                           when "b-sch" then
     1172                               do:
     1173                                   hh:load-image("cmp/b-sch.bmp":u) .
     1174                                   hh:TOOLTIP = "Установка Фильтра" .
     1175                                   v-h[ii] = hh:handle .
     1176                                   ii = ii + 1 .
     1177                                   hh:width-chars = 3 .
     1178                               end.
     1179                           when "b-hist-user" then
     1180                               do:
     1181                                   hh:load-image("cmp/b-hist.bmp":u) .
     1182                                   hh:TOOLTIP = "История пользователя" .
     1183                                   ii = ii + 1 .
     1184                               end.
     1185                       end case.
     1186                   end.
     1187                   hh = hh:next-sibling.
     1188               end.
     1189               b-help:column = v-frame-width - b-help:width-chars.
     1190               jj = 0.
     1191               repeat ii = 4 to 1 by -1 :
     1192                   if valid-handle (v-h[ii] ) then
     1193                   do:
     1194                       jj  = jj + 1 .
     1195                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1196                       v-h[ii]:row    = v-help-old-y .
     1197                   end.
     1198               end.
     1199           end.
     1200       end.
     1201   end procedure.
     1202   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1203   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1204   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1205   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1206   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1207   define variable v-diasize-current-frame-height as decimal   no-undo .
     1208   define variable v-diasize-change-size          as logical   no-undo .
     1209   define variable v-diasize-resize-button        as handle    no-undo .
     1210   define variable v-diasize-wndmax               as logical   no-undo .
     1211   define variable v-diasize-wndstore             as logical   no-undo .
     1212   define variable v-diasize-proc-name            as character no-undo .
     1213   define variable v-diasize-browse-handle        as handle    no-undo .
     1214   define variable v-diasize-browse-number        as integer   no-undo .
     1215   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1216   define temp-table temp-diasize-handle no-undo
     1217     field handle-value  as handle
     1218     field save-position as decimal
     1219     index xpk is primary unique handle-value
     1220     .
     1221   define temp-table temp-browse-handle no-undo
     1222     field browse-type   as character
     1223     field browse-number as integer
     1224     field browse-handle as handle
     1225     field original-size as decimal
     1226     index xpk is primary unique browse-type browse-number
     1227     index xie browse-type browse-handle
     1228   .
     1229   procedure diasize_change-height :
     1230     define input  parameter p-change-value  as decimal   no-undo .
     1231     define input  parameter p-move-resize   as logical   no-undo .
     1232     define variable v-field-group-handle    as handle    no-undo .
     1233     define variable v-object-handle         as handle    no-undo .
     1234     define variable v-frame-height          as decimal   no-undo .
     1235     define variable v-frame-virtual-height  as decimal   no-undo .
     1236     define variable v-browse-height         as decimal   no-undo .
     1237     define variable v-window-height         as decimal   no-undo .
     1238     define variable v-window-virtual-height as decimal   no-undo .
     1239     define variable v-change-sign           as integer   no-undo .
     1240     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1241     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1242     if p-change-value > 0
     1243     then do:
     1244       if frame Dialog-Frame :height + p-change-value
     1245           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1246       then do:
     1247         assign
     1248           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1249                           - (frame Dialog-Frame :height-chars)
     1250         .
     1251         if p-change-value <= 0
     1252         then do:
     1253           run diasize_position-resize-button in this-procedure .
     1254           return .
     1255         end.
     1256       end.
     1257     end.
     1258     if p-change-value < 0
     1259     then do:
     1260       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1261       then do:
     1262         assign
     1263           p-change-value = v-diasize-orig-frame-height
     1264                          - (frame Dialog-Frame :height-chars)
     1265         .
     1266         if p-change-value >= 0
     1267         then do:
     1268           run diasize_position-resize-button in this-procedure .
     1269           return .
     1270         end.
     1271       end.
     1272     end.
     1273     if p-change-value >= 0
     1274     then do:
     1275       assign
     1276         v-change-sign = 1
     1277       .
     1278     end.
     1279     else do:
     1280       assign
     1281         v-change-sign = -1
     1282       .
     1283     end.
     1284     assign
     1285       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1286     .
     1287     if p-change-value = 0
     1288     then do:
     1289       run diasize_position-resize-button in this-procedure .
     1290       return .
     1291     end.
     1292     move_block:
     1293     do
     1294     on error undo move_block, retry move_block
     1295     :
     1296       if retry
     1297       then do:
     1298         do
     1299         on error undo move_block, leave move_block
     1300         :
     1301           if p-change-value > 0
     1302           then do:
     1303             for each buf_temp-diasize-handle
     1304             on error undo, next
     1305             :
     1306               assign
     1307                 v-object-handle = buf_temp-diasize-handle.handle-value
     1308               .
     1309               if v-object-handle <> v-diasize-resize-button
     1310               then do:
     1311                 assign
     1312                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1313                 .
     1314               end.
     1315             end.
     1316             assign
     1317               v-diasize-browse-handle :height = v-browse-height
     1318             .
     1319             for each buf_temp-browse-handle
     1320               where buf_temp-browse-handle.browse-type = 'height':u
     1321             on error undo, next
     1322             :
     1323               assign
     1324                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1325               .
     1326             end.
     1327             assign
     1328               frame Dialog-Frame :height = v-frame-height
     1329             .
     1330             if frame Dialog-Frame :scrollable = true
     1331             then do:
     1332               assign
     1333                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1334               .
     1335             end.
     1336             run diasize_position-resize-button in this-procedure .
     1337           end.
     1338           else do:
     1339             if frame Dialog-Frame :scrollable = true
     1340             then do:
     1341               assign
     1342                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1343               .
     1344             end.
     1345             assign
     1346               frame Dialog-Frame :height = v-frame-height
     1347             .
     1348             assign
     1349               v-diasize-browse-handle :height = v-browse-height
     1350             .
     1351             for each buf_temp-browse-handle
     1352               where buf_temp-browse-handle.browse-type = 'height':u
     1353             on error undo, next
     1354             :
     1355               assign
     1356                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1357               .
     1358             end.
     1359             for each buf_temp-diasize-handle
     1360             on error undo, next
     1361             :
     1362               assign
     1363                 v-object-handle = buf_temp-diasize-handle.handle-value
     1364               .
     1365               if v-object-handle <> v-diasize-resize-button
     1366               then do:
     1367                 assign
     1368                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1369                 .
     1370               end.
     1371             end.
     1372             run diasize_position-resize-button in this-procedure .
     1373           end.
     1374           assign
     1375             v-diasize-change-size = false
     1376           .
     1377           leave move_block .
     1378         end.
     1379       end.
     1380       assign
     1381         v-diasize-need-full-display = true
     1382       .
     1383       if v-diasize-change-size = false
     1384       then do:
     1385         assign
     1386           v-diasize-change-size = true
     1387         .
     1388       end.
     1389       else do:
     1390         return .
     1391       end.
     1392       assign
     1393         v-frame-height = frame Dialog-Frame :height
     1394         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1395         v-browse-height = v-diasize-browse-handle :height
     1396       .
     1397       for each buf_temp-browse-handle
     1398         where buf_temp-browse-handle.browse-type = 'height':u
     1399       :
     1400         assign
     1401           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1402         .
     1403       end.
     1404       for each buf_temp-diasize-handle
     1405       :
     1406         delete buf_temp-diasize-handle .
     1407       end.
     1408       assign
     1409         v-field-group-handle = frame Dialog-Frame :first-child
     1410       .
     1411       do while valid-handle(v-field-group-handle)
     1412       :
     1413         assign
     1414           v-object-handle = v-field-group-handle :first-child
     1415         .
     1416         do while valid-handle(v-object-handle)
     1417         :
     1418           if  v-object-handle <> v-diasize-browse-handle :handle
     1419           and can-query(v-object-handle, "row")
     1420           and can-query(v-object-handle, "height")
     1421           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1422           then do:
     1423             find first buf_temp-browse-handle
     1424               where buf_temp-browse-handle.browse-type   = 'height':u
     1425                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1426               no-error .
     1427             if available buf_temp-browse-handle
     1428             then do:
     1429             end.
     1430             else do:
     1431               create buf_temp-diasize-handle .
     1432               assign
     1433                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1434                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1435               .
     1436             end.
     1437           end.
     1438           assign
     1439             v-object-handle = v-object-handle :next-sibling
     1440           .
     1441         end.
     1442         assign
     1443           v-field-group-handle = v-field-group-handle :next-sibling
     1444         .
     1445       end.
     1446       do with frame Dialog-Frame
     1447       :
     1448         hide v-diasize-resize-button .
     1449         assign
     1450           v-diasize-resize-button :row    = 1
     1451           v-diasize-resize-button :column = 1
     1452         .
     1453       end.
     1454       if p-change-value > 0
     1455       then do:
     1456         if frame Dialog-Frame :scrollable = true
     1457         then do:
     1458           assign
     1459             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1460             no-error .
     1461           if error-status :error
     1462           or error-status :get-message(1) <> ""
     1463           then do:
     1464             undo move_block, retry move_block .
     1465           end.
     1466         end.
     1467         assign
     1468           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1469           no-error .
     1470         if error-status :error
     1471         or error-status :get-message(1) <> ""
     1472         then do:
     1473           undo move_block, retry move_block .
     1474         end.
     1475         assign
     1476           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1477           no-error .
     1478         if error-status :error
     1479         or error-status :get-message(1) <> ""
     1480         then do:
     1481           undo move_block, retry move_block .
     1482         end.
     1483         for each buf_temp-browse-handle
     1484           where buf_temp-browse-handle.browse-type = 'height':u
     1485         on error undo move_block, retry move_block
     1486         :
     1487           assign
     1488             buf_temp-browse-handle.browse-handle :height
     1489               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1490             no-error .
     1491           if error-status :error
     1492           or error-status :get-message(1) <> ""
     1493           then do:
     1494             undo move_block, retry move_block .
     1495           end.
     1496         end.
     1497         for each buf_temp-diasize-handle
     1498         on error undo move_block, retry move_block
     1499         :
     1500           assign
     1501             v-object-handle = buf_temp-diasize-handle.handle-value
     1502           .
     1503           if v-object-handle <> v-diasize-resize-button
     1504           then do:
     1505             assign
     1506               v-object-handle :row = v-object-handle :row + p-change-value
     1507               no-error .
     1508             if error-status :error
     1509             or error-status :get-message(1) <> ""
     1510             then do:
     1511               undo move_block, retry move_block .
     1512             end.
     1513           end.
     1514         end.
     1515       end.
     1516       else do:
     1517         for each buf_temp-diasize-handle
     1518         on error undo move_block, retry move_block
     1519         :
     1520           assign
     1521             v-object-handle = buf_temp-diasize-handle.handle-value
     1522           .
     1523           if v-object-handle <> v-diasize-resize-button
     1524           then do:
     1525             assign
     1526               v-object-handle :row = v-object-handle :row + p-change-value
     1527               no-error .
     1528             if error-status :error
     1529             or error-status :get-message(1) <> ""
     1530             then do:
     1531               undo move_block, retry move_block .
     1532             end.
     1533           end.
     1534         end.
     1535         assign
     1536           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1537           no-error .
     1538         if error-status :error
     1539         or error-status :get-message(1) <> ""
     1540         then do:
     1541           undo move_block, retry move_block .
     1542         end.
     1543         for each buf_temp-browse-handle
     1544           where buf_temp-browse-handle.browse-type = 'height':u
     1545         on error undo move_block, retry move_block
     1546         :
     1547           assign
     1548             buf_temp-browse-handle.browse-handle :height
     1549               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1550             no-error .
     1551           if error-status :error
     1552           or error-status :get-message(1) <> ""
     1553           then do:
     1554             undo move_block, retry move_block .
     1555           end.
     1556         end.
     1557         assign
     1558           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1559           no-error .
     1560         if error-status :error
     1561         or error-status :get-message(1) <> ""
     1562         then do:
     1563           undo move_block, retry move_block .
     1564         end.
     1565         if frame Dialog-Frame :scrollable = true
     1566         then do:
     1567           assign
     1568             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1569             no-error .
     1570           if error-status :error
     1571           or error-status :get-message(1) <> ""
     1572           then do:
     1573             undo move_block, retry move_block .
     1574           end.
     1575         end.
     1576       end.
     1577       if p-move-resize = true
     1578       then do:
     1579         run diasize_position-resize-button in this-procedure .
     1580       end.
     1581       if v-diasize-wndstore = true
     1582       then do:
     1583         if connected("ub") = true
     1584         then do:
     1585           define variable v-cntxt-db-num        as integer   no-undo .
     1586           define variable v-cntxt-userid        as character no-undo .
     1587           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1588                                             , OUTPUT v-cntxt-userid
     1589                                             ) .
     1590           run gbl/wndsizew.p
     1591             (input  v-cntxt-db-num
     1592             ,input  v-cntxt-userid
     1593             ,input  v-diasize-proc-name
     1594             ,input  'height':u
     1595             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1596             ) .
     1597         end.
     1598       end.
     1599     end.
     1600     assign
     1601       v-diasize-change-size = false
     1602     .
     1603   end procedure.
     1604   procedure diasize_set-height :
     1605     define input  parameter p-new-height  as decimal   no-undo .
     1606     define input  parameter p-move-resize as logical   no-undo .
     1607     do
     1608     on error undo, return error return-value
     1609     :
     1610       run diasize_change-height in this-procedure
     1611         (input  (p-new-height - frame Dialog-Frame :height)
     1612         ,input  p-move-resize
     1613         ) .
     1614     end.
     1615   end procedure.
     1616   procedure diasize_change-width :
     1617     define input  parameter p-change-value as decimal   no-undo .
     1618     define input  parameter p-move-resize  as logical   no-undo .
     1619     define variable v-field-group-handle   as handle    no-undo .
     1620     define variable v-object-handle        as handle    no-undo .
     1621     define variable v-frame-width          as decimal   no-undo .
     1622     define variable v-frame-virtual-width  as decimal   no-undo .
     1623     define variable v-browse-width         as decimal   no-undo .
     1624     define variable v-window-width         as decimal   no-undo .
     1625     define variable v-window-virtual-width as decimal   no-undo .
     1626     define variable v-change-sign          as integer   no-undo .
     1627     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1628     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1629     if p-change-value > 0
     1630     then do:
     1631       if frame Dialog-Frame :width + p-change-value >
     1632           session :width-chars
     1633       then do:
     1634         assign
     1635           p-change-value = session :width-chars - frame Dialog-Frame :width
     1636         .
     1637         if p-change-value <= 0
     1638         then do:
     1639           run diasize_position-resize-button in this-procedure .
     1640           return .
     1641         end.
     1642       end.
     1643     end.
     1644     if p-change-value < 0
     1645     then do:
     1646       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1647       then do:
     1648         assign
     1649           p-change-value = v-diasize-orig-frame-width
     1650                          - frame Dialog-Frame :width
     1651         .
     1652         if p-change-value >= 0
     1653         then do:
     1654           run diasize_position-resize-button in this-procedure .
     1655           return .
     1656         end.
     1657       end.
     1658     end.
     1659     if p-change-value >= 0
     1660     then do:
     1661       assign
     1662         v-change-sign = 1
     1663       .
     1664     end.
     1665     else do:
     1666       assign
     1667         v-change-sign = -1
     1668       .
     1669     end.
     1670     assign
     1671       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1672     .
     1673     if p-change-value = 0
     1674     then do:
     1675       run diasize_position-resize-button in this-procedure .
     1676       return .
     1677     end.
     1678     move_block:
     1679     do
     1680     on error undo move_block, leave move_block
     1681     :
     1682       if retry
     1683       then do:
     1684         do
     1685         on error undo move_block, leave move_block
     1686         :
     1687           if p-change-value > 0
     1688           then do:
     1689             for each buf_temp-diasize-handle
     1690             on error undo, next
     1691             :
     1692               assign
     1693                 v-object-handle = buf_temp-diasize-handle.handle-value
     1694               .
     1695               if v-object-handle <> v-diasize-resize-button
     1696               then do:
     1697                 assign
     1698                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1699                 .
     1700               end.
     1701             end.
     1702             assign
     1703               v-diasize-browse-handle :width = v-browse-width
     1704             .
     1705             for each buf_temp-browse-handle
     1706               where buf_temp-browse-handle.browse-type = 'width':u
     1707             on error undo, next
     1708             :
     1709               assign
     1710                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1711               .
     1712             end.
     1713             assign
     1714               frame Dialog-Frame :width = v-frame-width
     1715             .
     1716             if frame Dialog-Frame :scrollable = true
     1717             then do:
     1718               assign
     1719                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1720               .
     1721             end.
     1722             run diasize_position-resize-button in this-procedure .
     1723           end.
     1724           else do:
     1725             if frame Dialog-Frame :scrollable = true
     1726             then do:
     1727               assign
     1728                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1729               .
     1730             end.
     1731             assign
     1732               frame Dialog-Frame :width = v-frame-width
     1733             .
     1734             for each buf_temp-browse-handle
     1735               where buf_temp-browse-handle.browse-type = 'width':u
     1736             on error undo, next
     1737             :
     1738               assign
     1739                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1740               .
     1741             end.
     1742             assign
     1743               v-diasize-browse-handle :width = v-browse-width
     1744             .
     1745             for each buf_temp-diasize-handle
     1746             on error undo, next
     1747             :
     1748               assign
     1749                 v-object-handle = buf_temp-diasize-handle.handle-value
     1750               .
     1751               if v-object-handle <> v-diasize-resize-button
     1752               then do:
     1753                 assign
     1754                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1755                 .
     1756               end.
     1757             end.
     1758             run diasize_position-resize-button in this-procedure .
     1759           end.
     1760           assign
     1761             v-diasize-change-size = false
     1762           .
     1763           leave move_block .
     1764         end.
     1765       end.
     1766       assign
     1767         v-diasize-need-full-display = true
     1768       .
     1769       if v-diasize-change-size = false
     1770       then do:
     1771         assign
     1772           v-diasize-change-size = true
     1773         .
     1774       end.
     1775       else do:
     1776         return .
     1777       end.
     1778       assign
     1779         v-frame-width = frame Dialog-Frame :width
     1780         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1781         v-browse-width = v-diasize-browse-handle :width
     1782       .
     1783       for each buf_temp-browse-handle
     1784         where buf_temp-browse-handle.browse-type = 'width':u
     1785       :
     1786         assign
     1787           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1788         .
     1789       end.
     1790       for each buf_temp-diasize-handle
     1791       :
     1792         delete buf_temp-diasize-handle .
     1793       end.
     1794       assign
     1795         v-field-group-handle = frame Dialog-Frame :first-child
     1796       .
     1797       do while valid-handle(v-field-group-handle)
     1798       :
     1799         assign
     1800           v-object-handle = v-field-group-handle :first-child
     1801         .
     1802         do while valid-handle(v-object-handle)
     1803         :
     1804           if  v-object-handle <> v-diasize-browse-handle :handle
     1805           and v-object-handle <> v-diasize-resize-button
     1806           and can-query(v-object-handle, "row")
     1807           and can-query(v-object-handle, "height")
     1808           and ( v-object-handle :col + v-object-handle :width
     1809                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1810               )
     1811           then do:
     1812             find first buf_temp-browse-handle
     1813               where buf_temp-browse-handle.browse-type   = 'width':u
     1814                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1815               no-error .
     1816             if available buf_temp-browse-handle
     1817             then do:
     1818             end.
     1819             else do:
     1820               create buf_temp-diasize-handle .
     1821               assign
     1822                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1823                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1824               .
     1825             end.
     1826           end.
     1827           assign
     1828             v-object-handle = v-object-handle :next-sibling
     1829           .
     1830         end.
     1831         assign
     1832           v-field-group-handle = v-field-group-handle :next-sibling
     1833         .
     1834       end.
     1835       do with frame Dialog-Frame
     1836       :
     1837         hide v-diasize-resize-button .
     1838         v-diasize-resize-button :row = 1.
     1839         v-diasize-resize-button :column = 1.
     1840       end.
     1841       if p-change-value > 0
     1842       then do:
     1843         if frame Dialog-Frame :scrollable = true
     1844         then do:
     1845           assign
     1846             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1847             no-error .
     1848           if error-status :error
     1849           or error-status :get-message(1) <> ""
     1850           then do:
     1851             undo move_block, retry move_block.
     1852           end.
     1853         end.
     1854         assign
     1855           frame Dialog-Frame :width = v-frame-width + p-change-value
     1856           no-error .
     1857         if error-status :error
     1858         or error-status :get-message(1) <> ""
     1859         then do:
     1860           undo move_block, retry move_block.
     1861         end.
     1862         assign
     1863           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1864         no-error .
     1865         if error-status :error
     1866         or error-status :get-message(1) <> ""
     1867         then do:
     1868           undo move_block, retry move_block.
     1869         end.
     1870         for each buf_temp-browse-handle
     1871           where buf_temp-browse-handle.browse-type = 'width':u
     1872         on error undo move_block, retry move_block
     1873         :
     1874           assign
     1875             buf_temp-browse-handle.browse-handle :width
     1876               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1877             no-error .
     1878           if error-status :error
     1879           or error-status :get-message(1) <> ""
     1880           then do:
     1881             undo move_block, retry move_block .
     1882           end.
     1883         end.
     1884         for each buf_temp-diasize-handle
     1885         on error undo move_block, retry move_block
     1886         :
     1887           assign
     1888             v-object-handle = buf_temp-diasize-handle.handle-value
     1889           .
     1890           if v-object-handle <> v-diasize-resize-button
     1891           then do:
     1892             assign
     1893               v-object-handle :col = v-object-handle :col + p-change-value
     1894               no-error .
     1895             if error-status :error
     1896             or error-status :get-message(1) <> ""
     1897             then do:
     1898               undo move_block, retry move_block .
     1899             end.
     1900           end.
     1901         end.
     1902       end.
     1903       else do:
     1904         for each buf_temp-diasize-handle
     1905         on error undo move_block, retry move_block
     1906         :
     1907           assign
     1908             v-object-handle = buf_temp-diasize-handle.handle-value
     1909           .
     1910           if v-object-handle <> v-diasize-resize-button
     1911           then do:
     1912             assign
     1913               v-object-handle :col = v-object-handle :col + p-change-value
     1914               no-error .
     1915             if error-status :error
     1916             or error-status :get-message(1) <> ""
     1917             then do:
     1918               undo move_block, retry move_block .
     1919             end.
     1920           end.
     1921         end.
     1922         for each buf_temp-browse-handle
     1923           where buf_temp-browse-handle.browse-type = 'width':u
     1924         on error undo move_block, retry move_block
     1925         :
     1926           assign
     1927             buf_temp-browse-handle.browse-handle :width
     1928               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1929             no-error .
     1930           if error-status :error
     1931           or error-status :get-message(1) <> ""
     1932           then do:
     1933             undo move_block, retry move_block .
     1934           end.
     1935         end.
     1936         assign
     1937           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1938           no-error .
     1939         if error-status :error
     1940         or error-status :get-message(1) <> ""
     1941         then do:
     1942           undo move_block, retry move_block.
     1943         end.
     1944         assign
     1945           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1946         no-error .
     1947         if error-status :error
     1948         or error-status :get-message(1) <> ""
     1949         then do:
     1950           undo move_block, retry move_block.
     1951         end.
     1952         if frame Dialog-Frame :scrollable = true
     1953         then do:
     1954           assign
     1955             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1956           no-error .
     1957           if error-status :error
     1958           or error-status :get-message(1) <> ""
     1959           then do:
     1960             undo move_block, retry move_block.
     1961           end.
     1962         end.
     1963       end.
     1964       if p-move-resize
     1965       then do:
     1966         run diasize_position-resize-button in this-procedure .
     1967       end.
     1968       if v-diasize-wndstore = true
     1969       then do:
     1970         if connected("ub") = true
     1971         then do:
     1972           define variable v-cntxt-db-num        as integer   no-undo .
     1973           define variable v-cntxt-userid        as character no-undo .
     1974           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1975                                             , OUTPUT v-cntxt-userid
     1976                                             ) .
     1977           run gbl/wndsizew.p
     1978             (input  v-cntxt-db-num
     1979             ,input  v-cntxt-userid
     1980             ,input  v-diasize-proc-name
     1981             ,input  'width':u
     1982             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1983             ) .
     1984         end.
     1985       end.
     1986     end.
     1987     assign
     1988       v-diasize-change-size = false
     1989     .
     1990   end procedure.
     1991   procedure diasize_set-width :
     1992     define input  parameter p-new-width  as decimal   no-undo .
     1993     define input  parameter p-move-resize as logical   no-undo .
     1994     do
     1995     on error undo, return error return-value
     1996     :
     1997       run diasize_change-width in this-procedure
     1998         (input  (p-new-width - frame Dialog-Frame :width)
     1999         ,input  p-move-resize
     2000         ) .
     2001     end.
     2002   end procedure.
     2003   procedure diasize_position-resize-button :
     2004     do with frame Dialog-Frame
     2005     :
     2006       hide v-diasize-resize-button .
     2007       assign
     2008         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2009                     - 1
     2010                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2011         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2012                     - 1
     2013                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2014       .
     2015       view v-diasize-resize-button .
     2016     end.
     2017   end procedure.
     2018   on alt-right anywhere
     2019   do:
     2020     run diasize_change-width in this-procedure
     2021       (input 1
     2022       ,input true
     2023       ) .
     2024     return no-apply .
     2025   end.
     2026   on alt-left anywhere
     2027   do:
     2028     run diasize_change-width in this-procedure
     2029       (input -1
     2030       ,input true
     2031       ) .
     2032     return no-apply .
     2033   end.
     2034   on alt-down anywhere
     2035   do:
     2036     run diasize_change-height in this-procedure
     2037       (input 1
     2038       ,input true
     2039       ) .
     2040     return no-apply .
     2041   end.
     2042   on alt-up anywhere
     2043   do:
     2044     run diasize_change-height in this-procedure
     2045       (input -1
     2046       ,input true
     2047       ) .
     2048     return no-apply .
     2049   end.
     2050   on alt-enter of frame Dialog-Frame
     2051   do:
     2052     run diasize_maximize in this-procedure
     2053       (input  ?
     2054       ).
     2055     return no-apply .
     2056   end.
     2057   procedure diasize_end-move :
     2058     do
     2059     on error undo, return error return-value
     2060     :
     2061       define variable v-row-delta as decimal   no-undo .
     2062       define variable v-col-delta as decimal   no-undo .
     2063       define variable v-new-row as decimal   no-undo .
     2064       define variable v-new-col as decimal   no-undo .
     2065       assign
     2066         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2067         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2068       .
     2069       assign
     2070         v-row-delta = v-new-row - frame Dialog-Frame :height
     2071         v-col-delta = v-new-col - frame Dialog-Frame :width
     2072       .
     2073       run diasize_change-height in this-procedure
     2074         (input v-row-delta
     2075         ,input true
     2076         ) .
     2077       run diasize_change-width in this-procedure
     2078         (input v-col-delta
     2079         ,input true
     2080         ) .
     2081     end.
     2082   end procedure.
     2083   procedure diasize_maximize :
     2084     define input  parameter p-action as logical   no-undo .
     2085     do
     2086     on error undo, return error return-value
     2087     :
     2088       if p-action = ?
     2089       then do:
     2090         if v-diasize-need-maximize = true
     2091         then do:
     2092           assign
     2093             p-action = true
     2094           .
     2095         end.
     2096         else do:
     2097           assign
     2098             p-action = false
     2099           .
     2100         end.
     2101       end.
     2102       if p-action = true
     2103       then do:
     2104         run diasize_change-height in this-procedure
     2105           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2106               - frame Dialog-Frame :height-chars
     2107           ,input true
     2108           ) .
     2109         run diasize_change-width in this-procedure
     2110           (input session :width-chars
     2111               - frame Dialog-Frame :width-chars
     2112           ,input true
     2113           ) .
     2114         assign
     2115           v-diasize-need-maximize = false
     2116         .
     2117       end.
     2118       else do:
     2119         run diasize_change-width in this-procedure
     2120           (input v-diasize-orig-frame-width
     2121               - frame Dialog-Frame :width-chars
     2122           ,input true
     2123           ) .
     2124         run diasize_change-height in this-procedure
     2125           (input v-diasize-orig-frame-height
     2126               - frame Dialog-Frame :height-chars
     2127           ,input true
     2128           ) .
     2129         assign
     2130           v-diasize-need-maximize = true
     2131         .
     2132       end.
     2133     end.
     2134   end procedure.
     2135   procedure diasize_restore-orig-size :
     2136     do
     2137     on error undo, return error return-value
     2138     :
     2139       assign
     2140         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2141         v-diasize-current-frame-height = frame Dialog-Frame :height
     2142       .
     2143       run diasize_set-height in this-procedure
     2144         (input  v-diasize-orig-frame-height
     2145         ,input  true
     2146         ) .
     2147       run diasize_set-width in this-procedure
     2148         (input  v-diasize-orig-frame-width
     2149         ,input  true
     2150         ) .
     2151     end.
     2152   end procedure.
     2153   procedure diasize_restore-current-size :
     2154     do
     2155     on error undo, return error return-value
     2156     :
     2157       run diasize_set-height in this-procedure
     2158         (input  v-diasize-current-frame-height
     2159         ,input  true
     2160         ) .
     2161       run diasize_set-width in this-procedure
     2162         (input  v-diasize-current-frame-width
     2163         ,input  true
     2164         ) .
     2165     end.
     2166   end procedure.
     2167   procedure diasize_set-browse-handle :
     2168     define input  parameter p-browse-handle as handle   no-undo .
     2169     define buffer buf_temp-browse-handle for temp-browse-handle .
     2170     do
     2171     on error undo, return error return-value
     2172     :
     2173       assign
     2174         v-diasize-browse-handle = p-browse-handle
     2175       .
     2176       for each buf_temp-browse-handle
     2177       on error undo, return error return-value
     2178       :
     2179         delete buf_temp-browse-handle .
     2180       end.
     2181     end.
     2182   end procedure.
     2183   procedure diasize_add_browse :
     2184     define input  parameter p-browse-type   as character no-undo .
     2185     define input  parameter p-browse-handle as handle    no-undo .
     2186     define buffer buf_temp-browse-handle for temp-browse-handle .
     2187     do
     2188     on error undo, return error return-value
     2189     :
     2190       assign
     2191         v-diasize-browse-number = v-diasize-browse-number + 1
     2192       .
     2193       create buf_temp-browse-handle .
     2194       assign
     2195         buf_temp-browse-handle.browse-type   = p-browse-type
     2196         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2197         buf_temp-browse-handle.browse-handle = p-browse-handle
     2198       .
     2199     end.
     2200   end procedure.
     2201   procedure diasize_init :
     2202     define variable v-default-value    as logical   no-undo .
     2203     define variable v-restore-saved    as logical   no-undo .
     2204     define variable v-resize-value-str as character no-undo .
     2205     do
     2206     on error undo, return error return-value
     2207     :
     2208       do with frame Dialog-Frame
     2209       :
     2210         assign
     2211           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2212           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2213           v-diasize-browse-handle     = browse AMin :handle
     2214         .
     2215         create button v-diasize-resize-button
     2216         assign
     2217           parent        = frame Dialog-Frame :first-child
     2218           label         = "s"
     2219           height-pixels = 16
     2220           width-pixels  = 16
     2221           visible       = true
     2222           sensitive     = true
     2223           movable       = true
     2224           triggers:
     2225             on end-move persistent run diasize_end-move in this-procedure .
     2226           end triggers.
     2227         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2228         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2229         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2230         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2231         assign
     2232           v-diasize-wndmax = false
     2233         .
     2234         if connected("ub") = true
     2235         then do:
     2236           define variable v-cntxt-db-num        as integer   no-undo .
     2237           define variable v-cntxt-userid        as character no-undo .
     2238           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2239                                             , OUTPUT v-cntxt-userid
     2240                                             ) .
     2241           run gbl/wndpar_r.p
     2242             (input  v-cntxt-db-num
     2243             ,input  v-cntxt-userid
     2244             ,input  'wndmax':U
     2245             ,output v-diasize-wndmax
     2246             ,output v-default-value
     2247             ) .
     2248         end.
     2249         assign
     2250           v-diasize-wndstore = false
     2251         .
     2252         if connected("ub") = true
     2253         then do:
     2254           run gbl/wndpar_r.p
     2255             (input  v-cntxt-db-num
     2256             ,input  v-cntxt-userid
     2257             ,input  'wndstore':U
     2258             ,output v-diasize-wndstore
     2259             ,output v-default-value
     2260             ) .
     2261         end.
     2262         assign
     2263           v-diasize-proc-name = entry(1, program-name(2), '.')
     2264         .
     2265         if v-diasize-wndstore = true
     2266         then do:
     2267           assign
     2268             v-restore-saved = false
     2269           .
     2270           if connected("ub") = true
     2271           then do:
     2272             run gbl/wndsizer.p
     2273               (input  v-cntxt-db-num
     2274               ,input  v-cntxt-userid
     2275               ,input  v-diasize-proc-name
     2276               ,input  'height':u
     2277               ,output v-resize-value-str
     2278               ) .
     2279             if v-resize-value-str <> '':U
     2280             then do:
     2281               run diasize_change-height in this-procedure
     2282                 (input  integer(v-resize-value-str)
     2283                 ,input  true
     2284                 ) .
     2285               assign
     2286                 v-restore-saved = true
     2287               .
     2288             end.
     2289           end.
     2290           if connected("ub") = true
     2291           then do:
     2292             run gbl/wndsizer.p
     2293               (input  v-cntxt-db-num
     2294               ,input  v-cntxt-userid
     2295               ,input  v-diasize-proc-name
     2296               ,input  'width':u
     2297               ,output v-resize-value-str
     2298               ) .
     2299             if v-resize-value-str <> '':U
     2300             then do:
     2301               run diasize_change-width in this-procedure
     2302                 (input  integer(v-resize-value-str)
     2303                 ,input  true
     2304                 ) .
     2305               assign
     2306                 v-restore-saved = true
     2307               .
     2308             end.
     2309           end.
     2310           if v-restore-saved <> true
     2311           then do:
     2312             if v-diasize-wndmax = true
     2313             then do:
     2314               run diasize_maximize in this-procedure
     2315                 (input  true
     2316                 ) .
     2317             end.
     2318           end.
     2319         end.
     2320         else do:
     2321           if v-diasize-wndmax = true
     2322           then do:
     2323             run diasize_maximize in this-procedure
     2324               (input  true
     2325               ) .
     2326           end.
     2327         end.
     2328       end.
     2329     end.
     2330   end procedure.
     2331   procedure diasize_need-full-display :
     2332     define output parameter p-need-full-display as logical   no-undo .
     2333     do
     2334     on error undo, return error return-value
     2335     :
     2336       assign
     2337         p-need-full-display = v-diasize-need-full-display
     2338       .
     2339       assign
     2340         v-diasize-need-full-display = false
     2341       .
     2342     end.
     2343   end procedure.
     2344   procedure get-context :
     2345      define output parameter p-db-num as integer          no-undo.
     2346      define output parameter p-user-id as character        no-undo.
     2347      define variable v-login               as character    no-undo.
     2348      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2349      define buffer buf_user-login  for ub.user-login .
     2350      do
     2351      on error undo, return error
     2352      :
     2353            FIND FIRST buf_sys-ctrl no-lock.
     2354            ASSIGN
     2355               v-login = USERID("ub")
     2356               p-db-num = buf_sys-ctrl.db-num
     2357            .
     2358            FIND FIRST buf_user-login
     2359                 WHERE buf_user-login.db-num = p-db-num
     2360                   AND buf_user-login.user-login = v-login
     2361                 no-lock
     2362                 no-error
     2363                 .
     2364            IF AVAILABLE buf_user-login
     2365            THEN DO:
     2366               assign
     2367                  p-user-id = buf_user-login.user-id
     2368               .
     2369            END.
     2370      end.
     2371   end procedure.
     2372       run diasize_init in this-procedure .
     2373   def var sort-labelAMin   as character no-undo .
     2374   def var sort-clmnAMin    as handle    no-undo .
     2375   def var cur-clmnAMin     as handle    no-undo .
     2376   def var cur-clmn-locAMin as integer   no-undo .
     2377   def var re-queryAMin     as logical   initial no no-undo .
     2378   on start-search, ctrl-o of AMin in frame Dialog-Frame do:
     2379      run sort-brAMin
     2380        (input (if available x-gds-obj-prop
     2381                then recid(x-gds-obj-prop)
     2382                else ?
     2383               )
     2384        ).
     2385   end.
     2386   PROCEDURE sort-brAMin :
     2387     define input parameter p-recid as recid no-undo .
     2388     if re-queryAMin = no then do:
     2389       assign
     2390          cur-clmnAMin = AMin:current-column in frame Dialog-Frame
     2391       .
     2392       if sort-clmnAMin <> ? then sort-clmnAMin:column-fgcolor = 0.
     2393       if cur-clmnAMin = sort-clmnAMin then do:
     2394         assign
     2395            sort-labelAMin = ""
     2396            sort-clmnAMin = ?
     2397         .
     2398        end.
     2399        else do:
     2400          assign
     2401            sort-labelAMin = cur-clmnAMin:label
     2402            sort-clmnAMin  = cur-clmnAMin
     2403            sort-clmnAMin:column-fgcolor = 4
     2404          .
     2405        end.
     2406      end.
     2407     assign
     2408       cur-clmn-locAMin = 1
     2409     .
     2410     def var column-handle as handle no-undo .
     2411     column-handle = AMin:first-column.
     2412     do while valid-handle(column-handle) :
     2413       if column-handle = cur-clmnAMin then do:
     2414         leave .
     2415       end.
     2416       column-handle = column-handle:NEXT-COLUMN.
     2417       assign
     2418         cur-clmn-locAMin = cur-clmn-locAMin + 1
     2419       .
     2420     end.
     2421     case sort-labelAMin:
     2422           when 'Артикул'  then DO:   assign     sort-column-name = "x-goods.artic"   .   run OpenBr.   . END.
     2423           when 'Наименование'  then DO:   assign     sort-column-name = "x-goods.gds-name"   .   run OpenBr.   . END.
     2424           when 'MIN!остаток'  then DO:   assign     sort-column-name = "x-gds-obj-prop.gdop-min-stock"   .   run OpenBr.   . END.
     2425           when 'Факт!(кол-во)'  then DO:   assign     sort-column-name = "x-gds-obj.fact-qnty"   .   run OpenBr.   . END.
     2426           when 'Свободно!(кол-во)'  then DO:   assign     sort-column-name = "x-gds-obj.free-qnty"   .   run OpenBr.   . END.
     2427           when 'MAX!остаток'  then DO:   assign     sort-column-name = "x-gds-obj-prop.grop-max-stock"   .   run OpenBr.   . END.
     2428           when 'ИЖТ'  then DO:   assign     sort-column-name = "x-gds-obj-prop.gdop-igt"   .   run OpenBr.   . END.
     2429           when 'Производитель'  then DO:   assign     sort-column-name = "x-goods.prod-type + STRING (x-goods.prod-code)"   .   run OpenBr.   . END.
     2430           when 'Ед.!изм.'  then DO:   assign     sort-column-name = "x-goods.unit-base"   .   run OpenBr.   . END.
     2431       otherwise do:
     2432         assign
     2433           sort-column-name = ""
     2434         .
     2435         run OpenBr.
     2436           if can-do( this-procedure:internal-entries, 'mv-brw-defaultAMin') then do:
     2437             run mv-brw-defaultAMin.
     2438           end.
     2439         if sort-labelAMin <> "" then do:
     2440           assign
     2441             cur-clmnAMin:column-fgcolor = 0
     2442           .
     2443         end.
     2444         assign
     2445           cur-clmn-locAMin = ?
     2446         .
     2447       end.
     2448     end case.
     2449       if cur-clmn-locAMin <> ? then do:
     2450         if can-do( this-procedure:internal-entries, 'ch-clmnAMin') then do:
     2451           run ch-clmnAMin in this-procedure (cur-clmn-locAMin).
     2452         end.
     2453       end.
     2454     if p-recid <> ? then do:
     2455       reposition AMin to recid p-recid no-error.
     2456       apply "value-changed" to AMin in frame Dialog-Frame.
     2457     end.
     2458     apply "entry" to AMin in frame Dialog-Frame.
     2459   END PROCEDURE.
     2460   procedure re-open-query-srt-clmnAMin:
     2461   if cur-clmnAMin = ? then do:
     2462      run OpenBr.
     2463   end.
     2464   else do:
     2465      assign re-queryAMin = yes.
     2466      run sort-brAMin
     2467        (input (if available x-gds-obj-prop
     2468                then recid(x-gds-obj-prop)
     2469                else ?
     2470               )
     2471        ).
     2472      assign re-queryAMin = no.
     2473   end.
     2474   end.
     2475   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2476   do:
     2477     AMin :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2478   end.
     2479   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2480   on F9 of frame Dialog-Frame anywhere do:
     2481     run init-gds-rec.
     2482     if gds-rec = ? then
     2483       return no-apply.
     2484     run ref/gds-form.w ( input parParentProc
     2485                         ,input 'ПРОСМОТР':U
     2486                         ,input ?
     2487                         ,input ?
     2488                         ,input ?
     2489                         ,input-output gds-rec).
     2490     apply "entry" to AMin in frame Dialog-Frame.
     2491     return no-apply.
     2492   end.
     2493   MAIN-BLOCK:
     2494   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2495      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2496     run enable_ui.
     2497   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2498   DEF VAR cur-clmn-numAMin as INT EXTENT 9 no-undo.
     2499   DEF VAR varmviAMin       as INT no-undo.
     2500   DEF VAR varmvjAMin       as INT no-undo.
     2501   DEF VAR varmvkAMin       as INT no-undo.
     2502   DEF VAR varmvlAMin       as INT no-undo.
     2503   DEF VAR move-elementAMin as INT no-undo.
     2504   def var jjAMin           as int no-undo.
     2505   do varmviAMin = 1 to EXTENT(cur-clmn-numAMin):
     2506     ASSIGN cur-clmn-numAMin[varmviAMin] = varmviAMin.
     2507   END.
     2508   RUN start-mv-clmnAMin.
     2509   PROCEDURE start-mv-clmnAMin:
     2510   def var old-session as logical no-undo.
     2511      old-session = SESSION:IMMEDIATE-DISPLAY.
     2512      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2513      SESSION:IMMEDIATE-DISPLAY = old-session.
     2514   END.
     2515   ON ctrl-cursor-right OF BROWSE AMin do:
     2516     RUN re-move-clmnAMin ( 2, 9).
     2517   END.
     2518   ON ctrl-cursor-left OF BROWSE AMin do:
     2519     RUN re-move-clmnAMin (9, 2).
     2520   END.
     2521   PROCEDURE re-move-clmnAMin:
     2522     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2523     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2524     DO varmviAMin = 1 TO EXTENT(cur-clmn-numAMin):
     2525       if cur-clmn-numAMin[varmviAMin] = source-column THEN cur-clmn-numAMin[varmviAMin] = -1.
     2526     END.
     2527     if AMin:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2528     if source-column > target-column THEN
     2529     DO varmvjAMin = source-column - 1 to target-column BY -1:
     2530       DO varmviAMin = 1 TO EXTENT(cur-clmn-numAMin):
     2531           if cur-clmn-numAMin[varmviAMin] = varmvjAMin THEN DO:
     2532             cur-clmn-numAMin[varmviAMin] = cur-clmn-numAMin[varmviAMin] + 1.
     2533           END.
     2534       END.
     2535     END.
     2536     ELSE
     2537     DO varmvjAMin = source-column + 1 to target-column:
     2538       DO varmviAMin = 1 TO EXTENT(cur-clmn-numAMin):
     2539         if cur-clmn-numAMin[varmviAMin] = varmvjAMin THEN DO:
     2540           cur-clmn-numAMin[varmviAMin] = cur-clmn-numAMin[varmviAMin] - 1.
     2541         END.
     2542       END.
     2543     END.
     2544     DO varmviAMin = 1 TO EXTENT(cur-clmn-numAMin):
     2545       if cur-clmn-numAMin[varmviAMin] = -1 THEN cur-clmn-numAMin[varmviAMin] = target-column.
     2546     END.
     2547   END PROCEDURE.
     2548   PROCEDURE ch-clmnAMin:
     2549     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2550     if cur-clmn-loc <= 2 then do:
     2551       return .
     2552     end.
     2553     DO varmviAMin = 1 TO EXTENT(cur-clmn-numAMin):
     2554       if cur-clmn-numAMin[varmviAMin] = cur-clmn-loc THEN move-elementAMin = varmviAMin.
     2555     END.
     2556     RUN re-move-clmnAMin (cur-clmn-loc, 2).
     2557   END PROCEDURE.
     2558   PROCEDURE mv-brw-defaultAMin:
     2559   def var old-session as logical no-undo.
     2560     old-session = SESSION:IMMEDIATE-DISPLAY.
     2561     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2562     do varmvlAMin = 2 to EXTENT(cur-clmn-numAMin):
     2563       RUN re-move-clmnAMin (cur-clmn-numAMin[varmvlAMin], varmvlAMin).
     2564     END.
     2565     RUN start-mv-clmnAMin.
     2566     SESSION:IMMEDIATE-DISPLAY = old-session.
     2567   END PROCEDURE.
     2568   .
     2569     if p-mode = "min" then do:
     2570        rs-hard = "min".
     2571       display  rs-hard with frame Dialog-Frame .
     2572       disable  rs-hard with frame Dialog-Frame .
     2573     end.
     2574     x-gds-obj-prop.gdop-igt:resizable in browse AMin  = true .
     2575     x-goods.gds-name:resizable in browse AMin  = true .
     2576     x-goods.artic:read-only in browse AMin  = true .
     2577     run openbr in this-procedure no-error.
     2578     WAIT-FOR GO OF FRAME Dialog-Frame.
     2579   END.
     2580   run disable_ui.
     2581   PROCEDURE disable_UI :
     2582     HIDE FRAME Dialog-Frame.
     2583   END PROCEDURE.
     2584   PROCEDURE enable_UI :
     2585     DISPLAY RS-hard ED_asmg-des f-name
     2586         WITH FRAME Dialog-Frame.
     2587     ENABLE b-quit B-print B-Help RS-hard AMin ED_asmg-des f-name
     2588         WITH FRAME Dialog-Frame.
     2589     VIEW FRAME Dialog-Frame.
     2590   END PROCEDURE.
     2591   PROCEDURE init-gds-rec :
     2592   if available x-goods then do:
     2593      gds-rec = recid (x-goods) .
     2594   end.
     2595   END PROCEDURE.
     2596   PROCEDURE openBr :
     2597   define variable p-open-query     as logical   no-undo init true .
     2598   define variable l-query-was-opened as logical no-undo .
     2599   define variable doc-rec  as recid     no-undo .
     2600   define variable  p-find-next      as logical   no-undo .
     2601   define variable  p-find-condition as character no-undo .
     2602   ASSIGN  FRAME Dialog-Frame
     2603     rs-hard
     2604       .
     2605   if p-mode = "min" then rs-hard = "min" .
     2606   def var sort-column-phrase as character no-undo .
     2607   case sort-column-name :
     2608     when "" then do:
     2609       assign
     2610         sort-column-phrase = ""
     2611       .
     2612     end.
     2613     otherwise do:
     2614       assign
     2615         sort-column-phrase = "by " + sort-column-name
     2616       .
     2617     end.
     2618   end case.
     2619   define variable title0 as character no-undo init "Ассортиментный минимум" .
     2620    title0 = "Ассортиментный минимум по объекту " + X_curr_clients.obj-type + " " + string(X_curr_clients.obj-code)
     2621                                                 + " " + X_curr_clients.obj-name.
     2622   IF rs-hard = "all" THEN DO:
     2623       frame Dialog-Frame:TITLE = title0  .
     2624   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2625   define variable  l-disable-where-14  as logical   no-undo .
     2626   define variable  l-filter-open-14    as logical   .
     2627   define variable  flt-rec-14       as recid     no-undo .
     2628   define variable  filter-name-14      as character no-undo .
     2629   define variable  where-phrase-14     as character no-undo .
     2630   define variable  sort-phrase-14      as character no-undo .
     2631   define variable  where-phrase-rus-14 as character no-undo .
     2632   define variable  sort-phrase-rus-14  as character no-undo .
     2633     run waitfram-show in this-procedure
     2634       (input "ЖДИТЕ ..."
     2635       ).
     2636   run gbl/flt-get.p
     2637     (input filter-point
     2638     ,output flt-rec-14
     2639     ,output filter-name-14
     2640     ,output where-phrase-14
     2641     ,output sort-phrase-14
     2642     ,output where-phrase-rus-14
     2643     ,output sort-phrase-rus-14
     2644     ).
     2645   if p-open-query then do:
     2646     assign
     2647       l-filter-open-14 = false
     2648     .
     2649     if flt-rec-14 <> ?
     2650       or sort-column-phrase > ""
     2651     then do:
     2652       define variable  parameter-2-14 as character no-undo .
     2653       define variable  parameter-3-14 as character no-undo .
     2654       define variable  parameter-4-14 as character no-undo .
     2655       define variable  parameter-5-14 as character no-undo .
     2656       define variable  parameter-6-14 as character no-undo .
     2657       define variable  parameter-7-14 as character no-undo .
     2658         assign
     2659         parameter-3-14 =
     2660                                 "FOR EACH x-gds-obj-prop"
     2661         parameter-4-14 =
     2662           (
     2663             if ("        x-gds-obj-prop.gdop-assort-min = YES and        x-gds-obj-prop.obj-code = p-obj-code AND        x-gds-obj-prop.obj-type = p-obj-type        " + " " + where-phrase-14) <> ""
     2664             then  substitute('x-gds-obj-prop.gdop-assort-min = YES and                                     x-gds-obj-prop.obj-code = &2 AND                                     x-gds-obj-prop.obj-type = &1&3&1                                   ' ,  chr(34), p-obj-code , p-obj-type)  + " " + where-phrase-14
     2665             else "true"
     2666           )
     2667         parameter-5-14 = (" " + "" + " " + ",       EACH x-gds-obj WHERE             x-gds-obj.gds-code = x-gds-obj-prop.gds-code AND                        x-gds-obj.obj-code = x-gds-obj-prop.obj-code AND                        x-gds-obj.obj-type = x-gds-obj-prop.obj-type OUTER-JOIN   NO-LOCK,       EACH x-goods OF x-gds-obj-prop NO-LOCK")
     2668         parameter-6-14 = if sort-phrase-14 = ''
     2669                              then
     2670           (
     2671           " " + "  " +
     2672             " " + sort-column-phrase +
     2673           " " + " "
     2674           )
     2675                              else
     2676           (
     2677           " " + "  " +
     2678             " " + sort-column-phrase +
     2679           " " + sort-phrase-14
     2680           )
     2681         parameter-7-14 =
     2682           " indexed-reposition  "
     2683       .
     2684       do
     2685       on stop undo, leave
     2686       on error undo, leave
     2687       :
     2688         assign
     2689           l-disable-where-14 =
     2690             ("        x-gds-obj-prop.gdop-assort-min = YES and        x-gds-obj-prop.obj-code = p-obj-code AND        x-gds-obj-prop.obj-type = p-obj-type        " + " " + where-phrase-14 = "")
     2691         .
     2692         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2693                             ,input query AMin:handle
     2694                             ,input parameter-3-14
     2695                             ,input parameter-4-14
     2696                             ,input parameter-5-14
     2697                             ,input parameter-6-14
     2698                             ,input parameter-7-14
     2699                             )
     2700         .
     2701         assign
     2702           l-filter-open-14 = true
     2703         .
     2704       end.
     2705       if l-filter-open-14 = false then do:
     2706         message
     2707           "Ошибка при фильтрации / сортировке" skip
     2708           "Будут показаны записи без учета фильтра" skip
     2709           view-as alert-box .
     2710       end.
     2711       else do:
     2712           assign
     2713             l-query-was-opened = true
     2714           .
     2715       end.
     2716     end.
     2717     if l-filter-open-14 = false then do:
     2718       OPEN QUERY AMin FOR EACH x-gds-obj-prop  no-lock
     2719         where         x-gds-obj-prop.gdop-assort-min = YES and        x-gds-obj-prop.obj-code = p-obj-code AND        x-gds-obj-prop.obj-type = p-obj-type
     2720       ,       EACH x-gds-obj WHERE             x-gds-obj.gds-code = x-gds-obj-prop.gds-code AND                        x-gds-obj.obj-code = x-gds-obj-prop.obj-code AND                        x-gds-obj.obj-type = x-gds-obj-prop.obj-type OUTER-JOIN   NO-LOCK,       EACH x-goods OF x-gds-obj-prop NO-LOCK
     2721         indexed-reposition
     2722     .
     2723         assign
     2724           l-query-was-opened = true
     2725         .
     2726     end.
     2727   end.
     2728   else do:
     2729     assign
     2730       doc-rec = recid( x-gds-obj-prop )
     2731     .
     2732     do
     2733     on stop undo, leave
     2734     on error undo, leave
     2735     :
     2736       if query AMin:handle:get-buffer-handle(1) = (buffer x-gds-obj-prop:handle) then do:
     2737         assign
     2738         parameter-2-14 = (if p-find-next then "true":u else "false":u )
     2739         parameter-4-14 =
     2740           "where ":u +  substitute('x-gds-obj-prop.gdop-assort-min = YES and                                     x-gds-obj-prop.obj-code = &2 AND                                     x-gds-obj-prop.obj-type = &1&3&1                                   ' ,  chr(34), p-obj-code , p-obj-type)  + " ":u + where-phrase-14 + " ":u + p-find-condition + " " + ""
     2741         parameter-5-14 = "  "
     2742       .
     2743         run fltopend_fltfindd in this-procedure  (
     2744                             input this-procedure:handle
     2745                             ,input query AMin:handle
     2746                             ,input rowid(x-gds-obj-prop)
     2747                             ,input logical(parameter-2-14)
     2748                             ,input no-lock
     2749                             ,input (buffer x-gds-obj-prop:handle)
     2750                             ,input parameter-4-14
     2751                             ,input parameter-5-14
     2752                             ) no-error.
     2753         .
     2754         assign
     2755           doc-rec = integer(return-value)
     2756           v-fltopend-rowid[1] = ?
     2757         .
     2758       end.
     2759       else do:
     2760         assign
     2761         parameter-2-14 = (if p-find-next then "true":u else "false":u )
     2762         parameter-3-14 =  "FOR EACH x-gds-obj-prop"
     2763         parameter-4-14 =
     2764           (
     2765             if ("        x-gds-obj-prop.gdop-assort-min = YES and        x-gds-obj-prop.obj-code = p-obj-code AND        x-gds-obj-prop.obj-type = p-obj-type        " + " " + where-phrase-14) <> ""
     2766             then  substitute('x-gds-obj-prop.gdop-assort-min = YES and                                     x-gds-obj-prop.obj-code = &2 AND                                     x-gds-obj-prop.obj-type = &1&3&1                                   ' ,  chr(34), p-obj-code , p-obj-type)  + " " + where-phrase-14
     2767             else "true"
     2768           )
     2769         parameter-5-14 = (" " + "" + " " + ",       EACH x-gds-obj WHERE             x-gds-obj.gds-code = x-gds-obj-prop.gds-code AND                        x-gds-obj.obj-code = x-gds-obj-prop.obj-code AND                        x-gds-obj.obj-type = x-gds-obj-prop.obj-type OUTER-JOIN   NO-LOCK,       EACH x-goods OF x-gds-obj-prop NO-LOCK" + " " + p-find-condition)
     2770         parameter-6-14 = if sort-phrase-14 = ''
     2771                              then
     2772           (
     2773           " " + "  " +
     2774             " " + sort-column-phrase +
     2775           " " + " "
     2776           )
     2777                              else
     2778           (
     2779           " " + "  " +
     2780             " " + sort-column-phrase +
     2781           " " + sort-phrase-14
     2782           )
     2783         parameter-7-14 =
     2784           " indexed-reposition  "
     2785       .
     2786         run fltopend_fltfindq in this-procedure  (
     2787                             input this-procedure:handle
     2788                             ,input query AMin:handle
     2789                             ,input logical(parameter-2-14)
     2790                             ,input no-lock
     2791                             ,input parameter-3-14
     2792                             ,input parameter-4-14
     2793                             ,input parameter-5-14
     2794                             ,input parameter-6-14
     2795                             ,input parameter-7-14
     2796                             ,output v-fltopend-rowid
     2797                             ) no-error.
     2798         .
     2799         doc-rec = ?.
     2800       end.
     2801       assign
     2802         l-query-was-opened = true
     2803       .
     2804     end.
     2805   end.
     2806     run waitfram-hide in this-procedure .
     2807   END.
     2808   ELSE DO:
     2809       frame Dialog-Frame:TITLE = title0 + chr(32) + "Остаток на объекте < min остатка".
     2810   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2811   define variable  l-disable-where-16  as logical   no-undo .
     2812   define variable  l-filter-open-16    as logical   .
     2813   define variable  flt-rec-16       as recid     no-undo .
     2814   define variable  filter-name-16      as character no-undo .
     2815   define variable  where-phrase-16     as character no-undo .
     2816   define variable  sort-phrase-16      as character no-undo .
     2817   define variable  where-phrase-rus-16 as character no-undo .
     2818   define variable  sort-phrase-rus-16  as character no-undo .
     2819     run waitfram-show in this-procedure
     2820       (input "ЖДИТЕ ..."
     2821       ).
     2822   run gbl/flt-get.p
     2823     (input filter-point
     2824     ,output flt-rec-16
     2825     ,output filter-name-16
     2826     ,output where-phrase-16
     2827     ,output sort-phrase-16
     2828     ,output where-phrase-rus-16
     2829     ,output sort-phrase-rus-16
     2830     ).
     2831   if p-open-query then do:
     2832     assign
     2833       l-filter-open-16 = false
     2834     .
     2835     if flt-rec-16 <> ?
     2836       or sort-column-phrase > ""
     2837     then do:
     2838       define variable  parameter-2-16 as character no-undo .
     2839       define variable  parameter-3-16 as character no-undo .
     2840       define variable  parameter-4-16 as character no-undo .
     2841       define variable  parameter-5-16 as character no-undo .
     2842       define variable  parameter-6-16 as character no-undo .
     2843       define variable  parameter-7-16 as character no-undo .
     2844         assign
     2845         parameter-3-16 =
     2846                                 "FOR EACH x-gds-obj-prop"
     2847         parameter-4-16 =
     2848           (
     2849             if ("                 x-gds-obj-prop.gdop-assort-min = YES and                 x-gds-obj-prop.obj-code = p-obj-code AND                 x-gds-obj-prop.obj-type = p-obj-type                 " + " " + where-phrase-16) <> ""
     2850             then  substitute('x-gds-obj-prop.gdop-assort-min = YES and                                               x-gds-obj-prop.obj-code = &2 AND                                               x-gds-obj-prop.obj-type = &1&3&1                                             ' ,  chr(34), p-obj-code , p-obj-type)  + " " + where-phrase-16
     2851             else "true"
     2852           )
     2853         parameter-5-16 = (" " + "" + " " + ",       EACH x-gds-obj WHERE             x-gds-obj.gds-code = x-gds-obj-prop.gds-code AND             x-gds-obj.obj-code = x-gds-obj-prop.obj-code AND             x-gds-obj.obj-type = x-gds-obj-prop.obj-type and             x-gds-obj.fact-qnty < x-gds-obj-prop.gdop-min-stock             NO-LOCK,       EACH x-goods OF x-gds-obj-prop NO-LOCK")
     2854         parameter-6-16 = if sort-phrase-16 = ''
     2855                              then
     2856           (
     2857           " " + " " +
     2858             " " + sort-column-phrase +
     2859           " " + " "
     2860           )
     2861                              else
     2862           (
     2863           " " + " " +
     2864             " " + sort-column-phrase +
     2865           " " + sort-phrase-16
     2866           )
     2867         parameter-7-16 =
     2868           " indexed-reposition  "
     2869       .
     2870       do
     2871       on stop undo, leave
     2872       on error undo, leave
     2873       :
     2874         assign
     2875           l-disable-where-16 =
     2876             ("                 x-gds-obj-prop.gdop-assort-min = YES and                 x-gds-obj-prop.obj-code = p-obj-code AND                 x-gds-obj-prop.obj-type = p-obj-type                 " + " " + where-phrase-16 = "")
     2877         .
     2878         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2879                             ,input query AMin:handle
     2880                             ,input parameter-3-16
     2881                             ,input parameter-4-16
     2882                             ,input parameter-5-16
     2883                             ,input parameter-6-16
     2884                             ,input parameter-7-16
     2885                             )
     2886         .
     2887         assign
     2888           l-filter-open-16 = true
     2889         .
     2890       end.
     2891       if l-filter-open-16 = false then do:
     2892         message
     2893           "Ошибка при фильтрации / сортировке" skip
     2894           "Будут показаны записи без учета фильтра" skip
     2895           view-as alert-box .
     2896       end.
     2897       else do:
     2898           assign
     2899             l-query-was-opened = true
     2900           .
     2901       end.
     2902     end.
     2903     if l-filter-open-16 = false then do:
     2904       OPEN QUERY AMin FOR EACH x-gds-obj-prop  no-lock
     2905         where                  x-gds-obj-prop.gdop-assort-min = YES and                 x-gds-obj-prop.obj-code = p-obj-code AND                 x-gds-obj-prop.obj-type = p-obj-type
     2906       ,       EACH x-gds-obj WHERE             x-gds-obj.gds-code = x-gds-obj-prop.gds-code AND             x-gds-obj.obj-code = x-gds-obj-prop.obj-code AND             x-gds-obj.obj-type = x-gds-obj-prop.obj-type and             x-gds-obj.fact-qnty < x-gds-obj-prop.gdop-min-stock             NO-LOCK,       EACH x-goods OF x-gds-obj-prop NO-LOCK
     2907         indexed-reposition
     2908     .
     2909         assign
     2910           l-query-was-opened = true
     2911         .
     2912     end.
     2913   end.
     2914   else do:
     2915     assign
     2916       doc-rec = recid( x-gds-obj-prop )
     2917     .
     2918     do
     2919     on stop undo, leave
     2920     on error undo, leave
     2921     :
     2922       if query AMin:handle:get-buffer-handle(1) = (buffer x-gds-obj-prop:handle) then do:
     2923         assign
     2924         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     2925         parameter-4-16 =
     2926           "where ":u +  substitute('x-gds-obj-prop.gdop-assort-min = YES and                                               x-gds-obj-prop.obj-code = &2 AND                                               x-gds-obj-prop.obj-type = &1&3&1                                             ' ,  chr(34), p-obj-code , p-obj-type)  + " ":u + where-phrase-16 + " ":u + p-find-condition + " " + ""
     2927         parameter-5-16 = " "
     2928       .
     2929         run fltopend_fltfindd in this-procedure  (
     2930                             input this-procedure:handle
     2931                             ,input query AMin:handle
     2932                             ,input rowid(x-gds-obj-prop)
     2933                             ,input logical(parameter-2-16)
     2934                             ,input no-lock
     2935                             ,input (buffer x-gds-obj-prop:handle)
     2936                             ,input parameter-4-16
     2937                             ,input parameter-5-16
     2938                             ) no-error.
     2939         .
     2940         assign
     2941           doc-rec = integer(return-value)
     2942           v-fltopend-rowid[1] = ?
     2943         .
     2944       end.
     2945       else do:
     2946         assign
     2947         parameter-2-16 = (if p-find-next then "true":u else "false":u )
     2948         parameter-3-16 =  "FOR EACH x-gds-obj-prop"
     2949         parameter-4-16 =
     2950           (
     2951             if ("                 x-gds-obj-prop.gdop-assort-min = YES and                 x-gds-obj-prop.obj-code = p-obj-code AND                 x-gds-obj-prop.obj-type = p-obj-type                 " + " " + where-phrase-16) <> ""
     2952             then  substitute('x-gds-obj-prop.gdop-assort-min = YES and                                               x-gds-obj-prop.obj-code = &2 AND                                               x-gds-obj-prop.obj-type = &1&3&1                                             ' ,  chr(34), p-obj-code , p-obj-type)  + " " + where-phrase-16
     2953             else "true"
     2954           )
     2955         parameter-5-16 = (" " + "" + " " + ",       EACH x-gds-obj WHERE             x-gds-obj.gds-code = x-gds-obj-prop.gds-code AND             x-gds-obj.obj-code = x-gds-obj-prop.obj-code AND             x-gds-obj.obj-type = x-gds-obj-prop.obj-type and             x-gds-obj.fact-qnty < x-gds-obj-prop.gdop-min-stock             NO-LOCK,       EACH x-goods OF x-gds-obj-prop NO-LOCK" + " " + p-find-condition)
     2956         parameter-6-16 = if sort-phrase-16 = ''
     2957                              then
     2958           (
     2959           " " + " " +
     2960             " " + sort-column-phrase +
     2961           " " + " "
     2962           )
     2963                              else
     2964           (
     2965           " " + " " +
     2966             " " + sort-column-phrase +
     2967           " " + sort-phrase-16
     2968           )
     2969         parameter-7-16 =
     2970           " indexed-reposition  "
     2971       .
     2972         run fltopend_fltfindq in this-procedure  (
     2973                             input this-procedure:handle
     2974                             ,input query AMin:handle
     2975                             ,input logical(parameter-2-16)
     2976                             ,input no-lock
     2977                             ,input parameter-3-16
     2978                             ,input parameter-4-16
     2979                             ,input parameter-5-16
     2980                             ,input parameter-6-16
     2981                             ,input parameter-7-16
     2982                             ,output v-fltopend-rowid
     2983                             ) no-error.
     2984         .
     2985         doc-rec = ?.
     2986       end.
     2987       assign
     2988         l-query-was-opened = true
     2989       .
     2990     end.
     2991   end.
     2992     run waitfram-hide in this-procedure .
     2993   END.
     2994   APPLY "VALUE-CHANGED" TO AMin in frame Dialog-Frame.
     2995   APPLY "ENTRY" TO AMin.
     2996   END PROCEDURE.
     2997   PROCEDURE proc-b-print :
     2998   define variable v-doc-rec as recid no-undo .
     2999   define variable accum-count as integer.
     3000   define variable date_string     as      char    no-undo.
     3001   define variable Line            as      char    no-undo.
     3002   define variable v-time-cr as character no-undo .
     3003   DEFINE FRAME buf_Matrix-list
     3004         x-goods.artic FORMAT "X(16)":U
     3005         x-goods.gds-name FORMAT "X(30)":U
     3006         x-gds-obj-prop.gdop-min-stock COLUMN-LABEL "MIN!остаток" FORMAT "->>>>>>>9.<<<":U
     3007         x-gds-obj.fact-qnty COLUMN-LABEL "Факт!(кол-во)" FORMAT "->>>>>>>9.<<<":U
     3008         x-gds-obj.free-qnty COLUMN-LABEL "Свободно!(кол-во)" FORMAT "->>>>>>>9.<<<":U
     3009         x-gds-obj-prop.grop-max-stock COLUMN-LABEL "MAX!остаток" FORMAT "->>>>>>>9.<<<":U
     3010         x-gds-obj-prop.gdop-igt COLUMN-LABEL "ИЖТ" FORMAT "X(8)":U
     3011         v-time-cr COLUMN-LABEL "Производитель" FORMAT "x(13)":U
     3012         x-goods.unit-base COLUMN-LABEL "Ед.!изм." FORMAT "X(3)":U
     3013   HEADER  date_string AT 5 format "X(35)"
     3014    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3015   Line format "X(195)" AT 1
     3016   with width 232 down stream-io use-text    .
     3017   Line = fill("-", 195).
     3018   date_string = cur-time-print() .
     3019   run prn-lib-open-stream  in this-procedure (
     3020                                                input parParentProc
     3021                                               ,input 43
     3022                                               ,input yes
     3023                                               ,input no
     3024                                               ).
     3025   PUT  STREAM PrnLibStream
     3026   SPACE(25) ( frame Dialog-Frame:title )
     3027   format "x(90)" SKIP(1) .
     3028   FORM HEADER
     3029   Line format "X(195)" AT 1 SKIP
     3030   "Продолжение - на следующей странице" AT 30 SKIP
     3031   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3032   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3033   FORM with FRAME buf_Matrix-list  .
     3034   run waitfram-show in this-procedure ("Ждите...").
     3035   v-doc-rec = recid(x-gds-obj-prop).
     3036   DO WHILE available x-gds-obj-prop :
     3037     GET prev AMin.
     3038   END.
     3039   GET next AMin.
     3040   DO WHILE available x-gds-obj-prop :
     3041     Display STREAM PrnLibStream
     3042         x-goods.artic
     3043         x-goods.gds-name
     3044         x-gds-obj-prop.gdop-min-stock
     3045         x-gds-obj.fact-qnty
     3046         x-gds-obj.free-qnty
     3047         x-gds-obj-prop.grop-max-stock
     3048         x-gds-obj-prop.gdop-igt
     3049         x-goods.prod-type +  " "  +  STRING (x-goods.prod-code) @ v-time-cr
     3050         x-goods.unit-base
     3051    with FRAME buf_Matrix-list .
     3052     DOWN STREAM PrnLibStream 1
     3053     with FRAME buf_Matrix-list  .
     3054     assign
     3055     accum-count = accum-count + 1
     3056     .
     3057     GET next AMin.
     3058   END.
     3059   UNDERLINE  STREAM PrnLibStream
     3060         x-goods.artic
     3061         x-goods.gds-name
     3062         x-gds-obj-prop.gdop-min-stock
     3063         x-gds-obj.fact-qnty
     3064         x-gds-obj.free-qnty
     3065         x-gds-obj-prop.grop-max-stock
     3066         x-gds-obj-prop.gdop-igt
     3067         v-time-cr
     3068         x-goods.unit-base
     3069   with FRAME buf_Matrix-list .
     3070   DISPLAY STREAM PrnLibStream
     3071   "ИТОГО"     @ x-goods.artic
     3072   accum-count @ x-goods.gds-name
     3073   with frame buf_Matrix-list.
     3074   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3075   HIDE  STREAM PrnLibStream FRAME buf_Matrix-List.
     3076   output  STREAM PrnLibStream CLOSE.
     3077   REPOSITION AMin to recid v-doc-rec no-error.
     3078   APPLY "entry" to AMin.
     3079   run waitfram-hide in this-procedure .
     3080   run prn-lib-prn-file in this-procedure (
     3081                                             input parParentProc
     3082                                             ,input 8
     3083                                             ).
     3084   END PROCEDURE.
