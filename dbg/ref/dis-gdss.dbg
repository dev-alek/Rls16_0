     1595        SIZE 3 BY 1.
     1596   DEFINE BUTTON B-sel AUTO-GO
     1597        LABEL "Вы&бор"
     1598        SIZE 10 BY 1.
     1599   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1600         VIEW-AS TEXT
     1601        SIZE 6 BY 1
     1602        FGCOLOR 4  NO-UNDO.
     1603   DEFINE QUERY BR-dis-gds-rule FOR X_dis-gds-rule,
     1604         X_goods SCROLLING.
     1605   DEFINE BROWSE BR-dis-gds-rule
     1606     QUERY BR-dis-gds-rule NO-LOCK DISPLAY
     1607         mark-string(recid(X_dis-gds-rule), v-rid-list) COLUMN-LABEL '*' FORMAT "X(1)"
     1608   X_dis-gds-rule.gds-code COLUMN-LABEL 'Код товара'
