     1610   X_goods.artic COLUMN-LABEL 'Артикул'
     1611   (X_goods.prod-type + string(X_goods.prod-code)) COLUMN-LABEL 'Пр-ль' FORMAT "X(12)"
     1612   X_dis-gds-rule.nonunique COLUMN-LABEL 'Детализ.' FORMAT "X(9)"
     1613   X_dis-gds-rule.templ-rl-root COLUMN-LABEL 'Тип правила' FORMAT ">>>>>>>>9"
     1614   entry (lookup (X_dis-gds-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) COLUMN-LABEL 'Место использ.' FORMAT "X(10)"
     1615   X_dis-gds-rule.obj-type COLUMN-LABEL 'Тип объ' FORMAT "X(3)"
     1616   X_dis-gds-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>>>>>9"
     1617   entry (lookup (X_dis-gds-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) COLUMN-LABEL 'Тип скидки' FORMAT "X(70)"
     1618   X_dis-gds-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     1619   X_dis-gds-rule.rule-num COLUMN-LABEL '№ корн.!правила' FORMAT ">>>>>>>>9"
     1620       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20 FIT-LAST-COLUMN.
     1621   DEFINE FRAME Dialog-Frame
     1622        b-quit AT ROW 1 COL 1
     1623        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1624        B-sel AT ROW 1 COL 21 WIDGET-ID 10
     1625        b-gds AT ROW 1 COL 41 WIDGET-ID 18
     1626        b-dis-rule AT ROW 1 COL 51 WIDGET-ID 16
     1627        B-sch AT ROW 1 COL 86 WIDGET-ID 8
     1628        B-print AT ROW 1 COL 89 WIDGET-ID 6
     1629        b-history AT ROW 1 COL 92 WIDGET-ID 2
     1630        B-Help AT ROW 1 COL 95
     1631        BR-dis-gds-rule AT ROW 3 COL 1 WIDGET-ID 100
     1632        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 12
     1633        SPACE(78.50) SKIP(21.22)
     1634       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1635            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1636            TITLE "Скидки по товарам"
     1637            CANCEL-BUTTON b-quit.
     1638   ASSIGN
     1639          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1640          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1641   ON GO OF FRAME Dialog-Frame
     1642   DO:
     1643     p-rid-list = v-rid-list.
     1644   END.
     1645   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1646   DO:
     1647     APPLY "END-ERROR":U TO SELF.
     1648   END.
     1649   ON CHOOSE OF b-dis-rule IN FRAME Dialog-Frame
     1650   DO:
     1651     IF NOT AVAILABLE X_dis-gds-rule THEN RETURN NO-APPLY.
     1652     run dsp-dis-rule in this-procedure  (
     1653                                          input X_dis-gds-rule.gds-code
     1654                                         ,input X_dis-gds-rule.nonunique
     1655                                         ,input X_dis-gds-rule.obj-type
     1656                                         ,input X_dis-gds-rule.obj-code
     1657                                         ,input X_dis-gds-rule.discnt-role
     1658                                         ,input X_dis-gds-rule.pos-type
     1659                                         ,input X_dis-gds-rule.rule-num) .
     1660     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1661   END.
     1662   ON CHOOSE OF b-gds IN FRAME Dialog-Frame
     1663   DO:
     1664       IF NOT AVAILABLE X_dis-gds-rule THEN RETURN NO-APPLY.
     1665       run str/showgds.p ( input parparentproc
     1666                      ,input ?
     1667                      ,INPUT X_dis-gds-rule.gds-code
     1668                      ,INPUT 'ПРОСМОТР':U
     1669                      ) NO-ERROR.
     1670      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1671   END.
     1672   ON CHOOSE OF b-history IN FRAME Dialog-Frame
     1673   DO:
     1674   define variable v-rid-list as character no-undo .
     1675   define variable v-host-code as integer no-undo .
     1676   if not available X_dis-gds-rule then return no-apply.
     1677   if p-curr-obj-type = 'маг':U
     1678   or p-curr-obj-type = 'скл':U then do:
     1679   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1680   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1681     (input  p-curr-obj-type
     1682     ,input  p-curr-obj-code
     1683     ,output v-host-code
     1684     )  .
     1685   end.
     1686   run ref/cgdshist.w (
     1687                     input parparentproc
     1688                   , input v-host-code
     1689                   , input p-curr-obj-type
     1690                   , input p-curr-obj-code
     1691                   , input "":U
     1692                   , "subject":U
     1693                   , input X_dis-gds-rule.gds-code
     1694                   , input ?
     1695                   , input X_dis-gds-rule.obj-type
     1696                   , input X_dis-gds-rule.obj-code
     1697                   , input ?
     1698                   , input "":U
     1699                   , input 'dis-gds-rule':U
     1700                   , input v-cntxt-db-num
     1701                   , input-output v-rid-list  ) no-error .
     1702   END.
     1703   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1704   DO:
     1705     RUN proc-b-mark IN THIS-PROCEDURE NO-ERROR.
     1706     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1707   END.
     1708   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1709   DO:
     1710     run proc-b-print in this-procedure no-error.
     1711     if error-status:error then do:
     1712       return no-apply.
     1713     end.
     1714     APPLY "ENTRY" to br-dis-gds-rule.
     1715   END.
     1716   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1717   DO:
     1718     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1719     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1720   END.
     1721   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1722   DO:
     1723       if ( available X_dis-gds-rule ) then do:
     1724       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1725       then
     1726       v-rid-list = string( recid( X_dis-gds-rule ) ) .
     1727     end.
     1728   END.
     1729   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1730   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1731   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1732   on help of frame Dialog-Frame
     1733   do:
     1734     run gbl/app_help.p
     1735       (input this-procedure :file-name
     1736       ,input ''
     1737       ,input ?
     1738       ) no-error.
     1739     if error-status :error then do:
     1740       message
     1741         "Ошибка при вызове помощи"
     1742         error-status :get-message(1)
     1743         view-as alert-box .
     1744     end.
     1745   end.
     1746   run minbtn-set in this-procedure .
     1747   on choose of b-help in frame Dialog-Frame
     1748   do:
     1749     apply "help":u to frame Dialog-Frame .
     1750   end.
     1751   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1752   procedure minbtn-set :
     1753       do
     1754           on error undo, return error return-value
     1755           :
     1756           define variable ii              as integer       no-undo .
     1757           define variable fh              as widget-handle no-undo .
     1758           define variable hh              as widget-handle no-undo .
     1759           define variable v-h             as handle        extent 4 no-undo .
     1760           define variable v-name-button   as character     no-undo .
     1761           define variable v-help-old-x    as decimal       no-undo .
     1762           define variable v-help-old-y    as decimal       no-undo .
     1763           define variable v-help-old-size as decimal       no-undo .
     1764           define variable v-frame-width   as decimal       no-undo .
     1765           define variable jj              as integer       no-undo .
     1766           do
     1767               on error undo, return error
     1768               :
     1769               assign
     1770                   v-frame-width = frame Dialog-Frame:width - 0.3
     1771                   fh            = frame Dialog-Frame:first-child
     1772                   hh            = fh:first-child
     1773                   ii            = 1
     1774                   .
     1775               do while valid-handle(hh):
     1776                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1777                   do:
     1778                       case lc(hh:name) :
     1779                           when "b-help" then
     1780                               do:
     1781                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1782                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1783                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1784                                   hh:TOOLTIP = "Помощь" .
     1785                                   v-help-old-x = hh:column .
     1786                                   v-help-old-y = hh:row    .
     1787                                   v-help-old-size = hh:width .
     1788                                   hh:width-chars = 2.5 .
     1789                               end.
     1790                           when "b-print" then
     1791                               do:
     1792                                   hh:load-image("cmp/b-print.bmp":u) .
     1793                                   hh:TOOLTIP = "Печать" .
     1794                                   v-h[ii] = hh:handle .
     1795                                   ii = ii + 1 .
     1796                                   hh:width-chars = 3 .
     1797                               end.
     1798                           when "b-history" or
     1799                           when "b-hist" then
     1800                               do:
     1801                                   hh:load-image("cmp/b-hist.bmp":u) .
     1802                                   hh:TOOLTIP = "История" .
     1803                                   v-h[ii] = hh:handle .
     1804                                   ii = ii + 1 .
     1805                                   hh:width-chars = 3 .
     1806                               end.
     1807                           when "b-sch" then
     1808                               do:
     1809                                   hh:load-image("cmp/b-sch.bmp":u) .
     1810                                   hh:TOOLTIP = "Установка Фильтра" .
     1811                                   v-h[ii] = hh:handle .
     1812                                   ii = ii + 1 .
     1813                                   hh:width-chars = 3 .
     1814                               end.
     1815                           when "b-hist-user" then
     1816                               do:
     1817                                   hh:load-image("cmp/b-hist.bmp":u) .
     1818                                   hh:TOOLTIP = "История пользователя" .
     1819                                   ii = ii + 1 .
     1820                               end.
     1821                       end case.
     1822                   end.
     1823                   hh = hh:next-sibling.
     1824               end.
     1825               b-help:column = v-frame-width - b-help:width-chars.
     1826               jj = 0.
     1827               repeat ii = 4 to 1 by -1 :
     1828                   if valid-handle (v-h[ii] ) then
     1829                   do:
     1830                       jj  = jj + 1 .
     1831                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1832                       v-h[ii]:row    = v-help-old-y .
     1833                   end.
     1834               end.
     1835           end.
     1836       end.
     1837   end procedure.
     1838   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1839   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1840   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1841   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1842   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1843   define variable v-diasize-current-frame-height as decimal   no-undo .
     1844   define variable v-diasize-change-size          as logical   no-undo .
     1845   define variable v-diasize-resize-button        as handle    no-undo .
     1846   define variable v-diasize-wndmax               as logical   no-undo .
     1847   define variable v-diasize-wndstore             as logical   no-undo .
     1848   define variable v-diasize-proc-name            as character no-undo .
     1849   define variable v-diasize-browse-handle        as handle    no-undo .
     1850   define variable v-diasize-browse-number        as integer   no-undo .
     1851   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1852   define temp-table temp-diasize-handle no-undo
     1853     field handle-value  as handle
     1854     field save-position as decimal
     1855     index xpk is primary unique handle-value
     1856     .
     1857   define temp-table temp-browse-handle no-undo
     1858     field browse-type   as character
     1859     field browse-number as integer
     1860     field browse-handle as handle
     1861     field original-size as decimal
     1862     index xpk is primary unique browse-type browse-number
     1863     index xie browse-type browse-handle
     1864   .
     1865   procedure diasize_change-height :
     1866     define input  parameter p-change-value  as decimal   no-undo .
     1867     define input  parameter p-move-resize   as logical   no-undo .
     1868     define variable v-field-group-handle    as handle    no-undo .
     1869     define variable v-object-handle         as handle    no-undo .
     1870     define variable v-frame-height          as decimal   no-undo .
     1871     define variable v-frame-virtual-height  as decimal   no-undo .
     1872     define variable v-browse-height         as decimal   no-undo .
     1873     define variable v-window-height         as decimal   no-undo .
     1874     define variable v-window-virtual-height as decimal   no-undo .
     1875     define variable v-change-sign           as integer   no-undo .
     1876     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1877     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1878     if p-change-value > 0
     1879     then do:
     1880       if frame Dialog-Frame :height + p-change-value
     1881           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1882       then do:
     1883         assign
     1884           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1885                           - (frame Dialog-Frame :height-chars)
     1886         .
     1887         if p-change-value <= 0
     1888         then do:
     1889           run diasize_position-resize-button in this-procedure .
     1890           return .
     1891         end.
     1892       end.
     1893     end.
     1894     if p-change-value < 0
     1895     then do:
     1896       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1897       then do:
     1898         assign
     1899           p-change-value = v-diasize-orig-frame-height
     1900                          - (frame Dialog-Frame :height-chars)
     1901         .
     1902         if p-change-value >= 0
     1903         then do:
     1904           run diasize_position-resize-button in this-procedure .
     1905           return .
     1906         end.
     1907       end.
     1908     end.
     1909     if p-change-value >= 0
     1910     then do:
     1911       assign
     1912         v-change-sign = 1
     1913       .
     1914     end.
     1915     else do:
     1916       assign
     1917         v-change-sign = -1
     1918       .
     1919     end.
     1920     assign
     1921       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1922     .
     1923     if p-change-value = 0
     1924     then do:
     1925       run diasize_position-resize-button in this-procedure .
     1926       return .
     1927     end.
     1928     move_block:
     1929     do
     1930     on error undo move_block, retry move_block
     1931     :
     1932       if retry
     1933       then do:
     1934         do
     1935         on error undo move_block, leave move_block
     1936         :
     1937           if p-change-value > 0
     1938           then do:
     1939             for each buf_temp-diasize-handle
     1940             on error undo, next
     1941             :
     1942               assign
     1943                 v-object-handle = buf_temp-diasize-handle.handle-value
     1944               .
     1945               if v-object-handle <> v-diasize-resize-button
     1946               then do:
     1947                 assign
     1948                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1949                 .
     1950               end.
     1951             end.
     1952             assign
     1953               v-diasize-browse-handle :height = v-browse-height
     1954             .
     1955             for each buf_temp-browse-handle
     1956               where buf_temp-browse-handle.browse-type = 'height':u
     1957             on error undo, next
     1958             :
     1959               assign
     1960                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1961               .
     1962             end.
     1963             assign
     1964               frame Dialog-Frame :height = v-frame-height
     1965             .
     1966             if frame Dialog-Frame :scrollable = true
     1967             then do:
     1968               assign
     1969                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1970               .
     1971             end.
     1972             run diasize_position-resize-button in this-procedure .
     1973           end.
     1974           else do:
     1975             if frame Dialog-Frame :scrollable = true
     1976             then do:
     1977               assign
     1978                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1979               .
     1980             end.
     1981             assign
     1982               frame Dialog-Frame :height = v-frame-height
     1983             .
     1984             assign
     1985               v-diasize-browse-handle :height = v-browse-height
     1986             .
     1987             for each buf_temp-browse-handle
     1988               where buf_temp-browse-handle.browse-type = 'height':u
     1989             on error undo, next
     1990             :
     1991               assign
     1992                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1993               .
     1994             end.
     1995             for each buf_temp-diasize-handle
     1996             on error undo, next
     1997             :
     1998               assign
     1999                 v-object-handle = buf_temp-diasize-handle.handle-value
     2000               .
     2001               if v-object-handle <> v-diasize-resize-button
     2002               then do:
     2003                 assign
     2004                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2005                 .
     2006               end.
     2007             end.
     2008             run diasize_position-resize-button in this-procedure .
     2009           end.
     2010           assign
     2011             v-diasize-change-size = false
     2012           .
     2013           leave move_block .
     2014         end.
     2015       end.
     2016       assign
     2017         v-diasize-need-full-display = true
     2018       .
     2019       if v-diasize-change-size = false
     2020       then do:
     2021         assign
     2022           v-diasize-change-size = true
     2023         .
     2024       end.
     2025       else do:
     2026         return .
     2027       end.
     2028       assign
     2029         v-frame-height = frame Dialog-Frame :height
     2030         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2031         v-browse-height = v-diasize-browse-handle :height
     2032       .
     2033       for each buf_temp-browse-handle
     2034         where buf_temp-browse-handle.browse-type = 'height':u
     2035       :
     2036         assign
     2037           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2038         .
     2039       end.
     2040       for each buf_temp-diasize-handle
     2041       :
     2042         delete buf_temp-diasize-handle .
     2043       end.
     2044       assign
     2045         v-field-group-handle = frame Dialog-Frame :first-child
     2046       .
     2047       do while valid-handle(v-field-group-handle)
     2048       :
     2049         assign
     2050           v-object-handle = v-field-group-handle :first-child
     2051         .
     2052         do while valid-handle(v-object-handle)
     2053         :
     2054           if  v-object-handle <> v-diasize-browse-handle :handle
     2055           and can-query(v-object-handle, "row")
     2056           and can-query(v-object-handle, "height")
     2057           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2058           then do:
     2059             find first buf_temp-browse-handle
     2060               where buf_temp-browse-handle.browse-type   = 'height':u
     2061                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2062               no-error .
     2063             if available buf_temp-browse-handle
     2064             then do:
     2065             end.
     2066             else do:
     2067               create buf_temp-diasize-handle .
     2068               assign
     2069                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2070                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2071               .
     2072             end.
     2073           end.
     2074           assign
     2075             v-object-handle = v-object-handle :next-sibling
     2076           .
     2077         end.
     2078         assign
     2079           v-field-group-handle = v-field-group-handle :next-sibling
     2080         .
     2081       end.
     2082       do with frame Dialog-Frame
     2083       :
     2084         hide v-diasize-resize-button .
     2085         assign
     2086           v-diasize-resize-button :row    = 1
     2087           v-diasize-resize-button :column = 1
     2088         .
     2089       end.
     2090       if p-change-value > 0
     2091       then do:
     2092         if frame Dialog-Frame :scrollable = true
     2093         then do:
     2094           assign
     2095             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2096             no-error .
     2097           if error-status :error
     2098           or error-status :get-message(1) <> ""
     2099           then do:
     2100             undo move_block, retry move_block .
     2101           end.
     2102         end.
     2103         assign
     2104           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2105           no-error .
     2106         if error-status :error
     2107         or error-status :get-message(1) <> ""
     2108         then do:
     2109           undo move_block, retry move_block .
     2110         end.
     2111         assign
     2112           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2113           no-error .
     2114         if error-status :error
     2115         or error-status :get-message(1) <> ""
     2116         then do:
     2117           undo move_block, retry move_block .
     2118         end.
     2119         for each buf_temp-browse-handle
     2120           where buf_temp-browse-handle.browse-type = 'height':u
     2121         on error undo move_block, retry move_block
     2122         :
     2123           assign
     2124             buf_temp-browse-handle.browse-handle :height
     2125               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2126             no-error .
     2127           if error-status :error
     2128           or error-status :get-message(1) <> ""
     2129           then do:
     2130             undo move_block, retry move_block .
     2131           end.
     2132         end.
     2133         for each buf_temp-diasize-handle
     2134         on error undo move_block, retry move_block
     2135         :
     2136           assign
     2137             v-object-handle = buf_temp-diasize-handle.handle-value
     2138           .
     2139           if v-object-handle <> v-diasize-resize-button
     2140           then do:
     2141             assign
     2142               v-object-handle :row = v-object-handle :row + p-change-value
     2143               no-error .
     2144             if error-status :error
     2145             or error-status :get-message(1) <> ""
     2146             then do:
     2147               undo move_block, retry move_block .
     2148             end.
     2149           end.
     2150         end.
     2151       end.
     2152       else do:
     2153         for each buf_temp-diasize-handle
     2154         on error undo move_block, retry move_block
     2155         :
     2156           assign
     2157             v-object-handle = buf_temp-diasize-handle.handle-value
     2158           .
     2159           if v-object-handle <> v-diasize-resize-button
     2160           then do:
     2161             assign
     2162               v-object-handle :row = v-object-handle :row + p-change-value
     2163               no-error .
     2164             if error-status :error
     2165             or error-status :get-message(1) <> ""
     2166             then do:
     2167               undo move_block, retry move_block .
     2168             end.
     2169           end.
     2170         end.
     2171         assign
     2172           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2173           no-error .
     2174         if error-status :error
     2175         or error-status :get-message(1) <> ""
     2176         then do:
     2177           undo move_block, retry move_block .
     2178         end.
     2179         for each buf_temp-browse-handle
     2180           where buf_temp-browse-handle.browse-type = 'height':u
     2181         on error undo move_block, retry move_block
     2182         :
     2183           assign
     2184             buf_temp-browse-handle.browse-handle :height
     2185               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2186             no-error .
     2187           if error-status :error
     2188           or error-status :get-message(1) <> ""
     2189           then do:
     2190             undo move_block, retry move_block .
     2191           end.
     2192         end.
     2193         assign
     2194           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2195           no-error .
     2196         if error-status :error
     2197         or error-status :get-message(1) <> ""
     2198         then do:
     2199           undo move_block, retry move_block .
     2200         end.
     2201         if frame Dialog-Frame :scrollable = true
     2202         then do:
     2203           assign
     2204             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2205             no-error .
     2206           if error-status :error
     2207           or error-status :get-message(1) <> ""
     2208           then do:
     2209             undo move_block, retry move_block .
     2210           end.
     2211         end.
     2212       end.
     2213       if p-move-resize = true
     2214       then do:
     2215         run diasize_position-resize-button in this-procedure .
     2216       end.
     2217       if v-diasize-wndstore = true
     2218       then do:
     2219         if connected("ub") = true
     2220         then do:
     2221           define variable v-cntxt-db-num        as integer   no-undo .
     2222           define variable v-cntxt-userid        as character no-undo .
     2223           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2224                                             , OUTPUT v-cntxt-userid
     2225                                             ) .
     2226           run gbl/wndsizew.p
     2227             (input  v-cntxt-db-num
     2228             ,input  v-cntxt-userid
     2229             ,input  v-diasize-proc-name
     2230             ,input  'height':u
     2231             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2232             ) .
     2233         end.
     2234       end.
     2235     end.
     2236     assign
     2237       v-diasize-change-size = false
     2238     .
     2239   end procedure.
     2240   procedure diasize_set-height :
     2241     define input  parameter p-new-height  as decimal   no-undo .
     2242     define input  parameter p-move-resize as logical   no-undo .
     2243     do
     2244     on error undo, return error return-value
     2245     :
     2246       run diasize_change-height in this-procedure
     2247         (input  (p-new-height - frame Dialog-Frame :height)
     2248         ,input  p-move-resize
     2249         ) .
     2250     end.
     2251   end procedure.
     2252   procedure diasize_change-width :
     2253     define input  parameter p-change-value as decimal   no-undo .
     2254     define input  parameter p-move-resize  as logical   no-undo .
     2255     define variable v-field-group-handle   as handle    no-undo .
     2256     define variable v-object-handle        as handle    no-undo .
     2257     define variable v-frame-width          as decimal   no-undo .
     2258     define variable v-frame-virtual-width  as decimal   no-undo .
     2259     define variable v-browse-width         as decimal   no-undo .
     2260     define variable v-window-width         as decimal   no-undo .
     2261     define variable v-window-virtual-width as decimal   no-undo .
     2262     define variable v-change-sign          as integer   no-undo .
     2263     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2264     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2265     if p-change-value > 0
     2266     then do:
     2267       if frame Dialog-Frame :width + p-change-value >
     2268           session :width-chars
     2269       then do:
     2270         assign
     2271           p-change-value = session :width-chars - frame Dialog-Frame :width
     2272         .
     2273         if p-change-value <= 0
     2274         then do:
     2275           run diasize_position-resize-button in this-procedure .
     2276           return .
     2277         end.
     2278       end.
     2279     end.
     2280     if p-change-value < 0
     2281     then do:
     2282       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2283       then do:
     2284         assign
     2285           p-change-value = v-diasize-orig-frame-width
     2286                          - frame Dialog-Frame :width
     2287         .
     2288         if p-change-value >= 0
     2289         then do:
     2290           run diasize_position-resize-button in this-procedure .
     2291           return .
     2292         end.
     2293       end.
     2294     end.
     2295     if p-change-value >= 0
     2296     then do:
     2297       assign
     2298         v-change-sign = 1
     2299       .
     2300     end.
     2301     else do:
     2302       assign
     2303         v-change-sign = -1
     2304       .
     2305     end.
     2306     assign
     2307       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2308     .
     2309     if p-change-value = 0
     2310     then do:
     2311       run diasize_position-resize-button in this-procedure .
     2312       return .
     2313     end.
     2314     move_block:
     2315     do
     2316     on error undo move_block, leave move_block
     2317     :
     2318       if retry
     2319       then do:
     2320         do
     2321         on error undo move_block, leave move_block
     2322         :
     2323           if p-change-value > 0
     2324           then do:
     2325             for each buf_temp-diasize-handle
     2326             on error undo, next
     2327             :
     2328               assign
     2329                 v-object-handle = buf_temp-diasize-handle.handle-value
     2330               .
     2331               if v-object-handle <> v-diasize-resize-button
     2332               then do:
     2333                 assign
     2334                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2335                 .
     2336               end.
     2337             end.
     2338             assign
     2339               v-diasize-browse-handle :width = v-browse-width
     2340             .
     2341             for each buf_temp-browse-handle
     2342               where buf_temp-browse-handle.browse-type = 'width':u
     2343             on error undo, next
     2344             :
     2345               assign
     2346                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2347               .
     2348             end.
     2349             assign
     2350               frame Dialog-Frame :width = v-frame-width
     2351             .
     2352             if frame Dialog-Frame :scrollable = true
     2353             then do:
     2354               assign
     2355                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2356               .
     2357             end.
     2358             run diasize_position-resize-button in this-procedure .
     2359           end.
     2360           else do:
     2361             if frame Dialog-Frame :scrollable = true
     2362             then do:
     2363               assign
     2364                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2365               .
     2366             end.
     2367             assign
     2368               frame Dialog-Frame :width = v-frame-width
     2369             .
     2370             for each buf_temp-browse-handle
     2371               where buf_temp-browse-handle.browse-type = 'width':u
     2372             on error undo, next
     2373             :
     2374               assign
     2375                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2376               .
     2377             end.
     2378             assign
     2379               v-diasize-browse-handle :width = v-browse-width
     2380             .
     2381             for each buf_temp-diasize-handle
     2382             on error undo, next
     2383             :
     2384               assign
     2385                 v-object-handle = buf_temp-diasize-handle.handle-value
     2386               .
     2387               if v-object-handle <> v-diasize-resize-button
     2388               then do:
     2389                 assign
     2390                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2391                 .
     2392               end.
     2393             end.
     2394             run diasize_position-resize-button in this-procedure .
     2395           end.
     2396           assign
     2397             v-diasize-change-size = false
     2398           .
     2399           leave move_block .
     2400         end.
     2401       end.
     2402       assign
     2403         v-diasize-need-full-display = true
     2404       .
     2405       if v-diasize-change-size = false
     2406       then do:
     2407         assign
     2408           v-diasize-change-size = true
     2409         .
     2410       end.
     2411       else do:
     2412         return .
     2413       end.
     2414       assign
     2415         v-frame-width = frame Dialog-Frame :width
     2416         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2417         v-browse-width = v-diasize-browse-handle :width
     2418       .
     2419       for each buf_temp-browse-handle
     2420         where buf_temp-browse-handle.browse-type = 'width':u
     2421       :
     2422         assign
     2423           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2424         .
     2425       end.
     2426       for each buf_temp-diasize-handle
     2427       :
     2428         delete buf_temp-diasize-handle .
     2429       end.
     2430       assign
     2431         v-field-group-handle = frame Dialog-Frame :first-child
     2432       .
     2433       do while valid-handle(v-field-group-handle)
     2434       :
     2435         assign
     2436           v-object-handle = v-field-group-handle :first-child
     2437         .
     2438         do while valid-handle(v-object-handle)
     2439         :
     2440           if  v-object-handle <> v-diasize-browse-handle :handle
     2441           and v-object-handle <> v-diasize-resize-button
     2442           and can-query(v-object-handle, "row")
     2443           and can-query(v-object-handle, "height")
     2444           and ( v-object-handle :col + v-object-handle :width
     2445                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2446               )
     2447           then do:
     2448             find first buf_temp-browse-handle
     2449               where buf_temp-browse-handle.browse-type   = 'width':u
     2450                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2451               no-error .
     2452             if available buf_temp-browse-handle
     2453             then do:
     2454             end.
     2455             else do:
     2456               create buf_temp-diasize-handle .
     2457               assign
     2458                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2459                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2460               .
     2461             end.
     2462           end.
     2463           assign
     2464             v-object-handle = v-object-handle :next-sibling
     2465           .
     2466         end.
     2467         assign
     2468           v-field-group-handle = v-field-group-handle :next-sibling
     2469         .
     2470       end.
     2471       do with frame Dialog-Frame
     2472       :
     2473         hide v-diasize-resize-button .
     2474         v-diasize-resize-button :row = 1.
     2475         v-diasize-resize-button :column = 1.
     2476       end.
     2477       if p-change-value > 0
     2478       then do:
     2479         if frame Dialog-Frame :scrollable = true
     2480         then do:
     2481           assign
     2482             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2483             no-error .
     2484           if error-status :error
     2485           or error-status :get-message(1) <> ""
     2486           then do:
     2487             undo move_block, retry move_block.
     2488           end.
     2489         end.
     2490         assign
     2491           frame Dialog-Frame :width = v-frame-width + p-change-value
     2492           no-error .
     2493         if error-status :error
     2494         or error-status :get-message(1) <> ""
     2495         then do:
     2496           undo move_block, retry move_block.
     2497         end.
     2498         assign
     2499           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2500         no-error .
     2501         if error-status :error
     2502         or error-status :get-message(1) <> ""
     2503         then do:
     2504           undo move_block, retry move_block.
     2505         end.
     2506         for each buf_temp-browse-handle
     2507           where buf_temp-browse-handle.browse-type = 'width':u
     2508         on error undo move_block, retry move_block
     2509         :
     2510           assign
     2511             buf_temp-browse-handle.browse-handle :width
     2512               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2513             no-error .
     2514           if error-status :error
     2515           or error-status :get-message(1) <> ""
     2516           then do:
     2517             undo move_block, retry move_block .
     2518           end.
     2519         end.
     2520         for each buf_temp-diasize-handle
     2521         on error undo move_block, retry move_block
     2522         :
     2523           assign
     2524             v-object-handle = buf_temp-diasize-handle.handle-value
     2525           .
     2526           if v-object-handle <> v-diasize-resize-button
     2527           then do:
     2528             assign
     2529               v-object-handle :col = v-object-handle :col + p-change-value
     2530               no-error .
     2531             if error-status :error
     2532             or error-status :get-message(1) <> ""
     2533             then do:
     2534               undo move_block, retry move_block .
     2535             end.
     2536           end.
     2537         end.
     2538       end.
     2539       else do:
     2540         for each buf_temp-diasize-handle
     2541         on error undo move_block, retry move_block
     2542         :
     2543           assign
     2544             v-object-handle = buf_temp-diasize-handle.handle-value
     2545           .
     2546           if v-object-handle <> v-diasize-resize-button
     2547           then do:
     2548             assign
     2549               v-object-handle :col = v-object-handle :col + p-change-value
     2550               no-error .
     2551             if error-status :error
     2552             or error-status :get-message(1) <> ""
     2553             then do:
     2554               undo move_block, retry move_block .
     2555             end.
     2556           end.
     2557         end.
     2558         for each buf_temp-browse-handle
     2559           where buf_temp-browse-handle.browse-type = 'width':u
     2560         on error undo move_block, retry move_block
     2561         :
     2562           assign
     2563             buf_temp-browse-handle.browse-handle :width
     2564               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2565             no-error .
     2566           if error-status :error
     2567           or error-status :get-message(1) <> ""
     2568           then do:
     2569             undo move_block, retry move_block .
     2570           end.
     2571         end.
     2572         assign
     2573           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2574           no-error .
     2575         if error-status :error
     2576         or error-status :get-message(1) <> ""
     2577         then do:
     2578           undo move_block, retry move_block.
     2579         end.
     2580         assign
     2581           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2582         no-error .
     2583         if error-status :error
     2584         or error-status :get-message(1) <> ""
     2585         then do:
     2586           undo move_block, retry move_block.
     2587         end.
     2588         if frame Dialog-Frame :scrollable = true
     2589         then do:
     2590           assign
     2591             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2592           no-error .
     2593           if error-status :error
     2594           or error-status :get-message(1) <> ""
     2595           then do:
     2596             undo move_block, retry move_block.
     2597           end.
     2598         end.
     2599       end.
     2600       if p-move-resize
     2601       then do:
     2602         run diasize_position-resize-button in this-procedure .
     2603       end.
     2604       if v-diasize-wndstore = true
     2605       then do:
     2606         if connected("ub") = true
     2607         then do:
     2608           define variable v-cntxt-db-num        as integer   no-undo .
     2609           define variable v-cntxt-userid        as character no-undo .
     2610           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2611                                             , OUTPUT v-cntxt-userid
     2612                                             ) .
     2613           run gbl/wndsizew.p
     2614             (input  v-cntxt-db-num
     2615             ,input  v-cntxt-userid
     2616             ,input  v-diasize-proc-name
     2617             ,input  'width':u
     2618             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2619             ) .
     2620         end.
     2621       end.
     2622     end.
     2623     assign
     2624       v-diasize-change-size = false
     2625     .
     2626   end procedure.
     2627   procedure diasize_set-width :
     2628     define input  parameter p-new-width  as decimal   no-undo .
     2629     define input  parameter p-move-resize as logical   no-undo .
     2630     do
     2631     on error undo, return error return-value
     2632     :
     2633       run diasize_change-width in this-procedure
     2634         (input  (p-new-width - frame Dialog-Frame :width)
     2635         ,input  p-move-resize
     2636         ) .
     2637     end.
     2638   end procedure.
     2639   procedure diasize_position-resize-button :
     2640     do with frame Dialog-Frame
     2641     :
     2642       hide v-diasize-resize-button .
     2643       assign
     2644         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2645                     - 1
     2646                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2647         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2648                     - 1
     2649                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2650       .
     2651       view v-diasize-resize-button .
     2652     end.
     2653   end procedure.
     2654   on alt-right anywhere
     2655   do:
     2656     run diasize_change-width in this-procedure
     2657       (input 1
     2658       ,input true
     2659       ) .
     2660     return no-apply .
     2661   end.
     2662   on alt-left anywhere
     2663   do:
     2664     run diasize_change-width in this-procedure
     2665       (input -1
     2666       ,input true
     2667       ) .
     2668     return no-apply .
     2669   end.
     2670   on alt-down anywhere
     2671   do:
     2672     run diasize_change-height in this-procedure
     2673       (input 1
     2674       ,input true
     2675       ) .
     2676     return no-apply .
     2677   end.
     2678   on alt-up anywhere
     2679   do:
     2680     run diasize_change-height in this-procedure
     2681       (input -1
     2682       ,input true
     2683       ) .
     2684     return no-apply .
     2685   end.
     2686   on alt-enter of frame Dialog-Frame
     2687   do:
     2688     run diasize_maximize in this-procedure
     2689       (input  ?
     2690       ).
     2691     return no-apply .
     2692   end.
     2693   procedure diasize_end-move :
     2694     do
     2695     on error undo, return error return-value
     2696     :
     2697       define variable v-row-delta as decimal   no-undo .
     2698       define variable v-col-delta as decimal   no-undo .
     2699       define variable v-new-row as decimal   no-undo .
     2700       define variable v-new-col as decimal   no-undo .
     2701       assign
     2702         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2703         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2704       .
     2705       assign
     2706         v-row-delta = v-new-row - frame Dialog-Frame :height
     2707         v-col-delta = v-new-col - frame Dialog-Frame :width
     2708       .
     2709       run diasize_change-height in this-procedure
     2710         (input v-row-delta
     2711         ,input true
     2712         ) .
     2713       run diasize_change-width in this-procedure
     2714         (input v-col-delta
     2715         ,input true
     2716         ) .
     2717     end.
     2718   end procedure.
     2719   procedure diasize_maximize :
     2720     define input  parameter p-action as logical   no-undo .
     2721     do
     2722     on error undo, return error return-value
     2723     :
     2724       if p-action = ?
     2725       then do:
     2726         if v-diasize-need-maximize = true
     2727         then do:
     2728           assign
     2729             p-action = true
     2730           .
     2731         end.
     2732         else do:
     2733           assign
     2734             p-action = false
     2735           .
     2736         end.
     2737       end.
     2738       if p-action = true
     2739       then do:
     2740         run diasize_change-height in this-procedure
     2741           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2742               - frame Dialog-Frame :height-chars
     2743           ,input true
     2744           ) .
     2745         run diasize_change-width in this-procedure
     2746           (input session :width-chars
     2747               - frame Dialog-Frame :width-chars
     2748           ,input true
     2749           ) .
     2750         assign
     2751           v-diasize-need-maximize = false
     2752         .
     2753       end.
     2754       else do:
     2755         run diasize_change-width in this-procedure
     2756           (input v-diasize-orig-frame-width
     2757               - frame Dialog-Frame :width-chars
     2758           ,input true
     2759           ) .
     2760         run diasize_change-height in this-procedure
     2761           (input v-diasize-orig-frame-height
     2762               - frame Dialog-Frame :height-chars
     2763           ,input true
     2764           ) .
     2765         assign
     2766           v-diasize-need-maximize = true
     2767         .
     2768       end.
     2769     end.
     2770   end procedure.
     2771   procedure diasize_restore-orig-size :
     2772     do
     2773     on error undo, return error return-value
     2774     :
     2775       assign
     2776         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2777         v-diasize-current-frame-height = frame Dialog-Frame :height
     2778       .
     2779       run diasize_set-height in this-procedure
     2780         (input  v-diasize-orig-frame-height
     2781         ,input  true
     2782         ) .
     2783       run diasize_set-width in this-procedure
     2784         (input  v-diasize-orig-frame-width
     2785         ,input  true
     2786         ) .
     2787     end.
     2788   end procedure.
     2789   procedure diasize_restore-current-size :
     2790     do
     2791     on error undo, return error return-value
     2792     :
     2793       run diasize_set-height in this-procedure
     2794         (input  v-diasize-current-frame-height
     2795         ,input  true
     2796         ) .
     2797       run diasize_set-width in this-procedure
     2798         (input  v-diasize-current-frame-width
     2799         ,input  true
     2800         ) .
     2801     end.
     2802   end procedure.
     2803   procedure diasize_set-browse-handle :
     2804     define input  parameter p-browse-handle as handle   no-undo .
     2805     define buffer buf_temp-browse-handle for temp-browse-handle .
     2806     do
     2807     on error undo, return error return-value
     2808     :
     2809       assign
     2810         v-diasize-browse-handle = p-browse-handle
     2811       .
     2812       for each buf_temp-browse-handle
     2813       on error undo, return error return-value
     2814       :
     2815         delete buf_temp-browse-handle .
     2816       end.
     2817     end.
     2818   end procedure.
     2819   procedure diasize_add_browse :
     2820     define input  parameter p-browse-type   as character no-undo .
     2821     define input  parameter p-browse-handle as handle    no-undo .
     2822     define buffer buf_temp-browse-handle for temp-browse-handle .
     2823     do
     2824     on error undo, return error return-value
     2825     :
     2826       assign
     2827         v-diasize-browse-number = v-diasize-browse-number + 1
     2828       .
     2829       create buf_temp-browse-handle .
     2830       assign
     2831         buf_temp-browse-handle.browse-type   = p-browse-type
     2832         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2833         buf_temp-browse-handle.browse-handle = p-browse-handle
     2834       .
     2835     end.
     2836   end procedure.
     2837   procedure diasize_init :
     2838     define variable v-default-value    as logical   no-undo .
     2839     define variable v-restore-saved    as logical   no-undo .
     2840     define variable v-resize-value-str as character no-undo .
     2841     do
     2842     on error undo, return error return-value
     2843     :
     2844       do with frame Dialog-Frame
     2845       :
     2846         assign
     2847           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2848           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2849           v-diasize-browse-handle     = browse br-dis-gds-rule :handle
     2850         .
     2851         create button v-diasize-resize-button
     2852         assign
     2853           parent        = frame Dialog-Frame :first-child
     2854           label         = "s"
     2855           height-pixels = 16
     2856           width-pixels  = 16
     2857           visible       = true
     2858           sensitive     = true
     2859           movable       = true
     2860           triggers:
     2861             on end-move persistent run diasize_end-move in this-procedure .
     2862           end triggers.
     2863         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2864         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2865         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2866         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2867         assign
     2868           v-diasize-wndmax = false
     2869         .
     2870         if connected("ub") = true
     2871         then do:
     2872           define variable v-cntxt-db-num        as integer   no-undo .
     2873           define variable v-cntxt-userid        as character no-undo .
     2874           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2875                                             , OUTPUT v-cntxt-userid
     2876                                             ) .
     2877           run gbl/wndpar_r.p
     2878             (input  v-cntxt-db-num
     2879             ,input  v-cntxt-userid
     2880             ,input  'wndmax':U
     2881             ,output v-diasize-wndmax
     2882             ,output v-default-value
     2883             ) .
     2884         end.
     2885         assign
     2886           v-diasize-wndstore = false
     2887         .
     2888         if connected("ub") = true
     2889         then do:
     2890           run gbl/wndpar_r.p
     2891             (input  v-cntxt-db-num
     2892             ,input  v-cntxt-userid
     2893             ,input  'wndstore':U
     2894             ,output v-diasize-wndstore
     2895             ,output v-default-value
     2896             ) .
     2897         end.
     2898         assign
     2899           v-diasize-proc-name = entry(1, program-name(2), '.')
     2900         .
     2901         if v-diasize-wndstore = true
     2902         then do:
     2903           assign
     2904             v-restore-saved = false
     2905           .
     2906           if connected("ub") = true
     2907           then do:
     2908             run gbl/wndsizer.p
     2909               (input  v-cntxt-db-num
     2910               ,input  v-cntxt-userid
     2911               ,input  v-diasize-proc-name
     2912               ,input  'height':u
     2913               ,output v-resize-value-str
     2914               ) .
     2915             if v-resize-value-str <> '':U
     2916             then do:
     2917               run diasize_change-height in this-procedure
     2918                 (input  integer(v-resize-value-str)
     2919                 ,input  true
     2920                 ) .
     2921               assign
     2922                 v-restore-saved = true
     2923               .
     2924             end.
     2925           end.
     2926           if connected("ub") = true
     2927           then do:
     2928             run gbl/wndsizer.p
     2929               (input  v-cntxt-db-num
     2930               ,input  v-cntxt-userid
     2931               ,input  v-diasize-proc-name
     2932               ,input  'width':u
     2933               ,output v-resize-value-str
     2934               ) .
     2935             if v-resize-value-str <> '':U
     2936             then do:
     2937               run diasize_change-width in this-procedure
     2938                 (input  integer(v-resize-value-str)
     2939                 ,input  true
     2940                 ) .
     2941               assign
     2942                 v-restore-saved = true
     2943               .
     2944             end.
     2945           end.
     2946           if v-restore-saved <> true
     2947           then do:
     2948             if v-diasize-wndmax = true
     2949             then do:
     2950               run diasize_maximize in this-procedure
     2951                 (input  true
     2952                 ) .
     2953             end.
     2954           end.
     2955         end.
     2956         else do:
     2957           if v-diasize-wndmax = true
     2958           then do:
     2959             run diasize_maximize in this-procedure
     2960               (input  true
     2961               ) .
     2962           end.
     2963         end.
     2964       end.
     2965     end.
     2966   end procedure.
     2967   procedure diasize_need-full-display :
     2968     define output parameter p-need-full-display as logical   no-undo .
     2969     do
     2970     on error undo, return error return-value
     2971     :
     2972       assign
     2973         p-need-full-display = v-diasize-need-full-display
     2974       .
     2975       assign
     2976         v-diasize-need-full-display = false
     2977       .
     2978     end.
     2979   end procedure.
     2980   procedure get-context :
     2981      define output parameter p-db-num as integer          no-undo.
     2982      define output parameter p-user-id as character        no-undo.
     2983      define variable v-login               as character    no-undo.
     2984      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2985      define buffer buf_user-login  for ub.user-login .
     2986      do
     2987      on error undo, return error
     2988      :
     2989            FIND FIRST buf_sys-ctrl no-lock.
     2990            ASSIGN
     2991               v-login = USERID("ub")
     2992               p-db-num = buf_sys-ctrl.db-num
     2993            .
     2994            FIND FIRST buf_user-login
     2995                 WHERE buf_user-login.db-num = p-db-num
     2996                   AND buf_user-login.user-login = v-login
     2997                 no-lock
     2998                 no-error
     2999                 .
     3000            IF AVAILABLE buf_user-login
     3001            THEN DO:
     3002               assign
     3003                  p-user-id = buf_user-login.user-id
     3004               .
     3005            END.
     3006      end.
     3007   end procedure.
     3008   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3009   on f5 of frame Dialog-Frame anywhere
     3010   do:
     3011      v-doc-rec = recid(X_dis-gds-rule).  Run OpenBR in this-procedure ( input yes, input no, input '':U).  REPOSITION br-dis-gds-rule to recid v-doc-rec No-ERROR.               apply 'value-changed' to br-dis-gds-rule.
     3012       apply "VALUE-CHANGED" to BR-dis-gds-rule.
     3013   end.
     3014   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3015   on F9 of frame Dialog-Frame anywhere do:
     3016     if not available ub.goods then
     3017       return no-apply.
     3018     gds-rec = recid (ub.goods).
     3019     run ref/gds-form.w ( input parparentproc
     3020                         ,input 'ПРОСМОТР':U
     3021                         ,input ?
     3022                         ,input ?
     3023                         ,input ?
     3024                         ,input-output gds-rec).
     3025     apply "entry" to br-dis-gds-rule in frame Dialog-Frame.
     3026     return no-apply.
     3027   end.
     3028   on SHIFT-F9 of frame Dialog-Frame anywhere do:
     3029     if not available X_goods then
     3030       return no-apply.
     3031     gds-rec = recid (X_goods).
     3032     run ref/gds-form.w ( input parparentproc
     3033                         ,input 'ПРОСМОТР':U
     3034                         ,input ?
     3035                         ,input ?
     3036                         ,input ?
     3037                         ,input-output gds-rec).
     3038     apply "entry" to br-dis-gds-rule in frame Dialog-Frame.
     3039     return no-apply.
     3040   end.
     3041   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3042   procedure set-filter-name :
     3043   define input parameter p-filter-name as character no-undo .
     3044     do with frame Dialog-Frame:
     3045       if p-filter-name > "" then do:
     3046         assign
     3047           frame Dialog-Frame:title
     3048             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3049         .
     3050         assign
     3051           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3052         .
     3053       end.
     3054       else do:
     3055         assign
     3056           b-sch :tooltip = ""
     3057         .
     3058       end.
     3059     end.
     3060   end procedure.
     3061   def var sort-labelbr-dis-gds-rule   as character no-undo .
     3062   def var sort-clmnbr-dis-gds-rule    as handle    no-undo .
     3063   def var cur-clmnbr-dis-gds-rule     as handle    no-undo .
     3064   def var cur-clmn-locbr-dis-gds-rule as integer   no-undo .
     3065   def var re-querybr-dis-gds-rule     as logical   initial no no-undo .
     3066   on start-search, ctrl-o of br-dis-gds-rule in frame Dialog-Frame do:
     3067      run sort-brbr-dis-gds-rule
     3068        (input (if available X_dis-gds-rule
     3069                then recid(X_dis-gds-rule)
     3070                else ?
     3071               )
     3072        ).
     3073   end.
     3074   PROCEDURE sort-brbr-dis-gds-rule :
     3075     define input parameter p-recid as recid no-undo .
     3076     if re-querybr-dis-gds-rule = no then do:
     3077       assign
     3078          cur-clmnbr-dis-gds-rule = br-dis-gds-rule:current-column in frame Dialog-Frame
     3079       .
     3080       if sort-clmnbr-dis-gds-rule <> ? then sort-clmnbr-dis-gds-rule:column-fgcolor = 0.
     3081       if cur-clmnbr-dis-gds-rule = sort-clmnbr-dis-gds-rule then do:
     3082         assign
     3083            sort-labelbr-dis-gds-rule = ""
     3084            sort-clmnbr-dis-gds-rule = ?
     3085         .
     3086        end.
     3087        else do:
     3088          assign
     3089            sort-labelbr-dis-gds-rule = cur-clmnbr-dis-gds-rule:label
     3090            sort-clmnbr-dis-gds-rule  = cur-clmnbr-dis-gds-rule
     3091            sort-clmnbr-dis-gds-rule:column-fgcolor = 4
     3092          .
     3093        end.
     3094      end.
     3095     assign
     3096       cur-clmn-locbr-dis-gds-rule = 1
     3097     .
     3098     def var column-handle as handle no-undo .
     3099     column-handle = br-dis-gds-rule:first-column.
     3100     do while valid-handle(column-handle) :
     3101       if column-handle = cur-clmnbr-dis-gds-rule then do:
     3102         leave .
     3103       end.
     3104       column-handle = column-handle:NEXT-COLUMN.
     3105       assign
     3106         cur-clmn-locbr-dis-gds-rule = cur-clmn-locbr-dis-gds-rule + 1
     3107       .
     3108     end.
     3109     case sort-labelbr-dis-gds-rule:
     3110           when '*'  then DO:    assign       sort-column-name = "mark-string(recid(X_dis-gds-rule), v-rid-list)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3111           when 'Код товара'  then DO:    assign       sort-column-name = "X_dis-gds-rule.gds-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3112           when 'Название'  then DO:    assign       sort-column-name = "X_goods.gds-name"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3113           when 'Артикул'  then DO:    assign       sort-column-name = "X_goods.artic"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3114           when 'Пр-ль'  then DO:    assign       sort-column-name = "(X_goods.prod-type + string(X_goods.prod-code))"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3115           when 'Тип правила'  then DO:    assign       sort-column-name = "X_dis-gds-rule.templ-rl-root"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3116           when 'Место использ.'  then DO:    assign       sort-column-name = "entry (lookup (X_dis-gds-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3117           when 'Тип объ'  then DO:    assign       sort-column-name = "X_dis-gds-rule.obj-type"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3118           when 'Код объ'  then DO:    assign       sort-column-name = "X_dis-gds-rule.obj-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3119           when 'Тип скидки'  then DO:    assign       sort-column-name = "entry (lookup (X_dis-gds-rule.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3120           when '№ правила'  then DO:    assign       sort-column-name = "X_dis-gds-rule.rule-num"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3121           when '№ корн.!правила'  then DO:    assign       sort-column-name = "X_dis-gds-rule.rule-num"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3122           when 'Детализ.'  then DO:    assign       sort-column-name = "X_dis-gds-rule.nonunique"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3123       otherwise do:
     3124         assign
     3125           sort-column-name = ""
     3126         .
     3127         run OpenBr in this-procedure ( input yes, input no, input no).
     3128         if sort-labelbr-dis-gds-rule <> "" then do:
     3129           assign
     3130             cur-clmnbr-dis-gds-rule:column-fgcolor = 0
     3131           .
     3132         end.
     3133         assign
     3134           cur-clmn-locbr-dis-gds-rule = ?
     3135         .
     3136       end.
     3137     end case.
     3138     if p-recid <> ? then do:
     3139       reposition br-dis-gds-rule to recid p-recid no-error.
     3140       apply "value-changed" to br-dis-gds-rule in frame Dialog-Frame.
     3141     end.
     3142     apply "entry" to br-dis-gds-rule in frame Dialog-Frame.
     3143   END PROCEDURE.
     3144   procedure re-open-query-srt-clmnbr-dis-gds-rule:
     3145   if cur-clmnbr-dis-gds-rule = ? then do:
     3146      run OpenBr in this-procedure ( input yes, input no, input no).
     3147   end.
     3148   else do:
     3149      assign re-querybr-dis-gds-rule = yes.
     3150      run sort-brbr-dis-gds-rule
     3151        (input (if available X_dis-gds-rule
     3152                then recid(X_dis-gds-rule)
     3153                else ?
     3154               )
     3155        ).
     3156      assign re-querybr-dis-gds-rule = no.
     3157   end.
     3158   end.
     3159   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3160   do:
     3161     BR-dis-gds-rule :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3162   end.
     3163   MAIN-BLOCK:
     3164   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3165      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3166   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3167     run mainmenu_getcntxt in parparentproc
     3168       (output v-cntxt-db-num
     3169       ,output v-cntxt-userid
     3170       ,output v-cntxt-level
     3171       ,output v-cntxt-host-code-obj
     3172       ,output v-cntxt-obj-type
     3173       ,output v-cntxt-obj-code
     3174       ,output v-cntxt-db-num-obj
     3175       ,output v-cntxt-is-admin
     3176       ) .
     3177     v-rid-list = p-rid-list.
     3178     IF lookup(p-list-mode, ('все':U + chr(4) +
     3179                             "pos" + chr(4) +
     3180                             "templ-rl-root" + chr(4) +
     3181                             "discnt-role" + chr(4) +
     3182                             'объект':U + chr(4) +
     3183                             ('объект':U + chr(44) + "pos-type":U) + chr(4) +
     3184                             ('объект':U + chr(44) + "templ-rl-root":U) + chr(4) +
     3185                             ('объект':U + chr(44) + "discnt-role":U) + chr(4) +
     3186                             "rule-num":U + chr(4) +
     3187                             "rl-root":U) , chr(4)) = 0
     3188     THEN DO:
     3189        MESSAGE
     3190        vss-workfile vss-revision vss-description skip
     3191        "Неверный параметр вызова p-list-mode " p-list-mode
     3192        VIEW-AS ALERT-BOX ERROR.
     3193        UNDO, RETURN ERROR.
     3194     END.
     3195     IF lookup('объект':U , p-list-mode) > 0 THEN DO:
     3196       IF p-curr-obj-type <> 'скл':U
     3197       AND p-curr-obj-type <> 'маг':U THEN DO:
     3198           MESSAGE
     3199           vss-workfile vss-revision vss-description skip
     3200           "Неверный параметр вызова p-curr-obj-type " p-curr-obj-type
     3201           VIEW-AS ALERT-BOX ERROR.
     3202           UNDO, RETURN ERROR.
     3203       END.
     3204       FIND FIRST X_clients-obj NO-LOCK WHERE
     3205                 X_clients-obj.obj-type = p-curr-obj-type
     3206            AND  X_clients-obj.obj-code = p-curr-obj-code NO-ERROR.
     3207       IF NOT AVAILABLE X_clients-obj THEN DO:
     3208           MESSAGE
     3209           vss-workfile vss-revision vss-description skip
     3210           "Неверные параметры вызова p-curr-obj-type p-curr-obj-code" p-curr-obj-type p-curr-obj-code
     3211           VIEW-AS ALERT-BOX ERROR.
     3212           UNDO, RETURN ERROR.
     3213       END.
     3214     end.
     3215     IF LOOKUP( "templ-rl-root", p-list-mode) > 0 THEN DO:
     3216         FIND FIRST PAR_dis-rule NO-LOCK WHERE
     3217                   par_dis-rule.rule-num = p-templ-rl-root no-error.
     3218         IF NOT AVAILABLE par_Dis-rule THEN DO:
     3219             MESSAGE
     3220             vss-workfile vss-revision vss-description skip
     3221             "Неверный параметр вызова p-templ-rl-root" p-templ-rl-root
     3222             VIEW-AS ALERT-BOX ERROR.
     3223             UNDO, RETURN ERROR.
     3224         END.
     3225     END.
     3226     IF LOOKUP( "pos-type", p-list-mode) > 0
     3227     AND lookup(p-pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U) = 0  THEN DO:
     3228         MESSAGE
     3229         vss-workfile vss-revision vss-description skip
     3230         "Неверный параметр вызова p-pos-type" p-pos-type
     3231         VIEW-AS ALERT-BOX ERROR.
     3232         UNDO, RETURN ERROR.
     3233     END.
     3234     IF LOOKUP( "discnt-role", p-list-mode) > 0 THEN DO:
     3235       FIND FIRST par_dis-cfg-rule NO-LOCK WHERE
     3236                 par_dis-cfg-rule.discnt-role = p-discnt-role
     3237             AND par_dis-cfg-rule.TABLE-name = 'dis-gds-rule':U NO-ERROR.
     3238       IF NOT AVAILABLE par_dis-cfg-rule  THEN DO:
     3239         MESSAGE
     3240         vss-workfile vss-revision vss-description skip
     3241         "Неверный параметр вызова p-discnt-role" p-discnt-role
     3242         VIEW-AS ALERT-BOX ERROR.
     3243         UNDO, RETURN ERROR.
     3244       END.
     3245     END.
     3246     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     3247     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     3248     WAIT-FOR GO OF FRAME Dialog-Frame.
     3249   END.
     3250   RUN disable_UI.
     3251   PROCEDURE disable_UI :
     3252     HIDE FRAME Dialog-Frame.
     3253   END PROCEDURE.
     3254   PROCEDURE enable_UI :
     3255     DISPLAY mark-num
     3256         WITH FRAME Dialog-Frame.
     3257     ENABLE b-quit B-mark B-sel b-gds b-dis-rule B-sch B-print b-history B-Help
     3258            BR-dis-gds-rule mark-num
     3259         WITH FRAME Dialog-Frame.
     3260     VIEW FRAME Dialog-Frame.
     3261     OPEN QUERY BR-dis-gds-rule FOR EACH X_dis-gds-rule NO-LOCK ,            FIRST X_goods NO-LOCK WHERE           X_goods.gds-code = X_dis-gds-rule.gds-code INDEXED-REPOSITION.
     3262   END PROCEDURE.
     3263   PROCEDURE MyEnable :
     3264   define variable v-h as handle no-undo .
     3265   define variable v-ii as integer no-undo .
     3266   v-h = BR-dis-gds-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     3267   DO while valid-handle(v-h)
     3268   and  v-ii < br-dis-gds-rule:num-COLUMNs IN FRAME Dialog-Frame:
     3269     v-ii = v-ii + 1.
     3270     if v-h:LABEL = 'Тип правила'
     3271     or v-h:LABEL = 'Тип скидки'
     3272     then do:
     3273       v-h:RESIZABLE = YES.
     3274     end.
     3275     ELSE DO:
     3276       v-h = v-h:NEXT-COLUMN.
     3277     END.
     3278   END.
     3279   DISPLAY
     3280   mark-num
     3281   WITH FRAME Dialog-Frame.
     3282   ENABLE
     3283   b-quit
     3284   B-mark WHEN LOOKUP("b-mark", bttn) > 0
     3285   B-sel WHEN LOOKUP("b-mark", bttn) > 0
     3286   B-sch
     3287   B-print
     3288   b-history
     3289   B-Help
     3290   b-dis-rule
     3291   b-gds
     3292   BR-dis-gds-rule
     3293   WITH FRAME Dialog-Frame.
     3294   VIEW FRAME Dialog-Frame.
     3295   RUn Openbr in this-procedure ( input yes, input no, input '':U).
     3296   END PROCEDURE.
     3297   PROCEDURE OpenBr :
     3298   define input  parameter p-open-query     as logical   no-undo .
     3299   define input  parameter p-find-next      as logical   no-undo .
     3300   define input  parameter p-find-condition as character no-undo .
     3301   define variable l-query-was-opened as logical no-undo .
     3302   define variable title0 as character no-undo init "Скидки на товар".
     3303   define variable p-host-code like ub.sysconf.host-code no-undo .
     3304   run waitfram-show in this-procedure ( input "Ждите...").
     3305   define variable sort-column-phrase as character no-undo .
     3306   case sort-column-name :
     3307     when "" then do:
     3308       assign
     3309         sort-column-phrase = ""
     3310       .
     3311     end.
     3312     otherwise do:
     3313       assign
     3314         sort-column-phrase = "by " + sort-column-name
     3315       .
     3316     end.
     3317   end case.
     3318   if not( p-curr-obj-type = "":U and p-curr-obj-code = 0 ) then do:
     3319   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3320   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3321     (input  p-curr-obj-type
     3322     ,input  p-curr-obj-code
     3323     ,output p-host-code
     3324     )  .
     3325   end.
     3326   define variable l-open-query as logical   no-undo .
     3327   filter-point = filter-point0 + p-list-mode.
     3328   CASE p-list-mode :
     3329     WHEN 'все':U        THEN DO:
     3330       ASSIGN
     3331       frame Dialog-Frame:TITLE =
     3332                                     substitute("&1"
     3333                                     , title0
     3334                                     )
     3335      filter-label = substitute("&1", filter-label0)
     3336                                     .
     3337   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3338   define variable  l-disable-where-29  as logical   no-undo .
     3339   define variable  l-filter-open-29    as logical   .
     3340   define variable  flt-rec-29       as recid     no-undo .
     3341   define variable  filter-name-29      as character no-undo .
     3342   define variable  where-phrase-29     as character no-undo .
     3343   define variable  sort-phrase-29      as character no-undo .
     3344   define variable  where-phrase-rus-29 as character no-undo .
     3345   define variable  sort-phrase-rus-29  as character no-undo .
     3346     run waitfram-show in this-procedure
     3347       (input "ЖДИТЕ ..."
     3348       ).
     3349   run gbl/flt-get.p
     3350     (input filter-point
     3351     ,output flt-rec-29
     3352     ,output filter-name-29
     3353     ,output where-phrase-29
     3354     ,output sort-phrase-29
     3355     ,output where-phrase-rus-29
     3356     ,output sort-phrase-rus-29
     3357     ).
     3358   if p-open-query then do:
     3359       run set-filter-name in this-procedure
     3360         (INPUT filter-name-29
     3361         ) no-error .
     3362     assign
     3363       l-filter-open-29 = false
     3364     .
     3365     if flt-rec-29 <> ?
     3366       or sort-column-phrase > ""
     3367     then do:
     3368       define variable  parameter-2-29 as character no-undo .
     3369       define variable  parameter-3-29 as character no-undo .
     3370       define variable  parameter-4-29 as character no-undo .
     3371       define variable  parameter-5-29 as character no-undo .
     3372       define variable  parameter-6-29 as character no-undo .
     3373       define variable  parameter-7-29 as character no-undo .
     3374         assign
     3375         parameter-3-29 =
     3376                                 "FOR EACH X_dis-gds-rule no-lock"
     3377         parameter-4-29 =
     3378           (
     3379             if (" X_dis-gds-rule.rule-num > 0 " + " " + where-phrase-29) <> ""
     3380             then " X_dis-gds-rule.rule-num > 0 " + " " + where-phrase-29
     3381             else "true"
     3382           )
     3383         parameter-5-29 = (" " + "" + " " + ", FIRST X_goods no-lock where X_goods.gds-code = X_dis-gds-rule.gds-code")
     3384         parameter-6-29 = if sort-phrase-29 = ''
     3385                              then
     3386           (
     3387           " " + "  " +
     3388             " " + sort-column-phrase +
     3389           " " + "  "
     3390           )
     3391                              else
     3392           (
     3393           " " + "  " +
     3394             " " + sort-column-phrase +
     3395           " " + sort-phrase-29
     3396           )
     3397         parameter-7-29 =
     3398           " indexed-reposition  "
     3399       .
     3400       do
     3401       on stop undo, leave
     3402       on error undo, leave
     3403       :
     3404         assign
     3405           l-disable-where-29 =
     3406             (" X_dis-gds-rule.rule-num > 0 " + " " + where-phrase-29 = "")
     3407         .
     3408         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3409                             ,input QUERY br-dis-gds-rule:HANDLE
     3410                             ,input parameter-3-29
     3411                             ,input parameter-4-29
     3412                             ,input parameter-5-29
     3413                             ,input parameter-6-29
     3414                             ,input parameter-7-29
     3415                             )
     3416         .
     3417         assign
     3418           l-filter-open-29 = true
     3419         .
     3420       end.
     3421       if l-filter-open-29 = false then do:
     3422         message
     3423           "Ошибка при фильтрации / сортировке" skip
     3424           "Будут показаны записи без учета фильтра" skip
     3425           view-as alert-box .
     3426       end.
     3427       else do:
     3428           assign
     3429             l-query-was-opened = true
     3430           .
     3431       end.
     3432     end.
     3433     if l-filter-open-29 = false then do:
     3434       OPEN QUERY br-dis-gds-rule FOR EACH X_dis-gds-rule no-lock
     3435         where  X_dis-gds-rule.rule-num > 0
     3436       , FIRST X_goods no-lock where X_goods.gds-code = X_dis-gds-rule.gds-code
     3437         indexed-reposition
     3438     .
     3439         assign
     3440           l-query-was-opened = true
     3441         .
     3442     end.
     3443   end.
     3444   else do:
     3445     assign
     3446       v-doc-rec = recid( X_dis-gds-rule )
     3447     .
     3448     do
     3449     on stop undo, leave
     3450     on error undo, leave
     3451     :
     3452       if QUERY br-dis-gds-rule:HANDLE:get-buffer-handle(1) = (buffer X_dis-gds-rule:handle) then do:
     3453         assign
     3454         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3455         parameter-4-29 =
     3456           "where ":u + " X_dis-gds-rule.rule-num > 0 " + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3457         parameter-5-29 = "  "
     3458       .
     3459         run fltopend_fltfindd in this-procedure  (
     3460                             input this-procedure:handle
     3461                             ,input QUERY br-dis-gds-rule:HANDLE
     3462                             ,input rowid(X_dis-gds-rule)
     3463                             ,input logical(parameter-2-29)
     3464                             ,input no-lock
     3465                             ,input (buffer X_dis-gds-rule:handle)
     3466                             ,input parameter-4-29
     3467                             ,input parameter-5-29
     3468                             ) no-error.
