      407   procedure fltfield-clear :
      408     define output parameter loc-fld as character no-undo.
      409     define output parameter loc-lab as character no-undo .
      410     define output parameter loc-spr as character no-undo .
      411     define output parameter loc-dim as character no-undo .
      412     assign
      413       loc-fld = ""
      414       loc-lab = ""
      415       loc-spr = ""
      416       loc-dim = "0"
      417     .
      418   end procedure .
      419   procedure fltfield-add :
      420     define input        parameter par-fld as character no-undo.
      421     define input        parameter par-lab as character no-undo .
      422     define input        parameter par-spr as character no-undo .
      423     define input-output parameter loc-fld as character no-undo.
      424     define input-output parameter loc-lab as character no-undo .
      425     define input-output parameter loc-spr as character no-undo .
      426     define input-output parameter loc-dim as character no-undo .
      427     do
      428     on error undo, return error
      429     :
      430       assign
      431       loc-fld = if loc-dim = '0'
      432                 then par-fld
      433                 else (loc-fld + chr(44) + par-fld)
      434       loc-lab = if loc-dim = '0'
      435                 then par-lab
      436                 else (loc-lab + chr(44) + par-lab)
      437       loc-spr = if loc-dim = '0'
      438                 then par-spr
      439                 else (loc-spr + chr(44) + par-spr)
      440       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      441                 string(integer(if num-entries(loc-dim) > 1
      442                               then entry(2, loc-dim)
      443                               else entry(1, loc-dim)
      444                               ) + 1)
      445       no-error
      446       .
      447     end.
      448   end procedure.
      449   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      450   define  stream PrnLibStream.
      451   procedure prn-lib-prn-file :
      452     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      453     define input parameter p-DIsabledoptions as integer no-undo .
      454     define variable v-report-name as character no-undo .
      455     define variable v-user-action as character no-undo .
      456     define variable v-printed     as logical   no-undo .
      457     define variable v-exist       as logical   no-undo .
      458     do
      459       on error undo, return error
      460       :
      461       run prn-lib-get-report-name  in this-procedure (
      462         input parParentProc
      463         ,output v-report-name
      464         ).
      465   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      466   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      467     (input  v-report-name
      468     ,input  2
      469     ,output v-exist
      470     )  .
      471       if NOT v-exist then
      472       DO:
      473         Message
      474           "Нет заданий на печать ! "
      475           view-as alert-box .
      476         Return  .
      477       End.
      478       run gbl/prnfilen.w
      479         (input  ""
      480         ,input  p-DisabledOptions
      481         ,input  string(v-report-name )
      482         ,input  7
      483         ,output v-user-action
      484         ,output v-printed
      485         ) .
      486       if v-printed then
      487       do:
      488         return "YES" .
      489       end.
      490       else
      491       do:
      492         return "NO" .
      493       end.
      494     end.
      495   end procedure.
      496   procedure prn-lib-open-stream :
      497     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      498     define input parameter p-page-size    as integer no-undo .
      499     define input parameter p-is-stream    as logical no-undo .
      500     define input parameter p-append       as logical no-undo .
      501     define variable v-report-name as character no-undo .
      502     do
      503       on error undo, return error
      504       :
      505       run prn-lib-get-report-name  in this-procedure (
      506         input parParentProc
      507         ,output v-report-name
      508         ).
      509       if p-is-stream then
      510       do:
      511         if p-append then
      512         do:
      513           output stream PrnLibStream to value( v-report-name )
      514             page-size value(p-page-size) append .
      515         end.
      516         if not p-append then
      517         do:
      518           output stream PrnLibStream to value( v-report-name )
      519             page-size value(p-page-size) .
      520         end.
      521       end.
      522       if not p-is-stream then
      523       do:
      524         if p-append then
      525         do:
      526           output to value( v-report-name )
      527             page-size value(p-page-size) append .
      528         end.
      529         if not p-append then
      530         do:
      531           output to value( v-report-name )
      532             page-size value(p-page-size) .
      533         end.
      534       end.
      535     end.
      536   end procedure.
      537   procedure prn-lib-open-exp :
      538     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      539     define input parameter p-is-stream    as logical no-undo .
      540     define input parameter p-is-append    as logical no-undo .
      541     define output parameter p-ReportFileName as char init "report" no-undo.
      542     define output parameter p-process as logical no-undo .
      543     define variable glog as logical no-undo .
      544     do
      545       on error undo, return error
      546       :
      547       SYSTEM-DIALOG GET-FILE p-ReportFileName
      548         TITLE      "Укажите путь"
      549         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      550         ASK-OVERWRITE
      551         CREATE-TEST-FILE
      552         SAVE-AS
      553         USE-FILENAME
      554         DEFAULT-EXTENSION "txt"
      555         UPDATE glog
      556         .
      557       if not glog then  return.
      558       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      559       if p-is-stream then
      560       do:
      561         if p-is-append then
      562         do:
      563           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      564         end.
      565         else
      566         do:
      567           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      568         end.
      569       end.
      570       else
      571       do:
      572         if p-is-append then
      573         do:
      574           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      575         end.
      576         else
      577         do:
      578           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      579         end.
      580       end.
      581       p-process = yes.
      582     end.
      583   end procedure.
      584   procedure prn-lib-get-report-name :
      585     define input parameter parParentProc  as widget-handle no-undo.
      586     define output parameter p-report-name as character no-undo .
      587     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      588   end procedure.
      589   procedure prn-lib-reportviewer-report-name :
      590     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      591     define input parameter p-report-name-html as character no-undo .
      592     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      593   end procedure.
      594   procedure prn-lib-reportviewer :
      595     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      596     define input parameter p-report-name-html as character no-undo .
      597     define input parameter p-param        as character no-undo .
      598     define variable v-excel           as character no-undo init 'TRUE' .
      599     define variable v-value-character as character no-undo .
      600     define variable v-value-integer   as character no-undo .
      601     define variable v-value-date      as date      no-undo .
      602     define variable v-value-decimal   as decimal   no-undo .
      603     define variable rep-excel         as logical   no-undo .
      604     define variable excel-string      as character no-undo .
      605     define variable v-param-type      as character no-undo .
      606     define variable v-tth             as handle    no-undo .
      607     run adm/shattri.p (
      608       input "get":U
      609       ,input  ""
      610       ,input  0
      611       ,input  'report-glob':U
      612       ,input  'rep-excel':U
      613       ,output v-value-character
      614       ,output v-value-date
      615       ,output v-value-decimal
      616       ,output v-value-integer
      617       ,output rep-excel
      618       ,output v-param-type
      619       ,INPUT-OUTPUT table-handle v-tth
      620       )  .
      621     if rep-excel then v-excel = "TRUE" .
      622     else v-excel = "FALSE" .
      623     if p-param eq ""
      624     then
      625        p-param = "EXCEL:" + v-excel.
      626     else
      627        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      628     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      629   end procedure.
      630   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      631   FUNCTION mark-string RETURNS CHARACTER
      632     ( input p-recid as recid, input mark-list as character  ) :
      633     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      634   END FUNCTION.
      635   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      636   procedure cur-time :
      637      define output parameter p-today as date      no-undo .
      638      define output parameter p-time  as integer   no-undo .
      639     do
      640     on error undo, return error
      641     :
      642       define variable v-date1 as date      no-undo .
      643       define variable v-date2 as date      no-undo .
      644       define variable v-time  as integer   no-undo .
      645       assign
      646         v-date1 = today
      647         v-time  = time
      648         v-date2 = today
      649       .
      650       if v-date1 <> v-date2
      651       then do:
      652         assign
      653           v-date1 = today
      654           v-time  = v-time
      655         .
      656       end.
      657       assign
      658         p-today = v-date1
      659         p-time  = v-time
      660       .
      661     end.
      662   end.
      663   function cur-time-date returns character
      664   :
      665     return string(today, '99/99/9999':U) .
      666   end.
      667   function cur-time-mjd returns decimal
      668   :
      669     define variable v-date as date      no-undo .
      670     define variable v-time as integer   no-undo .
      671     run cur-time in this-procedure
      672       (output v-date
      673       ,output v-time
      674       ) .
      675     return integer(v-date) - 2400002 + (v-time / 86400) .
      676   end.
      677   function cur-time-get-ending-index returns integer
      678   (input p-number as integer
      679   )
      680   :
      681     if p-number < 0
      682     or p-number = ?
      683     then do:
      684       return 1 .
      685     end.
      686     define variable v-rest as integer   no-undo .
      687     assign
      688       p-number = p-number modulo 100
      689     .
      690     if p-number < 20
      691     then do:
      692       assign
      693         v-rest = p-number
      694       .
      695     end.
      696     else do:
      697       assign
      698         v-rest = p-number modulo 10
      699       .
      700     end.
      701     case v-rest :
      702       when 1
      703       then do:
      704         return 2 .
      705       end.
      706       when 2 or
      707       when 3 or
      708       when 4
      709       then do:
      710         return 3 .
      711       end.
      712       otherwise do:
      713         return 1 .
      714       end.
      715     end case .
      716   end.
      717   procedure cur-time-mjd-to-date :
      718      define input  parameter i-mjd-diff as decimal no-undo.
      719      define output parameter o-Date     as date    no-undo.
      720      define output parameter o-Time     as integer no-undo.
      721      define variable v-day-number as integer   no-undo .
      722      if    i-mjd-diff < 0
      723         or i-mjd-diff = ?
      724      then do:
      725         return "?" .
      726      end.
      727      assign
      728         v-day-number = truncate(i-mjd-diff,0).
      729         o-Date = date(v-day-number + 2400002).
      730         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      731     .
      732   end.
      733   function cur-time-mjd-to-string returns character
      734   (input p-mjd-diff as decimal
      735   )
      736   :
      737     define variable v-day-number as integer   no-undo .
      738     define variable v-seconds    as integer   no-undo .
      739     define variable v-hour       as integer   no-undo .
      740     define variable v-min        as integer   no-undo .
      741     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      742     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      743     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      744     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      745     if p-mjd-diff < 0
      746     or p-mjd-diff = ?
      747     then do:
      748       return "?" .
      749     end.
      750     assign
      751       v-day-number = integer(truncate(p-mjd-diff,0))
      752       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      753     .
      754     if v-seconds > 86400
      755     then do:
      756       assign
      757         v-seconds = 86400 - 1
      758       .
      759     end.
      760     if v-seconds < 0
      761     then do:
      762       assign
      763         v-seconds = 0
      764       .
      765     end.
      766     assign
      767       v-hour = truncate(v-seconds / 3600, 0)
      768     .
      769     assign
      770       v-seconds = v-seconds modulo 3600
      771     .
      772     assign
      773       v-min = truncate(v-seconds / 60, 0)
      774     .
      775     assign
      776       v-seconds = v-seconds modulo 60
      777     .
      778     return
      779         (if v-day-number <> 0
      780           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      781           else ""
      782         )
      783       + (if v-day-number <> 0 or v-hour <> 0
      784           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      785           else ""
      786         )
      787       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      788           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      789           else ""
      790         )
      791       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      792       .
      793   end.
      794   function cur-time-string returns character
      795   :
      796     define variable v-date as date      no-undo .
      797     define variable v-time as integer   no-undo .
      798     run cur-time in this-procedure
      799       (output v-date
      800       ,output v-time
      801       ) .
      802     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      803   end.
      804   function cur-time-string-sec returns character
      805   :
      806     define variable v-date as date      no-undo .
      807     define variable v-time as integer   no-undo .
      808     run cur-time in this-procedure
      809       (output v-date
      810       ,output v-time
      811       ) .
      812     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      813   end.
      814   function cur-time-custom  returns character
      815   (input p-prefix as character
      816   ,input p-date-format as character
      817   ,input p-delimiter as character
      818   ,input p-time-format as character
      819   ,input p-suffix as character
      820   )
      821   :
      822     define variable v-date as date      no-undo .
      823     define variable v-time as integer   no-undo .
      824     run cur-time in this-procedure
      825       (output v-date
      826       ,output v-time
      827       ) .
      828     return
      829       p-prefix
      830       + string(v-date, p-date-format)
      831       + p-delimiter
      832       + string(v-time, p-time-format)
      833       + p-suffix
      834       .
      835   end.
      836   function cur-time-print  returns character
      837   :
      838     define variable v-date as date      no-undo .
      839     define variable v-time as integer   no-undo .
      840     run cur-time in this-procedure
      841       (output v-date
      842       ,output v-time
      843       ) .
      844     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      845   end.
      846   function cur-time-datetime returns datetime
      847   :
      848     define variable v-char as character no-undo .
      849     define variable v-datetime as datetime no-undo .
      850     v-char = cur-time-string().
      851     v-datetime = datetime(v-char).
      852     return  v-datetime.
      853   end.
      854   function cur-time-string-msec returns character
      855   :
      856     define variable v-date as datetime  no-undo .
      857     v-date = now.
      858     return string(v-date) .
      859   end.
      860   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      862   procedure fltopend_fltopend :
      863   define input parameter p-parent-handle as handle no-undo .
      864   define input parameter p-qh as handle no-undo .
      865   define input parameter p-flt-open-open-query  as character no-undo .
      866   define input parameter p-where-cond as character no-undo .
      867   define input parameter p-use-indFIRST-query-tail as character no-undo .
      868   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      869   define input parameter p-indexed-reposition as character no-undo .
      870     do
      871     on error undo, return error
      872     :
      873   define variable v-prepare-string as character no-undo .
      874   define variable glog as logical no-undo .
      875   assign
      876   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      877                      p-where-cond + chr(32)  +
      878                      p-use-indFIRST-query-tail + chr(32) +
      879                      p-use-ind-sort-clmn-by + chr(32) +
      880                      p-indexed-reposition
      881   .
      882   assign
      883   glog = p-qh:query-prepare(v-prepare-string) no-error .
      884   if not glog
      885   or error-status:error then do:
      886     message error-status:get-message(1) view-as alert-box .
      887     undo, return error .
      888   end.
      889   assign
      890   glog = p-qh:query-open no-error .
      891   if not glog
      892   or error-status:error then do:
      893     message error-status:get-message(1) view-as alert-box .
      894     undo, return error .
      895   end.
      896     end.
      897   end procedure.
      898   procedure fltopend_fltfindd :
      899   define input parameter p-parent-handle as handle no-undo .
      900   define input parameter p-qh as handle no-undo .
      901   define input parameter p-rowid as rowid no-undo .
      902   define input parameter p-next as logical no-undo .
      903   define input parameter p-lock as integer no-undo .
      904   define input parameter p-bh as handle no-undo .
      905   define input parameter p-where-cond as character no-undo .
      906   define input parameter p-use-index-phrase as character no-undo .
      907   define variable glog as logical no-undo .
      908   define variable v-qh as handle no-undo .
      909   define variable v-bh as handle no-undo .
      910   define variable v-recid as recid no-undo .
      911   define variable v-prepare-string as character no-undo .
      912   do
      913   on error undo, return error
      914   on stop undo, return error
      915   :
      916     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      917     create buffer v-bh for table p-bh buffer-name p-bh:name.
      918     create query v-qh.
      919     v-qh:set-buffers(v-bh).
      920     v-prepare-string = substitute("for each &1 &2 &3"
      921                                     ,v-bh:name
      922                                     ,p-where-cond
      923                                     ,p-use-index-phrase).
      924     glog = v-qh:query-prepare(v-prepare-string) no-error.
      925     if not glog then do:
      926       delete object v-qh.
      927       delete object v-bh.
      928       undo, return error .
      929     end.
      930     glog = v-qh:query-open no-error .
      931     if not glog then do:
      932       delete object v-qh.
      933       delete object v-bh.
      934       undo, return error .
      935     end.
      936     if p-next then do:
      937       v-qh:reposition-to-rowid(p-rowid) no-error .
      938       glog = v-qh:get-next( p-lock) no-error .
      939       glog = v-qh:get-next( p-lock) no-error .
      940       if not glog or v-qh:query-off-end = yes then do:
      941         glog = v-qh:get-first( p-lock) no-error .
      942       end.
      943     end.
      944     else do:
      945       glog = v-qh:get-first( p-lock) no-error .
      946     end.
      947     v-recid = v-bh:recid no-error .
      948     delete object v-qh.
      949     delete object v-bh.
      950     return string(v-recid) .
      951   end.
      952   end procedure.
      953   procedure fltopend_fltfindq :
      954   define input parameter p-parent-handle as handle no-undo .
      955   define input parameter p-qh as handle no-undo .
      956   define input parameter p-next as logical no-undo .
      957   define input parameter p-lock as integer no-undo .
      958   define input parameter p-flt-open-open-query  as character no-undo .
      959   define input parameter p-where-cond as character no-undo .
      960   define input parameter p-use-indFIRST-query-tail as character no-undo .
      961   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      962   define input parameter p-indexed-reposition as character no-undo .
      963   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      964   define variable glog as logical no-undo .
      965   define variable v-qh as handle no-undo .
      966   define variable v-bh as handle no-undo extent 18.
      967   define variable v-rowid as rowid no-undo extent 18.
      968   define variable v-ii as integer no-undo .
      969   define variable v-prepare-string as character no-undo .
      970   do
      971   on error undo, return error
      972   on stop undo, return error
      973   :
      974     create query v-qh.
      975     do v-ii = 1 to p-qh:num-buffers:
      976       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      977       assign
      978       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      979       no-error.
      980       v-qh:add-buffer(v-bh[v-ii]).
      981     end.
      982     assign
      983     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      984                       p-where-cond + chr(32)  +
      985                       p-use-indFIRST-query-tail + chr(32) +
      986                       p-use-ind-sort-clmn-by + chr(32) +
      987                       p-indexed-reposition
      988     .
      989     glog = v-qh:query-prepare( v-prepare-string) no-error .
      990     if not glog then do:
      991       delete object v-qh.
      992       do v-ii = 1 to p-qh:num-buffers:
      993         delete object v-bh[v-ii].
      994       end.
      995       undo, return error .
      996     end.
      997     glog = v-qh:query-open no-error .
      998     if not glog then do:
      999       delete object v-qh.
     1000       do v-ii = 1 to p-qh:num-buffers:
     1001         delete object v-bh[v-ii].
     1002       end.
     1003       undo, return error .
     1004     end.
     1005     if p-next then do:
     1006       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1007       glog = v-qh:get-next( p-lock) no-error .
     1008       glog = v-qh:get-next( p-lock) no-error .
     1009       if not glog or v-qh:query-off-end = yes then do:
     1010         glog = v-qh:get-first( p-lock) no-error .
     1011       end.
     1012     end.
     1013     else do:
     1014       glog = v-qh:get-first( p-lock) no-error .
     1015     end.
     1016     do v-ii = 1 to p-qh:num-buffers:
     1017       assign
     1018       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1019       no-error.
     1020     end.
     1021     delete object v-qh.
     1022     do v-ii = 1 to p-qh:num-buffers:
     1023       delete object v-bh[v-ii].
     1024     end.
     1025   end.
     1026   end procedure.
     1027   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   procedure dr-code :
     1029     do
     1030     on error undo, return error
     1031     :
     1032       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
     1033       define output parameter  p-des               like ub.dis-rule.des               no-undo .
     1034       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
     1035       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
     1036       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
     1037       define output parameter  p-level-1           as character no-undo .
     1038       define output parameter  p-level-2           as character no-undo .
     1039       define output parameter  p-global             as integer no-undo .
     1040       define output parameter  p-host               as integer no-undo .
     1041       define output parameter  p-object             as integer no-undo .
     1042       define output parameter  p-output-display as logical   no-undo .
     1043       define output parameter  p-tree           as char  no-undo .
     1044       define output parameter  p-other          as character no-undo .
     1045       define variable v-other as character no-undo .
     1046       define buffer buf_dis-rule for ub.dis-rule .
     1047       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1048       find first buf_dis-rule no-lock where
     1049                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1050       find first buf_dis-cfg-rule no-lock where
     1051               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     1052           and buf_dis-cfg-rule.pos-type = '':U
     1053           and buf_dis-cfg-rule.table-name = '':U
     1054           and buf_dis-cfg-rule.discnt-role = '':U
     1055           and buf_dis-cfg-rule.self-nonunique = '':U
     1056               no-error.
     1057       if not available buf_Dis-cfg-rule then do:
     1058           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
     1059       end.
     1060       assign
     1061       p-des = buf_dis-rule.des
     1062       p-discnt-type = buf_dis-rule.discnt-type
     1063       p-subject-type = buf_dis-rule.subject-type
     1064       p-value-type = buf_dis-rule.value-type
     1065       p-global = (if available buf_dis-cfg-rule
     1066                   then buf_dis-cfg-rule.has-global
     1067                   else 0)
     1068       p-host = (if available buf_dis-cfg-rule
     1069                 then buf_dis-cfg-rule.has-host
     1070                 else 0)
     1071       p-object = (if available buf_dis-cfg-rule
     1072                 then buf_dis-cfg-rule.has-obj
     1073                 else 0)
     1074       p-output-display = (buf_dis-rule.sts = integer('0':U))
     1075       p-tree = buf_Dis-rule.uniq-field
     1076       p-other = buf_dis-rule.other-inf
     1077       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
     1078       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
     1079                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
     1080                    else '')
     1081       .
     1082     end.
     1083   end procedure.
     1084   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1085   procedure disrules-fill-properties:
     1086   define input  parameter p-templ-rl-root as integer   no-undo .
     1087   define buffer buf_drt-prop for ub.drt-prop.
     1088   define buffer buf_temp-drt-prop for temp-drt-prop.
     1089   do
     1090   on error undo, return error return-value
     1091   :
     1092     for each buf_temp-drt-prop:
     1093       delete buf_temp-drt-prop.
     1094     end.
     1095     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1096       create buf_temp-drt-prop.
     1097       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1098     end.
     1099   end.
     1100   end procedure.
     1101   procedure disrules-get-interface-form :
     1102   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     1103   define output parameter p-form-name as character no-undo .
     1104   define buffer buf_temp-drt-prop for temp-drt-prop.
     1105   define buffer buf_drt-prop for ub.drt-prop.
     1106   find first buf_temp-drt-prop where
     1107             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     1108         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     1109         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     1110   if not available buf_temp-drt-prop then do:
     1111     find first buf_drt-prop where
     1112               buf_drt-prop.templ-rl-root = p-templ-rl-root
     1113           and buf_drt-prop.upper-prop-code = "InputForm"
     1114           and buf_drt-prop.prop-code = "FormName" no-error.
     1115     if available buf_drt-prop then do:
     1116       p-form-name = buf_drt-prop.property-value.
     1117     end.
     1118     else do:
     1119       p-form-name = "ref/dis-ruli.w".
     1120     end.
     1121   end.
     1122   else do:
     1123     p-form-name = buf_temp-drt-prop.property-value.
     1124   end.
     1125   end procedure.
     1126   ~
     1127   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1129   ~
     1130   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   procedure discfgru-check :
     1132   define input parameter p-table-name as character no-undo .
     1133   define input parameter p-templ-rl-root as integer no-undo .
     1134   define input parameter p-time-templ-rl-root as integer no-undo .
     1135   define input parameter p-pos-type as character no-undo .
     1136   define output parameter p-disnct-role as character no-undo .
     1137   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1138     do
     1139     on error undo, return error return-value
     1140     :
     1141       find first buf_dis-cfg-rule no-lock where
     1142               buf_dis-cfg-rule.table-name = p-table-name
     1143           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1144           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1145           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1146       if not available buf_dis-cfg-rule
     1147       or p-pos-type = "":U
     1148       then do:
     1149          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1150                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1151                                  , p-templ-rl-root
     1152                                  , (if p-time-templ-rl-root = ?
     1153                                     then '':U
     1154                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1155                                     )
     1156                                  ).
     1157       end.
     1158       assign
     1159       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1160       .
     1161     end.
     1162   end procedure.
     1163   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1164   FUNCTION get-region RETURNS CHARACTER
     1165     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1166     define variable par-region as character no-undo.
     1167     if parhost-code = 0 and
     1168          parobj-type = "":U and
     1169          parobj-code = 0 then do:
     1170          par-region = "Глобально".
     1171          return par-region.
     1172       end.
     1173       if parobj-type = 'орг':U then do:
     1174          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1175          return par-region.
     1176       end.
     1177       if parobj-type = 'регион':U
     1178       then do:
     1179          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1180          return par-region.
     1181       end.
     1182       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1183       return par-region.
     1184   END FUNCTION.
     1185   FUNCTION get-objregion RETURNS CHARACTER
     1186     (  input parobj-type as character, input parobj-code as integer ) :
     1187     define variable par-region as character no-undo.
     1188     if  parobj-type = "":U and
     1189         parobj-code = 0
     1190     then do:
     1191        par-region = "Глобально".
     1192     end.
     1193     else if parobj-type = 'орг':U
     1194     then do:
     1195        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1196     end.
     1197     else if parobj-type = 'регион':U
     1198     then do:
     1199        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1200     end.
     1201     else
     1202        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1203     return par-region.
     1204   END FUNCTION.
     1205   procedure disgdsru-name :
     1206   define buffer buf_dis-rule for ub.dis-rule.
     1207   do
     1208     on error undo, return error
     1209     :
     1210     define input  parameter p-templ-rl-root  as integer no-undo .
     1211     define output parameter p-label          as character no-undo .
     1212     find first buf_dis-rule no-lock where
     1213               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1214     if available buf_dis-rule
     1215     then do:
     1216       if buf_dis-rule.rule-num > 0 then
     1217       p-label = buf_dis-rule.des.
     1218     end.
     1219     else do:
     1220       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1221     end.
     1222   end.
     1223   end procedure.
     1224   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1225   define variable v-rule-label as character no-undo .
     1226   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1227                                        ,output v-rule-label) no-error.
     1228   return v-rule-label.
     1229   end function.
     1230   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1231   define variable v-rule-label as character no-undo .
     1232   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1233   end function.
     1234   procedure disgdsru-write :
     1235     do
     1236     on error undo, return error
     1237     :
     1238       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1239       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1240       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1241       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1242       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1243       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1244       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1245       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1246       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1247       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1248       define buffer buf_dis-rule for ub.dis-rule.
     1249       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1250       define variable v-label          as character no-undo .
     1251       define variable v-discnt-role as character no-undo .
     1252       run discfgru-check in this-procedure (
     1253                                             input 'dis-gds-rule':U
     1254                                            ,input p-templ-rl-root
     1255                                            ,input p-time-templ-rl-root
     1256                                            ,input p-pos-type
     1257                                            ,output v-discnt-role
     1258                                             ) no-error .
     1259       if error-status :error then do:
     1260         undo, return error return-value .
     1261       end.
     1262       if p-discnt-role = ? then do:
     1263         p-discnt-role = v-discnt-role.
     1264       end.
     1265       if p-discnt-role <> v-discnt-role then do:
     1266         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1267                                 ,p-gds-code
     1268                                 ,p-obj-type
     1269                                 ,p-obj-code
     1270                                 ,p-pos-type
     1271                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1272                                 ,chr(10)
     1273                                 ,p-templ-rl-root
     1274                                 ,p-rule-num).
     1275       end.
     1276       if p-pos-type = ? then do:
     1277   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   define variable v-param-type16 as character no-undo .
     1279   define variable v-value-date16 as date no-undo .
     1280   define variable v-value-decimal16 as decimal no-undo .
     1281   define variable v-value-integer16 as INTEGER no-undo .
     1282   define variable v-value-logical16 AS LOGICAL no-undo .
     1283   define variable v-tth16 as handle no-undo .
     1284   run adm/shattri.p (
     1285       input "get":U
     1286       ,input  p-obj-type
     1287       ,input  p-obj-code
     1288       ,input  'cd-sending':U
     1289       ,input  'dflt-cd':U
     1290       ,output p-pos-type
     1291       ,output v-value-date16
     1292       ,output v-value-decimal16
     1293       ,output v-value-integer16
     1294       ,output v-value-logical16
     1295       ,output v-param-type16
     1296       ,INPUT-OUTPUT table-handle v-tth16
     1297       )  .
     1298   delete object v-tth16 no-error.
     1299       end.
     1300       find first buf_dis-rule no-lock where
     1301                 buf_dis-rule.rule-num = p-rule-num no-error.
     1302       if not available buf_Dis-rule then do:
     1303         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1304                                 ,p-gds-code
     1305                                 ,p-obj-type
     1306                                 ,p-obj-code
     1307                                 ,p-pos-type
     1308                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1309                                 ,chr(10)
     1310                                 ,p-rule-num).
     1311       end.
     1312       if buf_dis-rule.root <> yes then do:
     1313         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1314                                 ,p-gds-code
     1315                                 ,p-obj-type
     1316                                 ,p-obj-code
     1317                                 ,p-pos-type
     1318                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1319                                 ,chr(10)
     1320                                 ,p-rule-num).
     1321       end.
     1322       if not (p-obj-type = buf_dis-rule.obj-type
     1323           and p-obj-code = buf_dis-rule.obj-code)
     1324       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1325                and
     1326                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1327        then do:
     1328         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1329                                 ,p-gds-code
     1330                                 ,p-obj-type
     1331                                 ,p-obj-code
     1332                                 ,p-pos-type
     1333                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1334                                 ,chr(10)
     1335                                 ) +
     1336                             substitute("Правило скидки &1 определено для &2&3" +
     1337                                        "а привязка к товару для &4"
     1338                                        ,buf_dis-rule.rule-num
     1339                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1340                                        ,chr(10)
     1341                                        ,get-objregion( p-obj-type, p-obj-code)
     1342                                        ))
     1343                                 .
     1344       end.
     1345       find first buf_dis-gds-rule exclusive-lock where
     1346                  buf_dis-gds-rule.gds-code  = p-gds-code
     1347              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1348              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1349              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1350              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1351              and buf_dis-gds-rule.nonunique = p-nonunique
     1352              no-error .
     1353       if not available buf_dis-gds-rule then do:
     1354         find first buf_dis-gds-rule exclusive-lock where
     1355                   buf_dis-gds-rule.gds-code  = p-gds-code
     1356               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1357               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1358               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1359               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1360               no-error .
     1361         if available buf_Dis-gds-rule then do:
     1362           if p-nonunique = ''
     1363           and available buf_dis-gds-rule
     1364           then do:
     1365             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1366                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1367                                      , p-gds-code
     1368                                      , buf_Dis-rule.obj-type
     1369                                      , buf_Dis-rule.obj-code
     1370                                      , p-nonunique
     1371                                     ).
     1372           end.
     1373           if available buf_dis-gds-rule
     1374           and buf_dis-gds-rule.nonunique = ''
     1375           and p-nonunique <> ''then do:
     1376             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1377                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1378                                      , p-gds-code
     1379                                      , buf_Dis-rule.obj-type
     1380                                      , buf_Dis-rule.obj-code
     1381                                     ).
     1382           end.
     1383         end.
     1384         create buf_dis-gds-rule .
     1385         assign
     1386         buf_dis-gds-rule.gds-code  = p-gds-code
     1387         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1388         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1389         buf_dis-gds-rule.pos-type = p-pos-type
     1390         buf_dis-gds-rule.discnt-role = v-discnt-role
     1391         buf_dis-gds-rule.rule-num = p-rule-num
     1392         buf_dis-gds-rule.nonunique = p-nonunique
     1393         no-error
     1394         .
     1395       end.
     1396       ASSIGN
     1397       buf_dis-gds-rule.rule-num = p-rule-num
     1398       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1399       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1400       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1401       buf_dis-gds-rule.nonunique = p-nonunique
     1402       no-error.
     1403     end.
     1404   end procedure.
     1405   PROCEDURE cmp-disgdsru-write :
     1406   do
     1407   on error undo, return error
     1408   :
     1409     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1410     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1411     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1412     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1413     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1414     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1415     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1416     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1417     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1418     define variable v-rule-label          as character no-undo .
     1419     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1420     define buffer buf_dis-rule     for ub.dis-rule.
     1421     run disgdsru-name in this-procedure (
     1422                                         input  p-templ-rl-root
     1423                                         ,output v-rule-label
     1424                                         ) no-error .
     1425     if error-status :error then do:
     1426       undo, return error return-value .
     1427     end.
     1428     find first buf_tt0-dis-gds-rule exclusive-lock where
     1429                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1430             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1431             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1432             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1433             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1434             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1435             no-error .
     1436     if not available buf_tt0-dis-gds-rule then do:
     1437       create buf_tt0-dis-gds-rule .
     1438       assign
     1439       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1440       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1441       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1442       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1443       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1444       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1445       no-error
     1446       .
     1447     end.
     1448     find first buf_dis-rule no-lock where
     1449               buf_dis-rule.rule-num = p-rule-num.
     1450     ASSIGN
     1451     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1452     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1453     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1454     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1455     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1456     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1457     no-error.
     1458     release buf_tt0-dis-gds-rule no-error .
     1459     if error-status:error then do:
     1460       undo, return error return-value .
     1461     end.
     1462   end.
     1463   END PROCEDURE.
     1464   procedure dsp-dis-rule :
     1465   define input parameter p-gds-code like ub.dis-gds-rule.gds-code no-undo .
     1466   define input parameter p-nonunique as character no-undo .
     1467   define input parameter p-obj-type like ub.dis-gds-rule.obj-type no-undo .
     1468   define input parameter p-obj-code like ub.dis-gds-rule.obj-code no-undo .
     1469   define input parameter p-discnt-role as character no-undo .
     1470   define input parameter p-pos-type as character no-undo .
     1471   define input parameter p-value like ub.dis-gds-rule.rule-num no-undo .
     1472   define buffer buf_dis-rule for ub.dis-rule.
     1473   DEFINE variable loc#log as logical no-undo.
     1474   define variable loc-doc-rec as recid no-undo .
     1475   define variable r-b-code like ub.bar-code.b-code no-undo .
     1476   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1477   define variable v-cfg-nonunique as character no-undo .
     1478     do
     1479     on error undo, return error
     1480     :
     1481       find first buf_dis-rule no-lock where
     1482                 buf_dis-rule.rule-num = p-value no-error .
     1483       if not available buf_dis-rule then do:
     1484         message substitute("Не найдено правило скидки с номером &1", p-value)
     1485         view-as alert-box error .
     1486         .
     1487         return.
     1488       end.
     1489   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1490   do:
     1491     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1492       (input  v-cntxt-db-num
     1493       ,input  v-cntxt-userid
     1494       ,input  0
     1495       ,input  'actn_discount_work':U
     1496       ,input  'global':U
     1497       ,input  0
     1498       ,input  '':U
     1499       ,input  0
     1500       ,input  0
     1501       ,input  0
     1502       ,input  0
     1503       ,input  true
     1504       ,output loc#log
     1505       )  .
     1506   end.
     1507       if not loc#log then return error.
     1508       ASSIGN
     1509       loc-doc-rec = recid(buf_dis-rule)
     1510       .
     1511       if p-gds-code <> ? then do:
     1512   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1513     (input  p-gds-code
     1514     ,input  ?
     1515     ,output r-b-code
     1516     )  .
     1517       end.
     1518       define variable v-form-name as character no-undo init "ref/dis-ruli.w".
     1519       run disrules-get-interface-form in this-procedure ( input buf_dis-rule.templ-rl-root
     1520                                                         ,output v-form-name) .
     1521       if p-discnt-role <> ''
     1522       and p-pos-type <> '' then do:
     1523         find first buf_dis-cfg-rule no-lock where
     1524                   buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
     1525               and buf_dis-cfg-rule.discnt-role = p-discnt-role
     1526               and buf_dis-cfg-rule.pos-type = p-pos-type
     1527               and buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     1528               no-error .
     1529         if available buf_dis-cfg-rule then do:
     1530           assign
     1531           v-cfg-nonunique = buf_dis-cfg-rule.nonunique.
     1532         end.
     1533       end.
     1534       if v-cfg-nonunique <> ''
     1535       and num-entries(v-cfg-nonunique, ".") > 1
     1536       then do:
     1537         case v-cfg-nonunique:
     1538           when "bar-code.b-code" then do:
     1539             r-b-code = integer(p-nonunique).
     1540           end.
     1541         end case.
     1542       end.
     1543       run value(v-form-name) (
     1544                        input parparentproc
     1545                       ,input 'ПРОСМОТР':U
     1546                       ,input buf_dis-rule.templ-rl-root
     1547                       ,input buf_dis-rule.host-code
     1548                       ,input buf_dis-rule.obj-type
     1549                       ,input buf_dis-rule.obj-code
     1550                       ,input buf_dis-rule.rule-num
     1551                       ,input buf_dis-rule.upper-rule-num
     1552                       ,input r-b-code
     1553                       ,input buf_dis-rule.time-templ-rl-root
     1554                       ,input '':U
     1555                       ,input-output loc-doc-rec
     1556                                   )
     1557       .
     1558     end.
     1559   end procedure.
     1560   DEFINE VARIABLE gds-rec AS RECID NO-UNDO.
     1561   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1562   define variable filter-label as character no-undo init "Скидки по товарам" .
     1563   define variable filter-label0 as character no-undo init "Скидки по товарам" .
     1564   define variable filter-point0 as character no-undo init "dis-gdss" .
     1565   define variable filter-point as character no-undo init "dis-gdss" .
     1566   define variable sort-column-name as character no-undo .
     1567   define variable v-rid-list as character no-undo .
