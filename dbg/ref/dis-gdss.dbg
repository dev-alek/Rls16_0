     5396     entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u) @ v-d-name
     5397     X_dis-gds-rule.rule-num
     5398     X_dis-gds-rule.rule-num
     5399     with frame List .
     5400     DOWN stream PrnLibStream 1 with frame List .
     5401     ii =  ii + 1 .
     5402     if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     5403     run waitfram-show in this-procedure ( input ("Просмотрено строк : " + string( ii )) ) .
     5404     GET next br-dis-gds-rule .
     5405   END.
     5406   run waitfram-hide in this-procedure .
     5407   PUT stream PrnLibStream Line format "X(130)" SKIP.
     5408   HIDE stream PrnLibStream FRAME BottomFrame .
     5409   output stream PrnLibStream close .
     5410   run prn-lib-prn-file in this-procedure (
     5411                                             input parParentProc
     5412                                             ,input 0
     5413                                             ).
     5414   reposition br-dis-gds-rule to recid v-rec no-error.
     5415   if error-status:error then do:
     5416     reposition br-dis-gds-rule to row 1 no-error.
     5417   end.
     5418   APPLy "ENTRY" to br-dis-gds-rule.
     5419   END PROCEDURE.
     5420   PROCEDURE proc-b-sch :
     5421   assign
     5422     tbl = 'dis-gds-rule'
     5423     join-tbl = 'X_dis-gds-rule'
     5424     fld = ""
