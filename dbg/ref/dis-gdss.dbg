     5426     spr = ""
     5427     dim = '0'
     5428     .
     5429     run fltfield-add in this-procedure('templ-rl-root', 'Номер типа(шаблона) правила', '',
     5430     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5431     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     5432     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5433     run fltfield-add in this-procedure('rule-num', '№ правила', '',
     5434     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5435     run fltfield-add in this-procedure('rl-root', '№ корн.правила', '',
     5436     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5437     run fltfield-add in this-procedure('pos-type', 'Место использ.', 'cd-types-discnt',
     5438     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5439     run fltfield-add in this-procedure('discnt-role', 'Тип скидки', '',
     5440     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5441     run fltfield-add in this-procedure('gds-code', 'Товар', 'gds',
     5442     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5443   Filter-Block:
     5444   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5445       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5446       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5447     run gbl/filter.w ( INPUT parparentproc
     5448                        ,INPUT (filter-point + chr(4) + filter-label)
     5449                        ,INPUT tbl
     5450                        ,INPUT join-tbl
     5451                        ,INPUT fld
     5452                        ,INPUT lab
     5453                        ,INPUT spr
     5454                        ,INPUT dim ).
     5455     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5456   END.
     5457   END PROCEDURE.
