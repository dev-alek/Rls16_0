        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-node-code like ub.gds-prt.node-code no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: gdsprtpr.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: ref/gdsprtpr.p $":U .
        9   def var vss-description as character no-undo init "Печать шкалы".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   DEFINE VARIABLE line as character no-undo .
       65   DEFINE VARIABLE date_string as character no-undo .
       66   DEFINE VARIABLE v-found as logical no-undo .
       67   define variable v-node-code like ub.gds-prt.node-code no-undo.
       68   define variable v-lvl-num like ub.gds-prt.lvl-num no-undo.
       69   define buffer buf_gds-prt for ub.gds-prt .
       70   define buffer upper_gds-prt for ub.gds-prt .
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure cur-time :
       88      define output parameter p-today as date      no-undo .
       89      define output parameter p-time  as integer   no-undo .
       90     do
       91     on error undo, return error
       92     :
       93       define variable v-date1 as date      no-undo .
       94       define variable v-date2 as date      no-undo .
       95       define variable v-time  as integer   no-undo .
       96       assign
       97         v-date1 = today
       98         v-time  = time
       99         v-date2 = today
      100       .
      101       if v-date1 <> v-date2
      102       then do:
      103         assign
      104           v-date1 = today
      105           v-time  = v-time
      106         .
      107       end.
      108       assign
      109         p-today = v-date1
      110         p-time  = v-time
      111       .
      112     end.
      113   end.
      114   function cur-time-date returns character
      115   :
      116     return string(today, '99/99/9999':U) .
      117   end.
      118   function cur-time-mjd returns decimal
      119   :
      120     define variable v-date as date      no-undo .
      121     define variable v-time as integer   no-undo .
      122     run cur-time in this-procedure
      123       (output v-date
      124       ,output v-time
      125       ) .
      126     return integer(v-date) - 2400002 + (v-time / 86400) .
      127   end.
      128   function cur-time-get-ending-index returns integer
      129   (input p-number as integer
      130   )
      131   :
      132     if p-number < 0
      133     or p-number = ?
      134     then do:
      135       return 1 .
      136     end.
      137     define variable v-rest as integer   no-undo .
      138     assign
      139       p-number = p-number modulo 100
      140     .
      141     if p-number < 20
      142     then do:
      143       assign
      144         v-rest = p-number
      145       .
      146     end.
      147     else do:
      148       assign
      149         v-rest = p-number modulo 10
      150       .
      151     end.
      152     case v-rest :
      153       when 1
      154       then do:
      155         return 2 .
      156       end.
      157       when 2 or
      158       when 3 or
      159       when 4
      160       then do:
      161         return 3 .
      162       end.
      163       otherwise do:
      164         return 1 .
      165       end.
      166     end case .
      167   end.
      168   procedure cur-time-mjd-to-date :
      169      define input  parameter i-mjd-diff as decimal no-undo.
      170      define output parameter o-Date     as date    no-undo.
      171      define output parameter o-Time     as integer no-undo.
      172      define variable v-day-number as integer   no-undo .
      173      if    i-mjd-diff < 0
      174         or i-mjd-diff = ?
      175      then do:
      176         return "?" .
      177      end.
      178      assign
      179         v-day-number = truncate(i-mjd-diff,0).
      180         o-Date = date(v-day-number + 2400002).
      181         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      182     .
      183   end.
      184   function cur-time-mjd-to-string returns character
      185   (input p-mjd-diff as decimal
      186   )
      187   :
      188     define variable v-day-number as integer   no-undo .
      189     define variable v-seconds    as integer   no-undo .
      190     define variable v-hour       as integer   no-undo .
      191     define variable v-min        as integer   no-undo .
      192     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      193     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      194     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      195     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      196     if p-mjd-diff < 0
      197     or p-mjd-diff = ?
      198     then do:
      199       return "?" .
      200     end.
      201     assign
      202       v-day-number = integer(truncate(p-mjd-diff,0))
      203       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      204     .
      205     if v-seconds > 86400
      206     then do:
      207       assign
      208         v-seconds = 86400 - 1
      209       .
      210     end.
      211     if v-seconds < 0
      212     then do:
      213       assign
      214         v-seconds = 0
      215       .
      216     end.
      217     assign
      218       v-hour = truncate(v-seconds / 3600, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 3600
      222     .
      223     assign
      224       v-min = truncate(v-seconds / 60, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 60
      228     .
      229     return
      230         (if v-day-number <> 0
      231           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0
      235           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      239           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      240           else ""
      241         )
      242       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      243       .
      244   end.
      245   function cur-time-string returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      254   end.
      255   function cur-time-string-sec returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      264   end.
      265   function cur-time-custom  returns character
      266   (input p-prefix as character
      267   ,input p-date-format as character
      268   ,input p-delimiter as character
      269   ,input p-time-format as character
      270   ,input p-suffix as character
      271   )
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return
      280       p-prefix
      281       + string(v-date, p-date-format)
      282       + p-delimiter
      283       + string(v-time, p-time-format)
      284       + p-suffix
      285       .
      286   end.
      287   function cur-time-print  returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-datetime returns datetime
      298   :
      299     define variable v-char as character no-undo .
      300     define variable v-datetime as datetime no-undo .
      301     v-char = cur-time-string().
      302     v-datetime = datetime(v-char).
      303     return  v-datetime.
      304   end.
      305   function cur-time-string-msec returns character
      306   :
      307     define variable v-date as datetime  no-undo .
      308     v-date = now.
      309     return string(v-date) .
      310   end.
      311   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      313   define new shared variable RepPathName        as character no-undo .
      314   define new shared variable PrintRubl          as logical   no-undo .
      315   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   define  stream PrnLibStream.
      317   procedure prn-lib-prn-file :
      318     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      319     define input parameter p-DIsabledoptions as integer no-undo .
      320     define variable v-report-name as character no-undo .
      321     define variable v-user-action as character no-undo .
      322     define variable v-printed     as logical   no-undo .
      323     define variable v-exist       as logical   no-undo .
      324     do
      325       on error undo, return error
      326       :
      327       run prn-lib-get-report-name  in this-procedure (
      328         input parParentProc
      329         ,output v-report-name
      330         ).
      331   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      333     (input  v-report-name
      334     ,input  2
      335     ,output v-exist
      336     )  .
      337       if NOT v-exist then
      338       DO:
      339         Message
      340           "Нет заданий на печать ! "
      341           view-as alert-box .
      342         Return  .
      343       End.
      344       run gbl/prnfilen.w
      345         (input  ""
      346         ,input  p-DisabledOptions
      347         ,input  string(v-report-name )
      348         ,input  7
      349         ,output v-user-action
      350         ,output v-printed
      351         ) .
      352       if v-printed then
      353       do:
      354         return "YES" .
      355       end.
      356       else
      357       do:
      358         return "NO" .
      359       end.
      360     end.
      361   end procedure.
      362   procedure prn-lib-open-stream :
      363     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      364     define input parameter p-page-size    as integer no-undo .
      365     define input parameter p-is-stream    as logical no-undo .
      366     define input parameter p-append       as logical no-undo .
      367     define variable v-report-name as character no-undo .
      368     do
      369       on error undo, return error
      370       :
      371       run prn-lib-get-report-name  in this-procedure (
      372         input parParentProc
      373         ,output v-report-name
      374         ).
      375       if p-is-stream then
      376       do:
      377         if p-append then
      378         do:
      379           output stream PrnLibStream to value( v-report-name )
      380             page-size value(p-page-size) append .
      381         end.
      382         if not p-append then
      383         do:
      384           output stream PrnLibStream to value( v-report-name )
      385             page-size value(p-page-size) .
      386         end.
      387       end.
      388       if not p-is-stream then
      389       do:
      390         if p-append then
      391         do:
      392           output to value( v-report-name )
      393             page-size value(p-page-size) append .
      394         end.
      395         if not p-append then
      396         do:
      397           output to value( v-report-name )
      398             page-size value(p-page-size) .
      399         end.
      400       end.
      401     end.
      402   end procedure.
      403   procedure prn-lib-open-exp :
      404     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      405     define input parameter p-is-stream    as logical no-undo .
      406     define input parameter p-is-append    as logical no-undo .
      407     define output parameter p-ReportFileName as char init "report" no-undo.
      408     define output parameter p-process as logical no-undo .
      409     define variable glog as logical no-undo .
      410     do
      411       on error undo, return error
      412       :
      413       SYSTEM-DIALOG GET-FILE p-ReportFileName
      414         TITLE      "Укажите путь"
      415         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      416         ASK-OVERWRITE
      417         CREATE-TEST-FILE
      418         SAVE-AS
      419         USE-FILENAME
      420         DEFAULT-EXTENSION "txt"
      421         UPDATE glog
      422         .
      423       if not glog then  return.
      424       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      425       if p-is-stream then
      426       do:
      427         if p-is-append then
      428         do:
      429           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      430         end.
      431         else
      432         do:
      433           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      434         end.
      435       end.
      436       else
      437       do:
      438         if p-is-append then
      439         do:
      440           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      441         end.
      442         else
      443         do:
      444           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      445         end.
      446       end.
      447       p-process = yes.
      448     end.
      449   end procedure.
      450   procedure prn-lib-get-report-name :
      451     define input parameter parParentProc  as widget-handle no-undo.
      452     define output parameter p-report-name as character no-undo .
      453     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      454   end procedure.
      455   procedure prn-lib-reportviewer-report-name :
      456     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      457     define input parameter p-report-name-html as character no-undo .
      458     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      459   end procedure.
      460   procedure prn-lib-reportviewer :
      461     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      462     define input parameter p-report-name-html as character no-undo .
      463     define input parameter p-param        as character no-undo .
      464     define variable v-excel           as character no-undo init 'TRUE' .
      465     define variable v-value-character as character no-undo .
      466     define variable v-value-integer   as character no-undo .
      467     define variable v-value-date      as date      no-undo .
      468     define variable v-value-decimal   as decimal   no-undo .
      469     define variable rep-excel         as logical   no-undo .
      470     define variable excel-string      as character no-undo .
      471     define variable v-param-type      as character no-undo .
      472     define variable v-tth             as handle    no-undo .
      473     run adm/shattri.p (
      474       input "get":U
      475       ,input  ""
      476       ,input  0
      477       ,input  'report-glob':U
      478       ,input  'rep-excel':U
      479       ,output v-value-character
      480       ,output v-value-date
      481       ,output v-value-decimal
      482       ,output v-value-integer
      483       ,output rep-excel
      484       ,output v-param-type
      485       ,INPUT-OUTPUT table-handle v-tth
      486       )  .
      487     if rep-excel then v-excel = "TRUE" .
      488     else v-excel = "FALSE" .
      489     if p-param eq ""
      490     then
      491        p-param = "EXCEL:" + v-excel.
      492     else
      493        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      494     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      495   end procedure.
      496   find first buf_gds-prt no-lock where
      497              buf_gds-prt.node-code = p-node-code no-error.
      498   if not available buf_gds-prt then do:
      499     message
      500     vss-workfile vss-revision vss-description skip
      501     "Не найден узел шкалы" skip
      502     "node-code" p-node-code
      503     view-as alert-box error .
      504     return error.
      505   end.
      506   if can-find(first upper_gds-prt no-lock where
      507                     upper_gds-prt.node-code = buf_gds-prt.upper-code) then do:
      508     message
      509     vss-workfile vss-revision vss-description skip
      510     "Узел шкалы не корневой"
      511     "node-code" p-node-code "upper-code" buf_gds-prt.upper-code
      512     view-as alert-box error .
      513     return error.
      514   end.
      515   do
      516   on error undo, return error
      517   :
      518     run prn-lib-open-stream  in this-procedure (
      519                                                 input parParentProc
      520                                                 ,input 62
      521                                                 ,input yes
      522                                                 ,input no
      523                                                 ).
      524     Line = fill("-", 128).
      525     date_string = cur-time-print() .
      526     PUT STREAM PrnLibStream UNFORMATTED
      527     line skip(0)
      528     date_string skip(0)
      529     "Шкала:" chr(32) buf_gds-prt.node-name
      530     skip(1).
      531     assign
      532     v-node-code = buf_gds-prt.node-code
      533     v-lvl-num = 1
      534     v-found = yes
      535     .
      536     do while v-found = yes:
      537       assign
      538       v-found = yes
      539       .
      540       run print-level in this-procedure (
      541                                            input-output v-node-code
      542                                           ,input buf_gds-prt.upper-code
      543                                           ,input-output v-lvl-num
      544                                           ,output v-found
      545                                                           ) no-error.
      546       if error-status:error then  LEAVE.
      547     END.
      548     output  STREAM PrnLibStream CLOSE.
      549     run prn-lib-prn-file in this-procedure (
      550                                               input parParentProc
      551                                               ,input 0
      552                                               ).
      553   end.
      554   procedure print-level :
      555   define input-output parameter p-node-code like ub.gds-prt.node-code no-undo.
      556   define input parameter p-upper-code like ub.gds-prt.upper-code no-undo .
      557   define input-output  parameter p-lvl-num like ub.gds-prt.lvl-num no-undo.
      558   DEFINE output parameter p-found as logical no-undo.
      559   define variable v-current-pos as integer no-undo.
      560   define buffer bf_gds-prt for ub.gds-prt.
      561   define buffer bf_lvl-name for ub.lvl-name.
      562     do
      563     on error undo, return error
      564     :
      565     if can-find(first bf_gds-prt no-lock where
      566                         bf_gds-prt.upper-code = p-node-code) then do:
      567         find first bf_lvl-name no-lock where
      568                    bf_lvl-name.level = p-lvl-num - 1 and
      569                    bf_lvl-name.upper-code = p-upper-code no-error .
      570         put stream PrnLibStream unformatted
      571         fill(chr(32), p-lvl-num * 2)
      572         "Уровень" chr(32) p-lvl-num chr(58) chr(32)
      573         (if available bf_lvl-name then bf_lvl-name.lvl-name else "":U) skip
      574         fill(chr(32), p-lvl-num * 2)
      575         .
      576         assign
      577         v-current-pos = p-lvl-num * 2
      578         .
      579         for each bf_gds-prt no-lock where
      580                     bf_gds-prt.upper-code = p-node-code:
      581           if v-current-pos + 14 >  136 then do:
      582             assign
      583             v-current-pos = p-lvl-num * 2
      584             .
      585             put stream PrnLibStream unformatted
      586             skip
      587             fill(chr(32), p-lvl-num * 2)
      588             .
      589           end.
      590           put stream PrnLibStream unformatted
      591           string(chr(124) + substr(bf_gds-prt.node-name, 1, 10), "X(11)") chr(32) chr(32) chr(32)
      592           .
      593           assign
      594           v-current-pos = v-current-pos + 14
      595           .
      596         end.
      597         put stream PrnLibStream unformatted
      598         skip(1).
      599         assign
      600         p-lvl-num = p-lvl-num + 1
      601         .
      602         find first bf_gds-prt no-lock where
      603                     bf_gds-prt.upper-code = p-node-code.
      604           assign
      605           p-node-code = bf_gds-prt.node-code
      606           p-found = yes
      607           .
      608     end.
      609     else do:
      610         assign
      611         p-found = no
      612         .
      613     end.
      614       end.
      615   end procedure.
