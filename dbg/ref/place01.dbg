        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aa9af722fe7d, 3049, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Чт май 12 16:29:49 2022 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: place01.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: ref/place01.p $":U .
        7   define variable vss-description as character no-undo init "Сохранение изменений в карточке складского места".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure gen-b-code :
       70     define input  parameter type-code like ub.code-range.range-type no-undo .
       71     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
       72     do
       73     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       74     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
       75     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
       76     :
       77       define buffer buf_thbj-attr     for ub.thbj-attr .
       78       define buffer buf_sys-ctrl   for ub.sys-ctrl .
       79       define buffer buf_code-range for ub.code-range .
       80       define variable l-code         as   integer              no-undo .
       81       define variable v-db-num       like ub.db.db-num         no-undo .
       82       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
       83       if type-code = 'sslc':U
       84       or type-code = 'ssgb':U
       85       then do:
       86         message
       87           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
       88           "Обратитесь к администратору системы."
       89           view-as alert-box error .
       90         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
       91       end.
       92       run trg/getpcode.p ( input  type-code
       93                      ,output cfg-param-code
       94                     ).
       95       run get-next-seq( input  type-code,
       96                         output l-code
       97                       ).
       98       find first buf_sys-ctrl no-lock.
       99       if type-code = 'sclc':U
      100       or type-code = 'pglc':U
      101       then do:
      102         assign
      103           v-db-num = 0
      104         .
      105       end.
      106       else do:
      107         assign
      108           v-db-num = buf_sys-ctrl.db-num
      109         .
      110       end.
      111       find first buf_code-range no-lock
      112         where buf_code-range.db-num     = v-db-num
      113           and buf_code-range.range-type = type-code
      114           and buf_code-range.stts       = "a"
      115         use-index stts
      116         no-error .
      117       if available buf_code-range
      118          and l-code <= buf_code-range.last-code
      119          and l-code >= buf_code-range.first-code then do:
      120         assign
      121           p-b-code = l-code
      122         .
      123       end.
      124       else do:
      125         if available buf_code-range
      126            and l-code < buf_code-range.last-code then do:
      127           message
      128             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      129             "Обратитесь к администратору системы."
      130             view-as alert-box error .
      131           undo, return error "sequence":U .
      132         end.
      133         do transaction
      134         on error undo, return error
      135         :
      136           find first buf_thbj-attr exclusive-lock
      137             where buf_thbj-attr.upper-prop-code = 'code-range':U
      138               and buf_thbj-attr.prop-code = cfg-param-code
      139               and buf_thbj-attr.obj-type   = 'БД':U
      140               and buf_thbj-attr.obj-code   = v-db-num
      141             no-error .
      142           if not available buf_thbj-attr then do:
      143             find first buf_thbj-attr exclusive-lock
      144               where buf_thbj-attr.upper-prop-code = 'code-range':U
      145                 and buf_thbj-attr.prop-code = cfg-param-code
      146                 and buf_thbj-attr.obj-type   = ''
      147                 and buf_thbj-attr.obj-code   = 0
      148               no-error .
      149             if not available buf_thbj-attr then do:
      150               if not locked buf_thbj-attr then do:
      151                 message
      152                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      153                   "Обратитесь к администратору системы."
      154                   view-as alert-box error .
      155               end.
      156               undo, return error "config":U .
      157             end.
      158           end.
      159           run get-next-seq( input type-code,
      160                             output l-code
      161                           ).
      162           find first buf_code-range
      163             where buf_code-range.db-num     = v-db-num
      164               and buf_code-range.range-type = type-code
      165               and buf_code-range.stts       = "a"
      166             use-index stts
      167             no-error .
      168           if available buf_code-range
      169           and l-code <= buf_code-range.last-code
      170           and l-code >= buf_code-range.first-code
      171           then do:
      172             assign
      173               p-b-code = l-code
      174             .
      175           end.
      176           else do:
      177             if available buf_code-range then do:
      178               assign
      179                 buf_code-range.stts = "u"
      180               .
      181             end.
      182             find first buf_code-range
      183               where buf_code-range.db-num     = v-db-num
      184                 and buf_code-range.range-type = type-code
      185                 and buf_code-range.stts       = "f"
      186               use-index stts
      187               no-error .
      188             if not available buf_code-range then do:
      189               message
      190                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      191                 "Обратитесь к администратору системы"
      192                 view-as alert-box error .
      193               undo, return error "code-range":U .
      194             end.
      195             assign
      196               buf_code-range.stts           = "a"
      197             .
      198             if buf_code-range.first-code = 1 then do:
      199               run set-seq-cr( input type-code,
      200                               input buf_code-range.first-code
      201                             ).
      202               assign
      203                 p-b-code = 1
      204               .
      205             end.
      206             else do:
      207               run set-seq-cr( input type-code,
      208                               input ( buf_code-range.first-code - 1 )
      209                             ).
      210               run get-next-seq( input type-code,
      211                                 output p-b-code
      212                               ).
      213             end.
      214           end.
      215         end.
      216       end.
      217     end.
      218   end procedure.
      219   procedure get-next-seq :
      220     define input  parameter type-code like ub.code-range.range-type no-undo .
      221     define output parameter next-seq  as   integer                  no-undo .
      222     do
      223     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      224     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      225     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      226     :
      227       case type-code:
      228         when 'bcgb':U then do:
      229           assign
      230             next-seq = next-value(s-bcgb-code, ub)
      231           .
      232         end.
      233         when 'scgb':U then do:
      234           assign
      235             next-seq = next-value(s-scgb-code, ub)
      236           .
      237         end.
      238         when 'sclc':U then do:
      239           assign
      240             next-seq = next-value(s-sclc-code, ub)
      241           .
      242         end.
      243         when 'pglc':U then do:
      244           assign
      245             next-seq = next-value(s-pglc-code, ub)
      246           .
      247         end.
      248         when 'dcgb':U then do:
      249           assign
      250             next-seq = next-value(s-dcgb-code, ub)
      251           .
      252         end.
      253         when 'ctgb':U then do:
      254           assign
      255             next-seq = next-value(s-ctgb-code, ub)
      256           .
      257         end.
      258         when 'drgb':U then do:
      259           assign
      260             next-seq = next-value(s-drgb-code, ub)
      261           .
      262         end.
      263         when 'fmgb':U then do:
      264           assign
      265             next-seq = next-value(s-fmgb-code, ub)
      266           .
      267         end.
      268         when 'pngb':U then do:
      269           assign
      270             next-seq = next-value(s-pngb-code, ub)
      271           .
      272         end.
      273         when 'cagb':U then do:
      274           assign
      275             next-seq = next-value(s-cagb-code, ub)
      276           .
      277         end.
      278         when 'fdgb':U then do:
      279           assign
      280             next-seq = next-value(s-fin-doc, ub)
      281           .
      282         end.
      283       end case.
      284     end.
      285   end procedure.
      286   procedure set-seq-cr :
      287     define input parameter type-code like ub.code-range.range-type no-undo .
      288     define input parameter set-val   like ub.code-range.first-code no-undo .
      289     do
      290     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      291     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      292     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      293     :
      294       case type-code:
      295         when 'bcgb':U then do:
      296           assign
      297             current-value(s-bcgb-code, ub) = set-val
      298           .
      299         end.
      300         when 'scgb':U then do:
      301           assign
      302             current-value(s-scgb-code, ub) = set-val
      303           .
      304         end.
      305         when 'sclc':U then do:
      306           assign
      307             current-value(s-sclc-code, ub) = set-val
      308           .
      309         end.
      310         when 'pglc':U then do:
      311           assign
      312             current-value(s-pglc-code, ub) = set-val
      313           .
      314         end.
      315         when 'dcgb':U then do:
      316           assign
      317             current-value(s-dcgb-code, ub) = set-val
      318           .
      319         end.
      320         when 'ctgb':U then do:
      321           assign
      322             current-value(s-ctgb-code, ub) = set-val
      323           .
      324         end.
      325         when 'drgb':U then do:
      326           assign
      327             current-value(s-drgb-code, ub) = set-val
      328           .
      329         end.
      330         when 'fmgb':U then do:
      331           assign
      332             current-value(s-fmgb-code, ub) = set-val
      333           .
      334         end.
      335         when 'pngb':U then do:
      336           assign
      337             current-value(s-pngb-code, ub) = set-val
      338           .
      339         end.
      340         when 'cagb':U then do:
      341           assign
      342             current-value(s-cagb-code, ub) = set-val
      343           .
      344         end.
      345         when 'fdgb':U then do:
      346           assign
      347             current-value(s-fin-doc, ub) = set-val
      348           .
      349         end.
      350       end case.
      351     end.
      352   end procedure.
      353   procedure new-bcod-gen-code-range :
      354     do
      355     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      356     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      357     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      358     :
      359       define input parameter p-db-num  like ub.db.db-num             no-undo .
      360       define input parameter type-code like ub.code-range.range-type no-undo .
      361       define buffer buf_code-range      for ub.code-range .
      362       define buffer last_code-range     for ub.code-range .
      363       define buffer last-1_code-range   for ub.code-range .
      364       define buffer last-2_code-range   for ub.code-range .
      365       define buffer last-3_code-range   for ub.code-range .
      366       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      367       define variable conf-par       as character no-undo .
      368       define variable par-type       as character no-undo .
      369       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      370       define variable v-cre-cdrg as logical   no-undo .
      371       define variable v-cre-str  as character no-undo .
      372       define variable v-cr1      as integer no-undo .
      373       define variable v-cr2      as integer no-undo .
      374       define variable v-cr3      as integer no-undo .
      375       define variable v-cmax     as integer no-undo .
      376       find first buf_sys-ctrl no-lock .
      377       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      378         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      379                                       ,vss-workfile
      380                                       ,vss-revision
      381                                       ,vss-description
      382                                       ,chr(10)
      383                                       , p-db-num
      384                                      ).
      385       end.
      386       run trg/getpcode.p ( input  type-code
      387                      ,output cfg-param-code
      388                     ).
      389       for each buf_code-range
      390         where buf_code-range.db-num     = -1
      391           and buf_code-range.range-type = type-code
      392           and buf_code-range.stts       = "f"
      393       by buf_code-range.first-code
      394       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      395       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      396       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      397       :
      398         assign
      399           buf_code-range.db-num = p-db-num
      400         .
      401         return .
      402       end.
      403       assign
      404         v-cre-cdrg = TRUE
      405       .
      406       case type-code:
      407         when 'sclc':U
      408         or when 'scgb':U
      409         or when 'pglc':U
      410         then do:
      411           find last last-1_code-range no-lock
      412             where last-1_code-range.range-type = 'sclc':U
      413             no-error .
      414           if available last-1_code-range then do:
      415             v-cr1 = last-1_code-range.last-code.
      416           end.
      417           find last last-2_code-range no-lock
      418             where last-2_code-range.range-type = 'scgb':U
      419             no-error .
      420           if available last-2_code-range then do:
      421             v-cr2 = last-2_code-range.last-code.
      422             end.
      423           find last last-3_code-range no-lock
      424             where last-3_code-range.range-type = 'pglc':U
      425             no-error .
      426           if available last-3_code-range then do:
      427             v-cr3 = last-3_code-range.last-code.
      428           end.
      429           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      430           .
      431           if v-cmax = v-cr1  then do:
      432               find last last_code-range no-lock
      433                 where recid( last_code-range ) = recid( last-1_code-range )
      434                 .
      435             end.
      436           if v-cmax = v-cr2  then do:
      437               find last last_code-range no-lock
      438                 where recid( last_code-range ) = recid( last-2_code-range )
      439                 .
      440             end.
      441           if v-cmax = v-cr3  then do:
      442             find last last_code-range no-lock
      443               where recid( last_code-range ) = recid( last-3_code-range )
      444               .
      445           end.
      446           if last_code-range.last-code + 1 > 99999 then do:
      447             assign
      448               v-cre-cdrg = FALSE
      449             .
      450           end.
      451         end.
      452         when 'bcgb':U
      453         or when 'sslc':U
      454         or when 'ssgb':U
      455         then do:
      456           find last last-1_code-range no-lock
      457             where last-1_code-range.range-type = 'sslc':U
      458             no-error .
      459           if available last-1_code-range then do:
      460             v-cr1 = last-1_code-range.last-code.
      461           end.
      462           find last last-2_code-range no-lock
      463             where last-2_code-range.range-type = 'bcgb':U
      464             no-error .
      465           if available last-2_code-range then do:
      466             v-cr2 = last-2_code-range.last-code.
      467             end.
      468           find last last-3_code-range no-lock
      469             where last-3_code-range.range-type = 'ssgb':U
      470             no-error .
      471           if available last-3_code-range then do:
      472             v-cr3 = last-3_code-range.last-code.
      473           end.
      474           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      475           .
      476           if v-cmax = v-cr1  then do:
      477               find last last_code-range no-lock
      478                 where recid( last_code-range ) = recid( last-1_code-range )
      479                 .
      480             end.
      481           if v-cmax = v-cr2  then do:
      482               find last last_code-range no-lock
      483                 where recid( last_code-range ) = recid( last-2_code-range )
      484                 .
      485             end.
      486           if v-cmax = v-cr3  then do:
      487             find last last_code-range no-lock
      488               where recid( last_code-range ) = recid( last-3_code-range )
      489               .
      490           end.
      491         end.
      492         otherwise do:
      493           find last last_code-range no-lock
      494             where last_code-range.range-type = type-code
      495             no-error .
      496         end.
      497       end case.
      498       if not available last_code-range then do:
      499         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      500                                       ,vss-workfile
      501                                       ,vss-revision
      502                                       ,vss-description
      503                                       , chr(10)
      504                                       , type-code
      505                                      ) .
      506       end.
      507       define variable v-mes0 as character no-undo .
      508       define variable v-param-type0 as character no-undo .
      509       define variable v-value-character0 as INTEGER no-undo .
      510       define variable v-value-date0 as date no-undo .
      511       define variable v-value-decimal0 as decimal no-undo .
      512       define variable v-value-integer0 AS integer no-undo .
      513       define variable v-value-logical0 AS LOGICAL no-undo .
      514       define variable v-tth0 as handle no-undo .
      515       run adm/shattri.p (
      516           input "get":U
      517           ,input  'БД':U
      518           ,input  p-db-num
      519           ,input  'code-range':U
      520           ,input  cfg-param-code
      521           ,output v-value-character0
      522           ,output v-value-date0
      523           ,output v-value-decimal0
      524           ,output v-value-integer0
      525           ,output v-value-logical0
      526           ,output v-param-type0
      527           ,INPUT-OUTPUT table-handle v-tth0
      528           ) no-error .
      529       if error-status :error then do:
      530         delete object v-tth0.
      531         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      532                            , error-status:get-message(1)
      533                            , chr(10)
      534                            , return-value ).
      535         undo, return error v-mes0.
      536       end.
      537       delete object v-tth0.
      538       if v-cre-cdrg = TRUE then do:
      539         create buf_code-range .
      540         assign
      541           buf_code-range.db-num     = p-db-num
      542           buf_code-range.range-type = type-code
      543           buf_code-range.stts       = "f"
      544           buf_code-range.first-code = last_code-range.last-code + 1
      545           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      546           v-cre-str = "Свободный диапазон успешно создан"
      547         .
      548       end.
      549       else do:
      550         assign
      551           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      552                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      553         .
      554       end.
      555     end.
      556     return v-cre-str .
      557   end procedure.
      558   procedure gen-new-code-range-if-neces :
      559     define input parameter v-db-num           like ub.db.db-num             no-undo .
      560     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      561     define input parameter v-cur-code         as   integer                  no-undo .
      562     define input parameter v-g#news           as   logical                  no-undo .
      563     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      564     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      565     do
      566     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      567     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      568     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      569     :
      570       define variable l-code-range-exist as logical   no-undo init false .
      571       define variable v-db-for-send      as character no-undo .
      572       define buffer buf_code-range  for ub.code-range .
      573       define buffer buf1_code-range for ub.code-range .
      574       define buffer buf_db          for ub.db .
      575       find first buf_code-range
      576         where buf_code-range.range-type = v-range-type
      577           and buf_code-range.last-code >= v-cur-code
      578         use-index last-codei
      579         no-error .
      580       if
      581       (
      582          available buf_code-range
      583          and
      584         (buf_code-range.db-num = v-db-num
      585           and
      586         buf_code-range.first-code <= v-cur-code
      587         )
      588       or
      589         (
      590           v-range-type = 'drgb':U
      591           AND
      592           v-cur-code = 0
      593         )
      594      )
      595      then do:
      596         assign
      597           l-code-range-exist = true
      598         .
      599         if v-g#news
      600         and buf_code-range.stts = "f" then do:
      601           assign
      602             buf_code-range.stts = "u"
      603           .
      604         end.
      605       end.
      606       if not l-code-range-exist
      607          and v-g#news-source-db <> 0
      608       then do:
      609         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      610                                       ,vss-workfile
      611                                       ,vss-revision
      612                                       ,vss-description
      613                                       ,chr(10)
      614                                       ,v-db-num
      615                                       ,v-range-type
      616                                       ,v-cur-code
      617                                      ).
      618       end.
      619       if (not l-code-range-exist
      620           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      621          )
      622       and ( not can-find (first buf1_code-range no-lock
      623                           where buf1_code-range.db-num = v-db-num
      624                             and buf1_code-range.range-type = v-range-type
      625                             and buf1_code-range.stts = "f"
      626                          )
      627           )
      628       then do:
      629         if v-g#db-num = 0 then do:
      630           run new-bcod-gen-code-range in this-procedure
      631             (input v-db-num,
      632              input v-range-type
      633             ) no-error .
      634           if error-status :error then do:
      635             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      636                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      637                                           ,v-db-num
      638                                           ,v-range-type
      639                                           ,v-cur-code
      640                                           ,chr(10)
      641                                           ,error-status:get-message(1)
      642                                           ,return-value
      643                                          ).
      644           end.
      645         end.
      646         else do:
      647           if v-range-type = 'sclc':U
      648           or v-range-type = 'pglc':U
      649           then do:
      650             assign
      651               v-db-for-send = "":U
      652             .
      653             if v-g#db-num = 0 then do:
      654               for each buf_db no-lock
      655                 where buf_db.db-num > 0
      656                   and buf_db.db-num <> v-g#news-source-db
      657               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      658               :
      659                 assign
      660                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      661                 .
      662               end.
      663               assign
      664                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      665               .
      666             end.
      667             else do:
      668               if not v-g#news then do:
      669                 assign
      670                   v-db-for-send = "0":U
      671                 .
      672               end.
      673             end.
      674             run nws/cr-route.p ( input 'send-cmd':U
      675                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      676                                  "code-range":U + chr(1) +
      677                                  (if v-range-type = 'sclc':U
      678                                   then string( current-value(s-sclc-code, ub))
      679                                   else string( current-value(s-pglc-code, ub))
      680                                   ) + chr(1) +
      681                                   v-range-type)
      682                           ,input ?
      683                           ,input v-db-for-send
      684                           ) no-error .
      685             if error-status :error then do:
      686               undo, return error return-value.
      687             end.
      688           end.
      689         end.
      690       end.
      691     end.
      692   end procedure.
      693   procedure cre-loc-sc-code-range :
      694     define input parameter v-cur-code as integer no-undo .
      695   define input parameter p-cdrg-type as character no-undo .
      696     do
      697     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      698     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      699     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      700     :
      701       define buffer buf_code-range for ub.code-range .
      702       find first buf_code-range
      703            where buf_code-range.range-type = p-cdrg-type
      704              and buf_code-range.first-code >= v-cur-code
      705            no-error .
      706       if not available buf_code-range then do:
      707         run new-bcod-gen-code-range in this-procedure
      708           ( input 0,
      709             input p-cdrg-type
      710           ) no-error .
      711         if error-status :error then do:
      712           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      713                                          + "Код &2&1&3 &4"
      714                                         , chr(10)
      715                                         , v-cur-code
      716                                         , error-status:get-message(1)
      717                                         , return-value
      718                                        ) .
      719         end.
      720       end.
      721     end.
      722   end procedure.
      723   procedure mark-used-if-need :
      724   define input parameter p-cur-code as integer no-undo .
      725   define input parameter p-range-type like ub.code-range.range-type no-undo .
      726   define input parameter p-db-num like ub.code-range.db-num no-undo .
      727     do
      728     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      729     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      730     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      731     :
      732       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      733       define buffer buf_code-range for ub.code-range .
      734       assign
      735       v-db-num = if p-range-type = 'sclc':U
      736                  then 0
      737                  else p-db-num
      738       .
      739   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      740   define buffer locK-batchprocess1 for ub.batchprocess.
      741   run gbl/lock-prc.p
      742       (input 'lscc':U
      743       ,input 0
      744       ,input 0
      745       ,input 0
      746       ,input ""
      747       ,input ""
      748       ,input ""
      749       ,input (
      750               ",,,Вкл/выкл лок. вес. кодов"
      751              )
      752       ,input true
      753       ,buffer lock-batchprocess1
      754       ) no-error .
      755     if error-status :error then do:
      756       message
      757         vss-workfile vss-revision vss-description skip
      758         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      759         view-as alert-box error .
      760       undo, return error .
      761     end.
      762       find first buf_code-range
      763            where buf_code-range.range-type = p-range-type
      764              and buf_code-range.first-code >= p-cur-code
      765              and buf_code-range.last-code <= p-cur-code
      766              and buf_code-range.db-num = v-db-num
      767            no-error .
      768       if not available buf_code-range then do:
      769         message
      770           vss-workfile vss-revision vss-description skip
      771           "Ошибка при создании поиске диапазона" skip
      772           "База данных" p-db-num skip
      773           "Код" p-cur-code skip
      774           "Тип" p-range-type
      775           error-status :get-message(1) skip
      776           return-value skip
      777           view-as alert-box error .
      778         undo, return error .
      779       end.
      780       if buf_code-range.stts = "f":U then do:
      781         assign
      782         buf_code-range.stts = "u":U
      783         .
      784       end.
      785     end.
      786   end procedure.
      787   define input-output parameter p-rid      as recid no-undo.
      788   define input parameter p-mode as character no-undo .
      789   define input parameter p-silent as logical no-undo .
      790   define input parameter p-obj-type as character no-undo .
      791   define input parameter p-obj-code as integer no-undo .
      792   define input parameter p-pl-code as integer no-undo .
      793   define input parameter p-loc1 as character no-undo .
      794   define input parameter p-loc2 as character no-undo .
      795   define input parameter p-loc3 as character no-undo .
      796   define input parameter p-loc4 as character no-undo .
      797   define input parameter p-pl-name as character no-undo .
      798   define input parameter p-ps as character no-undo .
      799   define input parameter p-add-qnty as decimal no-undo .
      800   define input parameter p-is-meas as logical no-undo .
      801   define input parameter p-max-qnty as decimal no-undo .
      802   define input parameter p-issue-year as integer no-undo .
      803   define input parameter p-start-date as date no-undo .
      804   define input parameter p-chk-max-qnty as logical no-undo .
      805   define variable glog as logical no-undo .
      806   define variable v-mess as character no-undo .
      807   DEFINE VARIABLE v-shift-date as date no-undo.
      808   DEFINE VARIABLE v-shift-num as integer no-undo.
      809   define variable v-shift-name as character no-undo .
      810   define variable v-is-petrol-place as logical no-undo .
      811   define buffer buf_clients for ub.clients.
      812   define buffer main_place for ub.place.
      813   define variable v-dopi  as integer  no-undo .
      814   if p-mode <> 'ДОБАВЛЕНИЕ':U
      815   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      816     message
      817     vss-workfile vss-revision vss-description skip
      818     "Неверный параметр p-mode" p-mode
      819     view-as alert-box error .
      820     return error '':u.
      821   end.
      822   define variable t-loc as integer no-undo .
      823   if p-loc1 <> '' THEN DO:
      824           t-loc = integer(p-loc1) NO-ERROR.
      825           IF ERROR-STATUS:ERROR THEN DO:
      826                    MESSAGE "коорд1 должна быть числом от 1 до 999 "
      827                    view-as alert-box error .
      828           return error '':u.
      829           END.
      830           IF t-loc > 999 THEN DO:
      831                    MESSAGE "коорд1 должна быть числом от 1 до 999 "
      832                    view-as alert-box error .
      833           return error '':u.
      834           END.
      835   END.
      836   if p-loc2 <> '' THEN DO:
      837           t-loc = integer(p-loc2) NO-ERROR.
      838           IF ERROR-STATUS:ERROR THEN DO:
      839                    MESSAGE "коорд2 должна быть числом от 1 до 999 "
      840                    view-as alert-box error .
      841           return error '':u.
      842           END.
      843           IF t-loc > 999 THEN DO:
      844                    MESSAGE "коорд2 должна быть числом от 1 до 999 "
      845                    view-as alert-box error .
      846           return error '':u.
      847           END.
      848   END.
      849   if p-loc3 <> '' THEN DO:
      850           t-loc = integer(p-loc3) NO-ERROR.
      851           IF ERROR-STATUS:ERROR THEN DO:
      852                    MESSAGE "коорд3 должна быть числом от 1 до 999 "
      853                    view-as alert-box error .
      854           return error '':u.
      855           END.
      856           IF t-loc > 999 THEN DO:
      857                    MESSAGE "коорд3 должна быть числом от 1 до 999 "
      858                    view-as alert-box error .
      859           return error '':u.
      860           END.
      861   END.
      862   if p-loc4 <> '' THEN DO:
      863           t-loc = integer(p-loc4) NO-ERROR.
      864           IF ERROR-STATUS:ERROR THEN DO:
      865                    MESSAGE "коорд4 должна быть числом от 1 до 999 "
      866                    view-as alert-box error .
      867           return error '':u.
      868           END.
      869           IF t-loc > 999 THEN DO:
      870                    MESSAGE "коорд4 должна быть числом от 1 до 999 "
      871                    view-as alert-box error .
      872           return error '':u.
      873           END.
      874   END.
      875   if p-pl-name = '':U
      876   or p-pl-name = ? then do:
      877     v-mess = "Название складского места не может быть пустым".
      878     run err-mes in this-procedure ( input-output v-mess).
      879     undo, return error (if p-silent then v-mess else 'pl-name':U).
      880   end.
      881   if p-obj-type <> 'маг':U
      882   and p-obj-type <> 'скл':U then do:
      883     v-mess = substitute("Складские места могут быть только для &1 и &2", 'маг':U, 'скл':U).
      884     run err-mes in this-procedure ( input-output v-mess).
      885     undo, return error (if p-silent then v-mess else '':U).
      886   end.
      887   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      888     find first buf_clients no-lock where
      889               buf_clients.obj-type = p-obj-type
      890           and buf_clients.obj-code = p-obj-code no-error .
      891     if not available buf_clients then do:
      892        v-mess = substitute("Не найден объект &1&2 для складского места", p-obj-type, p-obj-code).
      893        undo, return error (if p-silent then v-mess else '':U).
      894     end.
      895   end.
      896   main-block:
      897   DO for main_place
      898   on error undo, return error return-value
      899   :
      900     v-is-petrol-place = no.
      901     run trg/plloc1wv.p (
      902                           input p-obj-type
      903                         ,input p-obj-code
      904                         ,input p-pl-code
      905                         ,input p-loc1
      906                         ,input p-is-meas
      907                         ,input-output v-is-petrol-place
      908                         ,output glog) no-error.
      909     if error-status:error then do:
      910       v-mess = error-status:get-message(1) .
      911       run err-mes in this-procedure ( input-output v-mess).
      912       undo main-block, return error (if p-silent then v-mess else '':U).
      913     end.
      914     if not glog then do:
      915       v-mess = return-value .
      916       run err-mes in this-procedure ( input-output v-mess).
      917       undo main-block, return error (if p-silent then v-mess else '':U).
      918     end.
      919     CASE p-mode:
      920       when 'ДОБАВЛЕНИЕ':U then do:
      921          define variable conf-par as character no-undo.
      922          define variable par-type as character no-undo.
      923   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      924     (input  'is-erpRN'
      925     ,input  0
      926     ,input  ''
      927     ,input  0
      928     ,input  ''
      929     ,input  ''
      930     ,input  ''
      931     ,input  NO
      932     ,output conf-par
      933     ,output par-type
      934     ) no-error .
      935            IF not error-status:error and conf-par = "yes":U
      936            then do:
      937             find last c-place where c-place.obj-type = p-obj-type
      938                                 and c-place.obj-code = p-obj-code
      939                                 and c-place.pl-code  < 10000000000
      940                                 no-lock no-error.
      941             if available c-place
      942             then
      943                p-pl-code = c-place.pl-code.
      944             find last place where place.obj-type = p-obj-type
      945                               and place.obj-code = p-obj-code
      946                               and place.pl-code  < 10000000000
      947                                 no-lock no-error.
      948             if available place
      949             then
      950                p-pl-code = max(place.pl-code,p-pl-code).
      951             if p-pl-code < 100000 then p-pl-code = 100000.
      952             p-pl-code =  p-pl-code +  1.
      953            end.
      954            else do:
      955              run gen-b-code in this-procedure ( input 'bcgb':U, output p-pl-code) no-error.
      956               if error-status:error then do:
      957                 if return-value <> '':u then do:
      958                   v-mess = return-value .
      959                   run err-mes in this-procedure ( input-output v-mess).
      960                 end.
      961                 undo main-block, return error (if p-silent then v-mess else 'pl-code').
      962               end.
      963            end.
      964         create main_place.
      965         assign
      966         main_place.obj-type = p-obj-type
      967         main_place.obj-code = p-obj-code
      968         main_place.pl-code = p-pl-code
      969         .
      970       end.
      971       when 'ИЗМЕНЕНИЕ':U then do:
      972         FIND FIRST main_place where
      973                   recid(main_place) = p-rid No-ERROR.
      974         if not available main_place then do:
      975           message
      976           vss-workfile vss-revision vss-description skip
      977           "Не найдена запись СКЛАДСКОГО МЕСТА - p-rid" p-rid
      978           view-as alert-box error .
      979           undo main-block, return error '':u.
      980         end.
      981         if main_place.obj-type <>  p-obj-type
      982         OR main_place.obj-code <>  p-obj-code
      983         OR main_place.pl-code <>  p-pl-code
      984         then do:
      985           message
      986           vss-workfile vss-revision vss-description skip
      987           "Для уже имеющейся записи нельзя изменить"
      988           "тип и код объекта" skip
      989           view-as alert-box ERROR.
      990           undo main-block, return error '':U.
      991         end.
      992         if v-is-petrol-place
      993         and p-loc1 <> main_place.loc1
      994         then do:
      995   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      996   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      997     (input  p-obj-type
      998     ,input  p-obj-code
      999     ,output v-shift-date
     1000     ,output v-shift-num
     1001     ,output v-shift-name
     1002     )  .
     1003           if v-shift-date <> ? then do:
     1004              v-mess = substitute("Нельзя менять КООРД1 для резервуара: открыта смена на &1&2", p-obj-type, p-obj-code).
     1005              run err-mes in this-procedure ( input-output v-mess).
     1006              undo main-block, return error (if p-silent then v-mess else 'loc1').
     1007           end.
     1008         end.
     1009       end.
     1010     END CASE.
     1011     assign
     1012     main_place.loc1   = p-loc1
     1013     main_place.loc2   = p-loc2
     1014     main_place.loc3   = p-loc3
     1015     main_place.loc4   = p-loc4
     1016     main_place.pl-name   = p-pl-name
     1017     main_place.ps     = p-ps
     1018     main_place.add-qnty = p-add-qnty
     1019     main_place.is-meas = p-is-meas
     1020     main_place.max-qnty = p-max-qnty
     1021     main_place.issue-year  = p-issue-year
     1022     main_place.start-date  = p-start-date
     1023     main_place.chk-max-qnty = p-chk-max-qnty
     1024     p-rid = recid(main_place)
     1025     .
     1026     release main_place no-error .
     1027     if error-status:error then do:
     1028       v-mess = substitute("Ошибка при сохранении СКЛАДСКОГО МЕСТА&1&2&1&3", chr(10), return-value, error-status:get-message(1)).
     1029       run err-mes in this-procedure ( input-output v-mess).
     1030       undo main-block, return error v-mess.
     1031     end.
     1032   end.
     1033   procedure err-mes :
     1034   define input-output parameter p-mess as character no-undo .
     1035     do
     1036     on error undo, return error
     1037     :
     1038       if not p-silent then do:
     1039         message
     1040         p-mess
     1041         view-as alert-box error.
     1042       end.
     1043       assign
     1044       p-mess = substitute("&1", p-mess).
     1045     end.
     1046   end procedure.
