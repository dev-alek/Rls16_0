     1064                  t-has-return
     1065                  t-has-overpay
     1066                  cb-type-pay-fr
     1067                  WITH FRAME Dialog-Frame.
     1068               if cb-prop = "4" then
     1069               do:
     1070                  enable cb-card-type with frame Dialog-Frame .
     1071               end.
     1072               if cb-prop = "2" or cb-prop = "3" then
     1073               do:
     1074                  enable cb-card-type-bank with frame Dialog-Frame .
     1075               end.
     1076               if cb-prop = "2" then do:
     1077                  enable
     1078                    qr-mir with frame Dialog-Frame .
     1079               end.
     1080            end.
     1081         when 'ПРОСМОТР':U then
     1082            do:
     1083               assign
     1084                  b-quit:label = "&Выход".
     1085               HIDE
     1086                  b-exit in frame Dialog-Frame.
     1087            end.
     1088      END CASE.
     1089      ENABLE
     1090         RECT-3
     1091         b-quit
     1092         B-Help
     1093         b-attr
     1094         WHEN par-mode <> 'ДОБАВЛЕНИЕ':U
     1095         WITH FRAME Dialog-Frame.
     1096      VIEW FRAME Dialog-Frame.
     1097   END PROCEDURE.
     1098   PROCEDURE proc-save-record :
     1099      IF par-mode = 'ПРОСМОТР':U THEN
     1100      DO:
     1101         RETURN error.
     1102      END.
     1103      assign
     1104         tt-cash-pay.cdpay-code frame Dialog-Frame
     1105         tt-cash-pay.obj-name
     1106         tt-cash-pay.curr-code
     1107         tt-cash-pay.pay-code
     1108         tt-cash-pay.wth-code
     1109         tt-cash-pay.pay-limit
     1110         tt-cash-pay.is-cash
     1111         tt-cash-pay.atr1
     1112         tt-cash-pay.atr2
     1113         tt-cash-pay.atr4
     1114         tt-cash-pay.atr8
     1115         tt-cash-pay.atr16
     1116         tt-cash-pay.atr32
     1117         tt-cash-pay.atr64
     1118         tt-cash-pay.atr128
     1119         tt-cash-pay.pay-card-view
     1120         tt-cash-pay.is-debet-card
     1121         tt-cash-pay.is-advance
     1122         tt-cash-pay.is-credit
     1123         tt-cash-pay.is-credit-card
     1124         tt-cash-pay.is-all-pay
     1125         tt-cash-pay.is-bar-read
     1126         tt-cash-pay.is-card-swap
     1127         tt-cash-pay.is-goods-pay
     1128         tt-cash-pay.is-service-pay
     1129         tt-cash-pay.rule-file-name
     1130         tt-cash-pay.slip-file-name
     1131         t-register
     1132         tt-cash-pay.register    = (IF t-register THEN 1 ELSE 0)
     1133         cb-prop
     1134         cb-card-type-bank
     1135         cb-card-type
     1136         cb-type-pay-fr
     1137         t-kbo
     1138         tt-cash-pay.is-kbo      = (IF t-kbo THEN 1 ELSE 0)
     1139         t-lnr
     1140         tt-cash-pay.is-lnr      = (IF t-lnr THEN 1 ELSE 0)
     1141         t-has-return
     1142         tt-cash-pay.has-return  = (IF t-has-return THEN 1 ELSE 0)
     1143         t-has-overpay
     1144         tt-cash-pay.has-overpay = (IF t-has-overpay THEN 1 ELSE 0)
     1145         t-can-mix
     1146         tt-cash-pay.can-mix     = (IF t-can-mix THEN 1 ELSE 0)
     1147         .
     1148      if par-mode <> 'ДОБАВЛЕНИЕ':U then
     1149         par-ri = recid(locked_cash-pay).
     1150      else par-ri = ?.
     1151      run ref/cashpay1.p (
     1152         input parparentproc
     1153         ,input no
     1154         ,input-output par-ri
     1155         ,input        par-mode
     1156         ,input tt-cash-pay.cdpay-code
     1157         ,input tt-cash-pay.obj-name
     1158         ,input tt-cash-pay.curr-code
     1159         ,input tt-cash-pay.pay-code
     1160         ,input tt-cash-pay.wth-code
     1161         ,input tt-cash-pay.pay-limit
     1162         ,input tt-cash-pay.is-cash
     1163         ,input tt-cash-pay.atr1
     1164         ,input tt-cash-pay.atr2
     1165         ,input tt-cash-pay.atr4
     1166         ,input tt-cash-pay.atr8
     1167         ,input tt-cash-pay.atr16
     1168         ,input tt-cash-pay.atr32
     1169         ,input tt-cash-pay.atr64
     1170         ,input tt-cash-pay.atr128
     1171         ,input tt-cash-pay.pay-card-view
     1172         ,input tt-cash-pay.is-advance
     1173         ,input tt-cash-pay.is-credit
     1174         ,input tt-cash-pay.is-credit-card
     1175         ,input tt-cash-pay.is-debet-card
     1176         ,input tt-cash-pay.is-all-pay
     1177         ,input tt-cash-pay.is-bar-read
     1178         ,input tt-cash-pay.is-card-swap
     1179         ,input tt-cash-pay.is-goods-pay
     1180         ,input tt-cash-pay.is-service-pay
     1181         ,input tt-cash-pay.is-kbo
     1182         ,input tt-cash-pay.is-lnr
     1183         ,input tt-cash-pay.can-mix
     1184         ,input tt-cash-pay.has-return
     1185         ,input tt-cash-pay.has-overpay
     1186         ,input tt-cash-pay.rule-file-name
     1187         ,input tt-cash-pay.slip-file-name
     1188         ,input tt-cash-pay.register
     1189         ) no-error .
     1190      IF ERROR-STATUS:ERROR THEN
     1191      DO:
     1192   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1193   define variable fh as widget-handle no-undo .
     1194   define variable hh as widget-handle no-undo .
     1195   define variable rv as character no-undo .
     1196   assign
     1197   rv = entry(1, return-value , chr(4)).
     1198   if rv <> "":U then do:
     1199     assign
     1200     fh = frame Dialog-Frame:first-child
     1201     hh = fh:first-child
     1202     .
     1203     do while valid-handle(hh):
     1204       if hh:name = rv then do:
     1205         APPLY "ENTRY" to hh.
     1206         undo ,
     1207         return error.
     1208       end.
     1209       hh = hh:next-sibling.
     1210     end.
     1211   end.
     1212         undo, return error.
     1213      END.
     1214      find first buf_cash-pay-attr where
     1215         buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1216         and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     1217         and buf_cash-pay-attr.attr-code = "cash-prop" no-error .
     1218      if not AVAILABLE buf_cash-pay-attr then
     1219      do:
     1220         create buf_cash-pay-attr .
     1221         assign
     1222            buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1223            buf_cash-pay-attr.curr-code  = tt-cash-pay.curr-code
     1224            buf_cash-pay-attr.attr-code  = "cash-prop"
     1225            buf_cash-pay-attr.attr-value = cb-prop
     1226            .
     1227      end.
     1228      else
     1229      do:
     1230         buf_cash-pay-attr.attr-value = cb-prop .
     1231      end.
     1232      find first buf_cash-pay-attr where
     1233         buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1234         and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     1235         and buf_cash-pay-attr.attr-code = "cash-type-pay-fr" no-error .
     1236      if not AVAILABLE buf_cash-pay-attr then
     1237      do:
     1238         create buf_cash-pay-attr .
     1239         assign
     1240            buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1241            buf_cash-pay-attr.curr-code  = tt-cash-pay.curr-code
     1242            buf_cash-pay-attr.attr-code  = "cash-type-pay-fr"
     1243            buf_cash-pay-attr.attr-value = cb-type-pay-fr
     1244            .
     1245      end.
     1246      else
     1247      do:
     1248         buf_cash-pay-attr.attr-value = cb-type-pay-fr .
     1249      end.
     1250      find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1251         and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     1252         and buf_cash-pay-attr.attr-code = "cash-card-type" no-error .
     1253      if not AVAILABLE buf_cash-pay-attr then
     1254      do:
     1255         if cb-prop = "4" then
     1256         do:
     1257            create buf_cash-pay-attr .
     1258            assign
     1259               buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1260               buf_cash-pay-attr.curr-code  = tt-cash-pay.curr-code
     1261               buf_cash-pay-attr.attr-code  = "cash-card-type"
     1262               buf_cash-pay-attr.attr-value = cb-card-type
     1263               .
     1264         end.
     1265         else
     1266         do:
     1267            cb-card-type = "" .
     1268         end.
     1269      end.
     1270      else
     1271      do:
     1272         if cb-prop = "4" then
     1273         do:
     1274            buf_cash-pay-attr.attr-value = cb-card-type .
     1275         end.
     1276         else
     1277         do:
     1278            delete buf_cash-pay-attr .
     1279            cb-card-type = "" .
     1280         end.
     1281      end.
     1282      find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1283         and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     1284         and buf_cash-pay-attr.attr-code = "cash-card-type-bank" no-error .
     1285      if not AVAILABLE buf_cash-pay-attr then
     1286      do:
     1287         if cb-prop = "2" or cb-prop = "3" then
     1288         do:
     1289            create buf_cash-pay-attr .
     1290            assign
     1291               buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1292               buf_cash-pay-attr.curr-code  = tt-cash-pay.curr-code
     1293               buf_cash-pay-attr.attr-code  = "cash-card-type-bank"
     1294               buf_cash-pay-attr.attr-value = cb-card-type-bank
     1295               .
     1296         end.
     1297         else
     1298         do:
     1299            cb-card-type-bank = "" .
     1300         end.
     1301      end.
     1302      else
     1303      do:
     1304         if cb-prop = "2" or cb-prop = "3" then
     1305         do:
     1306            buf_cash-pay-attr.attr-value = cb-card-type-bank .
     1307         end.
     1308         else
     1309         do:
     1310            delete buf_cash-pay-attr .
     1311            cb-card-type-bank = "" .
     1312         end.
     1313      end.
     1314      find first buf_cash-pay-attr where
     1315         buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1316         and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     1317         and buf_cash-pay-attr.attr-code = "cash-type-pay-fr" no-error .
     1318      if not AVAILABLE buf_cash-pay-attr then
     1319      do:
     1320         create buf_cash-pay-attr .
     1321         assign
     1322            buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1323            buf_cash-pay-attr.curr-code  = tt-cash-pay.curr-code
     1324            buf_cash-pay-attr.attr-code  = "cash-type-pay-fr"
     1325            buf_cash-pay-attr.attr-value = cb-type-pay-fr
     1326            .
     1327      end.
     1328      else
     1329      do:
     1330         buf_cash-pay-attr.attr-value = cb-type-pay-fr .
     1331      end.
     1332        find first buf_cash-pay-attr where
     1333           buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1334       and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
     1335       and buf_cash-pay-attr.attr-code = "qr-mir" no-error .
     1336     if not AVAILABLE buf_cash-pay-attr then
     1337     do:
     1338       create buf_cash-pay-attr .
     1339       assign
     1340         buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
     1341         buf_cash-pay-attr.curr-code  = tt-cash-pay.curr-code
     1342         buf_cash-pay-attr.attr-code  = "qr-mir"
     1343         buf_cash-pay-attr.attr-value = string(qr-mir)
     1344         .
     1345     end.
     1346     else
     1347     do:
     1348       buf_cash-pay-attr.attr-value = string(qr-mir) .
     1349     end.
     1350   END PROCEDURE.
