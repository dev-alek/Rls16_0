      286             LABEL "Предел без авторизации"
      287             VIEW-AS FILL-IN
      288             SIZE 15.63 BY 1
      289        cb-prop AT ROW 6.58 COL 48.63 COLON-ALIGNED WIDGET-ID 4
      290        cb-card-type-bank AT ROW 7.88 COL 48.75 COLON-ALIGNED WIDGET-ID 8
      291        cb-card-type AT ROW 7.88 COL 48.75 COLON-ALIGNED WIDGET-ID 8
      292        tt-cash-pay.slip-file-name AT ROW 9.17 COL 17.13 COLON-ALIGNED
      293             LABEL "Имя файла слипа"
      294             VIEW-AS FILL-IN
      295             SIZE 22 BY .96
      296        tt-cash-pay.rule-file-name AT ROW 9.17 COL 71.63 COLON-ALIGNED
      297             LABEL "Имя файла правил обработки"
      298             VIEW-AS FILL-IN
      299             SIZE 22 BY 1
      300        tt-cash-pay.is-cash AT ROW 11.5 COL 2.5
      301             LABEL "Платеж наличными"
      302             VIEW-AS TOGGLE-BOX
      303             SIZE 45 BY 1
      304        tt-cash-pay.atr128 AT ROW 11.5 COL 49
      305             LABEL "Платеж по топливной карте"
      306             VIEW-AS TOGGLE-BOX
      307             SIZE 45 BY 1
      308        tt-cash-pay.atr1 AT ROW 12.5 COL 2.5
      309             LABEL "Разрешается сдача и возврат"
      310             VIEW-AS TOGGLE-BOX
      311             SIZE 45 BY 1
      312        tt-cash-pay.is-credit-card AT ROW 12.5 COL 49
      313             LABEL "Кредитная карта"
      314             VIEW-AS TOGGLE-BOX
      315             SIZE 45.38 BY .92
      316        tt-cash-pay.atr2 AT ROW 13.5 COL 2.5
      317             LABEL "Разрешен перевод оплаты на платеж"
      318             VIEW-AS TOGGLE-BOX
      319             SIZE 45 BY 1
      320        tt-cash-pay.is-debet-card AT ROW 13.5 COL 49
      321             LABEL "Расчетная (дебетовая) карта"
      322             VIEW-AS TOGGLE-BOX
      323             SIZE 45.38 BY .92
      324        tt-cash-pay.atr4 AT ROW 14.5 COL 2.5
      325             LABEL "Принудительная печать слипа по платежу"
      326             VIEW-AS TOGGLE-BOX
      327             SIZE 45 BY 1
      328        tt-cash-pay.is-goods-pay AT ROW 14.5 COL 49
      329             LABEL "Платеж за товары"
      330             VIEW-AS TOGGLE-BOX
      331             SIZE 45.38 BY .92
      332        tt-cash-pay.atr8 AT ROW 15.5 COL 2.5
      333             LABEL "Принудительная печать фактуры по платежу"
      334             VIEW-AS TOGGLE-BOX
      335             SIZE 45 BY 1
      336        tt-cash-pay.is-service-pay AT ROW 15.5 COL 49.13
      337             LABEL "Сервисный платеж"
      338             VIEW-AS TOGGLE-BOX
      339             SIZE 45.38 BY .92
      340        tt-cash-pay.atr16 AT ROW 16.5 COL 2.5
      341             LABEL "Необходима on-line авторизация"
      342             VIEW-AS TOGGLE-BOX
      343             SIZE 45 BY 1
      344       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      345            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      346            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      347   DEFINE FRAME Dialog-Frame
      348        tt-cash-pay.is-all-pay AT ROW 16.5 COL 49.13
      349             LABEL "'Общий' платеж"
      350             VIEW-AS TOGGLE-BOX
      351             SIZE 45.38 BY .92
      352        tt-cash-pay.atr32 AT ROW 17.5 COL 2.5
      353             LABEL "Обязателен ввод PIN-кода"
      354             VIEW-AS TOGGLE-BOX
      355             SIZE 45 BY 1
      356        tt-cash-pay.is-card-swap AT ROW 17.5 COL 49.25
      357             LABEL "Запрос ввода карты"
      358             VIEW-AS TOGGLE-BOX
      359             SIZE 45.38 BY .92
      360        tt-cash-pay.atr64 AT ROW 18.5 COL 2.5
      361             LABEL "Топливный платеж"
      362             VIEW-AS TOGGLE-BOX
      363             SIZE 45 BY 1
      364        tt-cash-pay.is-bar-read AT ROW 18.5 COL 49.25
      365             LABEL "Запрашивать сканирование баркода талона для платежа"
      366             VIEW-AS TOGGLE-BOX
      367             SIZE 48.75 BY .92
      368        tt-cash-pay.is-credit AT ROW 19.5 COL 2.5
      369             LABEL "Платеж <В кредит>"
      370             VIEW-AS TOGGLE-BOX
      371             SIZE 45 BY 1 TOOLTIP "Не кредитная карта!!!!"
      372        tt-cash-pay.is-advance AT ROW 19.5 COL 49.25
      373             LABEL "Учет авансового платежа"
      374             VIEW-AS TOGGLE-BOX
      375             SIZE 45 BY 1
      376        T-register AT ROW 20.42 COL 2.5 WIDGET-ID 2
      377        T-kbo AT ROW 20.5 COL 49.25 WIDGET-ID 4
      378        T-can-mix AT ROW 21.5 COL 2.5 WIDGET-ID 6
      379        T-lnr AT ROW 21.5 COL 49.25 WIDGET-ID 8
      380        T-has-overpay AT ROW 22.42 COL 49.13 WIDGET-ID 12
      381        T-has-return AT ROW 22.5 COL 2.5 WIDGET-ID 10
      382        qr-mir AT ROW 23.25 COL 49.13 WIDGET-ID 10
      383        tt-cash-pay.pay-card-view AT ROW 24.46 COL 1.38
      384             LABEL "Префиксы N плат.карт для просмотра"
      385             VIEW-AS FILL-IN
      386             SIZE 52.25 BY 1 TOOLTIP "Список префикс номеров платежных карт, которые будут видны в BO"
      387        for-curr-name AT ROW 3.75 COL 28.5 COLON-ALIGNED NO-LABEL
      388        for-pay-name AT ROW 5 COL 21 COLON-ALIGNED NO-LABEL
      389        for-wth-name AT ROW 5 COL 70 COLON-ALIGNED NO-LABEL
      390        "Свойства платежа :" VIEW-AS TEXT
      391             SIZE 18 BY .75 AT ROW 10.75 COL 38.38
      392             BGCOLOR 8 FGCOLOR 4
      393        RECT-3 AT ROW 6.33 COL 1.5
      394        SPACE(0.99) SKIP(1.32)
      395       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      396            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      397            TITLE "Параметры типа кассового платежа"
      398            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      399   ASSIGN
      400      FRAME Dialog-Frame:SCROLLABLE = FALSE
      401      FRAME Dialog-Frame:HIDDEN     = TRUE.
      402   ASSIGN
      403      cb-card-type:HIDDEN IN FRAME Dialog-Frame = TRUE.
      404   cb-card-type-bank:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      405   assign
      406          qr-mir:hidden in frame Dialog-Frame = true .
      407   ON GO OF FRAME Dialog-Frame
      408      DO:
      409         run proc-save-record in this-procedure No-ERROR.
      410         if error-status:error then return no-apply.
      411      END.
      412   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      413      DO:
      414         APPLY "END-ERROR":U TO SELF.
      415      END.
      416   ON CHOOSE OF B-attr IN FRAME Dialog-Frame
      417      DO:
      418         run ref/cp-atti.w ( input parparentproc
      419            ,input 'ПРОСМОТР':U
      420            ,input tt-cash-pay.cdpay-code
      421            ,input tt-cash-pay.curr-code
      422            ,input p-host-code
      423            ,input p-obj-type
      424            ,input p-obj-code
      425            ) NO-ERROR.
      426      END.
      427   ON CHOOSE OF b-curr IN FRAME Dialog-Frame
      428      DO:
      429         define variable rr as recid no-undo.
      430         rr = ? .
      431         run ref/currency.w (parparentproc, "b-sel", input-output rr ).
      432         if rr <> ? then
      433         do:
      434            FIND FIRST buf_currency WHERE
      435               recid( buf_currency ) = rr NO-LOCK .
      436            DISPLAY
      437               buf_currency.curr-code @ tt-cash-pay.curr-code
      438               buf_currency.curr-name @ for-curr-name
      439               with frame Dialog-Frame .
      440         end.
      441      END.
      442   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      443      DO:
      444         define variable rid-list as character no-undo.
      445         run ref/ccashpay.w (
      446            input parparentproc
      447            , INPUT "":U
      448            , INPUT "one":U
      449            , OUTPUT  rid-list
      450            , INPUT tt-cash-pay.cdpay-code
      451            , INPUT tt-cash-pay.curr-code
      452            , input "":U
      453            ) no-error .
      454      END.
      455   ON CHOOSE OF b-pay IN FRAME Dialog-Frame
      456      DO:
      457         DEFINE VARIABLE rr as character no-undo .
      458         rr = ? .
      459         run ref/paytype.w (parparentproc,  "b-sel":U, output rr ).
      460         if rr <> '' then
      461         do:
      462            FIND FIRST buf_pay-type WHERE
      463               recid( buf_pay-type ) = integer(rr) NO-LOCK .
      464            DISPLAY
      465               buf_pay-type.obj-code @ tt-cash-pay.pay-code
      466               buf_pay-type.obj-name @ for-pay-name
      467               with frame Dialog-Frame .
      468         end.
      469      END.
      470   ON CHOOSE OF b-wealth IN FRAME Dialog-Frame
      471      DO:
      472         define variable rstr as character no-undo.
      473         run ref/wth-ref.w (
      474            input parparentproc
      475            , input "b-sel":U
      476            , input p-host-code
      477            , input p-obj-type
      478            , input p-obj-code
      479            , input 'все':U
      480            , input-output rstr ).
      481         if rstr <> '':U then
      482         do:
      483            FIND FIRST buf_wealth WHERE
      484               recid(buf_wealth) = integer(entry(1, rstr)) NO-LOCK .
      485            DISPLAY
      486               buf_wealth.wth-code @ tt-cash-pay.wth-code
      487               buf_wealth.wth-name @ for-wth-name
      488               with frame Dialog-Frame .
      489         end.
      490      END.
      491   ON VALUE-CHANGED OF cb-card-type IN FRAME Dialog-Frame
      492      DO:
      493         assign
      494            cb-card-type.
      495      END.
      496   ON VALUE-CHANGED OF cb-card-type-bank IN FRAME Dialog-Frame
      497      DO:
      498         assign
      499            cb-card-type-bank.
      500      END.
      501   ON VALUE-CHANGED OF cb-type-pay-fr IN FRAME Dialog-Frame
      502      DO:
      503         assign
      504            cb-type-pay-fr.
      505      END.
      506   ON VALUE-CHANGED OF cb-prop IN FRAME Dialog-Frame
      507      DO:
      508         assign cb-prop .
      509         if cb-prop = "4" then
      510         do:
      511            enable
      512               cb-card-type
      513               with frame Dialog-Frame
      514               .
      515            APPLY "value-change" to cb-card-type in FRAME Dialog-Frame .
      516         end.
      517         else
      518         do:
      519            HIDE
      520               cb-card-type
      521               in frame Dialog-Frame .
      522         end.
      523         if cb-prop = "2" or cb-prop = "3" then
      524         do:
      525            enable
      526               cb-card-type-bank
      527               with frame Dialog-Frame
      528               .
      529            APPLY "value-change" to cb-card-type-bank in FRAME Dialog-Frame .
      530         end.
      531         else
      532         do:
      533            HIDE
      534               cb-card-type-bank
      535               in frame Dialog-Frame .
      536         end.
      537        if cb-prop = "2" then
      538        do:
      539          enable
      540            qr-mir
      541            with frame Dialog-Frame
      542            .
      543            APPLY "value-change" to qr-mir in FRAME Dialog-Frame .
      544        end.
      545        else
      546        do:
      547          qr-mir = false .
      548          HIDE
      549            qr-mir
      550            in frame Dialog-Frame .
      551        end.
      552      END.
      553   ON VALUE-CHANGED OF cb-type-pay-fr IN FRAME Dialog-Frame
      554      DO:
      555         assign
      556            cb-type-pay-fr.
      557      END.
      558   ON LEAVE OF tt-cash-pay.cdpay-code IN FRAME Dialog-Frame
      559      DO:
      560      END.
      561   ON LEAVE OF tt-cash-pay.curr-code IN FRAME Dialog-Frame
      562      DO:
      563         FIND FIRST buf_currency NO-LOCK WHERE
      564            buf_currency.curr-code = INPUT FRAME Dialog-Frame tt-cash-pay.curr-code NO-ERROR.
      565         IF AVAIL buf_currency THEN
      566         DO:
      567            DISPLAY
      568               buf_currency.curr-name @ for-curr-name
      569               WITH FRAME Dialog-Frame.
      570         END.
      571      END.
      572   ON LEAVE OF tt-cash-pay.pay-code IN FRAME Dialog-Frame
      573      DO:
      574         FIND FIRST buf_pay-type NO-LOCK WHERE
      575            buf_pay-type.obj-code = INPUT FRAME Dialog-Frame tt-cash-pay.pay-code NO-ERROR.
      576         IF AVAIL buf_pay-type THEN
      577         DO:
      578            DISPLAY
      579               buf_pay-type.obj-name @ for-pay-name
      580               WITH FRAME Dialog-Frame.
      581         END.
      582      END.
      583   ON VALUE-CHANGED OF qr-mir IN FRAME Dialog-Frame
      584   DO:
      585     assign qr-mir.
      586   END.
      587   ON LEAVE OF tt-cash-pay.wth-code IN FRAME Dialog-Frame
      588      DO:
      589         FIND FIRST buf_wealth NO-LOCK WHERE
      590            buf_wealth.wth-code = INPUT FRAME Dialog-Frame tt-cash-pay.wth-code NO-ERROR.
      591         IF AVAIL buf_wealth THEN
      592         DO:
      593            DISPLAY
      594               buf_wealth.wth-name @ for-wth-name
      595               WITH FRAME Dialog-Frame.
      596         END.
      597      END.
      598   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      599      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      600   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      601   on help of frame Dialog-Frame
      602   do:
      603     run gbl/app_help.p
      604       (input this-procedure :file-name
      605       ,input ''
      606       ,input ?
      607       ) no-error.
      608     if error-status :error then do:
      609       message
      610         "Ошибка при вызове помощи"
      611         error-status :get-message(1)
      612         view-as alert-box .
      613     end.
      614   end.
      615   run minbtn-set in this-procedure .
      616   on choose of b-help in frame Dialog-Frame
      617   do:
      618     apply "help":u to frame Dialog-Frame .
      619   end.
      620   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      621   procedure minbtn-set :
      622       do
      623           on error undo, return error return-value
      624           :
      625           define variable ii              as integer       no-undo .
      626           define variable fh              as widget-handle no-undo .
      627           define variable hh              as widget-handle no-undo .
      628           define variable v-h             as handle        extent 4 no-undo .
      629           define variable v-name-button   as character     no-undo .
      630           define variable v-help-old-x    as decimal       no-undo .
      631           define variable v-help-old-y    as decimal       no-undo .
      632           define variable v-help-old-size as decimal       no-undo .
      633           define variable v-frame-width   as decimal       no-undo .
      634           define variable jj              as integer       no-undo .
      635           do
      636               on error undo, return error
      637               :
      638               assign
      639                   v-frame-width = frame Dialog-Frame:width - 0.3
      640                   fh            = frame Dialog-Frame:first-child
      641                   hh            = fh:first-child
      642                   ii            = 1
      643                   .
      644               do while valid-handle(hh):
      645                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      646                   do:
      647                       case lc(hh:name) :
      648                           when "b-help" then
      649                               do:
      650                                   hh:load-image-up("cmp/b-help.bmp":u) .
      651                                   hh:load-image-down("cmp/b-help.bmp":u) .
      652                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      653                                   hh:TOOLTIP = "Помощь" .
      654                                   v-help-old-x = hh:column .
      655                                   v-help-old-y = hh:row    .
      656                                   v-help-old-size = hh:width .
      657                                   hh:width-chars = 2.5 .
      658                               end.
      659                           when "b-print" then
      660                               do:
      661                                   hh:load-image("cmp/b-print.bmp":u) .
      662                                   hh:TOOLTIP = "Печать" .
      663                                   v-h[ii] = hh:handle .
      664                                   ii = ii + 1 .
      665                                   hh:width-chars = 3 .
      666                               end.
      667                           when "b-history" or
      668                           when "b-hist" then
      669                               do:
      670                                   hh:load-image("cmp/b-hist.bmp":u) .
      671                                   hh:TOOLTIP = "История" .
      672                                   v-h[ii] = hh:handle .
      673                                   ii = ii + 1 .
      674                                   hh:width-chars = 3 .
      675                               end.
      676                           when "b-sch" then
      677                               do:
      678                                   hh:load-image("cmp/b-sch.bmp":u) .
      679                                   hh:TOOLTIP = "Установка Фильтра" .
      680                                   v-h[ii] = hh:handle .
      681                                   ii = ii + 1 .
      682                                   hh:width-chars = 3 .
      683                               end.
      684                           when "b-hist-user" then
      685                               do:
      686                                   hh:load-image("cmp/b-hist.bmp":u) .
      687                                   hh:TOOLTIP = "История пользователя" .
      688                                   ii = ii + 1 .
      689                               end.
      690                       end case.
      691                   end.
      692                   hh = hh:next-sibling.
      693               end.
      694               b-help:column = v-frame-width - b-help:width-chars.
      695               jj = 0.
      696               repeat ii = 4 to 1 by -1 :
      697                   if valid-handle (v-h[ii] ) then
      698                   do:
      699                       jj  = jj + 1 .
      700                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      701                       v-h[ii]:row    = v-help-old-y .
      702                   end.
      703               end.
      704           end.
      705       end.
      706   end procedure.
      707   MAIN-BLOCK:
      708   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      709      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      710      if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U and par-mode <> 'ПРОСМОТР':U then
      711      do:
      712         message vss-workfile vss-revision vss-description skip
      713            "Неверный параметр вызова par-mode"
      714            view-as alert-box ERROR.
      715         return error.
      716      end.
      717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      718     (input  'is-wth'
      719     ,input  0
      720     ,input  ''
      721     ,input  0
      722     ,input  ''
      723     ,input  ''
      724     ,input  ''
      725     ,input  yes
      726     ,output conf-par
      727     ,output par-type
      728     ) no-error .
      729      IF not error-status:error then
      730         assign
      731            is-wth = (conf-par = "yes":U).
      732      Run fill-tables in this-procedure no-error.
      733      if error-status:error then return error.
      734      RUN Myenable.
      735      WAIT-FOR GO OF FRAME Dialog-Frame.
      736   END.
      737   RUN disable_UI.
      738   PROCEDURE disable_UI :
      739      HIDE FRAME Dialog-Frame.
      740   END PROCEDURE.
      741   PROCEDURE enable_UI :
      742      DISPLAY cb-type-pay-fr cb-prop T-register T-kbo T-can-mix T-lnr T-has-return
      743         T-has-overpay for-curr-name for-pay-name for-wth-name qr-mir
      744         WITH FRAME Dialog-Frame.
      745      IF AVAILABLE tt-cash-pay THEN
      746         DISPLAY tt-cash-pay.cdpay-code tt-cash-pay.obj-name tt-cash-pay.curr-code
      747            tt-cash-pay.pay-code tt-cash-pay.wth-code tt-cash-pay.pay-limit
      748            tt-cash-pay.slip-file-name tt-cash-pay.rule-file-name
      749            tt-cash-pay.is-cash tt-cash-pay.atr128 tt-cash-pay.atr1
      750            tt-cash-pay.is-credit-card tt-cash-pay.atr2 tt-cash-pay.is-debet-card
      751            tt-cash-pay.atr4 tt-cash-pay.is-goods-pay tt-cash-pay.atr8
      752            tt-cash-pay.is-service-pay tt-cash-pay.atr16 tt-cash-pay.is-all-pay
      753            tt-cash-pay.atr32 tt-cash-pay.is-card-swap tt-cash-pay.atr64
      754            tt-cash-pay.is-bar-read tt-cash-pay.is-credit tt-cash-pay.is-advance
      755            tt-cash-pay.pay-card-view
      756            WITH FRAME Dialog-Frame.
      757      ENABLE B-exit b-quit B-attr B-hist B-Help RECT-3 tt-cash-pay.cdpay-code
      758         tt-cash-pay.obj-name tt-cash-pay.curr-code b-curr cb-type-pay-fr
      759         tt-cash-pay.pay-code b-pay tt-cash-pay.wth-code b-wealth
      760         tt-cash-pay.pay-limit cb-prop tt-cash-pay.slip-file-name
      761         tt-cash-pay.rule-file-name tt-cash-pay.is-cash tt-cash-pay.atr128
      762         tt-cash-pay.atr1 tt-cash-pay.is-credit-card tt-cash-pay.atr2
      763         tt-cash-pay.is-debet-card tt-cash-pay.atr4 tt-cash-pay.is-goods-pay
      764         tt-cash-pay.atr8 tt-cash-pay.is-service-pay tt-cash-pay.atr16
      765         tt-cash-pay.is-all-pay tt-cash-pay.atr32 tt-cash-pay.is-card-swap
      766         tt-cash-pay.atr64 tt-cash-pay.is-bar-read tt-cash-pay.is-credit
      767         tt-cash-pay.is-advance T-register T-kbo T-can-mix T-lnr T-has-return
      768         T-has-overpay tt-cash-pay.pay-card-view for-curr-name for-pay-name
      769         for-wth-name qr-mir
      770         WITH FRAME Dialog-Frame.
      771      VIEW FRAME Dialog-Frame.
      772   END PROCEDURE.
      773   PROCEDURE fill-tables :
      774      for each tt-cash-pay:
      775         delete tt-cash-pay.
      776      end.
      777      VIEW FRAME Dialog-Frame.
      778      IF par-mode = 'ДОБАВЛЕНИЕ':U then
      779      do:
      780         FIND LAST ub.cash-pay NO-LOCK  use-index pi NO-ERROR .
      781         if available ub.cash-pay then
      782            tcode = ub.cash-pay.cdpay-code + 1.
      783         else
      784            tcode = 1.
      785         DO TRANSACTION ON ERROR UNDO, RETURN ERROR:
      786            create tt-cash-pay.
      787            assign
      788               tt-cash-pay.cdpay-code = tcode
      789               .
      790         END.
      791      end.
      792      else
      793      do:
      794         if par-mode = 'ПРОСМОТР':U then
      795         do:
      796            FIND FIRST locked_cash-pay NO-LOCK WHERE
      797               recid(locked_cash-pay) = par-ri.
      798         end.
      799         ELSE
      800         do:
      801            DO TRANSACTION
      802               ON ERROR UNDO, RETURN ERROR:
      803               FIND FIRST locked_cash-pay EXCLUSIVE-LOCK WHERE
      804                  recid(locked_cash-pay) = par-ri.
      805            END.
      806         END.
      807         IF NOT AVAIL locked_cash-pay then
      808            return error.
      809         create tt-cash-pay.
      810         buffer-copy locked_cash-pay to tt-cash-pay.
      811         FIND FIRST buf_currency No-LOCK WHERe
      812            buf_currency.curr-code = tt-cash-pay.curr-code No-ERROR.
      813         if not avail buf_currency then
      814         do:
      815            message "Тип кассового платежа" locked_cash-pay.cdpay-code  skip
      816               "Неверная валюта" locked_cash-pay.curr-code
      817               view-as alert-box ERROR.
      818            return error.
      819         end.
      820         FIND FIRST buf_pay-type No-LOCK WHERe
      821            buf_pay-type.obj-code = tt-cash-pay.pay-code No-ERROR.
      822         if not avail buf_pay-type then
      823         do:
      824            message "Тип кассового платежа" locked_cash-pay.cdpay-code  skip
      825               "Неверная оплата" locked_cash-pay.pay-code
      826               view-as alert-box ERROR.
      827            return error.
      828         end.
      829         if tt-cash-pay.wth-code > 0 then
      830         do:
      831            FIND FIRST buf_wealth No-LOCK WHERe
      832               buf_wealth.wth-code = tt-cash-pay.wth-code No-ERROR.
      833            if not avail buf_wealth then
      834            do:
      835               message "Тип кассового платежа" locked_cash-pay.cdpay-code  skip
      836                  "Неверный код МЦ" locked_cash-pay.wth-code
      837                  view-as alert-box ERROR.
      838               return error.
      839            end.
      840         end.
      841      end.
      842      find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
      843         and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
      844         and buf_cash-pay-attr.attr-code = "cash-prop" no-error .
      845      if AVAILABLE buf_cash-pay-attr then
      846      do:
      847         cb-prop = buf_cash-pay-attr.attr-value .
      848      end.
      849      find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
      850         and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
      851         and buf_cash-pay-attr.attr-code = "cash-card-type" no-error .
      852      if AVAILABLE buf_cash-pay-attr then
      853      do:
      854         cb-card-type = buf_cash-pay-attr.attr-value .
      855      end.
      856      find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
      857         and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
      858         and buf_cash-pay-attr.attr-code = "cash-card-type-bank" no-error .
      859      if AVAILABLE buf_cash-pay-attr then
      860      do:
      861         cb-card-type-bank = buf_cash-pay-attr.attr-value .
      862      end.
      863      find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
      864         and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
      865         and buf_cash-pay-attr.attr-code = "cash-type-pay-fr" no-error .
      866      if AVAILABLE buf_cash-pay-attr then
      867      do:
      868         cb-type-pay-fr = buf_cash-pay-attr.attr-value .
      869      end.
      870      find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = tt-cash-pay.cdpay-code
      871                                    and buf_cash-pay-attr.curr-code = tt-cash-pay.curr-code
      872                                    and buf_cash-pay-attr.attr-code = "qr-mir" no-error .
      873       if AVAILABLE buf_cash-pay-attr then do:
      874       qr-mir = logical(buf_cash-pay-attr.attr-value) .
      875       end.
      876   END PROCEDURE.
      877   PROCEDURE Myenable :
      878      DISPLAY
      879         for-curr-name
      880         for-pay-name
      881         for-wth-name
      882         WITH FRAME Dialog-Frame.
      883      IF AVAILABLE tt-cash-pay THEN
      884      DO:
      885         ASSIGN
      886            t-register    = (tt-cash-pay.register > 0)
      887            t-kbo         = (tt-cash-pay.is-kbo > 0)
      888            t-lnr         = (tt-cash-pay.is-lnr > 0)
      889            t-can-mix     = (tt-cash-pay.can-mix > 0)
      890            t-has-return  = (tt-cash-pay.has-return > 0)
      891            t-has-overpay = (tt-cash-pay.has-overpay > 0)
      892            .
      893         DISPLAY
      894            tt-cash-pay.cdpay-code
      895            tt-cash-pay.obj-name
      896            tt-cash-pay.curr-code
      897            tt-cash-pay.pay-code
      898            tt-cash-pay.wth-code
      899            tt-cash-pay.pay-limit
      900            tt-cash-pay.is-cash
      901            tt-cash-pay.atr1
      902            tt-cash-pay.atr2
      903            tt-cash-pay.atr4
      904            tt-cash-pay.atr8
      905            tt-cash-pay.atr16
      906            tt-cash-pay.atr32
      907            tt-cash-pay.atr64
      908            tt-cash-pay.atr128
      909            tt-cash-pay.is-debet-card
      910            tt-cash-pay.is-advance
      911            tt-cash-pay.is-credit
      912            tt-cash-pay.is-credit-card
      913            tt-cash-pay.pay-card-view
      914            tt-cash-pay.is-all-pay
      915            tt-cash-pay.is-bar-read
      916            tt-cash-pay.is-card-swap
      917            tt-cash-pay.is-goods-pay
      918            tt-cash-pay.is-service-pay
      919            tt-cash-pay.rule-file-name
      920            tt-cash-pay.slip-file-name
      921            t-register
      922            cb-prop
      923            t-kbo
      924            t-lnr
      925            t-can-mix
      926            t-has-return
      927            t-has-overpay
      928            cb-type-pay-fr
      929            WITH FRAME Dialog-Frame.
      930      END.
      931      if cb-prop = "4" then
      932      do:
      933         display cb-card-type
      934            WITH FRAME Dialog-Frame.
      935      end.
      936      if cb-prop = "2" or cb-prop = "3" then
      937      do:
      938         display cb-card-type-bank
      939            WITH FRAME Dialog-Frame.
      940      end.
      941      if cb-prop = "2" then
      942      do:
      943         display qr-mir
      944            WITH FRAME Dialog-Frame.
      945      end.
      946      if available buf_currency then
      947         display
      948            buf_currency.curr-name @ for-curr-name
      949            WITH FRAME Dialog-Frame.
      950      if available buf_pay-type then
      951         display
      952            buf_pay-type.obj-name @ for-pay-name
      953            WITH FRAME Dialog-Frame.
      954      if available buf_wealth then
      955         display
      956            buf_wealth.wth-name @ for-wth-name
      957            WITH FRAME Dialog-Frame.
      958      CASE par-mode:
      959         when 'ДОБАВЛЕНИЕ':U then
      960            do:
      961               ENABLE
      962                  B-exit
      963                  tt-cash-pay.cdpay-code
      964                  tt-cash-pay.obj-name
      965                  b-curr
      966                  tt-cash-pay.curr-code
      967                  tt-cash-pay.pay-code
      968                  b-pay
      969                  tt-cash-pay.wth-code
      970                  b-wealth
      971                  tt-cash-pay.pay-limit
      972                  tt-cash-pay.is-cash
      973                  tt-cash-pay.atr1
      974                  tt-cash-pay.atr2
      975                  tt-cash-pay.atr4
      976                  tt-cash-pay.atr8
      977                  tt-cash-pay.atr16
      978                  tt-cash-pay.atr32
      979                  tt-cash-pay.atr64
      980                  tt-cash-pay.atr128
      981                  tt-cash-pay.is-advance
      982                  tt-cash-pay.is-debet-card
      983                  tt-cash-pay.is-credit
      984                  tt-cash-pay.is-credit-card
      985                  tt-cash-pay.pay-card-view
      986                  tt-cash-pay.is-all-pay
      987                  tt-cash-pay.is-bar-read
      988                  tt-cash-pay.is-card-swap
      989                  tt-cash-pay.is-goods-pay
      990                  tt-cash-pay.is-service-pay
      991                  tt-cash-pay.rule-file-name
      992                  tt-cash-pay.slip-file-name
      993                  t-register
      994                  cb-prop
      995                  t-kbo
      996                  t-lnr
      997                  t-can-mix
      998                  t-has-return
      999                  t-has-overpay
     1000                  cb-type-pay-fr
     1001                  WITH FRAME Dialog-Frame.
     1002               if cb-prop = "4" then
     1003               do:
     1004                  enable cb-card-type with frame Dialog-Frame .
     1005               end.
     1006               if cb-prop = "2" or cb-prop = "3" then
     1007               do:
     1008                  enable cb-card-type-bank with frame Dialog-Frame .
     1009               end.
     1010              if cb-prop = "2" then
     1011              do:
     1012                display qr-mir
     1013                  WITH FRAME Dialog-Frame.
     1014              end.
     1015            end.
     1016         when 'ИЗМЕНЕНИЕ':U then
     1017            do:
     1018               find first ub.db No-LOCK where ub.db.db-num > 0 No-ERROR.
     1019               if not avail ub.db then
     1020               do:
     1021                  FIND FIRST ub.chk-pay No-LOCK WHERE
     1022                     ub.chk-pay.pay-code = tt-cash-pay.cdpay-code  AND
     1023                     ub.chk-pay.curr-code = tt-cash-pay.curr-code No-ERROR.
     1024               end.
     1025               ENABLE
     1026                  B-exit
     1027                  tt-cash-pay.cdpay-code
     1028                  when (not available ub.db and not available chk-pay)
     1029                  tt-cash-pay.curr-code
     1030                  when (not available ub.db and not available chk-pay)
     1031                  tt-cash-pay.obj-name
     1032                  tt-cash-pay.pay-code
     1033                  b-pay
     1034                  b-hist
     1035                  tt-cash-pay.wth-code
     1036                  b-wealth
     1037                  tt-cash-pay.pay-limit
     1038                  tt-cash-pay.is-cash
     1039                  tt-cash-pay.atr1
