      261        tt-cash-pay.cdpay-code AT ROW 2.25 COL 19 COLON-ALIGNED
      262             LABEL "Код типа платежа" FORMAT "9999"
      263             VIEW-AS FILL-IN
      264             SIZE 11.5 BY 1
      265        tt-cash-pay.obj-name AT ROW 2.25 COL 45.5 COLON-ALIGNED
