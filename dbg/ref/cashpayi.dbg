      162      IMAGE-DOWN FILE "btn-down-arrow":U
      163      IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      164      LABEL "":L
      165      SIZE 3 BY 1
      166      BGCOLOR 8 FGCOLOR 0 .
      167   DEFINE VARIABLE cb-card-type-bank AS CHARACTER FORMAT "X(256)":U
