     1051                  tt-cash-pay.pay-card-view
     1052                  tt-cash-pay.is-all-pay
     1053                  tt-cash-pay.is-bar-read
     1054                  tt-cash-pay.is-card-swap
     1055                  tt-cash-pay.is-goods-pay
     1056                  tt-cash-pay.is-service-pay
