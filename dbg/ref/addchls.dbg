        1   define input parameter   parParentProc  as widget-handle no-undo.
        2   define input parameter   bttns          as character no-undo .
        3   define output parameter  p-rid-list     as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Список дополнительных расходов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define new shared temp-table gds-list no-undo like ub.goods
      117     field qnty   as decimal
      118     field to-del as logical
      119     field order-num as integer
      120     field to-sel as logical
      121     field promo-code as character
      122     field ActionId  as int64
      123     field db-num as integer
      124     index art  is primary unique artic prod-type prod-code
      125     index code is         unique gds-code
      126     index oi order-num
      127     index isel to-sel
      128     .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define  new shared  temp-table gds-list-hist no-undo
      131   field list-table as character
      132   field id as integer
      133   field line as integer
      134   field hist-mode as character
      135   field des as character
      136   field num-recs as integer
      137   field option_ as character
      138   field item_ as character
      139   field status_ as character
      140   field num-add as integer
      141   field num-ignored as integer
      142   field done as logical
      143   field err_ as logical
      144   field err-mes as character
      145   index pi is primary
      146   id
      147   line
      148   index isdone
      149   done
      150   .
      151   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152     define variable v-cntxt-db-num        as integer   no-undo .
      153     define variable v-cntxt-userid        as character no-undo .
      154     define variable v-cntxt-level         as character no-undo .
      155     define variable v-cntxt-host-code-obj as integer   no-undo .
      156     define variable v-cntxt-obj-type      as character no-undo .
      157     define variable v-cntxt-obj-code      as integer   no-undo .
      158     define variable v-cntxt-db-num-obj    as integer   no-undo .
      159     define variable v-cntxt-is-admin      as logical   no-undo .
      160   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161     run mainmenu_getcntxt in parparentproc
      162       (output v-cntxt-db-num
      163       ,output v-cntxt-userid
      164       ,output v-cntxt-level
      165       ,output v-cntxt-host-code-obj
      166       ,output v-cntxt-obj-type
      167       ,output v-cntxt-obj-code
      168       ,output v-cntxt-db-num-obj
      169       ,output v-cntxt-is-admin
      170       ) .
      171   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   FUNCTION alg-name RETURNS CHARACTER
      173     ( buffer loc-table for ub.gds-add-charges ) :
      174   if not available  loc-table  then return "678" .
      175   if loc-table.cost-include = no then return "".
      176   case loc-table.algoritm :
      177     when "1" then do:
      178       return "сумме приходных цен".
      179     end.
      180     when "2" then do:
      181       return "количеству(в баз. ед.изм.)".
      182     end.
      183     when "3" then do:
      184       return "количеству(в пост. ед.изм.)" .
      185     end.
      186     when "4" then do:
      187       return "весу".
      188     end.
      189   end case.
      190   END FUNCTION.
      191   define variable log-res as log no-undo.
      192   define variable rr as recid no-undo.
      193   define variable v-log as logical   no-undo .
      194   define variable line-mode as character no-undo .
      195   define variable doc-rec as recid no-undo .
      196   define variable gds-rec as recid no-undo .
      197   define variable lns-cnt as integer   no-undo .
      198   define variable g#log as logical   no-undo .
      199   define variable alg as character no-undo .
      200   define temp-table tt-gds-list no-undo like ub.goods
      201   field nn as integer
      202   index by-nn nn
      203   index by_gds-code gds-code
      204   .
      205   define variable varschartic       like ub.goods.artic initial " " no-undo.
      206   define variable ref-list  as character                     no-undo.
      207   define variable sch-field as character no-undo.
      208   define buffer buf_gds-add-charges for ub.gds-add-charges.
      209   define buffer buf_goods      for ub.goods.
      210   define variable sort-column-name as character no-undo .
      211   define variable list-option as character no-undo.
      212   define stream sout.
      213   FUNCTION mark-string RETURNS CHARACTER
      214   ( buffer loc-table for ub.goods, input mark-list as character )  FORWARD.
      215   DEFINE BUTTON b-exit AUTO-GO
      216        LABEL "&Выход ":L
      217        SIZE 10 BY 1.
      218   DEFINE BUTTON b-help
      219        LABEL "Помо&щь":L
      220        SIZE 10 BY 1.
      221   DEFINE BUTTON B-mark
      222        LABEL "&*"
      223        SIZE 3 BY 1.
      224   DEFINE BUTTON b-print
      225        LABEL "Пе&чать":L
      226        SIZE 10 BY 1.
      227   DEFINE BUTTON b-sel AUTO-GO
      228        LABEL "Вы&бор ":L
      229        SIZE 10 BY 1.
      230   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск по"
      231         VIEW-AS TEXT
      232        SIZE 8.88 BY .67
      233        FGCOLOR 4  NO-UNDO.
      234   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      235         VIEW-AS TEXT
      236        SIZE 9 BY .67
      237        FGCOLOR 4  NO-UNDO.
      238   DEFINE VARIABLE s-artic AS CHARACTER FORMAT "X(256)":U
      239        VIEW-AS FILL-IN
      240        SIZE 30 BY 1
      241        FGCOLOR 1  NO-UNDO.
      242   DEFINE VARIABLE s-name AS CHARACTER FORMAT "X(256)":U
      243        VIEW-AS FILL-IN
      244        SIZE 30 BY 1
      245        FGCOLOR 1  NO-UNDO.
      246   DEFINE VARIABLE s-name-cnt AS CHARACTER FORMAT "X(256)":U
      247        VIEW-AS FILL-IN
      248        SIZE 30 BY 1
      249        FGCOLOR 1  NO-UNDO.
      250   DEFINE VARIABLE R-sort AS INTEGER
      251        VIEW-AS RADIO-SET HORIZONTAL
      252        RADIO-BUTTONS
      253             "Артик", 1,
      254   "Нач.назв", 2,
      255   "Нач.слова", 3
      256        SIZE 34.63 BY .96 TOOLTIP "Поиск по" NO-UNDO.
      257   DEFINE QUERY BROWSE-2 FOR
      258         ub.gds-add-charges,
      259         ub.goods SCROLLING.
      260   DEFINE BROWSE BROWSE-2
      261     QUERY BROWSE-2 NO-LOCK DISPLAY
      262         mark-string(buffer ub.goods , p-rid-list) FORMAT "X(1)":U COLUMN-LABEL "*"
      263         ub.goods.artic FORMAT "X(16)":U
      264         ub.goods.gds-name FORMAT "X(48)":U
      265         ub.goods.unit-base FORMAT "X(3)":U
      266         alg-name(buffer ub.gds-add-charges) @ alg FORMAT "X(30)":U COLUMN-LABEL "Алгоритм включения в учетную цену"
      267         ub.goods.gds-code FORMAT "999999999":U
      268        ENABLE
      269             ub.goods.artic
      270       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 18.33
      271            BGCOLOR 15 .
      272   DEFINE FRAME Dialog-Frame
      273        b-exit AT ROW 1 COL 1
      274        b-sel AT ROW 1 COL 11
      275        B-mark AT ROW 1 COL 21
      276        b-print AT ROW 1 COL 54
      277        b-help AT ROW 1 COL 78
      278        R-sort AT ROW 2.04 COL 10.75 NO-LABEL
      279        s-name AT ROW 2.04 COL 44.13 COLON-ALIGNED NO-LABEL
      280        s-name-cnt AT ROW 2.04 COL 44.13 COLON-ALIGNED NO-LABEL
      281        s-artic AT ROW 2.04 COL 44.13 COLON-ALIGNED NO-LABEL
      282        BROWSE-2 AT ROW 3.71 COL 1
      283        FILL-IN-2 AT ROW 2.21 COL 1 NO-LABEL
      284        mark-num AT ROW 2.96 COL 1 NO-LABEL
      285        SPACE(89.74) SKIP(18.41)
      286       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      287            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      288            TITLE "Товары по сезону".
      289   ASSIGN
      290          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      291          FRAME Dialog-Frame:HIDDEN           = TRUE.
      292   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      293   DO:
      294     APPLY "END-ERROR":U TO SELF.
      295   END.
      296   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      297   DO:
      298     define variable loc#log as logical no-undo .
      299     if AVAILABLE ub.goods  then do:
      300   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   define variable v-str-recid6 as character no-undo .
      302   define variable v-num-entry6 as integer   no-undo .
      303   assign
      304     v-str-recid6 = trim( string( recid( ub.goods ) , "->>>>>>>>>>>9":U ) )
      305     v-num-entry6 = lookup( v-str-recid6 , p-rid-list )
      306   .
      307   if v-num-entry6 > 0 then do:
      308     assign
      309       entry( v-num-entry6, p-rid-list ) = "":U
      310       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      311     .
      312   end.
      313   else do:
      314     assign
      315       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid6
      316     .
      317   end.
      318       loc#log = BROWSE-2:refresh() .
      319       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      320           loc#log = BROWSE-2:select-next-row ().
      321           apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
      322       end.
      323       if num-entries( p-rid-list ) = 0
      324       then
      325           hide mark-num in frame Dialog-Frame.
      326       else
      327           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
      328     end.
      329     apply "entry" to BROWSE-2 in frame Dialog-Frame.
      330   END.
      331   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      332   DO:
      333       if ( available ub.goods ) AND ( p-rid-list = "" ) then
      334           p-rid-list = string( recid( ub.goods ) ) .
      335   END.
      336   ON VALUE-CHANGED OF R-sort IN FRAME Dialog-Frame
      337   DO:
      338     Assign frame Dialog-Frame r-sort.
      339     case r-sort :
      340     when 1 then do:
      341           if sch-field = "s-name-cnt" then do:
      342                          assign frame Dialog-Frame:title = "Дополнительные расходы".
      343                         OPEN QUERY BROWSE-2 FOR EACH                           ub.gds-add-charges NO-LOCK,                                  EACH ub.goods WHERE                           ub.goods.gds-code = ub.gds-add-charges.gds-code and                           ub.goods.stts = 0                           NO-LOCK     .
      344                         end.
      345           enable s-artic with frame Dialog-Frame.
      346               Hide s-name  s-name-cnt in frame Dialog-Frame.
      347           display s-artic with frame Dialog-Frame.
      348      end.
      349     when 2 then do:
      350       if sch-field = "s-name-cnt" then do:
      351                    assign frame Dialog-Frame:title = "Дополнительные расходы ".
      352                   OPEN QUERY BROWSE-2 FOR EACH                           ub.gds-add-charges NO-LOCK,                                  EACH ub.goods WHERE                           ub.goods.gds-code = ub.gds-add-charges.gds-code and                           ub.goods.stts = 0                           NO-LOCK     .
      353                   end.
      354           enable s-name with frame Dialog-Frame.
      355           hide s-artic  s-name-cnt in frame Dialog-Frame.
      356           display s-name with frame Dialog-Frame.
      357      end.
      358     when 3 then do:
      359           enable s-name-cnt with frame Dialog-Frame.
      360           hide s-artic  s-name in frame Dialog-Frame.
      361           display s-name-cnt with frame Dialog-Frame.
      362      end.
      363     end case.
      364   END.
      365   ON MOUSE-SELECT-DBLCLICK OF s-artic IN FRAME Dialog-Frame
      366   OR  RETURN OF s-artic IN FRAME Dialog-Frame
      367   DO:
      368     if s-artic <> input frame Dialog-Frame s-artic or sch-field <> "s-artic" then do:
      369    sch-field = "s-artic".
      370    assign s-artic = input frame Dialog-Frame s-artic.
      371    doc-rec = ?.
      372    for each buf_gds-add-charges no-lock ,
      373               first buf_goods no-lock where
      374                     buf_goods.gds-code = buf_gds-add-charges.gds-code and
      375                     buf_goods.artic begins s-artic :
      376            doc-rec = recid ( buf_gds-add-charges ) .
      377            leave.
      378    end.
      379     if doc-rec = ? then message "Товар не найден !"  .
      380     else
      381         reposition BROWSE-2 to recid doc-rec no-error.
      382   return no-apply.
      383   end.
      384   END.
      385   ON MOUSE-SELECT-DBLCLICK OF s-name IN FRAME Dialog-Frame
      386   OR  RETURN OF s-name IN FRAME Dialog-Frame
      387   DO:
      388     if s-name <> input frame Dialog-Frame s-name or sch-field <> "s-name" then do:
      389    sch-field = "s-name".
      390    assign s-name = input frame Dialog-Frame s-name.
      391    doc-rec = ?.
      392    for each buf_gds-add-charges no-lock ,
      393               first buf_goods no-lock where
      394                     buf_goods.gds-code = buf_gds-add-charges.gds-code and
      395                     buf_goods.gds-name begins s-name
      396                     :
      397            doc-rec = recid(buf_gds-add-charges) .
      398            leave.
      399    end.
      400     if doc-rec = ? then message "Товар не найден !"  .
      401     else
      402         reposition BROWSE-2 to recid doc-rec no-error.
      403   return no-apply.
      404   end.
      405   END.
      406   ON MOUSE-SELECT-DBLCLICK OF s-name-cnt IN FRAME Dialog-Frame
      407   OR  RETURN OF s-name-cnt IN FRAME Dialog-Frame
      408   DO:
      409     if s-name-cnt <> input frame Dialog-Frame s-name-cnt or sch-field <> "s-name-cnt" then do:
      410    sch-field = "s-name-cnt".
      411    assign s-name-cnt = input frame Dialog-Frame s-name-cnt.
      412    doc-rec = ?.
      413    for each buf_gds-add-charges no-lock ,
      414               first buf_goods no-lock where
      415                     buf_goods.gds-code = buf_gds-add-charges.gds-code  and
      416               INDEX (buf_goods.gds-name,s-name-cnt) > 0
      417               :
      418            doc-rec = recid(buf_gds-add-charges) .
      419            leave.
      420    end.
      421     if doc-rec = ? then message "Товар не найден !"  .
      422     else do:
      423        assign frame Dialog-Frame:title = "Дополнительные расходы , содержащие в названии " + s-name-cnt .
      424         OPEN QUERY BROWSE-2 FOR EACH ub.gds-add-charges             NO-LOCK,       EACH ub.goods where       ub.goods.gds-code = ub.gds-add-charges.gds-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK .
      425        end.
      426   return no-apply.
      427   end.
      428   END.
      429   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      430   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      431   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   on help of frame Dialog-Frame
      433   do:
      434     run gbl/app_help.p
      435       (input this-procedure :file-name
      436       ,input ''
      437       ,input ?
      438       ) no-error.
      439     if error-status :error then do:
      440       message
      441         "Ошибка при вызове помощи"
      442         error-status :get-message(1)
      443         view-as alert-box .
      444     end.
      445   end.
      446   run minbtn-set in this-procedure .
      447   on choose of b-help in frame Dialog-Frame
      448   do:
      449     apply "help":u to frame Dialog-Frame .
      450   end.
      451   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      452   procedure minbtn-set :
      453       do
      454           on error undo, return error return-value
      455           :
      456           define variable ii              as integer       no-undo .
      457           define variable fh              as widget-handle no-undo .
      458           define variable hh              as widget-handle no-undo .
      459           define variable v-h             as handle        extent 4 no-undo .
      460           define variable v-name-button   as character     no-undo .
      461           define variable v-help-old-x    as decimal       no-undo .
      462           define variable v-help-old-y    as decimal       no-undo .
      463           define variable v-help-old-size as decimal       no-undo .
      464           define variable v-frame-width   as decimal       no-undo .
      465           define variable jj              as integer       no-undo .
      466           do
      467               on error undo, return error
      468               :
      469               assign
      470                   v-frame-width = frame Dialog-Frame:width - 0.3
      471                   fh            = frame Dialog-Frame:first-child
      472                   hh            = fh:first-child
      473                   ii            = 1
      474                   .
      475               do while valid-handle(hh):
      476                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      477                   do:
      478                       case lc(hh:name) :
      479                           when "b-help" then
      480                               do:
      481                                   hh:load-image-up("cmp/b-help.bmp":u) .
      482                                   hh:load-image-down("cmp/b-help.bmp":u) .
      483                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      484                                   hh:TOOLTIP = "Помощь" .
      485                                   v-help-old-x = hh:column .
      486                                   v-help-old-y = hh:row    .
      487                                   v-help-old-size = hh:width .
      488                                   hh:width-chars = 2.5 .
      489                               end.
      490                           when "b-print" then
      491                               do:
      492                                   hh:load-image("cmp/b-print.bmp":u) .
      493                                   hh:TOOLTIP = "Печать" .
      494                                   v-h[ii] = hh:handle .
      495                                   ii = ii + 1 .
      496                                   hh:width-chars = 3 .
      497                               end.
      498                           when "b-history" or
      499                           when "b-hist" then
      500                               do:
      501                                   hh:load-image("cmp/b-hist.bmp":u) .
      502                                   hh:TOOLTIP = "История" .
      503                                   v-h[ii] = hh:handle .
      504                                   ii = ii + 1 .
      505                                   hh:width-chars = 3 .
      506                               end.
      507                           when "b-sch" then
      508                               do:
      509                                   hh:load-image("cmp/b-sch.bmp":u) .
      510                                   hh:TOOLTIP = "Установка Фильтра" .
      511                                   v-h[ii] = hh:handle .
      512                                   ii = ii + 1 .
      513                                   hh:width-chars = 3 .
      514                               end.
      515                           when "b-hist-user" then
      516                               do:
      517                                   hh:load-image("cmp/b-hist.bmp":u) .
      518                                   hh:TOOLTIP = "История пользователя" .
      519                                   ii = ii + 1 .
      520                               end.
      521                       end case.
      522                   end.
      523                   hh = hh:next-sibling.
      524               end.
      525               b-help:column = v-frame-width - b-help:width-chars.
      526               jj = 0.
      527               repeat ii = 4 to 1 by -1 :
      528                   if valid-handle (v-h[ii] ) then
      529                   do:
      530                       jj  = jj + 1 .
      531                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      532                       v-h[ii]:row    = v-help-old-y .
      533                   end.
      534               end.
      535           end.
      536       end.
      537   end procedure.
      538   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      539   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      540   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      541   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      542   define variable v-diasize-current-frame-width  as decimal   no-undo .
      543   define variable v-diasize-current-frame-height as decimal   no-undo .
      544   define variable v-diasize-change-size          as logical   no-undo .
      545   define variable v-diasize-resize-button        as handle    no-undo .
      546   define variable v-diasize-wndmax               as logical   no-undo .
      547   define variable v-diasize-wndstore             as logical   no-undo .
      548   define variable v-diasize-proc-name            as character no-undo .
      549   define variable v-diasize-browse-handle        as handle    no-undo .
      550   define variable v-diasize-browse-number        as integer   no-undo .
      551   define variable v-diasize-need-full-display    as logical   no-undo init false .
      552   define temp-table temp-diasize-handle no-undo
      553     field handle-value  as handle
      554     field save-position as decimal
      555     index xpk is primary unique handle-value
      556     .
      557   define temp-table temp-browse-handle no-undo
      558     field browse-type   as character
      559     field browse-number as integer
      560     field browse-handle as handle
      561     field original-size as decimal
      562     index xpk is primary unique browse-type browse-number
      563     index xie browse-type browse-handle
      564   .
      565   procedure diasize_change-height :
      566     define input  parameter p-change-value  as decimal   no-undo .
      567     define input  parameter p-move-resize   as logical   no-undo .
      568     define variable v-field-group-handle    as handle    no-undo .
      569     define variable v-object-handle         as handle    no-undo .
      570     define variable v-frame-height          as decimal   no-undo .
      571     define variable v-frame-virtual-height  as decimal   no-undo .
      572     define variable v-browse-height         as decimal   no-undo .
      573     define variable v-window-height         as decimal   no-undo .
      574     define variable v-window-virtual-height as decimal   no-undo .
      575     define variable v-change-sign           as integer   no-undo .
      576     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      577     define buffer buf_temp-browse-handle  for temp-browse-handle .
      578     if p-change-value > 0
      579     then do:
      580       if frame Dialog-Frame :height + p-change-value
      581           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      582       then do:
      583         assign
      584           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      585                           - (frame Dialog-Frame :height-chars)
      586         .
      587         if p-change-value <= 0
      588         then do:
      589           run diasize_position-resize-button in this-procedure .
      590           return .
      591         end.
      592       end.
      593     end.
      594     if p-change-value < 0
      595     then do:
      596       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      597       then do:
      598         assign
      599           p-change-value = v-diasize-orig-frame-height
      600                          - (frame Dialog-Frame :height-chars)
      601         .
      602         if p-change-value >= 0
      603         then do:
      604           run diasize_position-resize-button in this-procedure .
      605           return .
      606         end.
      607       end.
      608     end.
      609     if p-change-value >= 0
      610     then do:
      611       assign
      612         v-change-sign = 1
      613       .
      614     end.
      615     else do:
      616       assign
      617         v-change-sign = -1
      618       .
      619     end.
      620     assign
      621       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      622     .
      623     if p-change-value = 0
      624     then do:
      625       run diasize_position-resize-button in this-procedure .
      626       return .
      627     end.
      628     move_block:
      629     do
      630     on error undo move_block, retry move_block
      631     :
      632       if retry
      633       then do:
      634         do
      635         on error undo move_block, leave move_block
      636         :
      637           if p-change-value > 0
      638           then do:
      639             for each buf_temp-diasize-handle
      640             on error undo, next
      641             :
      642               assign
      643                 v-object-handle = buf_temp-diasize-handle.handle-value
      644               .
      645               if v-object-handle <> v-diasize-resize-button
      646               then do:
      647                 assign
      648                   v-object-handle :row = buf_temp-diasize-handle.save-position
      649                 .
      650               end.
      651             end.
      652             assign
      653               v-diasize-browse-handle :height = v-browse-height
      654             .
      655             for each buf_temp-browse-handle
      656               where buf_temp-browse-handle.browse-type = 'height':u
      657             on error undo, next
      658             :
      659               assign
      660                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      661               .
      662             end.
      663             assign
      664               frame Dialog-Frame :height = v-frame-height
      665             .
      666             if frame Dialog-Frame :scrollable = true
      667             then do:
      668               assign
      669                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      670               .
      671             end.
      672             run diasize_position-resize-button in this-procedure .
      673           end.
      674           else do:
      675             if frame Dialog-Frame :scrollable = true
      676             then do:
      677               assign
      678                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      679               .
      680             end.
      681             assign
      682               frame Dialog-Frame :height = v-frame-height
      683             .
      684             assign
      685               v-diasize-browse-handle :height = v-browse-height
      686             .
      687             for each buf_temp-browse-handle
      688               where buf_temp-browse-handle.browse-type = 'height':u
      689             on error undo, next
      690             :
      691               assign
      692                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      693               .
      694             end.
      695             for each buf_temp-diasize-handle
      696             on error undo, next
      697             :
      698               assign
      699                 v-object-handle = buf_temp-diasize-handle.handle-value
      700               .
      701               if v-object-handle <> v-diasize-resize-button
      702               then do:
      703                 assign
      704                   v-object-handle :row = buf_temp-diasize-handle.save-position
      705                 .
      706               end.
      707             end.
      708             run diasize_position-resize-button in this-procedure .
      709           end.
      710           assign
      711             v-diasize-change-size = false
      712           .
      713           leave move_block .
      714         end.
      715       end.
      716       assign
      717         v-diasize-need-full-display = true
      718       .
      719       if v-diasize-change-size = false
      720       then do:
      721         assign
      722           v-diasize-change-size = true
      723         .
      724       end.
      725       else do:
      726         return .
      727       end.
      728       assign
      729         v-frame-height = frame Dialog-Frame :height
      730         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      731         v-browse-height = v-diasize-browse-handle :height
      732       .
      733       for each buf_temp-browse-handle
      734         where buf_temp-browse-handle.browse-type = 'height':u
      735       :
      736         assign
      737           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      738         .
      739       end.
      740       for each buf_temp-diasize-handle
      741       :
      742         delete buf_temp-diasize-handle .
      743       end.
      744       assign
      745         v-field-group-handle = frame Dialog-Frame :first-child
      746       .
      747       do while valid-handle(v-field-group-handle)
      748       :
      749         assign
      750           v-object-handle = v-field-group-handle :first-child
      751         .
      752         do while valid-handle(v-object-handle)
      753         :
      754           if  v-object-handle <> v-diasize-browse-handle :handle
      755           and can-query(v-object-handle, "row")
      756           and can-query(v-object-handle, "height")
      757           and ( v-object-handle :row > v-diasize-browse-handle :row )
      758           then do:
      759             find first buf_temp-browse-handle
      760               where buf_temp-browse-handle.browse-type   = 'height':u
      761                 and buf_temp-browse-handle.browse-handle = v-object-handle
      762               no-error .
      763             if available buf_temp-browse-handle
      764             then do:
      765             end.
      766             else do:
      767               create buf_temp-diasize-handle .
      768               assign
      769                 buf_temp-diasize-handle.handle-value  = v-object-handle
      770                 buf_temp-diasize-handle.save-position = v-object-handle :row
      771               .
      772             end.
      773           end.
      774           assign
      775             v-object-handle = v-object-handle :next-sibling
      776           .
      777         end.
      778         assign
      779           v-field-group-handle = v-field-group-handle :next-sibling
      780         .
      781       end.
      782       do with frame Dialog-Frame
      783       :
      784         hide v-diasize-resize-button .
      785         assign
      786           v-diasize-resize-button :row    = 1
      787           v-diasize-resize-button :column = 1
      788         .
      789       end.
      790       if p-change-value > 0
      791       then do:
      792         if frame Dialog-Frame :scrollable = true
      793         then do:
      794           assign
      795             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      796             no-error .
      797           if error-status :error
      798           or error-status :get-message(1) <> ""
      799           then do:
      800             undo move_block, retry move_block .
      801           end.
      802         end.
      803         assign
      804           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      805           no-error .
      806         if error-status :error
      807         or error-status :get-message(1) <> ""
      808         then do:
      809           undo move_block, retry move_block .
      810         end.
      811         assign
      812           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      813           no-error .
      814         if error-status :error
      815         or error-status :get-message(1) <> ""
      816         then do:
      817           undo move_block, retry move_block .
      818         end.
      819         for each buf_temp-browse-handle
      820           where buf_temp-browse-handle.browse-type = 'height':u
      821         on error undo move_block, retry move_block
      822         :
      823           assign
      824             buf_temp-browse-handle.browse-handle :height
      825               = buf_temp-browse-handle.browse-handle :height + p-change-value
      826             no-error .
      827           if error-status :error
      828           or error-status :get-message(1) <> ""
      829           then do:
      830             undo move_block, retry move_block .
      831           end.
      832         end.
      833         for each buf_temp-diasize-handle
      834         on error undo move_block, retry move_block
      835         :
      836           assign
      837             v-object-handle = buf_temp-diasize-handle.handle-value
      838           .
      839           if v-object-handle <> v-diasize-resize-button
      840           then do:
      841             assign
      842               v-object-handle :row = v-object-handle :row + p-change-value
      843               no-error .
      844             if error-status :error
      845             or error-status :get-message(1) <> ""
      846             then do:
      847               undo move_block, retry move_block .
      848             end.
      849           end.
      850         end.
      851       end.
      852       else do:
      853         for each buf_temp-diasize-handle
      854         on error undo move_block, retry move_block
      855         :
      856           assign
      857             v-object-handle = buf_temp-diasize-handle.handle-value
      858           .
      859           if v-object-handle <> v-diasize-resize-button
      860           then do:
      861             assign
      862               v-object-handle :row = v-object-handle :row + p-change-value
      863               no-error .
      864             if error-status :error
      865             or error-status :get-message(1) <> ""
      866             then do:
      867               undo move_block, retry move_block .
      868             end.
      869           end.
      870         end.
      871         assign
      872           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      873           no-error .
      874         if error-status :error
      875         or error-status :get-message(1) <> ""
      876         then do:
      877           undo move_block, retry move_block .
      878         end.
      879         for each buf_temp-browse-handle
      880           where buf_temp-browse-handle.browse-type = 'height':u
      881         on error undo move_block, retry move_block
      882         :
      883           assign
      884             buf_temp-browse-handle.browse-handle :height
      885               = buf_temp-browse-handle.browse-handle :height + p-change-value
      886             no-error .
      887           if error-status :error
      888           or error-status :get-message(1) <> ""
      889           then do:
      890             undo move_block, retry move_block .
      891           end.
      892         end.
      893         assign
      894           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      895           no-error .
      896         if error-status :error
      897         or error-status :get-message(1) <> ""
      898         then do:
      899           undo move_block, retry move_block .
      900         end.
      901         if frame Dialog-Frame :scrollable = true
      902         then do:
      903           assign
      904             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      905             no-error .
      906           if error-status :error
      907           or error-status :get-message(1) <> ""
      908           then do:
      909             undo move_block, retry move_block .
      910           end.
      911         end.
      912       end.
      913       if p-move-resize = true
      914       then do:
      915         run diasize_position-resize-button in this-procedure .
      916       end.
      917       if v-diasize-wndstore = true
      918       then do:
      919         if connected("ub") = true
      920         then do:
      921           define variable v-cntxt-db-num        as integer   no-undo .
      922           define variable v-cntxt-userid        as character no-undo .
      923           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      924                                             , OUTPUT v-cntxt-userid
      925                                             ) .
      926           run gbl/wndsizew.p
      927             (input  v-cntxt-db-num
      928             ,input  v-cntxt-userid
      929             ,input  v-diasize-proc-name
      930             ,input  'height':u
      931             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      932             ) .
      933         end.
      934       end.
      935     end.
      936     assign
      937       v-diasize-change-size = false
      938     .
      939   end procedure.
      940   procedure diasize_set-height :
      941     define input  parameter p-new-height  as decimal   no-undo .
      942     define input  parameter p-move-resize as logical   no-undo .
      943     do
      944     on error undo, return error return-value
      945     :
      946       run diasize_change-height in this-procedure
      947         (input  (p-new-height - frame Dialog-Frame :height)
      948         ,input  p-move-resize
      949         ) .
      950     end.
      951   end procedure.
      952   procedure diasize_change-width :
      953     define input  parameter p-change-value as decimal   no-undo .
      954     define input  parameter p-move-resize  as logical   no-undo .
      955     define variable v-field-group-handle   as handle    no-undo .
      956     define variable v-object-handle        as handle    no-undo .
      957     define variable v-frame-width          as decimal   no-undo .
      958     define variable v-frame-virtual-width  as decimal   no-undo .
      959     define variable v-browse-width         as decimal   no-undo .
      960     define variable v-window-width         as decimal   no-undo .
      961     define variable v-window-virtual-width as decimal   no-undo .
      962     define variable v-change-sign          as integer   no-undo .
      963     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      964     define buffer buf_temp-browse-handle  for temp-browse-handle .
      965     if p-change-value > 0
      966     then do:
      967       if frame Dialog-Frame :width + p-change-value >
      968           session :width-chars
      969       then do:
      970         assign
      971           p-change-value = session :width-chars - frame Dialog-Frame :width
      972         .
      973         if p-change-value <= 0
      974         then do:
      975           run diasize_position-resize-button in this-procedure .
      976           return .
      977         end.
      978       end.
      979     end.
      980     if p-change-value < 0
      981     then do:
      982       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      983       then do:
      984         assign
      985           p-change-value = v-diasize-orig-frame-width
      986                          - frame Dialog-Frame :width
      987         .
      988         if p-change-value >= 0
      989         then do:
      990           run diasize_position-resize-button in this-procedure .
      991           return .
      992         end.
      993       end.
      994     end.
      995     if p-change-value >= 0
      996     then do:
      997       assign
      998         v-change-sign = 1
      999       .
     1000     end.
     1001     else do:
     1002       assign
     1003         v-change-sign = -1
     1004       .
     1005     end.
     1006     assign
     1007       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1008     .
     1009     if p-change-value = 0
     1010     then do:
     1011       run diasize_position-resize-button in this-procedure .
     1012       return .
     1013     end.
     1014     move_block:
     1015     do
     1016     on error undo move_block, leave move_block
     1017     :
     1018       if retry
     1019       then do:
     1020         do
     1021         on error undo move_block, leave move_block
     1022         :
     1023           if p-change-value > 0
     1024           then do:
     1025             for each buf_temp-diasize-handle
     1026             on error undo, next
     1027             :
     1028               assign
     1029                 v-object-handle = buf_temp-diasize-handle.handle-value
     1030               .
     1031               if v-object-handle <> v-diasize-resize-button
     1032               then do:
     1033                 assign
     1034                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1035                 .
     1036               end.
     1037             end.
     1038             assign
     1039               v-diasize-browse-handle :width = v-browse-width
     1040             .
     1041             for each buf_temp-browse-handle
     1042               where buf_temp-browse-handle.browse-type = 'width':u
     1043             on error undo, next
     1044             :
     1045               assign
     1046                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1047               .
     1048             end.
     1049             assign
     1050               frame Dialog-Frame :width = v-frame-width
     1051             .
     1052             if frame Dialog-Frame :scrollable = true
     1053             then do:
     1054               assign
     1055                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1056               .
     1057             end.
     1058             run diasize_position-resize-button in this-procedure .
     1059           end.
     1060           else do:
     1061             if frame Dialog-Frame :scrollable = true
     1062             then do:
     1063               assign
     1064                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1065               .
     1066             end.
     1067             assign
     1068               frame Dialog-Frame :width = v-frame-width
     1069             .
     1070             for each buf_temp-browse-handle
     1071               where buf_temp-browse-handle.browse-type = 'width':u
     1072             on error undo, next
     1073             :
     1074               assign
     1075                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1076               .
     1077             end.
     1078             assign
     1079               v-diasize-browse-handle :width = v-browse-width
     1080             .
     1081             for each buf_temp-diasize-handle
     1082             on error undo, next
     1083             :
     1084               assign
     1085                 v-object-handle = buf_temp-diasize-handle.handle-value
     1086               .
     1087               if v-object-handle <> v-diasize-resize-button
     1088               then do:
     1089                 assign
     1090                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1091                 .
     1092               end.
     1093             end.
     1094             run diasize_position-resize-button in this-procedure .
     1095           end.
     1096           assign
     1097             v-diasize-change-size = false
     1098           .
     1099           leave move_block .
     1100         end.
     1101       end.
     1102       assign
     1103         v-diasize-need-full-display = true
     1104       .
     1105       if v-diasize-change-size = false
     1106       then do:
     1107         assign
     1108           v-diasize-change-size = true
     1109         .
     1110       end.
     1111       else do:
     1112         return .
     1113       end.
     1114       assign
     1115         v-frame-width = frame Dialog-Frame :width
     1116         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1117         v-browse-width = v-diasize-browse-handle :width
     1118       .
     1119       for each buf_temp-browse-handle
     1120         where buf_temp-browse-handle.browse-type = 'width':u
     1121       :
     1122         assign
     1123           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1124         .
     1125       end.
     1126       for each buf_temp-diasize-handle
     1127       :
     1128         delete buf_temp-diasize-handle .
     1129       end.
     1130       assign
     1131         v-field-group-handle = frame Dialog-Frame :first-child
     1132       .
     1133       do while valid-handle(v-field-group-handle)
     1134       :
     1135         assign
     1136           v-object-handle = v-field-group-handle :first-child
     1137         .
     1138         do while valid-handle(v-object-handle)
     1139         :
     1140           if  v-object-handle <> v-diasize-browse-handle :handle
     1141           and v-object-handle <> v-diasize-resize-button
     1142           and can-query(v-object-handle, "row")
     1143           and can-query(v-object-handle, "height")
     1144           and ( v-object-handle :col + v-object-handle :width
     1145                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1146               )
     1147           then do:
     1148             find first buf_temp-browse-handle
     1149               where buf_temp-browse-handle.browse-type   = 'width':u
     1150                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1151               no-error .
     1152             if available buf_temp-browse-handle
     1153             then do:
     1154             end.
     1155             else do:
     1156               create buf_temp-diasize-handle .
     1157               assign
     1158                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1159                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1160               .
     1161             end.
     1162           end.
     1163           assign
     1164             v-object-handle = v-object-handle :next-sibling
     1165           .
     1166         end.
     1167         assign
     1168           v-field-group-handle = v-field-group-handle :next-sibling
     1169         .
     1170       end.
     1171       do with frame Dialog-Frame
     1172       :
     1173         hide v-diasize-resize-button .
     1174         v-diasize-resize-button :row = 1.
     1175         v-diasize-resize-button :column = 1.
     1176       end.
     1177       if p-change-value > 0
     1178       then do:
     1179         if frame Dialog-Frame :scrollable = true
     1180         then do:
     1181           assign
     1182             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1183             no-error .
     1184           if error-status :error
     1185           or error-status :get-message(1) <> ""
     1186           then do:
     1187             undo move_block, retry move_block.
     1188           end.
     1189         end.
     1190         assign
     1191           frame Dialog-Frame :width = v-frame-width + p-change-value
     1192           no-error .
     1193         if error-status :error
     1194         or error-status :get-message(1) <> ""
     1195         then do:
     1196           undo move_block, retry move_block.
     1197         end.
     1198         assign
     1199           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1200         no-error .
     1201         if error-status :error
     1202         or error-status :get-message(1) <> ""
     1203         then do:
     1204           undo move_block, retry move_block.
     1205         end.
     1206         for each buf_temp-browse-handle
     1207           where buf_temp-browse-handle.browse-type = 'width':u
     1208         on error undo move_block, retry move_block
     1209         :
     1210           assign
     1211             buf_temp-browse-handle.browse-handle :width
     1212               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1213             no-error .
     1214           if error-status :error
     1215           or error-status :get-message(1) <> ""
     1216           then do:
     1217             undo move_block, retry move_block .
     1218           end.
     1219         end.
     1220         for each buf_temp-diasize-handle
     1221         on error undo move_block, retry move_block
     1222         :
     1223           assign
     1224             v-object-handle = buf_temp-diasize-handle.handle-value
     1225           .
     1226           if v-object-handle <> v-diasize-resize-button
     1227           then do:
     1228             assign
     1229               v-object-handle :col = v-object-handle :col + p-change-value
     1230               no-error .
     1231             if error-status :error
     1232             or error-status :get-message(1) <> ""
     1233             then do:
     1234               undo move_block, retry move_block .
     1235             end.
     1236           end.
     1237         end.
     1238       end.
     1239       else do:
     1240         for each buf_temp-diasize-handle
     1241         on error undo move_block, retry move_block
     1242         :
     1243           assign
     1244             v-object-handle = buf_temp-diasize-handle.handle-value
     1245           .
     1246           if v-object-handle <> v-diasize-resize-button
     1247           then do:
     1248             assign
     1249               v-object-handle :col = v-object-handle :col + p-change-value
     1250               no-error .
     1251             if error-status :error
     1252             or error-status :get-message(1) <> ""
     1253             then do:
     1254               undo move_block, retry move_block .
     1255             end.
     1256           end.
     1257         end.
     1258         for each buf_temp-browse-handle
     1259           where buf_temp-browse-handle.browse-type = 'width':u
     1260         on error undo move_block, retry move_block
     1261         :
     1262           assign
     1263             buf_temp-browse-handle.browse-handle :width
     1264               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1265             no-error .
     1266           if error-status :error
     1267           or error-status :get-message(1) <> ""
     1268           then do:
     1269             undo move_block, retry move_block .
     1270           end.
     1271         end.
     1272         assign
     1273           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1274           no-error .
     1275         if error-status :error
     1276         or error-status :get-message(1) <> ""
     1277         then do:
     1278           undo move_block, retry move_block.
     1279         end.
     1280         assign
     1281           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1282         no-error .
     1283         if error-status :error
     1284         or error-status :get-message(1) <> ""
     1285         then do:
     1286           undo move_block, retry move_block.
     1287         end.
     1288         if frame Dialog-Frame :scrollable = true
     1289         then do:
     1290           assign
     1291             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1292           no-error .
     1293           if error-status :error
     1294           or error-status :get-message(1) <> ""
     1295           then do:
     1296             undo move_block, retry move_block.
     1297           end.
     1298         end.
     1299       end.
     1300       if p-move-resize
     1301       then do:
     1302         run diasize_position-resize-button in this-procedure .
     1303       end.
     1304       if v-diasize-wndstore = true
     1305       then do:
     1306         if connected("ub") = true
     1307         then do:
     1308           define variable v-cntxt-db-num        as integer   no-undo .
     1309           define variable v-cntxt-userid        as character no-undo .
     1310           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1311                                             , OUTPUT v-cntxt-userid
     1312                                             ) .
     1313           run gbl/wndsizew.p
     1314             (input  v-cntxt-db-num
     1315             ,input  v-cntxt-userid
     1316             ,input  v-diasize-proc-name
     1317             ,input  'width':u
     1318             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1319             ) .
     1320         end.
     1321       end.
     1322     end.
     1323     assign
     1324       v-diasize-change-size = false
     1325     .
     1326   end procedure.
     1327   procedure diasize_set-width :
     1328     define input  parameter p-new-width  as decimal   no-undo .
     1329     define input  parameter p-move-resize as logical   no-undo .
     1330     do
     1331     on error undo, return error return-value
     1332     :
     1333       run diasize_change-width in this-procedure
     1334         (input  (p-new-width - frame Dialog-Frame :width)
     1335         ,input  p-move-resize
     1336         ) .
     1337     end.
     1338   end procedure.
     1339   procedure diasize_position-resize-button :
     1340     do with frame Dialog-Frame
     1341     :
     1342       hide v-diasize-resize-button .
     1343       assign
     1344         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1345                     - 1
     1346                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1347         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1348                     - 1
     1349                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1350       .
     1351       view v-diasize-resize-button .
     1352     end.
     1353   end procedure.
     1354   on alt-right anywhere
     1355   do:
     1356     run diasize_change-width in this-procedure
     1357       (input 1
     1358       ,input true
     1359       ) .
     1360     return no-apply .
     1361   end.
     1362   on alt-left anywhere
     1363   do:
     1364     run diasize_change-width in this-procedure
     1365       (input -1
     1366       ,input true
     1367       ) .
     1368     return no-apply .
     1369   end.
     1370   on alt-down anywhere
     1371   do:
     1372     run diasize_change-height in this-procedure
     1373       (input 1
     1374       ,input true
     1375       ) .
     1376     return no-apply .
     1377   end.
     1378   on alt-up anywhere
     1379   do:
     1380     run diasize_change-height in this-procedure
     1381       (input -1
     1382       ,input true
     1383       ) .
     1384     return no-apply .
     1385   end.
     1386   on alt-enter of frame Dialog-Frame
     1387   do:
     1388     run diasize_maximize in this-procedure
     1389       (input  ?
     1390       ).
     1391     return no-apply .
     1392   end.
     1393   procedure diasize_end-move :
     1394     do
     1395     on error undo, return error return-value
     1396     :
     1397       define variable v-row-delta as decimal   no-undo .
     1398       define variable v-col-delta as decimal   no-undo .
     1399       define variable v-new-row as decimal   no-undo .
     1400       define variable v-new-col as decimal   no-undo .
     1401       assign
     1402         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1403         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1404       .
     1405       assign
     1406         v-row-delta = v-new-row - frame Dialog-Frame :height
     1407         v-col-delta = v-new-col - frame Dialog-Frame :width
     1408       .
     1409       run diasize_change-height in this-procedure
     1410         (input v-row-delta
     1411         ,input true
     1412         ) .
     1413       run diasize_change-width in this-procedure
     1414         (input v-col-delta
     1415         ,input true
     1416         ) .
     1417     end.
     1418   end procedure.
     1419   procedure diasize_maximize :
     1420     define input  parameter p-action as logical   no-undo .
     1421     do
     1422     on error undo, return error return-value
     1423     :
     1424       if p-action = ?
     1425       then do:
     1426         if v-diasize-need-maximize = true
     1427         then do:
     1428           assign
     1429             p-action = true
     1430           .
     1431         end.
     1432         else do:
     1433           assign
     1434             p-action = false
     1435           .
     1436         end.
     1437       end.
     1438       if p-action = true
     1439       then do:
     1440         run diasize_change-height in this-procedure
     1441           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1442               - frame Dialog-Frame :height-chars
     1443           ,input true
     1444           ) .
     1445         run diasize_change-width in this-procedure
     1446           (input session :width-chars
     1447               - frame Dialog-Frame :width-chars
     1448           ,input true
     1449           ) .
     1450         assign
     1451           v-diasize-need-maximize = false
     1452         .
     1453       end.
     1454       else do:
     1455         run diasize_change-width in this-procedure
     1456           (input v-diasize-orig-frame-width
     1457               - frame Dialog-Frame :width-chars
     1458           ,input true
     1459           ) .
     1460         run diasize_change-height in this-procedure
     1461           (input v-diasize-orig-frame-height
     1462               - frame Dialog-Frame :height-chars
     1463           ,input true
     1464           ) .
     1465         assign
     1466           v-diasize-need-maximize = true
     1467         .
     1468       end.
     1469     end.
     1470   end procedure.
     1471   procedure diasize_restore-orig-size :
     1472     do
     1473     on error undo, return error return-value
     1474     :
     1475       assign
     1476         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1477         v-diasize-current-frame-height = frame Dialog-Frame :height
     1478       .
     1479       run diasize_set-height in this-procedure
     1480         (input  v-diasize-orig-frame-height
     1481         ,input  true
     1482         ) .
     1483       run diasize_set-width in this-procedure
     1484         (input  v-diasize-orig-frame-width
     1485         ,input  true
     1486         ) .
     1487     end.
     1488   end procedure.
     1489   procedure diasize_restore-current-size :
     1490     do
     1491     on error undo, return error return-value
     1492     :
     1493       run diasize_set-height in this-procedure
     1494         (input  v-diasize-current-frame-height
     1495         ,input  true
     1496         ) .
     1497       run diasize_set-width in this-procedure
     1498         (input  v-diasize-current-frame-width
     1499         ,input  true
     1500         ) .
     1501     end.
     1502   end procedure.
     1503   procedure diasize_set-browse-handle :
     1504     define input  parameter p-browse-handle as handle   no-undo .
     1505     define buffer buf_temp-browse-handle for temp-browse-handle .
     1506     do
     1507     on error undo, return error return-value
     1508     :
     1509       assign
     1510         v-diasize-browse-handle = p-browse-handle
     1511       .
     1512       for each buf_temp-browse-handle
     1513       on error undo, return error return-value
     1514       :
     1515         delete buf_temp-browse-handle .
     1516       end.
     1517     end.
     1518   end procedure.
     1519   procedure diasize_add_browse :
     1520     define input  parameter p-browse-type   as character no-undo .
     1521     define input  parameter p-browse-handle as handle    no-undo .
     1522     define buffer buf_temp-browse-handle for temp-browse-handle .
     1523     do
     1524     on error undo, return error return-value
     1525     :
     1526       assign
     1527         v-diasize-browse-number = v-diasize-browse-number + 1
     1528       .
     1529       create buf_temp-browse-handle .
     1530       assign
     1531         buf_temp-browse-handle.browse-type   = p-browse-type
     1532         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1533         buf_temp-browse-handle.browse-handle = p-browse-handle
     1534       .
     1535     end.
     1536   end procedure.
     1537   procedure diasize_init :
     1538     define variable v-default-value    as logical   no-undo .
     1539     define variable v-restore-saved    as logical   no-undo .
     1540     define variable v-resize-value-str as character no-undo .
     1541     do
     1542     on error undo, return error return-value
     1543     :
     1544       do with frame Dialog-Frame
     1545       :
     1546         assign
     1547           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1548           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1549           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1550         .
     1551         create button v-diasize-resize-button
     1552         assign
     1553           parent        = frame Dialog-Frame :first-child
     1554           label         = "s"
     1555           height-pixels = 16
     1556           width-pixels  = 16
     1557           visible       = true
     1558           sensitive     = true
     1559           movable       = true
     1560           triggers:
     1561             on end-move persistent run diasize_end-move in this-procedure .
     1562           end triggers.
     1563         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1564         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1565         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1566         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1567         assign
     1568           v-diasize-wndmax = false
     1569         .
     1570         if connected("ub") = true
     1571         then do:
     1572           define variable v-cntxt-db-num        as integer   no-undo .
     1573           define variable v-cntxt-userid        as character no-undo .
     1574           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1575                                             , OUTPUT v-cntxt-userid
     1576                                             ) .
     1577           run gbl/wndpar_r.p
     1578             (input  v-cntxt-db-num
     1579             ,input  v-cntxt-userid
     1580             ,input  'wndmax':U
     1581             ,output v-diasize-wndmax
     1582             ,output v-default-value
     1583             ) .
     1584         end.
     1585         assign
     1586           v-diasize-wndstore = false
     1587         .
     1588         if connected("ub") = true
     1589         then do:
     1590           run gbl/wndpar_r.p
     1591             (input  v-cntxt-db-num
     1592             ,input  v-cntxt-userid
     1593             ,input  'wndstore':U
     1594             ,output v-diasize-wndstore
     1595             ,output v-default-value
     1596             ) .
     1597         end.
     1598         assign
     1599           v-diasize-proc-name = entry(1, program-name(2), '.')
     1600         .
     1601         if v-diasize-wndstore = true
     1602         then do:
     1603           assign
     1604             v-restore-saved = false
     1605           .
     1606           if connected("ub") = true
     1607           then do:
     1608             run gbl/wndsizer.p
     1609               (input  v-cntxt-db-num
     1610               ,input  v-cntxt-userid
     1611               ,input  v-diasize-proc-name
     1612               ,input  'height':u
     1613               ,output v-resize-value-str
     1614               ) .
     1615             if v-resize-value-str <> '':U
     1616             then do:
     1617               run diasize_change-height in this-procedure
     1618                 (input  integer(v-resize-value-str)
     1619                 ,input  true
     1620                 ) .
     1621               assign
     1622                 v-restore-saved = true
     1623               .
     1624             end.
     1625           end.
     1626           if connected("ub") = true
     1627           then do:
     1628             run gbl/wndsizer.p
     1629               (input  v-cntxt-db-num
     1630               ,input  v-cntxt-userid
     1631               ,input  v-diasize-proc-name
     1632               ,input  'width':u
     1633               ,output v-resize-value-str
     1634               ) .
     1635             if v-resize-value-str <> '':U
     1636             then do:
     1637               run diasize_change-width in this-procedure
     1638                 (input  integer(v-resize-value-str)
     1639                 ,input  true
     1640                 ) .
     1641               assign
     1642                 v-restore-saved = true
     1643               .
     1644             end.
     1645           end.
     1646           if v-restore-saved <> true
     1647           then do:
     1648             if v-diasize-wndmax = true
     1649             then do:
     1650               run diasize_maximize in this-procedure
     1651                 (input  true
     1652                 ) .
     1653             end.
     1654           end.
     1655         end.
     1656         else do:
     1657           if v-diasize-wndmax = true
     1658           then do:
     1659             run diasize_maximize in this-procedure
     1660               (input  true
     1661               ) .
     1662           end.
     1663         end.
     1664       end.
     1665     end.
     1666   end procedure.
     1667   procedure diasize_need-full-display :
     1668     define output parameter p-need-full-display as logical   no-undo .
     1669     do
     1670     on error undo, return error return-value
     1671     :
     1672       assign
     1673         p-need-full-display = v-diasize-need-full-display
     1674       .
     1675       assign
     1676         v-diasize-need-full-display = false
     1677       .
     1678     end.
     1679   end procedure.
     1680   procedure get-context :
     1681      define output parameter p-db-num as integer          no-undo.
     1682      define output parameter p-user-id as character        no-undo.
     1683      define variable v-login               as character    no-undo.
     1684      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1685      define buffer buf_user-login  for ub.user-login .
     1686      do
     1687      on error undo, return error
     1688      :
     1689            FIND FIRST buf_sys-ctrl no-lock.
     1690            ASSIGN
     1691               v-login = USERID("ub")
     1692               p-db-num = buf_sys-ctrl.db-num
     1693            .
     1694            FIND FIRST buf_user-login
     1695                 WHERE buf_user-login.db-num = p-db-num
     1696                   AND buf_user-login.user-login = v-login
     1697                 no-lock
     1698                 no-error
     1699                 .
     1700            IF AVAILABLE buf_user-login
     1701            THEN DO:
     1702               assign
     1703                  p-user-id = buf_user-login.user-id
     1704               .
     1705            END.
     1706      end.
     1707   end procedure.
     1708       run diasize_init in this-procedure .
     1709   assign frame Dialog-Frame:title = "Дополнительные расходы".
     1710   def var sort-labelBROWSE-2   as character no-undo .
     1711   def var sort-clmnBROWSE-2    as handle    no-undo .
     1712   def var cur-clmnBROWSE-2     as handle    no-undo .
     1713   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     1714   def var re-queryBROWSE-2     as logical   initial no no-undo .
     1715   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     1716      run sort-brBROWSE-2
     1717        (input (if available ub.gds-add-charges
     1718                then recid(ub.gds-add-charges)
     1719                else ?
     1720               )
     1721        ).
     1722   end.
     1723   PROCEDURE sort-brBROWSE-2 :
     1724     define input parameter p-recid as recid no-undo .
     1725     if re-queryBROWSE-2 = no then do:
     1726       assign
     1727          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     1728       .
     1729       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     1730       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     1731         assign
     1732            sort-labelBROWSE-2 = ""
     1733            sort-clmnBROWSE-2 = ?
     1734         .
     1735        end.
     1736        else do:
     1737          assign
     1738            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     1739            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     1740            sort-clmnBROWSE-2:column-fgcolor = 4
     1741          .
     1742        end.
     1743      end.
     1744     assign
     1745       cur-clmn-locBROWSE-2 = 1
     1746     .
     1747     def var column-handle as handle no-undo .
     1748     column-handle = BROWSE-2:first-column.
     1749     do while valid-handle(column-handle) :
     1750       if column-handle = cur-clmnBROWSE-2 then do:
     1751         leave .
     1752       end.
     1753       column-handle = column-handle:NEXT-COLUMN.
     1754       assign
     1755         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     1756       .
     1757     end.
     1758     case sort-labelBROWSE-2:
     1759           when ub.goods.artic:label in browse BROWSE-2 then DO:   assign     sort-column-name = "ub.goods.artic"   .   run OpenBr.   . END.
     1760           when ub.goods.gds-name:label in browse BROWSE-2 then DO:   assign     sort-column-name = "ub.goods.gds-name"   .   run OpenBr.   . END.
     1761           when ub.goods.unit-base:label in browse BROWSE-2 then DO:   assign     sort-column-name = "ub.goods.unit-base"   .   run OpenBr.   . END.
     1762           when alg:label in browse BROWSE-2 then DO:   assign     sort-column-name = "alg"   .   run OpenBr.   . END.
     1763       otherwise do:
     1764         assign
     1765           sort-column-name = ""
     1766         .
     1767         run OpenBr.
     1768         if sort-labelBROWSE-2 <> "" then do:
     1769           assign
     1770             cur-clmnBROWSE-2:column-fgcolor = 0
     1771           .
     1772         end.
     1773         assign
     1774           cur-clmn-locBROWSE-2 = ?
     1775         .
     1776       end.
     1777     end case.
     1778     if p-recid <> ? then do:
     1779       reposition BROWSE-2 to recid p-recid no-error.
     1780       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     1781     end.
     1782     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     1783   END PROCEDURE.
     1784   procedure re-open-query-srt-clmnBROWSE-2:
     1785   if cur-clmnBROWSE-2 = ? then do:
     1786      run OpenBr.
     1787   end.
     1788   else do:
     1789      assign re-queryBROWSE-2 = yes.
     1790      run sort-brBROWSE-2
     1791        (input (if available ub.gds-add-charges
     1792                then recid(ub.gds-add-charges)
     1793                else ?
     1794               )
     1795        ).
     1796      assign re-queryBROWSE-2 = no.
     1797   end.
     1798   end.
     1799   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1800   on F9 of frame Dialog-Frame anywhere do:
     1801     if not available ub.goods then
     1802       return no-apply.
     1803     gds-rec = recid (ub.goods).
     1804     run ref/gds-form.w ( input parParentProc
     1805                         ,input 'ПРОСМОТР':U
     1806                         ,input ?
     1807                         ,input ?
     1808                         ,input ?
     1809                         ,input-output gds-rec).
     1810     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     1811     return no-apply.
     1812   end.
     1813   MAIN-BLOCK:
     1814   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1815      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1816   ub.goods.artic:READ-ONLY = TRUE.
     1817   ub.goods.artic:resizable = true .
     1818   ub.goods.gds-name:resizable = true .
     1819     run     enable_ui in this-procedure .
     1820     enable  s-artic
     1821             B-mark when LOOKUP("b-mark":U, bttns) > 0
     1822             B-sel when LOOKUP("b-sel":U, bttns) > 0
     1823         with frame Dialog-Frame.
     1824     hide    s-name  s-name-cnt in frame Dialog-Frame.
     1825     display s-artic with frame Dialog-Frame.
     1826     WAIT-FOR GO OF FRAME Dialog-Frame.
     1827   END.
     1828   run disable_UI in this-procedure .
     1829   PROCEDURE cycle-add :
     1830   end procedure.
     1831   PROCEDURE disable_UI :
     1832     HIDE FRAME Dialog-Frame.
     1833   END PROCEDURE.
     1834   PROCEDURE enable_UI :
     1835     DISPLAY R-sort s-name s-name-cnt s-artic FILL-IN-2 mark-num
     1836         WITH FRAME Dialog-Frame.
     1837     ENABLE b-exit b-help R-sort s-artic BROWSE-2 FILL-IN-2 mark-num
     1838         WITH FRAME Dialog-Frame.
     1839     VIEW FRAME Dialog-Frame.
     1840     OPEN QUERY BROWSE-2 FOR EACH                           ub.gds-add-charges NO-LOCK,                                  EACH ub.goods WHERE                           ub.goods.gds-code = ub.gds-add-charges.gds-code and                           ub.goods.stts = 0                           NO-LOCK     .
     1841   END PROCEDURE.
     1842   PROCEDURE OpenBr :
     1843   define variable t-ret as logical no-undo .
     1844   t-ret =  session:SET-WAIT-STATE("GENERAL") .
     1845   case sort-column-name :
     1846     when "" then do:
     1847           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Дополнительные расходы , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.gds-add-charges             NO-LOCK,       EACH ub.goods where       ub.goods.gds-code = ub.gds-add-charges.gds-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK .     end.    else DO:     assign frame Dialog-Frame:title = "Дополнительные расходы " .    OPEN QUERY BROWSE-2 FOR EACH                           ub.gds-add-charges NO-LOCK,                                  EACH ub.goods WHERE                           ub.goods.gds-code = ub.gds-add-charges.gds-code and                           ub.goods.stts = 0                           NO-LOCK     .    end.
     1848     end.
     1849     when "goods.artic" then do:
     1850           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Дополнительные расходы , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.gds-add-charges             NO-LOCK,       EACH ub.goods where       ub.goods.gds-code = ub.gds-add-charges.gds-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK by ub.goods.artic.     end.    else DO:     assign frame Dialog-Frame:title = "Дополнительные расходы " .    OPEN QUERY BROWSE-2 FOR EACH                           ub.gds-add-charges NO-LOCK,                                  EACH ub.goods WHERE                           ub.goods.gds-code = ub.gds-add-charges.gds-code and                           ub.goods.stts = 0                           NO-LOCK     by ub.goods.artic.    end.
     1851     end.
     1852     when "goods.gds-name" then do:
     1853           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Дополнительные расходы , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.gds-add-charges             NO-LOCK,       EACH ub.goods where       ub.goods.gds-code = ub.gds-add-charges.gds-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK by ub.goods.gds-name.     end.    else DO:     assign frame Dialog-Frame:title = "Дополнительные расходы " .    OPEN QUERY BROWSE-2 FOR EACH                           ub.gds-add-charges NO-LOCK,                                  EACH ub.goods WHERE                           ub.goods.gds-code = ub.gds-add-charges.gds-code and                           ub.goods.stts = 0                           NO-LOCK     by ub.goods.gds-name.    end.
     1854     end.
     1855     when "goods.unit-base" then do:
     1856           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Дополнительные расходы , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.gds-add-charges             NO-LOCK,       EACH ub.goods where       ub.goods.gds-code = ub.gds-add-charges.gds-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK by ub.goods.unit-base.     end.    else DO:     assign frame Dialog-Frame:title = "Дополнительные расходы " .    OPEN QUERY BROWSE-2 FOR EACH                           ub.gds-add-charges NO-LOCK,                                  EACH ub.goods WHERE                           ub.goods.gds-code = ub.gds-add-charges.gds-code and                           ub.goods.stts = 0                           NO-LOCK     by ub.goods.unit-base.    end.
     1857     end.
     1858     when "alg" then do:
     1859           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Дополнительные расходы , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.gds-add-charges             NO-LOCK,       EACH ub.goods where       ub.goods.gds-code = ub.gds-add-charges.gds-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK by ub.gds-add-charges.algoritm.     end.    else DO:     assign frame Dialog-Frame:title = "Дополнительные расходы " .    OPEN QUERY BROWSE-2 FOR EACH                           ub.gds-add-charges NO-LOCK,                                  EACH ub.goods WHERE                           ub.goods.gds-code = ub.gds-add-charges.gds-code and                           ub.goods.stts = 0                           NO-LOCK     by ub.gds-add-charges.algoritm.    end.
     1860     end.
     1861     otherwise do:
     1862           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Дополнительные расходы , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.gds-add-charges             NO-LOCK,       EACH ub.goods where       ub.goods.gds-code = ub.gds-add-charges.gds-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK .     end.    else DO:     assign frame Dialog-Frame:title = "Дополнительные расходы " .    OPEN QUERY BROWSE-2 FOR EACH                           ub.gds-add-charges NO-LOCK,                                  EACH ub.goods WHERE                           ub.goods.gds-code = ub.gds-add-charges.gds-code and                           ub.goods.stts = 0                           NO-LOCK     .    end.
     1863     end.
     1864   end case.
     1865   t-ret =  session:SET-WAIT-STATE("") .
     1866   apply "HOME" to BROWSE-2 in frame Dialog-Frame.
     1867   END PROCEDURE.
     1868   PROCEDURE proc-b-list :
     1869   END PROCEDURE.
     1870   FUNCTION mark-string RETURNS CHARACTER
     1871   ( buffer loc-table for ub.goods, input mark-list as character ) :
     1872   return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then CHR(42) else chr(0) ).
     1873   end function.
