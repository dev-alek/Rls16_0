      997       ,input  '':U
      998       ,input  0
      999       ,input  0
     1000       ,input  0
     1001       ,input  0
     1002       ,input  true
     1003       ,output glog
     1004       )  .
     1005   end.
     1006       if NOT glog then return no-apply .
     1007       if not avail ub.tax then return no-apply.
     1008       if ub.tax.individual = yes then do:
     1009         message "Нельзя добавить ставки к индивидуальному налогу"
     1010         view-as alert-box ERROR.
     1011         return no-apply.
     1012       end.
     1013       ri = recid(tax).
     1014       run ref/taxratei.w ( 'ДОБАВЛЕНИЕ':U, input-output ri ).
