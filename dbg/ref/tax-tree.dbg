     1437   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1438   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1439   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1440   on help of frame Dialog-Frame
     1441   do:
     1442     run gbl/app_help.p
     1443       (input this-procedure :file-name
     1444       ,input ''
     1445       ,input ?
     1446       ) no-error.
     1447     if error-status :error then do:
     1448       message
     1449         "Ошибка при вызове помощи"
     1450         error-status :get-message(1)
     1451         view-as alert-box .
     1452     end.
     1453   end.
     1454   run minbtn-set in this-procedure .
     1455   on choose of b-help in frame Dialog-Frame
     1456   do:
     1457     apply "help":u to frame Dialog-Frame .
     1458   end.
     1459   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1460   procedure minbtn-set :
     1461       do
     1462           on error undo, return error return-value
     1463           :
     1464           define variable ii              as integer       no-undo .
     1465           define variable fh              as widget-handle no-undo .
     1466           define variable hh              as widget-handle no-undo .
     1467           define variable v-h             as handle        extent 4 no-undo .
     1468           define variable v-name-button   as character     no-undo .
     1469           define variable v-help-old-x    as decimal       no-undo .
     1470           define variable v-help-old-y    as decimal       no-undo .
     1471           define variable v-help-old-size as decimal       no-undo .
     1472           define variable v-frame-width   as decimal       no-undo .
     1473           define variable jj              as integer       no-undo .
     1474           do
     1475               on error undo, return error
     1476               :
     1477               assign
     1478                   v-frame-width = frame Dialog-Frame:width - 0.3
     1479                   fh            = frame Dialog-Frame:first-child
     1480                   hh            = fh:first-child
     1481                   ii            = 1
     1482                   .
     1483               do while valid-handle(hh):
     1484                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1485                   do:
     1486                       case lc(hh:name) :
     1487                           when "b-help" then
     1488                               do:
     1489                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1490                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1491                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1492                                   hh:TOOLTIP = "Помощь" .
     1493                                   v-help-old-x = hh:column .
     1494                                   v-help-old-y = hh:row    .
     1495                                   v-help-old-size = hh:width .
     1496                                   hh:width-chars = 2.5 .
     1497                               end.
     1498                           when "b-print" then
     1499                               do:
     1500                                   hh:load-image("cmp/b-print.bmp":u) .
     1501                                   hh:TOOLTIP = "Печать" .
     1502                                   v-h[ii] = hh:handle .
     1503                                   ii = ii + 1 .
     1504                                   hh:width-chars = 3 .
     1505                               end.
     1506                           when "b-history" or
     1507                           when "b-hist" then
     1508                               do:
     1509                                   hh:load-image("cmp/b-hist.bmp":u) .
     1510                                   hh:TOOLTIP = "История" .
     1511                                   v-h[ii] = hh:handle .
     1512                                   ii = ii + 1 .
     1513                                   hh:width-chars = 3 .
     1514                               end.
     1515                           when "b-sch" then
     1516                               do:
     1517                                   hh:load-image("cmp/b-sch.bmp":u) .
     1518                                   hh:TOOLTIP = "Установка Фильтра" .
     1519                                   v-h[ii] = hh:handle .
     1520                                   ii = ii + 1 .
     1521                                   hh:width-chars = 3 .
     1522                               end.
     1523                           when "b-hist-user" then
     1524                               do:
     1525                                   hh:load-image("cmp/b-hist.bmp":u) .
     1526                                   hh:TOOLTIP = "История пользователя" .
     1527                                   ii = ii + 1 .
     1528                               end.
     1529                       end case.
     1530                   end.
     1531                   hh = hh:next-sibling.
     1532               end.
     1533               b-help:column = v-frame-width - b-help:width-chars.
     1534               jj = 0.
     1535               repeat ii = 4 to 1 by -1 :
     1536                   if valid-handle (v-h[ii] ) then
     1537                   do:
     1538                       jj  = jj + 1 .
     1539                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1540                       v-h[ii]:row    = v-help-old-y .
     1541                   end.
     1542               end.
     1543           end.
     1544       end.
     1545   end procedure.
     1546   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1547   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1548   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1549   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1550   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1551   define variable v-diasize-current-frame-height as decimal   no-undo .
     1552   define variable v-diasize-change-size          as logical   no-undo .
     1553   define variable v-diasize-resize-button        as handle    no-undo .
     1554   define variable v-diasize-wndmax               as logical   no-undo .
     1555   define variable v-diasize-wndstore             as logical   no-undo .
     1556   define variable v-diasize-proc-name            as character no-undo .
     1557   define variable v-diasize-browse-handle        as handle    no-undo .
     1558   define variable v-diasize-browse-number        as integer   no-undo .
     1559   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1560   define temp-table temp-diasize-handle no-undo
     1561     field handle-value  as handle
     1562     field save-position as decimal
     1563     index xpk is primary unique handle-value
     1564     .
     1565   define temp-table temp-browse-handle no-undo
     1566     field browse-type   as character
     1567     field browse-number as integer
     1568     field browse-handle as handle
     1569     field original-size as decimal
     1570     index xpk is primary unique browse-type browse-number
     1571     index xie browse-type browse-handle
     1572   .
     1573   procedure diasize_change-height :
     1574     define input  parameter p-change-value  as decimal   no-undo .
     1575     define input  parameter p-move-resize   as logical   no-undo .
     1576     define variable v-field-group-handle    as handle    no-undo .
     1577     define variable v-object-handle         as handle    no-undo .
     1578     define variable v-frame-height          as decimal   no-undo .
     1579     define variable v-frame-virtual-height  as decimal   no-undo .
     1580     define variable v-browse-height         as decimal   no-undo .
     1581     define variable v-window-height         as decimal   no-undo .
     1582     define variable v-window-virtual-height as decimal   no-undo .
     1583     define variable v-change-sign           as integer   no-undo .
     1584     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1585     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1586     if p-change-value > 0
     1587     then do:
     1588       if frame Dialog-Frame :height + p-change-value
     1589           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1590       then do:
     1591         assign
     1592           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1593                           - (frame Dialog-Frame :height-chars)
     1594         .
     1595         if p-change-value <= 0
     1596         then do:
     1597           run diasize_position-resize-button in this-procedure .
     1598           return .
     1599         end.
     1600       end.
     1601     end.
     1602     if p-change-value < 0
     1603     then do:
     1604       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1605       then do:
     1606         assign
     1607           p-change-value = v-diasize-orig-frame-height
     1608                          - (frame Dialog-Frame :height-chars)
     1609         .
     1610         if p-change-value >= 0
     1611         then do:
     1612           run diasize_position-resize-button in this-procedure .
     1613           return .
     1614         end.
     1615       end.
     1616     end.
     1617     if p-change-value >= 0
     1618     then do:
     1619       assign
     1620         v-change-sign = 1
     1621       .
     1622     end.
     1623     else do:
     1624       assign
     1625         v-change-sign = -1
     1626       .
     1627     end.
     1628     assign
     1629       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1630     .
     1631     if p-change-value = 0
     1632     then do:
     1633       run diasize_position-resize-button in this-procedure .
     1634       return .
     1635     end.
     1636     move_block:
     1637     do
     1638     on error undo move_block, retry move_block
     1639     :
     1640       if retry
     1641       then do:
     1642         do
     1643         on error undo move_block, leave move_block
     1644         :
     1645           if p-change-value > 0
     1646           then do:
     1647             for each buf_temp-diasize-handle
     1648             on error undo, next
     1649             :
     1650               assign
     1651                 v-object-handle = buf_temp-diasize-handle.handle-value
     1652               .
     1653               if v-object-handle <> v-diasize-resize-button
     1654               then do:
     1655                 assign
     1656                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1657                 .
     1658               end.
     1659             end.
     1660             assign
     1661               v-diasize-browse-handle :height = v-browse-height
     1662             .
     1663             for each buf_temp-browse-handle
     1664               where buf_temp-browse-handle.browse-type = 'height':u
     1665             on error undo, next
     1666             :
     1667               assign
     1668                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1669               .
     1670             end.
     1671             assign
     1672               frame Dialog-Frame :height = v-frame-height
     1673             .
     1674             if frame Dialog-Frame :scrollable = true
     1675             then do:
     1676               assign
     1677                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1678               .
     1679             end.
     1680             run diasize_position-resize-button in this-procedure .
     1681           end.
     1682           else do:
     1683             if frame Dialog-Frame :scrollable = true
     1684             then do:
     1685               assign
     1686                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1687               .
     1688             end.
     1689             assign
     1690               frame Dialog-Frame :height = v-frame-height
     1691             .
     1692             assign
     1693               v-diasize-browse-handle :height = v-browse-height
     1694             .
     1695             for each buf_temp-browse-handle
     1696               where buf_temp-browse-handle.browse-type = 'height':u
     1697             on error undo, next
     1698             :
     1699               assign
     1700                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1701               .
     1702             end.
     1703             for each buf_temp-diasize-handle
     1704             on error undo, next
     1705             :
     1706               assign
     1707                 v-object-handle = buf_temp-diasize-handle.handle-value
     1708               .
     1709               if v-object-handle <> v-diasize-resize-button
     1710               then do:
     1711                 assign
     1712                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1713                 .
     1714               end.
     1715             end.
     1716             run diasize_position-resize-button in this-procedure .
     1717           end.
     1718           assign
     1719             v-diasize-change-size = false
     1720           .
     1721           leave move_block .
     1722         end.
     1723       end.
     1724       assign
     1725         v-diasize-need-full-display = true
     1726       .
     1727       if v-diasize-change-size = false
     1728       then do:
     1729         assign
     1730           v-diasize-change-size = true
     1731         .
     1732       end.
     1733       else do:
     1734         return .
     1735       end.
     1736       assign
     1737         v-frame-height = frame Dialog-Frame :height
     1738         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1739         v-browse-height = v-diasize-browse-handle :height
     1740       .
     1741       for each buf_temp-browse-handle
     1742         where buf_temp-browse-handle.browse-type = 'height':u
     1743       :
     1744         assign
     1745           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1746         .
     1747       end.
     1748       for each buf_temp-diasize-handle
     1749       :
     1750         delete buf_temp-diasize-handle .
     1751       end.
     1752       assign
     1753         v-field-group-handle = frame Dialog-Frame :first-child
     1754       .
     1755       do while valid-handle(v-field-group-handle)
     1756       :
     1757         assign
     1758           v-object-handle = v-field-group-handle :first-child
     1759         .
     1760         do while valid-handle(v-object-handle)
     1761         :
     1762           if  v-object-handle <> v-diasize-browse-handle :handle
     1763           and can-query(v-object-handle, "row")
     1764           and can-query(v-object-handle, "height")
     1765           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1766           then do:
     1767             find first buf_temp-browse-handle
     1768               where buf_temp-browse-handle.browse-type   = 'height':u
     1769                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1770               no-error .
     1771             if available buf_temp-browse-handle
     1772             then do:
     1773             end.
     1774             else do:
     1775               create buf_temp-diasize-handle .
     1776               assign
     1777                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1778                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1779               .
     1780             end.
     1781           end.
     1782           assign
     1783             v-object-handle = v-object-handle :next-sibling
     1784           .
     1785         end.
     1786         assign
     1787           v-field-group-handle = v-field-group-handle :next-sibling
     1788         .
     1789       end.
     1790       do with frame Dialog-Frame
     1791       :
     1792         hide v-diasize-resize-button .
     1793         assign
     1794           v-diasize-resize-button :row    = 1
     1795           v-diasize-resize-button :column = 1
     1796         .
     1797       end.
     1798       if p-change-value > 0
     1799       then do:
     1800         if frame Dialog-Frame :scrollable = true
     1801         then do:
     1802           assign
     1803             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1804             no-error .
     1805           if error-status :error
     1806           or error-status :get-message(1) <> ""
     1807           then do:
     1808             undo move_block, retry move_block .
     1809           end.
     1810         end.
     1811         assign
     1812           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1813           no-error .
     1814         if error-status :error
     1815         or error-status :get-message(1) <> ""
     1816         then do:
     1817           undo move_block, retry move_block .
     1818         end.
     1819         assign
     1820           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1821           no-error .
     1822         if error-status :error
     1823         or error-status :get-message(1) <> ""
     1824         then do:
     1825           undo move_block, retry move_block .
     1826         end.
     1827         for each buf_temp-browse-handle
     1828           where buf_temp-browse-handle.browse-type = 'height':u
     1829         on error undo move_block, retry move_block
     1830         :
     1831           assign
     1832             buf_temp-browse-handle.browse-handle :height
     1833               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1834             no-error .
     1835           if error-status :error
     1836           or error-status :get-message(1) <> ""
     1837           then do:
     1838             undo move_block, retry move_block .
     1839           end.
     1840         end.
     1841         for each buf_temp-diasize-handle
     1842         on error undo move_block, retry move_block
     1843         :
     1844           assign
     1845             v-object-handle = buf_temp-diasize-handle.handle-value
     1846           .
     1847           if v-object-handle <> v-diasize-resize-button
     1848           then do:
     1849             assign
     1850               v-object-handle :row = v-object-handle :row + p-change-value
     1851               no-error .
     1852             if error-status :error
     1853             or error-status :get-message(1) <> ""
     1854             then do:
     1855               undo move_block, retry move_block .
     1856             end.
     1857           end.
     1858         end.
     1859       end.
     1860       else do:
     1861         for each buf_temp-diasize-handle
     1862         on error undo move_block, retry move_block
     1863         :
     1864           assign
     1865             v-object-handle = buf_temp-diasize-handle.handle-value
     1866           .
     1867           if v-object-handle <> v-diasize-resize-button
     1868           then do:
     1869             assign
     1870               v-object-handle :row = v-object-handle :row + p-change-value
     1871               no-error .
     1872             if error-status :error
     1873             or error-status :get-message(1) <> ""
     1874             then do:
     1875               undo move_block, retry move_block .
     1876             end.
     1877           end.
     1878         end.
     1879         assign
     1880           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1881           no-error .
     1882         if error-status :error
     1883         or error-status :get-message(1) <> ""
     1884         then do:
     1885           undo move_block, retry move_block .
     1886         end.
     1887         for each buf_temp-browse-handle
     1888           where buf_temp-browse-handle.browse-type = 'height':u
     1889         on error undo move_block, retry move_block
     1890         :
     1891           assign
     1892             buf_temp-browse-handle.browse-handle :height
     1893               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1894             no-error .
     1895           if error-status :error
     1896           or error-status :get-message(1) <> ""
     1897           then do:
     1898             undo move_block, retry move_block .
     1899           end.
     1900         end.
     1901         assign
     1902           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1903           no-error .
     1904         if error-status :error
     1905         or error-status :get-message(1) <> ""
     1906         then do:
     1907           undo move_block, retry move_block .
     1908         end.
     1909         if frame Dialog-Frame :scrollable = true
     1910         then do:
     1911           assign
     1912             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1913             no-error .
     1914           if error-status :error
     1915           or error-status :get-message(1) <> ""
     1916           then do:
     1917             undo move_block, retry move_block .
     1918           end.
     1919         end.
     1920       end.
     1921       if p-move-resize = true
     1922       then do:
     1923         run diasize_position-resize-button in this-procedure .
     1924       end.
     1925       if v-diasize-wndstore = true
     1926       then do:
     1927         if connected("ub") = true
     1928         then do:
     1929           define variable v-cntxt-db-num        as integer   no-undo .
     1930           define variable v-cntxt-userid        as character no-undo .
     1931           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1932                                             , OUTPUT v-cntxt-userid
     1933                                             ) .
     1934           run gbl/wndsizew.p
     1935             (input  v-cntxt-db-num
     1936             ,input  v-cntxt-userid
     1937             ,input  v-diasize-proc-name
     1938             ,input  'height':u
     1939             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1940             ) .
     1941         end.
     1942       end.
     1943     end.
     1944     assign
     1945       v-diasize-change-size = false
     1946     .
     1947   end procedure.
     1948   procedure diasize_set-height :
     1949     define input  parameter p-new-height  as decimal   no-undo .
     1950     define input  parameter p-move-resize as logical   no-undo .
     1951     do
     1952     on error undo, return error return-value
     1953     :
     1954       run diasize_change-height in this-procedure
     1955         (input  (p-new-height - frame Dialog-Frame :height)
     1956         ,input  p-move-resize
     1957         ) .
     1958     end.
     1959   end procedure.
     1960   procedure diasize_change-width :
     1961     define input  parameter p-change-value as decimal   no-undo .
     1962     define input  parameter p-move-resize  as logical   no-undo .
     1963     define variable v-field-group-handle   as handle    no-undo .
     1964     define variable v-object-handle        as handle    no-undo .
     1965     define variable v-frame-width          as decimal   no-undo .
     1966     define variable v-frame-virtual-width  as decimal   no-undo .
     1967     define variable v-browse-width         as decimal   no-undo .
     1968     define variable v-window-width         as decimal   no-undo .
     1969     define variable v-window-virtual-width as decimal   no-undo .
     1970     define variable v-change-sign          as integer   no-undo .
     1971     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1972     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1973     if p-change-value > 0
     1974     then do:
     1975       if frame Dialog-Frame :width + p-change-value >
     1976           session :width-chars
     1977       then do:
     1978         assign
     1979           p-change-value = session :width-chars - frame Dialog-Frame :width
     1980         .
     1981         if p-change-value <= 0
     1982         then do:
     1983           run diasize_position-resize-button in this-procedure .
     1984           return .
     1985         end.
     1986       end.
     1987     end.
     1988     if p-change-value < 0
     1989     then do:
     1990       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1991       then do:
     1992         assign
     1993           p-change-value = v-diasize-orig-frame-width
     1994                          - frame Dialog-Frame :width
     1995         .
     1996         if p-change-value >= 0
     1997         then do:
     1998           run diasize_position-resize-button in this-procedure .
     1999           return .
     2000         end.
     2001       end.
     2002     end.
     2003     if p-change-value >= 0
     2004     then do:
     2005       assign
     2006         v-change-sign = 1
     2007       .
     2008     end.
     2009     else do:
     2010       assign
     2011         v-change-sign = -1
     2012       .
     2013     end.
     2014     assign
     2015       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2016     .
     2017     if p-change-value = 0
     2018     then do:
     2019       run diasize_position-resize-button in this-procedure .
     2020       return .
     2021     end.
     2022     move_block:
     2023     do
     2024     on error undo move_block, leave move_block
     2025     :
     2026       if retry
     2027       then do:
     2028         do
     2029         on error undo move_block, leave move_block
     2030         :
     2031           if p-change-value > 0
     2032           then do:
     2033             for each buf_temp-diasize-handle
     2034             on error undo, next
     2035             :
     2036               assign
     2037                 v-object-handle = buf_temp-diasize-handle.handle-value
     2038               .
     2039               if v-object-handle <> v-diasize-resize-button
     2040               then do:
     2041                 assign
     2042                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2043                 .
     2044               end.
     2045             end.
     2046             assign
     2047               v-diasize-browse-handle :width = v-browse-width
     2048             .
     2049             for each buf_temp-browse-handle
     2050               where buf_temp-browse-handle.browse-type = 'width':u
     2051             on error undo, next
     2052             :
     2053               assign
     2054                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2055               .
     2056             end.
     2057             assign
     2058               frame Dialog-Frame :width = v-frame-width
     2059             .
     2060             if frame Dialog-Frame :scrollable = true
     2061             then do:
     2062               assign
     2063                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2064               .
     2065             end.
     2066             run diasize_position-resize-button in this-procedure .
     2067           end.
     2068           else do:
     2069             if frame Dialog-Frame :scrollable = true
     2070             then do:
     2071               assign
     2072                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2073               .
     2074             end.
     2075             assign
     2076               frame Dialog-Frame :width = v-frame-width
     2077             .
     2078             for each buf_temp-browse-handle
     2079               where buf_temp-browse-handle.browse-type = 'width':u
     2080             on error undo, next
     2081             :
     2082               assign
     2083                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2084               .
     2085             end.
     2086             assign
     2087               v-diasize-browse-handle :width = v-browse-width
     2088             .
     2089             for each buf_temp-diasize-handle
     2090             on error undo, next
     2091             :
     2092               assign
     2093                 v-object-handle = buf_temp-diasize-handle.handle-value
     2094               .
     2095               if v-object-handle <> v-diasize-resize-button
     2096               then do:
     2097                 assign
     2098                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2099                 .
     2100               end.
     2101             end.
     2102             run diasize_position-resize-button in this-procedure .
     2103           end.
     2104           assign
     2105             v-diasize-change-size = false
     2106           .
     2107           leave move_block .
     2108         end.
     2109       end.
     2110       assign
     2111         v-diasize-need-full-display = true
     2112       .
     2113       if v-diasize-change-size = false
     2114       then do:
     2115         assign
     2116           v-diasize-change-size = true
     2117         .
     2118       end.
     2119       else do:
     2120         return .
     2121       end.
     2122       assign
     2123         v-frame-width = frame Dialog-Frame :width
     2124         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2125         v-browse-width = v-diasize-browse-handle :width
     2126       .
     2127       for each buf_temp-browse-handle
     2128         where buf_temp-browse-handle.browse-type = 'width':u
     2129       :
     2130         assign
     2131           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2132         .
     2133       end.
     2134       for each buf_temp-diasize-handle
     2135       :
     2136         delete buf_temp-diasize-handle .
     2137       end.
     2138       assign
     2139         v-field-group-handle = frame Dialog-Frame :first-child
     2140       .
     2141       do while valid-handle(v-field-group-handle)
     2142       :
     2143         assign
     2144           v-object-handle = v-field-group-handle :first-child
     2145         .
     2146         do while valid-handle(v-object-handle)
     2147         :
     2148           if  v-object-handle <> v-diasize-browse-handle :handle
     2149           and v-object-handle <> v-diasize-resize-button
     2150           and can-query(v-object-handle, "row")
     2151           and can-query(v-object-handle, "height")
     2152           and ( v-object-handle :col + v-object-handle :width
     2153                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2154               )
     2155           then do:
     2156             find first buf_temp-browse-handle
     2157               where buf_temp-browse-handle.browse-type   = 'width':u
     2158                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2159               no-error .
     2160             if available buf_temp-browse-handle
     2161             then do:
     2162             end.
     2163             else do:
     2164               create buf_temp-diasize-handle .
     2165               assign
     2166                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2167                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2168               .
     2169             end.
     2170           end.
     2171           assign
     2172             v-object-handle = v-object-handle :next-sibling
     2173           .
     2174         end.
     2175         assign
     2176           v-field-group-handle = v-field-group-handle :next-sibling
     2177         .
     2178       end.
     2179       do with frame Dialog-Frame
     2180       :
     2181         hide v-diasize-resize-button .
     2182         v-diasize-resize-button :row = 1.
     2183         v-diasize-resize-button :column = 1.
     2184       end.
     2185       if p-change-value > 0
     2186       then do:
     2187         if frame Dialog-Frame :scrollable = true
     2188         then do:
     2189           assign
     2190             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2191             no-error .
     2192           if error-status :error
     2193           or error-status :get-message(1) <> ""
     2194           then do:
     2195             undo move_block, retry move_block.
     2196           end.
     2197         end.
     2198         assign
     2199           frame Dialog-Frame :width = v-frame-width + p-change-value
     2200           no-error .
     2201         if error-status :error
     2202         or error-status :get-message(1) <> ""
     2203         then do:
     2204           undo move_block, retry move_block.
     2205         end.
     2206         assign
     2207           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2208         no-error .
     2209         if error-status :error
     2210         or error-status :get-message(1) <> ""
     2211         then do:
     2212           undo move_block, retry move_block.
     2213         end.
     2214         for each buf_temp-browse-handle
     2215           where buf_temp-browse-handle.browse-type = 'width':u
     2216         on error undo move_block, retry move_block
     2217         :
     2218           assign
     2219             buf_temp-browse-handle.browse-handle :width
     2220               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2221             no-error .
     2222           if error-status :error
     2223           or error-status :get-message(1) <> ""
     2224           then do:
     2225             undo move_block, retry move_block .
     2226           end.
     2227         end.
     2228         for each buf_temp-diasize-handle
     2229         on error undo move_block, retry move_block
     2230         :
     2231           assign
     2232             v-object-handle = buf_temp-diasize-handle.handle-value
     2233           .
     2234           if v-object-handle <> v-diasize-resize-button
     2235           then do:
     2236             assign
     2237               v-object-handle :col = v-object-handle :col + p-change-value
     2238               no-error .
     2239             if error-status :error
     2240             or error-status :get-message(1) <> ""
     2241             then do:
     2242               undo move_block, retry move_block .
     2243             end.
     2244           end.
     2245         end.
     2246       end.
     2247       else do:
     2248         for each buf_temp-diasize-handle
     2249         on error undo move_block, retry move_block
     2250         :
     2251           assign
     2252             v-object-handle = buf_temp-diasize-handle.handle-value
     2253           .
     2254           if v-object-handle <> v-diasize-resize-button
     2255           then do:
     2256             assign
     2257               v-object-handle :col = v-object-handle :col + p-change-value
     2258               no-error .
     2259             if error-status :error
     2260             or error-status :get-message(1) <> ""
     2261             then do:
     2262               undo move_block, retry move_block .
     2263             end.
     2264           end.
     2265         end.
     2266         for each buf_temp-browse-handle
     2267           where buf_temp-browse-handle.browse-type = 'width':u
     2268         on error undo move_block, retry move_block
     2269         :
     2270           assign
     2271             buf_temp-browse-handle.browse-handle :width
     2272               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2273             no-error .
     2274           if error-status :error
     2275           or error-status :get-message(1) <> ""
     2276           then do:
     2277             undo move_block, retry move_block .
     2278           end.
     2279         end.
     2280         assign
     2281           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2282           no-error .
     2283         if error-status :error
     2284         or error-status :get-message(1) <> ""
     2285         then do:
     2286           undo move_block, retry move_block.
     2287         end.
     2288         assign
     2289           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2290         no-error .
     2291         if error-status :error
     2292         or error-status :get-message(1) <> ""
     2293         then do:
     2294           undo move_block, retry move_block.
     2295         end.
     2296         if frame Dialog-Frame :scrollable = true
     2297         then do:
     2298           assign
     2299             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2300           no-error .
     2301           if error-status :error
     2302           or error-status :get-message(1) <> ""
     2303           then do:
     2304             undo move_block, retry move_block.
     2305           end.
     2306         end.
     2307       end.
     2308       if p-move-resize
     2309       then do:
     2310         run diasize_position-resize-button in this-procedure .
     2311       end.
     2312       if v-diasize-wndstore = true
     2313       then do:
     2314         if connected("ub") = true
     2315         then do:
     2316           define variable v-cntxt-db-num        as integer   no-undo .
     2317           define variable v-cntxt-userid        as character no-undo .
     2318           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2319                                             , OUTPUT v-cntxt-userid
     2320                                             ) .
     2321           run gbl/wndsizew.p
     2322             (input  v-cntxt-db-num
     2323             ,input  v-cntxt-userid
     2324             ,input  v-diasize-proc-name
     2325             ,input  'width':u
     2326             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2327             ) .
     2328         end.
     2329       end.
     2330     end.
     2331     assign
     2332       v-diasize-change-size = false
     2333     .
     2334   end procedure.
     2335   procedure diasize_set-width :
     2336     define input  parameter p-new-width  as decimal   no-undo .
     2337     define input  parameter p-move-resize as logical   no-undo .
     2338     do
     2339     on error undo, return error return-value
     2340     :
     2341       run diasize_change-width in this-procedure
     2342         (input  (p-new-width - frame Dialog-Frame :width)
     2343         ,input  p-move-resize
     2344         ) .
     2345     end.
     2346   end procedure.
     2347   procedure diasize_position-resize-button :
     2348     do with frame Dialog-Frame
     2349     :
     2350       hide v-diasize-resize-button .
     2351       assign
     2352         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2353                     - 1
     2354                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2355         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2356                     - 1
     2357                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2358       .
     2359       view v-diasize-resize-button .
     2360     end.
     2361   end procedure.
     2362   on alt-right anywhere
     2363   do:
     2364     run diasize_change-width in this-procedure
     2365       (input 1
     2366       ,input true
     2367       ) .
     2368     return no-apply .
     2369   end.
     2370   on alt-left anywhere
     2371   do:
     2372     run diasize_change-width in this-procedure
     2373       (input -1
     2374       ,input true
     2375       ) .
     2376     return no-apply .
     2377   end.
     2378   on alt-down anywhere
     2379   do:
     2380     run diasize_change-height in this-procedure
     2381       (input 1
     2382       ,input true
     2383       ) .
     2384     return no-apply .
     2385   end.
     2386   on alt-up anywhere
     2387   do:
     2388     run diasize_change-height in this-procedure
     2389       (input -1
     2390       ,input true
     2391       ) .
     2392     return no-apply .
     2393   end.
     2394   on alt-enter of frame Dialog-Frame
     2395   do:
     2396     run diasize_maximize in this-procedure
     2397       (input  ?
     2398       ).
     2399     return no-apply .
     2400   end.
     2401   procedure diasize_end-move :
     2402     do
     2403     on error undo, return error return-value
     2404     :
     2405       define variable v-row-delta as decimal   no-undo .
     2406       define variable v-col-delta as decimal   no-undo .
     2407       define variable v-new-row as decimal   no-undo .
     2408       define variable v-new-col as decimal   no-undo .
     2409       assign
     2410         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2411         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2412       .
     2413       assign
     2414         v-row-delta = v-new-row - frame Dialog-Frame :height
     2415         v-col-delta = v-new-col - frame Dialog-Frame :width
     2416       .
     2417       run diasize_change-height in this-procedure
     2418         (input v-row-delta
     2419         ,input true
     2420         ) .
     2421       run diasize_change-width in this-procedure
     2422         (input v-col-delta
     2423         ,input true
     2424         ) .
     2425     end.
     2426   end procedure.
     2427   procedure diasize_maximize :
     2428     define input  parameter p-action as logical   no-undo .
     2429     do
     2430     on error undo, return error return-value
     2431     :
     2432       if p-action = ?
     2433       then do:
     2434         if v-diasize-need-maximize = true
     2435         then do:
     2436           assign
     2437             p-action = true
     2438           .
     2439         end.
     2440         else do:
     2441           assign
     2442             p-action = false
     2443           .
     2444         end.
     2445       end.
     2446       if p-action = true
     2447       then do:
     2448         run diasize_change-height in this-procedure
     2449           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2450               - frame Dialog-Frame :height-chars
     2451           ,input true
     2452           ) .
     2453         run diasize_change-width in this-procedure
     2454           (input session :width-chars
     2455               - frame Dialog-Frame :width-chars
     2456           ,input true
     2457           ) .
     2458         assign
     2459           v-diasize-need-maximize = false
     2460         .
     2461       end.
     2462       else do:
     2463         run diasize_change-width in this-procedure
     2464           (input v-diasize-orig-frame-width
     2465               - frame Dialog-Frame :width-chars
     2466           ,input true
     2467           ) .
     2468         run diasize_change-height in this-procedure
     2469           (input v-diasize-orig-frame-height
     2470               - frame Dialog-Frame :height-chars
     2471           ,input true
     2472           ) .
     2473         assign
     2474           v-diasize-need-maximize = true
     2475         .
     2476       end.
     2477     end.
     2478   end procedure.
     2479   procedure diasize_restore-orig-size :
     2480     do
     2481     on error undo, return error return-value
     2482     :
     2483       assign
     2484         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2485         v-diasize-current-frame-height = frame Dialog-Frame :height
     2486       .
     2487       run diasize_set-height in this-procedure
     2488         (input  v-diasize-orig-frame-height
     2489         ,input  true
     2490         ) .
     2491       run diasize_set-width in this-procedure
     2492         (input  v-diasize-orig-frame-width
     2493         ,input  true
     2494         ) .
     2495     end.
     2496   end procedure.
     2497   procedure diasize_restore-current-size :
     2498     do
     2499     on error undo, return error return-value
     2500     :
     2501       run diasize_set-height in this-procedure
     2502         (input  v-diasize-current-frame-height
     2503         ,input  true
     2504         ) .
     2505       run diasize_set-width in this-procedure
     2506         (input  v-diasize-current-frame-width
     2507         ,input  true
     2508         ) .
     2509     end.
     2510   end procedure.
     2511   procedure diasize_set-browse-handle :
     2512     define input  parameter p-browse-handle as handle   no-undo .
     2513     define buffer buf_temp-browse-handle for temp-browse-handle .
     2514     do
     2515     on error undo, return error return-value
     2516     :
     2517       assign
     2518         v-diasize-browse-handle = p-browse-handle
     2519       .
     2520       for each buf_temp-browse-handle
     2521       on error undo, return error return-value
     2522       :
     2523         delete buf_temp-browse-handle .
     2524       end.
     2525     end.
     2526   end procedure.
     2527   procedure diasize_add_browse :
     2528     define input  parameter p-browse-type   as character no-undo .
     2529     define input  parameter p-browse-handle as handle    no-undo .
     2530     define buffer buf_temp-browse-handle for temp-browse-handle .
     2531     do
     2532     on error undo, return error return-value
     2533     :
     2534       assign
     2535         v-diasize-browse-number = v-diasize-browse-number + 1
     2536       .
     2537       create buf_temp-browse-handle .
     2538       assign
     2539         buf_temp-browse-handle.browse-type   = p-browse-type
     2540         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2541         buf_temp-browse-handle.browse-handle = p-browse-handle
     2542       .
     2543     end.
     2544   end procedure.
     2545   procedure diasize_init :
     2546     define variable v-default-value    as logical   no-undo .
     2547     define variable v-restore-saved    as logical   no-undo .
     2548     define variable v-resize-value-str as character no-undo .
     2549     do
     2550     on error undo, return error return-value
     2551     :
     2552       do with frame Dialog-Frame
     2553       :
     2554         assign
     2555           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2556           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2557           v-diasize-browse-handle     = browse BR-tax-rate :handle
     2558         .
     2559         create button v-diasize-resize-button
     2560         assign
     2561           parent        = frame Dialog-Frame :first-child
     2562           label         = "s"
     2563           height-pixels = 16
     2564           width-pixels  = 16
     2565           visible       = true
     2566           sensitive     = true
     2567           movable       = true
     2568           triggers:
     2569             on end-move persistent run diasize_end-move in this-procedure .
     2570           end triggers.
     2571         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2572         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2573         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2574         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2575         assign
     2576           v-diasize-wndmax = false
     2577         .
     2578         if connected("ub") = true
     2579         then do:
     2580           define variable v-cntxt-db-num        as integer   no-undo .
     2581           define variable v-cntxt-userid        as character no-undo .
     2582           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2583                                             , OUTPUT v-cntxt-userid
     2584                                             ) .
     2585           run gbl/wndpar_r.p
     2586             (input  v-cntxt-db-num
     2587             ,input  v-cntxt-userid
     2588             ,input  'wndmax':U
     2589             ,output v-diasize-wndmax
     2590             ,output v-default-value
     2591             ) .
     2592         end.
     2593         assign
     2594           v-diasize-wndstore = false
     2595         .
     2596         if connected("ub") = true
     2597         then do:
     2598           run gbl/wndpar_r.p
     2599             (input  v-cntxt-db-num
     2600             ,input  v-cntxt-userid
     2601             ,input  'wndstore':U
     2602             ,output v-diasize-wndstore
     2603             ,output v-default-value
     2604             ) .
     2605         end.
     2606         assign
     2607           v-diasize-proc-name = entry(1, program-name(2), '.')
     2608         .
     2609         if v-diasize-wndstore = true
     2610         then do:
     2611           assign
     2612             v-restore-saved = false
     2613           .
     2614           if connected("ub") = true
     2615           then do:
     2616             run gbl/wndsizer.p
     2617               (input  v-cntxt-db-num
     2618               ,input  v-cntxt-userid
     2619               ,input  v-diasize-proc-name
     2620               ,input  'height':u
     2621               ,output v-resize-value-str
     2622               ) .
     2623             if v-resize-value-str <> '':U
     2624             then do:
     2625               run diasize_change-height in this-procedure
     2626                 (input  integer(v-resize-value-str)
     2627                 ,input  true
     2628                 ) .
     2629               assign
     2630                 v-restore-saved = true
     2631               .
     2632             end.
     2633           end.
     2634           if connected("ub") = true
     2635           then do:
     2636             run gbl/wndsizer.p
     2637               (input  v-cntxt-db-num
     2638               ,input  v-cntxt-userid
     2639               ,input  v-diasize-proc-name
     2640               ,input  'width':u
     2641               ,output v-resize-value-str
     2642               ) .
     2643             if v-resize-value-str <> '':U
     2644             then do:
     2645               run diasize_change-width in this-procedure
     2646                 (input  integer(v-resize-value-str)
     2647                 ,input  true
     2648                 ) .
     2649               assign
     2650                 v-restore-saved = true
     2651               .
     2652             end.
     2653           end.
     2654           if v-restore-saved <> true
     2655           then do:
     2656             if v-diasize-wndmax = true
     2657             then do:
     2658               run diasize_maximize in this-procedure
     2659                 (input  true
     2660                 ) .
     2661             end.
     2662           end.
     2663         end.
     2664         else do:
     2665           if v-diasize-wndmax = true
     2666           then do:
     2667             run diasize_maximize in this-procedure
     2668               (input  true
     2669               ) .
     2670           end.
     2671         end.
     2672       end.
     2673     end.
     2674   end procedure.
     2675   procedure diasize_need-full-display :
     2676     define output parameter p-need-full-display as logical   no-undo .
     2677     do
     2678     on error undo, return error return-value
     2679     :
     2680       assign
     2681         p-need-full-display = v-diasize-need-full-display
     2682       .
     2683       assign
     2684         v-diasize-need-full-display = false
     2685       .
     2686     end.
     2687   end procedure.
     2688   procedure get-context :
     2689      define output parameter p-db-num as integer          no-undo.
     2690      define output parameter p-user-id as character        no-undo.
     2691      define variable v-login               as character    no-undo.
     2692      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2693      define buffer buf_user-login  for ub.user-login .
     2694      do
     2695      on error undo, return error
     2696      :
     2697            FIND FIRST buf_sys-ctrl no-lock.
     2698            ASSIGN
     2699               v-login = USERID("ub")
     2700               p-db-num = buf_sys-ctrl.db-num
     2701            .
     2702            FIND FIRST buf_user-login
     2703                 WHERE buf_user-login.db-num = p-db-num
     2704                   AND buf_user-login.user-login = v-login
     2705                 no-lock
     2706                 no-error
     2707                 .
     2708            IF AVAILABLE buf_user-login
     2709            THEN DO:
     2710               assign
     2711                  p-user-id = buf_user-login.user-id
     2712               .
     2713            END.
     2714      end.
     2715   end procedure.
     2716   run diasize_add_browse in this-procedure
     2717     (input  'width':u
     2718     ,input  browse br-taxes :handle
     2719     ) .
     2720   run diasize_add_browse in this-procedure
     2721     (input  'height':u
     2722     ,input  browse BR-tax-rate-value :handle
     2723     ) .
     2724   run diasize_init in this-procedure .
     2725   MAIN-BLOCK:
     2726   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2727      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2728   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2729     run mainmenu_getcntxt in parparentproc
     2730       (output v-cntxt-db-num
     2731       ,output v-cntxt-userid
     2732       ,output v-cntxt-level
     2733       ,output v-cntxt-host-code-obj
     2734       ,output v-cntxt-obj-type
     2735       ,output v-cntxt-obj-code
     2736       ,output v-cntxt-db-num-obj
     2737       ,output v-cntxt-is-admin
     2738       ) .
     2739     if ref-mode = "ALL-TAX-RATES" then do:
     2740         if rid# <> ? then do:
     2741           find first tax no-lock where
     2742                               recid(tax) = rid# No-ERROR.
     2743           if not avail tax then return error.
     2744           var-tax-code = tax.tax-code.
     2745        end.
     2746     end.
     2747     assign
     2748     v-tax-rate-rid = p-tax-rate-rid
     2749     .
     2750     RUN Myenable.
     2751     if ref-mode = "ALL-TAX-RATES" then do:
     2752        var-ismarked = if LOOKUP("b-seltax-rate", bttns) > 0 or LOOKUP("b-markltax-rate", bttns) > 0 then yes else no.
     2753        run OpenBr-tax-rate.
     2754     end.
     2755     else do:
     2756        RUn OpenBr.
     2757     end.
     2758     WAIT-FOR GO OF FRAME Dialog-Frame.
     2759   END.
     2760   RUN disable_UI.
     2761   PROCEDURE disable_UI :
     2762     HIDE FRAME Dialog-Frame.
     2763   END PROCEDURE.
     2764   PROCEDURE enable_UI :
     2765     DISPLAY RS-date br-tax-rate-name br-tax-rate-value-name mark-numtax-rate
     2766         WITH FRAME Dialog-Frame.
     2767     ENABLE B-exit B-seltax B-addtax B-chgtax B-Help BR-taxes RS-date
     2768            B-seltax-rate B-marktax-rate B-addtax-rate B-chgtax-rate B-deltax-rate
     2769            B-addtax-rate-value B-deltax-rate-value B-gdstax-rate B-histtax-rate
     2770            B-ext B-overvalue-rate-value B-histtax-rate-value BR-tax-rate
     2771            BR-tax-rate-value mark-numtax-rate
     2772         WITH FRAME Dialog-Frame.
     2773     VIEW FRAME Dialog-Frame.
     2774     OPEN QUERY BR-taxes FOR EACH ub.tax NO-LOCK.
     2775   END PROCEDURE.
     2776   PROCEDURE MyEnable :
     2777   define variable nr as integer no-undo.
     2778   HIDE
     2779   mark-numtax-rate
     2780   in frame Dialog-Frame .
     2781   assign
     2782   RS-DATE = 1
     2783   B-addtax-rate-value:POPUP-MENU IN FRAME Dialog-Frame  = MENU MENU-B-addtax-rate-value:HANDLE
     2784   b-addtax-rate-value:MENU-MOUSE in frame Dialog-Frame = 1
     2785   nr = BR-taxes:height-chars
     2786   menu-item m_global:sensitive in menu menu-b-addtax-rate-value = (if v-cntxt-db-num > 0 then no  else yes)
     2787   menu-item m_host:sensitive in menu menu-b-addtax-rate-value = (if v-cntxt-db-num > 0 then no  else yes)
     2788   .
     2789   ENABLE
     2790   B-exit
     2791   B-seltax when lookup("b-seltax":U, bttns) > 0
     2792   B-chgtax when (v-cntxt-db-num = 0 AND not (parobj-type = "":U and parobj-code = 0))
     2793   b-taxgds
     2794   B-Help
     2795   b-taxhist
     2796   BR-taxes
     2797   B-seltax-rate when lookup("b-seltax-rate":U, bttns) > 0
     2798   B-addtax-rate when (v-cntxt-db-num = 0 AND NOT ref-mode = "ALL-TAX-RATES":U AND not (parobj-type = "":U and parobj-code = 0))
     2799   B-chgtax-rate when (v-cntxt-db-num = 0 AND NOT ref-mode = "ALL-TAX-RATES":U AND not (parobj-type = "":U and parobj-code = 0))
     2800   B-deltax-rate  when (v-cntxt-db-num = 0 AND NOT ref-mode = "ALL-TAX-RATES":U AND not (parobj-type = "":U and parobj-code = 0))
     2801   B-marktax-rate when lookup("b-marktax-rate":U, bttns) > 0
     2802   B-histtax-rate
     2803   b-gdstax-rate
     2804   BR-tax-rate
     2805   RS-DATE
     2806   b-addtax-rate-value when (NOT ref-mode = "ALL-TAX-RATES":U AND not (parobj-type = "":U and parobj-code = 0))
     2807   b-deltax-rate-value when (NOT ref-mode = "ALL-TAX-RATES":U AND not (parobj-type = "":U and parobj-code = 0))
     2808   b-histtax-rate-value when NOT ref-mode = "ALL-TAX-RATES":U
     2809   b-overvalue-rate-value when (NOT ref-mode = "ALL-TAX-RATES":U AND not (parobj-type = "":U and parobj-code = 0))
     2810   b-ext
     2811   BR-tax-rate-value
     2812   WITH FRAME Dialog-Frame.
     2813   if ref-mode = "ALL-TAX-RATES":U then dO:
     2814       hide
     2815       B-chgtax BR-taxes b-seltax B-taxgds B-taxhist
     2816       in frame Dialog-Frame.
     2817           assign
     2818           B-addtax-rate:row in frame Dialog-Frame = B-addtax-rate:row in frame Dialog-Frame - nr
     2819           B-addtax-rate-value:row in frame Dialog-Frame =  B-addtax-rate-value:row - nr
     2820           B-chgtax-rate:row in frame Dialog-Frame =  B-chgtax-rate:row - nr
     2821           B-deltax-rate:row in frame Dialog-Frame =  B-deltax-rate:row - nr
     2822           B-deltax-rate-value:row in frame Dialog-Frame =  B-deltax-rate-value:row - nr
     2823           B-ext:row in frame Dialog-Frame =  B-ext:row - nr
     2824           B-gdstax-rate:row in frame Dialog-Frame =  B-gdstax-rate:row - nr
     2825           B-histtax-rate:row in frame Dialog-Frame =  B-histtax-rate:row - nr
     2826           B-histtax-rate-value:row in frame Dialog-Frame =  B-histtax-rate-value:row - nr
     2827           B-overvalue-rate-value:row in frame Dialog-Frame =  B-overvalue-rate-value:row - nr
     2828           B-marktax-rate:row in frame Dialog-Frame =  B-marktax-rate:row - nr
     2829           BR-tax-rate:row in frame Dialog-Frame =  BR-tax-rate:row - nr
     2830           br-tax-rate-name:row in frame Dialog-Frame =  br-tax-rate-name:row - nr
     2831           BR-tax-rate-value:row in frame Dialog-Frame =  BR-tax-rate-value:row - nr
     2832           br-tax-rate-value-name:row in frame Dialog-Frame =  br-tax-rate-value-name:row - nr
     2833           B-seltax-rate:row in frame Dialog-Frame =  B-seltax-rate:row - nr
     2834           mark-numtax-rate:row in frame Dialog-Frame =  mark-numtax-rate:row - nr
     2835           RS-date:row in frame Dialog-Frame = RS-date:row - nr
     2836           .
     2837           DISPLAY br-tax-rate-name
     2838                   with frame Dialog-Frame.
     2839   end.
     2840   HIDE
     2841   b-addtax
     2842   b-deltax
     2843   in frame Dialog-Frame.
     2844   VIEW FRAME Dialog-Frame.
     2845   END PROCEDURE.
     2846   PROCEDURE OpenBr :
     2847   CASE ref-mode:
     2848       when "ALL":U then do:
     2849           OPEN QUERY BR-taxes FOR EACH ub.tax NO-LOCK.
     2850       end.
     2851       otherwise do:
     2852              OPEN QUERY BR-taxes FOR EACH ub.tax NO-LOCK.
     2853          end.
     2854   END CASE.
     2855   APPLY "VALUE-CHANGED" to br-taxes in frame Dialog-Frame.
     2856   END PROCEDURE.
     2857   PROCEDURE Openbr-tax-rate :
     2858   CASE ref-mode:
     2859       when "ALL":U then do:
     2860           Open query br-tax-rate for each ub.tax-rate where
     2861                                           ub.tax-rate.tax-code = ub.tax.tax-code NO-LOCK.
     2862           br-tax-rate-name = "Ставки по налогу с кодом " + string(ub.tax.tax-code).
     2863               display
     2864               br-tax-rate-name
     2865               with frame Dialog-Frame.
     2866       end.
     2867       when "ALL-TAX-RATES":U then do:
     2868           if var-tax-code = 0 then
     2869           Open query br-tax-rate for each ub.tax-rate NO-LOCK.
     2870           else do:
     2871             br-tax-rate-name = "Ставки по налогу с кодом " + string(ub.tax.tax-code).
     2872             Open query br-tax-rate for each ub.tax-rate where
     2873                                             ub.tax-rate.tax-code = var-tax-code NO-LOCK.
     2874             display
     2875             br-tax-rate-name
     2876             with frame Dialog-Frame.
     2877             REPOSITION BR-tax-rate to recid integer(v-tax-rate-rid) no-error.
     2878             APPLY "ENTRY" to BR-tax-rate.
     2879           end.
     2880       end.
     2881   END CASE.
     2882   APPLY "VALUE-CHANGED" to br-tax-rate in frame Dialog-Frame.
     2883   END PROCEDURE.
     2884   PROCEDURE OpenBr-tax-rate-value :
     2885   define input parameter par-date-option as integer no-undo.
     2886   define var var-tt-rc as recid.
     2887   define var var-fact-order like ub.tax-rate-value.fact-order no-undo.
     2888   define var var-ismarked-rate as logical no-undo.
     2889   DEFINE VARIABLE v-today as date no-undo .
     2890   DEFINE VARIABLE v-time as integer no-undo .
     2891   define buffer bf_tt-tax-rate-value for tt-tax-rate-value.
     2892   run cur-time in this-procedure(output v-today, output v-time).
     2893   run factord-end-day in this-procedure (input v-today, output var-fact-order).
     2894   for each tt-tax-rate-value:
     2895       delete tt-tax-rate-value.
     2896   end.
     2897   if not available ub.tax-rate then do:
     2898     open query br-tax-rate-value for each tt-tax-rate-value no-lock.
     2899     return.
     2900   end.
     2901   var-ismarked-rate = var-ismarked and CAN-DO (v-tax-rate-rid, string( recid(ub.tax-rate))).
     2902   CASE par-date-option:
     2903       when 0 then do:
     2904       for each ub.tax-rate-value where
     2905               ub.tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     2906               ub.tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     2907               ub.tax-rate-value.host-code = 0 AND
     2908               ub.tax-rate-value.obj-type = "" AND
     2909               ub.tax-rate-value.obj-code = 0
     2910               :
     2911         create
     2912         tt-tax-rate-value.
     2913         buffer-copy ub.tax-rate-value to tt-tax-rate-value
     2914         assign
     2915         tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     2916         .
     2917         if tax-rate-value.fact-date <= v-today AND
     2918           (not var-ismarked or var-ismarked-rate)  AND
     2919           tax-rate-value.status_ = 'тек':U
     2920         then
     2921         var-rc = recid(ub.tax-rate-value).
     2922       end.
     2923     end.
     2924     when 1 then do:
     2925       FIND LAST ub.tax-rate-value where
     2926               ub.tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     2927               ub.tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     2928               ub.tax-rate-value.host-code = 0 AND
     2929               ub.tax-rate-value.obj-type = "" AND
     2930               ub.tax-rate-value.obj-code = 0 AND
     2931               ub.tax-rate-value.fact-order <= var-fact-order AND
     2932               ub.tax-rate-value.status_ = 'тек':U No-ERROR.
     2933       if avail ub.tax-rate-value then  do:
     2934           create
     2935           tt-tax-rate-value.
     2936           buffer-copy ub.tax-rate-value to tt-tax-rate-value
     2937           assign
     2938           tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     2939           .
     2940           if (not var-ismarked or var-ismarked-rate) then
     2941           var-rc = recid(ub.tax-rate-value).
     2942       end.
     2943     end.
     2944   END CASE.
     2945       for each ub.tax-rate-value where
     2946               ub.tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     2947               ub.tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     2948               ub.tax-rate-value.host-code > 0 AND
     2949               ub.tax-rate-value.obj-type = "" AND
     2950               ub.tax-rate-value.obj-code = 0 AND
     2951               (par-date-option = 0 or ub.tax-rate-value.fact-order <= var-fact-order) AND
     2952               (par-date-option = 0 or ub.tax-rate-value.status_ = 'тек':U)
     2953       break
     2954       by ub.tax-rate-value.host-code
     2955       by ub.tax-rate-value.obj-type
     2956       by ub.tax-rate-value.obj-code
     2957       by ub.tax-rate-value.fact-order
     2958       by ub.tax-rate-value.status_
     2959       :
     2960         if par-date-option = 0 or last-of(ub.tax-rate-value.obj-code) then do:
     2961             create
     2962             tt-tax-rate-value.
     2963             buffer-copy ub.tax-rate-value to tt-tax-rate-value
     2964             assign
     2965             tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     2966             .
     2967               if tax-rate-value.fact-date <= v-today AND
     2968                  tax-rate-value.host-code = parhost-code AND
     2969                  (not var-ismarked or var-ismarked-rate) AND
     2970                  tax-rate-value.status_ = 'тек':U
     2971               then
     2972               var-rc = recid(ub.tax-rate-value).
     2973         end.
     2974       end.
     2975      for each tt-tax-rate-value where
     2976               tt-tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     2977               tt-tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     2978               tt-tax-rate-value.host-code = 0:
     2979       tt-tax-rate-value.exp = yes.
     2980      end.
     2981       for each ub.tax-rate-value where
     2982               ub.tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     2983               ub.tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     2984               ub.tax-rate-value.host-code = parhost-code AND
     2985               ub.tax-rate-value.obj-type <> "" AND
     2986               ub.tax-rate-value.obj-code <> 0 AND
     2987               (par-date-option = 0 or ub.tax-rate-value.fact-order <= var-fact-order) AND
     2988               (par-date-option = 0 or ub.tax-rate-value.status_ = 'тек':U)
     2989       break
     2990       by ub.tax-rate-value.host-code
     2991       by ub.tax-rate-value.obj-type
     2992       by ub.tax-rate-value.obj-code
     2993       by ub.tax-rate-value.fact-order
     2994       by ub.tax-rate-value.status_
     2995       :
     2996       if par-date-option = 0
     2997       or last-of(ub.tax-rate-value.obj-code)
     2998       then do:
     2999           create
     3000           tt-tax-rate-value.
     3001           buffer-copy ub.tax-rate-value to tt-tax-rate-value
     3002           assign
     3003           tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     3004           .
     3005                  if tax-rate-value.fact-date <= v-today AND
     3006                      tax-rate-value.host-code = parhost-code AND
     3007                      tax-rate-value.obj-type = parobj-type AND
     3008                      tax-rate-value.obj-code = parobj-code AND
     3009                      (not var-ismarked or var-ismarked-rate) AND
     3010                      tax-rate-value.status_ = 'тек':U
     3011                  then
     3012                  var-rc = recid(ub.tax-rate-value).
     3013       end.
     3014     end.
     3015     for each tt-tax-rate-value where
     3016           tt-tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     3017           tt-tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     3018           tt-tax-rate-value.host-code = parhost-code :
     3019        tt-tax-rate-value.exp = yes.
     3020     end.
     3021   find first tt-tax-rate-value where
     3022       tt-tax-rate-value.rc = var-rc no-lock no-error.
     3023       if avail tt-tax-rate-value then
     3024       var-tt-rc = recid(tt-tax-rate-value).
     3025   open query br-tax-rate-value for each tt-tax-rate-value no-lock.
     3026   reposition br-tax-rate-value to recid var-tt-rc no-error.
     3027   br-tax-rate-value-name = "Значения ставки налога с кодом " +
     3028                                                     string(tax-rate.tax-code) +
     3029                            ": код ставки " + string(tax-rate.rate-code).
     3030   display
     3031   br-tax-rate-value-name
     3032   with frame Dialog-Frame.
     3033   if br-tax-rate-value:focused-row in frame Dialog-Frame = 1 then do:
     3034       glog = br-tax-rate-value:SELECT-PREV-ROW( ) .
     3035       if glog then do:
     3036           APPLY "CURSOR-DOWN" to br-tax-rate-value.
     3037       end.
     3038   end.
     3039   END PROCEDURE.
     3040   PROCEDURE proc-b-addtax-rate-value :
     3041   DEFINE INPUT PARAMETER par-option as character no-undo.
     3042   DEFINE INPUT PARAMETER par-date as integer no-undo.
     3043   define buffer b_tt-tax-rate-value for tt-tax-rate-value.
     3044   case par-option
     3045   :
     3046     when "GLOBAL":U
     3047     then do:
     3048   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3049   do:
     3050     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3051       (input  v-cntxt-db-num
     3052       ,input  v-cntxt-userid
     3053       ,input  0
     3054       ,input  'actn_tax-rate-values_global-update':U
     3055       ,input  'firm':U
     3056       ,input  0
     3057       ,input  '':U
     3058       ,input  0
     3059       ,input  0
     3060       ,input  0
     3061       ,input  0
     3062       ,input  true
     3063       ,output glog
     3064       )  .
     3065   end.
     3066     end.
     3067     when "HOST":U
     3068     then do:
     3069   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3070   do:
     3071     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3072       (input  v-cntxt-db-num
     3073       ,input  v-cntxt-userid
     3074       ,input  0
     3075       ,input  'actn_tax-rate-values_firm-update':U
     3076       ,input  'firm':U
     3077       ,input  parhost-code
     3078       ,input  '':U
     3079       ,input  0
     3080       ,input  0
     3081       ,input  0
     3082       ,input  0
     3083       ,input  true
     3084       ,output glog
     3085       )  .
     3086   end.
     3087     end.
     3088     when "OBJECT":U
     3089     then do:
     3090   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3091   do:
     3092     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3093       (input  v-cntxt-db-num
     3094       ,input  v-cntxt-userid
     3095       ,input  0
     3096       ,input  'actn_tax-rate-values_object-update':U
     3097       ,input  'object':U
     3098       ,input  parhost-code
     3099       ,input  parobj-type
     3100       ,input  parobj-code
     3101       ,input  0
     3102       ,input  0
     3103       ,input  0
     3104       ,input  true
     3105       ,output glog
     3106       )  .
     3107   end.
     3108     end.
     3109     otherwise do:
     3110       message
     3111         vss-workfile vss-revision vss-description skip
     3112         "Неизвестное значение режима" skip
     3113         "par-option" par-option skip
     3114         view-as alert-box error .
     3115       undo, return error return-value .
     3116     end.
     3117   end case .
     3118   if not glog then return error.
     3119   if not avail ub.tax-rate then return no-apply.
     3120   if ub.tax-rate.status_ = 'удал':U then do:
     3121     message "Нельзя добавить значениe к удаленной ставке"
     3122     view-as alert-box error .
     3123     return error.
     3124   end.
     3125   ri = recid(ub.tax-rate).
     3126   CASE par-option:
     3127       when "GLOBAL":U then do:
     3128           run ref/taxvali.w ( input 'ДОБАВЛЕНИЕ':U,
     3129                               input 0,
     3130                               input "":U,
     3131                               input 0,
     3132                               input-output ri ) no-error.
     3133           if error-status:error then return error.
     3134       end.
     3135       when "HOST":U then do:
     3136           run ref/taxvali.w ( input 'ДОБАВЛЕНИЕ':U,
     3137                               input parhost-code,
     3138                               input "":U,
     3139                               input 0,
     3140                               input-output ri ) no-error.
     3141           if error-status:error then return error.
     3142       end.
     3143       when "OBJECT":U then do:
     3144           run ref/taxvali.w ( input 'ДОБАВЛЕНИЕ':U,
     3145                               input parhost-code,
     3146                               input parobj-type,
     3147                               input parobj-code,
     3148                               input-output ri ) no-error.
     3149           if error-status:error then return error.
     3150       end.
     3151   END CASE.
     3152   if ri <> ? then  do:
     3153       run OpenBr-tax-rate-value(par-date).
     3154       if var-rc <> ri then do:
     3155         FIND FIRST b_tt-tax-rate-value No-LOCK WHERE
     3156                    b_tt-tax-rate-value.rc = ri No-ERROR.
     3157         if avail b_tt-tax-rate-value then
     3158         reposition br-tax-rate-value to recid recid(b_tt-tax-rate-value) no-error.
     3159         apply "ENTRY" to br-tax-rate-value in frame Dialog-Frame.
     3160       end.
     3161   end.
     3162   END PROCEDURE.
     3163   PROCEDURE proc-b-ext :
     3164   define input parameter par-rc as recid no-undo.
     3165   define input parameter par-date-option as integer no-undo.
     3166   define var var-tt-rc as recid no-undo.
     3167   define var var-fact-order like ub.tax-rate-value.fact-order no-undo.
     3168   DEFINE VARIABLE v-today as date no-undo .
     3169   DEFINE VARIABLE v-time as integer no-undo .
     3170   define buffer b_tt-tax-rate-value for tt-tax-rate-value.
     3171   define buffer bf_tt-tax-rate-value for tt-tax-rate-value.
     3172   if tt-tax-rate-value.host-code <> 0 and
     3173      tt-tax-rate-value.obj-type <> "":U and
     3174      tt-tax-rate-value.obj-code <> 0 THEN do:
     3175      BELL.
     3176      return error.
     3177   end.
     3178   run cur-time in this-procedure(output v-today, output v-time).
     3179   run factord-end-day in this-procedure (input v-today, output var-fact-order).
     3180   var-tt-rc = recid(tt-tax-rate-value).
     3181   IF tt-tax-rate-value.host-code = 0 then do:
     3182       if tt-tax-rate-value.exp = yes then do:
     3183         FIND FIRST b_tt-tax-rate-value where
     3184                    b_tt-tax-rate-value.rc = par-rc No-ERROR.
     3185         if avail b_tt-tax-rate-value and
     3186                 b_tt-tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3187                 b_tt-tax-rate-value.rate-code = tt-tax-rate-value.rate-code
     3188         then.
     3189         else dO:
     3190           FOR EACH b_tt-tax-rate-value where
     3191                                 b_tt-tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3192                                 b_tt-tax-rate-value.rate-code = tt-tax-rate-value.rate-code AND
     3193                                 b_tt-tax-rate-value.host-code <> 0:
     3194                       delete b_tt-tax-rate-value.
     3195           END.
     3196           find first b_tt-tax-rate-value where
     3197                     recid(b_tt-tax-rate-value) = recid(tt-tax-rate-value) No-ERROR.
     3198           if avail b_tt-tax-rate-value then do:
     3199                 b_tt-tax-rate-value.exp = no.
     3200           end.
     3201         end.
     3202       end.
     3203       else do:
     3204         FOR EACH ub.tax-rate-value NO-LOCK where
     3205                 ub.tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3206                 ub.tax-rate-value.rate-code = tt-tax-rate-value.rate-code AND
     3207                 ub.tax-rate-value.host-code <> 0 AND
     3208                 ub.tax-rate-value.obj-type = "" AND
     3209                 ub.tax-rate-value.obj-code = 0 AND
     3210                 (par-date-option = 0 or ub.tax-rate-value.fact-order <= var-fact-order) AND
     3211                 (par-date-option = 0 or ub.tax-rate-value.status_ = 'тек':U)
     3212         break
     3213         by ub.tax-rate-value.host-code
     3214         by ub.tax-rate-value.obj-type
     3215         by ub.tax-rate-value.obj-code
     3216         by ub.tax-rate-value.fact-order
     3217         by ub.tax-rate-value.status_
     3218         :
     3219           if par-date-option = 0 or last-of(ub.tax-rate-value.obj-code) then do:
     3220               create
     3221               b_tt-tax-rate-value.
     3222               buffer-copy ub.tax-rate-value to b_tt-tax-rate-value
     3223               assign
     3224               b_tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     3225               .
     3226           end.
     3227         end.
     3228         find first b_tt-tax-rate-value where
     3229                    recid(b_tt-tax-rate-value) = recid(tt-tax-rate-value) No-ERROR.
     3230         if avail b_tt-tax-rate-value then do:
     3231               b_tt-tax-rate-value.exp = yes.
     3232          end.
     3233       end.
     3234   end.
     3235   else do:
     3236     if tt-tax-rate-value.exp = yes then do:
     3237         FIND FIRST b_tt-tax-rate-value where
     3238                    b_tt-tax-rate-value.rc = par-rc No-ERROR.
     3239         if avail b_tt-tax-rate-value and
     3240                 b_tt-tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3241                 b_tt-tax-rate-value.rate-code = tt-tax-rate-value.rate-code AND
     3242                 b_tt-tax-rate-value.host-code = tt-tax-rate-value.host-code
     3243         then.
     3244         else do:
     3245           FOR EACH b_tt-tax-rate-value where
     3246                     b_tt-tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3247                     b_tt-tax-rate-value.rate-code = tt-tax-rate-value.rate-code AND
     3248                     b_tt-tax-rate-value.host-code = tt-tax-rate-value.host-code AND
     3249                     b_tt-tax-rate-value.obj-type <> "" and
     3250                     b_tt-tax-rate-value.obj-code <> 0:
     3251               delete b_tt-tax-rate-value.
     3252           END.
     3253           find first b_tt-tax-rate-value where
     3254                     recid(b_tt-tax-rate-value) = recid(tt-tax-rate-value) No-ERROR.
     3255           if avail b_tt-tax-rate-value then do:
     3256                     b_tt-tax-rate-value.exp = no.
     3257           end.
     3258        end.
     3259      end.
     3260      else do:
     3261         FOR EACH ub.tax-rate-value NO-LOCK where
     3262               ub.tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3263               ub.tax-rate-value.rate-code = tt-tax-rate-value.rate-code AND
     3264               ub.tax-rate-value.host-code = tt-tax-rate-value.host-code AND
     3265               ub.tax-rate-value.obj-type <> "" AND
     3266               ub.tax-rate-value.obj-code <> 0 AND
     3267               (par-date-option = 0 or ub.tax-rate-value.fact-order <= var-fact-order) AND
     3268               (par-date-option = 0 or ub.tax-rate-value.status_ = 'тек':U)
     3269         break
     3270         by ub.tax-rate-value.host-code
     3271         by ub.tax-rate-value.obj-type
     3272         by ub.tax-rate-value.obj-code
     3273         by ub.tax-rate-value.fact-order
     3274         by ub.tax-rate-value.status_
     3275         :
     3276           if par-date-option = 0 or last-of(ub.tax-rate-value.obj-code) then do:
     3277             create
     3278             b_tt-tax-rate-value.
     3279             buffer-copy ub.tax-rate-value to b_tt-tax-rate-value
     3280             assign
     3281             b_tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     3282             .
     3283         end.
     3284       end.
     3285       find first b_tt-tax-rate-value where
     3286                  recid(b_tt-tax-rate-value) = recid(tt-tax-rate-value) No-ERROR.
     3287       if avail b_tt-tax-rate-value then do:
     3288             b_tt-tax-rate-value.exp = yes.
     3289       end.
     3290     END.
     3291   end.
     3292   open query br-tax-rate-value for each tt-tax-rate-value no-lock.
     3293   reposition br-tax-rate-value to recid var-tt-rc no-error.
     3294   END PROCEDURE.
     3295   FUNCTION get-envd RETURNS CHARACTER
     3296     ( input i-tax-code as integer, i-rate-code as integer) :
     3297   define buffer tax-rate-attr for tax-rate-attr.
     3298   define variable vIsENVD as logical no-undo.
     3299   find first tax-rate-attr where
     3300              tax-rate-attr.tax-code  = i-tax-code
     3301          and tax-rate-attr.rate-code = i-rate-code
     3302          and tax-rate-attr.attr-code = "envd"
     3303   no-lock no-error.
     3304   vIsENVD =  AVAILABLE tax-rate-attr.
     3305   return string(vIsENVD, "+/").
     3306   END FUNCTION.
     3307   FUNCTION get-marktax-rate RETURNS CHARACTER
     3308     ( input par-ismarked as logical, input par-rid as recid, input par-tax-rate-rid as character) :
     3309   define variable var-mark as character no-undo.
     3310   var-mark = IF par-ismarked and  CAN-DO (par-tax-rate-rid, string( par-rid )) THEN ("*") ELSE (" ").
     3311   return var-mark.
     3312   END FUNCTION.
     3313   FUNCTION get-region RETURNS CHARACTER
     3314     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     3315     define variable par-region as character no-undo.
     3316     if parhost-code = 0 and
     3317          parobj-type = "":U and
     3318          parobj-code = 0 then do:
     3319          par-region = "Глобально".
     3320          return par-region.
     3321       end.
     3322       if parobj-type = "" and
     3323          parobj-code = 0 then do:
     3324          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     3325          return par-region.
     3326       end.
     3327       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     3328       return par-region.
     3329   END FUNCTION.
     3330   FUNCTION get-types RETURNS CHARACTER
     3331     ( input partax-code as integer ) :
     3332   DEFINE BUFFER loc-tax-units for ub.tax-units.
     3333   DEFINE VARIABLE var-units-types as character no-undo .
     3334   define variable is-first as logical no-undo init yes.
     3335       FOR EACH loc-tax-units No-LOCK WHERE
     3336               loc-tax-units.tax-code = partax-code:
     3337               var-units-types = var-units-types +
     3338                                 (if is-first then "":U else (chr(44) + chr(32))) +
     3339                                 loc-tax-units.type.
     3340           is-first = no.
     3341       END.
     3342     RETURN var-units-types.
     3343   END FUNCTION.
