        1   DEFINE TEMP-TABLE tt-tax-rate-value NO-UNDO LIKE ub.tax-rate-value
        2          field rc as recid
        3          field exp as logical
        4          index pi is unique primary
        5          tax-code
        6          rate-code
        7          host-code
        8          obj-type
        9          obj-code
       10          fact-order
       11          index irc is unique
       12          rc.
       13   define input parameter parparentproc as widget-handle no-undo .
       14   DEFINE INPUT PARAMETER BTTNS AS CHAR NO-UNDO.
       15   DEFINE INPUT PARAMETER ref-mode AS CHAR No-UNDO.
       16   DEFINE INPUT PARAMETER parhost-code like ub.sysconf.host-code No-UNDO.
       17   DEFINE INPUT PARAMETER  parobj-type like ub.clients.obj-type No-UNDO.
       18   DEFINE INPUT PARAMETER  parobj-code like ub.clients.obj-code No-UNDO.
       19   DEFINE INPUT PARAMETER rid# As recid NO-UNDO.
       20   DEFINE INPUT-OUTPUT PARAMETER p-tax-rate-rid As char NO-UNDO.
       21   define variable vss-revision    as character no-undo init "$Revision$":u .
       22   define variable vss-author      as character no-undo init "$Author$":u .
       23   define variable vss-date        as character no-undo init "$Date$":u .
       24   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       25   define variable vss-archive     as character no-undo init "$Archive$":u .
       26   define variable vss-description as character no-undo init "Справочник видов налогов" .
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure factord :
       89     define input  parameter p-fact-date            as date    no-undo .
       90     define input  parameter p-fact-time            as integer no-undo .
       91     define input  parameter p-fact-num             as integer no-undo .
       92     define input  parameter p-shift-date           as date    no-undo .
       93     define input  parameter p-shift-num            as integer no-undo .
       94     define input  parameter p-shift-on             as logical no-undo .
       95     define output parameter p-fact-order           as decimal no-undo .
       96     define output parameter p-shift-end-fact-order as decimal no-undo .
       97     define output parameter p-day-end-fact-order   as decimal no-undo .
       98     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       99     if p-fact-date = ?
      100     then do:
      101       return error "Не указана фактическая дата" .
      102     end.
      103     define variable v-fact-date-num as integer no-undo .
      104     assign
      105       v-fact-date-num = integer(p-fact-date)
      106     .
      107     if p-fact-num = ?
      108     or p-fact-num = 0
      109     then do:
      110       return error "Не задан p-fact-num " + string(p-fact-num) .
      111     end.
      112     if p-fact-num < 0
      113     then do:
      114       return error "Отрицательный fact-num " + string(p-fact-num) .
      115     end.
      116     if p-fact-num >= 100000000
      117     then do:
      118       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      119     end.
      120     if p-shift-on = true
      121     then do:
      122       if p-shift-date = ?
      123       then do:
      124         return error "Не задана дата смены" .
      125       end.
      126       if p-shift-num = ?
      127       or p-shift-num = 0
      128       then do:
      129         return error "Не задан номер смены" .
      130       end.
      131     end.
      132     else do:
      133       assign
      134         p-shift-date = p-fact-date
      135         p-shift-num  = 24
      136       .
      137     end.
      138     define variable v-shift-offset as integer no-undo .
      139     if p-shift-date = p-fact-date
      140     then do:
      141       assign
      142         v-shift-offset = 1
      143       .
      144     end.
      145     if p-shift-date < p-fact-date
      146     then do:
      147       assign
      148         v-shift-offset = 0
      149       .
      150     end.
      151     if p-shift-date > p-fact-date
      152     then do:
      153       message
      154         vss-workfile vss-revision vss-description skip
      155         "Неправильная дата закрытия смены" skip
      156         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      157         view-as alert-box error .
      158       undo, return error
      159         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      160           ,string(p-fact-date, '99/99/9999':U)
      161           ,string(p-shift-date, '99/99/9999':U)
      162           )
      163       .
      164     end.
      165     if p-shift-num < 1
      166     or p-shift-num > 24
      167     then do:
      168       message
      169         vss-workfile vss-revision vss-description skip
      170         "Неправильный номер смены" skip
      171         "p-shift-num" p-shift-num skip
      172         view-as alert-box error .
      173       undo, return error return-value .
      174     end.
      175     assign
      176       p-fact-order           = v-fact-date-num
      177                              + v-shift-offset * 0.5
      178                              + p-shift-num    * 0.02 - 0.01
      179                              + p-fact-num     * 0.0000000001
      180       p-shift-end-fact-order = v-fact-date-num
      181                              + v-shift-offset * 0.5
      182                              + p-shift-num    * 0.02
      183       p-day-end-fact-order   = v-fact-date-num
      184                              + 0.99
      185     .
      186     if p-fact-order           <= v-fact-date-num
      187     or p-shift-end-fact-order <= v-fact-date-num
      188     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      189     or p-shift-end-fact-order >= p-day-end-fact-order
      190     then do:
      191       message
      192         vss-workfile vss-revision vss-description skip
      193         "Внутренняя ошибка при генерации фактического номера" skip
      194         "p-fact-date"            p-fact-date            skip
      195         "p-fact-time"            p-fact-time            skip
      196         "p-fact-num"             p-fact-num             skip
      197         "p-shift-date"           p-shift-date           skip
      198         "p-shift-num"            p-shift-num            skip
      199         "p-shift-on"             p-shift-on             skip
      200         "p-shift-end-fact-order" p-shift-end-fact-order skip
      201         "p-day-end-fact-order"   p-day-end-fact-order   skip
      202         "v-fact-date-num"        v-fact-date-num        skip
      203         view-as alert-box error .
      204       undo, return error return-value .
      205     end.
      206   end procedure.
      207   procedure day-begin-fact-order :
      208     define input  parameter p-fact-date            as date    no-undo .
      209     define output parameter p-day-begin-fact-order as decimal no-undo .
      210     do
      211     on error undo, return error return-value
      212     :
      213       if p-fact-date = ?
      214       then do:
      215         assign
      216           p-day-begin-fact-order = 0
      217         .
      218       end.
      219       else do:
      220         assign
      221           p-day-begin-fact-order = integer(p-fact-date)
      222         .
      223       end.
      224     end.
      225   end procedure.
      226   procedure factord-max-fact-order :
      227     define output parameter p-max-fact-order as decimal   no-undo .
      228     do
      229     on error undo, return error return-value
      230     :
      231       run day-begin-fact-order in this-procedure
      232         (input  date(1, 1, 5000)
      233         ,output p-max-fact-order
      234         ) .
      235     end.
      236   end procedure.
      237   procedure factord-cut-archive :
      238     define input  parameter p-obj-type             as character no-undo .
      239     define input  parameter p-obj-code             as integer   no-undo .
      240     define input  parameter p-fact-date            as date      no-undo .
      241     define output parameter p-shift-on             as logical   no-undo .
      242     define output parameter p-shift-date           as date      no-undo .
      243     define output parameter p-shift-num            as integer   no-undo .
      244     define output parameter p-day-end-fact-order   as decimal   no-undo .
      245     define output parameter p-shift-end-fact-order as decimal   no-undo .
      246     define variable v-fact-order as decimal   no-undo .
      247     define buffer buf_shift-obj for ub.shift-obj .
      248     do
      249     on error undo, return error return-value
      250     :
      251   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      252   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      253     (input  p-obj-type
      254     ,input  p-obj-code
      255     ,input  'shift-on=request'
      256     ,output p-shift-on
      257     ) no-error .
      258       if error-status :error
      259       then do:
      260         message
      261           vss-workfile vss-revision vss-description skip
      262           "Ошибка при определении атрибута объекта" skip
      263           "Объект" p-obj-type p-obj-code skip
      264           error-status :get-message(1) skip
      265           return-value skip
      266           view-as alert-box error .
      267         undo, return error return-value .
      268       end.
      269       if p-shift-on = false
      270       then do:
      271         assign
      272           p-shift-date               = ?
      273           p-shift-num                = 0
      274         .
      275       end.
      276       else do:
      277         find first buf_shift-obj share-lock
      278           where buf_shift-obj.obj-type   = p-obj-type
      279             and buf_shift-obj.obj-code   = p-obj-code
      280             and buf_shift-obj.shift-date > p-fact-date
      281           use-index pi
      282           no-error .
      283         if not available buf_shift-obj
      284         or buf_shift-obj.status_ <> 'зкр':U
      285         then do:
      286           message
      287             vss-workfile vss-revision vss-description skip
      288             "Невозможно вычислить последнюю смену" skip
      289             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      290             "Объект" p-obj-type p-obj-code skip
      291             "Дата" p-fact-date skip
      292             view-as alert-box error .
      293           undo, return error return-value .
      294         end.
      295         find last buf_shift-obj share-lock
      296           where buf_shift-obj.obj-type = p-obj-type
      297             and buf_shift-obj.obj-code = p-obj-code
      298             and buf_shift-obj.shift-date <= p-fact-date
      299           use-index pi
      300           no-error .
      301         if available buf_shift-obj
      302         then do:
      303           if  buf_shift-obj.status_ = 'зкр':U
      304           then do:
      305             assign
      306               p-shift-date = buf_shift-obj.shift-date
      307               p-shift-num  = buf_shift-obj.shift-num
      308             .
      309           end.
      310           else do:
      311             message
      312               vss-workfile vss-revision vss-description skip
      313               "Невозможно вычислить последнюю смену" skip
      314               "Статус смены отличен от статуса" 'зкр':U skip
      315               "Объект" p-obj-type p-obj-code skip
      316               "Дата" p-fact-date skip
      317               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      318               view-as alert-box error .
      319             undo, return error return-value .
      320           end.
      321         end.
      322         else do:
      323           assign
      324             p-shift-date = p-fact-date - 1
      325             p-shift-num  = 1
      326           .
      327         end.
      328       end.
      329       run factord in this-procedure
      330         (input  p-fact-date
      331         ,input  1
      332         ,input  1
      333         ,input  p-shift-date
      334         ,input  p-shift-num
      335         ,input  p-shift-on
      336         ,output v-fact-order
      337         ,output p-shift-end-fact-order
      338         ,output p-day-end-fact-order
      339         ) no-error .
      340       if error-status :error
      341       then do:
      342         message
      343           vss-workfile vss-revision vss-description skip
      344           "Ошибка при вызове процедуры factord"
      345           error-status :get-message(1) skip
      346           return-value skip
      347           view-as alert-box error .
      348         undo, return error return-value .
      349       end.
      350     end.
      351   end procedure.
      352   procedure factord-lock-shift :
      353     define input  parameter p-obj-type  as character no-undo .
      354     define input  parameter p-obj-code  as integer   no-undo .
      355     define input  parameter p-fact-date as date      no-undo .
      356     define parameter buffer buf_shift-obj for ub.shift-obj .
      357     define variable v-shift-on      as logical   no-undo .
      358     define variable v-extra-message as character no-undo .
      359     define variable v-error as character no-undo .
      360     do
      361     on error undo, return error return-value
      362     :
      363   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      365     (input  p-obj-type
      366     ,input  p-obj-code
      367     ,input  'shift-on=request'
      368     ,output v-shift-on
      369     ) no-error .
      370       if error-status :error
      371       then do:
      372         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      373         undo, return error v-error .
      374       end.
      375       if v-shift-on = true
      376       then do:
      377         find first buf_shift-obj share-lock
      378           where buf_shift-obj.obj-type   = p-obj-type
      379             and buf_shift-obj.obj-code   = p-obj-code
      380             and buf_shift-obj.shift-date > p-fact-date
      381           use-index pi
      382           no-error .
      383         if not available buf_shift-obj
      384         or buf_shift-obj.status_ <> 'зкр':U
      385         then do:
      386           find last buf_shift-obj
      387             where buf_shift-obj.obj-type = p-obj-type
      388               and buf_shift-obj.obj-code = p-obj-code
      389               and buf_shift-obj.status_  = 'зкр':U
      390             use-index stts
      391             no-error .
      392           if available buf_shift-obj
      393           then do:
      394             assign
      395               v-extra-message =
      396                     substitute("Дата начала последеней закрытой смены на объекте &1"
      397                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      398                               )
      399             .
      400           end.
      401           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      402           undo, return error v-error .
      403         end.
      404       end.
      405     end.
      406   end procedure.
      407   procedure factord-end-day :
      408     define input  parameter p-fact-date            as date    no-undo .
      409     define output parameter p-day-end-fact-order   as decimal no-undo .
      410     do
      411     on error undo, return error return-value
      412     :
      413       if p-fact-date = ?
      414       then do:
      415         return error "Не указана фактическая дата" .
      416       end.
      417       assign
      418         p-day-end-fact-order = integer(p-fact-date) + 0.99
      419       .
      420     end.
      421   end procedure.
      422   procedure factord-to-date :
      423     define input  parameter p-fact-order as decimal no-undo .
      424     define output parameter p-fact-date  as date    no-undo .
      425     define variable v-ref-date  as date      no-undo .
      426     define variable v-ref-delta as integer   no-undo .
      427     do
      428     on error undo, return error return-value
      429     :
      430       if p-fact-order = ?
      431       or p-fact-order = 0
      432       then do:
      433         return error "Не указан fact-order" .
      434       end.
      435       assign
      436         v-ref-date  = date(1, 1, 2000)
      437       .
      438       assign
      439         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      440       .
      441       assign
      442         p-fact-date = v-ref-date + v-ref-delta
      443       .
      444     end.
      445   end procedure.
      446   procedure factord-to-fact-num :
      447     define input  parameter p-fact-order as decimal no-undo .
      448     define output parameter p-fact-num   as integer no-undo .
      449     define variable v-fact-order-trunc as decimal no-undo .
      450     do
      451     on error undo, return error return-value
      452     :
      453       if p-fact-order = ?
      454       or p-fact-order = 0
      455       then do:
      456         return error "Не указан fact-order" .
      457       end.
      458       assign
      459        v-fact-order-trunc = truncate(p-fact-order, 2)
      460       .
      461       assign
      462         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      463       .
      464     end.
      465   end procedure.
      466   procedure factord-to-shift-num :
      467     define input  parameter p-fact-order as decimal no-undo .
      468     define output parameter p-shift-num   as integer no-undo .
      469     define variable  p-shift-numd  as decimal   no-undo .
      470     define variable v-fact-order-trunc as decimal no-undo .
      471     do
      472     on error undo, return error return-value
      473     :
      474       if p-fact-order = ?
      475       or p-fact-order = 0
      476       then do:
      477         return error "Не указан fact-order" .
      478       end.
      479       assign
      480        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      481       .
      482       if v-fact-order-trunc < 0.5 then do:
      483         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      484       end.
      485       assign
      486         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      487         .
      488        assign
      489         p-shift-num = truncate (p-shift-numd , 0)
      490       .
      491     end.
      492   end procedure.
      493   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   procedure cur-time :
      495      define output parameter p-today as date      no-undo .
      496      define output parameter p-time  as integer   no-undo .
      497     do
      498     on error undo, return error
      499     :
      500       define variable v-date1 as date      no-undo .
      501       define variable v-date2 as date      no-undo .
      502       define variable v-time  as integer   no-undo .
      503       assign
      504         v-date1 = today
      505         v-time  = time
      506         v-date2 = today
      507       .
      508       if v-date1 <> v-date2
      509       then do:
      510         assign
      511           v-date1 = today
      512           v-time  = v-time
      513         .
      514       end.
      515       assign
      516         p-today = v-date1
      517         p-time  = v-time
      518       .
      519     end.
      520   end.
      521   function cur-time-date returns character
      522   :
      523     return string(today, '99/99/9999':U) .
      524   end.
      525   function cur-time-mjd returns decimal
      526   :
      527     define variable v-date as date      no-undo .
      528     define variable v-time as integer   no-undo .
      529     run cur-time in this-procedure
      530       (output v-date
      531       ,output v-time
      532       ) .
      533     return integer(v-date) - 2400002 + (v-time / 86400) .
      534   end.
      535   function cur-time-get-ending-index returns integer
      536   (input p-number as integer
      537   )
      538   :
      539     if p-number < 0
      540     or p-number = ?
      541     then do:
      542       return 1 .
      543     end.
      544     define variable v-rest as integer   no-undo .
      545     assign
      546       p-number = p-number modulo 100
      547     .
      548     if p-number < 20
      549     then do:
      550       assign
      551         v-rest = p-number
      552       .
      553     end.
      554     else do:
      555       assign
      556         v-rest = p-number modulo 10
      557       .
      558     end.
      559     case v-rest :
      560       when 1
      561       then do:
      562         return 2 .
      563       end.
      564       when 2 or
      565       when 3 or
      566       when 4
      567       then do:
      568         return 3 .
      569       end.
      570       otherwise do:
      571         return 1 .
      572       end.
      573     end case .
      574   end.
      575   procedure cur-time-mjd-to-date :
      576      define input  parameter i-mjd-diff as decimal no-undo.
      577      define output parameter o-Date     as date    no-undo.
      578      define output parameter o-Time     as integer no-undo.
      579      define variable v-day-number as integer   no-undo .
      580      if    i-mjd-diff < 0
      581         or i-mjd-diff = ?
      582      then do:
      583         return "?" .
      584      end.
      585      assign
      586         v-day-number = truncate(i-mjd-diff,0).
      587         o-Date = date(v-day-number + 2400002).
      588         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      589     .
      590   end.
      591   function cur-time-mjd-to-string returns character
      592   (input p-mjd-diff as decimal
      593   )
      594   :
      595     define variable v-day-number as integer   no-undo .
      596     define variable v-seconds    as integer   no-undo .
      597     define variable v-hour       as integer   no-undo .
      598     define variable v-min        as integer   no-undo .
      599     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      600     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      601     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      602     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      603     if p-mjd-diff < 0
      604     or p-mjd-diff = ?
      605     then do:
      606       return "?" .
      607     end.
      608     assign
      609       v-day-number = integer(truncate(p-mjd-diff,0))
      610       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      611     .
      612     if v-seconds > 86400
      613     then do:
      614       assign
      615         v-seconds = 86400 - 1
      616       .
      617     end.
      618     if v-seconds < 0
      619     then do:
      620       assign
      621         v-seconds = 0
      622       .
      623     end.
      624     assign
      625       v-hour = truncate(v-seconds / 3600, 0)
      626     .
      627     assign
      628       v-seconds = v-seconds modulo 3600
      629     .
      630     assign
      631       v-min = truncate(v-seconds / 60, 0)
      632     .
      633     assign
      634       v-seconds = v-seconds modulo 60
      635     .
      636     return
      637         (if v-day-number <> 0
      638           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      639           else ""
      640         )
      641       + (if v-day-number <> 0 or v-hour <> 0
      642           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      643           else ""
      644         )
      645       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      646           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      647           else ""
      648         )
      649       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      650       .
      651   end.
      652   function cur-time-string returns character
      653   :
      654     define variable v-date as date      no-undo .
      655     define variable v-time as integer   no-undo .
      656     run cur-time in this-procedure
      657       (output v-date
      658       ,output v-time
      659       ) .
      660     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      661   end.
      662   function cur-time-string-sec returns character
      663   :
      664     define variable v-date as date      no-undo .
      665     define variable v-time as integer   no-undo .
      666     run cur-time in this-procedure
      667       (output v-date
      668       ,output v-time
      669       ) .
      670     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      671   end.
      672   function cur-time-custom  returns character
      673   (input p-prefix as character
      674   ,input p-date-format as character
      675   ,input p-delimiter as character
      676   ,input p-time-format as character
      677   ,input p-suffix as character
      678   )
      679   :
      680     define variable v-date as date      no-undo .
      681     define variable v-time as integer   no-undo .
      682     run cur-time in this-procedure
      683       (output v-date
      684       ,output v-time
      685       ) .
      686     return
      687       p-prefix
      688       + string(v-date, p-date-format)
      689       + p-delimiter
      690       + string(v-time, p-time-format)
      691       + p-suffix
      692       .
      693   end.
      694   function cur-time-print  returns character
      695   :
      696     define variable v-date as date      no-undo .
      697     define variable v-time as integer   no-undo .
      698     run cur-time in this-procedure
      699       (output v-date
      700       ,output v-time
      701       ) .
      702     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      703   end.
      704   function cur-time-datetime returns datetime
      705   :
      706     define variable v-char as character no-undo .
      707     define variable v-datetime as datetime no-undo .
      708     v-char = cur-time-string().
      709     v-datetime = datetime(v-char).
      710     return  v-datetime.
      711   end.
      712   function cur-time-string-msec returns character
      713   :
      714     define variable v-date as datetime  no-undo .
      715     v-date = now.
      716     return string(v-date) .
      717   end.
      718   procedure proc-alt-shift-f2:
      719     if not ibs.th.gbl.gbl-var:rcode
      720   then
      721     run gbl\inidebug.p .
      722   end.
      723   procedure proc-alt-shift-f3:
      724     run gbl/prvssinf.p
      725       ( input this-procedure
      726       ) .
      727   end.
      728   define variable v-inform-launched as logical no-undo initial false .
      729   procedure proc-alt-shift-f4:
      730     define variable v-action as character no-undo .
      731     if v-inform-launched = false then do:
      732       assign
      733         v-inform-launched = true
      734       .
      735       run gbl/d-inform.w
      736         (  input self
      737         ,  input this-procedure
      738         , output v-action
      739         ) no-error .
      740       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      741       assign
      742         v-inform-launched = false
      743       .
      744     end.
      745   end.
      746   procedure proc-alt-f1:
      747     run gbl/corrhelp.p
      748       (input this-procedure
      749       ) .
      750   end .
      751   on alt-shift-f2 anywhere do:
      752     run proc-alt-shift-f2.
      753   end.
      754   on alt-shift-f3 anywhere do:
      755     run proc-alt-shift-f3 in this-procedure .
      756   end.
      757   on alt-shift-f4 anywhere do:
      758     run proc-alt-shift-f4 in this-procedure.
      759   end.
      760   on alt-f1 anywhere do:
      761     run proc-alt-f1 in this-procedure .
      762   end.
