      976       if NOT glog then return no-apply .
      977       ri = ?.
      978       run ref/taxesi.w ( 'ДОБАВЛЕНИЕ':U, input-output ri ).
      979       if ri <> ? then do:
      980           OPEN QUERY br-taxes FOR EACH ub.tax NO-LOCK.
      981           reposition br-taxes to recid ri.
      982           apply "ENTRY" to br-taxes.
      983       end.
