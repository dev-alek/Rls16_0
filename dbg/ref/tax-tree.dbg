      985   ON CHOOSE OF B-addtax-rate IN FRAME Dialog-Frame
      986   DO:
      987      if ref-mode = "ALL-TAX-RATES":U then return no-apply.
      988   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      989   do:
      990     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      991       (input  v-cntxt-db-num
