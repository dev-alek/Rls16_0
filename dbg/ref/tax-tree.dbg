     1283   ON CHOOSE OF B-marktax-rate IN FRAME Dialog-Frame
     1284   DO:
     1285     if available ub.tax-rate then do:
     1286   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   define variable v-str-recid15 as character no-undo .
     1288   define variable v-num-entry15 as integer   no-undo .
     1289   assign
     1290     v-str-recid15 = trim( string( recid( ub.tax-rate ) , "->>>>>>>>>>>9":U ) )
     1291     v-num-entry15 = lookup( v-str-recid15 , v-tax-rate-rid )
     1292   .
     1293   if v-num-entry15 > 0 then do:
     1294     assign
     1295       entry( v-num-entry15, v-tax-rate-rid ) = "":U
     1296       v-tax-rate-rid = trim( replace( v-tax-rate-rid , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1297     .
     1298   end.
     1299   else do:
     1300     assign
     1301       v-tax-rate-rid = v-tax-rate-rid + ( if v-tax-rate-rid = "":U then "":U else chr(44) ) + v-str-recid15
     1302     .
     1303   end.
     1304       glog = br-tax-rate:refresh() .
     1305       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     1306         glog = br-tax-rate:select-next-row ().
     1307         apply "Value-changed" to br-tax-rate in frame Dialog-Frame.
     1308       end.
     1309       if num-entries( v-tax-rate-rid ) = 0
     1310       then
     1311       hide mark-numtax-rate in frame Dialog-Frame.
     1312       else
     1313       disp num-entries( v-tax-rate-rid ) @ mark-numtax-rate with frame Dialog-Frame.
     1314     end.
     1315     apply "entry" to br-tax-rate in frame Dialog-Frame.
     1316   END.
