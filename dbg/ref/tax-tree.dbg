      960     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      961       (input  v-cntxt-db-num
      962       ,input  v-cntxt-userid
      963       ,input  0
      964       ,input  'actn_tax-kinds_update':U
      965       ,input  'global':U
      966       ,input  0
      967       ,input  '':U
      968       ,input  0
