      515   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      516   procedure minbtn-set :
      517       do
      518           on error undo, return error return-value
      519           :
      520           define variable ii              as integer       no-undo .
      521           define variable fh              as widget-handle no-undo .
      522           define variable hh              as widget-handle no-undo .
      523           define variable v-h             as handle        extent 4 no-undo .
      524           define variable v-name-button   as character     no-undo .
      525           define variable v-help-old-x    as decimal       no-undo .
      526           define variable v-help-old-y    as decimal       no-undo .
      527           define variable v-help-old-size as decimal       no-undo .
      528           define variable v-frame-width   as decimal       no-undo .
      529           define variable jj              as integer       no-undo .
      530           do
      531               on error undo, return error
      532               :
      533               assign
      534                   v-frame-width = frame Dialog-Frame:width - 0.3
      535                   fh            = frame Dialog-Frame:first-child
      536                   hh            = fh:first-child
      537                   ii            = 1
      538                   .
      539               do while valid-handle(hh):
      540                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      541                   do:
      542                       case lc(hh:name) :
      543                           when "b-help" then
      544                               do:
      545                                   hh:load-image-up("cmp/b-help.bmp":u) .
      546                                   hh:load-image-down("cmp/b-help.bmp":u) .
      547                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      548                                   hh:TOOLTIP = "Помощь" .
      549                                   v-help-old-x = hh:column .
      550                                   v-help-old-y = hh:row    .
      551                                   v-help-old-size = hh:width .
      552                                   hh:width-chars = 2.5 .
      553                               end.
      554                           when "b-print" then
      555                               do:
      556                                   hh:load-image("cmp/b-print.bmp":u) .
      557                                   hh:TOOLTIP = "Печать" .
      558                                   v-h[ii] = hh:handle .
      559                                   ii = ii + 1 .
      560                                   hh:width-chars = 3 .
      561                               end.
      562                           when "b-history" or
      563                           when "b-hist" then
      564                               do:
      565                                   hh:load-image("cmp/b-hist.bmp":u) .
      566                                   hh:TOOLTIP = "История" .
      567                                   v-h[ii] = hh:handle .
      568                                   ii = ii + 1 .
      569                                   hh:width-chars = 3 .
      570                               end.
      571                           when "b-sch" then
      572                               do:
      573                                   hh:load-image("cmp/b-sch.bmp":u) .
      574                                   hh:TOOLTIP = "Установка Фильтра" .
      575                                   v-h[ii] = hh:handle .
      576                                   ii = ii + 1 .
      577                                   hh:width-chars = 3 .
      578                               end.
      579                           when "b-hist-user" then
      580                               do:
      581                                   hh:load-image("cmp/b-hist.bmp":u) .
      582                                   hh:TOOLTIP = "История пользователя" .
      583                                   ii = ii + 1 .
      584                               end.
      585                       end case.
      586                   end.
      587                   hh = hh:next-sibling.
      588               end.
      589               b-help:column = v-frame-width - b-help:width-chars.
      590               jj = 0.
      591               repeat ii = 4 to 1 by -1 :
      592                   if valid-handle (v-h[ii] ) then
      593                   do:
      594                       jj  = jj + 1 .
      595                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      596                       v-h[ii]:row    = v-help-old-y .
      597                   end.
      598               end.
      599           end.
      600       end.
      601   end procedure.
      602   MAIN-BLOCK:
      603   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      604      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      605    if p-mode  <> 'ПРОСМОТР':U
      606    then do:
      607       message
      608       vss-workfile vss-revision vss-description skip
      609       "Неверное значение параметров вызова p-mode"  p-mode
      610       view-as alert-box ERROR.
      611       undo, return error.
      612    end.
      613   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      614   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      615     (output v-db-num
      616     )  .
      617     for each tt-c-fin-bank:
      618         delete tt-c-fin-bank.
      619     end.
      620     find first locked_c-fin-bank no-lock where
      621                     recid(locked_c-fin-bank) = p-doc-rec.
      622     if not available locked_c-fin-bank then do:
      623     message
      624     vss-workfile vss-revision vss-description skip
      625     "Не найдена запись БАНК"
      626     view-as alert-box error .
      627     undo, return error.
      628     end.
      629     create tt-c-fin-bank.
      630     buffer-copy locked_c-fin-bank to tt-c-fin-bank.
      631     RUN MYEnable.
      632     WAIT-FOR GO OF FRAME Dialog-Frame.
      633   END.
      634   RUN disable_UI.
      635   PROCEDURE disable_UI :
      636     HIDE FRAME Dialog-Frame.
      637   END PROCEDURE.
      638   PROCEDURE enable_UI :
      639     OPEN QUERY Dialog-Frame FOR EACH tt-c-fin-bank SHARE-LOCK.
      640     GET FIRST Dialog-Frame.
      641     DISPLAY f-host-name
      642         WITH FRAME Dialog-Frame.
      643     IF AVAILABLE tt-c-fin-bank THEN
      644       DISPLAY tt-c-fin-bank.host-code tt-c-fin-bank.code-bank tt-c-fin-bank.bik
      645             tt-c-fin-bank.inn tt-c-fin-bank.kpp tt-c-fin-bank.cor-acc
      646             tt-c-fin-bank.bank-name tt-c-fin-bank.short-name tt-c-fin-bank.licenz
      647             tt-c-fin-bank.otdel tt-c-fin-bank.bank-city tt-c-fin-bank.addres
      648             tt-c-fin-bank.addres1 tt-c-fin-bank.phone tt-c-fin-bank.fax
      649             tt-c-fin-bank.e-mail tt-c-fin-bank.okato tt-c-fin-bank.okonx
      650             tt-c-fin-bank.okpo tt-c-fin-bank.PS
      651         WITH FRAME Dialog-Frame.
      652     ENABLE b-quit B-exit B-Help tt-c-fin-bank.bik tt-c-fin-bank.inn
      653            tt-c-fin-bank.kpp tt-c-fin-bank.cor-acc tt-c-fin-bank.bank-name
      654            tt-c-fin-bank.short-name tt-c-fin-bank.licenz tt-c-fin-bank.otdel
      655            tt-c-fin-bank.bank-city tt-c-fin-bank.addres tt-c-fin-bank.addres1
      656            tt-c-fin-bank.phone tt-c-fin-bank.fax tt-c-fin-bank.e-mail
      657            tt-c-fin-bank.okato tt-c-fin-bank.okonx tt-c-fin-bank.okpo
      658            tt-c-fin-bank.PS
      659         WITH FRAME Dialog-Frame.
      660     VIEW FRAME Dialog-Frame.
      661   END PROCEDURE.
      662   PROCEDURE MyEnable :
      663   tt-c-fin-bank.okonx:label in frame Dialog-Frame = "ОКОНХ".
      664   tt-c-fin-bank.inn:label in frame Dialog-Frame = "ИНН".
      665   tt-c-fin-bank.kpp:label in frame Dialog-Frame = "КПП".
      666   find first X_clients no-lock where
      667               X_clients.obj-type = 'орг':U
      668           AND X_clients.obj-code = p-host-code.
      669     DISPLAY
      670     X_clients.obj-name @  f-host-name
      671      WITH FRAME Dialog-Frame.
      672   ENABLE
      673   b-quit
      674   B-exit
      675   B-Help
      676   WITH FRAME Dialog-Frame.
      677   IF AVAILABLE tt-c-fin-bank THEN
      678   DISPLAY
      679   tt-c-fin-bank.bank-city
      680   tt-c-fin-bank.host-code
      681   tt-c-fin-bank.code-bank
      682   tt-c-fin-bank.bik
      683   tt-c-fin-bank.inn
      684   tt-c-fin-bank.kpp
      685   tt-c-fin-bank.cor-acc
      686   tt-c-fin-bank.bank-name
      687   tt-c-fin-bank.short-name
      688   tt-c-fin-bank.licenz
      689   tt-c-fin-bank.otdel
      690   tt-c-fin-bank.addres
      691   tt-c-fin-bank.addres1
      692   tt-c-fin-bank.phone
      693   tt-c-fin-bank.fax
      694   tt-c-fin-bank.e-mail
      695   tt-c-fin-bank.okato
      696   tt-c-fin-bank.okonx
      697   tt-c-fin-bank.okpo
      698   tt-c-fin-bank.PS
      699   WITH FRAME Dialog-Frame .
      700   if p-mode = 'ПРОСМОТР':U then do:
      701     assign
      702     b-quit:label = "&Выход"
      703     .
      704     hide
      705     b-exit in frame Dialog-Frame .
      706   end.
      707   VIEW FRAME Dialog-Frame.
      708   END PROCEDURE.
