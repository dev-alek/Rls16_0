        1   DEFINE BUFFER locked_c-fin-bank FOR ub.c-fin-bank.
        2   DEFINE TEMP-TABLE tt-c-fin-bank NO-UNDO LIKE ub.c-fin-bank.
        3   DEFINE BUFFER X_clients FOR ub.clients.
        4   DEFINE BUFFER X_sysconf FOR ub.sysconf.
        5   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        6   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
        7   define input parameter p-mode as character no-undo.
        8   define input parameter p-host-code like ub.c-fin-bank.host-code no-undo.
        9   define input parameter p-code-bank like ub.c-fin-bank.code-bank no-undo.
       10   define input parameter p-corr-user-db-num like ub.c-fin-bank.corr-user-db-num no-undo .
       11   define input parameter p-chip-num  like ub.c-fin-bank.chip-num  no-undo .
       12   define input-output parameter p-doc-rec as recid no-undo.
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Карточка редактирования банка".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define variable v-db-num like ub.db.db-num no-undo.
       74   define buffer X_curr_sysconf for ub.sysconf.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
