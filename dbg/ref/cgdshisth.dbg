     3130     then do:
     3131       ASSIGN
     3132         sch-corr-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date21 :HANDLE
     3133         sch-corr-date :MENU-MOUSE in frame Dialog-Frame = 3
     3134       .
     3135     end.
