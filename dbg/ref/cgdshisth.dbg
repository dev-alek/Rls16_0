     2939   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2940   on ' ' of sch-corr-date in frame Dialog-Frame
     2941   do:
     2942     if (can-query (self, "sensitive")
     2943        and
     2944        self :sensitive = true
     2945        )
     2946     or (can-query (self, "read-only")
     2947        and
     2948        self :read-only = false
     2949        )
     2950     then do:
     2951       assign
     2952         self :screen-value = ?
     2953       .
     2954     end.
     2955     return no-apply.
     2956   end.
     2957   on delete-character of sch-corr-date in frame Dialog-Frame
     2958   do:
     2959     if (can-query (self, "sensitive")
     2960        and
     2961        self :sensitive = true
     2962        )
     2963     or (can-query (self, "read-only")
     2964        and
     2965        self :read-only = false
     2966        )
     2967     then do:
