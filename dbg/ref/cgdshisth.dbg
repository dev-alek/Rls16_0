     5657           apply "choose" to b-mark in frame Dialog-Frame.
     5658       end.
     5659       else do:
     5660           apply "choose" to b-sel in frame Dialog-Frame.
     5661       end.
     5662   end.
     5663   else do:
     5664       if b-lookup:sensitive then
     5665       apply "choose" to b-lookup in frame Dialog-Frame.
     5666   end.
     5667   END PROCEDURE.
     5668   PROCEDURE proc-find-corr-date :
     5669   define input parameter p-next as logical no-undo.
     5670   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5671   define variable v-date-chr as character no-undo.
     5672   if p-date = ? then return .
     5673   display
     5674   0 @ sch-gds-code
     5675   0 @ sch-db-num
     5676   "":U @ sch-corr-user-name
     5677   with frame Dialog-Frame.
     5678   assign
     5679   v-date-chr = string(day(p-date)) + chr(47) +
     5680                    string(month(p-date)) + chr(47) +
     5681                    string(year(p-date)).
     5682          run OpenBr in this-procedure
     5683           (input false
     5684           ,input true
     5685           ,input substitute("and X_c-gds-hist.corr-date = &1 "
     5686             , v-date-chr)
     5687           ,input v-corr-user-db-num
     5688           ).
     5689         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     5690   END PROCEDURE.
     5691   PROCEDURE proc-find-db-num :
     5692   define input parameter p-next as logical no-undo.
     5693   define input parameter p-db-num like ub.c-gds-hist.corr-user-db-num no-undo.
     5694   define variable v-db-num as character no-undo.
     5695   assign
     5696   sch-corr-date = ?
     5697   .
     5698   display
     5699   "":U @ sch-corr-user-name
     5700   0 @ sch-gds-code
     5701   sch-corr-date
     5702   with frame Dialog-Frame.
     5703   assign
     5704   v-db-num = string(p-db-num).
     5705   run OpenBr in this-procedure
     5706       (input false
     5707       ,input p-next
     5708       ,input substitute("and X_c-gds-hist.corr-user-db-num = &1 "
     5709         , v-db-num)
     5710       ,input v-corr-user-db-num
     5711       ).
     5712   apply "entry":u to sch-db-num in frame Dialog-Frame .
     5713   END PROCEDURE.
     5714   PROCEDURE proc-find-gds-code :
     5715   define input parameter p-next as logical no-undo.
     5716   define input parameter p-gds-code like ub.c-gds-hist.gds-code no-undo.
     5717   define variable v-gds-code as character no-undo.
     5718   assign
     5719   sch-corr-date = ?.
     5720   display
     5721   "":U @ sch-corr-user-name
     5722   0 @ sch-db-num
     5723   sch-corr-date
     5724   with frame Dialog-Frame.
     5725   assign
     5726   v-gds-code = string(p-gds-code).
     5727   run OpenBr in this-procedure
     5728       (input false
     5729       ,input p-next
     5730       ,input substitute("and X_c-gds-hist.gds-code = &1 "
     5731         , v-gds-code)
     5732       ,input v-corr-user-db-num
     5733       ).
     5734   apply "entry":u to sch-gds-code in frame Dialog-Frame .
     5735   END PROCEDURE.
     5736   PROCEDURE proc-find-user :
     5737   define input parameter p-next as logical no-undo.
     5738   define input parameter p-user like ub.c-gds-hist.corr-user-name no-undo.
     5739   assign
     5740   sch-corr-date = ?.
     5741   display
     5742   0 @ sch-db-num
     5743   sch-corr-date
     5744   0 @ sch-gds-code
     5745   with frame Dialog-Frame.
     5746   p-user = chr(34) + p-user + chr(34).
     5747   run OpenBr in this-procedure
     5748       (input false
     5749       ,input p-next
     5750       ,input substitute("and X_c-gds-hist.corr-user-name = &1 "
     5751         , p-user)
     5752       ,input v-corr-user-db-num
     5753       ).
     5754   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     5755   END PROCEDURE.
     5756   PROCEDURE proc-view-changes :
     5757   define variable v-description as character no-undo .
     5758   for each temp-changes:
     5759       delete temp-changes.
     5760   END.
     5761   if not available X_c-gds-hist then do:
     5762     Open QUery br-changes for each temp-changes.
     5763     return.
     5764   end.
     5765   run ref/cgdshisv.p (
     5766                      input X_c-gds-hist.gds-code
     5767                     ,input X_c-gds-hist.chip-num
     5768                     ,input X_c-gds-hist.corr-user-db-num
     5769                     ,input X_c-gds-hist.host-code
     5770                     ,input X_c-gds-hist.obj-type
     5771                     ,input X_c-gds-hist.obj-code
     5772                     ,input X_c-gds-hist.subject
     5773                     ,input X_c-gds-hist.action
     5774                     ,input no
     5775                     ,input "":U
     5776                     ,output v-description
     5777                  ) no-error .
     5778   Open QUery br-changes for each temp-changes.
     5779   assign
     5780   br-changes:title in frame Dialog-Frame = v-description
     5781   .
     5782   END PROCEDURE.
     5783   FUNCTION get-action RETURNS CHARACTER
     5784     ( p-action as integer ) :
     5785     define variable dops as character no-undo.
     5786   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     5787   RETURN dops.
     5788   END FUNCTION.
     5789   FUNCTION get-good RETURNS CHARACTER
     5790     ( p-gds-code as integer, output p-artic as character, output p-prod-type as character, output p-prod-code as integer ) :
     5791   define buffer buf_goods for ub.goods.
     5792   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error.
     5793   if not available buf_goods then do:
     5794       return "!!! Неизвестный товар!!!".
     5795   end.
     5796   assign
     5797   p-artic =  buf_goods.artic
     5798   p-prod-type =  buf_goods.prod-type
     5799   p-prod-code =  buf_goods.prod-code
     5800   .
     5801     RETURN buf_goods.gds-name.
     5802   END FUNCTION.
     5803   FUNCTION get-source-type RETURNS CHARACTER
     5804     ( p-source-type as character ) :
     5805   define variable v-dop as character no-undo .
     5806   assign
     5807   v-dop =  entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U) no-error
     5808   .
     5809     RETURN v-dop .
     5810   END FUNCTION.
     5811   FUNCTION get-subject RETURNS CHARACTER
     5812     ( p-subject as character ) :
     5813   define variable v-return as character no-undo .
     5814   assign
     5815   v-return =  entry (lookup (p-subject, 'goods,goods-attr,gds-host-attr,gds-obj-attr,fbr-gds-obj,s-coeff,bar-code,bar-code-attr,bar-code-obj-attr,prod-bc,varianty-delivery-gds-obj,gds-season,tax-rate-gds,assortment-matrix-goods,gds-obj-prop,pl-gds,pl-gds-pump,sert-join,pl-gds-attr,dis-gds-rule,ext-artic,ext-classif,recipe,recipe-gds,gds-obj,gds-obj-prop-attr':U), 'Товар,Атр-т товара,Атр-т тов. на фирме,Атр-т тов. на объекте,Атрибут РЕСТОРАНа,Сезонный коэфф,Бар-код,Атрибуты бар-кодов,Атрибуты бар-кода на объекте,ДопБК,Варианты доставки,Сезон товара,Ставки налогов,Содержимое ассортиментных матр,Индикаторы,Товар на складском месте,Товар на ТРК,Сертификат на товар,АттрТовара на скл.месте,Скидка Товара на объ.,Внешний артикул товара,Внешний классификатор,Рецепт,Товар рецепта,Товар на объекте,Атр-т тов. для заказов':U) no-error.
     5816   if error-status:error then  do:
     5817     message error-status:get-message(1) view-as alert-box .
     5818     RETURN p-subject.
     5819   end.
     5820   else return v-return.
     5821   END FUNCTION.
