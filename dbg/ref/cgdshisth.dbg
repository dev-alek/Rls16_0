     3031           self :screen-value = string(v-new-sv-date) .
     3032         .
     3033       end.
     3034     end.
     3035     return no-apply .
     3036   end.
     3037   on ctrl-e of sch-corr-date in frame Dialog-Frame
     3038   do:
