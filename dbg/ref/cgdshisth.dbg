     5547         get-action(X_c-gds-hist.action) @ v-action-chr
     5548         (if v-find then get-good(X_c-gds-hist.gds-code, output v-artic, output v-prod-type, output v-prod-code) else "":U )
     5549         @ v-gds-name
     5550         v-artic
     5551         (v-prod-type + string(v-prod-code)) @ v-prod
     5552         get-subject(X_c-gds-hist.subject) @ v-subject-chr
     5553         X_c-gds-hist.is-news
     5554         get-source-type(X_c-gds-hist.source-type) @ v-source-type
     5555         X_c-gds-hist.source-ref
     5556         X_c-gds-hist.corr-date
     5557         string(X_c-gds-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
