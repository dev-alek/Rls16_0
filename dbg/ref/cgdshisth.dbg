     3137     assign
     3138       v-label-handle21 = sch-corr-date :side-label-handle in frame Dialog-Frame
     3139     .
     3140     if valid-handle (v-label-handle21)
     3141     then do:
     3142       if v-label-handle21 :tooltip = ""
     3143       or v-label-handle21 :tooltip = ?
     3144       then do:
     3145         assign
     3146           v-label-handle21 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     3147         .
     3148       end.
     3149     end.
