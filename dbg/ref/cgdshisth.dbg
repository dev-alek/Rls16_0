      618   procedure fltfield-clear :
      619     define output parameter loc-fld as character no-undo.
      620     define output parameter loc-lab as character no-undo .
      621     define output parameter loc-spr as character no-undo .
      622     define output parameter loc-dim as character no-undo .
      623     assign
      624       loc-fld = ""
      625       loc-lab = ""
      626       loc-spr = ""
      627       loc-dim = "0"
      628     .
      629   end procedure .
      630   procedure fltfield-add :
      631     define input        parameter par-fld as character no-undo.
      632     define input        parameter par-lab as character no-undo .
      633     define input        parameter par-spr as character no-undo .
      634     define input-output parameter loc-fld as character no-undo.
      635     define input-output parameter loc-lab as character no-undo .
      636     define input-output parameter loc-spr as character no-undo .
      637     define input-output parameter loc-dim as character no-undo .
      638     do
      639     on error undo, return error
      640     :
      641       assign
      642       loc-fld = if loc-dim = '0'
      643                 then par-fld
      644                 else (loc-fld + chr(44) + par-fld)
      645       loc-lab = if loc-dim = '0'
      646                 then par-lab
      647                 else (loc-lab + chr(44) + par-lab)
      648       loc-spr = if loc-dim = '0'
      649                 then par-spr
      650                 else (loc-spr + chr(44) + par-spr)
      651       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      652                 string(integer(if num-entries(loc-dim) > 1
      653                               then entry(2, loc-dim)
      654                               else entry(1, loc-dim)
      655                               ) + 1)
      656       no-error
      657       .
      658     end.
      659   end procedure.
