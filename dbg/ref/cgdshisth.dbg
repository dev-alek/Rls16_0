     1072   FUNCTION get-all-fields returns character (p-file-name as character ):
     1073   define variable v-dop as character no-undo .
     1074     find first _file no-lock where _file._file-name = p-file-name no-error .
     1075     if not available _file then return "":U.
     1076     for each _field no-lock where
     1077              _field._file-recid = recid(_file) :
     1078       assign
     1079       v-dop = v-dop + _field._field-name + chr(44)
     1080       .
     1081     end.
     1082     return trim(v-dop).
     1083   END FUNCTION.
     1084   PROCEDURE proc-full-temp-changes :
     1085     define input  parameter p-hst-handle as handle    no-undo .
     1086     define input  parameter p-main-table as character no-undo .
     1087     define input  parameter p-field-list as character no-undo .
     1088     define input  parameter p-label-form as character no-undo .
     1089     define variable h-new-buf         as handle    no-undo .
     1090     define variable h-main-buf        as handle    no-undo .
     1091     define variable h-for-comp        as handle    no-undo .
     1092     define variable v-inform          as character no-undo .
     1093     define variable v-ind             as integer   no-undo .
     1094     define variable v-idx-field-qnty  as integer   no-undo .
     1095     define variable v-num-entries     as integer   no-undo .
     1096     define variable fh                as handle    no-undo .
     1097     define variable fh-main           as handle    no-undo .
     1098     define variable fh-old            as handle    no-undo .
     1099     define variable fh-new            as handle    no-undo .
     1100     define variable v-field-name      as character no-undo .
     1101     define variable v-field-lvl       as character no-undo .
     1102     define variable v-field-form      as character no-undo .
     1103     define variable v-search-exp      as character no-undo .
     1104     define variable v-srch-main       as character no-undo .
     1105     define variable v-word-link       as character no-undo .
     1106     define variable v-av-chip-num     as logical   no-undo .
     1107     define variable v-main-pi-fld-lst as character no-undo .
     1108     define variable v-main-fld-lst    as character no-undo .
     1109     define variable v-delim-list      as character no-undo .
     1110     define variable v-label           as character no-undo .
     1111     define variable v-old-value       as character no-undo case-sensitive.
     1112     define variable v-new-value       as character no-undo case-sensitive.
     1113     define variable v-chg-fields as character no-undo.
     1114     for each temp-changes:
     1115       delete temp-changes.
     1116     end.
     1117     if not p-hst-handle:available then do:
     1118       return .
     1119     end.
     1120     create buffer h-new-buf  for table p-hst-handle .
     1121     create buffer h-main-buf for table p-main-table .
     1122     assign
     1123       v-inform = h-main-buf:index-information(1)
     1124       v-ind    = 2
     1125     .
     1126     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1127     on error undo, return error
     1128     :
     1129       assign
     1130         v-inform = h-main-buf:index-information( v-ind )
     1131         v-ind    = v-ind + 1
     1132       .
     1133     end.
     1134     if v-inform = ?
     1135       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1136       or entry( 3, v-inform, ",":U ) <> "1":U
     1137     then do:
     1138       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1139     end.
     1140     assign
     1141       v-idx-field-qnty = num-entries( v-inform ) - 4
     1142     .
     1143     if v-idx-field-qnty < 2 then do:
     1144       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1145     end.
     1146     assign
     1147       v-srch-main   = "where":U
     1148       v-word-link   = "":U
     1149       v-av-chip-num = false
     1150       v-delim-list  = "":U
     1151     .
     1152     do v-ind = 1 to v-idx-field-qnty by 2
     1153     on error undo, return error
     1154     :
     1155       assign
     1156         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1157         fh                = p-hst-handle:buffer-field( v-field-name )
     1158         fh-main           = h-main-buf:buffer-field( v-field-name )
     1159         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1160         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1161       .
     1162       if fh:data-type ="character":U then do:
     1163         assign
     1164           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1165         .
     1166       end.
     1167       else do:
     1168         assign
     1169           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1170         .
     1171       end.
     1172       if v-delim-list = "":U then do:
     1173         assign
     1174           v-delim-list = ",":U
     1175         .
     1176       end.
     1177       if v-word-link = "":U then do:
     1178         assign
     1179           v-word-link = "and":U
     1180         .
     1181       end.
     1182     end.
     1183     assign
     1184       v-delim-list  = "":U
     1185     .
     1186     do v-ind = 1 to h-main-buf:num-fields
     1187     on error undo, return error
     1188     :
     1189       assign
     1190         fh-main      = h-main-buf:buffer-field( v-ind )
     1191         v-field-name = fh-main:name
     1192       .
     1193         assign
     1194           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1195         .
     1196         if v-delim-list = "":U then do:
     1197           assign
     1198             v-delim-list = ",":U
     1199           .
     1200         end.
     1201     end.
     1202     assign
     1203       v-inform = p-hst-handle:index-information(1)
     1204       v-ind    = 2
     1205     .
     1206     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1207     on error undo, return error
     1208     :
     1209       assign
     1210         v-inform = p-hst-handle:index-information( v-ind )
     1211         v-ind    = v-ind + 1
     1212       .
     1213     end.
     1214     if v-inform = ?
     1215       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1216       or entry( 3, v-inform, ",":U ) <> "1":U
     1217     then do:
     1218       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1219     end.
     1220     assign
     1221       v-idx-field-qnty = num-entries( v-inform ) - 4
     1222     .
     1223     if v-idx-field-qnty < 2 then do:
     1224       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1225     end.
     1226     assign
     1227       v-search-exp  = "where":U
     1228       v-word-link   = "":U
     1229       v-av-chip-num = false
     1230     .
     1231     do v-ind = 1 to v-idx-field-qnty by 2
     1232     on error undo, return error
     1233     :
     1234       assign
     1235         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1236         fh           = p-hst-handle:buffer-field( v-field-name )
     1237         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1238       .
     1239       if v-field-name = "chip-num":U then do:
     1240         assign
     1241           v-search-exp  = substitute( "&1 >", v-search-exp )
     1242           v-av-chip-num = true
     1243         .
     1244       end.
     1245       else do:
     1246         assign
     1247           v-search-exp = substitute( "&1 =", v-search-exp )
     1248         .
     1249       end.
     1250       if fh:data-type ="character":U then do:
     1251         assign
     1252           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1253         .
     1254       end.
     1255       else do:
     1256         assign
     1257           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1258         .
     1259       end.
     1260       if v-word-link = "":U then do:
     1261         assign
     1262           v-word-link = "and":U
     1263         .
     1264       end.
     1265     end.
     1266     if v-av-chip-num = false then do:
     1267       message
     1268         vss-workfile vss-revision vss-description skip
     1269         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1270         "Использование данной процедуры невозможно!" skip
     1271         view-as alert-box error .
     1272       return error .
     1273     end.
     1274     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1275     if not h-new-buf:available then do:
     1276       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1277       if not h-main-buf:available then do:
     1278         assign
     1279           h-for-comp = ?
     1280         .
     1281       end.
     1282       else do:
     1283         assign
     1284           h-for-comp = h-main-buf
     1285         .
     1286       end.
     1287     end.
     1288     else do:
     1289       assign
     1290         h-for-comp = h-new-buf
     1291       .
     1292     end.
     1293     assign
     1294       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1295     .
     1296     do v-ind = 1 to v-num-entries
     1297     on error undo, return error return-value
     1298     :
     1299       assign
     1300         v-field-name = entry( v-ind, v-main-fld-lst )
     1301         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1302         v-old-value  = fh-old:buffer-value()
     1303         v-label      = trim( fh-old:label )
     1304       .
     1305       if ( trim( p-field-list ) <> "":U
     1306            and lookup( v-field-name, p-field-list ) > 0
     1307          )
     1308          or trim( p-field-list ) = "":U
     1309       then do:
     1310         if h-for-comp <> ? then do:
     1311           assign
     1312             fh-new      = h-for-comp:buffer-field( v-field-name )
     1313             v-new-value = fh-new:buffer-value()
     1314           .
     1315         end.
     1316         else do:
     1317           assign
     1318             v-new-value = "":U
     1319           .
     1320         end.
     1321         if v-old-value <> v-new-value
     1322         then do:
     1323           create temp-changes.
     1324           assign
     1325             temp-changes.t_name = p-main-table
     1326             temp-changes.f_name = v-field-name
     1327             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1328             temp-changes.v_old  = trim( v-old-value )
     1329             temp-changes.v_new  = trim( v-new-value )
     1330             temp-changes.num_   = 0
     1331             temp-changes.fNotChange = v-old-value eq v-new-value
     1332           .
     1333         end.
     1334       end.
     1335     end.
     1336     assign
     1337       v-num-entries = num-entries( p-label-form, chr(8) )
     1338     .
     1339     do v-ind = 1 to v-num-entries
     1340     on error undo, return error return-value
     1341     :
     1342       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1343         assign
     1344           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1345           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1346           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1347         .
     1348         find first temp-changes
     1349           where temp-changes.f_name = v-field-name
     1350           no-error .
     1351         if available temp-changes then do:
     1352           if trim( v-field-lvl ) <> "":U then do:
     1353             assign
     1354               temp-changes.l_name = v-field-lvl
     1355             .
     1356           end.
     1357           if trim( v-field-form ) <> "":U then do:
     1358             assign
     1359               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1360             .
     1361             if h-for-comp <> ? then do:
     1362               assign
     1363                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1364               .
     1365             end.
     1366           end.
     1367         end.
     1368       end.
     1369       else do:
     1370         message
     1371           vss-workfile vss-revision vss-description skip
     1372           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1373           substitute( "список для поля '&1': '&2'"
     1374                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1375                       ,entry( v-ind, p-label-form, chr(8) )
     1376                     ) skip
     1377           substitute( "полный список: &2", p-label-form ) skip
     1378           view-as alert-box error .
     1379       end.
     1380     end.
     1381     delete object h-new-buf .
     1382     delete object h-main-buf .
     1383   END PROCEDURE.
     1384   FUNCTION get-action RETURNS CHARACTER
     1385     ( p-action as integer )  FORWARD.
     1386   FUNCTION get-good RETURNS CHARACTER
     1387     ( p-gds-code as integer, output p-artic as character, output p-prod-type as character, output p-prod-code as integer )  FORWARD.
     1388   FUNCTION get-source-type RETURNS CHARACTER
     1389     ( p-source-type as character )  FORWARD.
     1390   FUNCTION get-subject RETURNS CHARACTER
     1391     ( p-subject as character )  FORWARD.
     1392   DEFINE BUTTON B-gds-obj
     1393        LABEL "&Остатки"
     1394        SIZE 10 BY 1.
     1395   DEFINE BUTTON B-Help
     1396        LABEL "Помо&щь"
     1397        SIZE 3 BY 1
     1398        BGCOLOR 8 .
     1399   DEFINE BUTTON B-lookup
     1400        LABEL "&Товар"
     1401        SIZE 10 BY 1.
     1402   DEFINE BUTTON B-mark
     1403        LABEL "&*"
     1404        SIZE 3 BY 1.
     1405   DEFINE BUTTON B-print
     1406        LABEL "Пе&чать"
     1407        SIZE 3 BY 1.
     1408   DEFINE BUTTON b-quit AUTO-END-KEY
     1409        LABEL "&Выход"
     1410        SIZE 10 BY 1
     1411        BGCOLOR 8 .
     1412   DEFINE BUTTON B-sch
     1413        LABEL "&Фильтр"
     1414        SIZE 3 BY 1.
     1415   DEFINE BUTTON b-sel AUTO-GO
     1416        LABEL "Вы&бор"
     1417        SIZE 10 BY 1
     1418        BGCOLOR 8 .
     1419   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1420         VIEW-AS TEXT
     1421        SIZE 6 BY 1
     1422        FGCOLOR 4  NO-UNDO.
     1423   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1424        LABEL "Дате изменения"
     1425        VIEW-AS FILL-IN
     1426        SIZE 11 BY 1 NO-UNDO.
     1427   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1428        LABEL "пользователю"
     1429        VIEW-AS FILL-IN
     1430        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1431   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1432        LABEL "БД"
     1433        VIEW-AS FILL-IN
     1434        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1435   DEFINE VARIABLE sch-gds-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1436        LABEL "коду товара"
     1437        VIEW-AS FILL-IN
     1438        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1439   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1440        LABEL "по БД"
     1441        VIEW-AS FILL-IN
     1442        SIZE 5 BY 1 NO-UNDO.
     1443   DEFINE QUERY BR-changes FOR
     1444         temp-changes SCROLLING.
     1445   DEFINE QUERY BR-gds-hist FOR
     1446         X_c-gds-hist SCROLLING.
     1447   DEFINE BROWSE BR-changes
     1448     QUERY BR-changes DISPLAY
     1449         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1450   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1451   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1452       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1453   DEFINE BROWSE BR-gds-hist
     1454     QUERY BR-gds-hist NO-LOCK DISPLAY
     1455         mark-string(recid(X_c-gds-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1456     X_c-gds-hist.gds-code FORMAT "999999999":U
     1457     X_c-gds-hist.corr-date FORMAT "99/99/9999":U
     1458     string(X_c-gds-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1459     usrfulnf(X_c-gds-hist.corr-user-name) column-label 'Изменил' FORMAT "X(8)":U
     1460     get-action(X_c-gds-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1461     X_c-gds-hist.corr-user-db-num FORMAT ">>>>9":U
     1462     X_c-gds-hist.is-news FORMAT "+/":U
     1463     get-source-type(X_c-gds-hist.source-type) COLUMN-LABEL "Источн.!измен."
     1464     X_c-gds-hist.source-ref FORMAT "X(14)":U
     1465     if v-find then get-good(X_c-gds-hist.gds-code, output v-artic, output v-prod-type, output v-prod-code) else "":U COLUMN-LABEL "Назв. товара" FORMAT "X(25)":U
     1466     v-artic COLUMN-LABEL "Артикул" FORMAT "X(14)":U
     1467     v-prod-type + string(v-prod-code) COLUMN-LABEL "Пр-ль" FORMAT "X(12)":U
     1468     get-subject(X_c-gds-hist.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(55)":U width 15
     1469     X_c-gds-hist.host-code COLUMN-LABEL "Фирма" FORMAT "999999999":U
     1470     X_c-gds-hist.obj-type + string(X_c-gds-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1471   ENABLE
     1472     X_c-gds-hist.is-news
     1473       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1474   DEFINE FRAME Dialog-Frame
     1475        b-quit AT ROW 1 COL 1
     1476        B-mark AT ROW 1 COL 11
     1477        b-sel AT ROW 1 COL 21
     1478        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1479        B-gds-obj AT ROW 1 COL 55
     1480        B-print AT ROW 1 COL 89
     1481        B-sch AT ROW 1 COL 92
     1482        B-Help AT ROW 1 COL 95
     1483        B-lookup AT ROW 1.04 COL 45
     1484        BR-gds-hist AT ROW 2 COL 1
     1485        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1486        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1487        sch-gds-code AT ROW 13.67 COL 48.13 COLON-ALIGNED
     1488        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1489        BR-changes AT ROW 14.79 COL 1
     1490        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1491        "ПОИСК ПО" VIEW-AS TEXT
     1492             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1493             FGCOLOR 4
     1494        SPACE(89.48) SKIP(7.44)
     1495       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1496            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1497            TITLE "Полная история по товару"
     1498            CANCEL-BUTTON b-quit.
     1499   ASSIGN
     1500          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1501          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1502   ASSIGN
     1503          BR-gds-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1504   ON GO OF FRAME Dialog-Frame
     1505   DO:
     1506     p-rid-list = v-rid-list.
     1507   END.
     1508   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1509   DO:
     1510     APPLY "END-ERROR":U TO SELF.
     1511   END.
     1512   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1513   DO:
     1514   run str/showgds.p (input parparentproc
     1515                 ,input ?
     1516                 ,input X_c-gds-hist.gds-code
     1517                 ,input 'ПРОСМОТР':U) no-error.
     1518   if error-status:error then return no-apply.
     1519   END.
     1520   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1521   DO:
     1522   define variable loc#log as logical no-undo .
     1523     if available X_c-gds-hist then do:
     1524   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1525   define variable v-str-recid14 as character no-undo .
     1526   define variable v-num-entry14 as integer   no-undo .
     1527   assign
     1528     v-str-recid14 = trim( string( recid( X_c-gds-hist ) , "->>>>>>>>>>>9":U ) )
     1529     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1530   .
     1531   if v-num-entry14 > 0 then do:
     1532     assign
     1533       entry( v-num-entry14, v-rid-list ) = "":U
     1534       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1535     .
     1536   end.
     1537   else do:
     1538     assign
     1539       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1540     .
     1541   end.
     1542       loc#log = br-gds-hist:refresh() .
     1543       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1544           loc#log = br-gds-hist:select-next-row ().
     1545           apply "VALUE-CHANGED" to br-gds-hist in frame Dialog-Frame.
     1546       end.
     1547       if num-entries( v-rid-list ) = 0
     1548       then
     1549           hide mark-num in frame Dialog-Frame.
     1550       else
     1551           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1552     end.
     1553     apply "entry" to br-gds-hist in frame Dialog-Frame.
     1554   END.
     1555   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1556   DO:
     1557       run proc-b-print in this-procedure no-error.
     1558     if error-status:error then return no-apply.
     1559   END.
     1560   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1561   DO:
     1562       run proc-b-sch in this-procedure no-error.
     1563     if error-status:error then return no-apply.
     1564   END.
     1565   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1566   DO:
     1567     if ( available X_c-gds-hist ) then do:
     1568       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1569       then
     1570       v-rid-list = string( recid( X_c-gds-hist ) ) .
     1571     end.
     1572   END.
     1573   ON MOUSE-SELECT-DBLCLICK OF BR-gds-hist IN FRAME Dialog-Frame
     1574   DO:
     1575        run proc-br-gds-hist in this-procedure no-error.
     1576     if error-status:error then return no-apply.
     1577   END.
     1578   ON RETURN OF BR-gds-hist IN FRAME Dialog-Frame
     1579   DO:
     1580       run proc-br-gds-hist in this-procedure no-error.
     1581     if error-status:error then return no-apply.
     1582   END.
     1583   ON VALUE-CHANGED OF BR-gds-hist IN FRAME Dialog-Frame
     1584   DO:
     1585     run proc-view-changes in this-procedure no-error.
     1586   END.
     1587   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1588   DO:
     1589      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1590     if error-status:error then return no-apply.
     1591   END.
     1592   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1593   DO:
     1594     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1595     if error-status:error then return no-apply.
     1596   END.
     1597   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1598   DO:
     1599     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1600     if error-status:error then return no-apply.
     1601   END.
     1602   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1603   DO:
     1604     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1605     if error-status:error then return no-apply.
     1606   END.
     1607   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
     1608   DO:
     1609     run proc-find-db-num in this-procedure(yes, input frame Dialog-Frame sch-db-num) no-error.
     1610     if error-status:error then return no-apply.
     1611   END.
     1612   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1613   DO:
     1614     run proc-find-db-num in this-procedure(no, input frame Dialog-Frame sch-db-num) no-error.
     1615     if error-status:error then return no-apply.
     1616   END.
     1617   ON CTRL-J OF sch-gds-code IN FRAME Dialog-Frame
     1618   DO:
     1619     run proc-find-gds-code in this-procedure(yes, input frame Dialog-Frame sch-gds-code) no-error.
     1620     if error-status:error then return no-apply.
     1621   END.
     1622   ON RETURN OF sch-gds-code IN FRAME Dialog-Frame
     1623   DO:
     1624     run proc-find-gds-code in this-procedure(no, input frame Dialog-Frame sch-gds-code) no-error.
     1625     if error-status:error then return no-apply.
     1626   END.
     1627   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1628   DO:
     1629     assign
     1630     v-corr-user-db-num
     1631     .
     1632     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     1633   END.
     1634   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1635   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1636   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1637   on help of frame Dialog-Frame
     1638   do:
     1639     run gbl/app_help.p
     1640       (input this-procedure :file-name
     1641       ,input ''
     1642       ,input ?
     1643       ) no-error.
     1644     if error-status :error then do:
     1645       message
     1646         "Ошибка при вызове помощи"
     1647         error-status :get-message(1)
     1648         view-as alert-box .
     1649     end.
     1650   end.
     1651   run minbtn-set in this-procedure .
     1652   on choose of b-help in frame Dialog-Frame
     1653   do:
     1654     apply "help":u to frame Dialog-Frame .
     1655   end.
     1656   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1657   procedure minbtn-set :
     1658       do
     1659           on error undo, return error return-value
     1660           :
     1661           define variable ii              as integer       no-undo .
     1662           define variable fh              as widget-handle no-undo .
     1663           define variable hh              as widget-handle no-undo .
     1664           define variable v-h             as handle        extent 4 no-undo .
     1665           define variable v-name-button   as character     no-undo .
     1666           define variable v-help-old-x    as decimal       no-undo .
     1667           define variable v-help-old-y    as decimal       no-undo .
     1668           define variable v-help-old-size as decimal       no-undo .
     1669           define variable v-frame-width   as decimal       no-undo .
     1670           define variable jj              as integer       no-undo .
     1671           do
     1672               on error undo, return error
     1673               :
     1674               assign
     1675                   v-frame-width = frame Dialog-Frame:width - 0.3
     1676                   fh            = frame Dialog-Frame:first-child
     1677                   hh            = fh:first-child
     1678                   ii            = 1
     1679                   .
     1680               do while valid-handle(hh):
     1681                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1682                   do:
     1683                       case lc(hh:name) :
     1684                           when "b-help" then
     1685                               do:
     1686                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1687                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1688                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1689                                   hh:TOOLTIP = "Помощь" .
     1690                                   v-help-old-x = hh:column .
     1691                                   v-help-old-y = hh:row    .
     1692                                   v-help-old-size = hh:width .
     1693                                   hh:width-chars = 2.5 .
     1694                               end.
     1695                           when "b-print" then
     1696                               do:
     1697                                   hh:load-image("cmp/b-print.bmp":u) .
     1698                                   hh:TOOLTIP = "Печать" .
     1699                                   v-h[ii] = hh:handle .
     1700                                   ii = ii + 1 .
     1701                                   hh:width-chars = 3 .
     1702                               end.
     1703                           when "b-history" or
     1704                           when "b-hist" then
     1705                               do:
     1706                                   hh:load-image("cmp/b-hist.bmp":u) .
     1707                                   hh:TOOLTIP = "История" .
     1708                                   v-h[ii] = hh:handle .
     1709                                   ii = ii + 1 .
     1710                                   hh:width-chars = 3 .
     1711                               end.
     1712                           when "b-sch" then
     1713                               do:
     1714                                   hh:load-image("cmp/b-sch.bmp":u) .
     1715                                   hh:TOOLTIP = "Установка Фильтра" .
     1716                                   v-h[ii] = hh:handle .
     1717                                   ii = ii + 1 .
     1718                                   hh:width-chars = 3 .
     1719                               end.
     1720                           when "b-hist-user" then
     1721                               do:
     1722                                   hh:load-image("cmp/b-hist.bmp":u) .
     1723                                   hh:TOOLTIP = "История пользователя" .
     1724                                   ii = ii + 1 .
     1725                               end.
     1726                       end case.
     1727                   end.
     1728                   hh = hh:next-sibling.
     1729               end.
     1730               b-help:column = v-frame-width - b-help:width-chars.
     1731               jj = 0.
     1732               repeat ii = 4 to 1 by -1 :
     1733                   if valid-handle (v-h[ii] ) then
     1734                   do:
     1735                       jj  = jj + 1 .
     1736                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1737                       v-h[ii]:row    = v-help-old-y .
     1738                   end.
     1739               end.
     1740           end.
     1741       end.
     1742   end procedure.
     1743   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1744   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1745   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1746   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1747   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1748   define variable v-diasize-current-frame-height as decimal   no-undo .
     1749   define variable v-diasize-change-size          as logical   no-undo .
     1750   define variable v-diasize-resize-button        as handle    no-undo .
     1751   define variable v-diasize-wndmax               as logical   no-undo .
     1752   define variable v-diasize-wndstore             as logical   no-undo .
     1753   define variable v-diasize-proc-name            as character no-undo .
     1754   define variable v-diasize-browse-handle        as handle    no-undo .
     1755   define variable v-diasize-browse-number        as integer   no-undo .
     1756   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1757   define temp-table temp-diasize-handle no-undo
     1758     field handle-value  as handle
     1759     field save-position as decimal
     1760     index xpk is primary unique handle-value
     1761     .
     1762   define temp-table temp-browse-handle no-undo
     1763     field browse-type   as character
     1764     field browse-number as integer
     1765     field browse-handle as handle
     1766     field original-size as decimal
     1767     index xpk is primary unique browse-type browse-number
     1768     index xie browse-type browse-handle
     1769   .
     1770   procedure diasize_change-height :
     1771     define input  parameter p-change-value  as decimal   no-undo .
     1772     define input  parameter p-move-resize   as logical   no-undo .
     1773     define variable v-field-group-handle    as handle    no-undo .
     1774     define variable v-object-handle         as handle    no-undo .
     1775     define variable v-frame-height          as decimal   no-undo .
     1776     define variable v-frame-virtual-height  as decimal   no-undo .
     1777     define variable v-browse-height         as decimal   no-undo .
     1778     define variable v-window-height         as decimal   no-undo .
     1779     define variable v-window-virtual-height as decimal   no-undo .
     1780     define variable v-change-sign           as integer   no-undo .
     1781     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1782     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1783     if p-change-value > 0
     1784     then do:
     1785       if frame Dialog-Frame :height + p-change-value
     1786           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1787       then do:
     1788         assign
     1789           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1790                           - (frame Dialog-Frame :height-chars)
     1791         .
     1792         if p-change-value <= 0
     1793         then do:
     1794           run diasize_position-resize-button in this-procedure .
     1795           return .
     1796         end.
     1797       end.
     1798     end.
     1799     if p-change-value < 0
     1800     then do:
     1801       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1802       then do:
     1803         assign
     1804           p-change-value = v-diasize-orig-frame-height
     1805                          - (frame Dialog-Frame :height-chars)
     1806         .
     1807         if p-change-value >= 0
     1808         then do:
     1809           run diasize_position-resize-button in this-procedure .
     1810           return .
     1811         end.
     1812       end.
     1813     end.
     1814     if p-change-value >= 0
     1815     then do:
     1816       assign
     1817         v-change-sign = 1
     1818       .
     1819     end.
     1820     else do:
     1821       assign
     1822         v-change-sign = -1
     1823       .
     1824     end.
     1825     assign
     1826       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1827     .
     1828     if p-change-value = 0
     1829     then do:
     1830       run diasize_position-resize-button in this-procedure .
     1831       return .
     1832     end.
     1833     move_block:
     1834     do
     1835     on error undo move_block, retry move_block
     1836     :
     1837       if retry
     1838       then do:
     1839         do
     1840         on error undo move_block, leave move_block
     1841         :
     1842           if p-change-value > 0
     1843           then do:
     1844             for each buf_temp-diasize-handle
     1845             on error undo, next
     1846             :
     1847               assign
     1848                 v-object-handle = buf_temp-diasize-handle.handle-value
     1849               .
     1850               if v-object-handle <> v-diasize-resize-button
     1851               then do:
     1852                 assign
     1853                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1854                 .
     1855               end.
     1856             end.
     1857             assign
     1858               v-diasize-browse-handle :height = v-browse-height
     1859             .
     1860             for each buf_temp-browse-handle
     1861               where buf_temp-browse-handle.browse-type = 'height':u
     1862             on error undo, next
     1863             :
     1864               assign
     1865                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1866               .
     1867             end.
     1868             assign
     1869               frame Dialog-Frame :height = v-frame-height
     1870             .
     1871             if frame Dialog-Frame :scrollable = true
     1872             then do:
     1873               assign
     1874                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1875               .
     1876             end.
     1877             run diasize_position-resize-button in this-procedure .
     1878           end.
     1879           else do:
     1880             if frame Dialog-Frame :scrollable = true
     1881             then do:
     1882               assign
     1883                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1884               .
     1885             end.
     1886             assign
     1887               frame Dialog-Frame :height = v-frame-height
     1888             .
     1889             assign
     1890               v-diasize-browse-handle :height = v-browse-height
     1891             .
     1892             for each buf_temp-browse-handle
     1893               where buf_temp-browse-handle.browse-type = 'height':u
     1894             on error undo, next
     1895             :
     1896               assign
     1897                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1898               .
     1899             end.
     1900             for each buf_temp-diasize-handle
     1901             on error undo, next
     1902             :
     1903               assign
     1904                 v-object-handle = buf_temp-diasize-handle.handle-value
     1905               .
     1906               if v-object-handle <> v-diasize-resize-button
     1907               then do:
     1908                 assign
     1909                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1910                 .
     1911               end.
     1912             end.
     1913             run diasize_position-resize-button in this-procedure .
     1914           end.
     1915           assign
     1916             v-diasize-change-size = false
     1917           .
     1918           leave move_block .
     1919         end.
     1920       end.
     1921       assign
     1922         v-diasize-need-full-display = true
     1923       .
     1924       if v-diasize-change-size = false
     1925       then do:
     1926         assign
     1927           v-diasize-change-size = true
     1928         .
     1929       end.
     1930       else do:
     1931         return .
     1932       end.
     1933       assign
     1934         v-frame-height = frame Dialog-Frame :height
     1935         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1936         v-browse-height = v-diasize-browse-handle :height
     1937       .
     1938       for each buf_temp-browse-handle
     1939         where buf_temp-browse-handle.browse-type = 'height':u
     1940       :
     1941         assign
     1942           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1943         .
     1944       end.
     1945       for each buf_temp-diasize-handle
     1946       :
     1947         delete buf_temp-diasize-handle .
     1948       end.
     1949       assign
     1950         v-field-group-handle = frame Dialog-Frame :first-child
     1951       .
     1952       do while valid-handle(v-field-group-handle)
     1953       :
     1954         assign
     1955           v-object-handle = v-field-group-handle :first-child
     1956         .
     1957         do while valid-handle(v-object-handle)
     1958         :
     1959           if  v-object-handle <> v-diasize-browse-handle :handle
     1960           and can-query(v-object-handle, "row")
     1961           and can-query(v-object-handle, "height")
     1962           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1963           then do:
     1964             find first buf_temp-browse-handle
     1965               where buf_temp-browse-handle.browse-type   = 'height':u
     1966                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1967               no-error .
     1968             if available buf_temp-browse-handle
     1969             then do:
     1970             end.
     1971             else do:
     1972               create buf_temp-diasize-handle .
     1973               assign
     1974                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1975                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1976               .
     1977             end.
     1978           end.
     1979           assign
     1980             v-object-handle = v-object-handle :next-sibling
     1981           .
     1982         end.
     1983         assign
     1984           v-field-group-handle = v-field-group-handle :next-sibling
     1985         .
     1986       end.
     1987       do with frame Dialog-Frame
     1988       :
     1989         hide v-diasize-resize-button .
     1990         assign
     1991           v-diasize-resize-button :row    = 1
     1992           v-diasize-resize-button :column = 1
     1993         .
     1994       end.
     1995       if p-change-value > 0
     1996       then do:
     1997         if frame Dialog-Frame :scrollable = true
     1998         then do:
     1999           assign
     2000             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2001             no-error .
     2002           if error-status :error
     2003           or error-status :get-message(1) <> ""
     2004           then do:
     2005             undo move_block, retry move_block .
     2006           end.
     2007         end.
     2008         assign
     2009           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2010           no-error .
     2011         if error-status :error
     2012         or error-status :get-message(1) <> ""
     2013         then do:
     2014           undo move_block, retry move_block .
     2015         end.
     2016         assign
     2017           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2018           no-error .
     2019         if error-status :error
     2020         or error-status :get-message(1) <> ""
     2021         then do:
     2022           undo move_block, retry move_block .
     2023         end.
     2024         for each buf_temp-browse-handle
     2025           where buf_temp-browse-handle.browse-type = 'height':u
     2026         on error undo move_block, retry move_block
     2027         :
     2028           assign
     2029             buf_temp-browse-handle.browse-handle :height
     2030               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2031             no-error .
     2032           if error-status :error
     2033           or error-status :get-message(1) <> ""
     2034           then do:
     2035             undo move_block, retry move_block .
     2036           end.
     2037         end.
     2038         for each buf_temp-diasize-handle
     2039         on error undo move_block, retry move_block
     2040         :
     2041           assign
     2042             v-object-handle = buf_temp-diasize-handle.handle-value
     2043           .
     2044           if v-object-handle <> v-diasize-resize-button
     2045           then do:
     2046             assign
     2047               v-object-handle :row = v-object-handle :row + p-change-value
     2048               no-error .
     2049             if error-status :error
     2050             or error-status :get-message(1) <> ""
     2051             then do:
     2052               undo move_block, retry move_block .
     2053             end.
     2054           end.
     2055         end.
     2056       end.
     2057       else do:
     2058         for each buf_temp-diasize-handle
     2059         on error undo move_block, retry move_block
     2060         :
     2061           assign
     2062             v-object-handle = buf_temp-diasize-handle.handle-value
     2063           .
     2064           if v-object-handle <> v-diasize-resize-button
     2065           then do:
     2066             assign
     2067               v-object-handle :row = v-object-handle :row + p-change-value
     2068               no-error .
     2069             if error-status :error
     2070             or error-status :get-message(1) <> ""
     2071             then do:
     2072               undo move_block, retry move_block .
     2073             end.
     2074           end.
     2075         end.
     2076         assign
     2077           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2078           no-error .
     2079         if error-status :error
     2080         or error-status :get-message(1) <> ""
     2081         then do:
     2082           undo move_block, retry move_block .
     2083         end.
     2084         for each buf_temp-browse-handle
     2085           where buf_temp-browse-handle.browse-type = 'height':u
     2086         on error undo move_block, retry move_block
     2087         :
     2088           assign
     2089             buf_temp-browse-handle.browse-handle :height
     2090               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2091             no-error .
     2092           if error-status :error
     2093           or error-status :get-message(1) <> ""
     2094           then do:
     2095             undo move_block, retry move_block .
     2096           end.
     2097         end.
     2098         assign
     2099           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2100           no-error .
     2101         if error-status :error
     2102         or error-status :get-message(1) <> ""
     2103         then do:
     2104           undo move_block, retry move_block .
     2105         end.
     2106         if frame Dialog-Frame :scrollable = true
     2107         then do:
     2108           assign
     2109             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2110             no-error .
     2111           if error-status :error
     2112           or error-status :get-message(1) <> ""
     2113           then do:
     2114             undo move_block, retry move_block .
     2115           end.
     2116         end.
     2117       end.
     2118       if p-move-resize = true
     2119       then do:
     2120         run diasize_position-resize-button in this-procedure .
     2121       end.
     2122       if v-diasize-wndstore = true
     2123       then do:
     2124         if connected("ub") = true
     2125         then do:
     2126           define variable v-cntxt-db-num        as integer   no-undo .
     2127           define variable v-cntxt-userid        as character no-undo .
     2128           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2129                                             , OUTPUT v-cntxt-userid
     2130                                             ) .
     2131           run gbl/wndsizew.p
     2132             (input  v-cntxt-db-num
     2133             ,input  v-cntxt-userid
     2134             ,input  v-diasize-proc-name
     2135             ,input  'height':u
     2136             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2137             ) .
     2138         end.
     2139       end.
     2140     end.
     2141     assign
     2142       v-diasize-change-size = false
     2143     .
     2144   end procedure.
     2145   procedure diasize_set-height :
     2146     define input  parameter p-new-height  as decimal   no-undo .
     2147     define input  parameter p-move-resize as logical   no-undo .
     2148     do
     2149     on error undo, return error return-value
     2150     :
     2151       run diasize_change-height in this-procedure
     2152         (input  (p-new-height - frame Dialog-Frame :height)
     2153         ,input  p-move-resize
     2154         ) .
     2155     end.
     2156   end procedure.
     2157   procedure diasize_change-width :
     2158     define input  parameter p-change-value as decimal   no-undo .
     2159     define input  parameter p-move-resize  as logical   no-undo .
     2160     define variable v-field-group-handle   as handle    no-undo .
     2161     define variable v-object-handle        as handle    no-undo .
     2162     define variable v-frame-width          as decimal   no-undo .
     2163     define variable v-frame-virtual-width  as decimal   no-undo .
     2164     define variable v-browse-width         as decimal   no-undo .
     2165     define variable v-window-width         as decimal   no-undo .
     2166     define variable v-window-virtual-width as decimal   no-undo .
     2167     define variable v-change-sign          as integer   no-undo .
     2168     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2169     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2170     if p-change-value > 0
     2171     then do:
     2172       if frame Dialog-Frame :width + p-change-value >
     2173           session :width-chars
     2174       then do:
     2175         assign
     2176           p-change-value = session :width-chars - frame Dialog-Frame :width
     2177         .
     2178         if p-change-value <= 0
     2179         then do:
     2180           run diasize_position-resize-button in this-procedure .
     2181           return .
     2182         end.
     2183       end.
     2184     end.
     2185     if p-change-value < 0
     2186     then do:
     2187       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2188       then do:
     2189         assign
     2190           p-change-value = v-diasize-orig-frame-width
     2191                          - frame Dialog-Frame :width
     2192         .
     2193         if p-change-value >= 0
     2194         then do:
     2195           run diasize_position-resize-button in this-procedure .
     2196           return .
     2197         end.
     2198       end.
     2199     end.
     2200     if p-change-value >= 0
     2201     then do:
     2202       assign
     2203         v-change-sign = 1
     2204       .
     2205     end.
     2206     else do:
     2207       assign
     2208         v-change-sign = -1
     2209       .
     2210     end.
     2211     assign
     2212       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2213     .
     2214     if p-change-value = 0
     2215     then do:
     2216       run diasize_position-resize-button in this-procedure .
     2217       return .
     2218     end.
     2219     move_block:
     2220     do
     2221     on error undo move_block, leave move_block
     2222     :
     2223       if retry
     2224       then do:
     2225         do
     2226         on error undo move_block, leave move_block
     2227         :
     2228           if p-change-value > 0
     2229           then do:
     2230             for each buf_temp-diasize-handle
     2231             on error undo, next
     2232             :
     2233               assign
     2234                 v-object-handle = buf_temp-diasize-handle.handle-value
     2235               .
     2236               if v-object-handle <> v-diasize-resize-button
     2237               then do:
     2238                 assign
     2239                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2240                 .
     2241               end.
     2242             end.
     2243             assign
     2244               v-diasize-browse-handle :width = v-browse-width
     2245             .
     2246             for each buf_temp-browse-handle
     2247               where buf_temp-browse-handle.browse-type = 'width':u
     2248             on error undo, next
     2249             :
     2250               assign
     2251                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2252               .
     2253             end.
     2254             assign
     2255               frame Dialog-Frame :width = v-frame-width
     2256             .
     2257             if frame Dialog-Frame :scrollable = true
     2258             then do:
     2259               assign
     2260                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2261               .
     2262             end.
     2263             run diasize_position-resize-button in this-procedure .
     2264           end.
     2265           else do:
     2266             if frame Dialog-Frame :scrollable = true
     2267             then do:
     2268               assign
     2269                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2270               .
     2271             end.
     2272             assign
     2273               frame Dialog-Frame :width = v-frame-width
     2274             .
     2275             for each buf_temp-browse-handle
     2276               where buf_temp-browse-handle.browse-type = 'width':u
     2277             on error undo, next
     2278             :
     2279               assign
     2280                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2281               .
     2282             end.
     2283             assign
     2284               v-diasize-browse-handle :width = v-browse-width
     2285             .
     2286             for each buf_temp-diasize-handle
     2287             on error undo, next
     2288             :
     2289               assign
     2290                 v-object-handle = buf_temp-diasize-handle.handle-value
     2291               .
     2292               if v-object-handle <> v-diasize-resize-button
     2293               then do:
     2294                 assign
     2295                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2296                 .
     2297               end.
     2298             end.
     2299             run diasize_position-resize-button in this-procedure .
     2300           end.
     2301           assign
     2302             v-diasize-change-size = false
     2303           .
     2304           leave move_block .
     2305         end.
     2306       end.
     2307       assign
     2308         v-diasize-need-full-display = true
     2309       .
     2310       if v-diasize-change-size = false
     2311       then do:
     2312         assign
     2313           v-diasize-change-size = true
     2314         .
     2315       end.
     2316       else do:
     2317         return .
     2318       end.
     2319       assign
     2320         v-frame-width = frame Dialog-Frame :width
     2321         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2322         v-browse-width = v-diasize-browse-handle :width
     2323       .
     2324       for each buf_temp-browse-handle
     2325         where buf_temp-browse-handle.browse-type = 'width':u
     2326       :
     2327         assign
     2328           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2329         .
     2330       end.
     2331       for each buf_temp-diasize-handle
     2332       :
     2333         delete buf_temp-diasize-handle .
     2334       end.
     2335       assign
     2336         v-field-group-handle = frame Dialog-Frame :first-child
     2337       .
     2338       do while valid-handle(v-field-group-handle)
     2339       :
     2340         assign
     2341           v-object-handle = v-field-group-handle :first-child
     2342         .
     2343         do while valid-handle(v-object-handle)
     2344         :
     2345           if  v-object-handle <> v-diasize-browse-handle :handle
     2346           and v-object-handle <> v-diasize-resize-button
     2347           and can-query(v-object-handle, "row")
     2348           and can-query(v-object-handle, "height")
     2349           and ( v-object-handle :col + v-object-handle :width
     2350                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2351               )
     2352           then do:
     2353             find first buf_temp-browse-handle
     2354               where buf_temp-browse-handle.browse-type   = 'width':u
     2355                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2356               no-error .
     2357             if available buf_temp-browse-handle
     2358             then do:
     2359             end.
     2360             else do:
     2361               create buf_temp-diasize-handle .
     2362               assign
     2363                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2364                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2365               .
     2366             end.
     2367           end.
     2368           assign
     2369             v-object-handle = v-object-handle :next-sibling
     2370           .
     2371         end.
     2372         assign
     2373           v-field-group-handle = v-field-group-handle :next-sibling
     2374         .
     2375       end.
     2376       do with frame Dialog-Frame
     2377       :
     2378         hide v-diasize-resize-button .
     2379         v-diasize-resize-button :row = 1.
     2380         v-diasize-resize-button :column = 1.
     2381       end.
     2382       if p-change-value > 0
     2383       then do:
     2384         if frame Dialog-Frame :scrollable = true
     2385         then do:
     2386           assign
     2387             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2388             no-error .
     2389           if error-status :error
     2390           or error-status :get-message(1) <> ""
     2391           then do:
     2392             undo move_block, retry move_block.
     2393           end.
     2394         end.
     2395         assign
     2396           frame Dialog-Frame :width = v-frame-width + p-change-value
     2397           no-error .
     2398         if error-status :error
     2399         or error-status :get-message(1) <> ""
     2400         then do:
     2401           undo move_block, retry move_block.
     2402         end.
     2403         assign
     2404           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2405         no-error .
     2406         if error-status :error
     2407         or error-status :get-message(1) <> ""
     2408         then do:
     2409           undo move_block, retry move_block.
     2410         end.
     2411         for each buf_temp-browse-handle
     2412           where buf_temp-browse-handle.browse-type = 'width':u
     2413         on error undo move_block, retry move_block
     2414         :
     2415           assign
     2416             buf_temp-browse-handle.browse-handle :width
     2417               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2418             no-error .
     2419           if error-status :error
     2420           or error-status :get-message(1) <> ""
     2421           then do:
     2422             undo move_block, retry move_block .
     2423           end.
     2424         end.
     2425         for each buf_temp-diasize-handle
     2426         on error undo move_block, retry move_block
     2427         :
     2428           assign
     2429             v-object-handle = buf_temp-diasize-handle.handle-value
     2430           .
     2431           if v-object-handle <> v-diasize-resize-button
     2432           then do:
     2433             assign
     2434               v-object-handle :col = v-object-handle :col + p-change-value
     2435               no-error .
     2436             if error-status :error
     2437             or error-status :get-message(1) <> ""
     2438             then do:
     2439               undo move_block, retry move_block .
     2440             end.
     2441           end.
     2442         end.
     2443       end.
     2444       else do:
     2445         for each buf_temp-diasize-handle
     2446         on error undo move_block, retry move_block
     2447         :
     2448           assign
     2449             v-object-handle = buf_temp-diasize-handle.handle-value
     2450           .
     2451           if v-object-handle <> v-diasize-resize-button
     2452           then do:
     2453             assign
     2454               v-object-handle :col = v-object-handle :col + p-change-value
     2455               no-error .
     2456             if error-status :error
     2457             or error-status :get-message(1) <> ""
     2458             then do:
     2459               undo move_block, retry move_block .
     2460             end.
     2461           end.
     2462         end.
     2463         for each buf_temp-browse-handle
     2464           where buf_temp-browse-handle.browse-type = 'width':u
     2465         on error undo move_block, retry move_block
     2466         :
     2467           assign
     2468             buf_temp-browse-handle.browse-handle :width
     2469               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2470             no-error .
     2471           if error-status :error
     2472           or error-status :get-message(1) <> ""
     2473           then do:
     2474             undo move_block, retry move_block .
     2475           end.
     2476         end.
     2477         assign
     2478           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2479           no-error .
     2480         if error-status :error
     2481         or error-status :get-message(1) <> ""
     2482         then do:
     2483           undo move_block, retry move_block.
     2484         end.
     2485         assign
     2486           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2487         no-error .
     2488         if error-status :error
     2489         or error-status :get-message(1) <> ""
     2490         then do:
     2491           undo move_block, retry move_block.
     2492         end.
     2493         if frame Dialog-Frame :scrollable = true
     2494         then do:
     2495           assign
     2496             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2497           no-error .
     2498           if error-status :error
     2499           or error-status :get-message(1) <> ""
     2500           then do:
     2501             undo move_block, retry move_block.
     2502           end.
     2503         end.
     2504       end.
     2505       if p-move-resize
     2506       then do:
     2507         run diasize_position-resize-button in this-procedure .
     2508       end.
     2509       if v-diasize-wndstore = true
     2510       then do:
     2511         if connected("ub") = true
     2512         then do:
     2513           define variable v-cntxt-db-num        as integer   no-undo .
     2514           define variable v-cntxt-userid        as character no-undo .
     2515           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2516                                             , OUTPUT v-cntxt-userid
     2517                                             ) .
     2518           run gbl/wndsizew.p
     2519             (input  v-cntxt-db-num
     2520             ,input  v-cntxt-userid
     2521             ,input  v-diasize-proc-name
     2522             ,input  'width':u
     2523             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2524             ) .
     2525         end.
     2526       end.
     2527     end.
     2528     assign
     2529       v-diasize-change-size = false
     2530     .
     2531   end procedure.
     2532   procedure diasize_set-width :
     2533     define input  parameter p-new-width  as decimal   no-undo .
     2534     define input  parameter p-move-resize as logical   no-undo .
     2535     do
     2536     on error undo, return error return-value
     2537     :
     2538       run diasize_change-width in this-procedure
     2539         (input  (p-new-width - frame Dialog-Frame :width)
     2540         ,input  p-move-resize
     2541         ) .
     2542     end.
     2543   end procedure.
     2544   procedure diasize_position-resize-button :
     2545     do with frame Dialog-Frame
     2546     :
     2547       hide v-diasize-resize-button .
     2548       assign
     2549         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2550                     - 1
     2551                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2552         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2553                     - 1
     2554                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2555       .
     2556       view v-diasize-resize-button .
     2557     end.
     2558   end procedure.
     2559   on alt-right anywhere
     2560   do:
     2561     run diasize_change-width in this-procedure
     2562       (input 1
     2563       ,input true
     2564       ) .
     2565     return no-apply .
     2566   end.
     2567   on alt-left anywhere
     2568   do:
     2569     run diasize_change-width in this-procedure
     2570       (input -1
     2571       ,input true
     2572       ) .
     2573     return no-apply .
     2574   end.
     2575   on alt-down anywhere
     2576   do:
     2577     run diasize_change-height in this-procedure
     2578       (input 1
     2579       ,input true
     2580       ) .
     2581     return no-apply .
     2582   end.
     2583   on alt-up anywhere
     2584   do:
     2585     run diasize_change-height in this-procedure
     2586       (input -1
     2587       ,input true
     2588       ) .
     2589     return no-apply .
     2590   end.
     2591   on alt-enter of frame Dialog-Frame
     2592   do:
     2593     run diasize_maximize in this-procedure
     2594       (input  ?
     2595       ).
     2596     return no-apply .
     2597   end.
     2598   procedure diasize_end-move :
     2599     do
     2600     on error undo, return error return-value
     2601     :
     2602       define variable v-row-delta as decimal   no-undo .
     2603       define variable v-col-delta as decimal   no-undo .
     2604       define variable v-new-row as decimal   no-undo .
     2605       define variable v-new-col as decimal   no-undo .
     2606       assign
     2607         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2608         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2609       .
     2610       assign
     2611         v-row-delta = v-new-row - frame Dialog-Frame :height
     2612         v-col-delta = v-new-col - frame Dialog-Frame :width
     2613       .
     2614       run diasize_change-height in this-procedure
     2615         (input v-row-delta
     2616         ,input true
     2617         ) .
     2618       run diasize_change-width in this-procedure
     2619         (input v-col-delta
     2620         ,input true
     2621         ) .
     2622     end.
     2623   end procedure.
     2624   procedure diasize_maximize :
     2625     define input  parameter p-action as logical   no-undo .
     2626     do
     2627     on error undo, return error return-value
     2628     :
     2629       if p-action = ?
     2630       then do:
     2631         if v-diasize-need-maximize = true
     2632         then do:
     2633           assign
     2634             p-action = true
     2635           .
     2636         end.
     2637         else do:
     2638           assign
     2639             p-action = false
     2640           .
     2641         end.
     2642       end.
     2643       if p-action = true
     2644       then do:
     2645         run diasize_change-height in this-procedure
     2646           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2647               - frame Dialog-Frame :height-chars
     2648           ,input true
     2649           ) .
     2650         run diasize_change-width in this-procedure
     2651           (input session :width-chars
     2652               - frame Dialog-Frame :width-chars
     2653           ,input true
     2654           ) .
     2655         assign
     2656           v-diasize-need-maximize = false
     2657         .
     2658       end.
     2659       else do:
     2660         run diasize_change-width in this-procedure
     2661           (input v-diasize-orig-frame-width
     2662               - frame Dialog-Frame :width-chars
     2663           ,input true
     2664           ) .
     2665         run diasize_change-height in this-procedure
     2666           (input v-diasize-orig-frame-height
     2667               - frame Dialog-Frame :height-chars
     2668           ,input true
     2669           ) .
     2670         assign
     2671           v-diasize-need-maximize = true
     2672         .
     2673       end.
     2674     end.
     2675   end procedure.
     2676   procedure diasize_restore-orig-size :
     2677     do
     2678     on error undo, return error return-value
     2679     :
     2680       assign
     2681         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2682         v-diasize-current-frame-height = frame Dialog-Frame :height
     2683       .
     2684       run diasize_set-height in this-procedure
     2685         (input  v-diasize-orig-frame-height
     2686         ,input  true
     2687         ) .
     2688       run diasize_set-width in this-procedure
     2689         (input  v-diasize-orig-frame-width
     2690         ,input  true
     2691         ) .
     2692     end.
     2693   end procedure.
     2694   procedure diasize_restore-current-size :
     2695     do
     2696     on error undo, return error return-value
     2697     :
     2698       run diasize_set-height in this-procedure
     2699         (input  v-diasize-current-frame-height
     2700         ,input  true
     2701         ) .
     2702       run diasize_set-width in this-procedure
     2703         (input  v-diasize-current-frame-width
     2704         ,input  true
     2705         ) .
     2706     end.
     2707   end procedure.
     2708   procedure diasize_set-browse-handle :
     2709     define input  parameter p-browse-handle as handle   no-undo .
     2710     define buffer buf_temp-browse-handle for temp-browse-handle .
     2711     do
     2712     on error undo, return error return-value
     2713     :
     2714       assign
     2715         v-diasize-browse-handle = p-browse-handle
     2716       .
     2717       for each buf_temp-browse-handle
     2718       on error undo, return error return-value
     2719       :
     2720         delete buf_temp-browse-handle .
     2721       end.
     2722     end.
     2723   end procedure.
     2724   procedure diasize_add_browse :
     2725     define input  parameter p-browse-type   as character no-undo .
     2726     define input  parameter p-browse-handle as handle    no-undo .
     2727     define buffer buf_temp-browse-handle for temp-browse-handle .
     2728     do
     2729     on error undo, return error return-value
     2730     :
     2731       assign
     2732         v-diasize-browse-number = v-diasize-browse-number + 1
     2733       .
     2734       create buf_temp-browse-handle .
     2735       assign
     2736         buf_temp-browse-handle.browse-type   = p-browse-type
     2737         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2738         buf_temp-browse-handle.browse-handle = p-browse-handle
     2739       .
     2740     end.
     2741   end procedure.
     2742   procedure diasize_init :
     2743     define variable v-default-value    as logical   no-undo .
     2744     define variable v-restore-saved    as logical   no-undo .
     2745     define variable v-resize-value-str as character no-undo .
     2746     do
     2747     on error undo, return error return-value
     2748     :
     2749       do with frame Dialog-Frame
     2750       :
     2751         assign
     2752           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2753           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2754           v-diasize-browse-handle     = browse br-gds-hist :handle
     2755         .
     2756         create button v-diasize-resize-button
     2757         assign
     2758           parent        = frame Dialog-Frame :first-child
     2759           label         = "s"
     2760           height-pixels = 16
     2761           width-pixels  = 16
     2762           visible       = true
     2763           sensitive     = true
     2764           movable       = true
     2765           triggers:
     2766             on end-move persistent run diasize_end-move in this-procedure .
     2767           end triggers.
     2768         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2769         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2770         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2771         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2772         assign
     2773           v-diasize-wndmax = false
     2774         .
     2775         if connected("ub") = true
     2776         then do:
     2777           define variable v-cntxt-db-num        as integer   no-undo .
     2778           define variable v-cntxt-userid        as character no-undo .
     2779           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2780                                             , OUTPUT v-cntxt-userid
     2781                                             ) .
     2782           run gbl/wndpar_r.p
     2783             (input  v-cntxt-db-num
     2784             ,input  v-cntxt-userid
     2785             ,input  'wndmax':U
     2786             ,output v-diasize-wndmax
     2787             ,output v-default-value
     2788             ) .
     2789         end.
     2790         assign
     2791           v-diasize-wndstore = false
     2792         .
     2793         if connected("ub") = true
     2794         then do:
     2795           run gbl/wndpar_r.p
     2796             (input  v-cntxt-db-num
     2797             ,input  v-cntxt-userid
     2798             ,input  'wndstore':U
     2799             ,output v-diasize-wndstore
     2800             ,output v-default-value
     2801             ) .
     2802         end.
     2803         assign
     2804           v-diasize-proc-name = entry(1, program-name(2), '.')
     2805         .
     2806         if v-diasize-wndstore = true
     2807         then do:
     2808           assign
     2809             v-restore-saved = false
     2810           .
     2811           if connected("ub") = true
     2812           then do:
     2813             run gbl/wndsizer.p
     2814               (input  v-cntxt-db-num
     2815               ,input  v-cntxt-userid
     2816               ,input  v-diasize-proc-name
     2817               ,input  'height':u
     2818               ,output v-resize-value-str
     2819               ) .
     2820             if v-resize-value-str <> '':U
     2821             then do:
     2822               run diasize_change-height in this-procedure
     2823                 (input  integer(v-resize-value-str)
     2824                 ,input  true
     2825                 ) .
     2826               assign
     2827                 v-restore-saved = true
     2828               .
     2829             end.
     2830           end.
     2831           if connected("ub") = true
     2832           then do:
     2833             run gbl/wndsizer.p
     2834               (input  v-cntxt-db-num
     2835               ,input  v-cntxt-userid
     2836               ,input  v-diasize-proc-name
     2837               ,input  'width':u
     2838               ,output v-resize-value-str
     2839               ) .
     2840             if v-resize-value-str <> '':U
     2841             then do:
     2842               run diasize_change-width in this-procedure
     2843                 (input  integer(v-resize-value-str)
     2844                 ,input  true
     2845                 ) .
     2846               assign
     2847                 v-restore-saved = true
     2848               .
     2849             end.
     2850           end.
     2851           if v-restore-saved <> true
     2852           then do:
     2853             if v-diasize-wndmax = true
     2854             then do:
     2855               run diasize_maximize in this-procedure
     2856                 (input  true
     2857                 ) .
     2858             end.
     2859           end.
     2860         end.
     2861         else do:
     2862           if v-diasize-wndmax = true
     2863           then do:
     2864             run diasize_maximize in this-procedure
     2865               (input  true
     2866               ) .
     2867           end.
     2868         end.
     2869       end.
     2870     end.
     2871   end procedure.
     2872   procedure diasize_need-full-display :
     2873     define output parameter p-need-full-display as logical   no-undo .
     2874     do
     2875     on error undo, return error return-value
     2876     :
     2877       assign
     2878         p-need-full-display = v-diasize-need-full-display
     2879       .
     2880       assign
     2881         v-diasize-need-full-display = false
     2882       .
     2883     end.
     2884   end procedure.
     2885   procedure get-context :
     2886      define output parameter p-db-num as integer          no-undo.
     2887      define output parameter p-user-id as character        no-undo.
     2888      define variable v-login               as character    no-undo.
     2889      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2890      define buffer buf_user-login  for ub.user-login .
     2891      do
     2892      on error undo, return error
     2893      :
     2894            FIND FIRST buf_sys-ctrl no-lock.
     2895            ASSIGN
     2896               v-login = USERID("ub")
     2897               p-db-num = buf_sys-ctrl.db-num
     2898            .
     2899            FIND FIRST buf_user-login
     2900                 WHERE buf_user-login.db-num = p-db-num
     2901                   AND buf_user-login.user-login = v-login
     2902                 no-lock
     2903                 no-error
     2904                 .
     2905            IF AVAILABLE buf_user-login
     2906            THEN DO:
     2907               assign
     2908                  p-user-id = buf_user-login.user-id
     2909               .
     2910            END.
     2911      end.
     2912   end procedure.
