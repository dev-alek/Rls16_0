     2982        and
     2983        self :read-only = false
     2984        )
     2985     then do:
     2986       if self :handle <> focus :handle
     2987       then do:
     2988         apply "entry":u to self .
     2989       end.
     2990       run gbl/getcurdt.p
     2991         (output v-curr-sv-date
     2992         ) .
     2993       assign
     2994         self :screen-value = string(v-curr-sv-date) .
     2995       .
     2996     end.
     2997     return no-apply.
     2998   end.
     2999   on ctrl-b of sch-corr-date in frame Dialog-Frame
     3000   do:
     3001     if (can-query (self, "sensitive")
     3002        and
     3003        self :sensitive = true
     3004        )
     3005     or (can-query (self, "read-only")
     3006        and
     3007        self :read-only = false
     3008        )
     3009     then do:
     3010       if self :handle <> focus :handle
     3011       then do:
     3012         apply "entry":u to self .
     3013       end.
     3014       define variable v-curr-sv-date as date no-undo .
     3015       define variable v-new-sv-date  as date no-undo .
     3016       assign
