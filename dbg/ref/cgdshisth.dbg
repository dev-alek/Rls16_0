     5488   PROCEDURE proc-b-print :
     5489   define variable date_string     as      char    no-undo.
     5490   define variable Line                as      char    no-undo.
     5491   define variable for-time as char.
     5492   define variable accum-count as integer.
     5493   define variable v-doc-rec as recid no-undo.
     5494   define variable v-prod as character no-undo .
     5495   define variable v-subject-chr as character no-undo .
     5496   define variable v-upd-time as character no-undo .
     5497   define variable v-obj as character no-undo .
     5498   define variable v-action-chr as character no-undo .
     5499   define variable v-source-type as character no-undo .
     5500   DEFINE FRAME HistoryList
     5501   X_c-gds-hist.gds-code
     5502   v-action-chr FORMAT "X(10)"
     5503   v-gds-name COLUMN-LABEL "Назв. товара" FORMAT "X(20)"
     5504   v-artic COLUMN-LABEL "Артикул" FORMAT "X(14)"
     5505   v-prod COLUMN-LABEL "Пр-ль" FORMAT "X(12)"
     5506   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     5507   X_c-gds-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     5508   v-source-type COLUMn-LABEL "Источн.!измен"
     5509   X_c-gds-hist.source-ref COLUMn-LABEL "№"
     5510   X_c-gds-hist.corr-date
     5511   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     5512   X_c-gds-hist.corr-user-name
     5513   X_c-gds-hist.corr-user-db-num
     5514   X_c-gds-hist.host-code COLUMN-LABEL "Фирма"
     5515   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     5516   HEADER  date_string AT 5 format "X(35)"
     5517   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5518   Line format "X(192)" AT 1
     5519   with width 232 down stream-io use-text    .
     5520   Line = fill("-", 192).
     5521   date_string = cur-time-print() .
     5522   assign
     5523   v-doc-rec = recid( X_c-gds-hist ).
     5524   DO WHILE available X_c-gds-hist :
     5525         GET prev br-gds-hist.
     5526   END.
     5527   run prn-lib-open-stream  in this-procedure (
     5528                                                input parparentProc
     5529                                               ,input 43
     5530                                               ,input yes
     5531                                               ,input no
     5532                                               ).
     5533   PUT  STREAM PrnLibStream
     5534   SPACE(25) ( frame Dialog-Frame:title )
     5535   format "x(90)" SKIP(1) .
     5536   FORM HEADER
     5537   Line format "X(177)" AT 1 SKIP
     5538   "Продолжение - на следующей странице" AT 30 SKIP
     5539   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5540   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5541   FORM with FRAME HistoryList  .
     5542   run waitfram-show in this-procedure ("Ждите...").
     5543     GET next br-gds-hist.
