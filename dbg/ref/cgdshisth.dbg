     3114         then do:
     3115           assign
     3116             self :screen-value = string(v-curr-sv-date) .
     3117           .
     3118         end.
     3119       end.
     3120     end.
     3121     return no-apply .
     3122   end.
     3123     define MENU m-ed-date21
     3124       MENU-ITEM m-ed-date21-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3125       MENU-ITEM m-ed-date21-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3126       MENU-ITEM m-ed-date21-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3127       MENU-ITEM m-ed-date21-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
