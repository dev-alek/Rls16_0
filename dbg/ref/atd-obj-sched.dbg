        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":u .
        5   define variable vss-author      as character no-undo init "$Author$":u .
        6   define variable vss-date        as character no-undo init "$Date$":u .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        8   define variable vss-archive     as character no-undo init "$Archive$":u .
        9   define variable vss-description as character no-undo init "Управление расписанием сообщений" .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   procedure proc-alt-shift-f2:
       65     if not ibs.th.gbl.gbl-var:rcode
       66   then
       67     run gbl\inidebug.p .
       68   end.
       69   procedure proc-alt-shift-f3:
       70     run gbl/prvssinf.p
       71       ( input this-procedure
       72       ) .
       73   end.
       74   define variable v-inform-launched as logical no-undo initial false .
       75   procedure proc-alt-shift-f4:
       76     define variable v-action as character no-undo .
       77     if v-inform-launched = false then do:
       78       assign
       79         v-inform-launched = true
       80       .
       81       run gbl/d-inform.w
       82         (  input self
       83         ,  input this-procedure
       84         , output v-action
       85         ) no-error .
       86       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       87       assign
       88         v-inform-launched = false
       89       .
       90     end.
       91   end.
       92   procedure proc-alt-f1:
       93     run gbl/corrhelp.p
       94       (input this-procedure
       95       ) .
       96   end .
       97   on alt-shift-f2 anywhere do:
       98     run proc-alt-shift-f2.
       99   end.
      100   on alt-shift-f3 anywhere do:
      101     run proc-alt-shift-f3 in this-procedure .
      102   end.
      103   on alt-shift-f4 anywhere do:
      104     run proc-alt-shift-f4 in this-procedure.
      105   end.
      106   on alt-f1 anywhere do:
      107     run proc-alt-f1 in this-procedure .
      108   end.
      109   define new global shared variable g#language as character no-undo .
      110   if g#language <> '' and g#language <> 'rus':U then do:
      111     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      112   end.
      113   define buffer buf_clients for ub.clients .
      114   define buffer buf2_clients for ub.clients .
      115   define buffer buf_clients-attr for ub.clients-attr .
      116   DEFINE BUTTON b-cancel AUTO-END-KEY
      117        LABEL "Отмена"
      118        SIZE 15 BY 1.14
      119        BGCOLOR 8 .
      120   DEFINE BUTTON b-ok AUTO-GO
      121        LABEL "Ввод"
      122        SIZE 15 BY 1.14
      123        BGCOLOR 8 .
      124   DEFINE VARIABLE f-level AS integer FORMAT ">>9":U
      125        LABEL "Сообщения по превышению уровня повторять каждые"
      126        VIEW-AS FILL-IN
      127        SIZE 10 BY 1 NO-UNDO.
      128   DEFINE VARIABLE f-water AS integer FORMAT ">>9":U
      129        LABEL "Сообщения по воде повторять каждые"
      130        VIEW-AS FILL-IN
      131        SIZE 10 BY 1 NO-UNDO.
      132   DEFINE VARIABLE rs-obj AS INTEGER
      133        VIEW-AS RADIO-SET HORIZONTAL
      134        RADIO-BUTTONS
      135             "Текущий объект", 1,
      136   "По фирме", 2
      137        SIZE 36 BY 1.1 NO-UNDO.
      138   DEFINE FRAME Dialog-Frame
      139        b-ok AT ROW 1.24 COL 3
      140        b-cancel AT ROW 1.24 COL 17.8
      141        f-water AT ROW 3.14 COL 58 COLON-ALIGNED WIDGET-ID 2
      142        f-level AT ROW 4.57 COL 58 COLON-ALIGNED WIDGET-ID 6
      143        rs-obj AT ROW 6.48 COL 35 NO-LABEL WIDGET-ID 10
      144        "Установить на:" VIEW-AS TEXT
      145             SIZE 17 BY .62 AT ROW 6.67 COL 15.8 WIDGET-ID 14
      146        "мин." VIEW-AS TEXT
      147             SIZE 6 BY .62 AT ROW 3.33 COL 70.6 WIDGET-ID 4
      148        "мин." VIEW-AS TEXT
      149             SIZE 6 BY .62 AT ROW 4.81 COL 70.6 WIDGET-ID 8
      150        SPACE(1.39) SKIP(2.85)
      151       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      152            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      153            TITLE "Управление расписанием сообщений"
      154            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
      155   ASSIGN
      156          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      157          FRAME Dialog-Frame:HIDDEN           = TRUE.
      158   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      159   DO:
      160     APPLY "END-ERROR":U TO SELF.
      161   END.
      162   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      163   DO:
      164     assign
      165       f-water
      166       f-level
      167       rs-obj
      168     .
      169     case rs-obj :
      170       when 1
      171       then do :
      172         run save-obj (input p-obj-type,
      173                       input p-obj-code)
      174                       .
      175         run trg/userlog.p (
      176                 input 'atd-alarm-sched'
      177               , input ("Период алармов с АТД на объекте " +
      178                       buf_clients.obj-type + string(buf_clients.obj-code) +
      179                       substitute("; вода: &1мин; уровень: &2мин", f-water, f-level) +
      180                       chr(3) +
      181                       buf_clients.obj-type + string(buf_clients.obj-code) +
      182                       substitute("; вода: &1мин; уровень: &2мин", f-water, f-level) )
      183               , input ?
      184               , input ?
      185               , input ""
      186               ) no-error.
      187         if error-status :error
      188         then do:
      189             message return-value + error-status:get-message(1) view-as alert-box title "Ошибка записи истории действий пользователя".
      190         end.
      191       end .
      192       when 2
      193       then do :
      194         for each buf2_clients no-lock where buf2_clients.host-code = buf_clients.host-code :
      195           run save-obj (input buf2_clients.obj-type,
      196                         input buf2_clients.obj-code)
      197                         .
      198         end .
      199         run trg/userlog.p (
      200                 input 'atd-alarm-sched'
      201               , input ("Период алармов с АТД по фирме орг" +
      202                       string(buf_clients.host-code) +
      203                       substitute("; вода: &1мин; уровень: &2мин", f-water, f-level) +
      204                       chr(3) +
      205                       "орг" + string(buf_clients.host-code) +
      206                       substitute("; вода: &1мин; уровень: &2мин", f-water, f-level) )
      207               , input ?
      208               , input ?
      209               , input ""
      210               ) no-error.
      211         if error-status :error
      212         then do:
      213             message return-value + error-status:get-message(1) view-as alert-box title "Ошибка записи истории действий пользователя".
      214         end.
      215       end .
      216     end case .
      217   END.
      218   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      219   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      220   MAIN-BLOCK:
      221   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      222      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      223     find first buf_clients no-lock where buf_clients.obj-type = p-obj-type
      224                                      and buf_clients.obj-code = p-obj-code
      225                                      .
      226     for first buf_clients-attr no-lock where buf_clients-attr.obj-type = buf_clients.obj-type
      227                                          and buf_clients-attr.obj-code = buf_clients.obj-code
      228                                          and buf_clients-attr.attr-code = 'atd-alarm-schedule':U
      229                                          and buf_clients-attr.attr-value > ""
      230                                          :
      231       if num-entries(buf_clients-attr.attr-value) = 2
      232       then do :
      233         f-water = integer(entry(1, buf_clients-attr.attr-value)) .
      234         f-level = integer(entry(2, buf_clients-attr.attr-value)) .
      235       end .
      236     end .
      237     RUN enable_UI.
      238     WAIT-FOR GO OF FRAME Dialog-Frame.
      239   END.
      240   RUN disable_UI.
      241   procedure save-obj :
      242     define input parameter p-obj-type like ub.clients.obj-type no-undo .
      243     define input parameter p-obj-code like ub.clients.obj-code no-undo .
      244     find first buf_clients-attr exclusive-lock where buf_clients-attr.obj-type = p-obj-type
      245                                                  and buf_clients-attr.obj-code = p-obj-code
      246                                                  and buf_clients-attr.attr-code = 'atd-alarm-schedule':U
      247                                                  no-error .
      248     if not available buf_clients-attr
      249     then do :
      250       create buf_clients-attr .
      251       assign
      252         buf_clients-attr.obj-type = p-obj-type
      253         buf_clients-attr.obj-code = p-obj-code
      254         buf_clients-attr.attr-code = 'atd-alarm-schedule':U
      255       .
      256     end.
      257     assign
      258       buf_clients-attr.attr-value = string(f-water) + "," + string(f-level)
      259     .
      260   end procedure .
      261   PROCEDURE disable_UI :
      262     HIDE FRAME Dialog-Frame.
      263   END PROCEDURE.
      264   PROCEDURE enable_UI :
      265     DISPLAY f-water f-level rs-obj
      266         WITH FRAME Dialog-Frame.
      267     ENABLE b-ok b-cancel f-water f-level rs-obj
      268         WITH FRAME Dialog-Frame.
      269     VIEW FRAME Dialog-Frame.
      270   END PROCEDURE.
