     1319         (input  (p-new-height - frame Dialog-Frame :height)
     1320         ,input  p-move-resize
     1321         ) .
     1322     end.
     1323   end procedure.
     1324   procedure diasize_change-width :
     1325     define input  parameter p-change-value as decimal   no-undo .
     1326     define input  parameter p-move-resize  as logical   no-undo .
     1327     define variable v-field-group-handle   as handle    no-undo .
