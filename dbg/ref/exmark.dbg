     1333     define variable v-window-virtual-width as decimal   no-undo .
     1334     define variable v-change-sign          as integer   no-undo .
     1335     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1336     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1337     if p-change-value > 0
     1338     then do:
     1339       if frame Dialog-Frame :width + p-change-value >
     1340           session :width-chars
     1341       then do:
     1342         assign
     1343           p-change-value = session :width-chars - frame Dialog-Frame :width
     1344         .
     1345         if p-change-value <= 0
     1346         then do:
     1347           run diasize_position-resize-button in this-procedure .
     1348           return .
     1349         end.
     1350       end.
     1351     end.
     1352     if p-change-value < 0
     1353     then do:
     1354       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1355       then do:
     1356         assign
     1357           p-change-value = v-diasize-orig-frame-width
     1358                          - frame Dialog-Frame :width
     1359         .
     1360         if p-change-value >= 0
     1361         then do:
     1362           run diasize_position-resize-button in this-procedure .
     1363           return .
     1364         end.
     1365       end.
     1366     end.
     1367     if p-change-value >= 0
     1368     then do:
     1369       assign
     1370         v-change-sign = 1
     1371       .
     1372     end.
     1373     else do:
     1374       assign
     1375         v-change-sign = -1
     1376       .
     1377     end.
     1378     assign
     1379       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1380     .
     1381     if p-change-value = 0
     1382     then do:
     1383       run diasize_position-resize-button in this-procedure .
     1384       return .
     1385     end.
