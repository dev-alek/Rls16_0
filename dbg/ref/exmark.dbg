      801   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      802   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      803   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      804   on help of frame Dialog-Frame
      805   do:
      806     run gbl/app_help.p
      807       (input this-procedure :file-name
      808       ,input ''
      809       ,input ?
      810       ) no-error.
      811     if error-status :error then do:
      812       message
      813         "Ошибка при вызове помощи"
      814         error-status :get-message(1)
      815         view-as alert-box .
      816     end.
      817   end.
      818   run minbtn-set in this-procedure .
      819   on choose of b-help in frame Dialog-Frame
      820   do:
      821     apply "help":u to frame Dialog-Frame .
      822   end.
      823   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   procedure minbtn-set :
      825       do
      826           on error undo, return error return-value
      827           :
      828           define variable ii              as integer       no-undo .
      829           define variable fh              as widget-handle no-undo .
      830           define variable hh              as widget-handle no-undo .
      831           define variable v-h             as handle        extent 4 no-undo .
      832           define variable v-name-button   as character     no-undo .
      833           define variable v-help-old-x    as decimal       no-undo .
      834           define variable v-help-old-y    as decimal       no-undo .
      835           define variable v-help-old-size as decimal       no-undo .
      836           define variable v-frame-width   as decimal       no-undo .
      837           define variable jj              as integer       no-undo .
      838           do
      839               on error undo, return error
      840               :
      841               assign
      842                   v-frame-width = frame Dialog-Frame:width - 0.3
      843                   fh            = frame Dialog-Frame:first-child
      844                   hh            = fh:first-child
      845                   ii            = 1
      846                   .
      847               do while valid-handle(hh):
      848                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      849                   do:
      850                       case lc(hh:name) :
      851                           when "b-help" then
      852                               do:
      853                                   hh:load-image-up("cmp/b-help.bmp":u) .
      854                                   hh:load-image-down("cmp/b-help.bmp":u) .
      855                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      856                                   hh:TOOLTIP = "Помощь" .
      857                                   v-help-old-x = hh:column .
      858                                   v-help-old-y = hh:row    .
      859                                   v-help-old-size = hh:width .
      860                                   hh:width-chars = 2.5 .
      861                               end.
      862                           when "b-print" then
      863                               do:
      864                                   hh:load-image("cmp/b-print.bmp":u) .
      865                                   hh:TOOLTIP = "Печать" .
      866                                   v-h[ii] = hh:handle .
      867                                   ii = ii + 1 .
      868                                   hh:width-chars = 3 .
      869                               end.
      870                           when "b-history" or
      871                           when "b-hist" then
      872                               do:
      873                                   hh:load-image("cmp/b-hist.bmp":u) .
      874                                   hh:TOOLTIP = "История" .
      875                                   v-h[ii] = hh:handle .
      876                                   ii = ii + 1 .
      877                                   hh:width-chars = 3 .
      878                               end.
      879                           when "b-sch" then
      880                               do:
      881                                   hh:load-image("cmp/b-sch.bmp":u) .
      882                                   hh:TOOLTIP = "Установка Фильтра" .
      883                                   v-h[ii] = hh:handle .
      884                                   ii = ii + 1 .
      885                                   hh:width-chars = 3 .
      886                               end.
      887                           when "b-hist-user" then
      888                               do:
      889                                   hh:load-image("cmp/b-hist.bmp":u) .
      890                                   hh:TOOLTIP = "История пользователя" .
      891                                   ii = ii + 1 .
      892                               end.
      893                       end case.
      894                   end.
      895                   hh = hh:next-sibling.
      896               end.
      897               b-help:column = v-frame-width - b-help:width-chars.
      898               jj = 0.
      899               repeat ii = 4 to 1 by -1 :
      900                   if valid-handle (v-h[ii] ) then
      901                   do:
      902                       jj  = jj + 1 .
      903                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      904                       v-h[ii]:row    = v-help-old-y .
      905                   end.
      906               end.
      907           end.
      908       end.
      909   end procedure.
      910   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      911   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      912   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      913   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      914   define variable v-diasize-current-frame-width  as decimal   no-undo .
      915   define variable v-diasize-current-frame-height as decimal   no-undo .
      916   define variable v-diasize-change-size          as logical   no-undo .
      917   define variable v-diasize-resize-button        as handle    no-undo .
      918   define variable v-diasize-wndmax               as logical   no-undo .
      919   define variable v-diasize-wndstore             as logical   no-undo .
      920   define variable v-diasize-proc-name            as character no-undo .
      921   define variable v-diasize-browse-handle        as handle    no-undo .
      922   define variable v-diasize-browse-number        as integer   no-undo .
      923   define variable v-diasize-need-full-display    as logical   no-undo init false .
      924   define temp-table temp-diasize-handle no-undo
      925     field handle-value  as handle
      926     field save-position as decimal
      927     index xpk is primary unique handle-value
      928     .
      929   define temp-table temp-browse-handle no-undo
      930     field browse-type   as character
      931     field browse-number as integer
      932     field browse-handle as handle
      933     field original-size as decimal
      934     index xpk is primary unique browse-type browse-number
      935     index xie browse-type browse-handle
      936   .
      937   procedure diasize_change-height :
      938     define input  parameter p-change-value  as decimal   no-undo .
      939     define input  parameter p-move-resize   as logical   no-undo .
      940     define variable v-field-group-handle    as handle    no-undo .
      941     define variable v-object-handle         as handle    no-undo .
      942     define variable v-frame-height          as decimal   no-undo .
      943     define variable v-frame-virtual-height  as decimal   no-undo .
      944     define variable v-browse-height         as decimal   no-undo .
      945     define variable v-window-height         as decimal   no-undo .
      946     define variable v-window-virtual-height as decimal   no-undo .
      947     define variable v-change-sign           as integer   no-undo .
      948     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      949     define buffer buf_temp-browse-handle  for temp-browse-handle .
      950     if p-change-value > 0
      951     then do:
      952       if frame Dialog-Frame :height + p-change-value
      953           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      954       then do:
      955         assign
      956           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      957                           - (frame Dialog-Frame :height-chars)
      958         .
      959         if p-change-value <= 0
      960         then do:
      961           run diasize_position-resize-button in this-procedure .
      962           return .
      963         end.
      964       end.
      965     end.
      966     if p-change-value < 0
      967     then do:
      968       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      969       then do:
      970         assign
      971           p-change-value = v-diasize-orig-frame-height
      972                          - (frame Dialog-Frame :height-chars)
      973         .
      974         if p-change-value >= 0
      975         then do:
      976           run diasize_position-resize-button in this-procedure .
      977           return .
      978         end.
      979       end.
      980     end.
      981     if p-change-value >= 0
      982     then do:
      983       assign
      984         v-change-sign = 1
      985       .
      986     end.
      987     else do:
      988       assign
      989         v-change-sign = -1
      990       .
      991     end.
      992     assign
      993       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      994     .
      995     if p-change-value = 0
      996     then do:
      997       run diasize_position-resize-button in this-procedure .
      998       return .
      999     end.
     1000     move_block:
     1001     do
     1002     on error undo move_block, retry move_block
     1003     :
     1004       if retry
     1005       then do:
     1006         do
     1007         on error undo move_block, leave move_block
     1008         :
     1009           if p-change-value > 0
     1010           then do:
     1011             for each buf_temp-diasize-handle
     1012             on error undo, next
     1013             :
     1014               assign
     1015                 v-object-handle = buf_temp-diasize-handle.handle-value
     1016               .
     1017               if v-object-handle <> v-diasize-resize-button
     1018               then do:
     1019                 assign
     1020                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1021                 .
     1022               end.
     1023             end.
     1024             assign
     1025               v-diasize-browse-handle :height = v-browse-height
     1026             .
     1027             for each buf_temp-browse-handle
     1028               where buf_temp-browse-handle.browse-type = 'height':u
     1029             on error undo, next
     1030             :
     1031               assign
     1032                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1033               .
     1034             end.
     1035             assign
     1036               frame Dialog-Frame :height = v-frame-height
     1037             .
     1038             if frame Dialog-Frame :scrollable = true
     1039             then do:
     1040               assign
     1041                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1042               .
     1043             end.
     1044             run diasize_position-resize-button in this-procedure .
     1045           end.
     1046           else do:
     1047             if frame Dialog-Frame :scrollable = true
     1048             then do:
     1049               assign
     1050                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1051               .
     1052             end.
     1053             assign
     1054               frame Dialog-Frame :height = v-frame-height
     1055             .
     1056             assign
     1057               v-diasize-browse-handle :height = v-browse-height
     1058             .
     1059             for each buf_temp-browse-handle
     1060               where buf_temp-browse-handle.browse-type = 'height':u
     1061             on error undo, next
     1062             :
     1063               assign
     1064                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
