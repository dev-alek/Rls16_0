     1675       end.
     1676       if v-diasize-wndstore = true
     1677       then do:
     1678         if connected("ub") = true
     1679         then do:
     1680           define variable v-cntxt-db-num        as integer   no-undo .
     1681           define variable v-cntxt-userid        as character no-undo .
     1682           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1683                                             , OUTPUT v-cntxt-userid
     1684                                             ) .
     1685           run gbl/wndsizew.p
     1686             (input  v-cntxt-db-num
     1687             ,input  v-cntxt-userid
     1688             ,input  v-diasize-proc-name
     1689             ,input  'width':u
     1690             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1691             ) .
     1692         end.
     1693       end.
     1694     end.
     1695     assign
     1696       v-diasize-change-size = false
     1697     .
     1698   end procedure.
     1699   procedure diasize_set-width :
     1700     define input  parameter p-new-width  as decimal   no-undo .
     1701     define input  parameter p-move-resize as logical   no-undo .
     1702     do
     1703     on error undo, return error return-value
     1704     :
     1705       run diasize_change-width in this-procedure
     1706         (input  (p-new-width - frame Dialog-Frame :width)
     1707         ,input  p-move-resize
     1708         ) .
     1709     end.
     1710   end procedure.
     1711   procedure diasize_position-resize-button :
     1712     do with frame Dialog-Frame
     1713     :
     1714       hide v-diasize-resize-button .
     1715       assign
     1716         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1717                     - 1
     1718                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1719         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1720                     - 1
     1721                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1722       .
     1723       view v-diasize-resize-button .
     1724     end.
     1725   end procedure.
     1726   on alt-right anywhere
     1727   do:
     1728     run diasize_change-width in this-procedure
     1729       (input 1
     1730       ,input true
     1731       ) .
     1732     return no-apply .
     1733   end.
     1734   on alt-left anywhere
     1735   do:
     1736     run diasize_change-width in this-procedure
     1737       (input -1
     1738       ,input true
     1739       ) .
     1740     return no-apply .
     1741   end.
     1742   on alt-down anywhere
     1743   do:
     1744     run diasize_change-height in this-procedure
     1745       (input 1
     1746       ,input true
     1747       ) .
     1748     return no-apply .
     1749   end.
     1750   on alt-up anywhere
     1751   do:
     1752     run diasize_change-height in this-procedure
     1753       (input -1
     1754       ,input true
     1755       ) .
     1756     return no-apply .
     1757   end.
     1758   on alt-enter of frame Dialog-Frame
     1759   do:
     1760     run diasize_maximize in this-procedure
     1761       (input  ?
     1762       ).
     1763     return no-apply .
     1764   end.
     1765   procedure diasize_end-move :
     1766     do
     1767     on error undo, return error return-value
     1768     :
     1769       define variable v-row-delta as decimal   no-undo .
     1770       define variable v-col-delta as decimal   no-undo .
     1771       define variable v-new-row as decimal   no-undo .
     1772       define variable v-new-col as decimal   no-undo .
     1773       assign
     1774         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1775         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1776       .
     1777       assign
     1778         v-row-delta = v-new-row - frame Dialog-Frame :height
     1779         v-col-delta = v-new-col - frame Dialog-Frame :width
     1780       .
     1781       run diasize_change-height in this-procedure
     1782         (input v-row-delta
     1783         ,input true
     1784         ) .
     1785       run diasize_change-width in this-procedure
     1786         (input v-col-delta
     1787         ,input true
     1788         ) .
     1789     end.
     1790   end procedure.
     1791   procedure diasize_maximize :
     1792     define input  parameter p-action as logical   no-undo .
     1793     do
     1794     on error undo, return error return-value
     1795     :
     1796       if p-action = ?
     1797       then do:
     1798         if v-diasize-need-maximize = true
     1799         then do:
     1800           assign
     1801             p-action = true
     1802           .
     1803         end.
     1804         else do:
     1805           assign
     1806             p-action = false
     1807           .
     1808         end.
     1809       end.
     1810       if p-action = true
     1811       then do:
     1812         run diasize_change-height in this-procedure
     1813           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1814               - frame Dialog-Frame :height-chars
     1815           ,input true
     1816           ) .
     1817         run diasize_change-width in this-procedure
     1818           (input session :width-chars
     1819               - frame Dialog-Frame :width-chars
     1820           ,input true
     1821           ) .
     1822         assign
     1823           v-diasize-need-maximize = false
     1824         .
     1825       end.
     1826       else do:
     1827         run diasize_change-width in this-procedure
     1828           (input v-diasize-orig-frame-width
     1829               - frame Dialog-Frame :width-chars
     1830           ,input true
     1831           ) .
     1832         run diasize_change-height in this-procedure
     1833           (input v-diasize-orig-frame-height
     1834               - frame Dialog-Frame :height-chars
     1835           ,input true
     1836           ) .
     1837         assign
     1838           v-diasize-need-maximize = true
     1839         .
     1840       end.
     1841     end.
     1842   end procedure.
     1843   procedure diasize_restore-orig-size :
     1844     do
     1845     on error undo, return error return-value
     1846     :
     1847       assign
     1848         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1849         v-diasize-current-frame-height = frame Dialog-Frame :height
     1850       .
     1851       run diasize_set-height in this-procedure
     1852         (input  v-diasize-orig-frame-height
     1853         ,input  true
     1854         ) .
     1855       run diasize_set-width in this-procedure
     1856         (input  v-diasize-orig-frame-width
     1857         ,input  true
     1858         ) .
     1859     end.
     1860   end procedure.
     1861   procedure diasize_restore-current-size :
     1862     do
     1863     on error undo, return error return-value
     1864     :
     1865       run diasize_set-height in this-procedure
     1866         (input  v-diasize-current-frame-height
     1867         ,input  true
     1868         ) .
     1869       run diasize_set-width in this-procedure
     1870         (input  v-diasize-current-frame-width
     1871         ,input  true
     1872         ) .
     1873     end.
     1874   end procedure.
     1875   procedure diasize_set-browse-handle :
     1876     define input  parameter p-browse-handle as handle   no-undo .
     1877     define buffer buf_temp-browse-handle for temp-browse-handle .
     1878     do
     1879     on error undo, return error return-value
     1880     :
     1881       assign
     1882         v-diasize-browse-handle = p-browse-handle
     1883       .
     1884       for each buf_temp-browse-handle
     1885       on error undo, return error return-value
     1886       :
     1887         delete buf_temp-browse-handle .
     1888       end.
     1889     end.
     1890   end procedure.
     1891   procedure diasize_add_browse :
     1892     define input  parameter p-browse-type   as character no-undo .
     1893     define input  parameter p-browse-handle as handle    no-undo .
     1894     define buffer buf_temp-browse-handle for temp-browse-handle .
     1895     do
     1896     on error undo, return error return-value
     1897     :
     1898       assign
     1899         v-diasize-browse-number = v-diasize-browse-number + 1
     1900       .
     1901       create buf_temp-browse-handle .
     1902       assign
     1903         buf_temp-browse-handle.browse-type   = p-browse-type
     1904         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1905         buf_temp-browse-handle.browse-handle = p-browse-handle
     1906       .
     1907     end.
     1908   end procedure.
     1909   procedure diasize_init :
     1910     define variable v-default-value    as logical   no-undo .
     1911     define variable v-restore-saved    as logical   no-undo .
     1912     define variable v-resize-value-str as character no-undo .
     1913     do
     1914     on error undo, return error return-value
     1915     :
     1916       do with frame Dialog-Frame
     1917       :
     1918         assign
     1919           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1920           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1921           v-diasize-browse-handle     = browse br-exmark :handle
     1922         .
     1923         create button v-diasize-resize-button
     1924         assign
     1925           parent        = frame Dialog-Frame :first-child
     1926           label         = "s"
     1927           height-pixels = 16
     1928           width-pixels  = 16
     1929           visible       = true
     1930           sensitive     = true
     1931           movable       = true
     1932           triggers:
     1933             on end-move persistent run diasize_end-move in this-procedure .
     1934           end triggers.
     1935         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1936         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1937         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1938         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1939         assign
     1940           v-diasize-wndmax = false
     1941         .
     1942         if connected("ub") = true
     1943         then do:
     1944           define variable v-cntxt-db-num        as integer   no-undo .
     1945           define variable v-cntxt-userid        as character no-undo .
     1946           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1947                                             , OUTPUT v-cntxt-userid
     1948                                             ) .
     1949           run gbl/wndpar_r.p
     1950             (input  v-cntxt-db-num
     1951             ,input  v-cntxt-userid
     1952             ,input  'wndmax':U
     1953             ,output v-diasize-wndmax
     1954             ,output v-default-value
     1955             ) .
     1956         end.
     1957         assign
     1958           v-diasize-wndstore = false
     1959         .
     1960         if connected("ub") = true
     1961         then do:
     1962           run gbl/wndpar_r.p
     1963             (input  v-cntxt-db-num
     1964             ,input  v-cntxt-userid
     1965             ,input  'wndstore':U
     1966             ,output v-diasize-wndstore
     1967             ,output v-default-value
     1968             ) .
     1969         end.
     1970         assign
     1971           v-diasize-proc-name = entry(1, program-name(2), '.')
     1972         .
     1973         if v-diasize-wndstore = true
     1974         then do:
     1975           assign
     1976             v-restore-saved = false
     1977           .
     1978           if connected("ub") = true
     1979           then do:
     1980             run gbl/wndsizer.p
     1981               (input  v-cntxt-db-num
     1982               ,input  v-cntxt-userid
     1983               ,input  v-diasize-proc-name
     1984               ,input  'height':u
     1985               ,output v-resize-value-str
     1986               ) .
     1987             if v-resize-value-str <> '':U
     1988             then do:
     1989               run diasize_change-height in this-procedure
     1990                 (input  integer(v-resize-value-str)
     1991                 ,input  true
     1992                 ) .
     1993               assign
     1994                 v-restore-saved = true
     1995               .
     1996             end.
     1997           end.
     1998           if connected("ub") = true
     1999           then do:
     2000             run gbl/wndsizer.p
     2001               (input  v-cntxt-db-num
     2002               ,input  v-cntxt-userid
     2003               ,input  v-diasize-proc-name
     2004               ,input  'width':u
     2005               ,output v-resize-value-str
     2006               ) .
     2007             if v-resize-value-str <> '':U
     2008             then do:
     2009               run diasize_change-width in this-procedure
     2010                 (input  integer(v-resize-value-str)
     2011                 ,input  true
     2012                 ) .
     2013               assign
     2014                 v-restore-saved = true
     2015               .
     2016             end.
     2017           end.
     2018           if v-restore-saved <> true
     2019           then do:
     2020             if v-diasize-wndmax = true
     2021             then do:
     2022               run diasize_maximize in this-procedure
     2023                 (input  true
     2024                 ) .
     2025             end.
     2026           end.
     2027         end.
     2028         else do:
     2029           if v-diasize-wndmax = true
     2030           then do:
     2031             run diasize_maximize in this-procedure
     2032               (input  true
     2033               ) .
     2034           end.
     2035         end.
     2036       end.
     2037     end.
     2038   end procedure.
     2039   procedure diasize_need-full-display :
     2040     define output parameter p-need-full-display as logical   no-undo .
     2041     do
     2042     on error undo, return error return-value
     2043     :
     2044       assign
     2045         p-need-full-display = v-diasize-need-full-display
     2046       .
     2047       assign
     2048         v-diasize-need-full-display = false
     2049       .
     2050     end.
     2051   end procedure.
     2052   procedure get-context :
     2053      define output parameter p-db-num as integer          no-undo.
     2054      define output parameter p-user-id as character        no-undo.
     2055      define variable v-login               as character    no-undo.
     2056      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2057      define buffer buf_user-login  for ub.user-login .
     2058      do
     2059      on error undo, return error
     2060      :
     2061            FIND FIRST buf_sys-ctrl no-lock.
     2062            ASSIGN
     2063               v-login = USERID("ub")
     2064               p-db-num = buf_sys-ctrl.db-num
     2065            .
     2066            FIND FIRST buf_user-login
     2067                 WHERE buf_user-login.db-num = p-db-num
     2068                   AND buf_user-login.user-login = v-login
     2069                 no-lock
     2070                 no-error
     2071                 .
     2072            IF AVAILABLE buf_user-login
     2073            THEN DO:
     2074               assign
     2075                  p-user-id = buf_user-login.user-id
     2076               .
     2077            END.
     2078      end.
     2079   end procedure.
     2080       run diasize_init in this-procedure .
     2081   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2082   do:
     2083     br-exmark :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2084   end.
     2085   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2086   on f5 of frame Dialog-Frame anywhere
     2087   do:
     2088     if available buf_ex-mark then     v-cur-recid = recid(buf_ex-mark).   run OpenBR in this-procedure (yes, no, '':U).   reposition br-exmark to recid v-cur-recid no-error.   apply 'entry' to br-exmark in frame Dialog-Frame.
     2089       apply "VALUE-CHANGED" to br-exmark.
     2090   end.
     2091   create query f-query.
     2092   create query h-query.
     2093   assign
     2094     h-query = br-exmark:query in frame Dialog-Frame
     2095     br-exmark:allow-column-searching in frame Dialog-Frame = yes.
     2096   .
     2097   def var sort-labelbr-exmark   as character no-undo .
     2098   def var sort-clmnbr-exmark    as handle    no-undo .
     2099   def var cur-clmnbr-exmark     as handle    no-undo .
     2100   def var cur-clmn-locbr-exmark as integer   no-undo .
     2101   def var re-querybr-exmark     as logical   initial no no-undo .
     2102   on start-search, ctrl-o of br-exmark in frame Dialog-Frame do:
     2103      run sort-brbr-exmark
     2104        (input (if available buf_ex-mark
     2105                then recid(buf_ex-mark)
     2106                else ?
     2107               )
     2108        ).
     2109   end.
     2110   PROCEDURE sort-brbr-exmark :
     2111     define input parameter p-recid as recid no-undo .
     2112     if re-querybr-exmark = no then do:
     2113       assign
     2114          cur-clmnbr-exmark = br-exmark:current-column in frame Dialog-Frame
     2115       .
     2116       if sort-clmnbr-exmark <> ? then sort-clmnbr-exmark:column-fgcolor = 0.
     2117       if cur-clmnbr-exmark = sort-clmnbr-exmark then do:
     2118         assign
     2119            sort-labelbr-exmark = ""
     2120            sort-clmnbr-exmark = ?
     2121         .
     2122        end.
     2123        else do:
     2124          assign
     2125            sort-labelbr-exmark = cur-clmnbr-exmark:label
     2126            sort-clmnbr-exmark  = cur-clmnbr-exmark
     2127            sort-clmnbr-exmark:column-fgcolor = 4
     2128          .
     2129        end.
     2130      end.
     2131     assign
     2132       cur-clmn-locbr-exmark = 1
     2133     .
     2134     def var column-handle as handle no-undo .
     2135     column-handle = br-exmark:first-column.
     2136     do while valid-handle(column-handle) :
     2137       if column-handle = cur-clmnbr-exmark then do:
     2138         leave .
     2139       end.
     2140       column-handle = column-handle:NEXT-COLUMN.
     2141       assign
     2142         cur-clmn-locbr-exmark = cur-clmn-locbr-exmark + 1
     2143       .
     2144     end.
     2145     case sort-labelbr-exmark:
     2146           when 'Код марки'  then DO:   assign     sort-column-name = "buf_ex-mark.mark-name"   .   run OpenBr in this-procedure (yes, no, '':U).   . END.
     2147           when 'Тип'  then DO:   assign     sort-column-name = "dynamic-function ('exmrklib_get-type-name', buf_ex-mark.mark-type)"   .   run OpenBr in this-procedure (yes, no, '':U).   . END.
     2148           when 'Статус'  then DO:   assign     sort-column-name = "dynamic-function ('exmrklib_get-status-name' , buf_ex-mark.stts)"   .   run OpenBr in this-procedure (yes, no, '':U).   . END.
     2149           when 'БД создания'  then DO:   assign     sort-column-name = "buf_ex-mark.db-num"   .   run OpenBr in this-procedure (yes, no, '':U).   . END.
     2150           when 'Внутренний код'  then DO:   assign     sort-column-name = "buf_ex-mark.mark-code"   .   run OpenBr in this-procedure (yes, no, '':U).   . END.
     2151       otherwise do:
     2152         assign
     2153           sort-column-name = ""
     2154         .
     2155         run OpenBr in this-procedure (yes, no, '':U).
     2156         if sort-labelbr-exmark <> "" then do:
     2157           assign
     2158             cur-clmnbr-exmark:column-fgcolor = 0
     2159           .
     2160         end.
     2161         assign
     2162           cur-clmn-locbr-exmark = ?
     2163         .
     2164       end.
     2165     end case.
     2166     if p-recid <> ? then do:
     2167       reposition br-exmark to recid p-recid no-error.
     2168       apply "value-changed" to br-exmark in frame Dialog-Frame.
     2169     end.
     2170     apply "entry" to br-exmark in frame Dialog-Frame.
     2171   END PROCEDURE.
     2172   procedure re-open-query-srt-clmnbr-exmark:
     2173   if cur-clmnbr-exmark = ? then do:
     2174      run OpenBr in this-procedure (yes, no, '':U).
     2175   end.
     2176   else do:
     2177      assign re-querybr-exmark = yes.
     2178      run sort-brbr-exmark
     2179        (input (if available buf_ex-mark
     2180                then recid(buf_ex-mark)
     2181                else ?
     2182               )
     2183        ).
     2184      assign re-querybr-exmark = no.
     2185   end.
     2186   end.
     2187   ON WINDOW-CLOSE OF FRAME Dialog-Frame APPLY "END-ERROR":U TO SELF.
     2188   MAIN-BLOCK:
     2189   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2190      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2191   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2192     run mainmenu_getcntxt in parParentProc
     2193       (output v-cntxt-db-num
     2194       ,output v-cntxt-userid
     2195       ,output v-cntxt-level
     2196       ,output v-cntxt-host-code-obj
     2197       ,output v-cntxt-obj-type
     2198       ,output v-cntxt-obj-code
     2199       ,output v-cntxt-db-num-obj
     2200       ,output v-cntxt-is-admin
     2201       ) .
     2202       RUN MyEnable in this-procedure.
     2203       RUN OpenBR in this-procedure (yes, no, '':U).
     2204       if p-rid-list <> "":U and p-rid-list <> ? then do:
     2205         assign
     2206           v-cur-recid = integer(entry (1, p-rid-list))
     2207         .
     2208         find buf_ex-mark no-lock where recid(buf_ex-mark) = v-cur-recid no-error.
     2209         if available buf_ex-mark and
     2210            buf_ex-mark.stts = integer('0':U)
     2211         then do:
     2212           reposition br-exmark to recid v-cur-recid no-error.
     2213           if num-results("br-exmark") > 0 then do:
     2214             br-exmark:select-focused-row( ).
     2215           end.
     2216         end.
     2217       end.
     2218       apply "entry" to br-exmark in frame Dialog-Frame.
     2219       WAIT-FOR GO OF FRAME Dialog-Frame.
     2220   END.
     2221   RUN my-disable IN THIS-PROCEDURE.
     2222   PROCEDURE disable_UI :
     2223     HIDE FRAME Dialog-Frame.
     2224   END PROCEDURE.
     2225   PROCEDURE my-disable :
     2226       delete object f-query.
     2227       delete object h-query.
     2228       RUN DISABLE_UI IN THIS-PROCEDURE.
     2229   END PROCEDURE.
     2230   PROCEDURE MyEnable :
     2231     assign
     2232       r-stts:radio-buttons in frame Dialog-Frame =
     2233                  "Текущие&+"   + chr(44) + '0':U + chr(44) +
     2234                  "Все&!"       + chr(44) + "2" + chr(44) +
     2235                  "Удаленные&-" + chr(44) + '1':U
     2236     .
     2237     display r-stts
     2238       with frame Dialog-Frame.
     2239     ENABLE
     2240         b-exit
     2241         b-add WHEN  (lookup  ( "b-add" , bttns) > 0)
     2242         b-sel WHEN  (lookup  ( "b-sel" , bttns) > 0)
     2243         b-upd WHEN  (lookup  ( "b-add" , bttns) > 0)
     2244         b-del WHEN  (lookup  ( "b-add" , bttns) > 0)
     2245         b-help
     2246         b-hist
     2247         r-type
     2248         r-stts
     2249         sch-code
     2250         br-exmark
     2251       WITH FRAME Dialog-Frame.
     2252   END PROCEDURE.
     2253   PROCEDURE OpenBR :
     2254     define input  parameter p-open-query     as logical   no-undo .
     2255     define input  parameter p-find-next      as logical   no-undo .
     2256     define input  parameter p-find-condition as character no-undo .
     2257     define variable v-query-prefix   as character no-undo.
     2258     define variable v-query-where    as character no-undo.
     2259     define variable v-query-by       as character no-undo.
     2260     define variable v-query-text     as character no-undo.
     2261     define variable v-find-text      as character no-undo.
     2262     define variable l-rec-found      as logical   no-undo.
     2263     v-mark-type = get-type-by-filter (r-type).
     2264     v-stts = get-stts-by-filter (r-stts).
     2265     assign
     2266       v-query-prefix = "for each buf_ex-mark no-lock":U
     2267       v-query-where = "":U
     2268       v-query-by    = "":U
     2269       v-query-text  = "":U
     2270     .
     2271     if v-mark-type <> ? then do :
     2272       assign
     2273         v-query-where = substitute ("buf_ex-mark.mark-type = &1":U, v-mark-type)
     2274       .
     2275     end.
     2276     if v-stts <> ? then do:
     2277       assign
     2278         v-query-where = (if v-query-where <> "":U then v-query-where + " and ":U else "":U)
     2279                       + substitute ("buf_ex-mark.stts = &1":U, v-stts)
     2280       .
     2281     end.
     2282     if v-query-where <> "":U then do:
     2283       assign
     2284         v-query-where = " where ":U + v-query-where
     2285       .
     2286     end.
     2287     if sort-column-name = "":U or sort-column-name = "buf_ex-mark.mark-name":U then do:
     2288       assign
     2289         v-query-by = " by buf_ex-mark.mark-name":U
     2290       .
     2291     end.
     2292     else do:
     2293       assign
     2294         v-query-by = " by ":U + sort-column-name
     2295                    + " by buf_ex-mark.mark-name":U
     2296       .
     2297     end.
     2298     assign
     2299       v-query-text = v-query-prefix
     2300                    + v-query-where
     2301                    + v-query-by
     2302                    + " indexed-reposition":U
     2303     .
     2304     run waitfram-show in this-procedure ("Подождите...").
     2305     if p-open-query then do:
     2306       if h-query:query-prepare(v-query-text) then do:
     2307         h-query:query-open().
     2308       end.
     2309       else do:
     2310         message
     2311           "Ошибка при фильтрации / сортировке" skip
     2312           "Будут показаны записи без учета фильтра" skip
     2313           view-as alert-box .
     2314         open query br-exmark
     2315          for each buf_ex-mark no-lock
     2316              by buf_ex-mark.mark-name indexed-reposition.
     2317       end.
     2318     end.
     2319     else do:
     2320       assign
     2321         l-rec-found = no
     2322         v-find-text = v-query-prefix
     2323                     + v-query-where
     2324                     + (if v-query-where <> "":U then " and ":U else "":U)
     2325                     + p-find-condition
     2326                     + v-query-by
     2327                     + " indexed-reposition":U
     2328         v-find-text = replace (v-find-text, "buf_ex-mark":U, "sch_ex-mark":U)
     2329       .
     2330       f-query:set-buffers(buffer sch_ex-mark:handle).
     2331       if f-query:query-prepare(v-find-text) then do:
     2332         f-query:query-open().
     2333         f-query:get-first().
     2334         if available sch_ex-mark then do:
     2335           if p-find-next and available buf_ex-mark then do:
     2336             if f-query:reposition-to-rowid (rowid(buf_ex-mark)) then do:
     2337               f-query:get-next().
     2338               if f-query:get-next() then do:
     2339                 l-rec-found = yes.
     2340               end.
     2341             end.
     2342           end.
     2343           else do:
     2344             l-rec-found = yes.
     2345           end.
     2346         end.
     2347         if l-rec-found then do:
     2348           v-cur-recid = recid(sch_ex-mark).
     2349           reposition br-exmark to recid v-cur-recid no-error.
     2350           if num-results("br-exmark") > 0 then do:
     2351             br-exmark:select-focused-row( ) in frame Dialog-Frame.
     2352           end.
     2353         end.
     2354       end.
     2355       else do:
     2356         message
     2357           vss-workfile vss-revision vss-description skip
     2358           "Ошибка при формировании запроса для поиска" skip(1)
     2359           v-find-text
     2360           view-as alert-box warning.
     2361       end.
     2362     end.
     2363     run waitfram-hide in this-procedure .
     2364   END PROCEDURE.
     2365   PROCEDURE proc-b-hist :
     2366     run ref/ex-markh.w ( input parparentproc
     2367                        , rowid( buf_ex-mark )
     2368                        ) .
     2369   END PROCEDURE.
     2370   PROCEDURE proc-find :
     2371     define input parameter p-find-next as logical   no-undo.
     2372     define input parameter p-code      as character no-undo.
     2373     define variable v-find-condition as character no-undo.
     2374     assign
     2375       v-find-condition = substitute (" buf_ex-mark.mark-name begins '&1' ", p-code)
     2376     .
     2377     run OpenBR in this-procedure
     2378       (input no
     2379       ,input p-find-next
     2380       ,input v-find-condition
     2381       ).
     2382   END PROCEDURE.
     2383   FUNCTION get-stts-by-filter RETURNS INTEGER
     2384     ( input p-filter-stts as integer ) :
     2385     define variable ret    as integer no-undo .
     2386     if p-filter-stts = integer('0':U) or
     2387        p-filter-stts = integer('1':U) then do:
     2388       assign
     2389         ret = p-filter-stts
     2390       .
     2391     end.
     2392     else do:
     2393       assign
     2394         ret = ?
     2395       .
     2396     end.
     2397     return ret .
     2398   END FUNCTION.
     2399   FUNCTION get-type-by-filter RETURNS INTEGER
     2400     ( input p-filter-type as integer ) :
     2401     define variable ret    as integer no-undo .
     2402     case p-filter-type:
     2403         when 1 then ret = 0.
     2404         when 2 then ret = 1.
     2405         otherwise   ret = ?.
     2406     end case.
     2407     return ret .
     2408   END FUNCTION.
