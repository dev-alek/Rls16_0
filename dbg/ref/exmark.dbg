        1   define input        parameter parParentProc as widget-handle no-undo.
        2   define input        parameter bttns         as char no-undo .
        3   define input-output parameter p-rid-list    as char no-undo .
        4   def var vss-revision    as character no-undo init "$Revision$":U .
        5   def var vss-author      as character no-undo init "$Author$":U .
        6   def var vss-date        as character no-undo init "$Date$":U .
        7   def var vss-workfile    as character no-undo init "$Workfile$":U .
        8   def var vss-archive     as character no-undo init "$Archive$":U .
        9   def var vss-description as character no-undo init "Справочник акцизных и специальных марок".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define variable v-waitfram-action01         as character   no-undo .
      117   define variable v-waitfram-action02         as character   no-undo .
      118   define variable v-waitfram-action03         as character   no-undo .
      119   define variable mWaitFramTextBeg            as character   no-undo.
      120   define variable mWaitFramTextEnd            as character   no-undo.
      121   define variable mWaitFramView               as logical     no-undo.
      122   define variable mWaitProcEvent              as logical     no-undo init yes.
      123   define variable mWaitFramInterval           as integer     no-undo init 1 .
      124   define variable mWaitFramStop               as logical     no-undo.
      125   define variable mWaitFramStopUser           as logical     no-undo.
      126   define variable mWaitFramStopTimeOut        as logical     no-undo.
      127   define variable mWaitFramStartProc          as datetime-tz no-undo.
      128   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      129   define button B-WaitFramStop auto-end-key
      130        label "Стоп"
      131        size 10 by 1 tooltip "Остоновить процесс".
      132   define button B-viewProcInfo
      133        label "Информация"
      134        size 15 by 1 tooltip "Информация о процесс".
      135   define frame waitfram
      136     v-waitfram-action01 format "x(72)" no-label skip
      137     v-waitfram-action02 format "x(72)" no-label skip
      138     v-waitfram-action03 format "x(72)" no-label skip
      139     B-viewProcInfo
      140     B-WaitFramStop at row 4 col 30
      141     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      142     .
      143   define new global shared variable mBatchMode as logical no-undo init ?.
      144   define variable mFramBachModHandle as handle no-undo.
      145   mFramBachModHandle = frame waitfram:handle.
      146   define variable mFameOldVis as logical no-undo.
      147   define variable mVisCUrentVin as logical no-undo.
      148   if session:batch-mode
      149   then
      150      mBatchMode = yes.
      151   if mBatchMode = ? then do:
      152     mVisCUrentVin = current-window:visible.
      153     mFameOldVis = mFramBachModHandle:visible.
      154     mFramBachModHandle:visible  = yes.
      155     mBatchMode = mFramBachModHandle:visible ne yes.
      156     mFramBachModHandle:visible = mFameOldVis.
      157     current-window:visible = mVisCUrentVin.
      158   end.
      159    if  log-manager:logfile-name ne ?
      160     then DO:
      161         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      162         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      163         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      164     end.
      165   on choose of B-WaitFramStop in frame waitfram
      166   do:
      167     mWaitFramStop = yes.
      168     mWaitFramStopUser = yes.
      169   end.
      170   function waitfram-check-timeout returns logical():
      171      define variable vtime as int64 no-undo.
      172      if mWaitFramStopTimeOut
      173      then
      174         return yes.
      175      vtime = ( now - mWaitFramStartProc ) / 1000 .
      176      if     mWaitFramTimeOut ne ?
      177         and mWaitFramTimeOut ne 0
      178         and mWaitFramTimeOut lt vtime
      179      then do:
      180         mWaitFramStopTimeOut = yes.
      181      end.
      182      return mWaitFramStopTimeOut.
      183   end.
      184   procedure waitfram-hide :
      185     if not session:batch-mode
      186     then do
      187     on error undo, return error return-value
      188     :
      189       pause 0 before-hide .
      190       if not mBatchMode then
      191         hide frame waitfram .
      192     if     not mWaitFramView
      193        and mWaitProcEvent
      194     then
      195       process events .
      196     end.
      197   end procedure.
      198   procedure waitfram-show :
      199     define input  parameter p-message as character no-undo .
      200     define variable v-left-margin as integer   no-undo .
      201     if not session:batch-mode
      202     then do
      203     on error undo, return error return-value
      204     :
      205       if length(p-message) <= 70 then do:
      206         assign
      207           v-left-margin = integer((70 - length(p-message)) / 2)
      208         .
      209         assign
      210           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      211         .
      212         assign
      213           v-waitfram-action01 = " "
      214           v-waitfram-action02 = " "
      215                                    + fill(" ", v-left-margin)
      216                                    + p-message
      217           v-waitfram-action03 = " "
      218         .
      219       end.
      220       else do:
      221         define variable vRindex1 as integer no-undo.
      222         define variable vRindex2 as integer no-undo.
      223         vRindex1 = r-index(p-message," ",70).
      224         if vRindex1 = 0
      225         then
      226            vRindex1 = 70.
      227         if length(p-message)  <= vRindex1 + 70 then do:
      228           assign
      229             v-waitfram-action01 = " "
      230             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      231             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      232           .
      233         end.
      234         else do:
      235           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      236           if vRindex2 <= vRindex1
      237           then
      238              vRindex2 = vRindex1 + 70.
      239           assign
      240             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      243           .
      244         end.
      245       end.
      246       B-viewProcInfo:visible   in frame waitfram = no.
      247       B-viewProcInfo:sensitive in frame waitfram = no.
      248       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      249       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      250       if  (   mWaitFramView
      251          or  mWaitProcEvent)
      252          and not mBatchMode
      253       then
      254          display
      255             v-waitfram-action01 skip
      256             v-waitfram-action02 skip
      257             v-waitfram-action03 skip
      258          with frame waitfram .
      259       if     mWaitFramView
      260          then do:
      261             if     mWaitFramInterval ne ?
      262                and not mBatchMode
      263             then
      264                wait-for go of frame waitfram pause mWaitFramInterval.
      265          end.
      266          else
      267             if     mWaitProcEvent
      268                and not mBatchMode
      269             then
      270                process events .
      271     end.
      272   end procedure.
      273      procedure waitfram-show-this:
      274         define input  parameter iInterval as int64 no-undo.
      275         define variable vtime as int64 no-undo.
      276         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      277         mWaitFramInterval = iInterval.
      278         run waitfram-show (substitute("&1&2 &3&4" ,
      279                                       mWaitFramTextBeg ,
      280                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      281                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      282                                       mWaitFramTextEnd
      283                                      )
      284                           ).
      285      end.
      286      procedure WaitFramRunPause:
      287         define input  parameter iInterval as dec no-undo.
      288         define variable vStart  as datetime-tz no-undo.
      289         define variable vend    as datetime-tz no-undo.
      290         define variable vint as int64 no-undo.
      291         define variable vOk as logical no-undo.
      292         vStart = now.
      293         vend   = vStart.
      294         publish "WaitFramPause" (iInterval,output vOk).
      295         vend   =  now.
      296         vint = vend - vStart.
      297         vint = iInterval - vint / 1000.
      298         if     not mWaitFramStop
      299            and (   vint > 0
      300                 or (    not vOk
      301                     and iInterval eq ?
      302                     )
      303                 )
      304         then
      305            run waitfram-show-this (iInterval).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and vint > 0
      311         then do:
      312            run gbl/pause.p (vint * 1000).
      313         end.
      314         if iInterval ne ?
      315         then
      316            publish "WaitFramStop".
      317         waitfram-check-timeout().
      318      end.
      319      procedure WaitFramWaitFor:
      320         define input  parameter iInterval as dec no-undo.
      321         assign
      322            mWaitFramStartProc   = now
      323            mWaitFramStopUser    = no
      324            mWaitFramStopTimeOut = no
      325         .
      326         block-wait:
      327         do while not mWaitFramStop:
      328            run WaitFramRunPause (iInterval).
      329            if  waitfram-check-timeout()
      330            then do:
      331               leave block-wait.
      332            end.
      333         end.
      334         run waitfram-hide.
      335      end.
      336   procedure waitfram-join :
      337     define input  parameter p-line-1  as character no-undo .
      338     define input  parameter p-line-2  as character no-undo .
      339     define input  parameter p-line-3  as character no-undo .
      340     define output parameter p-message as character no-undo .
      341     do
      342     on error undo, return error return-value
      343     :
      344       assign
      345         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      346                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      347                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      348       .
      349     end.
      350   end procedure.
      351   function waitfram-join-function returns character
      352     (input p-line-1 as character
      353     ,input p-line-2 as character
      354     ,input p-line-3 as character
      355     ).
      356     define variable v-message as character no-undo .
      357     run waitfram-join in this-procedure
      358       (input  p-line-1
      359       ,input  p-line-2
      360       ,input  p-line-3
      361       ,output v-message
      362       ) .
      363     return v-message .
      364   end function .
      365   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366     define variable v-cntxt-db-num        as integer   no-undo .
      367     define variable v-cntxt-userid        as character no-undo .
      368     define variable v-cntxt-level         as character no-undo .
      369     define variable v-cntxt-host-code-obj as integer   no-undo .
      370     define variable v-cntxt-obj-type      as character no-undo .
      371     define variable v-cntxt-obj-code      as integer   no-undo .
      372     define variable v-cntxt-db-num-obj    as integer   no-undo .
      373     define variable v-cntxt-is-admin      as logical   no-undo .
      374   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   function exmrklib_get-type-name returns character
      376     ( input p-mark-type as integer ) :
      377     define variable ret    as character no-undo .
      378     case p-mark-type:
      379         when 0 then ret = "Специальная".
      380         when 1 then ret = "Акцизная".
      381         otherwise   ret = "<неизвестен>".
      382     end case.
      383     return ret .
      384   end function.
      385   function exmrklib_get-status-name returns character
      386     ( input p-stts as integer ) :
      387     return entry (lookup (string(p-stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      388   end function.
      389   define variable v-cur-recid      as recid     no-undo.
      390   define variable v-mark-type      as integer   no-undo.
      391   define variable v-stts           as integer   no-undo.
      392   define variable glog             as logical   no-undo.
      393   define variable sort-column-name as character no-undo.
      394   define variable h-query          as handle    no-undo.
      395   define variable f-query          as handle    no-undo.
      396   define buffer buf_ex-mark for ub.ex-mark.
      397   define buffer sch_ex-mark for ub.ex-mark.
      398   define buffer pos_ex-mark for ub.ex-mark.
      399   FUNCTION get-stts-by-filter RETURNS INTEGER
      400     ( input p-filter-stts as integer )  FORWARD.
      401   FUNCTION get-type-by-filter RETURNS INTEGER
      402     ( input p-filter-type as integer )  FORWARD.
      403   DEFINE BUTTON b-add
      404        LABEL "&Добавить":L
      405        SIZE 10 BY 1.
      406   DEFINE BUTTON b-del
      407        LABEL "&Удалить"
      408        SIZE 10 BY 1.
      409   DEFINE BUTTON b-exit AUTO-GO
      410        LABEL "&Выход ":L
      411        SIZE 10 BY 1.
      412   DEFINE BUTTON b-help
      413        LABEL "Помо&щь":L
      414        SIZE 10 BY 1.
      415   DEFINE BUTTON b-hist
      416        LABEL "Ис&тория"
      417        SIZE 10 BY 1.
      418   DEFINE BUTTON b-sel AUTO-GO
      419        LABEL "Вы&бор ":L
      420        SIZE 10 BY 1.
      421   DEFINE BUTTON b-upd
      422        LABEL "&Изменить":L
      423        SIZE 10 BY 1.
      424   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(40)":U
      425        LABEL "Поиск"
      426        VIEW-AS FILL-IN
      427        SIZE 14 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
      428   DEFINE VARIABLE r-stts AS INTEGER
      429        VIEW-AS RADIO-SET HORIZONTAL
      430        RADIO-BUTTONS
      431             "Текущие&+", 0,
      432   "Все&!", 2,
      433   "Удаленные&-", 1
      434        SIZE 36 BY .79 TOOLTIP "Статус записей"
      435        FGCOLOR 4  NO-UNDO.
      436   DEFINE VARIABLE r-type AS INTEGER
      437        VIEW-AS RADIO-SET HORIZONTAL
      438        RADIO-BUTTONS
      439             "Все", 0,
      440   "Специальные марки", 1,
      441   "Акцизные марки", 2
      442        SIZE 46 BY .79 TOOLTIP "Тип справочника"
      443        FGCOLOR 4  NO-UNDO.
      444   DEFINE RECTANGLE RECT-1
      445        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      446        SIZE 70 BY 2.13.
      447   DEFINE QUERY br-exmark FOR
      448         buf_ex-mark SCROLLING.
      449   DEFINE BROWSE br-exmark
      450     QUERY br-exmark NO-LOCK DISPLAY
      451         buf_ex-mark.mark-name  COLUMN-LABEL 'Код марки' FORMAT "X(20)":U
      452         exmrklib_get-type-name (buf_ex-mark.mark-type)  COLUMN-LABEL 'Тип' FORMAT "X(12)":U
      453         exmrklib_get-status-name(buf_ex-mark.stts)  COLUMN-LABEL 'Статус'
      454         buf_ex-mark.db-num  COLUMN-LABEL 'БД создания' FORMAT ">>>>9":U
      455         buf_ex-mark.mark-code  COLUMN-LABEL 'Внутренний код' FORMAT "999999999":U
      456       WITH SEPARATORS SIZE 69.5 BY 13.88
      457            BGCOLOR 15 FGCOLOR 0 .
      458   DEFINE FRAME Dialog-Frame
      459        b-exit AT ROW 1 COL 1
      460        b-sel AT ROW 1 COL 11
      461        b-add AT ROW 1 COL 21
      462        b-upd AT ROW 1 COL 31
      463        b-del AT ROW 1 COL 41
      464        b-hist AT ROW 1 COL 51
      465        b-help AT ROW 1 COL 61
      466        r-type AT ROW 2.33 COL 9.5 NO-LABEL
      467        r-stts AT ROW 3.13 COL 9.5 NO-LABEL
      468        sch-code AT ROW 4.29 COL 7.5 COLON-ALIGNED
      469        br-exmark AT ROW 5.54 COL 1.5
      470        "Тип:" VIEW-AS TEXT
      471             SIZE 6.5 BY .67 AT ROW 2.33 COL 2
      472        "Статус:" VIEW-AS TEXT
      473             SIZE 6.5 BY .67 AT ROW 3.13 COL 2
      474        RECT-1 AT ROW 2.08 COL 1
      475        SPACE(0.39) SKIP(15.38)
      476       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      477            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      478            TITLE "Акцизные и специальные марки":L.
      479   ASSIGN
      480          FRAME Dialog-Frame:SCROLLABLE       = FALSE.
      481   ASSIGN
      482          br-exmark:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
      483   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      484   DO:
      485     define variable v-new-recid as recid no-undo.
      486   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      487   if lookup(self :type
      488            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      489            ) = 0
      490   then do:
      491     message
      492       "$Workfile$"
      493       "Указанному интерфейсному элементу фокус не может быть передан" skip
      494       "Интерфейсный элемент" self :name  skip
      495       "Тип" self :type  skip
      496       "Процедура" this-procedure :file-name skip
      497       view-as alert-box .
      498   end.
      499   else do:
      500     apply "entry":u to self  .
      501     if focus :handle <> self :handle  then do:
      502       return no-apply .
      503     end.
      504   end.
      505   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      506   do:
      507     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      508       (input  v-cntxt-db-num
      509       ,input  v-cntxt-userid
      510       ,input  0
      511       ,input  'actn_exmark-reference_update':U
      512       ,input  'global':U
      513       ,input  0
      514       ,input  '':U
      515       ,input  0
      516       ,input  0
      517       ,input  0
      518       ,input  0
      519       ,input  false
      520       ,output glog
      521       )  .
      522   end.
      523     if not glog then return.
      524     v-mark-type = get-type-by-filter (r-type).
      525     do on error undo, return no-apply:
      526       run ref/exmarki.w (input parParentProc
      527                         ,input 'ДОБАВЛЕНИЕ':U
      528                         ,input v-mark-type
      529                         ,input-output v-new-recid
      530                         ).
      531       if v-new-recid <> ? then do:
      532         run OpenBR in this-procedure (yes, no, '':U).
      533         reposition br-exmark to recid v-new-recid no-error.
      534         if error-status:error then do:
      535           find first pos_ex-mark no-lock
      536             where recid(pos_ex-mark) = v-new-recid no-error.
      537           if available pos_ex-mark then do:
      538             message "Добавленная запись не попадает в текущую выборку " +
      539                     "из-за установленного фильтра"
      540               view-as alert-box warning.
      541           end.
      542         end.
      543         if num-results("br-exmark") > 0 then do:
      544           br-exmark:select-focused-row( ).
      545         end.
      546       end.
      547     end.
      548   END.
      549   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      550   DO:
      551     define variable v-new-stts as integer no-undo .
      552     define variable lOK        as logical no-undo .
      553   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   if lookup(self :type
      555            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      556            ) = 0
      557   then do:
      558     message
      559       "$Workfile$"
      560       "Указанному интерфейсному элементу фокус не может быть передан" skip
      561       "Интерфейсный элемент" self :name  skip
      562       "Тип" self :type  skip
      563       "Процедура" this-procedure :file-name skip
      564       view-as alert-box .
      565   end.
      566   else do:
      567     apply "entry":u to self  .
      568     if focus :handle <> self :handle  then do:
      569       return no-apply .
      570     end.
      571   end.
      572     if not available buf_ex-mark then
      573       return no-apply.
      574   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   do:
      576     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      577       (input  v-cntxt-db-num
      578       ,input  v-cntxt-userid
      579       ,input  0
      580       ,input  'actn_exmark-reference_update':U
      581       ,input  'global':U
      582       ,input  0
      583       ,input  '':U
      584       ,input  0
      585       ,input  0
      586       ,input  0
      587       ,input  0
      588       ,input  false
      589       ,output glog
      590       )  .
      591   end.
      592     if not glog then return.
      593     case buf_ex-mark.stts :
      594       when integer('0':U) then do:
      595         message "Удалить текущую запись ?"
      596           view-as alert-box question buttons yes-no
      597           update lOK.
      598       end.
      599       when integer('1':U) then do:
      600         message "Запись уже удалена. Восстановить ?"
      601           view-as alert-box question buttons yes-no
      602           update lOK.
      603       end.
      604       otherwise do:
      605         message
      606           vss-workfile vss-revision vss-description skip
      607           "Неизвестный статус текущей записи" skip
      608           "ex-mark.stts =" buf_ex-mark.stts
      609           view-as alert-box error.
      610         return no-apply.
      611       end.
      612     end case.
      613     if not lOK then do:
      614       apply "entry" to br-exmark in frame Dialog-Frame.
      615       return no-apply.
      616     end.
      617     do on error undo, return no-apply:
      618       assign
      619         v-new-stts = if buf_ex-mark.stts = integer('0':U)
      620                        then integer('1':U)
      621                        else integer('0':U)
      622       .
      623       run ref/exmark2.p
      624         ( input buf_ex-mark.db-num
      625          ,input buf_ex-mark.mark-code
      626          ,input v-new-stts
      627         ) no-error.
      628       if error-status:error then do:
      629         message
      630           (if error-status :get-message(1) <> ''
      631              then error-status :get-message(1) + '~n':U
      632              else '':U)
      633           return-value
      634           view-as alert-box error .
      635         undo, return no-apply.
      636       end.
      637       assign
      638         v-stts = get-stts-by-filter (r-stts).
      639       .
      640       if v-stts = ? then do:
      641         br-exmark:refresh( ).
      642       end.
      643       else do:
      644         br-exmark:delete-current-row( ).
      645         if num-results("br-exmark") > 0 then do:
      646           br-exmark:select-focused-row( ).
      647         end.
      648       end.
      649     end.
      650     apply "entry" to br-exmark in frame Dialog-Frame.
      651   END.
