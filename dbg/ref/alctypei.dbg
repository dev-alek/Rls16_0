        1   define input  parameter parParentProc  as widget-handle no-undo.
        2   define input  parameter p-def          as character no-undo.
        3   define input-output parameter  p-rr    as recid no-undo.
        4   define variable v-attr-value           as character no-undo .
        5   define variable v-attr-status          as integer   no-undo .
        6   define variable v-corr-date            as date      no-undo .
        7   define variable v-corr-time            as integer   no-undo .
        8   define variable v-corr-user-name       as character no-undo .
        9   define variable v-create-date          as date      no-undo .
       10   define variable v-create-time          as integer   no-undo .
       11   define variable v-create-user          as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Создание и редактирование типов алкогол" .
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define new global shared variable g#language as character no-undo .
      118   if g#language <> '' and g#language <> 'rus':U then do:
      119     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      120   end.
      121   define new global shared variable g#library  as handle no-undo .
      122   define new global shared variable g#library2 as handle no-undo .
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124     define variable v-cntxt-db-num        as integer   no-undo .
      125     define variable v-cntxt-userid        as character no-undo .
      126     define variable v-cntxt-level         as character no-undo .
      127     define variable v-cntxt-host-code-obj as integer   no-undo .
      128     define variable v-cntxt-obj-type      as character no-undo .
      129     define variable v-cntxt-obj-code      as integer   no-undo .
      130     define variable v-cntxt-db-num-obj    as integer   no-undo .
      131     define variable v-cntxt-is-admin      as logical   no-undo .
      132   procedure alc-type-attr-value :
      133     define input  parameter p-alc-type-inner-code as integer   no-undo .
      134     define input  parameter p-create-user-db-num  as integer   no-undo .
      135     define input  parameter p-code                as character no-undo .
      136     define output parameter p-value               as character no-undo .
      137     define output parameter p-status              as integer   no-undo .
      138     define output parameter p-corr-date           as date      no-undo .
      139     define output parameter p-corr-time           as integer   no-undo .
      140     define output parameter p-corr-user-name      as character no-undo .
      141     define output parameter p-create-date         as date      no-undo .
      142     define output parameter p-create-time         as integer   no-undo .
      143     define output parameter p-create-user         as character no-undo .
      144     define buffer buf_alc-type-attr for ub.alc-type-attr .
      145     do
      146     on error undo, return error
      147     :
      148          find first buf_alc-type-attr no-lock where
      149                     buf_alc-type-attr.alc-type-inner-code   = p-alc-type-inner-code
      150               and   buf_alc-type-attr.create-user-db-num    = p-create-user-db-num
      151               and   buf_alc-type-attr.attr-code             = p-code no-error .
      152         if not available buf_alc-type-attr then do:
      153           return error return-value
      154           .
      155         end.
      156         else do:
      157         assign
      158           p-value           = buf_alc-type-attr.attr-value
      159           p-status          = buf_alc-type-attr.attr-status
      160           p-corr-date       = buf_alc-type-attr.corr-date
      161           p-corr-time       = buf_alc-type-attr.corr-time
      162           p-corr-user-name  = buf_alc-type-attr.corr-user-name
      163           p-create-date     = buf_alc-type-attr.create-date
      164           p-create-time     = buf_alc-type-attr.create-time
      165           p-create-user     = buf_alc-type-attr.create-user
      166         .
      167         end.
      168     end.
      169   end procedure.
      170   procedure alc-type-attr-val :
      171     define input  parameter p-alc-type-inner-code as integer   no-undo .
      172     define input  parameter p-create-user-db-num  as integer   no-undo .
      173     define input  parameter p-code                as character no-undo .
      174     define output parameter p-value               as character no-undo .
      175     define buffer buf_alc-type-attr for ub.alc-type-attr .
      176     do
      177     on error undo, return error
      178     :
      179          find first buf_alc-type-attr no-lock where
      180                     buf_alc-type-attr.alc-type-inner-code   = p-alc-type-inner-code
      181               and   buf_alc-type-attr.create-user-db-num    = p-create-user-db-num
      182               and   buf_alc-type-attr.attr-code             = p-code no-error .
      183         if not available buf_alc-type-attr then do:
      184           return error return-value
      185           .
      186         end.
      187         else do:
      188         assign
      189           p-value           = buf_alc-type-attr.attr-value
      190         .
      191         end.
      192     end.
      193   end procedure.
      194   procedure alc-type-attr-write :
      195     define input  parameter p-alc-type-inner-code as integer   no-undo .
      196     define input  parameter p-create-user-db-num  as integer   no-undo .
      197     define input  parameter p-code                as character no-undo .
      198     define input parameter p-value                as character no-undo .
      199     define input parameter p-status               as integer   no-undo .
      200     define input parameter p-corr-date            as date      no-undo .
      201     define input parameter p-corr-time            as integer   no-undo .
      202     define input parameter p-corr-user-name       as character no-undo .
      203     define input parameter p-create-date          as date      no-undo .
      204     define input parameter p-create-time          as integer   no-undo .
      205     define input parameter p-create-user          as character no-undo .
      206     define buffer buf_alc-type-attr for ub.alc-type-attr .
      207     do
      208     on error undo, return error
      209     :
      210          find first buf_alc-type-attr no-lock where
      211                     buf_alc-type-attr.alc-type-inner-code   = p-alc-type-inner-code
      212               and   buf_alc-type-attr.create-user-db-num    = p-create-user-db-num
      213               and   buf_alc-type-attr.attr-code             = p-code no-error .
      214         if not available buf_alc-type-attr then do:
      215           create buf_alc-type-attr .
      216           assign
      217             buf_alc-type-attr.alc-type-inner-code = p-alc-type-inner-code
      218             buf_alc-type-attr.create-user-db-num  = p-create-user-db-num
      219             buf_alc-type-attr.attr-code           = p-code
      220             buf_alc-type-attr.attr-value          = p-value
      221             buf_alc-type-attr.attr-status         = p-status
      222             buf_alc-type-attr.corr-date           = p-corr-date
      223             buf_alc-type-attr.corr-time           = p-corr-time
      224             buf_alc-type-attr.corr-user-name      = p-corr-user-name
      225             buf_alc-type-attr.create-date         = p-create-date
      226             buf_alc-type-attr.create-time         = p-create-time
      227             buf_alc-type-attr.create-user         = p-create-user
      228           .
      229         end.
      230         else do:
      231         assign
      232             buf_alc-type-attr.attr-value          = p-value
      233             buf_alc-type-attr.attr-status         = p-status
      234             buf_alc-type-attr.corr-date           = p-corr-date
      235             buf_alc-type-attr.corr-time           = p-corr-time
      236             buf_alc-type-attr.corr-user-name      = p-corr-user-name
      237             buf_alc-type-attr.create-date         = p-create-date
      238             buf_alc-type-attr.create-time         = p-create-time
      239             buf_alc-type-attr.create-user         = p-create-user
      240         .
      241         end.
      242     end.
      243   end procedure.
      244   procedure alc-type-attr-delete :
      245     define input  parameter p-alc-type-inner-code as integer   no-undo .
      246     define input  parameter p-create-user-db-num  as integer   no-undo .
      247     define input  parameter p-code                as character no-undo .
      248     define buffer buf_alc-type-attr for ub.alc-type-attr .
      249     do
      250     on error undo, return error
      251     :
      252          find first buf_alc-type-attr exclusive-lock where
      253                     buf_alc-type-attr.alc-type-inner-code   = p-alc-type-inner-code
      254               and   buf_alc-type-attr.create-user-db-num    = p-create-user-db-num
      255               and   buf_alc-type-attr.attr-code             = p-code no-error .
      256         if not available buf_alc-type-attr then do:
      257           return error return-value
      258           .
      259         end.
      260         else do:
      261           delete buf_alc-type-attr .
      262         end.
      263     end.
      264   end procedure.
      265   define buffer buf_alc-type for ub.alc-type .
      266   define buffer buf_alc-type-attr for ub.alc-type-attr .
      267   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      268     run mainmenu_getcntxt in parparentproc
      269       (output v-cntxt-db-num
      270       ,output v-cntxt-userid
      271       ,output v-cntxt-level
      272       ,output v-cntxt-host-code-obj
      273       ,output v-cntxt-obj-type
      274       ,output v-cntxt-obj-code
      275       ,output v-cntxt-db-num-obj
      276       ,output v-cntxt-is-admin
      277       ) .
      278   DEFINE BUTTON b-exit AUTO-GO
      279        LABEL "&Ввод"
      280        SIZE 10 BY 1
      281        BGCOLOR 8 .
      282   DEFINE BUTTON B-Help
      283        LABEL "&Помощь"
      284        SIZE 10 BY 1
      285        BGCOLOR 8 .
      286   DEFINE BUTTON b-quit AUTO-END-KEY
      287        LABEL "&Отмена"
      288        SIZE 10 BY 1
      289        BGCOLOR 8 .
      290   DEFINE VARIABLE v-code AS CHARACTER FORMAT "x(8)":U
      291        LABEL "Код"
      292        VIEW-AS FILL-IN
      293        SIZE 8.88 BY 1 NO-UNDO.
      294   DEFINE VARIABLE v-inner-code AS INTEGER FORMAT ">>>9":U INITIAL 0
      295        LABEL "Код внут."
      296         VIEW-AS TEXT
      297        SIZE 14 BY .67
      298        FGCOLOR 1  NO-UNDO.
      299   DEFINE VARIABLE v-min-price AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
      300        LABEL "Мин.опт.цена"
      301        VIEW-AS FILL-IN
      302        SIZE 8.88 BY 1 NO-UNDO.
      303   DEFINE VARIABLE v-name AS CHARACTER FORMAT "X(80)":U
      304        LABEL "Название"
      305        VIEW-AS FILL-IN
      306        SIZE 80 BY 1 NO-UNDO.
      307   DEFINE VARIABLE rs-alc-declar AS INTEGER
      308        VIEW-AS RADIO-SET VERTICAL
      309        RADIO-BUTTONS
      310             "Алк. продукция.   Форма декларации: 11", 1,
      311   "Пивная продукция. Форма декларации: 12", 2
      312        SIZE 44 BY 1.96 NO-UNDO.
      313   DEFINE FRAME Dialog-Frame
      314        b-exit AT ROW 1 COL 1
      315        b-quit AT ROW 1 COL 11
      316        B-Help AT ROW 1 COL 83.5
      317        v-name AT ROW 3.13 COL 11.5 COLON-ALIGNED
      318        v-code AT ROW 4.21 COL 11.5 COLON-ALIGNED
      319        v-min-price AT ROW 4.21 COL 35.13 COLON-ALIGNED WIDGET-ID 8
      320        rs-alc-declar AT ROW 4.25 COL 49.5 NO-LABEL WIDGET-ID 4
      321        v-inner-code AT ROW 2.33 COL 11.5 COLON-ALIGNED
      322        SPACE(66.49) SKIP(3.49)
      323       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      324            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      325            TITLE " видов алкоголя"
      326            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      327   ASSIGN
      328          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      329          FRAME Dialog-Frame:HIDDEN           = TRUE.
      330   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      331   DO:
      332     APPLY "END-ERROR":U TO SELF.
      333   END.
      334   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      335   DO:
      336      Assign
      337         v-inner-code
      338         v-code
      339         v-name
      340         v-min-price
      341         rs-alc-declar
      342      .
      343      if p-def = 'ДОБАВЛЕНИЕ':U then do:
      344         FIND FIRST buf_alc-type WHERE buf_alc-type.alc-type-code   = v-code
      345                                   AND buf_alc-type.alc-type-status = 0
      346                                 NO-LOCK
      347                                 NO-ERROR
      348                                 .
      349         IF AVAILABLE buf_alc-type
      350         THEN DO:
      351            MESSAGE "Введенный код вида алкоголя уже существует" buf_alc-type.alc-type-name " ! " VIEW-AS  ALERT-BOX  ERROR.
      352            APPLY "entry"  TO v-code .
      353            RETURN NO-APPLY.
      354         END.
      355      END.
      356      if p-def = 'ДОБАВЛЕНИЕ':U OR p-def = 'ИЗМЕНЕНИЕ':U  then DO:
      357         if v-name = "" then do:
      358            message "Введите название вида алкоголя! "
      359            view-as  alert-box  error.
      360            apply "entry"  to v-name .
      361            return no-apply.
      362         end.
      363         if v-code = "" then do:
      364            message "Введите код вида алкоголя! "
      365            view-as  alert-box  error.
      366            apply "entry"  to v-code .
      367            return no-apply.
      368         end.
      369         if p-def = 'ДОБАВЛЕНИЕ':U then do:
      370            v-inner-code = next-value ( s-alc-type , ub).
      371            create buf_alc-type.
      372            Assign
      373               buf_alc-type.alc-type-inner-code = v-inner-code
      374               buf_alc-type.create-user-db-num  = v-cntxt-db-num
      375               buf_alc-type.create-date         = TODAY
      376               buf_alc-type.create-time         = TIME
      377               buf_alc-type.create-user-db-num  = v-cntxt-db-num
      378               buf_alc-type.create-user         = v-cntxt-userid
      379               p-rr                             = recid(buf_alc-type)
      380            .
      381         end.
      382         Assign
      383            buf_alc-type.alc-type-name  = v-name
      384            buf_alc-type.alc-type-code  = v-code
      385            buf_alc-type.corr-date      = TODAY
      386            buf_alc-type.corr-time      = TIME
      387            buf_alc-type.corr-user-name = v-cntxt-userid
      388         .
      389           run alc-type-attr-val (  input   buf_alc-type.alc-type-inner-code,
      390                                    input   buf_alc-type.create-user-db-num,
      391                                    input   "alc-min-price",
      392                                    output  v-attr-value
      393                                 )  no-error.
      394                     IF NOT ERROR-STATUS:ERROR THEN DO:
      395                 run alc-type-attr-delete (  input   buf_alc-type.alc-type-inner-code,
      396                                             input   buf_alc-type.create-user-db-num,
      397                                             input   "alc-min-price"
      398                                          )  no-error.
      399                     end.
      400           run alc-type-attr-write (  input    buf_alc-type.alc-type-inner-code,
      401                                      input    buf_alc-type.create-user-db-num,
      402                                      input    "alc-min-price",
      403                                      input    string(v-min-price),
      404                                      input    0,
      405                                      input    TODAY,
      406                                      input    TIME,
      407                                      input    v-cntxt-userid,
      408                                      input    TODAY,
      409                                      input    TIME,
      410                                      input    v-cntxt-userid
      411                                   )  no-error.
      412           run alc-type-attr-val (  input   buf_alc-type.alc-type-inner-code,
      413                                    input   buf_alc-type.create-user-db-num,
      414                                    input   "alc-type",
      415                                    output  v-attr-value
      416                                 )  no-error.
      417                     IF NOT ERROR-STATUS:ERROR THEN DO:
      418                 run alc-type-attr-delete (  input   buf_alc-type.alc-type-inner-code,
      419                                             input   buf_alc-type.create-user-db-num,
      420                                             input   "alc-type"
      421                                          )  no-error.
      422                     end.
      423         case rs-alc-declar:
      424           when 1 then do:
      425           run alc-type-attr-write (  input    buf_alc-type.alc-type-inner-code,
      426                                      input    buf_alc-type.create-user-db-num,
      427                                      input    "alc-type",
      428                                      input    "1",
      429                                      input    0,
      430                                      input    TODAY,
      431                                      input    TIME,
      432                                      input    v-cntxt-userid,
      433                                      input    TODAY,
      434                                      input    TIME,
      435                                      input    v-cntxt-userid
      436                                   )  no-error.
      437           end.
      438           when 2 then do:
      439           run alc-type-attr-write (  input    buf_alc-type.alc-type-inner-code,
      440                                      input    buf_alc-type.create-user-db-num,
      441                                      input    "alc-type",
      442                                      input    "2",
      443                                      input    0,
      444                                      input    TODAY,
      445                                      input    TIME,
      446                                      input    v-cntxt-userid,
      447                                      input    TODAY,
      448                                      input    TIME,
      449                                      input    v-cntxt-userid
      450                                   )  no-error.
      451           end.
      452         end case .
      453      END.
      454   END.
      455   ON VALUE-CHANGED OF rs-alc-declar IN FRAME Dialog-Frame
      456   DO:
      457     assign rs-alc-declar .
      458   END.
      459   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      460   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      461   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      462   on help of frame Dialog-Frame
      463   do:
      464     run gbl/app_help.p
      465       (input this-procedure :file-name
      466       ,input ''
      467       ,input ?
      468       ) no-error.
      469     if error-status :error then do:
      470       message
      471         "Ошибка при вызове помощи"
      472         error-status :get-message(1)
      473         view-as alert-box .
      474     end.
      475   end.
      476   run minbtn-set in this-procedure .
      477   on choose of b-help in frame Dialog-Frame
      478   do:
      479     apply "help":u to frame Dialog-Frame .
      480   end.
      481   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      482   procedure minbtn-set :
      483       do
      484           on error undo, return error return-value
      485           :
      486           define variable ii              as integer       no-undo .
      487           define variable fh              as widget-handle no-undo .
      488           define variable hh              as widget-handle no-undo .
      489           define variable v-h             as handle        extent 4 no-undo .
      490           define variable v-name-button   as character     no-undo .
      491           define variable v-help-old-x    as decimal       no-undo .
      492           define variable v-help-old-y    as decimal       no-undo .
      493           define variable v-help-old-size as decimal       no-undo .
      494           define variable v-frame-width   as decimal       no-undo .
      495           define variable jj              as integer       no-undo .
      496           do
      497               on error undo, return error
      498               :
      499               assign
      500                   v-frame-width = frame Dialog-Frame:width - 0.3
      501                   fh            = frame Dialog-Frame:first-child
      502                   hh            = fh:first-child
      503                   ii            = 1
      504                   .
      505               do while valid-handle(hh):
      506                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      507                   do:
      508                       case lc(hh:name) :
      509                           when "b-help" then
      510                               do:
      511                                   hh:load-image-up("cmp/b-help.bmp":u) .
      512                                   hh:load-image-down("cmp/b-help.bmp":u) .
      513                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      514                                   hh:TOOLTIP = "Помощь" .
      515                                   v-help-old-x = hh:column .
      516                                   v-help-old-y = hh:row    .
      517                                   v-help-old-size = hh:width .
      518                                   hh:width-chars = 2.5 .
      519                               end.
      520                           when "b-print" then
      521                               do:
      522                                   hh:load-image("cmp/b-print.bmp":u) .
      523                                   hh:TOOLTIP = "Печать" .
      524                                   v-h[ii] = hh:handle .
      525                                   ii = ii + 1 .
      526                                   hh:width-chars = 3 .
      527                               end.
      528                           when "b-history" or
      529                           when "b-hist" then
      530                               do:
      531                                   hh:load-image("cmp/b-hist.bmp":u) .
      532                                   hh:TOOLTIP = "История" .
      533                                   v-h[ii] = hh:handle .
      534                                   ii = ii + 1 .
      535                                   hh:width-chars = 3 .
      536                               end.
      537                           when "b-sch" then
      538                               do:
      539                                   hh:load-image("cmp/b-sch.bmp":u) .
      540                                   hh:TOOLTIP = "Установка Фильтра" .
      541                                   v-h[ii] = hh:handle .
      542                                   ii = ii + 1 .
      543                                   hh:width-chars = 3 .
      544                               end.
      545                           when "b-hist-user" then
      546                               do:
      547                                   hh:load-image("cmp/b-hist.bmp":u) .
      548                                   hh:TOOLTIP = "История пользователя" .
      549                                   ii = ii + 1 .
      550                               end.
      551                       end case.
      552                   end.
      553                   hh = hh:next-sibling.
      554               end.
      555               b-help:column = v-frame-width - b-help:width-chars.
      556               jj = 0.
      557               repeat ii = 4 to 1 by -1 :
      558                   if valid-handle (v-h[ii] ) then
      559                   do:
      560                       jj  = jj + 1 .
      561                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      562                       v-h[ii]:row    = v-help-old-y .
      563                   end.
      564               end.
      565           end.
      566       end.
      567   end procedure.
      568   assign frame Dialog-Frame:title = p-def + " вида алкоголя  " .
      569   MAIN-BLOCK:
      570   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      571      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      572     run local-init in this-procedure.
      573     run enable_UI in this-procedure .
      574     WAIT-FOR GO OF FRAME Dialog-Frame.
      575   END.
      576   run disable_UI in this-procedure .
      577   PROCEDURE disable_UI :
      578     HIDE FRAME Dialog-Frame.
      579   END PROCEDURE.
      580   PROCEDURE enable_UI :
      581     DISPLAY v-name v-code v-min-price rs-alc-declar v-inner-code
      582         WITH FRAME Dialog-Frame.
      583     ENABLE b-exit b-quit B-Help v-name v-code v-min-price rs-alc-declar
      584            v-inner-code
      585         WITH FRAME Dialog-Frame.
      586     VIEW FRAME Dialog-Frame.
      587   END PROCEDURE.
      588   PROCEDURE local-init :
      589   if Lookup(p-def, 'ДОБАВЛЕНИЕ':U + "," + 'ПРОСМОТР':U + "," +  'ИЗМЕНЕНИЕ':U)  = 0 then DO:
      590         return error.
      591      end.
      592      if p-def = 'ИЗМЕНЕНИЕ':U then do:
      593         find first buf_alc-type
      594               where recid(buf_alc-type) = p-rr
      595               exclusive-lock
      596               no-error .
      597         if not available buf_alc-type then do:
      598            return error.
      599         end.
      600      end.
      601      if p-def = 'ПРОСМОТР':U then do:
      602         find first buf_alc-type
      603               where recid(buf_alc-type) = p-rr
      604               no-lock
      605               no-error .
      606            if not available buf_alc-type then DO:
      607               return error.
      608            end.
      609      end.
      610      if available buf_alc-type then do:
      611         assign
      612            v-inner-code = buf_alc-type.alc-type-inner-code
      613            v-name       = buf_alc-type.alc-type-name
      614            v-code       = buf_alc-type.alc-type-code
      615            .
      616            run alc-type-attr-val (  input   buf_alc-type.alc-type-inner-code,
      617                                     input   v-cntxt-db-num,
      618                                     input   "alc-type",
      619                                     output  v-attr-value
      620                                  )  no-error.
      621             IF ERROR-STATUS:ERROR THEN DO:
      622                 rs-alc-declar = 1.
      623             end.
      624             else do:
      625                 rs-alc-declar = integer (v-attr-value) .
      626             end.
      627            run alc-type-attr-val (  input   buf_alc-type.alc-type-inner-code,
      628                                     input   v-cntxt-db-num,
      629                                     input   "alc-min-price",
      630                                     output  v-attr-value
      631                                  )  no-error.
      632             IF NOT ERROR-STATUS:ERROR THEN DO:
      633                 v-min-price = decimal (v-attr-value) .
      634             end.
      635      end.
      636      else do:
      637         if p-def = 'ДОБАВЛЕНИЕ':U then do:
      638         end.
      639      end.
      640   END PROCEDURE.
