        1   DEFINE BUFFER locked_assortment-matrix FOR ub.assortment-matrix.
        2   DEFINE TEMP-TABLE tt-assortment-matrix NO-UNDO LIKE ub.assortment-matrix
        3          field obj-name as character
        4          field is-rel as logic
        5          field rel-id as character.
        6   DEFINE BUFFER X_curr_clients FOR ub.clients.
        7   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        8   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
        9   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       10   define input parameter p-mode as character no-undo.
       11   DEFINE INPUT PARAMETER p-asmt-id LIKE ub.assortment-matrix.asmt-id NO-UNDO.
       12   define input-output parameter p-doc-rec as recid no-undo.
       13   def var vss-revision    as character no-undo init "$Revision$":U .
       14   def var vss-author      as character no-undo init "$Author$":U .
       15   def var vss-date        as character no-undo init "$Date$":U .
       16   def var vss-workfile    as character no-undo init "$Workfile$":U .
       17   def var vss-archive     as character no-undo init "$Archive$":U .
       18   def var vss-description as character no-undo init "Карточка редактирования заголовка ассортиментной матрицы ".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125     define variable v-cntxt-db-num        as integer   no-undo .
      126     define variable v-cntxt-userid        as character no-undo .
      127     define variable v-cntxt-level         as character no-undo .
      128     define variable v-cntxt-host-code-obj as integer   no-undo .
      129     define variable v-cntxt-obj-type      as character no-undo .
      130     define variable v-cntxt-obj-code      as integer   no-undo .
      131     define variable v-cntxt-db-num-obj    as integer   no-undo .
      132     define variable v-cntxt-is-admin      as logical   no-undo .
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define temp-table userobjs_temp-user-obj no-undo
      135     field obj-type as character
      136     field obj-code as integer
      137     index xpk is primary unique obj-type obj-code
      138     .
      139   procedure userobjs_clear :
      140     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      141     do
      142     on error undo, return error return-value
      143     :
      144       for each buf_userobjs_temp-user-obj
      145       on error undo, return error return-value
      146       :
      147         delete buf_userobjs_temp-user-obj .
      148       end.
      149     end.
      150   end .
      151   procedure userobjs_object-count :
      152     define output parameter p-total-count as integer   no-undo .
      153     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      154     do
      155     on error undo, return error return-value
      156     :
      157       assign
      158         p-total-count = 0
      159       .
      160       for each buf_userobjs_temp-user-obj
      161       on error undo, return error return-value
      162       :
      163         assign
      164           p-total-count = p-total-count + 1
      165         .
      166       end.
      167     end.
      168   end.
      169   procedure userobjs_append :
      170      define input  parameter p-obj-type as character no-undo .
      171      define input  parameter p-obj-code as integer   no-undo .
      172     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      173     do
      174     on error undo, return error return-value
      175     :
      176       find first buf_userobjs_temp-user-obj
      177         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      178           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      179         no-error .
      180       if not available buf_userobjs_temp-user-obj
      181       then do:
      182         create buf_userobjs_temp-user-obj .
      183         assign
      184           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      185           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      186         .
      187       end.
      188     end.
      189   end.
      190   procedure userobjs_object-exist :
      191     define output parameter p-object-exist as logical   no-undo .
      192     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      193     do
      194     on error undo, return error return-value
      195     :
      196       find first buf_userobjs_temp-user-obj
      197         no-error .
      198       if not available buf_userobjs_temp-user-obj
      199       then do:
      200         assign
      201           p-object-exist = false
      202         .
      203       end.
      204       else do:
      205         assign
      206           p-object-exist = true
      207         .
      208       end.
      209     end.
      210   end.
      211   procedure userobjs_transfer :
      212     define input  parameter p-callback-handle as handle no-undo .
      213     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      214     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      215     do
      216     on error undo, return error return-value
      217     :
      218       if valid-handle(p-callback-handle) <> true
      219       then do:
      220         message
      221           vss-workfile vss-revision vss-description skip
      222           "Ошибка задания входных параметров" skip
      223           "Неизвестный указатель на процедуру" skip
      224           view-as alert-box error .
      225         undo, return error return-value .
      226       end.
      227       if p-callback-handle :get-signature("userobjs_append") = ""
      228       then do:
      229         message
      230           vss-workfile vss-revision vss-description skip
      231           "Ошибка задания входных параметров" skip
      232           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      233                     ,p-callback-handle :file-name
      234                     ) skip
      235           view-as alert-box error .
      236         undo, return error return-value .
      237       end.
      238       for each buf_userobjs_temp-user-obj
      239       on error undo, return error return-value
      240       :
      241         run userobjs_append in p-callback-handle
      242           (input  buf_userobjs_temp-user-obj.obj-type
      243           ,input  buf_userobjs_temp-user-obj.obj-code
      244           ) .
      245       end.
      246     end.
      247   end procedure.
