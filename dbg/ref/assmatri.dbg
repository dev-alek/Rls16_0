      489           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run assmatat-batch-edit in g#attr-lib
      490         (input  p-code
      491         ,output p-section-num
      492         ) no-error .
      493       if error-status :error
      494       then do:
      495         undo, return error return-value .
      496       end.
      497     end.
      498   end procedure.
      499   define variable v-rid-list  as character no-undo.
      500   define variable v-tab-order as character no-undo.
      501   define variable v-db-num LIKE ub.db.db-num no-undo.
      502   define variable v-last-code like ub.assortment-matrix.asmt-id no-undo.
      503   DEFINE BUTTON B-exit AUTO-GO
      504        LABEL "&Ввод"
      505        SIZE 10 BY 1
      506        BGCOLOR 8 .
      507   DEFINE BUTTON B-Help
      508        LABEL "Помо&щь"
      509        SIZE 2.5 BY 1
      510        BGCOLOR 8 .
      511   DEFINE BUTTON B-Hist
      512        LABEL "Ис&тория"
      513        SIZE 6.5 BY 1
      514        BGCOLOR 8 .
      515   DEFINE BUTTON b-quit AUTO-END-KEY
      516        LABEL "&Отмена"
      517        SIZE 10 BY 1
      518        BGCOLOR 8 .
      519   DEFINE BUTTON r-assmatr
      520        IMAGE-UP FILE "btn-down-arrow":U
      521        IMAGE-DOWN FILE "btn-down-arrow":U
      522        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      523        LABEL ""
      524        SIZE 3 BY 1 TOOLTIP "Выбор шаблона".
      525   DEFINE BUTTON r-obj
      526        IMAGE-UP FILE "btn-down-arrow":U
      527        IMAGE-DOWN FILE "btn-down-arrow":U
      528        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      529        LABEL ""
      530        SIZE 3 BY .88.
      531   DEFINE VARIABLE v-rel-id AS CHARACTER FORMAT "X(256)":U
      532         VIEW-AS TEXT
      533        SIZE 14 BY 1
      534        FGCOLOR 1  NO-UNDO.
      535   DEFINE VARIABLE v-shablon-name AS CHARACTER FORMAT "X(256)":U
      536         VIEW-AS TEXT
      537        SIZE 44.5 BY 1
      538        FGCOLOR 1  NO-UNDO.
      539   DEFINE VARIABLE T-relation AS LOGICAL INITIAL no
      540        LABEL "Есть привязка к шаблону"
      541        VIEW-AS TOGGLE-BOX
      542        SIZE 26.5 BY 1 NO-UNDO.
      543   DEFINE QUERY Dialog-Frame FOR
      544         tt-assortment-matrix SCROLLING.
      545   DEFINE FRAME Dialog-Frame
      546        B-exit AT ROW 1 COL 1
      547        b-quit AT ROW 1 COL 11
      548        B-Hist AT ROW 1 COL 89.5
      549        B-Help AT ROW 1 COL 96.5
      550        tt-assortment-matrix.asmt-id AT ROW 2 COL 34 COLON-ALIGNED
      551             LABEL "Внутр.код ассортиментной матрицы"
      552             VIEW-AS FILL-IN
      553             SIZE 11 BY 1
      554        tt-assortment-matrix.asmt-type AT ROW 3 COL 36 NO-LABEL
      555             VIEW-AS RADIO-SET HORIZONTAL
      556             RADIO-BUTTONS
      557                       "Item 1", "1":U,
      558   "Item 2", "2":U
      559             SIZE 34 BY 1 TOOLTIP "Тип ассортиментной матрицы"
      560        tt-assortment-matrix.obj-type AT ROW 4 COL 34 COLON-ALIGNED
      561             LABEL "Объект"
      562             VIEW-AS FILL-IN
      563             SIZE 4.5 BY 1
      564        tt-assortment-matrix.obj-code AT ROW 4 COL 39 COLON-ALIGNED NO-LABEL FORMAT ">>>>>>>>>"
      565             VIEW-AS FILL-IN
      566             SIZE 9 BY 1
      567        r-obj AT ROW 4 COL 50.5
      568        T-relation AT ROW 5.54 COL 9.25 WIDGET-ID 2
      569        r-assmatr AT ROW 5.54 COL 35.5 WIDGET-ID 12
      570        tt-assortment-matrix.asmt-name AT ROW 6.92 COL 34 COLON-ALIGNED
      571             LABEL "Название ассортиментной матрицы"
      572             VIEW-AS FILL-IN
      573             SIZE 32 BY 1
      574        tt-assortment-matrix.asmt-des AT ROW 9.33 COL 1 NO-LABEL
      575             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      576             SIZE 98 BY 6.5
      577        tt-assortment-matrix.obj-name AT ROW 4 COL 52 COLON-ALIGNED NO-LABEL FORMAT "x(20)"
      578              VIEW-AS TEXT
      579             SIZE 43.5 BY 1
      580        v-rel-id AT ROW 5.54 COL 36.88 COLON-ALIGNED NO-LABEL WIDGET-ID 8
      581        v-shablon-name AT ROW 5.54 COL 51.5 COLON-ALIGNED NO-LABEL WIDGET-ID 10
      582        "Описание:" VIEW-AS TEXT
      583             SIZE 10 BY 1 AT ROW 8 COL 3.25
      584        "Тип:" VIEW-AS TEXT
      585             SIZE 4.5 BY 1 AT ROW 3 COL 31
      586        SPACE(63.74) SKIP(12.32)
      587       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      588            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      589            TITLE "Заголовок ассортиментной матрицы"
      590            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      591   ASSIGN
      592          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      593          FRAME Dialog-Frame:HIDDEN           = TRUE.
      594   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      595   DO:
      596     APPLY "END-ERROR":U TO SELF.
      597   END.
      598   ON VALUE-CHANGED OF tt-assortment-matrix.asmt-type IN FRAME Dialog-Frame
      599   DO:
      600     ASSIGN tt-assortment-matrix.asmt-TYPE .
      601     RUN proc-rs-type.
      602   END.
      603   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      604   DO:
      605       run proc-save in this-procedure no-error.
      606     if error-status:error then return no-apply.
      607   END.
      608   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      609   DO:
      610     define variable pp-rid-list as character no-undo .
      611    run str/cassmatr.w (
      612     input  parparentproc ,
      613     input  locked_assortment-matrix.asmt-id ,
      614     input  locked_assortment-matrix.db-num ,
      615     input-output pp-rid-list    ).
      616   END.
      617   ON CHOOSE OF r-assmatr IN FRAME Dialog-Frame
      618   DO:
      619   define buffer buf_assort-matrix for ub.assortment-matrix  .
      620     v-rid-list  = "".
      621     v-rel-id        = "" .
      622     v-shablon-name  = "" .
      623     display v-rel-id v-shablon-name  with frame Dialog-Frame .
      624       run ref/assmatr.w (
      625           input parParentProc   ,
      626           input "b-sel"         ,
      627           input p-curr-obj-type ,
      628           input p-curr-obj-code ,
      629           input 'Шаблон':U  ,
      630           input 0               ,
      631           input-output v-rid-list ) .
      632     if num-entries(v-rid-list) <> 1 then return no-apply.
      633     find first buf_assort-matrix no-lock where  recid(buf_assort-matrix) = int(v-rid-list) no-error .
      634     if error-status :error then return no-apply.
      635     v-rel-id        = substitute( "&1&3&2" , buf_assort-matrix.asmt-id , buf_assort-matrix.db-num , chr(4) ) .
      636     v-shablon-name  = buf_assort-matrix.asmt-name .
      637     display v-rel-id v-shablon-name  with frame Dialog-Frame .
      638   END.
      639   ON VALUE-CHANGED OF T-relation IN FRAME Dialog-Frame
      640   DO:
      641     assign t-relation.
      642     run select-list-sh .
      643   END.
      644   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      645   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      646   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      647   on help of frame Dialog-Frame
      648   do:
      649     run gbl/app_help.p
      650       (input this-procedure :file-name
      651       ,input ''
      652       ,input ?
      653       ) no-error.
      654     if error-status :error then do:
      655       message
      656         "Ошибка при вызове помощи"
      657         error-status :get-message(1)
      658         view-as alert-box .
      659     end.
      660   end.
      661   run minbtn-set in this-procedure .
      662   on choose of b-help in frame Dialog-Frame
      663   do:
      664     apply "help":u to frame Dialog-Frame .
      665   end.
      666   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   procedure minbtn-set :
      668       do
      669           on error undo, return error return-value
      670           :
      671           define variable ii              as integer       no-undo .
      672           define variable fh              as widget-handle no-undo .
      673           define variable hh              as widget-handle no-undo .
      674           define variable v-h             as handle        extent 4 no-undo .
      675           define variable v-name-button   as character     no-undo .
      676           define variable v-help-old-x    as decimal       no-undo .
      677           define variable v-help-old-y    as decimal       no-undo .
      678           define variable v-help-old-size as decimal       no-undo .
      679           define variable v-frame-width   as decimal       no-undo .
      680           define variable jj              as integer       no-undo .
      681           do
      682               on error undo, return error
      683               :
      684               assign
      685                   v-frame-width = frame Dialog-Frame:width - 0.3
      686                   fh            = frame Dialog-Frame:first-child
      687                   hh            = fh:first-child
      688                   ii            = 1
      689                   .
      690               do while valid-handle(hh):
      691                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      692                   do:
      693                       case lc(hh:name) :
      694                           when "b-help" then
      695                               do:
      696                                   hh:load-image-up("cmp/b-help.bmp":u) .
      697                                   hh:load-image-down("cmp/b-help.bmp":u) .
      698                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      699                                   hh:TOOLTIP = "Помощь" .
      700                                   v-help-old-x = hh:column .
      701                                   v-help-old-y = hh:row    .
      702                                   v-help-old-size = hh:width .
      703                                   hh:width-chars = 2.5 .
      704                               end.
      705                           when "b-print" then
      706                               do:
      707                                   hh:load-image("cmp/b-print.bmp":u) .
      708                                   hh:TOOLTIP = "Печать" .
      709                                   v-h[ii] = hh:handle .
      710                                   ii = ii + 1 .
      711                                   hh:width-chars = 3 .
      712                               end.
      713                           when "b-history" or
      714                           when "b-hist" then
      715                               do:
      716                                   hh:load-image("cmp/b-hist.bmp":u) .
      717                                   hh:TOOLTIP = "История" .
      718                                   v-h[ii] = hh:handle .
      719                                   ii = ii + 1 .
      720                                   hh:width-chars = 3 .
      721                               end.
      722                           when "b-sch" then
      723                               do:
      724                                   hh:load-image("cmp/b-sch.bmp":u) .
      725                                   hh:TOOLTIP = "Установка Фильтра" .
      726                                   v-h[ii] = hh:handle .
      727                                   ii = ii + 1 .
      728                                   hh:width-chars = 3 .
      729                               end.
      730                           when "b-hist-user" then
      731                               do:
      732                                   hh:load-image("cmp/b-hist.bmp":u) .
      733                                   hh:TOOLTIP = "История пользователя" .
      734                                   ii = ii + 1 .
      735                               end.
      736                       end case.
      737                   end.
      738                   hh = hh:next-sibling.
      739               end.
      740               b-help:column = v-frame-width - b-help:width-chars.
      741               jj = 0.
      742               repeat ii = 4 to 1 by -1 :
      743                   if valid-handle (v-h[ii] ) then
      744                   do:
      745                       jj  = jj + 1 .
      746                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      747                       v-h[ii]:row    = v-help-old-y .
      748                   end.
      749               end.
      750           end.
      751       end.
      752   end procedure.
      753   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   ON TAB ANYWHERE
      755   DO:
      756   define variable ii as integer no-undo .
      757   define variable fh as widget-handle no-undo .
      758   define variable hh as widget-handle no-undo .
      759   define variable v-next-widget-name as character no-undo .
      760   if v-tab-order <> '' then do:
      761     if self:type = "TOGGLE-BOX" then
      762     self:BGCOLOR = ?.
      763     assign
      764     ii = lookup(self:name, v-tab-order).
      765     assign
      766     ii = ii + 1
      767     v-next-widget-name = entry(ii, v-tab-order)
      768     no-error .
      769     if error-status:error then do:
      770       assign
      771       ii = 1
      772       v-next-widget-name = entry( ii, v-tab-order)
      773       .
      774     end.
      775     assign
      776     fh = frame Dialog-Frame:first-child
      777     hh = fh:first-child
      778     .
      779     do while valid-handle(hh):
      780       if hh:name = v-next-widget-name then do:
      781         if hh:sensitive  = yes
      782         AND hh:visible = yes then do:
      783           APPLY "ENTRY" to hh.
      784           return no-apply.
      785         end.
      786         else do:
      787           APPLY "TAB" to hh.
      788           return no-apply.
      789         end.
      790       end.
      791       hh = hh:next-sibling.
      792     end.
      793   end.
      794   END.
      795   ON BACK-TAB ANYWHERE
      796   DO:
      797   define variable ii as integer no-undo .
      798   define variable fh as widget-handle no-undo .
      799   define variable hh as widget-handle no-undo .
      800   define variable v-next-widget-name as character no-undo .
      801   if v-tab-order <> '' then do:
      802     assign
      803     ii = lookup(self:name, v-tab-order).
      804     .
      805     assign
      806     ii = (if ii = 1
      807           then  num-entries(v-tab-order)
      808           else ii - 1
      809           )
      810     v-next-widget-name = entry(ii, v-tab-order)
      811     .
      812     assign
      813     fh = frame Dialog-Frame:first-child
      814     hh = fh:first-child
      815     .
      816     do while valid-handle(hh):
      817       if hh:name = v-next-widget-name then do:
      818         if hh:sensitive  = yes
      819         AND hh:visible = yes then do:
      820           APPLY "ENTRY" to hh.
      821           return no-apply.
      822         end.
      823         else do:
      824         APPLY "BACK-TAB" to hh.
      825         return no-apply.
      826         end.
      827       end.
      828       hh = hh:next-sibling.
      829     end.
      830     end.
      831   END.
      832   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   ON RETURN ANYWHERE
      834   DO:
      835   define variable ii as integer no-undo .
      836   define variable fh as widget-handle no-undo .
      837   define variable hh as widget-handle no-undo .
      838   define variable v-next-widget-name as character no-undo .
      839     if v-tab-order <> '' then do:
      840       assign
      841       ii = lookup(self:name, v-tab-order).
      842       if ii = num-entries(v-tab-order) then do:
      843           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      844           return no-apply.
      845       end.
      846       if self:type <> "BUTTON" and
      847         self:type <> "EDITOR"  then do:
      848         run proc-move-forward in this-procedure .
      849         return no-apply.
      850       end.
      851       if self:type = "BUTTON" then do:
      852         APPLY "CHOOSE" to self.
      853       end.
      854       if self:type = "TOGGLE-BOX" then
      855       self:BGCOLOR = ?.
      856       assign
      857       ii = ii + 1
      858       v-next-widget-name = entry(ii, v-tab-order)
      859       no-error .
      860       if error-status:error then do:
      861         assign
      862         ii = 1
      863         v-next-widget-name = entry( ii, v-tab-order)
      864         .
      865       end.
      866       assign
      867       fh = frame Dialog-Frame:first-child
      868       hh = fh:first-child
      869       .
      870       do while valid-handle(hh):
      871         if hh:name = v-next-widget-name then do:
      872           if hh:sensitive  = yes
      873           AND hh:visible = yes then do:
      874             if hh:type = "TOGGLE-BOX":U then do:
      875               assign
      876               hh:BGcolor = 1
      877               .
      878             end.
      879             APPLY "ENTRY" to hh.
      880             return no-apply.
      881           end.
      882           else do:
      883             APPLY "TAB" to hh.
      884             return no-apply.
      885           end.
      886         end.
      887         hh = hh:next-sibling.
      888       end.
      889     end.
      890   END.
      891   procedure proc-move-forward :
      892   define variable ii as integer no-undo .
      893   define variable fh as widget-handle no-undo .
      894   define variable hh as widget-handle no-undo .
      895   define variable v-next-widget-name as character no-undo .
      896   do
      897   on error undo, return error
      898   :
      899     if v-tab-order <> '' then do:
      900       if self:type = "TOGGLE-BOX" then
      901       self:BGCOLOR = ?.
      902       assign
      903       ii = lookup(self:name, v-tab-order).
      904       assign
      905       ii = ii + 1
      906       v-next-widget-name = entry(ii, v-tab-order)
      907       no-error .
      908       if error-status:error then do:
      909         assign
      910         ii = 1
      911         v-next-widget-name = entry( ii, v-tab-order)
      912         .
      913       end.
      914       assign
      915       fh = frame Dialog-Frame:first-child
      916       hh = fh:first-child
      917       .
      918       do while valid-handle(hh):
      919         if hh:name = v-next-widget-name then do:
      920           if hh:sensitive  = yes
      921           AND hh:visible = yes then do:
      922             if hh:type = "TOGGLE-BOX":U then do:
      923               assign
      924               hh:BGcolor = 1
      925               .
      926             end.
      927             APPLY "ENTRY" to hh.
      928             return.
      929           end.
      930           else do:
      931             assign
      932             ii = ii + 1
      933             v-next-widget-name = entry(ii, v-tab-order)
      934             no-error .
      935             if error-status:error then do:
      936               assign
      937               ii = 1
      938               v-next-widget-name = entry( ii, v-tab-order)
      939               .
      940             end.
      941           end.
      942         end.
      943         hh = hh:next-sibling.
      944       end.
      945     end.
      946   end.
      947   end procedure.
      948   on choose of r-obj in frame dialog-frame
      949   do:
      950      run proc-r-obj in this-procedure no-error .
      951      if error-status :error then
      952         return no-apply.
      953   end.
      954   on mouse-select-dblclick of tt-assortment-matrix.obj-code in frame Dialog-Frame
      955   do:
      956     apply "CHOOSE" to r-obj in frame Dialog-Frame.
      957     return no-apply .
      958   end.
      959   on mouse-select-dblclick of tt-assortment-matrix.obj-type in frame Dialog-Frame
      960   do:
      961     apply "CHOOSE" to r-obj in frame Dialog-Frame.
      962     return no-apply .
      963   end.
      964   procedure proc-r-obj :
      965    do
      966    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      967    :
      968    define variable v-recid as recid no-undo .
      969    define variable old-types as character no-undo .
      970    define variable v-host-code like ub.sysconf.host-code no-undo .
      971    define buffer obj#clients for ub.clients.
      972    define variable v-user-select as logical   no-undo .
      973    define variable v-obj-type    as character no-undo .
      974    define variable v-obj-code    as integer   no-undo .
      975   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      977     (input  p-curr-obj-type
      978     ,input  p-curr-obj-code
      979     ,output v-host-code
      980     )  .
      981   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      982   run userobjs_select-one in this-procedure
      983     (input  parparentproc
      984     ,input  v-cntxt-db-num
      985     ,input  v-cntxt-userid
      986     ,input  v-host-code
      987     ,input  p-curr-obj-type
      988     ,input  p-curr-obj-code
      989     ,output v-user-select
      990     ,output v-obj-type
      991     ,output v-obj-code
      992     )  .
      993     if v-user-select <> true
      994     then do:
      995       return error return-value .
      996     end.
      997       find first obj#clients no-lock
      998         where obj#clients.obj-type = v-obj-type
      999           and obj#clients.obj-code = v-obj-code
     1000            no-error.
     1001       if avail obj#clients then
     1002           assign
     1003               tt-assortment-matrix.obj-type = obj#clients.obj-type
     1004               tt-assortment-matrix.obj-code = obj#clients.obj-code
     1005               tt-assortment-matrix.obj-name = obj#clients.obj-name
     1006               .
     1007       else
     1008          assign
     1009             tt-assortment-matrix.obj-type = ""
     1010             tt-assortment-matrix.obj-name = ""
     1011             tt-assortment-matrix.obj-code = ?
     1012             .
     1013       display
     1014           tt-assortment-matrix.obj-type
     1015           tt-assortment-matrix.obj-name
     1016           tt-assortment-matrix.obj-code
     1017           with frame Dialog-Frame .
     1018   end.
     1019   end procedure.
     1020   procedure leave-proc-obj :
     1021    do
     1022    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1023    :
     1024     def buffer buf_clients for ub.clients.
     1025     assign frame Dialog-Frame
     1026        tt-assortment-matrix.obj-type
     1027        tt-assortment-matrix.obj-code
     1028         .
     1029     if tt-assortment-matrix.obj-code <> ? and tt-assortment-matrix.obj-code <> 0 and
     1030        tt-assortment-matrix.obj-type <> ? and tt-assortment-matrix.obj-type <> ""
     1031         then do:
     1032         find first buf_clients no-lock where
     1033                   buf_clients.obj-type =  tt-assortment-matrix.obj-type  and
     1034                   buf_clients.obj-code  = tt-assortment-matrix.obj-code no-error.
     1035             if error-status :error or not available buf_clients then do:
     1036                 message "Неправильно задан "  tt-assortment-matrix.obj-code:label in frame Dialog-Frame.
     1037                   assign
     1038                   tt-assortment-matrix.obj-type = ""
     1039                   tt-assortment-matrix.obj-name = ""
     1040                   tt-assortment-matrix.obj-code = ?
     1041                   .
     1042                 display
     1043                 tt-assortment-matrix.obj-type
     1044                 tt-assortment-matrix.obj-name
     1045                 tt-assortment-matrix.obj-code
     1046                 with frame Dialog-Frame.
     1047                 apply "CHOOSE" to r-obj in frame Dialog-Frame .
     1048             end.
     1049             if available buf_clients then do:
     1050                   tt-assortment-matrix.obj-type  = buf_clients.obj-type .
     1051                   tt-assortment-matrix.obj-name  = buf_clients.obj-name .
     1052                   tt-assortment-matrix.obj-code  = buf_clients.obj-code .
     1053             end.
     1054    end.
     1055    else do:
     1056         assign
     1057           tt-assortment-matrix.obj-type = ""
     1058           tt-assortment-matrix.obj-name = ""
     1059           tt-assortment-matrix.obj-code = ?
     1060           .
     1061     end.
     1062    display
     1063     tt-assortment-matrix.obj-type
     1064     tt-assortment-matrix.obj-name
     1065     tt-assortment-matrix.obj-code
     1066     with frame Dialog-Frame.
     1067    end.
     1068   end procedure.
     1069   MAIN-BLOCK:
     1070   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1071      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1072   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1073     run mainmenu_getcntxt in parparentproc
     1074       (output v-cntxt-db-num
     1075       ,output v-cntxt-userid
     1076       ,output v-cntxt-level
     1077       ,output v-cntxt-host-code-obj
     1078       ,output v-cntxt-obj-type
     1079       ,output v-cntxt-obj-code
     1080       ,output v-cntxt-db-num-obj
     1081       ,output v-cntxt-is-admin
     1082       ) .
     1083    if p-mode  <> 'ДОБАВЛЕНИЕ':U
     1084    and p-mode <> 'ИЗМЕНЕНИЕ':U
     1085    and p-mode <> 'ПРОСМОТР':U
     1086    then do:
     1087       message
     1088       vss-workfile vss-revision vss-description skip
     1089       "Неверное значение параметров вызова p-mode"  p-mode
     1090       view-as alert-box ERROR.
     1091       undo, return error.
     1092    end.
     1093      find first X_curr_clients no-lock where
     1094               X_curr_clients.obj-type = p-curr-obj-type
     1095          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     1096     if not available X_curr_clients then do:
     1097       message
     1098       vss-workfile vss-revision vss-description skip
     1099       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     1100       p-curr-obj-type p-curr-obj-code
     1101       view-as alert-box ERROR.
     1102       return error .
     1103     end.
     1104     for each tt-assortment-matrix:
     1105       delete tt-assortment-matrix.
     1106     end.
     1107     if p-mode = 'ИЗМЕНЕНИЕ':U
     1108     or p-mode = 'ПРОСМОТР':U then do:
     1109       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1110         find first locked_assortment-matrix EXclusive-lock where
     1111                      recid(locked_assortment-matrix) = p-doc-rec no-wait no-error.
     1112         if locked locked_assortment-matrix then do:
     1113           message
     1114           vss-workfile vss-revision vss-description skip
     1115            "Запись Ассортиментная матрица занята"
     1116           view-as alert-box error .
     1117           undo, return error.
     1118         end.
     1119       end.
     1120       else do:
     1121         find first locked_assortment-matrix no-lock where
     1122                          recid(locked_assortment-matrix) = p-doc-rec no-error .
     1123         if not avail locked_assortment-matrix then do:
     1124           find first locked_assortment-matrix no-lock where
     1125                      locked_assortment-matrix.asmt-id = p-asmt-id no-error .
     1126         end.
     1127       end.
     1128       if not available locked_assortment-matrix then do:
     1129         message
     1130         vss-workfile vss-revision vss-description skip
     1131         "Не найдена запись Ассортиментной матрицы"
     1132         view-as alert-box error .
     1133         undo, return error.
     1134       end.
     1135       create tt-assortment-matrix.
     1136       buffer-copy locked_assortment-matrix to tt-assortment-matrix.
     1137      end.
     1138      else do:
     1139             create tt-assortment-matrix.
     1140             assign
     1141             tt-assortment-matrix.asmt-id = v-last-code + 1
     1142            .
     1143      end.
     1144      run init-attr.
     1145     RUN Myenable.
     1146     wait-for go of frame Dialog-Frame focus tt-assortment-matrix.asmt-name .
     1147   END.
     1148   RUN disable_UI.
     1149   PROCEDURE disable_UI :
     1150     HIDE FRAME Dialog-Frame.
     1151   END PROCEDURE.
     1152   PROCEDURE enable_UI :
     1153     OPEN QUERY Dialog-Frame FOR EACH tt-assortment-matrix SHARE-LOCK.
     1154     GET FIRST Dialog-Frame.
     1155     DISPLAY T-relation v-rel-id v-shablon-name
     1156         WITH FRAME Dialog-Frame.
     1157     IF AVAILABLE tt-assortment-matrix THEN
     1158       DISPLAY tt-assortment-matrix.asmt-id tt-assortment-matrix.asmt-type
     1159             tt-assortment-matrix.obj-type tt-assortment-matrix.obj-code
     1160             tt-assortment-matrix.asmt-name tt-assortment-matrix.asmt-des
     1161             tt-assortment-matrix.obj-name
     1162         WITH FRAME Dialog-Frame.
     1163     ENABLE B-exit b-quit B-Hist B-Help tt-assortment-matrix.asmt-id
     1164            tt-assortment-matrix.asmt-type tt-assortment-matrix.obj-type
     1165            tt-assortment-matrix.obj-code r-obj T-relation r-assmatr
     1166            tt-assortment-matrix.asmt-name tt-assortment-matrix.asmt-des
     1167            tt-assortment-matrix.obj-name v-rel-id v-shablon-name
     1168         WITH FRAME Dialog-Frame.
     1169     VIEW FRAME Dialog-Frame.
     1170   END PROCEDURE.
     1171   PROCEDURE init-attr :
     1172   define variable v-exist   as logical   no-undo .
     1173   define variable v-type    as character no-undo .
     1174   define variable v-value   as character no-undo .
     1175   define buffer bufsh_assortment-matrix for ub.assortment-matrix  .
     1176   v-shablon-name = "" .
     1177     run assmatat-exist (
     1178         input tt-assortment-matrix.asmt-id
     1179         ,input tt-assortment-matrix.db-num
     1180         ,input 'RootShablon':U
     1181         ,output v-exist
     1182         ) .
     1183     if v-exist then do:
     1184     run assmatat-value (
     1185         input tt-assortment-matrix.asmt-id
     1186         ,input tt-assortment-matrix.db-num
     1187         ,input 'RootShablon':U
     1188         ,output v-value
     1189         ,output v-type
     1190         ) .
     1191        find first bufsh_assortment-matrix no-lock where
     1192                   bufsh_assortment-matrix.asmt-id = int(entry(1,v-value,chr(4))) and
     1193                   bufsh_assortment-matrix.db-num  = int(entry(2,v-value,chr(4))) no-error .
     1194       if not available bufsh_assortment-matrix then do:
     1195           assign
     1196               tt-assortment-matrix.is-rel = false
     1197               tt-assortment-matrix.rel-id = ""
     1198           .
     1199       end.
     1200       else do:
     1201        assign
     1202           tt-assortment-matrix.is-rel = true
     1203           tt-assortment-matrix.rel-id = v-value
     1204           v-shablon-name = bufsh_assortment-matrix.asmt-name
     1205        .
     1206        end.
     1207     end.
     1208     else do:
     1209        assign
     1210           tt-assortment-matrix.is-rel = false
     1211           tt-assortment-matrix.rel-id = ""
     1212        .
     1213      end.
     1214      assign
     1215         T-relation =    tt-assortment-matrix.is-rel
     1216         v-rel-id   =    tt-assortment-matrix.rel-id
     1217      .
     1218   END PROCEDURE.
     1219   PROCEDURE MyENable :
     1220   tt-assortment-matrix.asmt-type:RADIO-BUTTONS IN FRAME Dialog-Frame
     1221                   = 'Объект':U + chr(44) + 'Объект':U + chr(44) +
     1222                   'Шаблон':U + chr(44) + 'Шаблон':U .
     1223     run select-list-sh .
     1224     case p-mode:
     1225     when 'ДОБАВЛЕНИЕ':U then do:
     1226       tt-assortment-matrix.asmt-type  = 'Шаблон':U .
     1227       display
     1228       ? @ tt-assortment-matrix.asmt-id
     1229       ? @ tt-assortment-matrix.obj-code
     1230       ? @ tt-assortment-matrix.obj-type
     1231       ? @ tt-assortment-matrix.obj-name
     1232           tt-assortment-matrix.asmt-type
     1233       WITH FRAME Dialog-Frame.
     1234       RUN proc-rs-type.
     1235     end.
     1236     otherwise do:
     1237       IF AVAILABLE tt-assortment-matrix THEN
     1238       DISPLAY
     1239       tt-assortment-matrix.asmt-id
     1240       tt-assortment-matrix.asmt-name
     1241       tt-assortment-matrix.asmt-des
     1242       tt-assortment-matrix.asmt-type
     1243       tt-assortment-matrix.obj-code
     1244       tt-assortment-matrix.obj-type
     1245       tt-assortment-matrix.obj-name
     1246       WITH FRAME Dialog-Frame.
     1247     end.
     1248   END CASE.
     1249   if p-mode = 'ПРОСМОТР':U then do:
     1250   assign
     1251   b-quit:label = "&Выход"
     1252   b-quit:col = 1
     1253   .
     1254   hide
     1255   b-exit in frame Dialog-Frame.
     1256   end.
     1257   ENABLE
     1258   B-exit when p-mode <> 'ПРОСМОТР':U
     1259   b-quit
     1260   B-Hist when p-mode <> 'ДОБАВЛЕНИЕ':U
     1261   B-Help
     1262   r-obj                           when p-mode = 'ДОБАВЛЕНИЕ':U  and  tt-assortment-matrix.asmt-type  <> 'Шаблон':U
     1263   tt-assortment-matrix.obj-code   when p-mode = 'ДОБАВЛЕНИЕ':U  and  tt-assortment-matrix.asmt-type  <> 'Шаблон':U
     1264   tt-assortment-matrix.obj-type   when p-mode = 'ДОБАВЛЕНИЕ':U  and  tt-assortment-matrix.asmt-type  <> 'Шаблон':U
     1265   tt-assortment-matrix.asmt-type  when p-mode = 'ДОБАВЛЕНИЕ':U
     1266   tt-assortment-matrix.asmt-name  when p-mode <> 'ПРОСМОТР':U
     1267   tt-assortment-matrix.asmt-des   when p-mode <> 'ПРОСМОТР':U
     1268   WITH FRAME Dialog-Frame.
     1269   VIEW FRAME Dialog-Frame.
     1270   END PROCEDURE.
     1271   PROCEDURE proc-rs-type :
     1272     IF  tt-assortment-matrix.asmt-TYPE = 'Объект':U THEN DO:
     1273         DISPLAY tt-assortment-matrix.obj-type tt-assortment-matrix.obj-code r-obj T-relation r-assmatr v-rel-id v-shablon-name tt-assortment-matrix.obj-name WITH FRAME Dialog-Frame .
     1274         ENABLE tt-assortment-matrix.obj-type tt-assortment-matrix.obj-code r-obj T-relation r-assmatr v-rel-id v-shablon-name WITH FRAME Dialog-Frame .
     1275     END.
     1276     ELSE DO:
     1277        tt-assortment-matrix.obj-code = 0 .
     1278        tt-assortment-matrix.obj-type = "" .
     1279        tt-assortment-matrix.obj-name = "" .
     1280        t-relation = false .
     1281        v-rel-id = "".
     1282        v-shablon-name = "".
     1283        DISPLAY tt-assortment-matrix.obj-type tt-assortment-matrix.obj-code r-obj T-relation r-assmatr v-rel-id v-shablon-name tt-assortment-matrix.obj-name WITH FRAME Dialog-Frame .
     1284        DISABLE tt-assortment-matrix.obj-type tt-assortment-matrix.obj-code r-obj T-relation r-assmatr v-rel-id v-shablon-name tt-assortment-matrix.obj-name WITH FRAME Dialog-Frame .
     1285     END.
     1286   END PROCEDURE.
     1287   PROCEDURE Proc-save :
     1288   if p-mode = 'ПРОСМОТР':U then do:
     1289       return error.
     1290   end.
     1291   if not available tt-assortment-matrix then do:
     1292       create tt-assortment-matrix.
     1293   end.
     1294   assign
     1295     frame Dialog-Frame
     1296     tt-assortment-matrix.asmt-id
     1297     tt-assortment-matrix.asmt-name
     1298     tt-assortment-matrix.asmt-type
     1299     tt-assortment-matrix.obj-type
     1300     tt-assortment-matrix.obj-code
     1301     T-relation
     1302     v-rel-id
     1303     .
     1304   assign
     1305     tt-assortment-matrix.asmt-des = tt-assortment-matrix.asmt-des:SCREEN-VALUE.
     1306   IF tt-assortment-matrix.asmt-TYPE = 'Объект':U  THEN DO:
     1307       IF tt-assortment-matrix.obj-type = "" AND tt-assortment-matrix.obj-code = 0 THEN DO:
     1308           MESSAGE "Не заполнено значение Объекта !"
     1309                    view-as alert-box ERROR.
     1310           return error  .
     1311       END.
     1312       find first X_curr_clients no-lock where
     1313                  X_curr_clients.obj-type = tt-assortment-matrix.obj-type AND
     1314                  X_curr_clients.obj-code = tt-assortment-matrix.obj-code no-error.
     1315   if not available X_curr_clients then do:
     1316    message
     1317    vss-workfile vss-revision vss-description skip
     1318    "Неверное значение для поиска Объекта"
     1319        tt-assortment-matrix.obj-type
     1320        tt-assortment-matrix.obj-code
     1321        view-as alert-box ERROR.
     1322    return error .
     1323   end.
     1324    run leave-proc-obj no-error .
     1325      if error-status :error then return error return-value .
     1326   end.
     1327   define buffer bufsh_assortment-matrix for ub.assortment-matrix  .
     1328   if T-relation then do:
     1329        find first bufsh_assortment-matrix no-lock where
     1330                   bufsh_assortment-matrix.asmt-id = int(entry(1,v-rel-id,chr(4))) and
     1331                   bufsh_assortment-matrix.db-num  = int(entry(2,v-rel-id,chr(4))) no-error .
     1332       if not available bufsh_assortment-matrix then do:
     1333        message "Не верно задан ШАБЛОН МАТРИЦ !" view-as alert-box information .
     1334        return error return-value .
     1335       end.
     1336       if bufsh_assortment-matrix.asmt-type <> 'Шаблон':U then do:
     1337         message "Можно выбрать только  ШАБЛОН МАТРИЦ !" view-as alert-box information .
     1338         return error return-value .
     1339       end.
     1340       if bufsh_assortment-matrix.asmt-status <> 0 then do:
     1341         message "Статус ШАБЛОНА МАТРИЦ  должен быть текущим!" view-as alert-box information .
     1342         return error return-value .
     1343       end.
     1344   end.
     1345   run ref/assmatr1.p
     1346   (input-output p-doc-rec
     1347   ,input p-mode
     1348   ,input tt-assortment-matrix.asmt-id
     1349   ,input tt-assortment-matrix.asmt-name
     1350   ,input tt-assortment-matrix.asmt-des
     1351   ,input tt-assortment-matrix.asmt-type
     1352   ,input tt-assortment-matrix.obj-type
     1353   ,input tt-assortment-matrix.obj-code
     1354   ,input T-relation
     1355   ,input v-rel-id
     1356   ) no-error.
     1357   if error-status:error then do:
     1358   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1359   define variable fh as widget-handle no-undo .
     1360   define variable hh as widget-handle no-undo .
     1361   define variable rv as character no-undo .
     1362   assign
     1363   rv = entry(1, return-value , chr(4)).
     1364   if rv <> "":U then do:
     1365     assign
     1366     fh = frame Dialog-Frame:first-child
     1367     hh = fh:first-child
     1368     .
     1369     do while valid-handle(hh):
     1370       if hh:name = rv then do:
     1371         APPLY "ENTRY" to hh.
     1372         undo ,
     1373         return error.
     1374       end.
     1375       hh = hh:next-sibling.
     1376     end.
     1377   end.
     1378      undo, return error.
     1379   end.
     1380   END PROCEDURE.
     1381   PROCEDURE select-list-sh :
     1382     if tt-assortment-matrix.asmt-type = 'Шаблон':U then do:
     1383       hide
     1384         v-rel-id in frame Dialog-Frame
     1385         v-shablon-name
     1386         r-assmatr
     1387         t-relation
     1388         in frame Dialog-Frame .
     1389     end.
     1390     else do:
     1391         if p-mode <> 'ПРОСМОТР':U then do:
     1392             enable  t-relation with frame Dialog-Frame .
     1393         end.
     1394         display t-relation with frame Dialog-Frame .
     1395         if t-relation then do:
     1396            display v-rel-id v-shablon-name r-assmatr with frame  Dialog-Frame.
     1397            if p-mode <> 'ПРОСМОТР':U then do:
     1398               enable  r-assmatr with frame  Dialog-Frame.
     1399            end.
     1400         end.
     1401         else do:
     1402           disable v-rel-id v-shablon-name r-assmatr with frame Dialog-Frame.
     1403           hide    v-rel-id v-shablon-name r-assmatr in frame Dialog-Frame.
     1404         end.
     1405     end.
     1406   END PROCEDURE.
