        1   block-level on error undo, throw.
        2   define input parameter p-d-card                 like ub.dis-card.d-card no-undo .
        3   define input parameter p-type                   like ub.dis-card.type no-undo .
        4   define input parameter p-emitent-host-code      like ub.dis-card.emitent-host-code no-undo .
        5   define input parameter p-issue-code             like ub.dis-card.issue-code no-undo .
        6   define output parameter p-can-issue              as logical no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: dcardi04.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: ref/dcardi04.p $":U .
       12   define variable vss-description as character no-undo init "Проверка возможности ввода ДК, по соответствующей маске и коду объекта выдачи".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3|&4':u,p-d-card,p-type,p-emitent-host-code,p-issue-code)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   function check-by-mask returns logical (
       87     input p-mask  as character
       88     ,input p-str as character
       89      ,output p-descr as character
       90     ).
       91   define variable ii as integer no-undo .
       92   define variable v-max as integer no-undo .
       93   define variable v-mask-char as character no-undo .
       94   assign
       95   v-max = length (p-mask).
       96   _do:
       97   do ii = 1 to v-max:
       98     assign
       99     v-mask-char = substring(p-mask, ii, 1).
      100     if v-mask-char = chr(63) then NEXT _do.
      101     if v-mask-char = "*":U then do:
      102       if ii < v-max then do:
      103         assign
      104         p-descr = substitute("неверная маска &1: звездочка может быть только последним символом маски").
      105         return no .
      106       end.
      107       return yes.
      108     end.
      109     else do:
      110       if v-mask-char <> substring(p-str, ii, 1) then do:
      111         assign
      112         p-descr = substitute("№ ДК &1 не соответствует МАСКЕ &2", p-str, p-mask).
      113         return no.
      114       end.
      115       next _do.
      116     end.
      117   end.
      118   if v-mask-char = chr(63) and v-max = length(p-str) then return yes.
      119   end function.
      120   define variable v-host-code like ub.sysconf.host-code no-undo .
      121   define variable v-descr     as character no-undo .
      122   define variable v-is-correct as logical no-undo .
      123   define variable v-found      as logical no-undo .
      124   define variable v-type       as character no-undo .
      125   define buffer buf_dis-card-mask for ub.dis-card-mask.
      126   define buffer buf_dis-card-type for ub.dis-card-type .
      127   do
      128   on error undo, return error substitute("&1 &2 &3:&4&5 &6"
      129                                           , vss-workfile
      130                                           , vss-revision
      131                                           , vss-description
      132                                           , chr(10)
      133                                           , error-status:get-message(1)
      134                                           , return-value )
      135   :
      136     if p-issue-code = ?
      137     or p-issue-code = 0 then do:
      138        undo, return error substitute( "Не опеределен код магазина, выдавшего карту").
      139     end.
      140   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      142     (input  'маг':U
      143     ,input  p-issue-code
      144     ,output v-host-code
      145     )  .
      146     find first buf_dis-card-type share-lock where
      147               buf_dis-card-type.emitent-host-code = p-emitent-host-code
      148           and buf_dis-card-type.type = p-type
      149           and buf_dis-card-type.host-code = 0
      150           and buf_dis-card-type.obj-type = '':U
      151           and buf_dis-card-type.obj-code = 0 .
      152     if buf_dis-card-type.check-by-mask = 0 then do:
      153       assign
      154       p-can-issue = yes.
      155       return.
      156     end.
      157     _maska:
      158     for each buf_dis-card-mask no-lock where
      159             buf_dis-card-mask.emitent-host-code = p-emitent-host-code
      160         AND buf_dis-card-mask.type              = p-type
      161         AND buf_Dis-card-mask.stts              = integer('0':U)
      162     by buf_Dis-card-mask.host-code
      163     by buf_Dis-card-mask.obj-type
      164     by buf_Dis-card-mask.obj-code
      165     by buf_Dis-card-mask.rank:
      166       if buf_dis-card-type.ho-join = 1
      167       and
      168       buf_dis-card-mask.host-code <> 0
      169       And buf_dis-card-mask.host-code <> v-host-code then next.
      170       if buf_dis-card-type.ho-join = 1
      171       and
      172       buf_dis-card-mask.obj-type <> "":U
      173       AND
      174          (buf_dis-card-mask.obj-type <> 'маг':U
      175       or buf_dis-card-mask.obj-code <> p-issue-code) then NEXT.
      176       if buf_dis-card-mask.use-on = integer('1':U) then NEXT.
      177       assign
      178       v-found = yes
      179       v-descr = "":U
      180       .
      181       assign
      182       v-is-correct = check-by-mask (buf_dis-card-mask.mask,  p-d-card, output v-descr)
      183       no-error
      184       .
      185       if error-status:error then undo, return error v-descr.
      186       if v-is-correct then do:
      187         assign
      188         p-can-issue = yes.
      189         return .
      190       end.
      191     end.
      192     if not v-found then do:
      193       return substitute("Для карты &1 (тип &2 эмитент &3) не определено ни одной действующей маски, для объекта выдачи карты маг&4"
      194                                     , p-d-card
      195                                     , p-type
      196                                     , p-emitent-host-code
      197                                     , p-issue-code).
      198     end.
      199     else do:
      200       return substitute("Карта &1 (тип &2 эмитент &3) не соответствует ни одной действующей маски, для объекта выдачи карты маг&4"
      201                                     , p-d-card
      202                                     , p-type
      203                                     , p-emitent-host-code
      204                                     , p-issue-code).
      205     end.
      206   end.
