     1233     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1234     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1235     if p-change-value > 0
     1236     then do:
     1237       if frame Dialog-Frame :width + p-change-value >
     1238           session :width-chars
     1239       then do:
     1240         assign
     1241           p-change-value = session :width-chars - frame Dialog-Frame :width
     1242         .
     1243         if p-change-value <= 0
     1244         then do:
     1245           run diasize_position-resize-button in this-procedure .
     1246           return .
     1247         end.
     1248       end.
     1249     end.
     1250     if p-change-value < 0
     1251     then do:
     1252       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1253       then do:
     1254         assign
     1255           p-change-value = v-diasize-orig-frame-width
     1256                          - frame Dialog-Frame :width
     1257         .
     1258         if p-change-value >= 0
     1259         then do:
     1260           run diasize_position-resize-button in this-procedure .
     1261           return .
     1262         end.
     1263       end.
     1264     end.
     1265     if p-change-value >= 0
     1266     then do:
     1267       assign
     1268         v-change-sign = 1
     1269       .
     1270     end.
     1271     else do:
     1272       assign
     1273         v-change-sign = -1
     1274       .
     1275     end.
     1276     assign
     1277       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1278     .
     1279     if p-change-value = 0
     1280     then do:
     1281       run diasize_position-resize-button in this-procedure .
     1282       return .
     1283     end.
