     1578           define variable v-cntxt-db-num        as integer   no-undo .
     1579           define variable v-cntxt-userid        as character no-undo .
     1580           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1581                                             , OUTPUT v-cntxt-userid
     1582                                             ) .
     1583           run gbl/wndsizew.p
     1584             (input  v-cntxt-db-num
     1585             ,input  v-cntxt-userid
     1586             ,input  v-diasize-proc-name
     1587             ,input  'width':u
     1588             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1589             ) .
     1590         end.
     1591       end.
     1592     end.
     1593     assign
     1594       v-diasize-change-size = false
     1595     .
     1596   end procedure.
     1597   procedure diasize_set-width :
     1598     define input  parameter p-new-width  as decimal   no-undo .
     1599     define input  parameter p-move-resize as logical   no-undo .
     1600     do
     1601     on error undo, return error return-value
     1602     :
     1603       run diasize_change-width in this-procedure
     1604         (input  (p-new-width - frame Dialog-Frame :width)
     1605         ,input  p-move-resize
     1606         ) .
     1607     end.
     1608   end procedure.
     1609   procedure diasize_position-resize-button :
     1610     do with frame Dialog-Frame
     1611     :
     1612       hide v-diasize-resize-button .
     1613       assign
     1614         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1615                     - 1
     1616                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1617         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1618                     - 1
     1619                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1620       .
     1621       view v-diasize-resize-button .
     1622     end.
     1623   end procedure.
     1624   on alt-right anywhere
     1625   do:
     1626     run diasize_change-width in this-procedure
     1627       (input 1
     1628       ,input true
     1629       ) .
     1630     return no-apply .
     1631   end.
     1632   on alt-left anywhere
     1633   do:
     1634     run diasize_change-width in this-procedure
     1635       (input -1
     1636       ,input true
     1637       ) .
     1638     return no-apply .
     1639   end.
     1640   on alt-down anywhere
     1641   do:
     1642     run diasize_change-height in this-procedure
     1643       (input 1
     1644       ,input true
     1645       ) .
     1646     return no-apply .
     1647   end.
     1648   on alt-up anywhere
     1649   do:
     1650     run diasize_change-height in this-procedure
     1651       (input -1
     1652       ,input true
     1653       ) .
     1654     return no-apply .
     1655   end.
     1656   on alt-enter of frame Dialog-Frame
     1657   do:
     1658     run diasize_maximize in this-procedure
     1659       (input  ?
     1660       ).
     1661     return no-apply .
     1662   end.
     1663   procedure diasize_end-move :
     1664     do
     1665     on error undo, return error return-value
     1666     :
     1667       define variable v-row-delta as decimal   no-undo .
     1668       define variable v-col-delta as decimal   no-undo .
     1669       define variable v-new-row as decimal   no-undo .
     1670       define variable v-new-col as decimal   no-undo .
     1671       assign
     1672         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1673         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1674       .
     1675       assign
     1676         v-row-delta = v-new-row - frame Dialog-Frame :height
     1677         v-col-delta = v-new-col - frame Dialog-Frame :width
     1678       .
     1679       run diasize_change-height in this-procedure
     1680         (input v-row-delta
     1681         ,input true
     1682         ) .
     1683       run diasize_change-width in this-procedure
     1684         (input v-col-delta
     1685         ,input true
     1686         ) .
     1687     end.
     1688   end procedure.
     1689   procedure diasize_maximize :
     1690     define input  parameter p-action as logical   no-undo .
     1691     do
     1692     on error undo, return error return-value
     1693     :
     1694       if p-action = ?
     1695       then do:
     1696         if v-diasize-need-maximize = true
     1697         then do:
     1698           assign
     1699             p-action = true
     1700           .
     1701         end.
     1702         else do:
     1703           assign
     1704             p-action = false
     1705           .
     1706         end.
     1707       end.
     1708       if p-action = true
     1709       then do:
     1710         run diasize_change-height in this-procedure
     1711           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1712               - frame Dialog-Frame :height-chars
     1713           ,input true
     1714           ) .
     1715         run diasize_change-width in this-procedure
     1716           (input session :width-chars
     1717               - frame Dialog-Frame :width-chars
     1718           ,input true
     1719           ) .
     1720         assign
     1721           v-diasize-need-maximize = false
     1722         .
     1723       end.
     1724       else do:
     1725         run diasize_change-width in this-procedure
     1726           (input v-diasize-orig-frame-width
     1727               - frame Dialog-Frame :width-chars
     1728           ,input true
     1729           ) .
     1730         run diasize_change-height in this-procedure
     1731           (input v-diasize-orig-frame-height
     1732               - frame Dialog-Frame :height-chars
     1733           ,input true
     1734           ) .
     1735         assign
     1736           v-diasize-need-maximize = true
     1737         .
     1738       end.
     1739     end.
     1740   end procedure.
     1741   procedure diasize_restore-orig-size :
     1742     do
     1743     on error undo, return error return-value
     1744     :
     1745       assign
     1746         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1747         v-diasize-current-frame-height = frame Dialog-Frame :height
     1748       .
     1749       run diasize_set-height in this-procedure
     1750         (input  v-diasize-orig-frame-height
     1751         ,input  true
     1752         ) .
     1753       run diasize_set-width in this-procedure
     1754         (input  v-diasize-orig-frame-width
     1755         ,input  true
     1756         ) .
     1757     end.
     1758   end procedure.
     1759   procedure diasize_restore-current-size :
     1760     do
     1761     on error undo, return error return-value
     1762     :
     1763       run diasize_set-height in this-procedure
     1764         (input  v-diasize-current-frame-height
     1765         ,input  true
     1766         ) .
     1767       run diasize_set-width in this-procedure
     1768         (input  v-diasize-current-frame-width
     1769         ,input  true
     1770         ) .
     1771     end.
     1772   end procedure.
     1773   procedure diasize_set-browse-handle :
     1774     define input  parameter p-browse-handle as handle   no-undo .
     1775     define buffer buf_temp-browse-handle for temp-browse-handle .
     1776     do
     1777     on error undo, return error return-value
     1778     :
     1779       assign
     1780         v-diasize-browse-handle = p-browse-handle
     1781       .
     1782       for each buf_temp-browse-handle
     1783       on error undo, return error return-value
     1784       :
     1785         delete buf_temp-browse-handle .
     1786       end.
     1787     end.
     1788   end procedure.
     1789   procedure diasize_add_browse :
     1790     define input  parameter p-browse-type   as character no-undo .
     1791     define input  parameter p-browse-handle as handle    no-undo .
     1792     define buffer buf_temp-browse-handle for temp-browse-handle .
     1793     do
     1794     on error undo, return error return-value
     1795     :
     1796       assign
     1797         v-diasize-browse-number = v-diasize-browse-number + 1
     1798       .
     1799       create buf_temp-browse-handle .
     1800       assign
     1801         buf_temp-browse-handle.browse-type   = p-browse-type
     1802         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1803         buf_temp-browse-handle.browse-handle = p-browse-handle
     1804       .
     1805     end.
     1806   end procedure.
     1807   procedure diasize_init :
     1808     define variable v-default-value    as logical   no-undo .
     1809     define variable v-restore-saved    as logical   no-undo .
     1810     define variable v-resize-value-str as character no-undo .
     1811     do
     1812     on error undo, return error return-value
     1813     :
     1814       do with frame Dialog-Frame
     1815       :
     1816         assign
     1817           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1818           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1819           v-diasize-browse-handle     = browse BR-hn :handle
     1820         .
     1821         create button v-diasize-resize-button
     1822         assign
     1823           parent        = frame Dialog-Frame :first-child
     1824           label         = "s"
     1825           height-pixels = 16
     1826           width-pixels  = 16
     1827           visible       = true
     1828           sensitive     = true
     1829           movable       = true
     1830           triggers:
     1831             on end-move persistent run diasize_end-move in this-procedure .
     1832           end triggers.
     1833         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1834         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1835         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1836         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1837         assign
     1838           v-diasize-wndmax = false
     1839         .
     1840         if connected("ub") = true
     1841         then do:
     1842           define variable v-cntxt-db-num        as integer   no-undo .
     1843           define variable v-cntxt-userid        as character no-undo .
     1844           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1845                                             , OUTPUT v-cntxt-userid
     1846                                             ) .
     1847           run gbl/wndpar_r.p
     1848             (input  v-cntxt-db-num
     1849             ,input  v-cntxt-userid
     1850             ,input  'wndmax':U
     1851             ,output v-diasize-wndmax
     1852             ,output v-default-value
     1853             ) .
     1854         end.
     1855         assign
     1856           v-diasize-wndstore = false
     1857         .
     1858         if connected("ub") = true
     1859         then do:
     1860           run gbl/wndpar_r.p
     1861             (input  v-cntxt-db-num
     1862             ,input  v-cntxt-userid
     1863             ,input  'wndstore':U
     1864             ,output v-diasize-wndstore
     1865             ,output v-default-value
     1866             ) .
     1867         end.
     1868         assign
     1869           v-diasize-proc-name = entry(1, program-name(2), '.')
     1870         .
     1871         if v-diasize-wndstore = true
     1872         then do:
     1873           assign
     1874             v-restore-saved = false
     1875           .
     1876           if connected("ub") = true
     1877           then do:
     1878             run gbl/wndsizer.p
     1879               (input  v-cntxt-db-num
     1880               ,input  v-cntxt-userid
     1881               ,input  v-diasize-proc-name
     1882               ,input  'height':u
     1883               ,output v-resize-value-str
     1884               ) .
     1885             if v-resize-value-str <> '':U
     1886             then do:
     1887               run diasize_change-height in this-procedure
     1888                 (input  integer(v-resize-value-str)
     1889                 ,input  true
     1890                 ) .
     1891               assign
     1892                 v-restore-saved = true
     1893               .
     1894             end.
     1895           end.
     1896           if connected("ub") = true
     1897           then do:
     1898             run gbl/wndsizer.p
     1899               (input  v-cntxt-db-num
     1900               ,input  v-cntxt-userid
     1901               ,input  v-diasize-proc-name
     1902               ,input  'width':u
     1903               ,output v-resize-value-str
     1904               ) .
     1905             if v-resize-value-str <> '':U
     1906             then do:
     1907               run diasize_change-width in this-procedure
     1908                 (input  integer(v-resize-value-str)
     1909                 ,input  true
     1910                 ) .
     1911               assign
     1912                 v-restore-saved = true
     1913               .
     1914             end.
     1915           end.
     1916           if v-restore-saved <> true
     1917           then do:
     1918             if v-diasize-wndmax = true
     1919             then do:
     1920               run diasize_maximize in this-procedure
     1921                 (input  true
     1922                 ) .
     1923             end.
     1924           end.
     1925         end.
     1926         else do:
     1927           if v-diasize-wndmax = true
     1928           then do:
     1929             run diasize_maximize in this-procedure
     1930               (input  true
     1931               ) .
     1932           end.
     1933         end.
     1934       end.
     1935     end.
     1936   end procedure.
     1937   procedure diasize_need-full-display :
     1938     define output parameter p-need-full-display as logical   no-undo .
     1939     do
     1940     on error undo, return error return-value
     1941     :
     1942       assign
     1943         p-need-full-display = v-diasize-need-full-display
     1944       .
     1945       assign
     1946         v-diasize-need-full-display = false
     1947       .
     1948     end.
     1949   end procedure.
     1950   procedure get-context :
     1951      define output parameter p-db-num as integer          no-undo.
     1952      define output parameter p-user-id as character        no-undo.
     1953      define variable v-login               as character    no-undo.
     1954      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1955      define buffer buf_user-login  for ub.user-login .
     1956      do
     1957      on error undo, return error
     1958      :
     1959            FIND FIRST buf_sys-ctrl no-lock.
     1960            ASSIGN
     1961               v-login = USERID("ub")
     1962               p-db-num = buf_sys-ctrl.db-num
     1963            .
     1964            FIND FIRST buf_user-login
     1965                 WHERE buf_user-login.db-num = p-db-num
     1966                   AND buf_user-login.user-login = v-login
     1967                 no-lock
     1968                 no-error
     1969                 .
     1970            IF AVAILABLE buf_user-login
     1971            THEN DO:
     1972               assign
     1973                  p-user-id = buf_user-login.user-id
     1974               .
     1975            END.
     1976      end.
     1977   end procedure.
     1978       run diasize_init in this-procedure .
     1979   MAIN-BLOCK:
     1980   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1981      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1982     RUN fill-tt0 IN THIS-PROCEDURE.
     1983     RUN Myenable.
     1984     WAIT-FOR GO OF FRAME Dialog-Frame.
     1985   END.
     1986   RUN disable_UI.
     1987   PROCEDURE disable_UI :
     1988     HIDE FRAME Dialog-Frame.
     1989   END PROCEDURE.
     1990   PROCEDURE enable_UI :
     1991     ENABLE B-exit b-quit B-Help BR-hn
     1992         WITH FRAME Dialog-Frame.
     1993     VIEW FRAME Dialog-Frame.
     1994     OPEN QUERY BR-hn FOR EACH tt0-hist-nws-option NO-LOCK INDEXED-REPOSITION.
     1995   END PROCEDURE.
     1996   PROCEDURE fill-tt0 :
     1997   DEFINE BUFFER buf_tt-hist-nws-option FOR tt-hist-nws-option.
     1998   define buffer  buf_tt0-hist-nws-option for tt0-hist-nws-option.
     1999   FOR EACH buf_tt-hist-nws-option:
     2000     CREATE buf_tt0-hist-nws-option.
     2001     BUFFER-COPY buf_tt-hist-nws-option TO buf_tt0-hist-nws-option.
     2002   END.
     2003   run fill-tt0-hist-nws-option in this-procedure ( input p-emitent-host-code
     2004                                                   ,input p-type).
     2005   END PROCEDURE.
     2006   PROCEDURE MyEnable :
     2007   ASSIGN
     2008   tt0-hist-nws-option.option-descr:RESIZABLE IN BROWSE br-hn = YES
     2009   tt0-hist-nws-option.hist-to-nws-is-on:READ-ONLY in BROWSE br-hn = (p-mode = 'ПРОСМОТР':U)
     2010   tt0-hist-nws-option.nws-to-hist-is-on:READ-ONLY in BROWSE br-hn = (p-mode = 'ПРОСМОТР':U)
     2011   tt0-hist-nws-option.hist-from-prim-is-on:READ-ONLY in BROWSE br-hn = (p-mode = 'ПРОСМОТР':U)
     2012   tt0-hist-nws-option.get-hist-from-nws-is-on:READ-ONLY in BROWSE br-hn = (p-mode = 'ПРОСМОТР':U)
     2013   tt0-hist-nws-option.nws-to-cd-is-on:READ-ONLY in BROWSE br-hn = (p-mode = 'ПРОСМОТР':U)
     2014   tt0-hist-nws-option.smart-nws-is-on:READ-ONLY in BROWSE br-hn = (p-mode = 'ПРОСМОТР':U)
     2015   .
     2016   ENABLE
     2017   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     2018   b-quit
     2019   B-Help
     2020   br-hn
     2021   WITH FRAME Dialog-Frame.
     2022   IF p-mode = 'ПРОСМОТР':U THEN DO:
     2023     HIDE
     2024     b-exit
     2025     IN FRAME Dialog-Frame.
     2026     ASSIGN
     2027     b-quit:COLUMN = 1
     2028     b-quit:LABEL = "&Выход".
     2029   END.
     2030   VIEW FRAME Dialog-Frame.
     2031   assign
     2032   tt0-hist-nws-option.smart-nws-is-on:LIST-ITEMs  = 'Да,Нет,Смарт2':U
     2033   tt0-hist-nws-option.smart-nws-is-on:INNER-LINES in BROWSE br-hn = 5
     2034   .
     2035   frame Dialog-Frame:title = substitute("&1: тип ДК &2, эмитент &3"
     2036                                          , frame Dialog-Frame:title
     2037                                          , p-type
     2038                                          , p-emitent-host-code).
     2039   OPEN QUERY BR-hn FOR EACH tt0-hist-nws-option NO-LOCK INDEXED-REPOSITION.
     2040   END PROCEDURE.
     2041   PROCEDURE proc-save :
     2042   DEFINE BUFFER buf_tt-hist-nws-option FOR tt-hist-nws-option.
     2043   DEFINE BUFFER buf_tt0-hist-nws-option FOR tt0-hist-nws-option.
     2044   p-ok = yes.
     2045   FOR EACH buf_tt0-hist-nws-option
     2046   ON error UNDO, RETURN ERROR return-value
     2047   ON STOP UNDO, RETURN ERROR return-value :
     2048     FIND FIRST buf_tt-hist-nws-option WHERE
     2049               buf_tt-hist-nws-option.table-name = buf_tt0-hist-nws-option.table-name
     2050            and buf_tt-hist-nws-option.host-code = p-emitent-host-code
     2051            and buf_tt-hist-nws-option.obj-type = '':U
     2052            and buf_tt-hist-nws-option.obj-code = 0
     2053            and buf_tt-hist-nws-option.key#_one = buf_tt0-hist-nws-option.key#_one
     2054            and buf_tt-hist-nws-option.charkey_one = p-type no-error.
     2055     IF NOT AVAILABLE buf_tt-hist-nws-option THEN DO:
     2056       CREATE buf_tt-hist-nws-option.
     2057       BUFFER-COPY buf_tt0-hist-nws-option TO buf_tt-hist-nws-option.
     2058     END.
     2059     assign
     2060     buf_tt-hist-nws-option.hist-to-nws = (IF buf_tt0-hist-nws-option.hist-to-nws-can
     2061                                       THEN (IF buf_tt0-hist-nws-option.hist-to-nws-is-on
     2062                                             THEN INTEGER('0':U)
     2063                                             ELSE INTEGER('-1':U)
     2064                                             )
     2065                                       ELSE buf_tt-hist-nws-option.hist-to-nws)
     2066     buf_tt-hist-nws-option.nws-to-hist = (IF buf_tt0-hist-nws-option.nws-to-hist-can
     2067                                         THEN (IF buf_tt0-hist-nws-option.nws-to-hist-is-on
     2068                                                 THEN INTEGER('0':U)
     2069                                                 ELSE INTEGER('-1':U)
     2070                                                 )
     2071                                         ELSE buf_tt-hist-nws-option.nws-to-hist)
     2072     buf_tt-hist-nws-option.get-hist-from-nws = (IF buf_tt0-hist-nws-option.get-hist-from-nws-can
     2073                                         THEN (IF buf_tt0-hist-nws-option.get-hist-from-nws-is-on
     2074                                                 THEN INTEGER('0':U)
     2075                                                 ELSE INTEGER('-1':U)
     2076                                                 )
     2077                                         ELSE buf_tt-hist-nws-option.get-hist-from-nws)
     2078     buf_tt-hist-nws-option.hist-from-prim = (IF buf_tt0-hist-nws-option.hist-from-prim-can
     2079                                         THEN (IF buf_tt0-hist-nws-option.hist-from-prim-is-on
     2080                                                   THEN INTEGER('0':U)
     2081                                                   ELSE INTEGER('-1':U)
     2082                                                   )
     2083                                         ELSE buf_tt-hist-nws-option.hist-from-prim)
     2084     buf_tt-hist-nws-option.nws-to-cd = (IF buf_tt0-hist-nws-option.nws-to-cd-can
     2085                                             THEN (IF buf_tt0-hist-nws-option.nws-to-cd-is-on
     2086                                                     THEN INTEGER('0':U)
     2087                                                     ELSE INTEGER('-1':U)
     2088                                                     )
     2089                                             ELSE buf_tt-hist-nws-option.nws-to-cd).
     2090     buf_tt-hist-nws-option.smart-nws = (IF buf_tt0-hist-nws-option.smart-nws-can
     2091                                                 THEN  integer(get-hn-value(buf_tt0-hist-nws-option.smart-nws-is-on))
     2092                                                 ELSE buf_tt-hist-nws-option.smart-nws)
     2093         .
     2094   END.
     2095   END PROCEDURE.
     2096   FUNCTION get-hn-label RETURNS CHARACTER
     2097     ( INPUT p-hn-option AS integer ) :
     2098     RETURN entry (lookup (string(p-hn-option), '0,-1,1,10,-10':U) + 1, ',' + 'Да,Нет,Смарт2,Всегда,Никогда':U).
     2099   END FUNCTION.
     2100   FUNCTION get-hn-value RETURNS integer
     2101     ( INPUT p-hn-label AS character ) :
     2102     RETURN integer(entry (lookup (p-hn-label, 'Да,Нет,Смарт2,Всегда,Никогда':U) + 1, ',' + '0,-1,1,10,-10':U)).
     2103   END FUNCTION.
     2104   FUNCTION get-prop-head-label RETURNS CHARACTER
     2105     ( INPUT p-dtm-code AS INTEGER ) :
     2106   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     2107   FIND FIRST buf_prop-head NO-LOCK WHERE
     2108           buf_prop-head.dtm-code = p-dtm-code NO-ERROR.
     2109   IF NOT AVAILABLE buf_prop-head THEN  RETURN chr(63).
     2110   RETURN buf_prop-head.prop-label.
     2111   END FUNCTION.
