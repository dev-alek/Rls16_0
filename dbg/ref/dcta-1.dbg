        1   DEFINE TEMP-TABLE tt-hist-nws-option NO-UNDO LIKE ub.hist-nws-option.
        2   DEFINE TEMP-TABLE tt0-hist-nws-option NO-UNDO LIKE ub.hist-nws-option
        3          field get-hist-from-nws-is-on as logical
        4          field smart-nws-is-on as character
        5          field hist-to-nws-is-on as logical
        6          field hist-from-prim-is-on as logical
        7          field nws-to-cd-is-on as logical
        8          field nws-to-hist-is-on as logical
        9          field get-hist-from-nws-can as logical
       10          field smart-nws-can as logical
       11          field hist-to-nws-can as logical
       12          field hist-from-prim-can as logical
       13          field nws-to-cd-can as logical
       14          field nws-to-hist-can as logical.
       15   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
       16   DEFINE INPUT PARAMETER p-mode AS character NO-UNDO.
       17   define input parameter p-type like ub.dis-card-type.type no-undo .
       18   define input parameter p-emitent-host-code like ub.dis-card-type.emitent-host-code no-undo .
       19   define INPUT-OUTPUT parameter table for tt-hist-nws-option.
       20   define output parameter p-ok as logical no-undo .
       21   define variable vss-revision    as character no-undo init "$Revision$":U .
       22   define variable vss-author      as character no-undo init "$Author$":U .
       23   define variable vss-date        as character no-undo init "$Date$":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       25   define variable vss-archive     as character no-undo init "$Archive$":U .
       26   define variable vss-description as character no-undo init "Опции записи истории и маршрутизации для типа ДК".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define variable v-waitfram-action01         as character   no-undo .
       83   define variable v-waitfram-action02         as character   no-undo .
       84   define variable v-waitfram-action03         as character   no-undo .
       85   define variable mWaitFramTextBeg            as character   no-undo.
       86   define variable mWaitFramTextEnd            as character   no-undo.
       87   define variable mWaitFramView               as logical     no-undo.
       88   define variable mWaitProcEvent              as logical     no-undo init yes.
       89   define variable mWaitFramInterval           as integer     no-undo init 1 .
       90   define variable mWaitFramStop               as logical     no-undo.
       91   define variable mWaitFramStopUser           as logical     no-undo.
       92   define variable mWaitFramStopTimeOut        as logical     no-undo.
       93   define variable mWaitFramStartProc          as datetime-tz no-undo.
       94   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       95   define button B-WaitFramStop auto-end-key
       96        label "Стоп"
       97        size 10 by 1 tooltip "Остоновить процесс".
       98   define button B-viewProcInfo
       99        label "Информация"
      100        size 15 by 1 tooltip "Информация о процесс".
      101   define frame waitfram
      102     v-waitfram-action01 format "x(72)" no-label skip
      103     v-waitfram-action02 format "x(72)" no-label skip
      104     v-waitfram-action03 format "x(72)" no-label skip
      105     B-viewProcInfo
      106     B-WaitFramStop at row 4 col 30
      107     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      108     .
      109   define new global shared variable mBatchMode as logical no-undo init ?.
      110   define variable mFramBachModHandle as handle no-undo.
      111   mFramBachModHandle = frame waitfram:handle.
      112   define variable mFameOldVis as logical no-undo.
      113   define variable mVisCUrentVin as logical no-undo.
      114   if session:batch-mode
      115   then
      116      mBatchMode = yes.
      117   if mBatchMode = ? then do:
      118     mVisCUrentVin = current-window:visible.
      119     mFameOldVis = mFramBachModHandle:visible.
      120     mFramBachModHandle:visible  = yes.
      121     mBatchMode = mFramBachModHandle:visible ne yes.
      122     mFramBachModHandle:visible = mFameOldVis.
      123     current-window:visible = mVisCUrentVin.
      124   end.
      125    if  log-manager:logfile-name ne ?
      126     then DO:
      127         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      128         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      129         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      130     end.
      131   on choose of B-WaitFramStop in frame waitfram
      132   do:
      133     mWaitFramStop = yes.
      134     mWaitFramStopUser = yes.
      135   end.
      136   function waitfram-check-timeout returns logical():
      137      define variable vtime as int64 no-undo.
      138      if mWaitFramStopTimeOut
      139      then
      140         return yes.
      141      vtime = ( now - mWaitFramStartProc ) / 1000 .
      142      if     mWaitFramTimeOut ne ?
      143         and mWaitFramTimeOut ne 0
      144         and mWaitFramTimeOut lt vtime
      145      then do:
      146         mWaitFramStopTimeOut = yes.
      147      end.
      148      return mWaitFramStopTimeOut.
      149   end.
      150   procedure waitfram-hide :
      151     if not session:batch-mode
      152     then do
      153     on error undo, return error return-value
      154     :
      155       pause 0 before-hide .
      156       if not mBatchMode then
      157         hide frame waitfram .
      158     if     not mWaitFramView
      159        and mWaitProcEvent
      160     then
      161       process events .
      162     end.
      163   end procedure.
      164   procedure waitfram-show :
      165     define input  parameter p-message as character no-undo .
      166     define variable v-left-margin as integer   no-undo .
      167     if not session:batch-mode
      168     then do
      169     on error undo, return error return-value
      170     :
      171       if length(p-message) <= 70 then do:
      172         assign
      173           v-left-margin = integer((70 - length(p-message)) / 2)
      174         .
      175         assign
      176           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      177         .
      178         assign
      179           v-waitfram-action01 = " "
      180           v-waitfram-action02 = " "
      181                                    + fill(" ", v-left-margin)
      182                                    + p-message
      183           v-waitfram-action03 = " "
      184         .
      185       end.
      186       else do:
      187         define variable vRindex1 as integer no-undo.
      188         define variable vRindex2 as integer no-undo.
      189         vRindex1 = r-index(p-message," ",70).
      190         if vRindex1 = 0
      191         then
      192            vRindex1 = 70.
      193         if length(p-message)  <= vRindex1 + 70 then do:
      194           assign
      195             v-waitfram-action01 = " "
      196             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      197             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      198           .
      199         end.
      200         else do:
      201           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      202           if vRindex2 <= vRindex1
      203           then
      204              vRindex2 = vRindex1 + 70.
      205           assign
      206             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      207             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      208             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      209           .
      210         end.
      211       end.
      212       B-viewProcInfo:visible   in frame waitfram = no.
      213       B-viewProcInfo:sensitive in frame waitfram = no.
      214       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      215       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      216       if  (   mWaitFramView
      217          or  mWaitProcEvent)
      218          and not mBatchMode
      219       then
      220          display
      221             v-waitfram-action01 skip
      222             v-waitfram-action02 skip
      223             v-waitfram-action03 skip
      224          with frame waitfram .
      225       if     mWaitFramView
      226          then do:
      227             if     mWaitFramInterval ne ?
      228                and not mBatchMode
      229             then
      230                wait-for go of frame waitfram pause mWaitFramInterval.
      231          end.
      232          else
      233             if     mWaitProcEvent
      234                and not mBatchMode
      235             then
      236                process events .
      237     end.
      238   end procedure.
      239      procedure waitfram-show-this:
      240         define input  parameter iInterval as int64 no-undo.
      241         define variable vtime as int64 no-undo.
      242         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      243         mWaitFramInterval = iInterval.
      244         run waitfram-show (substitute("&1&2 &3&4" ,
      245                                       mWaitFramTextBeg ,
      246                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      247                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      248                                       mWaitFramTextEnd
      249                                      )
      250                           ).
      251      end.
      252      procedure WaitFramRunPause:
      253         define input  parameter iInterval as dec no-undo.
      254         define variable vStart  as datetime-tz no-undo.
      255         define variable vend    as datetime-tz no-undo.
      256         define variable vint as int64 no-undo.
      257         define variable vOk as logical no-undo.
      258         vStart = now.
      259         vend   = vStart.
      260         publish "WaitFramPause" (iInterval,output vOk).
      261         vend   =  now.
      262         vint = vend - vStart.
      263         vint = iInterval - vint / 1000.
      264         if     not mWaitFramStop
      265            and (   vint > 0
      266                 or (    not vOk
      267                     and iInterval eq ?
      268                     )
      269                 )
      270         then
      271            run waitfram-show-this (iInterval).
      272         vend   =  now.
      273         vint = vend - vStart.
      274         vint = iInterval - vint / 1000.
      275         if     not mWaitFramStop
      276            and vint > 0
      277         then do:
      278            run gbl/pause.p (vint * 1000).
      279         end.
      280         if iInterval ne ?
      281         then
      282            publish "WaitFramStop".
      283         waitfram-check-timeout().
      284      end.
      285      procedure WaitFramWaitFor:
      286         define input  parameter iInterval as dec no-undo.
      287         assign
      288            mWaitFramStartProc   = now
      289            mWaitFramStopUser    = no
      290            mWaitFramStopTimeOut = no
      291         .
      292         block-wait:
      293         do while not mWaitFramStop:
      294            run WaitFramRunPause (iInterval).
      295            if  waitfram-check-timeout()
      296            then do:
      297               leave block-wait.
      298            end.
      299         end.
      300         run waitfram-hide.
      301      end.
      302   procedure waitfram-join :
      303     define input  parameter p-line-1  as character no-undo .
      304     define input  parameter p-line-2  as character no-undo .
      305     define input  parameter p-line-3  as character no-undo .
      306     define output parameter p-message as character no-undo .
      307     do
      308     on error undo, return error return-value
      309     :
      310       assign
      311         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      312                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      313                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      314       .
      315     end.
      316   end procedure.
      317   function waitfram-join-function returns character
      318     (input p-line-1 as character
      319     ,input p-line-2 as character
      320     ,input p-line-3 as character
      321     ).
      322     define variable v-message as character no-undo .
      323     run waitfram-join in this-procedure
      324       (input  p-line-1
      325       ,input  p-line-2
      326       ,input  p-line-3
      327       ,output v-message
      328       ) .
      329     return v-message .
      330   end function .
      331   define new global shared variable g#language as character no-undo .
      332   if g#language <> '' and g#language <> 'rus':U then do:
      333     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      334   end.
      335   define new global shared variable g#library  as handle no-undo .
      336   define new global shared variable g#library2 as handle no-undo .
      337   procedure proc-alt-shift-f2:
      338     if not ibs.th.gbl.gbl-var:rcode
      339   then
      340     run gbl\inidebug.p .
      341   end.
      342   procedure proc-alt-shift-f3:
      343     run gbl/prvssinf.p
      344       ( input this-procedure
      345       ) .
      346   end.
      347   define variable v-inform-launched as logical no-undo initial false .
      348   procedure proc-alt-shift-f4:
      349     define variable v-action as character no-undo .
      350     if v-inform-launched = false then do:
      351       assign
      352         v-inform-launched = true
      353       .
      354       run gbl/d-inform.w
      355         (  input self
      356         ,  input this-procedure
      357         , output v-action
      358         ) no-error .
      359       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      360       assign
      361         v-inform-launched = false
      362       .
      363     end.
      364   end.
      365   procedure proc-alt-f1:
      366     run gbl/corrhelp.p
      367       (input this-procedure
      368       ) .
      369   end .
      370   on alt-shift-f2 anywhere do:
      371     run proc-alt-shift-f2.
      372   end.
      373   on alt-shift-f3 anywhere do:
      374     run proc-alt-shift-f3 in this-procedure .
      375   end.
      376   on alt-shift-f4 anywhere do:
      377     run proc-alt-shift-f4 in this-procedure.
      378   end.
      379   on alt-f1 anywhere do:
      380     run proc-alt-f1 in this-procedure .
      381   end.
      382   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   PROCEDURE fill-tt0-hist-nws-option :
      384   define input parameter p-emitent-host-code as integer no-undo .
      385   define input parameter p-type as character no-undo .
      386   define buffer  buf_tt0-hist-nws-option for tt0-hist-nws-option.
      387   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
      388   DEFINE VARIABLE v-table-name AS CHARACTER NO-UNDO.
      389   DEFINE VARIABLE v-label0 AS CHARACTER NO-UNDO.
      390   define variable v-region as character no-undo .
      391   DEFINE VARIABLE v-label AS CHARACTER NO-UNDO.
      392   DEFINE VARIABLE v-done AS CHARACTER NO-UNDO.
      393   define variable v-hn-id as integer no-undo .
      394   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
      395   FOR EACH buf_prop-head NO-LOCK WHERE
      396       buf_prop-head.general CONTAINS  'dis-card-type':U
      397       and
      398       buf_prop-head.general-view CONTAINS  'dis-card-type':U
      399   ON ERROR UNDO, RETURN ERROR :
      400       v-label0 = buf_prop-head.prop-label.
      401       v-done = '':U.
      402       v-table-name = '':U.
      403      _v-ii:
      404      DO v-ii = 1 TO 3:
      405        IF v-ii = 1 THEN do:
      406           v-table-name = buf_prop-head.storage-place.
      407           v-label = substitute("&1_", v-label0).
      408           v-region = "".
      409        END.
      410        IF v-ii = 2 THEN do:
      411           v-table-name = buf_prop-head.storage-place-host.
      412           v-label = substitute("&1_Фирма", v-label0).
      413           v-region = "Фирма".
      414        END.
      415        IF v-ii = 3 THEN do:
      416           v-table-name = buf_prop-head.storage-place-obj.
      417           v-label = substitute("&1_Объект", v-label0).
      418           v-region = "Объект".
      419        END.
      420        IF v-table-name = '':U
      421        OR v-table-name = ?
      422        OR v-table-name = chr(63) THEN NEXT _v-ii.
      423        IF v-table-name > '':U and LOOKUP(v-table-name, v-done) = 0
      424        THEN do:
      425          FIND FIRST buf_tt0-hist-nws-option WHERE
      426                   buf_tt0-hist-nws-option.db-num = 0
      427               AND buf_tt0-hist-nws-option.table-name = v-table-name
      428               and buf_tt0-hist-nws-option.host-code = p-emitent-host-code
      429               and buf_tt0-hist-nws-option.obj-type = '':U
      430               and buf_tt0-hist-nws-option.obj-code = 0
      431               and buf_tt0-hist-nws-option.key#_one = buf_prop-head.dtm-code
      432               and buf_tt0-hist-nws-option.charkey_one = p-type no-error.
      433          if not available buf_tt0-hist-nws-option then do:
      434            create buf_tt0-hist-nws-option.
      435            assign
      436            buf_tt0-hist-nws-option.db-num = 0
      437            buf_tt0-hist-nws-option.table-name = v-table-name
      438            buf_tt0-hist-nws-option.host-code = p-emitent-host-code
      439            buf_tt0-hist-nws-option.obj-type = '':U
      440            buf_tt0-hist-nws-option.obj-code = 0
      441            buf_tt0-hist-nws-option.key#_one = buf_prop-head.dtm-code
      442            buf_tt0-hist-nws-option.charkey_one = p-type
      443            buf_tt0-hist-nws-option.get-hist-from-nws = buf_prop-head.get-hist-from-nws
      444            buf_tt0-hist-nws-option.hist-to-nws = buf_prop-head.hist-to-nws
      445            buf_tt0-hist-nws-option.nws-to-hist = buf_prop-head.nws-to-hist
      446            buf_tt0-hist-nws-option.hist-from-prim = buf_prop-head.hist-from-prim
      447            buf_tt0-hist-nws-option.nws-to-cd = buf_prop-head.nws-to-cd
      448            buf_tt0-hist-nws-option.smart-nws = buf_prop-head.smart-nws
      449            buf_tt0-hist-nws-option.get-hist-from-nws = buf_prop-head.get-hist-from-nws
      450            buf_tt0-hist-nws-option.subject-group = 'c-dc-hist':U
      451            buf_tt0-hist-nws-option.option-desc = v-label
      452            buf_tt0-hist-nws-option.hn-id = v-hn-id
      453            v-hn-id = v-hn-id + 1
      454            .
      455         END.
      456         else do:
      457           if entry(num-entries(buf_tt0-hist-nws-option.option-desc, "_")
      458                     , buf_tt0-hist-nws-option.option-desc
      459                     , "_") <> v-region
      460             or v-ii = 1 then do:
      461             v-label = substitute("&1/&2"
      462                                   , buf_tt0-hist-nws-option.option-desc
      463                                   , (if v-ii = 1
      464                                       then "_Глобально"
      465                                       else (if v-ii = 2
      466                                           then "_Фирма"
      467                                           else "_Объект"
      468                                           )
      469                                     )
      470                                   ).
      471             assign
      472             buf_tt0-hist-nws-option.option-desc = v-label
      473             .
      474           end.
      475         end.
      476           ASSIGN
      477           buf_tt0-hist-nws-option.hist-to-nws-is-on = (buf_tt0-hist-nws-option.hist-to-nws >= 0)
      478           buf_tt0-hist-nws-option.nws-to-hist-is-on = (buf_tt0-hist-nws-option.nws-to-hist >= 0)
      479           buf_tt0-hist-nws-option.hist-from-prim-is-on = (buf_tt0-hist-nws-option.hist-from-prim >= 0)
      480           buf_tt0-hist-nws-option.nws-to-cd-is-on = (buf_tt0-hist-nws-option.nws-to-cd >= 0)
      481           buf_tt0-hist-nws-option.smart-nws-is-on = entry (lookup (string(buf_tt0-hist-nws-option.smart-nws), '0,-1,1,10,-10':U) + 1, ',' + 'Да,Нет,Смарт2,Всегда,Никогда':U)
      482           buf_tt0-hist-nws-option.get-hist-from-nws-is-on = (buf_tt0-hist-nws-option.get-hist-from-nws >= 0)
      483           buf_tt0-hist-nws-option.hist-to-nws-can = NOT ((buf_tt0-hist-nws-option.hist-to-nws = INTEGER('10':U)) OR
      484                                                     (buf_tt0-hist-nws-option.hist-to-nws = INTEGER('-10':U)))
      485           buf_tt0-hist-nws-option.nws-to-hist-can = NOT ((buf_tt0-hist-nws-option.nws-to-hist = INTEGER('10':U)) OR
      486                                                     (buf_tt0-hist-nws-option.nws-to-hist = INTEGER('-10':U)))
      487           buf_tt0-hist-nws-option.hist-from-prim-can = NOT ((buf_tt0-hist-nws-option.hist-from-prim = INTEGER('10':U)) OR
      488                                                                   (buf_tt0-hist-nws-option.hist-from-prim = INTEGER('-10':U)))
      489           buf_tt0-hist-nws-option.nws-to-cd-can = NOT ((buf_tt0-hist-nws-option.nws-to-cd = INTEGER('10':U)) OR
      490                                                         (buf_tt0-hist-nws-option.nws-to-cd = INTEGER('-10':U)))
      491           buf_tt0-hist-nws-option.smart-nws-can = NOT ((buf_tt0-hist-nws-option.smart-nws = INTEGER('10':U)) OR
      492                                                             (buf_tt0-hist-nws-option.smart-nws = INTEGER('-10':U)))
      493           buf_tt0-hist-nws-option.get-hist-from-nws-can = NOT ((buf_tt0-hist-nws-option.get-hist-from-nws = INTEGER('10':U)) OR
      494                                                           (buf_tt0-hist-nws-option.get-hist-from-nws = INTEGER('-10':U)))
      495           .
      496                   if buf_tt0-hist-nws-option.smart-nws = integer('-10':U) then do:
      497             buf_tt0-hist-nws-option.smart-nws-is-on = entry (lookup ('-1':U, '0,-1,1,10,-10':U) + 1, ',' + 'Да,Нет,Смарт2,Всегда,Никогда':U).
      498           end.
      499                   if buf_tt0-hist-nws-option.smart-nws = integer('10':U) then do:
      500             buf_tt0-hist-nws-option.smart-nws-is-on = entry (lookup ('0':U, '0,-1,1,10,-10':U) + 1, ',' + 'Да,Нет,Смарт2,Всегда,Никогда':U).
      501           end.
      502       end.
      503       IF v-table-name > '':U and LOOKUP(v-table-name, v-done) > 0
      504       THEN do:
      505          FIND FIRST buf_tt0-hist-nws-option WHERE
      506                   buf_tt0-hist-nws-option.db-num = 0
      507               AND buf_tt0-hist-nws-option.table-name = v-table-name
      508               and buf_tt0-hist-nws-option.host-code = p-emitent-host-code
      509               and buf_tt0-hist-nws-option.obj-type = '':U
      510               and buf_tt0-hist-nws-option.obj-code = 0
      511               and buf_tt0-hist-nws-option.key#_one = buf_prop-head.dtm-code
      512               and buf_tt0-hist-nws-option.charkey_one = p-type no-error.
      513          if available buf_tt0-hist-nws-option then do:
      514           if entry(num-entries(buf_tt0-hist-nws-option.option-desc, "_")
      515                   , buf_tt0-hist-nws-option.option-desc
      516                   , "_") <> v-region
      517           or v-ii = 1 then do:
      518             v-label = substitute("&1/&2"
      519                                   , buf_tt0-hist-nws-option.option-desc
      520                                   , (if v-ii = 1
      521                                       then "_Глобально"
      522                                       else (if v-ii = 2
      523                                           then "_Фирма"
      524                                           else "_Объект"
      525                                           )
      526                                     )
      527                                   ).
      528             assign
      529             buf_tt0-hist-nws-option.option-desc = v-label
      530             .
      531           end.
      532         end.
      533       end.
      534       v-done = v-done + chr(44) + v-table-name.
      535     END.
      536   END.
      537   END PROCEDURE.
      538   FUNCTION get-hn-label RETURNS CHARACTER
      539     ( INPUT p-hn-option AS integer )  FORWARD.
      540   FUNCTION get-hn-value RETURNS integer
      541     ( INPUT p-hn-label AS character )  FORWARD.
      542   FUNCTION get-prop-head-label RETURNS CHARACTER
      543     ( INPUT p-dtm-code AS INTEGER )  FORWARD.
      544   DEFINE BUTTON B-exit AUTO-GO
      545        LABEL "&Ввод"
      546        SIZE 10 BY 1
      547        BGCOLOR 8 .
      548   DEFINE BUTTON B-Help
      549        LABEL "Помо&щь"
      550        SIZE 3 BY 1
      551        BGCOLOR 8 .
      552   DEFINE BUTTON b-quit AUTO-END-KEY
      553        LABEL "&Отмена"
      554        SIZE 10 BY 1
      555        BGCOLOR 8 .
      556   DEFINE QUERY BR-hn FOR
      557         tt0-hist-nws-option SCROLLING.
      558   DEFINE BROWSE BR-hn
      559     QUERY BR-hn NO-LOCK DISPLAY
      560         tt0-hist-nws-option.option-descr FORMAT "X(255)":U WIDTH 35
      561   get-hn-label(tt0-hist-nws-option.hist-from-prim) FORMAT "X(15)" COLUMN-LABEL "Создание ист.!при изменении"
      562   tt0-hist-nws-option.hist-from-prim-is-on COLUMN-LABEL "Вкл/!выкл" VIEW-AS TOGGLE-BOX
      563   get-hn-label(tt0-hist-nws-option.hist-to-nws) FORMAT "X(15)" COLUMN-LABEL "Пересылка ист.!в другие БД"
      564   tt0-hist-nws-option.hist-to-nws-is-on COLUMN-LABEL "Вкл/!выкл" VIEW-AS TOGGLE-BOX
      565   get-hn-label(tt0-hist-nws-option.nws-to-hist) FORMAT "X(15)" COLUMN-LABEL "Создание ист.!при приеме!по СПН"
      566   tt0-hist-nws-option.nws-to-hist-is-on COLUMN-LABEL "Вкл/!выкл" VIEW-AS TOGGLE-BOX
      567   get-hn-label(tt0-hist-nws-option.get-hist-from-nws) FORMAT "X(15)" COLUMN-LABEL "Прием истории!из другой!УБД"
      568   tt0-hist-nws-option.get-hist-from-nws-is-on COLUMN-LABEL "Вкл/!выкл" VIEW-AS TOGGLE-BOX
      569   get-hn-label(tt0-hist-nws-option.smart-nws) FORMAT "X(15)" COLUMN-LABEL "Смарт-!передача!по СПН"
      570   tt0-hist-nws-option.smart-nws-is-on COLUMN-LABEL "Вкл/!выкл" VIEW-AS COMBO-BOX
      571   get-hn-label(tt0-hist-nws-option.nws-to-cd) FORMAT "X(15)" COLUMN-LABEL "Активация пер-чи!на кассы!из СПН"
      572   tt0-hist-nws-option.nws-to-cd-is-on COLUMN-LABEL "Вкл/!выкл" VIEW-AS TOGGLE-BOX
      573   ENABLE
      574   tt0-hist-nws-option.hist-from-prim-is-on
      575   tt0-hist-nws-option.hist-to-nws-is-on
      576   tt0-hist-nws-option.nws-to-hist-is-on
      577   tt0-hist-nws-option.get-hist-from-nws-is-on
      578   tt0-hist-nws-option.smart-nws-is-on
      579   tt0-hist-nws-option.nws-to-cd-is-on
      580       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 21 FIT-LAST-COLUMN.
      581   DEFINE FRAME Dialog-Frame
      582        B-exit AT ROW 1 COL 1
      583        b-quit AT ROW 1 COL 11
      584        B-Help AT ROW 1 COL 95
      585        BR-hn AT ROW 2 COL 1 WIDGET-ID 100
      586        SPACE(0.74) SKIP(0.37)
      587       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      588            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      589            TITLE "Опции пересылки на кассу, создания истории и маршрутизации"
      590            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      591   ASSIGN
      592          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      593          FRAME Dialog-Frame:HIDDEN           = TRUE.
      594   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      595   DO:
      596     APPLY "END-ERROR":U TO SELF.
      597   END.
      598   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      599   DO:
      600   DEFINE buffer buf_tt0-hist-nws-option FOR tt0-hist-nws-option.
      601   IF p-mode = 'ПРОСМОТР':U THEN RETURN NO-APPLY.
      602   RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      603   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      604   END.
      605   ON "leave" OF tt0-hist-nws-option.hist-to-nws-is-on  IN BROWSE br-hn
      606   DO:
      607      IF tt0-hist-nws-option.hist-to-nws-can = NO
      608      or p-mode = 'ПРОСМОТР':U
      609      THEN DO:
      610       BELL.
      611       assign
      612       tt0-hist-nws-option.hist-to-nws-is-on = (IF tt0-hist-nws-option.hist-to-Nws = integer('10':U)
      613                                               THEN YES
      614                                               ELSE NO).
      615       display
      616       tt0-hist-nws-option.hist-to-nws-is-on
      617       with browse br-hn.
      618     END.
      619   END.
      620   ON "leave" OF tt0-hist-nws-option.nws-to-hist-is-on  IN BROWSE br-hn
      621   DO:
      622      IF tt0-hist-nws-option.nws-to-hist-can = NO
      623      or p-mode = 'ПРОСМОТР':U
      624      THEN DO:
      625       BELL.
      626       assign
      627       tt0-hist-nws-option.nws-to-hist-is-on = (IF tt0-hist-nws-option.nws-to-hist = integer('10':U)
      628                                               THEN YES
      629                                               ELSE NO).
      630       display
      631       tt0-hist-nws-option.nws-to-hist-is-on
      632       with browse br-hn.
      633     END.
      634   END.
      635   ON "leave" OF tt0-hist-nws-option.get-hist-from-nws-is-on  IN BROWSE br-hn
      636   DO:
      637      IF tt0-hist-nws-option.get-hist-from-nws-can = NO
