      639      THEN DO:
      640       BELL.
      641       assign
      642       tt0-hist-nws-option.get-hist-from-nws-is-on = (IF tt0-hist-nws-option.get-hist-from-nws = integer('10':U)
      643                                               THEN YES
      644                                               ELSE NO).
      645       DISPLAY
      646       tt0-hist-nws-option.get-hist-from-nws-is-on
      647       with browse br-hn.
      648     END.
      649   END.
      650   ON "leave" OF tt0-hist-nws-option.hist-from-prim-is-on  IN BROWSE br-hn
      651   DO:
      652      IF tt0-hist-nws-option.hist-from-prim-can = NO
      653      or p-mode = 'ПРОСМОТР':U
      654      THEN DO:
      655       BELL.
      656       assign
      657       tt0-hist-nws-option.hist-from-prim-is-on = (IF tt0-hist-nws-option.hist-from-prim = integer('10':U)
      658                                               THEN YES
      659                                               ELSE NO).
      660       display
      661       tt0-hist-nws-option.hist-from-prim-is-on
      662       with browse br-hn.
      663     END.
      664   END.
      665   ON "leave" OF tt0-hist-nws-option.nws-to-cd-is-on  IN BROWSE br-hn
      666   DO:
      667      IF tt0-hist-nws-option.nws-to-cd-can = NO
      668      or p-mode = 'ПРОСМОТР':U
      669      THEN DO:
      670       BELL.
      671       assign
      672       tt0-hist-nws-option.nws-to-cd-is-on = (IF tt0-hist-nws-option.nws-to-cd = integer('10':U)
      673                                               THEN YES
      674                                               ELSE NO).
      675       display
      676       tt0-hist-nws-option.nws-to-cd-is-on
      677       with browse br-hn.
      678     END.
      679   END.
      680   ON "value-changed" OF tt0-hist-nws-option.smart-nws-is-on  IN BROWSE br-hn
      681   OR "leave" OF tt0-hist-nws-option.smart-nws-is-on  IN BROWSE br-hn
      682   DO:
      683      IF tt0-hist-nws-option.smart-nws-can = NO
      684      or p-mode = 'ПРОСМОТР':U
      685      THEN DO:
      686       BELL.
      687       assign
      688       tt0-hist-nws-option.smart-nws-is-on = entry (lookup (string(tt0-hist-nws-option.smart-nws), '0,-1,1,10,-10':U) + 1, ',' + 'Да,Нет,Смарт2,Всегда,Никогда':U)
      689       .
      690       message
      691       tt0-hist-nws-option.smart-nws-is-on
      692           tt0-hist-nws-option.smart-nws-can
      693       view-as alert-box .
      694       display
      695       tt0-hist-nws-option.smart-nws-is-on
      696       with browse br-hn.
      697     END.
      698   END.
      699   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      700   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      701   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      702   on help of frame Dialog-Frame
      703   do:
      704     run gbl/app_help.p
      705       (input this-procedure :file-name
      706       ,input ''
      707       ,input ?
      708       ) no-error.
      709     if error-status :error then do:
      710       message
      711         "Ошибка при вызове помощи"
      712         error-status :get-message(1)
      713         view-as alert-box .
      714     end.
      715   end.
      716   run minbtn-set in this-procedure .
      717   on choose of b-help in frame Dialog-Frame
      718   do:
      719     apply "help":u to frame Dialog-Frame .
      720   end.
      721   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      722   procedure minbtn-set :
      723       do
      724           on error undo, return error return-value
      725           :
      726           define variable ii              as integer       no-undo .
      727           define variable fh              as widget-handle no-undo .
      728           define variable hh              as widget-handle no-undo .
      729           define variable v-h             as handle        extent 4 no-undo .
      730           define variable v-name-button   as character     no-undo .
      731           define variable v-help-old-x    as decimal       no-undo .
      732           define variable v-help-old-y    as decimal       no-undo .
      733           define variable v-help-old-size as decimal       no-undo .
      734           define variable v-frame-width   as decimal       no-undo .
      735           define variable jj              as integer       no-undo .
      736           do
      737               on error undo, return error
      738               :
      739               assign
      740                   v-frame-width = frame Dialog-Frame:width - 0.3
      741                   fh            = frame Dialog-Frame:first-child
      742                   hh            = fh:first-child
      743                   ii            = 1
      744                   .
      745               do while valid-handle(hh):
      746                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      747                   do:
      748                       case lc(hh:name) :
      749                           when "b-help" then
      750                               do:
      751                                   hh:load-image-up("cmp/b-help.bmp":u) .
      752                                   hh:load-image-down("cmp/b-help.bmp":u) .
      753                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      754                                   hh:TOOLTIP = "Помощь" .
      755                                   v-help-old-x = hh:column .
      756                                   v-help-old-y = hh:row    .
      757                                   v-help-old-size = hh:width .
      758                                   hh:width-chars = 2.5 .
      759                               end.
      760                           when "b-print" then
      761                               do:
      762                                   hh:load-image("cmp/b-print.bmp":u) .
      763                                   hh:TOOLTIP = "Печать" .
      764                                   v-h[ii] = hh:handle .
      765                                   ii = ii + 1 .
      766                                   hh:width-chars = 3 .
      767                               end.
      768                           when "b-history" or
      769                           when "b-hist" then
      770                               do:
      771                                   hh:load-image("cmp/b-hist.bmp":u) .
      772                                   hh:TOOLTIP = "История" .
      773                                   v-h[ii] = hh:handle .
      774                                   ii = ii + 1 .
      775                                   hh:width-chars = 3 .
      776                               end.
      777                           when "b-sch" then
      778                               do:
      779                                   hh:load-image("cmp/b-sch.bmp":u) .
      780                                   hh:TOOLTIP = "Установка Фильтра" .
      781                                   v-h[ii] = hh:handle .
      782                                   ii = ii + 1 .
      783                                   hh:width-chars = 3 .
      784                               end.
      785                           when "b-hist-user" then
      786                               do:
      787                                   hh:load-image("cmp/b-hist.bmp":u) .
      788                                   hh:TOOLTIP = "История пользователя" .
      789                                   ii = ii + 1 .
      790                               end.
      791                       end case.
      792                   end.
      793                   hh = hh:next-sibling.
      794               end.
      795               b-help:column = v-frame-width - b-help:width-chars.
      796               jj = 0.
      797               repeat ii = 4 to 1 by -1 :
      798                   if valid-handle (v-h[ii] ) then
      799                   do:
      800                       jj  = jj + 1 .
      801                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      802                       v-h[ii]:row    = v-help-old-y .
      803                   end.
      804               end.
      805           end.
      806       end.
      807   end procedure.
      808   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      809   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      810   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      811   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      812   define variable v-diasize-current-frame-width  as decimal   no-undo .
      813   define variable v-diasize-current-frame-height as decimal   no-undo .
      814   define variable v-diasize-change-size          as logical   no-undo .
      815   define variable v-diasize-resize-button        as handle    no-undo .
      816   define variable v-diasize-wndmax               as logical   no-undo .
      817   define variable v-diasize-wndstore             as logical   no-undo .
      818   define variable v-diasize-proc-name            as character no-undo .
      819   define variable v-diasize-browse-handle        as handle    no-undo .
      820   define variable v-diasize-browse-number        as integer   no-undo .
      821   define variable v-diasize-need-full-display    as logical   no-undo init false .
      822   define temp-table temp-diasize-handle no-undo
      823     field handle-value  as handle
      824     field save-position as decimal
      825     index xpk is primary unique handle-value
      826     .
      827   define temp-table temp-browse-handle no-undo
      828     field browse-type   as character
      829     field browse-number as integer
      830     field browse-handle as handle
      831     field original-size as decimal
      832     index xpk is primary unique browse-type browse-number
      833     index xie browse-type browse-handle
      834   .
      835   procedure diasize_change-height :
      836     define input  parameter p-change-value  as decimal   no-undo .
      837     define input  parameter p-move-resize   as logical   no-undo .
      838     define variable v-field-group-handle    as handle    no-undo .
      839     define variable v-object-handle         as handle    no-undo .
      840     define variable v-frame-height          as decimal   no-undo .
      841     define variable v-frame-virtual-height  as decimal   no-undo .
      842     define variable v-browse-height         as decimal   no-undo .
      843     define variable v-window-height         as decimal   no-undo .
      844     define variable v-window-virtual-height as decimal   no-undo .
      845     define variable v-change-sign           as integer   no-undo .
      846     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      847     define buffer buf_temp-browse-handle  for temp-browse-handle .
      848     if p-change-value > 0
      849     then do:
      850       if frame Dialog-Frame :height + p-change-value
      851           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      852       then do:
      853         assign
      854           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      855                           - (frame Dialog-Frame :height-chars)
      856         .
      857         if p-change-value <= 0
      858         then do:
      859           run diasize_position-resize-button in this-procedure .
      860           return .
      861         end.
      862       end.
      863     end.
      864     if p-change-value < 0
      865     then do:
      866       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      867       then do:
      868         assign
      869           p-change-value = v-diasize-orig-frame-height
      870                          - (frame Dialog-Frame :height-chars)
      871         .
      872         if p-change-value >= 0
      873         then do:
      874           run diasize_position-resize-button in this-procedure .
      875           return .
      876         end.
      877       end.
      878     end.
      879     if p-change-value >= 0
      880     then do:
      881       assign
      882         v-change-sign = 1
      883       .
      884     end.
      885     else do:
      886       assign
      887         v-change-sign = -1
      888       .
      889     end.
      890     assign
      891       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      892     .
      893     if p-change-value = 0
      894     then do:
      895       run diasize_position-resize-button in this-procedure .
      896       return .
      897     end.
      898     move_block:
      899     do
      900     on error undo move_block, retry move_block
      901     :
      902       if retry
      903       then do:
      904         do
      905         on error undo move_block, leave move_block
      906         :
      907           if p-change-value > 0
      908           then do:
      909             for each buf_temp-diasize-handle
      910             on error undo, next
      911             :
      912               assign
      913                 v-object-handle = buf_temp-diasize-handle.handle-value
      914               .
      915               if v-object-handle <> v-diasize-resize-button
      916               then do:
      917                 assign
      918                   v-object-handle :row = buf_temp-diasize-handle.save-position
      919                 .
      920               end.
      921             end.
      922             assign
      923               v-diasize-browse-handle :height = v-browse-height
      924             .
      925             for each buf_temp-browse-handle
      926               where buf_temp-browse-handle.browse-type = 'height':u
      927             on error undo, next
      928             :
      929               assign
      930                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      931               .
      932             end.
      933             assign
      934               frame Dialog-Frame :height = v-frame-height
      935             .
      936             if frame Dialog-Frame :scrollable = true
      937             then do:
      938               assign
      939                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      940               .
      941             end.
      942             run diasize_position-resize-button in this-procedure .
      943           end.
      944           else do:
      945             if frame Dialog-Frame :scrollable = true
      946             then do:
      947               assign
      948                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      949               .
      950             end.
      951             assign
      952               frame Dialog-Frame :height = v-frame-height
      953             .
      954             assign
      955               v-diasize-browse-handle :height = v-browse-height
      956             .
      957             for each buf_temp-browse-handle
      958               where buf_temp-browse-handle.browse-type = 'height':u
      959             on error undo, next
      960             :
      961               assign
      962                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      963               .
      964             end.
