     1210   procedure diasize_set-height :
     1211     define input  parameter p-new-height  as decimal   no-undo .
     1212     define input  parameter p-move-resize as logical   no-undo .
     1213     do
     1214     on error undo, return error return-value
     1215     :
     1216       run diasize_change-height in this-procedure
     1217         (input  (p-new-height - frame Dialog-Frame :height)
     1218         ,input  p-move-resize
     1219         ) .
     1220     end.
     1221   end procedure.
     1222   procedure diasize_change-width :
     1223     define input  parameter p-change-value as decimal   no-undo .
     1224     define input  parameter p-move-resize  as logical   no-undo .
