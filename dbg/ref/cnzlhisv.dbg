        1   block-level on error undo, throw.
        2   define input parameter p-obj-type like ub.c-nzl-hist.obj-type no-undo .
        3   define input parameter p-obj-code like ub.c-nzl-hist.obj-code no-undo .
        4   define input parameter p-nozzle-code like ub.c-nzl-hist.nozzle-code no-undo .
        5   define input parameter p-chip-num like ub.c-nzl-hist.chip-num no-undo .
        6   define input parameter p-corr-user-db-num like ub.c-nzl-hist.corr-user-db-num no-undo .
        7   define input parameter p-subject like ub.c-nzl-hist.subject no-undo .
        8   define input parameter p-action   like ub.c-nzl-hist.action no-undo .
        9   define input parameter p-silent  as logical no-undo .
       10   define output parameter p-description as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: cnzlhisv.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: ref/cnzlhisv.p $":U .
       16   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории пистолета".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure nzzlattr-name :
       77   do
       78     on error undo, return error
       79     :
       80     define input  parameter p-code           as character no-undo .
       81     define output parameter p-type           as character no-undo .
       82     define output parameter p-format         as character no-undo .
       83     define output parameter p-label          as character no-undo .
       84     define output parameter p-user-can-edit  as logical   no-undo .
       85     define output parameter p-output-display as logical   no-undo .
       86     define output parameter p-other          as character no-undo .
       87       case p-code :
       88               when 'pulse-qnty':U then do:     assign     p-label = "Количество импульсов расходомера на 10 л"     p-type = 'I':U      p-format = ">>>>"     p-label = "Количество импульсов расходомера на 10 л"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       89               when 'max-no-overr-cnt-val':U then do:     assign     p-label = "Max знач. необнуляемого счетчика"     p-type = 'D':U      p-format = ">>>,>>>,>>>,>>9.9999"     p-label = "Max знач. необнуляемого счетчика"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       90         otherwise do:
       91           undo, return error "неизвестный атрибут пистолета" + " " + p-code .
       92         end.
       93       end.
       94     end.
       95   end procedure.
       96   procedure nzzlattr-tooltip :
       97   do
       98     on error undo, return error
       99     :
      100       define input  parameter p-code    as character no-undo .
      101       define output parameter p-tooltip as character no-undo .
      102       define output parameter p-label   as character no-undo .
      103       case p-code :
      104               when 'pulse-qnty':U then do:     assign     p-tooltip = "Количество импульсов расходомера на 10 л"     p-label = "Количество импульсов расходомера на 10 л" .   end.
      105               when 'max-no-overr-cnt-val':U then do:     assign     p-tooltip = "Max знач. необнуляемого счетчика"     p-label = "Max знач. необнуляемого счетчика" .   end.
      106         otherwise do:
      107           undo, return error "Неизвестный атрибут пистолета" + " " + p-code .
      108         end.
      109       end.
      110     end.
      111   end procedure.
      112   procedure nzzlattr-value :
      113    do
      114     on error undo, return error
      115     :
      116       define input  parameter p-code     like ub.nozzle-attr.attr-code  no-undo .
      117       define input  parameter p-obj-type like ub.nozzle-attr.obj-type   no-undo .
      118       define input  parameter p-obj-code like ub.nozzle-attr.obj-code   no-undo .
      119       define input  parameter p-nozzle-code like ub.nozzle-attr.nozzle-code   no-undo .
      120       define output parameter p-value    like ub.nozzle-attr.attr-value no-undo .
      121       define output parameter p-type     as character no-undo .
      122       define buffer buf_nozzle-attr for ub.nozzle-attr .
      123       def var v-format         as character no-undo .
      124       def var v-label          as character no-undo .
      125       def var v-user-can-edit  as logical   no-undo .
      126       def var v-output-display as logical   no-undo .
      127       def var v-other          as character no-undo .
      128       run nzzlattr-name in this-procedure
      129         (input  p-code
      130         ,output p-type
      131         ,output v-format
      132         ,output v-label
      133         ,output v-user-can-edit
      134         ,output v-output-display
      135         ,output v-other
      136         ) no-error .
      137       if error-status :error then do:
      138         undo, return error return-value .
      139       end.
      140       find first buf_nozzle-attr no-lock where
      141                  buf_nozzle-attr.obj-type  = p-obj-type
      142              AND buf_nozzle-attr.obj-code  = p-obj-code
      143              AND buf_nozzle-attr.nozzle-code  = p-nozzle-code
      144              AND buf_nozzle-attr.attr-code = p-code
      145         no-error .
      146       if avail buf_nozzle-attr then do:
      147         assign
      148           p-value =  buf_nozzle-attr.attr-value
      149         .
      150       end.
      151       else do:
      152         assign
      153           p-value = if p-type = 'L':U then "no":U else ""
      154         .
      155       end.
      156     end.
      157   end procedure.
      158   procedure nzzlattr-write :
      159     do
      160     on error undo, return error
      161     :
      162       define input parameter p-obj-type like ub.nozzle-attr.obj-type   no-undo .
      163       define input parameter p-obj-code like ub.nozzle-attr.obj-code   no-undo .
      164       define input parameter p-nozzle-code like ub.nozzle-attr.nozzle-code   no-undo .
      165       define input parameter p-code     like ub.nozzle-attr.attr-code  no-undo .
      166       define input parameter p-value    like ub.nozzle-attr.attr-value no-undo .
      167       define buffer buf_nozzle-attr for ub.nozzle-attr .
      168       define buffer lock_nzzl-attr for ub.nozzle-attr .
      169       def var v-type           as character no-undo .
      170       def var v-format         as character no-undo .
      171       def var v-label          as character no-undo .
      172       def var v-user-can-edit  as logical   no-undo .
      173       def var v-output-display as logical   no-undo .
      174       def var v-other          as character no-undo .
      175       run nzzlattr-name in this-procedure
      176         (input  p-code
      177         ,output v-type
      178         ,output v-format
      179         ,output v-label
      180         ,output v-user-can-edit
      181         ,output v-output-display
      182         ,output v-other
      183         ) no-error .
      184       if error-status :error then do:
      185         undo, return error return-value .
      186       end.
      187       find first buf_nozzle-attr exclusive-lock where
      188                  buf_nozzle-attr.obj-type  = p-obj-type
      189              AND buf_nozzle-attr.obj-code  = p-obj-code
      190              AND buf_nozzle-attr.nozzle-code  = p-nozzle-code
      191              AND buf_nozzle-attr.attr-code = p-code no-error .
      192       if not available buf_nozzle-attr then do:
      193         create buf_nozzle-attr .
      194         assign
      195           buf_nozzle-attr.nozzle-code  = p-nozzle-code
      196           buf_nozzle-attr.obj-type  = p-obj-type
      197           buf_nozzle-attr.obj-code  = p-obj-code
      198           buf_nozzle-attr.attr-code = p-code
      199           buf_nozzle-attr.attr-value = p-value no-error
      200         .
      201       end.
      202       ELSE
      203       ASSIGN
      204       buf_nozzle-attr.attr-value = p-value no-error.
      205     end.
      206   end procedure.
      207   procedure nzzlattr-exist :
      208     do
      209     on error undo, return error
      210     :
      211       define input parameter p-obj-type like ub.nozzle-attr.obj-type   no-undo .
      212       define input parameter p-obj-code like ub.nozzle-attr.obj-code   no-undo .
      213       define input parameter p-nozzle-code like ub.nozzle-attr.nozzle-code   no-undo .
      214       define input parameter p-code     like ub.nozzle-attr.attr-code  no-undo .
      215       define output parameter p-exist    as logical no-undo .
      216       define buffer buf_nozzle-attr for ub.nozzle-attr .
      217       def var v-type           as character no-undo .
      218       def var v-format         as character no-undo .
      219       def var v-label          as character no-undo .
      220       def var v-user-can-edit  as logical   no-undo .
      221       def var v-output-display as logical   no-undo .
      222       def var v-other          as character no-undo .
      223       run nzzlattr-name in this-procedure
      224         (input  p-code
      225         ,output v-type
      226         ,output v-format
      227         ,output v-label
      228         ,output v-user-can-edit
      229         ,output v-output-display
      230         ,output v-other
      231         ) no-error .
      232       if error-status :error then do:
      233         undo, return error return-value .
      234       end.
      235       find first buf_nozzle-attr no-lock where
      236                  buf_nozzle-attr.obj-type  = p-obj-type
      237              AND buf_nozzle-attr.obj-code  = p-obj-code
      238              AND buf_nozzle-attr.nozzle-code  = p-nozzle-code
      239              AND buf_nozzle-attr.attr-code = p-code no-error .
      240       if available buf_nozzle-attr then do:
      241         P-EXIST = YES.
      242       end.
      243     end.
      244   end procedure.
      245   procedure nzzlattr-delete :
      246     do
      247     on error undo, return error
      248     :
      249       define input parameter p-obj-type like ub.nozzle-attr.obj-type   no-undo .
      250       define input parameter p-obj-code like ub.nozzle-attr.obj-code   no-undo .
      251       define input parameter p-nozzle-code like ub.nozzle-attr.nozzle-code   no-undo .
      252       define input parameter p-code     like ub.nozzle-attr.attr-code  no-undo .
      253       define output parameter p-deleted  as logical no-undo .
      254       define buffer buf_nozzle-attr for ub.nozzle-attr .
      255       def var v-type           as character no-undo .
      256       def var v-format         as character no-undo .
      257       def var v-label          as character no-undo .
      258       def var v-user-can-edit  as logical   no-undo .
      259       def var v-output-display as logical   no-undo .
      260       def var v-other          as character no-undo .
      261       run nzzlattr-name in this-procedure
      262         (input  p-code
      263         ,output v-type
      264         ,output v-format
      265         ,output v-label
      266         ,output v-user-can-edit
      267         ,output v-output-display
      268         ,output v-other
      269         ) no-error .
      270       if error-status :error then do:
      271         undo, return error return-value .
      272       end.
      273       find first buf_nozzle-attr exclusive-lock where
      274                  buf_nozzle-attr.obj-type  = p-obj-type
      275              AND buf_nozzle-attr.obj-code  = p-obj-code
      276              AND buf_nozzle-attr.nozzle-code  = p-nozzle-code
      277              AND buf_nozzle-attr.attr-code = p-code no-error .
      278       if not available buf_nozzle-attr then do:
      279         P-DELETED = NO.
      280       end.
      281       ELSE DO:
      282          delete buf_nozzle-attr.
      283          P-DELETED = YES.
      284       END.
      285     end.
      286   end procedure.
      287   define variable v-chg-fields as character no-undo.
      288   define variable v-old-fields as character no-undo.
      289   define variable v-new-fields as character no-undo.
      290   define variable ii as integer no-undo.
      291   define variable v-mess as character no-undo .
      292   define buffer buf_c-nzl-hist for ub.c-nzl-hist.
      293   define stream LogStream.
      294   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   define SHARED temp-table temp-changes no-undo
      296   field f_name as character
      297   field l_name as character
      298   field v_old as character
      299   field v_new as character
      300   field t_name as character
      301   field num_ as integer
      302   field uniq-key-rec as character
      303   field action as integer
      304   field fNotChange as logical
      305   index pi is unique primary
      306   num_
      307   t_name
      308   f_name
      309   index
      310   Chan
      311   fnotChange
      312   t_name
      313   f_name
      314   index imain uniq-key-rec
      315   .
      316   FUNCTION get-all-fields returns character (p-file-name as character ):
      317   define variable v-dop as character no-undo .
      318     find first _file no-lock where _file._file-name = p-file-name no-error .
      319     if not available _file then return "":U.
      320     for each _field no-lock where
      321              _field._file-recid = recid(_file) :
      322       assign
      323       v-dop = v-dop + _field._field-name + chr(44)
      324       .
      325     end.
      326     return trim(v-dop).
      327   END FUNCTION.
      328   PROCEDURE proc-full-temp-changes :
      329     define input  parameter p-act-create as logical   no-undo .
      330     define input  parameter p-act-delete as logical   no-undo .
      331     define input  parameter p-hst-handle as handle    no-undo .
      332     define input  parameter p-main-table as character no-undo .
      333     define input  parameter p-field-list as character no-undo .
      334     define input  parameter p-label-form as character no-undo .
      335     define variable h-new-buf         as handle    no-undo .
      336     define variable h-main-buf        as handle    no-undo .
      337     define variable h-for-comp        as handle    no-undo .
      338     define variable v-inform          as character no-undo .
      339     define variable v-ind             as integer   no-undo .
      340     define variable v-idx-field-qnty  as integer   no-undo .
      341     define variable v-num-entries     as integer   no-undo .
      342     define variable fh                as handle    no-undo .
      343     define variable fh-main           as handle    no-undo .
      344     define variable fh-old            as handle    no-undo .
      345     define variable fh-new            as handle    no-undo .
      346     define variable v-field-name      as character no-undo .
      347     define variable v-field-lvl       as character no-undo .
      348     define variable v-field-form      as character no-undo .
      349     define variable v-search-exp      as character no-undo .
      350     define variable v-srch-main       as character no-undo .
      351     define variable v-word-link       as character no-undo .
      352     define variable v-av-chip-num     as logical   no-undo .
      353     define variable v-main-pi-fld-lst as character no-undo .
      354     define variable v-main-fld-lst    as character no-undo .
      355     define variable v-delim-list      as character no-undo .
      356     define variable v-label           as character no-undo .
      357     define variable v-old-value       as character no-undo case-sensitive.
      358     define variable v-new-value       as character no-undo case-sensitive.
      359     define variable v-chg-fields as character no-undo.
      360     for each temp-changes:
      361       delete temp-changes.
      362     end.
      363     if not p-hst-handle:available then do:
      364       return .
      365     end.
      366     create buffer h-new-buf  for table p-hst-handle .
      367     create buffer h-main-buf for table p-main-table .
      368     assign
      369       v-inform = h-main-buf:index-information(1)
      370       v-ind    = 2
      371     .
      372     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      373     on error undo, return error
      374     :
      375       assign
      376         v-inform = h-main-buf:index-information( v-ind )
      377         v-ind    = v-ind + 1
      378       .
      379     end.
      380     if v-inform = ?
      381       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      382       or entry( 3, v-inform, ",":U ) <> "1":U
      383     then do:
      384       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      385     end.
      386     assign
      387       v-idx-field-qnty = num-entries( v-inform ) - 4
      388     .
      389     if v-idx-field-qnty < 2 then do:
      390       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      391     end.
      392     assign
      393       v-srch-main   = "where":U
      394       v-word-link   = "":U
      395       v-av-chip-num = false
      396       v-delim-list  = "":U
      397     .
      398     do v-ind = 1 to v-idx-field-qnty by 2
      399     on error undo, return error
      400     :
      401       assign
      402         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      403         fh                = p-hst-handle:buffer-field( v-field-name )
      404         fh-main           = h-main-buf:buffer-field( v-field-name )
      405         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      406         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      407       .
      408       if fh:data-type ="character":U then do:
      409         assign
      410           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      411         .
      412       end.
      413       else do:
      414         assign
      415           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      416         .
      417       end.
      418       if v-delim-list = "":U then do:
      419         assign
      420           v-delim-list = ",":U
      421         .
      422       end.
      423       if v-word-link = "":U then do:
      424         assign
      425           v-word-link = "and":U
      426         .
      427       end.
      428     end.
      429     assign
      430       v-delim-list  = "":U
      431     .
      432     do v-ind = 1 to h-main-buf:num-fields
      433     on error undo, return error
      434     :
      435       assign
      436         fh-main      = h-main-buf:buffer-field( v-ind )
      437         v-field-name = fh-main:name
      438       .
      439         assign
      440           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      441         .
      442         if v-delim-list = "":U then do:
      443           assign
      444             v-delim-list = ",":U
      445           .
      446         end.
      447     end.
      448     assign
      449       v-inform = p-hst-handle:index-information(1)
      450       v-ind    = 2
      451     .
      452     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      453     on error undo, return error
      454     :
      455       assign
      456         v-inform = p-hst-handle:index-information( v-ind )
      457         v-ind    = v-ind + 1
      458       .
      459     end.
      460     if v-inform = ?
      461       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      462       or entry( 3, v-inform, ",":U ) <> "1":U
      463     then do:
      464       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      465     end.
      466     assign
      467       v-idx-field-qnty = num-entries( v-inform ) - 4
      468     .
      469     if v-idx-field-qnty < 2 then do:
      470       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      471     end.
      472     assign
      473       v-search-exp  = "where":U
      474       v-word-link   = "":U
      475       v-av-chip-num = false
      476     .
      477     do v-ind = 1 to v-idx-field-qnty by 2
      478     on error undo, return error
      479     :
      480       assign
      481         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      482         fh           = p-hst-handle:buffer-field( v-field-name )
      483         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      484       .
      485       if v-field-name = "chip-num":U then do:
      486         assign
      487           v-search-exp  = substitute( "&1 >", v-search-exp )
      488           v-av-chip-num = true
      489         .
      490       end.
      491       else do:
      492         assign
      493           v-search-exp = substitute( "&1 =", v-search-exp )
      494         .
      495       end.
      496       if fh:data-type ="character":U then do:
      497         assign
      498           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      499         .
      500       end.
      501       else do:
      502         assign
      503           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      504         .
      505       end.
      506       if v-word-link = "":U then do:
      507         assign
      508           v-word-link = "and":U
      509         .
      510       end.
      511     end.
      512     if v-av-chip-num = false then do:
      513       message
      514         vss-workfile vss-revision vss-description skip
      515         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      516         "Использование данной процедуры невозможно!" skip
      517         view-as alert-box error .
      518       return error .
      519     end.
      520     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      521     if not h-new-buf:available then do:
      522       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      523       if not h-main-buf:available then do:
      524         assign
      525           h-for-comp = ?
      526         .
      527       end.
      528       else do:
      529         assign
      530           h-for-comp = h-main-buf
      531         .
      532       end.
      533     end.
      534     else do:
      535       assign
      536         h-for-comp = h-new-buf
      537       .
      538     end.
      539     assign
      540       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      541     .
      542     do v-ind = 1 to v-num-entries
      543     on error undo, return error return-value
      544     :
      545       assign
      546         v-field-name = entry( v-ind, v-main-fld-lst )
      547         fh-old       = p-hst-handle:buffer-field( v-field-name )
      548         v-old-value  = fh-old:buffer-value()
      549         v-label      = trim( fh-old:label )
      550       .
      551       if ( trim( p-field-list ) <> "":U
      552            and lookup( v-field-name, p-field-list ) > 0
      553          )
      554          or trim( p-field-list ) = "":U
      555       then do:
      556         if h-for-comp <> ? then do:
      557           assign
      558             fh-new      = h-for-comp:buffer-field( v-field-name )
      559             v-new-value = fh-new:buffer-value()
      560           .
      561         end.
      562         else do:
      563           assign
      564             v-new-value = "":U
      565           .
      566         end.
      567           if p-act-create = true then do:
      568             assign
      569               v-old-value = "":U
      570             .
      571           end.
      572           if p-act-delete = true then do:
      573             assign
      574               v-new-value = "":U
      575             .
      576           end.
      577         if v-old-value <> v-new-value
      578         then do:
      579           create temp-changes.
      580           assign
      581             temp-changes.t_name = p-main-table
      582             temp-changes.f_name = v-field-name
      583             temp-changes.l_name = replace( v-label, "&":U, "":U )
      584             temp-changes.v_old  = trim( v-old-value )
      585             temp-changes.v_new  = trim( v-new-value )
      586             temp-changes.num_   = 0
      587             temp-changes.fNotChange = v-old-value eq v-new-value
      588           .
      589         end.
      590       end.
      591     end.
      592     assign
      593       v-num-entries = num-entries( p-label-form, chr(8) )
      594     .
      595     do v-ind = 1 to v-num-entries
      596     on error undo, return error return-value
      597     :
      598       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      599         assign
      600           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      601           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      602           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      603         .
      604         find first temp-changes
      605           where temp-changes.f_name = v-field-name
      606           no-error .
      607         if available temp-changes then do:
      608           if trim( v-field-lvl ) <> "":U then do:
      609             assign
      610               temp-changes.l_name = v-field-lvl
      611             .
      612           end.
      613           if trim( v-field-form ) <> "":U then do:
      614             assign
      615               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      616             .
      617             if h-for-comp <> ? then do:
      618               assign
      619                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      620               .
      621             end.
      622           end.
      623         end.
      624       end.
      625       else do:
      626         message
      627           vss-workfile vss-revision vss-description skip
      628           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      629           substitute( "список для поля '&1': '&2'"
      630                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      631                       ,entry( v-ind, p-label-form, chr(8) )
      632                     ) skip
      633           substitute( "полный список: &2", p-label-form ) skip
      634           view-as alert-box error .
      635       end.
      636     end.
      637     delete object h-new-buf .
      638     delete object h-main-buf .
      639   END PROCEDURE.
      640   find first buf_c-nzl-hist no-lock where
      641             buf_c-nzl-hist.obj-type = p-obj-type
      642         AND buf_c-nzl-hist.obj-code = p-obj-code
      643         AND buf_c-nzl-hist.nozzle-code = p-nozzle-code
      644         AND buf_c-nzl-hist.chip-num = p-chip-num
      645         AND buf_c-nzl-hist.corr-user-db-num = p-corr-user-db-num
      646         AND buf_c-nzl-hist.subject  = p-subject no-error .
      647   if not available buf_c-nzl-hist then do:
      648     return error .
      649   end.
      650   CASE p-subject:
      651     when 'nozzle':U then do:
      652       run nozzle-proc in this-procedure(output p-description) no-error  .
      653     end.
      654     when 'pump-nozzle':U then do:
      655       run pump-nozzle-proc in this-procedure(output p-description) no-error  .
      656     end.
      657     when 'pl-pump-nozzle':U then do:
      658       run pl-pump-nozzle-proc in this-procedure(output p-description) no-error  .
      659     end.
      660     when 'nozzle-attr':U then do:
      661       run nozzle-attr-proc in this-procedure(output p-description) no-error  .
      662     end.
      663   END CASE.
      664   if error-status:error then do:
      665     return error .
      666   end.
      667   procedure nozzle-proc :
      668   define output parameter p-description as character no-undo .
      669   define buffer curr_c-nozzle for ub.c-nozzle  .
      670     do
      671     on error undo, return error
      672     :
      673       find first curr_c-nozzle no-lock where
      674                  curr_c-nozzle.obj-type = p-obj-type
      675              AND curr_c-nozzle.obj-code = p-obj-code
      676              AND curr_c-nozzle.nozzle-code = buf_c-nzl-hist.nozzle-code
      677              AND curr_c-nozzle.chip-num = p-chip-num
      678              AND curr_c-nozzle.corr-user-db-num = p-corr-user-db-num
      679              no-error .
      680       if not avail curr_c-nozzle then do:
      681         v-mess = "Неверная ссылка на c-nozzle в таблице c-nzl-hist".
      682         run err-mess in this-procedure ( input-output v-mess).
      683         return error v-mess.
      684       end.
      685   define variable v-label-param as character no-undo .
      686   v-label-param =
      687     "nozzle-code" + chr(4) + "№ пистолета" + chr(4) + "" + chr(8)
      688    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      689    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      690    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
      691    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
      692    run proc-full-temp-changes in this-procedure (
      693                                                input (buf_c-nzl-hist.action = integer('1':U))
      694                                               ,input (buf_c-nzl-hist.action = integer('99':U))
      695                                               ,input  buffer curr_c-nozzle:handle
      696                                               ,input  'nozzle':U
      697                                               ,input  "nozzle-code,obj-code,obj-type,PS,status_"
      698                                               ,input  v-label-param).
      699   end.
      700   end procedure.
      701   procedure pump-nozzle-proc :
      702   define output parameter p-description as character no-undo .
      703   define buffer buf_c-table-bind for ub.c-table-bind.
      704   define buffer curr_c-pump-nozzle for ub.c-pump-nozzle  .
      705     do
      706     on error undo, return error
      707     :
      708       find first buf_c-table-bind no-lock where
      709                 buf_c-table-bind.corr-user-db-num = buf_c-nzl-hist.corr-user-db-num
      710             AND buf_c-table-bind.tbl-name-rec     = 'c-nzl-hist':U
      711             AND buf_c-table-bind.chip-num-rec     = buf_c-nzl-hist.chip-num no-error .
      712       if not available buf_c-table-bind then do:
      713         v-mess = "Неверная ссылка на c-table-bind в таблице c-nzl-hist".
      714         run err-mess in this-procedure ( input-output v-mess).
      715         return error v-mess.
      716       end.
      717       find first curr_c-pump-nozzle no-lock where
      718                  curr_c-pump-nozzle.obj-type = buf_c-nzl-hist.obj-type
      719              AND curr_c-pump-nozzle.obj-code = buf_c-nzl-hist.obj-code
      720              AND curr_c-pump-nozzle.nozzle-code = buf_c-nzl-hist.nozzle-code
      721              AND curr_c-pump-nozzle.chip-num = buf_c-table-bind.chip-num-src
      722              AND curr_c-pump-nozzle.corr-user-db-num = buf_c-table-bind.corr-user-db-num no-error .
      723       if not avail curr_c-pump-nozzle then do:
      724         v-mess = "Неверная ссылка на c-pump-nozzle в таблице c-nzl-hist".
      725         run err-mess in this-procedure ( input-output v-mess).
      726         return error.
      727       end.
      728   define variable v-label-param as character no-undo .
      729   v-label-param =
      730     "nozzle-code" + chr(4) + "№ пистолета" + chr(4) + "" + chr(8)
      731    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      732    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      733    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
      734    + "status_" + chr(4) + "Статус" + chr(4) + "" + chr(8)
      735    + "is-meas" + chr(4) + "Измеряется приборами" + chr(4) + "" + chr(8)
      736    + "pump-code" + chr(4) + "№ ТРК" + chr(4) + ""  + chr(8)
      737    + "ef-nid" + chr(4) + "Идентификатор EasyFuel" + chr(4) + ""  .
      738    run proc-full-temp-changes in this-procedure (
      739                                                input (buf_c-nzl-hist.action = integer('1':U))
      740                                               ,input (buf_c-nzl-hist.action = integer('99':U))
      741                                               ,input  buffer curr_c-pump-nozzle:handle
      742                                               ,input  'pump-nozzle':U
      743                                               ,input  "nozzle-code,obj-code,obj-type,PS,status_,is-meas,pump-code"
      744                                               ,input  v-label-param).
      745   end.
      746   end procedure.
      747   procedure pl-pump-nozzle-proc :
      748   define output parameter p-description as character no-undo .
      749   define buffer buf_c-table-bind for ub.c-table-bind.
      750   define buffer curr_c-pl-pump-nozzle for ub.c-pl-pump-nozzle  .
      751     do
      752     on error undo, return error
      753     :
      754       find first buf_c-table-bind no-lock where
      755                 buf_c-table-bind.corr-user-db-num = buf_c-nzl-hist.corr-user-db-num
      756             AND buf_c-table-bind.tbl-name-rec     = 'c-nzl-hist':U
      757             AND buf_c-table-bind.chip-num-rec     = buf_c-nzl-hist.chip-num no-error .
      758       if not available buf_c-table-bind then do:
      759         v-mess = "Неверная ссылка на c-table-bind в таблице c-nzl-hist".
      760         run err-mess in this-procedure ( input-output v-mess).
      761         return error v-mess.
      762       end.
      763       find first curr_c-pl-pump-nozzle no-lock where
      764                  curr_c-pl-pump-nozzle.nozzle-code = buf_c-nzl-hist.nozzle-code
      765              AND curr_c-pl-pump-nozzle.obj-type = buf_c-nzl-hist.obj-type
      766              AND curr_c-pl-pump-nozzle.obj-code = buf_c-nzl-hist.obj-code
      767              AND curr_c-pl-pump-nozzle.chip-num = buf_c-table-bind.chip-num-src
      768              AND curr_c-pl-pump-nozzle.corr-user-db-num = buf_c-table-bind.corr-user-db-num  no-error .
      769       if not avail curr_c-pl-pump-nozzle then do:
      770         v-mess = "Неверная ссылка на c-pl-pump-nozzle в таблице c-nzl-hist".
      771         run err-mess in this-procedure ( input-output v-mess).
      772         return error v-mess .
      773       end.
      774   define variable v-label-param as character no-undo .
      775   v-label-param =
      776     "nozzle-code" + chr(4) + "№ пистолета" + chr(4) + "" + chr(8)
      777    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      778    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      779    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
      780    + "status_" + chr(4) + "Статус" + chr(4) + "" + chr(8)
      781    + "is-meas" + chr(4) + "Измеряется приборами" + chr(4) + "" + chr(8)
      782    + "pump-code" + chr(4) + "№ ТРК" + chr(4) + "" + chr(8)
      783    + "pl-code" + chr(4) + "Код складского места" + chr(4) + ""  .
      784    run proc-full-temp-changes in this-procedure (
      785                                                input (buf_c-nzl-hist.action = integer('1':U))
      786                                               ,input (buf_c-nzl-hist.action = integer('99':U))
      787                                               ,input  buffer curr_c-pl-pump-nozzle:handle
      788                                               ,input  'pl-pump-nozzle':U
      789                                               ,input  "nozzle-code,obj-code,obj-type,PS,status_,is-meas,pump-code,pl-code"
      790                                               ,input  v-label-param).
      791   end.
      792   end procedure.
      793   procedure nozzle-attr-proc :
      794   define output parameter p-description as character no-undo .
      795   define variable v-tooltip as character no-undo .
      796   define variable v-label as character no-undo .
      797   define buffer current_c-nozzle-attr for ub.c-nozzle-attr  .
      798     do
      799     on error undo, return error
      800     :
      801       find first current_c-nozzle-attr no-lock where
      802                  current_c-nozzle-attr.chip-num = p-chip-num
      803              AND current_c-nozzle-attr.corr-user-db-num = p-corr-user-db-num
      804              AND current_c-nozzle-attr.obj-type = p-obj-type
      805              AND current_c-nozzle-attr.obj-code = p-obj-code
      806              AND current_c-nozzle-attr.nozzle-code = p-nozzle-code  no-error .
      807       if not avail current_c-nozzle-attr then do:
      808         v-mess = "Неверная ссылка на c-nozzle-attr в таблице c-nzl-hist".
      809         run err-mess in this-procedure ( input-output v-mess).
      810         return error v-mess.
      811       end.
      812       run nzzlattr-tooltip in this-procedure (
      813                   input  current_c-nozzle-attr.attr-code
      814                   ,output v-tooltip
      815                   ,output v-label
      816                   ) no-error .
      817       assign
      818       p-description = "Атрибут" + chr(32) + v-label
      819       .
      820   define variable v-label-param as character no-undo .
      821   v-label-param =
      822     "nozzle-code" + chr(4) + "№ пистолета" + chr(4) + "" + chr(8)
      823    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      824    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      825    + "attr-value" + chr(4) + "Значение атрибута" + chr(4) + ""  .
      826    run proc-full-temp-changes in this-procedure (
      827                                                input (buf_c-nzl-hist.action = integer('1':U))
      828                                               ,input (buf_c-nzl-hist.action = integer('99':U))
      829                                               ,input  buffer current_c-nozzle-attr:handle
      830                                               ,input  'nozzle-attr':U
      831                                               ,input  "nozzle-code,obj-code,obj-type,attr-value"
      832                                               ,input  v-label-param).
      833   end.
      834   end procedure.
      835   PROCEDURE err-mess:
      836     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      837     CASE p-silent:
      838       when yes then do:
      839         p-mess =
      840         substitute("История пистолета &1 на &2&3: щепка &4 БД:&5  Предмет изменений &6&7&8"
      841                     ,p-nozzle-code
      842                     ,p-obj-type
      843                     ,p-obj-code
      844                     ,p-chip-num
      845                     ,p-corr-user-db-num
      846                     ,p-subject
      847                     ,chr(10)
      848                     ,p-mess
      849                     ).
      850       end.
      851       otherwise do:
      852         message
      853         p-mess
      854         view-as alert-box error .
      855       end.
      856     end.
      857   END PROCEDURE.
