      130   define new global shared variable g#library  as handle no-undo .
      131   define new global shared variable g#library2 as handle no-undo .
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define variable c-point  as character no-undo .
      134   define variable tbl      as character no-undo .
      135   define variable join-tbl as character no-undo .
      136   define variable fld      as character no-undo .
      137   define variable lab      as character no-undo .
      138   define variable spr      as character no-undo .
      139   define variable dim      as character no-undo .
