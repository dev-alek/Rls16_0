     2933   def var sort-labelBR-docs   as character no-undo .
     2934   def var sort-clmnBR-docs    as handle    no-undo .
     2935   def var cur-clmnBR-docs     as handle    no-undo .
     2936   def var cur-clmn-locBR-docs as integer   no-undo .
     2937   def var re-queryBR-docs     as logical   initial no no-undo .
     2938   on start-search, ctrl-o of BR-docs in frame Dialog-Frame do:
     2939      run sort-brBR-docs
     2940        (input (if available chk-gds
     2941                then recid(chk-gds)
     2942                else ?
     2943               )
     2944        ).
     2945   end.
     2946   PROCEDURE sort-brBR-docs :
     2947     define input parameter p-recid as recid no-undo .
     2948     if re-queryBR-docs = no then do:
     2949       assign
     2950          cur-clmnBR-docs = BR-docs:current-column in frame Dialog-Frame
     2951       .
     2952       if sort-clmnBR-docs <> ? then sort-clmnBR-docs:column-fgcolor = 0.
     2953       if cur-clmnBR-docs = sort-clmnBR-docs then do:
     2954         assign
     2955            sort-labelBR-docs = ""
     2956            sort-clmnBR-docs = ?
     2957         .
     2958        end.
     2959        else do:
     2960          assign
     2961            sort-labelBR-docs = cur-clmnBR-docs:label
     2962            sort-clmnBR-docs  = cur-clmnBR-docs
     2963            sort-clmnBR-docs:column-fgcolor = 4
     2964          .
     2965        end.
     2966      end.
     2967     assign
     2968       cur-clmn-locBR-docs = 1
     2969     .
     2970     def var column-handle as handle no-undo .
     2971     column-handle = BR-docs:first-column.
     2972     do while valid-handle(column-handle) :
     2973       if column-handle = cur-clmnBR-docs then do:
     2974         leave .
     2975       end.
     2976       column-handle = column-handle:NEXT-COLUMN.
     2977       assign
     2978         cur-clmn-locBR-docs = cur-clmn-locBR-docs + 1
     2979       .
     2980     end.
     2981     case sort-labelBR-docs:
     2982           when BAR-CODE.B-CODE:label in browse BR-docs then DO:    assign       sort-column-name = "BAR-CODE.B-CODE"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2983           when c-doc.office:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.office"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2984           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(chk-gds), &1&2&1)', chr(34), rid-list)     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2985           when c-doc.doc-code:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.doc-code"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2986           when 'Тип_чека'  then DO:    assign       sort-column-name = "entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2987           when c-doc.chk-num:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.chk-num"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2988           when c-doc.chk-date:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.chk-date"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2989           when 'Время'  then DO:    assign       sort-column-name = "(string (c-doc.chk-time, 'HH:MM'))"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2990           when chk-gds.doc-qnty:label in browse BR-docs then DO:    assign       sort-column-name = "chk-gds.doc-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2991           when chk-gds.price-base:label in browse BR-docs then DO:    assign       sort-column-name = "chk-gds.price-base"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2992           when chk-gds.discnt:label in browse BR-docs then DO:    assign       sort-column-name = "chk-gds.discnt"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2993           when '%'  then DO:    assign       sort-column-name = "(chk-gds.discnt / chk-gds.price-base * 100)"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2994           when 'Нетто цена'  then DO:    assign       sort-column-name = "(chk-gds.price-base - chk-gds.discnt)"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2995           when 'ТРК'  then DO:    assign       sort-column-name = "chk-gds.pump"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2996           when 'Пист'  then DO:    assign       sort-column-name = "chk-gds.nozzle-code"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2997           when 'Рез'  then DO:    assign       sort-column-name = "chk-gds.loc1"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2998           when 'Код_спис'  then DO:    assign       sort-column-name = "entry (lookup (STRING(chk-gds.WRITE-off-code),  '?,0,1,-6,-9,2,-2,3,-3,-4,17':U), ',,Без_оплаты,Отмена_позиции,Полн_Отмена,Модификатор,Модификатор,Модификатор(+спис),Модификатор(-спис),Модификатор(-спис),Техпролив':U)"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     2999           when c-doc.shift-date:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.shift-date"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     3000           when c-doc.pay-desk:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.pay-desk"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     3001           when c-doc.cashier:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.cashier"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     3002           when c-doc.sales-man:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.sales-man"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     3003           when c-doc.out-code:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.out-code"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     3004           when c-doc.d-card:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.d-card"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     3005       otherwise do:
     3006         assign
     3007           sort-column-name = ""
     3008         .
     3009         run OpenBr in this-procedure ( input yes, input no, input '').
     3010         if sort-labelBR-docs <> "" then do:
     3011           assign
     3012             cur-clmnBR-docs:column-fgcolor = 0
     3013           .
     3014         end.
     3015         assign
     3016           cur-clmn-locBR-docs = ?
     3017         .
     3018       end.
     3019     end case.
     3020     if p-recid <> ? then do:
     3021       reposition BR-docs to recid p-recid no-error.
     3022       apply "value-changed" to BR-docs in frame Dialog-Frame.
     3023     end.
     3024     apply "entry" to BR-docs in frame Dialog-Frame.
     3025   END PROCEDURE.
     3026   procedure re-open-query-srt-clmnBR-docs:
     3027   if cur-clmnBR-docs = ? then do:
     3028      run OpenBr in this-procedure ( input yes, input no, input '').
     3029   end.
     3030   else do:
     3031      assign re-queryBR-docs = yes.
     3032      run sort-brBR-docs
     3033        (input (if available chk-gds
     3034                then recid(chk-gds)
     3035                else ?
     3036               )
     3037        ).
     3038      assign re-queryBR-docs = no.
     3039   end.
     3040   end.
     3041   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3042   DEF VAR cur-clmn-numbr-docs as INT EXTENT 29 no-undo.
     3043   DEF VAR varmvibr-docs       as INT no-undo.
     3044   DEF VAR varmvjbr-docs       as INT no-undo.
     3045   DEF VAR varmvkbr-docs       as INT no-undo.
     3046   DEF VAR varmvlbr-docs       as INT no-undo.
     3047   DEF VAR move-elementbr-docs as INT no-undo.
     3048   def var jjbr-docs           as int no-undo.
     3049   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     3050     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
     3051   END.
     3052   RUN start-mv-clmnbr-docs.
     3053   PROCEDURE start-mv-clmnbr-docs:
     3054   def var old-session as logical no-undo.
     3055      old-session = SESSION:IMMEDIATE-DISPLAY.
     3056      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3057      SESSION:IMMEDIATE-DISPLAY = old-session.
     3058   END.
     3059   ON ctrl-cursor-right OF BROWSE br-docs do:
     3060     RUN re-move-clmnbr-docs ( 10, 29).
     3061   END.
     3062   ON ctrl-cursor-left OF BROWSE br-docs do:
     3063     RUN re-move-clmnbr-docs (29, 10).
     3064   END.
     3065   PROCEDURE re-move-clmnbr-docs:
     3066     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3067     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3068     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3069       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
     3070     END.
     3071     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3072     if source-column > target-column THEN
     3073     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
     3074       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3075           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3076             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
     3077           END.
     3078       END.
     3079     END.
     3080     ELSE
     3081     DO varmvjbr-docs = source-column + 1 to target-column:
     3082       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3083         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3084           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
     3085         END.
     3086       END.
     3087     END.
     3088     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3089       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
     3090     END.
     3091   END PROCEDURE.
     3092   PROCEDURE ch-clmnbr-docs:
     3093     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3094     if cur-clmn-loc <= 10 then do:
     3095       return .
     3096     end.
     3097     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3098       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
     3099     END.
     3100     RUN re-move-clmnbr-docs (cur-clmn-loc, 10).
     3101   END PROCEDURE.
     3102   PROCEDURE mv-brw-defaultbr-docs:
     3103   def var old-session as logical no-undo.
     3104     old-session = SESSION:IMMEDIATE-DISPLAY.
     3105     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3106     do varmvlbr-docs = 10 to EXTENT(cur-clmn-numbr-docs):
     3107       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
     3108     END.
     3109     RUN start-mv-clmnbr-docs.
     3110     SESSION:IMMEDIATE-DISPLAY = old-session.
     3111   END PROCEDURE.
     3112   .
     3113   MAIN-BLOCK:
     3114   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3115      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3116   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3117     run mainmenu_getcntxt in parparentproc
     3118       (output v-cntxt-db-num
     3119       ,output v-cntxt-userid
     3120       ,output v-cntxt-level
     3121       ,output v-cntxt-host-code-obj
     3122       ,output v-cntxt-obj-type
     3123       ,output v-cntxt-obj-code
     3124       ,output v-cntxt-db-num-obj
     3125       ,output v-cntxt-is-admin
     3126       ) .
     3127     find FIRST buf_goods where
     3128                recid(buf_goods) = r-g NO-LOCK.
     3129     find FIRST buf_gds-prt where
     3130                buf_gds-prt.upper-code = buf_goods.prt-root no-lock.
     3131     if entry(1, par-mode) = "gds-chk":u then do:
     3132       assign
     3133       v-cycle = yes
     3134       par-mode = substr(par-mode, 9)
     3135       .
     3136     end.
     3137   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3138   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3139     (output v-curr-r-b
     3140     )  .
     3141   CASE par-mode:
     3142       WHEN 'все':U        THEN DO:
     3143       END.
     3144       WHEN 'объект':U or when "free":U THEN DO:
     3145         FIND FIRST buf_obj No-LOCK WHERE
     3146                     buf_obj.obj-type = parobj-type and
     3147                     buf_obj.obj-code = parobj-code No-ERROR.
     3148         if not avail buf_obj then do:
     3149           message vss-workfile vss-revision vss-description skip
     3150           "Неверное значение параметров вызова parobj-type и/или parobj-code"
     3151           parobj-type parobj-code
     3152           view-as alert-box ERROR.
     3153           return.
     3154         end.
     3155       END.
     3156       when "d-card":U or when ("d-card" + chr(44) + 'продажа':U) then do:
     3157           FIND FIRST buf_dis-card where
     3158                             buf_dis-card.d-card = pard-card No-LOCK NO-ERROR.
     3159         if not avail buf_dis-card then do:
     3160             message vss-workfile vss-revision vss-description skip
     3161             "Неверное значение параметра вызова pard-card" pard-card
     3162             view-as alert-box ERROR.
     3163             return.
     3164         end.
     3165          FIND FIrst  buf_clients NO-LOCK WHERE
     3166                           buf_clients.obj-type = buf_dis-card.cli-type AND
     3167                           buf_clients.obj-code = buf_dis-card.cli-code No-ERROR.
     3168       end.
     3169       WHEN 'продажа':U  or when ("d-card" + chr(44) + 'продажа':U) then do:
     3170           FIND buf_inkas where buf_inkas.inkas-code = parout-code NO-LOCK no-error.
     3171         if not avail buf_inkas then do:
     3172             message vss-workfile vss-revision vss-description skip
     3173             "Неверное значение параметра вызова parout-code" parout-code
     3174             view-as alert-box ERROR.
     3175             return.
     3176         end.
     3177         assign
     3178         v-inkas-host-code = buf_inkas.host-code
     3179         v-inkas-obj-type = buf_inkas.obj-type
     3180         v-inkas-obj-code = buf_inkas.obj-code
     3181         .
     3182       end.
     3183       otherwise do:
     3184         message vss-workfile vss-revision vss-description skip
     3185         "Неверный вызов - par-mode=" par-mode
     3186         view-as alert-box ERROR.
     3187         return.
     3188       end.
     3189     end CASE.
     3190       if pardoc-rec <> ? then do:
     3191         FIND FIRST find_bar-code No-LOCK where
     3192                    recid(find_bar-code) = pardoc-rec No-ERROR.
     3193         if not avail find_bar-code then do:
     3194           message
     3195           vss-workfile vss-revision vss-description skip
     3196           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3197           view-as alert-box error .
     3198           return error.
     3199         end.
     3200         v-doc-rec = pardoc-rec.
     3201       end.
     3202     RUN MyEnable in this-procedure .
     3203     RUn OpenBR in this-procedure (  input yes, input no, input '':U).
     3204     HIDE mark-num in frame Dialog-Frame .
     3205     if pardoc-rec <> ? then
     3206     REPOSITION br-docs to recid pardoc-rec No-ERROR.
     3207     WAIT-FOR GO OF FRAME Dialog-Frame.
     3208   END.
     3209   RUN disable_UI in this-procedure .
     3210   PROCEDURE disable_UI :
     3211     HIDE FRAME Dialog-Frame.
     3212   END PROCEDURE.
     3213   PROCEDURE enable_UI :
     3214     DISPLAY Cb-chk-type RS-sort ED-notes sch-bcode sch-code sch-date sch-price
     3215             mark-num
     3216         WITH FRAME Dialog-Frame.
     3217     ENABLE b-quit B-mark b-sel b-lkp b-onlybcode B-del B-sale B-print B-sch
     3218            B-Help Cb-chk-type RS-sort BR-docs ED-notes sch-bcode sch-code
     3219            sch-date sch-price mark-num
     3220         WITH FRAME Dialog-Frame.
     3221     VIEW FRAME Dialog-Frame.
     3222   END PROCEDURE.
     3223   PROCEDURE get-params :
     3224   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3225   define variable v-param-type32 as character no-undo .
     3226   define variable v-value-character32 as character no-undo .
     3227   define variable v-value-date32 as date no-undo .
     3228   define variable v-value-decimal32 as decimal no-undo .
     3229   define variable v-value-integer32 as INTEGER no-undo .
     3230   define variable v-tth32 as handle no-undo .
     3231   run adm/shattri.p (
     3232       input "get":U
     3233       ,input  parobj-type
     3234       ,input  parobj-code
     3235       ,input  'get-chk':U
     3236       ,input  'cas-shft':U
     3237       ,output v-value-character32
     3238       ,output v-value-date32
     3239       ,output v-value-decimal32
     3240       ,output v-value-integer32
