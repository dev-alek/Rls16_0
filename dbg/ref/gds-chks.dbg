      872   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      874   procedure fltopend_fltopend :
      875   define input parameter p-parent-handle as handle no-undo .
      876   define input parameter p-qh as handle no-undo .
      877   define input parameter p-flt-open-open-query  as character no-undo .
      878   define input parameter p-where-cond as character no-undo .
      879   define input parameter p-use-indFIRST-query-tail as character no-undo .
      880   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      881   define input parameter p-indexed-reposition as character no-undo .
      882     do
      883     on error undo, return error
      884     :
      885   define variable v-prepare-string as character no-undo .
      886   define variable glog as logical no-undo .
      887   assign
      888   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      889                      p-where-cond + chr(32)  +
      890                      p-use-indFIRST-query-tail + chr(32) +
      891                      p-use-ind-sort-clmn-by + chr(32) +
      892                      p-indexed-reposition
      893   .
      894   assign
      895   glog = p-qh:query-prepare(v-prepare-string) no-error .
      896   if not glog
      897   or error-status:error then do:
      898     message error-status:get-message(1) view-as alert-box .
      899     undo, return error .
      900   end.
      901   assign
      902   glog = p-qh:query-open no-error .
      903   if not glog
      904   or error-status:error then do:
      905     message error-status:get-message(1) view-as alert-box .
      906     undo, return error .
      907   end.
      908     end.
      909   end procedure.
      910   procedure fltopend_fltfindd :
      911   define input parameter p-parent-handle as handle no-undo .
      912   define input parameter p-qh as handle no-undo .
      913   define input parameter p-rowid as rowid no-undo .
      914   define input parameter p-next as logical no-undo .
      915   define input parameter p-lock as integer no-undo .
      916   define input parameter p-bh as handle no-undo .
      917   define input parameter p-where-cond as character no-undo .
      918   define input parameter p-use-index-phrase as character no-undo .
      919   define variable glog as logical no-undo .
      920   define variable v-qh as handle no-undo .
      921   define variable v-bh as handle no-undo .
      922   define variable v-recid as recid no-undo .
      923   define variable v-prepare-string as character no-undo .
      924   do
      925   on error undo, return error
      926   on stop undo, return error
      927   :
      928     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      929     create buffer v-bh for table p-bh buffer-name p-bh:name.
      930     create query v-qh.
      931     v-qh:set-buffers(v-bh).
      932     v-prepare-string = substitute("for each &1 &2 &3"
      933                                     ,v-bh:name
      934                                     ,p-where-cond
      935                                     ,p-use-index-phrase).
      936     glog = v-qh:query-prepare(v-prepare-string) no-error.
      937     if not glog then do:
      938       delete object v-qh.
      939       delete object v-bh.
      940       undo, return error .
      941     end.
      942     glog = v-qh:query-open no-error .
      943     if not glog then do:
      944       delete object v-qh.
      945       delete object v-bh.
      946       undo, return error .
      947     end.
      948     if p-next then do:
      949       v-qh:reposition-to-rowid(p-rowid) no-error .
      950       glog = v-qh:get-next( p-lock) no-error .
      951       glog = v-qh:get-next( p-lock) no-error .
      952       if not glog or v-qh:query-off-end = yes then do:
      953         glog = v-qh:get-first( p-lock) no-error .
      954       end.
      955     end.
      956     else do:
      957       glog = v-qh:get-first( p-lock) no-error .
      958     end.
      959     v-recid = v-bh:recid no-error .
      960     delete object v-qh.
      961     delete object v-bh.
      962     return string(v-recid) .
      963   end.
      964   end procedure.
      965   procedure fltopend_fltfindq :
      966   define input parameter p-parent-handle as handle no-undo .
      967   define input parameter p-qh as handle no-undo .
      968   define input parameter p-next as logical no-undo .
      969   define input parameter p-lock as integer no-undo .
      970   define input parameter p-flt-open-open-query  as character no-undo .
      971   define input parameter p-where-cond as character no-undo .
      972   define input parameter p-use-indFIRST-query-tail as character no-undo .
      973   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      974   define input parameter p-indexed-reposition as character no-undo .
      975   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      976   define variable glog as logical no-undo .
      977   define variable v-qh as handle no-undo .
      978   define variable v-bh as handle no-undo extent 18.
      979   define variable v-rowid as rowid no-undo extent 18.
      980   define variable v-ii as integer no-undo .
      981   define variable v-prepare-string as character no-undo .
      982   do
      983   on error undo, return error
      984   on stop undo, return error
      985   :
      986     create query v-qh.
      987     do v-ii = 1 to p-qh:num-buffers:
      988       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      989       assign
      990       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      991       no-error.
      992       v-qh:add-buffer(v-bh[v-ii]).
      993     end.
      994     assign
      995     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      996                       p-where-cond + chr(32)  +
      997                       p-use-indFIRST-query-tail + chr(32) +
      998                       p-use-ind-sort-clmn-by + chr(32) +
      999                       p-indexed-reposition
     1000     .
     1001     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1002     if not glog then do:
     1003       delete object v-qh.
     1004       do v-ii = 1 to p-qh:num-buffers:
     1005         delete object v-bh[v-ii].
     1006       end.
     1007       undo, return error .
     1008     end.
     1009     glog = v-qh:query-open no-error .
     1010     if not glog then do:
     1011       delete object v-qh.
     1012       do v-ii = 1 to p-qh:num-buffers:
     1013         delete object v-bh[v-ii].
     1014       end.
     1015       undo, return error .
     1016     end.
     1017     if p-next then do:
     1018       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1019       glog = v-qh:get-next( p-lock) no-error .
     1020       glog = v-qh:get-next( p-lock) no-error .
     1021       if not glog or v-qh:query-off-end = yes then do:
     1022         glog = v-qh:get-first( p-lock) no-error .
     1023       end.
     1024     end.
     1025     else do:
     1026       glog = v-qh:get-first( p-lock) no-error .
     1027     end.
     1028     do v-ii = 1 to p-qh:num-buffers:
     1029       assign
     1030       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1031       no-error.
     1032     end.
     1033     delete object v-qh.
     1034     do v-ii = 1 to p-qh:num-buffers:
     1035       delete object v-bh[v-ii].
     1036     end.
     1037   end.
     1038   end procedure.
