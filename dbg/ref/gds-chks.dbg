     3246   END PROCEDURE.
     3247   PROCEDURE MyEnable :
     3248   ASSIGN
     3249   cb-chk-type:LIST-ITEM-PAIRS  in frame Dialog-Frame =  "Все типы чеков" + chr(44) + '0':U + chr(44) +
     3250                                                          'Продажа,1,Возврат,6,ВзврСпис,96,СбросТрнзкц,14,Перелив,15,ПеревТрнзкц,16,РазблТрнзкц,36,ТехПролив,17,Списание,69,Аннуляция,8,Инвентаризация,11,Z-отчет,12,_Продажа,101,_Возврат,106,_ВзврСпис,196,_СбросТрнзкц,114,_Перелив,115,_ПеревТрнзкц,116,_ТехПролив,117,_Списание,169,_Аннуляция,108,_Инвентаризация,111,_Z-отчет,112,_СбросТрнзкц,114,_РазблТрнзкц,136,>Продажа,201,>Возврат,206,>Аннуляция,208,>>Продажа,301,>>Возврат,306':U
     3251   cb-chk-type = string(0)
     3252   p-chk-type = integer(cb-chk-type)
     3253   br-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 9
     3254   b-print:MENU-MOUSE = 1
     3255   b-del:MENU-MOUSE = 1
     3256   c-doc.cashier:READ-ONLY IN BROWSE BR-docs = YES
     3257   RS-sort = "doc-code":U
     3258   .
     3259   if lookup ('продажа':U, par-mode) > 0 then do:
     3260       assign
     3261       v-doc-rec = ?
     3262       .
     3263   end.
     3264   DISPLAY
     3265   ED-notes
     3266   sch-bcode
     3267   sch-code
     3268   sch-date
     3269   sch-price
     3270   mark-num
     3271   RS-sort
     3272   cb-chk-type when par-mode <> 'все':U
     3273   WITH FRAME Dialog-Frame .
     3274   ENABLE
     3275   b-quit
     3276   b-lkp
     3277   b-onlybcode when v-cycle = no
     3278   b-sch
     3279   b-sale when par-mode <> 'продажа':U
     3280   b-help
     3281   br-docs
     3282   b-sel  when LOOKUP("b-sel":U, bttns) > 0
     3283   b-mark when LOOKUP("b-mark":U, bttns) > 0
     3284   b-del WHEN LOOKUP("b-del":U, bttns) > 0 AND LOOKUP('продажа':U, par-mode) > 0 AND buf_Inkas.STATUS_ <> 'факт':U and buf_inkas.status_ <> 'запрос':U
     3285   sch-bcode
     3286   sch-code
     3287   sch-date
     3288   sch-price
     3289   ed-notes
     3290   b-print
     3291   RS-sort
     3292   cb-chk-type when par-mode <> 'все':U
     3293   WITH FRAME Dialog-Frame.
     3294   IF LOOKUP('продажа':U, par-mode) = 0 THEN DO:
     3295       HIDE
     3296       b-del
     3297       IN FRAME Dialog-Frame.
     3298   END.
     3299   if par-mode = 'все':U then do:
     3300     hide
     3301     cb-chk-type
     3302     in frame Dialog-Frame .
     3303   end.
     3304   VIEW FRAME Dialog-Frame .
     3305   END PROCEDURE.
     3306   PROCEDURE OpenBr :
     3307   define input  parameter p-open-query     as logical   no-undo .
     3308   define input  parameter p-find-next      as logical   no-undo .
     3309   define input  parameter p-find-condition as character no-undo .
     3310   DEFINE VARIABLE l-query-was-opened as logical no-undo .
     3311   define variable title0 as character no-undo.
     3312   title0 = "Список чеков по товару" + chr(32) +
     3313            "Артикул:" + chr(32) + buf_goods.artic + chr(32) + buf_goods.gds-name + chr(32) .
     3314   run waitfram-show in this-procedure ( input "Ждите...").
     3315   DEFINE VARIABLE sort-column-phrase as character no-undo .
     3316   case sort-column-name :
     3317     when "" then do:
     3318       assign
     3319         sort-column-phrase = ""
     3320       .
     3321     end.
     3322     otherwise do:
     3323       assign
     3324         sort-column-phrase = "by " + sort-column-name
     3325       .
     3326     end.
     3327   end case.
     3328   define variable l-open-query as logical   no-undo .
     3329   CASE RS-sort:
     3330     when "unsort":U then do:
     3331       CASE par-mode :
     3332         WHEN 'все':U        THEN DO:
     3333         v-print-host-code = 0.
     3334         ASSIGN
     3335         filter-point = filter-point0 + par-mode
     3336         filter-label = substitute("&1", filter-label0)
     3337         .
     3338         if p-open-query then do:
     3339           assign
     3340           frame Dialog-Frame:TITLE = substitute("&1", title0)
     3341           .
     3342         end.
     3343   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3344   define variable  l-disable-where-34  as logical   no-undo .
     3345   define variable  l-filter-open-34    as logical   .
     3346   define variable  flt-rec-34       as recid     no-undo .
     3347   define variable  filter-name-34      as character no-undo .
     3348   define variable  where-phrase-34     as character no-undo .
     3349   define variable  sort-phrase-34      as character no-undo .
     3350   define variable  where-phrase-rus-34 as character no-undo .
     3351   define variable  sort-phrase-rus-34  as character no-undo .
     3352   run gbl/flt-get.p
     3353     (input filter-point
     3354     ,output flt-rec-34
     3355     ,output filter-name-34
     3356     ,output where-phrase-34
     3357     ,output sort-phrase-34
     3358     ,output where-phrase-rus-34
     3359     ,output sort-phrase-rus-34
     3360     ).
     3361   if p-open-query then do:
     3362       run set-filter-name in this-procedure
     3363         (INPUT filter-name-34
     3364         ) no-error .
     3365     assign
     3366       l-filter-open-34 = false
     3367     .
     3368     if flt-rec-34 <> ?
     3369       or sort-column-phrase > ""
     3370     then do:
     3371       define variable  parameter-2-34 as character no-undo .
     3372       define variable  parameter-3-34 as character no-undo .
     3373       define variable  parameter-4-34 as character no-undo .
     3374       define variable  parameter-5-34 as character no-undo .
     3375       define variable  parameter-6-34 as character no-undo .
     3376       define variable  parameter-7-34 as character no-undo .
     3377         assign
     3378         parameter-3-34 =
     3379                                 "FOR EACH bar-code"
     3380         parameter-4-34 =
     3381           (
     3382             if (" bar-code.gds-code = buf_goods.gds-code " + " " + where-phrase-34) <> ""
     3383             then  substitute(' bar-code.gds-code = &1 ', buf_goods.gds-code) + " " + where-phrase-34
     3384             else "true"
     3385           )
     3386         parameter-5-34 = (" " + "" + " " + ", EACH chk-gds No-LOCK WHERE chk-gds.b-code = bar-code.b-code, FIRST c-doc No-LOCK WHERE c-doc.doc-code = chk-gds.doc-code")
     3387         parameter-6-34 = if sort-phrase-34 = ''
     3388                              then
     3389           (
     3390           " " + "  " +
     3391             " " + sort-column-phrase +
     3392           " " + " "
     3393           )
     3394                              else
     3395           (
     3396           " " + "  " +
     3397             " " + sort-column-phrase +
     3398           " " + sort-phrase-34
     3399           )
     3400         parameter-7-34 =
     3401           "   "
     3402       .
     3403       do
     3404       on stop undo, leave
     3405       on error undo, leave
     3406       :
     3407         assign
     3408           l-disable-where-34 =
     3409             (" bar-code.gds-code = buf_goods.gds-code " + " " + where-phrase-34 = "")
     3410         .
     3411         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3412                             ,input query br-docs:handle
     3413                             ,input parameter-3-34
     3414                             ,input parameter-4-34
     3415                             ,input parameter-5-34
     3416                             ,input parameter-6-34
     3417                             ,input parameter-7-34
     3418                             )
     3419         .
     3420         assign
     3421           l-filter-open-34 = true
     3422         .
     3423       end.
     3424       if l-filter-open-34 = false then do:
     3425         message
     3426           "Ошибка при фильтрации / сортировке" skip
     3427           "Будут показаны записи без учета фильтра" skip
     3428           view-as alert-box .
     3429       end.
     3430       else do:
     3431           assign
     3432             l-query-was-opened = true
     3433           .
     3434       end.
     3435     end.
     3436     if l-filter-open-34 = false then do:
     3437       OPEN QUERY br-docs FOR EACH bar-code
     3438         where  bar-code.gds-code = buf_goods.gds-code
     3439       , EACH chk-gds No-LOCK WHERE chk-gds.b-code = bar-code.b-code, FIRST c-doc No-LOCK WHERE c-doc.doc-code = chk-gds.doc-code
     3440     .
     3441         assign
     3442           l-query-was-opened = true
     3443         .
     3444     end.
     3445   end.
     3446   else do:
     3447     assign
     3448       v-doc-rec = recid( bar-code )
     3449     .
     3450     do
     3451     on stop undo, leave
     3452     on error undo, leave
     3453     :
     3454       if query br-docs:handle:get-buffer-handle(1) = (buffer chk-gds:handle) then do:
     3455         assign
     3456         parameter-2-34 = (if p-find-next then "true":u else "false":u )
     3457         parameter-4-34 =
     3458           "where ":u +  substitute(' bar-code.gds-code = &1 ', buf_goods.gds-code) + " ":u + where-phrase-34 + " ":u + p-find-condition + " " + ""
     3459         parameter-5-34 = "  "
     3460       .
     3461         run fltopend_fltfindd in this-procedure  (
     3462                             input this-procedure:handle
     3463                             ,input query br-docs:handle
     3464                             ,input rowid(bar-code)
     3465                             ,input logical(parameter-2-34)
     3466                             ,input no-lock
     3467                             ,input (buffer bar-code:handle)
     3468                             ,input parameter-4-34
     3469                             ,input parameter-5-34
     3470                             ) no-error.
     3471         .
     3472         assign
     3473           v-doc-rec = integer(return-value)
     3474           v-fltopend-rowid[1] = ?
     3475         .
     3476       end.
     3477       else do:
     3478         assign
     3479         parameter-2-34 = (if p-find-next then "true":u else "false":u )
     3480         parameter-3-34 =  "FOR EACH bar-code"
     3481         parameter-4-34 =
     3482           (
     3483             if (" bar-code.gds-code = buf_goods.gds-code " + " " + where-phrase-34) <> ""
     3484             then  substitute(' bar-code.gds-code = &1 ', buf_goods.gds-code) + " " + where-phrase-34
     3485             else "true"
     3486           )
     3487         parameter-5-34 = (" " + "" + " " + ", EACH chk-gds No-LOCK WHERE chk-gds.b-code = bar-code.b-code, FIRST c-doc No-LOCK WHERE c-doc.doc-code = chk-gds.doc-code" + " " + p-find-condition)
     3488         parameter-6-34 = if sort-phrase-34 = ''
     3489                              then
     3490           (
     3491           " " + "  " +
     3492             " " + sort-column-phrase +
     3493           " " + " "
     3494           )
     3495                              else
     3496           (
     3497           " " + "  " +
     3498             " " + sort-column-phrase +
     3499           " " + sort-phrase-34
     3500           )
     3501         parameter-7-34 =
     3502           "   "
     3503       .
     3504         run fltopend_fltfindq in this-procedure  (
     3505                             input this-procedure:handle
     3506                             ,input query br-docs:handle
     3507                             ,input logical(parameter-2-34)
     3508                             ,input no-lock
     3509                             ,input parameter-3-34
     3510                             ,input parameter-4-34
     3511                             ,input parameter-5-34
     3512                             ,input parameter-6-34
     3513                             ,input parameter-7-34
     3514                             ,output v-fltopend-rowid
     3515                             ) no-error.
     3516         .
     3517         v-doc-rec = ?.
     3518       end.
     3519       assign
     3520         l-query-was-opened = true
     3521       .
     3522     end.
     3523   end.
     3524         END.
     3525         WHEN 'объект':U THEN DO:
     3526   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3527   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3528     (input  parobj-type
     3529     ,input  parobj-code
     3530     ,output v-print-host-code
     3531     )  .
     3532           ASSIGN
     3533           filter-point = filter-point0 + par-mode
     3534           filter-label = substitute("&1 Один объект", filter-label0)
     3535           .
     3536           if p-open-query then do:
     3537             assign
     3538             frame Dialog-Frame:TITLE = substitute("&1 Объект: &2&3 &4"
     3539                                                         , title0
     3540                                                         , parobj-type
     3541                                                         , parobj-code
     3542                                                         , (if p-chk-type = 0 then '':u else entry (lookup (string(p-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U))
     3543                                                         )
     3544             .
     3545           end.
     3546   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3547   define variable  l-disable-where-37  as logical   no-undo .
     3548   define variable  l-filter-open-37    as logical   .
     3549   define variable  flt-rec-37       as recid     no-undo .
     3550   define variable  filter-name-37      as character no-undo .
     3551   define variable  where-phrase-37     as character no-undo .
     3552   define variable  sort-phrase-37      as character no-undo .
     3553   define variable  where-phrase-rus-37 as character no-undo .
     3554   define variable  sort-phrase-rus-37  as character no-undo .
     3555   run gbl/flt-get.p
     3556     (input filter-point
     3557     ,output flt-rec-37
     3558     ,output filter-name-37
     3559     ,output where-phrase-37
