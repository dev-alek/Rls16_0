     1074   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1075   define new shared temp-table gds-list no-undo like ub.goods
     1076     field qnty   as decimal
     1077     field to-del as logical
     1078     field order-num as integer
     1079     field to-sel as logical
     1080     field promo-code as character
     1081     field ActionId  as int64
     1082     field db-num as integer
     1083     index art  is primary unique artic prod-type prod-code
     1084     index code is         unique gds-code
     1085     index oi order-num
     1086     index isel to-sel
     1087     .
     1088   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1089   define  new shared  temp-table gds-list-hist no-undo
     1090   field list-table as character
     1091   field id as integer
     1092   field line as integer
     1093   field hist-mode as character
     1094   field des as character
     1095   field num-recs as integer
     1096   field option_ as character
     1097   field item_ as character
     1098   field status_ as character
     1099   field num-add as integer
     1100   field num-ignored as integer
     1101   field done as logical
     1102   field err_ as logical
     1103   field err-mes as character
     1104   index pi is primary
     1105   id
     1106   line
     1107   index isdone
     1108   done
     1109   .
     1110   def temp-table gds-bar no-undo
     1111   field b-code like bar-code.b-code
     1112   field qnty   as decimal
     1113   index art is unique b-code .
     1114   DEFINE MENU m-print
     1115          MENU-ITEM m-gds          LABEL "Список строк чеков"
     1116          RULE
     1117          MENU-ITEM m-one-time     LABEL "Игнорировать повторение строк чеков с таким же бар-кодом"
     1118                 TOGGLE-BOX
     1119          MENU-ITEM m-list         LABEL "Список чеков"
     1120          RULE
     1121          MENU-ITEM m-one          LABEL "Чек"
     1122          MENU-ITEM m-spcf         LABEL "Спецификация"  .
     1123   DEFINE MENU MENU-B-del
     1124          MENU-ITEM m_one          LABEL "Один чек"
     1125          MENU-ITEM m_list         LABEL "Список чеков"  .
     1126   DEFINE BUTTON B-del
     1127        LABEL "Искл&ючить"
     1128        SIZE 10 BY 1.
     1129   DEFINE BUTTON B-Help
     1130        LABEL "Помо&щь"
     1131        SIZE 3 BY 1
     1132        BGCOLOR 8 .
     1133   DEFINE BUTTON b-lkp
     1134        LABEL "&Просмотр"
     1135        SIZE 10 BY 1.
     1136   DEFINE BUTTON B-mark
     1137        LABEL "&*"
     1138        SIZE 3 BY 1.
     1139   DEFINE BUTTON b-onlybcode
     1140        LABEL "Этот &БК"
     1141        SIZE 10 BY 1.
     1142   DEFINE BUTTON B-print
     1143        LABEL "Пе&чать"
     1144        SIZE 3 BY 1.
     1145   DEFINE BUTTON b-quit AUTO-END-KEY
     1146        LABEL "&Выход"
     1147        SIZE 10 BY 1
     1148        BGCOLOR 8 .
     1149   DEFINE BUTTON B-sale
     1150        LABEL "П&родажа"
     1151        SIZE 10 BY 1.
     1152   DEFINE BUTTON B-sch
     1153        LABEL "&Фильтр"
     1154        SIZE 3 BY 1.
     1155   DEFINE BUTTON b-sel AUTO-GO
     1156        LABEL "Вы&бор"
     1157        SIZE 10 BY 1
     1158        BGCOLOR 8 .
     1159   DEFINE VARIABLE Cb-chk-type AS CHARACTER FORMAT "X(256)":U
     1160        VIEW-AS COMBO-BOX INNER-LINES 10
     1161        LIST-ITEMS "Item 1"
     1162        DROP-DOWN-LIST
     1163        SIZE 19 BY 1
     1164        BGCOLOR 15  NO-UNDO.
     1165   DEFINE VARIABLE ED-notes AS CHARACTER
     1166        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1167        SIZE 98 BY 2
     1168        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1169   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1170         VIEW-AS TEXT
     1171        SIZE 6 BY 1
     1172        FGCOLOR 4  NO-UNDO.
     1173   DEFINE VARIABLE sch-bcode AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1174        LABEL "бар-коду"
     1175        VIEW-AS FILL-IN
     1176        SIZE 19.1 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1177   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(20)":U
     1178        LABEL "номеру"
     1179        VIEW-AS FILL-IN
     1180        SIZE 19.1 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1181   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U
     1182        LABEL "дате"
     1183        VIEW-AS FILL-IN
     1184        SIZE 11.6 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1185   DEFINE VARIABLE sch-price AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
     1186        LABEL "цене"
     1187        VIEW-AS FILL-IN
     1188        SIZE 19.1 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1189   DEFINE VARIABLE RS-sort AS CHARACTER
     1190        VIEW-AS RADIO-SET HORIZONTAL
     1191        RADIO-BUTTONS
     1192             "Без сортировки/по фильтру", "unsort",
     1193   "По коду чека в БД", "doc-code"
     1194        SIZE 51.9 BY 1.13 NO-UNDO.
     1195   DEFINE QUERY BR-docs FOR
     1196                   bar-code,
     1197                   chk-gds,
     1198                   c-doc SCROLLING.
     1199   DEFINE BROWSE BR-docs
     1200     QUERY BR-docs DISPLAY
     1201         bar-code.b-code FORMAT "999999999":U
     1202     c-doc.office FORMAT "X(7)":U
     1203     mark-string(recid(chk-gds), rid-list) COLUMN-LABEL '*' FORMAT "X(1)":U
     1204     c-doc.doc-code COLUMN-LABEL "Номер_чека" FORMAT "X(20)":U
     1205     entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) COLUMN-LABEL 'Тип_чека' FORMAT "X(8)":U
     1206     chk-gds.line-num COLUMN-LABEL "NN" FORMAT "->>9":U
     1207     c-doc.chk-num COLUMN-LABEL "N_по_кассе" FORMAT "->>>>>>>>9":U
     1208     c-doc.chk-date FORMAT "99/99/9999":U
     1209     (string (c-doc.chk-time, 'HH:MM')) COLUMN-LABEL 'Время'
     1210     chk-gds.doc-qnty FORMAT "->>,>>>,>>9.<<<":U
     1211     chk-gds.price-base FORMAT "->>>,>>>,>>9.99":U
     1212     chk-gds.discnt FORMAT "->>>,>>>,>>9.99":U
     1213     (chk-gds.discnt / chk-gds.price-base * 100) COLUMN-LABEL '%' FORMAT "->>9.<%":U
     1214     (chk-gds.price-base - chk-gds.discnt) COLUMN-LABEL 'Нетто цена' FORMAT "->>>,>>>,>>9.99":U
     1215     chk-gds.pump COLUMN-LABEL 'ТРК' FORMAT ">9":U
     1216     chk-gds.nozzle-code COLUMN-LABEL 'Пист' FORMAT ">>9":U
     1217     chk-gds.loc1 COLUMN-LABEL 'Рез' FORMAT "X(3)":U
     1218     entry (lookup (STRING(chk-gds.WRITE-off-code),  '?,0,1,-6,-9,2,-2,3,-3,-4,17':U), ',,Без_оплаты,Отмена_позиции,Полн_Отмена,Модификатор,Модификатор,Модификатор(+спис),Модификатор(-спис),Модификатор(-спис),Техпролив':U) COLUMN-LABEL 'Код_спис' FORMAT "X(10)":U
     1219     c-doc.shift-date COLUMN-LABEL "Смена_от" FORMAT "99/99/9999":U
     1220     shift-name-no-err(buffer c-doc) COLUMN-LABEL '№_см.' FORMAT "X(6)":U
     1221     c-doc.netto COLUMN-LABEL "Сумма_оплат" FORMAT "->>>,>>>,>>9.99":U
     1222     c-doc.tot-doc COLUMN-LABEL "Сумма_товарная" FORMAT "->>>,>>>,>>9.99":U
     1223     c-doc.discnt COLUMN-LABEL "Скидка_общая" FORMAT "->>>,>>>,>>9.99":U
     1224     c-doc.sub-discnt COLUMN-LABEL "Списания" FORMAT "->>>,>>>,>>9.99":U
     1225     c-doc.pay-desk FORMAT ">>>9":U
     1226     c-doc.cashier FORMAT "99999":U
     1227     c-doc.sales-man COLUMN-LABEL "Прод-w" FORMAT "99999":U
     1228     c-doc.out-code COLUMN-LABEL "Номер_РН" FORMAT "X(14)":U
     1229     c-doc.d-card COLUMN-LABEL "N_диск._карты" FORMAT "X(19)":U
     1230     ENABLE
     1231         c-doc.cashier
     1232       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 14.
     1233   DEFINE FRAME Dialog-Frame
     1234        b-quit AT ROW 1 COL 1
     1235        B-mark AT ROW 1 COL 11
     1236        b-sel AT ROW 1 COL 21
     1237        b-lkp AT ROW 1 COL 31
     1238        b-onlybcode AT ROW 1 COL 41
     1239        B-del AT ROW 1 COL 51
     1240        B-sale AT ROW 1 COL 61
     1241        B-print AT ROW 1 COL 89
     1242        B-sch AT ROW 1 COL 92
     1243        B-Help AT ROW 1 COL 95
     1244        Cb-chk-type AT ROW 2 COL 1 NO-LABEL
     1245        RS-sort AT ROW 2.03 COL 45 NO-LABEL
     1246        BR-docs AT ROW 3.33 COL 1
     1247        ED-notes AT ROW 17.67 COL 1 NO-LABEL
     1248        sch-bcode AT ROW 19.8 COL 17.6 COLON-ALIGNED
     1249        sch-code AT ROW 20.8 COL 17.6 COLON-ALIGNED WIDGET-ID 2
     1250        sch-date AT ROW 20.83 COL 48.3 COLON-ALIGNED WIDGET-ID 4
     1251        sch-price AT ROW 20.83 COL 77.5 COLON-ALIGNED WIDGET-ID 6
     1252        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1253        "Сортировка" VIEW-AS TEXT
     1254             SIZE 12.8 BY .8 AT ROW 2.3 COL 30
     1255             FGCOLOR 4
     1256        "ПОИСК ПО" VIEW-AS TEXT
     1257             SIZE 9.3 BY 1 AT ROW 19.8 COL 1.5
     1258             FGCOLOR 4
     1259        SPACE(88.20) SKIP(1.19)
     1260       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1261            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1262            TITLE ""
     1263            CANCEL-BUTTON b-quit.
     1264   ASSIGN
     1265          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1266          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1267   ASSIGN
     1268          B-del:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-del:HANDLE.
     1269   ASSIGN
     1270          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-print:HANDLE.
     1271   ON ENDKEY OF FRAME Dialog-Frame
     1272   DO:
     1273     if deleted then return "deleted".
     1274   END.
     1275   ON GO OF FRAME Dialog-Frame
     1276   DO:
     1277     if deleted then return "deleted".
     1278   END.
     1279   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1280   DO:
     1281     APPLY "END-ERROR":U TO SELF.
     1282   END.
     1283   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1284   DO:
     1285      if not available c-doc then return no-apply.
     1286    if del-type = "" then do:
     1287       run gbl/pop-up.p ( input b-del:handle, input no) no-error.
     1288       if error-status:error then return no-apply.
     1289    end.
     1290    if del-type = "" then return no-apply.
     1291    run proc-b-del in this-procedure ( input del-type) no-error.
     1292     if error-status:error then do:
     1293       del-type = '':U.
     1294       return no-apply.
     1295   end.
     1296   END.
     1297   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1298   DO:
     1299   define variable next-prev as character no-undo .
     1300     DO WHILE next-prev = '':U:
     1301         if NOT available c-doc then do:
     1302                 message "Неправильно выбран чек." view-as alert-box ERROR.
     1303                 return no-apply.
     1304         end.
     1305         v-doc-rec = recid (c-doc).
     1306         run str/superchk.w (
     1307                         input parparentproc
     1308                         ,input 'ПРОСМОТР':U
     1309                         ,input c-doc.obj-type
     1310                         ,input c-doc.obj-code
     1311                         ,input-output v-doc-rec
     1312                         ,input this-procedure:handle
     1313                         ,input-output next-prev
     1314                                     )
     1315         .
     1316     END .
     1317     reposition br-docs to recid v-doc-rec no-error.
     1318     apply "entry" to br-docs in frame Dialog-Frame.
     1319     apply "value-changed" to br-docs in frame Dialog-Frame.
     1320   END.
     1321   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1322   DO:
     1323   define variable glog as logical no-undo .
     1324       if available chk-gds then do:
     1325   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1326   define variable v-str-recid16 as character no-undo .
     1327   define variable v-num-entry16 as integer   no-undo .
     1328   assign
     1329     v-str-recid16 = trim( string( recid( chk-gds ) , "->>>>>>>>>>>9":U ) )
     1330     v-num-entry16 = lookup( v-str-recid16 , rid-list )
     1331   .
     1332   if v-num-entry16 > 0 then do:
     1333     assign
     1334       entry( v-num-entry16, rid-list ) = "":U
     1335       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1336     .
     1337   end.
     1338   else do:
     1339     assign
     1340       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1341     .
     1342   end.
     1343         glog = br-docs:refresh() .
     1344         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1345             glog = br-docs:select-next-row ().
     1346             apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1347         end.
     1348         if num-entries( rid-list ) = 0
     1349         then
     1350             hide mark-num in frame Dialog-Frame.
     1351         else
     1352             disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     1353       end.
     1354       apply "entry" to br-docs in frame Dialog-Frame.
     1355   END.
     1356   ON CHOOSE OF b-onlybcode IN FRAME Dialog-Frame
     1357   DO:
     1358   DEFINE VARIABLE rid-list as character no-undo .
     1359   if not avail bar-code then return no-apply.
     1360      run ref/gds-chk.w (
     1361                      input parparentproc
     1362                     ,input bar-code.b-code
     1363                     ,input bttns
     1364                     ,input "gds-chks":U + chr(44) + par-mode
     1365                     ,input ?
     1366                     ,input parobj-type
     1367                     ,input parobj-code
     1368                     ,input parout-code
     1369                     ,input pard-card
     1370                     ,output rid-list
     1371                       ).
     1372   END.
     1373   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1374   DO:
     1375   define variable glog as logical no-undo .
     1376   define variable v-doc-rec as recid no-undo .
     1377     def buffer s-doc for ub.trn-doc.
     1378     if not avail chk-gds then do:
     1379       print-type = "":U.
     1380       return no-apply.
     1381     end.
     1382      if print-type = "" then do:
     1383        run gbl/pop-up.p ( input self:handle, input no) no-error.
     1384      end.
     1385      if print-type = "list":U or print-type = "gds":U then do:
     1386         if (par-mode = 'объект':U or par-mode = 'все':U) and index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0 then do:
     1387           CASE print-type:
     1388             when "list":U then do:
     1389                  message "Вы хотите напечатать весь список чеков при невключенном фильтре!" skip
     1390                  "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1391                 WARNING buttons YES-NO update glog.
     1392                 if NOT glog then return no-apply.
     1393             end.
     1394             when "gds":U then do:
     1395                  message "Вы хотите напечатать строки чеков при невключенном фильтре!" skip
     1396                  "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1397                 WARNING buttons YES-NO update glog.
     1398                 if NOT glog then return no-apply.
     1399             end.
     1400           END CASE.
     1401         end.
     1402         v-doc-rec = recid( chk-gds ).
     1403         DO WHILE available chk-gds :
     1404               GET prev br-docs no-lock.
     1405         END.
     1406         CASE print-type:
     1407           when "list":U then do:
     1408             run PrintProc in this-procedure.
     1409           end.
     1410           when "gds":U then do:
     1411             run PrintProcGds in this-procedure.
     1412           end.
     1413        END CASE.
     1414         print-type = "".
     1415         reposition br-docs to recid v-doc-rec no-error.
     1416         apply "entry" to br-docs in frame Dialog-Frame.
     1417       end.
     1418       else do:
     1419           if NOT available c-doc then do:
     1420               message "Неправильно выбран чек." view-as alert-box ERROR.
     1421               return no-apply.
     1422           end.
     1423           CASE print-type:
     1424               when "one":U then do:
     1425                   run str/checkp.p ( input parparentproc, input c-doc.doc-code) no-error.
     1426                   print-type = "".
     1427               end.
     1428               when "spcf":U then do:
     1429                  if can-do( 'т':U, c-doc.office ) AND ( c-doc.d-card <> "" ) then
     1430                  run rep/r-specsr.p ( input parparentproc, input recid( c-doc ), input 'касс':U ) .
     1431                 else
     1432                 message "Чек все еще ошибочный ! " view-as alert-box ERROR.
     1433               end.
     1434           END CASE.
     1435       end.
     1436   END.
     1437   ON CHOOSE OF B-sale IN FRAME Dialog-Frame
     1438   DO:
     1439       if NOT available chk-gds then do:
     1440           message "Неправильно выбран чек." view-as alert-box ERROR.
     1441           return no-apply.
     1442       end.
     1443       FIND find_inkas where
     1444               find_inkas.inkas-code = chk-gds.out-code NO-LOCK no-error.
     1445       if NOT available find_inkas then do:
     1446               message "Для данного чека нет отчета о продаже.".
     1447               return no-apply.
     1448        end.
     1449       run str/ink-lkp.p ( input parparentproc
     1450                    , input recid(find_inkas) ).
     1451   END.
     1452   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1453   DO:
     1454     run proc-b-sch in this-procedure no-error.
     1455     if error-status:error then return no-apply.
     1456   END.
     1457   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1458   DO:
     1459     if ( available chk-gds ) AND ( rid-list = "" ) then
     1460       rid-list = string( recid( chk-gds ) ) .
     1461   END.
     1462   ON ANY-PRINTABLE OF BR-docs IN FRAME Dialog-Frame
     1463   DO:
     1464   DEFINE VARIABLE v-int as integer no-undo .
     1465   assign
     1466   v-int = integer(last-event:label) no-error .
     1467   if not error-status:error then do:
     1468       sch-bcode:screen-value = sch-bcode:screen-value + last-event:label.
     1469       apply "entry" to sch-bcode in frame Dialog-Frame.
     1470   end.
     1471   END.
     1472   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     1473   DO:
     1474     if b-mark:sensitive in frame Dialog-Frame then
     1475     APPLY "CHOOSE" to b-mark.
     1476   END.
     1477   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     1478   DO:
     1479     if b-mark:sensitive in frame Dialog-Frame then
     1480     APPLY "CHOOSE" to b-mark.
     1481       else do:
     1482         if b-sel:sensitive in frame Dialog-Frame then
     1483         APPLY "CHOOSE" to b-sel.
     1484       end.
     1485   END.
     1486   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1487   OR MOUSE-SELECT-DBLCLICK OF BR-docs IN FRAME Dialog-Frame
     1488   DO:
     1489         if b-sel:sensitive in frame Dialog-Frame  = yes then
     1490           apply "choose" to b-sel in frame Dialog-Frame.
     1491       else
     1492           apply "choose" to b-lkp in frame Dialog-Frame.
     1493   END.
     1494   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1495   DO:
     1496       DEFINE VARIABLE dops as character no-undo .
     1497     dops = if available c-doc then c-doc.ps else '':U.
     1498     ED-notes:screen-value = dops.
     1499   END.
     1500   ON VALUE-CHANGED OF Cb-chk-type IN FRAME Dialog-Frame
     1501   DO:
     1502     ASSIGN
     1503     CB-chk-type
     1504     p-chk-type = integer(cb-chk-type)
     1505     .
     1506     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1507   END.
     1508   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1509   DO:
     1510     define buffer ps_chk-doc for ub.chk-doc.
     1511      DO on stop undo, return no-apply:
     1512           FIND PS_chk-doc where recid (ps_chk-doc) = recid(c-doc) exclusive.
     1513           if ps_CHk-doc.PS <> input frame Dialog-Frame ed-notes then
     1514           ps_chk-doc.PS = input frame Dialog-Frame ed-notes.
     1515       END.
     1516   END.
     1517   ON CHOOSE OF MENU-ITEM m-gds
     1518   DO:
     1519       print-type = "gds":U.
     1520       apply "choose" to b-print in frame Dialog-Frame.
     1521   END.
     1522   ON CHOOSE OF MENU-ITEM m-list
     1523   DO:
     1524       print-type = "list":U.
     1525       apply "choose" to b-print in frame Dialog-Frame.
     1526   END.
     1527   ON CHOOSE OF MENU-ITEM m-one
     1528   DO:
     1529       print-type = "one":U.
     1530       apply "choose" to b-print in frame Dialog-Frame.
     1531   END.
     1532   ON VALUE-CHANGED OF MENU-ITEM m-one-time
     1533   DO:
     1534     assign
     1535     v-one-time = menu-item m-one-time:checked in menu m-print.
     1536   END.
     1537   ON CHOOSE OF MENU-ITEM m_list
     1538   DO:
     1539       del-type = "list":U.
     1540       apply "choose" to b-del in frame Dialog-Frame.
     1541   END.
     1542   ON CHOOSE OF MENU-ITEM m_one
     1543   DO:
     1544       del-type = "one":U.
     1545       apply "choose" to b-del in frame Dialog-Frame.
     1546   END.
     1547   ON VALUE-CHANGED OF RS-sort IN FRAME Dialog-Frame
     1548   DO:
     1549     assign
     1550     RS-sort.
     1551     Run OpenBr in this-procedure ( input yes, input no, input '':U).
     1552   END.
     1553   ON CTRL-J OF sch-bcode IN FRAME Dialog-Frame
     1554   DO:
     1555     run proc-find-bcode in this-procedure ( input yes, input string(input frame Dialog-Frame sch-bcode)) no-error.
     1556     if error-status:error then return no-apply.
     1557   END.
     1558   ON RETURN OF sch-bcode IN FRAME Dialog-Frame
     1559   DO:
     1560     run proc-find-bcode in this-procedure ( input no, input string(input frame Dialog-Frame sch-bcode)) no-error.
     1561     if error-status:error then return no-apply.
     1562   END.
     1563   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1564   DO:
     1565     run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1566     if error-status:error then return no-apply.
     1567   END.
     1568   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1569   DO:
     1570     run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1571     if error-status:error then return no-apply.
     1572   END.
     1573   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     1574   DO:
     1575       run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-date) no-error.
     1576     if error-status:error then return no-apply.
     1577   END.
     1578   ON RETURN OF sch-date IN FRAME Dialog-Frame
     1579   DO:
     1580     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-date) no-error.
     1581     if error-status:error then return no-apply.
     1582   END.
     1583   ON CTRL-J OF sch-price IN FRAME Dialog-Frame
     1584   DO:
     1585     run proc-find-price in this-procedure ( input yes, input frame Dialog-Frame sch-price) no-error.
     1586     if error-status:error then return no-apply.
     1587   END.
     1588   ON RETURN OF sch-price IN FRAME Dialog-Frame
     1589   DO:
     1590     run proc-find-price in this-procedure ( input no, input frame Dialog-Frame sch-price) no-error.
     1591     if error-status:error then return no-apply.
     1592   END.
     1593   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1594   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1595   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1596   on help of frame Dialog-Frame
     1597   do:
     1598     run gbl/app_help.p
     1599       (input this-procedure :file-name
     1600       ,input ''
     1601       ,input ?
     1602       ) no-error.
     1603     if error-status :error then do:
     1604       message
     1605         "Ошибка при вызове помощи"
     1606         error-status :get-message(1)
     1607         view-as alert-box .
     1608     end.
     1609   end.
     1610   run minbtn-set in this-procedure .
     1611   on choose of b-help in frame Dialog-Frame
     1612   do:
     1613     apply "help":u to frame Dialog-Frame .
     1614   end.
     1615   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1616   procedure minbtn-set :
     1617       do
     1618           on error undo, return error return-value
     1619           :
     1620           define variable ii              as integer       no-undo .
     1621           define variable fh              as widget-handle no-undo .
     1622           define variable hh              as widget-handle no-undo .
     1623           define variable v-h             as handle        extent 4 no-undo .
     1624           define variable v-name-button   as character     no-undo .
     1625           define variable v-help-old-x    as decimal       no-undo .
     1626           define variable v-help-old-y    as decimal       no-undo .
     1627           define variable v-help-old-size as decimal       no-undo .
     1628           define variable v-frame-width   as decimal       no-undo .
     1629           define variable jj              as integer       no-undo .
     1630           do
     1631               on error undo, return error
     1632               :
     1633               assign
     1634                   v-frame-width = frame Dialog-Frame:width - 0.3
     1635                   fh            = frame Dialog-Frame:first-child
     1636                   hh            = fh:first-child
     1637                   ii            = 1
     1638                   .
     1639               do while valid-handle(hh):
     1640                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1641                   do:
     1642                       case lc(hh:name) :
     1643                           when "b-help" then
     1644                               do:
     1645                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1646                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1647                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1648                                   hh:TOOLTIP = "Помощь" .
     1649                                   v-help-old-x = hh:column .
     1650                                   v-help-old-y = hh:row    .
     1651                                   v-help-old-size = hh:width .
     1652                                   hh:width-chars = 2.5 .
     1653                               end.
     1654                           when "b-print" then
     1655                               do:
     1656                                   hh:load-image("cmp/b-print.bmp":u) .
     1657                                   hh:TOOLTIP = "Печать" .
     1658                                   v-h[ii] = hh:handle .
     1659                                   ii = ii + 1 .
     1660                                   hh:width-chars = 3 .
     1661                               end.
     1662                           when "b-history" or
     1663                           when "b-hist" then
     1664                               do:
     1665                                   hh:load-image("cmp/b-hist.bmp":u) .
     1666                                   hh:TOOLTIP = "История" .
     1667                                   v-h[ii] = hh:handle .
     1668                                   ii = ii + 1 .
     1669                                   hh:width-chars = 3 .
     1670                               end.
     1671                           when "b-sch" then
     1672                               do:
     1673                                   hh:load-image("cmp/b-sch.bmp":u) .
     1674                                   hh:TOOLTIP = "Установка Фильтра" .
     1675                                   v-h[ii] = hh:handle .
     1676                                   ii = ii + 1 .
     1677                                   hh:width-chars = 3 .
     1678                               end.
     1679                           when "b-hist-user" then
     1680                               do:
     1681                                   hh:load-image("cmp/b-hist.bmp":u) .
     1682                                   hh:TOOLTIP = "История пользователя" .
     1683                                   ii = ii + 1 .
     1684                               end.
     1685                       end case.
     1686                   end.
     1687                   hh = hh:next-sibling.
     1688               end.
     1689               b-help:column = v-frame-width - b-help:width-chars.
     1690               jj = 0.
     1691               repeat ii = 4 to 1 by -1 :
     1692                   if valid-handle (v-h[ii] ) then
     1693                   do:
     1694                       jj  = jj + 1 .
     1695                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1696                       v-h[ii]:row    = v-help-old-y .
     1697                   end.
     1698               end.
     1699           end.
     1700       end.
     1701   end procedure.
     1702   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1703   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1704   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1705   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1706   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1707   define variable v-diasize-current-frame-height as decimal   no-undo .
     1708   define variable v-diasize-change-size          as logical   no-undo .
     1709   define variable v-diasize-resize-button        as handle    no-undo .
     1710   define variable v-diasize-wndmax               as logical   no-undo .
     1711   define variable v-diasize-wndstore             as logical   no-undo .
     1712   define variable v-diasize-proc-name            as character no-undo .
     1713   define variable v-diasize-browse-handle        as handle    no-undo .
     1714   define variable v-diasize-browse-number        as integer   no-undo .
     1715   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1716   define temp-table temp-diasize-handle no-undo
     1717     field handle-value  as handle
     1718     field save-position as decimal
     1719     index xpk is primary unique handle-value
     1720     .
     1721   define temp-table temp-browse-handle no-undo
     1722     field browse-type   as character
     1723     field browse-number as integer
     1724     field browse-handle as handle
     1725     field original-size as decimal
     1726     index xpk is primary unique browse-type browse-number
     1727     index xie browse-type browse-handle
     1728   .
     1729   procedure diasize_change-height :
     1730     define input  parameter p-change-value  as decimal   no-undo .
     1731     define input  parameter p-move-resize   as logical   no-undo .
     1732     define variable v-field-group-handle    as handle    no-undo .
     1733     define variable v-object-handle         as handle    no-undo .
     1734     define variable v-frame-height          as decimal   no-undo .
     1735     define variable v-frame-virtual-height  as decimal   no-undo .
     1736     define variable v-browse-height         as decimal   no-undo .
     1737     define variable v-window-height         as decimal   no-undo .
     1738     define variable v-window-virtual-height as decimal   no-undo .
     1739     define variable v-change-sign           as integer   no-undo .
     1740     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1741     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1742     if p-change-value > 0
     1743     then do:
     1744       if frame Dialog-Frame :height + p-change-value
     1745           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1746       then do:
     1747         assign
     1748           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1749                           - (frame Dialog-Frame :height-chars)
     1750         .
     1751         if p-change-value <= 0
     1752         then do:
     1753           run diasize_position-resize-button in this-procedure .
     1754           return .
     1755         end.
     1756       end.
     1757     end.
     1758     if p-change-value < 0
     1759     then do:
     1760       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1761       then do:
     1762         assign
     1763           p-change-value = v-diasize-orig-frame-height
     1764                          - (frame Dialog-Frame :height-chars)
     1765         .
     1766         if p-change-value >= 0
     1767         then do:
     1768           run diasize_position-resize-button in this-procedure .
     1769           return .
     1770         end.
     1771       end.
     1772     end.
     1773     if p-change-value >= 0
     1774     then do:
     1775       assign
     1776         v-change-sign = 1
     1777       .
     1778     end.
     1779     else do:
     1780       assign
     1781         v-change-sign = -1
     1782       .
     1783     end.
     1784     assign
     1785       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1786     .
     1787     if p-change-value = 0
     1788     then do:
     1789       run diasize_position-resize-button in this-procedure .
     1790       return .
     1791     end.
     1792     move_block:
     1793     do
     1794     on error undo move_block, retry move_block
     1795     :
     1796       if retry
     1797       then do:
     1798         do
     1799         on error undo move_block, leave move_block
     1800         :
     1801           if p-change-value > 0
     1802           then do:
     1803             for each buf_temp-diasize-handle
     1804             on error undo, next
     1805             :
     1806               assign
     1807                 v-object-handle = buf_temp-diasize-handle.handle-value
     1808               .
     1809               if v-object-handle <> v-diasize-resize-button
     1810               then do:
     1811                 assign
     1812                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1813                 .
     1814               end.
     1815             end.
     1816             assign
     1817               v-diasize-browse-handle :height = v-browse-height
     1818             .
     1819             for each buf_temp-browse-handle
     1820               where buf_temp-browse-handle.browse-type = 'height':u
     1821             on error undo, next
     1822             :
     1823               assign
     1824                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1825               .
     1826             end.
     1827             assign
     1828               frame Dialog-Frame :height = v-frame-height
     1829             .
     1830             if frame Dialog-Frame :scrollable = true
     1831             then do:
     1832               assign
     1833                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1834               .
     1835             end.
     1836             run diasize_position-resize-button in this-procedure .
     1837           end.
     1838           else do:
     1839             if frame Dialog-Frame :scrollable = true
     1840             then do:
     1841               assign
     1842                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1843               .
     1844             end.
     1845             assign
     1846               frame Dialog-Frame :height = v-frame-height
     1847             .
     1848             assign
     1849               v-diasize-browse-handle :height = v-browse-height
     1850             .
     1851             for each buf_temp-browse-handle
     1852               where buf_temp-browse-handle.browse-type = 'height':u
     1853             on error undo, next
     1854             :
     1855               assign
     1856                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1857               .
     1858             end.
     1859             for each buf_temp-diasize-handle
     1860             on error undo, next
     1861             :
     1862               assign
     1863                 v-object-handle = buf_temp-diasize-handle.handle-value
     1864               .
     1865               if v-object-handle <> v-diasize-resize-button
     1866               then do:
     1867                 assign
     1868                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1869                 .
     1870               end.
     1871             end.
     1872             run diasize_position-resize-button in this-procedure .
     1873           end.
     1874           assign
     1875             v-diasize-change-size = false
     1876           .
     1877           leave move_block .
     1878         end.
     1879       end.
     1880       assign
     1881         v-diasize-need-full-display = true
     1882       .
     1883       if v-diasize-change-size = false
     1884       then do:
     1885         assign
     1886           v-diasize-change-size = true
     1887         .
     1888       end.
     1889       else do:
     1890         return .
     1891       end.
     1892       assign
     1893         v-frame-height = frame Dialog-Frame :height
     1894         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1895         v-browse-height = v-diasize-browse-handle :height
     1896       .
     1897       for each buf_temp-browse-handle
     1898         where buf_temp-browse-handle.browse-type = 'height':u
     1899       :
     1900         assign
     1901           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1902         .
     1903       end.
     1904       for each buf_temp-diasize-handle
     1905       :
     1906         delete buf_temp-diasize-handle .
     1907       end.
     1908       assign
     1909         v-field-group-handle = frame Dialog-Frame :first-child
     1910       .
     1911       do while valid-handle(v-field-group-handle)
     1912       :
     1913         assign
     1914           v-object-handle = v-field-group-handle :first-child
     1915         .
     1916         do while valid-handle(v-object-handle)
     1917         :
     1918           if  v-object-handle <> v-diasize-browse-handle :handle
     1919           and can-query(v-object-handle, "row")
     1920           and can-query(v-object-handle, "height")
     1921           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1922           then do:
     1923             find first buf_temp-browse-handle
     1924               where buf_temp-browse-handle.browse-type   = 'height':u
     1925                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1926               no-error .
     1927             if available buf_temp-browse-handle
     1928             then do:
     1929             end.
     1930             else do:
     1931               create buf_temp-diasize-handle .
     1932               assign
     1933                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1934                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1935               .
     1936             end.
     1937           end.
     1938           assign
     1939             v-object-handle = v-object-handle :next-sibling
     1940           .
     1941         end.
     1942         assign
     1943           v-field-group-handle = v-field-group-handle :next-sibling
     1944         .
     1945       end.
     1946       do with frame Dialog-Frame
     1947       :
     1948         hide v-diasize-resize-button .
     1949         assign
     1950           v-diasize-resize-button :row    = 1
     1951           v-diasize-resize-button :column = 1
     1952         .
     1953       end.
     1954       if p-change-value > 0
     1955       then do:
     1956         if frame Dialog-Frame :scrollable = true
     1957         then do:
     1958           assign
     1959             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1960             no-error .
     1961           if error-status :error
     1962           or error-status :get-message(1) <> ""
     1963           then do:
     1964             undo move_block, retry move_block .
     1965           end.
     1966         end.
     1967         assign
     1968           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1969           no-error .
     1970         if error-status :error
     1971         or error-status :get-message(1) <> ""
     1972         then do:
     1973           undo move_block, retry move_block .
     1974         end.
     1975         assign
     1976           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1977           no-error .
     1978         if error-status :error
     1979         or error-status :get-message(1) <> ""
     1980         then do:
     1981           undo move_block, retry move_block .
     1982         end.
     1983         for each buf_temp-browse-handle
     1984           where buf_temp-browse-handle.browse-type = 'height':u
     1985         on error undo move_block, retry move_block
     1986         :
     1987           assign
     1988             buf_temp-browse-handle.browse-handle :height
     1989               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1990             no-error .
     1991           if error-status :error
     1992           or error-status :get-message(1) <> ""
     1993           then do:
     1994             undo move_block, retry move_block .
     1995           end.
     1996         end.
     1997         for each buf_temp-diasize-handle
     1998         on error undo move_block, retry move_block
     1999         :
     2000           assign
     2001             v-object-handle = buf_temp-diasize-handle.handle-value
     2002           .
     2003           if v-object-handle <> v-diasize-resize-button
     2004           then do:
     2005             assign
     2006               v-object-handle :row = v-object-handle :row + p-change-value
     2007               no-error .
     2008             if error-status :error
     2009             or error-status :get-message(1) <> ""
     2010             then do:
     2011               undo move_block, retry move_block .
     2012             end.
     2013           end.
     2014         end.
     2015       end.
     2016       else do:
     2017         for each buf_temp-diasize-handle
     2018         on error undo move_block, retry move_block
     2019         :
     2020           assign
     2021             v-object-handle = buf_temp-diasize-handle.handle-value
     2022           .
     2023           if v-object-handle <> v-diasize-resize-button
     2024           then do:
     2025             assign
     2026               v-object-handle :row = v-object-handle :row + p-change-value
     2027               no-error .
     2028             if error-status :error
     2029             or error-status :get-message(1) <> ""
     2030             then do:
     2031               undo move_block, retry move_block .
     2032             end.
     2033           end.
     2034         end.
     2035         assign
     2036           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2037           no-error .
     2038         if error-status :error
     2039         or error-status :get-message(1) <> ""
     2040         then do:
     2041           undo move_block, retry move_block .
     2042         end.
     2043         for each buf_temp-browse-handle
     2044           where buf_temp-browse-handle.browse-type = 'height':u
     2045         on error undo move_block, retry move_block
     2046         :
     2047           assign
     2048             buf_temp-browse-handle.browse-handle :height
     2049               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2050             no-error .
     2051           if error-status :error
     2052           or error-status :get-message(1) <> ""
     2053           then do:
     2054             undo move_block, retry move_block .
     2055           end.
     2056         end.
     2057         assign
     2058           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2059           no-error .
     2060         if error-status :error
     2061         or error-status :get-message(1) <> ""
     2062         then do:
     2063           undo move_block, retry move_block .
     2064         end.
     2065         if frame Dialog-Frame :scrollable = true
     2066         then do:
     2067           assign
     2068             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2069             no-error .
     2070           if error-status :error
     2071           or error-status :get-message(1) <> ""
     2072           then do:
     2073             undo move_block, retry move_block .
     2074           end.
     2075         end.
     2076       end.
     2077       if p-move-resize = true
     2078       then do:
     2079         run diasize_position-resize-button in this-procedure .
     2080       end.
     2081       if v-diasize-wndstore = true
     2082       then do:
     2083         if connected("ub") = true
     2084         then do:
     2085           define variable v-cntxt-db-num        as integer   no-undo .
     2086           define variable v-cntxt-userid        as character no-undo .
     2087           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2088                                             , OUTPUT v-cntxt-userid
     2089                                             ) .
     2090           run gbl/wndsizew.p
     2091             (input  v-cntxt-db-num
     2092             ,input  v-cntxt-userid
     2093             ,input  v-diasize-proc-name
     2094             ,input  'height':u
     2095             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2096             ) .
     2097         end.
     2098       end.
     2099     end.
     2100     assign
     2101       v-diasize-change-size = false
     2102     .
     2103   end procedure.
     2104   procedure diasize_set-height :
     2105     define input  parameter p-new-height  as decimal   no-undo .
     2106     define input  parameter p-move-resize as logical   no-undo .
     2107     do
     2108     on error undo, return error return-value
     2109     :
     2110       run diasize_change-height in this-procedure
     2111         (input  (p-new-height - frame Dialog-Frame :height)
     2112         ,input  p-move-resize
     2113         ) .
     2114     end.
     2115   end procedure.
     2116   procedure diasize_change-width :
     2117     define input  parameter p-change-value as decimal   no-undo .
     2118     define input  parameter p-move-resize  as logical   no-undo .
     2119     define variable v-field-group-handle   as handle    no-undo .
     2120     define variable v-object-handle        as handle    no-undo .
     2121     define variable v-frame-width          as decimal   no-undo .
     2122     define variable v-frame-virtual-width  as decimal   no-undo .
     2123     define variable v-browse-width         as decimal   no-undo .
     2124     define variable v-window-width         as decimal   no-undo .
     2125     define variable v-window-virtual-width as decimal   no-undo .
     2126     define variable v-change-sign          as integer   no-undo .
     2127     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2128     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2129     if p-change-value > 0
     2130     then do:
     2131       if frame Dialog-Frame :width + p-change-value >
     2132           session :width-chars
     2133       then do:
     2134         assign
     2135           p-change-value = session :width-chars - frame Dialog-Frame :width
     2136         .
     2137         if p-change-value <= 0
     2138         then do:
     2139           run diasize_position-resize-button in this-procedure .
     2140           return .
     2141         end.
     2142       end.
     2143     end.
     2144     if p-change-value < 0
     2145     then do:
     2146       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2147       then do:
     2148         assign
     2149           p-change-value = v-diasize-orig-frame-width
     2150                          - frame Dialog-Frame :width
     2151         .
     2152         if p-change-value >= 0
     2153         then do:
     2154           run diasize_position-resize-button in this-procedure .
     2155           return .
     2156         end.
     2157       end.
     2158     end.
     2159     if p-change-value >= 0
     2160     then do:
     2161       assign
     2162         v-change-sign = 1
     2163       .
     2164     end.
     2165     else do:
     2166       assign
     2167         v-change-sign = -1
     2168       .
     2169     end.
     2170     assign
     2171       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2172     .
     2173     if p-change-value = 0
     2174     then do:
     2175       run diasize_position-resize-button in this-procedure .
     2176       return .
     2177     end.
     2178     move_block:
     2179     do
     2180     on error undo move_block, leave move_block
     2181     :
     2182       if retry
     2183       then do:
     2184         do
     2185         on error undo move_block, leave move_block
     2186         :
     2187           if p-change-value > 0
     2188           then do:
     2189             for each buf_temp-diasize-handle
     2190             on error undo, next
     2191             :
     2192               assign
     2193                 v-object-handle = buf_temp-diasize-handle.handle-value
     2194               .
     2195               if v-object-handle <> v-diasize-resize-button
     2196               then do:
     2197                 assign
     2198                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2199                 .
     2200               end.
     2201             end.
     2202             assign
     2203               v-diasize-browse-handle :width = v-browse-width
     2204             .
     2205             for each buf_temp-browse-handle
     2206               where buf_temp-browse-handle.browse-type = 'width':u
     2207             on error undo, next
     2208             :
     2209               assign
     2210                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2211               .
     2212             end.
     2213             assign
     2214               frame Dialog-Frame :width = v-frame-width
     2215             .
     2216             if frame Dialog-Frame :scrollable = true
     2217             then do:
     2218               assign
     2219                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2220               .
     2221             end.
     2222             run diasize_position-resize-button in this-procedure .
     2223           end.
     2224           else do:
     2225             if frame Dialog-Frame :scrollable = true
     2226             then do:
     2227               assign
     2228                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2229               .
     2230             end.
     2231             assign
     2232               frame Dialog-Frame :width = v-frame-width
     2233             .
     2234             for each buf_temp-browse-handle
     2235               where buf_temp-browse-handle.browse-type = 'width':u
     2236             on error undo, next
     2237             :
     2238               assign
     2239                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2240               .
     2241             end.
     2242             assign
     2243               v-diasize-browse-handle :width = v-browse-width
     2244             .
     2245             for each buf_temp-diasize-handle
     2246             on error undo, next
     2247             :
     2248               assign
     2249                 v-object-handle = buf_temp-diasize-handle.handle-value
     2250               .
     2251               if v-object-handle <> v-diasize-resize-button
     2252               then do:
     2253                 assign
     2254                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2255                 .
     2256               end.
     2257             end.
     2258             run diasize_position-resize-button in this-procedure .
     2259           end.
     2260           assign
     2261             v-diasize-change-size = false
     2262           .
     2263           leave move_block .
     2264         end.
     2265       end.
     2266       assign
     2267         v-diasize-need-full-display = true
     2268       .
     2269       if v-diasize-change-size = false
     2270       then do:
     2271         assign
     2272           v-diasize-change-size = true
     2273         .
     2274       end.
     2275       else do:
     2276         return .
     2277       end.
     2278       assign
     2279         v-frame-width = frame Dialog-Frame :width
     2280         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2281         v-browse-width = v-diasize-browse-handle :width
     2282       .
     2283       for each buf_temp-browse-handle
     2284         where buf_temp-browse-handle.browse-type = 'width':u
     2285       :
     2286         assign
     2287           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2288         .
     2289       end.
     2290       for each buf_temp-diasize-handle
     2291       :
     2292         delete buf_temp-diasize-handle .
     2293       end.
     2294       assign
     2295         v-field-group-handle = frame Dialog-Frame :first-child
     2296       .
     2297       do while valid-handle(v-field-group-handle)
     2298       :
     2299         assign
     2300           v-object-handle = v-field-group-handle :first-child
     2301         .
     2302         do while valid-handle(v-object-handle)
     2303         :
     2304           if  v-object-handle <> v-diasize-browse-handle :handle
     2305           and v-object-handle <> v-diasize-resize-button
     2306           and can-query(v-object-handle, "row")
     2307           and can-query(v-object-handle, "height")
     2308           and ( v-object-handle :col + v-object-handle :width
     2309                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2310               )
     2311           then do:
     2312             find first buf_temp-browse-handle
     2313               where buf_temp-browse-handle.browse-type   = 'width':u
     2314                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2315               no-error .
     2316             if available buf_temp-browse-handle
     2317             then do:
     2318             end.
     2319             else do:
     2320               create buf_temp-diasize-handle .
     2321               assign
     2322                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2323                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2324               .
     2325             end.
     2326           end.
     2327           assign
     2328             v-object-handle = v-object-handle :next-sibling
     2329           .
     2330         end.
     2331         assign
     2332           v-field-group-handle = v-field-group-handle :next-sibling
     2333         .
     2334       end.
     2335       do with frame Dialog-Frame
     2336       :
     2337         hide v-diasize-resize-button .
     2338         v-diasize-resize-button :row = 1.
     2339         v-diasize-resize-button :column = 1.
     2340       end.
     2341       if p-change-value > 0
     2342       then do:
     2343         if frame Dialog-Frame :scrollable = true
     2344         then do:
     2345           assign
     2346             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2347             no-error .
     2348           if error-status :error
     2349           or error-status :get-message(1) <> ""
     2350           then do:
     2351             undo move_block, retry move_block.
     2352           end.
     2353         end.
     2354         assign
     2355           frame Dialog-Frame :width = v-frame-width + p-change-value
     2356           no-error .
     2357         if error-status :error
     2358         or error-status :get-message(1) <> ""
     2359         then do:
     2360           undo move_block, retry move_block.
     2361         end.
     2362         assign
     2363           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2364         no-error .
     2365         if error-status :error
     2366         or error-status :get-message(1) <> ""
     2367         then do:
     2368           undo move_block, retry move_block.
     2369         end.
     2370         for each buf_temp-browse-handle
     2371           where buf_temp-browse-handle.browse-type = 'width':u
     2372         on error undo move_block, retry move_block
     2373         :
     2374           assign
     2375             buf_temp-browse-handle.browse-handle :width
     2376               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2377             no-error .
     2378           if error-status :error
     2379           or error-status :get-message(1) <> ""
     2380           then do:
     2381             undo move_block, retry move_block .
     2382           end.
     2383         end.
     2384         for each buf_temp-diasize-handle
     2385         on error undo move_block, retry move_block
     2386         :
     2387           assign
     2388             v-object-handle = buf_temp-diasize-handle.handle-value
     2389           .
     2390           if v-object-handle <> v-diasize-resize-button
     2391           then do:
     2392             assign
     2393               v-object-handle :col = v-object-handle :col + p-change-value
     2394               no-error .
     2395             if error-status :error
     2396             or error-status :get-message(1) <> ""
     2397             then do:
     2398               undo move_block, retry move_block .
     2399             end.
     2400           end.
     2401         end.
     2402       end.
     2403       else do:
     2404         for each buf_temp-diasize-handle
     2405         on error undo move_block, retry move_block
     2406         :
     2407           assign
     2408             v-object-handle = buf_temp-diasize-handle.handle-value
     2409           .
     2410           if v-object-handle <> v-diasize-resize-button
     2411           then do:
     2412             assign
     2413               v-object-handle :col = v-object-handle :col + p-change-value
     2414               no-error .
     2415             if error-status :error
     2416             or error-status :get-message(1) <> ""
     2417             then do:
     2418               undo move_block, retry move_block .
     2419             end.
     2420           end.
     2421         end.
     2422         for each buf_temp-browse-handle
     2423           where buf_temp-browse-handle.browse-type = 'width':u
     2424         on error undo move_block, retry move_block
     2425         :
     2426           assign
     2427             buf_temp-browse-handle.browse-handle :width
     2428               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2429             no-error .
     2430           if error-status :error
     2431           or error-status :get-message(1) <> ""
     2432           then do:
     2433             undo move_block, retry move_block .
     2434           end.
     2435         end.
     2436         assign
     2437           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2438           no-error .
     2439         if error-status :error
     2440         or error-status :get-message(1) <> ""
     2441         then do:
     2442           undo move_block, retry move_block.
     2443         end.
     2444         assign
     2445           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2446         no-error .
     2447         if error-status :error
     2448         or error-status :get-message(1) <> ""
     2449         then do:
     2450           undo move_block, retry move_block.
     2451         end.
     2452         if frame Dialog-Frame :scrollable = true
     2453         then do:
     2454           assign
     2455             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2456           no-error .
     2457           if error-status :error
     2458           or error-status :get-message(1) <> ""
     2459           then do:
     2460             undo move_block, retry move_block.
     2461           end.
     2462         end.
     2463       end.
     2464       if p-move-resize
     2465       then do:
     2466         run diasize_position-resize-button in this-procedure .
     2467       end.
     2468       if v-diasize-wndstore = true
     2469       then do:
     2470         if connected("ub") = true
     2471         then do:
     2472           define variable v-cntxt-db-num        as integer   no-undo .
     2473           define variable v-cntxt-userid        as character no-undo .
     2474           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2475                                             , OUTPUT v-cntxt-userid
     2476                                             ) .
     2477           run gbl/wndsizew.p
     2478             (input  v-cntxt-db-num
     2479             ,input  v-cntxt-userid
     2480             ,input  v-diasize-proc-name
     2481             ,input  'width':u
     2482             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2483             ) .
     2484         end.
     2485       end.
     2486     end.
     2487     assign
     2488       v-diasize-change-size = false
     2489     .
     2490   end procedure.
     2491   procedure diasize_set-width :
     2492     define input  parameter p-new-width  as decimal   no-undo .
     2493     define input  parameter p-move-resize as logical   no-undo .
     2494     do
     2495     on error undo, return error return-value
     2496     :
     2497       run diasize_change-width in this-procedure
     2498         (input  (p-new-width - frame Dialog-Frame :width)
     2499         ,input  p-move-resize
     2500         ) .
     2501     end.
     2502   end procedure.
     2503   procedure diasize_position-resize-button :
     2504     do with frame Dialog-Frame
     2505     :
     2506       hide v-diasize-resize-button .
     2507       assign
     2508         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2509                     - 1
     2510                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2511         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2512                     - 1
     2513                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2514       .
     2515       view v-diasize-resize-button .
     2516     end.
     2517   end procedure.
     2518   on alt-right anywhere
     2519   do:
     2520     run diasize_change-width in this-procedure
     2521       (input 1
     2522       ,input true
     2523       ) .
     2524     return no-apply .
     2525   end.
     2526   on alt-left anywhere
     2527   do:
     2528     run diasize_change-width in this-procedure
     2529       (input -1
     2530       ,input true
     2531       ) .
     2532     return no-apply .
     2533   end.
     2534   on alt-down anywhere
     2535   do:
     2536     run diasize_change-height in this-procedure
     2537       (input 1
     2538       ,input true
     2539       ) .
     2540     return no-apply .
     2541   end.
     2542   on alt-up anywhere
     2543   do:
     2544     run diasize_change-height in this-procedure
     2545       (input -1
     2546       ,input true
     2547       ) .
     2548     return no-apply .
     2549   end.
     2550   on alt-enter of frame Dialog-Frame
     2551   do:
     2552     run diasize_maximize in this-procedure
     2553       (input  ?
     2554       ).
     2555     return no-apply .
     2556   end.
     2557   procedure diasize_end-move :
     2558     do
     2559     on error undo, return error return-value
     2560     :
     2561       define variable v-row-delta as decimal   no-undo .
     2562       define variable v-col-delta as decimal   no-undo .
     2563       define variable v-new-row as decimal   no-undo .
     2564       define variable v-new-col as decimal   no-undo .
     2565       assign
     2566         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2567         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2568       .
     2569       assign
     2570         v-row-delta = v-new-row - frame Dialog-Frame :height
     2571         v-col-delta = v-new-col - frame Dialog-Frame :width
     2572       .
     2573       run diasize_change-height in this-procedure
     2574         (input v-row-delta
     2575         ,input true
     2576         ) .
     2577       run diasize_change-width in this-procedure
     2578         (input v-col-delta
     2579         ,input true
     2580         ) .
     2581     end.
     2582   end procedure.
     2583   procedure diasize_maximize :
     2584     define input  parameter p-action as logical   no-undo .
     2585     do
     2586     on error undo, return error return-value
     2587     :
     2588       if p-action = ?
     2589       then do:
     2590         if v-diasize-need-maximize = true
     2591         then do:
     2592           assign
     2593             p-action = true
     2594           .
     2595         end.
     2596         else do:
     2597           assign
     2598             p-action = false
     2599           .
     2600         end.
     2601       end.
     2602       if p-action = true
     2603       then do:
     2604         run diasize_change-height in this-procedure
     2605           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2606               - frame Dialog-Frame :height-chars
     2607           ,input true
     2608           ) .
     2609         run diasize_change-width in this-procedure
     2610           (input session :width-chars
     2611               - frame Dialog-Frame :width-chars
     2612           ,input true
     2613           ) .
     2614         assign
     2615           v-diasize-need-maximize = false
     2616         .
     2617       end.
     2618       else do:
     2619         run diasize_change-width in this-procedure
     2620           (input v-diasize-orig-frame-width
     2621               - frame Dialog-Frame :width-chars
     2622           ,input true
     2623           ) .
     2624         run diasize_change-height in this-procedure
     2625           (input v-diasize-orig-frame-height
     2626               - frame Dialog-Frame :height-chars
     2627           ,input true
     2628           ) .
     2629         assign
     2630           v-diasize-need-maximize = true
     2631         .
     2632       end.
     2633     end.
     2634   end procedure.
     2635   procedure diasize_restore-orig-size :
     2636     do
     2637     on error undo, return error return-value
     2638     :
     2639       assign
     2640         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2641         v-diasize-current-frame-height = frame Dialog-Frame :height
     2642       .
     2643       run diasize_set-height in this-procedure
     2644         (input  v-diasize-orig-frame-height
     2645         ,input  true
     2646         ) .
     2647       run diasize_set-width in this-procedure
     2648         (input  v-diasize-orig-frame-width
     2649         ,input  true
     2650         ) .
     2651     end.
     2652   end procedure.
     2653   procedure diasize_restore-current-size :
     2654     do
     2655     on error undo, return error return-value
     2656     :
     2657       run diasize_set-height in this-procedure
     2658         (input  v-diasize-current-frame-height
     2659         ,input  true
     2660         ) .
     2661       run diasize_set-width in this-procedure
     2662         (input  v-diasize-current-frame-width
     2663         ,input  true
     2664         ) .
     2665     end.
     2666   end procedure.
     2667   procedure diasize_set-browse-handle :
     2668     define input  parameter p-browse-handle as handle   no-undo .
     2669     define buffer buf_temp-browse-handle for temp-browse-handle .
     2670     do
     2671     on error undo, return error return-value
     2672     :
     2673       assign
     2674         v-diasize-browse-handle = p-browse-handle
     2675       .
     2676       for each buf_temp-browse-handle
     2677       on error undo, return error return-value
     2678       :
     2679         delete buf_temp-browse-handle .
     2680       end.
     2681     end.
     2682   end procedure.
     2683   procedure diasize_add_browse :
     2684     define input  parameter p-browse-type   as character no-undo .
     2685     define input  parameter p-browse-handle as handle    no-undo .
     2686     define buffer buf_temp-browse-handle for temp-browse-handle .
     2687     do
     2688     on error undo, return error return-value
     2689     :
     2690       assign
     2691         v-diasize-browse-number = v-diasize-browse-number + 1
     2692       .
     2693       create buf_temp-browse-handle .
     2694       assign
     2695         buf_temp-browse-handle.browse-type   = p-browse-type
     2696         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2697         buf_temp-browse-handle.browse-handle = p-browse-handle
     2698       .
     2699     end.
     2700   end procedure.
     2701   procedure diasize_init :
     2702     define variable v-default-value    as logical   no-undo .
     2703     define variable v-restore-saved    as logical   no-undo .
     2704     define variable v-resize-value-str as character no-undo .
     2705     do
     2706     on error undo, return error return-value
     2707     :
     2708       do with frame Dialog-Frame
     2709       :
     2710         assign
     2711           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2712           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2713           v-diasize-browse-handle     = browse BR-docs :handle
     2714         .
     2715         create button v-diasize-resize-button
     2716         assign
     2717           parent        = frame Dialog-Frame :first-child
     2718           label         = "s"
     2719           height-pixels = 16
     2720           width-pixels  = 16
     2721           visible       = true
     2722           sensitive     = true
     2723           movable       = true
     2724           triggers:
     2725             on end-move persistent run diasize_end-move in this-procedure .
     2726           end triggers.
     2727         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2728         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2729         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2730         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2731         assign
     2732           v-diasize-wndmax = false
     2733         .
     2734         if connected("ub") = true
     2735         then do:
     2736           define variable v-cntxt-db-num        as integer   no-undo .
     2737           define variable v-cntxt-userid        as character no-undo .
     2738           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2739                                             , OUTPUT v-cntxt-userid
     2740                                             ) .
     2741           run gbl/wndpar_r.p
     2742             (input  v-cntxt-db-num
     2743             ,input  v-cntxt-userid
     2744             ,input  'wndmax':U
     2745             ,output v-diasize-wndmax
     2746             ,output v-default-value
     2747             ) .
     2748         end.
     2749         assign
     2750           v-diasize-wndstore = false
     2751         .
     2752         if connected("ub") = true
     2753         then do:
     2754           run gbl/wndpar_r.p
     2755             (input  v-cntxt-db-num
     2756             ,input  v-cntxt-userid
     2757             ,input  'wndstore':U
     2758             ,output v-diasize-wndstore
     2759             ,output v-default-value
     2760             ) .
     2761         end.
     2762         assign
     2763           v-diasize-proc-name = entry(1, program-name(2), '.')
     2764         .
     2765         if v-diasize-wndstore = true
     2766         then do:
     2767           assign
     2768             v-restore-saved = false
     2769           .
     2770           if connected("ub") = true
     2771           then do:
     2772             run gbl/wndsizer.p
     2773               (input  v-cntxt-db-num
     2774               ,input  v-cntxt-userid
     2775               ,input  v-diasize-proc-name
     2776               ,input  'height':u
     2777               ,output v-resize-value-str
     2778               ) .
     2779             if v-resize-value-str <> '':U
     2780             then do:
     2781               run diasize_change-height in this-procedure
     2782                 (input  integer(v-resize-value-str)
     2783                 ,input  true
     2784                 ) .
     2785               assign
     2786                 v-restore-saved = true
     2787               .
     2788             end.
     2789           end.
     2790           if connected("ub") = true
     2791           then do:
     2792             run gbl/wndsizer.p
     2793               (input  v-cntxt-db-num
     2794               ,input  v-cntxt-userid
     2795               ,input  v-diasize-proc-name
     2796               ,input  'width':u
     2797               ,output v-resize-value-str
     2798               ) .
     2799             if v-resize-value-str <> '':U
     2800             then do:
     2801               run diasize_change-width in this-procedure
     2802                 (input  integer(v-resize-value-str)
     2803                 ,input  true
     2804                 ) .
     2805               assign
     2806                 v-restore-saved = true
     2807               .
     2808             end.
     2809           end.
     2810           if v-restore-saved <> true
     2811           then do:
     2812             if v-diasize-wndmax = true
     2813             then do:
     2814               run diasize_maximize in this-procedure
     2815                 (input  true
     2816                 ) .
     2817             end.
     2818           end.
     2819         end.
     2820         else do:
     2821           if v-diasize-wndmax = true
     2822           then do:
     2823             run diasize_maximize in this-procedure
     2824               (input  true
     2825               ) .
     2826           end.
     2827         end.
     2828       end.
     2829     end.
     2830   end procedure.
     2831   procedure diasize_need-full-display :
     2832     define output parameter p-need-full-display as logical   no-undo .
     2833     do
     2834     on error undo, return error return-value
     2835     :
     2836       assign
     2837         p-need-full-display = v-diasize-need-full-display
     2838       .
     2839       assign
     2840         v-diasize-need-full-display = false
     2841       .
     2842     end.
     2843   end procedure.
     2844   procedure get-context :
     2845      define output parameter p-db-num as integer          no-undo.
     2846      define output parameter p-user-id as character        no-undo.
     2847      define variable v-login               as character    no-undo.
     2848      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2849      define buffer buf_user-login  for ub.user-login .
     2850      do
     2851      on error undo, return error
     2852      :
     2853            FIND FIRST buf_sys-ctrl no-lock.
     2854            ASSIGN
     2855               v-login = USERID("ub")
     2856               p-db-num = buf_sys-ctrl.db-num
     2857            .
     2858            FIND FIRST buf_user-login
     2859                 WHERE buf_user-login.db-num = p-db-num
     2860                   AND buf_user-login.user-login = v-login
     2861                 no-lock
     2862                 no-error
     2863                 .
     2864            IF AVAILABLE buf_user-login
     2865            THEN DO:
     2866               assign
     2867                  p-user-id = buf_user-login.user-id
     2868               .
     2869            END.
     2870      end.
     2871   end procedure.
     2872       run diasize_init in this-procedure .
     2873   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
