     5741   PROCEDURE PrintProc :
     5742   DEFINE VARIABLE date_string     as      char    no-undo.
     5743   DEFINE VARIABLE Line                as      char    no-undo.
     5744   DEFINE VARIABLE for-time as char.
     5745   DEFINE VARIABLE accum-count as integer.
     5746   DEFINE VARIABLE accum-tot-doc as decimal.
     5747   DEFINE VARIABLE accum-discnt as decima.
     5748   DEFINE VARIABLE accum-sub-discnt as decimal.
     5749   DEFINE VARIABLE accum-netto as decimal.
