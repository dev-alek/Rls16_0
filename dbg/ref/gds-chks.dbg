      370   define  stream PrnLibStream.
      371   procedure prn-lib-prn-file :
      372     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      373     define input parameter p-DIsabledoptions as integer no-undo .
      374     define variable v-report-name as character no-undo .
      375     define variable v-user-action as character no-undo .
      376     define variable v-printed     as logical   no-undo .
      377     define variable v-exist       as logical   no-undo .
      378     do
      379       on error undo, return error
      380       :
      381       run prn-lib-get-report-name  in this-procedure (
      382         input parParentProc
      383         ,output v-report-name
      384         ).
      385   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      387     (input  v-report-name
      388     ,input  2
      389     ,output v-exist
      390     )  .
      391       if NOT v-exist then
      392       DO:
      393         Message
      394           "Нет заданий на печать ! "
      395           view-as alert-box .
      396         Return  .
      397       End.
      398       run gbl/prnfilen.w
      399         (input  ""
      400         ,input  p-DisabledOptions
      401         ,input  string(v-report-name )
      402         ,input  7
      403         ,output v-user-action
      404         ,output v-printed
      405         ) .
      406       if v-printed then
      407       do:
      408         return "YES" .
      409       end.
      410       else
      411       do:
      412         return "NO" .
      413       end.
      414     end.
      415   end procedure.
      416   procedure prn-lib-open-stream :
      417     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      418     define input parameter p-page-size    as integer no-undo .
      419     define input parameter p-is-stream    as logical no-undo .
      420     define input parameter p-append       as logical no-undo .
      421     define variable v-report-name as character no-undo .
      422     do
      423       on error undo, return error
      424       :
      425       run prn-lib-get-report-name  in this-procedure (
      426         input parParentProc
      427         ,output v-report-name
      428         ).
      429       if p-is-stream then
      430       do:
      431         if p-append then
      432         do:
      433           output stream PrnLibStream to value( v-report-name )
      434             page-size value(p-page-size) append .
      435         end.
      436         if not p-append then
      437         do:
      438           output stream PrnLibStream to value( v-report-name )
      439             page-size value(p-page-size) .
      440         end.
      441       end.
      442       if not p-is-stream then
      443       do:
      444         if p-append then
      445         do:
      446           output to value( v-report-name )
      447             page-size value(p-page-size) append .
      448         end.
      449         if not p-append then
      450         do:
      451           output to value( v-report-name )
      452             page-size value(p-page-size) .
      453         end.
      454       end.
      455     end.
      456   end procedure.
      457   procedure prn-lib-open-exp :
      458     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      459     define input parameter p-is-stream    as logical no-undo .
      460     define input parameter p-is-append    as logical no-undo .
      461     define output parameter p-ReportFileName as char init "report" no-undo.
      462     define output parameter p-process as logical no-undo .
      463     define variable glog as logical no-undo .
      464     do
      465       on error undo, return error
      466       :
      467       SYSTEM-DIALOG GET-FILE p-ReportFileName
      468         TITLE      "Укажите путь"
      469         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      470         ASK-OVERWRITE
      471         CREATE-TEST-FILE
      472         SAVE-AS
      473         USE-FILENAME
      474         DEFAULT-EXTENSION "txt"
      475         UPDATE glog
      476         .
      477       if not glog then  return.
      478       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      479       if p-is-stream then
      480       do:
      481         if p-is-append then
      482         do:
      483           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      484         end.
      485         else
      486         do:
      487           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      488         end.
      489       end.
      490       else
      491       do:
      492         if p-is-append then
      493         do:
      494           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      495         end.
      496         else
      497         do:
      498           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      499         end.
      500       end.
      501       p-process = yes.
      502     end.
      503   end procedure.
      504   procedure prn-lib-get-report-name :
      505     define input parameter parParentProc  as widget-handle no-undo.
      506     define output parameter p-report-name as character no-undo .
      507     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      508   end procedure.
      509   procedure prn-lib-reportviewer-report-name :
      510     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      511     define input parameter p-report-name-html as character no-undo .
      512     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      513   end procedure.
      514   procedure prn-lib-reportviewer :
      515     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      516     define input parameter p-report-name-html as character no-undo .
      517     define input parameter p-param        as character no-undo .
      518     define variable v-excel           as character no-undo init 'TRUE' .
      519     define variable v-value-character as character no-undo .
      520     define variable v-value-integer   as character no-undo .
      521     define variable v-value-date      as date      no-undo .
      522     define variable v-value-decimal   as decimal   no-undo .
      523     define variable rep-excel         as logical   no-undo .
      524     define variable excel-string      as character no-undo .
      525     define variable v-param-type      as character no-undo .
      526     define variable v-tth             as handle    no-undo .
      527     run adm/shattri.p (
      528       input "get":U
      529       ,input  ""
      530       ,input  0
      531       ,input  'report-glob':U
      532       ,input  'rep-excel':U
      533       ,output v-value-character
      534       ,output v-value-date
      535       ,output v-value-decimal
      536       ,output v-value-integer
      537       ,output rep-excel
      538       ,output v-param-type
      539       ,INPUT-OUTPUT table-handle v-tth
      540       )  .
      541     if rep-excel then v-excel = "TRUE" .
      542     else v-excel = "FALSE" .
      543     if p-param eq ""
      544     then
      545        p-param = "EXCEL:" + v-excel.
      546     else
      547        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      548     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      549   end procedure.
      550   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      551   procedure fltfield-clear :
      552     define output parameter loc-fld as character no-undo.
      553     define output parameter loc-lab as character no-undo .
      554     define output parameter loc-spr as character no-undo .
      555     define output parameter loc-dim as character no-undo .
      556     assign
      557       loc-fld = ""
      558       loc-lab = ""
      559       loc-spr = ""
      560       loc-dim = "0"
      561     .
      562   end procedure .
      563   procedure fltfield-add :
      564     define input        parameter par-fld as character no-undo.
      565     define input        parameter par-lab as character no-undo .
      566     define input        parameter par-spr as character no-undo .
      567     define input-output parameter loc-fld as character no-undo.
      568     define input-output parameter loc-lab as character no-undo .
      569     define input-output parameter loc-spr as character no-undo .
      570     define input-output parameter loc-dim as character no-undo .
      571     do
      572     on error undo, return error
      573     :
      574       assign
      575       loc-fld = if loc-dim = '0'
      576                 then par-fld
      577                 else (loc-fld + chr(44) + par-fld)
      578       loc-lab = if loc-dim = '0'
      579                 then par-lab
      580                 else (loc-lab + chr(44) + par-lab)
      581       loc-spr = if loc-dim = '0'
      582                 then par-spr
      583                 else (loc-spr + chr(44) + par-spr)
      584       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      585                 string(integer(if num-entries(loc-dim) > 1
      586                               then entry(2, loc-dim)
      587                               else entry(1, loc-dim)
      588                               ) + 1)
      589       no-error
      590       .
      591     end.
      592   end procedure.
      593   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      594   define variable v-waitfram-action01         as character   no-undo .
      595   define variable v-waitfram-action02         as character   no-undo .
      596   define variable v-waitfram-action03         as character   no-undo .
      597   define variable mWaitFramTextBeg            as character   no-undo.
      598   define variable mWaitFramTextEnd            as character   no-undo.
      599   define variable mWaitFramView               as logical     no-undo.
      600   define variable mWaitProcEvent              as logical     no-undo init yes.
      601   define variable mWaitFramInterval           as integer     no-undo init 1 .
      602   define variable mWaitFramStop               as logical     no-undo.
      603   define variable mWaitFramStopUser           as logical     no-undo.
      604   define variable mWaitFramStopTimeOut        as logical     no-undo.
      605   define variable mWaitFramStartProc          as datetime-tz no-undo.
      606   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      607   define button B-WaitFramStop auto-end-key
      608        label "Стоп"
      609        size 10 by 1 tooltip "Остоновить процесс".
      610   define button B-viewProcInfo
      611        label "Информация"
      612        size 15 by 1 tooltip "Информация о процесс".
      613   define frame waitfram
      614     v-waitfram-action01 format "x(72)" no-label skip
      615     v-waitfram-action02 format "x(72)" no-label skip
      616     v-waitfram-action03 format "x(72)" no-label skip
      617     B-viewProcInfo
      618     B-WaitFramStop at row 4 col 30
      619     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      620     .
      621   define new global shared variable mBatchMode as logical no-undo init ?.
      622   define variable mFramBachModHandle as handle no-undo.
      623   mFramBachModHandle = frame waitfram:handle.
      624   define variable mFameOldVis as logical no-undo.
      625   define variable mVisCUrentVin as logical no-undo.
      626   if session:batch-mode
      627   then
      628      mBatchMode = yes.
      629   if mBatchMode = ? then do:
      630     mVisCUrentVin = current-window:visible.
      631     mFameOldVis = mFramBachModHandle:visible.
      632     mFramBachModHandle:visible  = yes.
      633     mBatchMode = mFramBachModHandle:visible ne yes.
      634     mFramBachModHandle:visible = mFameOldVis.
      635     current-window:visible = mVisCUrentVin.
      636   end.
      637    if  log-manager:logfile-name ne ?
      638     then DO:
      639         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      640         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      641         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      642     end.
      643   on choose of B-WaitFramStop in frame waitfram
      644   do:
      645     mWaitFramStop = yes.
      646     mWaitFramStopUser = yes.
      647   end.
      648   function waitfram-check-timeout returns logical():
      649      define variable vtime as int64 no-undo.
      650      if mWaitFramStopTimeOut
      651      then
      652         return yes.
      653      vtime = ( now - mWaitFramStartProc ) / 1000 .
      654      if     mWaitFramTimeOut ne ?
      655         and mWaitFramTimeOut ne 0
      656         and mWaitFramTimeOut lt vtime
      657      then do:
      658         mWaitFramStopTimeOut = yes.
      659      end.
      660      return mWaitFramStopTimeOut.
      661   end.
      662   procedure waitfram-hide :
      663     if not session:batch-mode
      664     then do
      665     on error undo, return error return-value
      666     :
      667       pause 0 before-hide .
      668       if not mBatchMode then
      669         hide frame waitfram .
      670     if     not mWaitFramView
      671        and mWaitProcEvent
      672     then
      673       process events .
      674     end.
      675   end procedure.
      676   procedure waitfram-show :
      677     define input  parameter p-message as character no-undo .
      678     define variable v-left-margin as integer   no-undo .
      679     if not session:batch-mode
      680     then do
      681     on error undo, return error return-value
      682     :
      683       if length(p-message) <= 70 then do:
      684         assign
      685           v-left-margin = integer((70 - length(p-message)) / 2)
      686         .
      687         assign
      688           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      689         .
      690         assign
      691           v-waitfram-action01 = " "
      692           v-waitfram-action02 = " "
      693                                    + fill(" ", v-left-margin)
      694                                    + p-message
      695           v-waitfram-action03 = " "
      696         .
      697       end.
      698       else do:
      699         define variable vRindex1 as integer no-undo.
      700         define variable vRindex2 as integer no-undo.
      701         vRindex1 = r-index(p-message," ",70).
      702         if vRindex1 = 0
      703         then
      704            vRindex1 = 70.
      705         if length(p-message)  <= vRindex1 + 70 then do:
      706           assign
      707             v-waitfram-action01 = " "
      708             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      709             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      710           .
      711         end.
      712         else do:
      713           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      714           if vRindex2 <= vRindex1
      715           then
      716              vRindex2 = vRindex1 + 70.
      717           assign
      718             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      719             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      720             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      721           .
      722         end.
      723       end.
      724       B-viewProcInfo:visible   in frame waitfram = no.
      725       B-viewProcInfo:sensitive in frame waitfram = no.
      726       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      727       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      728       if  (   mWaitFramView
      729          or  mWaitProcEvent)
      730          and not mBatchMode
      731       then
      732          display
      733             v-waitfram-action01 skip
      734             v-waitfram-action02 skip
      735             v-waitfram-action03 skip
      736          with frame waitfram .
      737       if     mWaitFramView
      738          then do:
      739             if     mWaitFramInterval ne ?
      740                and not mBatchMode
      741             then
      742                wait-for go of frame waitfram pause mWaitFramInterval.
      743          end.
      744          else
      745             if     mWaitProcEvent
      746                and not mBatchMode
      747             then
      748                process events .
      749     end.
      750   end procedure.
      751      procedure waitfram-show-this:
      752         define input  parameter iInterval as int64 no-undo.
      753         define variable vtime as int64 no-undo.
      754         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      755         mWaitFramInterval = iInterval.
      756         run waitfram-show (substitute("&1&2 &3&4" ,
      757                                       mWaitFramTextBeg ,
      758                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      759                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      760                                       mWaitFramTextEnd
      761                                      )
      762                           ).
      763      end.
      764      procedure WaitFramRunPause:
      765         define input  parameter iInterval as dec no-undo.
      766         define variable vStart  as datetime-tz no-undo.
      767         define variable vend    as datetime-tz no-undo.
      768         define variable vint as int64 no-undo.
      769         define variable vOk as logical no-undo.
      770         vStart = now.
      771         vend   = vStart.
      772         publish "WaitFramPause" (iInterval,output vOk).
      773         vend   =  now.
      774         vint = vend - vStart.
      775         vint = iInterval - vint / 1000.
      776         if     not mWaitFramStop
      777            and (   vint > 0
      778                 or (    not vOk
      779                     and iInterval eq ?
      780                     )
      781                 )
      782         then
      783            run waitfram-show-this (iInterval).
      784         vend   =  now.
      785         vint = vend - vStart.
      786         vint = iInterval - vint / 1000.
      787         if     not mWaitFramStop
      788            and vint > 0
      789         then do:
      790            run gbl/pause.p (vint * 1000).
      791         end.
      792         if iInterval ne ?
      793         then
      794            publish "WaitFramStop".
      795         waitfram-check-timeout().
      796      end.
      797      procedure WaitFramWaitFor:
      798         define input  parameter iInterval as dec no-undo.
      799         assign
      800            mWaitFramStartProc   = now
      801            mWaitFramStopUser    = no
      802            mWaitFramStopTimeOut = no
      803         .
      804         block-wait:
      805         do while not mWaitFramStop:
      806            run WaitFramRunPause (iInterval).
      807            if  waitfram-check-timeout()
      808            then do:
      809               leave block-wait.
      810            end.
      811         end.
      812         run waitfram-hide.
      813      end.
      814   procedure waitfram-join :
      815     define input  parameter p-line-1  as character no-undo .
      816     define input  parameter p-line-2  as character no-undo .
      817     define input  parameter p-line-3  as character no-undo .
      818     define output parameter p-message as character no-undo .
      819     do
      820     on error undo, return error return-value
      821     :
      822       assign
      823         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      824                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      825                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      826       .
      827     end.
      828   end procedure.
      829   function waitfram-join-function returns character
      830     (input p-line-1 as character
      831     ,input p-line-2 as character
      832     ,input p-line-3 as character
      833     ).
      834     define variable v-message as character no-undo .
      835     run waitfram-join in this-procedure
      836       (input  p-line-1
      837       ,input  p-line-2
      838       ,input  p-line-3
      839       ,output v-message
      840       ) .
      841     return v-message .
      842   end function .
      843   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      844   FUNCTION mark-string RETURNS CHARACTER
      845     ( input p-recid as recid, input mark-list as character  ) :
      846     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      847   END FUNCTION.
      848   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      849   define new global shared variable g#lib-trn  as handle no-undo .
      850   define new global shared variable g#lib-trn2 as handle no-undo .
      851   define new global shared variable g#lib-trn3 as handle no-undo .
      852   define new global shared variable g#lib-trn4 as handle no-undo .
      853   function shift-name-no-err return char (
      854                                           buffer loc-chk-doc for ub.chk-doc
      855    ).
      856   define variable varshift-name as character no-undo.
      857   define variable varshift-name-num as character no-undo.
      858     varshift-name = loc-chk-doc.shift-name.
      859   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      860   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnme in g#lib-trn3 ( input  loc-chk-doc.obj-type,
      861                          input  loc-chk-doc.obj-code,
      862                          input  loc-chk-doc.shift-date,
      863                          input  loc-chk-doc.shift-num,
