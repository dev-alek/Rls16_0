     5753   define variable v-header-base-curr as character no-undo .
     5754   define variable v-base-code like ub.sysconf.host-code no-undo .
     5755   define variable v-base-type like ub.currency.curr-abbr no-undo .
     5756   define variable v-receipt-name as character no-undo .
     5757   define buffer buf_currency for ub.currency.
     5758   if v-curr-r-b = 'base':U then do:
     5759     if v-print-host-code <> 0 then do:
     5760   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5761   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5762     (input  v-print-host-code
     5763     ,output v-base-code
     5764     )  .
     5765       find first buf_currency where
     5766               buf_currency.curr-code = v-base-code.
     5767       assign
     5768       v-base-type = buf_currency.curr-abbr.
     5769     end.
     5770   end.
     5771   assign
     5772   v-header-base-curr = string( "( Б.Вал. - " + caps( v-base-type ) + " )" )
     5773   .
     5774   DEFINE FRAME Chk-List
     5775   c-doc.office        column-label "Тип"    format "X(8)"
     5776   chk-gds.b-code      column-label "Бар-код"
     5777   c-doc.doc-code      column-label "Номер_чека/Номер_строки"  format "X(23)"
     5778   v-receipt-name      column-label "Тип_чека" format "X(8)"
     5779   c-doc.chk-num       column-label "N_касс" format "->>>>>>9"
     5780   c-doc.chk-date      column-label "Дата" format "99/99/9999"
     5781   for-time            column-label "Время"   format "X(5)"
     5782   c-doc.shift-date    column-label "Смена_от" format "99/99/9999"
     5783   v-shift-name-num    column-label "№_см." FORMAT "X(6)"
     5784   c-doc.tot-doc       column-label "Сумма_товарная"
     5785   c-doc.discnt        column-label "Скидка_общая"
     5786   c-doc.sub-discnt    column-label "Списания"
     5787   c-doc.netto         column-label "Сумма_оплат"
     5788   c-doc.pay-desk      column-label "Касса"
     5789   c-doc.cashier       column-label "Кассир"       format ">>>>9"
     5790   c-doc.sales-man     column-label "Прод-ц"       format ">>>>9"
     5791   c-doc.out-code      column-label "Номер_РН"
     5792   c-doc.d-card        column-label "Номер_диск.карты" format "X(16)"  space(0)
     5793   HEADER  date_string AT 5 format "X(35)"
     5794   v-header-base-curr        format "X(20)"
     5795   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5796   Line format "X(198)" AT 1
     5797   with width 232 down stream-io use-text    .
     5798   Line = fill("-", 198).
     5799   date_string = cur-time-print() .
     5800   run prn-lib-open-stream  in this-procedure (
     5801                                                input parParentProc
     5802                                               ,input 43
     5803                                               ,input yes
     5804                                               ,input no
     5805                                               ).
     5806   PUT  STREAM PrnLibStream
     5807   ( frame Dialog-Frame:title )
     5808   format "x(198)" SKIP(1) .
     5809   FORM HEADER
     5810   Line format "X(198)" AT 1 SKIP
     5811   "Продолжение - на следующей странице" AT 30 SKIP
     5812   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5813   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5814   FORM with FRAME Chk-List  .
     5815   run waitfram-show in this-procedure ( input "Ждите...").
     5816   GET next br-docs no-lock .
     5817   assign
     5818   v-doc-code = chk-gds.doc-code
     5819   v-b-code = chk-gds.b-code
     5820   .
     5821   DO WHILE available chk-gds :
     5822     if v-one-time = no OR
     5823       v-doc-code <> chk-gds.doc-code
     5824       OR v-b-code <> chk-gds.b-code
     5825       then do:
     5826       Display STREAM PrnLibStream
     5827       c-doc.office
     5828       chk-gds.b-code
     5829       (if v-one-time
     5830       then c-doc.doc-code
     5831       else (string(c-doc.doc-code, "X(20)") + chr(32) + string(chk-gds.line-num, "-99"))) @ c-doc.doc-code
     5832       entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) @ v-receipt-name
     5833       c-doc.chk-num
     5834       c-doc.chk-date
     5835       string(c-doc.chk-time, "HH:mm") @ for-time
     5836       c-doc.shift-date
     5837       shift-name-no-err(buffer c-doc) @ v-shift-name-num
     5838       c-doc.tot-doc
     5839       c-doc.discnt
     5840       c-doc.sub-discnt
     5841       c-doc.netto
     5842       c-doc.pay-desk
     5843       c-doc.cashier
     5844       c-doc.sales-man
     5845       if c-doc.out-code <> ? then c-doc.out-code else "" @ c-doc.out-code
     5846       c-doc.d-card
     5847       with FRAME Chk-List .
     5848       DOWN STREAM PrnLibStream 1 with FRAME CHk-List  .
     5849       assign
     5850       accum-count = accum-count + 1
     5851       accum-tot-doc = accum-tot-doc + c-doc.tot-doc
     5852       accum-discnt = accum-discnt + c-doc.discnt
     5853       accum-sub-discnt = accum-sub-discnt + c-doc.sub-discnt
     5854       accum-netto = accum-netto + c-doc.netto.
     5855     end.
     5856     assign
     5857     v-doc-code = chk-gds.doc-code
     5858     v-b-code = chk-gds.b-code
     5859     .
     5860     GET next br-docs no-lock.
     5861   END.
     5862   if v-one-time then do:
     5863     UNDERLINE  STREAM PrnLibStream
     5864     c-doc.office
     5865     chk-gds.b-code
     5866     c-doc.doc-code
     5867     v-receipt-name
     5868     c-doc.chk-num
     5869     c-doc.chk-date
     5870     for-time
     5871     c-doc.shift-date
     5872     v-shift-name-num
     5873     c-doc.tot-doc
     5874     c-doc.discnt
     5875     c-doc.sub-discnt
     5876     c-doc.netto
     5877     c-doc.pay-desk
     5878     c-doc.cashier
     5879     c-doc.sales-man
     5880     c-doc.out-code
     5881     c-doc.d-card
     5882     with FRAME Chk-List .
     5883     DISPLAY STREAM PrnLibStream
     5884     "ИТОГО"  @ c-doc.doc-code
     5885     accum-count @ c-doc.chk-num
     5886     "_" @ c-doc.chk-date
     5887     "_ " @ for-time
     5888     "_" @ c-doc.shift-date
     5889     "______" @ v-shift-name-num
     5890     accum-tot-doc @ c-doc.tot-doc
     5891     accum-discnt @ c-doc.discnt
     5892     accum-sub-discnt @ c-doc.sub-discnt
     5893     accum-netto @ c-doc.netto
     5894     with frame Chk-List.
     5895   end.
     5896   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5897   HIDE  STREAM PrnLibStream FRAME CheckList.
     5898   output  STREAM PrnLibStream CLOSE.
     5899   run waitfram-hide in this-procedure .
     5900   run prn-lib-prn-file in this-procedure (
     5901                                             input parParentProc
     5902                                             ,input 8
     5903                                             ).
     5904   END PROCEDURE.
     5905   PROCEDURE PrintProcGds :
     5906   DEFINE VARIABLE date_string     as      char    no-undo.
     5907   DEFINE VARIABLE Line                as      char    no-undo.
     5908   DEFINE VARIABLE for-time as char no-undo.
     5909   DEFINE VARIABLE accum-count as integer no-undo.
     5910   DEFINE VARIABLE accum-qnty as decimal no-undo.
     5911   DEFINE VARIABLE accum-tot-doc as decimal no-undo.
     5912   DEFINE VARIABLE accum-discnt as decimal no-undo.
     5913   DEFINE VARIABLE accum-netto as decimal no-undo.
     5914   DEFINE VARIABLE fgds-discnt-pc as decimal no-undo.
     5915   DEFINE VARIABLE for-gds-price like ub.chk-gds.price-base no-undo.
     5916   DEFINE VARIABLE for-gds-brutto like ub.chk-doc.netto no-undo.
     5917   DEFINE VARIABLE for-gds-netto like ub.chk-doc.netto no-undo.
     5918   DEFINE VARIABLE for-gds-discnt like ub.chk-doc.netto no-undo.
     5919   define variable v-write-off as logical no-undo .
     5920   define variable v-header-base-curr as character no-undo .
     5921   define variable v-base-code like ub.sysconf.host-code no-undo .
     5922   define variable v-base-type like ub.currency.curr-abbr no-undo .
     5923   define buffer buf_currency for ub.currency.
     5924   if v-curr-r-b = 'base':U then do:
     5925     if v-print-host-code <> 0 then do:
     5926   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5927   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5928     (input  v-print-host-code
     5929     ,output v-base-code
     5930     )  .
     5931       find first buf_currency where
     5932               buf_currency.curr-code = v-base-code.
     5933       assign
     5934       v-base-type = buf_currency.curr-abbr.
     5935     end.
     5936   end.
     5937   assign
     5938   v-header-base-curr = string( "( Б.Вал. - " + caps( v-base-type ) + " )" )
     5939   .
     5940   DEFINE FRAME Goods-Frame
     5941   chk-gds.b-code
     5942   chk-gds.doc-code column-label "Номер_чека" FORMAT "X(18)"
     5943   chk-gds.line-num column-label "NN" format "-99"
     5944   chk-gds.is-error COLUMN-LABEL "Ош" FORMAT "+/ "
     5945   chk-gds.src-code Column-label "Код в спул-файле" FORMAT "X(16)"
     5946   chk-gds.pump column-label "ТРК"
     5947   chk-gds.nozzle-code column-label "Пист"
     5948   chk-gds.loc1 column-label "Рез"
     5949   chk-gds.doc-qnty
     5950   chk-gds.price-base
     5951   chk-gds.discnt
     5952   fgds-discnt-pc COLUMn-LABEL "% ск."  FORMAT "->9.99%"
     5953   for-gds-price COLUMN-LABEL "Цена нетто"
     5954   v-write-off COLUMn-LABEL "Сп" FORMAT "+/"
     5955   chk-gds.road-tax
     5956   for-gds-brutto COLUMN-LABEL "Сумма брутто"
     5957   for-gds-discnt COLUMN-LABEL "Сумма скидки"
     5958   for-gds-netto COLUMN-LABEL "Сумма нетто"
     5959   HEADER  date_string AT 5 format "X(35)"
     5960   v-header-base-curr        format "X(20)"
     5961   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5962    Line format 198 AT 1
     5963   with width 232 down stream-io use-text .
     5964   Line = fill("-", 198).
     5965   date_string = cur-time-print() .
     5966   run prn-lib-open-stream  in this-procedure (
     5967                                                input parParentProc
     5968                                               ,input 43
     5969                                               ,input yes
     5970                                               ,input no
     5971                                               ).
     5972   PUT  STREAM PrnLibStream
     5973   (frame Dialog-Frame:title + chr(32) + "- строки чеков")
     5974   format "x(190)" SKIP(1) .
     5975   FORM HEADER
     5976   Line format "X(230)" AT 1 SKIP
     5977   "Продолжение - на следующей странице" AT 30 SKIP
     5978   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5979   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5980   FORM with FRAME Goods-Frame  .
     5981   run waitfram-show in this-procedure ( input "Ждите...").
     5982   GET next br-docs no-lock.
     5983   DO WHILE available chk-gds :
     5984       assign
     5985       fgds-discnt-pc = (chk-gds.discnt / (chk-gds.price-base + chk-gds.price-service) * 100)
     5986       for-gds-price = chk-gds.price-base + chk-gds.price-service - chk-gds.discnt
     5987       for-gds-brutto = (chk-gds.price-base + chk-gds.price-service) * chk-gds.doc-qnty
     5988       for-gds-discnt = chk-gds.discnt * chk-gds.doc-qnty
     5989       for-gds-netto = (chk-gds.price-base + chk-gds.price-service - chk-gds.discnt) * chk-gds.doc-qnty
     5990       .
     5991       DISPLAY Stream PrnLibStream
     5992       chk-gds.b-code
     5993       chk-gds.doc-code
     5994       chk-gds.line-num
     5995       chk-gds.is-error
     5996       chk-gds.src-code
     5997       chk-gds.pump
     5998       chk-gds.nozzle-code
     5999       chk-gds.loc1
     6000       chk-gds.doc-qnty
     6001       (chk-gds.price-base + chk-gds.price-service) @ chk-gds.price-base
     6002       chk-gds.discnt
     6003       fgds-discnt-pc
     6004       for-gds-price
     6005       (if chk-gds.write-off-code <> ?
     6006       and chk-gds.write-off-code <> 0
     6007       then yes
     6008       else no
     6009       )  @ v-write-off
     6010       chk-gds.road-tax
     6011       for-gds-brutto
     6012       for-gds-discnt
     6013       for-gds-netto
     6014       WITH FRAME Goods-Frame.
     6015       DOWN STREAM PrnLibStream with FRAME Goods-Frame .
     6016       assign
     6017       accum-count = accum-count + 1
     6018       accum-qnty = accum-qnty + chk-gds.doc-qnty
     6019       accum-tot-doc = accum-tot-doc + chk-gds.doc-qnty * (chk-gds.price-base + price-service)
     6020       accum-discnt = accum-discnt + chk-gds.doc-qnty * chk-gds.discnt
     6021       accum-netto = accum-netto + chk-gds.doc-qnty * (chk-gds.price-base + chk-gds.price-service - chk-gds.discnt)
     6022       .
     6023     GET next br-docs no-lock.
     6024   END.
     6025   UNDERLINE  STREAM PrnLibStream
     6026   chk-gds.b-code
     6027   chk-gds.doc-code
     6028   chk-gds.line-num
     6029   chk-gds.is-error
     6030   chk-gds.src-code
     6031   chk-gds.pump
     6032   chk-gds.nozzle-code
     6033   chk-gds.loc1
     6034   chk-gds.doc-qnty
     6035   chk-gds.price-base
     6036   chk-gds.discnt
     6037   fgds-discnt-pc
     6038   for-gds-price
     6039   v-write-off
     6040   chk-gds.road-tax
     6041   for-gds-brutto
     6042   for-gds-discnt
     6043   for-gds-netto
     6044   with FRAME Goods-Frame .
     6045   DISPLAY STREAM PrnLibStream
     6046   "ИТОГО"  @ chk-gds.doc-code
     6047   "_" @ chk-gds.line-num
     6048   "_" @ chk-gds.is-error
     6049   string(accum-count) @ chk-gds.src-code
     6050   ACCUM-qnty @ chk-gds.doc-qnty
     6051   "__" @ chk-gds.pump
     6052   "___" @ chk-gds.nozzle-code
     6053   "___" @ chk-gds.loc1
     6054   "_" @ chk-gds.price-base
     6055   "_" @ chk-gds.discnt
     6056   "_" @ fgds-discnt-pc
     6057   "_" @ for-gds-price
     6058   "_" @ v-write-off
     6059   "_" @ chk-gds.road-tax
     6060   accum-tot-doc @ for-gds-brutto
     6061   accum-discnt @ for-gds-discnt
     6062   accum-netto @ for-gds-netto
     6063   WITH FRAME Goods-Frame.
     6064   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     6065   HIDE  STREAM PrnLibStream FRAME Goods-Frame.
     6066   output  STREAM PrnLibStream CLOSE.
     6067   run waitfram-hide in this-procedure .
     6068   run prn-lib-prn-file in this-procedure (
     6069                                             input parParentProc
     6070                                             ,input 8
     6071                                             ).
     6072   END PROCEDURE.
     6073   PROCEDURE proc-b-del :
     6074   define input parameter del-type as character no-undo.
     6075   define variable old-netto as decimal no-undo.
     6076   define  variable old-tot-doc as decimal no-undo.
     6077   define  variable old-discnt as decimal no-undo.
     6078   define variable glog as logical no-undo .
     6079   define buffer buf_inkas for ub.inkas .
     6080   define buffer del_chk-doc for ub.chk-doc.
     6081   IF par-mode = 'продажа':U then do:
     6082   CASE del-type:
     6083      when "list":U then do:
     6084           if index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0 then do:
     6085          message
     6086          "Вы хотите исключить ВСЕ чеки с данным товаром из продажи!" skip
     6087          "Эта процедура может занять долгое время! Продолжать?"
     6088          view-as alert-box WARNING buttons YES-NO update glog.
     6089          if NOT glog then return error.
     6090        end.
     6091        ELSE DO:
     6092          message
     6093          "Вы действительно хотите исключить ВСЕ чеки с данным товаром по текущему списку из продажи?!" skip
     6094          view-as alert-box WARNING buttons YES-NO update glog.
     6095          if NOT glog then return error.
     6096        END.
     6097         DO WHILE available c-doc :
     6098               GET prev br-docs no-lock.
     6099         END.
     6100         GET next br-docs.
     6101         _list0:
     6102         DO WHILE available c-doc
     6103         on error undo, next _list0
     6104         on stop undo, next _list0
     6105         :
     6106           v-doc-rec = recid( c-doc ).
     6107           FIND FIRST del_chk-doc where
     6108                             recid (del_chk-doc) = v-doc-rec No-ERROR.
     6109           if not avail del_chk-doc then NEXT _list0.
     6110           if del_chk-doc.out-code <> ? then DO  :
     6111             run waitfram-show in this-procedure ( input "Ждите...").
     6112             FIND FIRST buf_inkas No-LOCK WHERE
     6113                             buf_inkas.inkas-code = del_chk-doc.out-code No-ERROR.
     6114             assign
     6115             old-netto = buf_inkas.netto
     6116             old-tot-doc = buf_inkas.tot-doc
     6117             old-discnt = buf_inkas.discnt.
     6118             run str/excl-chk.p (
     6119                                 input parparentproc
     6120                               , input v-curr-r-b
     6121                               , buffer del_chk-doc) no-error.
     6122             if error-status:error OR
     6123             buf_inkas.netto <> old-netto  - del_chk-doc.netto OR
     6124             buf_inkas.tot-doc <> old-tot-doc  - del_chk-doc.tot-doc OR
     6125             buf_inkas.discnt <> old-discnt - del_chk-doc.discnt then do:
     6126               message
     6127               substitute("Исключение чека &1 из продажи &2 не удалось:&3&4 &5"
     6128                           ,del_chk-doc.doc-code
     6129                           ,buf_inkas.inkas-code
     6130                           , chr(10)
     6131                           ,error-status:get-message(1)
     6132                           ,return-value
     6133                           )
     6134               view-as alert-box ERROR.
     6135               undo, NEXT.
     6136             end.
     6137             deleted = yes.
     6138           END.
     6139           GET next br-docs.
     6140         END.
     6141         run waitfram-hide in this-procedure .
     6142         del-type = "".
     6143         RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6144         APPLY "page-UP"   to br-docs.
     6145         APPLY "page-down"   to br-docs.
     6146         reposition br-docs to row 1 no-error.
     6147         apply "entry" to br-docs in frame Dialog-Frame.
     6148      end.
     6149      when "one":U then do:
     6150       if c-doc.out-code <> ? then do:
     6151       v-doc-rec = recid (c-doc).
     6152          FIND FIRST del_chk-doc where
     6153                     recid (del_chk-doc) = v-doc-rec No-ERROR.
     6154          if not avail del_chk-doc then return error.
     6155          FIND FIRST buf_inkas No-LOCK WHERE
     6156                     buf_inkas.inkas-code = del_chk-doc.out-code No-ERROR.
     6157          assign
     6158          old-netto = buf_inkas.netto
     6159          old-tot-doc = buf_inkas.tot-doc
     6160          old-discnt = buf_inkas.discnt.
     6161          del-type = "".
     6162          run str/excl-chk.p (
     6163                             input parparentproc
     6164                           , input v-curr-r-b
     6165                           , buffer del_chk-doc) no-error.
     6166          if error-status:error  OR
     6167          buf_inkas.netto <> old-netto  - del_chk-doc.netto OR
     6168          buf_inkas.tot-doc <> old-tot-doc  - del_chk-doc.tot-doc OR
     6169          buf_inkas.discnt <> old-discnt - del_chk-doc.discnt then do:
     6170           message
     6171           substitute("Исключение чека &1 из продажи &2 не удалось:&3&4 &5"
     6172                       ,del_chk-doc.doc-code
     6173                       ,buf_inkas.inkas-code
     6174                       , chr(10)
     6175                       ,error-status:get-message(1)
     6176                       ,return-value
     6177                       )
     6178           view-as alert-box ERROR.
     6179            return error.
     6180          end.
     6181          deleted = yes.
     6182          RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6183          APPLY "page-UP"   to br-docs in frame Dialog-Frame.
     6184          APPLY "page-down"   to br-docs in frame Dialog-Frame.
     6185       end.
     6186     end.
     6187   END CASE.
     6188   end.
     6189   END PROCEDURE.
     6190   PROCEDURE proc-b-sch :
     6191   assign
     6192     tbl = 'bar-code'
     6193     join-tbl = 'bar-code'
     6194     fld = ""
     6195     lab = ""
     6196     spr = ""
     6197     dim = '0'
     6198     .
     6199   run fltfield-add in this-procedure('b-code', '', '',
     6200   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6201   run fltfield-add in this-procedure('in-code', 'Номер ПН', '',
     6202   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6203   run fltfield-add in this-procedure('unit-cli', 'Ед.изм', '',
     6204   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6205   run fltfield-add in this-procedure('part-code', 'Номер партии', '',
     6206   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6207   Filter-Block:
     6208   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     6209       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     6210       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     6211     run gbl/filter.w ( INPUT parparentproc
     6212                      , INPUT (filter-point + chr(4) + filter-label)
     6213                      , INPUT tbl
     6214                      , INPUT join-tbl
     6215                      , INPUT fld
     6216                      , INPUT lab
     6217                      , INPUT spr
     6218                      , INPUT dim ).
     6219     if return-value = 'undo':U then return error.
     6220     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6221   END.
     6222   END PROCEDURE.
     6223   PROCEDURE proc-find-bcode :
     6224   define input parameter par-next as logical no-undo.
     6225   define input parameter parb-code as character no-undo .
     6226   display
     6227   "  /  /":U @ sch-date
     6228   0 @ sch-price
     6229   "" @ sch-code
     6230   with frame Dialog-Frame.
     6231   run OpenBr in this-procedure (
     6232        input false
     6233       ,input par-next
     6234       ,input substitute("and bar-code.b-code = &1 "
     6235         , parb-code)
     6236       ).
     6237   apply "entry":u to sch-bcode in frame Dialog-Frame .
     6238   END PROCEDURE.
     6239   PROCEDURE proc-find-code :
     6240   define input parameter par-next as logical no-undo.
     6241   define input parameter pardoc-code like ub.chk-doc.doc-code no-undo.
     6242   display
     6243   "  /  /":U @ sch-date
     6244   0 @ sch-price
     6245   0 @ sch-bcode
     6246   with frame Dialog-Frame.
     6247   assign
     6248   pardoc-code = chr(34) + pardoc-code + chr(34).
     6249   run OpenBr in this-procedure (
     6250        input false
     6251       ,input par-next
     6252       ,input substitute("and chk-gds.doc-code   begins &1 "
     6253         , pardoc-code)
     6254       ).
     6255   apply "entry":u to sch-code in frame Dialog-Frame .
     6256   END PROCEDURE.
     6257   PROCEDURE proc-find-date :
     6258   define input parameter par-next as logical no-undo.
     6259   define input parameter parchk-date like ub.chk-doc.chk-date no-undo.
     6260   define variable varchk-datechr as character no-undo.
     6261   display
     6262   '':U @ sch-code
     6263   0 @ sch-price
     6264   0 @ sch-bcode
     6265   with frame Dialog-Frame.
     6266   assign
     6267   varchk-datechr = string(day(parchk-date)) + chr(47) +
     6268                    string(month(parchk-date)) + chr(47) +
     6269                    string(year(parchk-date)).
     6270   run OpenBr in this-procedure (
     6271      input false
     6272     ,input true
     6273     ,input substitute("and chk-gds.chk-date = &1 "
     6274       , varchk-datechr)
     6275     ).
     6276   apply "entry":u to sch-date in frame Dialog-Frame.
     6277   END PROCEDURE.
     6278   PROCEDURE proc-find-price :
     6279   define input parameter par-next as logical no-undo.
     6280   define input parameter par-price-base like ub.chk-gds.price-base no-undo.
     6281   display
     6282   "  /  /":U @ sch-date
     6283   "":U @ sch-code
     6284   0 @ sch-bcode
     6285   with frame Dialog-Frame.
     6286   run OpenBr in this-procedure (
     6287        input false
     6288       ,input par-next
     6289       ,input substitute("and chk-gds.price-base = &1 "
     6290         , par-price-base)
     6291       ).
     6292   apply "entry":u to sch-price in frame Dialog-Frame .
     6293   END PROCEDURE.
     6294   PROCEDURE reposition-chk-doc :
     6295   define input  parameter p-direction   as character no-undo .
     6296   define output parameter p-chk-doc-recid as recid no-undo .
     6297   define variable v-chk-gds-recid  as recid no-undo .
     6298     case p-direction :
     6299       when "first":U
     6300       then do:
     6301         get first br-docs.
     6302       end.
     6303       when "last":U
     6304       then do:
     6305         get last br-docs.
     6306       end.
     6307       when "prev":U
     6308       then do:
     6309         get prev br-docs.
     6310         if not available c-doc then do:
     6311           message
     6312           "Это первый чек списка"
     6313           view-as alert-box.
     6314         end.
     6315       end.
     6316       when "next":U
     6317       then do:
     6318         get next br-docs.
     6319         if not available c-doc then do:
     6320           message
     6321           "Это последний чек списка"
     6322           view-as alert-box.
     6323         end.
     6324       end.
     6325     end case .
     6326     assign
     6327     p-chk-doc-recid = recid(c-doc)
     6328     v-chk-gds-recid = recid (chk-gds)
     6329     .
     6330     run reposition-query in this-procedure
     6331       (input v-chk-gds-recid
     6332       ).
     6333   END PROCEDURE.
     6334   PROCEDURE reposition-query :
     6335   define input parameter p-recid as recid no-undo .
     6336     if p-recid <> ?
     6337     then do:
     6338       reposition br-docs to recid p-recid no-error.
     6339     end.
     6340     do with frame Dialog-Frame:
     6341       apply "entry":u to browse BR-docs .
     6342       apply "VALUE-CHANGED":u to browse BR-docs .
     6343     end.
     6344   END PROCEDURE.
