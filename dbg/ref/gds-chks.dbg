       18   define input parameter parout-code like ub.chk-doc.out-code no-undo.
       19   define input parameter pard-card like ub.chk-doc.d-card no-undo.
       20   define output param rid-list    as  char no-undo .
       21   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       22   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       23   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       24   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       25   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
