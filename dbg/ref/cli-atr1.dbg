      367   define variable v-deleted as logical no-undo .
      368   define variable v-err-mess as character no-undo .
      369   define variable v-attr-type as character no-undo .
      370   define variable v-attr-format as character no-undo .
      371   define variable v-attr-label as character no-undo .
      372   define variable v-attr-user-can-edit as logical no-undo .
      373   define variable v-attr-output-display as logical no-undo .
      374   define variable v-attr-other as char no-undo .
      375   define buffer buf_clients-attr for ub.clients-attr.
      376   define buffer buf_clients for ub.clients.
      377   _main:
      378   do
      379   on error undo, return error return-value
      380   :
      381     find first buf_clients no-lock where
      382             buf_clients.obj-type = p-obj-type
      383        AND  buf_clients.obj-code = p-obj-code no-error .
      384     if not available buf_clients then do:
      385       undo, return error substitute("&1 &2 &3&4Не найден клиент с типом &5 кодом 6"
      386                                    , vss-workfile
      387                                    , vss-revision
      388                                    , vss-description
      389                                    , chr(10)
      390                                    , p-obj-type
      391                                    , p-obj-code
      392                                    ).
      393     end.
      394     FOR EACH tt0-clients-attr:
      395         find FIRST buf_clients-attr WHERE
      396                 buf_clients-attr.obj-type = p-obj-type
      397             AND buf_clients-attr.obj-code = p-obj-code
      398             AND buf_clients-attr.attr-code = tt0-clients-attr.attr-code no-error.
      399       IF not available buf_clients-attr
      400       or buf_clients-attr.attr-value <> tt0-clients-attr.attr-value
      401       THEN DO:
      402         run clntattr-code in this-procedure (
      403                                                   input  tt0-clients-attr.attr-code
      404                                                   ,output v-attr-type
      405                                                   ,output v-attr-format
      406                                                   ,output v-attr-label
      407                                                   ,output v-attr-user-can-edit
      408                                                   ,output v-attr-output-display
      409                                                   ,output v-attr-other
      410                                                ).
      411         if v-attr-user-can-edit then do:
      412           run clntattr-write IN THIS-PROCEDURE(
      413                                               INPUT p-obj-type
      414                                               ,INPUT p-obj-code
      415                                               ,INPUT tt0-clients-attr.attr-code
      416                                               ,INPUT tt0-clients-attr.attr-value) NO-ERROR.
      417           IF ERROR-STATUS:ERROR THEN DO:
      418             assign
      419             v-err-mess = substitute("Ошибка при сохранении атрибута клиента &1 &2 &3 :&4&5 &6"
      420                                     , p-obj-type
      421                                     , p-obj-code
      422                                     , tt0-clients-attr.attr-code
      423                                     , chr(10)
      424                                     ,error-status:get-message(1)
      425                                     ,return-value).
      426             undo _main, return error v-err-mess.
      427           END.
      428         end.
      429         else do:
      430           undo, return error substitute("Ошибка при сохранении атрибута клиента &1 &2 &3 :&4атрибут не может быть изменен вручную"
      431                                     , p-obj-type
      432                                     , p-obj-code
      433                                     , tt0-clients-attr.attr-code
      434                                     , chr(10)).
      435         end.
      436       END.
      437     END.
      438     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      439       FOR EACH buf_clients-attr where
      440               buf_clients-attr.obj-type = p-obj-type
      441           AND buf_clients-attr.obj-code = p-obj-code       :
      442           FIND FIRST tt0-clients-attr NO-LOCK WHERE
      443               tt0-clients-attr.obj-type = p-obj-type
      444           AND tt0-clients-attr.obj-code = buf_clients-attr.obj-code
      445           AND tt0-clients-attr.attr-code = buf_clients-attr.attr-code NO-ERROR.
      446         IF NOT AVAILABLE tt0-clients-attr THEN DO:
      447           run clntattr-code in this-procedure (
      448                                                     input  buf_clients-attr.attr-code
      449                                                     ,output v-attr-type
      450                                                     ,output v-attr-format
      451                                                     ,output v-attr-label
      452                                                     ,output v-attr-user-can-edit
      453                                                     ,output v-attr-output-display
      454                                                     ,output v-attr-other
      455                                                 ).
      456           if v-attr-user-can-edit then do:
      457               ASSIGN
      458               v-deleted = NO.
      459               RUN clntattr-delete  IN THIS-PROCEDURE (
      460                                                     input buf_clients-attr.obj-type
      461                                                     ,input buf_clients-attr.obj-code
      462                                                     ,INPUT buf_clients-attr.attr-code
      463                                                     ,output v-deleted ) NO-ERROR.
      464             IF NOT v-deleted
      465             or error-status:error
      466             THEN DO:
      467               assign
      468               v-err-mess = substitute("Ошибка при удалении атрибута клиента &1 &2 &3 :&4&5 &6"
      469                                       , buf_clients-attr.obj-type
      470                                       , buf_clients-attr.obj-code
      471                                       , buf_clients-attr.attr-code
      472                                       , chr(10)
      473                                       ,error-status:get-message(1)
      474                                       ,return-value
      475                                       ).
      476               undo _main, return error v-err-mess.
      477             END.
      478           end.
      479           else do:
      480             if v-attr-output-display then do:
      481               undo, return error substitute("Ошибка при удалении атрибута клиента &1 &2 &3 :&4атрибут не может быть удален вручную"
      482                                         , p-obj-type
      483                                         , p-obj-code
      484                                         , buf_clients-attr.attr-code
      485                                         , chr(10)).
      486             end.
      487           end.
      488         END.
      489       END.
      490     end.
      491   end.
