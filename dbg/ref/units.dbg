      622           and can-query(v-object-handle, "row")
      623           and can-query(v-object-handle, "height")
      624           and ( v-object-handle :row > v-diasize-browse-handle :row )
      625           then do:
      626             find first buf_temp-browse-handle
      627               where buf_temp-browse-handle.browse-type   = 'height':u
      628                 and buf_temp-browse-handle.browse-handle = v-object-handle
      629               no-error .
