      631             then do:
      632             end.
      633             else do:
      634               create buf_temp-diasize-handle .
      635               assign
      636                 buf_temp-diasize-handle.handle-value  = v-object-handle
      637                 buf_temp-diasize-handle.save-position = v-object-handle :row
      638               .
      639             end.
      640           end.
      641           assign
      642             v-object-handle = v-object-handle :next-sibling
      643           .
      644         end.
      645         assign
      646           v-field-group-handle = v-field-group-handle :next-sibling
      647         .
      648       end.
      649       do with frame d-units
      650       :
      651         hide v-diasize-resize-button .
      652         assign
      653           v-diasize-resize-button :row    = 1
      654           v-diasize-resize-button :column = 1
      655         .
      656       end.
      657       if p-change-value > 0
      658       then do:
      659         if frame d-units :scrollable = true
      660         then do:
      661           assign
      662             frame d-units :virtual-height = frame d-units :virtual-height + p-change-value
      663             no-error .
      664           if error-status :error
      665           or error-status :get-message(1) <> ""
      666           then do:
      667             undo move_block, retry move_block .
      668           end.
      669         end.
      670         assign
      671           frame d-units :height = frame d-units :height + p-change-value
      672           no-error .
