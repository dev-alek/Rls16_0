      141        LABEL "Помощь"
      142        SIZE 10 BY 1 TOOLTIP "Помощь".
      143   DEFINE BUTTON B-hist
      144        LABEL "Ис&тория"
      145        SIZE 10 BY 1.
      146   DEFINE QUERY br-units FOR ub.units SCROLLING.
      147   DEFINE BROWSE br-units QUERY br-units NO-LOCK DISPLAY
      148         ub.units.unit-name
      149         ub.units.long-name FORMAT "X(30)"
      150         (IF (ub.units.type = "" ) THEN ("") ELSE (entry (lookup (ENTRY(1,units.type), 'шту,дро,сер,вес,топ,2ед,прп,доп,сте':U), 'штучный,дробный,серийный,весовой,топливо,2едизма,прпарт,дополнительный,стеклопосуда':U) + if num-entries(units.type) > 1  then (',':U + entry (lookup (entry(2,units.type), 'шту,дро,сер,вес,топ,2ед,прп,доп,сте':U), 'штучный,дробный,серийный,весовой,топливо,2едизма,прпарт,дополнительный,стеклопосуда':U)) else '':U)) COLUMN-LABEL "Описание типа" FORMAT "x(30)"
      151         ub.units.type FORMAT "X(12)"
      152         ub.units.OKEI COLUMn-LABEL "Код!ОКЕИ" format "9999"
      153         mKKT COLUMN-LABEL "Код!ККТ" FORMAT ">>>>9"
      154         mText COLUMN-LABEL "Текст!в чеке ККТ" FORMAT "X(10)"
      155       WITH SEPARATORS
      156              size 86.25 by 12.58
      157            .
      158   DEFINE FRAME d-units
      159        br-units at row 2.5 col 3
      160        b-exit at row 1 col 1
      161        b-select at row 1 col 11
      162        b-add-unit at row 1 col 21
      163        b-change at row 1 col 31
      164        B-hist AT ROW 1 COL 41
      165        b-help at row 1 col 61
      166       WITH VIEW-AS DIALOG-BOX
      167            SIDE-LABELS THREE-D
      168            SCROLLABLE size 91.88 by 16.25
      169            TITLE "ЕДИНИЦЫ  ИЗМЕРЕНИЯ":L.
      170   ASSIGN
      171          FRAME d-units:SCROLLABLE       = FALSE.
      172   ON ROW-DISPLAY OF br-units IN FRAME d-units
      173   DO:
      174      define buffer code for code.
      175      assign
      176         mKKT  = 255
      177         mText = "-".
      178      find first code where
      179                 code.parent = "okei-kkt"
      180             and int(code.code)  = units.OKEI
      181             and code.status_ = 0
      182      no-lock no-error.
      183      if avail code then
      184         assign
      185            mKKT  = integer(code.CodeName)
      186            mText = code.misc1
      187            mKKT:bgcolor  in browse br-units = 10
      188            mText:bgcolor in browse br-units = 10
      189            .
      190      else
      191         assign
      192            mKKT:bgcolor  in browse br-units = 14
      193            mText:bgcolor in browse br-units = 14
      194           .
      195   END.
      196   ON CHOOSE OF b-add-unit IN FRAME d-units
      197   DO:
      198   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   do:
      200     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      201       (input  ibs.th.gbl.gbl-var:g#db-num
      202       ,input  ibs.th.gbl.gbl-var:g#userid
      203       ,input  0
      204       ,input  'actn_unit_update':U
      205       ,input  'global':U
      206       ,input  0
      207       ,input  '':U
      208       ,input  0
      209       ,input  0
      210       ,input  0
      211       ,input  0
      212       ,input  true
      213       ,output glog
      214       )  .
      215   end.
      216   if NOT glog then return no-apply .
      217   ri = ?.
      218   run ref/unitsi.w (
      219                   input parparentproc
      220                 , input 'ДОБАВЛЕНИЕ':U
      221                 , "":U
      222                 , input-output ri).
      223   if ri <> ? then  do:
      224       OPEN QUERY br-units FOR EACH ub.units NO-LOCK.
      225       reposition br-units to recid ri.
      226       apply "ENTRY" to br-units.
      227   end.
      228   END.
      229   ON CHOOSE OF b-change IN FRAME d-units
      230   DO:
      231   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      232   do:
      233     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      234       (input  ibs.th.gbl.gbl-var:g#db-num
      235       ,input  ibs.th.gbl.gbl-var:g#userid
      236       ,input  0
      237       ,input  'actn_unit_update':U
      238       ,input  'global':U
      239       ,input  0
      240       ,input  '':U
      241       ,input  0
      242       ,input  0
      243       ,input  0
      244       ,input  0
      245       ,input  true
      246       ,output glog
      247       )  .
      248   end.
      249   if NOT glog then  return no-apply .
      250   if available ub.units then  do:
      251     ri = recid( units ) .
      252     run ref/unitsi.w (
      253                   input parparentproc
      254                 , input 'ИЗМЕНЕНИЕ':U
      255                 , units.unit-name
      256                 , input-output ri ).
      257     OPEN QUERY br-units FOR EACH ub.units NO-LOCK.
      258     reposition br-units to recid ri.
      259     apply "ENTRY" to br-units.
      260   end.
      261   END.
      262   ON CHOOSE OF B-hist IN FRAME d-units
      263   DO:
      264     DEFINE VARIABLE v-rid-list AS CHARACTER NO-undo.
      265       IF AVAILABLE ub.units THEN DO:
      266         run ref/c-units.w (
      267                        INPUT parparentproc
      268                       ,INPUT '':U
      269                       ,INPUT 'one':U
      270                       ,INPUT units.unit-name
      271                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      272     END.
      273   END.
      274   ON CHOOSE OF b-select IN FRAME d-units
      275   DO:
      276       if available ub.units then
      277           do:
      278               units-rid = recid( units).
      279               apply  "GO" to FRAME d-units.
      280           end.
      281   END.
      282   ON DEFAULT-ACTION OF br-units IN FRAME d-units
      283   DO:
      284       if as-ref then
      285           do:
      286                   apply "CHOOSE":U to b-select.
      287           end.
      288   END.
      289   ON RETURN OF br-units IN FRAME d-units
      290   DO:
      291       if as-ref then
      292           do:
      293                   apply "CHOOSE":U to b-select.
      294           end.
      295   END.
      296   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED
      297   THEN CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      298   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   on help of frame d-units
      300   do:
      301     run gbl/app_help.p
      302       (input this-procedure :file-name
      303       ,input ''
      304       ,input ?
      305       ) no-error.
      306     if error-status :error then do:
      307       message
      308         "Ошибка при вызове помощи"
      309         error-status :get-message(1)
      310         view-as alert-box .
      311     end.
      312   end.
      313   run minbtn-set in this-procedure .
      314   on choose of b-help in frame d-units
      315   do:
      316     apply "help":u to frame d-units .
      317   end.
      318   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      319   procedure minbtn-set :
      320       do
      321           on error undo, return error return-value
      322           :
      323           define variable ii              as integer       no-undo .
      324           define variable fh              as widget-handle no-undo .
      325           define variable hh              as widget-handle no-undo .
      326           define variable v-h             as handle        extent 4 no-undo .
      327           define variable v-name-button   as character     no-undo .
      328           define variable v-help-old-x    as decimal       no-undo .
      329           define variable v-help-old-y    as decimal       no-undo .
      330           define variable v-help-old-size as decimal       no-undo .
      331           define variable v-frame-width   as decimal       no-undo .
      332           define variable jj              as integer       no-undo .
      333           do
      334               on error undo, return error
      335               :
      336               assign
      337                   v-frame-width = frame d-units:width - 0.3
      338                   fh            = frame d-units:first-child
      339                   hh            = fh:first-child
      340                   ii            = 1
      341                   .
      342               do while valid-handle(hh):
      343                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      344                   do:
      345                       case lc(hh:name) :
      346                           when "b-help" then
      347                               do:
      348                                   hh:load-image-up("cmp/b-help.bmp":u) .
      349                                   hh:load-image-down("cmp/b-help.bmp":u) .
      350                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      351                                   hh:TOOLTIP = "Помощь" .
      352                                   v-help-old-x = hh:column .
      353                                   v-help-old-y = hh:row    .
      354                                   v-help-old-size = hh:width .
      355                                   hh:width-chars = 2.5 .
      356                               end.
      357                           when "b-print" then
      358                               do:
      359                                   hh:load-image("cmp/b-print.bmp":u) .
      360                                   hh:TOOLTIP = "Печать" .
      361                                   v-h[ii] = hh:handle .
      362                                   ii = ii + 1 .
      363                                   hh:width-chars = 3 .
      364                               end.
      365                           when "b-history" or
      366                           when "b-hist" then
      367                               do:
      368                                   hh:load-image("cmp/b-hist.bmp":u) .
      369                                   hh:TOOLTIP = "История" .
      370                                   v-h[ii] = hh:handle .
      371                                   ii = ii + 1 .
      372                                   hh:width-chars = 3 .
      373                               end.
      374                           when "b-sch" then
      375                               do:
      376                                   hh:load-image("cmp/b-sch.bmp":u) .
      377                                   hh:TOOLTIP = "Установка Фильтра" .
      378                                   v-h[ii] = hh:handle .
      379                                   ii = ii + 1 .
      380                                   hh:width-chars = 3 .
      381                               end.
      382                           when "b-hist-user" then
      383                               do:
      384                                   hh:load-image("cmp/b-hist.bmp":u) .
      385                                   hh:TOOLTIP = "История пользователя" .
      386                                   ii = ii + 1 .
      387                               end.
      388                       end case.
      389                   end.
      390                   hh = hh:next-sibling.
      391               end.
      392               b-help:column = v-frame-width - b-help:width-chars.
      393               jj = 0.
      394               repeat ii = 4 to 1 by -1 :
      395                   if valid-handle (v-h[ii] ) then
      396                   do:
      397                       jj  = jj + 1 .
      398                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      399                       v-h[ii]:row    = v-help-old-y .
      400                   end.
      401               end.
      402           end.
      403       end.
      404   end procedure.
      405   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      406   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      407   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      408   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      409   define variable v-diasize-current-frame-width  as decimal   no-undo .
      410   define variable v-diasize-current-frame-height as decimal   no-undo .
      411   define variable v-diasize-change-size          as logical   no-undo .
      412   define variable v-diasize-resize-button        as handle    no-undo .
      413   define variable v-diasize-wndmax               as logical   no-undo .
      414   define variable v-diasize-wndstore             as logical   no-undo .
      415   define variable v-diasize-proc-name            as character no-undo .
      416   define variable v-diasize-browse-handle        as handle    no-undo .
      417   define variable v-diasize-browse-number        as integer   no-undo .
      418   define variable v-diasize-need-full-display    as logical   no-undo init false .
      419   define temp-table temp-diasize-handle no-undo
      420     field handle-value  as handle
      421     field save-position as decimal
      422     index xpk is primary unique handle-value
      423     .
      424   define temp-table temp-browse-handle no-undo
      425     field browse-type   as character
      426     field browse-number as integer
      427     field browse-handle as handle
      428     field original-size as decimal
      429     index xpk is primary unique browse-type browse-number
      430     index xie browse-type browse-handle
      431   .
      432   procedure diasize_change-height :
      433     define input  parameter p-change-value  as decimal   no-undo .
      434     define input  parameter p-move-resize   as logical   no-undo .
      435     define variable v-field-group-handle    as handle    no-undo .
      436     define variable v-object-handle         as handle    no-undo .
      437     define variable v-frame-height          as decimal   no-undo .
      438     define variable v-frame-virtual-height  as decimal   no-undo .
      439     define variable v-browse-height         as decimal   no-undo .
      440     define variable v-window-height         as decimal   no-undo .
      441     define variable v-window-virtual-height as decimal   no-undo .
      442     define variable v-change-sign           as integer   no-undo .
      443     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      444     define buffer buf_temp-browse-handle  for temp-browse-handle .
      445     if p-change-value > 0
      446     then do:
      447       if frame d-units :height + p-change-value
      448           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      449       then do:
      450         assign
      451           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      452                           - (frame d-units :height-chars)
      453         .
      454         if p-change-value <= 0
      455         then do:
      456           run diasize_position-resize-button in this-procedure .
      457           return .
      458         end.
      459       end.
      460     end.
      461     if p-change-value < 0
      462     then do:
      463       if frame d-units :height + p-change-value < v-diasize-orig-frame-height
      464       then do:
      465         assign
      466           p-change-value = v-diasize-orig-frame-height
      467                          - (frame d-units :height-chars)
      468         .
      469         if p-change-value >= 0
      470         then do:
      471           run diasize_position-resize-button in this-procedure .
      472           return .
      473         end.
      474       end.
      475     end.
      476     if p-change-value >= 0
      477     then do:
      478       assign
      479         v-change-sign = 1
      480       .
      481     end.
      482     else do:
      483       assign
      484         v-change-sign = -1
      485       .
      486     end.
      487     assign
      488       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      489     .
      490     if p-change-value = 0
      491     then do:
      492       run diasize_position-resize-button in this-procedure .
      493       return .
      494     end.
      495     move_block:
      496     do
      497     on error undo move_block, retry move_block
      498     :
      499       if retry
      500       then do:
      501         do
      502         on error undo move_block, leave move_block
      503         :
      504           if p-change-value > 0
      505           then do:
      506             for each buf_temp-diasize-handle
      507             on error undo, next
      508             :
      509               assign
      510                 v-object-handle = buf_temp-diasize-handle.handle-value
      511               .
      512               if v-object-handle <> v-diasize-resize-button
      513               then do:
      514                 assign
      515                   v-object-handle :row = buf_temp-diasize-handle.save-position
      516                 .
      517               end.
      518             end.
      519             assign
      520               v-diasize-browse-handle :height = v-browse-height
      521             .
      522             for each buf_temp-browse-handle
      523               where buf_temp-browse-handle.browse-type = 'height':u
      524             on error undo, next
      525             :
      526               assign
      527                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      528               .
      529             end.
      530             assign
      531               frame d-units :height = v-frame-height
      532             .
      533             if frame d-units :scrollable = true
      534             then do:
      535               assign
      536                 frame d-units :virtual-height = v-frame-virtual-height
      537               .
      538             end.
      539             run diasize_position-resize-button in this-procedure .
      540           end.
      541           else do:
      542             if frame d-units :scrollable = true
      543             then do:
