      827     define variable v-window-width         as decimal   no-undo .
      828     define variable v-window-virtual-width as decimal   no-undo .
      829     define variable v-change-sign          as integer   no-undo .
      830     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      831     define buffer buf_temp-browse-handle  for temp-browse-handle .
      832     if p-change-value > 0
      833     then do:
      834       if frame d-units :width + p-change-value >
      835           session :width-chars
      836       then do:
      837         assign
      838           p-change-value = session :width-chars - frame d-units :width
      839         .
      840         if p-change-value <= 0
      841         then do:
      842           run diasize_position-resize-button in this-procedure .
      843           return .
      844         end.
      845       end.
      846     end.
      847     if p-change-value < 0
      848     then do:
      849       if frame d-units :width + p-change-value < v-diasize-orig-frame-width
      850       then do:
      851         assign
      852           p-change-value = v-diasize-orig-frame-width
      853                          - frame d-units :width
      854         .
      855         if p-change-value >= 0
      856         then do:
      857           run diasize_position-resize-button in this-procedure .
      858           return .
      859         end.
      860       end.
      861     end.
      862     if p-change-value >= 0
      863     then do:
      864       assign
      865         v-change-sign = 1
      866       .
      867     end.
      868     else do:
      869       assign
      870         v-change-sign = -1
      871       .
      872     end.
      873     assign
      874       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      875     .
      876     if p-change-value = 0
      877     then do:
      878       run diasize_position-resize-button in this-procedure .
      879       return .
      880     end.
