     1175           define variable v-cntxt-db-num        as integer   no-undo .
     1176           define variable v-cntxt-userid        as character no-undo .
     1177           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1178                                             , OUTPUT v-cntxt-userid
     1179                                             ) .
     1180           run gbl/wndsizew.p
     1181             (input  v-cntxt-db-num
     1182             ,input  v-cntxt-userid
     1183             ,input  v-diasize-proc-name
     1184             ,input  'width':u
     1185             ,input  string(frame d-units :width - v-diasize-orig-frame-width)
     1186             ) .
     1187         end.
     1188       end.
     1189     end.
     1190     assign
     1191       v-diasize-change-size = false
     1192     .
     1193   end procedure.
     1194   procedure diasize_set-width :
     1195     define input  parameter p-new-width  as decimal   no-undo .
     1196     define input  parameter p-move-resize as logical   no-undo .
     1197     do
     1198     on error undo, return error return-value
     1199     :
     1200       run diasize_change-width in this-procedure
     1201         (input  (p-new-width - frame d-units :width)
     1202         ,input  p-move-resize
     1203         ) .
     1204     end.
     1205   end procedure.
     1206   procedure diasize_position-resize-button :
     1207     do with frame d-units
     1208     :
     1209       hide v-diasize-resize-button .
     1210       assign
     1211         v-diasize-resize-button :row = frame d-units :height - v-diasize-resize-button :height
     1212                     - 1
     1213                     - (frame d-units :border-bottom-pixels / session :pixels-per-row)
     1214         v-diasize-resize-button :col = frame d-units :width - v-diasize-resize-button :width
     1215                     - 1
     1216                     - (frame d-units :border-right-pixels / session :pixels-per-column)
     1217       .
     1218       view v-diasize-resize-button .
     1219     end.
     1220   end procedure.
     1221   on alt-right anywhere
     1222   do:
     1223     run diasize_change-width in this-procedure
     1224       (input 1
     1225       ,input true
     1226       ) .
     1227     return no-apply .
     1228   end.
     1229   on alt-left anywhere
     1230   do:
     1231     run diasize_change-width in this-procedure
     1232       (input -1
     1233       ,input true
     1234       ) .
     1235     return no-apply .
     1236   end.
     1237   on alt-down anywhere
     1238   do:
     1239     run diasize_change-height in this-procedure
     1240       (input 1
     1241       ,input true
     1242       ) .
     1243     return no-apply .
     1244   end.
     1245   on alt-up anywhere
     1246   do:
     1247     run diasize_change-height in this-procedure
     1248       (input -1
     1249       ,input true
     1250       ) .
     1251     return no-apply .
     1252   end.
     1253   on alt-enter of frame d-units
     1254   do:
     1255     run diasize_maximize in this-procedure
     1256       (input  ?
     1257       ).
     1258     return no-apply .
     1259   end.
     1260   procedure diasize_end-move :
     1261     do
     1262     on error undo, return error return-value
     1263     :
     1264       define variable v-row-delta as decimal   no-undo .
     1265       define variable v-col-delta as decimal   no-undo .
     1266       define variable v-new-row as decimal   no-undo .
     1267       define variable v-new-col as decimal   no-undo .
     1268       assign
     1269         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1270         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1271       .
     1272       assign
     1273         v-row-delta = v-new-row - frame d-units :height
     1274         v-col-delta = v-new-col - frame d-units :width
     1275       .
     1276       run diasize_change-height in this-procedure
     1277         (input v-row-delta
     1278         ,input true
     1279         ) .
     1280       run diasize_change-width in this-procedure
     1281         (input v-col-delta
     1282         ,input true
     1283         ) .
     1284     end.
     1285   end procedure.
     1286   procedure diasize_maximize :
     1287     define input  parameter p-action as logical   no-undo .
     1288     do
     1289     on error undo, return error return-value
     1290     :
     1291       if p-action = ?
     1292       then do:
     1293         if v-diasize-need-maximize = true
     1294         then do:
     1295           assign
     1296             p-action = true
     1297           .
     1298         end.
     1299         else do:
     1300           assign
     1301             p-action = false
     1302           .
     1303         end.
     1304       end.
     1305       if p-action = true
     1306       then do:
     1307         run diasize_change-height in this-procedure
     1308           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1309               - frame d-units :height-chars
     1310           ,input true
     1311           ) .
     1312         run diasize_change-width in this-procedure
     1313           (input session :width-chars
     1314               - frame d-units :width-chars
     1315           ,input true
     1316           ) .
     1317         assign
     1318           v-diasize-need-maximize = false
     1319         .
     1320       end.
     1321       else do:
     1322         run diasize_change-width in this-procedure
     1323           (input v-diasize-orig-frame-width
     1324               - frame d-units :width-chars
     1325           ,input true
     1326           ) .
     1327         run diasize_change-height in this-procedure
     1328           (input v-diasize-orig-frame-height
     1329               - frame d-units :height-chars
     1330           ,input true
     1331           ) .
     1332         assign
     1333           v-diasize-need-maximize = true
     1334         .
     1335       end.
     1336     end.
     1337   end procedure.
     1338   procedure diasize_restore-orig-size :
     1339     do
     1340     on error undo, return error return-value
     1341     :
     1342       assign
     1343         v-diasize-current-frame-width  = frame d-units :width
     1344         v-diasize-current-frame-height = frame d-units :height
     1345       .
     1346       run diasize_set-height in this-procedure
     1347         (input  v-diasize-orig-frame-height
     1348         ,input  true
     1349         ) .
     1350       run diasize_set-width in this-procedure
     1351         (input  v-diasize-orig-frame-width
     1352         ,input  true
     1353         ) .
     1354     end.
     1355   end procedure.
     1356   procedure diasize_restore-current-size :
     1357     do
     1358     on error undo, return error return-value
     1359     :
     1360       run diasize_set-height in this-procedure
     1361         (input  v-diasize-current-frame-height
     1362         ,input  true
     1363         ) .
     1364       run diasize_set-width in this-procedure
     1365         (input  v-diasize-current-frame-width
     1366         ,input  true
     1367         ) .
     1368     end.
     1369   end procedure.
     1370   procedure diasize_set-browse-handle :
     1371     define input  parameter p-browse-handle as handle   no-undo .
     1372     define buffer buf_temp-browse-handle for temp-browse-handle .
     1373     do
     1374     on error undo, return error return-value
     1375     :
     1376       assign
     1377         v-diasize-browse-handle = p-browse-handle
     1378       .
     1379       for each buf_temp-browse-handle
     1380       on error undo, return error return-value
     1381       :
     1382         delete buf_temp-browse-handle .
     1383       end.
     1384     end.
     1385   end procedure.
     1386   procedure diasize_add_browse :
     1387     define input  parameter p-browse-type   as character no-undo .
     1388     define input  parameter p-browse-handle as handle    no-undo .
     1389     define buffer buf_temp-browse-handle for temp-browse-handle .
     1390     do
     1391     on error undo, return error return-value
     1392     :
     1393       assign
     1394         v-diasize-browse-number = v-diasize-browse-number + 1
     1395       .
     1396       create buf_temp-browse-handle .
     1397       assign
     1398         buf_temp-browse-handle.browse-type   = p-browse-type
     1399         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1400         buf_temp-browse-handle.browse-handle = p-browse-handle
     1401       .
     1402     end.
     1403   end procedure.
     1404   procedure diasize_init :
     1405     define variable v-default-value    as logical   no-undo .
     1406     define variable v-restore-saved    as logical   no-undo .
     1407     define variable v-resize-value-str as character no-undo .
     1408     do
     1409     on error undo, return error return-value
     1410     :
     1411       do with frame d-units
     1412       :
     1413         assign
     1414           v-diasize-orig-frame-height = frame d-units :height
     1415           v-diasize-orig-frame-width  = frame d-units :width
     1416           v-diasize-browse-handle     = browse br-units :handle
     1417         .
     1418         create button v-diasize-resize-button
     1419         assign
     1420           parent        = frame d-units :first-child
     1421           label         = "s"
     1422           height-pixels = 16
     1423           width-pixels  = 16
     1424           visible       = true
     1425           sensitive     = true
     1426           movable       = true
     1427           triggers:
     1428             on end-move persistent run diasize_end-move in this-procedure .
     1429           end triggers.
     1430         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1431         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1432         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1433         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1434         assign
     1435           v-diasize-wndmax = false
     1436         .
     1437         if connected("ub") = true
     1438         then do:
     1439           define variable v-cntxt-db-num        as integer   no-undo .
     1440           define variable v-cntxt-userid        as character no-undo .
     1441           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1442                                             , OUTPUT v-cntxt-userid
     1443                                             ) .
     1444           run gbl/wndpar_r.p
     1445             (input  v-cntxt-db-num
     1446             ,input  v-cntxt-userid
     1447             ,input  'wndmax':U
     1448             ,output v-diasize-wndmax
     1449             ,output v-default-value
     1450             ) .
     1451         end.
     1452         assign
     1453           v-diasize-wndstore = false
     1454         .
     1455         if connected("ub") = true
     1456         then do:
     1457           run gbl/wndpar_r.p
     1458             (input  v-cntxt-db-num
     1459             ,input  v-cntxt-userid
     1460             ,input  'wndstore':U
     1461             ,output v-diasize-wndstore
     1462             ,output v-default-value
     1463             ) .
     1464         end.
     1465         assign
     1466           v-diasize-proc-name = entry(1, program-name(2), '.')
     1467         .
     1468         if v-diasize-wndstore = true
     1469         then do:
     1470           assign
     1471             v-restore-saved = false
     1472           .
     1473           if connected("ub") = true
     1474           then do:
     1475             run gbl/wndsizer.p
     1476               (input  v-cntxt-db-num
     1477               ,input  v-cntxt-userid
     1478               ,input  v-diasize-proc-name
     1479               ,input  'height':u
     1480               ,output v-resize-value-str
     1481               ) .
     1482             if v-resize-value-str <> '':U
     1483             then do:
     1484               run diasize_change-height in this-procedure
     1485                 (input  integer(v-resize-value-str)
     1486                 ,input  true
     1487                 ) .
     1488               assign
     1489                 v-restore-saved = true
     1490               .
     1491             end.
     1492           end.
     1493           if connected("ub") = true
     1494           then do:
     1495             run gbl/wndsizer.p
     1496               (input  v-cntxt-db-num
     1497               ,input  v-cntxt-userid
     1498               ,input  v-diasize-proc-name
     1499               ,input  'width':u
     1500               ,output v-resize-value-str
     1501               ) .
     1502             if v-resize-value-str <> '':U
     1503             then do:
     1504               run diasize_change-width in this-procedure
     1505                 (input  integer(v-resize-value-str)
     1506                 ,input  true
     1507                 ) .
     1508               assign
     1509                 v-restore-saved = true
     1510               .
     1511             end.
     1512           end.
     1513           if v-restore-saved <> true
     1514           then do:
     1515             if v-diasize-wndmax = true
     1516             then do:
     1517               run diasize_maximize in this-procedure
     1518                 (input  true
     1519                 ) .
     1520             end.
     1521           end.
     1522         end.
     1523         else do:
     1524           if v-diasize-wndmax = true
     1525           then do:
     1526             run diasize_maximize in this-procedure
     1527               (input  true
     1528               ) .
     1529           end.
     1530         end.
     1531       end.
     1532     end.
     1533   end procedure.
     1534   procedure diasize_need-full-display :
     1535     define output parameter p-need-full-display as logical   no-undo .
     1536     do
     1537     on error undo, return error return-value
     1538     :
     1539       assign
     1540         p-need-full-display = v-diasize-need-full-display
     1541       .
     1542       assign
     1543         v-diasize-need-full-display = false
     1544       .
     1545     end.
     1546   end procedure.
     1547   procedure get-context :
     1548      define output parameter p-db-num as integer          no-undo.
     1549      define output parameter p-user-id as character        no-undo.
     1550      define variable v-login               as character    no-undo.
     1551      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1552      define buffer buf_user-login  for ub.user-login .
     1553      do
     1554      on error undo, return error
     1555      :
     1556            FIND FIRST buf_sys-ctrl no-lock.
     1557            ASSIGN
     1558               v-login = USERID("ub")
     1559               p-db-num = buf_sys-ctrl.db-num
     1560            .
     1561            FIND FIRST buf_user-login
     1562                 WHERE buf_user-login.db-num = p-db-num
     1563                   AND buf_user-login.user-login = v-login
     1564                 no-lock
     1565                 no-error
     1566                 .
     1567            IF AVAILABLE buf_user-login
     1568            THEN DO:
     1569               assign
     1570                  p-user-id = buf_user-login.user-id
     1571               .
     1572            END.
     1573      end.
     1574   end procedure.
     1575       run diasize_init in this-procedure .
     1576   ON WINDOW-CLOSE OF FRAME d-units APPLY "END-ERROR":U TO SELF.
     1577   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578     run mainmenu_getcntxt in parparentproc
     1579       (output v-cntxt-db-num
     1580       ,output v-cntxt-userid
     1581       ,output v-cntxt-level
     1582       ,output v-cntxt-host-code-obj
     1583       ,output v-cntxt-obj-type
     1584       ,output v-cntxt-obj-code
     1585       ,output v-cntxt-db-num-obj
     1586       ,output v-cntxt-is-admin
     1587       ) .
     1588     RUN enable_UI.
     1589     if available units then
     1590         glog = br-units:select-focused-row( ).
     1591   do  on endkey undo, leave  on error undo, leave:
     1592     WAIT-FOR GO OF FRAME d-units.
     1593   end.
     1594   RUN disable_UI.
     1595   PROCEDURE disable_UI :
     1596     HIDE FRAME d-units.
     1597   END PROCEDURE.
     1598   PROCEDURE enable_UI :
     1599       b-select:visible   IN FRAME d-units = as-ref .
     1600       b-add-unit:visible IN FRAME d-units = ( not as-ref ) AND ibs.th.gbl.gbl-var:g#db-num = 0 .
     1601       b-change:visible   In FRAME d-units = b-add-unit:visible IN FRAME d-units .
     1602       ENABLE  br-units b-exit
     1603                       b-select    WHEN b-select:visible
     1604                       b-help     WHEN b-help:visible
     1605                       b-add-unit WHEN b-add-unit:visible
     1606                       b-change WHEN b-change:visible
     1607                       b-hist
     1608           WITH FRAME d-units.
     1609       OPEN QUERY br-units FOR EACH ub.units NO-LOCK.
     1610   END PROCEDURE.
