      128   DEFINE BUTTON b-add-unit
      129        LABEL "&Добавить":L
      130        SIZE 10 BY 1.
      131   DEFINE BUTTON b-change
      132        LABEL "&Изменить":L
      133        SIZE 10 BY 1.
      134   DEFINE BUTTON b-exit AUTO-END-KEY
      135        LABEL "&Выход ":L
      136        SIZE 10 BY 1.
