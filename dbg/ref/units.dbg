      807   procedure diasize_set-height :
      808     define input  parameter p-new-height  as decimal   no-undo .
      809     define input  parameter p-move-resize as logical   no-undo .
      810     do
      811     on error undo, return error return-value
      812     :
      813       run diasize_change-height in this-procedure
      814         (input  (p-new-height - frame d-units :height)
      815         ,input  p-move-resize
      816         ) .
      817     end.
      818   end procedure.
      819   procedure diasize_change-width :
      820     define input  parameter p-change-value as decimal   no-undo .
      821     define input  parameter p-move-resize  as logical   no-undo .
      822     define variable v-field-group-handle   as handle    no-undo .
      823     define variable v-object-handle        as handle    no-undo .
      824     define variable v-frame-width          as decimal   no-undo .
      825     define variable v-frame-virtual-width  as decimal   no-undo .
