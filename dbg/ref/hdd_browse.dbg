      442     method private void HDDbrowseGBD_RowPostPaint( input sender as System.Object, input e as System.Windows.Forms.DataGridViewRowPostPaintEventArgs ):
      443       define buffer tt-devicePC for tt-devicePC .
      444       define variable kk as integer no-undo .
      445       for each tt-devicePC:
      446         tt-devicePC.ii = kk .
      447         kk = kk + 1.
      448       end.
      449       if e:RowIndex > -1 then
      450       do:
      451         for each tt-devicePC no-lock where tt-devicePC.ii = e:RowIndex and
      452           (tt-devicePC.UserProc = 100 or
      453           tt-devicePC.ProcDisk = 100 or
      454           tt-devicePC.status_ <> "Пройдена"):
      455             HDDbrowseGBD:Rows[e:RowIndex]:DefaultCellStyle:BackColor = System.Drawing.Color:Red.
      456             HDDbrowseGBD:Rows[e:RowIndex]:DefaultCellStyle:ForeColor = System.Drawing.Color:White.
      457         end.
      458       end.
      459       return.
      460     end method.
