      172     constructor public HDD_browse (pdb-num as integer):
      173       super().
      174       InitializeComponent().
      175       Visual_form(pdb-num) .
      176       p-db-num = pdb-num .
      177       v-status = -1 .
      178       this-object:sort_date:Value = today .
      179       if v-SortDate = ? then v-SortDate = today .
      180       this-object:sort_time:Value = today .
      181       this-object:sort_time_end:text = "23:59:59" .
      182       if v-SortTime = ? then v-SortTime = time.
      183       if v-SortTime-end = ? then v-SortTime-end = time.
      184       v-SortTime = mtime (this-object:sort_time:value) / 1000 .
      185       v-SortTime-end = mtime (this-object:sort_time_end:value) / 1000 .
      186       if p-db-num <> 0 then bindingSource1:Handle = browse_HDD(v-SortDate, v-SortTime, v-SortTime-end, v-NamePK, v-ModelDisk, v-ProcDisk, v-UserDisk, v-status, v-ValueDisk, v-TreshDisk, v-Delta) no-error .
      187       else bindingSource3:Handle = browse_HDDGBD(v-SortDate, v-SortTime, v-SortTime-end, v-NamePK, v-ModelDisk, v-ProcDisk, v-UserDisk, v-status, v-ValueDisk, v-TreshDisk, v-Delta) no-error .
      188       bindingSource2:Handle = browse_HDDattr(v-ValueDisk, v-TreshDisk, v-Delta) no-error.
      189       this-object:ComponentsCollection:ADD(this-object:components).
      190       catch e as Progress.Lang.Error:
      191         undo, throw e.
      192       end catch.
      193     end constructor.
