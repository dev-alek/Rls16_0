     1422                   tt-devicePC.id          = buf_devisPC.id
     1423                   tt-devicePC.db-num      = integer(entry(ii,v-db-list,","))
     1424                   tt-devicePC.modeldevice = buf_devisPC.modeldevice
     1425                   tt-devicePC.ModelPC     = buf_devisPC.ModelPC
     1426                   tt-devicePC.ii          = jj
     1427                   tt-devicePC.namepc      = buf_devisPC.namepc
     1428                   tt-devicePC.date_       = buf_devisPCAttr.date
     1429                   tt-devicePC.time_int    = buf_devisPCAttr.time_
     1430                   tt-devicePC.time_       = string(truncate (buf_devisPCAttr.time_ / 3600, 0)) + ":" + string((buf_devisPCAttr.time_ modulo 3600) / 60,"99")
     1431                   .
     1432                 jj = jj + 1 .
     1433               end.
     1434               find first tt-devicePCAttr exclusive-lock where tt-devicePCAttr.id = buf_devisPCattr.id and tt-devicePCAttr.name_ = buf_devisPCattr.attr-code and tt-devicePCAttr.date_  = buf_devisPCAttr.date
     1435                 and    tt-devicePCAttr.time_       = buf_devisPCAttr.time_ and tt-devicePCAttr.db-num      = integer(entry(ii,v-db-list,",")) no-error .
     1436               if not available (tt-devicePCAttr) then
     1437               do:
     1438                 if buf_devisPCattr.attr-code <> "ProcDisk" and buf_devisPCattr.attr-code <> "UserProc" and buf_devisPCattr.attr-code <> "TestStatus" then
     1439                 do:
     1440                   create tt-devicePCAttr .
     1441                   assign
     1442                     tt-devicePCAttr.id        = buf_devisPCattr.id
     1443                     tt-devicePCAttr.db-num    = integer(entry(ii,v-db-list,","))
     1444                     tt-devicePCAttr.name_     = buf_devisPCattr.attr-code
     1445                     tt-devicePCAttr.raw_value = buf_devisPCattr.attr-Raw-value
     1446                     tt-devicePCAttr.tresh     = decimal(buf_devisPCattr.tresh)
     1447                     tt-devicePCAttr.value_    = decimal(buf_devisPCattr.attr-value)
     1448                     tt-devicePCAttr.type_     = buf_devisPCattr.type
     1449                     tt-devicePCAttr.date_     = buf_devisPCAttr.date
     1450                     tt-devicePCAttr.time_     = buf_devisPCAttr.time_
     1451                     .
     1452                 end.
     1453               end.
     1454               if v-TestStatus <> "" then tt-devicePC.status_  = v-TestStatus .
     1455               if v-ProcDisk <> 0 then tt-devicePC.ProcDisk = v-ProcDisk .
     1456               if v-UserDisk <> 0 then tt-devicePC.UserProc = v-UserDisk .
     1457             end.
     1458           end.
     1459         end.
     1460         if ProcDisk_ > 0 then
     1461         do:
     1462           for each tt-devicePC exclusive-lock where tt-devicePC.ProcDisk < ProcDisk_:
     1463             delete tt-devicePC .
     1464           end.
     1465         end.
     1466         if UserDisk_ > 0 then
     1467         do:
     1468           for each tt-devicePC exclusive-lock where tt-devicePC.UserProc < UserDisk_:
     1469             delete tt-devicePC .
     1470           end.
     1471         end.
     1472       case Status_:
     1473       when 0 then
     1474       do:
     1475           for each tt-devicePC exclusive-lock where tt-devicePC.status_ <> "Пройдена":
     1476             delete tt-devicePC .
     1477           end.
     1478       end.
     1479       when 1 then
     1480         do:
     1481           for each tt-devicePC exclusive-lock where tt-devicePC.status_ <> "Не пройдена":
     1482             delete tt-devicePC .
     1483           end.
     1484       end.
     1485       when 2 then do:
     1486           for each tt-devicePC exclusive-lock where tt-devicePC.status_ = "Пройдена" or tt-devicePC.status_ = "Не пройдена":
     1487             delete tt-devicePC .
     1488           end.
     1489         end.
     1490       end case .
     1491         if v-ValueDisk > 0 then
     1492         do:
