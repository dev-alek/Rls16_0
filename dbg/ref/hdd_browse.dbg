      399     method private void drowseHDDAttr_RowPostPaint( input sender as System.Object, input e as System.Windows.Forms.DataGridViewRowPostPaintEventArgs ):
      400       define variable kk as integer no-undo .
      401       define buffer tt-devicePCAttr for tt-devicePCAttr.
      402       for each tt-devicePCAttr:
      403         tt-devicePCAttr.ii = kk .
      404         kk = kk + 1 .
      405       end.
      406       if e:RowIndex > -1 then
