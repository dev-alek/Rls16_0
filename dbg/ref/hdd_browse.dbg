     1229     method private handle browse_HDD(date_ as date, time_ as integer, time_end as integer, namePk_ as character, ModelDisk_ as character, ProcDisk_ as decimal, UserDisk_ as decimal, Status_ as integer, ValueDisk_ as decimal, TreshDisk_ as decimal, Delta_ as decimal):
     1230       define buffer buf_devisPC     for ub.devisPC .
     1231       define buffer buf_devisPCAttr for ub.devisPC-attr .
     1232       define buffer bf_devisPCAttr  for ub.devisPC-attr .
     1233       define buffer bt_devisPCAttr  for ub.devisPC-attr .
     1234       define variable v-ProcDisk   as decimal   no-undo .
     1235       define variable v-UserDisk   as decimal   no-undo .
     1236       define variable v-TestStatus as character no-undo .
     1237       define variable v-Date       as decimal   no-undo .
     1238       define variable v-TimeST     as character no-undo .
     1239       define variable v-TimeST1    as character no-undo .
     1240       define variable ii           as integer   no-undo .
     1241       empty temp-table tt-devicePC .
     1242       empty temp-table tt-devicePCAttr .
     1243       for each buf_devisPC no-lock where buf_devisPC.DB-num = p-db-num:
     1244         if buf_devisPC.namepc begins namePk_ and buf_devisPC.modeldevice begins ModelDisk_ then
     1245         do:
     1246           next_:
     1247           for each buf_devisPCAttr no-lock where buf_devisPCAttr.id = buf_devisPC.id and buf_devisPCAttr.date >= date_:
     1248             if buf_devisPCAttr.time_ < time_ then next next_.
     1249             if buf_devisPCAttr.time_ > time_end then next next_.
     1250             v-ProcDisk = 0 .
     1251             v-UserDisk = 0 .
     1252             v-TestStatus = "" .
     1253             if buf_devisPCAttr.attr-code = "ProcDisk" then
     1254             do:
     1255               v-ProcDisk = decimal(entry(1,buf_devisPCAttr.attr-value,"%")) .
     1256             end.
     1257             if buf_devisPCAttr.attr-code = "UserProc" then
     1258             do:
     1259               v-UserDisk = decimal(entry(1,buf_devisPCAttr.attr-value,"%")) .
     1260             end.
     1261             if buf_devisPCAttr.attr-code = "TestStatus" then
     1262             do:
     1263               v-TestStatus = buf_devisPCAttr.attr-value .
     1264             end.
     1265             find first tt-devicePC exclusive-lock where tt-devicePC.id = buf_devisPC.id and tt-devicePC.modeldevice = buf_devisPC.modeldevice
     1266               and tt-devicePC.ModelPC     = buf_devisPC.ModelPC and tt-devicePC.namepc      = buf_devisPC.namepc and tt-devicePC.date_       = buf_devisPCAttr.date and
     1267               tt-devicePC.time_int       = buf_devisPCAttr.time_ and tt-devicePC.db-num = p-db-num no-error .
     1268             if not available (tt-devicePC) then
     1269             do:
     1270               create tt-devicePC .
     1271               assign
     1272                 tt-devicePC.id          = buf_devisPC.id
     1273                 tt-devicePC.db-num      = p-db-num
     1274                 tt-devicePC.modeldevice = buf_devisPC.modeldevice
     1275                 tt-devicePC.ModelPC     = buf_devisPC.ModelPC
     1276                 tt-devicePC.namepc      = buf_devisPC.namepc
     1277                 tt-devicePC.date_       = buf_devisPCAttr.date
     1278                 tt-devicePC.ii          = ii
     1279                 tt-devicePC.time_int    = buf_devisPCAttr.time_
     1280                 tt-devicePC.time_       = string(truncate (buf_devisPCAttr.time_ / 3600, 0)) + ":" + string((buf_devisPCAttr.time_ modulo 3600) / 60,"99") + ":" + string((buf_devisPCAttr.time_ modulo 3600) / 360,"99")
     1281                 .
     1282               ii = ii + 1 .
     1283             end.
     1284             find first tt-devicePCAttr exclusive-lock where tt-devicePCAttr.id = buf_devisPCattr.id and tt-devicePCAttr.name_ = buf_devisPCattr.attr-code and tt-devicePCAttr.date_  = buf_devisPCAttr.date
     1285               and    tt-devicePCAttr.time_       = buf_devisPCAttr.time_ and tt-devicePCAttr.db-num = p-db-num no-error .
     1286             if not available (tt-devicePCAttr) then
     1287             do:
     1288               if buf_devisPCattr.attr-code <> "ProcDisk" and buf_devisPCattr.attr-code <> "UserProc" and buf_devisPCattr.attr-code <> "TestStatus" then
     1289               do:
     1290                 create tt-devicePCAttr .
     1291                 assign
     1292                   tt-devicePCAttr.id        = buf_devisPCattr.id
     1293                   tt-devicePCAttr.db-num    = p-db-num
     1294                   tt-devicePCAttr.name_     = buf_devisPCattr.attr-code
     1295                   tt-devicePCAttr.raw_value = buf_devisPCattr.attr-Raw-value
     1296                   tt-devicePCAttr.tresh     = decimal(buf_devisPCattr.tresh)
     1297                   tt-devicePCAttr.value_    = decimal(buf_devisPCattr.attr-value)
     1298                   tt-devicePCAttr.type_     = buf_devisPCattr.type
     1299                   tt-devicePCAttr.date_     = buf_devisPCAttr.date
     1300                   tt-devicePCAttr.time_     = buf_devisPCAttr.time_
     1301                   .
     1302               end.
     1303             end.
     1304             if v-TestStatus <> "" then tt-devicePC.status_  = v-TestStatus .
     1305             if v-ProcDisk <> 0 then tt-devicePC.ProcDisk = v-ProcDisk .
     1306             if v-UserDisk <> 0 then tt-devicePC.UserProc = v-UserDisk .
     1307           end.
     1308         end.
     1309       end.
     1310       if ProcDisk_ > 0 then
     1311       do:
     1312         for each tt-devicePC exclusive-lock where tt-devicePC.ProcDisk < ProcDisk_:
     1313           delete tt-devicePC .
     1314         end.
     1315       end.
     1316       if UserDisk_ > 0 then
     1317       do:
     1318         for each tt-devicePC exclusive-lock where tt-devicePC.UserProc < UserDisk_:
     1319           delete tt-devicePC .
     1320         end.
     1321       end.
     1322       case Status_:
     1323       when 0 then
     1324       do:
     1325           for each tt-devicePC exclusive-lock where tt-devicePC.status_ <> "Пройдена":
     1326             delete tt-devicePC .
     1327           end.
     1328       end.
     1329       when 1 then
     1330         do:
     1331           for each tt-devicePC exclusive-lock where tt-devicePC.status_ <> "Не пройдена":
     1332             delete tt-devicePC .
     1333           end.
     1334       end.
     1335       when 2 then do:
     1336           for each tt-devicePC exclusive-lock where tt-devicePC.status_ = "Пройдена" or tt-devicePC.status_ = "Не пройдена":
     1337             delete tt-devicePC .
     1338           end.
     1339         end.
     1340       end case .
     1341       if v-ValueDisk > 0 then
     1342       do:
     1343         for each tt-devicePCAttr where tt-devicePCAttr.value_ < v-ValueDisk:
     1344           delete tt-devicePCAttr .
     1345         end.
     1346       end.
     1347       if v-TreshDisk > 0 then
     1348       do:
     1349         for each tt-devicePCAttr where tt-devicePCAttr.tresh < v-TreshDisk:
     1350           delete tt-devicePCAttr .
     1351         end.
     1352       end.
     1353       if v-Delta > 0 then
     1354       do:
     1355         for each tt-devicePCAttr where abs(tt-devicePCAttr.value_ - tt-devicePCAttr.tresh) > v-Delta:
     1356           delete tt-devicePCAttr .
     1357         end.
     1358       end.
     1359       for each tt-devicePC:
     1360         find first tt-devicePCAttr where tt-devicePCAttr.id = tt-devicePC.id and tt-devicePCAttr.date_ = tt-devicePC.date_ and tt-devicePCAttr.time_ = tt-devicePC.time_int no-error .
     1361         if not available (tt-devicePCAttr) then
     1362         do:
     1363           if tt-devicePC.status_ = "не закончена" then next .
     1364           delete tt-devicePC .
     1365         end.
     1366       end.
     1367       vPos = bindingSource1:Position.
     1368       if valid-handle(hQuery1)  THEN DELETE object hQuery1.
     1369       create query hQuery1.
     1370       hQuery1:set-buffers(buffer tt-devicePC:HANDLE).
     1371       hQuery1:query-prepare("FOR EACH tt-devicePC").
     1372       hQuery1:query-open.
     1373       bindingSource1:Refresh() .
     1374       return hQuery1 .
     1375     end method .
     1376     method private handle browse_HDDGBD(date_ as date, time_ as integer, time_end as integer, namePk_ as character, ModelDisk_ as character, ProcDisk_ as decimal, UserDisk_ as decimal, Status_ as integer, ValueDisk_ as decimal, TreshDisk_ as decimal, Delta_ as decimal):
     1377       define buffer buf_devisPC     for ub.devisPC .
     1378       define buffer buf_devisPCAttr for ub.devisPC-attr .
     1379       define buffer bf_devisPCAttr  for ub.devisPC-attr .
     1380       define buffer bt_devisPCAttr  for ub.devisPC-attr .
     1381       define variable ii           as integer   no-undo .
     1382       define variable jj           as integer   no-undo .
     1383       define variable v-ProcDisk   as decimal   no-undo .
     1384       define variable v-UserDisk   as decimal   no-undo .
     1385       define variable v-TestStatus as character no-undo .
     1386       define variable v-Date       as decimal   no-undo .
     1387       define variable v-TimeST     as character no-undo .
     1388       define variable v-TimeST1    as character no-undo .
     1389       empty temp-table tt-devicePC .
     1390       empty temp-table tt-devicePCAttr .
     1391       if v-db-list = "" then v-db-list = string (v-cntxt-db-num) .
     1392       do ii = 1 to num-entries (v-db-list,","):
     1393         for each buf_devisPC no-lock where buf_devisPC.DB-num = integer(entry(ii,v-db-list,",")):
     1394           if buf_devisPC.namepc begins namePk_ and buf_devisPC.modeldevice begins ModelDisk_ then
     1395           do:
     1396             next_:
     1397             for each buf_devisPCAttr no-lock where buf_devisPCAttr.id = buf_devisPC.id and buf_devisPCAttr.date >= date_:
     1398               if buf_devisPCAttr.time_ < time_ then next next_.
     1399               if buf_devisPCAttr.time_ > time_end then next next_.
     1400               v-ProcDisk = 0 .
     1401               v-UserDisk = 0 .
     1402               v-TestStatus = "" .
     1403               if buf_devisPCAttr.attr-code = "ProcDisk" then
     1404               do:
     1405                 v-ProcDisk = decimal(entry(1,buf_devisPCAttr.attr-value,"%")) .
     1406               end.
     1407               if buf_devisPCAttr.attr-code = "UserProc" then
     1408               do:
     1409                 v-UserDisk = decimal(entry(1,buf_devisPCAttr.attr-value,"%")) .
     1410               end.
     1411               if buf_devisPCAttr.attr-code = "TestStatus" then
     1412               do:
     1413                 v-TestStatus = buf_devisPCAttr.attr-value .
     1414               end.
     1415               find first tt-devicePC exclusive-lock where tt-devicePC.id = buf_devisPC.id and tt-devicePC.modeldevice = buf_devisPC.modeldevice
     1416                 and tt-devicePC.ModelPC     = buf_devisPC.ModelPC and tt-devicePC.namepc      = buf_devisPC.namepc and tt-devicePC.date_       = buf_devisPCAttr.date and
     1417                 tt-devicePC.time_int       = buf_devisPCAttr.time_ and tt-devicePC.db-num      = integer(entry(ii,v-db-list,",")) no-error .
     1418               if not available (tt-devicePC) then
     1419               do:
     1420                 create tt-devicePC .
