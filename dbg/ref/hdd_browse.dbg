     1219     method private void r_status_Checked( input sender as System.Object, input e as System.EventArgs ):
     1220       if this-object:radioButton1:Checked = true then v-status = -1 .
     1221       if this-object:radioButton2:Checked = true then v-status = 0 .
     1222       if this-object:radioButton4:Checked = true then v-status = 1 .
     1223       if this-object:radioButton3:Checked = true then v-status = 2 .
     1224       if p-db-num <> 0 then bindingSource1:Handle = browse_HDD(v-SortDate, v-SortTime, v-SortTime-end, v-NamePK, v-ModelDisk, v-ProcDisk, v-UserDisk, v-status, v-ValueDisk, v-TreshDisk, v-Delta) no-error .
     1225       else bindingSource3:Handle = browse_HDDGBD(v-SortDate, v-SortTime, v-SortTime-end, v-NamePK, v-ModelDisk, v-ProcDisk, v-UserDisk, v-status, v-ValueDisk, v-TreshDisk, v-Delta) no-error .
