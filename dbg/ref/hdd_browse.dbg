     1500             delete tt-devicePCAttr .
     1501           end.
     1502         end.
     1503         if v-Delta > 0 then
     1504         do:
     1505           for each tt-devicePCAttr where abs(tt-devicePCAttr.value_ - tt-devicePCAttr.tresh) > v-Delta:
     1506             delete tt-devicePCAttr .
     1507           end.
     1508         end.
     1509       end.
     1510       for each tt-devicePC:
     1511         find first tt-devicePCAttr where tt-devicePCAttr.id = tt-devicePC.id and tt-devicePCAttr.date_ = tt-devicePC.date_ and tt-devicePCAttr.time_ = tt-devicePC.time_int and tt-devicePCAttr.db-num = tt-devicePC.db-num no-error .
     1512         if not available (tt-devicePCAttr) then
     1513         do:
     1514           if tt-devicePC.status_ = "не закончена" then next .
     1515           delete tt-devicePC .
     1516         end.
     1517       end.
     1518       vPos = bindingSource3:Position.
     1519       if valid-handle(hQuery1)  THEN DELETE object hQuery1.
     1520       create query hQuery1.
     1521       hQuery1:set-buffers(buffer tt-devicePC:HANDLE).
     1522       hQuery1:query-prepare("FOR EACH tt-devicePC").
     1523       hQuery1:query-open.
