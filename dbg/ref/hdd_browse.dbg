     1527     method private handle browse_HDDattr(ValueDisk_ as decimal, TreshDisk_ as decimal, Delta_ as decimal):
     1528       define variable v-TimeST  as character no-undo .
     1529       define variable v-TimeST1 as character no-undo .
     1530       define buffer buf_devisPC-attr for ub.devisPC-attr .
     1531       define variable ii as integer no-undo .
     1532       empty temp-table tt-devicePCAttr .
     1533       next_:
     1534       for each buf_devisPC-attr no-lock where buf_devisPC-attr.id = tt-devicePC.id and buf_devisPC-attr.date = tt-devicePC.date_ and buf_devisPC-attr.db-num = tt-devicePC.db-num
     1535         and buf_devisPC-attr.attr-code <> "ProcDisk" and buf_devisPC-attr.attr-code <> "UserProc" and buf_devisPC-attr.attr-code <> "testStatus" :
     1536         if buf_devisPC-Attr.time_ <> tt-devicePC.time_int then next next_.
     1537         create tt-devicePCAttr .
     1538         assign
     1539           tt-devicePCAttr.id        = buf_devisPC-attr.id
     1540           tt-devicePCAttr.db-num    = buf_devisPC-attr.db-num
     1541           tt-devicePCAttr.ii        = ii
     1542           tt-devicePCAttr.name_     = buf_devisPC-attr.attr-code
     1543           tt-devicePCAttr.raw_value = buf_devisPC-attr.attr-Raw-value
     1544           tt-devicePCAttr.tresh     = decimal(buf_devisPC-attr.tresh)
     1545           tt-devicePCAttr.value_    = decimal(buf_devisPC-attr.attr-value)
     1546           tt-devicePCAttr.type_     = buf_devisPC-attr.type
     1547           .
     1548         ii = ii + 1 .
     1549       end.
     1550       if v-ValueDisk > 0 then
     1551       do:
     1552         for each tt-devicePCAttr where tt-devicePCAttr.value_ < v-ValueDisk:
     1553           delete tt-devicePCAttr .
     1554         end.
     1555       end.
     1556       if v-TreshDisk > 0 then
     1557       do:
     1558         for each tt-devicePCAttr where tt-devicePCAttr.tresh < v-TreshDisk:
     1559           delete tt-devicePCAttr .
     1560         end.
     1561       end.
     1562       if v-Delta > 0 then
     1563       do:
     1564         for each tt-devicePCAttr where abs(tt-devicePCAttr.value_ - tt-devicePCAttr.tresh) > v-Delta:
     1565           delete tt-devicePCAttr .
     1566         end.
     1567       end.
     1568       if valid-handle(hQuery2)  THEN DELETE object hQuery2.
     1569       create query hQuery2.
     1570       hQuery2:set-buffers(buffer tt-devicePCAttr:HANDLE).
     1571       hQuery2:query-prepare("FOR EACH tt-devicePCAttr").
     1572       hQuery2:query-open.
     1573       bindingSource2:Refresh() .
     1574       return hQuery2 .
     1575     end method .
