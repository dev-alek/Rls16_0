      202     @VisualDesigner.
      203     method private void browseHDD_RowPostPaint( input sender as System.Object, input e as System.Windows.Forms.DataGridViewRowPostPaintEventArgs ):
      204       define buffer tt-devicePC for tt-devicePC .
      205       define variable kk as integer no-undo .
      206       for each tt-devicePC:
      207         tt-devicePC.ii = kk .
      208         kk = kk + 1.
      209       end.
      210       if e:RowIndex > -1 then
      211       do:
      212         for each tt-devicePC no-lock where tt-devicePC.ii = e:RowIndex and
      213           (tt-devicePC.UserProc = 100 or
      214           tt-devicePC.ProcDisk = 100 or
      215           tt-devicePC.status_ <> "Пройдена"):
      216             browseHDD:Rows[e:RowIndex]:DefaultCellStyle:BackColor = System.Drawing.Color:Red.
      217             browseHDD:Rows[e:RowIndex]:DefaultCellStyle:ForeColor = System.Drawing.Color:White.
      218         end.
      219       end.
      220       return.
      221     end method.
