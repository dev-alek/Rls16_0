      228     @VisualDesigner.
      229     method private void click_choice_obj( input sender as System.Object, input e as System.EventArgs ):
      230       define variable v-host-code like ub.sysconf.host-code no-undo .
      231       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      232       define variable v-select-obj-type  as character no-undo .
      233       define variable v-select-obj-code  as integer   no-undo .
      234       define variable v-object-available as logical   no-undo .
      235       define variable p-obj-list         as character no-undo .
      236   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237     define variable v-cntxt-db-num        as integer   no-undo .
      238     define variable v-cntxt-userid        as character no-undo .
      239     define variable v-cntxt-level         as character no-undo .
      240     define variable v-cntxt-host-code-obj as integer   no-undo .
      241     define variable v-cntxt-obj-type      as character no-undo .
      242     define variable v-cntxt-obj-code      as integer   no-undo .
      243     define variable v-cntxt-db-num-obj    as integer   no-undo .
      244     define variable v-cntxt-is-admin      as logical   no-undo .
      245   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      246     run mainmenu_getcntxt in parparentproc
      247       (output v-cntxt-db-num
      248       ,output v-cntxt-userid
      249       ,output v-cntxt-level
      250       ,output v-cntxt-host-code-obj
      251       ,output v-cntxt-obj-type
      252       ,output v-cntxt-obj-code
      253       ,output v-cntxt-db-num-obj
      254       ,output v-cntxt-is-admin
      255       ) .
      256       for each buf_userobjs_temp-user-obj
      257         on error undo, return error return-value
      258         :
      259         delete buf_userobjs_temp-user-obj .
      260       end.
      261   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262   run usobjava in ibs.th.gbl.gbl-hndllib:g#library2
      263     (input  v-cntxt-db-num
      264     ,input  0
      265     ,input  v-cntxt-userid
      266     ,input  v-cntxt-obj-type
      267     ,input  v-cntxt-obj-code
      268     ,output v-object-available
      269     ) no-error .
      270       if error-status :error
      271         then
      272       do:
      273         message
      274           "Ошибка при вызове процедуры gbl/usobjava.i" skip
      275           error-status :get-message(1) skip
      276           return-value skip
      277           view-as alert-box error .
      278         undo, return no-apply .
      279       end.
      280       if v-object-available = true
      281         then
      282       do:
      283         find first buf_userobjs_temp-user-obj
      284           where buf_userobjs_temp-user-obj.obj-type = v-cntxt-obj-type
      285           and buf_userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
      286           and buf_userobjs_temp-user-obj.db-num = v-cntxt-db-num
      287           no-error .
      288         if not available buf_userobjs_temp-user-obj
      289           then
      290         do:
      291           create buf_userobjs_temp-user-obj .
      292           assign
      293             buf_userobjs_temp-user-obj.obj-type = v-cntxt-obj-type
      294             buf_userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
      295             buf_userobjs_temp-user-obj.db-num   = v-cntxt-db-num
      296             .
      297         end.
      298       end.
      299       define variable v-user-select as logical no-undo .
      300       run gbl/userobjs.w
      301         (input  parparentproc
      302         ,input  p-callback-handle
      303         ,input  v-cntxt-db-num
      304         ,input  v-cntxt-userid
      305         ,input  v-cntxt-host-code-obj
      306         ,input  v-cntxt-obj-type
      307         ,input  v-cntxt-obj-code
      308         ,INPUT  "b-sel,b-mark"
      309         ,output v-user-select
      310         ,output v-select-obj-type
      311         ,output v-select-obj-code
      312         ) .
      313       if v-user-select <> true
      314         then
      315       do:
      316         message
      317           "Объект не выбран"
      318           view-as alert-box information .
      319         assign
      320           p-obj-list = ""
      321           v-db-list  = ""
      322           .
      323       end.
      324       else
      325       do:
      326         for each temp_obj-list:
      327           delete temp_obj-list.
      328         end.
      329         for each buf_userobjs_temp-user-obj
      330           on error undo, return no-apply
      331           :
      332           create temp_obj-list.
      333           assign
      334             temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
      335             temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
      336             .
      337         end.
      338         assign
      339           p-obj-list = ""
      340           v-db-list  = ""
      341           .
      342         for each temp_obj-list
      343           :
      344           assign
      345             p-obj-list = p-obj-list + "," + temp_obj-list.obj-type + "," + string( temp_obj-list.obj-code )
      346             .
      347           find first ub.clients no-lock where ub.clients.obj-code = userobjs_temp-user-obj.obj-code and ub.clients.obj-type = userobjs_temp-user-obj.obj-type no-error .
      348           if available (ub.clients) and ub.clients.db-num <> ? then v-db-list = v-db-list + "," + string( ub.clients.db-num).
      349           else v-db-list = v-db-list + "," + string (temp_obj-list.obj-code) .
      350         end.
      351         v-db-list = trim (v-db-list,",") .
      352         p-obj-list = trim (p-obj-list,",") .
      353       end.
      354       this-object:obj_list:Text = string(p-obj-list) .
      355       bindingSource3:Handle = browse_HDDGBD(v-SortDate, v-SortTime, v-SortTime-end, v-NamePK, v-ModelDisk, v-ProcDisk, v-UserDisk, v-status, v-ValueDisk, v-TreshDisk, v-Delta) no-error .
      356       bindingSource2:Handle = browse_HDDattr(v-ValueDisk, v-TreshDisk, v-Delta).
      357       return.
      358     end method.
