      894   END.
      895   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      896   DO:
      897   define variable loc#log as logical no-undo.
      898   define variable loc-doc-rec as recid no-undo .
      899   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   do:
      901     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      902       (input  v-cntxt-db-num
      903       ,input  v-cntxt-userid
      904       ,input  0
      905       ,input  'actn_delivery-storage_work':U
      906       ,input  'global':U
      907       ,input  0
      908       ,input  '':U
      909       ,input  0
      910       ,input  0
      911       ,input  0
      912       ,input  0
      913       ,input  true
      914       ,output loc#log
      915       )  .
      916   end.
      917   if not loc#log then return no-apply.
      918   run ref/dlvtypei.w
      919                 (
      920                    input parParentProc
      921                   ,input p-curr-obj-type
      922                   ,input p-curr-obj-code
      923                   ,input 'ДОБАВЛЕНИЕ':U
      924                   ,input 0
      925                   ,input-output loc-doc-rec
      926                               ) no-error
      927   .
      928   if loc-doc-rec <> ? then do:
      929     RUn OpenBR in this-procedure .
      930     reposition br-delivtype to recid loc-doc-rec no-error.
      931     if error-status:error then do:                           find first pos_delivery-type no-lock where                                   recid(pos_delivery-type) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ТИПА ДОСТАВКИ" skip                            string(if avail pos_delivery-type                                     then  substitute("Вн код типа доставки: &1"                                                     , pos_delivery-type.deliv-type-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
      932   end.
      933   apply "entry" to br-delivtype in frame Dialog-Frame.
      934   apply "value-changed" to br-delivtype in frame Dialog-Frame.
      935   END.
      936   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      937   DO:
      938     DEFINE variable loc#log as logical no-undo.
      939   define variable loc-doc-rec as recid no-undo .
      940   if not available X_delivery-type then return no-apply.
      941   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   do:
      943     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      944       (input  v-cntxt-db-num
      945       ,input  v-cntxt-userid
      946       ,input  0
      947       ,input  'actn_delivery-storage_work':U
      948       ,input  'global':U
      949       ,input  0
      950       ,input  '':U
      951       ,input  0
