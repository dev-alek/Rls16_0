      966                   ,input p-curr-obj-code
      967                   ,input 'ИЗМЕНЕНИЕ':U
      968                   ,input X_delivery-type.deliv-type-code
      969                   ,input-output loc-doc-rec
      970                               ) no-error
      971   .
      972   if loc-doc-rec <> ? then do:
      973     RUn OpenBR in this-procedure .
      974     reposition br-delivtype to recid loc-doc-rec no-error.
      975     if error-status:error then do:                           find first pos_delivery-type no-lock where                                   recid(pos_delivery-type) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ТИПА ДОСТАВКИ" skip                            string(if avail pos_delivery-type                                     then  substitute("Вн код типа доставки: &1"                                                     , pos_delivery-type.deliv-type-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
      976   end.
      977   apply "entry" to br-delivtype in frame Dialog-Frame.
      978   apply "value-changed" to br-delivtype in frame Dialog-Frame.
      979   END.
      980   ON CHOOSE OF B-condkeep IN FRAME Dialog-Frame
      981   DO:
      982     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      983     define variable v-sts as integer no-undo init ?.
      984     IF NOT AVAILABLE X_delivery-type THEN RETURN no-apply.
      985     run ref/dlvtcnds.w (input parParentProc
      986                 , input p-curr-obj-type
      987                 , input p-curr-obj-code
      988                 , input (IF LOOKUP("b-add":U, bttns) > 0 THEN "b-add":U ELSE "":U)
      989                 , input "delivery-type":U
