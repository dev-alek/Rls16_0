     2542   MAIN-BLOCK:
     2543   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2544      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2545   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2546     run mainmenu_getcntxt in parparentproc
     2547       (output v-cntxt-db-num
     2548       ,output v-cntxt-userid
     2549       ,output v-cntxt-level
     2550       ,output v-cntxt-host-code-obj
     2551       ,output v-cntxt-obj-type
     2552       ,output v-cntxt-obj-code
     2553       ,output v-cntxt-db-num-obj
     2554       ,output v-cntxt-is-admin
     2555       ) .
     2556     if v-cntxt-level = 'object':U then do:
     2557       find first X_curr_clients no-lock where
     2558                 X_curr_clients.obj-type = p-curr-obj-type
     2559           AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     2560       if not available X_curr_clients then do:
     2561         message
     2562         vss-workfile vss-revision vss-description skip
     2563         "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     2564         p-curr-obj-type p-curr-obj-code
     2565         view-as alert-box ERROR.
     2566         return error .
     2567       end.
     2568     end.
     2569     if LOOKUP(p-mode, 'все':U,
     2570                   chr(4)) = 0
     2571        then dO:
     2572       message
     2573       vss-workfile vss-revision vss-description skip
     2574       "Неверное значение параметров вызова p-mode"
     2575       p-mode
     2576       view-as alert-box ERROR.
     2577       return error .
     2578    end.
     2579    v-rid-list = p-rid-list.
     2580   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2582     (output v-db-num
     2583     )  .
     2584     RUN MyEnable.
     2585     RUn OpenBR.
     2586     HIDE mark-num in frame Dialog-Frame .
     2587     if v-doc-rec <> ? then
     2588     REPOSITION br-delivtype to recid v-doc-rec No-ERROR.
     2589   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2590   DEF VAR cur-clmn-numbr-delivtype as INT EXTENT 5 no-undo.
     2591   DEF VAR varmvibr-delivtype       as INT no-undo.
     2592   DEF VAR varmvjbr-delivtype       as INT no-undo.
     2593   DEF VAR varmvkbr-delivtype       as INT no-undo.
     2594   DEF VAR varmvlbr-delivtype       as INT no-undo.
     2595   DEF VAR move-elementbr-delivtype as INT no-undo.
     2596   def var jjbr-delivtype           as int no-undo.
     2597   do varmvibr-delivtype = 1 to EXTENT(cur-clmn-numbr-delivtype):
     2598     ASSIGN cur-clmn-numbr-delivtype[varmvibr-delivtype] = varmvibr-delivtype.
     2599   END.
     2600   RUN start-mv-clmnbr-delivtype.
     2601   PROCEDURE start-mv-clmnbr-delivtype:
     2602   def var old-session as logical no-undo.
     2603      old-session = SESSION:IMMEDIATE-DISPLAY.
     2604      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2605          IF  p-mode = 'все':U  THEN DO:
     2606      DO jjbr-delivtype = NUM-ENTRIES('1,2,3,4,5') TO 1 BY -1:
     2607        RUN re-move-clmnbr-delivtype ( cur-clmn-numbr-delivtype[INTEGER(ENTRY (jjbr-delivtype, '1,2,3,4,5'))] , 1).
     2608      END.
     2609          END.
     2610      SESSION:IMMEDIATE-DISPLAY = old-session.
     2611   END.
     2612   ON ctrl-cursor-right OF BROWSE br-delivtype do:
     2613     RUN re-move-clmnbr-delivtype ( 1, 5).
     2614   END.
     2615   ON ctrl-cursor-left OF BROWSE br-delivtype do:
     2616     RUN re-move-clmnbr-delivtype (5, 1).
     2617   END.
     2618   PROCEDURE re-move-clmnbr-delivtype:
     2619     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2620     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2621     DO varmvibr-delivtype = 1 TO EXTENT(cur-clmn-numbr-delivtype):
     2622       if cur-clmn-numbr-delivtype[varmvibr-delivtype] = source-column THEN cur-clmn-numbr-delivtype[varmvibr-delivtype] = -1.
     2623     END.
     2624     if br-delivtype:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2625     if source-column > target-column THEN
     2626     DO varmvjbr-delivtype = source-column - 1 to target-column BY -1:
     2627       DO varmvibr-delivtype = 1 TO EXTENT(cur-clmn-numbr-delivtype):
     2628           if cur-clmn-numbr-delivtype[varmvibr-delivtype] = varmvjbr-delivtype THEN DO:
     2629             cur-clmn-numbr-delivtype[varmvibr-delivtype] = cur-clmn-numbr-delivtype[varmvibr-delivtype] + 1.
     2630           END.
     2631       END.
     2632     END.
     2633     ELSE
     2634     DO varmvjbr-delivtype = source-column + 1 to target-column:
     2635       DO varmvibr-delivtype = 1 TO EXTENT(cur-clmn-numbr-delivtype):
     2636         if cur-clmn-numbr-delivtype[varmvibr-delivtype] = varmvjbr-delivtype THEN DO:
     2637           cur-clmn-numbr-delivtype[varmvibr-delivtype] = cur-clmn-numbr-delivtype[varmvibr-delivtype] - 1.
     2638         END.
     2639       END.
     2640     END.
     2641     DO varmvibr-delivtype = 1 TO EXTENT(cur-clmn-numbr-delivtype):
     2642       if cur-clmn-numbr-delivtype[varmvibr-delivtype] = -1 THEN cur-clmn-numbr-delivtype[varmvibr-delivtype] = target-column.
     2643     END.
     2644   END PROCEDURE.
     2645   PROCEDURE ch-clmnbr-delivtype:
     2646     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2647     if cur-clmn-loc <= 1 then do:
     2648       return .
     2649     end.
     2650     DO varmvibr-delivtype = 1 TO EXTENT(cur-clmn-numbr-delivtype):
     2651       if cur-clmn-numbr-delivtype[varmvibr-delivtype] = cur-clmn-loc THEN move-elementbr-delivtype = varmvibr-delivtype.
     2652     END.
     2653     RUN re-move-clmnbr-delivtype (cur-clmn-loc, 1).
     2654   END PROCEDURE.
     2655   PROCEDURE mv-brw-defaultbr-delivtype:
     2656   def var old-session as logical no-undo.
     2657     old-session = SESSION:IMMEDIATE-DISPLAY.
     2658     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2659     do varmvlbr-delivtype = 1 to EXTENT(cur-clmn-numbr-delivtype):
     2660       RUN re-move-clmnbr-delivtype (cur-clmn-numbr-delivtype[varmvlbr-delivtype], varmvlbr-delivtype).
     2661     END.
     2662     RUN start-mv-clmnbr-delivtype.
     2663     SESSION:IMMEDIATE-DISPLAY = old-session.
     2664   END PROCEDURE.
     2665   .
     2666   WAIT-FOR GO OF FRAME Dialog-Frame.
     2667   END.
     2668   RUN disable_UI.
     2669   PROCEDURE disable_UI :
     2670     HIDE FRAME Dialog-Frame.
     2671   END PROCEDURE.
     2672   PROCEDURE enable_UI :
     2673     DISPLAY RS-sts mark-num
     2674         WITH FRAME Dialog-Frame.
     2675     ENABLE b-quit B-mark B-sel B-add b-lkp B-chg B-del B-print B-hist B-Help
     2676            B-delivsubj B-condkeep RS-sts br-delivtype mark-num
     2677         WITH FRAME Dialog-Frame.
     2678     VIEW FRAME Dialog-Frame.
     2679     OPEN QUERY br-delivtype FOR EACH X_delivery-type NO-LOCK INDEXED-REPOSITION.
     2680   END PROCEDURE.
     2681   PROCEDURE MyEnable :
     2682   ASSIGN
     2683   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     2684                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     2685                          "Все&!" + chr(44) + 'все':U + chr(44) +
     2686                           "Удаленные&-" + chr(44) + '1':U
     2687   rs-sts = (IF p-sts = ? THEN 'все':U ELSE string(p-sts))
     2688   .
     2689   DISPLAY mark-num
     2690   WITH FRAME Dialog-Frame.
     2691   ENABLE
     2692   b-quit
     2693   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2694   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2695   B-add when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2696   b-lkp
     2697   B-chg when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2698   B-del when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2699   B-print
     2700   B-Help
     2701   B-hist
     2702   B-delivsubj
     2703   B-condkeep
     2704   br-delivtype
     2705   mark-num
     2706   rs-sts
     2707   with FRAME Dialog-Frame.
     2708   VIEW FRAME Dialog-Frame.
     2709   END PROCEDURE.
     2710   PROCEDURE OpenBr :
     2711   define variable title0 as character no-undo init "Список типов доставки".
     2712   IF p-sts = ? THEN DO:
     2713       OPEN QUERY br-delivtype
     2714       FOR EACH X_delivery-type NO-LOCK
     2715       INDEXED-REPOSITION.
     2716   END.
     2717   ELSE DO:
     2718       frame Dialog-Frame:TITLE = title0 +  chr(32) + entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U).
     2719       OPEN QUERY br-delivtype
     2720       FOR EACH X_delivery-type NO-LOCK where
     2721       X_delivery-type.sts = p-sts
     2722       INDEXED-REPOSITION.
     2723   END.
     2724   APPLY "VALUE-CHANGED" TO br-delivtype in frame Dialog-Frame.
     2725   APPLY "ENTRY" TO br-delivtype.
     2726   END PROCEDURE.
     2727   PROCEDURE proc-b-del :
     2728   define variable loc#log as logical no-undo.
     2729   define variable v-sts like ub.delivery-type.sts no-undo .
     2730   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     2731   if not available X_delivery-type then return error.
     2732   do
     2733   on error undo, return error
     2734   on stop undo, return error
     2735   :
     2736   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2737   do:
     2738     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2739       (input  v-cntxt-db-num
     2740       ,input  v-cntxt-userid
     2741       ,input  0
     2742       ,input  'actn_delivery-storage_work':U
     2743       ,input  'global':U
     2744       ,input  0
     2745       ,input  '':U
     2746       ,input  0
     2747       ,input  0
     2748       ,input  0
     2749       ,input  0
     2750       ,input  true
     2751       ,output loc#log
     2752       )  .
     2753   end.
     2754   if not loc#log then return error.
     2755     assign
     2756     v-sts = ?
     2757     loc-doc-rec = RECID(X_delivery-type)
     2758     .
     2759     run ref/dlvtype2.p (
     2760                     input recid(X_delivery-type)
     2761                     ,input-output v-sts
     2762                    ) no-error .
     2763     if error-status:error then undo, return error.
     2764     RUN OpenBr.
     2765     REPOSITION br-delivtype to recid loc-doc-rec No-error.
     2766     if error-status:error then do:                           find first pos_delivery-type no-lock where                                   recid(pos_delivery-type) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ТИПА ДОСТАВКИ" skip                            string(if avail pos_delivery-type                                     then  substitute("Вн код типа доставки: &1"                                                     , pos_delivery-type.deliv-type-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     2767     if available X_delivery-type then do:
     2768       loc#log = br-delivtype:select-focused-row( ) IN FRAME Dialog-Frame.
     2769     end.
     2770     apply "ENTRY" to br-delivtype.
     2771   end.
     2772   END PROCEDURE.
     2773   PROCEDURE proc-b-print :
     2774   define variable v-doc-rec as recid no-undo .
     2775   define variable accum-count as integer.
     2776   define variable date_string     as      char    no-undo.
     2777   define variable Line            as      char    no-undo.
     2778   DEFINE VARIABLE v-sts-chr AS CHARACTER NO-UNDO.
     2779   DEFINE FRAME delivery-type-list
     2780   X_delivery-type.deliv-type-name
     2781   v-sts-chr FORMAT "X(8)" COLUMN-LABEL "Статус"
     2782   X_delivery-type.des FORMAT "X(100)"
     2783   X_delivery-type.deliv-type-code COLUMN-LABEL "Вн.код!группы"
     2784   HEADER  date_string AT 5 format "X(35)"
     2785    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     2786   Line format "X(195)" AT 1
     2787   with width 232 down stream-io use-text    .
     2788   Line = fill("-", 195).
     2789   date_string = cur-time-print() .
     2790   run prn-lib-open-stream  in this-procedure (
     2791                                                input parParentProc
     2792                                               ,input 43
     2793                                               ,input yes
     2794                                               ,input no
     2795                                               ).
     2796   PUT  STREAM PrnLibStream
     2797   SPACE(25) ( frame Dialog-Frame:title )
     2798   format "x(90)" SKIP(1) .
     2799   FORM HEADER
     2800   Line format "X(195)" AT 1 SKIP
     2801   "Продолжение - на следующей странице" AT 30 SKIP
     2802   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2803   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2804   FORM with FRAME delivery-type-list  .
     2805   run waitfram-show in this-procedure ("Ждите...").
     2806   v-doc-rec = recid(X_delivery-type).
     2807   DO WHILE available X_delivery-type :
     2808     GET prev br-delivtype.
     2809   END.
     2810   GET next br-delivtype.
     2811   DO WHILE available X_delivery-type :
     2812     Display STREAM PrnLibStream
     2813      X_delivery-type.deliv-type-name
     2814     entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ v-sts-chr
     2815     X_delivery-type.des
     2816     X_delivery-type.deliv-type-code
     2817   with FRAME delivery-type-list .
     2818     DOWN STREAM PrnLibStream 1
     2819     with FRAME delivery-type-list  .
     2820     assign
     2821     accum-count = accum-count + 1
     2822     .
     2823     GET next br-delivtype.
     2824   END.
     2825   UNDERLINE  STREAM PrnLibStream
     2826   X_delivery-type.deliv-type-name
     2827   v-sts-chr
     2828   X_delivery-type.des
     2829   X_delivery-type.deliv-type-code
     2830   with FRAME delivery-type-list .
     2831   DISPLAY STREAM PrnLibStream
     2832   "ИТОГО" @ X_delivery-type.deliv-type-name
     2833   accum-count @ v-sts-chr
     2834   with frame delivery-type-list.
     2835   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     2836   HIDE  STREAM PrnLibStream FRAME delivery-type-List.
     2837   output  STREAM PrnLibStream CLOSE.
     2838   REPOSITION br-delivtype to recid v-doc-rec no-error.
     2839   APPLY "entry" to br-delivtype.
     2840   run waitfram-hide in this-procedure .
     2841   run prn-lib-prn-file in this-procedure (
     2842                                             input parParentProc
     2843                                             ,input 8
     2844                                             ).
     2845   END PROCEDURE.
     2846   PROCEDURE proc-br-delivtype :
     2847   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2848   if b-sel:sensitive in frame Dialog-Frame then dO:
     2849       if b-mark:sensitive then do:
     2850           apply "choose" to b-mark in frame Dialog-Frame.
     2851       end.
     2852       else do:
     2853           apply "choose" to b-sel in frame Dialog-Frame.
     2854       end.
     2855   end.
     2856   else do:
     2857       if b-lkp:sensitive then
     2858       apply "choose" to b-lkp in frame Dialog-Frame.
     2859   end.
     2860   END PROCEDURE.
