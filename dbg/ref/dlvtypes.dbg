      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      123   define new shared variable RepPathName        as character no-undo .
      124   define new shared variable PrintRubl          as logical   no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define variable v-waitfram-action01         as character   no-undo .
      127   define variable v-waitfram-action02         as character   no-undo .
      128   define variable v-waitfram-action03         as character   no-undo .
      129   define variable mWaitFramTextBeg            as character   no-undo.
      130   define variable mWaitFramTextEnd            as character   no-undo.
      131   define variable mWaitFramView               as logical     no-undo.
      132   define variable mWaitProcEvent              as logical     no-undo init yes.
      133   define variable mWaitFramInterval           as integer     no-undo init 1 .
      134   define variable mWaitFramStop               as logical     no-undo.
      135   define variable mWaitFramStopUser           as logical     no-undo.
      136   define variable mWaitFramStopTimeOut        as logical     no-undo.
      137   define variable mWaitFramStartProc          as datetime-tz no-undo.
      138   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      139   define button B-WaitFramStop auto-end-key
      140        label "Стоп"
      141        size 10 by 1 tooltip "Остоновить процесс".
      142   define button B-viewProcInfo
      143        label "Информация"
      144        size 15 by 1 tooltip "Информация о процесс".
      145   define frame waitfram
      146     v-waitfram-action01 format "x(72)" no-label skip
      147     v-waitfram-action02 format "x(72)" no-label skip
      148     v-waitfram-action03 format "x(72)" no-label skip
      149     B-viewProcInfo
      150     B-WaitFramStop at row 4 col 30
      151     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      152     .
      153   define new global shared variable mBatchMode as logical no-undo init ?.
      154   define variable mFramBachModHandle as handle no-undo.
      155   mFramBachModHandle = frame waitfram:handle.
      156   define variable mFameOldVis as logical no-undo.
      157   define variable mVisCUrentVin as logical no-undo.
      158   if session:batch-mode
      159   then
      160      mBatchMode = yes.
      161   if mBatchMode = ? then do:
      162     mVisCUrentVin = current-window:visible.
      163     mFameOldVis = mFramBachModHandle:visible.
      164     mFramBachModHandle:visible  = yes.
      165     mBatchMode = mFramBachModHandle:visible ne yes.
      166     mFramBachModHandle:visible = mFameOldVis.
      167     current-window:visible = mVisCUrentVin.
      168   end.
      169    if  log-manager:logfile-name ne ?
      170     then DO:
      171         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      172         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      173         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      174     end.
      175   on choose of B-WaitFramStop in frame waitfram
      176   do:
      177     mWaitFramStop = yes.
      178     mWaitFramStopUser = yes.
      179   end.
      180   function waitfram-check-timeout returns logical():
      181      define variable vtime as int64 no-undo.
      182      if mWaitFramStopTimeOut
      183      then
      184         return yes.
      185      vtime = ( now - mWaitFramStartProc ) / 1000 .
      186      if     mWaitFramTimeOut ne ?
      187         and mWaitFramTimeOut ne 0
      188         and mWaitFramTimeOut lt vtime
      189      then do:
      190         mWaitFramStopTimeOut = yes.
      191      end.
      192      return mWaitFramStopTimeOut.
      193   end.
      194   procedure waitfram-hide :
      195     if not session:batch-mode
      196     then do
      197     on error undo, return error return-value
      198     :
      199       pause 0 before-hide .
      200       if not mBatchMode then
      201         hide frame waitfram .
      202     if     not mWaitFramView
      203        and mWaitProcEvent
      204     then
      205       process events .
      206     end.
      207   end procedure.
      208   procedure waitfram-show :
      209     define input  parameter p-message as character no-undo .
      210     define variable v-left-margin as integer   no-undo .
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       if length(p-message) <= 70 then do:
      216         assign
      217           v-left-margin = integer((70 - length(p-message)) / 2)
      218         .
      219         assign
      220           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      221         .
      222         assign
      223           v-waitfram-action01 = " "
      224           v-waitfram-action02 = " "
      225                                    + fill(" ", v-left-margin)
      226                                    + p-message
      227           v-waitfram-action03 = " "
      228         .
      229       end.
      230       else do:
      231         define variable vRindex1 as integer no-undo.
      232         define variable vRindex2 as integer no-undo.
      233         vRindex1 = r-index(p-message," ",70).
      234         if vRindex1 = 0
      235         then
      236            vRindex1 = 70.
      237         if length(p-message)  <= vRindex1 + 70 then do:
      238           assign
      239             v-waitfram-action01 = " "
      240             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      242           .
      243         end.
      244         else do:
      245           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      246           if vRindex2 <= vRindex1
      247           then
      248              vRindex2 = vRindex1 + 70.
      249           assign
      250             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      251             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      253           .
      254         end.
      255       end.
      256       B-viewProcInfo:visible   in frame waitfram = no.
      257       B-viewProcInfo:sensitive in frame waitfram = no.
      258       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       if  (   mWaitFramView
      261          or  mWaitProcEvent)
      262          and not mBatchMode
      263       then
      264          display
      265             v-waitfram-action01 skip
      266             v-waitfram-action02 skip
      267             v-waitfram-action03 skip
      268          with frame waitfram .
      269       if     mWaitFramView
      270          then do:
      271             if     mWaitFramInterval ne ?
      272                and not mBatchMode
      273             then
      274                wait-for go of frame waitfram pause mWaitFramInterval.
      275          end.
      276          else
      277             if     mWaitProcEvent
      278                and not mBatchMode
      279             then
      280                process events .
      281     end.
      282   end procedure.
      283      procedure waitfram-show-this:
      284         define input  parameter iInterval as int64 no-undo.
      285         define variable vtime as int64 no-undo.
      286         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      287         mWaitFramInterval = iInterval.
      288         run waitfram-show (substitute("&1&2 &3&4" ,
      289                                       mWaitFramTextBeg ,
      290                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      291                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      292                                       mWaitFramTextEnd
      293                                      )
      294                           ).
      295      end.
      296      procedure WaitFramRunPause:
      297         define input  parameter iInterval as dec no-undo.
      298         define variable vStart  as datetime-tz no-undo.
      299         define variable vend    as datetime-tz no-undo.
      300         define variable vint as int64 no-undo.
      301         define variable vOk as logical no-undo.
      302         vStart = now.
      303         vend   = vStart.
      304         publish "WaitFramPause" (iInterval,output vOk).
      305         vend   =  now.
      306         vint = vend - vStart.
      307         vint = iInterval - vint / 1000.
      308         if     not mWaitFramStop
      309            and (   vint > 0
      310                 or (    not vOk
      311                     and iInterval eq ?
      312                     )
      313                 )
      314         then
      315            run waitfram-show-this (iInterval).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and vint > 0
      321         then do:
      322            run gbl/pause.p (vint * 1000).
      323         end.
      324         if iInterval ne ?
      325         then
      326            publish "WaitFramStop".
      327         waitfram-check-timeout().
      328      end.
      329      procedure WaitFramWaitFor:
      330         define input  parameter iInterval as dec no-undo.
      331         assign
      332            mWaitFramStartProc   = now
      333            mWaitFramStopUser    = no
      334            mWaitFramStopTimeOut = no
      335         .
      336         block-wait:
      337         do while not mWaitFramStop:
      338            run WaitFramRunPause (iInterval).
      339            if  waitfram-check-timeout()
      340            then do:
      341               leave block-wait.
      342            end.
      343         end.
      344         run waitfram-hide.
      345      end.
      346   procedure waitfram-join :
      347     define input  parameter p-line-1  as character no-undo .
      348     define input  parameter p-line-2  as character no-undo .
      349     define input  parameter p-line-3  as character no-undo .
      350     define output parameter p-message as character no-undo .
      351     do
      352     on error undo, return error return-value
      353     :
      354       assign
      355         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      358       .
      359     end.
      360   end procedure.
      361   function waitfram-join-function returns character
      362     (input p-line-1 as character
      363     ,input p-line-2 as character
      364     ,input p-line-3 as character
      365     ).
      366     define variable v-message as character no-undo .
      367     run waitfram-join in this-procedure
      368       (input  p-line-1
      369       ,input  p-line-2
      370       ,input  p-line-3
      371       ,output v-message
      372       ) .
      373     return v-message .
      374   end function .
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   define  stream PrnLibStream.
      377   procedure prn-lib-prn-file :
      378     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      379     define input parameter p-DIsabledoptions as integer no-undo .
      380     define variable v-report-name as character no-undo .
      381     define variable v-user-action as character no-undo .
      382     define variable v-printed     as logical   no-undo .
      383     define variable v-exist       as logical   no-undo .
      384     do
      385       on error undo, return error
      386       :
      387       run prn-lib-get-report-name  in this-procedure (
      388         input parParentProc
      389         ,output v-report-name
      390         ).
      391   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      393     (input  v-report-name
      394     ,input  2
      395     ,output v-exist
      396     )  .
      397       if NOT v-exist then
      398       DO:
      399         Message
      400           "Нет заданий на печать ! "
      401           view-as alert-box .
      402         Return  .
      403       End.
      404       run gbl/prnfilen.w
      405         (input  ""
      406         ,input  p-DisabledOptions
      407         ,input  string(v-report-name )
      408         ,input  7
      409         ,output v-user-action
      410         ,output v-printed
      411         ) .
      412       if v-printed then
      413       do:
      414         return "YES" .
      415       end.
      416       else
      417       do:
      418         return "NO" .
      419       end.
      420     end.
      421   end procedure.
      422   procedure prn-lib-open-stream :
      423     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      424     define input parameter p-page-size    as integer no-undo .
      425     define input parameter p-is-stream    as logical no-undo .
      426     define input parameter p-append       as logical no-undo .
      427     define variable v-report-name as character no-undo .
      428     do
      429       on error undo, return error
      430       :
      431       run prn-lib-get-report-name  in this-procedure (
      432         input parParentProc
      433         ,output v-report-name
      434         ).
      435       if p-is-stream then
      436       do:
      437         if p-append then
      438         do:
      439           output stream PrnLibStream to value( v-report-name )
      440             page-size value(p-page-size) append .
      441         end.
      442         if not p-append then
      443         do:
      444           output stream PrnLibStream to value( v-report-name )
      445             page-size value(p-page-size) .
      446         end.
      447       end.
      448       if not p-is-stream then
      449       do:
      450         if p-append then
      451         do:
      452           output to value( v-report-name )
      453             page-size value(p-page-size) append .
      454         end.
      455         if not p-append then
      456         do:
      457           output to value( v-report-name )
      458             page-size value(p-page-size) .
      459         end.
      460       end.
      461     end.
      462   end procedure.
      463   procedure prn-lib-open-exp :
      464     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      465     define input parameter p-is-stream    as logical no-undo .
      466     define input parameter p-is-append    as logical no-undo .
      467     define output parameter p-ReportFileName as char init "report" no-undo.
      468     define output parameter p-process as logical no-undo .
      469     define variable glog as logical no-undo .
      470     do
      471       on error undo, return error
      472       :
      473       SYSTEM-DIALOG GET-FILE p-ReportFileName
      474         TITLE      "Укажите путь"
      475         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      476         ASK-OVERWRITE
      477         CREATE-TEST-FILE
      478         SAVE-AS
      479         USE-FILENAME
      480         DEFAULT-EXTENSION "txt"
      481         UPDATE glog
      482         .
      483       if not glog then  return.
      484       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      485       if p-is-stream then
      486       do:
      487         if p-is-append then
      488         do:
      489           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      490         end.
      491         else
      492         do:
      493           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      494         end.
      495       end.
      496       else
      497       do:
      498         if p-is-append then
      499         do:
      500           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      501         end.
      502         else
      503         do:
      504           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      505         end.
      506       end.
      507       p-process = yes.
      508     end.
      509   end procedure.
      510   procedure prn-lib-get-report-name :
      511     define input parameter parParentProc  as widget-handle no-undo.
      512     define output parameter p-report-name as character no-undo .
      513     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      514   end procedure.
      515   procedure prn-lib-reportviewer-report-name :
      516     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      517     define input parameter p-report-name-html as character no-undo .
      518     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      519   end procedure.
      520   procedure prn-lib-reportviewer :
      521     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      522     define input parameter p-report-name-html as character no-undo .
      523     define input parameter p-param        as character no-undo .
      524     define variable v-excel           as character no-undo init 'TRUE' .
      525     define variable v-value-character as character no-undo .
      526     define variable v-value-integer   as character no-undo .
      527     define variable v-value-date      as date      no-undo .
      528     define variable v-value-decimal   as decimal   no-undo .
      529     define variable rep-excel         as logical   no-undo .
      530     define variable excel-string      as character no-undo .
      531     define variable v-param-type      as character no-undo .
      532     define variable v-tth             as handle    no-undo .
      533     run adm/shattri.p (
      534       input "get":U
      535       ,input  ""
      536       ,input  0
      537       ,input  'report-glob':U
      538       ,input  'rep-excel':U
      539       ,output v-value-character
      540       ,output v-value-date
      541       ,output v-value-decimal
      542       ,output v-value-integer
      543       ,output rep-excel
      544       ,output v-param-type
      545       ,INPUT-OUTPUT table-handle v-tth
      546       )  .
      547     if rep-excel then v-excel = "TRUE" .
      548     else v-excel = "FALSE" .
      549     if p-param eq ""
      550     then
      551        p-param = "EXCEL:" + v-excel.
      552     else
      553        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      554     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      555   end procedure.
      556   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   procedure cur-time :
      558      define output parameter p-today as date      no-undo .
      559      define output parameter p-time  as integer   no-undo .
      560     do
      561     on error undo, return error
      562     :
      563       define variable v-date1 as date      no-undo .
      564       define variable v-date2 as date      no-undo .
      565       define variable v-time  as integer   no-undo .
      566       assign
      567         v-date1 = today
      568         v-time  = time
      569         v-date2 = today
      570       .
      571       if v-date1 <> v-date2
      572       then do:
      573         assign
      574           v-date1 = today
      575           v-time  = v-time
      576         .
      577       end.
      578       assign
      579         p-today = v-date1
      580         p-time  = v-time
      581       .
      582     end.
      583   end.
      584   function cur-time-date returns character
      585   :
      586     return string(today, '99/99/9999':U) .
      587   end.
      588   function cur-time-mjd returns decimal
      589   :
      590     define variable v-date as date      no-undo .
      591     define variable v-time as integer   no-undo .
      592     run cur-time in this-procedure
      593       (output v-date
      594       ,output v-time
      595       ) .
      596     return integer(v-date) - 2400002 + (v-time / 86400) .
      597   end.
      598   function cur-time-get-ending-index returns integer
      599   (input p-number as integer
      600   )
      601   :
      602     if p-number < 0
      603     or p-number = ?
      604     then do:
      605       return 1 .
      606     end.
      607     define variable v-rest as integer   no-undo .
      608     assign
      609       p-number = p-number modulo 100
      610     .
      611     if p-number < 20
      612     then do:
      613       assign
      614         v-rest = p-number
      615       .
      616     end.
      617     else do:
      618       assign
      619         v-rest = p-number modulo 10
      620       .
      621     end.
      622     case v-rest :
      623       when 1
      624       then do:
      625         return 2 .
      626       end.
      627       when 2 or
      628       when 3 or
      629       when 4
      630       then do:
      631         return 3 .
      632       end.
      633       otherwise do:
      634         return 1 .
      635       end.
      636     end case .
      637   end.
      638   procedure cur-time-mjd-to-date :
      639      define input  parameter i-mjd-diff as decimal no-undo.
      640      define output parameter o-Date     as date    no-undo.
      641      define output parameter o-Time     as integer no-undo.
      642      define variable v-day-number as integer   no-undo .
      643      if    i-mjd-diff < 0
      644         or i-mjd-diff = ?
      645      then do:
      646         return "?" .
      647      end.
      648      assign
      649         v-day-number = truncate(i-mjd-diff,0).
      650         o-Date = date(v-day-number + 2400002).
      651         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      652     .
      653   end.
      654   function cur-time-mjd-to-string returns character
      655   (input p-mjd-diff as decimal
      656   )
      657   :
      658     define variable v-day-number as integer   no-undo .
      659     define variable v-seconds    as integer   no-undo .
      660     define variable v-hour       as integer   no-undo .
      661     define variable v-min        as integer   no-undo .
      662     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      663     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      664     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      665     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      666     if p-mjd-diff < 0
      667     or p-mjd-diff = ?
      668     then do:
      669       return "?" .
      670     end.
      671     assign
      672       v-day-number = integer(truncate(p-mjd-diff,0))
      673       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      674     .
      675     if v-seconds > 86400
      676     then do:
      677       assign
      678         v-seconds = 86400 - 1
      679       .
      680     end.
      681     if v-seconds < 0
      682     then do:
      683       assign
      684         v-seconds = 0
      685       .
      686     end.
      687     assign
      688       v-hour = truncate(v-seconds / 3600, 0)
      689     .
      690     assign
      691       v-seconds = v-seconds modulo 3600
      692     .
      693     assign
      694       v-min = truncate(v-seconds / 60, 0)
      695     .
      696     assign
      697       v-seconds = v-seconds modulo 60
      698     .
      699     return
      700         (if v-day-number <> 0
      701           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      702           else ""
      703         )
      704       + (if v-day-number <> 0 or v-hour <> 0
      705           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      706           else ""
      707         )
      708       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      709           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      710           else ""
      711         )
      712       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      713       .
      714   end.
      715   function cur-time-string returns character
      716   :
      717     define variable v-date as date      no-undo .
      718     define variable v-time as integer   no-undo .
      719     run cur-time in this-procedure
      720       (output v-date
      721       ,output v-time
      722       ) .
      723     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      724   end.
      725   function cur-time-string-sec returns character
      726   :
      727     define variable v-date as date      no-undo .
      728     define variable v-time as integer   no-undo .
      729     run cur-time in this-procedure
      730       (output v-date
      731       ,output v-time
      732       ) .
      733     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      734   end.
      735   function cur-time-custom  returns character
      736   (input p-prefix as character
      737   ,input p-date-format as character
      738   ,input p-delimiter as character
      739   ,input p-time-format as character
      740   ,input p-suffix as character
      741   )
      742   :
      743     define variable v-date as date      no-undo .
      744     define variable v-time as integer   no-undo .
      745     run cur-time in this-procedure
      746       (output v-date
      747       ,output v-time
      748       ) .
      749     return
      750       p-prefix
      751       + string(v-date, p-date-format)
      752       + p-delimiter
      753       + string(v-time, p-time-format)
      754       + p-suffix
      755       .
      756   end.
      757   function cur-time-print  returns character
      758   :
      759     define variable v-date as date      no-undo .
      760     define variable v-time as integer   no-undo .
      761     run cur-time in this-procedure
      762       (output v-date
      763       ,output v-time
      764       ) .
      765     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      766   end.
      767   function cur-time-datetime returns datetime
      768   :
      769     define variable v-char as character no-undo .
      770     define variable v-datetime as datetime no-undo .
      771     v-char = cur-time-string().
      772     v-datetime = datetime(v-char).
      773     return  v-datetime.
      774   end.
      775   function cur-time-string-msec returns character
      776   :
      777     define variable v-date as datetime  no-undo .
      778     v-date = now.
      779     return string(v-date) .
      780   end.
      781   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      782     define variable v-cntxt-db-num        as integer   no-undo .
      783     define variable v-cntxt-userid        as character no-undo .
      784     define variable v-cntxt-level         as character no-undo .
      785     define variable v-cntxt-host-code-obj as integer   no-undo .
      786     define variable v-cntxt-obj-type      as character no-undo .
      787     define variable v-cntxt-obj-code      as integer   no-undo .
      788     define variable v-cntxt-db-num-obj    as integer   no-undo .
      789     define variable v-cntxt-is-admin      as logical   no-undo .
      790   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791   FUNCTION mark-string RETURNS CHARACTER
      792     ( input p-recid as recid, input mark-list as character  ) :
      793     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      794   END FUNCTION.
      795   define variable v-rid-list as character no-undo .
      796   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      797   define variable sort-column-name as character no-undo .
      798   define variable v-db-num LIKE ub.db.db-num no-undo.
      799   define buffer pos_delivery-type for ub.delivery-type.
      800   DEFINE BUTTON B-add
      801        LABEL "&Добавить"
      802        SIZE 10 BY 1.
      803   DEFINE BUTTON B-chg
      804        LABEL "&Изменить"
      805        SIZE 10 BY 1.
      806   DEFINE BUTTON B-condkeep
      807        LABEL "Условия &хранения"
      808        SIZE 20 BY 1.
      809   DEFINE BUTTON B-del
      810        LABEL "&Удалить"
      811        SIZE 10 BY 1.
      812   DEFINE BUTTON B-delivsubj
      813        LABEL "&Субъекты"
      814        SIZE 10 BY 1.
      815   DEFINE BUTTON B-Help
      816        LABEL "Помо&щь"
      817        SIZE 3 BY 1
      818        BGCOLOR 8 .
      819   DEFINE BUTTON B-hist
      820        LABEL "Ис&тория"
      821        SIZE 3 BY 1.
      822   DEFINE BUTTON b-lkp
      823        LABEL "&Просмотр"
      824        SIZE 10 BY 1.
      825   DEFINE BUTTON B-mark
      826        LABEL "&*"
      827        SIZE 3 BY 1.
      828   DEFINE BUTTON B-print
      829        LABEL "Пе&чать"
      830        SIZE 3 BY 1.
      831   DEFINE BUTTON b-quit AUTO-END-KEY
      832        LABEL "&Выход"
      833        SIZE 10 BY 1
      834        BGCOLOR 8 .
      835   DEFINE BUTTON B-sel AUTO-GO
      836        LABEL "Вы&бор"
      837        SIZE 10 BY 1.
      838   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      839         VIEW-AS TEXT
      840        SIZE 6 BY 1
      841        FGCOLOR 4  NO-UNDO.
      842   DEFINE VARIABLE RS-sts AS CHARACTER
      843        VIEW-AS RADIO-SET HORIZONTAL
      844        RADIO-BUTTONS
      845             "Item 1", "1",
      846   "Item 2", "2",
      847   "Item 3", "3"
      848        SIZE 33.5 BY 1 NO-UNDO.
      849   DEFINE QUERY br-delivtype FOR
      850         X_delivery-type SCROLLING.
      851   DEFINE BROWSE br-delivtype
      852     QUERY br-delivtype NO-LOCK DISPLAY
      853         mark-string(recid(X_delivery-type), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      854         X_delivery-type.deliv-type-name FORMAT "X(50)":U
      855         entry (lookup (STRING(X_delivery-type.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) COLUMN-LABEL "Статус"
      856         X_delivery-type.des FORMAT "X(255)":U
      857         X_delivery-type.deliv-type-code FORMAT ">>9":U
      858       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.27.
      859   DEFINE FRAME Dialog-Frame
      860        b-quit AT ROW 1 COL 1
      861        B-mark AT ROW 1 COL 11
      862        B-sel AT ROW 1 COL 21
      863        B-add AT ROW 1 COL 31
      864        b-lkp AT ROW 1 COL 41
      865        B-chg AT ROW 1 COL 51
      866        B-del AT ROW 1 COL 61
      867        B-print AT ROW 1 COL 89
      868        B-hist AT ROW 1 COL 92
      869        B-Help AT ROW 1 COL 95
      870        B-delivsubj AT ROW 2 COL 51
      871        B-condkeep AT ROW 2 COL 61
      872        RS-sts AT ROW 3.5 COL 3.5 NO-LABEL
      873        br-delivtype AT ROW 5 COL 1
      874        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      875        SPACE(78.62) SKIP(20.03)
      876       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      877            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      878            TITLE "Типы доставки"
      879            CANCEL-BUTTON b-quit.
      880   ASSIGN
      881          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      882          FRAME Dialog-Frame:HIDDEN           = TRUE.
