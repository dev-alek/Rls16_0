     1002   procedure uf-get :
     1003     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1004     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1005     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1006     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1007     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1008     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1009     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1010     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1011     do
     1012     on error undo, return error
     1013     :
     1014       define buffer buf_usr-flt for ubflt.usr-flt .
     1015       define variable v-use-List_     as logical   no-undo .
     1016       define variable v-type-List_     as character no-undo .
     1017       define variable v-format-List_   as character no-undo .
     1018       define variable v-use-Naim      as logical   no-undo .
     1019       define variable v-type-Naim      as character no-undo .
     1020       define variable v-format-Naim    as character no-undo .
     1021       define variable v-use-print-graft as logical   no-undo .
     1022       define variable v-use-sort-gr     as logical   no-undo .
     1023       define variable v-use-type-price  as logical   no-undo .
     1024       define variable v-use-type-val    as logical   no-undo .
     1025       define variable v-label          as character no-undo .
     1026       define variable v-tooltip        as character no-undo .
     1027       define variable v-user-can-edit  as logical   no-undo .
     1028       define variable v-output-display as logical   no-undo .
     1029       define variable v-other          as character no-undo .
     1030       run uf-name in this-procedure
     1031          (input  entry(1, p-code, chr(4))
     1032         ,output v-use-List_
     1033         ,output v-type-List_
     1034         ,output v-format-List_
     1035         ,output v-use-Naim
     1036         ,output v-type-Naim
     1037         ,output v-format-Naim
     1038         ,output v-use-print-graft
     1039         ,output v-use-sort-gr
     1040         ,output v-use-type-price
     1041         ,output v-use-type-val
     1042         ,output v-label
     1043         ,output v-tooltip
     1044         ,output v-user-can-edit
     1045         ,output v-output-display
     1046         ,output v-other
     1047         ) no-error .
     1048       if error-status :error then do:
     1049         undo, return error return-value .
     1050       end.
     1051       find first buf_usr-flt no-lock where
     1052                  buf_usr-flt.Call-point     = p-code AND
     1053                  buf_usr-flt.user-name       = p-user-name
     1054         no-error .
     1055       if avail buf_usr-flt then do:
     1056         assign
     1057         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1058         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1059         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1060         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1061         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1062         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1063         .
     1064       end.
     1065       else do:
     1066         assign
     1067         p-List_        = (if v-use-List_       then "":U                    else ?)
     1068         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1069         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1070         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1071         p-type-price   = (if v-use-type-price  then no                      else ?)
     1072         p-type-val     = (if v-use-List_       then no                      else ?)
     1073         .
     1074       end.
     1075     end.
     1076   end procedure.
     1077   procedure uf-set :
     1078     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1079     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1080     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1081     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1082     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1083     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1084     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1085     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1086     do
     1087     on error undo, return error
     1088     :
     1089       define buffer buf_usr-flt for ubflt.usr-flt .
     1090       define variable v-use-List_     as logical   no-undo .
     1091       define variable v-type-List_     as character no-undo .
     1092       define variable v-format-List_   as character no-undo .
     1093       define variable v-use-Naim      as logical   no-undo .
     1094       define variable v-type-Naim      as character no-undo .
     1095       define variable v-format-Naim    as character no-undo .
     1096       define variable v-use-print-graft as logical   no-undo .
     1097       define variable v-use-sort-gr   as logical   no-undo .
     1098       define variable v-use-type-price as logical   no-undo .
     1099       define variable v-use-type-val  as logical   no-undo .
     1100       define variable v-tooltip        as character no-undo .
     1101       define variable v-label          as character no-undo .
     1102       define variable v-user-can-edit  as logical   no-undo .
     1103       define variable v-output-display as logical   no-undo .
     1104       define variable v-other          as character no-undo .
     1105       run uf-name in this-procedure
     1106         (input  entry(1, p-code, chr(4))
     1107         ,output v-use-List_
     1108         ,output v-type-List_
     1109         ,output v-format-List_
     1110         ,output v-use-Naim
     1111         ,output v-type-Naim
     1112         ,output v-format-Naim
     1113         ,output v-use-print-graft
     1114         ,output v-use-sort-gr
     1115         ,output v-use-type-price
     1116         ,output v-use-type-val
     1117         ,output v-label
     1118         ,output v-tooltip
     1119         ,output v-user-can-edit
     1120         ,output v-output-display
     1121         ,output v-other
     1122         ) no-error .
     1123       if error-status :error then do:
     1124         undo, return error return-value .
     1125       end.
     1126       find first buf_usr-flt where
     1127                  buf_usr-flt.Call-point     = p-code AND
     1128                  buf_usr-flt.user-name       = p-user-name
     1129         no-error .
     1130       if not avail buf_usr-flt then do:
     1131           create buf_usr-flt .
     1132           assign
     1133           buf_usr-flt.call-point = p-code
     1134           buf_usr-flt.user-name  = p-user-name
     1135           .
     1136       end.
     1137       if avail buf_usr-flt then do:
     1138        assign
     1139        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1140        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1141        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1142        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1143        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1144        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1145       .
     1146       release buf_usr-flt.
     1147       end.
     1148       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1149     end.
     1150   end procedure.
     1151   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1152   FUNCTION mark-string RETURNS CHARACTER
     1153     ( input p-recid as recid, input mark-list as character  ) :
     1154     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1155   END FUNCTION.
     1156   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1157   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1158   procedure fltopend_fltopend :
     1159   define input parameter p-parent-handle as handle no-undo .
     1160   define input parameter p-qh as handle no-undo .
     1161   define input parameter p-flt-open-open-query  as character no-undo .
     1162   define input parameter p-where-cond as character no-undo .
     1163   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1164   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1165   define input parameter p-indexed-reposition as character no-undo .
     1166     do
     1167     on error undo, return error
     1168     :
     1169   define variable v-prepare-string as character no-undo .
     1170   define variable glog as logical no-undo .
     1171   assign
     1172   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1173                      p-where-cond + chr(32)  +
     1174                      p-use-indFIRST-query-tail + chr(32) +
     1175                      p-use-ind-sort-clmn-by + chr(32) +
     1176                      p-indexed-reposition
     1177   .
     1178   assign
     1179   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1180   if not glog
     1181   or error-status:error then do:
     1182     message error-status:get-message(1) view-as alert-box .
     1183     undo, return error .
     1184   end.
     1185   assign
     1186   glog = p-qh:query-open no-error .
     1187   if not glog
     1188   or error-status:error then do:
     1189     message error-status:get-message(1) view-as alert-box .
     1190     undo, return error .
     1191   end.
     1192     end.
     1193   end procedure.
     1194   procedure fltopend_fltfindd :
     1195   define input parameter p-parent-handle as handle no-undo .
     1196   define input parameter p-qh as handle no-undo .
     1197   define input parameter p-rowid as rowid no-undo .
     1198   define input parameter p-next as logical no-undo .
     1199   define input parameter p-lock as integer no-undo .
     1200   define input parameter p-bh as handle no-undo .
     1201   define input parameter p-where-cond as character no-undo .
     1202   define input parameter p-use-index-phrase as character no-undo .
     1203   define variable glog as logical no-undo .
     1204   define variable v-qh as handle no-undo .
     1205   define variable v-bh as handle no-undo .
     1206   define variable v-recid as recid no-undo .
     1207   define variable v-prepare-string as character no-undo .
     1208   do
     1209   on error undo, return error
     1210   on stop undo, return error
     1211   :
     1212     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1213     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1214     create query v-qh.
     1215     v-qh:set-buffers(v-bh).
     1216     v-prepare-string = substitute("for each &1 &2 &3"
     1217                                     ,v-bh:name
     1218                                     ,p-where-cond
     1219                                     ,p-use-index-phrase).
     1220     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1221     if not glog then do:
     1222       delete object v-qh.
     1223       delete object v-bh.
     1224       undo, return error .
     1225     end.
     1226     glog = v-qh:query-open no-error .
     1227     if not glog then do:
     1228       delete object v-qh.
     1229       delete object v-bh.
     1230       undo, return error .
     1231     end.
     1232     if p-next then do:
     1233       v-qh:reposition-to-rowid(p-rowid) no-error .
     1234       glog = v-qh:get-next( p-lock) no-error .
     1235       glog = v-qh:get-next( p-lock) no-error .
     1236       if not glog or v-qh:query-off-end = yes then do:
     1237         glog = v-qh:get-first( p-lock) no-error .
     1238       end.
     1239     end.
     1240     else do:
     1241       glog = v-qh:get-first( p-lock) no-error .
     1242     end.
     1243     v-recid = v-bh:recid no-error .
     1244     delete object v-qh.
     1245     delete object v-bh.
     1246     return string(v-recid) .
     1247   end.
     1248   end procedure.
     1249   procedure fltopend_fltfindq :
     1250   define input parameter p-parent-handle as handle no-undo .
     1251   define input parameter p-qh as handle no-undo .
     1252   define input parameter p-next as logical no-undo .
     1253   define input parameter p-lock as integer no-undo .
     1254   define input parameter p-flt-open-open-query  as character no-undo .
     1255   define input parameter p-where-cond as character no-undo .
     1256   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1257   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1258   define input parameter p-indexed-reposition as character no-undo .
     1259   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1260   define variable glog as logical no-undo .
     1261   define variable v-qh as handle no-undo .
     1262   define variable v-bh as handle no-undo extent 18.
     1263   define variable v-rowid as rowid no-undo extent 18.
     1264   define variable v-ii as integer no-undo .
     1265   define variable v-prepare-string as character no-undo .
     1266   do
     1267   on error undo, return error
     1268   on stop undo, return error
     1269   :
     1270     create query v-qh.
     1271     do v-ii = 1 to p-qh:num-buffers:
     1272       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1273       assign
     1274       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1275       no-error.
     1276       v-qh:add-buffer(v-bh[v-ii]).
     1277     end.
     1278     assign
     1279     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1280                       p-where-cond + chr(32)  +
     1281                       p-use-indFIRST-query-tail + chr(32) +
     1282                       p-use-ind-sort-clmn-by + chr(32) +
     1283                       p-indexed-reposition
     1284     .
     1285     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1286     if not glog then do:
     1287       delete object v-qh.
     1288       do v-ii = 1 to p-qh:num-buffers:
     1289         delete object v-bh[v-ii].
     1290       end.
     1291       undo, return error .
     1292     end.
     1293     glog = v-qh:query-open no-error .
     1294     if not glog then do:
     1295       delete object v-qh.
     1296       do v-ii = 1 to p-qh:num-buffers:
     1297         delete object v-bh[v-ii].
     1298       end.
     1299       undo, return error .
     1300     end.
     1301     if p-next then do:
     1302       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1303       glog = v-qh:get-next( p-lock) no-error .
     1304       glog = v-qh:get-next( p-lock) no-error .
     1305       if not glog or v-qh:query-off-end = yes then do:
     1306         glog = v-qh:get-first( p-lock) no-error .
     1307       end.
     1308     end.
     1309     else do:
     1310       glog = v-qh:get-first( p-lock) no-error .
     1311     end.
     1312     do v-ii = 1 to p-qh:num-buffers:
     1313       assign
     1314       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1315       no-error.
     1316     end.
     1317     delete object v-qh.
     1318     do v-ii = 1 to p-qh:num-buffers:
     1319       delete object v-bh[v-ii].
     1320     end.
     1321   end.
     1322   end procedure.
     1323   define variable log-res as log no-undo.
     1324   define variable choice as log no-undo.
     1325   define variable ri-str  as char no-undo.
