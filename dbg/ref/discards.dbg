     4230   procedure get-context :
     4231      define output parameter p-db-num as integer          no-undo.
     4232      define output parameter p-user-id as character        no-undo.
     4233      define variable v-login               as character    no-undo.
     4234      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4235      define buffer buf_user-login  for ub.user-login .
     4236      do
     4237      on error undo, return error
     4238      :
     4239            FIND FIRST buf_sys-ctrl no-lock.
     4240            ASSIGN
     4241               v-login = USERID("ub")
     4242               p-db-num = buf_sys-ctrl.db-num
     4243            .
     4244            FIND FIRST buf_user-login
     4245                 WHERE buf_user-login.db-num = p-db-num
     4246                   AND buf_user-login.user-login = v-login
     4247                 no-lock
     4248                 no-error
     4249                 .
     4250            IF AVAILABLE buf_user-login
     4251            THEN DO:
     4252               assign
     4253                  p-user-id = buf_user-login.user-id
     4254               .
     4255            END.
     4256      end.
     4257   end procedure.
     4258       run diasize_init in this-procedure .
