     6722   PROCEDURE proc-b-disc :
     6723   DEFINE variable v-is-error AS LOGICAL NO-UNDO.
     6724   DEFINE variable v-update-dccr AS LOGICAL NO-UNDO.
     6725   define variable loc#log as logical no-undo .
     6726   IF NOT AVAILABLE X_dis-card THEN DO:
     6727      disc-option = '':U.
     6728      RETURN NO-APPLY.
     6729   END.
     6730   IF disc-option = 'ИЗМЕНЕНИЕ':U THEN DO:
     6731   define variable vss-include-info62 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6732   do:
     6733     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6734       (input  v-cntxt-db-num
     6735       ,input  v-cntxt-userid
     6736       ,input  0
     6737       ,input  'actn_referense-dis_input-deletion-updating':U
     6738       ,input  'firm':U
     6739       ,input  p-curr-host-code
     6740       ,input  '':U
     6741       ,input  0
     6742       ,input  0
     6743       ,input  0
     6744       ,input  0
     6745       ,input  false
     6746       ,output loc#log
     6747       )  .
     6748   end.
     6749   END.
     6750   run ref/ddcrattr.p (
     6751                  input parparentproc
     6752                 ,input disc-option
     6753                 ,input X_dis-card.d-card
     6754                 ,input p-curr-host-code
     6755                 ,input p-curr-obj-type
     6756                 ,input p-curr-obj-code
     6757                 ,input yes
     6758                 ,output v-update-dccr
     6759                 ,output v-is-error
     6760                 ) no-error .
     6761   if error-status :error
     6762   or v-is-error
     6763   then do:
     6764     message
     6765     "Ошибка при вызове списка скидок ДК" skip
     6766     error-status:get-message(1) skip
     6767     return-value
     6768     view-as alert-box .
     6769     disc-option = '':U.
     6770     undo, return error.
     6771   end.
     6772   END PROCEDURE.
     6773   PROCEDURE proc-b-history :
     6774   DEFINE INPUT PARAMETER loc-option as character no-undo.
     6775   define variable parref-list as character no-undo .
