     1352   define variable v-host-code like ub.sysconf.host-code no-undo .
     1353   DEFINE VARIABLE v-cli-name AS CHARACTER NO-UNDO.
     1354   DEFINE VARIABLE v-cli-type-code AS CHARACTER NO-UNDO.
     1355   define variable sort-column-name as character no-undo .
     1356   define variable v-doc-rec as recid no-undo .
     1357   define variable v-initial-height as decimal no-undo .
     1358   define buffer pos_dis-card for ub.dis-card.
