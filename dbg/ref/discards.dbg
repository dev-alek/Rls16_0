      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable c-point  as character no-undo .
      126   define variable tbl      as character no-undo .
      127   define variable join-tbl as character no-undo .
      128   define variable fld      as character no-undo .
      129   define variable lab      as character no-undo .
      130   define variable spr      as character no-undo .
      131   define variable dim      as character no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   procedure cur-time :
      134      define output parameter p-today as date      no-undo .
      135      define output parameter p-time  as integer   no-undo .
      136     do
      137     on error undo, return error
      138     :
      139       define variable v-date1 as date      no-undo .
      140       define variable v-date2 as date      no-undo .
      141       define variable v-time  as integer   no-undo .
      142       assign
      143         v-date1 = today
      144         v-time  = time
      145         v-date2 = today
      146       .
      147       if v-date1 <> v-date2
      148       then do:
      149         assign
      150           v-date1 = today
      151           v-time  = v-time
      152         .
      153       end.
      154       assign
      155         p-today = v-date1
      156         p-time  = v-time
      157       .
      158     end.
      159   end.
      160   function cur-time-date returns character
      161   :
      162     return string(today, '99/99/9999':U) .
      163   end.
      164   function cur-time-mjd returns decimal
      165   :
      166     define variable v-date as date      no-undo .
      167     define variable v-time as integer   no-undo .
      168     run cur-time in this-procedure
      169       (output v-date
      170       ,output v-time
      171       ) .
      172     return integer(v-date) - 2400002 + (v-time / 86400) .
      173   end.
      174   function cur-time-get-ending-index returns integer
      175   (input p-number as integer
      176   )
      177   :
      178     if p-number < 0
      179     or p-number = ?
      180     then do:
      181       return 1 .
      182     end.
      183     define variable v-rest as integer   no-undo .
      184     assign
      185       p-number = p-number modulo 100
      186     .
      187     if p-number < 20
      188     then do:
      189       assign
      190         v-rest = p-number
      191       .
      192     end.
      193     else do:
      194       assign
      195         v-rest = p-number modulo 10
      196       .
      197     end.
      198     case v-rest :
      199       when 1
      200       then do:
      201         return 2 .
      202       end.
      203       when 2 or
      204       when 3 or
      205       when 4
      206       then do:
      207         return 3 .
      208       end.
      209       otherwise do:
      210         return 1 .
      211       end.
      212     end case .
      213   end.
      214   procedure cur-time-mjd-to-date :
      215      define input  parameter i-mjd-diff as decimal no-undo.
      216      define output parameter o-Date     as date    no-undo.
      217      define output parameter o-Time     as integer no-undo.
      218      define variable v-day-number as integer   no-undo .
      219      if    i-mjd-diff < 0
      220         or i-mjd-diff = ?
      221      then do:
      222         return "?" .
      223      end.
      224      assign
      225         v-day-number = truncate(i-mjd-diff,0).
      226         o-Date = date(v-day-number + 2400002).
      227         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229   end.
      230   function cur-time-mjd-to-string returns character
      231   (input p-mjd-diff as decimal
      232   )
      233   :
      234     define variable v-day-number as integer   no-undo .
      235     define variable v-seconds    as integer   no-undo .
      236     define variable v-hour       as integer   no-undo .
      237     define variable v-min        as integer   no-undo .
      238     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      239     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      240     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      241     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      242     if p-mjd-diff < 0
      243     or p-mjd-diff = ?
      244     then do:
      245       return "?" .
      246     end.
      247     assign
      248       v-day-number = integer(truncate(p-mjd-diff,0))
      249       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      250     .
      251     if v-seconds > 86400
      252     then do:
      253       assign
      254         v-seconds = 86400 - 1
      255       .
      256     end.
      257     if v-seconds < 0
      258     then do:
      259       assign
      260         v-seconds = 0
      261       .
      262     end.
      263     assign
      264       v-hour = truncate(v-seconds / 3600, 0)
      265     .
      266     assign
      267       v-seconds = v-seconds modulo 3600
      268     .
      269     assign
      270       v-min = truncate(v-seconds / 60, 0)
      271     .
      272     assign
      273       v-seconds = v-seconds modulo 60
      274     .
      275     return
      276         (if v-day-number <> 0
      277           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      278           else ""
      279         )
      280       + (if v-day-number <> 0 or v-hour <> 0
      281           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      282           else ""
      283         )
      284       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      285           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      286           else ""
      287         )
      288       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      289       .
      290   end.
      291   function cur-time-string returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-string-sec returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      310   end.
      311   function cur-time-custom  returns character
      312   (input p-prefix as character
      313   ,input p-date-format as character
      314   ,input p-delimiter as character
      315   ,input p-time-format as character
      316   ,input p-suffix as character
      317   )
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return
      326       p-prefix
      327       + string(v-date, p-date-format)
      328       + p-delimiter
      329       + string(v-time, p-time-format)
      330       + p-suffix
      331       .
      332   end.
      333   function cur-time-print  returns character
      334   :
      335     define variable v-date as date      no-undo .
      336     define variable v-time as integer   no-undo .
      337     run cur-time in this-procedure
      338       (output v-date
      339       ,output v-time
      340       ) .
      341     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      342   end.
      343   function cur-time-datetime returns datetime
      344   :
      345     define variable v-char as character no-undo .
      346     define variable v-datetime as datetime no-undo .
      347     v-char = cur-time-string().
      348     v-datetime = datetime(v-char).
      349     return  v-datetime.
      350   end.
      351   function cur-time-string-msec returns character
      352   :
      353     define variable v-date as datetime  no-undo .
      354     v-date = now.
      355     return string(v-date) .
      356   end.
      357   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   define variable v-waitfram-action01         as character   no-undo .
      359   define variable v-waitfram-action02         as character   no-undo .
      360   define variable v-waitfram-action03         as character   no-undo .
      361   define variable mWaitFramTextBeg            as character   no-undo.
      362   define variable mWaitFramTextEnd            as character   no-undo.
      363   define variable mWaitFramView               as logical     no-undo.
      364   define variable mWaitProcEvent              as logical     no-undo init yes.
      365   define variable mWaitFramInterval           as integer     no-undo init 1 .
      366   define variable mWaitFramStop               as logical     no-undo.
      367   define variable mWaitFramStopUser           as logical     no-undo.
      368   define variable mWaitFramStopTimeOut        as logical     no-undo.
      369   define variable mWaitFramStartProc          as datetime-tz no-undo.
      370   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      371   define button B-WaitFramStop auto-end-key
      372        label "Стоп"
      373        size 10 by 1 tooltip "Остоновить процесс".
      374   define button B-viewProcInfo
      375        label "Информация"
      376        size 15 by 1 tooltip "Информация о процесс".
      377   define frame waitfram
      378     v-waitfram-action01 format "x(72)" no-label skip
      379     v-waitfram-action02 format "x(72)" no-label skip
      380     v-waitfram-action03 format "x(72)" no-label skip
      381     B-viewProcInfo
      382     B-WaitFramStop at row 4 col 30
      383     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      384     .
      385   define new global shared variable mBatchMode as logical no-undo init ?.
      386   define variable mFramBachModHandle as handle no-undo.
      387   mFramBachModHandle = frame waitfram:handle.
      388   define variable mFameOldVis as logical no-undo.
      389   define variable mVisCUrentVin as logical no-undo.
      390   if session:batch-mode
      391   then
      392      mBatchMode = yes.
      393   if mBatchMode = ? then do:
      394     mVisCUrentVin = current-window:visible.
      395     mFameOldVis = mFramBachModHandle:visible.
      396     mFramBachModHandle:visible  = yes.
      397     mBatchMode = mFramBachModHandle:visible ne yes.
      398     mFramBachModHandle:visible = mFameOldVis.
      399     current-window:visible = mVisCUrentVin.
      400   end.
      401    if  log-manager:logfile-name ne ?
      402     then DO:
      403         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      404         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      405         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      406     end.
      407   on choose of B-WaitFramStop in frame waitfram
      408   do:
      409     mWaitFramStop = yes.
      410     mWaitFramStopUser = yes.
      411   end.
      412   function waitfram-check-timeout returns logical():
      413      define variable vtime as int64 no-undo.
      414      if mWaitFramStopTimeOut
      415      then
      416         return yes.
      417      vtime = ( now - mWaitFramStartProc ) / 1000 .
      418      if     mWaitFramTimeOut ne ?
      419         and mWaitFramTimeOut ne 0
      420         and mWaitFramTimeOut lt vtime
      421      then do:
      422         mWaitFramStopTimeOut = yes.
      423      end.
      424      return mWaitFramStopTimeOut.
      425   end.
      426   procedure waitfram-hide :
      427     if not session:batch-mode
      428     then do
      429     on error undo, return error return-value
      430     :
      431       pause 0 before-hide .
      432       if not mBatchMode then
      433         hide frame waitfram .
      434     if     not mWaitFramView
      435        and mWaitProcEvent
      436     then
      437       process events .
      438     end.
      439   end procedure.
      440   procedure waitfram-show :
      441     define input  parameter p-message as character no-undo .
      442     define variable v-left-margin as integer   no-undo .
      443     if not session:batch-mode
      444     then do
      445     on error undo, return error return-value
      446     :
      447       if length(p-message) <= 70 then do:
      448         assign
      449           v-left-margin = integer((70 - length(p-message)) / 2)
      450         .
      451         assign
      452           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      453         .
      454         assign
      455           v-waitfram-action01 = " "
      456           v-waitfram-action02 = " "
      457                                    + fill(" ", v-left-margin)
      458                                    + p-message
      459           v-waitfram-action03 = " "
      460         .
      461       end.
      462       else do:
      463         define variable vRindex1 as integer no-undo.
      464         define variable vRindex2 as integer no-undo.
      465         vRindex1 = r-index(p-message," ",70).
      466         if vRindex1 = 0
      467         then
      468            vRindex1 = 70.
      469         if length(p-message)  <= vRindex1 + 70 then do:
      470           assign
      471             v-waitfram-action01 = " "
      472             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      473             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      474           .
      475         end.
      476         else do:
      477           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      478           if vRindex2 <= vRindex1
      479           then
      480              vRindex2 = vRindex1 + 70.
      481           assign
      482             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      483             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      484             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      485           .
      486         end.
      487       end.
      488       B-viewProcInfo:visible   in frame waitfram = no.
      489       B-viewProcInfo:sensitive in frame waitfram = no.
      490       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      491       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      492       if  (   mWaitFramView
      493          or  mWaitProcEvent)
      494          and not mBatchMode
      495       then
      496          display
      497             v-waitfram-action01 skip
      498             v-waitfram-action02 skip
      499             v-waitfram-action03 skip
      500          with frame waitfram .
      501       if     mWaitFramView
      502          then do:
      503             if     mWaitFramInterval ne ?
      504                and not mBatchMode
      505             then
      506                wait-for go of frame waitfram pause mWaitFramInterval.
      507          end.
      508          else
      509             if     mWaitProcEvent
      510                and not mBatchMode
      511             then
      512                process events .
      513     end.
      514   end procedure.
      515      procedure waitfram-show-this:
      516         define input  parameter iInterval as int64 no-undo.
      517         define variable vtime as int64 no-undo.
      518         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      519         mWaitFramInterval = iInterval.
      520         run waitfram-show (substitute("&1&2 &3&4" ,
      521                                       mWaitFramTextBeg ,
      522                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      523                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      524                                       mWaitFramTextEnd
      525                                      )
      526                           ).
      527      end.
      528      procedure WaitFramRunPause:
      529         define input  parameter iInterval as dec no-undo.
      530         define variable vStart  as datetime-tz no-undo.
      531         define variable vend    as datetime-tz no-undo.
      532         define variable vint as int64 no-undo.
      533         define variable vOk as logical no-undo.
      534         vStart = now.
      535         vend   = vStart.
      536         publish "WaitFramPause" (iInterval,output vOk).
      537         vend   =  now.
      538         vint = vend - vStart.
      539         vint = iInterval - vint / 1000.
      540         if     not mWaitFramStop
      541            and (   vint > 0
      542                 or (    not vOk
      543                     and iInterval eq ?
      544                     )
      545                 )
      546         then
      547            run waitfram-show-this (iInterval).
      548         vend   =  now.
      549         vint = vend - vStart.
      550         vint = iInterval - vint / 1000.
      551         if     not mWaitFramStop
      552            and vint > 0
      553         then do:
      554            run gbl/pause.p (vint * 1000).
      555         end.
      556         if iInterval ne ?
      557         then
      558            publish "WaitFramStop".
      559         waitfram-check-timeout().
      560      end.
      561      procedure WaitFramWaitFor:
      562         define input  parameter iInterval as dec no-undo.
      563         assign
      564            mWaitFramStartProc   = now
      565            mWaitFramStopUser    = no
      566            mWaitFramStopTimeOut = no
      567         .
      568         block-wait:
      569         do while not mWaitFramStop:
      570            run WaitFramRunPause (iInterval).
      571            if  waitfram-check-timeout()
      572            then do:
      573               leave block-wait.
      574            end.
      575         end.
      576         run waitfram-hide.
      577      end.
      578   procedure waitfram-join :
      579     define input  parameter p-line-1  as character no-undo .
      580     define input  parameter p-line-2  as character no-undo .
      581     define input  parameter p-line-3  as character no-undo .
      582     define output parameter p-message as character no-undo .
      583     do
      584     on error undo, return error return-value
      585     :
      586       assign
      587         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      588                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      589                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      590       .
      591     end.
      592   end procedure.
      593   function waitfram-join-function returns character
      594     (input p-line-1 as character
      595     ,input p-line-2 as character
      596     ,input p-line-3 as character
      597     ).
      598     define variable v-message as character no-undo .
      599     run waitfram-join in this-procedure
      600       (input  p-line-1
      601       ,input  p-line-2
      602       ,input  p-line-3
      603       ,output v-message
      604       ) .
      605     return v-message .
      606   end function .
      607   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   define variable dcard-algo-field-name as character no-undo extent 3 init [
      610    'd-pcnt':U
      611   ,'cash-d-pcnt':U
      612   ,'pcnt-kat':U].
      613   define variable algo-field-abbr as character no-undo extent 3 init [
      614    'ITEM%':U
      615   ,'TOTAL%':U
      616   ,'CATEG':U].
      617   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
      618   define variable v-date-str as character no-undo .
      619   assign
      620   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
      621                string(Month(p-date), "99":U) + chr(47) +
      622                string(DAY(p-date), "99":U).
      623   return v-date-str.
      624   END FUNCTION.
      625   function dct-algo-string-to-date returns date ( input p-string  as character):
      626     define variable v-date as date no-undo .
      627     assign
      628     v-date = date(integer(substring(p-string, 6, 2))
      629                   ,integer(substring(p-string, 9, 2))
      630                   ,integer(substring(p-string, 1, 4))
      631                  ) no-error .
      632     if error-status:error then return ?.
      633     return v-date.
      634   END FUNCTION.
      635   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
      636   define buffer buf_prop-ref for ub.prop-ref.
      637   find first buf_prop-ref no-lock where
      638             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
      639   if not available buf_prop-ref then do:
      640     return chr(63).
      641   end.
      642   return buf_prop-ref.sum-id.
      643   END FUNCTION.
      644   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
      645   define variable v-des as character no-undo .
      646   define buffer buf_prop-ref for ub.prop-ref.
      647   define buffer buf_prop-head for ub.prop-head.
      648   find first buf_prop-ref no-lock where
      649             buf_prop-ref.dt-code = p-dt-code no-error.
      650   if not available buf_prop-ref then do:
      651     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      652   end.
      653   find first buf_prop-head no-lock where
      654           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
      655   if not available buf_prop-head then do:
      656     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
      657   end.
      658   assign
      659   v-des = substitute("&1  &2 &3"
      660                     , buf_prop-head.prop-name
      661                     , buf_prop-ref.sum-id
      662                     , buf_prop-ref.caller_id).
      663   return v-des.
      664   end FUNCTION.
      665   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
      666                                                               ,input p-dt-code as integer
      667                                                               ,input p-node-code as integer
      668                                                               ):
      669   define variable v-des as character no-undo .
      670   define buffer buf_prop-ref for ub.prop-ref.
      671   define buffer buf_prop-head for ub.prop-head.
      672   define buffer buf_prop-map for ub.prop-map.
      673   find first buf_prop-ref no-lock where
      674             buf_prop-ref.dt-code = p-dt-code no-error.
      675   if not available buf_prop-ref then do:
      676     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      677   end.
      678   find first buf_prop-head no-lock where
      679           buf_prop-head.dtm-code = p-dtm-code no-error.
      680   if not available buf_prop-head then do:
      681     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
      682   end.
      683   find first buf_prop-map no-lock where
      684           buf_prop-map.dtm-code = p-dtm-code
      685       and buf_prop-map.node-code = p-node-code no-error .
      686   if not available buf_prop-map then do:
      687     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
      688                       , p-dt-code
      689                       , buf_prop-head.prop-label
      690                       , p-node-code).
      691   end.
      692   assign
      693   v-des = substitute("&1.&2 &3 &4"
      694                     , buf_prop-head.prop-label
      695                     , buf_prop-map.node-label
      696                     , buf_prop-ref.sum-id
      697                     , buf_prop-ref.caller_id).
      698   return v-des.
      699   end FUNCTION.
      700   function dct-algo-get-prev-sum-id RETURNS integer (
      701                                                       input p-dt-code as integer
      702                                                      ):
      703   define variable v-dtm-code as integer no-undo .
      704   define variable v-sum-id as character no-undo .
      705   define variable v-caller-id as character no-undo .
      706   define buffer buf_prop-ref for ub.prop-ref.
      707   find first buf_prop-ref no-lock where
      708           buf_prop-ref.dt-code = p-dt-code no-error.
      709   if not available buf_prop-ref then return ?.
      710   assign
      711   v-dtm-code = buf_prop-ref.dtm-code
      712   v-sum-id = buf_prop-ref.sum-id.
      713   v-caller-id = buf_prop-ref.caller_id.
      714   find last buf_prop-ref no-lock where
      715             buf_prop-ref.dtm-code = v-dtm-code
      716        and  buf_prop-ref.sum-id < v-sum-id
      717        and  buf_prop-ref.caller_id = v-caller-id
      718        no-error.
      719   if available buf_prop-ref then return buf_prop-ref.dt-code.
      720   return -1 .
      721   END FUNCTION.
      722   FUNCTION dct-algo-get_dcproperty-value returns logical (
      723                                                             input p-prop-name as character
      724                                                           , input p-d-card    as character
      725                                                           , input p-host-code as integer
      726                                                           , input p-obj-type  as character
      727                                                           , input p-obj-code  as integer
      728                                                           , output p-value-character as character
      729                                                           , output p-value-date   as date
      730                                                           , output p-value-integer as integer
      731                                                           , output p-value-decimal as decimal
      732                                                           , output p-value-logical as logical):
      733     return no.
      734   END FUNCTION.
      735   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
      736                                                             input p-d-card    as character
      737                                                           , input p-emitent-host-code as integer
      738                                                           , input p-type as character
      739                                                           , input p-host-code as integer
      740                                                           , input p-obj-type  as character
      741                                                           , input p-obj-code  as integer
      742                                                           , output p-value-chr as character):
      743   define variable v-dt-code as integer no-undo .
      744   define variable v-node-code as integer no-undo .
      745   define variable v-field-name as character no-undo .
      746   define variable v-storage-place as character no-undo .
      747   define variable v-sum-id-value as character no-undo .
      748   define variable v-sum-id-output as logical no-undo .
      749   define variable v-value-chr as character no-undo .
      750   define variable v-ii as integer no-undo .
      751   define buffer buf_dis-card-property for ub.dis-card-property.
      752   define buffer buf_dis-host for ub.dis-host.
      753   define buffer buf_dis-obj for ub.dis-obj.
      754   run get-cd-sumid in this-procedure (
      755                                         input p-emitent-host-code
      756                                        ,input p-type
      757                                        ,input p-host-code
      758                                        ,input p-obj-type
      759                                        ,input p-obj-code
      760                                        ,output v-sum-id-value
      761                                        ,output v-sum-id-output
      762                                       ) no-error.
      763   if not v-sum-id-output then do:
      764     return no.
      765   end.
      766   do v-ii = 1 to num-entries(v-sum-id-value):
      767     assign
      768     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
      769     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
      770     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
      771     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
      772     no-error .
      773     if not error-status:error then do:
      774       case v-storage-place:
      775         when 'dis-card-property':U then do:
      776           find first buf_dis-card-property no-lock where
      777                     buf_dis-card-property.d-card = p-d-card
      778               and  buf_dis-card-property.host-code = p-host-code
      779               and  buf_dis-card-property.obj-type = p-obj-type
      780               and  buf_dis-card-property.obj-code = p-obj-code
      781               and  buf_dis-card-property.dt-code = v-dt-code
      782               and  buf_dis-card-property.node-code = v-node-code no-error .
      783           if available buf_dis-card-property then do:
      784             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
      785           end.
      786           else do:
      787             v-value-chr = chr(63).
      788           end.
      789         end.
      790         when 'dis-obj':U then do:
      791           find first buf_dis-obj no-lock where
      792                     buf_dis-obj.d-card = p-d-card
      793               and  buf_dis-obj.obj-type = p-obj-type
      794               and  buf_dis-obj.obj-code = p-obj-code
      795               and  buf_dis-obj.dt-code = v-dt-code no-error .
      796           if available buf_dis-obj then do:
      797             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
      798           end.
      799           else do:
      800             v-value-chr = chr(63).
      801           end.
      802         end.
      803         when 'dis-host':U then do:
      804           find first buf_dis-host no-lock where
      805                     buf_dis-host.d-card = p-d-card
      806               and  buf_dis-host.host-code = p-host-code
      807               and  buf_dis-host.dt-code = v-dt-code no-error .
      808           if available buf_dis-host then do:
      809             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
      810           end.
      811           else do:
      812             v-value-chr = chr(63).
      813           end.
      814         end.
      815       end.
      816     end.
      817     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
      818   end.
      819   END FUNCTION.
      820   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
      821     ( INPUT p-custom-sent as character ) :
      822   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
      823   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
      824   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
      825   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
      826   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
      827   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
      828   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
      829   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
      830   assign
      831   v-storage-place = entry(1, p-custom-sent, chr(4))
      832   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
      833   v-sum-id   = entry(3, p-custom-sent, chr(4))
      834   v-caller-id = entry(4, p-custom-sent, chr(4))
      835   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
      836   no-error .
      837   IF ERROR-STATUS:ERROR THEN DO:
      838     MESSAGE
      839     "Не могу разобрать строку, описывающую итог"
      840      VIEW-AS ALERT-BOX WARNING.
      841     RETURN chr(63).
      842   END.
      843   FIND FIRST buf_prop-ref NO-LOCK WHERE
      844             buf_prop-ref.dtm-code = v-dtm-code
      845        AND  buf_prop-ref.sum-id = v-sum-id
      846        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      847   IF NOT AVAILABLE buf_prop-ref THEN DO:
      848     FIND FIRST buf_prop-ref NO-LOCK WHERE
      849               buf_prop-ref.dtm-code = v-dtm-code
      850         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      851     IF NOT AVAILABLE buf_prop-ref THEN DO:
      852         MESSAGE
      853         "Не могу разобрать строку, описывающую итог"
      854          VIEW-AS ALERT-BOX WARNING.
      855         RETURN chr(63).
      856      end.
      857   end.
      858   ASSIGN
      859   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
      860                                                          ,buf_prop-ref.dt-code
      861                                                          ,v-node-code).
      862   RETURN v-sum-id-description.
      863   END FUNCTION.
      864   FUNCTION one-base-cur-for-objs  returns logical (output p-glob-curr-code as integer):
      865   define variable v-glob-val as logical no-undo init yes.
      866   define buffer buf_sysconf for ub.sysconf.
      867   define buffer buf_clients for ub.clients.
      868   assign
      869   p-glob-curr-code =  -1
      870   .
      871   FOR EACH buf_sysconf NO-LOCK,
      872       first buf_clients no-lock where
      873            buf_clients.host-code = buf_sysconf.host-code:
      874       if p-glob-curr-code = -1 then
      875       assign
      876       p-glob-curr-code = buf_sysconf.base-code
      877       .
      878       else if p-glob-curr-code <> buf_sysconf.base-code then do:
      879           assign
      880           v-glob-val = no
      881           p-glob-curr-code = ?
      882           .
      883           LEAVE.
      884       end.
      885   END.
      886   return v-glob-val.
      887   END FUNCTION.
      888   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889     define variable v-cntxt-db-num        as integer   no-undo .
      890     define variable v-cntxt-userid        as character no-undo .
      891     define variable v-cntxt-level         as character no-undo .
      892     define variable v-cntxt-host-code-obj as integer   no-undo .
      893     define variable v-cntxt-obj-type      as character no-undo .
      894     define variable v-cntxt-obj-code      as integer   no-undo .
      895     define variable v-cntxt-db-num-obj    as integer   no-undo .
      896     define variable v-cntxt-is-admin      as logical   no-undo .
      897   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      899   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      900   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      901   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      902   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      903   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      904   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      905   procedure uf-name :
      906     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      907     define output parameter p-use-List_     as logical   no-undo .
      908     define output parameter p-type-List_     as character no-undo .
      909     define output parameter p-format-List_   as character no-undo .
      910     define output parameter p-use-Naim      as logical   no-undo .
      911     define output parameter p-type-Naim      as character no-undo .
      912     define output parameter p-format-Naim    as character no-undo .
      913     define output parameter p-use-print-graft as logical   no-undo .
      914     define output parameter p-use-sort-gr   as logical   no-undo .
      915     define output parameter p-use-type-price as logical   no-undo .
      916     define output parameter p-use-type-val  as logical   no-undo .
      917     define output parameter p-label          as character no-undo .
      918     define output parameter p-tooltip        as character no-undo .
      919     define output parameter p-user-can-edit  as logical   no-undo .
      920     define output parameter p-output-display as logical   no-undo .
      921     define output parameter p-other          as character no-undo .
      922     do
      923     on error undo, return error
      924     :
      925       case p-code :
      926               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      927               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      928               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      929               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      930               when 'fbr-gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп блюд"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп блюд"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      931               when 'cli-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      932               when 'findoci-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
