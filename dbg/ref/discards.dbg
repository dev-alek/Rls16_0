     2659   ON CHOOSE OF MENU-ITEM m-block
     2660   DO:
     2661       status-type = 'блок':U.
     2662       apply "choose" to b-del in frame d-dis-card.
     2663   END.
     2664   ON CHOOSE OF MENU-ITEM m-curr
     2665   DO:
     2666       status-type = 'тек':U.
     2667       apply "choose" to b-del in frame d-dis-card.
     2668   END.
     2669   ON CHOOSE OF MENU-ITEM m-del
     2670   DO:
     2671       status-type = 'удал':U.
     2672       apply "choose" to b-del in frame d-dis-card.
     2673   END.
     2674   ON CHOOSE OF MENU-ITEM m_add
     2675   DO:
     2676      assign
     2677      new-type = "":U
     2678      add-option = 'ДОБАВЛЕНИЕ':U.
     2679     apply "CHOOSE" to b-add in frame d-dis-card.
     2680   END.
     2681   ON CHOOSE OF MENU-ITEM m_c-dc-hist
     2682   DO:
     2683         assign
     2684     hist-option = 'c-dc-hist':U.
     2685     APPLY "CHOOSE" to b-history in frame d-dis-card.
     2686   END.
     2687   ON CHOOSE OF MENU-ITEM m_c-dc-hist_plus
     2688   DO:
     2689         assign
     2690     hist-option = 'c-dc-hist-plus':U.
     2691     APPLY "CHOOSE" to b-history in frame d-dis-card.
     2692   END.
     2693   ON CHOOSE OF MENU-ITEM m_chk-doc
     2694   DO:
     2695     ASSIGN chk-OPTION = "chk-docs".
     2696     apply "CHOOSE" to b-chk in frame d-dis-card.
     2697   END.
     2698   ON CHOOSE OF MENU-ITEM m_cli-sourced
     2699   DO:
     2700     add-option = ('ИЗМЕНЕНИЕ':U + chr(44) + 'КОПИРОВАНИЕ':U).
     2701     apply "CHOOSE" to b-add in frame d-dis-card.
     2702   END.
     2703   ON CHOOSE OF MENU-ITEM m_cli-subsid
     2704   DO:
     2705     add-option = ('ДОБАВЛЕНИЕ':U + chr(44) + 'КОПИРОВАНИЕ':U).
     2706     apply "CHOOSE" to b-add in frame d-dis-card.
     2707   END.
     2708   ON CHOOSE OF MENU-ITEM m_company
     2709   DO:
     2710     new-type = 'фирма':U.
     2711     apply "CHOOSE" to b-add in frame d-dis-card.
     2712   END.
     2713   ON CHOOSE OF MENU-ITEM m_copy
     2714   DO:
     2715      assign
     2716      new-type = "":U
     2717      add-option = 'КОПИРОВАНИЕ':U.
     2718     apply "CHOOSE" to b-add in frame d-dis-card.
     2719   END.
     2720   ON CHOOSE OF MENU-ITEM m_dct-client
     2721   DO:
     2722      assign
     2723      new-type = "":U
     2724      add-option = '@client':U.
     2725     apply "CHOOSE" to b-add in frame d-dis-card.
     2726   END.
     2727   ON CHOOSE OF MENU-ITEM m_ef-cd-trans
     2728   DO:
     2729     ASSIGN chk-OPTION = "ef".
     2730     apply "CHOOSE" to b-chk in frame d-dis-card.
     2731   END.
     2732   ON CHOOSE OF MENU-ITEM m_first-main-card
     2733   DO:
     2734     ASSIGN LOOKUP-OPTION = "first-main-card".
     2735     apply "CHOOSE" to b-LKP in frame d-dis-card.
     2736   END.
     2737   ON CHOOSE OF MENU-ITEM m_glob
     2738   DO:
     2739     new-type = 'все':U.
     2740     apply "CHOOSE" to b-add in frame d-dis-card.
     2741   END.
     2742   ON CHOOSE OF MENU-ITEM m_lookup-disc
     2743   DO:
     2744     assign
     2745     disc-option = 'ПРОСМОТР':U
     2746     .
     2747     RUN proc-b-disc IN THIS-PROCEDURE NO-ERROR.
     2748     IF ERROR-STATUS:ERROR THEN do:
     2749       disc-option = '':U.
     2750       RETURN NO-APPLY.
     2751     end.
     2752     disc-option = '':U.
     2753   END.
     2754   ON CHOOSE OF MENU-ITEM m_lookup-prop
     2755   DO:
     2756       assign
     2757     prop-option = 'ПРОСМОТР':U
     2758     .
     2759     RUN proc-b-prop IN THIS-PROCEDURE NO-ERROR.
     2760     IF ERROR-STATUS:ERROR THEN do:
     2761       prop-option = '':U.
     2762       RETURN NO-APPLY.
     2763     end.
     2764     assign
     2765     prop-option = '':U.
     2766   END.
     2767   ON CHOOSE OF MENU-ITEM m_one
     2768   DO:
     2769     ASSIGN LOOKUP-OPTION = 'ПРОСМОТР':U.
     2770     apply "CHOOSE" to b-LKP in frame d-dis-card.
     2771   END.
     2772   ON CHOOSE OF MENU-ITEM m_sourced
     2773   DO:
     2774    assign
     2775    new-type = "":U
     2776    add-option =   'ИЗМЕНЕНИЕ':U + chr(44) + 'КОПИРОВАНИЕ':U.
     2777   apply "CHOOSE" to b-add in frame d-dis-card.
     2778   END.
     2779   ON CHOOSE OF MENU-ITEM m_subsid
     2780   DO:
     2781     add-option = ('ДОБАВЛЕНИЕ':U + chr(44) + 'КОПИРОВАНИЕ':U).
     2782     apply "CHOOSE" to b-add in frame d-dis-card.
     2783   END.
     2784   ON CHOOSE OF MENU-ITEM m_update-disc
     2785   DO:
     2786       assign
     2787     disc-option = 'ИЗМЕНЕНИЕ':U
     2788     .
     2789     RUN proc-b-disc IN THIS-PROCEDURE NO-ERROR.
     2790     IF ERROR-STATUS:ERROR THEN do:
     2791       disc-option = '':U.
     2792       RETURN NO-APPLY.
     2793     end.
     2794     disc-option = '':U.
     2795   END.
     2796   ON CHOOSE OF MENU-ITEM m_update-prop
     2797   DO:
     2798     assign
     2799     prop-option = 'ИЗМЕНЕНИЕ':U
     2800     .
     2801     RUN proc-b-prop IN THIS-PROCEDURE NO-ERROR.
     2802     IF ERROR-STATUS:ERROR THEN do:
     2803       prop-option = '':U.
     2804       RETURN NO-APPLY.
     2805     end.
     2806     prop-option = '':U.
     2807   END.
     2808   ON VALUE-CHANGED OF RS-global IN FRAME d-dis-card
     2809   DO:
     2810     ASSIGN
     2811     RS-GLOBAL.
     2812     assign
     2813     p-list-mode = Rs-GLobal.
     2814     run Enable_ui in this-procedure .
     2815     run OpenBr in this-procedure ( input yes, input no, input no).
     2816     if ri <> ? then
     2817     reposition br-discard to recid ri no-error.
     2818     if available X_dis-card then
     2819      log-res = br-discard:select-focused-row( ).
     2820   END.
     2821   ON VALUE-CHANGED OF RS-val IN FRAME d-dis-card
     2822   DO:
     2823    define variable v-doc-rec as recid no-undo .
     2824     if available X_dis-card then do:
     2825       v-doc-rec = recid(X_dis-card).
     2826     end.
     2827     Assign Rs-val.
     2828     run OpenBr in this-procedure ( input yes, input no, input no).
     2829     reposition br-discard to recid v-doc-rec no-error .
     2830     APPLY "ENTRY" to br-discard.
     2831     APPLY "VALUE-CHANGED" to br-discard.
     2832     IF (p-list-mode = "client":u
     2833     or p-list-mode = "card":U )
     2834     and pravo then do:
     2835         run get-totals in this-procedure No-ERROR.
     2836         if error-status:error then do:
     2837           message
     2838           substitute("Нельзя подсчитать итоги по объектам фирм с разными базовыми валютами&1или не удалось определить валюты по одной из фирм!"
     2839                      , chr(10))
     2840           view-as alert-box ERROR.
     2841           RS-val = 'rubl':U.
     2842           DISPLAY RS-VAL
     2843           WITH FRAME d-dis-card.
     2844           return no-apply.
     2845       end.
     2846     end.
     2847   END.
     2848   ON RETURN OF SPattern IN FRAME d-dis-card
     2849   OR CTRL-J OF SPattern IN FRAME d-dis-card DO:
     2850    DEFINE VARIABLE v-next AS LOGICAL NO-UNDO.
     2851    IF LAST-EVENT:LABEL = "CTRL-J" THEN DO:
     2852      v-next = YES.
     2853    END.
     2854     assign RS-SEARCH SPattern.
     2855     CASE rs-search:
     2856       WHEN 'карта':U THEN DO:
     2857          run proc-find-d-card in THIS-PROCEDURE ( INPUT v-next, input frame d-dis-card spattern) no-error.
     2858       END.
     2859       WHEN 'Контрагент':U THEN DO:
     2860         run proc-find-client in THIS-PROCEDURE ( INPUT v-next, input frame d-dis-card spattern) no-error.
     2861       END.
     2862       WHEN 'название':U THEN DO:
     2863          run proc-find-name in THIS-PROCEDURE ( INPUT v-next, input frame d-dis-card spattern) no-error.
     2864       END.
     2865     END CASE.
     2866     if error-status:error then return no-apply.
     2867   END.
     2868   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-dis-card:PARENT eq ?
     2869   THEN FRAME d-dis-card:PARENT = ACTIVE-WINDOW.
     2870   def var sort-labelbr-DISCARD   as character no-undo .
     2871   def var sort-clmnbr-DISCARD    as handle    no-undo .
     2872   def var cur-clmnbr-DISCARD     as handle    no-undo .
     2873   def var cur-clmn-locbr-DISCARD as integer   no-undo .
     2874   def var re-querybr-DISCARD     as logical   initial no no-undo .
     2875   on start-search, ctrl-o of br-DISCARD in frame d-dis-card do:
     2876      run sort-brbr-DISCARD
     2877        (input (if available X_DIS-CARD
     2878                then recid(X_DIS-CARD)
     2879                else ?
     2880               )
     2881        ).
     2882   end.
     2883   PROCEDURE sort-brbr-DISCARD :
     2884     define input parameter p-recid as recid no-undo .
     2885     if re-querybr-DISCARD = no then do:
     2886       assign
     2887          cur-clmnbr-DISCARD = br-DISCARD:current-column in frame d-dis-card
     2888       .
     2889       if sort-clmnbr-DISCARD <> ? then sort-clmnbr-DISCARD:column-fgcolor = 0.
     2890       if cur-clmnbr-DISCARD = sort-clmnbr-DISCARD then do:
     2891         assign
     2892            sort-labelbr-DISCARD = ""
     2893            sort-clmnbr-DISCARD = ?
     2894         .
     2895        end.
     2896        else do:
     2897          assign
     2898            sort-labelbr-DISCARD = cur-clmnbr-DISCARD:label
     2899            sort-clmnbr-DISCARD  = cur-clmnbr-DISCARD
     2900            sort-clmnbr-DISCARD:column-fgcolor = 4
     2901          .
     2902        end.
     2903      end.
     2904     assign
     2905       cur-clmn-locbr-DISCARD = 1
     2906     .
     2907     def var column-handle as handle no-undo .
     2908     column-handle = br-DISCARD:first-column.
     2909     do while valid-handle(column-handle) :
     2910       if column-handle = cur-clmnbr-DISCARD then do:
     2911         leave .
     2912       end.
     2913       column-handle = column-handle:NEXT-COLUMN.
     2914       assign
     2915         cur-clmn-locbr-DISCARD = cur-clmn-locbr-DISCARD + 1
     2916       .
     2917     end.
     2918     case sort-labelbr-DISCARD:
     2919           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(X_dis-card), &1&2&1)', chr(34), rid-list)     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2920           when 'Номер'  then DO:    assign       sort-column-name = "X_dis-card.d-card"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2921           when 'Название/ФИО'  then DO:    assign       sort-column-name = "X_clients.obj-name"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2922           when 'Маг-н'  then DO:    assign       sort-column-name = "X_dis-card.issue-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2923           when 'Выдано'  then DO:    assign       sort-column-name = "X_dis-card.issue-date"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2924           when 'Скидка на!товар'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-dpcn&1, X_dis-card.d-card,  X_dis-card.emitent-host-code, X_dis-card.type, &2, &1&3&1, &4, &1&5&1, X_dis-card.d-pcnt, X_dis-card.cash-d-pcnt, X_dis-card.category)', chr(34), p-curr-host-code,  p-curr-obj-type, p-curr-obj-code, 1)     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2925           when 'Статус'  then DO:    assign       sort-column-name = "X_dis-card.status_"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2926           when 'Фирма'  then DO:    assign       sort-column-name = "X_dis-card.emitent-host-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2927           when 'Перевыпуск'  then DO:    assign       sort-column-name = "X_dis-card.sourceD-card"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2928           when '#'  then DO:    assign       sort-column-name = "X_dis-card.overissue-num"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2929           when 'Перв.осн.'  then DO:    assign       sort-column-name = "X_dis-card.first-main-card"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2930           when 'Скидка на!объекте'  then DO:    assign       sort-column-name = "obj-d-pcnt"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2931           when 'Действ.по'  then DO:    assign       sort-column-name = "X_dis-card.valid-date"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2932           when 'Тип'  then DO:    assign       sort-column-name = "X_dis-card.type"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2933           when 'Кред.?'  then DO:    assign       sort-column-name = "X_dis-card.credit-card"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2934           when 'Лимит кредита!(в вал.продаж)'  then DO:    assign       sort-column-name = "X_dis-card.lim-kr"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2935           when 'Клиент'  then DO:    assign       sort-column-name = "(X_dis-card.cli-type + ' ' + STRING (X_dis-card.cli-code))"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2936           when 'Кол-во!чеков'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1Get-num-chk-l&1, &1&2&1, &3, X_dis-host.num-chk, &1X_dis-card.type&1, X_dis-card.emitent-host-code, input &4)', chr(34), rs-val, pravo, v-cntxt-db-num)     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2937           when 'Сумма покупок'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1Get-gds-sum-l&1, &1&2&1, &3, X_dis-host.gds-tot-rubl, X_dis-host.gds-tot-base)', chr(34), rs-val, pravo)     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2938           when 'Скидка'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1Get-disc-sum-l&1, &1&2&1, &3, X_dis-host.gds-dis-rubl, X_dis-host.gds-dis-base)', chr(34), rs-val, pravo)     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2939           when 'Сумма покупок!нетто'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1Get-netto-sum-l&1, &1&2&1, &3, X_dis-host.gds-tot-rubl, X_dis-host.gds-tot-base, X_dis-host.gds-dis-rubl, X_dis-host.gds-dis-base)', chr(34), rs-val, pravo)     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2940           when 'Сумма в кредит'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1Get-credit-sum-l&1, &1&2&1, &3, X_dis-host.gds-tot-rubl, X_dis-host.gds-tot-base, X_dis-host.gds-dis-rubl, X_dis-host.gds-dis-base, X_dis-host.pay-tot-rubl, X_dis-host.pay-tot-base)', chr(34), rs-val, pravo)     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2941           when 'Скидка на!итог'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-dpcn&1, X_dis-card.d-card,  X_dis-card.emitent-host-code, X_dis-card.type, &2, &1&3&1, &4, &1&5&1, X_dis-card.d-pcnt, X_dis-card.cash-d-pcnt, X_dis-card.category)',  chr(34), p-curr-host-code, p-curr-obj-type, p-curr-obj-code, 2)     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2942           when 'Использ.скидки'  then DO:    assign       sort-column-name = "entry (lookup (string(X_dis-card.d-pcnt-method), '1,2,3':U), 'Товар,Итог_чека,Товары_и_итог_чека':U)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2943           when 'Дополн?'  then DO:    assign       sort-column-name = "X_dis-card.is-subsid"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2944           when 'Основная'  then DO:    assign       sort-column-name = "X_dis-card.main-card"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2945       otherwise do:
     2946         assign
     2947           sort-column-name = ""
     2948         .
     2949         run OpenBr in this-procedure ( input yes, input no, input no).
     2950         if sort-labelbr-DISCARD <> "" then do:
     2951           assign
     2952             cur-clmnbr-DISCARD:column-fgcolor = 0
     2953           .
     2954         end.
     2955         assign
     2956           cur-clmn-locbr-DISCARD = ?
     2957         .
     2958       end.
     2959     end case.
     2960     if p-recid <> ? then do:
     2961       reposition br-DISCARD to recid p-recid no-error.
     2962       apply "value-changed" to br-DISCARD in frame d-dis-card.
     2963     end.
     2964     apply "entry" to br-DISCARD in frame d-dis-card.
     2965   END PROCEDURE.
     2966   procedure re-open-query-srt-clmnbr-DISCARD:
     2967   if cur-clmnbr-DISCARD = ? then do:
     2968      run OpenBr in this-procedure ( input yes, input no, input no).
     2969   end.
     2970   else do:
     2971      assign re-querybr-DISCARD = yes.
     2972      run sort-brbr-DISCARD
     2973        (input (if available X_DIS-CARD
     2974                then recid(X_DIS-CARD)
     2975                else ?
     2976               )
     2977        ).
     2978      assign re-querybr-DISCARD = no.
     2979   end.
     2980   end.
     2981   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2982   on help of frame d-dis-card
     2983   do:
     2984     run gbl/app_help.p
     2985       (input this-procedure :file-name
     2986       ,input ''
     2987       ,input ?
     2988       ) no-error.
     2989     if error-status :error then do:
     2990       message
     2991         "Ошибка при вызове помощи"
     2992         error-status :get-message(1)
     2993         view-as alert-box .
     2994     end.
     2995   end.
     2996   run minbtn-set in this-procedure .
     2997   on choose of b-help in frame d-dis-card
     2998   do:
     2999     apply "help":u to frame d-dis-card .
     3000   end.
     3001   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3002   procedure minbtn-set :
     3003       do
     3004           on error undo, return error return-value
     3005           :
     3006           define variable ii              as integer       no-undo .
     3007           define variable fh              as widget-handle no-undo .
     3008           define variable hh              as widget-handle no-undo .
     3009           define variable v-h             as handle        extent 4 no-undo .
     3010           define variable v-name-button   as character     no-undo .
     3011           define variable v-help-old-x    as decimal       no-undo .
     3012           define variable v-help-old-y    as decimal       no-undo .
     3013           define variable v-help-old-size as decimal       no-undo .
     3014           define variable v-frame-width   as decimal       no-undo .
     3015           define variable jj              as integer       no-undo .
     3016           do
     3017               on error undo, return error
     3018               :
     3019               assign
     3020                   v-frame-width = frame d-dis-card:width - 0.3
     3021                   fh            = frame d-dis-card:first-child
     3022                   hh            = fh:first-child
     3023                   ii            = 1
     3024                   .
     3025               do while valid-handle(hh):
     3026                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3027                   do:
     3028                       case lc(hh:name) :
     3029                           when "b-help" then
     3030                               do:
     3031                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3032                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3033                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3034                                   hh:TOOLTIP = "Помощь" .
     3035                                   v-help-old-x = hh:column .
     3036                                   v-help-old-y = hh:row    .
     3037                                   v-help-old-size = hh:width .
     3038                                   hh:width-chars = 2.5 .
     3039                               end.
     3040                           when "b-print" then
     3041                               do:
     3042                                   hh:load-image("cmp/b-print.bmp":u) .
     3043                                   hh:TOOLTIP = "Печать" .
     3044                                   v-h[ii] = hh:handle .
     3045                                   ii = ii + 1 .
     3046                                   hh:width-chars = 3 .
     3047                               end.
     3048                           when "b-history" or
     3049                           when "b-hist" then
     3050                               do:
     3051                                   hh:load-image("cmp/b-hist.bmp":u) .
     3052                                   hh:TOOLTIP = "История" .
     3053                                   v-h[ii] = hh:handle .
     3054                                   ii = ii + 1 .
     3055                                   hh:width-chars = 3 .
     3056                               end.
     3057                           when "b-sch" then
     3058                               do:
     3059                                   hh:load-image("cmp/b-sch.bmp":u) .
     3060                                   hh:TOOLTIP = "Установка Фильтра" .
     3061                                   v-h[ii] = hh:handle .
     3062                                   ii = ii + 1 .
     3063                                   hh:width-chars = 3 .
     3064                               end.
     3065                           when "b-hist-user" then
     3066                               do:
     3067                                   hh:load-image("cmp/b-hist.bmp":u) .
     3068                                   hh:TOOLTIP = "История пользователя" .
     3069                                   ii = ii + 1 .
     3070                               end.
     3071                       end case.
     3072                   end.
     3073                   hh = hh:next-sibling.
     3074               end.
     3075               b-help:column = v-frame-width - b-help:width-chars.
     3076               jj = 0.
     3077               repeat ii = 4 to 1 by -1 :
     3078                   if valid-handle (v-h[ii] ) then
     3079                   do:
     3080                       jj  = jj + 1 .
     3081                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3082                       v-h[ii]:row    = v-help-old-y .
     3083                   end.
     3084               end.
     3085           end.
     3086       end.
     3087   end procedure.
     3088   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3089   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3090   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3091   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3092   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3093   define variable v-diasize-current-frame-height as decimal   no-undo .
     3094   define variable v-diasize-change-size          as logical   no-undo .
     3095   define variable v-diasize-resize-button        as handle    no-undo .
     3096   define variable v-diasize-wndmax               as logical   no-undo .
     3097   define variable v-diasize-wndstore             as logical   no-undo .
     3098   define variable v-diasize-proc-name            as character no-undo .
     3099   define variable v-diasize-browse-handle        as handle    no-undo .
     3100   define variable v-diasize-browse-number        as integer   no-undo .
     3101   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3102   define temp-table temp-diasize-handle no-undo
     3103     field handle-value  as handle
     3104     field save-position as decimal
     3105     index xpk is primary unique handle-value
     3106     .
     3107   define temp-table temp-browse-handle no-undo
     3108     field browse-type   as character
     3109     field browse-number as integer
     3110     field browse-handle as handle
     3111     field original-size as decimal
     3112     index xpk is primary unique browse-type browse-number
     3113     index xie browse-type browse-handle
     3114   .
     3115   procedure diasize_change-height :
     3116     define input  parameter p-change-value  as decimal   no-undo .
     3117     define input  parameter p-move-resize   as logical   no-undo .
     3118     define variable v-field-group-handle    as handle    no-undo .
     3119     define variable v-object-handle         as handle    no-undo .
     3120     define variable v-frame-height          as decimal   no-undo .
     3121     define variable v-frame-virtual-height  as decimal   no-undo .
     3122     define variable v-browse-height         as decimal   no-undo .
     3123     define variable v-window-height         as decimal   no-undo .
     3124     define variable v-window-virtual-height as decimal   no-undo .
     3125     define variable v-change-sign           as integer   no-undo .
     3126     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3127     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3128     if p-change-value > 0
     3129     then do:
     3130       if frame d-dis-card :height + p-change-value
     3131           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3132       then do:
     3133         assign
     3134           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3135                           - (frame d-dis-card :height-chars)
     3136         .
     3137         if p-change-value <= 0
     3138         then do:
     3139           run diasize_position-resize-button in this-procedure .
     3140           return .
     3141         end.
     3142       end.
     3143     end.
     3144     if p-change-value < 0
     3145     then do:
     3146       if frame d-dis-card :height + p-change-value < v-diasize-orig-frame-height
     3147       then do:
     3148         assign
     3149           p-change-value = v-diasize-orig-frame-height
     3150                          - (frame d-dis-card :height-chars)
     3151         .
     3152         if p-change-value >= 0
     3153         then do:
     3154           run diasize_position-resize-button in this-procedure .
     3155           return .
     3156         end.
     3157       end.
     3158     end.
     3159     if p-change-value >= 0
     3160     then do:
     3161       assign
     3162         v-change-sign = 1
     3163       .
     3164     end.
     3165     else do:
     3166       assign
     3167         v-change-sign = -1
     3168       .
     3169     end.
     3170     assign
     3171       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3172     .
     3173     if p-change-value = 0
     3174     then do:
     3175       run diasize_position-resize-button in this-procedure .
     3176       return .
     3177     end.
     3178     move_block:
     3179     do
     3180     on error undo move_block, retry move_block
     3181     :
     3182       if retry
     3183       then do:
     3184         do
     3185         on error undo move_block, leave move_block
     3186         :
     3187           if p-change-value > 0
     3188           then do:
     3189             for each buf_temp-diasize-handle
     3190             on error undo, next
     3191             :
     3192               assign
     3193                 v-object-handle = buf_temp-diasize-handle.handle-value
     3194               .
     3195               if v-object-handle <> v-diasize-resize-button
     3196               then do:
     3197                 assign
     3198                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3199                 .
     3200               end.
     3201             end.
     3202             assign
     3203               v-diasize-browse-handle :height = v-browse-height
     3204             .
     3205             for each buf_temp-browse-handle
     3206               where buf_temp-browse-handle.browse-type = 'height':u
     3207             on error undo, next
     3208             :
     3209               assign
     3210                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3211               .
     3212             end.
     3213             assign
     3214               frame d-dis-card :height = v-frame-height
     3215             .
     3216             if frame d-dis-card :scrollable = true
     3217             then do:
     3218               assign
     3219                 frame d-dis-card :virtual-height = v-frame-virtual-height
     3220               .
     3221             end.
     3222             run diasize_position-resize-button in this-procedure .
     3223           end.
     3224           else do:
     3225             if frame d-dis-card :scrollable = true
     3226             then do:
     3227               assign
     3228                 frame d-dis-card :virtual-height = v-frame-virtual-height
     3229               .
     3230             end.
     3231             assign
     3232               frame d-dis-card :height = v-frame-height
     3233             .
     3234             assign
     3235               v-diasize-browse-handle :height = v-browse-height
     3236             .
     3237             for each buf_temp-browse-handle
     3238               where buf_temp-browse-handle.browse-type = 'height':u
     3239             on error undo, next
     3240             :
     3241               assign
     3242                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3243               .
     3244             end.
     3245             for each buf_temp-diasize-handle
     3246             on error undo, next
     3247             :
     3248               assign
     3249                 v-object-handle = buf_temp-diasize-handle.handle-value
     3250               .
     3251               if v-object-handle <> v-diasize-resize-button
     3252               then do:
     3253                 assign
     3254                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3255                 .
     3256               end.
     3257             end.
     3258             run diasize_position-resize-button in this-procedure .
     3259           end.
     3260           assign
     3261             v-diasize-change-size = false
     3262           .
     3263           leave move_block .
     3264         end.
     3265       end.
     3266       assign
     3267         v-diasize-need-full-display = true
     3268       .
     3269       if v-diasize-change-size = false
     3270       then do:
     3271         assign
     3272           v-diasize-change-size = true
     3273         .
     3274       end.
     3275       else do:
     3276         return .
     3277       end.
     3278       assign
     3279         v-frame-height = frame d-dis-card :height
     3280         v-frame-virtual-height = frame d-dis-card :virtual-height
     3281         v-browse-height = v-diasize-browse-handle :height
     3282       .
     3283       for each buf_temp-browse-handle
     3284         where buf_temp-browse-handle.browse-type = 'height':u
     3285       :
     3286         assign
     3287           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3288         .
     3289       end.
     3290       for each buf_temp-diasize-handle
     3291       :
     3292         delete buf_temp-diasize-handle .
     3293       end.
     3294       assign
     3295         v-field-group-handle = frame d-dis-card :first-child
     3296       .
     3297       do while valid-handle(v-field-group-handle)
     3298       :
     3299         assign
     3300           v-object-handle = v-field-group-handle :first-child
     3301         .
     3302         do while valid-handle(v-object-handle)
     3303         :
     3304           if  v-object-handle <> v-diasize-browse-handle :handle
     3305           and can-query(v-object-handle, "row")
     3306           and can-query(v-object-handle, "height")
     3307           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3308           then do:
     3309             find first buf_temp-browse-handle
     3310               where buf_temp-browse-handle.browse-type   = 'height':u
     3311                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3312               no-error .
     3313             if available buf_temp-browse-handle
     3314             then do:
     3315             end.
     3316             else do:
     3317               create buf_temp-diasize-handle .
     3318               assign
     3319                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3320                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3321               .
     3322             end.
     3323           end.
     3324           assign
     3325             v-object-handle = v-object-handle :next-sibling
     3326           .
     3327         end.
     3328         assign
     3329           v-field-group-handle = v-field-group-handle :next-sibling
     3330         .
     3331       end.
     3332       do with frame d-dis-card
     3333       :
     3334         hide v-diasize-resize-button .
     3335         assign
     3336           v-diasize-resize-button :row    = 1
     3337           v-diasize-resize-button :column = 1
     3338         .
     3339       end.
     3340       if p-change-value > 0
     3341       then do:
     3342         if frame d-dis-card :scrollable = true
     3343         then do:
     3344           assign
     3345             frame d-dis-card :virtual-height = frame d-dis-card :virtual-height + p-change-value
     3346             no-error .
     3347           if error-status :error
     3348           or error-status :get-message(1) <> ""
     3349           then do:
     3350             undo move_block, retry move_block .
     3351           end.
     3352         end.
     3353         assign
     3354           frame d-dis-card :height = frame d-dis-card :height + p-change-value
     3355           no-error .
     3356         if error-status :error
     3357         or error-status :get-message(1) <> ""
     3358         then do:
     3359           undo move_block, retry move_block .
     3360         end.
     3361         assign
     3362           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3363           no-error .
     3364         if error-status :error
     3365         or error-status :get-message(1) <> ""
     3366         then do:
     3367           undo move_block, retry move_block .
     3368         end.
     3369         for each buf_temp-browse-handle
     3370           where buf_temp-browse-handle.browse-type = 'height':u
     3371         on error undo move_block, retry move_block
     3372         :
     3373           assign
     3374             buf_temp-browse-handle.browse-handle :height
     3375               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3376             no-error .
     3377           if error-status :error
     3378           or error-status :get-message(1) <> ""
     3379           then do:
     3380             undo move_block, retry move_block .
     3381           end.
     3382         end.
     3383         for each buf_temp-diasize-handle
     3384         on error undo move_block, retry move_block
     3385         :
     3386           assign
     3387             v-object-handle = buf_temp-diasize-handle.handle-value
     3388           .
     3389           if v-object-handle <> v-diasize-resize-button
     3390           then do:
     3391             assign
     3392               v-object-handle :row = v-object-handle :row + p-change-value
     3393               no-error .
     3394             if error-status :error
     3395             or error-status :get-message(1) <> ""
     3396             then do:
     3397               undo move_block, retry move_block .
     3398             end.
     3399           end.
     3400         end.
     3401       end.
     3402       else do:
     3403         for each buf_temp-diasize-handle
     3404         on error undo move_block, retry move_block
     3405         :
     3406           assign
     3407             v-object-handle = buf_temp-diasize-handle.handle-value
     3408           .
     3409           if v-object-handle <> v-diasize-resize-button
     3410           then do:
     3411             assign
     3412               v-object-handle :row = v-object-handle :row + p-change-value
     3413               no-error .
     3414             if error-status :error
     3415             or error-status :get-message(1) <> ""
     3416             then do:
     3417               undo move_block, retry move_block .
     3418             end.
     3419           end.
     3420         end.
     3421         assign
     3422           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3423           no-error .
     3424         if error-status :error
     3425         or error-status :get-message(1) <> ""
     3426         then do:
     3427           undo move_block, retry move_block .
     3428         end.
     3429         for each buf_temp-browse-handle
     3430           where buf_temp-browse-handle.browse-type = 'height':u
     3431         on error undo move_block, retry move_block
     3432         :
     3433           assign
     3434             buf_temp-browse-handle.browse-handle :height
     3435               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3436             no-error .
     3437           if error-status :error
     3438           or error-status :get-message(1) <> ""
     3439           then do:
     3440             undo move_block, retry move_block .
     3441           end.
     3442         end.
     3443         assign
     3444           frame d-dis-card :height = frame d-dis-card :height + p-change-value
     3445           no-error .
     3446         if error-status :error
     3447         or error-status :get-message(1) <> ""
     3448         then do:
     3449           undo move_block, retry move_block .
     3450         end.
     3451         if frame d-dis-card :scrollable = true
     3452         then do:
     3453           assign
     3454             frame d-dis-card :virtual-height = frame d-dis-card :virtual-height + p-change-value
     3455             no-error .
     3456           if error-status :error
     3457           or error-status :get-message(1) <> ""
     3458           then do:
     3459             undo move_block, retry move_block .
     3460           end.
     3461         end.
     3462       end.
     3463       if p-move-resize = true
     3464       then do:
     3465         run diasize_position-resize-button in this-procedure .
     3466       end.
     3467       if v-diasize-wndstore = true
     3468       then do:
     3469         if connected("ub") = true
     3470         then do:
     3471           define variable v-cntxt-db-num        as integer   no-undo .
     3472           define variable v-cntxt-userid        as character no-undo .
     3473           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3474                                             , OUTPUT v-cntxt-userid
     3475                                             ) .
     3476           run gbl/wndsizew.p
     3477             (input  v-cntxt-db-num
     3478             ,input  v-cntxt-userid
     3479             ,input  v-diasize-proc-name
     3480             ,input  'height':u
     3481             ,input  string(frame d-dis-card :height - v-diasize-orig-frame-height)
     3482             ) .
     3483         end.
     3484       end.
     3485     end.
     3486     assign
     3487       v-diasize-change-size = false
     3488     .
     3489   end procedure.
     3490   procedure diasize_set-height :
     3491     define input  parameter p-new-height  as decimal   no-undo .
     3492     define input  parameter p-move-resize as logical   no-undo .
     3493     do
     3494     on error undo, return error return-value
     3495     :
     3496       run diasize_change-height in this-procedure
     3497         (input  (p-new-height - frame d-dis-card :height)
     3498         ,input  p-move-resize
     3499         ) .
     3500     end.
     3501   end procedure.
     3502   procedure diasize_change-width :
     3503     define input  parameter p-change-value as decimal   no-undo .
     3504     define input  parameter p-move-resize  as logical   no-undo .
     3505     define variable v-field-group-handle   as handle    no-undo .
     3506     define variable v-object-handle        as handle    no-undo .
     3507     define variable v-frame-width          as decimal   no-undo .
     3508     define variable v-frame-virtual-width  as decimal   no-undo .
     3509     define variable v-browse-width         as decimal   no-undo .
     3510     define variable v-window-width         as decimal   no-undo .
     3511     define variable v-window-virtual-width as decimal   no-undo .
     3512     define variable v-change-sign          as integer   no-undo .
     3513     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3514     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3515     if p-change-value > 0
     3516     then do:
     3517       if frame d-dis-card :width + p-change-value >
     3518           session :width-chars
     3519       then do:
     3520         assign
     3521           p-change-value = session :width-chars - frame d-dis-card :width
     3522         .
     3523         if p-change-value <= 0
     3524         then do:
     3525           run diasize_position-resize-button in this-procedure .
     3526           return .
     3527         end.
     3528       end.
     3529     end.
     3530     if p-change-value < 0
     3531     then do:
     3532       if frame d-dis-card :width + p-change-value < v-diasize-orig-frame-width
     3533       then do:
     3534         assign
     3535           p-change-value = v-diasize-orig-frame-width
     3536                          - frame d-dis-card :width
     3537         .
     3538         if p-change-value >= 0
     3539         then do:
     3540           run diasize_position-resize-button in this-procedure .
     3541           return .
     3542         end.
     3543       end.
     3544     end.
     3545     if p-change-value >= 0
     3546     then do:
     3547       assign
     3548         v-change-sign = 1
     3549       .
     3550     end.
     3551     else do:
     3552       assign
     3553         v-change-sign = -1
     3554       .
     3555     end.
     3556     assign
     3557       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3558     .
     3559     if p-change-value = 0
     3560     then do:
     3561       run diasize_position-resize-button in this-procedure .
     3562       return .
     3563     end.
     3564     move_block:
     3565     do
     3566     on error undo move_block, leave move_block
     3567     :
     3568       if retry
     3569       then do:
     3570         do
     3571         on error undo move_block, leave move_block
     3572         :
     3573           if p-change-value > 0
     3574           then do:
     3575             for each buf_temp-diasize-handle
     3576             on error undo, next
     3577             :
     3578               assign
     3579                 v-object-handle = buf_temp-diasize-handle.handle-value
     3580               .
     3581               if v-object-handle <> v-diasize-resize-button
     3582               then do:
     3583                 assign
     3584                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3585                 .
     3586               end.
     3587             end.
     3588             assign
     3589               v-diasize-browse-handle :width = v-browse-width
     3590             .
     3591             for each buf_temp-browse-handle
     3592               where buf_temp-browse-handle.browse-type = 'width':u
     3593             on error undo, next
     3594             :
     3595               assign
     3596                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3597               .
     3598             end.
     3599             assign
     3600               frame d-dis-card :width = v-frame-width
     3601             .
     3602             if frame d-dis-card :scrollable = true
     3603             then do:
     3604               assign
     3605                 frame d-dis-card :virtual-width = v-frame-virtual-width
     3606               .
     3607             end.
     3608             run diasize_position-resize-button in this-procedure .
     3609           end.
     3610           else do:
     3611             if frame d-dis-card :scrollable = true
     3612             then do:
     3613               assign
     3614                 frame d-dis-card :virtual-width = v-frame-virtual-width
     3615               .
     3616             end.
     3617             assign
     3618               frame d-dis-card :width = v-frame-width
     3619             .
     3620             for each buf_temp-browse-handle
     3621               where buf_temp-browse-handle.browse-type = 'width':u
     3622             on error undo, next
     3623             :
     3624               assign
     3625                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3626               .
     3627             end.
     3628             assign
     3629               v-diasize-browse-handle :width = v-browse-width
     3630             .
     3631             for each buf_temp-diasize-handle
     3632             on error undo, next
     3633             :
     3634               assign
     3635                 v-object-handle = buf_temp-diasize-handle.handle-value
     3636               .
     3637               if v-object-handle <> v-diasize-resize-button
     3638               then do:
     3639                 assign
     3640                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3641                 .
     3642               end.
     3643             end.
     3644             run diasize_position-resize-button in this-procedure .
     3645           end.
     3646           assign
     3647             v-diasize-change-size = false
     3648           .
     3649           leave move_block .
     3650         end.
     3651       end.
     3652       assign
     3653         v-diasize-need-full-display = true
     3654       .
     3655       if v-diasize-change-size = false
     3656       then do:
     3657         assign
     3658           v-diasize-change-size = true
     3659         .
     3660       end.
     3661       else do:
     3662         return .
     3663       end.
     3664       assign
     3665         v-frame-width = frame d-dis-card :width
     3666         v-frame-virtual-width = frame d-dis-card :virtual-width
     3667         v-browse-width = v-diasize-browse-handle :width
     3668       .
     3669       for each buf_temp-browse-handle
     3670         where buf_temp-browse-handle.browse-type = 'width':u
     3671       :
     3672         assign
     3673           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3674         .
     3675       end.
     3676       for each buf_temp-diasize-handle
     3677       :
     3678         delete buf_temp-diasize-handle .
     3679       end.
     3680       assign
     3681         v-field-group-handle = frame d-dis-card :first-child
     3682       .
     3683       do while valid-handle(v-field-group-handle)
     3684       :
     3685         assign
     3686           v-object-handle = v-field-group-handle :first-child
     3687         .
     3688         do while valid-handle(v-object-handle)
     3689         :
     3690           if  v-object-handle <> v-diasize-browse-handle :handle
     3691           and v-object-handle <> v-diasize-resize-button
     3692           and can-query(v-object-handle, "row")
     3693           and can-query(v-object-handle, "height")
     3694           and ( v-object-handle :col + v-object-handle :width
     3695                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3696               )
     3697           then do:
     3698             find first buf_temp-browse-handle
     3699               where buf_temp-browse-handle.browse-type   = 'width':u
     3700                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3701               no-error .
     3702             if available buf_temp-browse-handle
     3703             then do:
     3704             end.
     3705             else do:
     3706               create buf_temp-diasize-handle .
     3707               assign
     3708                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3709                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3710               .
     3711             end.
     3712           end.
     3713           assign
     3714             v-object-handle = v-object-handle :next-sibling
     3715           .
     3716         end.
     3717         assign
     3718           v-field-group-handle = v-field-group-handle :next-sibling
     3719         .
     3720       end.
     3721       do with frame d-dis-card
     3722       :
     3723         hide v-diasize-resize-button .
     3724         v-diasize-resize-button :row = 1.
     3725         v-diasize-resize-button :column = 1.
     3726       end.
     3727       if p-change-value > 0
     3728       then do:
     3729         if frame d-dis-card :scrollable = true
     3730         then do:
     3731           assign
     3732             frame d-dis-card :virtual-width = frame d-dis-card :virtual-width + p-change-value
     3733             no-error .
     3734           if error-status :error
     3735           or error-status :get-message(1) <> ""
     3736           then do:
     3737             undo move_block, retry move_block.
     3738           end.
     3739         end.
     3740         assign
     3741           frame d-dis-card :width = v-frame-width + p-change-value
     3742           no-error .
     3743         if error-status :error
     3744         or error-status :get-message(1) <> ""
     3745         then do:
     3746           undo move_block, retry move_block.
     3747         end.
     3748         assign
     3749           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3750         no-error .
     3751         if error-status :error
     3752         or error-status :get-message(1) <> ""
     3753         then do:
     3754           undo move_block, retry move_block.
     3755         end.
     3756         for each buf_temp-browse-handle
     3757           where buf_temp-browse-handle.browse-type = 'width':u
     3758         on error undo move_block, retry move_block
     3759         :
     3760           assign
     3761             buf_temp-browse-handle.browse-handle :width
     3762               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3763             no-error .
     3764           if error-status :error
     3765           or error-status :get-message(1) <> ""
     3766           then do:
     3767             undo move_block, retry move_block .
     3768           end.
     3769         end.
     3770         for each buf_temp-diasize-handle
     3771         on error undo move_block, retry move_block
     3772         :
     3773           assign
     3774             v-object-handle = buf_temp-diasize-handle.handle-value
     3775           .
     3776           if v-object-handle <> v-diasize-resize-button
     3777           then do:
     3778             assign
     3779               v-object-handle :col = v-object-handle :col + p-change-value
     3780               no-error .
     3781             if error-status :error
     3782             or error-status :get-message(1) <> ""
     3783             then do:
     3784               undo move_block, retry move_block .
     3785             end.
     3786           end.
     3787         end.
     3788       end.
     3789       else do:
     3790         for each buf_temp-diasize-handle
     3791         on error undo move_block, retry move_block
     3792         :
     3793           assign
     3794             v-object-handle = buf_temp-diasize-handle.handle-value
     3795           .
     3796           if v-object-handle <> v-diasize-resize-button
     3797           then do:
     3798             assign
     3799               v-object-handle :col = v-object-handle :col + p-change-value
     3800               no-error .
     3801             if error-status :error
     3802             or error-status :get-message(1) <> ""
     3803             then do:
     3804               undo move_block, retry move_block .
     3805             end.
     3806           end.
     3807         end.
     3808         for each buf_temp-browse-handle
     3809           where buf_temp-browse-handle.browse-type = 'width':u
     3810         on error undo move_block, retry move_block
     3811         :
     3812           assign
     3813             buf_temp-browse-handle.browse-handle :width
     3814               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3815             no-error .
     3816           if error-status :error
     3817           or error-status :get-message(1) <> ""
     3818           then do:
     3819             undo move_block, retry move_block .
     3820           end.
     3821         end.
     3822         assign
     3823           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3824           no-error .
     3825         if error-status :error
     3826         or error-status :get-message(1) <> ""
     3827         then do:
     3828           undo move_block, retry move_block.
     3829         end.
     3830         assign
     3831           frame d-dis-card :width = frame d-dis-card :width + p-change-value
     3832         no-error .
     3833         if error-status :error
     3834         or error-status :get-message(1) <> ""
     3835         then do:
     3836           undo move_block, retry move_block.
     3837         end.
     3838         if frame d-dis-card :scrollable = true
     3839         then do:
     3840           assign
     3841             frame d-dis-card :virtual-width = frame d-dis-card :virtual-width + p-change-value
     3842           no-error .
     3843           if error-status :error
     3844           or error-status :get-message(1) <> ""
     3845           then do:
     3846             undo move_block, retry move_block.
     3847           end.
     3848         end.
     3849       end.
     3850       if p-move-resize
     3851       then do:
     3852         run diasize_position-resize-button in this-procedure .
     3853       end.
     3854       if v-diasize-wndstore = true
     3855       then do:
     3856         if connected("ub") = true
     3857         then do:
     3858           define variable v-cntxt-db-num        as integer   no-undo .
     3859           define variable v-cntxt-userid        as character no-undo .
     3860           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3861                                             , OUTPUT v-cntxt-userid
     3862                                             ) .
     3863           run gbl/wndsizew.p
     3864             (input  v-cntxt-db-num
     3865             ,input  v-cntxt-userid
     3866             ,input  v-diasize-proc-name
     3867             ,input  'width':u
     3868             ,input  string(frame d-dis-card :width - v-diasize-orig-frame-width)
     3869             ) .
     3870         end.
     3871       end.
     3872     end.
     3873     assign
     3874       v-diasize-change-size = false
     3875     .
     3876   end procedure.
     3877   procedure diasize_set-width :
     3878     define input  parameter p-new-width  as decimal   no-undo .
     3879     define input  parameter p-move-resize as logical   no-undo .
     3880     do
     3881     on error undo, return error return-value
     3882     :
     3883       run diasize_change-width in this-procedure
     3884         (input  (p-new-width - frame d-dis-card :width)
     3885         ,input  p-move-resize
     3886         ) .
     3887     end.
     3888   end procedure.
     3889   procedure diasize_position-resize-button :
     3890     do with frame d-dis-card
     3891     :
     3892       hide v-diasize-resize-button .
     3893       assign
     3894         v-diasize-resize-button :row = frame d-dis-card :height - v-diasize-resize-button :height
     3895                     - 1
     3896                     - (frame d-dis-card :border-bottom-pixels / session :pixels-per-row)
     3897         v-diasize-resize-button :col = frame d-dis-card :width - v-diasize-resize-button :width
     3898                     - 1
     3899                     - (frame d-dis-card :border-right-pixels / session :pixels-per-column)
     3900       .
     3901       view v-diasize-resize-button .
     3902     end.
     3903   end procedure.
     3904   on alt-right anywhere
     3905   do:
     3906     run diasize_change-width in this-procedure
     3907       (input 1
     3908       ,input true
     3909       ) .
     3910     return no-apply .
     3911   end.
     3912   on alt-left anywhere
     3913   do:
     3914     run diasize_change-width in this-procedure
     3915       (input -1
     3916       ,input true
     3917       ) .
     3918     return no-apply .
     3919   end.
     3920   on alt-down anywhere
     3921   do:
     3922     run diasize_change-height in this-procedure
     3923       (input 1
     3924       ,input true
     3925       ) .
     3926     return no-apply .
     3927   end.
     3928   on alt-up anywhere
     3929   do:
     3930     run diasize_change-height in this-procedure
     3931       (input -1
     3932       ,input true
     3933       ) .
     3934     return no-apply .
     3935   end.
     3936   on alt-enter of frame d-dis-card
     3937   do:
     3938     run diasize_maximize in this-procedure
     3939       (input  ?
     3940       ).
     3941     return no-apply .
     3942   end.
     3943   procedure diasize_end-move :
     3944     do
     3945     on error undo, return error return-value
     3946     :
     3947       define variable v-row-delta as decimal   no-undo .
     3948       define variable v-col-delta as decimal   no-undo .
     3949       define variable v-new-row as decimal   no-undo .
     3950       define variable v-new-col as decimal   no-undo .
     3951       assign
     3952         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3953         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3954       .
     3955       assign
     3956         v-row-delta = v-new-row - frame d-dis-card :height
     3957         v-col-delta = v-new-col - frame d-dis-card :width
     3958       .
     3959       run diasize_change-height in this-procedure
     3960         (input v-row-delta
     3961         ,input true
     3962         ) .
     3963       run diasize_change-width in this-procedure
     3964         (input v-col-delta
     3965         ,input true
     3966         ) .
     3967     end.
     3968   end procedure.
     3969   procedure diasize_maximize :
     3970     define input  parameter p-action as logical   no-undo .
     3971     do
     3972     on error undo, return error return-value
     3973     :
     3974       if p-action = ?
     3975       then do:
     3976         if v-diasize-need-maximize = true
     3977         then do:
     3978           assign
     3979             p-action = true
     3980           .
     3981         end.
     3982         else do:
     3983           assign
     3984             p-action = false
     3985           .
     3986         end.
     3987       end.
     3988       if p-action = true
     3989       then do:
     3990         run diasize_change-height in this-procedure
     3991           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3992               - frame d-dis-card :height-chars
     3993           ,input true
     3994           ) .
     3995         run diasize_change-width in this-procedure
     3996           (input session :width-chars
     3997               - frame d-dis-card :width-chars
     3998           ,input true
     3999           ) .
     4000         assign
     4001           v-diasize-need-maximize = false
     4002         .
     4003       end.
     4004       else do:
     4005         run diasize_change-width in this-procedure
     4006           (input v-diasize-orig-frame-width
     4007               - frame d-dis-card :width-chars
     4008           ,input true
     4009           ) .
     4010         run diasize_change-height in this-procedure
     4011           (input v-diasize-orig-frame-height
     4012               - frame d-dis-card :height-chars
     4013           ,input true
     4014           ) .
     4015         assign
     4016           v-diasize-need-maximize = true
     4017         .
     4018       end.
     4019     end.
     4020   end procedure.
     4021   procedure diasize_restore-orig-size :
     4022     do
     4023     on error undo, return error return-value
     4024     :
     4025       assign
     4026         v-diasize-current-frame-width  = frame d-dis-card :width
     4027         v-diasize-current-frame-height = frame d-dis-card :height
     4028       .
     4029       run diasize_set-height in this-procedure
     4030         (input  v-diasize-orig-frame-height
     4031         ,input  true
     4032         ) .
     4033       run diasize_set-width in this-procedure
     4034         (input  v-diasize-orig-frame-width
     4035         ,input  true
     4036         ) .
