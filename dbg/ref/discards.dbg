     1343   define variable obj-cash-d-pcnt like ub.dis-card.cash-d-pcnt no-undo.
     1344   define variable v-is-dc as character no-undo .
     1345   define variable v-is-ef as character no-undo .
     1346   define variable v-conf-type as character no-undo .
     1347   define variable attr-option as character no-undo .
