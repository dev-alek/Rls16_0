     1360   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361   FUNCTION get-dpcn RETURNS CHARACTER (
     1362        input p-d-card as character
     1363       ,input p-emitent-host-code as integer
     1364       ,input p-type as character
     1365       ,input parhost-code as integer
     1366       ,input parobj-type as character
     1367       ,input parobj-code as integer
     1368       ,input p-node-code as integer
     1369       ,input p-d-pcnt as decimal
     1370       ,input p-cash-d-pcnt as decimal
     1371       ,input p-category as integer
     1372       ) :
     1373   define buffer buf_dis-card-type for ub.dis-card-type.
     1374   define variable loc-d-v as decimal no-undo init ?.
     1375   define variable v-discnt-role as character no-undo .
     1376   define buffer buf_dis-card-property for ub.dis-card-property.
     1377   find first buf_dis-card-type no-lock where
     1378             buf_dis-card-type.type = p-type
     1379         and buf_dis-card-type.emitent-host-code = p-emitent-host-code
     1380         and buf_dis-card-type.host-code = 0
     1381         and buf_dis-card-type.obj-type = '':U
     1382         and buf_dis-card-type.obj-code = 0 no-error.
     1383   if available buf_dis-card-type then do:
     1384     case p-node-code:
     1385       when 1 then do:
     1386         assign
     1387         v-discnt-role = 'def-pcnt':U .
     1388       end.
     1389       when 2 then do:
     1390         assign
     1391         v-discnt-role = 'def-cash-pcnt':U.
     1392       end.
     1393       when 3 then do:
     1394         assign
     1395         v-discnt-role = 'def-categ':U.
     1396       end.
     1397     end case.
     1398     if buf_dis-card-type.d-pcnt-byshop then do:
     1399      find first buf_dis-card-property no-lock where
     1400                buf_dis-card-property.d-card = p-d-card
     1401            and buf_dis-card-property.dtm-code = 26
     1402            and buf_dis-card-property.host-code = parhost-code
     1403            and buf_dis-card-property.obj-type = parobj-type
     1404            and buf_dis-card-property.obj-code = parobj-code
     1405            and buf_dis-card-property.node-code = p-node-code no-error.
     1406      if available buf_dis-card-property then do:
     1407        if v-discnt-role = 'def-categ':U then do:
     1408          assign
     1409          loc-d-v = buf_dis-card-property.property-value-integer.
     1410        end.
     1411        else do:
     1412          assign
     1413          loc-d-v = buf_dis-card-property.property-value-decimal.
     1414        end.
     1415      end.
     1416      if loc-d-v = ? then do:
     1417   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1418   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1419     (
     1420      input  p-type
     1421     ,input  p-emitent-host-code
     1422     ,input  parhost-code
     1423     ,input  parobj-type
     1424     ,input  parobj-code
     1425     ,input  v-discnt-role
     1426     ,output loc-d-v
     1427     ) no-error .
     1428       end.
     1429       if loc-d-v = ? then do:
     1430         find first buf_dis-card-property no-lock where
     1431                   buf_dis-card-property.d-card = p-d-card
     1432               and buf_dis-card-property.dtm-code = 26
     1433               and buf_dis-card-property.host-code = parhost-code
     1434               and buf_dis-card-property.obj-type = ''
     1435               and buf_dis-card-property.obj-code = 0
     1436               and buf_dis-card-property.node-code = p-node-code no-error.
     1437         if available buf_dis-card-property then do:
     1438           if v-discnt-role = 'def-categ':U then do:
     1439             assign
     1440             loc-d-v = buf_dis-card-property.property-value-integer.
     1441           end.
     1442           else do:
     1443             assign
     1444             loc-d-v = buf_dis-card-property.property-value-decimal.
     1445           end.
     1446         end.
     1447       end.
     1448       if loc-d-v = ? then do:
     1449   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1450   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1451     (
     1452      input  p-type
     1453     ,input  p-emitent-host-code
     1454     ,input  parhost-code
     1455     ,input  ''
     1456     ,input  0
     1457     ,input  v-discnt-role
     1458     ,output loc-d-v
     1459     ) no-error .
     1460       end.
     1461       if loc-d-v = ? then do:
     1462         case v-discnt-role:
     1463           when 'def-categ':U then do:
     1464             loc-d-v = p-category.
     1465           end.
     1466           when 'def-pcnt':U then do:
     1467             loc-d-v = p-d-pcnt.
     1468           end.
     1469           when 'def-cash-pcnt':U then do:
     1470             loc-d-v = p-cash-d-pcnt.
     1471           end.
     1472         end case.
     1473       end.
     1474       if v-discnt-role = 'def-categ':U then do:
     1475         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     1476       end.
     1477       else do:
     1478         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     1479       end.
     1480     end.
     1481   end.
     1482   else do:
     1483    return "ОШИБКА-НЕТ ТИПА".
     1484   end.
     1485   case v-discnt-role:
     1486     when 'def-categ':U then do:
     1487        loc-d-v = p-category.
     1488        return string(loc-d-v, ">>>9").
     1489     end.
     1490     when 'def-pcnt':U then do:
     1491       loc-d-v = p-d-pcnt.
     1492       return string(loc-d-v, "->9.99%").
     1493     end.
     1494     when 'def-cash-pcnt':U then do:
     1495       loc-d-v = p-cash-d-pcnt.
     1496       return string(loc-d-v, "->9.99%").
     1497     end.
     1498   end case.
     1499   END FUNCTION.
     1500   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1501   procedure fltfield-clear :
     1502     define output parameter loc-fld as character no-undo.
     1503     define output parameter loc-lab as character no-undo .
     1504     define output parameter loc-spr as character no-undo .
     1505     define output parameter loc-dim as character no-undo .
     1506     assign
     1507       loc-fld = ""
     1508       loc-lab = ""
     1509       loc-spr = ""
     1510       loc-dim = "0"
     1511     .
     1512   end procedure .
     1513   procedure fltfield-add :
     1514     define input        parameter par-fld as character no-undo.
     1515     define input        parameter par-lab as character no-undo .
     1516     define input        parameter par-spr as character no-undo .
     1517     define input-output parameter loc-fld as character no-undo.
     1518     define input-output parameter loc-lab as character no-undo .
     1519     define input-output parameter loc-spr as character no-undo .
     1520     define input-output parameter loc-dim as character no-undo .
     1521     do
     1522     on error undo, return error
     1523     :
     1524       assign
     1525       loc-fld = if loc-dim = '0'
     1526                 then par-fld
     1527                 else (loc-fld + chr(44) + par-fld)
     1528       loc-lab = if loc-dim = '0'
     1529                 then par-lab
     1530                 else (loc-lab + chr(44) + par-lab)
     1531       loc-spr = if loc-dim = '0'
     1532                 then par-spr
     1533                 else (loc-spr + chr(44) + par-spr)
     1534       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1535                 string(integer(if num-entries(loc-dim) > 1
     1536                               then entry(2, loc-dim)
     1537                               else entry(1, loc-dim)
     1538                               ) + 1)
     1539       no-error
     1540       .
     1541     end.
     1542   end procedure.
     1543   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1544   define variable num-chk as integer no-undo.
     1545   define variable gds-sum as decimal no-undo.
     1546   define variable disc-sum as decimal no-undo.
     1547   define variable netto-sum as decimal no-undo.
     1548   define variable pay-sum as decimal no-undo.
     1549   define variable credit-sum as decimal no-undo.
     1550   define variable saldo-sum as decimal no-undo.
     1551   define variable gds-sum-ch as char no-undo.
     1552   define variable disc-sum-ch as char no-undo.
     1553   define variable netto-sum-ch as char no-undo.
     1554   define variable pay-sum-ch as char no-undo.
     1555   define variable credit-sum-ch as char no-undo.
     1556   define variable pravo as logical no-undo.
     1557   define variable smart-pravo as logical no-undo .
     1558   FUNCTION get-cli-name RETURNS CHARACTER
     1559     (  input p-cli-type as character, input p-cli-code as integer ) :
     1560   define buffer buf_clients for ub.clients.
     1561   find first buf_clients no-lock where buf_clients.obj-type = p-cli-type
     1562   and buf_clients.obj-code = p-cli-code no-error.
     1563   if available buf_clients then return buf_clients.obj-name.
     1564   RETURN (p-cli-type + string(p-cli-code)).
     1565   END FUNCTION.
     1566   FUNCTION Get-num-chk RETURNS CHARACTER(input rs-val as character
     1567                                        , input p-pravo as logical
     1568                                        , buffer buf_dis-card for ub.dis-card
     1569                                        , input p-db-num as integer
     1570                                        ):
     1571   DEFINE variable num-chk-ch as char no-undo.
     1572   define variable loc-smart-pravo as logical no-undo .
     1573   define buffer buf_dis-host for ub.dis-host.
     1574   define buffer buf_hist-nws-option for ub.hist-nws-option.
     1575     if NOT p-pravo then do:
     1576         assign
     1577         num-chk = 0
     1578         gds-sum-ch = ""
     1579         disc-sum-ch = ""
     1580         netto-sum-ch = ""
     1581         pay-sum-ch = ""
     1582         credit-sum-ch = ""
     1583         .
     1584         return "Нет прав".
     1585     end.
     1586     IF not avail buf_dis-card then do:
     1587         assign
     1588         num-chk = 0
     1589         gds-sum-ch = ""
     1590         disc-sum-ch = ""
     1591         netto-sum-ch = ""
     1592         pay-sum-ch = ""
     1593         credit-sum-ch = ""
     1594         .
     1595         return "".
     1596     end.
     1597     assign
     1598     num-chk = 0
     1599     gds-sum = 0
     1600     disc-sum = 0
     1601     netto-sum = 0
     1602     pay-sum = 0
     1603     credit-sum = 0
     1604     .
     1605     if p-db-num > 0 then do:
     1606       find first buf_HIST-NWS-OPTION WHERE
     1607         buf_HIST-NWS-OPTION.db-num = 0
     1608         and buf_hist-nws-option.table-name = 'dis-host':U
     1609         and buf_hist-nws-option.host-code = buf_dis-card.emitent-host-code
     1610         and buf_hist-nws-option.obj-type = '':U
     1611         and buf_hist-nws-option.obj-code = 0
     1612         and buf_hist-nws-option.key#_one = 1
     1613         and buf_hist-nws-option.charkey_one = buf_dis-card.type
     1614         and buf_hist-nws-option.subject-group = 'c-dc-hist':U NO-ERROR.
     1615       if available buf_hist-nws-option
     1616       and buf_hist-nws-option.smart-nws >= 0 then loc-smart-pravo = yes.
     1617       if loc-smart-pravo then do:
     1618         assign
     1619         num-chk = ?
     1620         gds-sum = ?
     1621         disc-sum = ?
     1622         netto-sum = ?
     1623         pay-sum = ?
     1624         credit-sum = ?
     1625         .
     1626         return "".
     1627       end.
     1628     end.
     1629     find first buf_Dis-host no-lock where
     1630               buf_dis-host.host-code = buf_Dis-card.emitent-host-code
     1631           and buf_dis-host.d-card = buf_Dis-card.d-card
     1632           and buf_Dis-host.dt-code = 0 no-error.
     1633     if not available buf_Dis-host then return "".
     1634     IF RS-val = 'rubl':U then do:
     1635       assign
     1636       num-chk = buf_dis-host.num-chk
     1637       gds-sum = buf_dis-host.gds-tot-rubl
     1638       disc-sum = buf_dis-host.gds-dis-rubl
     1639       netto-sum = gds-sum - disc-sum
     1640       pay-sum = buf_dis-host.pay-tot-rubl
     1641       credit-sum = netto-sum - pay-sum
     1642       saldo-sum = buf_dis-card.saldo-rubl.
     1643     end.
     1644     else do:
     1645       assign
     1646       num-chk = buf_dis-host.num-chk
     1647       gds-sum = buf_dis-host.gds-tot-base
     1648       disc-sum = buf_dis-host.gds-dis-base
     1649       netto-sum = gds-sum - disc-sum
     1650       pay-sum = buf_dis-host.pay-tot-base
     1651       credit-sum = netto-sum - pay-sum
     1652       saldo-sum = buf_dis-card.saldo-base.
     1653     end.
     1654     assign
     1655     gds-sum-ch = string(gds-sum, "->>>,>>>,>>9.99")
     1656     disc-sum-ch = string(disc-sum, "->>>,>>>,>>9.99")
     1657     netto-sum-ch = string(netto-sum, "->>>,>>>,>>9.99")
     1658     pay-sum-ch = string(pay-sum, "->>>,>>>,>>9.99")
     1659     num-chk-ch = string(num-chk, "->>>>>>>9")
     1660     credit-sum-ch = string(credit-sum, "->>>,>>>,>>9.99")
     1661     .
     1662     RETURN num-chk-ch.
     1663   END FUNCTION.
     1664   FUNCTION Get-num-chk-l RETURNS integer(input rs-val as character
     1665                                        , input p-pravo as logical
     1666                                        , input p-num-chk as integer
     1667                                        , input p-type as character
     1668                                        , input p-emitent-host-code as integer
     1669                                        , input p-db-num as integer
     1670                                        ):
     1671   define buffer buf_hist-nws-option for ub.hist-nws-option.
     1672     smart-pravo = no.
     1673     if NOT p-pravo then do:
     1674       return 0.
     1675     end.
     1676     if p-db-num > 0 then do:
     1677       find first buf_HIST-NWS-OPTION WHERE
     1678         buf_HIST-NWS-OPTION.db-num = 0
     1679         and buf_hist-nws-option.table-name = 'dis-host':U
     1680         and buf_hist-nws-option.host-code = p-emitent-host-code
     1681         and buf_hist-nws-option.obj-type = '':U
     1682         and buf_hist-nws-option.obj-code = 0
     1683         and buf_hist-nws-option.key#_one = 1
     1684         and buf_hist-nws-option.charkey_one = p-type
     1685         and buf_hist-nws-option.subject-group = 'c-dc-hist':U NO-ERROR.
     1686       if available buf_hist-nws-option
     1687       and buf_hist-nws-option.smart-nws >= 0 then smart-pravo = yes.
     1688       else smart-pravo = no.
     1689     end.
     1690     if smart-pravo then return ?.
     1691     return p-num-chk.
     1692   end FUNCTION.
     1693   FUNCTION Get-gds-sum-l RETURNS decimal(
     1694                                          input rs-val as character
     1695                                        , input p-pravo as logical
     1696                                        , input p-gds-tot-rubl as decimal
     1697                                        , input p-gds-tot-base as decimal):
     1698     if NOT p-pravo then do:
     1699       return 0.0.
     1700     end.
     1701     if smart-pravo then return ?.
     1702     if rs-val = 'rubl':U then
     1703     return p-gds-tot-rubl.
     1704     else
     1705     return p-gds-tot-base.
     1706   end FUNCTION.
     1707   FUNCTION Get-disc-sum-l RETURNS decimal(input rs-val as character
     1708                                        , input p-pravo as logical
     1709                                        , input p-gds-dis-rubl as decimal
     1710                                        , input p-gds-dis-base as decimal):
     1711     if NOT p-pravo then do:
     1712       return 0.0.
     1713     end.
     1714     if smart-pravo then return ?.
     1715     if rs-val = 'rubl':U then
     1716     return p-gds-dis-rubl.
     1717     else
     1718     return p-gds-dis-base.
     1719   end FUNCTION.
     1720   FUNCTION Get-netto-sum-l RETURNS decimal(input rs-val as character
     1721                                        , input p-pravo as logical
     1722                                        , input p-gds-tot-rubl as decimal
     1723                                        , input p-gds-tot-base as decimal
     1724                                        , input p-gds-dis-rubl as decimal
     1725                                        , input p-gds-dis-base as decimal):
     1726     if NOT p-pravo then do:
     1727       return 0.0.
     1728     end.
     1729     if smart-pravo then return ?.
     1730     if rs-val = 'rubl':U then
     1731     return (p-gds-tot-rubl - p-gds-dis-rubl).
     1732     else
     1733     return (p-gds-tot-base - p-gds-dis-base).
     1734   end FUNCTION.
     1735   FUNCTION Get-pay-sum-l RETURNS decimal(input rs-val as character
     1736                                        , input p-pravo as logical
     1737                                        , buffer buf_dis-host for ub.dis-host):
     1738     if NOT p-pravo then do:
     1739       return 0.0.
     1740     end.
     1741     if smart-pravo then return ?.
     1742     if rs-val = 'rubl':U then
     1743     return buf_dis-host.pay-tot-rubl.
     1744     else
     1745     return buf_dis-host.pay-tot-base.
     1746   end FUNCTION.
     1747   FUNCTION Get-credit-sum-l RETURNS decimal(input rs-val as character
     1748                                        , input p-pravo as logical
     1749                                        , input p-gds-tot-rubl as decimal
     1750                                        , input p-gds-tot-base as decimal
     1751                                        , input p-gds-dis-rubl as decimal
     1752                                        , input p-gds-dis-base as decimal
     1753                                        , input p-pay-tot-rubl as decimal
     1754                                        , input p-pay-tot-base as decimal):
     1755     if NOT p-pravo then do:
     1756       return 0.0.
     1757     end.
     1758     if smart-pravo then return ?.
     1759     if rs-val = 'rubl':U then
     1760     return (p-gds-tot-rubl - p-gds-dis-rubl - p-pay-tot-rubl).
     1761     else
     1762     return (p-gds-tot-base - p-gds-dis-base - p-pay-tot-base).
     1763   end FUNCTION.
     1764   FUNCTION Get-saldo-l RETURNS decimal(input rs-val as character
     1765                                        , input p-pravo as logical
     1766                                        , buffer buf_dis-card for ub.dis-card):
     1767     if NOT p-pravo then do:
     1768       return 0.0.
     1769     end.
     1770     if smart-pravo then return ?.
     1771     if rs-val = 'rubl':U then
     1772     return buf_dis-card.saldo-rubl.
     1773     else
     1774     return buf_dis-card.saldo-base.
     1775   end FUNCTION.
