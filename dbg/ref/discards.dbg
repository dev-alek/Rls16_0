     4463   PROCEDURE disable_UI :
     4464     HIDE FRAME d-dis-card.
     4465   END PROCEDURE.
     4466   PROCEDURE enable_UI :
     4467   define variable v-d-card-width as integer no-undo init 19.
     4468   define variable v-cli-name-width as integer no-undo init 29.
     4469   define variable v-cli-type-code-width as integer no-undo init 10.
     4470   define variable v-sourced-card-width as integer no-undo init 19.
     4471   run uf-get in this-procedure (
     4472       input  ('discards-p':U + chr(4) + p-list-mode)
     4473       ,input  v-cntxt-userid
     4474       ,output v-uf-List_
     4475       ,output v-uf-Naim
     4476       ,output v-uf-print-graft
     4477       ,output v-uf-sort-gr
     4478       ,output v-uf-type-price
     4479       ,output v-uf-type-val
     4480   )  no-error.
     4481   if not error-status:error
     4482   and num-entries(v-uf-List_, chr(4)) = 5 then do:
     4483       assign
     4484       ri = (if entry(1, v-uf-list_, chr(4)) = chr(63)
     4485            then ?
     4486            else integer(entry(1, v-uf-list_, chr(4))))
     4487       v-d-card-width = integer(entry(2, v-uf-list_, chr(4) ))
     4488       v-cli-name-width = integer(entry(3, v-uf-list_, chr(4) ))
     4489       v-cli-type-code-width = integer(entry(4, v-uf-list_, chr(4) ))
     4490       v-sourced-card-width = integer(entry(5, v-uf-list_, chr(4) ))
     4491       .
     4492   end.
     4493   if v-initial-height = 0 then do:
     4494     v-initial-height = br-discard:height in frame d-dis-card .
     4495   end.
     4496   ASSIGN
     4497   X_dis-card.issue-date:READ-ONLY IN BROWSE BR-DISCARD = YES
     4498   b-history:MENU-MOUSE in frame d-dis-card = 1
     4499   b-chk:menu-mouse in frame d-dis-card = 1
     4500   menu-item m_ef-cd-trans:sensitive in menu menu-b-chk = logical(v-is-ef)
     4501   b-CHG:POPUP-MENU IN FRAME d-dis-card = ?
     4502   b-add:MENU-MOUSE in frame d-dis-card = 1
     4503   b-lkp:MENU-MOUSE in frame d-dis-card =1
     4504   b-prop:MENU-MOUSE in frame d-dis-card = 1
     4505   b-disc:MENU-MOUSE in frame d-dis-card = 1
     4506   X_dis-card.d-card:resizable in browse br-discard = true
     4507   X_dis-card.d-card:width in browse br-discard = v-d-card-width
     4508   v-cli-name:resizable in browse br-discard = true
     4509   v-cli-name:width in browse br-discard = v-cli-name-width
     4510   v-cli-type-code:resizable in browse br-discard = true
     4511   v-cli-type-code:width in browse br-discard = v-cli-type-code-width
     4512   X_dis-card.sourced-card:resizable in browse br-discard = true
     4513   X_dis-card.sourced-card:width in browse br-discard = v-sourced-card-width
     4514   MENU-ITEM m_first-main-card:SENSITIVE IN MENU menu-b-lkp = (p-list-mode <> 'card':U)
     4515   br-discard:height = v-initial-height + ( if p-list-mode = "client" or p-list-mode = "card"
     4516                                             then 0.0
     4517                                             else 3.0)
     4518   MENU-ITEM m_cli-sourced:sensitive in menu menu-b-add = yes
     4519   MENU-ITEM m_sourced:sensitive in menu menu-b-add-copy = yes
     4520   .
     4521   if cli-recid <> ? then
     4522   FIND b_clients WHERE recid( b_clients ) = cli-recid NO-LOCK .
     4523   ENABLE
     4524   br-discard
     4525   b-exit
     4526   b-mark  WHEN can-do( bttns, "b-mark" )
     4527   b-sel  WHEN can-do( bttns, "b-sel" )
     4528   b-payment when v-cntxt-db-num = 0
     4529   b-sch
     4530   b-print
     4531   b-history
     4532   b-help
     4533   b-chk WHEN p-curr-obj-type = 'маг':U
     4534   b-lkp
     4535   b-add WHEN (not transaction and v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     4536   b-del WHEN (not transaction and v-cntxt-db-num = 0 )
     4537   b-chg WHEN (not transaction and v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     4538   b-prop
     4539   b-disc
     4540   b_clientsi WHEN cli-recid = ?
     4541   b-view
     4542   b-type
     4543   b-disc
     4544   RS-SEARCH
     4545   SPattern
     4546   RS-Global
     4547   b-sl
     4548   WITH FRAME d-dis-card.
     4549   if transaction then do:
     4550     menu-item m_update-prop:sensitive in menu menu-b-prop  = no.
     4551     menu-item m_update-disc:sensitive in menu menu-b-disc  = no.
     4552   end.
     4553   case p-list-mode:
     4554     when 'все':U then do:
     4555       assign
     4556       glob-val = one-base-cur-for-objs(output v-glob-curr-code)
     4557       .
     4558       ASSIGN
     4559       b-add:POPUP-MENU IN FRAME d-dis-card = MENU MENU-b-add-copy:HANDLE.
     4560       RS-GLOBAL = 'все':U.
     4561       glog = RS-GLOBAL:disable("Клиент").
     4562       glog = RS-GLOBAL:disable("Перв.осн.").
     4563     end.
     4564     when 'фирма':U then do:
     4565       ASSIGN
     4566       b-add:POPUP-MENU IN FRAME d-dis-card = MENU MENU-b-add-copy:HANDLE.
     4567       RS-GLOBAL = 'фирма':U.
     4568       glog = RS-GLOBAL:disable("Клиент").
     4569       glog = RS-GLOBAL:disable("Перв.осн.").
     4570       glob-val = yes.
     4571   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4572   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4573     (output RS-val
     4574     )  .
     4575       display
     4576       rs-val
     4577       with frame d-dis-card.
     4578     end.
     4579     when "client" then do:
     4580       RS-GLOBAL = 'карты-клиента':U.
     4581       glog = RS-GLOBAL:disable("Глоб.").
     4582       glog = RS-GLOBAL:disable("По фирме").
     4583       glog = RS-GLOBAL:disable("Перв.осн.").
     4584       glob-val = yes.
     4585     end.
     4586     when "card" then do:
     4587       t-totals = substitute("Итоги по всем картам к первич. осн. карте &1", p-first-main-card).
     4588       RS-GLOBAL = 'карта':U.
     4589       glog = RS-GLOBAL:disable("Глоб.").
     4590       glog = RS-GLOBAL:disable("По фирме").
     4591       glog = RS-GLOBAL:disable("Клиент").
     4592       glob-val = yes.
     4593     end.
     4594   end case.
     4595   display
     4596   RS-GLOBAL
     4597   WITH frame d-dis-card.
     4598   IF glob-val AND pravo then
     4599   ENABLE RS-VAL when glob-val
     4600   WITH FRAME d-dis-card.
     4601   else do:
     4602     rs-val = 'rubl':U.
     4603     display
     4604     rs-val
     4605     with frame d-dis-card.
     4606     disable
     4607     Rs-val
     4608     WITH FRAME d-dis-card.
     4609   end.
     4610   if NOT ((p-list-mode = "client":u
     4611           or
     4612           p-list-mode = "card":u )
     4613   and pravo) then
     4614   HIDE
     4615   F-disc-sum
     4616   F-gds-sum
     4617   F-netto-sum
     4618   F-pay-sum
     4619   F-num-chk
     4620   F-credit-sum
     4621   F-saldo-sum
     4622   t-totals
     4623   b-disc
     4624   IN FRAME d-dis-card.
     4625   END PROCEDURE.
     4626   PROCEDURE Get-Totals :
     4627   DEFINE variable dopi2 as integer no-undo init -1.
     4628   define variable dop-num-chk as integer no-undo.
     4629   define variable dop-gds-sum as decimal no-undo.
     4630   define variable dop-disc-sum as decimal no-undo.
     4631   define variable dop-netto-sum as decimal no-undo.
     4632   define variable dop-pay-sum as decimal no-undo.
     4633   define variable dop-credit-sum as decimal no-undo.
     4634   define variable dop-saldo-sum as decimal no-undo.
     4635   CASE p-list-mode:
     4636     when "client":U then do:
     4637       IF RS-val = 'rubl':U then do:
     4638         FOR EACH b-d-c No-LOCK WHERE
     4639                 b-d-c.cli-type = b_clients.obj-type
     4640             AND b-d-c.cli-code = b_clients.obj-code,
     4641             EACH ub.dis-host NO-LOCK WHERE
     4642                 ub.dis-host.d-card = b-d-c.d-card
     4643             AND ub.dis-host.host-code > 0
     4644             and ub.dis-host.dt-code = 0
     4645             :
     4646           assign
     4647           dop-num-chk = dop-num-chk + ub.dis-host.num-chk
     4648           dop-gds-sum = dop-gds-sum + ub.dis-host.gds-tot-rubl
     4649           dop-disc-sum = dop-disc-sum + ub.dis-host.gds-dis-rubl
     4650           dop-netto-sum = dop-gds-sum - dop-disc-sum
     4651           dop-pay-sum = dop-pay-sum + ub.dis-host.pay-tot-rubl
     4652           dop-credit-sum = dop-netto-sum - dop-pay-sum
     4653           dop-saldo-sum = dop-saldo-sum + b-d-c.saldo-rubl
     4654           .
     4655         END.
     4656       end.
     4657       if RS-VAL = 'base':U then do:
     4658           FOR EACH b-d-c No-LOCK WHERE
     4659                   b-d-c.cli-type = b_clients.obj-type
     4660               AND b-d-c.cli-code = b_clients.obj-code,
     4661               EACH dis-host NO-LOCK WHERE
     4662                   dis-host.d-card = b-d-c.d-card
     4663               AND dis-host.host-code > 0
     4664               and dis-host.dt-code = 0
     4665               :
     4666           if dopi2 = -1 then do:
     4667               dopi2 = ub.dis-host.host-code.
     4668               FINd FIRST ub.sysconf No-LOCK WHERE ub.sysconf.host-code = ub.dis-host.host-code no-error .
     4669               if not available sysconf then do:
     4670                  undo, return error .
     4671               end.
     4672               dopi = sysconf.base-code.
     4673           end.
     4674           else if dopi2 <> ub.dis-host.host-code then do:
     4675               FIND FIRST ub.sysconf No-LOCK WHERE ub.sysconf.host-code = ub.dis-host.host-code no-error .
     4676               if not available ub.sysconf then do:
     4677                  undo, return error .
     4678               end.
     4679               if ub.sysconf.base-code <> dopi then do:
     4680                   return error.
     4681               end.
     4682           end.
     4683           assign
     4684           dop-num-chk = dop-num-chk + dis-host.num-chk
     4685           dop-gds-sum = dop-gds-sum + dis-host.gds-tot-base
     4686           dop-disc-sum = dop-disc-sum + dis-host.gds-dis-base
     4687           dop-netto-sum = dop-gds-sum - dop-disc-sum
     4688           dop-pay-sum = dop-pay-sum + dis-host.pay-tot-base
     4689           dop-credit-sum = dop-netto-sum - dop-pay-sum
     4690           dop-saldo-sum = dop-saldo-sum + b-d-c.saldo-base
     4691           .
     4692         END.
     4693       end.
     4694     end.
     4695     when "card":U then do:
     4696       IF RS-val = 'rubl':U then do:
     4697         FOR EACH b-d-c No-LOCK WHERE
     4698                 b-d-c.first-main-card = p-first-main-card,
     4699             EACH dis-host NO-LOCK WHERE
     4700                 dis-host.d-card = b-d-c.d-card
     4701             AND dis-host.host-code > 0
     4702             and dis-host.dt-code = 0:
     4703           assign
     4704           dop-num-chk = dop-num-chk + dis-host.num-chk
     4705           dop-gds-sum = dop-gds-sum + dis-host.gds-tot-rubl
     4706           dop-disc-sum = dop-disc-sum + dis-host.gds-dis-rubl
     4707           dop-netto-sum = dop-gds-sum - dop-disc-sum
     4708           dop-pay-sum = dop-pay-sum + dis-host.pay-tot-rubl
     4709           dop-credit-sum = dop-netto-sum - dop-pay-sum
     4710           dop-saldo-sum = dop-saldo-sum + b-d-c.saldo-rubl
     4711           .
     4712         END.
     4713       end.
     4714       if RS-VAL = 'base':U then do:
     4715           FOR EACH b-d-c No-LOCK WHERE
     4716                   b-d-c.first-main-card = p-first-main-card,
     4717               EACH dis-host NO-LOCK WHERE
     4718                   dis-host.d-card = b-d-c.d-card
     4719               AND dis-host.host-code > 0
     4720               and dis-host.dt-code = 0 :
     4721           if dopi2 = -1 then do:
     4722               dopi2 = dis-host.host-code.
     4723               FINd FIRST sysconf No-LOCK WHERE sysconf.host-code = dis-host.host-code.
     4724               dopi = sysconf.base-code.
     4725           end.
     4726           else if dopi2 <> dis-host.host-code then do:
     4727               FIND FIRST sysconf No-LOCK WHERE sysconf.host-code = dis-host.host-code.
     4728               if sysconf.base-code <> dopi then do:
     4729                   return error.
     4730               end.
     4731           end.
     4732           assign
     4733           dop-num-chk = dop-num-chk + dis-host.num-chk
     4734           dop-gds-sum = dop-gds-sum + dis-host.gds-tot-base
     4735           dop-disc-sum = dop-disc-sum + dis-host.gds-dis-base
     4736           dop-netto-sum = dop-gds-sum - dop-disc-sum
     4737           dop-pay-sum = dop-pay-sum + dis-host.pay-tot-base
     4738           dop-credit-sum = dop-netto-sum - dop-pay-sum
     4739           dop-saldo-sum = dop-saldo-sum + b-d-c.saldo-base
     4740           .
     4741         END.
     4742       end.
     4743     end.
     4744   END CASE.
     4745   assign
     4746   f-num-chk = dop-num-chk
     4747   f-gds-sum = dop-gds-sum
     4748   f-disc-sum = dop-disc-sum
     4749   f-netto-sum = dop-netto-sum
     4750   F-pay-sum = dop-pay-sum
     4751   f-credit-sum = dop-credit-sum
     4752   f-saldo-sum = dop-saldo-sum
     4753   .
     4754   DISPLAY
     4755   t-totals
     4756   f-disc-sum
     4757   f-gds-sum
     4758   f-netto-sum
     4759   F-pay-sum
     4760   f-num-chk
     4761   f-credit-sum
     4762   f-saldo-sum
     4763   WITH FRAME d-dis-card.
     4764   END PROCEDURE.
     4765   PROCEDURE OpenBr :
     4766   define input  parameter p-open-query     as logical   no-undo .
     4767   define input  parameter p-find-next      as logical   no-undo .
     4768   define input  parameter p-find-condition as character no-undo .
     4769   define variable l-query-was-opened as logical no-undo .
     4770   run waitfram-show in this-procedure ( input "Ждите...").
     4771   define variable sort-column-phrase as character no-undo .
     4772   case sort-column-name :
     4773     when "" then do:
     4774       assign
     4775         sort-column-phrase = ""
     4776       .
     4777     end.
     4778     otherwise do:
     4779       assign
     4780         sort-column-phrase = "by " + sort-column-name
     4781       .
     4782     end.
     4783   end case.
     4784   CASE p-list-mode:
     4785       when 'фирма':U then do:
     4786         if p-open-query then do:
     4787           ASSIGN
     4788           frame d-dis-card:TITLE = substitute("ДИСКОНТНЫЕ КАРТЫ ПО ФИРМЕ &1", v-host-name).
     4789         end.
     4790         assign
     4791         filter-point-name = filter-point-name0 + " " + p-list-mode
     4792         filter-point = filter-point0 + " " + p-list-mode.
     4793         if rs-search = 'название':U then do:
     4794                   if sort-column-name = '':u then do:
     4795   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4796   define variable  l-disable-where-43  as logical   no-undo .
     4797   define variable  l-filter-open-43    as logical   .
     4798   define variable  flt-rec-43       as recid     no-undo .
     4799   define variable  filter-name-43      as character no-undo .
     4800   define variable  where-phrase-43     as character no-undo .
     4801   define variable  sort-phrase-43      as character no-undo .
     4802   define variable  where-phrase-rus-43 as character no-undo .
     4803   define variable  sort-phrase-rus-43  as character no-undo .
     4804     run waitfram-show in this-procedure
     4805       (input "ЖДИТЕ ..."
     4806       ).
     4807   run gbl/flt-get.p
     4808     (input filter-point
     4809     ,output flt-rec-43
     4810     ,output filter-name-43
     4811     ,output where-phrase-43
     4812     ,output sort-phrase-43
     4813     ,output where-phrase-rus-43
     4814     ,output sort-phrase-rus-43
     4815     ).
     4816   if p-open-query then do:
     4817       run set-filter-name in this-procedure
     4818         (INPUT filter-name-43
     4819         ) no-error .
     4820     assign
     4821       l-filter-open-43 = false
     4822     .
     4823     if flt-rec-43 <> ?
     4824       or sort-column-phrase > ""
     4825     then do:
     4826       define variable  parameter-2-43 as character no-undo .
     4827       define variable  parameter-3-43 as character no-undo .
     4828       define variable  parameter-4-43 as character no-undo .
     4829       define variable  parameter-5-43 as character no-undo .
     4830       define variable  parameter-6-43 as character no-undo .
     4831       define variable  parameter-7-43 as character no-undo .
     4832         assign
     4833         parameter-3-43 =
     4834                                 "FOR EACH X_dis-card"
     4835         parameter-4-43 =
     4836           (
     4837             if (" X_dis-card.emitent-host-code = p-curr-host-code " + " " + where-phrase-43) <> ""
     4838             then  substitute('X_dis-card.emitent-host-code = &1', p-curr-host-code)  + " " + where-phrase-43
     4839             else "true"
     4840           )
     4841         parameter-5-43 = (" " + "" + " " + ", FIRST X_clients NO-LOCK WHERE X_clients.obj-type = X_dis-card.cli-type AND X_clients.obj-code = X_dis-card.cli-code , FIRST X_dis-host NO-LOCK WHERE          X_dis-host.host-code = 0          AND X_dis-host.d-card = X_dis-card.d-card                        and X_dis-host.dt-code = 0")
     4842         parameter-6-43 = if sort-phrase-43 = ''
     4843                              then
     4844           (
     4845           " " + "  " +
     4846             " " + sort-column-phrase +
     4847           " " + " by X_dis-card.d-card "
     4848           )
     4849                              else
     4850           (
     4851           " " + "  " +
     4852             " " + sort-column-phrase +
     4853           " " + sort-phrase-43
     4854           )
     4855         parameter-7-43 =
     4856           " indexed-reposition  "
     4857       .
     4858       do
     4859       on stop undo, leave
     4860       on error undo, leave
     4861       :
     4862         assign
     4863           l-disable-where-43 =
     4864             (" X_dis-card.emitent-host-code = p-curr-host-code " + " " + where-phrase-43 = "")
     4865         .
     4866         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4867                             ,input QUERY br-discard:handle
     4868                             ,input parameter-3-43
     4869                             ,input parameter-4-43
     4870                             ,input parameter-5-43
     4871                             ,input parameter-6-43
     4872                             ,input parameter-7-43
     4873                             )
     4874         .
     4875         assign
     4876           l-filter-open-43 = true
     4877         .
     4878       end.
     4879       if l-filter-open-43 = false then do:
     4880         message
     4881           "Ошибка при фильтрации / сортировке" skip
     4882           "Будут показаны записи без учета фильтра" skip
     4883           view-as alert-box .
     4884       end.
     4885       else do:
     4886           assign
     4887             l-query-was-opened = true
     4888           .
     4889       end.
     4890     end.
     4891     if l-filter-open-43 = false then do:
     4892       OPEN QUERY br-discard FOR EACH X_dis-card
     4893         where  X_dis-card.emitent-host-code = p-curr-host-code
     4894       , FIRST X_clients NO-LOCK WHERE X_clients.obj-type = X_dis-card.cli-type AND X_clients.obj-code = X_dis-card.cli-code , FIRST X_dis-host NO-LOCK WHERE          X_dis-host.host-code = 0          AND X_dis-host.d-card = X_dis-card.d-card                        and X_dis-host.dt-code = 0
     4895          by X_dis-card.d-card
     4896         indexed-reposition
     4897     .
     4898         assign
     4899           l-query-was-opened = true
     4900         .
     4901     end.
     4902   end.
     4903   else do:
     4904     assign
     4905       v-doc-rec = recid( X_dis-card )
     4906     .
     4907     do
     4908     on stop undo, leave
     4909     on error undo, leave
     4910     :
     4911       if QUERY br-discard:handle:get-buffer-handle(1) = (buffer X_clients:handle) then do:
     4912         assign
     4913         parameter-2-43 = (if p-find-next then "true":u else "false":u )
     4914         parameter-4-43 =
     4915           "where ":u +  substitute('X_dis-card.emitent-host-code = &1', p-curr-host-code)  + " ":u + where-phrase-43 + " ":u + p-find-condition + " " + ""
     4916         parameter-5-43 = "  "
     4917       .
     4918         run fltopend_fltfindd in this-procedure  (
     4919                             input this-procedure:handle
     4920                             ,input QUERY br-discard:handle
     4921                             ,input rowid(X_dis-card)
     4922                             ,input logical(parameter-2-43)
     4923                             ,input no-lock
     4924                             ,input (buffer X_dis-card:handle)
     4925                             ,input parameter-4-43
     4926                             ,input parameter-5-43
     4927                             ) no-error.
     4928         .
     4929         assign
     4930           v-doc-rec = integer(return-value)
     4931           v-fltopend-rowid[1] = ?
     4932         .
     4933       end.
     4934       else do:
     4935         assign
     4936         parameter-2-43 = (if p-find-next then "true":u else "false":u )
     4937         parameter-3-43 =  "FOR EACH X_dis-card"
     4938         parameter-4-43 =
     4939           (
     4940             if (" X_dis-card.emitent-host-code = p-curr-host-code " + " " + where-phrase-43) <> ""
     4941             then  substitute('X_dis-card.emitent-host-code = &1', p-curr-host-code)  + " " + where-phrase-43
     4942             else "true"
     4943           )
     4944         parameter-5-43 = (" " + "" + " " + ", FIRST X_clients NO-LOCK WHERE X_clients.obj-type = X_dis-card.cli-type AND X_clients.obj-code = X_dis-card.cli-code , FIRST X_dis-host NO-LOCK WHERE          X_dis-host.host-code = 0          AND X_dis-host.d-card = X_dis-card.d-card                        and X_dis-host.dt-code = 0" + " " + p-find-condition)
     4945         parameter-6-43 = if sort-phrase-43 = ''
     4946                              then
     4947           (
     4948           " " + "  " +
     4949             " " + sort-column-phrase +
     4950           " " + " by X_dis-card.d-card "
     4951           )
     4952                              else
     4953           (
     4954           " " + "  " +
     4955             " " + sort-column-phrase +
     4956           " " + sort-phrase-43
     4957           )
     4958         parameter-7-43 =
     4959           " indexed-reposition  "
     4960       .
     4961         run fltopend_fltfindq in this-procedure  (
     4962                             input this-procedure:handle
     4963                             ,input QUERY br-discard:handle
     4964                             ,input logical(parameter-2-43)
     4965                             ,input no-lock
     4966                             ,input parameter-3-43
     4967                             ,input parameter-4-43
     4968                             ,input parameter-5-43
     4969                             ,input parameter-6-43
     4970                             ,input parameter-7-43
     4971                             ,output v-fltopend-rowid
     4972                             ) no-error.
     4973         .
     4974         v-doc-rec = ?.
