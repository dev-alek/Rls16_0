     4053   procedure diasize_set-browse-handle :
     4054     define input  parameter p-browse-handle as handle   no-undo .
     4055     define buffer buf_temp-browse-handle for temp-browse-handle .
     4056     do
     4057     on error undo, return error return-value
     4058     :
     4059       assign
     4060         v-diasize-browse-handle = p-browse-handle
     4061       .
     4062       for each buf_temp-browse-handle
     4063       on error undo, return error return-value
     4064       :
     4065         delete buf_temp-browse-handle .
     4066       end.
     4067     end.
     4068   end procedure.
     4069   procedure diasize_add_browse :
     4070     define input  parameter p-browse-type   as character no-undo .
     4071     define input  parameter p-browse-handle as handle    no-undo .
     4072     define buffer buf_temp-browse-handle for temp-browse-handle .
     4073     do
     4074     on error undo, return error return-value
     4075     :
     4076       assign
     4077         v-diasize-browse-number = v-diasize-browse-number + 1
     4078       .
     4079       create buf_temp-browse-handle .
     4080       assign
     4081         buf_temp-browse-handle.browse-type   = p-browse-type
     4082         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4083         buf_temp-browse-handle.browse-handle = p-browse-handle
     4084       .
     4085     end.
     4086   end procedure.
     4087   procedure diasize_init :
     4088     define variable v-default-value    as logical   no-undo .
     4089     define variable v-restore-saved    as logical   no-undo .
     4090     define variable v-resize-value-str as character no-undo .
     4091     do
     4092     on error undo, return error return-value
     4093     :
     4094       do with frame d-dis-card
     4095       :
     4096         assign
     4097           v-diasize-orig-frame-height = frame d-dis-card :height
     4098           v-diasize-orig-frame-width  = frame d-dis-card :width
     4099           v-diasize-browse-handle     = browse br-discard :handle
     4100         .
     4101         create button v-diasize-resize-button
     4102         assign
     4103           parent        = frame d-dis-card :first-child
     4104           label         = "s"
     4105           height-pixels = 16
     4106           width-pixels  = 16
     4107           visible       = true
     4108           sensitive     = true
     4109           movable       = true
     4110           triggers:
     4111             on end-move persistent run diasize_end-move in this-procedure .
     4112           end triggers.
     4113         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4114         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4115         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4116         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4117         assign
     4118           v-diasize-wndmax = false
     4119         .
     4120         if connected("ub") = true
     4121         then do:
     4122           define variable v-cntxt-db-num        as integer   no-undo .
     4123           define variable v-cntxt-userid        as character no-undo .
     4124           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4125                                             , OUTPUT v-cntxt-userid
     4126                                             ) .
     4127           run gbl/wndpar_r.p
     4128             (input  v-cntxt-db-num
     4129             ,input  v-cntxt-userid
     4130             ,input  'wndmax':U
     4131             ,output v-diasize-wndmax
     4132             ,output v-default-value
     4133             ) .
     4134         end.
     4135         assign
     4136           v-diasize-wndstore = false
     4137         .
     4138         if connected("ub") = true
     4139         then do:
     4140           run gbl/wndpar_r.p
     4141             (input  v-cntxt-db-num
     4142             ,input  v-cntxt-userid
     4143             ,input  'wndstore':U
     4144             ,output v-diasize-wndstore
     4145             ,output v-default-value
     4146             ) .
     4147         end.
     4148         assign
     4149           v-diasize-proc-name = entry(1, program-name(2), '.')
     4150         .
     4151         if v-diasize-wndstore = true
     4152         then do:
     4153           assign
     4154             v-restore-saved = false
     4155           .
     4156           if connected("ub") = true
     4157           then do:
     4158             run gbl/wndsizer.p
     4159               (input  v-cntxt-db-num
     4160               ,input  v-cntxt-userid
     4161               ,input  v-diasize-proc-name
     4162               ,input  'height':u
     4163               ,output v-resize-value-str
     4164               ) .
     4165             if v-resize-value-str <> '':U
     4166             then do:
     4167               run diasize_change-height in this-procedure
     4168                 (input  integer(v-resize-value-str)
     4169                 ,input  true
     4170                 ) .
     4171               assign
     4172                 v-restore-saved = true
     4173               .
     4174             end.
     4175           end.
     4176           if connected("ub") = true
     4177           then do:
     4178             run gbl/wndsizer.p
     4179               (input  v-cntxt-db-num
     4180               ,input  v-cntxt-userid
     4181               ,input  v-diasize-proc-name
     4182               ,input  'width':u
     4183               ,output v-resize-value-str
     4184               ) .
     4185             if v-resize-value-str <> '':U
     4186             then do:
     4187               run diasize_change-width in this-procedure
     4188                 (input  integer(v-resize-value-str)
     4189                 ,input  true
     4190                 ) .
     4191               assign
     4192                 v-restore-saved = true
     4193               .
     4194             end.
     4195           end.
     4196           if v-restore-saved <> true
     4197           then do:
     4198             if v-diasize-wndmax = true
     4199             then do:
     4200               run diasize_maximize in this-procedure
     4201                 (input  true
     4202                 ) .
     4203             end.
     4204           end.
     4205         end.
     4206         else do:
     4207           if v-diasize-wndmax = true
     4208           then do:
     4209             run diasize_maximize in this-procedure
     4210               (input  true
     4211               ) .
     4212           end.
     4213         end.
     4214       end.
     4215     end.
     4216   end procedure.
