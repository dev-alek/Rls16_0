     2027   DO:
     2028   define buffer b-dis-card for ub.dis-card .
     2029   define buffer for-clients for ub.clients.
     2030   define variable old-list-mode as char no-undo.
     2031   DEFINE VARIABLE varhost-code like ub.sysconf.host-code no-undo .
     2032     define variable v-ok as logical no-undo .
     2033   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
