     2485     ,output v-conf-type
     2486     ) no-error .
     2487   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2488     (input  'iscredit'
     2489     ,input  0
     2490     ,input  '':U
     2491     ,input  0
     2492     ,input  '':U
     2493     ,input  '':U
     2494     ,input  '':U
     2495     ,input  NO
     2496     ,output v-is-credit
     2497     ,output v-conf-type
     2498     ) NO-ERROR .
     2499       assign
     2500       v-add = (X_dis-card.credit-card
     2501               and X_dis-card.emitent-host-code <> 0
     2502               and logical(v-is-credit) = yes
     2503               )
     2504       no-error.
     2505       run ref/payments.w (
     2506                        input parparentproc
     2507                       ,input (if v-add then "b-add" else '')
     2508                       ,input 'карта':U
     2509                       ,input ?
     2510                       ,input ?
     2511                       ,input ""
     2512                       ,input ""
     2513                       ,input X_dis-card.d-card
     2514                       ,output v-rid-list) no-error .
     2515     end.
     2516     apply "entry" to br-discard.
     2517   END.
     2518   ON CHOOSE OF b-print IN FRAME d-dis-card
     2519   DO:
     2520       run ref/discardp.p (
     2521                      input parparentproc
     2522                     ,input frame d-dis-card:title
     2523                     ,input pravo
     2524                     ,input rs-val
     2525                     ,input p-curr-host-code
     2526                     ,input p-curr-obj-type
     2527                     ,input p-curr-obj-code
     2528                     ,buffer X_dis-card
     2529                     ,input query br-discard:handle
     2530                       ) no-error.
     2531       If error-status:error then do:
     2532           return no-apply.
     2533       end.
     2534   END.
     2535   ON CHOOSE OF B-prop IN FRAME d-dis-card
     2536   DO:
     2537     if prop-option = "":U then do:
     2538       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     2539       if error-status :error then do: return no-apply. end.
     2540     end.
     2541     if prop-option = "":U then do:
     2542         return no-apply.
     2543     end.
     2544     RUN proc-b-prop IN THIS-PROCEDURE NO-ERROR.
     2545     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2546   END.
     2547   ON CHOOSE OF B-sch IN FRAME d-dis-card
     2548   DO:
     2549     run proc-b-sch in this-procedure no-error.
     2550     if error-status:error then return no-apply.
     2551   END.
     2552   ON CHOOSE OF b-sel IN FRAME d-dis-card
     2553   DO:
     2554       if ( available X_dis-card ) AND ( rid-list = "" ) then
     2555           rid-list = string( recid( X_dis-card ) ) .
     2556   END.
     2557   ON CHOOSE OF b-sl IN FRAME d-dis-card
     2558   DO:
     2559     define variable v-loc-rid-list as character no-undo .
     2560     if not available X_dis-card then undo, return no-apply.
     2561     run ref/stop-lls.w ( INPUT parparentproc
     2562                     ,INPUT "":U
     2563                     ,INPUT 'ПРОСМОТР':U
     2564                     ,INPUT '':U
     2565                     ,input X_dis-card.d-card
     2566                     ,INPUT-OUTPUT v-loc-rid-list ) NO-ERROR.
     2567   END.
     2568   ON CHOOSE OF B-type IN FRAME d-dis-card
     2569   DO:
     2570   define variable dctype-ri as recid no-undo.
     2571     if not avail X_dis-card then return no-apply.
     2572       FIND FIRST ub.dis-card-type No-LOCK WHERE
     2573                   ub.dis-card-type.type = X_dis-card.type AND
     2574                   ub.dis-card-type.emitent-host-code = X_dis-card.emitent-host-code AND
     2575                   ub.dis-card-type.host-code = 0 and
     2576                   ub.dis-card-type.obj-type = "":U and
     2577                   ub.dis-card-type.obj-code = 0 No-ERROR.
     2578        if not avail ub.dis-card-type then do:
     2579           message "Неверный тип дисконтной карты"
     2580           view-as alert-box ERROR.
     2581           return no-apply.
     2582        end.
     2583        dctype-ri = recid( ub.dis-card-type ) .
     2584        run ref/dc-typei.w (
     2585                       input parparentproc
     2586                      ,input 'ПРОСМОТР':U
     2587                      ,input p-curr-host-code
     2588                      ,input p-curr-obj-type
     2589                      ,input p-curr-obj-code
     2590                      ,input-output dctype-ri ).
     2591        apply "ENTRY" to br-discard.
     2592   END.
     2593   ON CHOOSE OF b-view IN FRAME d-dis-card
     2594   DO:
     2595   define buffer b-dis-card for ub.dis-card .
     2596   define variable rc as recid.
     2597   define variable old-d-pcnt like ub.dis-card.d-pcnt.
     2598   define variable old-val as character no-undo .
     2599   if available X_dis-card then  do:
     2600     rc = recid(X_dis-card).
     2601     if X_dis-card.emitent-host-code = p-curr-host-code or X_dis-card.emitent-host-code = 0 then do:
     2602         old-d-pcnt = X_dis-card.d-pcnt.
     2603         old-val = rs-val.
     2604         run ref/dc-view.w ( input parparentproc
     2605                       ,input p-curr-host-code
     2606                       ,input p-curr-obj-type
     2607                       ,input p-curr-obj-code
     2608                       ,input X_dis-card.d-card
     2609                       ,input (if p-list-mode = "card" then no else ?)
     2610                       ,input (if p-list-mode = "card" then no else ?)
     2611                       ) .
     2612         rs-val = old-val.
     2613         DISPLAY RS-val with frame d-dis-card.
     2614         run OpenBR in this-procedure ( input yes, input no, input no).
     2615         REPOSITION br-discard to recid rc NO-ERROR.
     2616       if error-status:error then do:
     2617           if error-status:error then do:                           find first pos_dis-card no-lock where                                   recid(pos_dis-card) = rc no-error .                             message                             "Невозможно позиционироваться на записи ДИСКОНТНАЯ КАРТА" skip                            string(if avail pos_dis-card                                     then  substitute("Номер карты: &1"                                                     , pos_dis-card.d-card)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     2618       end.
     2619     end.
     2620     else do:
     2621         message "Данная дисконтная карта принадлежит другой фирме - просмотр запрещен!"
     2622         view-as alert-box ERROR.
     2623     end.
     2624   end.
     2625   apply "entry" to br-discard.
     2626   END.
     2627   ON DEFAULT-ACTION OF br-discard IN FRAME d-dis-card
     2628   DO:
     2629       if b-sel:sensitive THEN
     2630           apply "CHOOSE":U to b-sel.
     2631       else
     2632           apply "CHOOSE":U to b-view.
     2633   END.
     2634   ON ITERATION-CHANGED OF br-discard IN FRAME d-dis-card
     2635   DO:
     2636       if available X_dis-card then
     2637           log-res = br-discard:select-focused-row( ).
     2638   END.
     2639   ON LEFT-MOUSE-DBLCLICK OF br-discard IN FRAME d-dis-card
     2640   DO:
     2641       apply "DEFAULT-ACTION":U to self.
     2642   END.
     2643   ON RETURN OF br-discard IN FRAME d-dis-card
     2644   DO:
     2645       apply "DEFAULT-ACTION":U to self.
     2646   END.
     2647   ON CHOOSE OF b_clientsi IN FRAME d-dis-card
     2648   DO:
     2649   define variable cli-ri as recid init ? no-undo .
     2650       if available X_dis-card THEN do:
     2651               run ref/showcli.p (
     2652                input parparentproc
     2653               ,input X_dis-card.cli-type
     2654               ,input X_dis-card.cli-code
     2655               ).
