     6778     when "c-dc-hist":U then do:
     6779       run ref/cdchist.w (
     6780                       INPUT parparentproc
     6781                       ,input p-curr-host-code
     6782                       ,input p-curr-obj-type
     6783                       ,input p-curr-obj-code
     6784                       ,input "":U
     6785                       ,input "one":U
     6786                       ,input X_dis-card.d-card
     6787                       ,input X_dis-card.card-num
     6788                       ,input p-curr-obj-type
     6789                       ,input p-curr-obj-code
     6790                       ,input p-curr-host-code
     6791                       ,input ?
     6792                       ,input "":U
     6793                       ,input "":U
     6794                       ,input ?
     6795                       ,input-output parref-list
     6796                    ) no-error .
     6797     end.
     6798     when "c-dc-hist-plus":U then do:
     6799       run ref/cdchist.w (
     6800                       INPUT parparentproc
     6801                       ,input p-curr-host-code
     6802                       ,input p-curr-obj-type
     6803                       ,input p-curr-obj-code
     6804                       ,input "":U
     6805                       ,input "card-num":U
     6806                       ,input X_dis-card.d-card
     6807                       ,input X_dis-card.card-num
     6808                       ,input p-curr-obj-type
     6809                       ,input p-curr-obj-code
     6810                       ,input p-curr-host-code
     6811                       ,input ?
     6812                       ,input "":U
     6813                       ,input "":U
     6814                       ,input ?
     6815                      ,input-output parref-list
     6816                    ) no-error .
     6817     end.
     6818   END CASE.
     6819   apply "entry" to br-discard in frame d-dis-card.
     6820   END PROCEDURE.
     6821   PROCEDURE proc-b-prop :
     6822   define variable loc#log as logical no-undo.
     6823   define variable v-update-attr as logical no-undo .
     6824   define variable v-is-error as logical no-undo .
     6825   define variable log-res as logical no-undo .
     6826   define buffer prop_dis-card for ub.dis-card.
     6827   define buffer buf_dis-card-property for ub.dis-card-property.
     6828   if not available X_dis-card then return error .
     6829   FIND FIRST prop_dis-card No-LOCK WHERE
     6830                recid(prop_dis-card) = recid(X_dis-card) no-error.
     6831   if not available prop_dis-card then return error .
     6832   IF prop-option = 'ИЗМЕНЕНИЕ':U THEN DO:
     6833   define variable vss-include-info63 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6834   do:
     6835     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6836       (input  v-cntxt-db-num
     6837       ,input  v-cntxt-userid
     6838       ,input  0
     6839       ,input  'actn_referense-dis_input-deletion-updating':U
     6840       ,input  'firm':U
     6841       ,input  p-curr-host-code
     6842       ,input  '':U
     6843       ,input  0
     6844       ,input  0
     6845       ,input  0
     6846       ,input  0
     6847       ,input  false
     6848       ,output loc#log
     6849       )  .
     6850   end.
     6851   END.
     6852   do
     6853   on error undo, return error
     6854   :
     6855     run ref/dc-propr.p ( input parparentproc
     6856                    ,input (if prop_dis-card.status_ <> 'удал':U
     6857                            and loc#log
     6858                            AND prop-option = 'ИЗМЕНЕНИЕ':U
     6859                            then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U)
     6860                    ,input prop_dis-card.d-card
     6861                    ,input prop_dis-card.emitent-host-code
     6862                    ,input prop_dis-card.type
     6863                    ,input p-curr-host-code
     6864                    ,input p-curr-obj-type
     6865                    ,input p-curr-obj-code
     6866                    ,input yes
     6867                    ,output v-update-attr
     6868                    ,output v-is-error
     6869                   ) no-error .
     6870     if error-status:error then undo, return error .
     6871     if prop-option = 'ИЗМЕНЕНИЕ':U then do:
     6872       ri = recid(X_dis-card).
     6873       run OpenBr in this-procedure ( input yes, input no, input no).
     6874       reposition br-discard to recid ri no-error.
     6875       if error-status:error then do:
     6876         if error-status:error then do:                           find first pos_dis-card no-lock where                                   recid(pos_dis-card) = ri no-error .                             message                             "Невозможно позиционироваться на записи ДИСКОНТНАЯ КАРТА" skip                            string(if avail pos_dis-card                                     then  substitute("Номер карты: &1"                                                     , pos_dis-card.d-card)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     6877       end.
     6878       if available X_dis-card then do:
     6879         log-res = br-discard:select-focused-row( ) in frame d-dis-card .
     6880       end.
     6881     end.
     6882   end.
     6883   END PROCEDURE.
