     6959   PROCEDURE proc-find-client :
     6960   define input parameter p-next as logical no-undo.
     6961   define input parameter p-cli-code like ub.dis-card.cli-code no-undo.
     6962   define variable v-cli-code as character no-undo.
     6963   define variable v-cli-code-int as integer no-undo .
     6964   assign
     6965   v-cli-code-int = integer(p-cli-code)
     6966   NO-ERROR.
     6967   IF ERROR-STATUS:ERROR THEN DO:
     6968       message "Введите ЧИСЛЕННЫЙ код клиента!" view-as alert-box ERROR.
     6969       RETURN ERROR.
     6970   END.
     6971   run OpenBr in this-procedure
     6972       (input false
     6973       ,input p-next
     6974       ,input substitute("and (X_dis-card.cli-type = 'орг':U or X_dis-card.cli-type = 'чел':U) and X_dis-card.cli-code = &1 "
     6975         , v-cli-code-int)
     6976       ).
     6977   apply "entry":u to spattern in frame d-dis-card .
     6978   END PROCEDURE.
     6979   PROCEDURE proc-find-d-card :
     6980   define input parameter p-next as logical no-undo.
     6981   define input parameter p-d-card like ub.dis-card.d-card no-undo.
     6982   assign
     6983   p-d-card = replace(p-d-card, chr(34), "":U)
     6984   p-d-card = replace(p-d-card, chr(39), chr(39) + chr(39))
     6985   p-d-card = chr(34) + p-d-card + chr(34).
     6986   run OpenBr in this-procedure
     6987       (input false
     6988       ,input p-next
     6989       ,input substitute(" and X_dis-card.d-card  begins &1 " , p-d-card)
     6990       ).
     6991   apply "entry":u to spattern in frame d-dis-card .
     6992   END PROCEDURE.
     6993   PROCEDURE proc-find-name :
     6994   define input parameter p-next as logical no-undo.
     6995   define input parameter p-name AS CHARACTER no-undo.
     6996   DEFINE VARIABLE v-cli-type LIKE ub.dis-card.cli-type NO-UNDO.
     6997   DEFINE VARIABLE v-cli-code LIKE ub.dis-card.cli-code NO-UNDO.
     6998   assign
     6999   p-name = replace(p-name, chr(34), "":U)
     7000   p-name = replace(p-name, chr(39), chr(39) + chr(39))
     7001   p-name = chr(34) + p-name + chr(34)
     7002       .
     7003   run OpenBr in this-procedure
     7004       (input false
     7005       ,input p-next
     7006       ,input substitute(" and X_clients.obj-name begins &1 "
     7007                         , p-name)).
     7008   apply "entry":u to spattern in frame d-dis-card .
     7009   END PROCEDURE.
