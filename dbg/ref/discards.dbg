     1329   define variable filter-point-name as character no-undo .
     1330   define variable filter-point-name0 as character no-undo init "Дисконтные_карты" .
     1331   define variable filter-point as character no-undo .
     1332   define variable filter-point0 as character no-undo init "discards" .
     1333   define variable status-type as char no-undo.
