        1   DEFINE TEMP-TABLE Temp-hattr NO-UNDO LIKE fin-doc-attr
        2          field user-can-edit as log
        3          field code as character
        4          field value_ as character.
        5   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        6   define input parameter mode as char no-undo.
        7   define input parameter p-host-code like ub.fin-doc-attr.host-code no-undo.
        8   define input parameter p-fin-doc-code like ub.fin-doc-attr.fin-doc-code no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Атрибуты платежа".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure fd-attr-code :
       77     do
       78     on error undo, return error
       79     :
       80       define input  parameter p-code           as character no-undo .
       81       define output parameter p-type           as character no-undo .
       82       define output parameter p-format         as character no-undo .
       83       define output parameter p-label          as character no-undo .
       84       define output parameter p-user-can-edit  as logical   no-undo .
       85       define output parameter p-output-display as logical   no-undo .
       86       define output parameter p-other          as character no-undo .
       87       case p-code :
       88               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       89               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       90               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       91               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       92               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       93               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       94               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
       95               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       96         otherwise do:
       97           undo, return error "неизвестный атрибут платежа" + " " + p-code .
       98         end.
       99       end.
      100     end.
      101   end procedure.
      102   procedure fd-attr-tooltip :
      103     do
      104     on error undo, return error
      105     :
      106       define input  parameter p-code    as character no-undo .
      107       define output parameter p-tooltip as character no-undo .
      108       define output parameter p-label   as character no-undo .
      109       case p-code :
      110               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
      111               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
      112               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
      113               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
      114               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
      115               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
      116               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
      117               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
      118         otherwise do:
      119           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      120         end.
      121       end.
      122     end.
      123   end procedure.
      124   procedure fin-doc-attr-write :
      125    do
      126    on error undo, return error return-value
      127    :
      128   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      129   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      130   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
      131   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
      132   define variable  v-format         as character no-undo .
      133   define variable  v-label          as character no-undo .
      134   define variable  v-user-can-edit  as logical   no-undo .
      135   define variable  v-output-display as logical   no-undo .
      136   define variable  v-other          as character no-undo .
      137   define variable  v-type           as character no-undo .
      138   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      139   run fd-attr-code in this-procedure
      140                                     (input  p-attr-code
      141                                     ,output v-type
      142                                     ,output v-format
      143                                     ,output v-label
      144                                     ,output v-user-can-edit
      145                                     ,output v-output-display
      146                                     ,output v-other
      147                                     ) no-error .
      148   if error-status :error then do:
      149     undo, return error return-value .
      150   end.
      151   find first buf_fin-doc-attr  exclusive-lock  where
      152             buf_fin-doc-attr.attr-code    = p-attr-code
      153         AND buf_fin-doc-attr.host-code    = p-host-code
      154         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
      155     if not available  buf_fin-doc-attr then do:
      156         create buf_fin-doc-attr.
      157         assign
      158         buf_fin-doc-attr.attr-code    = p-attr-code
      159         buf_fin-doc-attr.attr-value   = p-attr-value
      160         buf_fin-doc-attr.host-code    = p-host-code
      161         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
      162         .
      163     end.
      164     else do:
      165          assign
      166          buf_fin-doc-attr.attr-value = p-attr-value.
      167     end.
      168    end.
      169   end procedure.
      170   procedure fd-attr-exist :
      171     do
      172     on error undo, return error
      173     :
      174       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      175       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      176       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      177       define output parameter p-exist   as logical  no-undo .
      178       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      179       define variable  v-type           as character no-undo .
      180       define variable  v-format         as character no-undo .
      181       define variable  v-label          as character no-undo .
      182       define variable  v-user-can-edit  as logical   no-undo .
      183       define variable  v-output-display as logical   no-undo .
      184       define variable  v-other          as character no-undo .
      185       run fd-attr-code in this-procedure
      186         (input  p-code
      187         ,output v-type
      188         ,output v-format
      189         ,output v-label
      190         ,output v-user-can-edit
      191         ,output v-output-display
      192         ,output v-other
      193         ) no-error .
      194       if error-status :error then do:
      195         undo, return error return-value .
      196       end.
      197       find first buf_fin-doc-attr exclusive-lock
      198         where buf_fin-doc-attr.host-code  = p-host-code
      199           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      200           and buf_fin-doc-attr.attr-code = p-code
      201         no-error .
      202       if  available buf_fin-doc-attr then do:
      203         p-exist = yes.
      204       end.
      205     end.
      206   end procedure.
      207   procedure fd-attr-delete :
      208     do
      209     on error undo, return error
      210     :
      211     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      212     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      213     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      214     define output parameter p-deleted  as logical no-undo.
      215       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      216       define variable  v-type           as character no-undo .
      217       define variable  v-format         as character no-undo .
      218       define variable  v-label          as character no-undo .
      219       define variable  v-user-can-edit  as logical   no-undo .
      220       define variable  v-output-display as logical   no-undo .
      221       define variable  v-other          as character no-undo .
      222       run fd-attr-code in this-procedure
      223         (input  p-code
      224         ,output v-type
      225         ,output v-format
      226         ,output v-label
      227         ,output v-user-can-edit
      228         ,output v-output-display
      229         ,output v-other
      230         ) no-error .
      231       if error-status :error then do:
      232         undo, return error return-value .
      233       end.
      234       find first buf_fin-doc-attr exclusive-lock
      235         where buf_fin-doc-attr.host-code  = p-host-code
      236           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      237           and buf_fin-doc-attr.attr-code = p-code
      238         no-error NO-WAIT.
      239       if not available buf_fin-doc-attr then do:
      240         p-deleted = no.
      241       end.
      242       else do:
      243         delete buf_fin-doc-attr no-error .
      244         if error-status:error then do:
      245           undo, return error return-value .
      246         end.
      247         p-deleted = yes.
      248       end.
      249     end.
      250   end procedure.
      251   procedure fin-doc-attr-value :
      252    do
      253    on error undo, return error return-value
      254    :
      255   define input  parameter p-host-code    like ub.fin-doc-attr.host-code    no-undo .
      256   define input  parameter p-fin-doc-code like ub.fin-doc-attr.fin-doc-code     no-undo .
      257   define input  parameter p-attr-code    like ub.fin-doc-attr.attr-code    no-undo .
      258   define output parameter p-attr-value   like ub.fin-doc-attr.attr-value   no-undo .
      259   define variable  v-format         as character no-undo .
      260   define variable  v-label          as character no-undo .
      261   define variable  v-user-can-edit  as logical   no-undo .
      262   define variable  v-output-display as logical   no-undo .
      263   define variable  v-other          as character no-undo .
      264   define variable  v-type           as character no-undo .
      265   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      266   run fd-attr-code in this-procedure
      267     (input  p-attr-code
      268     ,output v-type
      269     ,output v-format
      270     ,output v-label
      271     ,output v-user-can-edit
      272     ,output v-output-display
      273     ,output v-other
      274     ) no-error .
      275   if error-status :error then do:
      276     undo, return error return-value .
      277   end.
      278   find first buf_fin-doc-attr no-lock where
      279             buf_fin-doc-attr.attr-code    = p-attr-code
      280         AND buf_fin-doc-attr.host-code     = p-host-code
      281         AND buf_fin-doc-attr.fin-doc-code = p-fin-doc-code      no-error .
      282     if available  buf_fin-doc-attr then do:
      283       assign
      284       p-attr-value = buf_fin-doc-attr.attr-value
      285       .
      286     end.
      287     else do:
      288       p-attr-value = ? .
      289     end.
      290    end.
      291   end procedure.
      292   procedure fd-attr-news :
      293     do
      294     on error undo, return error
      295     :
      296       define input  parameter p-code           as character no-undo .
      297       define output parameter p-news           as logical   no-undo .
      298       case p-code :
      299               when 'shift-date':U then do:     assign     p-news = no.   end.
      300               when 'shift-num':U then do:     assign     p-news = no.   end.
      301               when 'shift-name':U then do:     assign     p-news = no.   end.
      302               when 'barcode':U then do:     assign     p-news = no.   end.
      303               when 'lockid':U then do:     assign     p-news = no.   end.
      304               when 'cover_sheet':U then do:     assign     p-news = no.   end.
      305               when 'pre-vedom':U then do:     assign     p-news = no.   end.
      306         otherwise do:
      307           undo, return error "неизвестный атрибут платежа " + " " + p-code .
      308         end.
      309       end.
      310     end.
      311   end procedure.
