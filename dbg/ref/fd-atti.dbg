      406   procedure c-fin-doc-attr-value-nextchip :
      407    do
      408    on error undo, return error return-value
      409    :
      410   define input  parameter p-host-code    like ub.c-fin-doc-attr.host-code    no-undo .
      411   define input  parameter p-fin-doc-code like ub.c-fin-doc-attr.fin-doc-code     no-undo .
      412   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
      413   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
      414   define input  parameter p-attr-code    like ub.c-fin-doc-attr.attr-code    no-undo .
      415   define output parameter p-attr-value   like ub.c-fin-doc-attr.attr-value   no-undo .
      416   define variable  v-format         as character no-undo .
      417   define variable  v-label          as character no-undo .
      418   define variable  v-user-can-edit  as logical   no-undo .
      419   define variable  v-output-display as logical   no-undo .
      420   define variable  v-other          as character no-undo .
      421   define variable  v-type           as character no-undo .
      422   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
      423   run fd-attr-code in this-procedure
      424     (input  p-attr-code
      425     ,output v-type
      426     ,output v-format
      427     ,output v-label
      428     ,output v-user-can-edit
      429     ,output v-output-display
      430     ,output v-other
      431     ) no-error .
      432   if error-status :error then do:
      433     undo, return error return-value .
      434   end.
      435   find first buf_c-fin-doc-attr no-lock where
      436             buf_c-fin-doc-attr.attr-code    = p-attr-code
      437         and buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
      438         and buf_c-fin-doc-attr.host-code      = p-host-code
      439         and buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
      440         and buf_c-fin-doc-attr.chip-num         > p-chip-num      no-error .
      441     if available  buf_c-fin-doc-attr then do:
      442       assign
      443       p-attr-value = buf_c-fin-doc-attr.attr-value
      444       .
      445     end.
      446     else do:
      447       p-attr-value = ? .
      448     end.
      449    end.
      450   end procedure.
      451   procedure proc-alt-shift-f2:
      452     if not ibs.th.gbl.gbl-var:rcode
      453   then
      454     run gbl\inidebug.p .
      455   end.
      456   procedure proc-alt-shift-f3:
      457     run gbl/prvssinf.p
      458       ( input this-procedure
      459       ) .
      460   end.
      461   define variable v-inform-launched as logical no-undo initial false .
      462   procedure proc-alt-shift-f4:
      463     define variable v-action as character no-undo .
      464     if v-inform-launched = false then do:
      465       assign
      466         v-inform-launched = true
      467       .
      468       run gbl/d-inform.w
      469         (  input self
      470         ,  input this-procedure
      471         , output v-action
      472         ) no-error .
      473       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      474       assign
      475         v-inform-launched = false
      476       .
      477     end.
      478   end.
      479   procedure proc-alt-f1:
      480     run gbl/corrhelp.p
      481       (input this-procedure
      482       ) .
      483   end .
      484   on alt-shift-f2 anywhere do:
      485     run proc-alt-shift-f2.
      486   end.
      487   on alt-shift-f3 anywhere do:
      488     run proc-alt-shift-f3 in this-procedure .
      489   end.
      490   on alt-shift-f4 anywhere do:
      491     run proc-alt-shift-f4 in this-procedure.
      492   end.
      493   on alt-f1 anywhere do:
      494     run proc-alt-f1 in this-procedure .
      495   end.
      496   define variable updated as logical no-undo.
      497   DEFINE VARIABLE added  as logical no-undo .
      498   define variable add-option as char no-undo.
      499   define variable temp-doc-rec as recid no-undo.
      500   DEFINE BUTTON b-chg
      501        LABEL "&Изменить":L
      502        SIZE 10 BY 1 TOOLTIP "Изменить атрибут платежа".
      503   DEFINE BUTTON b-del
      504        LABEL "&Удалить":L
      505        SIZE 10 BY 1 TOOLTIP "Удалить  атрибут платежа".
      506   DEFINE BUTTON b-help
      507        LABEL "Помо&щь":L
      508        SIZE 10 BY 1.
      509   DEFINE BUTTON B-hist
      510        LABEL "Ис&тория"
      511        SIZE 10 BY 1.
      512   DEFINE BUTTON b-ins
      513        LABEL "&Добавить":L
      514        SIZE 10 BY 1 TOOLTIP "Добавить атрибут платежа".
      515   DEFINE BUTTON b-quit AUTO-GO
      516        LABEL "&Выход ":L
      517        SIZE 10 BY 1 TOOLTIP "Выход из режима".
      518   DEFINE VARIABLE cd-fin-doc-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      519        LABEL "Вн. N"
      520         VIEW-AS TEXT
      521        SIZE 17 BY 1
      522        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      523   DEFINE VARIABLE cd-host-code AS INTEGER FORMAT ">>>>>>>>>>9":U INITIAL 0
      524        LABEL "Фирма"
      525         VIEW-AS TEXT
      526        SIZE 18 BY 1
      527        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      528   DEFINE QUERY BROWSE-2 FOR
      529         Temp-hattr SCROLLING.
      530   DEFINE BROWSE BROWSE-2
      531     QUERY BROWSE-2 DISPLAY
      532         Temp-hattr.attr-code COLUMN-LABEL "Атрибут" FORMAT "X(50)":U
      533         Temp-hattr.attr-value COLUMN-LABEL "Значение" FORMAT "X(600)":U
      534       WITH NO-ROW-MARKERS SEPARATORS SIZE 100 BY 15.33.
      535   DEFINE FRAME Dialog-Frame
      536        b-quit AT ROW 1 COL 1
      537        b-ins AT ROW 1 COL 21
      538        b-chg AT ROW 1 COL 31
      539        b-del AT ROW 1 COL 41
      540        B-hist AT ROW 1 COL 61
      541        b-help AT ROW 1 COL 71
      542        BROWSE-2 AT ROW 4.46 COL 2
      543        cd-host-code AT ROW 3.29 COL 1
      544        cd-fin-doc-code AT ROW 3.29 COL 29.5
      545        SPACE(39.50) SKIP(15.66)
      546       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      547            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      548            TITLE "Атрибуты платежа".
      549   ASSIGN
      550          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      551          FRAME Dialog-Frame:HIDDEN           = TRUE.
      552   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      553   DO:
      554     APPLY "END-ERROR":U TO SELF.
      555   END.
      556   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      557   DO:
      558     if not avail temp-hattr then return no-apply.
      559     run proc-add-chg in this-procedure (no ) no-error.
      560     if error-status:error then return no-apply.
      561     RUN init-proc.
      562   END.
      563   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      564   DO:
      565   define variable loc#log as logical no-undo.
      566   define variable attr-type as character no-undo .
      567   define variable attr-format as character no-undo .
      568   define variable attr-label as character no-undo .
      569   define variable attr-user-can-edit as logical no-undo .
      570   define variable attr-output-display as logical no-undo .
      571   define variable attr-other as char no-undo .
      572   define variable glog as logical no-undo .
      573   DEFINE VARIABLE v-check AS CHARACTER NO-UNDO.
      574   define variable v-correct as logical no-undo .
      575   define variable v-error-code as character no-undo .
      576   DEFINE VARIABLE jj AS INTEGER NO-UNDO.
      577     if not avail temp-hattr then return no-apply.
      578     run fd-attr-code (
      579       input  temp-hattr.code
      580       ,output attr-type
      581       ,output attr-format
      582       ,output attr-label
      583       ,output attr-user-can-edit
      584       ,output attr-output-display
      585       ,output attr-other
      586       ) .
      587     if not attr-user-can-edit then do:
      588       message
      589       "Атрибут нельзя удалить вручную"
      590       view-as alert-box error .
      591       return no-apply.
      592     end.
      593        do jj = 1 to num-entries(attr-other, chr(47)):
      594       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
      595         assign
      596         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
      597         .
      598       end.
      599     end.
      600     if v-check <> "":U then do:
      601       run value(v-check)(
      602                          input p-host-code
      603                         ,input p-fin-doc-code
      604                         ,input temp-hattr.code
      605                         ,input "0":U
      606                         ,input 'удаление':U
      607                         ,output v-correct
      608                         ,output v-error-code) no-error.
      609       if error-status:error then do:
      610         message
      611         "Ошибка при проверке корректности удаления атрибута" skip
      612         error-status:get-message(1) skip
      613         view-as alert-box error .
      614         undo, return no-apply .
      615       end.
      616       if not v-correct then do:
      617         message
      618         "Удаление атрибута некорректно" skip
      619         return-value
      620         view-as alert-box error .
      621         undo, return no-apply .
      622       end.
      623     end.
      624     glog = no.
      625     message
      626     "Вы уверены, что хотите удалить атрибут " temp-hattr.attr-code skip
      627     " для платежа"
      628     view-as alert-box QUESTIOn buttons YES-NO update glog.
      629     if NOT glog then return no-apply.
      630       run fd-attr-delete in this-procedure(
      631                                       input p-host-code,
      632                                       input p-fin-doc-code,
      633                                       input temp-hattr.code,
      634                                       output loc#log) no-error .
      635       if error-status:error or not loc#log then do:
      636          message "Ошибка при удалении атрибута платежа!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
      637          return no-apply.
      638       end.
      639       delete temp-hattr.
      640       updated = yes.
      641       run init-proc.
      642   END.
      643   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      644   DO:
      645     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      646     IF NOT AVAILABLE temp-hattr  THEN RETURN NO-APPLY.
      647     run ref/fincdoca.w (
      648                     INPUT parparentproc
      649                    ,INPUT '':U
      650                    ,INPUT 'one':U
      651                    ,INPUT p-host-code
      652                    ,INPUT p-fin-doc-code
      653                    ,INPUT Temp-hattr.code
      654                    ,INPUT-OUTPUT v-rid-list).
      655   END.
      656   ON CHOOSE OF b-ins IN FRAME Dialog-Frame
      657   DO:
      658   define variable attr-type as character no-undo .
      659   define variable attr-format as character no-undo .
      660   define variable attr-label as character no-undo .
      661   define variable attr-user-can-edit as logical no-undo .
      662   define variable attr-output-display as logical no-undo .
      663   define variable attr-other as char no-undo .
      664   define variable loc#log as logical no-undo.
      665   define buffer buf_temp-hattr for temp-hattr.
      666   if add-option = "" then do:
      667     run gbl/pop-up.p (self:handle, no) no-error.
      668   end.
      669   if add-option = "":U then return no-apply.
      670   run proc-add-chg in this-procedure (yes) no-error .
      671   if error-status:error then do:
      672     add-option = "":U.
      673     return no-apply.
      674   end.
      675   Run init-proc.
      676   find first buf_temp-hattr no-lock where
      677                           buf_temp-hattr.code = add-option no-error.
      678   add-option = "":U.
      679   if avail buf_temp-hattr then
      680       temp-doc-rec = recid(buf_temp-hattr).
      681       else temp-doc-rec = ?.
      682   reposition BROWSE-2 to recid temp-doc-rec no-error.
      683   if error-status:error then return no-apply.
      684   END.
      685   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      686   DO:
      687   END.
      688   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      689   on help of frame Dialog-Frame
      690   do:
      691     run gbl/app_help.p
      692       (input this-procedure :file-name
      693       ,input ''
      694       ,input ?
      695       ) no-error.
      696     if error-status :error then do:
      697       message
      698         "Ошибка при вызове помощи"
      699         error-status :get-message(1)
      700         view-as alert-box .
      701     end.
      702   end.
      703   run minbtn-set in this-procedure .
      704   on choose of b-help in frame Dialog-Frame
      705   do:
      706     apply "help":u to frame Dialog-Frame .
      707   end.
      708   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      709   procedure minbtn-set :
      710       do
      711           on error undo, return error return-value
      712           :
      713           define variable ii              as integer       no-undo .
      714           define variable fh              as widget-handle no-undo .
      715           define variable hh              as widget-handle no-undo .
      716           define variable v-h             as handle        extent 4 no-undo .
      717           define variable v-name-button   as character     no-undo .
      718           define variable v-help-old-x    as decimal       no-undo .
      719           define variable v-help-old-y    as decimal       no-undo .
      720           define variable v-help-old-size as decimal       no-undo .
      721           define variable v-frame-width   as decimal       no-undo .
      722           define variable jj              as integer       no-undo .
      723           do
      724               on error undo, return error
      725               :
      726               assign
      727                   v-frame-width = frame Dialog-Frame:width - 0.3
      728                   fh            = frame Dialog-Frame:first-child
      729                   hh            = fh:first-child
      730                   ii            = 1
      731                   .
      732               do while valid-handle(hh):
      733                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      734                   do:
      735                       case lc(hh:name) :
      736                           when "b-help" then
      737                               do:
      738                                   hh:load-image-up("cmp/b-help.bmp":u) .
      739                                   hh:load-image-down("cmp/b-help.bmp":u) .
      740                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      741                                   hh:TOOLTIP = "Помощь" .
      742                                   v-help-old-x = hh:column .
      743                                   v-help-old-y = hh:row    .
      744                                   v-help-old-size = hh:width .
      745                                   hh:width-chars = 2.5 .
      746                               end.
      747                           when "b-print" then
      748                               do:
      749                                   hh:load-image("cmp/b-print.bmp":u) .
      750                                   hh:TOOLTIP = "Печать" .
      751                                   v-h[ii] = hh:handle .
      752                                   ii = ii + 1 .
      753                                   hh:width-chars = 3 .
      754                               end.
      755                           when "b-history" or
      756                           when "b-hist" then
      757                               do:
      758                                   hh:load-image("cmp/b-hist.bmp":u) .
      759                                   hh:TOOLTIP = "История" .
      760                                   v-h[ii] = hh:handle .
      761                                   ii = ii + 1 .
      762                                   hh:width-chars = 3 .
      763                               end.
      764                           when "b-sch" then
      765                               do:
      766                                   hh:load-image("cmp/b-sch.bmp":u) .
      767                                   hh:TOOLTIP = "Установка Фильтра" .
      768                                   v-h[ii] = hh:handle .
      769                                   ii = ii + 1 .
      770                                   hh:width-chars = 3 .
      771                               end.
      772                           when "b-hist-user" then
      773                               do:
      774                                   hh:load-image("cmp/b-hist.bmp":u) .
      775                                   hh:TOOLTIP = "История пользователя" .
      776                                   ii = ii + 1 .
      777                               end.
      778                       end case.
      779                   end.
      780                   hh = hh:next-sibling.
      781               end.
      782               b-help:column = v-frame-width - b-help:width-chars.
      783               jj = 0.
      784               repeat ii = 4 to 1 by -1 :
      785                   if valid-handle (v-h[ii] ) then
      786                   do:
      787                       jj  = jj + 1 .
      788                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      789                       v-h[ii]:row    = v-help-old-y .
      790                   end.
      791               end.
      792           end.
      793       end.
      794   end procedure.
      795   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      796   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      797   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      798   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      799   define variable v-diasize-current-frame-width  as decimal   no-undo .
      800   define variable v-diasize-current-frame-height as decimal   no-undo .
      801   define variable v-diasize-change-size          as logical   no-undo .
      802   define variable v-diasize-resize-button        as handle    no-undo .
      803   define variable v-diasize-wndmax               as logical   no-undo .
      804   define variable v-diasize-wndstore             as logical   no-undo .
      805   define variable v-diasize-proc-name            as character no-undo .
      806   define variable v-diasize-browse-handle        as handle    no-undo .
      807   define variable v-diasize-browse-number        as integer   no-undo .
      808   define variable v-diasize-need-full-display    as logical   no-undo init false .
      809   define temp-table temp-diasize-handle no-undo
      810     field handle-value  as handle
      811     field save-position as decimal
      812     index xpk is primary unique handle-value
      813     .
      814   define temp-table temp-browse-handle no-undo
      815     field browse-type   as character
      816     field browse-number as integer
      817     field browse-handle as handle
      818     field original-size as decimal
      819     index xpk is primary unique browse-type browse-number
      820     index xie browse-type browse-handle
      821   .
      822   procedure diasize_change-height :
      823     define input  parameter p-change-value  as decimal   no-undo .
      824     define input  parameter p-move-resize   as logical   no-undo .
      825     define variable v-field-group-handle    as handle    no-undo .
      826     define variable v-object-handle         as handle    no-undo .
      827     define variable v-frame-height          as decimal   no-undo .
      828     define variable v-frame-virtual-height  as decimal   no-undo .
      829     define variable v-browse-height         as decimal   no-undo .
      830     define variable v-window-height         as decimal   no-undo .
      831     define variable v-window-virtual-height as decimal   no-undo .
      832     define variable v-change-sign           as integer   no-undo .
      833     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      834     define buffer buf_temp-browse-handle  for temp-browse-handle .
      835     if p-change-value > 0
      836     then do:
      837       if frame Dialog-Frame :height + p-change-value
      838           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      839       then do:
      840         assign
      841           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      842                           - (frame Dialog-Frame :height-chars)
      843         .
      844         if p-change-value <= 0
      845         then do:
      846           run diasize_position-resize-button in this-procedure .
      847           return .
      848         end.
      849       end.
      850     end.
      851     if p-change-value < 0
      852     then do:
      853       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      854       then do:
      855         assign
      856           p-change-value = v-diasize-orig-frame-height
      857                          - (frame Dialog-Frame :height-chars)
      858         .
      859         if p-change-value >= 0
      860         then do:
      861           run diasize_position-resize-button in this-procedure .
      862           return .
      863         end.
      864       end.
      865     end.
      866     if p-change-value >= 0
      867     then do:
      868       assign
      869         v-change-sign = 1
      870       .
      871     end.
      872     else do:
      873       assign
      874         v-change-sign = -1
      875       .
      876     end.
      877     assign
      878       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      879     .
      880     if p-change-value = 0
      881     then do:
      882       run diasize_position-resize-button in this-procedure .
      883       return .
      884     end.
      885     move_block:
      886     do
      887     on error undo move_block, retry move_block
      888     :
      889       if retry
      890       then do:
      891         do
      892         on error undo move_block, leave move_block
      893         :
      894           if p-change-value > 0
      895           then do:
      896             for each buf_temp-diasize-handle
      897             on error undo, next
      898             :
      899               assign
      900                 v-object-handle = buf_temp-diasize-handle.handle-value
      901               .
      902               if v-object-handle <> v-diasize-resize-button
      903               then do:
      904                 assign
      905                   v-object-handle :row = buf_temp-diasize-handle.save-position
      906                 .
      907               end.
      908             end.
      909             assign
      910               v-diasize-browse-handle :height = v-browse-height
      911             .
      912             for each buf_temp-browse-handle
      913               where buf_temp-browse-handle.browse-type = 'height':u
      914             on error undo, next
      915             :
      916               assign
      917                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      918               .
      919             end.
      920             assign
      921               frame Dialog-Frame :height = v-frame-height
      922             .
      923             if frame Dialog-Frame :scrollable = true
      924             then do:
      925               assign
      926                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      927               .
      928             end.
      929             run diasize_position-resize-button in this-procedure .
      930           end.
      931           else do:
      932             if frame Dialog-Frame :scrollable = true
      933             then do:
      934               assign
      935                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      936               .
      937             end.
      938             assign
      939               frame Dialog-Frame :height = v-frame-height
      940             .
      941             assign
      942               v-diasize-browse-handle :height = v-browse-height
      943             .
      944             for each buf_temp-browse-handle
      945               where buf_temp-browse-handle.browse-type = 'height':u
      946             on error undo, next
      947             :
      948               assign
      949                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      950               .
      951             end.
      952             for each buf_temp-diasize-handle
      953             on error undo, next
      954             :
      955               assign
      956                 v-object-handle = buf_temp-diasize-handle.handle-value
      957               .
      958               if v-object-handle <> v-diasize-resize-button
      959               then do:
      960                 assign
      961                   v-object-handle :row = buf_temp-diasize-handle.save-position
      962                 .
      963               end.
      964             end.
      965             run diasize_position-resize-button in this-procedure .
      966           end.
      967           assign
      968             v-diasize-change-size = false
      969           .
      970           leave move_block .
      971         end.
      972       end.
      973       assign
      974         v-diasize-need-full-display = true
      975       .
      976       if v-diasize-change-size = false
      977       then do:
      978         assign
      979           v-diasize-change-size = true
      980         .
      981       end.
      982       else do:
      983         return .
      984       end.
      985       assign
      986         v-frame-height = frame Dialog-Frame :height
      987         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      988         v-browse-height = v-diasize-browse-handle :height
      989       .
      990       for each buf_temp-browse-handle
      991         where buf_temp-browse-handle.browse-type = 'height':u
      992       :
      993         assign
      994           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      995         .
      996       end.
      997       for each buf_temp-diasize-handle
      998       :
      999         delete buf_temp-diasize-handle .
     1000       end.
     1001       assign
     1002         v-field-group-handle = frame Dialog-Frame :first-child
     1003       .
     1004       do while valid-handle(v-field-group-handle)
     1005       :
     1006         assign
     1007           v-object-handle = v-field-group-handle :first-child
     1008         .
     1009         do while valid-handle(v-object-handle)
     1010         :
     1011           if  v-object-handle <> v-diasize-browse-handle :handle
     1012           and can-query(v-object-handle, "row")
     1013           and can-query(v-object-handle, "height")
     1014           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1015           then do:
     1016             find first buf_temp-browse-handle
     1017               where buf_temp-browse-handle.browse-type   = 'height':u
     1018                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1019               no-error .
     1020             if available buf_temp-browse-handle
     1021             then do:
     1022             end.
     1023             else do:
     1024               create buf_temp-diasize-handle .
     1025               assign
     1026                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1027                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1028               .
     1029             end.
     1030           end.
     1031           assign
     1032             v-object-handle = v-object-handle :next-sibling
     1033           .
     1034         end.
     1035         assign
     1036           v-field-group-handle = v-field-group-handle :next-sibling
     1037         .
     1038       end.
     1039       do with frame Dialog-Frame
     1040       :
     1041         hide v-diasize-resize-button .
     1042         assign
     1043           v-diasize-resize-button :row    = 1
     1044           v-diasize-resize-button :column = 1
     1045         .
     1046       end.
     1047       if p-change-value > 0
     1048       then do:
     1049         if frame Dialog-Frame :scrollable = true
     1050         then do:
     1051           assign
     1052             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1053             no-error .
     1054           if error-status :error
     1055           or error-status :get-message(1) <> ""
     1056           then do:
     1057             undo move_block, retry move_block .
     1058           end.
     1059         end.
     1060         assign
     1061           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1062           no-error .
     1063         if error-status :error
     1064         or error-status :get-message(1) <> ""
     1065         then do:
     1066           undo move_block, retry move_block .
     1067         end.
     1068         assign
     1069           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1070           no-error .
     1071         if error-status :error
     1072         or error-status :get-message(1) <> ""
     1073         then do:
     1074           undo move_block, retry move_block .
     1075         end.
     1076         for each buf_temp-browse-handle
     1077           where buf_temp-browse-handle.browse-type = 'height':u
     1078         on error undo move_block, retry move_block
     1079         :
     1080           assign
     1081             buf_temp-browse-handle.browse-handle :height
     1082               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1083             no-error .
     1084           if error-status :error
     1085           or error-status :get-message(1) <> ""
     1086           then do:
     1087             undo move_block, retry move_block .
     1088           end.
     1089         end.
     1090         for each buf_temp-diasize-handle
     1091         on error undo move_block, retry move_block
     1092         :
     1093           assign
     1094             v-object-handle = buf_temp-diasize-handle.handle-value
     1095           .
     1096           if v-object-handle <> v-diasize-resize-button
     1097           then do:
     1098             assign
     1099               v-object-handle :row = v-object-handle :row + p-change-value
     1100               no-error .
     1101             if error-status :error
     1102             or error-status :get-message(1) <> ""
     1103             then do:
     1104               undo move_block, retry move_block .
     1105             end.
     1106           end.
     1107         end.
     1108       end.
     1109       else do:
     1110         for each buf_temp-diasize-handle
     1111         on error undo move_block, retry move_block
     1112         :
     1113           assign
     1114             v-object-handle = buf_temp-diasize-handle.handle-value
     1115           .
     1116           if v-object-handle <> v-diasize-resize-button
     1117           then do:
     1118             assign
     1119               v-object-handle :row = v-object-handle :row + p-change-value
     1120               no-error .
     1121             if error-status :error
     1122             or error-status :get-message(1) <> ""
     1123             then do:
     1124               undo move_block, retry move_block .
     1125             end.
     1126           end.
     1127         end.
     1128         assign
     1129           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1130           no-error .
     1131         if error-status :error
     1132         or error-status :get-message(1) <> ""
     1133         then do:
     1134           undo move_block, retry move_block .
     1135         end.
     1136         for each buf_temp-browse-handle
     1137           where buf_temp-browse-handle.browse-type = 'height':u
     1138         on error undo move_block, retry move_block
     1139         :
     1140           assign
     1141             buf_temp-browse-handle.browse-handle :height
     1142               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1143             no-error .
     1144           if error-status :error
     1145           or error-status :get-message(1) <> ""
     1146           then do:
     1147             undo move_block, retry move_block .
     1148           end.
     1149         end.
     1150         assign
     1151           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1152           no-error .
     1153         if error-status :error
     1154         or error-status :get-message(1) <> ""
     1155         then do:
     1156           undo move_block, retry move_block .
     1157         end.
     1158         if frame Dialog-Frame :scrollable = true
     1159         then do:
     1160           assign
     1161             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1162             no-error .
     1163           if error-status :error
     1164           or error-status :get-message(1) <> ""
     1165           then do:
     1166             undo move_block, retry move_block .
     1167           end.
     1168         end.
     1169       end.
     1170       if p-move-resize = true
     1171       then do:
     1172         run diasize_position-resize-button in this-procedure .
     1173       end.
     1174       if v-diasize-wndstore = true
     1175       then do:
     1176         if connected("ub") = true
     1177         then do:
     1178           define variable v-cntxt-db-num        as integer   no-undo .
     1179           define variable v-cntxt-userid        as character no-undo .
     1180           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1181                                             , OUTPUT v-cntxt-userid
     1182                                             ) .
     1183           run gbl/wndsizew.p
     1184             (input  v-cntxt-db-num
     1185             ,input  v-cntxt-userid
     1186             ,input  v-diasize-proc-name
     1187             ,input  'height':u
     1188             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1189             ) .
     1190         end.
     1191       end.
     1192     end.
     1193     assign
     1194       v-diasize-change-size = false
     1195     .
     1196   end procedure.
     1197   procedure diasize_set-height :
     1198     define input  parameter p-new-height  as decimal   no-undo .
     1199     define input  parameter p-move-resize as logical   no-undo .
     1200     do
     1201     on error undo, return error return-value
     1202     :
     1203       run diasize_change-height in this-procedure
     1204         (input  (p-new-height - frame Dialog-Frame :height)
     1205         ,input  p-move-resize
     1206         ) .
     1207     end.
     1208   end procedure.
     1209   procedure diasize_change-width :
     1210     define input  parameter p-change-value as decimal   no-undo .
     1211     define input  parameter p-move-resize  as logical   no-undo .
     1212     define variable v-field-group-handle   as handle    no-undo .
     1213     define variable v-object-handle        as handle    no-undo .
     1214     define variable v-frame-width          as decimal   no-undo .
     1215     define variable v-frame-virtual-width  as decimal   no-undo .
     1216     define variable v-browse-width         as decimal   no-undo .
     1217     define variable v-window-width         as decimal   no-undo .
     1218     define variable v-window-virtual-width as decimal   no-undo .
     1219     define variable v-change-sign          as integer   no-undo .
     1220     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1221     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1222     if p-change-value > 0
     1223     then do:
     1224       if frame Dialog-Frame :width + p-change-value >
     1225           session :width-chars
     1226       then do:
     1227         assign
     1228           p-change-value = session :width-chars - frame Dialog-Frame :width
     1229         .
     1230         if p-change-value <= 0
     1231         then do:
     1232           run diasize_position-resize-button in this-procedure .
     1233           return .
     1234         end.
     1235       end.
     1236     end.
     1237     if p-change-value < 0
     1238     then do:
     1239       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1240       then do:
     1241         assign
     1242           p-change-value = v-diasize-orig-frame-width
     1243                          - frame Dialog-Frame :width
     1244         .
     1245         if p-change-value >= 0
     1246         then do:
     1247           run diasize_position-resize-button in this-procedure .
     1248           return .
     1249         end.
     1250       end.
     1251     end.
     1252     if p-change-value >= 0
     1253     then do:
     1254       assign
     1255         v-change-sign = 1
     1256       .
     1257     end.
     1258     else do:
     1259       assign
     1260         v-change-sign = -1
     1261       .
     1262     end.
     1263     assign
     1264       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1265     .
     1266     if p-change-value = 0
     1267     then do:
     1268       run diasize_position-resize-button in this-procedure .
     1269       return .
     1270     end.
     1271     move_block:
     1272     do
     1273     on error undo move_block, leave move_block
     1274     :
     1275       if retry
     1276       then do:
     1277         do
     1278         on error undo move_block, leave move_block
     1279         :
     1280           if p-change-value > 0
     1281           then do:
     1282             for each buf_temp-diasize-handle
     1283             on error undo, next
     1284             :
     1285               assign
     1286                 v-object-handle = buf_temp-diasize-handle.handle-value
     1287               .
     1288               if v-object-handle <> v-diasize-resize-button
     1289               then do:
     1290                 assign
     1291                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1292                 .
     1293               end.
     1294             end.
     1295             assign
     1296               v-diasize-browse-handle :width = v-browse-width
     1297             .
     1298             for each buf_temp-browse-handle
     1299               where buf_temp-browse-handle.browse-type = 'width':u
     1300             on error undo, next
     1301             :
     1302               assign
     1303                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1304               .
     1305             end.
     1306             assign
     1307               frame Dialog-Frame :width = v-frame-width
     1308             .
     1309             if frame Dialog-Frame :scrollable = true
     1310             then do:
     1311               assign
     1312                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1313               .
     1314             end.
     1315             run diasize_position-resize-button in this-procedure .
     1316           end.
     1317           else do:
     1318             if frame Dialog-Frame :scrollable = true
     1319             then do:
     1320               assign
     1321                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1322               .
     1323             end.
     1324             assign
     1325               frame Dialog-Frame :width = v-frame-width
     1326             .
     1327             for each buf_temp-browse-handle
     1328               where buf_temp-browse-handle.browse-type = 'width':u
     1329             on error undo, next
     1330             :
     1331               assign
     1332                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1333               .
     1334             end.
     1335             assign
     1336               v-diasize-browse-handle :width = v-browse-width
     1337             .
     1338             for each buf_temp-diasize-handle
     1339             on error undo, next
     1340             :
     1341               assign
     1342                 v-object-handle = buf_temp-diasize-handle.handle-value
     1343               .
     1344               if v-object-handle <> v-diasize-resize-button
     1345               then do:
     1346                 assign
     1347                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1348                 .
     1349               end.
     1350             end.
     1351             run diasize_position-resize-button in this-procedure .
     1352           end.
     1353           assign
     1354             v-diasize-change-size = false
     1355           .
     1356           leave move_block .
     1357         end.
     1358       end.
     1359       assign
     1360         v-diasize-need-full-display = true
     1361       .
     1362       if v-diasize-change-size = false
     1363       then do:
     1364         assign
     1365           v-diasize-change-size = true
     1366         .
     1367       end.
     1368       else do:
     1369         return .
     1370       end.
     1371       assign
     1372         v-frame-width = frame Dialog-Frame :width
     1373         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1374         v-browse-width = v-diasize-browse-handle :width
     1375       .
     1376       for each buf_temp-browse-handle
     1377         where buf_temp-browse-handle.browse-type = 'width':u
     1378       :
     1379         assign
     1380           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1381         .
     1382       end.
     1383       for each buf_temp-diasize-handle
     1384       :
     1385         delete buf_temp-diasize-handle .
     1386       end.
     1387       assign
     1388         v-field-group-handle = frame Dialog-Frame :first-child
     1389       .
     1390       do while valid-handle(v-field-group-handle)
     1391       :
     1392         assign
     1393           v-object-handle = v-field-group-handle :first-child
     1394         .
     1395         do while valid-handle(v-object-handle)
     1396         :
     1397           if  v-object-handle <> v-diasize-browse-handle :handle
     1398           and v-object-handle <> v-diasize-resize-button
     1399           and can-query(v-object-handle, "row")
     1400           and can-query(v-object-handle, "height")
     1401           and ( v-object-handle :col + v-object-handle :width
     1402                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1403               )
     1404           then do:
     1405             find first buf_temp-browse-handle
     1406               where buf_temp-browse-handle.browse-type   = 'width':u
     1407                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1408               no-error .
     1409             if available buf_temp-browse-handle
     1410             then do:
     1411             end.
     1412             else do:
     1413               create buf_temp-diasize-handle .
     1414               assign
     1415                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1416                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1417               .
     1418             end.
     1419           end.
     1420           assign
     1421             v-object-handle = v-object-handle :next-sibling
     1422           .
     1423         end.
     1424         assign
     1425           v-field-group-handle = v-field-group-handle :next-sibling
     1426         .
     1427       end.
     1428       do with frame Dialog-Frame
     1429       :
     1430         hide v-diasize-resize-button .
     1431         v-diasize-resize-button :row = 1.
     1432         v-diasize-resize-button :column = 1.
     1433       end.
     1434       if p-change-value > 0
     1435       then do:
     1436         if frame Dialog-Frame :scrollable = true
     1437         then do:
     1438           assign
     1439             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1440             no-error .
     1441           if error-status :error
     1442           or error-status :get-message(1) <> ""
     1443           then do:
     1444             undo move_block, retry move_block.
     1445           end.
     1446         end.
     1447         assign
     1448           frame Dialog-Frame :width = v-frame-width + p-change-value
     1449           no-error .
     1450         if error-status :error
     1451         or error-status :get-message(1) <> ""
     1452         then do:
     1453           undo move_block, retry move_block.
     1454         end.
     1455         assign
     1456           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1457         no-error .
     1458         if error-status :error
     1459         or error-status :get-message(1) <> ""
     1460         then do:
     1461           undo move_block, retry move_block.
     1462         end.
     1463         for each buf_temp-browse-handle
     1464           where buf_temp-browse-handle.browse-type = 'width':u
     1465         on error undo move_block, retry move_block
     1466         :
     1467           assign
     1468             buf_temp-browse-handle.browse-handle :width
     1469               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1470             no-error .
     1471           if error-status :error
     1472           or error-status :get-message(1) <> ""
     1473           then do:
     1474             undo move_block, retry move_block .
     1475           end.
     1476         end.
     1477         for each buf_temp-diasize-handle
     1478         on error undo move_block, retry move_block
     1479         :
     1480           assign
     1481             v-object-handle = buf_temp-diasize-handle.handle-value
     1482           .
     1483           if v-object-handle <> v-diasize-resize-button
     1484           then do:
     1485             assign
     1486               v-object-handle :col = v-object-handle :col + p-change-value
     1487               no-error .
     1488             if error-status :error
     1489             or error-status :get-message(1) <> ""
     1490             then do:
     1491               undo move_block, retry move_block .
     1492             end.
     1493           end.
     1494         end.
     1495       end.
     1496       else do:
     1497         for each buf_temp-diasize-handle
     1498         on error undo move_block, retry move_block
     1499         :
     1500           assign
     1501             v-object-handle = buf_temp-diasize-handle.handle-value
     1502           .
     1503           if v-object-handle <> v-diasize-resize-button
     1504           then do:
     1505             assign
     1506               v-object-handle :col = v-object-handle :col + p-change-value
     1507               no-error .
     1508             if error-status :error
     1509             or error-status :get-message(1) <> ""
     1510             then do:
     1511               undo move_block, retry move_block .
     1512             end.
     1513           end.
     1514         end.
     1515         for each buf_temp-browse-handle
     1516           where buf_temp-browse-handle.browse-type = 'width':u
     1517         on error undo move_block, retry move_block
     1518         :
     1519           assign
     1520             buf_temp-browse-handle.browse-handle :width
     1521               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1522             no-error .
     1523           if error-status :error
     1524           or error-status :get-message(1) <> ""
     1525           then do:
     1526             undo move_block, retry move_block .
     1527           end.
     1528         end.
     1529         assign
     1530           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1531           no-error .
     1532         if error-status :error
     1533         or error-status :get-message(1) <> ""
     1534         then do:
     1535           undo move_block, retry move_block.
     1536         end.
     1537         assign
     1538           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1539         no-error .
     1540         if error-status :error
     1541         or error-status :get-message(1) <> ""
     1542         then do:
     1543           undo move_block, retry move_block.
     1544         end.
     1545         if frame Dialog-Frame :scrollable = true
     1546         then do:
     1547           assign
     1548             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1549           no-error .
     1550           if error-status :error
     1551           or error-status :get-message(1) <> ""
     1552           then do:
     1553             undo move_block, retry move_block.
     1554           end.
     1555         end.
     1556       end.
     1557       if p-move-resize
     1558       then do:
     1559         run diasize_position-resize-button in this-procedure .
     1560       end.
     1561       if v-diasize-wndstore = true
     1562       then do:
     1563         if connected("ub") = true
     1564         then do:
     1565           define variable v-cntxt-db-num        as integer   no-undo .
     1566           define variable v-cntxt-userid        as character no-undo .
     1567           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1568                                             , OUTPUT v-cntxt-userid
     1569                                             ) .
     1570           run gbl/wndsizew.p
     1571             (input  v-cntxt-db-num
     1572             ,input  v-cntxt-userid
     1573             ,input  v-diasize-proc-name
     1574             ,input  'width':u
     1575             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1576             ) .
     1577         end.
     1578       end.
     1579     end.
     1580     assign
     1581       v-diasize-change-size = false
     1582     .
     1583   end procedure.
     1584   procedure diasize_set-width :
     1585     define input  parameter p-new-width  as decimal   no-undo .
     1586     define input  parameter p-move-resize as logical   no-undo .
     1587     do
     1588     on error undo, return error return-value
     1589     :
     1590       run diasize_change-width in this-procedure
     1591         (input  (p-new-width - frame Dialog-Frame :width)
     1592         ,input  p-move-resize
     1593         ) .
     1594     end.
     1595   end procedure.
     1596   procedure diasize_position-resize-button :
     1597     do with frame Dialog-Frame
     1598     :
     1599       hide v-diasize-resize-button .
     1600       assign
     1601         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1602                     - 1
     1603                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1604         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1605                     - 1
     1606                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1607       .
     1608       view v-diasize-resize-button .
     1609     end.
     1610   end procedure.
     1611   on alt-right anywhere
     1612   do:
     1613     run diasize_change-width in this-procedure
     1614       (input 1
     1615       ,input true
     1616       ) .
     1617     return no-apply .
     1618   end.
     1619   on alt-left anywhere
     1620   do:
     1621     run diasize_change-width in this-procedure
     1622       (input -1
     1623       ,input true
     1624       ) .
     1625     return no-apply .
     1626   end.
     1627   on alt-down anywhere
     1628   do:
     1629     run diasize_change-height in this-procedure
     1630       (input 1
     1631       ,input true
     1632       ) .
     1633     return no-apply .
     1634   end.
     1635   on alt-up anywhere
     1636   do:
     1637     run diasize_change-height in this-procedure
     1638       (input -1
     1639       ,input true
     1640       ) .
     1641     return no-apply .
     1642   end.
     1643   on alt-enter of frame Dialog-Frame
     1644   do:
     1645     run diasize_maximize in this-procedure
     1646       (input  ?
     1647       ).
     1648     return no-apply .
     1649   end.
     1650   procedure diasize_end-move :
     1651     do
     1652     on error undo, return error return-value
     1653     :
     1654       define variable v-row-delta as decimal   no-undo .
     1655       define variable v-col-delta as decimal   no-undo .
     1656       define variable v-new-row as decimal   no-undo .
     1657       define variable v-new-col as decimal   no-undo .
     1658       assign
     1659         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1660         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1661       .
     1662       assign
     1663         v-row-delta = v-new-row - frame Dialog-Frame :height
     1664         v-col-delta = v-new-col - frame Dialog-Frame :width
     1665       .
     1666       run diasize_change-height in this-procedure
     1667         (input v-row-delta
     1668         ,input true
     1669         ) .
     1670       run diasize_change-width in this-procedure
     1671         (input v-col-delta
     1672         ,input true
     1673         ) .
     1674     end.
     1675   end procedure.
     1676   procedure diasize_maximize :
     1677     define input  parameter p-action as logical   no-undo .
     1678     do
     1679     on error undo, return error return-value
     1680     :
     1681       if p-action = ?
     1682       then do:
     1683         if v-diasize-need-maximize = true
     1684         then do:
     1685           assign
     1686             p-action = true
     1687           .
     1688         end.
     1689         else do:
     1690           assign
     1691             p-action = false
     1692           .
     1693         end.
     1694       end.
     1695       if p-action = true
     1696       then do:
     1697         run diasize_change-height in this-procedure
     1698           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1699               - frame Dialog-Frame :height-chars
     1700           ,input true
     1701           ) .
     1702         run diasize_change-width in this-procedure
     1703           (input session :width-chars
     1704               - frame Dialog-Frame :width-chars
     1705           ,input true
     1706           ) .
     1707         assign
     1708           v-diasize-need-maximize = false
     1709         .
     1710       end.
     1711       else do:
     1712         run diasize_change-width in this-procedure
     1713           (input v-diasize-orig-frame-width
     1714               - frame Dialog-Frame :width-chars
     1715           ,input true
     1716           ) .
     1717         run diasize_change-height in this-procedure
     1718           (input v-diasize-orig-frame-height
     1719               - frame Dialog-Frame :height-chars
     1720           ,input true
     1721           ) .
     1722         assign
     1723           v-diasize-need-maximize = true
     1724         .
     1725       end.
     1726     end.
     1727   end procedure.
     1728   procedure diasize_restore-orig-size :
     1729     do
     1730     on error undo, return error return-value
     1731     :
     1732       assign
     1733         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1734         v-diasize-current-frame-height = frame Dialog-Frame :height
     1735       .
     1736       run diasize_set-height in this-procedure
     1737         (input  v-diasize-orig-frame-height
     1738         ,input  true
     1739         ) .
     1740       run diasize_set-width in this-procedure
     1741         (input  v-diasize-orig-frame-width
     1742         ,input  true
     1743         ) .
     1744     end.
     1745   end procedure.
     1746   procedure diasize_restore-current-size :
     1747     do
     1748     on error undo, return error return-value
     1749     :
     1750       run diasize_set-height in this-procedure
     1751         (input  v-diasize-current-frame-height
     1752         ,input  true
     1753         ) .
     1754       run diasize_set-width in this-procedure
     1755         (input  v-diasize-current-frame-width
     1756         ,input  true
     1757         ) .
     1758     end.
     1759   end procedure.
     1760   procedure diasize_set-browse-handle :
     1761     define input  parameter p-browse-handle as handle   no-undo .
     1762     define buffer buf_temp-browse-handle for temp-browse-handle .
     1763     do
     1764     on error undo, return error return-value
     1765     :
     1766       assign
     1767         v-diasize-browse-handle = p-browse-handle
     1768       .
     1769       for each buf_temp-browse-handle
     1770       on error undo, return error return-value
     1771       :
     1772         delete buf_temp-browse-handle .
     1773       end.
     1774     end.
     1775   end procedure.
     1776   procedure diasize_add_browse :
     1777     define input  parameter p-browse-type   as character no-undo .
     1778     define input  parameter p-browse-handle as handle    no-undo .
     1779     define buffer buf_temp-browse-handle for temp-browse-handle .
     1780     do
     1781     on error undo, return error return-value
     1782     :
     1783       assign
     1784         v-diasize-browse-number = v-diasize-browse-number + 1
     1785       .
     1786       create buf_temp-browse-handle .
     1787       assign
     1788         buf_temp-browse-handle.browse-type   = p-browse-type
     1789         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1790         buf_temp-browse-handle.browse-handle = p-browse-handle
     1791       .
     1792     end.
     1793   end procedure.
     1794   procedure diasize_init :
     1795     define variable v-default-value    as logical   no-undo .
     1796     define variable v-restore-saved    as logical   no-undo .
     1797     define variable v-resize-value-str as character no-undo .
     1798     do
     1799     on error undo, return error return-value
     1800     :
     1801       do with frame Dialog-Frame
     1802       :
     1803         assign
     1804           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1805           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1806           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1807         .
     1808         create button v-diasize-resize-button
     1809         assign
     1810           parent        = frame Dialog-Frame :first-child
     1811           label         = "s"
     1812           height-pixels = 16
     1813           width-pixels  = 16
     1814           visible       = true
     1815           sensitive     = true
     1816           movable       = true
     1817           triggers:
     1818             on end-move persistent run diasize_end-move in this-procedure .
     1819           end triggers.
     1820         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1821         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1822         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1823         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1824         assign
     1825           v-diasize-wndmax = false
     1826         .
     1827         if connected("ub") = true
     1828         then do:
     1829           define variable v-cntxt-db-num        as integer   no-undo .
     1830           define variable v-cntxt-userid        as character no-undo .
     1831           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1832                                             , OUTPUT v-cntxt-userid
     1833                                             ) .
     1834           run gbl/wndpar_r.p
     1835             (input  v-cntxt-db-num
     1836             ,input  v-cntxt-userid
     1837             ,input  'wndmax':U
     1838             ,output v-diasize-wndmax
     1839             ,output v-default-value
     1840             ) .
     1841         end.
     1842         assign
     1843           v-diasize-wndstore = false
     1844         .
     1845         if connected("ub") = true
     1846         then do:
     1847           run gbl/wndpar_r.p
     1848             (input  v-cntxt-db-num
     1849             ,input  v-cntxt-userid
     1850             ,input  'wndstore':U
     1851             ,output v-diasize-wndstore
     1852             ,output v-default-value
     1853             ) .
     1854         end.
     1855         assign
     1856           v-diasize-proc-name = entry(1, program-name(2), '.')
     1857         .
     1858         if v-diasize-wndstore = true
     1859         then do:
     1860           assign
     1861             v-restore-saved = false
     1862           .
     1863           if connected("ub") = true
     1864           then do:
     1865             run gbl/wndsizer.p
     1866               (input  v-cntxt-db-num
     1867               ,input  v-cntxt-userid
     1868               ,input  v-diasize-proc-name
     1869               ,input  'height':u
     1870               ,output v-resize-value-str
     1871               ) .
     1872             if v-resize-value-str <> '':U
     1873             then do:
     1874               run diasize_change-height in this-procedure
     1875                 (input  integer(v-resize-value-str)
     1876                 ,input  true
     1877                 ) .
     1878               assign
     1879                 v-restore-saved = true
     1880               .
     1881             end.
     1882           end.
     1883           if connected("ub") = true
     1884           then do:
     1885             run gbl/wndsizer.p
     1886               (input  v-cntxt-db-num
     1887               ,input  v-cntxt-userid
     1888               ,input  v-diasize-proc-name
     1889               ,input  'width':u
     1890               ,output v-resize-value-str
     1891               ) .
     1892             if v-resize-value-str <> '':U
     1893             then do:
     1894               run diasize_change-width in this-procedure
     1895                 (input  integer(v-resize-value-str)
     1896                 ,input  true
     1897                 ) .
     1898               assign
     1899                 v-restore-saved = true
     1900               .
     1901             end.
     1902           end.
     1903           if v-restore-saved <> true
     1904           then do:
     1905             if v-diasize-wndmax = true
     1906             then do:
     1907               run diasize_maximize in this-procedure
     1908                 (input  true
     1909                 ) .
     1910             end.
     1911           end.
     1912         end.
     1913         else do:
     1914           if v-diasize-wndmax = true
     1915           then do:
     1916             run diasize_maximize in this-procedure
     1917               (input  true
     1918               ) .
     1919           end.
     1920         end.
     1921       end.
     1922     end.
     1923   end procedure.
     1924   procedure diasize_need-full-display :
     1925     define output parameter p-need-full-display as logical   no-undo .
     1926     do
     1927     on error undo, return error return-value
     1928     :
     1929       assign
     1930         p-need-full-display = v-diasize-need-full-display
     1931       .
     1932       assign
     1933         v-diasize-need-full-display = false
     1934       .
     1935     end.
     1936   end procedure.
     1937   procedure get-context :
     1938      define output parameter p-db-num as integer          no-undo.
     1939      define output parameter p-user-id as character        no-undo.
     1940      define variable v-login               as character    no-undo.
     1941      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1942      define buffer buf_user-login  for ub.user-login .
     1943      do
     1944      on error undo, return error
     1945      :
     1946            FIND FIRST buf_sys-ctrl no-lock.
     1947            ASSIGN
     1948               v-login = USERID("ub")
     1949               p-db-num = buf_sys-ctrl.db-num
     1950            .
     1951            FIND FIRST buf_user-login
     1952                 WHERE buf_user-login.db-num = p-db-num
     1953                   AND buf_user-login.user-login = v-login
     1954                 no-lock
     1955                 no-error
     1956                 .
     1957            IF AVAILABLE buf_user-login
     1958            THEN DO:
     1959               assign
     1960                  p-user-id = buf_user-login.user-id
     1961               .
     1962            END.
     1963      end.
     1964   end procedure.
     1965       run diasize_init in this-procedure .
     1966    frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE.
     1967   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1968   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1969   MAIN-BLOCK:
     1970   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1971      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1972     RUN MyEnable no-error.
     1973     if error-status:error then return error.
     1974     Run init-proc.
     1975     view frame Dialog-Frame .
     1976     WAIT-FOR GO OF FRAME Dialog-Frame.
     1977   END.
     1978   RUN disable_UI.
     1979   if updated then return 'ИЗМЕНЕНИЕ':U.
     1980   PROCEDURE disable_UI :
     1981     HIDE FRAME Dialog-Frame.
     1982   END PROCEDURE.
     1983   PROCEDURE enable_UI :
     1984     DISPLAY cd-host-code cd-fin-doc-code
     1985         WITH FRAME Dialog-Frame.
     1986     ENABLE b-quit b-ins b-chg b-del B-hist b-help cd-host-code cd-fin-doc-code
     1987         WITH FRAME Dialog-Frame.
     1988     VIEW FRAME Dialog-Frame.
     1989     OPEN QUERY BROWSE-2 FOR EACH Temp-hattr NO-LOCK.
     1990   END PROCEDURE.
     1991   PROCEDURE init-proc :
     1992   define var  attr-type as character no-undo .
     1993   define var  attr-format as character no-undo .
     1994   define var  attr-label as character no-undo .
     1995   define var  attr-value as character no-undo .
     1996   define var  attr-user-can-edit as logical no-undo .
     1997   define var  attr-output-display as logical no-undo .
     1998   define var  attr-other as char no-undo .
     1999   define buffer buf_fin-doc for ub.fin-doc.
     2000   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     2001   for each  Temp-hattr share-lock: delete Temp-hattr. end.
     2002   add-option = "".
     2003   find first buf_fin-doc where buf_fin-doc.fin-doc-code =  p-fin-doc-code
     2004                      and buf_fin-doc.host-code =  p-host-code
     2005                           no-lock no-error .
     2006   Assign
     2007       cd-host-code = buf_fin-doc.host-code
     2008       cd-fin-doc-code = buf_fin-doc.fin-doc-code
     2009       .
     2010   display cd-host-code cd-fin-doc-code   with frame Dialog-Frame  .
     2011      For each buf_fin-doc-attr where
     2012               buf_fin-doc-attr.fin-doc-code = p-fin-doc-code
     2013          and  buf_fin-doc-attr.host-code  = p-host-code
     2014               no-lock :
     2015             run fd-attr-code ( input buf_fin-doc-attr.attr-code ,
     2016                                 output attr-type ,
     2017                                 output attr-format,
     2018                                 output attr-label,
     2019                                 output attr-user-can-edit,
     2020                                 output attr-output-display,
     2021                                 output attr-other ).
     2022             if attr-output-display = true then DO:
     2023                 run fin-doc-attr-value ( input buf_fin-doc-attr.host-code,
     2024                                     input buf_fin-doc-attr.fin-doc-code,
     2025                                     input buf_fin-doc-attr.attr-code,
     2026                                     output attr-value
     2027                                     ).
     2028                 create Temp-hattr.
     2029                 assign Temp-hattr.attr-code = attr-label
     2030                        Temp-hattr.value_ = buf_fin-doc-attr.attr-value
     2031                        Temp-hattr.attr-value = (if attr-type = 'L':U
     2032                                                 then string(attr-value = "yes":U, attr-format)
     2033                                                 else attr-value)
     2034                        Temp-hattr.user-can-edit = attr-user-can-edit
     2035                        Temp-hattr.code = buf_fin-doc-attr.attr-code
     2036                       .
     2037                   End.
     2038       End.
     2039       OPEN QUERY BROWSE-2 FOR EACH Temp-hattr NO-LOCK.
     2040   END PROCEDURE.
     2041   PROCEDURE MyEnable :
     2042   define var  attr-type as character no-undo .
     2043   define var  attr-format as character no-undo .
     2044   define var  attr-label as character no-undo .
     2045   define var  attr-value as character no-undo .
     2046   define var  attr-user-can-edit as logical no-undo .
     2047   define var  attr-output-display as logical no-undo .
     2048   define var  attr-other as char no-undo .
     2049   define variable ii as integer no-undo .
     2050   define variable jj as integer no-undo .
     2051   define variable v-attr as character no-undo .
     2052   define variable v-attr-list as character no-undo .
     2053   if mode <> 'ПРОСМОТР':U then do:
     2054     do ii = 1 to num-entries('':u):
     2055       run fd-attr-code (
     2056         input  entry(ii, '':u)
     2057         ,output attr-type
     2058         ,output attr-format
     2059         ,output attr-label
     2060         ,output attr-user-can-edit
     2061         ,output attr-output-display
     2062         ,output attr-other
     2063         ) .
     2064         assign
     2065         v-attr-list = v-attr-list + (if ii = 1 then "":U else string(attr-user-can-edit))
     2066         .
     2067       end.
     2068     end.
     2069     ENABLE
     2070     b-quit
     2071     b-del when mode = 'ИЗМЕНЕНИЕ':U
     2072     b-ins when mode = 'ИЗМЕНЕНИЕ':U
     2073     b-chg when mode = 'ИЗМЕНЕНИЕ':U
     2074     b-help BROWSE-2
     2075     b-hist
     2076     WITH FRAME Dialog-Frame .
     2077     VIEW FRAME Dialog-Frame .
     2078     OPEN QUERY BROWSE-2 FOR EACH Temp-hattr NO-LOCK.
     2079     ASSIGN b-ins:MENU-MOUSE = 1.
     2080   END PROCEDURE.
     2081   PROCEDURE proc-add-chg :
     2082   define input parameter p-add as logical no-undo .
     2083   define variable attr-type as character no-undo .
     2084   define variable attr-format as character no-undo .
     2085   define variable attr-label as character no-undo .
     2086   define variable attr-user-can-edit as logical no-undo .
     2087   define variable attr-output-display as logical no-undo .
     2088   define variable attr-other as char no-undo .
     2089   define variable attr-value as character no-undo .
     2090   define variable v-attr-value as character no-undo .
     2091   define variable v-init as character no-undo .
     2092   define variable jj as integer no-undo.
     2093   DEFINE VARIABLE v-spr as character no-undo .
     2094   DEFINE VARIABLE v-setted as logical no-undo .
     2095   DEFINE VARIABLE v-deleted as logical no-undo .
     2096   define variable v-check as character no-undo .
     2097   define variable v-error-code as character no-undo .
     2098   define variable v-correct as logical no-undo .
     2099   define var loc#log as logical no-undo.
     2100   case p-add:
     2101     when yes then do:
     2102       if mode <> 'ДОБАВЛЕНИЕ':U then do:
     2103         run temp-fd-attr-exist in this-procedure(
     2104                                       input p-host-code,
     2105                                       input p-fin-doc-code,
     2106                                       input add-option,
     2107                                       output loc#log)  no-error.
     2108         if error-status:error then return error.
     2109         if loc#log then do:
     2110           message
     2111           "Данный атрибут уже существует"
     2112           view-as alert-box error .
     2113           return error.
     2114         end.
     2115       end.
     2116       run fd-attr-code in this-procedure
     2117         (input  add-option
     2118         ,output attr-type
     2119         ,output attr-format
     2120         ,output attr-label
     2121         ,output attr-user-can-edit
     2122         ,output attr-output-display
     2123         ,output attr-other
     2124         ) no-error .
     2125       if error-status :error then do:
     2126         return error .
     2127       end.
     2128       assign
     2129       added = yes.
     2130       do jj = 1 to num-entries(attr-other, chr(47)):
     2131         if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "init":U then do:
     2132           assign
     2133           v-init = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2134           .
     2135         end.
     2136       end.
     2137       if  v-init <> "":U then do:
     2138           run  value(v-init)
     2139                       in this-procedure (
     2140                                             p-host-code
     2141                                           , p-fin-doc-code
     2142                                           , output attr-value) no-error .
     2143             if error-status:error then do:
     2144                 assign
     2145                 attr-value = "":U
     2146                 .
     2147             end.
     2148       end.
     2149       CASE attr-type:
     2150         when 'L':U then do:
     2151           assign
     2152           v-attr-value = "yes":U
     2153           .
     2154         end.
     2155         when 'I':U or when 'D':U then do:
     2156           assign
     2157           v-attr-value = if v-init <> "":U
     2158                         then attr-value
     2159                         else string(0)
     2160           .
     2161         end.
     2162         when 'T':U then do:
     2163           assign
     2164           v-attr-value = ?
     2165           .
     2166         end.
     2167         when 'C':U then do:
     2168           assign
     2169           v-attr-value = if v-init <> "":U
     2170                         then attr-value
     2171                         else "":U
     2172           .
     2173         end.
     2174       END CASE.
     2175       assign
     2176       attr-value = v-attr-value
     2177       .
     2178     end.
     2179     when no then do:
     2180       run fd-attr-code in this-procedure(input TEMP-hattr.code,
     2181                                       output attr-type,
     2182                                       output attr-format,
     2183                                       output attr-label,
     2184                                       output attr-user-can-edit,
     2185                                       output attr-output-display,
     2186                                       output attr-other) no-error.
     2187       IF ERROR-STATUS:ERROR THEN DO:
     2188           message "Ошибка при определении названия и типа атрибута платежа!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2189           return error.
     2190       END.
     2191       RUN fin-doc-attr-VALUE IN THIS-PROCEDURE(
     2192                                            INPUT p-host-code,
     2193                                            INPUT p-fin-doc-code,
     2194                                            input TEMP-hattr.code,
     2195                                            OUTPUT ATTR-VALUE
     2196                                            ) NO-ERROR.
     2197       IF ERROR-STATUS:ERROR THEN DO:
     2198           message "Ошибка при определении значения атрибута платежа!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2199           return error.
     2200       END.
     2201     end.
     2202   END CASE.
     2203   IF attr-user-can-edit Then DO:
     2204     do jj = 1 to num-entries(attr-other, chr(47)):
     2205       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr":U then do:
     2206         assign
     2207         v-spr = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2208         .
     2209       end.
     2210       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
     2211         assign
     2212         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2213         .
     2214       end.
     2215     end.
     2216     if v-spr = "":U then do:
     2217     run gbl/d-prompt.w (
     2218       'title=':u + "Изменение атрибута платежа" + '\':u
     2219     + 'text1=':u + attr-label + '\':u
     2220     + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     2221     + 'type=' + attr-type + '\':u
     2222     + 'fillin_row=2\':u
     2223     + 'fillin_col=4\':u
     2224     + 'fillin_width=20\':u
     2225     + 'fillin_height=1\':u
     2226     + 'max-chars=70\':u
     2227     + 'readonly=' + (if mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u
     2228     , input-output attr-value
     2229         ).
     2230     if return-value = 'false':u then return error.
     2231     END.
     2232     ELSE DO:
     2233         run  value(v-spr)
     2234                     in this-procedure (
     2235                                          input p-host-code
     2236                                         ,input p-fin-doc-code
     2237                                         ,input-output attr-value
     2238                                         ,output v-setted) no-error .
     2239         if not v-setted then return error.
     2240     end.
     2241     if v-check <> "":U then do:
     2242       run value(v-check)(
     2243                          input p-host-code
     2244                         ,input p-fin-doc-code
     2245                         ,input (if p-add = yes then add-option else temp-hattr.attr-code)
     2246                         ,input attr-value
     2247                         ,input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     2248                         ,output v-correct
     2249                         ,output v-error-code) no-error.
     2250       if error-status:error then do:
     2251         message
     2252         "Ошибка при проверке корректности задаваемого значения атрибута" skip
     2253         error-status:get-message(1) skip
     2254         view-as alert-box error .
     2255         undo, return error .
     2256       end.
     2257       if not v-correct then do:
     2258         message
     2259         "Задаваемое значение атрибута некорректно" skip
     2260         return-value
     2261         view-as alert-box error .
     2262         undo, return error .
     2263       end.
     2264     end.
     2265     run fin-doc-attr-write in this-procedure(
     2266                                       input p-host-code,
     2267                                       input p-fin-doc-code,
     2268                                       input (if p-add then add-option else temp-hattr.code),
     2269                                       input attr-value
     2270                                      ) no-error .
     2271     IF NOT error-status:error then do:
     2272         assign
     2273         updated = yes
     2274         .
     2275     END.
     2276     else do:
     2277         message "Ошибка при изменении значения атрибута платежа!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2278     end.
     2279   End.
     2280   Else message "Изменение атрибута невозможно !" view-as alert-box error.
     2281   END PROCEDURE.
     2282   PROCEDURE temp-fd-attr-exist :
     2283     do
     2284     on error undo, return error
     2285     :
     2286       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     2287       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     2288       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
     2289       define output parameter p-exist   as logical  no-undo .
     2290       define buffer buf_temp-hattr for temp-hattr .
     2291       define variable v-type           as character no-undo .
     2292       define variable v-format         as character no-undo .
     2293       define variable v-label          as character no-undo .
     2294       define variable v-user-can-edit  as logical   no-undo .
     2295       define variable v-output-display as logical   no-undo .
     2296       define variable v-other          as character no-undo .
     2297       run fd-attr-code in this-procedure
     2298         (input  p-code
     2299         ,output v-type
     2300         ,output v-format
     2301         ,output v-label
     2302         ,output v-user-can-edit
     2303         ,output v-output-display
     2304         ,output v-other
     2305         ) no-error .
     2306       if error-status :error then do:
     2307         undo, return error return-value .
     2308       end.
     2309       find first buf_temp-hattr exclusive-lock
     2310         where buf_temp-hattr.host-code  = p-host-code
     2311           and buf_temp-hattr.fin-doc-code  = p-fin-doc-code
     2312           and buf_temp-hattr.attr-code = p-code
     2313         no-error .
     2314       if  available buf_temp-hattr then do:
     2315         p-exist = yes.
     2316       end.
     2317     end.
     2318   END PROCEDURE.
