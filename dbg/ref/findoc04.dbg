-doc.enclosure            no-undo . define input parameter p-exch-rate           like ub.fin-doc.exch-rate            no-undo . define input parameter p-exch-scale          like ub.fin-doc.exch-scale           no-undo . define input parameter p-f104                like ub.fin-doc.f104                 no-undo . define input parameter p-f105                like ub.fin-doc.f105                 no-undo . define input parameter p-f106                like ub.fin-doc.f106                 no-undo . define input parameter p-f107                like ub.fin-doc.f107                 no-undo . define input parameter p-f108                like ub.fin-doc.f108                 no-undo . define input parameter p-f109                like ub.fin-doc.f109                 no-undo . define input parameter p-f110                like ub.fin-doc.f110                 no-undo . define input parameter p-f22                 like ub.fin-doc.f22                  no-undo . define input parameter p-f23                 like ub.fin-doc.f23                  no-undo . define input parameter p-fact-date           like ub.fin-doc.fact-date            no-undo . define input parameter p-fin-doc-type        like ub.fin-doc.fin-doc-type         no-undo . define input parameter p-fin-ext-doc-type    like ub.fin-doc.fin-ext-doc-type     no-undo . define input parameter p-in-doc-code         like ub.fin-doc.in-doc-code          no-undo . define input parameter p-in-host-code        like ub.fin-doc.in-host-code         no-undo . define input parameter p-including           like ub.fin-doc.including            no-undo . define input parameter p-nazn-pl             like ub.fin-doc.nazn-pl              no-undo . define input parameter p-naznach-plat        like ub.fin-doc.naznach-plat         no-undo . define input parameter p-ocher-pl            like ub.fin-doc.ocher-pl             no-undo . define input parameter p-out-doc-code        like ub.fin-doc.out-doc-code         no-undo . define input parameter p-out-host-code       like ub.fin-doc.out-host-code        no-undo . define input parameter p-pay-date            like ub.fin-doc.pay-date             no-undo . define input parameter p-payer-bank-name     like ub.fin-doc.payer-bank-name      no-undo . define input parameter p-payer-bank-city     like ub.fin-doc.payer-bank-city      no-undo . define input parameter p-payer-bik           like ub.fin-doc.payer-bik            no-undo . define input parameter p-payer-c-schet       like ub.fin-doc.payer-c-schet        no-undo . define input parameter p-payer-code          like ub.fin-doc.payer-code           no-undo . define input parameter p-payer-code-schet    like ub.fin-doc.payer-code-schet     no-undo . define input parameter p-payer-dop1          like ub.fin-doc.payer-dop1           no-undo . define input parameter p-payer-dop2          like ub.fin-doc.payer-dop2           no-undo . define input parameter p-payer-inn           like ub.fin-doc.payer-inn            no-undo . define input parameter p-payer-kpp           like ub.fin-doc.payer-kpp            no-undo . define input parameter p-payer-name          like ub.fin-doc.payer-name           no-undo . define input parameter p-payer-okpo          like ub.fin-doc.payer-okpo           no-undo . define input parameter p-payer-passport      like ub.fin-doc.payer-passport       no-undo . define input parameter p-payer-r-schet       like ub.fin-doc.payer-r-schet        no-undo . define input parameter p-payer-type          like ub.fin-doc.payer-type           no-undo . define input parameter p-perm-date           like ub.fin-doc.perm-date            no-undo . define input parameter p-prn-doc-code        like ub.fin-doc.prn-doc-code         no-undo . define input parameter p-PS                  like ub.fin-doc.PS                   no-undo . define input parameter p-receiver-bank-name  like ub.fin-doc.receiver-bank-name   no-undo . define input parameter p-receiver-bank-city  like ub.fin-doc.receiver-bank-city   no-undo . define input parameter p-receiver-bik        like ub.fin-doc.receiver-bik         no-undo . define input parameter p-receiver-c-schet    like ub.fin-doc.receiver-c-schet     no-undo . define input parameter p-receiver-code       like ub.fin-doc.receiver-code        no-undo . define input parameter p-receiver-code-schet like ub.fin-doc.receiver-code-schet  no-undo . define input parameter p-receiver-dop1       like ub.fin-doc.receiver-dop1        no-undo . define input parameter p-receiver-dop2       like ub.fin-doc.receiver-dop2        no-undo . define input parameter p-receiver-inn        like ub.fin-doc.receiver-inn         no-undo . define input parameter p-receiver-kpp        like ub.fin-doc.receiver-kpp         no-undo . define input parameter p-receiver-name       like ub.fin-doc.receiver-name        no-undo . define input parameter p-receiver-okpo       like ub.fin-doc.receiver-okpo        no-undo . define input parameter p-receiver-passport   like ub.fin-doc.receiver-passport    no-undo . define input parameter p-receiver-r-schet    like ub.fin-doc.receiver-r-schet     no-undo . define input parameter p-receiver-type       like ub.fin-doc.receiver-type        no-undo . define input parameter p-srok-pl             like ub.fin-doc.srok-pl              no-undo . define input parameter p-stat-pl             like ub.fin-doc.stat-pl              no-undo . define input parameter p-str-podr-code       like ub.fin-doc.str-podr-code        no-undo . define input parameter p-str-podr-type       like ub.fin-doc.str-podr-type        no-undo . define input parameter p-str-podr-name       like ub.fin-doc.str-podr-name        no-undo . define input parameter p-sum-base            like ub.fin-doc.sum-base             no-undo . define input parameter p-sum-doc             like ub.fin-doc.sum-doc              no-undo . define input parameter p-sum-rubl            like ub.fin-doc.sum-rubl             no-undo . define input parameter p-sum-contr           like ub.fin-doc.sum-contr            no-undo . define input parameter p-trn-doc-code        like ub.fin-doc.trn-doc-code         no-undo . define input parameter p-vid-opl             like ub.fin-doc.vid-opl              no-undo . define input parameter p-vid-plat            like ub.fin-doc.vid-plat             no-undo .
        6   define input parameter p-con-sum-rubl        like ub.fin-doc.con-sum-rubl         no-undo . define input parameter p-con-sum-base        like ub.fin-doc.con-sum-base         no-undo . define input parameter p-con-sum-doc         like ub.fin-doc.con-sum-doc          no-undo . define input parameter p-con-sum-contr       like ub.fin-doc.con-sum-contr        no-undo . define input parameter p-con-stat            like ub.fin-doc.con-stat             no-undo . define input parameter p-payer-sign1               like ub.fin-doc.payer-sign1                no-undo . define input parameter p-payer-sign2               like ub.fin-doc.payer-sign2                no-undo . define input parameter p-payer-sign3               like ub.fin-doc.payer-sign3                no-undo . define input parameter p-payer-sign4               like ub.fin-doc.payer-sign4                no-undo . define input parameter p-receiver-sign1               like ub.fin-doc.receiver-sign1                no-undo . define input parameter p-receiver-sign2               like ub.fin-doc.receiver-sign2                no-undo . define input parameter p-receiver-sign3               like ub.fin-doc.receiver-sign3                no-undo . define input parameter p-receiver-sign4               like ub.fin-doc.receiver-sign4                no-undo . define input parameter p-obj-type                  like ub.fin-doc.obj-type                  no-undo . define input parameter p-obj-code                  like ub.fin-doc.obj-code                  no-undo . define input parameter p-doc-author                like ub.fin-doc.doc-author                no-undo . define input parameter p-fact-author               like ub.fin-doc.fact-author               no-undo . define input parameter p-cashbookid               like ub.fin-doc.CashBookId                no-undo .
        7   define input parameter p-status_ like ub.fin-doc.status_ no-undo .
        8   define input parameter p-status-date like ub.fin-doc.doc-date no-undo .
        9   define output parameter p-correct as logical no-undo .
       10   define output parameter p-err-mess as character no-undo .
       11   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   def var vss-author      as character no-undo init "$Author: expertek $":U .
       13   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   def var vss-workfile    as character no-undo init "$Workfile: findoc04.p $":U .
       15   def var vss-archive     as character no-undo init "$Archive: ref/findoc04.p $":U .
       16   def var vss-description as character no-undo init "Проверка платежа типа expense-cashless".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define variable v-is-an-uchet as logical no-undo .
       79   define variable v-dopi as integer no-undo .
       80   define variable v-reason as character no-undo .
       81   define variable v-author as character no-undo .
       82   define buffer buf_fin-code-cor-acc for ub.fin-code-cor-acc.
       83   define buffer buf_fin-doc for ub.fin-doc.
       84   define buffer buf_sysconf for ub.sysconf.
       85   define buffer buf_fin-connect for ub.fin-connect.
       86   FUNCTION check-f107 RETURNS LOGICAL(input  p-f107 as character,
       87                                       output p-reason as character):
       88   define variable v-dopi as integer no-undo .
       89   define variable v-dopdate as date no-undo .
       90   if length(p-f107) <> 10 then do:
       91     assign
       92     p-reason = "длина должна быть 10 знаков"
       93     .
       94     return no.
       95   end.
       96   if substr(p-f107, 3, 1) <> ".":U
       97   or substr(p-f107, 6, 1) <> ".":U then do:
       98     assign
       99     p-reason = "3-й и 6-й знаки должны быть точками".
      100     .
      101     return no.
      102   end.
      103   assign
      104   v-dopi = integer(substr(p-f107, 1, 2))
      105   no-error .
      106   if not error-status:error then do:
      107     assign
      108     v-dopdate = date(
      109                      integer(substr(p-f107, 4, 2))
      110                     , integer(substr(p-f107, 1, 2))
      111                     , integer(substr(p-f107, 7, 4))
      112                    )
      113     no-error .
      114     if error-status:error then do:
      115       assign
      116       p-reason = "не соответствует никакой дате"
      117       .
      118       return no.
      119     end.
      120   end.
      121   if LOOKUP(substr(p-f107, 1, 2), "Д1,Д2,Д3,МС,КВ,ПЛ,ГД":U) = 0 then do:
      122     assign
      123     p-reason = substitute("первые два знака должно быть одни из &1", "Д1,Д2,Д3,МС,КВ,ПЛ,ГД":U).
      124     .
      125     return no.
      126   end.
      127   assign
      128   v-dopi = integer(substr(p-f107, 4, 2))
      129   no-error .
      130   CASE substr(p-f107, 1, 2):
      131     when "Д1":U
      132     or
      133     when "Д2":U
      134     or
      135     when "Д3":U
      136     or
      137     when "МС":U then do:
      138       if error-status:error
      139       or v-dopi < 1
      140       or v-dopi > 12 then do:
      141         assign
      142         p-reason = "4 и 5 знак должны быть равны номеру месяца -от 01 до 12".
      143         .
      144         return no.
      145       end.
      146     end.
      147     when "КВ":U then do:
      148       if error-status:error
      149       or v-dopi < 1
      150       or v-dopi > 4 then do:
      151         assign
      152         p-reason = "4 и 5 знак должны быть равны номеру квартала -от 01 до 04".
      153         .
      154         return no.
      155       end.
      156     end.
      157     when "ПЛ":U then do:
      158       if error-status:error
      159       or v-dopi < 1
      160       or v-dopi > 2 then do:
      161         assign
      162         p-reason = "4 и 5 знак должны быть равны номеру полугодия -от 01 до 02".
      163         .
      164         return no.
      165       end.
      166     end.
      167     when "ГД":U then do:
      168       if error-status:error
      169       or v-dopi <> 0 then do:
      170         assign
      171         p-reason = "4 и 5 знак должны быть равны 00".
      172         .
      173         return no.
      174       end.
      175     end.
      176   END CASE.
      177   assign
      178   p-reason = "":U.
      179   RETURN yes.
      180   END FUNCTION.
      181   FUNCTION check-f109 RETURNS LOGICAL(input  p-f109 as character,
      182                                       output p-reason as character):
      183   define variable v-dopdate as date no-undo .
      184   if length(p-f109) <> 10 then do:
      185     assign
      186     p-reason = "длина должна быть 10 знаков"
      187     .
      188     return no.
      189   end.
      190   if substr(p-f109, 3, 1) <> ".":U
      191   or substr(p-f109, 6, 1) <> ".":U then do:
      192     assign
      193     p-reason = "3-й и 6-й знаки должны быть точками".
      194     .
      195     return no.
      196   end.
      197   assign
      198   v-dopdate = date(
      199                     integer(substr(p-f109, 4, 2))
      200                   , integer(substr(p-f109, 1, 2))
      201                   , integer(substr(p-f109, 7, 4))
      202                   )
      203   no-error .
      204   if error-status:error then do:
      205     assign
      206     p-reason = "не соответствует никакой дате"
      207     .
      208     return no.
      209   end.
      210   assign
      211   p-reason = "":U.
      212   RETURN yes.
      213   END FUNCTION.
      214   procedure income-expense-gen :
      215   define input parameter p-close-mode as character no-undo .
      216   define output parameter p-correct as logical no-undo .
      217   define buffer buf_firm for ub.firm.
      218   define buffer buf_person for ub.person.
      219   do
      220   on error undo, return error
      221   :
      222     find first buf_sysconf no-lock where
      223               buf_sysconf.host-code = p-host-code .
      224     if p-status_ = 'разрешен':U
      225     or v-author = 'cl-bank':U
      226     then do:
      227       if p-naznach-plat = "":U then do:
      228         assign
      229         p-err-mess = "Не заполнено основание платежа"
      230         .
      231         return "naznach-plat":u.
      232       end.
      233       if p-vid-opl <> '01':U then do:
      234         assign
      235         p-err-mess = "Неверное значение поля <Вид оп.>"
      236         .
      237         return "vid-opl":u.
      238       end.
      239     end.
      240     if p-status_ = 'факт':U then do:
      241       find first buf_fin-connect no-lock where
      242               buf_fin-connect.host-code      = p-host-code
      243           AND buf_fin-connect.fin-doc-code   = p-fin-doc-code no-error.
      244       if not available buf_fin-connect then do:
      245         if buf_sysconf.fin-calc = 1
      246         and p-obj-type = "":U and p-obj-code = 0
      247         then do:
      248           p-err-mess = substitute("Финансовый учет на фирме ведется пообъектно, а объект не задан")
      249           .
      250           return error "obj-code":U.
      251         end.
      252       end.
      253       if p-prn-doc-code = "":U then do:
      254         assign
      255         p-err-mess = "Не заполнен номер платежа"
      256         .
      257         return "prn-doc-code":U.
      258       end.
      259     end.
      260     if p-status_ = 'факт':U then do:
      261       if buf_sysconf.is-corr-acc
      262       and (p-cor-acc = ? or p-cor-acc = 0) then do:
      263         assign
      264         p-err-mess = "Не заполнен корр. счет/субсчет"
      265         .
      266         return "cor-acc":U.
      267       end.
      268       if buf_sysconf.is-code-cel-nazn
      269       and (p-cel-nazn-code = ? or p-cel-nazn-code = 0) then do:
      270         assign
      271         p-err-mess = "Не заполнен код целевого назначения"
      272         .
      273         return "cel-nazn-code":U.
      274       end.
      275       if buf_sysconf.is-an-uchet
      276       and (p-an-uchet-code = ? or p-an-uchet-code = 0) then do:
      277         assign
      278         p-err-mess = "Не заполнен код аналитического учета"
      279         .
      280         return  "an-uchet-code":U.
      281       end.
      282     end.
      283     if LOOKUP(p-vid-plat , 'почтой,телеграфом,электронно,':U) = 0 then do:
      284       assign
      285       p-err-mess = "Неверный тип платежа -должен быть один из" + chr(32) + 'почтой,телеграфом,электронно,':U
      286       .
      287       return "vid-plat":U.
      288     end.
      289     if p-status_ = 'разрешен':U
      290     or v-author = 'cl-bank':U
      291     then do:
      292       if p-payer-inn = "":U then do:
      293         assign
      294         p-err-mess = "Не заполнен ИНН ПЛАТЕЛЬЩИКА"
      295         .
      296         return "payer-inn":U.
      297       end.
      298       if p-payer-kpp = "":U
      299       then do:
      300         CASE p-payer-type:
      301           when 'орг':U then do:
      302             find first buf_firm no-lock where
      303                       buf_firm.firm-code = p-payer-code .
      304           end.
      305           when 'чел':U then do:
      306             find first buf_person no-lock where
      307                       buf_person.psn-code = p-payer-code .
      308           end.
      309         END CASE.
      310       end.
      311       if p-payer-bik = "":U then do:
      312         assign
      313         p-err-mess = "Не заполнен БИК ПЛАТЕЛЬЩИКА"
      314         .
      315             message p-err-mess skip
      316                 "Закрывать документ ? "
      317                 view-as alert-box question
      318                 buttons yes-no
      319                 title "ВНИМАНИЕ !!!"
      320                 update v-ok3 as logical.
      321             if not v-ok3 then do:
      322                return "payer-bik":U.
      323             end.
      324       end.
      325       if p-payer-r-schet = "":U then do:
      326         assign
      327         p-err-mess = "Не заполнен р/с ПЛАТЕЛЬЩИКА"
      328         .
      329         return "payer-r-schet":U.
      330       end.
      331       if p-payer-bank-name = "":U then do:
      332         assign
      333         p-err-mess = "Не заполнен банк ПЛАТЕЛЬЩИКА"
      334         .
      335         return "payer-bank-name":U.
      336       end.
      337       if p-payer-c-schet = "":U then do:
      338         if not (
      339                 (substring(p-payer-bik, 7, 9) = '000'
      340                 or
      341                 substring(p-payer-bik, 7, 9) = '001'
      342                 or
      343                 substring(p-payer-bik, 7, 9) = '002'
      344                 )
      345                 and not
      346                 ( "руб" = "тг."
      347                   or "руб" = "грн"
      348                   or "руб" = "дрм"
      349                   or "руб" = "lei")
      350                )
      351         then do:
      352           assign
      353           p-err-mess = "Не заполнен к/с ПЛАТЕЛЬЩИКА"
      354           .
      355           define variable v-nocoracc as character no-undo .
      356           define variable v-conf-type as character no-undo .
      357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      358     (input  'nocoracc'
      359     ,input  0
      360     ,input  '':U
      361     ,input  0
      362     ,input  '':U
      363     ,input  '':U
      364     ,input  '':U
      365     ,input  NO
      366     ,output v-nocoracc
      367     ,output v-conf-type
      368     ) NO-ERROR .
      369           IF ERROR-STATUS:ERROR OR v-conf-type <> 'L':U THEN v-nocoracc = "no".
      370           if v-nocoracc = "no" then   return "payer-c-schet":U.
      371         end.
      372       end.
      373       if p-receiver-inn = "":U then do:
      374         assign
      375         p-err-mess = "Не заполнен ИНН ПОЛУЧАТЕЛЯ"
      376         .
      377         return "receiver-inn":U.
      378       end.
      379       if p-receiver-kpp = "":U then do:
      380         CASE p-receiver-type:
      381           when 'орг':U then do:
      382             find first buf_firm no-lock where
      383                       buf_firm.firm-code = p-receiver-code .
      384           end.
      385           when 'чел':U then do:
      386             find first buf_person no-lock where
      387                       buf_person.psn-code = p-receiver-code .
      388           end.
      389         END CASE.
      390       end.
      391       if p-receiver-bik = "":U then do:
      392         assign
      393         p-err-mess = "Не заполнен БИК ПОЛУЧАТЕЛЯ"
      394         .
      395             message p-err-mess skip
      396                 "Закрывать документ ? "
      397                 view-as alert-box question
      398                 buttons yes-no
      399                 title "ВНИМАНИЕ !!!"
      400                 update v-ok4 as logical.
      401             if not v-ok4 then do:
      402                return "receiver-bik":U.
      403             end.
      404       end.
      405       if p-receiver-r-schet = "":U then do:
      406         assign
      407         p-err-mess = "Не заполнен р/с ПОЛУЧАТЕЛЯ"
      408         .
      409         return "receiver-r-schet":U.
      410       end.
      411       if p-receiver-bank-name = "":U then do:
      412         assign
      413         p-err-mess = "Не заполнен банк ПОЛУЧАТЕЛЯ"
      414         .
      415         return "receiver-bank-name":U.
      416       end.
      417       if p-receiver-c-schet = "":U then do:
      418         if not (
      419                (substring(p-receiver-bik, 7, 9) = '000'
      420                 or
      421                 substring(p-receiver-bik, 7, 9) = '001'
      422                 or
      423                 substring(p-receiver-bik, 7, 9) = '002'
      424                 )
      425                 and not
      426                 ( "руб" = "тг."
      427                   or "руб" = "грн"
      428                   or "руб" = "дрм"
      429                   or "руб" = "lei")
      430                )
      431          then do:
      432           assign
      433           p-err-mess = "Не заполнен к/с ПОЛУЧАТЕЛЯ"
      434           .
      435   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      436     (input  'nocoracc'
      437     ,input  0
      438     ,input  '':U
      439     ,input  0
      440     ,input  '':U
      441     ,input  '':U
      442     ,input  '':U
      443     ,input  NO
      444     ,output v-nocoracc
      445     ,output v-conf-type
      446     ) NO-ERROR .
      447           IF ERROR-STATUS:ERROR OR v-conf-type <> 'L':U THEN v-nocoracc = "no".
      448           if v-nocoracc = "no" then   return "payer-c-schet":U.
      449         end.
      450       end.
      451       assign
      452       v-dopi =  integer(p-ocher-pl)
      453       no-error .
      454       if error-status:error
      455       or v-dopi < 1 or v-dopi > 6 then do:
      456         assign
      457         p-err-mess = "Неверно заполнено поле очередность платежа"
      458         .
      459         return "ocher-pl":U.
      460       end.
      461       if p-stat-pl <> "":U then do:
      462         if lookup(p-stat-pl, '01,02,03,04,05,06,07,08':U) = 0 then do:
      463           assign
      464           p-err-mess = "Неверно заполнено поле статус плательщика"
      465           .
      466           return "stat-pl":U.
      467         end.
      468         if p-f104 = "":U then do:
      469           assign
      470           p-err-mess = "Не заполнено поле показателя Кода Бюджетной Классификации"
      471           .
      472           return "f-104":U.
      473         end.
      474         if p-f105 = "":U then do:
      475           assign
      476           p-err-mess = "Не заполнено поле кода ОКАТО"
      477           .
      478           return "f-105":U.
      479         end.
      480         if p-f106 = "":U
      481         or lookup(p-f106, 'ТП,ЗД,ТР,РС,ОТ,РТ,ВУ,ПР,АП,АР,0':U) = 0
      482         then do:
      483           assign
      484           p-err-mess = "Не заполнено или неверно заполнено поле показателя основания платежа"
      485           .
      486           return "f-106":U.
      487         end.
      488         if p-f107 = "":U
      489         or check-f107(p-f107, output v-reason) = no
      490         then do:
      491           assign
      492           p-err-mess = substitute("Не заполнено или неверно заполнено поле показателя налового периода: &1", v-reason)
      493           .
      494           return "f-107":U.
      495         end.
      496         if (p-f106 = "ТП":U
      497         or p-f106 = "ЗД":U )
      498         and p-f108 <> "0":U then do:
      499           assign
      500           p-err-mess = substitute("Неверно заполнено поле показателя номера документа: если показатель основания платежа = &1, то там должно стоять <0>", p-f106)
      501           .
      502           return "f-108":U.
      503         end.
      504         if p-f109 = "":U
      505         or check-f109(p-f109, output v-reason) = no
      506         then do:
      507           assign
      508           p-err-mess = substitute("Не заполнено или неверно заполнено поле показателя даты документа: &1", v-reason)
      509           .
      510           return "f-109":U.
      511         end.
      512         if p-f110 = "":U
      513         or lookup(p-f110, 'НС,АВ,ПЕ,ПЦ,СА,АШ,ИШ,0':U) = 0
      514         then do:
      515           assign
      516           p-err-mess = "Не заполнено или неверно заполнено поле показателя типа платежа"
      517           .
      518           return "f-110":U.
      519         end.
      520       end.
      521     end.
      522     if p-close-mode = '<закрытие документа>':U
      523     or p-close-mode = '<отказ от документа>':U
      524     then do:
      525       if (p-perm-date <> ? and p-doc-date > p-perm-date )
      526       or (p-status-date <> ? and p-doc-date > p-status-date and p-status_ = 'разрешен':U)
      527       then do:
      528         assign
      529         p-err-mess = "Дата разр не может быть меньше даты док"
      530         .
      531         return "perm-date":U.
      532       end.
      533       if (p-pay-date <> ? and p-perm-date > p-pay-date)
      534       or (p-status-date <> ? and p-perm-date > p-status-date and p-status_ = 'банк':U )  then do:
      535         assign
      536         p-err-mess = "Дата оплаты не может быть меньше даты разр"
      537         .
      538         return "pay-date":U.
      539       end.
      540       if (p-fact-date <> ? and p-pay-date > p-fact-date)
      541       or (p-status-date <> ? and p-pay-date > p-status-date and (p-status_ = 'факт':U or p-status_ = 'отказ':U))
      542         then do:
      543         assign
      544         p-err-mess = "Дата факт (или дата отказ) не может быть меньше даты платежа".
      545         return "fact-date":U.
      546       end.
      547     end.
      548     assign
      549     p-correct = yes
      550     .
      551   end.
      552   end procedure.
      553   do
      554   on error undo, return error
      555   :
      556     assign
      557     v-author = (if num-entries(p-mode, chr(4)) > 1
      558               then entry(2, p-mode, chr(4))
      559               else '':U)
      560     p-mode = entry(1, p-mode, chr(4))
      561     .
      562     run income-expense-gen in this-procedure(input p-close-mode, output p-correct) no-error .
      563     if error-status:error then do:
      564       return "Ошибка в процедуре проверки валидности платежа".
      565     end.
      566     else do:
      567       if p-correct = no then return return-value.
      568     end.
      569     assign
      570     p-correct = yes
      571     .
      572   end.
