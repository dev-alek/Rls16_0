     1180   procedure prn-lib-prn-file :
     1181     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1182     define input parameter p-DIsabledoptions as integer no-undo .
     1183     define variable v-report-name as character no-undo .
     1184     define variable v-user-action as character no-undo .
     1185     define variable v-printed     as logical   no-undo .
     1186     define variable v-exist       as logical   no-undo .
     1187     do
     1188       on error undo, return error
     1189       :
     1190       run prn-lib-get-report-name  in this-procedure (
     1191         input parParentProc
     1192         ,output v-report-name
     1193         ).
     1194   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1195   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1196     (input  v-report-name
     1197     ,input  2
     1198     ,output v-exist
     1199     )  .
     1200       if NOT v-exist then
     1201       DO:
     1202         Message
     1203           "Нет заданий на печать ! "
     1204           view-as alert-box .
     1205         Return  .
     1206       End.
     1207       run gbl/prnfilen.w
     1208         (input  ""
     1209         ,input  p-DisabledOptions
     1210         ,input  string(v-report-name )
     1211         ,input  7
     1212         ,output v-user-action
     1213         ,output v-printed
     1214         ) .
     1215       if v-printed then
     1216       do:
     1217         return "YES" .
     1218       end.
     1219       else
     1220       do:
     1221         return "NO" .
     1222       end.
     1223     end.
     1224   end procedure.
     1225   procedure prn-lib-open-stream :
     1226     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1227     define input parameter p-page-size    as integer no-undo .
     1228     define input parameter p-is-stream    as logical no-undo .
     1229     define input parameter p-append       as logical no-undo .
     1230     define variable v-report-name as character no-undo .
     1231     do
     1232       on error undo, return error
     1233       :
     1234       run prn-lib-get-report-name  in this-procedure (
     1235         input parParentProc
     1236         ,output v-report-name
     1237         ).
     1238       if p-is-stream then
     1239       do:
     1240         if p-append then
     1241         do:
     1242           output stream PrnLibStream to value( v-report-name )
     1243             page-size value(p-page-size) append .
     1244         end.
     1245         if not p-append then
     1246         do:
     1247           output stream PrnLibStream to value( v-report-name )
     1248             page-size value(p-page-size) .
     1249         end.
     1250       end.
     1251       if not p-is-stream then
     1252       do:
     1253         if p-append then
     1254         do:
     1255           output to value( v-report-name )
     1256             page-size value(p-page-size) append .
     1257         end.
     1258         if not p-append then
     1259         do:
     1260           output to value( v-report-name )
     1261             page-size value(p-page-size) .
     1262         end.
     1263       end.
     1264     end.
     1265   end procedure.
     1266   procedure prn-lib-open-exp :
     1267     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1268     define input parameter p-is-stream    as logical no-undo .
     1269     define input parameter p-is-append    as logical no-undo .
     1270     define output parameter p-ReportFileName as char init "report" no-undo.
     1271     define output parameter p-process as logical no-undo .
     1272     define variable glog as logical no-undo .
     1273     do
     1274       on error undo, return error
     1275       :
     1276       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1277         TITLE      "Укажите путь"
     1278         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1279         ASK-OVERWRITE
     1280         CREATE-TEST-FILE
     1281         SAVE-AS
     1282         USE-FILENAME
     1283         DEFAULT-EXTENSION "txt"
     1284         UPDATE glog
     1285         .
     1286       if not glog then  return.
     1287       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1288       if p-is-stream then
     1289       do:
     1290         if p-is-append then
     1291         do:
     1292           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1293         end.
     1294         else
     1295         do:
     1296           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1297         end.
     1298       end.
     1299       else
     1300       do:
     1301         if p-is-append then
     1302         do:
     1303           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1304         end.
     1305         else
     1306         do:
     1307           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1308         end.
     1309       end.
     1310       p-process = yes.
     1311     end.
     1312   end procedure.
     1313   procedure prn-lib-get-report-name :
     1314     define input parameter parParentProc  as widget-handle no-undo.
     1315     define output parameter p-report-name as character no-undo .
     1316     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1317   end procedure.
     1318   procedure prn-lib-reportviewer-report-name :
     1319     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1320     define input parameter p-report-name-html as character no-undo .
     1321     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1322   end procedure.
     1323   procedure prn-lib-reportviewer :
     1324     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1325     define input parameter p-report-name-html as character no-undo .
     1326     define input parameter p-param        as character no-undo .
     1327     define variable v-excel           as character no-undo init 'TRUE' .
     1328     define variable v-value-character as character no-undo .
     1329     define variable v-value-integer   as character no-undo .
     1330     define variable v-value-date      as date      no-undo .
     1331     define variable v-value-decimal   as decimal   no-undo .
     1332     define variable rep-excel         as logical   no-undo .
     1333     define variable excel-string      as character no-undo .
     1334     define variable v-param-type      as character no-undo .
     1335     define variable v-tth             as handle    no-undo .
     1336     run adm/shattri.p (
     1337       input "get":U
     1338       ,input  ""
     1339       ,input  0
     1340       ,input  'report-glob':U
     1341       ,input  'rep-excel':U
     1342       ,output v-value-character
     1343       ,output v-value-date
     1344       ,output v-value-decimal
     1345       ,output v-value-integer
     1346       ,output rep-excel
     1347       ,output v-param-type
     1348       ,INPUT-OUTPUT table-handle v-tth
     1349       )  .
     1350     if rep-excel then v-excel = "TRUE" .
     1351     else v-excel = "FALSE" .
     1352     if p-param eq ""
     1353     then
     1354        p-param = "EXCEL:" + v-excel.
     1355     else
     1356        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1357     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1358   end procedure.
     1359   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1360   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1361   procedure fltopend_fltopend :
     1362   define input parameter p-parent-handle as handle no-undo .
     1363   define input parameter p-qh as handle no-undo .
     1364   define input parameter p-flt-open-open-query  as character no-undo .
     1365   define input parameter p-where-cond as character no-undo .
     1366   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1367   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1368   define input parameter p-indexed-reposition as character no-undo .
     1369     do
     1370     on error undo, return error
     1371     :
     1372   define variable v-prepare-string as character no-undo .
     1373   define variable glog as logical no-undo .
     1374   assign
     1375   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1376                      p-where-cond + chr(32)  +
     1377                      p-use-indFIRST-query-tail + chr(32) +
     1378                      p-use-ind-sort-clmn-by + chr(32) +
     1379                      p-indexed-reposition
     1380   .
     1381   assign
     1382   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1383   if not glog
     1384   or error-status:error then do:
     1385     message error-status:get-message(1) view-as alert-box .
     1386     undo, return error .
     1387   end.
     1388   assign
     1389   glog = p-qh:query-open no-error .
     1390   if not glog
     1391   or error-status:error then do:
     1392     message error-status:get-message(1) view-as alert-box .
     1393     undo, return error .
     1394   end.
     1395     end.
     1396   end procedure.
     1397   procedure fltopend_fltfindd :
     1398   define input parameter p-parent-handle as handle no-undo .
     1399   define input parameter p-qh as handle no-undo .
     1400   define input parameter p-rowid as rowid no-undo .
     1401   define input parameter p-next as logical no-undo .
     1402   define input parameter p-lock as integer no-undo .
     1403   define input parameter p-bh as handle no-undo .
     1404   define input parameter p-where-cond as character no-undo .
     1405   define input parameter p-use-index-phrase as character no-undo .
     1406   define variable glog as logical no-undo .
     1407   define variable v-qh as handle no-undo .
     1408   define variable v-bh as handle no-undo .
     1409   define variable v-recid as recid no-undo .
     1410   define variable v-prepare-string as character no-undo .
     1411   do
     1412   on error undo, return error
     1413   on stop undo, return error
     1414   :
     1415     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1416     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1417     create query v-qh.
     1418     v-qh:set-buffers(v-bh).
     1419     v-prepare-string = substitute("for each &1 &2 &3"
     1420                                     ,v-bh:name
     1421                                     ,p-where-cond
     1422                                     ,p-use-index-phrase).
     1423     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1424     if not glog then do:
     1425       delete object v-qh.
     1426       delete object v-bh.
     1427       undo, return error .
     1428     end.
     1429     glog = v-qh:query-open no-error .
     1430     if not glog then do:
     1431       delete object v-qh.
     1432       delete object v-bh.
     1433       undo, return error .
     1434     end.
     1435     if p-next then do:
     1436       v-qh:reposition-to-rowid(p-rowid) no-error .
     1437       glog = v-qh:get-next( p-lock) no-error .
     1438       glog = v-qh:get-next( p-lock) no-error .
     1439       if not glog or v-qh:query-off-end = yes then do:
     1440         glog = v-qh:get-first( p-lock) no-error .
     1441       end.
     1442     end.
     1443     else do:
     1444       glog = v-qh:get-first( p-lock) no-error .
     1445     end.
     1446     v-recid = v-bh:recid no-error .
     1447     delete object v-qh.
     1448     delete object v-bh.
     1449     return string(v-recid) .
     1450   end.
     1451   end procedure.
     1452   procedure fltopend_fltfindq :
     1453   define input parameter p-parent-handle as handle no-undo .
     1454   define input parameter p-qh as handle no-undo .
     1455   define input parameter p-next as logical no-undo .
     1456   define input parameter p-lock as integer no-undo .
     1457   define input parameter p-flt-open-open-query  as character no-undo .
     1458   define input parameter p-where-cond as character no-undo .
     1459   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1460   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1461   define input parameter p-indexed-reposition as character no-undo .
     1462   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1463   define variable glog as logical no-undo .
     1464   define variable v-qh as handle no-undo .
     1465   define variable v-bh as handle no-undo extent 18.
     1466   define variable v-rowid as rowid no-undo extent 18.
     1467   define variable v-ii as integer no-undo .
     1468   define variable v-prepare-string as character no-undo .
     1469   do
     1470   on error undo, return error
     1471   on stop undo, return error
     1472   :
     1473     create query v-qh.
     1474     do v-ii = 1 to p-qh:num-buffers:
     1475       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1476       assign
     1477       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1478       no-error.
     1479       v-qh:add-buffer(v-bh[v-ii]).
     1480     end.
     1481     assign
     1482     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1483                       p-where-cond + chr(32)  +
     1484                       p-use-indFIRST-query-tail + chr(32) +
     1485                       p-use-ind-sort-clmn-by + chr(32) +
     1486                       p-indexed-reposition
     1487     .
     1488     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1489     if not glog then do:
     1490       delete object v-qh.
     1491       do v-ii = 1 to p-qh:num-buffers:
     1492         delete object v-bh[v-ii].
     1493       end.
     1494       undo, return error .
     1495     end.
     1496     glog = v-qh:query-open no-error .
     1497     if not glog then do:
     1498       delete object v-qh.
     1499       do v-ii = 1 to p-qh:num-buffers:
     1500         delete object v-bh[v-ii].
     1501       end.
     1502       undo, return error .
     1503     end.
     1504     if p-next then do:
     1505       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1506       glog = v-qh:get-next( p-lock) no-error .
     1507       glog = v-qh:get-next( p-lock) no-error .
     1508       if not glog or v-qh:query-off-end = yes then do:
     1509         glog = v-qh:get-first( p-lock) no-error .
     1510       end.
     1511     end.
     1512     else do:
     1513       glog = v-qh:get-first( p-lock) no-error .
     1514     end.
     1515     do v-ii = 1 to p-qh:num-buffers:
     1516       assign
     1517       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1518       no-error.
     1519     end.
     1520     delete object v-qh.
     1521     do v-ii = 1 to p-qh:num-buffers:
     1522       delete object v-bh[v-ii].
     1523     end.
     1524   end.
     1525   end procedure.
     1526   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1527   define variable sort-column-name as character no-undo.
     1528   define shared variable loc-art  as character no-undo.
     1529   define variable filter-point     as character NO-UNDO INIT "esysclis".
     1530   define variable filter-label     as character NO-UNDO INIT "Коды объектов внешней системы".
     1531   define variable filter-point0     as character NO-UNDO INIT "esysclis".
     1532   define variable filter-label0     as character NO-UNDO INIT "Коды объектов внешней системы".
     1533   define variable esys-name               as character no-undo.
     1534   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1535   define variable prid                    as recid.
     1536   function get-gds-name returns character
     1537    ( p-gds-code as integer,
     1538      p-attr-code as integer ) forward.
     1539   FUNCTION get-esys-name RETURNS CHARACTER
     1540   ( INPUT p-esys-id AS INTEGER ) :
     1541           DEFINE BUFFER buf_ext-system FOR ub.ext-system.
     1542           FIND FIRST buf_ext-system NO-LOCK WHERE
     1543                             buf_Ext-system.db-num = 0
     1544                     AND buf_Ext-system.esys-id = p-esys-id NO-ERROR.
     1545           IF AVAILABLE buf_ext-system THEN DO:
     1546              RETURN buf_ext-system.esys-name.
     1547           END.
     1548           RETURN "!!Неизвестная внешняя система".
     1549   END FUNCTION.
     1550   define query br-esys-gds-query for ext-classif.
     1551   define browse br-esys-gds query br-esys-gds-query
     1552   disp
     1553   mark-string(recid(ext-classif), v-rid-list) COLUMN-LABEL "" FORMAT "X(1)"
     1554   ext-classif.KEY#_two  COLUMN-LABEL "Код!внешней!системы" FORMAT ">>>>>>>>9"
     1555   get-esys-name (ext-classif.KEY#_two) @ esys-name COLUMN-LABEL "Внешняя система" FORMAT "X(30)"
     1556   ext-classif.charkey_one  COLUMN-LABEL "Код товара!во внешней!системе" FORMAT "X(20)"
     1557   ext-classif.key#_one COLUMN-LABEL "Код!товара" FORMAT ">>>>>>>>9"
     1558   get-gds-name(ext-classif.key#_one, ext-classif.key#_three) COLUMN-LABEL "Наименование товара" FORMAT "X(32)"
     1559   WITH NO-ROW-MARKERS SEPARATORS SIZE 98.3 BY 20.37 FIT-LAST-COLUMN.
     1560   DEFINE BUTTON b-add
     1561        LABEL "&Добавить"
     1562        SIZE 10 BY 1.
     1563   DEFINE BUTTON b-cli
     1564        LABEL "Товар"
     1565        SIZE 10 BY 1.
     1566   DEFINE BUTTON b-del
     1567        LABEL "&Удалить"
     1568        SIZE 10 BY 1.
     1569   DEFINE BUTTON b-esys
     1570        LABEL "ВС"
     1571        SIZE 10 BY 1.
     1572   DEFINE BUTTON B-Help
     1573        LABEL "Помо&щь"
     1574        SIZE 3 BY 1
     1575        BGCOLOR 8 .
     1576   DEFINE BUTTON B-mark
     1577        LABEL "&*"
     1578        SIZE 3 BY 1.
     1579   DEFINE BUTTON b-print
     1580        LABEL "&Печать"
     1581        SIZE 3 BY 1.
     1582   DEFINE BUTTON b-quit AUTO-END-KEY
     1583        LABEL "&Выход"
     1584        SIZE 10 BY 1
     1585        BGCOLOR 8 .
     1586   DEFINE BUTTON b-sch
     1587        LABEL "Фильтр"
     1588        SIZE 3 BY 1.
     1589   DEFINE BUTTON B-sel AUTO-GO
     1590        LABEL "Вы&бор"
     1591        SIZE 10 BY 1.
     1592   DEFINE VARIABLE fill-in-code-system AS CHARACTER FORMAT "X(256)":U
     1593        LABEL "Код товара во внешней системе"
     1594        VIEW-AS FILL-IN
     1595        SIZE 14 BY 1 NO-UNDO.
     1596   DEFINE VARIABLE fill-in-code-th AS CHARACTER FORMAT "X(256)":U
     1597        LABEL "Код товара в ТН"
     1598        VIEW-AS FILL-IN
     1599        SIZE 14 BY 1 NO-UNDO.
     1600   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1601         VIEW-AS TEXT
     1602        SIZE 6 BY 1
     1603        FGCOLOR 4  NO-UNDO.
     1604   DEFINE FRAME Dialog-Frame
     1605        b-quit AT ROW 1 COL 1
     1606        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1607        B-sel AT ROW 1 COL 21 WIDGET-ID 6
     1608        b-add AT ROW 1 COL 31 WIDGET-ID 14
     1609        b-del AT ROW 1 COL 41 WIDGET-ID 16
     1610        b-cli AT ROW 1 COL 51 WIDGET-ID 2
     1611        b-esys AT ROW 1 COL 61 WIDGET-ID 18
     1612        b-sch AT ROW 1 COL 86 WIDGET-ID 12
     1613        b-print AT ROW 1 COL 89 WIDGET-ID 10
     1614        B-Help AT ROW 1 COL 95
     1615        fill-in-code-system AT ROW 2.50 COL 33 COLON-ALIGNED WIDGET-ID 2
     1616        fill-in-code-th AT ROW 2.50 COL 68 COLON-ALIGNED WIDGET-ID 2
     1617        br-esys-gds AT ROW 4.00 COL 1.5 WIDGET-ID 100
     1618        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1619        SPACE(79.30) SKIP(21.26)
     1620       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1621            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1622            TITLE ""
     1623            CANCEL-BUTTON b-quit.
     1624   ASSIGN
     1625          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1626          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1627   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1628   DO:
     1629     APPLY "END-ERROR":U TO SELF.
     1630   END.
     1631   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1632   DO:
     1633     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1634     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1635   END.
     1636   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1637   DO:
     1638     define variable gdsrec as recid no-undo.
     1639     define buffer buf_code for ub.code.
     1640     IF NOT AVAILABLE ext-classif THEN RETURN NO-APPLY.
     1641     for first goods no-lock where goods.gds-code = ext-classif.key#_one:
     1642       gdsrec = recid(goods).
     1643       run ref/gds-form.w (parparentproc, 'ПРОСМОТР':U, v-cntxt-obj-type, v-cntxt-obj-code, input this-procedure:handle, input-output gdsrec).
     1644     end.
     1645     if not available goods then
     1646     do:
     1647       for first buf_code no-lock where
     1648                 buf_code.parent = "DTSeasons"
     1649             and buf_code.code = string(ext-classif.key#_one)
     1650       :
     1651         gdsrec = recid(buf_code).
     1652         run ref/dtseasons-frm.w (
     1653           input parparentproc
     1654           , 'ПРОСМОТР':U
     1655           , input-output gdsrec).
     1656       end.
     1657     end.
     1658   END.
     1659   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1660   DO:
     1661     IF NOT AVAILABLE ext-classif THEN RETURN NO-APPLY.
     1662     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1663     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1664   END.
     1665   ON CHOOSE OF b-esys IN FRAME Dialog-Frame
     1666   DO:
     1667   define variable v-have-rights    as logical        no-undo.
     1668   define variable v-success    as logical        no-undo.
     1669   define variable v-esys-id   as integer        no-undo.
     1670    IF NOT AVAILABLE ext-classif THEN RETURN NO-APPLY.
     1671    ASSIGN
     1672    v-esys-id = ext-classif.key#_two.
     1673   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1674   do:
     1675     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1676       (input  v-cntxt-db-num
     1677       ,input  v-cntxt-userid
     1678       ,input  0
     1679       ,input  'actn_openxml-subsystem_lookup':U
     1680       ,input  'global':U
     1681       ,input  0
     1682       ,input  '':U
     1683       ,input  0
     1684       ,input  0
     1685       ,input  0
     1686       ,input  0
     1687       ,input  yes
     1688       ,output v-have-rights
     1689       )  .
     1690   end.
     1691       if v-have-rights = yes
     1692       then do:
     1693                     run bge/oxmlspci.w (
     1694                   input parparentproc
     1695                 , input 'ПРОСМОТР':U
     1696                 , input-output v-esys-id
     1697                 , input 0
     1698                 , output v-success
     1699             ) no-error.
     1700    end.
     1701     APPLY "entry" TO br-esys-gds.
     1702   END.
     1703   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1704   DO:
     1705     define variable loc#log as logical no-undo .
     1706     if available ext-classif then do:
     1707   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1708   define variable v-str-recid16 as character no-undo .
     1709   define variable v-num-entry16 as integer   no-undo .
     1710   assign
     1711     v-str-recid16 = trim( string( recid( ext-classif ) , "->>>>>>>>>>>9":U ) )
     1712     v-num-entry16 = lookup( v-str-recid16 , v-rid-list )
     1713   .
     1714   if v-num-entry16 > 0 then do:
     1715     assign
     1716       entry( v-num-entry16, v-rid-list ) = "":U
     1717       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1718     .
     1719   end.
     1720   else do:
     1721     assign
     1722       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1723     .
     1724   end.
     1725       loc#log = br-esys-gds:refresh() .
     1726       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1727           loc#log = br-esys-gds:select-next-row ().
     1728           apply "VALUE-CHANGED" to br-esys-gds in frame Dialog-Frame.
     1729       end.
     1730       if num-entries( v-rid-list ) = 0
     1731       then
     1732           hide mark-num in frame Dialog-Frame.
     1733       else
     1734           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1735     end.
     1736     apply "entry" to br-esys-gds in frame Dialog-Frame.
     1737   END.
     1738   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1739   DO:
     1740     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
     1741     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1742   END.
     1743   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1744   DO:
     1745     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1746     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1747   END.
     1748   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1749   DO:
     1750       if ( available ext-classif ) then do:
     1751       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1752       then
     1753       v-rid-list = string( recid( ext-classif ) ) .
     1754     end.
     1755   p-rid-list = v-rid-list .
     1756   END.
     1757   ON ENTER OF fill-in-code-system IN FRAME Dialog-Frame
     1758   DO:
     1759      find first ub.ext-classif no-lock  where
     1760                                           ub.ext-classif.CharKey_One = fill-in-code-system:screen-value
     1761                                           and (if fill-in-code-th:screen-value > "" then
     1762                                                ub.ext-classif.Key#_One = integer(fill-in-code-th:screen-value) else true)
     1763                                           and  ub.ext-classif.classif-subject = 'goods':U
     1764                                           and  ub.ext-classif.classif-name = 'exp-esys-gds-code':U no-error.
     1765     if available ub.ext-classif then reposition br-esys-gds-query to rowid rowid(ub.ext-classif).
     1766                              else message "Указанный код товара во внешней системе отсутствует. ".
     1767     apply "entry" to br-esys-gds in frame Dialog-Frame .
     1768     return no-apply.
     1769   END.
     1770   ON ENTER OF fill-in-code-th IN FRAME Dialog-Frame
     1771   DO:
     1772     find first ub.ext-classif no-lock   where ub.ext-classif.Key#_One=integer(fill-in-code-th:screen-value)
     1773                                            and (if fill-in-code-system:screen-value>"" then
     1774                                                 ub.ext-classif.CharKey_One = fill-in-code-system:screen-value else true )
     1775                                            and ub.ext-classif.classif-subject = 'goods':U
     1776                                            and ub.ext-classif.classif-name = 'exp-esys-gds-code':U  no-error.
     1777     if available ub.ext-classif then reposition br-esys-gds-query to rowid rowid(ub.ext-classif).
     1778                              else message "Указанный код товара в TH отсутствует. ".
     1779     apply "entry" to br-esys-gds in frame Dialog-Frame .
     1780     return no-apply.
     1781   END.
     1782   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1783   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1784   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1785   on help of frame Dialog-Frame
     1786   do:
     1787     run gbl/app_help.p
     1788       (input this-procedure :file-name
     1789       ,input ''
     1790       ,input ?
     1791       ) no-error.
     1792     if error-status :error then do:
     1793       message
     1794         "Ошибка при вызове помощи"
     1795         error-status :get-message(1)
     1796         view-as alert-box .
     1797     end.
     1798   end.
     1799   run minbtn-set in this-procedure .
     1800   on choose of b-help in frame Dialog-Frame
     1801   do:
     1802     apply "help":u to frame Dialog-Frame .
     1803   end.
     1804   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1805   procedure minbtn-set :
     1806       do
     1807           on error undo, return error return-value
     1808           :
     1809           define variable ii              as integer       no-undo .
     1810           define variable fh              as widget-handle no-undo .
     1811           define variable hh              as widget-handle no-undo .
     1812           define variable v-h             as handle        extent 4 no-undo .
     1813           define variable v-name-button   as character     no-undo .
     1814           define variable v-help-old-x    as decimal       no-undo .
     1815           define variable v-help-old-y    as decimal       no-undo .
     1816           define variable v-help-old-size as decimal       no-undo .
     1817           define variable v-frame-width   as decimal       no-undo .
     1818           define variable jj              as integer       no-undo .
     1819           do
     1820               on error undo, return error
     1821               :
     1822               assign
     1823                   v-frame-width = frame Dialog-Frame:width - 0.3
     1824                   fh            = frame Dialog-Frame:first-child
     1825                   hh            = fh:first-child
     1826                   ii            = 1
     1827                   .
     1828               do while valid-handle(hh):
     1829                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1830                   do:
     1831                       case lc(hh:name) :
     1832                           when "b-help" then
     1833                               do:
     1834                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1835                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1836                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1837                                   hh:TOOLTIP = "Помощь" .
     1838                                   v-help-old-x = hh:column .
     1839                                   v-help-old-y = hh:row    .
     1840                                   v-help-old-size = hh:width .
     1841                                   hh:width-chars = 2.5 .
     1842                               end.
     1843                           when "b-print" then
     1844                               do:
     1845                                   hh:load-image("cmp/b-print.bmp":u) .
     1846                                   hh:TOOLTIP = "Печать" .
     1847                                   v-h[ii] = hh:handle .
     1848                                   ii = ii + 1 .
     1849                                   hh:width-chars = 3 .
     1850                               end.
     1851                           when "b-history" or
     1852                           when "b-hist" then
     1853                               do:
     1854                                   hh:load-image("cmp/b-hist.bmp":u) .
     1855                                   hh:TOOLTIP = "История" .
     1856                                   v-h[ii] = hh:handle .
     1857                                   ii = ii + 1 .
     1858                                   hh:width-chars = 3 .
     1859                               end.
     1860                           when "b-sch" then
     1861                               do:
     1862                                   hh:load-image("cmp/b-sch.bmp":u) .
     1863                                   hh:TOOLTIP = "Установка Фильтра" .
     1864                                   v-h[ii] = hh:handle .
     1865                                   ii = ii + 1 .
     1866                                   hh:width-chars = 3 .
     1867                               end.
     1868                           when "b-hist-user" then
     1869                               do:
     1870                                   hh:load-image("cmp/b-hist.bmp":u) .
     1871                                   hh:TOOLTIP = "История пользователя" .
     1872                                   ii = ii + 1 .
     1873                               end.
     1874                       end case.
     1875                   end.
     1876                   hh = hh:next-sibling.
     1877               end.
     1878               b-help:column = v-frame-width - b-help:width-chars.
     1879               jj = 0.
     1880               repeat ii = 4 to 1 by -1 :
     1881                   if valid-handle (v-h[ii] ) then
     1882                   do:
     1883                       jj  = jj + 1 .
     1884                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1885                       v-h[ii]:row    = v-help-old-y .
     1886                   end.
     1887               end.
     1888           end.
     1889       end.
     1890   end procedure.
     1891   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1892   procedure set-filter-name :
     1893   define input parameter p-filter-name as character no-undo .
     1894     do with frame Dialog-Frame:
     1895       if p-filter-name > "" then do:
     1896         assign
     1897           frame Dialog-Frame:title
     1898             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     1899         .
     1900         assign
     1901           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     1902         .
     1903       end.
     1904       else do:
     1905         assign
     1906           b-sch :tooltip = ""
     1907         .
     1908       end.
     1909     end.
     1910   end procedure.
     1911   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1912   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     1913     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     1914     return no-apply.
     1915   end.
     1916   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1917   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     1918     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     1919     return no-apply.
     1920   end.
     1921   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1922   on F8 of frame Dialog-Frame anywhere do:
     1923     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     1924     return no-apply.
     1925   end.
     1926   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1927   on INS of frame Dialog-Frame anywhere do:
     1928     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1929     return no-apply.
     1930   end.
     1931   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1932   on F2 of frame Dialog-Frame anywhere do:
     1933     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     1934     return no-apply.
     1935   end.
     1936   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1937   on F2 of frame Dialog-Frame anywhere do:
     1938     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     1939     return no-apply.
     1940   end.
     1941   MAIN-BLOCK:
     1942   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1943      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1944   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1945     run mainmenu_getcntxt in parparentproc
     1946       (output v-cntxt-db-num
     1947       ,output v-cntxt-userid
     1948       ,output v-cntxt-level
     1949       ,output v-cntxt-host-code-obj
     1950       ,output v-cntxt-obj-type
     1951       ,output v-cntxt-obj-code
     1952       ,output v-cntxt-db-num-obj
     1953       ,output v-cntxt-is-admin
     1954       ) .
     1955     v-rid-list = p-rid-list.
     1956     if not (p-list-mode = 'все':U
     1957            or
     1958            p-list-mode = "one") then  do:
     1959       message
     1960       substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     1961       view-as alert-box error .
     1962       undo, return error .
     1963     end.
     1964     if p-list-mode = "one" then do:
     1965       find first ext-system no-lock where
     1966                 ext-system.db-num = 0
     1967             and ext-system.esys-id = p-esys-id no-error.
     1968       if not available ext-system then do:
     1969         message
     1970         substitute("Неверное значение параметра p-esys-id=&1&2" +
     1971                     "Нет внешней системы &1 с db-num = 0"
     1972                   , p-esys-id)
     1973         view-as alert-box error .
     1974         undo, return error .
     1975       end.
     1976     end.
     1977     RUN Myenable.
     1978     run ui-on.
     1979     WAIT-FOR GO OF FRAME Dialog-Frame.
     1980   END.
     1981   RUN disable_UI.
     1982   PROCEDURE disable_UI :
     1983     HIDE FRAME Dialog-Frame.
     1984   END PROCEDURE.
     1985   PROCEDURE UI-on :
     1986       define variable sort-column-phrase as character no-undo .
     1987       define variable l-query-was-opened as logical no-undo .
     1988       define variable title0 as character no-undo .
     1989       define buffer buf_clients for clients.
     1990                           filter-point = filter-point0 + p-list-mode .
     1991       case p-list-mode :
     1992         when 'все':U then do:
     1993           title0 = "Товары всех внешних систем".
     1994           ASSIGN
     1995           frame Dialog-Frame:title = substitute("&1", title0)
     1996           filter-label = SUBSTITUTE("&1"
     1997                                     , frame Dialog-Frame:title
     1998                                     )
     1999           .
     2000   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2001   define variable  l-disable-where-28  as logical   no-undo .
