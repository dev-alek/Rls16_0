     2099         .
     2100     end.
     2101         end.
     2102         when "one" then do:
     2103           title0 = substitute("Товары внешней системы &1", p-esys-id).
     2104           ASSIGN
     2105           frame Dialog-Frame:title = substitute("&1", title0)
     2106           filter-label = SUBSTITUTE("&1"
     2107                                     , frame Dialog-Frame:title
     2108                                     )
     2109           .
     2110   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
