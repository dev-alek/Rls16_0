        1   using Progress.Lang.*.
        2   using Ibs.Th.Gbl.ReportXml.
        3   using Ibs.Th.Gbl.rep-out.
        4   DEFINE BUFFER X_clients FOR ub.clients.
        5   define buffer x_goods   for ub.goods.
        6   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        7   DEFINE INPUT PARAMETER bttns AS character NO-UNDO.
        8   DEFINE INPUT PARAMETER p-list-mode AS character NO-UNDO.
        9   define input parameter p-esys-id as integer no-undo .
       10   DEFINE INPUT-OUTPUT PARAMETER p-rid-list AS character NO-UNDO.
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Коды товаров внешней системы".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define variable v-waitfram-action01         as character   no-undo .
       73   define variable v-waitfram-action02         as character   no-undo .
       74   define variable v-waitfram-action03         as character   no-undo .
       75   define variable mWaitFramTextBeg            as character   no-undo.
       76   define variable mWaitFramTextEnd            as character   no-undo.
       77   define variable mWaitFramView               as logical     no-undo.
       78   define variable mWaitProcEvent              as logical     no-undo init yes.
       79   define variable mWaitFramInterval           as integer     no-undo init 1 .
       80   define variable mWaitFramStop               as logical     no-undo.
       81   define variable mWaitFramStopUser           as logical     no-undo.
       82   define variable mWaitFramStopTimeOut        as logical     no-undo.
       83   define variable mWaitFramStartProc          as datetime-tz no-undo.
       84   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       85   define button B-WaitFramStop auto-end-key
       86        label "Стоп"
       87        size 10 by 1 tooltip "Остоновить процесс".
       88   define button B-viewProcInfo
       89        label "Информация"
       90        size 15 by 1 tooltip "Информация о процесс".
       91   define frame waitfram
       92     v-waitfram-action01 format "x(72)" no-label skip
       93     v-waitfram-action02 format "x(72)" no-label skip
       94     v-waitfram-action03 format "x(72)" no-label skip
       95     B-viewProcInfo
       96     B-WaitFramStop at row 4 col 30
       97     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       98     .
       99   define new global shared variable mBatchMode as logical no-undo init ?.
      100   define variable mFramBachModHandle as handle no-undo.
      101   mFramBachModHandle = frame waitfram:handle.
      102   define variable mFameOldVis as logical no-undo.
      103   define variable mVisCUrentVin as logical no-undo.
      104   if session:batch-mode
      105   then
      106      mBatchMode = yes.
      107   if mBatchMode = ? then do:
      108     mVisCUrentVin = current-window:visible.
      109     mFameOldVis = mFramBachModHandle:visible.
      110     mFramBachModHandle:visible  = yes.
      111     mBatchMode = mFramBachModHandle:visible ne yes.
      112     mFramBachModHandle:visible = mFameOldVis.
      113     current-window:visible = mVisCUrentVin.
      114   end.
      115    if  log-manager:logfile-name ne ?
      116     then DO:
      117         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      118         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      119         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      120     end.
      121   on choose of B-WaitFramStop in frame waitfram
      122   do:
      123     mWaitFramStop = yes.
      124     mWaitFramStopUser = yes.
      125   end.
      126   function waitfram-check-timeout returns logical():
      127      define variable vtime as int64 no-undo.
      128      if mWaitFramStopTimeOut
      129      then
      130         return yes.
      131      vtime = ( now - mWaitFramStartProc ) / 1000 .
      132      if     mWaitFramTimeOut ne ?
      133         and mWaitFramTimeOut ne 0
      134         and mWaitFramTimeOut lt vtime
      135      then do:
      136         mWaitFramStopTimeOut = yes.
      137      end.
      138      return mWaitFramStopTimeOut.
      139   end.
      140   procedure waitfram-hide :
      141     if not session:batch-mode
      142     then do
      143     on error undo, return error return-value
      144     :
      145       pause 0 before-hide .
      146       if not mBatchMode then
      147         hide frame waitfram .
      148     if     not mWaitFramView
      149        and mWaitProcEvent
      150     then
      151       process events .
      152     end.
      153   end procedure.
      154   procedure waitfram-show :
      155     define input  parameter p-message as character no-undo .
      156     define variable v-left-margin as integer   no-undo .
      157     if not session:batch-mode
      158     then do
      159     on error undo, return error return-value
      160     :
      161       if length(p-message) <= 70 then do:
      162         assign
      163           v-left-margin = integer((70 - length(p-message)) / 2)
      164         .
      165         assign
      166           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      167         .
      168         assign
      169           v-waitfram-action01 = " "
      170           v-waitfram-action02 = " "
      171                                    + fill(" ", v-left-margin)
      172                                    + p-message
      173           v-waitfram-action03 = " "
      174         .
      175       end.
      176       else do:
      177         define variable vRindex1 as integer no-undo.
      178         define variable vRindex2 as integer no-undo.
      179         vRindex1 = r-index(p-message," ",70).
      180         if vRindex1 = 0
      181         then
      182            vRindex1 = 70.
      183         if length(p-message)  <= vRindex1 + 70 then do:
      184           assign
      185             v-waitfram-action01 = " "
      186             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      187             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      188           .
      189         end.
      190         else do:
      191           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      192           if vRindex2 <= vRindex1
      193           then
      194              vRindex2 = vRindex1 + 70.
      195           assign
      196             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      197             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      199           .
      200         end.
      201       end.
      202       B-viewProcInfo:visible   in frame waitfram = no.
      203       B-viewProcInfo:sensitive in frame waitfram = no.
      204       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       if  (   mWaitFramView
      207          or  mWaitProcEvent)
      208          and not mBatchMode
      209       then
      210          display
      211             v-waitfram-action01 skip
      212             v-waitfram-action02 skip
      213             v-waitfram-action03 skip
      214          with frame waitfram .
      215       if     mWaitFramView
      216          then do:
      217             if     mWaitFramInterval ne ?
      218                and not mBatchMode
      219             then
      220                wait-for go of frame waitfram pause mWaitFramInterval.
      221          end.
      222          else
      223             if     mWaitProcEvent
      224                and not mBatchMode
      225             then
      226                process events .
      227     end.
      228   end procedure.
      229      procedure waitfram-show-this:
      230         define input  parameter iInterval as int64 no-undo.
      231         define variable vtime as int64 no-undo.
      232         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      233         mWaitFramInterval = iInterval.
      234         run waitfram-show (substitute("&1&2 &3&4" ,
      235                                       mWaitFramTextBeg ,
      236                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      237                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      238                                       mWaitFramTextEnd
      239                                      )
      240                           ).
      241      end.
      242      procedure WaitFramRunPause:
      243         define input  parameter iInterval as dec no-undo.
      244         define variable vStart  as datetime-tz no-undo.
      245         define variable vend    as datetime-tz no-undo.
      246         define variable vint as int64 no-undo.
      247         define variable vOk as logical no-undo.
      248         vStart = now.
      249         vend   = vStart.
      250         publish "WaitFramPause" (iInterval,output vOk).
      251         vend   =  now.
      252         vint = vend - vStart.
      253         vint = iInterval - vint / 1000.
      254         if     not mWaitFramStop
      255            and (   vint > 0
      256                 or (    not vOk
      257                     and iInterval eq ?
      258                     )
      259                 )
      260         then
      261            run waitfram-show-this (iInterval).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and vint > 0
      267         then do:
      268            run gbl/pause.p (vint * 1000).
      269         end.
      270         if iInterval ne ?
      271         then
      272            publish "WaitFramStop".
      273         waitfram-check-timeout().
      274      end.
      275      procedure WaitFramWaitFor:
      276         define input  parameter iInterval as dec no-undo.
      277         assign
      278            mWaitFramStartProc   = now
      279            mWaitFramStopUser    = no
      280            mWaitFramStopTimeOut = no
      281         .
      282         block-wait:
      283         do while not mWaitFramStop:
      284            run WaitFramRunPause (iInterval).
      285            if  waitfram-check-timeout()
      286            then do:
      287               leave block-wait.
      288            end.
      289         end.
      290         run waitfram-hide.
      291      end.
      292   procedure waitfram-join :
      293     define input  parameter p-line-1  as character no-undo .
      294     define input  parameter p-line-2  as character no-undo .
      295     define input  parameter p-line-3  as character no-undo .
      296     define output parameter p-message as character no-undo .
      297     do
      298     on error undo, return error return-value
      299     :
      300       assign
      301         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      304       .
      305     end.
      306   end procedure.
      307   function waitfram-join-function returns character
      308     (input p-line-1 as character
      309     ,input p-line-2 as character
      310     ,input p-line-3 as character
      311     ).
      312     define variable v-message as character no-undo .
      313     run waitfram-join in this-procedure
      314       (input  p-line-1
      315       ,input  p-line-2
      316       ,input  p-line-3
      317       ,output v-message
      318       ) .
      319     return v-message .
      320   end function .
      321   define new global shared variable g#language as character no-undo .
      322   if g#language <> '' and g#language <> 'rus':U then do:
      323     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      324   end.
      325   procedure proc-alt-shift-f2:
      326     if not ibs.th.gbl.gbl-var:rcode
      327   then
      328     run gbl\inidebug.p .
      329   end.
      330   procedure proc-alt-shift-f3:
      331     run gbl/prvssinf.p
      332       ( input this-procedure
      333       ) .
      334   end.
      335   define variable v-inform-launched as logical no-undo initial false .
      336   procedure proc-alt-shift-f4:
      337     define variable v-action as character no-undo .
      338     if v-inform-launched = false then do:
      339       assign
      340         v-inform-launched = true
      341       .
      342       run gbl/d-inform.w
      343         (  input self
      344         ,  input this-procedure
      345         , output v-action
      346         ) no-error .
      347       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      348       assign
      349         v-inform-launched = false
      350       .
      351     end.
      352   end.
      353   procedure proc-alt-f1:
      354     run gbl/corrhelp.p
      355       (input this-procedure
      356       ) .
      357   end .
      358   on alt-shift-f2 anywhere do:
      359     run proc-alt-shift-f2.
      360   end.
      361   on alt-shift-f3 anywhere do:
      362     run proc-alt-shift-f3 in this-procedure .
      363   end.
      364   on alt-shift-f4 anywhere do:
      365     run proc-alt-shift-f4 in this-procedure.
      366   end.
      367   on alt-f1 anywhere do:
      368     run proc-alt-f1 in this-procedure .
      369   end.
      370   define new global shared variable g#library  as handle no-undo .
      371   define new global shared variable g#library2 as handle no-undo .
      372   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373     define variable v-cntxt-db-num        as integer   no-undo .
      374     define variable v-cntxt-userid        as character no-undo .
      375     define variable v-cntxt-level         as character no-undo .
      376     define variable v-cntxt-host-code-obj as integer   no-undo .
      377     define variable v-cntxt-obj-type      as character no-undo .
      378     define variable v-cntxt-obj-code      as integer   no-undo .
      379     define variable v-cntxt-db-num-obj    as integer   no-undo .
      380     define variable v-cntxt-is-admin      as logical   no-undo .
      381   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   procedure gen-key-rec :
      383     define input  parameter p-tbl-name    as character no-undo.
      384     define input  parameter p-bh_tbl-name as handle    no-undo.
      385     define output parameter p-key-rec     as character no-undo.
      386     do
      387     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      388     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      389     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      390     :
      391       define variable fh               as handle    no-undo .
      392       define variable v-ok             as logical   no-undo .
      393       define variable v-inform         as character no-undo .
      394       define variable v-ind            as integer   no-undo .
      395       define variable v-idx-field-qnty as integer   no-undo .
      396       if p-tbl-name = ?
      397         or p-tbl-name = "":U
      398       then do:
      399         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      400       end.
      401       if not p-bh_tbl-name:available then do:
      402         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      403       end.
      404       assign
      405         p-key-rec = p-tbl-name
      406         v-inform  = p-bh_tbl-name:index-information(1)
      407         v-ind     = 2
      408       .
      409       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      410       on error undo, return error
      411       :
      412         assign
      413           v-inform = p-bh_tbl-name:index-information( v-ind )
      414           v-ind    = v-ind + 1
      415         .
      416       end.
      417       if v-inform = ?
      418         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      419         or entry( 3, v-inform, ",":U ) <> "1":U
      420       then do:
      421         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      422       end.
      423       else do:
      424         assign
      425           v-idx-field-qnty = num-entries( v-inform ) - 4
      426         .
      427         if v-idx-field-qnty < 2 then do:
      428           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      429         end.
      430         do v-ind = 1 to v-idx-field-qnty by 2
      431         on error undo, return error
      432         :
      433           assign
      434             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      435             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      436           .
      437         end.
      438       end.
      439       if p-key-rec = ? then do:
      440         assign
      441           p-key-rec = "":U
      442         .
      443         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      444       end.
      445     end.
      446     return.
      447   end procedure.
      448   procedure gen-where-keyr-tab :
      449     define input  parameter i-tableSerach as character no-undo.
      450     define input  parameter i-tablekey   as character  no-undo.
      451     define input  parameter p-key-rec    as character  no-undo.
      452     define input  parameter p-key-handle as handle     no-undo .
      453     define input  parameter p-db-name    as character  no-undo .
      454     define input  parameter p-tt-handle  as handle     no-undo .
      455     define output parameter o-Where      as character  no-undo.
      456     do
      457     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      458     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      459     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      460     :
      461       define variable v-full-tbl-name  as character no-undo .
      462       define variable bh_tbl-name      as handle    no-undo .
      463       define variable fh_key           as handle    no-undo .
      464       define variable fh_search        as handle    no-undo .
      465       define variable v-field-num      as integer   no-undo .
      466       define variable v-count-fld      as integer   no-undo .
      467       define variable v-inform         as character no-undo .
      468       define variable v-ind            as integer   no-undo .
      469       define variable v-idx-field-qnty as integer   no-undo .
      470       define variable v-field-name     as character no-undo .
      471       define variable v-field-val      as character no-undo .
      472       define variable v-word-link      as character no-undo .
      473       define variable vTable           as character no-undo.
      474       define variable bh_tbl-key       as handle    no-undo .
      475       assign
      476         p-key-rec = trim( p-key-rec )
      477       .
      478       if p-key-handle <> ? then do:
      479         if not valid-handle(p-key-handle)
      480            or p-key-handle:type <> "buffer"
      481         then do:
      482           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      483         end.
      484         if num-entries( p-key-rec, chr(3) ) > 1
      485           or p-key-rec = ?
      486           or p-key-rec = "":U
      487         then do:
      488           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      489         end.
      490       end.
      491       else do:
      492         if p-key-rec = ?
      493           or p-key-rec = "":U
      494         then do:
      495           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      496         end.
      497       end.
      498       assign
      499         vTable = entry( 1 , p-key-rec, chr(3) )
      500       .
      501       if p-tt-handle <> ?
      502         and ( not valid-handle(p-tt-handle)
      503               or p-tt-handle:type <> "buffer"
      504             )
      505       then do:
      506         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      507       end.
      508       if p-tt-handle = ? then do:
      509         assign
      510           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      511         .
      512         create buffer bh_tbl-name for table v-full-tbl-name .
      513       end.
      514       else do:
      515         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      516       end.
      517       assign
      518         v-inform = bh_tbl-name:index-information(1)
      519         v-ind    = 2
      520       .
      521       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      522       on error undo, return error
      523       :
      524         assign
      525           v-inform = bh_tbl-name:index-information( v-ind )
      526           v-ind    = v-ind + 1
      527         .
      528       end.
      529       if v-inform = ?
      530         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      531         or entry( 3, v-inform, ",":U ) <> "1":U
      532       then do:
      533         delete object bh_tbl-name no-error.
      534         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      535       end.
      536       assign
      537         v-idx-field-qnty = num-entries( v-inform ) - 4
      538       .
      539       if v-idx-field-qnty < 2 then do:
      540         delete object bh_tbl-name no-error.
      541         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      542       end.
      543       assign
      544         o-where     = "where":U
      545         v-word-link = "":U
      546         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      547         v-count-fld = 0
      548       .
      549       if i-tablekey ne "" and i-tablekey ne ?
      550       then do:
      551         assign
      552           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      553         .
      554         create buffer bh_tbl-key for table v-full-tbl-name .
      555       end.
      556       if i-tableSerach ne "" and i-tableSerach ne ?
      557       then do:
      558         delete object bh_tbl-name no-error.
      559         assign
      560           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      561         .
      562         create buffer bh_tbl-name for table v-full-tbl-name .
      563       end.
      564       block_where:
      565       do v-ind = 1 to v-idx-field-qnty by 2
      566       on error undo, return error
      567       :
      568         assign
      569           v-count-fld = v-count-fld + 1
      570         .
      571         if p-key-handle = ?
      572           and v-count-fld > v-field-num
      573         then do:
      574           leave block_where.
      575         end.
      576         define variable VfieldKeyTable as handle no-undo.
      577         assign
      578           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      579           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      580         .
      581         if     bh_tbl-key ne ?
      582         then do:
      583            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      584            if VfieldKeyTable eq ?
      585            then next block_where.
      586         end.
      587         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      588         then
      589            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      590         else
      591            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      592         if p-key-handle = ? then do:
      593           assign
      594             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      595           .
      596         end.
      597         else do:
      598           assign
      599             fh_key = p-key-handle:buffer-field( v-field-name )
      600           .
      601           if fh_key = ?
      602             or not valid-handle( fh_key )
      603           then do:
      604             delete object bh_tbl-name.
      605             if     bh_tbl-key ne ?
      606             then
      607                delete object bh_tbl-key.
      608             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      609           end.
      610           assign
      611             v-field-val = fh_key:buffer-value
      612           .
      613         end.
      614         if fh_search:data-type ="character":U then do:
      615           assign
      616             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      617             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      618             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      619             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      620             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      621             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      622             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      623             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      624             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      625             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      626             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      627             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      628             v-field-val = substitute( '"&1"', v-field-val )
      629           .
      630         end.
      631         assign
      632           o-where = substitute( "&1 &2", o-where, v-field-val )
      633         .
      634         if v-word-link = "":U then do:
      635           assign
      636             v-word-link = "and":U
      637           .
      638         end.
      639       end.
      640       delete object bh_tbl-name.
      641       if     bh_tbl-key ne ?
      642       then
      643          delete object bh_tbl-key.
      644       if p-key-handle = ?
      645         and v-count-fld <> v-field-num
      646       then do:
      647         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      648       end.
      649     end.
      650   end procedure.
      651   procedure gen-hn-keyr-tab :
      652     define input  parameter i-tableSerach as character no-undo.
      653     define input  parameter i-tablekey   as character no-undo.
      654     define input  parameter p-key-rec    as character no-undo.
      655     define input  parameter p-key-handle as handle    no-undo .
      656     define input  parameter p-db-name    as character no-undo .
      657     define input  parameter p-tt-handle  as handle    no-undo .
      658     define input  parameter p-stts-lock  as integer   no-undo .
      659     define output parameter o-hn         as handle    no-undo.
      660     define variable v-full-tbl-name as character no-undo.
      661     define variable v-where         as character no-undo.
      662     define variable bh_tbl-name     as handle    no-undo.
      663     define variable vTable          as character no-undo.
      664     do
      665     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      666     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      667     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      668         run gen-where-keyr-tab(i-tableSerach,
      669                                i-tablekey,
      670                                p-key-rec,
      671                                p-key-handle,
      672                                p-db-name,
      673                                p-tt-handle,
      674                                output v-where).
      675         if i-tableSerach ne "" and i-tableSerach ne ?
      676         then do:
      677            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      678            create buffer bh_tbl-name for table v-full-tbl-name .
      679         end.
      680         else do:
      681            if p-tt-handle = ? then do:
      682               assign
      683                  vTable = entry( 1 , p-key-rec, chr(3) )
      684               .
      685               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      686               create buffer bh_tbl-name for table v-full-tbl-name .
      687            end.
      688            else do:
      689               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      690            end.
      691         end.
      692         if p-tt-handle = ? then do:
      693            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      694         end.
      695         else do:
      696            bh_tbl-name:find-first( v-where ) no-error .
      697         end.
      698         o-hn = bh_tbl-name.
      699      end.
      700   end procedure.
      701   procedure gen-hn-keyr :
      702     define input  parameter p-key-rec    as character no-undo.
      703     define input  parameter p-key-handle as handle    no-undo .
      704     define input  parameter p-db-name    as character no-undo .
      705     define input  parameter p-tt-handle  as handle    no-undo .
      706     define input  parameter p-stts-lock  as integer   no-undo .
      707     define output parameter o-hn         as handle    no-undo.
      708     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      709   end.
      710   procedure gen-row-keyr :
      711     define input  parameter p-key-rec    as character no-undo.
      712     define input  parameter p-key-handle as handle    no-undo .
      713     define input  parameter p-db-name    as character no-undo .
      714     define input  parameter p-tt-handle  as handle    no-undo .
      715     define input  parameter p-stts-lock  as integer   no-undo .
      716     define output parameter p-tbl-row    as rowid     no-undo.
      717     define output parameter p-tbl-name   as character no-undo.
      718     define variable vHn as handle no-undo.
      719       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      720       p-tbl-row = if vHn:available then vHn:rowid else ?.
      721       p-tbl-name =  vHn:table.
      722       delete object vHn no-error.
      723     if p-tbl-row = ? then do:
      724       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      725     end.
      726     else do:
      727       return.
      728     end.
      729   end procedure.
      730   procedure gen-key-fv :
      731     define input  parameter p-key-rec    as character no-undo .
      732     define output parameter p-field-list as character no-undo .
      733     define output parameter p-value-list as character no-undo.
      734     do
      735     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      736     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      737     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      738     :
      739       define variable v-full-tbl-name  as character no-undo .
      740       define variable bh_tbl-name      as handle    no-undo .
      741       define variable v-tbl-name       as character no-undo .
      742       define variable v-field-num      as integer   no-undo .
      743       define variable v-count-fld      as integer   no-undo .
      744       define variable v-inform         as character no-undo .
      745       define variable v-ind            as integer   no-undo .
      746       define variable v-idx-field-qnty as integer   no-undo .
      747       define variable v-delim-key      as character no-undo .
      748       if p-key-rec = ?
      749         or p-key-rec = "":U
      750       then do:
      751         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      752       end.
      753       assign
      754         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      755         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      756       .
      757       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      758       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      759       assign
      760         v-inform = bh_tbl-name:index-information(1)
      761         v-ind    = 2
      762       .
      763       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      764       on error undo, return error
      765       :
      766         assign
      767           v-inform = bh_tbl-name:index-information( v-ind )
      768           v-ind    = v-ind + 1
      769         .
      770       end.
      771       if v-inform = ?
      772         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      773         or entry( 3, v-inform, ",":U ) <> "1":U
      774       then do:
      775         delete object bh_tbl-name no-error.
      776         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      777       end.
      778       assign
      779         v-idx-field-qnty = num-entries( v-inform ) - 4
      780       .
      781       if v-idx-field-qnty < 2 then do:
      782         delete object bh_tbl-name no-error.
      783         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      784       end.
      785       assign
      786         p-field-list = "":U
      787         p-value-list = "":U
      788         v-delim-key  = "":U
      789         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      790         v-count-fld  = 0
      791       .
      792       block_where:
      793       do v-ind = 1 to v-idx-field-qnty by 2
      794       on error undo, return error
      795       :
      796         assign
      797           v-count-fld = v-count-fld + 1
      798         .
      799         if v-count-fld > v-field-num then do:
      800           leave block_where.
      801         end.
      802         assign
      803           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      804           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      805         .
      806         if v-ind = 1 then do:
      807           assign
      808             v-delim-key = chr(3)
      809           .
      810         end.
      811       end.
      812       delete object bh_tbl-name.
      813       if v-count-fld <> v-field-num then do:
      814         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      815       end.
      816     end.
      817   end procedure.
      818   procedure gen-key-field :
      819     define input  parameter p-table      as character no-undo .
      820     define output parameter p-field-list as character no-undo .
      821     do
      822     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      823     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      824     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      825     :
      826       define variable v-full-tbl-name  as character no-undo .
      827       define variable bh_tbl-name      as handle    no-undo .
      828       define variable v-tbl-name       as character no-undo .
      829       define variable v-field-num      as integer   no-undo .
      830       define variable v-count-fld      as integer   no-undo .
      831       define variable v-inform         as character no-undo .
      832       define variable v-ind            as integer   no-undo .
      833       define variable v-idx-field-qnty as integer   no-undo .
      834       define variable v-delim-key      as character no-undo .
      835       if p-table = ?
      836         or p-table = "":U
      837       then do:
      838         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      839       end.
      840       assign
      841         v-tbl-name      = p-table
      842         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      843       .
      844       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      845       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      846       assign
      847         v-inform = bh_tbl-name:index-information(1)
      848         v-ind    = 2
      849       .
      850       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      851       on error undo, return error
      852       :
      853         assign
      854           v-inform = bh_tbl-name:index-information( v-ind )
      855           v-ind    = v-ind + 1
      856         .
      857       end.
      858       if v-inform = ?
      859         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      860         or entry( 3, v-inform, ",":U ) <> "1":U
      861       then do:
      862         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      863       end.
      864       assign
      865         v-idx-field-qnty = num-entries( v-inform ) - 4
      866       .
      867       if v-idx-field-qnty < 2 then do:
      868         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      869       end.
      870       assign
      871         p-field-list = "":U
      872         v-delim-key  = "":U
      873         v-count-fld  = 0
      874       .
      875       block_where:
      876       do v-ind = 1 to v-idx-field-qnty by 2
      877       on error undo, return error
      878       :
      879         assign
      880           v-count-fld = v-count-fld + 1
      881         .
      882         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      883         if v-ind = 1 then do:
      884           assign
      885             v-delim-key = chr(3)
      886           .
      887         end.
      888       end.
      889       delete object bh_tbl-name.
      890     end.
      891   end procedure.
      892   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   define variable c-point  as character no-undo .
      894   define variable tbl      as character no-undo .
      895   define variable join-tbl as character no-undo .
      896   define variable fld      as character no-undo .
      897   define variable lab      as character no-undo .
      898   define variable spr      as character no-undo .
      899   define variable dim      as character no-undo .
      900   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      901   procedure fltfield-clear :
      902     define output parameter loc-fld as character no-undo.
      903     define output parameter loc-lab as character no-undo .
      904     define output parameter loc-spr as character no-undo .
      905     define output parameter loc-dim as character no-undo .
      906     assign
      907       loc-fld = ""
      908       loc-lab = ""
      909       loc-spr = ""
      910       loc-dim = "0"
      911     .
      912   end procedure .
      913   procedure fltfield-add :
      914     define input        parameter par-fld as character no-undo.
      915     define input        parameter par-lab as character no-undo .
      916     define input        parameter par-spr as character no-undo .
      917     define input-output parameter loc-fld as character no-undo.
      918     define input-output parameter loc-lab as character no-undo .
      919     define input-output parameter loc-spr as character no-undo .
      920     define input-output parameter loc-dim as character no-undo .
      921     do
      922     on error undo, return error
      923     :
      924       assign
      925       loc-fld = if loc-dim = '0'
      926                 then par-fld
      927                 else (loc-fld + chr(44) + par-fld)
      928       loc-lab = if loc-dim = '0'
      929                 then par-lab
      930                 else (loc-lab + chr(44) + par-lab)
      931       loc-spr = if loc-dim = '0'
      932                 then par-spr
      933                 else (loc-spr + chr(44) + par-spr)
      934       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      935                 string(integer(if num-entries(loc-dim) > 1
      936                               then entry(2, loc-dim)
      937                               else entry(1, loc-dim)
      938                               ) + 1)
      939       no-error
      940       .
      941     end.
      942   end procedure.
      943   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   FUNCTION mark-string RETURNS CHARACTER
      945     ( input p-recid as recid, input mark-list as character  ) :
      946     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      947   END FUNCTION.
      948   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      950   procedure cur-time :
      951      define output parameter p-today as date      no-undo .
      952      define output parameter p-time  as integer   no-undo .
      953     do
      954     on error undo, return error
      955     :
      956       define variable v-date1 as date      no-undo .
      957       define variable v-date2 as date      no-undo .
      958       define variable v-time  as integer   no-undo .
      959       assign
      960         v-date1 = today
      961         v-time  = time
      962         v-date2 = today
      963       .
      964       if v-date1 <> v-date2
      965       then do:
      966         assign
      967           v-date1 = today
      968           v-time  = v-time
      969         .
      970       end.
      971       assign
      972         p-today = v-date1
      973         p-time  = v-time
      974       .
      975     end.
      976   end.
      977   function cur-time-date returns character
      978   :
      979     return string(today, '99/99/9999':U) .
      980   end.
      981   function cur-time-mjd returns decimal
      982   :
      983     define variable v-date as date      no-undo .
      984     define variable v-time as integer   no-undo .
      985     run cur-time in this-procedure
      986       (output v-date
      987       ,output v-time
      988       ) .
      989     return integer(v-date) - 2400002 + (v-time / 86400) .
      990   end.
      991   function cur-time-get-ending-index returns integer
      992   (input p-number as integer
      993   )
      994   :
      995     if p-number < 0
      996     or p-number = ?
      997     then do:
      998       return 1 .
      999     end.
     1000     define variable v-rest as integer   no-undo .
     1001     assign
     1002       p-number = p-number modulo 100
     1003     .
     1004     if p-number < 20
     1005     then do:
     1006       assign
     1007         v-rest = p-number
     1008       .
     1009     end.
     1010     else do:
     1011       assign
     1012         v-rest = p-number modulo 10
     1013       .
     1014     end.
     1015     case v-rest :
     1016       when 1
     1017       then do:
     1018         return 2 .
     1019       end.
     1020       when 2 or
     1021       when 3 or
     1022       when 4
     1023       then do:
     1024         return 3 .
     1025       end.
     1026       otherwise do:
     1027         return 1 .
     1028       end.
     1029     end case .
     1030   end.
     1031   procedure cur-time-mjd-to-date :
     1032      define input  parameter i-mjd-diff as decimal no-undo.
     1033      define output parameter o-Date     as date    no-undo.
     1034      define output parameter o-Time     as integer no-undo.
     1035      define variable v-day-number as integer   no-undo .
     1036      if    i-mjd-diff < 0
     1037         or i-mjd-diff = ?
     1038      then do:
     1039         return "?" .
     1040      end.
     1041      assign
     1042         v-day-number = truncate(i-mjd-diff,0).
     1043         o-Date = date(v-day-number + 2400002).
     1044         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1045     .
     1046   end.
     1047   function cur-time-mjd-to-string returns character
     1048   (input p-mjd-diff as decimal
     1049   )
     1050   :
     1051     define variable v-day-number as integer   no-undo .
     1052     define variable v-seconds    as integer   no-undo .
     1053     define variable v-hour       as integer   no-undo .
     1054     define variable v-min        as integer   no-undo .
     1055     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1056     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1057     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1058     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1059     if p-mjd-diff < 0
     1060     or p-mjd-diff = ?
     1061     then do:
     1062       return "?" .
     1063     end.
     1064     assign
     1065       v-day-number = integer(truncate(p-mjd-diff,0))
     1066       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1067     .
     1068     if v-seconds > 86400
     1069     then do:
     1070       assign
     1071         v-seconds = 86400 - 1
     1072       .
     1073     end.
     1074     if v-seconds < 0
     1075     then do:
     1076       assign
     1077         v-seconds = 0
     1078       .
     1079     end.
     1080     assign
     1081       v-hour = truncate(v-seconds / 3600, 0)
     1082     .
     1083     assign
     1084       v-seconds = v-seconds modulo 3600
     1085     .
     1086     assign
     1087       v-min = truncate(v-seconds / 60, 0)
     1088     .
     1089     assign
     1090       v-seconds = v-seconds modulo 60
     1091     .
     1092     return
     1093         (if v-day-number <> 0
     1094           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1095           else ""
     1096         )
     1097       + (if v-day-number <> 0 or v-hour <> 0
     1098           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1099           else ""
     1100         )
     1101       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1102           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1103           else ""
     1104         )
     1105       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1106       .
     1107   end.
     1108   function cur-time-string returns character
     1109   :
     1110     define variable v-date as date      no-undo .
     1111     define variable v-time as integer   no-undo .
     1112     run cur-time in this-procedure
     1113       (output v-date
     1114       ,output v-time
     1115       ) .
     1116     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1117   end.
     1118   function cur-time-string-sec returns character
     1119   :
     1120     define variable v-date as date      no-undo .
     1121     define variable v-time as integer   no-undo .
     1122     run cur-time in this-procedure
     1123       (output v-date
     1124       ,output v-time
     1125       ) .
     1126     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1127   end.
     1128   function cur-time-custom  returns character
     1129   (input p-prefix as character
     1130   ,input p-date-format as character
     1131   ,input p-delimiter as character
     1132   ,input p-time-format as character
     1133   ,input p-suffix as character
     1134   )
     1135   :
     1136     define variable v-date as date      no-undo .
     1137     define variable v-time as integer   no-undo .
     1138     run cur-time in this-procedure
     1139       (output v-date
     1140       ,output v-time
     1141       ) .
     1142     return
     1143       p-prefix
     1144       + string(v-date, p-date-format)
     1145       + p-delimiter
     1146       + string(v-time, p-time-format)
     1147       + p-suffix
     1148       .
     1149   end.
     1150   function cur-time-print  returns character
     1151   :
     1152     define variable v-date as date      no-undo .
     1153     define variable v-time as integer   no-undo .
     1154     run cur-time in this-procedure
     1155       (output v-date
     1156       ,output v-time
     1157       ) .
     1158     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1159   end.
     1160   function cur-time-datetime returns datetime
     1161   :
     1162     define variable v-char as character no-undo .
     1163     define variable v-datetime as datetime no-undo .
     1164     v-char = cur-time-string().
     1165     v-datetime = datetime(v-char).
     1166     return  v-datetime.
     1167   end.
     1168   function cur-time-string-msec returns character
     1169   :
     1170     define variable v-date as datetime  no-undo .
     1171     v-date = now.
     1172     return string(v-date) .
     1173   end.
