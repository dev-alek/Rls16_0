     2214   PROCEDURE enable_UI :
     2215     DISPLAY mark-num fill-in-code-system fill-in-code-th
     2216         WITH FRAME Dialog-Frame.
     2217     ENABLE b-quit B-mark B-sel b-add b-del b-cli b-esys b-sch b-print B-Help
     2218            br-esys-gds mark-num
     2219            fill-in-code-system fill-in-code-th
     2220         WITH FRAME Dialog-Frame.
     2221     VIEW FRAME Dialog-Frame.
     2222   END PROCEDURE.
     2223   PROCEDURE MyEnable :
     2224   ENABLE
     2225   b-quit
     2226   b-cli
     2227   b-print
     2228   B-mark when (lookup("b-mark", bttns) > 0 and not transaction)
     2229   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     2230   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     2231   b-esys
     2232   b-sch
     2233   b-sel when (lookup("b-sel", bttns) > 0 and not transaction)
     2234   B-Help
     2235   br-esys-gds
     2236   fill-in-code-system
     2237   fill-in-code-th
     2238   WITH FRAME Dialog-Frame.
     2239   VIEW FRAME Dialog-Frame.
     2240   END PROCEDURE.
     2241   PROCEDURE proc-b-add :
     2242           DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2243           define variable v-rid as recid no-undo .
     2244           DEFINE VARIABLE v-ok AS logical NO-UNDO.
     2245           define variable v-esys-id as integer no-undo .
     2246           define variable v-value-character as character no-undo init "".
     2247           define variable v-uniq-key-rec as character no-undo .
     2248           define variable v-esys-uniq-key-rec as character no-undo .
     2249           define variable v-tbl-row as rowid no-undo .
     2250           define variable v-tbl-name as character no-undo .
     2251           define buffer buf_goods for ub.goods.
     2252           define buffer buf_ext-system for ub.ext-system.
     2253           define variable cursorr  as integer no-undo init 0.
     2254           define variable v-list          as character no-undo.
     2255   run ref/code_system.w ( input  parparentproc  ,
     2256                           output v-rid  ).
     2257                                   if v-rid <> ? then do:
     2258                                     run ui-on in this-procedure.
     2259                                     reposition br-esys-gds-query to recid v-rid no-error .
     2260                                     apply "entry" to br-esys-gds in frame Dialog-Frame .
     2261                                   end.
     2262   END PROCEDURE.
     2263   PROCEDURE proc-b-del :
     2264           DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     2265           DEFINE VARIABLE glog AS logical NO-UNDO.
     2266           IF NOT AVAILABLE ext-classif THEN UNDO, RETURN ERROR.
     2267           v-rec = recid(ext-classif).
     2268           MESSAGE
     2269           "Вы действительно хотите удалить эту запись?"
     2270           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     2271           IF NOT glog THEN RETURN ERROR.
     2272           for each ext-classif-attr exclusive-lock where ext-classif-attr.classif-subject = ext-classif.classif-subject
     2273         and ext-classif-attr.classif-name = ext-classif.classif-name
     2274         and ext-classif-attr.db-num = ext-classif.db-num
     2275         and ext-classif-attr.Key#_One = ext-classif.key#_one
     2276         and ext-classif-attr.Key#_two = ext-classif.key#_two
     2277         and ext-classif-attr.Key#_three = ext-classif.key#_three
     2278         and ext-classif-attr.CharKey_One = ext-classif.charkey_one
     2279         and ext-classif-attr.CharKey_two = ext-classif.charkey_two
     2280         and ext-classif-attr.CharKey_three = ext-classif.charkey_three
     2281         and ext-classif-attr.nonunique = ext-classif.nonunique :
     2282           delete ext-classif-attr .
     2283       end.
     2284           run ref/extclas3.p ( INPUT NO
     2285                                                   ,INPUT v-rec) NO-ERROR.
     2286           if not error-status:error then do:
     2287               run ui-on in this-procedure.
     2288               reposition br-esys-gds-query to row 1 no-error .
     2289               apply "entry" to br-esys-gds in frame Dialog-Frame .
     2290           end.
     2291   END PROCEDURE.
     2292   PROCEDURE proc-b-print :
     2293       define buffer b-ext-classif for ub.ext-classif.
     2294       define variable cnter as integer no-undo init 0.
     2295       define variable xml_tmp as character no-undo.
     2296       define variable xslt-path as character no-undo.
     2297       define variable report as class ReportXml no-undo.
     2298       define variable rep-out-unit    as class rep-out no-undo.
     2299       define variable ckeythree as character no-undo init "".
     2300       xml_tmp = string(session:temp-directory + "extgds-tmp.xml").
     2301       report = new ReportXml(xml_tmp).
     2302       report:worksheet("Лист 1").
     2303       report:worksheet-header("start").
     2304       report:worksheet-header("Справочник соответствия товаров во внешней системе и TradeHouse.").
     2305       report:worksheet-header("Дата печати: " + string(cur-time-date())).
     2306       report:worksheet-header("end").
     2307       report:table-columns("80,120,80,140,400").
     2308       report:table-types = "String,String,String,String,String".
     2309       report:table-header("Внешняя система|Код внешней системы|Код товара|Код товара во внешней системе|Наименование товара","40","4").
     2310       for each b-ext-classif no-lock where b-ext-classif.classif-subject = 'goods':U and b-ext-classif.classif-name = 'exp-esys-gds-code':U by b-ext-classif.key#_two:
     2311           ckeythree = replace(b-ext-classif.charkey_three, "|", "\").
     2312           ckeythree = replace(ckeythree,"<","[").
     2313           ckeythree = replace(ckeythree,">","]").
     2314           ckeythree = replace(ckeythree,"","*").
     2315           report:table-row(   replace(get-esys-name (b-ext-classif.KEY#_two), "|", "/")
     2316               + "|" +       string(b-ext-classif.key#_two)
     2317               + "|" +       string(b-ext-classif.key#_one)
     2318               + "|" +       replace(b-ext-classif.charkey_one, "|", "/")
     2319               + "|" +       ckeythree
     2320           ).
     2321           cnter = cnter + 1.
     2322       end.
     2323       report:table-total("Итого|" + string(cnter) + "|||").
     2324       report:worksheet("end").
     2325       delete object report.
     2326       xslt-path = search("exe\template.xsl").
     2327       rep-out-unit = new rep-out ().
     2328       rep-out-unit:office(xml_tmp, xslt-path).
     2329   END PROCEDURE.
     2330   PROCEDURE proc-b-sch :
     2331       define variable v-ri as recid no-undo .
     2332       assign
     2333       v-ri = (if avail ext-classif then recid(ext-classif) else ?)
     2334       .
     2335       assign
     2336       tbl = 'ext-classif':U
     2337       join-tbl = 'ext-classif'
     2338       fld = ""
     2339       lab = ""
     2340       spr = ""
     2341       dim = '0'
     2342       .
     2343       run fltfield-add in this-procedure('key#_one', 'Код товара', '',
     2344       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2345       run fltfield-add in this-procedure('key#_two', 'Код внешней системы', '',
     2346       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2347       run fltfield-add in this-procedure('charkey_one', 'Код товара во внешней системе', '',
     2348       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2349       DO on stop undo, leave:
     2350           run gbl/filter.w ( INPUT parparentproc
     2351                            ,INPUT filter-point + chr(4) + filter-label
     2352                            ,INPUT tbl
     2353                            ,INPUT join-tbl
     2354                            ,INPUT fld
     2355                            ,INput lab
     2356                            ,INPUT spr
     2357                            ,INPUT  dim).
     2358           run ui-on in this-procedure.
     2359           if v-ri <> ? then do:
     2360             reposition br-esys-gds-query to recid v-ri no-error.
     2361           end.
     2362           APPLY "ENTRY" to br-esys-gds in frame Dialog-Frame .
     2363           APPLY "VALUE-CHANGED" to br-esys-gds.
     2364       END .
     2365   END PROCEDURE.
     2366   PROCEDURE reposition-goods :
     2367   define input  parameter p-direction   as character no-undo .
     2368   define output parameter p-recid as recid no-undo .
     2369   define buffer buf_ext for ub.ext-classif.
     2370   define buffer bgds      for ub.goods.
     2371   define query q-ext for buf_ext .
     2372   define variable v-rec as recid no-undo.
     2373   case p-direction :
     2374     when "first":U
     2375     then do:
     2376       for first buf_ext:
     2377           reposition br-esys-gds-query to recid recid(buf_ext).
     2378           for first ub.goods no-lock where goods.gds-code = ext-classif.key#_one:
     2379               p-recid = recid(goods).
     2380           end.
     2381      end.
     2382      end.
     2383     when "last":U
     2384     then do:
     2385           for first buf_ext:
     2386           reposition br-esys-gds-query to recid recid(buf_ext).
     2387           for first ub.goods no-lock where goods.gds-code = ext-classif.key#_one:
     2388               p-recid = recid(goods).
     2389           end.
     2390      end.
     2391     end.
     2392     when "prev":U
     2393     then do:
     2394       reposition br-esys-gds-query backwards 0.
     2395       if not available ext-classif then do:
     2396         message
     2397         "Это первый товар списка"
     2398         view-as alert-box.
     2399       end.
     2400       else
     2401           for first ub.goods no-lock where goods.gds-code = ext-classif.key#_one:
     2402               p-recid = recid(goods).
     2403           end.
     2404     end.
     2405     when "next":U
     2406     then do:
     2407      reposition br-esys-gds-query forwards 0.
     2408       if not available  ext-classif then do:
     2409         message
     2410         "Это последний товар списка"
     2411         view-as alert-box.
     2412       end.
     2413       else
     2414           for first ub.goods no-lock where goods.gds-code = ext-classif.key#_one:
     2415               p-recid = recid(goods).
     2416           end.
     2417     end.
     2418   end case .
     2419   END PROCEDURE.
     2420   function get-gds-name returns character
     2421    ( p-gds-code as integer ,
     2422      p-attr-code as integer):
     2423       define buffer bf_goods for ub.goods.
     2424       define buffer bf_code for ub.code.
     2425       find first bf_goods no-lock where bf_goods.gds-code = p-gds-code no-error.
     2426       if available bf_goods then
     2427       do:
     2428         if p-attr-code <> 0 then
     2429         do:
     2430           find first bf_code where
     2431                      bf_code.parent = "DTSeasons"
     2432                  and bf_code.code = string(p-attr-code)
     2433                no-lock no-error.
     2434         end.
     2435         return bf_goods.gds-name + if available bf_code then " : " + bf_code.codename else "".
     2436       end.
     2437       else return "".
     2438   end function.
