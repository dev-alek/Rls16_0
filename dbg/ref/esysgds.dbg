     2149             then  substitute('ext-classif.classif-subject = &1&2&1                           and ext-classif.classif-name = &1&4&1                           AND ext-classif.key#_two = &3', chr(34), 'goods':U, p-esys-id, 'exp-esys-gds-code':U) + " " + where-phrase-30
