      578   end procedure.
      579   define new global shared variable g#library  as handle no-undo .
      580   define new global shared variable g#library2 as handle no-undo .
      581   define variable var-report-r-b as character no-undo .
      582   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      584     (output var-report-r-b
      585     )  .
      586   do
      587   on error undo, return error return-value
      588   :
      589   find first ub.gds-obj where  ub.gds-obj.gds-code = p-gds-code and
      590                             ub.gds-obj.obj-type = p-obj-type and
      591                             ub.gds-obj.obj-code = p-obj-code
      592                             no-lock no-error .
      593   define variable t-date as date no-undo .
      594   if ub.gds-obj.first-doc <> ? then t-date = ub.gds-obj.first-doc.
      595      else t-date = today - 1.
      596   run rep/d-report.w ( input parParentProc ,
      597   input                   "r-iprt.p "    +
      598                                          "gds-code=" + string(p-gds-code) + ";"  +
      599                                          "b-code=" + string(p-bar-code)
      600                                            ,
      601   input                       "Обороты по признаку на объекте",
      602   input                        2,
      603   input                        "":U,
      604   input                        "2":U,
      605   input                        "",
      606   input                        "",
      607   input                        "all,1,X-DATE-START=" + string(t-date, "99/99/9999"),
      608   input                        yes).
      609   end.
