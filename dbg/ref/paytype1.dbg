        1   block-level on error undo, throw.
        2   define input-output parameter p-rid           as recid                  no-undo .
        3   define input        parameter p-mode          as character              no-undo .
        4   define input        parameter p-silent        as logical                no-undo .
        5   define input        parameter p-pay-type-code like ub.pay-type.obj-code no-undo .
        6   define input        parameter p-pay-type-name like ub.pay-type.obj-name no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: paytype1.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: ref/paytype1.p $":U .
       12   define variable vss-description as character no-undo init "Процедура изменения/сохранения вида оплаты".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   main-block:
       72   do
       73   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       74   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       75   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       76   :
       77     define buffer buf_pay-type  for ub.pay-type .
       78     define buffer buf1_pay-type for ub.pay-type .
       79     define variable v-mess as character no-undo .
       80     if p-mode =  'ДОБАВЛЕНИЕ':U
       81       and p-pay-type-code = 0
       82     then do:
       83       assign
       84         v-mess = substitute( "Код оплаты не может быть 0." )
       85       .
       86       run err-mess in this-procedure ( input-output v-mess ).
       87       undo main-block, return error (if p-silent = yes then v-mess else 'obj-code':U ).
       88     end.
       89     if p-pay-type-name = ""  then do:
       90       assign
       91         v-mess = substitute( "Наименование оплаты не может быть пустым." )
       92       .
       93       run err-mess in this-procedure ( input-output v-mess ).
       94       undo main-block, return error (if p-silent = yes then v-mess else 'obj-name':U ).
       95     end.
       96     find first buf1_pay-type no-lock
       97       where buf1_pay-type.obj-code = p-pay-type-code
       98         and recid( buf1_pay-type ) <> p-rid
       99       no-error .
      100     if available buf1_pay-type then do:
      101       assign
      102         v-mess = substitute( "Оплата с КОДОМ &1 уже существует!", p-pay-type-code )
      103       .
      104       run err-mess in this-procedure ( input-output v-mess ).
      105       undo main-block, return error (if p-silent = yes then v-mess else 'obj-code':U ).
      106     end.
      107     find first buf1_pay-type no-lock
      108       where buf1_pay-type.obj-name = p-pay-type-name
      109         and recid( buf1_pay-type ) <> p-rid
      110       no-error .
      111     if available buf1_pay-type then do:
      112       assign
      113         v-mess = substitute( 'Оплата с наименованием "&1" уже существует!', p-pay-type-name )
      114       .
      115       run err-mess in this-procedure ( input-output v-mess ).
      116       undo main-block, return error (if p-silent = yes then v-mess else 'obj-name':U ).
      117     end.
      118     if p-rid = ? then do:
      119       create buf_pay-type .
      120       assign
      121         p-rid = recid( buf_pay-type )
      122       .
      123     end.
      124     else do:
      125       find first buf_pay-type no-lock
      126         where recid( buf_pay-type ) = p-rid
      127         no-error .
      128       if not available buf_pay-type then do:
      129         assign
      130           v-mess = substitute( "Указанная оплата не найдена!" )
      131         .
      132         run err-mess in this-procedure ( input-output v-mess ).
      133         undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      134       end.
      135     end.
      136     assign
      137       buf_pay-type.obj-code = p-pay-type-code
      138       buf_pay-type.obj-name = p-pay-type-name
      139       .
      140     release buf_pay-type no-error .
      141     if error-status :error then do:
      142       assign
      143         v-mess = substitute( "Ошибка при сохранении записи ВИД ОПЛАТЫ.&1&2&1&3", chr(10), error-status:get-message(1), return-value )
      144       .
      145       run err-mess in this-procedure ( input-output v-mess ).
      146       undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      147     end.
      148   end.
      149   return '':U.
      150   procedure err-mess:
      151     define input-output parameter p-mess as character no-undo.
      152     case p-silent:
      153       when true then do:
      154         assign
      155           p-mess = substitute("Сохранение изменений в карточке вида оплаты&1Код &2&1Оплата &3&1&4"
      156                             , chr(10)
      157                             , p-pay-type-code
      158                             , p-pay-type-name
      159                             , p-mess
      160                             )
      161         .
      162       end.
      163       when false then do:
      164         message
      165           p-mess
      166           view-as alert-box error .
      167       end.
      168     end.
      169   end procedure.
