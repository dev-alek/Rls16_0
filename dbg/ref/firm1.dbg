       77       and v-vssrevis-logger :get-signature("logevent") <> ""
       78       then do:
       79         run vss-get-parameters in this-procedure
       80           (output v-vssrevis-parameters
       81           ).
       82         run logevent in v-vssrevis-logger
       83           (input vss-workfile
       84           ,input vss-revision
       85           ,input v-vssrevis-parameters
       86           ,input p-extra-paramters
       87           ).
       88       end.
       89     end.
       90   end procedure.
