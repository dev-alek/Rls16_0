       67   define new global shared variable g#vssrevis-logger as handle    no-undo .
       68   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       69   define variable v-vssrevis-logger                   as handle    no-undo .
       70   procedure vss-logevent :
       71     define input  parameter p-extra-paramters as character no-undo .
       72     define variable v-vssrevis-parameters as character no-undo .
