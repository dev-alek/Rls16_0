      118   FUNCTION calc-range RETURNS LOGICAL(
      119                                        input  my-db-num as integer
      120                                       ,input  my-code-src as integer
      121                                       ,input p-range-type as character
      122                                       ):
      123   define variable mycode as integer no-undo .
      124   mycode = abs(my-code-src).
      125   if mycode = 0 then return no.
      126   define buffer buf_code-range for ub.code-range.
      127   find first  buf_code-range no-lock where
      128           buf_code-range.db-num = my-db-num
      129       and buf_code-range.range-type = p-range-type
      130       and buf_code-range.stts = 'u'
      131       and buf_code-range.first-code <= mycode
      132       and buf_code-range.last-code >= mycode no-error .
      133   if available buf_code-range then return yes.
      134   find first buf_code-range no-lock where
      135           buf_code-range.db-num = my-db-num
      136       and buf_code-range.range-type = p-range-type
      137       and buf_code-range.stts = 'a':U
      138       and buf_code-range.first-code <= mycode no-error .
      139   if p-range-type = 'fmgb':U
      140   and available buf_code-range
      141   and (buf_code-range.stts = 'u'
      142       or
      143       mycode <  current-value(s-fmgb-code, ub)) then return yes.
      144   if p-range-type = 'pngb':U
      145   and available buf_code-range
      146   and (buf_code-range.stts = 'u'
      147       or
      148       mycode <  current-value(s-pngb-code, ub)) then return yes.
      149   if my-code-src < 0 then do:
      150     find first buf_code-range no-lock where
      151             buf_code-range.db-num = my-db-num
      152         and buf_code-range.range-type = p-range-type
      153         and buf_code-range.stts = 'f':U
      154         and buf_code-range.first-code <= mycode
      155         and buf_code-range.last-code >= mycode  no-error .
      156     if available buf_code-range then return yes.
      157   end.
      158     find first buf_code-range no-lock where
      159             buf_code-range.db-num = my-db-num
      160         and buf_code-range.range-type = p-range-type
      161         and buf_code-range.first-code <= mycode
      162         and buf_code-range.last-code >= mycode  no-error .
      163   if available buf_code-range then return no.
      164   return ?.
      165   END FUNCTION.
