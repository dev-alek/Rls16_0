      411     define input parameter p-obj-type like ub.clients.obj-type no-undo .
      412     define input parameter p-obj-code like ub.clients.obj-code no-undo .
      413     define input-output parameter p-value as character no-undo .
      414     define output parameter p-setted as logical no-undo .
      415     do
      416     on error undo, return error
      417     :
      418           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-requisite-alc-decl in g#attr-lib
      419         (input  p-obj-type
      420         ,input  p-obj-code
      421         ,input-output p-value
      422         ,output p-setted
      423         ) no-error .
      424       if error-status :error
      425       then do:
      426         undo, return error return-value .
      427       end.
      428     end.
      429   end procedure.
      430   procedure clntattr-manual-edit :
      431     define input  parameter p-code           as character no-undo .
      432     define output parameter p-section-num    as integer no-undo .
      433     do
      434     on error undo, return error
      435     :
      436           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-manual-edit in g#attr-lib
      437         (input  p-code
      438         ,output p-section-num
      439         ) no-error .
      440       if error-status :error
      441       then do:
      442         undo, return error return-value .
      443       end.
      444     end.
      445   end procedure.
      446   procedure clntattr-batch-edit :
      447     define input  parameter p-code           as character no-undo .
      448     define output parameter p-section-num    as integer no-undo .
      449     do
      450     on error undo, return error
      451     :
      452           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-batch-edit in g#attr-lib
      453         (input  p-code
      454         ,output p-section-num
      455         ) no-error .
      456       if error-status :error
      457       then do:
      458         undo, return error return-value .
      459       end.
      460     end.
      461   end procedure.
      462   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      463   procedure gen-b-code :
      464     define input  parameter type-code like ub.code-range.range-type no-undo .
      465     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      466     do
      467     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      468     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      469     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      470     :
      471       define buffer buf_thbj-attr     for ub.thbj-attr .
      472       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      473       define buffer buf_code-range for ub.code-range .
      474       define variable l-code         as   integer              no-undo .
      475       define variable v-db-num       like ub.db.db-num         no-undo .
      476       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      477       if type-code = 'sslc':U
      478       or type-code = 'ssgb':U
      479       then do:
      480         message
      481           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      482           "Обратитесь к администратору системы."
      483           view-as alert-box error .
      484         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      485       end.
      486       run trg/getpcode.p ( input  type-code
      487                      ,output cfg-param-code
      488                     ).
      489       run get-next-seq( input  type-code,
      490                         output l-code
      491                       ).
      492       find first buf_sys-ctrl no-lock.
      493       if type-code = 'sclc':U
      494       or type-code = 'pglc':U
      495       then do:
      496         assign
      497           v-db-num = 0
      498         .
      499       end.
      500       else do:
      501         assign
      502           v-db-num = buf_sys-ctrl.db-num
      503         .
      504       end.
      505       find first buf_code-range no-lock
      506         where buf_code-range.db-num     = v-db-num
      507           and buf_code-range.range-type = type-code
      508           and buf_code-range.stts       = "a"
      509         use-index stts
      510         no-error .
      511       if available buf_code-range
      512          and l-code <= buf_code-range.last-code
      513          and l-code >= buf_code-range.first-code then do:
      514         assign
      515           p-b-code = l-code
      516         .
      517       end.
      518       else do:
      519         if available buf_code-range
      520            and l-code < buf_code-range.last-code then do:
      521           message
      522             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      523             "Обратитесь к администратору системы."
      524             view-as alert-box error .
      525           undo, return error "sequence":U .
      526         end.
      527         do transaction
      528         on error undo, return error
      529         :
      530           find first buf_thbj-attr exclusive-lock
      531             where buf_thbj-attr.upper-prop-code = 'code-range':U
      532               and buf_thbj-attr.prop-code = cfg-param-code
      533               and buf_thbj-attr.obj-type   = 'БД':U
      534               and buf_thbj-attr.obj-code   = v-db-num
      535             no-error .
      536           if not available buf_thbj-attr then do:
      537             find first buf_thbj-attr exclusive-lock
      538               where buf_thbj-attr.upper-prop-code = 'code-range':U
      539                 and buf_thbj-attr.prop-code = cfg-param-code
      540                 and buf_thbj-attr.obj-type   = ''
      541                 and buf_thbj-attr.obj-code   = 0
      542               no-error .
      543             if not available buf_thbj-attr then do:
      544               if not locked buf_thbj-attr then do:
      545                 message
      546                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      547                   "Обратитесь к администратору системы."
      548                   view-as alert-box error .
      549               end.
      550               undo, return error "config":U .
      551             end.
      552           end.
      553           run get-next-seq( input type-code,
      554                             output l-code
      555                           ).
      556           find first buf_code-range
      557             where buf_code-range.db-num     = v-db-num
      558               and buf_code-range.range-type = type-code
      559               and buf_code-range.stts       = "a"
      560             use-index stts
      561             no-error .
      562           if available buf_code-range
      563           and l-code <= buf_code-range.last-code
      564           and l-code >= buf_code-range.first-code
      565           then do:
      566             assign
      567               p-b-code = l-code
      568             .
      569           end.
      570           else do:
      571             if available buf_code-range then do:
      572               assign
      573                 buf_code-range.stts = "u"
      574               .
      575             end.
      576             find first buf_code-range
      577               where buf_code-range.db-num     = v-db-num
      578                 and buf_code-range.range-type = type-code
      579                 and buf_code-range.stts       = "f"
      580               use-index stts
      581               no-error .
      582             if not available buf_code-range then do:
      583               message
      584                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      585                 "Обратитесь к администратору системы"
      586                 view-as alert-box error .
      587               undo, return error "code-range":U .
      588             end.
      589             assign
      590               buf_code-range.stts           = "a"
      591             .
      592             if buf_code-range.first-code = 1 then do:
      593               run set-seq-cr( input type-code,
      594                               input buf_code-range.first-code
      595                             ).
      596               assign
      597                 p-b-code = 1
      598               .
      599             end.
      600             else do:
      601               run set-seq-cr( input type-code,
      602                               input ( buf_code-range.first-code - 1 )
      603                             ).
      604               run get-next-seq( input type-code,
      605                                 output p-b-code
      606                               ).
      607             end.
      608           end.
      609         end.
      610       end.
      611     end.
      612   end procedure.
      613   procedure get-next-seq :
      614     define input  parameter type-code like ub.code-range.range-type no-undo .
      615     define output parameter next-seq  as   integer                  no-undo .
      616     do
      617     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      618     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      619     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      620     :
      621       case type-code:
      622         when 'bcgb':U then do:
      623           assign
      624             next-seq = next-value(s-bcgb-code, ub)
      625           .
      626         end.
      627         when 'scgb':U then do:
      628           assign
      629             next-seq = next-value(s-scgb-code, ub)
      630           .
      631         end.
      632         when 'sclc':U then do:
      633           assign
      634             next-seq = next-value(s-sclc-code, ub)
      635           .
      636         end.
      637         when 'pglc':U then do:
      638           assign
      639             next-seq = next-value(s-pglc-code, ub)
      640           .
      641         end.
      642         when 'dcgb':U then do:
      643           assign
      644             next-seq = next-value(s-dcgb-code, ub)
      645           .
      646         end.
      647         when 'ctgb':U then do:
      648           assign
      649             next-seq = next-value(s-ctgb-code, ub)
      650           .
      651         end.
      652         when 'drgb':U then do:
      653           assign
      654             next-seq = next-value(s-drgb-code, ub)
      655           .
      656         end.
      657         when 'fmgb':U then do:
      658           assign
      659             next-seq = next-value(s-fmgb-code, ub)
      660           .
      661         end.
      662         when 'pngb':U then do:
      663           assign
      664             next-seq = next-value(s-pngb-code, ub)
      665           .
      666         end.
      667         when 'cagb':U then do:
      668           assign
      669             next-seq = next-value(s-cagb-code, ub)
      670           .
      671         end.
      672         when 'fdgb':U then do:
      673           assign
      674             next-seq = next-value(s-fin-doc, ub)
      675           .
      676         end.
      677       end case.
      678     end.
      679   end procedure.
      680   procedure set-seq-cr :
      681     define input parameter type-code like ub.code-range.range-type no-undo .
      682     define input parameter set-val   like ub.code-range.first-code no-undo .
      683     do
      684     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      685     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      686     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      687     :
      688       case type-code:
      689         when 'bcgb':U then do:
      690           assign
      691             current-value(s-bcgb-code, ub) = set-val
      692           .
      693         end.
      694         when 'scgb':U then do:
      695           assign
      696             current-value(s-scgb-code, ub) = set-val
      697           .
      698         end.
      699         when 'sclc':U then do:
      700           assign
      701             current-value(s-sclc-code, ub) = set-val
      702           .
      703         end.
      704         when 'pglc':U then do:
      705           assign
      706             current-value(s-pglc-code, ub) = set-val
      707           .
      708         end.
      709         when 'dcgb':U then do:
      710           assign
      711             current-value(s-dcgb-code, ub) = set-val
      712           .
      713         end.
      714         when 'ctgb':U then do:
      715           assign
      716             current-value(s-ctgb-code, ub) = set-val
      717           .
      718         end.
      719         when 'drgb':U then do:
      720           assign
      721             current-value(s-drgb-code, ub) = set-val
      722           .
      723         end.
      724         when 'fmgb':U then do:
      725           assign
      726             current-value(s-fmgb-code, ub) = set-val
      727           .
      728         end.
      729         when 'pngb':U then do:
      730           assign
      731             current-value(s-pngb-code, ub) = set-val
      732           .
      733         end.
      734         when 'cagb':U then do:
      735           assign
      736             current-value(s-cagb-code, ub) = set-val
      737           .
      738         end.
      739         when 'fdgb':U then do:
      740           assign
      741             current-value(s-fin-doc, ub) = set-val
      742           .
      743         end.
      744       end case.
      745     end.
      746   end procedure.
      747   procedure new-bcod-gen-code-range :
      748     do
      749     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      750     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      751     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      752     :
      753       define input parameter p-db-num  like ub.db.db-num             no-undo .
      754       define input parameter type-code like ub.code-range.range-type no-undo .
      755       define buffer buf_code-range      for ub.code-range .
      756       define buffer last_code-range     for ub.code-range .
      757       define buffer last-1_code-range   for ub.code-range .
      758       define buffer last-2_code-range   for ub.code-range .
      759       define buffer last-3_code-range   for ub.code-range .
      760       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      761       define variable conf-par       as character no-undo .
      762       define variable par-type       as character no-undo .
      763       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      764       define variable v-cre-cdrg as logical   no-undo .
      765       define variable v-cre-str  as character no-undo .
      766       define variable v-cr1      as integer no-undo .
      767       define variable v-cr2      as integer no-undo .
      768       define variable v-cr3      as integer no-undo .
      769       define variable v-cmax     as integer no-undo .
      770       find first buf_sys-ctrl no-lock .
      771       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      772         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      773                                       ,vss-workfile
      774                                       ,vss-revision
      775                                       ,vss-description
      776                                       ,chr(10)
      777                                       , p-db-num
      778                                      ).
      779       end.
      780       run trg/getpcode.p ( input  type-code
      781                      ,output cfg-param-code
      782                     ).
      783       for each buf_code-range
      784         where buf_code-range.db-num     = -1
      785           and buf_code-range.range-type = type-code
      786           and buf_code-range.stts       = "f"
      787       by buf_code-range.first-code
      788       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      789       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      790       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      791       :
      792         assign
      793           buf_code-range.db-num = p-db-num
      794         .
      795         return .
      796       end.
      797       assign
      798         v-cre-cdrg = TRUE
      799       .
      800       case type-code:
      801         when 'sclc':U
      802         or when 'scgb':U
      803         or when 'pglc':U
      804         then do:
      805           find last last-1_code-range no-lock
      806             where last-1_code-range.range-type = 'sclc':U
      807             no-error .
      808           if available last-1_code-range then do:
      809             v-cr1 = last-1_code-range.last-code.
      810           end.
      811           find last last-2_code-range no-lock
      812             where last-2_code-range.range-type = 'scgb':U
      813             no-error .
      814           if available last-2_code-range then do:
      815             v-cr2 = last-2_code-range.last-code.
      816             end.
      817           find last last-3_code-range no-lock
      818             where last-3_code-range.range-type = 'pglc':U
      819             no-error .
      820           if available last-3_code-range then do:
      821             v-cr3 = last-3_code-range.last-code.
      822           end.
      823           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      824           .
      825           if v-cmax = v-cr1  then do:
      826               find last last_code-range no-lock
      827                 where recid( last_code-range ) = recid( last-1_code-range )
      828                 .
      829             end.
      830           if v-cmax = v-cr2  then do:
      831               find last last_code-range no-lock
      832                 where recid( last_code-range ) = recid( last-2_code-range )
      833                 .
      834             end.
      835           if v-cmax = v-cr3  then do:
      836             find last last_code-range no-lock
      837               where recid( last_code-range ) = recid( last-3_code-range )
      838               .
      839           end.
      840           if last_code-range.last-code + 1 > 99999 then do:
      841             assign
      842               v-cre-cdrg = FALSE
      843             .
      844           end.
      845         end.
      846         when 'bcgb':U
      847         or when 'sslc':U
      848         or when 'ssgb':U
      849         then do:
      850           find last last-1_code-range no-lock
      851             where last-1_code-range.range-type = 'sslc':U
      852             no-error .
      853           if available last-1_code-range then do:
      854             v-cr1 = last-1_code-range.last-code.
      855           end.
      856           find last last-2_code-range no-lock
      857             where last-2_code-range.range-type = 'bcgb':U
      858             no-error .
      859           if available last-2_code-range then do:
      860             v-cr2 = last-2_code-range.last-code.
      861             end.
      862           find last last-3_code-range no-lock
      863             where last-3_code-range.range-type = 'ssgb':U
      864             no-error .
      865           if available last-3_code-range then do:
      866             v-cr3 = last-3_code-range.last-code.
      867           end.
      868           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      869           .
      870           if v-cmax = v-cr1  then do:
      871               find last last_code-range no-lock
      872                 where recid( last_code-range ) = recid( last-1_code-range )
      873                 .
      874             end.
      875           if v-cmax = v-cr2  then do:
      876               find last last_code-range no-lock
      877                 where recid( last_code-range ) = recid( last-2_code-range )
      878                 .
      879             end.
      880           if v-cmax = v-cr3  then do:
      881             find last last_code-range no-lock
      882               where recid( last_code-range ) = recid( last-3_code-range )
      883               .
      884           end.
      885         end.
      886         otherwise do:
      887           find last last_code-range no-lock
      888             where last_code-range.range-type = type-code
      889             no-error .
      890         end.
      891       end case.
      892       if not available last_code-range then do:
      893         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      894                                       ,vss-workfile
      895                                       ,vss-revision
      896                                       ,vss-description
      897                                       , chr(10)
      898                                       , type-code
      899                                      ) .
      900       end.
      901       define variable v-mes2 as character no-undo .
      902       define variable v-param-type2 as character no-undo .
      903       define variable v-value-character2 as INTEGER no-undo .
      904       define variable v-value-date2 as date no-undo .
      905       define variable v-value-decimal2 as decimal no-undo .
      906       define variable v-value-integer2 AS integer no-undo .
      907       define variable v-value-logical2 AS LOGICAL no-undo .
      908       define variable v-tth2 as handle no-undo .
      909       run adm/shattri.p (
      910           input "get":U
      911           ,input  'БД':U
      912           ,input  p-db-num
      913           ,input  'code-range':U
      914           ,input  cfg-param-code
      915           ,output v-value-character2
      916           ,output v-value-date2
      917           ,output v-value-decimal2
      918           ,output v-value-integer2
      919           ,output v-value-logical2
      920           ,output v-param-type2
      921           ,INPUT-OUTPUT table-handle v-tth2
      922           ) no-error .
      923       if error-status :error then do:
      924         delete object v-tth2.
      925         v-mes2 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      926                            , error-status:get-message(1)
      927                            , chr(10)
      928                            , return-value ).
      929         undo, return error v-mes2.
      930       end.
      931       delete object v-tth2.
      932       if v-cre-cdrg = TRUE then do:
      933         create buf_code-range .
      934         assign
      935           buf_code-range.db-num     = p-db-num
      936           buf_code-range.range-type = type-code
      937           buf_code-range.stts       = "f"
      938           buf_code-range.first-code = last_code-range.last-code + 1
      939           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer2)
      940           v-cre-str = "Свободный диапазон успешно создан"
      941         .
      942       end.
      943       else do:
      944         assign
      945           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      946                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      947         .
      948       end.
      949     end.
      950     return v-cre-str .
      951   end procedure.
      952   procedure gen-new-code-range-if-neces :
      953     define input parameter v-db-num           like ub.db.db-num             no-undo .
      954     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      955     define input parameter v-cur-code         as   integer                  no-undo .
      956     define input parameter v-g#news           as   logical                  no-undo .
      957     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      958     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      959     do
      960     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      961     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      962     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      963     :
      964       define variable l-code-range-exist as logical   no-undo init false .
      965       define variable v-db-for-send      as character no-undo .
      966       define buffer buf_code-range  for ub.code-range .
      967       define buffer buf1_code-range for ub.code-range .
      968       define buffer buf_db          for ub.db .
      969       find first buf_code-range
      970         where buf_code-range.range-type = v-range-type
      971           and buf_code-range.last-code >= v-cur-code
      972         use-index last-codei
      973         no-error .
      974       if
      975       (
      976          available buf_code-range
      977          and
      978         (buf_code-range.db-num = v-db-num
      979           and
      980         buf_code-range.first-code <= v-cur-code
      981         )
      982       or
      983         (
      984           v-range-type = 'drgb':U
      985           AND
      986           v-cur-code = 0
      987         )
      988      )
      989      then do:
      990         assign
      991           l-code-range-exist = true
      992         .
      993         if v-g#news
      994         and buf_code-range.stts = "f" then do:
      995           assign
      996             buf_code-range.stts = "u"
      997           .
      998         end.
      999       end.
     1000       if not l-code-range-exist
     1001          and v-g#news-source-db <> 0
     1002       then do:
     1003         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1004                                       ,vss-workfile
     1005                                       ,vss-revision
     1006                                       ,vss-description
     1007                                       ,chr(10)
     1008                                       ,v-db-num
     1009                                       ,v-range-type
     1010                                       ,v-cur-code
     1011                                      ).
     1012       end.
     1013       if (not l-code-range-exist
     1014           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1015          )
     1016       and ( not can-find (first buf1_code-range no-lock
     1017                           where buf1_code-range.db-num = v-db-num
     1018                             and buf1_code-range.range-type = v-range-type
     1019                             and buf1_code-range.stts = "f"
     1020                          )
     1021           )
     1022       then do:
     1023         if v-g#db-num = 0 then do:
     1024           run new-bcod-gen-code-range in this-procedure
     1025             (input v-db-num,
     1026              input v-range-type
     1027             ) no-error .
     1028           if error-status :error then do:
     1029             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1030                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1031                                           ,v-db-num
     1032                                           ,v-range-type
     1033                                           ,v-cur-code
     1034                                           ,chr(10)
     1035                                           ,error-status:get-message(1)
     1036                                           ,return-value
     1037                                          ).
     1038           end.
     1039         end.
     1040         else do:
     1041           if v-range-type = 'sclc':U
     1042           or v-range-type = 'pglc':U
     1043           then do:
     1044             assign
     1045               v-db-for-send = "":U
     1046             .
     1047             if v-g#db-num = 0 then do:
     1048               for each buf_db no-lock
     1049                 where buf_db.db-num > 0
     1050                   and buf_db.db-num <> v-g#news-source-db
     1051               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1052               :
     1053                 assign
     1054                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1055                 .
     1056               end.
     1057               assign
     1058                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1059               .
     1060             end.
     1061             else do:
     1062               if not v-g#news then do:
     1063                 assign
     1064                   v-db-for-send = "0":U
     1065                 .
     1066               end.
     1067             end.
     1068             run nws/cr-route.p ( input 'send-cmd':U
     1069                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1070                                  "code-range":U + chr(1) +
     1071                                  (if v-range-type = 'sclc':U
     1072                                   then string( current-value(s-sclc-code, ub))
     1073                                   else string( current-value(s-pglc-code, ub))
     1074                                   ) + chr(1) +
     1075                                   v-range-type)
     1076                           ,input ?
     1077                           ,input v-db-for-send
     1078                           ) no-error .
     1079             if error-status :error then do:
     1080               undo, return error return-value.
     1081             end.
     1082           end.
     1083         end.
     1084       end.
     1085     end.
     1086   end procedure.
     1087   procedure cre-loc-sc-code-range :
     1088     define input parameter v-cur-code as integer no-undo .
     1089   define input parameter p-cdrg-type as character no-undo .
     1090     do
     1091     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1092     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1093     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1094     :
     1095       define buffer buf_code-range for ub.code-range .
     1096       find first buf_code-range
     1097            where buf_code-range.range-type = p-cdrg-type
     1098              and buf_code-range.first-code >= v-cur-code
     1099            no-error .
     1100       if not available buf_code-range then do:
     1101         run new-bcod-gen-code-range in this-procedure
     1102           ( input 0,
     1103             input p-cdrg-type
     1104           ) no-error .
     1105         if error-status :error then do:
     1106           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1107                                          + "Код &2&1&3 &4"
     1108                                         , chr(10)
     1109                                         , v-cur-code
     1110                                         , error-status:get-message(1)
     1111                                         , return-value
     1112                                        ) .
     1113         end.
     1114       end.
     1115     end.
     1116   end procedure.
     1117   procedure mark-used-if-need :
     1118   define input parameter p-cur-code as integer no-undo .
     1119   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1120   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1121     do
     1122     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1123     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1124     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1125     :
     1126       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1127       define buffer buf_code-range for ub.code-range .
     1128       assign
     1129       v-db-num = if p-range-type = 'sclc':U
     1130                  then 0
     1131                  else p-db-num
     1132       .
     1133   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1134   define buffer locK-batchprocess3 for ub.batchprocess.
     1135   run gbl/lock-prc.p
     1136       (input 'lscc':U
     1137       ,input 0
     1138       ,input 0
     1139       ,input 0
     1140       ,input ""
     1141       ,input ""
     1142       ,input ""
     1143       ,input (
     1144               ",,,Вкл/выкл лок. вес. кодов"
     1145              )
     1146       ,input true
     1147       ,buffer lock-batchprocess3
     1148       ) no-error .
     1149     if error-status :error then do:
     1150       message
     1151         vss-workfile vss-revision vss-description skip
     1152         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1153         view-as alert-box error .
     1154       undo, return error .
     1155     end.
     1156       find first buf_code-range
     1157            where buf_code-range.range-type = p-range-type
     1158              and buf_code-range.first-code >= p-cur-code
     1159              and buf_code-range.last-code <= p-cur-code
     1160              and buf_code-range.db-num = v-db-num
     1161            no-error .
     1162       if not available buf_code-range then do:
     1163         message
     1164           vss-workfile vss-revision vss-description skip
     1165           "Ошибка при создании поиске диапазона" skip
     1166           "База данных" p-db-num skip
     1167           "Код" p-cur-code skip
     1168           "Тип" p-range-type
     1169           error-status :get-message(1) skip
     1170           return-value skip
     1171           view-as alert-box error .
     1172         undo, return error .
     1173       end.
     1174       if buf_code-range.stts = "f":U then do:
     1175         assign
     1176         buf_code-range.stts = "u":U
     1177         .
     1178       end.
     1179     end.
     1180   end procedure.
     1181   if p-mode <> 'ДОБАВЛЕНИЕ':U
     1182   AND p-mode <> 'ИЗМЕНЕНИЕ':U
     1183   and p-mode <> 'ДОБАВЛЕНИЕ-ИМПОРТ':U
     1184   then do:
     1185     message
     1186     vss-workfile vss-revision vss-description skip
     1187     "Неверный параметр p-mode" p-mode
     1188     view-as alert-box error .
     1189     return error '':u.
     1190   end.
     1191   if p-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then do:
     1192     assign
     1193     p-mode = 'ДОБАВЛЕНИЕ':U
     1194     v-import = yes
     1195     .
     1196   end.
     1197   if p-callpoint <> "discards":U
     1198   and p-callpoint <> "cli-all":U
     1199   and p-callpoint <> "":U
     1200   then do:
     1201       message
     1202       vss-workfile vss-revision vss-description skip
     1203       "Неверное значение параметров вызова p-callpoint"  p-callpoint
     1204       view-as alert-box ERROR.
     1205       undo, return error.
     1206   end.
     1207   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1208   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1209     (output v-db-num
     1210     )  .
     1211   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1212     RUN chk-code in this-procedure ( output v-is-correct) no-error.
     1213     if error-status:error THEN do:
     1214       assign
     1215       v-err-mess = substitute("Ошибка при проверке кода организации &1&2&3"
     1216                               , p-firm-code
     1217                               , chr(10)
     1218                               , return-value ).
     1219       run err-mess in this-procedure ( input-output v-err-mess).
     1220       undo, return error (if p-silent then v-err-mess else (if return-value = "":U then "firm-code":U else return-value)).
     1221     end.
     1222     if not v-is-correct then do:
     1223       undo, return error (if p-silent then v-err-mess else (if return-value = "":U then "firm-code":U else return-value)).
     1224     end.
     1225     p-firm-code = abs(p-firm-code).
     1226   end.
     1227   RUN chk-name in this-procedure ( p-firm-code, output v-is-correct) no-error.
     1228   if error-status:error THEN do:
     1229     assign
     1230     v-err-mess = substitute("Ошибка при проверке названия организации &1", p-obj-name)
     1231     .
     1232     run err-mess in this-procedure ( input-output  v-err-mess ).
     1233     undo, return error (if p-silent then v-err-mess else "obj-name":U).
     1234   end.
     1235   if not v-is-correct then do:
     1236     undo, return error (if p-silent then v-err-mess else "obj-name":U).
     1237   end.
     1238   find first buf_cli-grp no-lock where
     1239             buf_cli-grp.node-code = p-grp-code no-error .
     1240   if not avail buf_cli-grp then do:
     1241     assign
     1242     v-err-mess = substitute("Неверный код группы клиента &1", p-grp-code) .
     1243     run err-mess in this-procedure ( input-output v-err-mess ).
     1244     undo, return error v-err-mess.
     1245   end.
     1246   if can-find(first ub.cli-grp no-lock where
     1247                       ub.cli-grp.upper-code = p-grp-code) then do:
     1248     v-err-mess = "Клиент может быть привязан только к терминальной группе".
     1249     run err-mess in this-procedure ( input-output v-err-mess).
     1250     undo, return error (if p-silent then v-err-mess else "":U).
     1251   end.
     1252   if p-inn <> "":U and not p-no-check-inn then do:
     1253     run gbl/keyinn.p ( input p-inn, input 'орг':U, input p-firm-code, input p-is-pboul, output v-correct-inn) no-error .
     1254     if error-status:error or not v-correct-inn then do:
     1255       assign
     1256       v-err-mess = substitute("Неверный ИНН &1: &2", p-inn, return-value).
     1257       run err-mess in this-procedure ( input-output v-err-mess ).
     1258       return error (if p-silent then v-err-mess else "inn":U).
     1259     end.
     1260   end.
     1261   if p-reg-code <> 0  then do:
     1262     find first buf_regions no-lock where
     1263               buf_regions.reg-code = p-reg-code no-error.
     1264     if not available buf_regions then do:
     1265       assign
     1266       v-err-mess = substitute("Неверный код региона &1", p-reg-code).
     1267       run err-mess ( input-output v-err-mess ).
     1268       return error ( if p-silent then v-err-mess else "reg-code":U).
     1269     end.
     1270   end.
     1271   define variable v-int as integer no-undo .
     1272   if p-passp-num <> "":U then do:
     1273     assign
     1274     v-int = integer(p-passp-num)
     1275     no-error .
     1276     if error-status:error
     1277     or v-int = ?
     1278     or trim(p-passp-num, "0123456789") <> '':U
     1279     then do:
     1280       assign
     1281       v-err-mess = substitute("Неверный № паспорта &1: &2", p-passp-num, return-value).
     1282       run err-mess ( input-output v-err-mess ).
     1283       return error ( if p-silent then v-err-mess else "passp-num":U).
     1284     end.
     1285   end.
     1286   if p-tobj-code > 0 then do:
     1287     IF NOT can-find(first ub.clients where
     1288                          ub.clients.obj-type = 'чел':U
     1289                      and ub.clients.obj-code = p-tobj-code) then do:
     1290       assign
     1291       v-err-mess = substitute("Значение поля <<КОД ТОРГОВОГО ПРЕДСТАВИТЕЛЯ>>&1должно соответствовать имеющемуся в системе клиенту типа <<&2>>"
     1292                             ,chr(10)
     1293                           ,'чел':U).
     1294       run err-mess ( input-output v-err-mess ).
     1295       return error ( if p-silent then v-err-mess else "tobj-code":U).
     1296     END.
     1297   end.
     1298   main-block:
     1299   DO for buf_clients
     1300         ,buf_firm
     1301   ON ERROR undo main-block, RETURN ERROR
     1302   ON STOP undo main-block, RETURN ERROR :
     1303     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1304       if available buf_clients then release buf_clients.
     1305       create buf_clients.
     1306       assign
     1307       buf_clients.obj-type = 'орг':U
     1308       buf_clients.obj-code = p-firm-code
     1309       buf_clients.obj-name = p-obj-name
     1310       buf_clients.stts     = p-stts
     1311       buf_clients.grp-code = p-grp-code
     1312       .
     1313       create buf_firm.
     1314       assign
     1315       buf_firm.firm-code =  p-firm-code
     1316       .
     1317       assign
     1318       p-rid = recid(buf_clients)
     1319       .
     1320     end.
     1321     else do:
     1322       FIND FIRST buf_clients where
     1323                 recid(buf_clients) = p-rid No-ERROR.
     1324       if not available buf_clients then do:
     1325         message
     1326         vss-workfile vss-revision vss-description skip
     1327         "Не найдена запись КЛИЕНТ - p-rid" p-rid
     1328         view-as alert-box error .
     1329         undo main-block, return error '':u.
     1330       end.
     1331       if buf_clients.obj-type <>  'орг':U
     1332       OR buf_clients.obj-code <> p-firm-code then do:
     1333         message
     1334         vss-workfile vss-revision vss-description skip
     1335         "Для уже имеющейся записи нельзя изменить"
     1336         "тип и код клиента" skip
     1337         view-as alert-box ERROR.
     1338         undo main-block, return error '':U.
     1339       end.
     1340       FIND FIRST buf_firm where
     1341                 buf_firm.firm-code = p-firm-code No-ERROR.
     1342       if not available buf_firm then do:
     1343         message
     1344         vss-workfile vss-revision vss-description skip
     1345         "Не найдена запись ОРГАНИЗАЦИЯ - p-firm-code" p-firm-code
     1346         view-as alert-box error .
     1347         undo main-block, return error '':u.
     1348       end.
     1349     end.
     1350     assign
     1351     v-new-inn = p-inn.
     1352     run trg/inn-uniq.p (
     1353                      input-output v-new-inn
     1354                     ,input (if p-mode = 'ДОБАВЛЕНИЕ':U then p-inn else buf_firm.inn)
     1355                     ,input 'орг':U
     1356                     ,input buf_firm.firm-code
     1357                     ,input p-silent
     1358                     ,input recid(buf_firm)
     1359                     ,input buffer buf_firm:handle
     1360                     ,output v-inn-uniq-error
     1361                     ) no-error.
     1362     if error-status:error then do:
     1363       v-err-mess = substitute("Ошибка при проверке ИНН на уникальность&1&2&1&3"
     1364                               , chr(10)
     1365                               , error-status:get-message(1)
     1366                               , return-value) .
     1367       run err-mess in this-procedure ( input-output v-err-mess ).
     1368       undo, return error (if p-silent then v-err-mess else "inn-uniq":U).
     1369     end.
     1370     if v-inn-uniq-error then do:
     1371       v-err-mess = return-value .
     1372       if v-err-mess = 'inn-uniq-no-message' then do:
     1373         v-err-mess = 'inn-uniq'.
     1374       end.
     1375       else do:
     1376         run err-mess in this-procedure ( input-output v-err-mess ).
     1377       end.
     1378       undo, return error (if p-silent then v-err-mess else "inn-uniq":U).
     1379     end.
     1380     assign
     1381     buf_clients.obj-name    =  p-obj-name
     1382     buf_clients.lim-kr      =  p-lim-kr
     1383     buf_clients.PS          =  p-PS
     1384     buf_clients.grp-code    =  p-grp-code
     1385     buf_firm.addres1        =  p-addres1
     1386     buf_firm.addres2        =  p-addres2
     1387     buf_firm.city           =  p-city
     1388     buf_firm.contact-psn    =  p-contact-psn
     1389     buf_firm.director       =  p-director
     1390     buf_firm.e-mail         =  p-e-mail
     1391     buf_firm.engl-name      =  p-engl-name
     1392     buf_firm.fax            =  p-fax
     1393     buf_firm.given-by       =  p-given-by
     1394     buf_firm.ind            =  p-ind
     1395     buf_firm.inn            =  p-inn
     1396     buf_firm.is-pboul       =  p-is-pboul
     1397     buf_firm.kpp            =  p-kpp
     1398     buf_firm.okonh          =  p-okonh
     1399     buf_firm.okpo           =  p-okpo
     1400     buf_firm.passp-num      =  p-passp-num
     1401     buf_firm.passp-ser      =  p-passp-ser
     1402     buf_firm.phone          =  p-phone
     1403     buf_firm.phone1-note    =  p-phone1-note
     1404     buf_firm.post-addr1     =  p-post-addr1
     1405     buf_firm.post-addr2     =  p-post-addr2
     1406     buf_firm.post-city      =  p-post-city
     1407     buf_firm.post-ind       =  p-post-ind
     1408     buf_clients.reg-code    =  p-reg-code
     1409     buf_firm.telex          =  p-telex
     1410     buf_firm.tobj-code      =  p-tobj-code
     1411     buf_clients.turnover-buyer     = p-turnover-buyer
     1412     buf_clients.turnover-buyer-gds = p-turnover-buyer-gds
     1413     buf_clients.trg-param   =    (if v-import
     1414                                  and p-callpoint = "discards"
     1415                                  then 'no-callnews':U
     1416                                  else '':U)
     1417     buf_firm.trg-param      =    (if v-import
     1418                                  and p-callpoint = "discards"
     1419                                  then 'no-callnews':U
     1420                                  else '':U)
     1421     .
     1422     release buf_clients no-error.
     1423     if error-status:error then do:
     1424       message
     1425       vss-workfile vss-revision vss-description skip
     1426       "Ошибка при сохранении записи КЛИЕНТА" skip
     1427       ERROR-STATUS:GET-NUMBER(1) skip
     1428       return-value
     1429       view-as alert-box .
     1430       undo main-block, return error "":U.
     1431     end.
     1432     release buf_firm no-error.
     1433     if error-status:error then do:
     1434       message
     1435       vss-workfile vss-revision vss-description skip
     1436       "Ошибка при сохранении записи ОРГАНИЗАЦИИ" skip
     1437       ERROR-STATUS:GET-NUMBER(1) skip
     1438       return-value
     1439       view-as alert-box .
     1440       undo main-block, return error "":U.
     1441     end.
     1442   end.
     1443   procedure chk-code :
     1444   define output parameter p-is-correct as logical no-undo .
     1445   define variable v-rid as recid no-undo .
     1446   define variable maindb-begin-code as integer no-undo.
     1447   define variable maindb-end-code as integer no-undo.
     1448   define variable currentdb-begin-code as integer no-undo.
     1449   define variable currentdb-end-code as integer no-undo.
     1450   define variable glog as logical no-undo .
     1451   define variable v-result as logical no-undo .
     1452   define buffer buf_clients for ub.clients.
     1453   define buffer buf_person for ub.person.
     1454   do
     1455   on error undo, return error return-value
     1456   :
     1457    if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1458       if p-firm-code = 0 then do:
     1459         run gen-b-code in this-procedure ( input 'fmgb':U, output p-firm-code) no-error .
     1460         if error-status:error then do:
     1461           assign
     1462           v-err-mess = substitute("Ошибка при получении кода организации для нового контрагента&1&2&1&3"
     1463                                   , chr(10)
     1464                                   , error-status:get-message(1)
     1465                                   , return-value ).
     1466           run err-mess in this-procedure ( input-output v-err-mess ).
     1467           undo, return  error (if p-silent then v-err-mess else "firm-code":U).
     1468         end.
     1469       end.
     1470       else do:
     1471         assign
     1472         v-result = calc-range(
     1473                            input v-db-num
     1474                           ,input p-firm-code
     1475                           ,input 'fmgb':U
     1476                           )
     1477         no-error .
     1478         if v-result = ?  then  do:
     1479             assign
     1480             v-err-mess = substitute("Не найден диапапазон контрагентов для кода контрагента &1 в БД &2", p-firm-code, v-db-num).
     1481             run err-mess in this-procedure ( input-output v-err-mess ).
     1482             undo, return  error (if p-silent then v-err-mess else "psn-code":U).
     1483         end.
     1484         if v-result = no  and v-import = no then  do:
     1485           assign
     1486           v-err-mess = substitute("Вы не можете САМОСТОЯТЕЛЬНО определить код НОВОЙ организации = &1", p-firm-code).
     1487           run err-mess in this-procedure ( input-output v-err-mess ).
     1488           undo, return  error (if p-silent then v-err-mess else "firm-code":U).
     1489         end.
     1490       end.
     1491       if p-firm-code = 0 then  do:
     1492         assign
     1493         v-err-mess = "Код организации не может быть равен 0".
     1494         run err-mess in this-procedure (input-output v-err-mess).
     1495         undo, return error (if p-silent then v-err-mess else "":U).
     1496       end.
     1497       if can-find( first ub.firm where
     1498                         ub.firm.firm-code = p-firm-code ) then do:
     1499         assign
     1500         v-err-mess =  substitute("Организация с кодом &1 уже есть", p-firm-code).
     1501         run err-mess in this-procedure ( input-output v-err-mess).
     1502         undo, return error (if p-silent then v-err-mess else "firm-code":U).
     1503       end.
     1504     end.
     1505     assign
     1506     p-is-correct = yes
     1507     .
     1508   end.
     1509   end procedure.
     1510   procedure chk-name :
     1511   DEFINE INPUT PARAMETER p-firm-code like ub.firm.firm-code no-undo.
     1512   define output parameter p-is-correct as logical no-undo .
     1513   define variable int-buf as integer no-undo .
     1514   DEFINE buffer buf_firm for ub.firm.
     1515     do
     1516     on error undo, return error return-value
     1517     :
     1518       if p-obj-name  = "" then do:
     1519         assign
     1520         v-err-mess = "Нет названия".
     1521         run err-mess in this-procedure  ( input-output v-err-mess ).
     1522         undo, return error (if p-silent then v-err-mess else "obj-name":U).
     1523       end.
     1524       assign
     1525       p-is-correct = yes
     1526       .
     1527     end.
     1528   end procedure.
     1529   PROCEDURE err-mess:
     1530     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     1531     CASE p-silent:
     1532       when yes then do:
     1533         p-mess = substitute("Клиент орг&1: &2", p-firm-code,  p-mess).
     1534       end.
     1535       otherwise do:
     1536         message
     1537         p-mess
     1538         view-as alert-box error .
     1539       end.
     1540     end.
     1541   END PROCEDURE.
