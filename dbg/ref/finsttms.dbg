      955   procedure uf-get :
      956     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      957     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      958     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      959     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      960     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      961     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      962     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      963     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      964     do
      965     on error undo, return error
      966     :
      967       define buffer buf_usr-flt for ubflt.usr-flt .
      968       define variable v-use-List_     as logical   no-undo .
      969       define variable v-type-List_     as character no-undo .
      970       define variable v-format-List_   as character no-undo .
      971       define variable v-use-Naim      as logical   no-undo .
      972       define variable v-type-Naim      as character no-undo .
      973       define variable v-format-Naim    as character no-undo .
      974       define variable v-use-print-graft as logical   no-undo .
      975       define variable v-use-sort-gr     as logical   no-undo .
      976       define variable v-use-type-price  as logical   no-undo .
      977       define variable v-use-type-val    as logical   no-undo .
      978       define variable v-label          as character no-undo .
      979       define variable v-tooltip        as character no-undo .
      980       define variable v-user-can-edit  as logical   no-undo .
      981       define variable v-output-display as logical   no-undo .
      982       define variable v-other          as character no-undo .
      983       run uf-name in this-procedure
      984          (input  entry(1, p-code, chr(4))
      985         ,output v-use-List_
      986         ,output v-type-List_
      987         ,output v-format-List_
      988         ,output v-use-Naim
      989         ,output v-type-Naim
      990         ,output v-format-Naim
      991         ,output v-use-print-graft
      992         ,output v-use-sort-gr
      993         ,output v-use-type-price
      994         ,output v-use-type-val
      995         ,output v-label
      996         ,output v-tooltip
      997         ,output v-user-can-edit
      998         ,output v-output-display
      999         ,output v-other
     1000         ) no-error .
     1001       if error-status :error then do:
     1002         undo, return error return-value .
     1003       end.
     1004       find first buf_usr-flt no-lock where
     1005                  buf_usr-flt.Call-point     = p-code AND
     1006                  buf_usr-flt.user-name       = p-user-name
     1007         no-error .
     1008       if avail buf_usr-flt then do:
     1009         assign
     1010         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1011         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1012         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1013         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1014         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1015         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1016         .
     1017       end.
     1018       else do:
     1019         assign
     1020         p-List_        = (if v-use-List_       then "":U                    else ?)
     1021         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1022         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1023         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1024         p-type-price   = (if v-use-type-price  then no                      else ?)
     1025         p-type-val     = (if v-use-List_       then no                      else ?)
     1026         .
     1027       end.
     1028     end.
     1029   end procedure.
     1030   procedure uf-set :
     1031     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1032     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1033     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1034     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1035     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1036     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1037     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1038     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1039     do
     1040     on error undo, return error
     1041     :
     1042       define buffer buf_usr-flt for ubflt.usr-flt .
     1043       define variable v-use-List_     as logical   no-undo .
     1044       define variable v-type-List_     as character no-undo .
     1045       define variable v-format-List_   as character no-undo .
     1046       define variable v-use-Naim      as logical   no-undo .
     1047       define variable v-type-Naim      as character no-undo .
     1048       define variable v-format-Naim    as character no-undo .
     1049       define variable v-use-print-graft as logical   no-undo .
     1050       define variable v-use-sort-gr   as logical   no-undo .
     1051       define variable v-use-type-price as logical   no-undo .
     1052       define variable v-use-type-val  as logical   no-undo .
     1053       define variable v-tooltip        as character no-undo .
     1054       define variable v-label          as character no-undo .
     1055       define variable v-user-can-edit  as logical   no-undo .
     1056       define variable v-output-display as logical   no-undo .
     1057       define variable v-other          as character no-undo .
     1058       run uf-name in this-procedure
     1059         (input  entry(1, p-code, chr(4))
     1060         ,output v-use-List_
     1061         ,output v-type-List_
     1062         ,output v-format-List_
     1063         ,output v-use-Naim
     1064         ,output v-type-Naim
     1065         ,output v-format-Naim
     1066         ,output v-use-print-graft
     1067         ,output v-use-sort-gr
     1068         ,output v-use-type-price
     1069         ,output v-use-type-val
     1070         ,output v-label
     1071         ,output v-tooltip
     1072         ,output v-user-can-edit
     1073         ,output v-output-display
     1074         ,output v-other
     1075         ) no-error .
     1076       if error-status :error then do:
     1077         undo, return error return-value .
     1078       end.
     1079       find first buf_usr-flt where
     1080                  buf_usr-flt.Call-point     = p-code AND
     1081                  buf_usr-flt.user-name       = p-user-name
     1082         no-error .
     1083       if not avail buf_usr-flt then do:
     1084           create buf_usr-flt .
     1085           assign
     1086           buf_usr-flt.call-point = p-code
     1087           buf_usr-flt.user-name  = p-user-name
     1088           .
     1089       end.
     1090       if avail buf_usr-flt then do:
     1091        assign
     1092        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1093        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1094        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1095        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1096        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1097        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1098       .
     1099       release buf_usr-flt.
     1100       end.
     1101       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1102     end.
     1103   end procedure.
     1104   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105     define variable v-cntxt-db-num        as integer   no-undo .
     1106     define variable v-cntxt-userid        as character no-undo .
     1107     define variable v-cntxt-level         as character no-undo .
     1108     define variable v-cntxt-host-code-obj as integer   no-undo .
     1109     define variable v-cntxt-obj-type      as character no-undo .
     1110     define variable v-cntxt-obj-code      as integer   no-undo .
     1111     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1112     define variable v-cntxt-is-admin      as logical   no-undo .
     1113   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1114   FUNCTION mark-string RETURNS CHARACTER
     1115     ( input p-recid as recid, input mark-list as character  ) :
     1116     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1117   END FUNCTION.
     1118   FUNCTION uf-convert-mode returns character(
     1119                                           input p-mode as character):
     1120   CASE p-mode:
     1121   when 'все':U
     1122   or
     1123   when "currency":U
     1124   or
     1125   when "code-schet":U
     1126   or
     1127   when "code-bank":U
     1128   then do:
     1129   return p-mode.
     1130   end.
     1131   when "type":U
     1132   or
     1133   when "type-date":U
     1134   then do:
     1135   return (p-mode + chr(4) + p-fins-doc-type).
     1136   end.
     1137   when "ext-type":U
     1138   or
     1139   when "ext-type-date":U
     1140   then do:
     1141   return (p-mode + chr(4) + p-fins-ext-doc-type).
     1142   end.
     1143   when "type-stat":U
     1144   or
     1145   when "type-stat-date":U
     1146   then do:
     1147     return (p-mode + chr(4) + p-fins-doc-type + p-status_).
     1148   end.
     1149   when "ext-type-stat":U
     1150   or
     1151   when "ext-type-stat-start":U
     1152   or
     1153   when "ext-type-stat-end":U
     1154   or
     1155   when "ext-type-stat-date":U
     1156   then do:
     1157   return (p-mode + chr(4) + p-fins-ext-doc-type + p-status_).
     1158   end.
     1159   when 'фирма':U then do:
     1160   return (p-mode + chr(4) + string(p-host-code)).
     1161   end.
     1162   END CASE.
     1163   END FUNCTION.
