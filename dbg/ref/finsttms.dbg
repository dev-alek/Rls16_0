     3081   def var sort-labelbr-fin-statement   as character no-undo .
     3082   def var sort-clmnbr-fin-statement    as handle    no-undo .
     3083   def var cur-clmnbr-fin-statement     as handle    no-undo .
     3084   def var cur-clmn-locbr-fin-statement as integer   no-undo .
     3085   def var re-querybr-fin-statement     as logical   initial no no-undo .
     3086   on start-search, ctrl-o of br-fin-statement in frame Dialog-Frame do:
     3087      run sort-brbr-fin-statement
     3088        (input (if available X_fin-statement
     3089                then recid(X_fin-statement)
     3090                else ?
     3091               )
     3092        ).
     3093   end.
     3094   PROCEDURE sort-brbr-fin-statement :
     3095     define input parameter p-recid as recid no-undo .
     3096     if re-querybr-fin-statement = no then do:
     3097       assign
     3098          cur-clmnbr-fin-statement = br-fin-statement:current-column in frame Dialog-Frame
     3099       .
     3100       if sort-clmnbr-fin-statement <> ? then sort-clmnbr-fin-statement:column-fgcolor = 0.
     3101       if cur-clmnbr-fin-statement = sort-clmnbr-fin-statement then do:
     3102         assign
     3103            sort-labelbr-fin-statement = ""
     3104            sort-clmnbr-fin-statement = ?
     3105         .
     3106        end.
     3107        else do:
     3108          assign
     3109            sort-labelbr-fin-statement = cur-clmnbr-fin-statement:label
     3110            sort-clmnbr-fin-statement  = cur-clmnbr-fin-statement
     3111            sort-clmnbr-fin-statement:column-fgcolor = 4
     3112          .
     3113        end.
     3114      end.
     3115     assign
     3116       cur-clmn-locbr-fin-statement = 1
     3117     .
     3118     def var column-handle as handle no-undo .
     3119     column-handle = br-fin-statement:first-column.
     3120     do while valid-handle(column-handle) :
     3121       if column-handle = cur-clmnbr-fin-statement then do:
     3122         leave .
     3123       end.
     3124       column-handle = column-handle:NEXT-COLUMN.
     3125       assign
     3126         cur-clmn-locbr-fin-statement = cur-clmn-locbr-fin-statement + 1
     3127       .
     3128     end.
     3129     case sort-labelbr-fin-statement:
     3130           when X_fin-statement.prn-doc-code:label in browse br-fin-statement then DO:   assign     sort-column-name = "X_fin-statement.prn-doc-code"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3131       otherwise do:
     3132         assign
     3133           sort-column-name = ""
     3134         .
     3135         run OpenBr in this-procedure (  input yes, input no, input no).
     3136           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-fin-statement') then do:
     3137             run mv-brw-defaultbr-fin-statement.
     3138           end.
     3139         if sort-labelbr-fin-statement <> "" then do:
     3140           assign
     3141             cur-clmnbr-fin-statement:column-fgcolor = 0
     3142           .
     3143         end.
     3144         assign
     3145           cur-clmn-locbr-fin-statement = ?
     3146         .
     3147       end.
     3148     end case.
     3149       if cur-clmn-locbr-fin-statement <> ? then do:
     3150         if can-do( this-procedure:internal-entries, 'ch-clmnbr-fin-statement') then do:
     3151           run ch-clmnbr-fin-statement in this-procedure (cur-clmn-locbr-fin-statement).
     3152         end.
     3153       end.
     3154     if p-recid <> ? then do:
     3155       reposition br-fin-statement to recid p-recid no-error.
     3156       apply "value-changed" to br-fin-statement in frame Dialog-Frame.
     3157     end.
     3158     apply "entry" to br-fin-statement in frame Dialog-Frame.
     3159   END PROCEDURE.
     3160   procedure re-open-query-srt-clmnbr-fin-statement:
     3161   if cur-clmnbr-fin-statement = ? then do:
     3162      run OpenBr in this-procedure (  input yes, input no, input no).
     3163   end.
     3164   else do:
     3165      assign re-querybr-fin-statement = yes.
     3166      run sort-brbr-fin-statement
     3167        (input (if available X_fin-statement
     3168                then recid(X_fin-statement)
     3169                else ?
     3170               )
     3171        ).
     3172      assign re-querybr-fin-statement = no.
     3173   end.
     3174   end.
     3175   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3176   do:
