     5215       ,input  0
     5216       ,input  0
     5217       ,input  0
     5218       ,input  true
     5219       ,output OK
     5220       )  .
     5221   end.
     5222           end.
     5223           when '<открытие документа>':U
     5224           then do:
     5225   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5226   do:
     5227     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5228       (input  v-cntxt-db-num
     5229       ,input  v-cntxt-userid
     5230       ,input  0
