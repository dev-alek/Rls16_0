     1169   define variable print-option as character no-undo.
     1170   define variable add-option as character no-undo.
     1171   define variable client-option as character no-undo.
     1172   define variable schet-option as character no-undo.
     1173   DEFINE VARIABLE v-db-num like ub.db.db-num no-undo .
     1174   define variable v-rid-list as character no-undo .
     1175   define variable v-doc-rec as recid no-undo .
     1176   define variable v-for-title as character no-undo.
     1177   define variable is-type-mode as logical no-undo .
     1178   define variable is-fact-mode as logical no-undo .
     1179   define variable is-stat-mode as logical no-undo init ?.
     1180   define variable is-fin as logical   no-undo .
     1181   define variable dops as character no-undo format "X(250)".
     1182   define variable dopst as character no-undo format "X(1)".
     1183   DEFINE BUFFER X_fin-schet FOR ub.fin-schet.
     1184   DEFINE BUFFER X_clients FOR ub.clients.
     1185   DEFINE BUFFER X_currency FOR ub.currency.
     1186   DEFINE BUFFER X_fin-bank FOR ub.fin-bank.
     1187   define buffer X_curr_sysconf for ub.sysconf.
     1188   FUNCTION get-currency RETURNS CHARACTER
     1189     ( BUFFER loc-fin-statement FOR ub.fin-statement )  FORWARD.
     1190   DEFINE MENU MENU-B-add
     1191          MENU-ITEM standard-sttm  LABEL "стандартная"   .
     1192   DEFINE MENU MENU-B-print
