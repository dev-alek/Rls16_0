     1727   ON VALUE-CHANGED OF T-batch IN FRAME Dialog-Frame
     1728   DO:
     1729   define variable GLOG as logical no-undo .
     1730     assign
     1731     t-batch.
     1732     run proc-buttons in this-procedure ( input t-batch).
     1733     if t-batch = no
     1734     and b-mark:sensitive = no then do:
     1735       assign
     1736       v-rid-list = "":U.
     1737       if avail X_fin-statement then
     1738       GLOG = br-fin-statement:refresh().
     1739     end.
     1740   END.
     1741   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1742   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1743   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1744   on help of frame Dialog-Frame
     1745   do:
     1746     run gbl/app_help.p
     1747       (input this-procedure :file-name
     1748       ,input ''
     1749       ,input ?
     1750       ) no-error.
     1751     if error-status :error then do:
     1752       message
     1753         "Ошибка при вызове помощи"
     1754         error-status :get-message(1)
     1755         view-as alert-box .
     1756     end.
     1757   end.
     1758   run minbtn-set in this-procedure .
     1759   on choose of b-help in frame Dialog-Frame
     1760   do:
     1761     apply "help":u to frame Dialog-Frame .
     1762   end.
     1763   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1764   procedure minbtn-set :
     1765       do
     1766           on error undo, return error return-value
     1767           :
     1768           define variable ii              as integer       no-undo .
     1769           define variable fh              as widget-handle no-undo .
     1770           define variable hh              as widget-handle no-undo .
     1771           define variable v-h             as handle        extent 4 no-undo .
     1772           define variable v-name-button   as character     no-undo .
     1773           define variable v-help-old-x    as decimal       no-undo .
     1774           define variable v-help-old-y    as decimal       no-undo .
     1775           define variable v-help-old-size as decimal       no-undo .
     1776           define variable v-frame-width   as decimal       no-undo .
     1777           define variable jj              as integer       no-undo .
     1778           do
     1779               on error undo, return error
     1780               :
     1781               assign
     1782                   v-frame-width = frame Dialog-Frame:width - 0.3
     1783                   fh            = frame Dialog-Frame:first-child
     1784                   hh            = fh:first-child
     1785                   ii            = 1
     1786                   .
     1787               do while valid-handle(hh):
     1788                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1789                   do:
     1790                       case lc(hh:name) :
     1791                           when "b-help" then
     1792                               do:
     1793                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1794                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1795                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1796                                   hh:TOOLTIP = "Помощь" .
     1797                                   v-help-old-x = hh:column .
     1798                                   v-help-old-y = hh:row    .
     1799                                   v-help-old-size = hh:width .
     1800                                   hh:width-chars = 2.5 .
     1801                               end.
     1802                           when "b-print" then
     1803                               do:
     1804                                   hh:load-image("cmp/b-print.bmp":u) .
     1805                                   hh:TOOLTIP = "Печать" .
     1806                                   v-h[ii] = hh:handle .
     1807                                   ii = ii + 1 .
     1808                                   hh:width-chars = 3 .
     1809                               end.
     1810                           when "b-history" or
     1811                           when "b-hist" then
     1812                               do:
     1813                                   hh:load-image("cmp/b-hist.bmp":u) .
     1814                                   hh:TOOLTIP = "История" .
     1815                                   v-h[ii] = hh:handle .
     1816                                   ii = ii + 1 .
     1817                                   hh:width-chars = 3 .
     1818                               end.
     1819                           when "b-sch" then
     1820                               do:
     1821                                   hh:load-image("cmp/b-sch.bmp":u) .
     1822                                   hh:TOOLTIP = "Установка Фильтра" .
     1823                                   v-h[ii] = hh:handle .
     1824                                   ii = ii + 1 .
     1825                                   hh:width-chars = 3 .
     1826                               end.
     1827                           when "b-hist-user" then
     1828                               do:
     1829                                   hh:load-image("cmp/b-hist.bmp":u) .
     1830                                   hh:TOOLTIP = "История пользователя" .
     1831                                   ii = ii + 1 .
     1832                               end.
     1833                       end case.
     1834                   end.
     1835                   hh = hh:next-sibling.
     1836               end.
     1837               b-help:column = v-frame-width - b-help:width-chars.
     1838               jj = 0.
     1839               repeat ii = 4 to 1 by -1 :
     1840                   if valid-handle (v-h[ii] ) then
     1841                   do:
     1842                       jj  = jj + 1 .
     1843                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1844                       v-h[ii]:row    = v-help-old-y .
     1845                   end.
     1846               end.
     1847           end.
     1848       end.
     1849   end procedure.
     1850   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1851   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1852   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1853   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1854   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1855   define variable v-diasize-current-frame-height as decimal   no-undo .
     1856   define variable v-diasize-change-size          as logical   no-undo .
     1857   define variable v-diasize-resize-button        as handle    no-undo .
     1858   define variable v-diasize-wndmax               as logical   no-undo .
     1859   define variable v-diasize-wndstore             as logical   no-undo .
     1860   define variable v-diasize-proc-name            as character no-undo .
     1861   define variable v-diasize-browse-handle        as handle    no-undo .
     1862   define variable v-diasize-browse-number        as integer   no-undo .
     1863   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1864   define temp-table temp-diasize-handle no-undo
     1865     field handle-value  as handle
     1866     field save-position as decimal
     1867     index xpk is primary unique handle-value
     1868     .
     1869   define temp-table temp-browse-handle no-undo
     1870     field browse-type   as character
     1871     field browse-number as integer
     1872     field browse-handle as handle
     1873     field original-size as decimal
     1874     index xpk is primary unique browse-type browse-number
     1875     index xie browse-type browse-handle
     1876   .
     1877   procedure diasize_change-height :
     1878     define input  parameter p-change-value  as decimal   no-undo .
     1879     define input  parameter p-move-resize   as logical   no-undo .
     1880     define variable v-field-group-handle    as handle    no-undo .
     1881     define variable v-object-handle         as handle    no-undo .
     1882     define variable v-frame-height          as decimal   no-undo .
     1883     define variable v-frame-virtual-height  as decimal   no-undo .
     1884     define variable v-browse-height         as decimal   no-undo .
     1885     define variable v-window-height         as decimal   no-undo .
     1886     define variable v-window-virtual-height as decimal   no-undo .
     1887     define variable v-change-sign           as integer   no-undo .
     1888     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1889     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1890     if p-change-value > 0
     1891     then do:
     1892       if frame Dialog-Frame :height + p-change-value
     1893           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1894       then do:
     1895         assign
     1896           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1897                           - (frame Dialog-Frame :height-chars)
     1898         .
     1899         if p-change-value <= 0
     1900         then do:
     1901           run diasize_position-resize-button in this-procedure .
     1902           return .
     1903         end.
     1904       end.
     1905     end.
     1906     if p-change-value < 0
     1907     then do:
     1908       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1909       then do:
     1910         assign
     1911           p-change-value = v-diasize-orig-frame-height
     1912                          - (frame Dialog-Frame :height-chars)
     1913         .
     1914         if p-change-value >= 0
     1915         then do:
     1916           run diasize_position-resize-button in this-procedure .
     1917           return .
     1918         end.
     1919       end.
     1920     end.
     1921     if p-change-value >= 0
     1922     then do:
     1923       assign
     1924         v-change-sign = 1
     1925       .
     1926     end.
     1927     else do:
     1928       assign
     1929         v-change-sign = -1
     1930       .
     1931     end.
     1932     assign
     1933       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1934     .
     1935     if p-change-value = 0
     1936     then do:
     1937       run diasize_position-resize-button in this-procedure .
     1938       return .
     1939     end.
     1940     move_block:
     1941     do
     1942     on error undo move_block, retry move_block
     1943     :
     1944       if retry
     1945       then do:
     1946         do
     1947         on error undo move_block, leave move_block
     1948         :
     1949           if p-change-value > 0
     1950           then do:
     1951             for each buf_temp-diasize-handle
     1952             on error undo, next
     1953             :
     1954               assign
     1955                 v-object-handle = buf_temp-diasize-handle.handle-value
     1956               .
     1957               if v-object-handle <> v-diasize-resize-button
     1958               then do:
     1959                 assign
     1960                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1961                 .
     1962               end.
     1963             end.
     1964             assign
     1965               v-diasize-browse-handle :height = v-browse-height
     1966             .
     1967             for each buf_temp-browse-handle
     1968               where buf_temp-browse-handle.browse-type = 'height':u
     1969             on error undo, next
     1970             :
     1971               assign
     1972                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1973               .
     1974             end.
     1975             assign
     1976               frame Dialog-Frame :height = v-frame-height
     1977             .
     1978             if frame Dialog-Frame :scrollable = true
     1979             then do:
     1980               assign
     1981                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1982               .
     1983             end.
     1984             run diasize_position-resize-button in this-procedure .
     1985           end.
     1986           else do:
     1987             if frame Dialog-Frame :scrollable = true
     1988             then do:
     1989               assign
     1990                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1991               .
     1992             end.
     1993             assign
     1994               frame Dialog-Frame :height = v-frame-height
     1995             .
     1996             assign
     1997               v-diasize-browse-handle :height = v-browse-height
     1998             .
     1999             for each buf_temp-browse-handle
     2000               where buf_temp-browse-handle.browse-type = 'height':u
     2001             on error undo, next
     2002             :
     2003               assign
     2004                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2005               .
     2006             end.
     2007             for each buf_temp-diasize-handle
     2008             on error undo, next
     2009             :
     2010               assign
     2011                 v-object-handle = buf_temp-diasize-handle.handle-value
     2012               .
     2013               if v-object-handle <> v-diasize-resize-button
     2014               then do:
     2015                 assign
     2016                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2017                 .
     2018               end.
     2019             end.
     2020             run diasize_position-resize-button in this-procedure .
     2021           end.
     2022           assign
     2023             v-diasize-change-size = false
     2024           .
     2025           leave move_block .
     2026         end.
     2027       end.
     2028       assign
     2029         v-diasize-need-full-display = true
     2030       .
     2031       if v-diasize-change-size = false
     2032       then do:
     2033         assign
     2034           v-diasize-change-size = true
     2035         .
     2036       end.
     2037       else do:
     2038         return .
     2039       end.
     2040       assign
     2041         v-frame-height = frame Dialog-Frame :height
     2042         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2043         v-browse-height = v-diasize-browse-handle :height
     2044       .
     2045       for each buf_temp-browse-handle
     2046         where buf_temp-browse-handle.browse-type = 'height':u
     2047       :
     2048         assign
     2049           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2050         .
     2051       end.
     2052       for each buf_temp-diasize-handle
     2053       :
     2054         delete buf_temp-diasize-handle .
     2055       end.
     2056       assign
     2057         v-field-group-handle = frame Dialog-Frame :first-child
     2058       .
     2059       do while valid-handle(v-field-group-handle)
     2060       :
     2061         assign
     2062           v-object-handle = v-field-group-handle :first-child
     2063         .
     2064         do while valid-handle(v-object-handle)
     2065         :
     2066           if  v-object-handle <> v-diasize-browse-handle :handle
     2067           and can-query(v-object-handle, "row")
     2068           and can-query(v-object-handle, "height")
     2069           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2070           then do:
     2071             find first buf_temp-browse-handle
     2072               where buf_temp-browse-handle.browse-type   = 'height':u
     2073                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2074               no-error .
     2075             if available buf_temp-browse-handle
     2076             then do:
     2077             end.
     2078             else do:
     2079               create buf_temp-diasize-handle .
     2080               assign
     2081                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2082                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2083               .
     2084             end.
     2085           end.
     2086           assign
     2087             v-object-handle = v-object-handle :next-sibling
     2088           .
     2089         end.
     2090         assign
     2091           v-field-group-handle = v-field-group-handle :next-sibling
     2092         .
     2093       end.
     2094       do with frame Dialog-Frame
     2095       :
     2096         hide v-diasize-resize-button .
     2097         assign
     2098           v-diasize-resize-button :row    = 1
     2099           v-diasize-resize-button :column = 1
     2100         .
     2101       end.
     2102       if p-change-value > 0
     2103       then do:
     2104         if frame Dialog-Frame :scrollable = true
     2105         then do:
     2106           assign
     2107             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2108             no-error .
     2109           if error-status :error
     2110           or error-status :get-message(1) <> ""
     2111           then do:
     2112             undo move_block, retry move_block .
     2113           end.
     2114         end.
     2115         assign
     2116           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2117           no-error .
     2118         if error-status :error
     2119         or error-status :get-message(1) <> ""
     2120         then do:
     2121           undo move_block, retry move_block .
     2122         end.
     2123         assign
     2124           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2125           no-error .
     2126         if error-status :error
     2127         or error-status :get-message(1) <> ""
     2128         then do:
     2129           undo move_block, retry move_block .
     2130         end.
     2131         for each buf_temp-browse-handle
     2132           where buf_temp-browse-handle.browse-type = 'height':u
     2133         on error undo move_block, retry move_block
     2134         :
     2135           assign
     2136             buf_temp-browse-handle.browse-handle :height
     2137               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2138             no-error .
     2139           if error-status :error
     2140           or error-status :get-message(1) <> ""
     2141           then do:
     2142             undo move_block, retry move_block .
     2143           end.
     2144         end.
     2145         for each buf_temp-diasize-handle
     2146         on error undo move_block, retry move_block
     2147         :
     2148           assign
     2149             v-object-handle = buf_temp-diasize-handle.handle-value
     2150           .
     2151           if v-object-handle <> v-diasize-resize-button
     2152           then do:
     2153             assign
     2154               v-object-handle :row = v-object-handle :row + p-change-value
     2155               no-error .
     2156             if error-status :error
     2157             or error-status :get-message(1) <> ""
     2158             then do:
     2159               undo move_block, retry move_block .
     2160             end.
     2161           end.
     2162         end.
     2163       end.
     2164       else do:
     2165         for each buf_temp-diasize-handle
     2166         on error undo move_block, retry move_block
     2167         :
     2168           assign
     2169             v-object-handle = buf_temp-diasize-handle.handle-value
     2170           .
     2171           if v-object-handle <> v-diasize-resize-button
     2172           then do:
     2173             assign
     2174               v-object-handle :row = v-object-handle :row + p-change-value
     2175               no-error .
     2176             if error-status :error
     2177             or error-status :get-message(1) <> ""
     2178             then do:
     2179               undo move_block, retry move_block .
     2180             end.
     2181           end.
     2182         end.
     2183         assign
     2184           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2185           no-error .
     2186         if error-status :error
     2187         or error-status :get-message(1) <> ""
     2188         then do:
     2189           undo move_block, retry move_block .
     2190         end.
     2191         for each buf_temp-browse-handle
     2192           where buf_temp-browse-handle.browse-type = 'height':u
     2193         on error undo move_block, retry move_block
     2194         :
     2195           assign
     2196             buf_temp-browse-handle.browse-handle :height
     2197               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2198             no-error .
     2199           if error-status :error
     2200           or error-status :get-message(1) <> ""
     2201           then do:
     2202             undo move_block, retry move_block .
     2203           end.
     2204         end.
     2205         assign
     2206           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2207           no-error .
     2208         if error-status :error
     2209         or error-status :get-message(1) <> ""
     2210         then do:
     2211           undo move_block, retry move_block .
     2212         end.
     2213         if frame Dialog-Frame :scrollable = true
     2214         then do:
     2215           assign
     2216             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2217             no-error .
     2218           if error-status :error
     2219           or error-status :get-message(1) <> ""
     2220           then do:
     2221             undo move_block, retry move_block .
     2222           end.
     2223         end.
     2224       end.
     2225       if p-move-resize = true
     2226       then do:
     2227         run diasize_position-resize-button in this-procedure .
     2228       end.
     2229       if v-diasize-wndstore = true
     2230       then do:
     2231         if connected("ub") = true
     2232         then do:
     2233           define variable v-cntxt-db-num        as integer   no-undo .
     2234           define variable v-cntxt-userid        as character no-undo .
     2235           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2236                                             , OUTPUT v-cntxt-userid
     2237                                             ) .
     2238           run gbl/wndsizew.p
     2239             (input  v-cntxt-db-num
     2240             ,input  v-cntxt-userid
     2241             ,input  v-diasize-proc-name
     2242             ,input  'height':u
     2243             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2244             ) .
     2245         end.
     2246       end.
     2247     end.
     2248     assign
     2249       v-diasize-change-size = false
     2250     .
     2251   end procedure.
     2252   procedure diasize_set-height :
     2253     define input  parameter p-new-height  as decimal   no-undo .
     2254     define input  parameter p-move-resize as logical   no-undo .
     2255     do
     2256     on error undo, return error return-value
     2257     :
     2258       run diasize_change-height in this-procedure
     2259         (input  (p-new-height - frame Dialog-Frame :height)
     2260         ,input  p-move-resize
     2261         ) .
     2262     end.
     2263   end procedure.
     2264   procedure diasize_change-width :
     2265     define input  parameter p-change-value as decimal   no-undo .
     2266     define input  parameter p-move-resize  as logical   no-undo .
     2267     define variable v-field-group-handle   as handle    no-undo .
     2268     define variable v-object-handle        as handle    no-undo .
     2269     define variable v-frame-width          as decimal   no-undo .
     2270     define variable v-frame-virtual-width  as decimal   no-undo .
     2271     define variable v-browse-width         as decimal   no-undo .
     2272     define variable v-window-width         as decimal   no-undo .
     2273     define variable v-window-virtual-width as decimal   no-undo .
     2274     define variable v-change-sign          as integer   no-undo .
     2275     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2276     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2277     if p-change-value > 0
     2278     then do:
     2279       if frame Dialog-Frame :width + p-change-value >
     2280           session :width-chars
     2281       then do:
     2282         assign
     2283           p-change-value = session :width-chars - frame Dialog-Frame :width
     2284         .
     2285         if p-change-value <= 0
     2286         then do:
     2287           run diasize_position-resize-button in this-procedure .
     2288           return .
     2289         end.
     2290       end.
     2291     end.
     2292     if p-change-value < 0
     2293     then do:
     2294       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2295       then do:
     2296         assign
     2297           p-change-value = v-diasize-orig-frame-width
     2298                          - frame Dialog-Frame :width
     2299         .
     2300         if p-change-value >= 0
     2301         then do:
     2302           run diasize_position-resize-button in this-procedure .
     2303           return .
     2304         end.
     2305       end.
     2306     end.
     2307     if p-change-value >= 0
     2308     then do:
     2309       assign
     2310         v-change-sign = 1
     2311       .
     2312     end.
     2313     else do:
     2314       assign
     2315         v-change-sign = -1
     2316       .
     2317     end.
     2318     assign
     2319       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2320     .
     2321     if p-change-value = 0
     2322     then do:
     2323       run diasize_position-resize-button in this-procedure .
     2324       return .
     2325     end.
     2326     move_block:
     2327     do
     2328     on error undo move_block, leave move_block
     2329     :
     2330       if retry
     2331       then do:
     2332         do
     2333         on error undo move_block, leave move_block
     2334         :
     2335           if p-change-value > 0
     2336           then do:
     2337             for each buf_temp-diasize-handle
     2338             on error undo, next
     2339             :
     2340               assign
     2341                 v-object-handle = buf_temp-diasize-handle.handle-value
     2342               .
     2343               if v-object-handle <> v-diasize-resize-button
     2344               then do:
     2345                 assign
     2346                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2347                 .
     2348               end.
     2349             end.
     2350             assign
     2351               v-diasize-browse-handle :width = v-browse-width
     2352             .
     2353             for each buf_temp-browse-handle
     2354               where buf_temp-browse-handle.browse-type = 'width':u
     2355             on error undo, next
     2356             :
     2357               assign
     2358                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2359               .
     2360             end.
     2361             assign
     2362               frame Dialog-Frame :width = v-frame-width
     2363             .
     2364             if frame Dialog-Frame :scrollable = true
     2365             then do:
     2366               assign
     2367                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2368               .
     2369             end.
     2370             run diasize_position-resize-button in this-procedure .
     2371           end.
     2372           else do:
     2373             if frame Dialog-Frame :scrollable = true
     2374             then do:
     2375               assign
     2376                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2377               .
     2378             end.
     2379             assign
     2380               frame Dialog-Frame :width = v-frame-width
     2381             .
     2382             for each buf_temp-browse-handle
     2383               where buf_temp-browse-handle.browse-type = 'width':u
     2384             on error undo, next
     2385             :
     2386               assign
     2387                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2388               .
     2389             end.
     2390             assign
     2391               v-diasize-browse-handle :width = v-browse-width
     2392             .
     2393             for each buf_temp-diasize-handle
     2394             on error undo, next
     2395             :
     2396               assign
     2397                 v-object-handle = buf_temp-diasize-handle.handle-value
     2398               .
     2399               if v-object-handle <> v-diasize-resize-button
     2400               then do:
     2401                 assign
     2402                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2403                 .
     2404               end.
     2405             end.
     2406             run diasize_position-resize-button in this-procedure .
     2407           end.
     2408           assign
     2409             v-diasize-change-size = false
     2410           .
     2411           leave move_block .
     2412         end.
     2413       end.
     2414       assign
     2415         v-diasize-need-full-display = true
     2416       .
     2417       if v-diasize-change-size = false
     2418       then do:
     2419         assign
     2420           v-diasize-change-size = true
     2421         .
     2422       end.
     2423       else do:
     2424         return .
     2425       end.
     2426       assign
     2427         v-frame-width = frame Dialog-Frame :width
     2428         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2429         v-browse-width = v-diasize-browse-handle :width
     2430       .
     2431       for each buf_temp-browse-handle
     2432         where buf_temp-browse-handle.browse-type = 'width':u
     2433       :
     2434         assign
     2435           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2436         .
     2437       end.
     2438       for each buf_temp-diasize-handle
     2439       :
     2440         delete buf_temp-diasize-handle .
     2441       end.
     2442       assign
     2443         v-field-group-handle = frame Dialog-Frame :first-child
     2444       .
     2445       do while valid-handle(v-field-group-handle)
     2446       :
     2447         assign
     2448           v-object-handle = v-field-group-handle :first-child
     2449         .
     2450         do while valid-handle(v-object-handle)
     2451         :
     2452           if  v-object-handle <> v-diasize-browse-handle :handle
     2453           and v-object-handle <> v-diasize-resize-button
     2454           and can-query(v-object-handle, "row")
     2455           and can-query(v-object-handle, "height")
     2456           and ( v-object-handle :col + v-object-handle :width
     2457                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2458               )
     2459           then do:
     2460             find first buf_temp-browse-handle
     2461               where buf_temp-browse-handle.browse-type   = 'width':u
     2462                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2463               no-error .
     2464             if available buf_temp-browse-handle
     2465             then do:
     2466             end.
     2467             else do:
     2468               create buf_temp-diasize-handle .
     2469               assign
     2470                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2471                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2472               .
     2473             end.
     2474           end.
     2475           assign
     2476             v-object-handle = v-object-handle :next-sibling
     2477           .
     2478         end.
     2479         assign
     2480           v-field-group-handle = v-field-group-handle :next-sibling
     2481         .
     2482       end.
     2483       do with frame Dialog-Frame
     2484       :
     2485         hide v-diasize-resize-button .
     2486         v-diasize-resize-button :row = 1.
     2487         v-diasize-resize-button :column = 1.
     2488       end.
     2489       if p-change-value > 0
     2490       then do:
     2491         if frame Dialog-Frame :scrollable = true
     2492         then do:
     2493           assign
     2494             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2495             no-error .
     2496           if error-status :error
     2497           or error-status :get-message(1) <> ""
     2498           then do:
     2499             undo move_block, retry move_block.
     2500           end.
     2501         end.
     2502         assign
     2503           frame Dialog-Frame :width = v-frame-width + p-change-value
     2504           no-error .
     2505         if error-status :error
     2506         or error-status :get-message(1) <> ""
     2507         then do:
     2508           undo move_block, retry move_block.
     2509         end.
     2510         assign
     2511           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2512         no-error .
     2513         if error-status :error
     2514         or error-status :get-message(1) <> ""
     2515         then do:
     2516           undo move_block, retry move_block.
     2517         end.
     2518         for each buf_temp-browse-handle
     2519           where buf_temp-browse-handle.browse-type = 'width':u
     2520         on error undo move_block, retry move_block
     2521         :
     2522           assign
     2523             buf_temp-browse-handle.browse-handle :width
     2524               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2525             no-error .
     2526           if error-status :error
     2527           or error-status :get-message(1) <> ""
     2528           then do:
     2529             undo move_block, retry move_block .
     2530           end.
     2531         end.
     2532         for each buf_temp-diasize-handle
     2533         on error undo move_block, retry move_block
     2534         :
     2535           assign
     2536             v-object-handle = buf_temp-diasize-handle.handle-value
     2537           .
     2538           if v-object-handle <> v-diasize-resize-button
     2539           then do:
     2540             assign
     2541               v-object-handle :col = v-object-handle :col + p-change-value
     2542               no-error .
     2543             if error-status :error
     2544             or error-status :get-message(1) <> ""
     2545             then do:
     2546               undo move_block, retry move_block .
     2547             end.
     2548           end.
     2549         end.
     2550       end.
     2551       else do:
     2552         for each buf_temp-diasize-handle
     2553         on error undo move_block, retry move_block
     2554         :
     2555           assign
     2556             v-object-handle = buf_temp-diasize-handle.handle-value
     2557           .
     2558           if v-object-handle <> v-diasize-resize-button
     2559           then do:
     2560             assign
     2561               v-object-handle :col = v-object-handle :col + p-change-value
     2562               no-error .
     2563             if error-status :error
     2564             or error-status :get-message(1) <> ""
     2565             then do:
     2566               undo move_block, retry move_block .
     2567             end.
     2568           end.
     2569         end.
     2570         for each buf_temp-browse-handle
     2571           where buf_temp-browse-handle.browse-type = 'width':u
     2572         on error undo move_block, retry move_block
     2573         :
     2574           assign
     2575             buf_temp-browse-handle.browse-handle :width
     2576               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2577             no-error .
     2578           if error-status :error
     2579           or error-status :get-message(1) <> ""
     2580           then do:
     2581             undo move_block, retry move_block .
     2582           end.
     2583         end.
     2584         assign
     2585           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2586           no-error .
     2587         if error-status :error
     2588         or error-status :get-message(1) <> ""
     2589         then do:
     2590           undo move_block, retry move_block.
     2591         end.
     2592         assign
     2593           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2594         no-error .
     2595         if error-status :error
     2596         or error-status :get-message(1) <> ""
     2597         then do:
     2598           undo move_block, retry move_block.
     2599         end.
     2600         if frame Dialog-Frame :scrollable = true
     2601         then do:
     2602           assign
     2603             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2604           no-error .
     2605           if error-status :error
     2606           or error-status :get-message(1) <> ""
     2607           then do:
     2608             undo move_block, retry move_block.
     2609           end.
     2610         end.
     2611       end.
     2612       if p-move-resize
     2613       then do:
     2614         run diasize_position-resize-button in this-procedure .
     2615       end.
     2616       if v-diasize-wndstore = true
     2617       then do:
     2618         if connected("ub") = true
     2619         then do:
     2620           define variable v-cntxt-db-num        as integer   no-undo .
     2621           define variable v-cntxt-userid        as character no-undo .
     2622           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2623                                             , OUTPUT v-cntxt-userid
     2624                                             ) .
     2625           run gbl/wndsizew.p
     2626             (input  v-cntxt-db-num
     2627             ,input  v-cntxt-userid
     2628             ,input  v-diasize-proc-name
     2629             ,input  'width':u
     2630             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2631             ) .
     2632         end.
     2633       end.
     2634     end.
     2635     assign
     2636       v-diasize-change-size = false
     2637     .
     2638   end procedure.
     2639   procedure diasize_set-width :
     2640     define input  parameter p-new-width  as decimal   no-undo .
     2641     define input  parameter p-move-resize as logical   no-undo .
     2642     do
     2643     on error undo, return error return-value
     2644     :
     2645       run diasize_change-width in this-procedure
     2646         (input  (p-new-width - frame Dialog-Frame :width)
     2647         ,input  p-move-resize
     2648         ) .
     2649     end.
     2650   end procedure.
     2651   procedure diasize_position-resize-button :
     2652     do with frame Dialog-Frame
     2653     :
     2654       hide v-diasize-resize-button .
     2655       assign
     2656         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2657                     - 1
     2658                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2659         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2660                     - 1
     2661                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2662       .
     2663       view v-diasize-resize-button .
     2664     end.
     2665   end procedure.
     2666   on alt-right anywhere
     2667   do:
     2668     run diasize_change-width in this-procedure
     2669       (input 1
     2670       ,input true
     2671       ) .
     2672     return no-apply .
     2673   end.
     2674   on alt-left anywhere
     2675   do:
     2676     run diasize_change-width in this-procedure
     2677       (input -1
     2678       ,input true
     2679       ) .
     2680     return no-apply .
     2681   end.
     2682   on alt-down anywhere
     2683   do:
     2684     run diasize_change-height in this-procedure
     2685       (input 1
     2686       ,input true
     2687       ) .
     2688     return no-apply .
     2689   end.
     2690   on alt-up anywhere
     2691   do:
     2692     run diasize_change-height in this-procedure
     2693       (input -1
     2694       ,input true
     2695       ) .
     2696     return no-apply .
     2697   end.
     2698   on alt-enter of frame Dialog-Frame
     2699   do:
     2700     run diasize_maximize in this-procedure
     2701       (input  ?
     2702       ).
     2703     return no-apply .
     2704   end.
     2705   procedure diasize_end-move :
     2706     do
     2707     on error undo, return error return-value
     2708     :
     2709       define variable v-row-delta as decimal   no-undo .
     2710       define variable v-col-delta as decimal   no-undo .
     2711       define variable v-new-row as decimal   no-undo .
     2712       define variable v-new-col as decimal   no-undo .
     2713       assign
     2714         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2715         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2716       .
     2717       assign
     2718         v-row-delta = v-new-row - frame Dialog-Frame :height
     2719         v-col-delta = v-new-col - frame Dialog-Frame :width
     2720       .
     2721       run diasize_change-height in this-procedure
     2722         (input v-row-delta
     2723         ,input true
     2724         ) .
     2725       run diasize_change-width in this-procedure
     2726         (input v-col-delta
     2727         ,input true
     2728         ) .
     2729     end.
     2730   end procedure.
     2731   procedure diasize_maximize :
     2732     define input  parameter p-action as logical   no-undo .
     2733     do
     2734     on error undo, return error return-value
     2735     :
     2736       if p-action = ?
     2737       then do:
     2738         if v-diasize-need-maximize = true
     2739         then do:
     2740           assign
     2741             p-action = true
     2742           .
     2743         end.
     2744         else do:
     2745           assign
     2746             p-action = false
     2747           .
     2748         end.
     2749       end.
     2750       if p-action = true
     2751       then do:
     2752         run diasize_change-height in this-procedure
     2753           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2754               - frame Dialog-Frame :height-chars
     2755           ,input true
     2756           ) .
     2757         run diasize_change-width in this-procedure
     2758           (input session :width-chars
     2759               - frame Dialog-Frame :width-chars
     2760           ,input true
     2761           ) .
     2762         assign
     2763           v-diasize-need-maximize = false
     2764         .
     2765       end.
     2766       else do:
     2767         run diasize_change-width in this-procedure
     2768           (input v-diasize-orig-frame-width
     2769               - frame Dialog-Frame :width-chars
     2770           ,input true
     2771           ) .
     2772         run diasize_change-height in this-procedure
     2773           (input v-diasize-orig-frame-height
     2774               - frame Dialog-Frame :height-chars
     2775           ,input true
     2776           ) .
     2777         assign
     2778           v-diasize-need-maximize = true
     2779         .
     2780       end.
     2781     end.
     2782   end procedure.
     2783   procedure diasize_restore-orig-size :
     2784     do
     2785     on error undo, return error return-value
     2786     :
     2787       assign
     2788         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2789         v-diasize-current-frame-height = frame Dialog-Frame :height
     2790       .
     2791       run diasize_set-height in this-procedure
     2792         (input  v-diasize-orig-frame-height
     2793         ,input  true
     2794         ) .
     2795       run diasize_set-width in this-procedure
     2796         (input  v-diasize-orig-frame-width
     2797         ,input  true
     2798         ) .
     2799     end.
     2800   end procedure.
     2801   procedure diasize_restore-current-size :
     2802     do
     2803     on error undo, return error return-value
     2804     :
     2805       run diasize_set-height in this-procedure
     2806         (input  v-diasize-current-frame-height
     2807         ,input  true
     2808         ) .
     2809       run diasize_set-width in this-procedure
     2810         (input  v-diasize-current-frame-width
     2811         ,input  true
     2812         ) .
     2813     end.
     2814   end procedure.
     2815   procedure diasize_set-browse-handle :
     2816     define input  parameter p-browse-handle as handle   no-undo .
     2817     define buffer buf_temp-browse-handle for temp-browse-handle .
     2818     do
     2819     on error undo, return error return-value
     2820     :
     2821       assign
     2822         v-diasize-browse-handle = p-browse-handle
     2823       .
     2824       for each buf_temp-browse-handle
     2825       on error undo, return error return-value
     2826       :
     2827         delete buf_temp-browse-handle .
     2828       end.
     2829     end.
     2830   end procedure.
     2831   procedure diasize_add_browse :
     2832     define input  parameter p-browse-type   as character no-undo .
     2833     define input  parameter p-browse-handle as handle    no-undo .
     2834     define buffer buf_temp-browse-handle for temp-browse-handle .
     2835     do
     2836     on error undo, return error return-value
     2837     :
     2838       assign
     2839         v-diasize-browse-number = v-diasize-browse-number + 1
     2840       .
     2841       create buf_temp-browse-handle .
     2842       assign
     2843         buf_temp-browse-handle.browse-type   = p-browse-type
     2844         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2845         buf_temp-browse-handle.browse-handle = p-browse-handle
     2846       .
     2847     end.
     2848   end procedure.
     2849   procedure diasize_init :
     2850     define variable v-default-value    as logical   no-undo .
     2851     define variable v-restore-saved    as logical   no-undo .
     2852     define variable v-resize-value-str as character no-undo .
     2853     do
     2854     on error undo, return error return-value
     2855     :
     2856       do with frame Dialog-Frame
     2857       :
     2858         assign
     2859           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2860           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2861           v-diasize-browse-handle     = browse br-fin-statement :handle
     2862         .
     2863         create button v-diasize-resize-button
     2864         assign
     2865           parent        = frame Dialog-Frame :first-child
     2866           label         = "s"
     2867           height-pixels = 16
     2868           width-pixels  = 16
     2869           visible       = true
