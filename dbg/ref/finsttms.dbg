     5460   END PROCEDURE.
     5461   PROCEDURE proc-find-date :
     5462   define input parameter p-next as logical no-undo.
     5463   define input parameter p-date like ub.fin-statement.doc-date no-undo.
     5464   define input parameter p-what-date as character no-undo.
     5465   define variable v-date-chr as character no-undo.
     5466   if p-date = ? then return .
     5467   display
     5468   "":U @ sch-BIK
     5469   0 @ sch-curr-code
     5470   "":U @ sch-prn-doc-code
     5471   "":U @ sch-r-schet
     5472   with frame Dialog-Frame.
     5473   CASE p-what-date:
     5474       when "doc-date":U then do:
     5475         assign
     5476         sch-bank-date = ?
     5477         sch-fact-date = ?
     5478         .
     5479         display
     5480         sch-fact-date
     5481         sch-bank-date
     5482         with frame Dialog-Frame.
     5483       end.
     5484       when "fact-date":U then do:
     5485         assign
     5486         sch-doc-date = ?
     5487         sch-bank-date = ?
     5488         .
     5489         display
     5490         sch-doc-date
     5491         sch-bank-date
     5492         with frame Dialog-Frame.
     5493       end.
     5494       when "bank-date":U then do:
     5495         assign
     5496         sch-doc-date = ?
     5497         sch-fact-date = ?
     5498         .
     5499         display
     5500         sch-fact-date
     5501         sch-doc-date
     5502         with frame Dialog-Frame.
     5503       end.
     5504   END CASE.
     5505   assign
     5506   v-date-chr = string(day(p-date)) + chr(47) +
     5507                    string(month(p-date)) + chr(47) +
     5508                    string(year(p-date)).
     5509   CASE p-what-date:
     5510       when "doc-date":U then do:
     5511          run OpenBr in this-procedure
     5512           ( input false
     5513            ,input true
     5514            ,input substitute("and X_fin-statement.doc-date = &1 "
     5515                             , v-date-chr)
     5516           ).
     5517         apply "entry":u to sch-doc-date in frame Dialog-Frame.
     5518       end.
     5519       when "fact-date":U then do:
     5520          run OpenBr in this-procedure
     5521           ( input false
     5522            ,input true
     5523            ,input substitute("and X_fin-statement.fact-date = &1 "
     5524                               , v-date-chr)
     5525           ).
     5526         apply "entry":u to sch-fact-date in frame Dialog-Frame.
     5527       end.
     5528           when "bank-date":U then do:
     5529          run OpenBr in this-procedure
     5530           ( input false
     5531            ,input true
     5532            ,input substitute("and X_fin-statement.bank-date = &1 "
     5533                             , v-date-chr)
     5534           ).
     5535         apply "entry":u to sch-bank-date in frame Dialog-Frame.
     5536       end.
     5537   END CASE.
     5538   END PROCEDURE.
