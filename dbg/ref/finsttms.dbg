     4990   PROCEDURE proc-br-fin-statement :
     4991   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4992   if b-sel:sensitive in frame Dialog-Frame then dO:
     4993       if b-mark:sensitive then do:
     4994           apply "choose" to b-mark in frame Dialog-Frame.
     4995       end.
     4996       else do:
     4997           apply "choose" to b-sel in frame Dialog-Frame.
     4998       end.
     4999   end.
     5000   else do:
     5001       if b-lkp:sensitive then
     5002       apply "choose" to b-lkp in frame Dialog-Frame.
     5003   end.
     5004   END PROCEDURE.
     5005   PROCEDURE proc-buttons :
     5006   define input parameter p-is-batch as logical no-undo.
     5007   ENABLE
     5008   b-close when (is-fact-mode = no
     5009                 AND
     5010                 (not p-is-batch
     5011                 or
     5012                 (
     5013                 is-stat-mode = yes
     5014                   AND
     5015                 is-type-mode = yes
     5016                 ))
     5017                 AND (p-curr-host-code = p-host-code
     5018                     AND available X_sysconf
     5019                     AND X_sysconf.firm-db-num = v-db-num)
     5020                 and is-fin
     5021                     )
     5022   b-open when (is-fact-mode = no
     5023               AND
     5024                 (not p-is-batch
     5025                 or
     5026                 (
     5027                 is-stat-mode = yes
     5028                   AND
     5029                 is-type-mode = yes
     5030                 ))
     5031               AND (p-curr-host-code = p-host-code
     5032                   AND available X_sysconf
     5033                   AND X_sysconf.firm-db-num = v-db-num)
     5034               and is-fin
     5035                   )
     5036   b-reject when (is-fact-mode = no
     5037                 AND
     5038                 (not p-is-batch
     5039                 or
     5040                 (
     5041                 is-stat-mode = yes
     5042                   AND
     5043                 is-type-mode = yes
     5044                 ))
     5045                 AND (p-curr-host-code = p-host-code
     5046                       AND available X_sysconf
     5047                       AND X_sysconf.firm-db-num = v-db-num)
     5048                and is-fin
     5049                       )
     5050   with frame Dialog-Frame .
     5051   CASE p-is-batch:
     5052       when yes then do:
     5053           ENABLE
     5054           B-mark
     5055           with frame Dialog-Frame.
     5056           disable
     5057           b-add
     5058           b-chg with frame Dialog-Frame.
     5059         assign
     5060         menu-item m_one:label     in menu menu-b-print = "Выбранные"
     5061         menu-item m_one-graphics:label     in menu menu-b-print = "Выбранные-графика"
     5062         menu-item m_one:sensitive in menu menu-b-print = (is-type-mode = yes).
     5063       end.
     5064       when no then do:
     5065           ENABLE
     5066           B-mark when lookup("b-mark":U, bttns) > 0
     5067           B-add when (p-curr-host-code = p-host-code
     5068                       AND available X_sysconf
     5069                       AND X_sysconf.firm-db-num = v-db-num
     5070                       AND not p-is-batch
     5071                       AND not(is-stat-mode = yes and p-status_ <> 'новый':U)
     5072                       and is-fin
     5073                       )
     5074           B-chg when (p-curr-host-code = p-host-code
     5075                       AND available X_sysconf
     5076                       AND X_sysconf.firm-db-num = v-db-num
     5077                       and is-fin
     5078                       )
     5079           with frame Dialog-Frame.
     5080           DISABLE
     5081           b-mark when lookup("b-mark":U, bttns) = 0
     5082           with frame Dialog-Frame.
     5083           assign
     5084           menu-item m_one:label     in menu menu-b-print = "Один"
     5085           menu-item m_one-graphics:label     in menu menu-b-print = "Один-графика"
     5086           menu-item m_one:sensitive in menu menu-b-print = yes.
     5087       end.
     5088   END CASE.
     5089   END PROCEDURE.
     5090   PROCEDURE proc-close-open :
     5091   define input parameter p-close-mode as character no-undo .
     5092   define input parameter p-is-batch as logical no-undo .
     5093   define variable v-status_ as character no-undo .
     5094   define variable v-old-status_ as character no-undo .
     5095   define variable v-fins-doc-type as character no-undo .
     5096   define variable v-ask-date as logical no-undo .
     5097   define variable v-ask-message as character no-undo .
     5098   define variable v-status-date-chr as character no-undo.
     5099   define variable v-date as date no-undo .
     5100   define variable v-time as integer no-undo .
     5101   define variable ok as logical no-undo .
     5102   define variable ii as integer no-undo.
     5103   define variable ok-ii as integer no-undo.
     5104   define variable v-new-rid-list as character no-undo .
     5105   define variable v-doc-rec as recid no-undo .
     5106   define variable conf-par as character no-undo .
     5107   define variable par-type as character no-undo .
     5108   define variable glog as logical no-undo .
     5109   define buffer buf_fin-statement for ub.fin-statement.
     5110   if t-batch = no then do:
     5111       if not available X_fin-statement then return error.
     5112       assign
     5113       v-doc-rec = recid(X_fin-statement).
     5114   end.
     5115   if t-batch = yes then do:
     5116   if v-rid-list = "":U then do:
     5117       message
     5118       "Вы не отметили ни одного платежа"
     5119       view-as alert-box error.
     5120       return error.
     5121     end.
     5122   end.
     5123   do
     5124   on error undo, return error
     5125   :
     5126     CASE t-batch:
     5127       when no then do:
     5128         find first buf_fin-statement where
     5129                   recid(buf_fin-statement) = recid(X_fin-statement) exclusive-lock no-error .
     5130         if not avail buf_fin-statement then return error.
     5131         assign
     5132         v-old-status_ = buf_fin-statement.status_
     5133         .
     5134       end.
     5135       when yes then do:
     5136         _do:
     5137         do ii = 1 to num-entries(v-rid-list):
     5138           find first buf_fin-statement where
     5139               recid(buf_fin-statement) = integer(entry(ii, v-rid-list)) exclusive-lock no-error .
     5140           if ii = 1 then do:
     5141             assign
     5142             v-old-status_ = buf_fin-statement.status_
     5143             V-fins-doc-type = BUF_fin-statement.fins-doc-type
     5144             v-doc-rec = recid(buf_fin-statement)
     5145             .
     5146           end.
     5147           if not avail buf_fin-statement
     5148           or (avail buf_fin-statement and v-old-status_ <> "":U and buf_fin-statement.status_ <> v-old-status_)
     5149           or (avail buf_fin-statement and v-fins-doc-type <> "":U aND buf_fin-statement.fins-doc-type <> v-fins-doc-type)
     5150           then NEXT _do.
     5151           LEAVE _do.
     5152         end.
     5153       end.
     5154     END CASE.
     5155   end.
     5156   run trg/finsgraf.p (
     5157                    input  buf_fin-statement.host-code
     5158                   ,input  buf_fin-statement.sttm-code
     5159                   ,input  p-close-mode
     5160                   ,input  'cl-bank'
     5161                   ,input  v-old-status_
     5162                   ,input  ?
     5163                   ,output v-status_
     5164                   ,output v-ask-date
     5165                   ,output v-ask-message
     5166                   ) no-error.
     5167   if error-status:error then do:
     5168     message
     5169     "Ошибка при проверке возможности" p-close-mode skip
     5170     return-value
     5171     view-as alert-box error.
     5172     return error.
     5173   end.
     5174   case buf_fin-statement.fins-doc-type
     5175   :
     5176     when 'стд':U
     5177     then do:
     5178       if v-status_ = 'факт':U
     5179       then do:
     5180   define variable vss-include-info41 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5181   do:
     5182     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5183       (input  v-cntxt-db-num
     5184       ,input  v-cntxt-userid
     5185       ,input  0
     5186       ,input  'actn_standard-sttm_close-fact':U
     5187       ,input  'firm':U
     5188       ,input  buf_fin-statement.host-code
     5189       ,input  '':U
     5190       ,input  0
     5191       ,input  0
     5192       ,input  0
     5193       ,input  0
     5194       ,input  true
     5195       ,output OK
     5196       )  .
     5197   end.
     5198       end.
     5199       else do:
     5200         case p-close-mode
     5201         :
     5202           when '<закрытие документа>':U
     5203           then do:
     5204   define variable vss-include-info42 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5205   do:
     5206     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5207       (input  v-cntxt-db-num
