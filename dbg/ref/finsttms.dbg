     5596   PROCEDURE proc-print-list :
     5597   define variable v-doc-rec as recid no-undo .
     5598   define variable accum-count as integer.
     5599   define variable date_string     as      char    no-undo.
     5600   define variable Line            as      char    no-undo.
     5601   define variable v-curr-abbr as character no-undo.
     5602   DEFINE FRAME fin-statement-list
     5603   X_fin-statement.prn-doc-code FORMAT "X(22)"
     5604   X_fin-statement.code-schet COLUMN-LABEL "Вн.№счета"
     5605   X_fin-statement.start-date FORMAT "99/99/9999":U COLUMN-LABEL "С"
     5606   X_fin-statement.end-date FORMAT "99/99/9999":U COLUMN-LABEL "По"
     5607   X_fin-statement.doc-date
     5608   X_fin-statement.bank-date  COLUMn-LABEL "Дата прин!банком"
     5609   X_fin-statement.fact-date COLUMn-LABEL "Дата факт"
     5610   X_fin-statement.status_
     5611   X_fin-statement.sum-doc
     5612   X_fin-statement.cli-name COLUMN-LABEL "Назв.!плательщика" FORMAT "X(16)"
     5613   v-curr-abbr  COLUMN-LABEL "Вал" FORMAT "X(3)"
     5614   X_fin-statement.sttm-code COLUMN-LABEL "Вн.N" FORMAT "999999999":U
     5615   X_fin-statement.cl-bank COLUMN-LABEL "Кл-банк"
     5616   X_fin-statement.host-code COLUMN-LABEL "Код!фирмы"
     5617   HEADER  date_string AT 5 format "X(35)"
     5618    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5619   Line format "X(198)" AT 1
     5620   with width 232 down stream-io use-text    .
     5621   Line = fill("-", 198).
     5622   date_string = cur-time-print() .
     5623   run prn-lib-open-stream  in this-procedure (
     5624                                                input parParentProc
     5625                                               ,input 43
     5626                                               ,input yes
     5627                                               ,input no
     5628                                               ).
     5629   PUT  STREAM PrnLibStream
     5630   SPACE(25) ( frame Dialog-Frame:title + chr(32) + "Только отмеченные записи")
     5631   format "x(90)" SKIP(1) .
     5632   FORM HEADER
     5633   Line format "X(195)" AT 1 SKIP
     5634   "Продолжение - на следующей странице" AT 30 SKIP
     5635   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5636   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5637   FORM with FRAME fin-statement-list  .
     5638   run waitfram-show in this-procedure ( input "Ждите...").
     5639   v-doc-rec = recid(X_fin-statement).
     5640   DO WHILE available X_fin-statement :
     5641     GET prev br-fin-statement.
     5642   END.
     5643   GET next br-fin-statement.
     5644   DO WHILE available X_fin-statement :
     5645     if not t-batch or
     5646     mark-string (recid(X_fin-statement), input v-rid-list) = "*":U then do:
     5647       Display STREAM PrnLibStream
     5648       X_fin-statement.prn-doc-code
     5649       X_fin-statement.code-schet
     5650       X_fin-statement.start-date
     5651       X_fin-statement.end-date
     5652       X_fin-statement.doc-date
     5653       X_fin-statement.bank-date
     5654       X_fin-statement.fact-date
     5655       X_fin-statement.status_
     5656       X_fin-statement.sum-doc
     5657       X_fin-statement.cli-name
     5658       get-currency(buffer X_fin-statement) @ v-curr-abbr
     5659       X_fin-statement.sttm-code
     5660       X_fin-statement.cl-bank
     5661       X_fin-statement.host-code
     5662       with FRAME fin-statement-list .
     5663       DOWN STREAM PrnLibStream 1
     5664       with FRAME fin-statement-list  .
     5665     end.
     5666     assign
     5667     accum-count = accum-count + 1
     5668     .
     5669     GET next br-fin-statement.
     5670   END.
     5671   UNDERLINE  STREAM PrnLibStream
     5672   X_fin-statement.prn-doc-code
     5673   X_fin-statement.code-schet
     5674   X_fin-statement.start-date
     5675   X_fin-statement.end-date
     5676   X_fin-statement.doc-date
     5677   X_fin-statement.bank-date
     5678   X_fin-statement.fact-date
     5679   X_fin-statement.status_
     5680   X_fin-statement.sum-doc
     5681   X_fin-statement.cli-name
     5682   v-curr-abbr
     5683   X_fin-statement.sttm-code
     5684   X_fin-statement.cl-bank
     5685   X_fin-statement.host-code
     5686   with FRAME fin-statement-list .
     5687   DISPLAY STREAM PrnLibStream
     5688   "ИТОГО" @ X_fin-statement.host-code
     5689   accum-count @ X_fin-statement.prn-doc-code
     5690   with frame fin-statement-list.
     5691   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5692   HIDE  STREAM PrnLibStream FRAME fin-statement-List.
     5693   output  STREAM PrnLibStream CLOSE.
     5694   REPOSITION br-fin-statement to recid v-doc-rec no-error.
     5695   APPLY "entry" to br-fin-statement.
     5696   run waitfram-hide in this-procedure .
     5697   run prn-lib-prn-file in this-procedure (
     5698                                              input parParentProc
     5699                                             ,input 8
     5700                                             ).
     5701   END PROCEDURE.
     5702   PROCEDURE proc-print-one :
     5703   define variable v-doc-rec as recid no-undo .
     5704   define variable accum-count as integer no-undo .
     5705   define variable v-format as integer no-undo .
     5706   define variable ii as integer no-undo .
     5707   if not available X_fin-statement then return error.
     5708   define buffer buf_fin-statement  for ub.fin-statement.
     5709   CASE t-batch:
     5710     when no then do:
     5711       run rep/finsttmp.p (
     5712                       INPUT parParentProc
     5713                       ,input X_fin-statement.host-code
     5714                       ,input X_fin-statement.sttm-code
     5715                       ,input T-batch
     5716                       ,input no
     5717                       ,input-output v-format
     5718                     ) no-error.
     5719       if error-status:error then do:
     5720         return error.
     5721       end.
     5722     end.
     5723     when  yes then do:
     5724       if v-rid-list = "":U then do:
     5725           message
     5726           "Вы не отметили ни одной выписки"
     5727           view-as alert-box error.
     5728           return error.
     5729       end.
     5730       run waitfram-show in this-procedure ( input "Ждите...").
     5731       v-doc-rec = recid(X_fin-statement).
     5732       run prn-lib-open-stream  in this-procedure (
     5733                                                   input parParentProc
     5734                                                   ,input 43
     5735                                                   ,input yes
     5736                                                   ,input no
     5737                                                   ).
     5738       output  STREAM PrnLibStream CLOSE.
     5739       assign
     5740       v-format = ?
     5741       .
     5742       _do:
     5743       do ii = 1 to num-entries(v-rid-list):
     5744         find first buf_fin-statement no-lock where
     5745                   recid(buf_fin-statement) = integer(entry(ii, v-rid-list)) no-error .
     5746         if available buf_fin-statement then do:
     5747           run rep/finsttmp.p (
     5748                            INPUT parParentProc
     5749                           ,input buf_fin-statement.host-code
     5750                           ,input buf_fin-statement.sttm-code
     5751                           ,T-batch
     5752                           ,(if T-batch and (ii = num-entries(v-rid-list))
     5753                             then yes
     5754                             else no)
     5755                           ,input-output v-format
     5756                         ) no-error.
     5757           if error-status:error or v-format = ? then do:
     5758             next _do .
     5759           end.
     5760           assign
     5761           accum-count = accum-count + 1
     5762           .
     5763         end.
     5764       end.
     5765       run prn-lib-prn-file in this-procedure (
     5766                                                      input parParentProc
     5767                                                     ,input (if v-format = 0 then 0 else 8)
     5768                                                    ).
     5769       run waitfram-hide in this-procedure .
     5770       APPLY "entry" to br-fin-statement in frame Dialog-Frame .
     5771     end.
     5772   END CASE.
     5773   END PROCEDURE.
     5774   PROCEDURE proc-print-one-graphics :
     5775   define variable varxmldocfl      as character no-undo.
     5776   define variable varxmldocfl-type as character no-undo.
     5777   define variable for-dir as character no-undo .
     5778   define variable accum-count as integer no-undo .
     5779   define variable accum-count-ok as integer no-undo .
     5780   define variable loclog as logical no-undo .
     5781   define variable ii as integer no-undo .
     5782   define variable ii0 as integer no-undo .
     5783   define variable v-template-code as character no-undo .
     5784   define variable v-copy-nums as integer no-undo .
     5785   define variable v-add-info as character no-undo .
     5786   define variable v-full-path        as character no-undo .
     5787   define variable v-path             as character no-undo .
     5788   define variable v-file-name        as character no-undo .
     5789   define variable v-file-name-no-ext as character no-undo .
     5790   define variable v-file-name-ext    as character no-undo .
     5791   define buffer buf_fin-statement for ub.fin-statement.
     5792   if not available X_fin-statement then do:
     5793     message "Неправильный выбор документа.".
     5794     return no-apply.
     5795   end.
     5796   run gbl/filename.p (
     5797                   input "fxmlstt.bat"
     5798                   ,output v-full-path
     5799                   ,output v-path
     5800                   ,output v-file-name
     5801                   ,output v-file-name-no-ext
     5802                   ,output v-file-name-ext
     5803                   ) no-error .
     5804   if error-status:error  = ? then do:
     5805     message
     5806     substitute("Не найден командный файл для графической печати выписок fxmlstt.bat:&1 &2", chr(10), return-value )
     5807     view-as alert-box error .
     5808     return error .
     5809   end.
     5810   if t-batch then
     5811   ii0 = num-entries(v-rid-list).
     5812   else ii0 = 1.
     5813   run ref/finstcgp.w (
     5814                   input X_fin-statement.fins-doc-type
     5815                  ,input X_fin-statement.fins-ext-doc-type
     5816                  ,input ii0
     5817                  ,output v-template-code
     5818                  ,output v-copy-nums
     5819                  ,output v-add-info) no-error.
     5820   if error-status:error
     5821   or v-template-code = "":U
     5822   then do:
     5823     undo, return error.
     5824   end.
     5825   CASE t-batch:
     5826     when no then do:
     5827       assign
     5828       v-file-name = ?
     5829       .
     5830       run str/xmlfstt.p ( input X_fin-statement.host-code
     5831                          ,input X_fin-statement.sttm-code
     5832                          ,input-output v-file-name
     5833                          ,input yes
     5834                          ,input yes) no-error .
     5835       if not error-status:error then do:
     5836         os-command silent value(search ("fxmldoc.bat") + chr(32)
     5837                                        + v-full-path + chr(32)
     5838                                        + v-file-name + chr(32)
     5839                                        + v-template-code + chr(32)
     5840                                        + string(v-copy-nums) + chr(32)
     5841                                        + v-add-info
     5842                                        ).
     5843         if os-error = 0 then
     5844         assign
     5845         accum-count-ok = accum-count-ok + 1
     5846         .
     5847       end.
     5848     end.
     5849     when  yes then do:
     5850       if v-rid-list = "":U then do:
     5851           message
     5852           "Вы не отметили ни одного платежа"
     5853           view-as alert-box error.
     5854           return error.
     5855       end.
     5856       run waitfram-show in this-procedure ( input "Ждите...").
     5857       assign
     5858       v-doc-rec = recid(X_fin-statement)
     5859       .
     5860       _do:
     5861       do ii = 1 to ii0:
     5862         run waitfram-show in this-procedure ( input substitute("Ждите... Обрабатывается &1-й документ, всего &2", accum-count + 1, ii0)).
     5863         find first buf_fin-statement no-lock where
     5864                   recid(buf_fin-statement) = integer(entry(ii, v-rid-list)) no-error .
     5865         if available buf_fin-statement then do:
     5866           assign
     5867           accum-count = accum-count + 1
     5868           .
     5869           assign
     5870           v-file-name = ?
     5871           .
     5872           run str/xmlfstt.p (
     5873                           input buf_fin-statement.host-code
     5874                         , input buf_fin-statement.sttm-code
     5875                         , input-output v-file-name
     5876                         , input yes
     5877                         , input yes
     5878                         ) no-error .
     5879           if not error-status:error then do:
     5880             os-command silent value(search ("fxmldoc.bat") + chr(32)
     5881                                           + v-full-path + chr(32)
     5882                                           + v-file-name + chr(32)
     5883                                           + v-template-code + chr(32)
     5884                                           + string(v-copy-nums) + chr(32)
     5885                                           + v-add-info
     5886                                           ).
     5887             if os-error = 0 then
     5888             assign
     5889             accum-count-ok = accum-count-ok + 1
     5890             .
     5891           end.
     5892         end.
     5893       end.
     5894       run waitfram-hide in this-procedure .
     5895     end.
     5896   END CASE.
     5897   if error-status:error
     5898   or (t-batch and accum-count <> accum-count-ok)
     5899   then do:
     5900     message
     5901     "Ошибка при печати платежа(-ей) в графике" skip
     5902     string(if t-batch then substitute("Напечатано &1 платежей из &2", accum-count-ok, accum-count) else "":U)
     5903     view-as alert-box .
     5904     if not t-batch then
     5905     return error .
     5906   end.
     5907   END PROCEDURE.
     5908   FUNCTION get-currency RETURNS CHARACTER
     5909     ( BUFFER loc-fin-statement FOR ub.fin-statement ) :
     5910    define buffer buf_currency for ub.currency.
     5911     find first buf_currency no-lock where
     5912                   buf_currency.curr-code = loc-fin-statement.curr-code no-error.
     5913       if available buf_currency then return buf_currency.curr-abbr.
     5914     RETURN string(loc-fin-statement.curr-code).
     5915   END FUNCTION.
