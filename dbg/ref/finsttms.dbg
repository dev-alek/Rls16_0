     1194          MENU-ITEM m_one-graphics LABEL "Один-графика"
     1195          MENU-ITEM m_list         LABEL "Список"        .
     1196   DEFINE BUTTON B-add
     1197        LABEL "&Добавить"
     1198        SIZE 10 BY 1.
     1199   DEFINE BUTTON B-attr
     1200        LABEL "&Аттриб."
     1201        SIZE 10 BY 1.
     1202   DEFINE BUTTON B-chg
     1203        LABEL "&Изменить"
     1204        SIZE 10 BY 1.
     1205   DEFINE BUTTON B-close
     1206        LABEL "&Закрыть"
     1207        SIZE 10 BY 1.
     1208   DEFINE BUTTON B-curr
     1209        IMAGE-UP FILE "btn-down-arrow":U
     1210        IMAGE-DOWN FILE "btn-down-arrow":U
     1211        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1212        LABEL "Btn 1"
     1213        SIZE 3 BY 1.
     1214   DEFINE BUTTON B-del
     1215        LABEL "&Удалить"
     1216        SIZE 10 BY 1.
     1217   DEFINE BUTTON B-exp
     1218        LABEL "&Экспорт"
     1219        SIZE 10 BY 1.
     1220   DEFINE BUTTON B-Help
     1221        LABEL "Помо&щь"
     1222        SIZE 3 BY 1
     1223        BGCOLOR 8 .
     1224   DEFINE BUTTON B-hist
     1225        LABEL "Ис&тория"
     1226        SIZE 3 BY 1.
     1227   DEFINE BUTTON b-lkp
     1228        LABEL "&Просмотр"
     1229        SIZE 10 BY 1.
     1230   DEFINE BUTTON B-mark
     1231        LABEL "&*"
     1232        SIZE 3 BY 1.
     1233   DEFINE BUTTON B-open
     1234        LABEL "&Открыть"
     1235        SIZE 10 BY 1.
     1236   DEFINE BUTTON B-print
     1237        LABEL "Пе&чать"
     1238        SIZE 3 BY 1.
     1239   DEFINE BUTTON b-quit AUTO-END-KEY
     1240        LABEL "&Выход"
     1241        SIZE 10 BY 1
     1242        BGCOLOR 8 .
     1243   DEFINE BUTTON B-reject
     1244        LABEL "&-Отказ"
     1245        SIZE 10 BY 1.
     1246   DEFINE BUTTON B-sch
     1247        LABEL "&Фильтр"
     1248        SIZE 3 BY 1.
     1249   DEFINE BUTTON B-schet
     1250        LABEL "&Счет"
     1251        SIZE 10 BY 1.
     1252   DEFINE BUTTON b-sel AUTO-GO
     1253        LABEL "Вы&бор"
     1254        SIZE 10 BY 1
     1255        BGCOLOR 8 .
     1256   DEFINE VARIABLE ED-notes AS CHARACTER
     1257        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1258        SIZE 98 BY 2
     1259        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1260   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1261         VIEW-AS TEXT
     1262        SIZE 6 BY 1
     1263        FGCOLOR 4  NO-UNDO.
     1264   DEFINE VARIABLE sch-bank-date AS DATE FORMAT "99/99/9999":U
     1265        LABEL "Дате банка."
     1266        VIEW-AS FILL-IN
     1267        SIZE 11 BY 1 NO-UNDO.
     1268   DEFINE VARIABLE sch-BIK AS CHARACTER FORMAT "X(9)":U
     1269        LABEL "БИК"
     1270        VIEW-AS FILL-IN
     1271        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1272   DEFINE VARIABLE sch-curr-code AS INTEGER FORMAT ">>9":U INITIAL 0
     1273        LABEL "коду вал"
     1274        VIEW-AS FILL-IN
     1275        SIZE 4 BY 1 NO-UNDO.
     1276   DEFINE VARIABLE sch-doc-date AS DATE FORMAT "99/99/9999":U
     1277        LABEL "Дате док-та"
     1278        VIEW-AS FILL-IN
     1279        SIZE 11 BY 1 NO-UNDO.
     1280   DEFINE VARIABLE sch-fact-date AS DATE FORMAT "99/99/9999":U
     1281        LABEL "Дате факт."
     1282        VIEW-AS FILL-IN
     1283        SIZE 11 BY 1 NO-UNDO.
     1284   DEFINE VARIABLE sch-prn-doc-code AS CHARACTER FORMAT "X(22)":U
     1285        LABEL "номеру"
     1286        VIEW-AS FILL-IN
     1287        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1288   DEFINE VARIABLE sch-r-schet AS CHARACTER FORMAT "X(35)":U
     1289        LABEL "Расч.счет"
     1290        VIEW-AS FILL-IN
     1291        SIZE 22 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1292   DEFINE VARIABLE T-batch AS LOGICAL INITIAL no
     1293        LABEL "Пктн.рж"
     1294        VIEW-AS TOGGLE-BOX
     1295        SIZE 10.5 BY 1 TOOLTIP "Пакетная обработка выбранных выписок" NO-UNDO.
     1296   DEFINE NEW SHARED QUERY br-fin-statement FOR
     1297         X_fin-statement SCROLLING.
     1298   DEFINE BROWSE br-fin-statement
     1299     QUERY br-fin-statement DISPLAY
     1300         mark-string(recid(X_fin-statement), v-rid-list) FORMAT "X(1)":U
     1301   WIDTH 2
     1302   X_fin-statement.host-code COLUMN-LABEL "Код!фирмы" FORMAT "99999":U
     1303   X_fin-statement.prn-doc-code FORMAT "X(22)":U
     1304   X_fin-statement.fins-ext-doc-type COLUMN-LABEL "Расш.тип" FORMAT "X(8)":U
     1305   X_fin-statement.code-schet COLUMN-LABEL "Вн.№счета"
     1306   X_fin-statement.start-date FORMAT "99/99/9999":U COLUMN-LABEL "С"
     1307   X_fin-statement.end-date FORMAT "99/99/9999":U COLUMN-LABEL "По"
     1308   X_fin-statement.status_ FORMAT "X(8)":U
     1309   X_fin-statement.bank-date COLUMN-LABEL "Дата банка!(пост.из банка)" FORMAT "99/99/9999":U
     1310   X_fin-statement.fact-date FORMAT "99/99/9999":U
     1311   X_fin-statement.sum-doc FORMAT "->,>>>,>>>,>>>,>>9.99":U
     1312   X_fin-statement.cli-name COLUMN-LABEL "Название держателя счета" FORMAT "X(255)":U WIDTH 20
     1313   get-currency(buffer X_fin-statement) COLUMN-LABEL "Вал" FORMAT "X(3)":U
     1314   X_fin-statement.sttm-code COLUMN-LABEL "Вн.N" FORMAT "999999999":U
     1315   X_fin-statement.cl-bank COLUMN-LABEL "Кл-банк" FORMAT "X(8)"
     1316   ENABLE
     1317   X_fin-statement.prn-doc-code
     1318       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 14.37.
     1319   DEFINE FRAME Dialog-Frame
     1320        b-quit AT ROW 1 COL 1
     1321        B-mark AT ROW 1 COL 11
     1322        b-sel AT ROW 1 COL 21
     1323        B-add AT ROW 1 COL 41
     1324        b-lkp AT ROW 1 COL 51
     1325        B-chg AT ROW 1 COL 61
     1326        B-del AT ROW 1 COL 71
     1327        B-print AT ROW 1 COL 86
     1328        B-hist AT ROW 1 COL 89
     1329        B-sch AT ROW 1 COL 92
     1330        B-Help AT ROW 1 COL 95
     1331        T-batch AT ROW 2 COL 1
     1332        B-close AT ROW 2 COL 21
     1333        B-open AT ROW 2 COL 31
     1334        B-reject AT ROW 2 COL 41
     1335        B-schet AT ROW 2 COL 51
     1336        B-attr AT ROW 2 COL 61
     1337        B-exp AT ROW 2 COL 71
     1338        br-fin-statement AT ROW 3.03 COL 1.4
     1339        ED-notes AT ROW 17.5 COL 1 NO-LABEL
     1340        sch-prn-doc-code AT ROW 19.57 COL 16 COLON-ALIGNED
     1341        sch-doc-date AT ROW 19.57 COL 38.1 COLON-ALIGNED
     1342        sch-fact-date AT ROW 19.57 COL 62 COLON-ALIGNED
     1343        sch-bank-date AT ROW 19.57 COL 86 COLON-ALIGNED
     1344        sch-r-schet AT ROW 20.8 COL 75.3 COLON-ALIGNED
     1345        sch-curr-code AT ROW 20.93 COL 9 COLON-ALIGNED
     1346        B-curr AT ROW 20.93 COL 15.5
     1347        sch-BIK AT ROW 20.93 COL 27.5 COLON-ALIGNED
     1348        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1349        "ПОИСК ПО" VIEW-AS TEXT
     1350             SIZE 8.4 BY 1 AT ROW 19.57 COL 1
     1351        SPACE(89.90) SKIP(1.46)
     1352       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1353            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1354            TITLE "Список выписок"
     1355            CANCEL-BUTTON b-quit.
     1356   ASSIGN
     1357          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1358          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1359   ASSIGN
     1360          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
     1361   ASSIGN
     1362          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     1363   ASSIGN
     1364          br-fin-statement:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1365   ON ENDKEY OF FRAME Dialog-Frame
     1366   DO:
     1367     run gbl/markqwa.p (
     1368                           input b-mark:sensitive
     1369                         , input v-rid-list) no-error.
     1370     if error-status:error then return no-apply.
     1371   END.
     1372   ON GO OF FRAME Dialog-Frame
     1373   DO:
     1374     p-rid-list = v-rid-list.
     1375   END.
     1376   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1377   DO:
     1378     if add-option = '':U then do:
     1379       run gbl/pop-up.p ( input self:handle
     1380                         ,input no) no-error.
     1381     end.
     1382     if add-option = '':U then return no-apply.
     1383     run proc-b-add in this-procedure ( input add-option) no-error.
     1384     if error-status:error then do:
     1385       add-option = (if is-type-mode then p-fins-doc-type else  '':U).
     1386       return no-apply.
     1387     end.
     1388     APPLY "ENTRY" to br-fin-statement.
     1389   END.
     1390   ON CHOOSE OF B-attr IN FRAME Dialog-Frame
     1391   DO:
     1392   define variable loc-doc-rec as recid no-undo .
     1393     if  available X_fin-statement then do:
     1394       run ref/fd-atti.w (  input parparentproc
     1395                           ,input 'ПРОСМОТР':U
     1396                           ,input X_fin-statement.host-code
     1397                           ,input X_fin-statement.sttm-code
     1398                         ) NO-ERROR.
     1399       apply "entry" to br-fin-statement in frame Dialog-Frame.
     1400     end.
     1401   END.
     1402   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1403   DO:
     1404   if not available X_fin-statement then return no-apply.
     1405   run proc-b-chg-lookup in this-procedure ( input 'ИЗМЕНЕНИЕ':U) no-error.
     1406   if error-status:error then do:
     1407     return no-apply.
     1408   end.
     1409   END.
     1410   ON CHOOSE OF B-close IN FRAME Dialog-Frame
     1411   DO:
     1412     if not available X_fin-statement then return no-apply.
     1413     run proc-close-open in this-procedure ( input '<закрытие документа>':U
     1414                                           , input t-batch) no-error.
     1415     if error-status:error then return no-apply.
     1416   END.
     1417   ON CHOOSE OF B-curr IN FRAME Dialog-Frame
     1418   DO:
     1419   define variable rr as recid no-undo.
     1420   define buffer buf_currency for ub.currency.
     1421       rr = ? .
     1422       run ref/currency.w (
     1423                           input parparentproc
     1424                          ,input "b-sel"
     1425                          ,input-output rr ).
     1426       if rr <> ? then do:
     1427         FIND FIRST buf_currency WHERE
     1428               recid( buf_currency ) = rr NO-LOCK .
     1429         DISPLAY
     1430         buf_currency.curr-code @ sch-curr-code
     1431         with frame Dialog-Frame .
     1432       end.
     1433   END.
     1434   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1435   DO:
     1436     run proc-b-del in this-procedure ( input t-batch) no-error.
     1437     if error-status:error then return no-apply.
     1438   END.
     1439   ON CHOOSE OF B-exp IN FRAME Dialog-Frame
     1440   DO:
     1441     RUN proc-b-exp IN THIS-PROCEDURE NO-ERROR.
     1442     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1443   END.
     1444   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1445   DO:
     1446   define variable loc-doc-rec as recid no-undo .
     1447   define variable v-rid-list as character no-undo.
     1448     if available X_fin-statement then do:
     1449         loc-doc-rec = recid (X_fin-statement).
     1450       .
     1451       run ref/fincstts.w
     1452                     (
     1453                      input parParentProc
     1454                     ,input p-curr-host-code
     1455                     ,input "":U
     1456                     ,input "one":U
     1457                     ,input X_fin-statement.host-code
     1458                     ,input X_fin-statement.sttm-code
     1459                     ,input X_fin-statement.code-schet
     1460                     ,input-output v-rid-list
     1461                                   )
     1462       .
     1463       reposition br-fin-statement to recid loc-doc-rec no-error.
     1464       apply "entry" to br-fin-statement in frame Dialog-Frame.
     1465       apply "value-changed" to br-fin-statement in frame Dialog-Frame.
     1466     end.
     1467   END.
     1468   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1469   DO:
     1470   if not available X_fin-statement then return no-apply.
     1471   run proc-b-chg-lookup in this-procedure ( input 'ПРОСМОТР':U) no-error.
     1472   if error-status:error then do:
     1473     return no-apply.
     1474   end.
     1475   END.
     1476   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1477   DO:
     1478   define variable loc#log as logical no-undo .
     1479     if available X_fin-statement then do:
     1480   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1481   define variable v-str-recid11 as character no-undo .
     1482   define variable v-num-entry11 as integer   no-undo .
     1483   assign
     1484     v-str-recid11 = trim( string( recid( X_fin-statement ) , "->>>>>>>>>>>9":U ) )
     1485     v-num-entry11 = lookup( v-str-recid11 , v-rid-list )
     1486   .
     1487   if v-num-entry11 > 0 then do:
     1488     assign
     1489       entry( v-num-entry11, v-rid-list ) = "":U
     1490       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1491     .
     1492   end.
     1493   else do:
     1494     assign
     1495       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid11
     1496     .
     1497   end.
     1498       loc#log = br-fin-statement:refresh() .
     1499       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1500           loc#log = br-fin-statement:select-next-row ().
     1501           apply "VALUE-CHANGED" to br-fin-statement in frame Dialog-Frame.
     1502       end.
     1503       if num-entries( v-rid-list ) = 0
     1504       then
     1505           hide mark-num in frame Dialog-Frame.
     1506       else
     1507           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1508     end.
     1509     apply "entry" to br-fin-statement in frame Dialog-Frame.
     1510   END.
     1511   ON CHOOSE OF B-open IN FRAME Dialog-Frame
     1512   DO:
     1513     if not available X_fin-statement then return no-apply.
     1514     run proc-close-open in this-procedure ( '<открытие документа>':U, input t-batch ) no-error .
     1515     if error-status:error then return no-apply.
     1516   END.
     1517   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1518   DO:
     1519     if not avail X_fin-statement then return no-apply.
     1520     if print-option = '':U then do:
     1521        run gbl/pop-up.p ( input self:handle
     1522                          ,input no) no-error.
     1523     end.
     1524     if print-option = '':U then return no-apply.
     1525     run proc-b-print in this-procedure ( input print-option) no-error.
     1526     if error-status:error then do:
     1527       print-option = '':U.
     1528       return no-apply.
     1529     end.
     1530     APPLY "ENTRY" to br-fin-statement.
     1531   END.
     1532   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1533   DO:
     1534       assign
     1535       v-uf-List_ = string(recid(X_fin-statement))
     1536       .
     1537       run uf-set in this-procedure (
     1538          input  ('finsttms-p':U + chr(4) + uf-convert-mode(p-mode))
     1539         ,input  g#userid
     1540         ,input v-uf-List_
     1541         ,input v-uf-Naim
     1542         ,input v-uf-print-graft
     1543         ,input v-uf-sort-gr
     1544         ,input v-uf-type-price
     1545         ,input v-uf-type-val
     1546     )  no-error .
     1547   END.
     1548   ON CHOOSE OF B-reject IN FRAME Dialog-Frame
     1549   DO:
     1550     if not available X_fin-statement then return no-apply.
     1551     run proc-close-open in this-procedure ( input '<отказ от документа>':U
     1552                                           , input t-batch) no-error .
     1553     if error-status:error then return no-apply.
     1554   END.
     1555   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1556   DO:
     1557     run proc-b-sch in this-procedure no-error.
     1558     if error-status:error then return no-apply.
     1559   END.
     1560   ON CHOOSE OF B-schet IN FRAME Dialog-Frame
     1561   DO:
     1562   define variable loc-doc-rec as recid no-undo.
     1563   if not available X_fin-statement then return no-apply.
     1564   run ref/finschti.w
     1565                 (
     1566                    input parParentProc
     1567                   ,input p-curr-host-code
     1568                   ,input 'ПРОСМОТР':U
     1569                   ,input X_fin-statement.host-code
     1570                   ,input X_fin-statement.code-schet
     1571                   ,input X_fin-statement.code-bank
     1572                   ,input 'орг':U
     1573                   ,input X_fin-statement.host-code
     1574                   ,input X_fin-statement.curr-code
     1575                   ,input-output loc-doc-rec
     1576                               )
     1577   .
     1578    schet-option = '':U.
     1579    APPLY "ENTRY" to br-fin-statement.
     1580   END.
     1581   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1582   DO:
     1583     if ( available X_fin-statement ) then do:
     1584       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1585       then
     1586       v-rid-list = string( recid( X_fin-statement ) ) .
     1587     end.
     1588   END.
     1589   ON RETURN OF br-fin-statement IN FRAME Dialog-Frame
     1590   or MOUSE-SELECT-DBLCLICK OF br-fin-statement IN FRAME Dialog-Frame
     1591   DO:
     1592     run proc-br-fin-statement no-error.
     1593     if error-status:error then return no-apply.
     1594   END.
     1595   ON VALUE-CHANGED OF br-fin-statement IN FRAME Dialog-Frame
     1596   DO:
     1597     DEFINE VARIABLE dops as character no-undo .
     1598     dops = if available X_fin-statement then X_fin-statement.ps else '':U.
     1599     ED-notes:screen-value = dops.
     1600   END.
     1601   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1602   DO:
     1603     define buffer ps_fin-statement for ub.fin-statement.
     1604     if not available X_fin-statement then return no-apply.
     1605      DO on stop undo, return no-apply:
     1606         FIND PS_fin-statement where
     1607              recid (ps_fin-statement) = recid(X_fin-statement) exclusive.
     1608         if ps_fin-statement.PS <> input frame Dialog-Frame ed-notes then
     1609         assign
     1610         ps_fin-statement.PS = input frame Dialog-Frame ed-notes
     1611         .
     1612      END.
     1613   END.
     1614   ON CHOOSE OF MENU-ITEM m_list
     1615   DO:
     1616      assign
     1617     print-option = 'LIST':U.
     1618     APPLY "CHOOSE" to b-print  in frame Dialog-Frame.
     1619   END.
     1620   ON CHOOSE OF MENU-ITEM m_one
     1621   DO:
     1622      assign
     1623     print-option = 'ONE':U.
     1624     APPLY "CHOOSE" to b-print  in frame Dialog-Frame.
     1625   END.
     1626   ON CHOOSE OF MENU-ITEM m_one-graphics
     1627   DO:
     1628      assign
     1629     print-option = 'ONE-GRAPHICS':U.
     1630     APPLY "CHOOSE" to b-print  in frame Dialog-Frame.
     1631   END.
     1632   ON CTRL-J OF sch-bank-date IN FRAME Dialog-Frame
     1633   DO:
     1634     run proc-find-date in this-procedure ( input no
     1635                                          , input frame Dialog-Frame sch-bank-date
     1636                                          , input "bank-date":U) no-error.
     1637     if error-status:error then return no-apply.
     1638   END.
     1639   ON RETURN OF sch-bank-date IN FRAME Dialog-Frame
     1640   DO:
     1641     run proc-find-date in this-procedure ( input yes
     1642                                          , input frame Dialog-Frame sch-bank-date
     1643                                          , input "bank-date":U) no-error.
     1644     if error-status:error then return no-apply.
     1645   END.
     1646   ON CTRL-J OF sch-BIK IN FRAME Dialog-Frame
     1647   DO:
     1648     run proc-find-bik in this-procedure (  input yes
     1649                                          , input frame Dialog-Frame sch-bik) no-error.
     1650     if error-status:error then return no-apply.
     1651   END.
     1652   ON RETURN OF sch-BIK IN FRAME Dialog-Frame
     1653   DO:
     1654     run proc-find-bik in this-procedure ( input no
     1655                                         , input frame Dialog-Frame sch-bik) no-error.
     1656     if error-status:error then return no-apply.
     1657   END.
     1658   ON CTRL-J OF sch-curr-code IN FRAME Dialog-Frame
     1659   DO:
     1660     run proc-find-curr-code in this-procedure ( input yes
     1661                                               , input frame Dialog-Frame sch-curr-code) no-error.
     1662     if error-status:error then return no-apply.
     1663   END.
     1664   ON RETURN OF sch-curr-code IN FRAME Dialog-Frame
     1665   DO:
     1666      run proc-find-curr-code in this-procedure ( input no
     1667                                                , input frame Dialog-Frame sch-curr-code) no-error.
     1668     if error-status:error then return no-apply.
     1669   END.
     1670   ON CTRL-J OF sch-doc-date IN FRAME Dialog-Frame
     1671   DO:
     1672      run proc-find-date in this-procedure ( input yes
     1673                                           , input frame Dialog-Frame sch-doc-date, "doc-date":U) no-error.
     1674     if error-status:error then return no-apply.
     1675   END.
     1676   ON RETURN OF sch-doc-date IN FRAME Dialog-Frame
     1677   DO:
     1678     run proc-find-date in this-procedure ( input no
     1679                                          , input frame Dialog-Frame sch-doc-date
     1680                                          , input "doc-date":U) no-error.
     1681     if error-status:error then return no-apply.
     1682   END.
     1683   ON CTRL-J OF sch-fact-date IN FRAME Dialog-Frame
