     5258       ,input  0
     5259       ,input  0
     5260       ,input  true
     5261       ,output OK
     5262       )  .
     5263   end.
     5264           end.
     5265           otherwise do:
     5266             message
     5267               "Ошибка при проверке возможности" p-close-mode skip
     5268               "Неизвестное значение p-close-mode" skip
     5269               view-as alert-box error.
     5270             return error.
     5271           end.
     5272         end case .
     5273       end.
     5274     end.
     5275     otherwise do:
     5276       message
     5277         "Ошибка при проверке возможности" p-close-mode skip
     5278         "Неизвестный тип банковской выписки" buf_fin-statement.fins-doc-type skip
     5279         view-as alert-box error.
     5280       return error.
     5281     end.
     5282   end case .
     5283   if not ok then return error.
     5284   ok = no.
     5285   message
     5286   v-ask-message skip(1)
     5287   (if t-batch
     5288   then
     5289   substitute("Все платежи, которые Вы отметили, но которые к настоящему моменту не находятся в статусе <&1>,&2 &3 обработаны не будут "
     5290               , v-old-status_
     5291               , chr(10)
     5292               , (if is-type-mode = no
     5293                 then substitute("или не имеют типа <&1>,", v-fins-doc-type)
     5294                 else "":U)
     5295               )
     5296     else "":U
     5297   )
     5298   view-as alert-box QUESTION buttons Yes-NO update ok.
     5299   if not ok then return error.
     5300   if v-ask-date then do:
     5301     run cur-time in this-procedure ( output v-date, output v-time).
     5302     assign
     5303     v-status-date-chr = string(v-date, "99/99/9999":U)
     5304     .
     5305     run gbl/d-prompt.w (
     5306         'title=':u + "Введите дату смены статуса платежа" + '\':u
     5307       + 'text1=':u + "Дата смены статуса" + '\':u
     5308       + 'format=99/99/9999\'
     5309       + 'type=' + 'T':U + '\':u
     5310       + 'fillin_row=2\':u
     5311       + 'fillin_col=4\':u
     5312       + 'fillin_width=20\':u
     5313       + 'fillin_height=1\':u
     5314       + 'max-chars=70\':u
     5315       + 'readonly=no\'
     5316       , input-output v-status-date-chr
     5317       ).
     5318     if return-value = 'false':u then return error.
     5319     assign
     5320     v-date = date(integer(substr(v-status-date-chr, 4, 2)),
     5321                   integer(substr(v-status-date-chr, 1, 2)),
     5322                   integer(substr(v-status-date-chr, 7, 4))
     5323                  )
     5324     no-error .
     5325     if error-status:error then do:
     5326       message
     5327       "Неверная дата для смены статуса"
     5328       view-as alert-box error .
     5329       return error.
     5330     end.
     5331   end.
     5332   run waitfram-show in this-procedure ( input "Ждите..." ).
     5333   CASE t-batch:
     5334     when no then do:
     5335       run trg/finsstat.p (
     5336                        input buf_fin-statement.host-code
     5337                       ,input buf_fin-statement.sttm-code
     5338                       ,input p-close-mode
     5339                       ,input '':U
     5340                       ,input v-status_
     5341                       ,input-output v-date
     5342                       ,input no
     5343                      ) no-error .
     5344       if error-status:error then do:
     5345         run waitfram-hide in this-procedure .
     5346         if error-status:get-message(1) <> "":u then
     5347         message
     5348         error-status:get-message(1)  skip
     5349         return-value view-as alert-box .
     5350         return error .
     5351       end.
     5352       run waitfram-hide in this-procedure .
     5353       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5354       reposition br-fin-statement to recid v-doc-rec No-ERROR.
     5355     end.
     5356     when yes then do:
     5357       _do1:
     5358       do ii = 1 to num-entries(v-rid-list):
     5359         run waitfram-show in this-procedure ( input substitute("Обрабатывается &1 платеж списка", ii)).
     5360         find first buf_fin-statement where
     5361                   recid(buf_fin-statement) = integer(entry(ii, v-rid-list)) exclusive-lock no-error .
     5362         if not avail buf_fin-statement
     5363         or (avail buf_fin-statement and buf_fin-statement.status_ <> v-old-status_)
     5364         or (avail buf_fin-statement and buf_fin-statement.fins-doc-type <> v-fins-doc-type)
     5365         then DO:
     5366           assign
     5367           v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(ii, v-rid-list)
     5368           .
     5369           NEXT _do1.
     5370         END.
     5371         run trg/finsstat.p (
     5372                        input buf_fin-statement.host-code
     5373                       ,input buf_fin-statement.sttm-code
     5374                       ,input p-close-mode
     5375                       ,input '':U
     5376                       ,input v-status_
     5377                       ,input-output v-date
     5378                       ,input no
     5379                       ) no-error .
     5380         if error-status:error then do:
     5381           assign
     5382           v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(ii, v-rid-list)
     5383           .
     5384           NEXT _do1 .
     5385         end.
     5386         assign
     5387         ok-ii = ok-ii + 1
     5388         v-new-rid-list = v-new-rid-list
     5389         .
     5390       end.
     5391       run waitfram-hide in this-procedure .
     5392       assign
     5393       v-rid-list = v-new-rid-list
     5394       .
     5395       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5396       reposition br-fin-statement to recid v-doc-rec No-ERROR.
     5397       message
     5398       substitute("Из &1 выбранных Вами платежей удалось сменить статус на &2 у &3 платежей", ii - 1, v-status_, ok-ii)
     5399       view-as alert-box.
     5400     end.
     5401   END CASE.
     5402   END PROCEDURE.
     5403   PROCEDURE proc-find-bik :
     5404   define input parameter p-next as logical no-undo.
     5405   define input parameter p-bik like ub.fin-statement.bik no-undo.
     5406   assign
     5407   sch-doc-date = ?
     5408   sch-bank-date = ?
     5409   sch-fact-date = ?
     5410   .
     5411   display
     5412   "":U @ sch-prn-doc-code
     5413   0 @ sch-curr-code
     5414   sch-doc-date
     5415   sch-fact-date
     5416   sch-bank-date
     5417   with frame Dialog-Frame.
     5418   display
     5419   "":U @ sch-r-schet
     5420   with frame Dialog-Frame .
     5421   assign
     5422   p-bik = replace(p-bik, chr(34), "":U)
     5423   p-bik = replace(p-bik, chr(39), chr(39) + chr(39))
     5424   p-bik = chr(34) + p-bik + chr(34).
     5425   run OpenBr in this-procedure
     5426       ( input false
     5427        ,input p-next
     5428        ,input substitute("and X_fin-statement.bik   begins &1 "
     5429                         , p-bik)
     5430       ).
     5431   apply "entry":u to sch-bik in frame Dialog-Frame .
     5432   END PROCEDURE.
