      137     run proc-alt-f1 in this-procedure .
      138   end.
      139   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   define variable c-point  as character no-undo .
      141   define variable tbl      as character no-undo .
      142   define variable join-tbl as character no-undo .
      143   define variable fld      as character no-undo .
      144   define variable lab      as character no-undo .
      145   define variable spr      as character no-undo .
      146   define variable dim      as character no-undo .
      147   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   procedure cur-time :
      149      define output parameter p-today as date      no-undo .
      150      define output parameter p-time  as integer   no-undo .
      151     do
      152     on error undo, return error
      153     :
      154       define variable v-date1 as date      no-undo .
      155       define variable v-date2 as date      no-undo .
      156       define variable v-time  as integer   no-undo .
      157       assign
      158         v-date1 = today
      159         v-time  = time
      160         v-date2 = today
      161       .
      162       if v-date1 <> v-date2
      163       then do:
      164         assign
      165           v-date1 = today
      166           v-time  = v-time
      167         .
      168       end.
      169       assign
      170         p-today = v-date1
      171         p-time  = v-time
      172       .
      173     end.
      174   end.
      175   function cur-time-date returns character
      176   :
      177     return string(today, '99/99/9999':U) .
      178   end.
      179   function cur-time-mjd returns decimal
      180   :
      181     define variable v-date as date      no-undo .
      182     define variable v-time as integer   no-undo .
      183     run cur-time in this-procedure
      184       (output v-date
      185       ,output v-time
      186       ) .
      187     return integer(v-date) - 2400002 + (v-time / 86400) .
      188   end.
      189   function cur-time-get-ending-index returns integer
      190   (input p-number as integer
      191   )
      192   :
      193     if p-number < 0
      194     or p-number = ?
      195     then do:
      196       return 1 .
      197     end.
      198     define variable v-rest as integer   no-undo .
      199     assign
      200       p-number = p-number modulo 100
      201     .
      202     if p-number < 20
      203     then do:
      204       assign
      205         v-rest = p-number
      206       .
      207     end.
      208     else do:
      209       assign
      210         v-rest = p-number modulo 10
      211       .
      212     end.
      213     case v-rest :
      214       when 1
      215       then do:
      216         return 2 .
      217       end.
      218       when 2 or
      219       when 3 or
      220       when 4
      221       then do:
      222         return 3 .
      223       end.
      224       otherwise do:
      225         return 1 .
      226       end.
      227     end case .
      228   end.
      229   procedure cur-time-mjd-to-date :
      230      define input  parameter i-mjd-diff as decimal no-undo.
      231      define output parameter o-Date     as date    no-undo.
      232      define output parameter o-Time     as integer no-undo.
      233      define variable v-day-number as integer   no-undo .
      234      if    i-mjd-diff < 0
      235         or i-mjd-diff = ?
      236      then do:
      237         return "?" .
      238      end.
      239      assign
      240         v-day-number = truncate(i-mjd-diff,0).
      241         o-Date = date(v-day-number + 2400002).
      242         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      243     .
      244   end.
      245   function cur-time-mjd-to-string returns character
      246   (input p-mjd-diff as decimal
      247   )
      248   :
      249     define variable v-day-number as integer   no-undo .
      250     define variable v-seconds    as integer   no-undo .
      251     define variable v-hour       as integer   no-undo .
      252     define variable v-min        as integer   no-undo .
      253     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      254     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      255     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      256     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      257     if p-mjd-diff < 0
      258     or p-mjd-diff = ?
      259     then do:
      260       return "?" .
      261     end.
      262     assign
      263       v-day-number = integer(truncate(p-mjd-diff,0))
      264       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      265     .
      266     if v-seconds > 86400
      267     then do:
      268       assign
      269         v-seconds = 86400 - 1
      270       .
      271     end.
      272     if v-seconds < 0
      273     then do:
      274       assign
      275         v-seconds = 0
      276       .
      277     end.
      278     assign
      279       v-hour = truncate(v-seconds / 3600, 0)
      280     .
      281     assign
      282       v-seconds = v-seconds modulo 3600
      283     .
      284     assign
      285       v-min = truncate(v-seconds / 60, 0)
      286     .
      287     assign
      288       v-seconds = v-seconds modulo 60
      289     .
      290     return
      291         (if v-day-number <> 0
      292           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      293           else ""
      294         )
      295       + (if v-day-number <> 0 or v-hour <> 0
      296           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      297           else ""
      298         )
      299       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      300           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      301           else ""
      302         )
      303       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      304       .
      305   end.
      306   function cur-time-string returns character
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      315   end.
      316   function cur-time-string-sec returns character
      317   :
      318     define variable v-date as date      no-undo .
      319     define variable v-time as integer   no-undo .
      320     run cur-time in this-procedure
      321       (output v-date
      322       ,output v-time
      323       ) .
      324     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      325   end.
      326   function cur-time-custom  returns character
      327   (input p-prefix as character
      328   ,input p-date-format as character
      329   ,input p-delimiter as character
      330   ,input p-time-format as character
      331   ,input p-suffix as character
      332   )
      333   :
      334     define variable v-date as date      no-undo .
      335     define variable v-time as integer   no-undo .
      336     run cur-time in this-procedure
      337       (output v-date
      338       ,output v-time
      339       ) .
      340     return
      341       p-prefix
      342       + string(v-date, p-date-format)
      343       + p-delimiter
      344       + string(v-time, p-time-format)
      345       + p-suffix
      346       .
      347   end.
      348   function cur-time-print  returns character
      349   :
      350     define variable v-date as date      no-undo .
      351     define variable v-time as integer   no-undo .
      352     run cur-time in this-procedure
      353       (output v-date
      354       ,output v-time
      355       ) .
      356     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      357   end.
      358   function cur-time-datetime returns datetime
      359   :
      360     define variable v-char as character no-undo .
      361     define variable v-datetime as datetime no-undo .
      362     v-char = cur-time-string().
      363     v-datetime = datetime(v-char).
      364     return  v-datetime.
      365   end.
      366   function cur-time-string-msec returns character
      367   :
      368     define variable v-date as datetime  no-undo .
      369     v-date = now.
      370     return string(v-date) .
      371   end.
      372   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      374   define new shared variable RepPathName        as character no-undo .
      375   define new shared variable PrintRubl          as logical   no-undo .
      376   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define variable v-waitfram-action01         as character   no-undo .
      378   define variable v-waitfram-action02         as character   no-undo .
      379   define variable v-waitfram-action03         as character   no-undo .
      380   define variable mWaitFramTextBeg            as character   no-undo.
      381   define variable mWaitFramTextEnd            as character   no-undo.
      382   define variable mWaitFramView               as logical     no-undo.
      383   define variable mWaitProcEvent              as logical     no-undo init yes.
      384   define variable mWaitFramInterval           as integer     no-undo init 1 .
      385   define variable mWaitFramStop               as logical     no-undo.
      386   define variable mWaitFramStopUser           as logical     no-undo.
      387   define variable mWaitFramStopTimeOut        as logical     no-undo.
      388   define variable mWaitFramStartProc          as datetime-tz no-undo.
      389   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      390   define button B-WaitFramStop auto-end-key
      391        label "Стоп"
      392        size 10 by 1 tooltip "Остоновить процесс".
      393   define button B-viewProcInfo
      394        label "Информация"
      395        size 15 by 1 tooltip "Информация о процесс".
      396   define frame waitfram
      397     v-waitfram-action01 format "x(72)" no-label skip
      398     v-waitfram-action02 format "x(72)" no-label skip
      399     v-waitfram-action03 format "x(72)" no-label skip
      400     B-viewProcInfo
      401     B-WaitFramStop at row 4 col 30
      402     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      403     .
      404   define new global shared variable mBatchMode as logical no-undo init ?.
      405   define variable mFramBachModHandle as handle no-undo.
      406   mFramBachModHandle = frame waitfram:handle.
      407   define variable mFameOldVis as logical no-undo.
      408   define variable mVisCUrentVin as logical no-undo.
      409   if session:batch-mode
      410   then
      411      mBatchMode = yes.
      412   if mBatchMode = ? then do:
      413     mVisCUrentVin = current-window:visible.
      414     mFameOldVis = mFramBachModHandle:visible.
      415     mFramBachModHandle:visible  = yes.
      416     mBatchMode = mFramBachModHandle:visible ne yes.
      417     mFramBachModHandle:visible = mFameOldVis.
      418     current-window:visible = mVisCUrentVin.
      419   end.
      420    if  log-manager:logfile-name ne ?
      421     then DO:
      422         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      423         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      424         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      425     end.
      426   on choose of B-WaitFramStop in frame waitfram
      427   do:
      428     mWaitFramStop = yes.
      429     mWaitFramStopUser = yes.
      430   end.
      431   function waitfram-check-timeout returns logical():
      432      define variable vtime as int64 no-undo.
      433      if mWaitFramStopTimeOut
      434      then
      435         return yes.
      436      vtime = ( now - mWaitFramStartProc ) / 1000 .
      437      if     mWaitFramTimeOut ne ?
      438         and mWaitFramTimeOut ne 0
      439         and mWaitFramTimeOut lt vtime
      440      then do:
      441         mWaitFramStopTimeOut = yes.
      442      end.
      443      return mWaitFramStopTimeOut.
      444   end.
      445   procedure waitfram-hide :
      446     if not session:batch-mode
      447     then do
      448     on error undo, return error return-value
      449     :
      450       pause 0 before-hide .
      451       if not mBatchMode then
      452         hide frame waitfram .
      453     if     not mWaitFramView
      454        and mWaitProcEvent
      455     then
      456       process events .
      457     end.
      458   end procedure.
      459   procedure waitfram-show :
      460     define input  parameter p-message as character no-undo .
      461     define variable v-left-margin as integer   no-undo .
      462     if not session:batch-mode
      463     then do
      464     on error undo, return error return-value
      465     :
      466       if length(p-message) <= 70 then do:
      467         assign
      468           v-left-margin = integer((70 - length(p-message)) / 2)
      469         .
      470         assign
      471           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      472         .
      473         assign
      474           v-waitfram-action01 = " "
      475           v-waitfram-action02 = " "
      476                                    + fill(" ", v-left-margin)
      477                                    + p-message
      478           v-waitfram-action03 = " "
      479         .
      480       end.
      481       else do:
      482         define variable vRindex1 as integer no-undo.
      483         define variable vRindex2 as integer no-undo.
      484         vRindex1 = r-index(p-message," ",70).
      485         if vRindex1 = 0
      486         then
      487            vRindex1 = 70.
      488         if length(p-message)  <= vRindex1 + 70 then do:
      489           assign
      490             v-waitfram-action01 = " "
      491             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      492             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      493           .
      494         end.
      495         else do:
      496           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      497           if vRindex2 <= vRindex1
      498           then
      499              vRindex2 = vRindex1 + 70.
      500           assign
      501             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      502             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      503             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      504           .
      505         end.
      506       end.
      507       B-viewProcInfo:visible   in frame waitfram = no.
      508       B-viewProcInfo:sensitive in frame waitfram = no.
      509       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      510       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      511       if  (   mWaitFramView
      512          or  mWaitProcEvent)
      513          and not mBatchMode
      514       then
      515          display
      516             v-waitfram-action01 skip
      517             v-waitfram-action02 skip
      518             v-waitfram-action03 skip
      519          with frame waitfram .
      520       if     mWaitFramView
      521          then do:
      522             if     mWaitFramInterval ne ?
      523                and not mBatchMode
      524             then
      525                wait-for go of frame waitfram pause mWaitFramInterval.
      526          end.
      527          else
      528             if     mWaitProcEvent
      529                and not mBatchMode
      530             then
      531                process events .
      532     end.
      533   end procedure.
      534      procedure waitfram-show-this:
      535         define input  parameter iInterval as int64 no-undo.
      536         define variable vtime as int64 no-undo.
      537         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      538         mWaitFramInterval = iInterval.
      539         run waitfram-show (substitute("&1&2 &3&4" ,
      540                                       mWaitFramTextBeg ,
      541                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      542                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      543                                       mWaitFramTextEnd
      544                                      )
      545                           ).
      546      end.
      547      procedure WaitFramRunPause:
      548         define input  parameter iInterval as dec no-undo.
      549         define variable vStart  as datetime-tz no-undo.
      550         define variable vend    as datetime-tz no-undo.
      551         define variable vint as int64 no-undo.
      552         define variable vOk as logical no-undo.
      553         vStart = now.
      554         vend   = vStart.
      555         publish "WaitFramPause" (iInterval,output vOk).
      556         vend   =  now.
      557         vint = vend - vStart.
      558         vint = iInterval - vint / 1000.
      559         if     not mWaitFramStop
      560            and (   vint > 0
      561                 or (    not vOk
      562                     and iInterval eq ?
      563                     )
      564                 )
      565         then
      566            run waitfram-show-this (iInterval).
      567         vend   =  now.
      568         vint = vend - vStart.
      569         vint = iInterval - vint / 1000.
      570         if     not mWaitFramStop
      571            and vint > 0
      572         then do:
      573            run gbl/pause.p (vint * 1000).
      574         end.
      575         if iInterval ne ?
      576         then
      577            publish "WaitFramStop".
      578         waitfram-check-timeout().
      579      end.
      580      procedure WaitFramWaitFor:
      581         define input  parameter iInterval as dec no-undo.
      582         assign
      583            mWaitFramStartProc   = now
      584            mWaitFramStopUser    = no
      585            mWaitFramStopTimeOut = no
      586         .
      587         block-wait:
      588         do while not mWaitFramStop:
      589            run WaitFramRunPause (iInterval).
      590            if  waitfram-check-timeout()
      591            then do:
      592               leave block-wait.
      593            end.
      594         end.
      595         run waitfram-hide.
      596      end.
      597   procedure waitfram-join :
      598     define input  parameter p-line-1  as character no-undo .
      599     define input  parameter p-line-2  as character no-undo .
      600     define input  parameter p-line-3  as character no-undo .
      601     define output parameter p-message as character no-undo .
      602     do
      603     on error undo, return error return-value
      604     :
      605       assign
      606         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      607                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      608                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      609       .
      610     end.
      611   end procedure.
      612   function waitfram-join-function returns character
      613     (input p-line-1 as character
      614     ,input p-line-2 as character
      615     ,input p-line-3 as character
      616     ).
      617     define variable v-message as character no-undo .
      618     run waitfram-join in this-procedure
      619       (input  p-line-1
      620       ,input  p-line-2
      621       ,input  p-line-3
      622       ,output v-message
      623       ) .
      624     return v-message .
      625   end function .
      626   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      627   procedure fltfield-clear :
      628     define output parameter loc-fld as character no-undo.
      629     define output parameter loc-lab as character no-undo .
      630     define output parameter loc-spr as character no-undo .
      631     define output parameter loc-dim as character no-undo .
      632     assign
      633       loc-fld = ""
      634       loc-lab = ""
      635       loc-spr = ""
      636       loc-dim = "0"
      637     .
      638   end procedure .
      639   procedure fltfield-add :
      640     define input        parameter par-fld as character no-undo.
      641     define input        parameter par-lab as character no-undo .
      642     define input        parameter par-spr as character no-undo .
      643     define input-output parameter loc-fld as character no-undo.
      644     define input-output parameter loc-lab as character no-undo .
      645     define input-output parameter loc-spr as character no-undo .
      646     define input-output parameter loc-dim as character no-undo .
      647     do
      648     on error undo, return error
      649     :
      650       assign
      651       loc-fld = if loc-dim = '0'
      652                 then par-fld
      653                 else (loc-fld + chr(44) + par-fld)
      654       loc-lab = if loc-dim = '0'
      655                 then par-lab
      656                 else (loc-lab + chr(44) + par-lab)
      657       loc-spr = if loc-dim = '0'
      658                 then par-spr
      659                 else (loc-spr + chr(44) + par-spr)
      660       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      661                 string(integer(if num-entries(loc-dim) > 1
      662                               then entry(2, loc-dim)
      663                               else entry(1, loc-dim)
      664                               ) + 1)
      665       no-error
      666       .
      667     end.
      668   end procedure.
      669   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   define  stream PrnLibStream.
      671   procedure prn-lib-prn-file :
      672     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      673     define input parameter p-DIsabledoptions as integer no-undo .
      674     define variable v-report-name as character no-undo .
      675     define variable v-user-action as character no-undo .
      676     define variable v-printed     as logical   no-undo .
      677     define variable v-exist       as logical   no-undo .
      678     do
      679       on error undo, return error
      680       :
      681       run prn-lib-get-report-name  in this-procedure (
      682         input parParentProc
      683         ,output v-report-name
      684         ).
      685   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      686   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      687     (input  v-report-name
      688     ,input  2
      689     ,output v-exist
      690     )  .
      691       if NOT v-exist then
      692       DO:
      693         Message
      694           "Нет заданий на печать ! "
      695           view-as alert-box .
      696         Return  .
      697       End.
      698       run gbl/prnfilen.w
      699         (input  ""
      700         ,input  p-DisabledOptions
      701         ,input  string(v-report-name )
      702         ,input  7
      703         ,output v-user-action
      704         ,output v-printed
      705         ) .
      706       if v-printed then
      707       do:
      708         return "YES" .
      709       end.
      710       else
      711       do:
      712         return "NO" .
      713       end.
      714     end.
      715   end procedure.
      716   procedure prn-lib-open-stream :
      717     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      718     define input parameter p-page-size    as integer no-undo .
      719     define input parameter p-is-stream    as logical no-undo .
      720     define input parameter p-append       as logical no-undo .
      721     define variable v-report-name as character no-undo .
      722     do
      723       on error undo, return error
      724       :
      725       run prn-lib-get-report-name  in this-procedure (
      726         input parParentProc
      727         ,output v-report-name
      728         ).
      729       if p-is-stream then
      730       do:
      731         if p-append then
      732         do:
      733           output stream PrnLibStream to value( v-report-name )
      734             page-size value(p-page-size) append .
      735         end.
      736         if not p-append then
      737         do:
      738           output stream PrnLibStream to value( v-report-name )
      739             page-size value(p-page-size) .
      740         end.
      741       end.
      742       if not p-is-stream then
      743       do:
      744         if p-append then
      745         do:
      746           output to value( v-report-name )
      747             page-size value(p-page-size) append .
      748         end.
      749         if not p-append then
      750         do:
      751           output to value( v-report-name )
      752             page-size value(p-page-size) .
      753         end.
      754       end.
      755     end.
      756   end procedure.
      757   procedure prn-lib-open-exp :
      758     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      759     define input parameter p-is-stream    as logical no-undo .
      760     define input parameter p-is-append    as logical no-undo .
      761     define output parameter p-ReportFileName as char init "report" no-undo.
      762     define output parameter p-process as logical no-undo .
      763     define variable glog as logical no-undo .
      764     do
      765       on error undo, return error
      766       :
      767       SYSTEM-DIALOG GET-FILE p-ReportFileName
      768         TITLE      "Укажите путь"
      769         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      770         ASK-OVERWRITE
      771         CREATE-TEST-FILE
      772         SAVE-AS
      773         USE-FILENAME
      774         DEFAULT-EXTENSION "txt"
      775         UPDATE glog
      776         .
      777       if not glog then  return.
      778       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      779       if p-is-stream then
      780       do:
      781         if p-is-append then
      782         do:
      783           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      784         end.
      785         else
      786         do:
      787           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      788         end.
      789       end.
      790       else
      791       do:
      792         if p-is-append then
      793         do:
      794           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      795         end.
      796         else
      797         do:
      798           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      799         end.
      800       end.
      801       p-process = yes.
      802     end.
      803   end procedure.
      804   procedure prn-lib-get-report-name :
      805     define input parameter parParentProc  as widget-handle no-undo.
      806     define output parameter p-report-name as character no-undo .
      807     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      808   end procedure.
      809   procedure prn-lib-reportviewer-report-name :
      810     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      811     define input parameter p-report-name-html as character no-undo .
      812     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      813   end procedure.
      814   procedure prn-lib-reportviewer :
      815     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      816     define input parameter p-report-name-html as character no-undo .
      817     define input parameter p-param        as character no-undo .
      818     define variable v-excel           as character no-undo init 'TRUE' .
      819     define variable v-value-character as character no-undo .
      820     define variable v-value-integer   as character no-undo .
      821     define variable v-value-date      as date      no-undo .
      822     define variable v-value-decimal   as decimal   no-undo .
      823     define variable rep-excel         as logical   no-undo .
      824     define variable excel-string      as character no-undo .
      825     define variable v-param-type      as character no-undo .
      826     define variable v-tth             as handle    no-undo .
      827     run adm/shattri.p (
      828       input "get":U
      829       ,input  ""
      830       ,input  0
      831       ,input  'report-glob':U
      832       ,input  'rep-excel':U
      833       ,output v-value-character
      834       ,output v-value-date
      835       ,output v-value-decimal
      836       ,output v-value-integer
      837       ,output rep-excel
      838       ,output v-param-type
      839       ,INPUT-OUTPUT table-handle v-tth
      840       )  .
      841     if rep-excel then v-excel = "TRUE" .
      842     else v-excel = "FALSE" .
      843     if p-param eq ""
      844     then
      845        p-param = "EXCEL:" + v-excel.
      846     else
      847        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      848     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      849   end procedure.
