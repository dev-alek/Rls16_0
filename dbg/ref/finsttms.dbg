     4525   if p-change-mode = 'ИЗМЕНЕНИЕ':U then do:
     4526   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4527   do:
     4528     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4529       (input  v-cntxt-db-num
     4530       ,input  v-cntxt-userid
     4531       ,input  0
     4532       ,input  'actn_fin-statement_update':U
     4533       ,input  'firm':U
     4534       ,input  X_fin-statement.host-code
     4535       ,input  '':U
     4536       ,input  0
     4537       ,input  0
     4538       ,input  0
     4539       ,input  0
     4540       ,input  true
     4541       ,output loc#log
     4542       )  .
     4543   end.
     4544   end.
     4545   else do:
     4546   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4547   do:
     4548     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4549       (input  v-cntxt-db-num
     4550       ,input  v-cntxt-userid
     4551       ,input  0
     4552       ,input  'actn_fin-statement_lookup':U
     4553       ,input  'firm':U
     4554       ,input  X_fin-statement.host-code
     4555       ,input  '':U
     4556       ,input  0
     4557       ,input  0
     4558       ,input  0
     4559       ,input  0
     4560       ,input  true
     4561       ,output loc#log
     4562       )  .
     4563   end.
     4564   end.
     4565   if not loc#log then return error.
     4566   assign
     4567   loc-doc-rec = recid(X_fin-statement).
     4568   CASE X_fin-statement.fins-ext-doc-type:
     4569     when '':U
     4570     or when 'стд':U
     4571     then do:
     4572       run ref/finstti1.w
     4573                     (
     4574                           input parParentProc
     4575                           ,input p-curr-host-code
     4576                           ,input p-change-mode
     4577                           ,input X_fin-statement.host-code
     4578                           ,input 0
     4579                           ,input "":U
     4580                           ,input X_fin-statement.code-bank
     4581                           ,input X_fin-statement.code-schet
     4582                           ,input "":U
     4583                           ,input-output loc-doc-rec
     4584                           ,input-output loc-line-rec
     4585                      )
     4586       .
     4587     end.
     4588   END CASE.
     4589   if loc-doc-rec <> ? and p-change-mode = 'ИЗМЕНЕНИЕ':U then do:
     4590     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     4591     reposition br-fin-statement to recid loc-doc-rec no-error.
     4592   end.
     4593   apply "entry" to br-fin-statement in frame Dialog-Frame.
     4594   apply "value-changed" to br-fin-statement in frame Dialog-Frame.
     4595   END PROCEDURE.
     4596   PROCEDURE proc-b-del :
     4597   define input parameter p-is-batch as logical no-undo .
     4598   define variable loc#log as logical no-undo.
     4599   define variable ii as integer no-undo .
     4600   define variable ok-ii as integer no-undo .
     4601   define variable v-new-rid-list as character no-undo .
     4602   define variable v-doc-rec as recid no-undo.
     4603   define buffer buf_fin-statement for ub.fin-statement.
     4604   if not available X_fin-statement then return error.
     4605   define variable vss-include-info38 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4606   do:
     4607     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4608       (input  v-cntxt-db-num
     4609       ,input  v-cntxt-userid
     4610       ,input  0
     4611       ,input  'actn_fin-statement_deletion':U
     4612       ,input  'firm':U
     4613       ,input  X_fin-statement.host-code
     4614       ,input  '':U
     4615       ,input  0
     4616       ,input  0
     4617       ,input  0
     4618       ,input  0
     4619       ,input  true
     4620       ,output loc#log
     4621       )  .
     4622   end.
     4623   if not loc#log then return error.
     4624   CASE p-is-batch:
     4625     when no then do:
     4626         find first buf_fin-statement exclusive-lock where
     4627         recid(buf_fin-statement) = recid(X_fin-statement) NO-ERROR.
     4628         if not avail buf_fin-statement then return no-apply.
     4629         IF buf_fin-statement.status_ <> 'новый':U
     4630         and buf_fin-statement.status_ <> 'факт':U
     4631         THEN DO:
     4632           MESSAGE
     4633           "Выписка закрыта - удалять нельзя!"
     4634           VIEW-AS ALERT-BOX ERROR.
     4635           RETURN error.
     4636         END.
     4637         loc#log = no.
     4638         MESSAGE
     4639         "Вы уверены, что хотите удалить выписку?" skip(0)
     4640         string(if buf_fin-statement.status_ = 'факт':U then "Выписка закрыта до статуса <факт>, удаление повлечет за собой перерасчет архивов" else "")
     4641         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE loc#log.
     4642         IF loc#log <> YES THEN DO:
     4643           RETURN error.
     4644         END.
     4645       do
     4646       on error undo, return error
     4647       on stop undo, return error
     4648       :
     4649         if buf_fin-statement.status_ = 'факт':U then do:
     4650           run trg/finsttdl.p (
     4651                           input buf_fin-statement.host-code
     4652                          ,input buf_fin-statement.sttm-code
     4653                          ,input yes
     4654                          ,input no) no-error.
     4655           if error-status:error then do:
     4656             message
     4657             "Ошибка при удалении выписки, закрытой до статуса факт" skip
     4658             error-status:get-message(1) skip
     4659             return-value
     4660             view-as alert-box error .
     4661           end.
     4662         end.
     4663         else do:
     4664           run trg/finsttdl.p (
     4665                           input buf_fin-statement.host-code
     4666                          ,input buf_fin-statement.sttm-code
     4667                          ,input no
     4668                          ,input no) no-error.
     4669         end.
     4670       end.
     4671       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4672       reposition br-fin-statement to row 1 No-ERROR.
     4673     end.
     4674     when yes then do:
     4675         loc#log = no.
     4676         MESSAGE
     4677         "Вы уверены, что хотите удалить ВСЕ отмеченные ВАМИ выписки?"
     4678         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE loc#log.
     4679         IF loc#log <> YES THEN DO:
     4680           RETURN error.
     4681         END.
     4682       do
     4683       on error undo, return error
     4684       on stop undo, return error
     4685       :
     4686         _do:
     4687         do ii = 1 to num-entries(v-rid-list):
     4688           run waitfram-show in this-procedure ( input substitute("Обрабатывается &1 выписка списка", ii)).
     4689           find first buf_fin-statement where
     4690               recid(buf_fin-statement) = integer(entry(ii, v-rid-list)) exclusive-lock no-error .
     4691           if ii = 1 then do:
     4692             assign
     4693             v-doc-rec = recid(buf_fin-statement)
     4694             .
     4695           end.
     4696           if not avail buf_fin-statement
     4697           or (buf_fin-statement.status_ <> 'новый':U
     4698           and buf_fin-statement.status_ <> "":U)
     4699           then do:
     4700             assign
     4701             v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(ii, v-rid-list)
     4702             .
     4703             NEXT _do.
     4704           end.
     4705           if buf_fin-statement.status_ = 'факт':U then do:
     4706             run trg/finsttdl.p (
     4707                             input buf_fin-statement.host-code
     4708                           ,input buf_fin-statement.sttm-code
     4709                           ,input yes
     4710                           ,input yes ) no-error.
     4711           end.
     4712           else do:
     4713             run trg/finsttdl.p (
     4714                             input buf_fin-statement.host-code
     4715                           ,input buf_fin-statement.sttm-code
     4716                           ,input no
     4717                           ,input yes ) no-error.
     4718           end.
     4719           if error-status:error then do:
     4720             assign
     4721             v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(ii, v-rid-list)
     4722             .
     4723             NEXT _do.
     4724           end.
     4725           else do:
     4726             assign
     4727             ok-ii = ok-ii + 1
     4728             .
     4729           end.
     4730         end.
     4731       end.
     4732       run waitfram-hide in this-procedure .
     4733       assign
     4734       v-rid-list = v-new-rid-list
     4735       .
     4736       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4737       reposition br-fin-statement to recid integer(entry(1, v-rid-list)) No-ERROR.
     4738       message
     4739       substitute("Из &1 выбранных Вами выписок удалось удалить &2", ii - 1, ok-ii)
     4740       view-as alert-box.
     4741     end.
     4742   END CASE.
     4743   APPLY "Value-CHanged" to br-fin-statement in frame Dialog-Frame.
     4744   APPLY "ENTRY" to br-fin-statement in frame Dialog-Frame.
     4745   END PROCEDURE.
     4746   PROCEDURE proc-b-exp :
     4747   define variable varxmldocfl      as character no-undo.
     4748   define variable varxmldocfl-type as character no-undo.
     4749   define variable v-file-name as character no-undo .
     4750   define variable for-dir as character no-undo .
     4751   define variable accum-count as integer no-undo .
     4752   define variable accum-count-ok as integer no-undo .
     4753   define variable loclog as logical no-undo .
     4754   define variable ii as integer no-undo .
     4755   define variable ii0 as integer no-undo .
     4756   define buffer buf_fin-statement for ub.fin-statement.
     4757   if not available X_fin-statement then do:
     4758     message "Неправильный выбор документа.".
     4759     return no-apply.
     4760   end.
     4761   define variable v-sys-key   as character         no-undo.
     4762   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     4763   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     4764     (output v-sys-key
     4765     ) no-error .
     4766   CASE t-batch:
     4767     when no then do:
     4768       assign
     4769       v-file-name =  ?
     4770       .
     4771       run str/xmlfstt.p ( input X_fin-statement.host-code
     4772                          ,input X_fin-statement.sttm-code
     4773                          ,input-output v-file-name
     4774                          ,input yes
     4775                          ,input yes) no-error .
     4776     end.
     4777     when  yes then do:
     4778       if v-rid-list = "":U then do:
     4779           message
     4780           "Вы не отметили ни одной выписки"
     4781           view-as alert-box error.
     4782           return error.
     4783       end.
     4784       run gbl/d-file.p
     4785         (
     4786          input-output v-file-name
     4787         ,input-output for-dir
     4788         ,input  (" Все файлы XML (*.xml) ")
     4789         ,input  ("*.xml":U)
     4790         ,input  chr(44)
     4791         ,input  (".xml":U)
     4792         ,input  no
     4793         ,input  yes
     4794         ,input  yes
     4795         ,input  "Введите имя файла"
     4796         ,output loclog
     4797         ) .
     4798       if not loclog then do:
     4799         return .
     4800       end.
     4801       run waitfram-show in this-procedure ( input "Ждите...").
     4802       assign
     4803       v-doc-rec = recid(X_fin-statement)
     4804       ii0 = num-entries(v-rid-list)
     4805       .
     4806       _do:
     4807       do ii = 1 to ii0:
     4808         find first buf_fin-statement no-lock where
     4809                   recid(buf_fin-statement) = integer(entry(ii, v-rid-list)) no-error .
     4810         if available buf_fin-statement then do:
     4811           assign
     4812           accum-count = accum-count + 1
     4813           .
     4814           run str/xmlfstt.p (
     4815                           input buf_fin-statement.host-code
     4816                         , input buf_fin-statement.sttm-code
     4817                         , input-output v-file-name
     4818                         , input (accum-count-ok = 0)
     4819                         , input ii = ii0
     4820                         ) no-error .
     4821           if not error-status:error then
     4822           assign
     4823           accum-count-ok = accum-count-ok + 1
     4824           .
     4825         end.
     4826       end.
     4827       run waitfram-hide in this-procedure .
     4828     end.
     4829   END CASE.
     4830   if error-status:error
     4831   or (t-batch and accum-count <> accum-count-ok)
     4832   then do:
     4833     message
     4834     "Ошибка при выгрузке выписки(-ок) в XML-формате" skip
     4835     string(if t-batch then substitute("Выгружено &1 выписок из &2", accum-count-ok, accum-count) else "":U)
     4836     view-as alert-box .
     4837     if not t-batch then
     4838     return error .
     4839   end.
     4840   if search ("exmldoc.bat") <> ? then do:
     4841     os-command silent value(search ("exmldoc.bat") + " " + v-file-name + " " + v-sys-key).
     4842   end.
     4843   else do:
     4844     if search (v-file-name ) <> ? then do:
     4845       message "Выписки(-ы) выгружен(-ы) в файл " v-file-name view-as alert-box.
     4846     end.
     4847   end.
     4848   END PROCEDURE.
     4849   PROCEDURE proc-b-print :
     4850   DEFINE INPUT PARAMETER loc-option as character no-undo.
     4851   if loc-option = '':U then return error.
     4852   CASE loc-option:
     4853   when 'ONE':U then do:
     4854     run proc-print-one in this-procedure .
     4855   end.
     4856   when 'ONE-GRAPHICS':U then do:
     4857     RUN proc-print-one-graphics IN THIS-PROCEDURE.
     4858   end.
     4859   when 'LIST':U then do:
     4860     run proc-print-list in this-procedure no-error.
     4861   end.
     4862   end case.
     4863   loc-option = ''.
     4864   END PROCEDURE.
     4865   PROCEDURE proc-b-sch :
     4866   assign
     4867     tbl = 'fin-statement'
     4868     join-tbl = 'X_fin-statement'
     4869     fld = ""
     4870     lab = ""
     4871     spr = ""
     4872     dim = '0'
     4873     .
     4874   run fltfield-add in this-procedure ( 'sttm-code', 'Вн.№ выписки', '',
     4875   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4876   run fltfield-add in this-procedure ( 'prn-doc-code', 'Номер', '',
     4877   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4878   run fltfield-add in this-procedure ( 'host-code', '', '',
     4879   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
