      830   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      831   procedure fltopend_fltopend :
      832   define input parameter p-parent-handle as handle no-undo .
      833   define input parameter p-qh as handle no-undo .
      834   define input parameter p-flt-open-open-query  as character no-undo .
      835   define input parameter p-where-cond as character no-undo .
      836   define input parameter p-use-indFIRST-query-tail as character no-undo .
      837   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      838   define input parameter p-indexed-reposition as character no-undo .
      839     do
      840     on error undo, return error
      841     :
      842   define variable v-prepare-string as character no-undo .
      843   define variable glog as logical no-undo .
      844   assign
      845   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      846                      p-where-cond + chr(32)  +
      847                      p-use-indFIRST-query-tail + chr(32) +
      848                      p-use-ind-sort-clmn-by + chr(32) +
      849                      p-indexed-reposition
      850   .
      851   assign
      852   glog = p-qh:query-prepare(v-prepare-string) no-error .
      853   if not glog
      854   or error-status:error then do:
      855     message error-status:get-message(1) view-as alert-box .
      856     undo, return error .
      857   end.
      858   assign
      859   glog = p-qh:query-open no-error .
      860   if not glog
      861   or error-status:error then do:
      862     message error-status:get-message(1) view-as alert-box .
      863     undo, return error .
      864   end.
      865     end.
      866   end procedure.
      867   procedure fltopend_fltfindd :
      868   define input parameter p-parent-handle as handle no-undo .
      869   define input parameter p-qh as handle no-undo .
      870   define input parameter p-rowid as rowid no-undo .
      871   define input parameter p-next as logical no-undo .
      872   define input parameter p-lock as integer no-undo .
      873   define input parameter p-bh as handle no-undo .
      874   define input parameter p-where-cond as character no-undo .
      875   define input parameter p-use-index-phrase as character no-undo .
      876   define variable glog as logical no-undo .
      877   define variable v-qh as handle no-undo .
      878   define variable v-bh as handle no-undo .
      879   define variable v-recid as recid no-undo .
      880   define variable v-prepare-string as character no-undo .
      881   do
      882   on error undo, return error
      883   on stop undo, return error
      884   :
      885     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      886     create buffer v-bh for table p-bh buffer-name p-bh:name.
      887     create query v-qh.
      888     v-qh:set-buffers(v-bh).
      889     v-prepare-string = substitute("for each &1 &2 &3"
      890                                     ,v-bh:name
      891                                     ,p-where-cond
      892                                     ,p-use-index-phrase).
      893     glog = v-qh:query-prepare(v-prepare-string) no-error.
      894     if not glog then do:
      895       delete object v-qh.
      896       delete object v-bh.
      897       undo, return error .
      898     end.
      899     glog = v-qh:query-open no-error .
      900     if not glog then do:
      901       delete object v-qh.
      902       delete object v-bh.
      903       undo, return error .
      904     end.
      905     if p-next then do:
      906       v-qh:reposition-to-rowid(p-rowid) no-error .
      907       glog = v-qh:get-next( p-lock) no-error .
      908       glog = v-qh:get-next( p-lock) no-error .
      909       if not glog or v-qh:query-off-end = yes then do:
      910         glog = v-qh:get-first( p-lock) no-error .
      911       end.
      912     end.
      913     else do:
      914       glog = v-qh:get-first( p-lock) no-error .
      915     end.
      916     v-recid = v-bh:recid no-error .
      917     delete object v-qh.
      918     delete object v-bh.
      919     return string(v-recid) .
      920   end.
      921   end procedure.
      922   procedure fltopend_fltfindq :
      923   define input parameter p-parent-handle as handle no-undo .
      924   define input parameter p-qh as handle no-undo .
      925   define input parameter p-next as logical no-undo .
      926   define input parameter p-lock as integer no-undo .
      927   define input parameter p-flt-open-open-query  as character no-undo .
      928   define input parameter p-where-cond as character no-undo .
      929   define input parameter p-use-indFIRST-query-tail as character no-undo .
      930   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      931   define input parameter p-indexed-reposition as character no-undo .
      932   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      933   define variable glog as logical no-undo .
      934   define variable v-qh as handle no-undo .
      935   define variable v-bh as handle no-undo extent 18.
      936   define variable v-rowid as rowid no-undo extent 18.
      937   define variable v-ii as integer no-undo .
      938   define variable v-prepare-string as character no-undo .
      939   do
      940   on error undo, return error
      941   on stop undo, return error
      942   :
      943     create query v-qh.
      944     do v-ii = 1 to p-qh:num-buffers:
      945       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      946       assign
      947       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      948       no-error.
      949       v-qh:add-buffer(v-bh[v-ii]).
      950     end.
      951     assign
      952     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      953                       p-where-cond + chr(32)  +
      954                       p-use-indFIRST-query-tail + chr(32) +
      955                       p-use-ind-sort-clmn-by + chr(32) +
      956                       p-indexed-reposition
      957     .
      958     glog = v-qh:query-prepare( v-prepare-string) no-error .
      959     if not glog then do:
      960       delete object v-qh.
      961       do v-ii = 1 to p-qh:num-buffers:
      962         delete object v-bh[v-ii].
      963       end.
      964       undo, return error .
      965     end.
      966     glog = v-qh:query-open no-error .
      967     if not glog then do:
      968       delete object v-qh.
      969       do v-ii = 1 to p-qh:num-buffers:
      970         delete object v-bh[v-ii].
      971       end.
      972       undo, return error .
      973     end.
      974     if p-next then do:
      975       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      976       glog = v-qh:get-next( p-lock) no-error .
      977       glog = v-qh:get-next( p-lock) no-error .
      978       if not glog or v-qh:query-off-end = yes then do:
      979         glog = v-qh:get-first( p-lock) no-error .
      980       end.
      981     end.
      982     else do:
      983       glog = v-qh:get-first( p-lock) no-error .
      984     end.
      985     do v-ii = 1 to p-qh:num-buffers:
      986       assign
      987       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      988       no-error.
      989     end.
      990     delete object v-qh.
      991     do v-ii = 1 to p-qh:num-buffers:
      992       delete object v-bh[v-ii].
      993     end.
      994   end.
      995   end procedure.
