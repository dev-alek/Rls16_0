     4975   PROCEDURE proc-b-del :
     4976   define variable loc#log as logical no-undo.
     4977   define variable v-sts like ub.assortment-matrix.asmt-status no-undo .
     4978   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     4979   if not available buf_Matrix then return error.
     4980   do
     4981   on error undo, return error
     4982   on stop undo, return error
     4983   :
     4984   define variable vss-include-info48 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4985   do:
     4986     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4987       (input  v-cntxt-db-num
     4988       ,input  v-cntxt-userid
     4989       ,input  0
     4990       ,input  'actn_assort-matr_deletion':U
     4991       ,input  'global':U
     4992       ,input  0
     4993       ,input  '':U
     4994       ,input  0
     4995       ,input  0
     4996       ,input  0
     4997       ,input  0
     4998       ,input  true
     4999       ,output loc#log
     5000       )  .
     5001   end.
     5002     if loc#log <> yes then do: return error. end.
     5003     assign
     5004     v-sts = ?
     5005     loc-doc-rec = RECID(buf_Matrix)
     5006     .
     5007     run ref/assmatr2.p (
     5008          input recid ( buf_Matrix )
     5009         ,input-output v-sts )
     5010          no-error .
     5011     if error-status:error then undo, return error.
     5012     run openbr in this-procedure .
     5013     REPOSITION BROWSE-AM to recid loc-doc-rec No-error.
     5014     if error-status:error then do:                           find first pos_assortment-matrix no-lock where                                   recid(pos_assortment-matrix) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи AM" skip                            string(if avail pos_assortment-matrix                                     then  substitute("Вн код AM: &1"                                                     , pos_assortment-matrix.asmt-id)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     5015     if available buf_Matrix then do:
     5016       loc#log = BROWSE-AM:select-focused-row( ) IN FRAME Dialog-Frame.
     5017     end.
     5018     apply "ENTRY" to BROWSE-AM.
     5019   end.
     5020   END PROCEDURE.
     5021   PROCEDURE proc-b-print :
     5022   define variable v-doc-rec as recid no-undo .
     5023   define variable accum-count as integer.
     5024   define variable date_string     as      char    no-undo.
     5025   define variable Line            as      char    no-undo.
     5026   define variable v-time-cr as character no-undo .
     5027   define variable v-time-up as character no-undo .
     5028   define variable v-st      as character no-undo .
     5029   DEFINE FRAME buf_Matrix-list
     5030         buf_Matrix.asmt-name COLUMN-LABEL "Название" FORMAT "X(30)":U
     5031         buf_Matrix.asmt-type COLUMN-LABEL "Тип" FORMAT "X(6)":U
     5032         buf_Matrix.obj-type  COLUMN-LABEL "Объект"
     5033         buf_Matrix.obj-code
     5034         buf_Matrix.asmt-date-update COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
     5035         v-time-up COLUMN-LABEL "Время" FORMAT "x(5)":U
     5036         buf_Matrix.asmt-who-update COLUMN-LABEL "Кто!изменил" FORMAT "X(8)":U
     5037         buf_Matrix.asmt-db-num-update COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     5038         buf_Matrix.asmt-date-create COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     5039         v-time-cr  COLUMN-LABEL "Время" FORMAT "x(5)":U
     5040         buf_Matrix.asmt-who-create COLUMN-LABEL "Кто!создал" FORMAT "X(8)":U
     5041         buf_Matrix.asmt-db-num-create COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
     5042   HEADER  date_string AT 5 format "X(35)"
     5043    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5044   Line format "X(195)" AT 1
     5045   with width 232 down stream-io use-text    .
     5046   Line = fill("-", 195).
     5047   date_string = cur-time-print() .
     5048   run prn-lib-open-stream  in this-procedure (
     5049                                                input parParentProc
     5050                                               ,input 43
     5051                                               ,input yes
     5052                                               ,input no
     5053                                               ).
     5054   PUT  STREAM PrnLibStream
     5055   SPACE(25) ( frame Dialog-Frame:title )
     5056   format "x(90)" SKIP(1) .
     5057   FORM HEADER
     5058   Line format "X(195)" AT 1 SKIP
     5059   "Продолжение - на следующей странице" AT 30 SKIP
     5060   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5061   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5062   FORM with FRAME buf_Matrix-list  .
     5063   run waitfram-show in this-procedure ("Ждите...").
     5064   v-doc-rec = recid(buf_Matrix).
     5065   DO WHILE available buf_Matrix :
     5066     GET prev BROWSE-AM.
     5067   END.
     5068   GET next BROWSE-AM.
     5069   DO WHILE available buf_Matrix :
     5070     Display STREAM PrnLibStream
     5071         buf_Matrix.asmt-name
     5072         buf_Matrix.asmt-type
     5073         buf_Matrix.obj-type
     5074         buf_Matrix.obj-code
     5075         buf_Matrix.asmt-date-update
     5076         STRING (buf_Matrix.asmt-time-update,"HH:MM") @ v-time-up
     5077         buf_Matrix.asmt-who-update
     5078         buf_Matrix.asmt-db-num-update
     5079         buf_Matrix.asmt-date-create
     5080         STRING (buf_Matrix.asmt-time-create,"HH:MM") @ v-time-cr
     5081         buf_Matrix.asmt-who-create
     5082         buf_Matrix.asmt-db-num-create
     5083   with FRAME buf_Matrix-list .
     5084     DOWN STREAM PrnLibStream 1
     5085     with FRAME buf_Matrix-list  .
     5086     assign
     5087     accum-count = accum-count + 1
     5088     .
     5089     GET next BROWSE-AM.
     5090   END.
     5091   UNDERLINE  STREAM PrnLibStream
     5092         buf_Matrix.asmt-name
     5093         buf_Matrix.asmt-type
     5094         buf_Matrix.obj-type
     5095         buf_Matrix.obj-code
     5096         buf_Matrix.asmt-date-update
     5097         buf_Matrix.asmt-who-update
     5098         buf_Matrix.asmt-db-num-update
     5099         buf_Matrix.asmt-date-create
     5100         buf_Matrix.asmt-who-create
     5101         buf_Matrix.asmt-db-num-create
     5102         v-time-cr
     5103         v-time-up
     5104   with FRAME buf_Matrix-list .
     5105   DISPLAY STREAM PrnLibStream
     5106   "ИТОГО" @ buf_Matrix.asmt-name
     5107   accum-count @ buf_Matrix.asmt-type
     5108   with frame buf_Matrix-list.
     5109   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5110   HIDE  STREAM PrnLibStream FRAME buf_Matrix-List.
     5111   output  STREAM PrnLibStream CLOSE.
     5112   REPOSITION BROWSE-AM to recid v-doc-rec no-error.
     5113   APPLY "entry" to BROWSE-AM.
     5114   run waitfram-hide in this-procedure .
     5115   run prn-lib-prn-file in this-procedure (
     5116                                             input parParentProc
     5117                                             ,input 8
     5118                                             ).
     5119   END PROCEDURE.
     5120   PROCEDURE proc-br :
     5121   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5122   if b-sel:sensitive in frame Dialog-Frame then dO:
     5123       if b-mark:sensitive then do:
     5124           apply "choose" to b-mark in frame Dialog-Frame.
     5125       end.
     5126       else do:
     5127           apply "choose" to b-sel in frame Dialog-Frame.
     5128       end.
     5129   end.
     5130   else do:
     5131       if b-lookup:sensitive then
     5132       apply "choose" to b-lookup in frame Dialog-Frame.
     5133   end.
     5134   END PROCEDURE.
     5135   FUNCTION Get-status-AM-goods RETURNS CHARACTER
     5136     ( iRid-AM AS RECID,
     5137       cGds-code AS CHARACTER
     5138     ) :
     5139   DEFINE BUFFER buf_AM       FOR ub.Assortment-matrix.
     5140   DEFINE BUFFER buf_AM-goods FOR ub.Assortment-matrix-goods.
     5141   FIND FIRST buf_AM WHERE
     5142              RECID(buf_AM) = iRid-AM
     5143        NO-LOCK NO-ERROR.
     5144   IF NOT AVAILABLE buf_AM THEN DO:
     5145      RETURN "".
     5146   END.
     5147   FIND FIRST buf_Am-goods WHERE
     5148              buf_AM-goods.Asmt-id  = buf_AM.Asmt-id
     5149          AND buf_AM-goods.db-num   = buf_AM.db-num
     5150          AND buf_AM-goods.Gds-code = INTEGER(cGds-code)
     5151        NO-LOCK NO-ERROR.
     5152     RETURN (IF AVAILABLE buf_AM-goods THEN entry (lookup (STRING(buf_AM-goods.asmg-status), '0,1,50,99':U), 'тек,удал,блок,удаление':U) ELSE "").
     5153   END FUNCTION.
