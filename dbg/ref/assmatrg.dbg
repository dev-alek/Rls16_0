     1089             "Item 1", "1",
     1090   "Item 2", "2"
     1091        SIZE 22.5 BY 1 NO-UNDO.
     1092   DEFINE VARIABLE RS-type AS CHARACTER
     1093        VIEW-AS RADIO-SET HORIZONTAL EXPAND
     1094        RADIO-BUTTONS
     1095             "Item 1", "1",
     1096   "Item 2", "2",
     1097   "Item 3", "3"
     1098        SIZE 33.5 BY 1 NO-UNDO.
     1099   DEFINE new shared QUERY BROWSE-AM FOR
     1100                   buf_matrix,
     1101                   buf_matrix-goods SCROLLING.
     1102   DEFINE BROWSE BROWSE-AM
     1103     QUERY BROWSE-AM NO-LOCK DISPLAY
     1104         mark-string(recid(buf_Matrix) , p-rid-list) @ p-mark COLUMN-LABEL "*" FORMAT "x(1)":U
     1105         buf_matrix.asmt-name COLUMN-LABEL "Название" FORMAT "X(20)":U
     1106         buf_matrix.asmt-type COLUMN-LABEL "Тип" FORMAT "X(7)":U
     1107         IF (buf_Matrix.obj-code <> 0 ) THEN (buf_Matrix.obj-type + ' ' + string(buf_Matrix.obj-code)) ELSE ("")  @ p-obj COLUMN-LABEL "Объект" FORMAT "x(11)":U
     1108         entry (lookup (STRING(buf_Matrix.asmt-status), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ p-status COLUMN-LABEL "Статус!AM" FORMAT "x(6)":U
     1109         Get-status-AM-goods(recid(buf_Matrix), STRING(p-Gds-code)) @ p-stat-gds COLUMN-LABEL "Товар!в AM" FORMAT "x(6)":U
     1110         buf_matrix.asmt-date-update COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
     1111         STRING (buf_Matrix.asmt-time-update,"HH:MM") @ p-time-upd COLUMN-LABEL "Время" FORMAT "x(5)":U
     1112         buf_matrix.asmt-db-num-update COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     1113         buf_matrix.asmt-date-create COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     1114         STRING (buf_Matrix.asmt-time-create,"HH:MM") @ p-time-cr COLUMN-LABEL "Время" FORMAT "x(5)":U
     1115         buf_matrix.asmt-db-num-create COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
     1116     ENABLE
     1117         buf_matrix.asmt-name
     1118       WITH NO-ROW-MARKERS SEPARATORS SIZE 96 BY 11.75 FIT-LAST-COLUMN.
     1119   DEFINE FRAME Dialog-Frame
     1120        b-quit AT ROW 1 COL 1
     1121        B-mark AT ROW 1 COL 11
     1122        B-sel AT ROW 1 COL 17.5
     1123        B-add AT ROW 1 COL 27.5
     1124        B-lookup AT ROW 1 COL 37.5
     1125        B-chg AT ROW 1 COL 47.5
     1126        B-del AT ROW 1 COL 57.5
     1127        B-Help AT ROW 1 COL 87.5
     1128        B-goods AT ROW 2 COL 17.5
     1129        B-print AT ROW 2 COL 87.5
     1130        RS-sts AT ROW 3 COL 11.5 NO-LABEL
     1131        B-hist AT ROW 3 COL 87.5
     1132        RS-type AT ROW 4 COL 11.5 NO-LABEL
     1133        RS-object AT ROW 5 COL 11.5 NO-LABEL
     1134        BROWSE-AM AT ROW 6.25 COL 1.5
     1135        buf_matrix.asmt-des AT ROW 19.25 COL 1.5 NO-LABEL
     1136             VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1137             SIZE 94 BY 2.5
     1138        mark-num AT ROW 1 COL 12 COLON-ALIGNED NO-LABEL
     1139        FILL-IN-1 AT ROW 3 COL 3.5 NO-LABEL
     1140        FILL-IN-2 AT ROW 4 COL 6.5 NO-LABEL
     1141        v-text_object-bd AT ROW 5 COL 1 NO-LABEL
     1142        v-user-name-create AT ROW 18.13 COL 7.63 COLON-ALIGNED WIDGET-ID 2
     1143        v-user-name-corr AT ROW 18.25 COL 80 COLON-ALIGNED WIDGET-ID 4
     1144        SPACE(0.74) SKIP(2.86)
     1145       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1146            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1147            TITLE "Список Ассортиментных матриц ТОВАРА".
     1148   ASSIGN
     1149          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1150          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1151   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1152   OR ENDKEY OF FRAME Dialog-Frame DO:
     1153       run gbl/markqwa.p
     1154       (    input b-mark:sensitive
     1155          , input p-rid-list) no-error.
     1156       if error-status:error then return no-apply.
     1157       APPLY "END-ERROR":U TO SELF.
     1158   END.
     1159   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1160   DO:
     1161     define variable loc#log as logical no-undo.
     1162     define variable loc-doc-rec as recid no-undo .
     1163   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1164   do:
     1165     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1166       (input  v-cntxt-db-num
     1167       ,input  v-cntxt-userid
     1168       ,input  0
     1169       ,input  'actn_assort-matr_add-def':U
     1170       ,input  'global':U
     1171       ,input  0
     1172       ,input  '':U
     1173       ,input  0
     1174       ,input  0
     1175       ,input  0
     1176       ,input  0
     1177       ,input  true
     1178       ,output loc#log
     1179       )  .
     1180   end.
     1181     if loc#log <> yes then do: return no-apply. end.
     1182     run ref/assmatri.w
     1183                   (
     1184                      input parParentProc
     1185                     ,input p-curr-obj-type
     1186                     ,input p-curr-obj-code
     1187                     ,input 'ДОБАВЛЕНИЕ':U
     1188                     ,input 0
     1189                     ,input-output loc-doc-rec
     1190                                 ) no-error
     1191     .
     1192     if loc-doc-rec <> ? THEN DO:
     1193         run OpenBR in this-procedure .
     1194         reposition BROWSE-AM to recid loc-doc-rec no-error.
     1195         if error-status:error then do:                           find first pos_assortment-matrix no-lock where                                   recid(pos_assortment-matrix) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи AM" skip                            string(if avail pos_assortment-matrix                                     then  substitute("Вн код AM: &1"                                                     , pos_assortment-matrix.asmt-id)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1196     END.
     1197     apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1198     apply "value-changed" to BROWSE-AM in frame Dialog-Frame.
     1199   END.
     1200   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1201   DO:
     1202   define variable loc#log as logical no-undo.
     1203   define variable loc-doc-rec as recid no-undo .
     1204   if not available buf_matrix then return no-apply.
     1205   if  buf_matrix.asmt-status = 1  then do:
     1206       message "Корректировать можно только запись в статусе  ТЕК."
     1207       view-as alert-box information .
     1208       return no-apply.
     1209   end.
     1210   assign
     1211   loc-doc-rec = recid(buf_matrix).
     1212   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1213   do:
     1214     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1215       (input  v-cntxt-db-num
     1216       ,input  v-cntxt-userid
     1217       ,input  0
     1218       ,input  'actn_assort-matr_update':U
     1219       ,input  'global':U
     1220       ,input  0
     1221       ,input  '':U
     1222       ,input  0
     1223       ,input  0
     1224       ,input  0
     1225       ,input  0
     1226       ,input  true
     1227       ,output loc#log
     1228       )  .
     1229   end.
     1230      if loc#log <> yes then do: return no-apply. end.
     1231   if buf_matrix.asmt-type = 'Шаблон':U then do:
     1232   if v-cntxt-db-num <> 0 and  v-cntxt-db-num <> buf_matrix.asmt-db-num-create then do:
     1233      message
     1234       "Нельзя редактировать ШАБЛОН Ассортиментная матрица созданный в чужой УБД"
     1235       view-as alert-box error.
     1236       return  no-apply.
     1237   end.
     1238   end.
     1239   else do:
     1240   define variable obj-db-num as integer   no-undo .
     1241   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1243     (input  buf_matrix.obj-type
     1244     ,input  buf_matrix.obj-code
     1245     ,output obj-db-num
     1246     )  .
     1247   if v-cntxt-db-num <> 0 and  v-cntxt-db-num <> obj-db-num  then do:
     1248      message
     1249       "Нельзя редактировать запись Ассортиментная матрица чужой УБД"
     1250       view-as alert-box error.
     1251       return  no-apply.
     1252   end.
     1253   end.
     1254      run ref/assmatri.w
     1255                    (
     1256                       input parParentProc
     1257                      ,input p-curr-obj-type
     1258                      ,input p-curr-obj-code
     1259                      ,input 'ИЗМЕНЕНИЕ':U
     1260                      ,input buf_matrix.asmt-id
     1261                      ,input-output loc-doc-rec
     1262                                  ) no-error
     1263      .
     1264      if loc-doc-rec <> ? THEN DO:
     1265          run OpenBR in this-procedure .
     1266          reposition BROWSE-AM to recid loc-doc-rec no-error.
     1267          if error-status:error then do:                           find first pos_assortment-matrix no-lock where                                   recid(pos_assortment-matrix) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи AM" skip                            string(if avail pos_assortment-matrix                                     then  substitute("Вн код AM: &1"                                                     , pos_assortment-matrix.asmt-id)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1268      END.
     1269      apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1270      apply "value-changed" to BROWSE-AM in frame Dialog-Frame.
     1271   END.
     1272   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1273   DO:
     1274   if buf_matrix.asmt-type = 'Шаблон':U then do:
     1275   if v-cntxt-db-num <> 0 and  v-cntxt-db-num <> buf_matrix.asmt-db-num-create then do:
     1276      message
     1277       "Нельзя удалять ШАБЛОН Ассортиментная матрица созданный в чужой УБД"
     1278       view-as alert-box error.
     1279       return  no-apply.
     1280   end.
     1281   end.
     1282   else do:
     1283   define variable obj-db-num as integer   no-undo .
     1284   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1285   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1286     (input  buf_matrix.obj-type
     1287     ,input  buf_matrix.obj-code
     1288     ,output obj-db-num
     1289     )  .
     1290   if v-cntxt-db-num <> 0 and  v-cntxt-db-num <> obj-db-num  then do:
     1291      message
     1292       "Нельзя удалять запись Ассортиментная матрица чужой УБД"
     1293       view-as alert-box error.
     1294       return  no-apply.
     1295   end.
     1296   end.
     1297   run proc-b-del in this-procedure no-error.
     1298   if error-status:error then return no-apply.
     1299   END.
     1300   ON CHOOSE OF B-goods IN FRAME Dialog-Frame
     1301   DO:
     1302   define variable loc#log as logical   no-undo .
     1303   if not available buf_matrix then return no-apply.
     1304     run ref/gds-matr.w ( parParentProc ,
     1305                      buf_matrix.asmt-id ,
     1306                      buf_matrix.db-num  ,
     1307                      p-curr-obj-type   ,
     1308                      p-curr-obj-code ,
     1309                      "no-button"
     1310                      )  no-error .
     1311   if error-status :error  then message error-status :get-message(1) return-value .
     1312   return no-apply.
     1313   END.
     1314   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1315   DO:
     1316     define variable pp-rid-list as character no-undo .
     1317    run str/cassmatr.w (
     1318     input  parparentproc ,
     1319     input  buf_Matrix.asmt-id ,
     1320     input  buf_Matrix.db-num ,
     1321     input-output pp-rid-list    ).
     1322   END.
     1323   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1324   DO:
     1325   define variable loc#log as logical no-undo.
     1326   define variable loc-doc-rec as recid no-undo .
     1327   if not available buf_matrix then return no-apply.
     1328   assign
     1329   loc-doc-rec = recid(buf_matrix).
     1330   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1331   do:
     1332     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1333       (input  v-cntxt-db-num
     1334       ,input  v-cntxt-userid
     1335       ,input  0
     1336       ,input  'actn_assort-matr_lookup':U
     1337       ,input  'global':U
     1338       ,input  0
     1339       ,input  '':U
     1340       ,input  0
     1341       ,input  0
     1342       ,input  0
     1343       ,input  0
     1344       ,input  true
     1345       ,output loc#log
     1346       )  .
     1347   end.
     1348      if loc#log <> yes then do: return no-apply. end.
     1349      run ref/assmatri.w
     1350                    (
     1351                       input parParentProc
     1352                      ,input p-curr-obj-type
     1353                      ,input p-curr-obj-code
     1354                      ,input 'ПРОСМОТР':U
     1355                      ,input buf_matrix.asmt-id
     1356                      ,input-output loc-doc-rec
     1357                      ) no-error   .
     1358      apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1359   END.
     1360   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1361   DO:
     1362     define variable loc#log as logical no-undo .
     1363     if AVAILABLE buf_matrix  then do:
     1364   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1365   define variable v-str-recid17 as character no-undo .
     1366   define variable v-num-entry17 as integer   no-undo .
     1367   assign
     1368     v-str-recid17 = trim( string( recid( buf_matrix ) , "->>>>>>>>>>>9":U ) )
     1369     v-num-entry17 = lookup( v-str-recid17 , p-rid-list )
     1370   .
     1371   if v-num-entry17 > 0 then do:
     1372     assign
     1373       entry( v-num-entry17, p-rid-list ) = "":U
     1374       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1375     .
     1376   end.
     1377   else do:
     1378     assign
     1379       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1380     .
     1381   end.
     1382       loc#log = BROWSE-AM:refresh() .
     1383       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1384           loc#log = BROWSE-AM:select-next-row ().
     1385           apply "VALUE-CHANGED" to BROWSE-AM in frame Dialog-Frame.
     1386       end.
     1387       if num-entries( p-rid-list ) = 0
     1388       then
     1389           hide mark-num in frame Dialog-Frame.
     1390       else
     1391           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1392     end.
     1393     apply "entry" to BROWSE-AM in frame Dialog-Frame.
     1394   END.
     1395   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1396   DO:
     1397     run proc-b-print in this-procedure no-error.
     1398     if error-status:error then do:
     1399       return no-apply.
     1400     end.
     1401   END.
     1402   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1403   DO:
     1404     IF  p-rid-list = "" THEN DO:
     1405         IF AVAILABLE buf_matrix THEN p-rid-list = string(RECID(buf_matrix)).
     1406     END.
     1407   END.
     1408   ON ROW-DISPLAY OF BROWSE-AM IN FRAME Dialog-Frame
     1409   DO:
     1410     IF can-find (first  assortment-matrix-goods no-lock where
     1411                         assortment-matrix-goods.db-num  = buf_matrix.db-num and
     1412                         assortment-matrix-goods.asmt-id = buf_matrix.asmt-id )  THEN DO:
     1413         buf_matrix.asmt-date-create   :fgcolor in browse BROWSE-AM = ?.
     1414         buf_matrix.asmt-date-update   :fgcolor in browse BROWSE-AM = ?.
     1415         buf_matrix.asmt-db-num-create :fgcolor in browse BROWSE-AM = ?.
     1416         buf_matrix.asmt-db-num-update :fgcolor in browse BROWSE-AM = ?.
     1417         buf_matrix.asmt-name         :fgcolor in browse BROWSE-AM = ? .
     1418         buf_matrix.asmt-type         :fgcolor in browse BROWSE-AM = ? .
     1419         p-mark                       :fgcolor in browse BROWSE-AM = ? .
     1420         p-obj                        :fgcolor in browse BROWSE-AM = ? .
     1421         p-time-upd                   :fgcolor in browse BROWSE-AM = ? .
     1422         p-time-cr                    :fgcolor in browse BROWSE-AM = ? .
     1423         p-status                     :fgcolor in browse BROWSE-AM = ? .
     1424         p-stat-gds                   :fgcolor in browse BROWSE-AM = ? .
     1425     END.
     1426     ELSE DO:
     1427         buf_matrix.asmt-date-create   :fgcolor in browse BROWSE-AM = DARK_GRAY_COLOR.
     1428         buf_matrix.asmt-date-update   :fgcolor in browse BROWSE-AM = DARK_GRAY_COLOR.
     1429         buf_matrix.asmt-db-num-create :fgcolor in browse BROWSE-AM = DARK_GRAY_COLOR.
     1430         buf_matrix.asmt-db-num-update :fgcolor in browse BROWSE-AM = DARK_GRAY_COLOR.
     1431         buf_matrix.asmt-name         :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1432         buf_matrix.asmt-type         :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1433         p-mark                       :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1434         p-obj                        :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1435         p-time-upd                   :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1436         p-time-cr                    :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1437         p-status                     :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1438         p-stat-gds                   :fgcolor in browse BROWSE-AM  = DARK_GRAY_COLOR.
     1439   END.
     1440   END.
     1441   ON VALUE-CHANGED OF BROWSE-AM IN FRAME Dialog-Frame
     1442   DO:
     1443       IF AVAILABLE buf_Matrix THEN DO:
     1444   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1446     (input  buf_matrix.asmt-who-create
     1447     ,output v-user-name-create
     1448     )  .
     1449   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1450   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1451     (input  buf_matrix.asmt-who-update
     1452     ,output v-user-name-corr
     1453     )  .
     1454           DISPLAY buf_Matrix.asmt-des
     1455                   v-user-name-corr
     1456                   v-user-name-create
     1457           WITH FRAME Dialog-Frame.
     1458       END.
     1459   END.
     1460   ON VALUE-CHANGED OF RS-object IN FRAME Dialog-Frame
     1461   DO:
     1462     run openbr in this-procedure no-error.
     1463     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1464   END.
     1465   ON VALUE-CHANGED OF RS-sts IN FRAME Dialog-Frame
     1466   DO:
     1467     RUN openbr IN THIS-PROCEDURE NO-ERROR.
     1468     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1469   END.
     1470   ON VALUE-CHANGED OF RS-type IN FRAME Dialog-Frame
     1471   DO:
     1472     RUN openbr IN THIS-PROCEDURE NO-ERROR.
     1473     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1474   END.
     1475   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1476   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1477   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   procedure set-filter-name :
     1479   define input parameter p-filter-name as character no-undo .
     1480     do with frame Dialog-Frame:
     1481       if p-filter-name > "" then do:
     1482         assign
     1483           frame Dialog-Frame:title
     1484             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     1485         .
     1486       end.
     1487       else do:
     1488       end.
     1489     end.
     1490   end procedure.
     1491   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1492   on help of frame Dialog-Frame
     1493   do:
     1494     run gbl/app_help.p
     1495       (input this-procedure :file-name
     1496       ,input ''
     1497       ,input ?
     1498       ) no-error.
     1499     if error-status :error then do:
     1500       message
     1501         "Ошибка при вызове помощи"
     1502         error-status :get-message(1)
     1503         view-as alert-box .
     1504     end.
     1505   end.
     1506   run minbtn-set in this-procedure .
     1507   on choose of b-help in frame Dialog-Frame
     1508   do:
     1509     apply "help":u to frame Dialog-Frame .
     1510   end.
     1511   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1512   procedure minbtn-set :
     1513       do
     1514           on error undo, return error return-value
     1515           :
     1516           define variable ii              as integer       no-undo .
     1517           define variable fh              as widget-handle no-undo .
     1518           define variable hh              as widget-handle no-undo .
     1519           define variable v-h             as handle        extent 4 no-undo .
     1520           define variable v-name-button   as character     no-undo .
     1521           define variable v-help-old-x    as decimal       no-undo .
     1522           define variable v-help-old-y    as decimal       no-undo .
     1523           define variable v-help-old-size as decimal       no-undo .
     1524           define variable v-frame-width   as decimal       no-undo .
     1525           define variable jj              as integer       no-undo .
     1526           do
     1527               on error undo, return error
     1528               :
     1529               assign
     1530                   v-frame-width = frame Dialog-Frame:width - 0.3
     1531                   fh            = frame Dialog-Frame:first-child
     1532                   hh            = fh:first-child
     1533                   ii            = 1
     1534                   .
     1535               do while valid-handle(hh):
     1536                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1537                   do:
     1538                       case lc(hh:name) :
     1539                           when "b-help" then
     1540                               do:
     1541                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1542                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1543                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1544                                   hh:TOOLTIP = "Помощь" .
     1545                                   v-help-old-x = hh:column .
     1546                                   v-help-old-y = hh:row    .
     1547                                   v-help-old-size = hh:width .
     1548                                   hh:width-chars = 2.5 .
     1549                               end.
     1550                           when "b-print" then
     1551                               do:
     1552                                   hh:load-image("cmp/b-print.bmp":u) .
     1553                                   hh:TOOLTIP = "Печать" .
     1554                                   v-h[ii] = hh:handle .
     1555                                   ii = ii + 1 .
     1556                                   hh:width-chars = 3 .
     1557                               end.
     1558                           when "b-history" or
     1559                           when "b-hist" then
     1560                               do:
     1561                                   hh:load-image("cmp/b-hist.bmp":u) .
     1562                                   hh:TOOLTIP = "История" .
     1563                                   v-h[ii] = hh:handle .
     1564                                   ii = ii + 1 .
     1565                                   hh:width-chars = 3 .
     1566                               end.
     1567                           when "b-sch" then
     1568                               do:
     1569                                   hh:load-image("cmp/b-sch.bmp":u) .
     1570                                   hh:TOOLTIP = "Установка Фильтра" .
     1571                                   v-h[ii] = hh:handle .
     1572                                   ii = ii + 1 .
     1573                                   hh:width-chars = 3 .
     1574                               end.
     1575                           when "b-hist-user" then
     1576                               do:
     1577                                   hh:load-image("cmp/b-hist.bmp":u) .
     1578                                   hh:TOOLTIP = "История пользователя" .
     1579                                   ii = ii + 1 .
     1580                               end.
     1581                       end case.
     1582                   end.
     1583                   hh = hh:next-sibling.
     1584               end.
     1585               b-help:column = v-frame-width - b-help:width-chars.
     1586               jj = 0.
     1587               repeat ii = 4 to 1 by -1 :
     1588                   if valid-handle (v-h[ii] ) then
     1589                   do:
     1590                       jj  = jj + 1 .
     1591                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1592                       v-h[ii]:row    = v-help-old-y .
     1593                   end.
     1594               end.
     1595           end.
     1596       end.
     1597   end procedure.
     1598   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1599   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1600   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1601   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1602   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1603   define variable v-diasize-current-frame-height as decimal   no-undo .
     1604   define variable v-diasize-change-size          as logical   no-undo .
     1605   define variable v-diasize-resize-button        as handle    no-undo .
     1606   define variable v-diasize-wndmax               as logical   no-undo .
     1607   define variable v-diasize-wndstore             as logical   no-undo .
     1608   define variable v-diasize-proc-name            as character no-undo .
     1609   define variable v-diasize-browse-handle        as handle    no-undo .
     1610   define variable v-diasize-browse-number        as integer   no-undo .
     1611   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1612   define temp-table temp-diasize-handle no-undo
     1613     field handle-value  as handle
     1614     field save-position as decimal
     1615     index xpk is primary unique handle-value
     1616     .
     1617   define temp-table temp-browse-handle no-undo
     1618     field browse-type   as character
     1619     field browse-number as integer
     1620     field browse-handle as handle
     1621     field original-size as decimal
     1622     index xpk is primary unique browse-type browse-number
     1623     index xie browse-type browse-handle
     1624   .
     1625   procedure diasize_change-height :
     1626     define input  parameter p-change-value  as decimal   no-undo .
     1627     define input  parameter p-move-resize   as logical   no-undo .
     1628     define variable v-field-group-handle    as handle    no-undo .
     1629     define variable v-object-handle         as handle    no-undo .
     1630     define variable v-frame-height          as decimal   no-undo .
     1631     define variable v-frame-virtual-height  as decimal   no-undo .
     1632     define variable v-browse-height         as decimal   no-undo .
     1633     define variable v-window-height         as decimal   no-undo .
     1634     define variable v-window-virtual-height as decimal   no-undo .
     1635     define variable v-change-sign           as integer   no-undo .
     1636     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1637     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1638     if p-change-value > 0
     1639     then do:
     1640       if frame Dialog-Frame :height + p-change-value
     1641           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1642       then do:
     1643         assign
     1644           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1645                           - (frame Dialog-Frame :height-chars)
     1646         .
     1647         if p-change-value <= 0
     1648         then do:
     1649           run diasize_position-resize-button in this-procedure .
     1650           return .
     1651         end.
     1652       end.
     1653     end.
     1654     if p-change-value < 0
     1655     then do:
     1656       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1657       then do:
     1658         assign
     1659           p-change-value = v-diasize-orig-frame-height
     1660                          - (frame Dialog-Frame :height-chars)
     1661         .
     1662         if p-change-value >= 0
     1663         then do:
     1664           run diasize_position-resize-button in this-procedure .
     1665           return .
     1666         end.
     1667       end.
     1668     end.
     1669     if p-change-value >= 0
     1670     then do:
     1671       assign
     1672         v-change-sign = 1
     1673       .
     1674     end.
     1675     else do:
     1676       assign
     1677         v-change-sign = -1
     1678       .
     1679     end.
     1680     assign
     1681       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1682     .
     1683     if p-change-value = 0
     1684     then do:
     1685       run diasize_position-resize-button in this-procedure .
     1686       return .
     1687     end.
     1688     move_block:
     1689     do
     1690     on error undo move_block, retry move_block
     1691     :
     1692       if retry
     1693       then do:
     1694         do
     1695         on error undo move_block, leave move_block
     1696         :
     1697           if p-change-value > 0
     1698           then do:
     1699             for each buf_temp-diasize-handle
     1700             on error undo, next
     1701             :
     1702               assign
     1703                 v-object-handle = buf_temp-diasize-handle.handle-value
     1704               .
     1705               if v-object-handle <> v-diasize-resize-button
     1706               then do:
     1707                 assign
     1708                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1709                 .
     1710               end.
     1711             end.
     1712             assign
     1713               v-diasize-browse-handle :height = v-browse-height
     1714             .
     1715             for each buf_temp-browse-handle
     1716               where buf_temp-browse-handle.browse-type = 'height':u
     1717             on error undo, next
     1718             :
     1719               assign
     1720                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1721               .
     1722             end.
     1723             assign
     1724               frame Dialog-Frame :height = v-frame-height
     1725             .
     1726             if frame Dialog-Frame :scrollable = true
     1727             then do:
     1728               assign
     1729                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1730               .
     1731             end.
     1732             run diasize_position-resize-button in this-procedure .
     1733           end.
     1734           else do:
     1735             if frame Dialog-Frame :scrollable = true
     1736             then do:
     1737               assign
     1738                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1739               .
     1740             end.
     1741             assign
     1742               frame Dialog-Frame :height = v-frame-height
     1743             .
     1744             assign
     1745               v-diasize-browse-handle :height = v-browse-height
     1746             .
     1747             for each buf_temp-browse-handle
     1748               where buf_temp-browse-handle.browse-type = 'height':u
     1749             on error undo, next
     1750             :
     1751               assign
     1752                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1753               .
     1754             end.
     1755             for each buf_temp-diasize-handle
     1756             on error undo, next
     1757             :
     1758               assign
     1759                 v-object-handle = buf_temp-diasize-handle.handle-value
     1760               .
     1761               if v-object-handle <> v-diasize-resize-button
     1762               then do:
     1763                 assign
     1764                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1765                 .
     1766               end.
     1767             end.
     1768             run diasize_position-resize-button in this-procedure .
     1769           end.
     1770           assign
     1771             v-diasize-change-size = false
     1772           .
     1773           leave move_block .
     1774         end.
     1775       end.
     1776       assign
     1777         v-diasize-need-full-display = true
     1778       .
     1779       if v-diasize-change-size = false
     1780       then do:
     1781         assign
     1782           v-diasize-change-size = true
     1783         .
     1784       end.
     1785       else do:
     1786         return .
     1787       end.
     1788       assign
     1789         v-frame-height = frame Dialog-Frame :height
     1790         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1791         v-browse-height = v-diasize-browse-handle :height
     1792       .
     1793       for each buf_temp-browse-handle
     1794         where buf_temp-browse-handle.browse-type = 'height':u
     1795       :
     1796         assign
     1797           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1798         .
     1799       end.
     1800       for each buf_temp-diasize-handle
     1801       :
     1802         delete buf_temp-diasize-handle .
     1803       end.
     1804       assign
     1805         v-field-group-handle = frame Dialog-Frame :first-child
     1806       .
     1807       do while valid-handle(v-field-group-handle)
     1808       :
     1809         assign
     1810           v-object-handle = v-field-group-handle :first-child
     1811         .
     1812         do while valid-handle(v-object-handle)
     1813         :
     1814           if  v-object-handle <> v-diasize-browse-handle :handle
     1815           and can-query(v-object-handle, "row")
     1816           and can-query(v-object-handle, "height")
     1817           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1818           then do:
     1819             find first buf_temp-browse-handle
     1820               where buf_temp-browse-handle.browse-type   = 'height':u
     1821                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1822               no-error .
     1823             if available buf_temp-browse-handle
     1824             then do:
     1825             end.
     1826             else do:
     1827               create buf_temp-diasize-handle .
     1828               assign
     1829                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1830                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1831               .
     1832             end.
     1833           end.
     1834           assign
     1835             v-object-handle = v-object-handle :next-sibling
     1836           .
     1837         end.
     1838         assign
     1839           v-field-group-handle = v-field-group-handle :next-sibling
     1840         .
     1841       end.
     1842       do with frame Dialog-Frame
     1843       :
     1844         hide v-diasize-resize-button .
     1845         assign
     1846           v-diasize-resize-button :row    = 1
     1847           v-diasize-resize-button :column = 1
     1848         .
     1849       end.
     1850       if p-change-value > 0
     1851       then do:
     1852         if frame Dialog-Frame :scrollable = true
     1853         then do:
     1854           assign
     1855             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1856             no-error .
     1857           if error-status :error
     1858           or error-status :get-message(1) <> ""
     1859           then do:
     1860             undo move_block, retry move_block .
     1861           end.
     1862         end.
     1863         assign
     1864           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1865           no-error .
     1866         if error-status :error
     1867         or error-status :get-message(1) <> ""
     1868         then do:
     1869           undo move_block, retry move_block .
     1870         end.
     1871         assign
     1872           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1873           no-error .
     1874         if error-status :error
     1875         or error-status :get-message(1) <> ""
     1876         then do:
     1877           undo move_block, retry move_block .
     1878         end.
     1879         for each buf_temp-browse-handle
     1880           where buf_temp-browse-handle.browse-type = 'height':u
     1881         on error undo move_block, retry move_block
     1882         :
     1883           assign
     1884             buf_temp-browse-handle.browse-handle :height
     1885               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1886             no-error .
     1887           if error-status :error
     1888           or error-status :get-message(1) <> ""
     1889           then do:
     1890             undo move_block, retry move_block .
     1891           end.
     1892         end.
     1893         for each buf_temp-diasize-handle
     1894         on error undo move_block, retry move_block
     1895         :
     1896           assign
     1897             v-object-handle = buf_temp-diasize-handle.handle-value
     1898           .
     1899           if v-object-handle <> v-diasize-resize-button
     1900           then do:
     1901             assign
     1902               v-object-handle :row = v-object-handle :row + p-change-value
     1903               no-error .
     1904             if error-status :error
     1905             or error-status :get-message(1) <> ""
     1906             then do:
     1907               undo move_block, retry move_block .
     1908             end.
     1909           end.
     1910         end.
     1911       end.
     1912       else do:
     1913         for each buf_temp-diasize-handle
     1914         on error undo move_block, retry move_block
     1915         :
     1916           assign
     1917             v-object-handle = buf_temp-diasize-handle.handle-value
     1918           .
     1919           if v-object-handle <> v-diasize-resize-button
     1920           then do:
     1921             assign
     1922               v-object-handle :row = v-object-handle :row + p-change-value
     1923               no-error .
     1924             if error-status :error
     1925             or error-status :get-message(1) <> ""
     1926             then do:
     1927               undo move_block, retry move_block .
     1928             end.
     1929           end.
     1930         end.
     1931         assign
     1932           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1933           no-error .
     1934         if error-status :error
     1935         or error-status :get-message(1) <> ""
     1936         then do:
     1937           undo move_block, retry move_block .
     1938         end.
     1939         for each buf_temp-browse-handle
     1940           where buf_temp-browse-handle.browse-type = 'height':u
     1941         on error undo move_block, retry move_block
     1942         :
     1943           assign
     1944             buf_temp-browse-handle.browse-handle :height
     1945               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1946             no-error .
     1947           if error-status :error
     1948           or error-status :get-message(1) <> ""
     1949           then do:
     1950             undo move_block, retry move_block .
     1951           end.
     1952         end.
     1953         assign
     1954           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1955           no-error .
     1956         if error-status :error
     1957         or error-status :get-message(1) <> ""
     1958         then do:
     1959           undo move_block, retry move_block .
     1960         end.
     1961         if frame Dialog-Frame :scrollable = true
     1962         then do:
     1963           assign
     1964             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1965             no-error .
     1966           if error-status :error
     1967           or error-status :get-message(1) <> ""
     1968           then do:
     1969             undo move_block, retry move_block .
     1970           end.
     1971         end.
     1972       end.
     1973       if p-move-resize = true
     1974       then do:
     1975         run diasize_position-resize-button in this-procedure .
     1976       end.
     1977       if v-diasize-wndstore = true
     1978       then do:
     1979         if connected("ub") = true
     1980         then do:
     1981           define variable v-cntxt-db-num        as integer   no-undo .
     1982           define variable v-cntxt-userid        as character no-undo .
     1983           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1984                                             , OUTPUT v-cntxt-userid
     1985                                             ) .
     1986           run gbl/wndsizew.p
     1987             (input  v-cntxt-db-num
     1988             ,input  v-cntxt-userid
     1989             ,input  v-diasize-proc-name
     1990             ,input  'height':u
     1991             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1992             ) .
     1993         end.
     1994       end.
     1995     end.
     1996     assign
     1997       v-diasize-change-size = false
     1998     .
     1999   end procedure.
     2000   procedure diasize_set-height :
     2001     define input  parameter p-new-height  as decimal   no-undo .
     2002     define input  parameter p-move-resize as logical   no-undo .
     2003     do
     2004     on error undo, return error return-value
     2005     :
     2006       run diasize_change-height in this-procedure
     2007         (input  (p-new-height - frame Dialog-Frame :height)
     2008         ,input  p-move-resize
     2009         ) .
     2010     end.
     2011   end procedure.
     2012   procedure diasize_change-width :
     2013     define input  parameter p-change-value as decimal   no-undo .
     2014     define input  parameter p-move-resize  as logical   no-undo .
     2015     define variable v-field-group-handle   as handle    no-undo .
     2016     define variable v-object-handle        as handle    no-undo .
     2017     define variable v-frame-width          as decimal   no-undo .
     2018     define variable v-frame-virtual-width  as decimal   no-undo .
     2019     define variable v-browse-width         as decimal   no-undo .
     2020     define variable v-window-width         as decimal   no-undo .
     2021     define variable v-window-virtual-width as decimal   no-undo .
     2022     define variable v-change-sign          as integer   no-undo .
     2023     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2024     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2025     if p-change-value > 0
     2026     then do:
     2027       if frame Dialog-Frame :width + p-change-value >
     2028           session :width-chars
     2029       then do:
     2030         assign
     2031           p-change-value = session :width-chars - frame Dialog-Frame :width
     2032         .
     2033         if p-change-value <= 0
     2034         then do:
     2035           run diasize_position-resize-button in this-procedure .
     2036           return .
     2037         end.
     2038       end.
     2039     end.
     2040     if p-change-value < 0
     2041     then do:
     2042       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2043       then do:
     2044         assign
     2045           p-change-value = v-diasize-orig-frame-width
     2046                          - frame Dialog-Frame :width
     2047         .
     2048         if p-change-value >= 0
     2049         then do:
     2050           run diasize_position-resize-button in this-procedure .
     2051           return .
     2052         end.
     2053       end.
     2054     end.
     2055     if p-change-value >= 0
     2056     then do:
     2057       assign
     2058         v-change-sign = 1
     2059       .
     2060     end.
     2061     else do:
     2062       assign
     2063         v-change-sign = -1
     2064       .
     2065     end.
     2066     assign
     2067       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2068     .
     2069     if p-change-value = 0
     2070     then do:
     2071       run diasize_position-resize-button in this-procedure .
     2072       return .
     2073     end.
     2074     move_block:
     2075     do
     2076     on error undo move_block, leave move_block
     2077     :
     2078       if retry
     2079       then do:
     2080         do
     2081         on error undo move_block, leave move_block
     2082         :
     2083           if p-change-value > 0
     2084           then do:
     2085             for each buf_temp-diasize-handle
     2086             on error undo, next
     2087             :
     2088               assign
     2089                 v-object-handle = buf_temp-diasize-handle.handle-value
     2090               .
     2091               if v-object-handle <> v-diasize-resize-button
     2092               then do:
     2093                 assign
     2094                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2095                 .
     2096               end.
     2097             end.
     2098             assign
     2099               v-diasize-browse-handle :width = v-browse-width
     2100             .
     2101             for each buf_temp-browse-handle
     2102               where buf_temp-browse-handle.browse-type = 'width':u
     2103             on error undo, next
     2104             :
     2105               assign
     2106                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2107               .
     2108             end.
     2109             assign
     2110               frame Dialog-Frame :width = v-frame-width
     2111             .
     2112             if frame Dialog-Frame :scrollable = true
     2113             then do:
     2114               assign
     2115                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2116               .
     2117             end.
     2118             run diasize_position-resize-button in this-procedure .
     2119           end.
     2120           else do:
     2121             if frame Dialog-Frame :scrollable = true
     2122             then do:
     2123               assign
     2124                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2125               .
     2126             end.
     2127             assign
     2128               frame Dialog-Frame :width = v-frame-width
     2129             .
     2130             for each buf_temp-browse-handle
     2131               where buf_temp-browse-handle.browse-type = 'width':u
     2132             on error undo, next
     2133             :
     2134               assign
     2135                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2136               .
     2137             end.
     2138             assign
     2139               v-diasize-browse-handle :width = v-browse-width
     2140             .
     2141             for each buf_temp-diasize-handle
     2142             on error undo, next
     2143             :
     2144               assign
     2145                 v-object-handle = buf_temp-diasize-handle.handle-value
     2146               .
     2147               if v-object-handle <> v-diasize-resize-button
     2148               then do:
     2149                 assign
     2150                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2151                 .
     2152               end.
     2153             end.
     2154             run diasize_position-resize-button in this-procedure .
     2155           end.
     2156           assign
     2157             v-diasize-change-size = false
     2158           .
     2159           leave move_block .
     2160         end.
     2161       end.
     2162       assign
     2163         v-diasize-need-full-display = true
     2164       .
     2165       if v-diasize-change-size = false
     2166       then do:
     2167         assign
     2168           v-diasize-change-size = true
     2169         .
     2170       end.
     2171       else do:
     2172         return .
     2173       end.
     2174       assign
     2175         v-frame-width = frame Dialog-Frame :width
     2176         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2177         v-browse-width = v-diasize-browse-handle :width
     2178       .
     2179       for each buf_temp-browse-handle
     2180         where buf_temp-browse-handle.browse-type = 'width':u
     2181       :
     2182         assign
     2183           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2184         .
     2185       end.
     2186       for each buf_temp-diasize-handle
     2187       :
     2188         delete buf_temp-diasize-handle .
     2189       end.
     2190       assign
     2191         v-field-group-handle = frame Dialog-Frame :first-child
     2192       .
     2193       do while valid-handle(v-field-group-handle)
     2194       :
     2195         assign
     2196           v-object-handle = v-field-group-handle :first-child
     2197         .
     2198         do while valid-handle(v-object-handle)
     2199         :
     2200           if  v-object-handle <> v-diasize-browse-handle :handle
     2201           and v-object-handle <> v-diasize-resize-button
     2202           and can-query(v-object-handle, "row")
     2203           and can-query(v-object-handle, "height")
     2204           and ( v-object-handle :col + v-object-handle :width
     2205                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2206               )
     2207           then do:
     2208             find first buf_temp-browse-handle
     2209               where buf_temp-browse-handle.browse-type   = 'width':u
     2210                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2211               no-error .
     2212             if available buf_temp-browse-handle
     2213             then do:
     2214             end.
     2215             else do:
     2216               create buf_temp-diasize-handle .
     2217               assign
     2218                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2219                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2220               .
     2221             end.
     2222           end.
     2223           assign
     2224             v-object-handle = v-object-handle :next-sibling
     2225           .
     2226         end.
     2227         assign
     2228           v-field-group-handle = v-field-group-handle :next-sibling
     2229         .
     2230       end.
     2231       do with frame Dialog-Frame
     2232       :
     2233         hide v-diasize-resize-button .
     2234         v-diasize-resize-button :row = 1.
     2235         v-diasize-resize-button :column = 1.
     2236       end.
     2237       if p-change-value > 0
     2238       then do:
     2239         if frame Dialog-Frame :scrollable = true
     2240         then do:
     2241           assign
     2242             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2243             no-error .
     2244           if error-status :error
     2245           or error-status :get-message(1) <> ""
     2246           then do:
     2247             undo move_block, retry move_block.
     2248           end.
     2249         end.
     2250         assign
     2251           frame Dialog-Frame :width = v-frame-width + p-change-value
     2252           no-error .
     2253         if error-status :error
     2254         or error-status :get-message(1) <> ""
     2255         then do:
     2256           undo move_block, retry move_block.
     2257         end.
     2258         assign
     2259           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2260         no-error .
     2261         if error-status :error
     2262         or error-status :get-message(1) <> ""
     2263         then do:
     2264           undo move_block, retry move_block.
     2265         end.
     2266         for each buf_temp-browse-handle
     2267           where buf_temp-browse-handle.browse-type = 'width':u
     2268         on error undo move_block, retry move_block
     2269         :
     2270           assign
     2271             buf_temp-browse-handle.browse-handle :width
     2272               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2273             no-error .
     2274           if error-status :error
     2275           or error-status :get-message(1) <> ""
     2276           then do:
     2277             undo move_block, retry move_block .
     2278           end.
     2279         end.
     2280         for each buf_temp-diasize-handle
     2281         on error undo move_block, retry move_block
     2282         :
     2283           assign
     2284             v-object-handle = buf_temp-diasize-handle.handle-value
     2285           .
     2286           if v-object-handle <> v-diasize-resize-button
     2287           then do:
     2288             assign
     2289               v-object-handle :col = v-object-handle :col + p-change-value
     2290               no-error .
     2291             if error-status :error
     2292             or error-status :get-message(1) <> ""
     2293             then do:
     2294               undo move_block, retry move_block .
     2295             end.
     2296           end.
     2297         end.
     2298       end.
     2299       else do:
     2300         for each buf_temp-diasize-handle
     2301         on error undo move_block, retry move_block
     2302         :
     2303           assign
     2304             v-object-handle = buf_temp-diasize-handle.handle-value
     2305           .
     2306           if v-object-handle <> v-diasize-resize-button
     2307           then do:
     2308             assign
     2309               v-object-handle :col = v-object-handle :col + p-change-value
     2310               no-error .
     2311             if error-status :error
     2312             or error-status :get-message(1) <> ""
     2313             then do:
     2314               undo move_block, retry move_block .
     2315             end.
     2316           end.
     2317         end.
     2318         for each buf_temp-browse-handle
     2319           where buf_temp-browse-handle.browse-type = 'width':u
     2320         on error undo move_block, retry move_block
     2321         :
     2322           assign
     2323             buf_temp-browse-handle.browse-handle :width
     2324               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2325             no-error .
     2326           if error-status :error
     2327           or error-status :get-message(1) <> ""
     2328           then do:
     2329             undo move_block, retry move_block .
     2330           end.
     2331         end.
     2332         assign
     2333           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2334           no-error .
     2335         if error-status :error
     2336         or error-status :get-message(1) <> ""
     2337         then do:
     2338           undo move_block, retry move_block.
     2339         end.
     2340         assign
     2341           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2342         no-error .
     2343         if error-status :error
     2344         or error-status :get-message(1) <> ""
     2345         then do:
     2346           undo move_block, retry move_block.
     2347         end.
     2348         if frame Dialog-Frame :scrollable = true
     2349         then do:
     2350           assign
     2351             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2352           no-error .
     2353           if error-status :error
     2354           or error-status :get-message(1) <> ""
     2355           then do:
     2356             undo move_block, retry move_block.
     2357           end.
     2358         end.
     2359       end.
     2360       if p-move-resize
     2361       then do:
     2362         run diasize_position-resize-button in this-procedure .
     2363       end.
     2364       if v-diasize-wndstore = true
     2365       then do:
     2366         if connected("ub") = true
     2367         then do:
     2368           define variable v-cntxt-db-num        as integer   no-undo .
     2369           define variable v-cntxt-userid        as character no-undo .
     2370           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2371                                             , OUTPUT v-cntxt-userid
     2372                                             ) .
     2373           run gbl/wndsizew.p
     2374             (input  v-cntxt-db-num
     2375             ,input  v-cntxt-userid
     2376             ,input  v-diasize-proc-name
     2377             ,input  'width':u
     2378             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2379             ) .
     2380         end.
     2381       end.
     2382     end.
     2383     assign
     2384       v-diasize-change-size = false
     2385     .
     2386   end procedure.
     2387   procedure diasize_set-width :
     2388     define input  parameter p-new-width  as decimal   no-undo .
     2389     define input  parameter p-move-resize as logical   no-undo .
     2390     do
     2391     on error undo, return error return-value
     2392     :
     2393       run diasize_change-width in this-procedure
     2394         (input  (p-new-width - frame Dialog-Frame :width)
     2395         ,input  p-move-resize
     2396         ) .
     2397     end.
     2398   end procedure.
     2399   procedure diasize_position-resize-button :
     2400     do with frame Dialog-Frame
     2401     :
     2402       hide v-diasize-resize-button .
     2403       assign
     2404         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2405                     - 1
     2406                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2407         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2408                     - 1
     2409                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2410       .
     2411       view v-diasize-resize-button .
     2412     end.
     2413   end procedure.
     2414   on alt-right anywhere
     2415   do:
     2416     run diasize_change-width in this-procedure
     2417       (input 1
     2418       ,input true
     2419       ) .
     2420     return no-apply .
     2421   end.
     2422   on alt-left anywhere
     2423   do:
     2424     run diasize_change-width in this-procedure
     2425       (input -1
     2426       ,input true
     2427       ) .
     2428     return no-apply .
     2429   end.
     2430   on alt-down anywhere
     2431   do:
     2432     run diasize_change-height in this-procedure
     2433       (input 1
     2434       ,input true
     2435       ) .
     2436     return no-apply .
     2437   end.
     2438   on alt-up anywhere
     2439   do:
     2440     run diasize_change-height in this-procedure
     2441       (input -1
     2442       ,input true
     2443       ) .
     2444     return no-apply .
     2445   end.
     2446   on alt-enter of frame Dialog-Frame
     2447   do:
     2448     run diasize_maximize in this-procedure
     2449       (input  ?
     2450       ).
     2451     return no-apply .
     2452   end.
     2453   procedure diasize_end-move :
     2454     do
     2455     on error undo, return error return-value
     2456     :
     2457       define variable v-row-delta as decimal   no-undo .
     2458       define variable v-col-delta as decimal   no-undo .
     2459       define variable v-new-row as decimal   no-undo .
     2460       define variable v-new-col as decimal   no-undo .
     2461       assign
     2462         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2463         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2464       .
     2465       assign
     2466         v-row-delta = v-new-row - frame Dialog-Frame :height
     2467         v-col-delta = v-new-col - frame Dialog-Frame :width
     2468       .
     2469       run diasize_change-height in this-procedure
     2470         (input v-row-delta
     2471         ,input true
     2472         ) .
     2473       run diasize_change-width in this-procedure
     2474         (input v-col-delta
     2475         ,input true
     2476         ) .
     2477     end.
     2478   end procedure.
     2479   procedure diasize_maximize :
     2480     define input  parameter p-action as logical   no-undo .
     2481     do
     2482     on error undo, return error return-value
     2483     :
     2484       if p-action = ?
     2485       then do:
     2486         if v-diasize-need-maximize = true
     2487         then do:
     2488           assign
     2489             p-action = true
     2490           .
     2491         end.
     2492         else do:
     2493           assign
     2494             p-action = false
     2495           .
     2496         end.
     2497       end.
     2498       if p-action = true
     2499       then do:
     2500         run diasize_change-height in this-procedure
     2501           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2502               - frame Dialog-Frame :height-chars
     2503           ,input true
     2504           ) .
     2505         run diasize_change-width in this-procedure
     2506           (input session :width-chars
     2507               - frame Dialog-Frame :width-chars
     2508           ,input true
     2509           ) .
     2510         assign
     2511           v-diasize-need-maximize = false
     2512         .
     2513       end.
     2514       else do:
     2515         run diasize_change-width in this-procedure
     2516           (input v-diasize-orig-frame-width
     2517               - frame Dialog-Frame :width-chars
     2518           ,input true
     2519           ) .
     2520         run diasize_change-height in this-procedure
     2521           (input v-diasize-orig-frame-height
     2522               - frame Dialog-Frame :height-chars
     2523           ,input true
     2524           ) .
     2525         assign
     2526           v-diasize-need-maximize = true
     2527         .
     2528       end.
     2529     end.
     2530   end procedure.
     2531   procedure diasize_restore-orig-size :
     2532     do
     2533     on error undo, return error return-value
     2534     :
     2535       assign
     2536         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2537         v-diasize-current-frame-height = frame Dialog-Frame :height
     2538       .
     2539       run diasize_set-height in this-procedure
     2540         (input  v-diasize-orig-frame-height
     2541         ,input  true
     2542         ) .
     2543       run diasize_set-width in this-procedure
     2544         (input  v-diasize-orig-frame-width
     2545         ,input  true
     2546         ) .
     2547     end.
     2548   end procedure.
     2549   procedure diasize_restore-current-size :
     2550     do
     2551     on error undo, return error return-value
     2552     :
     2553       run diasize_set-height in this-procedure
     2554         (input  v-diasize-current-frame-height
     2555         ,input  true
     2556         ) .
     2557       run diasize_set-width in this-procedure
     2558         (input  v-diasize-current-frame-width
     2559         ,input  true
     2560         ) .
     2561     end.
     2562   end procedure.
     2563   procedure diasize_set-browse-handle :
     2564     define input  parameter p-browse-handle as handle   no-undo .
     2565     define buffer buf_temp-browse-handle for temp-browse-handle .
     2566     do
     2567     on error undo, return error return-value
     2568     :
     2569       assign
     2570         v-diasize-browse-handle = p-browse-handle
     2571       .
     2572       for each buf_temp-browse-handle
     2573       on error undo, return error return-value
     2574       :
     2575         delete buf_temp-browse-handle .
     2576       end.
     2577     end.
     2578   end procedure.
     2579   procedure diasize_add_browse :
     2580     define input  parameter p-browse-type   as character no-undo .
     2581     define input  parameter p-browse-handle as handle    no-undo .
     2582     define buffer buf_temp-browse-handle for temp-browse-handle .
     2583     do
     2584     on error undo, return error return-value
     2585     :
     2586       assign
     2587         v-diasize-browse-number = v-diasize-browse-number + 1
     2588       .
     2589       create buf_temp-browse-handle .
     2590       assign
     2591         buf_temp-browse-handle.browse-type   = p-browse-type
     2592         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2593         buf_temp-browse-handle.browse-handle = p-browse-handle
     2594       .
     2595     end.
     2596   end procedure.
     2597   procedure diasize_init :
     2598     define variable v-default-value    as logical   no-undo .
     2599     define variable v-restore-saved    as logical   no-undo .
     2600     define variable v-resize-value-str as character no-undo .
     2601     do
     2602     on error undo, return error return-value
     2603     :
     2604       do with frame Dialog-Frame
     2605       :
     2606         assign
     2607           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2608           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2609           v-diasize-browse-handle     = browse BROWSE-AM :handle
     2610         .
     2611         create button v-diasize-resize-button
     2612         assign
     2613           parent        = frame Dialog-Frame :first-child
     2614           label         = "s"
     2615           height-pixels = 16
     2616           width-pixels  = 16
     2617           visible       = true
     2618           sensitive     = true
     2619           movable       = true
     2620           triggers:
     2621             on end-move persistent run diasize_end-move in this-procedure .
     2622           end triggers.
     2623         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2624         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2625         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2626         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2627         assign
     2628           v-diasize-wndmax = false
     2629         .
     2630         if connected("ub") = true
     2631         then do:
     2632           define variable v-cntxt-db-num        as integer   no-undo .
     2633           define variable v-cntxt-userid        as character no-undo .
     2634           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2635                                             , OUTPUT v-cntxt-userid
     2636                                             ) .
     2637           run gbl/wndpar_r.p
     2638             (input  v-cntxt-db-num
     2639             ,input  v-cntxt-userid
     2640             ,input  'wndmax':U
     2641             ,output v-diasize-wndmax
     2642             ,output v-default-value
     2643             ) .
     2644         end.
     2645         assign
     2646           v-diasize-wndstore = false
     2647         .
     2648         if connected("ub") = true
     2649         then do:
     2650           run gbl/wndpar_r.p
     2651             (input  v-cntxt-db-num
     2652             ,input  v-cntxt-userid
     2653             ,input  'wndstore':U
     2654             ,output v-diasize-wndstore
     2655             ,output v-default-value
     2656             ) .
     2657         end.
     2658         assign
     2659           v-diasize-proc-name = entry(1, program-name(2), '.')
     2660         .
     2661         if v-diasize-wndstore = true
     2662         then do:
     2663           assign
     2664             v-restore-saved = false
     2665           .
     2666           if connected("ub") = true
     2667           then do:
     2668             run gbl/wndsizer.p
     2669               (input  v-cntxt-db-num
     2670               ,input  v-cntxt-userid
     2671               ,input  v-diasize-proc-name
     2672               ,input  'height':u
     2673               ,output v-resize-value-str
     2674               ) .
     2675             if v-resize-value-str <> '':U
     2676             then do:
     2677               run diasize_change-height in this-procedure
     2678                 (input  integer(v-resize-value-str)
     2679                 ,input  true
     2680                 ) .
     2681               assign
     2682                 v-restore-saved = true
     2683               .
     2684             end.
     2685           end.
     2686           if connected("ub") = true
     2687           then do:
     2688             run gbl/wndsizer.p
     2689               (input  v-cntxt-db-num
     2690               ,input  v-cntxt-userid
     2691               ,input  v-diasize-proc-name
     2692               ,input  'width':u
     2693               ,output v-resize-value-str
     2694               ) .
     2695             if v-resize-value-str <> '':U
     2696             then do:
     2697               run diasize_change-width in this-procedure
     2698                 (input  integer(v-resize-value-str)
     2699                 ,input  true
     2700                 ) .
     2701               assign
     2702                 v-restore-saved = true
     2703               .
     2704             end.
     2705           end.
     2706           if v-restore-saved <> true
     2707           then do:
     2708             if v-diasize-wndmax = true
     2709             then do:
     2710               run diasize_maximize in this-procedure
     2711                 (input  true
     2712                 ) .
     2713             end.
     2714           end.
     2715         end.
     2716         else do:
     2717           if v-diasize-wndmax = true
     2718           then do:
     2719             run diasize_maximize in this-procedure
     2720               (input  true
     2721               ) .
     2722           end.
     2723         end.
     2724       end.
     2725     end.
     2726   end procedure.
     2727   procedure diasize_need-full-display :
     2728     define output parameter p-need-full-display as logical   no-undo .
     2729     do
     2730     on error undo, return error return-value
     2731     :
     2732       assign
     2733         p-need-full-display = v-diasize-need-full-display
     2734       .
     2735       assign
     2736         v-diasize-need-full-display = false
     2737       .
     2738     end.
     2739   end procedure.
     2740   procedure get-context :
     2741      define output parameter p-db-num as integer          no-undo.
     2742      define output parameter p-user-id as character        no-undo.
     2743      define variable v-login               as character    no-undo.
     2744      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2745      define buffer buf_user-login  for ub.user-login .
     2746      do
     2747      on error undo, return error
     2748      :
     2749            FIND FIRST buf_sys-ctrl no-lock.
     2750            ASSIGN
     2751               v-login = USERID("ub")
     2752               p-db-num = buf_sys-ctrl.db-num
     2753            .
     2754            FIND FIRST buf_user-login
     2755                 WHERE buf_user-login.db-num = p-db-num
     2756                   AND buf_user-login.user-login = v-login
     2757                 no-lock
     2758                 no-error
     2759                 .
     2760            IF AVAILABLE buf_user-login
     2761            THEN DO:
     2762               assign
     2763                  p-user-id = buf_user-login.user-id
     2764               .
     2765            END.
     2766      end.
     2767   end procedure.
     2768       run diasize_init in this-procedure .
     2769   def var sort-labelBROWSE-AM   as character no-undo .
     2770   def var sort-clmnBROWSE-AM    as handle    no-undo .
     2771   def var cur-clmnBROWSE-AM     as handle    no-undo .
     2772   def var cur-clmn-locBROWSE-AM as integer   no-undo .
     2773   def var re-queryBROWSE-AM     as logical   initial no no-undo .
     2774   on start-search, ctrl-o of BROWSE-AM in frame Dialog-Frame do:
     2775      run sort-brBROWSE-AM
     2776        (input (if available buf_Matrix
     2777                then recid(buf_Matrix)
     2778                else ?
     2779               )
     2780        ).
     2781   end.
     2782   PROCEDURE sort-brBROWSE-AM :
     2783     define input parameter p-recid as recid no-undo .
     2784     if re-queryBROWSE-AM = no then do:
     2785       assign
     2786          cur-clmnBROWSE-AM = BROWSE-AM:current-column in frame Dialog-Frame
     2787       .
     2788       if sort-clmnBROWSE-AM <> ? then sort-clmnBROWSE-AM:column-fgcolor = 0.
     2789       if cur-clmnBROWSE-AM = sort-clmnBROWSE-AM then do:
     2790         assign
     2791            sort-labelBROWSE-AM = ""
     2792            sort-clmnBROWSE-AM = ?
     2793         .
     2794        end.
     2795        else do:
     2796          assign
     2797            sort-labelBROWSE-AM = cur-clmnBROWSE-AM:label
     2798            sort-clmnBROWSE-AM  = cur-clmnBROWSE-AM
     2799            sort-clmnBROWSE-AM:column-fgcolor = 4
     2800          .
     2801        end.
     2802      end.
     2803     assign
     2804       cur-clmn-locBROWSE-AM = 1
     2805     .
     2806     def var column-handle as handle no-undo .
     2807     column-handle = BROWSE-AM:first-column.
     2808     do while valid-handle(column-handle) :
     2809       if column-handle = cur-clmnBROWSE-AM then do:
     2810         leave .
     2811       end.
     2812       column-handle = column-handle:NEXT-COLUMN.
     2813       assign
     2814         cur-clmn-locBROWSE-AM = cur-clmn-locBROWSE-AM + 1
     2815       .
     2816     end.
     2817     case sort-labelBROWSE-AM:
     2818           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_Matrix), &1&2&1)', chr(34), p-rid-list)     .     run OpenBr.   . END.
     2819           when 'Название'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-name"     .     run OpenBr.   . END.
     2820           when 'Тип'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-type"     .     run OpenBr.   . END.
     2821           when 'Объект'  then DO:    assign       sort-column-name = "buf_Matrix.obj-type + ' ' + string(buf_Matrix.obj-code,'>>>>>>>>>')"     .     run OpenBr.   . END.
     2822           when 'Дата!изменения'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-date-update"     .     run OpenBr.   . END.
     2823           when 'Время'  then DO:    assign       sort-column-name = "STRING (buf_Matrix.asmt-time-update,'HH:MM')"     .     run OpenBr.   . END.
     2824           when 'Кто!изменил'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-who-update"     .     run OpenBr.   . END.
     2825           when 'БД!изм'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-db-num-update"     .     run OpenBr.   . END.
     2826           when 'Дата!создания'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-date-create"     .     run OpenBr.   . END.
     2827           when 'Время'  then DO:    assign       sort-column-name = "STRING (buf_Matrix.asmt-time-create,'HH:MM')"     .     run OpenBr.   . END.
     2828           when 'Кто!создал'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-who-create"     .     run OpenBr.   . END.
     2829           when 'БД!соз'  then DO:    assign       sort-column-name = "buf_Matrix.asmt-db-num-create"     .     run OpenBr.   . END.
     2830           when 'Статус!AM'  then DO:    assign       sort-column-name = "entry (lookup (STRING(buf_Matrix.asmt-status), '0,1,50,99':U), 'тек,удал,блок,удаление':U)"     .     run OpenBr.   . END.
     2831           when 'Товар!в AM'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1Get-Status-AM-goods&1, recid(buf_Matrix), &1&2&1 )', chr(34), STRING(p-Gds-code))     .     run OpenBr.   . END.
     2832       otherwise do:
     2833         assign
     2834           sort-column-name = ""
     2835         .
     2836         run OpenBr.
     2837         if sort-labelBROWSE-AM <> "" then do:
     2838           assign
     2839             cur-clmnBROWSE-AM:column-fgcolor = 0
     2840           .
     2841         end.
     2842         assign
     2843           cur-clmn-locBROWSE-AM = ?
     2844         .
     2845       end.
     2846     end case.
     2847     if p-recid <> ? then do:
     2848       reposition BROWSE-AM to recid p-recid no-error.
     2849       apply "value-changed" to BROWSE-AM in frame Dialog-Frame.
     2850     end.
     2851     apply "entry" to BROWSE-AM in frame Dialog-Frame.
     2852   END PROCEDURE.
     2853   procedure re-open-query-srt-clmnBROWSE-AM:
     2854   if cur-clmnBROWSE-AM = ? then do:
     2855      run OpenBr.
     2856   end.
     2857   else do:
     2858      assign re-queryBROWSE-AM = yes.
     2859      run sort-brBROWSE-AM
     2860        (input (if available buf_Matrix
     2861                then recid(buf_Matrix)
     2862                else ?
     2863               )
     2864        ).
     2865      assign re-queryBROWSE-AM = no.
     2866   end.
     2867   end.
     2868   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2869   do:
     2870     BROWSE-AM :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2871   end.
     2872   MAIN-BLOCK:
     2873   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2874      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2875   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2876   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2877     (output v-db-num
     2878     )  .
     2879     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     2880     if error-status :error then return error return-value .
     2881     frame Dialog-Frame:TITLE = "Список ассортиментных матриц товара "  + buf_goods.gds-name .
     2882     define variable title0 as character no-undo init "Список Ассортиментных матриц".
     2883     title0 =  frame Dialog-Frame:TITLE.
     2884     run my_enable in this-procedure .
     2885     hide mark-num in frame Dialog-Frame .
     2886     if v-doc-rec <> ? then
     2887     reposition BROWSE-AM to recid v-doc-rec no-error.
     2888   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2889   DEF VAR cur-clmn-numBROWSE-AM as INT EXTENT 14 no-undo.
     2890   DEF VAR varmviBROWSE-AM       as INT no-undo.
     2891   DEF VAR varmvjBROWSE-AM       as INT no-undo.
     2892   DEF VAR varmvkBROWSE-AM       as INT no-undo.
     2893   DEF VAR varmvlBROWSE-AM       as INT no-undo.
     2894   DEF VAR move-elementBROWSE-AM as INT no-undo.
     2895   def var jjBROWSE-AM           as int no-undo.
     2896   do varmviBROWSE-AM = 1 to EXTENT(cur-clmn-numBROWSE-AM):
     2897     ASSIGN cur-clmn-numBROWSE-AM[varmviBROWSE-AM] = varmviBROWSE-AM.
     2898   END.
     2899   RUN start-mv-clmnBROWSE-AM.
     2900   PROCEDURE start-mv-clmnBROWSE-AM:
     2901   def var old-session as logical no-undo.
     2902      old-session = SESSION:IMMEDIATE-DISPLAY.
     2903      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2904          IF  p-mode = 'все':U  THEN DO:
     2905      DO jjBROWSE-AM = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     2906        RUN re-move-clmnBROWSE-AM ( cur-clmn-numBROWSE-AM[INTEGER(ENTRY (jjBROWSE-AM, '1,2,3,4,5,6,7,8,9'))] , 3).
     2907      END.
     2908          END.
     2909      SESSION:IMMEDIATE-DISPLAY = old-session.
     2910   END.
     2911   ON ctrl-cursor-right OF BROWSE BROWSE-AM do:
     2912     RUN re-move-clmnBROWSE-AM ( 3, 14).
     2913   END.
     2914   ON ctrl-cursor-left OF BROWSE BROWSE-AM do:
     2915     RUN re-move-clmnBROWSE-AM (14, 3).
     2916   END.
     2917   PROCEDURE re-move-clmnBROWSE-AM:
     2918     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2919     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2920     DO varmviBROWSE-AM = 1 TO EXTENT(cur-clmn-numBROWSE-AM):
     2921       if cur-clmn-numBROWSE-AM[varmviBROWSE-AM] = source-column THEN cur-clmn-numBROWSE-AM[varmviBROWSE-AM] = -1.
     2922     END.
     2923     if BROWSE-AM:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2924     if source-column > target-column THEN
     2925     DO varmvjBROWSE-AM = source-column - 1 to target-column BY -1:
     2926       DO varmviBROWSE-AM = 1 TO EXTENT(cur-clmn-numBROWSE-AM):
     2927           if cur-clmn-numBROWSE-AM[varmviBROWSE-AM] = varmvjBROWSE-AM THEN DO:
     2928             cur-clmn-numBROWSE-AM[varmviBROWSE-AM] = cur-clmn-numBROWSE-AM[varmviBROWSE-AM] + 1.
     2929           END.
     2930       END.
     2931     END.
     2932     ELSE
     2933     DO varmvjBROWSE-AM = source-column + 1 to target-column:
     2934       DO varmviBROWSE-AM = 1 TO EXTENT(cur-clmn-numBROWSE-AM):
     2935         if cur-clmn-numBROWSE-AM[varmviBROWSE-AM] = varmvjBROWSE-AM THEN DO:
     2936           cur-clmn-numBROWSE-AM[varmviBROWSE-AM] = cur-clmn-numBROWSE-AM[varmviBROWSE-AM] - 1.
     2937         END.
     2938       END.
     2939     END.
     2940     DO varmviBROWSE-AM = 1 TO EXTENT(cur-clmn-numBROWSE-AM):
     2941       if cur-clmn-numBROWSE-AM[varmviBROWSE-AM] = -1 THEN cur-clmn-numBROWSE-AM[varmviBROWSE-AM] = target-column.
     2942     END.
     2943   END PROCEDURE.
     2944   PROCEDURE ch-clmnBROWSE-AM:
     2945     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2946     if cur-clmn-loc <= 3 then do:
     2947       return .
     2948     end.
     2949     DO varmviBROWSE-AM = 1 TO EXTENT(cur-clmn-numBROWSE-AM):
     2950       if cur-clmn-numBROWSE-AM[varmviBROWSE-AM] = cur-clmn-loc THEN move-elementBROWSE-AM = varmviBROWSE-AM.
     2951     END.
     2952     RUN re-move-clmnBROWSE-AM (cur-clmn-loc, 3).
     2953   END PROCEDURE.
     2954   PROCEDURE mv-brw-defaultBROWSE-AM:
     2955   def var old-session as logical no-undo.
     2956     old-session = SESSION:IMMEDIATE-DISPLAY.
     2957     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2958     do varmvlBROWSE-AM = 3 to EXTENT(cur-clmn-numBROWSE-AM):
     2959       RUN re-move-clmnBROWSE-AM (cur-clmn-numBROWSE-AM[varmvlBROWSE-AM], varmvlBROWSE-AM).
     2960     END.
     2961     RUN start-mv-clmnBROWSE-AM.
     2962     SESSION:IMMEDIATE-DISPLAY = old-session.
     2963   END PROCEDURE.
     2964   .
     2965     WAIT-FOR GO OF FRAME Dialog-Frame.
     2966   END.
     2967   run disable_ui in this-procedure .
     2968   PROCEDURE disable_UI :
     2969     HIDE FRAME Dialog-Frame.
     2970   END PROCEDURE.
     2971   PROCEDURE enable_UI :
     2972     DISPLAY RS-sts RS-type RS-object mark-num FILL-IN-1 FILL-IN-2 v-text_object-bd
     2973             v-user-name-create v-user-name-corr
     2974         WITH FRAME Dialog-Frame.
     2975     IF AVAILABLE buf_matrix THEN
     2976       DISPLAY buf_matrix.asmt-des
     2977         WITH FRAME Dialog-Frame.
     2978     ENABLE b-quit B-mark B-sel B-add B-lookup B-chg B-del B-Help B-goods B-print
     2979            RS-sts B-hist RS-type RS-object BROWSE-AM buf_matrix.asmt-des mark-num
     2980            FILL-IN-1 FILL-IN-2 v-text_object-bd v-user-name-create
     2981            v-user-name-corr
     2982         WITH FRAME Dialog-Frame.
     2983     VIEW FRAME Dialog-Frame.
     2984     OPEN QUERY BROWSE-AM FOR EACH buf_matrix NO-LOCK,              EACH buf_matrix-goods OF buf_matrix NO-LOCK INDEXED-REPOSITION.
     2985   END PROCEDURE.
     2986   PROCEDURE my_enable :
     2987   define variable v-db-num like ub.db.db-num no-undo .
     2988   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2989   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2990     (output v-db-num
     2991     )  .
     2992   buf_Matrix.asmt-name:read-only in browse BROWSE-AM = true .
     2993   buf_Matrix.asmt-name:resizable in browse BROWSE-AM = true .
     2994   ASSIGN
     2995   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     2996                 = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     2997                 "Все&!" + chr(44) + 'все':U
     2998   rs-sts = (IF p-sts = ? THEN '0':U ELSE string(p-sts))
     2999   rs-type:RADIO-BUTTONS IN FRAME Dialog-Frame
     3000                   = "Все" + chr(44) +  "1" + chr(44) +
     3001                   "Объект" + chr(44) + "2" + chr(44) +
     3002                   "Шаблон" + chr(44) + "3"
     3003   rs-object:RADIO-BUTTONS IN FRAME Dialog-Frame
     3004                   = "Своя БД" + chr(44) +  "1" + chr(44) +
     3005                     "Все БД" + chr(44) + "2"
     3006   .
     3007   if v-db-num = 0 then
     3008         assign
     3009           rs-object = "2"
     3010           rs-type = "1"
     3011         .
     3012       else
     3013         assign
     3014           rs-object = "1"
     3015           rs-type = "1"
     3016         .
     3017   v-type-s  = 'Шаблон':U  .
     3018   v-type-o  = 'Объект':U .
     3019   if rs-type = "3" then v-type = 'Шаблон':U .
     3020   if rs-type = "2" then v-type = 'Объект':U .
     3021   rs-sts = '0':U .
     3022   DISPLAY mark-num
     3023   FILL-IN-1
     3024   FILL-IN-2
     3025   v-text_object-bd
     3026   RS-sts
     3027   RS-type
     3028   RS-object
     3029   WITH FRAME Dialog-Frame.
     3030   ENABLE
     3031   b-quit
     3032   B-mark when LOOKUP("b-mark":U, bttns) > 0
     3033   B-sel when LOOKUP("b-sel":U, bttns) > 0
     3034   B-add when LOOKUP("b-add":U, bttns) > 0
     3035   B-lookup
     3036   B-chg when LOOKUP("b-add":U, bttns) > 0
     3037   B-del when LOOKUP("b-add":U, bttns) > 0
     3038   B-print
     3039   B-Help
     3040   B-hist
     3041   BROWSE-AM
     3042   mark-num
     3043   RS-sts
     3044   RS-type
     3045   RS-object
     3046   b-goods
     3047   buf_matrix.asmt-des
     3048   with FRAME Dialog-Frame.
     3049   VIEW FRAME Dialog-Frame.
     3050   buf_matrix.asmt-des:READ-ONLY = TRUE.
     3051   run openbr in this-procedure no-error.
     3052   IF ERROR-STATUS:ERROR  THEN RETURN error.
     3053   END PROCEDURE.
     3054   PROCEDURE openBr :
     3055   define variable p-open-query     as logical   no-undo init true .
     3056   define variable l-query-was-opened as logical no-undo .
     3057   define variable doc-rec  as recid     no-undo .
     3058   define variable  p-find-next      as logical   no-undo .
     3059   define variable  p-find-condition as character no-undo .
     3060   ASSIGN  FRAME Dialog-Frame
     3061     rs-sts
     3062     rs-object
     3063     rs-type
     3064       .
     3065   ASSIGN
     3066     p-sts = (IF rs-sts = 'все':U THEN ? ELSE INTEGER(rs-sts))
     3067     .
     3068     if rs-type = "3" then v-type = 'Шаблон':U .
     3069     if rs-type = "2" then v-type = 'Объект':U .
     3070     if rs-type = "1" then v-type = "" .
     3071   define variable sort-column-phrase as character no-undo .
     3072   case sort-column-name :
     3073     when "" then do:
     3074       assign
     3075         sort-column-phrase = ""
     3076       .
     3077     end.
     3078     otherwise do:
     3079       assign
     3080         sort-column-phrase = "by " + sort-column-name
     3081       .
     3082     end.
     3083   end case.
     3084   IF p-sts = ? THEN DO:
     3085       frame Dialog-Frame:TITLE = title0  .
     3086       if rs-type = "1" or rs-type = "" then do:
     3087           if rs-object = "2" then do:
     3088   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3089   define variable  l-disable-where-29  as logical   no-undo .
     3090   define variable  l-filter-open-29    as logical   .
     3091   define variable  flt-rec-29       as recid     no-undo .
     3092   define variable  filter-name-29      as character no-undo .
     3093   define variable  where-phrase-29     as character no-undo .
     3094   define variable  sort-phrase-29      as character no-undo .
     3095   define variable  where-phrase-rus-29 as character no-undo .
     3096   define variable  sort-phrase-rus-29  as character no-undo .
     3097     run waitfram-show in this-procedure
     3098       (input "ЖДИТЕ ..."
     3099       ).
     3100   run gbl/flt-get.p
     3101     (input filter-point
     3102     ,output flt-rec-29
     3103     ,output filter-name-29
