     1686               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1687               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1688                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1689               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1690         otherwise do:
     1691           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1692         end.
     1693       end CASE.
     1694     end.
     1695   end procedure.
     1696   procedure uf-get :
     1697     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1698     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1699     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1700     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1701     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1702     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1703     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1704     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1705     do
     1706     on error undo, return error
     1707     :
     1708       define buffer buf_usr-flt for ubflt.usr-flt .
     1709       define variable v-use-List_     as logical   no-undo .
     1710       define variable v-type-List_     as character no-undo .
     1711       define variable v-format-List_   as character no-undo .
     1712       define variable v-use-Naim      as logical   no-undo .
     1713       define variable v-type-Naim      as character no-undo .
     1714       define variable v-format-Naim    as character no-undo .
     1715       define variable v-use-print-graft as logical   no-undo .
     1716       define variable v-use-sort-gr     as logical   no-undo .
     1717       define variable v-use-type-price  as logical   no-undo .
     1718       define variable v-use-type-val    as logical   no-undo .
     1719       define variable v-label          as character no-undo .
     1720       define variable v-tooltip        as character no-undo .
     1721       define variable v-user-can-edit  as logical   no-undo .
     1722       define variable v-output-display as logical   no-undo .
     1723       define variable v-other          as character no-undo .
     1724       run uf-name in this-procedure
     1725          (input  entry(1, p-code, chr(4))
     1726         ,output v-use-List_
     1727         ,output v-type-List_
     1728         ,output v-format-List_
     1729         ,output v-use-Naim
     1730         ,output v-type-Naim
     1731         ,output v-format-Naim
     1732         ,output v-use-print-graft
     1733         ,output v-use-sort-gr
     1734         ,output v-use-type-price
     1735         ,output v-use-type-val
     1736         ,output v-label
     1737         ,output v-tooltip
     1738         ,output v-user-can-edit
     1739         ,output v-output-display
     1740         ,output v-other
     1741         ) no-error .
     1742       if error-status :error then do:
     1743         undo, return error return-value .
     1744       end.
     1745       find first buf_usr-flt no-lock where
     1746                  buf_usr-flt.Call-point     = p-code AND
     1747                  buf_usr-flt.user-name       = p-user-name
     1748         no-error .
     1749       if avail buf_usr-flt then do:
     1750         assign
     1751         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1752         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1753         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1754         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1755         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1756         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1757         .
     1758       end.
     1759       else do:
     1760         assign
     1761         p-List_        = (if v-use-List_       then "":U                    else ?)
     1762         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1763         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1764         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1765         p-type-price   = (if v-use-type-price  then no                      else ?)
     1766         p-type-val     = (if v-use-List_       then no                      else ?)
     1767         .
     1768       end.
     1769     end.
     1770   end procedure.
     1771   procedure uf-set :
     1772     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1773     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1774     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1775     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1776     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1777     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1778     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1779     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1780     do
     1781     on error undo, return error
     1782     :
     1783       define buffer buf_usr-flt for ubflt.usr-flt .
     1784       define variable v-use-List_     as logical   no-undo .
     1785       define variable v-type-List_     as character no-undo .
     1786       define variable v-format-List_   as character no-undo .
     1787       define variable v-use-Naim      as logical   no-undo .
     1788       define variable v-type-Naim      as character no-undo .
     1789       define variable v-format-Naim    as character no-undo .
     1790       define variable v-use-print-graft as logical   no-undo .
     1791       define variable v-use-sort-gr   as logical   no-undo .
     1792       define variable v-use-type-price as logical   no-undo .
     1793       define variable v-use-type-val  as logical   no-undo .
     1794       define variable v-tooltip        as character no-undo .
     1795       define variable v-label          as character no-undo .
     1796       define variable v-user-can-edit  as logical   no-undo .
     1797       define variable v-output-display as logical   no-undo .
     1798       define variable v-other          as character no-undo .
     1799       run uf-name in this-procedure
     1800         (input  entry(1, p-code, chr(4))
     1801         ,output v-use-List_
     1802         ,output v-type-List_
     1803         ,output v-format-List_
     1804         ,output v-use-Naim
     1805         ,output v-type-Naim
     1806         ,output v-format-Naim
     1807         ,output v-use-print-graft
     1808         ,output v-use-sort-gr
     1809         ,output v-use-type-price
     1810         ,output v-use-type-val
     1811         ,output v-label
     1812         ,output v-tooltip
     1813         ,output v-user-can-edit
     1814         ,output v-output-display
     1815         ,output v-other
     1816         ) no-error .
     1817       if error-status :error then do:
     1818         undo, return error return-value .
     1819       end.
     1820       find first buf_usr-flt where
     1821                  buf_usr-flt.Call-point     = p-code AND
     1822                  buf_usr-flt.user-name       = p-user-name
     1823         no-error .
     1824       if not avail buf_usr-flt then do:
     1825           create buf_usr-flt .
     1826           assign
     1827           buf_usr-flt.call-point = p-code
     1828           buf_usr-flt.user-name  = p-user-name
     1829           .
     1830       end.
     1831       if avail buf_usr-flt then do:
     1832        assign
     1833        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1834        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1835        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1836        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1837        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1838        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1839       .
     1840       release buf_usr-flt.
     1841       end.
     1842       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1843     end.
     1844   end procedure.
     1845   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1846     run mainmenu_getcntxt in parparentproc
     1847       (output v-cntxt-db-num
     1848       ,output v-cntxt-userid
     1849       ,output v-cntxt-level
     1850       ,output v-cntxt-host-code-obj
     1851       ,output v-cntxt-obj-type
     1852       ,output v-cntxt-obj-code
     1853       ,output v-cntxt-db-num-obj
     1854       ,output v-cntxt-is-admin
     1855       ) .
     1856   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1857   define new global shared variable g#attr-lib  as handle no-undo .
     1858   define variable v-attr-lib-variable as handle no-undo .
     1859   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1860   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1861   procedure thbjattr_code :
     1862      define input  parameter p-upper-code     as character no-undo .
     1863      define input  parameter p-code           as character no-undo .
     1864      define output parameter p-label          as character no-undo .
     1865      define output parameter p-user-can-edit  as logical   no-undo .
     1866      define output parameter p-output-display as logical   no-undo .
     1867      define output parameter p-other          as character no-undo .
     1868      define output parameter p-prop-list      as character no-undo .
     1869      define output parameter p-prop-type-list as character no-undo .
     1870      define output parameter p-prop-label-list as character no-undo .
     1871      define output parameter p-global          as logical no-undo .
     1872      define output parameter p-host           as logical no-undo .
     1873      define output parameter p-shop           as logical no-undo .
     1874      define output parameter p-store          as logical no-undo .
     1875      define output parameter p-db             as logical no-undo .
     1876      define variable p-region as logical no-undo.
     1877      run thbjattr_code_reg in this-procedure (
     1878                                               p-upper-code,
     1879                                               p-code,
     1880                                               output p-label,
     1881                                               output p-user-can-edit,
     1882                                               output p-output-display,
     1883                                               output p-other,
     1884                                               output p-prop-list,
     1885                                               output p-prop-type-list,
     1886                                               output p-prop-label-list,
     1887                                               output p-global,
     1888                                               output p-host,
     1889                                               output p-shop,
     1890                                               output p-store,
     1891                                               output p-db,
     1892                                               output p-region
     1893                                               ).
     1894   end procedure.
     1895   procedure thbjattr_code_reg :
     1896   define input  parameter p-upper-code     as character no-undo .
     1897   define input  parameter p-code           as character no-undo .
     1898   define output parameter p-label          as character no-undo .
     1899   define output parameter p-user-can-edit  as logical   no-undo .
     1900   define output parameter p-output-display as logical   no-undo .
     1901   define output parameter p-other          as character no-undo .
     1902   define output parameter p-prop-list      as character no-undo .
     1903   define output parameter p-prop-type-list as character no-undo .
     1904   define output parameter p-prop-label-list as character no-undo .
     1905   define output parameter p-global          as logical no-undo .
     1906   define output parameter p-host           as logical no-undo .
     1907   define output parameter p-shop           as logical no-undo .
     1908   define output parameter p-store          as logical no-undo .
     1909   define output parameter p-db             as logical no-undo .
     1910   define output parameter p-region         as logical no-undo .
     1911   do
     1912   on error undo, return error return-value
     1913   :
     1914       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     1915       (input  p-upper-code
     1916       ,input  p-code
     1917       ,output p-label
     1918       ,output p-user-can-edit
     1919       ,output p-output-display
     1920       ,output p-other
     1921       ,output p-prop-list
     1922       ,output p-prop-type-list
     1923       ,output p-prop-label-list
     1924       ,output p-global
     1925       ,output p-host
     1926       ,output p-shop
     1927       ,output p-store
     1928       ,output p-db
     1929       ,output p-region
     1930       ) no-error .
     1931     if error-status :error
     1932     then do:
     1933       undo, return error substitute( "&1. &2&3&4", vss-include-info11, return-value, chr(10), error-status :get-message (1)).
     1934     end.
     1935   end.
     1936   end procedure.
