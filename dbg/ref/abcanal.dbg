      807   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      808   function func-get-name-from-ext-type   returns char
      809     ( p-ext-type as character   ,
      810       p-caps     as logical ).
      811   define variable v-ext-name as character no-undo .
      812   run get-name-from-ext-type in this-procedure (
      813       input p-ext-type  ,
      814       input p-caps  ,
      815       output v-ext-name )
      816       no-error .
      817       if error-status :error then do:
      818          assign
      819            v-ext-name = p-ext-type
      820          .
      821       end.
      822    return (v-ext-name) .
      823   end.
      824   procedure get-name-from-ext-type :
      825    do
      826    on error undo, return error return-value
      827    :
      828   define input  parameter p-ext-type as character no-undo .
      829   define input  parameter p-caps     as logical no-undo   .
      830   define output parameter p-ext-name as character no-undo .
      831   define variable v-num as integer no-undo .
      832     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      833       message
      834         vss-include-info6 skip
      835         "Неправильно задано значение входящего параметра! "
      836         "Нет такого типа документов " p-ext-type
      837         view-as alert-box error .
      838         undo, return error .
      839     end.
      840     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      841     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      842     if p-caps  = true then do :
      843        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      844     end .
      845     end.
      846   end procedure.
      847   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848     define variable v-cntxt-db-num        as integer   no-undo .
      849     define variable v-cntxt-userid        as character no-undo .
      850     define variable v-cntxt-level         as character no-undo .
      851     define variable v-cntxt-host-code-obj as integer   no-undo .
      852     define variable v-cntxt-obj-type      as character no-undo .
      853     define variable v-cntxt-obj-code      as integer   no-undo .
      854     define variable v-cntxt-db-num-obj    as integer   no-undo .
      855     define variable v-cntxt-is-admin      as logical   no-undo .
      856   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      857   define temp-table temp-index_name-value no-undo
      858   field name-key  as character
      859   field value-key as character
      860   index pi name-key
      861   .
      862   define temp-table temp-sub-index_name no-undo
      863   field name-key  as character
      864   field nn as integer
      865   index pi nn
      866   .
      867   procedure def-hash :
      868     do
      869     on error undo, return error return-value
      870     :
      871     define input  parameter p-full-string as character no-undo .
      872     define output parameter p-possb-keep-string as logical   no-undo .
      873     define output parameter p-string            as character no-undo .
      874     define output parameter p-hash-string       as character no-undo .
      875       p-full-string = trim( p-full-string ) .
      876       if length (p-full-string ) > 150 then do:
      877       assign
      878         p-possb-keep-string =  false
      879         p-string            =  substring(p-full-string,1,150)
      880         p-hash-string       =  encode(p-full-string)
      881       .
      882       end.
      883       else do:
      884       assign
      885         p-possb-keep-string =  true
      886         p-string            =  p-full-string
      887         p-hash-string       =  encode(p-full-string)
      888       .
      889       end.
      890     end.
      891   end procedure.
      892   procedure find-from-hash :
      893     do
      894     on error undo, return error return-value
      895     :
      896   define input  parameter  p-full-string            as character no-undo .
      897   define input  parameter  p-table-name             as character no-undo .
      898   define input  parameter  p-field-possb-keep-name  as character no-undo .
      899   define input  parameter  p-field-string-name      as character no-undo .
      900   define input  parameter  p-field-hash-string-name as character no-undo .
      901   define input  parameter  p-sub-table-name         as character no-undo .
      902   define output parameter  p-recid                  as recid     no-undo .
      903   define variable v-possb-keep-string as logical   no-undo .
      904   define variable v-string            as character no-undo .
      905   define variable v-hash-string       as character no-undo .
      906   define variable v-query-prepare     as character no-undo .
      907   define variable i  as integer no-undo .
      908   define variable qh as widget-handle no-undo .
      909   define variable bh as widget-handle no-undo .
      910   define variable p-rez as logical   no-undo .
      911   run def-hash in this-procedure (input  p-full-string ,
      912                 output v-possb-keep-string ,
      913                 output v-string            ,
      914                 output v-hash-string
      915                 ).
      916   p-recid = ? .
      917   create buffer bh for table p-table-name.
      918   create query qh.
      919      v-query-prepare =
      920       "for each " + p-table-name + " no-lock where "
      921       + p-field-possb-keep-name   + " = "  + string(v-possb-keep-string) + " and "
      922       + p-field-string-name       + " = '" + v-string            + "' and "
      923       + p-field-hash-string-name  + " = '" + v-hash-string       + "'"
      924       .
      925   if v-possb-keep-string = true then do:
      926       qh:set-buffers(bh).
      927       qh:query-prepare(v-query-prepare).
      928       qh:query-open.
      929       qh:get-first.
      930       p-recid = bh:recid.
      931   end.
      932   else do:
      933   message false "анализ hash" .
      934     qh:set-buffers(bh).
      935     qh:query-prepare(v-query-prepare).
      936     qh:query-open.
      937     qh:get-first.
      938     p-recid = bh:recid.
      939     repeat :
      940       qh:get-next.
      941       if bh:available then do:
      942          qh:get-first.
      943          run ver-sub-table in this-procedure (
      944              input  p-full-string ,
      945              input  p-table-name ,
      946              input  p-sub-table-name ,
      947              input  bh:recid  ,
      948              output p-rez
      949              ).
      950          if p-rez = true  then do:
      951             p-recid = bh:recid .
      952             leave.
      953          end.
      954          else do:
      955            next.
      956          end.
      957       end.
      958       leave.
      959     end.
      960   end.
      961   delete widget bh.
      962   delete widget qh.
      963     end.
      964   end procedure.
      965   procedure ver-sub-table :
      966     do
      967     on error undo, return error return-value
      968     :
      969   define input  parameter p-full-string as character no-undo .
      970   define input  parameter p-name-table as character no-undo .
      971   define input  parameter p-sub-name-table as character no-undo .
      972   define input  parameter p-recid as recid no-undo .
      973   define output parameter p-ok as logical   no-undo .
      974   define variable v-query-prepare     as character no-undo .
      975   define variable i  as integer no-undo .
      976   define variable qh as widget-handle no-undo .
      977   define variable bh as widget-handle no-undo .
      978   define variable p-rez as logical   no-undo .
      979   for each temp-index_name-value : delete temp-index_name-value . end.
      980   for each temp-sub-index_name : delete temp-sub-index_name . end.
      981       create buffer bh for table p-name-table.
      982       create query qh.
      983       v-query-prepare = "for each " + p-name-table + " no-lock where recid(" + p-name-table + ") = " + string ( p-recid ) .
      984       qh:set-buffers(bh).
      985       qh:query-prepare(v-query-prepare).
      986       qh:query-open.
      987       qh:get-first.
      988       p-recid = bh:recid.
      989   define variable v-inf-ind AS CHAR NO-UNDO.
      990   define variable v-name-pi as character no-undo .
      991   define variable v-num-fl-inkey as integer   no-undo .
      992   define variable v-num-fl       as integer   no-undo .
      993   define variable j as integer   no-undo .
      994   v-name-pi = bh:PRIMARY .
      995   v-inf-ind = "1".
      996   i = 0.
      997   DO while ( v-inf-ind <> ? )
      998       on error undo, return error:
      999       i = i + 1 .
     1000       v-inf-ind = bh:INDEX-INFORMATION(i) .
     1001       if v-inf-ind = ? then leave.
     1002       if entry( 1 , v-inf-ind ) = v-name-pi then do:
     1003          v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
     1004          v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
     1005         if v-num-fl-inkey >= 1 then do:
     1006             do j = 5 to v-num-fl  by 2 :
     1007                 create temp-index_name-value .
     1008                 assign
     1009                   temp-index_name-value.name-key  = entry( j , v-inf-ind )
     1010                   temp-index_name-value.value-key = bh:BUFFER-FIELD(entry( j , v-inf-ind )):BUFFER-VALUE
     1011                 .
     1012             end.
     1013          end.
     1014       end.
     1015   END.
     1016   define variable qh-sub as widget-handle no-undo .
     1017   define variable bh-sub as widget-handle no-undo .
     1018       create buffer bh-sub for table p-sub-name-table.
     1019       create query qh-sub.
     1020   define variable k as integer   no-undo init 0 .
     1021       v-query-prepare = "for each " + p-sub-name-table + " no-lock where " .
     1022       for each temp-index_name-value :
     1023           v-query-prepare = v-query-prepare  + p-sub-name-table + "." + temp-index_name-value.name-key +
     1024                         " = " + temp-index_name-value.value-key + " and " .
     1025       end.
     1026       v-query-prepare = v-query-prepare + " true = true " .
     1027       qh-sub:set-buffers(bh-sub).
     1028       qh-sub:query-prepare(v-query-prepare).
     1029       qh-sub:query-open.
     1030         v-name-pi = bh-sub:PRIMARY .
     1031         v-inf-ind = "1".
     1032         i = 0.
     1033         DO while ( v-inf-ind <> ? )
     1034             on error undo, return error:
     1035             i = i + 1 .
     1036             v-inf-ind = bh-sub:INDEX-INFORMATION(i) .
     1037             if v-inf-ind = ? then leave.
     1038             if entry( 1 , v-inf-ind ) = v-name-pi then do:
     1039               v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
     1040               v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
     1041               if v-num-fl-inkey >= 1 then do:
     1042                   do j = 5 to v-num-fl  by 2 :
     1043                       if not can-find (first temp-index_name-value  where temp-index_name-value.name-key =  entry( j , v-inf-ind )) then do:
     1044                           create temp-sub-index_name .
     1045                           assign
     1046                             temp-sub-index_name.name-key  = entry( j , v-inf-ind )
     1047                             temp-sub-index_name.nn  = j
     1048                           .
     1049                       end.
     1050                   end.
     1051               end.
     1052             end.
     1053         END.
     1054         define variable v-qw as character no-undo .
     1055         v-qw = "".
     1056         qh-sub:GET-first.
     1057         DO WHILE (bh-sub:AVAILABLE):
     1058           for each temp-sub-index_name :
     1059               v-qw = v-qw + string(bh-sub:BUFFER-FIELD(temp-sub-index_name.name-key):BUFFER-VALUE) .
     1060           end.
     1061           v-qw = v-qw + ",".
     1062           qh-sub:GET-NEXT.
     1063         END.
     1064         p-ok = false .
     1065         if trim(p-full-string, ",")  =  trim (v-qw, ",") then p-ok = true  .
     1066       delete widget bh-sub.
     1067       delete widget qh-sub.
     1068       delete widget bh.
     1069       delete widget qh.
     1070     end.
     1071   end procedure.
     1072   PROCEDURE update-rang-def :
     1073   define input  parameter p-recid as recid     no-undo .
     1074   define input  parameter p-list-obj as character no-undo .
     1075   define input  parameter p-a as decimal   no-undo .
     1076   define input  parameter p-b as decimal   no-undo .
     1077   define input  parameter p-c as decimal   no-undo .
     1078   define input  parameter p-d as decimal   no-undo .
     1079   define input  parameter p-e as decimal   no-undo .
