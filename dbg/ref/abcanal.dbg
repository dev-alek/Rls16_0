     2454         STRING (x-abc-analysis.abc-time-create,'HH:MM') COLUMN-LABEL "Время!созд" FORMAT "x(5)":U WIDTH 5
     2455         x-abc-analysis.abc-db-num-create                COLUMN-LABEL "БД" FORMAT ">>>>9":U
     2456         x-abc-analysis.abc-who-create                   COLUMN-LABEL "Кто провел!анализ" FORMAT "X(15)":U WIDTH 10
     2457         v-def   COLUMN-LABEL "d!e!f" FORMAT "x(1)":U WIDTH 1
     2458         x-abc-analysis.abc-id                           COLUMN-LABEL "Внутренний!№" FORMAT ">>>>>>>>>9":U
     2459     ENABLE
     2460         x-abc-analysis.abc-name
     2461       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 11 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     2462   DEFINE BROWSE BROWSE-obj
     2463     QUERY BROWSE-obj NO-LOCK DISPLAY
     2464         x-abc-analysis-obj.obj-type FORMAT "X(3)":U
     2465         x-abc-analysis-obj.obj-code FORMAT ">>>>>>>>9":U
     2466       WITH NO-ROW-MARKERS SEPARATORS SIZE 13 BY 6.75
     2467            TITLE "Объекты" FIT-LAST-COLUMN TOOLTIP "Объекты АВС анализа".
     2468   DEFINE BROWSE BROWSE-period
     2469     QUERY BROWSE-period NO-LOCK DISPLAY
     2470         x-abc-analysis-period.abcp-start COLUMN-LABEL "Начало" FORMAT "99/99/99":U
     2471         x-abc-analysis-period.abcp-end COLUMN-LABEL "Конец" FORMAT "99/99/99":U
     2472       WITH NO-ROW-MARKERS SEPARATORS SIZE 20 BY 6.75
     2473            TITLE "Интервалы анализа" FIT-LAST-COLUMN TOOLTIP "Интервалы анализа".
     2474   DEFINE BROWSE BROWSE-type-doc
     2475     QUERY BROWSE-type-doc NO-LOCK DISPLAY
     2476         f-name-doc ( buffer x-abc-analysis-doc) COLUMN-LABEL "Тип документа" FORMAT "x(22)":U
     2477               WIDTH 22
     2478       WITH NO-ROW-MARKERS SEPARATORS SIZE 25 BY 6.75
     2479            TITLE "Типы документов" FIT-LAST-COLUMN TOOLTIP "Типы документов анализа".
     2480   DEFINE FRAME Dialog-Frame
     2481        b-quit AT ROW 1 COL 1
     2482        B-mark AT ROW 1 COL 14
     2483        B-sel AT ROW 1 COL 17
     2484        B-add AT ROW 1 COL 27
     2485        B-lookup AT ROW 1 COL 37
     2486        B-chg AT ROW 1 COL 57.5
     2487        B-del AT ROW 1 COL 67.5
     2488        B-print AT ROW 1 COL 77.5
     2489        B-Help AT ROW 1 COL 87.5
     2490        BROWSE-ABC AT ROW 3 COL 1
     2491        BROWSE-obj AT ROW 16.25 COL 2
     2492        BROWSE-period AT ROW 16.25 COL 15
     2493        BROWSE-type-doc AT ROW 16.25 COL 35
     2494        ub.x-abc-analysis.abc-des AT ROW 16.25 COL 60.5 NO-LABEL
     2495             VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2496             SIZE 37.88 BY 6.79 TOOLTIP "Описание анализа"
     2497        mark-num AT ROW 1 COL 9 COLON-ALIGNED NO-LABEL
     2498        x-abc-analysis.abc-name AT ROW 14.21 COL 2 NO-LABEL FORMAT "X(50)"
     2499              VIEW-AS TEXT
     2500             SIZE 72.5 BY .67 TOOLTIP "Наименование анализа"
     2501             FGCOLOR 4
     2502        v-user-name AT ROW 14.21 COL 80.5 COLON-ALIGNED WIDGET-ID 2
     2503        x-criterion-analysis.cral-name AT ROW 15.25 COL 1.5 NO-LABEL FORMAT "X(50)"
     2504              VIEW-AS TEXT
     2505             SIZE 96.5 BY .67 TOOLTIP "Критерий анализа"
     2506             FGCOLOR 4
     2507        SPACE(0.38) SKIP(7.12)
     2508       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2509            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2510            TITLE "Список ABC-анализов".
     2511   ASSIGN
     2512          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2513          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2514   ASSIGN
     2515          B-chg:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2516   ASSIGN
     2517          B-del:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2518   ASSIGN
     2519          BROWSE-ABC:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 2.
     2520   ASSIGN
     2521          x-criterion-analysis.cral-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2522   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2523   DO:
     2524     APPLY "END-ERROR":U TO SELF.
     2525   END.
     2526   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     2527   DO:
     2528     define variable loc#log as logical no-undo.
     2529     define variable loc-doc-rec as recid no-undo .
     2530   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2531   do:
     2532     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2533       (input  v-cntxt-db-num
     2534       ,input  v-cntxt-userid
     2535       ,input  0
     2536       ,input  'actn_ABC-XYZ_add-def':U
     2537       ,input  'global':U
     2538       ,input  0
     2539       ,input  '':U
     2540       ,input  0
     2541       ,input  0
     2542       ,input  0
     2543       ,input  0
     2544       ,input  true
     2545       ,output loc#log
     2546       )  .
     2547   end.
     2548     if not loc#log then return no-apply.
     2549     RUN proc-add (output loc-doc-rec ) no-error  .
     2550     if error-status :error then message
     2551     error-status :get-message(1)
     2552     return-value .
     2553     if loc-doc-rec <> ? THEN DO:
     2554         RUn OpenBR in this-procedure .
     2555         reposition BROWSE-ABC to recid loc-doc-rec no-error.
     2556     END.
     2557     apply "entry" to BROWSE-ABC in frame Dialog-Frame.
     2558     apply "value-changed" to BROWSE-ABC in frame Dialog-Frame.
     2559   END.
     2560   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     2561   DO:
     2562   define variable loc#log as logical no-undo.
     2563   define variable loc-doc-rec as recid no-undo .
     2564   if not available x-abc-analysis then return no-apply.
     2565   assign
     2566   loc-doc-rec = recid(x-abc-analysis).
     2567      run ref/abcanali.w
     2568        ( INPUT parParentProc ,
     2569          INPUT  'ИЗМЕНЕНИЕ':U ,
     2570          INPUT x-abc-analysis.abc-id ,
     2571          INPUT x-abc-analysis.db-num ,
     2572          input-output loc-doc-rec
     2573          ) .
     2574      run OpenBR .
     2575      reposition BROWSE-ABC to recid loc-doc-rec .
     2576      apply "entry" to BROWSE-ABC in frame Dialog-Frame.
     2577      apply "value-changed" to BROWSE-ABC in frame Dialog-Frame.
     2578   END.
     2579   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     2580   DO:
     2581   define variable v-log as logical   no-undo .
     2582   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2583   do:
     2584     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2585       (input  v-cntxt-db-num
     2586       ,input  v-cntxt-userid
     2587       ,input  0
     2588       ,input  'actn_ABC-XYZ_deletion':U
     2589       ,input  'global':U
     2590       ,input  0
     2591       ,input  '':U
     2592       ,input  0
     2593       ,input  0
     2594       ,input  0
     2595       ,input  0
     2596       ,input  true
     2597       ,output v-log
     2598       )  .
     2599   end.
     2600      if v-log = false then return no-apply.
     2601       message "Удалить АВС анализ ?"
     2602         view-as alert-box question
     2603         buttons yes-no
     2604         update g-log as logical.
     2605       if g-log = false then return no-apply.
     2606       run waitfram-show ("Ждите...").
     2607       run proc-b-del in this-procedure no-error.
     2608       if error-status:error then do:
     2609             run waitfram-hide .
     2610             return no-apply.
     2611          end.
     2612       run waitfram-hide .
     2613   END.
     2614   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     2615   DO:
     2616   define variable loc#log as logical no-undo.
     2617   define variable loc-doc-rec as recid no-undo .
     2618   if not available x-abc-analysis then return no-apply.
     2619   assign
     2620   loc-doc-rec = recid(x-abc-analysis).
     2621   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2622   do:
     2623     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2624       (input  v-cntxt-db-num
     2625       ,input  v-cntxt-userid
     2626       ,input  0
     2627       ,input  'actn_ABC-XYZ_lookup':U
     2628       ,input  'global':U
     2629       ,input  0
     2630       ,input  '':U
     2631       ,input  0
     2632       ,input  0
     2633       ,input  0
     2634       ,input  0
     2635       ,input  true
     2636       ,output loc#log
     2637       )  .
     2638   end.
     2639      if not loc#log then return no-apply.
     2640      run ref/abcanali.w
     2641      ( input parparentproc ,
     2642        input 'ПРОСМОТР':U ,
     2643        input x-abc-analysis.abc-id ,
