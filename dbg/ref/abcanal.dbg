     2437   DEFINE QUERY BROWSE-type-doc FOR
     2438         x-abc-analysis-doc SCROLLING.
     2439   DEFINE BROWSE BROWSE-ABC
     2440     QUERY BROWSE-ABC NO-LOCK DISPLAY
     2441         mark-string ( recid( x-abc-analysis), p-rid-list )  COLUMN-LABEL "*" FORMAT "X(1)":U
     2442         x-abc-analysis.abc-name                         COLUMN-LABEL "Наименование" FORMAT "X(30)":U WIDTH 20
     2443         x-criterion-analysis.cral-name                  COLUMN-LABEL "Критерий!анализа" FORMAT "X(55)":U WIDTH 20
     2444        x-abc-analysis.abc-a          COLUMN-LABEL "A%" FORMAT ">>.<":U WIDTH 4
     2445        x-abc-analysis.abc-b - x-abc-analysis.abc-a  @ v-b   COLUMN-LABEL "B%" FORMAT ">>.<":U WIDTH 4
     2446        x-abc-analysis.abc-c - x-abc-analysis.abc-b  @ v-c   COLUMN-LABEL "C%" FORMAT ">>.<":U WIDTH 4
     2447        if ( x-abc-analysis.abc-d - x-abc-analysis.abc-c ) < 0 then 0 else x-abc-analysis.abc-d - x-abc-analysis.abc-c  @ v-d   COLUMN-LABEL "D%" FORMAT ">>.<":U WIDTH 4
     2448        if ( x-abc-analysis.abc-e - x-abc-analysis.abc-d ) < 0 then 0 else x-abc-analysis.abc-e - x-abc-analysis.abc-d  @ v-e   COLUMN-LABEL "E%" FORMAT ">>.<":U WIDTH 4
     2449        if ( x-abc-analysis.abc-f - x-abc-analysis.abc-e ) < 0 then 0 else x-abc-analysis.abc-f - x-abc-analysis.abc-e  @ v-f   COLUMN-LABEL "F%" FORMAT ">>.<":U WIDTH 4
     2450         x-abc-analysis.abc-string-obj                   COLUMN-LABEL "Строка!объектов" FORMAT "X(30)":U WIDTH 10
     2451         x-abc-analysis.abc-string-period                COLUMN-LABEL "Строка!периодов" FORMAT "X(30)":U WIDTH 10
     2452         x-abc-analysis.abc-string-doc                   COLUMN-LABEL "Строка!документов" FORMAT "X(30)":U WIDTH 10
