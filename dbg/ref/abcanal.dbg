     2403        SIZE 10 BY 1
     2404        BGCOLOR 8 .
     2405   DEFINE BUTTON B-lookup
     2406        LABEL "&Просмотр"
     2407        SIZE 10 BY 1 TOOLTIP "Просмотр результата анализа".
