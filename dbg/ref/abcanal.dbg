     2147   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2148   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2149   procedure fltopend_fltopend :
     2150   define input parameter p-parent-handle as handle no-undo .
     2151   define input parameter p-qh as handle no-undo .
     2152   define input parameter p-flt-open-open-query  as character no-undo .
     2153   define input parameter p-where-cond as character no-undo .
     2154   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2155   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2156   define input parameter p-indexed-reposition as character no-undo .
     2157     do
     2158     on error undo, return error
     2159     :
     2160   define variable v-prepare-string as character no-undo .
     2161   define variable glog as logical no-undo .
     2162   assign
     2163   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2164                      p-where-cond + chr(32)  +
     2165                      p-use-indFIRST-query-tail + chr(32) +
     2166                      p-use-ind-sort-clmn-by + chr(32) +
     2167                      p-indexed-reposition
     2168   .
     2169   assign
     2170   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2171   if not glog
     2172   or error-status:error then do:
     2173     message error-status:get-message(1) view-as alert-box .
     2174     undo, return error .
     2175   end.
     2176   assign
     2177   glog = p-qh:query-open no-error .
     2178   if not glog
     2179   or error-status:error then do:
     2180     message error-status:get-message(1) view-as alert-box .
     2181     undo, return error .
     2182   end.
     2183     end.
     2184   end procedure.
     2185   procedure fltopend_fltfindd :
     2186   define input parameter p-parent-handle as handle no-undo .
     2187   define input parameter p-qh as handle no-undo .
     2188   define input parameter p-rowid as rowid no-undo .
     2189   define input parameter p-next as logical no-undo .
     2190   define input parameter p-lock as integer no-undo .
     2191   define input parameter p-bh as handle no-undo .
     2192   define input parameter p-where-cond as character no-undo .
     2193   define input parameter p-use-index-phrase as character no-undo .
     2194   define variable glog as logical no-undo .
     2195   define variable v-qh as handle no-undo .
     2196   define variable v-bh as handle no-undo .
     2197   define variable v-recid as recid no-undo .
     2198   define variable v-prepare-string as character no-undo .
     2199   do
     2200   on error undo, return error
     2201   on stop undo, return error
     2202   :
     2203     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2204     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2205     create query v-qh.
     2206     v-qh:set-buffers(v-bh).
     2207     v-prepare-string = substitute("for each &1 &2 &3"
     2208                                     ,v-bh:name
     2209                                     ,p-where-cond
     2210                                     ,p-use-index-phrase).
     2211     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2212     if not glog then do:
     2213       delete object v-qh.
     2214       delete object v-bh.
     2215       undo, return error .
     2216     end.
     2217     glog = v-qh:query-open no-error .
     2218     if not glog then do:
     2219       delete object v-qh.
     2220       delete object v-bh.
     2221       undo, return error .
     2222     end.
     2223     if p-next then do:
     2224       v-qh:reposition-to-rowid(p-rowid) no-error .
     2225       glog = v-qh:get-next( p-lock) no-error .
     2226       glog = v-qh:get-next( p-lock) no-error .
     2227       if not glog or v-qh:query-off-end = yes then do:
     2228         glog = v-qh:get-first( p-lock) no-error .
     2229       end.
     2230     end.
     2231     else do:
     2232       glog = v-qh:get-first( p-lock) no-error .
     2233     end.
     2234     v-recid = v-bh:recid no-error .
     2235     delete object v-qh.
     2236     delete object v-bh.
     2237     return string(v-recid) .
     2238   end.
     2239   end procedure.
     2240   procedure fltopend_fltfindq :
     2241   define input parameter p-parent-handle as handle no-undo .
     2242   define input parameter p-qh as handle no-undo .
     2243   define input parameter p-next as logical no-undo .
     2244   define input parameter p-lock as integer no-undo .
     2245   define input parameter p-flt-open-open-query  as character no-undo .
     2246   define input parameter p-where-cond as character no-undo .
     2247   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2248   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2249   define input parameter p-indexed-reposition as character no-undo .
     2250   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2251   define variable glog as logical no-undo .
     2252   define variable v-qh as handle no-undo .
     2253   define variable v-bh as handle no-undo extent 18.
     2254   define variable v-rowid as rowid no-undo extent 18.
     2255   define variable v-ii as integer no-undo .
     2256   define variable v-prepare-string as character no-undo .
     2257   do
     2258   on error undo, return error
     2259   on stop undo, return error
     2260   :
     2261     create query v-qh.
     2262     do v-ii = 1 to p-qh:num-buffers:
     2263       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2264       assign
     2265       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2266       no-error.
     2267       v-qh:add-buffer(v-bh[v-ii]).
     2268     end.
     2269     assign
     2270     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2271                       p-where-cond + chr(32)  +
     2272                       p-use-indFIRST-query-tail + chr(32) +
     2273                       p-use-ind-sort-clmn-by + chr(32) +
     2274                       p-indexed-reposition
     2275     .
     2276     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2277     if not glog then do:
     2278       delete object v-qh.
     2279       do v-ii = 1 to p-qh:num-buffers:
     2280         delete object v-bh[v-ii].
     2281       end.
     2282       undo, return error .
     2283     end.
     2284     glog = v-qh:query-open no-error .
     2285     if not glog then do:
     2286       delete object v-qh.
     2287       do v-ii = 1 to p-qh:num-buffers:
     2288         delete object v-bh[v-ii].
     2289       end.
     2290       undo, return error .
     2291     end.
     2292     if p-next then do:
     2293       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2294       glog = v-qh:get-next( p-lock) no-error .
     2295       glog = v-qh:get-next( p-lock) no-error .
     2296       if not glog or v-qh:query-off-end = yes then do:
     2297         glog = v-qh:get-first( p-lock) no-error .
     2298       end.
     2299     end.
     2300     else do:
     2301       glog = v-qh:get-first( p-lock) no-error .
     2302     end.
     2303     do v-ii = 1 to p-qh:num-buffers:
     2304       assign
     2305       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2306       no-error.
     2307     end.
     2308     delete object v-qh.
     2309     do v-ii = 1 to p-qh:num-buffers:
     2310       delete object v-bh[v-ii].
     2311     end.
     2312   end.
     2313   end procedure.
     2314   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2315   FUNCTION mark-string RETURNS CHARACTER
     2316     ( input p-recid as recid, input mark-list as character  ) :
     2317     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     2318   END FUNCTION.
     2319   function fnc-convert-dot-to-colon returns character
     2320       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     2321   function fnc-convert-dot-to-colon returns character
     2322   (input p-data as decimal, input p-accur as character, input p-num as integer):
     2323       define variable result as character no-undo.
     2324       define variable v-str-result as character no-undo.
     2325       if p-data = ? then p-data = 0 .
     2326       p-data = round(p-data, p-num).
     2327       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2328       return v-str-result.
     2329   END FUNCTION.
     2330   define variable mark-str  as character no-undo.
