     2649   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2650   DO:
     2651     define variable loc#log as logical no-undo .
     2652     if AVAILABLE x-abc-analysis  then do:
     2653   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2654   define variable v-str-recid20 as character no-undo .
     2655   define variable v-num-entry20 as integer   no-undo .
     2656   assign
     2657     v-str-recid20 = trim( string( recid( x-abc-analysis ) , "->>>>>>>>>>>9":U ) )
     2658     v-num-entry20 = lookup( v-str-recid20 , p-rid-list )
     2659   .
     2660   if v-num-entry20 > 0 then do:
     2661     assign
     2662       entry( v-num-entry20, p-rid-list ) = "":U
     2663       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2664     .
     2665   end.
     2666   else do:
     2667     assign
     2668       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid20
     2669     .
     2670   end.
     2671       loc#log = BROWSE-ABC:refresh() .
     2672       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2673           loc#log = BROWSE-ABC:select-next-row ().
     2674           apply "VALUE-CHANGED" to BROWSE-ABC in frame Dialog-Frame.
     2675       end.
     2676       if num-entries( p-rid-list ) = 0
     2677       then
     2678           hide mark-num in frame Dialog-Frame.
     2679       else
     2680           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     2681     end.
     2682     apply "entry" to BROWSE-ABC in frame Dialog-Frame.
     2683   END.
     2684   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2685   DO:
     2686     run proc-b-print in this-procedure no-error.
     2687     if error-status:error then do:
     2688       return no-apply.
     2689     end.
     2690   END.
     2691   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     2692   DO:
     2693     p-rid-list = "" .
     2694   define variable cur-clmn-loc as integer   no-undo .
     2695   define variable column-handle as handle no-undo .
     2696   define variable v-list as character no-undo .
     2697     assign
     2698       cur-clmn-loc  = 1
     2699       column-handle = BROWSE-ABC:first-column
     2700       v-list        = column-handle:label + "#"
     2701     .
     2702     do while valid-handle(column-handle) :
     2703       if cur-clmn-loc = BROWSE-ABC:num-columns then do:
     2704         leave .
     2705       end.
     2706       assign
     2707         column-handle = column-handle:NEXT-COLUMN
     2708         cur-clmn-loc  = cur-clmn-loc + 1
     2709         v-list        = v-list + column-handle:label + "#"
     2710       .
     2711     end.
     2712      v-list = trim(v-list, "#") .
     2713      define variable v-i as integer   no-undo .
     2714      define variable v-pos as integer   no-undo .
     2715      define variable v-list-new as character no-undo .
     2716      define variable v-elem as character no-undo .
     2717      repeat v-i = 1 to BROWSE-ABC:num-columns :
     2718         v-elem = entry( v-i, v-list , "#") .
     2719         v-pos = lookup( v-elem , '*' + '#' +  'Наименование' + '#' +  'Критерий!анализа' + '#' +  'A%' + '#' +  'B%' + '#' +  'C%' + '#' +  'D%' + '#' +  'E%' + '#' +  'F%' + '#' +  'Строка!объектов' + '#' +  'Строка!документов' + '#' +  'Дата!создания' + '#' +  'Время!созд' + '#' +  'БД' + '#' +  'Кто провел!анализ' + '#' +  'd!e!f' + '#' +  'Внутренний!№' , "#") .
     2720         v-list-new = v-list-new + string(v-pos) + "," .
     2721      end.
     2722      define variable v-list-str as character no-undo .
     2723      v-list-str = "" .
     2724      repeat v-i = 1 to num-entries(v-list-new) :
     2725         v-elem = entry(v-i , v-list-new ) .
     2726         if int(v-elem) > 1 then
     2727         v-list-str  = v-list-str + v-elem + "," .
     2728      end.
     2729      v-list-new = trim(v-list-str ,",")  +  chr(4)
     2730                 + string(decimal( x-abc-analysis.abc-name:width in browse BROWSE-ABC)) +  chr(4)
     2731                 + string(decimal( x-criterion-analysis.cral-name:width     in browse BROWSE-ABC)) +  chr(4)  .
     2732   run uf-set in this-procedure(
     2733       input  'list-abc-p':U
     2734       ,input v-cntxt-userid
     2735       ,input v-list-new
     2736       ,input v-uf-Naim
     2737       ,input v-uf-print-graft
     2738       ,input v-uf-sort-gr
     2739       ,input v-uf-type-price
     2740       ,input v-uf-type-val
     2741   ) no-error    .
     2742       if error-status :error then
     2743       message
     2744         vss-workfile vss-revision vss-description skip
     2745         error-status :get-message(1) skip
     2746         return-value skip
     2747         "uf-set"
     2748         view-as alert-box error
     2749       .
     2750   END.
     2751   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     2752   DO:
     2753      IF  p-rid-list = "" THEN DO:
     2754         IF AVAILABLE x-abc-analysis THEN p-rid-list = string(RECID(x-abc-analysis)).
     2755     END.
     2756   END.
     2757   ON ROW-DISPLAY OF BROWSE-ABC IN FRAME Dialog-Frame
     2758   DO:
     2759   define variable  p-abc-id   as integer   no-undo .
     2760   define variable  p-db-num   as integer   no-undo .
     2761      IF AVAILABLE x-abc-analysis THEN DO :
     2762         v-def = "" .
     2763             run find-def-analysis-obj in this-procedure
     2764             ( input  "abc"
     2765             ,input  p-curr-obj-type
     2766             ,input  p-curr-obj-code
     2767             ,output p-abc-id
     2768             ,output p-db-num   ) .
     2769          if p-abc-id = x-abc-analysis.abc-id and p-db-num = x-abc-analysis.db-num
     2770             then v-def = "x" .
     2771             else "" .
     2772          IF  x-criterion-analysis.cral-status <> 0 THEN
     2773           ASSIGN
     2774             x-abc-analysis.abc-name:fgcolor in browse BROWSE-ABC = DARK_GRAY_COLOR
     2775             x-criterion-analysis.cral-name:fgcolor in browse BROWSE-ABC = DARK_GRAY_COLOR
     2776           .
     2777          ELSE
     2778           ASSIGN
     2779             x-abc-analysis.abc-name:fgcolor in browse BROWSE-ABC = ?
     2780             x-criterion-analysis.cral-name:fgcolor in browse BROWSE-ABC = ?
     2781           .
     2782       END.
     2783   END.
     2784   ON VALUE-CHANGED OF BROWSE-ABC IN FRAME Dialog-Frame
     2785   DO:
     2786       IF AVAILABLE x-abc-analysis THEN DO :
     2787   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     2789     (input  x-abc-analysis.abc-who-create
     2790     ,output v-user-name
     2791     )  .
     2792           DISPLAY x-abc-analysis.abc-des
     2793                   x-abc-analysis.abc-name
     2794                   x-criterion-analysis.cral-name
     2795                   v-user-name
     2796           WITH FRAME Dialog-Frame.
     2797         OPEN QUERY BROWSE-type-doc FOR EACH x-abc-analysis-doc       WHERE x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and x-abc-analysis-doc.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2798         OPEN QUERY BROWSE-obj FOR EACH x-abc-analysis-obj       WHERE x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and x-abc-analysis-obj.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2799         OPEN QUERY BROWSE-period FOR EACH x-abc-analysis-period       WHERE x-abc-analysis-period.abc-id = x-abc-analysis.abc-id and x-abc-analysis-period.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2800       END.
     2801   END.
     2802   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2803   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2804   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2805   procedure set-filter-name :
     2806   define input parameter p-filter-name as character no-undo .
     2807     do with frame Dialog-Frame:
     2808       if p-filter-name > "" then do:
     2809         assign
     2810           frame Dialog-Frame:title
     2811             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2812         .
     2813       end.
     2814       else do:
     2815       end.
     2816     end.
     2817   end procedure.
     2818   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2819   on help of frame Dialog-Frame
     2820   do:
     2821     run gbl/app_help.p
     2822       (input this-procedure :file-name
     2823       ,input ''
     2824       ,input ?
     2825       ) no-error.
     2826     if error-status :error then do:
     2827       message
     2828         "Ошибка при вызове помощи"
     2829         error-status :get-message(1)
     2830         view-as alert-box .
     2831     end.
     2832   end.
     2833   run minbtn-set in this-procedure .
     2834   on choose of b-help in frame Dialog-Frame
     2835   do:
     2836     apply "help":u to frame Dialog-Frame .
     2837   end.
     2838   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2839   procedure minbtn-set :
     2840       do
     2841           on error undo, return error return-value
     2842           :
     2843           define variable ii              as integer       no-undo .
     2844           define variable fh              as widget-handle no-undo .
     2845           define variable hh              as widget-handle no-undo .
     2846           define variable v-h             as handle        extent 4 no-undo .
     2847           define variable v-name-button   as character     no-undo .
     2848           define variable v-help-old-x    as decimal       no-undo .
     2849           define variable v-help-old-y    as decimal       no-undo .
     2850           define variable v-help-old-size as decimal       no-undo .
     2851           define variable v-frame-width   as decimal       no-undo .
     2852           define variable jj              as integer       no-undo .
     2853           do
     2854               on error undo, return error
     2855               :
     2856               assign
     2857                   v-frame-width = frame Dialog-Frame:width - 0.3
     2858                   fh            = frame Dialog-Frame:first-child
     2859                   hh            = fh:first-child
     2860                   ii            = 1
     2861                   .
     2862               do while valid-handle(hh):
     2863                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2864                   do:
     2865                       case lc(hh:name) :
     2866                           when "b-help" then
     2867                               do:
     2868                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2869                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2870                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2871                                   hh:TOOLTIP = "Помощь" .
     2872                                   v-help-old-x = hh:column .
     2873                                   v-help-old-y = hh:row    .
     2874                                   v-help-old-size = hh:width .
     2875                                   hh:width-chars = 2.5 .
     2876                               end.
     2877                           when "b-print" then
     2878                               do:
     2879                                   hh:load-image("cmp/b-print.bmp":u) .
     2880                                   hh:TOOLTIP = "Печать" .
     2881                                   v-h[ii] = hh:handle .
     2882                                   ii = ii + 1 .
     2883                                   hh:width-chars = 3 .
     2884                               end.
     2885                           when "b-history" or
     2886                           when "b-hist" then
     2887                               do:
     2888                                   hh:load-image("cmp/b-hist.bmp":u) .
     2889                                   hh:TOOLTIP = "История" .
     2890                                   v-h[ii] = hh:handle .
     2891                                   ii = ii + 1 .
     2892                                   hh:width-chars = 3 .
     2893                               end.
     2894                           when "b-sch" then
     2895                               do:
     2896                                   hh:load-image("cmp/b-sch.bmp":u) .
     2897                                   hh:TOOLTIP = "Установка Фильтра" .
     2898                                   v-h[ii] = hh:handle .
     2899                                   ii = ii + 1 .
     2900                                   hh:width-chars = 3 .
     2901                               end.
     2902                           when "b-hist-user" then
     2903                               do:
     2904                                   hh:load-image("cmp/b-hist.bmp":u) .
     2905                                   hh:TOOLTIP = "История пользователя" .
     2906                                   ii = ii + 1 .
     2907                               end.
     2908                       end case.
     2909                   end.
     2910                   hh = hh:next-sibling.
     2911               end.
     2912               b-help:column = v-frame-width - b-help:width-chars.
     2913               jj = 0.
     2914               repeat ii = 4 to 1 by -1 :
     2915                   if valid-handle (v-h[ii] ) then
     2916                   do:
     2917                       jj  = jj + 1 .
     2918                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2919                       v-h[ii]:row    = v-help-old-y .
     2920                   end.
     2921               end.
     2922           end.
     2923       end.
     2924   end procedure.
     2925   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2926   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2927   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2928   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2929   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2930   define variable v-diasize-current-frame-height as decimal   no-undo .
     2931   define variable v-diasize-change-size          as logical   no-undo .
     2932   define variable v-diasize-resize-button        as handle    no-undo .
     2933   define variable v-diasize-wndmax               as logical   no-undo .
     2934   define variable v-diasize-wndstore             as logical   no-undo .
     2935   define variable v-diasize-proc-name            as character no-undo .
     2936   define variable v-diasize-browse-handle        as handle    no-undo .
     2937   define variable v-diasize-browse-number        as integer   no-undo .
     2938   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2939   define temp-table temp-diasize-handle no-undo
     2940     field handle-value  as handle
     2941     field save-position as decimal
     2942     index xpk is primary unique handle-value
     2943     .
     2944   define temp-table temp-browse-handle no-undo
     2945     field browse-type   as character
     2946     field browse-number as integer
     2947     field browse-handle as handle
     2948     field original-size as decimal
     2949     index xpk is primary unique browse-type browse-number
     2950     index xie browse-type browse-handle
     2951   .
     2952   procedure diasize_change-height :
     2953     define input  parameter p-change-value  as decimal   no-undo .
     2954     define input  parameter p-move-resize   as logical   no-undo .
     2955     define variable v-field-group-handle    as handle    no-undo .
     2956     define variable v-object-handle         as handle    no-undo .
     2957     define variable v-frame-height          as decimal   no-undo .
     2958     define variable v-frame-virtual-height  as decimal   no-undo .
     2959     define variable v-browse-height         as decimal   no-undo .
     2960     define variable v-window-height         as decimal   no-undo .
     2961     define variable v-window-virtual-height as decimal   no-undo .
     2962     define variable v-change-sign           as integer   no-undo .
     2963     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2964     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2965     if p-change-value > 0
     2966     then do:
     2967       if frame Dialog-Frame :height + p-change-value
     2968           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2969       then do:
     2970         assign
     2971           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2972                           - (frame Dialog-Frame :height-chars)
     2973         .
     2974         if p-change-value <= 0
     2975         then do:
     2976           run diasize_position-resize-button in this-procedure .
     2977           return .
     2978         end.
     2979       end.
     2980     end.
     2981     if p-change-value < 0
     2982     then do:
     2983       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2984       then do:
     2985         assign
     2986           p-change-value = v-diasize-orig-frame-height
     2987                          - (frame Dialog-Frame :height-chars)
     2988         .
     2989         if p-change-value >= 0
     2990         then do:
     2991           run diasize_position-resize-button in this-procedure .
     2992           return .
     2993         end.
     2994       end.
     2995     end.
     2996     if p-change-value >= 0
     2997     then do:
     2998       assign
     2999         v-change-sign = 1
     3000       .
     3001     end.
     3002     else do:
     3003       assign
     3004         v-change-sign = -1
     3005       .
     3006     end.
     3007     assign
     3008       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3009     .
     3010     if p-change-value = 0
     3011     then do:
     3012       run diasize_position-resize-button in this-procedure .
     3013       return .
     3014     end.
     3015     move_block:
     3016     do
     3017     on error undo move_block, retry move_block
     3018     :
     3019       if retry
     3020       then do:
     3021         do
     3022         on error undo move_block, leave move_block
     3023         :
     3024           if p-change-value > 0
     3025           then do:
     3026             for each buf_temp-diasize-handle
     3027             on error undo, next
     3028             :
     3029               assign
     3030                 v-object-handle = buf_temp-diasize-handle.handle-value
     3031               .
     3032               if v-object-handle <> v-diasize-resize-button
     3033               then do:
     3034                 assign
     3035                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3036                 .
     3037               end.
     3038             end.
     3039             assign
     3040               v-diasize-browse-handle :height = v-browse-height
     3041             .
     3042             for each buf_temp-browse-handle
     3043               where buf_temp-browse-handle.browse-type = 'height':u
     3044             on error undo, next
     3045             :
     3046               assign
     3047                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3048               .
     3049             end.
     3050             assign
     3051               frame Dialog-Frame :height = v-frame-height
     3052             .
     3053             if frame Dialog-Frame :scrollable = true
     3054             then do:
     3055               assign
     3056                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3057               .
     3058             end.
     3059             run diasize_position-resize-button in this-procedure .
     3060           end.
     3061           else do:
     3062             if frame Dialog-Frame :scrollable = true
     3063             then do:
     3064               assign
     3065                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3066               .
     3067             end.
     3068             assign
     3069               frame Dialog-Frame :height = v-frame-height
     3070             .
     3071             assign
     3072               v-diasize-browse-handle :height = v-browse-height
     3073             .
     3074             for each buf_temp-browse-handle
     3075               where buf_temp-browse-handle.browse-type = 'height':u
     3076             on error undo, next
     3077             :
     3078               assign
     3079                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3080               .
     3081             end.
     3082             for each buf_temp-diasize-handle
     3083             on error undo, next
     3084             :
     3085               assign
     3086                 v-object-handle = buf_temp-diasize-handle.handle-value
     3087               .
     3088               if v-object-handle <> v-diasize-resize-button
     3089               then do:
     3090                 assign
     3091                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3092                 .
     3093               end.
     3094             end.
     3095             run diasize_position-resize-button in this-procedure .
     3096           end.
     3097           assign
     3098             v-diasize-change-size = false
     3099           .
     3100           leave move_block .
     3101         end.
     3102       end.
     3103       assign
     3104         v-diasize-need-full-display = true
     3105       .
     3106       if v-diasize-change-size = false
     3107       then do:
     3108         assign
     3109           v-diasize-change-size = true
     3110         .
     3111       end.
     3112       else do:
     3113         return .
     3114       end.
     3115       assign
     3116         v-frame-height = frame Dialog-Frame :height
     3117         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3118         v-browse-height = v-diasize-browse-handle :height
     3119       .
     3120       for each buf_temp-browse-handle
     3121         where buf_temp-browse-handle.browse-type = 'height':u
     3122       :
     3123         assign
     3124           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3125         .
     3126       end.
     3127       for each buf_temp-diasize-handle
     3128       :
     3129         delete buf_temp-diasize-handle .
     3130       end.
     3131       assign
     3132         v-field-group-handle = frame Dialog-Frame :first-child
     3133       .
     3134       do while valid-handle(v-field-group-handle)
     3135       :
     3136         assign
     3137           v-object-handle = v-field-group-handle :first-child
     3138         .
     3139         do while valid-handle(v-object-handle)
     3140         :
     3141           if  v-object-handle <> v-diasize-browse-handle :handle
     3142           and can-query(v-object-handle, "row")
     3143           and can-query(v-object-handle, "height")
     3144           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3145           then do:
     3146             find first buf_temp-browse-handle
     3147               where buf_temp-browse-handle.browse-type   = 'height':u
     3148                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3149               no-error .
     3150             if available buf_temp-browse-handle
     3151             then do:
     3152             end.
     3153             else do:
     3154               create buf_temp-diasize-handle .
     3155               assign
     3156                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3157                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3158               .
     3159             end.
     3160           end.
     3161           assign
     3162             v-object-handle = v-object-handle :next-sibling
     3163           .
     3164         end.
     3165         assign
     3166           v-field-group-handle = v-field-group-handle :next-sibling
     3167         .
     3168       end.
     3169       do with frame Dialog-Frame
     3170       :
     3171         hide v-diasize-resize-button .
     3172         assign
     3173           v-diasize-resize-button :row    = 1
     3174           v-diasize-resize-button :column = 1
     3175         .
     3176       end.
     3177       if p-change-value > 0
     3178       then do:
     3179         if frame Dialog-Frame :scrollable = true
     3180         then do:
     3181           assign
     3182             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3183             no-error .
     3184           if error-status :error
     3185           or error-status :get-message(1) <> ""
     3186           then do:
     3187             undo move_block, retry move_block .
     3188           end.
     3189         end.
     3190         assign
     3191           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3192           no-error .
     3193         if error-status :error
     3194         or error-status :get-message(1) <> ""
     3195         then do:
     3196           undo move_block, retry move_block .
     3197         end.
     3198         assign
     3199           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3200           no-error .
     3201         if error-status :error
     3202         or error-status :get-message(1) <> ""
     3203         then do:
     3204           undo move_block, retry move_block .
     3205         end.
     3206         for each buf_temp-browse-handle
     3207           where buf_temp-browse-handle.browse-type = 'height':u
     3208         on error undo move_block, retry move_block
     3209         :
     3210           assign
     3211             buf_temp-browse-handle.browse-handle :height
     3212               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3213             no-error .
     3214           if error-status :error
     3215           or error-status :get-message(1) <> ""
     3216           then do:
     3217             undo move_block, retry move_block .
     3218           end.
     3219         end.
     3220         for each buf_temp-diasize-handle
     3221         on error undo move_block, retry move_block
     3222         :
     3223           assign
     3224             v-object-handle = buf_temp-diasize-handle.handle-value
     3225           .
     3226           if v-object-handle <> v-diasize-resize-button
     3227           then do:
     3228             assign
     3229               v-object-handle :row = v-object-handle :row + p-change-value
     3230               no-error .
     3231             if error-status :error
     3232             or error-status :get-message(1) <> ""
     3233             then do:
     3234               undo move_block, retry move_block .
     3235             end.
     3236           end.
     3237         end.
     3238       end.
     3239       else do:
     3240         for each buf_temp-diasize-handle
     3241         on error undo move_block, retry move_block
     3242         :
     3243           assign
     3244             v-object-handle = buf_temp-diasize-handle.handle-value
     3245           .
     3246           if v-object-handle <> v-diasize-resize-button
     3247           then do:
     3248             assign
     3249               v-object-handle :row = v-object-handle :row + p-change-value
     3250               no-error .
     3251             if error-status :error
     3252             or error-status :get-message(1) <> ""
     3253             then do:
     3254               undo move_block, retry move_block .
     3255             end.
     3256           end.
     3257         end.
     3258         assign
     3259           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3260           no-error .
     3261         if error-status :error
     3262         or error-status :get-message(1) <> ""
     3263         then do:
     3264           undo move_block, retry move_block .
     3265         end.
     3266         for each buf_temp-browse-handle
     3267           where buf_temp-browse-handle.browse-type = 'height':u
     3268         on error undo move_block, retry move_block
     3269         :
     3270           assign
     3271             buf_temp-browse-handle.browse-handle :height
     3272               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3273             no-error .
     3274           if error-status :error
     3275           or error-status :get-message(1) <> ""
     3276           then do:
     3277             undo move_block, retry move_block .
     3278           end.
     3279         end.
     3280         assign
     3281           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3282           no-error .
     3283         if error-status :error
     3284         or error-status :get-message(1) <> ""
     3285         then do:
     3286           undo move_block, retry move_block .
     3287         end.
     3288         if frame Dialog-Frame :scrollable = true
     3289         then do:
     3290           assign
     3291             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3292             no-error .
     3293           if error-status :error
     3294           or error-status :get-message(1) <> ""
     3295           then do:
     3296             undo move_block, retry move_block .
     3297           end.
     3298         end.
     3299       end.
     3300       if p-move-resize = true
     3301       then do:
     3302         run diasize_position-resize-button in this-procedure .
     3303       end.
     3304       if v-diasize-wndstore = true
     3305       then do:
     3306         if connected("ub") = true
     3307         then do:
     3308           define variable v-cntxt-db-num        as integer   no-undo .
     3309           define variable v-cntxt-userid        as character no-undo .
     3310           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3311                                             , OUTPUT v-cntxt-userid
     3312                                             ) .
     3313           run gbl/wndsizew.p
     3314             (input  v-cntxt-db-num
     3315             ,input  v-cntxt-userid
     3316             ,input  v-diasize-proc-name
     3317             ,input  'height':u
     3318             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3319             ) .
     3320         end.
     3321       end.
     3322     end.
     3323     assign
     3324       v-diasize-change-size = false
     3325     .
     3326   end procedure.
     3327   procedure diasize_set-height :
     3328     define input  parameter p-new-height  as decimal   no-undo .
     3329     define input  parameter p-move-resize as logical   no-undo .
     3330     do
     3331     on error undo, return error return-value
     3332     :
     3333       run diasize_change-height in this-procedure
     3334         (input  (p-new-height - frame Dialog-Frame :height)
     3335         ,input  p-move-resize
     3336         ) .
     3337     end.
     3338   end procedure.
     3339   procedure diasize_change-width :
     3340     define input  parameter p-change-value as decimal   no-undo .
     3341     define input  parameter p-move-resize  as logical   no-undo .
     3342     define variable v-field-group-handle   as handle    no-undo .
     3343     define variable v-object-handle        as handle    no-undo .
     3344     define variable v-frame-width          as decimal   no-undo .
     3345     define variable v-frame-virtual-width  as decimal   no-undo .
     3346     define variable v-browse-width         as decimal   no-undo .
     3347     define variable v-window-width         as decimal   no-undo .
     3348     define variable v-window-virtual-width as decimal   no-undo .
     3349     define variable v-change-sign          as integer   no-undo .
     3350     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3351     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3352     if p-change-value > 0
     3353     then do:
     3354       if frame Dialog-Frame :width + p-change-value >
     3355           session :width-chars
     3356       then do:
     3357         assign
     3358           p-change-value = session :width-chars - frame Dialog-Frame :width
     3359         .
     3360         if p-change-value <= 0
     3361         then do:
     3362           run diasize_position-resize-button in this-procedure .
     3363           return .
     3364         end.
     3365       end.
     3366     end.
     3367     if p-change-value < 0
     3368     then do:
     3369       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3370       then do:
     3371         assign
     3372           p-change-value = v-diasize-orig-frame-width
     3373                          - frame Dialog-Frame :width
     3374         .
     3375         if p-change-value >= 0
     3376         then do:
     3377           run diasize_position-resize-button in this-procedure .
     3378           return .
     3379         end.
     3380       end.
     3381     end.
     3382     if p-change-value >= 0
     3383     then do:
     3384       assign
     3385         v-change-sign = 1
     3386       .
     3387     end.
     3388     else do:
     3389       assign
     3390         v-change-sign = -1
     3391       .
     3392     end.
     3393     assign
     3394       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3395     .
     3396     if p-change-value = 0
     3397     then do:
     3398       run diasize_position-resize-button in this-procedure .
     3399       return .
     3400     end.
     3401     move_block:
     3402     do
     3403     on error undo move_block, leave move_block
     3404     :
     3405       if retry
     3406       then do:
     3407         do
     3408         on error undo move_block, leave move_block
     3409         :
     3410           if p-change-value > 0
     3411           then do:
     3412             for each buf_temp-diasize-handle
     3413             on error undo, next
     3414             :
     3415               assign
     3416                 v-object-handle = buf_temp-diasize-handle.handle-value
     3417               .
     3418               if v-object-handle <> v-diasize-resize-button
     3419               then do:
     3420                 assign
     3421                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3422                 .
     3423               end.
     3424             end.
     3425             assign
     3426               v-diasize-browse-handle :width = v-browse-width
     3427             .
     3428             for each buf_temp-browse-handle
     3429               where buf_temp-browse-handle.browse-type = 'width':u
     3430             on error undo, next
     3431             :
     3432               assign
     3433                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3434               .
     3435             end.
     3436             assign
     3437               frame Dialog-Frame :width = v-frame-width
     3438             .
     3439             if frame Dialog-Frame :scrollable = true
     3440             then do:
     3441               assign
     3442                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3443               .
     3444             end.
     3445             run diasize_position-resize-button in this-procedure .
     3446           end.
     3447           else do:
     3448             if frame Dialog-Frame :scrollable = true
     3449             then do:
     3450               assign
     3451                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3452               .
     3453             end.
     3454             assign
     3455               frame Dialog-Frame :width = v-frame-width
     3456             .
     3457             for each buf_temp-browse-handle
     3458               where buf_temp-browse-handle.browse-type = 'width':u
     3459             on error undo, next
     3460             :
     3461               assign
     3462                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3463               .
     3464             end.
     3465             assign
     3466               v-diasize-browse-handle :width = v-browse-width
     3467             .
     3468             for each buf_temp-diasize-handle
     3469             on error undo, next
     3470             :
     3471               assign
     3472                 v-object-handle = buf_temp-diasize-handle.handle-value
     3473               .
     3474               if v-object-handle <> v-diasize-resize-button
     3475               then do:
     3476                 assign
     3477                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3478                 .
     3479               end.
     3480             end.
     3481             run diasize_position-resize-button in this-procedure .
     3482           end.
     3483           assign
     3484             v-diasize-change-size = false
     3485           .
     3486           leave move_block .
     3487         end.
     3488       end.
     3489       assign
     3490         v-diasize-need-full-display = true
     3491       .
     3492       if v-diasize-change-size = false
     3493       then do:
     3494         assign
     3495           v-diasize-change-size = true
     3496         .
     3497       end.
     3498       else do:
     3499         return .
     3500       end.
     3501       assign
     3502         v-frame-width = frame Dialog-Frame :width
     3503         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3504         v-browse-width = v-diasize-browse-handle :width
     3505       .
     3506       for each buf_temp-browse-handle
     3507         where buf_temp-browse-handle.browse-type = 'width':u
     3508       :
     3509         assign
     3510           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3511         .
     3512       end.
     3513       for each buf_temp-diasize-handle
     3514       :
     3515         delete buf_temp-diasize-handle .
     3516       end.
     3517       assign
     3518         v-field-group-handle = frame Dialog-Frame :first-child
     3519       .
     3520       do while valid-handle(v-field-group-handle)
     3521       :
     3522         assign
     3523           v-object-handle = v-field-group-handle :first-child
     3524         .
     3525         do while valid-handle(v-object-handle)
     3526         :
     3527           if  v-object-handle <> v-diasize-browse-handle :handle
     3528           and v-object-handle <> v-diasize-resize-button
     3529           and can-query(v-object-handle, "row")
     3530           and can-query(v-object-handle, "height")
     3531           and ( v-object-handle :col + v-object-handle :width
     3532                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3533               )
     3534           then do:
     3535             find first buf_temp-browse-handle
     3536               where buf_temp-browse-handle.browse-type   = 'width':u
     3537                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3538               no-error .
     3539             if available buf_temp-browse-handle
     3540             then do:
     3541             end.
     3542             else do:
     3543               create buf_temp-diasize-handle .
     3544               assign
     3545                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3546                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3547               .
     3548             end.
     3549           end.
     3550           assign
     3551             v-object-handle = v-object-handle :next-sibling
     3552           .
     3553         end.
     3554         assign
     3555           v-field-group-handle = v-field-group-handle :next-sibling
     3556         .
     3557       end.
     3558       do with frame Dialog-Frame
     3559       :
     3560         hide v-diasize-resize-button .
     3561         v-diasize-resize-button :row = 1.
     3562         v-diasize-resize-button :column = 1.
     3563       end.
     3564       if p-change-value > 0
     3565       then do:
     3566         if frame Dialog-Frame :scrollable = true
     3567         then do:
     3568           assign
     3569             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3570             no-error .
     3571           if error-status :error
     3572           or error-status :get-message(1) <> ""
     3573           then do:
     3574             undo move_block, retry move_block.
     3575           end.
     3576         end.
     3577         assign
     3578           frame Dialog-Frame :width = v-frame-width + p-change-value
     3579           no-error .
     3580         if error-status :error
     3581         or error-status :get-message(1) <> ""
     3582         then do:
     3583           undo move_block, retry move_block.
     3584         end.
     3585         assign
     3586           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3587         no-error .
     3588         if error-status :error
     3589         or error-status :get-message(1) <> ""
     3590         then do:
     3591           undo move_block, retry move_block.
     3592         end.
     3593         for each buf_temp-browse-handle
     3594           where buf_temp-browse-handle.browse-type = 'width':u
     3595         on error undo move_block, retry move_block
     3596         :
     3597           assign
     3598             buf_temp-browse-handle.browse-handle :width
     3599               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3600             no-error .
     3601           if error-status :error
     3602           or error-status :get-message(1) <> ""
     3603           then do:
     3604             undo move_block, retry move_block .
     3605           end.
     3606         end.
     3607         for each buf_temp-diasize-handle
     3608         on error undo move_block, retry move_block
     3609         :
     3610           assign
     3611             v-object-handle = buf_temp-diasize-handle.handle-value
     3612           .
     3613           if v-object-handle <> v-diasize-resize-button
     3614           then do:
     3615             assign
     3616               v-object-handle :col = v-object-handle :col + p-change-value
     3617               no-error .
     3618             if error-status :error
     3619             or error-status :get-message(1) <> ""
     3620             then do:
     3621               undo move_block, retry move_block .
     3622             end.
     3623           end.
     3624         end.
     3625       end.
     3626       else do:
     3627         for each buf_temp-diasize-handle
     3628         on error undo move_block, retry move_block
     3629         :
     3630           assign
     3631             v-object-handle = buf_temp-diasize-handle.handle-value
     3632           .
     3633           if v-object-handle <> v-diasize-resize-button
     3634           then do:
     3635             assign
     3636               v-object-handle :col = v-object-handle :col + p-change-value
     3637               no-error .
     3638             if error-status :error
     3639             or error-status :get-message(1) <> ""
     3640             then do:
     3641               undo move_block, retry move_block .
     3642             end.
     3643           end.
     3644         end.
     3645         for each buf_temp-browse-handle
     3646           where buf_temp-browse-handle.browse-type = 'width':u
     3647         on error undo move_block, retry move_block
     3648         :
     3649           assign
     3650             buf_temp-browse-handle.browse-handle :width
     3651               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3652             no-error .
     3653           if error-status :error
     3654           or error-status :get-message(1) <> ""
     3655           then do:
     3656             undo move_block, retry move_block .
     3657           end.
     3658         end.
     3659         assign
     3660           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3661           no-error .
     3662         if error-status :error
     3663         or error-status :get-message(1) <> ""
     3664         then do:
     3665           undo move_block, retry move_block.
     3666         end.
     3667         assign
     3668           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3669         no-error .
     3670         if error-status :error
     3671         or error-status :get-message(1) <> ""
     3672         then do:
     3673           undo move_block, retry move_block.
     3674         end.
     3675         if frame Dialog-Frame :scrollable = true
     3676         then do:
     3677           assign
     3678             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3679           no-error .
     3680           if error-status :error
     3681           or error-status :get-message(1) <> ""
     3682           then do:
     3683             undo move_block, retry move_block.
     3684           end.
     3685         end.
     3686       end.
     3687       if p-move-resize
     3688       then do:
     3689         run diasize_position-resize-button in this-procedure .
     3690       end.
     3691       if v-diasize-wndstore = true
     3692       then do:
     3693         if connected("ub") = true
     3694         then do:
     3695           define variable v-cntxt-db-num        as integer   no-undo .
     3696           define variable v-cntxt-userid        as character no-undo .
     3697           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3698                                             , OUTPUT v-cntxt-userid
     3699                                             ) .
     3700           run gbl/wndsizew.p
     3701             (input  v-cntxt-db-num
     3702             ,input  v-cntxt-userid
     3703             ,input  v-diasize-proc-name
     3704             ,input  'width':u
     3705             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3706             ) .
     3707         end.
     3708       end.
     3709     end.
     3710     assign
     3711       v-diasize-change-size = false
     3712     .
     3713   end procedure.
     3714   procedure diasize_set-width :
     3715     define input  parameter p-new-width  as decimal   no-undo .
     3716     define input  parameter p-move-resize as logical   no-undo .
     3717     do
     3718     on error undo, return error return-value
     3719     :
     3720       run diasize_change-width in this-procedure
     3721         (input  (p-new-width - frame Dialog-Frame :width)
     3722         ,input  p-move-resize
     3723         ) .
     3724     end.
     3725   end procedure.
     3726   procedure diasize_position-resize-button :
     3727     do with frame Dialog-Frame
     3728     :
     3729       hide v-diasize-resize-button .
     3730       assign
     3731         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3732                     - 1
     3733                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3734         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3735                     - 1
     3736                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3737       .
     3738       view v-diasize-resize-button .
     3739     end.
     3740   end procedure.
     3741   on alt-right anywhere
     3742   do:
     3743     run diasize_change-width in this-procedure
     3744       (input 1
     3745       ,input true
     3746       ) .
     3747     return no-apply .
     3748   end.
     3749   on alt-left anywhere
     3750   do:
     3751     run diasize_change-width in this-procedure
     3752       (input -1
     3753       ,input true
     3754       ) .
     3755     return no-apply .
     3756   end.
     3757   on alt-down anywhere
     3758   do:
     3759     run diasize_change-height in this-procedure
     3760       (input 1
     3761       ,input true
     3762       ) .
     3763     return no-apply .
     3764   end.
     3765   on alt-up anywhere
     3766   do:
     3767     run diasize_change-height in this-procedure
     3768       (input -1
     3769       ,input true
     3770       ) .
     3771     return no-apply .
     3772   end.
     3773   on alt-enter of frame Dialog-Frame
     3774   do:
     3775     run diasize_maximize in this-procedure
     3776       (input  ?
     3777       ).
     3778     return no-apply .
     3779   end.
     3780   procedure diasize_end-move :
     3781     do
     3782     on error undo, return error return-value
     3783     :
     3784       define variable v-row-delta as decimal   no-undo .
     3785       define variable v-col-delta as decimal   no-undo .
     3786       define variable v-new-row as decimal   no-undo .
     3787       define variable v-new-col as decimal   no-undo .
     3788       assign
     3789         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3790         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3791       .
     3792       assign
     3793         v-row-delta = v-new-row - frame Dialog-Frame :height
     3794         v-col-delta = v-new-col - frame Dialog-Frame :width
     3795       .
     3796       run diasize_change-height in this-procedure
     3797         (input v-row-delta
     3798         ,input true
     3799         ) .
     3800       run diasize_change-width in this-procedure
     3801         (input v-col-delta
     3802         ,input true
     3803         ) .
     3804     end.
     3805   end procedure.
     3806   procedure diasize_maximize :
     3807     define input  parameter p-action as logical   no-undo .
     3808     do
     3809     on error undo, return error return-value
     3810     :
     3811       if p-action = ?
     3812       then do:
     3813         if v-diasize-need-maximize = true
     3814         then do:
     3815           assign
     3816             p-action = true
     3817           .
     3818         end.
     3819         else do:
     3820           assign
     3821             p-action = false
     3822           .
     3823         end.
     3824       end.
     3825       if p-action = true
     3826       then do:
     3827         run diasize_change-height in this-procedure
     3828           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3829               - frame Dialog-Frame :height-chars
     3830           ,input true
     3831           ) .
     3832         run diasize_change-width in this-procedure
     3833           (input session :width-chars
     3834               - frame Dialog-Frame :width-chars
     3835           ,input true
     3836           ) .
     3837         assign
     3838           v-diasize-need-maximize = false
     3839         .
     3840       end.
     3841       else do:
     3842         run diasize_change-width in this-procedure
     3843           (input v-diasize-orig-frame-width
     3844               - frame Dialog-Frame :width-chars
     3845           ,input true
     3846           ) .
     3847         run diasize_change-height in this-procedure
     3848           (input v-diasize-orig-frame-height
     3849               - frame Dialog-Frame :height-chars
     3850           ,input true
     3851           ) .
     3852         assign
     3853           v-diasize-need-maximize = true
     3854         .
     3855       end.
     3856     end.
     3857   end procedure.
     3858   procedure diasize_restore-orig-size :
     3859     do
     3860     on error undo, return error return-value
     3861     :
     3862       assign
     3863         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3864         v-diasize-current-frame-height = frame Dialog-Frame :height
     3865       .
     3866       run diasize_set-height in this-procedure
     3867         (input  v-diasize-orig-frame-height
     3868         ,input  true
     3869         ) .
     3870       run diasize_set-width in this-procedure
     3871         (input  v-diasize-orig-frame-width
     3872         ,input  true
     3873         ) .
     3874     end.
     3875   end procedure.
     3876   procedure diasize_restore-current-size :
     3877     do
     3878     on error undo, return error return-value
     3879     :
     3880       run diasize_set-height in this-procedure
     3881         (input  v-diasize-current-frame-height
     3882         ,input  true
     3883         ) .
     3884       run diasize_set-width in this-procedure
     3885         (input  v-diasize-current-frame-width
     3886         ,input  true
     3887         ) .
     3888     end.
     3889   end procedure.
     3890   procedure diasize_set-browse-handle :
     3891     define input  parameter p-browse-handle as handle   no-undo .
     3892     define buffer buf_temp-browse-handle for temp-browse-handle .
     3893     do
     3894     on error undo, return error return-value
     3895     :
     3896       assign
     3897         v-diasize-browse-handle = p-browse-handle
     3898       .
     3899       for each buf_temp-browse-handle
     3900       on error undo, return error return-value
     3901       :
     3902         delete buf_temp-browse-handle .
     3903       end.
     3904     end.
     3905   end procedure.
     3906   procedure diasize_add_browse :
     3907     define input  parameter p-browse-type   as character no-undo .
     3908     define input  parameter p-browse-handle as handle    no-undo .
     3909     define buffer buf_temp-browse-handle for temp-browse-handle .
     3910     do
     3911     on error undo, return error return-value
     3912     :
     3913       assign
     3914         v-diasize-browse-number = v-diasize-browse-number + 1
     3915       .
     3916       create buf_temp-browse-handle .
     3917       assign
     3918         buf_temp-browse-handle.browse-type   = p-browse-type
     3919         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3920         buf_temp-browse-handle.browse-handle = p-browse-handle
     3921       .
     3922     end.
     3923   end procedure.
     3924   procedure diasize_init :
     3925     define variable v-default-value    as logical   no-undo .
     3926     define variable v-restore-saved    as logical   no-undo .
     3927     define variable v-resize-value-str as character no-undo .
     3928     do
     3929     on error undo, return error return-value
     3930     :
     3931       do with frame Dialog-Frame
     3932       :
     3933         assign
     3934           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3935           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3936           v-diasize-browse-handle     = browse BROWSE-ABC :handle
     3937         .
     3938         create button v-diasize-resize-button
     3939         assign
     3940           parent        = frame Dialog-Frame :first-child
     3941           label         = "s"
     3942           height-pixels = 16
     3943           width-pixels  = 16
     3944           visible       = true
     3945           sensitive     = true
     3946           movable       = true
     3947           triggers:
     3948             on end-move persistent run diasize_end-move in this-procedure .
     3949           end triggers.
     3950         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3951         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3952         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3953         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3954         assign
     3955           v-diasize-wndmax = false
     3956         .
     3957         if connected("ub") = true
     3958         then do:
     3959           define variable v-cntxt-db-num        as integer   no-undo .
     3960           define variable v-cntxt-userid        as character no-undo .
     3961           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3962                                             , OUTPUT v-cntxt-userid
     3963                                             ) .
     3964           run gbl/wndpar_r.p
     3965             (input  v-cntxt-db-num
     3966             ,input  v-cntxt-userid
     3967             ,input  'wndmax':U
     3968             ,output v-diasize-wndmax
     3969             ,output v-default-value
     3970             ) .
     3971         end.
     3972         assign
     3973           v-diasize-wndstore = false
     3974         .
     3975         if connected("ub") = true
     3976         then do:
     3977           run gbl/wndpar_r.p
     3978             (input  v-cntxt-db-num
     3979             ,input  v-cntxt-userid
     3980             ,input  'wndstore':U
     3981             ,output v-diasize-wndstore
     3982             ,output v-default-value
     3983             ) .
     3984         end.
     3985         assign
     3986           v-diasize-proc-name = entry(1, program-name(2), '.')
     3987         .
     3988         if v-diasize-wndstore = true
     3989         then do:
     3990           assign
     3991             v-restore-saved = false
     3992           .
     3993           if connected("ub") = true
     3994           then do:
     3995             run gbl/wndsizer.p
     3996               (input  v-cntxt-db-num
     3997               ,input  v-cntxt-userid
     3998               ,input  v-diasize-proc-name
     3999               ,input  'height':u
     4000               ,output v-resize-value-str
     4001               ) .
     4002             if v-resize-value-str <> '':U
     4003             then do:
     4004               run diasize_change-height in this-procedure
     4005                 (input  integer(v-resize-value-str)
     4006                 ,input  true
     4007                 ) .
     4008               assign
     4009                 v-restore-saved = true
     4010               .
     4011             end.
     4012           end.
     4013           if connected("ub") = true
     4014           then do:
     4015             run gbl/wndsizer.p
     4016               (input  v-cntxt-db-num
     4017               ,input  v-cntxt-userid
     4018               ,input  v-diasize-proc-name
     4019               ,input  'width':u
     4020               ,output v-resize-value-str
     4021               ) .
     4022             if v-resize-value-str <> '':U
     4023             then do:
     4024               run diasize_change-width in this-procedure
     4025                 (input  integer(v-resize-value-str)
     4026                 ,input  true
     4027                 ) .
     4028               assign
     4029                 v-restore-saved = true
     4030               .
     4031             end.
     4032           end.
     4033           if v-restore-saved <> true
     4034           then do:
     4035             if v-diasize-wndmax = true
     4036             then do:
     4037               run diasize_maximize in this-procedure
     4038                 (input  true
     4039                 ) .
     4040             end.
     4041           end.
     4042         end.
     4043         else do:
     4044           if v-diasize-wndmax = true
     4045           then do:
     4046             run diasize_maximize in this-procedure
     4047               (input  true
     4048               ) .
     4049           end.
     4050         end.
     4051       end.
     4052     end.
     4053   end procedure.
     4054   procedure diasize_need-full-display :
     4055     define output parameter p-need-full-display as logical   no-undo .
     4056     do
     4057     on error undo, return error return-value
     4058     :
     4059       assign
     4060         p-need-full-display = v-diasize-need-full-display
     4061       .
     4062       assign
     4063         v-diasize-need-full-display = false
     4064       .
     4065     end.
     4066   end procedure.
     4067   procedure get-context :
     4068      define output parameter p-db-num as integer          no-undo.
     4069      define output parameter p-user-id as character        no-undo.
     4070      define variable v-login               as character    no-undo.
     4071      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4072      define buffer buf_user-login  for ub.user-login .
     4073      do
     4074      on error undo, return error
     4075      :
     4076            FIND FIRST buf_sys-ctrl no-lock.
     4077            ASSIGN
     4078               v-login = USERID("ub")
     4079               p-db-num = buf_sys-ctrl.db-num
     4080            .
     4081            FIND FIRST buf_user-login
     4082                 WHERE buf_user-login.db-num = p-db-num
     4083                   AND buf_user-login.user-login = v-login
     4084                 no-lock
     4085                 no-error
     4086                 .
     4087            IF AVAILABLE buf_user-login
     4088            THEN DO:
     4089               assign
     4090                  p-user-id = buf_user-login.user-id
     4091               .
     4092            END.
     4093      end.
     4094   end procedure.
     4095       run diasize_init in this-procedure .
     4096   def var sort-labelBROWSE-ABC   as character no-undo .
     4097   def var sort-clmnBROWSE-ABC    as handle    no-undo .
     4098   def var cur-clmnBROWSE-ABC     as handle    no-undo .
     4099   def var cur-clmn-locBROWSE-ABC as integer   no-undo .
     4100   def var re-queryBROWSE-ABC     as logical   initial no no-undo .
     4101   on start-search, ctrl-o of BROWSE-ABC in frame Dialog-Frame do:
     4102      run sort-brBROWSE-ABC
     4103        (input (if available x-abc-analysis
     4104                then recid(x-abc-analysis)
     4105                else ?
     4106               )
     4107        ).
     4108   end.
     4109   PROCEDURE sort-brBROWSE-ABC :
     4110     define input parameter p-recid as recid no-undo .
     4111     if re-queryBROWSE-ABC = no then do:
     4112       assign
     4113          cur-clmnBROWSE-ABC = BROWSE-ABC:current-column in frame Dialog-Frame
     4114       .
     4115       if sort-clmnBROWSE-ABC <> ? then sort-clmnBROWSE-ABC:column-fgcolor = 0.
     4116       if cur-clmnBROWSE-ABC = sort-clmnBROWSE-ABC then do:
     4117         assign
     4118            sort-labelBROWSE-ABC = ""
     4119            sort-clmnBROWSE-ABC = ?
     4120         .
     4121        end.
     4122        else do:
     4123          assign
     4124            sort-labelBROWSE-ABC = cur-clmnBROWSE-ABC:label
     4125            sort-clmnBROWSE-ABC  = cur-clmnBROWSE-ABC
     4126            sort-clmnBROWSE-ABC:column-fgcolor = 4
     4127          .
     4128        end.
     4129      end.
     4130     assign
     4131       cur-clmn-locBROWSE-ABC = 1
     4132     .
     4133     def var column-handle as handle no-undo .
     4134     column-handle = BROWSE-ABC:first-column.
     4135     do while valid-handle(column-handle) :
     4136       if column-handle = cur-clmnBROWSE-ABC then do:
     4137         leave .
     4138       end.
     4139       column-handle = column-handle:NEXT-COLUMN.
     4140       assign
     4141         cur-clmn-locBROWSE-ABC = cur-clmn-locBROWSE-ABC + 1
     4142       .
     4143     end.
     4144     case sort-labelBROWSE-ABC:
     4145           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(x-abc-analysis), &1&2&1)', chr(34), p-rid-list)     .     run OpenBr.   . END.
     4146           when 'Наименование'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-name"     .     run OpenBr.   . END.
     4147           when 'Критерий!анализа'  then DO:    assign       sort-column-name = "x-criterion-analysis.cral-name"     .     run OpenBr.   . END.
     4148           when 'A%'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-a"     .     run OpenBr.   . END.
     4149           when 'B%'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-b - x-abc-analysis.abc-a"     .     run OpenBr.   . END.
     4150           when 'C%'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-c - x-abc-analysis.abc-b"     .     run OpenBr.   . END.
     4151           when 'D%'  then DO:    assign       sort-column-name = "if ( x-abc-analysis.abc-d - x-abc-analysis.abc-c ) < 0 then 0 else x-abc-analysis.abc-d - x-abc-analysis.abc-c"     .     run OpenBr.   . END.
     4152           when 'E%'  then DO:    assign       sort-column-name = "if ( x-abc-analysis.abc-e - x-abc-analysis.abc-d ) < 0 then 0 else x-abc-analysis.abc-e - x-abc-analysis.abc-d"     .     run OpenBr.   . END.
     4153           when 'F%'  then DO:    assign       sort-column-name = "if ( x-abc-analysis.abc-f - x-abc-analysis.abc-e ) < 0 then 0 else x-abc-analysis.abc-f - x-abc-analysis.abc-e"     .     run OpenBr.   . END.
     4154           when 'Строка!объектов'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-string-obj"     .     run OpenBr.   . END.
     4155           when 'Строка!периодов'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-string-period"     .     run OpenBr.   . END.
     4156           when 'Строка!документов'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-string-doc"     .     run OpenBr.   . END.
     4157           when 'Дата!создания'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-date-create"     .     run OpenBr.   . END.
     4158           when 'Время!созд'  then DO:    assign       sort-column-name = "STRING (x-abc-analysis.abc-time-create,'HH:MM')"     .     run OpenBr.   . END.
     4159           when 'БД'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-db-num-create"     .     run OpenBr.   . END.
     4160           when 'Кто провел!анализ'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-who-create"     .     run OpenBr.   . END.
     4161           when 'Внутренний!№'  then DO:    assign       sort-column-name = "x-abc-analysis.abc-id"     .     run OpenBr.   . END.
     4162       otherwise do:
     4163         assign
     4164           sort-column-name = ""
     4165         .
     4166         run OpenBr.
     4167           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBROWSE-ABC') then do:
     4168             run mv-brw-defaultBROWSE-ABC.
     4169           end.
     4170         if sort-labelBROWSE-ABC <> "" then do:
     4171           assign
     4172             cur-clmnBROWSE-ABC:column-fgcolor = 0
     4173           .
     4174         end.
     4175         assign
     4176           cur-clmn-locBROWSE-ABC = ?
     4177         .
     4178       end.
     4179     end case.
     4180       if cur-clmn-locBROWSE-ABC <> ? then do:
     4181         if can-do( this-procedure:internal-entries, 'ch-clmnBROWSE-ABC') then do:
     4182           run ch-clmnBROWSE-ABC in this-procedure (cur-clmn-locBROWSE-ABC).
     4183         end.
     4184       end.
     4185     if p-recid <> ? then do:
     4186       reposition BROWSE-ABC to recid p-recid no-error.
     4187       apply "value-changed" to BROWSE-ABC in frame Dialog-Frame.
     4188     end.
     4189     apply "entry" to BROWSE-ABC in frame Dialog-Frame.
     4190   END PROCEDURE.
     4191   procedure re-open-query-srt-clmnBROWSE-ABC:
     4192   if cur-clmnBROWSE-ABC = ? then do:
     4193      run OpenBr.
     4194   end.
     4195   else do:
     4196      assign re-queryBROWSE-ABC = yes.
     4197      run sort-brBROWSE-ABC
     4198        (input (if available x-abc-analysis
     4199                then recid(x-abc-analysis)
     4200                else ?
     4201               )
     4202        ).
     4203      assign re-queryBROWSE-ABC = no.
     4204   end.
     4205   end.
     4206   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4207   do:
     4208     BROWSE-ABC :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     4209   end.
     4210   x-abc-analysis.abc-who-create:visible in browse BROWSE-ABC  = false .
     4211   MAIN-BLOCK:
     4212   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4213      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4214   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4215   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4216     (output v-db-num
     4217     )  .
     4218     x-abc-analysis.abc-des:read-only  in frame Dialog-Frame = true.
     4219     x-abc-analysis.abc-name:read-only in frame Dialog-Frame = true.
     4220     x-abc-analysis.abc-name:read-only in browse BROWSE-ABC  = true.
     4221     run my_enable in this-procedure .
     4222   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4223   DEF VAR cur-clmn-numBROWSE-ABC as INT EXTENT 18 no-undo.
     4224   DEF VAR varmviBROWSE-ABC       as INT no-undo.
     4225   DEF VAR varmvjBROWSE-ABC       as INT no-undo.
     4226   DEF VAR varmvkBROWSE-ABC       as INT no-undo.
     4227   DEF VAR varmvlBROWSE-ABC       as INT no-undo.
     4228   DEF VAR move-elementBROWSE-ABC as INT no-undo.
     4229   def var jjBROWSE-ABC           as int no-undo.
     4230   do varmviBROWSE-ABC = 1 to EXTENT(cur-clmn-numBROWSE-ABC):
     4231     ASSIGN cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] = varmviBROWSE-ABC.
     4232   END.
     4233   RUN start-mv-clmnBROWSE-ABC.
     4234   PROCEDURE start-mv-clmnBROWSE-ABC:
     4235   def var old-session as logical no-undo.
     4236      old-session = SESSION:IMMEDIATE-DISPLAY.
     4237      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4238          IF  true = true   THEN DO:
     4239      DO jjBROWSE-ABC = NUM-ENTRIES(v-order-col) TO 1 BY -1:
     4240        RUN re-move-clmnBROWSE-ABC ( cur-clmn-numBROWSE-ABC[INTEGER(ENTRY (jjBROWSE-ABC, v-order-col))] , 2).
     4241      END.
     4242          END.
     4243      SESSION:IMMEDIATE-DISPLAY = old-session.
     4244   END.
     4245   ON ctrl-cursor-right OF BROWSE BROWSE-ABC do:
     4246     RUN re-move-clmnBROWSE-ABC ( 2, 18).
     4247   END.
     4248   ON ctrl-cursor-left OF BROWSE BROWSE-ABC do:
     4249     RUN re-move-clmnBROWSE-ABC (18, 2).
     4250   END.
     4251   PROCEDURE re-move-clmnBROWSE-ABC:
     4252     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4253     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4254     DO varmviBROWSE-ABC = 1 TO EXTENT(cur-clmn-numBROWSE-ABC):
     4255       if cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] = source-column THEN cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] = -1.
     4256     END.
     4257     if BROWSE-ABC:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4258     if source-column > target-column THEN
     4259     DO varmvjBROWSE-ABC = source-column - 1 to target-column BY -1:
     4260       DO varmviBROWSE-ABC = 1 TO EXTENT(cur-clmn-numBROWSE-ABC):
     4261           if cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] = varmvjBROWSE-ABC THEN DO:
     4262             cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] = cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] + 1.
     4263           END.
     4264       END.
     4265     END.
     4266     ELSE
     4267     DO varmvjBROWSE-ABC = source-column + 1 to target-column:
     4268       DO varmviBROWSE-ABC = 1 TO EXTENT(cur-clmn-numBROWSE-ABC):
     4269         if cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] = varmvjBROWSE-ABC THEN DO:
     4270           cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] = cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] - 1.
     4271         END.
     4272       END.
     4273     END.
     4274     DO varmviBROWSE-ABC = 1 TO EXTENT(cur-clmn-numBROWSE-ABC):
     4275       if cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] = -1 THEN cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] = target-column.
     4276     END.
     4277   END PROCEDURE.
     4278   PROCEDURE ch-clmnBROWSE-ABC:
     4279     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4280     if cur-clmn-loc <= 2 then do:
     4281       return .
     4282     end.
     4283     DO varmviBROWSE-ABC = 1 TO EXTENT(cur-clmn-numBROWSE-ABC):
     4284       if cur-clmn-numBROWSE-ABC[varmviBROWSE-ABC] = cur-clmn-loc THEN move-elementBROWSE-ABC = varmviBROWSE-ABC.
     4285     END.
     4286     RUN re-move-clmnBROWSE-ABC (cur-clmn-loc, 2).
     4287   END PROCEDURE.
     4288   PROCEDURE mv-brw-defaultBROWSE-ABC:
     4289   def var old-session as logical no-undo.
     4290     old-session = SESSION:IMMEDIATE-DISPLAY.
     4291     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4292     do varmvlBROWSE-ABC = 2 to EXTENT(cur-clmn-numBROWSE-ABC):
     4293       RUN re-move-clmnBROWSE-ABC (cur-clmn-numBROWSE-ABC[varmvlBROWSE-ABC], varmvlBROWSE-ABC).
     4294     END.
     4295     RUN start-mv-clmnBROWSE-ABC.
     4296     SESSION:IMMEDIATE-DISPLAY = old-session.
     4297   END PROCEDURE.
     4298   .
     4299     WAIT-FOR GO OF FRAME Dialog-Frame focus BROWSE-ABC.
     4300   END.
     4301   RUN disable_UI in this-procedure .
     4302   PROCEDURE disable_UI :
     4303     HIDE FRAME Dialog-Frame.
     4304   END PROCEDURE.
     4305   PROCEDURE enable_UI :
     4306     DISPLAY mark-num v-user-name
     4307         WITH FRAME Dialog-Frame.
     4308     IF AVAILABLE x-abc-analysis THEN
     4309       DISPLAY x-abc-analysis.abc-des x-abc-analysis.abc-name
     4310         WITH FRAME Dialog-Frame.
     4311     IF AVAILABLE x-criterion-analysis THEN
     4312       DISPLAY x-criterion-analysis.cral-name
     4313         WITH FRAME Dialog-Frame.
     4314     ENABLE b-quit B-mark B-sel B-add B-lookup B-print B-Help BROWSE-ABC
     4315            BROWSE-obj BROWSE-period BROWSE-type-doc x-abc-analysis.abc-des
     4316            mark-num x-abc-analysis.abc-name v-user-name
     4317         WITH FRAME Dialog-Frame.
     4318     VIEW FRAME Dialog-Frame.
     4319     OPEN QUERY BROWSE-ABC FOR EACH x-abc-analysis NO-LOCK,              EACH x-criterion-analysis OF x-abc-analysis NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-obj FOR EACH x-abc-analysis-obj       WHERE x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and x-abc-analysis-obj.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-period FOR EACH x-abc-analysis-period       WHERE x-abc-analysis-period.abc-id = x-abc-analysis.abc-id and x-abc-analysis-period.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-type-doc FOR EACH x-abc-analysis-doc       WHERE x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and x-abc-analysis-doc.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     4320   END PROCEDURE.
     4321   PROCEDURE my_enable :
     4322   define variable  par-type as character no-undo .
     4323   define variable  v-value-date    as date   no-undo .
     4324   define variable  v-value-decimal as decimal   no-undo .
     4325   define variable  v-value-integer as integer   no-undo .
     4326   define variable  v-value-logical as logical   no-undo .
     4327   define variable v-found as logical   no-undo .
     4328   run thbjattr_value in this-procedure  (
     4329     input   "",
     4330     input   0 ,
     4331     input   'abc-global':U ,
     4332     input   'abc-type'  ,
     4333     output  par-abc-type ,
     4334     output  v-value-date      ,
     4335     output  v-value-decimal   ,
     4336     output  v-value-integer   ,
     4337     output  v-value-logical   ,
     4338     output  par-type            ,
     4339     output  v-found
     4340     ) no-error
     4341     .
     4342     if error-status :error or v-found = false then do:
     4343         message "Нет настроек Ассортиментной политики !!!." view-as alert-box information .
     4344         return error return-value .
     4345     end.
     4346      case par-abc-type :
     4347      when 'ABC':U
     4348      then do:
     4349           assign
     4350               v-d:VISIBLE IN BROWSE BROWSE-ABC = FALSE
     4351               v-e:VISIBLE IN BROWSE BROWSE-ABC = FALSE
     4352               v-f:VISIBLE IN BROWSE BROWSE-ABC = FALSE
     4353           .
     4354      end.
     4355      when 'ABCD':U
     4356      then do:
     4357           assign
     4358               v-e:VISIBLE IN BROWSE BROWSE-ABC = FALSE
     4359               v-f:VISIBLE IN BROWSE BROWSE-ABC = FALSE
     4360           .
     4361      end.
     4362      when 'ABCDE':U
     4363      then do:
     4364           assign
     4365               v-f:VISIBLE IN BROWSE BROWSE-ABC = FALSE
     4366           .
     4367      end.
     4368      when 'ABCDEF':U
     4369      then do:
     4370      end.
     4371      otherwise do:
     4372        message "Не верно задан параметр abc-type " par-abc-type view-as alert-box error .
     4373      end.
     4374      end case.
     4375      x-abc-analysis.abc-name:resizable in browse BROWSE-ABC = true .
     4376      x-criterion-analysis.cral-name:resizable in browse BROWSE-ABC = true .
     4377      x-abc-analysis.abc-name:width     in browse BROWSE-ABC   = v-size-col1 .
     4378      x-criterion-analysis.cral-name:width     in browse BROWSE-ABC   = v-size-col2 .
     4379     ENABLE b-quit
     4380            B-mark      when LOOKUP("b-mark":U, p-bttn ) > 0
     4381            mark-num
     4382            B-sel       when LOOKUP("b-sel":U, p-bttn ) > 0
     4383            B-add       when LOOKUP("b-add":U, p-bttn ) > 0
     4384            B-del       when LOOKUP("b-del":U, p-bttn ) > 0
     4385            B-lookup
     4386            B-print
     4387            B-Help
     4388            browse-abc
     4389            browse-obj
     4390            browse-period
     4391            browse-type-doc
     4392            x-abc-analysis.abc-des
     4393            x-abc-analysis.abc-name
     4394         WITH FRAME Dialog-Frame.
     4395     VIEW FRAME Dialog-Frame.
     4396     RUN OpenBR.
     4397   END PROCEDURE.
     4398   PROCEDURE OpenBR :
     4399   define variable p-open-query     as logical   no-undo init true .
     4400   def var l-query-was-opened as logical no-undo .
     4401   define variable doc-rec  as recid     no-undo .
     4402   define variable  p-find-next      as logical   no-undo .
     4403   define variable  p-find-condition as character no-undo .
     4404   def var sort-column-phrase as character no-undo .
     4405   case sort-column-name :
     4406     when "" then do:
     4407       assign
     4408         sort-column-phrase = ""
     4409       .
     4410     end.
     4411     otherwise do:
     4412       assign
     4413         sort-column-phrase = "by " + sort-column-name
     4414       .
     4415     end.
     4416   end case.
     4417   define variable title0 as character no-undo init "Список Ассортиментных матриц".
     4418   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4419   define variable  l-disable-where-30  as logical   no-undo .
     4420   define variable  l-filter-open-30    as logical   .
     4421   define variable  flt-rec-30       as recid     no-undo .
     4422   define variable  filter-name-30      as character no-undo .
     4423   define variable  where-phrase-30     as character no-undo .
     4424   define variable  sort-phrase-30      as character no-undo .
     4425   define variable  where-phrase-rus-30 as character no-undo .
     4426   define variable  sort-phrase-rus-30  as character no-undo .
     4427     run waitfram-show in this-procedure
     4428       (input "ЖДИТЕ ..."
     4429       ).
     4430   run gbl/flt-get.p
     4431     (input filter-point
     4432     ,output flt-rec-30
     4433     ,output filter-name-30
     4434     ,output where-phrase-30
     4435     ,output sort-phrase-30
     4436     ,output where-phrase-rus-30
     4437     ,output sort-phrase-rus-30
     4438     ).
     4439   if p-open-query then do:
     4440       run set-filter-name in this-procedure
     4441         (INPUT filter-name-30
     4442         ) no-error .
     4443     assign
     4444       l-filter-open-30 = false
     4445     .
     4446     if flt-rec-30 <> ?
     4447       or sort-column-phrase > ""
     4448     then do:
     4449       define variable  parameter-2-30 as character no-undo .
     4450       define variable  parameter-3-30 as character no-undo .
     4451       define variable  parameter-4-30 as character no-undo .
     4452       define variable  parameter-5-30 as character no-undo .
     4453       define variable  parameter-6-30 as character no-undo .
     4454       define variable  parameter-7-30 as character no-undo .
     4455         assign
     4456         parameter-3-30 =
     4457                                 "FOR EACH x-abc-analysis"
     4458         parameter-4-30 =
     4459           (
     4460             if (" true   " + " " + where-phrase-30) <> ""
     4461             then " true   " + " " + where-phrase-30
     4462             else "true"
     4463           )
     4464         parameter-5-30 = (" " + "" + " " + ", EACH x-criterion-analysis OF x-abc-analysis")
     4465         parameter-6-30 = if sort-phrase-30 = ''
     4466                              then
     4467           (
     4468           " " + " " +
     4469             " " + sort-column-phrase +
     4470           " " + " "
     4471           )
     4472                              else
     4473           (
     4474           " " + " " +
     4475             " " + sort-column-phrase +
     4476           " " + sort-phrase-30
     4477           )
     4478         parameter-7-30 =
     4479           " indexed-reposition  "
     4480       .
     4481       do
     4482       on stop undo, leave
     4483       on error undo, leave
     4484       :
     4485         assign
     4486           l-disable-where-30 =
     4487             (" true   " + " " + where-phrase-30 = "")
     4488         .
     4489         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4490                             ,input query BROWSE-Abc:handle
     4491                             ,input parameter-3-30
     4492                             ,input parameter-4-30
     4493                             ,input parameter-5-30
     4494                             ,input parameter-6-30
     4495                             ,input parameter-7-30
     4496                             )
     4497         .
     4498         assign
     4499           l-filter-open-30 = true
     4500         .
     4501       end.
     4502       if l-filter-open-30 = false then do:
     4503         message
     4504           "Ошибка при фильтрации / сортировке" skip
     4505           "Будут показаны записи без учета фильтра" skip
     4506           view-as alert-box .
     4507       end.
     4508       else do:
     4509           assign
     4510             l-query-was-opened = true
     4511           .
     4512       end.
     4513     end.
     4514     if l-filter-open-30 = false then do:
     4515       OPEN QUERY BROWSE-Abc FOR EACH x-abc-analysis
     4516         where  true
     4517       , EACH x-criterion-analysis OF x-abc-analysis
     4518         indexed-reposition
     4519     .
     4520         assign
     4521           l-query-was-opened = true
     4522         .
     4523     end.
     4524   end.
     4525   else do:
     4526     assign
     4527       doc-rec = recid( x-abc-analysis )
     4528     .
     4529     do
     4530     on stop undo, leave
     4531     on error undo, leave
     4532     :
     4533       if query BROWSE-Abc:handle:get-buffer-handle(1) = (buffer x-abc-analysis:handle) then do:
     4534         assign
     4535         parameter-2-30 = (if p-find-next then "true":u else "false":u )
     4536         parameter-4-30 =
     4537           "where ":u + " true   " + " ":u + where-phrase-30 + " ":u + p-find-condition + " " + ""
     4538         parameter-5-30 = " "
     4539       .
     4540         run fltopend_fltfindd in this-procedure  (
     4541                             input this-procedure:handle
     4542                             ,input query BROWSE-Abc:handle
     4543                             ,input rowid(x-abc-analysis)
     4544                             ,input logical(parameter-2-30)
     4545                             ,input no-lock
     4546                             ,input (buffer x-abc-analysis:handle)
     4547                             ,input parameter-4-30
     4548                             ,input parameter-5-30
     4549                             ) no-error.
     4550         .
     4551         assign
     4552           doc-rec = integer(return-value)
     4553           v-fltopend-rowid[1] = ?
     4554         .
     4555       end.
     4556       else do:
     4557         assign
     4558         parameter-2-30 = (if p-find-next then "true":u else "false":u )
     4559         parameter-3-30 =  "FOR EACH x-abc-analysis"
     4560         parameter-4-30 =
     4561           (
     4562             if (" true   " + " " + where-phrase-30) <> ""
     4563             then " true   " + " " + where-phrase-30
     4564             else "true"
     4565           )
     4566         parameter-5-30 = (" " + "" + " " + ", EACH x-criterion-analysis OF x-abc-analysis" + " " + p-find-condition)
     4567         parameter-6-30 = if sort-phrase-30 = ''
     4568                              then
     4569           (
     4570           " " + " " +
     4571             " " + sort-column-phrase +
     4572           " " + " "
     4573           )
     4574                              else
     4575           (
     4576           " " + " " +
     4577             " " + sort-column-phrase +
     4578           " " + sort-phrase-30
     4579           )
     4580         parameter-7-30 =
     4581           " indexed-reposition  "
     4582       .
     4583         run fltopend_fltfindq in this-procedure  (
     4584                             input this-procedure:handle
     4585                             ,input query BROWSE-Abc:handle
     4586                             ,input logical(parameter-2-30)
     4587                             ,input no-lock
     4588                             ,input parameter-3-30
     4589                             ,input parameter-4-30
     4590                             ,input parameter-5-30
     4591                             ,input parameter-6-30
     4592                             ,input parameter-7-30
     4593                             ,output v-fltopend-rowid
     4594                             ) no-error.
     4595         .
     4596         doc-rec = ?.
     4597       end.
     4598       assign
     4599         l-query-was-opened = true
     4600       .
     4601     end.
     4602   end.
     4603     run waitfram-hide in this-procedure .
     4604   APPLY "ENTRY" TO BROWSE-ABC in frame Dialog-Frame.
     4605   APPLY "VALUE-CHANGED" TO BROWSE-ABC in frame Dialog-Frame.
     4606   END PROCEDURE.
     4607   PROCEDURE proc-add :
     4608   define output  parameter p-doc-rec as recid     no-undo .
     4609   run ref/abcanali.w
     4610     ( input parparentproc ,
     4611       input  'ДОБАВЛЕНИЕ':U ,
     4612       input  ? ,
     4613       input v-db-num ,
     4614       input-output p-doc-rec
     4615       ) .
     4616   END PROCEDURE.
     4617   PROCEDURE proc-b-del :
     4618   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     4619   define variable br-handle as handle NO-UNDO.
     4620   define variable g#log  as logical   no-undo .
     4621   if not available x-abc-analysis then return error.
     4622    find current x-abc-analysis exclusive-lock no-error .
     4623           if not available x-abc-analysis then do:
     4624             message vss-workfile vss-revision vss-description skip
     4625                       error-status :get-message(1)   skip
     4626                       "Ошибка при определении записи x-abc-analysis"
     4627                       view-as alert-box error .
     4628             return .
     4629           end.
     4630     delete x-abc-analysis .
     4631     br-handle = BROWSE-ABC:handle in frame Dialog-Frame .
     4632     if valid-handle (br-handle) then do:
     4633       g#log = br-handle:select-next-row().
     4634       if not g#log then g#log = br-handle:select-prev-row().
     4635       loc-doc-rec = RECID(x-abc-analysis) .
     4636     end.
     4637      RUN OpenBr.
     4638      apply "VALUE-CHANGED" to BROWSE-ABC in frame Dialog-Frame.
     4639      reposition BROWSE-ABC to recid loc-doc-rec no-error.
     4640   END PROCEDURE.
     4641   PROCEDURE proc-b-print :
     4642   def var date_string     as      char    no-undo.
     4643   def var Line                as      char    no-undo.
     4644   def var for-time as char.
     4645   define variable v-time  as character no-undo .
     4646              run get-report-num (
     4647               output p-report-id
     4648           ).
     4649       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     4650       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     4651       put stream OutStr-html unformatted
     4652                "<!DOCTYPE HTML>" skip
     4653                   ' <html>' skip
     4654                   '  <head>' skip
     4655                   '   <meta charset="utf-8">' skip
     4656                   '    <style type="text/css">' skip
     4657                   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     4658                   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     4659                   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     4660                   '   </style>' skip
     4661                   '  </head>' skip
     4662               .
     4663       put stream OutStr-html unformatted
     4664           '<body>' skip
     4665           '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     4666           '<thead>' skip
     4667           '<TR class="set_columns">'skip
     4668               '<TD style="width: 150px;"></TD>'skip
     4669               '<TD style="width: 150px;"></TD>'skip
     4670               '<TD style="width: 50px;"></TD>'skip
     4671               '<TD style="width: 50px;"></TD>'skip
     4672               '<TD style="width: 50px;"></TD>'skip
     4673               '<TD style="width: 50px;"></TD>'skip
     4674               '<TD style="width: 70px;"></TD>'skip
     4675               '<TD style="width: 70px;"></TD>'skip
     4676               '<TD style="width: 50px;"></TD>'skip
     4677               '<TD style="width: 70px;"></TD>'skip
     4678               '<TD style="width: 50px;"></TD>'skip
     4679               '<TD style="width: 30px;"></TD>'skip
     4680               '<TD style="width: 50px;"></TD>'skip
     4681           '</TR>'skip
     4682           '<TR>'skip
     4683               '<TD colspan="13" STYLE="font-size: 14px;">Список ABC-анализов</TD>'skip
     4684           '</TR>'skip
     4685           '<TR>'skip
     4686               '<TD colspan="13" STYLE="font-size: 14px;">Дата печати: ' + string(date_string,"99.99.9999") + '</TD>' skip
     4687           '</TR>'skip
     4688           '</thead>'skip
     4689       .
     4690        put stream OutStr-html unformatted
     4691           '<tbody>'
     4692           '<TR>'skip
     4693               '<TH rowspan="2" style="text-align: center;">Наименование</TH>'skip
     4694               '<TH rowspan="2" style="text-align: center;">Критерий анализа</TH>'skip
     4695               '<TH style="text-align: center;">I</TH>'skip
     4696               '<TH style="text-align: center;">II</TH>'skip
     4697               '<TH style="text-align: center;">III</TH>'skip
     4698               '<TH style="text-align: center;">=<</TH>'skip
     4699               '<TH rowspan="2" style="text-align: center;">Строка объектов</TH>'skip
     4700               '<TH rowspan="2" style="text-align: center;">Строка периодов</TH>'skip
     4701               '<TH rowspan="2" style="text-align: center;">Строка документов</TH>'skip
     4702               '<TH rowspan="2" style="text-align: center;">Дата создания</TH>'skip
     4703               '<TH rowspan="2" style="text-align: center;">Время создания</TH>'skip
     4704               '<TH rowspan="2" style="text-align: center;">БД</TH>'skip
     4705               '<TH rowspan="2" style="text-align: center;">Кто провел анализ</TH>'skip
     4706           '</TR>'skip
     4707           '<TR>'skip
     4708               '<TH style="text-align: center;">A%</TH>'skip
     4709               '<TH style="text-align: center;">A%</TH>'skip
     4710               '<TH style="text-align: center;">B%</TH>'skip
     4711               '<TH style="text-align: center;">E%</TH>'skip
     4712           '</TR>'skip
     4713           .
     4714        for each x-abc-analysis :
     4715   put stream OutStr-html unformatted
     4716                                 '<TR>'skip
     4717                                     '<TD style="text-align: center"> ' + string(x-abc-analysis.abc-name) + '</TD>'skip
     4718                                     '<TD style="text-align: center"> ' + string(x-criterion-analysis.cral-name) + '</TD>'skip
     4719                                     '<TD num="0" val="' + fnc-convert-dot-to-colon(x-abc-analysis.abc-a,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if x-abc-analysis.abc-a <> ? then fnc-convert-dot-to-colon(x-abc-analysis.abc-a,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4720                                     '<TD num="0" val="' + fnc-convert-dot-to-colon(x-abc-analysis.abc-b,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if x-abc-analysis.abc-b <> ? then fnc-convert-dot-to-colon(x-abc-analysis.abc-b,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4721                                     '<TD num="0" val="' + fnc-convert-dot-to-colon(x-abc-analysis.double-line-proc,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if x-abc-analysis.double-line-proc <> ? then fnc-convert-dot-to-colon(x-abc-analysis.double-line-proc,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4722                                     '<TD num="0" val="' + fnc-convert-dot-to-colon(x-abc-analysis.le-proc,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if x-abc-analysis.le-proc <> ? then fnc-convert-dot-to-colon(x-abc-analysis.le-proc,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4723                                     '<TD> ' + string(x-abc-analysis.abc-string-obj) + '</TD>'skip
     4724                                     '<TD> ' + string(x-abc-analysis.abc-string-period) + '</TD>'skip
     4725                                     '<TD> ' + string(x-abc-analysis.abc-string-doc) + '</TD>'skip
     4726                                     '<TD> ' + string(x-abc-analysis.abc-date-create,"99/99/99") + '</TD>'skip
     4727                                     '<TD> ' + STRING (x-abc-analysis.abc-time-create,'HH:MM') + '</TD>'skip
     4728                                     '<TD num="0" val="' + fnc-convert-dot-to-colon(x-abc-analysis.abc-db-num-create,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if x-abc-analysis.abc-db-num-create <> ? then fnc-convert-dot-to-colon(x-abc-analysis.abc-db-num-create,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4729                                     '<TD> ' + STRING (x-abc-analysis.abc-who-create) + '</TD>'skip
     4730                                 '</TR>'skip
     4731                                 .
     4732         END.
     4733      put stream OutStr-html unformatted
     4734                                   '</tbody>' skip
     4735                                   '</table>' skip
     4736                                   '</body>' skip
     4737                                   '</html>' skip
     4738                                   .
     4739   output stream OutStr-html close.
     4740     run prn-lib-reportviewer-report-name in this-procedure (
     4741                                                             input parParentProc
     4742                                                             ,input v-file-name-rep-htm
     4743                                                             ).
     4744   END PROCEDURE.
     4745   PROCEDURE get-report-num :
     4746   define output parameter p-report-num as integer no-undo .
     4747     do
     4748     on error undo, return error return-value
     4749     :
     4750       run gbl/getrpnum.p (output p-report-num).
     4751     end.
     4752   END PROCEDURE.
     4753   FUNCTION f-name-doc RETURNS CHARACTER
     4754     ( BUFFER buf_abc-analysis-doc FOR  x-abc-analysis-doc   ) :
     4755       define variable v-ret as character no-undo .
     4756       run get-name-from-ext-type in this-procedure (buf_abc-analysis-doc.abcd-ext-doc-type , no ,  output  v-ret ) .
     4757     RETURN v-ret.
     4758   END FUNCTION.
