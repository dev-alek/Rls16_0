        1   DEFINE INPUT  PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE OUTPUT PARAMETER p-obj-type AS character NO-UNDO.
        3   DEFINE OUTPUT PARAMETER p-obj-code AS integer NO-UNDO.
        4   DEFINE OUTPUT PARAMETER p-ext-obj-type AS character NO-UNDO.
        5   DEFINE OUTPUT PARAMETER p-ext-obj-code AS integer NO-UNDO.
        6   DEFINE OUTPUT PARAMETER p-Ok        AS logical NO-UNDO.
        7   define variable vss-revision    as character no-undo init "$Revision$":u .
        8   define variable vss-author      as character no-undo init "$Author$":u .
        9   define variable vss-date        as character no-undo init "$Date$":u .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       11   define variable vss-archive     as character no-undo init "$Archive$":u .
       12   define variable vss-description as character no-undo init "Ввод данных для нового клиента во внешнем классификаторе соответствия контрагентов" .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable ref-list as character no-undo.
      119   define variable v-rec as recid no-undo .
      120   define buffer buf_db for ub.db.
      121   DEFINE BUTTON b-choose-client
      122        IMAGE-UP FILE "btn-down-arrow":U
      123        IMAGE-DOWN FILE "btn-down-arrow":U
      124        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      125        LABEL "b-choose-client"
      126        SIZE 3 BY 1.
      127   DEFINE BUTTON b-choose-contragent
      128        IMAGE-UP FILE "btn-down-arrow":U
      129        IMAGE-DOWN FILE "btn-down-arrow":U
      130        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      131        LABEL "b-choose-contragent"
      132        SIZE 3 BY 1.
      133   DEFINE BUTTON b-exit AUTO-GO
      134        LABEL "&Ввод "
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON B-help
      138        LABEL "Помо&щь"
      139        SIZE 3 BY 1
      140        BGCOLOR 8 .
      141   DEFINE BUTTON b-quit AUTO-END-KEY
      142        LABEL "&Отмена"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE VARIABLE fi-ext-obj-code AS INTEGER FORMAT ">>>>>>>9" INITIAL 0
      146        VIEW-AS FILL-IN
      147        SIZE 9.2 BY 1 TOOLTIP "Соответствующий код контрагента в ТН или другой системе"
      148        BGCOLOR 15 .
      149   DEFINE VARIABLE fi-ext-obj-type AS CHARACTER FORMAT "X(3)"
      150        LABEL "Контрагент"
      151        VIEW-AS FILL-IN
      152        SIZE 4.2 BY 1 TOOLTIP "Соответствующий тип контрагента в ТН или другой системе"
      153        BGCOLOR 15 .
      154   DEFINE VARIABLE fi-obj-code AS INTEGER FORMAT ">>>>>>>9" INITIAL 0
      155        VIEW-AS FILL-IN
      156        SIZE 9.2 BY 1 TOOLTIP "код клиента"
      157        BGCOLOR 15 .
      158   DEFINE VARIABLE fi-obj-type AS CHARACTER FORMAT "X(3)"
      159        LABEL "Клиент в ТН"
      160        VIEW-AS FILL-IN
      161        SIZE 4.2 BY 1 TOOLTIP "тип клиента"
      162        BGCOLOR 15 .
      163   DEFINE FRAME d-add-ext-client
      164        b-exit AT ROW 1 COL 1
      165        b-quit AT ROW 1 COL 11
      166        B-help AT ROW 1 COL 50
      167        fi-obj-type AT ROW 2.43 COL 13 COLON-ALIGNED
      168        fi-obj-code AT ROW 2.43 COL 18 COLON-ALIGNED NO-LABEL WIDGET-ID 2
      169        b-choose-client AT ROW 2.43 COL 29
      170        fi-ext-obj-type AT ROW 3.86 COL 13 COLON-ALIGNED
      171        fi-ext-obj-code AT ROW 3.86 COL 18 COLON-ALIGNED NO-LABEL WIDGET-ID 4
      172        b-choose-contragent AT ROW 3.86 COL 29
      173        SPACE(34.37) SKIP(1.78)
      174       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      175            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      176            TITLE "Соответствие контрагентов"
      177            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      178   ASSIGN
      179          FRAME d-add-ext-client:SCROLLABLE       = FALSE
      180          FRAME d-add-ext-client:HIDDEN           = TRUE.
      181   ON GO OF FRAME d-add-ext-client
      182   DO:
      183     define buffer buf_db for ub.db .
      184     define buffer buf_clients for ub.clients.
      185     assign
      186       fi-obj-type
      187       fi-obj-code
      188       fi-ext-obj-type
      189       fi-ext-obj-code
      190     .
      191     find first buf_clients no-lock
      192       where buf_clients.obj-type = fi-obj-type
      193         and buf_clients.obj-code = fi-obj-code
      194       no-error.
      195     if not avail buf_clients then do:
      196       message
      197         substitute( "Не возможно найти клиента &1 &2", fi-obj-type, string( fi-obj-code ) )
      198         view-as alert-box error .
      199       apply "entry" to fi-obj-type.
      200       return no-apply.
      201     end.
      202     assign
      203       p-obj-type     = fi-obj-type
      204       p-obj-code     = fi-obj-code
      205       p-ext-obj-type = fi-ext-obj-type
      206       p-ext-obj-code = fi-ext-obj-code
      207       p-Ok = yes
      208     .
      209    END.
      210   ON WINDOW-CLOSE OF FRAME d-add-ext-client
      211   DO:
      212     APPLY "END-ERROR":U TO SELF.
      213   END.
      214   ON CHOOSE OF b-choose-client IN FRAME d-add-ext-client
      215   DO:
      216     run ref/cli-all.w
      217     ( parparentproc
      218       , input  "b-sel"
      219       , ?
      220       , ?
      221       , ?
      222       , ?
      223       , ?
      224       , ?
      225     ,output ref-list
      226     ).
      227     If ref-list <> "" then do :
      228       find first ub.clients no-lock
      229         where recid(ub.clients) = integer(ref-list) no-error.
      230       if available ub.clients then do with frame d-add-ext-client:
      231         assign
      232           fi-obj-type = ub.clients.obj-type
      233           fi-obj-code = ub.clients.obj-code
      234         .
      235         display fi-obj-type fi-obj-code.
      236       end.
      237     end.
      238   END.
      239   ON CHOOSE OF b-choose-contragent IN FRAME d-add-ext-client
      240   DO:
      241     run ref/cli-all.w
      242     ( parparentproc
      243       , input  "b-sel"
      244       , ?
      245       , ?
      246       , ?
      247       , ?
      248       , ?
      249       , ?
      250     ,output ref-list
      251     ).
      252     If ref-list <> "" then do :
      253       find first ub.clients no-lock
      254            where recid(ub.clients) = integer(ref-list) no-error.
      255       if available ub.clients then do with frame d-add-ext-client:
      256         assign
      257           fi-ext-obj-type = ub.clients.obj-type
      258           fi-ext-obj-code = ub.clients.obj-code
      259         .
      260         display fi-ext-obj-type fi-ext-obj-code.
      261       end.
      262     end.
      263   END.
      264   ON CHOOSE OF b-quit IN FRAME d-add-ext-client
      265   DO:
      266   END.
      267   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-add-ext-client:PARENT eq ?
      268   THEN FRAME d-add-ext-client:PARENT = ACTIVE-WINDOW.
      269   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      270   on help of frame d-add-ext-client
      271   do:
      272     run gbl/app_help.p
      273       (input this-procedure :file-name
      274       ,input ''
      275       ,input ?
      276       ) no-error.
      277     if error-status :error then do:
      278       message
      279         "Ошибка при вызове помощи"
      280         error-status :get-message(1)
      281         view-as alert-box .
      282     end.
      283   end.
      284   run minbtn-set in this-procedure .
      285   on choose of b-help in frame d-add-ext-client
      286   do:
      287     apply "help":u to frame d-add-ext-client .
      288   end.
      289   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      290   procedure minbtn-set :
      291       do
      292           on error undo, return error return-value
      293           :
      294           define variable ii              as integer       no-undo .
      295           define variable fh              as widget-handle no-undo .
      296           define variable hh              as widget-handle no-undo .
      297           define variable v-h             as handle        extent 4 no-undo .
      298           define variable v-name-button   as character     no-undo .
      299           define variable v-help-old-x    as decimal       no-undo .
      300           define variable v-help-old-y    as decimal       no-undo .
      301           define variable v-help-old-size as decimal       no-undo .
      302           define variable v-frame-width   as decimal       no-undo .
      303           define variable jj              as integer       no-undo .
      304           do
      305               on error undo, return error
      306               :
      307               assign
      308                   v-frame-width = frame d-add-ext-client:width - 0.3
      309                   fh            = frame d-add-ext-client:first-child
      310                   hh            = fh:first-child
      311                   ii            = 1
      312                   .
      313               do while valid-handle(hh):
      314                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      315                   do:
      316                       case lc(hh:name) :
      317                           when "b-help" then
      318                               do:
      319                                   hh:load-image-up("cmp/b-help.bmp":u) .
      320                                   hh:load-image-down("cmp/b-help.bmp":u) .
      321                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      322                                   hh:TOOLTIP = "Помощь" .
      323                                   v-help-old-x = hh:column .
      324                                   v-help-old-y = hh:row    .
      325                                   v-help-old-size = hh:width .
      326                                   hh:width-chars = 2.5 .
      327                               end.
      328                           when "b-print" then
      329                               do:
      330                                   hh:load-image("cmp/b-print.bmp":u) .
      331                                   hh:TOOLTIP = "Печать" .
      332                                   v-h[ii] = hh:handle .
      333                                   ii = ii + 1 .
      334                                   hh:width-chars = 3 .
      335                               end.
      336                           when "b-history" or
      337                           when "b-hist" then
      338                               do:
      339                                   hh:load-image("cmp/b-hist.bmp":u) .
      340                                   hh:TOOLTIP = "История" .
      341                                   v-h[ii] = hh:handle .
      342                                   ii = ii + 1 .
      343                                   hh:width-chars = 3 .
      344                               end.
      345                           when "b-sch" then
      346                               do:
      347                                   hh:load-image("cmp/b-sch.bmp":u) .
      348                                   hh:TOOLTIP = "Установка Фильтра" .
      349                                   v-h[ii] = hh:handle .
      350                                   ii = ii + 1 .
      351                                   hh:width-chars = 3 .
      352                               end.
      353                           when "b-hist-user" then
      354                               do:
      355                                   hh:load-image("cmp/b-hist.bmp":u) .
      356                                   hh:TOOLTIP = "История пользователя" .
      357                                   ii = ii + 1 .
      358                               end.
      359                       end case.
      360                   end.
      361                   hh = hh:next-sibling.
      362               end.
      363               b-help:column = v-frame-width - b-help:width-chars.
      364               jj = 0.
      365               repeat ii = 4 to 1 by -1 :
      366                   if valid-handle (v-h[ii] ) then
      367                   do:
      368                       jj  = jj + 1 .
      369                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      370                       v-h[ii]:row    = v-help-old-y .
      371                   end.
      372               end.
      373           end.
      374       end.
      375   end procedure.
      376   MAIN-BLOCK:
      377   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      378      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      379     RUN MyEnable.
      380     WAIT-FOR GO OF FRAME d-add-ext-client.
      381   END.
      382   RUN disable_UI.
      383   PROCEDURE disable_UI :
      384     HIDE FRAME d-add-ext-client.
      385   END PROCEDURE.
      386   PROCEDURE enable_UI :
      387     DISPLAY fi-obj-type fi-obj-code fi-ext-obj-type fi-ext-obj-code
      388         WITH FRAME d-add-ext-client.
      389     ENABLE b-exit b-quit B-help fi-obj-type fi-obj-code b-choose-client
      390            fi-ext-obj-type fi-ext-obj-code b-choose-contragent
      391         WITH FRAME d-add-ext-client.
      392     VIEW FRAME d-add-ext-client.
      393   END PROCEDURE.
      394   PROCEDURE MyEnable :
      395       DISPLAY
      396       fi-obj-type fi-obj-code fi-ext-obj-type fi-ext-obj-code
      397       WITH FRAME d-add-ext-client.
      398     ENABLE
      399     B-exit
      400     B-quit
      401     B-Help
      402     fi-obj-type fi-obj-code b-choose-client fi-ext-obj-type fi-ext-obj-code b-choose-contragent
      403     WITH FRAME d-add-ext-client.
      404     VIEW FRAME d-add-ext-client.
      405   END PROCEDURE.
