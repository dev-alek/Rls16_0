      760   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      761     define variable v-cntxt-db-num        as integer   no-undo .
      762     define variable v-cntxt-userid        as character no-undo .
      763     define variable v-cntxt-level         as character no-undo .
      764     define variable v-cntxt-host-code-obj as integer   no-undo .
      765     define variable v-cntxt-obj-type      as character no-undo .
      766     define variable v-cntxt-obj-code      as integer   no-undo .
      767     define variable v-cntxt-db-num-obj    as integer   no-undo .
      768     define variable v-cntxt-is-admin      as logical   no-undo .
      769   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      770   define temp-table tt-attr-property  no-undo
      771   field upper-attr-code as character
      772   field attr-code as character
      773   field table-name as character
      774   field edit-menu-section-num as integer
      775   field attr-label as character
      776   field menu-item-handle as widget-handle
      777   field user-can-edit as logical
      778   field menu-name as character
      779   field parent-handle as handle
      780   index pi is unique primary
      781   table-name
      782   menu-name
      783   upper-attr-code
      784   attr-code
      785   index i-section
      786   edit-menu-section-num
      787   .
      788   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   procedure attr-pop-create-items :
      790   define input parameter p-table-name as character no-undo .
      791   define input parameter p-get-section-num-proc-name as character no-undo .
      792   define input parameter p-get-attr-label-proc-name as character no-undo .
      793   define input parameter p-attr-choose-proc-name as character no-undo .
      794   define input parameter p-menu-handle as widget-handle no-undo .
      795   define input parameter p-attr-list as character no-undo .
      796   define variable ii as integer no-undo .
      797   define variable V-CREATED as logical no-undo .
      798   define variable v-tool-tip as character no-undo .
      799   define variable v-dop as character no-undo .
      800   define variable v-attr-item as character no-undo .
      801   define variable p-upper-attr-code as character no-undo .
      802   define buffer buf_tt-attr-property for tt-attr-property.
      803     do
      804     on error undo, return error return-value
      805     :
      806        do ii = 1 to num-entries (p-attr-list):
      807          v-attr-item = entry(ii, p-attr-list) .
      808          find first tt-attr-property where
      809                    tt-attr-property.table-name = p-table-name
      810                and tt-attr-property.attr-code = v-attr-item
      811                and tt-attr-property.upper-attr-code = p-upper-attr-code
      812                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
      813          if not available tt-attr-property then do:
      814            create tt-attr-property.
      815            assign
      816            tt-attr-property.table-name = p-table-name
      817            tt-attr-property.attr-code = v-attr-item
      818            tt-attr-property.upper-attr-code = p-upper-attr-code
      819            tt-attr-property.menu-name = p-menu-handle:name
      820            .
      821            run value ( p-get-section-num-proc-name) (
      822                                                      input tt-attr-property.attr-code
      823                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
      824            run value ( p-get-attr-label-proc-name ) (
      825                                           input tt-attr-property.attr-code
      826                                          ,output v-tool-tip
      827                                          ,output tt-attr-property.attr-label
      828                                         ) no-error .
      829            release tt-attr-property.
      830          end.
      831        end.
      832        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
      833        break
      834        by  tt-attr-property.edit-menu-section-num
      835        by  tt-attr-property.attr-label
      836        :
      837          if tt-attr-property.edit-menu-section-num > 0
      838          then do:
      839             if not valid-handle(tt-attr-property.menu-item-handle) then do:
      840               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
      841               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
      842               then do:
      843                 find first buf_tt-attr-property where
      844                           buf_tt-attr-property.table-name = p-table-name
      845                       and buf_tt-attr-property.menu-name = p-menu-handle:name
      846                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      847                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
      848                 if not available buf_tt-attr-property then do:
      849                   create buf_tt-attr-property.
      850                   assign
      851                   buf_tt-attr-property.table-name = p-table-name
      852                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
      853                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      854                   buf_tt-attr-property.menu-name = p-menu-handle:name
      855                   .
      856                   create sub-menu buf_tt-attr-property.menu-item-handle
      857                   assign
      858                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
      859                   parent = p-menu-handle.
      860                 end.
      861                 create menu-item tt-attr-property.menu-item-handle
      862                 assign
      863                 label = tt-attr-property.attr-label
      864                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
      865                 parent = buf_tt-attr-property.menu-item-handle
      866                 triggers:
      867                   on choose
      868                     persistent run value(p-attr-choose-proc-name + "-2") (
      869                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
      870                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
      871                                                                             ) .
      872                 end triggers.
      873                 assign
      874                 v-created = yes.
      875               end.
      876               else do:
      877                 create menu-item tt-attr-property.menu-item-handle
      878                 assign
      879                 label = tt-attr-property.attr-label
      880                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
      881                 parent = p-menu-handle
      882                 triggers:
      883                   on choose
      884                     persistent run value(p-attr-choose-proc-name) (
      885                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
      886                 end triggers.
      887                 assign
      888                 v-created = yes.
      889               end.
      890             end.
      891             if last-of(tt-attr-property.edit-menu-section-num)
      892               then do:
      893               find first buf_tt-attr-property where
      894                         buf_tt-attr-property.table-name = p-table-name
      895                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
      896                                                            , p-table-name
      897                                                            , tt-attr-property.edit-menu-section-num
      898                                                            , p-menu-handle:name
      899                                                            )
      900                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
      901               if not available buf_tt-attr-property then do:
      902                 create buf_tt-attr-property.
      903                 assign
      904                 buf_tt-attr-property.table-name = p-table-name
      905                 buf_tt-attr-property.edit-menu-section-num =  - 1
      906                 buf_tt-attr-property.menu-name = p-menu-handle:name
      907                 buf_tt-attr-property.upper-attr-code = ''
      908                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
      909                                                             , p-table-name
      910                                                             , tt-attr-property.edit-menu-section-num
      911                                                             , p-menu-handle:name
      912                                                             )
      913                 .
      914                 create menu-item buf_tt-attr-property.menu-item-handle
      915                 assign
      916                 subtype = "rule"
      917                 parent = p-menu-handle
      918                 .
      919               end.
      920             end.
      921          end.
      922        end.
      923        if not v-created then do:
      924           run attr-pop-clean-up in this-procedure ( input p-table-name).
      925        end.
      926     end.
      927   end procedure.
      928   procedure attr-pop-clean-up :
      929   define input parameter p-table-name as character no-undo .
      930     for each tt-attr-property where
      931             tt-attr-property.table-name = p-table-name
      932       and tt-attr-property.edit-menu-section-num > 0:
      933       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      934         delete widget tt-attr-property.menu-item-handle.
      935       end.
      936       delete tt-attr-property.
      937     end.
      938     for each tt-attr-property where
      939              tt-attr-property.table-name = p-table-name
      940          and tt-attr-property.edit-menu-section-num =  - 1:
      941       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      942         delete widget tt-attr-property.menu-item-handle.
      943       end.
      944       delete tt-attr-property.
      945     end.
      946   end procedure.
