     1158   procedure grp-obj-notcorr-value :
     1159   do
     1160   on error undo, return error
     1161   :
     1162   define input parameter p-node-code             as integer      no-undo.
     1163   define input parameter p-obj-type              as character    no-undo.
     1164   define input parameter p-obj-code              as integer      no-undo.
     1165   define output parameter p-notcorr              as character    no-undo init ?.
     1166   define output parameter p-range-notcorr     as integer      no-undo.
     1167   define output parameter p-exists-notcorr    as logical      no-undo.
     1168   define variable v-host-code as integer      no-undo.
     1169   DEFINE VARIABLE v-found as logical no-undo .
     1170   DEFINE VARIABLE v-exists as logical no-undo .
     1171   DEFINE VARIABLE v-range as integer no-undo .
     1172   DEFINE VARIABLE jj as integer no-undo .
     1173   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1174   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1175   define buffer buf_gds-grp for ub.gds-grp.
     1176   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1177   find first buf_gds-grp no-lock where
     1178              buf_gds-grp.node-code = p-node-code no-error .
     1179   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1180     message
     1181       vss-workfile vss-revision vss-description
     1182       skip "Не удалось найти группу товаров с кодом" p-node-code
     1183       view-as alert-box error .
     1184     undo, return error .
     1185   end.
     1186   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1187   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1188     (input  p-obj-type
     1189     ,input  p-obj-code
     1190     ,output v-host-code
     1191     ) no-error .
     1192   if error-status :error
     1193   then do:
     1194       message
     1195         vss-workfile vss-revision vss-description
     1196         skip "Не удалось найти фирму объекта"
     1197         skip p-obj-type p-obj-code
     1198         skip return-value
     1199         skip trim(error-status :get-message(1))
     1200       view-as alert-box error.
     1201       undo, return error .
     1202   end.
     1203   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1204   do while v-found = no and jj < 2:
     1205     if v-range <> 3 then do:
     1206       find first buf_gds-grp-obj no-lock
     1207           where buf_gds-grp-obj.node-code = p-node-code
     1208             and buf_gds-grp-obj.host-code = v-host-code
     1209             and buf_gds-grp-obj.obj-type  = p-obj-type
     1210             and buf_gds-grp-obj.obj-code  = p-obj-code
     1211       no-error .
     1212     end.
     1213     if v-range = 3 or not available buf_gds-grp-obj
     1214     then do:
     1215        if v-range <> 2 then do:
     1216           find first buf_gds-grp-obj no-lock
     1217               where buf_gds-grp-obj.node-code = p-node-code
     1218                 and buf_gds-grp-obj.host-code = v-host-code
     1219                 and buf_gds-grp-obj.obj-type  = ""
     1220                 and buf_gds-grp-obj.obj-code  = 0
     1221           no-error .
     1222         end.
     1223         if v-range = 2 or not available buf_gds-grp-obj
     1224         then do:
     1225             if v-range <> 1 then do:
     1226               find first buf_gds-grp-obj no-lock
     1227                   where buf_gds-grp-obj.node-code = p-node-code
     1228                   and buf_gds-grp-obj.host-code = 0
     1229                   and buf_gds-grp-obj.obj-type  = ""
     1230                   and buf_gds-grp-obj.obj-code  = 0
     1231               no-error .
     1232             end.
     1233             if v-range = 1 or not available buf_gds-grp-obj
     1234             then do:
     1235                 assign
     1236                     v-exists = no
     1237                 .
     1238             end.
     1239             else do:
     1240                 assign
     1241                     v-exists = yes
     1242                     v-range = 1
     1243                 .
     1244             end.
     1245         end.
     1246         else do:
     1247             assign
     1248                 v-exists = yes
     1249                 v-range  = 2
     1250             .
     1251         end.
     1252     end.
     1253     else do:
     1254         assign
     1255             v-exists = yes
     1256             v-range  = 3
     1257         .
     1258     end.
     1259     if available buf_gds-grp-obj
     1260     then do:
     1261       find first buf_gds-grp-obj-attr no-lock
     1262         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1263           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1264           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1265           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1266           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1267         no-error .
     1268       if available buf_gds-grp-obj-attr then do:
     1269         assign
     1270           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1271         .
     1272       end.
     1273       else do:
     1274         assign
     1275           v-notcorr-value = ?
     1276         .
     1277       end.
     1278       assign
     1279       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1280                           then yes
     1281                           else p-exists-notcorr)
     1282       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1283                         then v-range
     1284                         else p-range-notcorr
     1285       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1286                         then v-notcorr-value
     1287                         else p-notcorr
     1288       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1289       jj = jj + 1
     1290       .
     1291     end.
     1292     else do:
     1293       assign
     1294       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1295       jj = jj + 1
     1296       .
     1297     end.
     1298   end.
     1299   end.
     1300   end procedure.
     1301   define variable updated      as logical   no-undo .
     1302   DEFINE VARIABLE added        as logical   no-undo .
     1303   define variable add-option   as character no-undo .
     1304   define variable ini-title    as character no-undo .
     1305   define variable temp-doc-rec as recid     no-undo .
     1306   define variable dops         as character no-undo .
     1307   define variable dopst        as character no-undo .
     1308   define variable v-tab-order  as character no-undo .
     1309   define variable alco-val-log as logical   no-undo .
     1310   define buffer buf_db for ub.db.
     1311   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1312   define new shared temp-table gds-list no-undo like ub.goods
     1313     field qnty   as decimal
     1314     field to-del as logical
     1315     field order-num as integer
     1316     field to-sel as logical
     1317     field promo-code as character
     1318     field ActionId  as int64
     1319     field db-num as integer
     1320     index art  is primary unique artic prod-type prod-code
     1321     index code is         unique gds-code
     1322     index oi order-num
     1323     index isel to-sel
     1324     .
     1325   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1326   define  new shared  temp-table gds-list-hist no-undo
     1327   field list-table as character
     1328   field id as integer
     1329   field line as integer
     1330   field hist-mode as character
     1331   field des as character
     1332   field num-recs as integer
     1333   field option_ as character
     1334   field item_ as character
     1335   field status_ as character
     1336   field num-add as integer
     1337   field num-ignored as integer
     1338   field done as logical
     1339   field err_ as logical
     1340   field err-mes as character
     1341   index pi is primary
     1342   id
     1343   line
     1344   index isdone
     1345   done
     1346   .
     1347   DEFINE MENU MENU-b-add .
     1348   DEFINE BUTTON b-add
     1349        LABEL "&Добавить":L
     1350        SIZE 10 BY 1 TOOLTIP "Добавить атрибут товара".
     1351   DEFINE BUTTON b-chg
     1352        LABEL "&Изменить":L
     1353        SIZE 10 BY 1 TOOLTIP "Изменить атрибут товара".
     1354   DEFINE BUTTON b-del
     1355        LABEL "&Удалить":L
     1356        SIZE 10 BY 1 TOOLTIP "Удалить атрибут товара".
     1357   DEFINE BUTTON B-exit AUTO-GO
     1358        LABEL "&Ввод"
     1359        SIZE 10 BY 1 TOOLTIP "Выход с сохранением".
     1360   DEFINE BUTTON b-help
     1361        LABEL "Помо&щь":L
     1362        SIZE 3 BY 1.
     1363   DEFINE BUTTON b-lkp
     1364        LABEL "&Просмотр"
     1365        SIZE 10 BY 1.
     1366   DEFINE BUTTON b-quit AUTO-END-KEY
     1367        LABEL "&Отмена":L
     1368        SIZE 10 BY 1 TOOLTIP "Выход из режима".
     1369   DEFINE VARIABLE goods-artic AS CHARACTER FORMAT "X(16)":U
     1370         VIEW-AS TEXT
     1371        SIZE 16.4 BY 1
     1372        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1373   DEFINE VARIABLE Goods-dsc-name AS CHARACTER FORMAT "X(60)":U
     1374         VIEW-AS TEXT
     1375        SIZE 61.6 BY 1
     1376        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1377   DEFINE VARIABLE goods-gds-code AS INTEGER FORMAT ">>>>>>>>>>":U INITIAL 0
     1378         VIEW-AS TEXT
     1379        SIZE 11 BY 1
     1380        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1381   DEFINE VARIABLE goods-prod-code AS INTEGER FORMAT ">>>>>>>>>":U INITIAL 0
     1382         VIEW-AS TEXT
     1383        SIZE 9.6 BY 1
     1384        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1385   DEFINE VARIABLE goods-prod-name AS CHARACTER FORMAT "X(60)":U
     1386         VIEW-AS TEXT
     1387        SIZE 46.8 BY 1
     1388        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1389   DEFINE VARIABLE goods-prod-type AS CHARACTER FORMAT "X(3)":U
     1390         VIEW-AS TEXT
     1391        SIZE 3.8 BY 1
     1392        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1393   DEFINE QUERY br-attr FOR
     1394         temp-attr SCROLLING.
     1395   DEFINE BROWSE br-attr
     1396     QUERY br-attr DISPLAY
     1397         temp-attr.attr-code COLUMN-LABEL "Атрибут" FORMAT "X(50)":U
     1398         temp-attr.attr-value COLUMN-LABEL "Значение" FORMAT "X(255)":U width 48
     1399       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.8 BY 15.33.
     1400   DEFINE FRAME Dialog-Frame
     1401        B-exit AT ROW 1 COL 1
     1402        b-quit AT ROW 1 COL 11
     1403        b-add AT ROW 1 COL 21
     1404        b-lkp AT ROW 1 COL 31
     1405        b-chg AT ROW 1 COL 41
     1406        b-del AT ROW 1 COL 51
     1407        b-help AT ROW 1 COL 95
     1408        br-attr AT ROW 4.47 COL 1
     1409        goods-artic AT ROW 2.13 COL 1.9 NO-LABEL
     1410        Goods-dsc-name AT ROW 2.13 COL 19 NO-LABEL
     1411        goods-gds-code AT ROW 3.3 COL 1.8 NO-LABEL
     1412        goods-prod-type AT ROW 3.3 COL 19 NO-LABEL
     1413        goods-prod-code AT ROW 3.3 COL 23.4 NO-LABEL
     1414        goods-prod-name AT ROW 3.3 COL 33.8 NO-LABEL
     1415        SPACE(19.15) SKIP(17.89)
     1416       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1417            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1418            TITLE "Атрибуты товара".
     1419   ASSIGN
     1420          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1421          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1422   ASSIGN
     1423      b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE.
     1424   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1425   DO:
     1426     APPLY "END-ERROR":U TO SELF.
     1427   END.
     1428   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1429   DO:
     1430     define buffer buf_temp-attr for temp-attr.
     1431     if add-option = "" then do:
     1432          run gbl/pop-up.p ( input self:handle, input no) no-error.
     1433     end.
     1434     if add-option = "":U then return no-apply.
     1435     run proc-add-chg in this-procedure ( input yes ) no-error.
     1436     if error-status:error then do:
     1437       add-option = "":U.
     1438       return no-apply.
     1439     end.
     1440     OPEN QUERY br-attr FOR EACH temp-attr no-lock where temp-attr.fdisable ne yes.
     1441     apply "VALUE-CHANGED" to br-attr IN frame Dialog-Frame.
     1442     find first buf_temp-attr no-lock where
     1443                buf_temp-attr.code = add-option no-error.
     1444     add-option = "":U.
     1445     if avail buf_temp-attr then
     1446         temp-doc-rec = recid(buf_temp-attr).
     1447         else temp-doc-rec = ?.
     1448     reposition br-attr to recid temp-doc-rec no-error.
     1449     if error-status:error then return no-apply.
     1450   END.
     1451   ON ROW-DISPLAY OF br-attr IN FRAME Dialog-Frame
     1452   DO:
     1453      define buffer buf_temp-attr for temp-attr.
     1454      define variable vColor as integer no-undo.
     1455      if available (temp-attr)
     1456      then do:
     1457         if temp-attr.grp eq no
     1458         then
     1459            find first buf_temp-attr where buf_temp-attr.gds-code  eq temp-attr.gds-code
     1460                                       and buf_temp-attr.attr-code eq temp-attr.attr-code
     1461                                       and buf_temp-attr.grp       ne temp-attr.grp
     1462            no-lock no-error.
     1463         vColor = if temp-attr.grp
     1464                  then GRAY_COLOR
     1465                  else if available buf_temp-attr
     1466                  then (if buf_temp-attr.attr-value eq temp-attr.attr-value
     1467                       then LIGHT_RED_COLOR
     1468                       else DARK_GREY_COLOR)
     1469                  else BLACK_COLOR.
     1470         temp-attr.attr-value:fGCOLOR in browse br-attr = vColor.
     1471         temp-attr.attr-code:fGCOLOR in browse br-attr = vColor.
     1472      end.
     1473   end.
     1474   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1475   DO:
     1476     if not avail temp-attr then return no-apply.
     1477     run proc-add-chg in this-procedure ( input no) no-error .
     1478     if error-status:error then return no-apply.
     1479     OPEN QUERY br-attr FOR EACH temp-attr no-lock where temp-attr.fdisable ne yes.
     1480   END.
     1481   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1482   DO:
     1483     define buffer buf_temp-attr for temp-attr.
     1484     define variable loc#log             as logical   no-undo .
     1485     define variable attr-type           as character no-undo .
     1486     define variable attr-format         as character no-undo .
     1487     define variable attr-label          as character no-undo .
     1488     define variable attr-user-can-edit  as logical   no-undo .
     1489     define variable attr-output-display as logical   no-undo .
     1490     define variable attr-other          as character no-undo .
     1491     define variable jj                  as integer   no-undo .
     1492     define variable v-check             as character no-undo .
     1493     define variable v-correct           as logical   no-undo .
     1494     define variable v-error-code        as character no-undo .
     1495     if not available temp-attr then return no-apply.
     1496     if temp-attr.code = 'mercur_FGIS':U then
     1497     do:
     1498       define variable ii             as integer   no-undo .
     1499       define variable gdsMercsubsObj as class     gdsmercsubs.
     1500       define variable gdsmercstrObj  as class     gdsmercstr.
     1501       define variable gdsMercObj     as class     gdsmercsub.
     1502       define VARIABLE f-guid         as character no-undo .
     1503       gdsMercsubsObj = new gdsmercsubs ().
     1504       gdsmercstrObj = new gdsmercstr ().
     1505       gdsMercsubsObj = gdsmercstrObj:getgdsmercs(p-gds-code).
     1506       if VALID-OBJECT (gdsMercsubsObj:GdsMercsubsCurr) then
     1507       do:
     1508         do ii = 1 to gdsMercsubsObj:GetItem (ii):
     1509           gdsMercObj = gdsMercsubsObj:GdsMercsubsCurr.
     1510           assign
     1511             f-guid = gdsMercObj:GUID_
     1512             .
     1513         end.
     1514       end.
     1515       if f-guid <> "" then
     1516       do:
     1517         message
     1518           "Необходимо удалить синхронизацию товара с Меркурием" skip
     1519           view-as alert-box error .
     1520         return NO-APPLY .
     1521       end.
     1522     end.
     1523     if temp-attr.code = 'item-matter-mark':U then
     1524     do:
     1525       message
     1526         "Атрибут нельзя удалить"
     1527         view-as alert-box error .
     1528       return no-apply.
     1529     end.
     1530     run gds-attr-name in this-procedure (
     1531       input  temp-attr.code
     1532       ,output attr-type
     1533       ,output attr-format
     1534       ,output attr-label
     1535       ,output attr-user-can-edit
     1536       ,output attr-output-display
     1537       ,output attr-other
     1538       ) no-error .
     1539     if error-status :error then
     1540     do:
     1541       return no-apply .
     1542     end.
     1543     if not attr-user-can-edit then
     1544     do:
     1545       message
     1546         "Атрибут нельзя удалить вручную"
     1547         view-as alert-box error .
     1548       return no-apply.
     1549     end.
     1550     do jj = 1 to num-entries(attr-other, chr(47)):
     1551       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then
     1552       do:
     1553         assign
     1554           v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     1555           .
     1556       end.
     1557     end.
     1558     if v-check <> "":U then
     1559     do:
     1560       run value(v-check) (
     1561         input p-gds-code
     1562         ,input temp-attr.code
     1563         ,input attr-value
     1564         ,input 'удаление':U
     1565         ,output v-correct
     1566         ,output v-error-code) no-error.
     1567       if error-status:error then
     1568       do:
     1569         message
     1570           "Ошибка при проверке корректности удаления атрибута" skip
     1571           error-status:get-message(1) skip
     1572           return-value
     1573           view-as alert-box error .
     1574         undo, return no-apply .
     1575       end.
     1576       if not v-correct then
     1577       do:
     1578         message
     1579           "Удаление атрибута некорректно" skip
     1580           return-value
     1581           view-as alert-box error .
     1582         undo, return no-apply .
     1583       end.
     1584     end.
     1585     loc#log = no.
     1586     message
     1587       "Вы уверены, что хотите удалить атрибут " temp-attr.attr-code skip
     1588       " для товара " goods-dsc-name
     1589       view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     1590     if NOT loc#log then return no-apply.
     1591           if temp-attr.grp then
     1592         do:
     1593            define buffer bf_temp-attr for temp-attr .
     1594            find first buf_temp-attr where buf_temp-attr.gds-code eq temp-attr.gds-code
     1595               and buf_temp-attr.code     eq temp-attr.code
     1596               and buf_temp-attr.grp no-error.
     1597            if available buf_temp-attr
     1598               then
     1599               buf_temp-attr.fdisable = no.
     1600            create bf_temp-attr.
     1601            buffer-copy buf_temp-attr except buf_temp-attr.grp buf_temp-attr.attr-value buf_temp-attr.value_ to bf_temp-attr .
     1602            bf_temp-attr.fdisable = true .
     1603            delete temp-attr.
     1604         end.
     1605         else
     1606         do:
     1607            find first buf_temp-attr where buf_temp-attr.gds-code eq temp-attr.gds-code
     1608               and buf_temp-attr.code     eq temp-attr.code
     1609               and buf_temp-attr.grp no-error.
     1610            if available buf_temp-attr
     1611               then
     1612               buf_temp-attr.fdisable = no.
     1613            delete temp-attr.
     1614         end.
     1615     updated = yes.
     1616     OPEN QUERY br-attr FOR EACH temp-attr no-lock where temp-attr.fdisable ne yes.
     1617     apply "VALUE-CHANGED" to br-attr IN frame Dialog-Frame.
     1618   END.
     1619   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1620   DO:
     1621      RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1622     IF ERROR-STATUS:ERROR THEN DO:
     1623        RETURN NO-APPLY.
     1624     END.
     1625   END.
     1626   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1627   DO:
     1628     if not avail temp-attr then return no-apply.
     1629     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     1630     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1631   END.
     1632   ON MOUSE-SELECT-DBLCLICK OF br-attr IN FRAME Dialog-Frame
     1633   DO:
     1634     if not avail temp-attr then return no-apply.
     1635     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     1636     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1637   END.
     1638   ON VALUE-CHANGED OF br-attr IN FRAME Dialog-Frame
     1639   DO:
     1640      if p-mode ne 'ПРОСМОТР':U
     1641      then do:
     1642         b-chg:visible = available temp-attr and not temp-attr.grp.
     1643         b-del:visible = available temp-attr and not temp-attr.grp.
     1644      end.
     1645   END.
     1646   ON RETURN OF br-attr IN FRAME Dialog-Frame
     1647   DO:
     1648     if not avail temp-attr then return no-apply.
     1649     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     1650     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1651   END.
     1652   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1653   on help of frame Dialog-Frame
     1654   do:
     1655     run gbl/app_help.p
     1656       (input this-procedure :file-name
     1657       ,input ''
     1658       ,input ?
     1659       ) no-error.
     1660     if error-status :error then do:
     1661       message
     1662         "Ошибка при вызове помощи"
     1663         error-status :get-message(1)
     1664         view-as alert-box .
     1665     end.
     1666   end.
     1667   run minbtn-set in this-procedure .
     1668   on choose of b-help in frame Dialog-Frame
     1669   do:
     1670     apply "help":u to frame Dialog-Frame .
     1671   end.
     1672   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1673   procedure minbtn-set :
     1674       do
     1675           on error undo, return error return-value
     1676           :
     1677           define variable ii              as integer       no-undo .
     1678           define variable fh              as widget-handle no-undo .
     1679           define variable hh              as widget-handle no-undo .
     1680           define variable v-h             as handle        extent 4 no-undo .
     1681           define variable v-name-button   as character     no-undo .
     1682           define variable v-help-old-x    as decimal       no-undo .
     1683           define variable v-help-old-y    as decimal       no-undo .
     1684           define variable v-help-old-size as decimal       no-undo .
     1685           define variable v-frame-width   as decimal       no-undo .
     1686           define variable jj              as integer       no-undo .
     1687           do
     1688               on error undo, return error
     1689               :
     1690               assign
     1691                   v-frame-width = frame Dialog-Frame:width - 0.3
     1692                   fh            = frame Dialog-Frame:first-child
     1693                   hh            = fh:first-child
     1694                   ii            = 1
     1695                   .
     1696               do while valid-handle(hh):
     1697                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1698                   do:
     1699                       case lc(hh:name) :
     1700                           when "b-help" then
     1701                               do:
     1702                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1703                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1704                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1705                                   hh:TOOLTIP = "Помощь" .
     1706                                   v-help-old-x = hh:column .
     1707                                   v-help-old-y = hh:row    .
     1708                                   v-help-old-size = hh:width .
     1709                                   hh:width-chars = 2.5 .
     1710                               end.
     1711                           when "b-print" then
     1712                               do:
     1713                                   hh:load-image("cmp/b-print.bmp":u) .
     1714                                   hh:TOOLTIP = "Печать" .
     1715                                   v-h[ii] = hh:handle .
     1716                                   ii = ii + 1 .
     1717                                   hh:width-chars = 3 .
     1718                               end.
     1719                           when "b-history" or
     1720                           when "b-hist" then
     1721                               do:
     1722                                   hh:load-image("cmp/b-hist.bmp":u) .
     1723                                   hh:TOOLTIP = "История" .
     1724                                   v-h[ii] = hh:handle .
     1725                                   ii = ii + 1 .
     1726                                   hh:width-chars = 3 .
     1727                               end.
     1728                           when "b-sch" then
     1729                               do:
     1730                                   hh:load-image("cmp/b-sch.bmp":u) .
     1731                                   hh:TOOLTIP = "Установка Фильтра" .
     1732                                   v-h[ii] = hh:handle .
     1733                                   ii = ii + 1 .
     1734                                   hh:width-chars = 3 .
     1735                               end.
     1736                           when "b-hist-user" then
     1737                               do:
     1738                                   hh:load-image("cmp/b-hist.bmp":u) .
     1739                                   hh:TOOLTIP = "История пользователя" .
     1740                                   ii = ii + 1 .
     1741                               end.
     1742                       end case.
     1743                   end.
     1744                   hh = hh:next-sibling.
     1745               end.
     1746               b-help:column = v-frame-width - b-help:width-chars.
     1747               jj = 0.
     1748               repeat ii = 4 to 1 by -1 :
     1749                   if valid-handle (v-h[ii] ) then
     1750                   do:
     1751                       jj  = jj + 1 .
     1752                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1753                       v-h[ii]:row    = v-help-old-y .
     1754                   end.
     1755               end.
     1756           end.
     1757       end.
     1758   end procedure.
     1759   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1760   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1761   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1762   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1763   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1764   define variable v-diasize-current-frame-height as decimal   no-undo .
     1765   define variable v-diasize-change-size          as logical   no-undo .
     1766   define variable v-diasize-resize-button        as handle    no-undo .
     1767   define variable v-diasize-wndmax               as logical   no-undo .
     1768   define variable v-diasize-wndstore             as logical   no-undo .
     1769   define variable v-diasize-proc-name            as character no-undo .
     1770   define variable v-diasize-browse-handle        as handle    no-undo .
     1771   define variable v-diasize-browse-number        as integer   no-undo .
     1772   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1773   define temp-table temp-diasize-handle no-undo
     1774     field handle-value  as handle
     1775     field save-position as decimal
     1776     index xpk is primary unique handle-value
     1777     .
     1778   define temp-table temp-browse-handle no-undo
     1779     field browse-type   as character
     1780     field browse-number as integer
     1781     field browse-handle as handle
     1782     field original-size as decimal
     1783     index xpk is primary unique browse-type browse-number
     1784     index xie browse-type browse-handle
     1785   .
     1786   procedure diasize_change-height :
     1787     define input  parameter p-change-value  as decimal   no-undo .
     1788     define input  parameter p-move-resize   as logical   no-undo .
     1789     define variable v-field-group-handle    as handle    no-undo .
     1790     define variable v-object-handle         as handle    no-undo .
     1791     define variable v-frame-height          as decimal   no-undo .
     1792     define variable v-frame-virtual-height  as decimal   no-undo .
     1793     define variable v-browse-height         as decimal   no-undo .
     1794     define variable v-window-height         as decimal   no-undo .
     1795     define variable v-window-virtual-height as decimal   no-undo .
     1796     define variable v-change-sign           as integer   no-undo .
     1797     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1798     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1799     if p-change-value > 0
     1800     then do:
     1801       if frame Dialog-Frame :height + p-change-value
     1802           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1803       then do:
     1804         assign
     1805           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1806                           - (frame Dialog-Frame :height-chars)
     1807         .
     1808         if p-change-value <= 0
     1809         then do:
     1810           run diasize_position-resize-button in this-procedure .
     1811           return .
     1812         end.
     1813       end.
     1814     end.
     1815     if p-change-value < 0
     1816     then do:
     1817       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1818       then do:
     1819         assign
     1820           p-change-value = v-diasize-orig-frame-height
     1821                          - (frame Dialog-Frame :height-chars)
     1822         .
     1823         if p-change-value >= 0
     1824         then do:
     1825           run diasize_position-resize-button in this-procedure .
     1826           return .
     1827         end.
     1828       end.
     1829     end.
     1830     if p-change-value >= 0
     1831     then do:
     1832       assign
     1833         v-change-sign = 1
     1834       .
     1835     end.
     1836     else do:
     1837       assign
     1838         v-change-sign = -1
     1839       .
     1840     end.
     1841     assign
     1842       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1843     .
     1844     if p-change-value = 0
     1845     then do:
     1846       run diasize_position-resize-button in this-procedure .
     1847       return .
     1848     end.
     1849     move_block:
     1850     do
     1851     on error undo move_block, retry move_block
     1852     :
     1853       if retry
     1854       then do:
     1855         do
     1856         on error undo move_block, leave move_block
     1857         :
     1858           if p-change-value > 0
     1859           then do:
     1860             for each buf_temp-diasize-handle
     1861             on error undo, next
     1862             :
     1863               assign
     1864                 v-object-handle = buf_temp-diasize-handle.handle-value
     1865               .
     1866               if v-object-handle <> v-diasize-resize-button
     1867               then do:
     1868                 assign
     1869                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1870                 .
     1871               end.
     1872             end.
     1873             assign
     1874               v-diasize-browse-handle :height = v-browse-height
     1875             .
     1876             for each buf_temp-browse-handle
     1877               where buf_temp-browse-handle.browse-type = 'height':u
     1878             on error undo, next
     1879             :
     1880               assign
     1881                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1882               .
     1883             end.
     1884             assign
     1885               frame Dialog-Frame :height = v-frame-height
     1886             .
     1887             if frame Dialog-Frame :scrollable = true
     1888             then do:
     1889               assign
     1890                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1891               .
     1892             end.
     1893             run diasize_position-resize-button in this-procedure .
     1894           end.
     1895           else do:
     1896             if frame Dialog-Frame :scrollable = true
     1897             then do:
     1898               assign
     1899                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1900               .
     1901             end.
     1902             assign
     1903               frame Dialog-Frame :height = v-frame-height
     1904             .
     1905             assign
     1906               v-diasize-browse-handle :height = v-browse-height
     1907             .
     1908             for each buf_temp-browse-handle
     1909               where buf_temp-browse-handle.browse-type = 'height':u
     1910             on error undo, next
     1911             :
     1912               assign
     1913                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1914               .
     1915             end.
     1916             for each buf_temp-diasize-handle
     1917             on error undo, next
     1918             :
     1919               assign
     1920                 v-object-handle = buf_temp-diasize-handle.handle-value
     1921               .
     1922               if v-object-handle <> v-diasize-resize-button
     1923               then do:
     1924                 assign
     1925                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1926                 .
     1927               end.
     1928             end.
     1929             run diasize_position-resize-button in this-procedure .
     1930           end.
     1931           assign
     1932             v-diasize-change-size = false
     1933           .
     1934           leave move_block .
     1935         end.
     1936       end.
     1937       assign
     1938         v-diasize-need-full-display = true
     1939       .
     1940       if v-diasize-change-size = false
     1941       then do:
     1942         assign
     1943           v-diasize-change-size = true
     1944         .
     1945       end.
     1946       else do:
     1947         return .
     1948       end.
     1949       assign
     1950         v-frame-height = frame Dialog-Frame :height
     1951         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1952         v-browse-height = v-diasize-browse-handle :height
     1953       .
     1954       for each buf_temp-browse-handle
     1955         where buf_temp-browse-handle.browse-type = 'height':u
     1956       :
     1957         assign
     1958           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1959         .
     1960       end.
     1961       for each buf_temp-diasize-handle
     1962       :
     1963         delete buf_temp-diasize-handle .
     1964       end.
     1965       assign
     1966         v-field-group-handle = frame Dialog-Frame :first-child
     1967       .
     1968       do while valid-handle(v-field-group-handle)
     1969       :
     1970         assign
     1971           v-object-handle = v-field-group-handle :first-child
     1972         .
     1973         do while valid-handle(v-object-handle)
     1974         :
     1975           if  v-object-handle <> v-diasize-browse-handle :handle
     1976           and can-query(v-object-handle, "row")
     1977           and can-query(v-object-handle, "height")
     1978           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1979           then do:
     1980             find first buf_temp-browse-handle
     1981               where buf_temp-browse-handle.browse-type   = 'height':u
     1982                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1983               no-error .
     1984             if available buf_temp-browse-handle
     1985             then do:
     1986             end.
     1987             else do:
     1988               create buf_temp-diasize-handle .
     1989               assign
     1990                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1991                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1992               .
     1993             end.
     1994           end.
     1995           assign
     1996             v-object-handle = v-object-handle :next-sibling
     1997           .
     1998         end.
     1999         assign
     2000           v-field-group-handle = v-field-group-handle :next-sibling
     2001         .
     2002       end.
     2003       do with frame Dialog-Frame
     2004       :
     2005         hide v-diasize-resize-button .
     2006         assign
     2007           v-diasize-resize-button :row    = 1
     2008           v-diasize-resize-button :column = 1
     2009         .
     2010       end.
     2011       if p-change-value > 0
     2012       then do:
     2013         if frame Dialog-Frame :scrollable = true
     2014         then do:
     2015           assign
     2016             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2017             no-error .
     2018           if error-status :error
     2019           or error-status :get-message(1) <> ""
     2020           then do:
     2021             undo move_block, retry move_block .
     2022           end.
     2023         end.
     2024         assign
     2025           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2026           no-error .
     2027         if error-status :error
     2028         or error-status :get-message(1) <> ""
     2029         then do:
     2030           undo move_block, retry move_block .
     2031         end.
     2032         assign
     2033           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2034           no-error .
     2035         if error-status :error
     2036         or error-status :get-message(1) <> ""
     2037         then do:
     2038           undo move_block, retry move_block .
     2039         end.
     2040         for each buf_temp-browse-handle
     2041           where buf_temp-browse-handle.browse-type = 'height':u
     2042         on error undo move_block, retry move_block
     2043         :
     2044           assign
     2045             buf_temp-browse-handle.browse-handle :height
     2046               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2047             no-error .
     2048           if error-status :error
     2049           or error-status :get-message(1) <> ""
     2050           then do:
     2051             undo move_block, retry move_block .
     2052           end.
     2053         end.
     2054         for each buf_temp-diasize-handle
     2055         on error undo move_block, retry move_block
     2056         :
     2057           assign
     2058             v-object-handle = buf_temp-diasize-handle.handle-value
     2059           .
     2060           if v-object-handle <> v-diasize-resize-button
     2061           then do:
     2062             assign
     2063               v-object-handle :row = v-object-handle :row + p-change-value
     2064               no-error .
     2065             if error-status :error
     2066             or error-status :get-message(1) <> ""
     2067             then do:
     2068               undo move_block, retry move_block .
     2069             end.
     2070           end.
     2071         end.
     2072       end.
     2073       else do:
     2074         for each buf_temp-diasize-handle
     2075         on error undo move_block, retry move_block
     2076         :
     2077           assign
     2078             v-object-handle = buf_temp-diasize-handle.handle-value
     2079           .
     2080           if v-object-handle <> v-diasize-resize-button
     2081           then do:
     2082             assign
     2083               v-object-handle :row = v-object-handle :row + p-change-value
     2084               no-error .
     2085             if error-status :error
     2086             or error-status :get-message(1) <> ""
     2087             then do:
     2088               undo move_block, retry move_block .
     2089             end.
     2090           end.
     2091         end.
     2092         assign
     2093           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2094           no-error .
     2095         if error-status :error
     2096         or error-status :get-message(1) <> ""
     2097         then do:
     2098           undo move_block, retry move_block .
     2099         end.
     2100         for each buf_temp-browse-handle
     2101           where buf_temp-browse-handle.browse-type = 'height':u
     2102         on error undo move_block, retry move_block
     2103         :
     2104           assign
     2105             buf_temp-browse-handle.browse-handle :height
     2106               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2107             no-error .
     2108           if error-status :error
     2109           or error-status :get-message(1) <> ""
     2110           then do:
     2111             undo move_block, retry move_block .
     2112           end.
     2113         end.
     2114         assign
     2115           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2116           no-error .
     2117         if error-status :error
     2118         or error-status :get-message(1) <> ""
     2119         then do:
     2120           undo move_block, retry move_block .
     2121         end.
     2122         if frame Dialog-Frame :scrollable = true
     2123         then do:
     2124           assign
     2125             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2126             no-error .
     2127           if error-status :error
     2128           or error-status :get-message(1) <> ""
     2129           then do:
     2130             undo move_block, retry move_block .
     2131           end.
     2132         end.
     2133       end.
     2134       if p-move-resize = true
     2135       then do:
     2136         run diasize_position-resize-button in this-procedure .
     2137       end.
     2138       if v-diasize-wndstore = true
     2139       then do:
     2140         if connected("ub") = true
     2141         then do:
     2142           define variable v-cntxt-db-num        as integer   no-undo .
     2143           define variable v-cntxt-userid        as character no-undo .
     2144           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2145                                             , OUTPUT v-cntxt-userid
     2146                                             ) .
     2147           run gbl/wndsizew.p
     2148             (input  v-cntxt-db-num
     2149             ,input  v-cntxt-userid
     2150             ,input  v-diasize-proc-name
     2151             ,input  'height':u
     2152             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2153             ) .
     2154         end.
     2155       end.
     2156     end.
     2157     assign
     2158       v-diasize-change-size = false
     2159     .
     2160   end procedure.
     2161   procedure diasize_set-height :
     2162     define input  parameter p-new-height  as decimal   no-undo .
     2163     define input  parameter p-move-resize as logical   no-undo .
     2164     do
     2165     on error undo, return error return-value
     2166     :
     2167       run diasize_change-height in this-procedure
     2168         (input  (p-new-height - frame Dialog-Frame :height)
     2169         ,input  p-move-resize
     2170         ) .
     2171     end.
     2172   end procedure.
     2173   procedure diasize_change-width :
     2174     define input  parameter p-change-value as decimal   no-undo .
     2175     define input  parameter p-move-resize  as logical   no-undo .
     2176     define variable v-field-group-handle   as handle    no-undo .
     2177     define variable v-object-handle        as handle    no-undo .
     2178     define variable v-frame-width          as decimal   no-undo .
     2179     define variable v-frame-virtual-width  as decimal   no-undo .
     2180     define variable v-browse-width         as decimal   no-undo .
     2181     define variable v-window-width         as decimal   no-undo .
     2182     define variable v-window-virtual-width as decimal   no-undo .
     2183     define variable v-change-sign          as integer   no-undo .
     2184     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2185     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2186     if p-change-value > 0
     2187     then do:
     2188       if frame Dialog-Frame :width + p-change-value >
     2189           session :width-chars
     2190       then do:
     2191         assign
     2192           p-change-value = session :width-chars - frame Dialog-Frame :width
     2193         .
     2194         if p-change-value <= 0
     2195         then do:
     2196           run diasize_position-resize-button in this-procedure .
     2197           return .
     2198         end.
     2199       end.
     2200     end.
     2201     if p-change-value < 0
     2202     then do:
     2203       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2204       then do:
     2205         assign
     2206           p-change-value = v-diasize-orig-frame-width
     2207                          - frame Dialog-Frame :width
     2208         .
     2209         if p-change-value >= 0
     2210         then do:
     2211           run diasize_position-resize-button in this-procedure .
     2212           return .
     2213         end.
     2214       end.
     2215     end.
     2216     if p-change-value >= 0
     2217     then do:
     2218       assign
     2219         v-change-sign = 1
     2220       .
     2221     end.
     2222     else do:
     2223       assign
     2224         v-change-sign = -1
     2225       .
     2226     end.
     2227     assign
     2228       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2229     .
     2230     if p-change-value = 0
     2231     then do:
     2232       run diasize_position-resize-button in this-procedure .
     2233       return .
     2234     end.
     2235     move_block:
     2236     do
     2237     on error undo move_block, leave move_block
     2238     :
     2239       if retry
     2240       then do:
     2241         do
     2242         on error undo move_block, leave move_block
     2243         :
     2244           if p-change-value > 0
     2245           then do:
     2246             for each buf_temp-diasize-handle
     2247             on error undo, next
     2248             :
     2249               assign
     2250                 v-object-handle = buf_temp-diasize-handle.handle-value
     2251               .
     2252               if v-object-handle <> v-diasize-resize-button
     2253               then do:
     2254                 assign
     2255                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2256                 .
     2257               end.
     2258             end.
     2259             assign
     2260               v-diasize-browse-handle :width = v-browse-width
     2261             .
     2262             for each buf_temp-browse-handle
     2263               where buf_temp-browse-handle.browse-type = 'width':u
     2264             on error undo, next
     2265             :
     2266               assign
     2267                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2268               .
     2269             end.
     2270             assign
     2271               frame Dialog-Frame :width = v-frame-width
     2272             .
     2273             if frame Dialog-Frame :scrollable = true
     2274             then do:
     2275               assign
     2276                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2277               .
     2278             end.
     2279             run diasize_position-resize-button in this-procedure .
     2280           end.
     2281           else do:
     2282             if frame Dialog-Frame :scrollable = true
     2283             then do:
     2284               assign
     2285                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2286               .
     2287             end.
     2288             assign
     2289               frame Dialog-Frame :width = v-frame-width
     2290             .
     2291             for each buf_temp-browse-handle
     2292               where buf_temp-browse-handle.browse-type = 'width':u
     2293             on error undo, next
     2294             :
     2295               assign
     2296                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2297               .
     2298             end.
     2299             assign
     2300               v-diasize-browse-handle :width = v-browse-width
     2301             .
     2302             for each buf_temp-diasize-handle
     2303             on error undo, next
     2304             :
     2305               assign
     2306                 v-object-handle = buf_temp-diasize-handle.handle-value
     2307               .
     2308               if v-object-handle <> v-diasize-resize-button
     2309               then do:
     2310                 assign
     2311                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2312                 .
     2313               end.
     2314             end.
     2315             run diasize_position-resize-button in this-procedure .
     2316           end.
     2317           assign
     2318             v-diasize-change-size = false
     2319           .
     2320           leave move_block .
     2321         end.
     2322       end.
     2323       assign
     2324         v-diasize-need-full-display = true
     2325       .
     2326       if v-diasize-change-size = false
     2327       then do:
     2328         assign
     2329           v-diasize-change-size = true
     2330         .
     2331       end.
     2332       else do:
     2333         return .
     2334       end.
     2335       assign
     2336         v-frame-width = frame Dialog-Frame :width
     2337         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2338         v-browse-width = v-diasize-browse-handle :width
     2339       .
     2340       for each buf_temp-browse-handle
     2341         where buf_temp-browse-handle.browse-type = 'width':u
     2342       :
     2343         assign
     2344           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2345         .
     2346       end.
     2347       for each buf_temp-diasize-handle
     2348       :
     2349         delete buf_temp-diasize-handle .
     2350       end.
     2351       assign
     2352         v-field-group-handle = frame Dialog-Frame :first-child
     2353       .
     2354       do while valid-handle(v-field-group-handle)
     2355       :
     2356         assign
     2357           v-object-handle = v-field-group-handle :first-child
     2358         .
     2359         do while valid-handle(v-object-handle)
     2360         :
     2361           if  v-object-handle <> v-diasize-browse-handle :handle
     2362           and v-object-handle <> v-diasize-resize-button
     2363           and can-query(v-object-handle, "row")
     2364           and can-query(v-object-handle, "height")
     2365           and ( v-object-handle :col + v-object-handle :width
     2366                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2367               )
     2368           then do:
     2369             find first buf_temp-browse-handle
     2370               where buf_temp-browse-handle.browse-type   = 'width':u
     2371                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2372               no-error .
     2373             if available buf_temp-browse-handle
     2374             then do:
     2375             end.
     2376             else do:
     2377               create buf_temp-diasize-handle .
     2378               assign
     2379                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2380                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2381               .
     2382             end.
     2383           end.
     2384           assign
     2385             v-object-handle = v-object-handle :next-sibling
     2386           .
     2387         end.
     2388         assign
     2389           v-field-group-handle = v-field-group-handle :next-sibling
     2390         .
     2391       end.
     2392       do with frame Dialog-Frame
     2393       :
     2394         hide v-diasize-resize-button .
     2395         v-diasize-resize-button :row = 1.
     2396         v-diasize-resize-button :column = 1.
     2397       end.
     2398       if p-change-value > 0
     2399       then do:
     2400         if frame Dialog-Frame :scrollable = true
     2401         then do:
     2402           assign
     2403             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2404             no-error .
     2405           if error-status :error
     2406           or error-status :get-message(1) <> ""
     2407           then do:
     2408             undo move_block, retry move_block.
     2409           end.
     2410         end.
     2411         assign
     2412           frame Dialog-Frame :width = v-frame-width + p-change-value
     2413           no-error .
     2414         if error-status :error
     2415         or error-status :get-message(1) <> ""
     2416         then do:
     2417           undo move_block, retry move_block.
     2418         end.
     2419         assign
     2420           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2421         no-error .
     2422         if error-status :error
     2423         or error-status :get-message(1) <> ""
     2424         then do:
     2425           undo move_block, retry move_block.
     2426         end.
     2427         for each buf_temp-browse-handle
     2428           where buf_temp-browse-handle.browse-type = 'width':u
     2429         on error undo move_block, retry move_block
     2430         :
     2431           assign
     2432             buf_temp-browse-handle.browse-handle :width
     2433               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2434             no-error .
     2435           if error-status :error
     2436           or error-status :get-message(1) <> ""
     2437           then do:
     2438             undo move_block, retry move_block .
     2439           end.
     2440         end.
     2441         for each buf_temp-diasize-handle
     2442         on error undo move_block, retry move_block
     2443         :
     2444           assign
     2445             v-object-handle = buf_temp-diasize-handle.handle-value
     2446           .
     2447           if v-object-handle <> v-diasize-resize-button
     2448           then do:
     2449             assign
     2450               v-object-handle :col = v-object-handle :col + p-change-value
     2451               no-error .
     2452             if error-status :error
     2453             or error-status :get-message(1) <> ""
     2454             then do:
     2455               undo move_block, retry move_block .
     2456             end.
     2457           end.
     2458         end.
     2459       end.
     2460       else do:
     2461         for each buf_temp-diasize-handle
     2462         on error undo move_block, retry move_block
     2463         :
     2464           assign
     2465             v-object-handle = buf_temp-diasize-handle.handle-value
     2466           .
     2467           if v-object-handle <> v-diasize-resize-button
     2468           then do:
     2469             assign
     2470               v-object-handle :col = v-object-handle :col + p-change-value
     2471               no-error .
     2472             if error-status :error
     2473             or error-status :get-message(1) <> ""
     2474             then do:
     2475               undo move_block, retry move_block .
     2476             end.
     2477           end.
     2478         end.
     2479         for each buf_temp-browse-handle
     2480           where buf_temp-browse-handle.browse-type = 'width':u
     2481         on error undo move_block, retry move_block
     2482         :
     2483           assign
     2484             buf_temp-browse-handle.browse-handle :width
     2485               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2486             no-error .
     2487           if error-status :error
     2488           or error-status :get-message(1) <> ""
     2489           then do:
     2490             undo move_block, retry move_block .
     2491           end.
     2492         end.
     2493         assign
     2494           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2495           no-error .
     2496         if error-status :error
     2497         or error-status :get-message(1) <> ""
     2498         then do:
     2499           undo move_block, retry move_block.
     2500         end.
     2501         assign
     2502           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2503         no-error .
     2504         if error-status :error
     2505         or error-status :get-message(1) <> ""
     2506         then do:
     2507           undo move_block, retry move_block.
     2508         end.
     2509         if frame Dialog-Frame :scrollable = true
     2510         then do:
     2511           assign
     2512             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2513           no-error .
     2514           if error-status :error
     2515           or error-status :get-message(1) <> ""
     2516           then do:
     2517             undo move_block, retry move_block.
     2518           end.
     2519         end.
     2520       end.
     2521       if p-move-resize
     2522       then do:
     2523         run diasize_position-resize-button in this-procedure .
     2524       end.
     2525       if v-diasize-wndstore = true
     2526       then do:
     2527         if connected("ub") = true
     2528         then do:
     2529           define variable v-cntxt-db-num        as integer   no-undo .
     2530           define variable v-cntxt-userid        as character no-undo .
     2531           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2532                                             , OUTPUT v-cntxt-userid
     2533                                             ) .
     2534           run gbl/wndsizew.p
     2535             (input  v-cntxt-db-num
     2536             ,input  v-cntxt-userid
     2537             ,input  v-diasize-proc-name
     2538             ,input  'width':u
     2539             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2540             ) .
     2541         end.
     2542       end.
     2543     end.
     2544     assign
     2545       v-diasize-change-size = false
     2546     .
     2547   end procedure.
     2548   procedure diasize_set-width :
     2549     define input  parameter p-new-width  as decimal   no-undo .
     2550     define input  parameter p-move-resize as logical   no-undo .
     2551     do
     2552     on error undo, return error return-value
     2553     :
     2554       run diasize_change-width in this-procedure
     2555         (input  (p-new-width - frame Dialog-Frame :width)
     2556         ,input  p-move-resize
     2557         ) .
     2558     end.
     2559   end procedure.
     2560   procedure diasize_position-resize-button :
     2561     do with frame Dialog-Frame
     2562     :
     2563       hide v-diasize-resize-button .
     2564       assign
     2565         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2566                     - 1
     2567                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2568         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2569                     - 1
     2570                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2571       .
     2572       view v-diasize-resize-button .
     2573     end.
     2574   end procedure.
     2575   on alt-right anywhere
     2576   do:
     2577     run diasize_change-width in this-procedure
     2578       (input 1
     2579       ,input true
     2580       ) .
     2581     return no-apply .
     2582   end.
     2583   on alt-left anywhere
     2584   do:
     2585     run diasize_change-width in this-procedure
     2586       (input -1
     2587       ,input true
     2588       ) .
     2589     return no-apply .
     2590   end.
     2591   on alt-down anywhere
     2592   do:
     2593     run diasize_change-height in this-procedure
     2594       (input 1
     2595       ,input true
     2596       ) .
     2597     return no-apply .
     2598   end.
     2599   on alt-up anywhere
     2600   do:
     2601     run diasize_change-height in this-procedure
     2602       (input -1
     2603       ,input true
     2604       ) .
     2605     return no-apply .
     2606   end.
     2607   on alt-enter of frame Dialog-Frame
     2608   do:
     2609     run diasize_maximize in this-procedure
     2610       (input  ?
     2611       ).
     2612     return no-apply .
     2613   end.
     2614   procedure diasize_end-move :
     2615     do
     2616     on error undo, return error return-value
     2617     :
     2618       define variable v-row-delta as decimal   no-undo .
     2619       define variable v-col-delta as decimal   no-undo .
     2620       define variable v-new-row as decimal   no-undo .
     2621       define variable v-new-col as decimal   no-undo .
     2622       assign
     2623         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2624         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2625       .
     2626       assign
     2627         v-row-delta = v-new-row - frame Dialog-Frame :height
     2628         v-col-delta = v-new-col - frame Dialog-Frame :width
     2629       .
     2630       run diasize_change-height in this-procedure
     2631         (input v-row-delta
     2632         ,input true
     2633         ) .
     2634       run diasize_change-width in this-procedure
     2635         (input v-col-delta
     2636         ,input true
     2637         ) .
     2638     end.
     2639   end procedure.
     2640   procedure diasize_maximize :
     2641     define input  parameter p-action as logical   no-undo .
     2642     do
     2643     on error undo, return error return-value
     2644     :
     2645       if p-action = ?
     2646       then do:
     2647         if v-diasize-need-maximize = true
     2648         then do:
     2649           assign
     2650             p-action = true
     2651           .
     2652         end.
     2653         else do:
     2654           assign
     2655             p-action = false
     2656           .
     2657         end.
     2658       end.
     2659       if p-action = true
     2660       then do:
     2661         run diasize_change-height in this-procedure
     2662           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2663               - frame Dialog-Frame :height-chars
     2664           ,input true
     2665           ) .
     2666         run diasize_change-width in this-procedure
     2667           (input session :width-chars
     2668               - frame Dialog-Frame :width-chars
     2669           ,input true
     2670           ) .
     2671         assign
     2672           v-diasize-need-maximize = false
     2673         .
     2674       end.
     2675       else do:
     2676         run diasize_change-width in this-procedure
     2677           (input v-diasize-orig-frame-width
     2678               - frame Dialog-Frame :width-chars
     2679           ,input true
     2680           ) .
     2681         run diasize_change-height in this-procedure
     2682           (input v-diasize-orig-frame-height
     2683               - frame Dialog-Frame :height-chars
     2684           ,input true
     2685           ) .
     2686         assign
     2687           v-diasize-need-maximize = true
     2688         .
     2689       end.
     2690     end.
     2691   end procedure.
     2692   procedure diasize_restore-orig-size :
     2693     do
     2694     on error undo, return error return-value
     2695     :
     2696       assign
     2697         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2698         v-diasize-current-frame-height = frame Dialog-Frame :height
     2699       .
     2700       run diasize_set-height in this-procedure
     2701         (input  v-diasize-orig-frame-height
     2702         ,input  true
     2703         ) .
     2704       run diasize_set-width in this-procedure
     2705         (input  v-diasize-orig-frame-width
     2706         ,input  true
     2707         ) .
     2708     end.
     2709   end procedure.
     2710   procedure diasize_restore-current-size :
     2711     do
     2712     on error undo, return error return-value
     2713     :
     2714       run diasize_set-height in this-procedure
     2715         (input  v-diasize-current-frame-height
     2716         ,input  true
     2717         ) .
     2718       run diasize_set-width in this-procedure
     2719         (input  v-diasize-current-frame-width
     2720         ,input  true
     2721         ) .
     2722     end.
     2723   end procedure.
     2724   procedure diasize_set-browse-handle :
     2725     define input  parameter p-browse-handle as handle   no-undo .
     2726     define buffer buf_temp-browse-handle for temp-browse-handle .
     2727     do
     2728     on error undo, return error return-value
     2729     :
     2730       assign
     2731         v-diasize-browse-handle = p-browse-handle
     2732       .
     2733       for each buf_temp-browse-handle
     2734       on error undo, return error return-value
     2735       :
     2736         delete buf_temp-browse-handle .
     2737       end.
     2738     end.
     2739   end procedure.
     2740   procedure diasize_add_browse :
     2741     define input  parameter p-browse-type   as character no-undo .
     2742     define input  parameter p-browse-handle as handle    no-undo .
     2743     define buffer buf_temp-browse-handle for temp-browse-handle .
     2744     do
     2745     on error undo, return error return-value
     2746     :
     2747       assign
     2748         v-diasize-browse-number = v-diasize-browse-number + 1
     2749       .
     2750       create buf_temp-browse-handle .
     2751       assign
     2752         buf_temp-browse-handle.browse-type   = p-browse-type
     2753         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2754         buf_temp-browse-handle.browse-handle = p-browse-handle
     2755       .
     2756     end.
     2757   end procedure.
     2758   procedure diasize_init :
     2759     define variable v-default-value    as logical   no-undo .
     2760     define variable v-restore-saved    as logical   no-undo .
     2761     define variable v-resize-value-str as character no-undo .
     2762     do
     2763     on error undo, return error return-value
     2764     :
     2765       do with frame Dialog-Frame
     2766       :
     2767         assign
     2768           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2769           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2770           v-diasize-browse-handle     = browse br-attr :handle
     2771         .
     2772         create button v-diasize-resize-button
     2773         assign
     2774           parent        = frame Dialog-Frame :first-child
     2775           label         = "s"
     2776           height-pixels = 16
     2777           width-pixels  = 16
     2778           visible       = true
     2779           sensitive     = true
     2780           movable       = true
     2781           triggers:
     2782             on end-move persistent run diasize_end-move in this-procedure .
     2783           end triggers.
     2784         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2785         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2786         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2787         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2788         assign
     2789           v-diasize-wndmax = false
     2790         .
     2791         if connected("ub") = true
     2792         then do:
     2793           define variable v-cntxt-db-num        as integer   no-undo .
     2794           define variable v-cntxt-userid        as character no-undo .
     2795           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2796                                             , OUTPUT v-cntxt-userid
     2797                                             ) .
     2798           run gbl/wndpar_r.p
     2799             (input  v-cntxt-db-num
     2800             ,input  v-cntxt-userid
     2801             ,input  'wndmax':U
     2802             ,output v-diasize-wndmax
     2803             ,output v-default-value
     2804             ) .
     2805         end.
     2806         assign
     2807           v-diasize-wndstore = false
     2808         .
     2809         if connected("ub") = true
     2810         then do:
     2811           run gbl/wndpar_r.p
     2812             (input  v-cntxt-db-num
     2813             ,input  v-cntxt-userid
     2814             ,input  'wndstore':U
     2815             ,output v-diasize-wndstore
     2816             ,output v-default-value
     2817             ) .
     2818         end.
     2819         assign
     2820           v-diasize-proc-name = entry(1, program-name(2), '.')
     2821         .
     2822         if v-diasize-wndstore = true
     2823         then do:
     2824           assign
     2825             v-restore-saved = false
     2826           .
     2827           if connected("ub") = true
     2828           then do:
     2829             run gbl/wndsizer.p
     2830               (input  v-cntxt-db-num
     2831               ,input  v-cntxt-userid
     2832               ,input  v-diasize-proc-name
     2833               ,input  'height':u
     2834               ,output v-resize-value-str
     2835               ) .
     2836             if v-resize-value-str <> '':U
     2837             then do:
     2838               run diasize_change-height in this-procedure
     2839                 (input  integer(v-resize-value-str)
     2840                 ,input  true
     2841                 ) .
     2842               assign
     2843                 v-restore-saved = true
     2844               .
     2845             end.
     2846           end.
     2847           if connected("ub") = true
     2848           then do:
     2849             run gbl/wndsizer.p
     2850               (input  v-cntxt-db-num
     2851               ,input  v-cntxt-userid
     2852               ,input  v-diasize-proc-name
     2853               ,input  'width':u
     2854               ,output v-resize-value-str
     2855               ) .
     2856             if v-resize-value-str <> '':U
     2857             then do:
     2858               run diasize_change-width in this-procedure
     2859                 (input  integer(v-resize-value-str)
     2860                 ,input  true
     2861                 ) .
     2862               assign
     2863                 v-restore-saved = true
     2864               .
     2865             end.
     2866           end.
     2867           if v-restore-saved <> true
     2868           then do:
     2869             if v-diasize-wndmax = true
     2870             then do:
     2871               run diasize_maximize in this-procedure
     2872                 (input  true
     2873                 ) .
     2874             end.
     2875           end.
     2876         end.
     2877         else do:
     2878           if v-diasize-wndmax = true
     2879           then do:
     2880             run diasize_maximize in this-procedure
     2881               (input  true
     2882               ) .
     2883           end.
     2884         end.
     2885       end.
     2886     end.
     2887   end procedure.
     2888   procedure diasize_need-full-display :
     2889     define output parameter p-need-full-display as logical   no-undo .
     2890     do
     2891     on error undo, return error return-value
     2892     :
     2893       assign
     2894         p-need-full-display = v-diasize-need-full-display
     2895       .
     2896       assign
     2897         v-diasize-need-full-display = false
     2898       .
     2899     end.
     2900   end procedure.
     2901   procedure get-context :
     2902      define output parameter p-db-num as integer          no-undo.
     2903      define output parameter p-user-id as character        no-undo.
     2904      define variable v-login               as character    no-undo.
     2905      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2906      define buffer buf_user-login  for ub.user-login .
     2907      do
     2908      on error undo, return error
     2909      :
     2910            FIND FIRST buf_sys-ctrl no-lock.
     2911            ASSIGN
     2912               v-login = USERID("ub")
     2913               p-db-num = buf_sys-ctrl.db-num
     2914            .
     2915            FIND FIRST buf_user-login
     2916                 WHERE buf_user-login.db-num = p-db-num
     2917                   AND buf_user-login.user-login = v-login
     2918                 no-lock
     2919                 no-error
     2920                 .
     2921            IF AVAILABLE buf_user-login
     2922            THEN DO:
     2923               assign
     2924                  p-user-id = buf_user-login.user-id
     2925               .
     2926            END.
     2927      end.
     2928   end procedure.
     2929       run diasize_init in this-procedure .
     2930   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2931   do:
     2932     br-attr :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2933   end.
     2934   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2935   on f5 of frame Dialog-Frame anywhere
     2936   do:
     2937     OPEN QUERY br-attr FOR EACH temp-attr no-lock where temp-attr.fdisable ne yes.
     2938       apply "VALUE-CHANGED" to br-attr.
     2939   end.
     2940   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2941   ON TAB ANYWHERE
     2942   DO:
     2943   define variable ii as integer no-undo .
     2944   define variable fh as widget-handle no-undo .
     2945   define variable hh as widget-handle no-undo .
     2946   define variable v-next-widget-name as character no-undo .
     2947   if v-tab-order <> '' then do:
     2948     if self:type = "TOGGLE-BOX" then
     2949     self:BGCOLOR = ?.
     2950     assign
     2951     ii = lookup(self:name, v-tab-order).
     2952     assign
     2953     ii = ii + 1
     2954     v-next-widget-name = entry(ii, v-tab-order)
     2955     no-error .
     2956     if error-status:error then do:
     2957       assign
     2958       ii = 1
     2959       v-next-widget-name = entry( ii, v-tab-order)
     2960       .
     2961     end.
     2962     assign
     2963     fh = frame Dialog-Frame:first-child
     2964     hh = fh:first-child
     2965     .
     2966     do while valid-handle(hh):
     2967       if hh:name = v-next-widget-name then do:
     2968         if hh:sensitive  = yes
     2969         AND hh:visible = yes then do:
     2970           if hh:type = "TOGGLE-BOX":U then do:
     2971             assign
     2972             hh:BGcolor = 1
     2973             .
     2974           end.
     2975           APPLY "ENTRY" to hh.
     2976           return no-apply.
     2977         end.
     2978         else do:
     2979           APPLY "TAB" to hh.
     2980           return no-apply.
     2981         end.
     2982       end.
     2983       hh = hh:next-sibling.
     2984     end.
     2985   end.
     2986   END.
     2987   ON BACK-TAB ANYWHERE
     2988   DO:
     2989   define variable ii as integer no-undo .
     2990   define variable fh as widget-handle no-undo .
     2991   define variable hh as widget-handle no-undo .
     2992   define variable v-next-widget-name as character no-undo .
     2993   if v-tab-order <> '' then do:
     2994     assign
     2995     ii = lookup(self:name, v-tab-order).
     2996     .
     2997     assign
     2998     ii = (if ii = 1
     2999           then  num-entries(v-tab-order)
     3000           else ii - 1
     3001           )
     3002     v-next-widget-name = entry(ii, v-tab-order)
     3003     .
     3004     assign
     3005     fh = frame Dialog-Frame:first-child
     3006     hh = fh:first-child
     3007     .
     3008     do while valid-handle(hh):
     3009       if hh:name = v-next-widget-name then do:
     3010         if hh:sensitive  = yes
     3011         AND hh:visible = yes then do:
     3012           if hh:type = "TOGGLE-BOX":U then do:
     3013             assign
     3014             hh:BGcolor = 1
     3015             .
     3016           end.
     3017           APPLY "ENTRY" to hh.
     3018           return no-apply.
     3019         end.
     3020         else do:
     3021         APPLY "BACK-TAB" to hh.
     3022         return no-apply.
     3023         end.
     3024       end.
     3025       hh = hh:next-sibling.
     3026     end.
     3027     end.
     3028   END.
     3029   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3030   ON RETURN ANYWHERE
     3031   DO:
     3032   define variable ii as integer no-undo .
     3033   define variable fh as widget-handle no-undo .
     3034   define variable hh as widget-handle no-undo .
     3035   define variable v-next-widget-name as character no-undo .
     3036     if v-tab-order <> '' then do:
     3037       assign
     3038       ii = lookup(self:name, v-tab-order).
     3039       if ii = num-entries(v-tab-order) then do:
     3040           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     3041           return no-apply.
     3042       end.
     3043       if self:type <> "BUTTON" and
     3044         self:type <> "EDITOR"  then do:
     3045         run proc-move-forward in this-procedure .
     3046         return no-apply.
     3047       end.
     3048       if self:type = "BUTTON" then do:
     3049         APPLY "CHOOSE" to self.
     3050       end.
     3051       if self:type = "TOGGLE-BOX" then
     3052       self:BGCOLOR = ?.
     3053       assign
     3054       ii = ii + 1
     3055       v-next-widget-name = entry(ii, v-tab-order)
     3056       no-error .
     3057       if error-status:error then do:
     3058         assign
     3059         ii = 1
     3060         v-next-widget-name = entry( ii, v-tab-order)
     3061         .
     3062       end.
     3063       assign
     3064       fh = frame Dialog-Frame:first-child
     3065       hh = fh:first-child
     3066       .
     3067       do while valid-handle(hh):
     3068         if hh:name = v-next-widget-name then do:
     3069           if hh:sensitive  = yes
     3070           AND hh:visible = yes then do:
     3071             if hh:type = "TOGGLE-BOX":U then do:
     3072               assign
     3073               hh:BGcolor = 1
     3074               .
     3075             end.
     3076             APPLY "ENTRY" to hh.
     3077             return no-apply.
     3078           end.
     3079           else do:
     3080             APPLY "TAB" to hh.
     3081             return no-apply.
     3082           end.
     3083         end.
     3084         hh = hh:next-sibling.
     3085       end.
     3086     end.
     3087   END.
     3088   procedure proc-move-forward :
     3089   define variable ii as integer no-undo .
     3090   define variable fh as widget-handle no-undo .
     3091   define variable hh as widget-handle no-undo .
     3092   define variable v-next-widget-name as character no-undo .
     3093   do
     3094   on error undo, return error
     3095   :
     3096     if v-tab-order <> '' then do:
     3097       if self:type = "TOGGLE-BOX" then
     3098       self:BGCOLOR = ?.
     3099       assign
     3100       ii = lookup(self:name, v-tab-order).
     3101       assign
     3102       ii = ii + 1
     3103       v-next-widget-name = entry(ii, v-tab-order)
     3104       no-error .
     3105       if error-status:error then do:
     3106         assign
     3107         ii = 1
     3108         v-next-widget-name = entry( ii, v-tab-order)
     3109         .
     3110       end.
     3111       assign
     3112       fh = frame Dialog-Frame:first-child
     3113       hh = fh:first-child
     3114       .
     3115       do while valid-handle(hh):
     3116         if hh:name = v-next-widget-name then do:
     3117           if hh:sensitive  = yes
     3118           AND hh:visible = yes then do:
     3119             if hh:type = "TOGGLE-BOX":U then do:
     3120               assign
     3121               hh:BGcolor = 1
     3122               .
     3123             end.
     3124             APPLY "ENTRY" to hh.
     3125             return.
     3126           end.
     3127           else do:
     3128             assign
     3129             ii = ii + 1
     3130             v-next-widget-name = entry(ii, v-tab-order)
     3131             no-error .
     3132             if error-status:error then do:
     3133               assign
     3134               ii = 1
     3135               v-next-widget-name = entry( ii, v-tab-order)
     3136               .
     3137             end.
     3138           end.
     3139         end.
     3140         hh = hh:next-sibling.
     3141       end.
     3142     end.
     3143   end.
     3144   end procedure.
     3145   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3146   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3147   MAIN-BLOCK:
     3148   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3149      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3150     ini-title  = frame Dialog-Frame:TITLE.
     3151     if NOT (p-mode = 'ПРОСМОТР':U
     3152           or p-mode = 'ИЗМЕНЕНИЕ':U
     3153           or p-mode = 'ДОБАВЛЕНИЕ':U
     3154           ) then do:
     3155       message
     3156       vss-workfile vss-revision vss-description skip
     3157       "Неверный параметр вызова p-mode" p-mode
     3158       view-as alert-box ERROR.
     3159       return error.
     3160     end.
     3161     if p-mode = 'ИЗМЕНЕНИЕ':U
     3162     or p-mode = 'ДОБАВЛЕНИЕ':U
     3163     then do:
     3164   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3165     run mainmenu_getcntxt in parparentproc
     3166       (output v-cntxt-db-num
     3167       ,output v-cntxt-userid
     3168       ,output v-cntxt-level
     3169       ,output v-cntxt-host-code-obj
     3170       ,output v-cntxt-obj-type
     3171       ,output v-cntxt-obj-code
     3172       ,output v-cntxt-db-num-obj
     3173       ,output v-cntxt-is-admin
     3174       ) .
     3175       find first buf_db no-lock where buf_db.db-num = v-cntxt-db-num.
     3176       if not buf_db.add-goods then do:
     3177         message
     3178         vss-workfile vss-revision vss-description skip
     3179         "Редактирование атрибутов товара доступно только в той БД,  которой разрешено добавление товаров" skip
     3180         "Текущая БД" v-cntxt-db-num
     3181         view-as alert-box error .
     3182         undo, return error.
     3183       end.
     3184     end.
     3185     for each  temp-attr share-lock:
     3186       delete temp-attr.
     3187     end.
     3188   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3189     RUN MyEnable in this-procedure .
     3190     Run init-proc in this-procedure .
     3191     apply "VALUE-CHANGED" to br-attr IN frame Dialog-Frame.
     3192     WAIT-FOR GO OF FRAME Dialog-Frame.
     3193   END.
     3194   RUN disable_UI in this-procedure .
     3195   run attr-pop-clean-up in this-procedure ( input 'goods-attr':U ).
     3196   if updated then return 'ИЗМЕНЕНИЕ':U.
     3197   PROCEDURE choose-to-edit :
     3198   define input parameter p-attr-code as character no-undo .
     3199   assign
     3200   add-option = p-attr-code
     3201   .
     3202   APPLY "CHOOSE" to b-add in frame Dialog-Frame .
     3203   END PROCEDURE.
     3204   PROCEDURE disable_UI :
     3205     HIDE FRAME Dialog-Frame.
     3206   END PROCEDURE.
     3207   PROCEDURE enable_UI :
     3208     DISPLAY goods-artic Goods-dsc-name goods-gds-code goods-prod-type
     3209             goods-prod-code goods-prod-name
     3210         WITH FRAME Dialog-Frame.
     3211     ENABLE B-exit b-quit b-add b-lkp b-chg b-del b-help goods-artic
     3212            Goods-dsc-name goods-gds-code goods-prod-type goods-prod-code
     3213            goods-prod-name
     3214         WITH FRAME Dialog-Frame.
     3215     VIEW FRAME Dialog-Frame.
     3216     OPEN QUERY br-attr FOR EACH temp-attr no-lock where temp-attr.fdisable ne yes.
     3217   END PROCEDURE.
     3218   PROCEDURE init-proc :
     3219   define var  attr-type as character no-undo .
     3220   define var  attr-format as character no-undo .
     3221   define var  attr-label as character no-undo .
     3222   define var  attr-value as character no-undo .
     3223   define var  attr-user-can-edit as logical no-undo .
     3224   define var  attr-output-display as logical no-undo .
     3225   define var  attr-other as char no-undo .
     3226   define buffer buf_goods for ub.goods.
     3227   define buffer buf_clients for ub.clients.
     3228   define buffer buf_prods for ub.clients.
     3229     if p-mode = 'ИЗМЕНЕНИЕ':U  then.
     3230     else empty temp-table temp-attr.
     3231   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     3232     find first buf_goods where
     3233              buf_goods.gds-code =  p-gds-code no-lock no-error .
     3234     find first buf_prods where
     3235                 buf_prods.obj-code =  buf_goods.prod-code
     3236             and buf_prods.obj-type =  buf_goods.prod-type  no-lock no-error .
     3237     Assign
     3238     Goods-dsc-name = buf_Goods.gds-name
     3239     goods-artic    = buf_goods.artic
     3240     goods-gds-code = buf_goods.gds-code
     3241     goods-prod-type = buf_goods.prod-type
     3242     goods-prod-code = buf_goods.prod-code
     3243     goods-prod-name = buf_prods.obj-name
     3244     .
     3245   display Goods-dsc-name goods-gds-code goods-artic
     3246   goods-prod-type goods-prod-code goods-prod-name
     3247     with frame Dialog-Frame  .
     3248   end.
     3249    For each tt0-goods-attr where
     3250            tt0-goods-attr.gds-code  = p-gds-code  no-lock :
     3251       run gds-attr-name in this-procedure (
     3252                                                input tt0-goods-attr.attr-code
     3253                                               ,output attr-type
     3254                                               ,output attr-format
     3255                                               ,output attr-label
     3256                                               ,output attr-user-can-edit
     3257                                               ,output attr-output-display
     3258                                               ,output attr-other ).
     3259       if attr-output-display = true then DO:
     3260         find first temp-attr where
     3261                   temp-attr.code = tt0-goods-attr.attr-code
     3262               AND temp-attr.gds-code = tt0-goods-attr.gds-code
     3263               and temp-attr.grp      = tt0-goods-attr.grp no-error.
     3264         if not available temp-attr then do:
     3265           create temp-attr.
     3266           assign
     3267           temp-attr.attr-code = attr-label
     3268           temp-attr.value_ = tt0-goods-attr.attr-value
     3269           temp-attr.attr-value = (if attr-type = 'L':U
     3270                                   then string(tt0-goods-attr.attr-value = "yes":U, attr-format)
     3271                                   else tt0-goods-attr.attr-value)
     3272           temp-attr.user-can-edit = attr-user-can-edit
     3273           temp-attr.code = tt0-goods-attr.attr-code
     3274           temp-attr.gds-code = tt0-goods-attr.gds-code
     3275           temp-attr.grp      = tt0-goods-attr.grp
     3276           temp-attr.fdisable = tt0-goods-attr.fdisable
     3277           .
     3278         end.
     3279       End.
     3280     End.
     3281     OPEN QUERY br-attr FOR EACH temp-attr no-lock where temp-attr.fdisable ne yes.
     3282     apply "VALUE-CHANGED" to br-attr IN frame Dialog-Frame.
     3283   END PROCEDURE.
     3284   PROCEDURE MyEnable :
     3285   define variable alco-val as character no-undo .
     3286   define variable alco-type as character no-undo .
     3287   assign
     3288   v-tab-order = "b-exit,b-quit,b-add,b-lkp,b-chg,b-del,b-help,br-attr".
     3289   ASSIGN
     3290   temp-attr.attr-code:resizable in browse br-attr = yes
     3291   temp-attr.attr-value:resizable in browse br-attr = yes.
     3292   .
     3293   if p-mode <> 'ПРОСМОТР':U then do:
     3294     run attr-pop-create-items in this-procedure  (
     3295                                                   input 'goods-attr':U
     3296                                                   ,input 'gds-attr-manual-edit'
     3297                                                   ,input 'gds-attr-tooltip'
     3298                                                   ,input 'choose-to-edit'
     3299                                                   ,input menu menu-b-add:handle
     3300                                                   ,input 'alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U
     3301                                                 ).
     3302   end.
     3303   DISPLAY
     3304   Goods-dsc-name
     3305   goods-gds-code
     3306   goods-artic
     3307   WITH FRAME Dialog-Frame.
     3308   ENABLE
     3309   b-exit when p-mode <> 'ПРОСМОТР':U
     3310   b-quit
     3311   b-del when p-mode <> 'ПРОСМОТР':U
     3312   b-add when p-mode <> 'ПРОСМОТР':U
     3313   b-chg when p-mode <> 'ПРОСМОТР':U
     3314   b-lkp
     3315   b-help
     3316   br-attr
     3317   Goods-dsc-name
     3318   goods-gds-code
     3319   goods-artic
     3320   WITH FRAME Dialog-Frame .
     3321   VIEW FRAME Dialog-Frame .
     3322   if p-mode = 'ПРОСМОТР':U then do:
     3323     hide
     3324     b-exit
     3325     in frame Dialog-Frame .
     3326     assign
     3327     b-quit:label = "&Выход"
     3328     b-quit:col    = 1
     3329     .
     3330   end.
     3331   ASSIGN b-add:MENU-MOUSE = 1.
     3332   OPEN QUERY br-attr FOR EACH temp-attr no-lock where temp-attr.fdisable ne yes.
     3333   APPLY "ENTRY" to br-attr.
     3334   END PROCEDURE.
     3335   PROCEDURE proc-add-chg :
     3336   define input parameter p-add as logical no-undo.
     3337   define variable attr-type as character no-undo .
     3338   define variable attr-format as character no-undo .
     3339   define variable attr-label as character no-undo .
     3340   define variable attr-user-can-edit as logical no-undo .
     3341   define variable attr-output-display as logical no-undo .
     3342   define variable attr-other as char no-undo .
     3343   define variable attr-value as char no-undo .
     3344   DEFINE VARIABLE v-attr-value as character no-undo .
     3345   define var loc#log as logical no-undo.
     3346   DEFINE VARIABLE v-init as character no-undo .
     3347   define variable jj as integer no-undo.
     3348   DEFINE VARIABLE v-spr as character no-undo .
     3349   define variable v-spr-ext as character no-undo .
     3350   define variable v-spr-param as character no-undo .
     3351   DEFINE VARIABLE v-setted as logical no-undo .
     3352   DEFINE VARIABLE v-deleted as logical no-undo .
     3353   define variable v-check as character no-undo .
     3354   define variable v-error-code as character no-undo .
     3355   define variable v-correct as logical no-undo .
     3356   define variable v-attr-entry as character no-undo .
     3357   define buffer buf_temp-attr for temp-attr.
     3358   CASE p-add:
     3359     when yes then do:
     3360       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     3361         run temp-gds-attr-exist in this-procedure (
     3362                                                    input p-gds-code
     3363                                                   ,input add-option
     3364                                                   ,output loc#log)  no-error.
     3365         if error-status:error then return error.
     3366         if loc#log then do:
     3367           message
     3368           "Данный атрибут уже существует"
     3369           view-as alert-box error .
     3370           return error.
     3371         end.
     3372       end.
     3373       run gds-attr-name in this-procedure (
     3374                                             input  add-option
     3375                                             ,output attr-type
     3376                                             ,output attr-format
     3377                                             ,output attr-label
     3378                                             ,output attr-user-can-edit
     3379                                             ,output attr-output-display
     3380                                             ,output attr-other
     3381                                             ) no-error .
     3382       if error-status :error then do:
     3383         return error .
     3384       end.
     3385       assign
     3386       added = yes.
     3387       do jj = 1 to num-entries(attr-other, chr(47)):
     3388         v-attr-entry = entry(jj, attr-other, chr(47)) .
     3389         if entry(1, v-attr-entry, "=":U) = "init":U then do:
     3390           assign
     3391           v-init = string(entry(2, v-attr-entry, "=":U))
     3392           .
     3393         end.
     3394       end.
     3395       if  v-init <> "":U then do:
     3396           run  value(v-init)
     3397                       in this-procedure (
     3398                                           input p-gds-code
     3399                                         , output attr-value) no-error .
     3400             if error-status:error then do:
     3401                 assign
     3402                 attr-value = "":U
     3403                 .
     3404             end.
     3405       end.
     3406       CASE attr-type:
     3407         when 'L':U then do:
     3408           assign
     3409           v-attr-value = "yes":U
     3410           .
     3411         end.
     3412         when 'I':U or when 'D':U then do:
     3413           assign
     3414           v-attr-value = if v-init <> "":U
     3415                         then attr-value
     3416                         else string(0)
     3417           .
     3418         end.
     3419         when 'T':U then do:
     3420           assign
     3421           v-attr-value = ?
     3422           .
     3423         end.
     3424         when 'C':U then do:
     3425           assign
     3426           v-attr-value = if v-init <> "":U
     3427                         then attr-value
     3428                         else "":U
     3429           .
     3430         end.
     3431       END CASE.
     3432       assign
     3433       attr-value = v-attr-value
     3434       .
     3435     end.
     3436     when no then do:
     3437       run gds-attr-name in this-procedure (
     3438                                             input temp-attr.code
     3439                                             ,output attr-type
     3440                                             ,output attr-format
     3441                                             ,output attr-label
     3442                                             ,output attr-user-can-edit
     3443                                             ,output attr-output-display
     3444                                             ,output attr-other) no-error.
     3445       IF ERROR-STATUS:ERROR THEN DO:
     3446           message "Ошибка при определении названия и типа атрибута товара"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3447           return error.
     3448       END.
     3449       attr-value  = temp-attr.value_.
     3450     end.
     3451   END CASE.
     3452   IF attr-user-can-edit Then DO:
     3453     do jj = 1 to num-entries(attr-other, chr(47)):
     3454       v-attr-entry = entry(jj, attr-other, chr(47)) .
     3455       if entry(1, v-attr-entry, "=":U) = "spr":U
     3456       then do:
     3457         assign
     3458         v-spr = string(entry(2, v-attr-entry, "=":U))
     3459         .
     3460       end.
     3461       if  entry(1, v-attr-entry, "=":U) = "spr-ext":U
     3462       then do:
     3463         assign
     3464         v-spr-ext = string(entry(2, v-attr-entry, "=":U))
     3465         .
     3466       end.
     3467       if entry(1, v-attr-entry, "=":U) = "spr-param":U then do:
     3468         assign
     3469         v-spr-param = string(entry(2, v-attr-entry, "=":U))
     3470         .
     3471       end.
     3472       if entry(1, v-attr-entry, "=":U) = "check":U then do:
     3473         assign
     3474         v-check = string(entry(2, v-attr-entry, "=":U))
     3475         .
     3476       end.
     3477     end.
     3478     if v-spr = "":U
     3479     and v-spr-ext = '':U
     3480     then do:
     3481       run gbl/d-prompt.w (
     3482         'title=':u + "Изменение атрибута товара" + '\':u
     3483       + 'text1=':u + attr-label + '\':u
     3484       + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     3485       + 'type=' + attr-type + '\':u
     3486       + 'fillin_row=2\':u
     3487       + 'fillin_col=4\':u
     3488       + 'fillin_width=20\':u
     3489       + 'fillin_height=1\':u
     3490       + 'max-chars=70\':u
     3491       + 'readonly=' + (if p-mode = 'ПРОСМОТР':U then 'yes':u else 'no':u) + '\':u
     3492       , input-output attr-value
     3493       ).
     3494       if return-value = 'false':u then return error.
     3495     end.
     3496     else do:
     3497       if v-spr = '':u then do:
     3498         if v-spr-param = "":U then do:
     3499           run  value(v-spr-ext)  (
     3500                              input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     3501                             ,input p-gds-code
     3502                             ,input-output attr-value
     3503                             ,output v-setted) no-error .
     3504         end.
     3505         else do:
     3506           run  value(v-spr-ext) (
     3507                                input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     3508                               ,input p-gds-code
     3509                               ,input v-spr-param
     3510                               ,input-output attr-value
     3511                               ,output v-setted) no-error .
     3512         end.
     3513         if not v-setted then return error.
     3514       end.
     3515       if v-spr-ext = '':U then do:
     3516         if v-spr-param = "":U then do:
     3517           run  value(v-spr) in this-procedure (
     3518                                                input p-gds-code
     3519                                               ,input-output attr-value
     3520                                               ,output v-setted) no-error .
     3521         end.
     3522         else do:
     3523           run  value(v-spr) in this-procedure (
     3524                                                  input p-gds-code
     3525                                                 ,input v-spr-param
     3526                                                 ,input-output attr-value
     3527                                                 ,output v-setted) no-error .
     3528         end.
     3529         if not v-setted then return error.
     3530       end.
     3531     end.
     3532     if v-check <> "":U then do:
     3533       run value(v-check) (
     3534                            input p-gds-code
     3535                           ,input (if p-add then add-option else temp-attr.code)
     3536                           ,input attr-value
     3537                           ,input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     3538                           ,output v-correct
     3539                           ,output v-error-code) no-error.
     3540       if error-status:error then do:
     3541         message
     3542         "Ошибка при проверке корректности задаваемого значения атрибута" skip
     3543         error-status:get-message(1) skip
     3544         return-value
     3545         view-as alert-box error .
     3546         undo, return error .
     3547       end.
     3548       if not v-correct then do:
     3549         message
     3550         "Задаваемое значение атрибута некорректно" skip
     3551         return-value
     3552         view-as alert-box error .
     3553         undo, return error .
     3554       end.
     3555     end.
     3556     if AVAILABLE (temp-attr) then do:
     3557     if attr-label = "Является подконтрольным ФГИС Меркурий" and
     3558     temp-attr.code = 'mercur_FGIS':U then do:
     3559     define variable ii             as integer no-undo .
     3560     define variable gdsMercsubsObj as class   gdsmercsubs.
     3561     define variable gdsmercstrObj  as class   gdsmercstr.
     3562     define variable gdsMercObj     as class     gdsmercsub.
     3563     define VARIABLE f-guid         as character no-undo .
     3564     gdsMercsubsObj = new gdsmercsubs ().
     3565     gdsmercstrObj = new gdsmercstr ().
     3566     gdsMercsubsObj = gdsmercstrObj:getgdsmercs(p-gds-code).
     3567     if VALID-OBJECT (gdsMercsubsObj:GdsMercsubsCurr) then
     3568     do:
     3569       do ii = 1 to gdsMercsubsObj:GetItem (ii):
     3570         gdsMercObj = gdsMercsubsObj:GdsMercsubsCurr.
     3571         assign
     3572           f-guid         = gdsMercObj:GUID_
     3573           .
     3574       end.
     3575     end.
     3576     if f-guid <> "" then do:
     3577         message
     3578         "Необходимо удалить синхронизацию товара с Меркурием" skip
     3579         view-as alert-box error .
     3580         undo, return error .
     3581     end.
     3582     end.
     3583     end.
     3584     run temp-gds-attr-write (
     3585                                input p-gds-code
     3586                               ,input (if p-add then add-option else temp-attr.code)
     3587                               ,input attr-value) no-error .
     3588     IF not error-status:error then do:
     3589         assign
     3590         updated = yes
     3591         .
     3592        if p-add
     3593        then do:
     3594           find first buf_temp-attr where buf_temp-attr.gds-code eq p-gds-code
     3595                                      and buf_temp-attr.code     eq add-option
     3596                                      and buf_temp-attr.grp no-error.
     3597           if available buf_temp-attr
     3598           then
     3599              buf_temp-attr.fdisable = yes.
     3600        end.
     3601        br-attr:refresh() in frame Dialog-Frame no-error .
     3602     END.
     3603     assign
     3604     added = no.
     3605   End.
     3606   Else message "Изменение атрибута невозможно !" view-as alert-box error.
     3607   END PROCEDURE.
     3608   PROCEDURE proc-b-lkp :
     3609   define variable attr-type           as character no-undo .
     3610   define variable attr-format         as character no-undo .
     3611   define variable attr-label          as character no-undo .
     3612   define variable attr-user-can-edit  as logical   no-undo .
     3613   define variable attr-output-display as logical   no-undo .
     3614   define variable attr-other          as character no-undo .
     3615   define variable attr-value          as character no-undo .
     3616   define variable v-run-name          as character no-undo .
     3617   define variable v-spr-param         as character no-undo .
     3618   define variable v-setted            as logical   no-undo .
     3619   define variable jj                  as integer   no-undo .
     3620   run gds-attr-name in this-procedure (
     3621                                            input temp-attr.code
     3622                                           ,output attr-type
     3623                                           ,output attr-format
     3624                                           ,output attr-label
     3625                                           ,output attr-user-can-edit
     3626                                           ,output attr-output-display
     3627                                           ,output attr-other) no-error.
     3628   IF ERROR-STATUS:ERROR THEN DO:
     3629       message "Ошибка при определении названия и типа атрибута товара"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3630       return error.
     3631   END.
     3632   do jj = 1 to num-entries(attr-other, chr(47)):
     3633     if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr-ext" then do:
     3634       v-run-name = entry(2, entry(jj, attr-other, chr(47)), "=":U).
     3635     end.
     3636     if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr-param":U then do:
     3637       assign
     3638       v-spr-param = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     3639       .
     3640     end.
     3641   END.
     3642   if v-run-name = "" then next.
     3643   if v-spr-param = '':U then do:
     3644     run value(v-run-name) (
     3645                            input 'ПРОСМОТР':U
     3646                           ,input p-gds-code
     3647                           ,input-output temp-attr.value_
     3648                           ,output v-setted
     3649                             )
     3650                           no-error .
     3651   end.
     3652   else do:
     3653     run value(v-run-name) (
     3654                            input 'ПРОСМОТР':U
     3655                           ,input p-gds-code
     3656                           ,input v-spr-param
     3657                           ,input-output temp-attr.value_
     3658                           ,output v-setted
     3659                             )
     3660                           no-error .
     3661   end.
     3662   if error-status:error then do:
     3663     message error-status:get-message(1)  skip
     3664     return-value
     3665     view-as alert-box error .
     3666     undo, return error .
     3667   end.
     3668   return .
     3669   END PROCEDURE.
     3670   PROCEDURE proc-save :
     3671   DEFINE VARIABLE v-updated AS LOGICAL NO-UNDO.
     3672   define variable v-created as logical no-undo .
     3673   define variable v-deleted as logical no-undo .
     3674   define variable v-updated-str as character no-undo .
     3675   define variable v-type as character no-undo .
     3676   define variable v-issue-host-code like ub.sysconf.host-code no-undo .
     3677   define variable v-emrc-type as character no-undo .
     3678   define variable v-emrc-value as character no-undo .
     3679   define buffer buf_goods for ub.goods .
     3680   for each temp-attr NO-LOCK where
     3681            temp-attr.gds-code = p-gds-code
     3682        and temp-attr.grp  ne yes       :
     3683      find first tt0-goods-attr NO-LOCK WHERE
     3684             tt0-goods-attr.gds-code = temp-attr.gds-code
     3685       AND   tt0-goods-attr.attr-code = temp-attr.code
     3686       AND   tt0-goods-attr.grp       = temp-attr.grp
     3687       no-error.
     3688     assign
     3689     v-updated = no.
     3690     if available  tt0-goods-attr then do:
     3691       BUFFER-COMPARE temp-attr
     3692                   TO tt0-goods-attr
     3693                   case-sensitive
     3694                   SAVE result IN v-updated-str.
     3695       assign
     3696       v-created = yes
     3697       v-updated = (v-updated-str <> "":U)
     3698       .
     3699     end.
     3700     else do:
     3701       assign
     3702       v-updated = yes.
     3703     end.
     3704     if v-updated then do:
     3705        if temp-attr.code = 'emrc-type':U then
     3706        do:
     3707           for first buf_goods no-lock where buf_goods.gds-code = p-gds-code:
     3708              run ggoattr-value (
     3709                 input   buf_goods.grp-code
     3710                 ,input   0
     3711                 ,input   ""
     3712                 ,input   0
     3713                 ,input   'emrc-type':U
     3714                 ,output   v-emrc-value
     3715                 ,output   v-emrc-type
     3716                 ) no-error .
     3717           end.
     3718           if v-emrc-value <> temp-attr.value_ then
     3719           do:
     3720              message "Для товара и группы установлено отличное значение «тип ЕМЦ»" skip
     3721                 "Наследовать «тип ЕМЦ» группы?" skip
     3722                 view-as alert-box question buttons yes-no update choice as logical .
     3723              case choice:
     3724                 when true then
     3725                    temp-attr.value_ = v-emrc-value .
     3726              end case.
     3727           end.
     3728           find last ub.Code no-lock where ub.Code.parent = "emc" + chr(4) + temp-attr.value_ and
     3729              ub.Code.status_ = 0 and ub.Code.code <= iso-date(today) no-error .
     3730           if available (ub.Code) then
     3731           do:
     3732              for last ub.price-all no-lock where ub.price-all.gds-code = p-gds-code and
     3733                 ub.price-all.main-indication = 0 and
     3734                 ub.price-all.type-price = 0:
     3735                 if ub.price-all.price-sale < decimal(ub.Code.CodeValue) then
     3736                 do:
     3737                    message "Стоимость товара в базе ниже установленной ЕМЦ. Продажа товара по цене базы запрещена."
     3738                       view-as alert-box .
     3739                 end.
     3740              end.
     3741           end.
     3742        end.
     3743       run tt0-gds-attr-write in this-procedure (
     3744                                                  input p-gds-code
     3745                                                 ,input temp-attr.code
     3746                                                 ,input temp-attr.value_)  no-error.
     3747       if error-status:error then do:
     3748         message
     3749         "Ошибка при сохранении атрибута товара" skip
     3750         "товар" p-gds-code skip
     3751         "Атрибут" temp-attr.attr-code
     3752         view-as alert-box  error .
     3753         undo, return error  .
     3754       end.
     3755       updated = yes.
     3756     end.
     3757     ASSIGN
     3758     p-updated = v-updated OR p-updated.
     3759   End.
     3760   FOR EACH tt0-goods-attr where
     3761            tt0-goods-attr.gds-code = p-gds-code
     3762        and tt0-goods-attr.grp ne yes:
     3763     FIND FIRST temp-attr NO-LOCK WHERE
     3764               temp-attr.gds-code = tt0-goods-attr.gds-code
     3765           AND temp-attr.code = tt0-goods-attr.attr-code
     3766           AND temp-attr.grp = tt0-goods-attr.grp
     3767           NO-ERROR.
     3768       IF NOT AVAILABLE temp-attr THEN DO:
     3769         DELETE tt0-goods-attr.
     3770         assign
     3771         v-deleted = yes.
     3772         ASSIGN
     3773         p-updated = (v-deleted OR p-updated).
     3774       END.
     3775   END.
     3776   if p-updated
     3777   and p-update-instantly then do:
     3778     run ref/gds-atr1.p (
     3779                        input p-mode
     3780                       ,input p-gds-code
     3781                       ,INPUT table tt0-goods-attr
     3782                       ) no-error .
     3783     if error-status:error then do:
     3784       message
     3785       substitute("Ошибка при сохранении атрибутов товара:&1&2&1&3"
     3786                  , chr(10)
     3787                  , error-status:get-message(1)
     3788                  , return-value )
     3789       view-as alert-box
     3790       error .
     3791       undo, return error .
     3792     end.
     3793   end.
     3794   END PROCEDURE.
     3795   PROCEDURE temp-gds-attr-exist :
     3796     do
     3797     on error undo, return error
     3798     :
     3799       define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
     3800       define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
     3801       define output parameter p-exist    as logical no-undo .
     3802       define buffer buf_goods-attr for ub.goods-attr .
     3803       define buffer buf_temp-attr for temp-attr .
     3804       define variable v-type           as character no-undo .
     3805       define variable v-format         as character no-undo .
     3806       define variable v-label          as character no-undo .
     3807       define variable v-user-can-edit  as logical   no-undo .
     3808       define variable v-output-display as logical   no-undo .
     3809       define variable v-other          as character no-undo .
     3810       run gds-attr-name in this-procedure (
     3811                                               input  p-code
     3812                                               ,output v-type
     3813                                               ,output v-format
     3814                                               ,output v-label
     3815                                               ,output v-user-can-edit
     3816                                               ,output v-output-display
     3817                                               ,output v-other
     3818                                               ) no-error .
     3819       if error-status :error then do:
     3820         undo, return error return-value .
     3821       end.
     3822       find first buf_temp-attr no-lock where
     3823                  buf_temp-attr.gds-code  = p-gds-code AND
     3824                  buf_temp-attr.attr-code = p-code no-error .
     3825       if available buf_temp-attr then do:
     3826         P-EXIST = YES.
     3827       end.
     3828     end.
     3829   END PROCEDURE.
     3830   PROCEDURE temp-gds-attr-write :
     3831     do
     3832     on error undo, return error
     3833     :
     3834       define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
     3835       define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
     3836       define input parameter p-value    like ub.goods-attr.attr-value no-undo .
     3837       define buffer buf_temp-attr for temp-attr .
     3838       define variable v-type           as character no-undo .
     3839       define variable v-format         as character no-undo .
     3840       define variable v-label          as character no-undo .
     3841       define variable v-user-can-edit  as logical   no-undo .
     3842       define variable v-output-display as logical   no-undo .
     3843       define variable v-other          as character no-undo .
     3844       run gds-attr-name in this-procedure (
     3845                                             input  p-code
     3846                                             ,output v-type
     3847                                             ,output v-format
     3848                                             ,output v-label
     3849                                             ,output v-user-can-edit
     3850                                             ,output v-output-display
     3851                                             ,output v-other
     3852                                             ) no-error .
     3853       if error-status :error then do:
     3854         undo, return error return-value .
     3855       end.
     3856       find first buf_temp-attr exclusive-lock where
     3857                  buf_temp-attr.gds-code  = p-gds-code AND
     3858                  buf_temp-attr.code      = p-code     and
     3859                  buf_temp-attr.grp ne yes no-error .
     3860       if not available buf_temp-attr then do:
     3861         create buf_temp-attr .
     3862         assign
     3863           buf_temp-attr.gds-code  = p-gds-code
     3864           buf_temp-attr.attr-code = v-label
     3865           buf_temp-attr.code      = p-code
     3866           buf_temp-attr.attr-value = (if v-type = 'L':U then string(logical(p-value), v-format) else p-value)
     3867           buf_temp-attr.value_ = p-value
     3868           no-error
     3869         .
     3870       end.
     3871       ELSE
     3872       ASSIGN
     3873       buf_temp-attr.attr-value = (if v-type = 'L':U then string(logical(p-value), v-format) else p-value)
     3874       buf_temp-attr.value_ = p-value
     3875       no-error.
     3876     end.
     3877   END PROCEDURE.
     3878   PROCEDURE tt0-gds-attr-write :
     3879     do
     3880     on error undo, return error
     3881     :
     3882       define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
     3883       define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
     3884       define input parameter p-value    like ub.goods-attr.attr-value no-undo .
     3885       define buffer buf_tt0-goods-attr for tt0-goods-attr .
     3886       define variable v-type           as character no-undo .
     3887       define variable v-format         as character no-undo .
     3888       define variable v-label          as character no-undo .
     3889       define variable v-user-can-edit  as logical   no-undo .
     3890       define variable v-output-display as logical   no-undo .
     3891       define variable v-other          as character no-undo .
     3892       run gds-attr-name in this-procedure (
     3893                                             input  p-code
     3894                                             ,output v-type
     3895                                             ,output v-format
     3896                                             ,output v-label
     3897                                             ,output v-user-can-edit
     3898                                             ,output v-output-display
     3899                                             ,output v-other
     3900                                             ) no-error .
     3901       if error-status :error then do:
     3902         undo, return error return-value .
     3903       end.
     3904       find first buf_tt0-goods-attr exclusive-lock where
     3905                  buf_tt0-goods-attr.gds-code  = p-gds-code AND
     3906                  buf_tt0-goods-attr.attr-code = p-code     and
     3907                  buf_tt0-goods-attr.grp ne yes
     3908                  no-error .
     3909       if not available buf_tt0-goods-attr then do:
     3910         create buf_tt0-goods-attr .
     3911         assign
     3912           buf_tt0-goods-attr.gds-code  = p-gds-code
     3913           buf_tt0-goods-attr.attr-code = p-code
     3914           buf_tt0-goods-attr.attr-value = p-value no-error
     3915         .
     3916       end.
     3917       ELSE
     3918       ASSIGN
     3919       buf_tt0-goods-attr.attr-value = p-value no-error.
     3920       release buf_tt0-goods-attr no-error .
     3921       if error-status:error then do:
     3922         undo, return error return-value .
     3923       end.
     3924     end.
     3925   END PROCEDURE.
