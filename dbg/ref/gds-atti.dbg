        1   using ibs.th.str.mercury.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.bge.mercury.*.
        4   DEFINE TEMP-TABLE temp-attr NO-UNDO LIKE ub.goods-attr
        5          field user-can-edit as log
        6          field code as char
        7          field value_ as char
        8          field grp as logical
        9          field fdisable as logical
       10          INDEX attrc is
       11          UNIQUE PRIMARY
       12          code
       13          grp
       14          INDEX attrcl is UNIQUE
       15          attr-code
       16          grp
       17          .
       18   define new global shared variable g#language as character no-undo .
       19   if g#language <> '' and g#language <> 'rus':U then do:
       20     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       21   end.
       22   define temp-table tt0-goods-attr no-undo like ub.goods-attr
       23   field grp as logical
       24   field fdisable as logical
       25   index attr-code-activ fdisable gds-code attr-code
       26   index attr-code                gds-code attr-code.
       27   procedure addGdsGrpAttr:
       28      define input  parameter i-gds-code as integer no-undo.
       29      define input  parameter i-grp-code as integer no-undo.
       30      define variable vi as integer no-undo.
       31      define buffer buf_gds-grp-obj-attr for gds-grp-obj-attr.
       32      define buffer tt0-goods-attr for tt0-goods-attr.
       33      define buffer buf-goods-attr for tt0-goods-attr.
       34      for each tt0-goods-attr where tt0-goods-attr.grp:
       35         delete tt0-goods-attr.
       36      end.
       37      do vi = 1 to num-entries('alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U):
       38         find first buf_gds-grp-obj-attr no-lock
       39            where buf_gds-grp-obj-attr.node-code   = i-grp-code
       40              and buf_gds-grp-obj-attr.host-code   = 0
       41              and buf_gds-grp-obj-attr.obj-type    = ""
       42              and buf_gds-grp-obj-attr.obj-code    = 0
       43              and buf_gds-grp-obj-attr.attr-code   = entry(vi,'alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U)
       44         no-error .
       45         if available buf_gds-grp-obj-attr
       46         then do:
       47            find first tt0-goods-attr where tt0-goods-attr.gds-code   = i-gds-code
       48                                        and tt0-goods-attr.attr-code  = buf_gds-grp-obj-attr.attr-code
       49                                        and tt0-goods-attr.grp
       50            no-error.
       51               create tt0-goods-attr.
       52            assign
       53               tt0-goods-attr.gds-code   = i-gds-code
       54               tt0-goods-attr.attr-code  = buf_gds-grp-obj-attr.attr-code
       55               tt0-goods-attr.attr-value = buf_gds-grp-obj-attr.attr-value
       56               tt0-goods-attr.grp        = yes
       57            .
       58            tt0-goods-attr.fdisable = can-find (buf-goods-attr where buf-goods-attr.gds-code   eq tt0-goods-attr.gds-code
       59                                                                 and buf-goods-attr.attr-code  eq tt0-goods-attr.attr-code
       60                                                                 and buf-goods-attr.grp        ne yes).
       61            .
       62            end.
       63      end.
       64   end.
       65   define input parameter parparentproc as widget-handle no-undo .
       66   define input parameter p-mode as character no-undo.
       67   define input parameter p-gds-code as integer no-undo.
       68   define input parameter p-update-instantly as logical no-undo .
       69   define output parameter p-updated AS LOGICAL no-undo.
       70   define INPUT-OUTPUT parameter table for tt0-goods-attr.
       71   define variable vss-revision    as character no-undo init "$Revision$":U .
       72   define variable vss-author      as character no-undo init "$Author$":U .
       73   define variable vss-date        as character no-undo init "$Date$":U .
       74   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       75   define variable vss-archive     as character no-undo init "$Archive$":U .
       76   define variable vss-description as character no-undo init "Атрибуты товара".
       77   procedure vss-get-info :
       78     define output parameter p-vss-revision    like vss-revision    no-undo .
       79     define output parameter p-vss-author      like vss-author      no-undo .
       80     define output parameter p-vss-date        like vss-date        no-undo .
       81     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       82     define output parameter p-vss-archive     like vss-archive     no-undo .
       83     define output parameter p-vss-description like vss-description no-undo .
       84     assign
       85       p-vss-revision    = vss-revision
       86       p-vss-author      = vss-author
       87       p-vss-date        = vss-date
       88       p-vss-workfile    = vss-workfile
       89       p-vss-archive     = vss-archive
       90       p-vss-description = vss-description
       91     .
       92   end procedure.
       93   procedure vss-get-parameters :
       94     define output parameter p-vss-parameters as character no-undo .
       95   end procedure.
       96   define new global shared variable g#vssrevis-logger as handle    no-undo .
       97   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       98   define variable v-vssrevis-logger                   as handle    no-undo .
       99   procedure vss-logevent :
      100     define input  parameter p-extra-paramters as character no-undo .
      101     define variable v-vssrevis-parameters as character no-undo .
      102     do
      103     on error undo, return error return-value
      104     :
      105       if  valid-handle(v-vssrevis-logger)
      106       and v-vssrevis-logger :get-signature("logevent") <> ""
      107       then do:
      108         run vss-get-parameters in this-procedure
      109           (output v-vssrevis-parameters
      110           ).
      111         run logevent in v-vssrevis-logger
      112           (input vss-workfile
      113           ,input vss-revision
      114           ,input v-vssrevis-parameters
      115           ,input p-extra-paramters
      116           ).
      117       end.
      118     end.
      119   end procedure.
      120   assign
      121     v-vssrevis-logger = g#vssrevis-logger
      122   .
      123   if  valid-handle(v-vssrevis-logger)
      124   and v-vssrevis-logger :get-signature("logevent") <> ""
      125   then do:
      126     assign
      127       v-vssrevis-logevent = true
      128     .
      129     run vss-logevent in this-procedure (input vss-description) .
      130   end.
      131   define new global shared variable g#library  as handle no-undo .
      132   define new global shared variable g#library2 as handle no-undo .
      133   procedure proc-alt-shift-f2:
      134     if not ibs.th.gbl.gbl-var:rcode
      135   then
      136     run gbl\inidebug.p .
      137   end.
      138   procedure proc-alt-shift-f3:
      139     run gbl/prvssinf.p
      140       ( input this-procedure
      141       ) .
      142   end.
      143   define variable v-inform-launched as logical no-undo initial false .
      144   procedure proc-alt-shift-f4:
      145     define variable v-action as character no-undo .
      146     if v-inform-launched = false then do:
      147       assign
      148         v-inform-launched = true
      149       .
      150       run gbl/d-inform.w
      151         (  input self
      152         ,  input this-procedure
      153         , output v-action
      154         ) no-error .
      155       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      156       assign
      157         v-inform-launched = false
      158       .
      159     end.
      160   end.
      161   procedure proc-alt-f1:
      162     run gbl/corrhelp.p
      163       (input this-procedure
      164       ) .
      165   end .
      166   on alt-shift-f2 anywhere do:
      167     run proc-alt-shift-f2.
      168   end.
      169   on alt-shift-f3 anywhere do:
      170     run proc-alt-shift-f3 in this-procedure .
      171   end.
      172   on alt-shift-f4 anywhere do:
      173     run proc-alt-shift-f4 in this-procedure.
      174   end.
      175   on alt-f1 anywhere do:
      176     run proc-alt-f1 in this-procedure .
      177   end.
