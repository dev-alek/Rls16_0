     3343       v-find = yes.
     3344       end.
     3345       else do:
     3346     end.
     3347     RUN MyEnable.
     3348     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     3349     HIDE mark-num in frame Dialog-Frame .
     3350     if v-rid-list <> "":U then
     3351     REPOSITION br-obj-hist to recid integer(entry(1, v-rid-list)) No-ERROR.
     3352   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3353   DEF VAR cur-clmn-numbr-obj-hist as INT EXTENT 6 no-undo.
     3354   DEF VAR varmvibr-obj-hist       as INT no-undo.
     3355   DEF VAR varmvjbr-obj-hist       as INT no-undo.
     3356   DEF VAR varmvkbr-obj-hist       as INT no-undo.
     3357   DEF VAR varmvlbr-obj-hist       as INT no-undo.
     3358   DEF VAR move-elementbr-obj-hist as INT no-undo.
     3359   def var jjbr-obj-hist           as int no-undo.
     3360   do varmvibr-obj-hist = 1 to EXTENT(cur-clmn-numbr-obj-hist):
     3361     ASSIGN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvibr-obj-hist.
     3362   END.
     3363   RUN start-mv-clmnbr-obj-hist.
     3364   PROCEDURE start-mv-clmnbr-obj-hist:
     3365   def var old-session as logical no-undo.
     3366      old-session = SESSION:IMMEDIATE-DISPLAY.
     3367      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3368          IF  p-mode = 'все':U  THEN DO:
     3369      DO jjbr-obj-hist = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     3370        RUN re-move-clmnbr-obj-hist ( cur-clmn-numbr-obj-hist[INTEGER(ENTRY (jjbr-obj-hist, '1,2,3,4,5,6'))] , 1).
     3371      END.
     3372          END.
     3373          IF  p-mode <> 'все':U  THEN DO:
     3374      DO jjbr-obj-hist = NUM-ENTRIES('1,2,3,5,6') TO 1 BY -1:
     3375        RUN re-move-clmnbr-obj-hist ( cur-clmn-numbr-obj-hist[INTEGER(ENTRY (jjbr-obj-hist, '1,2,3,5,6'))] , 1).
     3376      END.
     3377          END.
     3378      SESSION:IMMEDIATE-DISPLAY = old-session.
     3379   END.
     3380   ON ctrl-cursor-right OF BROWSE br-obj-hist do:
     3381     RUN re-move-clmnbr-obj-hist ( 1, 6).
     3382   END.
     3383   ON ctrl-cursor-left OF BROWSE br-obj-hist do:
     3384     RUN re-move-clmnbr-obj-hist (6, 1).
     3385   END.
     3386   PROCEDURE re-move-clmnbr-obj-hist:
     3387     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3388     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3389     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3390       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = source-column THEN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = -1.
     3391     END.
     3392     if br-obj-hist:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3393     if source-column > target-column THEN
     3394     DO varmvjbr-obj-hist = source-column - 1 to target-column BY -1:
     3395       DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3396           if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvjbr-obj-hist THEN DO:
     3397             cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-numbr-obj-hist[varmvibr-obj-hist] + 1.
     3398           END.
     3399       END.
     3400     END.
     3401     ELSE
     3402     DO varmvjbr-obj-hist = source-column + 1 to target-column:
     3403       DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3404         if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvjbr-obj-hist THEN DO:
     3405           cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-numbr-obj-hist[varmvibr-obj-hist] - 1.
     3406         END.
     3407       END.
     3408     END.
     3409     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3410       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = -1 THEN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = target-column.
     3411     END.
     3412   END PROCEDURE.
     3413   PROCEDURE ch-clmnbr-obj-hist:
     3414     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3415     if cur-clmn-loc <= 1 then do:
     3416       return .
     3417     end.
     3418     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3419       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-loc THEN move-elementbr-obj-hist = varmvibr-obj-hist.
     3420     END.
     3421     RUN re-move-clmnbr-obj-hist (cur-clmn-loc, 1).
     3422   END PROCEDURE.
     3423   PROCEDURE mv-brw-defaultbr-obj-hist:
     3424   def var old-session as logical no-undo.
     3425     old-session = SESSION:IMMEDIATE-DISPLAY.
     3426     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3427     do varmvlbr-obj-hist = 1 to EXTENT(cur-clmn-numbr-obj-hist):
     3428       RUN re-move-clmnbr-obj-hist (cur-clmn-numbr-obj-hist[varmvlbr-obj-hist], varmvlbr-obj-hist).
     3429     END.
     3430     RUN start-mv-clmnbr-obj-hist.
     3431     SESSION:IMMEDIATE-DISPLAY = old-session.
     3432   END PROCEDURE.
     3433   .
     3434     run diasize_add_browse in this-procedure
     3435       (input  'width':u
     3436       ,input  browse br-changes :handle
     3437       ) .
     3438     run diasize_init in this-procedure .
     3439     WAIT-FOR GO OF FRAME Dialog-Frame.
     3440   END.
     3441   RUN disable_UI.
     3442   PROCEDURE disable_UI :
     3443     HIDE FRAME Dialog-Frame.
     3444   END PROCEDURE.
     3445   PROCEDURE enable_UI :
     3446     DISPLAY v-corr-user-db-num sch-db-num sch-corr-date sch-obj-code
     3447             sch-corr-user-name mark-num
     3448         WITH FRAME Dialog-Frame.
     3449     ENABLE b-quit B-mark b-sel v-corr-user-db-num B-print B-sch
     3450            B-Help br-obj-hist sch-db-num sch-corr-date sch-obj-code
     3451            sch-corr-user-name BR-changes mark-num b-nextlevel
     3452         WITH FRAME Dialog-Frame.
     3453     VIEW FRAME Dialog-Frame.
     3454   END PROCEDURE.
     3455   PROCEDURE MyEnable :
     3456   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3457   assign
     3458   br-obj-hist:num-locked-columns in frame Dialog-Frame = 1
     3459   X_c-obj-hist.corr-date:read-only in browse br-obj-hist = yes
     3460   br-changes:title = "":U
     3461   v-corr-user-db-num = v-db-num
     3462   temp-changes.l_name:resizable in browse br-changes = true
     3463   temp-changes.v_old:resizable in browse br-changes = true
     3464   temp-changes.v_new:resizable in browse br-changes = true
     3465   temp-changes.l_name:width in browse br-changes = 30
     3466   temp-changes.v_old:width in browse br-changes = 40
     3467   temp-changes.v_new:width in browse br-changes = 40
     3468   v-h = br-obj-hist:FIRST-COLUMN IN FRAME Dialog-Frame
     3469   .
     3470   DO while valid-handle(v-h) :
     3471     if v-h:LABEL = "Предмет изменения"
     3472     or v-h:LABEL = "Изменил"
     3473       then do:
     3474       v-h:RESIZABLE = YES.
     3475     end.
     3476       v-h = v-h:NEXT-COLUMN.
     3477     END.
     3478   DISPLAY
     3479   v-corr-user-db-num
     3480   sch-db-num
     3481   sch-corr-date
     3482   sch-obj-code
     3483   sch-corr-user-name
     3484   mark-num
     3485   WITH FRAME Dialog-Frame.
     3486   ENABLE
     3487   v-corr-user-db-num
     3488   b-quit
     3489   B-mark when lookup("b-mark":U, bttns) > 0
     3490   b-sel when lookup("b-sel":U, bttns) > 0
     3491   B-sch
     3492   B-Print
     3493   B-Help
     3494   br-obj-hist
     3495   sch-corr-date
     3496   sch-corr-user-name
     3497   sch-obj-code when p-mode = 'все':U
     3498   sch-db-num when p-mode = 'все':U
     3499   BR-changes mark-num
     3500   b-nextlevel
     3501   WITH FRAME Dialog-Frame.
     3502   VIEW FRAME Dialog-Frame.
     3503   HIDE sch-corr-user-name IN FRAME Dialog-Frame.
     3504   END PROCEDURE.
     3505   PROCEDURE OpenBr :
     3506   define input  parameter p-open-query     as logical   no-undo .
     3507   define input  parameter p-find-next      as logical   no-undo .
     3508   define input  parameter p-find-condition as character no-undo .
     3509   define input  parameter p-db-num like c-marking.corr-user-db-num no-undo .
     3510   define variable l-query-was-opened as logical no-undo .
     3511   define variable title0 as character no-undo.
     3512   title0 = "Список полной истории контрагента" + chr(32).
     3513   run waitfram-show in this-procedure ("Ждите...").
     3514   define variable sort-column-phrase as character no-undo .
     3515   case sort-column-name :
     3516     when "" then do:
     3517       assign
     3518         sort-column-phrase = ""
     3519       .
     3520     end.
     3521     otherwise do:
     3522       assign
     3523         sort-column-phrase = "by " + sort-column-name
     3524       .
     3525     end.
     3526   end case.
     3527   define variable l-open-query as logical   no-undo .
     3528   if p-mode = 'все':U then
     3529   do:
     3530         assign
     3531         filter-point = filter-point0 + p-mode
     3532         filter-label = substitute("&1", filter-label0)
     3533         .
     3534   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3535   define variable  l-disable-where-27  as logical   no-undo .
     3536   define variable  l-filter-open-27    as logical   .
     3537   define variable  flt-rec-27       as recid     no-undo .
     3538   define variable  filter-name-27      as character no-undo .
     3539   define variable  where-phrase-27     as character no-undo .
     3540   define variable  sort-phrase-27      as character no-undo .
     3541   define variable  where-phrase-rus-27 as character no-undo .
     3542   define variable  sort-phrase-rus-27  as character no-undo .
     3543     run waitfram-show in this-procedure
     3544       (input "ЖДИТЕ ..."
     3545       ).
     3546   run gbl/flt-get.p
     3547     (input filter-point
     3548     ,output flt-rec-27
     3549     ,output filter-name-27
     3550     ,output where-phrase-27
     3551     ,output sort-phrase-27
     3552     ,output where-phrase-rus-27
     3553     ,output sort-phrase-rus-27
     3554     ).
     3555   if p-open-query then do:
     3556       run set-filter-name in this-procedure
     3557         (INPUT filter-name-27
     3558         ) no-error .
     3559     assign
     3560       l-filter-open-27 = false
     3561     .
     3562     if flt-rec-27 <> ?
     3563       or sort-column-phrase > ""
     3564     then do:
     3565       define variable  parameter-2-27 as character no-undo .
     3566       define variable  parameter-3-27 as character no-undo .
     3567       define variable  parameter-4-27 as character no-undo .
     3568       define variable  parameter-5-27 as character no-undo .
     3569       define variable  parameter-6-27 as character no-undo .
     3570       define variable  parameter-7-27 as character no-undo .
     3571         assign
     3572         parameter-3-27 =
     3573                                 "FOR EACH X_c-obj-hist"
     3574         parameter-4-27 =
     3575           (
     3576             if (" TRUE " + " " + where-phrase-27) <> ""
     3577             then " TRUE " + " " + where-phrase-27
     3578             else "true"
     3579           )
     3580         parameter-5-27 = (" " + "" + " " + "")
     3581         parameter-6-27 = if sort-phrase-27 = ''
     3582                              then
     3583           (
     3584           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC BY X_c-obj-hist.mark " +
     3585             " " + sort-column-phrase +
     3586           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC BY X_c-obj-hist.mark "
     3587           )
     3588                              else
     3589           (
     3590           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC BY X_c-obj-hist.mark " +
     3591             " " + sort-column-phrase +
     3592           " " + sort-phrase-27
     3593           )
     3594         parameter-7-27 =
     3595           " indexed-reposition  "
     3596       .
     3597       do
     3598       on stop undo, leave
     3599       on error undo, leave
     3600       :
     3601         assign
     3602           l-disable-where-27 =
     3603             (" TRUE " + " " + where-phrase-27 = "")
     3604         .
     3605         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3606                             ,input query br-obj-hist:handle
     3607                             ,input parameter-3-27
     3608                             ,input parameter-4-27
     3609                             ,input parameter-5-27
     3610                             ,input parameter-6-27
     3611                             ,input parameter-7-27
     3612                             )
     3613         .
     3614         assign
     3615           l-filter-open-27 = true
     3616         .
     3617       end.
     3618       if l-filter-open-27 = false then do:
     3619         message
     3620           "Ошибка при фильтрации / сортировке" skip
     3621           "Будут показаны записи без учета фильтра" skip
     3622           view-as alert-box .
     3623       end.
     3624       else do:
     3625           assign
     3626             l-query-was-opened = true
     3627           .
     3628       end.
     3629     end.
     3630     if l-filter-open-27 = false then do:
     3631       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3632         where  TRUE
     3633          BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC BY X_c-obj-hist.mark
     3634          BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC BY X_c-obj-hist.mark
     3635         indexed-reposition
     3636     .
     3637         assign
     3638           l-query-was-opened = true
     3639         .
     3640     end.
     3641   end.
     3642   else do:
     3643     assign
     3644       v-doc-rec = recid( X_c-obj-hist )
     3645     .
     3646     do
     3647     on stop undo, leave
     3648     on error undo, leave
     3649     :
     3650       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3651         assign
     3652         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3653         parameter-4-27 =
     3654           "where ":u + " TRUE " + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3655         parameter-5-27 = " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC BY X_c-obj-hist.mark "
     3656       .
     3657         run fltopend_fltfindd in this-procedure  (
     3658                             input this-procedure:handle
     3659                             ,input query br-obj-hist:handle
     3660                             ,input rowid(X_c-obj-hist)
     3661                             ,input logical(parameter-2-27)
     3662                             ,input no-lock
     3663                             ,input (buffer X_c-obj-hist:handle)
     3664                             ,input parameter-4-27
     3665                             ,input parameter-5-27
     3666                             ) no-error.
     3667         .
     3668         assign
     3669           v-doc-rec = integer(return-value)
     3670           v-fltopend-rowid[1] = ?
     3671         .
     3672       end.
     3673       else do:
     3674         assign
     3675         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3676         parameter-3-27 =  "FOR EACH X_c-obj-hist"
     3677         parameter-4-27 =
     3678           (
     3679             if (" TRUE " + " " + where-phrase-27) <> ""
     3680             then " TRUE " + " " + where-phrase-27
     3681             else "true"
     3682           )
     3683         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     3684         parameter-6-27 = if sort-phrase-27 = ''
     3685                              then
     3686           (
     3687           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC BY X_c-obj-hist.mark " +
     3688             " " + sort-column-phrase +
     3689           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC BY X_c-obj-hist.mark "
     3690           )
     3691                              else
     3692           (
     3693           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC BY X_c-obj-hist.mark " +
     3694             " " + sort-column-phrase +
     3695           " " + sort-phrase-27
     3696           )
     3697         parameter-7-27 =
     3698           " indexed-reposition  "
     3699       .
     3700         run fltopend_fltfindq in this-procedure  (
     3701                             input this-procedure:handle
     3702                             ,input query br-obj-hist:handle
     3703                             ,input logical(parameter-2-27)
     3704                             ,input no-lock
     3705                             ,input parameter-3-27
     3706                             ,input parameter-4-27
     3707                             ,input parameter-5-27
     3708                             ,input parameter-6-27
     3709                             ,input parameter-7-27
     3710                             ,output v-fltopend-rowid
     3711                             ) no-error.
     3712         .
     3713         v-doc-rec = ?.
     3714       end.
     3715       assign
     3716         l-query-was-opened = true
     3717       .
     3718     end.
     3719   end.
     3720     run waitfram-hide in this-procedure .
     3721   end.
     3722   else do:
     3723     if not local-open-br( p-open-query      ,
     3724                           p-find-next         ,
     3725                          p-find-condition )
     3726     then do:
     3727   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3728   define variable  l-disable-where-29  as logical   no-undo .
