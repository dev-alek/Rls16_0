     3209   def var sort-labelbr-obj-hist   as character no-undo .
     3210   def var sort-clmnbr-obj-hist    as handle    no-undo .
     3211   def var cur-clmnbr-obj-hist     as handle    no-undo .
     3212   def var cur-clmn-locbr-obj-hist as integer   no-undo .
     3213   def var re-querybr-obj-hist     as logical   initial no no-undo .
     3214   on start-search, ctrl-o of br-obj-hist in frame Dialog-Frame do:
     3215      run sort-brbr-obj-hist
     3216        (input (if available X_c-obj-hist
     3217                then recid(X_c-obj-hist)
     3218                else ?
     3219               )
     3220        ).
     3221   end.
     3222   PROCEDURE sort-brbr-obj-hist :
     3223     define input parameter p-recid as recid no-undo .
     3224     if re-querybr-obj-hist = no then do:
     3225       assign
     3226          cur-clmnbr-obj-hist = br-obj-hist:current-column in frame Dialog-Frame
     3227       .
     3228       if sort-clmnbr-obj-hist <> ? then sort-clmnbr-obj-hist:column-fgcolor = 0.
     3229       if cur-clmnbr-obj-hist = sort-clmnbr-obj-hist then do:
     3230         assign
     3231            sort-labelbr-obj-hist = ""
     3232            sort-clmnbr-obj-hist = ?
     3233         .
     3234        end.
     3235        else do:
     3236          assign
     3237            sort-labelbr-obj-hist = cur-clmnbr-obj-hist:label
     3238            sort-clmnbr-obj-hist  = cur-clmnbr-obj-hist
     3239            sort-clmnbr-obj-hist:column-fgcolor = 4
     3240          .
     3241        end.
     3242      end.
     3243     assign
     3244       cur-clmn-locbr-obj-hist = 1
     3245     .
     3246     def var column-handle as handle no-undo .
     3247     column-handle = br-obj-hist:first-column.
     3248     do while valid-handle(column-handle) :
     3249       if column-handle = cur-clmnbr-obj-hist then do:
     3250         leave .
     3251       end.
     3252       column-handle = column-handle:NEXT-COLUMN.
     3253       assign
     3254         cur-clmn-locbr-obj-hist = cur-clmn-locbr-obj-hist + 1
     3255       .
     3256     end.
     3257     case sort-labelbr-obj-hist:
     3258           when X_c-obj-hist.corr-date:label in browse br-obj-hist then DO:    assign       sort-column-name = "X_c-obj-hist.corr-date"     .     run OpenBr(yes, no, no, v-corr-user-db-num).   . END.
     3259           when X_c-obj-hist.corr-user-db-num:label in browse br-obj-hist then DO:    assign       sort-column-name = "X_c-obj-hist.corr-user-db-num"     .     run OpenBr(yes, no, no, v-corr-user-db-num).   . END.
     3260       otherwise do:
     3261         assign
     3262           sort-column-name = ""
     3263         .
     3264         run OpenBr(yes, no, no, v-corr-user-db-num).
     3265           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-obj-hist') then do:
     3266             run mv-brw-defaultbr-obj-hist.
     3267           end.
     3268         if sort-labelbr-obj-hist <> "" then do:
     3269           assign
     3270             cur-clmnbr-obj-hist:column-fgcolor = 0
     3271           .
     3272         end.
     3273         assign
     3274           cur-clmn-locbr-obj-hist = ?
     3275         .
     3276       end.
     3277     end case.
     3278       if cur-clmn-locbr-obj-hist <> ? then do:
     3279         if can-do( this-procedure:internal-entries, 'ch-clmnbr-obj-hist') then do:
     3280           run ch-clmnbr-obj-hist in this-procedure (cur-clmn-locbr-obj-hist).
     3281         end.
     3282       end.
     3283     if p-recid <> ? then do:
     3284       reposition br-obj-hist to recid p-recid no-error.
     3285       apply "value-changed" to br-obj-hist in frame Dialog-Frame.
     3286     end.
     3287     apply "entry" to br-obj-hist in frame Dialog-Frame.
     3288   END PROCEDURE.
     3289   procedure re-open-query-srt-clmnbr-obj-hist:
     3290   if cur-clmnbr-obj-hist = ? then do:
     3291      run OpenBr(yes, no, no, v-corr-user-db-num).
     3292   end.
     3293   else do:
     3294      assign re-querybr-obj-hist = yes.
     3295      run sort-brbr-obj-hist
     3296        (input (if available X_c-obj-hist
     3297                then recid(X_c-obj-hist)
     3298                else ?
     3299               )
     3300        ).
     3301      assign re-querybr-obj-hist = no.
     3302   end.
     3303   end.
     3304   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3305   do:
     3306     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3307   end.
     3308   MAIN-BLOCK:
     3309   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3310      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3311      if p-mode <> 'все':U
     3312    and p-mode <> 'фирма':U
     3313    and p-mode <> "one":U
     3314    and p-mode <> "subject":U
     3315    and p-mode <> "parentbeg":U
     3316    then dO:
     3317       message
     3318       vss-workfile vss-revision vss-description skip
     3319       "Неверное значение параметров вызова p-mode"
     3320       p-mode
     3321       view-as alert-box ERROR.
     3322       return.
     3323    end.
     3324    v-rid-list = p-rid-list.
     3325     if v-rid-list <> "" then do:
     3326         FIND FIRST find_c-obj-hist No-LOCK where
     3327                    recid(find_c-obj-hist) = integer(entry(1, v-rid-list)) No-ERROR.
     3328         if not avail find_c-obj-hist then do:
     3329           message
     3330           vss-workfile vss-revision vss-description skip
     3331           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3332           view-as alert-box error .
     3333           return error.
     3334         end.
     3335         v-doc-rec = integer(entry(1, v-rid-list)).
     3336       end.
     3337   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3339     (output v-db-num
     3340     )  .
     3341     if p-mode <> 'все':U then do:
