     2789   procedure diasize_init :
     2790     define variable v-default-value    as logical   no-undo .
     2791     define variable v-restore-saved    as logical   no-undo .
     2792     define variable v-resize-value-str as character no-undo .
     2793     do
     2794     on error undo, return error return-value
     2795     :
     2796       do with frame Dialog-Frame
     2797       :
     2798         assign
     2799           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2800           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2801           v-diasize-browse-handle     = browse br-obj-hist :handle
     2802         .
     2803         create button v-diasize-resize-button
     2804         assign
     2805           parent        = frame Dialog-Frame :first-child
     2806           label         = "s"
     2807           height-pixels = 16
     2808           width-pixels  = 16
     2809           visible       = true
     2810           sensitive     = true
     2811           movable       = true
     2812           triggers:
     2813             on end-move persistent run diasize_end-move in this-procedure .
     2814           end triggers.
     2815         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2816         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2817         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2818         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2819         assign
     2820           v-diasize-wndmax = false
     2821         .
     2822         if connected("ub") = true
     2823         then do:
     2824           define variable v-cntxt-db-num        as integer   no-undo .
     2825           define variable v-cntxt-userid        as character no-undo .
     2826           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2827                                             , OUTPUT v-cntxt-userid
     2828                                             ) .
     2829           run gbl/wndpar_r.p
     2830             (input  v-cntxt-db-num
     2831             ,input  v-cntxt-userid
     2832             ,input  'wndmax':U
     2833             ,output v-diasize-wndmax
     2834             ,output v-default-value
     2835             ) .
     2836         end.
     2837         assign
     2838           v-diasize-wndstore = false
     2839         .
     2840         if connected("ub") = true
     2841         then do:
     2842           run gbl/wndpar_r.p
     2843             (input  v-cntxt-db-num
     2844             ,input  v-cntxt-userid
     2845             ,input  'wndstore':U
     2846             ,output v-diasize-wndstore
     2847             ,output v-default-value
     2848             ) .
     2849         end.
     2850         assign
     2851           v-diasize-proc-name = entry(1, program-name(2), '.')
     2852         .
     2853         if v-diasize-wndstore = true
     2854         then do:
     2855           assign
     2856             v-restore-saved = false
     2857           .
     2858           if connected("ub") = true
     2859           then do:
     2860             run gbl/wndsizer.p
     2861               (input  v-cntxt-db-num
     2862               ,input  v-cntxt-userid
     2863               ,input  v-diasize-proc-name
     2864               ,input  'height':u
     2865               ,output v-resize-value-str
     2866               ) .
     2867             if v-resize-value-str <> '':U
     2868             then do:
     2869               run diasize_change-height in this-procedure
     2870                 (input  integer(v-resize-value-str)
     2871                 ,input  true
     2872                 ) .
     2873               assign
     2874                 v-restore-saved = true
     2875               .
     2876             end.
     2877           end.
     2878           if connected("ub") = true
     2879           then do:
     2880             run gbl/wndsizer.p
     2881               (input  v-cntxt-db-num
     2882               ,input  v-cntxt-userid
     2883               ,input  v-diasize-proc-name
     2884               ,input  'width':u
     2885               ,output v-resize-value-str
     2886               ) .
     2887             if v-resize-value-str <> '':U
     2888             then do:
     2889               run diasize_change-width in this-procedure
     2890                 (input  integer(v-resize-value-str)
     2891                 ,input  true
     2892                 ) .
     2893               assign
     2894                 v-restore-saved = true
     2895               .
     2896             end.
     2897           end.
     2898           if v-restore-saved <> true
     2899           then do:
     2900             if v-diasize-wndmax = true
     2901             then do:
     2902               run diasize_maximize in this-procedure
     2903                 (input  true
     2904                 ) .
     2905             end.
     2906           end.
     2907         end.
     2908         else do:
     2909           if v-diasize-wndmax = true
     2910           then do:
     2911             run diasize_maximize in this-procedure
     2912               (input  true
     2913               ) .
     2914           end.
     2915         end.
     2916       end.
     2917     end.
     2918   end procedure.
     2919   procedure diasize_need-full-display :
     2920     define output parameter p-need-full-display as logical   no-undo .
     2921     do
     2922     on error undo, return error return-value
     2923     :
     2924       assign
     2925         p-need-full-display = v-diasize-need-full-display
