     1080   .
     1081   FUNCTION get-all-fields returns character (p-file-name as character ):
     1082   define variable v-dop as character no-undo .
     1083     find first _file no-lock where _file._file-name = p-file-name no-error .
     1084     if not available _file then return "":U.
     1085     for each _field no-lock where
     1086              _field._file-recid = recid(_file) :
     1087       assign
     1088       v-dop = v-dop + _field._field-name + chr(44)
     1089       .
     1090     end.
     1091     return trim(v-dop).
     1092   END FUNCTION.
     1093   PROCEDURE proc-full-temp-changes :
     1094     define input  parameter p-act-create as logical   no-undo .
     1095     define input  parameter p-act-delete as logical   no-undo .
     1096     define input  parameter p-hst-handle as handle    no-undo .
     1097     define input  parameter p-main-table as character no-undo .
     1098     define input  parameter p-field-list as character no-undo .
     1099     define input  parameter p-label-form as character no-undo .
     1100     define variable h-new-buf         as handle    no-undo .
     1101     define variable h-main-buf        as handle    no-undo .
     1102     define variable h-for-comp        as handle    no-undo .
     1103     define variable v-inform          as character no-undo .
     1104     define variable v-ind             as integer   no-undo .
     1105     define variable v-idx-field-qnty  as integer   no-undo .
     1106     define variable v-num-entries     as integer   no-undo .
     1107     define variable fh                as handle    no-undo .
     1108     define variable fh-main           as handle    no-undo .
     1109     define variable fh-old            as handle    no-undo .
     1110     define variable fh-new            as handle    no-undo .
     1111     define variable v-field-name      as character no-undo .
     1112     define variable v-field-lvl       as character no-undo .
     1113     define variable v-field-form      as character no-undo .
     1114     define variable v-search-exp      as character no-undo .
     1115     define variable v-srch-main       as character no-undo .
     1116     define variable v-word-link       as character no-undo .
     1117     define variable v-av-chip-num     as logical   no-undo .
     1118     define variable v-main-pi-fld-lst as character no-undo .
     1119     define variable v-main-fld-lst    as character no-undo .
     1120     define variable v-delim-list      as character no-undo .
     1121     define variable v-label           as character no-undo .
     1122     define variable v-old-value       as character no-undo case-sensitive.
     1123     define variable v-new-value       as character no-undo case-sensitive.
     1124     define variable v-chg-fields as character no-undo.
     1125     for each temp-changes:
     1126       delete temp-changes.
     1127     end.
     1128     if not p-hst-handle:available then do:
     1129       return .
     1130     end.
     1131     create buffer h-new-buf  for table p-hst-handle .
     1132     create buffer h-main-buf for table p-main-table .
     1133     assign
     1134       v-inform = h-main-buf:index-information(1)
     1135       v-ind    = 2
     1136     .
     1137     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1138     on error undo, return error
     1139     :
     1140       assign
     1141         v-inform = h-main-buf:index-information( v-ind )
     1142         v-ind    = v-ind + 1
     1143       .
     1144     end.
     1145     if v-inform = ?
     1146       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1147       or entry( 3, v-inform, ",":U ) <> "1":U
     1148     then do:
     1149       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1150     end.
     1151     assign
     1152       v-idx-field-qnty = num-entries( v-inform ) - 4
     1153     .
     1154     if v-idx-field-qnty < 2 then do:
     1155       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1156     end.
     1157     assign
     1158       v-srch-main   = "where":U
     1159       v-word-link   = "":U
     1160       v-av-chip-num = false
     1161       v-delim-list  = "":U
     1162     .
     1163     do v-ind = 1 to v-idx-field-qnty by 2
     1164     on error undo, return error
     1165     :
     1166       assign
     1167         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1168         fh                = p-hst-handle:buffer-field( v-field-name )
     1169         fh-main           = h-main-buf:buffer-field( v-field-name )
     1170         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1171         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1172       .
     1173       if fh:data-type ="character":U then do:
     1174         assign
     1175           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1176         .
     1177       end.
     1178       else do:
     1179         assign
     1180           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1181         .
     1182       end.
     1183       if v-delim-list = "":U then do:
     1184         assign
     1185           v-delim-list = ",":U
     1186         .
     1187       end.
     1188       if v-word-link = "":U then do:
     1189         assign
     1190           v-word-link = "and":U
     1191         .
     1192       end.
     1193     end.
     1194     assign
     1195       v-delim-list  = "":U
     1196     .
     1197     do v-ind = 1 to h-main-buf:num-fields
     1198     on error undo, return error
     1199     :
     1200       assign
     1201         fh-main      = h-main-buf:buffer-field( v-ind )
     1202         v-field-name = fh-main:name
     1203       .
     1204         assign
     1205           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1206         .
     1207         if v-delim-list = "":U then do:
     1208           assign
     1209             v-delim-list = ",":U
     1210           .
     1211         end.
     1212     end.
     1213     assign
     1214       v-inform = p-hst-handle:index-information(1)
     1215       v-ind    = 2
     1216     .
     1217     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1218     on error undo, return error
     1219     :
     1220       assign
     1221         v-inform = p-hst-handle:index-information( v-ind )
     1222         v-ind    = v-ind + 1
     1223       .
     1224     end.
     1225     if v-inform = ?
     1226       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1227       or entry( 3, v-inform, ",":U ) <> "1":U
     1228     then do:
     1229       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1230     end.
     1231     assign
     1232       v-idx-field-qnty = num-entries( v-inform ) - 4
     1233     .
     1234     if v-idx-field-qnty < 2 then do:
     1235       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1236     end.
     1237     assign
     1238       v-search-exp  = "where":U
     1239       v-word-link   = "":U
     1240       v-av-chip-num = false
     1241     .
     1242     do v-ind = 1 to v-idx-field-qnty by 2
     1243     on error undo, return error
     1244     :
     1245       assign
     1246         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1247         fh           = p-hst-handle:buffer-field( v-field-name )
     1248         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1249       .
     1250       if v-field-name = "chip-num":U then do:
     1251         assign
     1252           v-search-exp  = substitute( "&1 >", v-search-exp )
     1253           v-av-chip-num = true
     1254         .
     1255       end.
     1256       else do:
     1257         assign
     1258           v-search-exp = substitute( "&1 =", v-search-exp )
     1259         .
     1260       end.
     1261       if fh:data-type ="character":U then do:
     1262         assign
     1263           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1264         .
     1265       end.
     1266       else do:
     1267         assign
     1268           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1269         .
     1270       end.
     1271       if v-word-link = "":U then do:
     1272         assign
     1273           v-word-link = "and":U
     1274         .
     1275       end.
     1276     end.
     1277     if v-av-chip-num = false then do:
     1278       message
     1279         vss-workfile vss-revision vss-description skip
     1280         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1281         "Использование данной процедуры невозможно!" skip
     1282         view-as alert-box error .
     1283       return error .
     1284     end.
     1285     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1286     if not h-new-buf:available then do:
     1287       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1288       if not h-main-buf:available then do:
     1289         assign
     1290           h-for-comp = ?
     1291         .
     1292       end.
     1293       else do:
     1294         assign
     1295           h-for-comp = h-main-buf
     1296         .
     1297       end.
     1298     end.
     1299     else do:
     1300       assign
     1301         h-for-comp = h-new-buf
     1302       .
     1303     end.
     1304     assign
     1305       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1306     .
     1307     do v-ind = 1 to v-num-entries
     1308     on error undo, return error return-value
     1309     :
     1310       assign
     1311         v-field-name = entry( v-ind, v-main-fld-lst )
     1312         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1313         v-old-value  = fh-old:buffer-value()
     1314         v-label      = trim( fh-old:label )
     1315       .
     1316       if ( trim( p-field-list ) <> "":U
     1317            and lookup( v-field-name, p-field-list ) > 0
     1318          )
     1319          or trim( p-field-list ) = "":U
     1320       then do:
     1321         if h-for-comp <> ? then do:
     1322           assign
     1323             fh-new      = h-for-comp:buffer-field( v-field-name )
     1324             v-new-value = fh-new:buffer-value()
     1325           .
     1326         end.
     1327         else do:
     1328           assign
     1329             v-new-value = "":U
     1330           .
     1331         end.
     1332           if p-act-create = true then do:
     1333             assign
     1334               v-old-value = "":U
     1335             .
     1336           end.
     1337           if p-act-delete = true then do:
     1338             assign
     1339               v-new-value = "":U
     1340             .
     1341           end.
     1342         if v-old-value <> v-new-value
     1343           or lookup(v-field-name,v-main-pi-fld-lst) ne 0
     1344         then do:
     1345           create temp-changes.
     1346           assign
     1347             temp-changes.t_name = p-main-table
     1348             temp-changes.f_name = v-field-name
     1349             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1350             temp-changes.v_old  = trim( v-old-value )
     1351             temp-changes.v_new  = trim( v-new-value )
     1352             temp-changes.num_   = 0
     1353             temp-changes.fNotChange = v-old-value eq v-new-value
     1354           .
     1355         end.
     1356       end.
     1357     end.
     1358     assign
     1359       v-num-entries = num-entries( p-label-form, chr(8) )
     1360     .
     1361         run ParentPars (if p-act-create = true then ? else p-hst-handle,
     1362                             if p-act-delete = true then ? else h-for-comp).
     1363     do v-ind = 1 to v-num-entries
     1364     on error undo, return error return-value
     1365     :
     1366       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1367         assign
     1368           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1369           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1370           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1371         .
     1372         find first temp-changes
     1373           where temp-changes.f_name = v-field-name
     1374           no-error .
     1375         if available temp-changes then do:
     1376           if trim( v-field-lvl ) <> "":U then do:
     1377             assign
     1378               temp-changes.l_name = v-field-lvl
     1379             .
     1380           end.
     1381           if trim( v-field-form ) <> "":U then do:
     1382             assign
     1383               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1384             .
     1385             if h-for-comp <> ? then do:
     1386               assign
     1387                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1388               .
     1389             end.
     1390           end.
     1391         end.
     1392       end.
     1393       else do:
     1394         message
     1395           vss-workfile vss-revision vss-description skip
     1396           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1397           substitute( "список для поля '&1': '&2'"
     1398                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1399                       ,entry( v-ind, p-label-form, chr(8) )
     1400                     ) skip
     1401           substitute( "полный список: &2", p-label-form ) skip
     1402           view-as alert-box error .
     1403       end.
     1404     end.
     1405     delete object h-new-buf .
     1406     delete object h-main-buf .
     1407   END PROCEDURE.
     1408   FUNCTION get-action RETURNS CHARACTER
     1409     ( p-action as integer )  FORWARD.
     1410   FUNCTION get-source-type RETURNS CHARACTER
     1411     ( p-source-type as character )  FORWARD.
     1412   FUNCTION get-subject RETURNS CHARACTER
     1413     ( p-subject as character )  FORWARD.
     1414   FUNCTION local-open-br RETURNS logical
     1415     (  p-open-query     as logical    ,
     1416     p-find-next       as logical    ,
     1417     p-find-condition as character )  FORWARD.
     1418   DEFINE BUTTON B-Help
     1419        LABEL "Помо&щь"
     1420        SIZE 3 BY 1
     1421        BGCOLOR 8 .
     1422   DEFINE BUTTON B-mark
     1423        LABEL "&*"
     1424        SIZE 3 BY 1.
     1425   DEFINE BUTTON B-print
     1426        LABEL "Пе&чать"
     1427        SIZE 3 BY 1.
     1428   DEFINE BUTTON b-quit AUTO-END-KEY
     1429        LABEL "&Выход"
     1430        SIZE 10 BY 1
     1431        BGCOLOR 8 .
     1432   DEFINE BUTTON b-reason
     1433        LABEL "&Причина"
     1434        SIZE 10 BY 1.
     1435   DEFINE BUTTON B-sch
     1436        LABEL "&Фильтр"
     1437        SIZE 3 BY 1.
     1438   DEFINE BUTTON b-sel AUTO-GO
     1439        LABEL "Вы&бор"
     1440        SIZE 10 BY 1
     1441        BGCOLOR 8 .
     1442   DEFINE BUTTON b-nextlevel
     1443        LABEL "Детали"
     1444        SIZE 10 BY 1
     1445        BGCOLOR 8 .
     1446   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1447         VIEW-AS TEXT
     1448        SIZE 6 BY 1
     1449        FGCOLOR 4  NO-UNDO.
     1450   DEFINE VARIABLE sch-obj-code AS CHARACTER FORMAT "X(50)":U
     1451        LABEL "коду"
     1452        VIEW-AS FILL-IN
     1453        SIZE 10 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1454   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1455        LABEL "Дате изменения"
     1456        VIEW-AS FILL-IN
     1457        SIZE 11 BY 1 NO-UNDO.
     1458   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1459        LABEL "пользователю"
     1460        VIEW-AS FILL-IN
     1461        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1462   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1463        LABEL "БД"
     1464        VIEW-AS FILL-IN
     1465        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1466   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1467        LABEL "по БД"
     1468        VIEW-AS FILL-IN
     1469        SIZE 6 BY 1 NO-UNDO.
     1470   DEFINE QUERY BR-changes FOR
     1471         temp-changes SCROLLING.
     1472   DEFINE QUERY br-obj-hist FOR
     1473         X_c-obj-hist SCROLLING.
     1474   DEFINE BROWSE BR-changes
     1475     QUERY BR-changes DISPLAY
     1476         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(200)" width 40
     1477   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1478   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1479       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1480   DEFINE BROWSE br-obj-hist
     1481     QUERY br-obj-hist NO-LOCK DISPLAY
     1482         mark-string(recid(X_c-obj-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1483         X_c-obj-hist.mark COLUMN-LABEL 'Марка' FORMAT 'X(50)':U WIDTH 35
     1484                        X_c-obj-hist.gds-code COLUMN-LABEL 'Код товара' FORMAT '>>>>>>>>9':U
     1485         X_c-obj-hist.corr-date FORMAT "99/99/9999":U COLUMN-LABEL "Дата изм."
     1486         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1487         usrfulnf(X_c-obj-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1488         get-action(X_c-obj-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1489         X_c-obj-hist.corr-user-db-num FORMAT ">>>>9":U COLUMN-LABEL "Дб!созд."
     1490     ENABLE
     1491         X_c-obj-hist.corr-date
     1492       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1493   DEFINE FRAME Dialog-Frame
     1494        b-quit AT ROW 1 COL 1
     1495        B-mark AT ROW 1 COL 11
     1496        b-sel AT ROW 1 COL 21
     1497        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1498        b-nextlevel AT ROW 1 COL 70
     1499        b-reason AT ROW 1 COL 59
     1500        B-print AT ROW 1 COL 89
     1501        B-sch AT ROW 1 COL 92
     1502        B-Help AT ROW 1 COL 95
     1503        br-obj-hist AT ROW 2 COL 1
     1504        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1505        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1506        sch-obj-code AT ROW 13.67 COL 45.13 COLON-ALIGNED
     1507        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1508        BR-changes AT ROW 14.79 COL 1
     1509        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1510        "ПОИСК ПО" VIEW-AS TEXT
     1511             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1512             FGCOLOR 4
     1513        SPACE(89.48) SKIP(7.44)
     1514       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1515            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1516            TITLE
     1517            vLabel
     1518            CANCEL-BUTTON b-quit.
     1519   ASSIGN
     1520          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1521          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1522   ASSIGN
     1523          br-obj-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1524   ON GO OF FRAME Dialog-Frame
     1525   DO:
     1526     p-rid-list = v-rid-list.
     1527   END.
     1528   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1529   DO:
     1530     APPLY "END-ERROR":U TO SELF.
     1531   END.
     1532   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1533   DO:
     1534   define variable loc#log as logical no-undo .
     1535     if available X_c-obj-hist then do:
     1536   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1537   define variable v-str-recid15 as character no-undo .
     1538   define variable v-num-entry15 as integer   no-undo .
     1539   assign
     1540     v-str-recid15 = trim( string( recid( X_c-obj-hist ) , "->>>>>>>>>>>9":U ) )
     1541     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1542   .
     1543   if v-num-entry15 > 0 then do:
     1544     assign
     1545       entry( v-num-entry15, v-rid-list ) = "":U
     1546       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1547     .
     1548   end.
     1549   else do:
     1550     assign
     1551       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1552     .
     1553   end.
     1554       loc#log = br-obj-hist:refresh() .
     1555       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1556           loc#log = br-obj-hist:select-next-row ().
     1557           apply "VALUE-CHANGED" to br-obj-hist in frame Dialog-Frame.
     1558       end.
     1559       if num-entries( v-rid-list ) = 0
     1560       then
     1561           hide mark-num in frame Dialog-Frame.
     1562       else
     1563           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1564     end.
     1565     apply "entry" to br-obj-hist in frame Dialog-Frame.
     1566   END.
     1567   ON CHOOSE OF b-nextlevel IN FRAME Dialog-Frame
     1568   DO:
     1569      define variable vRun as character no-undo.
     1570      vRun = this-procedure:file-name.
     1571      run value(vRun)
     1572         (
     1573          iMark,
     1574          parParentProc,
     1575          p-curr-host-code,
     1576          p-curr-obj-type,
     1577          p-curr-obj-code,
     1578          bttns,
     1579          "one",
     1580          p-corr-user-db-num,
     1581          p-corr-user-name,
     1582          p-subject,
     1583          p-db-num,
     1584          X_c-obj-hist.chip-num ,
     1585          input-output p-rid-list ).
     1586      apply "entry" to br-obj-hist in frame Dialog-Frame.
     1587   END.
     1588   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1589   DO:
     1590       run proc-b-print in this-procedure no-error.
     1591     if error-status:error then return no-apply.
     1592   END.
     1593   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1594   DO:
     1595       run proc-b-sch in this-procedure no-error.
     1596     if error-status:error then return no-apply.
     1597   END.
     1598   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1599   DO:
     1600     if ( available X_c-obj-hist ) then do:
     1601       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1602       then
     1603       v-rid-list = string( recid( X_c-obj-hist ) ) .
     1604     end.
     1605   END.
     1606   ON MOUSE-SELECT-DBLCLICK OF br-obj-hist IN FRAME Dialog-Frame
     1607   DO:
     1608        run proc-br-obj-hist in this-procedure no-error.
     1609     if error-status:error then return no-apply.
     1610   END.
     1611   ON RETURN OF br-obj-hist IN FRAME Dialog-Frame
     1612   DO:
     1613       run proc-br-obj-hist in this-procedure no-error.
     1614     if error-status:error then return no-apply.
     1615   END.
     1616   ON VALUE-CHANGED OF br-obj-hist IN FRAME Dialog-Frame
     1617   DO:
     1618     run proc-view-changes in this-procedure no-error.
     1619   END.
     1620   ON ROW-DISPLAY OF BR-changes IN FRAME Dialog-Frame
     1621   DO:
     1622      if temp-changes.fNotChange
     1623      then do:
     1624         temp-changes.l_name:fGCOLOR in browse BR-changes = GRAY_COLOR.
     1625         temp-changes.v_old:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1626         temp-changes.v_new:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1627      end.
     1628      else do:
     1629         temp-changes.l_name:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1630         temp-changes.v_old:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1631         temp-changes.v_new:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1632      end.
     1633   END.
     1634   ON CTRL-J OF sch-obj-code IN FRAME Dialog-Frame
     1635   DO:
     1636     run proc-find-obj-code in this-procedure(yes, input frame Dialog-Frame sch-obj-code) no-error.
     1637     if error-status:error then return no-apply.
     1638   END.
     1639   ON RETURN OF sch-obj-code IN FRAME Dialog-Frame
     1640   DO:
     1641     run proc-find-obj-code in this-procedure(no, input frame Dialog-Frame sch-obj-code) no-error.
     1642     if error-status:error then return no-apply.
     1643   END.
     1644   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1645   DO:
     1646      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1647     if error-status:error then return no-apply.
     1648   END.
     1649   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1650   DO:
     1651     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1652     if error-status:error then return no-apply.
     1653   END.
     1654   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1655   DO:
     1656     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1657     if error-status:error then return no-apply.
     1658   END.
     1659   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1660   DO:
     1661     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1662     if error-status:error then return no-apply.
     1663   END.
     1664   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
     1665   DO:
     1666     run proc-find-db-num in this-procedure(yes, input frame Dialog-Frame sch-db-num) no-error.
     1667     if error-status:error then return no-apply.
     1668   END.
     1669   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1670   DO:
     1671     run proc-find-db-num in this-procedure(no, input frame Dialog-Frame sch-db-num) no-error.
     1672     if error-status:error then return no-apply.
     1673   END.
     1674   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1675   DO:
     1676     assign
     1677     v-corr-user-db-num
     1678     .
     1679     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     1680   END.
     1681   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1682   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1683   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1684   on help of frame Dialog-Frame
     1685   do:
     1686     run gbl/app_help.p
     1687       (input this-procedure :file-name
     1688       ,input ''
     1689       ,input ?
     1690       ) no-error.
     1691     if error-status :error then do:
     1692       message
     1693         "Ошибка при вызове помощи"
     1694         error-status :get-message(1)
     1695         view-as alert-box .
     1696     end.
     1697   end.
     1698   run minbtn-set in this-procedure .
     1699   on choose of b-help in frame Dialog-Frame
     1700   do:
     1701     apply "help":u to frame Dialog-Frame .
     1702   end.
     1703   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1704   procedure minbtn-set :
     1705       do
     1706           on error undo, return error return-value
     1707           :
     1708           define variable ii              as integer       no-undo .
     1709           define variable fh              as widget-handle no-undo .
     1710           define variable hh              as widget-handle no-undo .
     1711           define variable v-h             as handle        extent 4 no-undo .
     1712           define variable v-name-button   as character     no-undo .
     1713           define variable v-help-old-x    as decimal       no-undo .
     1714           define variable v-help-old-y    as decimal       no-undo .
     1715           define variable v-help-old-size as decimal       no-undo .
     1716           define variable v-frame-width   as decimal       no-undo .
     1717           define variable jj              as integer       no-undo .
     1718           do
     1719               on error undo, return error
     1720               :
     1721               assign
     1722                   v-frame-width = frame Dialog-Frame:width - 0.3
     1723                   fh            = frame Dialog-Frame:first-child
     1724                   hh            = fh:first-child
     1725                   ii            = 1
     1726                   .
     1727               do while valid-handle(hh):
     1728                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1729                   do:
     1730                       case lc(hh:name) :
     1731                           when "b-help" then
     1732                               do:
     1733                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1734                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1735                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1736                                   hh:TOOLTIP = "Помощь" .
     1737                                   v-help-old-x = hh:column .
     1738                                   v-help-old-y = hh:row    .
     1739                                   v-help-old-size = hh:width .
     1740                                   hh:width-chars = 2.5 .
     1741                               end.
     1742                           when "b-print" then
     1743                               do:
     1744                                   hh:load-image("cmp/b-print.bmp":u) .
     1745                                   hh:TOOLTIP = "Печать" .
     1746                                   v-h[ii] = hh:handle .
     1747                                   ii = ii + 1 .
     1748                                   hh:width-chars = 3 .
     1749                               end.
     1750                           when "b-history" or
     1751                           when "b-hist" then
     1752                               do:
     1753                                   hh:load-image("cmp/b-hist.bmp":u) .
     1754                                   hh:TOOLTIP = "История" .
     1755                                   v-h[ii] = hh:handle .
     1756                                   ii = ii + 1 .
     1757                                   hh:width-chars = 3 .
     1758                               end.
     1759                           when "b-sch" then
     1760                               do:
     1761                                   hh:load-image("cmp/b-sch.bmp":u) .
     1762                                   hh:TOOLTIP = "Установка Фильтра" .
     1763                                   v-h[ii] = hh:handle .
     1764                                   ii = ii + 1 .
     1765                                   hh:width-chars = 3 .
     1766                               end.
     1767                           when "b-hist-user" then
     1768                               do:
     1769                                   hh:load-image("cmp/b-hist.bmp":u) .
     1770                                   hh:TOOLTIP = "История пользователя" .
     1771                                   ii = ii + 1 .
     1772                               end.
     1773                       end case.
     1774                   end.
     1775                   hh = hh:next-sibling.
     1776               end.
     1777               b-help:column = v-frame-width - b-help:width-chars.
     1778               jj = 0.
     1779               repeat ii = 4 to 1 by -1 :
     1780                   if valid-handle (v-h[ii] ) then
     1781                   do:
     1782                       jj  = jj + 1 .
     1783                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1784                       v-h[ii]:row    = v-help-old-y .
     1785                   end.
     1786               end.
     1787           end.
     1788       end.
     1789   end procedure.
     1790   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1791   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1792   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1793   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1794   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1795   define variable v-diasize-current-frame-height as decimal   no-undo .
     1796   define variable v-diasize-change-size          as logical   no-undo .
     1797   define variable v-diasize-resize-button        as handle    no-undo .
     1798   define variable v-diasize-wndmax               as logical   no-undo .
     1799   define variable v-diasize-wndstore             as logical   no-undo .
     1800   define variable v-diasize-proc-name            as character no-undo .
     1801   define variable v-diasize-browse-handle        as handle    no-undo .
     1802   define variable v-diasize-browse-number        as integer   no-undo .
     1803   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1804   define temp-table temp-diasize-handle no-undo
     1805     field handle-value  as handle
     1806     field save-position as decimal
     1807     index xpk is primary unique handle-value
     1808     .
     1809   define temp-table temp-browse-handle no-undo
     1810     field browse-type   as character
     1811     field browse-number as integer
     1812     field browse-handle as handle
     1813     field original-size as decimal
     1814     index xpk is primary unique browse-type browse-number
     1815     index xie browse-type browse-handle
     1816   .
     1817   procedure diasize_change-height :
     1818     define input  parameter p-change-value  as decimal   no-undo .
     1819     define input  parameter p-move-resize   as logical   no-undo .
     1820     define variable v-field-group-handle    as handle    no-undo .
     1821     define variable v-object-handle         as handle    no-undo .
     1822     define variable v-frame-height          as decimal   no-undo .
     1823     define variable v-frame-virtual-height  as decimal   no-undo .
     1824     define variable v-browse-height         as decimal   no-undo .
     1825     define variable v-window-height         as decimal   no-undo .
     1826     define variable v-window-virtual-height as decimal   no-undo .
     1827     define variable v-change-sign           as integer   no-undo .
     1828     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1829     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1830     if p-change-value > 0
     1831     then do:
     1832       if frame Dialog-Frame :height + p-change-value
     1833           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1834       then do:
     1835         assign
     1836           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1837                           - (frame Dialog-Frame :height-chars)
     1838         .
     1839         if p-change-value <= 0
     1840         then do:
     1841           run diasize_position-resize-button in this-procedure .
     1842           return .
     1843         end.
     1844       end.
     1845     end.
     1846     if p-change-value < 0
     1847     then do:
     1848       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1849       then do:
     1850         assign
     1851           p-change-value = v-diasize-orig-frame-height
     1852                          - (frame Dialog-Frame :height-chars)
     1853         .
     1854         if p-change-value >= 0
     1855         then do:
     1856           run diasize_position-resize-button in this-procedure .
     1857           return .
     1858         end.
     1859       end.
     1860     end.
     1861     if p-change-value >= 0
     1862     then do:
     1863       assign
     1864         v-change-sign = 1
     1865       .
     1866     end.
     1867     else do:
     1868       assign
     1869         v-change-sign = -1
     1870       .
     1871     end.
     1872     assign
     1873       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1874     .
     1875     if p-change-value = 0
     1876     then do:
     1877       run diasize_position-resize-button in this-procedure .
     1878       return .
     1879     end.
     1880     move_block:
     1881     do
     1882     on error undo move_block, retry move_block
     1883     :
     1884       if retry
     1885       then do:
     1886         do
     1887         on error undo move_block, leave move_block
     1888         :
     1889           if p-change-value > 0
     1890           then do:
     1891             for each buf_temp-diasize-handle
     1892             on error undo, next
     1893             :
     1894               assign
     1895                 v-object-handle = buf_temp-diasize-handle.handle-value
     1896               .
     1897               if v-object-handle <> v-diasize-resize-button
     1898               then do:
     1899                 assign
     1900                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1901                 .
     1902               end.
     1903             end.
     1904             assign
     1905               v-diasize-browse-handle :height = v-browse-height
     1906             .
     1907             for each buf_temp-browse-handle
     1908               where buf_temp-browse-handle.browse-type = 'height':u
     1909             on error undo, next
     1910             :
     1911               assign
     1912                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1913               .
     1914             end.
     1915             assign
     1916               frame Dialog-Frame :height = v-frame-height
     1917             .
     1918             if frame Dialog-Frame :scrollable = true
     1919             then do:
     1920               assign
     1921                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1922               .
     1923             end.
     1924             run diasize_position-resize-button in this-procedure .
     1925           end.
     1926           else do:
     1927             if frame Dialog-Frame :scrollable = true
     1928             then do:
     1929               assign
     1930                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1931               .
     1932             end.
     1933             assign
     1934               frame Dialog-Frame :height = v-frame-height
     1935             .
     1936             assign
     1937               v-diasize-browse-handle :height = v-browse-height
     1938             .
     1939             for each buf_temp-browse-handle
     1940               where buf_temp-browse-handle.browse-type = 'height':u
     1941             on error undo, next
     1942             :
     1943               assign
     1944                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1945               .
     1946             end.
     1947             for each buf_temp-diasize-handle
     1948             on error undo, next
     1949             :
     1950               assign
     1951                 v-object-handle = buf_temp-diasize-handle.handle-value
     1952               .
     1953               if v-object-handle <> v-diasize-resize-button
     1954               then do:
     1955                 assign
     1956                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1957                 .
     1958               end.
     1959             end.
     1960             run diasize_position-resize-button in this-procedure .
     1961           end.
     1962           assign
     1963             v-diasize-change-size = false
     1964           .
     1965           leave move_block .
     1966         end.
     1967       end.
     1968       assign
     1969         v-diasize-need-full-display = true
     1970       .
     1971       if v-diasize-change-size = false
     1972       then do:
     1973         assign
     1974           v-diasize-change-size = true
     1975         .
     1976       end.
     1977       else do:
     1978         return .
     1979       end.
     1980       assign
     1981         v-frame-height = frame Dialog-Frame :height
     1982         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1983         v-browse-height = v-diasize-browse-handle :height
     1984       .
     1985       for each buf_temp-browse-handle
     1986         where buf_temp-browse-handle.browse-type = 'height':u
     1987       :
     1988         assign
     1989           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1990         .
     1991       end.
     1992       for each buf_temp-diasize-handle
     1993       :
     1994         delete buf_temp-diasize-handle .
     1995       end.
     1996       assign
     1997         v-field-group-handle = frame Dialog-Frame :first-child
     1998       .
     1999       do while valid-handle(v-field-group-handle)
     2000       :
     2001         assign
     2002           v-object-handle = v-field-group-handle :first-child
     2003         .
     2004         do while valid-handle(v-object-handle)
     2005         :
     2006           if  v-object-handle <> v-diasize-browse-handle :handle
     2007           and can-query(v-object-handle, "row")
     2008           and can-query(v-object-handle, "height")
     2009           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2010           then do:
     2011             find first buf_temp-browse-handle
     2012               where buf_temp-browse-handle.browse-type   = 'height':u
     2013                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2014               no-error .
     2015             if available buf_temp-browse-handle
     2016             then do:
     2017             end.
     2018             else do:
     2019               create buf_temp-diasize-handle .
     2020               assign
     2021                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2022                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2023               .
     2024             end.
     2025           end.
     2026           assign
     2027             v-object-handle = v-object-handle :next-sibling
     2028           .
     2029         end.
     2030         assign
     2031           v-field-group-handle = v-field-group-handle :next-sibling
     2032         .
     2033       end.
     2034       do with frame Dialog-Frame
     2035       :
     2036         hide v-diasize-resize-button .
     2037         assign
     2038           v-diasize-resize-button :row    = 1
     2039           v-diasize-resize-button :column = 1
     2040         .
     2041       end.
     2042       if p-change-value > 0
     2043       then do:
     2044         if frame Dialog-Frame :scrollable = true
     2045         then do:
     2046           assign
     2047             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2048             no-error .
     2049           if error-status :error
     2050           or error-status :get-message(1) <> ""
     2051           then do:
     2052             undo move_block, retry move_block .
     2053           end.
     2054         end.
     2055         assign
     2056           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2057           no-error .
     2058         if error-status :error
     2059         or error-status :get-message(1) <> ""
     2060         then do:
     2061           undo move_block, retry move_block .
     2062         end.
     2063         assign
     2064           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2065           no-error .
     2066         if error-status :error
     2067         or error-status :get-message(1) <> ""
     2068         then do:
     2069           undo move_block, retry move_block .
     2070         end.
     2071         for each buf_temp-browse-handle
     2072           where buf_temp-browse-handle.browse-type = 'height':u
     2073         on error undo move_block, retry move_block
     2074         :
     2075           assign
     2076             buf_temp-browse-handle.browse-handle :height
     2077               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2078             no-error .
     2079           if error-status :error
     2080           or error-status :get-message(1) <> ""
     2081           then do:
     2082             undo move_block, retry move_block .
     2083           end.
     2084         end.
     2085         for each buf_temp-diasize-handle
     2086         on error undo move_block, retry move_block
     2087         :
     2088           assign
     2089             v-object-handle = buf_temp-diasize-handle.handle-value
     2090           .
     2091           if v-object-handle <> v-diasize-resize-button
     2092           then do:
     2093             assign
     2094               v-object-handle :row = v-object-handle :row + p-change-value
     2095               no-error .
     2096             if error-status :error
     2097             or error-status :get-message(1) <> ""
     2098             then do:
     2099               undo move_block, retry move_block .
     2100             end.
     2101           end.
     2102         end.
     2103       end.
     2104       else do:
     2105         for each buf_temp-diasize-handle
     2106         on error undo move_block, retry move_block
     2107         :
     2108           assign
     2109             v-object-handle = buf_temp-diasize-handle.handle-value
     2110           .
     2111           if v-object-handle <> v-diasize-resize-button
     2112           then do:
     2113             assign
     2114               v-object-handle :row = v-object-handle :row + p-change-value
     2115               no-error .
     2116             if error-status :error
     2117             or error-status :get-message(1) <> ""
     2118             then do:
     2119               undo move_block, retry move_block .
     2120             end.
     2121           end.
     2122         end.
     2123         assign
     2124           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2125           no-error .
     2126         if error-status :error
     2127         or error-status :get-message(1) <> ""
     2128         then do:
     2129           undo move_block, retry move_block .
     2130         end.
     2131         for each buf_temp-browse-handle
     2132           where buf_temp-browse-handle.browse-type = 'height':u
     2133         on error undo move_block, retry move_block
     2134         :
     2135           assign
     2136             buf_temp-browse-handle.browse-handle :height
     2137               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2138             no-error .
     2139           if error-status :error
     2140           or error-status :get-message(1) <> ""
     2141           then do:
     2142             undo move_block, retry move_block .
     2143           end.
     2144         end.
     2145         assign
     2146           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2147           no-error .
     2148         if error-status :error
     2149         or error-status :get-message(1) <> ""
     2150         then do:
     2151           undo move_block, retry move_block .
     2152         end.
     2153         if frame Dialog-Frame :scrollable = true
     2154         then do:
     2155           assign
     2156             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2157             no-error .
     2158           if error-status :error
     2159           or error-status :get-message(1) <> ""
     2160           then do:
     2161             undo move_block, retry move_block .
     2162           end.
     2163         end.
     2164       end.
     2165       if p-move-resize = true
     2166       then do:
     2167         run diasize_position-resize-button in this-procedure .
     2168       end.
     2169       if v-diasize-wndstore = true
     2170       then do:
     2171         if connected("ub") = true
     2172         then do:
     2173           define variable v-cntxt-db-num        as integer   no-undo .
     2174           define variable v-cntxt-userid        as character no-undo .
     2175           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2176                                             , OUTPUT v-cntxt-userid
     2177                                             ) .
     2178           run gbl/wndsizew.p
     2179             (input  v-cntxt-db-num
     2180             ,input  v-cntxt-userid
     2181             ,input  v-diasize-proc-name
     2182             ,input  'height':u
     2183             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2184             ) .
     2185         end.
     2186       end.
     2187     end.
     2188     assign
     2189       v-diasize-change-size = false
     2190     .
     2191   end procedure.
     2192   procedure diasize_set-height :
     2193     define input  parameter p-new-height  as decimal   no-undo .
     2194     define input  parameter p-move-resize as logical   no-undo .
     2195     do
     2196     on error undo, return error return-value
     2197     :
     2198       run diasize_change-height in this-procedure
     2199         (input  (p-new-height - frame Dialog-Frame :height)
     2200         ,input  p-move-resize
     2201         ) .
     2202     end.
     2203   end procedure.
     2204   procedure diasize_change-width :
     2205     define input  parameter p-change-value as decimal   no-undo .
     2206     define input  parameter p-move-resize  as logical   no-undo .
     2207     define variable v-field-group-handle   as handle    no-undo .
     2208     define variable v-object-handle        as handle    no-undo .
     2209     define variable v-frame-width          as decimal   no-undo .
     2210     define variable v-frame-virtual-width  as decimal   no-undo .
     2211     define variable v-browse-width         as decimal   no-undo .
     2212     define variable v-window-width         as decimal   no-undo .
     2213     define variable v-window-virtual-width as decimal   no-undo .
     2214     define variable v-change-sign          as integer   no-undo .
     2215     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2216     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2217     if p-change-value > 0
     2218     then do:
     2219       if frame Dialog-Frame :width + p-change-value >
     2220           session :width-chars
     2221       then do:
     2222         assign
     2223           p-change-value = session :width-chars - frame Dialog-Frame :width
     2224         .
     2225         if p-change-value <= 0
     2226         then do:
     2227           run diasize_position-resize-button in this-procedure .
     2228           return .
     2229         end.
     2230       end.
     2231     end.
     2232     if p-change-value < 0
     2233     then do:
     2234       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2235       then do:
     2236         assign
     2237           p-change-value = v-diasize-orig-frame-width
     2238                          - frame Dialog-Frame :width
     2239         .
     2240         if p-change-value >= 0
     2241         then do:
     2242           run diasize_position-resize-button in this-procedure .
     2243           return .
     2244         end.
     2245       end.
     2246     end.
     2247     if p-change-value >= 0
     2248     then do:
     2249       assign
     2250         v-change-sign = 1
     2251       .
     2252     end.
     2253     else do:
     2254       assign
     2255         v-change-sign = -1
     2256       .
     2257     end.
     2258     assign
     2259       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2260     .
     2261     if p-change-value = 0
     2262     then do:
     2263       run diasize_position-resize-button in this-procedure .
     2264       return .
     2265     end.
     2266     move_block:
     2267     do
     2268     on error undo move_block, leave move_block
     2269     :
     2270       if retry
     2271       then do:
     2272         do
     2273         on error undo move_block, leave move_block
     2274         :
     2275           if p-change-value > 0
     2276           then do:
     2277             for each buf_temp-diasize-handle
     2278             on error undo, next
     2279             :
     2280               assign
     2281                 v-object-handle = buf_temp-diasize-handle.handle-value
     2282               .
     2283               if v-object-handle <> v-diasize-resize-button
     2284               then do:
     2285                 assign
     2286                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2287                 .
     2288               end.
     2289             end.
     2290             assign
     2291               v-diasize-browse-handle :width = v-browse-width
     2292             .
     2293             for each buf_temp-browse-handle
     2294               where buf_temp-browse-handle.browse-type = 'width':u
     2295             on error undo, next
     2296             :
     2297               assign
     2298                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2299               .
     2300             end.
     2301             assign
     2302               frame Dialog-Frame :width = v-frame-width
     2303             .
     2304             if frame Dialog-Frame :scrollable = true
     2305             then do:
     2306               assign
     2307                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2308               .
     2309             end.
     2310             run diasize_position-resize-button in this-procedure .
     2311           end.
     2312           else do:
     2313             if frame Dialog-Frame :scrollable = true
     2314             then do:
     2315               assign
     2316                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2317               .
     2318             end.
     2319             assign
     2320               frame Dialog-Frame :width = v-frame-width
     2321             .
     2322             for each buf_temp-browse-handle
     2323               where buf_temp-browse-handle.browse-type = 'width':u
     2324             on error undo, next
     2325             :
     2326               assign
     2327                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2328               .
     2329             end.
     2330             assign
     2331               v-diasize-browse-handle :width = v-browse-width
     2332             .
     2333             for each buf_temp-diasize-handle
     2334             on error undo, next
     2335             :
     2336               assign
     2337                 v-object-handle = buf_temp-diasize-handle.handle-value
     2338               .
     2339               if v-object-handle <> v-diasize-resize-button
     2340               then do:
     2341                 assign
     2342                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2343                 .
     2344               end.
     2345             end.
     2346             run diasize_position-resize-button in this-procedure .
     2347           end.
     2348           assign
     2349             v-diasize-change-size = false
     2350           .
     2351           leave move_block .
     2352         end.
     2353       end.
     2354       assign
     2355         v-diasize-need-full-display = true
     2356       .
     2357       if v-diasize-change-size = false
     2358       then do:
     2359         assign
     2360           v-diasize-change-size = true
     2361         .
     2362       end.
     2363       else do:
     2364         return .
     2365       end.
     2366       assign
     2367         v-frame-width = frame Dialog-Frame :width
     2368         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2369         v-browse-width = v-diasize-browse-handle :width
     2370       .
     2371       for each buf_temp-browse-handle
     2372         where buf_temp-browse-handle.browse-type = 'width':u
     2373       :
     2374         assign
     2375           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2376         .
     2377       end.
     2378       for each buf_temp-diasize-handle
     2379       :
     2380         delete buf_temp-diasize-handle .
     2381       end.
     2382       assign
     2383         v-field-group-handle = frame Dialog-Frame :first-child
     2384       .
     2385       do while valid-handle(v-field-group-handle)
     2386       :
     2387         assign
     2388           v-object-handle = v-field-group-handle :first-child
     2389         .
     2390         do while valid-handle(v-object-handle)
     2391         :
     2392           if  v-object-handle <> v-diasize-browse-handle :handle
     2393           and v-object-handle <> v-diasize-resize-button
     2394           and can-query(v-object-handle, "row")
     2395           and can-query(v-object-handle, "height")
     2396           and ( v-object-handle :col + v-object-handle :width
     2397                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2398               )
     2399           then do:
     2400             find first buf_temp-browse-handle
     2401               where buf_temp-browse-handle.browse-type   = 'width':u
     2402                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2403               no-error .
     2404             if available buf_temp-browse-handle
     2405             then do:
     2406             end.
     2407             else do:
     2408               create buf_temp-diasize-handle .
     2409               assign
     2410                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2411                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2412               .
     2413             end.
     2414           end.
     2415           assign
     2416             v-object-handle = v-object-handle :next-sibling
     2417           .
     2418         end.
     2419         assign
     2420           v-field-group-handle = v-field-group-handle :next-sibling
     2421         .
     2422       end.
     2423       do with frame Dialog-Frame
     2424       :
     2425         hide v-diasize-resize-button .
     2426         v-diasize-resize-button :row = 1.
     2427         v-diasize-resize-button :column = 1.
     2428       end.
     2429       if p-change-value > 0
     2430       then do:
     2431         if frame Dialog-Frame :scrollable = true
     2432         then do:
     2433           assign
     2434             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2435             no-error .
     2436           if error-status :error
     2437           or error-status :get-message(1) <> ""
     2438           then do:
     2439             undo move_block, retry move_block.
     2440           end.
     2441         end.
     2442         assign
     2443           frame Dialog-Frame :width = v-frame-width + p-change-value
     2444           no-error .
     2445         if error-status :error
     2446         or error-status :get-message(1) <> ""
     2447         then do:
     2448           undo move_block, retry move_block.
     2449         end.
     2450         assign
     2451           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2452         no-error .
     2453         if error-status :error
     2454         or error-status :get-message(1) <> ""
     2455         then do:
     2456           undo move_block, retry move_block.
     2457         end.
     2458         for each buf_temp-browse-handle
     2459           where buf_temp-browse-handle.browse-type = 'width':u
     2460         on error undo move_block, retry move_block
     2461         :
     2462           assign
     2463             buf_temp-browse-handle.browse-handle :width
     2464               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2465             no-error .
     2466           if error-status :error
     2467           or error-status :get-message(1) <> ""
     2468           then do:
     2469             undo move_block, retry move_block .
     2470           end.
     2471         end.
     2472         for each buf_temp-diasize-handle
     2473         on error undo move_block, retry move_block
     2474         :
     2475           assign
     2476             v-object-handle = buf_temp-diasize-handle.handle-value
     2477           .
     2478           if v-object-handle <> v-diasize-resize-button
     2479           then do:
     2480             assign
     2481               v-object-handle :col = v-object-handle :col + p-change-value
     2482               no-error .
     2483             if error-status :error
     2484             or error-status :get-message(1) <> ""
     2485             then do:
     2486               undo move_block, retry move_block .
     2487             end.
     2488           end.
     2489         end.
     2490       end.
     2491       else do:
     2492         for each buf_temp-diasize-handle
     2493         on error undo move_block, retry move_block
     2494         :
     2495           assign
     2496             v-object-handle = buf_temp-diasize-handle.handle-value
     2497           .
     2498           if v-object-handle <> v-diasize-resize-button
     2499           then do:
     2500             assign
     2501               v-object-handle :col = v-object-handle :col + p-change-value
     2502               no-error .
     2503             if error-status :error
     2504             or error-status :get-message(1) <> ""
     2505             then do:
     2506               undo move_block, retry move_block .
     2507             end.
     2508           end.
     2509         end.
     2510         for each buf_temp-browse-handle
     2511           where buf_temp-browse-handle.browse-type = 'width':u
     2512         on error undo move_block, retry move_block
     2513         :
     2514           assign
     2515             buf_temp-browse-handle.browse-handle :width
     2516               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2517             no-error .
     2518           if error-status :error
     2519           or error-status :get-message(1) <> ""
     2520           then do:
     2521             undo move_block, retry move_block .
     2522           end.
     2523         end.
     2524         assign
     2525           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2526           no-error .
     2527         if error-status :error
     2528         or error-status :get-message(1) <> ""
     2529         then do:
     2530           undo move_block, retry move_block.
     2531         end.
     2532         assign
     2533           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2534         no-error .
     2535         if error-status :error
     2536         or error-status :get-message(1) <> ""
     2537         then do:
     2538           undo move_block, retry move_block.
     2539         end.
     2540         if frame Dialog-Frame :scrollable = true
     2541         then do:
     2542           assign
     2543             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2544           no-error .
     2545           if error-status :error
     2546           or error-status :get-message(1) <> ""
     2547           then do:
     2548             undo move_block, retry move_block.
     2549           end.
     2550         end.
     2551       end.
     2552       if p-move-resize
     2553       then do:
     2554         run diasize_position-resize-button in this-procedure .
     2555       end.
     2556       if v-diasize-wndstore = true
     2557       then do:
     2558         if connected("ub") = true
     2559         then do:
     2560           define variable v-cntxt-db-num        as integer   no-undo .
     2561           define variable v-cntxt-userid        as character no-undo .
     2562           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2563                                             , OUTPUT v-cntxt-userid
     2564                                             ) .
     2565           run gbl/wndsizew.p
     2566             (input  v-cntxt-db-num
     2567             ,input  v-cntxt-userid
     2568             ,input  v-diasize-proc-name
     2569             ,input  'width':u
     2570             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2571             ) .
     2572         end.
     2573       end.
     2574     end.
     2575     assign
     2576       v-diasize-change-size = false
     2577     .
     2578   end procedure.
     2579   procedure diasize_set-width :
     2580     define input  parameter p-new-width  as decimal   no-undo .
     2581     define input  parameter p-move-resize as logical   no-undo .
     2582     do
     2583     on error undo, return error return-value
     2584     :
     2585       run diasize_change-width in this-procedure
     2586         (input  (p-new-width - frame Dialog-Frame :width)
     2587         ,input  p-move-resize
     2588         ) .
     2589     end.
     2590   end procedure.
     2591   procedure diasize_position-resize-button :
     2592     do with frame Dialog-Frame
     2593     :
     2594       hide v-diasize-resize-button .
     2595       assign
     2596         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2597                     - 1
     2598                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2599         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2600                     - 1
     2601                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2602       .
     2603       view v-diasize-resize-button .
     2604     end.
     2605   end procedure.
     2606   on alt-right anywhere
     2607   do:
     2608     run diasize_change-width in this-procedure
     2609       (input 1
     2610       ,input true
     2611       ) .
     2612     return no-apply .
     2613   end.
     2614   on alt-left anywhere
     2615   do:
     2616     run diasize_change-width in this-procedure
     2617       (input -1
     2618       ,input true
     2619       ) .
     2620     return no-apply .
     2621   end.
     2622   on alt-down anywhere
     2623   do:
     2624     run diasize_change-height in this-procedure
     2625       (input 1
     2626       ,input true
     2627       ) .
     2628     return no-apply .
     2629   end.
     2630   on alt-up anywhere
     2631   do:
     2632     run diasize_change-height in this-procedure
     2633       (input -1
     2634       ,input true
     2635       ) .
     2636     return no-apply .
     2637   end.
     2638   on alt-enter of frame Dialog-Frame
     2639   do:
     2640     run diasize_maximize in this-procedure
     2641       (input  ?
     2642       ).
     2643     return no-apply .
     2644   end.
     2645   procedure diasize_end-move :
     2646     do
     2647     on error undo, return error return-value
     2648     :
     2649       define variable v-row-delta as decimal   no-undo .
     2650       define variable v-col-delta as decimal   no-undo .
     2651       define variable v-new-row as decimal   no-undo .
     2652       define variable v-new-col as decimal   no-undo .
     2653       assign
     2654         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2655         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2656       .
     2657       assign
     2658         v-row-delta = v-new-row - frame Dialog-Frame :height
     2659         v-col-delta = v-new-col - frame Dialog-Frame :width
     2660       .
     2661       run diasize_change-height in this-procedure
     2662         (input v-row-delta
     2663         ,input true
     2664         ) .
     2665       run diasize_change-width in this-procedure
     2666         (input v-col-delta
     2667         ,input true
     2668         ) .
     2669     end.
     2670   end procedure.
     2671   procedure diasize_maximize :
     2672     define input  parameter p-action as logical   no-undo .
     2673     do
     2674     on error undo, return error return-value
     2675     :
     2676       if p-action = ?
     2677       then do:
     2678         if v-diasize-need-maximize = true
     2679         then do:
     2680           assign
     2681             p-action = true
     2682           .
     2683         end.
     2684         else do:
     2685           assign
     2686             p-action = false
     2687           .
     2688         end.
     2689       end.
     2690       if p-action = true
     2691       then do:
     2692         run diasize_change-height in this-procedure
     2693           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2694               - frame Dialog-Frame :height-chars
     2695           ,input true
     2696           ) .
     2697         run diasize_change-width in this-procedure
     2698           (input session :width-chars
     2699               - frame Dialog-Frame :width-chars
     2700           ,input true
     2701           ) .
     2702         assign
     2703           v-diasize-need-maximize = false
     2704         .
     2705       end.
     2706       else do:
     2707         run diasize_change-width in this-procedure
     2708           (input v-diasize-orig-frame-width
     2709               - frame Dialog-Frame :width-chars
     2710           ,input true
     2711           ) .
     2712         run diasize_change-height in this-procedure
     2713           (input v-diasize-orig-frame-height
     2714               - frame Dialog-Frame :height-chars
     2715           ,input true
     2716           ) .
     2717         assign
     2718           v-diasize-need-maximize = true
     2719         .
     2720       end.
     2721     end.
     2722   end procedure.
     2723   procedure diasize_restore-orig-size :
     2724     do
     2725     on error undo, return error return-value
     2726     :
     2727       assign
     2728         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2729         v-diasize-current-frame-height = frame Dialog-Frame :height
     2730       .
     2731       run diasize_set-height in this-procedure
     2732         (input  v-diasize-orig-frame-height
     2733         ,input  true
     2734         ) .
     2735       run diasize_set-width in this-procedure
     2736         (input  v-diasize-orig-frame-width
     2737         ,input  true
     2738         ) .
     2739     end.
     2740   end procedure.
     2741   procedure diasize_restore-current-size :
     2742     do
     2743     on error undo, return error return-value
     2744     :
     2745       run diasize_set-height in this-procedure
     2746         (input  v-diasize-current-frame-height
     2747         ,input  true
     2748         ) .
     2749       run diasize_set-width in this-procedure
     2750         (input  v-diasize-current-frame-width
     2751         ,input  true
     2752         ) .
     2753     end.
     2754   end procedure.
     2755   procedure diasize_set-browse-handle :
     2756     define input  parameter p-browse-handle as handle   no-undo .
     2757     define buffer buf_temp-browse-handle for temp-browse-handle .
     2758     do
     2759     on error undo, return error return-value
     2760     :
     2761       assign
     2762         v-diasize-browse-handle = p-browse-handle
     2763       .
     2764       for each buf_temp-browse-handle
