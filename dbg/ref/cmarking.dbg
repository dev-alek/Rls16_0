     2932   procedure get-context :
     2933      define output parameter p-db-num as integer          no-undo.
     2934      define output parameter p-user-id as character        no-undo.
     2935      define variable v-login               as character    no-undo.
     2936      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2937      define buffer buf_user-login  for ub.user-login .
     2938      do
     2939      on error undo, return error
     2940      :
     2941            FIND FIRST buf_sys-ctrl no-lock.
     2942            ASSIGN
     2943               v-login = USERID("ub")
     2944               p-db-num = buf_sys-ctrl.db-num
     2945            .
     2946            FIND FIRST buf_user-login
     2947                 WHERE buf_user-login.db-num = p-db-num
     2948                   AND buf_user-login.user-login = v-login
     2949                 no-lock
     2950                 no-error
     2951                 .
     2952            IF AVAILABLE buf_user-login
     2953            THEN DO:
     2954               assign
     2955                  p-user-id = buf_user-login.user-id
     2956               .
     2957            END.
     2958      end.
     2959   end procedure.
