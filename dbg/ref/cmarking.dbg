      136   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define variable c-point  as character no-undo .
      138   define variable tbl      as character no-undo .
      139   define variable join-tbl as character no-undo .
      140   define variable fld      as character no-undo .
      141   define variable lab      as character no-undo .
      142   define variable spr      as character no-undo .
      143   define variable dim      as character no-undo .
      144   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   procedure cur-time :
      146      define output parameter p-today as date      no-undo .
      147      define output parameter p-time  as integer   no-undo .
      148     do
      149     on error undo, return error
      150     :
      151       define variable v-date1 as date      no-undo .
      152       define variable v-date2 as date      no-undo .
      153       define variable v-time  as integer   no-undo .
      154       assign
      155         v-date1 = today
      156         v-time  = time
      157         v-date2 = today
      158       .
      159       if v-date1 <> v-date2
      160       then do:
      161         assign
      162           v-date1 = today
      163           v-time  = v-time
      164         .
      165       end.
      166       assign
      167         p-today = v-date1
      168         p-time  = v-time
      169       .
      170     end.
      171   end.
      172   function cur-time-date returns character
      173   :
      174     return string(today, '99/99/9999':U) .
      175   end.
      176   function cur-time-mjd returns decimal
      177   :
      178     define variable v-date as date      no-undo .
      179     define variable v-time as integer   no-undo .
      180     run cur-time in this-procedure
      181       (output v-date
      182       ,output v-time
      183       ) .
      184     return integer(v-date) - 2400002 + (v-time / 86400) .
      185   end.
      186   function cur-time-get-ending-index returns integer
      187   (input p-number as integer
      188   )
      189   :
      190     if p-number < 0
      191     or p-number = ?
      192     then do:
      193       return 1 .
      194     end.
      195     define variable v-rest as integer   no-undo .
      196     assign
      197       p-number = p-number modulo 100
      198     .
      199     if p-number < 20
      200     then do:
      201       assign
      202         v-rest = p-number
      203       .
      204     end.
      205     else do:
      206       assign
      207         v-rest = p-number modulo 10
      208       .
      209     end.
      210     case v-rest :
      211       when 1
      212       then do:
      213         return 2 .
      214       end.
      215       when 2 or
      216       when 3 or
      217       when 4
      218       then do:
      219         return 3 .
      220       end.
      221       otherwise do:
      222         return 1 .
      223       end.
      224     end case .
      225   end.
      226   procedure cur-time-mjd-to-date :
      227      define input  parameter i-mjd-diff as decimal no-undo.
      228      define output parameter o-Date     as date    no-undo.
      229      define output parameter o-Time     as integer no-undo.
      230      define variable v-day-number as integer   no-undo .
      231      if    i-mjd-diff < 0
      232         or i-mjd-diff = ?
      233      then do:
      234         return "?" .
      235      end.
      236      assign
      237         v-day-number = truncate(i-mjd-diff,0).
      238         o-Date = date(v-day-number + 2400002).
      239         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      240     .
      241   end.
      242   function cur-time-mjd-to-string returns character
      243   (input p-mjd-diff as decimal
      244   )
      245   :
      246     define variable v-day-number as integer   no-undo .
      247     define variable v-seconds    as integer   no-undo .
      248     define variable v-hour       as integer   no-undo .
      249     define variable v-min        as integer   no-undo .
      250     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      251     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      252     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      253     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      254     if p-mjd-diff < 0
      255     or p-mjd-diff = ?
      256     then do:
      257       return "?" .
      258     end.
      259     assign
      260       v-day-number = integer(truncate(p-mjd-diff,0))
      261       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      262     .
      263     if v-seconds > 86400
      264     then do:
      265       assign
      266         v-seconds = 86400 - 1
      267       .
      268     end.
      269     if v-seconds < 0
      270     then do:
      271       assign
      272         v-seconds = 0
      273       .
      274     end.
      275     assign
      276       v-hour = truncate(v-seconds / 3600, 0)
      277     .
      278     assign
      279       v-seconds = v-seconds modulo 3600
      280     .
      281     assign
      282       v-min = truncate(v-seconds / 60, 0)
      283     .
      284     assign
      285       v-seconds = v-seconds modulo 60
      286     .
      287     return
      288         (if v-day-number <> 0
      289           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      290           else ""
      291         )
      292       + (if v-day-number <> 0 or v-hour <> 0
      293           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      294           else ""
      295         )
      296       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      297           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      298           else ""
      299         )
      300       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      301       .
      302   end.
      303   function cur-time-string returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      312   end.
      313   function cur-time-string-sec returns character
      314   :
      315     define variable v-date as date      no-undo .
      316     define variable v-time as integer   no-undo .
      317     run cur-time in this-procedure
      318       (output v-date
      319       ,output v-time
      320       ) .
      321     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      322   end.
      323   function cur-time-custom  returns character
      324   (input p-prefix as character
      325   ,input p-date-format as character
      326   ,input p-delimiter as character
      327   ,input p-time-format as character
      328   ,input p-suffix as character
      329   )
      330   :
      331     define variable v-date as date      no-undo .
      332     define variable v-time as integer   no-undo .
      333     run cur-time in this-procedure
      334       (output v-date
      335       ,output v-time
      336       ) .
      337     return
      338       p-prefix
      339       + string(v-date, p-date-format)
      340       + p-delimiter
      341       + string(v-time, p-time-format)
      342       + p-suffix
      343       .
      344   end.
      345   function cur-time-print  returns character
      346   :
      347     define variable v-date as date      no-undo .
      348     define variable v-time as integer   no-undo .
      349     run cur-time in this-procedure
      350       (output v-date
      351       ,output v-time
      352       ) .
      353     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      354   end.
      355   function cur-time-datetime returns datetime
      356   :
      357     define variable v-char as character no-undo .
      358     define variable v-datetime as datetime no-undo .
      359     v-char = cur-time-string().
      360     v-datetime = datetime(v-char).
      361     return  v-datetime.
      362   end.
      363   function cur-time-string-msec returns character
      364   :
      365     define variable v-date as datetime  no-undo .
      366     v-date = now.
      367     return string(v-date) .
      368   end.
      369   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      371   define new shared variable RepPathName        as character no-undo .
      372   define new shared variable PrintRubl          as logical   no-undo .
      373   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   define variable v-waitfram-action01         as character   no-undo .
      375   define variable v-waitfram-action02         as character   no-undo .
      376   define variable v-waitfram-action03         as character   no-undo .
      377   define variable mWaitFramTextBeg            as character   no-undo.
      378   define variable mWaitFramTextEnd            as character   no-undo.
      379   define variable mWaitFramView               as logical     no-undo.
      380   define variable mWaitProcEvent              as logical     no-undo init yes.
      381   define variable mWaitFramInterval           as integer     no-undo init 1 .
      382   define variable mWaitFramStop               as logical     no-undo.
      383   define variable mWaitFramStopUser           as logical     no-undo.
      384   define variable mWaitFramStopTimeOut        as logical     no-undo.
      385   define variable mWaitFramStartProc          as datetime-tz no-undo.
      386   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      387   define button B-WaitFramStop auto-end-key
      388        label "Стоп"
      389        size 10 by 1 tooltip "Остоновить процесс".
      390   define button B-viewProcInfo
      391        label "Информация"
      392        size 15 by 1 tooltip "Информация о процесс".
      393   define frame waitfram
      394     v-waitfram-action01 format "x(72)" no-label skip
      395     v-waitfram-action02 format "x(72)" no-label skip
      396     v-waitfram-action03 format "x(72)" no-label skip
      397     B-viewProcInfo
      398     B-WaitFramStop at row 4 col 30
      399     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      400     .
      401   define new global shared variable mBatchMode as logical no-undo init ?.
      402   define variable mFramBachModHandle as handle no-undo.
      403   mFramBachModHandle = frame waitfram:handle.
      404   define variable mFameOldVis as logical no-undo.
      405   define variable mVisCUrentVin as logical no-undo.
      406   if session:batch-mode
      407   then
      408      mBatchMode = yes.
      409   if mBatchMode = ? then do:
      410     mVisCUrentVin = current-window:visible.
      411     mFameOldVis = mFramBachModHandle:visible.
      412     mFramBachModHandle:visible  = yes.
      413     mBatchMode = mFramBachModHandle:visible ne yes.
      414     mFramBachModHandle:visible = mFameOldVis.
      415     current-window:visible = mVisCUrentVin.
      416   end.
      417    if  log-manager:logfile-name ne ?
      418     then DO:
      419         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      420         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      421         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      422     end.
      423   on choose of B-WaitFramStop in frame waitfram
      424   do:
      425     mWaitFramStop = yes.
      426     mWaitFramStopUser = yes.
      427   end.
      428   function waitfram-check-timeout returns logical():
      429      define variable vtime as int64 no-undo.
      430      if mWaitFramStopTimeOut
      431      then
      432         return yes.
      433      vtime = ( now - mWaitFramStartProc ) / 1000 .
      434      if     mWaitFramTimeOut ne ?
      435         and mWaitFramTimeOut ne 0
      436         and mWaitFramTimeOut lt vtime
      437      then do:
      438         mWaitFramStopTimeOut = yes.
      439      end.
      440      return mWaitFramStopTimeOut.
      441   end.
      442   procedure waitfram-hide :
      443     if not session:batch-mode
      444     then do
      445     on error undo, return error return-value
      446     :
      447       pause 0 before-hide .
      448       if not mBatchMode then
      449         hide frame waitfram .
      450     end.
      451   end procedure.
      452   procedure waitfram-show :
      453     define input  parameter p-message as character no-undo .
      454     define variable v-left-margin as integer   no-undo .
      455     if not session:batch-mode
      456     then do
      457     on error undo, return error return-value
      458     :
      459       if length(p-message) <= 70 then do:
      460         assign
      461           v-left-margin = integer((70 - length(p-message)) / 2)
      462         .
      463         assign
      464           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      465         .
      466         assign
      467           v-waitfram-action01 = " "
      468           v-waitfram-action02 = " "
      469                                    + fill(" ", v-left-margin)
      470                                    + p-message
      471           v-waitfram-action03 = " "
      472         .
      473       end.
      474       else do:
      475         define variable vRindex1 as integer no-undo.
      476         define variable vRindex2 as integer no-undo.
      477         vRindex1 = r-index(p-message," ",70).
      478         if vRindex1 = 0
      479         then
      480            vRindex1 = 70.
      481         if length(p-message)  <= vRindex1 + 70 then do:
      482           assign
      483             v-waitfram-action01 = " "
      484             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      485             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      486           .
      487         end.
      488         else do:
      489           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      490           if vRindex2 <= vRindex1
      491           then
      492              vRindex2 = vRindex1 + 70.
      493           assign
      494             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      495             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      496             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      497           .
      498         end.
      499       end.
      500       B-viewProcInfo:visible   in frame waitfram = no.
      501       B-viewProcInfo:sensitive in frame waitfram = no.
      502       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      503       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      504       if  (   mWaitFramView
      505          or  mWaitProcEvent)
      506          and not mBatchMode
      507       then
      508          display
      509             v-waitfram-action01 skip
      510             v-waitfram-action02 skip
      511             v-waitfram-action03 skip
      512          with frame waitfram .
      513     end.
      514   end procedure.
      515      procedure waitfram-show-this:
      516         define input  parameter iInterval as int64 no-undo.
      517         define variable vtime as int64 no-undo.
      518         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      519         mWaitFramInterval = iInterval.
      520         run waitfram-show (substitute("&1&2 &3&4" ,
      521                                       mWaitFramTextBeg ,
      522                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      523                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      524                                       mWaitFramTextEnd
      525                                      )
      526                           ).
      527      end.
      528      procedure WaitFramRunPause:
      529         define input  parameter iInterval as dec no-undo.
      530         define variable vStart  as datetime-tz no-undo.
      531         define variable vend    as datetime-tz no-undo.
      532         define variable vint as int64 no-undo.
      533         define variable vOk as logical no-undo.
      534         vStart = now.
      535         vend   = vStart.
      536         publish "WaitFramPause" (iInterval,output vOk).
      537         vend   =  now.
      538         vint = vend - vStart.
      539         vint = iInterval - vint / 1000.
      540         if     not mWaitFramStop
      541            and (   vint > 0
      542                 or (    not vOk
      543                     and iInterval eq ?
      544                     )
      545                 )
      546         then
      547            run waitfram-show-this (iInterval).
      548         vend   =  now.
      549         vint = vend - vStart.
      550         vint = iInterval - vint / 1000.
      551         if     not mWaitFramStop
      552            and vint > 0
      553         then do:
      554            run gbl/pause.p (vint * 1000).
      555         end.
      556         if iInterval ne ?
      557         then
      558            publish "WaitFramStop".
      559         waitfram-check-timeout().
      560      end.
      561      procedure WaitFramWaitFor:
      562         define input  parameter iInterval as dec no-undo.
      563         assign
      564            mWaitFramStartProc   = now
      565            mWaitFramStopUser    = no
      566            mWaitFramStopTimeOut = no
      567         .
      568         block-wait:
      569         do while not mWaitFramStop:
      570            run WaitFramRunPause (iInterval).
      571            if  waitfram-check-timeout()
      572            then do:
      573               leave block-wait.
      574            end.
      575         end.
      576         run waitfram-hide.
      577      end.
      578   procedure waitfram-join :
      579     define input  parameter p-line-1  as character no-undo .
      580     define input  parameter p-line-2  as character no-undo .
      581     define input  parameter p-line-3  as character no-undo .
      582     define output parameter p-message as character no-undo .
      583     do
      584     on error undo, return error return-value
      585     :
      586       assign
      587         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      588                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      589                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      590       .
      591     end.
      592   end procedure.
      593   function waitfram-join-function returns character
      594     (input p-line-1 as character
      595     ,input p-line-2 as character
      596     ,input p-line-3 as character
      597     ).
      598     define variable v-message as character no-undo .
      599     run waitfram-join in this-procedure
      600       (input  p-line-1
      601       ,input  p-line-2
      602       ,input  p-line-3
      603       ,output v-message
      604       ) .
      605     return v-message .
      606   end function .
      607   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608   procedure fltfield-clear :
      609     define output parameter loc-fld as character no-undo.
      610     define output parameter loc-lab as character no-undo .
      611     define output parameter loc-spr as character no-undo .
      612     define output parameter loc-dim as character no-undo .
      613     assign
      614       loc-fld = ""
      615       loc-lab = ""
      616       loc-spr = ""
      617       loc-dim = "0"
      618     .
      619   end procedure .
      620   procedure fltfield-add :
      621     define input        parameter par-fld as character no-undo.
      622     define input        parameter par-lab as character no-undo .
      623     define input        parameter par-spr as character no-undo .
      624     define input-output parameter loc-fld as character no-undo.
      625     define input-output parameter loc-lab as character no-undo .
      626     define input-output parameter loc-spr as character no-undo .
      627     define input-output parameter loc-dim as character no-undo .
      628     do
      629     on error undo, return error
      630     :
      631       assign
      632       loc-fld = if loc-dim = '0'
      633                 then par-fld
      634                 else (loc-fld + chr(44) + par-fld)
      635       loc-lab = if loc-dim = '0'
      636                 then par-lab
      637                 else (loc-lab + chr(44) + par-lab)
      638       loc-spr = if loc-dim = '0'
      639                 then par-spr
      640                 else (loc-spr + chr(44) + par-spr)
      641       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      642                 string(integer(if num-entries(loc-dim) > 1
      643                               then entry(2, loc-dim)
      644                               else entry(1, loc-dim)
      645                               ) + 1)
      646       no-error
      647       .
      648     end.
      649   end procedure.
      650   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      651   define  stream PrnLibStream.
      652   procedure prn-lib-prn-file :
      653     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      654     define input parameter p-DIsabledoptions as integer no-undo .
      655     define variable v-report-name as character no-undo .
      656     define variable v-user-action as character no-undo .
      657     define variable v-printed     as logical   no-undo .
      658     define variable v-exist       as logical   no-undo .
      659     do
      660       on error undo, return error
      661       :
      662       run prn-lib-get-report-name  in this-procedure (
      663         input parParentProc
      664         ,output v-report-name
      665         ).
      666   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      668     (input  v-report-name
      669     ,input  2
      670     ,output v-exist
      671     )  .
      672       if NOT v-exist then
      673       DO:
      674         Message
      675           "Нет заданий на печать ! "
      676           view-as alert-box .
      677         Return  .
      678       End.
      679       run gbl/prnfilen.w
      680         (input  ""
      681         ,input  p-DisabledOptions
      682         ,input  string(v-report-name )
      683         ,input  7
      684         ,output v-user-action
      685         ,output v-printed
      686         ) .
      687       if v-printed then
      688       do:
      689         return "YES" .
      690       end.
      691       else
