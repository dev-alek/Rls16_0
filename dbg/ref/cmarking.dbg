      795   procedure prn-lib-reportviewer :
      796     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      797     define input parameter p-report-name-html as character no-undo .
      798     define input parameter p-param        as character no-undo .
      799     define variable v-excel           as character no-undo init 'TRUE' .
      800     define variable v-value-character as character no-undo .
      801     define variable v-value-integer   as character no-undo .
      802     define variable v-value-date      as date      no-undo .
      803     define variable v-value-decimal   as decimal   no-undo .
