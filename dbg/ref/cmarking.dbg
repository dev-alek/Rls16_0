     3758       define variable  parameter-2-29 as character no-undo .
     3759       define variable  parameter-3-29 as character no-undo .
     3760       define variable  parameter-4-29 as character no-undo .
     3761       define variable  parameter-5-29 as character no-undo .
     3762       define variable  parameter-6-29 as character no-undo .
     3763       define variable  parameter-7-29 as character no-undo .
     3764         assign
     3765         parameter-3-29 =
     3766                                 "FOR EACH X_c-obj-hist"
     3767         parameter-4-29 =
     3768           (
     3769             if (" TRUE " + " " + where-phrase-29) <> ""
