     3794         assign
     3795           l-disable-where-29 =
     3796             (" TRUE " + " " + where-phrase-29 = "")
     3797         .
     3798         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3799                             ,input query br-obj-hist:handle
     3800                             ,input parameter-3-29
     3801                             ,input parameter-4-29
     3802                             ,input parameter-5-29
     3803                             ,input parameter-6-29
     3804                             ,input parameter-7-29
     3805                             )
     3806         .
     3807         assign
     3808           l-filter-open-29 = true
     3809         .
     3810       end.
     3811       if l-filter-open-29 = false then do:
     3812         message
     3813           "Ошибка при фильтрации / сортировке" skip
     3814           "Будут показаны записи без учета фильтра" skip
     3815           view-as alert-box .
     3816       end.
     3817       else do:
     3818           assign
     3819             l-query-was-opened = true
     3820           .
     3821       end.
     3822     end.
     3823     if l-filter-open-29 = false then do:
     3824       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3825         where  TRUE
     3826         indexed-reposition
     3827     .
     3828         assign
     3829           l-query-was-opened = true
     3830         .
     3831     end.
     3832   end.
     3833   else do:
     3834     assign
     3835       v-doc-rec = recid( X_c-obj-hist )
     3836     .
     3837     do
     3838     on stop undo, leave
     3839     on error undo, leave
     3840     :
     3841       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3842         assign
     3843         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3844         parameter-4-29 =
     3845           "where ":u + " TRUE " + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3846         parameter-5-29 = ""
     3847       .
     3848         run fltopend_fltfindd in this-procedure  (
     3849                             input this-procedure:handle
     3850                             ,input query br-obj-hist:handle
     3851                             ,input rowid(X_c-obj-hist)
     3852                             ,input logical(parameter-2-29)
     3853                             ,input no-lock
     3854                             ,input (buffer X_c-obj-hist:handle)
     3855                             ,input parameter-4-29
     3856                             ,input parameter-5-29
     3857                             ) no-error.
     3858         .
     3859         assign
     3860           v-doc-rec = integer(return-value)
     3861           v-fltopend-rowid[1] = ?
     3862         .
     3863       end.
     3864       else do:
     3865         assign
     3866         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3867         parameter-3-29 =  "FOR EACH X_c-obj-hist"
     3868         parameter-4-29 =
     3869           (
     3870             if (" TRUE " + " " + where-phrase-29) <> ""
     3871             then " TRUE " + " " + where-phrase-29
     3872             else "true"
     3873           )
     3874         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3875         parameter-6-29 = if sort-phrase-29 = ''
     3876                              then
     3877           (
     3878           " " + "" +
     3879             " " + sort-column-phrase +
     3880           " " + "  "
     3881           )
     3882                              else
     3883           (
     3884           " " + "" +
     3885             " " + sort-column-phrase +
     3886           " " + sort-phrase-29
     3887           )
     3888         parameter-7-29 =
     3889           " indexed-reposition  "
     3890       .
     3891         run fltopend_fltfindq in this-procedure  (
     3892                             input this-procedure:handle
     3893                             ,input query br-obj-hist:handle
     3894                             ,input logical(parameter-2-29)
     3895                             ,input no-lock
     3896                             ,input parameter-3-29
     3897                             ,input parameter-4-29
     3898                             ,input parameter-5-29
     3899                             ,input parameter-6-29
     3900                             ,input parameter-7-29
     3901                             ,output v-fltopend-rowid
     3902                             ) no-error.
     3903         .
     3904         v-doc-rec = ?.
     3905       end.
     3906       assign
     3907         l-query-was-opened = true
     3908       .
     3909     end.
     3910   end.
     3911     run waitfram-hide in this-procedure .
     3912     end.
     3913   end.
     3914   if not p-open-query and v-doc-rec <> ? then
     3915   REPOSITION br-obj-hist to recid v-doc-rec No-ERROR.
     3916   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3917   query br-obj-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3918   run waitfram-hide in this-procedure .
     3919   APPLY "VALUE-CHANGED" TO br-obj-hist in frame Dialog-Frame.
     3920   APPLY "ENTRY" TO br-obj-hist.
     3921   END PROCEDURE.
     3922   PROCEDURE proc-b-print :
     3923   define variable date_string     as      char    no-undo.
     3924   define variable Line                as      char    no-undo.
     3925   define variable for-time as char.
     3926   define variable accum-count as integer.
     3927   define variable v-doc-rec as recid no-undo.
     3928   define variable v-subject-chr as character no-undo .
     3929   define variable v-upd-time as character no-undo .
     3930   define variable v-obj as character no-undo .
     3931   define variable v-action-chr as character no-undo .
     3932   define variable v-source-type as character no-undo .
     3933   DEFINE FRAME HistoryList
     3934   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3935   X_c-obj-hist.corr-date
     3936   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3937   X_c-obj-hist.corr-user-name
     3938   X_c-obj-hist.corr-user-db-num
     3939   HEADER  date_string AT 5 format "X(35)"
     3940   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3941   Line format "X(195)" AT 1
     3942   with width 232 down stream-io use-text    .
     3943   Line = fill("-", 195).
     3944   date_string = cur-time-print() .
     3945   assign
     3946   v-doc-rec = recid( X_c-obj-hist ).
     3947   DO WHILE available X_c-obj-hist :
     3948         GET prev br-obj-hist.
     3949   END.
     3950   run prn-lib-open-stream  in this-procedure (
     3951                                                input parparentProc
     3952                                               ,input 43
     3953                                               ,input yes
     3954                                               ,input no
     3955                                               ).
     3956   PUT  STREAM PrnLibStream
     3957   SPACE(25) ( frame Dialog-Frame:title )
     3958   format "x(90)" SKIP(1) .
     3959   FORM HEADER
     3960   Line format "X(180)" AT 1 SKIP
     3961   "Продолжение - на следующей странице" AT 30 SKIP
     3962   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3963   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3964   FORM with FRAME HistoryList  .
     3965   run waitfram-show in this-procedure ("Ждите...").
     3966     GET next br-obj-hist.
     3967       DO WHILE available X_c-obj-hist :
     3968         Display STREAM PrnLibStream
     3969          get-action(X_c-obj-hist.action) @ v-action-chr
     3970         X_c-obj-hist.corr-date
     3971         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3972         X_c-obj-hist.corr-user-name
     3973         X_c-obj-hist.corr-user-db-num
     3974         with FRAME HistoryList .
     3975     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3976     assign
     3977     accum-count = accum-count + 1
     3978     .
     3979     GET next br-obj-hist.
     3980   END.
     3981   UNDERLINE  STREAM PrnLibStream
     3982   v-action-chr
     3983   v-subject-chr
     3984   X_c-obj-hist.corr-date
     3985   v-upd-time
     3986   X_c-obj-hist.corr-user-name
     3987   X_c-obj-hist.corr-user-db-num
     3988   with FRAME HistoryList .
     3989   DISPLAY STREAM PrnLibStream
     3990   "ИТОГО"  @ v-obj
     3991   string(accum-count)  @ v-action-chr
     3992   with frame HistoryList.
     3993   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3994   HIDE  STREAM PrnLibStream FRAME CheckList.
     3995   output  STREAM PrnLibStream CLOSE.
     3996   run waitfram-hide in this-procedure.
     3997   run prn-lib-prn-file in this-procedure (
     3998                                             input parparentproc
     3999                                             ,input 8
     4000                                             ).
     4001   reposition br-obj-hist to recid v-doc-rec no-error.
     4002   apply "entry" to br-obj-hist in frame Dialog-Frame.
     4003   END PROCEDURE.
     4004   PROCEDURE proc-b-sch :
     4005   assign
     4006     tbl = "c-marking"
     4007     join-tbl = 'X_c-obj-hist'
     4008     fld = ""
     4009     lab = ""
     4010     spr = ""
     4011     dim = '0'
     4012     .
     4013   run fltfield-add in this-procedure('corr-date', 'Дата корр.', '',
     4014   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4015   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4016   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4017   run fltfield-add in this-procedure('corr-user-db-num', 'БД корр.', '',
     4018   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4019   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4020   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4021   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4022   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4023   Filter-Block:
     4024   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4025       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4026       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4027     run gbl/filter.w ( INPUT parparentproc
     4028                      , INPUT filter-point + chr(4) + filter-label
     4029                      , INPUT tbl
     4030                      , INPUT join-tbl
     4031                      , INPUT fld
     4032                      , INPUT lab
     4033                      , INPUT spr
     4034                      , INPUT dim ).
     4035     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4036   END.
     4037   END PROCEDURE.
     4038   PROCEDURE proc-find-corr-date :
     4039   define input parameter p-next as logical no-undo.
     4040   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4041   define variable v-date-chr as character no-undo.
     4042   if p-date = ? then return .
     4043   display
     4044   0 @ sch-obj-code
     4045   0 @ sch-db-num
     4046   "":U @ sch-corr-user-name
     4047   with frame Dialog-Frame.
     4048   assign
     4049   v-date-chr = string(day(p-date)) + chr(47) +
     4050                    string(month(p-date)) + chr(47) +
     4051                    string(year(p-date)).
     4052          run OpenBr in this-procedure
     4053           (input false
     4054           ,input true
     4055           ,input substitute("and X_c-obj-hist.corr-date = &1 "
     4056             , v-date-chr)
     4057           ,input v-corr-user-db-num
     4058           ).
     4059         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4060   END PROCEDURE.
     4061   PROCEDURE proc-find-db-num :
     4062   define input parameter p-next as logical no-undo.
     4063   define input parameter p-db-num like c-marking.corr-user-db-num no-undo.
     4064   define variable v-db-num as character no-undo.
     4065   assign
     4066   sch-corr-date = ?
     4067   .
     4068   display
     4069   "":U @ sch-corr-user-name
     4070   0 @ sch-obj-code
     4071   sch-corr-date
     4072   with frame Dialog-Frame.
     4073   assign
     4074   v-db-num = string(p-db-num).
     4075   run OpenBr in this-procedure
     4076       (input false
     4077       ,input p-next
     4078       ,input substitute("and X_c-obj-hist.corr-user-db-num = &1 "
     4079         , v-db-num)
     4080       ,input v-corr-user-db-num
     4081       ).
     4082   apply "entry":u to sch-db-num in frame Dialog-Frame .
     4083   END PROCEDURE.
     4084   PROCEDURE proc-find-user :
     4085   define input parameter p-next as logical no-undo.
     4086   define input parameter p-user like c-marking.corr-user-name no-undo.
     4087   assign
     4088   sch-corr-date = ?.
     4089   display
     4090   0 @ sch-db-num
     4091   sch-corr-date
     4092   0 @ sch-obj-code
     4093   with frame Dialog-Frame.
     4094   p-user = chr(34) + p-user + chr(34).
     4095   run OpenBr in this-procedure
     4096       (input false
     4097       ,input p-next
     4098       ,input substitute("and X_c-obj-hist.corr-user-name = &1 "
     4099         , p-user)
     4100       ,input v-corr-user-db-num
     4101       ).
     4102   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4103   END PROCEDURE.
     4104   PROCEDURE proc-view-changes :
     4105   define variable v-description as character no-undo .
     4106   for each temp-changes:
     4107       delete temp-changes.
     4108   END.
     4109   if not available X_c-obj-hist then do:
     4110     b-nextlevel:visible IN FRAME Dialog-Frame = no.
     4111     Open QUery br-changes for each temp-changes.
     4112     return.
     4113   end.
     4114   b-nextlevel:visible IN FRAME Dialog-Frame =  no .
     4115   run local-view-cange in this-procedure (output v-description) .
     4116   Open QUery br-changes for each temp-changes by temp-changes.fNotChange.
     4117   assign
     4118   br-changes:title in frame Dialog-Frame = v-description
     4119   .
     4120   END PROCEDURE.
     4121   FUNCTION get-action RETURNS CHARACTER
     4122     ( p-action as integer ) :
     4123   define variable dops as character no-undo.
     4124   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4125   RETURN dops.
     4126   END FUNCTION.
     4127   FUNCTION get-source-type RETURNS CHARACTER
     4128     ( p-source-type as character ) :
     4129   define variable v-dop as character no-undo .
     4130   assign
     4131   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     4132   no-error
     4133   .
     4134   RETURN v-dop.
     4135   END FUNCTION.
     4136   end.
     4137   else do:
     4138     run ref/cmarkingone.w(
     4139       iMark,
     4140       parParentProc,
     4141       p-curr-host-code,
     4142       p-curr-obj-type,
     4143       p-curr-obj-code,
     4144       bttns,
     4145       p-mode,
     4146       p-corr-user-db-num,
     4147       p-corr-user-name,
     4148       p-subject,
     4149       p-db-num,
     4150       p-chip-num,
     4151       input-output p-rid-list
     4152     ).
     4153   end.
     4154   function getStsName returns character (iSts as int ):
     4155     define variable thMarkSts  as class ibs.th.str.marking.sts.mark no-undo.
     4156     thMarkSts = ObjSrv:Env:Marking:Sts:Mark.
     4157     return thMarkSts:GetLabel(iSts).
     4158   end.
     4159   function getOnlineResultName returns character (iOnlineResult as int ):
     4160     define variable vNames as character no-undo
     4161       init "Запрет продажи,Продажа разрешена,Необходимо проверить сроки годности".
     4162     return if iOnlineResult = ? then "null" else entry(iOnlineResult + 1, vNames).
     4163   end.
     4164   function formatLogicalValue returns character (iValue as character ):
     4165     return if iValue = "" then ? else string(logical(iValue),"Да/Нет").
     4166   end.
     4167   function formatValue returns character (iValue as character ):
     4168     define variable vLog as logical no-undo.
     4169     define variable vDec as decimal no-undo.
     4170     define variable vChr as character no-undo.
     4171     vChr = iValue.
     4172     if iValue <> "" then do:
     4173         vLog = logical(iValue) no-error.
     4174         if vLog <> ? then vChr = string(vLog,"Да/Нет").
     4175         else do:
     4176            vDec = decimal(iValue) no-error.
     4177            if vDec <> ? then vChr = string(vDec).
     4178         end.
     4179     end.
     4180     return vChr.
     4181   end.
     4182   function getAttributeName returns character (iCode as character ):
     4183     return
     4184       if iCode = "notOnlineCheck"
     4185         then "Игнорировать результат online-проверки"
     4186         else if iCode = "weight" then "Вес"
     4187         else "Значение атрибута " + iCode.
     4188   end.
     4189   procedure ParentPars:
     4190      define input  parameter iOldBuf as handle no-undo.
     4191      define input  parameter iCurBuf as handle no-undo.
     4192   end.
     4193   function get-subject returns character
     4194     ( p-subject as character ) :
     4195     return if p-subject = "marking" then "Марка" else "Атрибут марки".
     4196   end function.
     4197   procedure local-view-cange:
     4198     define output parameter odescription as character no-undo.
     4199     define buffer current_c-marking for ub.c-marking  .
     4200     define variable v-mess as character no-undo.
     4201         run getMarking (output odescription).
     4202   end procedure.
     4203   procedure getMarking:
     4204     define output parameter p-description as character no-undo .
     4205     define buffer current_c-marking for ub.c-marking.
     4206     define variable v-mess as character no-undo.
     4207     do
     4208     on error undo, return error return-value
     4209     :
     4210       find first current_c-marking no-lock where
     4211                  current_c-marking.mark = X_c-obj-hist.mark
     4212              and current_c-marking.chip-num = X_c-obj-hist.chip-num
     4213              and current_c-marking.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     4214       if not avail current_c-marking then do:
     4215           v-mess = "Неверная ссылка на марку в таблице c-marking".
     4216           return error  v-mess .
     4217       end.
     4218           define variable v-label-param as character no-undo .
     4219       v-label-param =
     4220             "sts"   + chr(4) + "Статус" + chr(4) + "getStsName" + chr(8)
     4221           + "last-change" + chr(4) + "Изменен" + chr(4) + "" + chr(8)
     4222           + "online-result" + chr(4) + "Результат ГИС МТ" + chr(4) + "getOnlineResultName".
     4223       run proc-full-temp-changes in this-procedure (
     4224                                                    input current_c-marking.action = integer('1':U)
     4225                                                   ,input current_c-marking.action = integer('99':U)
     4226                                                   ,input  buffer current_c-marking:handle
     4227                                                   ,input  "marking"
     4228                                                   ,input  "sts,last-change,online-result"
     4229                                                   ,input  v-label-param).
     4230     end.
     4231   end procedure.
     4232   procedure getMarkingAttr:
     4233     define output parameter p-description as character no-undo .
     4234     define buffer current_c-marking for ub.c-marking-attr.
     4235     define variable v-mess as character no-undo.
     4236     do
     4237     on error undo, return error return-value
     4238     :
     4239       find first current_c-marking no-lock where
     4240                  current_c-marking.mark = X_c-obj-hist.mark
     4241              and current_c-marking.chip-num = X_c-obj-hist.chip-num
     4242              and current_c-marking.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     4243       if not avail current_c-marking then do:
     4244           v-mess = "Неверная ссылка на марку в таблице c-marking".
     4245           return error  v-mess .
     4246       end.
     4247           define variable v-label-param as character no-undo .
     4248       v-label-param =
     4249             "attr-value"   + chr(4) + getAttributeName(current_c-marking.attr-code) + chr(4)
     4250             + (if current_c-marking.attr-code = "notOnlineCheck" then "formatLogicalValue" else "formatValue").
     4251       run proc-full-temp-changes in this-procedure (
     4252                                                    input current_c-marking.action = integer('1':U)
     4253                                                   ,input current_c-marking.action = integer('99':U)
     4254                                                   ,input  buffer current_c-marking:handle
     4255                                                   ,input  "marking-attr"
     4256                                                   ,input  "attr-value"
     4257                                                   ,input  v-label-param).
     4258     end.
     4259   end procedure.
     4260   PROCEDURE proc-find-obj-code :
     4261   define input parameter p-next as logical no-undo.
     4262   define input parameter p-obj-code as character no-undo.
     4263   if p-obj-code = "" then return .
     4264   run OpenBr in this-procedure
     4265       (input false
     4266       ,input true
     4267       ,input substitute("and X_c-obj-hist.mark begins '&1' "
     4268         , p-obj-code)
     4269       ,input v-corr-user-db-num
     4270       ).
     4271   apply "entry":u to sch-obj-code in frame Dialog-Frame.
     4272   END PROCEDURE.
     4273   function local-open-br returns logical (
     4274     p-open-query     as logical    ,
     4275     p-find-next      as logical    ,
     4276     p-find-condition as character
     4277   ):
     4278     return true.
     4279   end.
