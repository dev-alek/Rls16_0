     2769     end.
     2770   end procedure.
     2771   procedure diasize_add_browse :
     2772     define input  parameter p-browse-type   as character no-undo .
     2773     define input  parameter p-browse-handle as handle    no-undo .
     2774     define buffer buf_temp-browse-handle for temp-browse-handle .
