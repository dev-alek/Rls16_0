      697   procedure prn-lib-open-stream :
      698     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      699     define input parameter p-page-size    as integer no-undo .
      700     define input parameter p-is-stream    as logical no-undo .
      701     define input parameter p-append       as logical no-undo .
      702     define variable v-report-name as character no-undo .
      703     do
      704       on error undo, return error
      705       :
      706       run prn-lib-get-report-name  in this-procedure (
      707         input parParentProc
      708         ,output v-report-name
      709         ).
      710       if p-is-stream then
      711       do:
      712         if p-append then
      713         do:
      714           output stream PrnLibStream to value( v-report-name )
      715             page-size value(p-page-size) append .
      716         end.
      717         if not p-append then
      718         do:
      719           output stream PrnLibStream to value( v-report-name )
      720             page-size value(p-page-size) .
      721         end.
      722       end.
      723       if not p-is-stream then
      724       do:
      725         if p-append then
      726         do:
      727           output to value( v-report-name )
      728             page-size value(p-page-size) append .
      729         end.
      730         if not p-append then
      731         do:
      732           output to value( v-report-name )
      733             page-size value(p-page-size) .
      734         end.
      735       end.
      736     end.
      737   end procedure.
      738   procedure prn-lib-open-exp :
      739     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      740     define input parameter p-is-stream    as logical no-undo .
      741     define input parameter p-is-append    as logical no-undo .
      742     define output parameter p-ReportFileName as char init "report" no-undo.
      743     define output parameter p-process as logical no-undo .
      744     define variable glog as logical no-undo .
      745     do
      746       on error undo, return error
      747       :
      748       SYSTEM-DIALOG GET-FILE p-ReportFileName
      749         TITLE      "Укажите путь"
      750         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      751         ASK-OVERWRITE
      752         CREATE-TEST-FILE
      753         SAVE-AS
      754         USE-FILENAME
      755         DEFAULT-EXTENSION "txt"
      756         UPDATE glog
      757         .
      758       if not glog then  return.
      759       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      760       if p-is-stream then
      761       do:
      762         if p-is-append then
      763         do:
      764           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      765         end.
      766         else
      767         do:
      768           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      769         end.
      770       end.
      771       else
      772       do:
      773         if p-is-append then
      774         do:
      775           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      776         end.
      777         else
      778         do:
      779           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      780         end.
      781       end.
      782       p-process = yes.
      783     end.
      784   end procedure.
