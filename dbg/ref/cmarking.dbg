      808     run adm/shattri.p (
      809       input "get":U
      810       ,input  ""
      811       ,input  0
      812       ,input  'report-glob':U
      813       ,input  'rep-excel':U
      814       ,output v-value-character
      815       ,output v-value-date
      816       ,output v-value-decimal
      817       ,output v-value-integer
      818       ,output rep-excel
      819       ,output v-param-type
      820       ,INPUT-OUTPUT table-handle v-tth
      821       )  .
      822     if rep-excel then v-excel = "TRUE" .
      823     else v-excel = "FALSE" .
