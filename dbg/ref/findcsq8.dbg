     2765       if query br-fin-doc:handle:get-buffer-handle(1) = (buffer X_fin-doc:handle) then do:
     2766         assign
     2767         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2768         parameter-4-27 =
     2769           "where ":u +  substitute('X_fin-doc.host-code = &1               AND X_fin-doc.fin-ext-doc-type  = &2&3&2                          AND (X_fin-doc.doc-date  >= &4  AND                             X_fin-doc.doc-date  <= &5)                AND X_fin-doc.cel-nazn-code = &6 ', p-curr-host-code, chr(34), p-fin-ext-doc-type, p-start-date, p-end-date, p-cel-nazn-code) + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     2770         parameter-5-27 = " use-index iext-type "
     2771       .
     2772         run fltopend_fltfindd in this-procedure  (
     2773                             input this-procedure:handle
     2774                             ,input query br-fin-doc:handle
     2775                             ,input rowid(X_fin-doc)
     2776                             ,input logical(parameter-2-27)
     2777                             ,input no-lock
     2778                             ,input (buffer X_fin-doc:handle)
     2779                             ,input parameter-4-27
     2780                             ,input parameter-5-27
     2781                             ) no-error.
     2782         .
     2783         assign
     2784           v-doc-rec = integer(return-value)
     2785           v-fltopend-rowid[1] = ?
     2786         .
     2787       end.
     2788       else do:
     2789         assign
     2790         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2791         parameter-3-27 =  "FOR EACH X_fin-doc"
     2792         parameter-4-27 =
     2793           (
     2794             if (" X_fin-doc.host-code = p-curr-host-code               AND X_fin-doc.fin-ext-doc-type  = p-fin-ext-doc-type                          AND (X_fin-doc.doc-date  >= p-start-date  AND                             X_fin-doc.doc-date  <= p-end-date)                AND X_fin-doc.cel-nazn-code = p-cel-nazn-code " + " " + where-phrase-27) <> ""
     2795             then  substitute('X_fin-doc.host-code = &1               AND X_fin-doc.fin-ext-doc-type  = &2&3&2                          AND (X_fin-doc.doc-date  >= &4  AND                             X_fin-doc.doc-date  <= &5)                AND X_fin-doc.cel-nazn-code = &6 ', p-curr-host-code, chr(34), p-fin-ext-doc-type, p-start-date, p-end-date, p-cel-nazn-code) + " " + where-phrase-27
     2796             else "true"
     2797           )
     2798         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     2799         parameter-6-27 = if sort-phrase-27 = ''
     2800                              then
     2801           (
     2802           " " + " use-index iext-type " +
     2803             " " + sort-column-phrase +
     2804           " " + "  "
     2805           )
     2806                              else
     2807           (
     2808           " " + " use-index iext-type " +
     2809             " " + sort-column-phrase +
     2810           " " + sort-phrase-27
     2811           )
     2812         parameter-7-27 =
     2813           " indexed-reposition  "
     2814       .
     2815         run fltopend_fltfindq in this-procedure  (
     2816                             input this-procedure:handle
     2817                             ,input query br-fin-doc:handle
     2818                             ,input logical(parameter-2-27)
     2819                             ,input no-lock
     2820                             ,input parameter-3-27
     2821                             ,input parameter-4-27
     2822                             ,input parameter-5-27
     2823                             ,input parameter-6-27
     2824                             ,input parameter-7-27
     2825                             ,output v-fltopend-rowid
     2826                             ) no-error.
     2827         .
     2828         v-doc-rec = ?.
     2829       end.
     2830       assign
     2831         l-query-was-opened = true
     2832       .
     2833     end.
     2834   end.
     2835     run waitfram-hide in this-procedure .
     2836           end.
     2837         END CASE.
     2838       END.
     2839   END CASE.
     2840     end.
     2841   end procedure.
