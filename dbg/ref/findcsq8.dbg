      614             if (" X_fin-doc.host-code  = p-curr-host-code                          AND X_fin-doc.status_  = p-status_                          AND (X_fin-doc.fact-order  >= v-start-order  AND                             X_fin-doc.fact-order  <= v-end-order)                          AND X_fin-doc.receiver-code-schet = p-receiver-code-schet " + " " + where-phrase-5) <> ""
