        1   DEFINE BUFFER X_c-place-io FOR ub.c-place-io.
        2   define input        parameter parparentproc   as   widget-handle               no-undo.
        3   define input        parameter p-obj-type      like ub.clients.obj-type         no-undo .
        4   define input        parameter p-obj-code      like ub.clients.obj-code         no-undo .
        5   define input        parameter p-place-io-code like ub.c-place-io.place-io-code no-undo .
        6   define input        parameter bttns           as   character                   no-undo .
        7   define input-output parameter p-rid-list      as   character                   no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":u.
        9   define variable vss-author      as character no-undo init "$Author$":u.
       10   define variable vss-date        as character no-undo init "$Date$":u.
       11   define variable vss-workfile    as character no-undo init "$Workfile$":u.
       12   define variable vss-archive     as character no-undo init "$Archive$":u.
       13   define variable vss-description as character no-undo init "Список истории мест приемки/отгрузки":u.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   define variable c-point  as character no-undo .
      119   define variable tbl      as character no-undo .
      120   define variable join-tbl as character no-undo .
      121   define variable fld      as character no-undo .
      122   define variable lab      as character no-undo .
      123   define variable spr      as character no-undo .
      124   define variable dim      as character no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define variable v-waitfram-action01         as character   no-undo .
      127   define variable v-waitfram-action02         as character   no-undo .
      128   define variable v-waitfram-action03         as character   no-undo .
      129   define variable mWaitFramTextBeg            as character   no-undo.
      130   define variable mWaitFramTextEnd            as character   no-undo.
      131   define variable mWaitFramView               as logical     no-undo.
      132   define variable mWaitProcEvent              as logical     no-undo init yes.
      133   define variable mWaitFramInterval           as integer     no-undo init 1 .
      134   define variable mWaitFramStop               as logical     no-undo.
      135   define variable mWaitFramStopUser           as logical     no-undo.
      136   define variable mWaitFramStopTimeOut        as logical     no-undo.
      137   define variable mWaitFramStartProc          as datetime-tz no-undo.
      138   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      139   define button B-WaitFramStop auto-end-key
      140        label "Стоп"
      141        size 10 by 1 tooltip "Остоновить процесс".
      142   define button B-viewProcInfo
      143        label "Информация"
      144        size 15 by 1 tooltip "Информация о процесс".
      145   define frame waitfram
      146     v-waitfram-action01 format "x(72)" no-label skip
      147     v-waitfram-action02 format "x(72)" no-label skip
      148     v-waitfram-action03 format "x(72)" no-label skip
      149     B-viewProcInfo
      150     B-WaitFramStop at row 4 col 30
      151     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      152     .
      153   define new global shared variable mBatchMode as logical no-undo init ?.
      154   define variable mFramBachModHandle as handle no-undo.
      155   mFramBachModHandle = frame waitfram:handle.
      156   define variable mFameOldVis as logical no-undo.
      157   define variable mVisCUrentVin as logical no-undo.
      158   if session:batch-mode
      159   then
      160      mBatchMode = yes.
      161   if mBatchMode = ? then do:
      162     mVisCUrentVin = current-window:visible.
      163     mFameOldVis = mFramBachModHandle:visible.
      164     mFramBachModHandle:visible  = yes.
      165     mBatchMode = mFramBachModHandle:visible ne yes.
      166     mFramBachModHandle:visible = mFameOldVis.
      167     current-window:visible = mVisCUrentVin.
      168   end.
      169    if  log-manager:logfile-name ne ?
      170     then DO:
      171         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      172         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      173         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      174     end.
      175   on choose of B-WaitFramStop in frame waitfram
      176   do:
      177     mWaitFramStop = yes.
      178     mWaitFramStopUser = yes.
      179   end.
      180   function waitfram-check-timeout returns logical():
      181      define variable vtime as int64 no-undo.
      182      if mWaitFramStopTimeOut
      183      then
      184         return yes.
      185      vtime = ( now - mWaitFramStartProc ) / 1000 .
      186      if     mWaitFramTimeOut ne ?
      187         and mWaitFramTimeOut ne 0
      188         and mWaitFramTimeOut lt vtime
      189      then do:
      190         mWaitFramStopTimeOut = yes.
      191      end.
      192      return mWaitFramStopTimeOut.
      193   end.
      194   procedure waitfram-hide :
      195     if not session:batch-mode
      196     then do
      197     on error undo, return error return-value
      198     :
      199       pause 0 before-hide .
      200       if not mBatchMode then
      201         hide frame waitfram .
      202     if     not mWaitFramView
      203        and mWaitProcEvent
      204     then
      205       process events .
      206     end.
      207   end procedure.
      208   procedure waitfram-show :
      209     define input  parameter p-message as character no-undo .
      210     define variable v-left-margin as integer   no-undo .
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       if length(p-message) <= 70 then do:
      216         assign
      217           v-left-margin = integer((70 - length(p-message)) / 2)
      218         .
      219         assign
      220           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      221         .
      222         assign
      223           v-waitfram-action01 = " "
      224           v-waitfram-action02 = " "
      225                                    + fill(" ", v-left-margin)
      226                                    + p-message
      227           v-waitfram-action03 = " "
      228         .
      229       end.
      230       else do:
      231         define variable vRindex1 as integer no-undo.
      232         define variable vRindex2 as integer no-undo.
      233         vRindex1 = r-index(p-message," ",70).
      234         if vRindex1 = 0
      235         then
      236            vRindex1 = 70.
      237         if length(p-message)  <= vRindex1 + 70 then do:
      238           assign
      239             v-waitfram-action01 = " "
      240             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      242           .
      243         end.
      244         else do:
      245           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      246           if vRindex2 <= vRindex1
      247           then
      248              vRindex2 = vRindex1 + 70.
      249           assign
      250             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      251             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      253           .
      254         end.
      255       end.
      256       B-viewProcInfo:visible   in frame waitfram = no.
      257       B-viewProcInfo:sensitive in frame waitfram = no.
      258       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       if  (   mWaitFramView
      261          or  mWaitProcEvent)
      262          and not mBatchMode
      263       then
      264          display
      265             v-waitfram-action01 skip
      266             v-waitfram-action02 skip
      267             v-waitfram-action03 skip
      268          with frame waitfram .
      269       if     mWaitFramView
      270          then do:
      271             if     mWaitFramInterval ne ?
      272                and not mBatchMode
      273             then
      274                wait-for go of frame waitfram pause mWaitFramInterval.
      275          end.
      276          else
      277             if     mWaitProcEvent
      278                and not mBatchMode
      279             then
      280                process events .
      281     end.
      282   end procedure.
      283      procedure waitfram-show-this:
      284         define input  parameter iInterval as int64 no-undo.
      285         define variable vtime as int64 no-undo.
      286         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      287         mWaitFramInterval = iInterval.
      288         run waitfram-show (substitute("&1&2 &3&4" ,
      289                                       mWaitFramTextBeg ,
      290                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      291                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      292                                       mWaitFramTextEnd
      293                                      )
      294                           ).
      295      end.
      296      procedure WaitFramRunPause:
      297         define input  parameter iInterval as dec no-undo.
      298         define variable vStart  as datetime-tz no-undo.
      299         define variable vend    as datetime-tz no-undo.
      300         define variable vint as int64 no-undo.
      301         define variable vOk as logical no-undo.
      302         vStart = now.
      303         vend   = vStart.
      304         publish "WaitFramPause" (iInterval,output vOk).
      305         vend   =  now.
      306         vint = vend - vStart.
      307         vint = iInterval - vint / 1000.
      308         if     not mWaitFramStop
      309            and (   vint > 0
      310                 or (    not vOk
      311                     and iInterval eq ?
      312                     )
      313                 )
      314         then
      315            run waitfram-show-this (iInterval).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and vint > 0
      321         then do:
      322            run gbl/pause.p (vint * 1000).
      323         end.
      324         if iInterval ne ?
      325         then
      326            publish "WaitFramStop".
      327         waitfram-check-timeout().
      328      end.
      329      procedure WaitFramWaitFor:
      330         define input  parameter iInterval as dec no-undo.
      331         assign
      332            mWaitFramStartProc   = now
      333            mWaitFramStopUser    = no
      334            mWaitFramStopTimeOut = no
      335         .
      336         block-wait:
      337         do while not mWaitFramStop:
      338            run WaitFramRunPause (iInterval).
      339            if  waitfram-check-timeout()
      340            then do:
      341               leave block-wait.
      342            end.
      343         end.
      344         run waitfram-hide.
      345      end.
      346   procedure waitfram-join :
      347     define input  parameter p-line-1  as character no-undo .
      348     define input  parameter p-line-2  as character no-undo .
      349     define input  parameter p-line-3  as character no-undo .
      350     define output parameter p-message as character no-undo .
      351     do
      352     on error undo, return error return-value
      353     :
      354       assign
      355         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      358       .
      359     end.
      360   end procedure.
      361   function waitfram-join-function returns character
      362     (input p-line-1 as character
      363     ,input p-line-2 as character
      364     ,input p-line-3 as character
      365     ).
      366     define variable v-message as character no-undo .
      367     run waitfram-join in this-procedure
      368       (input  p-line-1
      369       ,input  p-line-2
      370       ,input  p-line-3
      371       ,output v-message
      372       ) .
      373     return v-message .
      374   end function .
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   procedure fltfield-clear :
      377     define output parameter loc-fld as character no-undo.
      378     define output parameter loc-lab as character no-undo .
      379     define output parameter loc-spr as character no-undo .
      380     define output parameter loc-dim as character no-undo .
      381     assign
      382       loc-fld = ""
      383       loc-lab = ""
      384       loc-spr = ""
      385       loc-dim = "0"
      386     .
      387   end procedure .
      388   procedure fltfield-add :
      389     define input        parameter par-fld as character no-undo.
      390     define input        parameter par-lab as character no-undo .
      391     define input        parameter par-spr as character no-undo .
      392     define input-output parameter loc-fld as character no-undo.
      393     define input-output parameter loc-lab as character no-undo .
      394     define input-output parameter loc-spr as character no-undo .
      395     define input-output parameter loc-dim as character no-undo .
      396     do
      397     on error undo, return error
      398     :
      399       assign
      400       loc-fld = if loc-dim = '0'
      401                 then par-fld
      402                 else (loc-fld + chr(44) + par-fld)
      403       loc-lab = if loc-dim = '0'
      404                 then par-lab
      405                 else (loc-lab + chr(44) + par-lab)
      406       loc-spr = if loc-dim = '0'
      407                 then par-spr
      408                 else (loc-spr + chr(44) + par-spr)
      409       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      410                 string(integer(if num-entries(loc-dim) > 1
      411                               then entry(2, loc-dim)
      412                               else entry(1, loc-dim)
      413                               ) + 1)
      414       no-error
      415       .
      416     end.
      417   end procedure.
      418   define new global shared variable g#library  as handle no-undo .
      419   define new global shared variable g#library2 as handle no-undo .
      420   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   function usrfulnf returns character ( input p-user-id as character):
      422   define variable v-user-name as character no-undo .
      423   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      425     (input  p-user-id
      426     ,output v-user-name
      427     ) no-error .
      428   if error-status:error
      429   or v-user-name = ""
      430   then do:
      431     return p-user-id.
      432   end.
      433   else do:
      434     return v-user-name.
      435   end.
      436   end function.
      437   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      439   procedure fltopend_fltopend :
      440   define input parameter p-parent-handle as handle no-undo .
      441   define input parameter p-qh as handle no-undo .
      442   define input parameter p-flt-open-open-query  as character no-undo .
      443   define input parameter p-where-cond as character no-undo .
      444   define input parameter p-use-indFIRST-query-tail as character no-undo .
      445   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      446   define input parameter p-indexed-reposition as character no-undo .
      447     do
      448     on error undo, return error
      449     :
      450   define variable v-prepare-string as character no-undo .
      451   define variable glog as logical no-undo .
      452   assign
      453   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      454                      p-where-cond + chr(32)  +
      455                      p-use-indFIRST-query-tail + chr(32) +
      456                      p-use-ind-sort-clmn-by + chr(32) +
      457                      p-indexed-reposition
      458   .
      459   assign
      460   glog = p-qh:query-prepare(v-prepare-string) no-error .
      461   if not glog
      462   or error-status:error then do:
      463     message error-status:get-message(1) view-as alert-box .
      464     undo, return error .
      465   end.
      466   assign
      467   glog = p-qh:query-open no-error .
      468   if not glog
      469   or error-status:error then do:
      470     message error-status:get-message(1) view-as alert-box .
      471     undo, return error .
      472   end.
      473     end.
      474   end procedure.
      475   procedure fltopend_fltfindd :
      476   define input parameter p-parent-handle as handle no-undo .
      477   define input parameter p-qh as handle no-undo .
      478   define input parameter p-rowid as rowid no-undo .
      479   define input parameter p-next as logical no-undo .
      480   define input parameter p-lock as integer no-undo .
      481   define input parameter p-bh as handle no-undo .
      482   define input parameter p-where-cond as character no-undo .
      483   define input parameter p-use-index-phrase as character no-undo .
      484   define variable glog as logical no-undo .
      485   define variable v-qh as handle no-undo .
      486   define variable v-bh as handle no-undo .
      487   define variable v-recid as recid no-undo .
      488   define variable v-prepare-string as character no-undo .
      489   do
      490   on error undo, return error
      491   on stop undo, return error
      492   :
      493     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      494     create buffer v-bh for table p-bh buffer-name p-bh:name.
      495     create query v-qh.
      496     v-qh:set-buffers(v-bh).
      497     v-prepare-string = substitute("for each &1 &2 &3"
      498                                     ,v-bh:name
      499                                     ,p-where-cond
      500                                     ,p-use-index-phrase).
      501     glog = v-qh:query-prepare(v-prepare-string) no-error.
      502     if not glog then do:
      503       delete object v-qh.
      504       delete object v-bh.
      505       undo, return error .
      506     end.
      507     glog = v-qh:query-open no-error .
      508     if not glog then do:
      509       delete object v-qh.
      510       delete object v-bh.
      511       undo, return error .
      512     end.
      513     if p-next then do:
      514       v-qh:reposition-to-rowid(p-rowid) no-error .
      515       glog = v-qh:get-next( p-lock) no-error .
      516       glog = v-qh:get-next( p-lock) no-error .
      517       if not glog or v-qh:query-off-end = yes then do:
      518         glog = v-qh:get-first( p-lock) no-error .
      519       end.
      520     end.
      521     else do:
      522       glog = v-qh:get-first( p-lock) no-error .
      523     end.
      524     v-recid = v-bh:recid no-error .
      525     delete object v-qh.
      526     delete object v-bh.
      527     return string(v-recid) .
      528   end.
      529   end procedure.
      530   procedure fltopend_fltfindq :
      531   define input parameter p-parent-handle as handle no-undo .
      532   define input parameter p-qh as handle no-undo .
      533   define input parameter p-next as logical no-undo .
      534   define input parameter p-lock as integer no-undo .
      535   define input parameter p-flt-open-open-query  as character no-undo .
      536   define input parameter p-where-cond as character no-undo .
      537   define input parameter p-use-indFIRST-query-tail as character no-undo .
      538   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      539   define input parameter p-indexed-reposition as character no-undo .
      540   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      541   define variable glog as logical no-undo .
      542   define variable v-qh as handle no-undo .
      543   define variable v-bh as handle no-undo extent 18.
      544   define variable v-rowid as rowid no-undo extent 18.
      545   define variable v-ii as integer no-undo .
      546   define variable v-prepare-string as character no-undo .
      547   do
      548   on error undo, return error
      549   on stop undo, return error
      550   :
      551     create query v-qh.
      552     do v-ii = 1 to p-qh:num-buffers:
      553       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      554       assign
      555       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      556       no-error.
      557       v-qh:add-buffer(v-bh[v-ii]).
      558     end.
      559     assign
      560     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      561                       p-where-cond + chr(32)  +
      562                       p-use-indFIRST-query-tail + chr(32) +
      563                       p-use-ind-sort-clmn-by + chr(32) +
      564                       p-indexed-reposition
      565     .
      566     glog = v-qh:query-prepare( v-prepare-string) no-error .
      567     if not glog then do:
      568       delete object v-qh.
      569       do v-ii = 1 to p-qh:num-buffers:
      570         delete object v-bh[v-ii].
      571       end.
      572       undo, return error .
      573     end.
      574     glog = v-qh:query-open no-error .
      575     if not glog then do:
      576       delete object v-qh.
      577       do v-ii = 1 to p-qh:num-buffers:
      578         delete object v-bh[v-ii].
      579       end.
      580       undo, return error .
      581     end.
      582     if p-next then do:
      583       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      584       glog = v-qh:get-next( p-lock) no-error .
      585       glog = v-qh:get-next( p-lock) no-error .
      586       if not glog or v-qh:query-off-end = yes then do:
      587         glog = v-qh:get-first( p-lock) no-error .
      588       end.
      589     end.
      590     else do:
      591       glog = v-qh:get-first( p-lock) no-error .
      592     end.
      593     do v-ii = 1 to p-qh:num-buffers:
      594       assign
      595       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      596       no-error.
      597     end.
      598     delete object v-qh.
      599     do v-ii = 1 to p-qh:num-buffers:
      600       delete object v-bh[v-ii].
      601     end.
      602   end.
      603   end procedure.
      604   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   define  temp-table temp-changes no-undo
      606   field f_name as character
      607   field l_name as character
      608   field v_old as character
      609   field v_new as character
      610   field t_name as character
      611   field num_ as integer
      612   field uniq-key-rec as character
      613   field action as integer
      614   field fNotChange as logical
      615   index pi is unique primary
      616   num_
      617   t_name
      618   f_name
      619   index
      620   Chan
      621   fnotChange
      622   t_name
      623   f_name
      624   index imain uniq-key-rec
      625   .
      626   FUNCTION get-all-fields returns character (p-file-name as character ):
      627   define variable v-dop as character no-undo .
      628     find first _file no-lock where _file._file-name = p-file-name no-error .
      629     if not available _file then return "":U.
      630     for each _field no-lock where
      631              _field._file-recid = recid(_file) :
      632       assign
      633       v-dop = v-dop + _field._field-name + chr(44)
      634       .
      635     end.
      636     return trim(v-dop).
      637   END FUNCTION.
      638   PROCEDURE proc-full-temp-changes :
      639     define input  parameter p-hst-handle as handle    no-undo .
      640     define input  parameter p-main-table as character no-undo .
      641     define input  parameter p-field-list as character no-undo .
      642     define input  parameter p-label-form as character no-undo .
      643     define variable h-new-buf         as handle    no-undo .
      644     define variable h-main-buf        as handle    no-undo .
      645     define variable h-for-comp        as handle    no-undo .
      646     define variable v-inform          as character no-undo .
      647     define variable v-ind             as integer   no-undo .
      648     define variable v-idx-field-qnty  as integer   no-undo .
      649     define variable v-num-entries     as integer   no-undo .
      650     define variable fh                as handle    no-undo .
      651     define variable fh-main           as handle    no-undo .
      652     define variable fh-old            as handle    no-undo .
      653     define variable fh-new            as handle    no-undo .
      654     define variable v-field-name      as character no-undo .
      655     define variable v-field-lvl       as character no-undo .
      656     define variable v-field-form      as character no-undo .
      657     define variable v-search-exp      as character no-undo .
      658     define variable v-srch-main       as character no-undo .
      659     define variable v-word-link       as character no-undo .
      660     define variable v-av-chip-num     as logical   no-undo .
      661     define variable v-main-pi-fld-lst as character no-undo .
      662     define variable v-main-fld-lst    as character no-undo .
      663     define variable v-delim-list      as character no-undo .
      664     define variable v-label           as character no-undo .
      665     define variable v-old-value       as character no-undo case-sensitive.
      666     define variable v-new-value       as character no-undo case-sensitive.
      667     define variable v-chg-fields as character no-undo.
      668     for each temp-changes:
      669       delete temp-changes.
      670     end.
      671     if not p-hst-handle:available then do:
      672       return .
      673     end.
      674     create buffer h-new-buf  for table p-hst-handle .
      675     create buffer h-main-buf for table p-main-table .
      676     assign
      677       v-inform = h-main-buf:index-information(1)
      678       v-ind    = 2
      679     .
      680     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      681     on error undo, return error
      682     :
      683       assign
      684         v-inform = h-main-buf:index-information( v-ind )
      685         v-ind    = v-ind + 1
      686       .
      687     end.
      688     if v-inform = ?
      689       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      690       or entry( 3, v-inform, ",":U ) <> "1":U
      691     then do:
      692       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      693     end.
      694     assign
      695       v-idx-field-qnty = num-entries( v-inform ) - 4
      696     .
      697     if v-idx-field-qnty < 2 then do:
      698       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      699     end.
      700     assign
      701       v-srch-main   = "where":U
      702       v-word-link   = "":U
      703       v-av-chip-num = false
      704       v-delim-list  = "":U
      705     .
      706     do v-ind = 1 to v-idx-field-qnty by 2
      707     on error undo, return error
      708     :
      709       assign
      710         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      711         fh                = p-hst-handle:buffer-field( v-field-name )
      712         fh-main           = h-main-buf:buffer-field( v-field-name )
      713         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      714         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      715       .
      716       if fh:data-type ="character":U then do:
      717         assign
      718           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      719         .
      720       end.
      721       else do:
      722         assign
      723           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      724         .
      725       end.
      726       if v-delim-list = "":U then do:
      727         assign
      728           v-delim-list = ",":U
      729         .
      730       end.
      731       if v-word-link = "":U then do:
      732         assign
      733           v-word-link = "and":U
      734         .
      735       end.
      736     end.
      737     assign
      738       v-delim-list  = "":U
      739     .
      740     do v-ind = 1 to h-main-buf:num-fields
      741     on error undo, return error
      742     :
      743       assign
      744         fh-main      = h-main-buf:buffer-field( v-ind )
      745         v-field-name = fh-main:name
      746       .
      747         assign
      748           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      749         .
      750         if v-delim-list = "":U then do:
      751           assign
      752             v-delim-list = ",":U
      753           .
      754         end.
      755     end.
      756     assign
      757       v-inform = p-hst-handle:index-information(1)
      758       v-ind    = 2
      759     .
      760     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      761     on error undo, return error
      762     :
      763       assign
      764         v-inform = p-hst-handle:index-information( v-ind )
      765         v-ind    = v-ind + 1
      766       .
      767     end.
      768     if v-inform = ?
      769       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      770       or entry( 3, v-inform, ",":U ) <> "1":U
      771     then do:
      772       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      773     end.
      774     assign
      775       v-idx-field-qnty = num-entries( v-inform ) - 4
      776     .
      777     if v-idx-field-qnty < 2 then do:
      778       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      779     end.
      780     assign
      781       v-search-exp  = "where":U
      782       v-word-link   = "":U
      783       v-av-chip-num = false
      784     .
      785     do v-ind = 1 to v-idx-field-qnty by 2
      786     on error undo, return error
      787     :
      788       assign
      789         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      790         fh           = p-hst-handle:buffer-field( v-field-name )
      791         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      792       .
      793       if v-field-name = "chip-num":U then do:
      794         assign
      795           v-search-exp  = substitute( "&1 >", v-search-exp )
      796           v-av-chip-num = true
      797         .
      798       end.
      799       else do:
      800         assign
      801           v-search-exp = substitute( "&1 =", v-search-exp )
      802         .
      803       end.
      804       if fh:data-type ="character":U then do:
      805         assign
      806           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      807         .
      808       end.
      809       else do:
      810         assign
      811           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      812         .
      813       end.
      814       if v-word-link = "":U then do:
      815         assign
      816           v-word-link = "and":U
      817         .
      818       end.
      819     end.
      820     if v-av-chip-num = false then do:
      821       message
      822         vss-workfile vss-revision vss-description skip
      823         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      824         "Использование данной процедуры невозможно!" skip
      825         view-as alert-box error .
      826       return error .
      827     end.
      828     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      829     if not h-new-buf:available then do:
      830       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      831       if not h-main-buf:available then do:
      832         assign
      833           h-for-comp = ?
      834         .
      835       end.
      836       else do:
      837         assign
      838           h-for-comp = h-main-buf
      839         .
      840       end.
      841     end.
      842     else do:
      843       assign
      844         h-for-comp = h-new-buf
      845       .
      846     end.
      847     assign
      848       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      849     .
      850     do v-ind = 1 to v-num-entries
      851     on error undo, return error return-value
      852     :
      853       assign
      854         v-field-name = entry( v-ind, v-main-fld-lst )
      855         fh-old       = p-hst-handle:buffer-field( v-field-name )
      856         v-old-value  = fh-old:buffer-value()
      857         v-label      = trim( fh-old:label )
      858       .
      859       if ( trim( p-field-list ) <> "":U
      860            and lookup( v-field-name, p-field-list ) > 0
      861          )
      862          or trim( p-field-list ) = "":U
      863       then do:
      864         if h-for-comp <> ? then do:
      865           assign
      866             fh-new      = h-for-comp:buffer-field( v-field-name )
      867             v-new-value = fh-new:buffer-value()
      868           .
      869         end.
      870         else do:
      871           assign
      872             v-new-value = "":U
      873           .
      874         end.
      875         if v-old-value <> v-new-value
      876         then do:
      877           create temp-changes.
      878           assign
      879             temp-changes.t_name = p-main-table
      880             temp-changes.f_name = v-field-name
      881             temp-changes.l_name = replace( v-label, "&":U, "":U )
      882             temp-changes.v_old  = trim( v-old-value )
      883             temp-changes.v_new  = trim( v-new-value )
      884             temp-changes.num_   = 0
      885             temp-changes.fNotChange = v-old-value eq v-new-value
      886           .
      887         end.
      888       end.
      889     end.
      890     assign
      891       v-num-entries = num-entries( p-label-form, chr(8) )
      892     .
      893     do v-ind = 1 to v-num-entries
      894     on error undo, return error return-value
      895     :
      896       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      897         assign
      898           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      899           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      900           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      901         .
      902         find first temp-changes
      903           where temp-changes.f_name = v-field-name
      904           no-error .
      905         if available temp-changes then do:
      906           if trim( v-field-lvl ) <> "":U then do:
      907             assign
      908               temp-changes.l_name = v-field-lvl
      909             .
      910           end.
      911           if trim( v-field-form ) <> "":U then do:
      912             assign
      913               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      914             .
      915             if h-for-comp <> ? then do:
      916               assign
      917                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      918               .
      919             end.
      920           end.
      921         end.
      922       end.
      923       else do:
      924         message
      925           vss-workfile vss-revision vss-description skip
      926           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      927           substitute( "список для поля '&1': '&2'"
      928                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      929                       ,entry( v-ind, p-label-form, chr(8) )
      930                     ) skip
      931           substitute( "полный список: &2", p-label-form ) skip
      932           view-as alert-box error .
      933       end.
      934     end.
      935     delete object h-new-buf .
      936     delete object h-main-buf .
      937   END PROCEDURE.
      938   define variable filter-point as character no-undo init "Список истории мест приемки/отгрузки" .
      939   define variable filter-point0 as character no-undo init "Список истории мест приемки/отгрузки" .
      940   define variable sort-column-name as character no-undo .
      941   define variable v-doc-rec as recid no-undo .
      942   define variable title0 as character no-undo.
      943   FUNCTION mark-string RETURNS CHARACTER
      944     ( input par-recid as recid, input mark-list as character)  FORWARD.
      945   DEFINE BUTTON b-Help
      946        LABEL "Помо&щь"
      947        SIZE 10 BY 1
      948        BGCOLOR 8 .
      949   DEFINE BUTTON b-mark
      950        LABEL "&*"
      951        SIZE 3 BY 1.
      952   DEFINE BUTTON b-quit AUTO-GO
      953        LABEL "&Выход"
      954        SIZE 10 BY 1
      955        BGCOLOR 8 .
      956   DEFINE BUTTON b-sch
      957        LABEL "&Фильтр"
      958        SIZE 10 BY 1.
      959   DEFINE BUTTON b-sel AUTO-GO
      960        LABEL "Вы&бор"
      961        SIZE 10 BY 1
      962        BGCOLOR 8 .
      963   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      964         VIEW-AS TEXT
      965        SIZE 6 BY 1
      966        FGCOLOR 4  NO-UNDO.
      967   DEFINE QUERY br-c-place-io FOR
      968         X_c-place-io SCROLLING.
      969   DEFINE QUERY BR-changes FOR
      970         temp-changes SCROLLING.
      971   DEFINE BROWSE br-c-place-io
      972     QUERY br-c-place-io NO-LOCK DISPLAY
      973         mark-string(recid(X_c-place-io), p-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      974         X_c-place-io.corr-date COLUMN-LABEL "Дата!изменения" FORMAT "99/99/9999":U
      975         string(X_c-place-io.corr-time,"HH:MM") COLUMN-LABEL "Время!изменения" FORMAT "X(5)":U
      976               WIDTH 9
      977         usrfulnf(X_c-place-io.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
      978         X_c-place-io.place-io-type COLUMN-LABEL "Место" FORMAT "X(8)":U
      979         X_c-place-io.place-io-code FORMAT "9999999":U
      980         X_c-place-io.place-io-name COLUMN-LABEL "Наименование" FORMAT "X(40)":U
      981         substitute( "&1 &2", X_c-place-io.obj-type, X_c-place-io.obj-code) COLUMN-LABEL "Объект" FORMAT "X(13)":U
      982         X_c-place-io.status_ FORMAT "X(8)":U
      983         X_c-place-io.PS FORMAT "X(50)":U
      984       WITH NO-ROW-MARKERS SEPARATORS SIZE 96 BY 13.71.
      985   DEFINE BROWSE BR-changes
      986     QUERY BR-changes DISPLAY
      987         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(35)"
      988   temp-changes.v_old COLUMn-LABEL "Было" format "X(40)"
      989   temp-changes.v_new COLUMn-LABEL "Стало" format "X(40)"
      990       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.88 BY 5.83.
      991   DEFINE FRAME Dialog-Frame
      992        b-quit AT ROW 1 COL 1
      993        b-mark AT ROW 1 COL 11
      994        b-sel AT ROW 1 COL 21
      995        b-sch AT ROW 1 COL 41
      996        b-Help AT ROW 1 COL 86.25
      997        br-c-place-io AT ROW 2 COL 1.38
      998        BR-changes AT ROW 16.04 COL 1.38
      999        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1000        SPACE(77.49) SKIP(20.03)
     1001       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1002            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1003            TITLE "История изменения мест прима/отгрузки"
     1004            CANCEL-BUTTON b-quit.
     1005   ASSIGN
     1006          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1007          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1008   ASSIGN
     1009          br-c-place-io:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1010   ON ENDKEY OF FRAME Dialog-Frame
     1011   DO:
     1012       run gbl/markqwa.p ( input b-mark:sensitive, input p-rid-list) no-error.
     1013       if error-status:error then return no-apply.
     1014   END.
     1015   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1016   DO:
     1017   define variable loc#log as logical no-undo .
     1018     if available X_c-place-io then do:
     1019         if can-do( p-rid-list, string( recid( X_c-place-io ) ) ) then do:
     1020             p-rid-list = replace( p-rid-list, chr(44) + string( recid( X_c-place-io ) ), "") .
     1021             p-rid-list = replace( p-rid-list, string( recid( X_c-place-io ) ) + chr(44), "") .
     1022             p-rid-list = replace( p-rid-list, string( recid( X_c-place-io ) ), "") .
     1023         end.
     1024         else
     1025         p-rid-list = p-rid-list + ( if p-rid-list = "" then "" else chr(44) ) + string( recid( X_c-place-io ) ) .
     1026         loc#log = br-c-place-io:refresh() .
     1027         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1028             loc#log = br-c-place-io:select-next-row ().
     1029             apply "VALUE-CHANGED" to br-c-place-io in frame Dialog-Frame.
     1030         end.
     1031         if num-entries( p-rid-list ) = 0 then hide mark-num in frame Dialog-Frame.
     1032         else disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1033     end.
     1034     apply "entry" to br-c-place-io in frame Dialog-Frame.
     1035   END.
     1036   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1037   DO:
     1038     assign
     1039       tbl = 'c-place-io'
     1040       join-tbl = 'X_c-place-io'
     1041       fld = ""
     1042       lab = ""
     1043       spr = ""
     1044       dim = '0'
     1045     .
     1046     run fltfield-add in this-procedure('obj-code', 'Код объекта', '',
     1047     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1048     run fltfield-add in this-procedure('obj-type', 'Тип объекта', '',
     1049     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1050     run fltfield-add in this-procedure('place-io-type', 'Тип места', '',
     1051     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1052     run fltfield-add in this-procedure('place-io-code', 'Код места', '',
     1053     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1054     run fltfield-add in this-procedure('place-io-name', 'Название места', '',
     1055     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1056     run fltfield-add in this-procedure('status_', 'Статус', '',
     1057     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1058     run fltfield-add in this-procedure('PS', 'Примечание', '',
     1059     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1060   Filter-Block:
     1061     DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     1062        ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     1063        ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     1064       run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     1065       RUN OpenBr(yes, no, '':U).
     1066     end.
     1067   END.
     1068   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1069   DO:
     1070     if ( available X_c-place-io ) AND ( p-rid-list = "" ) then  p-rid-list = string( recid( X_c-place-io ) ) .
     1071   END.
     1072   ON RETURN OF br-c-place-io IN FRAME Dialog-Frame
     1073   or MOUSE-SELECT-DBLCLICK OF br-c-place-io IN FRAME Dialog-Frame
     1074   DO:
     1075     if b-sel:sensitive in frame Dialog-Frame then
     1076       if b-mark:sensitive then apply "choose" to b-mark in frame Dialog-Frame.
     1077       else                     apply "choose" to b-sel in frame Dialog-Frame.
     1078   END.
     1079   ON VALUE-CHANGED OF br-c-place-io IN FRAME Dialog-Frame
     1080   DO:
     1081     define variable v-label-param as character no-undo .
     1082     if available X_c-place-io then do:
     1083       assign
     1084         v-label-param =
     1085           "place-io-code" + chr(4) + "Номер" + chr(4) + "" + chr(8)
     1086         + "place-io-name" + chr(4) + "Наименование" + chr(4) + "" + chr(8)
     1087         + "place-io-type" + chr(4) + "Тип" + chr(4) + "" + chr(8)
     1088         + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     1089         + "status_" + chr(4) + "Статус" + chr(4) + ""
     1090       .
     1091       run proc-full-temp-changes in this-procedure
     1092         ( input (buffer X_c-place-io:handle)
     1093          ,input 'place-io':U
     1094          ,input "place-io-code,place-io-name,place-io-type,PS,status_":U
     1095          ,input v-label-param
     1096         ) no-error.
     1097     end.
     1098     else do:
     1099       for each temp-changes
     1100       :
     1101         delete temp-changes .
     1102       end.
     1103     end.
     1104     OPEN QUERY BR-changes FOR EACH temp-changes.
     1105   END.
     1106   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1107   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1108   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1109   on help of frame Dialog-Frame
     1110   do:
     1111     run gbl/app_help.p
     1112       (input this-procedure :file-name
     1113       ,input ''
     1114       ,input ?
     1115       ) no-error.
     1116     if error-status :error then do:
     1117       message
     1118         "Ошибка при вызове помощи"
     1119         error-status :get-message(1)
     1120         view-as alert-box .
     1121     end.
     1122   end.
     1123   run minbtn-set in this-procedure .
     1124   on choose of b-help in frame Dialog-Frame
     1125   do:
     1126     apply "help":u to frame Dialog-Frame .
     1127   end.
     1128   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1129   procedure minbtn-set :
     1130       do
     1131           on error undo, return error return-value
     1132           :
     1133           define variable ii              as integer       no-undo .
     1134           define variable fh              as widget-handle no-undo .
     1135           define variable hh              as widget-handle no-undo .
     1136           define variable v-h             as handle        extent 4 no-undo .
     1137           define variable v-name-button   as character     no-undo .
     1138           define variable v-help-old-x    as decimal       no-undo .
     1139           define variable v-help-old-y    as decimal       no-undo .
     1140           define variable v-help-old-size as decimal       no-undo .
     1141           define variable v-frame-width   as decimal       no-undo .
     1142           define variable jj              as integer       no-undo .
     1143           do
     1144               on error undo, return error
     1145               :
     1146               assign
     1147                   v-frame-width = frame Dialog-Frame:width - 0.3
     1148                   fh            = frame Dialog-Frame:first-child
     1149                   hh            = fh:first-child
     1150                   ii            = 1
     1151                   .
     1152               do while valid-handle(hh):
     1153                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1154                   do:
     1155                       case lc(hh:name) :
     1156                           when "b-help" then
     1157                               do:
     1158                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1159                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1160                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1161                                   hh:TOOLTIP = "Помощь" .
     1162                                   v-help-old-x = hh:column .
     1163                                   v-help-old-y = hh:row    .
     1164                                   v-help-old-size = hh:width .
     1165                                   hh:width-chars = 2.5 .
     1166                               end.
     1167                           when "b-print" then
     1168                               do:
     1169                                   hh:load-image("cmp/b-print.bmp":u) .
     1170                                   hh:TOOLTIP = "Печать" .
     1171                                   v-h[ii] = hh:handle .
     1172                                   ii = ii + 1 .
     1173                                   hh:width-chars = 3 .
     1174                               end.
     1175                           when "b-history" or
     1176                           when "b-hist" then
     1177                               do:
     1178                                   hh:load-image("cmp/b-hist.bmp":u) .
     1179                                   hh:TOOLTIP = "История" .
     1180                                   v-h[ii] = hh:handle .
     1181                                   ii = ii + 1 .
     1182                                   hh:width-chars = 3 .
     1183                               end.
     1184                           when "b-sch" then
     1185                               do:
     1186                                   hh:load-image("cmp/b-sch.bmp":u) .
     1187                                   hh:TOOLTIP = "Установка Фильтра" .
     1188                                   v-h[ii] = hh:handle .
     1189                                   ii = ii + 1 .
     1190                                   hh:width-chars = 3 .
     1191                               end.
     1192                           when "b-hist-user" then
     1193                               do:
     1194                                   hh:load-image("cmp/b-hist.bmp":u) .
     1195                                   hh:TOOLTIP = "История пользователя" .
     1196                                   ii = ii + 1 .
     1197                               end.
     1198                       end case.
     1199                   end.
     1200                   hh = hh:next-sibling.
     1201               end.
     1202               b-help:column = v-frame-width - b-help:width-chars.
     1203               jj = 0.
     1204               repeat ii = 4 to 1 by -1 :
     1205                   if valid-handle (v-h[ii] ) then
     1206                   do:
     1207                       jj  = jj + 1 .
     1208                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1209                       v-h[ii]:row    = v-help-old-y .
     1210                   end.
     1211               end.
     1212           end.
     1213       end.
     1214   end procedure.
     1215   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1216   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1217   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1218   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1219   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1220   define variable v-diasize-current-frame-height as decimal   no-undo .
     1221   define variable v-diasize-change-size          as logical   no-undo .
     1222   define variable v-diasize-resize-button        as handle    no-undo .
     1223   define variable v-diasize-wndmax               as logical   no-undo .
     1224   define variable v-diasize-wndstore             as logical   no-undo .
     1225   define variable v-diasize-proc-name            as character no-undo .
     1226   define variable v-diasize-browse-handle        as handle    no-undo .
     1227   define variable v-diasize-browse-number        as integer   no-undo .
     1228   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1229   define temp-table temp-diasize-handle no-undo
     1230     field handle-value  as handle
     1231     field save-position as decimal
     1232     index xpk is primary unique handle-value
     1233     .
     1234   define temp-table temp-browse-handle no-undo
     1235     field browse-type   as character
     1236     field browse-number as integer
     1237     field browse-handle as handle
     1238     field original-size as decimal
     1239     index xpk is primary unique browse-type browse-number
     1240     index xie browse-type browse-handle
     1241   .
     1242   procedure diasize_change-height :
     1243     define input  parameter p-change-value  as decimal   no-undo .
     1244     define input  parameter p-move-resize   as logical   no-undo .
     1245     define variable v-field-group-handle    as handle    no-undo .
     1246     define variable v-object-handle         as handle    no-undo .
     1247     define variable v-frame-height          as decimal   no-undo .
     1248     define variable v-frame-virtual-height  as decimal   no-undo .
     1249     define variable v-browse-height         as decimal   no-undo .
     1250     define variable v-window-height         as decimal   no-undo .
     1251     define variable v-window-virtual-height as decimal   no-undo .
     1252     define variable v-change-sign           as integer   no-undo .
     1253     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1254     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1255     if p-change-value > 0
     1256     then do:
     1257       if frame Dialog-Frame :height + p-change-value
     1258           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1259       then do:
     1260         assign
     1261           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1262                           - (frame Dialog-Frame :height-chars)
     1263         .
     1264         if p-change-value <= 0
     1265         then do:
     1266           run diasize_position-resize-button in this-procedure .
     1267           return .
     1268         end.
     1269       end.
     1270     end.
     1271     if p-change-value < 0
     1272     then do:
     1273       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1274       then do:
     1275         assign
     1276           p-change-value = v-diasize-orig-frame-height
     1277                          - (frame Dialog-Frame :height-chars)
     1278         .
     1279         if p-change-value >= 0
     1280         then do:
     1281           run diasize_position-resize-button in this-procedure .
     1282           return .
     1283         end.
     1284       end.
     1285     end.
     1286     if p-change-value >= 0
     1287     then do:
     1288       assign
     1289         v-change-sign = 1
     1290       .
     1291     end.
     1292     else do:
     1293       assign
     1294         v-change-sign = -1
     1295       .
     1296     end.
     1297     assign
     1298       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1299     .
     1300     if p-change-value = 0
     1301     then do:
     1302       run diasize_position-resize-button in this-procedure .
     1303       return .
     1304     end.
     1305     move_block:
     1306     do
     1307     on error undo move_block, retry move_block
     1308     :
     1309       if retry
     1310       then do:
     1311         do
     1312         on error undo move_block, leave move_block
     1313         :
     1314           if p-change-value > 0
     1315           then do:
     1316             for each buf_temp-diasize-handle
     1317             on error undo, next
     1318             :
     1319               assign
     1320                 v-object-handle = buf_temp-diasize-handle.handle-value
     1321               .
     1322               if v-object-handle <> v-diasize-resize-button
     1323               then do:
     1324                 assign
     1325                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1326                 .
     1327               end.
     1328             end.
     1329             assign
     1330               v-diasize-browse-handle :height = v-browse-height
     1331             .
     1332             for each buf_temp-browse-handle
     1333               where buf_temp-browse-handle.browse-type = 'height':u
     1334             on error undo, next
     1335             :
     1336               assign
     1337                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1338               .
     1339             end.
     1340             assign
     1341               frame Dialog-Frame :height = v-frame-height
     1342             .
     1343             if frame Dialog-Frame :scrollable = true
     1344             then do:
     1345               assign
     1346                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1347               .
     1348             end.
     1349             run diasize_position-resize-button in this-procedure .
     1350           end.
     1351           else do:
     1352             if frame Dialog-Frame :scrollable = true
     1353             then do:
     1354               assign
     1355                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1356               .
     1357             end.
     1358             assign
     1359               frame Dialog-Frame :height = v-frame-height
     1360             .
     1361             assign
     1362               v-diasize-browse-handle :height = v-browse-height
     1363             .
     1364             for each buf_temp-browse-handle
     1365               where buf_temp-browse-handle.browse-type = 'height':u
     1366             on error undo, next
     1367             :
     1368               assign
     1369                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1370               .
     1371             end.
     1372             for each buf_temp-diasize-handle
     1373             on error undo, next
     1374             :
     1375               assign
     1376                 v-object-handle = buf_temp-diasize-handle.handle-value
     1377               .
     1378               if v-object-handle <> v-diasize-resize-button
     1379               then do:
     1380                 assign
     1381                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1382                 .
     1383               end.
     1384             end.
     1385             run diasize_position-resize-button in this-procedure .
     1386           end.
     1387           assign
     1388             v-diasize-change-size = false
     1389           .
     1390           leave move_block .
     1391         end.
     1392       end.
     1393       assign
     1394         v-diasize-need-full-display = true
     1395       .
     1396       if v-diasize-change-size = false
     1397       then do:
     1398         assign
     1399           v-diasize-change-size = true
     1400         .
     1401       end.
     1402       else do:
     1403         return .
     1404       end.
     1405       assign
     1406         v-frame-height = frame Dialog-Frame :height
     1407         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1408         v-browse-height = v-diasize-browse-handle :height
     1409       .
     1410       for each buf_temp-browse-handle
     1411         where buf_temp-browse-handle.browse-type = 'height':u
     1412       :
     1413         assign
     1414           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1415         .
     1416       end.
     1417       for each buf_temp-diasize-handle
     1418       :
     1419         delete buf_temp-diasize-handle .
     1420       end.
     1421       assign
     1422         v-field-group-handle = frame Dialog-Frame :first-child
     1423       .
     1424       do while valid-handle(v-field-group-handle)
     1425       :
     1426         assign
     1427           v-object-handle = v-field-group-handle :first-child
     1428         .
     1429         do while valid-handle(v-object-handle)
     1430         :
     1431           if  v-object-handle <> v-diasize-browse-handle :handle
     1432           and can-query(v-object-handle, "row")
     1433           and can-query(v-object-handle, "height")
     1434           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1435           then do:
     1436             find first buf_temp-browse-handle
     1437               where buf_temp-browse-handle.browse-type   = 'height':u
     1438                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1439               no-error .
     1440             if available buf_temp-browse-handle
     1441             then do:
     1442             end.
     1443             else do:
     1444               create buf_temp-diasize-handle .
     1445               assign
     1446                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1447                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1448               .
     1449             end.
     1450           end.
     1451           assign
     1452             v-object-handle = v-object-handle :next-sibling
     1453           .
     1454         end.
     1455         assign
     1456           v-field-group-handle = v-field-group-handle :next-sibling
     1457         .
     1458       end.
     1459       do with frame Dialog-Frame
     1460       :
     1461         hide v-diasize-resize-button .
     1462         assign
     1463           v-diasize-resize-button :row    = 1
     1464           v-diasize-resize-button :column = 1
     1465         .
     1466       end.
     1467       if p-change-value > 0
     1468       then do:
     1469         if frame Dialog-Frame :scrollable = true
     1470         then do:
     1471           assign
     1472             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1473             no-error .
     1474           if error-status :error
     1475           or error-status :get-message(1) <> ""
     1476           then do:
     1477             undo move_block, retry move_block .
     1478           end.
     1479         end.
     1480         assign
     1481           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1482           no-error .
     1483         if error-status :error
     1484         or error-status :get-message(1) <> ""
     1485         then do:
     1486           undo move_block, retry move_block .
     1487         end.
     1488         assign
     1489           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1490           no-error .
     1491         if error-status :error
     1492         or error-status :get-message(1) <> ""
     1493         then do:
     1494           undo move_block, retry move_block .
     1495         end.
     1496         for each buf_temp-browse-handle
     1497           where buf_temp-browse-handle.browse-type = 'height':u
     1498         on error undo move_block, retry move_block
     1499         :
     1500           assign
     1501             buf_temp-browse-handle.browse-handle :height
     1502               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1503             no-error .
     1504           if error-status :error
     1505           or error-status :get-message(1) <> ""
     1506           then do:
     1507             undo move_block, retry move_block .
     1508           end.
     1509         end.
     1510         for each buf_temp-diasize-handle
     1511         on error undo move_block, retry move_block
     1512         :
     1513           assign
     1514             v-object-handle = buf_temp-diasize-handle.handle-value
     1515           .
     1516           if v-object-handle <> v-diasize-resize-button
     1517           then do:
     1518             assign
     1519               v-object-handle :row = v-object-handle :row + p-change-value
     1520               no-error .
     1521             if error-status :error
     1522             or error-status :get-message(1) <> ""
     1523             then do:
     1524               undo move_block, retry move_block .
     1525             end.
     1526           end.
     1527         end.
     1528       end.
     1529       else do:
     1530         for each buf_temp-diasize-handle
     1531         on error undo move_block, retry move_block
     1532         :
     1533           assign
     1534             v-object-handle = buf_temp-diasize-handle.handle-value
     1535           .
     1536           if v-object-handle <> v-diasize-resize-button
     1537           then do:
     1538             assign
     1539               v-object-handle :row = v-object-handle :row + p-change-value
     1540               no-error .
     1541             if error-status :error
     1542             or error-status :get-message(1) <> ""
     1543             then do:
     1544               undo move_block, retry move_block .
     1545             end.
     1546           end.
     1547         end.
     1548         assign
     1549           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1550           no-error .
     1551         if error-status :error
     1552         or error-status :get-message(1) <> ""
     1553         then do:
     1554           undo move_block, retry move_block .
     1555         end.
     1556         for each buf_temp-browse-handle
     1557           where buf_temp-browse-handle.browse-type = 'height':u
     1558         on error undo move_block, retry move_block
     1559         :
     1560           assign
     1561             buf_temp-browse-handle.browse-handle :height
     1562               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1563             no-error .
     1564           if error-status :error
     1565           or error-status :get-message(1) <> ""
     1566           then do:
     1567             undo move_block, retry move_block .
     1568           end.
     1569         end.
     1570         assign
     1571           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1572           no-error .
     1573         if error-status :error
     1574         or error-status :get-message(1) <> ""
     1575         then do:
     1576           undo move_block, retry move_block .
     1577         end.
     1578         if frame Dialog-Frame :scrollable = true
     1579         then do:
     1580           assign
     1581             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1582             no-error .
     1583           if error-status :error
     1584           or error-status :get-message(1) <> ""
     1585           then do:
     1586             undo move_block, retry move_block .
     1587           end.
     1588         end.
     1589       end.
     1590       if p-move-resize = true
     1591       then do:
     1592         run diasize_position-resize-button in this-procedure .
     1593       end.
     1594       if v-diasize-wndstore = true
     1595       then do:
     1596         if connected("ub") = true
     1597         then do:
     1598           define variable v-cntxt-db-num        as integer   no-undo .
     1599           define variable v-cntxt-userid        as character no-undo .
     1600           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1601                                             , OUTPUT v-cntxt-userid
     1602                                             ) .
     1603           run gbl/wndsizew.p
     1604             (input  v-cntxt-db-num
     1605             ,input  v-cntxt-userid
     1606             ,input  v-diasize-proc-name
     1607             ,input  'height':u
     1608             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1609             ) .
     1610         end.
     1611       end.
     1612     end.
     1613     assign
     1614       v-diasize-change-size = false
     1615     .
     1616   end procedure.
     1617   procedure diasize_set-height :
     1618     define input  parameter p-new-height  as decimal   no-undo .
     1619     define input  parameter p-move-resize as logical   no-undo .
     1620     do
     1621     on error undo, return error return-value
     1622     :
     1623       run diasize_change-height in this-procedure
     1624         (input  (p-new-height - frame Dialog-Frame :height)
     1625         ,input  p-move-resize
     1626         ) .
     1627     end.
     1628   end procedure.
     1629   procedure diasize_change-width :
     1630     define input  parameter p-change-value as decimal   no-undo .
     1631     define input  parameter p-move-resize  as logical   no-undo .
     1632     define variable v-field-group-handle   as handle    no-undo .
     1633     define variable v-object-handle        as handle    no-undo .
     1634     define variable v-frame-width          as decimal   no-undo .
     1635     define variable v-frame-virtual-width  as decimal   no-undo .
     1636     define variable v-browse-width         as decimal   no-undo .
     1637     define variable v-window-width         as decimal   no-undo .
     1638     define variable v-window-virtual-width as decimal   no-undo .
     1639     define variable v-change-sign          as integer   no-undo .
     1640     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1641     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1642     if p-change-value > 0
     1643     then do:
     1644       if frame Dialog-Frame :width + p-change-value >
     1645           session :width-chars
     1646       then do:
     1647         assign
     1648           p-change-value = session :width-chars - frame Dialog-Frame :width
     1649         .
     1650         if p-change-value <= 0
     1651         then do:
     1652           run diasize_position-resize-button in this-procedure .
     1653           return .
     1654         end.
     1655       end.
     1656     end.
     1657     if p-change-value < 0
     1658     then do:
     1659       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1660       then do:
     1661         assign
     1662           p-change-value = v-diasize-orig-frame-width
     1663                          - frame Dialog-Frame :width
     1664         .
     1665         if p-change-value >= 0
     1666         then do:
     1667           run diasize_position-resize-button in this-procedure .
     1668           return .
     1669         end.
     1670       end.
     1671     end.
     1672     if p-change-value >= 0
     1673     then do:
     1674       assign
     1675         v-change-sign = 1
     1676       .
     1677     end.
     1678     else do:
     1679       assign
     1680         v-change-sign = -1
     1681       .
     1682     end.
     1683     assign
     1684       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1685     .
     1686     if p-change-value = 0
     1687     then do:
     1688       run diasize_position-resize-button in this-procedure .
     1689       return .
     1690     end.
     1691     move_block:
     1692     do
     1693     on error undo move_block, leave move_block
     1694     :
     1695       if retry
     1696       then do:
     1697         do
     1698         on error undo move_block, leave move_block
     1699         :
     1700           if p-change-value > 0
     1701           then do:
     1702             for each buf_temp-diasize-handle
     1703             on error undo, next
     1704             :
     1705               assign
     1706                 v-object-handle = buf_temp-diasize-handle.handle-value
     1707               .
     1708               if v-object-handle <> v-diasize-resize-button
     1709               then do:
     1710                 assign
     1711                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1712                 .
     1713               end.
     1714             end.
     1715             assign
     1716               v-diasize-browse-handle :width = v-browse-width
     1717             .
     1718             for each buf_temp-browse-handle
     1719               where buf_temp-browse-handle.browse-type = 'width':u
     1720             on error undo, next
     1721             :
     1722               assign
     1723                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1724               .
     1725             end.
     1726             assign
     1727               frame Dialog-Frame :width = v-frame-width
     1728             .
     1729             if frame Dialog-Frame :scrollable = true
     1730             then do:
     1731               assign
     1732                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1733               .
     1734             end.
     1735             run diasize_position-resize-button in this-procedure .
     1736           end.
     1737           else do:
     1738             if frame Dialog-Frame :scrollable = true
     1739             then do:
     1740               assign
     1741                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1742               .
     1743             end.
     1744             assign
     1745               frame Dialog-Frame :width = v-frame-width
     1746             .
     1747             for each buf_temp-browse-handle
     1748               where buf_temp-browse-handle.browse-type = 'width':u
     1749             on error undo, next
     1750             :
     1751               assign
     1752                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1753               .
     1754             end.
     1755             assign
     1756               v-diasize-browse-handle :width = v-browse-width
     1757             .
     1758             for each buf_temp-diasize-handle
     1759             on error undo, next
     1760             :
     1761               assign
     1762                 v-object-handle = buf_temp-diasize-handle.handle-value
     1763               .
     1764               if v-object-handle <> v-diasize-resize-button
     1765               then do:
     1766                 assign
     1767                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1768                 .
     1769               end.
     1770             end.
     1771             run diasize_position-resize-button in this-procedure .
     1772           end.
     1773           assign
     1774             v-diasize-change-size = false
     1775           .
     1776           leave move_block .
     1777         end.
     1778       end.
     1779       assign
     1780         v-diasize-need-full-display = true
     1781       .
     1782       if v-diasize-change-size = false
     1783       then do:
     1784         assign
     1785           v-diasize-change-size = true
     1786         .
     1787       end.
     1788       else do:
     1789         return .
     1790       end.
     1791       assign
     1792         v-frame-width = frame Dialog-Frame :width
     1793         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1794         v-browse-width = v-diasize-browse-handle :width
     1795       .
     1796       for each buf_temp-browse-handle
     1797         where buf_temp-browse-handle.browse-type = 'width':u
     1798       :
     1799         assign
     1800           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1801         .
     1802       end.
     1803       for each buf_temp-diasize-handle
     1804       :
     1805         delete buf_temp-diasize-handle .
     1806       end.
     1807       assign
     1808         v-field-group-handle = frame Dialog-Frame :first-child
     1809       .
     1810       do while valid-handle(v-field-group-handle)
     1811       :
     1812         assign
     1813           v-object-handle = v-field-group-handle :first-child
     1814         .
     1815         do while valid-handle(v-object-handle)
     1816         :
     1817           if  v-object-handle <> v-diasize-browse-handle :handle
     1818           and v-object-handle <> v-diasize-resize-button
     1819           and can-query(v-object-handle, "row")
     1820           and can-query(v-object-handle, "height")
     1821           and ( v-object-handle :col + v-object-handle :width
     1822                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1823               )
     1824           then do:
     1825             find first buf_temp-browse-handle
     1826               where buf_temp-browse-handle.browse-type   = 'width':u
     1827                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1828               no-error .
     1829             if available buf_temp-browse-handle
     1830             then do:
     1831             end.
     1832             else do:
     1833               create buf_temp-diasize-handle .
     1834               assign
     1835                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1836                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1837               .
     1838             end.
     1839           end.
     1840           assign
     1841             v-object-handle = v-object-handle :next-sibling
     1842           .
     1843         end.
     1844         assign
     1845           v-field-group-handle = v-field-group-handle :next-sibling
     1846         .
     1847       end.
     1848       do with frame Dialog-Frame
     1849       :
     1850         hide v-diasize-resize-button .
     1851         v-diasize-resize-button :row = 1.
     1852         v-diasize-resize-button :column = 1.
     1853       end.
     1854       if p-change-value > 0
     1855       then do:
     1856         if frame Dialog-Frame :scrollable = true
     1857         then do:
     1858           assign
     1859             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1860             no-error .
     1861           if error-status :error
     1862           or error-status :get-message(1) <> ""
     1863           then do:
     1864             undo move_block, retry move_block.
     1865           end.
     1866         end.
     1867         assign
     1868           frame Dialog-Frame :width = v-frame-width + p-change-value
     1869           no-error .
     1870         if error-status :error
     1871         or error-status :get-message(1) <> ""
     1872         then do:
     1873           undo move_block, retry move_block.
     1874         end.
     1875         assign
     1876           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1877         no-error .
     1878         if error-status :error
     1879         or error-status :get-message(1) <> ""
     1880         then do:
     1881           undo move_block, retry move_block.
     1882         end.
     1883         for each buf_temp-browse-handle
     1884           where buf_temp-browse-handle.browse-type = 'width':u
     1885         on error undo move_block, retry move_block
     1886         :
     1887           assign
     1888             buf_temp-browse-handle.browse-handle :width
     1889               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1890             no-error .
     1891           if error-status :error
     1892           or error-status :get-message(1) <> ""
     1893           then do:
     1894             undo move_block, retry move_block .
     1895           end.
     1896         end.
     1897         for each buf_temp-diasize-handle
     1898         on error undo move_block, retry move_block
     1899         :
     1900           assign
     1901             v-object-handle = buf_temp-diasize-handle.handle-value
     1902           .
     1903           if v-object-handle <> v-diasize-resize-button
     1904           then do:
     1905             assign
     1906               v-object-handle :col = v-object-handle :col + p-change-value
     1907               no-error .
     1908             if error-status :error
     1909             or error-status :get-message(1) <> ""
     1910             then do:
     1911               undo move_block, retry move_block .
     1912             end.
     1913           end.
     1914         end.
     1915       end.
     1916       else do:
     1917         for each buf_temp-diasize-handle
     1918         on error undo move_block, retry move_block
     1919         :
     1920           assign
     1921             v-object-handle = buf_temp-diasize-handle.handle-value
     1922           .
     1923           if v-object-handle <> v-diasize-resize-button
     1924           then do:
     1925             assign
     1926               v-object-handle :col = v-object-handle :col + p-change-value
     1927               no-error .
     1928             if error-status :error
     1929             or error-status :get-message(1) <> ""
     1930             then do:
     1931               undo move_block, retry move_block .
     1932             end.
     1933           end.
     1934         end.
     1935         for each buf_temp-browse-handle
     1936           where buf_temp-browse-handle.browse-type = 'width':u
     1937         on error undo move_block, retry move_block
     1938         :
     1939           assign
     1940             buf_temp-browse-handle.browse-handle :width
     1941               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1942             no-error .
     1943           if error-status :error
     1944           or error-status :get-message(1) <> ""
     1945           then do:
     1946             undo move_block, retry move_block .
     1947           end.
     1948         end.
     1949         assign
     1950           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1951           no-error .
     1952         if error-status :error
     1953         or error-status :get-message(1) <> ""
     1954         then do:
     1955           undo move_block, retry move_block.
     1956         end.
     1957         assign
     1958           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1959         no-error .
     1960         if error-status :error
     1961         or error-status :get-message(1) <> ""
     1962         then do:
     1963           undo move_block, retry move_block.
     1964         end.
     1965         if frame Dialog-Frame :scrollable = true
     1966         then do:
     1967           assign
     1968             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1969           no-error .
     1970           if error-status :error
     1971           or error-status :get-message(1) <> ""
     1972           then do:
     1973             undo move_block, retry move_block.
     1974           end.
     1975         end.
     1976       end.
     1977       if p-move-resize
     1978       then do:
     1979         run diasize_position-resize-button in this-procedure .
     1980       end.
     1981       if v-diasize-wndstore = true
     1982       then do:
     1983         if connected("ub") = true
     1984         then do:
     1985           define variable v-cntxt-db-num        as integer   no-undo .
     1986           define variable v-cntxt-userid        as character no-undo .
     1987           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1988                                             , OUTPUT v-cntxt-userid
     1989                                             ) .
     1990           run gbl/wndsizew.p
     1991             (input  v-cntxt-db-num
     1992             ,input  v-cntxt-userid
     1993             ,input  v-diasize-proc-name
     1994             ,input  'width':u
     1995             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1996             ) .
     1997         end.
     1998       end.
     1999     end.
     2000     assign
     2001       v-diasize-change-size = false
     2002     .
     2003   end procedure.
     2004   procedure diasize_set-width :
     2005     define input  parameter p-new-width  as decimal   no-undo .
     2006     define input  parameter p-move-resize as logical   no-undo .
     2007     do
     2008     on error undo, return error return-value
     2009     :
     2010       run diasize_change-width in this-procedure
     2011         (input  (p-new-width - frame Dialog-Frame :width)
     2012         ,input  p-move-resize
     2013         ) .
     2014     end.
     2015   end procedure.
     2016   procedure diasize_position-resize-button :
     2017     do with frame Dialog-Frame
     2018     :
     2019       hide v-diasize-resize-button .
     2020       assign
     2021         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2022                     - 1
     2023                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2024         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2025                     - 1
     2026                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2027       .
     2028       view v-diasize-resize-button .
     2029     end.
     2030   end procedure.
     2031   on alt-right anywhere
     2032   do:
     2033     run diasize_change-width in this-procedure
     2034       (input 1
     2035       ,input true
     2036       ) .
     2037     return no-apply .
     2038   end.
     2039   on alt-left anywhere
     2040   do:
     2041     run diasize_change-width in this-procedure
     2042       (input -1
     2043       ,input true
     2044       ) .
     2045     return no-apply .
     2046   end.
     2047   on alt-down anywhere
     2048   do:
     2049     run diasize_change-height in this-procedure
     2050       (input 1
     2051       ,input true
     2052       ) .
     2053     return no-apply .
     2054   end.
     2055   on alt-up anywhere
     2056   do:
     2057     run diasize_change-height in this-procedure
     2058       (input -1
     2059       ,input true
     2060       ) .
     2061     return no-apply .
     2062   end.
     2063   on alt-enter of frame Dialog-Frame
     2064   do:
     2065     run diasize_maximize in this-procedure
     2066       (input  ?
     2067       ).
     2068     return no-apply .
     2069   end.
     2070   procedure diasize_end-move :
     2071     do
     2072     on error undo, return error return-value
     2073     :
     2074       define variable v-row-delta as decimal   no-undo .
     2075       define variable v-col-delta as decimal   no-undo .
     2076       define variable v-new-row as decimal   no-undo .
     2077       define variable v-new-col as decimal   no-undo .
     2078       assign
     2079         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2080         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2081       .
     2082       assign
     2083         v-row-delta = v-new-row - frame Dialog-Frame :height
     2084         v-col-delta = v-new-col - frame Dialog-Frame :width
     2085       .
     2086       run diasize_change-height in this-procedure
     2087         (input v-row-delta
     2088         ,input true
     2089         ) .
     2090       run diasize_change-width in this-procedure
     2091         (input v-col-delta
     2092         ,input true
     2093         ) .
     2094     end.
     2095   end procedure.
     2096   procedure diasize_maximize :
     2097     define input  parameter p-action as logical   no-undo .
     2098     do
     2099     on error undo, return error return-value
     2100     :
     2101       if p-action = ?
     2102       then do:
     2103         if v-diasize-need-maximize = true
     2104         then do:
     2105           assign
     2106             p-action = true
     2107           .
     2108         end.
     2109         else do:
     2110           assign
     2111             p-action = false
     2112           .
     2113         end.
     2114       end.
     2115       if p-action = true
     2116       then do:
     2117         run diasize_change-height in this-procedure
     2118           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2119               - frame Dialog-Frame :height-chars
     2120           ,input true
     2121           ) .
     2122         run diasize_change-width in this-procedure
     2123           (input session :width-chars
     2124               - frame Dialog-Frame :width-chars
     2125           ,input true
     2126           ) .
     2127         assign
     2128           v-diasize-need-maximize = false
     2129         .
     2130       end.
     2131       else do:
     2132         run diasize_change-width in this-procedure
     2133           (input v-diasize-orig-frame-width
     2134               - frame Dialog-Frame :width-chars
     2135           ,input true
     2136           ) .
     2137         run diasize_change-height in this-procedure
     2138           (input v-diasize-orig-frame-height
     2139               - frame Dialog-Frame :height-chars
     2140           ,input true
     2141           ) .
     2142         assign
     2143           v-diasize-need-maximize = true
     2144         .
     2145       end.
     2146     end.
     2147   end procedure.
     2148   procedure diasize_restore-orig-size :
     2149     do
     2150     on error undo, return error return-value
     2151     :
     2152       assign
     2153         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2154         v-diasize-current-frame-height = frame Dialog-Frame :height
     2155       .
     2156       run diasize_set-height in this-procedure
     2157         (input  v-diasize-orig-frame-height
     2158         ,input  true
     2159         ) .
     2160       run diasize_set-width in this-procedure
     2161         (input  v-diasize-orig-frame-width
     2162         ,input  true
     2163         ) .
     2164     end.
     2165   end procedure.
     2166   procedure diasize_restore-current-size :
     2167     do
     2168     on error undo, return error return-value
     2169     :
     2170       run diasize_set-height in this-procedure
     2171         (input  v-diasize-current-frame-height
     2172         ,input  true
     2173         ) .
     2174       run diasize_set-width in this-procedure
     2175         (input  v-diasize-current-frame-width
     2176         ,input  true
     2177         ) .
     2178     end.
     2179   end procedure.
     2180   procedure diasize_set-browse-handle :
     2181     define input  parameter p-browse-handle as handle   no-undo .
     2182     define buffer buf_temp-browse-handle for temp-browse-handle .
     2183     do
     2184     on error undo, return error return-value
     2185     :
     2186       assign
     2187         v-diasize-browse-handle = p-browse-handle
     2188       .
     2189       for each buf_temp-browse-handle
     2190       on error undo, return error return-value
     2191       :
     2192         delete buf_temp-browse-handle .
     2193       end.
     2194     end.
     2195   end procedure.
     2196   procedure diasize_add_browse :
     2197     define input  parameter p-browse-type   as character no-undo .
     2198     define input  parameter p-browse-handle as handle    no-undo .
     2199     define buffer buf_temp-browse-handle for temp-browse-handle .
     2200     do
     2201     on error undo, return error return-value
     2202     :
     2203       assign
     2204         v-diasize-browse-number = v-diasize-browse-number + 1
     2205       .
     2206       create buf_temp-browse-handle .
     2207       assign
     2208         buf_temp-browse-handle.browse-type   = p-browse-type
     2209         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2210         buf_temp-browse-handle.browse-handle = p-browse-handle
     2211       .
     2212     end.
     2213   end procedure.
     2214   procedure diasize_init :
     2215     define variable v-default-value    as logical   no-undo .
     2216     define variable v-restore-saved    as logical   no-undo .
     2217     define variable v-resize-value-str as character no-undo .
     2218     do
     2219     on error undo, return error return-value
     2220     :
     2221       do with frame Dialog-Frame
     2222       :
     2223         assign
     2224           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2225           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2226           v-diasize-browse-handle     = browse br-c-place-io :handle
     2227         .
     2228         create button v-diasize-resize-button
     2229         assign
     2230           parent        = frame Dialog-Frame :first-child
     2231           label         = "s"
     2232           height-pixels = 16
     2233           width-pixels  = 16
     2234           visible       = true
     2235           sensitive     = true
     2236           movable       = true
     2237           triggers:
     2238             on end-move persistent run diasize_end-move in this-procedure .
     2239           end triggers.
     2240         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2241         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2242         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2243         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2244         assign
     2245           v-diasize-wndmax = false
     2246         .
     2247         if connected("ub") = true
     2248         then do:
     2249           define variable v-cntxt-db-num        as integer   no-undo .
     2250           define variable v-cntxt-userid        as character no-undo .
     2251           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2252                                             , OUTPUT v-cntxt-userid
     2253                                             ) .
     2254           run gbl/wndpar_r.p
     2255             (input  v-cntxt-db-num
     2256             ,input  v-cntxt-userid
     2257             ,input  'wndmax':U
     2258             ,output v-diasize-wndmax
     2259             ,output v-default-value
     2260             ) .
     2261         end.
     2262         assign
     2263           v-diasize-wndstore = false
     2264         .
     2265         if connected("ub") = true
     2266         then do:
     2267           run gbl/wndpar_r.p
     2268             (input  v-cntxt-db-num
     2269             ,input  v-cntxt-userid
     2270             ,input  'wndstore':U
     2271             ,output v-diasize-wndstore
     2272             ,output v-default-value
     2273             ) .
     2274         end.
     2275         assign
     2276           v-diasize-proc-name = entry(1, program-name(2), '.')
     2277         .
     2278         if v-diasize-wndstore = true
     2279         then do:
     2280           assign
     2281             v-restore-saved = false
     2282           .
     2283           if connected("ub") = true
     2284           then do:
     2285             run gbl/wndsizer.p
     2286               (input  v-cntxt-db-num
     2287               ,input  v-cntxt-userid
     2288               ,input  v-diasize-proc-name
     2289               ,input  'height':u
     2290               ,output v-resize-value-str
     2291               ) .
     2292             if v-resize-value-str <> '':U
     2293             then do:
     2294               run diasize_change-height in this-procedure
     2295                 (input  integer(v-resize-value-str)
     2296                 ,input  true
     2297                 ) .
     2298               assign
     2299                 v-restore-saved = true
     2300               .
     2301             end.
     2302           end.
     2303           if connected("ub") = true
     2304           then do:
     2305             run gbl/wndsizer.p
     2306               (input  v-cntxt-db-num
     2307               ,input  v-cntxt-userid
     2308               ,input  v-diasize-proc-name
     2309               ,input  'width':u
     2310               ,output v-resize-value-str
     2311               ) .
     2312             if v-resize-value-str <> '':U
     2313             then do:
     2314               run diasize_change-width in this-procedure
     2315                 (input  integer(v-resize-value-str)
     2316                 ,input  true
     2317                 ) .
     2318               assign
     2319                 v-restore-saved = true
     2320               .
     2321             end.
     2322           end.
     2323           if v-restore-saved <> true
     2324           then do:
     2325             if v-diasize-wndmax = true
     2326             then do:
     2327               run diasize_maximize in this-procedure
     2328                 (input  true
     2329                 ) .
     2330             end.
     2331           end.
     2332         end.
     2333         else do:
     2334           if v-diasize-wndmax = true
     2335           then do:
     2336             run diasize_maximize in this-procedure
     2337               (input  true
     2338               ) .
     2339           end.
     2340         end.
     2341       end.
     2342     end.
     2343   end procedure.
     2344   procedure diasize_need-full-display :
     2345     define output parameter p-need-full-display as logical   no-undo .
     2346     do
     2347     on error undo, return error return-value
     2348     :
     2349       assign
     2350         p-need-full-display = v-diasize-need-full-display
     2351       .
     2352       assign
     2353         v-diasize-need-full-display = false
     2354       .
     2355     end.
     2356   end procedure.
     2357   procedure get-context :
     2358      define output parameter p-db-num as integer          no-undo.
     2359      define output parameter p-user-id as character        no-undo.
     2360      define variable v-login               as character    no-undo.
     2361      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2362      define buffer buf_user-login  for ub.user-login .
     2363      do
     2364      on error undo, return error
     2365      :
     2366            FIND FIRST buf_sys-ctrl no-lock.
     2367            ASSIGN
     2368               v-login = USERID("ub")
     2369               p-db-num = buf_sys-ctrl.db-num
     2370            .
     2371            FIND FIRST buf_user-login
     2372                 WHERE buf_user-login.db-num = p-db-num
     2373                   AND buf_user-login.user-login = v-login
     2374                 no-lock
     2375                 no-error
     2376                 .
     2377            IF AVAILABLE buf_user-login
     2378            THEN DO:
     2379               assign
     2380                  p-user-id = buf_user-login.user-id
     2381               .
     2382            END.
     2383      end.
     2384   end procedure.
     2385       run diasize_init in this-procedure .
     2386   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2387   procedure set-filter-name :
     2388   define input parameter p-filter-name as character no-undo .
     2389     do with frame Dialog-Frame:
     2390       if p-filter-name > "" then do:
     2391         assign
     2392           frame Dialog-Frame:title
     2393             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2394         .
     2395         assign
     2396           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2397         .
     2398       end.
     2399       else do:
     2400         assign
     2401           b-sch :tooltip = ""
     2402         .
     2403       end.
     2404     end.
     2405   end procedure.
     2406   def var sort-labelbr-c-place-io   as character no-undo .
     2407   def var sort-clmnbr-c-place-io    as handle    no-undo .
     2408   def var cur-clmnbr-c-place-io     as handle    no-undo .
     2409   def var cur-clmn-locbr-c-place-io as integer   no-undo .
     2410   def var re-querybr-c-place-io     as logical   initial no no-undo .
     2411   on start-search, ctrl-o of br-c-place-io in frame Dialog-Frame do:
     2412      run sort-brbr-c-place-io
     2413        (input (if available X_c-place-io
     2414                then recid(X_c-place-io)
     2415                else ?
     2416               )
     2417        ).
     2418   end.
     2419   PROCEDURE sort-brbr-c-place-io :
     2420     define input parameter p-recid as recid no-undo .
     2421     if re-querybr-c-place-io = no then do:
     2422       assign
     2423          cur-clmnbr-c-place-io = br-c-place-io:current-column in frame Dialog-Frame
     2424       .
     2425       if sort-clmnbr-c-place-io <> ? then sort-clmnbr-c-place-io:column-fgcolor = 0.
     2426       if cur-clmnbr-c-place-io = sort-clmnbr-c-place-io then do:
     2427         assign
     2428            sort-labelbr-c-place-io = ""
     2429            sort-clmnbr-c-place-io = ?
     2430         .
     2431        end.
     2432        else do:
     2433          assign
     2434            sort-labelbr-c-place-io = cur-clmnbr-c-place-io:label
     2435            sort-clmnbr-c-place-io  = cur-clmnbr-c-place-io
     2436            sort-clmnbr-c-place-io:column-fgcolor = 4
     2437          .
     2438        end.
     2439      end.
     2440     assign
     2441       cur-clmn-locbr-c-place-io = 1
     2442     .
     2443     def var column-handle as handle no-undo .
     2444     column-handle = br-c-place-io:first-column.
     2445     do while valid-handle(column-handle) :
     2446       if column-handle = cur-clmnbr-c-place-io then do:
     2447         leave .
     2448       end.
     2449       column-handle = column-handle:NEXT-COLUMN.
     2450       assign
     2451         cur-clmn-locbr-c-place-io = cur-clmn-locbr-c-place-io + 1
     2452       .
     2453     end.
     2454     case sort-labelbr-c-place-io:
     2455           when X_c-place-io.place-io-code:label in browse br-c-place-io then DO:    assign       sort-column-name = "X_c-place-io.place-io-code"     .     run OpenBr(yes, no, no).   . END.
     2456       otherwise do:
     2457         assign
     2458           sort-column-name = ""
     2459         .
     2460         run OpenBr(yes, no, no).
     2461         if sort-labelbr-c-place-io <> "" then do:
     2462           assign
     2463             cur-clmnbr-c-place-io:column-fgcolor = 0
     2464           .
     2465         end.
     2466         assign
     2467           cur-clmn-locbr-c-place-io = ?
     2468         .
     2469       end.
     2470     end case.
     2471     if p-recid <> ? then do:
     2472       reposition br-c-place-io to recid p-recid no-error.
     2473       apply "value-changed" to br-c-place-io in frame Dialog-Frame.
     2474     end.
     2475     apply "entry" to br-c-place-io in frame Dialog-Frame.
     2476   END PROCEDURE.
     2477   procedure re-open-query-srt-clmnbr-c-place-io:
     2478   if cur-clmnbr-c-place-io = ? then do:
     2479      run OpenBr(yes, no, no).
     2480   end.
     2481   else do:
     2482      assign re-querybr-c-place-io = yes.
     2483      run sort-brbr-c-place-io
     2484        (input (if available X_c-place-io
     2485                then recid(X_c-place-io)
     2486                else ?
     2487               )
     2488        ).
     2489      assign re-querybr-c-place-io = no.
     2490   end.
     2491   end.
     2492   MAIN-BLOCK:
     2493   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2494      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2495     if p-place-io-code <> ?
     2496       and p-place-io-code <> 0
     2497     then do:
     2498       assign
     2499         title0 = substitute("История изменения места приема/отгрузки. Код: &1", p-place-io-code )
     2500       .
     2501     end.
     2502     else do:
     2503       assign
     2504         title0 = substitute("История изменения мест приема/отгрузки." )
     2505       .
     2506     end.
     2507     if p-obj-code <> ?
     2508       and p-obj-code <> 0
     2509       and p-obj-type <> "":U
     2510     then do:
     2511       assign
     2512         title0 = substitute("&1 Объект: &2 &3", title0, p-obj-type, p-obj-code )
     2513       .
     2514     end.
     2515     ENABLE
     2516       b-quit
     2517       b-sel  when lookup( bttns, "b-sel" ) > 0
     2518       b-mark when lookup( bttns, "b-mark" ) > 0
     2519       b-sch
     2520       b-Help
     2521       br-c-place-io
     2522       br-changes
     2523       WITH FRAME Dialog-Frame.
     2524     VIEW FRAME Dialog-Frame.
     2525     assign
     2526       temp-changes.l_name:resizable in browse br-changes = true
     2527       temp-changes.v_old:resizable in browse br-changes = true
     2528       temp-changes.v_new:resizable in browse br-changes = true
     2529       temp-changes.l_name:width in browse br-changes = 33
     2530       temp-changes.v_old:width in browse br-changes = 30
     2531       temp-changes.v_new:width in browse br-changes = 30
     2532     .
     2533     RUn OpenBR(yes, no, '':U).
     2534     HIDE mark-num in frame Dialog-Frame .
     2535     if p-rid-list <> "":U then do:
     2536       assign
     2537         v-doc-rec = integer(entry(1, p-rid-list))
     2538       .
     2539     end.
     2540     WAIT-FOR GO OF FRAME Dialog-Frame.
     2541   END.
     2542   RUN disable_UI.
     2543   PROCEDURE disable_UI :
     2544     HIDE FRAME Dialog-Frame.
     2545   END PROCEDURE.
     2546   PROCEDURE OpenBr :
     2547     define input  parameter p-open-query     as logical   no-undo .
     2548     define input  parameter p-find-next      as logical   no-undo .
     2549     define input  parameter p-find-condition as character no-undo .
     2550     define variable l-query-was-opened as logical no-undo .
     2551     define variable sort-column-phrase as character no-undo .
     2552     case sort-column-name :
     2553       when "" then assign sort-column-phrase = ""  .
     2554       otherwise    assign sort-column-phrase = "by " + sort-column-name  .
     2555     end case.
     2556     define variable l-open-query as logical   no-undo .
     2557     filter-point = filter-point0 .
     2558     ASSIGN frame Dialog-Frame:TITLE = title0 .
     2559   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2560   define variable  l-disable-where-13  as logical   no-undo .
     2561   define variable  l-filter-open-13    as logical   .
     2562   define variable  flt-rec-13       as recid     no-undo .
     2563   define variable  filter-name-13      as character no-undo .
     2564   define variable  where-phrase-13     as character no-undo .
     2565   define variable  sort-phrase-13      as character no-undo .
     2566   define variable  where-phrase-rus-13 as character no-undo .
     2567   define variable  sort-phrase-rus-13  as character no-undo .
     2568   run gbl/flt-get.p
     2569     (input filter-point
     2570     ,output flt-rec-13
     2571     ,output filter-name-13
     2572     ,output where-phrase-13
     2573     ,output sort-phrase-13
     2574     ,output where-phrase-rus-13
     2575     ,output sort-phrase-rus-13
     2576     ).
     2577   if p-open-query then do:
     2578       run set-filter-name in this-procedure
     2579         (INPUT filter-name-13
     2580         ) no-error .
     2581     assign
     2582       l-filter-open-13 = false
     2583     .
     2584     if flt-rec-13 <> ?
     2585       or sort-column-phrase > ""
     2586     then do:
     2587       define variable  parameter-2-13 as character no-undo .
     2588       define variable  parameter-3-13 as character no-undo .
     2589       define variable  parameter-4-13 as character no-undo .
     2590       define variable  parameter-5-13 as character no-undo .
     2591       define variable  parameter-6-13 as character no-undo .
     2592       define variable  parameter-7-13 as character no-undo .
     2593         assign
     2594         parameter-3-13 =
     2595                                 "FOR EACH X_c-place-io"
     2596         parameter-4-13 =
     2597           (
     2598             if (" X_c-place-io.obj-type = p-obj-type AND X_c-place-io.obj-code = p-obj-code  AND X_c-place-io.place-io-code  = p-place-io-code " + " " + where-phrase-13) <> ""
     2599             then  substitute(' X_c-place-io.obj-type = &4&1&4 AND X_c-place-io.obj-code  = &2 AND X_c-place-io.place-io-code  = &3 ', p-obj-type, p-obj-code, p-place-io-code, chr(34))  + " " + where-phrase-13
     2600             else "true"
     2601           )
     2602         parameter-5-13 = (" " + "" + " " + "")
     2603         parameter-6-13 = if sort-phrase-13 = ''
     2604                              then
     2605           (
     2606           " " + "  " +
     2607             " " + sort-column-phrase +
     2608           " " + "  "
     2609           )
     2610                              else
     2611           (
     2612           " " + "  " +
     2613             " " + sort-column-phrase +
     2614           " " + sort-phrase-13
     2615           )
     2616         parameter-7-13 =
     2617           " indexed-reposition  "
     2618       .
     2619       do
     2620       on stop undo, leave
     2621       on error undo, leave
     2622       :
     2623         assign
     2624           l-disable-where-13 =
     2625             (" X_c-place-io.obj-type = p-obj-type AND X_c-place-io.obj-code = p-obj-code  AND X_c-place-io.place-io-code  = p-place-io-code " + " " + where-phrase-13 = "")
     2626         .
     2627         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2628                             ,input QUERY br-c-place-io:handle
     2629                             ,input parameter-3-13
     2630                             ,input parameter-4-13
     2631                             ,input parameter-5-13
     2632                             ,input parameter-6-13
     2633                             ,input parameter-7-13
     2634                             )
     2635         .
     2636         assign
     2637           l-filter-open-13 = true
     2638         .
     2639       end.
     2640       if l-filter-open-13 = false then do:
     2641         message
     2642           "Ошибка при фильтрации / сортировке" skip
     2643           "Будут показаны записи без учета фильтра" skip
     2644           view-as alert-box .
     2645       end.
     2646       else do:
     2647           assign
     2648             l-query-was-opened = true
     2649           .
     2650       end.
     2651     end.
     2652     if l-filter-open-13 = false then do:
     2653       OPEN QUERY br-c-place-io FOR EACH X_c-place-io
     2654         where  X_c-place-io.obj-type = p-obj-type AND X_c-place-io.obj-code = p-obj-code  AND X_c-place-io.place-io-code  = p-place-io-code
     2655         indexed-reposition
     2656     .
     2657         assign
     2658           l-query-was-opened = true
     2659         .
     2660     end.
     2661   end.
     2662   else do:
     2663     assign
     2664       v-doc-rec = recid( X_c-place-io )
     2665     .
     2666     do
     2667     on stop undo, leave
     2668     on error undo, leave
     2669     :
     2670       if QUERY br-c-place-io:handle:get-buffer-handle(1) = (buffer X_c-place-io:handle) then do:
     2671         assign
     2672         parameter-2-13 = (if p-find-next then "true":u else "false":u )
     2673         parameter-4-13 =
     2674           "where ":u +  substitute(' X_c-place-io.obj-type = &4&1&4 AND X_c-place-io.obj-code  = &2 AND X_c-place-io.place-io-code  = &3 ', p-obj-type, p-obj-code, p-place-io-code, chr(34))  + " ":u + where-phrase-13 + " ":u + p-find-condition + " " + ""
     2675         parameter-5-13 = "  "
     2676       .
     2677         run fltopend_fltfindd in this-procedure  (
     2678                             input this-procedure:handle
     2679                             ,input QUERY br-c-place-io:handle
     2680                             ,input rowid(X_c-place-io)
     2681                             ,input logical(parameter-2-13)
     2682                             ,input no-lock
     2683                             ,input (buffer X_c-place-io:handle)
     2684                             ,input parameter-4-13
     2685                             ,input parameter-5-13
     2686                             ) no-error.
     2687         .
     2688         assign
     2689           v-doc-rec = integer(return-value)
     2690           v-fltopend-rowid[1] = ?
     2691         .
     2692       end.
     2693       else do:
     2694         assign
     2695         parameter-2-13 = (if p-find-next then "true":u else "false":u )
     2696         parameter-3-13 =  "FOR EACH X_c-place-io"
     2697         parameter-4-13 =
     2698           (
     2699             if (" X_c-place-io.obj-type = p-obj-type AND X_c-place-io.obj-code = p-obj-code  AND X_c-place-io.place-io-code  = p-place-io-code " + " " + where-phrase-13) <> ""
     2700             then  substitute(' X_c-place-io.obj-type = &4&1&4 AND X_c-place-io.obj-code  = &2 AND X_c-place-io.place-io-code  = &3 ', p-obj-type, p-obj-code, p-place-io-code, chr(34))  + " " + where-phrase-13
     2701             else "true"
     2702           )
     2703         parameter-5-13 = (" " + "" + " " + "" + " " + p-find-condition)
     2704         parameter-6-13 = if sort-phrase-13 = ''
     2705                              then
     2706           (
     2707           " " + "  " +
     2708             " " + sort-column-phrase +
     2709           " " + "  "
     2710           )
     2711                              else
     2712           (
     2713           " " + "  " +
     2714             " " + sort-column-phrase +
     2715           " " + sort-phrase-13
     2716           )
     2717         parameter-7-13 =
     2718           " indexed-reposition  "
     2719       .
     2720         run fltopend_fltfindq in this-procedure  (
     2721                             input this-procedure:handle
     2722                             ,input QUERY br-c-place-io:handle
     2723                             ,input logical(parameter-2-13)
     2724                             ,input no-lock
     2725                             ,input parameter-3-13
     2726                             ,input parameter-4-13
     2727                             ,input parameter-5-13
     2728                             ,input parameter-6-13
     2729                             ,input parameter-7-13
     2730                             ,output v-fltopend-rowid
     2731                             ) no-error.
     2732         .
     2733         v-doc-rec = ?.
     2734       end.
     2735       assign
     2736         l-query-was-opened = true
     2737       .
     2738     end.
     2739   end.
     2740     REPOSITION br-c-place-io to recid v-doc-rec No-ERROR.
     2741     if error-status:error then REPOSITION br-c-place-io to row 1 No-ERROR.
     2742     else  REPOSITION br-c-place-io to row 7 No-ERROR.
     2743     apply "value-changed" to br-c-place-io in frame Dialog-Frame .
     2744   END PROCEDURE.
     2745   FUNCTION mark-string RETURNS CHARACTER
     2746     ( input par-recid as recid, input mark-list as character) :
     2747   RETURN ( IF LOOKUP( STRING( par-recid ), mark-list ) > 0 THEN "*" ELSE "":U ).
     2748   END FUNCTION.
