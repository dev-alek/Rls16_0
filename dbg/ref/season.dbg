     1123         (IF ( CAN-DO (rid-list, string( recid( ub.season ) ) ) ) THEN ("*") ELSE (" ")) COLUMN-LABEL "*" FORMAT "X(1)":U
     1124         ub.season.sea-code COLUMN-LABEL "Код" FORMAT ">>>>>>>>>9":U
     1125         date-func(ub.season.sea-month-1) COLUMN-LABEL "с" FORMAT "99/99/99":U
     1126         date-func(ub.season.sea-month-2) COLUMN-LABEL "по" FORMAT "99/99/99":U
     1127         ub.season.sea-name FORMAT "X(100)":U
     1128         ub.season.db-num COLUMN-LABEL "БД" FORMAT ">>>>9":U
     1129       WITH SEPARATORS SIZE 56 BY 18.46
     1130            BGCOLOR 15 FGCOLOR 0 .
     1131   DEFINE FRAME d-type-tmp
     1132        b-exit AT ROW 1 COL 1
     1133        b-sel AT ROW 1 COL 13
     1134        b-goods AT ROW 1 COL 23
     1135        b-copy AT ROW 1 COL 33
     1136        b-hist AT ROW 1 COL 33
     1137        b-help AT ROW 1 COL 43
     1138        B-mark AT ROW 2 COL 1
     1139        b-add AT ROW 2 COL 4
     1140        b-upd AT ROW 2 COL 13
     1141        b-del AT ROW 2 COL 23
     1142        RADIO-SET-1 AT ROW 3 COL 15 NO-LABEL
     1143        RADIO-SET-2 AT ROW 3 COL 30 NO-LABEL
     1144        "Сезоны" VIEW-AS TEXT
     1145        SIZE 8 BY .62 AT ROW 3.5 COL 5 WIDGET-ID 8
     1146        mark-num AT ROW 2 COL 34 NO-LABEL
     1147        b-print AT ROW 2 COL 43
     1148        br-season AT ROW 5.25 COL 1.5
     1149        SPACE(0.37) SKIP(0.28)
     1150       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1151            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1152            TITLE "Сезоны":L.
     1153   ASSIGN
     1154          FRAME d-type-tmp:SCROLLABLE       = FALSE.
     1155   ASSIGN
     1156          br-season:NUM-LOCKED-COLUMNS IN FRAME d-type-tmp     = 3.
     1157   ON CHOOSE OF b-add IN FRAME d-type-tmp
     1158   DO:
     1159   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1160   do:
     1161     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1162       (input  v-cntxt-db-num
     1163       ,input  v-cntxt-userid
     1164       ,input  0
     1165       ,input  'actn_season_add-def':U
     1166       ,input  'global':U
     1167       ,input  0
     1168       ,input  '':U
     1169       ,input  0
     1170       ,input  0
     1171       ,input  0
     1172       ,input  0
     1173       ,input  true
     1174       ,output v-log
     1175       )  .
     1176   end.
     1177    if not v-log then return no-apply .
     1178    run ref/seasoni.w ( parParentProc , 'ДОБАВЛЕНИЕ':U, input-output rr ).
     1179    if rr <> ? then
     1180       do:
     1181           run open-br.
     1182           reposition br-season to recid rr no-error.
     1183           log-res  = br-season:select-focused-row( ) no-error.
     1184           apply "ENTRY":U to br-season.
     1185           apply "home"    to br-season.
     1186       end.
     1187   END.
     1188   ON CHOOSE OF b-del IN FRAME d-type-tmp
     1189   DO:
     1190   define variable g-log as logical   no-undo .
     1191   define variable v-recid as integer no-undo .
     1192   define variable ii as integer no-undo .
     1193   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1194   do:
     1195     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1196       (input  v-cntxt-db-num
     1197       ,input  v-cntxt-userid
     1198       ,input  0
     1199       ,input  'actn_season_deletion':U
     1200       ,input  'global':U
     1201       ,input  0
     1202       ,input  '':U
     1203       ,input  0
     1204       ,input  0
     1205       ,input  0
     1206       ,input  0
     1207       ,input  true
     1208       ,output v-log
     1209       )  .
     1210   end.
     1211   if not available ub.season or v-log = false then  return no-apply.
     1212   if not g#db-num = 0 and not can-find (buf_season-attr where buf_season-attr.sea-code = ub.season.sea-code
     1213                                               and buf_season-attr.db-num = ub.season.db-num
     1214                                               and buf_season-attr.attr-code = 'sea-obj':U)
     1215   then do:
     1216     message "Нельзя удалить глобальный сезон в УБД."
     1217             view-as alert-box information.
     1218     return no-apply.
     1219   end.
     1220   message "Удалить запись ? При этом удаляется привязка товаров к сезону."
     1221             view-as alert-box question
     1222             buttons yes-no
     1223             update g-log.
     1224             if g-log = false then return no-apply.
     1225   find current ub.season exclusive-lock no-error .
     1226   if available ub.season then delete ub.season.
     1227   run open-br.
     1228   END.
     1229   ON CHOOSE OF b-goods IN FRAME d-type-tmp
     1230   DO:
     1231     if not available ub.season then return no-apply.
     1232     run ref/seagdsl.w
     1233       ( input Parparentproc,
     1234         input ub.season.sea-code,
     1235         input ub.season.db-num,
     1236         input ub.season.sea-name
     1237         ).
     1238   END.
     1239   ON CHOOSE OF b-copy IN FRAME d-type-tmp
     1240   DO:
     1241     define variable v-user-select as logical   no-undo .
     1242     define variable v-ok as logical no-undo.
     1243     define variable v-seaobj as character no-undo.
     1244     define variable v-sea-code as integer no-undo.
     1245     define variable v-db-num as integer no-undo.
     1246     define variable v-longchar as longchar no-undo .
     1247     if not available ub.season then return no-apply.
     1248   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1249   run userobjs_select-many in this-procedure
     1250     (input  parParentProc
     1251     ,input  v-cntxt-db-num
     1252     ,input  v-cntxt-userid
     1253     ,input  v-cntxt-host-code-obj
     1254     ,input  v-cntxt-obj-type
     1255     ,input  v-cntxt-obj-code
     1256     ,output v-user-select
     1257     )  .
     1258     if v-user-select then do:
     1259       _foreach-userobj:
     1260       for each userobjs_temp-user-obj no-lock:
     1261         for each buf_gds-season no-lock where buf_gds-season.sea-code = ub.season.sea-code
     1262           and buf_gds-season.db-num = ub.season.db-num:
     1263           run chk-gdssea in this-procedure
     1264             ( input buf_gds-season.gds-code,
     1265               input userobjs_temp-user-obj.obj-type + string (userobjs_temp-user-obj.obj-code),
     1266               input ub.season.sea-month-1,
     1267               input ub.season.sea-month-2,
     1268               input ?,
     1269               output v-sea-code,
     1270               output v-db-num,
     1271               output v-ok) no-error.
     1272           if not v-ok then do:
     1273             find first buf_goods no-lock where buf_goods.gds-code = buf_gds-season.gds-code no-error.
     1274             find first buf_season no-lock where buf_season.sea-code = v-sea-code
     1275               and buf_season.db-num = v-db-num
     1276             no-error.
     1277             assign
     1278               v-longchar = v-longchar +
     1279                 substitute ("Товар &1 &2 пересекается с сезоном &3 &4.&5", buf_goods.gds-code, buf_goods.gds-name, v-sea-code, buf_season.sea-name, chr(10))
     1280               v-ok = true
     1281               .
     1282           end.
     1283         end.
     1284         if v-longchar <> "" then do:
     1285           assign
     1286             v-longchar = v-longchar +
     1287               substitute ("Сезон &1 &2 не скопирован для объекта &3.&4",
     1288                           ub.season.sea-code,
     1289                           buf_season.sea-name,
     1290                           userobjs_temp-user-obj.obj-type + string (userobjs_temp-user-obj.obj-code),
     1291                           chr(10)
     1292                           ).
     1293           next _foreach-userobj.
     1294         end.
     1295         do transaction:
     1296           create buf_season.
     1297           assign
     1298             buf_season.sea-code = next-value ( s-casm , ub )
     1299             buf_season.db-num = v-cntxt-db-num
     1300             .
     1301           buffer-copy ub.season except ub.season.sea-code ub.season.db-num ub.season.sea-name to buf_season.
     1302           buf_season.sea-name = ub.season.sea-name + " " + userobjs_temp-user-obj.obj-type + string(userobjs_temp-user-obj.obj-code).
     1303           create buf_season-attr.
     1304           assign
     1305             buf_season-attr.sea-code = buf_season.sea-code
     1306             buf_season-attr.db-num = buf_season.db-num
     1307             buf_season-attr.attr-code = 'sea-obj':U
     1308             buf_season-attr.attr-value = userobjs_temp-user-obj.obj-type + string(userobjs_temp-user-obj.obj-code)
     1309             .
     1310           for each buf_gds-season where buf_gds-season.sea-code = ub.season.sea-code
     1311             and buf_gds-season.db-num = ub.season.db-num:
     1312             create buf1_gds-season.
     1313             assign
     1314               buf1_gds-season.sea-code = buf_season.sea-code
     1315               buf1_gds-season.db-num = buf_season.db-num
     1316               .
     1317             buffer-copy buf_gds-season except buf_gds-season.sea-code buf_gds-season.db-num to buf1_gds-season.
     1318             for each buf_gds-season-attr where buf_gds-season-attr.sea-code = ub.season.sea-code
     1319               and buf_gds-season-attr.db-num = ub.season.db-num
     1320               and buf_gds-season-attr.gds-code = buf1_gds-season.gds-code:
     1321               create buf1_gds-season-attr.
     1322               assign
     1323                 buf1_gds-season-attr.sea-code = buf_season.sea-code
     1324                 buf1_gds-season-attr.db-num = buf_season.db-num
     1325                 .
     1326               buffer-copy buf_gds-season-attr except buf_gds-season-attr.sea-code buf_gds-season-attr.db-num to buf1_gds-season-attr.
     1327             end.
     1328           end.
     1329         end.
     1330       end.
     1331     end.
     1332     if v-longchar <> "" then do:
     1333       run gbl/d-longchar.w (
     1334               ?,
     1335               'Editor_row=2\':u
     1336             + 'title=Проверка товарного наполнения сезона: при копировании сезона возникли пересечения\':u
     1337             + 'Editor_col=1\':u
     1338             + 'Editor_width=96\':u
     1339             + 'Editor_height=21\':u
     1340             + 'readonly=yes\':u
     1341           ,input-output v-longchar
     1342           ,output v-ok ) no-error .
     1343           if error-status :error then message
     1344             vss-workfile vss-revision vss-description skip
     1345             error-status :get-message(1) skip
     1346             return-value skip
     1347             "4"
     1348             view-as alert-box error
     1349           .
     1350       assign
     1351         v-longchar = "".
     1352     end.
     1353   run open-br.
     1354   END.
     1355   ON CHOOSE OF b-hist IN FRAME d-type-tmp
     1356   DO:
     1357     find current ub.season no-lock no-error .
     1358     if available ub.season THEN
     1359         run ref/seasonh.w
     1360         ( input parParentProc ,
     1361           input ub.season.sea-code,
     1362           input ub.season.db-num
     1363           ).
     1364   END.
     1365   ON CHOOSE OF B-mark IN FRAME d-type-tmp
     1366   DO:
     1367     if not available ub.season then return.
     1368   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1369   define variable v-str-recid10 as character no-undo .
     1370   define variable v-num-entry10 as integer   no-undo .
     1371   assign
     1372     v-str-recid10 = trim( string( recid( ub.season ) , "->>>>>>>>>>>9":U ) )
     1373     v-num-entry10 = lookup( v-str-recid10 , rid-list )
     1374   .
     1375   if v-num-entry10 > 0 then do:
     1376     assign
     1377       entry( v-num-entry10, rid-list ) = "":U
     1378       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1379     .
     1380   end.
     1381   else do:
     1382     assign
     1383       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1384     .
     1385   end.
     1386       v-log = br-season :refresh( )  in frame d-type-tmp.
     1387     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1388         v-log = br-season:select-next-row () in frame d-type-tmp.
     1389         apply "iteration-changed" to br-season in frame d-type-tmp.
     1390     end.
     1391     if num-entries (rid-list) = 0 then
     1392        hide mark-num in frame d-type-tmp.
     1393     else
     1394       disp num-entries (rid-list) @ mark-num
     1395       with frame d-type-tmp.
     1396     apply "entry" to br-season in frame d-type-tmp.
     1397   END.
     1398   ON CHOOSE OF b-print IN FRAME d-type-tmp
     1399   DO:
     1400      for each tt-line no-lock :
     1401      delete tt-line.
     1402      end.
     1403      v-cur-time = cur-time-print ().
     1404      define variable v-file-name as character no-undo.
     1405      if RADIO-SET-1:screen-value = "1" then do:
     1406         FOR EACH ub.season ,EACH tt-season
     1407         WHERE season.sea-month-1 <> 0
     1408                AND season.sea-month-2 <> 0
     1409                AND tt-season.sea-code = season.sea-code
     1410                AND tt-season.db-num = season.db-num
     1411                AND tt-season.is-glob-sea = true:
     1412        create tt-line.
     1413        tt-line.sea-code = tt-season.sea-code.
     1414        tt-line.db-num = tt-season.db-num.
     1415        tt-line.sea-name = season.sea-name.
     1416        tt-line.sea-month-1 = season.sea-month-1.
     1417        tt-line.sea-month-2 = season.sea-month-2.
     1418        tt-line.attr-value = "глоб".
     1419        end.
     1420      end.
     1421      if RADIO-SET-1:screen-value in frame d-type-tmp = "2"
     1422     AND RADIO-SET-2:screen-value in frame d-type-tmp = "1"  then do:
     1423        FOR EACH ub.season ,EACH tt-season
     1424         WHERE season.sea-month-1 <> 0
     1425                AND season.sea-month-2 <> 0
     1426                AND tt-season.sea-code = season.sea-code
     1427                AND tt-season.db-num = season.db-num
     1428                AND tt-season.is-glob-sea = false:
     1429        create tt-line.
     1430        tt-line.sea-code = tt-season.sea-code.
     1431        tt-line.db-num = tt-season.db-num.
     1432        tt-line.sea-name = season.sea-name.
     1433        tt-line.sea-month-1 = season.sea-month-1.
     1434        tt-line.sea-month-2 = season.sea-month-2.
     1435        tt-line.attr-value  = tt-season.attr-value.
     1436        end.
     1437       end.
     1438      if RADIO-SET-1:screen-value in frame d-type-tmp = "2"
     1439     AND RADIO-SET-2:screen-value in frame d-type-tmp = "2"  then do:
     1440        FOR EACH ub.season ,EACH tt-season
     1441         WHERE season.sea-month-1 <> 0
     1442                AND season.sea-month-2 <> 0
     1443                AND tt-season.sea-code = season.sea-code
     1444                AND tt-season.db-num = season.db-num
     1445                AND tt-season.is-glob-sea = false
     1446                AND tt-season.attr-value = v-cntxt-obj-type + string( v-cntxt-obj-code ):
     1447        create tt-line.
     1448        tt-line.sea-code = tt-season.sea-code.
     1449        tt-line.db-num = tt-season.db-num.
     1450        tt-line.sea-name = season.sea-name.
     1451        tt-line.sea-month-1 = season.sea-month-1.
     1452        tt-line.sea-month-2 = season.sea-month-2.
     1453        tt-line.attr-value  = tt-season.attr-value.
     1454        end.
     1455      end.
     1456      if RADIO-SET-1:screen-value in frame d-type-tmp = "2"
     1457     AND RADIO-SET-2:screen-value in frame d-type-tmp = "3"  then do:
     1458        FOR EACH ub.season ,EACH tt-season
     1459         WHERE season.sea-month-1 <> 0
     1460                AND season.sea-month-2 <> 0
     1461                AND tt-season.sea-code = season.sea-code
     1462                AND tt-season.db-num = season.db-num
     1463                AND tt-season.is-glob-sea = false
     1464                AND lookup(tt-season.attr-value, v-sel-obj-list) > 0:
     1465        create tt-line.
     1466        tt-line.sea-code = tt-season.sea-code.
     1467        tt-line.db-num = tt-season.db-num.
     1468        tt-line.sea-name = season.sea-name.
     1469        tt-line.sea-month-1 = season.sea-month-1.
     1470        tt-line.sea-month-2 = season.sea-month-2.
     1471        tt-line.attr-value  = tt-season.attr-value.
     1472        end.
     1473       end.
     1474      run create-rep(output v-file-name).
     1475      if v-file-name = ? then
     1476           MESSAGE "Не удалось создать html-файл"
     1477           VIEW-AS ALERT-BOX.
     1478       else
     1479           run open-ie(v-file-name).
     1480   END.
     1481   ON CHOOSE OF b-sel IN FRAME d-type-tmp
     1482   DO:
     1483       if ( available ub.season ) AND ( rid-list = "" ) then
     1484           rid-list = string( recid( ub.season ) ) .
     1485   END.
     1486   ON CHOOSE OF b-upd IN FRAME d-type-tmp
     1487   DO:
     1488   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1489   do:
     1490     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1491       (input  v-cntxt-db-num
     1492       ,input  v-cntxt-userid
     1493       ,input  0
     1494       ,input  'actn_season_update':U
     1495       ,input  'global':U
     1496       ,input  0
     1497       ,input  '':U
     1498       ,input  0
     1499       ,input  0
     1500       ,input  0
     1501       ,input  0
     1502       ,input  true
     1503       ,output v-log
     1504       )  .
     1505   end.
     1506       if not available ub.season or v-log = false then  return no-apply.
     1507           rr = recid( ub.season ).
     1508           run ref/seasoni.w
     1509               (parParentProc , 'ИЗМЕНЕНИЕ':U, input-output rr ).
     1510           run open-br.
     1511           reposition br-season to recid rr .
     1512    END.
     1513   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME d-type-tmp
     1514   DO:
     1515   RADIO-SET-2:screen-value in frame d-type-tmp = "1".
     1516   if RADIO-SET-1:screen-value = "1" then do:  DISABLE RADIO-SET-2 WITH FRAME  d-type-tmp.
     1517                                               run open-br.
     1518                                          end.
     1519   if RADIO-SET-1:screen-value = "2" then do: ENABLE RADIO-SET-2 WITH FRAME  d-type-tmp.
     1520                                              run open-br.
     1521                                          end.
     1522   END.
     1523   ON VALUE-CHANGED OF RADIO-SET-2 IN FRAME d-type-tmp
     1524   DO:
     1525   if RADIO-SET-2:screen-value = "1" then run open-br.
     1526   if RADIO-SET-2:screen-value = "2" then run open-br.
     1527       if RADIO-SET-2:screen-value = "3"  then run open-br-when-b-obj.
     1528   END.
     1529   ON DEFAULT-ACTION OF br-season IN FRAME d-type-tmp
     1530   DO:
     1531     case yes:
     1532         when  b-upd:sensitive THEN apply "CHOOSE":U to b-upd.
     1533     end case.
     1534   END.
     1535   ON MOUSE-SELECT-DBLCLICK OF br-season IN FRAME d-type-tmp
     1536   DO:
     1537       if lookup ( "b-sel", bttns ) > 0  then
     1538           do:
     1539               apply "choose" to b-sel in frame d-type-tmp .
     1540               return no-apply .
     1541           end.
     1542   END.
     1543   ON RETURN OF br-season IN FRAME d-type-tmp
     1544   DO:
     1545       if Lookup( "b-sel",  bttns ) > 0 then
     1546           do:
     1547               apply "choose" to b-sel in frame d-type-tmp .
     1548               return no-apply .
     1549           end.
     1550       else
     1551           apply "DEFAULT-ACTION":U to self.
     1552   END.
     1553   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-type-tmp:PARENT eq ?
     1554   THEN FRAME d-type-tmp:PARENT = ACTIVE-WINDOW.
     1555   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1556   on help of frame d-type-tmp
     1557   do:
     1558     run gbl/app_help.p
     1559       (input this-procedure :file-name
     1560       ,input ''
     1561       ,input ?
     1562       ) no-error.
     1563     if error-status :error then do:
     1564       message
     1565         "Ошибка при вызове помощи"
     1566         error-status :get-message(1)
     1567         view-as alert-box .
     1568     end.
     1569   end.
     1570   run minbtn-set in this-procedure .
     1571   on choose of b-help in frame d-type-tmp
     1572   do:
     1573     apply "help":u to frame d-type-tmp .
     1574   end.
     1575   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1576   procedure minbtn-set :
     1577       do
     1578           on error undo, return error return-value
     1579           :
     1580           define variable ii              as integer       no-undo .
     1581           define variable fh              as widget-handle no-undo .
     1582           define variable hh              as widget-handle no-undo .
     1583           define variable v-h             as handle        extent 4 no-undo .
     1584           define variable v-name-button   as character     no-undo .
     1585           define variable v-help-old-x    as decimal       no-undo .
     1586           define variable v-help-old-y    as decimal       no-undo .
     1587           define variable v-help-old-size as decimal       no-undo .
     1588           define variable v-frame-width   as decimal       no-undo .
     1589           define variable jj              as integer       no-undo .
     1590           do
     1591               on error undo, return error
     1592               :
     1593               assign
     1594                   v-frame-width = frame d-type-tmp:width - 0.3
     1595                   fh            = frame d-type-tmp:first-child
     1596                   hh            = fh:first-child
     1597                   ii            = 1
     1598                   .
     1599               do while valid-handle(hh):
     1600                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1601                   do:
     1602                       case lc(hh:name) :
     1603                           when "b-help" then
     1604                               do:
     1605                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1606                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1607                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1608                                   hh:TOOLTIP = "Помощь" .
     1609                                   v-help-old-x = hh:column .
     1610                                   v-help-old-y = hh:row    .
     1611                                   v-help-old-size = hh:width .
     1612                                   hh:width-chars = 2.5 .
     1613                               end.
     1614                           when "b-print" then
     1615                               do:
     1616                                   hh:load-image("cmp/b-print.bmp":u) .
     1617                                   hh:TOOLTIP = "Печать" .
     1618                                   v-h[ii] = hh:handle .
     1619                                   ii = ii + 1 .
     1620                                   hh:width-chars = 3 .
     1621                               end.
     1622                           when "b-history" or
     1623                           when "b-hist" then
     1624                               do:
     1625                                   hh:load-image("cmp/b-hist.bmp":u) .
     1626                                   hh:TOOLTIP = "История" .
     1627                                   v-h[ii] = hh:handle .
     1628                                   ii = ii + 1 .
     1629                                   hh:width-chars = 3 .
     1630                               end.
     1631                           when "b-sch" then
     1632                               do:
     1633                                   hh:load-image("cmp/b-sch.bmp":u) .
     1634                                   hh:TOOLTIP = "Установка Фильтра" .
     1635                                   v-h[ii] = hh:handle .
     1636                                   ii = ii + 1 .
     1637                                   hh:width-chars = 3 .
     1638                               end.
     1639                           when "b-hist-user" then
     1640                               do:
     1641                                   hh:load-image("cmp/b-hist.bmp":u) .
     1642                                   hh:TOOLTIP = "История пользователя" .
     1643                                   ii = ii + 1 .
     1644                               end.
     1645                       end case.
     1646                   end.
     1647                   hh = hh:next-sibling.
     1648               end.
     1649               b-help:column = v-frame-width - b-help:width-chars.
     1650               jj = 0.
     1651               repeat ii = 4 to 1 by -1 :
     1652                   if valid-handle (v-h[ii] ) then
     1653                   do:
     1654                       jj  = jj + 1 .
     1655                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1656                       v-h[ii]:row    = v-help-old-y .
     1657                   end.
     1658               end.
     1659           end.
     1660       end.
     1661   end procedure.
     1662   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1663   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1664   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1665   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1666   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1667   define variable v-diasize-current-frame-height as decimal   no-undo .
     1668   define variable v-diasize-change-size          as logical   no-undo .
     1669   define variable v-diasize-resize-button        as handle    no-undo .
     1670   define variable v-diasize-wndmax               as logical   no-undo .
     1671   define variable v-diasize-wndstore             as logical   no-undo .
     1672   define variable v-diasize-proc-name            as character no-undo .
     1673   define variable v-diasize-browse-handle        as handle    no-undo .
     1674   define variable v-diasize-browse-number        as integer   no-undo .
     1675   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1676   define temp-table temp-diasize-handle no-undo
     1677     field handle-value  as handle
     1678     field save-position as decimal
     1679     index xpk is primary unique handle-value
     1680     .
     1681   define temp-table temp-browse-handle no-undo
     1682     field browse-type   as character
     1683     field browse-number as integer
     1684     field browse-handle as handle
     1685     field original-size as decimal
     1686     index xpk is primary unique browse-type browse-number
     1687     index xie browse-type browse-handle
     1688   .
     1689   procedure diasize_change-height :
     1690     define input  parameter p-change-value  as decimal   no-undo .
     1691     define input  parameter p-move-resize   as logical   no-undo .
     1692     define variable v-field-group-handle    as handle    no-undo .
     1693     define variable v-object-handle         as handle    no-undo .
     1694     define variable v-frame-height          as decimal   no-undo .
     1695     define variable v-frame-virtual-height  as decimal   no-undo .
     1696     define variable v-browse-height         as decimal   no-undo .
     1697     define variable v-window-height         as decimal   no-undo .
     1698     define variable v-window-virtual-height as decimal   no-undo .
     1699     define variable v-change-sign           as integer   no-undo .
     1700     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1701     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1702     if p-change-value > 0
     1703     then do:
     1704       if frame d-type-tmp :height + p-change-value
     1705           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1706       then do:
     1707         assign
     1708           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1709                           - (frame d-type-tmp :height-chars)
     1710         .
     1711         if p-change-value <= 0
     1712         then do:
     1713           run diasize_position-resize-button in this-procedure .
     1714           return .
     1715         end.
     1716       end.
     1717     end.
     1718     if p-change-value < 0
     1719     then do:
     1720       if frame d-type-tmp :height + p-change-value < v-diasize-orig-frame-height
     1721       then do:
     1722         assign
     1723           p-change-value = v-diasize-orig-frame-height
     1724                          - (frame d-type-tmp :height-chars)
     1725         .
     1726         if p-change-value >= 0
     1727         then do:
     1728           run diasize_position-resize-button in this-procedure .
     1729           return .
     1730         end.
     1731       end.
     1732     end.
     1733     if p-change-value >= 0
     1734     then do:
     1735       assign
     1736         v-change-sign = 1
     1737       .
     1738     end.
     1739     else do:
     1740       assign
     1741         v-change-sign = -1
     1742       .
     1743     end.
     1744     assign
     1745       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1746     .
     1747     if p-change-value = 0
     1748     then do:
     1749       run diasize_position-resize-button in this-procedure .
     1750       return .
     1751     end.
     1752     move_block:
     1753     do
     1754     on error undo move_block, retry move_block
     1755     :
     1756       if retry
     1757       then do:
     1758         do
     1759         on error undo move_block, leave move_block
     1760         :
     1761           if p-change-value > 0
     1762           then do:
     1763             for each buf_temp-diasize-handle
     1764             on error undo, next
     1765             :
     1766               assign
     1767                 v-object-handle = buf_temp-diasize-handle.handle-value
     1768               .
     1769               if v-object-handle <> v-diasize-resize-button
     1770               then do:
     1771                 assign
     1772                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1773                 .
     1774               end.
     1775             end.
     1776             assign
     1777               v-diasize-browse-handle :height = v-browse-height
     1778             .
     1779             for each buf_temp-browse-handle
     1780               where buf_temp-browse-handle.browse-type = 'height':u
     1781             on error undo, next
     1782             :
     1783               assign
     1784                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1785               .
     1786             end.
     1787             assign
     1788               frame d-type-tmp :height = v-frame-height
     1789             .
     1790             if frame d-type-tmp :scrollable = true
     1791             then do:
     1792               assign
     1793                 frame d-type-tmp :virtual-height = v-frame-virtual-height
     1794               .
     1795             end.
     1796             run diasize_position-resize-button in this-procedure .
     1797           end.
     1798           else do:
     1799             if frame d-type-tmp :scrollable = true
     1800             then do:
     1801               assign
     1802                 frame d-type-tmp :virtual-height = v-frame-virtual-height
     1803               .
     1804             end.
     1805             assign
     1806               frame d-type-tmp :height = v-frame-height
     1807             .
     1808             assign
     1809               v-diasize-browse-handle :height = v-browse-height
     1810             .
     1811             for each buf_temp-browse-handle
     1812               where buf_temp-browse-handle.browse-type = 'height':u
     1813             on error undo, next
     1814             :
     1815               assign
     1816                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1817               .
     1818             end.
     1819             for each buf_temp-diasize-handle
     1820             on error undo, next
     1821             :
     1822               assign
     1823                 v-object-handle = buf_temp-diasize-handle.handle-value
     1824               .
     1825               if v-object-handle <> v-diasize-resize-button
     1826               then do:
     1827                 assign
     1828                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1829                 .
     1830               end.
     1831             end.
     1832             run diasize_position-resize-button in this-procedure .
     1833           end.
     1834           assign
     1835             v-diasize-change-size = false
     1836           .
     1837           leave move_block .
     1838         end.
     1839       end.
     1840       assign
     1841         v-diasize-need-full-display = true
     1842       .
     1843       if v-diasize-change-size = false
     1844       then do:
     1845         assign
     1846           v-diasize-change-size = true
     1847         .
     1848       end.
     1849       else do:
     1850         return .
     1851       end.
     1852       assign
     1853         v-frame-height = frame d-type-tmp :height
     1854         v-frame-virtual-height = frame d-type-tmp :virtual-height
     1855         v-browse-height = v-diasize-browse-handle :height
     1856       .
     1857       for each buf_temp-browse-handle
     1858         where buf_temp-browse-handle.browse-type = 'height':u
     1859       :
     1860         assign
     1861           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1862         .
     1863       end.
     1864       for each buf_temp-diasize-handle
     1865       :
     1866         delete buf_temp-diasize-handle .
     1867       end.
     1868       assign
     1869         v-field-group-handle = frame d-type-tmp :first-child
     1870       .
     1871       do while valid-handle(v-field-group-handle)
     1872       :
     1873         assign
     1874           v-object-handle = v-field-group-handle :first-child
     1875         .
     1876         do while valid-handle(v-object-handle)
     1877         :
     1878           if  v-object-handle <> v-diasize-browse-handle :handle
     1879           and can-query(v-object-handle, "row")
     1880           and can-query(v-object-handle, "height")
     1881           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1882           then do:
     1883             find first buf_temp-browse-handle
     1884               where buf_temp-browse-handle.browse-type   = 'height':u
     1885                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1886               no-error .
     1887             if available buf_temp-browse-handle
     1888             then do:
     1889             end.
     1890             else do:
     1891               create buf_temp-diasize-handle .
     1892               assign
     1893                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1894                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1895               .
     1896             end.
     1897           end.
     1898           assign
     1899             v-object-handle = v-object-handle :next-sibling
     1900           .
     1901         end.
     1902         assign
     1903           v-field-group-handle = v-field-group-handle :next-sibling
     1904         .
     1905       end.
     1906       do with frame d-type-tmp
     1907       :
     1908         hide v-diasize-resize-button .
     1909         assign
     1910           v-diasize-resize-button :row    = 1
     1911           v-diasize-resize-button :column = 1
     1912         .
     1913       end.
     1914       if p-change-value > 0
     1915       then do:
     1916         if frame d-type-tmp :scrollable = true
     1917         then do:
     1918           assign
     1919             frame d-type-tmp :virtual-height = frame d-type-tmp :virtual-height + p-change-value
     1920             no-error .
     1921           if error-status :error
     1922           or error-status :get-message(1) <> ""
     1923           then do:
     1924             undo move_block, retry move_block .
     1925           end.
     1926         end.
     1927         assign
     1928           frame d-type-tmp :height = frame d-type-tmp :height + p-change-value
     1929           no-error .
     1930         if error-status :error
     1931         or error-status :get-message(1) <> ""
     1932         then do:
     1933           undo move_block, retry move_block .
     1934         end.
     1935         assign
     1936           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1937           no-error .
     1938         if error-status :error
     1939         or error-status :get-message(1) <> ""
     1940         then do:
     1941           undo move_block, retry move_block .
     1942         end.
     1943         for each buf_temp-browse-handle
     1944           where buf_temp-browse-handle.browse-type = 'height':u
     1945         on error undo move_block, retry move_block
     1946         :
     1947           assign
     1948             buf_temp-browse-handle.browse-handle :height
     1949               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1950             no-error .
     1951           if error-status :error
     1952           or error-status :get-message(1) <> ""
     1953           then do:
     1954             undo move_block, retry move_block .
     1955           end.
     1956         end.
     1957         for each buf_temp-diasize-handle
     1958         on error undo move_block, retry move_block
     1959         :
     1960           assign
     1961             v-object-handle = buf_temp-diasize-handle.handle-value
     1962           .
     1963           if v-object-handle <> v-diasize-resize-button
     1964           then do:
     1965             assign
     1966               v-object-handle :row = v-object-handle :row + p-change-value
     1967               no-error .
     1968             if error-status :error
     1969             or error-status :get-message(1) <> ""
     1970             then do:
     1971               undo move_block, retry move_block .
     1972             end.
     1973           end.
     1974         end.
     1975       end.
     1976       else do:
     1977         for each buf_temp-diasize-handle
     1978         on error undo move_block, retry move_block
     1979         :
     1980           assign
     1981             v-object-handle = buf_temp-diasize-handle.handle-value
     1982           .
     1983           if v-object-handle <> v-diasize-resize-button
     1984           then do:
     1985             assign
     1986               v-object-handle :row = v-object-handle :row + p-change-value
     1987               no-error .
     1988             if error-status :error
     1989             or error-status :get-message(1) <> ""
     1990             then do:
     1991               undo move_block, retry move_block .
     1992             end.
     1993           end.
     1994         end.
     1995         assign
     1996           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1997           no-error .
     1998         if error-status :error
     1999         or error-status :get-message(1) <> ""
     2000         then do:
     2001           undo move_block, retry move_block .
     2002         end.
     2003         for each buf_temp-browse-handle
     2004           where buf_temp-browse-handle.browse-type = 'height':u
     2005         on error undo move_block, retry move_block
     2006         :
     2007           assign
     2008             buf_temp-browse-handle.browse-handle :height
     2009               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2010             no-error .
     2011           if error-status :error
     2012           or error-status :get-message(1) <> ""
     2013           then do:
     2014             undo move_block, retry move_block .
     2015           end.
     2016         end.
     2017         assign
     2018           frame d-type-tmp :height = frame d-type-tmp :height + p-change-value
     2019           no-error .
     2020         if error-status :error
     2021         or error-status :get-message(1) <> ""
     2022         then do:
     2023           undo move_block, retry move_block .
     2024         end.
     2025         if frame d-type-tmp :scrollable = true
     2026         then do:
     2027           assign
     2028             frame d-type-tmp :virtual-height = frame d-type-tmp :virtual-height + p-change-value
     2029             no-error .
     2030           if error-status :error
     2031           or error-status :get-message(1) <> ""
     2032           then do:
     2033             undo move_block, retry move_block .
     2034           end.
     2035         end.
     2036       end.
     2037       if p-move-resize = true
     2038       then do:
     2039         run diasize_position-resize-button in this-procedure .
     2040       end.
     2041       if v-diasize-wndstore = true
     2042       then do:
     2043         if connected("ub") = true
     2044         then do:
     2045           define variable v-cntxt-db-num        as integer   no-undo .
     2046           define variable v-cntxt-userid        as character no-undo .
     2047           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2048                                             , OUTPUT v-cntxt-userid
     2049                                             ) .
     2050           run gbl/wndsizew.p
     2051             (input  v-cntxt-db-num
     2052             ,input  v-cntxt-userid
     2053             ,input  v-diasize-proc-name
     2054             ,input  'height':u
     2055             ,input  string(frame d-type-tmp :height - v-diasize-orig-frame-height)
     2056             ) .
     2057         end.
     2058       end.
     2059     end.
     2060     assign
     2061       v-diasize-change-size = false
     2062     .
     2063   end procedure.
     2064   procedure diasize_set-height :
     2065     define input  parameter p-new-height  as decimal   no-undo .
     2066     define input  parameter p-move-resize as logical   no-undo .
     2067     do
     2068     on error undo, return error return-value
     2069     :
     2070       run diasize_change-height in this-procedure
     2071         (input  (p-new-height - frame d-type-tmp :height)
     2072         ,input  p-move-resize
     2073         ) .
     2074     end.
     2075   end procedure.
     2076   procedure diasize_change-width :
     2077     define input  parameter p-change-value as decimal   no-undo .
     2078     define input  parameter p-move-resize  as logical   no-undo .
     2079     define variable v-field-group-handle   as handle    no-undo .
     2080     define variable v-object-handle        as handle    no-undo .
     2081     define variable v-frame-width          as decimal   no-undo .
     2082     define variable v-frame-virtual-width  as decimal   no-undo .
     2083     define variable v-browse-width         as decimal   no-undo .
     2084     define variable v-window-width         as decimal   no-undo .
     2085     define variable v-window-virtual-width as decimal   no-undo .
     2086     define variable v-change-sign          as integer   no-undo .
     2087     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2088     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2089     if p-change-value > 0
     2090     then do:
     2091       if frame d-type-tmp :width + p-change-value >
     2092           session :width-chars
     2093       then do:
     2094         assign
     2095           p-change-value = session :width-chars - frame d-type-tmp :width
     2096         .
     2097         if p-change-value <= 0
     2098         then do:
     2099           run diasize_position-resize-button in this-procedure .
     2100           return .
     2101         end.
     2102       end.
     2103     end.
     2104     if p-change-value < 0
     2105     then do:
     2106       if frame d-type-tmp :width + p-change-value < v-diasize-orig-frame-width
     2107       then do:
     2108         assign
     2109           p-change-value = v-diasize-orig-frame-width
     2110                          - frame d-type-tmp :width
     2111         .
     2112         if p-change-value >= 0
     2113         then do:
     2114           run diasize_position-resize-button in this-procedure .
     2115           return .
     2116         end.
     2117       end.
     2118     end.
     2119     if p-change-value >= 0
     2120     then do:
     2121       assign
     2122         v-change-sign = 1
     2123       .
     2124     end.
     2125     else do:
     2126       assign
     2127         v-change-sign = -1
     2128       .
     2129     end.
     2130     assign
     2131       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2132     .
     2133     if p-change-value = 0
     2134     then do:
     2135       run diasize_position-resize-button in this-procedure .
     2136       return .
     2137     end.
     2138     move_block:
     2139     do
     2140     on error undo move_block, leave move_block
     2141     :
     2142       if retry
     2143       then do:
     2144         do
     2145         on error undo move_block, leave move_block
     2146         :
     2147           if p-change-value > 0
     2148           then do:
     2149             for each buf_temp-diasize-handle
     2150             on error undo, next
     2151             :
     2152               assign
     2153                 v-object-handle = buf_temp-diasize-handle.handle-value
     2154               .
     2155               if v-object-handle <> v-diasize-resize-button
     2156               then do:
     2157                 assign
     2158                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2159                 .
     2160               end.
     2161             end.
     2162             assign
     2163               v-diasize-browse-handle :width = v-browse-width
     2164             .
     2165             for each buf_temp-browse-handle
     2166               where buf_temp-browse-handle.browse-type = 'width':u
     2167             on error undo, next
     2168             :
     2169               assign
     2170                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2171               .
     2172             end.
     2173             assign
     2174               frame d-type-tmp :width = v-frame-width
     2175             .
     2176             if frame d-type-tmp :scrollable = true
     2177             then do:
     2178               assign
     2179                 frame d-type-tmp :virtual-width = v-frame-virtual-width
     2180               .
     2181             end.
     2182             run diasize_position-resize-button in this-procedure .
     2183           end.
     2184           else do:
     2185             if frame d-type-tmp :scrollable = true
     2186             then do:
     2187               assign
     2188                 frame d-type-tmp :virtual-width = v-frame-virtual-width
     2189               .
     2190             end.
     2191             assign
     2192               frame d-type-tmp :width = v-frame-width
     2193             .
     2194             for each buf_temp-browse-handle
     2195               where buf_temp-browse-handle.browse-type = 'width':u
     2196             on error undo, next
     2197             :
     2198               assign
     2199                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2200               .
     2201             end.
     2202             assign
     2203               v-diasize-browse-handle :width = v-browse-width
     2204             .
     2205             for each buf_temp-diasize-handle
     2206             on error undo, next
     2207             :
     2208               assign
     2209                 v-object-handle = buf_temp-diasize-handle.handle-value
     2210               .
     2211               if v-object-handle <> v-diasize-resize-button
     2212               then do:
     2213                 assign
     2214                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2215                 .
     2216               end.
     2217             end.
     2218             run diasize_position-resize-button in this-procedure .
     2219           end.
     2220           assign
     2221             v-diasize-change-size = false
     2222           .
     2223           leave move_block .
     2224         end.
     2225       end.
     2226       assign
     2227         v-diasize-need-full-display = true
     2228       .
     2229       if v-diasize-change-size = false
     2230       then do:
     2231         assign
     2232           v-diasize-change-size = true
     2233         .
     2234       end.
     2235       else do:
     2236         return .
     2237       end.
     2238       assign
     2239         v-frame-width = frame d-type-tmp :width
     2240         v-frame-virtual-width = frame d-type-tmp :virtual-width
     2241         v-browse-width = v-diasize-browse-handle :width
     2242       .
     2243       for each buf_temp-browse-handle
     2244         where buf_temp-browse-handle.browse-type = 'width':u
     2245       :
     2246         assign
     2247           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2248         .
     2249       end.
     2250       for each buf_temp-diasize-handle
     2251       :
     2252         delete buf_temp-diasize-handle .
     2253       end.
     2254       assign
     2255         v-field-group-handle = frame d-type-tmp :first-child
     2256       .
     2257       do while valid-handle(v-field-group-handle)
     2258       :
     2259         assign
     2260           v-object-handle = v-field-group-handle :first-child
     2261         .
     2262         do while valid-handle(v-object-handle)
     2263         :
     2264           if  v-object-handle <> v-diasize-browse-handle :handle
     2265           and v-object-handle <> v-diasize-resize-button
     2266           and can-query(v-object-handle, "row")
     2267           and can-query(v-object-handle, "height")
     2268           and ( v-object-handle :col + v-object-handle :width
     2269                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2270               )
     2271           then do:
     2272             find first buf_temp-browse-handle
     2273               where buf_temp-browse-handle.browse-type   = 'width':u
     2274                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2275               no-error .
     2276             if available buf_temp-browse-handle
     2277             then do:
     2278             end.
     2279             else do:
     2280               create buf_temp-diasize-handle .
     2281               assign
     2282                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2283                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2284               .
     2285             end.
     2286           end.
     2287           assign
     2288             v-object-handle = v-object-handle :next-sibling
     2289           .
     2290         end.
     2291         assign
     2292           v-field-group-handle = v-field-group-handle :next-sibling
     2293         .
     2294       end.
     2295       do with frame d-type-tmp
     2296       :
     2297         hide v-diasize-resize-button .
     2298         v-diasize-resize-button :row = 1.
     2299         v-diasize-resize-button :column = 1.
     2300       end.
     2301       if p-change-value > 0
     2302       then do:
     2303         if frame d-type-tmp :scrollable = true
     2304         then do:
     2305           assign
     2306             frame d-type-tmp :virtual-width = frame d-type-tmp :virtual-width + p-change-value
     2307             no-error .
     2308           if error-status :error
     2309           or error-status :get-message(1) <> ""
     2310           then do:
     2311             undo move_block, retry move_block.
     2312           end.
     2313         end.
     2314         assign
     2315           frame d-type-tmp :width = v-frame-width + p-change-value
     2316           no-error .
     2317         if error-status :error
     2318         or error-status :get-message(1) <> ""
     2319         then do:
     2320           undo move_block, retry move_block.
     2321         end.
     2322         assign
     2323           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2324         no-error .
     2325         if error-status :error
     2326         or error-status :get-message(1) <> ""
     2327         then do:
     2328           undo move_block, retry move_block.
     2329         end.
     2330         for each buf_temp-browse-handle
     2331           where buf_temp-browse-handle.browse-type = 'width':u
     2332         on error undo move_block, retry move_block
     2333         :
     2334           assign
     2335             buf_temp-browse-handle.browse-handle :width
     2336               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2337             no-error .
     2338           if error-status :error
     2339           or error-status :get-message(1) <> ""
     2340           then do:
     2341             undo move_block, retry move_block .
     2342           end.
     2343         end.
     2344         for each buf_temp-diasize-handle
     2345         on error undo move_block, retry move_block
     2346         :
     2347           assign
     2348             v-object-handle = buf_temp-diasize-handle.handle-value
     2349           .
     2350           if v-object-handle <> v-diasize-resize-button
     2351           then do:
     2352             assign
     2353               v-object-handle :col = v-object-handle :col + p-change-value
     2354               no-error .
     2355             if error-status :error
     2356             or error-status :get-message(1) <> ""
     2357             then do:
     2358               undo move_block, retry move_block .
     2359             end.
     2360           end.
     2361         end.
     2362       end.
     2363       else do:
     2364         for each buf_temp-diasize-handle
     2365         on error undo move_block, retry move_block
     2366         :
     2367           assign
     2368             v-object-handle = buf_temp-diasize-handle.handle-value
     2369           .
     2370           if v-object-handle <> v-diasize-resize-button
     2371           then do:
     2372             assign
     2373               v-object-handle :col = v-object-handle :col + p-change-value
     2374               no-error .
     2375             if error-status :error
     2376             or error-status :get-message(1) <> ""
     2377             then do:
     2378               undo move_block, retry move_block .
     2379             end.
     2380           end.
     2381         end.
     2382         for each buf_temp-browse-handle
     2383           where buf_temp-browse-handle.browse-type = 'width':u
     2384         on error undo move_block, retry move_block
     2385         :
     2386           assign
     2387             buf_temp-browse-handle.browse-handle :width
     2388               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2389             no-error .
     2390           if error-status :error
     2391           or error-status :get-message(1) <> ""
     2392           then do:
     2393             undo move_block, retry move_block .
     2394           end.
     2395         end.
     2396         assign
     2397           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2398           no-error .
     2399         if error-status :error
     2400         or error-status :get-message(1) <> ""
     2401         then do:
     2402           undo move_block, retry move_block.
     2403         end.
     2404         assign
     2405           frame d-type-tmp :width = frame d-type-tmp :width + p-change-value
     2406         no-error .
     2407         if error-status :error
     2408         or error-status :get-message(1) <> ""
     2409         then do:
     2410           undo move_block, retry move_block.
     2411         end.
     2412         if frame d-type-tmp :scrollable = true
     2413         then do:
     2414           assign
     2415             frame d-type-tmp :virtual-width = frame d-type-tmp :virtual-width + p-change-value
     2416           no-error .
     2417           if error-status :error
     2418           or error-status :get-message(1) <> ""
     2419           then do:
     2420             undo move_block, retry move_block.
     2421           end.
     2422         end.
     2423       end.
     2424       if p-move-resize
     2425       then do:
     2426         run diasize_position-resize-button in this-procedure .
     2427       end.
     2428       if v-diasize-wndstore = true
     2429       then do:
     2430         if connected("ub") = true
     2431         then do:
     2432           define variable v-cntxt-db-num        as integer   no-undo .
     2433           define variable v-cntxt-userid        as character no-undo .
     2434           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2435                                             , OUTPUT v-cntxt-userid
     2436                                             ) .
     2437           run gbl/wndsizew.p
     2438             (input  v-cntxt-db-num
     2439             ,input  v-cntxt-userid
     2440             ,input  v-diasize-proc-name
     2441             ,input  'width':u
     2442             ,input  string(frame d-type-tmp :width - v-diasize-orig-frame-width)
     2443             ) .
     2444         end.
     2445       end.
     2446     end.
     2447     assign
     2448       v-diasize-change-size = false
     2449     .
     2450   end procedure.
     2451   procedure diasize_set-width :
     2452     define input  parameter p-new-width  as decimal   no-undo .
     2453     define input  parameter p-move-resize as logical   no-undo .
     2454     do
     2455     on error undo, return error return-value
     2456     :
     2457       run diasize_change-width in this-procedure
     2458         (input  (p-new-width - frame d-type-tmp :width)
     2459         ,input  p-move-resize
     2460         ) .
     2461     end.
     2462   end procedure.
     2463   procedure diasize_position-resize-button :
     2464     do with frame d-type-tmp
     2465     :
     2466       hide v-diasize-resize-button .
     2467       assign
     2468         v-diasize-resize-button :row = frame d-type-tmp :height - v-diasize-resize-button :height
     2469                     - 1
     2470                     - (frame d-type-tmp :border-bottom-pixels / session :pixels-per-row)
     2471         v-diasize-resize-button :col = frame d-type-tmp :width - v-diasize-resize-button :width
     2472                     - 1
     2473                     - (frame d-type-tmp :border-right-pixels / session :pixels-per-column)
     2474       .
     2475       view v-diasize-resize-button .
     2476     end.
     2477   end procedure.
     2478   on alt-right anywhere
     2479   do:
     2480     run diasize_change-width in this-procedure
     2481       (input 1
     2482       ,input true
     2483       ) .
     2484     return no-apply .
     2485   end.
     2486   on alt-left anywhere
     2487   do:
     2488     run diasize_change-width in this-procedure
     2489       (input -1
     2490       ,input true
     2491       ) .
     2492     return no-apply .
     2493   end.
     2494   on alt-down anywhere
     2495   do:
     2496     run diasize_change-height in this-procedure
     2497       (input 1
     2498       ,input true
     2499       ) .
     2500     return no-apply .
     2501   end.
     2502   on alt-up anywhere
     2503   do:
     2504     run diasize_change-height in this-procedure
     2505       (input -1
     2506       ,input true
     2507       ) .
     2508     return no-apply .
     2509   end.
     2510   on alt-enter of frame d-type-tmp
     2511   do:
     2512     run diasize_maximize in this-procedure
     2513       (input  ?
     2514       ).
     2515     return no-apply .
     2516   end.
     2517   procedure diasize_end-move :
     2518     do
     2519     on error undo, return error return-value
     2520     :
     2521       define variable v-row-delta as decimal   no-undo .
     2522       define variable v-col-delta as decimal   no-undo .
     2523       define variable v-new-row as decimal   no-undo .
     2524       define variable v-new-col as decimal   no-undo .
     2525       assign
     2526         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2527         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2528       .
     2529       assign
     2530         v-row-delta = v-new-row - frame d-type-tmp :height
     2531         v-col-delta = v-new-col - frame d-type-tmp :width
     2532       .
     2533       run diasize_change-height in this-procedure
     2534         (input v-row-delta
     2535         ,input true
     2536         ) .
     2537       run diasize_change-width in this-procedure
     2538         (input v-col-delta
     2539         ,input true
     2540         ) .
     2541     end.
     2542   end procedure.
     2543   procedure diasize_maximize :
     2544     define input  parameter p-action as logical   no-undo .
     2545     do
     2546     on error undo, return error return-value
     2547     :
     2548       if p-action = ?
     2549       then do:
     2550         if v-diasize-need-maximize = true
     2551         then do:
     2552           assign
     2553             p-action = true
     2554           .
     2555         end.
     2556         else do:
     2557           assign
     2558             p-action = false
     2559           .
     2560         end.
     2561       end.
     2562       if p-action = true
     2563       then do:
     2564         run diasize_change-height in this-procedure
     2565           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2566               - frame d-type-tmp :height-chars
     2567           ,input true
     2568           ) .
     2569         run diasize_change-width in this-procedure
     2570           (input session :width-chars
     2571               - frame d-type-tmp :width-chars
     2572           ,input true
     2573           ) .
     2574         assign
     2575           v-diasize-need-maximize = false
     2576         .
     2577       end.
     2578       else do:
     2579         run diasize_change-width in this-procedure
     2580           (input v-diasize-orig-frame-width
     2581               - frame d-type-tmp :width-chars
     2582           ,input true
     2583           ) .
     2584         run diasize_change-height in this-procedure
     2585           (input v-diasize-orig-frame-height
     2586               - frame d-type-tmp :height-chars
     2587           ,input true
     2588           ) .
     2589         assign
     2590           v-diasize-need-maximize = true
     2591         .
     2592       end.
     2593     end.
     2594   end procedure.
     2595   procedure diasize_restore-orig-size :
     2596     do
     2597     on error undo, return error return-value
     2598     :
     2599       assign
     2600         v-diasize-current-frame-width  = frame d-type-tmp :width
     2601         v-diasize-current-frame-height = frame d-type-tmp :height
     2602       .
     2603       run diasize_set-height in this-procedure
     2604         (input  v-diasize-orig-frame-height
     2605         ,input  true
     2606         ) .
     2607       run diasize_set-width in this-procedure
     2608         (input  v-diasize-orig-frame-width
     2609         ,input  true
     2610         ) .
     2611     end.
     2612   end procedure.
     2613   procedure diasize_restore-current-size :
     2614     do
     2615     on error undo, return error return-value
     2616     :
     2617       run diasize_set-height in this-procedure
     2618         (input  v-diasize-current-frame-height
     2619         ,input  true
     2620         ) .
     2621       run diasize_set-width in this-procedure
     2622         (input  v-diasize-current-frame-width
     2623         ,input  true
     2624         ) .
     2625     end.
     2626   end procedure.
     2627   procedure diasize_set-browse-handle :
     2628     define input  parameter p-browse-handle as handle   no-undo .
     2629     define buffer buf_temp-browse-handle for temp-browse-handle .
     2630     do
     2631     on error undo, return error return-value
     2632     :
     2633       assign
     2634         v-diasize-browse-handle = p-browse-handle
     2635       .
     2636       for each buf_temp-browse-handle
     2637       on error undo, return error return-value
     2638       :
     2639         delete buf_temp-browse-handle .
     2640       end.
     2641     end.
     2642   end procedure.
     2643   procedure diasize_add_browse :
     2644     define input  parameter p-browse-type   as character no-undo .
     2645     define input  parameter p-browse-handle as handle    no-undo .
     2646     define buffer buf_temp-browse-handle for temp-browse-handle .
     2647     do
     2648     on error undo, return error return-value
     2649     :
     2650       assign
     2651         v-diasize-browse-number = v-diasize-browse-number + 1
     2652       .
     2653       create buf_temp-browse-handle .
     2654       assign
     2655         buf_temp-browse-handle.browse-type   = p-browse-type
     2656         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2657         buf_temp-browse-handle.browse-handle = p-browse-handle
     2658       .
     2659     end.
     2660   end procedure.
     2661   procedure diasize_init :
     2662     define variable v-default-value    as logical   no-undo .
     2663     define variable v-restore-saved    as logical   no-undo .
     2664     define variable v-resize-value-str as character no-undo .
     2665     do
     2666     on error undo, return error return-value
     2667     :
     2668       do with frame d-type-tmp
     2669       :
     2670         assign
     2671           v-diasize-orig-frame-height = frame d-type-tmp :height
     2672           v-diasize-orig-frame-width  = frame d-type-tmp :width
     2673           v-diasize-browse-handle     = browse br-season :handle
     2674         .
     2675         create button v-diasize-resize-button
     2676         assign
     2677           parent        = frame d-type-tmp :first-child
     2678           label         = "s"
     2679           height-pixels = 16
     2680           width-pixels  = 16
     2681           visible       = true
     2682           sensitive     = true
     2683           movable       = true
     2684           triggers:
     2685             on end-move persistent run diasize_end-move in this-procedure .
     2686           end triggers.
     2687         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2688         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2689         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2690         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2691         assign
     2692           v-diasize-wndmax = false
     2693         .
     2694         if connected("ub") = true
     2695         then do:
     2696           define variable v-cntxt-db-num        as integer   no-undo .
     2697           define variable v-cntxt-userid        as character no-undo .
     2698           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2699                                             , OUTPUT v-cntxt-userid
     2700                                             ) .
     2701           run gbl/wndpar_r.p
     2702             (input  v-cntxt-db-num
     2703             ,input  v-cntxt-userid
     2704             ,input  'wndmax':U
     2705             ,output v-diasize-wndmax
     2706             ,output v-default-value
     2707             ) .
     2708         end.
     2709         assign
     2710           v-diasize-wndstore = false
     2711         .
     2712         if connected("ub") = true
     2713         then do:
     2714           run gbl/wndpar_r.p
     2715             (input  v-cntxt-db-num
     2716             ,input  v-cntxt-userid
     2717             ,input  'wndstore':U
     2718             ,output v-diasize-wndstore
     2719             ,output v-default-value
     2720             ) .
     2721         end.
     2722         assign
     2723           v-diasize-proc-name = entry(1, program-name(2), '.')
     2724         .
     2725         if v-diasize-wndstore = true
     2726         then do:
     2727           assign
     2728             v-restore-saved = false
     2729           .
     2730           if connected("ub") = true
     2731           then do:
     2732             run gbl/wndsizer.p
     2733               (input  v-cntxt-db-num
     2734               ,input  v-cntxt-userid
     2735               ,input  v-diasize-proc-name
     2736               ,input  'height':u
     2737               ,output v-resize-value-str
     2738               ) .
     2739             if v-resize-value-str <> '':U
     2740             then do:
     2741               run diasize_change-height in this-procedure
     2742                 (input  integer(v-resize-value-str)
     2743                 ,input  true
     2744                 ) .
     2745               assign
     2746                 v-restore-saved = true
     2747               .
     2748             end.
     2749           end.
     2750           if connected("ub") = true
     2751           then do:
     2752             run gbl/wndsizer.p
     2753               (input  v-cntxt-db-num
     2754               ,input  v-cntxt-userid
     2755               ,input  v-diasize-proc-name
     2756               ,input  'width':u
     2757               ,output v-resize-value-str
     2758               ) .
     2759             if v-resize-value-str <> '':U
     2760             then do:
     2761               run diasize_change-width in this-procedure
     2762                 (input  integer(v-resize-value-str)
     2763                 ,input  true
     2764                 ) .
     2765               assign
     2766                 v-restore-saved = true
     2767               .
     2768             end.
     2769           end.
     2770           if v-restore-saved <> true
     2771           then do:
     2772             if v-diasize-wndmax = true
     2773             then do:
     2774               run diasize_maximize in this-procedure
     2775                 (input  true
     2776                 ) .
     2777             end.
     2778           end.
     2779         end.
     2780         else do:
     2781           if v-diasize-wndmax = true
     2782           then do:
     2783             run diasize_maximize in this-procedure
     2784               (input  true
     2785               ) .
     2786           end.
     2787         end.
     2788       end.
     2789     end.
     2790   end procedure.
     2791   procedure diasize_need-full-display :
     2792     define output parameter p-need-full-display as logical   no-undo .
     2793     do
     2794     on error undo, return error return-value
     2795     :
     2796       assign
     2797         p-need-full-display = v-diasize-need-full-display
     2798       .
     2799       assign
     2800         v-diasize-need-full-display = false
     2801       .
     2802     end.
     2803   end procedure.
     2804   procedure get-context :
     2805      define output parameter p-db-num as integer          no-undo.
     2806      define output parameter p-user-id as character        no-undo.
     2807      define variable v-login               as character    no-undo.
     2808      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2809      define buffer buf_user-login  for ub.user-login .
     2810      do
     2811      on error undo, return error
     2812      :
     2813            FIND FIRST buf_sys-ctrl no-lock.
     2814            ASSIGN
     2815               v-login = USERID("ub")
     2816               p-db-num = buf_sys-ctrl.db-num
     2817            .
     2818            FIND FIRST buf_user-login
     2819                 WHERE buf_user-login.db-num = p-db-num
     2820                   AND buf_user-login.user-login = v-login
     2821                 no-lock
     2822                 no-error
     2823                 .
     2824            IF AVAILABLE buf_user-login
     2825            THEN DO:
     2826               assign
     2827                  p-user-id = buf_user-login.user-id
     2828               .
     2829            END.
     2830      end.
     2831   end procedure.
     2832       run diasize_init in this-procedure .
     2833   ON WINDOW-CLOSE OF FRAME d-type-tmp APPLY "END-ERROR":U TO SELF.
     2834   MAIN-BLOCK:
     2835   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2836      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2837       run enable_ui.
     2838       APPLY "VALUE-CHANGED":U TO br-season in frame d-type-tmp.
     2839       ub.season.sea-name:RESIZABLE in  browse br-season   = true .
     2840       if num-entries (rid-list) = 0 then
     2841           hide mark-num in frame d-type-tmp.
     2842       else
     2843           disp
     2844           num-entries (rid-list) @ mark-num
     2845           with frame d-type-tmp.
     2846       run open-br.
     2847       WAIT-FOR GO OF FRAME d-type-tmp.
     2848   END.
     2849   run disable_ui.
     2850   PROCEDURE disable_UI :
     2851     HIDE FRAME d-type-tmp.
     2852   END PROCEDURE.
     2853   PROCEDURE enable_UI :
     2854       RADIO-SET-1:screen-value in frame d-type-tmp = "1".
     2855       RADIO-SET-2:screen-value in frame d-type-tmp = "1".
     2856       ENABLE
     2857           br-season
     2858           b-exit
     2859           b-copy
     2860           b-add WHEN  (lookup  ( "b-add" , bttns) > 0 )
     2861           b-sel WHEN  (lookup  ( "b-sel" , bttns) > 0 )
     2862           b-mark when (lookup  ( "b-mark", bttns) > 0 )
     2863           b-upd WHEN  (lookup  ( "b-add" , bttns) > 0 )
     2864           b-del WHEN  (lookup  ( "b-add" , bttns) > 0 )
     2865           b-print
     2866           b-hist
     2867           b-help
     2868           b-goods
     2869           RADIO-SET-1
     2870           WITH FRAME  d-type-tmp.
     2871       if available ub.season then
     2872           log-res  = br-season:select-focused-row( ) in frame d-type-tmp.
     2873       run open-br.
     2874   END PROCEDURE.
     2875   PROCEDURE open-br-when-b-obj :
     2876   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2877   run userobjs_select-many in this-procedure
     2878     (input  parparentproc
     2879     ,input  v-cntxt-db-num
     2880     ,input  v-cntxt-userid
     2881     ,input  v-cntxt-host-code-obj
     2882     ,input  v-cntxt-obj-type
     2883     ,input  v-cntxt-obj-code
     2884     ,output v-sel-ok
     2885     )  .
     2886     if v-sel-ok = 'yes' then do:
     2887       v-sel-obj-list = "".
     2888       for each userobjs_temp-user-obj  :
     2889         v-sel-obj-list = v-sel-obj-list + "," + userobjs_temp-user-obj.obj-type + string(userobjs_temp-user-obj.obj-code).
     2890       end.
     2891       v-sel-obj-list = trim (v-sel-obj-list, ",").
     2892       OPEN QUERY br-season FOR EACH ub.season ,      EACH tt-season       WHERE season.sea-month-1 <> 0              AND season.sea-month-2 <> 0              AND tt-season.sea-code = season.sea-code              AND tt-season.db-num = season.db-num              AND tt-season.is-glob-sea = false              AND lookup(tt-season.attr-value, v-sel-obj-list) > 0              NO-LOCK.
     2893       apply "entry" to br-season in frame d-type-tmp.
     2894     end.
     2895   END PROCEDURE.
     2896   PROCEDURE open-br :
     2897   for each tt-season no-lock :
     2898     delete tt-season.
     2899   end.
     2900   FOR EACH ub.season
     2901   WHERE season.sea-month-1 <> 0
     2902   AND season.sea-month-2 <>  0 :
     2903     create tt-season.
     2904     tt-season.sea-code = season.sea-code.
     2905     tt-season.db-num = season.db-num.
     2906     tt-season.is-glob-sea = not can-find ( buf_season-attr where buf_season-attr.sea-code = ub.season.sea-code
     2907                          and buf_season-attr.db-num = ub.season.db-num
     2908                          and buf_season-attr.attr-code = 'sea-obj':U ).
     2909     find first ub.season-attr no-lock where season-attr.sea-code = season.sea-code
     2910                                       and season-attr.db-num = season.db-num no-error.
     2911     if available  season-attr then tt-season.attr-value = season-attr.attr-value.
     2912   END.
     2913   if RADIO-SET-1:screen-value in frame d-type-tmp = "1" then OPEN QUERY br-season FOR EACH ub.season ,      EACH tt-season       WHERE season.sea-month-1 <> 0              AND season.sea-month-2 <> 0              AND tt-season.sea-code = season.sea-code              AND tt-season.db-num = season.db-num              AND tt-season.is-glob-sea = true              NO-LOCK.
     2914   if RADIO-SET-1:screen-value in frame d-type-tmp = "2"
     2915     AND RADIO-SET-2:screen-value in frame d-type-tmp = "1"  then
     2916     OPEN QUERY br-season FOR EACH ub.season ,      EACH tt-season       WHERE season.sea-month-1 <> 0              AND season.sea-month-2 <> 0              AND tt-season.sea-code = season.sea-code              AND tt-season.db-num = season.db-num              AND tt-season.is-glob-sea = false              NO-LOCK.
     2917   if RADIO-SET-1:screen-value in frame d-type-tmp = "2"
     2918     AND RADIO-SET-2:screen-value in frame d-type-tmp = "2"  then
     2919     OPEN QUERY br-season FOR EACH ub.season ,      EACH tt-season       WHERE season.sea-month-1 <> 0              AND season.sea-month-2 <> 0              AND tt-season.sea-code = season.sea-code              AND tt-season.db-num = season.db-num              AND tt-season.is-glob-sea = false              AND tt-season.attr-value = v-cntxt-obj-type + string( v-cntxt-obj-code )              NO-LOCK.
     2920    if RADIO-SET-1:screen-value in frame d-type-tmp = "2"
     2921     AND RADIO-SET-2:screen-value in frame d-type-tmp = "3"  then
     2922     OPEN QUERY br-season FOR EACH ub.season ,      EACH tt-season       WHERE season.sea-month-1 <> 0              AND season.sea-month-2 <> 0              AND tt-season.sea-code = season.sea-code              AND tt-season.db-num = season.db-num              AND tt-season.is-glob-sea = false              AND lookup(tt-season.attr-value, v-sel-obj-list) > 0              NO-LOCK.
     2923   apply "entry" to br-season in frame d-type-tmp.
     2924   END PROCEDURE.
     2925   FUNCTION date-func RETURNS DATE
     2926   ( input date-int as int) :
     2927    define variable date-res as date no-undo.
     2928      if  date-int <= 12 then return error.
     2929      assign date-res = date (date-int) no-error.
     2930    RETURN date-res.
     2931   END FUNCTION.
     2932   procedure create-rep:
     2933       define output parameter p-filename as character no-undo.
     2934       define variable v-rls-file as character no-undo.
     2935       define variable v-data-file as character no-undo.
     2936       define variable v-xsl-file as character no-undo.
     2937       define variable v-tmp-file as character no-undo.
     2938       define variable hw as handle no-undo.
     2939       define variable rep-out as class Rep-Out no-undo.
     2940       assign
     2941           v-xsl-file = search("exe/season.xsl.html")
     2942           v-data-file = session:temp-directory + string(time) + ".xml"
     2943           v-tmp-file = session:temp-directory + string(time) + ".html"
     2944       .
     2945       create sax-writer hw.
     2946       hw:formatted = true.
     2947       hw:set-output-destination ("file", v-data-file).
     2948       run write-data(hw) .
     2949       rep-out = new rep-out().
     2950       v-rls-file = rep-out:xsl-transform(v-data-file, v-xsl-file).
     2951       os-delete value(v-tmp-file).
     2952       os-copy value(v-rls-file) value(v-tmp-file).
     2953       os-delete value(v-rls-file).
     2954       delete object rep-out.
     2955       p-filename = v-tmp-file.
     2956   end.
     2957   procedure write-data:
     2958       define input parameter hw as handle no-undo.
     2959           hw:start-document ().
     2960           hw:start-element ("rep").
     2961           hw:start-element ("card").
     2962           hw:insert-attribute ("time", if v-cur-time = ? then "" else v-cur-time ).
     2963           for each tt-line no-lock:
     2964           hw:start-element ("line").
     2965           hw:insert-attribute ("sea-code",if tt-line.sea-code = ? then "" else string(tt-line.sea-code)).
     2966           hw:insert-attribute ("db-num",if tt-line.db-num = ? then "" else string(tt-line.db-num)).
     2967           hw:insert-attribute ("sea-name",if tt-line.sea-name = ? then "" else string(tt-line.sea-name)).
     2968           hw:insert-attribute ("sea-month-1",if tt-line.sea-month-1 = ? then "" else string(date(tt-line.sea-month-1), "99/99/99")).
     2969           hw:insert-attribute ("sea-month-2",if tt-line.sea-month-2 = ? then "" else string(date(tt-line.sea-month-2),"99/99/99")).
     2970           hw:insert-attribute ("attr-value",if tt-line.attr-value = ? then "" else string(tt-line.attr-value)).
     2971           hw:end-element ("line").
     2972           end.
     2973           hw:end-element ("card").
     2974           hw:end-element ("rep").
     2975           hw:end-document ().
     2976   end.
     2977   procedure open-ie:
     2978       define input parameter p-filename as character no-undo.
     2979       define variable o-IE as com-handle no-undo.
     2980       create "InternetExplorer.Application" o-IE.
     2981       o-IE:addressbar = false.
     2982       o-IE:Navigate(p-filename).
     2983       o-IE:visible = true.
     2984       release object o-IE.
     2985   end.
