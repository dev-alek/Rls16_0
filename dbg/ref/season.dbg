      550   define button B-WaitFramStop auto-end-key
      551        label "Стоп"
      552        size 10 by 1 tooltip "Остоновить процесс".
      553   define button B-viewProcInfo
      554        label "Информация"
      555        size 15 by 1 tooltip "Информация о процесс".
      556   define frame waitfram
      557     v-waitfram-action01 format "x(72)" no-label skip
      558     v-waitfram-action02 format "x(72)" no-label skip
      559     v-waitfram-action03 format "x(72)" no-label skip
      560     B-viewProcInfo
      561     B-WaitFramStop at row 4 col 30
      562     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      563     .
      564   define new global shared variable mBatchMode as logical no-undo init ?.
      565   define variable mFramBachModHandle as handle no-undo.
      566   mFramBachModHandle = frame waitfram:handle.
      567   define variable mFameOldVis as logical no-undo.
      568   define variable mVisCUrentVin as logical no-undo.
      569   if session:batch-mode
      570   then
      571      mBatchMode = yes.
      572   if mBatchMode = ? then do:
      573     mVisCUrentVin = current-window:visible.
      574     mFameOldVis = mFramBachModHandle:visible.
      575     mFramBachModHandle:visible  = yes.
      576     mBatchMode = mFramBachModHandle:visible ne yes.
      577     mFramBachModHandle:visible = mFameOldVis.
      578     current-window:visible = mVisCUrentVin.
      579   end.
      580    if  log-manager:logfile-name ne ?
      581     then DO:
      582         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      583         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      584         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      585     end.
      586   on choose of B-WaitFramStop in frame waitfram
      587   do:
      588     mWaitFramStop = yes.
      589     mWaitFramStopUser = yes.
      590   end.
      591   function waitfram-check-timeout returns logical():
      592      define variable vtime as int64 no-undo.
      593      if mWaitFramStopTimeOut
      594      then
      595         return yes.
      596      vtime = ( now - mWaitFramStartProc ) / 1000 .
      597      if     mWaitFramTimeOut ne ?
      598         and mWaitFramTimeOut ne 0
      599         and mWaitFramTimeOut lt vtime
      600      then do:
      601         mWaitFramStopTimeOut = yes.
      602      end.
      603      return mWaitFramStopTimeOut.
      604   end.
      605   procedure waitfram-hide :
      606     if not session:batch-mode
      607     then do
      608     on error undo, return error return-value
      609     :
      610       pause 0 before-hide .
      611       if not mBatchMode then
      612         hide frame waitfram .
      613     if     not mWaitFramView
      614        and mWaitProcEvent
      615     then
      616       process events .
      617     end.
      618   end procedure.
      619   procedure waitfram-show :
      620     define input  parameter p-message as character no-undo .
      621     define variable v-left-margin as integer   no-undo .
      622     if not session:batch-mode
      623     then do
      624     on error undo, return error return-value
      625     :
      626       if length(p-message) <= 70 then do:
      627         assign
      628           v-left-margin = integer((70 - length(p-message)) / 2)
      629         .
      630         assign
      631           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      632         .
      633         assign
      634           v-waitfram-action01 = " "
      635           v-waitfram-action02 = " "
      636                                    + fill(" ", v-left-margin)
      637                                    + p-message
      638           v-waitfram-action03 = " "
      639         .
      640       end.
      641       else do:
      642         define variable vRindex1 as integer no-undo.
      643         define variable vRindex2 as integer no-undo.
      644         vRindex1 = r-index(p-message," ",70).
      645         if vRindex1 = 0
      646         then
      647            vRindex1 = 70.
      648         if length(p-message)  <= vRindex1 + 70 then do:
      649           assign
      650             v-waitfram-action01 = " "
      651             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      652             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      653           .
      654         end.
      655         else do:
      656           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      657           if vRindex2 <= vRindex1
      658           then
      659              vRindex2 = vRindex1 + 70.
      660           assign
      661             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      662             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      663             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      664           .
      665         end.
      666       end.
      667       B-viewProcInfo:visible   in frame waitfram = no.
      668       B-viewProcInfo:sensitive in frame waitfram = no.
      669       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      670       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      671       if  (   mWaitFramView
      672          or  mWaitProcEvent)
      673          and not mBatchMode
      674       then
      675          display
      676             v-waitfram-action01 skip
      677             v-waitfram-action02 skip
      678             v-waitfram-action03 skip
      679          with frame waitfram .
      680       if     mWaitFramView
      681          then do:
      682             if     mWaitFramInterval ne ?
      683                and not mBatchMode
      684             then
      685                wait-for go of frame waitfram pause mWaitFramInterval.
      686          end.
      687          else
      688             if     mWaitProcEvent
      689                and not mBatchMode
      690             then
      691                process events .
      692     end.
      693   end procedure.
      694      procedure waitfram-show-this:
      695         define input  parameter iInterval as int64 no-undo.
      696         define variable vtime as int64 no-undo.
      697         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      698         mWaitFramInterval = iInterval.
      699         run waitfram-show (substitute("&1&2 &3&4" ,
      700                                       mWaitFramTextBeg ,
      701                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      702                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      703                                       mWaitFramTextEnd
      704                                      )
      705                           ).
      706      end.
      707      procedure WaitFramRunPause:
      708         define input  parameter iInterval as dec no-undo.
      709         define variable vStart  as datetime-tz no-undo.
      710         define variable vend    as datetime-tz no-undo.
      711         define variable vint as int64 no-undo.
      712         define variable vOk as logical no-undo.
      713         vStart = now.
      714         vend   = vStart.
      715         publish "WaitFramPause" (iInterval,output vOk).
      716         vend   =  now.
      717         vint = vend - vStart.
      718         vint = iInterval - vint / 1000.
      719         if     not mWaitFramStop
      720            and (   vint > 0
      721                 or (    not vOk
      722                     and iInterval eq ?
      723                     )
      724                 )
      725         then
      726            run waitfram-show-this (iInterval).
      727         vend   =  now.
      728         vint = vend - vStart.
      729         vint = iInterval - vint / 1000.
      730         if     not mWaitFramStop
      731            and vint > 0
      732         then do:
      733            run gbl/pause.p (vint * 1000).
      734         end.
      735         if iInterval ne ?
      736         then
      737            publish "WaitFramStop".
      738         waitfram-check-timeout().
      739      end.
      740      procedure WaitFramWaitFor:
      741         define input  parameter iInterval as dec no-undo.
      742         assign
      743            mWaitFramStartProc   = now
      744            mWaitFramStopUser    = no
      745            mWaitFramStopTimeOut = no
      746         .
      747         block-wait:
      748         do while not mWaitFramStop:
      749            run WaitFramRunPause (iInterval).
      750            if  waitfram-check-timeout()
      751            then do:
      752               leave block-wait.
      753            end.
      754         end.
      755         run waitfram-hide.
      756      end.
      757   procedure waitfram-join :
      758     define input  parameter p-line-1  as character no-undo .
      759     define input  parameter p-line-2  as character no-undo .
      760     define input  parameter p-line-3  as character no-undo .
      761     define output parameter p-message as character no-undo .
      762     do
      763     on error undo, return error return-value
      764     :
      765       assign
      766         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      767                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      768                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      769       .
      770     end.
      771   end procedure.
      772   function waitfram-join-function returns character
      773     (input p-line-1 as character
      774     ,input p-line-2 as character
      775     ,input p-line-3 as character
      776     ).
      777     define variable v-message as character no-undo .
      778     run waitfram-join in this-procedure
      779       (input  p-line-1
      780       ,input  p-line-2
      781       ,input  p-line-3
      782       ,output v-message
      783       ) .
      784     return v-message .
      785   end function .
      786   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      787     run mainmenu_getcntxt in parparentproc
      788       (output v-cntxt-db-num
      789       ,output v-cntxt-userid
