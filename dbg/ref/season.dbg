      986   PROCEDURE chk-gdssea :
      987   define input  parameter p-gds-code as integer no-undo.
      988   define input  parameter p-seaobj as character no-undo.
      989   define input  parameter p-i-date1 as integer no-undo.
      990   define input  parameter p-i-date2 as integer no-undo.
      991   define input  parameter p-rowid as rowid no-undo.
      992   define output parameter p-sea-code as integer no-undo.
      993   define output parameter p-db-num as integer no-undo.
      994   define output parameter p-ok as logical no-undo init yes.
      995   define buffer buf_season for ub.season.
      996   define buffer buf1_season for ub.season.
      997   define buffer buf1_gds-season for ub.gds-season.
      998   define buffer buf_season-attr for ub.season-attr.
      999   define buffer buf1_season-attr for ub.season-attr.
     1000     for each buf1_season no-lock where ((buf1_season.sea-month-1 <= p-i-date1 and buf1_season.sea-month-2 >= p-i-date1)
     1001       or (buf1_season.sea-month-1 <= p-i-date2 and buf1_season.sea-month-2 >= p-i-date2)
     1002       or (buf1_season.sea-month-1 <= p-i-date1 and buf1_season.sea-month-2 >= p-i-date1))
     1003       and (rowid (buf1_season) <> p-rowid or p-rowid = ?):
     1004         if can-find (first buf1_season-attr where buf1_season-attr.sea-code = buf1_season.sea-code
     1005                                               and buf1_season-attr.db-num = buf1_season.db-num
     1006                                               and buf1_season-attr.attr-code = 'sea-obj':U
     1007                                               and buf1_season-attr.attr-value = p-seaobj
     1008                                               )
     1009           or
     1010           (not can-find (first buf1_season-attr where buf1_season-attr.sea-code = buf1_season.sea-code
     1011                                                 and buf1_season-attr.db-num = buf1_season.db-num
     1012                                                 and buf1_season-attr.attr-code = 'sea-obj':U
     1013                                                 )
     1014           and p-seaobj = "")
     1015         then do:
     1016           if can-find (first buf1_gds-season where  buf1_gds-season.sea-code = buf1_season.sea-code
     1017                                                 and buf1_gds-season.db-num = buf1_gds-season.db-num
     1018                                                 and buf1_gds-season.gds-code = p-gds-code)
     1019           then do:
     1020           assign
     1021             p-ok = false
     1022             p-sea-code = buf1_season.sea-code
     1023             p-db-num = buf1_season.db-num.
     1024             leave.
     1025           end.
     1026         end.
     1027     end.
     1028   END PROCEDURE.
