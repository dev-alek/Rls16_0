        1   using Progress.Lang.*.
        2   using Ibs.Th.Gbl.Rep-Out.
        3   define input  parameter parParentProc  as widget-handle no-undo.
        4   define input  parameter bttns  as character   no-undo .
        5   define output parameter rid-list    as  character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Справочник сезонов".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define new global shared variable g#language as character no-undo .
      112   if g#language <> '' and g#language <> 'rus':U then do:
      113     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      114   end.
      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118     define variable v-cntxt-db-num        as integer   no-undo .
      119     define variable v-cntxt-userid        as character no-undo .
      120     define variable v-cntxt-level         as character no-undo .
      121     define variable v-cntxt-host-code-obj as integer   no-undo .
      122     define variable v-cntxt-obj-type      as character no-undo .
      123     define variable v-cntxt-obj-code      as integer   no-undo .
      124     define variable v-cntxt-db-num-obj    as integer   no-undo .
      125     define variable v-cntxt-is-admin      as logical   no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      128   define new shared variable RepPathName        as character no-undo .
      129   define new shared variable PrintRubl          as logical   no-undo .
      130   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   procedure cur-time :
      132      define output parameter p-today as date      no-undo .
      133      define output parameter p-time  as integer   no-undo .
      134     do
      135     on error undo, return error
      136     :
      137       define variable v-date1 as date      no-undo .
      138       define variable v-date2 as date      no-undo .
      139       define variable v-time  as integer   no-undo .
      140       assign
      141         v-date1 = today
      142         v-time  = time
      143         v-date2 = today
      144       .
      145       if v-date1 <> v-date2
      146       then do:
      147         assign
      148           v-date1 = today
      149           v-time  = v-time
      150         .
      151       end.
      152       assign
      153         p-today = v-date1
      154         p-time  = v-time
      155       .
      156     end.
      157   end.
      158   function cur-time-date returns character
      159   :
      160     return string(today, '99/99/9999':U) .
      161   end.
      162   function cur-time-mjd returns decimal
      163   :
      164     define variable v-date as date      no-undo .
      165     define variable v-time as integer   no-undo .
      166     run cur-time in this-procedure
      167       (output v-date
      168       ,output v-time
      169       ) .
      170     return integer(v-date) - 2400002 + (v-time / 86400) .
      171   end.
      172   function cur-time-get-ending-index returns integer
      173   (input p-number as integer
      174   )
      175   :
      176     if p-number < 0
      177     or p-number = ?
      178     then do:
      179       return 1 .
      180     end.
      181     define variable v-rest as integer   no-undo .
      182     assign
      183       p-number = p-number modulo 100
      184     .
      185     if p-number < 20
      186     then do:
      187       assign
      188         v-rest = p-number
      189       .
      190     end.
      191     else do:
      192       assign
      193         v-rest = p-number modulo 10
      194       .
      195     end.
      196     case v-rest :
      197       when 1
      198       then do:
      199         return 2 .
      200       end.
      201       when 2 or
      202       when 3 or
      203       when 4
      204       then do:
      205         return 3 .
      206       end.
      207       otherwise do:
      208         return 1 .
      209       end.
      210     end case .
      211   end.
      212   procedure cur-time-mjd-to-date :
      213      define input  parameter i-mjd-diff as decimal no-undo.
      214      define output parameter o-Date     as date    no-undo.
      215      define output parameter o-Time     as integer no-undo.
      216      define variable v-day-number as integer   no-undo .
      217      if    i-mjd-diff < 0
      218         or i-mjd-diff = ?
      219      then do:
      220         return "?" .
      221      end.
      222      assign
      223         v-day-number = truncate(i-mjd-diff,0).
      224         o-Date = date(v-day-number + 2400002).
      225         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      226     .
      227   end.
      228   function cur-time-mjd-to-string returns character
      229   (input p-mjd-diff as decimal
      230   )
      231   :
      232     define variable v-day-number as integer   no-undo .
      233     define variable v-seconds    as integer   no-undo .
      234     define variable v-hour       as integer   no-undo .
      235     define variable v-min        as integer   no-undo .
      236     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      237     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      238     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      239     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      240     if p-mjd-diff < 0
      241     or p-mjd-diff = ?
      242     then do:
      243       return "?" .
      244     end.
      245     assign
      246       v-day-number = integer(truncate(p-mjd-diff,0))
      247       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      248     .
      249     if v-seconds > 86400
      250     then do:
      251       assign
      252         v-seconds = 86400 - 1
      253       .
      254     end.
      255     if v-seconds < 0
      256     then do:
      257       assign
      258         v-seconds = 0
      259       .
      260     end.
      261     assign
      262       v-hour = truncate(v-seconds / 3600, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 3600
      266     .
      267     assign
      268       v-min = truncate(v-seconds / 60, 0)
      269     .
      270     assign
      271       v-seconds = v-seconds modulo 60
      272     .
      273     return
      274         (if v-day-number <> 0
      275           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      276           else ""
      277         )
      278       + (if v-day-number <> 0 or v-hour <> 0
      279           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      283           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      284           else ""
      285         )
      286       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      287       .
      288   end.
      289   function cur-time-string returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-string-sec returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      308   end.
      309   function cur-time-custom  returns character
      310   (input p-prefix as character
      311   ,input p-date-format as character
      312   ,input p-delimiter as character
      313   ,input p-time-format as character
      314   ,input p-suffix as character
      315   )
      316   :
      317     define variable v-date as date      no-undo .
      318     define variable v-time as integer   no-undo .
      319     run cur-time in this-procedure
      320       (output v-date
      321       ,output v-time
      322       ) .
      323     return
      324       p-prefix
      325       + string(v-date, p-date-format)
      326       + p-delimiter
      327       + string(v-time, p-time-format)
      328       + p-suffix
      329       .
      330   end.
      331   function cur-time-print  returns character
      332   :
      333     define variable v-date as date      no-undo .
      334     define variable v-time as integer   no-undo .
      335     run cur-time in this-procedure
      336       (output v-date
      337       ,output v-time
      338       ) .
      339     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      340   end.
      341   function cur-time-datetime returns datetime
      342   :
      343     define variable v-char as character no-undo .
      344     define variable v-datetime as datetime no-undo .
      345     v-char = cur-time-string().
      346     v-datetime = datetime(v-char).
      347     return  v-datetime.
      348   end.
      349   function cur-time-string-msec returns character
      350   :
      351     define variable v-date as datetime  no-undo .
      352     v-date = now.
      353     return string(v-date) .
      354   end.
      355   function diff-list returns character (
      356     input parfirst-list  as character,
      357     input parsecond-list as character,
      358     input pardelim       as character).
      359     if pardelim = ""
      360     or pardelim = ?
      361     then do:
      362       assign
      363         pardelim = ","
      364       .
      365     end.
      366     def var ind as integer no-undo .
      367     def var v-elem as character no-undo .
      368     def var v-result-list as character no-undo init "".
      369     def var v-num-parfirst-list as integer no-undo .
      370     assign
      371       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      372     .
      373     do ind = 1 to v-num-parfirst-list
      374     :
      375       assign
      376         v-elem = entry(ind, parfirst-list, pardelim)
      377       .
      378       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      379         assign
      380           v-result-list = v-result-list
      381                         + (if v-result-list > "" then pardelim else "")
      382                         + v-elem
      383         .
      384       end.
      385     end.
      386     return v-result-list .
      387   end function.
      388   function add-list returns character (
      389    input parfirst-list  as character,
      390    input parsecond-list as character,
      391    input pardelim       as character).
      392     if pardelim = ""
      393     or pardelim = ?
      394     then do:
      395       assign
      396         pardelim = ","
      397       .
      398     end.
      399     def var ind as integer no-undo .
      400     def var v-elem as character no-undo .
      401     def var v-result-list as character no-undo init "".
      402     def var v-num-parfirst-list as integer no-undo .
      403     assign
      404       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      405     .
      406     do ind = 1 to v-num-parfirst-list
      407     :
      408       assign
      409         v-elem = entry(ind, parfirst-list, pardelim)
      410       .
      411       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      412         assign
      413           v-result-list = v-result-list
      414                         + (if v-result-list > "" then pardelim else "")
      415                         + v-elem
      416         .
      417       end.
      418     end.
      419     def var v-num-parsecond-list as integer no-undo .
      420     assign
      421       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      422     .
      423     do ind = 1 to v-num-parsecond-list
      424     :
      425       assign
      426         v-elem = entry(ind, parsecond-list, pardelim)
      427       .
      428       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      429         assign
      430           v-result-list = v-result-list
      431                         + (if v-result-list > "" then pardelim else "")
      432                         + v-elem
      433         .
      434       end.
      435     end.
      436     return v-result-list .
      437   end function.
      438   function cross-list returns character (
      439    input parfirst-list  as character,
      440    input parsecond-list as character,
      441    input pardelim       as character).
      442     if pardelim = ""
      443     or pardelim = ?
      444     then do:
      445       assign
      446         pardelim = ","
      447       .
      448     end.
      449     def var ind as integer no-undo .
      450     def var v-elem as character no-undo .
      451     def var v-result-list as character no-undo init "".
      452     def var v-num-parfirst-list as integer no-undo .
      453     assign
      454       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      455     .
      456     do ind = 1 to v-num-parfirst-list
      457     :
      458       assign
      459         v-elem = entry(ind, parfirst-list, pardelim)
      460       .
      461       if lookup(v-elem, v-result-list, pardelim) = 0
      462       and lookup(v-elem, parsecond-list, pardelim) > 0
      463       then do:
      464         assign
      465           v-result-list = v-result-list
      466                         + (if v-result-list > "" then pardelim else "")
      467                         + v-elem
      468         .
      469       end.
      470     end.
      471     return v-result-list .
      472   end function.
      473   function radio-label returns character (
      474    input par-rs-value  as character,
      475    input par-rs-radio-buttons as character)
      476    .
      477    DEFINE variable v-result-label as character no-undo.
      478    assign
      479    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      480                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      481                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      482                             ), par-rs-radio-buttons
      483                           )
      484    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      485    .
      486   return v-result-label.
      487   end function.
      488   function m-radio-label returns character (
      489    input par-rs-value  as character,
      490    input par-rs-radio-buttons as character,
      491    input par-delim as character
      492    )
      493    .
      494    DEFINE variable v-result-label as character no-undo.
      495    assign
      496    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      497                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      498                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      499                             ), par-rs-radio-buttons, par-delim
      500                           )
      501    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      502    .
      503   return v-result-label.
      504   end function.
      505   FUNCTION mixlist returns character
      506   (
      507    input parfirst-list  as character
      508    ,input parsecond-list as character
      509    ,input pardelim       as character
      510    ,input pardelim-result as character ) :
      511     if pardelim = ""
      512     or pardelim = ?
      513     then do:
      514       assign
      515         pardelim = ","
      516       .
      517     end.
      518     def var ind as integer no-undo .
      519     def var v-elem1 as character no-undo .
      520     def var v-elem2 as character no-undo .
      521     def var v-result-list as character no-undo init "".
      522     do ind = 1 to num-entries(parfirst-list, pardelim)
      523     :
      524       assign
      525         v-elem1 = entry(ind, parfirst-list, pardelim)
      526         v-elem2 = entry(ind, parsecond-list, pardelim)
      527       .
      528         assign
      529           v-result-list = v-result-list
      530                         + (if v-result-list > "" then pardelim-result else "")
      531                         + v-elem1 + pardelim-result + v-elem2
      532         .
      533     end.
      534     return v-result-list .
      535   END FUNCTION.
      536   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
