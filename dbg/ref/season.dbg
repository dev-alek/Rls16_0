      791       ,output v-cntxt-host-code-obj
      792       ,output v-cntxt-obj-type
      793       ,output v-cntxt-obj-code
      794       ,output v-cntxt-db-num-obj
      795       ,output v-cntxt-is-admin
      796       ) .
      797   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      798   define temp-table userobjs_temp-user-obj no-undo
      799     field obj-type as character
      800     field obj-code as integer
      801     index xpk is primary unique obj-type obj-code
      802     .
      803   procedure userobjs_clear :
      804     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      805     do
      806     on error undo, return error return-value
      807     :
      808       for each buf_userobjs_temp-user-obj
      809       on error undo, return error return-value
      810       :
      811         delete buf_userobjs_temp-user-obj .
      812       end.
      813     end.
      814   end .
      815   procedure userobjs_object-count :
      816     define output parameter p-total-count as integer   no-undo .
      817     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      818     do
      819     on error undo, return error return-value
      820     :
      821       assign
      822         p-total-count = 0
      823       .
      824       for each buf_userobjs_temp-user-obj
      825       on error undo, return error return-value
      826       :
      827         assign
      828           p-total-count = p-total-count + 1
      829         .
      830       end.
      831     end.
      832   end.
      833   procedure userobjs_append :
      834      define input  parameter p-obj-type as character no-undo .
      835      define input  parameter p-obj-code as integer   no-undo .
      836     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      837     do
      838     on error undo, return error return-value
      839     :
      840       find first buf_userobjs_temp-user-obj
      841         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      842           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      843         no-error .
      844       if not available buf_userobjs_temp-user-obj
      845       then do:
      846         create buf_userobjs_temp-user-obj .
      847         assign
      848           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      849           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      850         .
      851       end.
      852     end.
      853   end.
      854   procedure userobjs_object-exist :
      855     define output parameter p-object-exist as logical   no-undo .
      856     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      857     do
      858     on error undo, return error return-value
      859     :
      860       find first buf_userobjs_temp-user-obj
      861         no-error .
      862       if not available buf_userobjs_temp-user-obj
      863       then do:
      864         assign
      865           p-object-exist = false
      866         .
      867       end.
      868       else do:
      869         assign
      870           p-object-exist = true
      871         .
      872       end.
      873     end.
      874   end.
      875   procedure userobjs_transfer :
      876     define input  parameter p-callback-handle as handle no-undo .
      877     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      878     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      879     do
      880     on error undo, return error return-value
      881     :
      882       if valid-handle(p-callback-handle) <> true
      883       then do:
      884         message
      885           vss-workfile vss-revision vss-description skip
      886           "Ошибка задания входных параметров" skip
      887           "Неизвестный указатель на процедуру" skip
      888           view-as alert-box error .
      889         undo, return error return-value .
      890       end.
      891       if p-callback-handle :get-signature("userobjs_append") = ""
      892       then do:
      893         message
      894           vss-workfile vss-revision vss-description skip
      895           "Ошибка задания входных параметров" skip
      896           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      897                     ,p-callback-handle :file-name
      898                     ) skip
      899           view-as alert-box error .
      900         undo, return error return-value .
      901       end.
      902       for each buf_userobjs_temp-user-obj
      903       on error undo, return error return-value
      904       :
      905         run userobjs_append in p-callback-handle
      906           (input  buf_userobjs_temp-user-obj.obj-type
      907           ,input  buf_userobjs_temp-user-obj.obj-code
      908           ) .
      909       end.
      910     end.
      911   end procedure.
