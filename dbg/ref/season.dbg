      539   define variable v-waitfram-action03         as character   no-undo .
      540   define variable mWaitFramTextBeg            as character   no-undo.
      541   define variable mWaitFramTextEnd            as character   no-undo.
      542   define variable mWaitFramView               as logical     no-undo.
      543   define variable mWaitProcEvent              as logical     no-undo init yes.
      544   define variable mWaitFramInterval           as integer     no-undo init 1 .
      545   define variable mWaitFramStop               as logical     no-undo.
