      215   "Фирма", 1,
      216   "Объект", 2
      217        SIZE 63 BY 1 NO-UNDO.
      218   DEFINE VARIABLE reg-cash AS LOGICAL INITIAL no
      219        LABEL "Разрешена регистрация на кассе"
      220        VIEW-AS TOGGLE-BOX
      221        SIZE 34.5 BY .83 NO-UNDO.
      222   DEFINE QUERY Dialog-Frame FOR
      223         tt-dis-card-mask SCROLLING.
