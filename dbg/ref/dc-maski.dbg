      393                   (
      394                    input parParentProc
      395                   ,input p-curr-host-code
      396                   ,input p-curr-obj-type
      397                   ,input p-curr-obj-code
      398                   ,input "":U
      399                   ,input "one":U
      400                   ,input locked_dis-card-mask.type
      401                   ,input locked_dis-card-mask.host-code
      402                   ,input locked_dis-card-mask.mask-num
