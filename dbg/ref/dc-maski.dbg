      189   DEFINE VARIABLE CB-CC-run AS CHARACTER FORMAT "X(256)":U
      190        LABEL "Алгоритм КЦ"
      191        VIEW-AS COMBO-BOX INNER-LINES 5
      192        LIST-ITEM-PAIRS "item 1","Item 1"
      193        DROP-DOWN-LIST
      194        SIZE 30 BY 1 NO-UNDO.
      195   DEFINE VARIABLE f-cli-name AS CHARACTER FORMAT "X(256)":U
      196         VIEW-AS TEXT
      197        SIZE 46 BY 1 NO-UNDO.
      198   DEFINE VARIABLE f-emitent-name AS CHARACTER FORMAT "X(256)":U
      199         VIEW-AS TEXT
      200        SIZE 63.5 BY 1 NO-UNDO.
      201   DEFINE VARIABLE l-rs-cli-mask AS CHARACTER FORMAT "X(256)":U INITIAL "Метод поиска ДК по маске карты"
      202         VIEW-AS TEXT
      203        SIZE 31 BY 1 NO-UNDO.
      204   DEFINE VARIABLE RS-cli-mask AS CHARACTER
      205        VIEW-AS RADIO-SET HORIZONTAL
      206        RADIO-BUTTONS
      207             "Правило из маски", "cli-mask",
      208   "Определенный контрагент", "cli-code",
      209   "Маска и контрагент", "cli-mask-cli-code"
      210        SIZE 64.5 BY 1 NO-UNDO.
