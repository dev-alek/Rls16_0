      444   DO:
      445     if   input frame Dialog-Frame tt-dis-card-mask.cli-code <> 0 then do:
      446       run check-cli in this-procedure no-error.
      447       if error-status:error then do:
      448          return no-apply.
      449       end.
      450     end.
      451   END.
      452   ON VALUE-CHANGED OF tt-dis-card-mask.cli-type IN FRAME Dialog-Frame
      453   DO:
      454     assign
