      278        f-emitent-name AT ROW 5.25 COL 24 COLON-ALIGNED NO-LABEL
      279        l-rs-cli-mask AT ROW 9.71 COL 3 NO-LABEL
      280        f-cli-name AT ROW 12 COL 50.5 COLON-ALIGNED NO-LABEL
      281        "Область действия" VIEW-AS TEXT
      282             SIZE 17.5 BY 1 AT ROW 6.5 COL 3
      283        "Контрагент" VIEW-AS TEXT
      284             SIZE 13.5 BY 1 AT ROW 12 COL 3
      285        SPACE(82.74) SKIP(2.78)
      286       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      287            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      288            TITLE "Маска дисконтной карты"
      289            DEFAULT-BUTTON B-exit.
      290   ASSIGN
      291          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      292          FRAME Dialog-Frame:HIDDEN           = TRUE.
      293   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      294   DO:
      295     APPLY "END-ERROR":U TO SELF.
      296   END.
      297   ON CHOOSE OF B-card-type IN FRAME Dialog-Frame
      298   DO:
      299     run proc-b-card-type no-error.
      300       if error-status:error then return no-apply.
      301     APPLY "LEAVE" to tt-dis-card-mask.emitent-host-code.
      302   END.
      303   ON CHOOSE OF B-cli IN FRAME Dialog-Frame
      304   DO:
      305     define variable ref-list as character no-undo.
      306   define variable ref-rec as recid no-undo.
      307   define buffer buf_clients for ub.clients.
      308   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   if lookup(self :type
      310            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      311            ) = 0
      312   then do:
      313     message
      314       "$Workfile$"
      315       "Указанному интерфейсному элементу фокус не может быть передан" skip
      316       "Интерфейсный элемент" self :name  skip
      317       "Тип" self :type  skip
      318       "Процедура" this-procedure :file-name skip
      319       view-as alert-box .
      320   end.
      321   else do:
      322     apply "entry":u to self  .
      323     if focus :handle <> self :handle  then do:
      324       return no-apply .
      325     end.
      326   end.
      327     run ref/cli-all.w ( parParentProc
      328                     ,"b-sel"
      329                     , tt-dis-card-mask.cli-type
      330                     , ?
      331                     , ?
      332                     , (if available X_clients then recid(X_clients) else ?)
      333                     , ?
      334                     , "":U
      335                     , output ref-list) .
      336       if ref-list = "" then   do:
      337         return no-apply.
      338       end.
      339       ref-rec = integer( ref-list ).
      340       FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
      341       if NOT (buf_clients.obj-type = 'орг':U
      342               or
      343               buf_clients.obj-type = 'чел':U ) then do:
      344         message
      345         "Выберите контрагента типа" 'орг':U "или" 'чел':U
      346         view-as alert-box error .
      347         return no-apply.
      348       end.
      349       find first X_clients no-lock where
      350                 recid(X_clients) = recid(buf_clients).
      351       assign
      352       tt-dis-card-mask.cli-type =  buf_clients.obj-type
      353       tt-dis-card-mask.cli-code = buf_clients.obj-code
      354       f-cli-name = buf_clients.obj-name
      355       .
      356       display
      357       tt-dis-card-mask.cli-type
      358       tt-dis-card-mask.cli-code
      359       f-cli-name
      360       with frame Dialog-Frame.
      361   END.
      362   ON CHOOSE OF B-cli-mask IN FRAME Dialog-Frame
      363   DO:
      364    DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
      365    DEFINE VARIABLE v-mask AS CHARACTER NO-UNDO.
      366      run ref/fillques.w (INPUT tt-dis-card-mask.cli-mask
      367                    ,INPUT "Редактирование правила определения номера ДК по маске карты"
      368                    ,INPUT "Маска"
      369                    ,INPUT 19
      370                    ,INPUT  "?0123456789DC":U
      371                    ,OUTPUT v-mask
      372                    ,OUTPUT v-ok) NO-ERROR.
      373    IF NOT ERROR-STATUS:ERROR AND v-ok THEN DO:
      374        ASSIGN
      375        tt-dis-card-mask.cli-mask = v-mask.
      376        DISPLAY
      377        tt-dis-card-mask.cli-mask
      378        WITH FRAME Dialog-Frame.
      379    END.
      380   END.
