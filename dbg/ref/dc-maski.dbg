      411     run ref/fillques.w (INPUT tt-dis-card-mask.mask
      412                    ,INPUT "Редактирование маски карты"
      413                    ,INPUT "Маска"
      414                    ,INPUT 19
      415                    ,INPUT  "?*0123456789":U
      416                    ,OUTPUT v-mask
      417                    ,OUTPUT v-ok) NO-ERROR.
      418    IF NOT ERROR-STATUS:ERROR AND v-ok THEN DO:
      419        ASSIGN
      420        tt-dis-card-mask.mask = v-mask.
      421        DISPLAY
      422        tt-dis-card-mask.mask
      423        WITH FRAME Dialog-Frame.
      424    END.
      425   END.
      426   ON CHOOSE OF B-rank IN FRAME Dialog-Frame
      427   DO:
      428       define variable v-rid-list as character no-undo .
      429     run ref/dc-masks.w (
      430                       INPUT parparentproc
      431                      ,INPUT p-curr-host-code
      432                      ,INPUT p-curr-obj-type
      433                      ,INPUT p-curr-obj-code
      434                      ,input "b-chg":U
      435                      ,INPUT 'все':U
      436                      ,INPUT '':U
      437                      ,INPUT 0
      438                      ,INPUT ?
      439                      ,input-output v-rid-list
      440                       ) NO-ERROR.
      441     IF ERROR-STATUS:error  THEN RETURN NO-APPLY.
      442   END.
