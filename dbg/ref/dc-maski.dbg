      262        tt-dis-card-mask.cli-type AT ROW 12 COL 16.5 NO-LABEL
      263             VIEW-AS RADIO-SET HORIZONTAL
      264             RADIO-BUTTONS
      265                       "Item 1", "1":U,
      266   "Item 2", "2":U
      267             SIZE 14 BY 1
      268        tt-dis-card-mask.cli-code AT ROW 12 COL 29.5 COLON-ALIGNED NO-LABEL
      269             VIEW-AS FILL-IN
