      473     RUN proc-cli-or-mask IN THIS-PROCEDURE (rs-cli-mask) NO-ERROR.
      474     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
      475   END.
      476   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      477   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      478   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   on help of frame Dialog-Frame
      480   do:
      481     run gbl/app_help.p
      482       (input this-procedure :file-name
      483       ,input ''
      484       ,input ?
      485       ) no-error.
      486     if error-status :error then do:
      487       message
      488         "Ошибка при вызове помощи"
      489         error-status :get-message(1)
      490         view-as alert-box .
      491     end.
      492   end.
      493   run minbtn-set in this-procedure .
      494   on choose of b-help in frame Dialog-Frame
      495   do:
      496     apply "help":u to frame Dialog-Frame .
      497   end.
      498   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      499   procedure minbtn-set :
      500       do
      501           on error undo, return error return-value
      502           :
      503           define variable ii              as integer       no-undo .
      504           define variable fh              as widget-handle no-undo .
      505           define variable hh              as widget-handle no-undo .
      506           define variable v-h             as handle        extent 4 no-undo .
      507           define variable v-name-button   as character     no-undo .
      508           define variable v-help-old-x    as decimal       no-undo .
      509           define variable v-help-old-y    as decimal       no-undo .
      510           define variable v-help-old-size as decimal       no-undo .
      511           define variable v-frame-width   as decimal       no-undo .
      512           define variable jj              as integer       no-undo .
      513           do
      514               on error undo, return error
      515               :
      516               assign
      517                   v-frame-width = frame Dialog-Frame:width - 0.3
      518                   fh            = frame Dialog-Frame:first-child
      519                   hh            = fh:first-child
      520                   ii            = 1
      521                   .
      522               do while valid-handle(hh):
      523                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      524                   do:
      525                       case lc(hh:name) :
      526                           when "b-help" then
      527                               do:
      528                                   hh:load-image-up("cmp/b-help.bmp":u) .
      529                                   hh:load-image-down("cmp/b-help.bmp":u) .
      530                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      531                                   hh:TOOLTIP = "Помощь" .
      532                                   v-help-old-x = hh:column .
      533                                   v-help-old-y = hh:row    .
      534                                   v-help-old-size = hh:width .
      535                                   hh:width-chars = 2.5 .
      536                               end.
      537                           when "b-print" then
      538                               do:
      539                                   hh:load-image("cmp/b-print.bmp":u) .
      540                                   hh:TOOLTIP = "Печать" .
      541                                   v-h[ii] = hh:handle .
      542                                   ii = ii + 1 .
      543                                   hh:width-chars = 3 .
      544                               end.
      545                           when "b-history" or
      546                           when "b-hist" then
      547                               do:
      548                                   hh:load-image("cmp/b-hist.bmp":u) .
      549                                   hh:TOOLTIP = "История" .
      550                                   v-h[ii] = hh:handle .
      551                                   ii = ii + 1 .
      552                                   hh:width-chars = 3 .
      553                               end.
      554                           when "b-sch" then
      555                               do:
      556                                   hh:load-image("cmp/b-sch.bmp":u) .
      557                                   hh:TOOLTIP = "Установка Фильтра" .
      558                                   v-h[ii] = hh:handle .
      559                                   ii = ii + 1 .
      560                                   hh:width-chars = 3 .
      561                               end.
      562                           when "b-hist-user" then
      563                               do:
      564                                   hh:load-image("cmp/b-hist.bmp":u) .
      565                                   hh:TOOLTIP = "История пользователя" .
      566                                   ii = ii + 1 .
      567                               end.
      568                       end case.
      569                   end.
      570                   hh = hh:next-sibling.
      571               end.
      572               b-help:column = v-frame-width - b-help:width-chars.
      573               jj = 0.
      574               repeat ii = 4 to 1 by -1 :
      575                   if valid-handle (v-h[ii] ) then
      576                   do:
      577                       jj  = jj + 1 .
      578                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      579                       v-h[ii]:row    = v-help-old-y .
      580                   end.
      581               end.
      582           end.
      583       end.
      584   end procedure.
      585   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   ON TAB ANYWHERE
      587   DO:
      588   define variable ii as integer no-undo .
      589   define variable fh as widget-handle no-undo .
      590   define variable hh as widget-handle no-undo .
      591   define variable v-next-widget-name as character no-undo .
      592   if v-tab-order <> '' then do:
      593     if self:type = "TOGGLE-BOX" then
      594     self:BGCOLOR = ?.
      595     assign
      596     ii = lookup(self:name, v-tab-order).
      597     assign
      598     ii = ii + 1
      599     v-next-widget-name = entry(ii, v-tab-order)
      600     no-error .
      601     if error-status:error then do:
      602       assign
      603       ii = 1
      604       v-next-widget-name = entry( ii, v-tab-order)
      605       .
      606     end.
      607     assign
      608     fh = frame Dialog-Frame:first-child
      609     hh = fh:first-child
      610     .
      611     do while valid-handle(hh):
      612       if hh:name = v-next-widget-name then do:
      613         if hh:sensitive  = yes
      614         AND hh:visible = yes then do:
      615           APPLY "ENTRY" to hh.
      616           return no-apply.
      617         end.
      618         else do:
      619           APPLY "TAB" to hh.
      620           return no-apply.
      621         end.
      622       end.
      623       hh = hh:next-sibling.
      624     end.
      625   end.
      626   END.
      627   ON BACK-TAB ANYWHERE
      628   DO:
      629   define variable ii as integer no-undo .
      630   define variable fh as widget-handle no-undo .
      631   define variable hh as widget-handle no-undo .
      632   define variable v-next-widget-name as character no-undo .
      633   if v-tab-order <> '' then do:
      634     assign
      635     ii = lookup(self:name, v-tab-order).
      636     .
      637     assign
      638     ii = (if ii = 1
      639           then  num-entries(v-tab-order)
      640           else ii - 1
      641           )
      642     v-next-widget-name = entry(ii, v-tab-order)
      643     .
      644     assign
      645     fh = frame Dialog-Frame:first-child
      646     hh = fh:first-child
      647     .
      648     do while valid-handle(hh):
      649       if hh:name = v-next-widget-name then do:
      650         if hh:sensitive  = yes
      651         AND hh:visible = yes then do:
      652           APPLY "ENTRY" to hh.
      653           return no-apply.
      654         end.
      655         else do:
      656         APPLY "BACK-TAB" to hh.
      657         return no-apply.
      658         end.
      659       end.
      660       hh = hh:next-sibling.
      661     end.
      662     end.
      663   END.
      664   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      665   ON RETURN ANYWHERE
      666   DO:
      667   define variable ii as integer no-undo .
      668   define variable fh as widget-handle no-undo .
      669   define variable hh as widget-handle no-undo .
      670   define variable v-next-widget-name as character no-undo .
      671     if v-tab-order <> '' then do:
      672       assign
      673       ii = lookup(self:name, v-tab-order).
      674       if ii = num-entries(v-tab-order) then do:
      675           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      676           return no-apply.
      677       end.
      678       if self:type <> "BUTTON" and
      679         self:type <> "EDITOR"  then do:
      680         run proc-move-forward in this-procedure .
      681         return no-apply.
      682       end.
      683       if self:type = "BUTTON" then do:
      684         APPLY "CHOOSE" to self.
      685       end.
      686       if self:type = "TOGGLE-BOX" then
      687       self:BGCOLOR = ?.
      688       assign
      689       ii = ii + 1
      690       v-next-widget-name = entry(ii, v-tab-order)
      691       no-error .
      692       if error-status:error then do:
      693         assign
      694         ii = 1
      695         v-next-widget-name = entry( ii, v-tab-order)
      696         .
      697       end.
      698       assign
      699       fh = frame Dialog-Frame:first-child
      700       hh = fh:first-child
      701       .
      702       do while valid-handle(hh):
      703         if hh:name = v-next-widget-name then do:
      704           if hh:sensitive  = yes
      705           AND hh:visible = yes then do:
      706             if hh:type = "TOGGLE-BOX":U then do:
      707               assign
      708               hh:BGcolor = 1
      709               .
      710             end.
      711             APPLY "ENTRY" to hh.
      712             return no-apply.
      713           end.
      714           else do:
      715             APPLY "TAB" to hh.
      716             return no-apply.
      717           end.
      718         end.
      719         hh = hh:next-sibling.
      720       end.
      721     end.
      722   END.
      723   procedure proc-move-forward :
      724   define variable ii as integer no-undo .
      725   define variable fh as widget-handle no-undo .
      726   define variable hh as widget-handle no-undo .
      727   define variable v-next-widget-name as character no-undo .
      728   do
      729   on error undo, return error
      730   :
      731     if v-tab-order <> '' then do:
      732       if self:type = "TOGGLE-BOX" then
      733       self:BGCOLOR = ?.
      734       assign
      735       ii = lookup(self:name, v-tab-order).
      736       assign
      737       ii = ii + 1
      738       v-next-widget-name = entry(ii, v-tab-order)
      739       no-error .
      740       if error-status:error then do:
      741         assign
      742         ii = 1
      743         v-next-widget-name = entry( ii, v-tab-order)
      744         .
      745       end.
      746       assign
      747       fh = frame Dialog-Frame:first-child
      748       hh = fh:first-child
      749       .
      750       do while valid-handle(hh):
      751         if hh:name = v-next-widget-name then do:
      752           if hh:sensitive  = yes
      753           AND hh:visible = yes then do:
      754             if hh:type = "TOGGLE-BOX":U then do:
      755               assign
      756               hh:BGcolor = 1
      757               .
      758             end.
      759             APPLY "ENTRY" to hh.
      760             return.
      761           end.
      762           else do:
      763             assign
      764             ii = ii + 1
      765             v-next-widget-name = entry(ii, v-tab-order)
      766             no-error .
      767             if error-status:error then do:
      768               assign
      769               ii = 1
      770               v-next-widget-name = entry( ii, v-tab-order)
      771               .
      772             end.
      773           end.
      774         end.
      775         hh = hh:next-sibling.
      776       end.
      777     end.
      778   end.
      779   end procedure.
      780   MAIN-BLOCK:
      781   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      782      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      783    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      784    and p-mode <> 'ИЗМЕНЕНИЕ':U
      785    and p-mode <> 'ПРОСМОТР':U
      786    then do:
      787       message
      788       vss-workfile vss-revision vss-description skip
      789       "Неверное значение параметров вызова p-mode"  p-mode
      790       view-as alert-box ERROR.
      791       undo, return error.
      792    end.
      793     find first X_curr_clients no-lock where
      794               X_curr_clients.obj-type = p-curr-obj-type
      795          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
      796     if not available X_curr_clients then do:
      797       message
      798       vss-workfile vss-revision vss-description skip
      799       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
      800       p-curr-obj-type p-curr-obj-code
      801       view-as alert-box ERROR.
      802       return error .
      803     end.
      804   find first X_sysconf no-lock where
      805               X_sysconf.host-code = p-curr-host-code no-error.
      806     if not available X_sysconf OR X_sysconf.host-code <> X_curr_clients.host-code then do:
      807       message
      808       vss-workfile vss-revision vss-description skip
      809       "Неверное значение параметра вызова p-curr-host-code"
      810       p-curr-host-code
      811       view-as alert-box ERROR.
      812       return error .
      813     end.
      814   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      815   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      816     (output v-db-num
      817     )  .
      818   IF v-db-num <> 0
      819   AND (p-mode = 'ДОБАВЛЕНИЕ':U
      820        OR p-mode = 'ИЗМЕНЕНИЕ':U ) THEN DO:
      821       message
      822       vss-workfile vss-revision vss-description skip
      823       "Неверное значение параметра вызова p-mode" p-mode skip
      824       "Нельзя редактировать запись МАСКИ ДИСКОНТНОЙ КАРТЫ в УБД"
      825       view-as alert-box ERROR.
      826       return error .
      827   END.
      828   for each tt-dis-card-mask:
      829     delete tt-dis-card-mask.
      830   end.
      831     if p-mode = 'ИЗМЕНЕНИЕ':U
      832     or p-mode = 'ПРОСМОТР':U then do:
      833       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      834             find first locked_dis-card-mask EXclusive-lock where
      835                          recid(locked_dis-card-mask) = p-doc-rec no-wait no-error.
      836             if locked locked_dis-card-mask then do:
      837               message
      838               vss-workfile vss-revision vss-description skip
      839                "Запись МАСКИ ДИСКОНТНОЙ КАРТЫ занята"
      840               view-as alert-box error .
      841               undo, return error.
      842             end.
      843       end.
      844       else do:
      845         find first locked_dis-card-mask no-lock where
      846                          recid(locked_dis-card-mask) = p-doc-rec no-error .
      847         if not avail locked_dis-card-mask then do:
      848           find first locked_dis-card-mask no-lock where
      849                      locked_dis-card-mask.mask-num = p-mask-num no-error .
      850         end.
      851       end.
      852       if not available locked_dis-card-mask then do:
      853         message
      854         vss-workfile vss-revision vss-description skip
      855         "Не найдена запись МАСКИ ДИСКОНТНОЙ КАРТЫ"
      856         view-as alert-box error .
      857         undo, return error.
      858       end.
      859       create tt-dis-card-mask.
      860       buffer-copy locked_dis-card-mask to tt-dis-card-mask.
      861       .
      862       cb-cc-run = IF tt-dis-card-mask.cc-run > 0
      863                    THEN STRING(tt-dis-card-mask.cc-run)
      864                   ELSE '':U.
      865      end.
      866      else do:
      867          FIND last locked_dis-card-mask EXCLUSIVE-LOCK USE-INDEX pi NO-ERROR.
      868          IF AVAILABLE locked_dis-card-mask THEN DO:
      869              ASSIGN
      870              v-last-code = locked_dis-card-mask.mask-num
      871              .
      872          END.
      873             create tt-dis-card-mask.
      874             assign
      875            tt-dis-card-mask.mask-num = v-last-code + 1
      876            .
      877      end.
      878      IF p-mode <> 'ПРОСМОТР':U THEN DO:
      879          IF tt-dis-card-mask.obj-code <> 0 AND
      880              NOT (p-curr-obj-code = tt-dis-card-mask.obj-code
      881                  AND
      882                  p-curr-obj-type = tt-dis-card-mask.obj-type) THEN DO:
      883           MESSAGE
      884           "Редактирование маски, привязанной к объекту, разрешено только на этом объекте"
      885           VIEW-AS ALERT-BOX.
      886           UNDO, RETURN.
      887          END.
      888          IF  tt-dis-card-mask.host-code <> 0
      889          AND NOT p-curr-host-code = tt-dis-card-mask.host-code
      890                  THEN DO:
      891           MESSAGE
      892           "Редактирование маски, приязанной к фирме, разрешено только объекте данной фирмы"
      893           VIEW-AS ALERT-BOX.
      894           UNDO, RETURN.
      895          END.
      896     END.
      897   IF p-mode <> 'ДОБАВЛЕНИЕ':U
      898   or (p-mode = 'ДОБАВЛЕНИЕ':U and p-type <> "":U)
      899   THEN do:
      900      IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      901          FIND FIRST locked_dis-card-type  EXCLUSIVE-LOCK WHERE
      902                     locked_dis-card-type.emitent-host-code = locked_dis-card-mask.emitent-host-code
      903               AND   LOCKED_dis-card-type.TYPE = LOCKED_dis-card-mask.TYPE NO-WAIT NO-ERROR.
      904      END.
      905      IF p-mode = 'ПРОСМОТР':U THEN DO:
      906          FIND FIRST locked_dis-card-type  no-lock WHERE
      907                     locked_dis-card-type.emitent-host-code = locked_dis-card-mask.emitent-host-code
      908               AND   LOCKED_dis-card-type.TYPE = LOCKED_dis-card-mask.TYPE NO-ERROR.
      909      END.
      910      if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      911         cb-cc-run = (IF locked_dis-card-mask.cc-run > 0
      912                      THEN string(locked_dis-card-mask.cc-run)
      913                      ELSE '':U).
      914      end.
      915      IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      916               FIND FIRST locked_dis-card-type  no-lock WHERE
      917                     locked_dis-card-type.emitent-host-code = p-emitent-host-code
      918               AND   LOCKED_dis-card-type.TYPE = p-type no-error .
      919      END.
      920      if not available locked_dis-card-type then do:
      921       message
      922       "Не определен тип ДК" p-emitent-host-code p-type
      923       view-as alert-box error .
      924       UNDO, RETURN error .
      925      end.
      926      assign
      927      tt-dis-card-mask.emitent-host-code = locked_dis-card-type.emitent-host-code
      928      tt-dis-card-mask.type              = locked_dis-card-type.type
      929      .
      930   END.
      931     ASSIGN
      932     tt-dis-card-mask.mask = entry(1, tt-dis-card-mask.mask)
      933     tt-dis-card-mask.cli-mask = entry(1, tt-dis-card-mask.cli-mask)
      934     .
      935     find first buf_dis-card-mask-attr no-lock where buf_dis-card-mask-attr.mask-num = tt-dis-card-mask.mask-num and buf_dis-card-mask-attr.attr-code = "reg-cash" no-error .
      936     if available (buf_dis-card-mask-attr) then do:
      937       if buf_dis-card-mask-attr.attr-value = "yes" then reg-cash:checked = yes .
      938       else reg-cash:checked = no .
      939     end.
      940     else reg-cash:checked = no .
      941     RUN Myenable in this-procedure .
      942     WAIT-FOR GO OF FRAME Dialog-Frame.
      943   END.
      944   RUN disable_UI.
      945   PROCEDURE check-cli :
      946   define buffer buf_clients for ub.clients.
      947   find first buf_clients no-lock where
      948                 buf_clients.obj-code = input frame Dialog-Frame tt-dis-card-mask.cli-code
      949            and buf_clients.obj-type = input frame Dialog-Frame tt-dis-card-mask.cli-type no-error.
      950   if not available buf_clients then do:
      951     if input frame Dialog-Frame tt-dis-card-mask.cli-code <> ?  then
      952       message "Неправильный код или тип контрагента" VIEW-AS ALERT-BOX ERROR.
      953     apply "entry" to tt-dis-card-mask.cli-code in frame Dialog-Frame.
      954     return error.
      955   end.
      956   find first X_clients no-lock where recid(X_clients) = recid(buf_clients).
      957   assign
      958   tt-dis-card-mask.cli-type = buf_clients.obj-type
      959   tt-dis-card-mask.cli-code = buf_clients.obj-code
      960   f-cli-name = buf_clients.obj-name
      961   .
      962   display
      963   tt-dis-card-mask.cli-type
      964   tt-dis-card-mask.cli-code
      965   f-cli-name
      966   with frame Dialog-Frame.
      967   END PROCEDURE.
      968   PROCEDURE disable_UI :
      969     HIDE FRAME Dialog-Frame.
      970   END PROCEDURE.
      971   PROCEDURE enable_UI :
      972     OPEN QUERY Dialog-Frame FOR EACH tt-dis-card-mask SHARE-LOCK.
      973     GET FIRST Dialog-Frame.
      974     DISPLAY reg-cash RS-region RS-cli-mask CB-CC-run f-emitent-name l-rs-cli-mask
      975             f-cli-name
      976         WITH FRAME Dialog-Frame.
      977     IF AVAILABLE tt-dis-card-mask THEN
      978       DISPLAY tt-dis-card-mask.type tt-dis-card-mask.mask-num
      979             tt-dis-card-mask.use-on tt-dis-card-mask.emitent-host-code
      980             tt-dis-card-mask.mask tt-dis-card-mask.rank tt-dis-card-mask.cli-type
      981             tt-dis-card-mask.cli-code tt-dis-card-mask.cli-mask
      982         WITH FRAME Dialog-Frame.
      983     ENABLE B-exit b-quit B-hist B-Help B-card-type tt-dis-card-mask.use-on
      984            reg-cash RS-region B-mask tt-dis-card-mask.rank B-rank RS-cli-mask
      985            B-cli-mask CB-CC-run f-emitent-name l-rs-cli-mask f-cli-name
      986         WITH FRAME Dialog-Frame.
      987     VIEW FRAME Dialog-Frame.
      988   END PROCEDURE.
      989   PROCEDURE MyEnable :
      990   IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN do:
      991      IF tt-dis-card-mask.cli-code <> 0 THEN DO:
      992          FIND FIRST X_clients  NO-LOCK WHERE
      993                     X_clients.obj-type = tt-dis-card-mask.cli-type
      994              AND    X_clients.obj-code = tt-dis-card-mask.cli-code.
      995      END.
      996      IF tt-dis-card-mask.emitent-host-code <> 0 THEN DO:
      997         FIND FIRST X_clients_dctype  NO-LOCK WHERE
      998                         X_clients_dctype.obj-type = 'орг':U
      999                  AND    X_clients_dctype.obj-code = tt-dis-card-mask.emitent-host-code.
     1000      END.
     1001   END.
     1002   if p-mode = 'ДОБАВЛЕНИЕ':U then  do:
     1003     RS-cli-mask = "cli-code":U .
     1004   end.
     1005   if tt-dis-card-mask.cli-code > 0 then do:
     1006     if tt-dis-card-mask.cli-mask = '':U then do:
     1007       RS-cli-mask = "cli-code":U .
     1008     end.
     1009     else do:
     1010       RS-cli-mask = "cli-mask-cli-code":U.
     1011     end.
     1012   end.
     1013   else do:
     1014     RS-cli-mask = "cli-mask":U.
     1015   end.
     1016   ASSIGN
     1017   v-tab-order = "b-exit,b-quit,b-hist,b-help," +
     1018                 "b-card-type,mask-num,t-use-on-cd,RS-region,b-mask,rank,b-rank,Rs-cli-mask,cli-type,cli-code,b-cli,b-cli-mask,cb-cc-run"
     1019   tt-dis-card-mask.cli-type:RADIO-BUTTONS IN FRAME Dialog-Frame = "Орг" + chr(44) + 'орг':U + chr(44) +
     1020                                                                      "Чел" + chr(44) + 'чел':U
     1021   Rs-region:RADIO-BUTTONS IN FRAME Dialog-Frame =
     1022   "Глобально" + chr(44) + "0":U + chr(44) +
     1023   ("Фирма" + chr(32) +
     1024    (IF p-mode = 'ДОБАВЛЕНИЕ':U OR tt-dis-card-mask.host-code = 0
     1025     THEN STRING(p-curr-host-code)
     1026     ELSE STRING(tt-dis-card-mask.host-code))) + chr(44) + "1":U + chr(44) +
     1027   ("Объект" + chr(32) +
     1028     (IF p-mode = 'ДОБАВЛЕНИЕ':U OR tt-dis-card-mask.obj-code = 0
     1029      THEN (p-curr-obj-type + STRING(p-curr-obj-code))
     1030      ELSE (tt-dis-card-mask.obj-type + STRING(tt-dis-card-mask.obj-code))) + chr(44) + "2":U)
     1031   Rs-region = IF tt-dis-card-mask.host-code = 0
     1032               THEN 0
     1033               ELSE ( IF tt-dis-card-mask.obj-code = 0
     1034                      THEN 1
     1035                      ELSE 2
     1036                     )
     1037   f-emitent-name = IF p-mode = 'ДОБАВЛЕНИЕ':U
     1038                    THEN "":U
     1039                   ELSE (IF tt-dis-card-mask.emitent-host-code = 0
     1040                         THEN "Глобально"
     1041                         ELSE X_clients_dctype.obj-name
     1042                       )
     1043   cb-cc-run:LIST-ITEM-PAIRS  in frame Dialog-Frame =  "Не используется" + chr(44) + '0':U + chr(44) +
     1044                                                        "По методу Luhna" + chr(44) + '1':U
     1045   .
     1046   DISPLAY
     1047   RS-region
     1048   RS-cli-mask
     1049   f-emitent-name
     1050   f-cli-name
     1051   cb-cc-run
     1052   l-rs-cli-mask
     1053   WITH FRAME Dialog-Frame.
     1054   IF p-mode <> 'ПРОСМОТР':U THEN
     1055   ASSIGN
     1056   tt-dis-card-mask.mask:BGCOLOR = WHITE_COLOR
     1057   tt-dis-card-mask.cli-mask:BGCOLOR = WHITE_COLOR.
     1058   .
     1059   IF AVAILABLE tt-dis-card-mask THEN
     1060   DISPLAY
     1061   tt-dis-card-mask.type
     1062   tt-dis-card-mask.emitent-host-code
     1063   tt-dis-card-mask.mask-num
     1064   tt-dis-card-mask.rank
     1065   tt-dis-card-mask.mask
     1066   tt-dis-card-mask.cli-type
     1067   tt-dis-card-mask.cli-code
     1068   tt-dis-card-mask.cli-mask
     1069   tt-dis-card-mask.use-on
     1070   WITH FRAME Dialog-Frame.
     1071   ENABLE
     1072   B-exit
     1073   b-quit
     1074   B-hist WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     1075   B-Help
     1076   B-card-type WHEN (p-mode <> 'ПРОСМОТР':U and not (p-mode = 'ДОБАВЛЕНИЕ':U and p-type <> "":U))
     1077   cb-cc-run WHEN p-mode <> 'ПРОСМОТР':U
     1078   b-rank WHEN p-mode <> 'ПРОСМОТР':U
     1079   b-mask WHEN p-mode <> 'ПРОСМОТР':U
     1080   RS-region WHEN p-mode <> 'ПРОСМОТР':U
     1081   tt-dis-card-mask.rank WHEN p-mode <> 'ПРОСМОТР':U
     1082   tt-dis-card-mask.use-on WHEN p-mode <> 'ПРОСМОТР':U
     1083   RS-cli-mask WHEN p-mode <> 'ПРОСМОТР':U
     1084   reg-cash when p-mode <> 'ПРОСМОТР':U
     1085   WITH FRAME Dialog-Frame.
     1086   VIEW FRAME Dialog-Frame.
     1087   if p-mode = 'ПРОСМОТР':U then do:
     1088     assign
     1089     b-quit:label = "&Выход"
     1090     b-quit:column = 1
     1091     .
     1092     hide
     1093     b-exit in frame Dialog-Frame.
     1094   end.
     1095   RUN proc-cli-or-mask IN THIS-PROCEDURE(rs-cli-mask) NO-ERROR.
     1096   IF ERROR-STATUS:ERROR  THEN UNDO, RETURN ERROR.
     1097   END PROCEDURE.
     1098   PROCEDURE proc-b-card-type :
     1099   define variable var-rid-str as character no-undo.
     1100   define buffer b_clients for ub.clients.
     1101   var-rid-str = string(recid(locked_dis-card-type)).
     1102   run ref/dc-types.w (
     1103                  input parparentproc
     1104                 ,input "":U
     1105                 ,input "b-sel":U
     1106                 ,input 0
     1107                 ,input p-curr-host-code
     1108                 ,input p-curr-obj-type
     1109                 ,input p-curr-obj-code
     1110                 ,input-output  var-rid-str) .
     1111   if var-rid-str = "" then return no-apply.
     1112   find first locked_dis-card-type no-lock where
     1113              recid(locked_dis-card-type) = integer(var-rid-str) No-ERROR.
     1114   if not avail locked_dis-card-type then return no-apply.
     1115   if locked_dis-card-type.emitent-host-code = 0 then do:
     1116     ASSIGN
     1117     f-emitent-name = "Глобальная"
     1118     tt-dis-card-mask.emitent-host-code = LOCKED_dis-card-type.emitent-host-code
     1119     tt-dis-card-mask.TYPE              = LOCKED_dis-card-type.TYPE
     1120     .
     1121     RELEASE X_clients_dctype.
     1122   end.
     1123   else do:
     1124      find first b_clients No-LOCK WHERE
     1125                 b_clients.obj-type = 'орг':U and
     1126                 b_clients.obj-code = locked_dis-card-type.emitent-host-code No-ERROR.
     1127      if not avail b_clients then return no-apply.
     1128      ASSIGN
     1129      f-emitent-name = b_clients.obj-name
     1130      tt-dis-card-mask.emitent-host-code = LOCKED_dis-card-type.emitent-host-code
     1131      tt-dis-card-mask.TYPE              = LOCKED_dis-card-type.TYPE
     1132      .
     1133      FIND FIRST X_clients_dctype NO-LOCK WHERE
     1134                recid(X_clients_dctype) = recid(b_clients).
     1135   END.
     1136      display
     1137      tt-dis-card-mask.type
     1138      tt-dis-card-mask.emitent-host-code
     1139      f-emitent-name
     1140      with frame Dialog-Frame
     1141      .
     1142   END PROCEDURE.
     1143   PROCEDURE proc-cli-or-mask :
     1144   DEFINE INPUT PARAMETER p-cli-or-mask AS character NO-UNDO.
     1145   CASE p-cli-or-mask:
     1146       WHEN "cli-code":U THEN DO:
     1147           ASSIGN
     1148           tt-dis-card-mask.cli-mask = "":U.
     1149           ASSIGN
     1150           cb-cc-run = '':U
     1151           .
     1152           DISPLAY
     1153           tt-dis-card-mask.cli-mask
     1154           cb-cc-run
     1155           WITH FRAME Dialog-Frame.
     1156           DISABLE
     1157           tt-dis-card-mask.cli-mask
     1158           b-cli-mask
     1159           cb-cc-run
     1160           WITH FRAME Dialog-Frame.
     1161           ENABLE
     1162           b-cli      when p-mode <> 'ПРОСМОТР':U
     1163           tt-dis-card-mask.cli-code when p-mode <> 'ПРОСМОТР':U
     1164           tt-dis-card-mask.cli-type when p-mode <> 'ПРОСМОТР':U
     1165           WITH FRAME Dialog-Frame.
     1166       END.
     1167       WHEN "cli-mask":U THEN DO:
     1168           ASSIGN
     1169           tt-dis-card-mask.cli-code = 0
     1170           f-cli-name = "":U
     1171           .
     1172           DISPLAY
     1173           tt-dis-card-mask.cli-code
     1174           f-cli-name
     1175           WITH FRAME Dialog-Frame.
     1176           DISABLE
     1177           tt-dis-card-mask.cli-type
     1178           tt-dis-card-mask.cli-code
     1179           b-cli
     1180           WITH FRAME Dialog-Frame.
     1181           ENABLE
     1182           b-cli-mask when p-mode <> 'ПРОСМОТР':U
     1183           cb-cc-run  when p-mode <> 'ПРОСМОТР':U
     1184           WITH FRAME Dialog-Frame.
     1185       END.
     1186        WHEN "cli-mask-cli-code":U THEN DO:
     1187           DISPLAY
     1188           tt-dis-card-mask.cli-code
     1189           f-cli-name
     1190           WITH FRAME Dialog-Frame.
     1191           ENABLE
     1192           b-cli-mask when p-mode <> 'ПРОСМОТР':U
     1193           cb-cc-run  when p-mode <> 'ПРОСМОТР':U
     1194           b-cli      when p-mode <> 'ПРОСМОТР':U
     1195           tt-dis-card-mask.cli-code when p-mode <> 'ПРОСМОТР':U
     1196           tt-dis-card-mask.cli-type when p-mode <> 'ПРОСМОТР':U
     1197           WITH FRAME Dialog-Frame.
     1198       END.
     1199   END CASE.
     1200   END PROCEDURE.
     1201   PROCEDURE proc-save :
     1202   define variable glog as logical no-undo .
     1203   if p-mode = 'ПРОСМОТР':U then do:
     1204       return error.
     1205   end.
     1206   assign
     1207   frame Dialog-Frame
     1208   reg-cash
     1209   rs-CLI-MASK
     1210   rs-region
     1211   cb-cc-run
     1212   tt-dis-card-mask.use-on
     1213   tt-dis-card-mask.cc-run = INTEGER(cb-cc-run)
     1214   tt-dis-card-mask.host-code = (IF rs-region = 0 THEN 0 ELSE p-curr-host-code)
     1215   tt-dis-card-mask.obj-type  = (IF rs-region < 2 THEN "":U ELSE p-curr-obj-type)
     1216   tt-dis-card-mask.obj-code  = (IF rs-region < 2 THEN 0 ELSE p-curr-obj-code)
     1217   tt-dis-card-mask.cli-code
     1218   tt-dis-card-mask.cli-code = (IF RS-CLI-MASK = "CLI-CODE":u or RS-CLI-MASK = "cli-mask-cli-code"
     1219                                THEN tt-dis-card-mask.cli-code
     1220                                else 0)
     1221   tt-dis-card-mask.cli-type
     1222   tt-dis-card-mask.cli-type = (IF RS-CLI-MASK = "CLI-CODE":u or RS-CLI-MASK = "cli-mask-cli-code"
     1223                                THEN tt-dis-card-mask.cli-type
     1224                                else "":U)
     1225   tt-dis-card-mask.cli-mask
     1226   tt-dis-card-mask.cli-mask  = (IF RS-CLI-MASK = "CLI-MASK":u or RS-CLI-MASK = "cli-mask-cli-code"
     1227                                 THEN tt-dis-card-mask.cli-mask
     1228                                 ELSE "":U)
     1229   tt-dis-card-mask.emitent-host-code
     1230   tt-dis-card-mask.mask
     1231   tt-dis-card-mask.mask-num
     1232   tt-dis-card-mask.rank
     1233   tt-dis-card-mask.type
     1234   .
     1235   if index(tt-dis-card-mask.cli-mask, chr(63)) > 0 then do:
     1236     message
     1237     substitute("Если Вы планируете использовать ДАННУЮ маску для передачи на кассы ДЛИННЫХ номеров карт&1" +
     1238                "или определения КОРОТКИХ номеров карт (номеров, хранящихся в TH) по ДЛИННЫМ номерам при приеме чеков с касс&1" +
     1239                "то карта не должна содержать знаки &2&1" +
     1240                "Все равно сохранить маску?"
     1241                , chr(10)
     1242                , chr(63))
     1243     view-as alert-box WARNING buttons  YES-NO update glog.
     1244     if not glog then undo, return error .
     1245   end.
     1246    run ref/dc-mask1.p (
     1247   input-output p-doc-rec
     1248   ,input parparentproc
     1249   ,input p-mode
     1250   ,INPUT tt-dis-card-mask.use-on
     1251   ,input tt-dis-card-mask.cli-code
     1252   ,input tt-dis-card-mask.cli-mask
     1253   ,input tt-dis-card-mask.cli-type
     1254   ,input tt-dis-card-mask.emitent-host-code
     1255   ,input tt-dis-card-mask.host-code
     1256   ,input tt-dis-card-mask.mask-num
     1257   ,input tt-dis-card-mask.mask
     1258   ,input tt-dis-card-mask.obj-code
     1259   ,input tt-dis-card-mask.obj-type
     1260   ,input tt-dis-card-mask.rank
     1261   ,input tt-dis-card-mask.type
     1262   ,input tt-dis-card-mask.cc-run
     1263   ,input reg-cash
     1264   )
     1265   no-error.
     1266   if error-status:error then do:
     1267   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1268   define variable fh as widget-handle no-undo .
     1269   define variable hh as widget-handle no-undo .
     1270   define variable rv as character no-undo .
     1271   assign
     1272   rv = entry(1, return-value , chr(4)).
     1273   if rv <> "":U then do:
     1274     assign
     1275     fh = frame Dialog-Frame:first-child
     1276     hh = fh:first-child
     1277     .
     1278     do while valid-handle(hh):
     1279       if hh:name = rv then do:
     1280         APPLY "ENTRY" to hh.
     1281         undo ,
     1282         return error.
     1283       end.
     1284       hh = hh:next-sibling.
     1285     end.
     1286   end.
     1287     undo, return error.
     1288   end.
     1289   END PROCEDURE.
