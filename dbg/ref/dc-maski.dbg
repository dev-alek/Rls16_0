      456     if   input frame Dialog-Frame tt-dis-card-mask.cli-code <> 0 then do:
      457       run check-cli in this-procedure no-error.
      458       if error-status:error then do:
      459          return no-apply.
      460       end.
      461     end.
      462   END.
      463   ON VALUE-CHANGED OF reg-cash IN FRAME Dialog-Frame
      464   DO:
      465     assign
      466     reg-cash
      467     .
      468   END.
      469   ON VALUE-CHANGED OF RS-cli-mask IN FRAME Dialog-Frame
      470   DO:
