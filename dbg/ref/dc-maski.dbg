      241                       "Использовать на кассе и в TH", 0,
      242   "Использовать ТОЛЬКО на кассе", 1,
      243   "Использовать ТОЛЬКО в TH", 2
      244             SIZE 31.5 BY 2.25
      245        reg-cash AT ROW 4 COL 3 WIDGET-ID 2
