        1   define output parameter p-comment as character no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Закрытие документа".
        8   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
        9        LABEL "Нет"
       10        SIZE 15 BY 1.13
       11        BGCOLOR 8 .
       12   DEFINE BUTTON Btn_OK AUTO-GO
       13        LABEL "Да"
       14        SIZE 15 BY 1.13
       15        BGCOLOR 8 .
       16   DEFINE VARIABLE COMBO-BOX-1 AS CHARACTER FORMAT "X(256)":U
       17        LABEL "Причина"
       18        VIEW-AS COMBO-BOX INNER-LINES 5
       19        LIST-ITEMS "Товар отсутствует","Марка не читается","Марка отсутствует в документе","Ошибки, выявленные на уровне офиса"
       20        DROP-DOWN-LIST
       21        SIZE 43 BY 1 NO-UNDO.
       22   DEFINE RECTANGLE RECT-1
       23        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
       24        SIZE 60 BY 7.75.
       25   DEFINE FRAME Dialog-Frame
       26        Btn_OK AT ROW 2.25 COL 7.5
       27        Btn_Cancel AT ROW 2.25 COL 45.5
       28        COMBO-BOX-1 AT ROW 7.25 COL 16 COLON-ALIGNED WIDGET-ID 12
       29        "Вы уверены, что хотите завершить проверку документа" VIEW-AS TEXT
       30             SIZE 53 BY 1.25 AT ROW 3.58 COL 7.38 WIDGET-ID 6
       31        "с недопоставкой?" VIEW-AS TEXT
       32             SIZE 53 BY 1.25 AT ROW 5.04 COL 7.38 WIDGET-ID 10
       33        RECT-1 AT ROW 2 COL 3 WIDGET-ID 2
       34        SPACE(2.12) SKIP(0.99)
       35       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       36            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       37            TITLE "Причина закрытия"
       38            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
       39   ASSIGN
       40          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       41          FRAME Dialog-Frame:HIDDEN           = TRUE.
       42   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       43   DO:
       44     APPLY "END-ERROR":U TO SELF.
       45   END.
       46   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
       47   DO:
       48     p-comment = "" .
       49   END.
       50   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
       51   DO:
       52     if COMBO-BOX-1:screen-value = ? then do:
       53       message "Укажите причину"
       54       view-as alert-box.
       55       return no-apply .
       56     end.
       57     p-comment = "Причина: " + combo-box-1:screen-value .
       58   END.
       59   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       60   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       61   MAIN-BLOCK:
       62   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       63      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       64     RUN enable_UI.
       65     WAIT-FOR GO OF FRAME Dialog-Frame.
       66   END.
       67   RUN disable_UI.
       68   PROCEDURE disable_UI :
       69     HIDE FRAME Dialog-Frame.
       70   END PROCEDURE.
       71   PROCEDURE enable_UI :
       72     DISPLAY COMBO-BOX-1
       73         WITH FRAME Dialog-Frame.
       74     ENABLE RECT-1 Btn_OK Btn_Cancel COMBO-BOX-1
       75         WITH FRAME Dialog-Frame.
       76     VIEW FRAME Dialog-Frame.
       77   END PROCEDURE.
