        1   DEFINE BUFFER locked_c-fin-statement FOR ub.c-fin-statement.
        2   DEFINE BUFFER locked_c-fin-statement-line FOR ub.c-fin-statement-line.
        3   DEFINE TEMP-TABLE tt-c-fin-statement NO-UNDO LIKE ub.c-fin-statement.
        4   DEFINE TEMP-TABLE tt-fin-doc NO-UNDO LIKE ub.fin-doc.
        5   DEFINE TEMP-TABLE tt0-c-fin-statement-attr NO-UNDO LIKE ub.c-fin-statement-attr.
        6   DEFINE BUFFER X_clients FOR ub.clients.
        7   DEFINE BUFFER X_curr_sysconf FOR ub.sysconf.
        8   DEFINE BUFFER X_fin-bank FOR ub.fin-bank.
        9   DEFINE BUFFER X_fin-schet FOR ub.fin-schet.
       10   DEFINE BUFFER X_sysconf FOR ub.sysconf.
       11   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
       12   DEFINE INPUT PARAMETER p-curr-host-code LIKE ub.c-fin-statement.host-code NO-UNDO.
       13   DEFINE INPUT PARAMETER p-mode           AS character NO-UNDO.
       14   DEFINE INPUT PARAMETER p-host-code LIKE ub.c-fin-statement.host-code NO-UNDO.
       15   DEFINE INPUT PARAMETER p-sttm-code LIKE ub.c-fin-statement.sttm-code NO-UNDO.
       16   DEFINE INPUT PARAMETER p-fins-ext-doc-type LIKE ub.c-fin-statement.fins-ext-doc-type NO-UNDO.
       17   define input-output parameter p-doc-rec as recid no-undo.
       18   define input-output parameter p-line-rec as recid no-undo.
       19   define variable vss-revision    as character no-undo init "$Revision$":U .
       20   define variable vss-author      as character no-undo init "$Author$":U .
       21   define variable vss-date        as character no-undo init "$Date$":U .
       22   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       23   define variable vss-archive     as character no-undo init "$Archive$":U .
       24   define variable vss-description as character no-undo init "Просмотр истории банковский выписки".
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define variable v-waitfram-action01         as character   no-undo .
       81   define variable v-waitfram-action02         as character   no-undo .
       82   define variable v-waitfram-action03         as character   no-undo .
       83   define variable mWaitFramTextBeg            as character   no-undo.
       84   define variable mWaitFramTextEnd            as character   no-undo.
       85   define variable mWaitFramView               as logical     no-undo.
       86   define variable mWaitProcEvent              as logical     no-undo init yes.
       87   define variable mWaitFramInterval           as integer     no-undo init 1 .
       88   define variable mWaitFramStop               as logical     no-undo.
       89   define variable mWaitFramStopUser           as logical     no-undo.
       90   define variable mWaitFramStopTimeOut        as logical     no-undo.
       91   define variable mWaitFramStartProc          as datetime-tz no-undo.
       92   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       93   define button B-WaitFramStop auto-end-key
       94        label "Стоп"
       95        size 10 by 1 tooltip "Остоновить процесс".
       96   define button B-viewProcInfo
       97        label "Информация"
       98        size 15 by 1 tooltip "Информация о процесс".
       99   define frame waitfram
      100     v-waitfram-action01 format "x(72)" no-label skip
      101     v-waitfram-action02 format "x(72)" no-label skip
      102     v-waitfram-action03 format "x(72)" no-label skip
      103     B-viewProcInfo
      104     B-WaitFramStop at row 4 col 30
      105     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      106     .
      107   define new global shared variable mBatchMode as logical no-undo init ?.
      108   define variable mFramBachModHandle as handle no-undo.
      109   mFramBachModHandle = frame waitfram:handle.
      110   define variable mFameOldVis as logical no-undo.
      111   define variable mVisCUrentVin as logical no-undo.
      112   if session:batch-mode
      113   then
      114      mBatchMode = yes.
      115   if mBatchMode = ? then do:
      116     mVisCUrentVin = current-window:visible.
      117     mFameOldVis = mFramBachModHandle:visible.
      118     mFramBachModHandle:visible  = yes.
      119     mBatchMode = mFramBachModHandle:visible ne yes.
      120     mFramBachModHandle:visible = mFameOldVis.
      121     current-window:visible = mVisCUrentVin.
      122   end.
      123    if  log-manager:logfile-name ne ?
      124     then DO:
      125         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      126         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      127         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      128     end.
      129   on choose of B-WaitFramStop in frame waitfram
      130   do:
      131     mWaitFramStop = yes.
      132     mWaitFramStopUser = yes.
      133   end.
      134   function waitfram-check-timeout returns logical():
      135      define variable vtime as int64 no-undo.
      136      if mWaitFramStopTimeOut
      137      then
      138         return yes.
      139      vtime = ( now - mWaitFramStartProc ) / 1000 .
      140      if     mWaitFramTimeOut ne ?
      141         and mWaitFramTimeOut ne 0
      142         and mWaitFramTimeOut lt vtime
      143      then do:
      144         mWaitFramStopTimeOut = yes.
      145      end.
      146      return mWaitFramStopTimeOut.
      147   end.
      148   procedure waitfram-hide :
      149     if not session:batch-mode
      150     then do
      151     on error undo, return error return-value
      152     :
      153       pause 0 before-hide .
      154       if not mBatchMode then
      155         hide frame waitfram .
      156     if     not mWaitFramView
      157        and mWaitProcEvent
      158     then
      159       process events .
      160     end.
      161   end procedure.
      162   procedure waitfram-show :
      163     define input  parameter p-message as character no-undo .
      164     define variable v-left-margin as integer   no-undo .
      165     if not session:batch-mode
      166     then do
      167     on error undo, return error return-value
      168     :
      169       if length(p-message) <= 70 then do:
      170         assign
      171           v-left-margin = integer((70 - length(p-message)) / 2)
      172         .
      173         assign
      174           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      175         .
      176         assign
      177           v-waitfram-action01 = " "
      178           v-waitfram-action02 = " "
      179                                    + fill(" ", v-left-margin)
      180                                    + p-message
      181           v-waitfram-action03 = " "
      182         .
      183       end.
      184       else do:
      185         define variable vRindex1 as integer no-undo.
      186         define variable vRindex2 as integer no-undo.
      187         vRindex1 = r-index(p-message," ",70).
      188         if vRindex1 = 0
      189         then
      190            vRindex1 = 70.
      191         if length(p-message)  <= vRindex1 + 70 then do:
      192           assign
      193             v-waitfram-action01 = " "
      194             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      196           .
      197         end.
      198         else do:
      199           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      200           if vRindex2 <= vRindex1
      201           then
      202              vRindex2 = vRindex1 + 70.
      203           assign
      204             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      205             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      206             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      207           .
      208         end.
      209       end.
      210       B-viewProcInfo:visible   in frame waitfram = no.
      211       B-viewProcInfo:sensitive in frame waitfram = no.
      212       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      213       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      214       if  (   mWaitFramView
      215          or  mWaitProcEvent)
      216          and not mBatchMode
      217       then
      218          display
      219             v-waitfram-action01 skip
      220             v-waitfram-action02 skip
      221             v-waitfram-action03 skip
      222          with frame waitfram .
      223       if     mWaitFramView
      224          then do:
      225             if     mWaitFramInterval ne ?
      226                and not mBatchMode
      227             then
      228                wait-for go of frame waitfram pause mWaitFramInterval.
      229          end.
      230          else
      231             if     mWaitProcEvent
      232                and not mBatchMode
      233             then
      234                process events .
      235     end.
      236   end procedure.
      237      procedure waitfram-show-this:
      238         define input  parameter iInterval as int64 no-undo.
      239         define variable vtime as int64 no-undo.
      240         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      241         mWaitFramInterval = iInterval.
      242         run waitfram-show (substitute("&1&2 &3&4" ,
      243                                       mWaitFramTextBeg ,
      244                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      245                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      246                                       mWaitFramTextEnd
      247                                      )
      248                           ).
      249      end.
      250      procedure WaitFramRunPause:
      251         define input  parameter iInterval as dec no-undo.
      252         define variable vStart  as datetime-tz no-undo.
      253         define variable vend    as datetime-tz no-undo.
      254         define variable vint as int64 no-undo.
      255         define variable vOk as logical no-undo.
      256         vStart = now.
      257         vend   = vStart.
      258         publish "WaitFramPause" (iInterval,output vOk).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and (   vint > 0
      264                 or (    not vOk
      265                     and iInterval eq ?
      266                     )
      267                 )
      268         then
      269            run waitfram-show-this (iInterval).
      270         vend   =  now.
      271         vint = vend - vStart.
      272         vint = iInterval - vint / 1000.
      273         if     not mWaitFramStop
      274            and vint > 0
      275         then do:
      276            run gbl/pause.p (vint * 1000).
      277         end.
      278         if iInterval ne ?
      279         then
      280            publish "WaitFramStop".
      281         waitfram-check-timeout().
      282      end.
      283      procedure WaitFramWaitFor:
      284         define input  parameter iInterval as dec no-undo.
      285         assign
      286            mWaitFramStartProc   = now
      287            mWaitFramStopUser    = no
      288            mWaitFramStopTimeOut = no
      289         .
      290         block-wait:
      291         do while not mWaitFramStop:
      292            run WaitFramRunPause (iInterval).
      293            if  waitfram-check-timeout()
      294            then do:
      295               leave block-wait.
      296            end.
      297         end.
      298         run waitfram-hide.
      299      end.
      300   procedure waitfram-join :
      301     define input  parameter p-line-1  as character no-undo .
      302     define input  parameter p-line-2  as character no-undo .
      303     define input  parameter p-line-3  as character no-undo .
      304     define output parameter p-message as character no-undo .
      305     do
      306     on error undo, return error return-value
      307     :
      308       assign
      309         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      312       .
      313     end.
      314   end procedure.
      315   function waitfram-join-function returns character
      316     (input p-line-1 as character
      317     ,input p-line-2 as character
      318     ,input p-line-3 as character
      319     ).
      320     define variable v-message as character no-undo .
      321     run waitfram-join in this-procedure
      322       (input  p-line-1
      323       ,input  p-line-2
      324       ,input  p-line-3
      325       ,output v-message
      326       ) .
      327     return v-message .
      328   end function .
      329   define new global shared variable g#language as character no-undo .
      330   if g#language <> '' and g#language <> 'rus':U then do:
      331     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      332   end.
      333   define new global shared variable g#library  as handle no-undo .
      334   define new global shared variable g#library2 as handle no-undo .
      335   define   shared variable g#auto as logical no-undo.
      336   define   shared variable g#news as logical no-undo.
      337   define   shared variable g#oxml as logical no-undo.
      338   define   shared variable g#esys as logical no-undo.
      339   define   shared variable g#news-source-db as integer no-undo.
      340   define   shared variable g#esys-source-esys as integer no-undo.
      341   define   shared variable g#db-num as integer   no-undo .
      342   define   shared variable g#userid as character no-undo .
      343   define   shared variable g#passwd as character no-undo .
      344   procedure proc-alt-shift-f2:
      345     if not ibs.th.gbl.gbl-var:rcode
      346   then
      347     run gbl\inidebug.p .
      348   end.
      349   procedure proc-alt-shift-f3:
      350     run gbl/prvssinf.p
      351       ( input this-procedure
      352       ) .
      353   end.
      354   define variable v-inform-launched as logical no-undo initial false .
      355   procedure proc-alt-shift-f4:
      356     define variable v-action as character no-undo .
      357     if v-inform-launched = false then do:
      358       assign
      359         v-inform-launched = true
      360       .
      361       run gbl/d-inform.w
      362         (  input self
      363         ,  input this-procedure
      364         , output v-action
      365         ) no-error .
      366       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      367       assign
      368         v-inform-launched = false
      369       .
      370     end.
      371   end.
      372   procedure proc-alt-f1:
      373     run gbl/corrhelp.p
      374       (input this-procedure
      375       ) .
      376   end .
      377   on alt-shift-f2 anywhere do:
      378     run proc-alt-shift-f2.
      379   end.
      380   on alt-shift-f3 anywhere do:
      381     run proc-alt-shift-f3 in this-procedure .
      382   end.
      383   on alt-shift-f4 anywhere do:
      384     run proc-alt-shift-f4 in this-procedure.
      385   end.
      386   on alt-f1 anywhere do:
      387     run proc-alt-f1 in this-procedure .
      388   end.
      389   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   FUNCTION mark-string RETURNS CHARACTER
      391     ( input p-recid as recid, input mark-list as character  ) :
      392     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      393   END FUNCTION.
      394   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   procedure cur-time :
      396      define output parameter p-today as date      no-undo .
      397      define output parameter p-time  as integer   no-undo .
      398     do
      399     on error undo, return error
      400     :
      401       define variable v-date1 as date      no-undo .
      402       define variable v-date2 as date      no-undo .
      403       define variable v-time  as integer   no-undo .
      404       assign
      405         v-date1 = today
      406         v-time  = time
      407         v-date2 = today
      408       .
      409       if v-date1 <> v-date2
      410       then do:
      411         assign
      412           v-date1 = today
      413           v-time  = v-time
      414         .
      415       end.
      416       assign
      417         p-today = v-date1
      418         p-time  = v-time
      419       .
      420     end.
      421   end.
      422   function cur-time-date returns character
      423   :
      424     return string(today, '99/99/9999':U) .
      425   end.
      426   function cur-time-mjd returns decimal
      427   :
      428     define variable v-date as date      no-undo .
      429     define variable v-time as integer   no-undo .
      430     run cur-time in this-procedure
      431       (output v-date
      432       ,output v-time
      433       ) .
      434     return integer(v-date) - 2400002 + (v-time / 86400) .
      435   end.
      436   function cur-time-get-ending-index returns integer
      437   (input p-number as integer
      438   )
      439   :
      440     if p-number < 0
      441     or p-number = ?
      442     then do:
      443       return 1 .
      444     end.
      445     define variable v-rest as integer   no-undo .
      446     assign
      447       p-number = p-number modulo 100
      448     .
      449     if p-number < 20
      450     then do:
      451       assign
      452         v-rest = p-number
      453       .
      454     end.
      455     else do:
      456       assign
      457         v-rest = p-number modulo 10
      458       .
      459     end.
      460     case v-rest :
      461       when 1
      462       then do:
      463         return 2 .
      464       end.
      465       when 2 or
      466       when 3 or
      467       when 4
      468       then do:
      469         return 3 .
      470       end.
      471       otherwise do:
      472         return 1 .
      473       end.
      474     end case .
      475   end.
      476   procedure cur-time-mjd-to-date :
      477      define input  parameter i-mjd-diff as decimal no-undo.
      478      define output parameter o-Date     as date    no-undo.
      479      define output parameter o-Time     as integer no-undo.
      480      define variable v-day-number as integer   no-undo .
      481      if    i-mjd-diff < 0
      482         or i-mjd-diff = ?
      483      then do:
      484         return "?" .
      485      end.
      486      assign
      487         v-day-number = truncate(i-mjd-diff,0).
      488         o-Date = date(v-day-number + 2400002).
      489         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      490     .
      491   end.
      492   function cur-time-mjd-to-string returns character
      493   (input p-mjd-diff as decimal
      494   )
      495   :
      496     define variable v-day-number as integer   no-undo .
      497     define variable v-seconds    as integer   no-undo .
      498     define variable v-hour       as integer   no-undo .
      499     define variable v-min        as integer   no-undo .
      500     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      501     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      502     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      503     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      504     if p-mjd-diff < 0
      505     or p-mjd-diff = ?
      506     then do:
      507       return "?" .
      508     end.
      509     assign
      510       v-day-number = integer(truncate(p-mjd-diff,0))
      511       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      512     .
      513     if v-seconds > 86400
      514     then do:
      515       assign
      516         v-seconds = 86400 - 1
      517       .
      518     end.
      519     if v-seconds < 0
      520     then do:
      521       assign
      522         v-seconds = 0
      523       .
      524     end.
      525     assign
      526       v-hour = truncate(v-seconds / 3600, 0)
      527     .
      528     assign
      529       v-seconds = v-seconds modulo 3600
      530     .
      531     assign
      532       v-min = truncate(v-seconds / 60, 0)
      533     .
      534     assign
      535       v-seconds = v-seconds modulo 60
      536     .
      537     return
      538         (if v-day-number <> 0
      539           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      540           else ""
      541         )
      542       + (if v-day-number <> 0 or v-hour <> 0
      543           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      544           else ""
      545         )
      546       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      547           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      548           else ""
      549         )
      550       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      551       .
      552   end.
      553   function cur-time-string returns character
      554   :
      555     define variable v-date as date      no-undo .
      556     define variable v-time as integer   no-undo .
      557     run cur-time in this-procedure
      558       (output v-date
      559       ,output v-time
      560       ) .
      561     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      562   end.
      563   function cur-time-string-sec returns character
      564   :
      565     define variable v-date as date      no-undo .
      566     define variable v-time as integer   no-undo .
      567     run cur-time in this-procedure
      568       (output v-date
      569       ,output v-time
      570       ) .
      571     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      572   end.
      573   function cur-time-custom  returns character
      574   (input p-prefix as character
      575   ,input p-date-format as character
      576   ,input p-delimiter as character
      577   ,input p-time-format as character
      578   ,input p-suffix as character
      579   )
      580   :
      581     define variable v-date as date      no-undo .
      582     define variable v-time as integer   no-undo .
      583     run cur-time in this-procedure
      584       (output v-date
      585       ,output v-time
      586       ) .
      587     return
      588       p-prefix
      589       + string(v-date, p-date-format)
      590       + p-delimiter
      591       + string(v-time, p-time-format)
      592       + p-suffix
      593       .
      594   end.
      595   function cur-time-print  returns character
      596   :
      597     define variable v-date as date      no-undo .
      598     define variable v-time as integer   no-undo .
      599     run cur-time in this-procedure
      600       (output v-date
      601       ,output v-time
      602       ) .
      603     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      604   end.
      605   function cur-time-datetime returns datetime
      606   :
      607     define variable v-char as character no-undo .
      608     define variable v-datetime as datetime no-undo .
      609     v-char = cur-time-string().
      610     v-datetime = datetime(v-char).
      611     return  v-datetime.
      612   end.
      613   function cur-time-string-msec returns character
      614   :
      615     define variable v-date as datetime  no-undo .
      616     v-date = now.
      617     return string(v-date) .
      618   end.
      619   DEFINE VARIABLE v-cli-name AS CHARACTER NO-UNDO.
