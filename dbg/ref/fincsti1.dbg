     1372   procedure diasize_set-height :
     1373     define input  parameter p-new-height  as decimal   no-undo .
     1374     define input  parameter p-move-resize as logical   no-undo .
     1375     do
     1376     on error undo, return error return-value
     1377     :
     1378       run diasize_change-height in this-procedure
     1379         (input  (p-new-height - frame Dialog-Frame :height)
     1380         ,input  p-move-resize
     1381         ) .
     1382     end.
     1383   end procedure.
     1384   procedure diasize_change-width :
     1385     define input  parameter p-change-value as decimal   no-undo .
     1386     define input  parameter p-move-resize  as logical   no-undo .
     1387     define variable v-field-group-handle   as handle    no-undo .
     1388     define variable v-object-handle        as handle    no-undo .
