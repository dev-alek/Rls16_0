     1676             v-object-handle = buf_temp-diasize-handle.handle-value
     1677           .
     1678           if v-object-handle <> v-diasize-resize-button
     1679           then do:
     1680             assign
     1681               v-object-handle :col = v-object-handle :col + p-change-value
     1682               no-error .
     1683             if error-status :error
     1684             or error-status :get-message(1) <> ""
     1685             then do:
     1686               undo move_block, retry move_block .
     1687             end.
     1688           end.
     1689         end.
     1690         for each buf_temp-browse-handle
     1691           where buf_temp-browse-handle.browse-type = 'width':u
     1692         on error undo move_block, retry move_block
     1693         :
     1694           assign
     1695             buf_temp-browse-handle.browse-handle :width
     1696               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1697             no-error .
     1698           if error-status :error
     1699           or error-status :get-message(1) <> ""
     1700           then do:
     1701             undo move_block, retry move_block .
     1702           end.
     1703         end.
     1704         assign
     1705           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1706           no-error .
     1707         if error-status :error
     1708         or error-status :get-message(1) <> ""
     1709         then do:
     1710           undo move_block, retry move_block.
     1711         end.
     1712         assign
     1713           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1714         no-error .
     1715         if error-status :error
     1716         or error-status :get-message(1) <> ""
     1717         then do:
     1718           undo move_block, retry move_block.
     1719         end.
     1720         if frame Dialog-Frame :scrollable = true
     1721         then do:
     1722           assign
     1723             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1724           no-error .
     1725           if error-status :error
     1726           or error-status :get-message(1) <> ""
     1727           then do:
     1728             undo move_block, retry move_block.
     1729           end.
     1730         end.
     1731       end.
     1732       if p-move-resize
     1733       then do:
     1734         run diasize_position-resize-button in this-procedure .
     1735       end.
     1736       if v-diasize-wndstore = true
     1737       then do:
     1738         if connected("ub") = true
     1739         then do:
     1740           define variable v-cntxt-db-num        as integer   no-undo .
     1741           define variable v-cntxt-userid        as character no-undo .
     1742           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1743                                             , OUTPUT v-cntxt-userid
     1744                                             ) .
     1745           run gbl/wndsizew.p
     1746             (input  v-cntxt-db-num
     1747             ,input  v-cntxt-userid
     1748             ,input  v-diasize-proc-name
     1749             ,input  'width':u
     1750             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1751             ) .
     1752         end.
     1753       end.
     1754     end.
     1755     assign
     1756       v-diasize-change-size = false
     1757     .
     1758   end procedure.
     1759   procedure diasize_set-width :
     1760     define input  parameter p-new-width  as decimal   no-undo .
     1761     define input  parameter p-move-resize as logical   no-undo .
     1762     do
     1763     on error undo, return error return-value
     1764     :
     1765       run diasize_change-width in this-procedure
     1766         (input  (p-new-width - frame Dialog-Frame :width)
     1767         ,input  p-move-resize
     1768         ) .
     1769     end.
     1770   end procedure.
     1771   procedure diasize_position-resize-button :
     1772     do with frame Dialog-Frame
     1773     :
     1774       hide v-diasize-resize-button .
     1775       assign
     1776         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1777                     - 1
     1778                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1779         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1780                     - 1
     1781                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1782       .
     1783       view v-diasize-resize-button .
     1784     end.
     1785   end procedure.
     1786   on alt-right anywhere
     1787   do:
     1788     run diasize_change-width in this-procedure
     1789       (input 1
     1790       ,input true
     1791       ) .
     1792     return no-apply .
     1793   end.
     1794   on alt-left anywhere
     1795   do:
     1796     run diasize_change-width in this-procedure
     1797       (input -1
     1798       ,input true
     1799       ) .
     1800     return no-apply .
     1801   end.
     1802   on alt-down anywhere
     1803   do:
     1804     run diasize_change-height in this-procedure
     1805       (input 1
     1806       ,input true
     1807       ) .
     1808     return no-apply .
     1809   end.
     1810   on alt-up anywhere
     1811   do:
     1812     run diasize_change-height in this-procedure
     1813       (input -1
     1814       ,input true
     1815       ) .
     1816     return no-apply .
     1817   end.
     1818   on alt-enter of frame Dialog-Frame
     1819   do:
     1820     run diasize_maximize in this-procedure
     1821       (input  ?
     1822       ).
     1823     return no-apply .
     1824   end.
     1825   procedure diasize_end-move :
     1826     do
     1827     on error undo, return error return-value
     1828     :
     1829       define variable v-row-delta as decimal   no-undo .
     1830       define variable v-col-delta as decimal   no-undo .
     1831       define variable v-new-row as decimal   no-undo .
     1832       define variable v-new-col as decimal   no-undo .
     1833       assign
     1834         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1835         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1836       .
     1837       assign
     1838         v-row-delta = v-new-row - frame Dialog-Frame :height
     1839         v-col-delta = v-new-col - frame Dialog-Frame :width
     1840       .
     1841       run diasize_change-height in this-procedure
     1842         (input v-row-delta
     1843         ,input true
     1844         ) .
     1845       run diasize_change-width in this-procedure
     1846         (input v-col-delta
     1847         ,input true
     1848         ) .
     1849     end.
     1850   end procedure.
     1851   procedure diasize_maximize :
     1852     define input  parameter p-action as logical   no-undo .
     1853     do
     1854     on error undo, return error return-value
     1855     :
     1856       if p-action = ?
     1857       then do:
     1858         if v-diasize-need-maximize = true
     1859         then do:
     1860           assign
     1861             p-action = true
     1862           .
     1863         end.
     1864         else do:
     1865           assign
     1866             p-action = false
     1867           .
     1868         end.
     1869       end.
     1870       if p-action = true
     1871       then do:
     1872         run diasize_change-height in this-procedure
     1873           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1874               - frame Dialog-Frame :height-chars
     1875           ,input true
     1876           ) .
     1877         run diasize_change-width in this-procedure
     1878           (input session :width-chars
     1879               - frame Dialog-Frame :width-chars
     1880           ,input true
     1881           ) .
     1882         assign
     1883           v-diasize-need-maximize = false
     1884         .
     1885       end.
     1886       else do:
     1887         run diasize_change-width in this-procedure
     1888           (input v-diasize-orig-frame-width
     1889               - frame Dialog-Frame :width-chars
     1890           ,input true
     1891           ) .
     1892         run diasize_change-height in this-procedure
     1893           (input v-diasize-orig-frame-height
     1894               - frame Dialog-Frame :height-chars
     1895           ,input true
     1896           ) .
     1897         assign
     1898           v-diasize-need-maximize = true
     1899         .
     1900       end.
     1901     end.
     1902   end procedure.
     1903   procedure diasize_restore-orig-size :
     1904     do
     1905     on error undo, return error return-value
     1906     :
     1907       assign
     1908         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1909         v-diasize-current-frame-height = frame Dialog-Frame :height
     1910       .
     1911       run diasize_set-height in this-procedure
     1912         (input  v-diasize-orig-frame-height
     1913         ,input  true
     1914         ) .
     1915       run diasize_set-width in this-procedure
     1916         (input  v-diasize-orig-frame-width
     1917         ,input  true
     1918         ) .
     1919     end.
     1920   end procedure.
     1921   procedure diasize_restore-current-size :
     1922     do
     1923     on error undo, return error return-value
     1924     :
     1925       run diasize_set-height in this-procedure
     1926         (input  v-diasize-current-frame-height
     1927         ,input  true
     1928         ) .
     1929       run diasize_set-width in this-procedure
     1930         (input  v-diasize-current-frame-width
     1931         ,input  true
     1932         ) .
     1933     end.
     1934   end procedure.
     1935   procedure diasize_set-browse-handle :
     1936     define input  parameter p-browse-handle as handle   no-undo .
     1937     define buffer buf_temp-browse-handle for temp-browse-handle .
     1938     do
     1939     on error undo, return error return-value
     1940     :
     1941       assign
     1942         v-diasize-browse-handle = p-browse-handle
     1943       .
     1944       for each buf_temp-browse-handle
     1945       on error undo, return error return-value
     1946       :
     1947         delete buf_temp-browse-handle .
     1948       end.
     1949     end.
     1950   end procedure.
     1951   procedure diasize_add_browse :
     1952     define input  parameter p-browse-type   as character no-undo .
     1953     define input  parameter p-browse-handle as handle    no-undo .
     1954     define buffer buf_temp-browse-handle for temp-browse-handle .
     1955     do
     1956     on error undo, return error return-value
     1957     :
     1958       assign
     1959         v-diasize-browse-number = v-diasize-browse-number + 1
     1960       .
     1961       create buf_temp-browse-handle .
     1962       assign
     1963         buf_temp-browse-handle.browse-type   = p-browse-type
     1964         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1965         buf_temp-browse-handle.browse-handle = p-browse-handle
     1966       .
     1967     end.
     1968   end procedure.
     1969   procedure diasize_init :
     1970     define variable v-default-value    as logical   no-undo .
     1971     define variable v-restore-saved    as logical   no-undo .
     1972     define variable v-resize-value-str as character no-undo .
     1973     do
     1974     on error undo, return error return-value
     1975     :
     1976       do with frame Dialog-Frame
     1977       :
     1978         assign
     1979           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1980           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1981           v-diasize-browse-handle     = browse BR-lines :handle
     1982         .
     1983         create button v-diasize-resize-button
     1984         assign
     1985           parent        = frame Dialog-Frame :first-child
     1986           label         = "s"
     1987           height-pixels = 16
     1988           width-pixels  = 16
     1989           visible       = true
     1990           sensitive     = true
     1991           movable       = true
     1992           triggers:
     1993             on end-move persistent run diasize_end-move in this-procedure .
     1994           end triggers.
     1995         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1996         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1997         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1998         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1999         assign
     2000           v-diasize-wndmax = false
     2001         .
     2002         if connected("ub") = true
     2003         then do:
     2004           define variable v-cntxt-db-num        as integer   no-undo .
     2005           define variable v-cntxt-userid        as character no-undo .
     2006           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2007                                             , OUTPUT v-cntxt-userid
     2008                                             ) .
     2009           run gbl/wndpar_r.p
     2010             (input  v-cntxt-db-num
     2011             ,input  v-cntxt-userid
     2012             ,input  'wndmax':U
     2013             ,output v-diasize-wndmax
     2014             ,output v-default-value
     2015             ) .
     2016         end.
     2017         assign
     2018           v-diasize-wndstore = false
     2019         .
     2020         if connected("ub") = true
     2021         then do:
     2022           run gbl/wndpar_r.p
     2023             (input  v-cntxt-db-num
     2024             ,input  v-cntxt-userid
     2025             ,input  'wndstore':U
     2026             ,output v-diasize-wndstore
     2027             ,output v-default-value
     2028             ) .
     2029         end.
     2030         assign
     2031           v-diasize-proc-name = entry(1, program-name(2), '.')
     2032         .
     2033         if v-diasize-wndstore = true
     2034         then do:
     2035           assign
     2036             v-restore-saved = false
     2037           .
     2038           if connected("ub") = true
     2039           then do:
     2040             run gbl/wndsizer.p
     2041               (input  v-cntxt-db-num
     2042               ,input  v-cntxt-userid
     2043               ,input  v-diasize-proc-name
     2044               ,input  'height':u
     2045               ,output v-resize-value-str
     2046               ) .
     2047             if v-resize-value-str <> '':U
     2048             then do:
     2049               run diasize_change-height in this-procedure
     2050                 (input  integer(v-resize-value-str)
     2051                 ,input  true
     2052                 ) .
     2053               assign
     2054                 v-restore-saved = true
     2055               .
     2056             end.
     2057           end.
     2058           if connected("ub") = true
     2059           then do:
     2060             run gbl/wndsizer.p
     2061               (input  v-cntxt-db-num
     2062               ,input  v-cntxt-userid
     2063               ,input  v-diasize-proc-name
     2064               ,input  'width':u
     2065               ,output v-resize-value-str
     2066               ) .
     2067             if v-resize-value-str <> '':U
     2068             then do:
     2069               run diasize_change-width in this-procedure
     2070                 (input  integer(v-resize-value-str)
     2071                 ,input  true
     2072                 ) .
     2073               assign
     2074                 v-restore-saved = true
     2075               .
     2076             end.
     2077           end.
     2078           if v-restore-saved <> true
     2079           then do:
     2080             if v-diasize-wndmax = true
     2081             then do:
     2082               run diasize_maximize in this-procedure
     2083                 (input  true
     2084                 ) .
     2085             end.
     2086           end.
     2087         end.
     2088         else do:
     2089           if v-diasize-wndmax = true
     2090           then do:
     2091             run diasize_maximize in this-procedure
     2092               (input  true
     2093               ) .
     2094           end.
     2095         end.
     2096       end.
     2097     end.
     2098   end procedure.
     2099   procedure diasize_need-full-display :
     2100     define output parameter p-need-full-display as logical   no-undo .
     2101     do
     2102     on error undo, return error return-value
     2103     :
     2104       assign
     2105         p-need-full-display = v-diasize-need-full-display
     2106       .
     2107       assign
     2108         v-diasize-need-full-display = false
     2109       .
     2110     end.
     2111   end procedure.
     2112   procedure get-context :
     2113      define output parameter p-db-num as integer          no-undo.
     2114      define output parameter p-user-id as character        no-undo.
     2115      define variable v-login               as character    no-undo.
     2116      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2117      define buffer buf_user-login  for ub.user-login .
     2118      do
     2119      on error undo, return error
     2120      :
     2121            FIND FIRST buf_sys-ctrl no-lock.
     2122            ASSIGN
     2123               v-login = USERID("ub")
     2124               p-db-num = buf_sys-ctrl.db-num
     2125            .
     2126            FIND FIRST buf_user-login
     2127                 WHERE buf_user-login.db-num = p-db-num
     2128                   AND buf_user-login.user-login = v-login
     2129                 no-lock
     2130                 no-error
     2131                 .
     2132            IF AVAILABLE buf_user-login
     2133            THEN DO:
     2134               assign
     2135                  p-user-id = buf_user-login.user-id
     2136               .
     2137            END.
     2138      end.
     2139   end procedure.
     2140       run diasize_init in this-procedure .
     2141   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2142   ON TAB ANYWHERE
     2143   DO:
     2144   define variable ii as integer no-undo .
     2145   define variable fh as widget-handle no-undo .
     2146   define variable hh as widget-handle no-undo .
     2147   define variable v-next-widget-name as character no-undo .
     2148   if v-tab-order <> '' then do:
     2149     if self:type = "TOGGLE-BOX" then
     2150     self:BGCOLOR = ?.
     2151     assign
     2152     ii = lookup(self:name, v-tab-order).
     2153     assign
     2154     ii = ii + 1
     2155     v-next-widget-name = entry(ii, v-tab-order)
     2156     no-error .
     2157     if error-status:error then do:
     2158       assign
     2159       ii = 1
     2160       v-next-widget-name = entry( ii, v-tab-order)
     2161       .
     2162     end.
     2163     assign
     2164     fh = frame Dialog-Frame:first-child
     2165     hh = fh:first-child
     2166     .
     2167     do while valid-handle(hh):
     2168       if hh:name = v-next-widget-name then do:
     2169         if hh:sensitive  = yes
     2170         AND hh:visible = yes then do:
     2171           if hh:type = "TOGGLE-BOX":U then do:
     2172             assign
     2173             hh:BGcolor = 1
     2174             .
     2175           end.
     2176           APPLY "ENTRY" to hh.
     2177           return no-apply.
     2178         end.
     2179         else do:
     2180           APPLY "TAB" to hh.
     2181           return no-apply.
     2182         end.
     2183       end.
     2184       hh = hh:next-sibling.
     2185     end.
     2186   end.
     2187   END.
     2188   ON BACK-TAB ANYWHERE
     2189   DO:
     2190   define variable ii as integer no-undo .
     2191   define variable fh as widget-handle no-undo .
     2192   define variable hh as widget-handle no-undo .
     2193   define variable v-next-widget-name as character no-undo .
     2194   if v-tab-order <> '' then do:
     2195     assign
     2196     ii = lookup(self:name, v-tab-order).
     2197     .
     2198     assign
     2199     ii = (if ii = 1
     2200           then  num-entries(v-tab-order)
     2201           else ii - 1
     2202           )
     2203     v-next-widget-name = entry(ii, v-tab-order)
     2204     .
     2205     assign
     2206     fh = frame Dialog-Frame:first-child
     2207     hh = fh:first-child
     2208     .
     2209     do while valid-handle(hh):
     2210       if hh:name = v-next-widget-name then do:
     2211         if hh:sensitive  = yes
     2212         AND hh:visible = yes then do:
     2213           if hh:type = "TOGGLE-BOX":U then do:
     2214             assign
     2215             hh:BGcolor = 1
     2216             .
     2217           end.
     2218           APPLY "ENTRY" to hh.
     2219           return no-apply.
     2220         end.
     2221         else do:
     2222         APPLY "BACK-TAB" to hh.
     2223         return no-apply.
     2224         end.
     2225       end.
     2226       hh = hh:next-sibling.
     2227     end.
     2228     end.
     2229   END.
     2230   def var sort-labelBR-lines   as character no-undo .
     2231   def var sort-clmnBR-lines    as handle    no-undo .
     2232   def var cur-clmnBR-lines     as handle    no-undo .
     2233   def var cur-clmn-locBR-lines as integer   no-undo .
     2234   def var re-queryBR-lines     as logical   initial no no-undo .
     2235   on start-search, ctrl-o of BR-lines in frame Dialog-Frame do:
     2236      run sort-brBR-lines
     2237        (input (if available locked_c-fin-statement-line
     2238                then recid(locked_c-fin-statement-line)
     2239                else ?
     2240               )
     2241        ).
     2242   end.
     2243   PROCEDURE sort-brBR-lines :
     2244     define input parameter p-recid as recid no-undo .
     2245     if re-queryBR-lines = no then do:
     2246       assign
     2247          cur-clmnBR-lines = BR-lines:current-column in frame Dialog-Frame
     2248       .
     2249       if sort-clmnBR-lines <> ? then sort-clmnBR-lines:column-fgcolor = 0.
     2250       if cur-clmnBR-lines = sort-clmnBR-lines then do:
     2251         assign
     2252            sort-labelBR-lines = ""
     2253            sort-clmnBR-lines = ?
     2254         .
     2255        end.
     2256        else do:
     2257          assign
     2258            sort-labelBR-lines = cur-clmnBR-lines:label
     2259            sort-clmnBR-lines  = cur-clmnBR-lines
     2260            sort-clmnBR-lines:column-fgcolor = 4
     2261          .
     2262        end.
     2263      end.
     2264     assign
     2265       cur-clmn-locBR-lines = 1
     2266     .
     2267     def var column-handle as handle no-undo .
     2268     column-handle = BR-lines:first-column.
     2269     do while valid-handle(column-handle) :
     2270       if column-handle = cur-clmnBR-lines then do:
     2271         leave .
     2272       end.
     2273       column-handle = column-handle:NEXT-COLUMN.
     2274       assign
     2275         cur-clmn-locBR-lines = cur-clmn-locBR-lines + 1
     2276       .
     2277     end.
     2278     case sort-labelBR-lines:
     2279           when '*'  then DO:   assign     sort-column-name = "mark-string(recid(locked_c-fin-statement-line), v-rid-list)"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2280           when locked_c-fin-statement-line.line-num:label in browse BR-lines then DO:   assign     sort-column-name = "locked_c-fin-statement-line.line-num"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2281           when locked_c-fin-statement-line.prn-doc-code:label in browse BR-lines then DO:   assign     sort-column-name = "locked_c-fin-statement-line.prn-doc-code"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2282           when locked_c-fin-statement-line.fin-doc-code:label in browse BR-lines then DO:   assign     sort-column-name = "locked_c-fin-statement-line.fin-doc-code"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2283           when 'Контрагент'  then DO:   assign     sort-column-name = "get-cli-name(buffer locked_c-fin-statement-line)"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2284           when locked_c-fin-statement-line.sum-doc:label in browse BR-lines then DO:   assign     sort-column-name = "locked_c-fin-statement-line.sum-doc"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2285       otherwise do:
     2286         assign
     2287           sort-column-name = ""
     2288         .
     2289         run OpenBr in this-procedure ( yes, no, no).
     2290           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-lines') then do:
     2291             run mv-brw-defaultBR-lines.
     2292           end.
     2293         if sort-labelBR-lines <> "" then do:
     2294           assign
     2295             cur-clmnBR-lines:column-fgcolor = 0
     2296           .
     2297         end.
     2298         assign
     2299           cur-clmn-locBR-lines = ?
     2300         .
     2301       end.
     2302     end case.
     2303       if cur-clmn-locBR-lines <> ? then do:
     2304         if can-do( this-procedure:internal-entries, 'ch-clmnBR-lines') then do:
     2305           run ch-clmnBR-lines in this-procedure (cur-clmn-locBR-lines).
     2306         end.
     2307       end.
     2308     if p-recid <> ? then do:
     2309       reposition BR-lines to recid p-recid no-error.
     2310       apply "value-changed" to BR-lines in frame Dialog-Frame.
     2311     end.
     2312     apply "entry" to BR-lines in frame Dialog-Frame.
     2313   END PROCEDURE.
     2314   procedure re-open-query-srt-clmnBR-lines:
     2315   if cur-clmnBR-lines = ? then do:
     2316      run OpenBr in this-procedure ( yes, no, no).
     2317   end.
     2318   else do:
     2319      assign re-queryBR-lines = yes.
     2320      run sort-brBR-lines
     2321        (input (if available locked_c-fin-statement-line
     2322                then recid(locked_c-fin-statement-line)
     2323                else ?
     2324               )
     2325        ).
     2326      assign re-queryBR-lines = no.
     2327   end.
     2328   end.
     2329   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2330   do:
     2331     BR-lines :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2332   end.
     2333   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2334   on f5 of frame Dialog-Frame anywhere
     2335   do:
     2336     v-doc-rec = recid(locked_c-fin-statement-line). run OpenBr in this-procedure ( yes, no, '':U). reposition br-lines to recid v-doc-rec no-error. v-doc-rec = ?.
     2337       apply "VALUE-CHANGED" to BR-lines.
     2338   end.
     2339   MAIN-BLOCK:
     2340   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2341      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2342     RUN check-parameters IN THIS-PROCEDURE NO-ERROR.
     2343     IF ERROR-STATUS:ERROR THEN UNDO main-block, RETURN ERROR.
     2344     RUN fill-tables IN THIS-PROCEDURE NO-ERROR.
     2345     IF ERROR-STATUS:ERROR THEN UNDO main-block, RETURN ERROR.
     2346     RUN Myenable in this-procedure .
     2347     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2348     HIDE mark-num in frame Dialog-Frame .
     2349     if p-line-rec <> ? then
     2350     REPOSITION br-lines to recid p-line-rec No-ERROR.
     2351   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2352   DEF VAR cur-clmn-numbr-lines as INT EXTENT 7 no-undo.
     2353   DEF VAR varmvibr-lines       as INT no-undo.
     2354   DEF VAR varmvjbr-lines       as INT no-undo.
     2355   DEF VAR varmvkbr-lines       as INT no-undo.
     2356   DEF VAR varmvlbr-lines       as INT no-undo.
     2357   DEF VAR move-elementbr-lines as INT no-undo.
     2358   def var jjbr-lines           as int no-undo.
     2359   do varmvibr-lines = 1 to EXTENT(cur-clmn-numbr-lines):
     2360     ASSIGN cur-clmn-numbr-lines[varmvibr-lines] = varmvibr-lines.
     2361   END.
     2362   RUN start-mv-clmnbr-lines.
     2363   PROCEDURE start-mv-clmnbr-lines:
     2364   def var old-session as logical no-undo.
     2365      old-session = SESSION:IMMEDIATE-DISPLAY.
     2366      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2367          IF  yes  THEN DO:
     2368      DO jjbr-lines = NUM-ENTRIES('1,2,3,4,5,6,7') TO 1 BY -1:
     2369        RUN re-move-clmnbr-lines ( cur-clmn-numbr-lines[INTEGER(ENTRY (jjbr-lines, '1,2,3,4,5,6,7'))] , 2).
     2370      END.
     2371          END.
     2372      SESSION:IMMEDIATE-DISPLAY = old-session.
     2373   END.
     2374   ON ctrl-cursor-right OF BROWSE br-lines do:
     2375     RUN re-move-clmnbr-lines ( 2, 7).
     2376   END.
     2377   ON ctrl-cursor-left OF BROWSE br-lines do:
     2378     RUN re-move-clmnbr-lines (7, 2).
     2379   END.
     2380   PROCEDURE re-move-clmnbr-lines:
     2381     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2382     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2383     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     2384       if cur-clmn-numbr-lines[varmvibr-lines] = source-column THEN cur-clmn-numbr-lines[varmvibr-lines] = -1.
     2385     END.
     2386     if br-lines:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2387     if source-column > target-column THEN
     2388     DO varmvjbr-lines = source-column - 1 to target-column BY -1:
     2389       DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     2390           if cur-clmn-numbr-lines[varmvibr-lines] = varmvjbr-lines THEN DO:
     2391             cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-numbr-lines[varmvibr-lines] + 1.
     2392           END.
     2393       END.
     2394     END.
     2395     ELSE
     2396     DO varmvjbr-lines = source-column + 1 to target-column:
     2397       DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     2398         if cur-clmn-numbr-lines[varmvibr-lines] = varmvjbr-lines THEN DO:
     2399           cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-numbr-lines[varmvibr-lines] - 1.
     2400         END.
     2401       END.
     2402     END.
     2403     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     2404       if cur-clmn-numbr-lines[varmvibr-lines] = -1 THEN cur-clmn-numbr-lines[varmvibr-lines] = target-column.
     2405     END.
     2406   END PROCEDURE.
     2407   PROCEDURE ch-clmnbr-lines:
     2408     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2409     if cur-clmn-loc <= 2 then do:
     2410       return .
     2411     end.
     2412     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     2413       if cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-loc THEN move-elementbr-lines = varmvibr-lines.
     2414     END.
     2415     RUN re-move-clmnbr-lines (cur-clmn-loc, 2).
     2416   END PROCEDURE.
     2417   PROCEDURE mv-brw-defaultbr-lines:
     2418   def var old-session as logical no-undo.
     2419     old-session = SESSION:IMMEDIATE-DISPLAY.
     2420     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2421     do varmvlbr-lines = 2 to EXTENT(cur-clmn-numbr-lines):
     2422       RUN re-move-clmnbr-lines (cur-clmn-numbr-lines[varmvlbr-lines], varmvlbr-lines).
     2423     END.
     2424     RUN start-mv-clmnbr-lines.
     2425     SESSION:IMMEDIATE-DISPLAY = old-session.
     2426   END PROCEDURE.
     2427   .
     2428     WAIT-FOR GO OF FRAME Dialog-Frame.
     2429   END.
     2430   RUN disable_UI.
     2431   PROCEDURE check-parameters :
     2432   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2434     (output v-db-num
     2435     )  .
     2436   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2437   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2438     (input  p-host-code
     2439     ,output v-base-code
     2440     )  .
     2441   find first X_curr_sysconf no-lock where
     2442                 X_curr_sysconf.host-code = p-curr-host-code.
     2443   find first X_sysconf no-lock where
     2444               X_sysconf.host-code = p-host-code.
     2445   if p-mode <> 'ПРОСМОТР':U
     2446   then do:
     2447       message
     2448       vss-workfile vss-revision vss-description skip
     2449       "Неверное значение параметров вызова p-mode"  p-mode
     2450       view-as alert-box ERROR.
     2451       undo, return error.
     2452   end.
     2453   FIND FIRST X_curr_sysconf NO-LOCK WHERE
     2454           X_curr_sysconf.host-code = p-curr-host-code NO-ERROR.
     2455   IF NOT AVAILABLE X_curr_sysconf THEN DO:
     2456       message
     2457       vss-workfile vss-revision vss-description skip
     2458       "Неверное значение параметров вызова p-curr-host-code"  p-curr-host-code
     2459       view-as alert-box ERROR.
     2460       undo, return error.
     2461   END.
     2462   find first X_clients no-lock where
     2463           X_clients.obj-type = 'орг':U
     2464       and X_clients.obj-code = p-curr-host-code.
     2465   FIND FIRST X_sysconf NO-LOCK WHERE
     2466           X_sysconf.host-code = p-host-code NO-ERROR.
     2467   IF NOT AVAILABLE X_sysconf THEN DO:
     2468       message
     2469       vss-workfile vss-revision vss-description skip
     2470       "Неверное значение параметров вызова p-host-code"  p-curr-host-code
     2471       view-as alert-box ERROR.
     2472       undo, return error.
     2473   END.
     2474   END PROCEDURE.
     2475   PROCEDURE disable_UI :
     2476     HIDE FRAME Dialog-Frame.
     2477   END PROCEDURE.
     2478   PROCEDURE enable_UI :
     2479     DISPLAY mark-num f-bank-data f-th-data F-curr-abbr f-bank
     2480         WITH FRAME Dialog-Frame.
     2481     IF AVAILABLE tt-c-fin-statement THEN
     2482       DISPLAY tt-c-fin-statement.prn-doc-code tt-c-fin-statement.num-docs
     2483             tt-c-fin-statement.num-docs-th tt-c-fin-statement.sttm-code
     2484             tt-c-fin-statement.doc-date tt-c-fin-statement.start-sum-doc
     2485             tt-c-fin-statement.start-sum-doc-th tt-c-fin-statement.bank-date
     2486             tt-c-fin-statement.in-sum-doc tt-c-fin-statement.in-sum-doc-th
     2487             tt-c-fin-statement.fact-date tt-c-fin-statement.out-sum-doc
     2488             tt-c-fin-statement.out-sum-doc-th tt-c-fin-statement.start-date
     2489             tt-c-fin-statement.end-date tt-c-fin-statement.end-sum-doc
     2490             tt-c-fin-statement.end-sum-doc-th tt-c-fin-statement.PS
     2491             tt-c-fin-statement.curr-code tt-c-fin-statement.r-schet
     2492             tt-c-fin-statement.bank-name tt-c-fin-statement.bik
     2493         WITH FRAME Dialog-Frame.
     2494     ENABLE B-quit B-mark B-lookup B-Help tt-c-fin-statement.prn-doc-code
     2495            tt-c-fin-statement.num-docs tt-c-fin-statement.num-docs-th
     2496            tt-c-fin-statement.doc-date tt-c-fin-statement.start-sum-doc
     2497            tt-c-fin-statement.start-sum-doc-th tt-c-fin-statement.bank-date
     2498            tt-c-fin-statement.in-sum-doc tt-c-fin-statement.in-sum-doc-th
     2499            tt-c-fin-statement.out-sum-doc tt-c-fin-statement.out-sum-doc-th
     2500            tt-c-fin-statement.start-date tt-c-fin-statement.end-date
     2501            tt-c-fin-statement.end-sum-doc tt-c-fin-statement.end-sum-doc-th
     2502            BR-lines tt-c-fin-statement.PS mark-num tt-c-fin-statement.curr-code
     2503            tt-c-fin-statement.r-schet tt-c-fin-statement.bank-name
     2504            tt-c-fin-statement.bik
     2505         WITH FRAME Dialog-Frame.
     2506     VIEW FRAME Dialog-Frame.
     2507   END PROCEDURE.
     2508   PROCEDURE fill-tables :
     2509   DEFINE VARIABLE v-today as date no-undo .
     2510   DEFINE VARIABLE v-time as integer no-undo .
     2511   for each tt-c-fin-statement:
     2512     delete tt-c-fin-statement.
     2513   end.
     2514   for each tt0-c-fin-statement-attr:
     2515     delete tt0-c-fin-statement-attr.
     2516   end.
     2517   find first locked_c-fin-statement no-lock where
     2518             recid(locked_c-fin-statement) = p-doc-rec no-error .
     2519   if not available locked_c-fin-statement then do:
     2520     find first locked_c-fin-statement no-lock where
     2521                 locked_c-fin-statement.host-code = p-host-code
     2522             AND locked_c-fin-statement.sttm-code = p-sttm-code no-error .
     2523   end.
     2524   if not available locked_c-fin-statement then do:
     2525     message
     2526     vss-workfile vss-revision vss-description skip
     2527     "Не найдена запись БАНКОВСКОЙ ВЫПИСКИР"
     2528     view-as alert-box error .
     2529     undo, return error.
     2530   end.
     2531   run cur-time in this-procedure ( output v-today, output v-time).
     2532   create tt-c-fin-statement.
     2533   assign
     2534   tt-c-fin-statement.host-code = p-host-code
     2535   tt-c-fin-statement.sttm-code  = next-value(s-fin-sttm, ub)
     2536   tt-c-fin-statement.curr-code = (IF AVAILABLE X_fin-schet THEN X_fin-schet.curr-code ELSE 0)
     2537   tt-c-fin-statement.code-schet = (IF AVAILABLE X_fin-schet THEN X_fin-schet.code-schet ELSE 0)
     2538   tt-c-fin-statement.code-bank = (IF AVAILABLE X_fin-bank THEN X_fin-bank.code-bank ELSE 0)
     2539   tt-c-fin-statement.c-schet  = (IF AVAILABLE X_fin-schet THEN X_fin-schet.c-schet ELSE '':u)
     2540   tt-c-fin-statement.r-schet  = (IF AVAILABLE X_fin-schet THEN X_fin-schet.r-schet ELSE '':u)
     2541   tt-c-fin-statement.bik  = (IF AVAILABLE X_fin-bank THEN X_fin-bank.bik ELSE '':u)
     2542   tt-c-fin-statement.cl-bank  = (IF AVAILABLE X_fin-bank THEN X_fin-bank.cl-bank ELSE '':u)
     2543   tt-c-fin-statement.bank-name = (IF AVAILABLE X_fin-bank THEN X_fin-bank.bank-name ELSE '':u)
     2544   tt-c-fin-statement.bank-city = (IF AVAILABLE X_fin-bank THEN X_fin-bank.bank-city ELSE '':u)
     2545   tt-c-fin-statement.cli-name  = X_CLIENTS.obj-NAME
     2546   tt-c-fin-statement.PS  = '':U
     2547   tt-c-fin-statement.prn-doc-code  = '':U
     2548   tt-c-fin-statement.num-docs  = 0
     2549   tt-c-fin-statement.fins-ext-doc-type = '':U
     2550   tt-c-fin-statement.fins-doc-type = '':U
     2551   tt-c-fin-statement.start-date  = v-today
     2552   tt-c-fin-statement.end-date  = v-TODAY
     2553   tt-c-fin-statement.doc-date      = v-today
     2554   tt-c-fin-statement.fins-doc-type  = 'стд':U
     2555   tt-c-fin-statement.fins-ext-doc-type  = 'стд':U
     2556   tt-c-fin-statement.prn-doc-code  = "":U
     2557   tt-c-fin-statement.status_       = 'новый':U
     2558   .
     2559   END PROCEDURE.
     2560   PROCEDURE MyEnable :
     2561   ASSIGN
     2562   LOCKED_c-fin-statement-line.prn-doc-code:READ-ONLY  IN BROWSE  br-lines = YES
     2563   v-cli-name:resizable IN BROWSE  br-lines  = YES
     2564   .
     2565   ASSIGN
     2566   v-tab-order = "b-quit,b-mark,b-lookup,b-help,"
     2567   .
     2568   DISPLAY
     2569   F-curr-abbr
     2570   mark-num
     2571   f-bank
     2572   f-bank-data
     2573   f-th-data
     2574   WITH FRAME Dialog-Frame.
     2575   IF AVAILABLE tt-c-fin-statement THEN
     2576   DISPLAY
     2577   tt-c-fin-statement.num-docs
     2578   tt-c-fin-statement.num-docs-th
     2579   tt-c-fin-statement.prn-doc-code
     2580   tt-c-fin-statement.sttm-code
     2581   tt-c-fin-statement.doc-date
     2582   tt-c-fin-statement.bank-date
     2583   tt-c-fin-statement.fact-date
     2584   tt-c-fin-statement.curr-code
     2585   tt-c-fin-statement.start-date
     2586   tt-c-fin-statement.end-date
     2587   tt-c-fin-statement.start-sum-doc tt-c-fin-statement.start-sum-doc-th
     2588   tt-c-fin-statement.in-sum-doc tt-c-fin-statement.in-sum-doc-th
     2589   tt-c-fin-statement.out-sum-doc tt-c-fin-statement.out-sum-doc-th
     2590   tt-c-fin-statement.end-sum-doc tt-c-fin-statement.end-sum-doc-th
     2591   tt-c-fin-statement.r-schet
     2592   tt-c-fin-statement.bank-name
     2593   tt-c-fin-statement.bik
     2594   tt-c-fin-statement.PS
     2595   WITH FRAME Dialog-Frame.
     2596   ENABLE
     2597   b-quit
     2598   B-mark WHEN NOT (p-mode = 'ПРОСМОТР':U AND p-line-rec = ?)
     2599   B-lookup
     2600   B-Help
     2601   BR-lines
     2602   mark-num
     2603   WITH FRAME Dialog-Frame.
     2604   VIEW FRAME Dialog-Frame.
     2605   assign
     2606   frame Dialog-Frame:title = substitute("&1 Срез &2", frame Dialog-Frame:title, tt-c-fin-statement.chip-num).
     2607   APPLY "Value-changed" TO tt-c-fin-statement.curr-code.
     2608   END PROCEDURE.
     2609   PROCEDURE OpenBr :
     2610   define input  parameter p-open-query     as logical   no-undo .
     2611   define input  parameter p-find-next      as logical   no-undo .
     2612   define input  parameter p-find-condition as character no-undo .
     2613   OPEN QUERY br-lines FOR EACH locked_c-fin-statement-line NO-LOCK where
     2614       locked_c-fin-statement-line.host-code = tt-c-fin-statement.host-code
     2615    AND locked_c-fin-statement-line.sttm-code = tt-c-fin-statement.sttm-code INDEXED-REPOSITION.
     2616   END PROCEDURE.
     2617   FUNCTION get-cli-name RETURNS CHARACTER
     2618     (BUFFER buf_c-fin-statement-line FOR ub.c-fin-statement-line ) :
     2619   DEFINE BUFFER buf_fin-doc FOR ub.fin-doc.
     2620   IF buf_c-fin-statement-line.fin-doc-code = 0  THEN DO:
     2621       RETURN '':U.
     2622   END.
     2623   FIND FIRST buf_fin-doc NO-LOCK WHERE
     2624             buf_fin-doc.host-code = buf_c-fin-statement-line.host-code
     2625        AND  buf_fin-doc.fin-doc-code = buf_c-fin-statement-line.fin-doc-code NO-ERROR.
     2626   IF NOT AVAILABLE buf_fin-doc THEN DO:
     2627       RETURN "!!!Не найден платеж".
     2628   END.
     2629   CASE buf_fin-doc.fin-ext-doc-type:
     2630       WHEN 'ппп':U THEN DO:
     2631           RETURN buf_fin-doc.payer-name.
     2632       END.
     2633       WHEN 'рпп':U THEN DO:
     2634          RETURN buf_fin-doc.receiver-name.
     2635       END.
     2636   END CASE.
     2637     RETURN "".
     2638   END FUNCTION.
