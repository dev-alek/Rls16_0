     1392     define variable v-window-width         as decimal   no-undo .
     1393     define variable v-window-virtual-width as decimal   no-undo .
     1394     define variable v-change-sign          as integer   no-undo .
     1395     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1396     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1397     if p-change-value > 0
     1398     then do:
     1399       if frame Dialog-Frame :width + p-change-value >
     1400           session :width-chars
     1401       then do:
     1402         assign
     1403           p-change-value = session :width-chars - frame Dialog-Frame :width
     1404         .
     1405         if p-change-value <= 0
     1406         then do:
     1407           run diasize_position-resize-button in this-procedure .
     1408           return .
     1409         end.
     1410       end.
     1411     end.
     1412     if p-change-value < 0
     1413     then do:
     1414       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1415       then do:
     1416         assign
     1417           p-change-value = v-diasize-orig-frame-width
     1418                          - frame Dialog-Frame :width
     1419         .
     1420         if p-change-value >= 0
     1421         then do:
     1422           run diasize_position-resize-button in this-procedure .
     1423           return .
     1424         end.
     1425       end.
     1426     end.
     1427     if p-change-value >= 0
     1428     then do:
     1429       assign
     1430         v-change-sign = 1
     1431       .
     1432     end.
     1433     else do:
     1434       assign
     1435         v-change-sign = -1
     1436       .
     1437     end.
     1438     assign
     1439       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1440     .
     1441     if p-change-value = 0
     1442     then do:
     1443       run diasize_position-resize-button in this-procedure .
     1444       return .
     1445     end.
