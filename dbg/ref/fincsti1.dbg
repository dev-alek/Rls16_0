      770        f-th-data AT ROW 2 COL 78 NO-LABEL
      771        tt-c-fin-statement.curr-code AT ROW 5 COL 1
      772             LABEL "Вал" FORMAT ">>9"
      773              VIEW-AS TEXT
      774             SIZE 4 BY .67
      775        F-curr-abbr AT ROW 5 COL 6 COLON-ALIGNED NO-LABEL
      776        f-bank AT ROW 7 COL 1 NO-LABEL
      777        tt-c-fin-statement.r-schet AT ROW 7 COL 8 COLON-ALIGNED NO-LABEL FORMAT "X(20)"
      778              VIEW-AS TEXT
      779             SIZE 21 BY .67
      780             FGCOLOR 4
      781        tt-c-fin-statement.bank-name AT ROW 7 COL 30 COLON-ALIGNED NO-LABEL FORMAT "X(100)"
      782              VIEW-AS TEXT
      783             SIZE 50 BY .67
      784        tt-c-fin-statement.bik AT ROW 7 COL 87 COLON-ALIGNED
      785             LABEL "БИК" FORMAT "X(9)"
      786              VIEW-AS TEXT
      787             SIZE 10 BY .67
      788             FGCOLOR 4
      789        SPACE(0.24) SKIP(14.36)
      790       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      791            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      792            TITLE "Выписка №"
      793            CANCEL-BUTTON B-quit.
      794   ASSIGN
      795          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      796          FRAME Dialog-Frame:HIDDEN           = TRUE.
      797   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      798   DO:
      799     APPLY "END-ERROR":U TO SELF.
      800   END.
      801   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
      802   DO:
      803   define buffer buf_fin-doc for ub.fin-doc.
      804     IF NOT AVAILABLE LOCKED_c-fin-statement-line THEN RETURN NO-APPLY.
      805     IF locked_c-fin-statement-line.fin-doc-code = 0 THEN DO:
      806         MESSAGE
      807         "К данной строке платеж в системе не привязан!" SKIP
      808         "Просмотр невозможен!"
      809         VIEW-AS ALERT-BOX.
      810     END.
      811     find first buf_fin-doc no-lock where
      812               buf_fin-doc.host-code = locked_c-fin-statement.host-code
      813          and buf_fin-doc.fin-doc-code = locked_c-fin-statement-line.fin-doc-code no-error.
      814     if not available buf_Fin-doc then do:
      815     end.
      816     else do:
      817       run ref/shwcfind.p (
      818                           input parParentProc
      819                         ,input p-curr-host-code
      820                         ,input locked_c-fin-statement-line.host-code
      821                         ,input locked_c-fin-statement-line.fin-doc-code
      822                         ,input locked_c-fin-statement-line.corr-user-db-num
      823                         ,input locked_c-fin-statement-line.chip-num).
      824     end.
      825   END.
      826   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      827   DO:
      828   define variable loc#log as logical no-undo .
      829     if available locked_c-fin-statement then do:
      830   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      831   define variable v-str-recid4 as character no-undo .
      832   define variable v-num-entry4 as integer   no-undo .
      833   assign
      834     v-str-recid4 = trim( string( recid( locked_c-fin-statement ) , "->>>>>>>>>>>9":U ) )
      835     v-num-entry4 = lookup( v-str-recid4 , v-rid-list )
      836   .
      837   if v-num-entry4 > 0 then do:
      838     assign
      839       entry( v-num-entry4, v-rid-list ) = "":U
      840       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      841     .
      842   end.
      843   else do:
      844     assign
      845       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid4
      846     .
      847   end.
      848       loc#log = br-lines:refresh() .
      849       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      850           loc#log = br-lines:select-next-row ().
      851           apply "VALUE-CHANGED" to br-lines in frame Dialog-Frame.
      852       end.
      853       if num-entries( v-rid-list ) = 0
      854       then
      855           hide mark-num in frame Dialog-Frame.
      856       else
      857           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      858     end.
      859     apply "entry" to br-lines in frame Dialog-Frame.
      860   END.
      861   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      862   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      863   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      864   on help of frame Dialog-Frame
      865   do:
      866     run gbl/app_help.p
      867       (input this-procedure :file-name
      868       ,input ''
      869       ,input ?
      870       ) no-error.
      871     if error-status :error then do:
      872       message
      873         "Ошибка при вызове помощи"
      874         error-status :get-message(1)
      875         view-as alert-box .
      876     end.
      877   end.
      878   run minbtn-set in this-procedure .
      879   on choose of b-help in frame Dialog-Frame
      880   do:
      881     apply "help":u to frame Dialog-Frame .
      882   end.
      883   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      884   procedure minbtn-set :
      885       do
      886           on error undo, return error return-value
      887           :
      888           define variable ii              as integer       no-undo .
      889           define variable fh              as widget-handle no-undo .
      890           define variable hh              as widget-handle no-undo .
      891           define variable v-h             as handle        extent 4 no-undo .
      892           define variable v-name-button   as character     no-undo .
      893           define variable v-help-old-x    as decimal       no-undo .
      894           define variable v-help-old-y    as decimal       no-undo .
      895           define variable v-help-old-size as decimal       no-undo .
      896           define variable v-frame-width   as decimal       no-undo .
      897           define variable jj              as integer       no-undo .
      898           do
      899               on error undo, return error
      900               :
      901               assign
      902                   v-frame-width = frame Dialog-Frame:width - 0.3
      903                   fh            = frame Dialog-Frame:first-child
      904                   hh            = fh:first-child
      905                   ii            = 1
      906                   .
      907               do while valid-handle(hh):
      908                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      909                   do:
      910                       case lc(hh:name) :
      911                           when "b-help" then
      912                               do:
      913                                   hh:load-image-up("cmp/b-help.bmp":u) .
      914                                   hh:load-image-down("cmp/b-help.bmp":u) .
      915                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      916                                   hh:TOOLTIP = "Помощь" .
      917                                   v-help-old-x = hh:column .
      918                                   v-help-old-y = hh:row    .
      919                                   v-help-old-size = hh:width .
      920                                   hh:width-chars = 2.5 .
      921                               end.
      922                           when "b-print" then
      923                               do:
      924                                   hh:load-image("cmp/b-print.bmp":u) .
      925                                   hh:TOOLTIP = "Печать" .
      926                                   v-h[ii] = hh:handle .
      927                                   ii = ii + 1 .
      928                                   hh:width-chars = 3 .
      929                               end.
      930                           when "b-history" or
      931                           when "b-hist" then
      932                               do:
      933                                   hh:load-image("cmp/b-hist.bmp":u) .
      934                                   hh:TOOLTIP = "История" .
      935                                   v-h[ii] = hh:handle .
      936                                   ii = ii + 1 .
      937                                   hh:width-chars = 3 .
      938                               end.
      939                           when "b-sch" then
      940                               do:
      941                                   hh:load-image("cmp/b-sch.bmp":u) .
      942                                   hh:TOOLTIP = "Установка Фильтра" .
      943                                   v-h[ii] = hh:handle .
      944                                   ii = ii + 1 .
      945                                   hh:width-chars = 3 .
      946                               end.
      947                           when "b-hist-user" then
      948                               do:
      949                                   hh:load-image("cmp/b-hist.bmp":u) .
      950                                   hh:TOOLTIP = "История пользователя" .
      951                                   ii = ii + 1 .
      952                               end.
      953                       end case.
      954                   end.
      955                   hh = hh:next-sibling.
      956               end.
      957               b-help:column = v-frame-width - b-help:width-chars.
      958               jj = 0.
      959               repeat ii = 4 to 1 by -1 :
      960                   if valid-handle (v-h[ii] ) then
      961                   do:
      962                       jj  = jj + 1 .
      963                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      964                       v-h[ii]:row    = v-help-old-y .
      965                   end.
      966               end.
      967           end.
      968       end.
      969   end procedure.
      970   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      971   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      972   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      973   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      974   define variable v-diasize-current-frame-width  as decimal   no-undo .
      975   define variable v-diasize-current-frame-height as decimal   no-undo .
      976   define variable v-diasize-change-size          as logical   no-undo .
      977   define variable v-diasize-resize-button        as handle    no-undo .
      978   define variable v-diasize-wndmax               as logical   no-undo .
      979   define variable v-diasize-wndstore             as logical   no-undo .
      980   define variable v-diasize-proc-name            as character no-undo .
      981   define variable v-diasize-browse-handle        as handle    no-undo .
      982   define variable v-diasize-browse-number        as integer   no-undo .
      983   define variable v-diasize-need-full-display    as logical   no-undo init false .
      984   define temp-table temp-diasize-handle no-undo
      985     field handle-value  as handle
      986     field save-position as decimal
      987     index xpk is primary unique handle-value
      988     .
      989   define temp-table temp-browse-handle no-undo
      990     field browse-type   as character
      991     field browse-number as integer
      992     field browse-handle as handle
      993     field original-size as decimal
      994     index xpk is primary unique browse-type browse-number
      995     index xie browse-type browse-handle
      996   .
      997   procedure diasize_change-height :
      998     define input  parameter p-change-value  as decimal   no-undo .
      999     define input  parameter p-move-resize   as logical   no-undo .
     1000     define variable v-field-group-handle    as handle    no-undo .
     1001     define variable v-object-handle         as handle    no-undo .
     1002     define variable v-frame-height          as decimal   no-undo .
     1003     define variable v-frame-virtual-height  as decimal   no-undo .
     1004     define variable v-browse-height         as decimal   no-undo .
     1005     define variable v-window-height         as decimal   no-undo .
     1006     define variable v-window-virtual-height as decimal   no-undo .
     1007     define variable v-change-sign           as integer   no-undo .
     1008     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1009     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1010     if p-change-value > 0
     1011     then do:
     1012       if frame Dialog-Frame :height + p-change-value
     1013           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1014       then do:
     1015         assign
     1016           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1017                           - (frame Dialog-Frame :height-chars)
     1018         .
     1019         if p-change-value <= 0
     1020         then do:
     1021           run diasize_position-resize-button in this-procedure .
     1022           return .
     1023         end.
     1024       end.
     1025     end.
     1026     if p-change-value < 0
     1027     then do:
     1028       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1029       then do:
     1030         assign
     1031           p-change-value = v-diasize-orig-frame-height
     1032                          - (frame Dialog-Frame :height-chars)
     1033         .
     1034         if p-change-value >= 0
     1035         then do:
     1036           run diasize_position-resize-button in this-procedure .
     1037           return .
     1038         end.
     1039       end.
     1040     end.
     1041     if p-change-value >= 0
     1042     then do:
     1043       assign
     1044         v-change-sign = 1
     1045       .
     1046     end.
     1047     else do:
     1048       assign
     1049         v-change-sign = -1
     1050       .
     1051     end.
     1052     assign
     1053       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1054     .
     1055     if p-change-value = 0
     1056     then do:
     1057       run diasize_position-resize-button in this-procedure .
     1058       return .
