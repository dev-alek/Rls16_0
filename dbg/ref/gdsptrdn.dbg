        1   DEFINE BUFFER buf_goods FOR goods.
        2   define input parameter p-gds-code like ub.goods.gds-code no-undo.
        3   define input-output parameter p-value as character no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Диапазоны плотности для топлива".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define variable v-waitfram-action01         as character   no-undo .
       72   define variable v-waitfram-action02         as character   no-undo .
       73   define variable v-waitfram-action03         as character   no-undo .
       74   define variable mWaitFramTextBeg            as character   no-undo.
       75   define variable mWaitFramTextEnd            as character   no-undo.
       76   define variable mWaitFramView               as logical     no-undo.
       77   define variable mWaitProcEvent              as logical     no-undo init yes.
       78   define variable mWaitFramInterval           as integer     no-undo init 1 .
       79   define variable mWaitFramStop               as logical     no-undo.
       80   define variable mWaitFramStopUser           as logical     no-undo.
       81   define variable mWaitFramStopTimeOut        as logical     no-undo.
       82   define variable mWaitFramStartProc          as datetime-tz no-undo.
       83   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       84   define button B-WaitFramStop auto-end-key
       85        label "Стоп"
       86        size 10 by 1 tooltip "Остоновить процесс".
       87   define button B-viewProcInfo
       88        label "Информация"
       89        size 15 by 1 tooltip "Информация о процесс".
       90   define frame waitfram
       91     v-waitfram-action01 format "x(72)" no-label skip
       92     v-waitfram-action02 format "x(72)" no-label skip
       93     v-waitfram-action03 format "x(72)" no-label skip
       94     B-viewProcInfo
       95     B-WaitFramStop at row 4 col 30
       96     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       97     .
       98   define new global shared variable mBatchMode as logical no-undo init ?.
       99   define variable mFramBachModHandle as handle no-undo.
      100   mFramBachModHandle = frame waitfram:handle.
      101   define variable mFameOldVis as logical no-undo.
      102   define variable mVisCUrentVin as logical no-undo.
      103   if session:batch-mode
      104   then
      105      mBatchMode = yes.
      106   if mBatchMode = ? then do:
      107     mVisCUrentVin = current-window:visible.
      108     mFameOldVis = mFramBachModHandle:visible.
      109     mFramBachModHandle:visible  = yes.
      110     mBatchMode = mFramBachModHandle:visible ne yes.
      111     mFramBachModHandle:visible = mFameOldVis.
      112     current-window:visible = mVisCUrentVin.
      113   end.
      114    if  log-manager:logfile-name ne ?
      115     then DO:
      116         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      117         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      118         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      119     end.
      120   on choose of B-WaitFramStop in frame waitfram
      121   do:
      122     mWaitFramStop = yes.
      123     mWaitFramStopUser = yes.
      124   end.
      125   function waitfram-check-timeout returns logical():
      126      define variable vtime as int64 no-undo.
      127      if mWaitFramStopTimeOut
      128      then
      129         return yes.
      130      vtime = ( now - mWaitFramStartProc ) / 1000 .
      131      if     mWaitFramTimeOut ne ?
      132         and mWaitFramTimeOut ne 0
      133         and mWaitFramTimeOut lt vtime
      134      then do:
      135         mWaitFramStopTimeOut = yes.
      136      end.
      137      return mWaitFramStopTimeOut.
      138   end.
      139   procedure waitfram-hide :
      140     if not session:batch-mode
      141     then do
      142     on error undo, return error return-value
      143     :
      144       pause 0 before-hide .
      145       if not mBatchMode then
      146         hide frame waitfram .
      147     if     not mWaitFramView
      148        and mWaitProcEvent
      149     then
      150       process events .
      151     end.
      152   end procedure.
      153   procedure waitfram-show :
      154     define input  parameter p-message as character no-undo .
      155     define variable v-left-margin as integer   no-undo .
      156     if not session:batch-mode
      157     then do
      158     on error undo, return error return-value
      159     :
      160       if length(p-message) <= 70 then do:
      161         assign
      162           v-left-margin = integer((70 - length(p-message)) / 2)
      163         .
      164         assign
      165           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      166         .
      167         assign
      168           v-waitfram-action01 = " "
      169           v-waitfram-action02 = " "
      170                                    + fill(" ", v-left-margin)
      171                                    + p-message
      172           v-waitfram-action03 = " "
      173         .
      174       end.
      175       else do:
      176         define variable vRindex1 as integer no-undo.
      177         define variable vRindex2 as integer no-undo.
      178         vRindex1 = r-index(p-message," ",70).
      179         if vRindex1 = 0
      180         then
      181            vRindex1 = 70.
      182         if length(p-message)  <= vRindex1 + 70 then do:
      183           assign
      184             v-waitfram-action01 = " "
      185             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      186             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      187           .
      188         end.
      189         else do:
      190           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      191           if vRindex2 <= vRindex1
      192           then
      193              vRindex2 = vRindex1 + 70.
      194           assign
      195             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      197             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      198           .
      199         end.
      200       end.
      201       B-viewProcInfo:visible   in frame waitfram = no.
      202       B-viewProcInfo:sensitive in frame waitfram = no.
      203       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       if  (   mWaitFramView
      206          or  mWaitProcEvent)
      207          and not mBatchMode
      208       then
      209          display
      210             v-waitfram-action01 skip
      211             v-waitfram-action02 skip
      212             v-waitfram-action03 skip
      213          with frame waitfram .
      214       if     mWaitFramView
      215          then do:
      216             if     mWaitFramInterval ne ?
      217                and not mBatchMode
      218             then
      219                wait-for go of frame waitfram pause mWaitFramInterval.
      220          end.
      221          else
      222             if     mWaitProcEvent
      223                and not mBatchMode
      224             then
      225                process events .
      226     end.
      227   end procedure.
      228      procedure waitfram-show-this:
      229         define input  parameter iInterval as int64 no-undo.
      230         define variable vtime as int64 no-undo.
      231         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      232         mWaitFramInterval = iInterval.
      233         run waitfram-show (substitute("&1&2 &3&4" ,
      234                                       mWaitFramTextBeg ,
      235                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      236                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      237                                       mWaitFramTextEnd
      238                                      )
      239                           ).
      240      end.
      241      procedure WaitFramRunPause:
      242         define input  parameter iInterval as dec no-undo.
      243         define variable vStart  as datetime-tz no-undo.
      244         define variable vend    as datetime-tz no-undo.
      245         define variable vint as int64 no-undo.
      246         define variable vOk as logical no-undo.
      247         vStart = now.
      248         vend   = vStart.
      249         publish "WaitFramPause" (iInterval,output vOk).
      250         vend   =  now.
      251         vint = vend - vStart.
      252         vint = iInterval - vint / 1000.
      253         if     not mWaitFramStop
      254            and (   vint > 0
      255                 or (    not vOk
      256                     and iInterval eq ?
      257                     )
      258                 )
      259         then
      260            run waitfram-show-this (iInterval).
      261         vend   =  now.
      262         vint = vend - vStart.
      263         vint = iInterval - vint / 1000.
      264         if     not mWaitFramStop
      265            and vint > 0
      266         then do:
      267            run gbl/pause.p (vint * 1000).
      268         end.
      269         if iInterval ne ?
      270         then
      271            publish "WaitFramStop".
      272         waitfram-check-timeout().
      273      end.
      274      procedure WaitFramWaitFor:
      275         define input  parameter iInterval as dec no-undo.
      276         assign
      277            mWaitFramStartProc   = now
      278            mWaitFramStopUser    = no
      279            mWaitFramStopTimeOut = no
      280         .
      281         block-wait:
      282         do while not mWaitFramStop:
      283            run WaitFramRunPause (iInterval).
      284            if  waitfram-check-timeout()
      285            then do:
      286               leave block-wait.
      287            end.
      288         end.
      289         run waitfram-hide.
      290      end.
      291   procedure waitfram-join :
      292     define input  parameter p-line-1  as character no-undo .
      293     define input  parameter p-line-2  as character no-undo .
      294     define input  parameter p-line-3  as character no-undo .
      295     define output parameter p-message as character no-undo .
      296     do
      297     on error undo, return error return-value
      298     :
      299       assign
      300         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      303       .
      304     end.
      305   end procedure.
      306   function waitfram-join-function returns character
      307     (input p-line-1 as character
      308     ,input p-line-2 as character
      309     ,input p-line-3 as character
      310     ).
      311     define variable v-message as character no-undo .
      312     run waitfram-join in this-procedure
      313       (input  p-line-1
      314       ,input  p-line-2
      315       ,input  p-line-3
      316       ,output v-message
      317       ) .
      318     return v-message .
      319   end function .
      320   procedure proc-alt-shift-f2:
      321     if not ibs.th.gbl.gbl-var:rcode
      322   then
      323     run gbl\inidebug.p .
      324   end.
      325   procedure proc-alt-shift-f3:
      326     run gbl/prvssinf.p
      327       ( input this-procedure
      328       ) .
      329   end.
      330   define variable v-inform-launched as logical no-undo initial false .
      331   procedure proc-alt-shift-f4:
      332     define variable v-action as character no-undo .
      333     if v-inform-launched = false then do:
      334       assign
      335         v-inform-launched = true
      336       .
      337       run gbl/d-inform.w
      338         (  input self
      339         ,  input this-procedure
      340         , output v-action
      341         ) no-error .
      342       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      343       assign
      344         v-inform-launched = false
      345       .
      346     end.
      347   end.
      348   procedure proc-alt-f1:
      349     run gbl/corrhelp.p
      350       (input this-procedure
      351       ) .
      352   end .
      353   on alt-shift-f2 anywhere do:
      354     run proc-alt-shift-f2.
      355   end.
      356   on alt-shift-f3 anywhere do:
      357     run proc-alt-shift-f3 in this-procedure .
      358   end.
      359   on alt-shift-f4 anywhere do:
      360     run proc-alt-shift-f4 in this-procedure.
      361   end.
      362   on alt-f1 anywhere do:
      363     run proc-alt-f1 in this-procedure .
      364   end.
      365   DEFINE BUTTON B-exit AUTO-GO
      366        LABEL "&Ввод"
      367        SIZE 10 BY 1
      368        BGCOLOR 8 .
      369   DEFINE BUTTON B-Help
      370        LABEL "Помо&щь"
      371        SIZE 10 BY 1
      372        BGCOLOR 8 .
      373   DEFINE BUTTON b-quit AUTO-END-KEY
      374        LABEL "&Отмена"
      375        SIZE 10 BY 1
      376        BGCOLOR 8 .
      377   DEFINE VARIABLE fi-dens-max AS DECIMAL FORMAT "9.999" INITIAL 0
      378        LABEL "Максимальная плотность"
      379        VIEW-AS FILL-IN
      380        SIZE 10.63 BY 1.
      381   DEFINE VARIABLE fi-dens-min AS DECIMAL FORMAT "9.999" INITIAL 0
      382        LABEL "Минимальная плотность"
      383        VIEW-AS FILL-IN
      384        SIZE 10.63 BY 1.
      385   DEFINE FRAME Dialog-Frame
      386        b-quit AT ROW 1 COL 1
      387        B-exit AT ROW 1 COL 11
      388        B-Help AT ROW 1 COL 54.88
      389        fi-dens-min AT ROW 3.58 COL 50.01 RIGHT-ALIGNED
      390        fi-dens-max AT ROW 4.58 COL 50.01 RIGHT-ALIGNED
      391        SPACE(15.11) SKIP(0.74)
      392       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      393            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      394            TITLE "Диапазон плотности для топлива"
      395            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      396   ASSIGN
      397          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      398          FRAME Dialog-Frame:HIDDEN           = TRUE.
      399   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      400   DO:
      401     APPLY "END-ERROR":U TO SELF.
      402   END.
      403   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      404   DO:
      405   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      406   if lookup(self :type
      407            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      408            ) = 0
      409   then do:
      410     message
      411       "$Workfile$"
      412       "Указанному интерфейсному элементу фокус не может быть передан" skip
      413       "Интерфейсный элемент" self :name  skip
      414       "Тип" self :type  skip
      415       "Процедура" this-procedure :file-name skip
      416       view-as alert-box .
      417   end.
      418   else do:
      419     apply "entry":u to self  .
      420     if focus :handle <> self :handle  then do:
      421       return no-apply .
      422     end.
      423   end.
      424     assign
      425        fi-dens-max fi-dens-min.
      426     run proc-go in this-procedure (fi-dens-min, fi-dens-max) no-error.
      427     if error-status:error then return no-apply.
      428   END.
      429   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      430   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      431   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   on help of frame Dialog-Frame
      433   do:
      434     run gbl/app_help.p
      435       (input this-procedure :file-name
      436       ,input ''
      437       ,input ?
      438       ) no-error.
      439     if error-status :error then do:
      440       message
      441         "Ошибка при вызове помощи"
      442         error-status :get-message(1)
      443         view-as alert-box .
      444     end.
      445   end.
      446   run minbtn-set in this-procedure .
      447   on choose of b-help in frame Dialog-Frame
      448   do:
      449     apply "help":u to frame Dialog-Frame .
      450   end.
      451   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      452   procedure minbtn-set :
      453       do
      454           on error undo, return error return-value
      455           :
      456           define variable ii              as integer       no-undo .
      457           define variable fh              as widget-handle no-undo .
      458           define variable hh              as widget-handle no-undo .
      459           define variable v-h             as handle        extent 4 no-undo .
      460           define variable v-name-button   as character     no-undo .
      461           define variable v-help-old-x    as decimal       no-undo .
      462           define variable v-help-old-y    as decimal       no-undo .
      463           define variable v-help-old-size as decimal       no-undo .
      464           define variable v-frame-width   as decimal       no-undo .
      465           define variable jj              as integer       no-undo .
      466           do
      467               on error undo, return error
      468               :
      469               assign
      470                   v-frame-width = frame Dialog-Frame:width - 0.3
      471                   fh            = frame Dialog-Frame:first-child
      472                   hh            = fh:first-child
      473                   ii            = 1
      474                   .
      475               do while valid-handle(hh):
      476                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      477                   do:
      478                       case lc(hh:name) :
      479                           when "b-help" then
      480                               do:
      481                                   hh:load-image-up("cmp/b-help.bmp":u) .
      482                                   hh:load-image-down("cmp/b-help.bmp":u) .
      483                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      484                                   hh:TOOLTIP = "Помощь" .
      485                                   v-help-old-x = hh:column .
      486                                   v-help-old-y = hh:row    .
      487                                   v-help-old-size = hh:width .
      488                                   hh:width-chars = 2.5 .
      489                               end.
      490                           when "b-print" then
      491                               do:
      492                                   hh:load-image("cmp/b-print.bmp":u) .
      493                                   hh:TOOLTIP = "Печать" .
      494                                   v-h[ii] = hh:handle .
      495                                   ii = ii + 1 .
      496                                   hh:width-chars = 3 .
      497                               end.
      498                           when "b-history" or
      499                           when "b-hist" then
      500                               do:
      501                                   hh:load-image("cmp/b-hist.bmp":u) .
      502                                   hh:TOOLTIP = "История" .
      503                                   v-h[ii] = hh:handle .
      504                                   ii = ii + 1 .
      505                                   hh:width-chars = 3 .
      506                               end.
      507                           when "b-sch" then
      508                               do:
      509                                   hh:load-image("cmp/b-sch.bmp":u) .
      510                                   hh:TOOLTIP = "Установка Фильтра" .
      511                                   v-h[ii] = hh:handle .
      512                                   ii = ii + 1 .
      513                                   hh:width-chars = 3 .
      514                               end.
      515                           when "b-hist-user" then
      516                               do:
      517                                   hh:load-image("cmp/b-hist.bmp":u) .
      518                                   hh:TOOLTIP = "История пользователя" .
      519                                   ii = ii + 1 .
      520                               end.
      521                       end case.
      522                   end.
      523                   hh = hh:next-sibling.
      524               end.
      525               b-help:column = v-frame-width - b-help:width-chars.
      526               jj = 0.
      527               repeat ii = 4 to 1 by -1 :
      528                   if valid-handle (v-h[ii] ) then
      529                   do:
      530                       jj  = jj + 1 .
      531                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      532                       v-h[ii]:row    = v-help-old-y .
      533                   end.
      534               end.
      535           end.
      536       end.
      537   end procedure.
      538   MAIN-BLOCK:
      539   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      540      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      541     find first buf_goods no-lock where
      542                    buf_goods.gds-code = p-gds-code no-error.
      543     RUN MYenable.
      544     WAIT-FOR GO OF FRAME Dialog-Frame.
      545   END.
      546   RUN disable_UI.
      547   PROCEDURE disable_UI :
      548     HIDE FRAME Dialog-Frame.
      549   END PROCEDURE.
      550   PROCEDURE enable_UI :
      551     DISPLAY fi-dens-min fi-dens-max
      552         WITH FRAME Dialog-Frame.
      553     ENABLE b-quit B-exit B-Help fi-dens-min fi-dens-max
      554         WITH FRAME Dialog-Frame.
      555     VIEW FRAME Dialog-Frame.
      556   END PROCEDURE.
      557   PROCEDURE MyeNABLe :
      558   IF AVAILABLE buf_goods then do:
      559   assign
      560   frame Dialog-Frame:title = frame Dialog-Frame:title + substitute(" код товара &1", p-gds-code).
      561   end.
      562   if num-entries(p-value, "-") > 2 then do:
      563     assign
      564     fi-dens-min = decimal(replace(substring(p-value, 1, 10), "кг\л", "":U))
      565     fi-dens-max = decimal(replace(substring(p-value, 12), "кг\л", "":U))
      566     .
      567   end.
      568   else do:
      569     assign
      570     fi-dens-min = decimal(replace(entry(1, p-value, "-":U ), "кг\л", "":U))
      571     fi-dens-max  = decimal(replace(entry(2, p-value, "-":U ), "кг\л":U, "":U))
      572     no-error .
      573   end.
      574     DISPLAY fi-dens-min fi-dens-max
      575         WITH FRAME Dialog-Frame.
      576     ENABLE b-quit B-exit B-Help fi-dens-min fi-dens-max
      577         WITH FRAME Dialog-Frame.
      578     VIEW FRAME Dialog-Frame.
      579   END PROCEDURE.
      580   PROCEDURE proc-go :
      581   define input parameter v-min-dens as decimal no-undo.
      582   define input parameter v-max-dens as decimal no-undo.
      583       if v-min-dens <> ? and
      584       v-min-dens > v-max-dens then do:
      585           message
      586           "Минимальная плотность не может быть больше максимальной. Плотности не могут быть заданы."
      587           view-as alert-box error.
      588           return error.
      589       end.
      590       if (v-min-dens = ? ) <> (v-max-dens = ?) then do:
      591         message
      592         "Нельзя задать только одну границу диапазона"
      593         view-as alert-box  error .
      594         return error .
      595       end.
      596       if v-min-dens <=0  or v-min-dens >= 1 then do:
      597         message
      598         "Минимальное значение плотности не может быть меньше 0 или больше 1"
      599         view-as alert-box  error .
      600         return error .
      601       end.
      602       if v-max-dens <=0  or v-max-dens >= 1 then do:
      603         message
      604         "Максимальное значение плотности не может быть меньше 0 или больше 1"
      605         view-as alert-box  error .
      606         return error .
      607       end.
      608   assign
      609   p-value = string(v-min-dens, "9.999") + "-":U + string(v-max-dens, "9.999 кг\л")
      610   .
      611   END PROCEDURE.
