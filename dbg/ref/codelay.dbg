        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define input  parameter Parparentproc  as handle    no-undo.
        6   define input  parameter iMode          as character no-undo.
        7   define input  parameter iParent        as character no-undo.
        8   define input  parameter iCode          as character no-undo.
        9   define input  parameter ititle         as character no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision:$":U .
       11   define variable vss-author      as character no-undo init "$Author:$":U .
       12   define variable vss-date        as character no-undo init "$Date:$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       14   define variable vss-archive     as character no-undo init "$Archive:$":U .
       15   define variable vss-description as character no-undo init "".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   function objExists return character
       71   (input  ifolder as character,
       72    input  iType   as character  ):
       73       define variable vFileType as character no-undo init "D,F".
       74       define variable vi        as integer no-undo.
       75       define variable vtype as character no-undo.
       76       if iType ne ?
       77       then
       78          vFileType = iType.
       79       do vi = 1 to num-entries(vFileType):
       80          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       81          vtype = file-information:file-type.
       82          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       83             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       84             index(vtype , entry(vi,vFileType )) > 0
       85          then return file-information:full-pathname .
       86          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       87          vtype = file-information:file-type.
       88          if file-information:file-name <> "" and
       89             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       90             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       91             index( vtype, entry(vi,vFileType )) > 0
       92          then return file-information:full-pathname .
       93       end.
       94       return ? .
       95   end.
       96   function SearchFile return character
       97   (input  ifile as character):
       98      return objExists(ifile,?).
       99   end.
      100   function SearchPFile return character
      101   (input inFile as char):
      102        define variable oFile       as character no-undo.
      103        define variable vFileSearch as character no-undo.
      104        define variable vNumEntry   as integer no-undo.
      105        if inFile = "" then return ?.
      106        vNumEntry = num-entries(inFile,".").
      107        vFileSearch = inFile.
      108        if    vNumEntry > 0
      109           and (   entry(vNumEntry,inFile,".") eq "p"
      110                or entry(vNumEntry,inFile,".") eq "w")
      111        then do:
      112           entry(vNumEntry,vFileSearch, ".") = "r".
      113           oFile = search(vFileSearch ).
      114           if oFile eq ?
      115           then
      116              oFile = search(inFile).
      117        end.
      118        else
      119           oFile = search(vFileSearch).
      120        return oFile.
      121     end.
      122   find first code where code.parent eq iparent
      123                     and code.code   eq icode
      124                     no-lock no-error.
      125   if     available code
      126      and code.procview ne ""
      127      and code.procview ne ?
      128      and SearchPFile(code.procview)  ne ?
      129   then do:
      130      run value( code.procview) (Parparentproc, imode, code.parent , code.code,Code.CodeName).
      131   end.
      132   else do on error undo, leave:
      133      define variable mCodeTrg as class ibs.th.ref.code.code_trg no-undo.
      134      mCodeTrg = new ibs.th.ref.code.code_trg(imode).
      135      mCodeTrg:codeProcViewSet(iparent, icode).
      136      mCodeTrg:parent = left-trim(iparent + chr(4) + icode,chr(4)).
      137      mCodeTrg:startlevel = num-entries(mCodeTrg:parent,chr(4)).
      138      mCodeTrg:parparentproc = Parparentproc.
      139      if ititle ne "" and ititle ne ?
      140      then mCodeTrg:title = entry(1,ititle,chr(4)).
      141      else if available code
      142      then mCodeTrg:title = code.codename.
      143      if num-entries(ititle,chr(4)) > 1 then
      144        mCodeTrg:filter = entry(2,ititle,chr(4)).
      145      mCodeTrg:brwcode().
      146      finally:
      147          delete object mCodeTrg.
      148      end finally.
      149   end.
