        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-deliv-type-code like ub.deliv-type-cond-keep.deliv-type-code no-undo .
        5   define input parameter p-cond-keep-code like ub.deliv-type-cond-keep.cond-keep-code no-undo .
        6   define input parameter p-des like ub.deliv-type-cond-keep.des no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: dlvtcnd1.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: ref/dlvtcnd1.p $":U .
       12   define variable vss-description as character no-undo init "Сохранение изменений в карточке возможности доставки по условиям хранения".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable v-db-num like ub.db.db-num no-undo .
       83   define buffer buf_delivery-type  for ub.delivery-type.
       84   define buffer buf_deliv-type-cond-keep  for ub.deliv-type-cond-keep.
       85   define buffer buf_condition-keeping  for ub.condition-keeping.
       86   if p-mode <> 'ДОБАВЛЕНИЕ':U
       87   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       88     message
       89     vss-workfile vss-revision vss-description skip
       90     "Неверный параметр p-mode" p-mode
       91     view-as alert-box error .
       92     return error '':u.
       93   end.
       94   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       96     (output v-db-num
       97     )  .
       98   if v-db-num <> 0 then do:
       99     run err-mess (substitute("Нельзя изменять запись ВОЗМОЖНОСТИ ДОСТАВКИ ПО УСЛОВИЯМ ХРАНЕНИЯ в УБД: Номер текущей БД &1"
      100                   , v-db-num) ).
      101     undo, return error "":U.
      102   end.
      103   find first buf_delivery-type no-lock where
      104               buf_delivery-type.deliv-type-code = p-deliv-type-code  no-error .
      105   if not available buf_delivery-type then do:
      106     run err-mess (substitute("Неправильная ссылка на ТИП ДОСТАВКИ, код типа доставки: &1"
      107                   , p-deliv-type-code) ).
      108     undo, return error "deliv-type-code":U.
      109   end.
      110   find first buf_condition-keeping no-lock where
      111               buf_condition-keeping.cond-keep-code = p-cond-keep-code  no-error .
      112   if not available buf_condition-keeping then do:
      113     run err-mess (substitute("Неправильная ссылка на УСЛОВИЯ ХРАНЕНИЯ, код условий хранения: &1"
      114                   , p-cond-keep-code) ).
      115     undo, return error "deliv-subj-code":U.
      116   end.
      117   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      118     find first buf_deliv-type-cond-keep no-lock where
      119               buf_deliv-type-cond-keep.deliv-type-code = p-deliv-type-code
      120           AND buf_deliv-type-cond-keep.cond-keep-code = p-cond-keep-code
      121                 no-error .
      122     if available buf_deliv-type-cond-keep then do:
      123       run err-mess (substitute("Уже есть запись ВОЗМОЖНОСТИ  ДОСТАВКИ ПО УСЛОВИЯМ ХРАНЕНИЯ, у которой код типа доставки: &1 и код условий хранения: &2"
      124                     , p-deliv-type-code
      125                     , p-cond-keep-code) ).
      126       undo, return error "deliv-type-code":U.
      127     end.
      128   end.
      129   _MAIN:
      130   DO ON ERROR UNDO, RETURN ERROR
      131   ON STOP UNDO, RETURN ERROR:
      132     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      133       create ub.deliv-type-cond-keep.
      134       assign
      135       ub.deliv-type-cond-keep.deliv-type-code = p-deliv-type-code
      136       ub.deliv-type-cond-keep.cond-keep-code = p-cond-keep-code
      137       p-doc-rec = recid(ub.deliv-type-cond-keep)
      138       .
      139     end.
      140     else do:
      141       FIND FIRST ub.deliv-type-cond-keep where
      142                 recid(ub.deliv-type-cond-keep) = p-doc-rec No-ERROR.
      143       if not available ub.deliv-type-cond-keep then do:
      144         message
      145         vss-workfile vss-revision vss-description skip
      146         "Не найдена запись ВОЗМОЖНОСТИ ДОСТАВКИ ПО УСЛОВИЯМ ХРАНЕНИЯ - p-doc-rec" p-doc-rec
      147         view-as alert-box error .
      148         undo, return error '':u.
      149       end.
      150       if ub.deliv-type-cond-keep.deliv-type-code <> p-deliv-type-code
      151       then do:
      152         message
      153         vss-workfile vss-revision vss-description skip
      154         "Для уже имеющейся записи нельзя изменить"
      155         "внутренний код типа доставки" skip
      156         view-as alert-box ERROR.
      157         undo, return error '':U.
      158       end.
      159       if ub.deliv-type-cond-keep.cond-keep-code <> p-cond-keep-code
      160       then do:
      161         message
      162         vss-workfile vss-revision vss-description skip
      163         "Для уже имеющейся записи нельзя изменить"
      164         "внутренний код условий хранения" skip
      165         view-as alert-box ERROR.
      166         undo, return error '':U.
      167       end.
      168     end.
      169     assign
      170     ub.deliv-type-cond-keep.des                 = p-des
      171     ub.deliv-type-cond-keep.sts                 =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      172                                then 0
      173                                else ub.deliv-type-cond-keep.sts)
      174     .
      175     release ub.deliv-type-cond-keep no-error.
      176     if error-status:error then do:
      177        run err-mess(substitute("Ошибка при сохранении записи ВОЗМОЖНОСТЬ ДОСТАВКИ ПО УСЛОВИЯМ ХРАНЕНИЯ: тип доставки &1, код условий хранения &2: &3: &4"
      178                                , p-deliv-type-code
      179                                , p-cond-keep-code
      180                                , ERROR-STATUS:GET-message(1)
      181                                , return-value
      182                                )).
      183       undo, return error "":U.
      184    end.
      185   end.
      186   PROCEDURE err-mess:
      187     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      188         message
      189         p-mess
      190         view-as alert-box error .
      191   END PROCEDURE.
