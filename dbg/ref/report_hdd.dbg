        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: c188d6f80d33, 2331, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: druban $":U .
        4   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:32 2020 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: report_hdd.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: ref/report_hdd.p $":U .
        7   define variable vss-description as character no-undo init "".
        8   SESSION:ERROR-STACK-TRACE=YES.
        9   define input  parameter parparentproc as handle no-undo .
       10   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       11   define temp-table userobjs_temp-user-obj no-undo
       12     field obj-type as character
       13     field obj-code as integer
       14     index xpk is primary unique obj-type obj-code
       15     .
       16   procedure userobjs_clear :
       17     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       18     do
       19     on error undo, return error return-value
       20     :
       21       for each buf_userobjs_temp-user-obj
       22       on error undo, return error return-value
       23       :
       24         delete buf_userobjs_temp-user-obj .
       25       end.
       26     end.
       27   end .
       28   procedure userobjs_object-count :
       29     define output parameter p-total-count as integer   no-undo .
       30     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       31     do
       32     on error undo, return error return-value
       33     :
       34       assign
       35         p-total-count = 0
       36       .
       37       for each buf_userobjs_temp-user-obj
       38       on error undo, return error return-value
       39       :
       40         assign
       41           p-total-count = p-total-count + 1
       42         .
       43       end.
       44     end.
       45   end.
       46   procedure userobjs_append :
       47      define input  parameter p-obj-type as character no-undo .
       48      define input  parameter p-obj-code as integer   no-undo .
       49     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       50     do
       51     on error undo, return error return-value
       52     :
       53       find first buf_userobjs_temp-user-obj
       54         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
       55           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
       56         no-error .
       57       if not available buf_userobjs_temp-user-obj
       58       then do:
       59         create buf_userobjs_temp-user-obj .
       60         assign
       61           buf_userobjs_temp-user-obj.obj-type = p-obj-type
       62           buf_userobjs_temp-user-obj.obj-code = p-obj-code
       63         .
       64       end.
       65     end.
       66   end.
       67   procedure userobjs_object-exist :
       68     define output parameter p-object-exist as logical   no-undo .
       69     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       70     do
       71     on error undo, return error return-value
       72     :
       73       find first buf_userobjs_temp-user-obj
       74         no-error .
       75       if not available buf_userobjs_temp-user-obj
       76       then do:
       77         assign
       78           p-object-exist = false
       79         .
       80       end.
       81       else do:
       82         assign
       83           p-object-exist = true
       84         .
       85       end.
       86     end.
       87   end.
       88   procedure userobjs_transfer :
       89     define input  parameter p-callback-handle as handle no-undo .
       90     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
       91     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       92     do
       93     on error undo, return error return-value
       94     :
       95       if valid-handle(p-callback-handle) <> true
       96       then do:
       97         message
       98           vss-workfile vss-revision vss-description skip
       99           "Ошибка задания входных параметров" skip
      100           "Неизвестный указатель на процедуру" skip
      101           view-as alert-box error .
      102         undo, return error return-value .
      103       end.
      104       if p-callback-handle :get-signature("userobjs_append") = ""
      105       then do:
      106         message
      107           vss-workfile vss-revision vss-description skip
      108           "Ошибка задания входных параметров" skip
      109           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      110                     ,p-callback-handle :file-name
      111                     ) skip
      112           view-as alert-box error .
      113         undo, return error return-value .
      114       end.
      115       for each buf_userobjs_temp-user-obj
      116       on error undo, return error return-value
      117       :
      118         run userobjs_append in p-callback-handle
      119           (input  buf_userobjs_temp-user-obj.obj-type
      120           ,input  buf_userobjs_temp-user-obj.obj-code
      121           ) .
      122       end.
      123     end.
      124   end procedure.
      125   procedure userobjs_select-one :
      126      define input  parameter parparentproc     as widget-handle no-undo .
      127      define input  parameter p-db-num          as integer   no-undo .
      128      define input  parameter p-user-id         as character no-undo .
      129      define input  parameter p-host-code-obj   as integer   no-undo .
      130      define input  parameter p-obj-type        as character no-undo .
      131      define input  parameter p-obj-code        as integer   no-undo .
      132      define output parameter p-user-select     as logical   no-undo .
      133      define output parameter p-select-obj-type as character no-undo .
      134      define output parameter p-select-obj-code as character no-undo .
      135     do
      136     on error undo, return error return-value
      137     :
      138       run gbl/userobjs.w
      139         (input  parparentproc
      140         ,input  this-procedure :handle
      141         ,input  p-db-num
      142         ,input  p-user-id
      143         ,input  p-host-code-obj
      144         ,input  p-obj-type
      145         ,input  p-obj-code
      146         ,INPUT  "b-sel"
      147         ,output p-user-select
      148         ,output p-select-obj-type
      149         ,output p-select-obj-code
      150         ) .
      151     end.
      152   end.
      153   procedure userobjs_select-many :
      154     define input  parameter parparentproc   as widget-handle no-undo .
      155     define input  parameter p-db-num        as integer   no-undo .
      156     define input  parameter p-user-id       as character no-undo .
      157     define input  parameter p-host-code-obj as integer   no-undo .
      158     define input  parameter p-obj-type      as character no-undo .
      159     define input  parameter p-obj-code      as integer   no-undo .
      160     define output parameter p-user-select   as logical   no-undo .
      161     define variable v-select-obj-type as character no-undo .
      162     define variable v-select-obj-code as integer   no-undo .
      163     do
      164     on error undo, return error return-value
      165     :
      166       run gbl/userobjs.w
      167         (input  parparentproc
      168         ,input  this-procedure :handle
      169         ,input  p-db-num
      170         ,input  p-user-id
      171         ,input  p-host-code-obj
      172         ,input  p-obj-type
      173         ,input  p-obj-code
      174         ,INPUT  "b-sel,b-mark"
      175         ,output p-user-select
      176         ,output v-select-obj-type
      177         ,output v-select-obj-code
      178         ) .
      179     end.
      180   end.
      181   procedure thobjs :
      182      define input        parameter parparentproc     as widget-handle no-undo .
      183      define input        parameter i-bttns           as character     no-undo .
      184      define input        parameter i-list-mode       as character     no-undo.
      185      define input        parameter i-obj-type        as character     no-undo.
      186      define input        parameter i-db-num          as integer       no-undo.
      187      define input        parameter i-host-code       as integer       no-undo.
      188      define input-output parameter p-rid-list        as character     no-undo .
      189   run ref/thobjs.p
      190           ( input parparentproc
      191            ,input  this-procedure :handle
      192           , input i-bttns
      193           , input i-list-mode
      194           , input i-obj-type
      195           , input i-db-num
      196           , input i-host-code
      197           , input-output p-rid-list ) no-error .
      198   end.
