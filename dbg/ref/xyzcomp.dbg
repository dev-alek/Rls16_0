        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: xyzcomp.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: ref/xyzcomp.p $":U .
        8   define variable vss-description as character no-undo init "Сравнение XYZ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79     define variable v-cntxt-db-num        as integer   no-undo .
       80     define variable v-cntxt-userid        as character no-undo .
       81     define variable v-cntxt-level         as character no-undo .
       82     define variable v-cntxt-host-code-obj as integer   no-undo .
       83     define variable v-cntxt-obj-type      as character no-undo .
       84     define variable v-cntxt-obj-code      as integer   no-undo .
       85     define variable v-cntxt-db-num-obj    as integer   no-undo .
       86     define variable v-cntxt-is-admin      as logical   no-undo .
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88     run mainmenu_getcntxt in parparentproc
       89       (output v-cntxt-db-num
       90       ,output v-cntxt-userid
       91       ,output v-cntxt-level
       92       ,output v-cntxt-host-code-obj
       93       ,output v-cntxt-obj-type
       94       ,output v-cntxt-obj-code
       95       ,output v-cntxt-db-num-obj
       96       ,output v-cntxt-is-admin
       97       ) .
       98     define variable p-rez as character no-undo .
       99       run ref/xyzanal.w
      100         ( input parParentProc , input "b-sel,b-mark" , output p-rez) no-error .
      101    if num-entries(p-rez) < 2 then do:
      102       message
      103       "Должно быть отмечено более одного анализа !!!"
      104       view-as alert-box information .
      105       return .
      106    end.
      107   define variable var-i as integer   no-undo .
      108   define variable var-kol as integer   no-undo .
      109   var-kol = num-entries (p-rez).
      110   define buffer buf1_xyz-analysis for ub.xyz-analysis.
      111   define buffer buf_xyz-analysis for ub.xyz-analysis.
      112   define variable g-ok as logical   no-undo .
      113   define variable g1 as logical   no-undo init false  .
      114   define variable g2 as logical   no-undo init false .
      115   define variable g3 as logical   no-undo init false .
      116   define variable g4 as logical   no-undo init false .
      117   find first buf1_xyz-analysis no-lock where recid(buf1_xyz-analysis) = int(entry(1,p-rez )) no-error .
      118   repeat var-i = 1 to var-kol :
      119      find first buf_xyz-analysis no-lock where recid(buf_xyz-analysis) = int(entry(var-i,p-rez )) no-error .
      120       if buf_xyz-analysis.cral-id <> buf1_xyz-analysis.cral-id and g1 = false  then do:
      121           message
      122               "Есть несоответствия по критерию анализа. " skip
      123               "Продолжать сравнение ?"
      124               view-as alert-box question
      125               button yes-no
      126               update g-ok .
      127               if g-ok = false then return .
      128               else g1 = true .
      129       end.
      130       if buf_xyz-analysis.xyz-hash-string-obj <> buf1_xyz-analysis.xyz-hash-string-obj and g2 = false then do:
      131           message
      132               "Есть несоответствия по списку объектов. " skip
      133               "Продолжать сравнение ?"
      134               view-as alert-box question
      135               button yes-no
      136               update g-ok .
      137               if g-ok = false then return .
      138               else g2 = true .
      139       end.
      140       if buf_xyz-analysis.xyz-hash-string-doc <> buf1_xyz-analysis.xyz-hash-string-doc and g3 = false then do:
      141           message
      142               "Есть несоответствия по списку типов документов. " skip
      143               "Продолжать сравнение ?"
      144               view-as alert-box question
      145               button yes-no
      146               update g-ok .
      147               if g-ok = false then return .
      148               else g3 = true .
      149       end.
      150       if buf_xyz-analysis.xyz-hash-string-period <> buf1_xyz-analysis.xyz-hash-string-period and g4 = false  then do:
      151           message
      152               "Есть несоответствия по списку периодов. " skip
      153               "Продолжать сравнение ?"
      154               view-as alert-box question
      155               button yes-no
      156               update g-ok .
      157               if g-ok = false then return .
      158               else g4 = true .
      159       end.
      160   end.
      161   define variable v-user-name as character no-undo .
      162   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      163   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      164     (input  v-cntxt-userid
      165     ,output v-user-name
      166     )  .
      167   run ref/prexxyz.p (input  parParentProc ,input  p-rez , input v-user-name)  no-error .
