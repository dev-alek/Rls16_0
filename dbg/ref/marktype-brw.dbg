      125   procedure cur-time :
      126      define output parameter p-today as date      no-undo .
      127      define output parameter p-time  as integer   no-undo .
      128     do
      129     on error undo, return error
      130     :
      131       define variable v-date1 as date      no-undo .
      132       define variable v-date2 as date      no-undo .
      133       define variable v-time  as integer   no-undo .
      134       assign
      135         v-date1 = today
      136         v-time  = time
      137         v-date2 = today
      138       .
      139       if v-date1 <> v-date2
      140       then do:
      141         assign
      142           v-date1 = today
      143           v-time  = v-time
      144         .
      145       end.
      146       assign
      147         p-today = v-date1
      148         p-time  = v-time
      149       .
      150     end.
      151   end.
      152   function cur-time-date returns character
      153   :
      154     return string(today, '99/99/9999':U) .
      155   end.
      156   function cur-time-mjd returns decimal
      157   :
      158     define variable v-date as date      no-undo .
      159     define variable v-time as integer   no-undo .
      160     run cur-time in this-procedure
      161       (output v-date
      162       ,output v-time
      163       ) .
      164     return integer(v-date) - 2400002 + (v-time / 86400) .
      165   end.
      166   function cur-time-get-ending-index returns integer
      167   (input p-number as integer
      168   )
      169   :
      170     if p-number < 0
      171     or p-number = ?
      172     then do:
      173       return 1 .
      174     end.
      175     define variable v-rest as integer   no-undo .
      176     assign
      177       p-number = p-number modulo 100
      178     .
      179     if p-number < 20
      180     then do:
      181       assign
      182         v-rest = p-number
      183       .
      184     end.
      185     else do:
      186       assign
      187         v-rest = p-number modulo 10
      188       .
      189     end.
      190     case v-rest :
      191       when 1
      192       then do:
      193         return 2 .
      194       end.
      195       when 2 or
      196       when 3 or
      197       when 4
      198       then do:
      199         return 3 .
      200       end.
      201       otherwise do:
      202         return 1 .
      203       end.
      204     end case .
      205   end.
      206   procedure cur-time-mjd-to-date :
      207      define input  parameter i-mjd-diff as decimal no-undo.
      208      define output parameter o-Date     as date    no-undo.
      209      define output parameter o-Time     as integer no-undo.
      210      define variable v-day-number as integer   no-undo .
      211      if    i-mjd-diff < 0
      212         or i-mjd-diff = ?
      213      then do:
      214         return "?" .
      215      end.
      216      assign
      217         v-day-number = truncate(i-mjd-diff,0).
      218         o-Date = date(v-day-number + 2400002).
      219         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      220     .
      221   end.
      222   function cur-time-mjd-to-string returns character
      223   (input p-mjd-diff as decimal
      224   )
      225   :
      226     define variable v-day-number as integer   no-undo .
      227     define variable v-seconds    as integer   no-undo .
      228     define variable v-hour       as integer   no-undo .
      229     define variable v-min        as integer   no-undo .
      230     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      231     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      232     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      233     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      234     if p-mjd-diff < 0
      235     or p-mjd-diff = ?
      236     then do:
      237       return "?" .
      238     end.
      239     assign
      240       v-day-number = integer(truncate(p-mjd-diff,0))
      241       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      242     .
      243     if v-seconds > 86400
      244     then do:
      245       assign
      246         v-seconds = 86400 - 1
      247       .
      248     end.
      249     if v-seconds < 0
      250     then do:
      251       assign
      252         v-seconds = 0
      253       .
      254     end.
      255     assign
      256       v-hour = truncate(v-seconds / 3600, 0)
      257     .
      258     assign
      259       v-seconds = v-seconds modulo 3600
      260     .
      261     assign
      262       v-min = truncate(v-seconds / 60, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 60
      266     .
      267     return
      268         (if v-day-number <> 0
      269           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      270           else ""
      271         )
      272       + (if v-day-number <> 0 or v-hour <> 0
      273           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      274           else ""
      275         )
      276       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      277           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      278           else ""
      279         )
      280       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      281       .
      282   end.
      283   function cur-time-string returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-string-sec returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      302   end.
      303   function cur-time-custom  returns character
      304   (input p-prefix as character
      305   ,input p-date-format as character
      306   ,input p-delimiter as character
      307   ,input p-time-format as character
      308   ,input p-suffix as character
      309   )
      310   :
      311     define variable v-date as date      no-undo .
      312     define variable v-time as integer   no-undo .
      313     run cur-time in this-procedure
      314       (output v-date
      315       ,output v-time
      316       ) .
      317     return
      318       p-prefix
      319       + string(v-date, p-date-format)
      320       + p-delimiter
      321       + string(v-time, p-time-format)
      322       + p-suffix
      323       .
      324   end.
      325   function cur-time-print  returns character
      326   :
      327     define variable v-date as date      no-undo .
      328     define variable v-time as integer   no-undo .
      329     run cur-time in this-procedure
      330       (output v-date
      331       ,output v-time
      332       ) .
      333     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      334   end.
      335   function cur-time-datetime returns datetime
      336   :
      337     define variable v-char as character no-undo .
      338     define variable v-datetime as datetime no-undo .
      339     v-char = cur-time-string().
      340     v-datetime = datetime(v-char).
      341     return  v-datetime.
      342   end.
      343   function cur-time-string-msec returns character
      344   :
      345     define variable v-date as datetime  no-undo .
      346     v-date = now.
      347     return string(v-date) .
      348   end.
      349   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350     define variable v-cntxt-db-num        as integer   no-undo .
