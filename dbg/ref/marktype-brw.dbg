      573   then
      574      mBatchMode = yes.
      575   if mBatchMode = ? then do:
      576     mVisCUrentVin = current-window:visible.
      577     mFameOldVis = mFramBachModHandle:visible.
      578     mFramBachModHandle:visible  = yes.
      579     mBatchMode = mFramBachModHandle:visible ne yes.
      580     mFramBachModHandle:visible = mFameOldVis.
      581     current-window:visible = mVisCUrentVin.
      582   end.
      583    if  log-manager:logfile-name ne ?
      584     then DO:
      585         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      586         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      587         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      588     end.
      589   on choose of B-WaitFramStop in frame waitfram
      590   do:
      591     mWaitFramStop = yes.
      592     mWaitFramStopUser = yes.
      593   end.
      594   function waitfram-check-timeout returns logical():
      595      define variable vtime as int64 no-undo.
      596      if mWaitFramStopTimeOut
      597      then
      598         return yes.
      599      vtime = ( now - mWaitFramStartProc ) / 1000 .
      600      if     mWaitFramTimeOut ne ?
      601         and mWaitFramTimeOut ne 0
      602         and mWaitFramTimeOut lt vtime
      603      then do:
      604         mWaitFramStopTimeOut = yes.
      605      end.
      606      return mWaitFramStopTimeOut.
      607   end.
      608   procedure waitfram-hide :
      609     if not session:batch-mode
      610     then do
      611     on error undo, return error return-value
      612     :
      613       pause 0 before-hide .
      614       if not mBatchMode then
      615         hide frame waitfram .
      616     if     not mWaitFramView
      617        and mWaitProcEvent
      618     then
      619       process events .
      620     end.
      621   end procedure.
      622   procedure waitfram-show :
      623     define input  parameter p-message as character no-undo .
      624     define variable v-left-margin as integer   no-undo .
      625     if not session:batch-mode
      626     then do
      627     on error undo, return error return-value
      628     :
      629       if length(p-message) <= 70 then do:
      630         assign
      631           v-left-margin = integer((70 - length(p-message)) / 2)
      632         .
      633         assign
      634           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      635         .
      636         assign
      637           v-waitfram-action01 = " "
      638           v-waitfram-action02 = " "
      639                                    + fill(" ", v-left-margin)
      640                                    + p-message
      641           v-waitfram-action03 = " "
      642         .
      643       end.
      644       else do:
      645         define variable vRindex1 as integer no-undo.
      646         define variable vRindex2 as integer no-undo.
      647         vRindex1 = r-index(p-message," ",70).
      648         if vRindex1 = 0
      649         then
      650            vRindex1 = 70.
      651         if length(p-message)  <= vRindex1 + 70 then do:
      652           assign
      653             v-waitfram-action01 = " "
      654             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      655             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      656           .
      657         end.
      658         else do:
      659           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      660           if vRindex2 <= vRindex1
      661           then
      662              vRindex2 = vRindex1 + 70.
      663           assign
      664             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      665             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      666             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      667           .
      668         end.
      669       end.
      670       B-viewProcInfo:visible   in frame waitfram = no.
      671       B-viewProcInfo:sensitive in frame waitfram = no.
      672       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      673       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      674       if  (   mWaitFramView
      675          or  mWaitProcEvent)
      676          and not mBatchMode
      677       then
      678          display
      679             v-waitfram-action01 skip
      680             v-waitfram-action02 skip
      681             v-waitfram-action03 skip
      682          with frame waitfram .
      683       if     mWaitFramView
      684          then do:
      685             if     mWaitFramInterval ne ?
      686                and not mBatchMode
      687             then
      688                wait-for go of frame waitfram pause mWaitFramInterval.
      689          end.
      690          else
      691             if     mWaitProcEvent
      692                and not mBatchMode
      693             then
      694                process events .
      695     end.
      696   end procedure.
      697      procedure waitfram-show-this:
      698         define input  parameter iInterval as int64 no-undo.
      699         define variable vtime as int64 no-undo.
      700         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      701         mWaitFramInterval = iInterval.
      702         run waitfram-show (substitute("&1&2 &3&4" ,
      703                                       mWaitFramTextBeg ,
      704                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      705                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      706                                       mWaitFramTextEnd
      707                                      )
      708                           ).
      709      end.
      710      procedure WaitFramRunPause:
      711         define input  parameter iInterval as dec no-undo.
      712         define variable vStart  as datetime-tz no-undo.
      713         define variable vend    as datetime-tz no-undo.
      714         define variable vint as int64 no-undo.
      715         define variable vOk as logical no-undo.
      716         vStart = now.
      717         vend   = vStart.
      718         publish "WaitFramPause" (iInterval,output vOk).
      719         vend   =  now.
      720         vint = vend - vStart.
      721         vint = iInterval - vint / 1000.
      722         if     not mWaitFramStop
      723            and (   vint > 0
      724                 or (    not vOk
      725                     and iInterval eq ?
      726                     )
      727                 )
      728         then
      729            run waitfram-show-this (iInterval).
      730         vend   =  now.
      731         vint = vend - vStart.
      732         vint = iInterval - vint / 1000.
      733         if     not mWaitFramStop
      734            and vint > 0
      735         then do:
      736            run gbl/pause.p (vint * 1000).
      737         end.
      738         if iInterval ne ?
      739         then
      740            publish "WaitFramStop".
      741         waitfram-check-timeout().
      742      end.
      743      procedure WaitFramWaitFor:
      744         define input  parameter iInterval as dec no-undo.
      745         assign
      746            mWaitFramStartProc   = now
      747            mWaitFramStopUser    = no
      748            mWaitFramStopTimeOut = no
      749         .
      750         block-wait:
      751         do while not mWaitFramStop:
      752            run WaitFramRunPause (iInterval).
      753            if  waitfram-check-timeout()
      754            then do:
      755               leave block-wait.
      756            end.
      757         end.
      758         run waitfram-hide.
      759      end.
      760   procedure waitfram-join :
      761     define input  parameter p-line-1  as character no-undo .
      762     define input  parameter p-line-2  as character no-undo .
      763     define input  parameter p-line-3  as character no-undo .
      764     define output parameter p-message as character no-undo .
      765     do
      766     on error undo, return error return-value
      767     :
      768       assign
      769         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      770                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      771                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      772       .
      773     end.
      774   end procedure.
      775   function waitfram-join-function returns character
      776     (input p-line-1 as character
      777     ,input p-line-2 as character
      778     ,input p-line-3 as character
      779     ).
      780     define variable v-message as character no-undo .
      781     run waitfram-join in this-procedure
      782       (input  p-line-1
      783       ,input  p-line-2
      784       ,input  p-line-3
      785       ,output v-message
      786       ) .
      787     return v-message .
      788   end function .
      789   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   FUNCTION mark-string RETURNS CHARACTER
      791     ( input p-recid as recid, input mark-list as character  ) :
      792     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      793   END FUNCTION.
      794   define variable log-res     as log       no-undo.
      795   define variable v-rid       as recid     no-undo .
      796   define variable v-db-num like ub.db.db-num no-undo .
      797   define variable vIsUpdated as logical no-undo.
      798   define stream out-xml.
      799   DEFINE BUTTON b-add
      800        LABEL "&Добавить":L
      801        SIZE 10 BY 1.
      802   DEFINE BUTTON b-del
      803        LABEL "&Удалить":L
      804        SIZE 10 BY 1.
      805   DEFINE BUTTON b-exit AUTO-GO
      806        LABEL "&Выход ":L
      807        SIZE 10 BY 1.
      808   DEFINE BUTTON b-help
      809        LABEL "Помо&щь":L
      810        SIZE 3 BY 1.
      811   DEFINE BUTTON b-print
      812        LABEL "Пе&чать":L
      813        SIZE 3 BY 1.
      814   DEFINE BUTTON b-upd
      815        LABEL "&Изменить":L
      816        SIZE 10 BY 1.
      817   DEFINE BUTTON b-xml
      818        LABEL "Выгрузить"
      819        SIZE 14 BY 1.
      820   DEFINE QUERY BROWSE-5 FOR
      821         tt_code SCROLLING.
      822   DEFINE BROWSE BROWSE-5
      823     QUERY BROWSE-5 NO-LOCK DISPLAY
      824         tt_code.code FORMAT "x(6)":U
      825         tt_code.CodeValue FORMAT "x(20)":U WIDTH 19.4
      826         tt_code.CodeName FORMAT "x(60)":U WIDTH 59.2
      827         INTEGER (tt_code.misc1) COLUMN-LABEL "Длина!серийного!номера" FORMAT ">>>>9":U
      828               WIDTH 12.2
      829         if logical(tt_code.misc2) then "+" else "-" COLUMN-LABEL "Конфигурация!для кассы" FORMAT "X":U
      830         string(int(tt_code.misc4),"HH:MM") + " " + replace(tt_code.misc3,"/", ".") COLUMN-LABEL "Дата/ Время" FORMAT "X(16)":U
      831               WIDTH 11
      832       WITH NO-ROW-MARKERS SEPARATORS SIZE 131 BY 17.62 ROW-HEIGHT-CHARS .76 FIT-LAST-COLUMN.
      833   DEFINE FRAME f-okei2
      834        b-exit AT ROW 1 COL 1
      835        b-add AT ROW 1 COL 14
      836        b-upd AT ROW 1 COL 24
      837        b-del AT ROW 1 COL 34 WIDGET-ID 2
      838        b-xml AT ROW 1 COL 44 WIDGET-ID 6
      839        b-print AT ROW 1 COL 122
      840        b-help AT ROW 1 COL 128
      841        BROWSE-5 AT ROW 2.91 COL 1 WIDGET-ID 300
      842        SPACE(0.19) SKIP(0.00)
      843       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      844            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      845            TITLE "Типы маркировки":L.
      846   ASSIGN
      847          FRAME f-okei2:SCROLLABLE       = FALSE.
      848   ON END-ERROR OF FRAME f-okei2
      849   DO:
      850       run checkChanges in this-procedure no-error.
      851       if error-status:error then return no-apply.
      852   END.
      853   ON go OF FRAME f-okei2
      854   do:
      855       run checkChanges in this-procedure no-error.
      856       if error-status:error then return no-apply.
      857   end.
      858   ON choose OF b-add IN FRAME f-okei2
      859   do:
      860      define variable vCode      as character no-undo.
      861      define variable vCodeValue as character no-undo.
      862      define variable vCodeName  as character no-undo.
      863      define variable vMisc1     as character no-undo.
      864      define variable vMisc2     as character no-undo.
      865      define variable vMisc3     as character no-undo.
      866      define variable vMisc4     as character no-undo.
      867      define variable vId        as rowid     no-undo.
      868      define buffer buf_tt_code for tt_code.
      869      for last buf_tt_code no-lock
      870               by int(buf_tt_code.code):
      871          vCode = string(int(buf_tt_code.code) + 1).
      872      end.
      873      run ref/marktype.p (
      874                                   input parparentproc
      875                                 , input 'ДОБАВЛЕНИЕ':U
      876                                 , input-output vCode
      877                                 , input-output vCodeValue
      878                                 , input-output vCodeName
      879                                 , input-output vMisc1
      880                                 , input-output vMisc2
      881                                 , input-output vMisc3
      882                                 , input-output vMisc4
      883                                 , output vIsUpdated
      884                          ).
      885      find first buf_tt_code where
      886                 buf_tt_code.code = vCode
      887           no-lock no-error.
      888      if avail buf_tt_code then
      889      do:
      890        message
      891           "Ошибка добавления" skip
      892           "В справочнике уже есть тип маркировки с кодом " buf_tt_code.code "."
      893           view-as alert-box.
      894        return no-apply.
      895      end.
      896      find first buf_tt_code where
      897                 buf_tt_code.code = vCodeValue
      898           no-lock no-error.
      899      if avail buf_tt_code then
      900      do:
      901        message
      902           "Ошибка добавления" skip
      903           "В справочнике уже есть тип маркировки со значением " buf_tt_code.code "."
      904           view-as alert-box.
      905        return no-apply.
      906      end.
      907      if vIsUpdated then
      908      do:
      909          create tt_code.
      910          assign
      911            tt_code.parent = "MarkType"
      912            tt_code.code      = vCode
      913            tt_code.codevalue = vCodeValue
      914            tt_code.codename  = vCodeName
      915            tt_code.misc1     = vMisc1
      916            tt_code.misc2     = vMisc2
      917            tt_code.misc3     = vMisc3
      918            tt_code.misc4     = vMisc4
      919            tt_code.export_ = yes
      920            tt_code.status_ = 0
      921            tt_code.nwsgbd = yes
      922            vId            = rowid(tt_code)
      923          .
      924         OPEN QUERY BROWSE-5 FOR EACH tt_code NO-LOCK     BY tt_code.code INDEXED-REPOSITION.
      925         reposition BROWSE-5 to rowid vId.
      926         apply "ENTRY" to BROWSE-5.
      927      end.
      928   end.
      929   ON choose OF b-del IN FRAME f-okei2
      930   do:
      931      define buffer buf_code for code.
      932      define buffer buf-goods-attr for ub.goods-attr.
      933      if not avail tt_code then return.
      934      define variable v-ok as logical no-undo.
      935      define variable vCode as int no-undo.
      936      vCode = int(tt_code.code) no-error.
      937      if vCode <> ? and vCode > 0 and vCode < 17 then do:
      938          message "Нельзя удалять зарезервированные типы маркировки" view-as alert-box.
      939          return no-apply.
      940      end.
      941      find first buf_code where
      942                 buf_code.parent = "MarkType"
      943             and buf_code.code   = tt_code.code
      944           no-lock no-error.
      945      if avail buf_code then
      946      do:
      947         message "Нельзя удалить тип марки уже загруженной в систему" view-as alert-box.
      948         return no-apply.
      949      end.
      950      find first  buf-goods-attr no-lock where
      951                  buf-goods-attr.attr-code = 'mark-type':U
      952              and buf-goods-attr.attr-value  = tt_code.codevalue
      953              no-error .
      954      if avail buf-goods-attr then do:
      955         message "Нельзя удалить тип маркировки, указанный для товара" view-as alert-box.
      956          return no-apply.
      957      end.
      958      message "Удалить запись Тип маркировки - Код:" tt_code.code "Наименование:" tt_code.codename "?"
      959         view-as alert-box question
      960         buttons yes-no
      961         title "Удаление"
      962         update v-ok .
      963      if not v-ok then return no-apply.
      964      do on error undo, return
      965      on stop undo, return:
      966         delete tt_code.
      967         OPEN QUERY BROWSE-5 FOR EACH tt_code NO-LOCK     BY tt_code.code INDEXED-REPOSITION.
      968         apply "ENTRY" to BROWSE-5.
      969         reposition BROWSE-5 to row 1.
      970      end.
      971   end.
      972   ON choose OF b-upd IN FRAME f-okei2
      973   do:
      974      define variable vCode      as character no-undo.
      975      define variable vCodeValue as character no-undo.
      976      define variable vCodeName  as character no-undo.
      977      define variable vMisc1     as character no-undo.
      978      define variable vMisc2     as character no-undo.
      979      define variable vMisc3     as character no-undo.
      980      define variable vMisc4     as character no-undo.
      981      define buffer buf_tt_code for tt_code.
      982      if not avail tt_code then return.
      983      assign
      984         vCode      = tt_code.code
      985         vCodeValue = tt_code.codevalue
      986         vCodeName  = tt_code.codename
      987         vMisc1     = tt_code.misc1
      988         vMisc2     = tt_code.misc2
      989         vMisc3     = tt_code.misc3
      990         vMisc4     = tt_code.misc4
      991      .
      992      run ref/marktype.p (
      993                                   input parparentproc
      994                                 , input 'ИЗМЕНЕНИЕ':U
      995                                 , input-output vCode
      996                                 , input-output vCodeValue
      997                                 , input-output vCodeName
      998                                 , input-output vMisc1
      999                                 , input-output vMisc2
     1000                                 , input-output vMisc3
     1001                                 , input-output vMisc4
     1002                                 , output vIsUpdated
     1003                          ).
     1004      if vCode <> tt_code.code then
     1005      do:
     1006          find first buf_tt_code where
     1007                     buf_tt_code.code = vCode
     1008               no-lock no-error.
     1009          if avail buf_tt_code then
     1010          do:
     1011            message
     1012               "Ошибка изменения" skip
     1013               "В справочнике уже есть тип маркировки с кодом " buf_tt_code.code "."
     1014               view-as alert-box.
     1015            return no-apply.
     1016          end.
     1017      end.
     1018      if vCodeValue <> tt_code.codevalue then
     1019      do:
     1020          find first buf_tt_code where
     1021                     buf_tt_code.code = vCodeValue
     1022               no-lock no-error.
     1023          if avail buf_tt_code then
     1024          do:
     1025            message
     1026               "Ошибка изменения" skip
     1027               "В справочнике уже есть тип маркировки со значением " buf_tt_code.code "."
     1028               view-as alert-box.
     1029            return no-apply.
     1030          end.
     1031      end.
     1032      if vIsUpdated then do:
     1033        assign
     1034           tt_code.code      = vCode
     1035           tt_code.codevalue = vCodeValue
     1036           tt_code.codename  = vCodeName
     1037           tt_code.misc1     = vMisc1
     1038           tt_code.misc2     = vMisc2
     1039           tt_code.misc3     = vMisc3
     1040           tt_code.misc4     = vMisc4
     1041        .
     1042        BROWSE-5:refresh().
     1043      end.
     1044      apply "ENTRY" to BROWSE-5.
     1045   end.
     1046   ON CHOOSE OF b-xml IN FRAME f-okei2
     1047   DO:
     1048      run Exp2Xml in this-procedure.
     1049   END.
     1050   if valid-handle(active-window) and frame f-okei2:PARENT eq ?
     1051     then frame f-okei2:PARENT = active-window.
     1052   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053   on help of frame f-okei2
     1054   do:
     1055     run gbl/app_help.p
     1056       (input this-procedure :file-name
     1057       ,input ''
     1058       ,input ?
     1059       ) no-error.
     1060     if error-status :error then do:
     1061       message
     1062         "Ошибка при вызове помощи"
     1063         error-status :get-message(1)
     1064         view-as alert-box .
     1065     end.
     1066   end.
     1067   run minbtn-set in this-procedure .
     1068   on choose of b-help in frame f-okei2
     1069   do:
     1070     apply "help":u to frame f-okei2 .
     1071   end.
     1072   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1073   procedure minbtn-set :
     1074       do
     1075           on error undo, return error return-value
     1076           :
     1077           define variable ii              as integer       no-undo .
     1078           define variable fh              as widget-handle no-undo .
     1079           define variable hh              as widget-handle no-undo .
     1080           define variable v-h             as handle        extent 4 no-undo .
     1081           define variable v-name-button   as character     no-undo .
     1082           define variable v-help-old-x    as decimal       no-undo .
     1083           define variable v-help-old-y    as decimal       no-undo .
     1084           define variable v-help-old-size as decimal       no-undo .
     1085           define variable v-frame-width   as decimal       no-undo .
     1086           define variable jj              as integer       no-undo .
     1087           do
     1088               on error undo, return error
     1089               :
     1090               assign
     1091                   v-frame-width = frame f-okei2:width - 0.3
     1092                   fh            = frame f-okei2:first-child
     1093                   hh            = fh:first-child
     1094                   ii            = 1
     1095                   .
     1096               do while valid-handle(hh):
     1097                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1098                   do:
     1099                       case lc(hh:name) :
     1100                           when "b-help" then
     1101                               do:
     1102                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1103                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1104                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1105                                   hh:TOOLTIP = "Помощь" .
     1106                                   v-help-old-x = hh:column .
     1107                                   v-help-old-y = hh:row    .
     1108                                   v-help-old-size = hh:width .
     1109                                   hh:width-chars = 2.5 .
     1110                               end.
     1111                           when "b-print" then
     1112                               do:
     1113                                   hh:load-image("cmp/b-print.bmp":u) .
     1114                                   hh:TOOLTIP = "Печать" .
     1115                                   v-h[ii] = hh:handle .
     1116                                   ii = ii + 1 .
     1117                                   hh:width-chars = 3 .
     1118                               end.
     1119                           when "b-history" or
     1120                           when "b-hist" then
     1121                               do:
     1122                                   hh:load-image("cmp/b-hist.bmp":u) .
     1123                                   hh:TOOLTIP = "История" .
     1124                                   v-h[ii] = hh:handle .
     1125                                   ii = ii + 1 .
     1126                                   hh:width-chars = 3 .
     1127                               end.
     1128                           when "b-sch" then
     1129                               do:
     1130                                   hh:load-image("cmp/b-sch.bmp":u) .
     1131                                   hh:TOOLTIP = "Установка Фильтра" .
     1132                                   v-h[ii] = hh:handle .
     1133                                   ii = ii + 1 .
     1134                                   hh:width-chars = 3 .
     1135                               end.
     1136                           when "b-hist-user" then
     1137                               do:
     1138                                   hh:load-image("cmp/b-hist.bmp":u) .
     1139                                   hh:TOOLTIP = "История пользователя" .
     1140                                   ii = ii + 1 .
     1141                               end.
     1142                       end case.
     1143                   end.
     1144                   hh = hh:next-sibling.
     1145               end.
     1146               b-help:column = v-frame-width - b-help:width-chars.
     1147               jj = 0.
     1148               repeat ii = 4 to 1 by -1 :
     1149                   if valid-handle (v-h[ii] ) then
     1150                   do:
     1151                       jj  = jj + 1 .
     1152                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1153                       v-h[ii]:row    = v-help-old-y .
     1154                   end.
     1155               end.
     1156           end.
     1157       end.
     1158   end procedure.
     1159   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1160   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1161   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1162   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1163   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1164   define variable v-diasize-current-frame-height as decimal   no-undo .
     1165   define variable v-diasize-change-size          as logical   no-undo .
     1166   define variable v-diasize-resize-button        as handle    no-undo .
     1167   define variable v-diasize-wndmax               as logical   no-undo .
     1168   define variable v-diasize-wndstore             as logical   no-undo .
     1169   define variable v-diasize-proc-name            as character no-undo .
     1170   define variable v-diasize-browse-handle        as handle    no-undo .
     1171   define variable v-diasize-browse-number        as integer   no-undo .
     1172   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1173   define temp-table temp-diasize-handle no-undo
     1174     field handle-value  as handle
     1175     field save-position as decimal
     1176     index xpk is primary unique handle-value
     1177     .
     1178   define temp-table temp-browse-handle no-undo
     1179     field browse-type   as character
     1180     field browse-number as integer
     1181     field browse-handle as handle
     1182     field original-size as decimal
     1183     index xpk is primary unique browse-type browse-number
     1184     index xie browse-type browse-handle
     1185   .
     1186   procedure diasize_change-height :
     1187     define input  parameter p-change-value  as decimal   no-undo .
     1188     define input  parameter p-move-resize   as logical   no-undo .
     1189     define variable v-field-group-handle    as handle    no-undo .
     1190     define variable v-object-handle         as handle    no-undo .
     1191     define variable v-frame-height          as decimal   no-undo .
     1192     define variable v-frame-virtual-height  as decimal   no-undo .
     1193     define variable v-browse-height         as decimal   no-undo .
     1194     define variable v-window-height         as decimal   no-undo .
     1195     define variable v-window-virtual-height as decimal   no-undo .
     1196     define variable v-change-sign           as integer   no-undo .
     1197     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1198     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1199     if p-change-value > 0
     1200     then do:
     1201       if frame f-okei2 :height + p-change-value
     1202           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1203       then do:
     1204         assign
     1205           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1206                           - (frame f-okei2 :height-chars)
     1207         .
     1208         if p-change-value <= 0
     1209         then do:
     1210           run diasize_position-resize-button in this-procedure .
     1211           return .
     1212         end.
     1213       end.
     1214     end.
     1215     if p-change-value < 0
     1216     then do:
     1217       if frame f-okei2 :height + p-change-value < v-diasize-orig-frame-height
     1218       then do:
     1219         assign
     1220           p-change-value = v-diasize-orig-frame-height
     1221                          - (frame f-okei2 :height-chars)
     1222         .
     1223         if p-change-value >= 0
     1224         then do:
     1225           run diasize_position-resize-button in this-procedure .
     1226           return .
     1227         end.
     1228       end.
     1229     end.
     1230     if p-change-value >= 0
     1231     then do:
     1232       assign
     1233         v-change-sign = 1
     1234       .
     1235     end.
     1236     else do:
     1237       assign
     1238         v-change-sign = -1
     1239       .
     1240     end.
     1241     assign
     1242       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1243     .
     1244     if p-change-value = 0
     1245     then do:
     1246       run diasize_position-resize-button in this-procedure .
     1247       return .
     1248     end.
     1249     move_block:
     1250     do
     1251     on error undo move_block, retry move_block
     1252     :
     1253       if retry
     1254       then do:
     1255         do
     1256         on error undo move_block, leave move_block
     1257         :
     1258           if p-change-value > 0
     1259           then do:
     1260             for each buf_temp-diasize-handle
     1261             on error undo, next
     1262             :
     1263               assign
     1264                 v-object-handle = buf_temp-diasize-handle.handle-value
     1265               .
     1266               if v-object-handle <> v-diasize-resize-button
     1267               then do:
     1268                 assign
     1269                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1270                 .
     1271               end.
     1272             end.
     1273             assign
     1274               v-diasize-browse-handle :height = v-browse-height
     1275             .
     1276             for each buf_temp-browse-handle
     1277               where buf_temp-browse-handle.browse-type = 'height':u
     1278             on error undo, next
     1279             :
     1280               assign
     1281                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1282               .
     1283             end.
     1284             assign
     1285               frame f-okei2 :height = v-frame-height
     1286             .
     1287             if frame f-okei2 :scrollable = true
     1288             then do:
     1289               assign
     1290                 frame f-okei2 :virtual-height = v-frame-virtual-height
     1291               .
     1292             end.
     1293             run diasize_position-resize-button in this-procedure .
     1294           end.
     1295           else do:
     1296             if frame f-okei2 :scrollable = true
     1297             then do:
     1298               assign
     1299                 frame f-okei2 :virtual-height = v-frame-virtual-height
     1300               .
     1301             end.
     1302             assign
     1303               frame f-okei2 :height = v-frame-height
     1304             .
     1305             assign
     1306               v-diasize-browse-handle :height = v-browse-height
     1307             .
     1308             for each buf_temp-browse-handle
     1309               where buf_temp-browse-handle.browse-type = 'height':u
     1310             on error undo, next
     1311             :
     1312               assign
     1313                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1314               .
     1315             end.
     1316             for each buf_temp-diasize-handle
     1317             on error undo, next
     1318             :
     1319               assign
     1320                 v-object-handle = buf_temp-diasize-handle.handle-value
     1321               .
     1322               if v-object-handle <> v-diasize-resize-button
     1323               then do:
     1324                 assign
     1325                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1326                 .
     1327               end.
     1328             end.
     1329             run diasize_position-resize-button in this-procedure .
     1330           end.
     1331           assign
     1332             v-diasize-change-size = false
     1333           .
     1334           leave move_block .
     1335         end.
     1336       end.
     1337       assign
     1338         v-diasize-need-full-display = true
     1339       .
     1340       if v-diasize-change-size = false
     1341       then do:
     1342         assign
     1343           v-diasize-change-size = true
     1344         .
     1345       end.
     1346       else do:
     1347         return .
     1348       end.
     1349       assign
     1350         v-frame-height = frame f-okei2 :height
     1351         v-frame-virtual-height = frame f-okei2 :virtual-height
     1352         v-browse-height = v-diasize-browse-handle :height
     1353       .
     1354       for each buf_temp-browse-handle
     1355         where buf_temp-browse-handle.browse-type = 'height':u
     1356       :
     1357         assign
     1358           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1359         .
     1360       end.
     1361       for each buf_temp-diasize-handle
     1362       :
     1363         delete buf_temp-diasize-handle .
     1364       end.
     1365       assign
     1366         v-field-group-handle = frame f-okei2 :first-child
     1367       .
     1368       do while valid-handle(v-field-group-handle)
     1369       :
     1370         assign
     1371           v-object-handle = v-field-group-handle :first-child
     1372         .
     1373         do while valid-handle(v-object-handle)
     1374         :
     1375           if  v-object-handle <> v-diasize-browse-handle :handle
     1376           and can-query(v-object-handle, "row")
     1377           and can-query(v-object-handle, "height")
     1378           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1379           then do:
     1380             find first buf_temp-browse-handle
     1381               where buf_temp-browse-handle.browse-type   = 'height':u
     1382                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1383               no-error .
     1384             if available buf_temp-browse-handle
     1385             then do:
     1386             end.
     1387             else do:
     1388               create buf_temp-diasize-handle .
     1389               assign
     1390                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1391                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1392               .
     1393             end.
     1394           end.
     1395           assign
     1396             v-object-handle = v-object-handle :next-sibling
     1397           .
     1398         end.
     1399         assign
     1400           v-field-group-handle = v-field-group-handle :next-sibling
     1401         .
     1402       end.
     1403       do with frame f-okei2
     1404       :
     1405         hide v-diasize-resize-button .
     1406         assign
     1407           v-diasize-resize-button :row    = 1
     1408           v-diasize-resize-button :column = 1
     1409         .
     1410       end.
     1411       if p-change-value > 0
     1412       then do:
     1413         if frame f-okei2 :scrollable = true
     1414         then do:
     1415           assign
     1416             frame f-okei2 :virtual-height = frame f-okei2 :virtual-height + p-change-value
     1417             no-error .
     1418           if error-status :error
     1419           or error-status :get-message(1) <> ""
     1420           then do:
     1421             undo move_block, retry move_block .
     1422           end.
     1423         end.
     1424         assign
     1425           frame f-okei2 :height = frame f-okei2 :height + p-change-value
     1426           no-error .
     1427         if error-status :error
     1428         or error-status :get-message(1) <> ""
     1429         then do:
     1430           undo move_block, retry move_block .
     1431         end.
     1432         assign
     1433           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1434           no-error .
     1435         if error-status :error
     1436         or error-status :get-message(1) <> ""
     1437         then do:
     1438           undo move_block, retry move_block .
     1439         end.
     1440         for each buf_temp-browse-handle
     1441           where buf_temp-browse-handle.browse-type = 'height':u
     1442         on error undo move_block, retry move_block
     1443         :
     1444           assign
     1445             buf_temp-browse-handle.browse-handle :height
     1446               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1447             no-error .
     1448           if error-status :error
     1449           or error-status :get-message(1) <> ""
     1450           then do:
     1451             undo move_block, retry move_block .
     1452           end.
     1453         end.
     1454         for each buf_temp-diasize-handle
     1455         on error undo move_block, retry move_block
     1456         :
     1457           assign
     1458             v-object-handle = buf_temp-diasize-handle.handle-value
     1459           .
     1460           if v-object-handle <> v-diasize-resize-button
     1461           then do:
     1462             assign
     1463               v-object-handle :row = v-object-handle :row + p-change-value
     1464               no-error .
     1465             if error-status :error
     1466             or error-status :get-message(1) <> ""
     1467             then do:
     1468               undo move_block, retry move_block .
     1469             end.
     1470           end.
     1471         end.
     1472       end.
     1473       else do:
     1474         for each buf_temp-diasize-handle
     1475         on error undo move_block, retry move_block
     1476         :
     1477           assign
     1478             v-object-handle = buf_temp-diasize-handle.handle-value
     1479           .
     1480           if v-object-handle <> v-diasize-resize-button
     1481           then do:
     1482             assign
     1483               v-object-handle :row = v-object-handle :row + p-change-value
     1484               no-error .
     1485             if error-status :error
     1486             or error-status :get-message(1) <> ""
     1487             then do:
     1488               undo move_block, retry move_block .
     1489             end.
     1490           end.
     1491         end.
     1492         assign
     1493           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1494           no-error .
     1495         if error-status :error
     1496         or error-status :get-message(1) <> ""
     1497         then do:
     1498           undo move_block, retry move_block .
     1499         end.
     1500         for each buf_temp-browse-handle
     1501           where buf_temp-browse-handle.browse-type = 'height':u
     1502         on error undo move_block, retry move_block
     1503         :
     1504           assign
     1505             buf_temp-browse-handle.browse-handle :height
     1506               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1507             no-error .
     1508           if error-status :error
     1509           or error-status :get-message(1) <> ""
     1510           then do:
     1511             undo move_block, retry move_block .
     1512           end.
     1513         end.
     1514         assign
     1515           frame f-okei2 :height = frame f-okei2 :height + p-change-value
     1516           no-error .
     1517         if error-status :error
     1518         or error-status :get-message(1) <> ""
     1519         then do:
     1520           undo move_block, retry move_block .
     1521         end.
     1522         if frame f-okei2 :scrollable = true
     1523         then do:
     1524           assign
     1525             frame f-okei2 :virtual-height = frame f-okei2 :virtual-height + p-change-value
     1526             no-error .
     1527           if error-status :error
     1528           or error-status :get-message(1) <> ""
     1529           then do:
     1530             undo move_block, retry move_block .
     1531           end.
     1532         end.
     1533       end.
     1534       if p-move-resize = true
     1535       then do:
     1536         run diasize_position-resize-button in this-procedure .
     1537       end.
     1538       if v-diasize-wndstore = true
     1539       then do:
     1540         if connected("ub") = true
     1541         then do:
     1542           define variable v-cntxt-db-num        as integer   no-undo .
     1543           define variable v-cntxt-userid        as character no-undo .
     1544           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1545                                             , OUTPUT v-cntxt-userid
     1546                                             ) .
     1547           run gbl/wndsizew.p
     1548             (input  v-cntxt-db-num
     1549             ,input  v-cntxt-userid
     1550             ,input  v-diasize-proc-name
     1551             ,input  'height':u
     1552             ,input  string(frame f-okei2 :height - v-diasize-orig-frame-height)
     1553             ) .
     1554         end.
     1555       end.
     1556     end.
     1557     assign
     1558       v-diasize-change-size = false
     1559     .
     1560   end procedure.
     1561   procedure diasize_set-height :
     1562     define input  parameter p-new-height  as decimal   no-undo .
     1563     define input  parameter p-move-resize as logical   no-undo .
     1564     do
     1565     on error undo, return error return-value
     1566     :
     1567       run diasize_change-height in this-procedure
     1568         (input  (p-new-height - frame f-okei2 :height)
     1569         ,input  p-move-resize
     1570         ) .
     1571     end.
     1572   end procedure.
     1573   procedure diasize_change-width :
     1574     define input  parameter p-change-value as decimal   no-undo .
     1575     define input  parameter p-move-resize  as logical   no-undo .
     1576     define variable v-field-group-handle   as handle    no-undo .
     1577     define variable v-object-handle        as handle    no-undo .
     1578     define variable v-frame-width          as decimal   no-undo .
     1579     define variable v-frame-virtual-width  as decimal   no-undo .
     1580     define variable v-browse-width         as decimal   no-undo .
     1581     define variable v-window-width         as decimal   no-undo .
     1582     define variable v-window-virtual-width as decimal   no-undo .
     1583     define variable v-change-sign          as integer   no-undo .
     1584     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1585     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1586     if p-change-value > 0
     1587     then do:
     1588       if frame f-okei2 :width + p-change-value >
     1589           session :width-chars
     1590       then do:
     1591         assign
     1592           p-change-value = session :width-chars - frame f-okei2 :width
     1593         .
     1594         if p-change-value <= 0
     1595         then do:
     1596           run diasize_position-resize-button in this-procedure .
     1597           return .
     1598         end.
     1599       end.
     1600     end.
     1601     if p-change-value < 0
     1602     then do:
     1603       if frame f-okei2 :width + p-change-value < v-diasize-orig-frame-width
     1604       then do:
     1605         assign
     1606           p-change-value = v-diasize-orig-frame-width
     1607                          - frame f-okei2 :width
     1608         .
     1609         if p-change-value >= 0
     1610         then do:
     1611           run diasize_position-resize-button in this-procedure .
     1612           return .
     1613         end.
     1614       end.
     1615     end.
     1616     if p-change-value >= 0
     1617     then do:
     1618       assign
     1619         v-change-sign = 1
     1620       .
     1621     end.
     1622     else do:
     1623       assign
     1624         v-change-sign = -1
     1625       .
     1626     end.
     1627     assign
     1628       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1629     .
     1630     if p-change-value = 0
     1631     then do:
     1632       run diasize_position-resize-button in this-procedure .
     1633       return .
     1634     end.
     1635     move_block:
     1636     do
     1637     on error undo move_block, leave move_block
     1638     :
     1639       if retry
     1640       then do:
     1641         do
     1642         on error undo move_block, leave move_block
     1643         :
     1644           if p-change-value > 0
     1645           then do:
     1646             for each buf_temp-diasize-handle
     1647             on error undo, next
     1648             :
     1649               assign
     1650                 v-object-handle = buf_temp-diasize-handle.handle-value
     1651               .
     1652               if v-object-handle <> v-diasize-resize-button
     1653               then do:
     1654                 assign
     1655                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1656                 .
     1657               end.
     1658             end.
     1659             assign
     1660               v-diasize-browse-handle :width = v-browse-width
     1661             .
     1662             for each buf_temp-browse-handle
     1663               where buf_temp-browse-handle.browse-type = 'width':u
     1664             on error undo, next
     1665             :
     1666               assign
     1667                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1668               .
     1669             end.
     1670             assign
     1671               frame f-okei2 :width = v-frame-width
     1672             .
     1673             if frame f-okei2 :scrollable = true
     1674             then do:
     1675               assign
     1676                 frame f-okei2 :virtual-width = v-frame-virtual-width
     1677               .
     1678             end.
     1679             run diasize_position-resize-button in this-procedure .
     1680           end.
     1681           else do:
     1682             if frame f-okei2 :scrollable = true
     1683             then do:
     1684               assign
     1685                 frame f-okei2 :virtual-width = v-frame-virtual-width
     1686               .
     1687             end.
     1688             assign
     1689               frame f-okei2 :width = v-frame-width
     1690             .
     1691             for each buf_temp-browse-handle
     1692               where buf_temp-browse-handle.browse-type = 'width':u
     1693             on error undo, next
     1694             :
     1695               assign
     1696                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1697               .
     1698             end.
     1699             assign
     1700               v-diasize-browse-handle :width = v-browse-width
     1701             .
     1702             for each buf_temp-diasize-handle
     1703             on error undo, next
     1704             :
     1705               assign
     1706                 v-object-handle = buf_temp-diasize-handle.handle-value
     1707               .
     1708               if v-object-handle <> v-diasize-resize-button
     1709               then do:
     1710                 assign
     1711                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1712                 .
     1713               end.
     1714             end.
     1715             run diasize_position-resize-button in this-procedure .
     1716           end.
     1717           assign
     1718             v-diasize-change-size = false
     1719           .
     1720           leave move_block .
     1721         end.
     1722       end.
     1723       assign
     1724         v-diasize-need-full-display = true
     1725       .
     1726       if v-diasize-change-size = false
     1727       then do:
     1728         assign
     1729           v-diasize-change-size = true
     1730         .
     1731       end.
     1732       else do:
     1733         return .
     1734       end.
     1735       assign
     1736         v-frame-width = frame f-okei2 :width
     1737         v-frame-virtual-width = frame f-okei2 :virtual-width
     1738         v-browse-width = v-diasize-browse-handle :width
     1739       .
     1740       for each buf_temp-browse-handle
     1741         where buf_temp-browse-handle.browse-type = 'width':u
     1742       :
     1743         assign
     1744           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1745         .
     1746       end.
     1747       for each buf_temp-diasize-handle
     1748       :
     1749         delete buf_temp-diasize-handle .
     1750       end.
     1751       assign
     1752         v-field-group-handle = frame f-okei2 :first-child
     1753       .
     1754       do while valid-handle(v-field-group-handle)
     1755       :
     1756         assign
     1757           v-object-handle = v-field-group-handle :first-child
     1758         .
     1759         do while valid-handle(v-object-handle)
     1760         :
     1761           if  v-object-handle <> v-diasize-browse-handle :handle
     1762           and v-object-handle <> v-diasize-resize-button
     1763           and can-query(v-object-handle, "row")
     1764           and can-query(v-object-handle, "height")
     1765           and ( v-object-handle :col + v-object-handle :width
     1766                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1767               )
     1768           then do:
     1769             find first buf_temp-browse-handle
     1770               where buf_temp-browse-handle.browse-type   = 'width':u
     1771                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1772               no-error .
     1773             if available buf_temp-browse-handle
     1774             then do:
     1775             end.
     1776             else do:
     1777               create buf_temp-diasize-handle .
     1778               assign
     1779                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1780                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1781               .
     1782             end.
     1783           end.
     1784           assign
     1785             v-object-handle = v-object-handle :next-sibling
     1786           .
     1787         end.
     1788         assign
     1789           v-field-group-handle = v-field-group-handle :next-sibling
     1790         .
     1791       end.
     1792       do with frame f-okei2
     1793       :
     1794         hide v-diasize-resize-button .
     1795         v-diasize-resize-button :row = 1.
     1796         v-diasize-resize-button :column = 1.
     1797       end.
     1798       if p-change-value > 0
     1799       then do:
     1800         if frame f-okei2 :scrollable = true
     1801         then do:
     1802           assign
     1803             frame f-okei2 :virtual-width = frame f-okei2 :virtual-width + p-change-value
     1804             no-error .
     1805           if error-status :error
     1806           or error-status :get-message(1) <> ""
     1807           then do:
     1808             undo move_block, retry move_block.
     1809           end.
     1810         end.
     1811         assign
     1812           frame f-okei2 :width = v-frame-width + p-change-value
     1813           no-error .
     1814         if error-status :error
     1815         or error-status :get-message(1) <> ""
     1816         then do:
     1817           undo move_block, retry move_block.
     1818         end.
     1819         assign
     1820           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1821         no-error .
     1822         if error-status :error
     1823         or error-status :get-message(1) <> ""
     1824         then do:
     1825           undo move_block, retry move_block.
     1826         end.
     1827         for each buf_temp-browse-handle
     1828           where buf_temp-browse-handle.browse-type = 'width':u
     1829         on error undo move_block, retry move_block
     1830         :
     1831           assign
     1832             buf_temp-browse-handle.browse-handle :width
     1833               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1834             no-error .
     1835           if error-status :error
     1836           or error-status :get-message(1) <> ""
     1837           then do:
     1838             undo move_block, retry move_block .
     1839           end.
     1840         end.
     1841         for each buf_temp-diasize-handle
     1842         on error undo move_block, retry move_block
     1843         :
     1844           assign
     1845             v-object-handle = buf_temp-diasize-handle.handle-value
     1846           .
     1847           if v-object-handle <> v-diasize-resize-button
     1848           then do:
     1849             assign
     1850               v-object-handle :col = v-object-handle :col + p-change-value
     1851               no-error .
     1852             if error-status :error
     1853             or error-status :get-message(1) <> ""
     1854             then do:
     1855               undo move_block, retry move_block .
     1856             end.
     1857           end.
     1858         end.
     1859       end.
     1860       else do:
     1861         for each buf_temp-diasize-handle
     1862         on error undo move_block, retry move_block
     1863         :
     1864           assign
     1865             v-object-handle = buf_temp-diasize-handle.handle-value
     1866           .
     1867           if v-object-handle <> v-diasize-resize-button
     1868           then do:
     1869             assign
     1870               v-object-handle :col = v-object-handle :col + p-change-value
     1871               no-error .
     1872             if error-status :error
     1873             or error-status :get-message(1) <> ""
     1874             then do:
     1875               undo move_block, retry move_block .
     1876             end.
     1877           end.
     1878         end.
     1879         for each buf_temp-browse-handle
     1880           where buf_temp-browse-handle.browse-type = 'width':u
     1881         on error undo move_block, retry move_block
     1882         :
     1883           assign
     1884             buf_temp-browse-handle.browse-handle :width
     1885               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1886             no-error .
     1887           if error-status :error
     1888           or error-status :get-message(1) <> ""
     1889           then do:
     1890             undo move_block, retry move_block .
     1891           end.
     1892         end.
     1893         assign
     1894           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1895           no-error .
     1896         if error-status :error
     1897         or error-status :get-message(1) <> ""
     1898         then do:
     1899           undo move_block, retry move_block.
     1900         end.
     1901         assign
     1902           frame f-okei2 :width = frame f-okei2 :width + p-change-value
     1903         no-error .
     1904         if error-status :error
     1905         or error-status :get-message(1) <> ""
     1906         then do:
     1907           undo move_block, retry move_block.
     1908         end.
     1909         if frame f-okei2 :scrollable = true
     1910         then do:
     1911           assign
     1912             frame f-okei2 :virtual-width = frame f-okei2 :virtual-width + p-change-value
     1913           no-error .
     1914           if error-status :error
     1915           or error-status :get-message(1) <> ""
     1916           then do:
     1917             undo move_block, retry move_block.
     1918           end.
     1919         end.
     1920       end.
     1921       if p-move-resize
     1922       then do:
     1923         run diasize_position-resize-button in this-procedure .
     1924       end.
     1925       if v-diasize-wndstore = true
     1926       then do:
     1927         if connected("ub") = true
     1928         then do:
     1929           define variable v-cntxt-db-num        as integer   no-undo .
     1930           define variable v-cntxt-userid        as character no-undo .
     1931           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1932                                             , OUTPUT v-cntxt-userid
     1933                                             ) .
     1934           run gbl/wndsizew.p
     1935             (input  v-cntxt-db-num
     1936             ,input  v-cntxt-userid
     1937             ,input  v-diasize-proc-name
     1938             ,input  'width':u
     1939             ,input  string(frame f-okei2 :width - v-diasize-orig-frame-width)
     1940             ) .
     1941         end.
     1942       end.
     1943     end.
     1944     assign
     1945       v-diasize-change-size = false
     1946     .
     1947   end procedure.
     1948   procedure diasize_set-width :
     1949     define input  parameter p-new-width  as decimal   no-undo .
     1950     define input  parameter p-move-resize as logical   no-undo .
     1951     do
     1952     on error undo, return error return-value
     1953     :
     1954       run diasize_change-width in this-procedure
     1955         (input  (p-new-width - frame f-okei2 :width)
     1956         ,input  p-move-resize
     1957         ) .
     1958     end.
     1959   end procedure.
     1960   procedure diasize_position-resize-button :
     1961     do with frame f-okei2
     1962     :
     1963       hide v-diasize-resize-button .
     1964       assign
     1965         v-diasize-resize-button :row = frame f-okei2 :height - v-diasize-resize-button :height
     1966                     - 1
     1967                     - (frame f-okei2 :border-bottom-pixels / session :pixels-per-row)
     1968         v-diasize-resize-button :col = frame f-okei2 :width - v-diasize-resize-button :width
     1969                     - 1
     1970                     - (frame f-okei2 :border-right-pixels / session :pixels-per-column)
     1971       .
     1972       view v-diasize-resize-button .
     1973     end.
     1974   end procedure.
     1975   on alt-right anywhere
     1976   do:
     1977     run diasize_change-width in this-procedure
     1978       (input 1
     1979       ,input true
     1980       ) .
     1981     return no-apply .
     1982   end.
     1983   on alt-left anywhere
     1984   do:
     1985     run diasize_change-width in this-procedure
     1986       (input -1
     1987       ,input true
     1988       ) .
     1989     return no-apply .
     1990   end.
     1991   on alt-down anywhere
     1992   do:
     1993     run diasize_change-height in this-procedure
     1994       (input 1
     1995       ,input true
     1996       ) .
     1997     return no-apply .
     1998   end.
     1999   on alt-up anywhere
     2000   do:
     2001     run diasize_change-height in this-procedure
     2002       (input -1
     2003       ,input true
     2004       ) .
     2005     return no-apply .
     2006   end.
     2007   on alt-enter of frame f-okei2
     2008   do:
     2009     run diasize_maximize in this-procedure
     2010       (input  ?
     2011       ).
     2012     return no-apply .
     2013   end.
     2014   procedure diasize_end-move :
     2015     do
     2016     on error undo, return error return-value
     2017     :
     2018       define variable v-row-delta as decimal   no-undo .
     2019       define variable v-col-delta as decimal   no-undo .
     2020       define variable v-new-row as decimal   no-undo .
     2021       define variable v-new-col as decimal   no-undo .
     2022       assign
     2023         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2024         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2025       .
     2026       assign
     2027         v-row-delta = v-new-row - frame f-okei2 :height
     2028         v-col-delta = v-new-col - frame f-okei2 :width
     2029       .
     2030       run diasize_change-height in this-procedure
     2031         (input v-row-delta
     2032         ,input true
     2033         ) .
     2034       run diasize_change-width in this-procedure
     2035         (input v-col-delta
     2036         ,input true
     2037         ) .
     2038     end.
     2039   end procedure.
     2040   procedure diasize_maximize :
     2041     define input  parameter p-action as logical   no-undo .
     2042     do
     2043     on error undo, return error return-value
     2044     :
     2045       if p-action = ?
     2046       then do:
     2047         if v-diasize-need-maximize = true
     2048         then do:
     2049           assign
     2050             p-action = true
     2051           .
     2052         end.
     2053         else do:
     2054           assign
     2055             p-action = false
     2056           .
     2057         end.
     2058       end.
     2059       if p-action = true
     2060       then do:
     2061         run diasize_change-height in this-procedure
     2062           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2063               - frame f-okei2 :height-chars
     2064           ,input true
     2065           ) .
     2066         run diasize_change-width in this-procedure
     2067           (input session :width-chars
     2068               - frame f-okei2 :width-chars
     2069           ,input true
     2070           ) .
     2071         assign
     2072           v-diasize-need-maximize = false
     2073         .
     2074       end.
     2075       else do:
     2076         run diasize_change-width in this-procedure
     2077           (input v-diasize-orig-frame-width
     2078               - frame f-okei2 :width-chars
     2079           ,input true
     2080           ) .
     2081         run diasize_change-height in this-procedure
     2082           (input v-diasize-orig-frame-height
     2083               - frame f-okei2 :height-chars
     2084           ,input true
     2085           ) .
     2086         assign
     2087           v-diasize-need-maximize = true
     2088         .
     2089       end.
     2090     end.
     2091   end procedure.
     2092   procedure diasize_restore-orig-size :
     2093     do
     2094     on error undo, return error return-value
     2095     :
     2096       assign
     2097         v-diasize-current-frame-width  = frame f-okei2 :width
     2098         v-diasize-current-frame-height = frame f-okei2 :height
     2099       .
     2100       run diasize_set-height in this-procedure
     2101         (input  v-diasize-orig-frame-height
     2102         ,input  true
     2103         ) .
     2104       run diasize_set-width in this-procedure
     2105         (input  v-diasize-orig-frame-width
     2106         ,input  true
     2107         ) .
     2108     end.
     2109   end procedure.
     2110   procedure diasize_restore-current-size :
     2111     do
     2112     on error undo, return error return-value
     2113     :
     2114       run diasize_set-height in this-procedure
     2115         (input  v-diasize-current-frame-height
     2116         ,input  true
     2117         ) .
     2118       run diasize_set-width in this-procedure
     2119         (input  v-diasize-current-frame-width
     2120         ,input  true
     2121         ) .
     2122     end.
     2123   end procedure.
     2124   procedure diasize_set-browse-handle :
     2125     define input  parameter p-browse-handle as handle   no-undo .
     2126     define buffer buf_temp-browse-handle for temp-browse-handle .
     2127     do
     2128     on error undo, return error return-value
     2129     :
     2130       assign
     2131         v-diasize-browse-handle = p-browse-handle
     2132       .
     2133       for each buf_temp-browse-handle
     2134       on error undo, return error return-value
     2135       :
     2136         delete buf_temp-browse-handle .
     2137       end.
     2138     end.
     2139   end procedure.
     2140   procedure diasize_add_browse :
     2141     define input  parameter p-browse-type   as character no-undo .
     2142     define input  parameter p-browse-handle as handle    no-undo .
     2143     define buffer buf_temp-browse-handle for temp-browse-handle .
     2144     do
     2145     on error undo, return error return-value
     2146     :
     2147       assign
     2148         v-diasize-browse-number = v-diasize-browse-number + 1
     2149       .
     2150       create buf_temp-browse-handle .
     2151       assign
     2152         buf_temp-browse-handle.browse-type   = p-browse-type
     2153         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2154         buf_temp-browse-handle.browse-handle = p-browse-handle
     2155       .
     2156     end.
     2157   end procedure.
     2158   procedure diasize_init :
     2159     define variable v-default-value    as logical   no-undo .
     2160     define variable v-restore-saved    as logical   no-undo .
     2161     define variable v-resize-value-str as character no-undo .
     2162     do
     2163     on error undo, return error return-value
     2164     :
     2165       do with frame f-okei2
     2166       :
     2167         assign
     2168           v-diasize-orig-frame-height = frame f-okei2 :height
     2169           v-diasize-orig-frame-width  = frame f-okei2 :width
     2170           v-diasize-browse-handle     = browse BROWSE-5 :handle
     2171         .
     2172         create button v-diasize-resize-button
     2173         assign
     2174           parent        = frame f-okei2 :first-child
     2175           label         = "s"
     2176           height-pixels = 16
     2177           width-pixels  = 16
     2178           visible       = true
     2179           sensitive     = true
     2180           movable       = true
     2181           triggers:
     2182             on end-move persistent run diasize_end-move in this-procedure .
     2183           end triggers.
     2184         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2185         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2186         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2187         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2188         assign
     2189           v-diasize-wndmax = false
     2190         .
     2191         if connected("ub") = true
     2192         then do:
     2193           define variable v-cntxt-db-num        as integer   no-undo .
     2194           define variable v-cntxt-userid        as character no-undo .
     2195           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2196                                             , OUTPUT v-cntxt-userid
     2197                                             ) .
     2198           run gbl/wndpar_r.p
     2199             (input  v-cntxt-db-num
     2200             ,input  v-cntxt-userid
     2201             ,input  'wndmax':U
     2202             ,output v-diasize-wndmax
     2203             ,output v-default-value
     2204             ) .
     2205         end.
     2206         assign
     2207           v-diasize-wndstore = false
     2208         .
     2209         if connected("ub") = true
     2210         then do:
     2211           run gbl/wndpar_r.p
     2212             (input  v-cntxt-db-num
     2213             ,input  v-cntxt-userid
     2214             ,input  'wndstore':U
     2215             ,output v-diasize-wndstore
     2216             ,output v-default-value
     2217             ) .
     2218         end.
     2219         assign
     2220           v-diasize-proc-name = entry(1, program-name(2), '.')
     2221         .
     2222         if v-diasize-wndstore = true
     2223         then do:
     2224           assign
     2225             v-restore-saved = false
     2226           .
     2227           if connected("ub") = true
     2228           then do:
     2229             run gbl/wndsizer.p
     2230               (input  v-cntxt-db-num
     2231               ,input  v-cntxt-userid
     2232               ,input  v-diasize-proc-name
     2233               ,input  'height':u
     2234               ,output v-resize-value-str
     2235               ) .
     2236             if v-resize-value-str <> '':U
     2237             then do:
     2238               run diasize_change-height in this-procedure
     2239                 (input  integer(v-resize-value-str)
     2240                 ,input  true
     2241                 ) .
     2242               assign
     2243                 v-restore-saved = true
     2244               .
     2245             end.
     2246           end.
     2247           if connected("ub") = true
     2248           then do:
     2249             run gbl/wndsizer.p
     2250               (input  v-cntxt-db-num
     2251               ,input  v-cntxt-userid
     2252               ,input  v-diasize-proc-name
     2253               ,input  'width':u
     2254               ,output v-resize-value-str
     2255               ) .
     2256             if v-resize-value-str <> '':U
     2257             then do:
     2258               run diasize_change-width in this-procedure
     2259                 (input  integer(v-resize-value-str)
     2260                 ,input  true
     2261                 ) .
     2262               assign
     2263                 v-restore-saved = true
     2264               .
     2265             end.
     2266           end.
     2267           if v-restore-saved <> true
     2268           then do:
     2269             if v-diasize-wndmax = true
     2270             then do:
     2271               run diasize_maximize in this-procedure
     2272                 (input  true
     2273                 ) .
     2274             end.
     2275           end.
     2276         end.
     2277         else do:
     2278           if v-diasize-wndmax = true
     2279           then do:
     2280             run diasize_maximize in this-procedure
     2281               (input  true
     2282               ) .
     2283           end.
     2284         end.
     2285       end.
     2286     end.
     2287   end procedure.
     2288   procedure diasize_need-full-display :
     2289     define output parameter p-need-full-display as logical   no-undo .
     2290     do
     2291     on error undo, return error return-value
     2292     :
     2293       assign
     2294         p-need-full-display = v-diasize-need-full-display
     2295       .
     2296       assign
     2297         v-diasize-need-full-display = false
     2298       .
     2299     end.
     2300   end procedure.
     2301   procedure get-context :
     2302      define output parameter p-db-num as integer          no-undo.
     2303      define output parameter p-user-id as character        no-undo.
     2304      define variable v-login               as character    no-undo.
     2305      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2306      define buffer buf_user-login  for ub.user-login .
     2307      do
     2308      on error undo, return error
     2309      :
     2310            FIND FIRST buf_sys-ctrl no-lock.
     2311            ASSIGN
     2312               v-login = USERID("ub")
     2313               p-db-num = buf_sys-ctrl.db-num
     2314            .
     2315            FIND FIRST buf_user-login
     2316                 WHERE buf_user-login.db-num = p-db-num
     2317                   AND buf_user-login.user-login = v-login
     2318                 no-lock
     2319                 no-error
     2320                 .
     2321            IF AVAILABLE buf_user-login
     2322            THEN DO:
     2323               assign
     2324                  p-user-id = buf_user-login.user-id
     2325               .
     2326            END.
     2327      end.
     2328   end procedure.
     2329       run diasize_init in this-procedure .
     2330   on window-close of frame f-okei2
     2331     apply "END-ERROR":U to self.
     2332   MAIN-BLOCK:
     2333   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2334     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2335   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2336     run mainmenu_getcntxt in parparentproc
     2337       (output v-cntxt-db-num
     2338       ,output v-cntxt-userid
     2339       ,output v-cntxt-level
     2340       ,output v-cntxt-host-code-obj
     2341       ,output v-cntxt-obj-type
     2342       ,output v-cntxt-obj-code
     2343       ,output v-cntxt-db-num-obj
     2344       ,output v-cntxt-is-admin
     2345       ) .
     2346   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2347   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2348     (output v-db-num
     2349     )  .
     2350     run init-marktype.
     2351     run enable_UI in this-procedure .
     2352     wait-for go of frame f-okei2 focus BROWSE-5.
     2353   end.
     2354   run disable_UI in this-procedure .
     2355   PROCEDURE checkChanges :
     2356       define variable vIsChanged     as logical no-undo init no.
     2357       define variable vBufferCompare as logical no-undo init no.
     2358       define variable vExit          as logical no-undo.
     2359       define buffer buf_code    for ub.code.
     2360       define buffer buf_tt_code for tt_code.
     2361       for each buf_code where
     2362                buf_code.parent = "MarkType"
     2363           no-lock:
     2364         accum buf_code.code (count).
     2365       end.
     2366       for each buf_tt_code
     2367           no-lock:
     2368         accum buf_tt_code.code (count).
     2369       end.
     2370       if (accum count buf_code.code) <> (accum count buf_tt_code.code) then
     2371           vIsChanged = true.
     2372       if not vIsChanged then
     2373       do:
     2374           BLOCK_COMPARE:
     2375           for each buf_tt_code where
     2376                    int(buf_tt_code.code) > 16
     2377               no-lock:
     2378             find first buf_code where
     2379                        buf_code.parent = "MarkType"
     2380                    and buf_code.code = buf_tt_code.code
     2381                  no-lock no-error.
     2382             if avail buf_code then
     2383             do:
     2384                buffer-compare buf_tt_code to buf_code
     2385                  SAVE RESULT IN vBufferCompare.
     2386                if not vBufferCompare then
     2387                do:
     2388                  vIsChanged = true.
     2389                  leave BLOCK_COMPARE.
     2390                end.
     2391             end.
     2392             else
     2393             do:
     2394                 vIsChanged = true.
     2395                 leave BLOCK_COMPARE.
     2396             end.
     2397           end.
     2398       end.
     2399       if vIsChanged then
     2400       do:
     2401           message
     2402             "Для сохранения обновленной конфигурации типов маркировки нажмите «Нет»" skip
     2403             "и проведите выгрузку конфигурации в основной форме." skip
     2404             "После выхода из режима конфигурации типов маркировки внесенные изменения будут удалены." skip
     2405             "Вы уверены, что хотите завершить конфигурирование и закрыть форму?"
     2406             view-as alert-box question buttons yes-no update vExit.
     2407           if not vExit then return error.
     2408        end.
     2409        return.
     2410   END PROCEDURE.
     2411   PROCEDURE disable_UI :
     2412     HIDE FRAME f-okei2.
     2413   END PROCEDURE.
     2414   PROCEDURE enable_UI :
     2415     enable
     2416       BROWSE-5
     2417       b-exit
     2418       b-add
     2419       when v-db-num = 0
     2420       b-del
     2421       when v-db-num = 0
     2422       b-upd
     2423       when v-db-num = 0
     2424       b-xml
     2425       when v-db-num = 0
     2426       b-help
     2427       with frame f-okei2.
     2428     OPEN QUERY BROWSE-5 FOR EACH tt_code NO-LOCK     BY tt_code.code INDEXED-REPOSITION.
     2429   end procedure.
     2430   PROCEDURE Exp2Xml :
     2431       define buffer   b-code for ub.code.
     2432       define buffer   b-tt_code for tt_code.
     2433       define variable v-file-name as character no-undo.
     2434       define variable vDateTime   as character no-undo.
     2435       define variable vCodeName   as character no-undo.
     2436       assign
     2437         v-file-name = "marktype_000000000" + ".xml"
     2438         vDateTime   = substitute("&1 &2",string(today,"99.99.9999"),string(time,"HH:MM")).
     2439       .
     2440       output stream out-xml to value(v-file-name).
     2441       put stream out-xml unformatted
     2442       "<?xml version=~"1.0~" encoding=~"windows-1251~" ?>" skip
     2443       "<Root>" skip
     2444       "    <File-info>" skip
     2445       "        <DateActive>01.01.2100</DateActive>" skip
     2446       "        <version>000</version>" skip
     2447       "    </File-info>" skip
     2448       "    <table-Code NwsNotSend=~"TableList~">" skip
     2449       "        <record-Code record-delete=~"no~">" skip
     2450       "            <code>Versions</code>" skip
     2451       "            <CodeName>Версии справочников БД</CodeName>" skip
     2452       "            <export_>yes</export_>" skip
     2453       "            <status_>0</status_>" skip
     2454       "            <nwsgbd>yes</nwsgbd>" skip
     2455       "        </record-Code>" skip
     2456       "        <record-Code record-delete=~"no~">" skip
     2457       "            <parent>Versions</parent>" skip
     2458       "            <code>0</code>" skip
     2459       "            <CodeName>Версии справочников на главной БД</CodeName>" skip
     2460       "            <export_>yes</export_>" skip
     2461       "            <status_>0</status_>" skip
     2462       "            <nwsgbd>yes</nwsgbd>" skip
     2463       "        </record-Code>" skip
     2464       "        <record-Code record-delete=~"no~">" skip
     2465       "            <parent>Versions" chr(4) "0</parent>" skip
     2466       "            <code>MarkType</code>" skip
     2467       "            <CodeName>Типы маркировки</CodeName>" skip
     2468       "            <CodeValue>" vDateTime "</CodeValue>" skip
     2469       "            <export_>yes</export_>" skip
     2470       "            <status_>0</status_>" skip
     2471       "            <nwsgbd>yes</nwsgbd>" skip
     2472       "        </record-Code>" skip
     2473       "        <record-Code record-delete=~"no~">" skip
     2474       "            <code>MarkType</code>" skip
     2475       "            <CodeName>Типы маркировки</CodeName>" skip
     2476       "            <export_>yes</export_>" skip
     2477       "            <procview>ref/marktype-brw.w</procview>" skip
     2478       "            <status_>0</status_>" skip
     2479       "            <nwsgbd>yes</nwsgbd>" skip
     2480       "        </record-Code>" skip
     2481       .
     2482       for each b-tt_code:
     2483           assign
     2484              vCodeName = replace(b-tt_code.CodeName, "&", "&amp;")
     2485              vCodeName = replace(vCodeName, "~"", "&quot;")
     2486              vCodeName = replace(vCodeName, "'", "&apos;")
     2487              vCodeName = replace(vCodeName, "<", "&lt;")
     2488              vCodeName = replace(vCodeName, ">", "&gt;")
     2489              vCodeName = replace(vCodeName, "<", "&lt;")
     2490           .
     2491           put stream out-xml unformatted
     2492               "        <record-Code record-delete=~"no~">" skip
     2493               "            <parent>MarkType</parent>" skip
     2494               "            <code>" b-tt_code.code "</code>" skip
     2495               "            <CodeValue>" b-tt_code.codevalue "</CodeValue>" skip
     2496               "            <CodeName>" vCodeName "</CodeName>" skip
     2497               "            <misc1>" b-tt_code.misc1 "</misc1>" skip
     2498               "            <misc2>" b-tt_code.misc2 "</misc2>" skip
     2499               "            <misc3>" b-tt_code.misc3 "</misc3>" skip
     2500               "            <misc4>" b-tt_code.misc4 "</misc4>" skip
     2501               "            <export_>" string(b-tt_code.export_) "</export_>" skip
     2502               "            <status_>" string(b-tt_code.status_) "</status_>" skip
     2503               "            <nwsgbd>" string(b-tt_code.nwsgbd) "</nwsgbd>" skip
     2504               "        </record-Code>" skip
     2505           .
     2506       end.
     2507       put stream out-xml unformatted
     2508       "    </table-Code>" skip
     2509       "</Root>" skip
     2510       .
     2511       output stream out-xml close.
     2512       MESSAGE "Справочник <Типы маркировки> выгружен в файл " search(v-file-name)
     2513       VIEW-AS ALERT-BOX.
     2514   END PROCEDURE.
     2515   PROCEDURE init-marktype :
     2516      def buffer b-code for ub.code.
     2517      empty temp-table tt_code.
     2518      for each b-code no-lock where
     2519               b-code.parent = "MarkType"
     2520               :
     2521         create tt_code.
     2522         buffer-copy b-code to tt_code.
     2523      end.
     2524   END PROCEDURE.
