        1   DEFINE INPUT PARAMETER p-field AS CHARACTER NO-UNDO.
        2   DEFINE INPUT PARAMETER p-title AS CHARACTER NO-UNDO.
        3   DEFINE INPUT PARAMETER p-label AS CHARACTER NO-UNDO.
        4   DEFINE INPUT PARAMETER p-length AS CHARACTER NO-UNDO.
        5   DEFINE INPUT PARAMETER p-validchars AS CHARACTER NO-UNDO.
        6   DEFINE OUTPUT PARAMETER p-field-new AS character NO-UNDO.
        7   DEFINE OUTPUT PARAMETER p-ok AS LOGICAL NO-UNDO.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Ввести строку, которая начинается с вопросительного знака".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   DEFINE VARIABLE v-pos-ind AS INTEGER NO-UNDO.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      116   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      117   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      118   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      119   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      120   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      121   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      122   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      123   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      124   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      125   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      126   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      127   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      128   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      129   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      130   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      131   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      132   DEFINE BUTTON B-exit AUTO-GO
      133        LABEL "&Ввод"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON B-Help
      137        LABEL "Помо&щь"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE BUTTON b-quit AUTO-END-KEY
      141        LABEL "&Отмена"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      145        VIEW-AS EDITOR
      146        SIZE 74.5 BY 3.75 NO-UNDO.
      147   DEFINE VARIABLE f-value AS CHARACTER FORMAT "X(19)"
      148        LABEL "Значение"
      149        VIEW-AS FILL-IN
      150        SIZE 21.5 BY 1.
      151   DEFINE VARIABLE v-pos AS CHARACTER FORMAT "X(256)":U
      152        VIEW-AS FILL-IN
      153        SIZE 21.5 BY .42
      154        BGCOLOR 8 FGCOLOR 12  NO-UNDO.
      155   DEFINE FRAME Dialog-Frame
      156        B-exit AT ROW 1 COL 1
      157        b-quit AT ROW 1 COL 11
      158        B-Help AT ROW 1 COL 54.88
      159        f-value AT ROW 4.21 COL 15.5 COLON-ALIGNED
      160        v-pos AT ROW 5.25 COL 15.5 COLON-ALIGNED NO-LABEL
      161        EDITOR-1 AT ROW 6.25 COL 3.5 NO-LABEL
      162        SPACE(6.37) SKIP(0.32)
      163       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      164            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      165            TITLE "Редактирование поля с вопросительным знаком"
      166            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      167   ASSIGN
      168          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      169          FRAME Dialog-Frame:HIDDEN           = TRUE.
      170   ASSIGN
      171          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      172   ON GO OF FRAME Dialog-Frame
      173   DO:
      174     ASSIGN
      175     f-value
      176     p-ok = YES
      177     p-field-new = f-value
      178     .
      179   END.
      180   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      181   DO:
      182     APPLY "END-ERROR":U TO SELF.
      183   END.
      184   ON ENTRY OF v-pos IN FRAME Dialog-Frame
      185   DO:
      186     RETURN NO-APPLY.
      187   END.
      188   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      189   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      190   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   on help of frame Dialog-Frame
      192   do:
      193     run gbl/app_help.p
      194       (input this-procedure :file-name
      195       ,input ''
      196       ,input ?
      197       ) no-error.
      198     if error-status :error then do:
      199       message
      200         "Ошибка при вызове помощи"
      201         error-status :get-message(1)
      202         view-as alert-box .
      203     end.
      204   end.
      205   run minbtn-set in this-procedure .
      206   on choose of b-help in frame Dialog-Frame
      207   do:
      208     apply "help":u to frame Dialog-Frame .
      209   end.
      210   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      211   procedure minbtn-set :
      212       do
      213           on error undo, return error return-value
      214           :
      215           define variable ii              as integer       no-undo .
      216           define variable fh              as widget-handle no-undo .
      217           define variable hh              as widget-handle no-undo .
      218           define variable v-h             as handle        extent 4 no-undo .
      219           define variable v-name-button   as character     no-undo .
      220           define variable v-help-old-x    as decimal       no-undo .
      221           define variable v-help-old-y    as decimal       no-undo .
      222           define variable v-help-old-size as decimal       no-undo .
      223           define variable v-frame-width   as decimal       no-undo .
      224           define variable jj              as integer       no-undo .
      225           do
      226               on error undo, return error
      227               :
      228               assign
      229                   v-frame-width = frame Dialog-Frame:width - 0.3
      230                   fh            = frame Dialog-Frame:first-child
      231                   hh            = fh:first-child
      232                   ii            = 1
      233                   .
      234               do while valid-handle(hh):
      235                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      236                   do:
      237                       case lc(hh:name) :
      238                           when "b-help" then
      239                               do:
      240                                   hh:load-image-up("cmp/b-help.bmp":u) .
      241                                   hh:load-image-down("cmp/b-help.bmp":u) .
      242                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      243                                   hh:TOOLTIP = "Помощь" .
      244                                   v-help-old-x = hh:column .
      245                                   v-help-old-y = hh:row    .
      246                                   v-help-old-size = hh:width .
      247                                   hh:width-chars = 2.5 .
      248                               end.
      249                           when "b-print" then
      250                               do:
      251                                   hh:load-image("cmp/b-print.bmp":u) .
      252                                   hh:TOOLTIP = "Печать" .
      253                                   v-h[ii] = hh:handle .
      254                                   ii = ii + 1 .
      255                                   hh:width-chars = 3 .
      256                               end.
      257                           when "b-history" or
      258                           when "b-hist" then
      259                               do:
      260                                   hh:load-image("cmp/b-hist.bmp":u) .
      261                                   hh:TOOLTIP = "История" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-sch" then
      267                               do:
      268                                   hh:load-image("cmp/b-sch.bmp":u) .
      269                                   hh:TOOLTIP = "Установка Фильтра" .
      270                                   v-h[ii] = hh:handle .
      271                                   ii = ii + 1 .
      272                                   hh:width-chars = 3 .
      273                               end.
      274                           when "b-hist-user" then
      275                               do:
      276                                   hh:load-image("cmp/b-hist.bmp":u) .
      277                                   hh:TOOLTIP = "История пользователя" .
      278                                   ii = ii + 1 .
      279                               end.
      280                       end case.
      281                   end.
      282                   hh = hh:next-sibling.
      283               end.
      284               b-help:column = v-frame-width - b-help:width-chars.
      285               jj = 0.
      286               repeat ii = 4 to 1 by -1 :
      287                   if valid-handle (v-h[ii] ) then
      288                   do:
      289                       jj  = jj + 1 .
      290                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      291                       v-h[ii]:row    = v-help-old-y .
      292                   end.
      293               end.
      294           end.
      295       end.
      296   end procedure.
      297   on ANY-KEY OF FRAME Dialog-Frame
      298   OR ANY-KEY OF b-quit
      299   OR ANY-KEY OF b-exit
      300   OR ANY-KEY OF b-help
      301   do:
      302     define variable v-length as integer no-undo .
      303     assign
      304       v-length = length(f-value)
      305     .
      306     if index(p-validchars, last-event :label) > 0
      307     then do:
      308       if v-length < 20
      309       then do:
      310         assign
      311           f-value = substring(f-value, 1, v-pos-ind - 1) + last-event :label
      312                    + substring(f-value, v-pos-ind, v-length - v-pos-ind + 1)
      313         .
      314         assign
      315           v-pos-ind = v-pos-ind + 1
      316         .
      317       end.
      318     end.
      319     if last-event :label = "backspace" then do:
      320       assign
      321         v-length = length(f-value)
      322       .
      323       if  v-length > 0
      324       and v-pos-ind > 1
      325       then do:
      326         assign
      327           f-value = substring(f-value, 1, v-pos-ind - 2)
      328                    + substring(f-value, v-pos-ind, v-length - v-pos-ind + 1)
      329         .
      330         assign
      331           v-pos-ind = v-pos-ind - 1
      332         .
      333       end.
      334     end.
      335     if last-event :label = "del" then do:
      336       assign
      337         v-length = length(f-value)
      338       .
      339       if  v-length > 0
      340       and v-pos-ind < v-length + 1
      341       and v-pos-ind > 0
      342       then do:
      343         assign
      344           f-value = substring(f-value, 1, v-pos-ind - 1)
      345                    + substring(f-value, v-pos-ind + 1, v-length - v-pos-ind + 1)
      346         .
      347       end.
      348     end.
      349     if last-event :label = "home" then do:
      350       assign
      351         v-pos-ind = 1
      352       .
      353     end.
      354     if last-event :label = "end" then do:
      355       assign
      356         v-pos-ind = v-length + 1
      357       .
      358     end.
      359     if last-event :label = "cursor-left"
      360     then do:
      361       if v-pos-ind > 1
      362       then do:
      363         assign
      364           v-pos-ind = v-pos-ind - 1
      365         .
      366       end.
      367     end.
      368     if last-event :label = "cursor-right"
      369     then do:
      370       if v-pos-ind < length(f-value) + 1
      371       then do:
      372         assign
      373           v-pos-ind = v-pos-ind + 1
      374         .
      375       end.
      376     end.
      377     assign
      378       v-pos = fill(" ", v-pos-ind - 1) + "|"
      379       .
      380     display f-value v-pos with frame Dialog-Frame .
      381   end.
      382   MAIN-BLOCK:
      383   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      384      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      385     RUN MYenable.
      386     WAIT-FOR GO OF FRAME Dialog-Frame.
      387   END.
      388   RUN disable_UI.
      389   PROCEDURE disable_UI :
      390     HIDE FRAME Dialog-Frame.
      391   END PROCEDURE.
      392   PROCEDURE enable_UI :
      393     DISPLAY f-value v-pos EDITOR-1
      394         WITH FRAME Dialog-Frame.
      395     ENABLE B-exit b-quit B-Help f-value v-pos EDITOR-1
      396         WITH FRAME Dialog-Frame.
      397     VIEW FRAME Dialog-Frame.
      398   END PROCEDURE.
      399   PROCEDURE MyEnable :
      400   ASSIGN
      401   v-pos-ind = Length(p-field)  + 1
      402   f-value = p-field
      403   f-value:BGCOLOR IN FRAME Dialog-Frame = white_color
      404   v-pos = fill(" ", v-pos-ind - 1) + "|"
      405   frame Dialog-Frame:title  = p-title
      406   f-value:label = p-label
      407   f-value:format = "X(" + string(p-length) + ")"
      408   editor-1:SCREEN-VALUE = SUBSTITUTE("Для ввода &1 следует использовать клавиши &2, ", p-label, p-validchars) +
      409             "для редактирования следует использовать клавиши BACK-SPACE, DELETE, HOME, END, ->, <-"
      410   .
      411   DISPLAY f-value v-pos
      412         WITH FRAME Dialog-Frame.
      413     ENABLE B-exit b-quit B-Help v-pos
      414         WITH FRAME Dialog-Frame.
      415     VIEW FRAME Dialog-Frame.
      416   END PROCEDURE.
