        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-obj-type    as character no-undo .
        4   define input parameter p-obj-code    as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: showcli.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/showcli.p $":U .
       10   define variable vss-description as character no-undo init "Показать клиента".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72     define variable v-cntxt-db-num        as integer   no-undo .
       73     define variable v-cntxt-userid        as character no-undo .
       74     define variable v-cntxt-level         as character no-undo .
       75     define variable v-cntxt-host-code-obj as integer   no-undo .
       76     define variable v-cntxt-obj-type      as character no-undo .
       77     define variable v-cntxt-obj-code      as integer   no-undo .
       78     define variable v-cntxt-db-num-obj    as integer   no-undo .
       79     define variable v-cntxt-is-admin      as logical   no-undo .
       80   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81     run mainmenu_getcntxt in parparentproc
       82       (output v-cntxt-db-num
       83       ,output v-cntxt-userid
       84       ,output v-cntxt-level
       85       ,output v-cntxt-host-code-obj
       86       ,output v-cntxt-obj-type
       87       ,output v-cntxt-obj-code
       88       ,output v-cntxt-db-num-obj
       89       ,output v-cntxt-is-admin
       90       ) .
       91   define var loc#log as logical no-undo.
       92   define buffer buf_sysconf for ub.sysconf .
       93   do
       94   on error undo, return error return-value
       95   :
       96     find first ub.clients no-lock
       97       where ub.clients.obj-type = p-obj-type
       98         and ub.clients.obj-code = p-obj-code
       99       no-error .
      100     if not available ub.clients
      101     then do:
      102       message
      103         "Ошибка задания входных параметров" skip
      104         "Не найден клиент" p-obj-type p-obj-code skip
      105         view-as alert-box error .
      106       undo, return error return-value .
      107     end.
      108     define variable ri as recid no-undo .
      109     assign
      110       ri = recid (ub.clients)
      111     .
      112     CASE p-obj-type :
      113       when 'орг':U
      114       then do:
      115   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   do:
      117     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      118       (input  v-cntxt-db-num
      119       ,input  v-cntxt-userid
      120       ,input  0
      121       ,input  'actn_client-reference_lookup':U
      122       ,input  'global':U
      123       ,input  0
      124       ,input  '':U
      125       ,input  0
      126       ,input  0
      127       ,input  0
      128       ,input  0
      129       ,input  true
      130       ,output loc#log
      131       )  .
      132   end.
      133         if not loc#log
      134         then do:
      135           return.
      136         end.
      137         find first buf_sysconf no-lock
      138           where buf_sysconf.host-code = ub.clients.obj-code
      139           no-error .
      140         if available buf_sysconf
      141         then do:
      142           run adm/config.w
      143             (input  parparentproc
      144             ,input  ub.clients.obj-code
      145             ,input  'ПРОСМОТР':U
      146             ,input  false
      147             ) .
      148         end.
      149         else do:
      150           run ref/firmi.w
      151             (input  parparentproc
      152             ,input  'ПРОСМОТР':U
      153             ,input  ub.clients.obj-code
      154             ,input  ub.clients.grp-code
      155             ,input  "cli-all"
      156             ,input-output ri
      157             ) .
      158         end.
      159       end.
      160       when 'чел':U
      161       then do:
      162   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      163   do:
      164     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      165       (input  v-cntxt-db-num
      166       ,input  v-cntxt-userid
      167       ,input  0
      168       ,input  'actn_client-reference_lookup':U
      169       ,input  'global':U
      170       ,input  0
      171       ,input  '':U
      172       ,input  0
      173       ,input  0
      174       ,input  0
      175       ,input  0
      176       ,input  true
      177       ,output loc#log
      178       )  .
      179   end.
      180         if not loc#log
      181         then do:
      182           return.
      183         end.
      184         run ref/personi.w
      185           (input  parparentproc
      186           ,input  'ПРОСМОТР':U
      187           ,input  ub.clients.obj-code
      188           ,input  ub.clients.grp-code
      189           ,input  'cli-all':U
      190           ,input-output ri
      191           ).
      192       end.
      193       when 'маг':U
      194       then do:
      195         run adm/shopi.w
      196           (input  parParentProc
      197           ,input  0
      198           ,input  ub.clients.obj-code
      199           ,input  'ПРОСМОТР':U
      200           ,input-output ri
      201           ).
      202       end.
      203       when 'скл':U
      204       then do:
      205         run adm/storei.w
      206           (input  parParentProc
      207           ,input  0
      208           ,input  ub.clients.obj-code
      209           ,input  'ПРОСМОТР':U
      210           ,input-output ri
      211           ).
      212       end.
      213       otherwise do:
      214         message
      215           "showcli.p: Неизвестный тип клиента" skip
      216           "p-obj-type" p-obj-type skip
      217           view-as alert-box error .
      218         return .
      219       end.
      220     end case .
      221   end.
