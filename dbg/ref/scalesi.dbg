        1   DEFINE BUFFER locked_scales FOR ub.scales.
        2   DEFINE TEMP-TABLE tt-scales NO-UNDO LIKE ub.scales.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        5   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        6   define input parameter p-mode as char no-undo .
        7   define input parameter p-db-num like ub.db.db-nu  no-undo .
        8   define input parameter p-scales-num like ub.scales.scales-num no-undo .
        9   define output parameter p-rid as recid no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Карточка весов".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define new global shared variable g#library  as handle no-undo .
      120   define new global shared variable g#library2 as handle no-undo .
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122     define variable v-cntxt-db-num        as integer   no-undo .
      123     define variable v-cntxt-userid        as character no-undo .
      124     define variable v-cntxt-level         as character no-undo .
      125     define variable v-cntxt-host-code-obj as integer   no-undo .
      126     define variable v-cntxt-obj-type      as character no-undo .
      127     define variable v-cntxt-obj-code      as integer   no-undo .
      128     define variable v-cntxt-db-num-obj    as integer   no-undo .
      129     define variable v-cntxt-is-admin      as logical   no-undo .
      130   define buffer b-scales for ub.scales .
      131   define variable ini-types as char no-undo init ?.
      132   define variable ini-model as char no-undo .
      133   define variable ii as int no-undo .
      134   define variable glog as logical no-undo .
      135   define variable v-rid as recid no-undo .
      136   define variable v-param-type as character no-undo .
      137   define variable v-value-character as character no-undo .
      138   define variable v-value-date as date no-undo .
      139   define variable v-value-decimal as decimal no-undo .
      140   define variable v-value-integer as INTEGER no-undo .
      141   define variable v-value-logical AS LOGICAL no-undo .
      142   define variable v-tth as handle no-undo .
      143   DEFINE BUTTON b-attr
      144        LABEL "&Атрибуты"
      145        SIZE 10 BY 1.
      146   DEFINE BUTTON B-exit AUTO-GO
      147        LABEL "&Ввод"
      148        SIZE 10 BY 1
      149        BGCOLOR 8 .
      150   DEFINE BUTTON B-help
      151        LABEL "Помо&щь"
      152        SIZE 3 BY 1
      153        BGCOLOR 8 .
      154   DEFINE BUTTON B-quit AUTO-END-KEY
      155        LABEL "&Отмена"
      156        SIZE 10 BY 1
      157        BGCOLOR 8 .
      158   DEFINE BUTTON r-base
      159        IMAGE-UP FILE "btn-down-arrow":U
      160        IMAGE-DOWN FILE "btn-down-arrow":U
      161        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      162        LABEL ""
      163        SIZE 3 BY 1.
      164   DEFINE RECTANGLE RECT-1
      165        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      166        SIZE 72.75 BY 16.25.
      167   DEFINE VARIABLE S-type AS CHARACTER
      168        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      169        SIZE 18.25 BY 9
      170        BGCOLOR 15  NO-UNDO.
      171   DEFINE QUERY d-scalesi FOR
      172         ub.scales,
      173         tt-scales SCROLLING.
      174   DEFINE FRAME d-scalesi
      175        B-exit AT ROW 1 COL 1
      176        B-quit AT ROW 1 COL 11
      177        b-attr AT ROW 1 COL 37
      178        B-help AT ROW 1 COL 73
      179        tt-scales.scales-num AT ROW 3 COL 14.88 COLON-ALIGNED
      180             LABEL "Номер"
      181             VIEW-AS FILL-IN
      182             SIZE 7 BY 1
      183        tt-scales.master AT ROW 4.25 COL 14.88 COLON-ALIGNED
      184             LABEL "Главные"
      185             VIEW-AS FILL-IN
      186             SIZE 6.75 BY 1
      187        tt-scales.scales-name AT ROW 5.5 COL 14.88 COLON-ALIGNED
      188             LABEL "Название"
      189             VIEW-AS FILL-IN
      190             SIZE 31.38 BY 1
      191        S-type AT ROW 6.75 COL 17 NO-LABEL
      192        tt-scales.max-gds AT ROW 7 COL 62 COLON-ALIGNED
      193             LABEL "Максимальная номенклатура"
      194             VIEW-AS FILL-IN
      195             SIZE 6 BY 1.13
      196        tt-scales.address AT ROW 16 COL 14.88 COLON-ALIGNED
      197             LABEL "Адрес"
      198             VIEW-AS FILL-IN
      199             SIZE 38.13 BY 1
      200        tt-scales.unit-base AT ROW 17.25 COL 35.88 COLON-ALIGNED
      201             LABEL "Основная единица измерения"
      202             VIEW-AS FILL-IN
      203             SIZE 4.88 BY 1.08
      204        r-base AT ROW 17.25 COL 44
      205        " Тип" VIEW-AS TEXT
      206             SIZE 8 BY 1 AT ROW 7.33 COL 7.63
      207        RECT-1 AT ROW 2.25 COL 2.38
      208        SPACE(1.11) SKIP(0.25)
      209       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      210            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      211            TITLE "  Весы"
      212            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      213   ASSIGN
      214          FRAME d-scalesi:SCROLLABLE       = FALSE
      215          FRAME d-scalesi:HIDDEN           = TRUE.
      216   ON WINDOW-CLOSE OF FRAME d-scalesi
      217   DO:
      218     APPLY "END-ERROR":U TO SELF.
      219   END.
      220   ON CHOOSE OF b-attr IN FRAME d-scalesi
      221   DO:
      222       run ref/scl-atti.w ( INPUT parparentproc
      223                     ,INPUT   'ПРОСМОТР':U
      224                     ,INPUT tt-scales.db-num
      225                     ,INPUT tt-scales.scales-num
      226                    ) NO-ERROR.
      227   END.
      228   ON CHOOSE OF B-exit IN FRAME d-scalesi
      229   DO:
      230   RUN proc-save IN THIS-PROCEDURE no-error.
      231   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      232   END.
      233   ON CHOOSE OF r-base IN FRAME d-scalesi
      234   DO:
      235     define variable ref-rec as recid no-undo .
      236     DEFINE BUFFER buf_units FOR ub.units.
      237       run ref/units.w ( input parparentproc, input yes, output ref-rec ).
      238       if ref-rec = ? THEN do:
      239               apply "entry" to r-base in frame d-scalesi.
      240               return no-apply.
      241       end.
      242       FIND buf_units WHERE recid (buf_units) = ref-rec NO-LOCK.
      243       if lookup('вес':U, buf_units.type) = 0 then do:
      244           message "Вы выбрали невесовую единицу измерения!" view-as alert-box ERROR.
      245           apply "entry" to r-base in frame d-scalesi.
      246           return no-apply.
      247       end.
      248       DISPLAY
      249       buf_units.unit-name @ tt-scales.unit-base
      250       with frame d-scalesi.
      251   END.
      252   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-scalesi:PARENT eq ?
      253   THEN FRAME d-scalesi:PARENT = ACTIVE-WINDOW.
      254   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255   on help of frame d-scalesi
      256   do:
      257     run gbl/app_help.p
      258       (input this-procedure :file-name
      259       ,input ''
      260       ,input ?
      261       ) no-error.
      262     if error-status :error then do:
      263       message
      264         "Ошибка при вызове помощи"
      265         error-status :get-message(1)
      266         view-as alert-box .
      267     end.
      268   end.
      269   run minbtn-set in this-procedure .
      270   on choose of b-help in frame d-scalesi
      271   do:
      272     apply "help":u to frame d-scalesi .
      273   end.
      274   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      275   procedure minbtn-set :
      276       do
      277           on error undo, return error return-value
      278           :
      279           define variable ii              as integer       no-undo .
      280           define variable fh              as widget-handle no-undo .
      281           define variable hh              as widget-handle no-undo .
      282           define variable v-h             as handle        extent 4 no-undo .
      283           define variable v-name-button   as character     no-undo .
      284           define variable v-help-old-x    as decimal       no-undo .
      285           define variable v-help-old-y    as decimal       no-undo .
      286           define variable v-help-old-size as decimal       no-undo .
      287           define variable v-frame-width   as decimal       no-undo .
      288           define variable jj              as integer       no-undo .
      289           do
      290               on error undo, return error
      291               :
      292               assign
      293                   v-frame-width = frame d-scalesi:width - 0.3
      294                   fh            = frame d-scalesi:first-child
      295                   hh            = fh:first-child
      296                   ii            = 1
      297                   .
      298               do while valid-handle(hh):
      299                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      300                   do:
      301                       case lc(hh:name) :
      302                           when "b-help" then
      303                               do:
      304                                   hh:load-image-up("cmp/b-help.bmp":u) .
      305                                   hh:load-image-down("cmp/b-help.bmp":u) .
      306                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      307                                   hh:TOOLTIP = "Помощь" .
      308                                   v-help-old-x = hh:column .
      309                                   v-help-old-y = hh:row    .
      310                                   v-help-old-size = hh:width .
      311                                   hh:width-chars = 2.5 .
      312                               end.
      313                           when "b-print" then
      314                               do:
      315                                   hh:load-image("cmp/b-print.bmp":u) .
      316                                   hh:TOOLTIP = "Печать" .
      317                                   v-h[ii] = hh:handle .
      318                                   ii = ii + 1 .
      319                                   hh:width-chars = 3 .
      320                               end.
      321                           when "b-history" or
      322                           when "b-hist" then
      323                               do:
      324                                   hh:load-image("cmp/b-hist.bmp":u) .
      325                                   hh:TOOLTIP = "История" .
      326                                   v-h[ii] = hh:handle .
      327                                   ii = ii + 1 .
      328                                   hh:width-chars = 3 .
      329                               end.
      330                           when "b-sch" then
      331                               do:
      332                                   hh:load-image("cmp/b-sch.bmp":u) .
      333                                   hh:TOOLTIP = "Установка Фильтра" .
      334                                   v-h[ii] = hh:handle .
      335                                   ii = ii + 1 .
      336                                   hh:width-chars = 3 .
      337                               end.
      338                           when "b-hist-user" then
      339                               do:
      340                                   hh:load-image("cmp/b-hist.bmp":u) .
      341                                   hh:TOOLTIP = "История пользователя" .
      342                                   ii = ii + 1 .
      343                               end.
      344                       end case.
      345                   end.
      346                   hh = hh:next-sibling.
      347               end.
      348               b-help:column = v-frame-width - b-help:width-chars.
      349               jj = 0.
      350               repeat ii = 4 to 1 by -1 :
      351                   if valid-handle (v-h[ii] ) then
      352                   do:
      353                       jj  = jj + 1 .
      354                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      355                       v-h[ii]:row    = v-help-old-y .
      356                   end.
      357               end.
      358           end.
      359       end.
      360   end procedure.
      361   MAIN-BLOCK:
      362   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      363      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      364      ON STOP UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      365      :
      366   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367     run mainmenu_getcntxt in parparentproc
      368       (output v-cntxt-db-num
      369       ,output v-cntxt-userid
      370       ,output v-cntxt-level
      371       ,output v-cntxt-host-code-obj
      372       ,output v-cntxt-obj-type
      373       ,output v-cntxt-obj-code
      374       ,output v-cntxt-db-num-obj
      375       ,output v-cntxt-is-admin
      376       ) .
      377      IF p-mode <> 'ИЗМЕНЕНИЕ':U
      378      AND p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
      379         MESSAGE
      380         substitute("Неверное значение параметра p-mode = &1", p-mode)
      381         VIEW-AS ALERT-BOX ERROR.
      382         RETURN ERROR.
      383      END.
      384      if p-db-num <> v-cntxt-db-num
      385      and (p-mode = 'ДОБАВЛЕНИЕ':U
      386           or
      387           p-mode = 'ИЗМЕНЕНИЕ':U)
      388      then do:
      389       message
      390       "Нельзя изменять/добавлять ВЕСЫ в чужой БД"
      391       view-as alert-box error .
      392       undo, return error .
      393      end.
      394       run adm/shattri.p (
      395           input "get":U
      396         ,input  p-obj-type
      397         ,input  p-obj-code
      398         ,input  'scale-inf':U
      399         ,input  'scales-type':U
      400         , output v-value-character
      401         , output v-value-date
      402         , output v-value-decimal
      403         , output v-value-integer
      404         , output v-value-logical
      405         , output v-param-type
      406         , INPUT-OUTPUT table-handle v-tth
      407         ) no-error .
      408       IF error-status:error then do:
      409         delete object v-tth.
      410           message
      411           substitute("Ошибка при получении настроек, необъодимых для работы весов НА ОБЪЕКТЕ &1&2:&3&4 &5"
      412                   , p-obj-type
      413                   , p-obj-code
      414                   , chr(10)
      415                   , error-status:get-message(1)
      416                   , return-value )
      417           view-as alert-box error .
      418           undo, return error .
      419       end.
      420       delete object v-tth.
      421       assign
      422       ini-types =  v-value-character.
      423       if ini-types = ?
      424       or ini-types = '':U then do:
      425         message
      426         'Ошибка! Не заданы используемые типы весов!' SKIP
      427         'АРМ Администратор-Справочники-Магазины-Параметры-Опции работы с весами'
      428         view-as alert-box error .
      429         return error .
      430       end.
      431       IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      432           FIND FIRST LOCKED_scales exclusive-LOCK WHERE
      433                    LOCKED_scales.db-num = p-db-num
      434                AND LOCKED_scales.scales-num = p-scales-num .
      435         v-rid = recid(locked_scales).
      436       END.
      437       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      438           glog = no.
      439           DO ii = 1 TO num-entries( ini-types ) :
      440               if entry(ii, ini-types) = locked_scales.scales-type then glog = yes.
      441           END .
      442         if not glog then do:
      443           message
      444           substitute("Ошибка! В списке используемых весов&1"  +
      445                      "нет типа весов &2!", LOCKED_scales.scales-type)
      446           view-as alert-box error .
      447           return error .
      448         end.
      449       end.
      450       S-Type:list-items = ini-types .
      451       if can-do( 'ДОБАВЛЕНИЕ':U, p-mode ) then do:
      452           CREATE tt-scales.
      453           assign
      454           tt-scales.max-gds = 999
      455           tt-scales.scales-type = entry( 1, ini-types )
      456           tt-scales.address = "COM1"
      457           tt-scales.db-num  = p-db-num
      458           tt-scales.sts     = integer('0':U)
      459           frame d-scalesi:title = substitute("&1    - &2"
      460                                                  ,frame d-scalesi:title
      461                                                  ,'ДОБАВЛЕНИЕ':U) .
      462       end.
      463       else do:
      464           CREATE tt-scales.
      465           BUFFER-COPY locked_scales TO tt-scales.
      466           frame d-scalesi:title = substitute("&1    - &2"
      467                                                  ,frame d-scalesi:title
      468                                                  ,'ИЗМЕНЕНИЕ':U) .
      469      end.
      470       RUN MyEnable IN THIS-PROCEDURE.
      471       if S-Type:num-items < 2 then
      472           S-Type:inner-lines = 1 .
      473       S-Type:screen-value = tt-scales.scales-type .
      474       glog = S-Type:scroll-to-item ( tt-scales.scales-type ) .
      475       if can-do( 'ДОБАВЛЕНИЕ':U, p-mode ) then
      476           WAIT-FOR GO OF FRAME d-scalesi focus tt-scales.scales-num.
      477       else
      478           WAIT-FOR GO OF FRAME d-scalesi focus tt-scales.scales-name .
      479   END.
      480   RUN disable_UI.
      481   PROCEDURE disable_UI :
      482     HIDE FRAME d-scalesi.
      483   END PROCEDURE.
      484   PROCEDURE enable_UI :
      485     DISPLAY S-type
      486         WITH FRAME d-scalesi.
      487     IF AVAILABLE tt-scales THEN
      488       DISPLAY tt-scales.scales-num tt-scales.master tt-scales.scales-name
      489             tt-scales.max-gds tt-scales.address tt-scales.unit-base
      490         WITH FRAME d-scalesi.
      491     ENABLE B-exit B-quit b-attr B-help RECT-1 tt-scales.scales-num
      492            tt-scales.master tt-scales.scales-name S-type tt-scales.max-gds
      493            tt-scales.address tt-scales.unit-base r-base
      494         WITH FRAME d-scalesi.
      495     VIEW FRAME d-scalesi.
      496   END PROCEDURE.
      497   PROCEDURE MyEnable :
      498   IF AVAILABLE tt-scales THEN do:
      499       if tt-scales.master = 0 and LOOKUP('ДОБАВЛЕНИЕ':U, p-mode) = 0 then
      500       HIDE tt-scales.master
      501       IN frame d-scalesi.
      502       ELSE
      503       DISPLAY
      504       tt-scales.master
      505       WITH FRAME d-scalesi.
      506       DISPLAY
      507       tt-scales.max-gds
      508       tt-scales.scales-num
      509       tt-scales.scales-name
      510       tt-scales.address
      511       tt-scales.unit-base
      512       S-Type
      513       WITH FRAME d-scalesi.
      514   end.
      515   ENABLE
      516   tt-scales.max-gds WHEN not(lookup('ИЗМЕНЕНИЕ':U, p-mode) > 0 and tt-scales.master > 0)
      517   b-exit
      518   b-quit
      519   b-help
      520   r-base WHEN not(lookup('ИЗМЕНЕНИЕ':U, p-mode) > 0 and tt-scales.master > 0)
      521   tt-scales.scales-num WHEN can-do( 'ДОБАВЛЕНИЕ':U, p-mode )
      522   tt-scales.master WHEN  can-do( 'ДОБАВЛЕНИЕ':U, p-mode )
      523   tt-scales.scales-name
      524   tt-scales.address
      525   tt-scales.unit-base WHEN not(lookup('ИЗМЕНЕНИЕ':U, p-mode) > 0 and tt-scales.master > 0)
      526   S-Type WHEN not(lookup('ИЗМЕНЕНИЕ':U, p-mode) > 0 and tt-scales.master > 0)
      527   b-attr when p-mode <> 'ДОБАВЛЕНИЕ':U
      528   WITH FRAME d-scalesi.
      529   VIEW FRAME d-scalesi.
      530   END PROCEDURE.
      531   PROCEDURE proc-save :
      532   define variable choice as log no-undo .
      533   define buffer b-scales-gds for ub.scales-gds.
      534   define buffer b-scales-grp for ub.scales-grp.
      535   ASSIGN FRAME d-scalesi
      536   tt-scales.scales-num
      537   tt-scales.scales-name
      538   tt-scales.address
      539   tt-scales.unit-base
      540   tt-scales.master
      541   tt-scales.max-gds
      542   s-type
      543   tt-scales.scales-type = s-type
      544   .
      545   if p-mode = 'ИЗМЕНЕНИЕ':U then p-rid = recid(locked_scales).
      546   run ref/scales1.p (
      547    input-output p-rid
      548   ,input p-mode
      549   ,INPUT NO
      550   ,input tt-scales.db-num
      551   ,input tt-scales.scales-num
      552   ,input tt-scales.address
      553   ,input tt-scales.master
      554   ,input tt-scales.max-gds
      555   ,input tt-scales.scales-name
      556   ,input tt-scales.scales-type
      557   ,input tt-scales.remote
      558   ,input tt-scales.sts
      559   ,input tt-scales.unit-base
      560   ,input tt-scales.wt-cart
      561   ) no-error .
      562   if error-status:error then do:
      563   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      564   define variable fh as widget-handle no-undo .
      565   define variable hh as widget-handle no-undo .
      566   define variable rv as character no-undo .
      567   assign
      568   rv = entry(1, return-value , chr(4)).
      569   if rv <> "":U then do:
      570     assign
      571     fh = frame d-scalesi:first-child
      572     hh = fh:first-child
      573     .
      574     do while valid-handle(hh):
      575       if hh:name = rv then do:
      576         APPLY "ENTRY" to hh.
      577         undo ,
      578         return error.
      579       end.
      580       hh = hh:next-sibling.
      581     end.
      582   end.
      583     undo, return error.
      584   end.
      585   END PROCEDURE.
