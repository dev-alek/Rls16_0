     1159   procedure proc-color-widgets :
     1160   define input parameter p-list as character no-undo .
     1161   define input parameter p-fg as logical no-undo .
     1162   define input parameter p-bg as logical no-undo .
     1163   define input parameter p-fgc as integer no-undo .
     1164   define input parameter p-bgc as integer no-undo .
     1165   define variable ii as integer no-undo .
     1166   define variable fh as widget-handle no-undo .
     1167   define variable hh as widget-handle no-undo .
     1168     do
     1169     on error undo, return error
     1170     :
     1171       assign
     1172       fh = frame Dialog-Frame:first-child
     1173       hh = fh:first-child
     1174       .
     1175       do while valid-handle(hh):
     1176         if LOOKUP(hh:name, p-list) > 0  then do:
     1177           assign
     1178           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     1179           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     1180           .
     1181         end.
     1182         hh = hh:next-sibling.
     1183       end.
     1184     end.
     1185   end procedure.
