     1616       f-contract-prn-code when tt-c-fin-doc.contract-code <> 0
     1617       f-contract-type when tt-c-fin-doc.contract-code <> 0
     1618       f-contract-curr-abbr when tt-c-fin-doc.contract-code <> 0
     1619       tt-c-fin-doc.contract-curr when tt-c-fin-doc.contract-code <> 0
     1620       with frame Dialog-Frame
     1621       .
     1622       ENABLE
     1623       b-contract-view
     1624       with frame Dialog-Frame.
     1625     end.
     1626   END CASE.
     1627   END PROCEDURE.
     1628   PROCEDURE disable_UI :
     1629     HIDE FRAME Dialog-Frame.
     1630   END PROCEDURE.
     1631   PROCEDURE enable_UI :
     1632     OPEN QUERY Dialog-Frame FOR EACH locked_c-fin-doc SHARE-LOCK.
     1633     GET FIRST Dialog-Frame.
     1634     DISPLAY RS-view f-cor-acc-descr f-an-uchet-descr f-contract-curr-abbr
     1635             f-contract-prn-code f-contract-date f-contract-type f-cel-nazn-descr
     1636             f-cor-acc1-descr F-curr-abbr F-debet F-credit
     1637         WITH FRAME Dialog-Frame.
     1638     IF AVAILABLE tt-c-fin-doc THEN
     1639       DISPLAY tt-c-fin-doc.user-name-doc tt-c-fin-doc.prn-doc-code
     1640             tt-c-fin-doc.fin-doc-code tt-c-fin-doc.perm-date tt-c-fin-doc.doc-date
     1641             tt-c-fin-doc.user-name-perm tt-c-fin-doc.obj-type
     1642             tt-c-fin-doc.obj-code tt-c-fin-doc.fact-date
     1643             tt-c-fin-doc.user-name-fact tt-c-fin-doc.payer-type
     1644             tt-c-fin-doc.payer-code tt-c-fin-doc.payer-okpo
     1645             tt-c-fin-doc.payer-name tt-c-fin-doc.str-podr-type
     1646             tt-c-fin-doc.str-podr-code tt-c-fin-doc.str-podr-name
     1647             tt-c-fin-doc.cor-acc-value tt-c-fin-doc.an-uchet-value
     1648             tt-c-fin-doc.contract-curr tt-c-fin-doc.cel-nazn-value
     1649             tt-c-fin-doc.cor-acc1-value tt-c-fin-doc.sum-doc
     1650             tt-c-fin-doc.curr-code tt-c-fin-doc.exch-rate tt-c-fin-doc.exch-scale
     1651             tt-c-fin-doc.sum-rubl tt-c-fin-doc.base-rate tt-c-fin-doc.base-scale
     1652             tt-c-fin-doc.sum-base tt-c-fin-doc.contract-rate
     1653             tt-c-fin-doc.contract-scale tt-c-fin-doc.sum-contr
     1654             tt-c-fin-doc.receiver-type tt-c-fin-doc.receiver-code
     1655             tt-c-fin-doc.receiver-name tt-c-fin-doc.naznach-plat
     1656             tt-c-fin-doc.receiver-passport tt-c-fin-doc.enclosure tt-c-fin-doc.PS
     1657             tt-c-fin-doc.payer-sign1 tt-c-fin-doc.payer-sign2
     1658             tt-c-fin-doc.payer-sign3
     1659         WITH FRAME Dialog-Frame.
     1660     ENABLE B-exit b-quit B-tax B-Help RS-view tt-c-fin-doc.user-name-doc
     1661            tt-c-fin-doc.prn-doc-code tt-c-fin-doc.doc-date tt-c-fin-doc.obj-type
     1662            tt-c-fin-doc.obj-code tt-c-fin-doc.payer-name B-payer-view
     1663            tt-c-fin-doc.str-podr-type tt-c-fin-doc.str-podr-code
     1664            tt-c-fin-doc.str-podr-name tt-c-fin-doc.cor-acc-value
     1665            tt-c-fin-doc.an-uchet-value f-contract-curr-abbr B-contract-view
     1666            tt-c-fin-doc.contract-curr tt-c-fin-doc.cel-nazn-value
     1667            tt-c-fin-doc.cor-acc1-value tt-c-fin-doc.sum-doc
     1668            tt-c-fin-doc.curr-code tt-c-fin-doc.exch-rate tt-c-fin-doc.exch-scale
     1669            tt-c-fin-doc.sum-base tt-c-fin-doc.contract-rate
     1670            tt-c-fin-doc.contract-scale tt-c-fin-doc.sum-contr
     1671            tt-c-fin-doc.receiver-type tt-c-fin-doc.receiver-code
     1672            tt-c-fin-doc.receiver-name B-receiver-view tt-c-fin-doc.naznach-plat
     1673            tt-c-fin-doc.receiver-passport tt-c-fin-doc.enclosure tt-c-fin-doc.PS
     1674            tt-c-fin-doc.payer-sign1 tt-c-fin-doc.payer-sign2
     1675            tt-c-fin-doc.payer-sign3
     1676         WITH FRAME Dialog-Frame.
     1677     VIEW FRAME Dialog-Frame.
     1678   END PROCEDURE.
     1679   PROCEDURE fill-main-table :
     1680   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1682     (output v-db-num
     1683     )  .
     1684   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1686     (input  p-host-code
     1687     ,output v-base-code
     1688     )  .
     1689   find first X_curr_sysconf no-lock where
     1690                   X_curr_sysconf.host-code = p-curr-host-code.
     1691   find first X_sysconf no-lock where
     1692                 X_sysconf.host-code = p-host-code.
     1693   find first X_clients-host no-lock where
     1694               X_clients-host.obj-type = 'орг':U
     1695           AND   X_clients-host.obj-code = p-host-code  no-error.
     1696   if not available X_clients-host then do:
     1697     message
     1698     vss-workfile vss-revision vss-description skip
     1699     "Неверное значение параметра вызова p-host-code"  p-host-code
     1700     view-as alert-box ERROR.
     1701     undo, return error.
     1702   end.
     1703   find first X_firm no-lock where
     1704               X_firm.firm-code = p-host-code.
     1705   for each tt-c-fin-doc:
     1706     delete tt-c-fin-doc.
     1707   end.
     1708   for each tt0-fin-doc-attr:
     1709     delete tt0-fin-doc-attr.
     1710   end.
     1711   for each tt0-fin-doc-tax:
     1712    delete tt0-fin-doc-tax.
     1713   end.
     1714   find first locked_c-fin-doc no-lock where
     1715               recid(locked_c-fin-doc) = p-doc-rec no-error .
     1716   if not available locked_c-fin-doc then do:
     1717     find first locked_c-fin-doc no-lock where
     1718                 locked_c-fin-doc.host-code = p-host-code
     1719             AND locked_c-fin-doc.fin-doc-code = p-fin-doc-code no-error .
     1720   end.
     1721   if not available locked_c-fin-doc then do:
     1722   message
     1723   vss-workfile vss-revision vss-description skip
     1724   "Не найдена запись истории РАСХОДНОГО ОРДЕРА"
     1725   view-as alert-box error .
     1726   undo, return error.
     1727   end.
     1728   create tt-c-fin-doc.
     1729   buffer-copy locked_c-fin-doc to tt-c-fin-doc.
     1730   END PROCEDURE.
     1731   PROCEDURE Myenable :
     1732   define variable g-log as logical no-undo.
     1733   assign
     1734       tt-c-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     1735   .
     1736   run uf-get in this-procedure(
     1737       input  ('findoci-p':U + chr(4) + 'рко':U)
     1738       ,input  v-cntxt-userid
     1739       ,output v-uf-List_
     1740       ,output v-uf-Naim
     1741       ,output v-uf-print-graft
     1742       ,output v-uf-sort-gr
     1743       ,output v-uf-type-price
     1744       ,output v-uf-type-val
     1745   )  no-error.
     1746   if not error-status:error
     1747   and not v-uf-LIst_ = "":U
     1748   then do:
     1749       assign
     1750       v-view =  entry(1, v-uf-List_, chr(4))
     1751       .
     1752   end.
     1753   assign
     1754   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     1755   tt-c-fin-doc.receiver-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     1756                                            "Чел" + chr(44) + 'чел':U
     1757   rs-view:radio-buttons = "&Полностью" + chr(44) + "full":U +  chr(44) +
     1758                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     1759                                       "&Договор" + chr(44) + "contract":U
     1760   rs-view = v-view
     1761   tt-c-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     1762                                         "Скл" + chr(44) + 'скл':U
     1763   .
     1764   if tt-c-fin-doc.contract-code = 0 then do:
     1765       assign
     1766       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     1767       .
     1768       if rs-view = "contract":U then
     1769       assign
     1770       rs-view = "full":U
     1771       v-not-uf-set = yes.
     1772   end.
     1773   find first X_currency no-lock where
     1774                 X_currency.curr-code = tt-c-fin-doc.curr-code.
     1775   assign
     1776   f-curr-abbr = X_Currency.curr-abbr.
     1777   if tt-c-fin-doc.contract-code <> 0 then do:
     1778     find first X_currency no-lock where
     1779                   X_currency.curr-code = tt-c-fin-doc.contract-curr.
     1780     assign
     1781     f-contract-curr-abbr = X_Currency.curr-abbr.
     1782   end.
     1783   assign
     1784   tt-c-fin-doc.payer-sign1:label  = tt-c-fin-doc.payer-sign1:label  + " - ":U +
     1785                             (if num-entries(tt-c-fin-doc.payer-sign1, chr(4)) > 1
     1786                             then entry(1, tt-c-fin-doc.payer-sign1, chr(4))
     1787                             else "":U)
     1788   tt-c-fin-doc.payer-sign1 =   (if num-entries(tt-c-fin-doc.payer-sign1, chr(4)) > 1
     1789                                     then entry(2, tt-c-fin-doc.payer-sign1, chr(4))
     1790                                     else entry(1, tt-c-fin-doc.payer-sign1, chr(4)))
     1791   .
     1792   find first X_receiver no-lock where
     1793             X_receiver.obj-type = tt-c-fin-doc.receiver-type
     1794         and X_receiver.obj-code = tt-c-fin-doc.receiver-code.
     1795   if tt-c-fin-doc.cor-acc1 <> 0 then do:
     1796       find first X_fin-code-cor-acc1 no-lock where
     1797                   X_fin-code-cor-acc1.fin-code  = tt-c-fin-doc.cor-acc1 no-error.
     1798       if available X_fin-code-cor-acc1 then do:
     1799         assign
     1800         f-cor-acc1-descr = X_fin-code-cor-acc1.descr.
     1801       end.
     1802       if not available X_fin-code-cor-acc1 then do:
     1803         assign
     1804         f-cor-acc1-descr = "!!!Код больше не существует".
     1805       end.
     1806   end.
     1807   if tt-c-fin-doc.cor-acc <> 0 then do:
     1808       find first X_fin-code-cor-acc no-lock where
     1809                   X_fin-code-cor-acc.fin-code  = tt-c-fin-doc.cor-acc no-error.
     1810       if available X_fin-code-cor-acc then do:
     1811         assign
     1812         f-cor-acc-descr = X_fin-code-cor-acc.descr.
     1813       end.
     1814       if not available X_fin-code-cor-acc then do:
     1815         assign
     1816         f-cor-acc-descr = "!!!Код больше не существует".
     1817       end.
     1818   end.
     1819   if tt-c-fin-doc.an-uchet-code <> 0 then do:
     1820     find first X_fin-code-an-uchet no-lock where
     1821                   X_fin-code-an-uchet.fin-code  = tt-c-fin-doc.an-uchet-code no-error.
     1822       if available X_fin-code-an-uchet then do:
     1823         assign
     1824         f-an-uchet-descr = X_fin-code-an-uchet.descr.
     1825       end.
     1826       if not available X_fin-code-an-uchet then do:
     1827         assign
     1828         f-an-uchet-descr = "!!!Код больше не существует".
     1829       end.
     1830   end.
     1831   if tt-c-fin-doc.cel-nazn-code <> 0 then do:
     1832     find first X_fin-code-cel-nazn no-lock where
     1833                   X_fin-code-cel-nazn.fin-code  = tt-c-fin-doc.cel-nazn-code no-error.
     1834       if available X_fin-code-cel-nazn then do:
     1835         assign
     1836         f-cel-nazn-descr = X_fin-code-cel-nazn.descr.
     1837       end.
     1838       if not available X_fin-code-cel-nazn then do:
     1839         assign
     1840         f-cel-nazn-descr = "!!!Код больше не существует".
     1841       end.
     1842   end.
     1843   run proc-color-widgets in this-procedure("f-an-uchet-descr,f-cel-nazn-descr,f-contract-curr-abbr,f-contract-date,f-contract-prn-code,f-contract-rate," +                         "f-contract-scale,f-contract-type,f-cor-acc1-descr,f-cor-acc-descr,base-rate,base-scale,curr-code,exch-rate,exch-scale," +                         "fact-date,fin-doc-code,receiver-code,receiver-type,perm-date,PS,payer-code,payer-type,sum-base,sum-rubl," +                         "user-name-doc,user-name-fact,user-name-perm", no, yes, ?, grey_color).
     1844   run proc-color-widgets in this-procedure("F-curr-abbr,an-uchet-value,cel-nazn-value,cor-acc1-value,cor-acc-value,doc-date,enclosure," +                       "naznach-plat,receiver-name,prn-doc-code,payer-name,payer-okpo,receiver-passport,payer-sign1,payer-sign2,payer-sign3" +                       "str-podr-code,str-podr-name,str-podr-type,sum-doc", no, yes, ?, grey_color).
     1845   run change-view in this-procedure(rs-view).
     1846   VIEW FRAME Dialog-Frame.
     1847   END PROCEDURE.
