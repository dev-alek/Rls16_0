     1549     tt-c-fin-doc.receiver-type
     1550     tt-c-fin-doc.receiver-name
     1551     tt-c-fin-doc.receiver-passport
     1552     tt-c-fin-doc.naznach-plat
     1553     tt-c-fin-doc.enclosure
     1554     tt-c-fin-doc.PS
