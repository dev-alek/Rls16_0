     1187   ON CHOOSE OF B-contract-view IN FRAME Dialog-Frame
     1188   DO:
     1189   define variable g-log as logical no-undo.
     1190    define variable ri as recid no-undo .
     1191     if not avail X_contract then return no-apply.
     1192   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1193   do:
     1194     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1195       (input  v-cntxt-db-num
     1196       ,input  v-cntxt-userid
     1197       ,input  0
     1198       ,input  'actn_fin-contract_lookup':U
     1199       ,input  'firm':U
     1200       ,input  tt-c-fin-doc.host-code
     1201       ,input  '':U
     1202       ,input  0
     1203       ,input  0
     1204       ,input  0
     1205       ,input  0
     1206       ,input  true
     1207       ,output g-log
     1208       )  .
     1209   end.
     1210     if not g-log then  return .
     1211     ri = recid( X_contract ).
     1212     run str/sh-contr.p ( input parParentProc, input ri) no-error.
     1213     if error-status:error then return no-apply.
     1214   END.
