     1255   PROCEDURE fill-tables :
     1256   define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax.
     1257   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1258   for each buf_c-fin-doc-tax no-lock where
     1259   buf_c-fin-doc-tax.host-code = tt-c-fin-doc.host-code
     1260   AND buf_c-fin-doc-tax.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1261   AND buf_c-fin-doc-tax.chip-num = tt-c-fin-doc.chip-num
     1262    :
     1263       create tt0-fin-doc-tax.
     1264       buffer-copy buf_c-fin-doc-tax to tt0-fin-doc-tax.
     1265   end.
     1266   for each buf_c-fin-doc-attr no-lock where
     1267   buf_c-fin-doc-attr.host-code = tt-c-fin-doc.host-code
     1268   AND buf_c-fin-doc-attr.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1269   AND buf_c-fin-doc-attr.chip-num = tt-c-fin-doc.chip-num
     1270   :
     1271       create tt0-fin-doc-attr.
     1272       buffer-copy buf_c-fin-doc-attr to tt0-fin-doc-attr.
     1273   end.
     1274   END PROCEDURE.
     1275   PROCEDURE hide-view-currency :
     1276   assign
     1277   v-rubf = no
     1278   v-exchf = no
     1279   v-basef = no
     1280   v-baseratef = no
     1281   v-contractf = no
     1282   v-contractratef = no
     1283   .
     1284   hide
     1285   tt-c-fin-doc.exch-rate in frame Dialog-Frame
     1286   tt-c-fin-doc.exch-scale
     1287   tt-c-fin-doc.sum-rubl
     1288   tt-c-fin-doc.sum-base
     1289   tt-c-fin-doc.base-rate
     1290   tt-c-fin-doc.base-scale
     1291   tt-c-fin-doc.sum-contr
     1292   tt-c-fin-doc.contract-rate
     1293   tt-c-fin-doc.contract-scale
     1294   in frame Dialog-Frame .
     1295   if tt-c-fin-doc.curr-code = 0
     1296   and v-base-code = 0
     1297   and
     1298   (tt-c-fin-doc.contract-code = 0
     1299   or tt-c-fin-doc.contract-curr = 0)
     1300   then do:
     1301       return.
     1302   end.
     1303   if tt-c-fin-doc.curr-code <> 0 then do:
     1304     if tt-c-fin-doc.curr-code:visible then
     1305     display
     1306     tt-c-fin-doc.exch-rate
     1307     tt-c-fin-doc.exch-scale
     1308     tt-c-fin-doc.sum-rubl
     1309     with frame Dialog-Frame.
     1310     assign
     1311     v-rubf = yes
     1312     v-exchf = yes
     1313     .
     1314   end.
     1315   if v-base-code <> 0 then do:
     1316     if tt-c-fin-doc.curr-code:visible then
     1317     display
     1318     tt-c-fin-doc.base-rate
     1319     tt-c-fin-doc.base-scale
     1320     tt-c-fin-doc.sum-base
     1321     with frame Dialog-Frame.
     1322     assign
     1323     v-basef = yes
     1324     v-baseratef = yes
     1325     .
     1326   end.
     1327   if tt-c-fin-doc.contract-code  <> 0 and
     1328     (tt-c-fin-doc.contract-curr <> 0  )
     1329     then do:
     1330       if tt-c-fin-doc.curr-code:visible then
     1331       display
     1332       tt-c-fin-doc.sum-contr
     1333       tt-c-fin-doc.contract-rate
     1334       tt-c-fin-doc.contract-scale
     1335       with frame Dialog-Frame.
     1336     assign
     1337     v-contractf = yes
     1338     v-contractratef = yes
     1339     .
     1340   end.
     1341   END PROCEDURE.
     1342   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1343   on help of frame Dialog-Frame
     1344   do:
     1345     run gbl/app_help.p
     1346       (input this-procedure :file-name
     1347       ,input ''
     1348       ,input ?
     1349       ) no-error.
     1350     if error-status :error then do:
     1351       message
     1352         "Ошибка при вызове помощи"
     1353         error-status :get-message(1)
     1354         view-as alert-box .
     1355     end.
     1356   end.
     1357   run minbtn-set in this-procedure .
     1358   on choose of b-help in frame Dialog-Frame
     1359   do:
     1360     apply "help":u to frame Dialog-Frame .
     1361   end.
     1362   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1363   procedure minbtn-set :
     1364       do
     1365           on error undo, return error return-value
     1366           :
     1367           define variable ii              as integer       no-undo .
     1368           define variable fh              as widget-handle no-undo .
     1369           define variable hh              as widget-handle no-undo .
     1370           define variable v-h             as handle        extent 4 no-undo .
     1371           define variable v-name-button   as character     no-undo .
     1372           define variable v-help-old-x    as decimal       no-undo .
     1373           define variable v-help-old-y    as decimal       no-undo .
     1374           define variable v-help-old-size as decimal       no-undo .
     1375           define variable v-frame-width   as decimal       no-undo .
     1376           define variable jj              as integer       no-undo .
     1377           do
     1378               on error undo, return error
     1379               :
     1380               assign
     1381                   v-frame-width = frame Dialog-Frame:width - 0.3
     1382                   fh            = frame Dialog-Frame:first-child
     1383                   hh            = fh:first-child
     1384                   ii            = 1
     1385                   .
     1386               do while valid-handle(hh):
     1387                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1388                   do:
     1389                       case lc(hh:name) :
     1390                           when "b-help" then
     1391                               do:
     1392                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1393                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1394                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1395                                   hh:TOOLTIP = "Помощь" .
     1396                                   v-help-old-x = hh:column .
     1397                                   v-help-old-y = hh:row    .
     1398                                   v-help-old-size = hh:width .
     1399                                   hh:width-chars = 2.5 .
     1400                               end.
     1401                           when "b-print" then
     1402                               do:
     1403                                   hh:load-image("cmp/b-print.bmp":u) .
     1404                                   hh:TOOLTIP = "Печать" .
     1405                                   v-h[ii] = hh:handle .
     1406                                   ii = ii + 1 .
     1407                                   hh:width-chars = 3 .
     1408                               end.
     1409                           when "b-history" or
     1410                           when "b-hist" then
     1411                               do:
     1412                                   hh:load-image("cmp/b-hist.bmp":u) .
     1413                                   hh:TOOLTIP = "История" .
     1414                                   v-h[ii] = hh:handle .
     1415                                   ii = ii + 1 .
     1416                                   hh:width-chars = 3 .
     1417                               end.
     1418                           when "b-sch" then
     1419                               do:
     1420                                   hh:load-image("cmp/b-sch.bmp":u) .
     1421                                   hh:TOOLTIP = "Установка Фильтра" .
     1422                                   v-h[ii] = hh:handle .
     1423                                   ii = ii + 1 .
     1424                                   hh:width-chars = 3 .
     1425                               end.
     1426                           when "b-hist-user" then
     1427                               do:
     1428                                   hh:load-image("cmp/b-hist.bmp":u) .
     1429                                   hh:TOOLTIP = "История пользователя" .
     1430                                   ii = ii + 1 .
     1431                               end.
     1432                       end case.
     1433                   end.
     1434                   hh = hh:next-sibling.
     1435               end.
     1436               b-help:column = v-frame-width - b-help:width-chars.
     1437               jj = 0.
     1438               repeat ii = 4 to 1 by -1 :
     1439                   if valid-handle (v-h[ii] ) then
     1440                   do:
     1441                       jj  = jj + 1 .
     1442                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1443                       v-h[ii]:row    = v-help-old-y .
     1444                   end.
     1445               end.
     1446           end.
     1447       end.
     1448   end procedure.
