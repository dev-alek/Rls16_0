        1   define input parameter parparentproc as widget-handle no-undo.
        2   define input parameter p-mode as character no-undo.
        3   define input parameter p-parent as character no-undo.
        4   define input-output parameter p-rid as recid init ? no-undo.
        5   define buffer b3-code for code .
        6   define variable vss-revision    as character no-undo init "$Revision: $":U .
        7   define variable vss-author      as character no-undo init "$Author: $":U .
        8   define variable vss-date        as character no-undo init "$Date: $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: $":U .
       11   define variable vss-description as character no-undo init "редактирование параметров".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   procedure sel-date :
      119     define input  parameter p-date-handle as handle    no-undo .
      120     define input  parameter p-description as character no-undo .
      121     do
      122     on error undo, return error return-value
      123     :
      124       if (can-query (p-date-handle, "sensitive")
      125         and
      126         p-date-handle :sensitive = true
      127         )
      128       or (can-query (p-date-handle, "read-only")
      129         and
      130         p-date-handle :read-only = false
      131         )
      132       then do:
      133         if p-date-handle :handle <> focus :handle
      134         then do:
      135           apply "entry":u to p-date-handle .
      136         end.
      137         define variable v-ok            as logical no-undo .
      138         define variable v-curr-sv-date as date no-undo .
      139         assign
      140           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      141         .
      142         if v-curr-sv-date = ?
      143         then do:
      144           run gbl/getcurdt.p
      145             (output v-curr-sv-date
      146             ) .
      147         end.
      148         if v-curr-sv-date <> ?
      149         then do:
      150           run gbl/d-inpday.w
      151             (input ?
      152             ,input "Выбор даты"
      153             ,input p-description
      154             ,input ""
      155             ,input-output v-curr-sv-date
      156             ,output v-ok
      157             ).
      158           if v-ok = true
      159           then do:
      160             assign
      161               p-date-handle :screen-value = string(v-curr-sv-date) .
      162             .
      163           end.
      164         end.
      165       end.
      166     end.
      167   end procedure.
      168   define variable v-db-num like ub.db.db-num no-undo .
      169   define variable v-name   as character no-undo .
      170   define variable vDateIsoOld as character no-undo.
      171   define variable mViewDop as logical no-undo.
      172   mViewDop = num-entries (p-parent,chr(4)) eq 2.
      173   define button B-Help
      174      label "Помо&щь"
      175      size 10 by 1
      176      bgcolor 8 .
      177   define button b-quit auto-end-key
      178      label "&Отмена"
      179      size 10 by 1
      180      bgcolor 8 .
      181   define button B-save auto-go
      182      label "&Ввод"
      183      size 10 by 1
      184      bgcolor 8 .
      185   define variable mParentCode   as character       format "x(40)":U
      186      label "Функция"
      187      view-as combo-box
      188      list-item-pairs "1","1"
      189      size 42 by 1 no-undo.
      190   define variable mCode   as character       format "x(20)":U
      191      label "Доп. Значение"
      192      view-as fill-in
      193      size 21 by 1 no-undo.
      194   define variable mZNACH  as character    format "x(3)":U
      195      label "Степень защиты"
      196      view-as combo-box
      197      list-item-pairs "MGR","MGR",
      198      "REG","REG"
      199      size 20 by 1 no-undo.
      200   define variable mDecript  as character    format "x(40)":U
      201      label "Наименование"
      202      view-as fill-in
      203      size 20 by 1 no-undo.
      204   define variable fStatus as integer   init '0':U
      205      label "Статус"
      206      view-as combo-box inner-lines 2
      207      list-item-pairs "Обязательный",'0':U,
      208      "Необязательный",'1':U
      209      drop-down-list
      210      size 20 by 1 no-undo.
      211   define frame Dialog-Frame
      212      B-save at row 1 col 1
      213      b-quit at row 1 col 11
      214      B-Help at row 1 col 36
      215      mParentCode at row 2.5 col 18 colon-aligned widget-id 8
      216      mCode at row 4 col 18 colon-aligned widget-id 10
      217      mZNACH at row 5.5 col 18 colon-aligned widget-id 12
      218      mDecript at row 7 col 18 colon-aligned widget-id 14
      219      fStatus at row 8.5 col 18 colon-aligned widget-id 16
      220      with view-as dialog-box keep-tab-order
      221      side-labels no-underline three-d  scrollable
      222      title "Редактирование параметра"
      223      default-button B-save cancel-button b-quit.
      224   assign
      225      frame Dialog-Frame:SCROLLABLE = false
      226      frame Dialog-Frame:HIDDEN     = true.
      227   on window-close of frame Dialog-Frame
      228      do:
      229         apply "END-ERROR":U to self.
      230      end.
      231   on choose of B-save in frame Dialog-Frame
      232      do:
      233         run proc-save in this-procedure no-error.
      234         if error-status:error then return no-apply.
      235      end.
      236   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      237      then frame Dialog-Frame:PARENT = active-window.
      238   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      239   on help of frame Dialog-Frame
      240   do:
      241     run gbl/app_help.p
      242       (input this-procedure :file-name
      243       ,input ''
      244       ,input ?
      245       ) no-error.
      246     if error-status :error then do:
      247       message
      248         "Ошибка при вызове помощи"
      249         error-status :get-message(1)
      250         view-as alert-box .
      251     end.
      252   end.
      253   run minbtn-set in this-procedure .
      254   on choose of b-help in frame Dialog-Frame
      255   do:
      256     apply "help":u to frame Dialog-Frame .
      257   end.
      258   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      259   procedure minbtn-set :
      260       do
      261           on error undo, return error return-value
      262           :
      263           define variable ii              as integer       no-undo .
      264           define variable fh              as widget-handle no-undo .
      265           define variable hh              as widget-handle no-undo .
      266           define variable v-h             as handle        extent 4 no-undo .
      267           define variable v-name-button   as character     no-undo .
      268           define variable v-help-old-x    as decimal       no-undo .
      269           define variable v-help-old-y    as decimal       no-undo .
      270           define variable v-help-old-size as decimal       no-undo .
      271           define variable v-frame-width   as decimal       no-undo .
      272           define variable jj              as integer       no-undo .
      273           do
      274               on error undo, return error
      275               :
      276               assign
      277                   v-frame-width = frame Dialog-Frame:width - 0.3
      278                   fh            = frame Dialog-Frame:first-child
      279                   hh            = fh:first-child
      280                   ii            = 1
      281                   .
      282               do while valid-handle(hh):
      283                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      284                   do:
      285                       case lc(hh:name) :
      286                           when "b-help" then
      287                               do:
      288                                   hh:load-image-up("cmp/b-help.bmp":u) .
      289                                   hh:load-image-down("cmp/b-help.bmp":u) .
      290                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      291                                   hh:TOOLTIP = "Помощь" .
      292                                   v-help-old-x = hh:column .
      293                                   v-help-old-y = hh:row    .
      294                                   v-help-old-size = hh:width .
      295                                   hh:width-chars = 2.5 .
      296                               end.
      297                           when "b-print" then
      298                               do:
      299                                   hh:load-image("cmp/b-print.bmp":u) .
      300                                   hh:TOOLTIP = "Печать" .
      301                                   v-h[ii] = hh:handle .
      302                                   ii = ii + 1 .
      303                                   hh:width-chars = 3 .
      304                               end.
      305                           when "b-history" or
      306                           when "b-hist" then
      307                               do:
      308                                   hh:load-image("cmp/b-hist.bmp":u) .
      309                                   hh:TOOLTIP = "История" .
      310                                   v-h[ii] = hh:handle .
      311                                   ii = ii + 1 .
      312                                   hh:width-chars = 3 .
      313                               end.
      314                           when "b-sch" then
      315                               do:
      316                                   hh:load-image("cmp/b-sch.bmp":u) .
      317                                   hh:TOOLTIP = "Установка Фильтра" .
      318                                   v-h[ii] = hh:handle .
      319                                   ii = ii + 1 .
      320                                   hh:width-chars = 3 .
      321                               end.
      322                           when "b-hist-user" then
      323                               do:
      324                                   hh:load-image("cmp/b-hist.bmp":u) .
      325                                   hh:TOOLTIP = "История пользователя" .
      326                                   ii = ii + 1 .
      327                               end.
      328                       end case.
      329                   end.
      330                   hh = hh:next-sibling.
      331               end.
      332               b-help:column = v-frame-width - b-help:width-chars.
      333               jj = 0.
      334               repeat ii = 4 to 1 by -1 :
      335                   if valid-handle (v-h[ii] ) then
      336                   do:
      337                       jj  = jj + 1 .
      338                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      339                       v-h[ii]:row    = v-help-old-y .
      340                   end.
      341               end.
      342           end.
      343       end.
      344   end procedure.
      345   MAIN-BLOCK:
      346   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
      347      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
      348      if p-mode <> 'ДОБАВЛЕНИЕ':U and
      349         p-mode <> 'ИЗМЕНЕНИЕ':U
      350         then
      351      do:
      352         message
      353            vss-workfile vss-revision vss-description skip
      354            "Неверное значение параметров вызова p-mode"  p-mode
      355            view-as alert-box error.
      356         undo, return error.
      357      end.
      358   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      360     (output v-db-num
      361     )  .
      362      define variable vparentpar as character no-undo.
      363      define variable vcodepar   as character no-undo.
      364      assign
      365         vparentpar = p-parent
      366         vcodepar   = entry(num-entries (vparentpar,chr(4)),vparentpar,chr(4))
      367         entry(num-entries (vparentpar,chr(4)),vparentpar,chr(4)) = ""
      368         vparentpar = trim(vparentpar,chr(4))
      369      no-error.
      370      if not error-status:error
      371      then do:
      372         find first b3-code where
      373            b3-code.parent  = vparentpar
      374            and b3-code.code    = vcodepar no-lock no-error.
      375         if available b3-code
      376            then
      377         do:
      378            frame Dialog-Frame:TITLE = "Редактирование параметра " + b3-code.codename.
      379            v-name = b3-code.CodeName .
      380         end.
      381      end.
      382      mParentCode = entry(num-entries (p-parent,chr(4)),p-parent,chr(4)).
      383      define variable v-list-items as character no-undo.
      384      define buffer code-func for ub.code.
      385      for each code-func where code-func.parent eq "CashFunKey" no-lock by code-func.CodeName:
      386         v-list-items = v-list-items + chr(44) + code-func.codename + " (" + code-func.Code + ")" + chr(44) + code-func.code .
      387      end.
      388      mParentCode:LIST-ITEM-PAIRS  in frame Dialog-Frame = trim(v-list-items,chr(44)) .
      389      if p-mode = 'ИЗМЕНЕНИЕ':U then
      390      do:
      391         find first b3-code where
      392            recid(b3-code) = p-rid exclusive-lock no-wait no-error.
      393         if not available b3-code then
      394         do:
      395            message
      396               vss-workfile vss-revision vss-description skip
      397               "Не найдена запись параметра"
      398               view-as alert-box error .
      399            undo, return error.
      400         end.
      401         assign
      402            mCode    = b3-code.code
      403            mZNACH   = b3-code.CodeValue
      404            mDecript     = b3-code.CodeName
      405            Fstatus  = b3-code.status_
      406            .
      407      end.
      408      run enable_UI in this-procedure .
      409      if p-mode = 'ДОБАВЛЕНИЕ':U then
      410      do:
      411         enable mCode with frame Dialog-Frame.
      412         apply "entry" to mCode in frame Dialog-Frame.
      413      end.
      414      wait-for go of frame Dialog-Frame.
      415   end.
      416   session:data-entry-return = no .
      417   run disable_UI.
      418   procedure disable_UI :
      419      hide frame Dialog-Frame.
      420   end procedure.
      421   procedure enable_UI :
      422      display mCode mZNACH fStatus mDecript mParentCode
      423         with frame Dialog-Frame.
      424      enable B-save b-quit B-Help mCode mZNACH fStatus mDecript
      425         with frame Dialog-Frame.
      426      view frame Dialog-Frame.
      427      if mParentCode eq  ""
      428      then enable mParentCode
      429         with frame Dialog-Frame.
      430   end procedure.
      431   procedure proc-save :
      432      define buffer b3-code for code.
      433      define buffer b2-code for code.
      434      assign frame Dialog-Frame
      435         mParentCode
      436         mCode
      437         mZNACH
      438         mDecript
      439         fStatus
      440         .
      441      if mZNACH eq ""
      442         or mZNACH eq ""
      443      then do:
      444         message "Введите степень защиты ! " view-as  alert-box  error.
      445         apply "entry"  to mZNACH .
      446         return ERROR.
      447      end.
      448      do on error undo, return error
      449         on stop undo, return error:
      450         entry(num-entries (p-parent,chr(4)),p-parent,chr(4)) = mParentCode.
      451         if    mParentCode eq ?
      452            or mParentCode eq ""
      453         then do:
      454            message "Заполните функцию"
      455            view-as alert-box.
      456            apply "entry"  to mParentCode .
      457            return error.
      458         end.
      459         if mCode eq ?
      460         then do:
      461            message "Код не может быть пустой"
      462            view-as alert-box.
      463            return error.
      464         end.
      465         find first b3-code where
      466            b3-code.parent = p-parent
      467            and b3-code.code   = mcode
      468            and if p-rid eq ? then yes else recid(b3-code) ne p-rid
      469            no-lock no-error.
      470         if avail b3-code then
      471         do:
      472            message
      473               "Уже есть такаой параметр :" mCode
      474               view-as alert-box error .
      475            return error.
      476         end.
      477         find first b3-code where
      478            recid(b3-code) eq p-rid
      479            exclusive-lock no-error.
      480         if not avail b3-code then
      481         do:
      482            create b3-code.
      483         end.
      484         assign
      485            b3-code.parent    = p-parent
      486            b3-code.code      = mcode
      487            b3-code.codevalue = mZNACH
      488            b3-code.CodeName  = mDecript
      489            b3-code.status_   = fStatus
      490            b3-code.nwsgbd    = yes
      491            .
      492         p-rid = recid(b3-code).
      493      end.
      494   end procedure.
