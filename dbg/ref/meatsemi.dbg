      455   field subkind-name-3 as character column-label "Фаршировка" help "Полуфабрикаты, объединенные по технологии изготовления"
      456   format "X(15)" label "Фаршировка"
      457   view-as combo-box list-items "-", "фаршированные", "нефаршированные"  inner-lines 3 drop-down-list size-chars 20  by 1
      458   field subkind-name-4 as character column-label "Формовка" help "Полуфабрикаты, объединенные по технологии изготовления"
      459   format "X(13)" label "Формовка"
      460   view-as combo-box list-items "-", "формованные", "неформованные"  inner-lines 3 drop-down-list size-chars 20  by 1
      461   field subkind-name-5 as character column-label "Панировка" help "Полуфабрикаты, объединенные по технологии изготовления"
      462   format "X(14)" label "Панировка"
      463   view-as combo-box list-items "-", "панированные", "непанированные"  inner-lines 3 drop-down-list size-chars 20  by 1
      464   field subkind-name-6 as character column-label "Фасовка" help "Полуфабрикаты, объединенные по технологии изготовления"
      465   format "X(10)" label "Фасовка"
      466   view-as combo-box list-items "весовые", "фасованные"  inner-lines 2 drop-down-list size-chars 20  by 1
      467   field category-name as character  column-label "Категория" help "Полуфабрикаты, объединенные по массовой доле мышечной ткани в рецептуре"
      468   format "X(11)" label "Категория"
      469   view-as combo-box list-items "категория А", "категория Б", "категория В", "категория Г", "категория Д"  inner-lines 5 drop-down-list size-chars 20  by 1
      470   field termic-condition-name as character  column-label "Терм.!состояние" help "Полуфабрикаты, объединенные по термическому состоянию"
      471   format "X(15)" label "Терм.состояние"
      472   view-as combo-box list-items "охлажденные", "подмороженные", "замороженные"  inner-lines 3 drop-down-list size-chars 20  by 1
      473   field node-code as integer  column-label "Код"
      474   format ">>>9" label "Код"
      475   fgcolor RED_COLOR
      476   field upper-node-code as integer
      477   field subkind-name as character
      478   field lvl-num as integer
      479   index pi is unique primary
      480   node-code
      481   index iupper upper-node-code
      482   index igroup group-name
      483   index ikind kind-name
      484   index isubkind subkind-name
      485   index icategory category-name
      486   index itermic termic-condition-name
      487   .
      488   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      489   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      490   procedure meatsemi_fill-msf :
      491   define input parameter p-mode as character no-undo .
      492   define parameter buffer buf_clob-bind for ub.clob-bind.
      493   define buffer buf_clob-data for ub.clob-data.
      494   define variable v-longchar as longchar no-undo .
      495   define variable glog as logical no-undo .
      496   case p-mode:
      497     when  'ИЗМЕНЕНИЕ':U then do:
      498      find first buf_clob-bind exclusive-lock where
      499               buf_clob-bind.resource-type = 'ref':U
      500          and buf_clob-bind.uniq-key-rec = "meat-semi-finished.xml"
      501          and buf_clob-bind.field-name = "" no-error.
      502     end.
      503     otherwise do:
      504       find first buf_clob-bind no-lock where
      505               buf_clob-bind.resource-type = 'ref':U
      506          and buf_clob-bind.uniq-key-rec = "meat-semi-finished.xml"
      507          and buf_clob-bind.field-name = "" no-error.
      508     end.
      509   end case.
      510   if available buf_clob-bind then do:
      511     find first buf_clob-data no-lock where
      512               buf_clob-data.db-num = buf_clob-bind.db-num
      513           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      514     if available buf_clob-data then do:
      515       v-longchar = buf_clob-data.cdata.
      516       glog = DATASET meat-semi-finished-ds:HANDLE:read-XML("LONGCHAR"
      517                                                   , v-longchar
      518                                                   , "EMPTY"
      519                                                   , ?
      520                                                   , ?
      521                                                   , ?
      522                                                   , "loose"   )  no-error .
      523       if error-status:error
      524       or not glog then do:
      525         MESSAGE
      526         "НЕ удается прочитать из БД классификатор" skip
      527         ERROR-STATUS:GET-MESSAGE(1) SKIP
      528         RETURN-VALUE
      529         VIEW-AS ALERT-BOX ERROR.
      530         UNDO, RETURN ERROR.
      531       end.
      532     end.
      533   end.
      534   end procedure.
      535   DEFINE VARIABLE v-max-node-code AS INTEGER NO-UNDO.
      536   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
      537   define variable v-edit-mode as logical no-undo .
      538   define buffer buf_clob-bind for ub.clob-bind.
      539   FUNCTION mark-string RETURNS CHARACTER
      540     ( INPUT p-current-node-code AS INTEGER )  FORWARD.
      541   DEFINE BUTTON b-add
      542        LABEL "&Добавить"
      543        SIZE 10 BY 1.
      544   DEFINE BUTTON b-cancel
      545        LABEL "Отмена"
      546        SIZE 10 BY 1.
      547   DEFINE BUTTON b-del
      548        LABEL "&Удалить"
      549        SIZE 10 BY 1.
      550   DEFINE BUTTON B-exit AUTO-GO
      551        LABEL "&Сохранить"
      552        SIZE 10 BY 1
      553        BGCOLOR 8 .
      554   DEFINE BUTTON b-gds-list
      555        LABEL "Товары"
      556        SIZE 10 BY 1.
      557   DEFINE BUTTON B-Help
      558        LABEL "Помо&щь"
      559        SIZE 3 BY 1
      560        BGCOLOR 8 .
      561   DEFINE BUTTON b-ok
      562        LABEL "&Ввод"
      563        SIZE 10 BY 1.
      564   DEFINE BUTTON b-quit AUTO-GO
      565        LABEL "&Отмена"
      566        SIZE 10 BY 1
      567        BGCOLOR 8 .
      568   DEFINE BUTTON b-sel AUTO-GO
      569        LABEL "&Выбор"
      570        SIZE 10 BY 1.
      571   DEFINE QUERY BR-msf FOR
      572         meat-semi-finished SCROLLING.
      573   DEFINE BROWSE BR-msf
      574     QUERY BR-msf NO-LOCK DISPLAY
      575         mark-string(meat-semi-finished.node-code) COLUMN-LABEL "*" FORMAT "(1)"
      576   meat-semi-finished.node-code
      577   meat-semi-finished.group-name
      578   meat-semi-finished.kind-name
      579   meat-semi-finished.subkind-name-1
      580   meat-semi-finished.subkind-name-2
      581   meat-semi-finished.subkind-name-3
      582   meat-semi-finished.subkind-name-4
      583   meat-semi-finished.subkind-name-5
      584   meat-semi-finished.subkind-name-6
      585   meat-semi-finished.category-name
      586   meat-semi-finished.termic-condition-name
      587   meat-semi-finished.node-code
      588       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 13 FIT-LAST-COLUMN.
      589   DEFINE FRAME Dialog-Frame
      590        B-exit AT ROW 1 COL 1 WIDGET-ID 2
      591        b-quit AT ROW 1 COL 11
      592        b-sel AT ROW 1 COL 25 WIDGET-ID 20
      593        b-add AT ROW 1 COL 45 WIDGET-ID 4
      594        b-del AT ROW 1 COL 55 WIDGET-ID 8
      595        b-gds-list AT ROW 1 COL 65 WIDGET-ID 22
      596        B-Help AT ROW 1 COL 95
      597        BR-msf AT ROW 3 COL 1 WIDGET-ID 100
      598        b-ok AT ROW 16 COL 78 WIDGET-ID 16
      599        b-cancel AT ROW 16 COL 88 WIDGET-ID 18
      600        SPACE(1.69) SKIP(5.26)
      601       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      602            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      603            TITLE "Классификатор мясных и мясосодержащих полуфабрикатов по ГОСТ P 52675"
      604            CANCEL-BUTTON b-quit.
      605   ASSIGN
      606          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      607          FRAME Dialog-Frame:HIDDEN           = TRUE.
      608   ASSIGN
      609          b-cancel:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      610   ASSIGN
      611          b-ok:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      612   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      613   DO:
      614     APPLY "END-ERROR":U TO SELF.
      615   END.
      616   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      617   DO:
      618     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
      619     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      620   END.
      621   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      622   DO:
      623     RUN proc-undo-record IN THIS-PROCEDURE NO-ERROR.
      624     IF ERROR-STATUS:ERROR THEN do:
      625       enable
      626       b-add when v-edit-mode
      627       b-del when v-edit-mode
      628       b-gds-list
      629       with frame Dialog-Frame .
      630       RETURN NO-APPLY.
      631     end.
      632     enable
      633     b-add when v-edit-mode
      634     b-del when v-edit-mode
      635     with frame Dialog-Frame .
      636   END.
      637   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      638   DO:
      639     IF NOT AVAILABLE meat-semi-finished  THEN RETURN NO-APPLY.
      640     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
      641     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      642   END.
      643   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      644   DO:
      645   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      646     MESSAGE
      647     "Вы уверены, что хотите сохранить классификатор в таком виде в БД?" SKIP
      648     "УДАЛЕНИЕ ДОБАВЛЕННЫХ ЗАПИСЕЙ (если Вы их добавляли) ПОСЛЕ ЭТОГО СТАНЕТ НЕВОЗМОЖНЫМ!"
      649     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
      650     if not glog then return no-apply.
      651     RUN proc-save-all IN THIS-PROCEDURE NO-ERROR.
      652     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      653   END.
      654   ON CHOOSE OF b-gds-list IN FRAME Dialog-Frame
      655   DO:
      656    DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      657    IF NOT AVAILABLE meat-semi-finished THEN RETURN NO-APPLY.
      658    if meat-semi-finished.node-code >  v-max-node-code then do:
      659      message
      660      "Нельзя просмотреть товары по данному коду классификатора" skip
      661      "Он еще не был сохранен в БД"
      662      view-as alert-box error .
      663      undo, return no-apply.
      664    end.
      665    run ref/gds-msfs.w ( INPUT parparentproc
      666                         ,INPUT (if b-add:sensitive in frame Dialog-Frame  = yes
      667                                 and v-cntxt-db-num = 0
      668                                 and not transaction
      669                                 and meat-semi-finished.node-code <= v-max-node-code
      670                                 then 'b-add' else '')
      671                         ,INPUT "node-code"
      672                         ,INPUT meat-semi-finished.node-code
      673                         ,input ''
      674                         ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      675   END.
      676   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      677   DO:
      678     RUN proc-save-record IN THIS-PROCEDURE NO-ERROR.
      679     IF ERROR-STATUS:ERROR THEN do:
      680       enable
      681       b-add when v-edit-mode
      682       b-del when v-edit-mode
      683       with frame Dialog-Frame .
      684       RETURN NO-APPLY.
      685     end.
      686     enable
      687     b-add when v-edit-mode
      688     b-del when v-edit-mode
      689     with frame Dialog-Frame .
      690   END.
      691   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      692   DO:
      693     IF AVAILABLE meat-semi-finished THEN DO:
      694         ASSIGN
      695         p-node-code = meat-semi-finished.node-code.
      696     END.
      697   END.
      698   ON VALUE-CHANGED OF BR-msf IN FRAME Dialog-Frame
      699   DO:
      700     if b-ok:visible in frame Dialog-Frame
      701     or b-cancel:visible in frame Dialog-Frame  then do:
      702       return no-apply.
      703     end.
      704     IF AVAILABLE meat-semi-finished THEN do:
      705       ASSIGN
      706       dop-msf.node-code =  meat-semi-finished.node-code
      707       dop-msf.group-name =  meat-semi-finished.group-name
      708       dop-msf.kind-name  =  meat-semi-finished.kind-name
      709       dop-msf.subkind-name-1 = meat-semi-finished.subkind-name-1
      710       dop-msf.subkind-name-2 = meat-semi-finished.subkind-name-2
      711       dop-msf.subkind-name-3 = meat-semi-finished.subkind-name-3
      712       dop-msf.subkind-name-4  = meat-semi-finished.subkind-name-4
      713       dop-msf.subkind-name-5 = meat-semi-finished.subkind-name-5
      714       dop-msf.subkind-name-6 = meat-semi-finished.subkind-name-6
      715       dop-msf.category-name = meat-semi-finished.category-name
      716       dop-msf.termic-condition-name = meat-semi-finished.termic-condition-name
      717       .
      718       DISPLAY dop-msf.node-code AT ROW 16 COL 5 COLON-ALIGN  dop-msf.group-name AT ROW 16 COL 17 COLON-ALIGN dop-msf.kind-name AT ROW 16 COL 54 COLON-ALIGN SKIP dop-msf.subkind-name-1 AT ROW 17 COL 17 COLON-ALIGN dop-msf.subkind-name-2 AT ROW 17 COL 54 COLON-ALIGN SKIP dop-msf.subkind-name-3 AT ROW 18 COL 17 colon-align dop-msf.subkind-name-4 AT ROW 18 COL 54 COLON-ALIGN SKIP dop-msf.subkind-name-5 AT ROW 19 COL 17 colon-align dop-msf.subkind-name-6 AT ROW 19 COL 54 COLON-ALIGN SKIP  dop-msf.category-name AT ROW 20 COL 17 COLON-ALIGN dop-msf.termic-condition-name AT ROW 20 COL 54 COLON-ALIGN with FRAME Dialog-Frame.
      719     END.
      720     ELSE DO:
      721       disable dop-msf.node-code dop-msf.group-name dop-msf.kind-name dop-msf.subkind-name-1  dop-msf.subkind-name-2  dop-msf.subkind-name-3  dop-msf.subkind-name-4  dop-msf.subkind-name-5  dop-msf.subkind-name-6  dop-msf.category-name   dop-msf.termic-condition-name with FRAME Dialog-Frame. hide dop-msf.node-code in FRAME Dialog-Frame dop-msf.group-name dop-msf.kind-name dop-msf.subkind-name-1  dop-msf.subkind-name-2  dop-msf.subkind-name-3  dop-msf.subkind-name-4  dop-msf.subkind-name-5  dop-msf.subkind-name-6  dop-msf.category-name   dop-msf.termic-condition-name in FRAME Dialog-Frame.
      722     END.
      723   END.
      724   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      725   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      726   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      727   on help of frame Dialog-Frame
      728   do:
      729     run gbl/app_help.p
      730       (input this-procedure :file-name
      731       ,input ''
      732       ,input ?
      733       ) no-error.
      734     if error-status :error then do:
      735       message
      736         "Ошибка при вызове помощи"
      737         error-status :get-message(1)
      738         view-as alert-box .
      739     end.
      740   end.
      741   run minbtn-set in this-procedure .
      742   on choose of b-help in frame Dialog-Frame
      743   do:
      744     apply "help":u to frame Dialog-Frame .
      745   end.
      746   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      747   procedure minbtn-set :
      748       do
      749           on error undo, return error return-value
      750           :
      751           define variable ii              as integer       no-undo .
      752           define variable fh              as widget-handle no-undo .
      753           define variable hh              as widget-handle no-undo .
      754           define variable v-h             as handle        extent 4 no-undo .
      755           define variable v-name-button   as character     no-undo .
      756           define variable v-help-old-x    as decimal       no-undo .
      757           define variable v-help-old-y    as decimal       no-undo .
      758           define variable v-help-old-size as decimal       no-undo .
      759           define variable v-frame-width   as decimal       no-undo .
      760           define variable jj              as integer       no-undo .
      761           do
      762               on error undo, return error
      763               :
      764               assign
      765                   v-frame-width = frame Dialog-Frame:width - 0.3
      766                   fh            = frame Dialog-Frame:first-child
      767                   hh            = fh:first-child
      768                   ii            = 1
      769                   .
      770               do while valid-handle(hh):
      771                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      772                   do:
      773                       case lc(hh:name) :
      774                           when "b-help" then
      775                               do:
      776                                   hh:load-image-up("cmp/b-help.bmp":u) .
      777                                   hh:load-image-down("cmp/b-help.bmp":u) .
      778                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      779                                   hh:TOOLTIP = "Помощь" .
      780                                   v-help-old-x = hh:column .
      781                                   v-help-old-y = hh:row    .
      782                                   v-help-old-size = hh:width .
      783                                   hh:width-chars = 2.5 .
      784                               end.
      785                           when "b-print" then
      786                               do:
      787                                   hh:load-image("cmp/b-print.bmp":u) .
      788                                   hh:TOOLTIP = "Печать" .
      789                                   v-h[ii] = hh:handle .
      790                                   ii = ii + 1 .
      791                                   hh:width-chars = 3 .
      792                               end.
      793                           when "b-history" or
      794                           when "b-hist" then
      795                               do:
      796                                   hh:load-image("cmp/b-hist.bmp":u) .
      797                                   hh:TOOLTIP = "История" .
      798                                   v-h[ii] = hh:handle .
      799                                   ii = ii + 1 .
      800                                   hh:width-chars = 3 .
      801                               end.
      802                           when "b-sch" then
      803                               do:
      804                                   hh:load-image("cmp/b-sch.bmp":u) .
      805                                   hh:TOOLTIP = "Установка Фильтра" .
      806                                   v-h[ii] = hh:handle .
      807                                   ii = ii + 1 .
      808                                   hh:width-chars = 3 .
      809                               end.
      810                           when "b-hist-user" then
      811                               do:
      812                                   hh:load-image("cmp/b-hist.bmp":u) .
      813                                   hh:TOOLTIP = "История пользователя" .
      814                                   ii = ii + 1 .
      815                               end.
      816                       end case.
      817                   end.
      818                   hh = hh:next-sibling.
      819               end.
      820               b-help:column = v-frame-width - b-help:width-chars.
      821               jj = 0.
      822               repeat ii = 4 to 1 by -1 :
      823                   if valid-handle (v-h[ii] ) then
      824                   do:
      825                       jj  = jj + 1 .
      826                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      827                       v-h[ii]:row    = v-help-old-y .
      828                   end.
      829               end.
      830           end.
      831       end.
      832   end procedure.
      833   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      834   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      835   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      836   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      837   define variable v-diasize-current-frame-width  as decimal   no-undo .
      838   define variable v-diasize-current-frame-height as decimal   no-undo .
      839   define variable v-diasize-change-size          as logical   no-undo .
      840   define variable v-diasize-resize-button        as handle    no-undo .
      841   define variable v-diasize-wndmax               as logical   no-undo .
      842   define variable v-diasize-wndstore             as logical   no-undo .
      843   define variable v-diasize-proc-name            as character no-undo .
      844   define variable v-diasize-browse-handle        as handle    no-undo .
      845   define variable v-diasize-browse-number        as integer   no-undo .
      846   define variable v-diasize-need-full-display    as logical   no-undo init false .
      847   define temp-table temp-diasize-handle no-undo
      848     field handle-value  as handle
      849     field save-position as decimal
      850     index xpk is primary unique handle-value
      851     .
      852   define temp-table temp-browse-handle no-undo
      853     field browse-type   as character
      854     field browse-number as integer
      855     field browse-handle as handle
      856     field original-size as decimal
      857     index xpk is primary unique browse-type browse-number
      858     index xie browse-type browse-handle
      859   .
      860   procedure diasize_change-height :
      861     define input  parameter p-change-value  as decimal   no-undo .
      862     define input  parameter p-move-resize   as logical   no-undo .
      863     define variable v-field-group-handle    as handle    no-undo .
      864     define variable v-object-handle         as handle    no-undo .
      865     define variable v-frame-height          as decimal   no-undo .
      866     define variable v-frame-virtual-height  as decimal   no-undo .
      867     define variable v-browse-height         as decimal   no-undo .
      868     define variable v-window-height         as decimal   no-undo .
      869     define variable v-window-virtual-height as decimal   no-undo .
      870     define variable v-change-sign           as integer   no-undo .
      871     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      872     define buffer buf_temp-browse-handle  for temp-browse-handle .
      873     if p-change-value > 0
      874     then do:
      875       if frame Dialog-Frame :height + p-change-value
      876           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      877       then do:
      878         assign
      879           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      880                           - (frame Dialog-Frame :height-chars)
      881         .
      882         if p-change-value <= 0
      883         then do:
      884           run diasize_position-resize-button in this-procedure .
      885           return .
      886         end.
      887       end.
      888     end.
      889     if p-change-value < 0
      890     then do:
      891       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      892       then do:
      893         assign
      894           p-change-value = v-diasize-orig-frame-height
      895                          - (frame Dialog-Frame :height-chars)
      896         .
      897         if p-change-value >= 0
      898         then do:
      899           run diasize_position-resize-button in this-procedure .
      900           return .
      901         end.
      902       end.
      903     end.
      904     if p-change-value >= 0
      905     then do:
      906       assign
      907         v-change-sign = 1
      908       .
      909     end.
      910     else do:
      911       assign
      912         v-change-sign = -1
      913       .
      914     end.
      915     assign
      916       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      917     .
      918     if p-change-value = 0
      919     then do:
      920       run diasize_position-resize-button in this-procedure .
      921       return .
      922     end.
      923     move_block:
      924     do
      925     on error undo move_block, retry move_block
      926     :
      927       if retry
      928       then do:
      929         do
      930         on error undo move_block, leave move_block
      931         :
      932           if p-change-value > 0
      933           then do:
      934             for each buf_temp-diasize-handle
      935             on error undo, next
      936             :
      937               assign
      938                 v-object-handle = buf_temp-diasize-handle.handle-value
      939               .
      940               if v-object-handle <> v-diasize-resize-button
      941               then do:
