     1519             v-object-handle = buf_temp-diasize-handle.handle-value
     1520           .
     1521           if v-object-handle <> v-diasize-resize-button
     1522           then do:
     1523             assign
     1524               v-object-handle :col = v-object-handle :col + p-change-value
     1525               no-error .
     1526             if error-status :error
     1527             or error-status :get-message(1) <> ""
     1528             then do:
     1529               undo move_block, retry move_block .
     1530             end.
     1531           end.
     1532         end.
     1533       end.
     1534       else do:
     1535         for each buf_temp-diasize-handle
     1536         on error undo move_block, retry move_block
     1537         :
     1538           assign
     1539             v-object-handle = buf_temp-diasize-handle.handle-value
     1540           .
     1541           if v-object-handle <> v-diasize-resize-button
     1542           then do:
     1543             assign
     1544               v-object-handle :col = v-object-handle :col + p-change-value
     1545               no-error .
     1546             if error-status :error
     1547             or error-status :get-message(1) <> ""
     1548             then do:
     1549               undo move_block, retry move_block .
     1550             end.
     1551           end.
     1552         end.
     1553         for each buf_temp-browse-handle
     1554           where buf_temp-browse-handle.browse-type = 'width':u
     1555         on error undo move_block, retry move_block
     1556         :
     1557           assign
     1558             buf_temp-browse-handle.browse-handle :width
     1559               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1560             no-error .
     1561           if error-status :error
     1562           or error-status :get-message(1) <> ""
     1563           then do:
     1564             undo move_block, retry move_block .
     1565           end.
     1566         end.
     1567         assign
     1568           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1569           no-error .
     1570         if error-status :error
     1571         or error-status :get-message(1) <> ""
     1572         then do:
     1573           undo move_block, retry move_block.
     1574         end.
     1575         assign
     1576           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1577         no-error .
     1578         if error-status :error
     1579         or error-status :get-message(1) <> ""
     1580         then do:
     1581           undo move_block, retry move_block.
     1582         end.
     1583         if frame Dialog-Frame :scrollable = true
     1584         then do:
     1585           assign
     1586             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1587           no-error .
     1588           if error-status :error
     1589           or error-status :get-message(1) <> ""
     1590           then do:
     1591             undo move_block, retry move_block.
     1592           end.
     1593         end.
     1594       end.
     1595       if p-move-resize
     1596       then do:
     1597         run diasize_position-resize-button in this-procedure .
     1598       end.
     1599       if v-diasize-wndstore = true
     1600       then do:
     1601         if connected("ub") = true
     1602         then do:
     1603           define variable v-cntxt-db-num        as integer   no-undo .
     1604           define variable v-cntxt-userid        as character no-undo .
     1605           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1606                                             , OUTPUT v-cntxt-userid
     1607                                             ) .
     1608           run gbl/wndsizew.p
     1609             (input  v-cntxt-db-num
     1610             ,input  v-cntxt-userid
     1611             ,input  v-diasize-proc-name
     1612             ,input  'width':u
     1613             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1614             ) .
     1615         end.
     1616       end.
     1617     end.
     1618     assign
     1619       v-diasize-change-size = false
     1620     .
     1621   end procedure.
     1622   procedure diasize_set-width :
     1623     define input  parameter p-new-width  as decimal   no-undo .
     1624     define input  parameter p-move-resize as logical   no-undo .
     1625     do
     1626     on error undo, return error return-value
     1627     :
     1628       run diasize_change-width in this-procedure
     1629         (input  (p-new-width - frame Dialog-Frame :width)
     1630         ,input  p-move-resize
     1631         ) .
     1632     end.
     1633   end procedure.
     1634   procedure diasize_position-resize-button :
     1635     do with frame Dialog-Frame
     1636     :
     1637       hide v-diasize-resize-button .
     1638       assign
     1639         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1640                     - 1
     1641                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1642         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1643                     - 1
     1644                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1645       .
     1646       view v-diasize-resize-button .
     1647     end.
     1648   end procedure.
     1649   on alt-right anywhere
     1650   do:
     1651     run diasize_change-width in this-procedure
     1652       (input 1
     1653       ,input true
     1654       ) .
     1655     return no-apply .
     1656   end.
     1657   on alt-left anywhere
     1658   do:
     1659     run diasize_change-width in this-procedure
     1660       (input -1
     1661       ,input true
     1662       ) .
     1663     return no-apply .
     1664   end.
     1665   on alt-down anywhere
     1666   do:
     1667     run diasize_change-height in this-procedure
     1668       (input 1
     1669       ,input true
     1670       ) .
     1671     return no-apply .
     1672   end.
     1673   on alt-up anywhere
     1674   do:
     1675     run diasize_change-height in this-procedure
     1676       (input -1
     1677       ,input true
     1678       ) .
     1679     return no-apply .
     1680   end.
     1681   on alt-enter of frame Dialog-Frame
     1682   do:
     1683     run diasize_maximize in this-procedure
     1684       (input  ?
     1685       ).
     1686     return no-apply .
     1687   end.
     1688   procedure diasize_end-move :
     1689     do
     1690     on error undo, return error return-value
     1691     :
     1692       define variable v-row-delta as decimal   no-undo .
     1693       define variable v-col-delta as decimal   no-undo .
     1694       define variable v-new-row as decimal   no-undo .
     1695       define variable v-new-col as decimal   no-undo .
     1696       assign
     1697         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1698         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1699       .
     1700       assign
     1701         v-row-delta = v-new-row - frame Dialog-Frame :height
     1702         v-col-delta = v-new-col - frame Dialog-Frame :width
     1703       .
     1704       run diasize_change-height in this-procedure
     1705         (input v-row-delta
     1706         ,input true
     1707         ) .
     1708       run diasize_change-width in this-procedure
     1709         (input v-col-delta
     1710         ,input true
     1711         ) .
     1712     end.
     1713   end procedure.
     1714   procedure diasize_maximize :
     1715     define input  parameter p-action as logical   no-undo .
     1716     do
     1717     on error undo, return error return-value
     1718     :
     1719       if p-action = ?
     1720       then do:
     1721         if v-diasize-need-maximize = true
     1722         then do:
     1723           assign
     1724             p-action = true
     1725           .
     1726         end.
     1727         else do:
     1728           assign
     1729             p-action = false
     1730           .
     1731         end.
     1732       end.
     1733       if p-action = true
     1734       then do:
     1735         run diasize_change-height in this-procedure
     1736           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1737               - frame Dialog-Frame :height-chars
     1738           ,input true
     1739           ) .
     1740         run diasize_change-width in this-procedure
     1741           (input session :width-chars
     1742               - frame Dialog-Frame :width-chars
     1743           ,input true
     1744           ) .
     1745         assign
     1746           v-diasize-need-maximize = false
     1747         .
     1748       end.
     1749       else do:
     1750         run diasize_change-width in this-procedure
     1751           (input v-diasize-orig-frame-width
     1752               - frame Dialog-Frame :width-chars
     1753           ,input true
     1754           ) .
     1755         run diasize_change-height in this-procedure
     1756           (input v-diasize-orig-frame-height
     1757               - frame Dialog-Frame :height-chars
     1758           ,input true
     1759           ) .
     1760         assign
     1761           v-diasize-need-maximize = true
     1762         .
     1763       end.
     1764     end.
     1765   end procedure.
     1766   procedure diasize_restore-orig-size :
     1767     do
     1768     on error undo, return error return-value
     1769     :
     1770       assign
     1771         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1772         v-diasize-current-frame-height = frame Dialog-Frame :height
     1773       .
     1774       run diasize_set-height in this-procedure
     1775         (input  v-diasize-orig-frame-height
     1776         ,input  true
     1777         ) .
     1778       run diasize_set-width in this-procedure
     1779         (input  v-diasize-orig-frame-width
     1780         ,input  true
     1781         ) .
     1782     end.
     1783   end procedure.
     1784   procedure diasize_restore-current-size :
     1785     do
     1786     on error undo, return error return-value
     1787     :
     1788       run diasize_set-height in this-procedure
     1789         (input  v-diasize-current-frame-height
     1790         ,input  true
     1791         ) .
     1792       run diasize_set-width in this-procedure
     1793         (input  v-diasize-current-frame-width
     1794         ,input  true
     1795         ) .
     1796     end.
     1797   end procedure.
     1798   procedure diasize_set-browse-handle :
     1799     define input  parameter p-browse-handle as handle   no-undo .
     1800     define buffer buf_temp-browse-handle for temp-browse-handle .
     1801     do
     1802     on error undo, return error return-value
     1803     :
     1804       assign
     1805         v-diasize-browse-handle = p-browse-handle
     1806       .
     1807       for each buf_temp-browse-handle
     1808       on error undo, return error return-value
     1809       :
     1810         delete buf_temp-browse-handle .
     1811       end.
     1812     end.
     1813   end procedure.
     1814   procedure diasize_add_browse :
     1815     define input  parameter p-browse-type   as character no-undo .
     1816     define input  parameter p-browse-handle as handle    no-undo .
     1817     define buffer buf_temp-browse-handle for temp-browse-handle .
     1818     do
     1819     on error undo, return error return-value
     1820     :
     1821       assign
     1822         v-diasize-browse-number = v-diasize-browse-number + 1
     1823       .
     1824       create buf_temp-browse-handle .
     1825       assign
     1826         buf_temp-browse-handle.browse-type   = p-browse-type
     1827         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1828         buf_temp-browse-handle.browse-handle = p-browse-handle
     1829       .
     1830     end.
     1831   end procedure.
     1832   procedure diasize_init :
     1833     define variable v-default-value    as logical   no-undo .
     1834     define variable v-restore-saved    as logical   no-undo .
     1835     define variable v-resize-value-str as character no-undo .
     1836     do
     1837     on error undo, return error return-value
     1838     :
     1839       do with frame Dialog-Frame
     1840       :
     1841         assign
     1842           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1843           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1844           v-diasize-browse-handle     = browse BR-msf :handle
     1845         .
     1846         create button v-diasize-resize-button
     1847         assign
     1848           parent        = frame Dialog-Frame :first-child
     1849           label         = "s"
     1850           height-pixels = 16
     1851           width-pixels  = 16
     1852           visible       = true
     1853           sensitive     = true
     1854           movable       = true
     1855           triggers:
     1856             on end-move persistent run diasize_end-move in this-procedure .
     1857           end triggers.
     1858         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1859         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1860         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1861         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1862         assign
     1863           v-diasize-wndmax = false
     1864         .
     1865         if connected("ub") = true
     1866         then do:
     1867           define variable v-cntxt-db-num        as integer   no-undo .
     1868           define variable v-cntxt-userid        as character no-undo .
     1869           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1870                                             , OUTPUT v-cntxt-userid
     1871                                             ) .
     1872           run gbl/wndpar_r.p
     1873             (input  v-cntxt-db-num
     1874             ,input  v-cntxt-userid
     1875             ,input  'wndmax':U
     1876             ,output v-diasize-wndmax
     1877             ,output v-default-value
     1878             ) .
     1879         end.
     1880         assign
     1881           v-diasize-wndstore = false
     1882         .
     1883         if connected("ub") = true
     1884         then do:
     1885           run gbl/wndpar_r.p
     1886             (input  v-cntxt-db-num
     1887             ,input  v-cntxt-userid
     1888             ,input  'wndstore':U
     1889             ,output v-diasize-wndstore
     1890             ,output v-default-value
     1891             ) .
     1892         end.
     1893         assign
     1894           v-diasize-proc-name = entry(1, program-name(2), '.')
     1895         .
     1896         if v-diasize-wndstore = true
     1897         then do:
     1898           assign
     1899             v-restore-saved = false
     1900           .
     1901           if connected("ub") = true
     1902           then do:
     1903             run gbl/wndsizer.p
     1904               (input  v-cntxt-db-num
     1905               ,input  v-cntxt-userid
     1906               ,input  v-diasize-proc-name
     1907               ,input  'height':u
     1908               ,output v-resize-value-str
     1909               ) .
     1910             if v-resize-value-str <> '':U
     1911             then do:
     1912               run diasize_change-height in this-procedure
     1913                 (input  integer(v-resize-value-str)
     1914                 ,input  true
     1915                 ) .
     1916               assign
     1917                 v-restore-saved = true
     1918               .
     1919             end.
     1920           end.
     1921           if connected("ub") = true
     1922           then do:
     1923             run gbl/wndsizer.p
     1924               (input  v-cntxt-db-num
     1925               ,input  v-cntxt-userid
     1926               ,input  v-diasize-proc-name
     1927               ,input  'width':u
     1928               ,output v-resize-value-str
     1929               ) .
     1930             if v-resize-value-str <> '':U
     1931             then do:
     1932               run diasize_change-width in this-procedure
     1933                 (input  integer(v-resize-value-str)
     1934                 ,input  true
     1935                 ) .
     1936               assign
     1937                 v-restore-saved = true
     1938               .
     1939             end.
     1940           end.
     1941           if v-restore-saved <> true
     1942           then do:
     1943             if v-diasize-wndmax = true
     1944             then do:
     1945               run diasize_maximize in this-procedure
     1946                 (input  true
     1947                 ) .
     1948             end.
     1949           end.
     1950         end.
     1951         else do:
     1952           if v-diasize-wndmax = true
     1953           then do:
     1954             run diasize_maximize in this-procedure
     1955               (input  true
     1956               ) .
     1957           end.
     1958         end.
     1959       end.
     1960     end.
     1961   end procedure.
     1962   procedure diasize_need-full-display :
     1963     define output parameter p-need-full-display as logical   no-undo .
     1964     do
     1965     on error undo, return error return-value
     1966     :
     1967       assign
     1968         p-need-full-display = v-diasize-need-full-display
     1969       .
     1970       assign
     1971         v-diasize-need-full-display = false
     1972       .
     1973     end.
     1974   end procedure.
     1975   procedure get-context :
     1976      define output parameter p-db-num as integer          no-undo.
     1977      define output parameter p-user-id as character        no-undo.
     1978      define variable v-login               as character    no-undo.
     1979      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1980      define buffer buf_user-login  for ub.user-login .
     1981      do
     1982      on error undo, return error
     1983      :
     1984            FIND FIRST buf_sys-ctrl no-lock.
     1985            ASSIGN
     1986               v-login = USERID("ub")
     1987               p-db-num = buf_sys-ctrl.db-num
     1988            .
     1989            FIND FIRST buf_user-login
     1990                 WHERE buf_user-login.db-num = p-db-num
     1991                   AND buf_user-login.user-login = v-login
     1992                 no-lock
     1993                 no-error
     1994                 .
     1995            IF AVAILABLE buf_user-login
     1996            THEN DO:
     1997               assign
     1998                  p-user-id = buf_user-login.user-id
     1999               .
     2000            END.
     2001      end.
     2002   end procedure.
     2003       run diasize_init in this-procedure .
     2004   on value-changed of dop-msf.kind-name in frame Dialog-Frame do:
     2005     if dop-msf.kind-name:screen-value in frame Dialog-Frame  <> "кусковые" then do:
     2006       dop-msf.subkind-name-1:screen-value in frame Dialog-Frame  = "-".
     2007       dop-msf.subkind-name-2:screen-value in frame Dialog-Frame  = "-".
     2008     end.
     2009   end.
     2010   MAIN-BLOCK:
     2011   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2012      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2013   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2014     run mainmenu_getcntxt in parparentproc
     2015       (output v-cntxt-db-num
     2016       ,output v-cntxt-userid
     2017       ,output v-cntxt-level
     2018       ,output v-cntxt-host-code-obj
     2019       ,output v-cntxt-obj-type
     2020       ,output v-cntxt-obj-code
     2021       ,output v-cntxt-db-num-obj
     2022       ,output v-cntxt-is-admin
     2023       ) .
     2024     IF LOOKUP(p-mode, 'ИЗМЕНЕНИЕ':U + chr(44) + 'ПРОСМОТР':U) = 0  THEN DO:
     2025       MESSAGE
     2026       substitute("Неверное значение параметрf p-mode = &1"
     2027       , p-mode)
     2028       VIEW-AS alert-box.
     2029       UNDO, RETURN ERROR.
     2030     END.
     2031     IF p-mode = 'ИЗМЕНЕНИЕ':U
     2032     AND LOOKUP("b-sel", bttns) > 0   THEN DO:
     2033       MESSAGE
     2034       substitute("Неверное значение параметров bttns = &1 и/или p-mode = &2"
     2035                  , bttns
     2036                  , p-mode)
     2037       VIEW-AS alert-box.
     2038       UNDO, RETURN ERROR.
     2039     END.
     2040     if p-mode = 'ИЗМЕНЕНИЕ':U
     2041     and v-cntxt-db-num > 0 then do:
     2042       MESSAGE
     2043       substitute("Нельзя редактировать классификатор в УБД")
     2044       VIEW-AS alert-box.
     2045       UNDO, RETURN ERROR.
     2046     end.
     2047     v-node-code = p-node-code.
     2048     RUN fill-tables in THIS-PROCEDURE.
     2049     RUN Myenable.
     2050     WAIT-FOR GO OF FRAME Dialog-Frame.
     2051   END.
     2052   RUN disable_UI.
     2053   PROCEDURE disable_UI :
     2054     HIDE FRAME Dialog-Frame.
     2055   END PROCEDURE.
     2056   PROCEDURE enable_UI :
     2057     ENABLE B-exit b-quit b-sel b-add b-del b-gds-list B-Help BR-msf
     2058         WITH FRAME Dialog-Frame.
     2059     VIEW FRAME Dialog-Frame.
     2060   END PROCEDURE.
     2061   PROCEDURE fill-tables :
     2062   run meatsemi_fill-msf in this-procedure ( input p-mode
     2063                                           , buffer buf_clob-bind).
     2064   CREATE dop-msf.
     2065   RELEASE dop-msf.
     2066   FIND LAST meat-semi-finished NO-ERROR.
     2067   IF AVAILABLE meat-semi-finished THEN DO:
     2068      ASSIGN
     2069      v-max-node-code = meat-semi-finished.node-code.
     2070   END.
     2071   ELSE DO:
     2072       ASSIGN
     2073       v-max-node-code = 0.
     2074   END.
     2075   release meat-semi-finished NO-ERROR.
     2076   END PROCEDURE.
     2077   PROCEDURE MyEnable :
     2078   if (lookup("b-add", bttns) > 0 AND v-cntxt-db-num = 0 AND NOT TRANSACTION AND p-mode = 'ИЗМЕНЕНИЕ':U) then do:
     2079     v-edit-mode = yes.
     2080   end.
     2081   FIND FIRST dop-msf.
     2082   enable
     2083   br-msf
     2084   b-add WHEN v-edit-mode
     2085   b-del WHEN v-edit-mode
     2086   b-sel WHEN (lookup("b-sel", bttns) > 0)
     2087   b-help
     2088   b-exit WHEN v-edit-mode
     2089   b-quit
     2090   b-gds-list
     2091   WITH FRAME Dialog-Frame
     2092   .
     2093   IF p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     2094     HIDE
     2095     b-exit
     2096     IN FRAME Dialog-Frame.
     2097     b-quit:COLUMN  = 1.
     2098     b-quit:label in frame Dialog-Frame = "&Выход".
     2099   END.
     2100   OPEN QUERY BR-msf FOR EACH meat-semi-finished NO-LOCK WHERE TRUE  BY meat-semi-finished.group-name BY meat-semi-finished.kind-name BY meat-semi-finished.subkind-name BY meat-semi-finished.category-name BY meat-semi-finished.termic-condition-name INDEXED-REPOSITION     .
     2101   APPLY "value-changed" TO BROWSE br-msf.
     2102   END PROCEDURE.
     2103   PROCEDURE proc-b-add :
     2104   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     2105   DEFINE BUFFER buf_msf FOR meat-semi-finished.
     2106   FIND LAST buf_msf NO-ERROR.
     2107   IF AVAILABLE buf_msf  THEN DO:
     2108       ASSIGN
     2109      v-node-code = buf_msf.node-code + 1.
     2110   END.
     2111   ELSE DO:
     2112      v-node-code = 1.
     2113   END.
     2114   DISPLAY
     2115   b-ok
     2116   b-cancel
     2117   WITH FRAME Dialog-Frame.
     2118   ENABLE
     2119   b-ok
     2120   b-cancel
     2121   WITH FRAME Dialog-Frame.
     2122   disable
     2123   b-add
     2124   b-del
     2125   b-gds-list
     2126   with frame Dialog-Frame .
     2127   do transaction:
     2128     delete dop-msf.
     2129     CREATE dop-msf.
     2130     ASSIGN
     2131     dop-msf.node-code = v-node-code
     2132     .
     2133   end.
     2134   DISPLAY
     2135   dop-msf.node-code
     2136   dop-msf.group-name
     2137   dop-msf.kind-name SKIP
     2138   dop-msf.subkind-name-1
     2139   dop-msf.subkind-name-2 SKIP
     2140   dop-msf.subkind-name-3
     2141   dop-msf.subkind-name-4 SKIP
     2142   dop-msf.subkind-name-5
     2143   dop-msf.subkind-name-6 SKIP
     2144   dop-msf.category-name
     2145   dop-msf.termic-condition-name
     2146   WITH FRAME Dialog-Frame
     2147   .
     2148   enable
     2149   dop-msf.group-name
     2150   dop-msf.kind-name
     2151   dop-msf.subkind-name-1
     2152   dop-msf.subkind-name-2
     2153   dop-msf.subkind-name-3
     2154   dop-msf.subkind-name-4
     2155   dop-msf.subkind-name-5
     2156   dop-msf.subkind-name-6
     2157   dop-msf.category-name
     2158   dop-msf.termic-condition-name
     2159   WITH FRAME Dialog-Frame
     2160   .
     2161   END PROCEDURE.
     2162   PROCEDURE proc-b-del :
     2163   DEFINE BUFFER buf_msf FOR meat-semi-finished.
     2164   IF meat-semi-finished.node-code <= v-max-node-code  THEN DO:
     2165     MESSAGE
     2166     "К сожалению, удалить эту запись уже невозможно!!!" SKIP
     2167     "Она сохранена в БД"
     2168      VIEW-AS ALERT-BOX.
     2169      undo, return error .
     2170   END.
     2171   FIND FIRST buf_msf WHERE RECID(buf_msf) = RECID(meat-semi-finished) NO-ERROR.
     2172   DELETE buf_msf .
     2173   OPEN QUERY BR-msf FOR EACH meat-semi-finished NO-LOCK WHERE TRUE  BY meat-semi-finished.group-name BY meat-semi-finished.kind-name BY meat-semi-finished.subkind-name BY meat-semi-finished.category-name BY meat-semi-finished.termic-condition-name INDEXED-REPOSITION     .
     2174   APPLY "value-changed" TO BROWSE br-msf.
     2175   END PROCEDURE.
     2176   PROCEDURE proc-save-all :
     2177   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2178   define variable v-part-num as integer no-undo .
     2179   define variable v-mode as character no-undo .
     2180   define variable v-clob-mode as character no-undo .
     2181   define variable v-clob-db-num as integer no-undo .
     2182   define variable v-int64-id as int64 no-undo .
     2183   define variable v-path                    as character                no-undo .
     2184   DEFINE VARIABLE v-full-path               as character                no-undo .
     2185   DEFINE VARIABLE v-file-name               as character                no-undo .
     2186   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     2187   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     2188   DEFINE BUFFER buf_meat-semi-finished FOR meat-semi-finished.
     2189   FOR EACH buf_meat-semi-finished WHERE buf_meat-semi-finished.node-code < 0:
     2190       DELETE buf_meat-semi-finished.
     2191   END.
     2192   find last buf_meat-semi-finished no-error.
     2193   if (available buf_meat-semi-finished
     2194   and buf_meat-semi-finished.node-code = v-max-node-code )
     2195   or (not available buf_meat-semi-finished
     2196   and v-max-node-code  = 0)
     2197   then do:
     2198     message
     2199     "Классификатор не изменился" skip
     2200     "сохранение не требуется"
     2201     view-as alert-box warning
     2202     .
     2203     return.
     2204   end.
     2205   run gbl/_tmpfile.p ( input ""
     2206                       ,input "xml"
     2207                       ,output v-file-name) .
     2208   output to value(v-file-name).
     2209   put 1 skip.
     2210   output close.
     2211   run gbl/filename.p (
     2212                  input v-file-name
     2213                 ,output v-full-path
     2214                 ,output v-path
     2215                 ,output v-file-name
     2216                 ,output v-file-name-no-ext
     2217                 ,output v-file-name-ext
     2218                 ) no-error .
     2219   if error-status:error then do:
     2220     undo, return error .
     2221   end.
     2222   glog = DATASET meat-semi-finished-ds:HANDLE:write-XML("FILE"
     2223                                              , v-full-path
     2224                                               , YES
     2225                                               , "windows-1251"
     2226                                               , ?
     2227                                               , YES
     2228                                                ,NO  ) NO-ERROR.
     2229   if error-status:error or not glog then do:
     2230     os-delete value(v-full-path) no-error.
     2231     MESSAGE
     2232     ERROR-STATUS:GET-MESSAGE(1) SKIP
     2233     RETURN-VALUE
     2234     VIEW-AS ALERT-BOX ERROR.
     2235     UNDO, RETURN ERROR.
     2236   end.
     2237   assign
     2238   v-part-num = 1.
     2239   if not available buf_clob-bind then do:
     2240     v-mode = 'ДОБАВЛЕНИЕ':U.
     2241     v-clob-mode = "".
     2242     v-clob-db-num = ?.
     2243     v-int64-id = 0.
     2244   end.
     2245   else do:
     2246     v-mode = 'ИЗМЕНЕНИЕ':U.
     2247     v-clob-mode = "add-new".
     2248     v-clob-db-num = buf_clob-bind.db-num.
     2249     v-int64-id = buf_clob-bind.int64-id.
     2250   end.
     2251   run gbl/file2clb.p ( input v-mode
     2252                       ,input v-clob-mode
     2253                       ,input ?
     2254                       ,input "meat-semi-finished.xml"
     2255                       ,input ''
     2256                       ,input frame Dialog-Frame:title
     2257                       ,input-output v-part-num
     2258                       ,input 'ref':U
     2259                       ,input-output v-clob-db-num
     2260                       ,input-output v-int64-id
     2261                       ,input v-full-path
     2262                       ,input ?
     2263                       ) no-error .
     2264   IF ERROR-STATUS:ERROR THEN DO:
     2265     os-delete value(v-full-path) no-error.
     2266     MESSAGE
     2267     ERROR-STATUS:GET-MESSAGE(1) SKIP
     2268     RETURN-VALUE
     2269     VIEW-AS ALERT-BOX ERROR.
     2270     UNDO, RETURN ERROR.
     2271   END.
     2272   os-delete value(v-full-path) no-error.
     2273   END PROCEDURE.
     2274   PROCEDURE proc-save-record :
     2275   define variable v-rec as recid no-undo .
     2276   DEFINE BUFFER buf_msf FOR meat-semi-finished.
     2277   ASSIGN
     2278   FRAME Dialog-Frame
     2279   dop-msf.group-name
     2280   dop-msf.kind-name
     2281   dop-msf.subkind-name-1
     2282   dop-msf.subkind-name-2
     2283   dop-msf.subkind-name-3
     2284   dop-msf.subkind-name-4
     2285   dop-msf.subkind-name-5
     2286   dop-msf.subkind-name-6
     2287   dop-msf.category-name
     2288   dop-msf.termic-condition-name
     2289   .
     2290   FIND FIRST buf_msf  WHERE
     2291       buf_msf.node-code = dop-msf.node-code NO-ERROR.
     2292   IF AVAILABLE buf_msf THEN DO:
     2293       ASSIGN
     2294       dop-msf.node-code = 0
     2295       .
     2296       MESSAGE
     2297       substitute("Уже есть запись с таким вн. кодом &1", dop-msf.node-code)
     2298       VIEW-AS ALERT-BOX ERROR.
     2299       RUN proc-undo-record IN this-procedure.
     2300      RETURN.
     2301   END.
     2302   FIND FIRST buf_msf  WHERE
     2303           buf_msf.group-name = dop-msf.group-name
     2304       AND buf_msf.kind-name = dop-msf.kind-name
     2305       AND buf_msf.subkind-name-1 = dop-msf.subkind-name-1
     2306       AND buf_msf.subkind-name-2 = dop-msf.subkind-name-2
     2307       AND buf_msf.subkind-name-3 = dop-msf.subkind-name-3
     2308       AND buf_msf.subkind-name-4 = dop-msf.subkind-name-4
     2309       AND buf_msf.subkind-name-5 = dop-msf.subkind-name-5
     2310       AND buf_msf.subkind-name-6 = dop-msf.subkind-name-6
     2311       AND buf_msf.category-name = dop-msf.category-name
     2312       AND buf_msf.termic-condition = dop-msf.termic-condition
     2313       NO-ERROR.
     2314   IF AVAILABLE buf_msf THEN DO:
     2315     MESSAGE
     2316     substitute("Уже есть запись с такими характеристиками")
     2317     VIEW-AS ALERT-BOX ERROR.
     2318     return.
     2319   END.
     2320   if dop-msf.group-name = ''
     2321   or dop-msf.group-name = ? then do:
     2322     MESSAGE
     2323     substitute("Не задана Группа")
     2324     VIEW-AS ALERT-BOX ERROR.
     2325     return.
     2326   end.
     2327   if dop-msf.kind-name = ''
     2328   or dop-msf.kind-name = ? then do:
     2329     MESSAGE
     2330     substitute("Не задан Вид")
     2331     VIEW-AS ALERT-BOX ERROR.
     2332     return.
     2333   end.
     2334   if dop-msf.subkind-name-1 = ''
     2335   or dop-msf.subkind-name-1 = ? then do:
     2336     MESSAGE
     2337     substitute("Не задан подвид (Кости-мясо)")
     2338     VIEW-AS ALERT-BOX ERROR.
     2339     return.
     2340   end.
     2341   if dop-msf.subkind-name-2 = ''
     2342   or dop-msf.subkind-name-2 = ? then do:
     2343     MESSAGE
     2344     substitute("Не задан подвид (Дискретность)")
     2345     VIEW-AS ALERT-BOX ERROR.
     2346     return.
     2347   end.
     2348   if dop-msf.subkind-name-3 = ''
     2349   or dop-msf.subkind-name-3 = ? then do:
     2350     MESSAGE
     2351     substitute("Не задан подвид (Фаршировка)")
     2352     VIEW-AS ALERT-BOX ERROR.
     2353     return.
     2354   end.
     2355   if dop-msf.subkind-name-4 = ''
     2356   or dop-msf.subkind-name-4 = ? then do:
     2357     MESSAGE
     2358     substitute("Не задан подвид (Формовка)")
     2359     VIEW-AS ALERT-BOX ERROR.
     2360     return.
     2361   end.
     2362   if dop-msf.subkind-name-5 = ''
     2363   or dop-msf.subkind-name-5 = ? then do:
     2364     MESSAGE
     2365     substitute("Не задан подвид (Панировка)")
     2366     VIEW-AS ALERT-BOX ERROR.
     2367     return.
     2368   end.
     2369   if dop-msf.subkind-name-6 = ''
     2370   or dop-msf.subkind-name-6 = ? then do:
     2371     MESSAGE
     2372     substitute("Не задан подвид (Фасовка)")
     2373     VIEW-AS ALERT-BOX ERROR.
     2374     return.
     2375   end.
     2376   if dop-msf.category-name = ''
     2377   or dop-msf.category-name = ? then do:
     2378     MESSAGE
     2379     substitute("Не задана Категория")
     2380     VIEW-AS ALERT-BOX ERROR.
     2381     return.
     2382   end.
     2383   if dop-msf.termic-condition-name = ''
     2384   or dop-msf.termic-condition-name = ? then do:
     2385     MESSAGE
     2386     substitute("Не задано Термическое состояние")
     2387     VIEW-AS ALERT-BOX ERROR.
     2388     return.
     2389   end.
     2390   IF dop-msf.group-name = "мясосодержащие"
     2391   AND (dop-msf.category = "категория А"
     2392        OR
     2393        dop-msf.category = "категория Б")
     2394        THEN DO:
     2395       MESSAGE
     2396       "Не бывает мясосодержащих полуфабрикатов такой категории!"
     2397       VIEW-AS ALERT-BOX ERROR.
     2398       return.
     2399   END.
     2400   IF dop-msf.kind-name <> "кусковые"
     2401   AND dop-msf.subkind-name-1 <> "-" THEN DO:
     2402       MESSAGE
     2403       SUBSTITUTE("Для полуфабрикатов такой группы нельзя задать свойство Кости-мясо = &1!", dop-msf.subkind-name-1)
     2404       VIEW-AS ALERT-BOX ERROR.
     2405       return.
     2406   END.
     2407   DO TRANSACTION
     2408   ON error UNDO, RETURN ERROR :
     2409       CREATE buf_msf.
     2410       BUFFER-COPY dop-msf TO buf_msf
     2411       assign
     2412       buf_msf.subkind-name =
     2413       buf_msf.subkind-name-1 + chr(44) +
     2414       buf_msf.subkind-name-2 + chr(44) +
     2415       buf_msf.subkind-name-3 + chr(44) +
     2416       buf_msf.subkind-name-4 + chr(44) +
     2417       buf_msf.subkind-name-5 + chr(44) +
     2418       buf_msf.subkind-name-6
     2419       buf_msf.lvl-num = 5
     2420       .
     2421       DELETE dop-msf.
     2422       CREATE dop-msf.
     2423       FIND FIRST dop-msf.
     2424       v-rec = RECID(buf_msf).
     2425       RELEASE buf_msf.
     2426   END.
     2427   disable dop-msf.node-code dop-msf.group-name dop-msf.kind-name dop-msf.subkind-name-1  dop-msf.subkind-name-2  dop-msf.subkind-name-3  dop-msf.subkind-name-4  dop-msf.subkind-name-5  dop-msf.subkind-name-6  dop-msf.category-name   dop-msf.termic-condition-name with FRAME Dialog-Frame. hide dop-msf.node-code in FRAME Dialog-Frame dop-msf.group-name dop-msf.kind-name dop-msf.subkind-name-1  dop-msf.subkind-name-2  dop-msf.subkind-name-3  dop-msf.subkind-name-4  dop-msf.subkind-name-5  dop-msf.subkind-name-6  dop-msf.category-name   dop-msf.termic-condition-name in FRAME Dialog-Frame.
     2428   HIDE b-ok b-cancel IN FRAME Dialog-Frame.
     2429   OPEN QUERY BR-msf FOR EACH meat-semi-finished NO-LOCK WHERE TRUE  BY meat-semi-finished.group-name BY meat-semi-finished.kind-name BY meat-semi-finished.subkind-name BY meat-semi-finished.category-name BY meat-semi-finished.termic-condition-name INDEXED-REPOSITION     .
     2430   REPOSITION br-msf TO RECID v-rec.
     2431   APPLY "value-changed" TO br-msf.
     2432   END PROCEDURE.
     2433   PROCEDURE proc-undo-record :
     2434   delete dop-msf.
     2435   create dop-msf.
     2436   RELEASE dop-msf.
     2437   FIND FIRST dop-msf.
     2438   disable dop-msf.node-code dop-msf.group-name dop-msf.kind-name dop-msf.subkind-name-1  dop-msf.subkind-name-2  dop-msf.subkind-name-3  dop-msf.subkind-name-4  dop-msf.subkind-name-5  dop-msf.subkind-name-6  dop-msf.category-name   dop-msf.termic-condition-name with FRAME Dialog-Frame. hide dop-msf.node-code in FRAME Dialog-Frame dop-msf.group-name dop-msf.kind-name dop-msf.subkind-name-1  dop-msf.subkind-name-2  dop-msf.subkind-name-3  dop-msf.subkind-name-4  dop-msf.subkind-name-5  dop-msf.subkind-name-6  dop-msf.category-name   dop-msf.termic-condition-name in FRAME Dialog-Frame.
     2439   HIDE b-ok b-cancel IN FRAME Dialog-Frame.
     2440   APPLY "VALUE-CHANGED" TO br-msf IN FRAME Dialog-Frame.
     2441   END PROCEDURE.
     2442   FUNCTION mark-string RETURNS CHARACTER
     2443     ( INPUT p-current-node-code AS INTEGER ) :
     2444    RETURN ( IF p-current-node-code = v-node-code THEN '*' ELSE '':U ).
     2445   END FUNCTION.
