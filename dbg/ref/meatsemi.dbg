     1235   procedure diasize_set-height :
     1236     define input  parameter p-new-height  as decimal   no-undo .
     1237     define input  parameter p-move-resize as logical   no-undo .
     1238     do
     1239     on error undo, return error return-value
     1240     :
     1241       run diasize_change-height in this-procedure
     1242         (input  (p-new-height - frame Dialog-Frame :height)
     1243         ,input  p-move-resize
     1244         ) .
     1245     end.
     1246   end procedure.
     1247   procedure diasize_change-width :
     1248     define input  parameter p-change-value as decimal   no-undo .
     1249     define input  parameter p-move-resize  as logical   no-undo .
     1250     define variable v-field-group-handle   as handle    no-undo .
     1251     define variable v-object-handle        as handle    no-undo .
     1252     define variable v-frame-width          as decimal   no-undo .
     1253     define variable v-frame-virtual-width  as decimal   no-undo .
     1254     define variable v-browse-width         as decimal   no-undo .
     1255     define variable v-window-width         as decimal   no-undo .
     1256     define variable v-window-virtual-width as decimal   no-undo .
     1257     define variable v-change-sign          as integer   no-undo .
     1258     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1259     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1260     if p-change-value > 0
     1261     then do:
     1262       if frame Dialog-Frame :width + p-change-value >
     1263           session :width-chars
     1264       then do:
     1265         assign
     1266           p-change-value = session :width-chars - frame Dialog-Frame :width
     1267         .
     1268         if p-change-value <= 0
     1269         then do:
     1270           run diasize_position-resize-button in this-procedure .
     1271           return .
     1272         end.
     1273       end.
     1274     end.
     1275     if p-change-value < 0
     1276     then do:
     1277       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1278       then do:
     1279         assign
     1280           p-change-value = v-diasize-orig-frame-width
     1281                          - frame Dialog-Frame :width
     1282         .
     1283         if p-change-value >= 0
     1284         then do:
     1285           run diasize_position-resize-button in this-procedure .
     1286           return .
     1287         end.
     1288       end.
     1289     end.
     1290     if p-change-value >= 0
     1291     then do:
     1292       assign
     1293         v-change-sign = 1
     1294       .
     1295     end.
     1296     else do:
     1297       assign
     1298         v-change-sign = -1
     1299       .
     1300     end.
     1301     assign
     1302       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1303     .
     1304     if p-change-value = 0
     1305     then do:
     1306       run diasize_position-resize-button in this-procedure .
     1307       return .
     1308     end.
