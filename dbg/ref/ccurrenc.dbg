        1   DEFINE BUFFER X_c-currency FOR ub.c-currency.
        2   DEFINE BUFFER X_currency FOR ub.currency.
        3   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        4   define input parameter bttns  as char   no-undo .
        5   define input parameter p-mode  as char   no-undo .
        6   define input parameter p-curr-code like ub.currency.curr-code no-undo .
        7   define input-output param p-rid-list    as  char no-undo .
        8   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
        9   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       10   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       11   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       12   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       13   define variable vss-description AS CHAR NO-UNDO INIT "Список истории валюты":U.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   procedure proc-alt-shift-f2:
       84     if not ibs.th.gbl.gbl-var:rcode
       85   then
       86     run gbl\inidebug.p .
       87   end.
       88   procedure proc-alt-shift-f3:
       89     run gbl/prvssinf.p
       90       ( input this-procedure
       91       ) .
       92   end.
       93   define variable v-inform-launched as logical no-undo initial false .
       94   procedure proc-alt-shift-f4:
       95     define variable v-action as character no-undo .
       96     if v-inform-launched = false then do:
       97       assign
       98         v-inform-launched = true
       99       .
      100       run gbl/d-inform.w
      101         (  input self
      102         ,  input this-procedure
      103         , output v-action
      104         ) no-error .
      105       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      106       assign
      107         v-inform-launched = false
      108       .
      109     end.
      110   end.
      111   procedure proc-alt-f1:
      112     run gbl/corrhelp.p
      113       (input this-procedure
      114       ) .
      115   end .
      116   on alt-shift-f2 anywhere do:
      117     run proc-alt-shift-f2.
      118   end.
      119   on alt-shift-f3 anywhere do:
      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      130   define new shared variable RepPathName        as character no-undo .
      131   define new shared variable PrintRubl          as logical   no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define variable v-waitfram-action01         as character   no-undo .
      134   define variable v-waitfram-action02         as character   no-undo .
      135   define variable v-waitfram-action03         as character   no-undo .
      136   define variable mWaitFramTextBeg            as character   no-undo.
      137   define variable mWaitFramTextEnd            as character   no-undo.
      138   define variable mWaitFramView               as logical     no-undo.
      139   define variable mWaitProcEvent              as logical     no-undo init yes.
      140   define variable mWaitFramInterval           as integer     no-undo init 1 .
      141   define variable mWaitFramStop               as logical     no-undo.
      142   define variable mWaitFramStopUser           as logical     no-undo.
      143   define variable mWaitFramStopTimeOut        as logical     no-undo.
      144   define variable mWaitFramStartProc          as datetime-tz no-undo.
      145   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      146   define button B-WaitFramStop auto-end-key
      147        label "Стоп"
      148        size 10 by 1 tooltip "Остоновить процесс".
      149   define button B-viewProcInfo
      150        label "Информация"
      151        size 15 by 1 tooltip "Информация о процесс".
      152   define frame waitfram
      153     v-waitfram-action01 format "x(72)" no-label skip
      154     v-waitfram-action02 format "x(72)" no-label skip
      155     v-waitfram-action03 format "x(72)" no-label skip
      156     B-viewProcInfo
      157     B-WaitFramStop at row 4 col 30
      158     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      159     .
      160   define new global shared variable mBatchMode as logical no-undo init ?.
      161   define variable mFramBachModHandle as handle no-undo.
      162   mFramBachModHandle = frame waitfram:handle.
      163   define variable mFameOldVis as logical no-undo.
      164   define variable mVisCUrentVin as logical no-undo.
      165   if session:batch-mode
      166   then
      167      mBatchMode = yes.
      168   if mBatchMode = ? then do:
      169     mVisCUrentVin = current-window:visible.
      170     mFameOldVis = mFramBachModHandle:visible.
      171     mFramBachModHandle:visible  = yes.
      172     mBatchMode = mFramBachModHandle:visible ne yes.
      173     mFramBachModHandle:visible = mFameOldVis.
      174     current-window:visible = mVisCUrentVin.
      175   end.
      176    if  log-manager:logfile-name ne ?
      177     then DO:
      178         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      179         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      180         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      181     end.
      182   on choose of B-WaitFramStop in frame waitfram
      183   do:
      184     mWaitFramStop = yes.
      185     mWaitFramStopUser = yes.
      186   end.
      187   function waitfram-check-timeout returns logical():
      188      define variable vtime as int64 no-undo.
      189      if mWaitFramStopTimeOut
      190      then
      191         return yes.
      192      vtime = ( now - mWaitFramStartProc ) / 1000 .
      193      if     mWaitFramTimeOut ne ?
      194         and mWaitFramTimeOut ne 0
      195         and mWaitFramTimeOut lt vtime
      196      then do:
      197         mWaitFramStopTimeOut = yes.
      198      end.
      199      return mWaitFramStopTimeOut.
      200   end.
      201   procedure waitfram-hide :
      202     if not session:batch-mode
      203     then do
      204     on error undo, return error return-value
      205     :
      206       pause 0 before-hide .
      207       if not mBatchMode then
      208         hide frame waitfram .
      209     if     not mWaitFramView
      210        and mWaitProcEvent
      211     then
      212       process events .
      213     end.
      214   end procedure.
      215   procedure waitfram-show :
      216     define input  parameter p-message as character no-undo .
      217     define variable v-left-margin as integer   no-undo .
      218     if not session:batch-mode
      219     then do
      220     on error undo, return error return-value
      221     :
      222       if length(p-message) <= 70 then do:
      223         assign
      224           v-left-margin = integer((70 - length(p-message)) / 2)
      225         .
      226         assign
      227           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      228         .
      229         assign
      230           v-waitfram-action01 = " "
      231           v-waitfram-action02 = " "
      232                                    + fill(" ", v-left-margin)
      233                                    + p-message
      234           v-waitfram-action03 = " "
      235         .
      236       end.
      237       else do:
      238         define variable vRindex1 as integer no-undo.
      239         define variable vRindex2 as integer no-undo.
      240         vRindex1 = r-index(p-message," ",70).
      241         if vRindex1 = 0
      242         then
      243            vRindex1 = 70.
      244         if length(p-message)  <= vRindex1 + 70 then do:
      245           assign
      246             v-waitfram-action01 = " "
      247             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      248             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      249           .
      250         end.
      251         else do:
      252           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      253           if vRindex2 <= vRindex1
      254           then
      255              vRindex2 = vRindex1 + 70.
      256           assign
      257             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      258             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      259             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      260           .
      261         end.
      262       end.
      263       B-viewProcInfo:visible   in frame waitfram = no.
      264       B-viewProcInfo:sensitive in frame waitfram = no.
      265       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      266       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      267       if  (   mWaitFramView
      268          or  mWaitProcEvent)
      269          and not mBatchMode
      270       then
      271          display
      272             v-waitfram-action01 skip
      273             v-waitfram-action02 skip
      274             v-waitfram-action03 skip
      275          with frame waitfram .
      276       if     mWaitFramView
      277          then do:
      278             if     mWaitFramInterval ne ?
      279                and not mBatchMode
      280             then
      281                wait-for go of frame waitfram pause mWaitFramInterval.
      282          end.
      283          else
      284             if     mWaitProcEvent
      285                and not mBatchMode
      286             then
      287                process events .
      288     end.
      289   end procedure.
      290      procedure waitfram-show-this:
      291         define input  parameter iInterval as int64 no-undo.
      292         define variable vtime as int64 no-undo.
      293         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      294         mWaitFramInterval = iInterval.
      295         run waitfram-show (substitute("&1&2 &3&4" ,
      296                                       mWaitFramTextBeg ,
      297                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      298                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      299                                       mWaitFramTextEnd
      300                                      )
      301                           ).
      302      end.
      303      procedure WaitFramRunPause:
      304         define input  parameter iInterval as dec no-undo.
      305         define variable vStart  as datetime-tz no-undo.
      306         define variable vend    as datetime-tz no-undo.
      307         define variable vint as int64 no-undo.
      308         define variable vOk as logical no-undo.
      309         vStart = now.
      310         vend   = vStart.
      311         publish "WaitFramPause" (iInterval,output vOk).
      312         vend   =  now.
      313         vint = vend - vStart.
      314         vint = iInterval - vint / 1000.
      315         if     not mWaitFramStop
      316            and (   vint > 0
      317                 or (    not vOk
      318                     and iInterval eq ?
      319                     )
      320                 )
      321         then
      322            run waitfram-show-this (iInterval).
      323         vend   =  now.
      324         vint = vend - vStart.
      325         vint = iInterval - vint / 1000.
      326         if     not mWaitFramStop
      327            and vint > 0
      328         then do:
      329            run gbl/pause.p (vint * 1000).
      330         end.
      331         if iInterval ne ?
      332         then
      333            publish "WaitFramStop".
      334         waitfram-check-timeout().
      335      end.
      336      procedure WaitFramWaitFor:
      337         define input  parameter iInterval as dec no-undo.
      338         assign
      339            mWaitFramStartProc   = now
      340            mWaitFramStopUser    = no
      341            mWaitFramStopTimeOut = no
      342         .
      343         block-wait:
      344         do while not mWaitFramStop:
      345            run WaitFramRunPause (iInterval).
      346            if  waitfram-check-timeout()
      347            then do:
      348               leave block-wait.
      349            end.
      350         end.
      351         run waitfram-hide.
      352      end.
      353   procedure waitfram-join :
      354     define input  parameter p-line-1  as character no-undo .
      355     define input  parameter p-line-2  as character no-undo .
      356     define input  parameter p-line-3  as character no-undo .
      357     define output parameter p-message as character no-undo .
      358     do
      359     on error undo, return error return-value
      360     :
      361       assign
      362         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      363                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      364                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      365       .
      366     end.
      367   end procedure.
      368   function waitfram-join-function returns character
      369     (input p-line-1 as character
      370     ,input p-line-2 as character
      371     ,input p-line-3 as character
      372     ).
      373     define variable v-message as character no-undo .
      374     run waitfram-join in this-procedure
      375       (input  p-line-1
      376       ,input  p-line-2
      377       ,input  p-line-3
      378       ,output v-message
      379       ) .
      380     return v-message .
      381   end function .
      382   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   define  stream PrnLibStream.
      384   procedure prn-lib-prn-file :
      385     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      386     define input parameter p-DIsabledoptions as integer no-undo .
      387     define variable v-report-name as character no-undo .
      388     define variable v-user-action as character no-undo .
      389     define variable v-printed     as logical   no-undo .
      390     define variable v-exist       as logical   no-undo .
      391     do
      392       on error undo, return error
      393       :
      394       run prn-lib-get-report-name  in this-procedure (
      395         input parParentProc
      396         ,output v-report-name
      397         ).
      398   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      400     (input  v-report-name
      401     ,input  2
      402     ,output v-exist
      403     )  .
      404       if NOT v-exist then
      405       DO:
      406         Message
      407           "Нет заданий на печать ! "
      408           view-as alert-box .
      409         Return  .
      410       End.
      411       run gbl/prnfilen.w
      412         (input  ""
      413         ,input  p-DisabledOptions
      414         ,input  string(v-report-name )
      415         ,input  7
      416         ,output v-user-action
      417         ,output v-printed
      418         ) .
      419       if v-printed then
      420       do:
      421         return "YES" .
      422       end.
      423       else
      424       do:
      425         return "NO" .
      426       end.
      427     end.
      428   end procedure.
      429   procedure prn-lib-open-stream :
      430     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      431     define input parameter p-page-size    as integer no-undo .
      432     define input parameter p-is-stream    as logical no-undo .
      433     define input parameter p-append       as logical no-undo .
      434     define variable v-report-name as character no-undo .
      435     do
      436       on error undo, return error
      437       :
      438       run prn-lib-get-report-name  in this-procedure (
      439         input parParentProc
      440         ,output v-report-name
      441         ).
      442       if p-is-stream then
      443       do:
      444         if p-append then
      445         do:
      446           output stream PrnLibStream to value( v-report-name )
      447             page-size value(p-page-size) append .
      448         end.
      449         if not p-append then
      450         do:
      451           output stream PrnLibStream to value( v-report-name )
      452             page-size value(p-page-size) .
      453         end.
      454       end.
      455       if not p-is-stream then
      456       do:
      457         if p-append then
      458         do:
      459           output to value( v-report-name )
      460             page-size value(p-page-size) append .
      461         end.
      462         if not p-append then
      463         do:
      464           output to value( v-report-name )
      465             page-size value(p-page-size) .
      466         end.
      467       end.
      468     end.
      469   end procedure.
      470   procedure prn-lib-open-exp :
      471     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      472     define input parameter p-is-stream    as logical no-undo .
      473     define input parameter p-is-append    as logical no-undo .
      474     define output parameter p-ReportFileName as char init "report" no-undo.
      475     define output parameter p-process as logical no-undo .
      476     define variable glog as logical no-undo .
      477     do
      478       on error undo, return error
      479       :
      480       SYSTEM-DIALOG GET-FILE p-ReportFileName
      481         TITLE      "Укажите путь"
      482         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      483         ASK-OVERWRITE
      484         CREATE-TEST-FILE
      485         SAVE-AS
      486         USE-FILENAME
      487         DEFAULT-EXTENSION "txt"
      488         UPDATE glog
      489         .
      490       if not glog then  return.
      491       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      492       if p-is-stream then
      493       do:
      494         if p-is-append then
      495         do:
      496           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      497         end.
      498         else
      499         do:
      500           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      501         end.
      502       end.
      503       else
      504       do:
      505         if p-is-append then
      506         do:
      507           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      508         end.
      509         else
      510         do:
      511           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      512         end.
      513       end.
      514       p-process = yes.
      515     end.
      516   end procedure.
      517   procedure prn-lib-get-report-name :
      518     define input parameter parParentProc  as widget-handle no-undo.
      519     define output parameter p-report-name as character no-undo .
      520     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      521   end procedure.
      522   procedure prn-lib-reportviewer-report-name :
      523     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      524     define input parameter p-report-name-html as character no-undo .
      525     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      526   end procedure.
      527   procedure prn-lib-reportviewer :
      528     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      529     define input parameter p-report-name-html as character no-undo .
      530     define input parameter p-param        as character no-undo .
      531     define variable v-excel           as character no-undo init 'TRUE' .
      532     define variable v-value-character as character no-undo .
      533     define variable v-value-integer   as character no-undo .
      534     define variable v-value-date      as date      no-undo .
      535     define variable v-value-decimal   as decimal   no-undo .
      536     define variable rep-excel         as logical   no-undo .
      537     define variable excel-string      as character no-undo .
      538     define variable v-param-type      as character no-undo .
      539     define variable v-tth             as handle    no-undo .
      540     run adm/shattri.p (
      541       input "get":U
      542       ,input  ""
      543       ,input  0
      544       ,input  'report-glob':U
      545       ,input  'rep-excel':U
      546       ,output v-value-character
      547       ,output v-value-date
      548       ,output v-value-decimal
      549       ,output v-value-integer
      550       ,output rep-excel
      551       ,output v-param-type
      552       ,INPUT-OUTPUT table-handle v-tth
      553       )  .
      554     if rep-excel then v-excel = "TRUE" .
      555     else v-excel = "FALSE" .
      556     if p-param eq ""
      557     then
      558        p-param = "EXCEL:" + v-excel.
      559     else
      560        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      561     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      562   end procedure.
      563   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      564   procedure cur-time :
      565      define output parameter p-today as date      no-undo .
      566      define output parameter p-time  as integer   no-undo .
      567     do
      568     on error undo, return error
      569     :
      570       define variable v-date1 as date      no-undo .
      571       define variable v-date2 as date      no-undo .
      572       define variable v-time  as integer   no-undo .
      573       assign
      574         v-date1 = today
      575         v-time  = time
      576         v-date2 = today
      577       .
      578       if v-date1 <> v-date2
      579       then do:
      580         assign
      581           v-date1 = today
      582           v-time  = v-time
      583         .
      584       end.
      585       assign
      586         p-today = v-date1
      587         p-time  = v-time
      588       .
      589     end.
      590   end.
      591   function cur-time-date returns character
      592   :
      593     return string(today, '99/99/9999':U) .
      594   end.
      595   function cur-time-mjd returns decimal
      596   :
      597     define variable v-date as date      no-undo .
      598     define variable v-time as integer   no-undo .
      599     run cur-time in this-procedure
      600       (output v-date
      601       ,output v-time
      602       ) .
      603     return integer(v-date) - 2400002 + (v-time / 86400) .
      604   end.
      605   function cur-time-get-ending-index returns integer
      606   (input p-number as integer
      607   )
      608   :
      609     if p-number < 0
      610     or p-number = ?
      611     then do:
      612       return 1 .
      613     end.
      614     define variable v-rest as integer   no-undo .
      615     assign
      616       p-number = p-number modulo 100
      617     .
      618     if p-number < 20
      619     then do:
      620       assign
      621         v-rest = p-number
      622       .
      623     end.
      624     else do:
      625       assign
      626         v-rest = p-number modulo 10
      627       .
      628     end.
      629     case v-rest :
      630       when 1
      631       then do:
      632         return 2 .
      633       end.
      634       when 2 or
      635       when 3 or
      636       when 4
      637       then do:
      638         return 3 .
      639       end.
      640       otherwise do:
      641         return 1 .
      642       end.
      643     end case .
      644   end.
      645   procedure cur-time-mjd-to-date :
      646      define input  parameter i-mjd-diff as decimal no-undo.
      647      define output parameter o-Date     as date    no-undo.
      648      define output parameter o-Time     as integer no-undo.
      649      define variable v-day-number as integer   no-undo .
      650      if    i-mjd-diff < 0
      651         or i-mjd-diff = ?
      652      then do:
      653         return "?" .
      654      end.
      655      assign
      656         v-day-number = truncate(i-mjd-diff,0).
      657         o-Date = date(v-day-number + 2400002).
      658         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      659     .
      660   end.
      661   function cur-time-mjd-to-string returns character
      662   (input p-mjd-diff as decimal
      663   )
      664   :
      665     define variable v-day-number as integer   no-undo .
      666     define variable v-seconds    as integer   no-undo .
      667     define variable v-hour       as integer   no-undo .
      668     define variable v-min        as integer   no-undo .
      669     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      670     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      671     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      672     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      673     if p-mjd-diff < 0
      674     or p-mjd-diff = ?
      675     then do:
      676       return "?" .
      677     end.
      678     assign
      679       v-day-number = integer(truncate(p-mjd-diff,0))
      680       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      681     .
      682     if v-seconds > 86400
      683     then do:
      684       assign
      685         v-seconds = 86400 - 1
      686       .
      687     end.
      688     if v-seconds < 0
      689     then do:
      690       assign
      691         v-seconds = 0
      692       .
      693     end.
      694     assign
      695       v-hour = truncate(v-seconds / 3600, 0)
      696     .
      697     assign
      698       v-seconds = v-seconds modulo 3600
      699     .
      700     assign
      701       v-min = truncate(v-seconds / 60, 0)
      702     .
      703     assign
      704       v-seconds = v-seconds modulo 60
      705     .
      706     return
      707         (if v-day-number <> 0
      708           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      709           else ""
      710         )
      711       + (if v-day-number <> 0 or v-hour <> 0
      712           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      713           else ""
      714         )
      715       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      716           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      717           else ""
      718         )
      719       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      720       .
      721   end.
      722   function cur-time-string returns character
      723   :
      724     define variable v-date as date      no-undo .
      725     define variable v-time as integer   no-undo .
      726     run cur-time in this-procedure
      727       (output v-date
      728       ,output v-time
      729       ) .
      730     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      731   end.
      732   function cur-time-string-sec returns character
      733   :
      734     define variable v-date as date      no-undo .
      735     define variable v-time as integer   no-undo .
      736     run cur-time in this-procedure
      737       (output v-date
      738       ,output v-time
      739       ) .
      740     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      741   end.
      742   function cur-time-custom  returns character
      743   (input p-prefix as character
      744   ,input p-date-format as character
      745   ,input p-delimiter as character
      746   ,input p-time-format as character
      747   ,input p-suffix as character
      748   )
      749   :
      750     define variable v-date as date      no-undo .
      751     define variable v-time as integer   no-undo .
      752     run cur-time in this-procedure
      753       (output v-date
      754       ,output v-time
      755       ) .
      756     return
      757       p-prefix
      758       + string(v-date, p-date-format)
      759       + p-delimiter
      760       + string(v-time, p-time-format)
      761       + p-suffix
      762       .
      763   end.
      764   function cur-time-print  returns character
      765   :
      766     define variable v-date as date      no-undo .
      767     define variable v-time as integer   no-undo .
      768     run cur-time in this-procedure
      769       (output v-date
      770       ,output v-time
      771       ) .
      772     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      773   end.
      774   function cur-time-datetime returns datetime
      775   :
      776     define variable v-char as character no-undo .
      777     define variable v-datetime as datetime no-undo .
      778     v-char = cur-time-string().
      779     v-datetime = datetime(v-char).
      780     return  v-datetime.
      781   end.
      782   function cur-time-string-msec returns character
      783   :
      784     define variable v-date as datetime  no-undo .
      785     v-date = now.
      786     return string(v-date) .
      787   end.
      788   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   FUNCTION mark-string RETURNS CHARACTER
      790     ( input p-recid as recid, input mark-list as character  ) :
      791     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      792   END FUNCTION.
      793   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   function usrfulnf returns character ( input p-user-id as character):
      795   define variable v-user-name as character no-undo .
      796   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      798     (input  p-user-id
      799     ,output v-user-name
      800     ) no-error .
      801   if error-status:error
      802   or v-user-name = ""
      803   then do:
      804     return p-user-id.
      805   end.
      806   else do:
      807     return v-user-name.
      808   end.
      809   end function.
      810   define variable V-RID-LIST as character no-undo .
      811   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      812   define variable sort-column-name as character no-undo .
      813   define variable v-db-num LIKE ub.db.db-num no-undo.
      814   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      815   define  temp-table temp-changes no-undo
      816   field f_name as character
      817   field l_name as character
      818   field v_old as character
      819   field v_new as character
      820   field t_name as character
      821   field num_ as integer
      822   field uniq-key-rec as character
      823   field action as integer
      824   field fNotChange as logical
      825   index pi is unique primary
      826   num_
      827   t_name
      828   f_name
      829   index
      830   Chan
      831   fnotChange
      832   t_name
      833   f_name
      834   index imain uniq-key-rec
      835   .
      836   FUNCTION get-all-fields returns character (p-file-name as character ):
      837   define variable v-dop as character no-undo .
      838     find first _file no-lock where _file._file-name = p-file-name no-error .
      839     if not available _file then return "":U.
      840     for each _field no-lock where
      841              _field._file-recid = recid(_file) :
      842       assign
      843       v-dop = v-dop + _field._field-name + chr(44)
      844       .
      845     end.
      846     return trim(v-dop).
      847   END FUNCTION.
      848   PROCEDURE proc-full-temp-changes :
      849     define input  parameter p-hst-handle as handle    no-undo .
      850     define input  parameter p-main-table as character no-undo .
      851     define input  parameter p-field-list as character no-undo .
      852     define input  parameter p-label-form as character no-undo .
      853     define variable h-new-buf         as handle    no-undo .
      854     define variable h-main-buf        as handle    no-undo .
      855     define variable h-for-comp        as handle    no-undo .
      856     define variable v-inform          as character no-undo .
      857     define variable v-ind             as integer   no-undo .
      858     define variable v-idx-field-qnty  as integer   no-undo .
      859     define variable v-num-entries     as integer   no-undo .
      860     define variable fh                as handle    no-undo .
      861     define variable fh-main           as handle    no-undo .
      862     define variable fh-old            as handle    no-undo .
      863     define variable fh-new            as handle    no-undo .
      864     define variable v-field-name      as character no-undo .
      865     define variable v-field-lvl       as character no-undo .
      866     define variable v-field-form      as character no-undo .
      867     define variable v-search-exp      as character no-undo .
      868     define variable v-srch-main       as character no-undo .
      869     define variable v-word-link       as character no-undo .
      870     define variable v-av-chip-num     as logical   no-undo .
      871     define variable v-main-pi-fld-lst as character no-undo .
      872     define variable v-main-fld-lst    as character no-undo .
      873     define variable v-delim-list      as character no-undo .
      874     define variable v-label           as character no-undo .
      875     define variable v-old-value       as character no-undo case-sensitive.
      876     define variable v-new-value       as character no-undo case-sensitive.
      877     define variable v-chg-fields as character no-undo.
      878     for each temp-changes:
      879       delete temp-changes.
      880     end.
      881     if not p-hst-handle:available then do:
      882       return .
      883     end.
      884     create buffer h-new-buf  for table p-hst-handle .
      885     create buffer h-main-buf for table p-main-table .
      886     assign
      887       v-inform = h-main-buf:index-information(1)
      888       v-ind    = 2
      889     .
      890     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      891     on error undo, return error
      892     :
      893       assign
      894         v-inform = h-main-buf:index-information( v-ind )
      895         v-ind    = v-ind + 1
      896       .
      897     end.
      898     if v-inform = ?
      899       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      900       or entry( 3, v-inform, ",":U ) <> "1":U
      901     then do:
      902       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      903     end.
      904     assign
      905       v-idx-field-qnty = num-entries( v-inform ) - 4
      906     .
      907     if v-idx-field-qnty < 2 then do:
      908       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      909     end.
      910     assign
      911       v-srch-main   = "where":U
      912       v-word-link   = "":U
      913       v-av-chip-num = false
      914       v-delim-list  = "":U
      915     .
      916     do v-ind = 1 to v-idx-field-qnty by 2
      917     on error undo, return error
      918     :
      919       assign
      920         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      921         fh                = p-hst-handle:buffer-field( v-field-name )
      922         fh-main           = h-main-buf:buffer-field( v-field-name )
      923         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      924         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      925       .
      926       if fh:data-type ="character":U then do:
      927         assign
      928           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      929         .
      930       end.
      931       else do:
      932         assign
      933           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      934         .
      935       end.
      936       if v-delim-list = "":U then do:
      937         assign
      938           v-delim-list = ",":U
      939         .
      940       end.
      941       if v-word-link = "":U then do:
      942         assign
      943           v-word-link = "and":U
      944         .
      945       end.
      946     end.
      947     assign
      948       v-delim-list  = "":U
      949     .
      950     do v-ind = 1 to h-main-buf:num-fields
      951     on error undo, return error
      952     :
      953       assign
      954         fh-main      = h-main-buf:buffer-field( v-ind )
      955         v-field-name = fh-main:name
      956       .
      957         assign
      958           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      959         .
      960         if v-delim-list = "":U then do:
      961           assign
      962             v-delim-list = ",":U
      963           .
      964         end.
      965     end.
      966     assign
      967       v-inform = p-hst-handle:index-information(1)
      968       v-ind    = 2
      969     .
      970     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      971     on error undo, return error
      972     :
      973       assign
      974         v-inform = p-hst-handle:index-information( v-ind )
      975         v-ind    = v-ind + 1
      976       .
      977     end.
      978     if v-inform = ?
      979       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      980       or entry( 3, v-inform, ",":U ) <> "1":U
      981     then do:
      982       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      983     end.
      984     assign
      985       v-idx-field-qnty = num-entries( v-inform ) - 4
      986     .
      987     if v-idx-field-qnty < 2 then do:
      988       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      989     end.
      990     assign
      991       v-search-exp  = "where":U
      992       v-word-link   = "":U
      993       v-av-chip-num = false
      994     .
      995     do v-ind = 1 to v-idx-field-qnty by 2
      996     on error undo, return error
      997     :
      998       assign
      999         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1000         fh           = p-hst-handle:buffer-field( v-field-name )
     1001         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1002       .
     1003       if v-field-name = "chip-num":U then do:
     1004         assign
     1005           v-search-exp  = substitute( "&1 >", v-search-exp )
     1006           v-av-chip-num = true
     1007         .
     1008       end.
     1009       else do:
     1010         assign
     1011           v-search-exp = substitute( "&1 =", v-search-exp )
     1012         .
     1013       end.
     1014       if fh:data-type ="character":U then do:
     1015         assign
     1016           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1017         .
     1018       end.
     1019       else do:
     1020         assign
     1021           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1022         .
     1023       end.
     1024       if v-word-link = "":U then do:
     1025         assign
     1026           v-word-link = "and":U
     1027         .
     1028       end.
     1029     end.
     1030     if v-av-chip-num = false then do:
     1031       message
     1032         vss-workfile vss-revision vss-description skip
     1033         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1034         "Использование данной процедуры невозможно!" skip
     1035         view-as alert-box error .
     1036       return error .
     1037     end.
     1038     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1039     if not h-new-buf:available then do:
     1040       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1041       if not h-main-buf:available then do:
     1042         assign
     1043           h-for-comp = ?
     1044         .
     1045       end.
     1046       else do:
     1047         assign
     1048           h-for-comp = h-main-buf
     1049         .
     1050       end.
     1051     end.
     1052     else do:
     1053       assign
     1054         h-for-comp = h-new-buf
     1055       .
     1056     end.
     1057     assign
     1058       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1059     .
     1060     do v-ind = 1 to v-num-entries
     1061     on error undo, return error return-value
     1062     :
     1063       assign
     1064         v-field-name = entry( v-ind, v-main-fld-lst )
     1065         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1066         v-old-value  = fh-old:buffer-value()
     1067         v-label      = trim( fh-old:label )
     1068       .
     1069       if ( trim( p-field-list ) <> "":U
     1070            and lookup( v-field-name, p-field-list ) > 0
     1071          )
     1072          or trim( p-field-list ) = "":U
     1073       then do:
     1074         if h-for-comp <> ? then do:
     1075           assign
     1076             fh-new      = h-for-comp:buffer-field( v-field-name )
     1077             v-new-value = fh-new:buffer-value()
     1078           .
     1079         end.
     1080         else do:
     1081           assign
     1082             v-new-value = "":U
     1083           .
     1084         end.
     1085         if v-old-value <> v-new-value
     1086         then do:
     1087           create temp-changes.
     1088           assign
     1089             temp-changes.t_name = p-main-table
     1090             temp-changes.f_name = v-field-name
     1091             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1092             temp-changes.v_old  = trim( v-old-value )
     1093             temp-changes.v_new  = trim( v-new-value )
     1094             temp-changes.num_   = 0
     1095             temp-changes.fNotChange = v-old-value eq v-new-value
     1096           .
     1097         end.
     1098       end.
     1099     end.
     1100     assign
     1101       v-num-entries = num-entries( p-label-form, chr(8) )
     1102     .
     1103     do v-ind = 1 to v-num-entries
     1104     on error undo, return error return-value
     1105     :
     1106       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1107         assign
     1108           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1109           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1110           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1111         .
     1112         find first temp-changes
     1113           where temp-changes.f_name = v-field-name
     1114           no-error .
     1115         if available temp-changes then do:
     1116           if trim( v-field-lvl ) <> "":U then do:
     1117             assign
     1118               temp-changes.l_name = v-field-lvl
     1119             .
     1120           end.
     1121           if trim( v-field-form ) <> "":U then do:
     1122             assign
     1123               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1124             .
     1125             if h-for-comp <> ? then do:
     1126               assign
     1127                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1128               .
     1129             end.
     1130           end.
     1131         end.
     1132       end.
     1133       else do:
     1134         message
     1135           vss-workfile vss-revision vss-description skip
     1136           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1137           substitute( "список для поля '&1': '&2'"
     1138                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1139                       ,entry( v-ind, p-label-form, chr(8) )
     1140                     ) skip
     1141           substitute( "полный список: &2", p-label-form ) skip
     1142           view-as alert-box error .
     1143       end.
     1144     end.
     1145     delete object h-new-buf .
     1146     delete object h-main-buf .
     1147   END PROCEDURE.
     1148   DEFINE BUTTON B-Help
     1149        LABEL "Помо&щь"
     1150        SIZE 3 BY 1
     1151        BGCOLOR 8 .
     1152   DEFINE BUTTON B-lookup
     1153        LABEL "&Просмотр"
     1154        SIZE 10 BY 1.
     1155   DEFINE BUTTON B-mark
     1156        LABEL "&*"
     1157        SIZE 3 BY 1.
     1158   DEFINE BUTTON b-quit AUTO-END-KEY
     1159        LABEL "&Выход"
     1160        SIZE 10 BY 1
     1161        BGCOLOR 8 .
     1162   DEFINE BUTTON B-sel AUTO-GO
     1163        LABEL "Вы&бор"
     1164        SIZE 10 BY 1.
     1165   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1166         VIEW-AS TEXT
     1167        SIZE 6 BY 1
     1168        FGCOLOR 4  NO-UNDO.
     1169   DEFINE QUERY br-ccur FOR
     1170         X_c-currency SCROLLING.
     1171   DEFINE QUERY BR-changes FOR
     1172         temp-changes SCROLLING.
     1173   DEFINE BROWSE br-ccur
     1174     QUERY br-ccur NO-LOCK DISPLAY
     1175         mark-string(recid(X_c-currency), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1176         usrfulnf(X_c-currency.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1177         X_c-currency.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1178         string(X_c-currency.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1179         X_c-currency.curr-abbr FORMAT "X(3)":U
     1180         X_c-currency.curr-name FORMAT "X(40)":U
     1181         X_c-currency.curr-code COLUMN-LABEL "Код валюты" FORMAT ">>9":U
     1182       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25.
     1183   DEFINE BROWSE BR-changes
     1184     QUERY BR-changes DISPLAY
     1185         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1186   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1187   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1188       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1189   DEFINE FRAME Dialog-Frame
     1190        b-quit AT ROW 1 COL 1
     1191        B-mark AT ROW 1 COL 11
     1192        B-sel AT ROW 1 COL 21
     1193        B-lookup AT ROW 1 COL 61
     1194        B-Help AT ROW 1 COL 95
     1195        br-ccur AT ROW 3 COL 1
     1196        BR-changes AT ROW 13 COL 1
     1197        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1198        SPACE(78.62) SKIP(20.04)
     1199       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1200            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1201            TITLE "История валюты"
     1202            CANCEL-BUTTON b-quit.
     1203   ASSIGN
     1204          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1205          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1206   ASSIGN
     1207          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1208   ON GO OF FRAME Dialog-Frame
     1209   DO:
     1210     p-rid-list = v-rid-list.
     1211   END.
     1212   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1213   DO:
     1214     APPLY "END-ERROR":U TO SELF.
     1215   END.
     1216   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1217   DO:
     1218     define variable loc#log as logical no-undo .
     1219     if available X_c-currency then do:
     1220   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1221   define variable v-str-recid10 as character no-undo .
     1222   define variable v-num-entry10 as integer   no-undo .
     1223   assign
     1224     v-str-recid10 = trim( string( recid( X_c-currency ) , "->>>>>>>>>>>9":U ) )
     1225     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
     1226   .
     1227   if v-num-entry10 > 0 then do:
     1228     assign
     1229       entry( v-num-entry10, v-rid-list ) = "":U
     1230       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1231     .
     1232   end.
     1233   else do:
     1234     assign
     1235       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1236     .
     1237   end.
     1238       loc#log = br-ccur:refresh() .
     1239       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1240           loc#log = br-ccur:select-next-row ().
     1241           apply "VALUE-CHANGED" to br-ccur in frame Dialog-Frame.
     1242       end.
     1243       if num-entries( v-rid-list ) = 0
     1244       then
     1245           hide mark-num in frame Dialog-Frame.
     1246       else
     1247           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1248     end.
     1249     apply "entry" to br-ccur in frame Dialog-Frame.
     1250   END.
     1251   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1252   DO:
     1253       if ( available X_c-currency ) then do:
     1254       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1255       then
     1256       v-rid-list = string( recid( X_c-currency ) ) .
     1257     end.
     1258   END.
     1259   ON RETURN OF br-ccur IN FRAME Dialog-Frame
     1260   or MOUSE-SELECT-DBLCLICK OF br-ccur IN FRAME Dialog-Frame
     1261       DO:
     1262       run proc-br-ccur no-error.
     1263     if error-status:error then return no-apply.
     1264   END.
     1265   ON VALUE-CHANGED OF br-ccur IN FRAME Dialog-Frame
     1266   DO:
     1267     run proc-view-changes in this-procedure no-error.
     1268   END.
     1269   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1270   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1271   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1272   on help of frame Dialog-Frame
     1273   do:
     1274     run gbl/app_help.p
     1275       (input this-procedure :file-name
     1276       ,input ''
     1277       ,input ?
     1278       ) no-error.
     1279     if error-status :error then do:
     1280       message
     1281         "Ошибка при вызове помощи"
     1282         error-status :get-message(1)
     1283         view-as alert-box .
     1284     end.
     1285   end.
     1286   run minbtn-set in this-procedure .
     1287   on choose of b-help in frame Dialog-Frame
     1288   do:
     1289     apply "help":u to frame Dialog-Frame .
     1290   end.
     1291   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1292   procedure minbtn-set :
     1293       do
     1294           on error undo, return error return-value
     1295           :
     1296           define variable ii              as integer       no-undo .
     1297           define variable fh              as widget-handle no-undo .
     1298           define variable hh              as widget-handle no-undo .
     1299           define variable v-h             as handle        extent 4 no-undo .
     1300           define variable v-name-button   as character     no-undo .
     1301           define variable v-help-old-x    as decimal       no-undo .
     1302           define variable v-help-old-y    as decimal       no-undo .
     1303           define variable v-help-old-size as decimal       no-undo .
     1304           define variable v-frame-width   as decimal       no-undo .
     1305           define variable jj              as integer       no-undo .
     1306           do
     1307               on error undo, return error
     1308               :
     1309               assign
     1310                   v-frame-width = frame Dialog-Frame:width - 0.3
     1311                   fh            = frame Dialog-Frame:first-child
     1312                   hh            = fh:first-child
     1313                   ii            = 1
     1314                   .
     1315               do while valid-handle(hh):
     1316                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1317                   do:
     1318                       case lc(hh:name) :
     1319                           when "b-help" then
     1320                               do:
     1321                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1322                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1323                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1324                                   hh:TOOLTIP = "Помощь" .
     1325                                   v-help-old-x = hh:column .
     1326                                   v-help-old-y = hh:row    .
     1327                                   v-help-old-size = hh:width .
     1328                                   hh:width-chars = 2.5 .
     1329                               end.
     1330                           when "b-print" then
     1331                               do:
     1332                                   hh:load-image("cmp/b-print.bmp":u) .
     1333                                   hh:TOOLTIP = "Печать" .
     1334                                   v-h[ii] = hh:handle .
     1335                                   ii = ii + 1 .
     1336                                   hh:width-chars = 3 .
     1337                               end.
     1338                           when "b-history" or
     1339                           when "b-hist" then
     1340                               do:
     1341                                   hh:load-image("cmp/b-hist.bmp":u) .
     1342                                   hh:TOOLTIP = "История" .
     1343                                   v-h[ii] = hh:handle .
     1344                                   ii = ii + 1 .
     1345                                   hh:width-chars = 3 .
     1346                               end.
     1347                           when "b-sch" then
     1348                               do:
     1349                                   hh:load-image("cmp/b-sch.bmp":u) .
     1350                                   hh:TOOLTIP = "Установка Фильтра" .
     1351                                   v-h[ii] = hh:handle .
     1352                                   ii = ii + 1 .
     1353                                   hh:width-chars = 3 .
     1354                               end.
     1355                           when "b-hist-user" then
     1356                               do:
     1357                                   hh:load-image("cmp/b-hist.bmp":u) .
     1358                                   hh:TOOLTIP = "История пользователя" .
     1359                                   ii = ii + 1 .
     1360                               end.
     1361                       end case.
     1362                   end.
     1363                   hh = hh:next-sibling.
     1364               end.
     1365               b-help:column = v-frame-width - b-help:width-chars.
     1366               jj = 0.
     1367               repeat ii = 4 to 1 by -1 :
     1368                   if valid-handle (v-h[ii] ) then
     1369                   do:
     1370                       jj  = jj + 1 .
     1371                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1372                       v-h[ii]:row    = v-help-old-y .
     1373                   end.
     1374               end.
     1375           end.
     1376       end.
     1377   end procedure.
     1378   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1379   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1380   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1381   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1382   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1383   define variable v-diasize-current-frame-height as decimal   no-undo .
     1384   define variable v-diasize-change-size          as logical   no-undo .
     1385   define variable v-diasize-resize-button        as handle    no-undo .
     1386   define variable v-diasize-wndmax               as logical   no-undo .
     1387   define variable v-diasize-wndstore             as logical   no-undo .
     1388   define variable v-diasize-proc-name            as character no-undo .
     1389   define variable v-diasize-browse-handle        as handle    no-undo .
     1390   define variable v-diasize-browse-number        as integer   no-undo .
     1391   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1392   define temp-table temp-diasize-handle no-undo
     1393     field handle-value  as handle
     1394     field save-position as decimal
     1395     index xpk is primary unique handle-value
     1396     .
     1397   define temp-table temp-browse-handle no-undo
     1398     field browse-type   as character
     1399     field browse-number as integer
     1400     field browse-handle as handle
     1401     field original-size as decimal
     1402     index xpk is primary unique browse-type browse-number
     1403     index xie browse-type browse-handle
     1404   .
     1405   procedure diasize_change-height :
     1406     define input  parameter p-change-value  as decimal   no-undo .
     1407     define input  parameter p-move-resize   as logical   no-undo .
     1408     define variable v-field-group-handle    as handle    no-undo .
     1409     define variable v-object-handle         as handle    no-undo .
     1410     define variable v-frame-height          as decimal   no-undo .
     1411     define variable v-frame-virtual-height  as decimal   no-undo .
     1412     define variable v-browse-height         as decimal   no-undo .
     1413     define variable v-window-height         as decimal   no-undo .
     1414     define variable v-window-virtual-height as decimal   no-undo .
     1415     define variable v-change-sign           as integer   no-undo .
     1416     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1417     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1418     if p-change-value > 0
     1419     then do:
     1420       if frame Dialog-Frame :height + p-change-value
     1421           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1422       then do:
     1423         assign
     1424           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1425                           - (frame Dialog-Frame :height-chars)
     1426         .
     1427         if p-change-value <= 0
     1428         then do:
     1429           run diasize_position-resize-button in this-procedure .
     1430           return .
     1431         end.
     1432       end.
     1433     end.
     1434     if p-change-value < 0
     1435     then do:
     1436       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1437       then do:
     1438         assign
     1439           p-change-value = v-diasize-orig-frame-height
     1440                          - (frame Dialog-Frame :height-chars)
     1441         .
     1442         if p-change-value >= 0
     1443         then do:
     1444           run diasize_position-resize-button in this-procedure .
     1445           return .
     1446         end.
     1447       end.
     1448     end.
     1449     if p-change-value >= 0
     1450     then do:
     1451       assign
     1452         v-change-sign = 1
     1453       .
     1454     end.
     1455     else do:
     1456       assign
     1457         v-change-sign = -1
     1458       .
     1459     end.
     1460     assign
     1461       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1462     .
     1463     if p-change-value = 0
     1464     then do:
     1465       run diasize_position-resize-button in this-procedure .
     1466       return .
     1467     end.
     1468     move_block:
     1469     do
     1470     on error undo move_block, retry move_block
     1471     :
     1472       if retry
     1473       then do:
     1474         do
     1475         on error undo move_block, leave move_block
     1476         :
     1477           if p-change-value > 0
     1478           then do:
     1479             for each buf_temp-diasize-handle
     1480             on error undo, next
     1481             :
     1482               assign
     1483                 v-object-handle = buf_temp-diasize-handle.handle-value
     1484               .
     1485               if v-object-handle <> v-diasize-resize-button
     1486               then do:
     1487                 assign
     1488                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1489                 .
     1490               end.
     1491             end.
     1492             assign
     1493               v-diasize-browse-handle :height = v-browse-height
     1494             .
     1495             for each buf_temp-browse-handle
     1496               where buf_temp-browse-handle.browse-type = 'height':u
     1497             on error undo, next
     1498             :
     1499               assign
     1500                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1501               .
     1502             end.
     1503             assign
     1504               frame Dialog-Frame :height = v-frame-height
     1505             .
     1506             if frame Dialog-Frame :scrollable = true
     1507             then do:
     1508               assign
     1509                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1510               .
     1511             end.
     1512             run diasize_position-resize-button in this-procedure .
     1513           end.
     1514           else do:
     1515             if frame Dialog-Frame :scrollable = true
     1516             then do:
     1517               assign
     1518                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1519               .
     1520             end.
     1521             assign
     1522               frame Dialog-Frame :height = v-frame-height
     1523             .
     1524             assign
     1525               v-diasize-browse-handle :height = v-browse-height
     1526             .
     1527             for each buf_temp-browse-handle
     1528               where buf_temp-browse-handle.browse-type = 'height':u
     1529             on error undo, next
     1530             :
     1531               assign
     1532                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1533               .
     1534             end.
     1535             for each buf_temp-diasize-handle
     1536             on error undo, next
     1537             :
     1538               assign
     1539                 v-object-handle = buf_temp-diasize-handle.handle-value
     1540               .
     1541               if v-object-handle <> v-diasize-resize-button
     1542               then do:
     1543                 assign
     1544                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1545                 .
     1546               end.
     1547             end.
     1548             run diasize_position-resize-button in this-procedure .
     1549           end.
     1550           assign
     1551             v-diasize-change-size = false
     1552           .
     1553           leave move_block .
     1554         end.
     1555       end.
     1556       assign
     1557         v-diasize-need-full-display = true
     1558       .
     1559       if v-diasize-change-size = false
     1560       then do:
     1561         assign
     1562           v-diasize-change-size = true
     1563         .
     1564       end.
     1565       else do:
     1566         return .
     1567       end.
     1568       assign
     1569         v-frame-height = frame Dialog-Frame :height
     1570         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1571         v-browse-height = v-diasize-browse-handle :height
     1572       .
     1573       for each buf_temp-browse-handle
     1574         where buf_temp-browse-handle.browse-type = 'height':u
     1575       :
     1576         assign
     1577           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1578         .
     1579       end.
     1580       for each buf_temp-diasize-handle
     1581       :
     1582         delete buf_temp-diasize-handle .
     1583       end.
     1584       assign
     1585         v-field-group-handle = frame Dialog-Frame :first-child
     1586       .
     1587       do while valid-handle(v-field-group-handle)
     1588       :
     1589         assign
     1590           v-object-handle = v-field-group-handle :first-child
     1591         .
     1592         do while valid-handle(v-object-handle)
     1593         :
     1594           if  v-object-handle <> v-diasize-browse-handle :handle
     1595           and can-query(v-object-handle, "row")
     1596           and can-query(v-object-handle, "height")
     1597           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1598           then do:
     1599             find first buf_temp-browse-handle
     1600               where buf_temp-browse-handle.browse-type   = 'height':u
     1601                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1602               no-error .
     1603             if available buf_temp-browse-handle
     1604             then do:
     1605             end.
     1606             else do:
     1607               create buf_temp-diasize-handle .
     1608               assign
     1609                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1610                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1611               .
     1612             end.
     1613           end.
     1614           assign
     1615             v-object-handle = v-object-handle :next-sibling
     1616           .
     1617         end.
     1618         assign
     1619           v-field-group-handle = v-field-group-handle :next-sibling
     1620         .
     1621       end.
     1622       do with frame Dialog-Frame
     1623       :
     1624         hide v-diasize-resize-button .
     1625         assign
     1626           v-diasize-resize-button :row    = 1
     1627           v-diasize-resize-button :column = 1
     1628         .
     1629       end.
     1630       if p-change-value > 0
     1631       then do:
     1632         if frame Dialog-Frame :scrollable = true
     1633         then do:
     1634           assign
     1635             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1636             no-error .
     1637           if error-status :error
     1638           or error-status :get-message(1) <> ""
     1639           then do:
     1640             undo move_block, retry move_block .
     1641           end.
     1642         end.
     1643         assign
     1644           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1645           no-error .
     1646         if error-status :error
     1647         or error-status :get-message(1) <> ""
     1648         then do:
     1649           undo move_block, retry move_block .
     1650         end.
     1651         assign
     1652           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1653           no-error .
     1654         if error-status :error
     1655         or error-status :get-message(1) <> ""
     1656         then do:
     1657           undo move_block, retry move_block .
     1658         end.
     1659         for each buf_temp-browse-handle
     1660           where buf_temp-browse-handle.browse-type = 'height':u
     1661         on error undo move_block, retry move_block
     1662         :
     1663           assign
     1664             buf_temp-browse-handle.browse-handle :height
     1665               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1666             no-error .
     1667           if error-status :error
     1668           or error-status :get-message(1) <> ""
     1669           then do:
     1670             undo move_block, retry move_block .
     1671           end.
     1672         end.
     1673         for each buf_temp-diasize-handle
     1674         on error undo move_block, retry move_block
     1675         :
     1676           assign
     1677             v-object-handle = buf_temp-diasize-handle.handle-value
     1678           .
     1679           if v-object-handle <> v-diasize-resize-button
     1680           then do:
     1681             assign
     1682               v-object-handle :row = v-object-handle :row + p-change-value
     1683               no-error .
     1684             if error-status :error
     1685             or error-status :get-message(1) <> ""
     1686             then do:
     1687               undo move_block, retry move_block .
     1688             end.
     1689           end.
     1690         end.
     1691       end.
     1692       else do:
     1693         for each buf_temp-diasize-handle
     1694         on error undo move_block, retry move_block
     1695         :
     1696           assign
     1697             v-object-handle = buf_temp-diasize-handle.handle-value
     1698           .
     1699           if v-object-handle <> v-diasize-resize-button
     1700           then do:
     1701             assign
     1702               v-object-handle :row = v-object-handle :row + p-change-value
     1703               no-error .
     1704             if error-status :error
     1705             or error-status :get-message(1) <> ""
     1706             then do:
     1707               undo move_block, retry move_block .
     1708             end.
     1709           end.
     1710         end.
     1711         assign
     1712           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1713           no-error .
     1714         if error-status :error
     1715         or error-status :get-message(1) <> ""
     1716         then do:
     1717           undo move_block, retry move_block .
     1718         end.
     1719         for each buf_temp-browse-handle
     1720           where buf_temp-browse-handle.browse-type = 'height':u
     1721         on error undo move_block, retry move_block
     1722         :
     1723           assign
     1724             buf_temp-browse-handle.browse-handle :height
     1725               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1726             no-error .
     1727           if error-status :error
     1728           or error-status :get-message(1) <> ""
     1729           then do:
     1730             undo move_block, retry move_block .
     1731           end.
     1732         end.
     1733         assign
     1734           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1735           no-error .
     1736         if error-status :error
     1737         or error-status :get-message(1) <> ""
     1738         then do:
     1739           undo move_block, retry move_block .
     1740         end.
     1741         if frame Dialog-Frame :scrollable = true
     1742         then do:
     1743           assign
     1744             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1745             no-error .
     1746           if error-status :error
     1747           or error-status :get-message(1) <> ""
     1748           then do:
     1749             undo move_block, retry move_block .
     1750           end.
     1751         end.
     1752       end.
     1753       if p-move-resize = true
     1754       then do:
     1755         run diasize_position-resize-button in this-procedure .
     1756       end.
     1757       if v-diasize-wndstore = true
     1758       then do:
     1759         if connected("ub") = true
     1760         then do:
     1761           define variable v-cntxt-db-num        as integer   no-undo .
     1762           define variable v-cntxt-userid        as character no-undo .
     1763           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1764                                             , OUTPUT v-cntxt-userid
     1765                                             ) .
     1766           run gbl/wndsizew.p
     1767             (input  v-cntxt-db-num
     1768             ,input  v-cntxt-userid
     1769             ,input  v-diasize-proc-name
     1770             ,input  'height':u
     1771             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1772             ) .
     1773         end.
     1774       end.
     1775     end.
     1776     assign
     1777       v-diasize-change-size = false
     1778     .
     1779   end procedure.
     1780   procedure diasize_set-height :
     1781     define input  parameter p-new-height  as decimal   no-undo .
     1782     define input  parameter p-move-resize as logical   no-undo .
     1783     do
     1784     on error undo, return error return-value
     1785     :
     1786       run diasize_change-height in this-procedure
     1787         (input  (p-new-height - frame Dialog-Frame :height)
     1788         ,input  p-move-resize
     1789         ) .
     1790     end.
     1791   end procedure.
     1792   procedure diasize_change-width :
     1793     define input  parameter p-change-value as decimal   no-undo .
     1794     define input  parameter p-move-resize  as logical   no-undo .
     1795     define variable v-field-group-handle   as handle    no-undo .
     1796     define variable v-object-handle        as handle    no-undo .
     1797     define variable v-frame-width          as decimal   no-undo .
     1798     define variable v-frame-virtual-width  as decimal   no-undo .
     1799     define variable v-browse-width         as decimal   no-undo .
     1800     define variable v-window-width         as decimal   no-undo .
     1801     define variable v-window-virtual-width as decimal   no-undo .
     1802     define variable v-change-sign          as integer   no-undo .
     1803     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1804     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1805     if p-change-value > 0
     1806     then do:
     1807       if frame Dialog-Frame :width + p-change-value >
     1808           session :width-chars
     1809       then do:
     1810         assign
     1811           p-change-value = session :width-chars - frame Dialog-Frame :width
     1812         .
     1813         if p-change-value <= 0
     1814         then do:
     1815           run diasize_position-resize-button in this-procedure .
     1816           return .
     1817         end.
     1818       end.
     1819     end.
     1820     if p-change-value < 0
     1821     then do:
     1822       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1823       then do:
     1824         assign
     1825           p-change-value = v-diasize-orig-frame-width
     1826                          - frame Dialog-Frame :width
     1827         .
     1828         if p-change-value >= 0
     1829         then do:
     1830           run diasize_position-resize-button in this-procedure .
     1831           return .
     1832         end.
     1833       end.
     1834     end.
     1835     if p-change-value >= 0
     1836     then do:
     1837       assign
     1838         v-change-sign = 1
     1839       .
     1840     end.
     1841     else do:
     1842       assign
     1843         v-change-sign = -1
     1844       .
     1845     end.
     1846     assign
     1847       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1848     .
     1849     if p-change-value = 0
     1850     then do:
     1851       run diasize_position-resize-button in this-procedure .
     1852       return .
     1853     end.
     1854     move_block:
     1855     do
     1856     on error undo move_block, leave move_block
     1857     :
     1858       if retry
     1859       then do:
     1860         do
     1861         on error undo move_block, leave move_block
     1862         :
     1863           if p-change-value > 0
     1864           then do:
     1865             for each buf_temp-diasize-handle
     1866             on error undo, next
     1867             :
     1868               assign
     1869                 v-object-handle = buf_temp-diasize-handle.handle-value
     1870               .
     1871               if v-object-handle <> v-diasize-resize-button
     1872               then do:
     1873                 assign
     1874                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1875                 .
     1876               end.
     1877             end.
     1878             assign
     1879               v-diasize-browse-handle :width = v-browse-width
     1880             .
     1881             for each buf_temp-browse-handle
     1882               where buf_temp-browse-handle.browse-type = 'width':u
     1883             on error undo, next
     1884             :
     1885               assign
     1886                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1887               .
     1888             end.
     1889             assign
     1890               frame Dialog-Frame :width = v-frame-width
     1891             .
     1892             if frame Dialog-Frame :scrollable = true
     1893             then do:
     1894               assign
     1895                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1896               .
     1897             end.
     1898             run diasize_position-resize-button in this-procedure .
     1899           end.
     1900           else do:
     1901             if frame Dialog-Frame :scrollable = true
     1902             then do:
     1903               assign
     1904                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1905               .
     1906             end.
     1907             assign
     1908               frame Dialog-Frame :width = v-frame-width
     1909             .
     1910             for each buf_temp-browse-handle
     1911               where buf_temp-browse-handle.browse-type = 'width':u
     1912             on error undo, next
     1913             :
     1914               assign
     1915                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1916               .
     1917             end.
     1918             assign
     1919               v-diasize-browse-handle :width = v-browse-width
     1920             .
     1921             for each buf_temp-diasize-handle
     1922             on error undo, next
     1923             :
     1924               assign
     1925                 v-object-handle = buf_temp-diasize-handle.handle-value
     1926               .
     1927               if v-object-handle <> v-diasize-resize-button
     1928               then do:
     1929                 assign
     1930                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1931                 .
     1932               end.
     1933             end.
     1934             run diasize_position-resize-button in this-procedure .
     1935           end.
     1936           assign
     1937             v-diasize-change-size = false
     1938           .
     1939           leave move_block .
     1940         end.
     1941       end.
     1942       assign
     1943         v-diasize-need-full-display = true
     1944       .
     1945       if v-diasize-change-size = false
     1946       then do:
     1947         assign
     1948           v-diasize-change-size = true
     1949         .
     1950       end.
     1951       else do:
     1952         return .
     1953       end.
     1954       assign
     1955         v-frame-width = frame Dialog-Frame :width
     1956         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1957         v-browse-width = v-diasize-browse-handle :width
     1958       .
     1959       for each buf_temp-browse-handle
     1960         where buf_temp-browse-handle.browse-type = 'width':u
     1961       :
     1962         assign
     1963           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1964         .
     1965       end.
     1966       for each buf_temp-diasize-handle
     1967       :
     1968         delete buf_temp-diasize-handle .
     1969       end.
     1970       assign
     1971         v-field-group-handle = frame Dialog-Frame :first-child
     1972       .
     1973       do while valid-handle(v-field-group-handle)
     1974       :
     1975         assign
     1976           v-object-handle = v-field-group-handle :first-child
     1977         .
     1978         do while valid-handle(v-object-handle)
     1979         :
     1980           if  v-object-handle <> v-diasize-browse-handle :handle
     1981           and v-object-handle <> v-diasize-resize-button
     1982           and can-query(v-object-handle, "row")
     1983           and can-query(v-object-handle, "height")
     1984           and ( v-object-handle :col + v-object-handle :width
     1985                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1986               )
     1987           then do:
     1988             find first buf_temp-browse-handle
     1989               where buf_temp-browse-handle.browse-type   = 'width':u
     1990                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1991               no-error .
     1992             if available buf_temp-browse-handle
     1993             then do:
     1994             end.
     1995             else do:
     1996               create buf_temp-diasize-handle .
     1997               assign
     1998                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1999                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2000               .
     2001             end.
     2002           end.
     2003           assign
     2004             v-object-handle = v-object-handle :next-sibling
     2005           .
     2006         end.
     2007         assign
     2008           v-field-group-handle = v-field-group-handle :next-sibling
     2009         .
     2010       end.
     2011       do with frame Dialog-Frame
     2012       :
     2013         hide v-diasize-resize-button .
     2014         v-diasize-resize-button :row = 1.
     2015         v-diasize-resize-button :column = 1.
     2016       end.
     2017       if p-change-value > 0
     2018       then do:
     2019         if frame Dialog-Frame :scrollable = true
     2020         then do:
     2021           assign
     2022             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2023             no-error .
     2024           if error-status :error
     2025           or error-status :get-message(1) <> ""
     2026           then do:
     2027             undo move_block, retry move_block.
     2028           end.
     2029         end.
     2030         assign
     2031           frame Dialog-Frame :width = v-frame-width + p-change-value
     2032           no-error .
     2033         if error-status :error
     2034         or error-status :get-message(1) <> ""
     2035         then do:
     2036           undo move_block, retry move_block.
     2037         end.
     2038         assign
     2039           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2040         no-error .
     2041         if error-status :error
     2042         or error-status :get-message(1) <> ""
     2043         then do:
     2044           undo move_block, retry move_block.
     2045         end.
     2046         for each buf_temp-browse-handle
     2047           where buf_temp-browse-handle.browse-type = 'width':u
     2048         on error undo move_block, retry move_block
     2049         :
     2050           assign
     2051             buf_temp-browse-handle.browse-handle :width
     2052               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2053             no-error .
     2054           if error-status :error
     2055           or error-status :get-message(1) <> ""
     2056           then do:
     2057             undo move_block, retry move_block .
     2058           end.
     2059         end.
     2060         for each buf_temp-diasize-handle
     2061         on error undo move_block, retry move_block
     2062         :
     2063           assign
     2064             v-object-handle = buf_temp-diasize-handle.handle-value
     2065           .
     2066           if v-object-handle <> v-diasize-resize-button
     2067           then do:
     2068             assign
     2069               v-object-handle :col = v-object-handle :col + p-change-value
     2070               no-error .
     2071             if error-status :error
     2072             or error-status :get-message(1) <> ""
     2073             then do:
     2074               undo move_block, retry move_block .
     2075             end.
     2076           end.
     2077         end.
     2078       end.
     2079       else do:
     2080         for each buf_temp-diasize-handle
     2081         on error undo move_block, retry move_block
     2082         :
     2083           assign
     2084             v-object-handle = buf_temp-diasize-handle.handle-value
     2085           .
     2086           if v-object-handle <> v-diasize-resize-button
     2087           then do:
     2088             assign
     2089               v-object-handle :col = v-object-handle :col + p-change-value
     2090               no-error .
     2091             if error-status :error
     2092             or error-status :get-message(1) <> ""
     2093             then do:
     2094               undo move_block, retry move_block .
     2095             end.
     2096           end.
     2097         end.
     2098         for each buf_temp-browse-handle
     2099           where buf_temp-browse-handle.browse-type = 'width':u
     2100         on error undo move_block, retry move_block
     2101         :
     2102           assign
     2103             buf_temp-browse-handle.browse-handle :width
     2104               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2105             no-error .
     2106           if error-status :error
     2107           or error-status :get-message(1) <> ""
     2108           then do:
     2109             undo move_block, retry move_block .
     2110           end.
     2111         end.
     2112         assign
     2113           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2114           no-error .
     2115         if error-status :error
     2116         or error-status :get-message(1) <> ""
     2117         then do:
     2118           undo move_block, retry move_block.
     2119         end.
     2120         assign
     2121           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2122         no-error .
     2123         if error-status :error
     2124         or error-status :get-message(1) <> ""
     2125         then do:
     2126           undo move_block, retry move_block.
     2127         end.
     2128         if frame Dialog-Frame :scrollable = true
     2129         then do:
     2130           assign
     2131             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2132           no-error .
     2133           if error-status :error
     2134           or error-status :get-message(1) <> ""
     2135           then do:
     2136             undo move_block, retry move_block.
     2137           end.
     2138         end.
     2139       end.
     2140       if p-move-resize
     2141       then do:
     2142         run diasize_position-resize-button in this-procedure .
     2143       end.
     2144       if v-diasize-wndstore = true
     2145       then do:
     2146         if connected("ub") = true
     2147         then do:
     2148           define variable v-cntxt-db-num        as integer   no-undo .
     2149           define variable v-cntxt-userid        as character no-undo .
     2150           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2151                                             , OUTPUT v-cntxt-userid
     2152                                             ) .
     2153           run gbl/wndsizew.p
     2154             (input  v-cntxt-db-num
     2155             ,input  v-cntxt-userid
     2156             ,input  v-diasize-proc-name
     2157             ,input  'width':u
     2158             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2159             ) .
     2160         end.
     2161       end.
     2162     end.
     2163     assign
     2164       v-diasize-change-size = false
     2165     .
     2166   end procedure.
     2167   procedure diasize_set-width :
     2168     define input  parameter p-new-width  as decimal   no-undo .
     2169     define input  parameter p-move-resize as logical   no-undo .
     2170     do
     2171     on error undo, return error return-value
     2172     :
     2173       run diasize_change-width in this-procedure
     2174         (input  (p-new-width - frame Dialog-Frame :width)
     2175         ,input  p-move-resize
     2176         ) .
     2177     end.
     2178   end procedure.
     2179   procedure diasize_position-resize-button :
     2180     do with frame Dialog-Frame
     2181     :
     2182       hide v-diasize-resize-button .
     2183       assign
     2184         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2185                     - 1
     2186                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2187         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2188                     - 1
     2189                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2190       .
     2191       view v-diasize-resize-button .
     2192     end.
     2193   end procedure.
     2194   on alt-right anywhere
     2195   do:
     2196     run diasize_change-width in this-procedure
     2197       (input 1
     2198       ,input true
     2199       ) .
     2200     return no-apply .
     2201   end.
     2202   on alt-left anywhere
     2203   do:
     2204     run diasize_change-width in this-procedure
     2205       (input -1
     2206       ,input true
     2207       ) .
     2208     return no-apply .
     2209   end.
     2210   on alt-down anywhere
     2211   do:
     2212     run diasize_change-height in this-procedure
     2213       (input 1
     2214       ,input true
     2215       ) .
     2216     return no-apply .
     2217   end.
     2218   on alt-up anywhere
     2219   do:
     2220     run diasize_change-height in this-procedure
     2221       (input -1
     2222       ,input true
     2223       ) .
     2224     return no-apply .
     2225   end.
     2226   on alt-enter of frame Dialog-Frame
     2227   do:
     2228     run diasize_maximize in this-procedure
     2229       (input  ?
     2230       ).
     2231     return no-apply .
     2232   end.
     2233   procedure diasize_end-move :
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237       define variable v-row-delta as decimal   no-undo .
     2238       define variable v-col-delta as decimal   no-undo .
     2239       define variable v-new-row as decimal   no-undo .
     2240       define variable v-new-col as decimal   no-undo .
     2241       assign
     2242         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2243         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2244       .
     2245       assign
     2246         v-row-delta = v-new-row - frame Dialog-Frame :height
     2247         v-col-delta = v-new-col - frame Dialog-Frame :width
     2248       .
     2249       run diasize_change-height in this-procedure
     2250         (input v-row-delta
     2251         ,input true
     2252         ) .
     2253       run diasize_change-width in this-procedure
     2254         (input v-col-delta
     2255         ,input true
     2256         ) .
     2257     end.
     2258   end procedure.
     2259   procedure diasize_maximize :
     2260     define input  parameter p-action as logical   no-undo .
     2261     do
     2262     on error undo, return error return-value
     2263     :
     2264       if p-action = ?
     2265       then do:
     2266         if v-diasize-need-maximize = true
     2267         then do:
     2268           assign
     2269             p-action = true
     2270           .
     2271         end.
     2272         else do:
     2273           assign
     2274             p-action = false
     2275           .
     2276         end.
     2277       end.
     2278       if p-action = true
     2279       then do:
     2280         run diasize_change-height in this-procedure
     2281           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2282               - frame Dialog-Frame :height-chars
     2283           ,input true
     2284           ) .
     2285         run diasize_change-width in this-procedure
     2286           (input session :width-chars
     2287               - frame Dialog-Frame :width-chars
     2288           ,input true
     2289           ) .
     2290         assign
     2291           v-diasize-need-maximize = false
     2292         .
     2293       end.
     2294       else do:
     2295         run diasize_change-width in this-procedure
     2296           (input v-diasize-orig-frame-width
     2297               - frame Dialog-Frame :width-chars
     2298           ,input true
     2299           ) .
     2300         run diasize_change-height in this-procedure
     2301           (input v-diasize-orig-frame-height
     2302               - frame Dialog-Frame :height-chars
     2303           ,input true
     2304           ) .
     2305         assign
     2306           v-diasize-need-maximize = true
     2307         .
     2308       end.
     2309     end.
     2310   end procedure.
     2311   procedure diasize_restore-orig-size :
     2312     do
     2313     on error undo, return error return-value
     2314     :
     2315       assign
     2316         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2317         v-diasize-current-frame-height = frame Dialog-Frame :height
     2318       .
     2319       run diasize_set-height in this-procedure
     2320         (input  v-diasize-orig-frame-height
     2321         ,input  true
     2322         ) .
     2323       run diasize_set-width in this-procedure
     2324         (input  v-diasize-orig-frame-width
     2325         ,input  true
     2326         ) .
     2327     end.
     2328   end procedure.
     2329   procedure diasize_restore-current-size :
     2330     do
     2331     on error undo, return error return-value
     2332     :
     2333       run diasize_set-height in this-procedure
     2334         (input  v-diasize-current-frame-height
     2335         ,input  true
     2336         ) .
     2337       run diasize_set-width in this-procedure
     2338         (input  v-diasize-current-frame-width
     2339         ,input  true
     2340         ) .
     2341     end.
     2342   end procedure.
     2343   procedure diasize_set-browse-handle :
     2344     define input  parameter p-browse-handle as handle   no-undo .
     2345     define buffer buf_temp-browse-handle for temp-browse-handle .
     2346     do
     2347     on error undo, return error return-value
     2348     :
     2349       assign
     2350         v-diasize-browse-handle = p-browse-handle
     2351       .
     2352       for each buf_temp-browse-handle
     2353       on error undo, return error return-value
     2354       :
     2355         delete buf_temp-browse-handle .
     2356       end.
     2357     end.
     2358   end procedure.
     2359   procedure diasize_add_browse :
     2360     define input  parameter p-browse-type   as character no-undo .
     2361     define input  parameter p-browse-handle as handle    no-undo .
     2362     define buffer buf_temp-browse-handle for temp-browse-handle .
     2363     do
     2364     on error undo, return error return-value
     2365     :
     2366       assign
     2367         v-diasize-browse-number = v-diasize-browse-number + 1
     2368       .
     2369       create buf_temp-browse-handle .
     2370       assign
     2371         buf_temp-browse-handle.browse-type   = p-browse-type
     2372         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2373         buf_temp-browse-handle.browse-handle = p-browse-handle
     2374       .
     2375     end.
     2376   end procedure.
     2377   procedure diasize_init :
     2378     define variable v-default-value    as logical   no-undo .
     2379     define variable v-restore-saved    as logical   no-undo .
     2380     define variable v-resize-value-str as character no-undo .
     2381     do
     2382     on error undo, return error return-value
     2383     :
     2384       do with frame Dialog-Frame
     2385       :
     2386         assign
     2387           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2388           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2389           v-diasize-browse-handle     = browse br-ccur :handle
     2390         .
     2391         create button v-diasize-resize-button
     2392         assign
     2393           parent        = frame Dialog-Frame :first-child
     2394           label         = "s"
     2395           height-pixels = 16
     2396           width-pixels  = 16
     2397           visible       = true
     2398           sensitive     = true
     2399           movable       = true
     2400           triggers:
     2401             on end-move persistent run diasize_end-move in this-procedure .
     2402           end triggers.
     2403         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2404         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2405         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2406         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2407         assign
     2408           v-diasize-wndmax = false
     2409         .
     2410         if connected("ub") = true
     2411         then do:
     2412           define variable v-cntxt-db-num        as integer   no-undo .
     2413           define variable v-cntxt-userid        as character no-undo .
     2414           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2415                                             , OUTPUT v-cntxt-userid
     2416                                             ) .
     2417           run gbl/wndpar_r.p
     2418             (input  v-cntxt-db-num
     2419             ,input  v-cntxt-userid
     2420             ,input  'wndmax':U
     2421             ,output v-diasize-wndmax
     2422             ,output v-default-value
     2423             ) .
     2424         end.
     2425         assign
     2426           v-diasize-wndstore = false
     2427         .
     2428         if connected("ub") = true
     2429         then do:
     2430           run gbl/wndpar_r.p
     2431             (input  v-cntxt-db-num
     2432             ,input  v-cntxt-userid
     2433             ,input  'wndstore':U
     2434             ,output v-diasize-wndstore
     2435             ,output v-default-value
     2436             ) .
     2437         end.
     2438         assign
     2439           v-diasize-proc-name = entry(1, program-name(2), '.')
     2440         .
     2441         if v-diasize-wndstore = true
     2442         then do:
     2443           assign
     2444             v-restore-saved = false
     2445           .
     2446           if connected("ub") = true
     2447           then do:
     2448             run gbl/wndsizer.p
     2449               (input  v-cntxt-db-num
     2450               ,input  v-cntxt-userid
     2451               ,input  v-diasize-proc-name
     2452               ,input  'height':u
     2453               ,output v-resize-value-str
     2454               ) .
     2455             if v-resize-value-str <> '':U
     2456             then do:
     2457               run diasize_change-height in this-procedure
     2458                 (input  integer(v-resize-value-str)
     2459                 ,input  true
     2460                 ) .
     2461               assign
     2462                 v-restore-saved = true
     2463               .
     2464             end.
     2465           end.
     2466           if connected("ub") = true
     2467           then do:
     2468             run gbl/wndsizer.p
     2469               (input  v-cntxt-db-num
     2470               ,input  v-cntxt-userid
     2471               ,input  v-diasize-proc-name
     2472               ,input  'width':u
     2473               ,output v-resize-value-str
     2474               ) .
     2475             if v-resize-value-str <> '':U
     2476             then do:
     2477               run diasize_change-width in this-procedure
     2478                 (input  integer(v-resize-value-str)
     2479                 ,input  true
     2480                 ) .
     2481               assign
     2482                 v-restore-saved = true
     2483               .
     2484             end.
     2485           end.
     2486           if v-restore-saved <> true
     2487           then do:
     2488             if v-diasize-wndmax = true
     2489             then do:
     2490               run diasize_maximize in this-procedure
     2491                 (input  true
     2492                 ) .
     2493             end.
     2494           end.
     2495         end.
     2496         else do:
     2497           if v-diasize-wndmax = true
     2498           then do:
     2499             run diasize_maximize in this-procedure
     2500               (input  true
     2501               ) .
     2502           end.
     2503         end.
     2504       end.
     2505     end.
     2506   end procedure.
     2507   procedure diasize_need-full-display :
     2508     define output parameter p-need-full-display as logical   no-undo .
     2509     do
     2510     on error undo, return error return-value
     2511     :
     2512       assign
     2513         p-need-full-display = v-diasize-need-full-display
     2514       .
     2515       assign
     2516         v-diasize-need-full-display = false
     2517       .
     2518     end.
     2519   end procedure.
     2520   procedure get-context :
     2521      define output parameter p-db-num as integer          no-undo.
     2522      define output parameter p-user-id as character        no-undo.
     2523      define variable v-login               as character    no-undo.
     2524      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2525      define buffer buf_user-login  for ub.user-login .
     2526      do
     2527      on error undo, return error
     2528      :
     2529            FIND FIRST buf_sys-ctrl no-lock.
     2530            ASSIGN
     2531               v-login = USERID("ub")
     2532               p-db-num = buf_sys-ctrl.db-num
     2533            .
     2534            FIND FIRST buf_user-login
     2535                 WHERE buf_user-login.db-num = p-db-num
     2536                   AND buf_user-login.user-login = v-login
     2537                 no-lock
     2538                 no-error
     2539                 .
     2540            IF AVAILABLE buf_user-login
     2541            THEN DO:
     2542               assign
     2543                  p-user-id = buf_user-login.user-id
     2544               .
     2545            END.
     2546      end.
     2547   end procedure.
     2548   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2549   on f5 of frame Dialog-Frame anywhere
     2550   do:
     2551     v-doc-rec = recid(X_c-currency). run OpenBr in this-procedure. reposition br-ccur to recid v-doc-rec no-error. v-doc-rec = ?.              apply 'value-changed' to br-ccur.
     2552       apply "VALUE-CHANGED" to br-ccur.
     2553   end.
     2554   def var sort-labelbr-ccur   as character no-undo .
     2555   def var sort-clmnbr-ccur    as handle    no-undo .
     2556   def var cur-clmnbr-ccur     as handle    no-undo .
     2557   def var cur-clmn-locbr-ccur as integer   no-undo .
     2558   def var re-querybr-ccur     as logical   initial no no-undo .
     2559   on start-search, ctrl-o of br-ccur in frame Dialog-Frame do:
     2560      run sort-brbr-ccur
     2561        (input (if available X_c-currency
     2562                then recid(X_c-currency)
     2563                else ?
     2564               )
     2565        ).
     2566   end.
     2567   PROCEDURE sort-brbr-ccur :
     2568     define input parameter p-recid as recid no-undo .
     2569     if re-querybr-ccur = no then do:
     2570       assign
     2571          cur-clmnbr-ccur = br-ccur:current-column in frame Dialog-Frame
     2572       .
     2573       if sort-clmnbr-ccur <> ? then sort-clmnbr-ccur:column-fgcolor = 0.
     2574       if cur-clmnbr-ccur = sort-clmnbr-ccur then do:
     2575         assign
     2576            sort-labelbr-ccur = ""
     2577            sort-clmnbr-ccur = ?
     2578         .
     2579        end.
     2580        else do:
     2581          assign
     2582            sort-labelbr-ccur = cur-clmnbr-ccur:label
     2583            sort-clmnbr-ccur  = cur-clmnbr-ccur
     2584            sort-clmnbr-ccur:column-fgcolor = 4
     2585          .
     2586        end.
     2587      end.
     2588     assign
     2589       cur-clmn-locbr-ccur = 1
     2590     .
     2591     def var column-handle as handle no-undo .
     2592     column-handle = br-ccur:first-column.
     2593     do while valid-handle(column-handle) :
     2594       if column-handle = cur-clmnbr-ccur then do:
     2595         leave .
     2596       end.
     2597       column-handle = column-handle:NEXT-COLUMN.
     2598       assign
     2599         cur-clmn-locbr-ccur = cur-clmn-locbr-ccur + 1
     2600       .
     2601     end.
     2602     case sort-labelbr-ccur:
     2603           when X_c-currency.curr-abbr:label in browse br-ccur then DO:   assign     sort-column-name = "X_c-currency.curr-abbr"   .   run OpenBr.   . END.
     2604       otherwise do:
     2605         assign
     2606           sort-column-name = ""
     2607         .
     2608         run OpenBr.
     2609           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-ccur') then do:
     2610             run mv-brw-defaultbr-ccur.
     2611           end.
     2612         if sort-labelbr-ccur <> "" then do:
     2613           assign
     2614             cur-clmnbr-ccur:column-fgcolor = 0
     2615           .
     2616         end.
     2617         assign
     2618           cur-clmn-locbr-ccur = ?
     2619         .
     2620       end.
     2621     end case.
     2622       if cur-clmn-locbr-ccur <> ? then do:
     2623         if can-do( this-procedure:internal-entries, 'ch-clmnbr-ccur') then do:
     2624           run ch-clmnbr-ccur in this-procedure (cur-clmn-locbr-ccur).
     2625         end.
     2626       end.
     2627     if p-recid <> ? then do:
     2628       reposition br-ccur to recid p-recid no-error.
     2629       apply "value-changed" to br-ccur in frame Dialog-Frame.
     2630     end.
     2631     apply "entry" to br-ccur in frame Dialog-Frame.
     2632   END PROCEDURE.
     2633   procedure re-open-query-srt-clmnbr-ccur:
     2634   if cur-clmnbr-ccur = ? then do:
     2635      run OpenBr.
     2636   end.
     2637   else do:
     2638      assign re-querybr-ccur = yes.
     2639      run sort-brbr-ccur
     2640        (input (if available X_c-currency
     2641                then recid(X_c-currency)
     2642                else ?
     2643               )
     2644        ).
     2645      assign re-querybr-ccur = no.
     2646   end.
     2647   end.
     2648   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2649   do:
     2650     br-ccur :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2651   end.
     2652   MAIN-BLOCK:
     2653   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2654      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2655    if LOOKUP(p-mode, 'one':U,
     2656                   chr(4)) = 0
     2657        then dO:
     2658       message
     2659       vss-workfile vss-revision vss-description skip
     2660       "Неверное значение параметров вызова p-mode"
     2661       p-mode
     2662       view-as alert-box ERROR.
     2663       return error .
     2664    end.
     2665    if p-mode = "one":U then do:
     2666     find first X_currency no-lock where
     2667                   X_currency.curr-code = p-curr-code no-error.
     2668       if not available X_currency then do:
     2669           message
     2670           vss-workfile vss-revision vss-description skip
     2671           "Неверное значение параметра вызова p-curr-code"
     2672           p-curr-code
     2673           view-as alert-box ERROR.
     2674           return.
     2675       end.
     2676     end.
     2677   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2678   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2679     (output v-db-num
     2680     )  .
     2681    v-rid-list = p-rid-list.
     2682     RUN MyEnable.
     2683     RUn OpenBR.
     2684     HIDE mark-num in frame Dialog-Frame .
     2685     if v-doc-rec <> ? then
     2686     REPOSITION br-ccur to recid v-doc-rec No-ERROR.
     2687   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2688   DEF VAR cur-clmn-numbr-ccur as INT EXTENT 8 no-undo.
     2689   DEF VAR varmvibr-ccur       as INT no-undo.
     2690   DEF VAR varmvjbr-ccur       as INT no-undo.
     2691   DEF VAR varmvkbr-ccur       as INT no-undo.
     2692   DEF VAR varmvlbr-ccur       as INT no-undo.
     2693   DEF VAR move-elementbr-ccur as INT no-undo.
     2694   def var jjbr-ccur           as int no-undo.
     2695   do varmvibr-ccur = 1 to EXTENT(cur-clmn-numbr-ccur):
     2696     ASSIGN cur-clmn-numbr-ccur[varmvibr-ccur] = varmvibr-ccur.
     2697   END.
     2698   RUN start-mv-clmnbr-ccur.
     2699   PROCEDURE start-mv-clmnbr-ccur:
     2700   def var old-session as logical no-undo.
     2701      old-session = SESSION:IMMEDIATE-DISPLAY.
     2702      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2703          IF  p-mode = 'one'  THEN DO:
     2704      DO jjbr-ccur = NUM-ENTRIES('1,2,3,4,5,6,7') TO 1 BY -1:
     2705        RUN re-move-clmnbr-ccur ( cur-clmn-numbr-ccur[INTEGER(ENTRY (jjbr-ccur, '1,2,3,4,5,6,7'))] , 1).
     2706      END.
     2707          END.
     2708      SESSION:IMMEDIATE-DISPLAY = old-session.
     2709   END.
     2710   ON ctrl-cursor-right OF BROWSE br-ccur do:
     2711     RUN re-move-clmnbr-ccur ( 1, 8).
     2712   END.
     2713   ON ctrl-cursor-left OF BROWSE br-ccur do:
     2714     RUN re-move-clmnbr-ccur (8, 1).
     2715   END.
     2716   PROCEDURE re-move-clmnbr-ccur:
     2717     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2718     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2719     DO varmvibr-ccur = 1 TO EXTENT(cur-clmn-numbr-ccur):
     2720       if cur-clmn-numbr-ccur[varmvibr-ccur] = source-column THEN cur-clmn-numbr-ccur[varmvibr-ccur] = -1.
     2721     END.
     2722     if br-ccur:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2723     if source-column > target-column THEN
     2724     DO varmvjbr-ccur = source-column - 1 to target-column BY -1:
     2725       DO varmvibr-ccur = 1 TO EXTENT(cur-clmn-numbr-ccur):
     2726           if cur-clmn-numbr-ccur[varmvibr-ccur] = varmvjbr-ccur THEN DO:
     2727             cur-clmn-numbr-ccur[varmvibr-ccur] = cur-clmn-numbr-ccur[varmvibr-ccur] + 1.
     2728           END.
     2729       END.
     2730     END.
     2731     ELSE
     2732     DO varmvjbr-ccur = source-column + 1 to target-column:
     2733       DO varmvibr-ccur = 1 TO EXTENT(cur-clmn-numbr-ccur):
     2734         if cur-clmn-numbr-ccur[varmvibr-ccur] = varmvjbr-ccur THEN DO:
     2735           cur-clmn-numbr-ccur[varmvibr-ccur] = cur-clmn-numbr-ccur[varmvibr-ccur] - 1.
     2736         END.
     2737       END.
     2738     END.
     2739     DO varmvibr-ccur = 1 TO EXTENT(cur-clmn-numbr-ccur):
     2740       if cur-clmn-numbr-ccur[varmvibr-ccur] = -1 THEN cur-clmn-numbr-ccur[varmvibr-ccur] = target-column.
     2741     END.
     2742   END PROCEDURE.
     2743   PROCEDURE ch-clmnbr-ccur:
     2744     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2745     if cur-clmn-loc <= 1 then do:
     2746       return .
     2747     end.
     2748     DO varmvibr-ccur = 1 TO EXTENT(cur-clmn-numbr-ccur):
     2749       if cur-clmn-numbr-ccur[varmvibr-ccur] = cur-clmn-loc THEN move-elementbr-ccur = varmvibr-ccur.
     2750     END.
     2751     RUN re-move-clmnbr-ccur (cur-clmn-loc, 1).
     2752   END PROCEDURE.
     2753   PROCEDURE mv-brw-defaultbr-ccur:
     2754   def var old-session as logical no-undo.
     2755     old-session = SESSION:IMMEDIATE-DISPLAY.
     2756     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2757     do varmvlbr-ccur = 1 to EXTENT(cur-clmn-numbr-ccur):
     2758       RUN re-move-clmnbr-ccur (cur-clmn-numbr-ccur[varmvlbr-ccur], varmvlbr-ccur).
     2759     END.
     2760     RUN start-mv-clmnbr-ccur.
     2761     SESSION:IMMEDIATE-DISPLAY = old-session.
     2762   END PROCEDURE.
     2763   .
     2764     run diasize_add_browse in this-procedure
     2765       (input  'width':u
     2766       ,input  browse br-changes :handle
     2767       ) .
     2768     run diasize_init in this-procedure .
     2769   WAIT-FOR GO OF FRAME Dialog-Frame.
     2770   END.
     2771   RUN disable_UI.
     2772   PROCEDURE disable_UI :
     2773     HIDE FRAME Dialog-Frame.
     2774   END PROCEDURE.
     2775   PROCEDURE enable_UI :
     2776     DISPLAY mark-num
     2777         WITH FRAME Dialog-Frame.
     2778     ENABLE b-quit B-mark B-sel B-Help br-ccur BR-changes mark-num
     2779         WITH FRAME Dialog-Frame.
     2780     VIEW FRAME Dialog-Frame.
     2781     OPEN QUERY br-ccur FOR EACH X_c-currency NO-LOCK INDEXED-REPOSITION.
     2782   END PROCEDURE.
     2783   PROCEDURE MyEnable :
     2784   assign
     2785   temp-changes.l_name:resizable in browse br-changes = true
     2786   temp-changes.v_old:resizable in browse br-changes = true
     2787   temp-changes.v_new:resizable in browse br-changes = true
     2788   temp-changes.l_name:width in browse br-changes = 30
     2789   temp-changes.v_old:width in browse br-changes = 40
     2790   temp-changes.v_new:width in browse br-changes = 40
     2791   .
     2792   DISPLAY mark-num
     2793   WITH FRAME Dialog-Frame.
     2794   ENABLE
     2795   b-quit
     2796   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2797   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2798   B-Help
     2799   br-ccur mark-num
     2800   br-changes
     2801   with FRAME Dialog-Frame.
     2802   VIEW FRAME Dialog-Frame.
     2803   END PROCEDURE.
     2804   PROCEDURE OpenBr :
     2805   OPEN QUERY br-ccur FOR EACH X_c-currency NO-LOCK where
     2806                                  X_c-currency.curr-code = p-curr-code
     2807                              AND X_c-currency.corr-user-db-num = 0
     2808                                 INDEXED-REPOSITION.
     2809   APPLY "VALUE-CHANGED" TO br-ccur in frame Dialog-Frame.
     2810   APPLY "ENTRY" TO br-ccur.
     2811   END PROCEDURE.
     2812   PROCEDURE proc-br-ccur :
     2813   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2814   if b-sel:sensitive in frame Dialog-Frame then dO:
     2815       if b-mark:sensitive then do:
     2816           apply "choose" to b-mark in frame Dialog-Frame.
     2817       end.
     2818       else do:
     2819           apply "choose" to b-sel in frame Dialog-Frame.
     2820       end.
     2821   end.
     2822   else do:
     2823       if b-lookup:sensitive then
     2824       apply "choose" to b-lookup in frame Dialog-Frame.
     2825   end.
     2826   END PROCEDURE.
     2827   PROCEDURE proc-view-changes :
     2828   define buffer new_c-currency for ub.c-currency.
     2829   define buffer current_currency for ub.currency.
     2830   define variable v-chg-fields as character no-undo.
     2831   define variable v-old-fields as character no-undo.
     2832   define variable v-new-fields as character no-undo.
     2833   define variable ii as integer no-undo.
     2834   define variable jj as integer no-undo .
     2835   define variable v-field-name as character no-undo .
     2836   define variable v-field-label as character no-undo .
     2837   for each temp-changes:
     2838       delete temp-changes.
     2839   END.
     2840   if not available X_c-currency then do:
     2841     Open QUery br-changes for each temp-changes.
     2842     return.
     2843   end.
     2844   define variable v-label-param as character no-undo .
     2845   v-label-param =
     2846     "curr-code" + chr(4) + "Код валюты" + chr(4) + "" + chr(8)
     2847    + "curr-abbr" + chr(4) + "Аббревиатура" + chr(4) + "" + chr(8)
     2848    + "curr-name" + chr(4) + "Название валюты" + chr(4) + "" + chr(8)
     2849    + "curr-name-five" + chr(4) + "пять..." + chr(4) + "" + chr(8)
     2850    + "curr-name-one" + chr(4) + "один/одна..." + chr(4) + "" + chr(8)
     2851    + "curr-name-three" + chr(4) + "три..." + chr(4) + "" + chr(8)
     2852    + "curr-eng-name" + chr(4) + "Название (англ.)+Букв.код" + chr(4) + "" + chr(8)
     2853    + "curr-eng-name-five" + chr(4) + "five..." + chr(4) + "" + chr(8)
     2854    + "curr-eng-name-one" + chr(4) + "one..." + chr(4) + "" + chr(8)
     2855    + "curr-eng-name-three" + chr(4) + "three..." + chr(4) + "" + chr(8)
     2856    + "okv-code" + chr(4) + "Код ОКВ" + chr(4) + "" + chr(8)
     2857    + "part-abbr" + chr(4) + "Сокращение дробной части" + chr(4) + "" + chr(8)
     2858    + "part-name" + chr(4) + "Название дробной части" + chr(4) + "" + chr(8)
     2859    + "part-name-five" + chr(4) + "пять..." + chr(4) + "" + chr(8)
     2860    + "part-name-one" + chr(4) + "один/одна..." + chr(4) + "" + chr(8)
     2861    + "part-name-three" + chr(4) + "три..." + chr(4) + ""  .
     2862    run proc-full-temp-changes in this-procedure (
     2863                                                input  buffer X_c-currency:handle
     2864                                               ,input  'currency':U
     2865                                               ,input  "curr-code,curr-abbr,curr-name,curr-name-five,curr-name-one,curr-name-three,curr-eng-name,curr-eng-name-five,curr-eng-name-one,curr-eng-name-three,okv-code,part-abbr,part-name,part-name-five,part-name-one,part-name-three"
     2866                                               ,input  v-label-param).
     2867   Open QUery br-changes for each temp-changes.
     2868   END PROCEDURE.
