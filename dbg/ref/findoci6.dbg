     2540   run change-view in this-procedure(rs-view).
     2541   END.
     2542   ON LEAVE OF tt-fin-doc.receiver-code IN FRAME Dialog-Frame
     2543     DO:
     2544   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2545   if lookup(self :type
     2546            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2547            ) = 0
     2548   then do:
     2549     message
     2550       "$Workfile$"
     2551       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2552       "Интерфейсный элемент" self :name  skip
     2553       "Тип" self :type  skip
     2554       "Процедура" this-procedure :file-name skip
     2555       view-as alert-box .
     2556   end.
     2557   else do:
     2558     apply "entry":u to self  .
     2559     if focus :handle <> self :handle  then do:
     2560       return no-apply .
     2561     end.
     2562   end.
     2563   if   input frame Dialog-Frame tt-fin-doc.receiver-code <> 0 then
     2564   do:
     2565     run check-receiver in this-procedure no-error.
     2566     if error-status:error then
     2567     do:
     2568       return no-apply.
     2569     end.
     2570     CASE X_receiver.obj-type:   when 'чел':U then do:              find first X_receiver-person no-lock where               X_receiver-person.psn-code = X_receiver.obj-code .   end.   when 'орг':U then do:     find first X_receiver-firm no-lock where               X_receiver-firm.firm-code = X_receiver.obj-code .   end. END CASE. assign tt-fin-doc.receiver-sign1  = if X_receiver.obj-type = 'орг':U                              then X_receiver-firm.director                             else X_receiver.obj-name . display tt-fin-doc.receiver-sign1 with frame Dialog-Frame.
     2571   end.
     2572   END.
     2573   ON VALUE-CHANGED OF tt-fin-doc.receiver-type IN FRAME Dialog-Frame
     2574     DO:
     2575       assign
     2576         tt-fin-doc.receiver-type.
     2577       if   input frame Dialog-Frame tt-fin-doc.receiver-code <> 0 then
     2578       do:
     2579         run check-receiver in this-procedure no-error.
     2580         if error-status:error then
     2581         do:
     2582           return no-apply.
     2583         end.
     2584         CASE X_receiver.obj-type:   when 'чел':U then do:              find first X_receiver-person no-lock where               X_receiver-person.psn-code = X_receiver.obj-code .   end.   when 'орг':U then do:     find first X_receiver-firm no-lock where               X_receiver-firm.firm-code = X_receiver.obj-code .   end. END CASE. assign tt-fin-doc.receiver-sign1  = if X_receiver.obj-type = 'орг':U                              then X_receiver-firm.director                             else X_receiver.obj-name . display tt-fin-doc.receiver-sign1 with frame Dialog-Frame.
     2585       end.
