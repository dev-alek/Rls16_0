     3787     v-doc-date = tt-fin-doc.doc-date
     3788     tt-fin-doc.doc-date
     3789     .
     3790   if tt-fin-doc.doc-date <> v-doc-date
     3791     and (input frame Dialog-Frame   tt-fin-doc.sum-doc <> 0
     3792     or tt-fin-doc.sum-doc <> 0)
     3793     then
     3794   do:
     3795     message
     3796       "Пересчитать суммы документа в соответствии с курсами на новую дату?"
     3797       view-as alert-box QUESTION buttons YEs-NO update vlog.
     3798     if  vlog then
     3799     do:
     3800       run recalc in this-procedure ("doc-date":U) no-error.
     3801       if error-status:error then
     3802       do:
     3803         assign
     3804           tt-fin-doc.doc-date = v-doc-date
     3805           .
     3806         display tt-fin-doc.doc-date
     3807           with frame Dialog-Frame.
     3808       end.
     3809     end.
     3810   end.
     3811   END.
