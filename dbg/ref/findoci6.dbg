     2901   ON LEAVE OF tt-fin-doc.an-uchet-value IN FRAME Dialog-Frame
     2902     DO:
     2903   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2904   if lookup(self :type
     2905            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
