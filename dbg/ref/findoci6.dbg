     2023     do:
     2024   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2025   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2026     (input  tt-fin-doc.obj-type
     2027     ,input  tt-fin-doc.obj-code
     2028     ,output v-obj-db-num
     2029     )  .
     2030       define variable l-shift-on as logical no-undo .
     2031   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2032   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2033     (input  tt-fin-doc.obj-type
     2034     ,input  tt-fin-doc.obj-code
     2035     ,input  'shift-on=request'
     2036     ,output l-shift-on
