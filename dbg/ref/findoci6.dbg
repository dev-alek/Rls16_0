     1536   ASSIGN
     1537          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1538          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1539   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1540   DO:
     1541     APPLY "END-ERROR":U TO SELF.
     1542   END.
     1543   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1544   DO:
     1545   define variable v-format as integer no-undo .
     1546   define variable v-cmp as character no-undo .
     1547   define variable v-log as logical no-undo .
     1548   buffer-compare tt-fin-doc except payer-sign1
     1549   to locked_fin-doc
     1550   case-sensitive
     1551   save result in v-cmp .
     1552   if v-cmp <> "":U
     1553   or  entry((if num-entries(locked_fin-doc.payer-sign1, chr(4)) > 1
     1554              then 2
     1555              else 1)
     1556              , locked_fin-doc.payer-sign1, chr(4)
     1557            ) <> tt-fin-doc.payer-sign1
     1558   then do:
     1559     message
     1560     "Вы изменили ПЛАТЕЖ, но не сохранили его" skip
     1561     "сохранить перед печатью?"
     1562     view-as alert-box QUESTION buttons YES-NO update v-log.
     1563   end.
     1564   run proc-save in this-procedure (v-log ) no-error.
     1565   run ref/fdoc-prn.p (
     1566           input parparentproc
     1567         , input this-procedure
     1568         , input string(recid(locked_fin-doc))
     1569                         ) no-error.
     1570   if error-status:error then return no-apply.
     1571   END.
     1572   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1573   procedure proc-color-widgets :
     1574   define input parameter p-list as character no-undo .
     1575   define input parameter p-fg as logical no-undo .
     1576   define input parameter p-bg as logical no-undo .
     1577   define input parameter p-fgc as integer no-undo .
     1578   define input parameter p-bgc as integer no-undo .
     1579   define variable ii as integer no-undo .
     1580   define variable fh as widget-handle no-undo .
     1581   define variable hh as widget-handle no-undo .
     1582     do
     1583     on error undo, return error
     1584     :
     1585       assign
     1586       fh = frame Dialog-Frame:first-child
     1587       hh = fh:first-child
     1588       .
     1589       do while valid-handle(hh):
     1590         if LOOKUP(hh:name, p-list) > 0  then do:
     1591           assign
     1592           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     1593           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     1594           .
     1595         end.
     1596         hh = hh:next-sibling.
     1597       end.
     1598     end.
     1599   end procedure.
     1600   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
