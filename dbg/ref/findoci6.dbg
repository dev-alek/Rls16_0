     2718       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2719       .
     2720   end.
     2721   end.
     2722   else do:
     2723   tt-fin-doc.naznach-plat = "".
     2724   end.
     2725   end.
     2726   end.
     2727     display
     2728       tt-fin-doc.receiver-type
     2729       tt-fin-doc.receiver-code
     2730       tt-fin-doc.receiver-name
     2731       with frame Dialog-Frame.
     2732   END PROCEDURE.
