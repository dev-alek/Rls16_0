     3723     tt-fin-doc.curr-code.
     3724   FIND FIRST X_currency WHERE
     3725     X_currency.curr-code = tt-fin-doc.curr-code NO-LOCK NO-error.
     3726   if not available X_currency then
     3727   do:
     3728     message
     3729       "Нет валюты с кодом"   tt-fin-doc.curr-code
     3730       view-as alert-box error.
     3731     assign
     3732       tt-fin-doc.curr-code = v-curr-code.
     3733     display
     3734       tt-fin-doc.curr-code
     3735       with frame Dialog-Frame.
     3736     .
     3737   end.
     3738   else
