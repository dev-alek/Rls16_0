     4918       .
     4919       display
     4920       b-contract-view
     4921       f-contract-date when tt-fin-doc.contract-code <> 0
     4922       f-contract-prn-code when tt-fin-doc.contract-code <> 0
     4923       f-contract-type when tt-fin-doc.contract-code <> 0
     4924       f-contract-curr-abbr when tt-fin-doc.contract-code <> 0
     4925       tt-fin-doc.contract-curr when tt-fin-doc.contract-code <> 0
     4926       with frame Dialog-Frame
     4927       .
     4928       ENABLE
     4929       b-contract-view
     4930       with frame Dialog-Frame.
     4931     end.
     4932   END CASE.
     4933   END PROCEDURE.
     4934   PROCEDURE disable_UI :
     4935     HIDE FRAME Dialog-Frame.
     4936   END PROCEDURE.
     4937   PROCEDURE enable_UI :
     4938     OPEN QUERY Dialog-Frame FOR EACH locked_fin-doc SHARE-LOCK.
     4939     GET FIRST Dialog-Frame.
     4940     DISPLAY RS-view f-cor-acc-descr f-an-uchet-descr f-contract-curr-abbr
     4941             f-contract-prn-code f-contract-date f-contract-type f-cor-acc1-descr
     4942             f-cel-nazn-descr f-rest-con-sum F-curr-abbr F-debet F-credit
     4943         WITH FRAME Dialog-Frame.
     4944     IF AVAILABLE tt-fin-doc THEN
     4945       DISPLAY tt-fin-doc.user-name-doc tt-fin-doc.prn-doc-code
     4946             tt-fin-doc.fin-doc-code tt-fin-doc.perm-date tt-fin-doc.doc-date
     4947             tt-fin-doc.user-name-perm tt-fin-doc.obj-type tt-fin-doc.obj-code
     4948             tt-fin-doc.fact-date tt-fin-doc.user-name-fact tt-fin-doc.payer-type
     4949             tt-fin-doc.payer-code tt-fin-doc.payer-okpo tt-fin-doc.payer-name
     4950             tt-fin-doc.str-podr-type tt-fin-doc.str-podr-code
     4951             tt-fin-doc.str-podr-name tt-fin-doc.cor-acc-value
     4952             tt-fin-doc.an-uchet-value tt-fin-doc.contract-curr
     4953             tt-fin-doc.cor-acc1-value tt-fin-doc.cel-nazn-value tt-fin-doc.sum-doc
     4954             tt-fin-doc.curr-code tt-fin-doc.exch-rate tt-fin-doc.exch-scale
     4955             tt-fin-doc.sum-rubl tt-fin-doc.base-rate tt-fin-doc.base-scale
     4956             tt-fin-doc.sum-base tt-fin-doc.contract-rate tt-fin-doc.contract-scale
     4957             tt-fin-doc.sum-contr tt-fin-doc.receiver-type tt-fin-doc.receiver-code
     4958             tt-fin-doc.receiver-name tt-fin-doc.naznach-plat tt-fin-doc.PS
     4959             tt-fin-doc.payer-sign1 tt-fin-doc.receiver-sign1
     4960         WITH FRAME Dialog-Frame.
     4961     ENABLE B-exit b-quit B-tax B-print B-hist B-Help RS-view
     4962            tt-fin-doc.user-name-doc tt-fin-doc.prn-doc-code tt-fin-doc.doc-date
     4963            tt-fin-doc.obj-type tt-fin-doc.obj-code B-obj tt-fin-doc.payer-name
     4964            B-payer-view tt-fin-doc.str-podr-type tt-fin-doc.str-podr-code
     4965            tt-fin-doc.str-podr-name tt-fin-doc.cor-acc-value B-cor-acc
     4966            tt-fin-doc.an-uchet-value B-an-uchet f-contract-curr-abbr
     4967            B-contract-view tt-fin-doc.contract-curr tt-fin-doc.cor-acc1-value
     4968            B-cor-acc1 tt-fin-doc.cel-nazn-value B-cel-nazn tt-fin-doc.sum-doc
     4969            f-rest-con-sum tt-fin-doc.curr-code B-currency B-calc
     4970            tt-fin-doc.exch-rate tt-fin-doc.exch-scale tt-fin-doc.sum-rubl
     4971            tt-fin-doc.sum-base tt-fin-doc.contract-rate tt-fin-doc.contract-scale
     4972            tt-fin-doc.sum-contr B-receiver tt-fin-doc.receiver-type
     4973            tt-fin-doc.receiver-code tt-fin-doc.receiver-name B-receiver-view
     4974            tt-fin-doc.naznach-plat tt-fin-doc.PS tt-fin-doc.payer-sign1
     4975            tt-fin-doc.receiver-sign1
     4976         WITH FRAME Dialog-Frame.
     4977     VIEW FRAME Dialog-Frame.
     4978   END PROCEDURE.
     4979   PROCEDURE fill-main-table :
     4980   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4981   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4982     (output v-db-num
     4983     )  .
     4984   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4985   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4986     (input  p-host-code
     4987     ,output v-base-code
     4988     )  .
     4989   for each tt-fin-doc:
     4990     delete tt-fin-doc.
     4991   end.
     4992   for each tt0-fin-doc-attr:
     4993     delete tt0-fin-doc-attr.
     4994   end.
     4995   for each tt0-fin-doc-tax:
     4996    delete tt0-fin-doc-tax.
     4997   end.
     4998   if p-mode = 'ИЗМЕНЕНИЕ':U
     4999   or p-mode = 'ПРОСМОТР':U
     5000   or p-mode = 'КОПИРОВАНИЕ':U
     5001   then do:
     5002     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     5003       find first locked_fin-doc EXclusive-lock where
     5004                     recid(locked_fin-doc) = p-doc-rec no-wait no-error.
     5005       if locked locked_fin-doc then do:
     5006         message
     5007         substitute("Запись &1 занята", p-fin-doc-code)
     5008         view-as alert-box error .
     5009         undo, return error.
     5010       end.
     5011     end.
     5012     else do:
     5013       find first locked_fin-doc no-lock where
     5014                   recid(locked_fin-doc) = p-doc-rec no-error .
     5015         if not available locked_fin-doc then do:
     5016           find first locked_fin-doc no-lock where
     5017                       locked_fin-doc.host-code = p-host-code
     5018                   AND locked_fin-doc.fin-doc-code = p-fin-doc-code no-error .
     5019         end.
     5020     end.
     5021     if not available locked_fin-doc then do:
     5022       message
     5023       substitute("&1 &2 &3&4 Не найдена запись &5"
     5024                   ,vss-workfile
     5025                   ,vss-revision
     5026                   ,vss-description
     5027                   ,chr(10)
     5028                   ,p-fin-doc-code)
     5029       view-as alert-box error .
     5030       undo, return error.
     5031     end.
     5032     if p-mode = 'ИЗМЕНЕНИЕ':U
     5033     AND not (locked_fin-doc.status_ = 'новый':U
     5034               or locked_fin-doc.status_ = 'разрешен':U )
     5035     then do:
     5036       message
     5037       substitute("Финансовый документ &1 находится в статусе &2&3Изменение невозможно"
     5038                 ,p-fin-doc-code
     5039                 ,locked_fin-doc.status_
     5040                 ,chr(10))
     5041       view-as alert-box error .
     5042       undo, return error.
     5043     end.
     5044     create tt-fin-doc.
     5045     if p-mode = 'КОПИРОВАНИЕ':U then do:
     5046       buffer-copy locked_fin-doc
     5047       using
     5048       obj-type
     5049       obj-code
     5050       payer-type
     5051       payer-code
     5052       payer-name
     5053       payer-sign1
     5054       payer-okpo
     5055       receiver-type
     5056       receiver-code
     5057       receiver-name
     5058       receiver-sign1
     5059       an-uchet-code
     5060       an-uchet-value
     5061       cel-nazn-code
     5062       cel-nazn-value
     5063       contract-code
     5064       contract-curr
     5065       cor-acc-value
     5066       cor-acc1-value
     5067       cor-acc1
     5068       cor-acc
     5069       curr-code
     5070       naznach-plat
     5071       str-podr-code
     5072       str-podr-name
     5073       str-podr-type
     5074       sum-doc
     5075       CashBookId
     5076       to tt-fin-doc
     5077       assign
     5078       tt-fin-doc.host-code = p-host-code
     5079       .
     5080     end.
     5081     else do:
     5082       buffer-copy locked_fin-doc to tt-fin-doc.
     5083     end.
     5084   end.
     5085   if p-mode = 'ДОБАВЛЕНИЕ':U
     5086   or p-mode = 'КОПИРОВАНИЕ':U then do:
     5087     run ref/finfnoco.p (
     5088                     INPUT parParentProc
     5089                   ,INPUT this-procedure:handle
     5090                   ,input p-curr-host-code
     5091                   ,input (p-mode  + chr(4) + 'manual':U)
     5092                   ,input p-host-code
     5093                   ,input p-doc-rec
     5094                   ,input p-fin-doc-code
     5095                   ,input 'апр':U
     5096                   ,input 'апр':U
     5097                   ,input p-obj-type
     5098                   ,input p-obj-code
     5099                   ,input p-contract-code
     5100                   ,input p-ob-doc-code
     5101                   ,input 'орг':U
     5102                   ,input p-host-code
     5103                   ,input 0
     5104                   ,input p-receiver-type
     5105                   ,input p-receiver-code
     5106                   ,input 0
     5107                   ,input p-curr-code
     5108                   ,input p-cor-acc
     5109                   ,input p-cor-acc1
     5110                   ,input p-an-uchet-code
     5111                   ,input p-cel-nazn-code
     5112                   ,input (if available tt-fin-doc then tt-fin-doc.CashBookId else 0)
     5113                   ,input ""
     5114                   ,INPUT-OUTPUT table tt-fin-doc
     5115                   ,INPUT-OUTPUT table ttc-fin-doc
     5116                   ,output table tt0-fin-doc-attr
     5117                   ,output v-limit-access ) no-error .
     5118   end.
     5119   else do:
     5120     run ref/finfnoco.p (
     5121                     INPUT parParentProc
     5122                   ,INPUT this-procedure:handle
     5123                   ,input p-curr-host-code
     5124                   ,input (p-mode  + chr(4) + 'manual':U)
     5125                   ,input p-host-code
     5126                   ,input p-doc-rec
     5127                   ,input tt-fin-doc.fin-doc-code
     5128                   ,input 'апр':U
     5129                   ,input tt-fin-doc.fin-ext-doc-type
     5130                   ,input tt-fin-doc.obj-type
     5131                   ,input tt-fin-doc.obj-code
     5132                   ,input tt-fin-doc.contract-code
     5133                   ,input p-ob-doc-code
     5134                   ,input 'орг':U
     5135                   ,input p-host-code
     5136                   ,input 0
     5137                   ,input tt-fin-doc.receiver-type
     5138                   ,input tt-fin-doc.receiver-code
     5139                   ,input 0
     5140                   ,input tt-fin-doc.curr-code
     5141                   ,input tt-fin-doc.cor-acc
     5142                   ,input tt-fin-doc.cor-acc1
     5143                   ,input tt-fin-doc.an-uchet-code
     5144                   ,input tt-fin-doc.cel-nazn-code
     5145                   ,input tt-fin-doc.CashBookId
     5146                   ,input ""
     5147                   ,INPUT-OUTPUT table ttc-fin-doc
     5148                   ,INPUT-OUTPUT table tt-fin-doc
     5149                   ,output table tt0-fin-doc-attr
     5150                   ,output v-limit-access ) no-error .
     5151   end.
     5152   if error-status:error then do:
     5153     if not return-value = "exit" then do:
     5154       message
     5155       vss-workfile vss-revision vss-description skip
     5156       error-status:get-message(1) skip
     5157       return-value
     5158       view-as alert-box .
     5159     end.
     5160     undo, return error.
     5161   end.
     5162   find first tt-fin-doc.
     5163   run recalc in this-procedure ( input "curr-code":U).
     5164   if p-mode = 'КОПИРОВАНИЕ':U then do:
     5165     assign
     5166     v-copy-mode = yes
     5167     p-mode = 'ДОБАВЛЕНИЕ':U.
     5168     if tt-fin-doc.curr-code = 0  then
     5169     run recalc in this-procedure  ( input "sum-doc").
     5170   end.
     5171   END PROCEDURE.
     5172   PROCEDURE Myenable :
     5173   define variable g-log as logical no-undo.
     5174   define variable v-inn like ub.firm.inn no-undo .
     5175   define variable v-kpp like ub.firm.kpp no-undo .
     5176   assign
     5177       tt-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     5178   .
     5179   run uf-get in this-procedure(
     5180       input  ('findoci-p':U + chr(4) + 'апр':U)
     5181       ,input  g#userid
     5182       ,output v-uf-List_
     5183       ,output v-uf-Naim
     5184       ,output v-uf-print-graft
     5185       ,output v-uf-sort-gr
     5186       ,output v-uf-type-price
     5187       ,output v-uf-type-val
     5188   )  no-error.
     5189   if not error-status:error
     5190   and not v-uf-LIst_ = "":U
     5191   then do:
     5192       assign
     5193       v-view =  entry(1, v-uf-List_, chr(4))
     5194       .
     5195   end.
     5196   assign
     5197   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     5198   tt-fin-doc.receiver-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     5199                                            "Чел" + chr(44) + 'чел':U
     5200   rs-view:radio-buttons = "&Полн." + chr(44) + "full":U +  chr(44) +
     5201                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     5202                                       "&Дог-р" + chr(44) + "contract":U
     5203   tt-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     5204                                       "Скл" + chr(44) + 'скл':U
     5205   rs-view = v-view
     5206   v-an-uchet-tab-order = (if X_sysconf.is-corr-acc then "cor-acc-value,b-cor-acc," else "":U) +
     5207                          (if X_sysconf.is-an-uchet then "an-uchet-value,b-an-uchet," else "":U) +
     5208                          (if X_sysconf.is-cassa-acc then "cor-acc1-value,b-cor-acc1," else "":U) +
     5209                          (if X_sysconf.is-code-cel-nazn then "cel-nazn-value,b-cel-nazn," else "":U)
     5210   v-an-uchet-tab-order = "cor-acc-value,b-cor-acc,"    +
     5211                          "an-uchet-value,b-an-uchet,"   +
     5212                          "cor-acc1-value,b-cor-acc1,"  +
     5213                          "cel-nazn-value,b-cel-nazn,"
     5214   v-limit-access = (if p-mode = 'ПРОСМОТР':U then 10 else v-limit-access)
     5215   tt-fin-doc.obj-type:screen-value  = (if tt-fin-doc.obj-type = 'маг':U
     5216                                       or tt-fin-doc.obj-type = 'скл':U
     5217                                       then tt-fin-doc.obj-type
     5218                                       else tt-fin-doc.obj-type:screen-value)
     5219   .
     5220   if p-mode = 'ПРОСМОТР':U and
     5221   tt-fin-doc.contract-code = 0 then do:
     5222       assign
     5223       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     5224       .
     5225       if rs-view = "contract":U then
     5226       assign
     5227       rs-view = "full":U
     5228       v-not-uf-set = yes.
     5229   end.
     5230   find first X_currency no-lock where
     5231                 X_currency.curr-code = tt-fin-doc.curr-code.
     5232   assign
     5233   f-curr-abbr = X_Currency.curr-abbr.
     5234   if p-mode = 'ДОБАВЛЕНИЕ':U and tt-fin-doc.contract-code = 0 then do:
     5235     assign
     5236     tt-fin-doc.receiver-type = (if tt-fin-doc.receiver-type = "":U then 'орг':U else tt-fin-doc.receiver-type)
     5237     .
     5238   end.
     5239   assign
     5240   v-head-position = (if num-entries(tt-fin-doc.payer-sign1, chr(4)) > 1
     5241                       then entry(1, tt-fin-doc.payer-sign1, chr(4))
     5242                       else "":U)
     5243   tt-fin-doc.payer-sign1:label  = tt-fin-doc.payer-sign1:label  + " - ":U +
     5244                             v-head-position
     5245   tt-fin-doc.payer-sign1 =   (if num-entries(tt-fin-doc.payer-sign1, chr(4)) > 1
     5246                                     then entry(2, tt-fin-doc.payer-sign1, chr(4))
     5247                                     else entry(1, tt-fin-doc.payer-sign1, chr(4)))
     5248   .
     5249   if p-mode = 'ПРОСМОТР':U then do:
     5250       run proc-color-widgets in this-procedure("f-an-uchet-descr,f-cel-nazn-descr,f-contract-curr-abbr,f-contract-date,f-contract-prn-code,f-contract-rate," +                         "f-contract-scale,f-contract-type,f-cor-acc1-descr,f-cor-acc-descr,base-rate,base-scale,curr-code,exch-rate,exch-scale," +                         "fact-date,fin-doc-code,receiver-code,receiver-type,perm-date,PS,payer-code,payer-type,sum-base,sum-rubl," +                         "user-name-doc,user-name-fact,user-name-perm", no, yes, ?, ?).
     5251       run proc-color-widgets in this-procedure("F-curr-abbr,an-uchet-value,cel-nazn-value,cor-acc1-value,cor-acc-value,doc-date," +                       "naznach-plat,receiver-name,prn-doc-code,payer-name,payer-okpo,payer-sign1,receiver-sign1" +                       "str-podr-code,str-podr-name,str-podr-type,sum-doc", no, yes, ?, ?).
     5252   end.
     5253   display
     5254   tt-fin-doc.exch-rate
     5255   tt-fin-doc.exch-scale
     5256   tt-fin-doc.sum-doc
     5257   (tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr ) @ f-rest-con-sum
     5258   tt-fin-doc.prn-doc-code
     5259   tt-fin-doc.receiver-name
     5260   tt-fin-doc.naznach-plat
     5261   tt-fin-doc.payer-sign1
     5262   tt-fin-doc.receiver-sign1
     5263   tt-fin-doc.PS
     5264   with frame Dialog-Frame
     5265   .
     5266   if tt-fin-doc.contract-code <> 0 then do:
     5267       find first X_contract-currency no-lock where
     5268                 X_contract-currency.curr-code = tt-fin-doc.contract-curr .
     5269       assign
     5270       f-contract-prn-code = X_contract.contract-prn-code
     5271       f-contract-date     = X_contract.contract-date
     5272       f-contract-type     = X_contract.contract-type
     5273       f-contract-curr-abbr = X_contract-currency.curr-abbr
     5274       .
     5275   end.
     5276   run change-view in this-procedure(rs-view).
     5277   VIEW FRAME Dialog-Frame.
     5278   if p-mode <> 'ПРОСМОТР':U then APPLY "ENTRY" to tt-fin-doc.prn-doc-code.
     5279   END PROCEDURE.
     5280   PROCEDURE proc-save :
     5281   define input parameter p-save as logical no-undo .
     5282   if p-mode = 'ПРОСМОТР':U or not available tt-fin-doc then do:
     5283       return error.
     5284   end.
     5285   assign
     5286   tt-fin-doc.prn-doc-code frame Dialog-Frame
     5287   tt-fin-doc.doc-date
     5288   tt-fin-doc.obj-code
     5289   tt-fin-doc.obj-type
     5290   tt-fin-doc.obj-type  = (if tt-fin-doc.obj-code = 0 then "":U else tt-fin-doc.obj-type)
     5291   tt-fin-doc.payer-name
     5292   tt-fin-doc.str-podr-type
     5293   tt-fin-doc.str-podr-code
     5294   tt-fin-doc.str-podr-name
     5295   tt-fin-doc.cor-acc1 = (if available X_fin-code-cor-acc1
     5296                          then X_fin-code-cor-acc1.fin-code
     5297                          else 0)
     5298   tt-fin-doc.cor-acc1-value = (if available X_fin-code-cor-acc1
     5299                          then X_fin-code-cor-acc1.code-value
     5300                          else "":U)
     5301   tt-fin-doc.cor-acc  = (if available X_fin-code-cor-acc
     5302                          then X_fin-code-cor-acc.fin-code
     5303                          else 0)
     5304   tt-fin-doc.cor-acc-value  = (if available X_fin-code-cor-acc
     5305                          then X_fin-code-cor-acc.code-value
     5306                          else "":U)
     5307   tt-fin-doc.an-uchet-code  = (if available X_fin-code-an-uchet
     5308                           then X_fin-code-an-uchet.fin-code
     5309                           else 0)
     5310   tt-fin-doc.an-uchet-value  = (if available X_fin-code-an-uchet
     5311                           then X_fin-code-an-uchet.code-value
     5312                           else "":U)
     5313   tt-fin-doc.cel-nazn-code  = (if available X_fin-code-cel-nazn
     5314                          then X_fin-code-cel-nazn.fin-code
     5315                          else 0)
     5316   tt-fin-doc.cel-nazn-value  = (if available X_fin-code-cel-nazn
     5317                          then X_fin-code-cel-nazn.code-value
     5318                          else "":U)
     5319   tt-fin-doc.curr-code
     5320   tt-fin-doc.contract-curr
     5321   tt-fin-doc.contract-rate
     5322   tt-fin-doc.contract-scale
     5323   tt-fin-doc.sum-doc
     5324   tt-fin-doc.receiver-code
     5325   tt-fin-doc.receiver-type
     5326   tt-fin-doc.receiver-name
     5327   tt-fin-doc.naznach-plat
     5328   tt-fin-doc.PS
     5329   tt-fin-doc.payer-sign1
     5330   tt-fin-doc.payer-sign1  =   v-head-position +  chr(4) + tt-fin-doc.payer-sign1
     5331   tt-fin-doc.receiver-sign1
     5332   .
     5333   if not p-save then return.
     5334   run check-sums-rate in this-procedure no-error.
     5335   if error-status:error then return error.
     5336   run ref/findoc0.p (
     5337   input-output p-doc-rec
