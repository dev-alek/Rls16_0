     2587   PROCEDURE check-receiver :
     2588     define buffer buf_clients for ub.clients.
     2589     find first buf_clients no-lock where
     2590       buf_clients.obj-code = input frame Dialog-Frame tt-fin-doc.receiver-code
     2591       and buf_clients.obj-type = input frame Dialog-Frame tt-fin-doc.receiver-type no-error.
     2592     if not available buf_clients then
     2593     do:
     2594       if input frame Dialog-Frame tt-fin-doc.receiver-code <> ?  then
     2595         message "Неправильный код или тип " 'ПОЛУЧАТЕЛЯ'.
     2596       apply "entry" to tt-fin-doc.receiver-code in frame Dialog-Frame.
     2597       return error.
     2598     end.
     2599     find first X_receiver no-lock where recid(X_receiver) = recid(buf_clients).
     2600     assign
     2601       tt-fin-doc.receiver-type = buf_clients.obj-type
     2602       tt-fin-doc.receiver-code = buf_clients.obj-code
     2603       tt-fin-doc.receiver-name = buf_clients.obj-name
     2604       .
     2605   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     2606   if ub.CashBook.cli-code = tt-fin-doc.receiver-code and ub.CashBook.cli-type = tt-fin-doc.receiver-type then do:
     2607   assign
     2608     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2609     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     2610     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     2611     .
     2612   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2613     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2614     and X_fin-code-cor-acc.status_ = integer('0':U)
     2615     no-error .
     2616   if available X_fin-code-cor-acc
     2617     then
     2618   do :
     2619     assign
     2620       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2621       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2622       .
     2623   end.
     2624   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2625     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2626     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2627     no-error .
     2628   if available X_fin-code-cor-acc1
     2629     then
     2630   do :
     2631     assign
     2632       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2633       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2634       .
     2635   end.
     2636   end.
     2637   else
     2638   do:
     2639   if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     2640   assign
     2641     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2642     .
     2643   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2644     and ub.CashBookRule.Obj-type   = 'всем':U
     2645     and ub.CashBookRule.Obj-code   = 0
     2646     and ub.CashBookRule.Code       = "corrPkoVne"
     2647     no-error.
     2648   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2649   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2650     and ub.CashBookRule.Obj-type   = 'всем':U
     2651     and ub.CashBookRule.Obj-code   = 0
     2652     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     2653     no-error.
     2654   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2655   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2656     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2657     and X_fin-code-cor-acc.status_ = integer('0':U)
     2658     no-error .
     2659   if available X_fin-code-cor-acc
     2660     then
     2661   do :
     2662     assign
     2663       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2664       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2665       .
     2666   end.
     2667   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2668     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2669     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2670     no-error .
     2671   if available X_fin-code-cor-acc1
     2672     then
     2673   do :
     2674     assign
     2675       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2676       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2677       .
     2678   end.
     2679   end.
     2680   else do:
     2681   if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     2682   assign
     2683     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2684     .
     2685   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2686     and ub.CashBookRule.Obj-type   = 'всем':U
     2687     and ub.CashBookRule.Obj-code   = 0
     2688     and ub.CashBookRule.Code       = "corrPkoAvans"
     2689     no-error.
     2690   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2691   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2692     and ub.CashBookRule.Obj-type   = 'всем':U
     2693     and ub.CashBookRule.Obj-code   = 0
     2694     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     2695     no-error.
     2696   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2697   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2698     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2699     and X_fin-code-cor-acc.status_ = integer('0':U)
     2700     no-error .
     2701   if available X_fin-code-cor-acc
     2702     then
     2703   do :
     2704     assign
