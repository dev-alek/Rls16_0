      920   function getCliKassa returns logical (input p-type as character, input p-code as integer, input p-attr as character, cashbookId as integer) :
      921   define buffer bf_CashBookRule  for ub.CashBookRule .
      922   define buffer buf_CashBookRule for ub.CashBookRule .
      923   find first bf_CashBookRule no-lock where bf_CashBookRule.CashBookID = cashbookId
      924     and bf_CashBookRule.Obj-type   = 'всем':U
      925     and bf_CashBookRule.Obj-code   = 0
      926     and bf_CashBookRule.Code       = p-attr + "-type"
      927     no-error.
      928   if available (bf_CashBookRule) then
      929   do:
      930     if p-type = bf_CashBookRule.RuleValue then
      931     do:
      932       find first buf_CashBookRule no-lock where buf_CashBookRule.CashBookID = cashbookId
      933         and buf_CashBookRule.Obj-type   = 'всем':U
      934         and buf_CashBookRule.Obj-code   = 0
      935         and buf_CashBookRule.Code       = p-attr + "-code"
      936         no-error.
      937       if available (buf_CashBookRule) then do:
      938           if p-code = integer(buf_CashBookRule.RuleValue) then return true .
      939       end.
      940     end.
      941   end.
      942   return false .
      943   end function .
      944   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
      945   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   procedure cur-time :
      947      define output parameter p-today as date      no-undo .
      948      define output parameter p-time  as integer   no-undo .
      949     do
      950     on error undo, return error
      951     :
      952       define variable v-date1 as date      no-undo .
      953       define variable v-date2 as date      no-undo .
      954       define variable v-time  as integer   no-undo .
      955       assign
      956         v-date1 = today
      957         v-time  = time
      958         v-date2 = today
      959       .
      960       if v-date1 <> v-date2
      961       then do:
      962         assign
      963           v-date1 = today
      964           v-time  = v-time
      965         .
      966       end.
      967       assign
      968         p-today = v-date1
      969         p-time  = v-time
      970       .
      971     end.
      972   end.
      973   function cur-time-date returns character
      974   :
      975     return string(today, '99/99/9999':U) .
      976   end.
      977   function cur-time-mjd returns decimal
      978   :
      979     define variable v-date as date      no-undo .
      980     define variable v-time as integer   no-undo .
      981     run cur-time in this-procedure
      982       (output v-date
      983       ,output v-time
      984       ) .
      985     return integer(v-date) - 2400002 + (v-time / 86400) .
      986   end.
      987   function cur-time-get-ending-index returns integer
      988   (input p-number as integer
      989   )
      990   :
      991     if p-number < 0
      992     or p-number = ?
      993     then do:
      994       return 1 .
      995     end.
      996     define variable v-rest as integer   no-undo .
      997     assign
      998       p-number = p-number modulo 100
      999     .
     1000     if p-number < 20
     1001     then do:
     1002       assign
     1003         v-rest = p-number
     1004       .
     1005     end.
     1006     else do:
     1007       assign
     1008         v-rest = p-number modulo 10
     1009       .
     1010     end.
     1011     case v-rest :
     1012       when 1
     1013       then do:
     1014         return 2 .
     1015       end.
     1016       when 2 or
     1017       when 3 or
     1018       when 4
     1019       then do:
     1020         return 3 .
     1021       end.
     1022       otherwise do:
     1023         return 1 .
     1024       end.
     1025     end case .
     1026   end.
     1027   procedure cur-time-mjd-to-date :
     1028      define input  parameter i-mjd-diff as decimal no-undo.
     1029      define output parameter o-Date     as date    no-undo.
     1030      define output parameter o-Time     as integer no-undo.
     1031      define variable v-day-number as integer   no-undo .
     1032      if    i-mjd-diff < 0
     1033         or i-mjd-diff = ?
     1034      then do:
     1035         return "?" .
     1036      end.
     1037      assign
     1038         v-day-number = truncate(i-mjd-diff,0).
     1039         o-Date = date(v-day-number + 2400002).
     1040         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1041     .
     1042   end.
     1043   function cur-time-mjd-to-string returns character
     1044   (input p-mjd-diff as decimal
     1045   )
     1046   :
     1047     define variable v-day-number as integer   no-undo .
     1048     define variable v-seconds    as integer   no-undo .
     1049     define variable v-hour       as integer   no-undo .
     1050     define variable v-min        as integer   no-undo .
     1051     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1052     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1053     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1054     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1055     if p-mjd-diff < 0
     1056     or p-mjd-diff = ?
     1057     then do:
     1058       return "?" .
     1059     end.
     1060     assign
     1061       v-day-number = integer(truncate(p-mjd-diff,0))
     1062       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1063     .
     1064     if v-seconds > 86400
     1065     then do:
     1066       assign
     1067         v-seconds = 86400 - 1
     1068       .
     1069     end.
     1070     if v-seconds < 0
     1071     then do:
     1072       assign
     1073         v-seconds = 0
     1074       .
     1075     end.
     1076     assign
     1077       v-hour = truncate(v-seconds / 3600, 0)
     1078     .
     1079     assign
     1080       v-seconds = v-seconds modulo 3600
     1081     .
     1082     assign
     1083       v-min = truncate(v-seconds / 60, 0)
     1084     .
     1085     assign
     1086       v-seconds = v-seconds modulo 60
     1087     .
     1088     return
     1089         (if v-day-number <> 0
     1090           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1091           else ""
     1092         )
     1093       + (if v-day-number <> 0 or v-hour <> 0
     1094           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1095           else ""
     1096         )
     1097       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1098           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1099           else ""
     1100         )
     1101       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1102       .
     1103   end.
     1104   function cur-time-string returns character
     1105   :
     1106     define variable v-date as date      no-undo .
     1107     define variable v-time as integer   no-undo .
     1108     run cur-time in this-procedure
     1109       (output v-date
     1110       ,output v-time
     1111       ) .
     1112     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1113   end.
     1114   function cur-time-string-sec returns character
     1115   :
     1116     define variable v-date as date      no-undo .
     1117     define variable v-time as integer   no-undo .
     1118     run cur-time in this-procedure
     1119       (output v-date
     1120       ,output v-time
     1121       ) .
     1122     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1123   end.
     1124   function cur-time-custom  returns character
     1125   (input p-prefix as character
     1126   ,input p-date-format as character
     1127   ,input p-delimiter as character
     1128   ,input p-time-format as character
     1129   ,input p-suffix as character
     1130   )
     1131   :
     1132     define variable v-date as date      no-undo .
     1133     define variable v-time as integer   no-undo .
     1134     run cur-time in this-procedure
     1135       (output v-date
     1136       ,output v-time
     1137       ) .
     1138     return
     1139       p-prefix
     1140       + string(v-date, p-date-format)
     1141       + p-delimiter
     1142       + string(v-time, p-time-format)
     1143       + p-suffix
     1144       .
     1145   end.
     1146   function cur-time-print  returns character
     1147   :
     1148     define variable v-date as date      no-undo .
     1149     define variable v-time as integer   no-undo .
     1150     run cur-time in this-procedure
     1151       (output v-date
     1152       ,output v-time
     1153       ) .
     1154     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1155   end.
     1156   function cur-time-datetime returns datetime
     1157   :
     1158     define variable v-char as character no-undo .
     1159     define variable v-datetime as datetime no-undo .
