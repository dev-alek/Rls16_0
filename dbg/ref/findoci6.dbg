     1997   PROCEDURE check-obj :
     1998     define input parameter p-check-obj-type as character no-undo .
     1999     define input parameter p-check-obj-code as integer no-undo .
     2000     define variable v-obj-db-num as integer no-undo init -1.
     2001     define variable v-cash-book  as integer no-undo .
     2002     define buffer buf_clients for ub.clients.
     2003     find first buf_clients no-lock where
     2004       buf_clients.obj-code = p-check-obj-code
     2005       and buf_clients.obj-type = p-check-obj-type no-error.
     2006     if not available buf_clients then
     2007     do:
     2008       if p-check-obj-code <> ?  then
     2009         message "Неправильный код или тип объекта" .
     2010       apply "entry" to tt-fin-doc.obj-code in frame Dialog-Frame.
     2011       return error.
     2012     end.
     2013     find first X_clients-obj no-lock where recid(X_clients-obj) = recid(buf_clients).
     2014     assign
     2015       tt-fin-doc.obj-type = buf_clients.obj-type
     2016       tt-fin-doc.obj-code = buf_clients.obj-code
     2017       .
     2018     display
     2019       tt-fin-doc.obj-type
     2020       tt-fin-doc.obj-code
     2021       with frame Dialog-Frame.
