     3341   ON CHOOSE OF B-currency IN FRAME Dialog-Frame
     3342     DO:
     3343       define variable rr          as recid no-undo.
     3344       define variable v-curr-code like ub.fin-doc.curr-code no-undo.
     3345   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3346   if lookup(self :type
     3347            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3348            ) = 0
     3349   then do:
     3350     message
     3351       "$Workfile$"
     3352       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3353       "Интерфейсный элемент" self :name  skip
     3354       "Тип" self :type  skip
     3355       "Процедура" this-procedure :file-name skip
     3356       view-as alert-box .
     3357   end.
     3358   else do:
     3359     apply "entry":u to self  .
     3360     if focus :handle <> self :handle  then do:
     3361       return no-apply .
     3362     end.
     3363   end.
     3364   assign
     3365     v-curr-code = tt-fin-doc.curr-code
     3366     tt-fin-doc.curr-code.
     3367   if available X_currency then rr = recid(X_currency).
     3368   else rr = ?.
     3369   run ref/currency.w (parparentproc, "b-sel", input-output rr ).
     3370   if rr <> ? then
     3371   do:
     3372     FIND FIRST X_currency WHERE
     3373       recid( X_currency ) = rr NO-LOCK .
     3374     assign
     3375       tt-fin-doc.curr-code = X_currency.curr-code
     3376       f-curr-abbr          = X_currency.curr-abbr
     3377       .
     3378     DISPLAY
     3379       tt-fin-doc.curr-code
     3380       f-curr-abbr
     3381       with frame Dialog-Frame .
     3382   end.
     3383   if tt-fin-doc.curr-code <> v-curr-code then
     3384   do:
     3385     run recalc in this-procedure("curr-code":U) no-error.
     3386     if error-status:error then
     3387     do:
     3388       assign
     3389         tt-fin-doc.curr-code = v-curr-code
     3390         .
     3391       display tt-fin-doc.curr-code
     3392         with frame Dialog-Frame.
     3393     end.
     3394     run hide-view-currency in this-procedure .
     3395   end.
     3396   END.
