     4282     if tt-fin-doc.sum-base:visible in frame Dialog-Frame then
     4283       display
     4284         tt-fin-doc.sum-base
     4285         tt-fin-doc.base-rate
     4286         tt-fin-doc.base-scale
     4287         with frame Dialog-Frame.
     4288     if tt-fin-doc.sum-contr:visible in frame Dialog-Frame then
     4289       display
     4290         tt-fin-doc.sum-contr
     4291         tt-fin-doc.contract-rate
     4292         tt-fin-doc.contract-scale
     4293         with frame Dialog-Frame.
     4294     if not v-first-start then
     4295       run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     4296   END PROCEDURE.
     4297   procedure proc-create-default-tax :
     4298     do
     4299       on error undo, return error
     4300       :
     4301       If p-mode = 'ДОБАВЛЕНИЕ':U then
     4302       do:
     4303         if p-ob-doc-code = "" then
     4304         do:
     4305           find tt0-fin-doc-tax where
     4306             tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4307             AND tt0-fin-doc-tax.host-code = tt-fin-doc.host-code no-error .
     4308           if not avail tt0-fin-doc-tax
     4309             and not AMBIGUOUS tt0-fin-doc-tax
     4310             then
     4311           do:
     4312             create tt0-fin-doc-tax.
     4313           end.
     4314           if AMBIGUOUS tt0-fin-doc-tax then return.
     4315           assign
     4316             tt0-fin-doc-tax.fin-doc-code     = tt-fin-doc.fin-doc-code
     4317             tt0-fin-doc-tax.host-code        = tt-fin-doc.host-code
     4318             tt0-fin-doc-tax.line-num         = 1
     4319             tt0-fin-doc-tax.slt-pc           = 0
     4320             tt0-fin-doc-tax.sum-line-doc     = tt-fin-doc.sum-doc
     4321             tt0-fin-doc-tax.sum-slt-line-doc = 0
     4322             tt0-fin-doc-tax.with-slt         = no
     4323             .
     4324           case paramVne:
     4325             when "vne" then do:
     4326             assign
     4327               tt0-fin-doc-tax.sum-vat-line-doc = 0
     4328               tt0-fin-doc-tax.vat-pc           = -1
     4329               tt0-fin-doc-tax.with-vat         = no
     4330               .
     4331             end.
     4332             when "avans" then do:
     4333             assign
     4334               tt0-fin-doc-tax.vat-pc           = 22
     4335               tt0-fin-doc-tax.sum-vat-line-doc = (tt-fin-doc.sum-doc * tt0-fin-doc-tax.vat-pc)/(100 + tt0-fin-doc-tax.vat-pc)
     4336               tt0-fin-doc-tax.with-vat         = yes
     4337               .
     4338             end.
     4339             otherwise do:
     4340             assign
     4341               tt0-fin-doc-tax.sum-vat-line-doc = 0
     4342               tt0-fin-doc-tax.vat-pc           = 0
     4343               tt0-fin-doc-tax.with-vat         = no
     4344               .
     4345             end.
     4346           end case .
     4347           release tt0-fin-doc-tax.
     4348         end.
     4349       end.
     4350     end.
     4351   end procedure.
     4352   procedure proc-update-sum-vat-chr :
     4353     define input-output parameter p-start as integer no-undo .
     4354     define variable v-sum-vat      like ub.fin-doc-tax.sum-vat-line-doc no-undo .
     4355     define variable v-sum-vat-chr  as character no-undo .
     4356     define variable v-each-vat-chr as character no-undo.
     4357     define variable v-vat-pc       as integer no-undo .
     4358   end procedure.
     4359   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4360   on help of frame Dialog-Frame
     4361   do:
     4362     run gbl/app_help.p
     4363       (input this-procedure :file-name
     4364       ,input ''
     4365       ,input ?
     4366       ) no-error.
     4367     if error-status :error then do:
     4368       message
     4369         "Ошибка при вызове помощи"
     4370         error-status :get-message(1)
     4371         view-as alert-box .
     4372     end.
     4373   end.
     4374   run minbtn-set in this-procedure .
     4375   on choose of b-help in frame Dialog-Frame
     4376   do:
     4377     apply "help":u to frame Dialog-Frame .
     4378   end.
     4379   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4380   procedure minbtn-set :
     4381       do
     4382           on error undo, return error return-value
     4383           :
     4384           define variable ii              as integer       no-undo .
     4385           define variable fh              as widget-handle no-undo .
     4386           define variable hh              as widget-handle no-undo .
     4387           define variable v-h             as handle        extent 4 no-undo .
     4388           define variable v-name-button   as character     no-undo .
     4389           define variable v-help-old-x    as decimal       no-undo .
     4390           define variable v-help-old-y    as decimal       no-undo .
     4391           define variable v-help-old-size as decimal       no-undo .
     4392           define variable v-frame-width   as decimal       no-undo .
     4393           define variable jj              as integer       no-undo .
     4394           do
     4395               on error undo, return error
     4396               :
     4397               assign
     4398                   v-frame-width = frame Dialog-Frame:width - 0.3
     4399                   fh            = frame Dialog-Frame:first-child
     4400                   hh            = fh:first-child
     4401                   ii            = 1
     4402                   .
     4403               do while valid-handle(hh):
     4404                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4405                   do:
     4406                       case lc(hh:name) :
     4407                           when "b-help" then
     4408                               do:
     4409                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4410                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4411                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4412                                   hh:TOOLTIP = "Помощь" .
     4413                                   v-help-old-x = hh:column .
     4414                                   v-help-old-y = hh:row    .
     4415                                   v-help-old-size = hh:width .
     4416                                   hh:width-chars = 2.5 .
     4417                               end.
     4418                           when "b-print" then
     4419                               do:
     4420                                   hh:load-image("cmp/b-print.bmp":u) .
     4421                                   hh:TOOLTIP = "Печать" .
     4422                                   v-h[ii] = hh:handle .
     4423                                   ii = ii + 1 .
     4424                                   hh:width-chars = 3 .
     4425                               end.
     4426                           when "b-history" or
     4427                           when "b-hist" then
     4428                               do:
     4429                                   hh:load-image("cmp/b-hist.bmp":u) .
     4430                                   hh:TOOLTIP = "История" .
     4431                                   v-h[ii] = hh:handle .
     4432                                   ii = ii + 1 .
     4433                                   hh:width-chars = 3 .
     4434                               end.
     4435                           when "b-sch" then
     4436                               do:
     4437                                   hh:load-image("cmp/b-sch.bmp":u) .
     4438                                   hh:TOOLTIP = "Установка Фильтра" .
     4439                                   v-h[ii] = hh:handle .
     4440                                   ii = ii + 1 .
     4441                                   hh:width-chars = 3 .
     4442                               end.
     4443                           when "b-hist-user" then
     4444                               do:
     4445                                   hh:load-image("cmp/b-hist.bmp":u) .
     4446                                   hh:TOOLTIP = "История пользователя" .
     4447                                   ii = ii + 1 .
     4448                               end.
     4449                       end case.
     4450                   end.
     4451                   hh = hh:next-sibling.
     4452               end.
     4453               b-help:column = v-frame-width - b-help:width-chars.
     4454               jj = 0.
     4455               repeat ii = 4 to 1 by -1 :
     4456                   if valid-handle (v-h[ii] ) then
     4457                   do:
     4458                       jj  = jj + 1 .
     4459                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4460                       v-h[ii]:row    = v-help-old-y .
     4461                   end.
     4462               end.
     4463           end.
     4464       end.
     4465   end procedure.
     4466   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4467   ON TAB ANYWHERE
     4468   DO:
     4469   define variable ii as integer no-undo .
     4470   define variable fh as widget-handle no-undo .
     4471   define variable hh as widget-handle no-undo .
     4472   define variable v-next-widget-name as character no-undo .
     4473   if v-tab-order <> '' then do:
     4474     if self:type = "TOGGLE-BOX" then
     4475     self:BGCOLOR = ?.
     4476     assign
     4477     ii = lookup(self:name, v-tab-order).
     4478     assign
     4479     ii = ii + 1
     4480     v-next-widget-name = entry(ii, v-tab-order)
     4481     no-error .
     4482     if error-status:error then do:
     4483       assign
     4484       ii = 1
     4485       v-next-widget-name = entry( ii, v-tab-order)
     4486       .
     4487     end.
     4488     assign
     4489     fh = frame Dialog-Frame:first-child
     4490     hh = fh:first-child
     4491     .
     4492     do while valid-handle(hh):
     4493       if hh:name = v-next-widget-name then do:
     4494         if hh:sensitive  = yes
     4495         AND hh:visible = yes then do:
     4496           if hh:type = "TOGGLE-BOX":U then do:
     4497             assign
     4498             hh:BGcolor = 1
     4499             .
     4500           end.
     4501           APPLY "ENTRY" to hh.
     4502           return no-apply.
     4503         end.
     4504         else do:
     4505           APPLY "TAB" to hh.
     4506           return no-apply.
     4507         end.
     4508       end.
     4509       hh = hh:next-sibling.
     4510     end.
     4511   end.
     4512   END.
     4513   ON BACK-TAB ANYWHERE
     4514   DO:
     4515   define variable ii as integer no-undo .
     4516   define variable fh as widget-handle no-undo .
     4517   define variable hh as widget-handle no-undo .
     4518   define variable v-next-widget-name as character no-undo .
     4519   if v-tab-order <> '' then do:
     4520     assign
     4521     ii = lookup(self:name, v-tab-order).
     4522     .
     4523     assign
     4524     ii = (if ii = 1
     4525           then  num-entries(v-tab-order)
     4526           else ii - 1
     4527           )
     4528     v-next-widget-name = entry(ii, v-tab-order)
     4529     .
     4530     assign
     4531     fh = frame Dialog-Frame:first-child
     4532     hh = fh:first-child
     4533     .
     4534     do while valid-handle(hh):
     4535       if hh:name = v-next-widget-name then do:
     4536         if hh:sensitive  = yes
     4537         AND hh:visible = yes then do:
     4538           if hh:type = "TOGGLE-BOX":U then do:
     4539             assign
     4540             hh:BGcolor = 1
     4541             .
     4542           end.
     4543           APPLY "ENTRY" to hh.
     4544           return no-apply.
     4545         end.
     4546         else do:
     4547         APPLY "BACK-TAB" to hh.
     4548         return no-apply.
     4549         end.
     4550       end.
     4551       hh = hh:next-sibling.
     4552     end.
     4553     end.
     4554   END.
     4555   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4556   ON RETURN ANYWHERE
     4557   DO:
     4558   define variable ii as integer no-undo .
     4559   define variable fh as widget-handle no-undo .
     4560   define variable hh as widget-handle no-undo .
     4561   define variable v-next-widget-name as character no-undo .
     4562     if v-tab-order <> '' then do:
     4563       assign
     4564       ii = lookup(self:name, v-tab-order).
     4565       if ii = num-entries(v-tab-order) then do:
     4566           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     4567           return no-apply.
     4568       end.
     4569       if self:type <> "BUTTON" and
     4570         self:type <> "EDITOR"  then do:
     4571         run proc-move-forward in this-procedure .
     4572         return no-apply.
     4573       end.
     4574       if self:type = "BUTTON" then do:
     4575         APPLY "CHOOSE" to self.
     4576       end.
     4577       if self:type = "TOGGLE-BOX" then
     4578       self:BGCOLOR = ?.
     4579       assign
     4580       ii = ii + 1
     4581       v-next-widget-name = entry(ii, v-tab-order)
     4582       no-error .
     4583       if error-status:error then do:
     4584         assign
     4585         ii = 1
     4586         v-next-widget-name = entry( ii, v-tab-order)
     4587         .
     4588       end.
     4589       assign
     4590       fh = frame Dialog-Frame:first-child
     4591       hh = fh:first-child
     4592       .
     4593       do while valid-handle(hh):
     4594         if hh:name = v-next-widget-name then do:
     4595           if hh:sensitive  = yes
     4596           AND hh:visible = yes then do:
     4597             if hh:type = "TOGGLE-BOX":U then do:
     4598               assign
     4599               hh:BGcolor = 1
     4600               .
     4601             end.
     4602             APPLY "ENTRY" to hh.
     4603             return no-apply.
     4604           end.
     4605           else do:
     4606             APPLY "TAB" to hh.
     4607             return no-apply.
     4608           end.
     4609         end.
     4610         hh = hh:next-sibling.
     4611       end.
     4612     end.
     4613   END.
     4614   procedure proc-move-forward :
     4615   define variable ii as integer no-undo .
     4616   define variable fh as widget-handle no-undo .
     4617   define variable hh as widget-handle no-undo .
     4618   define variable v-next-widget-name as character no-undo .
     4619   do
     4620   on error undo, return error
     4621   :
     4622     if v-tab-order <> '' then do:
     4623       if self:type = "TOGGLE-BOX" then
     4624       self:BGCOLOR = ?.
     4625       assign
     4626       ii = lookup(self:name, v-tab-order).
     4627       assign
     4628       ii = ii + 1
     4629       v-next-widget-name = entry(ii, v-tab-order)
     4630       no-error .
     4631       if error-status:error then do:
     4632         assign
     4633         ii = 1
     4634         v-next-widget-name = entry( ii, v-tab-order)
     4635         .
     4636       end.
     4637       assign
     4638       fh = frame Dialog-Frame:first-child
     4639       hh = fh:first-child
     4640       .
     4641       do while valid-handle(hh):
     4642         if hh:name = v-next-widget-name then do:
     4643           if hh:sensitive  = yes
     4644           AND hh:visible = yes then do:
     4645             if hh:type = "TOGGLE-BOX":U then do:
     4646               assign
     4647               hh:BGcolor = 1
     4648               .
     4649             end.
     4650             APPLY "ENTRY" to hh.
     4651             return.
     4652           end.
     4653           else do:
     4654             assign
     4655             ii = ii + 1
     4656             v-next-widget-name = entry(ii, v-tab-order)
     4657             no-error .
     4658             if error-status:error then do:
     4659               assign
     4660               ii = 1
     4661               v-next-widget-name = entry( ii, v-tab-order)
     4662               .
     4663             end.
     4664           end.
     4665         end.
     4666         hh = hh:next-sibling.
     4667       end.
     4668     end.
     4669   end.
     4670   end procedure.
