      546   procedure uf-get :
      547     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      548     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      549     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      550     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      551     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      552     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      553     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      554     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      555     do
      556     on error undo, return error
      557     :
      558       define buffer buf_usr-flt for ubflt.usr-flt .
      559       define variable v-use-List_     as logical   no-undo .
      560       define variable v-type-List_     as character no-undo .
      561       define variable v-format-List_   as character no-undo .
      562       define variable v-use-Naim      as logical   no-undo .
      563       define variable v-type-Naim      as character no-undo .
      564       define variable v-format-Naim    as character no-undo .
      565       define variable v-use-print-graft as logical   no-undo .
      566       define variable v-use-sort-gr     as logical   no-undo .
      567       define variable v-use-type-price  as logical   no-undo .
      568       define variable v-use-type-val    as logical   no-undo .
      569       define variable v-label          as character no-undo .
      570       define variable v-tooltip        as character no-undo .
      571       define variable v-user-can-edit  as logical   no-undo .
      572       define variable v-output-display as logical   no-undo .
      573       define variable v-other          as character no-undo .
      574       run uf-name in this-procedure
      575          (input  entry(1, p-code, chr(4))
      576         ,output v-use-List_
      577         ,output v-type-List_
      578         ,output v-format-List_
      579         ,output v-use-Naim
      580         ,output v-type-Naim
      581         ,output v-format-Naim
      582         ,output v-use-print-graft
      583         ,output v-use-sort-gr
      584         ,output v-use-type-price
      585         ,output v-use-type-val
      586         ,output v-label
      587         ,output v-tooltip
      588         ,output v-user-can-edit
      589         ,output v-output-display
      590         ,output v-other
      591         ) no-error .
      592       if error-status :error then do:
      593         undo, return error return-value .
      594       end.
      595       find first buf_usr-flt no-lock where
      596                  buf_usr-flt.Call-point     = p-code AND
      597                  buf_usr-flt.user-name       = p-user-name
      598         no-error .
      599       if avail buf_usr-flt then do:
      600         assign
      601         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      602         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      603         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      604         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      605         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      606         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      607         .
      608       end.
      609       else do:
      610         assign
      611         p-List_        = (if v-use-List_       then "":U                    else ?)
      612         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      613         p-print-graft  = (if v-use-print-graft then no                      else ?)
      614         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      615         p-type-price   = (if v-use-type-price  then no                      else ?)
      616         p-type-val     = (if v-use-List_       then no                      else ?)
      617         .
      618       end.
      619     end.
      620   end procedure.
      621   procedure uf-set :
      622     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      623     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      624     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      625     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      626     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      627     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      628     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      629     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      630     do
      631     on error undo, return error
      632     :
      633       define buffer buf_usr-flt for ubflt.usr-flt .
      634       define variable v-use-List_     as logical   no-undo .
      635       define variable v-type-List_     as character no-undo .
      636       define variable v-format-List_   as character no-undo .
      637       define variable v-use-Naim      as logical   no-undo .
      638       define variable v-type-Naim      as character no-undo .
      639       define variable v-format-Naim    as character no-undo .
      640       define variable v-use-print-graft as logical   no-undo .
      641       define variable v-use-sort-gr   as logical   no-undo .
      642       define variable v-use-type-price as logical   no-undo .
      643       define variable v-use-type-val  as logical   no-undo .
      644       define variable v-tooltip        as character no-undo .
      645       define variable v-label          as character no-undo .
      646       define variable v-user-can-edit  as logical   no-undo .
      647       define variable v-output-display as logical   no-undo .
      648       define variable v-other          as character no-undo .
      649       run uf-name in this-procedure
      650         (input  entry(1, p-code, chr(4))
      651         ,output v-use-List_
      652         ,output v-type-List_
      653         ,output v-format-List_
      654         ,output v-use-Naim
      655         ,output v-type-Naim
      656         ,output v-format-Naim
      657         ,output v-use-print-graft
      658         ,output v-use-sort-gr
      659         ,output v-use-type-price
      660         ,output v-use-type-val
      661         ,output v-label
      662         ,output v-tooltip
      663         ,output v-user-can-edit
      664         ,output v-output-display
      665         ,output v-other
      666         ) no-error .
      667       if error-status :error then do:
      668         undo, return error return-value .
      669       end.
      670       find first buf_usr-flt where
      671                  buf_usr-flt.Call-point     = p-code AND
      672                  buf_usr-flt.user-name       = p-user-name
      673         no-error .
      674       if not avail buf_usr-flt then do:
      675           create buf_usr-flt .
      676           assign
      677           buf_usr-flt.call-point = p-code
      678           buf_usr-flt.user-name  = p-user-name
      679           .
      680       end.
      681       if avail buf_usr-flt then do:
      682        assign
      683        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      684        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      685        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      686        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      687        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      688        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      689       .
      690       release buf_usr-flt.
      691       end.
      692       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      693     end.
      694   end procedure.
      695   function diff-list returns character (
      696     input parfirst-list  as character,
      697     input parsecond-list as character,
      698     input pardelim       as character).
      699     if pardelim = ""
      700     or pardelim = ?
      701     then do:
      702       assign
      703         pardelim = ","
      704       .
      705     end.
      706     def var ind as integer no-undo .
      707     def var v-elem as character no-undo .
      708     def var v-result-list as character no-undo init "".
      709     def var v-num-parfirst-list as integer no-undo .
      710     assign
      711       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      712     .
      713     do ind = 1 to v-num-parfirst-list
      714     :
      715       assign
      716         v-elem = entry(ind, parfirst-list, pardelim)
      717       .
      718       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      719         assign
      720           v-result-list = v-result-list
      721                         + (if v-result-list > "" then pardelim else "")
      722                         + v-elem
      723         .
      724       end.
      725     end.
      726     return v-result-list .
      727   end function.
      728   function add-list returns character (
      729    input parfirst-list  as character,
      730    input parsecond-list as character,
      731    input pardelim       as character).
      732     if pardelim = ""
      733     or pardelim = ?
      734     then do:
      735       assign
      736         pardelim = ","
      737       .
      738     end.
      739     def var ind as integer no-undo .
      740     def var v-elem as character no-undo .
      741     def var v-result-list as character no-undo init "".
      742     def var v-num-parfirst-list as integer no-undo .
      743     assign
      744       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      745     .
      746     do ind = 1 to v-num-parfirst-list
      747     :
      748       assign
      749         v-elem = entry(ind, parfirst-list, pardelim)
      750       .
      751       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      752         assign
      753           v-result-list = v-result-list
      754                         + (if v-result-list > "" then pardelim else "")
      755                         + v-elem
      756         .
      757       end.
      758     end.
      759     def var v-num-parsecond-list as integer no-undo .
      760     assign
      761       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      762     .
      763     do ind = 1 to v-num-parsecond-list
      764     :
      765       assign
      766         v-elem = entry(ind, parsecond-list, pardelim)
      767       .
      768       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      769         assign
      770           v-result-list = v-result-list
      771                         + (if v-result-list > "" then pardelim else "")
      772                         + v-elem
      773         .
      774       end.
      775     end.
      776     return v-result-list .
      777   end function.
      778   function cross-list returns character (
      779    input parfirst-list  as character,
      780    input parsecond-list as character,
      781    input pardelim       as character).
      782     if pardelim = ""
      783     or pardelim = ?
      784     then do:
      785       assign
      786         pardelim = ","
      787       .
      788     end.
      789     def var ind as integer no-undo .
      790     def var v-elem as character no-undo .
      791     def var v-result-list as character no-undo init "".
      792     def var v-num-parfirst-list as integer no-undo .
      793     assign
      794       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      795     .
      796     do ind = 1 to v-num-parfirst-list
      797     :
      798       assign
      799         v-elem = entry(ind, parfirst-list, pardelim)
      800       .
      801       if lookup(v-elem, v-result-list, pardelim) = 0
      802       and lookup(v-elem, parsecond-list, pardelim) > 0
      803       then do:
      804         assign
      805           v-result-list = v-result-list
      806                         + (if v-result-list > "" then pardelim else "")
      807                         + v-elem
      808         .
      809       end.
      810     end.
      811     return v-result-list .
      812   end function.
      813   function radio-label returns character (
      814    input par-rs-value  as character,
      815    input par-rs-radio-buttons as character)
      816    .
      817    DEFINE variable v-result-label as character no-undo.
      818    assign
      819    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      820                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      821                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      822                             ), par-rs-radio-buttons
      823                           )
      824    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      825    .
      826   return v-result-label.
      827   end function.
      828   function m-radio-label returns character (
      829    input par-rs-value  as character,
      830    input par-rs-radio-buttons as character,
      831    input par-delim as character
      832    )
      833    .
      834    DEFINE variable v-result-label as character no-undo.
      835    assign
      836    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      837                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      838                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      839                             ), par-rs-radio-buttons, par-delim
      840                           )
      841    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      842    .
      843   return v-result-label.
      844   end function.
      845   FUNCTION mixlist returns character
      846   (
      847    input parfirst-list  as character
      848    ,input parsecond-list as character
      849    ,input pardelim       as character
      850    ,input pardelim-result as character ) :
      851     if pardelim = ""
      852     or pardelim = ?
      853     then do:
      854       assign
      855         pardelim = ","
      856       .
      857     end.
      858     def var ind as integer no-undo .
      859     def var v-elem1 as character no-undo .
      860     def var v-elem2 as character no-undo .
      861     def var v-result-list as character no-undo init "".
      862     do ind = 1 to num-entries(parfirst-list, pardelim)
      863     :
      864       assign
      865         v-elem1 = entry(ind, parfirst-list, pardelim)
      866         v-elem2 = entry(ind, parsecond-list, pardelim)
      867       .
      868         assign
      869           v-result-list = v-result-list
      870                         + (if v-result-list > "" then pardelim-result else "")
      871                         + v-elem1 + pardelim-result + v-elem2
      872         .
      873     end.
      874     return v-result-list .
      875   END FUNCTION.
