     2080       v-dpt-option    = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "Struct") .
     2081       v-dpt-dflt-name = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptName") .
     2082       v-dpt-dflt-type = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptType") .
     2083       v-dpt-dflt-code = integer(mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptCode")) .
     2084       o-head-position = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerPosition") .
     2085       o-director      = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerFIO") .
     2086       o-snr-accnt     = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BuhFIO") .
     2087       delete object mCashBook no-error .
     2088       case v-dpt-option:
     2089         when "1" then
     2090           do:
     2091             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     2092             and ub.db-attr.attr-code = 'hist-code':U:
     2093               v-hist-code = ub.db-attr.attr-value .
     2094             end.
     2095             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     2096             and ub.db-attr.attr-code = 'hist-name':U:
     2097               v-hist-name = ub.db-attr.attr-value .
     2098             end.
     2099             if v-hist-code = "" then v-dpt-dflt-code = X_clients-obj.obj-code .
     2100             if v-hist-name = "" then v-dpt-dflt-name = X_clients-obj.obj-name .
     2101             v-dpt-dflt-type = X_clients-obj.obj-type  .
     2102           end.
     2103         when "0" then
     2104           do:
     2105             assign
     2106               v-dpt-dflt-name = ''
     2107               v-dpt-dflt-type = ''
     2108               v-dpt-dflt-code = 0
     2109               .
     2110           end.
     2111         otherwise
     2112         do:
     2113           assign
     2114             v-dpt-dflt-name = v-dpt-dflt-name
     2115             v-dpt-dflt-type = v-dpt-dflt-type
     2116             v-dpt-dflt-code = v-dpt-dflt-code
     2117             .
     2118         end.
     2119       end case.
     2120       find first buf_sysconf no-error .
     2121       case o-head-position:
     2122         when '0':U then
     2123           do:
     2124             v-head-position = buf_sysconf.head-position.
     2125           end.
     2126         when '1':U then
     2127           do:
     2128             v-head-position = "Директор".
     2129           end.
     2130         when '2':U then
     2131           do:
     2132             v-head-position = "Управляющий".
     2133           end.
     2134         otherwise
     2135         do :
     2136           v-head-position = o-head-position.
     2137         end.
     2138       end case.
     2139       find first buf_firm no-lock where
     2140         buf_firm.firm-code = buf_sysconf.host-code.
     2141       case o-director:
     2142         when '1':U then
     2143           do:
     2144             if p-obj-type = 'маг':U then
     2145             do:
     2146               find first buf_shop no-lock where
     2147                 buf_shop.obj-code = p-obj-code no-error .
     2148               if available buf_shop then
     2149               do:
     2150                 v-director = buf_shop.director.
     2151               end.
     2152             end.
     2153             if p-obj-type = 'скл':U then
     2154             do:
     2155               find first buf_store no-lock where
     2156                 buf_store.obj-code = p-obj-code no-error .
     2157               if available buf_store then
     2158               do:
     2159                 v-director = buf_store.store-boss.
     2160               end.
     2161             end.
     2162           end.
     2163         when '0':U then
     2164           do:
     2165             v-director = buf_firm.director.
     2166           end.
     2167         otherwise
     2168         do:
     2169           v-director = o-director .
     2170         end.
     2171       end case.
     2172       case o-snr-accnt:
     2173         when '1':U then
     2174           do:
     2175             if p-obj-type = 'маг':U then
     2176             do:
     2177               find first buf_shop no-lock where
     2178                 buf_shop.obj-code = p-obj-code no-error .
     2179               if available buf_shop then
     2180               do:
     2181                 v-snr-accnt = entry(1,buf_shop.acct,"|").
     2182               end.
     2183             end.
     2184             if p-obj-type = 'скл':U then
     2185             do:
     2186               v-snr-accnt = ''.
     2187             end.
     2188           end.
     2189         when '2':U then
     2190           do:
     2191             v-snr-accnt = buf_sysconf.snr-accnt.
     2192           end.
     2193         otherwise
     2194         do:
     2195           v-snr-accnt = o-snr-accnt .
     2196         end.
     2197       end case.
     2198     FIND FIRST ub.shift-staff No-LOCK WHERE
     2199       ub.shift-staff.obj-type   = p-obj-type AND
     2200       ub.shift-staff.obj-code   = p-obj-code AND
     2201       ub.shift-staff.shift-date = tt-fin-doc.shift-date AND
     2202       ub.shift-staff.shift-num  = tt-fin-doc.shift-num AND
     2203       ub.shift-staff.staff-role = no and
     2204       ub.shift-staff.psn-num    >= 0 No-ERROR.
     2205     assign
     2206       v-cashier = if available ub.shift-staff then string(ub.shift-staff.name, "X(30)") else "".
     2207     .
     2208     if tt-fin-doc.fin-ext-doc-type = 'рко':U then
     2209     do:
     2210       assign
     2211         tt-fin-doc.payer-sign1 = v-director
     2212         tt-fin-doc.payer-sign2 = v-snr-accnt
     2213         tt-fin-doc.payer-sign3 = v-cashier
     2214         .
     2215     end.
     2216     if tt-fin-doc.fin-ext-doc-type = 'пко':U then
     2217     do:
     2218       assign
     2219         tt-fin-doc.receiver-sign2 = v-snr-accnt
     2220         tt-fin-doc.receiver-sign3 = v-cashier
     2221         .
     2222     end.
     2223     find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.CashBookId no-error .
     2224     if available (ub.CashBook) then
     2225     do:
     2226       case ub.CashBook.RuleOsnRko:
     2227         when "0" then
     2228           tt-fin-doc.naznach-plat = "Выручка от реализации" .
     2229         when "1" or
     2230         when "2" then
     2231           tt-fin-doc.naznach-plat = "" .
     2232         otherwise
     2233         tt-fin-doc.naznach-plat = ub.CashBook.RuleOsnRko .
     2234       end case .
     2235       case ub.CashBook.RulePril:
     2236         when '0' then
     2237           do:
     2238             tt-fin-doc.enclosure = v-naznach-plat .
     2239           end.
     2240         when '1' then
     2241           do:
     2242             tt-fin-doc.enclosure = "" .
     2243           end.
     2244         otherwise
     2245         tt-fin-doc.enclosure = ub.CashBook.RulePril .
     2246       end case.
     2247       if ub.CashBook.CorrRko <> "" then
     2248       do:
     2249         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.CorrRko
     2250           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2251           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     2252           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2253         end.
     2254       end.
     2255       if tt-fin-doc.cor-acc = ? or tt-fin-doc.cor-acc = 0 then
     2256       do:
     2257         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     2258           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2259           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     2260           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2261         end.
     2262       end.
     2263       if ub.CashBook.OsnAcct <> "" then
     2264       do:
     2265         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     2266           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2267           tt-fin-doc.cor-acc1 = ub.fin-code-cor-acc.fin-code .
     2268           tt-fin-doc.cor-acc1-value = ub.fin-code-cor-acc.code-value .
     2269         end.
     2270       end.
     2271     end.
     2272     assign
     2273       tt-fin-doc.str-podr-name = if v-hist-name = "" then v-dpt-dflt-name else v-hist-name
     2274       tt-fin-doc.str-podr-type = v-dpt-dflt-type
     2275       tt-fin-doc.str-podr-code = v-dpt-dflt-code
     2276       .
     2277     display
     2278       tt-fin-doc.str-podr-name
     2279       tt-fin-doc.str-podr-type
     2280       tt-fin-doc.str-podr-code
     2281       tt-fin-doc.enclosure
     2282       tt-fin-doc.naznach-plat
     2283       tt-fin-doc.cor-acc
     2284       tt-fin-doc.cor-acc1
     2285       tt-fin-doc.cor-acc1-value
     2286       tt-fin-doc.cor-acc-value
     2287       with frame Dialog-Frame .
     2288     end.
     2289     else
     2290     do:
     2291       assign
     2292         tt-fin-doc.shift-flag = 0
     2293         .
     2294     end.
     2295   END PROCEDURE.
     2296   ON CHOOSE OF B-calc IN FRAME Dialog-Frame
     2297     DO:
     2298       run ref/findclci.w (
     2299         INPUT          parParentProc
     2300         ,input          "":U
     2301         ,INPUT          tt-fin-doc.doc-date
     2302         ,INPUT          tt-fin-doc.curr-code
     2303         ,INPUT          v-base-code
     2304         ,INPUT          tt-fin-doc.contract-curr
     2305         ,INPUT-OUTPUT   tt-fin-doc.sum-doc
     2306         ,INPUT-OUTPUT   tt-fin-doc.exch-rate
     2307         ,INPUT-OUTPUT   tt-fin-doc.exch-scale
     2308         ,INPUT-OUTPUT   tt-fin-doc.sum-rubl
     2309         ,INPUT-OUTPUT   tt-fin-doc.sum-base
     2310         ,INPUT-OUTPUT   tt-fin-doc.base-rate
     2311         ,INPUT-OUTPUT   tt-fin-doc.base-scale
     2312         ,INPUT-OUTPUT   tt-fin-doc.sum-contr
     2313         ,INPUT-OUTPUT   tt-fin-doc.contract-rate
     2314         ,INPUT-OUTPUT   tt-fin-doc.contract-scale ) no-error.
     2315       if error-status:error then return no-apply.
     2316       assign
     2317         f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     2318         .
     2319       display
     2320         tt-fin-doc.sum-rubl
     2321         when v-rubf
     2322         tt-fin-doc.sum-doc
     2323         tt-fin-doc.exch-rate
     2324         when v-exchf
     2325         tt-fin-doc.exch-scale
     2326         when v-exchf
     2327         tt-fin-doc.sum-base
     2328         when v-basef
     2329         tt-fin-doc.base-rate
     2330         when v-baseratef
     2331         tt-fin-doc.base-scale
     2332         when v-baseratef
     2333         tt-fin-doc.sum-contr
     2334         when v-contractf
     2335         tt-fin-doc.contract-rate
     2336         when v-contractratef
     2337         tt-fin-doc.contract-scale
     2338         when v-contractratef
     2339         f-rest-con-sum
     2340         with frame Dialog-Frame .
     2341     END.
     2342   ON CHOOSE OF B-receiver IN FRAME Dialog-Frame
     2343     DO:
     2344       define variable ref-list as character no-undo.
     2345       define variable ref-rec  as recid     no-undo.
     2346       define variable v-sum-vat-chr  as character no-undo .
     2347       define variable v-each-vat-chr as character no-undo.
     2348       define variable v-sum-vat      like ub.fin-doc-tax.sum-vat-line-doc no-undo .
     2349       define buffer buf_clients for ub.clients.
     2350   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2351   if lookup(self :type
     2352            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2353            ) = 0
     2354   then do:
     2355     message
     2356       "$Workfile$"
     2357       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2358       "Интерфейсный элемент" self :name  skip
     2359       "Тип" self :type  skip
     2360       "Процедура" this-procedure :file-name skip
     2361       view-as alert-box .
     2362   end.
     2363   else do:
     2364     apply "entry":u to self  .
     2365     if focus :handle <> self :handle  then do:
     2366       return no-apply .
     2367     end.
     2368   end.
     2369   run ref/cli-all.w ( parParentProc
     2370     ,"b-sel"
     2371     , tt-fin-doc.receiver-type
     2372     , ?
     2373     , ?
     2374     , (if available X_receiver then recid(X_receiver) else ?)
     2375     , ?
     2376     , "without-obj":U
     2377     , output ref-list) .
     2378   if ref-list = "" then
     2379   do:
     2380     return no-apply.
     2381   end.
     2382   ref-rec = integer( ref-list ).
     2383   FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     2384   if NOT (buf_clients.obj-type = 'орг':U
     2385     or
     2386     buf_clients.obj-type = 'чел':U ) then
     2387   do:
     2388     message
     2389       "Выберите контрагента типа" 'орг':U "или" 'чел':U
     2390       view-as alert-box error .
     2391     return no-apply.
     2392   end.
     2393   find first X_receiver no-lock where
     2394     recid(X_receiver) = recid(buf_clients).
     2395   assign
     2396     tt-fin-doc.receiver-type = buf_clients.obj-type
     2397     tt-fin-doc.receiver-code = buf_clients.obj-code
     2398     tt-fin-doc.receiver-name = buf_clients.obj-name
     2399     .
     2400   display
     2401     tt-fin-doc.receiver-type
     2402     tt-fin-doc.receiver-code
     2403     tt-fin-doc.receiver-name
     2404     with frame Dialog-Frame.
     2405   CASE X_receiver.obj-type:   when 'чел':U then do:              find first X_receiver-person no-lock where               X_receiver-person.psn-code = X_receiver.obj-code .   end.   when 'орг':U then do:     find first X_receiver-firm no-lock where               X_receiver-firm.firm-code = X_receiver.obj-code .   end. END CASE. assign tt-fin-doc.receiver-sign1  = if X_receiver.obj-type = 'орг':U                              then X_receiver-firm.director                             else X_receiver.obj-name . display tt-fin-doc.receiver-sign1 with frame Dialog-Frame.
     2406   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     2407   if ub.CashBook.cli-code = tt-fin-doc.receiver-code and ub.CashBook.cli-type = tt-fin-doc.receiver-type then do:
     2408   assign
     2409     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2410     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     2411     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     2412     .
     2413   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2414     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2415     and X_fin-code-cor-acc.status_ = integer('0':U)
     2416     no-error .
     2417   if available X_fin-code-cor-acc
     2418     then
     2419   do :
     2420     assign
     2421       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2422       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2423       .
     2424   end.
     2425   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2426     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2427     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2428     no-error .
     2429   if available X_fin-code-cor-acc1
     2430     then
     2431   do :
     2432     assign
     2433       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2434       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2435       .
     2436   end.
     2437   assign
     2438     tt-fin-doc.including = "@, в том числе НДС" .
     2439     paramVne = "" .
     2440   end.
     2441   else
     2442   do:
     2443     if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     2444   assign
     2445     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2446     .
     2447   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2448     and ub.CashBookRule.Obj-type   = 'всем':U
     2449     and ub.CashBookRule.Obj-code   = 0
     2450     and ub.CashBookRule.Code       = "corrPkoVne"
     2451     no-error.
     2452   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2453   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2454     and ub.CashBookRule.Obj-type   = 'всем':U
     2455     and ub.CashBookRule.Obj-code   = 0
     2456     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     2457     no-error.
     2458   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2459   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2460     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2461     and X_fin-code-cor-acc.status_ = integer('0':U)
     2462     no-error .
     2463   if available X_fin-code-cor-acc
     2464     then
     2465   do :
     2466     assign
     2467       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2468       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2469       .
     2470   end.
     2471   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2472     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2473     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2474     no-error .
     2475   if available X_fin-code-cor-acc1
     2476     then
     2477   do :
     2478     assign
     2479       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2480       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2481       .
     2482   end.
     2483   assign
     2484     tt-fin-doc.including = "@, в т.ч.: без налога (НДС)" .
     2485     paramVne = "vne" .
     2486   end.
     2487   else do:
     2488     if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     2489   assign
     2490     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2491     .
     2492   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2493     and ub.CashBookRule.Obj-type   = 'всем':U
     2494     and ub.CashBookRule.Obj-code   = 0
     2495     and ub.CashBookRule.Code       = "corrPkoAvans"
     2496     no-error.
     2497   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2498   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2499     and ub.CashBookRule.Obj-type   = 'всем':U
     2500     and ub.CashBookRule.Obj-code   = 0
     2501     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     2502     no-error.
     2503   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2504   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2505     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2506     and X_fin-code-cor-acc.status_ = integer('0':U)
     2507     no-error .
     2508   if available X_fin-code-cor-acc
     2509     then
     2510   do :
     2511     assign
     2512       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2513       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2514       .
     2515   end.
     2516   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2517     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2518     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2519     no-error .
     2520   if available X_fin-code-cor-acc1
     2521     then
     2522   do :
     2523     assign
     2524       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2525       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2526       .
     2527   end.
     2528   assign
     2529     tt-fin-doc.including = "@, в т.ч. 22/122 (НДС)" .
     2530     paramVne = "avans" .
     2531   end.
     2532   else do:
     2533   tt-fin-doc.naznach-plat = "".
     2534   tt-fin-doc.including = "@, в том числе НДС" .
     2535   paramVne = "" .
