     4226       end.
     4227     end.
     4228     CASE p-main-widget:
     4229       when "sum-doc" then
     4230         do:
     4231           assign
     4232             frame Dialog-Frame
     4233             tt-fin-doc.exch-rate
     4234             tt-fin-doc.exch-scale
     4235             tt-fin-doc.sum-doc
     4236             .
     4237           CASE tt-fin-doc.curr-code:
     4238             when 0 then
     4239               do:
     4240                 assign
     4241                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc
     4242                   tt-fin-doc.sum-base = tt-fin-doc.sum-doc / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4243                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4244                   .
     4245               end.
     4246             when v-base-code then
     4247               do:
     4248                 assign
     4249                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     4250                   tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4251                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4252                   .
     4253               end.
     4254             otherwise
     4255             do:
     4256               assign
     4257                 tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     4258                 tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4259                 tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4260                 .
     4261             end.
     4262           END CASE.
     4263         end.
     4264     END CASE.
     4265     assign
     4266       f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     4267       .
     4268     display
     4269       f-rest-con-sum
     4270       with frame Dialog-Frame.
