     3851   PROCEDURE check-sums-rate :
     3852     define variable v-exch-rate  like ub.fin-doc.sum-doc no-undo .
     3853     define variable v-exch-scale like ub.fin-doc.sum-doc no-undo .
     3854   END PROCEDURE.
     3855   PROCEDURE disable-enable :
     3856     define input parameter p-main-widget as character no-undo.
     3857     define input parameter p-main-curr as character no-undo .
     3858     disable
     3859       tt-fin-doc.sum-doc
     3860       tt-fin-doc.sum-rubl
     3861       tt-fin-doc.sum-base
     3862       tt-fin-doc.base-rate
     3863       tt-fin-doc.base-scale
     3864       tt-fin-doc.exch-rate
     3865       tt-fin-doc.exch-scale
     3866       tt-fin-doc.sum-contr
     3867       tt-fin-doc.contract-rate
     3868       tt-fin-doc.contract-scale
     3869       with frame Dialog-Frame .
     3870     assign
     3871       v-main-sum  = if p-main-widget <> "":U then p-main-widget else v-main-sum
     3872       v-main-curr = if p-main-curr <> "":U then p-main-curr else v-main-curr
     3873       .
     3874     if v-limit-access > 0 then
     3875     do:
     3876       display
     3877         tt-fin-doc.sum-rubl
     3878         when v-rubf
     3879         tt-fin-doc.sum-base
     3880         when v-basef
     3881         tt-fin-doc.exch-rate
     3882         when v-exchf
     3883         tt-fin-doc.exch-scale
     3884         when v-exchf
     3885         tt-fin-doc.base-rate
     3886         when v-basef
     3887         tt-fin-doc.base-scale
     3888         when v-basef
     3889         tt-fin-doc.sum-contr
     3890         when v-contractf
     3891         tt-fin-doc.contract-rate
     3892         when v-contractratef
     3893         tt-fin-doc.contract-scale
     3894         when v-contractratef
     3895         with frame Dialog-Frame.
     3896       return.
     3897     end.
     3898     CASE p-main-widget:
     3899       when "sum-doc" then
     3900         do:
     3901           enable
     3902             tt-fin-doc.sum-doc
     3903             with frame Dialog-Frame.
     3904           APPLY "ENTRY" to tt-fin-doc.sum-doc.
     3905         end.
     3906     END CASE.
     3907     display
     3908       tt-fin-doc.sum-rubl
     3909       when v-rubf
     3910       tt-fin-doc.sum-base
     3911       when v-basef
     3912       tt-fin-doc.exch-rate
     3913       when v-exchf
     3914       tt-fin-doc.exch-scale
     3915       when v-exchf
     3916       tt-fin-doc.base-rate
     3917       when v-basef
     3918       tt-fin-doc.base-scale
     3919       when v-basef
     3920       tt-fin-doc.sum-contr
     3921       when v-contractf
     3922       tt-fin-doc.contract-rate
     3923       when v-contractratef
     3924       tt-fin-doc.contract-scale
     3925       when v-contractratef
     3926       with frame Dialog-Frame.
     3927     CASE rs-view:
     3928       when "full":u then
     3929         do:
     3930           assign
     3931             v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +  "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-payer-view,str-podr-type,str-podr-code,str-podr-name," +                             v-an-uchet-tab-order +  v-sum-curr-tab-order +                             "receiver-type,receiver-code,b-receiver,receiver-name,naznach-plat," +                              "PS,payer-sign1,receiver-sign1"
     3932             .
     3933         end.
     3934       when "brief":u then
     3935         do:
     3936           assign
     3937             v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                            "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-payer-view," +                            v-sum-curr-tab-order +                            "receiver-type,receiver-code,b-receiver,receiver-name,naznach-plat," +                            "PS,payer-sign1,receiver-sign1"
     3938             .
     3939         end.
     3940       when "contract":u then
     3941         do:
     3942           assign
     3943             v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                               "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-payer-view," +                                v-contract-tab-order + v-sum-curr-tab-order +                                 "receiver-type,receiver-code,b-receiver,receiver-name,naznach-plat," +                                 "PS,payer-sign1,receiver-sign1"
     3944             .
     3945         end.
     3946     END CASE.
     3947   END PROCEDURE.
     3948   define new global shared variable g#lib-farh as handle no-undo .
     3949   PROCEDURE fill-tables :
     3950     define buffer buf_fin-doc-tax  for ub.fin-doc-tax.
     3951     define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     3952     define buffer buf_fin-ob-tax   for ub.fin-ob-tax.
     3953     define buffer buf_fin-connect  for ub.fin-connect.
     3954     define buffer buf_fin-ob       for ub.fin-ob.
     3955     define buffer buf_payment      for ub.payment.
     3956     if p-mode = 'ДОБАВЛЕНИЕ':U
     3957       AND p-ob-doc-code <> "" then
     3958     do:
     3959       for each buf_fin-ob-tax no-lock where
     3960         buf_fin-ob-tax.host-code = tt-fin-doc.fin-doc-code
     3961         AND buf_fin-ob-tax.doc-code = p-ob-doc-code:
     3962         create tt0-fin-doc-tax.
     3963         buffer-copy buf_fin-ob-tax to tt0-fin-doc-tax.
     3964       end.
     3965       return.
     3966     end.
     3967     if p-mode = 'ДОБАВЛЕНИЕ':U
     3968       and v-copy-mode = yes then
     3969     do:
     3970       for each buf_fin-doc-tax no-lock where
     3971         buf_fin-doc-tax.host-code = locked_fin-doc.host-code
     3972         AND buf_fin-doc-tax.fin-doc-code = locked_fin-doc.fin-doc-code
     3973         :
     3974         create tt0-fin-doc-tax.
     3975         buffer-copy buf_fin-doc-tax except fin-doc-code to tt0-fin-doc-tax
     3976           assign
     3977           tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     3978           .
     3979       end.
     3980       for each buf_payment no-lock where
     3981         buf_payment.source-type = 'платеж':U
     3982         AND buf_payment.source-ref = string(locked_fin-doc.fin-doc-code)
     3983         :
     3984         create tt0-payment.
     3985         buffer-copy buf_payment except source-ref to tt0-payment
     3986           assign
     3987           tt0-payment.source-ref = string(tt-fin-doc.fin-doc-code)
     3988           .
     3989       end.
     3990       for each buf_fin-doc-attr no-lock where
     3991         buf_fin-doc-attr.host-code = locked_fin-doc.host-code
     3992         AND buf_fin-doc-attr.fin-doc-code = locked_fin-doc.fin-doc-code
     3993         :
     3994         create tt0-fin-doc-attr.
     3995         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr
     3996           assign
     3997           tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     3998           .
     3999       end.
     4000     end.
     4001     else
     4002     do:
     4003       for each buf_fin-doc-tax no-lock where
     4004         buf_fin-doc-tax.host-code = tt-fin-doc.host-code
     4005         AND buf_fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4006         :
     4007         create tt0-fin-doc-tax.
     4008         buffer-copy buf_fin-doc-tax to tt0-fin-doc-tax.
     4009       end.
     4010       for each buf_payment no-lock where
     4011         buf_payment.source-type = 'платеж':U
     4012         AND buf_payment.source-ref = string(tt-fin-doc.fin-doc-code)
     4013         :
     4014         create tt0-payment.
     4015         buffer-copy buf_payment to tt0-payment.
     4016       end.
     4017       for each buf_fin-doc-attr no-lock where
     4018         buf_fin-doc-attr.host-code = tt-fin-doc.host-code
     4019         AND buf_fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4020         :
     4021         create tt0-fin-doc-attr.
     4022         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr.
     4023       end.
     4024       for each tt0-fin-doc-attr no-lock where
     4025         tt0-fin-doc-attr.host-code = tt-fin-doc.host-code
     4026         AND tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4027         :
     4028       end.
     4029     end.
     4030   if (valid-handle(g#lib-farh) <> true) then do:   run str/lib-farh.p persistent no-error .   if error-status :error or (valid-handle(g#lib-farh) <> true) then do:     message       "Error starting lib-farh.p" skip       g#lib-farh skip       g#lib-farh :type skip       g#lib-farh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-farh_fautoobj in g#lib-farh
     4031   (input tt-fin-doc.host-code
     4032   ,input tt-fin-doc.fin-doc-code
     4033   ,output v-is-auto-obj
     4034   )
     4035   .
     4036     if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Vnecli", tt-fin-doc.cashbookId) then paramVne = "vne" .
     4037     else if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Avanscli", tt-fin-doc.cashbookId) then paramVne = "avans" .
     4038     else paramVne = "" .
     4039     run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     4040   END PROCEDURE.
     4041   PROCEDURE hide-view-currency :
     4042     define buffer buf_currency for ub.currency.
     4043     assign
     4044       v-rubf          = no
     4045       v-exchf         = no
     4046       v-basef         = no
     4047       v-baseratef     = no
     4048       v-contractf     = no
     4049       v-contractratef = no
     4050       .
     4051     hide
     4052       tt-fin-doc.sum-rubl in frame Dialog-Frame
     4053       tt-fin-doc.exch-rate
     4054       tt-fin-doc.exch-scale
     4055       tt-fin-doc.sum-base
     4056       tt-fin-doc.base-rate
     4057       tt-fin-doc.base-scale
     4058       tt-fin-doc.sum-contr
     4059       tt-fin-doc.contract-rate
     4060       tt-fin-doc.contract-scale
     4061       in frame Dialog-Frame .
     4062     if tt-fin-doc.curr-code <> 0 then
     4063     do:
     4064       if tt-fin-doc.curr-code:visible then
     4065         display
     4066           tt-fin-doc.exch-rate
     4067           tt-fin-doc.exch-scale
     4068           tt-fin-doc.sum-rubl
     4069           with frame Dialog-Frame.
     4070       assign
     4071         v-rubf  = yes
     4072         v-exchf = yes
     4073         .
     4074     end.
     4075     if v-base-code <> tt-fin-doc.curr-code
     4076       and v-base-code <> 0
     4077       then
     4078     do:
     4079       find first buf_currency no-lock where
     4080         buf_currency.curr-code = v-base-code .
     4081       assign
     4082         tt-fin-doc.sum-base:label = "Б.в.("  + buf_currency.curr-abbr + ")":U
     4083         .
     4084       if tt-fin-doc.curr-code:visible then
     4085         display
     4086           tt-fin-doc.base-rate
     4087           tt-fin-doc.base-scale
     4088           tt-fin-doc.sum-base
     4089           with frame Dialog-Frame.
     4090       assign
     4091         v-basef     = yes
     4092         v-baseratef = yes
     4093         .
     4094     end.
     4095     if tt-fin-doc.contract-code  <> 0 and
     4096       (tt-fin-doc.contract-curr <> 0
     4097       and tt-fin-doc.contract-curr <> tt-fin-doc.curr-code
     4098       and tt-fin-doc.contract-curr <> v-base-code
     4099       )
     4100       then
     4101     do:
     4102       find first buf_currency no-lock where
     4103         buf_currency.curr-code = tt-fin-doc.contract-curr .
     4104       assign
     4105         tt-fin-doc.sum-contr:label = "Вал.дог.("  + buf_currency.curr-abbr + ")":U
     4106         .
     4107       if tt-fin-doc.curr-code:visible then
     4108         display
     4109           tt-fin-doc.sum-contr
     4110           tt-fin-doc.contract-rate
     4111           tt-fin-doc.contract-scale
     4112           with frame Dialog-Frame.
     4113       assign
     4114         v-contractf     = yes
     4115         v-contractratef = yes
     4116         .
     4117     end.
     4118     assign
     4119       v-sum-curr-tab-order = v-sum-doc-tab-order
     4120       .
     4121     run disable-enable in this-procedure (v-main-sum, v-main-curr).
     4122   END PROCEDURE.
