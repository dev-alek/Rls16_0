     2709   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2710     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2711     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2712     no-error .
