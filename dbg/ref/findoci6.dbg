     3001   ON CHOOSE OF B-cashbook IN FRAME Dialog-Frame
     3002     DO:
     3003       define variable v-cb-brw as class ibs.th.ref.cashbookbrw no-undo .
     3004       v-cb-brw = new ibs.th.ref.cashbookbrw ( 'ВЫБОР':U, parparentproc ).
     3005       wait-for  v-cb-brw:ShowDialog() .
     3006       if v-cb-brw:out-list-id > ""
     3007         then
     3008       do :
     3009         find first ub.cashbook no-lock where ub.cashbook.id = int64(v-cb-brw:out-list-id) .
     3010         tt-fin-doc.cashbookId = ub.cashbook.id .
     3011         f-cashbook = ub.CashBook.CashBookName .
     3012         display
     3013           f-cashbook
     3014           with frame Dialog-Frame .
     3015         IF LOOKUP("update_prc-doc-code-mask", THIS-PROCEDURE:INTERNAL-ENTRIES) >  0
     3016           THEN
     3017           run update_prc-doc-code-mask (no).
     3018         run check-obj in this-procedure (   input tt-fin-doc.obj-type
     3019           ,input tt-fin-doc.obj-code
     3020           )
     3021           no-error.
     3022         find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = (if tt-fin-doc.fin-doc-type eq 'рко':U then ub.cashbook.corrRko else ub.cashbook.corrPko)
     3023           and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3024           and X_fin-code-cor-acc.status_ = integer('0':U)
     3025           no-error .
     3026         if available X_fin-code-cor-acc
     3027           then
     3028         do :
     3029           assign
     3030             tt-fin-doc.cor-acc-value = X_fin-code-cor-acc.code-value
     3031             f-cor-acc-descr          = X_fin-code-cor-acc.descr
     3032             tt-fin-doc.cor-acc       = X_fin-code-cor-acc.fin-code
     3033             .
     3034         end.
     3035         else
     3036         do:
     3037           if ub.cashbook.corrRko = "" then
     3038           do:
     3039             for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     3040               and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     3041               tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     3042               tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     3043             end.
     3044           end.
     3045         end.
     3046         if ub.CashBook.OsnAcct <> "" then
     3047         do:
     3048           find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     3049             and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3050             and X_fin-code-cor-acc.status_ = integer('0':U)
     3051             no-error .
     3052           if available X_fin-code-cor-acc
     3053             then
     3054           do :
     3055             assign
     3056               tt-fin-doc.cor-acc1-value = X_fin-code-cor-acc.code-value
     3057               f-cor-acc1-descr          = X_fin-code-cor-acc.descr
     3058               tt-fin-doc.cor-acc1       = X_fin-code-cor-acc.fin-code
     3059               .
     3060           end.
     3061           else
     3062           do:
     3063             assign
     3064               tt-fin-doc.cor-acc1-value = ""
     3065               f-cor-acc1-descr          = ""
     3066               tt-fin-doc.cor-acc1       = ?
     3067               .
     3068           end.
     3069         end.
     3070       end.
     3071       display
     3072         tt-fin-doc.cor-acc-value
     3073         f-cor-acc-descr
     3074         tt-fin-doc.cor-acc
     3075         tt-fin-doc.cor-acc1-value
     3076         f-cor-acc1-descr
     3077         tt-fin-doc.cor-acc1
     3078         with frame Dialog-Frame .
     3079     END.
