      145   procedure proc-alt-shift-f2:
      146     if not ibs.th.gbl.gbl-var:rcode
      147   then
      148     run gbl\inidebug.p .
      149   end.
      150   procedure proc-alt-shift-f3:
      151     run gbl/prvssinf.p
      152       ( input this-procedure
      153       ) .
      154   end.
      155   define variable v-inform-launched as logical no-undo initial false .
      156   procedure proc-alt-shift-f4:
      157     define variable v-action as character no-undo .
      158     if v-inform-launched = false then do:
      159       assign
      160         v-inform-launched = true
      161       .
      162       run gbl/d-inform.w
      163         (  input self
      164         ,  input this-procedure
      165         , output v-action
      166         ) no-error .
      167       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      168       assign
      169         v-inform-launched = false
      170       .
      171     end.
      172   end.
      173   procedure proc-alt-f1:
      174     run gbl/corrhelp.p
      175       (input this-procedure
      176       ) .
      177   end .
      178   on alt-shift-f2 anywhere do:
      179     run proc-alt-shift-f2.
      180   end.
      181   on alt-shift-f3 anywhere do:
      182     run proc-alt-shift-f3 in this-procedure .
      183   end.
      184   on alt-shift-f4 anywhere do:
      185     run proc-alt-shift-f4 in this-procedure.
      186   end.
      187   on alt-f1 anywhere do:
      188     run proc-alt-f1 in this-procedure .
      189   end.
      190   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   define variable v-waitfram-action01         as character   no-undo .
      192   define variable v-waitfram-action02         as character   no-undo .
      193   define variable v-waitfram-action03         as character   no-undo .
      194   define variable mWaitFramTextBeg            as character   no-undo.
      195   define variable mWaitFramTextEnd            as character   no-undo.
      196   define variable mWaitFramView               as logical     no-undo.
      197   define variable mWaitProcEvent              as logical     no-undo init yes.
      198   define variable mWaitFramInterval           as integer     no-undo init 1 .
      199   define variable mWaitFramStop               as logical     no-undo.
      200   define variable mWaitFramStopUser           as logical     no-undo.
      201   define variable mWaitFramStopTimeOut        as logical     no-undo.
      202   define variable mWaitFramStartProc          as datetime-tz no-undo.
      203   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      204   define button B-WaitFramStop auto-end-key
      205        label "Стоп"
      206        size 10 by 1 tooltip "Остоновить процесс".
      207   define button B-viewProcInfo
      208        label "Информация"
      209        size 15 by 1 tooltip "Информация о процесс".
      210   define frame waitfram
      211     v-waitfram-action01 format "x(72)" no-label skip
      212     v-waitfram-action02 format "x(72)" no-label skip
      213     v-waitfram-action03 format "x(72)" no-label skip
      214     B-viewProcInfo
      215     B-WaitFramStop at row 4 col 30
      216     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      217     .
      218   define new global shared variable mBatchMode as logical no-undo init ?.
      219   define variable mFramBachModHandle as handle no-undo.
      220   mFramBachModHandle = frame waitfram:handle.
      221   define variable mFameOldVis as logical no-undo.
      222   define variable mVisCUrentVin as logical no-undo.
      223   if session:batch-mode
      224   then
      225      mBatchMode = yes.
      226   if mBatchMode = ? then do:
      227     mVisCUrentVin = current-window:visible.
      228     mFameOldVis = mFramBachModHandle:visible.
      229     mFramBachModHandle:visible  = yes.
      230     mBatchMode = mFramBachModHandle:visible ne yes.
      231     mFramBachModHandle:visible = mFameOldVis.
      232     current-window:visible = mVisCUrentVin.
      233   end.
      234    if  log-manager:logfile-name ne ?
      235     then DO:
      236         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      237         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      238         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      239     end.
      240   on choose of B-WaitFramStop in frame waitfram
      241   do:
      242     mWaitFramStop = yes.
      243     mWaitFramStopUser = yes.
      244   end.
      245   function waitfram-check-timeout returns logical():
      246      define variable vtime as int64 no-undo.
      247      if mWaitFramStopTimeOut
      248      then
      249         return yes.
      250      vtime = ( now - mWaitFramStartProc ) / 1000 .
      251      if     mWaitFramTimeOut ne ?
      252         and mWaitFramTimeOut ne 0
      253         and mWaitFramTimeOut lt vtime
      254      then do:
      255         mWaitFramStopTimeOut = yes.
      256      end.
      257      return mWaitFramStopTimeOut.
      258   end.
      259   procedure waitfram-hide :
      260     if not session:batch-mode
      261     then do
      262     on error undo, return error return-value
      263     :
      264       pause 0 before-hide .
      265       if not mBatchMode then
      266         hide frame waitfram .
      267     if     not mWaitFramView
      268        and mWaitProcEvent
      269     then
      270       process events .
      271     end.
      272   end procedure.
      273   procedure waitfram-show :
      274     define input  parameter p-message as character no-undo .
      275     define variable v-left-margin as integer   no-undo .
      276     if not session:batch-mode
      277     then do
      278     on error undo, return error return-value
      279     :
      280       if length(p-message) <= 70 then do:
      281         assign
      282           v-left-margin = integer((70 - length(p-message)) / 2)
      283         .
      284         assign
      285           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      286         .
      287         assign
      288           v-waitfram-action01 = " "
      289           v-waitfram-action02 = " "
      290                                    + fill(" ", v-left-margin)
      291                                    + p-message
      292           v-waitfram-action03 = " "
      293         .
      294       end.
      295       else do:
      296         define variable vRindex1 as integer no-undo.
      297         define variable vRindex2 as integer no-undo.
      298         vRindex1 = r-index(p-message," ",70).
      299         if vRindex1 = 0
      300         then
      301            vRindex1 = 70.
      302         if length(p-message)  <= vRindex1 + 70 then do:
      303           assign
      304             v-waitfram-action01 = " "
      305             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      306             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      307           .
      308         end.
      309         else do:
      310           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      311           if vRindex2 <= vRindex1
      312           then
      313              vRindex2 = vRindex1 + 70.
      314           assign
      315             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      316             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      317             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      318           .
      319         end.
      320       end.
      321       B-viewProcInfo:visible   in frame waitfram = no.
      322       B-viewProcInfo:sensitive in frame waitfram = no.
      323       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      324       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      325       if  (   mWaitFramView
      326          or  mWaitProcEvent)
      327          and not mBatchMode
      328       then
      329          display
      330             v-waitfram-action01 skip
      331             v-waitfram-action02 skip
      332             v-waitfram-action03 skip
      333          with frame waitfram .
      334       if     mWaitFramView
      335          then do:
      336             if     mWaitFramInterval ne ?
      337                and not mBatchMode
      338             then
      339                wait-for go of frame waitfram pause mWaitFramInterval.
      340          end.
      341          else
      342             if     mWaitProcEvent
      343                and not mBatchMode
      344             then
      345                process events .
      346     end.
      347   end procedure.
      348      procedure waitfram-show-this:
      349         define input  parameter iInterval as int64 no-undo.
      350         define variable vtime as int64 no-undo.
      351         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      352         mWaitFramInterval = iInterval.
      353         run waitfram-show (substitute("&1&2 &3&4" ,
      354                                       mWaitFramTextBeg ,
      355                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      356                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      357                                       mWaitFramTextEnd
      358                                      )
      359                           ).
      360      end.
      361      procedure WaitFramRunPause:
      362         define input  parameter iInterval as dec no-undo.
      363         define variable vStart  as datetime-tz no-undo.
      364         define variable vend    as datetime-tz no-undo.
      365         define variable vint as int64 no-undo.
      366         define variable vOk as logical no-undo.
      367         vStart = now.
      368         vend   = vStart.
      369         publish "WaitFramPause" (iInterval,output vOk).
      370         vend   =  now.
      371         vint = vend - vStart.
      372         vint = iInterval - vint / 1000.
      373         if     not mWaitFramStop
      374            and (   vint > 0
      375                 or (    not vOk
      376                     and iInterval eq ?
      377                     )
      378                 )
      379         then
      380            run waitfram-show-this (iInterval).
      381         vend   =  now.
      382         vint = vend - vStart.
      383         vint = iInterval - vint / 1000.
      384         if     not mWaitFramStop
      385            and vint > 0
      386         then do:
      387            run gbl/pause.p (vint * 1000).
      388         end.
      389         if iInterval ne ?
      390         then
      391            publish "WaitFramStop".
      392         waitfram-check-timeout().
      393      end.
      394      procedure WaitFramWaitFor:
      395         define input  parameter iInterval as dec no-undo.
      396         assign
      397            mWaitFramStartProc   = now
      398            mWaitFramStopUser    = no
      399            mWaitFramStopTimeOut = no
      400         .
      401         block-wait:
      402         do while not mWaitFramStop:
      403            run WaitFramRunPause (iInterval).
      404            if  waitfram-check-timeout()
      405            then do:
      406               leave block-wait.
      407            end.
      408         end.
      409         run waitfram-hide.
      410      end.
      411   procedure waitfram-join :
      412     define input  parameter p-line-1  as character no-undo .
      413     define input  parameter p-line-2  as character no-undo .
      414     define input  parameter p-line-3  as character no-undo .
      415     define output parameter p-message as character no-undo .
      416     do
      417     on error undo, return error return-value
      418     :
      419       assign
      420         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      421                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      422                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      423       .
      424     end.
      425   end procedure.
      426   function waitfram-join-function returns character
      427     (input p-line-1 as character
      428     ,input p-line-2 as character
      429     ,input p-line-3 as character
      430     ).
      431     define variable v-message as character no-undo .
      432     run waitfram-join in this-procedure
      433       (input  p-line-1
      434       ,input  p-line-2
      435       ,input  p-line-3
      436       ,output v-message
      437       ) .
      438     return v-message .
      439   end function .
      440   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      442   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      443   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      444   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      445   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      446   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      447   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      448   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      449   procedure uf-name :
      450     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      451     define output parameter p-use-List_     as logical   no-undo .
      452     define output parameter p-type-List_     as character no-undo .
      453     define output parameter p-format-List_   as character no-undo .
      454     define output parameter p-use-Naim      as logical   no-undo .
      455     define output parameter p-type-Naim      as character no-undo .
      456     define output parameter p-format-Naim    as character no-undo .
      457     define output parameter p-use-print-graft as logical   no-undo .
      458     define output parameter p-use-sort-gr   as logical   no-undo .
      459     define output parameter p-use-type-price as logical   no-undo .
      460     define output parameter p-use-type-val  as logical   no-undo .
      461     define output parameter p-label          as character no-undo .
      462     define output parameter p-tooltip        as character no-undo .
      463     define output parameter p-user-can-edit  as logical   no-undo .
      464     define output parameter p-output-display as logical   no-undo .
      465     define output parameter p-other          as character no-undo .
      466     do
      467     on error undo, return error
      468     :
