     5346   ) no-error.
     5347   if error-status:error then do:
     5348   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5349   define variable fh as widget-handle no-undo .
     5350   define variable hh as widget-handle no-undo .
     5351   define variable rv as character no-undo .
     5352   assign
     5353   rv = entry(1, return-value , chr(4)).
     5354   if rv <> "":U then do:
     5355     assign
     5356     fh = frame Dialog-Frame:first-child
     5357     hh = fh:first-child
     5358     .
     5359     do while valid-handle(hh):
     5360       if hh:name = rv then do:
     5361         APPLY "ENTRY" to hh.
     5362         undo ,
     5363         return error.
     5364       end.
     5365       hh = hh:next-sibling.
     5366     end.
     5367   end.
     5368     undo, return error.
     5369   end.
     5370   END PROCEDURE.
