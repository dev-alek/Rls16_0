     3894       .
     3895         run fltopend_fltfindq in this-procedure  (
     3896                             input this-procedure:handle
     3897                             ,input QUERY br-vardeliv:handle
     3898                             ,input logical(parameter-2-33)
     3899                             ,input no-lock
     3900                             ,input parameter-3-33
     3901                             ,input parameter-4-33
     3902                             ,input parameter-5-33
     3903                             ,input parameter-6-33
     3904                             ,input parameter-7-33
     3905                             ,output v-fltopend-rowid
     3906                             ) no-error.
     3907         .
     3908         v-doc-rec = ?.
     3909       end.
     3910       assign
     3911         l-query-was-opened = true
     3912       .
     3913     end.
     3914   end.
     3915     run waitfram-hide in this-procedure .
     3916     END.
     3917   END CASE.
     3918   if not p-open-query then
     3919   REPOSITION br-vardeliv to recid v-doc-rec No-ERROR.
     3920   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3921   query br-vardeliv:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3922   run waitfram-hide in this-procedure.
     3923   APPLY "VALUE-CHANGED" TO br-vardeliv in frame Dialog-Frame.
     3924   APPLY "ENTRY" TO br-vardeliv.
     3925   END PROCEDURE.
     3926   PROCEDURE proc-br-vardeliv :
     3927   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3928   if b-sel:sensitive in frame Dialog-Frame then dO:
     3929       if b-mark:sensitive then do:
     3930           apply "choose" to b-mark in frame Dialog-Frame.
     3931       end.
     3932       else do:
     3933           apply "choose" to b-sel in frame Dialog-Frame.
     3934       end.
     3935   end.
     3936   else do:
     3937       if b-lkp:sensitive then
     3938       apply "choose" to b-lkp in frame Dialog-Frame.
     3939   end.
     3940   END PROCEDURE.
     3941   PROCEDURE proc-view-changes :
     3942   for each temp-changes:
     3943       delete temp-changes.
     3944   END.
     3945   if not available X_c-var-deliv-gr-per-val then do:
     3946     Open QUery br-changes for each temp-changes.
     3947     return.
     3948   end.
     3949   define variable v-label-param as character no-undo .
     3950   v-label-param =
     3951     "des" + chr(4) + "Описание" + chr(4) + "" + chr(8)
     3952    + "deliv-type-code" + chr(4) + "Внутр.код типа доставки" + chr(4) + "" + chr(8)
     3953    + "deliv-subj-code" + chr(4) + "Внутр.код субъекта доставки" + chr(4) + "" + chr(8)
     3954    + "obj-type" + chr(4) + "Тип объекта доставки" + chr(4) + "" + chr(8)
     3955    + "obj-code" + chr(4) + "Код объекта доставки" + chr(4) + "" + chr(8)
     3956    + "gr-per-val-code" + chr(4) + "Внутр.код группы сроков годности" + chr(4) + "" + chr(8)
     3957    + "sts" + chr(4) + "Статус" + chr(4) + ""  .
