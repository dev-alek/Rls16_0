     3960                                               ,input  'var-deliv-gr-per-val':U
     3961                                               ,input  "des,deliv-type-code,deliv-subj-code,obj-type,obj-code,gr-per-val-code,sts"
     3962                                               ,input  v-label-param).
     3963   Open QUery br-changes for each temp-changes.
     3964   END PROCEDURE.
     3965   FUNCTION get-gr-per-val RETURNS CHARACTER
     3966     ( INPUT p-gr-per-val-code AS integer, OUTPUT p-gr-per-from AS INTEGER, OUTPUT p-gr-per-to AS INTEGER ) :
     3967   DEFINE BUFFER loc_group-period-validity FOR ub.group-period-validity.
     3968   FIND FIRST loc_group-period-validity NO-LOCK WHERE
     3969             loc_group-period-validity.gr-per-val-code = p-gr-per-val-code NO-ERROR.
     3970   IF AVAILABLE loc_group-period-validity THEN dO:
     3971       ASSIGN
     3972       p-gr-per-from = ?
     3973       p-gr-per-to = ?
     3974       .
     3975       RETURN loc_group-period-validity.gr-per-val-name.
     3976   END.
     3977   ASSIGN
     3978       p-gr-per-from = loc_group-period-validity.gr-per-from
     3979       p-gr-per-to = loc_group-period-validity.gr-per-to
     3980       .
     3981     RETURN "Неизв.группа сроков годности".
     3982   END FUNCTION.
     3983   FUNCTION get-subject RETURNS CHARACTER
     3984     ( INPUT p-deliv-subj-code AS INTEGER) :
     3985   DEFINE BUFFER loc_delivery-subject FOR ub.delivery-subject.
     3986   FIND FIRST loc_delivery-subject NO-LOCK WHERE
     3987             loc_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
     3988   IF AVAILABLE loc_delivery-subject THEN RETURN loc_delivery-subject.deliv-subj-name.
     3989     RETURN "Неизв.субъект доставки".
     3990   END FUNCTION.
     3991   FUNCTION get-type RETURNS CHARACTER
     3992   ( INPUT p-deliv-type-code AS INTEGER) :
     3993   DEFINE BUFFER loc_delivery-type FOR ub.delivery-type.
     3994   FIND FIRST loc_delivery-type NO-LOCK WHERE
     3995             loc_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     3996   IF AVAILABLE loc_delivery-type THEN RETURN loc_delivery-type.deliv-type-name.
     3997     RETURN "Неизв.тип доставки".
     3998   END FUNCTION.
