     3687                              then
     3688           (
     3689           " " + "  " +
     3690             " " + sort-column-phrase +
     3691           " " + "  "
     3692           )
     3693                              else
     3694           (
     3695           " " + "  " +
     3696             " " + sort-column-phrase +
     3697           " " + sort-phrase-31
     3698           )
     3699         parameter-7-31 =
