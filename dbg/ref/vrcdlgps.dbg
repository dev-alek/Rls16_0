     3682             then  substitute(' X_c-var-deliv-gr-per-val.deliv-subj-code  = &1            AND X_c-var-deliv-gr-per-val.deliv-type-code  = &2            AND X_c-var-deliv-gr-per-val.obj-type         = &3&4&3            AND X_c-var-deliv-gr-per-val.obj-code         = &5 ', p-deliv-subj-code, p-deliv-type-code, chr(34), p-deliv-obj-type, p-deliv-obj-code)  + " " + where-phrase-31
