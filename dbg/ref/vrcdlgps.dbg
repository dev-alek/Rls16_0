     3872         parameter-4-33 =
     3873           (
     3874             if ("             X_c-var-deliv-gr-per-val.obj-type         = p-deliv-obj-type            AND X_c-var-deliv-gr-per-val.obj-code         = p-deliv-obj-code                        " + " " + where-phrase-33) <> ""
     3875             then  substitute('X_c-var-deliv-gr-per-val.obj-type         = &1            AND X_c-var-deliv-gr-per-val.obj-code         = &2 ', p-deliv-obj-type, p-deliv-obj-code)  + " " + where-phrase-33
     3876             else "true"
     3877           )
     3878         parameter-5-33 = (" " + "" + " " + "" + " " + p-find-condition)
     3879         parameter-6-33 = if sort-phrase-33 = ''
     3880                              then
     3881           (
     3882           " " + "  " +
     3883             " " + sort-column-phrase +
     3884           " " + "  "
     3885           )
     3886                              else
     3887           (
     3888           " " + "  " +
     3889             " " + sort-column-phrase +
     3890           " " + sort-phrase-33
     3891           )
     3892         parameter-7-33 =
