     3756     assign
     3757       l-filter-open-33 = false
     3758     .
     3759     if flt-rec-33 <> ?
     3760       or sort-column-phrase > ""
     3761     then do:
     3762       define variable  parameter-2-33 as character no-undo .
     3763       define variable  parameter-3-33 as character no-undo .
     3764       define variable  parameter-4-33 as character no-undo .
     3765       define variable  parameter-5-33 as character no-undo .
     3766       define variable  parameter-6-33 as character no-undo .
     3767       define variable  parameter-7-33 as character no-undo .
     3768         assign
     3769         parameter-3-33 =
     3770                                 "FOR EACH X_c-var-deliv-gr-per-val"
     3771         parameter-4-33 =
     3772           (
     3773             if ("             X_c-var-deliv-gr-per-val.obj-type         = p-deliv-obj-type            AND X_c-var-deliv-gr-per-val.obj-code         = p-deliv-obj-code                        " + " " + where-phrase-33) <> ""
     3774             then  substitute('X_c-var-deliv-gr-per-val.obj-type         = &1            AND X_c-var-deliv-gr-per-val.obj-code         = &2 ', p-deliv-obj-type, p-deliv-obj-code)  + " " + where-phrase-33
     3775             else "true"
     3776           )
     3777         parameter-5-33 = (" " + "" + " " + "")
     3778         parameter-6-33 = if sort-phrase-33 = ''
     3779                              then
     3780           (
     3781           " " + "  " +
     3782             " " + sort-column-phrase +
     3783           " " + "  "
     3784           )
     3785                              else
     3786           (
     3787           " " + "  " +
     3788             " " + sort-column-phrase +
     3789           " " + sort-phrase-33
     3790           )
     3791         parameter-7-33 =
     3792           " indexed-reposition  "
     3793       .
     3794       do
     3795       on stop undo, leave
     3796       on error undo, leave
     3797       :
     3798         assign
     3799           l-disable-where-33 =
     3800             ("             X_c-var-deliv-gr-per-val.obj-type         = p-deliv-obj-type            AND X_c-var-deliv-gr-per-val.obj-code         = p-deliv-obj-code                        " + " " + where-phrase-33 = "")
     3801         .
     3802         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3803                             ,input QUERY br-vardeliv:handle
     3804                             ,input parameter-3-33
     3805                             ,input parameter-4-33
     3806                             ,input parameter-5-33
     3807                             ,input parameter-6-33
     3808                             ,input parameter-7-33
     3809                             )
     3810         .
     3811         assign
     3812           l-filter-open-33 = true
     3813         .
     3814       end.
     3815       if l-filter-open-33 = false then do:
     3816         message
     3817           "Ошибка при фильтрации / сортировке" skip
     3818           "Будут показаны записи без учета фильтра" skip
     3819           view-as alert-box .
     3820       end.
     3821       else do:
     3822           assign
     3823             l-query-was-opened = true
     3824           .
     3825       end.
     3826     end.
     3827     if l-filter-open-33 = false then do:
     3828       OPEN QUERY br-vardeliv FOR EACH X_c-var-deliv-gr-per-val
     3829         where              X_c-var-deliv-gr-per-val.obj-type         = p-deliv-obj-type            AND X_c-var-deliv-gr-per-val.obj-code         = p-deliv-obj-code
     3830         indexed-reposition
     3831     .
     3832         assign
     3833           l-query-was-opened = true
     3834         .
     3835     end.
     3836   end.
     3837   else do:
     3838     assign
     3839       v-doc-rec = recid( X_c-var-deliv-gr-per-val )
     3840     .
     3841     do
     3842     on stop undo, leave
     3843     on error undo, leave
     3844     :
     3845       if QUERY br-vardeliv:handle:get-buffer-handle(1) = (buffer X_c-var-deliv-gr-per-val:handle) then do:
     3846         assign
     3847         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3848         parameter-4-33 =
