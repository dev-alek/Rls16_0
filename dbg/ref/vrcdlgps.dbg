     2911   MAIN-BLOCK:
     2912   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2913      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2914     find first X_curr_clients no-lock where
     2915               X_curr_clients.obj-type = p-curr-obj-type
     2916          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     2917     if not available X_curr_clients then do:
     2918       message
     2919       vss-workfile vss-revision vss-description skip
     2920       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     2921       p-curr-obj-type p-curr-obj-code
     2922       view-as alert-box ERROR.
     2923       return error .
     2924     end.
     2925    if LOOKUP(p-mode, ('все':U + chr(4) + "variant-delivery" + chr(4) + "one" + chr(4) + 'объект':U) ,
     2926                   chr(4)) = 0
     2927        then dO:
     2928       message
     2929       vss-workfile vss-revision vss-description skip
     2930       "Неверное значение параметров вызова p-mode"
     2931       p-mode
     2932       view-as alert-box ERROR.
     2933       return error .
     2934    end.
     2935    IF p-mode = "variant-delivery"
     2936    or p-mode = "one":U
     2937    THEN DO:
     2938        FIND FIRST X_delivery-type NO-LOCK WHERE
     2939                   X_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     2940       IF NOT AVAILABLE X_delivery-type THEN DO:
     2941           MESSAGE
     2942           vss-workfile vss-revision vss-description skip
     2943           "Неверное значение параметров вызова p-deliv-type-code"
     2944           p-DELIV-TYPE-CODE
     2945           view-as alert-box ERROR.
     2946           return error .
     2947      END.
     2948    END.
     2949   IF p-mode = "variant-delivery"
     2950   or p-mode = "one":U
     2951   THEN DO:
     2952        FIND FIRST X_delivery-subject NO-LOCK WHERE
     2953                   X_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
     2954       IF NOT AVAILABLE X_delivery-subject THEN DO:
     2955           MESSAGE
     2956           vss-workfile vss-revision vss-description skip
     2957           "Неверное значение параметров вызова p-deliv-subj-code"
     2958           p-DELIV-subj-CODE
     2959           view-as alert-box ERROR.
     2960           return error .
     2961      END.
     2962    END.
     2963    if p-mode = 'объект':U
     2964    or p-mode = "one" then do:
     2965       FIND FIRST X_clients no-lock where
     2966                 X_clients.obj-type = p-deliv-obj-type
     2967            AND  X_clients.obj-code = p-deliv-obj-code no-error .
     2968       if not available X_clients then do:
     2969           MESSAGE
     2970           vss-workfile vss-revision vss-description skip
     2971           "Неверное значение параметров вызова p-deliv-obj-type и/или p-deliv-obj-code"
     2972           p-DELIV-obj-type p-deliv-obj-CODE
     2973           view-as alert-box ERROR.
     2974           return error .
     2975       end.
     2976    end.
     2977   IF p-mode = "one":U
     2978   THEN DO:
     2979        FIND FIRST X_group-period-validity NO-LOCK WHERE
     2980                   X_group-period-validity.gr-per-val-code = p-gr-per-val-code NO-ERROR.
     2981       IF NOT AVAILABLE X_group-period-validity THEN DO:
     2982           MESSAGE
     2983           vss-workfile vss-revision vss-description skip
     2984           "Неверное значение параметров вызова p-gr-per-val-code"
     2985           p-gr-per-val-code
     2986           view-as alert-box ERROR.
     2987           return error .
     2988      END.
     2989    END.
     2990   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2991   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
