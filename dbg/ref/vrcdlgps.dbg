      529   end procedure.
      530   procedure prn-lib-reportviewer :
      531     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      532     define input parameter p-report-name-html as character no-undo .
      533     define input parameter p-param        as character no-undo .
      534     define variable v-excel           as character no-undo init 'TRUE' .
      535     define variable v-value-character as character no-undo .
      536     define variable v-value-integer   as character no-undo .
      537     define variable v-value-date      as date      no-undo .
      538     define variable v-value-decimal   as decimal   no-undo .
      539     define variable rep-excel         as logical   no-undo .
      540     define variable excel-string      as character no-undo .
      541     define variable v-param-type      as character no-undo .
      542     define variable v-tth             as handle    no-undo .
      543     run adm/shattri.p (
      544       input "get":U
      545       ,input  ""
      546       ,input  0
      547       ,input  'report-glob':U
      548       ,input  'rep-excel':U
      549       ,output v-value-character
      550       ,output v-value-date
      551       ,output v-value-decimal
      552       ,output v-value-integer
      553       ,output rep-excel
      554       ,output v-param-type
      555       ,INPUT-OUTPUT table-handle v-tth
      556       )  .
      557     if rep-excel then v-excel = "TRUE" .
      558     else v-excel = "FALSE" .
      559     if p-param eq ""
      560     then
      561        p-param = "EXCEL:" + v-excel.
      562     else
      563        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      564     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      565   end procedure.
      566   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   procedure cur-time :
      568      define output parameter p-today as date      no-undo .
      569      define output parameter p-time  as integer   no-undo .
      570     do
      571     on error undo, return error
      572     :
      573       define variable v-date1 as date      no-undo .
      574       define variable v-date2 as date      no-undo .
      575       define variable v-time  as integer   no-undo .
      576       assign
      577         v-date1 = today
      578         v-time  = time
      579         v-date2 = today
      580       .
      581       if v-date1 <> v-date2
      582       then do:
      583         assign
      584           v-date1 = today
      585           v-time  = v-time
      586         .
      587       end.
      588       assign
      589         p-today = v-date1
      590         p-time  = v-time
      591       .
      592     end.
      593   end.
      594   function cur-time-date returns character
      595   :
      596     return string(today, '99/99/9999':U) .
      597   end.
      598   function cur-time-mjd returns decimal
      599   :
      600     define variable v-date as date      no-undo .
      601     define variable v-time as integer   no-undo .
      602     run cur-time in this-procedure
      603       (output v-date
      604       ,output v-time
      605       ) .
      606     return integer(v-date) - 2400002 + (v-time / 86400) .
      607   end.
      608   function cur-time-get-ending-index returns integer
      609   (input p-number as integer
      610   )
      611   :
      612     if p-number < 0
      613     or p-number = ?
      614     then do:
      615       return 1 .
      616     end.
      617     define variable v-rest as integer   no-undo .
      618     assign
      619       p-number = p-number modulo 100
      620     .
      621     if p-number < 20
      622     then do:
      623       assign
      624         v-rest = p-number
      625       .
      626     end.
      627     else do:
      628       assign
      629         v-rest = p-number modulo 10
      630       .
      631     end.
      632     case v-rest :
      633       when 1
      634       then do:
      635         return 2 .
      636       end.
      637       when 2 or
      638       when 3 or
      639       when 4
      640       then do:
      641         return 3 .
      642       end.
      643       otherwise do:
      644         return 1 .
      645       end.
      646     end case .
      647   end.
      648   procedure cur-time-mjd-to-date :
      649      define input  parameter i-mjd-diff as decimal no-undo.
      650      define output parameter o-Date     as date    no-undo.
      651      define output parameter o-Time     as integer no-undo.
      652      define variable v-day-number as integer   no-undo .
      653      if    i-mjd-diff < 0
      654         or i-mjd-diff = ?
      655      then do:
      656         return "?" .
      657      end.
      658      assign
      659         v-day-number = truncate(i-mjd-diff,0).
      660         o-Date = date(v-day-number + 2400002).
      661         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      662     .
      663   end.
      664   function cur-time-mjd-to-string returns character
      665   (input p-mjd-diff as decimal
      666   )
      667   :
      668     define variable v-day-number as integer   no-undo .
      669     define variable v-seconds    as integer   no-undo .
      670     define variable v-hour       as integer   no-undo .
      671     define variable v-min        as integer   no-undo .
      672     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      673     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      674     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      675     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      676     if p-mjd-diff < 0
      677     or p-mjd-diff = ?
      678     then do:
      679       return "?" .
      680     end.
      681     assign
      682       v-day-number = integer(truncate(p-mjd-diff,0))
      683       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      684     .
      685     if v-seconds > 86400
      686     then do:
      687       assign
      688         v-seconds = 86400 - 1
      689       .
      690     end.
      691     if v-seconds < 0
      692     then do:
      693       assign
      694         v-seconds = 0
      695       .
      696     end.
      697     assign
      698       v-hour = truncate(v-seconds / 3600, 0)
      699     .
      700     assign
      701       v-seconds = v-seconds modulo 3600
      702     .
      703     assign
      704       v-min = truncate(v-seconds / 60, 0)
      705     .
      706     assign
      707       v-seconds = v-seconds modulo 60
      708     .
      709     return
      710         (if v-day-number <> 0
      711           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      712           else ""
      713         )
      714       + (if v-day-number <> 0 or v-hour <> 0
      715           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      716           else ""
      717         )
      718       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      719           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      720           else ""
      721         )
      722       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      723       .
      724   end.
      725   function cur-time-string returns character
      726   :
      727     define variable v-date as date      no-undo .
      728     define variable v-time as integer   no-undo .
      729     run cur-time in this-procedure
      730       (output v-date
      731       ,output v-time
      732       ) .
      733     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      734   end.
      735   function cur-time-string-sec returns character
      736   :
      737     define variable v-date as date      no-undo .
      738     define variable v-time as integer   no-undo .
      739     run cur-time in this-procedure
      740       (output v-date
      741       ,output v-time
      742       ) .
      743     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      744   end.
      745   function cur-time-custom  returns character
      746   (input p-prefix as character
      747   ,input p-date-format as character
      748   ,input p-delimiter as character
      749   ,input p-time-format as character
      750   ,input p-suffix as character
      751   )
      752   :
      753     define variable v-date as date      no-undo .
      754     define variable v-time as integer   no-undo .
      755     run cur-time in this-procedure
      756       (output v-date
      757       ,output v-time
      758       ) .
      759     return
      760       p-prefix
      761       + string(v-date, p-date-format)
      762       + p-delimiter
      763       + string(v-time, p-time-format)
      764       + p-suffix
      765       .
      766   end.
      767   function cur-time-print  returns character
      768   :
      769     define variable v-date as date      no-undo .
      770     define variable v-time as integer   no-undo .
      771     run cur-time in this-procedure
      772       (output v-date
      773       ,output v-time
      774       ) .
      775     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      776   end.
      777   function cur-time-datetime returns datetime
      778   :
      779     define variable v-char as character no-undo .
      780     define variable v-datetime as datetime no-undo .
      781     v-char = cur-time-string().
      782     v-datetime = datetime(v-char).
      783     return  v-datetime.
      784   end.
      785   function cur-time-string-msec returns character
      786   :
      787     define variable v-date as datetime  no-undo .
      788     v-date = now.
      789     return string(v-date) .
      790   end.
