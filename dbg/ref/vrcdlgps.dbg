     1062   FUNCTION get-all-fields returns character (p-file-name as character ):
     1063   define variable v-dop as character no-undo .
     1064     find first _file no-lock where _file._file-name = p-file-name no-error .
     1065     if not available _file then return "":U.
     1066     for each _field no-lock where
     1067              _field._file-recid = recid(_file) :
     1068       assign
     1069       v-dop = v-dop + _field._field-name + chr(44)
     1070       .
     1071     end.
     1072     return trim(v-dop).
     1073   END FUNCTION.
     1074   PROCEDURE proc-full-temp-changes :
     1075     define input  parameter p-hst-handle as handle    no-undo .
     1076     define input  parameter p-main-table as character no-undo .
     1077     define input  parameter p-field-list as character no-undo .
     1078     define input  parameter p-label-form as character no-undo .
     1079     define variable h-new-buf         as handle    no-undo .
     1080     define variable h-main-buf        as handle    no-undo .
     1081     define variable h-for-comp        as handle    no-undo .
     1082     define variable v-inform          as character no-undo .
     1083     define variable v-ind             as integer   no-undo .
     1084     define variable v-idx-field-qnty  as integer   no-undo .
     1085     define variable v-num-entries     as integer   no-undo .
     1086     define variable fh                as handle    no-undo .
     1087     define variable fh-main           as handle    no-undo .
     1088     define variable fh-old            as handle    no-undo .
     1089     define variable fh-new            as handle    no-undo .
     1090     define variable v-field-name      as character no-undo .
     1091     define variable v-field-lvl       as character no-undo .
     1092     define variable v-field-form      as character no-undo .
     1093     define variable v-search-exp      as character no-undo .
     1094     define variable v-srch-main       as character no-undo .
     1095     define variable v-word-link       as character no-undo .
     1096     define variable v-av-chip-num     as logical   no-undo .
     1097     define variable v-main-pi-fld-lst as character no-undo .
     1098     define variable v-main-fld-lst    as character no-undo .
     1099     define variable v-delim-list      as character no-undo .
     1100     define variable v-label           as character no-undo .
     1101     define variable v-old-value       as character no-undo case-sensitive.
     1102     define variable v-new-value       as character no-undo case-sensitive.
     1103     define variable v-chg-fields as character no-undo.
     1104     for each temp-changes:
     1105       delete temp-changes.
     1106     end.
     1107     if not p-hst-handle:available then do:
     1108       return .
     1109     end.
     1110     create buffer h-new-buf  for table p-hst-handle .
     1111     create buffer h-main-buf for table p-main-table .
     1112     assign
     1113       v-inform = h-main-buf:index-information(1)
     1114       v-ind    = 2
     1115     .
     1116     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1117     on error undo, return error
     1118     :
     1119       assign
     1120         v-inform = h-main-buf:index-information( v-ind )
     1121         v-ind    = v-ind + 1
     1122       .
     1123     end.
     1124     if v-inform = ?
     1125       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1126       or entry( 3, v-inform, ",":U ) <> "1":U
     1127     then do:
     1128       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1129     end.
     1130     assign
     1131       v-idx-field-qnty = num-entries( v-inform ) - 4
     1132     .
     1133     if v-idx-field-qnty < 2 then do:
     1134       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1135     end.
     1136     assign
     1137       v-srch-main   = "where":U
     1138       v-word-link   = "":U
     1139       v-av-chip-num = false
     1140       v-delim-list  = "":U
     1141     .
     1142     do v-ind = 1 to v-idx-field-qnty by 2
     1143     on error undo, return error
     1144     :
     1145       assign
     1146         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1147         fh                = p-hst-handle:buffer-field( v-field-name )
     1148         fh-main           = h-main-buf:buffer-field( v-field-name )
     1149         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1150         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1151       .
     1152       if fh:data-type ="character":U then do:
     1153         assign
     1154           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1155         .
     1156       end.
     1157       else do:
     1158         assign
     1159           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1160         .
     1161       end.
     1162       if v-delim-list = "":U then do:
     1163         assign
     1164           v-delim-list = ",":U
     1165         .
     1166       end.
     1167       if v-word-link = "":U then do:
     1168         assign
     1169           v-word-link = "and":U
     1170         .
     1171       end.
     1172     end.
     1173     assign
     1174       v-delim-list  = "":U
     1175     .
     1176     do v-ind = 1 to h-main-buf:num-fields
     1177     on error undo, return error
     1178     :
     1179       assign
     1180         fh-main      = h-main-buf:buffer-field( v-ind )
     1181         v-field-name = fh-main:name
     1182       .
     1183         assign
     1184           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1185         .
     1186         if v-delim-list = "":U then do:
     1187           assign
     1188             v-delim-list = ",":U
     1189           .
     1190         end.
     1191     end.
     1192     assign
     1193       v-inform = p-hst-handle:index-information(1)
     1194       v-ind    = 2
     1195     .
     1196     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1197     on error undo, return error
     1198     :
     1199       assign
     1200         v-inform = p-hst-handle:index-information( v-ind )
     1201         v-ind    = v-ind + 1
     1202       .
     1203     end.
     1204     if v-inform = ?
     1205       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1206       or entry( 3, v-inform, ",":U ) <> "1":U
     1207     then do:
     1208       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1209     end.
     1210     assign
     1211       v-idx-field-qnty = num-entries( v-inform ) - 4
     1212     .
     1213     if v-idx-field-qnty < 2 then do:
     1214       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1215     end.
     1216     assign
     1217       v-search-exp  = "where":U
     1218       v-word-link   = "":U
     1219       v-av-chip-num = false
     1220     .
     1221     do v-ind = 1 to v-idx-field-qnty by 2
     1222     on error undo, return error
     1223     :
     1224       assign
     1225         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1226         fh           = p-hst-handle:buffer-field( v-field-name )
     1227         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1228       .
     1229       if v-field-name = "chip-num":U then do:
     1230         assign
     1231           v-search-exp  = substitute( "&1 >", v-search-exp )
     1232           v-av-chip-num = true
     1233         .
     1234       end.
     1235       else do:
     1236         assign
     1237           v-search-exp = substitute( "&1 =", v-search-exp )
     1238         .
     1239       end.
     1240       if fh:data-type ="character":U then do:
     1241         assign
     1242           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1243         .
     1244       end.
     1245       else do:
     1246         assign
     1247           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1248         .
     1249       end.
     1250       if v-word-link = "":U then do:
     1251         assign
     1252           v-word-link = "and":U
     1253         .
     1254       end.
     1255     end.
     1256     if v-av-chip-num = false then do:
     1257       message
     1258         vss-workfile vss-revision vss-description skip
     1259         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1260         "Использование данной процедуры невозможно!" skip
     1261         view-as alert-box error .
     1262       return error .
     1263     end.
     1264     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1265     if not h-new-buf:available then do:
     1266       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1267       if not h-main-buf:available then do:
     1268         assign
     1269           h-for-comp = ?
     1270         .
     1271       end.
     1272       else do:
     1273         assign
     1274           h-for-comp = h-main-buf
     1275         .
     1276       end.
     1277     end.
     1278     else do:
     1279       assign
     1280         h-for-comp = h-new-buf
     1281       .
     1282     end.
     1283     assign
     1284       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1285     .
     1286     do v-ind = 1 to v-num-entries
     1287     on error undo, return error return-value
     1288     :
     1289       assign
     1290         v-field-name = entry( v-ind, v-main-fld-lst )
     1291         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1292         v-old-value  = fh-old:buffer-value()
     1293         v-label      = trim( fh-old:label )
     1294       .
     1295       if ( trim( p-field-list ) <> "":U
     1296            and lookup( v-field-name, p-field-list ) > 0
     1297          )
     1298          or trim( p-field-list ) = "":U
     1299       then do:
     1300         if h-for-comp <> ? then do:
     1301           assign
     1302             fh-new      = h-for-comp:buffer-field( v-field-name )
     1303             v-new-value = fh-new:buffer-value()
     1304           .
     1305         end.
     1306         else do:
     1307           assign
     1308             v-new-value = "":U
     1309           .
     1310         end.
     1311         if v-old-value <> v-new-value
     1312         then do:
     1313           create temp-changes.
     1314           assign
     1315             temp-changes.t_name = p-main-table
     1316             temp-changes.f_name = v-field-name
     1317             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1318             temp-changes.v_old  = trim( v-old-value )
     1319             temp-changes.v_new  = trim( v-new-value )
     1320             temp-changes.num_   = 0
     1321             temp-changes.fNotChange = v-old-value eq v-new-value
     1322           .
     1323         end.
     1324       end.
     1325     end.
     1326     assign
     1327       v-num-entries = num-entries( p-label-form, chr(8) )
     1328     .
     1329     do v-ind = 1 to v-num-entries
     1330     on error undo, return error return-value
     1331     :
     1332       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1333         assign
     1334           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1335           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1336           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1337         .
     1338         find first temp-changes
     1339           where temp-changes.f_name = v-field-name
     1340           no-error .
     1341         if available temp-changes then do:
     1342           if trim( v-field-lvl ) <> "":U then do:
     1343             assign
     1344               temp-changes.l_name = v-field-lvl
     1345             .
     1346           end.
     1347           if trim( v-field-form ) <> "":U then do:
     1348             assign
     1349               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1350             .
     1351             if h-for-comp <> ? then do:
     1352               assign
     1353                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1354               .
     1355             end.
     1356           end.
     1357         end.
     1358       end.
     1359       else do:
     1360         message
     1361           vss-workfile vss-revision vss-description skip
     1362           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1363           substitute( "список для поля '&1': '&2'"
     1364                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1365                       ,entry( v-ind, p-label-form, chr(8) )
     1366                     ) skip
     1367           substitute( "полный список: &2", p-label-form ) skip
     1368           view-as alert-box error .
     1369       end.
     1370     end.
     1371     delete object h-new-buf .
     1372     delete object h-main-buf .
     1373   END PROCEDURE.
     1374   FUNCTION get-gr-per-val RETURNS CHARACTER
     1375     ( INPUT p-gr-per-val-code AS integer, OUTPUT p-gr-per-from AS INTEGER, OUTPUT p-gr-per-to AS INTEGER )  FORWARD.
     1376   FUNCTION get-subject RETURNS CHARACTER
     1377     ( INPUT p-deliv-subj-code AS INTEGER)  FORWARD.
     1378   FUNCTION get-type RETURNS CHARACTER
     1379   ( INPUT p-deliv-type-code AS INTEGER)  FORWARD.
     1380   DEFINE BUTTON B-Help
     1381        LABEL "Помо&щь"
     1382        SIZE 3 BY 1
     1383        BGCOLOR 8 .
     1384   DEFINE BUTTON b-lkp
     1385        LABEL "&Просмотр"
     1386        SIZE 10 BY 1.
     1387   DEFINE BUTTON B-mark
     1388        LABEL "&*"
     1389        SIZE 3 BY 1.
     1390   DEFINE BUTTON b-quit AUTO-END-KEY
     1391        LABEL "&Выход"
     1392        SIZE 10 BY 1
     1393        BGCOLOR 8 .
     1394   DEFINE BUTTON B-sel AUTO-GO
     1395        LABEL "Вы&бор"
     1396        SIZE 10 BY 1.
     1397   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1398         VIEW-AS TEXT
     1399        SIZE 6 BY 1
     1400        FGCOLOR 4  NO-UNDO.
     1401   DEFINE QUERY BR-changes FOR
     1402         temp-changes SCROLLING.
     1403   DEFINE QUERY br-vardeliv FOR
     1404         X_c-var-deliv-gr-per-val SCROLLING.
     1405   DEFINE BROWSE BR-changes
     1406     QUERY BR-changes DISPLAY
     1407         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1408   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1409   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1410       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.04.
     1411   DEFINE BROWSE br-vardeliv
     1412     QUERY br-vardeliv NO-LOCK DISPLAY
     1413         mark-string(recid(X_c-var-deliv-gr-per-val), p-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1414         usrfulnf(X_c-var-deliv-gr-per-val.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1415         X_c-var-deliv-gr-per-val.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1416         string(X_c-var-deliv-gr-per-val.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1417         entry (lookup (STRING(X_c-var-deliv-gr-per-val.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) COLUMN-LABEL "Статус"
     1418         X_c-var-deliv-gr-per-val.deliv-type-code COLUMN-LABEL "Вн.код!типа!доставки" FORMAT ">>9":U
     1419         get-type(X_c-var-deliv-gr-per-val.deliv-type-code) COLUMN-LABEL "Тип доставки" FORMAT "X(25)":U
     1420         X_c-var-deliv-gr-per-val.deliv-subj-code COLUMN-LABEL "Вн.код!субъекта!доставки" FORMAT ">>9":U
     1421         get-subject(X_c-var-deliv-gr-per-val.deliv-subj-code) COLUMN-LABEL "Субъект доставки" FORMAT "X(25)":U
     1422         X_c-var-deliv-gr-per-val.obj-type + string(X_c-var-deliv-gr-per-val.obj-code) COLUMN-LABEL "Объект!доставки" FORMAT "X(8)":U
     1423         X_c-var-deliv-gr-per-val.gr-per-val-code COLUMN-LABEL "Код группы!сроков!хранения" FORMAT ">>9":U
     1424         get-gr-per-val(X_c-var-deliv-gr-per-val.gr-per-val-code, output v-gr-per-from, v-gr-per-to) COLUMN-LABEL "Группа сроков годности" FORMAT "X(25)":U
     1425         X_c-var-deliv-gr-per-val.des FORMAT "X(100)":U WIDTH 17.25
     1426       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10.75.
     1427   DEFINE FRAME Dialog-Frame
     1428        b-quit AT ROW 1 COL 1
     1429        B-mark AT ROW 1 COL 11
     1430        B-sel AT ROW 1 COL 21
     1431        b-lkp AT ROW 1 COL 61
     1432        B-Help AT ROW 1 COL 95
     1433        br-vardeliv AT ROW 3 COL 1
     1434        BR-changes AT ROW 14 COL 1
     1435        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1436        SPACE(78.62) SKIP(20.04)
     1437       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1438            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1439            TITLE "История вариантов доставки"
     1440            CANCEL-BUTTON b-quit.
     1441   ASSIGN
     1442          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1443          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1444   ASSIGN
     1445          b-lkp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1446   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1447   OR ENDKEY OF FRAME Dialog-Frame DO:
     1448     run gbl/markqwa.p (
     1449                              input b-mark:sensitive
     1450                             , input p-rid-list) no-error.
     1451     if error-status:error then return no-apply.
     1452     APPLY "END-ERROR":U TO SELF.
     1453   END.
     1454   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1455   DO:
     1456     define variable loc#log as logical no-undo .
     1457     if available X_c-var-deliv-gr-per-val then do:
     1458   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1459   define variable v-str-recid14 as character no-undo .
     1460   define variable v-num-entry14 as integer   no-undo .
     1461   assign
     1462     v-str-recid14 = trim( string( recid( X_c-var-deliv-gr-per-val ) , "->>>>>>>>>>>9":U ) )
     1463     v-num-entry14 = lookup( v-str-recid14 , p-rid-list )
     1464   .
     1465   if v-num-entry14 > 0 then do:
     1466     assign
     1467       entry( v-num-entry14, p-rid-list ) = "":U
     1468       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1469     .
     1470   end.
     1471   else do:
     1472     assign
     1473       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1474     .
     1475   end.
     1476       loc#log = br-vardeliv:refresh() .
     1477       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1478           loc#log = br-vardeliv:select-next-row ().
     1479           apply "VALUE-CHANGED" to br-vardeliv in frame Dialog-Frame.
     1480       end.
     1481       if num-entries( p-rid-list ) = 0
     1482       then
     1483           hide mark-num in frame Dialog-Frame.
     1484       else
     1485           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1486     end.
     1487     apply "entry" to br-vardeliv in frame Dialog-Frame.
     1488   END.
     1489   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1490   DO:
     1491       if ( available X_c-var-deliv-gr-per-val ) then do:
     1492       if  ( p-rid-list = "" ) or b-mark:sensitive = no
     1493       then
     1494       p-rid-list = string( recid( X_c-var-deliv-gr-per-val ) ) .
     1495     end.
     1496   END.
     1497   ON RETURN OF br-vardeliv IN FRAME Dialog-Frame
     1498   or MOUSE-SELECT-DBLCLICK OF br-vardeliv IN FRAME Dialog-Frame
     1499       DO:
     1500       run proc-br-vardeliv no-error.
     1501     if error-status:error then return no-apply.
     1502   END.
     1503   ON VALUE-CHANGED OF br-vardeliv IN FRAME Dialog-Frame
     1504   DO:
     1505     run proc-view-changes in this-procedure no-error.
     1506   END.
     1507   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1508   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1509   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1510   on help of frame Dialog-Frame
     1511   do:
     1512     run gbl/app_help.p
     1513       (input this-procedure :file-name
     1514       ,input ''
     1515       ,input ?
     1516       ) no-error.
     1517     if error-status :error then do:
     1518       message
     1519         "Ошибка при вызове помощи"
     1520         error-status :get-message(1)
     1521         view-as alert-box .
     1522     end.
     1523   end.
     1524   run minbtn-set in this-procedure .
     1525   on choose of b-help in frame Dialog-Frame
     1526   do:
     1527     apply "help":u to frame Dialog-Frame .
     1528   end.
     1529   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1530   procedure minbtn-set :
     1531       do
     1532           on error undo, return error return-value
     1533           :
     1534           define variable ii              as integer       no-undo .
     1535           define variable fh              as widget-handle no-undo .
     1536           define variable hh              as widget-handle no-undo .
     1537           define variable v-h             as handle        extent 4 no-undo .
     1538           define variable v-name-button   as character     no-undo .
     1539           define variable v-help-old-x    as decimal       no-undo .
     1540           define variable v-help-old-y    as decimal       no-undo .
     1541           define variable v-help-old-size as decimal       no-undo .
     1542           define variable v-frame-width   as decimal       no-undo .
     1543           define variable jj              as integer       no-undo .
     1544           do
     1545               on error undo, return error
     1546               :
     1547               assign
     1548                   v-frame-width = frame Dialog-Frame:width - 0.3
     1549                   fh            = frame Dialog-Frame:first-child
     1550                   hh            = fh:first-child
     1551                   ii            = 1
     1552                   .
     1553               do while valid-handle(hh):
     1554                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1555                   do:
     1556                       case lc(hh:name) :
     1557                           when "b-help" then
     1558                               do:
     1559                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1560                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1561                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1562                                   hh:TOOLTIP = "Помощь" .
     1563                                   v-help-old-x = hh:column .
     1564                                   v-help-old-y = hh:row    .
     1565                                   v-help-old-size = hh:width .
     1566                                   hh:width-chars = 2.5 .
     1567                               end.
     1568                           when "b-print" then
     1569                               do:
     1570                                   hh:load-image("cmp/b-print.bmp":u) .
     1571                                   hh:TOOLTIP = "Печать" .
     1572                                   v-h[ii] = hh:handle .
     1573                                   ii = ii + 1 .
     1574                                   hh:width-chars = 3 .
     1575                               end.
     1576                           when "b-history" or
     1577                           when "b-hist" then
     1578                               do:
     1579                                   hh:load-image("cmp/b-hist.bmp":u) .
     1580                                   hh:TOOLTIP = "История" .
     1581                                   v-h[ii] = hh:handle .
     1582                                   ii = ii + 1 .
     1583                                   hh:width-chars = 3 .
     1584                               end.
     1585                           when "b-sch" then
     1586                               do:
     1587                                   hh:load-image("cmp/b-sch.bmp":u) .
     1588                                   hh:TOOLTIP = "Установка Фильтра" .
     1589                                   v-h[ii] = hh:handle .
     1590                                   ii = ii + 1 .
     1591                                   hh:width-chars = 3 .
     1592                               end.
     1593                           when "b-hist-user" then
     1594                               do:
     1595                                   hh:load-image("cmp/b-hist.bmp":u) .
     1596                                   hh:TOOLTIP = "История пользователя" .
     1597                                   ii = ii + 1 .
     1598                               end.
     1599                       end case.
     1600                   end.
     1601                   hh = hh:next-sibling.
     1602               end.
     1603               b-help:column = v-frame-width - b-help:width-chars.
     1604               jj = 0.
     1605               repeat ii = 4 to 1 by -1 :
     1606                   if valid-handle (v-h[ii] ) then
     1607                   do:
     1608                       jj  = jj + 1 .
     1609                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1610                       v-h[ii]:row    = v-help-old-y .
     1611                   end.
     1612               end.
     1613           end.
     1614       end.
     1615   end procedure.
     1616   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1617   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1618   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1619   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1620   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1621   define variable v-diasize-current-frame-height as decimal   no-undo .
     1622   define variable v-diasize-change-size          as logical   no-undo .
     1623   define variable v-diasize-resize-button        as handle    no-undo .
     1624   define variable v-diasize-wndmax               as logical   no-undo .
     1625   define variable v-diasize-wndstore             as logical   no-undo .
     1626   define variable v-diasize-proc-name            as character no-undo .
     1627   define variable v-diasize-browse-handle        as handle    no-undo .
     1628   define variable v-diasize-browse-number        as integer   no-undo .
     1629   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1630   define temp-table temp-diasize-handle no-undo
     1631     field handle-value  as handle
     1632     field save-position as decimal
     1633     index xpk is primary unique handle-value
     1634     .
     1635   define temp-table temp-browse-handle no-undo
     1636     field browse-type   as character
     1637     field browse-number as integer
     1638     field browse-handle as handle
     1639     field original-size as decimal
     1640     index xpk is primary unique browse-type browse-number
     1641     index xie browse-type browse-handle
     1642   .
     1643   procedure diasize_change-height :
     1644     define input  parameter p-change-value  as decimal   no-undo .
     1645     define input  parameter p-move-resize   as logical   no-undo .
     1646     define variable v-field-group-handle    as handle    no-undo .
     1647     define variable v-object-handle         as handle    no-undo .
     1648     define variable v-frame-height          as decimal   no-undo .
     1649     define variable v-frame-virtual-height  as decimal   no-undo .
     1650     define variable v-browse-height         as decimal   no-undo .
     1651     define variable v-window-height         as decimal   no-undo .
     1652     define variable v-window-virtual-height as decimal   no-undo .
     1653     define variable v-change-sign           as integer   no-undo .
     1654     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1655     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1656     if p-change-value > 0
     1657     then do:
     1658       if frame Dialog-Frame :height + p-change-value
     1659           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1660       then do:
     1661         assign
     1662           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1663                           - (frame Dialog-Frame :height-chars)
     1664         .
     1665         if p-change-value <= 0
     1666         then do:
     1667           run diasize_position-resize-button in this-procedure .
     1668           return .
     1669         end.
     1670       end.
     1671     end.
     1672     if p-change-value < 0
     1673     then do:
     1674       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1675       then do:
     1676         assign
     1677           p-change-value = v-diasize-orig-frame-height
     1678                          - (frame Dialog-Frame :height-chars)
     1679         .
     1680         if p-change-value >= 0
     1681         then do:
     1682           run diasize_position-resize-button in this-procedure .
     1683           return .
     1684         end.
     1685       end.
     1686     end.
     1687     if p-change-value >= 0
     1688     then do:
     1689       assign
     1690         v-change-sign = 1
     1691       .
     1692     end.
     1693     else do:
     1694       assign
     1695         v-change-sign = -1
     1696       .
     1697     end.
     1698     assign
     1699       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1700     .
     1701     if p-change-value = 0
     1702     then do:
     1703       run diasize_position-resize-button in this-procedure .
     1704       return .
     1705     end.
     1706     move_block:
     1707     do
     1708     on error undo move_block, retry move_block
     1709     :
     1710       if retry
     1711       then do:
     1712         do
     1713         on error undo move_block, leave move_block
     1714         :
     1715           if p-change-value > 0
     1716           then do:
     1717             for each buf_temp-diasize-handle
     1718             on error undo, next
     1719             :
     1720               assign
     1721                 v-object-handle = buf_temp-diasize-handle.handle-value
     1722               .
     1723               if v-object-handle <> v-diasize-resize-button
     1724               then do:
     1725                 assign
     1726                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1727                 .
     1728               end.
     1729             end.
     1730             assign
     1731               v-diasize-browse-handle :height = v-browse-height
     1732             .
     1733             for each buf_temp-browse-handle
     1734               where buf_temp-browse-handle.browse-type = 'height':u
     1735             on error undo, next
     1736             :
     1737               assign
     1738                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1739               .
     1740             end.
     1741             assign
     1742               frame Dialog-Frame :height = v-frame-height
     1743             .
     1744             if frame Dialog-Frame :scrollable = true
     1745             then do:
     1746               assign
     1747                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1748               .
     1749             end.
     1750             run diasize_position-resize-button in this-procedure .
     1751           end.
     1752           else do:
     1753             if frame Dialog-Frame :scrollable = true
     1754             then do:
     1755               assign
     1756                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1757               .
     1758             end.
     1759             assign
     1760               frame Dialog-Frame :height = v-frame-height
     1761             .
     1762             assign
     1763               v-diasize-browse-handle :height = v-browse-height
     1764             .
     1765             for each buf_temp-browse-handle
     1766               where buf_temp-browse-handle.browse-type = 'height':u
     1767             on error undo, next
     1768             :
     1769               assign
     1770                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1771               .
     1772             end.
     1773             for each buf_temp-diasize-handle
     1774             on error undo, next
     1775             :
     1776               assign
     1777                 v-object-handle = buf_temp-diasize-handle.handle-value
     1778               .
     1779               if v-object-handle <> v-diasize-resize-button
     1780               then do:
     1781                 assign
     1782                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1783                 .
     1784               end.
     1785             end.
     1786             run diasize_position-resize-button in this-procedure .
     1787           end.
     1788           assign
     1789             v-diasize-change-size = false
     1790           .
     1791           leave move_block .
     1792         end.
     1793       end.
     1794       assign
     1795         v-diasize-need-full-display = true
     1796       .
     1797       if v-diasize-change-size = false
     1798       then do:
     1799         assign
     1800           v-diasize-change-size = true
     1801         .
     1802       end.
     1803       else do:
     1804         return .
     1805       end.
     1806       assign
     1807         v-frame-height = frame Dialog-Frame :height
     1808         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1809         v-browse-height = v-diasize-browse-handle :height
     1810       .
     1811       for each buf_temp-browse-handle
     1812         where buf_temp-browse-handle.browse-type = 'height':u
     1813       :
     1814         assign
     1815           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1816         .
     1817       end.
     1818       for each buf_temp-diasize-handle
     1819       :
     1820         delete buf_temp-diasize-handle .
     1821       end.
     1822       assign
     1823         v-field-group-handle = frame Dialog-Frame :first-child
     1824       .
     1825       do while valid-handle(v-field-group-handle)
     1826       :
     1827         assign
     1828           v-object-handle = v-field-group-handle :first-child
     1829         .
     1830         do while valid-handle(v-object-handle)
     1831         :
     1832           if  v-object-handle <> v-diasize-browse-handle :handle
     1833           and can-query(v-object-handle, "row")
     1834           and can-query(v-object-handle, "height")
     1835           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1836           then do:
     1837             find first buf_temp-browse-handle
     1838               where buf_temp-browse-handle.browse-type   = 'height':u
     1839                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1840               no-error .
     1841             if available buf_temp-browse-handle
     1842             then do:
     1843             end.
     1844             else do:
     1845               create buf_temp-diasize-handle .
     1846               assign
     1847                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1848                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1849               .
     1850             end.
     1851           end.
     1852           assign
     1853             v-object-handle = v-object-handle :next-sibling
     1854           .
     1855         end.
     1856         assign
     1857           v-field-group-handle = v-field-group-handle :next-sibling
     1858         .
     1859       end.
     1860       do with frame Dialog-Frame
     1861       :
     1862         hide v-diasize-resize-button .
     1863         assign
     1864           v-diasize-resize-button :row    = 1
     1865           v-diasize-resize-button :column = 1
     1866         .
     1867       end.
     1868       if p-change-value > 0
     1869       then do:
     1870         if frame Dialog-Frame :scrollable = true
     1871         then do:
     1872           assign
     1873             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1874             no-error .
     1875           if error-status :error
     1876           or error-status :get-message(1) <> ""
     1877           then do:
     1878             undo move_block, retry move_block .
     1879           end.
     1880         end.
     1881         assign
     1882           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1883           no-error .
     1884         if error-status :error
     1885         or error-status :get-message(1) <> ""
     1886         then do:
     1887           undo move_block, retry move_block .
     1888         end.
     1889         assign
     1890           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1891           no-error .
     1892         if error-status :error
     1893         or error-status :get-message(1) <> ""
     1894         then do:
     1895           undo move_block, retry move_block .
     1896         end.
     1897         for each buf_temp-browse-handle
     1898           where buf_temp-browse-handle.browse-type = 'height':u
     1899         on error undo move_block, retry move_block
     1900         :
     1901           assign
     1902             buf_temp-browse-handle.browse-handle :height
     1903               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1904             no-error .
     1905           if error-status :error
     1906           or error-status :get-message(1) <> ""
     1907           then do:
     1908             undo move_block, retry move_block .
     1909           end.
     1910         end.
     1911         for each buf_temp-diasize-handle
     1912         on error undo move_block, retry move_block
     1913         :
     1914           assign
     1915             v-object-handle = buf_temp-diasize-handle.handle-value
     1916           .
     1917           if v-object-handle <> v-diasize-resize-button
     1918           then do:
     1919             assign
     1920               v-object-handle :row = v-object-handle :row + p-change-value
     1921               no-error .
     1922             if error-status :error
     1923             or error-status :get-message(1) <> ""
     1924             then do:
     1925               undo move_block, retry move_block .
     1926             end.
     1927           end.
     1928         end.
     1929       end.
     1930       else do:
     1931         for each buf_temp-diasize-handle
     1932         on error undo move_block, retry move_block
     1933         :
     1934           assign
     1935             v-object-handle = buf_temp-diasize-handle.handle-value
     1936           .
     1937           if v-object-handle <> v-diasize-resize-button
     1938           then do:
     1939             assign
     1940               v-object-handle :row = v-object-handle :row + p-change-value
     1941               no-error .
     1942             if error-status :error
     1943             or error-status :get-message(1) <> ""
     1944             then do:
     1945               undo move_block, retry move_block .
     1946             end.
     1947           end.
     1948         end.
     1949         assign
     1950           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1951           no-error .
     1952         if error-status :error
     1953         or error-status :get-message(1) <> ""
     1954         then do:
     1955           undo move_block, retry move_block .
     1956         end.
     1957         for each buf_temp-browse-handle
     1958           where buf_temp-browse-handle.browse-type = 'height':u
     1959         on error undo move_block, retry move_block
     1960         :
     1961           assign
     1962             buf_temp-browse-handle.browse-handle :height
     1963               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1964             no-error .
     1965           if error-status :error
     1966           or error-status :get-message(1) <> ""
     1967           then do:
     1968             undo move_block, retry move_block .
     1969           end.
     1970         end.
     1971         assign
     1972           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1973           no-error .
     1974         if error-status :error
     1975         or error-status :get-message(1) <> ""
     1976         then do:
     1977           undo move_block, retry move_block .
     1978         end.
     1979         if frame Dialog-Frame :scrollable = true
     1980         then do:
     1981           assign
     1982             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1983             no-error .
     1984           if error-status :error
     1985           or error-status :get-message(1) <> ""
     1986           then do:
     1987             undo move_block, retry move_block .
     1988           end.
     1989         end.
     1990       end.
     1991       if p-move-resize = true
     1992       then do:
     1993         run diasize_position-resize-button in this-procedure .
     1994       end.
     1995       if v-diasize-wndstore = true
     1996       then do:
     1997         if connected("ub") = true
     1998         then do:
     1999           define variable v-cntxt-db-num        as integer   no-undo .
     2000           define variable v-cntxt-userid        as character no-undo .
     2001           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2002                                             , OUTPUT v-cntxt-userid
     2003                                             ) .
     2004           run gbl/wndsizew.p
     2005             (input  v-cntxt-db-num
     2006             ,input  v-cntxt-userid
     2007             ,input  v-diasize-proc-name
     2008             ,input  'height':u
     2009             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2010             ) .
     2011         end.
     2012       end.
     2013     end.
     2014     assign
     2015       v-diasize-change-size = false
     2016     .
     2017   end procedure.
     2018   procedure diasize_set-height :
     2019     define input  parameter p-new-height  as decimal   no-undo .
     2020     define input  parameter p-move-resize as logical   no-undo .
     2021     do
     2022     on error undo, return error return-value
     2023     :
     2024       run diasize_change-height in this-procedure
     2025         (input  (p-new-height - frame Dialog-Frame :height)
     2026         ,input  p-move-resize
     2027         ) .
     2028     end.
     2029   end procedure.
     2030   procedure diasize_change-width :
     2031     define input  parameter p-change-value as decimal   no-undo .
     2032     define input  parameter p-move-resize  as logical   no-undo .
     2033     define variable v-field-group-handle   as handle    no-undo .
     2034     define variable v-object-handle        as handle    no-undo .
     2035     define variable v-frame-width          as decimal   no-undo .
     2036     define variable v-frame-virtual-width  as decimal   no-undo .
     2037     define variable v-browse-width         as decimal   no-undo .
     2038     define variable v-window-width         as decimal   no-undo .
     2039     define variable v-window-virtual-width as decimal   no-undo .
     2040     define variable v-change-sign          as integer   no-undo .
     2041     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2042     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2043     if p-change-value > 0
     2044     then do:
     2045       if frame Dialog-Frame :width + p-change-value >
     2046           session :width-chars
     2047       then do:
     2048         assign
     2049           p-change-value = session :width-chars - frame Dialog-Frame :width
     2050         .
     2051         if p-change-value <= 0
     2052         then do:
     2053           run diasize_position-resize-button in this-procedure .
     2054           return .
     2055         end.
     2056       end.
     2057     end.
     2058     if p-change-value < 0
     2059     then do:
     2060       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2061       then do:
     2062         assign
     2063           p-change-value = v-diasize-orig-frame-width
     2064                          - frame Dialog-Frame :width
     2065         .
     2066         if p-change-value >= 0
     2067         then do:
     2068           run diasize_position-resize-button in this-procedure .
     2069           return .
     2070         end.
     2071       end.
     2072     end.
     2073     if p-change-value >= 0
     2074     then do:
     2075       assign
     2076         v-change-sign = 1
     2077       .
     2078     end.
     2079     else do:
     2080       assign
     2081         v-change-sign = -1
     2082       .
     2083     end.
     2084     assign
     2085       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2086     .
     2087     if p-change-value = 0
     2088     then do:
     2089       run diasize_position-resize-button in this-procedure .
     2090       return .
     2091     end.
     2092     move_block:
     2093     do
     2094     on error undo move_block, leave move_block
     2095     :
     2096       if retry
     2097       then do:
     2098         do
     2099         on error undo move_block, leave move_block
     2100         :
     2101           if p-change-value > 0
     2102           then do:
     2103             for each buf_temp-diasize-handle
     2104             on error undo, next
     2105             :
     2106               assign
     2107                 v-object-handle = buf_temp-diasize-handle.handle-value
     2108               .
     2109               if v-object-handle <> v-diasize-resize-button
     2110               then do:
     2111                 assign
     2112                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2113                 .
     2114               end.
     2115             end.
     2116             assign
     2117               v-diasize-browse-handle :width = v-browse-width
     2118             .
     2119             for each buf_temp-browse-handle
     2120               where buf_temp-browse-handle.browse-type = 'width':u
     2121             on error undo, next
     2122             :
     2123               assign
     2124                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2125               .
     2126             end.
     2127             assign
     2128               frame Dialog-Frame :width = v-frame-width
     2129             .
     2130             if frame Dialog-Frame :scrollable = true
     2131             then do:
     2132               assign
     2133                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2134               .
     2135             end.
     2136             run diasize_position-resize-button in this-procedure .
     2137           end.
     2138           else do:
     2139             if frame Dialog-Frame :scrollable = true
     2140             then do:
     2141               assign
     2142                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2143               .
     2144             end.
     2145             assign
     2146               frame Dialog-Frame :width = v-frame-width
     2147             .
     2148             for each buf_temp-browse-handle
     2149               where buf_temp-browse-handle.browse-type = 'width':u
     2150             on error undo, next
     2151             :
     2152               assign
     2153                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2154               .
     2155             end.
     2156             assign
     2157               v-diasize-browse-handle :width = v-browse-width
     2158             .
     2159             for each buf_temp-diasize-handle
     2160             on error undo, next
     2161             :
     2162               assign
     2163                 v-object-handle = buf_temp-diasize-handle.handle-value
     2164               .
     2165               if v-object-handle <> v-diasize-resize-button
     2166               then do:
     2167                 assign
     2168                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2169                 .
     2170               end.
     2171             end.
     2172             run diasize_position-resize-button in this-procedure .
     2173           end.
     2174           assign
     2175             v-diasize-change-size = false
     2176           .
     2177           leave move_block .
     2178         end.
     2179       end.
     2180       assign
     2181         v-diasize-need-full-display = true
     2182       .
     2183       if v-diasize-change-size = false
     2184       then do:
     2185         assign
     2186           v-diasize-change-size = true
     2187         .
     2188       end.
     2189       else do:
     2190         return .
     2191       end.
     2192       assign
     2193         v-frame-width = frame Dialog-Frame :width
     2194         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2195         v-browse-width = v-diasize-browse-handle :width
     2196       .
     2197       for each buf_temp-browse-handle
     2198         where buf_temp-browse-handle.browse-type = 'width':u
     2199       :
     2200         assign
     2201           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2202         .
     2203       end.
     2204       for each buf_temp-diasize-handle
     2205       :
     2206         delete buf_temp-diasize-handle .
     2207       end.
     2208       assign
     2209         v-field-group-handle = frame Dialog-Frame :first-child
     2210       .
     2211       do while valid-handle(v-field-group-handle)
     2212       :
     2213         assign
     2214           v-object-handle = v-field-group-handle :first-child
     2215         .
     2216         do while valid-handle(v-object-handle)
     2217         :
     2218           if  v-object-handle <> v-diasize-browse-handle :handle
     2219           and v-object-handle <> v-diasize-resize-button
     2220           and can-query(v-object-handle, "row")
     2221           and can-query(v-object-handle, "height")
     2222           and ( v-object-handle :col + v-object-handle :width
     2223                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2224               )
     2225           then do:
     2226             find first buf_temp-browse-handle
     2227               where buf_temp-browse-handle.browse-type   = 'width':u
     2228                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2229               no-error .
     2230             if available buf_temp-browse-handle
     2231             then do:
     2232             end.
     2233             else do:
     2234               create buf_temp-diasize-handle .
     2235               assign
     2236                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2237                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2238               .
     2239             end.
     2240           end.
     2241           assign
     2242             v-object-handle = v-object-handle :next-sibling
     2243           .
     2244         end.
     2245         assign
     2246           v-field-group-handle = v-field-group-handle :next-sibling
     2247         .
     2248       end.
     2249       do with frame Dialog-Frame
     2250       :
     2251         hide v-diasize-resize-button .
     2252         v-diasize-resize-button :row = 1.
     2253         v-diasize-resize-button :column = 1.
     2254       end.
     2255       if p-change-value > 0
     2256       then do:
     2257         if frame Dialog-Frame :scrollable = true
     2258         then do:
     2259           assign
     2260             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2261             no-error .
     2262           if error-status :error
     2263           or error-status :get-message(1) <> ""
     2264           then do:
     2265             undo move_block, retry move_block.
     2266           end.
     2267         end.
     2268         assign
     2269           frame Dialog-Frame :width = v-frame-width + p-change-value
     2270           no-error .
     2271         if error-status :error
     2272         or error-status :get-message(1) <> ""
     2273         then do:
     2274           undo move_block, retry move_block.
     2275         end.
     2276         assign
     2277           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2278         no-error .
     2279         if error-status :error
     2280         or error-status :get-message(1) <> ""
     2281         then do:
     2282           undo move_block, retry move_block.
     2283         end.
     2284         for each buf_temp-browse-handle
     2285           where buf_temp-browse-handle.browse-type = 'width':u
     2286         on error undo move_block, retry move_block
     2287         :
     2288           assign
     2289             buf_temp-browse-handle.browse-handle :width
     2290               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2291             no-error .
     2292           if error-status :error
     2293           or error-status :get-message(1) <> ""
     2294           then do:
     2295             undo move_block, retry move_block .
     2296           end.
     2297         end.
     2298         for each buf_temp-diasize-handle
     2299         on error undo move_block, retry move_block
     2300         :
     2301           assign
     2302             v-object-handle = buf_temp-diasize-handle.handle-value
     2303           .
     2304           if v-object-handle <> v-diasize-resize-button
     2305           then do:
     2306             assign
     2307               v-object-handle :col = v-object-handle :col + p-change-value
     2308               no-error .
     2309             if error-status :error
     2310             or error-status :get-message(1) <> ""
     2311             then do:
     2312               undo move_block, retry move_block .
     2313             end.
     2314           end.
     2315         end.
     2316       end.
     2317       else do:
     2318         for each buf_temp-diasize-handle
     2319         on error undo move_block, retry move_block
     2320         :
     2321           assign
     2322             v-object-handle = buf_temp-diasize-handle.handle-value
     2323           .
     2324           if v-object-handle <> v-diasize-resize-button
     2325           then do:
     2326             assign
     2327               v-object-handle :col = v-object-handle :col + p-change-value
     2328               no-error .
     2329             if error-status :error
     2330             or error-status :get-message(1) <> ""
     2331             then do:
     2332               undo move_block, retry move_block .
     2333             end.
     2334           end.
     2335         end.
     2336         for each buf_temp-browse-handle
     2337           where buf_temp-browse-handle.browse-type = 'width':u
     2338         on error undo move_block, retry move_block
     2339         :
     2340           assign
     2341             buf_temp-browse-handle.browse-handle :width
     2342               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2343             no-error .
     2344           if error-status :error
     2345           or error-status :get-message(1) <> ""
     2346           then do:
     2347             undo move_block, retry move_block .
     2348           end.
     2349         end.
     2350         assign
     2351           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2352           no-error .
     2353         if error-status :error
     2354         or error-status :get-message(1) <> ""
     2355         then do:
     2356           undo move_block, retry move_block.
     2357         end.
     2358         assign
     2359           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2360         no-error .
     2361         if error-status :error
     2362         or error-status :get-message(1) <> ""
     2363         then do:
     2364           undo move_block, retry move_block.
     2365         end.
     2366         if frame Dialog-Frame :scrollable = true
     2367         then do:
     2368           assign
     2369             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2370           no-error .
     2371           if error-status :error
     2372           or error-status :get-message(1) <> ""
     2373           then do:
     2374             undo move_block, retry move_block.
     2375           end.
     2376         end.
     2377       end.
     2378       if p-move-resize
     2379       then do:
     2380         run diasize_position-resize-button in this-procedure .
     2381       end.
     2382       if v-diasize-wndstore = true
     2383       then do:
     2384         if connected("ub") = true
     2385         then do:
     2386           define variable v-cntxt-db-num        as integer   no-undo .
     2387           define variable v-cntxt-userid        as character no-undo .
     2388           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2389                                             , OUTPUT v-cntxt-userid
     2390                                             ) .
     2391           run gbl/wndsizew.p
     2392             (input  v-cntxt-db-num
     2393             ,input  v-cntxt-userid
     2394             ,input  v-diasize-proc-name
     2395             ,input  'width':u
     2396             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2397             ) .
     2398         end.
     2399       end.
     2400     end.
     2401     assign
     2402       v-diasize-change-size = false
     2403     .
     2404   end procedure.
     2405   procedure diasize_set-width :
     2406     define input  parameter p-new-width  as decimal   no-undo .
     2407     define input  parameter p-move-resize as logical   no-undo .
     2408     do
     2409     on error undo, return error return-value
     2410     :
     2411       run diasize_change-width in this-procedure
     2412         (input  (p-new-width - frame Dialog-Frame :width)
     2413         ,input  p-move-resize
     2414         ) .
     2415     end.
     2416   end procedure.
     2417   procedure diasize_position-resize-button :
     2418     do with frame Dialog-Frame
     2419     :
     2420       hide v-diasize-resize-button .
     2421       assign
     2422         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2423                     - 1
     2424                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2425         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2426                     - 1
     2427                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2428       .
     2429       view v-diasize-resize-button .
     2430     end.
     2431   end procedure.
     2432   on alt-right anywhere
     2433   do:
     2434     run diasize_change-width in this-procedure
     2435       (input 1
     2436       ,input true
     2437       ) .
     2438     return no-apply .
     2439   end.
     2440   on alt-left anywhere
     2441   do:
     2442     run diasize_change-width in this-procedure
     2443       (input -1
     2444       ,input true
     2445       ) .
     2446     return no-apply .
     2447   end.
     2448   on alt-down anywhere
     2449   do:
     2450     run diasize_change-height in this-procedure
     2451       (input 1
     2452       ,input true
     2453       ) .
     2454     return no-apply .
     2455   end.
     2456   on alt-up anywhere
     2457   do:
     2458     run diasize_change-height in this-procedure
     2459       (input -1
     2460       ,input true
     2461       ) .
     2462     return no-apply .
     2463   end.
     2464   on alt-enter of frame Dialog-Frame
     2465   do:
     2466     run diasize_maximize in this-procedure
     2467       (input  ?
     2468       ).
     2469     return no-apply .
     2470   end.
     2471   procedure diasize_end-move :
     2472     do
     2473     on error undo, return error return-value
     2474     :
     2475       define variable v-row-delta as decimal   no-undo .
     2476       define variable v-col-delta as decimal   no-undo .
     2477       define variable v-new-row as decimal   no-undo .
     2478       define variable v-new-col as decimal   no-undo .
     2479       assign
     2480         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2481         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2482       .
     2483       assign
     2484         v-row-delta = v-new-row - frame Dialog-Frame :height
     2485         v-col-delta = v-new-col - frame Dialog-Frame :width
     2486       .
     2487       run diasize_change-height in this-procedure
     2488         (input v-row-delta
     2489         ,input true
     2490         ) .
     2491       run diasize_change-width in this-procedure
     2492         (input v-col-delta
     2493         ,input true
     2494         ) .
     2495     end.
     2496   end procedure.
     2497   procedure diasize_maximize :
     2498     define input  parameter p-action as logical   no-undo .
     2499     do
     2500     on error undo, return error return-value
     2501     :
     2502       if p-action = ?
     2503       then do:
     2504         if v-diasize-need-maximize = true
     2505         then do:
     2506           assign
     2507             p-action = true
     2508           .
     2509         end.
     2510         else do:
     2511           assign
     2512             p-action = false
     2513           .
     2514         end.
     2515       end.
     2516       if p-action = true
     2517       then do:
     2518         run diasize_change-height in this-procedure
     2519           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2520               - frame Dialog-Frame :height-chars
     2521           ,input true
     2522           ) .
     2523         run diasize_change-width in this-procedure
     2524           (input session :width-chars
     2525               - frame Dialog-Frame :width-chars
     2526           ,input true
     2527           ) .
     2528         assign
     2529           v-diasize-need-maximize = false
     2530         .
     2531       end.
     2532       else do:
     2533         run diasize_change-width in this-procedure
     2534           (input v-diasize-orig-frame-width
     2535               - frame Dialog-Frame :width-chars
     2536           ,input true
     2537           ) .
     2538         run diasize_change-height in this-procedure
     2539           (input v-diasize-orig-frame-height
     2540               - frame Dialog-Frame :height-chars
     2541           ,input true
     2542           ) .
     2543         assign
     2544           v-diasize-need-maximize = true
     2545         .
     2546       end.
     2547     end.
     2548   end procedure.
     2549   procedure diasize_restore-orig-size :
     2550     do
     2551     on error undo, return error return-value
     2552     :
     2553       assign
     2554         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2555         v-diasize-current-frame-height = frame Dialog-Frame :height
     2556       .
     2557       run diasize_set-height in this-procedure
     2558         (input  v-diasize-orig-frame-height
     2559         ,input  true
     2560         ) .
     2561       run diasize_set-width in this-procedure
     2562         (input  v-diasize-orig-frame-width
     2563         ,input  true
     2564         ) .
     2565     end.
     2566   end procedure.
     2567   procedure diasize_restore-current-size :
     2568     do
     2569     on error undo, return error return-value
     2570     :
     2571       run diasize_set-height in this-procedure
     2572         (input  v-diasize-current-frame-height
     2573         ,input  true
     2574         ) .
     2575       run diasize_set-width in this-procedure
     2576         (input  v-diasize-current-frame-width
     2577         ,input  true
     2578         ) .
     2579     end.
     2580   end procedure.
     2581   procedure diasize_set-browse-handle :
     2582     define input  parameter p-browse-handle as handle   no-undo .
     2583     define buffer buf_temp-browse-handle for temp-browse-handle .
     2584     do
     2585     on error undo, return error return-value
     2586     :
     2587       assign
     2588         v-diasize-browse-handle = p-browse-handle
     2589       .
     2590       for each buf_temp-browse-handle
     2591       on error undo, return error return-value
     2592       :
     2593         delete buf_temp-browse-handle .
     2594       end.
     2595     end.
     2596   end procedure.
     2597   procedure diasize_add_browse :
     2598     define input  parameter p-browse-type   as character no-undo .
     2599     define input  parameter p-browse-handle as handle    no-undo .
     2600     define buffer buf_temp-browse-handle for temp-browse-handle .
     2601     do
     2602     on error undo, return error return-value
     2603     :
     2604       assign
     2605         v-diasize-browse-number = v-diasize-browse-number + 1
     2606       .
     2607       create buf_temp-browse-handle .
     2608       assign
     2609         buf_temp-browse-handle.browse-type   = p-browse-type
     2610         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2611         buf_temp-browse-handle.browse-handle = p-browse-handle
     2612       .
     2613     end.
     2614   end procedure.
     2615   procedure diasize_init :
     2616     define variable v-default-value    as logical   no-undo .
     2617     define variable v-restore-saved    as logical   no-undo .
     2618     define variable v-resize-value-str as character no-undo .
     2619     do
     2620     on error undo, return error return-value
     2621     :
     2622       do with frame Dialog-Frame
     2623       :
     2624         assign
     2625           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2626           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2627           v-diasize-browse-handle     = browse BR-vardeliv :handle
     2628         .
     2629         create button v-diasize-resize-button
     2630         assign
     2631           parent        = frame Dialog-Frame :first-child
     2632           label         = "s"
     2633           height-pixels = 16
     2634           width-pixels  = 16
     2635           visible       = true
     2636           sensitive     = true
     2637           movable       = true
     2638           triggers:
     2639             on end-move persistent run diasize_end-move in this-procedure .
     2640           end triggers.
     2641         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2642         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2643         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2644         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2645         assign
     2646           v-diasize-wndmax = false
     2647         .
     2648         if connected("ub") = true
     2649         then do:
     2650           define variable v-cntxt-db-num        as integer   no-undo .
     2651           define variable v-cntxt-userid        as character no-undo .
     2652           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2653                                             , OUTPUT v-cntxt-userid
     2654                                             ) .
     2655           run gbl/wndpar_r.p
     2656             (input  v-cntxt-db-num
     2657             ,input  v-cntxt-userid
     2658             ,input  'wndmax':U
     2659             ,output v-diasize-wndmax
     2660             ,output v-default-value
     2661             ) .
     2662         end.
     2663         assign
     2664           v-diasize-wndstore = false
     2665         .
     2666         if connected("ub") = true
     2667         then do:
     2668           run gbl/wndpar_r.p
     2669             (input  v-cntxt-db-num
     2670             ,input  v-cntxt-userid
     2671             ,input  'wndstore':U
     2672             ,output v-diasize-wndstore
     2673             ,output v-default-value
     2674             ) .
     2675         end.
     2676         assign
     2677           v-diasize-proc-name = entry(1, program-name(2), '.')
     2678         .
     2679         if v-diasize-wndstore = true
     2680         then do:
     2681           assign
     2682             v-restore-saved = false
     2683           .
     2684           if connected("ub") = true
     2685           then do:
     2686             run gbl/wndsizer.p
     2687               (input  v-cntxt-db-num
     2688               ,input  v-cntxt-userid
     2689               ,input  v-diasize-proc-name
     2690               ,input  'height':u
     2691               ,output v-resize-value-str
     2692               ) .
     2693             if v-resize-value-str <> '':U
     2694             then do:
     2695               run diasize_change-height in this-procedure
     2696                 (input  integer(v-resize-value-str)
     2697                 ,input  true
     2698                 ) .
     2699               assign
     2700                 v-restore-saved = true
     2701               .
     2702             end.
     2703           end.
     2704           if connected("ub") = true
     2705           then do:
     2706             run gbl/wndsizer.p
     2707               (input  v-cntxt-db-num
     2708               ,input  v-cntxt-userid
     2709               ,input  v-diasize-proc-name
     2710               ,input  'width':u
     2711               ,output v-resize-value-str
     2712               ) .
     2713             if v-resize-value-str <> '':U
     2714             then do:
     2715               run diasize_change-width in this-procedure
     2716                 (input  integer(v-resize-value-str)
     2717                 ,input  true
     2718                 ) .
     2719               assign
     2720                 v-restore-saved = true
     2721               .
     2722             end.
     2723           end.
     2724           if v-restore-saved <> true
     2725           then do:
     2726             if v-diasize-wndmax = true
     2727             then do:
     2728               run diasize_maximize in this-procedure
     2729                 (input  true
     2730                 ) .
     2731             end.
     2732           end.
     2733         end.
     2734         else do:
     2735           if v-diasize-wndmax = true
     2736           then do:
     2737             run diasize_maximize in this-procedure
     2738               (input  true
     2739               ) .
     2740           end.
     2741         end.
     2742       end.
     2743     end.
     2744   end procedure.
     2745   procedure diasize_need-full-display :
     2746     define output parameter p-need-full-display as logical   no-undo .
     2747     do
     2748     on error undo, return error return-value
     2749     :
     2750       assign
     2751         p-need-full-display = v-diasize-need-full-display
     2752       .
     2753       assign
     2754         v-diasize-need-full-display = false
     2755       .
     2756     end.
     2757   end procedure.
     2758   procedure get-context :
     2759      define output parameter p-db-num as integer          no-undo.
     2760      define output parameter p-user-id as character        no-undo.
     2761      define variable v-login               as character    no-undo.
     2762      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2763      define buffer buf_user-login  for ub.user-login .
     2764      do
     2765      on error undo, return error
     2766      :
     2767            FIND FIRST buf_sys-ctrl no-lock.
     2768            ASSIGN
     2769               v-login = USERID("ub")
     2770               p-db-num = buf_sys-ctrl.db-num
     2771            .
     2772            FIND FIRST buf_user-login
     2773                 WHERE buf_user-login.db-num = p-db-num
     2774                   AND buf_user-login.user-login = v-login
     2775                 no-lock
     2776                 no-error
     2777                 .
     2778            IF AVAILABLE buf_user-login
     2779            THEN DO:
     2780               assign
     2781                  p-user-id = buf_user-login.user-id
     2782               .
     2783            END.
     2784      end.
     2785   end procedure.
     2786   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2787   on f5 of frame Dialog-Frame anywhere
     2788   do:
     2789     v-doc-rec = recid(X_c-var-deliv-gr-per-val). run OpenBr in this-procedure ( input yes, input no, input no). reposition br-vardeliv to recid v-doc-rec no-error. v-doc-rec = ?.               apply 'value-changed' to br-vardeliv.
     2790       apply "VALUE-CHANGED" to BR-changes.
     2791   end.
     2792   def var sort-labelbr-vardeliv   as character no-undo .
     2793   def var sort-clmnbr-vardeliv    as handle    no-undo .
     2794   def var cur-clmnbr-vardeliv     as handle    no-undo .
     2795   def var cur-clmn-locbr-vardeliv as integer   no-undo .
     2796   def var re-querybr-vardeliv     as logical   initial no no-undo .
     2797   on start-search, ctrl-o of br-vardeliv in frame Dialog-Frame do:
     2798      run sort-brbr-vardeliv
     2799        (input (if available temp-changes
     2800                then recid(temp-changes)
     2801                else ?
     2802               )
     2803        ).
     2804   end.
     2805   PROCEDURE sort-brbr-vardeliv :
     2806     define input parameter p-recid as recid no-undo .
     2807     if re-querybr-vardeliv = no then do:
     2808       assign
     2809          cur-clmnbr-vardeliv = br-vardeliv:current-column in frame Dialog-Frame
     2810       .
     2811       if sort-clmnbr-vardeliv <> ? then sort-clmnbr-vardeliv:column-fgcolor = 0.
     2812       if cur-clmnbr-vardeliv = sort-clmnbr-vardeliv then do:
     2813         assign
     2814            sort-labelbr-vardeliv = ""
     2815            sort-clmnbr-vardeliv = ?
     2816         .
     2817        end.
     2818        else do:
     2819          assign
     2820            sort-labelbr-vardeliv = cur-clmnbr-vardeliv:label
     2821            sort-clmnbr-vardeliv  = cur-clmnbr-vardeliv
     2822            sort-clmnbr-vardeliv:column-fgcolor = 4
     2823          .
     2824        end.
     2825      end.
     2826     assign
     2827       cur-clmn-locbr-vardeliv = 1
     2828     .
     2829     def var column-handle as handle no-undo .
     2830     column-handle = br-vardeliv:first-column.
     2831     do while valid-handle(column-handle) :
     2832       if column-handle = cur-clmnbr-vardeliv then do:
     2833         leave .
     2834       end.
     2835       column-handle = column-handle:NEXT-COLUMN.
     2836       assign
     2837         cur-clmn-locbr-vardeliv = cur-clmn-locbr-vardeliv + 1
     2838       .
     2839     end.
     2840     case sort-labelbr-vardeliv:
     2841           when X_c-var-deliv-gr-per-val.deliv-type-code:label in browse br-vardeliv then DO:    assign       sort-column-name = "X_c-var-deliv-gr-per-val.deliv-type-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2842           when X_c-var-deliv-gr-per-val.deliv-subj-code:label in browse br-vardeliv then DO:    assign       sort-column-name = "X_c-var-deliv-gr-per-val.deliv-subj-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2843       otherwise do:
     2844         assign
     2845           sort-column-name = ""
     2846         .
     2847         run OpenBr in this-procedure ( input yes, input no, input no).
     2848           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-vardeliv') then do:
     2849             run mv-brw-defaultbr-vardeliv.
     2850           end.
     2851         if sort-labelbr-vardeliv <> "" then do:
     2852           assign
     2853             cur-clmnbr-vardeliv:column-fgcolor = 0
     2854           .
     2855         end.
     2856         assign
     2857           cur-clmn-locbr-vardeliv = ?
     2858         .
     2859       end.
     2860     end case.
     2861       if cur-clmn-locbr-vardeliv <> ? then do:
     2862         if can-do( this-procedure:internal-entries, 'ch-clmnbr-vardeliv') then do:
     2863           run ch-clmnbr-vardeliv in this-procedure (cur-clmn-locbr-vardeliv).
     2864         end.
     2865       end.
     2866     if p-recid <> ? then do:
     2867       reposition br-vardeliv to recid p-recid no-error.
     2868       apply "value-changed" to br-vardeliv in frame Dialog-Frame.
     2869     end.
     2870     apply "entry" to br-vardeliv in frame Dialog-Frame.
     2871   END PROCEDURE.
     2872   procedure re-open-query-srt-clmnbr-vardeliv:
     2873   if cur-clmnbr-vardeliv = ? then do:
     2874      run OpenBr in this-procedure ( input yes, input no, input no).
     2875   end.
     2876   else do:
     2877      assign re-querybr-vardeliv = yes.
     2878      run sort-brbr-vardeliv
     2879        (input (if available temp-changes
     2880                then recid(temp-changes)
     2881                else ?
     2882               )
     2883        ).
     2884      assign re-querybr-vardeliv = no.
     2885   end.
     2886   end.
