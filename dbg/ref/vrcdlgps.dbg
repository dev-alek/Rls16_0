     3711                             ,input parameter-7-31
     3712                             ,output v-fltopend-rowid
     3713                             ) no-error.
     3714         .
     3715         v-doc-rec = ?.
     3716       end.
     3717       assign
     3718         l-query-was-opened = true
     3719       .
     3720     end.
     3721   end.
     3722     run waitfram-hide in this-procedure .
     3723     END.
     3724     WHEN 'объект':U THEN DO:
     3725        filter-point = filter-point0 + p-mode.
     3726        ASSIGN
