     3850         parameter-5-33 = "  "
     3851       .
     3852         run fltopend_fltfindd in this-procedure  (
     3853                             input this-procedure:handle
     3854                             ,input QUERY br-vardeliv:handle
     3855                             ,input rowid(X_c-var-deliv-gr-per-val)
     3856                             ,input logical(parameter-2-33)
     3857                             ,input no-lock
     3858                             ,input (buffer X_c-var-deliv-gr-per-val:handle)
     3859                             ,input parameter-4-33
     3860                             ,input parameter-5-33
     3861                             ) no-error.
     3862         .
     3863         assign
