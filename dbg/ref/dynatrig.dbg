        1   block-level on error undo, throw.
        2   DEFINE VARIABLE vss-revision    AS CHARACTER NO-UNDO INITIAL "$Revision: a35951db4a04, 289, rls $":U .
        3   DEFINE VARIABLE vss-author      AS CHARACTER NO-UNDO INITIAL "$Author: EShklyar $":U .
        4   DEFINE VARIABLE vss-date        AS CHARACTER NO-UNDO INITIAL "$Date: Tue Dec 01 19:11:22 2015 +0300 $":U .
        5   DEFINE VARIABLE vss-workfile    AS CHARACTER NO-UNDO INITIAL "$Workfile: dynatrig.p $":U .
        6   DEFINE VARIABLE vss-archive     AS CHARACTER NO-UNDO INITIAL "$Archive: ref/dynatrig.p $":U .
        7   DEFINE VARIABLE vss-description AS CHARACTER NO-UNDO INITIAL "Адаптер динамических триггеров".
        8   DEFINE VARIABLE mHandle AS HANDLE NO-UNDO.
        9   PROCEDURE DynaTrig:
       10       DEFINE INPUT PARAMETER iTrigger AS CHARACTER NO-UNDO.
       11       RUN DynaTrig IN (THIS-PROCEDURE:INSTANTIATING-PROCEDURE)
       12           (mHandle, iTrigger) NO-ERROR.
       13   END PROCEDURE.
       14   PROCEDURE SetHandle:
       15       DEFINE INPUT PARAMETER iHandle AS HANDLE NO-UNDO.
       16       mHandle = iHandle.
       17   END.
