      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      124   define new shared variable RepPathName        as character no-undo .
      125   define new shared variable PrintRubl          as logical   no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define variable v-waitfram-action01         as character   no-undo .
      128   define variable v-waitfram-action02         as character   no-undo .
      129   define variable v-waitfram-action03         as character   no-undo .
      130   define variable mWaitFramTextBeg            as character   no-undo.
      131   define variable mWaitFramTextEnd            as character   no-undo.
      132   define variable mWaitFramView               as logical     no-undo.
      133   define variable mWaitProcEvent              as logical     no-undo init yes.
      134   define variable mWaitFramInterval           as integer     no-undo init 1 .
      135   define variable mWaitFramStop               as logical     no-undo.
      136   define variable mWaitFramStopUser           as logical     no-undo.
      137   define variable mWaitFramStopTimeOut        as logical     no-undo.
      138   define variable mWaitFramStartProc          as datetime-tz no-undo.
      139   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      140   define button B-WaitFramStop auto-end-key
      141        label "Стоп"
      142        size 10 by 1 tooltip "Остоновить процесс".
      143   define button B-viewProcInfo
      144        label "Информация"
      145        size 15 by 1 tooltip "Информация о процесс".
      146   define frame waitfram
      147     v-waitfram-action01 format "x(72)" no-label skip
      148     v-waitfram-action02 format "x(72)" no-label skip
      149     v-waitfram-action03 format "x(72)" no-label skip
      150     B-viewProcInfo
      151     B-WaitFramStop at row 4 col 30
      152     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      153     .
      154   define new global shared variable mBatchMode as logical no-undo init ?.
      155   define variable mFramBachModHandle as handle no-undo.
      156   mFramBachModHandle = frame waitfram:handle.
      157   define variable mFameOldVis as logical no-undo.
      158   define variable mVisCUrentVin as logical no-undo.
      159   if session:batch-mode
      160   then
      161      mBatchMode = yes.
      162   if mBatchMode = ? then do:
      163     mVisCUrentVin = current-window:visible.
      164     mFameOldVis = mFramBachModHandle:visible.
      165     mFramBachModHandle:visible  = yes.
      166     mBatchMode = mFramBachModHandle:visible ne yes.
      167     mFramBachModHandle:visible = mFameOldVis.
      168     current-window:visible = mVisCUrentVin.
      169   end.
      170    if  log-manager:logfile-name ne ?
      171     then DO:
      172         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      173         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      174         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      175     end.
      176   on choose of B-WaitFramStop in frame waitfram
      177   do:
      178     mWaitFramStop = yes.
      179     mWaitFramStopUser = yes.
      180   end.
      181   function waitfram-check-timeout returns logical():
      182      define variable vtime as int64 no-undo.
      183      if mWaitFramStopTimeOut
      184      then
      185         return yes.
      186      vtime = ( now - mWaitFramStartProc ) / 1000 .
      187      if     mWaitFramTimeOut ne ?
      188         and mWaitFramTimeOut ne 0
      189         and mWaitFramTimeOut lt vtime
      190      then do:
      191         mWaitFramStopTimeOut = yes.
      192      end.
      193      return mWaitFramStopTimeOut.
      194   end.
      195   procedure waitfram-hide :
      196     if not session:batch-mode
      197     then do
      198     on error undo, return error return-value
      199     :
      200       pause 0 before-hide .
      201       if not mBatchMode then
      202         hide frame waitfram .
      203     if     not mWaitFramView
      204        and mWaitProcEvent
      205     then
      206       process events .
      207     end.
      208   end procedure.
      209   procedure waitfram-show :
      210     define input  parameter p-message as character no-undo .
      211     define variable v-left-margin as integer   no-undo .
      212     if not session:batch-mode
      213     then do
      214     on error undo, return error return-value
      215     :
      216       if length(p-message) <= 70 then do:
      217         assign
      218           v-left-margin = integer((70 - length(p-message)) / 2)
      219         .
      220         assign
      221           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      222         .
      223         assign
      224           v-waitfram-action01 = " "
      225           v-waitfram-action02 = " "
      226                                    + fill(" ", v-left-margin)
      227                                    + p-message
      228           v-waitfram-action03 = " "
      229         .
      230       end.
      231       else do:
      232         define variable vRindex1 as integer no-undo.
      233         define variable vRindex2 as integer no-undo.
      234         vRindex1 = r-index(p-message," ",70).
      235         if vRindex1 = 0
      236         then
      237            vRindex1 = 70.
      238         if length(p-message)  <= vRindex1 + 70 then do:
      239           assign
      240             v-waitfram-action01 = " "
      241             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      243           .
      244         end.
      245         else do:
      246           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      247           if vRindex2 <= vRindex1
      248           then
      249              vRindex2 = vRindex1 + 70.
      250           assign
      251             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      253             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      254           .
      255         end.
      256       end.
      257       B-viewProcInfo:visible   in frame waitfram = no.
      258       B-viewProcInfo:sensitive in frame waitfram = no.
      259       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       if  (   mWaitFramView
      262          or  mWaitProcEvent)
      263          and not mBatchMode
      264       then
      265          display
      266             v-waitfram-action01 skip
      267             v-waitfram-action02 skip
      268             v-waitfram-action03 skip
      269          with frame waitfram .
      270       if     mWaitFramView
      271          then do:
      272             if     mWaitFramInterval ne ?
      273                and not mBatchMode
      274             then
      275                wait-for go of frame waitfram pause mWaitFramInterval.
      276          end.
      277          else
      278             if     mWaitProcEvent
      279                and not mBatchMode
      280             then
      281                process events .
      282     end.
      283   end procedure.
      284      procedure waitfram-show-this:
      285         define input  parameter iInterval as int64 no-undo.
      286         define variable vtime as int64 no-undo.
      287         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      288         mWaitFramInterval = iInterval.
      289         run waitfram-show (substitute("&1&2 &3&4" ,
      290                                       mWaitFramTextBeg ,
      291                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      292                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      293                                       mWaitFramTextEnd
      294                                      )
      295                           ).
      296      end.
      297      procedure WaitFramRunPause:
      298         define input  parameter iInterval as dec no-undo.
      299         define variable vStart  as datetime-tz no-undo.
      300         define variable vend    as datetime-tz no-undo.
      301         define variable vint as int64 no-undo.
      302         define variable vOk as logical no-undo.
      303         vStart = now.
      304         vend   = vStart.
      305         publish "WaitFramPause" (iInterval,output vOk).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and (   vint > 0
      311                 or (    not vOk
      312                     and iInterval eq ?
      313                     )
      314                 )
      315         then
      316            run waitfram-show-this (iInterval).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and vint > 0
      322         then do:
      323            run gbl/pause.p (vint * 1000).
      324         end.
      325         if iInterval ne ?
      326         then
      327            publish "WaitFramStop".
      328         waitfram-check-timeout().
      329      end.
      330      procedure WaitFramWaitFor:
      331         define input  parameter iInterval as dec no-undo.
      332         assign
      333            mWaitFramStartProc   = now
      334            mWaitFramStopUser    = no
      335            mWaitFramStopTimeOut = no
      336         .
      337         block-wait:
      338         do while not mWaitFramStop:
      339            run WaitFramRunPause (iInterval).
      340            if  waitfram-check-timeout()
      341            then do:
      342               leave block-wait.
      343            end.
      344         end.
      345         run waitfram-hide.
      346      end.
      347   procedure waitfram-join :
      348     define input  parameter p-line-1  as character no-undo .
      349     define input  parameter p-line-2  as character no-undo .
      350     define input  parameter p-line-3  as character no-undo .
      351     define output parameter p-message as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       assign
      356         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      359       .
      360     end.
      361   end procedure.
      362   function waitfram-join-function returns character
      363     (input p-line-1 as character
      364     ,input p-line-2 as character
      365     ,input p-line-3 as character
      366     ).
      367     define variable v-message as character no-undo .
      368     run waitfram-join in this-procedure
      369       (input  p-line-1
      370       ,input  p-line-2
      371       ,input  p-line-3
      372       ,output v-message
      373       ) .
      374     return v-message .
      375   end function .
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define  stream PrnLibStream.
      378   procedure prn-lib-prn-file :
      379     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      380     define input parameter p-DIsabledoptions as integer no-undo .
      381     define variable v-report-name as character no-undo .
      382     define variable v-user-action as character no-undo .
      383     define variable v-printed     as logical   no-undo .
      384     define variable v-exist       as logical   no-undo .
      385     do
      386       on error undo, return error
      387       :
      388       run prn-lib-get-report-name  in this-procedure (
      389         input parParentProc
      390         ,output v-report-name
      391         ).
      392   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      394     (input  v-report-name
      395     ,input  2
      396     ,output v-exist
      397     )  .
      398       if NOT v-exist then
      399       DO:
      400         Message
      401           "Нет заданий на печать ! "
      402           view-as alert-box .
      403         Return  .
      404       End.
      405       run gbl/prnfilen.w
      406         (input  ""
      407         ,input  p-DisabledOptions
      408         ,input  string(v-report-name )
      409         ,input  7
      410         ,output v-user-action
      411         ,output v-printed
      412         ) .
      413       if v-printed then
      414       do:
      415         return "YES" .
      416       end.
      417       else
      418       do:
      419         return "NO" .
      420       end.
      421     end.
      422   end procedure.
      423   procedure prn-lib-open-stream :
      424     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      425     define input parameter p-page-size    as integer no-undo .
      426     define input parameter p-is-stream    as logical no-undo .
      427     define input parameter p-append       as logical no-undo .
      428     define variable v-report-name as character no-undo .
      429     do
      430       on error undo, return error
      431       :
      432       run prn-lib-get-report-name  in this-procedure (
      433         input parParentProc
      434         ,output v-report-name
      435         ).
      436       if p-is-stream then
      437       do:
      438         if p-append then
      439         do:
      440           output stream PrnLibStream to value( v-report-name )
      441             page-size value(p-page-size) append .
      442         end.
      443         if not p-append then
      444         do:
      445           output stream PrnLibStream to value( v-report-name )
      446             page-size value(p-page-size) .
      447         end.
      448       end.
      449       if not p-is-stream then
      450       do:
      451         if p-append then
      452         do:
      453           output to value( v-report-name )
      454             page-size value(p-page-size) append .
      455         end.
      456         if not p-append then
      457         do:
      458           output to value( v-report-name )
      459             page-size value(p-page-size) .
      460         end.
      461       end.
      462     end.
      463   end procedure.
      464   procedure prn-lib-open-exp :
      465     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      466     define input parameter p-is-stream    as logical no-undo .
      467     define input parameter p-is-append    as logical no-undo .
      468     define output parameter p-ReportFileName as char init "report" no-undo.
      469     define output parameter p-process as logical no-undo .
      470     define variable glog as logical no-undo .
      471     do
      472       on error undo, return error
      473       :
      474       SYSTEM-DIALOG GET-FILE p-ReportFileName
      475         TITLE      "Укажите путь"
      476         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      477         ASK-OVERWRITE
      478         CREATE-TEST-FILE
      479         SAVE-AS
      480         USE-FILENAME
      481         DEFAULT-EXTENSION "txt"
      482         UPDATE glog
      483         .
      484       if not glog then  return.
      485       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      486       if p-is-stream then
      487       do:
      488         if p-is-append then
      489         do:
      490           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      491         end.
      492         else
      493         do:
      494           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      495         end.
      496       end.
      497       else
      498       do:
      499         if p-is-append then
      500         do:
      501           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      502         end.
      503         else
      504         do:
      505           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      506         end.
      507       end.
      508       p-process = yes.
      509     end.
      510   end procedure.
      511   procedure prn-lib-get-report-name :
      512     define input parameter parParentProc  as widget-handle no-undo.
      513     define output parameter p-report-name as character no-undo .
      514     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      515   end procedure.
      516   procedure prn-lib-reportviewer-report-name :
      517     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      518     define input parameter p-report-name-html as character no-undo .
      519     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      520   end procedure.
      521   procedure prn-lib-reportviewer :
      522     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      523     define input parameter p-report-name-html as character no-undo .
      524     define input parameter p-param        as character no-undo .
      525     define variable v-excel           as character no-undo init 'TRUE' .
      526     define variable v-value-character as character no-undo .
      527     define variable v-value-integer   as character no-undo .
      528     define variable v-value-date      as date      no-undo .
      529     define variable v-value-decimal   as decimal   no-undo .
      530     define variable rep-excel         as logical   no-undo .
      531     define variable excel-string      as character no-undo .
      532     define variable v-param-type      as character no-undo .
      533     define variable v-tth             as handle    no-undo .
      534     run adm/shattri.p (
      535       input "get":U
      536       ,input  ""
      537       ,input  0
      538       ,input  'report-glob':U
      539       ,input  'rep-excel':U
      540       ,output v-value-character
      541       ,output v-value-date
      542       ,output v-value-decimal
      543       ,output v-value-integer
      544       ,output rep-excel
      545       ,output v-param-type
      546       ,INPUT-OUTPUT table-handle v-tth
      547       )  .
      548     if rep-excel then v-excel = "TRUE" .
      549     else v-excel = "FALSE" .
      550     if p-param eq ""
      551     then
      552        p-param = "EXCEL:" + v-excel.
      553     else
      554        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      555     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      556   end procedure.
      557   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      558   procedure cur-time :
      559      define output parameter p-today as date      no-undo .
      560      define output parameter p-time  as integer   no-undo .
      561     do
      562     on error undo, return error
      563     :
      564       define variable v-date1 as date      no-undo .
      565       define variable v-date2 as date      no-undo .
      566       define variable v-time  as integer   no-undo .
      567       assign
      568         v-date1 = today
      569         v-time  = time
      570         v-date2 = today
      571       .
      572       if v-date1 <> v-date2
      573       then do:
      574         assign
      575           v-date1 = today
      576           v-time  = v-time
      577         .
      578       end.
      579       assign
      580         p-today = v-date1
      581         p-time  = v-time
      582       .
      583     end.
      584   end.
      585   function cur-time-date returns character
      586   :
      587     return string(today, '99/99/9999':U) .
      588   end.
      589   function cur-time-mjd returns decimal
      590   :
      591     define variable v-date as date      no-undo .
      592     define variable v-time as integer   no-undo .
      593     run cur-time in this-procedure
      594       (output v-date
      595       ,output v-time
      596       ) .
      597     return integer(v-date) - 2400002 + (v-time / 86400) .
      598   end.
      599   function cur-time-get-ending-index returns integer
      600   (input p-number as integer
      601   )
      602   :
      603     if p-number < 0
      604     or p-number = ?
      605     then do:
      606       return 1 .
      607     end.
      608     define variable v-rest as integer   no-undo .
      609     assign
      610       p-number = p-number modulo 100
      611     .
      612     if p-number < 20
      613     then do:
      614       assign
      615         v-rest = p-number
      616       .
      617     end.
      618     else do:
      619       assign
      620         v-rest = p-number modulo 10
      621       .
      622     end.
      623     case v-rest :
      624       when 1
      625       then do:
      626         return 2 .
      627       end.
      628       when 2 or
      629       when 3 or
      630       when 4
      631       then do:
      632         return 3 .
      633       end.
      634       otherwise do:
      635         return 1 .
      636       end.
      637     end case .
      638   end.
      639   procedure cur-time-mjd-to-date :
      640      define input  parameter i-mjd-diff as decimal no-undo.
      641      define output parameter o-Date     as date    no-undo.
      642      define output parameter o-Time     as integer no-undo.
      643      define variable v-day-number as integer   no-undo .
      644      if    i-mjd-diff < 0
      645         or i-mjd-diff = ?
      646      then do:
      647         return "?" .
      648      end.
      649      assign
      650         v-day-number = truncate(i-mjd-diff,0).
      651         o-Date = date(v-day-number + 2400002).
      652         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      653     .
      654   end.
      655   function cur-time-mjd-to-string returns character
      656   (input p-mjd-diff as decimal
      657   )
      658   :
      659     define variable v-day-number as integer   no-undo .
      660     define variable v-seconds    as integer   no-undo .
      661     define variable v-hour       as integer   no-undo .
      662     define variable v-min        as integer   no-undo .
      663     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      664     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      665     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      666     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      667     if p-mjd-diff < 0
      668     or p-mjd-diff = ?
      669     then do:
      670       return "?" .
      671     end.
      672     assign
      673       v-day-number = integer(truncate(p-mjd-diff,0))
      674       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      675     .
      676     if v-seconds > 86400
      677     then do:
      678       assign
      679         v-seconds = 86400 - 1
      680       .
      681     end.
      682     if v-seconds < 0
      683     then do:
      684       assign
      685         v-seconds = 0
      686       .
      687     end.
      688     assign
      689       v-hour = truncate(v-seconds / 3600, 0)
      690     .
      691     assign
      692       v-seconds = v-seconds modulo 3600
      693     .
      694     assign
      695       v-min = truncate(v-seconds / 60, 0)
      696     .
      697     assign
      698       v-seconds = v-seconds modulo 60
      699     .
      700     return
      701         (if v-day-number <> 0
      702           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      703           else ""
      704         )
      705       + (if v-day-number <> 0 or v-hour <> 0
      706           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      707           else ""
      708         )
      709       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      710           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      711           else ""
      712         )
      713       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      714       .
      715   end.
      716   function cur-time-string returns character
      717   :
      718     define variable v-date as date      no-undo .
      719     define variable v-time as integer   no-undo .
      720     run cur-time in this-procedure
      721       (output v-date
      722       ,output v-time
      723       ) .
      724     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      725   end.
      726   function cur-time-string-sec returns character
      727   :
      728     define variable v-date as date      no-undo .
      729     define variable v-time as integer   no-undo .
      730     run cur-time in this-procedure
      731       (output v-date
      732       ,output v-time
      733       ) .
      734     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      735   end.
      736   function cur-time-custom  returns character
      737   (input p-prefix as character
      738   ,input p-date-format as character
      739   ,input p-delimiter as character
      740   ,input p-time-format as character
      741   ,input p-suffix as character
      742   )
      743   :
      744     define variable v-date as date      no-undo .
      745     define variable v-time as integer   no-undo .
      746     run cur-time in this-procedure
      747       (output v-date
      748       ,output v-time
      749       ) .
      750     return
      751       p-prefix
      752       + string(v-date, p-date-format)
      753       + p-delimiter
      754       + string(v-time, p-time-format)
      755       + p-suffix
      756       .
      757   end.
      758   function cur-time-print  returns character
      759   :
      760     define variable v-date as date      no-undo .
      761     define variable v-time as integer   no-undo .
      762     run cur-time in this-procedure
      763       (output v-date
      764       ,output v-time
      765       ) .
      766     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      767   end.
      768   function cur-time-datetime returns datetime
      769   :
      770     define variable v-char as character no-undo .
      771     define variable v-datetime as datetime no-undo .
      772     v-char = cur-time-string().
      773     v-datetime = datetime(v-char).
      774     return  v-datetime.
      775   end.
      776   function cur-time-string-msec returns character
      777   :
      778     define variable v-date as datetime  no-undo .
      779     v-date = now.
      780     return string(v-date) .
      781   end.
      782   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   FUNCTION mark-string RETURNS CHARACTER
      784     ( input p-recid as recid, input mark-list as character  ) :
      785     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      786   END FUNCTION.
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   function usrfulnf returns character ( input p-user-id as character):
      789   define variable v-user-name as character no-undo .
      790   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      792     (input  p-user-id
      793     ,output v-user-name
      794     ) no-error .
      795   if error-status:error
      796   or v-user-name = ""
      797   then do:
      798     return p-user-id.
      799   end.
      800   else do:
      801     return v-user-name.
      802   end.
      803   end function.
      804   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      805   define variable sort-column-name as character no-undo .
      806   define variable v-db-num LIKE ub.db.db-num no-undo.
      807   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      808   define  temp-table temp-changes no-undo
      809   field f_name as character
      810   field l_name as character
      811   field v_old as character
      812   field v_new as character
      813   field t_name as character
      814   field num_ as integer
      815   field uniq-key-rec as character
      816   field action as integer
      817   field fNotChange as logical
      818   index pi is unique primary
      819   num_
      820   t_name
      821   f_name
      822   index
      823   Chan
      824   fnotChange
      825   t_name
      826   f_name
      827   index imain uniq-key-rec
      828   .
      829   FUNCTION get-all-fields returns character (p-file-name as character ):
      830   define variable v-dop as character no-undo .
      831     find first _file no-lock where _file._file-name = p-file-name no-error .
      832     if not available _file then return "":U.
      833     for each _field no-lock where
      834              _field._file-recid = recid(_file) :
      835       assign
      836       v-dop = v-dop + _field._field-name + chr(44)
      837       .
      838     end.
      839     return trim(v-dop).
      840   END FUNCTION.
      841   PROCEDURE proc-full-temp-changes :
      842     define input  parameter p-hst-handle as handle    no-undo .
      843     define input  parameter p-main-table as character no-undo .
      844     define input  parameter p-field-list as character no-undo .
      845     define input  parameter p-label-form as character no-undo .
      846     define variable h-new-buf         as handle    no-undo .
      847     define variable h-main-buf        as handle    no-undo .
      848     define variable h-for-comp        as handle    no-undo .
      849     define variable v-inform          as character no-undo .
      850     define variable v-ind             as integer   no-undo .
      851     define variable v-idx-field-qnty  as integer   no-undo .
      852     define variable v-num-entries     as integer   no-undo .
      853     define variable fh                as handle    no-undo .
      854     define variable fh-main           as handle    no-undo .
      855     define variable fh-old            as handle    no-undo .
      856     define variable fh-new            as handle    no-undo .
      857     define variable v-field-name      as character no-undo .
      858     define variable v-field-lvl       as character no-undo .
      859     define variable v-field-form      as character no-undo .
      860     define variable v-search-exp      as character no-undo .
      861     define variable v-srch-main       as character no-undo .
      862     define variable v-word-link       as character no-undo .
      863     define variable v-av-chip-num     as logical   no-undo .
      864     define variable v-main-pi-fld-lst as character no-undo .
      865     define variable v-main-fld-lst    as character no-undo .
      866     define variable v-delim-list      as character no-undo .
      867     define variable v-label           as character no-undo .
      868     define variable v-old-value       as character no-undo case-sensitive.
      869     define variable v-new-value       as character no-undo case-sensitive.
      870     define variable v-chg-fields as character no-undo.
      871     for each temp-changes:
      872       delete temp-changes.
      873     end.
      874     if not p-hst-handle:available then do:
      875       return .
      876     end.
      877     create buffer h-new-buf  for table p-hst-handle .
      878     create buffer h-main-buf for table p-main-table .
      879     assign
      880       v-inform = h-main-buf:index-information(1)
      881       v-ind    = 2
      882     .
      883     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      884     on error undo, return error
      885     :
      886       assign
      887         v-inform = h-main-buf:index-information( v-ind )
      888         v-ind    = v-ind + 1
      889       .
      890     end.
      891     if v-inform = ?
      892       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      893       or entry( 3, v-inform, ",":U ) <> "1":U
      894     then do:
      895       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      896     end.
      897     assign
      898       v-idx-field-qnty = num-entries( v-inform ) - 4
      899     .
      900     if v-idx-field-qnty < 2 then do:
      901       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      902     end.
      903     assign
      904       v-srch-main   = "where":U
      905       v-word-link   = "":U
      906       v-av-chip-num = false
      907       v-delim-list  = "":U
      908     .
      909     do v-ind = 1 to v-idx-field-qnty by 2
      910     on error undo, return error
      911     :
      912       assign
      913         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      914         fh                = p-hst-handle:buffer-field( v-field-name )
      915         fh-main           = h-main-buf:buffer-field( v-field-name )
      916         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      917         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      918       .
      919       if fh:data-type ="character":U then do:
      920         assign
      921           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      922         .
      923       end.
      924       else do:
      925         assign
      926           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      927         .
      928       end.
      929       if v-delim-list = "":U then do:
      930         assign
      931           v-delim-list = ",":U
      932         .
      933       end.
      934       if v-word-link = "":U then do:
      935         assign
      936           v-word-link = "and":U
      937         .
      938       end.
      939     end.
      940     assign
      941       v-delim-list  = "":U
      942     .
      943     do v-ind = 1 to h-main-buf:num-fields
      944     on error undo, return error
      945     :
      946       assign
      947         fh-main      = h-main-buf:buffer-field( v-ind )
      948         v-field-name = fh-main:name
      949       .
      950         assign
      951           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      952         .
      953         if v-delim-list = "":U then do:
      954           assign
      955             v-delim-list = ",":U
      956           .
      957         end.
      958     end.
      959     assign
      960       v-inform = p-hst-handle:index-information(1)
      961       v-ind    = 2
      962     .
      963     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      964     on error undo, return error
      965     :
      966       assign
      967         v-inform = p-hst-handle:index-information( v-ind )
      968         v-ind    = v-ind + 1
      969       .
      970     end.
      971     if v-inform = ?
      972       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      973       or entry( 3, v-inform, ",":U ) <> "1":U
      974     then do:
      975       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      976     end.
      977     assign
      978       v-idx-field-qnty = num-entries( v-inform ) - 4
      979     .
      980     if v-idx-field-qnty < 2 then do:
      981       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      982     end.
      983     assign
      984       v-search-exp  = "where":U
      985       v-word-link   = "":U
      986       v-av-chip-num = false
      987     .
      988     do v-ind = 1 to v-idx-field-qnty by 2
      989     on error undo, return error
      990     :
      991       assign
      992         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      993         fh           = p-hst-handle:buffer-field( v-field-name )
      994         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      995       .
      996       if v-field-name = "chip-num":U then do:
      997         assign
      998           v-search-exp  = substitute( "&1 >", v-search-exp )
      999           v-av-chip-num = true
     1000         .
     1001       end.
     1002       else do:
     1003         assign
     1004           v-search-exp = substitute( "&1 =", v-search-exp )
     1005         .
     1006       end.
     1007       if fh:data-type ="character":U then do:
     1008         assign
     1009           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1010         .
     1011       end.
     1012       else do:
     1013         assign
     1014           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1015         .
     1016       end.
     1017       if v-word-link = "":U then do:
     1018         assign
     1019           v-word-link = "and":U
     1020         .
     1021       end.
     1022     end.
     1023     if v-av-chip-num = false then do:
     1024       message
     1025         vss-workfile vss-revision vss-description skip
     1026         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1027         "Использование данной процедуры невозможно!" skip
     1028         view-as alert-box error .
     1029       return error .
     1030     end.
     1031     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1032     if not h-new-buf:available then do:
     1033       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1034       if not h-main-buf:available then do:
     1035         assign
     1036           h-for-comp = ?
     1037         .
     1038       end.
     1039       else do:
     1040         assign
     1041           h-for-comp = h-main-buf
     1042         .
     1043       end.
     1044     end.
     1045     else do:
     1046       assign
     1047         h-for-comp = h-new-buf
     1048       .
     1049     end.
     1050     assign
     1051       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1052     .
     1053     do v-ind = 1 to v-num-entries
     1054     on error undo, return error return-value
     1055     :
     1056       assign
     1057         v-field-name = entry( v-ind, v-main-fld-lst )
     1058         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1059         v-old-value  = fh-old:buffer-value()
     1060         v-label      = trim( fh-old:label )
     1061       .
     1062       if ( trim( p-field-list ) <> "":U
     1063            and lookup( v-field-name, p-field-list ) > 0
     1064          )
     1065          or trim( p-field-list ) = "":U
     1066       then do:
     1067         if h-for-comp <> ? then do:
     1068           assign
     1069             fh-new      = h-for-comp:buffer-field( v-field-name )
     1070             v-new-value = fh-new:buffer-value()
     1071           .
     1072         end.
     1073         else do:
     1074           assign
     1075             v-new-value = "":U
     1076           .
     1077         end.
     1078         if v-old-value <> v-new-value
     1079         then do:
     1080           create temp-changes.
     1081           assign
     1082             temp-changes.t_name = p-main-table
     1083             temp-changes.f_name = v-field-name
     1084             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1085             temp-changes.v_old  = trim( v-old-value )
     1086             temp-changes.v_new  = trim( v-new-value )
     1087             temp-changes.num_   = 0
     1088             temp-changes.fNotChange = v-old-value eq v-new-value
     1089           .
     1090         end.
     1091       end.
     1092     end.
     1093     assign
     1094       v-num-entries = num-entries( p-label-form, chr(8) )
     1095     .
     1096     do v-ind = 1 to v-num-entries
     1097     on error undo, return error return-value
     1098     :
     1099       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1100         assign
     1101           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1102           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1103           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1104         .
     1105         find first temp-changes
     1106           where temp-changes.f_name = v-field-name
     1107           no-error .
     1108         if available temp-changes then do:
     1109           if trim( v-field-lvl ) <> "":U then do:
     1110             assign
     1111               temp-changes.l_name = v-field-lvl
     1112             .
     1113           end.
     1114           if trim( v-field-form ) <> "":U then do:
     1115             assign
     1116               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1117             .
     1118             if h-for-comp <> ? then do:
     1119               assign
     1120                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1121               .
     1122             end.
     1123           end.
     1124         end.
     1125       end.
     1126       else do:
     1127         message
     1128           vss-workfile vss-revision vss-description skip
     1129           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1130           substitute( "список для поля '&1': '&2'"
     1131                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1132                       ,entry( v-ind, p-label-form, chr(8) )
     1133                     ) skip
     1134           substitute( "полный список: &2", p-label-form ) skip
     1135           view-as alert-box error .
     1136       end.
     1137     end.
     1138     delete object h-new-buf .
     1139     delete object h-main-buf .
     1140   END PROCEDURE.
     1141   DEFINE BUTTON B-Help
     1142        LABEL "Помо&щь"
     1143        SIZE 3 BY 1
     1144        BGCOLOR 8 .
     1145   DEFINE BUTTON b-lkp
     1146        LABEL "&Остатки"
     1147        SIZE 10 BY 1.
     1148   DEFINE BUTTON B-mark
     1149        LABEL "&*"
     1150        SIZE 3 BY 1.
     1151   DEFINE BUTTON b-quit AUTO-END-KEY
     1152        LABEL "&Выход"
     1153        SIZE 10 BY 1
     1154        BGCOLOR 8 .
     1155   DEFINE BUTTON B-sel AUTO-GO
     1156        LABEL "Вы&бор"
     1157        SIZE 10 BY 1.
     1158   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1159         VIEW-AS TEXT
     1160        SIZE 6 BY 1
     1161        FGCOLOR 4  NO-UNDO.
     1162   DEFINE QUERY BR-changes FOR
     1163         temp-changes SCROLLING.
     1164   DEFINE QUERY br-wp FOR
     1165         X_c-wth-place SCROLLING.
     1166   DEFINE BROWSE BR-changes
     1167     QUERY BR-changes DISPLAY
     1168         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1169   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1170   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1171       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1172   DEFINE BROWSE br-wp
     1173     QUERY br-wp NO-LOCK DISPLAY
     1174         mark-string(recid(X_c-wth-place), p-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1175         usrfulnf(X_c-wth-place.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1176         X_c-wth-place.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1177         string(X_c-wth-place.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1178         X_c-wth-place.w-p-name FORMAT "X(20)":U
     1179         X_c-wth-place.status_ COLUMN-LABEL "Статус" FORMAT "X(1)":U
     1180         X_c-wth-place.w-p-code COLUMN-LABEL "Код МХ" FORMAT ">>>>>>>>9":U
     1181       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25 FIT-LAST-COLUMN.
     1182   DEFINE FRAME Dialog-Frame
     1183        b-quit AT ROW 1 COL 1
     1184        B-mark AT ROW 1 COL 11
     1185        B-sel AT ROW 1 COL 21
     1186        b-lkp AT ROW 1 COL 61
     1187        B-Help AT ROW 1 COL 95
     1188        br-wp AT ROW 3 COL 1
     1189        BR-changes AT ROW 13 COL 1
     1190        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1191        SPACE(78.62) SKIP(20.04)
     1192       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1193            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1194            TITLE "История мест хранения МЦ"
     1195            CANCEL-BUTTON b-quit.
     1196   ASSIGN
     1197          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1198          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1199   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1200   DO:
     1201     APPLY "END-ERROR":U TO SELF.
     1202   END.
     1203   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1204   DO:
     1205     define variable v-rid-list as character no-undo .
     1206     run ref/cwthpobj.w
     1207       (
     1208        INPUT parparentproc
     1209       ,INPUT p-obj-type
     1210       ,INPUT p-obj-code
     1211       ,input '':U
     1212       ,INPUT 'place':U
     1213       ,input (if available X_c-wth-place
     1214               then X_c-wth-place.obj-type
     1215               else p-obj-type)
     1216       ,input (if available X_c-wth-place
     1217               then X_c-wth-place.obj-code
     1218               else p-obj-code)
     1219       ,INPUT (if available X_c-wth-place
     1220               then X_c-wth-place.w-p-code
     1221               else p-w-p-code)
     1222       ,INPUT 0
     1223       ,input-output v-rid-list
     1224      ) no-error.
     1225     if error-status :error
     1226     then do:
     1227       message error-status:get-message(1) view-as alert-box .
     1228       return no-apply.
     1229     end.
     1230   END.
     1231   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1232   DO:
     1233     define variable loc#log as logical no-undo .
     1234     if available X_c-wth-place then do:
     1235   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1236   define variable v-str-recid10 as character no-undo .
     1237   define variable v-num-entry10 as integer   no-undo .
     1238   assign
     1239     v-str-recid10 = trim( string( recid( X_c-wth-place ) , "->>>>>>>>>>>9":U ) )
     1240     v-num-entry10 = lookup( v-str-recid10 , p-rid-list )
     1241   .
     1242   if v-num-entry10 > 0 then do:
     1243     assign
     1244       entry( v-num-entry10, p-rid-list ) = "":U
     1245       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1246     .
     1247   end.
     1248   else do:
     1249     assign
     1250       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1251     .
     1252   end.
     1253       loc#log = br-wp:refresh() .
     1254       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1255           loc#log = br-wp:select-next-row ().
     1256           apply "VALUE-CHANGED" to br-wp in frame Dialog-Frame.
     1257       end.
     1258       if num-entries( p-rid-list ) = 0
     1259       then
     1260           hide mark-num in frame Dialog-Frame.
     1261       else
     1262           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1263     end.
     1264     apply "entry" to br-wp in frame Dialog-Frame.
     1265   END.
     1266   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1267   DO:
     1268       if ( available X_c-wth-place ) then do:
     1269       if  ( p-rid-list = "" ) or b-mark:sensitive = no
     1270       then
     1271       p-rid-list = string( recid( X_c-wth-place ) ) .
     1272     end.
     1273   END.
     1274   ON RETURN OF br-wp IN FRAME Dialog-Frame
     1275   or MOUSE-SELECT-DBLCLICK OF br-wp IN FRAME Dialog-Frame
     1276       DO:
     1277       run proc-br-wp no-error.
     1278     if error-status:error then return no-apply.
     1279   END.
     1280   ON VALUE-CHANGED OF br-wp IN FRAME Dialog-Frame
     1281   DO:
     1282     run proc-view-changes in this-procedure no-error.
     1283   END.
     1284   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1285   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1286   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   on help of frame Dialog-Frame
     1288   do:
     1289     run gbl/app_help.p
     1290       (input this-procedure :file-name
     1291       ,input ''
     1292       ,input ?
     1293       ) no-error.
     1294     if error-status :error then do:
     1295       message
     1296         "Ошибка при вызове помощи"
     1297         error-status :get-message(1)
     1298         view-as alert-box .
     1299     end.
     1300   end.
     1301   run minbtn-set in this-procedure .
     1302   on choose of b-help in frame Dialog-Frame
     1303   do:
     1304     apply "help":u to frame Dialog-Frame .
     1305   end.
     1306   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1307   procedure minbtn-set :
     1308       do
     1309           on error undo, return error return-value
     1310           :
     1311           define variable ii              as integer       no-undo .
     1312           define variable fh              as widget-handle no-undo .
     1313           define variable hh              as widget-handle no-undo .
     1314           define variable v-h             as handle        extent 4 no-undo .
     1315           define variable v-name-button   as character     no-undo .
     1316           define variable v-help-old-x    as decimal       no-undo .
     1317           define variable v-help-old-y    as decimal       no-undo .
     1318           define variable v-help-old-size as decimal       no-undo .
     1319           define variable v-frame-width   as decimal       no-undo .
     1320           define variable jj              as integer       no-undo .
     1321           do
     1322               on error undo, return error
     1323               :
     1324               assign
     1325                   v-frame-width = frame Dialog-Frame:width - 0.3
     1326                   fh            = frame Dialog-Frame:first-child
     1327                   hh            = fh:first-child
     1328                   ii            = 1
     1329                   .
     1330               do while valid-handle(hh):
     1331                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1332                   do:
     1333                       case lc(hh:name) :
     1334                           when "b-help" then
     1335                               do:
     1336                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1337                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1338                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1339                                   hh:TOOLTIP = "Помощь" .
     1340                                   v-help-old-x = hh:column .
     1341                                   v-help-old-y = hh:row    .
     1342                                   v-help-old-size = hh:width .
     1343                                   hh:width-chars = 2.5 .
     1344                               end.
     1345                           when "b-print" then
     1346                               do:
     1347                                   hh:load-image("cmp/b-print.bmp":u) .
     1348                                   hh:TOOLTIP = "Печать" .
     1349                                   v-h[ii] = hh:handle .
     1350                                   ii = ii + 1 .
     1351                                   hh:width-chars = 3 .
     1352                               end.
     1353                           when "b-history" or
     1354                           when "b-hist" then
     1355                               do:
     1356                                   hh:load-image("cmp/b-hist.bmp":u) .
     1357                                   hh:TOOLTIP = "История" .
     1358                                   v-h[ii] = hh:handle .
     1359                                   ii = ii + 1 .
     1360                                   hh:width-chars = 3 .
     1361                               end.
     1362                           when "b-sch" then
     1363                               do:
     1364                                   hh:load-image("cmp/b-sch.bmp":u) .
     1365                                   hh:TOOLTIP = "Установка Фильтра" .
     1366                                   v-h[ii] = hh:handle .
     1367                                   ii = ii + 1 .
     1368                                   hh:width-chars = 3 .
     1369                               end.
     1370                           when "b-hist-user" then
     1371                               do:
     1372                                   hh:load-image("cmp/b-hist.bmp":u) .
     1373                                   hh:TOOLTIP = "История пользователя" .
     1374                                   ii = ii + 1 .
     1375                               end.
     1376                       end case.
     1377                   end.
     1378                   hh = hh:next-sibling.
     1379               end.
     1380               b-help:column = v-frame-width - b-help:width-chars.
     1381               jj = 0.
     1382               repeat ii = 4 to 1 by -1 :
     1383                   if valid-handle (v-h[ii] ) then
     1384                   do:
     1385                       jj  = jj + 1 .
     1386                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1387                       v-h[ii]:row    = v-help-old-y .
     1388                   end.
     1389               end.
     1390           end.
     1391       end.
     1392   end procedure.
     1393   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1394   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1395   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1396   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1397   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1398   define variable v-diasize-current-frame-height as decimal   no-undo .
     1399   define variable v-diasize-change-size          as logical   no-undo .
     1400   define variable v-diasize-resize-button        as handle    no-undo .
     1401   define variable v-diasize-wndmax               as logical   no-undo .
     1402   define variable v-diasize-wndstore             as logical   no-undo .
     1403   define variable v-diasize-proc-name            as character no-undo .
     1404   define variable v-diasize-browse-handle        as handle    no-undo .
     1405   define variable v-diasize-browse-number        as integer   no-undo .
     1406   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1407   define temp-table temp-diasize-handle no-undo
     1408     field handle-value  as handle
     1409     field save-position as decimal
     1410     index xpk is primary unique handle-value
     1411     .
     1412   define temp-table temp-browse-handle no-undo
     1413     field browse-type   as character
     1414     field browse-number as integer
     1415     field browse-handle as handle
     1416     field original-size as decimal
     1417     index xpk is primary unique browse-type browse-number
     1418     index xie browse-type browse-handle
     1419   .
     1420   procedure diasize_change-height :
     1421     define input  parameter p-change-value  as decimal   no-undo .
     1422     define input  parameter p-move-resize   as logical   no-undo .
     1423     define variable v-field-group-handle    as handle    no-undo .
     1424     define variable v-object-handle         as handle    no-undo .
     1425     define variable v-frame-height          as decimal   no-undo .
     1426     define variable v-frame-virtual-height  as decimal   no-undo .
     1427     define variable v-browse-height         as decimal   no-undo .
     1428     define variable v-window-height         as decimal   no-undo .
     1429     define variable v-window-virtual-height as decimal   no-undo .
     1430     define variable v-change-sign           as integer   no-undo .
     1431     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1432     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1433     if p-change-value > 0
     1434     then do:
     1435       if frame Dialog-Frame :height + p-change-value
     1436           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1437       then do:
     1438         assign
     1439           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1440                           - (frame Dialog-Frame :height-chars)
     1441         .
     1442         if p-change-value <= 0
     1443         then do:
     1444           run diasize_position-resize-button in this-procedure .
     1445           return .
     1446         end.
     1447       end.
     1448     end.
     1449     if p-change-value < 0
     1450     then do:
     1451       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1452       then do:
     1453         assign
     1454           p-change-value = v-diasize-orig-frame-height
     1455                          - (frame Dialog-Frame :height-chars)
     1456         .
     1457         if p-change-value >= 0
     1458         then do:
     1459           run diasize_position-resize-button in this-procedure .
     1460           return .
     1461         end.
     1462       end.
     1463     end.
     1464     if p-change-value >= 0
     1465     then do:
     1466       assign
     1467         v-change-sign = 1
     1468       .
     1469     end.
     1470     else do:
     1471       assign
     1472         v-change-sign = -1
     1473       .
     1474     end.
     1475     assign
     1476       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1477     .
     1478     if p-change-value = 0
     1479     then do:
     1480       run diasize_position-resize-button in this-procedure .
     1481       return .
     1482     end.
     1483     move_block:
     1484     do
     1485     on error undo move_block, retry move_block
     1486     :
     1487       if retry
     1488       then do:
     1489         do
     1490         on error undo move_block, leave move_block
     1491         :
     1492           if p-change-value > 0
     1493           then do:
     1494             for each buf_temp-diasize-handle
     1495             on error undo, next
     1496             :
     1497               assign
     1498                 v-object-handle = buf_temp-diasize-handle.handle-value
     1499               .
     1500               if v-object-handle <> v-diasize-resize-button
     1501               then do:
     1502                 assign
     1503                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1504                 .
     1505               end.
     1506             end.
     1507             assign
     1508               v-diasize-browse-handle :height = v-browse-height
     1509             .
     1510             for each buf_temp-browse-handle
     1511               where buf_temp-browse-handle.browse-type = 'height':u
     1512             on error undo, next
     1513             :
     1514               assign
     1515                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1516               .
     1517             end.
     1518             assign
     1519               frame Dialog-Frame :height = v-frame-height
     1520             .
     1521             if frame Dialog-Frame :scrollable = true
     1522             then do:
     1523               assign
     1524                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1525               .
     1526             end.
     1527             run diasize_position-resize-button in this-procedure .
     1528           end.
     1529           else do:
     1530             if frame Dialog-Frame :scrollable = true
     1531             then do:
     1532               assign
     1533                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1534               .
     1535             end.
     1536             assign
     1537               frame Dialog-Frame :height = v-frame-height
     1538             .
     1539             assign
     1540               v-diasize-browse-handle :height = v-browse-height
     1541             .
     1542             for each buf_temp-browse-handle
     1543               where buf_temp-browse-handle.browse-type = 'height':u
     1544             on error undo, next
     1545             :
     1546               assign
     1547                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1548               .
     1549             end.
     1550             for each buf_temp-diasize-handle
     1551             on error undo, next
     1552             :
     1553               assign
     1554                 v-object-handle = buf_temp-diasize-handle.handle-value
     1555               .
     1556               if v-object-handle <> v-diasize-resize-button
     1557               then do:
     1558                 assign
     1559                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1560                 .
     1561               end.
     1562             end.
     1563             run diasize_position-resize-button in this-procedure .
     1564           end.
     1565           assign
     1566             v-diasize-change-size = false
     1567           .
     1568           leave move_block .
     1569         end.
     1570       end.
     1571       assign
     1572         v-diasize-need-full-display = true
     1573       .
     1574       if v-diasize-change-size = false
     1575       then do:
     1576         assign
     1577           v-diasize-change-size = true
     1578         .
     1579       end.
     1580       else do:
     1581         return .
     1582       end.
     1583       assign
     1584         v-frame-height = frame Dialog-Frame :height
     1585         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1586         v-browse-height = v-diasize-browse-handle :height
     1587       .
     1588       for each buf_temp-browse-handle
     1589         where buf_temp-browse-handle.browse-type = 'height':u
     1590       :
     1591         assign
     1592           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1593         .
     1594       end.
     1595       for each buf_temp-diasize-handle
     1596       :
     1597         delete buf_temp-diasize-handle .
     1598       end.
     1599       assign
     1600         v-field-group-handle = frame Dialog-Frame :first-child
     1601       .
     1602       do while valid-handle(v-field-group-handle)
     1603       :
     1604         assign
     1605           v-object-handle = v-field-group-handle :first-child
     1606         .
     1607         do while valid-handle(v-object-handle)
     1608         :
     1609           if  v-object-handle <> v-diasize-browse-handle :handle
     1610           and can-query(v-object-handle, "row")
     1611           and can-query(v-object-handle, "height")
     1612           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1613           then do:
     1614             find first buf_temp-browse-handle
     1615               where buf_temp-browse-handle.browse-type   = 'height':u
     1616                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1617               no-error .
     1618             if available buf_temp-browse-handle
     1619             then do:
     1620             end.
     1621             else do:
     1622               create buf_temp-diasize-handle .
     1623               assign
     1624                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1625                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1626               .
     1627             end.
     1628           end.
     1629           assign
     1630             v-object-handle = v-object-handle :next-sibling
     1631           .
     1632         end.
     1633         assign
     1634           v-field-group-handle = v-field-group-handle :next-sibling
     1635         .
     1636       end.
     1637       do with frame Dialog-Frame
     1638       :
     1639         hide v-diasize-resize-button .
     1640         assign
     1641           v-diasize-resize-button :row    = 1
     1642           v-diasize-resize-button :column = 1
     1643         .
     1644       end.
     1645       if p-change-value > 0
     1646       then do:
     1647         if frame Dialog-Frame :scrollable = true
     1648         then do:
     1649           assign
     1650             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1651             no-error .
     1652           if error-status :error
     1653           or error-status :get-message(1) <> ""
     1654           then do:
     1655             undo move_block, retry move_block .
     1656           end.
     1657         end.
     1658         assign
     1659           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1660           no-error .
     1661         if error-status :error
     1662         or error-status :get-message(1) <> ""
     1663         then do:
     1664           undo move_block, retry move_block .
     1665         end.
     1666         assign
     1667           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1668           no-error .
     1669         if error-status :error
     1670         or error-status :get-message(1) <> ""
     1671         then do:
     1672           undo move_block, retry move_block .
     1673         end.
     1674         for each buf_temp-browse-handle
     1675           where buf_temp-browse-handle.browse-type = 'height':u
     1676         on error undo move_block, retry move_block
     1677         :
     1678           assign
     1679             buf_temp-browse-handle.browse-handle :height
     1680               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1681             no-error .
     1682           if error-status :error
     1683           or error-status :get-message(1) <> ""
     1684           then do:
     1685             undo move_block, retry move_block .
     1686           end.
     1687         end.
     1688         for each buf_temp-diasize-handle
     1689         on error undo move_block, retry move_block
     1690         :
     1691           assign
     1692             v-object-handle = buf_temp-diasize-handle.handle-value
     1693           .
     1694           if v-object-handle <> v-diasize-resize-button
     1695           then do:
     1696             assign
     1697               v-object-handle :row = v-object-handle :row + p-change-value
     1698               no-error .
     1699             if error-status :error
     1700             or error-status :get-message(1) <> ""
     1701             then do:
     1702               undo move_block, retry move_block .
     1703             end.
     1704           end.
     1705         end.
     1706       end.
     1707       else do:
     1708         for each buf_temp-diasize-handle
     1709         on error undo move_block, retry move_block
     1710         :
     1711           assign
     1712             v-object-handle = buf_temp-diasize-handle.handle-value
     1713           .
     1714           if v-object-handle <> v-diasize-resize-button
     1715           then do:
     1716             assign
     1717               v-object-handle :row = v-object-handle :row + p-change-value
     1718               no-error .
     1719             if error-status :error
     1720             or error-status :get-message(1) <> ""
     1721             then do:
     1722               undo move_block, retry move_block .
     1723             end.
     1724           end.
     1725         end.
     1726         assign
     1727           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1728           no-error .
     1729         if error-status :error
     1730         or error-status :get-message(1) <> ""
     1731         then do:
     1732           undo move_block, retry move_block .
     1733         end.
     1734         for each buf_temp-browse-handle
     1735           where buf_temp-browse-handle.browse-type = 'height':u
     1736         on error undo move_block, retry move_block
     1737         :
     1738           assign
     1739             buf_temp-browse-handle.browse-handle :height
     1740               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1741             no-error .
     1742           if error-status :error
     1743           or error-status :get-message(1) <> ""
     1744           then do:
     1745             undo move_block, retry move_block .
     1746           end.
     1747         end.
     1748         assign
     1749           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1750           no-error .
     1751         if error-status :error
     1752         or error-status :get-message(1) <> ""
     1753         then do:
     1754           undo move_block, retry move_block .
     1755         end.
     1756         if frame Dialog-Frame :scrollable = true
     1757         then do:
     1758           assign
     1759             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1760             no-error .
     1761           if error-status :error
     1762           or error-status :get-message(1) <> ""
     1763           then do:
     1764             undo move_block, retry move_block .
     1765           end.
     1766         end.
     1767       end.
     1768       if p-move-resize = true
     1769       then do:
     1770         run diasize_position-resize-button in this-procedure .
     1771       end.
     1772       if v-diasize-wndstore = true
     1773       then do:
     1774         if connected("ub") = true
     1775         then do:
     1776           define variable v-cntxt-db-num        as integer   no-undo .
     1777           define variable v-cntxt-userid        as character no-undo .
     1778           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1779                                             , OUTPUT v-cntxt-userid
     1780                                             ) .
     1781           run gbl/wndsizew.p
     1782             (input  v-cntxt-db-num
     1783             ,input  v-cntxt-userid
     1784             ,input  v-diasize-proc-name
     1785             ,input  'height':u
     1786             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1787             ) .
     1788         end.
     1789       end.
     1790     end.
     1791     assign
     1792       v-diasize-change-size = false
     1793     .
     1794   end procedure.
     1795   procedure diasize_set-height :
     1796     define input  parameter p-new-height  as decimal   no-undo .
     1797     define input  parameter p-move-resize as logical   no-undo .
     1798     do
     1799     on error undo, return error return-value
     1800     :
     1801       run diasize_change-height in this-procedure
     1802         (input  (p-new-height - frame Dialog-Frame :height)
     1803         ,input  p-move-resize
     1804         ) .
     1805     end.
     1806   end procedure.
     1807   procedure diasize_change-width :
     1808     define input  parameter p-change-value as decimal   no-undo .
     1809     define input  parameter p-move-resize  as logical   no-undo .
     1810     define variable v-field-group-handle   as handle    no-undo .
     1811     define variable v-object-handle        as handle    no-undo .
     1812     define variable v-frame-width          as decimal   no-undo .
     1813     define variable v-frame-virtual-width  as decimal   no-undo .
     1814     define variable v-browse-width         as decimal   no-undo .
     1815     define variable v-window-width         as decimal   no-undo .
     1816     define variable v-window-virtual-width as decimal   no-undo .
     1817     define variable v-change-sign          as integer   no-undo .
     1818     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1819     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1820     if p-change-value > 0
     1821     then do:
     1822       if frame Dialog-Frame :width + p-change-value >
     1823           session :width-chars
     1824       then do:
     1825         assign
     1826           p-change-value = session :width-chars - frame Dialog-Frame :width
     1827         .
     1828         if p-change-value <= 0
     1829         then do:
     1830           run diasize_position-resize-button in this-procedure .
     1831           return .
     1832         end.
     1833       end.
     1834     end.
     1835     if p-change-value < 0
     1836     then do:
     1837       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1838       then do:
     1839         assign
     1840           p-change-value = v-diasize-orig-frame-width
     1841                          - frame Dialog-Frame :width
     1842         .
     1843         if p-change-value >= 0
     1844         then do:
     1845           run diasize_position-resize-button in this-procedure .
     1846           return .
     1847         end.
     1848       end.
     1849     end.
     1850     if p-change-value >= 0
     1851     then do:
     1852       assign
     1853         v-change-sign = 1
     1854       .
     1855     end.
     1856     else do:
     1857       assign
     1858         v-change-sign = -1
     1859       .
     1860     end.
     1861     assign
     1862       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1863     .
     1864     if p-change-value = 0
     1865     then do:
     1866       run diasize_position-resize-button in this-procedure .
     1867       return .
     1868     end.
     1869     move_block:
     1870     do
     1871     on error undo move_block, leave move_block
     1872     :
     1873       if retry
     1874       then do:
     1875         do
     1876         on error undo move_block, leave move_block
     1877         :
     1878           if p-change-value > 0
     1879           then do:
     1880             for each buf_temp-diasize-handle
     1881             on error undo, next
     1882             :
     1883               assign
     1884                 v-object-handle = buf_temp-diasize-handle.handle-value
     1885               .
     1886               if v-object-handle <> v-diasize-resize-button
     1887               then do:
     1888                 assign
     1889                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1890                 .
     1891               end.
     1892             end.
     1893             assign
     1894               v-diasize-browse-handle :width = v-browse-width
     1895             .
     1896             for each buf_temp-browse-handle
     1897               where buf_temp-browse-handle.browse-type = 'width':u
     1898             on error undo, next
     1899             :
     1900               assign
     1901                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1902               .
     1903             end.
     1904             assign
     1905               frame Dialog-Frame :width = v-frame-width
     1906             .
     1907             if frame Dialog-Frame :scrollable = true
     1908             then do:
     1909               assign
     1910                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1911               .
     1912             end.
     1913             run diasize_position-resize-button in this-procedure .
     1914           end.
     1915           else do:
     1916             if frame Dialog-Frame :scrollable = true
     1917             then do:
     1918               assign
     1919                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1920               .
     1921             end.
     1922             assign
     1923               frame Dialog-Frame :width = v-frame-width
     1924             .
     1925             for each buf_temp-browse-handle
     1926               where buf_temp-browse-handle.browse-type = 'width':u
     1927             on error undo, next
     1928             :
     1929               assign
     1930                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1931               .
     1932             end.
     1933             assign
     1934               v-diasize-browse-handle :width = v-browse-width
     1935             .
     1936             for each buf_temp-diasize-handle
     1937             on error undo, next
     1938             :
     1939               assign
     1940                 v-object-handle = buf_temp-diasize-handle.handle-value
     1941               .
     1942               if v-object-handle <> v-diasize-resize-button
     1943               then do:
     1944                 assign
     1945                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1946                 .
     1947               end.
     1948             end.
     1949             run diasize_position-resize-button in this-procedure .
     1950           end.
     1951           assign
     1952             v-diasize-change-size = false
     1953           .
     1954           leave move_block .
     1955         end.
     1956       end.
     1957       assign
     1958         v-diasize-need-full-display = true
     1959       .
     1960       if v-diasize-change-size = false
     1961       then do:
     1962         assign
     1963           v-diasize-change-size = true
     1964         .
     1965       end.
     1966       else do:
     1967         return .
     1968       end.
     1969       assign
     1970         v-frame-width = frame Dialog-Frame :width
     1971         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1972         v-browse-width = v-diasize-browse-handle :width
     1973       .
     1974       for each buf_temp-browse-handle
     1975         where buf_temp-browse-handle.browse-type = 'width':u
     1976       :
     1977         assign
     1978           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1979         .
     1980       end.
     1981       for each buf_temp-diasize-handle
     1982       :
     1983         delete buf_temp-diasize-handle .
     1984       end.
     1985       assign
     1986         v-field-group-handle = frame Dialog-Frame :first-child
     1987       .
     1988       do while valid-handle(v-field-group-handle)
     1989       :
     1990         assign
     1991           v-object-handle = v-field-group-handle :first-child
     1992         .
     1993         do while valid-handle(v-object-handle)
     1994         :
     1995           if  v-object-handle <> v-diasize-browse-handle :handle
     1996           and v-object-handle <> v-diasize-resize-button
     1997           and can-query(v-object-handle, "row")
     1998           and can-query(v-object-handle, "height")
     1999           and ( v-object-handle :col + v-object-handle :width
     2000                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2001               )
     2002           then do:
     2003             find first buf_temp-browse-handle
     2004               where buf_temp-browse-handle.browse-type   = 'width':u
     2005                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2006               no-error .
     2007             if available buf_temp-browse-handle
     2008             then do:
     2009             end.
     2010             else do:
     2011               create buf_temp-diasize-handle .
     2012               assign
     2013                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2014                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2015               .
     2016             end.
     2017           end.
     2018           assign
     2019             v-object-handle = v-object-handle :next-sibling
     2020           .
     2021         end.
     2022         assign
     2023           v-field-group-handle = v-field-group-handle :next-sibling
     2024         .
     2025       end.
     2026       do with frame Dialog-Frame
     2027       :
     2028         hide v-diasize-resize-button .
     2029         v-diasize-resize-button :row = 1.
     2030         v-diasize-resize-button :column = 1.
     2031       end.
     2032       if p-change-value > 0
     2033       then do:
     2034         if frame Dialog-Frame :scrollable = true
     2035         then do:
     2036           assign
     2037             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2038             no-error .
     2039           if error-status :error
     2040           or error-status :get-message(1) <> ""
     2041           then do:
     2042             undo move_block, retry move_block.
     2043           end.
     2044         end.
     2045         assign
     2046           frame Dialog-Frame :width = v-frame-width + p-change-value
     2047           no-error .
     2048         if error-status :error
     2049         or error-status :get-message(1) <> ""
     2050         then do:
     2051           undo move_block, retry move_block.
     2052         end.
     2053         assign
     2054           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2055         no-error .
     2056         if error-status :error
     2057         or error-status :get-message(1) <> ""
     2058         then do:
     2059           undo move_block, retry move_block.
     2060         end.
     2061         for each buf_temp-browse-handle
     2062           where buf_temp-browse-handle.browse-type = 'width':u
     2063         on error undo move_block, retry move_block
     2064         :
     2065           assign
     2066             buf_temp-browse-handle.browse-handle :width
     2067               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2068             no-error .
     2069           if error-status :error
     2070           or error-status :get-message(1) <> ""
     2071           then do:
     2072             undo move_block, retry move_block .
     2073           end.
     2074         end.
     2075         for each buf_temp-diasize-handle
     2076         on error undo move_block, retry move_block
     2077         :
     2078           assign
     2079             v-object-handle = buf_temp-diasize-handle.handle-value
     2080           .
     2081           if v-object-handle <> v-diasize-resize-button
     2082           then do:
     2083             assign
     2084               v-object-handle :col = v-object-handle :col + p-change-value
     2085               no-error .
     2086             if error-status :error
     2087             or error-status :get-message(1) <> ""
     2088             then do:
     2089               undo move_block, retry move_block .
     2090             end.
     2091           end.
     2092         end.
     2093       end.
     2094       else do:
     2095         for each buf_temp-diasize-handle
     2096         on error undo move_block, retry move_block
     2097         :
     2098           assign
     2099             v-object-handle = buf_temp-diasize-handle.handle-value
     2100           .
     2101           if v-object-handle <> v-diasize-resize-button
     2102           then do:
     2103             assign
     2104               v-object-handle :col = v-object-handle :col + p-change-value
     2105               no-error .
     2106             if error-status :error
     2107             or error-status :get-message(1) <> ""
     2108             then do:
     2109               undo move_block, retry move_block .
     2110             end.
     2111           end.
     2112         end.
     2113         for each buf_temp-browse-handle
     2114           where buf_temp-browse-handle.browse-type = 'width':u
     2115         on error undo move_block, retry move_block
     2116         :
     2117           assign
     2118             buf_temp-browse-handle.browse-handle :width
     2119               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2120             no-error .
     2121           if error-status :error
     2122           or error-status :get-message(1) <> ""
     2123           then do:
     2124             undo move_block, retry move_block .
     2125           end.
     2126         end.
     2127         assign
     2128           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2129           no-error .
     2130         if error-status :error
     2131         or error-status :get-message(1) <> ""
     2132         then do:
     2133           undo move_block, retry move_block.
     2134         end.
     2135         assign
     2136           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2137         no-error .
     2138         if error-status :error
     2139         or error-status :get-message(1) <> ""
     2140         then do:
     2141           undo move_block, retry move_block.
     2142         end.
     2143         if frame Dialog-Frame :scrollable = true
     2144         then do:
     2145           assign
     2146             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2147           no-error .
     2148           if error-status :error
     2149           or error-status :get-message(1) <> ""
     2150           then do:
     2151             undo move_block, retry move_block.
     2152           end.
     2153         end.
     2154       end.
     2155       if p-move-resize
     2156       then do:
     2157         run diasize_position-resize-button in this-procedure .
     2158       end.
     2159       if v-diasize-wndstore = true
     2160       then do:
     2161         if connected("ub") = true
     2162         then do:
     2163           define variable v-cntxt-db-num        as integer   no-undo .
     2164           define variable v-cntxt-userid        as character no-undo .
     2165           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2166                                             , OUTPUT v-cntxt-userid
     2167                                             ) .
     2168           run gbl/wndsizew.p
     2169             (input  v-cntxt-db-num
     2170             ,input  v-cntxt-userid
     2171             ,input  v-diasize-proc-name
     2172             ,input  'width':u
     2173             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2174             ) .
     2175         end.
     2176       end.
     2177     end.
     2178     assign
     2179       v-diasize-change-size = false
     2180     .
     2181   end procedure.
     2182   procedure diasize_set-width :
     2183     define input  parameter p-new-width  as decimal   no-undo .
     2184     define input  parameter p-move-resize as logical   no-undo .
     2185     do
     2186     on error undo, return error return-value
     2187     :
     2188       run diasize_change-width in this-procedure
     2189         (input  (p-new-width - frame Dialog-Frame :width)
     2190         ,input  p-move-resize
     2191         ) .
     2192     end.
     2193   end procedure.
     2194   procedure diasize_position-resize-button :
     2195     do with frame Dialog-Frame
     2196     :
     2197       hide v-diasize-resize-button .
     2198       assign
     2199         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2200                     - 1
     2201                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2202         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2203                     - 1
     2204                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2205       .
     2206       view v-diasize-resize-button .
     2207     end.
     2208   end procedure.
     2209   on alt-right anywhere
     2210   do:
     2211     run diasize_change-width in this-procedure
     2212       (input 1
     2213       ,input true
     2214       ) .
     2215     return no-apply .
     2216   end.
     2217   on alt-left anywhere
     2218   do:
     2219     run diasize_change-width in this-procedure
     2220       (input -1
     2221       ,input true
     2222       ) .
     2223     return no-apply .
     2224   end.
     2225   on alt-down anywhere
     2226   do:
     2227     run diasize_change-height in this-procedure
     2228       (input 1
     2229       ,input true
     2230       ) .
     2231     return no-apply .
     2232   end.
     2233   on alt-up anywhere
     2234   do:
     2235     run diasize_change-height in this-procedure
     2236       (input -1
     2237       ,input true
     2238       ) .
     2239     return no-apply .
     2240   end.
     2241   on alt-enter of frame Dialog-Frame
     2242   do:
     2243     run diasize_maximize in this-procedure
     2244       (input  ?
     2245       ).
     2246     return no-apply .
     2247   end.
     2248   procedure diasize_end-move :
     2249     do
     2250     on error undo, return error return-value
     2251     :
     2252       define variable v-row-delta as decimal   no-undo .
     2253       define variable v-col-delta as decimal   no-undo .
     2254       define variable v-new-row as decimal   no-undo .
     2255       define variable v-new-col as decimal   no-undo .
     2256       assign
     2257         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2258         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2259       .
     2260       assign
     2261         v-row-delta = v-new-row - frame Dialog-Frame :height
     2262         v-col-delta = v-new-col - frame Dialog-Frame :width
     2263       .
     2264       run diasize_change-height in this-procedure
     2265         (input v-row-delta
     2266         ,input true
     2267         ) .
     2268       run diasize_change-width in this-procedure
     2269         (input v-col-delta
     2270         ,input true
     2271         ) .
     2272     end.
     2273   end procedure.
     2274   procedure diasize_maximize :
     2275     define input  parameter p-action as logical   no-undo .
     2276     do
     2277     on error undo, return error return-value
     2278     :
     2279       if p-action = ?
     2280       then do:
     2281         if v-diasize-need-maximize = true
     2282         then do:
     2283           assign
     2284             p-action = true
     2285           .
     2286         end.
     2287         else do:
     2288           assign
     2289             p-action = false
     2290           .
     2291         end.
     2292       end.
     2293       if p-action = true
     2294       then do:
     2295         run diasize_change-height in this-procedure
     2296           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2297               - frame Dialog-Frame :height-chars
     2298           ,input true
     2299           ) .
     2300         run diasize_change-width in this-procedure
     2301           (input session :width-chars
     2302               - frame Dialog-Frame :width-chars
     2303           ,input true
     2304           ) .
     2305         assign
     2306           v-diasize-need-maximize = false
     2307         .
     2308       end.
     2309       else do:
     2310         run diasize_change-width in this-procedure
     2311           (input v-diasize-orig-frame-width
     2312               - frame Dialog-Frame :width-chars
     2313           ,input true
     2314           ) .
     2315         run diasize_change-height in this-procedure
     2316           (input v-diasize-orig-frame-height
     2317               - frame Dialog-Frame :height-chars
     2318           ,input true
     2319           ) .
     2320         assign
     2321           v-diasize-need-maximize = true
     2322         .
     2323       end.
     2324     end.
     2325   end procedure.
     2326   procedure diasize_restore-orig-size :
     2327     do
     2328     on error undo, return error return-value
     2329     :
     2330       assign
     2331         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2332         v-diasize-current-frame-height = frame Dialog-Frame :height
     2333       .
     2334       run diasize_set-height in this-procedure
     2335         (input  v-diasize-orig-frame-height
     2336         ,input  true
     2337         ) .
     2338       run diasize_set-width in this-procedure
     2339         (input  v-diasize-orig-frame-width
     2340         ,input  true
     2341         ) .
     2342     end.
     2343   end procedure.
     2344   procedure diasize_restore-current-size :
     2345     do
     2346     on error undo, return error return-value
     2347     :
     2348       run diasize_set-height in this-procedure
     2349         (input  v-diasize-current-frame-height
     2350         ,input  true
     2351         ) .
     2352       run diasize_set-width in this-procedure
     2353         (input  v-diasize-current-frame-width
     2354         ,input  true
     2355         ) .
     2356     end.
     2357   end procedure.
     2358   procedure diasize_set-browse-handle :
     2359     define input  parameter p-browse-handle as handle   no-undo .
     2360     define buffer buf_temp-browse-handle for temp-browse-handle .
     2361     do
     2362     on error undo, return error return-value
     2363     :
     2364       assign
     2365         v-diasize-browse-handle = p-browse-handle
     2366       .
     2367       for each buf_temp-browse-handle
     2368       on error undo, return error return-value
     2369       :
     2370         delete buf_temp-browse-handle .
     2371       end.
     2372     end.
     2373   end procedure.
     2374   procedure diasize_add_browse :
     2375     define input  parameter p-browse-type   as character no-undo .
     2376     define input  parameter p-browse-handle as handle    no-undo .
     2377     define buffer buf_temp-browse-handle for temp-browse-handle .
     2378     do
     2379     on error undo, return error return-value
     2380     :
     2381       assign
     2382         v-diasize-browse-number = v-diasize-browse-number + 1
     2383       .
     2384       create buf_temp-browse-handle .
     2385       assign
     2386         buf_temp-browse-handle.browse-type   = p-browse-type
     2387         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2388         buf_temp-browse-handle.browse-handle = p-browse-handle
     2389       .
     2390     end.
     2391   end procedure.
     2392   procedure diasize_init :
     2393     define variable v-default-value    as logical   no-undo .
     2394     define variable v-restore-saved    as logical   no-undo .
     2395     define variable v-resize-value-str as character no-undo .
     2396     do
     2397     on error undo, return error return-value
     2398     :
     2399       do with frame Dialog-Frame
     2400       :
     2401         assign
     2402           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2403           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2404           v-diasize-browse-handle     = browse br-wp :handle
     2405         .
     2406         create button v-diasize-resize-button
     2407         assign
     2408           parent        = frame Dialog-Frame :first-child
     2409           label         = "s"
     2410           height-pixels = 16
     2411           width-pixels  = 16
     2412           visible       = true
     2413           sensitive     = true
     2414           movable       = true
     2415           triggers:
     2416             on end-move persistent run diasize_end-move in this-procedure .
     2417           end triggers.
     2418         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2419         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2420         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2421         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2422         assign
     2423           v-diasize-wndmax = false
     2424         .
     2425         if connected("ub") = true
     2426         then do:
     2427           define variable v-cntxt-db-num        as integer   no-undo .
     2428           define variable v-cntxt-userid        as character no-undo .
     2429           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2430                                             , OUTPUT v-cntxt-userid
     2431                                             ) .
     2432           run gbl/wndpar_r.p
     2433             (input  v-cntxt-db-num
     2434             ,input  v-cntxt-userid
     2435             ,input  'wndmax':U
     2436             ,output v-diasize-wndmax
     2437             ,output v-default-value
     2438             ) .
     2439         end.
     2440         assign
     2441           v-diasize-wndstore = false
     2442         .
     2443         if connected("ub") = true
     2444         then do:
     2445           run gbl/wndpar_r.p
     2446             (input  v-cntxt-db-num
     2447             ,input  v-cntxt-userid
     2448             ,input  'wndstore':U
     2449             ,output v-diasize-wndstore
     2450             ,output v-default-value
     2451             ) .
     2452         end.
     2453         assign
     2454           v-diasize-proc-name = entry(1, program-name(2), '.')
     2455         .
     2456         if v-diasize-wndstore = true
     2457         then do:
     2458           assign
     2459             v-restore-saved = false
     2460           .
     2461           if connected("ub") = true
     2462           then do:
     2463             run gbl/wndsizer.p
     2464               (input  v-cntxt-db-num
     2465               ,input  v-cntxt-userid
     2466               ,input  v-diasize-proc-name
     2467               ,input  'height':u
     2468               ,output v-resize-value-str
     2469               ) .
     2470             if v-resize-value-str <> '':U
     2471             then do:
     2472               run diasize_change-height in this-procedure
     2473                 (input  integer(v-resize-value-str)
     2474                 ,input  true
     2475                 ) .
     2476               assign
     2477                 v-restore-saved = true
     2478               .
     2479             end.
     2480           end.
     2481           if connected("ub") = true
     2482           then do:
     2483             run gbl/wndsizer.p
     2484               (input  v-cntxt-db-num
     2485               ,input  v-cntxt-userid
     2486               ,input  v-diasize-proc-name
     2487               ,input  'width':u
     2488               ,output v-resize-value-str
     2489               ) .
     2490             if v-resize-value-str <> '':U
     2491             then do:
     2492               run diasize_change-width in this-procedure
     2493                 (input  integer(v-resize-value-str)
     2494                 ,input  true
     2495                 ) .
     2496               assign
     2497                 v-restore-saved = true
     2498               .
     2499             end.
     2500           end.
     2501           if v-restore-saved <> true
     2502           then do:
     2503             if v-diasize-wndmax = true
     2504             then do:
     2505               run diasize_maximize in this-procedure
     2506                 (input  true
     2507                 ) .
     2508             end.
     2509           end.
     2510         end.
     2511         else do:
     2512           if v-diasize-wndmax = true
     2513           then do:
     2514             run diasize_maximize in this-procedure
     2515               (input  true
     2516               ) .
     2517           end.
     2518         end.
     2519       end.
     2520     end.
     2521   end procedure.
     2522   procedure diasize_need-full-display :
     2523     define output parameter p-need-full-display as logical   no-undo .
     2524     do
     2525     on error undo, return error return-value
     2526     :
     2527       assign
     2528         p-need-full-display = v-diasize-need-full-display
     2529       .
     2530       assign
     2531         v-diasize-need-full-display = false
     2532       .
     2533     end.
     2534   end procedure.
     2535   procedure get-context :
     2536      define output parameter p-db-num as integer          no-undo.
     2537      define output parameter p-user-id as character        no-undo.
     2538      define variable v-login               as character    no-undo.
     2539      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2540      define buffer buf_user-login  for ub.user-login .
     2541      do
     2542      on error undo, return error
     2543      :
     2544            FIND FIRST buf_sys-ctrl no-lock.
     2545            ASSIGN
     2546               v-login = USERID("ub")
     2547               p-db-num = buf_sys-ctrl.db-num
     2548            .
     2549            FIND FIRST buf_user-login
     2550                 WHERE buf_user-login.db-num = p-db-num
     2551                   AND buf_user-login.user-login = v-login
     2552                 no-lock
     2553                 no-error
     2554                 .
     2555            IF AVAILABLE buf_user-login
     2556            THEN DO:
     2557               assign
     2558                  p-user-id = buf_user-login.user-id
     2559               .
     2560            END.
     2561      end.
     2562   end procedure.
     2563   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2564   on f5 of frame Dialog-Frame anywhere
     2565   do:
     2566     v-doc-rec = recid(X_wth-place). run openbr in this-procedure. reposition br-wp to recid v-doc-rec no-error.               apply 'value-changed' to br-wp.
     2567       apply "VALUE-CHANGED" to BR-changes.
     2568   end.
     2569   def var sort-labelbr-wp   as character no-undo .
     2570   def var sort-clmnbr-wp    as handle    no-undo .
     2571   def var cur-clmnbr-wp     as handle    no-undo .
     2572   def var cur-clmn-locbr-wp as integer   no-undo .
     2573   def var re-querybr-wp     as logical   initial no no-undo .
     2574   on start-search, ctrl-o of br-wp in frame Dialog-Frame do:
     2575      run sort-brbr-wp
     2576        (input (if available temp-changes
     2577                then recid(temp-changes)
     2578                else ?
     2579               )
     2580        ).
     2581   end.
     2582   PROCEDURE sort-brbr-wp :
     2583     define input parameter p-recid as recid no-undo .
     2584     if re-querybr-wp = no then do:
     2585       assign
     2586          cur-clmnbr-wp = br-wp:current-column in frame Dialog-Frame
     2587       .
     2588       if sort-clmnbr-wp <> ? then sort-clmnbr-wp:column-fgcolor = 0.
     2589       if cur-clmnbr-wp = sort-clmnbr-wp then do:
     2590         assign
     2591            sort-labelbr-wp = ""
     2592            sort-clmnbr-wp = ?
     2593         .
     2594        end.
     2595        else do:
     2596          assign
     2597            sort-labelbr-wp = cur-clmnbr-wp:label
     2598            sort-clmnbr-wp  = cur-clmnbr-wp
     2599            sort-clmnbr-wp:column-fgcolor = 4
     2600          .
     2601        end.
     2602      end.
     2603     assign
     2604       cur-clmn-locbr-wp = 1
     2605     .
     2606     def var column-handle as handle no-undo .
     2607     column-handle = br-wp:first-column.
     2608     do while valid-handle(column-handle) :
     2609       if column-handle = cur-clmnbr-wp then do:
     2610         leave .
     2611       end.
     2612       column-handle = column-handle:NEXT-COLUMN.
     2613       assign
     2614         cur-clmn-locbr-wp = cur-clmn-locbr-wp + 1
     2615       .
     2616     end.
     2617     case sort-labelbr-wp:
     2618           when X_c-wth-place.w-p-name:label in browse br-wp then DO:   assign     sort-column-name = "X_c-wth-place.w-p-name"   .   run OpenBr.   . END.
     2619           when X_c-wth-place.corr-date:label in browse br-wp then DO:   assign     sort-column-name = "X_c-wth-place.corr-date"   .   run OpenBr.   . END.
     2620       otherwise do:
     2621         assign
     2622           sort-column-name = ""
     2623         .
     2624         run OpenBr.
     2625           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-wp') then do:
     2626             run mv-brw-defaultbr-wp.
     2627           end.
     2628         if sort-labelbr-wp <> "" then do:
     2629           assign
     2630             cur-clmnbr-wp:column-fgcolor = 0
     2631           .
     2632         end.
     2633         assign
     2634           cur-clmn-locbr-wp = ?
     2635         .
     2636       end.
     2637     end case.
     2638       if cur-clmn-locbr-wp <> ? then do:
     2639         if can-do( this-procedure:internal-entries, 'ch-clmnbr-wp') then do:
     2640           run ch-clmnbr-wp in this-procedure (cur-clmn-locbr-wp).
     2641         end.
     2642       end.
     2643     if p-recid <> ? then do:
     2644       reposition br-wp to recid p-recid no-error.
     2645       apply "value-changed" to br-wp in frame Dialog-Frame.
     2646     end.
     2647     apply "entry" to br-wp in frame Dialog-Frame.
     2648   END PROCEDURE.
     2649   procedure re-open-query-srt-clmnbr-wp:
     2650   if cur-clmnbr-wp = ? then do:
     2651      run OpenBr.
     2652   end.
     2653   else do:
     2654      assign re-querybr-wp = yes.
     2655      run sort-brbr-wp
     2656        (input (if available temp-changes
     2657                then recid(temp-changes)
     2658                else ?
     2659               )
     2660        ).
     2661      assign re-querybr-wp = no.
     2662   end.
     2663   end.
     2664   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2665   do:
     2666     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2667   end.
     2668   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2669   on INS of frame Dialog-Frame anywhere do:
     2670     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2671     return no-apply.
     2672   end.
     2673   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2674   on F3 of frame Dialog-Frame anywhere do:
     2675     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     2676     return no-apply.
     2677   end.
     2678   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2679   on F2 of frame Dialog-Frame anywhere do:
     2680     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2681     return no-apply.
     2682   end.
     2683   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2684   on F2 of frame Dialog-Frame anywhere do:
     2685     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2686     return no-apply.
     2687   end.
     2688   MAIN-BLOCK:
     2689   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2690      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2691     find first X_curr_clients no-lock where
     2692               X_curr_clients.obj-type = p-obj-type
     2693          AND X_curr_clients.obj-code = p-obj-code no-error.
     2694     if not available X_curr_clients then do:
     2695       message
     2696       vss-workfile vss-revision vss-description skip
     2697       "Неверное значение параметра вызова p-obj-type p-obj-code"
     2698       p-obj-type p-obj-code
     2699       view-as alert-box ERROR.
     2700       return error .
     2701     end.
     2702    if LOOKUP(p-mode, 'one':U,
     2703                   chr(4)) = 0
     2704        then dO:
     2705       message
     2706       vss-workfile vss-revision vss-description skip
     2707       "Неверное значение параметров вызова p-mode"
     2708       p-mode
     2709       view-as alert-box ERROR.
     2710       return error .
     2711    end.
     2712    if p-mode = "one":U then do:
     2713     find first X_wth-place no-lock where
     2714                   X_wth-place.w-p-code = p-w-p-code
     2715               AND X_wth-place.obj-type = p-obj-type
     2716               AND X_wth-place.obj-code = p-obj-code no-error.
     2717       if not available X_wth-place then do:
     2718           message
     2719           vss-workfile vss-revision vss-description skip
     2720           "Неверное значение параметра вызова p-w-p-code или p-obj-type/p-obj-code"
     2721           p-w-p-code p-obj-type p-obj-code
     2722           view-as alert-box ERROR.
     2723           return.
     2724       end.
     2725     end.
     2726   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2727   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2728     (output v-db-num
     2729     )  .
     2730     RUN MyEnable.
     2731     RUn OpenBR.
     2732     HIDE mark-num in frame Dialog-Frame .
     2733     if v-doc-rec <> ? then
     2734     REPOSITION br-wp to recid v-doc-rec No-ERROR.
     2735   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2736   DEF VAR cur-clmn-numbr-wp as INT EXTENT 7 no-undo.
     2737   DEF VAR varmvibr-wp       as INT no-undo.
     2738   DEF VAR varmvjbr-wp       as INT no-undo.
     2739   DEF VAR varmvkbr-wp       as INT no-undo.
     2740   DEF VAR varmvlbr-wp       as INT no-undo.
     2741   DEF VAR move-elementbr-wp as INT no-undo.
     2742   def var jjbr-wp           as int no-undo.
     2743   do varmvibr-wp = 1 to EXTENT(cur-clmn-numbr-wp):
     2744     ASSIGN cur-clmn-numbr-wp[varmvibr-wp] = varmvibr-wp.
     2745   END.
     2746   RUN start-mv-clmnbr-wp.
     2747   PROCEDURE start-mv-clmnbr-wp:
     2748   def var old-session as logical no-undo.
     2749      old-session = SESSION:IMMEDIATE-DISPLAY.
     2750      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2751          IF  p-mode = 'one'  THEN DO:
     2752      DO jjbr-wp = NUM-ENTRIES('1,2,3,4,5,6,7') TO 1 BY -1:
     2753        RUN re-move-clmnbr-wp ( cur-clmn-numbr-wp[INTEGER(ENTRY (jjbr-wp, '1,2,3,4,5,6,7'))] , 1).
     2754      END.
     2755          END.
     2756      SESSION:IMMEDIATE-DISPLAY = old-session.
     2757   END.
     2758   ON ctrl-cursor-right OF BROWSE br-wp do:
     2759     RUN re-move-clmnbr-wp ( 1, 7).
     2760   END.
     2761   ON ctrl-cursor-left OF BROWSE br-wp do:
     2762     RUN re-move-clmnbr-wp (7, 1).
     2763   END.
     2764   PROCEDURE re-move-clmnbr-wp:
     2765     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2766     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2767     DO varmvibr-wp = 1 TO EXTENT(cur-clmn-numbr-wp):
     2768       if cur-clmn-numbr-wp[varmvibr-wp] = source-column THEN cur-clmn-numbr-wp[varmvibr-wp] = -1.
     2769     END.
     2770     if br-wp:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2771     if source-column > target-column THEN
     2772     DO varmvjbr-wp = source-column - 1 to target-column BY -1:
     2773       DO varmvibr-wp = 1 TO EXTENT(cur-clmn-numbr-wp):
     2774           if cur-clmn-numbr-wp[varmvibr-wp] = varmvjbr-wp THEN DO:
     2775             cur-clmn-numbr-wp[varmvibr-wp] = cur-clmn-numbr-wp[varmvibr-wp] + 1.
     2776           END.
     2777       END.
     2778     END.
     2779     ELSE
     2780     DO varmvjbr-wp = source-column + 1 to target-column:
     2781       DO varmvibr-wp = 1 TO EXTENT(cur-clmn-numbr-wp):
     2782         if cur-clmn-numbr-wp[varmvibr-wp] = varmvjbr-wp THEN DO:
     2783           cur-clmn-numbr-wp[varmvibr-wp] = cur-clmn-numbr-wp[varmvibr-wp] - 1.
     2784         END.
     2785       END.
     2786     END.
     2787     DO varmvibr-wp = 1 TO EXTENT(cur-clmn-numbr-wp):
     2788       if cur-clmn-numbr-wp[varmvibr-wp] = -1 THEN cur-clmn-numbr-wp[varmvibr-wp] = target-column.
     2789     END.
     2790   END PROCEDURE.
     2791   PROCEDURE ch-clmnbr-wp:
     2792     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2793     if cur-clmn-loc <= 1 then do:
     2794       return .
     2795     end.
     2796     DO varmvibr-wp = 1 TO EXTENT(cur-clmn-numbr-wp):
     2797       if cur-clmn-numbr-wp[varmvibr-wp] = cur-clmn-loc THEN move-elementbr-wp = varmvibr-wp.
     2798     END.
     2799     RUN re-move-clmnbr-wp (cur-clmn-loc, 1).
     2800   END PROCEDURE.
     2801   PROCEDURE mv-brw-defaultbr-wp:
     2802   def var old-session as logical no-undo.
     2803     old-session = SESSION:IMMEDIATE-DISPLAY.
     2804     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2805     do varmvlbr-wp = 1 to EXTENT(cur-clmn-numbr-wp):
     2806       RUN re-move-clmnbr-wp (cur-clmn-numbr-wp[varmvlbr-wp], varmvlbr-wp).
     2807     END.
     2808     RUN start-mv-clmnbr-wp.
     2809     SESSION:IMMEDIATE-DISPLAY = old-session.
     2810   END PROCEDURE.
     2811   .
     2812    run diasize_add_browse in this-procedure
     2813       (input  'width':u
     2814       ,input  browse br-changes :handle
     2815       ) .
     2816    run diasize_init in this-procedure .
     2817   WAIT-FOR GO OF FRAME Dialog-Frame.
     2818   END.
     2819   RUN disable_UI.
     2820   PROCEDURE disable_UI :
     2821     HIDE FRAME Dialog-Frame.
     2822   END PROCEDURE.
     2823   PROCEDURE enable_UI :
     2824     DISPLAY mark-num
     2825         WITH FRAME Dialog-Frame.
     2826     ENABLE b-quit B-mark B-sel b-lkp B-Help br-wp BR-changes mark-num
     2827         WITH FRAME Dialog-Frame.
     2828     VIEW FRAME Dialog-Frame.
     2829     OPEN QUERY br-wp FOR EACH X_c-wth-place NO-LOCK INDEXED-REPOSITION.
     2830   END PROCEDURE.
     2831   PROCEDURE MyEnable :
     2832   assign
     2833   temp-changes.l_name:resizable in browse br-changes = true
     2834   temp-changes.v_old:resizable in browse br-changes = true
     2835   temp-changes.v_new:resizable in browse br-changes = true
     2836   temp-changes.l_name:width in browse br-changes = 30
     2837   temp-changes.v_old:width in browse br-changes = 40
     2838   temp-changes.v_new:width in browse br-changes = 40
     2839   .
     2840   DISPLAY mark-num
     2841   WITH FRAME Dialog-Frame.
     2842   ENABLE
     2843   b-quit
     2844   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2845   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2846   B-Help
     2847   br-wp mark-num
     2848   b-lkp
     2849   br-changes
     2850   with FRAME Dialog-Frame.
     2851   VIEW FRAME Dialog-Frame.
     2852   END PROCEDURE.
     2853   PROCEDURE OpenBr :
     2854   define variable v-host-code as integer no-undo .
     2855   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2856   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2857     (input  p-obj-type
     2858     ,input  p-obj-code
     2859     ,output v-host-code
     2860     )  .
     2861   OPEN QUERY br-wp FOR EACH X_c-wth-place NO-LOCK where
     2862                                  X_c-wth-place.w-p-code = p-w-p-code
     2863                              and X_c-wth-place.host-code = v-host-code
     2864                              and X_c-wth-place.obj-type = p-obj-type
     2865                              and X_c-wth-place.obj-code = p-obj-code
     2866                                 INDEXED-REPOSITION.
     2867   APPLY "VALUE-CHANGED" TO br-wp in frame Dialog-Frame.
     2868   APPLY "ENTRY" TO br-wp.
     2869   END PROCEDURE.
     2870   PROCEDURE proc-br-wp :
     2871   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2872   if b-sel:sensitive in frame Dialog-Frame then dO:
     2873       if b-mark:sensitive then do:
     2874           apply "choose" to b-mark in frame Dialog-Frame.
     2875       end.
     2876       else do:
     2877           apply "choose" to b-sel in frame Dialog-Frame.
     2878       end.
     2879   end.
     2880   else do:
     2881       if b-lkp:sensitive then
     2882       apply "choose" to b-lkp in frame Dialog-Frame.
     2883   end.
     2884   END PROCEDURE.
     2885   PROCEDURE proc-view-changes :
     2886   for each temp-changes:
     2887       delete temp-changes.
     2888   END.
     2889   if not available X_c-wth-place then do:
     2890     Open QUery br-changes for each temp-changes.
     2891     return.
     2892   end.
     2893   define variable v-label-param as character no-undo .
     2894   v-label-param =
     2895     "w-p-code" + chr(4) + "Код МХ МЦ" + chr(4) + "" + chr(8)
     2896    + "w-p-name" + chr(4) + "Название МХ МЦ" + chr(4) + "" + chr(8)
     2897    + "status_" + chr(4) + "Статус" + chr(4) + "" + chr(8)
     2898    + "PS" + chr(4) + "Примечания" + chr(4) + "" + chr(8)
     2899    + "cash-desk" + chr(4) + "№ кассы" + chr(4) + "" + chr(8)
     2900    + "main-cash-desk" + chr(4) + "Главная касса" + chr(4) + ""  .
     2901    run proc-full-temp-changes in this-procedure (
     2902                                                input  buffer X_c-wth-place:handle
     2903                                               ,input  'wth-place':U
     2904                                               ,input  "w-p-code,w-p-name,status_,PS,cash-desk,main-cash-desk"
     2905                                               ,input  v-label-param).
     2906   Open QUery br-changes for each temp-changes.
     2907   END PROCEDURE.
