     3533       end.
     3534       else do:
     3535           assign
     3536             l-query-was-opened = true
     3537           .
     3538       end.
     3539     end.
     3540     if l-filter-open-27 = false then do:
     3541       OPEN QUERY br-docs FOR EACH buf_fin-code
     3542         where  buf_fin-code.host-code = par-host-code and buf_fin-code.status_ = p-sts
     3543          USE-INDEX val
