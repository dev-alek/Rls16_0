     3778         parameter-3-29 =  "FOR EACH buf_fin-code"
     3779         parameter-4-29 =
     3780           (
     3781             if (" TRUE " + " " + where-phrase-29) <> ""
     3782             then  'TRUE'  + " " + where-phrase-29
     3783             else "true"
     3784           )
     3785         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3786         parameter-6-29 = if sort-phrase-29 = ''
     3787                              then
     3788           (
     3789           " " + "  " +
     3790             " " + sort-column-phrase +
     3791           " " + "  "
     3792           )
     3793                              else
     3794           (
     3795           " " + "  " +
     3796             " " + sort-column-phrase +
     3797           " " + sort-phrase-29
     3798           )
     3799         parameter-7-29 =
     3800           " indexed-reposition  "
     3801       .
     3802         run fltopend_fltfindq in this-procedure  (
     3803                             input this-procedure:handle
     3804                             ,input query br-docs:handle
     3805                             ,input logical(parameter-2-29)
     3806                             ,input no-lock
     3807                             ,input parameter-3-29
     3808                             ,input parameter-4-29
     3809                             ,input parameter-5-29
     3810                             ,input parameter-6-29
     3811                             ,input parameter-7-29
     3812                             ,output v-fltopend-rowid
     3813                             ) no-error.
     3814         .
     3815         doc-rec = ?.
     3816       end.
     3817       assign
     3818         l-query-was-opened = true
     3819       .
     3820     end.
     3821   end.
     3822     run waitfram-hide in this-procedure .
     3823            END.
     3824            WHEN 'фирма':U THEN DO:
     3825               find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3826               if not available buf_clients then return .
     3827               filter-point = filter-point0 + par-mode.
     3828               ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name  + "  код:" +  string(par-host-code).
     3829   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3830   define variable  l-disable-where-31  as logical   no-undo .
