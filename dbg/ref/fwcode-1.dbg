     3487             then  substitute (' buf_fin-code.host-code = &2 and  buf_fin-code.status_ =  &1 ', p-sts , par-host-code)  + " " + where-phrase-27
     3488             else "true"
     3489           )
     3490         parameter-5-27 = (" " + "" + " " + "")
     3491         parameter-6-27 = if sort-phrase-27 = ''
     3492                              then
     3493           (
     3494           " " + " USE-INDEX val " +
     3495             " " + sort-column-phrase +
     3496           " " + "  "
     3497           )
     3498                              else
     3499           (
     3500           " " + " USE-INDEX val " +
     3501             " " + sort-column-phrase +
     3502           " " + sort-phrase-27
     3503           )
     3504         parameter-7-27 =
     3505           " indexed-reposition  "
     3506       .
     3507       do
     3508       on stop undo, leave
