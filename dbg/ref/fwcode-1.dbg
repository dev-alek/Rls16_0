     3837   define variable  sort-phrase-rus-31  as character no-undo .
     3838     run waitfram-show in this-procedure
     3839       (input "ЖДИТЕ ..."
     3840       ).
     3841   run gbl/flt-get.p
     3842     (input filter-point
     3843     ,output flt-rec-31
     3844     ,output filter-name-31
     3845     ,output where-phrase-31
     3846     ,output sort-phrase-31
     3847     ,output where-phrase-rus-31
     3848     ,output sort-phrase-rus-31
     3849     ).
     3850   if p-open-query then do:
     3851       run set-filter-name in this-procedure
     3852         (INPUT filter-name-31
     3853         ) no-error .
     3854     assign
     3855       l-filter-open-31 = false
     3856     .
     3857     if flt-rec-31 <> ?
     3858       or sort-column-phrase > ""
     3859     then do:
     3860       define variable  parameter-2-31 as character no-undo .
     3861       define variable  parameter-3-31 as character no-undo .
     3862       define variable  parameter-4-31 as character no-undo .
     3863       define variable  parameter-5-31 as character no-undo .
     3864       define variable  parameter-6-31 as character no-undo .
     3865       define variable  parameter-7-31 as character no-undo .
     3866         assign
     3867         parameter-3-31 =
     3868                                 "FOR EACH buf_fin-code"
     3869         parameter-4-31 =
     3870           (
     3871             if (" buf_fin-code.host-code = par-host-code " + " " + where-phrase-31) <> ""
     3872             then  substitute (' buf_fin-code.host-code = &1 ', par-host-code)  + " " + where-phrase-31
     3873             else "true"
     3874           )
     3875         parameter-5-31 = (" " + "" + " " + "")
     3876         parameter-6-31 = if sort-phrase-31 = ''
     3877                              then
     3878           (
     3879           " " + " USE-INDEX val " +
     3880             " " + sort-column-phrase +
     3881           " " + "  "
     3882           )
     3883                              else
     3884           (
     3885           " " + " USE-INDEX val " +
     3886             " " + sort-column-phrase +
     3887           " " + sort-phrase-31
     3888           )
     3889         parameter-7-31 =
     3890           " indexed-reposition  "
     3891       .
     3892       do
     3893       on stop undo, leave
     3894       on error undo, leave
     3895       :
     3896         assign
     3897           l-disable-where-31 =
     3898             (" buf_fin-code.host-code = par-host-code " + " " + where-phrase-31 = "")
     3899         .
     3900         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3901                             ,input query br-docs:handle
     3902                             ,input parameter-3-31
     3903                             ,input parameter-4-31
     3904                             ,input parameter-5-31
     3905                             ,input parameter-6-31
     3906                             ,input parameter-7-31
     3907                             )
     3908         .
     3909         assign
     3910           l-filter-open-31 = true
     3911         .
     3912       end.
     3913       if l-filter-open-31 = false then do:
     3914         message
     3915           "Ошибка при фильтрации / сортировке" skip
     3916           "Будут показаны записи без учета фильтра" skip
     3917           view-as alert-box .
     3918       end.
     3919       else do:
     3920           assign
     3921             l-query-was-opened = true
     3922           .
     3923       end.
     3924     end.
     3925     if l-filter-open-31 = false then do:
     3926       OPEN QUERY br-docs FOR EACH buf_fin-code
     3927         where  buf_fin-code.host-code = par-host-code
     3928          USE-INDEX val
     3929         indexed-reposition
     3930     .
     3931         assign
     3932           l-query-was-opened = true
     3933         .
     3934     end.
     3935   end.
     3936   else do:
     3937     assign
     3938       doc-rec = recid( buf_fin-code )
     3939     .
     3940     do
     3941     on stop undo, leave
     3942     on error undo, leave
     3943     :
     3944       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_fin-code:handle) then do:
     3945         assign
     3946         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     3947         parameter-4-31 =
     3948           "where ":u +  substitute (' buf_fin-code.host-code = &1 ', par-host-code)  + " ":u + where-phrase-31 + " ":u + p-find-condition + " " + ""
     3949         parameter-5-31 = " USE-INDEX val "
     3950       .
     3951         run fltopend_fltfindd in this-procedure  (
     3952                             input this-procedure:handle
     3953                             ,input query br-docs:handle
     3954                             ,input rowid(buf_fin-code)
     3955                             ,input logical(parameter-2-31)
     3956                             ,input no-lock
     3957                             ,input (buffer buf_fin-code:handle)
     3958                             ,input parameter-4-31
     3959                             ,input parameter-5-31
     3960                             ) no-error.
     3961         .
     3962         assign
     3963           doc-rec = integer(return-value)
     3964           v-fltopend-rowid[1] = ?
     3965         .
     3966       end.
     3967       else do:
     3968         assign
     3969         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     3970         parameter-3-31 =  "FOR EACH buf_fin-code"
     3971         parameter-4-31 =
     3972           (
     3973             if (" buf_fin-code.host-code = par-host-code " + " " + where-phrase-31) <> ""
     3974             then  substitute (' buf_fin-code.host-code = &1 ', par-host-code)  + " " + where-phrase-31
     3975             else "true"
     3976           )
     3977         parameter-5-31 = (" " + "" + " " + "" + " " + p-find-condition)
     3978         parameter-6-31 = if sort-phrase-31 = ''
     3979                              then
     3980           (
     3981           " " + " USE-INDEX val " +
     3982             " " + sort-column-phrase +
     3983           " " + "  "
     3984           )
     3985                              else
     3986           (
     3987           " " + " USE-INDEX val " +
     3988             " " + sort-column-phrase +
     3989           " " + sort-phrase-31
     3990           )
     3991         parameter-7-31 =
     3992           " indexed-reposition  "
     3993       .
     3994         run fltopend_fltfindq in this-procedure  (
     3995                             input this-procedure:handle
     3996                             ,input query br-docs:handle
     3997                             ,input logical(parameter-2-31)
     3998                             ,input no-lock
     3999                             ,input parameter-3-31
     4000                             ,input parameter-4-31
     4001                             ,input parameter-5-31
     4002                             ,input parameter-6-31
     4003                             ,input parameter-7-31
     4004                             ,output v-fltopend-rowid
     4005                             ) no-error.
     4006         .
     4007         doc-rec = ?.
     4008       end.
     4009       assign
     4010         l-query-was-opened = true
     4011       .
     4012     end.
     4013   end.
     4014     run waitfram-hide in this-procedure .
     4015            END.
     4016        END CASE.
     4017    END.
     4018   if not p-open-query and doc-rec <> ? then
     4019   REPOSITION br-docs to recid doc-rec No-ERROR.
     4020   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4021   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4022   apply "entry" to br-docs in frame Dialog-Frame.
     4023   END PROCEDURE.
     4024   PROCEDURE print-proc :
     4025   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4026   do:
     4027     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4028       (input  v-cntxt-db-num
     4029       ,input  v-cntxt-userid
     4030       ,input  0
     4031       ,input  'actn_fin-reference_print':U
     4032       ,input  'firm':U
     4033       ,input  par-host-code
     4034       ,input  '':U
     4035       ,input  0
     4036       ,input  0
     4037       ,input  0
     4038       ,input  0
     4039       ,input  true
     4040       ,output g#log
     4041       )  .
     4042   end.
     4043   if not g#log then  return .
     4044   define variable sym1   as char format "X(1)" init ":".
     4045   define variable sym2 as char format "X(1)" init ":".
     4046   define variable sym3 as char format "X(1)" init ":".
     4047   define variable sym4 as char format "X(1)" init ":".
     4048   define variable date_string     as      char    no-undo.
     4049   define variable Line                as      char    no-undo.
     4050   define variable for-time as char.
     4051   define variable l-type as character no-undo .
     4052   DEFINE FRAME Chk-List
     4053           sym1                      column-label "_"                   format "X(1)" space(0)
     4054           buf_fin-code.code-value   column-label "Код_"                format "X(12)"
     4055           sym2                      column-label " "                   format "X(1)"
     4056           l-type                    column-label "Тип"
     4057           sym4                      column-label " "                   format "X(1)"
     4058           buf_fin-code.descr        column-label "Описание_"           format "X(80)"
     4059           sym3                      column-label " "                   format "X(1)"
     4060           HEADER  date_string AT 5 format "X(35)"
     4061                       string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER(PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     4062                       Line format "X(108)" AT 1
     4063       with width 232 down stream-io use-text    .
     4064       Line = fill("-", 108).
     4065       date_string = cur-time-print() .
     4066   run prn-lib-open-stream  in this-procedure (
     4067                                                input parParentProc
     4068                                               ,input 43
     4069                                               ,input yes
     4070                                               ,input no
     4071                                               ).
     4072       PUT  STREAM PrnLibStream
     4073       SPACE(25) ( frame Dialog-Frame:title )
     4074       format "x(108)" SKIP(1) .
     4075       FORM HEADER
     4076               Line format "X(177)" AT 1 SKIP
     4077               "Продолжение - на следующей странице" AT 30 SKIP
     4078               with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4079       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4080       FORM with FRAME Chk-List  .
     4081       run waitfram-show in this-procedure("Ждите...").
     4082       run openbr in this-procedure (yes, no, '':u).
     4083        DO WHILE available buf_fin-code :
     4084                Display STREAM PrnLibStream
     4085               sym1
     4086               sym2
     4087               sym3
     4088               sym4
     4089               buf_fin-code.code-value
     4090               buf_fin-code.descr
     4091               sel-type(recid( ub.buf_fin-code)) @ l-type
     4092               with FRAME Chk-List .
     4093               DOWN STREAM PrnLibStream 1 with FRAME CHk-List  .
     4094               GET next br-docs.
     4095         END.
     4096         UNDERLINE  STREAM PrnLibStream
     4097               sym1 sym2 sym3 sym4
     4098               buf_fin-code.code-value buf_fin-code.descr l-type
     4099               with FRAME Chk-List .
     4100       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4101       HIDE  STREAM PrnLibStream FRAME CheckList.
     4102       output  STREAM PrnLibStream CLOSE.
     4103       run waitfram-hide in this-procedure.
     4104       run prn-lib-prn-file in this-procedure (
     4105                                             input parParentProc
     4106                                             ,input 0
     4107                                             ).
     4108   END PROCEDURE.
     4109   PROCEDURE proc-b-sch :
     4110   assign
     4111     tbl = 'ub.fin-code-cor-acc'
     4112     join-tbl = 'buf_fin-code'
     4113     fld = ""
     4114     lab = ""
     4115     spr = ""
     4116     dim = '0'
     4117     .
     4118   run fltfield-add in this-procedure('code-value', 'Код', '',
     4119   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4120   run fltfield-add in this-procedure('descr', 'Описание', '',
     4121   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4122   run fltfield-add in this-procedure('fin-code', 'Внутр.№', '',
     4123   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4124   run fltfield-add in this-procedure('host-code', 'Код фирмы', '',
     4125   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4126   run fltfield-add in this-procedure('level-1', 'Уровень_1', '',
     4127   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4128   run fltfield-add in this-procedure('level-2', 'Уровень_2', '',
     4129   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4130   run fltfield-add in this-procedure('level-3', 'Уровень_3', '',
     4131   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4132   Filter-Block:
     4133   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4134       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4135       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4136     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     4137     run openbr in this-procedure (yes, no, '':u).
     4138   END.
     4139   END PROCEDURE.
     4140   PROCEDURE proc-copy :
     4141   define variable p-fin-code as integer no-undo .
     4142   define variable p-out-host-code like ub.sysconf.host-code no-undo.
     4143   define variable firm-rid-list as char no-undo.
     4144   define variable p-ok as logical no-undo .
     4145   define buffer buf2_fin-code for ub.fin-code-cor-acc .
     4146   define variable i as integer no-undo .
     4147   define variable J as integer no-undo .
     4148   define variable k as integer no-undo .
     4149   define variable p-ret as logical no-undo .
     4150   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4151   do:
     4152     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4153       (input  v-cntxt-db-num
     4154       ,input  v-cntxt-userid
     4155       ,input  0
     4156       ,input  'actn_fin-reference_export':U
     4157       ,input  'firm':U
     4158       ,input  par-host-code
     4159       ,input  '':U
     4160       ,input  0
     4161       ,input  0
     4162       ,input  0
     4163       ,input  0
     4164       ,input  true
     4165       ,output g#log
     4166       )  .
     4167   end.
     4168   if not g#log then  return .
     4169   if num-entries(rid-list) = 0 then do:
     4170      message "Не отмечены записи для копирования !!!" .
     4171      return .
     4172   end.
     4173   define variable v-out-host-code  as integer no-undo .
     4174   define variable v-lock-self-host as integer no-undo .
     4175   define variable v-curr-host-code as integer no-undo .
     4176   v-lock-self-host = par-host-code.
     4177   v-lock-self-host = par-host-code.
     4178   run adm/sconfs.w
     4179   (
     4180    input parParentProc,
     4181    input "b-sel,b-mark" ,
     4182    input no,
     4183    input par-host-code,
     4184    output v-out-host-code,
     4185    input-output firm-rid-list )
     4186    .
     4187    if num-entries(firm-rid-list) = 0 then do:
     4188      message "Не выбрана фирма для копирования !!!" .
     4189      return .
     4190      end.
     4191     message
     4192       "Вы отметили " num-entries(firm-rid-list) " фирмы. " skip
     4193       "Скопировать выбранные значения справочника в эти фирмы ?"
     4194       view-as alert-box question
     4195       buttons yes-no
     4196       update p-ok.
     4197   k = 0.
     4198     if p-ok = false then return.
     4199   define buffer buf_sysconf for ub.sysconf.
     4200   define variable v-nn as integer   no-undo .
     4201   define variable v-nnn as integer   no-undo .
     4202   v-nn  = num-entries(firm-rid-list) .
     4203   v-nnn = num-entries(rid-list) .
     4204     repeat i = 1 to  v-nn :
     4205        for each buf_sysconf no-lock where recid(buf_sysconf) = integer(entry(i,firm-rid-list)) :
     4206           repeat j = 1 to v-nnn :
     4207             for each buf2_fin-code where recid(buf2_fin-code) =  integer(entry(j,rid-list)):
     4208             if not can-find ( first buf_fin-code no-lock where
     4209                                 buf_fin-code.host-code      = buf_sysconf.host-code and
     4210                                 buf_fin-code.code-value     = buf2_fin-code.code-value) then do:
     4211                     run current-db in this-procedure (
     4212                         input buf_fin-code.host-code,
     4213                         input par-host-code,
     4214                         output p-ret ) .
     4215                     if p-ret = no then next.
     4216                     run fin-code in this-procedure (input buf_sysconf.host-code , output p-fin-code) .
     4217                     run create-ref-corr-acc in this-procedure (
     4218                         input yes ,
     4219                         input buf_sysconf.host-code,
     4220                         input p-fin-code   ,
     4221                         input buf2_fin-code.code-value ,
     4222                         input buf2_fin-code.descr,
     4223                         input buf2_fin-code.status_,
     4224                         input buf2_fin-code.level-1,
     4225                         input buf2_fin-code.level-2,
     4226                         input buf2_fin-code.level-3,
     4227                         input buf2_fin-code.acc-type
     4228                         ).
     4229                         k = k + 1.
     4230                     end.
     4231             end.
     4232           end.
     4233        end.
     4234     end.
     4235   message "Скопировано " k  "записей" view-as alert-box .
     4236   END PROCEDURE.
     4237   PROCEDURE proc-find-code :
     4238   define input parameter par-next as logical no-undo.
     4239   define input parameter pardoc-code as char no-undo.
     4240   display "" @ p-desc with frame Dialog-Frame.
     4241   assign
     4242     pardoc-code = chr(34) + pardoc-code + chr(34) .
     4243   run OpenBr in this-procedure
     4244       (input false
     4245       ,input par-next
     4246       ,input substitute("and buf_fin-code.code-value   begins &1 "
     4247         , pardoc-code)
     4248       ).
     4249   END PROCEDURE.
     4250   PROCEDURE proc-find-desc :
     4251   define input parameter par-next as logical no-undo.
     4252   define input parameter pardoc-code as char no-undo.
     4253   display "" @ sch-code with frame Dialog-Frame.
     4254   assign
     4255     pardoc-code = chr(34) + pardoc-code + chr(34) .
