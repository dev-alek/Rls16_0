     1098   DEFINE VARIABLE p-desc AS CHARACTER FORMAT "X(80)":U
     1099        LABEL "по &описанию"
     1100        VIEW-AS FILL-IN
     1101        SIZE 29.25 BY 1 TOOLTIP "Поиск по описанию  Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1102   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(12)":U
     1103        LABEL "по &коду"
     1104        VIEW-AS FILL-IN
     1105        SIZE 14 BY 1 TOOLTIP "Поиск по коду справочника Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1106   DEFINE VARIABLE rs-sts AS CHARACTER
     1107        VIEW-AS RADIO-SET HORIZONTAL
     1108        RADIO-BUTTONS
     1109             "Item 1", "1",
     1110   "Item 2", "2",
     1111   "Item 3", "3"
     1112        SIZE 34.5 BY .75 NO-UNDO.
     1113   DEFINE QUERY BR-docs FOR
     1114         buf_fin-code SCROLLING.
     1115   DEFINE BROWSE BR-docs
     1116     QUERY BR-docs DISPLAY
     1117         mark-string(recid( ub.buf_fin-code), rid-list) COLUMN-LABEL "*" FORMAT "x(1)"
     1118         buf_fin-code.code-value COLUMN-LABEL "Код" FORMAT "x(6)"
     1119         sel-type(recid( ub.buf_fin-code)) @ t-a COLUMN-LABEL "Тип" FORMAT "x(9)"
     1120         buf_fin-code.descr    COLUMN-LABEL "Описание"
     1121         buf_fin-code.fin-code COLUMN-LABEL "Внутр. №"
     1122         buf_fin-code.host-code    COLUMN-LABEL "Фирма" format ">>>>>>>>9"
     1123         entry (lookup (STRING(buf_fin-code.status_ ), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ t-s  COLUMN-LABEL "Статус" FORMAT "x(6)"
     1124         buf_fin-code.level-1 COLUMN-LABEL   "Уровень1" format ">>>9"
     1125         buf_fin-code.level-2 COLUMN-LABEL   "Уровень2" format ">>>9"
     1126         buf_fin-code.level-3 COLUMN-LABEL   "Уровень3" format ">>>9"
     1127         enable buf_fin-code.code-value
     1128       WITH NO-ROW-MARKERS SEPARATORS SIZE 69.88 BY 12.75.
     1129   DEFINE FRAME Dialog-Frame
     1130        B-exit AT ROW 1 COL 1
     1131        B-mark AT ROW 1 COL 11.5
     1132        B-sel AT ROW 1 COL 21
     1133        B-add AT ROW 1 COL 31
     1134        B-lkp AT ROW 1 COL 41
     1135        B-chg AT ROW 1 COL 51
     1136        B-del AT ROW 1 COL 61
     1137        B-History AT ROW 2 COL 1
     1138        B-import AT ROW 2 COL 11
     1139        B-firm AT ROW 2 COL 21
     1140        B-copy AT ROW 2 COL 31
     1141        B-sch AT ROW 2 COL 41
     1142        B-print AT ROW 2 COL 51
     1143        B-Help AT ROW 2 COL 61
     1144        BR-docs AT ROW 3.25 COL 1.25
     1145        rs-sts AT ROW 16.25 COL 35 NO-LABEL
     1146        sch-code AT ROW 17.38 COL 1
     1147        p-desc AT ROW 17.38 COL 23.75
     1148        mark-num AT ROW 1 COL 14.88 NO-LABEL
     1149        " ПОИСК" VIEW-AS TEXT
     1150             SIZE 7.13 BY .71 AT ROW 16.67 COL 1.13
     1151             BGCOLOR 3 FGCOLOR 15
     1152        SPACE(62.98) SKIP(1.28)
     1153       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1154            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1155            TITLE "Справочник"
     1156            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-exit.
     1157   ASSIGN
     1158          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1159          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1160   ASSIGN
     1161          B-History:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1162   ASSIGN
     1163          B-import:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1164   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1165   DO:
     1166     APPLY "END-ERROR":U TO SELF.
     1167   END.
     1168   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1169   DO:
     1170     run add-proc in this-procedure.
     1171   END.
     1172   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1173   DO:
     1174   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175   do:
     1176     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1177       (input  v-cntxt-db-num
     1178       ,input  v-cntxt-userid
     1179       ,input  0
     1180       ,input  'actn_fin-reference_update':U
     1181       ,input  'firm':U
     1182       ,input  par-host-code
     1183       ,input  '':U
     1184       ,input  0
     1185       ,input  0
     1186       ,input  0
     1187       ,input  0
     1188       ,input  true
     1189       ,output g#log
     1190       )  .
     1191   end.
     1192   if not g#log then  return .
     1193   define variable rr as recid no-undo .
     1194       if available buf_fin-code then do:
     1195           rr = recid( buf_fin-code ).
     1196           run ref/fci-1.w
     1197           ( 'ИЗМЕНЕНИЕ':U , input-output rr , input par-host-code ).
     1198           disp buf_fin-code.code-value
     1199                buf_fin-code.descr
     1200                sel-type(recid( ub.buf_fin-code)) @ t-a
     1201                buf_fin-code.level-1
     1202                buf_fin-code.level-2
     1203                buf_fin-code.level-3
     1204           with browse br-docs.
     1205       end.
     1206   END.
     1207   ON CHOOSE OF B-copy IN FRAME Dialog-Frame
     1208   DO:
     1209   run proc-copy in this-procedure.
     1210   END.
     1211   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1212   DO:
     1213   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1214   do:
     1215     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1216       (input  v-cntxt-db-num
     1217       ,input  v-cntxt-userid
     1218       ,input  0
     1219       ,input  'actn_fin-reference_deletion':U
     1220       ,input  'firm':U
     1221       ,input  par-host-code
     1222       ,input  '':U
     1223       ,input  0
     1224       ,input  0
     1225       ,input  0
     1226       ,input  0
     1227       ,input  true
     1228       ,output g#log
     1229       )  .
     1230   end.
     1231   if not g#log then  return .
     1232     else do:
     1233         message "Удалить запись в справочнике ?"
     1234         view-as alert-box question
     1235         buttons yes-no
     1236         update g#log.
     1237         if g#log = false then return.
     1238     end.
     1239     find current buf_fin-code  exclusive-lock  no-error .
     1240     if available buf_fin-code then do:
     1241         find first ub.sysconf no-lock where
     1242               ( ub.sysconf.cor-acc-in   = buf_fin-code.fin-code    and
     1243                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1244               ( ub.sysconf.cor-acc1-in  = buf_fin-code.fin-code    and
     1245                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1246               ( ub.sysconf.cor-acc-out  = buf_fin-code.fin-code    and
     1247                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1248               ( ub.sysconf.cor-acc1-out = buf_fin-code.fin-code    and
     1249                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1250               ( ub.sysconf.cor-acc-in-cash  = buf_fin-code.fin-code    and
     1251                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1252               ( ub.sysconf.cor-acc1-in-cash  = buf_fin-code.fin-code    and
     1253                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1254               ( ub.sysconf.cor-acc-out-cash  = buf_fin-code.fin-code    and
     1255                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1256               ( ub.sysconf.cor-acc1-out-cash  = buf_fin-code.fin-code    and
     1257                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1258               ( ub.sysconf.cor-acc-in-payoff  = buf_fin-code.fin-code    and
     1259                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1260               ( ub.sysconf.cor-acc1-in-payoff  = buf_fin-code.fin-code    and
     1261                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1262               ( ub.sysconf.cor-acc-out-payoff  = buf_fin-code.fin-code    and
     1263                 ub.sysconf.host-code = buf_fin-code.host-code ) or
     1264               ( ub.sysconf.cor-acc1-out-payoff = buf_fin-code.fin-code    and
     1265                 ub.sysconf.host-code = buf_fin-code.host-code )
     1266                 no-error .
     1267         if available ub.sysconf
     1268           then do:
     1269             message
     1270               vss-workfile vss-revision vss-description skip
     1271               "Нельзя удалять запись! " skip
     1272               "Значение справочника используется в настройке фирмы"  skip
     1273               view-as alert-box error .
     1274             return no-apply.
     1275           end.
     1276       buf_fin-code.status_ = 1.
     1277       run OpenBr in this-procedure (yes, no, '':U).
     1278     end.
     1279   END.
     1280   ON CHOOSE OF B-firm IN FRAME Dialog-Frame
     1281   DO:
     1282   define var p-out-host-code like ub.sysconf.host-code no-undo.
     1283   define variable v-rid-list as character no-undo .
     1284   define buffer buf_sysconf for ub.sysconf.
     1285   find first buf_sysconf no-lock where
     1286               buf_sysconf.host-code = par-host-code no-error.
     1287   if available buf_sysconf then v-rid-list =string( recid(buf_sysconf) ).
     1288   run adm/sconfs.w
     1289                (input parParentProc,
     1290                 input "b-sel":U,
     1291                 input no,
     1292                 input  par-host-code ,
     1293                 output p-out-host-code,
     1294                 input-output v-rid-list ) no-error
     1295                 .
     1296   if error-status :error then     message vss-workfile vss-revision vss-description skip
     1297                                           error-status :get-message(1)
     1298                                           skip " из sconfs.w"
     1299                                           view-as alert-box error
     1300                                           .
     1301   define variable p-ret as logical no-undo .
     1302   if p-out-host-code <> ? then do:
     1303   run current-db in this-procedure (
     1304       input p-out-host-code,
     1305       input par-host-code,
     1306       output p-ret ) no-error .
     1307   if error-status :error then do:
     1308      message vss-workfile vss-revision vss-description skip
     1309              error-status :get-message(1) .
     1310      return .
     1311      end.
     1312   if p-ret = no then return.
     1313   if p-out-host-code <> ? then
     1314      par-host-code = p-out-host-code .
     1315   run OpenBR in this-procedure (yes, no, '':U).
     1316   end.
     1317   END.
     1318   ON CHOOSE OF B-import IN FRAME Dialog-Frame
     1319   DO:
     1320     run buh-import in this-procedure.
     1321   END.
     1322   ON CHOOSE OF B-History IN FRAME Dialog-Frame
     1323   DO:
     1324       if available buf_fin-code then do:
     1325          run ref/fincac.w
     1326            (input  parparentproc              ,
     1327             input  buf_fin-code.host-code     ,
     1328             input  buf_fin-code.fin-code
     1329             ).
     1330       end.
     1331   END.
     1332   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     1333   DO:
     1334   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1335   do:
     1336     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1337       (input  v-cntxt-db-num
     1338       ,input  v-cntxt-userid
     1339       ,input  0
     1340       ,input  'actn_fin-reference_lookup':U
     1341       ,input  'firm':U
     1342       ,input  par-host-code
     1343       ,input  '':U
     1344       ,input  0
     1345       ,input  0
     1346       ,input  0
     1347       ,input  0
     1348       ,input  true
     1349       ,output g#log
     1350       )  .
     1351   end.
     1352   if not g#log then  return .
     1353   define variable rr as recid no-undo .
     1354       if available buf_fin-code then do:
     1355           rr = recid( buf_fin-code ).
     1356           run ref/fci-1.w ( 'ПРОСМОТР':U , input-output rr , input par-host-code ).
     1357        end.
     1358   END.
     1359   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1360   DO:
     1361         if available buf_fin-code then do:
     1362   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1363   define variable v-str-recid15 as character no-undo .
     1364   define variable v-num-entry15 as integer   no-undo .
     1365   assign
     1366     v-str-recid15 = trim( string( recid( buf_fin-code ) , "->>>>>>>>>>>9":U ) )
     1367     v-num-entry15 = lookup( v-str-recid15 , rid-list )
     1368   .
     1369   if v-num-entry15 > 0 then do:
     1370     assign
     1371       entry( v-num-entry15, rid-list ) = "":U
     1372       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1373     .
     1374   end.
     1375   else do:
     1376     assign
     1377       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1378     .
     1379   end.
     1380           g#log = br-docs:refresh() .
     1381           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1382               g#log = br-docs:select-next-row ().
     1383               apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1384           end.
     1385           if num-entries( rid-list ) = 0
     1386           then
     1387               hide mark-num in frame Dialog-Frame.
     1388           else do:
     1389               mark-num:screen-value in frame Dialog-Frame  = string (num-entries( rid-list )) .
     1390               enable mark-num with frame Dialog-Frame.
     1391               end.
     1392       end.
     1393       apply "entry" to br-docs in frame Dialog-Frame.
     1394   END.
     1395   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1396   DO:
     1397     run print-proc in this-procedure.
     1398   END.
     1399   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1400   DO:
     1401     run proc-b-sch in this-procedure no-error.
     1402     if error-status:error then return no-apply.
     1403   END.
     1404   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1405   DO:
     1406       if ( available buf_fin-code ) AND ( rid-list = "" ) then
     1407       rid-list = string( recid( buf_fin-code ) ) .
     1408   END.
     1409   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     1410   DO:
     1411      if b-mark:sensitive in frame Dialog-Frame then
     1412     APPLY "CHOOSE" to b-mark.
     1413   END.
     1414   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     1415   DO:
     1416       if b-mark:sensitive in frame Dialog-Frame then
     1417     APPLY "CHOOSE" to b-mark.
     1418       else do:
     1419         if b-sel:sensitive in frame Dialog-Frame then
     1420         APPLY "CHOOSE" to b-sel.
     1421       end.
     1422   END.
     1423   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1424   OR MOUSE-SELECT-DBLCLICK OF BR-docs IN FRAME Dialog-Frame
     1425   DO:
     1426         if b-sel:sensitive in frame Dialog-Frame  = yes then
     1427           apply "choose" to b-sel in frame Dialog-Frame.
     1428       else
     1429           apply "choose" to B-lkp in frame Dialog-Frame.
     1430   END.
     1431   ON LEAVE OF p-desc IN FRAME Dialog-Frame
     1432   DO:
     1433   END.
     1434   ON CTRL-J OF p-desc IN FRAME Dialog-Frame
     1435   DO:
     1436     run proc-find-desc in this-procedure(yes, input frame Dialog-Frame p-desc) no-error.
     1437     if error-status:error then return no-apply.
     1438   END.
     1439   ON RETURN OF p-desc IN FRAME Dialog-Frame
     1440   DO:
     1441     run proc-find-desc in this-procedure(no, input frame Dialog-Frame p-desc) no-error.
     1442     return no-apply.
     1443   END.
     1444   ON VALUE-CHANGED OF rs-sts IN FRAME Dialog-Frame
     1445   DO:
     1446       ASSIGN
     1447     rs-sts
     1448     p-sts = (IF rs-sts = 'все':U  THEN ? ELSE INTEGER(rs-sts))
     1449     .
     1450     run openbr in this-procedure (yes, no, '':u)  no-error.
     1451     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1452   END.
     1453   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1454   DO:
     1455     run proc-find-code in this-procedure(no, input frame Dialog-Frame sch-code) no-error.
     1456     return no-apply.
     1457   END.
     1458   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1459   DO:
     1460     run proc-find-code in this-procedure(yes, input frame Dialog-Frame sch-code) no-error.
     1461     if error-status:error then return no-apply.
     1462   END.
     1463   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1464   define buffer buf_file for ub.fin-code-cor-acc .
     1465   procedure current-db :
     1466    do
     1467    on error undo, return error return-value
     1468    :
     1469   define input parameter  p-host-code as integer no-undo .
     1470   define input parameter  c-host-code as integer no-undo .
     1471   define output parameter ret         as logical no-undo .
     1472   define buffer current_sysconf for ub.sysconf.
     1473   define variable v-current-db as integer no-undo .
     1474   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     1475   if error-status :error then return error .
     1476      v-current-db = current_sysconf.firm-db-num .
     1477      ret = true .
     1478   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
     1479   if not( ub.sysconf.firm-db-num = v-current-db or
     1480           ub.sysconf.firm-db-num = 0 )
     1481     then do:
     1482     ret = false .
     1483     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
     1484     return .
     1485   end.
     1486    end.
     1487   end procedure.
     1488   procedure ver-db :
     1489    do
     1490    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1491    :
     1492   define input parameter  c-host-code as integer no-undo .
     1493   define input parameter  par-ver-db  as integer no-undo .
     1494   define input parameter  p-mess as logical no-undo .
     1495   define output parameter ret         as logical no-undo .
     1496   define buffer current_sysconf for ub.sysconf.
     1497   define variable v-current-db as integer no-undo .
     1498   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     1499   if error-status :error then return error .
     1500      v-current-db = current_sysconf.firm-db-num .
     1501      ret = true .
     1502   if not( par-ver-db = v-current-db or
     1503           par-ver-db = 0 )
     1504     then do:
     1505     ret = false .
     1506     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
     1507     return .
     1508   end.
     1509    end.
     1510   end procedure.
     1511   procedure fin-code :
     1512    do
     1513    on error undo, return error return-value
     1514    :
     1515     define input  parameter p-host-code as integer no-undo .
     1516     define output parameter p-fin-code  as integer no-undo .
     1517     p-fin-code = next-value(s-fin-code, ub) .
     1518    end.
     1519   end procedure.
     1520   procedure create-ref-fin-code :
     1521    do
     1522    on error undo, return error return-value
     1523    :
     1524   define input parameter p-ver as logical no-undo .
     1525   define input parameter p-host-code  as integer   no-undo .
     1526   define input parameter p-fin-code   as integer   no-undo .
     1527   define input parameter p-code-value as character no-undo .
     1528   define input parameter p-descr      as character no-undo .
     1529   define input parameter p-status_    as integer   no-undo .
     1530   define input parameter p-level-1    as integer   no-undo .
     1531   define input parameter p-level-2    as integer   no-undo .
     1532   define input parameter p-level-3    as integer   no-undo .
     1533   if p-ver then do:
     1534       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
     1535                                           buf_file.fin-code  = p-fin-code no-error .
     1536       if available buf_file then return error .
     1537   end.
     1538   define variable p-ret as logical no-undo .
     1539   run current-db in this-procedure (
     1540       input p-host-code,
     1541       input p-host-code,
     1542       output p-ret ) .
     1543    if p-ret = no then return.
     1544    create ub.fin-code-cor-acc.
     1545    assign
     1546      ub.fin-code-cor-acc.host-code  = p-host-code
     1547      ub.fin-code-cor-acc.fin-code   = p-fin-code
     1548      ub.fin-code-cor-acc.code-value = p-code-value
     1549      ub.fin-code-cor-acc.descr      = p-descr
     1550      ub.fin-code-cor-acc.status_    = p-status_
     1551      ub.fin-code-cor-acc.level-1    = p-level-1
     1552      ub.fin-code-cor-acc.level-2    = p-level-2
     1553      ub.fin-code-cor-acc.level-3    = p-level-3
     1554     no-error .
     1555     if error-status :error then do:
     1556         message vss-include-info16 skip
     1557                 error-status :get-message(1)
     1558                 view-as alert-box error .
     1559         return error .
     1560     end.
     1561    end.
     1562   end procedure.
     1563   procedure create-ref-corr-acc :
     1564    do
     1565    on error undo, return error return-value
     1566    :
     1567   define input parameter p-ver as logical no-undo .
     1568   define input parameter p-host-code  as integer   no-undo .
     1569   define input parameter p-fin-code   as integer   no-undo .
     1570   define input parameter p-code-value as character no-undo .
     1571   define input parameter p-descr      as character no-undo .
     1572   define input parameter p-status_    as integer   no-undo .
     1573   define input parameter p-level-1    as integer   no-undo .
     1574   define input parameter p-level-2    as integer   no-undo .
     1575   define input parameter p-level-3    as integer   no-undo .
     1576   define input parameter p-acc-type    as integer   no-undo .
     1577   define buffer buf_file  for ub.fin-code-cor-acc .
     1578   if p-ver then do:
     1579       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
     1580                                           buf_file.fin-code  = p-fin-code no-error .
     1581       if available buf_file then return error .
     1582   end.
     1583   define variable p-ret as logical no-undo .
     1584   run current-db in this-procedure (
     1585       input p-host-code,
     1586       input p-host-code,
     1587       output p-ret ) .
     1588    if p-ret = no then return.
     1589    create ub.fin-code-cor-acc.
     1590    assign
     1591      ub.fin-code-cor-acc.host-code  = p-host-code
     1592      ub.fin-code-cor-acc.fin-code   = p-fin-code
     1593      ub.fin-code-cor-acc.code-value = p-code-value
     1594      ub.fin-code-cor-acc.descr      = p-descr
     1595      ub.fin-code-cor-acc.status_    = p-status_
     1596      ub.fin-code-cor-acc.level-1    = p-level-1
     1597      ub.fin-code-cor-acc.level-2    = p-level-2
     1598      ub.fin-code-cor-acc.level-3    = p-level-3
     1599      ub.fin-code-cor-acc.acc-type   = p-acc-type
     1600     no-error .
     1601     if error-status :error then do:
     1602         message vss-include-info16 skip
     1603                 error-status :get-message(1)
     1604                 view-as alert-box error .
     1605         return error .
     1606     end.
     1607    end.
     1608   end procedure.
     1609   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1610   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1611   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1612   on help of frame Dialog-Frame
     1613   do:
     1614     run gbl/app_help.p
     1615       (input this-procedure :file-name
     1616       ,input ''
     1617       ,input ?
     1618       ) no-error.
     1619     if error-status :error then do:
     1620       message
     1621         "Ошибка при вызове помощи"
     1622         error-status :get-message(1)
     1623         view-as alert-box .
     1624     end.
     1625   end.
     1626   run minbtn-set in this-procedure .
     1627   on choose of b-help in frame Dialog-Frame
     1628   do:
     1629     apply "help":u to frame Dialog-Frame .
     1630   end.
     1631   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1632   procedure minbtn-set :
     1633       do
     1634           on error undo, return error return-value
     1635           :
     1636           define variable ii              as integer       no-undo .
     1637           define variable fh              as widget-handle no-undo .
     1638           define variable hh              as widget-handle no-undo .
     1639           define variable v-h             as handle        extent 4 no-undo .
     1640           define variable v-name-button   as character     no-undo .
     1641           define variable v-help-old-x    as decimal       no-undo .
     1642           define variable v-help-old-y    as decimal       no-undo .
     1643           define variable v-help-old-size as decimal       no-undo .
     1644           define variable v-frame-width   as decimal       no-undo .
     1645           define variable jj              as integer       no-undo .
     1646           do
     1647               on error undo, return error
     1648               :
     1649               assign
     1650                   v-frame-width = frame Dialog-Frame:width - 0.3
     1651                   fh            = frame Dialog-Frame:first-child
     1652                   hh            = fh:first-child
     1653                   ii            = 1
     1654                   .
     1655               do while valid-handle(hh):
     1656                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1657                   do:
     1658                       case lc(hh:name) :
     1659                           when "b-help" then
     1660                               do:
     1661                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1662                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1663                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1664                                   hh:TOOLTIP = "Помощь" .
     1665                                   v-help-old-x = hh:column .
     1666                                   v-help-old-y = hh:row    .
     1667                                   v-help-old-size = hh:width .
     1668                                   hh:width-chars = 2.5 .
     1669                               end.
     1670                           when "b-print" then
     1671                               do:
     1672                                   hh:load-image("cmp/b-print.bmp":u) .
     1673                                   hh:TOOLTIP = "Печать" .
     1674                                   v-h[ii] = hh:handle .
     1675                                   ii = ii + 1 .
     1676                                   hh:width-chars = 3 .
     1677                               end.
     1678                           when "b-history" or
     1679                           when "b-hist" then
     1680                               do:
     1681                                   hh:load-image("cmp/b-hist.bmp":u) .
     1682                                   hh:TOOLTIP = "История" .
     1683                                   v-h[ii] = hh:handle .
     1684                                   ii = ii + 1 .
     1685                                   hh:width-chars = 3 .
     1686                               end.
     1687                           when "b-sch" then
     1688                               do:
     1689                                   hh:load-image("cmp/b-sch.bmp":u) .
     1690                                   hh:TOOLTIP = "Установка Фильтра" .
     1691                                   v-h[ii] = hh:handle .
     1692                                   ii = ii + 1 .
     1693                                   hh:width-chars = 3 .
     1694                               end.
     1695                           when "b-hist-user" then
     1696                               do:
     1697                                   hh:load-image("cmp/b-hist.bmp":u) .
     1698                                   hh:TOOLTIP = "История пользователя" .
     1699                                   ii = ii + 1 .
     1700                               end.
     1701                       end case.
     1702                   end.
     1703                   hh = hh:next-sibling.
     1704               end.
     1705               b-help:column = v-frame-width - b-help:width-chars.
     1706               jj = 0.
     1707               repeat ii = 4 to 1 by -1 :
     1708                   if valid-handle (v-h[ii] ) then
     1709                   do:
     1710                       jj  = jj + 1 .
     1711                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1712                       v-h[ii]:row    = v-help-old-y .
     1713                   end.
     1714               end.
     1715           end.
     1716       end.
     1717   end procedure.
     1718   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1719   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1720   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1721   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1722   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1723   define variable v-diasize-current-frame-height as decimal   no-undo .
     1724   define variable v-diasize-change-size          as logical   no-undo .
     1725   define variable v-diasize-resize-button        as handle    no-undo .
     1726   define variable v-diasize-wndmax               as logical   no-undo .
     1727   define variable v-diasize-wndstore             as logical   no-undo .
     1728   define variable v-diasize-proc-name            as character no-undo .
     1729   define variable v-diasize-browse-handle        as handle    no-undo .
     1730   define variable v-diasize-browse-number        as integer   no-undo .
     1731   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1732   define temp-table temp-diasize-handle no-undo
     1733     field handle-value  as handle
     1734     field save-position as decimal
     1735     index xpk is primary unique handle-value
     1736     .
     1737   define temp-table temp-browse-handle no-undo
     1738     field browse-type   as character
     1739     field browse-number as integer
     1740     field browse-handle as handle
     1741     field original-size as decimal
     1742     index xpk is primary unique browse-type browse-number
     1743     index xie browse-type browse-handle
     1744   .
     1745   procedure diasize_change-height :
     1746     define input  parameter p-change-value  as decimal   no-undo .
     1747     define input  parameter p-move-resize   as logical   no-undo .
     1748     define variable v-field-group-handle    as handle    no-undo .
     1749     define variable v-object-handle         as handle    no-undo .
     1750     define variable v-frame-height          as decimal   no-undo .
     1751     define variable v-frame-virtual-height  as decimal   no-undo .
     1752     define variable v-browse-height         as decimal   no-undo .
     1753     define variable v-window-height         as decimal   no-undo .
     1754     define variable v-window-virtual-height as decimal   no-undo .
     1755     define variable v-change-sign           as integer   no-undo .
     1756     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1757     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1758     if p-change-value > 0
     1759     then do:
     1760       if frame Dialog-Frame :height + p-change-value
     1761           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1762       then do:
     1763         assign
     1764           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1765                           - (frame Dialog-Frame :height-chars)
     1766         .
     1767         if p-change-value <= 0
     1768         then do:
     1769           run diasize_position-resize-button in this-procedure .
     1770           return .
     1771         end.
     1772       end.
     1773     end.
     1774     if p-change-value < 0
     1775     then do:
     1776       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1777       then do:
     1778         assign
     1779           p-change-value = v-diasize-orig-frame-height
     1780                          - (frame Dialog-Frame :height-chars)
     1781         .
     1782         if p-change-value >= 0
     1783         then do:
     1784           run diasize_position-resize-button in this-procedure .
     1785           return .
     1786         end.
     1787       end.
     1788     end.
     1789     if p-change-value >= 0
     1790     then do:
     1791       assign
     1792         v-change-sign = 1
     1793       .
     1794     end.
     1795     else do:
     1796       assign
     1797         v-change-sign = -1
     1798       .
     1799     end.
     1800     assign
     1801       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1802     .
     1803     if p-change-value = 0
     1804     then do:
     1805       run diasize_position-resize-button in this-procedure .
     1806       return .
     1807     end.
     1808     move_block:
     1809     do
     1810     on error undo move_block, retry move_block
     1811     :
     1812       if retry
     1813       then do:
     1814         do
     1815         on error undo move_block, leave move_block
     1816         :
     1817           if p-change-value > 0
     1818           then do:
     1819             for each buf_temp-diasize-handle
     1820             on error undo, next
     1821             :
     1822               assign
     1823                 v-object-handle = buf_temp-diasize-handle.handle-value
     1824               .
     1825               if v-object-handle <> v-diasize-resize-button
     1826               then do:
     1827                 assign
     1828                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1829                 .
     1830               end.
     1831             end.
     1832             assign
     1833               v-diasize-browse-handle :height = v-browse-height
     1834             .
     1835             for each buf_temp-browse-handle
     1836               where buf_temp-browse-handle.browse-type = 'height':u
     1837             on error undo, next
     1838             :
     1839               assign
     1840                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1841               .
     1842             end.
     1843             assign
     1844               frame Dialog-Frame :height = v-frame-height
     1845             .
     1846             if frame Dialog-Frame :scrollable = true
     1847             then do:
     1848               assign
     1849                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1850               .
     1851             end.
     1852             run diasize_position-resize-button in this-procedure .
     1853           end.
     1854           else do:
     1855             if frame Dialog-Frame :scrollable = true
     1856             then do:
     1857               assign
     1858                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1859               .
     1860             end.
     1861             assign
     1862               frame Dialog-Frame :height = v-frame-height
     1863             .
     1864             assign
     1865               v-diasize-browse-handle :height = v-browse-height
     1866             .
     1867             for each buf_temp-browse-handle
     1868               where buf_temp-browse-handle.browse-type = 'height':u
     1869             on error undo, next
     1870             :
     1871               assign
     1872                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1873               .
     1874             end.
     1875             for each buf_temp-diasize-handle
     1876             on error undo, next
     1877             :
     1878               assign
     1879                 v-object-handle = buf_temp-diasize-handle.handle-value
     1880               .
     1881               if v-object-handle <> v-diasize-resize-button
     1882               then do:
     1883                 assign
     1884                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1885                 .
     1886               end.
     1887             end.
     1888             run diasize_position-resize-button in this-procedure .
     1889           end.
     1890           assign
     1891             v-diasize-change-size = false
     1892           .
     1893           leave move_block .
     1894         end.
     1895       end.
     1896       assign
     1897         v-diasize-need-full-display = true
     1898       .
     1899       if v-diasize-change-size = false
     1900       then do:
     1901         assign
     1902           v-diasize-change-size = true
     1903         .
     1904       end.
     1905       else do:
     1906         return .
     1907       end.
     1908       assign
     1909         v-frame-height = frame Dialog-Frame :height
     1910         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1911         v-browse-height = v-diasize-browse-handle :height
     1912       .
     1913       for each buf_temp-browse-handle
     1914         where buf_temp-browse-handle.browse-type = 'height':u
     1915       :
     1916         assign
     1917           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1918         .
     1919       end.
     1920       for each buf_temp-diasize-handle
     1921       :
     1922         delete buf_temp-diasize-handle .
     1923       end.
     1924       assign
     1925         v-field-group-handle = frame Dialog-Frame :first-child
     1926       .
     1927       do while valid-handle(v-field-group-handle)
     1928       :
     1929         assign
     1930           v-object-handle = v-field-group-handle :first-child
     1931         .
     1932         do while valid-handle(v-object-handle)
     1933         :
     1934           if  v-object-handle <> v-diasize-browse-handle :handle
     1935           and can-query(v-object-handle, "row")
     1936           and can-query(v-object-handle, "height")
     1937           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1938           then do:
     1939             find first buf_temp-browse-handle
     1940               where buf_temp-browse-handle.browse-type   = 'height':u
     1941                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1942               no-error .
     1943             if available buf_temp-browse-handle
     1944             then do:
     1945             end.
     1946             else do:
     1947               create buf_temp-diasize-handle .
     1948               assign
     1949                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1950                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1951               .
     1952             end.
     1953           end.
     1954           assign
     1955             v-object-handle = v-object-handle :next-sibling
     1956           .
     1957         end.
     1958         assign
     1959           v-field-group-handle = v-field-group-handle :next-sibling
     1960         .
     1961       end.
     1962       do with frame Dialog-Frame
     1963       :
     1964         hide v-diasize-resize-button .
     1965         assign
     1966           v-diasize-resize-button :row    = 1
     1967           v-diasize-resize-button :column = 1
     1968         .
     1969       end.
     1970       if p-change-value > 0
     1971       then do:
     1972         if frame Dialog-Frame :scrollable = true
     1973         then do:
     1974           assign
     1975             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1976             no-error .
     1977           if error-status :error
     1978           or error-status :get-message(1) <> ""
     1979           then do:
     1980             undo move_block, retry move_block .
     1981           end.
     1982         end.
     1983         assign
     1984           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1985           no-error .
     1986         if error-status :error
     1987         or error-status :get-message(1) <> ""
     1988         then do:
     1989           undo move_block, retry move_block .
     1990         end.
     1991         assign
     1992           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1993           no-error .
     1994         if error-status :error
     1995         or error-status :get-message(1) <> ""
     1996         then do:
     1997           undo move_block, retry move_block .
     1998         end.
     1999         for each buf_temp-browse-handle
     2000           where buf_temp-browse-handle.browse-type = 'height':u
     2001         on error undo move_block, retry move_block
     2002         :
     2003           assign
     2004             buf_temp-browse-handle.browse-handle :height
     2005               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2006             no-error .
     2007           if error-status :error
     2008           or error-status :get-message(1) <> ""
     2009           then do:
     2010             undo move_block, retry move_block .
     2011           end.
     2012         end.
     2013         for each buf_temp-diasize-handle
     2014         on error undo move_block, retry move_block
     2015         :
     2016           assign
     2017             v-object-handle = buf_temp-diasize-handle.handle-value
     2018           .
     2019           if v-object-handle <> v-diasize-resize-button
     2020           then do:
     2021             assign
     2022               v-object-handle :row = v-object-handle :row + p-change-value
     2023               no-error .
     2024             if error-status :error
     2025             or error-status :get-message(1) <> ""
     2026             then do:
     2027               undo move_block, retry move_block .
     2028             end.
     2029           end.
     2030         end.
     2031       end.
     2032       else do:
     2033         for each buf_temp-diasize-handle
     2034         on error undo move_block, retry move_block
     2035         :
     2036           assign
     2037             v-object-handle = buf_temp-diasize-handle.handle-value
     2038           .
     2039           if v-object-handle <> v-diasize-resize-button
     2040           then do:
     2041             assign
     2042               v-object-handle :row = v-object-handle :row + p-change-value
     2043               no-error .
     2044             if error-status :error
     2045             or error-status :get-message(1) <> ""
     2046             then do:
     2047               undo move_block, retry move_block .
     2048             end.
     2049           end.
     2050         end.
     2051         assign
     2052           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2053           no-error .
     2054         if error-status :error
     2055         or error-status :get-message(1) <> ""
     2056         then do:
     2057           undo move_block, retry move_block .
     2058         end.
     2059         for each buf_temp-browse-handle
     2060           where buf_temp-browse-handle.browse-type = 'height':u
     2061         on error undo move_block, retry move_block
     2062         :
     2063           assign
     2064             buf_temp-browse-handle.browse-handle :height
     2065               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2066             no-error .
     2067           if error-status :error
     2068           or error-status :get-message(1) <> ""
     2069           then do:
     2070             undo move_block, retry move_block .
     2071           end.
     2072         end.
     2073         assign
     2074           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2075           no-error .
     2076         if error-status :error
     2077         or error-status :get-message(1) <> ""
     2078         then do:
     2079           undo move_block, retry move_block .
     2080         end.
     2081         if frame Dialog-Frame :scrollable = true
     2082         then do:
     2083           assign
     2084             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2085             no-error .
     2086           if error-status :error
     2087           or error-status :get-message(1) <> ""
     2088           then do:
     2089             undo move_block, retry move_block .
     2090           end.
     2091         end.
     2092       end.
     2093       if p-move-resize = true
     2094       then do:
     2095         run diasize_position-resize-button in this-procedure .
     2096       end.
     2097       if v-diasize-wndstore = true
     2098       then do:
     2099         if connected("ub") = true
     2100         then do:
     2101           define variable v-cntxt-db-num        as integer   no-undo .
     2102           define variable v-cntxt-userid        as character no-undo .
     2103           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2104                                             , OUTPUT v-cntxt-userid
     2105                                             ) .
     2106           run gbl/wndsizew.p
     2107             (input  v-cntxt-db-num
     2108             ,input  v-cntxt-userid
     2109             ,input  v-diasize-proc-name
     2110             ,input  'height':u
     2111             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2112             ) .
     2113         end.
     2114       end.
     2115     end.
     2116     assign
     2117       v-diasize-change-size = false
     2118     .
     2119   end procedure.
     2120   procedure diasize_set-height :
     2121     define input  parameter p-new-height  as decimal   no-undo .
     2122     define input  parameter p-move-resize as logical   no-undo .
     2123     do
     2124     on error undo, return error return-value
     2125     :
     2126       run diasize_change-height in this-procedure
     2127         (input  (p-new-height - frame Dialog-Frame :height)
     2128         ,input  p-move-resize
     2129         ) .
     2130     end.
     2131   end procedure.
     2132   procedure diasize_change-width :
     2133     define input  parameter p-change-value as decimal   no-undo .
     2134     define input  parameter p-move-resize  as logical   no-undo .
     2135     define variable v-field-group-handle   as handle    no-undo .
     2136     define variable v-object-handle        as handle    no-undo .
     2137     define variable v-frame-width          as decimal   no-undo .
     2138     define variable v-frame-virtual-width  as decimal   no-undo .
     2139     define variable v-browse-width         as decimal   no-undo .
     2140     define variable v-window-width         as decimal   no-undo .
     2141     define variable v-window-virtual-width as decimal   no-undo .
     2142     define variable v-change-sign          as integer   no-undo .
     2143     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2144     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2145     if p-change-value > 0
     2146     then do:
     2147       if frame Dialog-Frame :width + p-change-value >
     2148           session :width-chars
     2149       then do:
     2150         assign
     2151           p-change-value = session :width-chars - frame Dialog-Frame :width
     2152         .
     2153         if p-change-value <= 0
     2154         then do:
     2155           run diasize_position-resize-button in this-procedure .
     2156           return .
     2157         end.
     2158       end.
     2159     end.
     2160     if p-change-value < 0
     2161     then do:
     2162       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2163       then do:
     2164         assign
     2165           p-change-value = v-diasize-orig-frame-width
     2166                          - frame Dialog-Frame :width
     2167         .
     2168         if p-change-value >= 0
     2169         then do:
     2170           run diasize_position-resize-button in this-procedure .
     2171           return .
     2172         end.
     2173       end.
     2174     end.
     2175     if p-change-value >= 0
     2176     then do:
     2177       assign
     2178         v-change-sign = 1
     2179       .
     2180     end.
     2181     else do:
     2182       assign
     2183         v-change-sign = -1
     2184       .
     2185     end.
     2186     assign
     2187       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2188     .
     2189     if p-change-value = 0
     2190     then do:
     2191       run diasize_position-resize-button in this-procedure .
     2192       return .
     2193     end.
     2194     move_block:
     2195     do
     2196     on error undo move_block, leave move_block
     2197     :
     2198       if retry
     2199       then do:
     2200         do
     2201         on error undo move_block, leave move_block
     2202         :
     2203           if p-change-value > 0
     2204           then do:
     2205             for each buf_temp-diasize-handle
     2206             on error undo, next
     2207             :
     2208               assign
     2209                 v-object-handle = buf_temp-diasize-handle.handle-value
     2210               .
     2211               if v-object-handle <> v-diasize-resize-button
     2212               then do:
     2213                 assign
     2214                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2215                 .
     2216               end.
     2217             end.
     2218             assign
     2219               v-diasize-browse-handle :width = v-browse-width
     2220             .
     2221             for each buf_temp-browse-handle
     2222               where buf_temp-browse-handle.browse-type = 'width':u
     2223             on error undo, next
     2224             :
     2225               assign
     2226                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2227               .
     2228             end.
     2229             assign
     2230               frame Dialog-Frame :width = v-frame-width
     2231             .
     2232             if frame Dialog-Frame :scrollable = true
     2233             then do:
     2234               assign
     2235                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2236               .
     2237             end.
     2238             run diasize_position-resize-button in this-procedure .
     2239           end.
     2240           else do:
     2241             if frame Dialog-Frame :scrollable = true
     2242             then do:
     2243               assign
     2244                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2245               .
     2246             end.
     2247             assign
     2248               frame Dialog-Frame :width = v-frame-width
     2249             .
     2250             for each buf_temp-browse-handle
     2251               where buf_temp-browse-handle.browse-type = 'width':u
     2252             on error undo, next
     2253             :
     2254               assign
     2255                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2256               .
     2257             end.
     2258             assign
     2259               v-diasize-browse-handle :width = v-browse-width
     2260             .
     2261             for each buf_temp-diasize-handle
     2262             on error undo, next
     2263             :
     2264               assign
     2265                 v-object-handle = buf_temp-diasize-handle.handle-value
     2266               .
     2267               if v-object-handle <> v-diasize-resize-button
     2268               then do:
     2269                 assign
     2270                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2271                 .
     2272               end.
     2273             end.
     2274             run diasize_position-resize-button in this-procedure .
     2275           end.
     2276           assign
     2277             v-diasize-change-size = false
     2278           .
     2279           leave move_block .
     2280         end.
     2281       end.
     2282       assign
     2283         v-diasize-need-full-display = true
     2284       .
     2285       if v-diasize-change-size = false
     2286       then do:
     2287         assign
     2288           v-diasize-change-size = true
     2289         .
     2290       end.
     2291       else do:
     2292         return .
     2293       end.
     2294       assign
     2295         v-frame-width = frame Dialog-Frame :width
     2296         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2297         v-browse-width = v-diasize-browse-handle :width
     2298       .
     2299       for each buf_temp-browse-handle
     2300         where buf_temp-browse-handle.browse-type = 'width':u
     2301       :
     2302         assign
     2303           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2304         .
     2305       end.
     2306       for each buf_temp-diasize-handle
     2307       :
     2308         delete buf_temp-diasize-handle .
     2309       end.
     2310       assign
     2311         v-field-group-handle = frame Dialog-Frame :first-child
     2312       .
     2313       do while valid-handle(v-field-group-handle)
     2314       :
     2315         assign
     2316           v-object-handle = v-field-group-handle :first-child
     2317         .
     2318         do while valid-handle(v-object-handle)
     2319         :
     2320           if  v-object-handle <> v-diasize-browse-handle :handle
     2321           and v-object-handle <> v-diasize-resize-button
     2322           and can-query(v-object-handle, "row")
     2323           and can-query(v-object-handle, "height")
     2324           and ( v-object-handle :col + v-object-handle :width
     2325                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2326               )
     2327           then do:
     2328             find first buf_temp-browse-handle
     2329               where buf_temp-browse-handle.browse-type   = 'width':u
     2330                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2331               no-error .
     2332             if available buf_temp-browse-handle
     2333             then do:
     2334             end.
     2335             else do:
     2336               create buf_temp-diasize-handle .
     2337               assign
     2338                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2339                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2340               .
     2341             end.
     2342           end.
     2343           assign
     2344             v-object-handle = v-object-handle :next-sibling
     2345           .
     2346         end.
     2347         assign
     2348           v-field-group-handle = v-field-group-handle :next-sibling
     2349         .
     2350       end.
     2351       do with frame Dialog-Frame
     2352       :
     2353         hide v-diasize-resize-button .
     2354         v-diasize-resize-button :row = 1.
     2355         v-diasize-resize-button :column = 1.
     2356       end.
     2357       if p-change-value > 0
     2358       then do:
     2359         if frame Dialog-Frame :scrollable = true
     2360         then do:
     2361           assign
     2362             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2363             no-error .
     2364           if error-status :error
     2365           or error-status :get-message(1) <> ""
     2366           then do:
     2367             undo move_block, retry move_block.
     2368           end.
     2369         end.
     2370         assign
     2371           frame Dialog-Frame :width = v-frame-width + p-change-value
     2372           no-error .
     2373         if error-status :error
     2374         or error-status :get-message(1) <> ""
     2375         then do:
     2376           undo move_block, retry move_block.
     2377         end.
     2378         assign
     2379           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2380         no-error .
     2381         if error-status :error
     2382         or error-status :get-message(1) <> ""
     2383         then do:
     2384           undo move_block, retry move_block.
     2385         end.
     2386         for each buf_temp-browse-handle
     2387           where buf_temp-browse-handle.browse-type = 'width':u
     2388         on error undo move_block, retry move_block
     2389         :
     2390           assign
     2391             buf_temp-browse-handle.browse-handle :width
     2392               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2393             no-error .
     2394           if error-status :error
     2395           or error-status :get-message(1) <> ""
     2396           then do:
     2397             undo move_block, retry move_block .
     2398           end.
     2399         end.
     2400         for each buf_temp-diasize-handle
     2401         on error undo move_block, retry move_block
     2402         :
     2403           assign
     2404             v-object-handle = buf_temp-diasize-handle.handle-value
     2405           .
     2406           if v-object-handle <> v-diasize-resize-button
     2407           then do:
     2408             assign
     2409               v-object-handle :col = v-object-handle :col + p-change-value
     2410               no-error .
     2411             if error-status :error
     2412             or error-status :get-message(1) <> ""
     2413             then do:
     2414               undo move_block, retry move_block .
     2415             end.
     2416           end.
     2417         end.
     2418       end.
     2419       else do:
     2420         for each buf_temp-diasize-handle
     2421         on error undo move_block, retry move_block
     2422         :
     2423           assign
     2424             v-object-handle = buf_temp-diasize-handle.handle-value
     2425           .
     2426           if v-object-handle <> v-diasize-resize-button
     2427           then do:
     2428             assign
     2429               v-object-handle :col = v-object-handle :col + p-change-value
     2430               no-error .
     2431             if error-status :error
     2432             or error-status :get-message(1) <> ""
     2433             then do:
     2434               undo move_block, retry move_block .
     2435             end.
     2436           end.
     2437         end.
     2438         for each buf_temp-browse-handle
     2439           where buf_temp-browse-handle.browse-type = 'width':u
     2440         on error undo move_block, retry move_block
     2441         :
     2442           assign
     2443             buf_temp-browse-handle.browse-handle :width
     2444               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2445             no-error .
     2446           if error-status :error
     2447           or error-status :get-message(1) <> ""
     2448           then do:
     2449             undo move_block, retry move_block .
     2450           end.
     2451         end.
     2452         assign
     2453           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2454           no-error .
     2455         if error-status :error
     2456         or error-status :get-message(1) <> ""
     2457         then do:
     2458           undo move_block, retry move_block.
     2459         end.
     2460         assign
     2461           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2462         no-error .
     2463         if error-status :error
     2464         or error-status :get-message(1) <> ""
     2465         then do:
     2466           undo move_block, retry move_block.
     2467         end.
     2468         if frame Dialog-Frame :scrollable = true
     2469         then do:
     2470           assign
     2471             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2472           no-error .
     2473           if error-status :error
     2474           or error-status :get-message(1) <> ""
     2475           then do:
     2476             undo move_block, retry move_block.
     2477           end.
     2478         end.
     2479       end.
     2480       if p-move-resize
     2481       then do:
     2482         run diasize_position-resize-button in this-procedure .
     2483       end.
     2484       if v-diasize-wndstore = true
     2485       then do:
     2486         if connected("ub") = true
     2487         then do:
     2488           define variable v-cntxt-db-num        as integer   no-undo .
     2489           define variable v-cntxt-userid        as character no-undo .
     2490           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2491                                             , OUTPUT v-cntxt-userid
     2492                                             ) .
     2493           run gbl/wndsizew.p
     2494             (input  v-cntxt-db-num
     2495             ,input  v-cntxt-userid
     2496             ,input  v-diasize-proc-name
     2497             ,input  'width':u
     2498             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2499             ) .
     2500         end.
     2501       end.
     2502     end.
     2503     assign
     2504       v-diasize-change-size = false
     2505     .
     2506   end procedure.
     2507   procedure diasize_set-width :
     2508     define input  parameter p-new-width  as decimal   no-undo .
     2509     define input  parameter p-move-resize as logical   no-undo .
     2510     do
     2511     on error undo, return error return-value
     2512     :
     2513       run diasize_change-width in this-procedure
     2514         (input  (p-new-width - frame Dialog-Frame :width)
     2515         ,input  p-move-resize
     2516         ) .
     2517     end.
     2518   end procedure.
     2519   procedure diasize_position-resize-button :
     2520     do with frame Dialog-Frame
     2521     :
     2522       hide v-diasize-resize-button .
     2523       assign
     2524         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2525                     - 1
     2526                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2527         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2528                     - 1
     2529                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2530       .
     2531       view v-diasize-resize-button .
     2532     end.
     2533   end procedure.
     2534   on alt-right anywhere
     2535   do:
     2536     run diasize_change-width in this-procedure
     2537       (input 1
     2538       ,input true
     2539       ) .
     2540     return no-apply .
     2541   end.
     2542   on alt-left anywhere
     2543   do:
     2544     run diasize_change-width in this-procedure
     2545       (input -1
     2546       ,input true
     2547       ) .
     2548     return no-apply .
     2549   end.
     2550   on alt-down anywhere
     2551   do:
     2552     run diasize_change-height in this-procedure
     2553       (input 1
     2554       ,input true
     2555       ) .
     2556     return no-apply .
     2557   end.
     2558   on alt-up anywhere
     2559   do:
     2560     run diasize_change-height in this-procedure
     2561       (input -1
     2562       ,input true
     2563       ) .
     2564     return no-apply .
     2565   end.
     2566   on alt-enter of frame Dialog-Frame
     2567   do:
     2568     run diasize_maximize in this-procedure
     2569       (input  ?
     2570       ).
     2571     return no-apply .
     2572   end.
     2573   procedure diasize_end-move :
     2574     do
     2575     on error undo, return error return-value
     2576     :
     2577       define variable v-row-delta as decimal   no-undo .
     2578       define variable v-col-delta as decimal   no-undo .
     2579       define variable v-new-row as decimal   no-undo .
     2580       define variable v-new-col as decimal   no-undo .
     2581       assign
     2582         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2583         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2584       .
     2585       assign
     2586         v-row-delta = v-new-row - frame Dialog-Frame :height
     2587         v-col-delta = v-new-col - frame Dialog-Frame :width
     2588       .
     2589       run diasize_change-height in this-procedure
     2590         (input v-row-delta
     2591         ,input true
     2592         ) .
     2593       run diasize_change-width in this-procedure
     2594         (input v-col-delta
     2595         ,input true
     2596         ) .
     2597     end.
     2598   end procedure.
     2599   procedure diasize_maximize :
     2600     define input  parameter p-action as logical   no-undo .
     2601     do
     2602     on error undo, return error return-value
     2603     :
     2604       if p-action = ?
     2605       then do:
     2606         if v-diasize-need-maximize = true
     2607         then do:
     2608           assign
     2609             p-action = true
     2610           .
     2611         end.
     2612         else do:
     2613           assign
     2614             p-action = false
     2615           .
     2616         end.
     2617       end.
     2618       if p-action = true
     2619       then do:
     2620         run diasize_change-height in this-procedure
     2621           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2622               - frame Dialog-Frame :height-chars
     2623           ,input true
     2624           ) .
     2625         run diasize_change-width in this-procedure
     2626           (input session :width-chars
     2627               - frame Dialog-Frame :width-chars
     2628           ,input true
     2629           ) .
     2630         assign
     2631           v-diasize-need-maximize = false
     2632         .
     2633       end.
     2634       else do:
     2635         run diasize_change-width in this-procedure
     2636           (input v-diasize-orig-frame-width
     2637               - frame Dialog-Frame :width-chars
     2638           ,input true
     2639           ) .
     2640         run diasize_change-height in this-procedure
     2641           (input v-diasize-orig-frame-height
     2642               - frame Dialog-Frame :height-chars
     2643           ,input true
     2644           ) .
     2645         assign
     2646           v-diasize-need-maximize = true
     2647         .
     2648       end.
     2649     end.
     2650   end procedure.
     2651   procedure diasize_restore-orig-size :
     2652     do
     2653     on error undo, return error return-value
     2654     :
     2655       assign
     2656         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2657         v-diasize-current-frame-height = frame Dialog-Frame :height
     2658       .
     2659       run diasize_set-height in this-procedure
     2660         (input  v-diasize-orig-frame-height
     2661         ,input  true
     2662         ) .
     2663       run diasize_set-width in this-procedure
     2664         (input  v-diasize-orig-frame-width
     2665         ,input  true
     2666         ) .
     2667     end.
     2668   end procedure.
     2669   procedure diasize_restore-current-size :
     2670     do
     2671     on error undo, return error return-value
     2672     :
     2673       run diasize_set-height in this-procedure
     2674         (input  v-diasize-current-frame-height
     2675         ,input  true
     2676         ) .
     2677       run diasize_set-width in this-procedure
     2678         (input  v-diasize-current-frame-width
     2679         ,input  true
     2680         ) .
     2681     end.
     2682   end procedure.
     2683   procedure diasize_set-browse-handle :
     2684     define input  parameter p-browse-handle as handle   no-undo .
     2685     define buffer buf_temp-browse-handle for temp-browse-handle .
     2686     do
     2687     on error undo, return error return-value
     2688     :
     2689       assign
     2690         v-diasize-browse-handle = p-browse-handle
     2691       .
     2692       for each buf_temp-browse-handle
     2693       on error undo, return error return-value
     2694       :
     2695         delete buf_temp-browse-handle .
     2696       end.
     2697     end.
     2698   end procedure.
     2699   procedure diasize_add_browse :
     2700     define input  parameter p-browse-type   as character no-undo .
     2701     define input  parameter p-browse-handle as handle    no-undo .
     2702     define buffer buf_temp-browse-handle for temp-browse-handle .
     2703     do
     2704     on error undo, return error return-value
     2705     :
     2706       assign
     2707         v-diasize-browse-number = v-diasize-browse-number + 1
     2708       .
     2709       create buf_temp-browse-handle .
     2710       assign
     2711         buf_temp-browse-handle.browse-type   = p-browse-type
     2712         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2713         buf_temp-browse-handle.browse-handle = p-browse-handle
     2714       .
     2715     end.
     2716   end procedure.
     2717   procedure diasize_init :
     2718     define variable v-default-value    as logical   no-undo .
     2719     define variable v-restore-saved    as logical   no-undo .
     2720     define variable v-resize-value-str as character no-undo .
     2721     do
     2722     on error undo, return error return-value
     2723     :
     2724       do with frame Dialog-Frame
     2725       :
     2726         assign
     2727           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2728           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2729           v-diasize-browse-handle     = browse BR-docs :handle
     2730         .
     2731         create button v-diasize-resize-button
     2732         assign
     2733           parent        = frame Dialog-Frame :first-child
     2734           label         = "s"
     2735           height-pixels = 16
     2736           width-pixels  = 16
     2737           visible       = true
     2738           sensitive     = true
     2739           movable       = true
     2740           triggers:
     2741             on end-move persistent run diasize_end-move in this-procedure .
     2742           end triggers.
     2743         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2744         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2745         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2746         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2747         assign
     2748           v-diasize-wndmax = false
     2749         .
     2750         if connected("ub") = true
     2751         then do:
     2752           define variable v-cntxt-db-num        as integer   no-undo .
     2753           define variable v-cntxt-userid        as character no-undo .
     2754           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2755                                             , OUTPUT v-cntxt-userid
     2756                                             ) .
     2757           run gbl/wndpar_r.p
     2758             (input  v-cntxt-db-num
     2759             ,input  v-cntxt-userid
     2760             ,input  'wndmax':U
     2761             ,output v-diasize-wndmax
     2762             ,output v-default-value
     2763             ) .
     2764         end.
     2765         assign
     2766           v-diasize-wndstore = false
     2767         .
     2768         if connected("ub") = true
     2769         then do:
     2770           run gbl/wndpar_r.p
     2771             (input  v-cntxt-db-num
     2772             ,input  v-cntxt-userid
     2773             ,input  'wndstore':U
     2774             ,output v-diasize-wndstore
     2775             ,output v-default-value
     2776             ) .
     2777         end.
     2778         assign
     2779           v-diasize-proc-name = entry(1, program-name(2), '.')
     2780         .
     2781         if v-diasize-wndstore = true
     2782         then do:
     2783           assign
     2784             v-restore-saved = false
     2785           .
     2786           if connected("ub") = true
     2787           then do:
     2788             run gbl/wndsizer.p
     2789               (input  v-cntxt-db-num
     2790               ,input  v-cntxt-userid
     2791               ,input  v-diasize-proc-name
     2792               ,input  'height':u
     2793               ,output v-resize-value-str
     2794               ) .
     2795             if v-resize-value-str <> '':U
     2796             then do:
     2797               run diasize_change-height in this-procedure
     2798                 (input  integer(v-resize-value-str)
     2799                 ,input  true
     2800                 ) .
     2801               assign
     2802                 v-restore-saved = true
     2803               .
     2804             end.
     2805           end.
     2806           if connected("ub") = true
     2807           then do:
     2808             run gbl/wndsizer.p
     2809               (input  v-cntxt-db-num
     2810               ,input  v-cntxt-userid
     2811               ,input  v-diasize-proc-name
     2812               ,input  'width':u
     2813               ,output v-resize-value-str
     2814               ) .
     2815             if v-resize-value-str <> '':U
     2816             then do:
     2817               run diasize_change-width in this-procedure
     2818                 (input  integer(v-resize-value-str)
     2819                 ,input  true
     2820                 ) .
     2821               assign
     2822                 v-restore-saved = true
     2823               .
     2824             end.
     2825           end.
     2826           if v-restore-saved <> true
     2827           then do:
     2828             if v-diasize-wndmax = true
     2829             then do:
     2830               run diasize_maximize in this-procedure
     2831                 (input  true
     2832                 ) .
     2833             end.
     2834           end.
     2835         end.
     2836         else do:
     2837           if v-diasize-wndmax = true
     2838           then do:
     2839             run diasize_maximize in this-procedure
     2840               (input  true
     2841               ) .
     2842           end.
     2843         end.
     2844       end.
     2845     end.
     2846   end procedure.
     2847   procedure diasize_need-full-display :
     2848     define output parameter p-need-full-display as logical   no-undo .
     2849     do
     2850     on error undo, return error return-value
     2851     :
     2852       assign
     2853         p-need-full-display = v-diasize-need-full-display
     2854       .
     2855       assign
     2856         v-diasize-need-full-display = false
     2857       .
     2858     end.
     2859   end procedure.
     2860   procedure get-context :
     2861      define output parameter p-db-num as integer          no-undo.
     2862      define output parameter p-user-id as character        no-undo.
     2863      define variable v-login               as character    no-undo.
     2864      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2865      define buffer buf_user-login  for ub.user-login .
     2866      do
     2867      on error undo, return error
     2868      :
     2869            FIND FIRST buf_sys-ctrl no-lock.
     2870            ASSIGN
     2871               v-login = USERID("ub")
     2872               p-db-num = buf_sys-ctrl.db-num
     2873            .
     2874            FIND FIRST buf_user-login
     2875                 WHERE buf_user-login.db-num = p-db-num
     2876                   AND buf_user-login.user-login = v-login
     2877                 no-lock
     2878                 no-error
     2879                 .
     2880            IF AVAILABLE buf_user-login
     2881            THEN DO:
     2882               assign
     2883                  p-user-id = buf_user-login.user-id
     2884               .
     2885            END.
     2886      end.
     2887   end procedure.
     2888       run diasize_init in this-procedure .
     2889   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2890   DEF VAR cur-clmn-numBR-docs as INT EXTENT 9 no-undo.
     2891   DEF VAR varmviBR-docs       as INT no-undo.
     2892   DEF VAR varmvjBR-docs       as INT no-undo.
     2893   DEF VAR varmvkBR-docs       as INT no-undo.
     2894   DEF VAR varmvlBR-docs       as INT no-undo.
     2895   DEF VAR move-elementBR-docs as INT no-undo.
     2896   def var jjBR-docs           as int no-undo.
     2897   do varmviBR-docs = 1 to EXTENT(cur-clmn-numBR-docs):
     2898     ASSIGN cur-clmn-numBR-docs[varmviBR-docs] = varmviBR-docs.
     2899   END.
     2900   RUN start-mv-clmnBR-docs.
     2901   PROCEDURE start-mv-clmnBR-docs:
     2902   def var old-session as logical no-undo.
     2903      old-session = SESSION:IMMEDIATE-DISPLAY.
     2904      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2905      SESSION:IMMEDIATE-DISPLAY = old-session.
     2906   END.
     2907   ON ctrl-cursor-right OF BROWSE BR-docs do:
     2908     RUN re-move-clmnBR-docs ( 2, 9).
     2909   END.
     2910   ON ctrl-cursor-left OF BROWSE BR-docs do:
     2911     RUN re-move-clmnBR-docs (9, 2).
     2912   END.
     2913   PROCEDURE re-move-clmnBR-docs:
     2914     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2915     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2916     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     2917       if cur-clmn-numBR-docs[varmviBR-docs] = source-column THEN cur-clmn-numBR-docs[varmviBR-docs] = -1.
     2918     END.
     2919     if BR-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2920     if source-column > target-column THEN
     2921     DO varmvjBR-docs = source-column - 1 to target-column BY -1:
     2922       DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     2923           if cur-clmn-numBR-docs[varmviBR-docs] = varmvjBR-docs THEN DO:
     2924             cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-numBR-docs[varmviBR-docs] + 1.
     2925           END.
     2926       END.
     2927     END.
     2928     ELSE
     2929     DO varmvjBR-docs = source-column + 1 to target-column:
     2930       DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     2931         if cur-clmn-numBR-docs[varmviBR-docs] = varmvjBR-docs THEN DO:
     2932           cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-numBR-docs[varmviBR-docs] - 1.
     2933         END.
     2934       END.
     2935     END.
     2936     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     2937       if cur-clmn-numBR-docs[varmviBR-docs] = -1 THEN cur-clmn-numBR-docs[varmviBR-docs] = target-column.
     2938     END.
     2939   END PROCEDURE.
     2940   PROCEDURE ch-clmnBR-docs:
     2941     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2942     if cur-clmn-loc <= 2 then do:
     2943       return .
     2944     end.
     2945     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     2946       if cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-loc THEN move-elementBR-docs = varmviBR-docs.
     2947     END.
     2948     RUN re-move-clmnBR-docs (cur-clmn-loc, 2).
     2949   END PROCEDURE.
     2950   PROCEDURE mv-brw-defaultBR-docs:
     2951   def var old-session as logical no-undo.
     2952     old-session = SESSION:IMMEDIATE-DISPLAY.
     2953     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2954     do varmvlBR-docs = 2 to EXTENT(cur-clmn-numBR-docs):
     2955       RUN re-move-clmnBR-docs (cur-clmn-numBR-docs[varmvlBR-docs], varmvlBR-docs).
     2956     END.
     2957     RUN start-mv-clmnBR-docs.
     2958     SESSION:IMMEDIATE-DISPLAY = old-session.
     2959   END PROCEDURE.
     2960   .
     2961   def var sort-labelBR-docs   as character no-undo .
     2962   def var sort-clmnBR-docs    as handle    no-undo .
     2963   def var cur-clmnBR-docs     as handle    no-undo .
     2964   def var cur-clmn-locBR-docs as integer   no-undo .
     2965   def var re-queryBR-docs     as logical   initial no no-undo .
     2966   on start-search, ctrl-o of BR-docs in frame Dialog-Frame do:
     2967      run sort-brBR-docs
     2968        (input (if available ub.fin-code-cor-acc
     2969                then recid(ub.fin-code-cor-acc)
     2970                else ?
     2971               )
     2972        ).
     2973   end.
     2974   PROCEDURE sort-brBR-docs :
     2975     define input parameter p-recid as recid no-undo .
     2976     if re-queryBR-docs = no then do:
     2977       assign
     2978          cur-clmnBR-docs = BR-docs:current-column in frame Dialog-Frame
     2979       .
     2980       if sort-clmnBR-docs <> ? then sort-clmnBR-docs:column-fgcolor = 0.
     2981       if cur-clmnBR-docs = sort-clmnBR-docs then do:
     2982         assign
     2983            sort-labelBR-docs = ""
     2984            sort-clmnBR-docs = ?
     2985         .
     2986        end.
     2987        else do:
     2988          assign
     2989            sort-labelBR-docs = cur-clmnBR-docs:label
     2990            sort-clmnBR-docs  = cur-clmnBR-docs
     2991            sort-clmnBR-docs:column-fgcolor = 4
     2992          .
     2993        end.
     2994      end.
     2995     assign
     2996       cur-clmn-locBR-docs = 1
     2997     .
     2998     def var column-handle as handle no-undo .
     2999     column-handle = BR-docs:first-column.
     3000     do while valid-handle(column-handle) :
     3001       if column-handle = cur-clmnBR-docs then do:
     3002         leave .
     3003       end.
     3004       column-handle = column-handle:NEXT-COLUMN.
     3005       assign
     3006         cur-clmn-locBR-docs = cur-clmn-locBR-docs + 1
     3007       .
     3008     end.
     3009     case sort-labelBR-docs:
     3010           when buf_fin-code.code-value:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.code-value"     .     run OpenBr(yes, no, '':U).   . END.
     3011           when 'Тип'  then DO:    assign       sort-column-name = "buf_fin-code.acc-type"     .     run OpenBr(yes, no, '':U).   . END.
     3012           when buf_fin-code.descr:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.descr"     .     run OpenBr(yes, no, '':U).   . END.
     3013           when buf_fin-code.fin-code:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.fin-code"     .     run OpenBr(yes, no, '':U).   . END.
     3014           when buf_fin-code.host-code:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.host-code"     .     run OpenBr(yes, no, '':U).   . END.
     3015           when buf_fin-code.level-1:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.level-1"     .     run OpenBr(yes, no, '':U).   . END.
     3016           when buf_fin-code.level-2:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.level-2"     .     run OpenBr(yes, no, '':U).   . END.
     3017           when buf_fin-code.level-3:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.level-3"     .     run OpenBr(yes, no, '':U).   . END.
     3018       otherwise do:
     3019         assign
     3020           sort-column-name = ""
     3021         .
     3022         run OpenBr(yes, no, '':U).
     3023           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-docs') then do:
     3024             run mv-brw-defaultBR-docs.
     3025           end.
     3026         if sort-labelBR-docs <> "" then do:
     3027           assign
     3028             cur-clmnBR-docs:column-fgcolor = 0
     3029           .
     3030         end.
     3031         assign
     3032           cur-clmn-locBR-docs = ?
     3033         .
     3034       end.
     3035     end case.
     3036       if cur-clmn-locBR-docs <> ? then do:
     3037         if can-do( this-procedure:internal-entries, 'ch-clmnBR-docs') then do:
     3038           run ch-clmnBR-docs in this-procedure (cur-clmn-locBR-docs).
     3039         end.
     3040       end.
     3041     if p-recid <> ? then do:
     3042       reposition BR-docs to recid p-recid no-error.
     3043       apply "value-changed" to BR-docs in frame Dialog-Frame.
     3044     end.
     3045     apply "entry" to BR-docs in frame Dialog-Frame.
     3046   END PROCEDURE.
     3047   procedure re-open-query-srt-clmnBR-docs:
     3048   if cur-clmnBR-docs = ? then do:
     3049      run OpenBr(yes, no, '':U).
     3050   end.
     3051   else do:
     3052      assign re-queryBR-docs = yes.
     3053      run sort-brBR-docs
     3054        (input (if available ub.fin-code-cor-acc
     3055                then recid(ub.fin-code-cor-acc)
     3056                else ?
     3057               )
     3058        ).
     3059      assign re-queryBR-docs = no.
     3060   end.
     3061   end.
     3062   MAIN-BLOCK:
     3063   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3064      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3065   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3066     run mainmenu_getcntxt in parparentproc
     3067       (output v-cntxt-db-num
     3068       ,output v-cntxt-userid
     3069       ,output v-cntxt-level
     3070       ,output v-cntxt-host-code-obj
     3071       ,output v-cntxt-obj-type
     3072       ,output v-cntxt-obj-code
     3073       ,output v-cntxt-db-num-obj
     3074       ,output v-cntxt-is-admin
     3075       ) .
     3076     assign
     3077       buf_fin-code.code-value:read-only in browse BR-docs = true
     3078     .
     3079     define variable p-file-label as character no-undo .
     3080     assign
     3081       p-file-label =  "Корреспондирующие счета"
     3082     .
     3083     define buffer buf_clients for  ub.clients .
     3084     case par-mode:
     3085       when 'все':U
     3086       then do:
     3087       end.
     3088       when 'фирма':U
     3089       then do:
     3090         find first buf_clients no-lock
     3091           where buf_clients.obj-code = par-host-code
     3092             and buf_clients.obj-type = 'орг':U
     3093           no-error .
     3094         if not available buf_clients then do:
     3095           message
     3096           substitute("Неверное значение параметра par-host-code=&1", par-host-code)
     3097           view-as alert-box error .
     3098           return error.
     3099         end.
     3100         find first X_sysconf where X_sysconf.host-code = par-host-code .
     3101         v-main-firm-db = X_sysconf.firm-db-num.
     3102       end.
     3103       otherwise do:
     3104         message vss-workfile vss-revision vss-description skip
     3105         "Неверный вызов - par-mode=" par-mode
     3106         view-as alert-box ERROR.
     3107         return.
     3108       end.
     3109     end CASE.
     3110       if pardoc-rec <> ? then do:
     3111         FIND FIRST find_code No-LOCK where
     3112                    recid(find_code) = pardoc-rec No-ERROR.
     3113         if not avail find_code then do:
     3114           message
     3115           vss-workfile vss-revision vss-description skip
     3116           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3117           view-as alert-box error .
     3118           return error.
     3119         end.
     3120         doc-rec = pardoc-rec.
     3121       end.
     3122     run my-enable_ui in this-procedure.
     3123     run openbr in this-procedure (yes, no, '':u).
     3124     hide mark-num  B-import in frame Dialog-Frame .
     3125     if pardoc-rec <> ? then
     3126     reposition br-docs to recid doc-rec no-error.
     3127     wait-for go of frame Dialog-Frame.
     3128   END.
     3129   run disable_ui in this-procedure.
     3130   PROCEDURE add-proc :
     3131   define variable v-doc-rec as recid no-undo .
     3132   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3133   do:
     3134     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3135       (input  v-cntxt-db-num
     3136       ,input  v-cntxt-userid
     3137       ,input  0
     3138       ,input  'actn_fin-reference_add-def':U
     3139       ,input  'firm':U
     3140       ,input  par-host-code
     3141       ,input  '':U
     3142       ,input  0
     3143       ,input  0
     3144       ,input  0
     3145       ,input  0
     3146       ,input  true
     3147       ,output g#log
     3148       )  .
     3149   end.
     3150   if not g#log then  return .
     3151   define variable rr as recid no-undo .
     3152     run ref/fci-1.w ( 'ДОБАВЛЕНИЕ':U , input-output rr , input par-host-code ).
     3153     v-doc-rec = rr .
     3154     run openbr in this-procedure (yes, no, '':u).
     3155     REPOSITION br-docs to recid v-doc-rec no-error .
     3156   END PROCEDURE.
     3157   PROCEDURE buh-import :
     3158   define variable v-doc-rec as recid no-undo .
     3159   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3160   do:
     3161     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3162       (input  v-cntxt-db-num
     3163       ,input  v-cntxt-userid
     3164       ,input  0
     3165       ,input  'actn_fin-reference_add-def':U
     3166       ,input  'firm':U
     3167       ,input  par-host-code
     3168       ,input  '':U
     3169       ,input  0
     3170       ,input  0
     3171       ,input  0
     3172       ,input  0
     3173       ,input  true
     3174       ,output g#log
     3175       )  .
     3176   end.
     3177   if not g#log then  return .
     3178   define variable rr as recid no-undo .
     3179     run ref/fi-buhac.p ( input-output rr , input par-host-code ).
     3180     v-doc-rec = rr .
     3181     run openbr in this-procedure (yes, no, '':u).
     3182     REPOSITION br-docs to recid v-doc-rec no-error .
     3183   END PROCEDURE.
     3184   PROCEDURE disable_UI :
     3185     HIDE FRAME Dialog-Frame.
     3186   END PROCEDURE.
     3187   PROCEDURE enable_UI :
     3188     DISPLAY rs-sts sch-code p-desc mark-num
     3189         WITH FRAME Dialog-Frame.
     3190     ENABLE B-exit B-mark B-sel B-add B-lkp B-chg B-del B-firm B-copy B-sch
     3191            B-print B-Help BR-docs rs-sts sch-code p-desc mark-num
     3192         WITH FRAME Dialog-Frame.
     3193     VIEW FRAME Dialog-Frame.
     3194     OPEN QUERY BR-docs FOR EACH buf_fin-code NO-LOCK.
     3195   END PROCEDURE.
     3196   PROCEDURE my-enable_UI :
     3197   ASSIGN
     3198   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     3199                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     3200                          "Все&!" + chr(44) + 'все':U + chr(44) +
     3201                           "Удаленные&-" + chr(44) + '1':U
     3202   rs-sts = (IF p-sts = ? THEN 'все':U ELSE string(p-sts))
     3203   .
     3204   DISPLAY sch-code p-desc mark-num
     3205         WITH FRAME Dialog-Frame.
     3206     ENABLE B-exit rs-sts
     3207            B-lkp
     3208            B-add       when LOOKUP("b-add":U,  bttns) > 0  and v-cntxt-db-num = v-main-firm-db  and not transaction
     3209            B-chg       when LOOKUP("b-chg":U,  bttns) > 0  and v-cntxt-db-num = v-main-firm-db  and not transaction
     3210            B-copy      when LOOKUP("b-add":U,  bttns) > 0  and v-cntxt-db-num = v-main-firm-db  and not transaction
     3211            B-import    when LOOKUP("b-add":U,  bttns) > 0  and v-cntxt-db-num = v-main-firm-db  and not transaction
     3212            B-firm
     3213            B-History
     3214            B-sch
     3215            B-print
     3216            B-Help
     3217            b-sel        when LOOKUP("b-sel":U,  bttns) > 0
     3218            b-mark       when LOOKUP("b-mark":U, bttns) > 0
     3219            b-del        when LOOKUP("b-del":U,  bttns) > 0 and v-cntxt-db-num = v-main-firm-db  and not transaction
     3220            BR-docs sch-code p-desc mark-num
     3221         WITH FRAME Dialog-Frame.
     3222     VIEW FRAME Dialog-Frame.
     3223   END PROCEDURE.
     3224   PROCEDURE OpenBr :
     3225   define input  parameter p-open-query     as logical   no-undo .
     3226   define input  parameter p-find-next      as logical   no-undo .
     3227   define input  parameter p-find-condition as character no-undo .
     3228   define variable l-query-was-opened as logical no-undo .
     3229   define variable title0 as character no-undo.
     3230   title0 = "Справочник фин.кодов " + caps(p-file-label) + chr(32).
     3231   IF p-sts <> ? THEN DO:
     3232       frame Dialog-Frame:TITLE = title0 + chr(32) + entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U).
     3233   END.
     3234   define variable sort-column-phrase as character no-undo .
     3235   case sort-column-name :
     3236     when "" then do:
     3237       assign
     3238         sort-column-phrase = ""
     3239       .
     3240     end.
     3241     otherwise do:
     3242       assign
     3243         sort-column-phrase = "by " + sort-column-name
     3244       .
     3245     end.
     3246   end case.
     3247   define variable l-open-query as logical   no-undo .
     3248    IF p-sts <> ? THEN DO:
     3249        CASE par-mode :
     3250            WHEN 'все':U        THEN DO:
     3251             filter-point = filter-point0 + par-mode.
     3252             ASSIGN frame Dialog-Frame:TITLE = title0 .
     3253   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3254   define variable  l-disable-where-25  as logical   no-undo .
     3255   define variable  l-filter-open-25    as logical   .
     3256   define variable  flt-rec-25       as recid     no-undo .
     3257   define variable  filter-name-25      as character no-undo .
     3258   define variable  where-phrase-25     as character no-undo .
     3259   define variable  sort-phrase-25      as character no-undo .
     3260   define variable  where-phrase-rus-25 as character no-undo .
     3261   define variable  sort-phrase-rus-25  as character no-undo .
     3262     run waitfram-show in this-procedure
     3263       (input "ЖДИТЕ ..."
     3264       ).
     3265   run gbl/flt-get.p
     3266     (input filter-point
     3267     ,output flt-rec-25
     3268     ,output filter-name-25
     3269     ,output where-phrase-25
     3270     ,output sort-phrase-25
     3271     ,output where-phrase-rus-25
     3272     ,output sort-phrase-rus-25
     3273     ).
     3274   if p-open-query then do:
     3275       run set-filter-name in this-procedure
     3276         (INPUT filter-name-25
     3277         ) no-error .
     3278     assign
     3279       l-filter-open-25 = false
     3280     .
     3281     if flt-rec-25 <> ?
     3282       or sort-column-phrase > ""
     3283     then do:
     3284       define variable  parameter-2-25 as character no-undo .
     3285       define variable  parameter-3-25 as character no-undo .
     3286       define variable  parameter-4-25 as character no-undo .
     3287       define variable  parameter-5-25 as character no-undo .
     3288       define variable  parameter-6-25 as character no-undo .
     3289       define variable  parameter-7-25 as character no-undo .
     3290         assign
     3291         parameter-3-25 =
     3292                                 "FOR EACH buf_fin-code"
     3293         parameter-4-25 =
     3294           (
     3295             if (" buf_fin-code.status_ = p-sts" + " " + where-phrase-25) <> ""
     3296             then  substitute (' buf_fin-code.status_ =  &1 ', p-sts )  + " " + where-phrase-25
     3297             else "true"
     3298           )
     3299         parameter-5-25 = (" " + "" + " " + "")
     3300         parameter-6-25 = if sort-phrase-25 = ''
     3301                              then
     3302           (
     3303           " " + "  " +
     3304             " " + sort-column-phrase +
     3305           " " + "  "
     3306           )
     3307                              else
     3308           (
     3309           " " + "  " +
     3310             " " + sort-column-phrase +
     3311           " " + sort-phrase-25
     3312           )
     3313         parameter-7-25 =
     3314           " indexed-reposition  "
     3315       .
     3316       do
     3317       on stop undo, leave
     3318       on error undo, leave
     3319       :
     3320         assign
     3321           l-disable-where-25 =
     3322             (" buf_fin-code.status_ = p-sts" + " " + where-phrase-25 = "")
     3323         .
     3324         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3325                             ,input query br-docs:handle
     3326                             ,input parameter-3-25
     3327                             ,input parameter-4-25
     3328                             ,input parameter-5-25
     3329                             ,input parameter-6-25
     3330                             ,input parameter-7-25
     3331                             )
     3332         .
     3333         assign
     3334           l-filter-open-25 = true
     3335         .
     3336       end.
     3337       if l-filter-open-25 = false then do:
     3338         message
     3339           "Ошибка при фильтрации / сортировке" skip
     3340           "Будут показаны записи без учета фильтра" skip
     3341           view-as alert-box .
     3342       end.
     3343       else do:
     3344           assign
     3345             l-query-was-opened = true
     3346           .
     3347       end.
     3348     end.
     3349     if l-filter-open-25 = false then do:
     3350       OPEN QUERY br-docs FOR EACH buf_fin-code
     3351         where  buf_fin-code.status_ = p-sts
     3352         indexed-reposition
     3353     .
     3354         assign
     3355           l-query-was-opened = true
     3356         .
     3357     end.
     3358   end.
     3359   else do:
     3360     assign
     3361       doc-rec = recid( buf_fin-code )
     3362     .
     3363     do
     3364     on stop undo, leave
     3365     on error undo, leave
     3366     :
     3367       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_fin-code:handle) then do:
     3368         assign
     3369         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     3370         parameter-4-25 =
     3371           "where ":u +  substitute (' buf_fin-code.status_ =  &1 ', p-sts )  + " ":u + where-phrase-25 + " ":u + p-find-condition + " " + ""
     3372         parameter-5-25 = "  "
     3373       .
     3374         run fltopend_fltfindd in this-procedure  (
     3375                             input this-procedure:handle
     3376                             ,input query br-docs:handle
     3377                             ,input rowid(buf_fin-code)
     3378                             ,input logical(parameter-2-25)
     3379                             ,input no-lock
     3380                             ,input (buffer buf_fin-code:handle)
     3381                             ,input parameter-4-25
     3382                             ,input parameter-5-25
     3383                             ) no-error.
     3384         .
     3385         assign
     3386           doc-rec = integer(return-value)
     3387           v-fltopend-rowid[1] = ?
     3388         .
     3389       end.
     3390       else do:
     3391         assign
     3392         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     3393         parameter-3-25 =  "FOR EACH buf_fin-code"
     3394         parameter-4-25 =
     3395           (
     3396             if (" buf_fin-code.status_ = p-sts" + " " + where-phrase-25) <> ""
     3397             then  substitute (' buf_fin-code.status_ =  &1 ', p-sts )  + " " + where-phrase-25
     3398             else "true"
     3399           )
     3400         parameter-5-25 = (" " + "" + " " + "" + " " + p-find-condition)
     3401         parameter-6-25 = if sort-phrase-25 = ''
     3402                              then
     3403           (
     3404           " " + "  " +
     3405             " " + sort-column-phrase +
     3406           " " + "  "
     3407           )
     3408                              else
     3409           (
     3410           " " + "  " +
     3411             " " + sort-column-phrase +
     3412           " " + sort-phrase-25
     3413           )
     3414         parameter-7-25 =
     3415           " indexed-reposition  "
     3416       .
     3417         run fltopend_fltfindq in this-procedure  (
     3418                             input this-procedure:handle
     3419                             ,input query br-docs:handle
     3420                             ,input logical(parameter-2-25)
     3421                             ,input no-lock
     3422                             ,input parameter-3-25
     3423                             ,input parameter-4-25
     3424                             ,input parameter-5-25
     3425                             ,input parameter-6-25
     3426                             ,input parameter-7-25
     3427                             ,output v-fltopend-rowid
     3428                             ) no-error.
     3429         .
     3430         doc-rec = ?.
     3431       end.
     3432       assign
     3433         l-query-was-opened = true
     3434       .
     3435     end.
     3436   end.
     3437     run waitfram-hide in this-procedure .
     3438            END.
     3439            WHEN 'фирма':U THEN DO:
     3440               find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3441               if not available buf_clients then return .
     3442               filter-point = filter-point0 + par-mode.
     3443               ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name  + "  код:" +  string(par-host-code).
     3444   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
