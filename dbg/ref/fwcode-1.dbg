     4257       (input false
     4258       ,input par-next
     4259       ,input substitute("and buf_fin-code.descr   begins &1 "
     4260         , pardoc-code)
     4261       ).
     4262   apply "entry":u to p-desc in frame Dialog-Frame .
     4263   END PROCEDURE.
     4264   PROCEDURE set-filter-name :
     4265   define input parameter p-filter-name as character no-undo .
     4266     do with frame Dialog-Frame:
     4267       if p-filter-name > "" then do:
     4268         assign
     4269           frame Dialog-Frame:title
     4270             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     4271         .
     4272         assign
     4273           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     4274         .
     4275       end.
     4276       else do:
     4277         assign
     4278           b-sch :TOOLTIP = ""
     4279         .
     4280       end.
     4281     end.
     4282   END PROCEDURE.
     4283   FUNCTION sel-type RETURNS CHARACTER
     4284     (input  p-rec as recid   ) :
     4285     define buffer loc-fin-code for ub.fin-code-cor-acc  .
     4286     find first loc-fin-code no-lock where recid(loc-fin-code) = p-rec no-error .
     4287     if error-status :error then return '' .
     4288     define variable rr as character no-undo .
     4289       rr = string(entry (lookup (string(loc-fin-code.acc-type), '1,2,3':U), 'Активный,Пассивный,Акт-пасс':U) ) no-error .
     4290     if error-status :error then return '' .
     4291     RETURN rr.
     4292   END FUNCTION.
