        1   block-level on error undo, throw.
        2   define input parameter        p-mode       as character no-undo .
        3   define input parameter        p-ser-code   as integer no-undo .
        4   define input parameter        p-db-num     as int no-undo .
        5   define input parameter        p-maska     as character no-undo .
        6   define input parameter        p-series    as character no-undo .
        7   define input parameter        p-authr     as int no-undo.
        8   define input parameter        p-wth-code  as integer   no-undo .
        9   define input parameter        p-par-code  as integer no-undo .
       10   define input parameter        p-beg-dd    as character no-undo .
       11   define input parameter        p-beg-dt    as date no-undo .
       12   define input parameter        p-beg-mm    as character no-undo .
       13   define input parameter        p-beg-yy-smb as character no-undo .
       14   define input parameter        p-beg-yy     as character no-undo .
       15   define input parameter        p-chk-bdt    as integer no-undo .
       16   define input parameter        p-chk-edt    as integer no-undo .
       17   define input parameter        p-chk-gds    as integer no-undo .
       18   define input parameter        p-chk-par    as integer no-undo .
       19   define input parameter        p-chk-ser    as integer no-undo .
       20   define input parameter        p-end-dd     as character no-undo .
       21   define input parameter        p-end-dt     as date no-undo .
       22   define input parameter        p-end-mm     as character no-undo .
       23   define input parameter        p-end-yy-smb as character no-undo .
       24   define input parameter        p-end-yy     as character no-undo .
       25   define input parameter        p-gds-rule   as character no-undo .
       26   define input parameter        p-gds-smb    as character no-undo .
       27   define input parameter        p-par-rule   as character no-undo .
       28   define input parameter        p-par-smb    as character no-undo .
       29   define input parameter        p-PS         as character no-undo .
       30   define input parameter        p-qnty       as integer no-undo .
       31   define input parameter        p-range-rule as character no-undo .
       32   define input parameter        p-range-smb  as character no-undo .
       33   define input parameter        p-ser-rule   as character no-undo .
       34   define input parameter        p-ser-smb    as character no-undo .
       35   define input parameter        p-silent     as logical no-undo .
       36   define input-output parameter p-rec        as recid     no-undo .
       37   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       38   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       39   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       40   define variable vss-workfile    as character no-undo init "$Workfile: wth-ser.p $":U .
       41   define variable vss-archive     as character no-undo init "$Archive: ref/wth-ser.p $":U .
       42   define variable vss-description as character no-undo init "Сохранение маски(серии)МЦ".
       43   procedure vss-get-info :
       44     define output parameter p-vss-revision    like vss-revision    no-undo .
       45     define output parameter p-vss-author      like vss-author      no-undo .
       46     define output parameter p-vss-date        like vss-date        no-undo .
       47     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       48     define output parameter p-vss-archive     like vss-archive     no-undo .
       49     define output parameter p-vss-description like vss-description no-undo .
       50     assign
       51       p-vss-revision    = vss-revision
       52       p-vss-author      = vss-author
       53       p-vss-date        = vss-date
       54       p-vss-workfile    = vss-workfile
       55       p-vss-archive     = vss-archive
       56       p-vss-description = vss-description
       57     .
       58   end procedure.
       59   procedure vss-get-parameters :
       60     define output parameter p-vss-parameters as character no-undo .
       61   end procedure.
       62   define new global shared variable g#vssrevis-logger as handle    no-undo .
       63   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       64   define variable v-vssrevis-logger                   as handle    no-undo .
       65   procedure vss-logevent :
       66     define input  parameter p-extra-paramters as character no-undo .
       67     define variable v-vssrevis-parameters as character no-undo .
       68     do
       69     on error undo, return error return-value
       70     :
       71       if  valid-handle(v-vssrevis-logger)
       72       and v-vssrevis-logger :get-signature("logevent") <> ""
       73       then do:
       74         run vss-get-parameters in this-procedure
       75           (output v-vssrevis-parameters
       76           ).
       77         run logevent in v-vssrevis-logger
       78           (input vss-workfile
       79           ,input vss-revision
       80           ,input v-vssrevis-parameters
       81           ,input p-extra-paramters
       82           ).
       83       end.
       84     end.
       85   end procedure.
       86   assign
       87     v-vssrevis-logger = g#vssrevis-logger
       88   .
       89   if  valid-handle(v-vssrevis-logger)
       90   and v-vssrevis-logger :get-signature("logevent") <> ""
       91   then do:
       92     assign
       93       v-vssrevis-logevent = true
       94     .
       95     run vss-logevent in this-procedure (input vss-description) .
       96   end.
       97   define new global shared variable g#language as character no-undo .
       98   if g#language <> '' and g#language <> 'rus':U then do:
       99     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      100   end.
      101   define new global shared variable g#library  as handle no-undo .
      102   define new global shared variable g#library2 as handle no-undo .
      103   define   shared variable g#auto as logical no-undo.
      104   define   shared variable g#news as logical no-undo.
      105   define   shared variable g#oxml as logical no-undo.
      106   define   shared variable g#esys as logical no-undo.
      107   define   shared variable g#news-source-db as integer no-undo.
      108   define   shared variable g#esys-source-esys as integer no-undo.
      109   define   shared variable g#db-num as integer   no-undo .
      110   define   shared variable g#userid as character no-undo .
      111   define   shared variable g#passwd as character no-undo .
      112   define variable v-mess as character no-undo .
      113   define buffer buf_wealth   for ub.wealth.
      114   define buffer buf_wth-ser  for ub.wth-ser.
      115   define buffer buf_wth-par  for ub.wth-par.
      116   define buffer b_wth-ser    for ub.wth-ser.
      117   define variable v-db-num  as integer   no-undo .
      118   define variable v-int     as integer   no-undo.
      119   define variable v-date    as date      no-undo.
      120   define variable v-ChkMask as character no-undo init 0 .
      121   define variable v-maxSmb  as integer   no-undo .
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      124     (output v-db-num
      125     )  .
      126   main-block:
      127   do
      128   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      129   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      130   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      131   :
      132     if p-wth-code > 0 then.
      133     else do:
      134       v-mess =  "Не указан код МЦ" .
      135       run err-mess in this-procedure ( input-output v-mess).
      136       return error (if p-silent = yes then v-mess else 'wth-code':U).
      137     end.
      138     find first buf_wealth no-lock where
      139             buf_wealth.wth-code = p-wth-code no-error .
      140     if not available buf_wealth then do:
      141       v-mess = substitute("Не найдена МЦ &1!",p-wth-code).
      142       run err-mess in this-procedure ( input-output v-mess).
      143       return error (if p-silent = yes then v-mess else 'wth-code':U).
      144     end.
      145     if buf_wealth.is-ser <> 1 then do:
      146       v-mess = substitute("Серия не может относиться к несерийной МЦ (&1)!",p-wth-code).
      147       run err-mess in this-procedure ( input-output v-mess).
      148       return error (if p-silent = yes then v-mess else 'wth-code':U).
      149     end.
      150     if p-par-code > 0 then.
      151     else do:
      152       v-mess =  "Не указан код номинала МЦ" .
      153       run err-mess in this-procedure ( input-output v-mess).
      154       return error (if p-silent = yes then v-mess else 'par-code':U).
      155     end.
      156     find first buf_wth-par no-lock where
      157             buf_wth-par.par-code = p-par-code
      158             and buf_wth-par.wth-code = p-wth-code no-error .
      159     if not available buf_wth-par then do:
      160       v-mess = substitute("Не найден номинал МЦ с кодом &1 и кодом МЦ &2!",p-par-code,p-wth-code).
      161       run err-mess in this-procedure ( input-output v-mess).
      162       return error (if p-silent = yes then v-mess else 'par-code':U).
      163     end.
      164     if p-series = '' then do:
      165       v-mess =  "Не указан внешний код серии" .
      166       run err-mess in this-procedure ( input-output v-mess).
      167       return error (if p-silent = yes then v-mess else 'series':U).
      168     end.
      169     if p-maska = '' then do:
      170       v-mess =  "Не указана маска по форматам кассы" .
      171       run err-mess in this-procedure ( input-output v-mess).
      172       return error (if p-silent = yes then v-mess else 'maska':U).
      173     end.
      174     do v-int = 1 to length(p-maska):
      175       if index('?*0123456789':U,substring(p-maska,v-int,1)) = 0 then do:
      176         v-mess = 'Неверно указана маска. Разрешены только символы ?*0123456789!'.
      177         run err-mess in this-procedure ( input-output v-mess).
      178         return error (if p-silent = yes then v-mess else 'maska':U).
      179       end.
      180       if substring(p-maska,v-int,1) = '*':U and v-int <> length(p-maska) then do:
      181         v-mess = 'Неверно указана маска. Символ * может быть использоваться только в конце маски!'.
      182         run err-mess in this-procedure ( input-output v-mess).
      183         return error (if p-silent = yes then v-mess else 'maska':U).
      184       end.
      185     end.
      186     if p-chk-ser = 1 then do:
      187       v-int = int(p-ser-rule) no-error.
      188       if v-int > 0 then.
      189       else do:
      190         v-mess = 'Неверно указан символ проверки серии'.
      191         run err-mess in this-procedure ( input-output v-mess).
      192         return error (if p-silent = yes then v-mess else 'ser-rule':U).
      193       end.
      194       if p-ser-smb > '' then.
      195       else do:
      196         v-mess = 'Неверно указано значение для проверки серии'.
      197         run err-mess in this-procedure ( input-output v-mess).
      198         return error (if p-silent = yes then v-mess else 'ser-smb':U).
      199       end.
      200       run ChkMask(p-ser-rule,length(p-ser-smb)) no-error.
      201       if error-status:error then do:
      202         v-mess = return-value.
      203         run err-mess in this-procedure ( input-output v-mess).
      204         return error (if p-silent = yes then v-mess else 'ser-smb':U).
      205       end.
      206     end.
      207     if p-chk-gds = 1 then do:
      208       v-int = int(p-gds-rule) no-error.
      209       if v-int > 0 then.
      210       else do:
      211         v-mess = 'Неверно указан символ проверки товара'.
      212         run err-mess in this-procedure ( input-output v-mess).
      213         return error (if p-silent = yes then v-mess else 'gds-rule':U).
      214       end.
      215       run ChkMask(p-gds-rule,length(p-gds-smb)) no-error.
      216       if error-status:error then do:
      217         v-mess = return-value.
      218         run err-mess in this-procedure ( input-output v-mess).
      219         return error (if p-silent = yes then v-mess else 'gds-smb':U).
      220       end.
      221     end.
      222     if p-chk-par = 1 then do:
      223       v-int = int(p-par-rule) no-error.
      224       if v-int > 0 then.
      225       else do:
      226         v-mess = 'Неверно указан символ проверки номинала'.
      227         run err-mess in this-procedure ( input-output v-mess).
      228         return error (if p-silent = yes then v-mess else 'par-rule':U).
      229       end.
      230       if p-par-smb > '' then.
      231       else do:
      232         v-mess = 'Неверно указано значение для проверки номинала'.
      233         run err-mess in this-procedure ( input-output v-mess).
      234         return error (if p-silent = yes then v-mess else 'par-smb':U).
      235       end.
      236       run ChkMask(p-par-rule,length(p-par-smb)) no-error.
      237       if error-status:error then do:
      238         v-mess = return-value.
      239         run err-mess in this-procedure ( input-output v-mess).
      240         return error (if p-silent = yes then v-mess else 'par-smb':U).
      241       end.
      242     end.
      243     if p-chk-bdt = 2 and p-beg-dt = ? then do:
      244         v-mess = 'Не указана дата начала срока действия! '.
      245         run err-mess in this-procedure ( input-output v-mess).
      246         return error (if p-silent = yes then v-mess else 'beg-dt':U).
      247     end.
      248     if p-chk-bdt = 1 then do:
      249       v-int = int(p-beg-yy) no-error.
      250       if v-int > 0 then.
      251       else do:
      252         v-mess = 'Неверно указан символ проверки года начала срока действия'.
      253         run err-mess in this-procedure ( input-output v-mess).
      254         return error (if p-silent = yes then v-mess else 'beg-yy':U).
      255       end.
      256       v-int = int(p-beg-yy-smb) no-error.
      257       if v-int > 0 then.
      258       else do:
      259         v-mess = 'Неверно указано кол-во символов для проверки года начала срока действия'.
      260         run err-mess in this-procedure ( input-output v-mess).
      261         return error (if p-silent = yes then v-mess else 'beg-yy-smb':U).
      262       end.
      263       if v-int > 0 and v-int <= 4 then.
      264       else do:
      265         v-mess = 'Кол-во символов для проверки года начала срока действия не должно быть больше 4-х'.
      266         run err-mess in this-procedure ( input-output v-mess).
      267         return error (if p-silent = yes then v-mess else 'end-yy-smb':U).
      268       end.
      269       run ChkMask(p-beg-yy,int(p-beg-yy-smb) ) no-error.
      270       if error-status:error then do:
      271         v-mess = return-value.
      272         run err-mess in this-procedure ( input-output v-mess).
      273         return error (if p-silent = yes then v-mess else 'beg-yy-smb':U).
      274       end.
      275       v-int = int(p-beg-mm) no-error.
      276       if v-int > 0 then.
      277       else do:
      278         v-mess = 'Неверно указан символ проверки месяца начала срока действия'.
      279         run err-mess in this-procedure ( input-output v-mess).
      280         return error (if p-silent = yes then v-mess else 'beg-mm':U).
      281       end.
      282       run ChkMask(p-beg-mm,2 ) no-error.
      283       if error-status:error then do:
      284         v-mess = return-value.
      285         run err-mess in this-procedure ( input-output v-mess).
      286         return error (if p-silent = yes then v-mess else 'beg-mm':U).
      287       end.
      288       v-int = int(p-beg-dd) no-error.
      289       if v-int > 0 then.
      290       else do:
      291         v-mess = 'Неверно указан символ проверки дня начала срока действия'.
      292         run err-mess in this-procedure ( input-output v-mess).
      293         return error (if p-silent = yes then v-mess else 'beg-dd':U).
      294       end.
      295       run ChkMask(p-beg-dd,2 ) no-error.
      296       if error-status:error then do:
      297         v-mess = return-value.
      298         run err-mess in this-procedure ( input-output v-mess).
      299         return error (if p-silent = yes then v-mess else 'beg-dd':U).
      300       end.
      301     end.
      302     if p-chk-edt = 2 and p-end-dt = ? then do:
      303         v-mess = 'Не указана дата начала срока действия! '.
      304         run err-mess in this-procedure ( input-output v-mess).
      305         return error (if p-silent = yes then v-mess else 'end-dt':U).
      306     end.
      307     if p-chk-edt = 1 then do:
      308       v-int = int(p-end-yy) no-error.
      309       if v-int > 0 then.
      310       else do:
      311         v-mess = 'Неверно указан символ проверки года окончания срока действия'.
      312         run err-mess in this-procedure ( input-output v-mess).
      313         return error (if p-silent = yes then v-mess else 'end-yy':U).
      314       end.
      315       v-int = int(p-end-yy-smb) no-error.
      316       if v-int > 0 then.
      317       else do:
      318         v-mess = 'Неверно указано кол-во символов для проверки года окончания срока действия'.
      319         run err-mess in this-procedure ( input-output v-mess).
      320         return error (if p-silent = yes then v-mess else 'end-yy-smb':U).
      321       end.
      322       if v-int > 0 and v-int <= 4 then.
      323       else do:
      324         v-mess = 'Кол-во символов для проверки года окончания срока действия не должно быть больше 4-х'.
      325         run err-mess in this-procedure ( input-output v-mess).
      326         return error (if p-silent = yes then v-mess else 'end-yy-smb':U).
      327       end.
      328       run ChkMask(p-end-yy,int(p-end-yy-smb) ) no-error.
      329       if error-status:error then do:
      330         v-mess = return-value.
      331         run err-mess in this-procedure ( input-output v-mess).
      332         return error (if p-silent = yes then v-mess else 'end-yy-smb':U).
      333       end.
      334       v-int = int(p-end-mm) no-error.
      335       if v-int > 0 then.
      336       else do:
      337         v-mess = 'Неверно указан символ проверки месяца окончания срока действия'.
      338         run err-mess in this-procedure ( input-output v-mess).
      339         return error (if p-silent = yes then v-mess else 'end-mm':U).
      340       end.
      341       run ChkMask(p-end-mm,2 ) no-error.
      342       if error-status:error then do:
      343         v-mess = return-value.
      344         run err-mess in this-procedure ( input-output v-mess).
      345         return error (if p-silent = yes then v-mess else 'end-mm':U).
      346       end.
      347       v-int = int(p-end-dd) no-error.
      348       if v-int > 0 then.
      349       else do:
      350         v-mess = 'Неверно указан символ проверки дня окончания срока действия'.
      351         run err-mess in this-procedure ( input-output v-mess).
      352         return error (if p-silent = yes then v-mess else 'end-dd':U).
      353       end.
      354       run ChkMask(p-end-dd,2 ) no-error.
      355       if error-status:error then do:
      356         v-mess = return-value.
      357         run err-mess in this-procedure ( input-output v-mess).
      358         return error (if p-silent = yes then v-mess else 'end-dd':U).
      359       end.
      360     end.
      361     v-int = int(p-range-rule) no-error.
      362     if v-int > 0 then.
      363     else do:
      364       v-mess = 'Неверно указан символ-начало для вырезания диапазона'.
      365       run err-mess in this-procedure ( input-output v-mess).
      366       return error (if p-silent = yes then v-mess else 'range-rule':U).
      367     end.
      368     v-int = int(p-range-smb) no-error.
      369     if v-int > 0 then.
      370     else do:
      371       v-mess = 'Неверно указан символ-конец для вырезания диапазона'.
      372       run err-mess in this-procedure ( input-output v-mess).
      373       return error (if p-silent = yes then v-mess else 'range-smb':U).
      374     end.
      375     run ChkMask(p-range-rule,int(p-range-smb) - int(p-range-rule) + 1 ) no-error.
      376     if error-status:error then do:
      377       v-mess = return-value.
      378       run err-mess in this-procedure ( input-output v-mess).
      379       return error (if p-silent = yes then v-mess else 'range-smb':U).
      380     end.
      381     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      382       create buf_wth-ser.
      383       assign
      384       buf_wth-ser.ser-code = next-value(s-wth-ser, ub)
      385       buf_wth-ser.db-num =  v-db-num.
      386       .
      387     end.
      388     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      389       find first buf_wth-ser exclusive-lock where
      390                 recid(buf_wth-ser) = p-rec .
      391       if buf_wth-ser.ser-code <> p-ser-code or buf_wth-ser.db-num <> p-db-num then do:
      392         v-mess = substitute("Для уже имеющейся записи Серии номинала МЦ нельзя изменить код Серии или № БД &1" +
      393                              "старый код серии - &2 № БД - &3"
      394                              ,chr(10)
      395                              , buf_wth-ser.ser-code
      396                              , buf_wth-ser.db-num).
      397         run err-mess in this-procedure ( input-output v-mess).
      398         return error (if p-silent = yes then v-mess else '':U).
      399       end.
      400     end.
      401     assign
      402     buf_wth-ser.maska      =  p-maska
      403     buf_wth-ser.series     =  p-series
      404     buf_wth-ser.authr      =  p-authr
      405     buf_wth-ser.wth-code   =  p-wth-code
      406     buf_wth-ser.par-code   =  p-par-code
      407     buf_wth-ser.beg-dd      = p-beg-dd
      408     buf_wth-ser.beg-dt     =  p-beg-dt
      409     buf_wth-ser.beg-mm     =  p-beg-mm
      410     buf_wth-ser.beg-yy-smb =  p-beg-yy-smb
      411     buf_wth-ser.beg-yy     =  p-beg-yy
      412     buf_wth-ser.chk-bdt    =  p-chk-bdt
      413     buf_wth-ser.chk-edt    =  p-chk-edt
      414     buf_wth-ser.chk-gds    =  p-chk-gds
      415     buf_wth-ser.chk-par    =  p-chk-par
      416     buf_wth-ser.chk-ser    =  p-chk-ser
      417     buf_wth-ser.end-dd     =  p-end-dd
      418     buf_wth-ser.end-dt     =  p-end-dt
      419     buf_wth-ser.end-mm     =  p-end-mm
      420     buf_wth-ser.end-yy-smb =  p-end-yy-smb
      421     buf_wth-ser.end-yy     =  p-end-yy
      422     buf_wth-ser.gds-rule   =  p-gds-rule
      423     buf_wth-ser.gds-smb    =  p-gds-smb
      424     buf_wth-ser.par-rule   =  p-par-rule
      425     buf_wth-ser.par-smb    =  p-par-smb
      426     buf_wth-ser.PS          = p-PS
      427     buf_wth-ser.qnty        = p-qnty
      428     buf_wth-ser.range-rule  = p-range-rule
      429     buf_wth-ser.range-smb   = p-range-smb
      430     buf_wth-ser.ser-rule    = p-ser-rule
      431     buf_wth-ser.ser-smb     = p-ser-smb
      432     .
      433     p-rec =   recid(buf_wth-ser).
      434     release buf_wth-ser no-error .
      435     if error-status:error then do:
      436       v-mess = substitute("Ошибка при сохранения записи номинала МЦ:&1&2&3"
      437                            , error-status:get-message(1)
      438                            , chr(10)
      439                            , return-value
      440                            ).
      441       run err-mess in this-procedure ( input-output v-mess).
      442       return error (if p-silent = yes then v-mess else '':U).
      443     end.
      444   end.
      445   PROCEDURE err-mess:
      446     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      447     CASE p-silent:
      448       when yes then do:
      449         assign
      450         p-mess = substitute("Серия МЦ: код &1-&2 &3&4"
      451                            , p-ser-code
      452                            , p-db-num
      453                            , chr(10)
      454                            , p-mess)
      455         .
      456       end.
      457       when no then do:
      458         message
      459         p-mess
      460         view-as alert-box error .
      461       end.
      462     end.
      463   END PROCEDURE.
      464   PROCEDURE ChkMask:
      465     DEFINE INPUT PARAMETER p-rule as char.
      466     DEFINE INPUT PARAMETER p-ln as int.
      467     def var v-i as int.
      468     do v-i = int(p-rule) to int(p-rule)+ p-ln - 1:
      469       if v-i > length(p-maska) and substring(p-maska,length(p-maska),1) <> '*' then  return error substitute('Символ &1, заданный в проверках по маске больше чем длина маски &2!',v-i,length(p-maska)).
      470       if lookup(string(v-i),v-ChkMask) > 0 then return error substitute('Не верно заданы проверки по маске.~nПозиция &1 используется более одного раза!',v-i).
      471       else  v-ChkMask =  v-ChkMask + ',' + string(v-i).
      472       if v-maxSmb < v-i then v-maxSmb = v-i.
      473     end.
      474   END PROCEDURE.
