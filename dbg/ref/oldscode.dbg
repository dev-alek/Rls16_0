     3762       ,input  '':U
     3763       ,input  0
     3764       ,input  0
     3765       ,input  ub.goods.grp-code
     3766       ,input  0
     3767       ,input  false
     3768       ,output glog
     3769       )  .
     3770   end.
     3771             end.
     3772             else do :
     3773             glog = false.
     3774             end.
     3775             if not glog then do :
     3776               v-msg = substitute("Товар: &1&2&3 код товара &4 ДопБК &5 : недоступно право actn_alt-barcode_loc-sc-code - выключение лок. вес. кодов  "
     3777                                 ,temp-codes.artic
     3778                                 ,temp-codes.prod-type
     3779                                 ,temp-codes.prod-code
     3780                                 ,temp-codes.gds-code
     3781                                 ,temp-codes.b-str)
     3782               .
     3783               run write-file in this-procedure ( input v-msg).
     3784             end.
     3785           end.
     3786           if glog then do :
     3787           if off-option = "mark":U and buf_temp-codes.is-mark = no then NEXT.
     3788           assign
     3789           v-ii = v-ii + 1
     3790           .
     3791           run waitfram-show in this-procedure ("Обработано" + chr(32) + string(v-ii)).
     3792           run trg/bc-upd.p (
     3793                                    input parparentproc
     3794                                   ,input buf_temp-codes.b-code
     3795                                   ,input buf_temp-codes.b-str
     3796                                   ,input no
     3797                                   ,input yes
     3798                                   ,input v-tocd
     3799                                   ,input ?
     3800                                   ,input this-procedure:handle
     3801                                   ) no-error.
     3802           if not error-status:error then do:
     3803             if choice = 2 then do:
     3804               find first buf_prod-bc exclusive-lock
     3805                     where buf_prod-bc.b-str = temp-codes.b-str
     3806                       and buf_prod-bc.b-code = temp-codes.b-code no-error.
     3807               if not available buf_prod-bc then do:
     3808                 next _temp-codes.
     3809               end.
     3810               if not (buf_prod-bc.bc-on = no) then do:
     3811                 next _temp-codes.
     3812           end.
     3813               delete buf_prod-bc no-error.
     3814               if error-status:error then do:
     3815                 next _temp-codes.
     3816         end.
     3817             end.
     3818             delete buf_temp-codes.
     3819           end.
     3820           end.
     3821         end.
     3822        run waitfram-hide in this-procedure .
     3823     end.
     3824   END CASE.
     3825   end.
     3826   run openbr in this-procedure.
     3827   END PROCEDURE.
     3828   PROCEDURE proc-b-print :
     3829   define variable v-today as date no-undo.
     3830   define variable v-time as integer no-undo.
     3831   define variable v-user-action   as character no-undo .
     3832   define variable v-printed       as logical   no-undo .
     3833   define variable accum-count as integer no-undo.
     3834   define variable for-prod   as character no-undo .
     3835   define variable for-obj   as character no-undo .
     3836   define variable for-max-fact-qnty-obj   as character no-undo .
     3837   define variable date_string   as character no-undo .
     3838   define variable Line   as character no-undo .
     3839   define variable v-doc-rec as recid no-undo .
     3840   DEFINE FRAME B-str-List
     3841   temp-codes.b-str       column-label "Код"                format "X(6)"
     3842   temp-codes.bc-on     column-label "Вкл" format "+/"
     3843   temp-codes.is-glob  column-label "Глоб" format "+/"
     3844   temp-codes.plu-type  column-label "Тип" format "X(3)"
     3845   temp-codes.artic
     3846   temp-codes.gds-code
     3847   temp-codes.gds-name COLUMN-LABEL "Название" FORMAT "X(20)"
     3848   for-prod   COLUMN-LABEL "П-ль" FORMAT "X(12)"
     3849   temp-codes.prod-name COLUMN-LABEL "Производитель" FORMAT "X(20)"
     3850   temp-codes.in-date COLUMN-LABEL "Посл.ПН!в тек.БД" FORMAT "99/99/9999"
     3851   for-obj  COLUMN-LABEL "Объект!посл.ПН" FORMAT "X(8)"
     3852   temp-codes.fact-qnty COLUMN-LABEL "Факт (кол-во)!на всех объ. БД"
     3853   temp-codes.free-qnty COLUMN-LABEL "Свободно (кол-во)!на всех объ. БД"
     3854   temp-codes.max-fact-qnty COLUMN-LABEL "Max факт. (кол-во)!на объ. БД"
     3855   for-max-fact-qnty-obj
     3856                        COLUMN-LABEL "Объект max!факт (кол.)" FORMAT "X(8)"
     3857   HEADER  date_string format "X(50)" AT 5
     3858   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3859   Line format "X(148)" AT 1
     3860   with width 232 down stream-io use-text    .
     3861   run cur-time in this-procedure(output v-today, output v-time).
     3862   assign
     3863   date_String = cur-time-print()
     3864   Line = fill("-", 179).
     3865   .
     3866   define buffer buf_temp-codes for temp-codes.
     3867   if print-option = "":U then do:
     3868      run gbl/pop-up.p (b-print:handle in frame Dialog-Frame, no) no-error.
     3869   end.
     3870   if print-option = "":U then do:
     3871       return error.
     3872   end.
     3873   CASE print-option:
     3874       when "protocol":U then do:
     3875          file-info:file-name = v-log-file.
     3876          if file-info:full-pathname = ? then do:
     3877            message
     3878            substitute("Не найден или еще не создавался файла протокола &1", v-log-file)
     3879            view-as alert-box error .
     3880            undo, return error .
     3881          end.
     3882          run gbl/prnfilen.w
     3883            (input  "Протокол"
     3884            ,input  0
     3885            ,input  v-log-file
     3886            ,input  7
     3887            ,output v-user-action
     3888            ,output v-printed
     3889            ).
     3890       end.
     3891       when "errors":U then do:
     3892          file-info:file-name = v-err-file.
     3893          if file-info:full-pathname = ? then do:
     3894            message
     3895            substitute("Не найден или еще не создавался файл ошибок &1", v-err-file)
     3896            view-as alert-box error .
     3897            undo, return error .
     3898          end.
     3899          run gbl/prnfilen.w
     3900            (input  "Ошибки"
     3901            ,input  0
     3902            ,input  v-err-file
     3903            ,input  7
     3904            ,output v-user-action
     3905            ,output v-printed
     3906            ).
     3907       end.
     3908       when "list":U then do:
     3909         v-doc-rec = recid( temp-codes ).
     3910         DO WHILE available temp-codes :
     3911               GET prev br-goods.
     3912         END.
     3913   run prn-lib-open-stream  in this-procedure (
     3914                                                input parParentProc
     3915                                               ,input 43
     3916                                               ,input yes
     3917                                               ,input no
     3918                                               ).
     3919   PUT  STREAM PrnLibStream
     3920   SPACE(25) ( frame Dialog-Frame:title )
     3921   format "x(90)" SKIP(1) .
     3922   FORM HEADER
     3923           Line format "X(179)" AT 1 SKIP
     3924           "Продолжение - на следующей странице" AT 30 SKIP
     3925           with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3926   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3927       FORM with FRAME B-str-list  .
     3928       run waitfram-show in this-procedure ("Ждите...").
     3929       GET next br-goods.
     3930       DO WHILE available temp-codes :
     3931         Display STREAM PrnLibStream
     3932         temp-codes.bc-on
     3933         temp-codes.b-str
     3934         temp-codes.artic
     3935         temp-codes.gds-code
     3936         temp-codes.gds-name
     3937         temp-codes.prod-type + string(temp-codes.prod-code) @ for-prod
     3938         temp-codes.prod-name
     3939         temp-codes.in-date
     3940         temp-codes.obj-type + string(temp-codes.obj-code) @ for-obj
     3941         temp-codes.fact-qnty
     3942         temp-codes.free-qnty
     3943         temp-codes.max-fact-qnty
     3944         temp-codes.max-fact-qnty-obj-type + string(temp-codes.max-fact-qnty-obj-code) @ for-max-fact-qnty-obj
     3945         with FRAME B-str-list .
     3946         DOWN STREAM PrnLibStream 1 with FRAME B-str-list  .
     3947         assign
     3948         accum-count = accum-count + 1
     3949         .
     3950         GET next br-goods.
     3951     END.
     3952       UNDERLINE  STREAM PrnLibStream
     3953       temp-codes.bc-on
     3954       temp-codes.b-str
     3955       temp-codes.artic
     3956       temp-codes.gds-code
     3957       temp-codes.gds-name
     3958       for-prod
     3959       temp-codes.prod-name
     3960       temp-codes.in-date
     3961       for-obj
     3962       temp-codes.fact-qnty
     3963       temp-codes.free-qnty
     3964       temp-codes.max-fact-qnty
     3965       for-max-fact-qnty-obj
     3966        with FRAME B-str-list .
     3967        DISPLAY STREAM PrnLibStream
     3968        "ИТОГО"  @ temp-codes.b-str
     3969        accum-count @ temp-codes.gds-code
     3970        with frame B-str-list.
     3971       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3972       HIDE  STREAM PrnLibStream FRAME CheckList.
     3973       output  STREAM PrnLibStream CLOSE.
     3974       reposition br-goods to recid v-doc-rec no-error.
     3975       run waitfram-hide in this-procedure .
     3976       run prn-lib-prn-file in this-procedure (
     3977                                                 input parParentProc
     3978                                                 ,input 8
     3979                                                 ).
     3980     end.
     3981   END.
     3982   END PROCEDURE.
     3983   PROCEDURE set-file-title :
     3984   define input parameter p-filename as character no-undo.
     3985   define output parameter p-full-path as character no-undo.
     3986   define variable v-today as date no-undo.
     3987   define variable v-time as integer no-undo.
     3988   define variable v-path             as character no-undo .
     3989   define variable v-file-name        as character no-undo .
     3990   define variable v-file-name-no-ext as character no-undo .
     3991   define variable v-file-name-ext    as character no-undo .
     3992   output stream PrnLibStream to value(p-filename) append.
     3993   run cur-time in this-procedure(output v-today, output v-time).
     3994   Put stream PrnLibStream unformatted
     3995   "**************************************************" skip
     3996   "USER:":U v-cntxt-userid skip
     3997   string(v-today, "99/99/9999") chr(32) string(v-time, "HH:MM:SS")
     3998   skip.
     3999   output stream PrnLibStream close.
     4000   run gbl/filename.p (
     4001                            input p-filename
     4002                           ,output p-full-path
     4003                           ,output v-path
     4004                           ,output v-file-name
     4005                           ,output v-file-name-no-ext
     4006                           ,output v-file-name-ext
     4007                           ).
     4008   END PROCEDURE.
     4009   PROCEDURE set-filter :
     4010   define variable v-today as date no-undo.
     4011   define variable v-time as integer no-undo.
     4012   define variable v-dop as character no-undo.
     4013   run cur-time in this-procedure(output v-today, output v-time).
     4014   run uf-get in this-procedure(
     4015       input  'oldscode':U
     4016       ,input  v-cntxt-userid
     4017       ,output v-uf-List_
     4018       ,output v-uf-Naim
     4019       ,output v-uf-print-graft
     4020       ,output v-uf-sort-gr
     4021       ,output v-uf-type-price
     4022       ,output v-uf-type-val
     4023   )  no-error.
     4024   if not error-status:error
     4025   and num-entries(v-uf-List_, ";") >= 2 then do:
     4026    assign
     4027    v-dop = entry(2, entry(1, v-uf-list_, ";"), "=")
     4028    v-in-date = date(integer(entry(2, v-dop, chr(47))),
     4029                     integer(entry(1, v-dop, chr(47))),
     4030                     integer(entry(3, v-dop, chr(47)))
     4031                    )
     4032    v-dop = entry(2, entry(2, v-uf-list_, ";"), "=")
     4033    v-fact-qnty = decimal(v-dop)
     4034    v-dop = (if num-entries(v-uf-List_, ";") > 2
     4035             then entry(2, entry(3, v-uf-list_, ";"), "=")
     4036             else string(yes))
     4037    rs-on-off-state = logical(v-dop)
     4038   .
     4039   end.
     4040   else do:
     4041     run uf-set in this-procedure(
     4042         input  'oldscode':U
     4043         ,input  v-cntxt-userid
     4044         ,input  ("in-date=":U +
     4045               string(date(Month(v-today), day(v-today), Year(v-today) - 1) , "99/99/9999") +
     4046                      ";" + "fact-qnty=":U + string(0.5) +
     4047                      ";" + "on-off-state=" + string(yes))
     4048         ,input v-uf-Naim
     4049         ,input v-uf-print-graft
     4050         ,input v-uf-sort-gr
     4051         ,input v-uf-type-price
     4052         ,input v-uf-type-val
     4053     )  no-error .
     4054    assign
     4055    v-in-date = v-today
     4056    v-fact-qnty = 0.5
     4057    rs-on-off-state = yes
     4058    .
     4059   end.
     4060   display
     4061   v-in-date
     4062   v-fact-qnty
     4063   rs-on-off-state
     4064   with frame Dialog-Frame
     4065   .
     4066   END PROCEDURE.
     4067   PROCEDURE Set-Query :
     4068   define input parameter p-l as logical no-undo.
     4069   CASE p-l:
     4070       when yes then do:
     4071           Display
     4072           RECT-b-query with frame Dialog-Frame.
     4073       end.
     4074       when no then do:
     4075           HIDE
     4076           RECT-b-query in frame Dialog-Frame.
     4077       end.
     4078   END CASE.
     4079   END PROCEDURE.
     4080   PROCEDURE write-file :
     4081   define input parameter p-message as character no-undo.
     4082   output stream PrnLibstream to value(v-log-file) append.
     4083   put stream PrnLibStream unformatted p-message skip.
     4084   output stream Prnlibstream close.
     4085   END PROCEDURE.
     4086   FUNCTION get-title RETURNS CHARACTER
     4087     ( p-in-date as date, p-fact-qnty as decimal, p-on-off-state as logical ) :
     4088   define variable v-str as character no-undo.
     4089     assign
     4090       v-str = chr(32) + "Посл. дата ПН" + chr(32) + string(p-in-date) + chr(44) +
     4091               chr(32) + "Max факт.кол-во на объекте<=" + chr(32) + string(p-fact-qnty) + chr(44) +
     4092               chr(32) + "Вкл/выкл=" + chr(32) + string(p-on-off-state)
     4093                  .
     4094     RETURN v-str.
     4095   END FUNCTION.
