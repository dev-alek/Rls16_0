     3626               if buf_prod-bc.cr-db-num <> v-cntxt-db-num then do:
     3627                 assign
     3628                 v-msg = substitute("Товар: &1&2&3 код товара &4 ДопБК &5 создан в другой БД (&6) - удалить невозможно"
     3629                                   ,temp-codes.artic
     3630                                   ,temp-codes.prod-type
     3631                                   ,temp-codes.prod-code
     3632                                   ,temp-codes.gds-code
     3633                                   ,temp-codes.b-str
