     3604                 run waitfram-hide in this-procedure .
     3605                 assign
     3606                 off-option = "":U
     3607                 .
     3608                 undo, return error.
     3609               end.
     3610               if not (buf_prod-bc.bc-on = no) then do:
     3611                 assign
     3612                 v-msg = substitute("Товар: &1&2&3 код товара &4 ДопБК &5 все еще включен - удалить невозможно"
     3613                                   ,temp-codes.artic
     3614                                   ,temp-codes.prod-type
     3615                                   ,temp-codes.prod-code
