     1254               when 'e-eslg-e':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1255               when 'prphoto':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(2256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(2256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Прайс-лист с фото товаров"     p-tooltip = "Прайс-лист с фото товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1256               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1257               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1258               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1259                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1260               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1261         otherwise do:
     1262           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1263         end.
     1264       end CASE.
     1265     end.
     1266   end procedure.
     1267   procedure uf-get :
     1268     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1269     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1270     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1271     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1272     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1273     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1274     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1275     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1276     do
     1277     on error undo, return error
     1278     :
     1279       define buffer buf_usr-flt for ubflt.usr-flt .
     1280       define variable v-use-List_     as logical   no-undo .
     1281       define variable v-type-List_     as character no-undo .
     1282       define variable v-format-List_   as character no-undo .
     1283       define variable v-use-Naim      as logical   no-undo .
     1284       define variable v-type-Naim      as character no-undo .
     1285       define variable v-format-Naim    as character no-undo .
     1286       define variable v-use-print-graft as logical   no-undo .
     1287       define variable v-use-sort-gr     as logical   no-undo .
     1288       define variable v-use-type-price  as logical   no-undo .
     1289       define variable v-use-type-val    as logical   no-undo .
     1290       define variable v-label          as character no-undo .
     1291       define variable v-tooltip        as character no-undo .
     1292       define variable v-user-can-edit  as logical   no-undo .
     1293       define variable v-output-display as logical   no-undo .
     1294       define variable v-other          as character no-undo .
     1295       run uf-name in this-procedure
     1296          (input  entry(1, p-code, chr(4))
     1297         ,output v-use-List_
     1298         ,output v-type-List_
     1299         ,output v-format-List_
     1300         ,output v-use-Naim
     1301         ,output v-type-Naim
     1302         ,output v-format-Naim
     1303         ,output v-use-print-graft
     1304         ,output v-use-sort-gr
     1305         ,output v-use-type-price
     1306         ,output v-use-type-val
     1307         ,output v-label
     1308         ,output v-tooltip
     1309         ,output v-user-can-edit
     1310         ,output v-output-display
     1311         ,output v-other
     1312         ) no-error .
     1313       if error-status :error then do:
     1314         undo, return error return-value .
     1315       end.
     1316       find first buf_usr-flt no-lock where
     1317                  buf_usr-flt.Call-point     = p-code AND
     1318                  buf_usr-flt.user-name       = p-user-name
     1319         no-error .
     1320       if avail buf_usr-flt then do:
     1321         assign
     1322         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1323         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1324         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1325         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1326         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1327         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1328         .
     1329       end.
     1330       else do:
     1331         assign
     1332         p-List_        = (if v-use-List_       then "":U                    else ?)
     1333         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1334         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1335         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1336         p-type-price   = (if v-use-type-price  then no                      else ?)
     1337         p-type-val     = (if v-use-List_       then no                      else ?)
     1338         .
     1339       end.
     1340     end.
     1341   end procedure.
     1342   procedure uf-set :
     1343     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1344     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1345     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1346     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1347     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1348     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1349     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1350     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1351     do
     1352     on error undo, return error
     1353     :
     1354       define buffer buf_usr-flt for ubflt.usr-flt .
     1355       define variable v-use-List_     as logical   no-undo .
     1356       define variable v-type-List_     as character no-undo .
     1357       define variable v-format-List_   as character no-undo .
     1358       define variable v-use-Naim      as logical   no-undo .
     1359       define variable v-type-Naim      as character no-undo .
     1360       define variable v-format-Naim    as character no-undo .
     1361       define variable v-use-print-graft as logical   no-undo .
     1362       define variable v-use-sort-gr   as logical   no-undo .
     1363       define variable v-use-type-price as logical   no-undo .
     1364       define variable v-use-type-val  as logical   no-undo .
     1365       define variable v-tooltip        as character no-undo .
     1366       define variable v-label          as character no-undo .
     1367       define variable v-user-can-edit  as logical   no-undo .
     1368       define variable v-output-display as logical   no-undo .
     1369       define variable v-other          as character no-undo .
     1370       run uf-name in this-procedure
     1371         (input  entry(1, p-code, chr(4))
     1372         ,output v-use-List_
     1373         ,output v-type-List_
     1374         ,output v-format-List_
     1375         ,output v-use-Naim
     1376         ,output v-type-Naim
     1377         ,output v-format-Naim
     1378         ,output v-use-print-graft
     1379         ,output v-use-sort-gr
     1380         ,output v-use-type-price
     1381         ,output v-use-type-val
     1382         ,output v-label
     1383         ,output v-tooltip
     1384         ,output v-user-can-edit
     1385         ,output v-output-display
     1386         ,output v-other
     1387         ) no-error .
     1388       if error-status :error then do:
     1389         undo, return error return-value .
     1390       end.
     1391       find first buf_usr-flt where
     1392                  buf_usr-flt.Call-point     = p-code AND
     1393                  buf_usr-flt.user-name       = p-user-name
     1394         no-error .
     1395       if not avail buf_usr-flt then do:
     1396           create buf_usr-flt .
     1397           assign
     1398           buf_usr-flt.call-point = p-code
     1399           buf_usr-flt.user-name  = p-user-name
     1400           .
     1401       end.
     1402       if avail buf_usr-flt then do:
     1403        assign
     1404        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1405        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1406        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1407        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1408        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1409        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1410       .
     1411       release buf_usr-flt.
     1412       end.
     1413       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1414     end.
     1415   end procedure.
     1416   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1417     define variable v-cntxt-db-num        as integer   no-undo .
     1418     define variable v-cntxt-userid        as character no-undo .
     1419     define variable v-cntxt-level         as character no-undo .
     1420     define variable v-cntxt-host-code-obj as integer   no-undo .
     1421     define variable v-cntxt-obj-type      as character no-undo .
     1422     define variable v-cntxt-obj-code      as integer   no-undo .
     1423     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1424     define variable v-cntxt-is-admin      as logical   no-undo .
     1425   define variable v-db-num like ub.db.db-num no-undo.
     1426   define variable v-title-0 as character no-undo.
     1427   define variable off-option as character no-undo.
     1428   define variable print-option as character no-undo.
     1429   define variable v-log-file as character no-undo init "oldscode.log".
     1430   define variable v-err-file as character no-undo init "oldscode.err".
     1431   define variable loc#log as logical no-undo.
     1432   define variable gds-rec as recid no-undo .
     1433   define temp-table temp-mark no-undo
     1434   field gds-code like ub.goods.gds-code
     1435   index pi is primary unique
     1436   gds-code.
     1437   FUNCTION get-title RETURNS CHARACTER
     1438     ( p-in-date as date, p-fact-qnty as decimal, p-on-off-state as logical )  FORWARD.
     1439   DEFINE MENU MENU-B-off
     1440          MENU-ITEM m-one          LABEL "Один код"
     1441          MENU-ITEM m-all          LABEL "Все коды в этом списке"
     1442          MENU-ITEM m-mark         LABEL "Отмеченные коды в этом списке".
     1443   DEFINE MENU MENU-B-print
     1444          MENU-ITEM m-list         LABEL "Список неиспользуемых кодов для весов"
     1445          MENU-ITEM m-protocol     LABEL "Протокол результатов работы"
     1446          MENU-ITEM m-errors       LABEL "Протокол ошибок".
     1447   DEFINE BUTTON B-codes
     1448        LABEL "&Коды"
     1449        SIZE 10 BY 1
     1450        BGCOLOR 8 .
     1451   DEFINE BUTTON B-goods
     1452        LABEL "&Товар"
     1453        SIZE 10 BY 1.
     1454   DEFINE BUTTON B-Help
     1455        LABEL "Помо&щь"
     1456        SIZE 3 BY 1
     1457        BGCOLOR 8 .
     1458   DEFINE BUTTON b-mark
     1459        LABEL "&*"
     1460        SIZE 3 BY 1.
     1461   DEFINE BUTTON B-off
     1462        LABEL "В&ыключить и/или Удалить"
     1463        SIZE 30 BY 1.
     1464   DEFINE BUTTON B-print
     1465        LABEL "Пе&чать"
     1466        SIZE 3 BY 1.
     1467   DEFINE BUTTON B-query
     1468        LABEL "&Отобрать"
     1469        SIZE 10 BY 1.
     1470   DEFINE BUTTON b-quit AUTO-END-KEY
     1471        LABEL "&Выход"
     1472        SIZE 10 BY 1
     1473        BGCOLOR 8 .
     1474   DEFINE VARIABLE F-log-file AS CHARACTER FORMAT "X(256)":U
     1475        LABEL "Лог"
     1476         VIEW-AS TEXT
     1477        SIZE 50.9 BY .67 NO-UNDO.
     1478   DEFINE VARIABLE v-all-count AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1479        LABEL "Всего"
     1480         VIEW-AS TEXT
     1481        SIZE 15 BY .67 TOOLTIP "Количество найденных кодов, удовлетворяющих заданному условию"
     1482        FGCOLOR 10  NO-UNDO.
     1483   DEFINE VARIABLE v-fact-qnty AS DECIMAL FORMAT "->>>,>>>,>>9.99":U INITIAL 0
     1484        LABEL "Max факт.кол-во на объекте <="
     1485        VIEW-AS FILL-IN
     1486        SIZE 10 BY 1 TOOLTIP "Факт.кол-во товара по всем объектам текущей БД" NO-UNDO.
     1487   DEFINE VARIABLE v-in-date AS DATE FORMAT "99/99/9999":U
     1488        LABEL "Дата посл.прихода<="
     1489        VIEW-AS FILL-IN
     1490        SIZE 12 BY 1 TOOLTIP "Дата посл.прихода на объект текущей БД" NO-UNDO.
     1491   DEFINE VARIABLE v-mark-count AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1492        LABEL "Отмечено к выключению"
     1493         VIEW-AS TEXT
     1494        SIZE 14.3 BY .67 TOOLTIP "Количество отмеченных кодов"
     1495        FGCOLOR 10  NO-UNDO.
     1496   DEFINE VARIABLE rs-on-off-state AS LOGICAL INITIAL yes
     1497        VIEW-AS RADIO-SET VERTICAL
     1498        RADIO-BUTTONS
     1499             "Включенные", yes,
     1500   "Выключенные", no,
     1501   "Все", ?
     1502        SIZE 13 BY 2 NO-UNDO.
     1503   DEFINE RECTANGLE RECT-b-query
     1504        EDGE-PIXELS 2 GRAPHIC-EDGE
     1505        SIZE 12 BY 1
     1506        BGCOLOR 12 FGCOLOR 12 .
     1507   DEFINE VARIABLE v-tocd AS LOGICAL INITIAL yes
     1508        LABEL "На кассу"
     1509        VIEW-AS TOGGLE-BOX
     1510        SIZE 14.8 BY 1 NO-UNDO.
     1511   DEFINE QUERY BR-goods FOR
     1512         temp-codes SCROLLING.
     1513   DEFINE BROWSE BR-goods
     1514     QUERY BR-goods DISPLAY
     1515         b-str COLUMN-LABEL "Код" FORMAT "X(6)":U
     1516         temp-codes.bc-on COLUMN-LABEL "Вкл" FORMAT "+/":U
     1517         temp-codes.is-mark COLUMN-LABEL "*" FORMAT "*/-":U
     1518         temp-codes.is-glob COLUMN-LABEL "Глоб" FORMAT "+/":U
     1519         temp-codes.plu-type COLUMN-LABEL "Тип" FORMAT "X(3)":U
     1520         temp-codes.artic FORMAT "X(16)":U
     1521         temp-codes.gds-code FORMAT "999999999":U
     1522         temp-codes.in-date COLUMN-LABEL "Посл.ПН!в тек.БД" FORMAT "99/99/9999":U
     1523         temp-codes.fact-qnty COLUMN-LABEL "Факт (кол-во)!на всех объ. БД" FORMAT "->>,>>>,>>9.<<<":U
     1524         temp-codes.gds-name COLUMN-LABEL "Название" FORMAT "X(20)":U
     1525         temp-codes.free-qnty COLUMN-LABEL "Свободно (кол-во)!на всех объ. БД" FORMAT "->>,>>>,>>9.<<<":U
     1526         temp-codes.prod-type + string(temp-codes.prod-code) COLUMN-LABEL "П-ль" FORMAT "X(12)":U
     1527         temp-codes.prod-name COLUMN-LABEL "Производитель" FORMAT "X(20)":U
     1528         temp-codes.obj-type + string(temp-codes.obj-code) COLUMN-LABEL "Объект!посл.ПН" FORMAT "X(8)":U
     1529         temp-codes.max-fact-qnty COLUMN-LABEL "Max факт (кол-во)!на объекте БД" FORMAT "->>,>>>,>>9.<<<":U
     1530         temp-codes.max-fact-qnty-obj-type + string(temp-codes.max-fact-qnty-obj-code) COLUMN-LABEL "Объект max!факт кол." FORMAT "X(8)":U
     1531       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.77.
     1532   DEFINE FRAME Dialog-Frame
     1533        b-quit AT ROW 1 COL 1
     1534        B-query AT ROW 1 COL 12
     1535        b-mark AT ROW 1 COL 32
     1536        B-off AT ROW 1 COL 41
     1537        B-goods AT ROW 1 COL 71
     1538        B-codes AT ROW 1 COL 81
     1539        B-print AT ROW 1 COL 92
     1540        B-Help AT ROW 1 COL 95
     1541        rs-on-off-state AT ROW 2 COL 80 NO-LABEL WIDGET-ID 4
     1542        v-in-date AT ROW 4 COL 3.3
     1543        v-fact-qnty AT ROW 4 COL 41.3
     1544        v-tocd AT ROW 4 COL 83.8
     1545        BR-goods AT ROW 5.27 COL 1
     1546        v-all-count AT ROW 2 COL 22.3 COLON-ALIGNED
     1547        F-log-file AT ROW 3 COL 5 COLON-ALIGNED
     1548        v-mark-count AT ROW 3 COL 22.3 COLON-ALIGNED
     1549        RECT-b-query AT ROW 1 COL 11
     1550        SPACE(76.24) SKIP(20.04)
     1551       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1552            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1553            TITLE "Неиспользуемые коды для весов"
     1554            CANCEL-BUTTON b-quit.
     1555   ASSIGN
     1556          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1557          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1558   ASSIGN
     1559          b-mark:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1560   ASSIGN
     1561          B-off:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-off:HANDLE.
     1562   ASSIGN
     1563          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     1564   ASSIGN
     1565          RECT-b-query:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1566   ON END-ERROR OF FRAME Dialog-Frame
     1567   OR ENDKEY OF FRAME Dialog-Frame DO:
     1568      run gbl/markqwa.p (
     1569                              input b-mark:sensitive
     1570                             , input (if v-mark-count = 0 then "":U else string(v-mark-count))) no-error.
     1571       if error-status:error then return no-apply.
     1572       END.
     1573   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1574   DO:
     1575     APPLY "END-ERROR":U TO SELF.
     1576   END.
     1577   ON CHOOSE OF B-codes IN FRAME Dialog-Frame
     1578   DO:
     1579    define variable v-main-b-code like ub.bar-code.b-code no-undo.
     1580    if not available temp-codes then return no-apply.
     1581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1582     (input  temp-codes.gds-code
     1583     ,input  ?
     1584     ,output v-main-b-code
     1585     ) no-error .
     1586    if error-status:error then return no-apply.
     1587    run ref/alt-bc.w (input parparentproc, input v-cntxt-obj-type, v-cntxt-obj-code, v-main-b-code).
     1588   END.
     1589   ON CHOOSE OF B-goods IN FRAME Dialog-Frame
     1590   DO:
     1591     APPLY "F9" to frame Dialog-Frame.
     1592   END.
     1593   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1594   DO:
     1595     run proc-b-mark in this-procedure no-error.
     1596       if error-status:error then do:
     1597           return no-apply.
     1598       end.
     1599   END.
     1600   ON CHOOSE OF B-off IN FRAME Dialog-Frame
     1601   DO:
     1602     run proc-b-off in this-procedure  no-error.
     1603     if error-status:error then return no-apply.
     1604     run openBr in this-procedure.
     1605   END.
     1606   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1607   DO:
     1608     run proc-b-print in this-procedure no-error.
     1609      if error-status:error then do:
     1610       assign
     1611       print-option = "":U
     1612       .
     1613       return no-apply.
     1614      end.
     1615   END.
     1616   ON CHOOSE OF B-query IN FRAME Dialog-Frame
     1617   DO:
     1618     assign
     1619     v-in-date
     1620     v-fact-qnty
     1621     rs-on-off-state
     1622     .
     1623     run assign-filter in this-procedure ( input v-in-date
     1624                                          ,input v-fact-qnty
     1625                                          ,input rs-on-off-state) no-error.
     1626     run set-query in this-procedure (no).
     1627     run openBr in this-procedure.
     1628   END.
     1629   ON INSERT-MODE OF BR-goods IN FRAME Dialog-Frame
     1630   DO:
     1631     run proc-b-mark in this-procedure no-error.
     1632       if error-status:error then do:
     1633           return no-apply.
     1634       end.
     1635   END.
     1636   ON CHOOSE OF MENU-ITEM m-all
     1637   DO:
     1638       assign
     1639      off-option = "all":U.
     1640      run proc-b-off in this-procedure no-error.
     1641      if error-status:error then do:
     1642       assign
     1643       off-option = "":U
     1644       .
     1645       return no-apply.
     1646      end.
     1647   END.
     1648   ON CHOOSE OF MENU-ITEM m-errors
     1649   DO:
     1650      assign
     1651      print-option = "errors":U.
     1652      run proc-b-print in this-procedure no-error.
     1653      if error-status:error then do:
     1654       assign
     1655       print-option = "":U
     1656       .
     1657       return no-apply.
     1658      end.
     1659   END.
     1660   ON CHOOSE OF MENU-ITEM m-list
     1661   DO:
     1662      assign
     1663      print-option = "list":U.
     1664      run proc-b-print in this-procedure no-error.
     1665      if error-status:error then do:
     1666       assign
     1667       print-option = "":U
     1668       .
     1669       return no-apply.
     1670      end.
     1671   END.
     1672   ON CHOOSE OF MENU-ITEM m-mark
     1673   DO:
     1674     assign
     1675      off-option = "mark":U.
     1676      run proc-b-off in this-procedure no-error.
     1677      if error-status:error then do:
     1678       assign
     1679       off-option = "":U
     1680       .
     1681       return no-apply.
     1682      end.
     1683   END.
     1684   ON CHOOSE OF MENU-ITEM m-one
     1685   DO:
     1686     assign
     1687      off-option = "one":U.
     1688      run proc-b-off in this-procedure no-error.
     1689      if error-status:error then do:
     1690       assign
     1691       off-option = "":U
     1692       .
     1693       return no-apply.
     1694      end.
     1695   END.
     1696   ON CHOOSE OF MENU-ITEM m-protocol
     1697   DO:
     1698     assign
     1699      print-option = "protocol":U.
     1700      run proc-b-print in this-procedure no-error.
     1701      if error-status:error then do:
     1702       assign
     1703       print-option = "":U
     1704       .
     1705       return no-apply.
     1706      end.
     1707   END.
     1708   ON VALUE-CHANGED OF rs-on-off-state IN FRAME Dialog-Frame
     1709   DO:
     1710     ASSIGN
     1711     rs-on-off-state.
     1712     run Set-Query in this-procedure (yes).
     1713     run assign-filter in this-procedure ( input v-in-date
     1714                                           ,input v-fact-qnty
     1715                                           ,input rs-on-off-state
     1716                                           ) no-error.
     1717     if error-status:error then return no-apply.
     1718   END.
     1719   ON LEAVE OF v-fact-qnty IN FRAME Dialog-Frame
     1720   DO:
     1721    if
     1722       v-fact-qnty:screen-value <> string(v-fact-qnty) then do:
     1723           run Set-Query in this-procedure(yes).
     1724       end.
     1725   END.
     1726   ON RETURN OF v-fact-qnty IN FRAME Dialog-Frame
     1727   DO:
     1728      assign
     1729      v-fact-qnty.
     1730      run assign-filter in this-procedure ( input v-in-date
     1731                                           ,input v-fact-qnty
     1732                                           ,input rs-on-off-state
     1733                                           ) no-error.
     1734      if error-status:error then return no-apply.
     1735    Run OpenBr.
     1736   END.
     1737   ON LEAVE OF v-in-date IN FRAME Dialog-Frame
     1738   DO:
     1739     if
     1740       v-in-date:screen-value <> string(v-in-date) then do:
     1741           run Set-Query in this-procedure (yes).
     1742       end.
     1743   END.
     1744   ON RETURN OF v-in-date IN FRAME Dialog-Frame
     1745   DO:
     1746     assign
     1747      v-in-date.
     1748      run assign-filter in this-procedure ( input v-in-date
     1749                                           ,input v-fact-qnty
     1750                                           ,input rs-on-off-state
     1751                                           ) no-error.
     1752      if error-status:error then return no-apply.
     1753    Run OpenBr.
     1754   END.
     1755   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1756   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1757   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1758   on help of frame Dialog-Frame
     1759   do:
     1760     run gbl/app_help.p
     1761       (input this-procedure :file-name
     1762       ,input ''
     1763       ,input ?
     1764       ) no-error.
     1765     if error-status :error then do:
     1766       message
     1767         "Ошибка при вызове помощи"
     1768         error-status :get-message(1)
     1769         view-as alert-box .
     1770     end.
     1771   end.
     1772   run minbtn-set in this-procedure .
     1773   on choose of b-help in frame Dialog-Frame
     1774   do:
     1775     apply "help":u to frame Dialog-Frame .
     1776   end.
     1777   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1778   procedure minbtn-set :
     1779       do
     1780           on error undo, return error return-value
     1781           :
     1782           define variable ii              as integer       no-undo .
     1783           define variable fh              as widget-handle no-undo .
     1784           define variable hh              as widget-handle no-undo .
     1785           define variable v-h             as handle        extent 4 no-undo .
     1786           define variable v-name-button   as character     no-undo .
     1787           define variable v-help-old-x    as decimal       no-undo .
     1788           define variable v-help-old-y    as decimal       no-undo .
     1789           define variable v-help-old-size as decimal       no-undo .
     1790           define variable v-frame-width   as decimal       no-undo .
     1791           define variable jj              as integer       no-undo .
     1792           do
     1793               on error undo, return error
     1794               :
     1795               assign
     1796                   v-frame-width = frame Dialog-Frame:width - 0.3
     1797                   fh            = frame Dialog-Frame:first-child
     1798                   hh            = fh:first-child
     1799                   ii            = 1
     1800                   .
     1801               do while valid-handle(hh):
     1802                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1803                   do:
     1804                       case lc(hh:name) :
     1805                           when "b-help" then
     1806                               do:
     1807                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1808                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1809                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1810                                   hh:TOOLTIP = "Помощь" .
     1811                                   v-help-old-x = hh:column .
     1812                                   v-help-old-y = hh:row    .
     1813                                   v-help-old-size = hh:width .
     1814                                   hh:width-chars = 2.5 .
     1815                               end.
     1816                           when "b-print" then
     1817                               do:
     1818                                   hh:load-image("cmp/b-print.bmp":u) .
     1819                                   hh:TOOLTIP = "Печать" .
     1820                                   v-h[ii] = hh:handle .
     1821                                   ii = ii + 1 .
     1822                                   hh:width-chars = 3 .
     1823                               end.
     1824                           when "b-history" or
     1825                           when "b-hist" then
     1826                               do:
     1827                                   hh:load-image("cmp/b-hist.bmp":u) .
     1828                                   hh:TOOLTIP = "История" .
     1829                                   v-h[ii] = hh:handle .
     1830                                   ii = ii + 1 .
     1831                                   hh:width-chars = 3 .
     1832                               end.
     1833                           when "b-sch" then
     1834                               do:
     1835                                   hh:load-image("cmp/b-sch.bmp":u) .
     1836                                   hh:TOOLTIP = "Установка Фильтра" .
     1837                                   v-h[ii] = hh:handle .
     1838                                   ii = ii + 1 .
     1839                                   hh:width-chars = 3 .
     1840                               end.
     1841                           when "b-hist-user" then
     1842                               do:
     1843                                   hh:load-image("cmp/b-hist.bmp":u) .
     1844                                   hh:TOOLTIP = "История пользователя" .
     1845                                   ii = ii + 1 .
     1846                               end.
     1847                       end case.
     1848                   end.
     1849                   hh = hh:next-sibling.
     1850               end.
     1851               b-help:column = v-frame-width - b-help:width-chars.
     1852               jj = 0.
     1853               repeat ii = 4 to 1 by -1 :
     1854                   if valid-handle (v-h[ii] ) then
     1855                   do:
     1856                       jj  = jj + 1 .
     1857                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1858                       v-h[ii]:row    = v-help-old-y .
     1859                   end.
     1860               end.
     1861           end.
     1862       end.
     1863   end procedure.
     1864   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1865   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1866   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1867   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1868   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1869   define variable v-diasize-current-frame-height as decimal   no-undo .
     1870   define variable v-diasize-change-size          as logical   no-undo .
     1871   define variable v-diasize-resize-button        as handle    no-undo .
     1872   define variable v-diasize-wndmax               as logical   no-undo .
     1873   define variable v-diasize-wndstore             as logical   no-undo .
     1874   define variable v-diasize-proc-name            as character no-undo .
     1875   define variable v-diasize-browse-handle        as handle    no-undo .
     1876   define variable v-diasize-browse-number        as integer   no-undo .
     1877   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1878   define temp-table temp-diasize-handle no-undo
     1879     field handle-value  as handle
     1880     field save-position as decimal
     1881     index xpk is primary unique handle-value
     1882     .
     1883   define temp-table temp-browse-handle no-undo
     1884     field browse-type   as character
     1885     field browse-number as integer
     1886     field browse-handle as handle
     1887     field original-size as decimal
     1888     index xpk is primary unique browse-type browse-number
     1889     index xie browse-type browse-handle
     1890   .
     1891   procedure diasize_change-height :
     1892     define input  parameter p-change-value  as decimal   no-undo .
     1893     define input  parameter p-move-resize   as logical   no-undo .
     1894     define variable v-field-group-handle    as handle    no-undo .
     1895     define variable v-object-handle         as handle    no-undo .
     1896     define variable v-frame-height          as decimal   no-undo .
     1897     define variable v-frame-virtual-height  as decimal   no-undo .
     1898     define variable v-browse-height         as decimal   no-undo .
     1899     define variable v-window-height         as decimal   no-undo .
     1900     define variable v-window-virtual-height as decimal   no-undo .
     1901     define variable v-change-sign           as integer   no-undo .
     1902     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1903     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1904     if p-change-value > 0
     1905     then do:
     1906       if frame Dialog-Frame :height + p-change-value
     1907           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1908       then do:
     1909         assign
     1910           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1911                           - (frame Dialog-Frame :height-chars)
     1912         .
     1913         if p-change-value <= 0
     1914         then do:
     1915           run diasize_position-resize-button in this-procedure .
     1916           return .
     1917         end.
     1918       end.
     1919     end.
     1920     if p-change-value < 0
     1921     then do:
     1922       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1923       then do:
     1924         assign
     1925           p-change-value = v-diasize-orig-frame-height
     1926                          - (frame Dialog-Frame :height-chars)
     1927         .
     1928         if p-change-value >= 0
     1929         then do:
     1930           run diasize_position-resize-button in this-procedure .
     1931           return .
     1932         end.
     1933       end.
     1934     end.
     1935     if p-change-value >= 0
     1936     then do:
     1937       assign
     1938         v-change-sign = 1
     1939       .
     1940     end.
     1941     else do:
     1942       assign
     1943         v-change-sign = -1
     1944       .
     1945     end.
     1946     assign
     1947       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1948     .
     1949     if p-change-value = 0
     1950     then do:
     1951       run diasize_position-resize-button in this-procedure .
     1952       return .
     1953     end.
     1954     move_block:
     1955     do
     1956     on error undo move_block, retry move_block
     1957     :
     1958       if retry
     1959       then do:
     1960         do
     1961         on error undo move_block, leave move_block
     1962         :
     1963           if p-change-value > 0
     1964           then do:
     1965             for each buf_temp-diasize-handle
     1966             on error undo, next
     1967             :
     1968               assign
     1969                 v-object-handle = buf_temp-diasize-handle.handle-value
     1970               .
     1971               if v-object-handle <> v-diasize-resize-button
     1972               then do:
     1973                 assign
     1974                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1975                 .
     1976               end.
     1977             end.
     1978             assign
     1979               v-diasize-browse-handle :height = v-browse-height
     1980             .
     1981             for each buf_temp-browse-handle
     1982               where buf_temp-browse-handle.browse-type = 'height':u
     1983             on error undo, next
     1984             :
     1985               assign
     1986                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1987               .
     1988             end.
     1989             assign
     1990               frame Dialog-Frame :height = v-frame-height
     1991             .
     1992             if frame Dialog-Frame :scrollable = true
     1993             then do:
     1994               assign
     1995                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1996               .
     1997             end.
     1998             run diasize_position-resize-button in this-procedure .
     1999           end.
     2000           else do:
     2001             if frame Dialog-Frame :scrollable = true
     2002             then do:
     2003               assign
     2004                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2005               .
     2006             end.
     2007             assign
     2008               frame Dialog-Frame :height = v-frame-height
     2009             .
     2010             assign
     2011               v-diasize-browse-handle :height = v-browse-height
     2012             .
     2013             for each buf_temp-browse-handle
     2014               where buf_temp-browse-handle.browse-type = 'height':u
     2015             on error undo, next
     2016             :
     2017               assign
     2018                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2019               .
     2020             end.
     2021             for each buf_temp-diasize-handle
     2022             on error undo, next
     2023             :
     2024               assign
     2025                 v-object-handle = buf_temp-diasize-handle.handle-value
     2026               .
     2027               if v-object-handle <> v-diasize-resize-button
     2028               then do:
     2029                 assign
     2030                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2031                 .
     2032               end.
     2033             end.
     2034             run diasize_position-resize-button in this-procedure .
     2035           end.
     2036           assign
     2037             v-diasize-change-size = false
     2038           .
     2039           leave move_block .
     2040         end.
     2041       end.
     2042       assign
     2043         v-diasize-need-full-display = true
     2044       .
     2045       if v-diasize-change-size = false
     2046       then do:
     2047         assign
     2048           v-diasize-change-size = true
     2049         .
     2050       end.
     2051       else do:
     2052         return .
     2053       end.
     2054       assign
     2055         v-frame-height = frame Dialog-Frame :height
     2056         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2057         v-browse-height = v-diasize-browse-handle :height
     2058       .
     2059       for each buf_temp-browse-handle
     2060         where buf_temp-browse-handle.browse-type = 'height':u
     2061       :
     2062         assign
     2063           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2064         .
     2065       end.
     2066       for each buf_temp-diasize-handle
     2067       :
     2068         delete buf_temp-diasize-handle .
     2069       end.
     2070       assign
     2071         v-field-group-handle = frame Dialog-Frame :first-child
     2072       .
     2073       do while valid-handle(v-field-group-handle)
     2074       :
     2075         assign
     2076           v-object-handle = v-field-group-handle :first-child
     2077         .
     2078         do while valid-handle(v-object-handle)
     2079         :
     2080           if  v-object-handle <> v-diasize-browse-handle :handle
     2081           and can-query(v-object-handle, "row")
     2082           and can-query(v-object-handle, "height")
     2083           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2084           then do:
     2085             find first buf_temp-browse-handle
     2086               where buf_temp-browse-handle.browse-type   = 'height':u
     2087                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2088               no-error .
     2089             if available buf_temp-browse-handle
     2090             then do:
     2091             end.
     2092             else do:
     2093               create buf_temp-diasize-handle .
     2094               assign
     2095                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2096                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2097               .
     2098             end.
     2099           end.
     2100           assign
     2101             v-object-handle = v-object-handle :next-sibling
     2102           .
     2103         end.
     2104         assign
     2105           v-field-group-handle = v-field-group-handle :next-sibling
     2106         .
     2107       end.
     2108       do with frame Dialog-Frame
     2109       :
     2110         hide v-diasize-resize-button .
     2111         assign
     2112           v-diasize-resize-button :row    = 1
     2113           v-diasize-resize-button :column = 1
     2114         .
     2115       end.
     2116       if p-change-value > 0
     2117       then do:
     2118         if frame Dialog-Frame :scrollable = true
     2119         then do:
     2120           assign
     2121             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2122             no-error .
     2123           if error-status :error
     2124           or error-status :get-message(1) <> ""
     2125           then do:
     2126             undo move_block, retry move_block .
     2127           end.
     2128         end.
     2129         assign
     2130           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2131           no-error .
     2132         if error-status :error
     2133         or error-status :get-message(1) <> ""
     2134         then do:
     2135           undo move_block, retry move_block .
     2136         end.
     2137         assign
     2138           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2139           no-error .
     2140         if error-status :error
     2141         or error-status :get-message(1) <> ""
     2142         then do:
     2143           undo move_block, retry move_block .
     2144         end.
     2145         for each buf_temp-browse-handle
     2146           where buf_temp-browse-handle.browse-type = 'height':u
     2147         on error undo move_block, retry move_block
     2148         :
     2149           assign
     2150             buf_temp-browse-handle.browse-handle :height
     2151               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2152             no-error .
     2153           if error-status :error
     2154           or error-status :get-message(1) <> ""
     2155           then do:
     2156             undo move_block, retry move_block .
     2157           end.
     2158         end.
     2159         for each buf_temp-diasize-handle
     2160         on error undo move_block, retry move_block
     2161         :
     2162           assign
     2163             v-object-handle = buf_temp-diasize-handle.handle-value
     2164           .
     2165           if v-object-handle <> v-diasize-resize-button
     2166           then do:
     2167             assign
     2168               v-object-handle :row = v-object-handle :row + p-change-value
     2169               no-error .
     2170             if error-status :error
     2171             or error-status :get-message(1) <> ""
     2172             then do:
     2173               undo move_block, retry move_block .
     2174             end.
     2175           end.
     2176         end.
     2177       end.
     2178       else do:
     2179         for each buf_temp-diasize-handle
     2180         on error undo move_block, retry move_block
     2181         :
     2182           assign
     2183             v-object-handle = buf_temp-diasize-handle.handle-value
     2184           .
     2185           if v-object-handle <> v-diasize-resize-button
     2186           then do:
     2187             assign
     2188               v-object-handle :row = v-object-handle :row + p-change-value
     2189               no-error .
     2190             if error-status :error
     2191             or error-status :get-message(1) <> ""
     2192             then do:
     2193               undo move_block, retry move_block .
     2194             end.
     2195           end.
     2196         end.
     2197         assign
     2198           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2199           no-error .
     2200         if error-status :error
     2201         or error-status :get-message(1) <> ""
     2202         then do:
     2203           undo move_block, retry move_block .
     2204         end.
     2205         for each buf_temp-browse-handle
     2206           where buf_temp-browse-handle.browse-type = 'height':u
     2207         on error undo move_block, retry move_block
     2208         :
     2209           assign
     2210             buf_temp-browse-handle.browse-handle :height
     2211               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2212             no-error .
     2213           if error-status :error
     2214           or error-status :get-message(1) <> ""
     2215           then do:
     2216             undo move_block, retry move_block .
     2217           end.
     2218         end.
     2219         assign
     2220           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2221           no-error .
     2222         if error-status :error
     2223         or error-status :get-message(1) <> ""
     2224         then do:
     2225           undo move_block, retry move_block .
     2226         end.
     2227         if frame Dialog-Frame :scrollable = true
     2228         then do:
     2229           assign
     2230             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2231             no-error .
     2232           if error-status :error
     2233           or error-status :get-message(1) <> ""
     2234           then do:
     2235             undo move_block, retry move_block .
     2236           end.
     2237         end.
     2238       end.
     2239       if p-move-resize = true
     2240       then do:
     2241         run diasize_position-resize-button in this-procedure .
     2242       end.
     2243       if v-diasize-wndstore = true
     2244       then do:
     2245         if connected("ub") = true
     2246         then do:
     2247           define variable v-cntxt-db-num        as integer   no-undo .
     2248           define variable v-cntxt-userid        as character no-undo .
     2249           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2250                                             , OUTPUT v-cntxt-userid
     2251                                             ) .
     2252           run gbl/wndsizew.p
     2253             (input  v-cntxt-db-num
     2254             ,input  v-cntxt-userid
     2255             ,input  v-diasize-proc-name
     2256             ,input  'height':u
     2257             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2258             ) .
     2259         end.
     2260       end.
     2261     end.
     2262     assign
     2263       v-diasize-change-size = false
     2264     .
     2265   end procedure.
     2266   procedure diasize_set-height :
     2267     define input  parameter p-new-height  as decimal   no-undo .
     2268     define input  parameter p-move-resize as logical   no-undo .
     2269     do
     2270     on error undo, return error return-value
     2271     :
     2272       run diasize_change-height in this-procedure
     2273         (input  (p-new-height - frame Dialog-Frame :height)
     2274         ,input  p-move-resize
     2275         ) .
     2276     end.
     2277   end procedure.
     2278   procedure diasize_change-width :
     2279     define input  parameter p-change-value as decimal   no-undo .
     2280     define input  parameter p-move-resize  as logical   no-undo .
     2281     define variable v-field-group-handle   as handle    no-undo .
     2282     define variable v-object-handle        as handle    no-undo .
     2283     define variable v-frame-width          as decimal   no-undo .
     2284     define variable v-frame-virtual-width  as decimal   no-undo .
     2285     define variable v-browse-width         as decimal   no-undo .
     2286     define variable v-window-width         as decimal   no-undo .
     2287     define variable v-window-virtual-width as decimal   no-undo .
     2288     define variable v-change-sign          as integer   no-undo .
     2289     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2290     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2291     if p-change-value > 0
     2292     then do:
     2293       if frame Dialog-Frame :width + p-change-value >
     2294           session :width-chars
     2295       then do:
     2296         assign
     2297           p-change-value = session :width-chars - frame Dialog-Frame :width
     2298         .
     2299         if p-change-value <= 0
     2300         then do:
     2301           run diasize_position-resize-button in this-procedure .
     2302           return .
     2303         end.
     2304       end.
     2305     end.
     2306     if p-change-value < 0
     2307     then do:
     2308       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2309       then do:
     2310         assign
     2311           p-change-value = v-diasize-orig-frame-width
     2312                          - frame Dialog-Frame :width
     2313         .
     2314         if p-change-value >= 0
     2315         then do:
     2316           run diasize_position-resize-button in this-procedure .
     2317           return .
     2318         end.
     2319       end.
     2320     end.
     2321     if p-change-value >= 0
     2322     then do:
     2323       assign
     2324         v-change-sign = 1
     2325       .
     2326     end.
     2327     else do:
     2328       assign
     2329         v-change-sign = -1
     2330       .
     2331     end.
     2332     assign
     2333       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2334     .
     2335     if p-change-value = 0
     2336     then do:
     2337       run diasize_position-resize-button in this-procedure .
     2338       return .
     2339     end.
     2340     move_block:
     2341     do
     2342     on error undo move_block, leave move_block
     2343     :
     2344       if retry
     2345       then do:
     2346         do
     2347         on error undo move_block, leave move_block
     2348         :
     2349           if p-change-value > 0
     2350           then do:
     2351             for each buf_temp-diasize-handle
     2352             on error undo, next
     2353             :
     2354               assign
     2355                 v-object-handle = buf_temp-diasize-handle.handle-value
     2356               .
     2357               if v-object-handle <> v-diasize-resize-button
     2358               then do:
     2359                 assign
     2360                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2361                 .
     2362               end.
     2363             end.
     2364             assign
     2365               v-diasize-browse-handle :width = v-browse-width
     2366             .
     2367             for each buf_temp-browse-handle
     2368               where buf_temp-browse-handle.browse-type = 'width':u
     2369             on error undo, next
     2370             :
     2371               assign
     2372                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2373               .
     2374             end.
     2375             assign
     2376               frame Dialog-Frame :width = v-frame-width
     2377             .
     2378             if frame Dialog-Frame :scrollable = true
     2379             then do:
     2380               assign
     2381                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2382               .
     2383             end.
     2384             run diasize_position-resize-button in this-procedure .
     2385           end.
     2386           else do:
     2387             if frame Dialog-Frame :scrollable = true
     2388             then do:
     2389               assign
     2390                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2391               .
     2392             end.
     2393             assign
     2394               frame Dialog-Frame :width = v-frame-width
     2395             .
     2396             for each buf_temp-browse-handle
     2397               where buf_temp-browse-handle.browse-type = 'width':u
     2398             on error undo, next
     2399             :
     2400               assign
     2401                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2402               .
     2403             end.
     2404             assign
     2405               v-diasize-browse-handle :width = v-browse-width
     2406             .
     2407             for each buf_temp-diasize-handle
     2408             on error undo, next
     2409             :
     2410               assign
     2411                 v-object-handle = buf_temp-diasize-handle.handle-value
     2412               .
     2413               if v-object-handle <> v-diasize-resize-button
     2414               then do:
     2415                 assign
     2416                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2417                 .
     2418               end.
     2419             end.
     2420             run diasize_position-resize-button in this-procedure .
     2421           end.
     2422           assign
     2423             v-diasize-change-size = false
     2424           .
     2425           leave move_block .
     2426         end.
     2427       end.
     2428       assign
     2429         v-diasize-need-full-display = true
     2430       .
     2431       if v-diasize-change-size = false
     2432       then do:
     2433         assign
     2434           v-diasize-change-size = true
     2435         .
     2436       end.
     2437       else do:
     2438         return .
     2439       end.
     2440       assign
     2441         v-frame-width = frame Dialog-Frame :width
     2442         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2443         v-browse-width = v-diasize-browse-handle :width
     2444       .
     2445       for each buf_temp-browse-handle
     2446         where buf_temp-browse-handle.browse-type = 'width':u
     2447       :
     2448         assign
     2449           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2450         .
     2451       end.
     2452       for each buf_temp-diasize-handle
     2453       :
     2454         delete buf_temp-diasize-handle .
     2455       end.
     2456       assign
     2457         v-field-group-handle = frame Dialog-Frame :first-child
     2458       .
     2459       do while valid-handle(v-field-group-handle)
     2460       :
     2461         assign
     2462           v-object-handle = v-field-group-handle :first-child
     2463         .
     2464         do while valid-handle(v-object-handle)
     2465         :
     2466           if  v-object-handle <> v-diasize-browse-handle :handle
     2467           and v-object-handle <> v-diasize-resize-button
     2468           and can-query(v-object-handle, "row")
     2469           and can-query(v-object-handle, "height")
     2470           and ( v-object-handle :col + v-object-handle :width
     2471                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2472               )
     2473           then do:
     2474             find first buf_temp-browse-handle
     2475               where buf_temp-browse-handle.browse-type   = 'width':u
     2476                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2477               no-error .
     2478             if available buf_temp-browse-handle
     2479             then do:
     2480             end.
     2481             else do:
     2482               create buf_temp-diasize-handle .
     2483               assign
     2484                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2485                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2486               .
     2487             end.
     2488           end.
     2489           assign
     2490             v-object-handle = v-object-handle :next-sibling
     2491           .
     2492         end.
     2493         assign
     2494           v-field-group-handle = v-field-group-handle :next-sibling
     2495         .
     2496       end.
     2497       do with frame Dialog-Frame
     2498       :
     2499         hide v-diasize-resize-button .
     2500         v-diasize-resize-button :row = 1.
     2501         v-diasize-resize-button :column = 1.
     2502       end.
     2503       if p-change-value > 0
     2504       then do:
     2505         if frame Dialog-Frame :scrollable = true
     2506         then do:
     2507           assign
     2508             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2509             no-error .
     2510           if error-status :error
     2511           or error-status :get-message(1) <> ""
     2512           then do:
     2513             undo move_block, retry move_block.
     2514           end.
     2515         end.
     2516         assign
     2517           frame Dialog-Frame :width = v-frame-width + p-change-value
     2518           no-error .
     2519         if error-status :error
     2520         or error-status :get-message(1) <> ""
     2521         then do:
     2522           undo move_block, retry move_block.
     2523         end.
     2524         assign
     2525           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2526         no-error .
     2527         if error-status :error
     2528         or error-status :get-message(1) <> ""
     2529         then do:
     2530           undo move_block, retry move_block.
     2531         end.
     2532         for each buf_temp-browse-handle
     2533           where buf_temp-browse-handle.browse-type = 'width':u
     2534         on error undo move_block, retry move_block
     2535         :
     2536           assign
     2537             buf_temp-browse-handle.browse-handle :width
     2538               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2539             no-error .
     2540           if error-status :error
     2541           or error-status :get-message(1) <> ""
     2542           then do:
     2543             undo move_block, retry move_block .
     2544           end.
     2545         end.
     2546         for each buf_temp-diasize-handle
     2547         on error undo move_block, retry move_block
     2548         :
     2549           assign
     2550             v-object-handle = buf_temp-diasize-handle.handle-value
     2551           .
     2552           if v-object-handle <> v-diasize-resize-button
     2553           then do:
     2554             assign
     2555               v-object-handle :col = v-object-handle :col + p-change-value
     2556               no-error .
     2557             if error-status :error
     2558             or error-status :get-message(1) <> ""
     2559             then do:
     2560               undo move_block, retry move_block .
     2561             end.
     2562           end.
     2563         end.
     2564       end.
     2565       else do:
     2566         for each buf_temp-diasize-handle
     2567         on error undo move_block, retry move_block
     2568         :
     2569           assign
     2570             v-object-handle = buf_temp-diasize-handle.handle-value
     2571           .
     2572           if v-object-handle <> v-diasize-resize-button
     2573           then do:
     2574             assign
     2575               v-object-handle :col = v-object-handle :col + p-change-value
     2576               no-error .
     2577             if error-status :error
     2578             or error-status :get-message(1) <> ""
     2579             then do:
     2580               undo move_block, retry move_block .
     2581             end.
     2582           end.
     2583         end.
     2584         for each buf_temp-browse-handle
     2585           where buf_temp-browse-handle.browse-type = 'width':u
     2586         on error undo move_block, retry move_block
     2587         :
     2588           assign
     2589             buf_temp-browse-handle.browse-handle :width
     2590               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2591             no-error .
     2592           if error-status :error
     2593           or error-status :get-message(1) <> ""
     2594           then do:
     2595             undo move_block, retry move_block .
     2596           end.
     2597         end.
     2598         assign
     2599           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2600           no-error .
     2601         if error-status :error
     2602         or error-status :get-message(1) <> ""
     2603         then do:
     2604           undo move_block, retry move_block.
     2605         end.
     2606         assign
     2607           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2608         no-error .
     2609         if error-status :error
     2610         or error-status :get-message(1) <> ""
     2611         then do:
     2612           undo move_block, retry move_block.
     2613         end.
     2614         if frame Dialog-Frame :scrollable = true
     2615         then do:
     2616           assign
     2617             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2618           no-error .
     2619           if error-status :error
     2620           or error-status :get-message(1) <> ""
     2621           then do:
     2622             undo move_block, retry move_block.
     2623           end.
     2624         end.
     2625       end.
     2626       if p-move-resize
     2627       then do:
     2628         run diasize_position-resize-button in this-procedure .
     2629       end.
     2630       if v-diasize-wndstore = true
     2631       then do:
     2632         if connected("ub") = true
     2633         then do:
     2634           define variable v-cntxt-db-num        as integer   no-undo .
     2635           define variable v-cntxt-userid        as character no-undo .
     2636           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2637                                             , OUTPUT v-cntxt-userid
     2638                                             ) .
     2639           run gbl/wndsizew.p
     2640             (input  v-cntxt-db-num
     2641             ,input  v-cntxt-userid
     2642             ,input  v-diasize-proc-name
     2643             ,input  'width':u
     2644             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2645             ) .
     2646         end.
     2647       end.
     2648     end.
     2649     assign
     2650       v-diasize-change-size = false
     2651     .
     2652   end procedure.
     2653   procedure diasize_set-width :
     2654     define input  parameter p-new-width  as decimal   no-undo .
     2655     define input  parameter p-move-resize as logical   no-undo .
     2656     do
     2657     on error undo, return error return-value
     2658     :
     2659       run diasize_change-width in this-procedure
     2660         (input  (p-new-width - frame Dialog-Frame :width)
     2661         ,input  p-move-resize
     2662         ) .
     2663     end.
     2664   end procedure.
     2665   procedure diasize_position-resize-button :
     2666     do with frame Dialog-Frame
     2667     :
     2668       hide v-diasize-resize-button .
     2669       assign
     2670         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2671                     - 1
     2672                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2673         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2674                     - 1
     2675                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2676       .
     2677       view v-diasize-resize-button .
     2678     end.
     2679   end procedure.
     2680   on alt-right anywhere
     2681   do:
     2682     run diasize_change-width in this-procedure
     2683       (input 1
     2684       ,input true
     2685       ) .
     2686     return no-apply .
     2687   end.
     2688   on alt-left anywhere
     2689   do:
     2690     run diasize_change-width in this-procedure
     2691       (input -1
     2692       ,input true
     2693       ) .
     2694     return no-apply .
     2695   end.
     2696   on alt-down anywhere
     2697   do:
     2698     run diasize_change-height in this-procedure
     2699       (input 1
     2700       ,input true
     2701       ) .
     2702     return no-apply .
     2703   end.
     2704   on alt-up anywhere
     2705   do:
     2706     run diasize_change-height in this-procedure
     2707       (input -1
     2708       ,input true
     2709       ) .
     2710     return no-apply .
     2711   end.
     2712   on alt-enter of frame Dialog-Frame
     2713   do:
     2714     run diasize_maximize in this-procedure
     2715       (input  ?
     2716       ).
     2717     return no-apply .
     2718   end.
     2719   procedure diasize_end-move :
     2720     do
     2721     on error undo, return error return-value
     2722     :
     2723       define variable v-row-delta as decimal   no-undo .
     2724       define variable v-col-delta as decimal   no-undo .
     2725       define variable v-new-row as decimal   no-undo .
     2726       define variable v-new-col as decimal   no-undo .
     2727       assign
     2728         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2729         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2730       .
     2731       assign
     2732         v-row-delta = v-new-row - frame Dialog-Frame :height
     2733         v-col-delta = v-new-col - frame Dialog-Frame :width
     2734       .
     2735       run diasize_change-height in this-procedure
     2736         (input v-row-delta
     2737         ,input true
     2738         ) .
     2739       run diasize_change-width in this-procedure
     2740         (input v-col-delta
     2741         ,input true
     2742         ) .
     2743     end.
     2744   end procedure.
     2745   procedure diasize_maximize :
     2746     define input  parameter p-action as logical   no-undo .
     2747     do
     2748     on error undo, return error return-value
     2749     :
     2750       if p-action = ?
     2751       then do:
     2752         if v-diasize-need-maximize = true
     2753         then do:
     2754           assign
     2755             p-action = true
     2756           .
     2757         end.
     2758         else do:
     2759           assign
     2760             p-action = false
     2761           .
     2762         end.
     2763       end.
     2764       if p-action = true
     2765       then do:
     2766         run diasize_change-height in this-procedure
     2767           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2768               - frame Dialog-Frame :height-chars
     2769           ,input true
     2770           ) .
     2771         run diasize_change-width in this-procedure
     2772           (input session :width-chars
     2773               - frame Dialog-Frame :width-chars
     2774           ,input true
     2775           ) .
     2776         assign
     2777           v-diasize-need-maximize = false
     2778         .
     2779       end.
     2780       else do:
     2781         run diasize_change-width in this-procedure
     2782           (input v-diasize-orig-frame-width
     2783               - frame Dialog-Frame :width-chars
     2784           ,input true
     2785           ) .
     2786         run diasize_change-height in this-procedure
     2787           (input v-diasize-orig-frame-height
     2788               - frame Dialog-Frame :height-chars
     2789           ,input true
     2790           ) .
     2791         assign
     2792           v-diasize-need-maximize = true
     2793         .
     2794       end.
     2795     end.
     2796   end procedure.
     2797   procedure diasize_restore-orig-size :
     2798     do
     2799     on error undo, return error return-value
     2800     :
     2801       assign
     2802         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2803         v-diasize-current-frame-height = frame Dialog-Frame :height
     2804       .
     2805       run diasize_set-height in this-procedure
     2806         (input  v-diasize-orig-frame-height
     2807         ,input  true
     2808         ) .
     2809       run diasize_set-width in this-procedure
     2810         (input  v-diasize-orig-frame-width
     2811         ,input  true
     2812         ) .
     2813     end.
     2814   end procedure.
     2815   procedure diasize_restore-current-size :
     2816     do
     2817     on error undo, return error return-value
     2818     :
     2819       run diasize_set-height in this-procedure
     2820         (input  v-diasize-current-frame-height
     2821         ,input  true
     2822         ) .
     2823       run diasize_set-width in this-procedure
     2824         (input  v-diasize-current-frame-width
     2825         ,input  true
     2826         ) .
     2827     end.
     2828   end procedure.
     2829   procedure diasize_set-browse-handle :
     2830     define input  parameter p-browse-handle as handle   no-undo .
     2831     define buffer buf_temp-browse-handle for temp-browse-handle .
     2832     do
     2833     on error undo, return error return-value
     2834     :
     2835       assign
     2836         v-diasize-browse-handle = p-browse-handle
     2837       .
     2838       for each buf_temp-browse-handle
     2839       on error undo, return error return-value
     2840       :
     2841         delete buf_temp-browse-handle .
     2842       end.
     2843     end.
     2844   end procedure.
     2845   procedure diasize_add_browse :
     2846     define input  parameter p-browse-type   as character no-undo .
     2847     define input  parameter p-browse-handle as handle    no-undo .
     2848     define buffer buf_temp-browse-handle for temp-browse-handle .
     2849     do
     2850     on error undo, return error return-value
     2851     :
     2852       assign
     2853         v-diasize-browse-number = v-diasize-browse-number + 1
     2854       .
     2855       create buf_temp-browse-handle .
     2856       assign
     2857         buf_temp-browse-handle.browse-type   = p-browse-type
     2858         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2859         buf_temp-browse-handle.browse-handle = p-browse-handle
     2860       .
     2861     end.
     2862   end procedure.
     2863   procedure diasize_init :
     2864     define variable v-default-value    as logical   no-undo .
     2865     define variable v-restore-saved    as logical   no-undo .
     2866     define variable v-resize-value-str as character no-undo .
     2867     do
     2868     on error undo, return error return-value
     2869     :
     2870       do with frame Dialog-Frame
     2871       :
     2872         assign
     2873           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2874           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2875           v-diasize-browse-handle     = browse BR-goods :handle
     2876         .
     2877         create button v-diasize-resize-button
     2878         assign
     2879           parent        = frame Dialog-Frame :first-child
     2880           label         = "s"
     2881           height-pixels = 16
     2882           width-pixels  = 16
     2883           visible       = true
     2884           sensitive     = true
     2885           movable       = true
     2886           triggers:
     2887             on end-move persistent run diasize_end-move in this-procedure .
     2888           end triggers.
     2889         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2890         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2891         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2892         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2893         assign
     2894           v-diasize-wndmax = false
     2895         .
     2896         if connected("ub") = true
     2897         then do:
     2898           define variable v-cntxt-db-num        as integer   no-undo .
     2899           define variable v-cntxt-userid        as character no-undo .
     2900           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2901                                             , OUTPUT v-cntxt-userid
     2902                                             ) .
     2903           run gbl/wndpar_r.p
     2904             (input  v-cntxt-db-num
     2905             ,input  v-cntxt-userid
     2906             ,input  'wndmax':U
     2907             ,output v-diasize-wndmax
     2908             ,output v-default-value
     2909             ) .
     2910         end.
     2911         assign
     2912           v-diasize-wndstore = false
     2913         .
     2914         if connected("ub") = true
     2915         then do:
     2916           run gbl/wndpar_r.p
     2917             (input  v-cntxt-db-num
     2918             ,input  v-cntxt-userid
     2919             ,input  'wndstore':U
     2920             ,output v-diasize-wndstore
     2921             ,output v-default-value
     2922             ) .
     2923         end.
     2924         assign
     2925           v-diasize-proc-name = entry(1, program-name(2), '.')
     2926         .
     2927         if v-diasize-wndstore = true
     2928         then do:
     2929           assign
     2930             v-restore-saved = false
     2931           .
     2932           if connected("ub") = true
     2933           then do:
     2934             run gbl/wndsizer.p
     2935               (input  v-cntxt-db-num
     2936               ,input  v-cntxt-userid
     2937               ,input  v-diasize-proc-name
     2938               ,input  'height':u
     2939               ,output v-resize-value-str
     2940               ) .
     2941             if v-resize-value-str <> '':U
     2942             then do:
     2943               run diasize_change-height in this-procedure
     2944                 (input  integer(v-resize-value-str)
     2945                 ,input  true
     2946                 ) .
     2947               assign
     2948                 v-restore-saved = true
     2949               .
     2950             end.
     2951           end.
     2952           if connected("ub") = true
     2953           then do:
     2954             run gbl/wndsizer.p
     2955               (input  v-cntxt-db-num
     2956               ,input  v-cntxt-userid
     2957               ,input  v-diasize-proc-name
     2958               ,input  'width':u
     2959               ,output v-resize-value-str
     2960               ) .
     2961             if v-resize-value-str <> '':U
     2962             then do:
     2963               run diasize_change-width in this-procedure
     2964                 (input  integer(v-resize-value-str)
     2965                 ,input  true
     2966                 ) .
     2967               assign
     2968                 v-restore-saved = true
     2969               .
     2970             end.
     2971           end.
     2972           if v-restore-saved <> true
     2973           then do:
     2974             if v-diasize-wndmax = true
     2975             then do:
     2976               run diasize_maximize in this-procedure
     2977                 (input  true
     2978                 ) .
     2979             end.
     2980           end.
     2981         end.
     2982         else do:
     2983           if v-diasize-wndmax = true
     2984           then do:
     2985             run diasize_maximize in this-procedure
     2986               (input  true
     2987               ) .
     2988           end.
     2989         end.
     2990       end.
     2991     end.
     2992   end procedure.
     2993   procedure diasize_need-full-display :
     2994     define output parameter p-need-full-display as logical   no-undo .
     2995     do
     2996     on error undo, return error return-value
     2997     :
     2998       assign
     2999         p-need-full-display = v-diasize-need-full-display
     3000       .
     3001       assign
     3002         v-diasize-need-full-display = false
     3003       .
     3004     end.
     3005   end procedure.
     3006   procedure get-context :
     3007      define output parameter p-db-num as integer          no-undo.
     3008      define output parameter p-user-id as character        no-undo.
     3009      define variable v-login               as character    no-undo.
     3010      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3011      define buffer buf_user-login  for ub.user-login .
     3012      do
     3013      on error undo, return error
     3014      :
     3015            FIND FIRST buf_sys-ctrl no-lock.
     3016            ASSIGN
     3017               v-login = USERID("ub")
     3018               p-db-num = buf_sys-ctrl.db-num
     3019            .
     3020            FIND FIRST buf_user-login
     3021                 WHERE buf_user-login.db-num = p-db-num
     3022                   AND buf_user-login.user-login = v-login
     3023                 no-lock
     3024                 no-error
     3025                 .
     3026            IF AVAILABLE buf_user-login
     3027            THEN DO:
     3028               assign
     3029                  p-user-id = buf_user-login.user-id
     3030               .
     3031            END.
     3032      end.
     3033   end procedure.
     3034       run diasize_init in this-procedure .
     3035   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3036     run mainmenu_getcntxt in parparentproc
     3037       (output v-cntxt-db-num
     3038       ,output v-cntxt-userid
     3039       ,output v-cntxt-level
     3040       ,output v-cntxt-host-code-obj
     3041       ,output v-cntxt-obj-type
     3042       ,output v-cntxt-obj-code
     3043       ,output v-cntxt-db-num-obj
     3044       ,output v-cntxt-is-admin
     3045       ) .
     3046   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3047   on F9 of frame Dialog-Frame anywhere do:
     3048     run get-goods.
     3049     if gds-rec = ? then
     3050       return no-apply.
     3051     run ref/gds-form.w ( input parparentproc
     3052                         ,input 'ПРОСМОТР':U
     3053                         ,input ?
     3054                         ,input ?
     3055                         ,input ?
     3056                         ,input-output gds-rec).
     3057     apply "entry" to br-goods in frame Dialog-Frame.
     3058     return no-apply.
     3059   end.
     3060   MAIN-BLOCK:
     3061   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3062      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3063     find first ub.sys-ctrl no-lock.
     3064     assign
     3065     v-db-num =  ub.sys-ctrl.db-num
     3066     .
     3067     RUN MyEnable.
     3068     WAIT-FOR GO OF FRAME Dialog-Frame.
     3069   END.
     3070   RUN disable_UI.
     3071   PROCEDURE assign-filter :
     3072   define input parameter p-in-date as date no-undo .
     3073   define input parameter p-fact-qnty as decimal no-undo .
     3074   define input parameter p-on-off-state as logical no-undo .
     3075   run uf-set in this-procedure(
     3076       input  'oldscode':U
     3077       ,input  v-cntxt-userid
     3078       ,input ("in-date=":U +
     3079               string(p-in-date , "99/99/9999") +   ";" +
     3080               "fact-qnty=":U + string(p-fact-qnty) + ";" +
     3081               "on-off-state=" + (if p-on-off-state = ? then chr(63) else string(p-on-off-state))
     3082               )
     3083       ,input v-uf-Naim
     3084       ,input v-uf-print-graft
     3085       ,input v-uf-sort-gr
     3086       ,input v-uf-type-price
     3087       ,input v-uf-type-val
     3088   )  no-error .
     3089   END PROCEDURE.
     3090   PROCEDURE create-temp :
     3091   define input parameter p-obj-type as character no-undo .
     3092   define input parameter p-obj-code as integer no-undo .
     3093   define parameter buffer b_goods for ub.goods.
     3094   define parameter buffer b_gds-obj for ub.gds-obj.
     3095   define parameter buffer b_gds-obj-attr for ub.gds-obj-attr.
     3096   define parameter buffer buf_prod-bc for ub.prod-bc.
     3097   define input parameter v-main-b-code as integer no-undo.
     3098   define input-output parameter jj as integer   no-undo .
     3099   define input-output parameter jj-mark as integer   no-undo .
     3100   define variable l-prod-bc-global as logical   no-undo .
     3101   define variable l-prod-bc-weight as logical  no-undo .
     3102   define buffer b_clients for ub.clients.
     3103   Find first temp-codes where
     3104                  temp-codes.gds-code = b_goods.gds-code no-error.
     3105    if not available temp-codes then do:
     3106      find first b_clients no-lock where
     3107                          b_clients.obj-type = b_goods.prod-type
     3108                      AND b_clients.obj-code = b_goods.prod-code no-error.
     3109      create temp-codes.
     3110      assign
     3111      temp-codes.bc-on = buf_prod-bc.bc-on
     3112      temp-codes.cr-db-num = buf_prod-bc.cr-db-num
     3113      temp-codes.gds-code = b_goods.gds-code
     3114      temp-codes.b-code = v-main-b-code
     3115      temp-codes.artic = b_goods.artic
     3116      temp-codes.prod-type = b_goods.prod-type
     3117      temp-codes.prod-code = b_goods.prod-code
     3118      temp-codes.gds-name = b_goods.gds-name
     3119      temp-codes.in-date = (if available b_gds-obj then b_gds-obj.in-date else ?)
     3120      temp-codes.obj-type = p-obj-type
     3121      temp-codes.obj-code = p-obj-code
     3122      temp-codes.max-fact-qnty = (if available b_gds-obj then  b_gds-obj.fact-qnty else 0)
     3123      temp-codes.max-fact-qnty-obj-type = p-obj-type
     3124      temp-codes.max-fact-qnty-obj-code = p-obj-code
     3125      temp-codes.b-str = buf_prod-bc.b-str
     3126      temp-codes.free-qnty = (if available b_gds-obj then  b_gds-obj.free-qnty else 0)
     3127      temp-codes.fact-qnty = (if available b_gds-obj then   b_gds-obj.fact-qnty else 0)
     3128      temp-codes.prod-name = (if available b_clients then b_clients.obj-name else "":U)
     3129      temp-codes.bc-on-type = (if available buf_prod-bc
     3130                               then buf_prod-bc.bc-on-type
     3131                               else chr(63))
     3132      jj = jj + 1
     3133      .
     3134      if temp-codes.bc-on-type = ''
     3135      then do:
     3136   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3137   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3138     (buffer buf_prod-bc
     3139     ,input  'global=request':u
     3140     ,output l-prod-bc-global
     3141     ) no-error .
     3142   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3143   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     3144     (buffer buf_prod-bc
     3145     ,input  'weight=request':u
     3146     ,output l-prod-bc-weight
     3147     ) no-error .
     3148       if error-status:error then do:
     3149         assign
     3150         temp-codes.bc-on-type = chr(63)
     3151         .
     3152       end.
     3153       else do:
     3154          if l-prod-bc-global
     3155          and l-prod-bc-weight then do:
     3156            assign
     3157            temp-codes.bc-on-type = 'scgb':U.
     3158          end.
     3159          if not l-prod-bc-global
     3160          and l-prod-bc-weight then do:
     3161            assign
     3162            temp-codes.bc-on-type = 'sclc':U.
     3163          end.
     3164          if not l-prod-bc-global
     3165          and not l-prod-bc-weight then do:
     3166            assign
     3167            temp-codes.bc-on-type = chr(63).
     3168          end.
     3169       end.
     3170      end.
     3171       if temp-codes.bc-on-type <> chr(63) then do:
     3172          if temp-codes.bc-on-type = 'scgb':U then do:
     3173             temp-codes.is-glob = yes.
     3174          end.
     3175          if temp-codes.bc-on-type = 'pglc':U then do:
     3176             temp-codes.plu-type = entry (lookup ('1':U, '0,1':U) + 1, ',' + 'Весовой,Штучный':U).
     3177          end.
     3178          else do:
     3179             temp-codes.plu-type = entry (lookup ('0':U, '0,1':U) + 1, ',' + 'Весовой,Штучный':U).
     3180          end.
     3181       end.
     3182      find first temp-mark no-lock where
     3183                 temp-mark.gds-code = temp-codes.gds-code no-error.
     3184      if avail temp-mark then do:
     3185        assign
     3186        temp-codes.is-mark = yes
     3187        jj-mark = jj-mark + 1
     3188        .
     3189      end.
     3190    end.
     3191    else do:
     3192      if available b_gds-obj then do:
     3193      assign
     3194      temp-codes.obj-type = if b_gds-obj.in-date > temp-codes.in-date
     3195                                         then  b_gds-obj.obj-type
     3196                                         else temp-codes.obj-type
     3197      temp-codes.obj-code = if b_gds-obj.in-date > temp-codes.in-date
     3198                                          then b_gds-obj.obj-code
     3199                                          else temp-codes.obj-code
     3200      temp-codes.in-date = if b_gds-obj.in-date > temp-codes.in-date
     3201                                          then b_gds-obj.in-date
     3202                                          else temp-codes.in-date
     3203      temp-codes.max-fact-qnty-obj-type = if b_gds-obj.fact-qnty > temp-codes.max-fact-qnty
     3204                                         then  b_gds-obj.obj-type
     3205                                         else temp-codes.obj-type
     3206      temp-codes.max-fact-qnty-obj-code = if b_gds-obj.fact-qnty > temp-codes.max-fact-qnty
     3207                                          then b_gds-obj.obj-code
     3208                                          else temp-codes.obj-code
     3209      temp-codes.max-fact-qnty = if b_gds-obj.fact-qnty > temp-codes.max-fact-qnty
     3210                                          then b_gds-obj.fact-qnty
     3211                                          else temp-codes.fact-qnty
     3212      temp-codes.free-qnty = temp-codes.free-qnty +  b_gds-obj.free-qnty
     3213      temp-codes.fact-qnty = temp-codes.free-qnty +  b_gds-obj.fact-qnty
     3214      .
     3215    end.
     3216    end.
     3217   END PROCEDURE.
     3218   PROCEDURE disable_UI :
     3219     HIDE FRAME Dialog-Frame.
     3220   END PROCEDURE.
     3221   PROCEDURE enable_UI :
     3222     DISPLAY rs-on-off-state v-in-date v-fact-qnty v-tocd v-all-count F-log-file
     3223             v-mark-count
     3224         WITH FRAME Dialog-Frame.
     3225     ENABLE b-quit RECT-b-query B-query b-mark B-off B-goods B-codes B-print
     3226            B-Help rs-on-off-state v-in-date v-fact-qnty v-tocd BR-goods
     3227            F-log-file
     3228         WITH FRAME Dialog-Frame.
     3229     VIEW FRAME Dialog-Frame.
     3230     OPEN QUERY BR-goods FOR EACH temp-codes NO-LOCK.
     3231   END PROCEDURE.
     3232   PROCEDURE get-goods :
     3233   define buffer buf_goods for ub.goods .
     3234   if not available temp-codes then do:
     3235       gds-rec = ?.
     3236       return.
     3237    end.
     3238   find first buf_goods no-lock where
     3239                buf_goods.gds-code = temp-codes.gds-code no-error.
     3240   if avail buf_goods then do:
     3241       assign
     3242       gds-rec = recid(buf_goods)
     3243       .
     3244   end.
     3245   END PROCEDURE.
     3246   PROCEDURE MyEnable :
     3247   run set-filter in this-procedure.
     3248   for each ub.clients no-lock where
     3249               ub.clients.db-num = v-db-num:
     3250   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3251   run create_obj-list in this-procedure
     3252    ( input ub.clients.obj-type ,
     3253      input ub.clients.obj-code )
     3254     no-error .
     3255   end.
     3256   assign
     3257   b-print:MENU-MOUSE in frame Dialog-Frame = 1
     3258   b-off:MENU-MOUSE in frame Dialog-Frame = 1
     3259   v-title-0 = frame Dialog-Frame:title
     3260   rs-on-off-state = yes
     3261   frame Dialog-Frame:title = v-title-0 + get-title(v-in-date, v-fact-qnty, rs-on-off-state).
     3262   DISPLAY
     3263   v-in-date
     3264   v-fact-qnty
     3265   v-all-count v-tocd
     3266   rs-on-off-state
     3267   WITH FRAME Dialog-Frame .
     3268   ENABLE
     3269   b-codes
     3270   b-goods
     3271   b-print
     3272   b-quit
     3273   RECT-b-query
     3274   B-query
     3275   B-off
     3276   B-Help
     3277   b-mark
     3278   BR-goods
     3279   v-in-date
     3280   v-fact-qnty
     3281   v-tocd
     3282   rs-on-off-state
     3283   WITH FRAME Dialog-Frame .
     3284   VIEW FRAME Dialog-Frame .
     3285     run Set-Query in this-procedure (no).
     3286     RUn Openbr in This-Procedure.
     3287   END PROCEDURE.
     3288   PROCEDURE OpenBr :
     3289   define variable v-main-b-code like ub.bar-code.b-code no-undo.
     3290   DEFINE VARIABLE jj as integer no-undo .
     3291   DEFINE VARIABLE jj-mark as integer no-undo .
     3292   define variable v-gds-code as integer no-undo .
     3293   define buffer b_goods for ub.goods.
     3294   define buffer b_units for ub.units.
     3295   define buffer b_gds-obj for ub.gds-obj.
     3296   define buffer b_gds-obj-attr for ub.gds-obj-attr.
     3297   define buffer b_code-range for ub.code-range.
     3298   define buffer b_scales-gds for ub.scales-gds.
     3299   define buffer buf_prod-bc for ub.prod-bc.
     3300   define buffer buf_bar-code for ub.bar-code.
     3301   run waitfram-show in this-procedure ("Ждите...Идет поиск товаров").
     3302   for each temp-mark:
     3303     delete temp-mark.
     3304   end.
     3305   for each temp-codes:
     3306     if temp-codes.is-mark then do:
     3307       find first temp-mark where
     3308                  temp-mark.gds-code = temp-codes.gds-code no-error.
     3309       if not avail temp-mark then do:
     3310         create
     3311         temp-mark.
     3312         assign
     3313         temp-mark.gds-code = temp-codes.gds-code.
     3314       end.
     3315     end.
     3316     delete temp-codes.
     3317   end.
     3318   _prod-bc:
     3319   for each buf_prod-bc no-lock where
     3320           buf_prod-bc.b-str >= "00100"
     3321        and buf_prod-bc.b-str <= "99999"
     3322        and length(buf_prod-bc.b-str) = 5
     3323        and (rs-on-off-state = ? or buf_prod-bc.bc-on = rs-on-off-state),
     3324       first buf_bar-code no-lock where
     3325           buf_bar-code.b-code = buf_prod-bc.b-code,
     3326       first b_goods No-LOCK where b_goods.gds-code = buf_bar-code.gds-code:
     3327   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3328     (input  b_goods.gds-code
     3329     ,input  ?
     3330     ,output v-main-b-code
     3331     )  .
     3332     for each obj-list:
     3333       find first b_gds-obj-attr No-LOCK WHERE
     3334                 b_gds-obj-attr.gds-code = b_goods.gds-code
     3335             and b_gds-obj-attr.obj-type = obj-list.obj-type
     3336             and b_gds-obj-attr.obj-code = obj-list.obj-code
     3337             AND b_gds-obj-attr.attr-code = 'scales-code':U no-error.
     3338       if (available b_gds-obj-attr
     3339       and buf_prod-bc.b-str = b_gds-obj-attr.attr-value)
     3340       or not available b_gds-obj-attr then do:
     3341         find first b_scales-gds no-lock where
     3342                   b_scales-gds.b-code = v-main-b-code
     3343               and b_scales-gds.obj-type = obj-list.obj-type
     3344               and b_scales-gds.obj-code = obj-list.obj-code  no-error.
     3345         if available b_scales-gds then do:
     3346           NEXT _prod-bc.
     3347         end.
     3348       end.
     3349     end.
     3350     for each obj-list:
     3351       find first b_gds-obj no-lock where
     3352                 b_gds-obj.obj-type = obj-list.obj-type
     3353             and b_gds-obj.obj-code = obj-list.obj-code
     3354             and b_gds-obj.gds-code = b_goods.gds-code
     3355             no-error.
     3356       if available b_gds-obj then do:
     3357      if b_gds-obj.in-date > v-in-date    then do:
     3358        v-gds-code = b_goods.gds-code.
     3359           NEXT _prod-bc.
     3360      end.
     3361      if b_gds-obj.fact-qnty > v-fact-qnty then do:
     3362        v-gds-code = b_goods.gds-code.
     3363           NEXT _prod-bc.
     3364         end.
     3365       end.
     3366       run create-temp in this-procedure ( input obj-list.obj-type
     3367                                         ,input obj-list.obj-code
     3368                                         ,buffer b_goods
     3369                                         ,buffer b_gds-obj
     3370                                         ,buffer b_gds-obj-attr
     3371                                         ,buffer buf_prod-bc
     3372                                         ,input v-main-b-code
     3373                                         ,input-output jj
     3374                                         ,input-output jj-mark).
     3375     end.
     3376     run waitfram-show in this-procedure (("Ждите...Идет поиск товаров. Найдено") + chr(32) + string(jj)).
     3377   END.
     3378      assign
     3379   frame Dialog-Frame:title = v-title-0 + get-title(v-in-date, v-fact-qnty, rs-on-off-state)
     3380     v-all-count = jj
     3381     v-mark-count = jj-mark
     3382     .
     3383   if v-mark-count > 0 then do:
     3384       display
     3385       v-mark-count with frame Dialog-Frame.
     3386   end.
     3387   else do:
     3388       HIDE
     3389       v-mark-count in frame Dialog-Frame.
     3390   end.
     3391   display
     3392   v-all-count
     3393   with frame Dialog-Frame.
     3394   run waitfram-hide in this-procedure .
     3395   OPEN QUERY BR-goods FOR EACH temp-codes NO-LOCK.
     3396   reposition br-goods to row 1.
     3397   APPLY "ENTRY" to br-goods.
     3398   END PROCEDURE.
     3399   PROCEDURE proc-b-mark :
     3400   define variable glog as logical no-undo .
     3401   define buffer buf_temp-codes for temp-codes.
     3402       if not avail temp-codes then do:
     3403           return error.
     3404       end.
     3405     find first buf_temp-codes where recid(buf_temp-codes) = recid(temp-codes) no-error.
     3406       if not avail buf_temp-codes then do:
     3407         return error.
     3408     end.
     3409     assign
     3410       v-mark-count = v-mark-count + (if  not buf_temp-codes.is-mark then 1 else (  - 1))
     3411     buf_temp-codes.is-mark = not buf_temp-codes.is-mark
     3412     .
     3413     display
     3414     temp-codes.is-mark with browse br-goods.
     3415     if v-mark-count > 0 then
     3416     display v-mark-count with frame Dialog-Frame.
     3417     else do:
     3418           hide
     3419           v-mark-count in frame Dialog-Frame.
     3420     end.
     3421       glog = br-goods:select-next-row () in frame Dialog-Frame.
     3422       apply "VALUE-changed" to br-goods in frame Dialog-Frame.
     3423   END PROCEDURE.
     3424   PROCEDURE proc-b-off :
     3425   DEFINE VARIABLE loc#log as logical no-undo .
     3426   DEFINE VARIABLE v-ii as integer no-undo .
     3427   define variable choice as integer no-undo .
     3428   define variable v-msg as character no-undo .
     3429   define variable glog as logical no-undo.
     3430   define buffer buf_temp-codes for temp-codes.
     3431   define buffer buf_prod-bc for ub.prod-bc.
     3432   do
     3433   on error undo, return error
     3434   :
     3435   if off-option = "":U then do:
     3436      run gbl/pop-up.p (b-off:handle in frame Dialog-Frame, no) no-error.
     3437   end.
     3438   if off-option = "":U then do:
     3439       return error.
     3440   end.
     3441   .
     3442   if not available temp-codes then do:
     3443     assign
     3444     off-option = "":U
     3445     .
     3446     return error.
     3447   end.
     3448   if temp-codes.is-glob then do:
     3449     message
     3450     "Пока нет возможности выключить ГЛОБАЛЬНЫЙ код для весов"
     3451     view-as alert-box error.
     3452     undo, return error.
     3453   end.
     3454   assign
     3455   frame Dialog-Frame
     3456   v-tocd.
     3457   run gbl/d-askw.w (input "Вопрос"
     3458                   ,input  substitute("Выберите действие, которое Вы хотите произвести над кодами&1"+
     3459                                      "Удаление рекомендуется выбирать ТОЛЬКО в том случае,&1если предполагается в дальнейшем удалить ДИАПАЗОН кодов"
     3460                                     , chr(10))
     3461                   ,input "|"
     3462                   ,input "Выключить|Выключить (если включен) и Удалить|Отменить"
     3463                   ,input "||"
     3464                   ,input 1
     3465                   ,input 3
     3466                   ,output choice).
     3467   if choice = 3 then do:
     3468     undo, return .
     3469   end.
     3470   CASE off-option:
     3471       when "one":U then do:
     3472         message
     3473         substitute("Вы действительно хотите &7 локальный код для весов &2&1" +
     3474                    "для товара &3 &4&5 &6 ?":U
     3475                     ,chr(10)
     3476                     ,temp-codes.b-str
     3477                     ,temp-codes.artic
     3478                     ,temp-codes.prod-type
     3479                     ,temp-codes.prod-code
     3480                     ,temp-codes.gds-name
     3481                     ,(if choice = 1 then "выключить" else "выключить и удалить")
     3482                     )
     3483         view-as alert-box QUESTION buttons YES-NO update loc#log.
     3484         if not loc#log then do:
     3485           assign
     3486           off-option = "":U
     3487           .
     3488           return error.
     3489         end.
     3490         run set-file-title in this-procedure (v-log-file, output F-log-file) .
     3491         display
     3492         f-log-file
     3493         with frame Dialog-Frame.
     3494         run waitfram-show in this-procedure ("Ждите...").
     3495         if temp-codes.plu-type = "Весовой" then do :
     3496           find first ub.goods no-lock
     3497                where ub.goods.gds-code = temp-codes.gds-code no-error.
     3498           if available ub.goods then do :
     3499   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3500   do:
     3501     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3502       (input  v-cntxt-db-num
     3503       ,input  v-cntxt-userid
     3504       ,input  0
