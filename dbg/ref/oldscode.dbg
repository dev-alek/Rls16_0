     3573                                     input parparentproc
     3574                                     ,input temp-codes.b-code
     3575                                     ,input temp-codes.b-str
     3576                                     ,input no
     3577                                     ,input no
     3578                                     ,input v-tocd
     3579                                     ,input ?
     3580                                     ,input this-procedure:handle
     3581                                     ) no-error.
     3582           if error-status:error then do:
     3583               run waitfram-hide in this-procedure .
     3584               assign
     3585               off-option = "":U
     3586               .
     3587                 undo, return error.
     3588               end.
     3589             end.
     3590             if choice = 2 then do:
