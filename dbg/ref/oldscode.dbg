     3514       ,output glog
     3515       )  .
     3516   end.
     3517           end.
     3518           else do :
     3519            glog = false.
     3520           end.
     3521           if not glog then do :
     3522             v-msg = substitute("Товар: &1&2&3 код товара &4 ДопБК &5 : недоступно право actn_alt-barcode_loc-pg-code - добавление лок. шт. кода для весов  "
     3523                               ,temp-codes.artic
