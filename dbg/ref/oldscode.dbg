     3592                     where buf_prod-bc.b-str = temp-codes.b-str
     3593                       and buf_prod-bc.b-code = temp-codes.b-code no-error.
     3594               if not available buf_prod-bc then do:
     3595                 assign
     3596                 v-msg = substitute("Товар: &1&2&3 код товара &4 ДопБК &5 не найден при попытке удаления"
     3597                                   ,temp-codes.artic
     3598                                   ,temp-codes.prod-type
     3599                                   ,temp-codes.prod-code
