      696   define  stream PrnLibStream.
      697   procedure prn-lib-prn-file :
      698     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      699     define input parameter p-DIsabledoptions as integer no-undo .
      700     define variable v-report-name as character no-undo .
      701     define variable v-user-action as character no-undo .
      702     define variable v-printed     as logical   no-undo .
      703     define variable v-exist       as logical   no-undo .
      704     do
      705       on error undo, return error
      706       :
      707       run prn-lib-get-report-name  in this-procedure (
      708         input parParentProc
      709         ,output v-report-name
      710         ).
      711   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      712   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      713     (input  v-report-name
      714     ,input  2
      715     ,output v-exist
      716     )  .
      717       if NOT v-exist then
      718       DO:
      719         Message
      720           "Нет заданий на печать ! "
      721           view-as alert-box .
      722         Return  .
      723       End.
      724       run gbl/prnfilen.w
      725         (input  ""
      726         ,input  p-DisabledOptions
      727         ,input  string(v-report-name )
      728         ,input  7
      729         ,output v-user-action
      730         ,output v-printed
      731         ) .
      732       if v-printed then
      733       do:
      734         return "YES" .
      735       end.
      736       else
      737       do:
      738         return "NO" .
      739       end.
      740     end.
      741   end procedure.
      742   procedure prn-lib-open-stream :
      743     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      744     define input parameter p-page-size    as integer no-undo .
      745     define input parameter p-is-stream    as logical no-undo .
      746     define input parameter p-append       as logical no-undo .
      747     define variable v-report-name as character no-undo .
      748     do
      749       on error undo, return error
      750       :
      751       run prn-lib-get-report-name  in this-procedure (
      752         input parParentProc
      753         ,output v-report-name
      754         ).
      755       if p-is-stream then
      756       do:
      757         if p-append then
      758         do:
      759           output stream PrnLibStream to value( v-report-name )
      760             page-size value(p-page-size) append .
      761         end.
      762         if not p-append then
      763         do:
      764           output stream PrnLibStream to value( v-report-name )
      765             page-size value(p-page-size) .
      766         end.
      767       end.
      768       if not p-is-stream then
      769       do:
      770         if p-append then
      771         do:
      772           output to value( v-report-name )
      773             page-size value(p-page-size) append .
      774         end.
      775         if not p-append then
      776         do:
      777           output to value( v-report-name )
      778             page-size value(p-page-size) .
      779         end.
      780       end.
      781     end.
      782   end procedure.
      783   procedure prn-lib-open-exp :
      784     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      785     define input parameter p-is-stream    as logical no-undo .
      786     define input parameter p-is-append    as logical no-undo .
      787     define output parameter p-ReportFileName as char init "report" no-undo.
      788     define output parameter p-process as logical no-undo .
      789     define variable glog as logical no-undo .
      790     do
      791       on error undo, return error
      792       :
      793       SYSTEM-DIALOG GET-FILE p-ReportFileName
      794         TITLE      "Укажите путь"
      795         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      796         ASK-OVERWRITE
      797         CREATE-TEST-FILE
      798         SAVE-AS
      799         USE-FILENAME
      800         DEFAULT-EXTENSION "txt"
      801         UPDATE glog
      802         .
      803       if not glog then  return.
      804       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      805       if p-is-stream then
      806       do:
      807         if p-is-append then
      808         do:
      809           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      810         end.
      811         else
      812         do:
      813           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      814         end.
      815       end.
      816       else
      817       do:
      818         if p-is-append then
      819         do:
      820           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      821         end.
      822         else
      823         do:
      824           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      825         end.
      826       end.
      827       p-process = yes.
      828     end.
      829   end procedure.
      830   procedure prn-lib-get-report-name :
      831     define input parameter parParentProc  as widget-handle no-undo.
      832     define output parameter p-report-name as character no-undo .
      833     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      834   end procedure.
      835   procedure prn-lib-reportviewer-report-name :
      836     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      837     define input parameter p-report-name-html as character no-undo .
      838     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      839   end procedure.
      840   procedure prn-lib-reportviewer :
      841     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      842     define input parameter p-report-name-html as character no-undo .
      843     define input parameter p-param        as character no-undo .
      844     define variable v-excel           as character no-undo init 'TRUE' .
      845     define variable v-value-character as character no-undo .
      846     define variable v-value-integer   as character no-undo .
      847     define variable v-value-date      as date      no-undo .
      848     define variable v-value-decimal   as decimal   no-undo .
      849     define variable rep-excel         as logical   no-undo .
      850     define variable excel-string      as character no-undo .
      851     define variable v-param-type      as character no-undo .
      852     define variable v-tth             as handle    no-undo .
      853     run adm/shattri.p (
      854       input "get":U
      855       ,input  ""
      856       ,input  0
      857       ,input  'report-glob':U
      858       ,input  'rep-excel':U
      859       ,output v-value-character
      860       ,output v-value-date
      861       ,output v-value-decimal
      862       ,output v-value-integer
      863       ,output rep-excel
      864       ,output v-param-type
      865       ,INPUT-OUTPUT table-handle v-tth
      866       )  .
      867     if rep-excel then v-excel = "TRUE" .
      868     else v-excel = "FALSE" .
      869     if p-param eq ""
      870     then
      871        p-param = "EXCEL:" + v-excel.
      872     else
      873        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      874     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      875   end procedure.
