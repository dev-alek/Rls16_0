      646   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      647   def
      648   new shared
      649   temp-table  obj-list no-undo
      650     field obj-type like ub.clients.obj-type
      651     field obj-code like ub.clients.obj-code
      652     field obj-name like ub.clients.obj-name
      653     field obj-id   as integer
      654     field db-num   as integer
      655     index pi is primary unique obj-id
      656     index ie1 obj-type obj-code
      657     index ie2 obj-name
      658   .
      659   procedure create_obj-list :
      660      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      661      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      662      do
      663      on error undo, return error return-value
      664      :
      665         define buffer cli-obj for ub.clients .
      666         define variable p-var as integer no-undo .
      667         define buffer buf_obj-list for obj-list .
      668         find last buf_obj-list  use-index pi no-error .
      669         if available buf_obj-list
      670         then
      671            p-var = buf_obj-list.obj-id + 1.
      672         else
      673            p-var = 1.
      674         find first cli-obj where
      675                   cli-obj.obj-type = p-obj-type
      676               and cli-obj.obj-code = p-obj-code
      677         no-lock no-error.
      678         if available cli-obj
      679         then do:
      680            create buf_obj-list.
      681            assign
      682               buf_obj-list.obj-id   = p-var
      683               buf_obj-list.obj-code = cli-obj.obj-code
      684               buf_obj-list.obj-type = cli-obj.obj-type
      685               buf_obj-list.obj-name = cli-obj.obj-name
      686               buf_obj-list.db-num   = cli-obj.db-num
      687            .
      688         end.
      689      end.
      690   end.
