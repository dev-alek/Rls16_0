      626   define variable v-chg-fields as character no-undo.
      627   define variable v-old-fields as character no-undo.
      628   define variable v-new-fields as character no-undo.
      629   define variable ii           as integer   no-undo.
      630   define variable v-mess       as character no-undo .
      631   define buffer buf_c-action-role      for ub.c-action-role.
      632   define buffer buf_c-action-role-item for ub.c-action-role-item.
      633   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      634   define SHARED temp-table temp-changes no-undo
      635   field f_name as character
      636   field l_name as character
      637   field v_old as character
      638   field v_new as character
      639   field t_name as character
      640   field num_ as integer
      641   field uniq-key-rec as character
      642   field action as integer
      643   field fNotChange as logical
      644   index pi is unique primary
      645   num_
      646   t_name
      647   f_name
      648   index
      649   Chan
      650   fnotChange
      651   t_name
      652   f_name
      653   index imain uniq-key-rec
      654   .
      655   FUNCTION get-all-fields returns character (p-file-name as character ):
      656   define variable v-dop as character no-undo .
      657     find first _file no-lock where _file._file-name = p-file-name no-error .
      658     if not available _file then return "":U.
      659     for each _field no-lock where
      660              _field._file-recid = recid(_file) :
      661       assign
      662       v-dop = v-dop + _field._field-name + chr(44)
      663       .
      664     end.
      665     return trim(v-dop).
      666   END FUNCTION.
      667   PROCEDURE proc-full-temp-changes :
      668     define input  parameter p-act-create as logical   no-undo .
      669     define input  parameter p-act-delete as logical   no-undo .
      670     define input  parameter p-hst-handle as handle    no-undo .
      671     define input  parameter p-main-table as character no-undo .
      672     define input  parameter p-field-list as character no-undo .
      673     define input  parameter p-label-form as character no-undo .
      674     define variable h-new-buf         as handle    no-undo .
      675     define variable h-main-buf        as handle    no-undo .
      676     define variable h-for-comp        as handle    no-undo .
      677     define variable v-inform          as character no-undo .
      678     define variable v-ind             as integer   no-undo .
      679     define variable v-idx-field-qnty  as integer   no-undo .
      680     define variable v-num-entries     as integer   no-undo .
      681     define variable fh                as handle    no-undo .
      682     define variable fh-main           as handle    no-undo .
      683     define variable fh-old            as handle    no-undo .
      684     define variable fh-new            as handle    no-undo .
      685     define variable v-field-name      as character no-undo .
      686     define variable v-field-lvl       as character no-undo .
      687     define variable v-field-form      as character no-undo .
      688     define variable v-search-exp      as character no-undo .
      689     define variable v-srch-main       as character no-undo .
      690     define variable v-word-link       as character no-undo .
      691     define variable v-av-chip-num     as logical   no-undo .
      692     define variable v-main-pi-fld-lst as character no-undo .
      693     define variable v-main-fld-lst    as character no-undo .
      694     define variable v-delim-list      as character no-undo .
      695     define variable v-label           as character no-undo .
      696     define variable v-old-value       as character no-undo case-sensitive.
      697     define variable v-new-value       as character no-undo case-sensitive.
      698     define variable v-chg-fields as character no-undo.
      699     for each temp-changes:
      700       delete temp-changes.
      701     end.
      702     if not p-hst-handle:available then do:
      703       return .
      704     end.
      705     create buffer h-new-buf  for table p-hst-handle .
      706     create buffer h-main-buf for table p-main-table .
      707     assign
      708       v-inform = h-main-buf:index-information(1)
      709       v-ind    = 2
      710     .
      711     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      712     on error undo, return error
      713     :
      714       assign
      715         v-inform = h-main-buf:index-information( v-ind )
      716         v-ind    = v-ind + 1
      717       .
      718     end.
      719     if v-inform = ?
      720       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      721       or entry( 3, v-inform, ",":U ) <> "1":U
      722     then do:
      723       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      724     end.
      725     assign
      726       v-idx-field-qnty = num-entries( v-inform ) - 4
      727     .
      728     if v-idx-field-qnty < 2 then do:
      729       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      730     end.
      731     assign
      732       v-srch-main   = "where":U
      733       v-word-link   = "":U
      734       v-av-chip-num = false
      735       v-delim-list  = "":U
      736     .
      737     do v-ind = 1 to v-idx-field-qnty by 2
      738     on error undo, return error
      739     :
      740       assign
      741         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      742         fh                = p-hst-handle:buffer-field( v-field-name )
      743         fh-main           = h-main-buf:buffer-field( v-field-name )
      744         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      745         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      746       .
      747       if fh:data-type ="character":U then do:
      748         assign
      749           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      750         .
      751       end.
      752       else do:
      753         assign
      754           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      755         .
      756       end.
      757       if v-delim-list = "":U then do:
      758         assign
      759           v-delim-list = ",":U
      760         .
      761       end.
      762       if v-word-link = "":U then do:
      763         assign
      764           v-word-link = "and":U
      765         .
      766       end.
      767     end.
      768     assign
      769       v-delim-list  = "":U
      770     .
      771     do v-ind = 1 to h-main-buf:num-fields
      772     on error undo, return error
      773     :
      774       assign
      775         fh-main      = h-main-buf:buffer-field( v-ind )
      776         v-field-name = fh-main:name
      777       .
      778         assign
      779           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      780         .
      781         if v-delim-list = "":U then do:
      782           assign
      783             v-delim-list = ",":U
      784           .
      785         end.
      786     end.
      787     assign
      788       v-inform = p-hst-handle:index-information(1)
      789       v-ind    = 2
      790     .
      791     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      792     on error undo, return error
      793     :
      794       assign
      795         v-inform = p-hst-handle:index-information( v-ind )
      796         v-ind    = v-ind + 1
      797       .
      798     end.
      799     if v-inform = ?
      800       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      801       or entry( 3, v-inform, ",":U ) <> "1":U
      802     then do:
      803       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      804     end.
      805     assign
      806       v-idx-field-qnty = num-entries( v-inform ) - 4
      807     .
      808     if v-idx-field-qnty < 2 then do:
      809       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      810     end.
      811     assign
      812       v-search-exp  = "where":U
      813       v-word-link   = "":U
      814       v-av-chip-num = false
      815     .
      816     do v-ind = 1 to v-idx-field-qnty by 2
      817     on error undo, return error
      818     :
      819       assign
      820         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      821         fh           = p-hst-handle:buffer-field( v-field-name )
      822         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      823       .
      824       if v-field-name = "chip-num":U then do:
      825         assign
      826           v-search-exp  = substitute( "&1 >", v-search-exp )
      827           v-av-chip-num = true
      828         .
      829       end.
      830       else do:
      831         assign
      832           v-search-exp = substitute( "&1 =", v-search-exp )
      833         .
      834       end.
      835       if fh:data-type ="character":U then do:
      836         assign
      837           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      838         .
      839       end.
      840       else do:
      841         assign
      842           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      843         .
      844       end.
      845       if v-word-link = "":U then do:
      846         assign
      847           v-word-link = "and":U
      848         .
      849       end.
      850     end.
      851     if v-av-chip-num = false then do:
      852       message
      853         vss-workfile vss-revision vss-description skip
      854         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      855         "Использование данной процедуры невозможно!" skip
      856         view-as alert-box error .
      857       return error .
      858     end.
      859     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      860     if not h-new-buf:available then do:
      861       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      862       if not h-main-buf:available then do:
      863         assign
      864           h-for-comp = ?
      865         .
      866       end.
      867       else do:
      868         assign
      869           h-for-comp = h-main-buf
      870         .
      871       end.
      872     end.
      873     else do:
      874       assign
      875         h-for-comp = h-new-buf
      876       .
      877     end.
      878     assign
      879       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      880     .
      881     do v-ind = 1 to v-num-entries
      882     on error undo, return error return-value
      883     :
      884       assign
      885         v-field-name = entry( v-ind, v-main-fld-lst )
      886         fh-old       = p-hst-handle:buffer-field( v-field-name )
      887         v-old-value  = fh-old:buffer-value()
      888         v-label      = trim( fh-old:label )
      889       .
      890       if ( trim( p-field-list ) <> "":U
      891            and lookup( v-field-name, p-field-list ) > 0
      892          )
      893          or trim( p-field-list ) = "":U
      894       then do:
      895         if h-for-comp <> ? then do:
      896           assign
      897             fh-new      = h-for-comp:buffer-field( v-field-name )
      898             v-new-value = fh-new:buffer-value()
      899           .
      900         end.
      901         else do:
      902           assign
      903             v-new-value = "":U
      904           .
      905         end.
      906           if p-act-create = true then do:
      907             assign
      908               v-old-value = "":U
      909             .
      910           end.
      911           if p-act-delete = true then do:
      912             assign
      913               v-new-value = "":U
      914             .
      915           end.
      916         if v-old-value <> v-new-value
      917         then do:
      918           create temp-changes.
      919           assign
      920             temp-changes.t_name = p-main-table
      921             temp-changes.f_name = v-field-name
      922             temp-changes.l_name = replace( v-label, "&":U, "":U )
      923             temp-changes.v_old  = trim( v-old-value )
      924             temp-changes.v_new  = trim( v-new-value )
      925             temp-changes.num_   = 0
      926             temp-changes.fNotChange = v-old-value eq v-new-value
      927           .
      928         end.
      929       end.
      930     end.
      931     assign
      932       v-num-entries = num-entries( p-label-form, chr(8) )
      933     .
      934     do v-ind = 1 to v-num-entries
      935     on error undo, return error return-value
      936     :
      937       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      938         assign
      939           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      940           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      941           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      942         .
      943         find first temp-changes
      944           where temp-changes.f_name = v-field-name
      945           no-error .
      946         if available temp-changes then do:
      947           if trim( v-field-lvl ) <> "":U then do:
      948             assign
      949               temp-changes.l_name = v-field-lvl
      950             .
      951           end.
      952           if trim( v-field-form ) <> "":U then do:
      953             assign
      954               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      955             .
      956             if h-for-comp <> ? then do:
      957               assign
      958                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      959               .
      960             end.
      961           end.
      962         end.
      963       end.
      964       else do:
      965         message
      966           vss-workfile vss-revision vss-description skip
      967           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      968           substitute( "список для поля '&1': '&2'"
      969                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      970                       ,entry( v-ind, p-label-form, chr(8) )
      971                     ) skip
      972           substitute( "полный список: &2", p-label-form ) skip
      973           view-as alert-box error .
      974       end.
      975     end.
      976     delete object h-new-buf .
      977     delete object h-main-buf .
      978   END PROCEDURE.
      979   if p-action = integer('99':U) then return.
      980   find first buf_c-action-role no-lock where
      981       buf_c-action-role.db-num   = p-db-num
      982       AND buf_c-action-role.action-head-code = p-head-code
      983       AND buf_c-action-role.action-role-code = p-role-code
      984       AND buf_c-action-role.chip-num = p-chip-num
      985       AND buf_c-action-role.corr-user-db-num = p-corr-user-db-num
      986       no-error .
      987   if not available buf_c-action-role then
      988   do:
      989       return error .
      990   end.
      991   CASE p-subject:
      992       when 'action-role':U or
      993       when "":U then
      994           do:
      995               run action-role-proc in this-procedure(output p-description) no-error .
      996           end.
      997       when 'action-role-item':U then
      998           do:
      999               run action-role-item-proc in this-procedure(output p-description) no-error .
     1000           end.
     1001   END CASE.
     1002   if error-status:error then
     1003   do:
     1004       return error .
     1005   end.
     1006   procedure action-role-proc :
     1007       define output parameter p-description as character no-undo .
     1008       define buffer current_c-action-role for ub.c-action-role  .
     1009       do
     1010           on error undo, return error
     1011           :
     1012           find first current_c-action-role no-lock where
     1013               current_c-action-role.db-num   = p-db-num
     1014               AND current_c-action-role.action-head-code = p-head-code
     1015               AND current_c-action-role.action-role-code = p-role-code
     1016               AND current_c-action-role.corr-user-db-num = p-corr-user-db-num
     1017               AND current_c-action-role.chip-num = p-chip-num
     1018               no-error .
     1019           if not avail current_c-action-role then
     1020           do:
     1021               v-mess = "Неверная ссылка на c-action-role в таблице c-action-role".
     1022               run err-mess in this-procedure ( input-output v-mess).
     1023               return error (if p-silent then v-mess else '':U).
     1024           end.
     1025           define variable v-label-param as character no-undo .
     1026           v-label-param =
     1027               "action-head-code" + chr(4) + "Код заголовка права" + chr(4) + "" + chr(8)
     1028               + "action-role-code" + chr(4) + "Код роли" + chr(4) + "" + chr(8)
     1029               + "action-role-context" + chr(4) + "Контекст роли" + chr(4) + "" + chr(8)
     1030               + "action-role-name" + chr(4) + "Имя роли" + chr(4) + "" + chr(8)
     1031               + "action-role-description" + chr(4) + "Описание роли" + chr(4) + "" + chr(8)
     1032               + "db-num" + chr(4) + "БД" + chr(4) + "" + chr(8)
     1033               + "is-del" + chr(4) + "Группа прав удалена" + chr(4) + "" .
     1034           run proc-full-temp-changes in this-procedure (
     1035               input  (buf_c-action-role.action = integer('1':U))
     1036               ,input  (buf_c-action-role.action = integer('99':U))
     1037               ,input  buffer current_c-action-role:handle
     1038               ,input  'action-role':U
     1039               ,input  "action-head-code,action-role-code,action-role-context,action-role-name,action-role-description,db-num,is-del"
     1040               ,input  v-label-param).
     1041       end.
     1042   end procedure.
     1043   procedure action-role-item-proc :
     1044       define output parameter p-description as character no-undo .
     1045       define variable v-tooltip as character no-undo .
     1046       define variable v-label   as character no-undo .
     1047       define buffer current_c-action-role-item for ub.c-action-role-item  .
     1048       do
     1049           on error undo, return error
     1050           :
     1051           find first current_c-action-role-item no-lock where
     1052               current_c-action-role-item.db-num   = p-db-num
     1053               AND current_c-action-role-item.action-head-code = p-head-code
     1054               AND current_c-action-role-item.action-role-code = p-role-code
     1055               AND current_c-action-role-item.corr-user-db-num = p-corr-user-db-num
     1056               AND current_c-action-role-item.chip-num = p-chip-num
     1057               no-error .
     1058           if not avail current_c-action-role-item then
     1059           do:
     1060               v-mess = "Неверная ссылка на c-action-role-item в таблице c-action-role".
     1061               run err-mess in this-procedure ( input-output v-mess).
     1062               return error (if p-silent then v-mess else '':U).
     1063           end.
     1064           v-label =
     1065               "action-head-code" + chr(4) + "Код заголовка права" + chr(4) + "" + chr(8)
     1066               + "action-role-code" + chr(4) + "Код роли" + chr(4) + "" + chr(8)
     1067               + "action-role-item-code" + chr(4) + "Код действия" + chr(4) + "" + chr(8)
     1068               + "action-item-code" + chr(4) + "Код права" + chr(4) + "" + chr(8)
     1069               + "action-item-id" + chr(4) + "Идентификатор права" + chr(4) + "" + chr(8)
     1070               + "db-num" + chr(4) + "БД" + chr(4) + "" + chr(8)
     1071               + "is-del" + chr(4) + "Группа прав удалена" + chr(4) + "" .
     1072           run proc-full-temp-changes in this-procedure (
     1073               input  (buf_c-action-role.action = integer('1':U))
     1074               ,input  (buf_c-action-role.action = integer('99':U))
     1075               ,input  buffer current_c-action-role-item:handle
     1076               ,input  'action-role-item':U
     1077               ,input  "action-head-code,action-role-code,action-role-item-code,action-item-code,action-item-id,db-num,is-del"
     1078               ,input  v-label).
     1079       end.
     1080   end procedure.
     1081   PROCEDURE err-mess:
     1082       DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     1083       CASE p-silent:
     1084           when yes then
     1085               do:
     1086                   p-mess =  substitute("История групп прав  БД&1: щепка &2 Предмет изменений &3&4&5"
     1087                       , p-db-num
     1088                       , p-chip-num
     1089                       , p-subject
     1090                       , chr(10)
     1091                       , p-mess).
     1092               end.
     1093           otherwise
     1094           do:
     1095               message
     1096                   p-mess
     1097                   view-as alert-box error .
     1098           end.
     1099       end.
     1100   END PROCEDURE.
