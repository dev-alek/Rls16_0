        1   block-level on error undo, throw.
        2   using ibs.th.gbl.gbl-var.
        3   define input parameter p-mode as character no-undo .
        4   define input parameter p-silent as logical no-undo .
        5   define input parameter p-get-node-code as logical no-undo .
        6   define input-output parameter p-node-code  like ub.cli-grp.node-code no-undo .
        7   define input-output parameter p-upper-code like ub.cli-grp.upper-code no-undo .
        8   define input parameter p-node-name   like ub.cli-grp.node-name no-undo .
        9   define output parameter p-rid as recid no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: cb37b650f92a, 1185, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
       12   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:20:27 2017 +0300 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: cligrp01.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/cligrp01.p $":U .
       15   define variable vss-description as character no-undo init "Проверка и создание группы клиентов".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "X(65)" no-undo
       86   initial "@(#)$Workfile$ $Revision$".
       87   define temp-table temp_cgrplib_grp no-undo
       88       field sel           as character
       89       field full-name     as character
       90       field sort-name     as character
       91       field node-code     as integer
       92       field upper-code    as integer
       93       field d-pcnt        as decimal
       94       field name          as character
       95       field level         as integer
       96       field mark          as character
       97       index pi is primary unique sort-name
       98       index fn full-name
       99       index nc is unique node-code
      100       index sl sel
      101       index uc upper-code
      102   .
      103   define temp-table temp_cgrplib_found-grp no-undo
      104       field full-name   as character
      105       field sort-name   as character
      106       field node-code   as integer
      107       field level       as integer
      108       field is-terminal as logical
      109       field d-pcnt      as decimal
      110       index pi is primary unique sort-name
      111       index fn full-name
      112       index lv level
      113       index it is-terminal
      114   .
      115   define temp-table temp_cfound-result-nodelist no-undo
      116       field node-code     as recid
      117       field processed     as logical
      118       field full-name     as character
      119       field sort-name     as character
      120       index pi is primary unique node-code
      121       index ps processed
      122   .
      123   procedure cli-grplib-get-sort-name :
      124   do
      125   on error undo, return error
      126   :
      127   define input parameter p-node-code  as integer      no-undo.
      128   define output parameter p-sort-name as character    no-undo.
      129       define variable v-upper-code    as integer           no-undo.
      130       define buffer buf_cli-grp       for ub.cli-grp.
      131       define buffer buf_upper_cli-grp for ub.cli-grp.
      132       find first buf_cli-grp no-lock
      133            where buf_cli-grp.node-code = p-node-code
      134       no-error.
      135       if not available buf_cli-grp
      136       then do:
      137           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      138       end.
      139       assign
      140           p-sort-name  = ""
      141           v-upper-code = 1
      142       .
      143       do while buf_cli-grp.upper-code <> 0
      144       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
      145       :
      146           assign
      147               p-sort-name  = buf_cli-grp.node-name
      148                            + (if p-sort-name <> "" then chr(2) else "")
      149                            + p-sort-name
      150               v-upper-code = buf_cli-grp.upper-code
      151           .
      152           find first buf_cli-grp no-lock
      153                where buf_cli-grp.node-code = v-upper-code
      154           no-error.
      155           if not available buf_cli-grp
      156           then do:
      157               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
      158                                   + string( v-upper-code )
      159                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      160           end.
      161       end.
      162   end.
      163   end procedure.
      164   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   procedure cli-grplib-get-full-name :
      166      define input parameter  p-node-code  as integer      no-undo.
      167      define output parameter p-full-name as character    no-undo.
      168   do
      169   on error undo, return error
      170   :
      171       define variable v-upper-code    as integer           no-undo.
      172       define buffer buf_cli-grp       for ub.cli-grp.
      173       define buffer buf_upper_cli-grp for ub.cli-grp.
      174       find first buf_cli-grp no-lock
      175            where buf_cli-grp.node-code = p-node-code
      176       no-error.
      177       if not available buf_cli-grp
      178       then do:
      179           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      180       end.
      181       assign
      182           p-full-name  = ""
      183           v-upper-code = 1
      184       .
      185       do while buf_cli-grp.upper-code <> 0
      186       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      187       :
      188           assign
      189               p-full-name  = buf_cli-grp.node-name
      190                            + (if p-full-name <> "" then chr(47) else "")
      191                            + p-full-name
      192               v-upper-code = buf_cli-grp.upper-code
      193           .
      194           find first buf_cli-grp no-lock
      195                where buf_cli-grp.node-code = v-upper-code
      196           no-error.
      197           if not available buf_cli-grp
      198           then do:
      199               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      200                                   + string( v-upper-code )
      201                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      202           end.
      203       end.
      204       assign
      205       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      206       .
      207   end.
      208   end .
      209   procedure cgrplib-get-node-from-full-name :
      210   define input parameter p-full-name as character no-undo .
      211   define output parameter p-node-code as integer no-undo .
      212   define variable v-ii as integer no-undo .
      213   define variable v-upper-code as integer no-undo .
      214   define variable v-root-code as integer no-undo .
      215   define variable v-entry as character no-undo .
      216   define buffer buf_cli-grp       for ub.cli-grp.
      217   do
      218   on error undo, return error
      219   :
      220     find first buf_cli-grp no-lock
      221         where buf_cli-grp.upper-code = 0
      222     no-error .
      223     if not available buf_cli-grp
      224     then do:
      225         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      226     end.
      227     else do:
      228       assign
      229       v-root-code = buf_cli-grp.node-code
      230       .
      231     end.
      232     v-upper-code = v-root-code.
      233     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      234       assign
      235       v-entry = entry(v-ii, p-full-name, chr(47)).
      236       if v-entry = '' then leave.
      237       find first buf_cli-grp no-lock where
      238                 buf_cli-grp.node-name = v-entry
      239             and buf_cli-grp.upper-code = v-upper-code
      240             no-error.
      241       if not available buf_cli-grp then do:
      242         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      243       end.
      244       else do:
      245         p-node-code = buf_cli-grp.node-code.
      246         v-upper-code = buf_cli-grp.node-code.
      247       end.
      248     end.
      249   end.
      250   end .
      251   procedure cgrplib-get-root-code :
      252   do
      253   on error undo, return error
      254   :
      255   define output parameter p-root-code as integer      no-undo.
      256       define buffer buf_cli-grp       for ub.cli-grp.
      257       find first buf_cli-grp no-lock
      258           where buf_cli-grp.upper-code = 0
      259       no-error .
      260       if not available buf_cli-grp
      261       then do:
      262           undo, return error .
      263       end.
      264       else do:
      265           assign
      266               p-root-code = buf_cli-grp.node-code
      267           .
      268       end.
      269   end.
      270   end procedure.
      271   procedure cgrplib-find-grp-by-full-name :
      272   do
      273   on error undo, return error
      274   :
      275   define input parameter p-search-name  as character    no-undo.
      276   define input parameter p-fill-path    as logical      no-undo.
      277       define variable v-upper-code    as integer          no-undo.
      278       define variable v-not-found     as logical init yes no-undo.
      279       define variable v-counter       as integer           no-undo.
      280       define variable v-level         as integer           no-undo.
      281       define variable v-full-name     as character         no-undo.
      282       define variable v-sort-name     as character         no-undo.
      283       define buffer buf_cli-grp       for ub.cli-grp.
      284       assign
      285           p-search-name = replace( p-search-name, chr(47), chr(2) )
      286       .
      287       run cgrplib-get-root-code ( output v-upper-code ) no-error .
      288       if error-status :error
      289       then do:
      290           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
      291       end.
      292       assign
      293           v-full-name  = ""
      294           v-level      = num-entries( p-search-name, chr(2) )
      295       .
      296       for each temp_cgrplib_found-grp
      297       :
      298           delete temp_cgrplib_found-grp.
      299       end.
      300       start-name-analyze:
      301       do v-counter = 1 to v-level
      302       :
      303           if v-counter < v-level
      304           then do:
      305               find first buf_cli-grp no-lock
      306                    where buf_cli-grp.upper-code = v-upper-code
      307                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      308               no-error .
      309               if not available buf_cli-grp
      310               then do:
      311                   assign
      312                       v-full-name  = p-search-name
      313                       v-sort-name  = p-search-name
      314                   .
      315                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      316               end.
      317               else do:
      318                   assign
      319                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
      320                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
      321                       v-upper-code = buf_cli-grp.node-code
      322                   .
      323                   if p-fill-path = yes
      324                   then do:
      325                       create temp_cgrplib_found-grp.
      326                       assign
      327                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
      328                           temp_cgrplib_found-grp.sort-name = v-sort-name
      329                           temp_cgrplib_found-grp.node-code = v-upper-code
      330                           temp_cgrplib_found-grp.level     = v-counter
      331                       .
      332                   end.
      333               end.
      334           end.
      335           else do:
      336               for each buf_cli-grp no-lock
      337                  where buf_cli-grp.upper-code = v-upper-code
      338                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      339               :
      340                   assign
      341                       v-not-found = no
      342                   .
      343                   create temp_cgrplib_found-grp.
      344                   assign
      345                       temp_cgrplib_found-grp.full-name = v-full-name
      346                                                           + ( if v-full-name = "" then "" else chr(47) )
      347                                                           + buf_cli-grp.node-name + chr(47)
      348                       temp_cgrplib_found-grp.sort-name = v-sort-name
      349                                                           + ( if v-sort-name = "" then "" else chr(2) )
      350                                                           + buf_cli-grp.node-name
      351                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
      352                       temp_cgrplib_found-grp.level     = v-level
      353                   .
      354               end.
      355               if v-not-found = yes
      356               then do:
      357                   assign
      358                       v-full-name  = p-search-name
      359                       v-sort-name  = p-search-name
      360                   .
      361                   for each temp_cgrplib_found-grp
      362                   :
      363                       delete temp_cgrplib_found-grp.
      364                   end.
      365                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      366               end.
      367           end.
      368       end.
      369   end.
      370   end procedure.
      371   procedure cgrplib-find-all-subgroup :
      372   do
      373   on error undo, return error
      374   :
      375   define input parameter p-start-node-code    as integer      no-undo.
      376   define input parameter p-terminal-only      as logical      no-undo.
      377       define variable v-start-full-name   as character     no-undo.
      378       define variable v-start-sort-name   as character     no-undo.
      379       define variable v-not-found         as logical       no-undo.
      380       define variable v-is-terminal       as logical       no-undo.
      381       define variable v-d-pcnt            as decimal       no-undo.
      382       define buffer buf_cli-grp           for ub.cli-grp.
      383       create temp_cfound-result-nodelist.
      384       assign
      385           temp_cfound-result-nodelist.node-code = p-start-node-code
      386           temp_cfound-result-nodelist.processed = no
      387       .
      388       run cli-grplib-get-full-name in this-procedure (
      389             input p-start-node-code
      390           , output v-start-full-name
      391       ).
      392       run cli-grplib-get-sort-name in this-procedure (
      393             input p-start-node-code
      394           , output v-start-sort-name
      395       ).
      396       process-nodes:
      397       do while yes
      398       :
      399           find first temp_cfound-result-nodelist
      400                where temp_cfound-result-nodelist.node-code = p-start-node-code
      401           .
      402           assign
      403               temp_cfound-result-nodelist.processed = yes
      404           .
      405           for each buf_cli-grp no-lock
      406              where buf_cli-grp.upper-code = p-start-node-code
      407           on error undo, return error
      408           :
      409               run cgrplib-is-terminal in this-procedure (
      410                     input buf_cli-grp.node-code
      411                   , output v-is-terminal
      412               ).
      413               if v-is-terminal = yes
      414               then do:
      415                   create temp_cgrplib_found-grp.
      416                   assign
      417                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      418                                                           chr(47) + buf_cli-grp.node-name + chr(47)
      419                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      420                                                           chr(2) + buf_cli-grp.node-name + chr(2)
      421                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
      422                       temp_cgrplib_found-grp.is-terminal = yes
      423                   .
      424                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
      425                  if not error-status:error then do:
      426                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
      427                  end.
      428                  else do:
      429                    temp_cgrplib_found-grp.d-pcnt = ?.
      430                  end.
      431               end.
      432               else do:
      433                   create temp_cfound-result-nodelist.
      434                   assign
      435                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
      436                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      437                                                              chr(47) + buf_cli-grp.node-name + chr(47)
      438                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      439                                                              chr(2) + buf_cli-grp.node-name + chr(2)
      440                       temp_cfound-result-nodelist.processed = no
      441                   .
      442                   if p-terminal-only = no
      443                   then do:
      444                       create temp_cgrplib_found-grp.
      445                       assign
      446                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      447                                                               chr(47) + buf_cli-grp.node-name + chr(47)
      448                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      449                                                               chr(2) + buf_cli-grp.node-name + chr(2)
      450                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
      451                           temp_cgrplib_found-grp.is-terminal = no
      452                       .
      453                   end.
      454               end.
      455           end.
      456           find first temp_cfound-result-nodelist
      457                where temp_cfound-result-nodelist.processed = no
      458           no-error.
      459           if not available temp_cfound-result-nodelist
      460           then do:
      461               leave process-nodes.
      462           end.
      463           else do:
      464               assign
      465                   p-start-node-code = temp_cfound-result-nodelist.node-code
      466                   v-start-full-name = temp_cfound-result-nodelist.full-name
      467                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
      468               .
      469           end.
      470       end.
      471   end.
      472   end procedure.
      473   procedure cgrplib-expand-name :
      474   do
      475   on error undo, return error
      476   :
      477   define input parameter p-start-name as character        no-undo.
      478   define output parameter p-end-name  as character        no-undo.
      479       define variable v-is-terminal     as logical           no-undo.
      480       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
      481       run cgrplib-find-grp-by-full-name in this-procedure (
      482             input p-start-name
      483           , input no
      484       ) no-error.
      485       run cgrplib-get-max-substring in this-procedure (
      486                   input length( p-start-name )
      487                 , output p-end-name
      488       ) no-error .
      489       if error-status :error
      490       then do:
      491           assign
      492               p-end-name = ""
      493           .
      494       end.
      495       else do:
      496           find first temp_cgrplib_found-grp
      497               where temp_cgrplib_found-grp.full-name = p-end-name
      498           no-error.
      499           if available temp_cgrplib_found-grp
      500           then do:
      501               find first buf_temp_cgrplib_found-grp
      502                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
      503                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
      504               no-error.
      505               if not available buf_temp_cgrplib_found-grp
      506               then do:
      507                   run cgrplib-is-terminal in this-procedure (
      508                       input temp_cgrplib_found-grp.node-code
      509                       , output v-is-terminal
      510                   ).
      511               end.
      512           end.
      513       end.
      514   end.
      515   end procedure.
      516   procedure cgrplib-get-max-substring :
      517   do
      518   on error undo, return error
      519   :
      520   define input parameter p-min-substring-length   as integer      no-undo.
      521   define output parameter p-substring             as character    no-undo.
      522           define variable v-char-counter  as integer           no-undo.
      523           define variable v-current-char  as character         no-undo.
      524           define variable v-names-counter  as integer           no-undo.
      525           define variable v-base-string   as character         no-undo.
      526           assign
      527               v-char-counter  = p-min-substring-length
      528           .
      529           find first temp_cgrplib_found-grp no-error.
      530           if not available temp_cgrplib_found-grp
      531           then do:
      532               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
      533           end.
      534           else do:
      535               assign
      536                   v-base-string = temp_cgrplib_found-grp.full-name
      537               .
      538               counter-block:
      539               do while yes
      540               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      541               :
      542                   assign
      543                       v-char-counter  = v-char-counter + 1
      544                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      545                       v-names-counter = 0
      546                   .
      547                   compare-block:
      548                   for each temp_cgrplib_found-grp
      549                   :
      550                       assign
      551                           v-names-counter = v-names-counter + 1
      552                       .
      553                       if v-names-counter = 1
      554                       then do:
      555                           next compare-block.
      556                       end.
      557                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      558                       then do:
      559                           leave counter-block.
      560                       end.
      561                   end.
      562                   if v-names-counter = 1
      563                   then do:
      564                       assign
      565                           p-substring = v-base-string
      566                       .
      567                       return.
      568                   end.
      569               end.
      570               assign
      571                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      572               .
      573           end.
      574   end.
      575   end procedure.
      576   procedure cgrplib-is-terminal :
      577   do
      578   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
      579   :
      580   define input parameter p-node-code      as integer      no-undo.
      581   define output parameter p-is-terminal   as logical      no-undo.
      582       define buffer buf_cli-grp       for ub.cli-grp.
      583       find first buf_cli-grp no-lock
      584           where buf_cli-grp.upper-code = p-node-code
      585       no-error .
      586       if not available buf_cli-grp
      587       then do:
      588           assign
      589               p-is-terminal = yes
      590           .
      591       end.
      592       else do:
      593           assign
      594               p-is-terminal = no
      595           .
      596       end.
      597   end.
      598   end procedure.
      599   procedure cgrplib-have-clients :
      600   do
      601   on error undo, return error
      602   :
      603   define input parameter p-node-code      as integer      no-undo.
      604   define output parameter p-have-clients   as logical      no-undo.
      605       define buffer buf_clients         for ub.clients.
      606       find first buf_clients no-lock
      607            where buf_clients.grp-code = p-node-code
      608       no-error .
      609       if available buf_clients
      610       then do:
      611           assign
      612               p-have-clients = yes
      613           .
      614       end.
      615       else do:
      616           assign
      617               p-have-clients = no
      618           .
      619       end.
      620   end.
      621   end procedure.
      622   procedure cgrplib-find-by-substring :
      623   do
      624   on error undo, return error
      625   :
      626   define input parameter p-start-code         as integer      no-undo.
      627   define input parameter p-full-search-string as character    no-undo.
      628   define output parameter p-found-code        as integer      no-undo.
      629   define output parameter p-full-name         as character    no-undo.
      630       define variable v-start-code     as integer           no-undo.
      631       define variable v-found          as logical  init no  no-undo.
      632       define buffer buf_cli-grp       for ub.cli-grp.
      633       search-grp:
      634       for each buf_cli-grp no-lock
      635           where buf_cli-grp.node-code > p-start-code
      636       :
      637           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
      638           then do:
      639               assign
      640                   p-found-code = buf_cli-grp.node-code
      641                   v-found      = yes
      642               .
      643               run cli-grplib-get-full-name in this-procedure (
      644                     input p-found-code
      645                   , output p-full-name
      646               ) no-error .
      647               if error-status :error
      648               then do:
      649                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      650               end.
      651               leave search-grp.
      652           end.
      653       end.
      654       if v-found = yes
      655       then do:
      656       end.
      657       else do:
      658           assign
      659               p-full-name  = ""
      660               p-found-code = 0
      661           .
      662       end.
      663   end.
      664   end procedure.
      665   procedure cgrplib-analyze-grp-name :
      666   do
      667   on error undo, return error
      668   :
      669   define input parameter p-grp-name       as character            no-undo.
      670   define input parameter p-upper-code     as integer              no-undo.
      671   define output parameter p-error-message as character init ""    no-undo.
      672       define variable v-char-list     as character    no-undo.
      673       define variable v-char-counter  as integer      no-undo.
      674       define variable v-full-name     as character    no-undo.
      675       if p-grp-name = "" then do:
      676           assign
      677               p-error-message = "Название группы не может быть пустым.".
      678           .
      679       end.
      680       else do:
      681           assign
      682               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      683           .
      684           do v-char-counter = 1 to num-entries( v-char-list )
      685           :
      686               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      687               then do:
      688                   assign
      689                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      690                   .
      691                   return.
      692               end.
      693           end.
      694           run cli-grplib-get-full-name in this-procedure (
      695                 input p-upper-code
      696               , output v-full-name
      697           ) no-error .
      698           if error-status :error
      699           then do:
      700               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      701           end.
      702           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
      703           then do:
      704               assign
      705                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
      706               .
      707           end.
      708       end.
      709   end.
      710   end procedure.
      711   procedure cgrplib-get-lvl-num :
      712   define input parameter p-node-code  as integer      no-undo.
      713   define output parameter p-lvl-num   as integer      no-undo.
      714       define variable v-full-name    as character    no-undo.
      715   do
      716   on error undo, return error
      717   :
      718       run cli-grplib-get-full-name in this-procedure (
      719             input p-node-code
      720           , output v-full-name
      721       ).
      722       assign
      723           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      724       .
      725       if p-lvl-num = -1
      726       then do:
      727           assign
      728               p-lvl-num = 0
      729           .
      730       end.
      731   end.
      732   end procedure.
      733   PROCEDURE cgrplib-get-pcnt-value :
      734   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
      735   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
      736   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
      737   define buffer buf_dis-rule for ub.dis-rule.
      738   find first buf_dis-grp-rule no-lock where
      739             buf_dis-grp-rule.classif-type = 'cli-grp':U
      740         and buf_dis-grp-rule.node-code = p-node-code
      741         and buf_dis-grp-rule.host-code = 0
      742         and buf_dis-grp-rule.obj-type = '':U
      743         and buf_dis-grp-rule.obj-code = 0
      744         and buf_dis-grp-rule.pos-type = '-':U
      745         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
      746   if available buf_dis-grp-rule then do:
      747     find first buf_dis-rule no-lock where
      748               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
      749     if available buf_dis-rule then do:
      750       assign
      751       p-pcnt-value        = buf_dis-rule.discnt-value.
      752       .
      753     end.
      754   end.
      755   END PROCEDURE.
      756   DEFINE VARIABLE v-full-name as character no-undo .
      757   DEFINE VARIABLE v-error-message as character no-undo .
      758   DEFINE VARIABLE v-list as character no-undo .
      759   DEFINE VARIABLE v-node-code like ub.cli-grp.node-code no-undo .
      760   define variable v-last-node-code as integer no-undo .
      761   define buffer upper_cli-grp  for ub.cli-grp.
      762   define buffer buf_cli-grp for ub.cli-grp.
      763   main-block:
      764   do
      765   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      766   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      767   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      768   :
      769   define variable v-value as character no-undo.
      770   define variable v-ttype as character no-undo.
      771     if NOT (p-mode = 'ДОБАВЛЕНИЕ':U or p-mode = 'ИЗМЕНЕНИЕ':U) then do:
      772       message
      773       vss-workfile vss-revision vss-description skip
      774       "Неверное значение параметра p-mode" p-mode
      775       view-as alert-box error .
      776       undo main-block, return error .
      777     end.
      778       run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-ttype) no-error.
      779       if v-value = "no"  then do:
      780     if gbl-var:g#db-num <> 0 then do:
      781       message
      782       vss-workfile vss-revision vss-description skip
      783       "Нельзя добавлять/изменить группы клиентов в УБД"
      784       view-as alert-box error .
      785       undo main-block, return error .
      786     end.
      787     end.
      788     if p-node-name = ""
      789     or p-node-name = ? then do:
      790       assign
      791       v-error-message = substitute("Не задано название группы" ).
      792       run err-mess in this-procedure ( input-output v-error-message).
      793       undo main-block, return error (if p-silent then v-error-message else "node-name").
      794     end.
      795     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      796       find first buf_cli-grp exclusive-lock
      797            where buf_cli-grp.node-code = p-node-code no-error no-wait .
      798       if locked(buf_cli-grp) then do:
      799         v-error-message = substitute(  "Запись о группе клиентов с внутр. № [&1] занята другим пользователем",  p-node-code  ).
      800         run err-mess in this-procedure (input-output v-error-message).
      801         undo main-block, return error (if p-silent then v-error-message else "node-code").
      802       end.
      803       if not available buf_cli-grp then do:
      804         v-error-message = substitute(  "Запись о группе клиентов с внутр. № [&1] отсутствует",  p-node-code  ).
      805         run err-mess in this-procedure (input-output v-error-message).
      806         undo main-block, return error (if p-silent then v-error-message else "node-code").
      807       end.
      808       if buf_cli-grp.upper-code <> p-upper-code then do:
      809         v-error-message = substitute(
      810           "Расхождение текущего кода родителя с параметрами обновления у группы клиентов с внутр. № [&1].&3" +
      811           "Код родителя у группы = [&2], код родителя в параметрах обновления = [&4]",
      812           p-node-code, buf_cli-grp.upper-code, chr(10), p-upper-code
      813         ) .
      814         run err-mess in this-procedure (input-output v-error-message).
      815         undo main-block, return error (if p-silent then v-error-message else "node-code").
      816       end.
      817       assign
      818       p-rid = recid(buf_cli-grp)
      819       .
      820       run cli-grplib-get-full-name in this-procedure (
      821                                                   input p-node-code
      822                                                  ,output v-full-name).
      823     end.
      824     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      825       find first upper_cli-grp exclusive-lock where
      826                  upper_cli-grp.node-code = p-upper-code no-error .
      827       if not avail upper_cli-grp then do:
      828         assign
      829         v-error-message = substitute("Не найдена группа верхнего уровня с внутр. № &1", p-upper-code).
      830         run err-mess in this-procedure ( input-output v-error-message).
      831         undo main-block, return error (if p-silent then v-error-message else "upper-code").
      832       end.
      833       if p-get-node-code = yes then do:
      834         find last buf_cli-grp no-lock use-index pi.
      835         assign
      836         v-last-node-code = buf_cli-grp.node-code.
      837         find first buf_cli-grp no-lock where
      838                   buf_cli-grp.node-code = p-node-code no-error.
      839         if available buf_cli-grp then do:
      840           assign
      841           v-error-message = substitute("Уже есть группа с внутр. № &1", p-node-code).
      842           run err-mess in this-procedure ( input-output v-error-message).
      843           undo main-block, return error (if p-silent then v-error-message else "node-code").
      844         end.
      845       end.
      846       run cli-grplib-get-full-name in this-procedure (
      847                                                   input p-upper-code
      848                                                  ,output v-full-name).
      849       assign
      850       v-full-name = v-full-name + chr(47) + p-node-name + chr(47)
      851       .
      852     end.
      853     run  cgrplib-analyze-grp-name in this-procedure
      854                                                     ( input p-node-name
      855                                                      ,input p-upper-code
      856                                                      ,output v-error-message ) no-error .
      857     if error-status:error or v-error-message <> "":U then do:
      858       assign
      859       v-error-message = substitute("&1", v-error-message).
      860       run err-mess in this-procedure ( input-output v-error-message).
      861       undo main-block, return error (if p-silent then v-error-message else "node-name").
      862     end.
      863     if can-find (ub.cli-grp where ub.cli-grp.upper-code = p-upper-code
      864                               AND ub.cli-grp.node-name  = p-node-name
      865                           AND recid (ub.cli-grp) <> p-rid) then do:
      866       v-error-message = substitute(
      867         "В группе верхнего уровня с внутр. № [&1] уже есть группа с названием [&2].&3" +
      868         "Внутр. № существующей группы отличается от внутр. № [&4] добавляемой группы",
      869         p-upper-code, p-node-name, chr(10), p-node-code
      870       ) .
      871       run err-mess in this-procedure ( input-output v-error-message).
      872       undo main-block, return error (if p-silent then v-error-message else "node-name").
      873     end.
      874     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      875       create buf_cli-grp.
      876       assign
      877       buf_cli-grp.node-code = (if p-get-node-code
      878                                then p-node-code
      879                                else next-value (s-cli-grp, ub))
      880       buf_cli-grp.upper-code = p-upper-code
      881       p-node-code = buf_cli-grp.node-code
      882       .
      883     end.
      884     assign
      885     buf_cli-grp.node-name = p-node-name
      886     p-rid = recid(buf_cli-grp)
      887     v-node-code = buf_cli-grp.node-code
      888     .
      889     release buf_cli-grp no-error .
      890     if error-status:error then do:
      891       assign
      892       v-error-message = substitute("Ошибка при сохранении группы клиентов:&1&2&1&3"
      893                                    , chr(10)
      894                                    , error-status:get-message(1)
      895                                    , return-value  ).
      896       run err-mess in this-procedure ( input-output v-error-message).
      897       undo main-block, return error (if p-silent then v-error-message else "").
      898     end.
      899     if p-mode = 'ДОБАВЛЕНИЕ':U
      900     and p-get-node-code
      901     and p-node-code > v-last-node-code
      902     then do:
      903       run adm/restseqr.p
      904         ( input "rest-no-msg":U
      905         ,input "s-cli-grp":U
      906         ,input no
      907         ) no-error .
      908       if error-status :error then do:
      909         assign
      910         v-error-message = substitute("Ошибка при восстановлении последовательности вн.№ групп клиентов:&1&2&1&3"
      911                                     , chr(10)
      912                                     , error-status:get-message(1)
      913                                     , return-value  ).
      914         run err-mess in this-procedure ( input-output v-error-message).
      915         undo main-block, return error (if p-silent then v-error-message else "").
      916       end.
      917     end.
      918   end.
      919   PROCEDURE err-mess:
      920     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      921     CASE p-silent:
      922       when yes then do:
      923         assign
      924         p-mess = substitute("Группа c внутр. №: &1 (&2):&3&4"
      925                            , p-node-code
      926                            , p-node-name
      927                            , chr(10)
      928                            , p-mess)
      929         .
      930       end.
      931       when no then do:
      932         message
      933         p-mess
      934         view-as alert-box error .
      935       end.
      936     end.
      937   END PROCEDURE.
