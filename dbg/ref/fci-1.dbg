        1   DEFINE BUFFER buf_fin-code FOR ub.fin-code-cor-acc.
        2   define input parameter        ref-mode as character no-undo .
        3   define input-output parameter ri       as recid no-undo.
        4   define input parameter par-host-code as integer no-undo .
        5   define variable tcode as character no-undo .
        6   define variable p-fin-code as integer no-undo .
        7   define variable fin-type-acc as WIDGET-handle no-undo .
        8   def var vss-revision    as character no-undo init "$Revision$":U .
        9   def var vss-author      as character no-undo init "$Author$":U .
       10   def var vss-date        as character no-undo init "$Date$":U .
       11   def var vss-workfile    as character no-undo init "$Workfile$":U .
       12   def var vss-archive     as character no-undo init "$Archive$":U .
       13   def var vss-description as character no-undo init "Корректировка справочника в ФИНБлоке кор счетов ".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   procedure proc-alt-shift-f2:
       84     if not ibs.th.gbl.gbl-var:rcode
       85   then
       86     run gbl\inidebug.p .
       87   end.
       88   procedure proc-alt-shift-f3:
       89     run gbl/prvssinf.p
       90       ( input this-procedure
       91       ) .
       92   end.
       93   define variable v-inform-launched as logical no-undo initial false .
       94   procedure proc-alt-shift-f4:
       95     define variable v-action as character no-undo .
       96     if v-inform-launched = false then do:
       97       assign
       98         v-inform-launched = true
       99       .
      100       run gbl/d-inform.w
      101         (  input self
      102         ,  input this-procedure
      103         , output v-action
      104         ) no-error .
      105       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      106       assign
      107         v-inform-launched = false
      108       .
      109     end.
      110   end.
      111   procedure proc-alt-f1:
      112     run gbl/corrhelp.p
      113       (input this-procedure
      114       ) .
      115   end .
      116   on alt-shift-f2 anywhere do:
      117     run proc-alt-shift-f2.
      118   end.
      119   on alt-shift-f3 anywhere do:
      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   procedure cur-time :
      130      define output parameter p-today as date      no-undo .
      131      define output parameter p-time  as integer   no-undo .
      132     do
      133     on error undo, return error
      134     :
      135       define variable v-date1 as date      no-undo .
      136       define variable v-date2 as date      no-undo .
      137       define variable v-time  as integer   no-undo .
      138       assign
      139         v-date1 = today
      140         v-time  = time
      141         v-date2 = today
      142       .
      143       if v-date1 <> v-date2
      144       then do:
      145         assign
      146           v-date1 = today
      147           v-time  = v-time
      148         .
      149       end.
      150       assign
      151         p-today = v-date1
      152         p-time  = v-time
      153       .
      154     end.
      155   end.
      156   function cur-time-date returns character
      157   :
      158     return string(today, '99/99/9999':U) .
      159   end.
      160   function cur-time-mjd returns decimal
      161   :
      162     define variable v-date as date      no-undo .
      163     define variable v-time as integer   no-undo .
      164     run cur-time in this-procedure
      165       (output v-date
      166       ,output v-time
      167       ) .
      168     return integer(v-date) - 2400002 + (v-time / 86400) .
      169   end.
      170   function cur-time-get-ending-index returns integer
      171   (input p-number as integer
      172   )
      173   :
      174     if p-number < 0
      175     or p-number = ?
      176     then do:
      177       return 1 .
      178     end.
      179     define variable v-rest as integer   no-undo .
      180     assign
      181       p-number = p-number modulo 100
      182     .
      183     if p-number < 20
      184     then do:
      185       assign
      186         v-rest = p-number
      187       .
      188     end.
      189     else do:
      190       assign
      191         v-rest = p-number modulo 10
      192       .
      193     end.
      194     case v-rest :
      195       when 1
      196       then do:
      197         return 2 .
      198       end.
      199       when 2 or
      200       when 3 or
      201       when 4
      202       then do:
      203         return 3 .
      204       end.
      205       otherwise do:
      206         return 1 .
      207       end.
      208     end case .
      209   end.
      210   procedure cur-time-mjd-to-date :
      211      define input  parameter i-mjd-diff as decimal no-undo.
      212      define output parameter o-Date     as date    no-undo.
      213      define output parameter o-Time     as integer no-undo.
      214      define variable v-day-number as integer   no-undo .
      215      if    i-mjd-diff < 0
      216         or i-mjd-diff = ?
      217      then do:
      218         return "?" .
      219      end.
      220      assign
      221         v-day-number = truncate(i-mjd-diff,0).
      222         o-Date = date(v-day-number + 2400002).
      223         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      224     .
      225   end.
      226   function cur-time-mjd-to-string returns character
      227   (input p-mjd-diff as decimal
      228   )
      229   :
      230     define variable v-day-number as integer   no-undo .
      231     define variable v-seconds    as integer   no-undo .
      232     define variable v-hour       as integer   no-undo .
      233     define variable v-min        as integer   no-undo .
      234     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      235     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      236     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      237     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      238     if p-mjd-diff < 0
      239     or p-mjd-diff = ?
      240     then do:
      241       return "?" .
      242     end.
      243     assign
      244       v-day-number = integer(truncate(p-mjd-diff,0))
      245       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      246     .
      247     if v-seconds > 86400
      248     then do:
      249       assign
      250         v-seconds = 86400 - 1
      251       .
      252     end.
      253     if v-seconds < 0
      254     then do:
      255       assign
      256         v-seconds = 0
      257       .
      258     end.
      259     assign
      260       v-hour = truncate(v-seconds / 3600, 0)
      261     .
      262     assign
      263       v-seconds = v-seconds modulo 3600
      264     .
      265     assign
      266       v-min = truncate(v-seconds / 60, 0)
      267     .
      268     assign
      269       v-seconds = v-seconds modulo 60
      270     .
      271     return
      272         (if v-day-number <> 0
      273           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      274           else ""
      275         )
      276       + (if v-day-number <> 0 or v-hour <> 0
      277           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      278           else ""
      279         )
      280       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      281           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      282           else ""
      283         )
      284       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      285       .
      286   end.
      287   function cur-time-string returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-string-sec returns character
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      306   end.
      307   function cur-time-custom  returns character
      308   (input p-prefix as character
      309   ,input p-date-format as character
      310   ,input p-delimiter as character
      311   ,input p-time-format as character
      312   ,input p-suffix as character
      313   )
      314   :
      315     define variable v-date as date      no-undo .
      316     define variable v-time as integer   no-undo .
      317     run cur-time in this-procedure
      318       (output v-date
      319       ,output v-time
      320       ) .
      321     return
      322       p-prefix
      323       + string(v-date, p-date-format)
      324       + p-delimiter
      325       + string(v-time, p-time-format)
      326       + p-suffix
      327       .
      328   end.
      329   function cur-time-print  returns character
      330   :
      331     define variable v-date as date      no-undo .
      332     define variable v-time as integer   no-undo .
      333     run cur-time in this-procedure
      334       (output v-date
      335       ,output v-time
      336       ) .
      337     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      338   end.
      339   function cur-time-datetime returns datetime
      340   :
      341     define variable v-char as character no-undo .
      342     define variable v-datetime as datetime no-undo .
      343     v-char = cur-time-string().
      344     v-datetime = datetime(v-char).
      345     return  v-datetime.
      346   end.
      347   function cur-time-string-msec returns character
      348   :
      349     define variable v-date as datetime  no-undo .
      350     v-date = now.
      351     return string(v-date) .
      352   end.
      353   DEFINE BUTTON b-exit AUTO-GO
      354        LABEL "&Ввод "
      355        SIZE 10 BY 1.
      356   DEFINE BUTTON b-help AUTO-GO
      357        LABEL "Помо&щь"
      358        SIZE 10 BY 1.
      359   DEFINE BUTTON b-quit AUTO-END-KEY
      360        LABEL "&Отмена"
      361        SIZE 10 BY 1.
      362   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Уровни для сбора аналитики"
      363         VIEW-AS TEXT
      364        SIZE 27.2 BY .67
      365        FGCOLOR 4  NO-UNDO.
      366   DEFINE RECTANGLE RECT-1
      367        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      368        SIZE 68.8 BY 2.52.
      369   DEFINE QUERY Dialog-Frame FOR
      370         fin-code-cor-acc,
      371         buf_fin-code SCROLLING.
      372   DEFINE FRAME Dialog-Frame
      373        b-exit AT ROW 1 COL 1
      374        b-quit AT ROW 1 COL 11.2
      375        b-help AT ROW 1 COL 62.2
      376        fin-code-cor-acc.code-value AT ROW 2.38 COL 6.8 COLON-ALIGNED
      377             LABEL "Код"
      378             VIEW-AS FILL-IN
      379             SIZE 13 BY 1 TOOLTIP "Код спрпавочника"
      380        fin-code-cor-acc.descr AT ROW 6.24 COL 1 NO-LABEL
      381             VIEW-AS FILL-IN
      382             SIZE 69.8 BY 1
      383        fin-code-cor-acc.level-1 AT ROW 8.43 COL 12.2 COLON-ALIGNED FORMAT ">>>9"
      384             VIEW-AS FILL-IN
      385             SIZE 5.8 BY 1
      386        fin-code-cor-acc.level-2 AT ROW 8.43 COL 32.4 COLON-ALIGNED FORMAT ">>>9"
      387             VIEW-AS FILL-IN
      388             SIZE 6.2 BY 1
      389        fin-code-cor-acc.level-3 AT ROW 8.43 COL 58.6 COLON-ALIGNED FORMAT ">>>9"
      390             VIEW-AS FILL-IN
      391             SIZE 5.8 BY 1
      392        FILL-IN-1 AT ROW 7.43 COL 21.2 COLON-ALIGNED NO-LABEL
      393        "Наименование" VIEW-AS TEXT
      394             SIZE 16 BY .62 AT ROW 5.29 COL 1 WIDGET-ID 2
      395        RECT-1 AT ROW 7.48 COL 1
      396        SPACE(2.45) SKIP(0.24)
      397       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      398            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      399            TITLE "Корректировка справочника"
      400            CANCEL-BUTTON b-quit.
      401   ASSIGN
      402          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      403          FRAME Dialog-Frame:HIDDEN           = TRUE.
      404   ON GO OF FRAME Dialog-Frame
      405   DO:
      406     def var rr as recid no-undo.
      407     if input ub.fin-code-cor-acc.code-value = "" then do:
      408         message "Код  не может быть не задан" view-as alert-box.
      409         apply "ENTRY":U to ub.fin-code-cor-acc.code-value.
      410         return no-apply.
      411     end.
      412     if  input ub.fin-code-cor-acc.descr = ""  then do:
      413         message "Введите наименование " view-as alert-box WARNING.
      414         apply "ENTRY":U to ub.fin-code-cor-acc.descr.
      415         return no-apply.
      416     end.
      417     rr = recid( ub.fin-code-cor-acc ).
      418     if ref-mode =  'ДОБАВЛЕНИЕ':U then do:
      419       if can-find(first ub.fin-code-cor-acc where ub.fin-code-cor-acc.code-value = input ub.fin-code-cor-acc.code-value
      420                                          AND recid( ub.fin-code-cor-acc ) <> rr
      421                                          and ub.fin-code-cor-acc.host-code = par-host-code
      422                                            ) then do:
      423           message "Запись с кодом" input ub.fin-code-cor-acc.code-value "уже существует!" skip
      424                 "Если ее нет в списке, то она логически удалена."
      425                 view-as alert-box warning.
      426           apply "ENTRY":U to ub.fin-code-cor-acc.code-value.
      427           return no-apply.
      428       end.
      429     end.
      430     if ref-mode <> 'ПРОСМОТР':U then do:
      431         assign ub.fin-code-cor-acc.code-value
      432                ub.fin-code-cor-acc.descr
      433                ub.fin-code-cor-acc.level-1
      434                ub.fin-code-cor-acc.level-2
      435                ub.fin-code-cor-acc.level-3
      436                ri = recid( ub.fin-code-cor-acc )
      437          .
      438                 if lookup(fin-type-acc:screen-value,'1,2,3':U ) > 0 then
      439                    ub.fin-code-cor-acc.acc-type = integer (fin-type-acc:screen-value ).
      440                   else message 123 error-status :get-message(1) fin-type-acc:screen-value integer(fin-type-acc:screen-value)     .
      441     end.
      442   END.
      443   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      444   DO:
      445     apply "CHOOSE" to b-quit IN FRAME Dialog-Frame .
      446     APPLY "END-ERROR":U TO SELF.
      447   END.
      448   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      449   DO:
      450     ri = ? .
      451     if ref-mode =  'ДОБАВЛЕНИЕ':U then do:
      452         find current ub.fin-code-cor-acc  exclusive-lock   no-error.
      453         if available ub.fin-code-cor-acc then do:
      454            delete ub.fin-code-cor-acc.
      455         end.
      456     end.
      457   END.
      458   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      459   define buffer buf_file for ub.fin-code-cor-acc .
      460   procedure current-db :
      461    do
      462    on error undo, return error return-value
      463    :
      464   define input parameter  p-host-code as integer no-undo .
      465   define input parameter  c-host-code as integer no-undo .
      466   define output parameter ret         as logical no-undo .
      467   define buffer current_sysconf for ub.sysconf.
      468   define variable v-current-db as integer no-undo .
      469   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      470   if error-status :error then return error .
      471      v-current-db = current_sysconf.firm-db-num .
      472      ret = true .
      473   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
      474   if not( ub.sysconf.firm-db-num = v-current-db or
      475           ub.sysconf.firm-db-num = 0 )
      476     then do:
      477     ret = false .
      478     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
      479     return .
      480   end.
      481    end.
      482   end procedure.
      483   procedure ver-db :
      484    do
      485    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      486    :
      487   define input parameter  c-host-code as integer no-undo .
      488   define input parameter  par-ver-db  as integer no-undo .
      489   define input parameter  p-mess as logical no-undo .
      490   define output parameter ret         as logical no-undo .
      491   define buffer current_sysconf for ub.sysconf.
      492   define variable v-current-db as integer no-undo .
      493   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
      494   if error-status :error then return error .
      495      v-current-db = current_sysconf.firm-db-num .
      496      ret = true .
      497   if not( par-ver-db = v-current-db or
      498           par-ver-db = 0 )
      499     then do:
      500     ret = false .
      501     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
      502     return .
      503   end.
      504    end.
      505   end procedure.
      506   procedure fin-code :
      507    do
      508    on error undo, return error return-value
      509    :
      510     define input  parameter p-host-code as integer no-undo .
      511     define output parameter p-fin-code  as integer no-undo .
      512     p-fin-code = next-value(s-fin-code, ub) .
      513    end.
      514   end procedure.
      515   procedure create-ref-fin-code :
      516    do
      517    on error undo, return error return-value
      518    :
      519   define input parameter p-ver as logical no-undo .
      520   define input parameter p-host-code  as integer   no-undo .
      521   define input parameter p-fin-code   as integer   no-undo .
      522   define input parameter p-code-value as character no-undo .
      523   define input parameter p-descr      as character no-undo .
      524   define input parameter p-status_    as integer   no-undo .
      525   define input parameter p-level-1    as integer   no-undo .
      526   define input parameter p-level-2    as integer   no-undo .
      527   define input parameter p-level-3    as integer   no-undo .
      528   if p-ver then do:
      529       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
      530                                           buf_file.fin-code  = p-fin-code no-error .
      531       if available buf_file then return error .
      532   end.
      533   define variable p-ret as logical no-undo .
      534   run current-db in this-procedure (
      535       input p-host-code,
      536       input p-host-code,
      537       output p-ret ) .
      538    if p-ret = no then return.
      539    create ub.fin-code-cor-acc.
      540    assign
      541      ub.fin-code-cor-acc.host-code  = p-host-code
      542      ub.fin-code-cor-acc.fin-code   = p-fin-code
      543      ub.fin-code-cor-acc.code-value = p-code-value
      544      ub.fin-code-cor-acc.descr      = p-descr
      545      ub.fin-code-cor-acc.status_    = p-status_
      546      ub.fin-code-cor-acc.level-1    = p-level-1
      547      ub.fin-code-cor-acc.level-2    = p-level-2
      548      ub.fin-code-cor-acc.level-3    = p-level-3
      549     no-error .
      550     if error-status :error then do:
      551         message vss-include-info1 skip
      552                 error-status :get-message(1)
      553                 view-as alert-box error .
      554         return error .
      555     end.
      556    end.
      557   end procedure.
      558   procedure create-ref-corr-acc :
      559    do
      560    on error undo, return error return-value
      561    :
      562   define input parameter p-ver as logical no-undo .
      563   define input parameter p-host-code  as integer   no-undo .
      564   define input parameter p-fin-code   as integer   no-undo .
      565   define input parameter p-code-value as character no-undo .
      566   define input parameter p-descr      as character no-undo .
      567   define input parameter p-status_    as integer   no-undo .
      568   define input parameter p-level-1    as integer   no-undo .
      569   define input parameter p-level-2    as integer   no-undo .
      570   define input parameter p-level-3    as integer   no-undo .
      571   define input parameter p-acc-type    as integer   no-undo .
      572   define buffer buf_file  for ub.fin-code-cor-acc .
      573   if p-ver then do:
      574       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
      575                                           buf_file.fin-code  = p-fin-code no-error .
      576       if available buf_file then return error .
      577   end.
      578   define variable p-ret as logical no-undo .
      579   run current-db in this-procedure (
      580       input p-host-code,
      581       input p-host-code,
      582       output p-ret ) .
      583    if p-ret = no then return.
      584    create ub.fin-code-cor-acc.
      585    assign
      586      ub.fin-code-cor-acc.host-code  = p-host-code
      587      ub.fin-code-cor-acc.fin-code   = p-fin-code
      588      ub.fin-code-cor-acc.code-value = p-code-value
      589      ub.fin-code-cor-acc.descr      = p-descr
      590      ub.fin-code-cor-acc.status_    = p-status_
      591      ub.fin-code-cor-acc.level-1    = p-level-1
      592      ub.fin-code-cor-acc.level-2    = p-level-2
      593      ub.fin-code-cor-acc.level-3    = p-level-3
      594      ub.fin-code-cor-acc.acc-type   = p-acc-type
      595     no-error .
      596     if error-status :error then do:
      597         message vss-include-info1 skip
      598                 error-status :get-message(1)
      599                 view-as alert-box error .
      600         return error .
      601     end.
      602    end.
      603   end procedure.
      604   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      605   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      606   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      607   on help of frame Dialog-Frame
      608   do:
      609     run gbl/app_help.p
      610       (input this-procedure :file-name
      611       ,input ''
      612       ,input ?
      613       ) no-error.
      614     if error-status :error then do:
      615       message
      616         "Ошибка при вызове помощи"
      617         error-status :get-message(1)
      618         view-as alert-box .
      619     end.
      620   end.
      621   run minbtn-set in this-procedure .
      622   on choose of b-help in frame Dialog-Frame
      623   do:
      624     apply "help":u to frame Dialog-Frame .
      625   end.
      626   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      627   procedure minbtn-set :
      628       do
      629           on error undo, return error return-value
      630           :
      631           define variable ii              as integer       no-undo .
      632           define variable fh              as widget-handle no-undo .
      633           define variable hh              as widget-handle no-undo .
      634           define variable v-h             as handle        extent 4 no-undo .
      635           define variable v-name-button   as character     no-undo .
      636           define variable v-help-old-x    as decimal       no-undo .
      637           define variable v-help-old-y    as decimal       no-undo .
      638           define variable v-help-old-size as decimal       no-undo .
      639           define variable v-frame-width   as decimal       no-undo .
      640           define variable jj              as integer       no-undo .
      641           do
      642               on error undo, return error
      643               :
      644               assign
      645                   v-frame-width = frame Dialog-Frame:width - 0.3
      646                   fh            = frame Dialog-Frame:first-child
      647                   hh            = fh:first-child
      648                   ii            = 1
      649                   .
      650               do while valid-handle(hh):
      651                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      652                   do:
      653                       case lc(hh:name) :
      654                           when "b-help" then
      655                               do:
      656                                   hh:load-image-up("cmp/b-help.bmp":u) .
      657                                   hh:load-image-down("cmp/b-help.bmp":u) .
      658                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      659                                   hh:TOOLTIP = "Помощь" .
      660                                   v-help-old-x = hh:column .
      661                                   v-help-old-y = hh:row    .
      662                                   v-help-old-size = hh:width .
      663                                   hh:width-chars = 2.5 .
      664                               end.
      665                           when "b-print" then
      666                               do:
      667                                   hh:load-image("cmp/b-print.bmp":u) .
      668                                   hh:TOOLTIP = "Печать" .
      669                                   v-h[ii] = hh:handle .
      670                                   ii = ii + 1 .
      671                                   hh:width-chars = 3 .
      672                               end.
      673                           when "b-history" or
      674                           when "b-hist" then
      675                               do:
      676                                   hh:load-image("cmp/b-hist.bmp":u) .
      677                                   hh:TOOLTIP = "История" .
      678                                   v-h[ii] = hh:handle .
      679                                   ii = ii + 1 .
      680                                   hh:width-chars = 3 .
      681                               end.
      682                           when "b-sch" then
      683                               do:
      684                                   hh:load-image("cmp/b-sch.bmp":u) .
      685                                   hh:TOOLTIP = "Установка Фильтра" .
      686                                   v-h[ii] = hh:handle .
      687                                   ii = ii + 1 .
      688                                   hh:width-chars = 3 .
      689                               end.
      690                           when "b-hist-user" then
      691                               do:
      692                                   hh:load-image("cmp/b-hist.bmp":u) .
      693                                   hh:TOOLTIP = "История пользователя" .
      694                                   ii = ii + 1 .
      695                               end.
      696                       end case.
      697                   end.
      698                   hh = hh:next-sibling.
      699               end.
      700               b-help:column = v-frame-width - b-help:width-chars.
      701               jj = 0.
      702               repeat ii = 4 to 1 by -1 :
      703                   if valid-handle (v-h[ii] ) then
      704                   do:
      705                       jj  = jj + 1 .
      706                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      707                       v-h[ii]:row    = v-help-old-y .
      708                   end.
      709               end.
      710           end.
      711       end.
      712   end procedure.
      713   MAIN-BLOCK:
      714   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      715      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      716      run cr-ob in this-procedure (input-output fin-type-acc, 30 , 1.67 ) .
      717       if ref-mode =  'ДОБАВЛЕНИЕ':U
      718           then  do:
      719               ri = ?.
      720               run fin-code in this-procedure (input par-host-code , output p-fin-code) .
      721               tcode = string(p-fin-code) .
      722               run create-ref-corr-acc in this-procedure (
      723                   input no ,
      724                   input par-host-code ,
      725                   input p-fin-code    ,
      726                   input tcode ,
      727                   input ""    ,
      728                   input 0 ,
      729                   input 0 ,
      730                   input 0 ,
      731                   input 0 ,
      732                   input 1
      733                   ).
      734           end.
      735           else  do:
      736            find ub.fin-code-cor-acc where recid( ub.fin-code-cor-acc ) = ri no-error .
      737            if error-status :error then return  error .
      738            fin-type-acc:screen-value = string(ub.fin-code-cor-acc.acc-type)  .
      739            end.
      740   frame Dialog-Frame:title = frame Dialog-Frame:title + "  - " + caps(ref-mode).
      741   b-quit:label = (if  ref-mode = 'ПРОСМОТР':U then "&Выход" else b-quit:label ).
      742       session:data-entry-return = yes .
      743        if ref-mode = 'ПРОСМОТР':U then do:
      744           run myenable_UI in this-procedure.
      745           WAIT-FOR GO OF FRAME Dialog-Frame FOCUS b-quit.
      746        end.
      747        else do:
      748           run enable_UI in this-procedure.
      749           if ref-mode = 'ДОБАВЛЕНИЕ':U
      750               then  WAIT-FOR GO OF FRAME Dialog-Frame FOCUS ub.fin-code-cor-acc.code-value .
      751               else  WAIT-FOR GO OF FRAME Dialog-Frame FOCUS ub.fin-code-cor-acc.descr .
      752      end.
      753   END.
      754   run disable_UI in this-procedure.
      755   PROCEDURE cr-ob :
      756    do
      757    on error undo, return error return-value
      758    :
      759   define input-output parameter type-acc  AS WIDGET-HANDLE.
      760   define input parameter p-x as integer no-undo .
      761   define input parameter p-y as integer no-undo .
      762   define var fin-type-acc-name as character no-undo .
      763   define var fin-type-acc-val  as character no-undo .
      764   define variable l-str as character no-undo .
      765   assign
      766     fin-type-acc-name = 'Активный,Пассивный,Акт-пасс':U
      767     fin-type-acc-val  = '1,2,3':U
      768     l-str        = 'Активный,1,Пассивный,2,Акт-пасс,3':U
      769   .
      770      create radio-set type-acc
      771      assign
      772       row    = p-y
      773       column = p-x
      774       frame  = frame Dialog-Frame:handle
      775       horizontal    = false
      776       radio-buttons = l-str
      777    .
      778   if valid-handle(type-acc) = false then do:
      779       message "Ошибка создания поля ТИПЫ СЧЕТОВ !!!" skip
      780       skip
      781       view-as alert-box information .
      782      return error .
      783    end.
      784     type-acc:sensitive = yes  .
      785     type-acc:visible   = yes  .
      786     end.
      787   END PROCEDURE.
      788   PROCEDURE disable_UI :
      789     HIDE FRAME Dialog-Frame.
      790   END PROCEDURE.
      791   PROCEDURE enable_UI :
      792     DISPLAY FILL-IN-1
      793         WITH FRAME Dialog-Frame.
      794     IF AVAILABLE fin-code-cor-acc THEN
      795       DISPLAY fin-code-cor-acc.code-value fin-code-cor-acc.descr
      796             fin-code-cor-acc.level-1 fin-code-cor-acc.level-2
      797             fin-code-cor-acc.level-3
      798         WITH FRAME Dialog-Frame.
      799     ENABLE b-exit RECT-1 b-quit b-help fin-code-cor-acc.code-value
      800            fin-code-cor-acc.descr fin-code-cor-acc.level-1
      801            fin-code-cor-acc.level-2 fin-code-cor-acc.level-3 FILL-IN-1
      802         WITH FRAME Dialog-Frame.
      803     VIEW FRAME Dialog-Frame.
      804   END PROCEDURE.
      805   PROCEDURE myenable_UI :
      806     IF AVAILABLE ub.fin-code-cor-acc THEN
      807       DISPLAY ub.fin-code-cor-acc.code-value ub.fin-code-cor-acc.descr FILL-IN-1
      808             ub.fin-code-cor-acc.level-1 ub.fin-code-cor-acc.level-2
      809             ub.fin-code-cor-acc.level-3
      810         WITH FRAME Dialog-Frame.
      811      enable  b-quit b-help
      812         WITH FRAME Dialog-Frame.
      813         fin-type-acc:screen-value = string(ub.fin-code-cor-acc.acc-type)  .
      814     fin-type-acc:sensitive = no  .
      815     VIEW FRAME Dialog-Frame.
      816   END PROCEDURE.
