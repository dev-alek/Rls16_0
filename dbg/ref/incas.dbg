        1   block-level on error undo, throw.
        2   define temp-table tt-cashBookOst no-undo
        3   field chang      as logical
        4   field cashbookid as int64
        5   field cashbookname as character
        6   field ost        as decimal
        7   field ostrasch   as decimal
        8   field osnpko     as decimal
        9   field osnrko     as decimal
       10   index pi cashbookid.
       11   define input-output  parameter table for tt-cashBookOst bind.
       12   define input  parameter iSummMax as decimal no-undo.
       13   define output parameter OSumm as decimal no-undo.
       14   define output parameter oBag as character no-undo.
       15   define output parameter oMoney  as character no-undo.
       16   define output parameter oOk     as logical no-undo.
       17   define variable mincas as class ibs.th.ref.incas no-undo.
       18   do trans:
       19   mincas = new ibs.th.ref.incas().
       20   mincas:settt(input table tt-cashBookOst).
       21   wait-for  mincas:ShowDialog() .
       22   end.
       23   if mincas:DialogResult = System.Windows.Forms.DialogResult:Ok
       24      then
       25   do:
       26      mincas:gettt(output table tt-cashBookOst).
       27      OSumm = mincas:mSumm.
       28      oBag = mincas:mosnbag.
       29      oMoney  = mincas:mMoney.
       30      oOk = yes.
       31   end.
       32   finally:
       33      delete object mincas.
       34   end finally.
