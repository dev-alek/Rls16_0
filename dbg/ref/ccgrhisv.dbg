        1   block-level on error undo, throw.
        2   define input parameter p-node-code  like ub.c-cli-grp.node-code no-undo .
        3   define input parameter p-corr-user-db-num  like ub.c-cli-grp.corr-user-db-num no-undo .
        4   define input parameter p-chip-num  like ub.c-cli-grp.chip-num no-undo .
        5   define input parameter p-subject as character no-undo .
        6   define input parameter p-silent  as logical no-undo .
        7   define output parameter p-description as character no-undo .
        8   define output parameter p-full-name-old as character no-undo case-sensitive.
        9   define output parameter p-full-name-new as character no-undo case-sensitive.
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: ccgrhisv.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/ccgrhisv.p $":U .
       15   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории групп клиентов".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable v-chg-fields as character no-undo.
       75   define variable v-old-fields as character no-undo.
       76   define variable v-new-fields as character no-undo.
       77   define variable ii as integer no-undo.
       78   define variable v-mess as character no-undo .
       79   define buffer buf_c-cli-grp for ub.c-cli-grp.
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define SHARED temp-table temp-changes no-undo
       82   field f_name as character
       83   field l_name as character
       84   field v_old as character
       85   field v_new as character
       86   field t_name as character
       87   field num_ as integer
       88   field uniq-key-rec as character
       89   field action as integer
       90   field fNotChange as logical
       91   index pi is unique primary
       92   num_
       93   t_name
       94   f_name
       95   index
       96   Chan
       97   fnotChange
       98   t_name
       99   f_name
      100   index imain uniq-key-rec
      101   .
      102   FUNCTION get-all-fields returns character (p-file-name as character ):
      103   define variable v-dop as character no-undo .
      104     find first _file no-lock where _file._file-name = p-file-name no-error .
      105     if not available _file then return "":U.
      106     for each _field no-lock where
      107              _field._file-recid = recid(_file) :
      108       assign
      109       v-dop = v-dop + _field._field-name + chr(44)
      110       .
      111     end.
      112     return trim(v-dop).
      113   END FUNCTION.
      114   PROCEDURE proc-full-temp-changes :
      115     define input  parameter p-act-create as logical   no-undo .
      116     define input  parameter p-act-delete as logical   no-undo .
      117     define input  parameter p-hst-handle as handle    no-undo .
      118     define input  parameter p-main-table as character no-undo .
      119     define input  parameter p-field-list as character no-undo .
      120     define input  parameter p-label-form as character no-undo .
      121     define variable h-new-buf         as handle    no-undo .
      122     define variable h-main-buf        as handle    no-undo .
      123     define variable h-for-comp        as handle    no-undo .
      124     define variable v-inform          as character no-undo .
      125     define variable v-ind             as integer   no-undo .
      126     define variable v-idx-field-qnty  as integer   no-undo .
      127     define variable v-num-entries     as integer   no-undo .
      128     define variable fh                as handle    no-undo .
      129     define variable fh-main           as handle    no-undo .
      130     define variable fh-old            as handle    no-undo .
      131     define variable fh-new            as handle    no-undo .
      132     define variable v-field-name      as character no-undo .
      133     define variable v-field-lvl       as character no-undo .
      134     define variable v-field-form      as character no-undo .
      135     define variable v-search-exp      as character no-undo .
      136     define variable v-srch-main       as character no-undo .
      137     define variable v-word-link       as character no-undo .
      138     define variable v-av-chip-num     as logical   no-undo .
      139     define variable v-main-pi-fld-lst as character no-undo .
      140     define variable v-main-fld-lst    as character no-undo .
      141     define variable v-delim-list      as character no-undo .
      142     define variable v-label           as character no-undo .
      143     define variable v-old-value       as character no-undo case-sensitive.
      144     define variable v-new-value       as character no-undo case-sensitive.
      145     define variable v-chg-fields as character no-undo.
      146     for each temp-changes:
      147       delete temp-changes.
      148     end.
      149     if not p-hst-handle:available then do:
      150       return .
      151     end.
      152     create buffer h-new-buf  for table p-hst-handle .
      153     create buffer h-main-buf for table p-main-table .
      154     assign
      155       v-inform = h-main-buf:index-information(1)
      156       v-ind    = 2
      157     .
      158     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      159     on error undo, return error
      160     :
      161       assign
      162         v-inform = h-main-buf:index-information( v-ind )
      163         v-ind    = v-ind + 1
      164       .
      165     end.
      166     if v-inform = ?
      167       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      168       or entry( 3, v-inform, ",":U ) <> "1":U
      169     then do:
      170       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      171     end.
      172     assign
      173       v-idx-field-qnty = num-entries( v-inform ) - 4
      174     .
      175     if v-idx-field-qnty < 2 then do:
      176       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      177     end.
      178     assign
      179       v-srch-main   = "where":U
      180       v-word-link   = "":U
      181       v-av-chip-num = false
      182       v-delim-list  = "":U
      183     .
      184     do v-ind = 1 to v-idx-field-qnty by 2
      185     on error undo, return error
      186     :
      187       assign
      188         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      189         fh                = p-hst-handle:buffer-field( v-field-name )
      190         fh-main           = h-main-buf:buffer-field( v-field-name )
      191         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      192         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      193       .
      194       if fh:data-type ="character":U then do:
      195         assign
      196           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      197         .
      198       end.
      199       else do:
      200         assign
      201           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      202         .
      203       end.
      204       if v-delim-list = "":U then do:
      205         assign
      206           v-delim-list = ",":U
      207         .
      208       end.
      209       if v-word-link = "":U then do:
      210         assign
      211           v-word-link = "and":U
      212         .
      213       end.
      214     end.
      215     assign
      216       v-delim-list  = "":U
      217     .
      218     do v-ind = 1 to h-main-buf:num-fields
      219     on error undo, return error
      220     :
      221       assign
      222         fh-main      = h-main-buf:buffer-field( v-ind )
      223         v-field-name = fh-main:name
      224       .
      225         assign
      226           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      227         .
      228         if v-delim-list = "":U then do:
      229           assign
      230             v-delim-list = ",":U
      231           .
      232         end.
      233     end.
      234     assign
      235       v-inform = p-hst-handle:index-information(1)
      236       v-ind    = 2
      237     .
      238     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      239     on error undo, return error
      240     :
      241       assign
      242         v-inform = p-hst-handle:index-information( v-ind )
      243         v-ind    = v-ind + 1
      244       .
      245     end.
      246     if v-inform = ?
      247       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      248       or entry( 3, v-inform, ",":U ) <> "1":U
      249     then do:
      250       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      251     end.
      252     assign
      253       v-idx-field-qnty = num-entries( v-inform ) - 4
      254     .
      255     if v-idx-field-qnty < 2 then do:
      256       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      257     end.
      258     assign
      259       v-search-exp  = "where":U
      260       v-word-link   = "":U
      261       v-av-chip-num = false
      262     .
      263     do v-ind = 1 to v-idx-field-qnty by 2
      264     on error undo, return error
      265     :
      266       assign
      267         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      268         fh           = p-hst-handle:buffer-field( v-field-name )
      269         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      270       .
      271       if v-field-name = "chip-num":U then do:
      272         assign
      273           v-search-exp  = substitute( "&1 >", v-search-exp )
      274           v-av-chip-num = true
      275         .
      276       end.
      277       else do:
      278         assign
      279           v-search-exp = substitute( "&1 =", v-search-exp )
      280         .
      281       end.
      282       if fh:data-type ="character":U then do:
      283         assign
      284           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      285         .
      286       end.
      287       else do:
      288         assign
      289           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      290         .
      291       end.
      292       if v-word-link = "":U then do:
      293         assign
      294           v-word-link = "and":U
      295         .
      296       end.
      297     end.
      298     if v-av-chip-num = false then do:
      299       message
      300         vss-workfile vss-revision vss-description skip
      301         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      302         "Использование данной процедуры невозможно!" skip
      303         view-as alert-box error .
      304       return error .
      305     end.
      306     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      307     if not h-new-buf:available then do:
      308       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      309       if not h-main-buf:available then do:
      310         assign
      311           h-for-comp = ?
      312         .
      313       end.
      314       else do:
      315         assign
      316           h-for-comp = h-main-buf
      317         .
      318       end.
      319     end.
      320     else do:
      321       assign
      322         h-for-comp = h-new-buf
      323       .
      324     end.
      325     assign
      326       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      327     .
      328     do v-ind = 1 to v-num-entries
      329     on error undo, return error return-value
      330     :
      331       assign
      332         v-field-name = entry( v-ind, v-main-fld-lst )
      333         fh-old       = p-hst-handle:buffer-field( v-field-name )
      334         v-old-value  = fh-old:buffer-value()
      335         v-label      = trim( fh-old:label )
      336       .
      337       if ( trim( p-field-list ) <> "":U
      338            and lookup( v-field-name, p-field-list ) > 0
      339          )
      340          or trim( p-field-list ) = "":U
      341       then do:
      342         if h-for-comp <> ? then do:
      343           assign
      344             fh-new      = h-for-comp:buffer-field( v-field-name )
      345             v-new-value = fh-new:buffer-value()
      346           .
      347         end.
      348         else do:
      349           assign
      350             v-new-value = "":U
      351           .
      352         end.
      353           if p-act-create = true then do:
      354             assign
      355               v-old-value = "":U
      356             .
      357           end.
      358           if p-act-delete = true then do:
      359             assign
      360               v-new-value = "":U
      361             .
      362           end.
      363         if v-old-value <> v-new-value
      364         then do:
      365           create temp-changes.
      366           assign
      367             temp-changes.t_name = p-main-table
      368             temp-changes.f_name = v-field-name
      369             temp-changes.l_name = replace( v-label, "&":U, "":U )
      370             temp-changes.v_old  = trim( v-old-value )
      371             temp-changes.v_new  = trim( v-new-value )
      372             temp-changes.num_   = 0
      373             temp-changes.fNotChange = v-old-value eq v-new-value
      374           .
      375         end.
      376       end.
      377     end.
      378     assign
      379       v-num-entries = num-entries( p-label-form, chr(8) )
      380     .
      381     do v-ind = 1 to v-num-entries
      382     on error undo, return error return-value
      383     :
      384       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      385         assign
      386           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      387           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      388           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      389         .
      390         find first temp-changes
      391           where temp-changes.f_name = v-field-name
      392           no-error .
      393         if available temp-changes then do:
      394           if trim( v-field-lvl ) <> "":U then do:
      395             assign
      396               temp-changes.l_name = v-field-lvl
      397             .
      398           end.
      399           if trim( v-field-form ) <> "":U then do:
      400             assign
      401               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      402             .
      403             if h-for-comp <> ? then do:
      404               assign
      405                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      406               .
      407             end.
      408           end.
      409         end.
      410       end.
      411       else do:
      412         message
      413           vss-workfile vss-revision vss-description skip
      414           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      415           substitute( "список для поля '&1': '&2'"
      416                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      417                       ,entry( v-ind, p-label-form, chr(8) )
      418                     ) skip
      419           substitute( "полный список: &2", p-label-form ) skip
      420           view-as alert-box error .
      421       end.
      422     end.
      423     delete object h-new-buf .
      424     delete object h-main-buf .
      425   END PROCEDURE.
      426   find first buf_c-cli-grp no-lock where
      427             buf_c-cli-grp.node-code = p-node-code
      428         AND buf_c-cli-grp.chip-num = p-chip-num
      429         AND buf_c-cli-grp.corr-user-db-num = p-corr-user-db-num no-error .
      430   if not available buf_c-cli-grp then do:
      431     return error .
      432   end.
      433   CASE p-subject:
      434     when 'cli-grp':U then do:
      435       run cli-grp-proc in this-procedure(output p-description) no-error .
      436     end.
      437     when 'dis-grp-rule':U then do:
      438       run dis-grp-rule-proc in this-procedure(output p-description) no-error .
      439     end.
      440    end case.
      441   if error-status:error then do:
      442     return error .
      443   end.
      444   procedure cli-grp-proc :
      445   define output parameter p-description as character no-undo .
      446   define variable v-is-created as logical no-undo .
      447   define variable v-is-deleted as logical no-undo .
      448   define variable v-field-name as character no-undo .
      449   define variable v-field-function as character no-undo .
      450   define variable jj as integer no-undo .
      451   define variable v-field-label  as character no-undo .
      452   define variable v-field-list as character no-undo .
      453   define buffer current_cli-grp for ub.cli-grp  .
      454   define buffer current_c-cli-grp for ub.c-cli-grp  .
      455   define buffer new_c-cli-grp for ub.c-cli-grp  .
      456     do
      457     on error undo, return error
      458     :
      459       find first current_c-cli-grp no-lock where
      460                  current_c-cli-grp.node-code = p-node-code
      461              AND current_c-cli-grp.chip-num = p-chip-num
      462              AND current_c-cli-grp.corr-user-db-num = p-corr-user-db-num
      463              no-error .
      464       if not avail current_c-cli-grp then do:
      465          v-mess = "Неверная ссылка на c-cli-grp в таблице c-cli-grp".
      466          run err-mess in this-procedure ( input-output v-mess).
      467          return error (if p-silent then v-mess else '':U).
      468       end.
      469       find first new_c-cli-grp no-lock where
      470                  new_c-cli-grp.node-code = p-node-code
      471              AND new_c-cli-grp.chip-num > p-chip-num
      472              AND new_c-cli-grp.corr-user-db-num = p-corr-user-db-num
      473               no-error .
      474       if not available new_c-cli-grp then do:
      475           find first current_cli-grp no-lock where
      476                  current_cli-grp.node-code = p-node-code no-error .
      477           if not available current_cli-grp then do:
      478              assign
      479              v-is-deleted = yes.
      480           end.
      481           if available current_cli-grp then
      482           buffer-compare current_cli-grp to current_c-cli-grp
      483           case-sensitive
      484           save result in v-chg-fields.
      485       end.
      486       else do:
      487           buffer-compare new_c-cli-grp except chip-num corr-date corr-user-name corr-user-db-num to current_c-cli-grp
      488           case-sensitive
      489           save result in v-chg-fields.
      490       end.
      491       if buf_c-cli-grp.upper-code = 0
      492       then do:
      493         assign
      494         v-is-created = yes
      495         v-chg-fields = get-all-fields ("cli-grp")
      496         .
      497       end.
      498       if not avail new_c-cli-grp
      499       and not available current_cli-grp
      500       then do:
      501         assign
      502         v-is-deleted = yes
      503         v-chg-fields = get-all-fields ("cli-grp")
      504         .
      505       end.
      506       if lookup("node-code", v-chg-fields ) > 0
      507       or lookup("upper-code", v-chg-fields ) > 0 then do:
      508          if not v-is-created then
      509          run c-get-full-name  in this-procedure (
      510                                                     input  yes
      511                                                    ,input p-node-code
      512                                                    ,input p-chip-num
      513                                                    ,input p-corr-user-db-num
      514                                                    ,output p-full-name-old
      515                                                   ) no-error .
      516          if not v-is-deleted then
      517          run c-get-full-name  in this-procedure (
      518                                                     input  (if available new_c-cli-grp
      519                                                             then yes
      520                                                             else no)
      521                                                    ,input p-node-code
      522                                                    ,input (if available new_c-cli-grp
      523                                                            then new_c-cli-grp.chip-num
      524                                                            else 0)
      525                                                    ,input p-corr-user-db-num
      526                                                    ,output p-full-name-new
      527                                                   ) no-error .
      528       end.
      529   define variable v-label-param as character no-undo .
      530   v-label-param =
      531      "is-term" + chr(4) + "Терминальная" + chr(4) + "" + chr(8)
      532    + "lvl-num" + chr(4) + "Уровень" + chr(4) + "" + chr(8)
      533    + "node-code" + chr(4) + "Вн №" + chr(4) + "" + chr(8)
      534    + "node-name" + chr(4) + "Наименование" + chr(4) + "" + chr(8)
      535    + "upper-code" + chr(4) + "Вн № выш.группы" + chr(4) + ""  .
      536    run proc-full-temp-changes in this-procedure (
      537                                                input v-is-created
      538                                               ,input v-is-deleted
      539                                               ,input  buffer current_c-cli-grp:handle
      540                                               ,input  'cli-grp':U
      541                                               ,input  "is-term,lvl-num,node-code,node-name,upper-code"
      542                                               ,input  v-label-param).
      543   end.
      544   end procedure.
      545   procedure dis-grp-rule-proc :
      546   define output parameter p-description as character no-undo .
      547   define variable v-label-param as character no-undo .
      548   define buffer buf_c-dis-grp-rule for ub.c-dis-grp-rule.
      549           find first buf_c-dis-grp-rule no-lock where
      550                 buf_c-dis-grp-rule.classif-type = 'cli-grp':U
      551            and  buf_c-dis-grp-rule.node-code = p-node-code
      552           and  buf_c-dis-grp-rule.corr-user-db-num = p-corr-user-db-num
      553           and  buf_c-dis-grp-rule.chip-num = p-chip-num no-error.
      554      if not available buf_c-dis-grp-rule then do:
      555        message
      556        "Неверная ссылка на c-dis-grp-rule в таблице c-cli-grp"
      557        view-as alert-box error.
      558      end.
      559   v-label-param =
      560     "rule-num" + chr(4) + "Номер правила скидки" + chr(4) + "" + chr(8)
      561    + "pos-type" + chr(4) + "Место использ." + chr(4) + "" + chr(8)
      562    + "templ-rl-root" + chr(4) + "Тип шаблона" + chr(4) + "disgrpru-get-disc-label"  + chr(8)
      563    + "discnt-role" + chr(4) + "Тип скидки" + chr(4) + "disgrpru-get-disc-role-label"
      564    .
      565   run proc-full-temp-changes in this-procedure (
      566                                                 input  (buf_c-cli-grp.action = integer('1':U))
      567                                               ,input  (buf_c-cli-grp.action = integer('99':U))
      568                                               ,input  buffer buf_c-dis-grp-rule:handle
      569                                               ,input  'dis-grp-rule':U
      570                                               ,input  "rule-num,pos-type,templ-rl-root,discnt-role"
      571                                               ,input  v-label-param).
      572   end procedure .
      573   procedure c-get-full-name :
      574   do
      575   on error undo, return error
      576   :
      577   define input parameter p-c          as logical no-undo .
      578   define input parameter p-node-code  as integer      no-undo.
      579   define input parameter p-chip-num  as integer no-undo .
      580   define input parameter p-corr-user-db-num as integer no-undo .
      581   define output parameter p-full-name as character    no-undo.
      582       define variable v-upper-code    as integer           no-undo.
      583       define variable v-c as logical no-undo .
      584       define buffer buf_cli-grp       for ub.cli-grp.
      585       define buffer buf_upper_cli-grp for ub.cli-grp.
      586       define buffer buf_c-cli-grp       for ub.c-cli-grp.
      587       define buffer buf_c-upper_cli-grp for ub.c-cli-grp.
      588       if p-c then do:
      589         find first buf_c-cli-grp no-lock
      590             where buf_c-cli-grp.node-code = p-node-code
      591               AND buf_c-cli-grp.chip-num  = p-chip-num
      592               AND buf_c-cli-grp.corr-user-db-num  = p-corr-user-db-num
      593         no-error.
      594         if not available buf_c-cli-grp
      595         then do:
      596             undo, return error substitute("Не найдена запись истории для групп клиентов: вн № &1, chip-num &2, БД-корректор &3"
      597                                           , p-node-code
      598                                           , p-chip-num
      599                                           , p-corr-user-db-num
      600                                           ).
      601         end.
      602       end.
      603       else do:
      604         find first buf_cli-grp no-lock
      605             where buf_cli-grp.node-code = p-node-code
      606         no-error.
      607         if not available buf_cli-grp
      608         then do:
      609             undo, return error substitute("Не найдена запись группы клиентов: вн № &1"
      610                                           , p-node-code
      611                                           ).
      612         end.
      613       end.
      614       assign
      615           p-full-name  = ""
      616           v-upper-code = 1
      617           v-c = p-c
      618       .
      619       do while
      620       ( v-c = no and buf_cli-grp.upper-code <> 0)
      621       or ( v-c = yes and  buf_c-cli-grp.upper-code <> 0)
      622       on error undo, return error "Ошибка составления полного имени группы"
      623       :
      624           assign
      625               p-full-name  = (if v-c = yes
      626                               then buf_c-cli-grp.node-name
      627                               else buf_cli-grp.node-name)
      628                            + (if p-full-name <> "" then chr(47) else "")
      629                            + p-full-name
      630               v-upper-code = (if v-c
      631                               then buf_c-cli-grp.upper-code
      632                               else buf_cli-grp.upper-code)
      633           .
      634           find first buf_c-cli-grp no-lock
      635                where buf_c-cli-grp.node-code = v-upper-code
      636                  AND buf_c-cli-grp.chip-num  > p-chip-num
      637                  AND buf_c-cli-grp.corr-user-db-num  > p-corr-user-db-num no-error .
      638           if not available buf_c-cli-grp then do:
      639             assign
      640             v-c = no
      641             .
      642             find first buf_cli-grp no-lock
      643                 where buf_cli-grp.node-code = v-upper-code
      644             no-error.
      645             if not available buf_cli-grp
      646             then do:
      647                 undo, return error substitute("Не найдена группа клиентов с кодом &1" +
      648                                                ". Ошибка ссылки в дереве клиентов для записи истории групп клиентов:" +
      649                                                "вн № &2, chip-num &3, БД-корректор &4"
      650                                               ,  v-upper-code
      651                                               ,  p-node-code
      652                                               , p-chip-num
      653                                               , p-corr-user-db-num).
      654             end.
      655           end.
      656           else do:
      657             assign
      658             v-c = yes
      659             .
      660           end.
      661       end.
      662       assign
      663       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      664       .
      665   end.
      666   end procedure.
      667   PROCEDURE err-mess:
      668     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      669     CASE p-silent:
      670       when yes then do:
      671         assign
      672         p-mess = substitute("История групп клиентов&1" +
      673                             "Вн Код группы: &2&1" +
      674                             "щепка &3 БД:&4&1&5"
      675                             ,chr(10)
      676                             ,p-node-code
      677                             ,p-chip-num
      678                             ,p-corr-user-db-num
      679                             ,p-mess).
      680       end.
      681       otherwise do:
      682         message
      683         p-mess
      684         view-as alert-box error .
      685       end.
      686     end.
      687   END PROCEDURE.
