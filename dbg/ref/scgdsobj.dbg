     2995   PROCEDURE MyEnable :
     2996   loc-art = "".
     2997   DISPLAY
     2998   a-n-c
     2999   WITH FRAME Dialog-Frame .
     3000   ENABLE
     3001   b-quit
     3002   B-scales
     3003   B-code
     3004   B-sch
     3005   B-Help
     3006   a-n-c
     3007   BR-gds
     3008   b-chg when (v-cntxt-db-num-obj = v-cntxt-db-num)
     3009   RS-mode
     3010   WITH FRAME Dialog-Frame .
     3011   VIEW FRAME Dialog-Frame .
     3012   assign
     3013   a-n-c = "art":U.
     3014   hide loc-art
     3015   in frame Dialog-Frame
     3016   loc-name
     3017   loc-code in frame Dialog-Frame.
     3018   END PROCEDURE.
     3019   PROCEDURE Openbr :
     3020   define input  parameter p-open-query     as logical   no-undo .
     3021   define input  parameter p-find-next      as logical   no-undo .
     3022   define input  parameter p-find-condition as character no-undo .
     3023   define variable l-query-was-opened as logical no-undo .
     3024   run waitfram-show in this-procedure ( input "Ждите...").
     3025   define variable sort-column-phrase as character no-undo .
     3026   case sort-column-name :
     3027     when "" then do:
     3028       assign
     3029         sort-column-phrase = ""
     3030       .
     3031     end.
     3032     otherwise do:
     3033       assign
     3034         sort-column-phrase = "by " + sort-column-name
     3035       .
     3036     end.
     3037   end case.
     3038   CASE RS-mode:
     3039       when 'объект':U then do:
     3040           ASSIGN
     3041           frame Dialog-Frame:TITLE = "ВЕСОВЫЕ ТОВАРЫ МАГАЗИНА " + p-obj-type + chr(32) + string(p-obj-code)
     3042           filter-point = filter-point0 + RS-mode
     3043           filter-label = substitute("&1 один магазин", filter-label0)
     3044           .
     3045   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3046   define variable  l-disable-where-22  as logical   no-undo .
     3047   define variable  l-filter-open-22    as logical   .
     3048   define variable  flt-rec-22       as recid     no-undo .
     3049   define variable  filter-name-22      as character no-undo .
     3050   define variable  where-phrase-22     as character no-undo .
     3051   define variable  sort-phrase-22      as character no-undo .
     3052   define variable  where-phrase-rus-22 as character no-undo .
     3053   define variable  sort-phrase-rus-22  as character no-undo .
     3054   run gbl/flt-get.p
     3055     (input filter-point
     3056     ,output flt-rec-22
     3057     ,output filter-name-22
     3058     ,output where-phrase-22
     3059     ,output sort-phrase-22
     3060     ,output where-phrase-rus-22
     3061     ,output sort-phrase-rus-22
     3062     ).
     3063       run set-filter-name in this-procedure
     3064         (INPUT filter-name-22
     3065         ) no-error .
     3066     assign
     3067       l-filter-open-22 = false
     3068     .
     3069     if flt-rec-22 <> ?
     3070       or sort-column-phrase > ""
     3071     then do:
     3072       define variable  parameter-2-22 as character no-undo .
     3073       define variable  parameter-3-22 as character no-undo .
     3074       define variable  parameter-4-22 as character no-undo .
     3075       define variable  parameter-5-22 as character no-undo .
     3076       define variable  parameter-6-22 as character no-undo .
     3077       define variable  parameter-7-22 as character no-undo .
     3078         assign
     3079         parameter-3-22 =
     3080                                 "FOR EACH X_goods No-LOCK"
     3081         parameter-4-22 =
     3082           (
     3083             if (" TRUE " + " " + where-phrase-22) <> ""
     3084             then " TRUE " + " " + where-phrase-22
     3085             else "true"
     3086           )
     3087         parameter-5-22 = (" " + "" + " " + substitute('   , FIRST X_units No-LOCK WHERE X_units.unit-name = X_goods.unit-base AND                                       LOOKUP(&1&5&1, X_units.type) > 0,   FIRST X_gds-obj WHERE X_gds-obj.gds-code = X_goods.gds-code   AND X_gds-obj.obj-type = &1&2&1   AND X_gds-obj.obj-code = &3 NO-LOCK,   FIRST X_gds-obj-attr WHERE X_gds-obj-attr.gds-code = X_goods.gds-code   AND X_gds-obj-attr.obj-type = X_gds-obj.obj-type   AND X_gds-obj-attr.obj-code = X_gds-obj.obj-code       AND X_gds-obj-attr.attr-code = &1&4&1 OUTER-JOIN  NO-LOCK', chr(34), p-obj-type, p-obj-code, 'scales-code':U, 'вес':U))
     3088         parameter-6-22 = if sort-phrase-22 = ''
     3089                              then
     3090           (
     3091           " " + "  " +
     3092             " " + sort-column-phrase +
     3093           " " + "  "
     3094           )
     3095                              else
     3096           (
     3097           " " + "  " +
     3098             " " + sort-column-phrase +
     3099           " " + sort-phrase-22
     3100           )
     3101         parameter-7-22 =
     3102           "   "
     3103       .
     3104       do
     3105       on stop undo, leave
     3106       on error undo, leave
     3107       :
     3108         assign
     3109           l-disable-where-22 =
     3110             (" TRUE " + " " + where-phrase-22 = "")
     3111         .
     3112         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3113                             ,input QUERY br-gds:handle
     3114                             ,input parameter-3-22
     3115                             ,input parameter-4-22
     3116                             ,input parameter-5-22
     3117                             ,input parameter-6-22
     3118                             ,input parameter-7-22
     3119                             )
     3120         .
     3121         assign
     3122           l-filter-open-22 = true
     3123         .
     3124       end.
     3125       if l-filter-open-22 = false then do:
     3126         message
     3127           "Ошибка при фильтрации / сортировке" skip
     3128           "Будут показаны записи без учета фильтра" skip
     3129           view-as alert-box .
     3130       end.
     3131       else do:
     3132           assign
     3133             l-query-was-opened = true
     3134           .
     3135       end.
     3136     end.
     3137     if l-filter-open-22 = false then do:
     3138       OPEN QUERY br-gds FOR EACH X_goods No-LOCK
     3139         where  TRUE
     3140       , FIRST X_units No-LOCK WHERE X_units.unit-name = X_goods.unit-base AND                                       LOOKUP('вес':U, X_units.type) > 0,   FIRST X_gds-obj WHERE X_gds-obj.gds-code = X_goods.gds-code   AND X_gds-obj.obj-type = p-obj-type   AND X_gds-obj.obj-code = p-obj-code NO-LOCK,   FIRST X_gds-obj-attr WHERE X_gds-obj-attr.gds-code = X_goods.gds-code   AND X_gds-obj-attr.obj-type = X_gds-obj.obj-type   AND X_gds-obj-attr.obj-code = X_gds-obj.obj-code       AND X_gds-obj-attr.attr-code = 'scales-code':U OUTER-JOIN  NO-LOCK
     3141     .
     3142         assign
     3143           l-query-was-opened = true
     3144         .
     3145     end.
     3146       end.
     3147       otherwise do:
     3148           ASSIGN
     3149           frame Dialog-Frame:TITLE = "ВСЕ ВЕСОВЫЕ ТОВАРЫ "
     3150           filter-point = filter-point0 + RS-mode
     3151           filter-label = substitute("&1", filter-label0)
     3152           .
     3153   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3154   define variable  l-disable-where-24  as logical   no-undo .
     3155   define variable  l-filter-open-24    as logical   .
     3156   define variable  flt-rec-24       as recid     no-undo .
     3157   define variable  filter-name-24      as character no-undo .
     3158   define variable  where-phrase-24     as character no-undo .
     3159   define variable  sort-phrase-24      as character no-undo .
     3160   define variable  where-phrase-rus-24 as character no-undo .
     3161   define variable  sort-phrase-rus-24  as character no-undo .
     3162   run gbl/flt-get.p
     3163     (input filter-point
     3164     ,output flt-rec-24
     3165     ,output filter-name-24
     3166     ,output where-phrase-24
     3167     ,output sort-phrase-24
     3168     ,output where-phrase-rus-24
     3169     ,output sort-phrase-rus-24
     3170     ).
     3171       run set-filter-name in this-procedure
     3172         (INPUT filter-name-24
     3173         ) no-error .
     3174     assign
     3175       l-filter-open-24 = false
     3176     .
     3177     if flt-rec-24 <> ?
     3178       or sort-column-phrase > ""
