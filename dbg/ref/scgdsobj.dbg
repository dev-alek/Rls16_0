      433         undo, return error return-value .
      434       end.
      435     end.
      436   end.
      437   procedure gds-attr_check-code-dt-seasons :
      438     define input  parameter p-code     like ub.goods.gds-code   no-undo .
      439     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
      440     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
