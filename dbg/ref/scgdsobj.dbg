     3181       define variable  parameter-3-24 as character no-undo .
     3182       define variable  parameter-4-24 as character no-undo .
     3183       define variable  parameter-5-24 as character no-undo .
     3184       define variable  parameter-6-24 as character no-undo .
     3185       define variable  parameter-7-24 as character no-undo .
     3186         assign
     3187         parameter-3-24 =
     3188                                 "FOR EACH X_goods No-LOCK"
     3189         parameter-4-24 =
     3190           (
     3191             if (" TRUE " + " " + where-phrase-24) <> ""
     3192             then " TRUE " + " " + where-phrase-24
     3193             else "true"
     3194           )
     3195         parameter-5-24 = (" " + "" + " " + substitute('  , FIRST X_units No-LOCK WHERE X_units.unit-name = X_goods.unit-base AND                                        LOOKUP(&1&5&1, X_units.type) > 0,   FIRST X_gds-obj WHERE X_gds-obj.gds-code = X_goods.gds-code   AND X_gds-obj.obj-type = &1&2&1   AND X_gds-obj.obj-code = &3 OUTER-JOIN NO-LOCK,   FIRST X_gds-obj-attr WHERE X_gds-obj-attr.gds-code = X_goods.gds-code   AND X_gds-obj-attr.obj-type = X_gds-obj.obj-type   AND X_gds-obj-attr.obj-code = X_gds-obj.obj-code       AND X_gds-obj-attr.attr-code = &1&4&1 OUTER-JOIN  NO-LOCK', chr(34), p-obj-type, p-obj-code, 'scales-code':U, 'вес':U))
     3196         parameter-6-24 = if sort-phrase-24 = ''
     3197                              then
     3198           (
     3199           " " + "  " +
     3200             " " + sort-column-phrase +
     3201           " " + "  "
     3202           )
     3203                              else
     3204           (
     3205           " " + "  " +
     3206             " " + sort-column-phrase +
     3207           " " + sort-phrase-24
     3208           )
     3209         parameter-7-24 =
     3210           "   "
     3211       .
     3212       do
     3213       on stop undo, leave
     3214       on error undo, leave
     3215       :
     3216         assign
     3217           l-disable-where-24 =
     3218             (" TRUE " + " " + where-phrase-24 = "")
     3219         .
     3220         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3221                             ,input QUERY br-gds:handle
     3222                             ,input parameter-3-24
     3223                             ,input parameter-4-24
     3224                             ,input parameter-5-24
     3225                             ,input parameter-6-24
     3226                             ,input parameter-7-24
     3227                             )
     3228         .
     3229         assign
     3230           l-filter-open-24 = true
     3231         .
     3232       end.
     3233       if l-filter-open-24 = false then do:
     3234         message
     3235           "Ошибка при фильтрации / сортировке" skip
     3236           "Будут показаны записи без учета фильтра" skip
     3237           view-as alert-box .
     3238       end.
     3239       else do:
     3240           assign
     3241             l-query-was-opened = true
     3242           .
     3243       end.
     3244     end.
     3245     if l-filter-open-24 = false then do:
     3246       OPEN QUERY br-gds FOR EACH X_goods No-LOCK
     3247         where  TRUE
     3248       , FIRST X_units No-LOCK WHERE X_units.unit-name = X_goods.unit-base AND                                        LOOKUP('вес':U, X_units.type) > 0,   FIRST X_gds-obj WHERE X_gds-obj.gds-code = X_goods.gds-code   AND X_gds-obj.obj-type = p-obj-type   AND X_gds-obj.obj-code = p-obj-code OUTER-JOIN NO-LOCK,   FIRST X_gds-obj-attr WHERE X_gds-obj-attr.gds-code = X_goods.gds-code   AND X_gds-obj-attr.obj-type = X_gds-obj.obj-type   AND X_gds-obj-attr.obj-code = X_gds-obj.obj-code       AND X_gds-obj-attr.attr-code = 'scales-code':U OUTER-JOIN  NO-LOCK
     3249     .
     3250         assign
     3251           l-query-was-opened = true
     3252         .
     3253     end.
     3254       end.
     3255   END CASE.
     3256   run waitfram-hide in this-procedure .
     3257   APPLY "VALUE-CHANGED" TO BR-GDS.
     3258   APPLY "ENTRY" TO BR-GDS.
     3259   END PROCEDURE.
     3260   PROCEDURE proc-b-chg :
     3261   DEFINE INPUT PARAMETER p-gds-code like ub.goods.gds-code no-undo.
     3262   DEFINE INPUT PARAMETER p-obj-type like ub.gds-obj.obj-type no-undo.
     3263   DEFINE INPUT PARAMETER p-obj-code like ub.gds-obj.obj-code no-undo.
     3264   define parameter buffer buf_prod-bc for ub.prod-bc.
     3265   define variable r-bar-code as integer no-undo .
     3266   define buffer loc-gds-obj-attr for ub.gds-obj-attr.
     3267   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3268     (input  X_goods.gds-code
     3269     ,input  ?
     3270     ,output r-bar-code
     3271     ) no-error .
     3272   if r-bar-code <> buf_prod-bc.b-code then do:
     3273     message
     3274     "Выбран НЕВЕРНЫЙ ДопБК"
     3275     view-as alert-box error .
     3276     return no-apply.
     3277   end.
     3278   run gdsoattr-write in this-procedure (
     3279       input p-gds-code,
     3280       input p-obj-type,
     3281       input P-obj-code,
     3282       input 'scales-code':U,
     3283       input string(integer(buf_prod-bc.b-str), "99999")
     3284       ) no-error.
     3285   END PROCEDURE.
     3286   PROCEDURE proc-b-code :
     3287   DEFINE INPUT-OUTPUT PARAMETER loc-code-option as character no-undo.
     3288   DEFINE PARAMETER buffer loc-goods for ub.goods.
     3289   define variable ref-list as character no-undo.
     3290   define variable r-bar-code like ub.bar-code.b-code no-undo.
     3291     if not avail loc-goods then return no-apply.
     3292       gds-rec = recid (loc-goods).
     3293   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3294     (input  loc-goods.gds-code
     3295     ,input  ?
     3296     ,output r-bar-code
     3297     ) no-error .
     3298   CASE loc-code-option:
     3299     when "ALL":U then do:
     3300       run ref/alt-bc.w (
     3301                     input parparentproc
     3302                     ,input p-obj-type
     3303                     ,input p-obj-code
     3304                     ,input  r-bar-code) no-error.
     3305     end.
     3306     when "scales-all" then do:
     3307       run ref/prod-cds.w (
     3308                                 input parparentproc
     3309                               ,input p-obj-type
     3310                               ,input p-obj-code
     3311                               ,input  "code-current":U
     3312                               ,input  loc-goods.gds-code
     3313                               ,input  r-bar-code
     3314                               ,output ref-list ).
     3315     end.
     3316   end case.
     3317   code-option = "".
     3318   END PROCEDURE.
