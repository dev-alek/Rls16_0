      462   define variable join-tbl as character no-undo .
      463   define variable fld      as character no-undo .
      464   define variable lab      as character no-undo .
      465   define variable spr      as character no-undo .
      466   define variable dim      as character no-undo .
      467   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      468   procedure fltfield-clear :
      469     define output parameter loc-fld as character no-undo.
      470     define output parameter loc-lab as character no-undo .
      471     define output parameter loc-spr as character no-undo .
      472     define output parameter loc-dim as character no-undo .
      473     assign
      474       loc-fld = ""
      475       loc-lab = ""
      476       loc-spr = ""
      477       loc-dim = "0"
      478     .
      479   end procedure .
      480   procedure fltfield-add :
      481     define input        parameter par-fld as character no-undo.
      482     define input        parameter par-lab as character no-undo .
      483     define input        parameter par-spr as character no-undo .
      484     define input-output parameter loc-fld as character no-undo.
      485     define input-output parameter loc-lab as character no-undo .
      486     define input-output parameter loc-spr as character no-undo .
      487     define input-output parameter loc-dim as character no-undo .
      488     do
      489     on error undo, return error
      490     :
      491       assign
      492       loc-fld = if loc-dim = '0'
      493                 then par-fld
      494                 else (loc-fld + chr(44) + par-fld)
      495       loc-lab = if loc-dim = '0'
      496                 then par-lab
      497                 else (loc-lab + chr(44) + par-lab)
      498       loc-spr = if loc-dim = '0'
      499                 then par-spr
      500                 else (loc-spr + chr(44) + par-spr)
      501       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      502                 string(integer(if num-entries(loc-dim) > 1
      503                               then entry(2, loc-dim)
      504                               else entry(1, loc-dim)
      505                               ) + 1)
      506       no-error
      507       .
      508     end.
      509   end procedure.
      510   define new global shared variable g#libbcrcn as handle no-undo .
      511   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   define variable v-waitfram-action01         as character   no-undo .
      513   define variable v-waitfram-action02         as character   no-undo .
      514   define variable v-waitfram-action03         as character   no-undo .
      515   define variable mWaitFramTextBeg            as character   no-undo.
      516   define variable mWaitFramTextEnd            as character   no-undo.
      517   define variable mWaitFramView               as logical     no-undo.
      518   define variable mWaitProcEvent              as logical     no-undo init yes.
      519   define variable mWaitFramInterval           as integer     no-undo init 1 .
      520   define variable mWaitFramStop               as logical     no-undo.
      521   define variable mWaitFramStopUser           as logical     no-undo.
      522   define variable mWaitFramStopTimeOut        as logical     no-undo.
      523   define variable mWaitFramStartProc          as datetime-tz no-undo.
      524   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      525   define button B-WaitFramStop auto-end-key
      526        label "Стоп"
      527        size 10 by 1 tooltip "Остоновить процесс".
      528   define button B-viewProcInfo
      529        label "Информация"
      530        size 15 by 1 tooltip "Информация о процесс".
      531   define frame waitfram
      532     v-waitfram-action01 format "x(72)" no-label skip
      533     v-waitfram-action02 format "x(72)" no-label skip
      534     v-waitfram-action03 format "x(72)" no-label skip
      535     B-viewProcInfo
      536     B-WaitFramStop at row 4 col 30
      537     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      538     .
      539   define new global shared variable mBatchMode as logical no-undo init ?.
      540   define variable mFramBachModHandle as handle no-undo.
      541   mFramBachModHandle = frame waitfram:handle.
      542   define variable mFameOldVis as logical no-undo.
      543   define variable mVisCUrentVin as logical no-undo.
      544   if session:batch-mode
      545   then
      546      mBatchMode = yes.
      547   if mBatchMode = ? then do:
      548     mVisCUrentVin = current-window:visible.
      549     mFameOldVis = mFramBachModHandle:visible.
      550     mFramBachModHandle:visible  = yes.
      551     mBatchMode = mFramBachModHandle:visible ne yes.
      552     mFramBachModHandle:visible = mFameOldVis.
      553     current-window:visible = mVisCUrentVin.
      554   end.
      555    if  log-manager:logfile-name ne ?
      556     then DO:
      557         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      558         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      559         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      560     end.
      561   on choose of B-WaitFramStop in frame waitfram
      562   do:
      563     mWaitFramStop = yes.
      564     mWaitFramStopUser = yes.
      565   end.
      566   function waitfram-check-timeout returns logical():
      567      define variable vtime as int64 no-undo.
      568      if mWaitFramStopTimeOut
      569      then
      570         return yes.
      571      vtime = ( now - mWaitFramStartProc ) / 1000 .
      572      if     mWaitFramTimeOut ne ?
      573         and mWaitFramTimeOut ne 0
      574         and mWaitFramTimeOut lt vtime
      575      then do:
      576         mWaitFramStopTimeOut = yes.
      577      end.
      578      return mWaitFramStopTimeOut.
      579   end.
      580   procedure waitfram-hide :
      581     if not session:batch-mode
      582     then do
      583     on error undo, return error return-value
      584     :
      585       pause 0 before-hide .
      586       if not mBatchMode then
      587         hide frame waitfram .
      588     if     not mWaitFramView
      589        and mWaitProcEvent
      590     then
      591       process events .
      592     end.
      593   end procedure.
      594   procedure waitfram-show :
      595     define input  parameter p-message as character no-undo .
      596     define variable v-left-margin as integer   no-undo .
      597     if not session:batch-mode
      598     then do
      599     on error undo, return error return-value
      600     :
      601       if length(p-message) <= 70 then do:
      602         assign
      603           v-left-margin = integer((70 - length(p-message)) / 2)
      604         .
      605         assign
      606           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      607         .
      608         assign
      609           v-waitfram-action01 = " "
      610           v-waitfram-action02 = " "
      611                                    + fill(" ", v-left-margin)
      612                                    + p-message
      613           v-waitfram-action03 = " "
      614         .
      615       end.
      616       else do:
      617         define variable vRindex1 as integer no-undo.
      618         define variable vRindex2 as integer no-undo.
      619         vRindex1 = r-index(p-message," ",70).
      620         if vRindex1 = 0
      621         then
      622            vRindex1 = 70.
      623         if length(p-message)  <= vRindex1 + 70 then do:
      624           assign
      625             v-waitfram-action01 = " "
      626             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      627             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      628           .
      629         end.
      630         else do:
      631           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      632           if vRindex2 <= vRindex1
      633           then
      634              vRindex2 = vRindex1 + 70.
      635           assign
      636             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      637             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      638             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      639           .
      640         end.
      641       end.
      642       B-viewProcInfo:visible   in frame waitfram = no.
      643       B-viewProcInfo:sensitive in frame waitfram = no.
      644       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      645       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      646       if  (   mWaitFramView
      647          or  mWaitProcEvent)
      648          and not mBatchMode
      649       then
      650          display
      651             v-waitfram-action01 skip
      652             v-waitfram-action02 skip
      653             v-waitfram-action03 skip
      654          with frame waitfram .
      655       if     mWaitFramView
      656          then do:
      657             if     mWaitFramInterval ne ?
      658                and not mBatchMode
      659             then
      660                wait-for go of frame waitfram pause mWaitFramInterval.
      661          end.
      662          else
      663             if     mWaitProcEvent
      664                and not mBatchMode
      665             then
      666                process events .
      667     end.
      668   end procedure.
      669      procedure waitfram-show-this:
      670         define input  parameter iInterval as int64 no-undo.
      671         define variable vtime as int64 no-undo.
      672         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      673         mWaitFramInterval = iInterval.
      674         run waitfram-show (substitute("&1&2 &3&4" ,
      675                                       mWaitFramTextBeg ,
      676                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      677                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      678                                       mWaitFramTextEnd
      679                                      )
      680                           ).
      681      end.
      682      procedure WaitFramRunPause:
      683         define input  parameter iInterval as dec no-undo.
      684         define variable vStart  as datetime-tz no-undo.
      685         define variable vend    as datetime-tz no-undo.
      686         define variable vint as int64 no-undo.
      687         define variable vOk as logical no-undo.
      688         vStart = now.
      689         vend   = vStart.
      690         publish "WaitFramPause" (iInterval,output vOk).
      691         vend   =  now.
      692         vint = vend - vStart.
      693         vint = iInterval - vint / 1000.
      694         if     not mWaitFramStop
      695            and (   vint > 0
      696                 or (    not vOk
      697                     and iInterval eq ?
      698                     )
      699                 )
      700         then
      701            run waitfram-show-this (iInterval).
      702         vend   =  now.
      703         vint = vend - vStart.
      704         vint = iInterval - vint / 1000.
      705         if     not mWaitFramStop
      706            and vint > 0
      707         then do:
      708            run gbl/pause.p (vint * 1000).
      709         end.
      710         if iInterval ne ?
      711         then
      712            publish "WaitFramStop".
      713         waitfram-check-timeout().
      714      end.
      715      procedure WaitFramWaitFor:
      716         define input  parameter iInterval as dec no-undo.
      717         assign
      718            mWaitFramStartProc   = now
      719            mWaitFramStopUser    = no
      720            mWaitFramStopTimeOut = no
      721         .
      722         block-wait:
      723         do while not mWaitFramStop:
      724            run WaitFramRunPause (iInterval).
      725            if  waitfram-check-timeout()
      726            then do:
      727               leave block-wait.
      728            end.
      729         end.
      730         run waitfram-hide.
      731      end.
      732   procedure waitfram-join :
      733     define input  parameter p-line-1  as character no-undo .
      734     define input  parameter p-line-2  as character no-undo .
      735     define input  parameter p-line-3  as character no-undo .
      736     define output parameter p-message as character no-undo .
      737     do
      738     on error undo, return error return-value
      739     :
      740       assign
      741         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      742                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      743                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      744       .
      745     end.
      746   end procedure.
      747   function waitfram-join-function returns character
      748     (input p-line-1 as character
      749     ,input p-line-2 as character
      750     ,input p-line-3 as character
      751     ).
      752     define variable v-message as character no-undo .
      753     run waitfram-join in this-procedure
      754       (input  p-line-1
      755       ,input  p-line-2
      756       ,input  p-line-3
      757       ,output v-message
      758       ) .
      759     return v-message .
      760   end function .
      761   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762     define variable v-cntxt-db-num        as integer   no-undo .
      763     define variable v-cntxt-userid        as character no-undo .
      764     define variable v-cntxt-level         as character no-undo .
      765     define variable v-cntxt-host-code-obj as integer   no-undo .
      766     define variable v-cntxt-obj-type      as character no-undo .
      767     define variable v-cntxt-obj-code      as integer   no-undo .
      768     define variable v-cntxt-db-num-obj    as integer   no-undo .
      769     define variable v-cntxt-is-admin      as logical   no-undo .
      770   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      771   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      772   procedure fltopend_fltopend :
      773   define input parameter p-parent-handle as handle no-undo .
      774   define input parameter p-qh as handle no-undo .
      775   define input parameter p-flt-open-open-query  as character no-undo .
      776   define input parameter p-where-cond as character no-undo .
      777   define input parameter p-use-indFIRST-query-tail as character no-undo .
      778   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      779   define input parameter p-indexed-reposition as character no-undo .
      780     do
      781     on error undo, return error
      782     :
      783   define variable v-prepare-string as character no-undo .
      784   define variable glog as logical no-undo .
      785   assign
      786   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      787                      p-where-cond + chr(32)  +
      788                      p-use-indFIRST-query-tail + chr(32) +
      789                      p-use-ind-sort-clmn-by + chr(32) +
      790                      p-indexed-reposition
      791   .
      792   assign
      793   glog = p-qh:query-prepare(v-prepare-string) no-error .
      794   if not glog
      795   or error-status:error then do:
      796     message error-status:get-message(1) view-as alert-box .
      797     undo, return error .
      798   end.
      799   assign
      800   glog = p-qh:query-open no-error .
      801   if not glog
      802   or error-status:error then do:
      803     message error-status:get-message(1) view-as alert-box .
      804     undo, return error .
      805   end.
      806     end.
      807   end procedure.
      808   procedure fltopend_fltfindd :
      809   define input parameter p-parent-handle as handle no-undo .
      810   define input parameter p-qh as handle no-undo .
      811   define input parameter p-rowid as rowid no-undo .
      812   define input parameter p-next as logical no-undo .
      813   define input parameter p-lock as integer no-undo .
      814   define input parameter p-bh as handle no-undo .
      815   define input parameter p-where-cond as character no-undo .
      816   define input parameter p-use-index-phrase as character no-undo .
      817   define variable glog as logical no-undo .
      818   define variable v-qh as handle no-undo .
      819   define variable v-bh as handle no-undo .
      820   define variable v-recid as recid no-undo .
      821   define variable v-prepare-string as character no-undo .
      822   do
      823   on error undo, return error
      824   on stop undo, return error
      825   :
      826     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      827     create buffer v-bh for table p-bh buffer-name p-bh:name.
      828     create query v-qh.
      829     v-qh:set-buffers(v-bh).
      830     v-prepare-string = substitute("for each &1 &2 &3"
      831                                     ,v-bh:name
      832                                     ,p-where-cond
      833                                     ,p-use-index-phrase).
      834     glog = v-qh:query-prepare(v-prepare-string) no-error.
      835     if not glog then do:
      836       delete object v-qh.
      837       delete object v-bh.
      838       undo, return error .
      839     end.
      840     glog = v-qh:query-open no-error .
      841     if not glog then do:
      842       delete object v-qh.
      843       delete object v-bh.
      844       undo, return error .
      845     end.
      846     if p-next then do:
      847       v-qh:reposition-to-rowid(p-rowid) no-error .
      848       glog = v-qh:get-next( p-lock) no-error .
      849       glog = v-qh:get-next( p-lock) no-error .
      850       if not glog or v-qh:query-off-end = yes then do:
      851         glog = v-qh:get-first( p-lock) no-error .
      852       end.
      853     end.
      854     else do:
      855       glog = v-qh:get-first( p-lock) no-error .
      856     end.
      857     v-recid = v-bh:recid no-error .
      858     delete object v-qh.
      859     delete object v-bh.
      860     return string(v-recid) .
      861   end.
      862   end procedure.
      863   procedure fltopend_fltfindq :
      864   define input parameter p-parent-handle as handle no-undo .
      865   define input parameter p-qh as handle no-undo .
      866   define input parameter p-next as logical no-undo .
      867   define input parameter p-lock as integer no-undo .
      868   define input parameter p-flt-open-open-query  as character no-undo .
      869   define input parameter p-where-cond as character no-undo .
      870   define input parameter p-use-indFIRST-query-tail as character no-undo .
      871   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      872   define input parameter p-indexed-reposition as character no-undo .
      873   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      874   define variable glog as logical no-undo .
      875   define variable v-qh as handle no-undo .
      876   define variable v-bh as handle no-undo extent 18.
      877   define variable v-rowid as rowid no-undo extent 18.
      878   define variable v-ii as integer no-undo .
      879   define variable v-prepare-string as character no-undo .
      880   do
      881   on error undo, return error
      882   on stop undo, return error
      883   :
      884     create query v-qh.
      885     do v-ii = 1 to p-qh:num-buffers:
      886       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      887       assign
      888       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      889       no-error.
      890       v-qh:add-buffer(v-bh[v-ii]).
      891     end.
      892     assign
      893     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      894                       p-where-cond + chr(32)  +
      895                       p-use-indFIRST-query-tail + chr(32) +
      896                       p-use-ind-sort-clmn-by + chr(32) +
      897                       p-indexed-reposition
      898     .
      899     glog = v-qh:query-prepare( v-prepare-string) no-error .
      900     if not glog then do:
      901       delete object v-qh.
      902       do v-ii = 1 to p-qh:num-buffers:
      903         delete object v-bh[v-ii].
      904       end.
      905       undo, return error .
      906     end.
      907     glog = v-qh:query-open no-error .
      908     if not glog then do:
      909       delete object v-qh.
      910       do v-ii = 1 to p-qh:num-buffers:
      911         delete object v-bh[v-ii].
      912       end.
      913       undo, return error .
      914     end.
      915     if p-next then do:
      916       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      917       glog = v-qh:get-next( p-lock) no-error .
      918       glog = v-qh:get-next( p-lock) no-error .
      919       if not glog or v-qh:query-off-end = yes then do:
      920         glog = v-qh:get-first( p-lock) no-error .
      921       end.
      922     end.
      923     else do:
      924       glog = v-qh:get-first( p-lock) no-error .
      925     end.
      926     do v-ii = 1 to p-qh:num-buffers:
      927       assign
      928       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      929       no-error.
      930     end.
      931     delete object v-qh.
      932     do v-ii = 1 to p-qh:num-buffers:
      933       delete object v-bh[v-ii].
      934     end.
      935   end.
      936   end procedure.
