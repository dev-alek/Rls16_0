      941   define variable filter-label0 as character no-undo init "Весовые_товары" .
      942   define variable filter-label as character no-undo init "Весовые_товары" .
      943   define variable filter-point as character no-undo init "scgdsobj".
      944   define variable filter-point0 as character no-undo init "scgdsobj".
      945   define variable sort-column-name as character no-undo .
      946   define variable code-option as character no-undo.
      947   define variable line-rec as recid no-undo .
      948   define variable gds-rec     as recid             no-undo.
      949   define variable v-doc-rec as recid no-undo .
      950   define variable conf-par as char no-undo.
      951   define variable par-type as char no-undo.
      952   define variable varscales-pref as character no-undo .
      953   define variable varpgscales-pref as character no-undo .
      954   DEFINE MENU MENU-B-code
      955          MENU-ITEM m_Prod-bc      LABEL "Весовые"
      956          MENU-ITEM m_all          LABEL "Все"           .
      957   DEFINE BUTTON B-chg
      958        LABEL "Смена вес. кода"
      959        SIZE 20 BY 1.
      960   DEFINE BUTTON B-code
      961        LABEL "&Коды"
      962        SIZE 10 BY 1.
      963   DEFINE BUTTON B-Help
      964        LABEL "Помо&щь"
      965        SIZE 3 BY 1
      966        BGCOLOR 8 .
      967   DEFINE BUTTON b-quit AUTO-END-KEY
      968        LABEL "&Выход"
      969        SIZE 10 BY 1
      970        BGCOLOR 8 .
      971   DEFINE BUTTON B-scales
      972        LABEL "Вес&ы"
      973        SIZE 10 BY 1.
      974   DEFINE BUTTON B-sch
      975        LABEL "&Фильтр"
      976        SIZE 3 BY 1.
      977   DEFINE VARIABLE loc-art AS CHARACTER FORMAT "X(256)":U
      978        LABEL "Начало артикула"
      979        VIEW-AS FILL-IN
      980        SIZE 14 BY 1
      981        FGCOLOR 12  NO-UNDO.
      982   DEFINE VARIABLE loc-code AS CHARACTER FORMAT "X(256)":U
      983        LABEL "Бар-код (весь)"
      984        VIEW-AS FILL-IN
      985        SIZE 14 BY 1
      986        FGCOLOR 12  NO-UNDO.
      987   DEFINE VARIABLE loc-name AS CHARACTER FORMAT "X(256)":U
      988        LABEL "Начало названия"
      989        VIEW-AS FILL-IN
      990        SIZE 20 BY 1
      991        FGCOLOR 12  NO-UNDO.
      992   DEFINE VARIABLE a-n-c AS CHARACTER INITIAL "art"
      993        VIEW-AS RADIO-SET HORIZONTAL
      994        RADIO-BUTTONS
      995             "&А", "art",
      996   "&Н", "name",
      997   "&К", "code",
      998   "Вес.код", "ves"
      999        SIZE 25.25 BY 1 NO-UNDO.
     1000   DEFINE VARIABLE RS-mode AS CHARACTER
     1001        VIEW-AS RADIO-SET HORIZONTAL
     1002        RADIO-BUTTONS
     1003             "Факт", "1",
     1004   "Объект", "2"
     1005        SIZE 18.5 BY .75 NO-UNDO.
     1006   DEFINE QUERY BR-gds FOR
     1007         X_goods,
     1008         X_units,
     1009         X_gds-obj,
     1010         X_gds-obj-attr SCROLLING.
     1011   DEFINE BROWSE BR-gds
     1012     QUERY BR-gds NO-LOCK DISPLAY
     1013         X_goods.artic FORMAT "X(16)":U
     1014         X_goods.gds-code FORMAT "999999999":U
     1015         X_goods.gds-name FORMAT "X(30)":U
     1016         X_gds-obj-attr.attr-value COLUMN-LABEL "Текущий!вес.код" FORMAT "X(5)":U
     1017         X_goods.grp-name FORMAT "X(40)":U
     1018         X_gds-obj.price-sale FORMAT "->>>,>>>,>>9.99":U
     1019         X_gds-obj.fact-qnty FORMAT "->>,>>>,>>9.<<<":U
     1020         X_gds-obj.free-qnty FORMAT "->>,>>>,>>9.<<<":U
     1021     ENABLE
     1022         X_gds-obj-attr.attr-value
     1023       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17.46.
     1024   DEFINE FRAME Dialog-Frame
     1025        b-quit AT ROW 1 COL 1
     1026        B-scales AT ROW 1 COL 11
     1027        B-code AT ROW 1 COL 21
     1028        B-chg AT ROW 1 COL 41
     1029        B-sch AT ROW 1 COL 92
     1030        B-Help AT ROW 1 COL 95
     1031        loc-name AT ROW 2.5 COL 51.5 COLON-ALIGNED
     1032        loc-code AT ROW 2.5 COL 51.5 COLON-ALIGNED
     1033        loc-art AT ROW 2.5 COL 51.5 COLON-ALIGNED
     1034        a-n-c AT ROW 2.54 COL 9.75 NO-LABEL
     1035        RS-mode AT ROW 2.58 COL 78.13 NO-LABEL
     1036        BR-gds AT ROW 4.04 COL 1
     1037        "Поиск:" VIEW-AS TEXT
     1038             SIZE 7.5 BY 1 AT ROW 2.54 COL 1.63
     1039        SPACE(89.87) SKIP(18.62)
     1040       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1041            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1042            TITLE "Весовые товары магазина"
     1043            CANCEL-BUTTON b-quit.
     1044   ASSIGN
     1045          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1046          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1047   ASSIGN
     1048          B-code:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-code:HANDLE.
     1049   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1050   DO:
     1051     APPLY "END-ERROR":U TO SELF.
     1052   END.
     1053   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1054   DO:
     1055     define variable r-bar-code like ub.bar-code.b-code no-undo.
     1056     define variable ref-list as character no-undo.
     1057     define variable glog as logical no-undo .
     1058     define variable gds-rec as recid no-undo .
     1059     define variable v-obj-db-num as integer no-undo .
     1060     define buffer buf_scales-gds for ub.scales-gds.
     1061     define buffer buf_prod-bc for ub.prod-bc.
     1062     if not avail X_goods then return no-apply.
     1063     define variable v-chk-act-host-code as integer   no-undo .
     1064   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1065   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1066     (input  p-obj-type
     1067     ,input  p-obj-code
     1068     ,output v-chk-act-host-code
     1069     )  .
     1070   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1071   do:
     1072     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1073       (input  v-cntxt-db-num
     1074       ,input  v-cntxt-userid
     1075       ,input  0
     1076       ,input  'actn_object-weight-code_update':U
     1077       ,input  'object':U
     1078       ,input  v-chk-act-host-code
     1079       ,input  p-obj-type
     1080       ,input  p-obj-code
     1081       ,input  0
     1082       ,input  X_goods.grp-code
     1083       ,input  0
     1084       ,input  true
     1085       ,output glog
     1086       )  .
     1087   end.
     1088     if not glog then return no-apply.
     1089       gds-rec = recid (X_goods).
     1090   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1091     (input  X_goods.gds-code
     1092     ,input  ?
     1093     ,output r-bar-code
     1094     ) no-error .
     1095       run ref/prod-cds.w (
     1096                        input parparentproc
     1097                       ,input p-obj-type
     1098                       ,input p-obj-code
     1099                       ,input  "code-all":U
     1100                       ,input X_goods.gds-code
     1101                       ,input r-bar-code
     1102                       ,output ref-list ).
     1103       if ref-list <> "" then do:
     1104         glog = no.
     1105         message
     1106         "Вы действительно хотите поменять текущий весовой код для товара?"   skip
     1107         "(После замены данный товар на весах будет взвешиваться с новым кодом)"
     1108         view-as alert-box QUESTION buttons YEs-no update gLog.
     1109         if not glog then return no-apply.
     1110   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1111   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1112     (input  X_gds-obj.obj-type
     1113     ,input  X_gds-obj.obj-code
     1114     ,output v-obj-db-num
     1115     )  .
     1116         find first buf_scales-gds No-LOCK WHERE
     1117                    buf_scales-gds.b-code = r-bar-code
     1118               and buf_scales-gds.db-num = v-obj-db-num
     1119                     No-ERROR.
     1120         if avail buf_scales-gds then do:
     1121           message "Товар имеется на весах"  skip
     1122                   "смена текущего весового кода невозможна"
     1123           view-as alert-box ERROR.
     1124             return no-apply.
     1125         end.
     1126         find first buf_prod-bc No-LOCK WHERE
     1127                     recid(buf_prod-bc) = integer(ref-list) No-ERROR.
     1128         if error-status:error then return no-apply.
     1129         if buf_prod-bc.bc-on = false then do:
     1130           message
     1131           "Данный весовой код выключен" skip
     1132           "смена весового кода невозможна"
     1133           view-as alert-box ERROR.
     1134           return no-apply.
     1135         end.
     1136         run proc-b-chg in this-procedure ( input X_goods.gds-code
     1137                                          , input X_gds-obj.obj-type
     1138                                          , input X_gds-obj.obj-code
     1139                                          , buffer buf_prod-bc) no-error.
     1140         if error-status:error then do:
     1141             message "Смена текущего весового кода не удалась"
     1142             view-as alert-box ERROR.
     1143             return no-apply.
     1144         end.
     1145         run openbr in this-procedure ( input yes, input no, input '':U).
     1146         reposition br-gds to recid gds-rec no-error.
     1147         APPLY "ENTRY" to br-gds.
     1148       end.
     1149   END.
     1150   ON CHOOSE OF B-code IN FRAME Dialog-Frame
     1151   DO:
     1152      if code-option = "" then do:
     1153       run gbl/pop-up.p ( input self:handle, input no) no-error.
     1154       if error-status:error then return no-apply.
     1155     end.
     1156    if code-option = "" then return no-apply.
     1157    run proc-b-code in this-procedure ( input-output code-option, buffer X_goods) no-error.
     1158    if error-status:error then return no-apply.
     1159   END.
     1160   ON CHOOSE OF B-scales IN FRAME Dialog-Frame
     1161   DO:
     1162   define variable r-bar-code like ub.bar-code.b-code no-undo.
     1163   define variable gds-rec as recid no-undo .
     1164     if not avail X_goods then return no-apply.
     1165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1166     (input  X_goods.gds-code
     1167     ,input  ?
     1168     ,output r-bar-code
     1169     ) no-error .
     1170     gds-rec = recid(X_goods).
     1171      run ref/scgdssc.w (
     1172                     input parparentproc
     1173                    ,input v-cntxt-db-num-obj
     1174                    ,input r-bar-code
     1175                    ,input (if avail X_gds-obj then X_gds-obj.obj-type else p-obj-type)
     1176                    ,input (if avail X_gds-obj then X_gds-obj.obj-code else p-obj-code)).
     1177     run openbr in this-procedure ( input yes, input no, input '':U).
     1178     reposition br-gds to recid gds-rec no-error.
     1179     APPLY "ENTRY" to br-gds.
     1180   END.
     1181   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1182   DO:
     1183     run init-flt in this-procedure no-error.
     1184     if error-status:error then return no-apply.
     1185       DO on stop undo, leave:
     1186           run gbl/filter.w ( input parparentproc
     1187                            , input (filter-point + chr(4) + filter-label)
     1188                            , input tbl
     1189                            , input join-tbl
     1190                            , input fld
     1191                            , input lab
     1192                            , input spr
     1193                            , input dim).
     1194           RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     1195       END .
     1196   END.
     1197   ON CHOOSE OF MENU-ITEM m_all
     1198   DO:
     1199     assign
     1200     code-option = "all":U.
     1201     run proc-b-code  in this-procedure ( input-output code-option, buffer X_goods) no-error.
     1202     if error-status:error then return no-apply.
     1203   END.
     1204   ON CHOOSE OF MENU-ITEM m_Prod-bc
     1205   DO:
     1206       assign
     1207     code-option = "scales-all":U.
     1208     run proc-b-code in this-procedure ( input-output code-option, buffer X_goods) no-error.
     1209     if error-status:error then return no-apply.
     1210   END.
     1211   ON VALUE-CHANGED OF RS-mode IN FRAME Dialog-Frame
     1212   DO:
     1213   define variable gds-rec as recid no-undo .
     1214     gds-rec = recid(X_goods).
     1215     assign RS-MODE.
     1216     Run MyEnable in this-procedure .
     1217     Run OpenBr in this-procedure ( input yes, input no, input '':U).
     1218     reposition br-gds to recid gds-rec no-error.
     1219     APPLY "ENTRY" to br-gds.
     1220   END.
     1221   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1222   procedure set-filter-name :
     1223   define input parameter p-filter-name as character no-undo .
     1224     do with frame Dialog-Frame:
     1225       if p-filter-name > "" then do:
     1226         assign
     1227           frame Dialog-Frame:title
     1228             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     1229         .
     1230         assign
     1231           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     1232         .
     1233       end.
     1234       else do:
     1235         assign
     1236           b-sch :tooltip = ""
     1237         .
     1238       end.
     1239     end.
     1240   end procedure.
     1241   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1242   on value-changed of a-n-c in frame Dialog-Frame do:
     1243     case input frame Dialog-Frame a-n-c :
     1244       when "art":U then do:
     1245         apply "entry" to br-gds in frame Dialog-Frame.
     1246         hide loc-name loc-code in frame Dialog-Frame.
     1247         loc-art = "".
     1248       end.
     1249       when "name":U then do:
     1250         enable loc-name with frame Dialog-Frame.
     1251         disp loc-name with frame Dialog-Frame.
     1252         hide loc-art loc-code in frame Dialog-Frame.
     1253         apply "entry" to loc-name in frame Dialog-Frame.
     1254       end.
     1255       when "code":U then do:
     1256         enable loc-code with frame Dialog-Frame.
     1257         loc-code:label = "Бар-код (весь)".
     1258         disp loc-code with frame Dialog-Frame.
     1259         hide loc-art loc-name in frame Dialog-Frame.
     1260         apply "entry" to loc-code in frame Dialog-Frame.
     1261       end.
     1262       when "ves":U then do:
     1263         enable loc-code with frame Dialog-Frame.
     1264         loc-code:label = "Вес. код".
     1265         disp loc-code with frame Dialog-Frame.
     1266         hide loc-art loc-name in frame Dialog-Frame.
     1267         apply "entry" to loc-code in frame Dialog-Frame.
     1268       end.
     1269     end.
     1270   end.
     1271   on any-printable of br-gds in frame Dialog-Frame do:
     1272     if input frame Dialog-Frame a-n-c = "art":U then do:
     1273       if last-event:label = " " and loc-art = "" then return no-apply.
     1274       FIND FIRST l-goods NO-LOCK WHERE
     1275                  l-goods.artic begins (loc-art + last-event:label) use-index pi NO-ERROR.
     1276       if avail l-goods then do:
     1277         loc-art = loc-art + last-event:label.
     1278         disp loc-art with frame Dialog-Frame.
     1279         line-rec = recid (l-goods).
     1280         reposition br-gds to recid line-rec no-error.
     1281       end.
     1282       else bell.
     1283     end.
     1284   end.
     1285   on backspace of br-gds in frame Dialog-Frame do:
     1286     if input frame Dialog-Frame a-n-c = "art":U then do:
     1287       if loc-art = "" then return no-apply.
     1288       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     1289       FIND FIRST l-goods NO-LOCK WHERE
     1290                  l-goods.artic begins loc-art use-index pi NO-ERROR.
     1291       disp loc-art with frame Dialog-Frame.
     1292       line-rec = recid (l-goods).
     1293       reposition br-gds to recid line-rec no-error.
     1294     end.
     1295   end.
     1296   ON MOUSE-SELECT-DBLCLICK, return OF loc-code IN FRAME Dialog-Frame do:
     1297   def var str-code as integer no-undo.
     1298   def var r-bar-code like ub.bar-code.b-code no-undo.
     1299   define variable varresult   as character                no-undo.
     1300   define variable vartype-bc  as character                no-undo.
     1301   define variable varweight   as decimal                  no-undo.
     1302     assign loc-code a-n-c.
     1303     case a-n-c:
     1304       when "code":U then do:
     1305   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1306   (
     1307    input  parparentproc
     1308   ,input  loc-code
     1309   ,input  ?
     1310   ,input  p-obj-type
     1311   ,input  p-obj-code
     1312   ,input  yes
     1313   ,input  no
     1314   ,input  varscales-pref
     1315   ,input  varpgscales-pref
     1316   ,output varresult
     1317   ,output vartype-bc
     1318   ,output varweight
     1319   ,buffer l-bar-code
     1320   ,buffer ub.prod-bc
     1321   ,buffer ub.place
     1322   ) no-error.
     1323        if error-status:error then do:
     1324          message "Ошибка при разборе бар-кода".
     1325          return no-apply.
     1326        end.
     1327        if avail l-bar-code then do:
     1328   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1329     (input  l-bar-code.gds-code
     1330     ,input  ?
     1331     ,output r-bar-code
     1332     ) no-error .
     1333           if error-status:error then do:
     1334              message "Бар-код не найден.".
     1335             return no-apply.
     1336           end.
     1337           FOR EACH  l-bar-code where
     1338                     l-bar-code.b-code = integer (r-bar-code) NO-LOCK,
     1339               FIRST l-goods No-LOCK WHERE
     1340                     l-goods.gds-code = l-bar-code.gds-code:
     1341               LEAVE.
     1342          END.
     1343          if avail l-goods then do:
     1344            line-rec = recid (l-goods).
     1345            reposition br-gds to recid line-rec no-error.
     1346          end.
     1347          else message "Строка не найдена.".
     1348        end.
     1349        else message "Бар-код не найден.".
     1350       end.
     1351       when "ves":U then do:
     1352        FIND FIRST l-prod-bc WHERE l-prod-bc.b-str = string(integer(loc-code), "99999") NO-LOCK No-ERROR.
     1353        IF AVAIl l-prod-bc then do:
     1354           FOR EACH  l-prod-bc WHERE
     1355                     l-prod-bc.bc-on = TRUE AND
     1356                     l-prod-bc.b-str = string(integer(loc-code), "99999") NO-LOCK,
     1357               FIRST l-bar-code WHERE
     1358                     l-bar-code.b-code = l-prod-bc.b-code NO-LOCK,
     1359               FIRST l-goods WHERE
     1360                     l-goods.gds-code = l-bar-code.gds-code NO-LOCK:
     1361              LEAVE.
     1362          END.
     1363            if avail l-goods then do:
     1364                line-rec = recid (l-goods).
     1365                reposition br-gds to recid line-rec no-error.
     1366            end.
     1367            else message "Строка не найдена.".
     1368        end.
     1369        else message "Весовой код не найден.".
     1370       end.
     1371     end case.
     1372     apply "entry" to loc-code in frame Dialog-Frame.
     1373     return no-apply.
     1374   end.
     1375   ON MOUSE-SELECT-DBLCLICK, return OF loc-name IN FRAME Dialog-Frame do:
     1376     assign loc-name.
     1377     FIND FIRST l-goods WHERE
     1378             l-goods.gds-name begins loc-name NO-LOCK No-ERROR.
     1379     if avail l-goods then do:
     1380       assign
     1381       line-rec = recid (l-goods).
     1382       reposition br-gds to recid line-rec no-error.
     1383     end.
     1384     else do:
     1385          message "Строка не найдена.".
     1386      end.
     1387     apply "entry" to loc-name in frame Dialog-Frame.
     1388     return no-apply.
     1389   end.
     1390   on iteration-changed of br-gds in frame Dialog-Frame do:
     1391     if not avail X_goods or recid (X_goods) <> line-rec then do:
     1392       hide loc-art in frame Dialog-Frame.
     1393       loc-art = "".
     1394     end.
     1395   end.
     1396   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1397   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1398   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1399   on help of frame Dialog-Frame
     1400   do:
     1401     run gbl/app_help.p
     1402       (input this-procedure :file-name
     1403       ,input ''
     1404       ,input ?
     1405       ) no-error.
     1406     if error-status :error then do:
     1407       message
     1408         "Ошибка при вызове помощи"
     1409         error-status :get-message(1)
     1410         view-as alert-box .
     1411     end.
     1412   end.
     1413   run minbtn-set in this-procedure .
     1414   on choose of b-help in frame Dialog-Frame
     1415   do:
     1416     apply "help":u to frame Dialog-Frame .
     1417   end.
     1418   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1419   procedure minbtn-set :
     1420       do
     1421           on error undo, return error return-value
     1422           :
     1423           define variable ii              as integer       no-undo .
     1424           define variable fh              as widget-handle no-undo .
     1425           define variable hh              as widget-handle no-undo .
     1426           define variable v-h             as handle        extent 4 no-undo .
     1427           define variable v-name-button   as character     no-undo .
     1428           define variable v-help-old-x    as decimal       no-undo .
     1429           define variable v-help-old-y    as decimal       no-undo .
     1430           define variable v-help-old-size as decimal       no-undo .
     1431           define variable v-frame-width   as decimal       no-undo .
     1432           define variable jj              as integer       no-undo .
     1433           do
     1434               on error undo, return error
     1435               :
     1436               assign
     1437                   v-frame-width = frame Dialog-Frame:width - 0.3
     1438                   fh            = frame Dialog-Frame:first-child
     1439                   hh            = fh:first-child
     1440                   ii            = 1
     1441                   .
     1442               do while valid-handle(hh):
     1443                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1444                   do:
     1445                       case lc(hh:name) :
     1446                           when "b-help" then
     1447                               do:
     1448                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1449                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1450                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1451                                   hh:TOOLTIP = "Помощь" .
     1452                                   v-help-old-x = hh:column .
     1453                                   v-help-old-y = hh:row    .
     1454                                   v-help-old-size = hh:width .
     1455                                   hh:width-chars = 2.5 .
     1456                               end.
     1457                           when "b-print" then
     1458                               do:
     1459                                   hh:load-image("cmp/b-print.bmp":u) .
     1460                                   hh:TOOLTIP = "Печать" .
     1461                                   v-h[ii] = hh:handle .
     1462                                   ii = ii + 1 .
     1463                                   hh:width-chars = 3 .
     1464                               end.
     1465                           when "b-history" or
     1466                           when "b-hist" then
     1467                               do:
     1468                                   hh:load-image("cmp/b-hist.bmp":u) .
     1469                                   hh:TOOLTIP = "История" .
     1470                                   v-h[ii] = hh:handle .
     1471                                   ii = ii + 1 .
     1472                                   hh:width-chars = 3 .
     1473                               end.
     1474                           when "b-sch" then
     1475                               do:
     1476                                   hh:load-image("cmp/b-sch.bmp":u) .
     1477                                   hh:TOOLTIP = "Установка Фильтра" .
     1478                                   v-h[ii] = hh:handle .
     1479                                   ii = ii + 1 .
     1480                                   hh:width-chars = 3 .
     1481                               end.
     1482                           when "b-hist-user" then
     1483                               do:
     1484                                   hh:load-image("cmp/b-hist.bmp":u) .
     1485                                   hh:TOOLTIP = "История пользователя" .
     1486                                   ii = ii + 1 .
     1487                               end.
     1488                       end case.
     1489                   end.
     1490                   hh = hh:next-sibling.
     1491               end.
     1492               b-help:column = v-frame-width - b-help:width-chars.
     1493               jj = 0.
     1494               repeat ii = 4 to 1 by -1 :
     1495                   if valid-handle (v-h[ii] ) then
     1496                   do:
     1497                       jj  = jj + 1 .
     1498                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1499                       v-h[ii]:row    = v-help-old-y .
     1500                   end.
     1501               end.
     1502           end.
     1503       end.
     1504   end procedure.
     1505   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1506   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1507   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1508   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1509   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1510   define variable v-diasize-current-frame-height as decimal   no-undo .
     1511   define variable v-diasize-change-size          as logical   no-undo .
     1512   define variable v-diasize-resize-button        as handle    no-undo .
     1513   define variable v-diasize-wndmax               as logical   no-undo .
     1514   define variable v-diasize-wndstore             as logical   no-undo .
     1515   define variable v-diasize-proc-name            as character no-undo .
     1516   define variable v-diasize-browse-handle        as handle    no-undo .
     1517   define variable v-diasize-browse-number        as integer   no-undo .
     1518   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1519   define temp-table temp-diasize-handle no-undo
     1520     field handle-value  as handle
     1521     field save-position as decimal
     1522     index xpk is primary unique handle-value
     1523     .
     1524   define temp-table temp-browse-handle no-undo
     1525     field browse-type   as character
     1526     field browse-number as integer
     1527     field browse-handle as handle
     1528     field original-size as decimal
     1529     index xpk is primary unique browse-type browse-number
     1530     index xie browse-type browse-handle
     1531   .
     1532   procedure diasize_change-height :
     1533     define input  parameter p-change-value  as decimal   no-undo .
     1534     define input  parameter p-move-resize   as logical   no-undo .
     1535     define variable v-field-group-handle    as handle    no-undo .
     1536     define variable v-object-handle         as handle    no-undo .
     1537     define variable v-frame-height          as decimal   no-undo .
     1538     define variable v-frame-virtual-height  as decimal   no-undo .
     1539     define variable v-browse-height         as decimal   no-undo .
     1540     define variable v-window-height         as decimal   no-undo .
     1541     define variable v-window-virtual-height as decimal   no-undo .
     1542     define variable v-change-sign           as integer   no-undo .
     1543     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1544     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1545     if p-change-value > 0
     1546     then do:
     1547       if frame Dialog-Frame :height + p-change-value
     1548           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1549       then do:
     1550         assign
     1551           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1552                           - (frame Dialog-Frame :height-chars)
     1553         .
     1554         if p-change-value <= 0
     1555         then do:
     1556           run diasize_position-resize-button in this-procedure .
     1557           return .
     1558         end.
     1559       end.
     1560     end.
     1561     if p-change-value < 0
     1562     then do:
     1563       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1564       then do:
     1565         assign
     1566           p-change-value = v-diasize-orig-frame-height
     1567                          - (frame Dialog-Frame :height-chars)
     1568         .
     1569         if p-change-value >= 0
     1570         then do:
     1571           run diasize_position-resize-button in this-procedure .
     1572           return .
     1573         end.
     1574       end.
     1575     end.
     1576     if p-change-value >= 0
     1577     then do:
     1578       assign
     1579         v-change-sign = 1
     1580       .
     1581     end.
     1582     else do:
     1583       assign
     1584         v-change-sign = -1
     1585       .
     1586     end.
     1587     assign
     1588       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1589     .
     1590     if p-change-value = 0
     1591     then do:
     1592       run diasize_position-resize-button in this-procedure .
     1593       return .
     1594     end.
     1595     move_block:
     1596     do
     1597     on error undo move_block, retry move_block
     1598     :
     1599       if retry
     1600       then do:
     1601         do
     1602         on error undo move_block, leave move_block
     1603         :
     1604           if p-change-value > 0
     1605           then do:
     1606             for each buf_temp-diasize-handle
     1607             on error undo, next
     1608             :
     1609               assign
     1610                 v-object-handle = buf_temp-diasize-handle.handle-value
     1611               .
     1612               if v-object-handle <> v-diasize-resize-button
     1613               then do:
     1614                 assign
     1615                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1616                 .
     1617               end.
     1618             end.
     1619             assign
     1620               v-diasize-browse-handle :height = v-browse-height
     1621             .
     1622             for each buf_temp-browse-handle
     1623               where buf_temp-browse-handle.browse-type = 'height':u
     1624             on error undo, next
     1625             :
     1626               assign
     1627                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1628               .
     1629             end.
     1630             assign
     1631               frame Dialog-Frame :height = v-frame-height
     1632             .
     1633             if frame Dialog-Frame :scrollable = true
     1634             then do:
     1635               assign
     1636                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1637               .
     1638             end.
     1639             run diasize_position-resize-button in this-procedure .
     1640           end.
     1641           else do:
     1642             if frame Dialog-Frame :scrollable = true
     1643             then do:
     1644               assign
     1645                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1646               .
     1647             end.
     1648             assign
     1649               frame Dialog-Frame :height = v-frame-height
     1650             .
     1651             assign
     1652               v-diasize-browse-handle :height = v-browse-height
     1653             .
     1654             for each buf_temp-browse-handle
     1655               where buf_temp-browse-handle.browse-type = 'height':u
     1656             on error undo, next
     1657             :
     1658               assign
     1659                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1660               .
     1661             end.
     1662             for each buf_temp-diasize-handle
     1663             on error undo, next
     1664             :
     1665               assign
     1666                 v-object-handle = buf_temp-diasize-handle.handle-value
     1667               .
     1668               if v-object-handle <> v-diasize-resize-button
     1669               then do:
     1670                 assign
     1671                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1672                 .
     1673               end.
     1674             end.
     1675             run diasize_position-resize-button in this-procedure .
     1676           end.
     1677           assign
     1678             v-diasize-change-size = false
     1679           .
     1680           leave move_block .
     1681         end.
     1682       end.
     1683       assign
     1684         v-diasize-need-full-display = true
     1685       .
     1686       if v-diasize-change-size = false
     1687       then do:
     1688         assign
     1689           v-diasize-change-size = true
     1690         .
     1691       end.
     1692       else do:
     1693         return .
     1694       end.
     1695       assign
     1696         v-frame-height = frame Dialog-Frame :height
     1697         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1698         v-browse-height = v-diasize-browse-handle :height
     1699       .
     1700       for each buf_temp-browse-handle
     1701         where buf_temp-browse-handle.browse-type = 'height':u
     1702       :
     1703         assign
     1704           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1705         .
     1706       end.
     1707       for each buf_temp-diasize-handle
     1708       :
     1709         delete buf_temp-diasize-handle .
     1710       end.
     1711       assign
     1712         v-field-group-handle = frame Dialog-Frame :first-child
     1713       .
     1714       do while valid-handle(v-field-group-handle)
     1715       :
     1716         assign
     1717           v-object-handle = v-field-group-handle :first-child
     1718         .
     1719         do while valid-handle(v-object-handle)
     1720         :
     1721           if  v-object-handle <> v-diasize-browse-handle :handle
     1722           and can-query(v-object-handle, "row")
     1723           and can-query(v-object-handle, "height")
     1724           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1725           then do:
     1726             find first buf_temp-browse-handle
     1727               where buf_temp-browse-handle.browse-type   = 'height':u
     1728                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1729               no-error .
     1730             if available buf_temp-browse-handle
     1731             then do:
     1732             end.
     1733             else do:
     1734               create buf_temp-diasize-handle .
     1735               assign
     1736                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1737                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1738               .
     1739             end.
     1740           end.
     1741           assign
     1742             v-object-handle = v-object-handle :next-sibling
     1743           .
     1744         end.
     1745         assign
     1746           v-field-group-handle = v-field-group-handle :next-sibling
     1747         .
     1748       end.
     1749       do with frame Dialog-Frame
     1750       :
     1751         hide v-diasize-resize-button .
     1752         assign
     1753           v-diasize-resize-button :row    = 1
     1754           v-diasize-resize-button :column = 1
     1755         .
     1756       end.
     1757       if p-change-value > 0
     1758       then do:
     1759         if frame Dialog-Frame :scrollable = true
     1760         then do:
     1761           assign
     1762             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1763             no-error .
     1764           if error-status :error
     1765           or error-status :get-message(1) <> ""
     1766           then do:
     1767             undo move_block, retry move_block .
     1768           end.
     1769         end.
     1770         assign
     1771           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1772           no-error .
     1773         if error-status :error
     1774         or error-status :get-message(1) <> ""
     1775         then do:
     1776           undo move_block, retry move_block .
     1777         end.
     1778         assign
     1779           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1780           no-error .
     1781         if error-status :error
     1782         or error-status :get-message(1) <> ""
     1783         then do:
     1784           undo move_block, retry move_block .
     1785         end.
     1786         for each buf_temp-browse-handle
     1787           where buf_temp-browse-handle.browse-type = 'height':u
     1788         on error undo move_block, retry move_block
     1789         :
     1790           assign
     1791             buf_temp-browse-handle.browse-handle :height
     1792               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1793             no-error .
     1794           if error-status :error
     1795           or error-status :get-message(1) <> ""
     1796           then do:
     1797             undo move_block, retry move_block .
     1798           end.
     1799         end.
     1800         for each buf_temp-diasize-handle
     1801         on error undo move_block, retry move_block
     1802         :
     1803           assign
     1804             v-object-handle = buf_temp-diasize-handle.handle-value
     1805           .
     1806           if v-object-handle <> v-diasize-resize-button
     1807           then do:
     1808             assign
     1809               v-object-handle :row = v-object-handle :row + p-change-value
     1810               no-error .
     1811             if error-status :error
     1812             or error-status :get-message(1) <> ""
     1813             then do:
     1814               undo move_block, retry move_block .
     1815             end.
     1816           end.
     1817         end.
     1818       end.
     1819       else do:
     1820         for each buf_temp-diasize-handle
     1821         on error undo move_block, retry move_block
     1822         :
     1823           assign
     1824             v-object-handle = buf_temp-diasize-handle.handle-value
     1825           .
     1826           if v-object-handle <> v-diasize-resize-button
     1827           then do:
     1828             assign
     1829               v-object-handle :row = v-object-handle :row + p-change-value
     1830               no-error .
     1831             if error-status :error
     1832             or error-status :get-message(1) <> ""
     1833             then do:
     1834               undo move_block, retry move_block .
     1835             end.
     1836           end.
     1837         end.
     1838         assign
     1839           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1840           no-error .
     1841         if error-status :error
     1842         or error-status :get-message(1) <> ""
     1843         then do:
     1844           undo move_block, retry move_block .
     1845         end.
     1846         for each buf_temp-browse-handle
     1847           where buf_temp-browse-handle.browse-type = 'height':u
     1848         on error undo move_block, retry move_block
     1849         :
     1850           assign
     1851             buf_temp-browse-handle.browse-handle :height
     1852               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1853             no-error .
     1854           if error-status :error
     1855           or error-status :get-message(1) <> ""
     1856           then do:
     1857             undo move_block, retry move_block .
     1858           end.
     1859         end.
     1860         assign
     1861           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1862           no-error .
     1863         if error-status :error
     1864         or error-status :get-message(1) <> ""
     1865         then do:
     1866           undo move_block, retry move_block .
     1867         end.
     1868         if frame Dialog-Frame :scrollable = true
     1869         then do:
     1870           assign
     1871             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1872             no-error .
     1873           if error-status :error
     1874           or error-status :get-message(1) <> ""
     1875           then do:
     1876             undo move_block, retry move_block .
     1877           end.
     1878         end.
     1879       end.
     1880       if p-move-resize = true
     1881       then do:
     1882         run diasize_position-resize-button in this-procedure .
     1883       end.
     1884       if v-diasize-wndstore = true
     1885       then do:
     1886         if connected("ub") = true
     1887         then do:
     1888           define variable v-cntxt-db-num        as integer   no-undo .
     1889           define variable v-cntxt-userid        as character no-undo .
     1890           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1891                                             , OUTPUT v-cntxt-userid
     1892                                             ) .
     1893           run gbl/wndsizew.p
     1894             (input  v-cntxt-db-num
     1895             ,input  v-cntxt-userid
     1896             ,input  v-diasize-proc-name
     1897             ,input  'height':u
     1898             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1899             ) .
     1900         end.
     1901       end.
     1902     end.
     1903     assign
     1904       v-diasize-change-size = false
     1905     .
     1906   end procedure.
     1907   procedure diasize_set-height :
     1908     define input  parameter p-new-height  as decimal   no-undo .
     1909     define input  parameter p-move-resize as logical   no-undo .
     1910     do
     1911     on error undo, return error return-value
     1912     :
     1913       run diasize_change-height in this-procedure
     1914         (input  (p-new-height - frame Dialog-Frame :height)
     1915         ,input  p-move-resize
     1916         ) .
     1917     end.
     1918   end procedure.
     1919   procedure diasize_change-width :
     1920     define input  parameter p-change-value as decimal   no-undo .
     1921     define input  parameter p-move-resize  as logical   no-undo .
     1922     define variable v-field-group-handle   as handle    no-undo .
     1923     define variable v-object-handle        as handle    no-undo .
     1924     define variable v-frame-width          as decimal   no-undo .
     1925     define variable v-frame-virtual-width  as decimal   no-undo .
     1926     define variable v-browse-width         as decimal   no-undo .
     1927     define variable v-window-width         as decimal   no-undo .
     1928     define variable v-window-virtual-width as decimal   no-undo .
     1929     define variable v-change-sign          as integer   no-undo .
     1930     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1931     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1932     if p-change-value > 0
     1933     then do:
     1934       if frame Dialog-Frame :width + p-change-value >
     1935           session :width-chars
     1936       then do:
     1937         assign
     1938           p-change-value = session :width-chars - frame Dialog-Frame :width
     1939         .
     1940         if p-change-value <= 0
     1941         then do:
     1942           run diasize_position-resize-button in this-procedure .
     1943           return .
     1944         end.
     1945       end.
     1946     end.
     1947     if p-change-value < 0
     1948     then do:
     1949       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1950       then do:
     1951         assign
     1952           p-change-value = v-diasize-orig-frame-width
     1953                          - frame Dialog-Frame :width
     1954         .
     1955         if p-change-value >= 0
     1956         then do:
     1957           run diasize_position-resize-button in this-procedure .
     1958           return .
     1959         end.
     1960       end.
     1961     end.
     1962     if p-change-value >= 0
     1963     then do:
     1964       assign
     1965         v-change-sign = 1
     1966       .
     1967     end.
     1968     else do:
     1969       assign
     1970         v-change-sign = -1
     1971       .
     1972     end.
     1973     assign
     1974       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1975     .
     1976     if p-change-value = 0
     1977     then do:
     1978       run diasize_position-resize-button in this-procedure .
     1979       return .
     1980     end.
     1981     move_block:
     1982     do
     1983     on error undo move_block, leave move_block
     1984     :
     1985       if retry
     1986       then do:
     1987         do
     1988         on error undo move_block, leave move_block
     1989         :
     1990           if p-change-value > 0
     1991           then do:
     1992             for each buf_temp-diasize-handle
     1993             on error undo, next
     1994             :
     1995               assign
     1996                 v-object-handle = buf_temp-diasize-handle.handle-value
     1997               .
     1998               if v-object-handle <> v-diasize-resize-button
     1999               then do:
     2000                 assign
     2001                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2002                 .
     2003               end.
     2004             end.
     2005             assign
     2006               v-diasize-browse-handle :width = v-browse-width
     2007             .
     2008             for each buf_temp-browse-handle
     2009               where buf_temp-browse-handle.browse-type = 'width':u
     2010             on error undo, next
     2011             :
     2012               assign
     2013                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2014               .
     2015             end.
     2016             assign
     2017               frame Dialog-Frame :width = v-frame-width
     2018             .
     2019             if frame Dialog-Frame :scrollable = true
     2020             then do:
     2021               assign
     2022                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2023               .
     2024             end.
     2025             run diasize_position-resize-button in this-procedure .
     2026           end.
     2027           else do:
     2028             if frame Dialog-Frame :scrollable = true
     2029             then do:
     2030               assign
     2031                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2032               .
     2033             end.
     2034             assign
     2035               frame Dialog-Frame :width = v-frame-width
     2036             .
     2037             for each buf_temp-browse-handle
     2038               where buf_temp-browse-handle.browse-type = 'width':u
     2039             on error undo, next
     2040             :
     2041               assign
     2042                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2043               .
     2044             end.
     2045             assign
     2046               v-diasize-browse-handle :width = v-browse-width
     2047             .
     2048             for each buf_temp-diasize-handle
     2049             on error undo, next
     2050             :
     2051               assign
     2052                 v-object-handle = buf_temp-diasize-handle.handle-value
     2053               .
     2054               if v-object-handle <> v-diasize-resize-button
     2055               then do:
     2056                 assign
     2057                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2058                 .
     2059               end.
     2060             end.
     2061             run diasize_position-resize-button in this-procedure .
     2062           end.
     2063           assign
     2064             v-diasize-change-size = false
     2065           .
     2066           leave move_block .
     2067         end.
     2068       end.
     2069       assign
     2070         v-diasize-need-full-display = true
     2071       .
     2072       if v-diasize-change-size = false
     2073       then do:
     2074         assign
     2075           v-diasize-change-size = true
     2076         .
     2077       end.
     2078       else do:
     2079         return .
     2080       end.
     2081       assign
     2082         v-frame-width = frame Dialog-Frame :width
     2083         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2084         v-browse-width = v-diasize-browse-handle :width
     2085       .
     2086       for each buf_temp-browse-handle
     2087         where buf_temp-browse-handle.browse-type = 'width':u
     2088       :
     2089         assign
     2090           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2091         .
     2092       end.
     2093       for each buf_temp-diasize-handle
     2094       :
     2095         delete buf_temp-diasize-handle .
     2096       end.
     2097       assign
     2098         v-field-group-handle = frame Dialog-Frame :first-child
     2099       .
     2100       do while valid-handle(v-field-group-handle)
     2101       :
     2102         assign
     2103           v-object-handle = v-field-group-handle :first-child
     2104         .
     2105         do while valid-handle(v-object-handle)
     2106         :
     2107           if  v-object-handle <> v-diasize-browse-handle :handle
     2108           and v-object-handle <> v-diasize-resize-button
     2109           and can-query(v-object-handle, "row")
     2110           and can-query(v-object-handle, "height")
     2111           and ( v-object-handle :col + v-object-handle :width
     2112                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2113               )
     2114           then do:
     2115             find first buf_temp-browse-handle
     2116               where buf_temp-browse-handle.browse-type   = 'width':u
     2117                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2118               no-error .
     2119             if available buf_temp-browse-handle
     2120             then do:
     2121             end.
     2122             else do:
     2123               create buf_temp-diasize-handle .
     2124               assign
     2125                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2126                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2127               .
     2128             end.
     2129           end.
     2130           assign
     2131             v-object-handle = v-object-handle :next-sibling
     2132           .
     2133         end.
     2134         assign
     2135           v-field-group-handle = v-field-group-handle :next-sibling
     2136         .
     2137       end.
     2138       do with frame Dialog-Frame
     2139       :
     2140         hide v-diasize-resize-button .
     2141         v-diasize-resize-button :row = 1.
     2142         v-diasize-resize-button :column = 1.
     2143       end.
     2144       if p-change-value > 0
     2145       then do:
     2146         if frame Dialog-Frame :scrollable = true
     2147         then do:
     2148           assign
     2149             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2150             no-error .
     2151           if error-status :error
     2152           or error-status :get-message(1) <> ""
     2153           then do:
     2154             undo move_block, retry move_block.
     2155           end.
     2156         end.
     2157         assign
     2158           frame Dialog-Frame :width = v-frame-width + p-change-value
     2159           no-error .
     2160         if error-status :error
     2161         or error-status :get-message(1) <> ""
     2162         then do:
     2163           undo move_block, retry move_block.
     2164         end.
     2165         assign
     2166           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2167         no-error .
     2168         if error-status :error
     2169         or error-status :get-message(1) <> ""
     2170         then do:
     2171           undo move_block, retry move_block.
     2172         end.
     2173         for each buf_temp-browse-handle
     2174           where buf_temp-browse-handle.browse-type = 'width':u
     2175         on error undo move_block, retry move_block
     2176         :
     2177           assign
     2178             buf_temp-browse-handle.browse-handle :width
     2179               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2180             no-error .
     2181           if error-status :error
     2182           or error-status :get-message(1) <> ""
     2183           then do:
     2184             undo move_block, retry move_block .
     2185           end.
     2186         end.
     2187         for each buf_temp-diasize-handle
     2188         on error undo move_block, retry move_block
     2189         :
     2190           assign
     2191             v-object-handle = buf_temp-diasize-handle.handle-value
     2192           .
     2193           if v-object-handle <> v-diasize-resize-button
     2194           then do:
     2195             assign
     2196               v-object-handle :col = v-object-handle :col + p-change-value
     2197               no-error .
     2198             if error-status :error
     2199             or error-status :get-message(1) <> ""
     2200             then do:
     2201               undo move_block, retry move_block .
     2202             end.
     2203           end.
     2204         end.
     2205       end.
     2206       else do:
     2207         for each buf_temp-diasize-handle
     2208         on error undo move_block, retry move_block
     2209         :
     2210           assign
     2211             v-object-handle = buf_temp-diasize-handle.handle-value
     2212           .
     2213           if v-object-handle <> v-diasize-resize-button
     2214           then do:
     2215             assign
     2216               v-object-handle :col = v-object-handle :col + p-change-value
     2217               no-error .
     2218             if error-status :error
     2219             or error-status :get-message(1) <> ""
     2220             then do:
     2221               undo move_block, retry move_block .
     2222             end.
     2223           end.
     2224         end.
     2225         for each buf_temp-browse-handle
     2226           where buf_temp-browse-handle.browse-type = 'width':u
     2227         on error undo move_block, retry move_block
     2228         :
     2229           assign
     2230             buf_temp-browse-handle.browse-handle :width
     2231               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2232             no-error .
     2233           if error-status :error
     2234           or error-status :get-message(1) <> ""
     2235           then do:
     2236             undo move_block, retry move_block .
     2237           end.
     2238         end.
     2239         assign
     2240           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2241           no-error .
     2242         if error-status :error
     2243         or error-status :get-message(1) <> ""
     2244         then do:
     2245           undo move_block, retry move_block.
     2246         end.
     2247         assign
     2248           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2249         no-error .
     2250         if error-status :error
     2251         or error-status :get-message(1) <> ""
     2252         then do:
     2253           undo move_block, retry move_block.
     2254         end.
     2255         if frame Dialog-Frame :scrollable = true
     2256         then do:
     2257           assign
     2258             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2259           no-error .
     2260           if error-status :error
     2261           or error-status :get-message(1) <> ""
     2262           then do:
     2263             undo move_block, retry move_block.
     2264           end.
     2265         end.
     2266       end.
     2267       if p-move-resize
     2268       then do:
     2269         run diasize_position-resize-button in this-procedure .
     2270       end.
     2271       if v-diasize-wndstore = true
     2272       then do:
     2273         if connected("ub") = true
     2274         then do:
     2275           define variable v-cntxt-db-num        as integer   no-undo .
     2276           define variable v-cntxt-userid        as character no-undo .
     2277           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2278                                             , OUTPUT v-cntxt-userid
     2279                                             ) .
     2280           run gbl/wndsizew.p
     2281             (input  v-cntxt-db-num
     2282             ,input  v-cntxt-userid
     2283             ,input  v-diasize-proc-name
     2284             ,input  'width':u
     2285             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2286             ) .
     2287         end.
     2288       end.
     2289     end.
     2290     assign
     2291       v-diasize-change-size = false
     2292     .
     2293   end procedure.
     2294   procedure diasize_set-width :
     2295     define input  parameter p-new-width  as decimal   no-undo .
     2296     define input  parameter p-move-resize as logical   no-undo .
     2297     do
     2298     on error undo, return error return-value
     2299     :
     2300       run diasize_change-width in this-procedure
     2301         (input  (p-new-width - frame Dialog-Frame :width)
     2302         ,input  p-move-resize
     2303         ) .
     2304     end.
     2305   end procedure.
     2306   procedure diasize_position-resize-button :
     2307     do with frame Dialog-Frame
     2308     :
     2309       hide v-diasize-resize-button .
     2310       assign
     2311         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2312                     - 1
     2313                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2314         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2315                     - 1
     2316                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2317       .
     2318       view v-diasize-resize-button .
     2319     end.
     2320   end procedure.
     2321   on alt-right anywhere
     2322   do:
     2323     run diasize_change-width in this-procedure
     2324       (input 1
     2325       ,input true
     2326       ) .
     2327     return no-apply .
     2328   end.
     2329   on alt-left anywhere
     2330   do:
     2331     run diasize_change-width in this-procedure
     2332       (input -1
     2333       ,input true
     2334       ) .
     2335     return no-apply .
     2336   end.
     2337   on alt-down anywhere
     2338   do:
     2339     run diasize_change-height in this-procedure
     2340       (input 1
     2341       ,input true
     2342       ) .
     2343     return no-apply .
     2344   end.
     2345   on alt-up anywhere
     2346   do:
     2347     run diasize_change-height in this-procedure
     2348       (input -1
     2349       ,input true
     2350       ) .
     2351     return no-apply .
     2352   end.
     2353   on alt-enter of frame Dialog-Frame
     2354   do:
     2355     run diasize_maximize in this-procedure
     2356       (input  ?
     2357       ).
     2358     return no-apply .
     2359   end.
     2360   procedure diasize_end-move :
     2361     do
     2362     on error undo, return error return-value
     2363     :
     2364       define variable v-row-delta as decimal   no-undo .
     2365       define variable v-col-delta as decimal   no-undo .
     2366       define variable v-new-row as decimal   no-undo .
     2367       define variable v-new-col as decimal   no-undo .
     2368       assign
     2369         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2370         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2371       .
     2372       assign
     2373         v-row-delta = v-new-row - frame Dialog-Frame :height
     2374         v-col-delta = v-new-col - frame Dialog-Frame :width
     2375       .
     2376       run diasize_change-height in this-procedure
     2377         (input v-row-delta
     2378         ,input true
     2379         ) .
     2380       run diasize_change-width in this-procedure
     2381         (input v-col-delta
     2382         ,input true
     2383         ) .
     2384     end.
     2385   end procedure.
     2386   procedure diasize_maximize :
     2387     define input  parameter p-action as logical   no-undo .
     2388     do
     2389     on error undo, return error return-value
     2390     :
     2391       if p-action = ?
     2392       then do:
     2393         if v-diasize-need-maximize = true
     2394         then do:
     2395           assign
     2396             p-action = true
     2397           .
     2398         end.
     2399         else do:
     2400           assign
     2401             p-action = false
     2402           .
     2403         end.
     2404       end.
     2405       if p-action = true
     2406       then do:
     2407         run diasize_change-height in this-procedure
     2408           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2409               - frame Dialog-Frame :height-chars
     2410           ,input true
     2411           ) .
     2412         run diasize_change-width in this-procedure
     2413           (input session :width-chars
     2414               - frame Dialog-Frame :width-chars
     2415           ,input true
     2416           ) .
     2417         assign
     2418           v-diasize-need-maximize = false
     2419         .
     2420       end.
     2421       else do:
     2422         run diasize_change-width in this-procedure
     2423           (input v-diasize-orig-frame-width
     2424               - frame Dialog-Frame :width-chars
     2425           ,input true
     2426           ) .
     2427         run diasize_change-height in this-procedure
     2428           (input v-diasize-orig-frame-height
     2429               - frame Dialog-Frame :height-chars
     2430           ,input true
     2431           ) .
     2432         assign
     2433           v-diasize-need-maximize = true
     2434         .
     2435       end.
     2436     end.
     2437   end procedure.
     2438   procedure diasize_restore-orig-size :
     2439     do
     2440     on error undo, return error return-value
     2441     :
     2442       assign
     2443         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2444         v-diasize-current-frame-height = frame Dialog-Frame :height
     2445       .
     2446       run diasize_set-height in this-procedure
     2447         (input  v-diasize-orig-frame-height
     2448         ,input  true
     2449         ) .
     2450       run diasize_set-width in this-procedure
     2451         (input  v-diasize-orig-frame-width
     2452         ,input  true
     2453         ) .
     2454     end.
     2455   end procedure.
     2456   procedure diasize_restore-current-size :
     2457     do
     2458     on error undo, return error return-value
     2459     :
     2460       run diasize_set-height in this-procedure
     2461         (input  v-diasize-current-frame-height
     2462         ,input  true
     2463         ) .
     2464       run diasize_set-width in this-procedure
     2465         (input  v-diasize-current-frame-width
     2466         ,input  true
     2467         ) .
     2468     end.
     2469   end procedure.
     2470   procedure diasize_set-browse-handle :
     2471     define input  parameter p-browse-handle as handle   no-undo .
     2472     define buffer buf_temp-browse-handle for temp-browse-handle .
     2473     do
     2474     on error undo, return error return-value
     2475     :
     2476       assign
     2477         v-diasize-browse-handle = p-browse-handle
     2478       .
     2479       for each buf_temp-browse-handle
     2480       on error undo, return error return-value
     2481       :
     2482         delete buf_temp-browse-handle .
     2483       end.
     2484     end.
     2485   end procedure.
     2486   procedure diasize_add_browse :
     2487     define input  parameter p-browse-type   as character no-undo .
     2488     define input  parameter p-browse-handle as handle    no-undo .
     2489     define buffer buf_temp-browse-handle for temp-browse-handle .
     2490     do
     2491     on error undo, return error return-value
     2492     :
     2493       assign
     2494         v-diasize-browse-number = v-diasize-browse-number + 1
     2495       .
     2496       create buf_temp-browse-handle .
     2497       assign
     2498         buf_temp-browse-handle.browse-type   = p-browse-type
     2499         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2500         buf_temp-browse-handle.browse-handle = p-browse-handle
     2501       .
     2502     end.
     2503   end procedure.
     2504   procedure diasize_init :
     2505     define variable v-default-value    as logical   no-undo .
     2506     define variable v-restore-saved    as logical   no-undo .
     2507     define variable v-resize-value-str as character no-undo .
     2508     do
     2509     on error undo, return error return-value
     2510     :
     2511       do with frame Dialog-Frame
     2512       :
     2513         assign
     2514           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2515           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2516           v-diasize-browse-handle     = browse BR-gds :handle
     2517         .
     2518         create button v-diasize-resize-button
     2519         assign
     2520           parent        = frame Dialog-Frame :first-child
     2521           label         = "s"
     2522           height-pixels = 16
     2523           width-pixels  = 16
     2524           visible       = true
     2525           sensitive     = true
     2526           movable       = true
     2527           triggers:
     2528             on end-move persistent run diasize_end-move in this-procedure .
     2529           end triggers.
     2530         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2531         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2532         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2533         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2534         assign
     2535           v-diasize-wndmax = false
     2536         .
     2537         if connected("ub") = true
     2538         then do:
     2539           define variable v-cntxt-db-num        as integer   no-undo .
     2540           define variable v-cntxt-userid        as character no-undo .
     2541           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2542                                             , OUTPUT v-cntxt-userid
     2543                                             ) .
     2544           run gbl/wndpar_r.p
     2545             (input  v-cntxt-db-num
     2546             ,input  v-cntxt-userid
     2547             ,input  'wndmax':U
     2548             ,output v-diasize-wndmax
     2549             ,output v-default-value
     2550             ) .
     2551         end.
     2552         assign
     2553           v-diasize-wndstore = false
     2554         .
     2555         if connected("ub") = true
     2556         then do:
     2557           run gbl/wndpar_r.p
     2558             (input  v-cntxt-db-num
     2559             ,input  v-cntxt-userid
     2560             ,input  'wndstore':U
     2561             ,output v-diasize-wndstore
     2562             ,output v-default-value
     2563             ) .
     2564         end.
     2565         assign
     2566           v-diasize-proc-name = entry(1, program-name(2), '.')
     2567         .
     2568         if v-diasize-wndstore = true
     2569         then do:
     2570           assign
     2571             v-restore-saved = false
     2572           .
     2573           if connected("ub") = true
     2574           then do:
     2575             run gbl/wndsizer.p
     2576               (input  v-cntxt-db-num
     2577               ,input  v-cntxt-userid
     2578               ,input  v-diasize-proc-name
     2579               ,input  'height':u
     2580               ,output v-resize-value-str
     2581               ) .
     2582             if v-resize-value-str <> '':U
     2583             then do:
     2584               run diasize_change-height in this-procedure
     2585                 (input  integer(v-resize-value-str)
     2586                 ,input  true
     2587                 ) .
     2588               assign
     2589                 v-restore-saved = true
     2590               .
     2591             end.
     2592           end.
     2593           if connected("ub") = true
     2594           then do:
     2595             run gbl/wndsizer.p
     2596               (input  v-cntxt-db-num
     2597               ,input  v-cntxt-userid
     2598               ,input  v-diasize-proc-name
     2599               ,input  'width':u
     2600               ,output v-resize-value-str
     2601               ) .
     2602             if v-resize-value-str <> '':U
     2603             then do:
     2604               run diasize_change-width in this-procedure
     2605                 (input  integer(v-resize-value-str)
     2606                 ,input  true
     2607                 ) .
     2608               assign
     2609                 v-restore-saved = true
     2610               .
     2611             end.
     2612           end.
     2613           if v-restore-saved <> true
     2614           then do:
     2615             if v-diasize-wndmax = true
     2616             then do:
     2617               run diasize_maximize in this-procedure
     2618                 (input  true
     2619                 ) .
     2620             end.
     2621           end.
     2622         end.
     2623         else do:
     2624           if v-diasize-wndmax = true
     2625           then do:
     2626             run diasize_maximize in this-procedure
     2627               (input  true
     2628               ) .
     2629           end.
     2630         end.
     2631       end.
     2632     end.
     2633   end procedure.
     2634   procedure diasize_need-full-display :
     2635     define output parameter p-need-full-display as logical   no-undo .
     2636     do
     2637     on error undo, return error return-value
     2638     :
     2639       assign
     2640         p-need-full-display = v-diasize-need-full-display
     2641       .
     2642       assign
     2643         v-diasize-need-full-display = false
     2644       .
     2645     end.
     2646   end procedure.
     2647   procedure get-context :
     2648      define output parameter p-db-num as integer          no-undo.
     2649      define output parameter p-user-id as character        no-undo.
     2650      define variable v-login               as character    no-undo.
     2651      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2652      define buffer buf_user-login  for ub.user-login .
     2653      do
     2654      on error undo, return error
     2655      :
     2656            FIND FIRST buf_sys-ctrl no-lock.
     2657            ASSIGN
     2658               v-login = USERID("ub")
     2659               p-db-num = buf_sys-ctrl.db-num
     2660            .
     2661            FIND FIRST buf_user-login
     2662                 WHERE buf_user-login.db-num = p-db-num
     2663                   AND buf_user-login.user-login = v-login
     2664                 no-lock
     2665                 no-error
     2666                 .
     2667            IF AVAILABLE buf_user-login
     2668            THEN DO:
     2669               assign
     2670                  p-user-id = buf_user-login.user-id
     2671               .
     2672            END.
     2673      end.
     2674   end procedure.
     2675       run diasize_init in this-procedure .
     2676   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2677   on F9 of frame Dialog-Frame anywhere do:
     2678     if not available ub.goods then
     2679       return no-apply.
     2680     gds-rec = recid (ub.goods).
     2681     run ref/gds-form.w ( input parparentproc
     2682                         ,input 'ПРОСМОТР':U
     2683                         ,input ?
     2684                         ,input ?
     2685                         ,input ?
     2686                         ,input-output gds-rec).
     2687     apply "entry" to br-gds in frame Dialog-Frame.
     2688     return no-apply.
     2689   end.
     2690   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2691   on f5 of frame Dialog-Frame anywhere
     2692   do:
     2693     v-doc-rec = recid(X_goods). Run openbr in this-procedure ( input yes, input no, input '':U). reposition br-gds to recid(v-doc-rec). v-doc-rec = ? .
     2694       apply "VALUE-CHANGED" to BR-gds.
     2695   end.
     2696   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2697   do:
     2698     BR-gds :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2699   end.
     2700   def var sort-labelBR-gds   as character no-undo .
     2701   def var sort-clmnBR-gds    as handle    no-undo .
     2702   def var cur-clmnBR-gds     as handle    no-undo .
     2703   def var cur-clmn-locBR-gds as integer   no-undo .
     2704   def var re-queryBR-gds     as logical   initial no no-undo .
     2705   on start-search, ctrl-o of BR-gds in frame Dialog-Frame do:
     2706      run sort-brBR-gds
     2707        (input (if available X_goods
     2708                then recid(X_goods)
     2709                else ?
     2710               )
     2711        ).
     2712   end.
     2713   PROCEDURE sort-brBR-gds :
     2714     define input parameter p-recid as recid no-undo .
     2715     if re-queryBR-gds = no then do:
     2716       assign
     2717          cur-clmnBR-gds = BR-gds:current-column in frame Dialog-Frame
     2718       .
     2719       if sort-clmnBR-gds <> ? then sort-clmnBR-gds:column-fgcolor = 0.
     2720       if cur-clmnBR-gds = sort-clmnBR-gds then do:
     2721         assign
     2722            sort-labelBR-gds = ""
     2723            sort-clmnBR-gds = ?
     2724         .
     2725        end.
     2726        else do:
     2727          assign
     2728            sort-labelBR-gds = cur-clmnBR-gds:label
     2729            sort-clmnBR-gds  = cur-clmnBR-gds
     2730            sort-clmnBR-gds:column-fgcolor = 4
     2731          .
     2732        end.
     2733      end.
     2734     assign
     2735       cur-clmn-locBR-gds = 1
     2736     .
     2737     def var column-handle as handle no-undo .
     2738     column-handle = BR-gds:first-column.
     2739     do while valid-handle(column-handle) :
     2740       if column-handle = cur-clmnBR-gds then do:
     2741         leave .
     2742       end.
     2743       column-handle = column-handle:NEXT-COLUMN.
     2744       assign
     2745         cur-clmn-locBR-gds = cur-clmn-locBR-gds + 1
     2746       .
     2747     end.
     2748     case sort-labelBR-gds:
     2749           when  X_goods.artic :label in browse BR-gds then DO:    assign       sort-column-name = " X_goods.artic "     .     run OpenBr in this-procedure ( input yes, input no, input '':U).    . END.
     2750           when  X_goods.gds-code :label in browse BR-gds then DO:    assign       sort-column-name = " X_goods.gds-code "     .     run OpenBr in this-procedure ( input yes, input no, input '':U).    . END.
     2751           when  X_goods.gds-name :label in browse BR-gds then DO:    assign       sort-column-name = " X_goods.gds-name "     .     run OpenBr in this-procedure ( input yes, input no, input '':U).    . END.
     2752           when  X_goods.grp-name :label in browse BR-gds then DO:    assign       sort-column-name = " X_goods.grp-name "     .     run OpenBr in this-procedure ( input yes, input no, input '':U).    . END.
     2753       otherwise do:
     2754         assign
     2755           sort-column-name = ""
     2756         .
     2757         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2758           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-gds') then do:
     2759             run mv-brw-defaultBR-gds.
     2760           end.
     2761         if sort-labelBR-gds <> "" then do:
     2762           assign
     2763             cur-clmnBR-gds:column-fgcolor = 0
     2764           .
     2765         end.
     2766         assign
     2767           cur-clmn-locBR-gds = ?
     2768         .
     2769       end.
     2770     end case.
     2771       if cur-clmn-locBR-gds <> ? then do:
     2772         if can-do( this-procedure:internal-entries, 'ch-clmnBR-gds') then do:
     2773           run ch-clmnBR-gds in this-procedure (cur-clmn-locBR-gds).
     2774         end.
     2775       end.
     2776     if p-recid <> ? then do:
     2777       reposition BR-gds to recid p-recid no-error.
     2778       apply "value-changed" to BR-gds in frame Dialog-Frame.
     2779     end.
     2780     apply "entry" to BR-gds in frame Dialog-Frame.
     2781   END PROCEDURE.
     2782   procedure re-open-query-srt-clmnBR-gds:
     2783   if cur-clmnBR-gds = ? then do:
     2784      run OpenBr in this-procedure ( input yes, input no, input '':U).
     2785   end.
     2786   else do:
     2787      assign re-queryBR-gds = yes.
     2788      run sort-brBR-gds
     2789        (input (if available X_goods
     2790                then recid(X_goods)
     2791                else ?
     2792               )
     2793        ).
     2794      assign re-queryBR-gds = no.
     2795   end.
     2796   end.
     2797   MAIN-BLOCK:
     2798   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2799      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2800   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
