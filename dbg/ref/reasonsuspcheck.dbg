      560     B-WaitFramStop at row 4 col 30
      561     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      562     .
      563   define new global shared variable mBatchMode as logical no-undo init ?.
      564   define variable mFramBachModHandle as handle no-undo.
      565   mFramBachModHandle = frame waitfram:handle.
      566   define variable mFameOldVis as logical no-undo.
      567   define variable mVisCUrentVin as logical no-undo.
      568   if session:batch-mode
      569   then
      570      mBatchMode = yes.
      571   if mBatchMode = ? then do:
      572     mVisCUrentVin = current-window:visible.
      573     mFameOldVis = mFramBachModHandle:visible.
      574     mFramBachModHandle:visible  = yes.
      575     mBatchMode = mFramBachModHandle:visible ne yes.
      576     mFramBachModHandle:visible = mFameOldVis.
      577     current-window:visible = mVisCUrentVin.
      578   end.
      579    if  log-manager:logfile-name ne ?
      580     then DO:
      581         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      582         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      583         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      584     end.
      585   on choose of B-WaitFramStop in frame waitfram
      586   do:
      587     mWaitFramStop = yes.
      588     mWaitFramStopUser = yes.
      589   end.
      590   function waitfram-check-timeout returns logical():
      591      define variable vtime as int64 no-undo.
      592      if mWaitFramStopTimeOut
      593      then
      594         return yes.
      595      vtime = ( now - mWaitFramStartProc ) / 1000 .
      596      if     mWaitFramTimeOut ne ?
      597         and mWaitFramTimeOut ne 0
      598         and mWaitFramTimeOut lt vtime
      599      then do:
      600         mWaitFramStopTimeOut = yes.
      601      end.
      602      return mWaitFramStopTimeOut.
      603   end.
      604   procedure waitfram-hide :
      605     if not session:batch-mode
      606     then do
      607     on error undo, return error return-value
      608     :
      609       pause 0 before-hide .
      610       if not mBatchMode then
      611         hide frame waitfram .
      612     if     not mWaitFramView
      613        and mWaitProcEvent
      614     then
      615       process events .
      616     end.
      617   end procedure.
      618   procedure waitfram-show :
      619     define input  parameter p-message as character no-undo .
      620     define variable v-left-margin as integer   no-undo .
      621     if not session:batch-mode
      622     then do
      623     on error undo, return error return-value
      624     :
      625       if length(p-message) <= 70 then do:
      626         assign
      627           v-left-margin = integer((70 - length(p-message)) / 2)
      628         .
      629         assign
      630           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      631         .
      632         assign
      633           v-waitfram-action01 = " "
      634           v-waitfram-action02 = " "
      635                                    + fill(" ", v-left-margin)
      636                                    + p-message
      637           v-waitfram-action03 = " "
      638         .
      639       end.
      640       else do:
      641         define variable vRindex1 as integer no-undo.
      642         define variable vRindex2 as integer no-undo.
      643         vRindex1 = r-index(p-message," ",70).
      644         if vRindex1 = 0
      645         then
      646            vRindex1 = 70.
      647         if length(p-message)  <= vRindex1 + 70 then do:
      648           assign
      649             v-waitfram-action01 = " "
      650             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      651             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      652           .
      653         end.
      654         else do:
      655           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      656           if vRindex2 <= vRindex1
      657           then
      658              vRindex2 = vRindex1 + 70.
      659           assign
      660             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      661             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      662             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      663           .
      664         end.
      665       end.
      666       B-viewProcInfo:visible   in frame waitfram = no.
      667       B-viewProcInfo:sensitive in frame waitfram = no.
      668       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      669       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      670       if  (   mWaitFramView
      671          or  mWaitProcEvent)
      672          and not mBatchMode
      673       then
      674          display
      675             v-waitfram-action01 skip
      676             v-waitfram-action02 skip
      677             v-waitfram-action03 skip
      678          with frame waitfram .
      679       if     mWaitFramView
      680          then do:
      681             if     mWaitFramInterval ne ?
      682                and not mBatchMode
      683             then
      684                wait-for go of frame waitfram pause mWaitFramInterval.
      685          end.
      686          else
      687             if     mWaitProcEvent
      688                and not mBatchMode
      689             then
      690                process events .
      691     end.
      692   end procedure.
      693      procedure waitfram-show-this:
      694         define input  parameter iInterval as int64 no-undo.
      695         define variable vtime as int64 no-undo.
      696         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      697         mWaitFramInterval = iInterval.
      698         run waitfram-show (substitute("&1&2 &3&4" ,
      699                                       mWaitFramTextBeg ,
      700                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      701                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      702                                       mWaitFramTextEnd
      703                                      )
      704                           ).
      705      end.
      706      procedure WaitFramRunPause:
      707         define input  parameter iInterval as dec no-undo.
      708         define variable vStart  as datetime-tz no-undo.
      709         define variable vend    as datetime-tz no-undo.
      710         define variable vint as int64 no-undo.
      711         define variable vOk as logical no-undo.
      712         vStart = now.
      713         vend   = vStart.
      714         publish "WaitFramPause" (iInterval,output vOk).
      715         vend   =  now.
      716         vint = vend - vStart.
      717         vint = iInterval - vint / 1000.
      718         if     not mWaitFramStop
      719            and (   vint > 0
      720                 or (    not vOk
      721                     and iInterval eq ?
      722                     )
      723                 )
      724         then
      725            run waitfram-show-this (iInterval).
      726         vend   =  now.
      727         vint = vend - vStart.
      728         vint = iInterval - vint / 1000.
      729         if     not mWaitFramStop
      730            and vint > 0
      731         then do:
      732            run gbl/pause.p (vint * 1000).
      733         end.
      734         if iInterval ne ?
      735         then
      736            publish "WaitFramStop".
      737         waitfram-check-timeout().
      738      end.
      739      procedure WaitFramWaitFor:
      740         define input  parameter iInterval as dec no-undo.
      741         assign
      742            mWaitFramStartProc   = now
      743            mWaitFramStopUser    = no
      744            mWaitFramStopTimeOut = no
      745         .
      746         block-wait:
      747         do while not mWaitFramStop:
      748            run WaitFramRunPause (iInterval).
      749            if  waitfram-check-timeout()
      750            then do:
      751               leave block-wait.
      752            end.
      753         end.
      754         run waitfram-hide.
      755      end.
      756   procedure waitfram-join :
      757     define input  parameter p-line-1  as character no-undo .
      758     define input  parameter p-line-2  as character no-undo .
      759     define input  parameter p-line-3  as character no-undo .
      760     define output parameter p-message as character no-undo .
      761     do
      762     on error undo, return error return-value
      763     :
      764       assign
      765         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      766                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      767                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      768       .
      769     end.
      770   end procedure.
      771   function waitfram-join-function returns character
      772     (input p-line-1 as character
      773     ,input p-line-2 as character
      774     ,input p-line-3 as character
      775     ).
      776     define variable v-message as character no-undo .
      777     run waitfram-join in this-procedure
      778       (input  p-line-1
      779       ,input  p-line-2
      780       ,input  p-line-3
      781       ,output v-message
      782       ) .
      783     return v-message .
      784   end function .
      785   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      786   FUNCTION mark-string RETURNS CHARACTER
      787     ( input p-recid as recid, input mark-list as character  ) :
      788     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      789   END FUNCTION.
      790   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791   define variable log-res     as log       no-undo.
      792   define variable rr          as recid     no-undo.
      793   define variable v_type      as char      no-undo.
      794   define variable v-is-deploy as logical   no-undo .
      795   define variable v-rid-list  as character no-undo .
      796   DEFINE BUTTON b-exit AUTO-GO
      797     LABEL "&Выход ":L
      798     SIZE 10 BY 1.
      799   DEFINE BUTTON b-sel AUTO-GO
      800     LABEL "Вы&бор ":L
      801     SIZE 10 BY 1.
      802   define variable t-del as logical init no
      803     label "Показывать удаленные":L
      804     view-as toggle-box
      805     size 22 by 1.
      806   DEFINE QUERY br-reasons-suspicious-check FOR
      807     X_ext-classif SCROLLING.
      808   function rvd-stat returns character (input p-nonuniq as integer) :
      809     if p-nonuniq = 1
      810     then return "Удал" .
      811     else return "Тек" .
      812   end function .
      813   function rvd-type returns character (input p-type as integer) :
      814     if p-type = 1
      815     then return "ТРК" .
      816     else return "РГС" .
      817   end function .
      818   DEFINE BROWSE br-reasons-suspicious-check
      819     QUERY br-reasons-suspicious-check NO-LOCK DISPLAY
      820     X_ext-classif.code COLUMN-LABEL "Код" FORMAT "X(64)":U width 10
      821     X_ext-classif.CodeName COLUMN-LABEL "Наименование" FORMAT "X(255)":U width 80
      822     rvd-stat(X_ext-classif.status_) COLUMN-LABEL "Статус" FORMAT "X(6)":U width 10
      823       WITH separators SIZE 102 BY 15 .
      824   DEFINE FRAME d-reasons-suspicious-check
      825     b-exit AT ROW 1 COL 1
      826     b-sel AT ROW 1 COL 11
      827     t-del at row 1 col 55
      828     br-reasons-suspicious-check AT ROW 3 COL 3
      829     SPACE(1) SKIP(1)
      830     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      831     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      832     TITLE "Причины подозрительных чеков":L.
      833   ASSIGN
      834     FRAME d-reasons-suspicious-check:SCROLLABLE = FALSE.
      835   ASSIGN
      836       br-reasons-suspicious-check:COLUMN-RESIZABLE IN FRAME d-reasons-suspicious-check = TRUE.
      837   ON GO OF FRAME d-reasons-suspicious-check
      838     DO:
      839       p-code = X_ext-classif.Code no-error.
      840     END.
      841   ON CHOOSE OF b-sel IN FRAME d-reasons-suspicious-check
      842     DO:
      843       if ( available X_ext-classif )
      844       AND v-rid-list = ""
      845       then
      846         v-rid-list = string( recid( X_ext-classif ) ) .
      847     END.
      848   ON VALUE-CHANGED OF t-del IN FRAME d-reasons-suspicious-check
      849   DO:
      850       assign
      851         t-del
      852       .
      853       if t-del
      854       then do :
      855         OPEN QUERY br-reasons-suspicious-check FOR EACH X_ext-classif NO-LOCK where X_ext-classif.parent = 'reasons-suspicious-check':U
      856                                                                 by X_ext-classif.status_ BY X_ext-classif.code desc .
      857       end .
      858       else do :
      859         OPEN QUERY br-reasons-suspicious-check FOR EACH X_ext-classif NO-LOCK where X_ext-classif.parent = 'reasons-suspicious-check':U
      860                                                                 and X_ext-classif.status_ = 0
      861                                                                 by X_ext-classif.status_ BY X_ext-classif.code desc.
      862       end .
      863   END.
      864   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-reasons-suspicious-check:PARENT eq ?
      865     THEN FRAME d-reasons-suspicious-check:PARENT = ACTIVE-WINDOW.
      866   ON WINDOW-CLOSE OF FRAME d-reasons-suspicious-check
      867     APPLY "END-ERROR":U TO SELF.
      868   MAIN-BLOCK:
      869   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      870     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      871   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      872     run mainmenu_getcntxt in parparentproc
      873       (output v-cntxt-db-num
      874       ,output v-cntxt-userid
      875       ,output v-cntxt-level
      876       ,output v-cntxt-host-code-obj
      877       ,output v-cntxt-obj-type
      878       ,output v-cntxt-obj-code
      879       ,output v-cntxt-db-num-obj
      880       ,output v-cntxt-is-admin
      881       ) .
      882     run enable_UI in this-procedure .
      883     WAIT-FOR GO OF FRAME d-reasons-suspicious-check focus br-reasons-suspicious-check.
      884   END.
      885   run disable_UI in this-procedure .
      886   PROCEDURE disable_UI :
      887     HIDE FRAME d-reasons-suspicious-check.
      888   END PROCEDURE.
      889   PROCEDURE enable_UI :
      890     ENABLE
      891       br-reasons-suspicious-check
      892       b-exit
      893       b-sel WHEN can-do( bttns, 'ВЫБОР':U )
      894       WITH FRAME d-reasons-suspicious-check.
      895       enable
      896         t-del
      897       WITH FRAME d-reasons-suspicious-check.
      898     OPEN QUERY br-reasons-suspicious-check FOR EACH X_ext-classif NO-LOCK where X_ext-classif.parent = 'reasons-suspicious-check':U
      899                                                               and X_ext-classif.status_ = 0
      900                                                               by X_ext-classif.status_ by X_ext-classif.code desc.
      901     if available X_ext-classif
      902       then log-res  = br-reasons-suspicious-check:select-focused-row( ).
      903   END PROCEDURE.
