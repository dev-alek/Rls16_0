      997           g-log = browse-2cli:refresh() .
      998         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      999             g-log = browse-2cli:select-next-row ().
     1000             apply "VALUE-CHANGED" to browse-2cli in frame Dialog-Frame.
     1001         end.
