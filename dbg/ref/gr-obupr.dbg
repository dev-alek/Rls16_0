      976   ON CHOOSE OF B-mark-2 IN FRAME Dialog-Frame
      977   DO:
      978       if available buf_tnv-in-turnover-group then do:
      979   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   define variable v-str-recid14 as character no-undo .
      981   define variable v-num-entry14 as integer   no-undo .
      982   assign
      983     v-str-recid14 = trim( string( recid( buf_tnv-in-turnover-group ) , "->>>>>>>>>>>9":U ) )
      984     v-num-entry14 = lookup( v-str-recid14 , v-rec-list-cli )
      985   .
