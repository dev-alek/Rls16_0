      987     assign
      988       entry( v-num-entry14, v-rec-list-cli ) = "":U
      989       v-rec-list-cli = trim( replace( v-rec-list-cli , chr(44) + chr(44) , chr(44) ) , chr(44) )
      990     .
      991   end.
      992   else do:
      993     assign
      994       v-rec-list-cli = v-rec-list-cli + ( if v-rec-list-cli = "":U then "":U else chr(44) ) + v-str-recid14
      995     .
