        1   DEFINE BUFFER buf_tnv-in-turnover-group FOR ub.tnv-in-turnover-group.
        2   DEFINE NEW SHARED BUFFER buf_turnover-group FOR ub.turnover-group.
        3   define input  parameter parParentProc as handle no-undo .
        4   define input  parameter p-bttns    as character no-undo .
        5   define input-output parameter p-rec-list as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Справочник суммовых групп для ценообразования".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118     define variable v-cntxt-db-num        as integer   no-undo .
      119     define variable v-cntxt-userid        as character no-undo .
      120     define variable v-cntxt-level         as character no-undo .
      121     define variable v-cntxt-host-code-obj as integer   no-undo .
      122     define variable v-cntxt-obj-type      as character no-undo .
      123     define variable v-cntxt-obj-code      as integer   no-undo .
      124     define variable v-cntxt-db-num-obj    as integer   no-undo .
      125     define variable v-cntxt-is-admin      as logical   no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127     run mainmenu_getcntxt in parparentproc
      128       (output v-cntxt-db-num
      129       ,output v-cntxt-userid
      130       ,output v-cntxt-level
      131       ,output v-cntxt-host-code-obj
      132       ,output v-cntxt-obj-type
      133       ,output v-cntxt-obj-code
      134       ,output v-cntxt-db-num-obj
      135       ,output v-cntxt-is-admin
      136       ) .
      137   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define variable v-waitfram-action01         as character   no-undo .
      139   define variable v-waitfram-action02         as character   no-undo .
      140   define variable v-waitfram-action03         as character   no-undo .
      141   define variable mWaitFramTextBeg            as character   no-undo.
      142   define variable mWaitFramTextEnd            as character   no-undo.
      143   define variable mWaitFramView               as logical     no-undo.
      144   define variable mWaitProcEvent              as logical     no-undo init yes.
      145   define variable mWaitFramInterval           as integer     no-undo init 1 .
      146   define variable mWaitFramStop               as logical     no-undo.
      147   define variable mWaitFramStopUser           as logical     no-undo.
      148   define variable mWaitFramStopTimeOut        as logical     no-undo.
      149   define variable mWaitFramStartProc          as datetime-tz no-undo.
      150   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      151   define button B-WaitFramStop auto-end-key
      152        label "Стоп"
      153        size 10 by 1 tooltip "Остоновить процесс".
      154   define button B-viewProcInfo
      155        label "Информация"
      156        size 15 by 1 tooltip "Информация о процесс".
      157   define frame waitfram
      158     v-waitfram-action01 format "x(72)" no-label skip
      159     v-waitfram-action02 format "x(72)" no-label skip
      160     v-waitfram-action03 format "x(72)" no-label skip
      161     B-viewProcInfo
      162     B-WaitFramStop at row 4 col 30
      163     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      164     .
      165   define new global shared variable mBatchMode as logical no-undo init ?.
      166   define variable mFramBachModHandle as handle no-undo.
      167   mFramBachModHandle = frame waitfram:handle.
      168   define variable mFameOldVis as logical no-undo.
      169   define variable mVisCUrentVin as logical no-undo.
      170   if session:batch-mode
      171   then
      172      mBatchMode = yes.
      173   if mBatchMode = ? then do:
      174     mVisCUrentVin = current-window:visible.
      175     mFameOldVis = mFramBachModHandle:visible.
      176     mFramBachModHandle:visible  = yes.
      177     mBatchMode = mFramBachModHandle:visible ne yes.
      178     mFramBachModHandle:visible = mFameOldVis.
      179     current-window:visible = mVisCUrentVin.
      180   end.
      181    if  log-manager:logfile-name ne ?
      182     then DO:
      183         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      184         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      185         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      186     end.
      187   on choose of B-WaitFramStop in frame waitfram
      188   do:
      189     mWaitFramStop = yes.
      190     mWaitFramStopUser = yes.
      191   end.
      192   function waitfram-check-timeout returns logical():
      193      define variable vtime as int64 no-undo.
      194      if mWaitFramStopTimeOut
      195      then
      196         return yes.
      197      vtime = ( now - mWaitFramStartProc ) / 1000 .
      198      if     mWaitFramTimeOut ne ?
      199         and mWaitFramTimeOut ne 0
      200         and mWaitFramTimeOut lt vtime
      201      then do:
      202         mWaitFramStopTimeOut = yes.
      203      end.
      204      return mWaitFramStopTimeOut.
      205   end.
      206   procedure waitfram-hide :
      207     if not session:batch-mode
      208     then do
      209     on error undo, return error return-value
      210     :
      211       pause 0 before-hide .
      212       if not mBatchMode then
      213         hide frame waitfram .
      214     if     not mWaitFramView
      215        and mWaitProcEvent
      216     then
      217       process events .
      218     end.
      219   end procedure.
      220   procedure waitfram-show :
      221     define input  parameter p-message as character no-undo .
      222     define variable v-left-margin as integer   no-undo .
      223     if not session:batch-mode
      224     then do
      225     on error undo, return error return-value
      226     :
      227       if length(p-message) <= 70 then do:
      228         assign
      229           v-left-margin = integer((70 - length(p-message)) / 2)
      230         .
      231         assign
      232           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      233         .
      234         assign
      235           v-waitfram-action01 = " "
      236           v-waitfram-action02 = " "
      237                                    + fill(" ", v-left-margin)
      238                                    + p-message
      239           v-waitfram-action03 = " "
      240         .
      241       end.
      242       else do:
      243         define variable vRindex1 as integer no-undo.
      244         define variable vRindex2 as integer no-undo.
      245         vRindex1 = r-index(p-message," ",70).
      246         if vRindex1 = 0
      247         then
      248            vRindex1 = 70.
      249         if length(p-message)  <= vRindex1 + 70 then do:
      250           assign
      251             v-waitfram-action01 = " "
      252             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      253             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      254           .
      255         end.
      256         else do:
      257           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      258           if vRindex2 <= vRindex1
      259           then
      260              vRindex2 = vRindex1 + 70.
      261           assign
      262             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      263             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      264             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      265           .
      266         end.
      267       end.
      268       B-viewProcInfo:visible   in frame waitfram = no.
      269       B-viewProcInfo:sensitive in frame waitfram = no.
      270       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      271       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      272       if  (   mWaitFramView
      273          or  mWaitProcEvent)
      274          and not mBatchMode
      275       then
      276          display
      277             v-waitfram-action01 skip
      278             v-waitfram-action02 skip
      279             v-waitfram-action03 skip
      280          with frame waitfram .
      281       if     mWaitFramView
      282          then do:
      283             if     mWaitFramInterval ne ?
      284                and not mBatchMode
      285             then
      286                wait-for go of frame waitfram pause mWaitFramInterval.
      287          end.
      288          else
      289             if     mWaitProcEvent
      290                and not mBatchMode
      291             then
      292                process events .
      293     end.
      294   end procedure.
      295      procedure waitfram-show-this:
      296         define input  parameter iInterval as int64 no-undo.
      297         define variable vtime as int64 no-undo.
      298         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      299         mWaitFramInterval = iInterval.
      300         run waitfram-show (substitute("&1&2 &3&4" ,
      301                                       mWaitFramTextBeg ,
      302                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      303                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      304                                       mWaitFramTextEnd
      305                                      )
      306                           ).
      307      end.
      308      procedure WaitFramRunPause:
      309         define input  parameter iInterval as dec no-undo.
      310         define variable vStart  as datetime-tz no-undo.
      311         define variable vend    as datetime-tz no-undo.
      312         define variable vint as int64 no-undo.
      313         define variable vOk as logical no-undo.
      314         vStart = now.
      315         vend   = vStart.
      316         publish "WaitFramPause" (iInterval,output vOk).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and (   vint > 0
      322                 or (    not vOk
      323                     and iInterval eq ?
      324                     )
      325                 )
      326         then
      327            run waitfram-show-this (iInterval).
      328         vend   =  now.
      329         vint = vend - vStart.
      330         vint = iInterval - vint / 1000.
      331         if     not mWaitFramStop
      332            and vint > 0
      333         then do:
      334            run gbl/pause.p (vint * 1000).
      335         end.
      336         if iInterval ne ?
      337         then
      338            publish "WaitFramStop".
      339         waitfram-check-timeout().
      340      end.
      341      procedure WaitFramWaitFor:
      342         define input  parameter iInterval as dec no-undo.
      343         assign
      344            mWaitFramStartProc   = now
      345            mWaitFramStopUser    = no
      346            mWaitFramStopTimeOut = no
      347         .
      348         block-wait:
      349         do while not mWaitFramStop:
      350            run WaitFramRunPause (iInterval).
      351            if  waitfram-check-timeout()
      352            then do:
      353               leave block-wait.
      354            end.
      355         end.
      356         run waitfram-hide.
      357      end.
      358   procedure waitfram-join :
      359     define input  parameter p-line-1  as character no-undo .
      360     define input  parameter p-line-2  as character no-undo .
      361     define input  parameter p-line-3  as character no-undo .
      362     define output parameter p-message as character no-undo .
      363     do
      364     on error undo, return error return-value
      365     :
      366       assign
      367         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      368                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      369                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      370       .
      371     end.
      372   end procedure.
      373   function waitfram-join-function returns character
      374     (input p-line-1 as character
      375     ,input p-line-2 as character
      376     ,input p-line-3 as character
      377     ).
      378     define variable v-message as character no-undo .
      379     run waitfram-join in this-procedure
      380       (input  p-line-1
      381       ,input  p-line-2
      382       ,input  p-line-3
      383       ,output v-message
      384       ) .
      385     return v-message .
      386   end function .
      387   PROCEDURE oio-ADD :
      388   define input  parameter p-db-num       as integer   no-undo .
      389   define input  parameter p-id           as integer   no-undo .
      390   define input  parameter p-ttg-summa    as decimal   no-undo .
      391   define input  parameter p-use-discnt           as logical   no-undo .
      392   define input  parameter p-discnt-pc            as decimal   no-undo .
      393   define input  parameter p-discnt-method-round  as character no-undo .
      394   define input  parameter p-stts         as integer   no-undo .
      395   define input  parameter p-db-num-usr   as integer   no-undo .
      396   define input  parameter p-userid       as character no-undo .
      397   define output parameter p-recid as recid no-undo .
      398     do
      399     on error undo, return error return-value
      400     :
      401   find first ub.tnv-in-turnover-group exclusive-lock where
      402           ub.tnv-in-turnover-group.tog-db-num   = p-db-num  and
      403           ub.tnv-in-turnover-group.tog-id       = p-id      and
      404           ub.tnv-in-turnover-group.ttg-summa    = p-ttg-summa
      405           no-error .
      406         if not available ub.tnv-in-turnover-group then do:
      407             create ub.tnv-in-turnover-group.
      408               assign
      409                   ub.tnv-in-turnover-group.tog-db-num          = p-db-num
      410                   ub.tnv-in-turnover-group.tog-id              = p-id
      411                   ub.tnv-in-turnover-group.ttg-summa           = p-ttg-summa
      412                   ub.tnv-in-turnover-group.use-discnt          = p-use-discnt
      413                   ub.tnv-in-turnover-group.discnt-pc           = p-discnt-pc
      414                   ub.tnv-in-turnover-group.discnt-method-round = p-discnt-method-round
      415               .
      416         end.
      417         assign
      418           ub.tnv-in-turnover-group.db-num-chg    = p-db-num-usr
      419           ub.tnv-in-turnover-group.stts          = p-stts
      420           ub.tnv-in-turnover-group.sys-date      = today
      421           ub.tnv-in-turnover-group.sys-time      = time
      422           ub.tnv-in-turnover-group.sys-time-chr  = string ( ub.tnv-in-turnover-group.sys-time,"hh:mm" )
      423           ub.tnv-in-turnover-group.who           = p-userid
      424           p-recid = recid ( ub.tnv-in-turnover-group )
      425         .
      426     end.
      427   end procedure.
      428   PROCEDURE oio-DEL :
      429   define input  parameter p-db-num       as integer   no-undo .
      430   define input  parameter p-id           as integer   no-undo .
      431   define input  parameter p-ttg-summa     as decimal   no-undo .
      432   define input  parameter p-db-num-usr   as integer   no-undo .
      433   define input  parameter p-userid       as character no-undo .
      434     do
      435     on error undo, return error return-value
      436     :
      437   find first ub.tnv-in-turnover-group exclusive-lock where
      438           ub.tnv-in-turnover-group.tog-db-num   = p-db-num  and
      439           ub.tnv-in-turnover-group.tog-id       = p-id      and
      440           ub.tnv-in-turnover-group.ttg-summa = p-ttg-summa
      441           no-error .
      442    if not available ub.tnv-in-turnover-group then  return error .
      443         assign
      444           ub.tnv-in-turnover-group.db-num-chg    = p-db-num-usr
      445           ub.tnv-in-turnover-group.stts          = 1
      446           ub.tnv-in-turnover-group.sys-date      = today
      447           ub.tnv-in-turnover-group.sys-time      = time
      448           ub.tnv-in-turnover-group.sys-time-chr  = string(ub.tnv-in-turnover-group.sys-time,"hh:mm")
      449           ub.tnv-in-turnover-group.who           = p-userid
      450         .
      451     end.
      452   end procedure.
      453   PROCEDURE oio-update :
      454   define input  parameter p-recid       as recid no-undo .
      455   define input  parameter p-db-num       as integer   no-undo .
      456   define input  parameter p-id           as integer   no-undo .
      457   define input  parameter p-ttg-summa    as decimal   no-undo .
      458   define input  parameter p-use-discnt           as logical   no-undo .
      459   define input  parameter p-discnt-pc            as decimal   no-undo .
      460   define input  parameter p-discnt-method-round  as character no-undo .
      461   define input  parameter p-stts         as integer   no-undo .
      462   define input  parameter p-db-num-usr   as integer   no-undo .
      463   define input  parameter p-userid       as character no-undo .
      464     do
      465     on error undo, return error return-value
      466     :
      467   find first ub.tnv-in-turnover-group exclusive-lock where
      468           recid(ub.tnv-in-turnover-group) = p-recid
      469           no-error .
      470         if not available ub.tnv-in-turnover-group then do:
      471             create ub.tnv-in-turnover-group.
      472               assign
      473                   ub.tnv-in-turnover-group.tog-db-num          = p-db-num
      474                   ub.tnv-in-turnover-group.tog-id              = p-id
      475                   ub.tnv-in-turnover-group.ttg-summa           = p-ttg-summa
      476                   ub.tnv-in-turnover-group.use-discnt          = p-use-discnt
      477                   ub.tnv-in-turnover-group.discnt-pc           = p-discnt-pc
      478                   ub.tnv-in-turnover-group.discnt-method-round = p-discnt-method-round
      479               .
      480         end.
      481         assign
      482           ub.tnv-in-turnover-group.tog-db-num          = p-db-num
      483           ub.tnv-in-turnover-group.tog-id              = p-id
      484           ub.tnv-in-turnover-group.ttg-summa           = p-ttg-summa
      485           ub.tnv-in-turnover-group.use-discnt          = p-use-discnt
      486           ub.tnv-in-turnover-group.discnt-pc           = p-discnt-pc
      487           ub.tnv-in-turnover-group.discnt-method-round = p-discnt-method-round
      488           ub.tnv-in-turnover-group.db-num-chg    = p-db-num-usr
      489           ub.tnv-in-turnover-group.stts          = p-stts
      490           ub.tnv-in-turnover-group.sys-date      = today
      491           ub.tnv-in-turnover-group.sys-time      = time
      492           ub.tnv-in-turnover-group.sys-time-chr  = string ( ub.tnv-in-turnover-group.sys-time,"hh:mm" )
      493           ub.tnv-in-turnover-group.who           = p-userid
      494         .
      495     end.
      496   end procedure.
      497   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      498   function usrfulnf returns character ( input p-user-id as character):
      499   define variable v-user-name as character no-undo .
      500   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      501   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      502     (input  p-user-id
      503     ,output v-user-name
      504     ) no-error .
      505   if error-status:error
      506   or v-user-name = ""
      507   then do:
      508     return p-user-id.
      509   end.
      510   else do:
      511     return v-user-name.
      512   end.
      513   end function.
      514   define variable v-sec as integer   no-undo .
      515   define variable r-find  as logical   no-undo init false .
      516   define variable find-id as integer   no-undo .
      517   define variable find-db as integer   no-undo .
      518   define variable v-rec-list-cli as character no-undo .
      519   define variable g-log as logical   no-undo .
      520   function mark-string returns character
      521     ( buffer loc-table for ub.turnover-group, input mark-list as character  ) :
      522     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
      523   end function.
      524   function mark-string-2 returns character
      525     ( buffer loc-table for ub.tnv-in-turnover-group , input mark-list as character  ) :
      526     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
      527   end function.
      528   function stts-string-2 returns character
      529     ( buffer loc-table for ub.tnv-in-turnover-group   ) :
      530   return entry (lookup (string(loc-table.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      531   end function.
      532   function stts-string returns character
      533     ( buffer loc-table for ub.turnover-group   ) :
      534   return entry (lookup (string(loc-table.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      535   end function.
      536   DEFINE QUERY external_tables FOR buf_turnover-group.
      537   DEFINE BUTTON B-add
      538        LABEL "Добавить"
      539        SIZE 10 BY 1 TOOLTIP "Добавить группу"
      540        BGCOLOR 8 .
      541   DEFINE BUTTON B-add-2
      542        LABEL "Добавить"
      543        SIZE 10 BY 1 TOOLTIP "Добавить оборот"
      544        BGCOLOR 8 .
      545   DEFINE BUTTON B-Cancel AUTO-END-KEY
      546        LABEL "Выход"
      547        SIZE 10 BY 1
      548        BGCOLOR 8 .
      549   DEFINE BUTTON B-chg
      550        LABEL "Изменить"
      551        SIZE 10 BY 1 TOOLTIP "Изменить название группы"
      552        BGCOLOR 8 .
      553   DEFINE BUTTON B-chg-2
      554        LABEL "Изменить"
      555        SIZE 10 BY 1 TOOLTIP "Изменить оборот и скидку"
      556        BGCOLOR 8 .
      557   DEFINE BUTTON b-clients
      558        IMAGE-UP FILE "cmp/btn-fnd.bmp":U
      559        IMAGE-DOWN FILE "cmp/btn-fnd.bmp":U
      560        IMAGE-INSENSITIVE FILE "cmp/btn-fnd.bmp":U NO-CONVERT-3D-COLORS
      561        LABEL ""
      562        SIZE 3 BY .83 TOOLTIP "Кто из покупателей входит в группу".
      563   DEFINE BUTTON B-del
      564        LABEL "Удалить"
      565        SIZE 10 BY 1 TOOLTIP "Удалить группу"
      566        BGCOLOR 8 .
      567   DEFINE BUTTON B-del-2
      568        LABEL "Удалить"
      569        SIZE 10 BY 1 TOOLTIP "Удалить оборот"
      570        BGCOLOR 8 .
      571   DEFINE BUTTON B-Help
      572        LABEL "Помо&щь"
      573        SIZE 10 BY 1
      574        BGCOLOR 8 .
      575   DEFINE BUTTON B-history
      576        LABEL "История"
      577        SIZE 10 BY 1 TOOLTIP "История изменения справочника"
      578        BGCOLOR 8 .
      579   DEFINE BUTTON B-mark
      580        LABEL "*"
      581        SIZE 3.25 BY 1 TOOLTIP "Отметить группу"
      582        BGCOLOR 8 .
      583   DEFINE BUTTON B-mark-2
      584        LABEL "*"
      585        SIZE 3.25 BY 1 TOOLTIP "Отметить оборот"
      586        BGCOLOR 8 .
      587   DEFINE BUTTON B-price-type
      588        LABEL "&ТПЛ"
      589        SIZE 6 BY 1 TOOLTIP "Список типов ПЛ по группе оборотов".
      590   DEFINE BUTTON B-print
      591        LABEL "Печать"
      592        SIZE 10 BY 1 TOOLTIP "Печать справочника"
      593        BGCOLOR 8 .
      594   DEFINE BUTTON B-sel AUTO-GO
      595        LABEL "Выбор"
      596        SIZE 10 BY 1
      597        BGCOLOR 8 .
      598   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
      599         VIEW-AS TEXT
      600        SIZE 7.5 BY .67
      601        FGCOLOR 4  NO-UNDO.
      602   DEFINE VARIABLE R-status AS INTEGER
      603        VIEW-AS RADIO-SET HORIZONTAL
      604        RADIO-BUTTONS
      605             "Текущие", 0,
      606   "Все", 2,
      607   "Удаленные", 1
      608        SIZE 30.5 BY .67 TOOLTIP "Условие отбора записей" NO-UNDO.
      609   DEFINE QUERY BROWSE-1grp FOR
      610         buf_turnover-group SCROLLING.
      611   DEFINE QUERY BROWSE-2cli FOR
      612         buf_tnv-in-turnover-group SCROLLING.
      613   DEFINE BROWSE BROWSE-1grp
      614     QUERY BROWSE-1grp NO-LOCK DISPLAY
      615         mark-string(buffer buf_turnover-group, p-rec-list) COLUMN-LABEL "*! " FORMAT "x(1)":U
      616         stts-string(buffer buf_turnover-group) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
      617         buf_turnover-group.tog-id COLUMN-LABEL "Код! " FORMAT ">>9":U
      618         buf_turnover-group.name COLUMN-LABEL "Название!группы" FORMAT "X(80)":U
      619         usrfulnf(buf_turnover-group.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(15)":U
      620         buf_turnover-group.sys-date COLUMN-LABEL "Дата!изм" FORMAT "99/99/99":U
      621         buf_turnover-group.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
      622         buf_turnover-group.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
      623         buf_turnover-group.tog-db-num COLUMN-LABEL "БДсоз!дания" FORMAT ">>>>9":U
      624       WITH NO-ROW-MARKERS SEPARATORS SIZE 48.13 BY 19
      625            TITLE "Группы оборотов покупателей" FIT-LAST-COLUMN.
      626   DEFINE BROWSE BROWSE-2cli
      627     QUERY BROWSE-2cli NO-LOCK DISPLAY
      628         mark-string-2 ( buffer buf_tnv-in-turnover-group, v-rec-list-cli ) COLUMN-LABEL "*! " FORMAT "x(1)":U
      629         stts-string-2 ( buffer buf_tnv-in-turnover-group ) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
      630         buf_tnv-in-turnover-group.ttg-summa COLUMN-LABEL "Оборот! " FORMAT "->,>>>,>>>,>>>,>>9.99":U
      631        (IF buf_tnv-in-turnover-group.discnt-pc = 0 THEN "" ELSE string(buf_tnv-in-turnover-group.discnt-pc)) COLUMN-LABEL "Скид-!ка %" FORMAT "x(6)":U
      632         usrfulnf(buf_tnv-in-turnover-group.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(15)":U
      633         buf_tnv-in-turnover-group.sys-date COLUMN-LABEL "Дата!изм" FORMAT "99/99/99":U
      634         buf_tnv-in-turnover-group.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
      635         buf_tnv-in-turnover-group.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
      636         buf_tnv-in-turnover-group.tog-id COLUMN-LABEL "Гру!ппа" FORMAT ">>9":U
      637         buf_tnv-in-turnover-group.tog-db-num FORMAT ">>>>9":U
      638       WITH NO-ROW-MARKERS SEPARATORS SIZE 50.5 BY 19
      639            TITLE "Обороты в группе" FIT-LAST-COLUMN.
      640   DEFINE FRAME Dialog-Frame
      641        B-Cancel AT ROW 1 COL 1
      642        B-sel AT ROW 1 COL 11
      643        B-add AT ROW 1 COL 21
      644        B-chg AT ROW 1 COL 31 WIDGET-ID 2
      645        B-del AT ROW 1 COL 41
      646        B-price-type AT ROW 1 COL 51
      647        B-history AT ROW 1 COL 79.88
      648        B-Help AT ROW 1 COL 90
      649        B-print AT ROW 2 COL 90
      650        R-status AT ROW 2.29 COL 9.63 NO-LABEL
      651        B-mark-2 AT ROW 2.92 COL 49.75
      652        B-add-2 AT ROW 2.92 COL 53
      653        B-chg-2 AT ROW 2.92 COL 63.13
      654        B-del-2 AT ROW 2.92 COL 73.13
      655        B-mark AT ROW 3 COL 1.75
      656        b-clients AT ROW 3 COL 83.5 WIDGET-ID 4
      657        BROWSE-1grp AT ROW 4 COL 1.38
      658        BROWSE-2cli AT ROW 4 COL 49.5
      659        FILL-IN-1 AT ROW 2.25 COL 2 NO-LABEL
      660        SPACE(90.88) SKIP(20.21)
      661       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      662            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      663            TITLE "Группы оборотов покупателей для ценообразования"
      664            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
      665   ASSIGN
      666          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      667          FRAME Dialog-Frame:HIDDEN           = TRUE.
      668   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      669   DO:
      670     APPLY "END-ERROR":U TO SELF.
      671   END.
      672   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      673   DO:
      674      define variable g#log as logical   no-undo .
      675   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   do:
      677     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      678       (input  v-cntxt-db-num
      679       ,input  v-cntxt-userid
      680       ,input  0
      681       ,input  'actn_ref-mpl_update':U
      682       ,input  'global':U
      683       ,input  v-cntxt-host-code-obj
      684       ,input  v-cntxt-obj-type
      685       ,input  v-cntxt-obj-code
      686       ,input  0
      687       ,input  0
      688       ,input  0
      689       ,input  true
      690       ,output g#log
      691       )  .
      692   end.
      693     if not g#log then return .
      694   define variable v-rec-id as recid no-undo .
      695     run ref/gr-oupra.w (input parparentproc,input 'ДОБАВЛЕНИЕ':U , input-output v-rec-id) .
      696     OPEN QUERY BROWSE-1grp FOR EACH buf_turnover-group WHERE ( r-status = 2 OR buf_turnover-group.stts =  r-status ) and ( r-find = no or (buf_turnover-group.tog-db-num = find-db and                   buf_turnover-group.tog-id = find-id )) .
      697     reposition BROWSE-1grp to recid v-rec-id no-error .
      698     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      699   END.
      700   ON CHOOSE OF B-add-2 IN FRAME Dialog-Frame
      701   DO:
      702      define variable g#log as logical   no-undo .
      703   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      704   do:
      705     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      706       (input  v-cntxt-db-num
      707       ,input  v-cntxt-userid
      708       ,input  0
      709       ,input  'actn_ref-mpl_update':U
      710       ,input  'global':U
      711       ,input  v-cntxt-host-code-obj
      712       ,input  v-cntxt-obj-type
      713       ,input  v-cntxt-obj-code
      714       ,input  0
      715       ,input  0
      716       ,input  0
      717       ,input  true
      718       ,output g#log
      719       )  .
      720   end.
      721     if not g#log then return .
      722   define variable v-rec-id as recid no-undo .
      723   if not available buf_turnover-group then return .
      724   if buf_turnover-group.stts <> 0 then do:
      725      message "В эту группу добавлять оборот нельзя!" view-as alert-box error .
      726      return .
      727   end.
      728   if v-cntxt-db-num <> 0 then do :
      729      if buf_turnover-group.tog-db-num <> v-cntxt-db-num then do:
      730         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_turnover-group.tog-db-num ) .
      731         return .
      732      end.
      733   end.
      734     run ref/gr-ouprb.w (
      735         input parparentproc ,
      736         input 'ДОБАВЛЕНИЕ':U ,
      737         input buf_turnover-group.tog-db-num ,
      738         input buf_turnover-group.tog-id     ,
      739         input buf_turnover-group.name ,
      740         input-output v-rec-id ) .
      741     OPEN QUERY BROWSE-2cli FOR EACH buf_tnv-in-turnover-group OF buf_turnover-group      WHERE ( r-status = 2 OR buf_tnv-in-turnover-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
      742     reposition BROWSE-2cli to recid v-rec-id no-error .
      743     if available buf_tnv-in-turnover-group then
      744     run ref/h-grtnv.p (buffer buf_tnv-in-turnover-group , input-output v-sec )  .
      745   END.
      746   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      747   DO:
      748      define variable g#log as logical   no-undo .
      749   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      750   do:
      751     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      752       (input  v-cntxt-db-num
      753       ,input  v-cntxt-userid
      754       ,input  0
      755       ,input  'actn_ref-mpl_update':U
      756       ,input  'global':U
      757       ,input  v-cntxt-host-code-obj
      758       ,input  v-cntxt-obj-type
      759       ,input  v-cntxt-obj-code
      760       ,input  0
      761       ,input  0
      762       ,input  0
      763       ,input  true
      764       ,output g#log
      765       )  .
      766   end.
      767     if not g#log then return .
      768   define variable v-rec-id as recid no-undo .
      769   IF NOT AVAILABLE buf_turnover-group THEN DO:
      770      RETURN.
      771   END.
      772     if buf_turnover-group.stts <> 0 then do:
      773        message "Группа удалена"  .
      774        return .
      775     end.
      776   if v-cntxt-db-num <> 0 then do :
      777      if buf_turnover-group.tog-db-num <> v-cntxt-db-num then do:
      778         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_turnover-group.tog-db-num ) .
      779         return .
      780      end.
      781   end.
      782     v-rec-id = RECID (buf_turnover-group) .
      783     run ref/gr-oupra.w (input parparentproc,input 'ИЗМЕНЕНИЕ':U , input-output v-rec-id) .
      784     OPEN QUERY BROWSE-1grp FOR EACH buf_turnover-group WHERE ( r-status = 2 OR buf_turnover-group.stts =  r-status ) and ( r-find = no or (buf_turnover-group.tog-db-num = find-db and                   buf_turnover-group.tog-id = find-id )) .
      785     reposition BROWSE-1grp to recid v-rec-id no-error .
      786     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      787   END.
      788   ON CHOOSE OF B-chg-2 IN FRAME Dialog-Frame
      789   DO:
      790      define variable g#log as logical   no-undo .
      791   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      792   do:
      793     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      794       (input  v-cntxt-db-num
      795       ,input  v-cntxt-userid
      796       ,input  0
      797       ,input  'actn_ref-mpl_update':U
      798       ,input  'global':U
      799       ,input  v-cntxt-host-code-obj
      800       ,input  v-cntxt-obj-type
      801       ,input  v-cntxt-obj-code
      802       ,input  0
      803       ,input  0
      804       ,input  0
      805       ,input  true
      806       ,output g#log
      807       )  .
      808   end.
      809     if not g#log then return .
      810   define variable v-rec-id as recid no-undo .
      811   if not available buf_turnover-group then return .
      812   if v-cntxt-db-num <> 0 then do :
      813      if buf_turnover-group.tog-db-num <> v-cntxt-db-num then do:
      814         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_turnover-group.tog-db-num ) .
      815         return .
      816      end.
      817   end.
      818   if not available buf_tnv-in-turnover-group then return .
      819   v-rec-id = RECID(buf_tnv-in-turnover-group) .
      820   if buf_turnover-group.stts <> 0 then do:
      821      message "В этой группе изменять оборот нельзя!" view-as alert-box error .
      822      return .
      823   end.
      824   if buf_tnv-in-turnover-group.stts <> 0 then do:
      825      message "Оборот удален, изменять оборот нельзя!" view-as alert-box error .
      826      return .
      827   end.
      828     run ref/gr-ouprb.w (
      829         input parparentproc ,
      830         input 'ИЗМЕНЕНИЕ':U ,
      831         input buf_turnover-group.tog-db-num ,
      832         input buf_turnover-group.tog-id     ,
      833         input buf_turnover-group.name ,
      834         input-output v-rec-id ) .
      835     OPEN QUERY BROWSE-2cli FOR EACH buf_tnv-in-turnover-group OF buf_turnover-group      WHERE ( r-status = 2 OR buf_tnv-in-turnover-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
      836     reposition BROWSE-2cli to recid v-rec-id no-error .
      837     if available buf_tnv-in-turnover-group then
      838     run ref/h-grtnv.p (buffer buf_tnv-in-turnover-group , input-output v-sec )  .
      839   END.
      840   ON CHOOSE OF b-clients IN FRAME Dialog-Frame
      841   DO:
      842   define buffer next_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
      843   define variable v1 as decimal   no-undo .
      844   define variable v2 as decimal   no-undo .
      845   if not available buf_tnv-in-turnover-group then return .
      846   v1 = buf_tnv-in-turnover-group.ttg-summa .
      847   v2 = 999999999999999 .
      848   find first next_tnv-in-turnover-group no-lock where
      849              next_tnv-in-turnover-group.tog-id     = buf_tnv-in-turnover-group.tog-id and
      850              next_tnv-in-turnover-group.tog-db-num = buf_tnv-in-turnover-group.tog-db-num and
      851              next_tnv-in-turnover-group.ttg-summa  > buf_tnv-in-turnover-group.ttg-summa  no-error .
      852          if available next_tnv-in-turnover-group then  v2 = next_tnv-in-turnover-group.ttg-summa - 1 .
      853      message "c" v1 "по" v2 view-as alert-box information .
      854   END.
      855   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      856   DO:
      857      define variable g#log as logical   no-undo .
      858   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      859   do:
      860     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      861       (input  v-cntxt-db-num
      862       ,input  v-cntxt-userid
      863       ,input  0
      864       ,input  'actn_ref-mpl_update':U
      865       ,input  'global':U
      866       ,input  v-cntxt-host-code-obj
      867       ,input  v-cntxt-obj-type
      868       ,input  v-cntxt-obj-code
      869       ,input  0
      870       ,input  0
      871       ,input  0
      872       ,input  true
      873       ,output g#log
      874       )  .
      875   end.
      876     if not g#log then return .
      877     if not available buf_turnover-group then return .
      878     if buf_turnover-group.stts <> 0 then do:
      879        message "Группа уже удалена"  .
      880        return .
      881     end.
      882     message "Удалять группу " buf_turnover-group.name "?"
      883             view-as alert-box question
      884             buttons yes-no update g-ok as log.
      885     if not g-ok then return .
      886     run ref/gr-oudel.p (
      887         input parparentproc ,
      888         input buf_turnover-group.tog-db-num ,
      889         input buf_turnover-group.tog-id      )
      890         no-error .
      891    if error-status :error then return no-apply .
      892    OPEN QUERY BROWSE-1grp FOR EACH buf_turnover-group WHERE ( r-status = 2 OR buf_turnover-group.stts =  r-status ) and ( r-find = no or (buf_turnover-group.tog-db-num = find-db and                   buf_turnover-group.tog-id = find-id )) .
      893    OPEN QUERY BROWSE-2cli FOR EACH buf_tnv-in-turnover-group OF buf_turnover-group      WHERE ( r-status = 2 OR buf_tnv-in-turnover-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
      894   END.
      895   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
      896   DO:
      897      define variable g#log as logical   no-undo .
      898   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      899   do:
      900     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      901       (input  v-cntxt-db-num
      902       ,input  v-cntxt-userid
      903       ,input  0
      904       ,input  'actn_ref-mpl_update':U
      905       ,input  'global':U
      906       ,input  v-cntxt-host-code-obj
      907       ,input  v-cntxt-obj-type
      908       ,input  v-cntxt-obj-code
      909       ,input  0
      910       ,input  0
      911       ,input  0
      912       ,input  true
      913       ,output g#log
      914       )  .
      915   end.
      916     if not g#log then return .
      917   if not available buf_turnover-group then return .
      918   if v-cntxt-db-num <> 0 then do :
      919      if buf_turnover-group.tog-db-num <> v-cntxt-db-num then do:
      920         message substitute(" Группа создана в другой БД (&1) , удалять ее в текущей БД нельзя !" , buf_turnover-group.tog-db-num ) .
      921         return .
      922      end.
      923   end.
      924     if not available buf_tnv-in-turnover-group then return .
      925     if buf_tnv-in-turnover-group.stts = 1 then return .
      926     message "Удалять оборот " buf_tnv-in-turnover-group.ttg-summa " из группы " "?"
      927             view-as alert-box question
      928             buttons yes-no update v-ok2 as logical.
      929     if not v-ok2 then return .
      930           run oio-del (
      931              input   buf_tnv-in-turnover-group.tog-db-num
      932             ,input   buf_tnv-in-turnover-group.tog-id
      933             ,input   buf_tnv-in-turnover-group.ttg-summa
      934             ,input   v-cntxt-db-num
      935             ,input   v-cntxt-userid ) .
      936           run ref/h-grtnv.p (buffer buf_tnv-in-turnover-group , input-output v-sec )  .
      937      OPEN QUERY BROWSE-2cli FOR EACH buf_tnv-in-turnover-group OF buf_turnover-group      WHERE ( r-status = 2 OR buf_tnv-in-turnover-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
      938   END.
