      947   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      948   DO:
      949       if available buf_turnover-group then do:
      950   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   define variable v-str-recid12 as character no-undo .
      952   define variable v-num-entry12 as integer   no-undo .
      953   assign
      954     v-str-recid12 = trim( string( recid( buf_turnover-group ) , "->>>>>>>>>>>9":U ) )
      955     v-num-entry12 = lookup( v-str-recid12 , p-rec-list )
      956   .
      957   if v-num-entry12 > 0 then do:
      958     assign
      959       entry( v-num-entry12, p-rec-list ) = "":U
      960       p-rec-list = trim( replace( p-rec-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      961     .
      962   end.
      963   else do:
      964     assign
      965       p-rec-list = p-rec-list + ( if p-rec-list = "":U then "":U else chr(44) ) + v-str-recid12
      966     .
      967   end.
      968           g-log = browse-1grp:refresh() .
      969         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      970             g-log = browse-1grp:select-next-row ().
      971             apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      972         end.
      973       end.
      974       apply "display" to browse-1grp in frame Dialog-Frame.
