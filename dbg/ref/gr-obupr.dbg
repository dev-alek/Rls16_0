     1028   ON VALUE-CHANGED OF BROWSE-1grp IN FRAME Dialog-Frame
     1029   DO:
     1030     OPEN QUERY BROWSE-2cli FOR EACH buf_tnv-in-turnover-group OF buf_turnover-group      WHERE ( r-status = 2 OR buf_tnv-in-turnover-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     1031   END.
     1032   ON VALUE-CHANGED OF R-status IN FRAME Dialog-Frame
     1033   DO:
     1034       ASSIGN R-status .
     1035     OPEN QUERY BROWSE-1grp FOR EACH buf_turnover-group WHERE ( r-status = 2 OR buf_turnover-group.stts =  r-status ) and ( r-find = no or (buf_turnover-group.tog-db-num = find-db and                   buf_turnover-group.tog-id = find-id )) .
     1036     OPEN QUERY BROWSE-2cli FOR EACH buf_tnv-in-turnover-group OF buf_turnover-group      WHERE ( r-status = 2 OR buf_tnv-in-turnover-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     1037   END.
     1038   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1039   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1040   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1041   on help of frame Dialog-Frame
     1042   do:
     1043     run gbl/app_help.p
     1044       (input this-procedure :file-name
     1045       ,input ''
     1046       ,input ?
     1047       ) no-error.
     1048     if error-status :error then do:
     1049       message
     1050         "Ошибка при вызове помощи"
     1051         error-status :get-message(1)
     1052         view-as alert-box .
     1053     end.
     1054   end.
     1055   run minbtn-set in this-procedure .
     1056   on choose of b-help in frame Dialog-Frame
     1057   do:
     1058     apply "help":u to frame Dialog-Frame .
     1059   end.
     1060   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1061   procedure minbtn-set :
     1062       do
     1063           on error undo, return error return-value
     1064           :
     1065           define variable ii              as integer       no-undo .
     1066           define variable fh              as widget-handle no-undo .
     1067           define variable hh              as widget-handle no-undo .
     1068           define variable v-h             as handle        extent 4 no-undo .
     1069           define variable v-name-button   as character     no-undo .
     1070           define variable v-help-old-x    as decimal       no-undo .
     1071           define variable v-help-old-y    as decimal       no-undo .
     1072           define variable v-help-old-size as decimal       no-undo .
     1073           define variable v-frame-width   as decimal       no-undo .
     1074           define variable jj              as integer       no-undo .
     1075           do
     1076               on error undo, return error
     1077               :
     1078               assign
     1079                   v-frame-width = frame Dialog-Frame:width - 0.3
     1080                   fh            = frame Dialog-Frame:first-child
     1081                   hh            = fh:first-child
     1082                   ii            = 1
     1083                   .
     1084               do while valid-handle(hh):
     1085                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1086                   do:
     1087                       case lc(hh:name) :
     1088                           when "b-help" then
     1089                               do:
     1090                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1091                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1092                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1093                                   hh:TOOLTIP = "Помощь" .
     1094                                   v-help-old-x = hh:column .
     1095                                   v-help-old-y = hh:row    .
     1096                                   v-help-old-size = hh:width .
     1097                                   hh:width-chars = 2.5 .
     1098                               end.
     1099                           when "b-print" then
     1100                               do:
     1101                                   hh:load-image("cmp/b-print.bmp":u) .
     1102                                   hh:TOOLTIP = "Печать" .
     1103                                   v-h[ii] = hh:handle .
     1104                                   ii = ii + 1 .
     1105                                   hh:width-chars = 3 .
     1106                               end.
     1107                           when "b-history" or
     1108                           when "b-hist" then
     1109                               do:
     1110                                   hh:load-image("cmp/b-hist.bmp":u) .
     1111                                   hh:TOOLTIP = "История" .
     1112                                   v-h[ii] = hh:handle .
     1113                                   ii = ii + 1 .
     1114                                   hh:width-chars = 3 .
     1115                               end.
     1116                           when "b-sch" then
     1117                               do:
     1118                                   hh:load-image("cmp/b-sch.bmp":u) .
     1119                                   hh:TOOLTIP = "Установка Фильтра" .
     1120                                   v-h[ii] = hh:handle .
     1121                                   ii = ii + 1 .
     1122                                   hh:width-chars = 3 .
     1123                               end.
     1124                           when "b-hist-user" then
     1125                               do:
     1126                                   hh:load-image("cmp/b-hist.bmp":u) .
     1127                                   hh:TOOLTIP = "История пользователя" .
     1128                                   ii = ii + 1 .
     1129                               end.
     1130                       end case.
     1131                   end.
     1132                   hh = hh:next-sibling.
     1133               end.
     1134               b-help:column = v-frame-width - b-help:width-chars.
     1135               jj = 0.
     1136               repeat ii = 4 to 1 by -1 :
     1137                   if valid-handle (v-h[ii] ) then
     1138                   do:
     1139                       jj  = jj + 1 .
     1140                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1141                       v-h[ii]:row    = v-help-old-y .
     1142                   end.
     1143               end.
     1144           end.
     1145       end.
     1146   end procedure.
     1147   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1148   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1149   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1150   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1151   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1152   define variable v-diasize-current-frame-height as decimal   no-undo .
     1153   define variable v-diasize-change-size          as logical   no-undo .
     1154   define variable v-diasize-resize-button        as handle    no-undo .
     1155   define variable v-diasize-wndmax               as logical   no-undo .
     1156   define variable v-diasize-wndstore             as logical   no-undo .
     1157   define variable v-diasize-proc-name            as character no-undo .
     1158   define variable v-diasize-browse-handle        as handle    no-undo .
     1159   define variable v-diasize-browse-number        as integer   no-undo .
     1160   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1161   define temp-table temp-diasize-handle no-undo
     1162     field handle-value  as handle
     1163     field save-position as decimal
     1164     index xpk is primary unique handle-value
     1165     .
     1166   define temp-table temp-browse-handle no-undo
     1167     field browse-type   as character
     1168     field browse-number as integer
     1169     field browse-handle as handle
     1170     field original-size as decimal
     1171     index xpk is primary unique browse-type browse-number
     1172     index xie browse-type browse-handle
     1173   .
     1174   procedure diasize_change-height :
     1175     define input  parameter p-change-value  as decimal   no-undo .
     1176     define input  parameter p-move-resize   as logical   no-undo .
     1177     define variable v-field-group-handle    as handle    no-undo .
     1178     define variable v-object-handle         as handle    no-undo .
     1179     define variable v-frame-height          as decimal   no-undo .
     1180     define variable v-frame-virtual-height  as decimal   no-undo .
     1181     define variable v-browse-height         as decimal   no-undo .
     1182     define variable v-window-height         as decimal   no-undo .
     1183     define variable v-window-virtual-height as decimal   no-undo .
     1184     define variable v-change-sign           as integer   no-undo .
     1185     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1186     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1187     if p-change-value > 0
     1188     then do:
     1189       if frame Dialog-Frame :height + p-change-value
     1190           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1191       then do:
     1192         assign
     1193           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1194                           - (frame Dialog-Frame :height-chars)
     1195         .
     1196         if p-change-value <= 0
     1197         then do:
     1198           run diasize_position-resize-button in this-procedure .
     1199           return .
     1200         end.
     1201       end.
     1202     end.
     1203     if p-change-value < 0
     1204     then do:
     1205       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1206       then do:
     1207         assign
     1208           p-change-value = v-diasize-orig-frame-height
     1209                          - (frame Dialog-Frame :height-chars)
     1210         .
     1211         if p-change-value >= 0
     1212         then do:
     1213           run diasize_position-resize-button in this-procedure .
     1214           return .
     1215         end.
     1216       end.
     1217     end.
     1218     if p-change-value >= 0
     1219     then do:
     1220       assign
     1221         v-change-sign = 1
     1222       .
     1223     end.
     1224     else do:
     1225       assign
     1226         v-change-sign = -1
     1227       .
     1228     end.
     1229     assign
     1230       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1231     .
     1232     if p-change-value = 0
     1233     then do:
     1234       run diasize_position-resize-button in this-procedure .
     1235       return .
     1236     end.
     1237     move_block:
     1238     do
     1239     on error undo move_block, retry move_block
     1240     :
     1241       if retry
     1242       then do:
     1243         do
     1244         on error undo move_block, leave move_block
     1245         :
     1246           if p-change-value > 0
     1247           then do:
     1248             for each buf_temp-diasize-handle
     1249             on error undo, next
     1250             :
     1251               assign
     1252                 v-object-handle = buf_temp-diasize-handle.handle-value
     1253               .
     1254               if v-object-handle <> v-diasize-resize-button
     1255               then do:
     1256                 assign
     1257                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1258                 .
     1259               end.
     1260             end.
     1261             assign
     1262               v-diasize-browse-handle :height = v-browse-height
     1263             .
     1264             for each buf_temp-browse-handle
     1265               where buf_temp-browse-handle.browse-type = 'height':u
     1266             on error undo, next
     1267             :
     1268               assign
     1269                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1270               .
     1271             end.
     1272             assign
     1273               frame Dialog-Frame :height = v-frame-height
     1274             .
     1275             if frame Dialog-Frame :scrollable = true
     1276             then do:
     1277               assign
     1278                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1279               .
     1280             end.
     1281             run diasize_position-resize-button in this-procedure .
     1282           end.
     1283           else do:
     1284             if frame Dialog-Frame :scrollable = true
     1285             then do:
     1286               assign
     1287                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1288               .
     1289             end.
     1290             assign
     1291               frame Dialog-Frame :height = v-frame-height
     1292             .
     1293             assign
     1294               v-diasize-browse-handle :height = v-browse-height
     1295             .
     1296             for each buf_temp-browse-handle
     1297               where buf_temp-browse-handle.browse-type = 'height':u
     1298             on error undo, next
     1299             :
     1300               assign
     1301                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1302               .
     1303             end.
     1304             for each buf_temp-diasize-handle
     1305             on error undo, next
     1306             :
     1307               assign
     1308                 v-object-handle = buf_temp-diasize-handle.handle-value
     1309               .
     1310               if v-object-handle <> v-diasize-resize-button
     1311               then do:
     1312                 assign
     1313                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1314                 .
     1315               end.
     1316             end.
     1317             run diasize_position-resize-button in this-procedure .
     1318           end.
     1319           assign
     1320             v-diasize-change-size = false
     1321           .
     1322           leave move_block .
     1323         end.
     1324       end.
     1325       assign
     1326         v-diasize-need-full-display = true
     1327       .
     1328       if v-diasize-change-size = false
     1329       then do:
     1330         assign
     1331           v-diasize-change-size = true
     1332         .
     1333       end.
     1334       else do:
     1335         return .
     1336       end.
     1337       assign
     1338         v-frame-height = frame Dialog-Frame :height
     1339         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1340         v-browse-height = v-diasize-browse-handle :height
     1341       .
     1342       for each buf_temp-browse-handle
     1343         where buf_temp-browse-handle.browse-type = 'height':u
     1344       :
     1345         assign
     1346           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1347         .
     1348       end.
     1349       for each buf_temp-diasize-handle
     1350       :
     1351         delete buf_temp-diasize-handle .
     1352       end.
     1353       assign
     1354         v-field-group-handle = frame Dialog-Frame :first-child
     1355       .
     1356       do while valid-handle(v-field-group-handle)
     1357       :
     1358         assign
     1359           v-object-handle = v-field-group-handle :first-child
     1360         .
     1361         do while valid-handle(v-object-handle)
     1362         :
     1363           if  v-object-handle <> v-diasize-browse-handle :handle
     1364           and can-query(v-object-handle, "row")
     1365           and can-query(v-object-handle, "height")
     1366           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1367           then do:
     1368             find first buf_temp-browse-handle
     1369               where buf_temp-browse-handle.browse-type   = 'height':u
     1370                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1371               no-error .
     1372             if available buf_temp-browse-handle
     1373             then do:
     1374             end.
     1375             else do:
     1376               create buf_temp-diasize-handle .
     1377               assign
     1378                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1379                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1380               .
     1381             end.
     1382           end.
     1383           assign
     1384             v-object-handle = v-object-handle :next-sibling
     1385           .
     1386         end.
     1387         assign
     1388           v-field-group-handle = v-field-group-handle :next-sibling
     1389         .
     1390       end.
     1391       do with frame Dialog-Frame
     1392       :
     1393         hide v-diasize-resize-button .
     1394         assign
     1395           v-diasize-resize-button :row    = 1
     1396           v-diasize-resize-button :column = 1
     1397         .
     1398       end.
     1399       if p-change-value > 0
     1400       then do:
     1401         if frame Dialog-Frame :scrollable = true
     1402         then do:
     1403           assign
     1404             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1405             no-error .
     1406           if error-status :error
     1407           or error-status :get-message(1) <> ""
     1408           then do:
     1409             undo move_block, retry move_block .
     1410           end.
     1411         end.
     1412         assign
     1413           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1414           no-error .
     1415         if error-status :error
     1416         or error-status :get-message(1) <> ""
     1417         then do:
     1418           undo move_block, retry move_block .
     1419         end.
     1420         assign
     1421           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1422           no-error .
     1423         if error-status :error
     1424         or error-status :get-message(1) <> ""
     1425         then do:
     1426           undo move_block, retry move_block .
     1427         end.
     1428         for each buf_temp-browse-handle
     1429           where buf_temp-browse-handle.browse-type = 'height':u
     1430         on error undo move_block, retry move_block
     1431         :
     1432           assign
     1433             buf_temp-browse-handle.browse-handle :height
     1434               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1435             no-error .
     1436           if error-status :error
     1437           or error-status :get-message(1) <> ""
     1438           then do:
     1439             undo move_block, retry move_block .
     1440           end.
     1441         end.
     1442         for each buf_temp-diasize-handle
     1443         on error undo move_block, retry move_block
     1444         :
     1445           assign
     1446             v-object-handle = buf_temp-diasize-handle.handle-value
     1447           .
     1448           if v-object-handle <> v-diasize-resize-button
     1449           then do:
     1450             assign
     1451               v-object-handle :row = v-object-handle :row + p-change-value
     1452               no-error .
     1453             if error-status :error
     1454             or error-status :get-message(1) <> ""
     1455             then do:
     1456               undo move_block, retry move_block .
     1457             end.
     1458           end.
     1459         end.
     1460       end.
     1461       else do:
     1462         for each buf_temp-diasize-handle
     1463         on error undo move_block, retry move_block
     1464         :
     1465           assign
     1466             v-object-handle = buf_temp-diasize-handle.handle-value
     1467           .
     1468           if v-object-handle <> v-diasize-resize-button
     1469           then do:
     1470             assign
     1471               v-object-handle :row = v-object-handle :row + p-change-value
     1472               no-error .
     1473             if error-status :error
     1474             or error-status :get-message(1) <> ""
     1475             then do:
     1476               undo move_block, retry move_block .
     1477             end.
     1478           end.
     1479         end.
     1480         assign
     1481           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1482           no-error .
     1483         if error-status :error
     1484         or error-status :get-message(1) <> ""
     1485         then do:
     1486           undo move_block, retry move_block .
     1487         end.
     1488         for each buf_temp-browse-handle
     1489           where buf_temp-browse-handle.browse-type = 'height':u
     1490         on error undo move_block, retry move_block
     1491         :
     1492           assign
     1493             buf_temp-browse-handle.browse-handle :height
     1494               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1495             no-error .
     1496           if error-status :error
     1497           or error-status :get-message(1) <> ""
     1498           then do:
     1499             undo move_block, retry move_block .
     1500           end.
     1501         end.
     1502         assign
     1503           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1504           no-error .
     1505         if error-status :error
     1506         or error-status :get-message(1) <> ""
     1507         then do:
     1508           undo move_block, retry move_block .
     1509         end.
     1510         if frame Dialog-Frame :scrollable = true
     1511         then do:
     1512           assign
     1513             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1514             no-error .
     1515           if error-status :error
     1516           or error-status :get-message(1) <> ""
     1517           then do:
     1518             undo move_block, retry move_block .
     1519           end.
     1520         end.
     1521       end.
     1522       if p-move-resize = true
     1523       then do:
     1524         run diasize_position-resize-button in this-procedure .
     1525       end.
     1526       if v-diasize-wndstore = true
     1527       then do:
     1528         if connected("ub") = true
     1529         then do:
     1530           define variable v-cntxt-db-num        as integer   no-undo .
     1531           define variable v-cntxt-userid        as character no-undo .
     1532           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1533                                             , OUTPUT v-cntxt-userid
     1534                                             ) .
     1535           run gbl/wndsizew.p
     1536             (input  v-cntxt-db-num
     1537             ,input  v-cntxt-userid
     1538             ,input  v-diasize-proc-name
     1539             ,input  'height':u
     1540             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1541             ) .
     1542         end.
     1543       end.
     1544     end.
     1545     assign
     1546       v-diasize-change-size = false
     1547     .
     1548   end procedure.
     1549   procedure diasize_set-height :
     1550     define input  parameter p-new-height  as decimal   no-undo .
     1551     define input  parameter p-move-resize as logical   no-undo .
     1552     do
     1553     on error undo, return error return-value
     1554     :
     1555       run diasize_change-height in this-procedure
     1556         (input  (p-new-height - frame Dialog-Frame :height)
     1557         ,input  p-move-resize
     1558         ) .
     1559     end.
     1560   end procedure.
     1561   procedure diasize_change-width :
     1562     define input  parameter p-change-value as decimal   no-undo .
     1563     define input  parameter p-move-resize  as logical   no-undo .
     1564     define variable v-field-group-handle   as handle    no-undo .
     1565     define variable v-object-handle        as handle    no-undo .
     1566     define variable v-frame-width          as decimal   no-undo .
     1567     define variable v-frame-virtual-width  as decimal   no-undo .
     1568     define variable v-browse-width         as decimal   no-undo .
     1569     define variable v-window-width         as decimal   no-undo .
     1570     define variable v-window-virtual-width as decimal   no-undo .
     1571     define variable v-change-sign          as integer   no-undo .
     1572     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1573     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1574     if p-change-value > 0
     1575     then do:
     1576       if frame Dialog-Frame :width + p-change-value >
     1577           session :width-chars
     1578       then do:
     1579         assign
     1580           p-change-value = session :width-chars - frame Dialog-Frame :width
     1581         .
     1582         if p-change-value <= 0
     1583         then do:
     1584           run diasize_position-resize-button in this-procedure .
     1585           return .
     1586         end.
     1587       end.
     1588     end.
     1589     if p-change-value < 0
     1590     then do:
     1591       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1592       then do:
     1593         assign
     1594           p-change-value = v-diasize-orig-frame-width
     1595                          - frame Dialog-Frame :width
     1596         .
     1597         if p-change-value >= 0
     1598         then do:
     1599           run diasize_position-resize-button in this-procedure .
     1600           return .
     1601         end.
     1602       end.
     1603     end.
     1604     if p-change-value >= 0
     1605     then do:
     1606       assign
     1607         v-change-sign = 1
     1608       .
     1609     end.
     1610     else do:
     1611       assign
     1612         v-change-sign = -1
     1613       .
     1614     end.
     1615     assign
     1616       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1617     .
     1618     if p-change-value = 0
     1619     then do:
     1620       run diasize_position-resize-button in this-procedure .
     1621       return .
     1622     end.
     1623     move_block:
     1624     do
     1625     on error undo move_block, leave move_block
     1626     :
     1627       if retry
     1628       then do:
     1629         do
     1630         on error undo move_block, leave move_block
     1631         :
     1632           if p-change-value > 0
     1633           then do:
     1634             for each buf_temp-diasize-handle
     1635             on error undo, next
     1636             :
     1637               assign
     1638                 v-object-handle = buf_temp-diasize-handle.handle-value
     1639               .
     1640               if v-object-handle <> v-diasize-resize-button
     1641               then do:
     1642                 assign
     1643                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1644                 .
     1645               end.
     1646             end.
     1647             assign
     1648               v-diasize-browse-handle :width = v-browse-width
     1649             .
     1650             for each buf_temp-browse-handle
     1651               where buf_temp-browse-handle.browse-type = 'width':u
     1652             on error undo, next
     1653             :
     1654               assign
     1655                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1656               .
     1657             end.
     1658             assign
     1659               frame Dialog-Frame :width = v-frame-width
     1660             .
     1661             if frame Dialog-Frame :scrollable = true
     1662             then do:
     1663               assign
     1664                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1665               .
     1666             end.
     1667             run diasize_position-resize-button in this-procedure .
     1668           end.
     1669           else do:
     1670             if frame Dialog-Frame :scrollable = true
     1671             then do:
     1672               assign
     1673                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1674               .
     1675             end.
     1676             assign
     1677               frame Dialog-Frame :width = v-frame-width
     1678             .
     1679             for each buf_temp-browse-handle
     1680               where buf_temp-browse-handle.browse-type = 'width':u
     1681             on error undo, next
     1682             :
     1683               assign
     1684                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1685               .
     1686             end.
     1687             assign
     1688               v-diasize-browse-handle :width = v-browse-width
     1689             .
     1690             for each buf_temp-diasize-handle
     1691             on error undo, next
     1692             :
     1693               assign
     1694                 v-object-handle = buf_temp-diasize-handle.handle-value
     1695               .
     1696               if v-object-handle <> v-diasize-resize-button
     1697               then do:
     1698                 assign
     1699                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1700                 .
     1701               end.
     1702             end.
     1703             run diasize_position-resize-button in this-procedure .
     1704           end.
     1705           assign
     1706             v-diasize-change-size = false
     1707           .
     1708           leave move_block .
     1709         end.
     1710       end.
     1711       assign
     1712         v-diasize-need-full-display = true
     1713       .
     1714       if v-diasize-change-size = false
     1715       then do:
     1716         assign
     1717           v-diasize-change-size = true
     1718         .
     1719       end.
     1720       else do:
     1721         return .
     1722       end.
     1723       assign
     1724         v-frame-width = frame Dialog-Frame :width
     1725         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1726         v-browse-width = v-diasize-browse-handle :width
     1727       .
     1728       for each buf_temp-browse-handle
     1729         where buf_temp-browse-handle.browse-type = 'width':u
     1730       :
     1731         assign
     1732           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1733         .
     1734       end.
     1735       for each buf_temp-diasize-handle
     1736       :
     1737         delete buf_temp-diasize-handle .
     1738       end.
     1739       assign
     1740         v-field-group-handle = frame Dialog-Frame :first-child
     1741       .
     1742       do while valid-handle(v-field-group-handle)
     1743       :
     1744         assign
     1745           v-object-handle = v-field-group-handle :first-child
     1746         .
     1747         do while valid-handle(v-object-handle)
     1748         :
     1749           if  v-object-handle <> v-diasize-browse-handle :handle
     1750           and v-object-handle <> v-diasize-resize-button
     1751           and can-query(v-object-handle, "row")
     1752           and can-query(v-object-handle, "height")
     1753           and ( v-object-handle :col + v-object-handle :width
     1754                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1755               )
     1756           then do:
     1757             find first buf_temp-browse-handle
     1758               where buf_temp-browse-handle.browse-type   = 'width':u
     1759                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1760               no-error .
     1761             if available buf_temp-browse-handle
     1762             then do:
     1763             end.
     1764             else do:
     1765               create buf_temp-diasize-handle .
     1766               assign
     1767                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1768                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1769               .
     1770             end.
     1771           end.
     1772           assign
     1773             v-object-handle = v-object-handle :next-sibling
     1774           .
     1775         end.
     1776         assign
     1777           v-field-group-handle = v-field-group-handle :next-sibling
     1778         .
     1779       end.
     1780       do with frame Dialog-Frame
     1781       :
     1782         hide v-diasize-resize-button .
     1783         v-diasize-resize-button :row = 1.
     1784         v-diasize-resize-button :column = 1.
     1785       end.
     1786       if p-change-value > 0
     1787       then do:
     1788         if frame Dialog-Frame :scrollable = true
     1789         then do:
     1790           assign
     1791             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1792             no-error .
     1793           if error-status :error
     1794           or error-status :get-message(1) <> ""
     1795           then do:
     1796             undo move_block, retry move_block.
     1797           end.
     1798         end.
     1799         assign
     1800           frame Dialog-Frame :width = v-frame-width + p-change-value
     1801           no-error .
     1802         if error-status :error
     1803         or error-status :get-message(1) <> ""
     1804         then do:
     1805           undo move_block, retry move_block.
     1806         end.
     1807         assign
     1808           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1809         no-error .
     1810         if error-status :error
     1811         or error-status :get-message(1) <> ""
     1812         then do:
     1813           undo move_block, retry move_block.
     1814         end.
     1815         for each buf_temp-browse-handle
     1816           where buf_temp-browse-handle.browse-type = 'width':u
     1817         on error undo move_block, retry move_block
     1818         :
     1819           assign
     1820             buf_temp-browse-handle.browse-handle :width
     1821               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1822             no-error .
     1823           if error-status :error
     1824           or error-status :get-message(1) <> ""
     1825           then do:
     1826             undo move_block, retry move_block .
     1827           end.
     1828         end.
     1829         for each buf_temp-diasize-handle
     1830         on error undo move_block, retry move_block
     1831         :
     1832           assign
     1833             v-object-handle = buf_temp-diasize-handle.handle-value
     1834           .
     1835           if v-object-handle <> v-diasize-resize-button
     1836           then do:
     1837             assign
     1838               v-object-handle :col = v-object-handle :col + p-change-value
     1839               no-error .
     1840             if error-status :error
     1841             or error-status :get-message(1) <> ""
     1842             then do:
     1843               undo move_block, retry move_block .
     1844             end.
     1845           end.
     1846         end.
     1847       end.
     1848       else do:
     1849         for each buf_temp-diasize-handle
     1850         on error undo move_block, retry move_block
     1851         :
     1852           assign
     1853             v-object-handle = buf_temp-diasize-handle.handle-value
     1854           .
     1855           if v-object-handle <> v-diasize-resize-button
     1856           then do:
     1857             assign
     1858               v-object-handle :col = v-object-handle :col + p-change-value
     1859               no-error .
     1860             if error-status :error
     1861             or error-status :get-message(1) <> ""
     1862             then do:
     1863               undo move_block, retry move_block .
     1864             end.
     1865           end.
     1866         end.
     1867         for each buf_temp-browse-handle
     1868           where buf_temp-browse-handle.browse-type = 'width':u
     1869         on error undo move_block, retry move_block
     1870         :
     1871           assign
     1872             buf_temp-browse-handle.browse-handle :width
     1873               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1874             no-error .
     1875           if error-status :error
     1876           or error-status :get-message(1) <> ""
     1877           then do:
     1878             undo move_block, retry move_block .
     1879           end.
     1880         end.
     1881         assign
     1882           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1883           no-error .
     1884         if error-status :error
     1885         or error-status :get-message(1) <> ""
     1886         then do:
     1887           undo move_block, retry move_block.
     1888         end.
     1889         assign
     1890           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1891         no-error .
     1892         if error-status :error
     1893         or error-status :get-message(1) <> ""
     1894         then do:
     1895           undo move_block, retry move_block.
     1896         end.
     1897         if frame Dialog-Frame :scrollable = true
     1898         then do:
     1899           assign
     1900             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1901           no-error .
     1902           if error-status :error
     1903           or error-status :get-message(1) <> ""
     1904           then do:
     1905             undo move_block, retry move_block.
     1906           end.
     1907         end.
     1908       end.
     1909       if p-move-resize
     1910       then do:
     1911         run diasize_position-resize-button in this-procedure .
     1912       end.
     1913       if v-diasize-wndstore = true
     1914       then do:
     1915         if connected("ub") = true
     1916         then do:
     1917           define variable v-cntxt-db-num        as integer   no-undo .
     1918           define variable v-cntxt-userid        as character no-undo .
     1919           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1920                                             , OUTPUT v-cntxt-userid
     1921                                             ) .
     1922           run gbl/wndsizew.p
     1923             (input  v-cntxt-db-num
     1924             ,input  v-cntxt-userid
     1925             ,input  v-diasize-proc-name
     1926             ,input  'width':u
     1927             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1928             ) .
     1929         end.
     1930       end.
     1931     end.
     1932     assign
     1933       v-diasize-change-size = false
     1934     .
     1935   end procedure.
     1936   procedure diasize_set-width :
     1937     define input  parameter p-new-width  as decimal   no-undo .
     1938     define input  parameter p-move-resize as logical   no-undo .
     1939     do
     1940     on error undo, return error return-value
     1941     :
     1942       run diasize_change-width in this-procedure
     1943         (input  (p-new-width - frame Dialog-Frame :width)
     1944         ,input  p-move-resize
     1945         ) .
     1946     end.
     1947   end procedure.
     1948   procedure diasize_position-resize-button :
     1949     do with frame Dialog-Frame
     1950     :
     1951       hide v-diasize-resize-button .
     1952       assign
     1953         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1954                     - 1
     1955                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1956         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1957                     - 1
     1958                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1959       .
     1960       view v-diasize-resize-button .
     1961     end.
     1962   end procedure.
     1963   on alt-right anywhere
     1964   do:
     1965     run diasize_change-width in this-procedure
     1966       (input 1
     1967       ,input true
     1968       ) .
     1969     return no-apply .
     1970   end.
     1971   on alt-left anywhere
     1972   do:
     1973     run diasize_change-width in this-procedure
     1974       (input -1
     1975       ,input true
     1976       ) .
     1977     return no-apply .
     1978   end.
     1979   on alt-down anywhere
     1980   do:
     1981     run diasize_change-height in this-procedure
     1982       (input 1
     1983       ,input true
     1984       ) .
     1985     return no-apply .
     1986   end.
     1987   on alt-up anywhere
     1988   do:
     1989     run diasize_change-height in this-procedure
     1990       (input -1
     1991       ,input true
     1992       ) .
     1993     return no-apply .
     1994   end.
     1995   on alt-enter of frame Dialog-Frame
     1996   do:
     1997     run diasize_maximize in this-procedure
     1998       (input  ?
     1999       ).
     2000     return no-apply .
     2001   end.
     2002   procedure diasize_end-move :
     2003     do
     2004     on error undo, return error return-value
     2005     :
     2006       define variable v-row-delta as decimal   no-undo .
     2007       define variable v-col-delta as decimal   no-undo .
     2008       define variable v-new-row as decimal   no-undo .
     2009       define variable v-new-col as decimal   no-undo .
     2010       assign
     2011         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2012         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2013       .
     2014       assign
     2015         v-row-delta = v-new-row - frame Dialog-Frame :height
     2016         v-col-delta = v-new-col - frame Dialog-Frame :width
     2017       .
     2018       run diasize_change-height in this-procedure
     2019         (input v-row-delta
     2020         ,input true
     2021         ) .
     2022       run diasize_change-width in this-procedure
     2023         (input v-col-delta
     2024         ,input true
     2025         ) .
     2026     end.
     2027   end procedure.
     2028   procedure diasize_maximize :
     2029     define input  parameter p-action as logical   no-undo .
     2030     do
     2031     on error undo, return error return-value
     2032     :
     2033       if p-action = ?
     2034       then do:
     2035         if v-diasize-need-maximize = true
     2036         then do:
     2037           assign
     2038             p-action = true
     2039           .
     2040         end.
     2041         else do:
     2042           assign
     2043             p-action = false
     2044           .
     2045         end.
     2046       end.
     2047       if p-action = true
     2048       then do:
     2049         run diasize_change-height in this-procedure
     2050           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2051               - frame Dialog-Frame :height-chars
     2052           ,input true
     2053           ) .
     2054         run diasize_change-width in this-procedure
     2055           (input session :width-chars
     2056               - frame Dialog-Frame :width-chars
     2057           ,input true
     2058           ) .
     2059         assign
     2060           v-diasize-need-maximize = false
     2061         .
     2062       end.
     2063       else do:
     2064         run diasize_change-width in this-procedure
     2065           (input v-diasize-orig-frame-width
     2066               - frame Dialog-Frame :width-chars
     2067           ,input true
     2068           ) .
     2069         run diasize_change-height in this-procedure
     2070           (input v-diasize-orig-frame-height
     2071               - frame Dialog-Frame :height-chars
     2072           ,input true
     2073           ) .
     2074         assign
     2075           v-diasize-need-maximize = true
     2076         .
     2077       end.
     2078     end.
     2079   end procedure.
     2080   procedure diasize_restore-orig-size :
     2081     do
     2082     on error undo, return error return-value
     2083     :
     2084       assign
     2085         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2086         v-diasize-current-frame-height = frame Dialog-Frame :height
     2087       .
     2088       run diasize_set-height in this-procedure
     2089         (input  v-diasize-orig-frame-height
     2090         ,input  true
     2091         ) .
     2092       run diasize_set-width in this-procedure
     2093         (input  v-diasize-orig-frame-width
     2094         ,input  true
     2095         ) .
     2096     end.
     2097   end procedure.
     2098   procedure diasize_restore-current-size :
     2099     do
     2100     on error undo, return error return-value
     2101     :
     2102       run diasize_set-height in this-procedure
     2103         (input  v-diasize-current-frame-height
     2104         ,input  true
     2105         ) .
     2106       run diasize_set-width in this-procedure
     2107         (input  v-diasize-current-frame-width
     2108         ,input  true
     2109         ) .
     2110     end.
     2111   end procedure.
     2112   procedure diasize_set-browse-handle :
     2113     define input  parameter p-browse-handle as handle   no-undo .
     2114     define buffer buf_temp-browse-handle for temp-browse-handle .
     2115     do
     2116     on error undo, return error return-value
     2117     :
     2118       assign
     2119         v-diasize-browse-handle = p-browse-handle
     2120       .
     2121       for each buf_temp-browse-handle
     2122       on error undo, return error return-value
     2123       :
     2124         delete buf_temp-browse-handle .
     2125       end.
     2126     end.
     2127   end procedure.
     2128   procedure diasize_add_browse :
     2129     define input  parameter p-browse-type   as character no-undo .
     2130     define input  parameter p-browse-handle as handle    no-undo .
     2131     define buffer buf_temp-browse-handle for temp-browse-handle .
     2132     do
     2133     on error undo, return error return-value
     2134     :
     2135       assign
     2136         v-diasize-browse-number = v-diasize-browse-number + 1
     2137       .
     2138       create buf_temp-browse-handle .
     2139       assign
     2140         buf_temp-browse-handle.browse-type   = p-browse-type
     2141         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2142         buf_temp-browse-handle.browse-handle = p-browse-handle
     2143       .
     2144     end.
     2145   end procedure.
     2146   procedure diasize_init :
     2147     define variable v-default-value    as logical   no-undo .
     2148     define variable v-restore-saved    as logical   no-undo .
     2149     define variable v-resize-value-str as character no-undo .
     2150     do
     2151     on error undo, return error return-value
     2152     :
     2153       do with frame Dialog-Frame
     2154       :
     2155         assign
     2156           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2157           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2158           v-diasize-browse-handle     = browse browse-1grp :handle
     2159         .
     2160         create button v-diasize-resize-button
     2161         assign
     2162           parent        = frame Dialog-Frame :first-child
     2163           label         = "s"
     2164           height-pixels = 16
     2165           width-pixels  = 16
     2166           visible       = true
     2167           sensitive     = true
     2168           movable       = true
     2169           triggers:
     2170             on end-move persistent run diasize_end-move in this-procedure .
     2171           end triggers.
     2172         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2173         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2174         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2175         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2176         assign
     2177           v-diasize-wndmax = false
     2178         .
     2179         if connected("ub") = true
     2180         then do:
     2181           define variable v-cntxt-db-num        as integer   no-undo .
     2182           define variable v-cntxt-userid        as character no-undo .
     2183           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2184                                             , OUTPUT v-cntxt-userid
     2185                                             ) .
     2186           run gbl/wndpar_r.p
     2187             (input  v-cntxt-db-num
     2188             ,input  v-cntxt-userid
     2189             ,input  'wndmax':U
     2190             ,output v-diasize-wndmax
     2191             ,output v-default-value
     2192             ) .
     2193         end.
     2194         assign
     2195           v-diasize-wndstore = false
     2196         .
     2197         if connected("ub") = true
     2198         then do:
     2199           run gbl/wndpar_r.p
     2200             (input  v-cntxt-db-num
     2201             ,input  v-cntxt-userid
     2202             ,input  'wndstore':U
     2203             ,output v-diasize-wndstore
     2204             ,output v-default-value
     2205             ) .
     2206         end.
     2207         assign
     2208           v-diasize-proc-name = entry(1, program-name(2), '.')
     2209         .
     2210         if v-diasize-wndstore = true
     2211         then do:
     2212           assign
     2213             v-restore-saved = false
     2214           .
     2215           if connected("ub") = true
     2216           then do:
     2217             run gbl/wndsizer.p
     2218               (input  v-cntxt-db-num
     2219               ,input  v-cntxt-userid
     2220               ,input  v-diasize-proc-name
     2221               ,input  'height':u
     2222               ,output v-resize-value-str
     2223               ) .
     2224             if v-resize-value-str <> '':U
     2225             then do:
     2226               run diasize_change-height in this-procedure
     2227                 (input  integer(v-resize-value-str)
     2228                 ,input  true
     2229                 ) .
     2230               assign
     2231                 v-restore-saved = true
     2232               .
     2233             end.
     2234           end.
     2235           if connected("ub") = true
     2236           then do:
     2237             run gbl/wndsizer.p
     2238               (input  v-cntxt-db-num
     2239               ,input  v-cntxt-userid
     2240               ,input  v-diasize-proc-name
     2241               ,input  'width':u
     2242               ,output v-resize-value-str
     2243               ) .
     2244             if v-resize-value-str <> '':U
     2245             then do:
     2246               run diasize_change-width in this-procedure
     2247                 (input  integer(v-resize-value-str)
     2248                 ,input  true
     2249                 ) .
     2250               assign
     2251                 v-restore-saved = true
     2252               .
     2253             end.
     2254           end.
     2255           if v-restore-saved <> true
     2256           then do:
     2257             if v-diasize-wndmax = true
     2258             then do:
     2259               run diasize_maximize in this-procedure
     2260                 (input  true
     2261                 ) .
     2262             end.
     2263           end.
     2264         end.
     2265         else do:
     2266           if v-diasize-wndmax = true
     2267           then do:
     2268             run diasize_maximize in this-procedure
     2269               (input  true
     2270               ) .
     2271           end.
     2272         end.
     2273       end.
     2274     end.
     2275   end procedure.
     2276   procedure diasize_need-full-display :
     2277     define output parameter p-need-full-display as logical   no-undo .
     2278     do
     2279     on error undo, return error return-value
     2280     :
     2281       assign
     2282         p-need-full-display = v-diasize-need-full-display
     2283       .
     2284       assign
     2285         v-diasize-need-full-display = false
     2286       .
     2287     end.
     2288   end procedure.
     2289   procedure get-context :
     2290      define output parameter p-db-num as integer          no-undo.
     2291      define output parameter p-user-id as character        no-undo.
     2292      define variable v-login               as character    no-undo.
     2293      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2294      define buffer buf_user-login  for ub.user-login .
     2295      do
     2296      on error undo, return error
     2297      :
     2298            FIND FIRST buf_sys-ctrl no-lock.
     2299            ASSIGN
     2300               v-login = USERID("ub")
     2301               p-db-num = buf_sys-ctrl.db-num
     2302            .
     2303            FIND FIRST buf_user-login
     2304                 WHERE buf_user-login.db-num = p-db-num
     2305                   AND buf_user-login.user-login = v-login
     2306                 no-lock
     2307                 no-error
     2308                 .
     2309            IF AVAILABLE buf_user-login
     2310            THEN DO:
     2311               assign
     2312                  p-user-id = buf_user-login.user-id
     2313               .
     2314            END.
     2315      end.
     2316   end procedure.
     2317   run diasize_add_browse in this-procedure
     2318     (input  'HEIGHT':U
     2319     ,input  browse browse-2cli :handle
     2320     ) .
     2321   run diasize_init in this-procedure .
     2322   MAIN-BLOCK:
     2323   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2324      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2325      define variable g#log as logical   no-undo .
     2326   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2327   do:
     2328     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2329       (input  v-cntxt-db-num
     2330       ,input  v-cntxt-userid
     2331       ,input  0
     2332       ,input  'actn_ref-mpl_lookup':U
     2333       ,input  'global':U
     2334       ,input  v-cntxt-host-code-obj
     2335       ,input  v-cntxt-obj-type
     2336       ,input  v-cntxt-obj-code
     2337       ,input  0
     2338       ,input  0
     2339       ,input  0
     2340       ,input  true
     2341       ,output g#log
     2342       )  .
     2343   end.
     2344     if not g#log then return .
     2345      buf_turnover-group.name:resizable in browse browse-1grp = true .
     2346      buf_turnover-group.name:width  in browse browse-1grp = 20 .
     2347     if p-rec-list <> "" and p-rec-list <> ? then run select_one .
     2348     RUN enable_UI.
     2349     disable
     2350        B-sel      when LOOKUP ("b-sel":U,    p-bttns) = 0
     2351        B-add      when LOOKUP ("b-add":U,    p-bttns) = 0
     2352        B-del      when LOOKUP ("b-del":U,    p-bttns) = 0
     2353        B-add-2    when LOOKUP ("b-add":U,    p-bttns) = 0
     2354        B-del-2    when LOOKUP ("b-del":U,    p-bttns) = 0
     2355        B-chg      when LOOKUP ("b-chg":U,    p-bttns) = 0
     2356        B-chg-2    when LOOKUP ("b-chg":U,    p-bttns) = 0
     2357        B-mark     when LOOKUP ("b-mark":U,   p-bttns) = 0
     2358        B-mark-2   when LOOKUP ("b-mark-2":U, p-bttns) = 0
     2359       with frame Dialog-Frame .
     2360     WAIT-FOR GO OF FRAME Dialog-Frame.
     2361   END.
     2362   RUN disable_UI.
     2363   PROCEDURE disable_UI :
     2364     HIDE FRAME Dialog-Frame.
     2365   END PROCEDURE.
     2366   PROCEDURE enable_UI :
     2367     DISPLAY R-status FILL-IN-1
     2368         WITH FRAME Dialog-Frame.
     2369     ENABLE B-Cancel B-sel B-add B-chg B-del B-price-type B-history B-Help B-print
     2370            R-status B-mark-2 B-add-2 B-chg-2 B-del-2 B-mark b-clients BROWSE-1grp
     2371            BROWSE-2cli FILL-IN-1
     2372         WITH FRAME Dialog-Frame.
     2373     VIEW FRAME Dialog-Frame.
     2374     OPEN QUERY BROWSE-1grp FOR EACH buf_turnover-group WHERE ( r-status = 2 OR buf_turnover-group.stts =  r-status ) and ( r-find = no or (buf_turnover-group.tog-db-num = find-db and                   buf_turnover-group.tog-id = find-id )) .    OPEN QUERY BROWSE-2cli FOR EACH buf_tnv-in-turnover-group OF buf_turnover-group      WHERE ( r-status = 2 OR buf_tnv-in-turnover-group.stts =  r-status )       NO-LOCK INDEXED-REPOSITION.
     2375   END PROCEDURE.
     2376   PROCEDURE select_one :
     2377   define buffer bufl_turnover-group for ub.turnover-group  .
     2378   find first bufl_turnover-group no-lock where recid(bufl_turnover-group) = int(p-rec-list) no-error .
     2379   if error-status :error then return .
     2380   r-find = true .
     2381   find-db = bufl_turnover-group.tog-db-num  .
     2382   find-id = bufl_turnover-group.tog-id      .
     2383   END PROCEDURE.
