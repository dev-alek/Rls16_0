        1   block-level on error undo, throw.
        2   define input parameter p-tax-code  like ub.c-tax-hist.tax-code no-undo .
        3   define input parameter p-rate-code like ub.c-tax-hist.rate-code no-undo .
        4   define input parameter p-corr-user-db-num  like ub.c-tax-hist.corr-user-db-num no-undo .
        5   define input parameter p-chip-num  like ub.c-tax-hist.chip-num no-undo .
        6   define input parameter p-host-code like ub.c-tax-hist.host-code no-undo .
        7   define input parameter p-obj-type like ub.c-tax-hist.obj-type no-undo .
        8   define input parameter p-obj-code like ub.c-tax-hist.obj-code no-undo .
        9   define input parameter p-subject like ub.c-tax-hist.subject no-undo .
       10   define input parameter p-action   like ub.c-tax-hist.action no-undo .
       11   define input parameter p-silent  as logical no-undo .
       12   define output parameter p-description as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: ctaxhisv.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: ref/ctaxhisv.p $":U .
       18   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории налогов".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define variable v-chg-fields as character no-undo.
       78   define variable v-old-fields as character no-undo.
       79   define variable v-new-fields as character no-undo.
       80   define variable ii as integer no-undo.
       81   define variable v-mess as character no-undo .
       82   define buffer buf_c-tax-hist for ub.c-tax-hist.
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define SHARED temp-table temp-changes no-undo
       85   field f_name as character
       86   field l_name as character
       87   field v_old as character
       88   field v_new as character
       89   field t_name as character
       90   field num_ as integer
       91   field uniq-key-rec as character
       92   field action as integer
       93   field fNotChange as logical
       94   index pi is unique primary
       95   num_
       96   t_name
       97   f_name
       98   index
       99   Chan
      100   fnotChange
      101   t_name
      102   f_name
      103   index imain uniq-key-rec
      104   .
      105   FUNCTION get-all-fields returns character (p-file-name as character ):
      106   define variable v-dop as character no-undo .
      107     find first _file no-lock where _file._file-name = p-file-name no-error .
      108     if not available _file then return "":U.
      109     for each _field no-lock where
      110              _field._file-recid = recid(_file) :
      111       assign
      112       v-dop = v-dop + _field._field-name + chr(44)
      113       .
      114     end.
      115     return trim(v-dop).
      116   END FUNCTION.
      117   PROCEDURE proc-full-temp-changes :
      118     define input  parameter p-act-create as logical   no-undo .
      119     define input  parameter p-act-delete as logical   no-undo .
      120     define input  parameter p-hst-handle as handle    no-undo .
      121     define input  parameter p-main-table as character no-undo .
      122     define input  parameter p-field-list as character no-undo .
      123     define input  parameter p-label-form as character no-undo .
      124     define variable h-new-buf         as handle    no-undo .
      125     define variable h-main-buf        as handle    no-undo .
      126     define variable h-for-comp        as handle    no-undo .
      127     define variable v-inform          as character no-undo .
      128     define variable v-ind             as integer   no-undo .
      129     define variable v-idx-field-qnty  as integer   no-undo .
      130     define variable v-num-entries     as integer   no-undo .
      131     define variable fh                as handle    no-undo .
      132     define variable fh-main           as handle    no-undo .
      133     define variable fh-old            as handle    no-undo .
      134     define variable fh-new            as handle    no-undo .
      135     define variable v-field-name      as character no-undo .
      136     define variable v-field-lvl       as character no-undo .
      137     define variable v-field-form      as character no-undo .
      138     define variable v-search-exp      as character no-undo .
      139     define variable v-srch-main       as character no-undo .
      140     define variable v-word-link       as character no-undo .
      141     define variable v-av-chip-num     as logical   no-undo .
      142     define variable v-main-pi-fld-lst as character no-undo .
      143     define variable v-main-fld-lst    as character no-undo .
      144     define variable v-delim-list      as character no-undo .
      145     define variable v-label           as character no-undo .
      146     define variable v-old-value       as character no-undo case-sensitive.
      147     define variable v-new-value       as character no-undo case-sensitive.
      148     define variable v-chg-fields as character no-undo.
      149     for each temp-changes:
      150       delete temp-changes.
      151     end.
      152     if not p-hst-handle:available then do:
      153       return .
      154     end.
      155     create buffer h-new-buf  for table p-hst-handle .
      156     create buffer h-main-buf for table p-main-table .
      157     assign
      158       v-inform = h-main-buf:index-information(1)
      159       v-ind    = 2
      160     .
      161     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      162     on error undo, return error
      163     :
      164       assign
      165         v-inform = h-main-buf:index-information( v-ind )
      166         v-ind    = v-ind + 1
      167       .
      168     end.
      169     if v-inform = ?
      170       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      171       or entry( 3, v-inform, ",":U ) <> "1":U
      172     then do:
      173       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      174     end.
      175     assign
      176       v-idx-field-qnty = num-entries( v-inform ) - 4
      177     .
      178     if v-idx-field-qnty < 2 then do:
      179       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      180     end.
      181     assign
      182       v-srch-main   = "where":U
      183       v-word-link   = "":U
      184       v-av-chip-num = false
      185       v-delim-list  = "":U
      186     .
      187     do v-ind = 1 to v-idx-field-qnty by 2
      188     on error undo, return error
      189     :
      190       assign
      191         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      192         fh                = p-hst-handle:buffer-field( v-field-name )
      193         fh-main           = h-main-buf:buffer-field( v-field-name )
      194         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      195         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      196       .
      197       if fh:data-type ="character":U then do:
      198         assign
      199           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      200         .
      201       end.
      202       else do:
      203         assign
      204           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      205         .
      206       end.
      207       if v-delim-list = "":U then do:
      208         assign
      209           v-delim-list = ",":U
      210         .
      211       end.
      212       if v-word-link = "":U then do:
      213         assign
      214           v-word-link = "and":U
      215         .
      216       end.
      217     end.
      218     assign
      219       v-delim-list  = "":U
      220     .
      221     do v-ind = 1 to h-main-buf:num-fields
      222     on error undo, return error
      223     :
      224       assign
      225         fh-main      = h-main-buf:buffer-field( v-ind )
      226         v-field-name = fh-main:name
      227       .
      228         assign
      229           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      230         .
      231         if v-delim-list = "":U then do:
      232           assign
      233             v-delim-list = ",":U
      234           .
      235         end.
      236     end.
      237     assign
      238       v-inform = p-hst-handle:index-information(1)
      239       v-ind    = 2
      240     .
      241     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      242     on error undo, return error
      243     :
      244       assign
      245         v-inform = p-hst-handle:index-information( v-ind )
      246         v-ind    = v-ind + 1
      247       .
      248     end.
      249     if v-inform = ?
      250       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      251       or entry( 3, v-inform, ",":U ) <> "1":U
      252     then do:
      253       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      254     end.
      255     assign
      256       v-idx-field-qnty = num-entries( v-inform ) - 4
      257     .
      258     if v-idx-field-qnty < 2 then do:
      259       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      260     end.
      261     assign
      262       v-search-exp  = "where":U
      263       v-word-link   = "":U
      264       v-av-chip-num = false
      265     .
      266     do v-ind = 1 to v-idx-field-qnty by 2
      267     on error undo, return error
      268     :
      269       assign
      270         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      271         fh           = p-hst-handle:buffer-field( v-field-name )
      272         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      273       .
      274       if v-field-name = "chip-num":U then do:
      275         assign
      276           v-search-exp  = substitute( "&1 >", v-search-exp )
      277           v-av-chip-num = true
      278         .
      279       end.
      280       else do:
      281         assign
      282           v-search-exp = substitute( "&1 =", v-search-exp )
      283         .
      284       end.
      285       if fh:data-type ="character":U then do:
      286         assign
      287           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      288         .
      289       end.
      290       else do:
      291         assign
      292           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      293         .
      294       end.
      295       if v-word-link = "":U then do:
      296         assign
      297           v-word-link = "and":U
      298         .
      299       end.
      300     end.
      301     if v-av-chip-num = false then do:
      302       message
      303         vss-workfile vss-revision vss-description skip
      304         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      305         "Использование данной процедуры невозможно!" skip
      306         view-as alert-box error .
      307       return error .
      308     end.
      309     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      310     if not h-new-buf:available then do:
      311       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      312       if not h-main-buf:available then do:
      313         assign
      314           h-for-comp = ?
      315         .
      316       end.
      317       else do:
      318         assign
      319           h-for-comp = h-main-buf
      320         .
      321       end.
      322     end.
      323     else do:
      324       assign
      325         h-for-comp = h-new-buf
      326       .
      327     end.
      328     assign
      329       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      330     .
      331     do v-ind = 1 to v-num-entries
      332     on error undo, return error return-value
      333     :
      334       assign
      335         v-field-name = entry( v-ind, v-main-fld-lst )
      336         fh-old       = p-hst-handle:buffer-field( v-field-name )
      337         v-old-value  = fh-old:buffer-value()
      338         v-label      = trim( fh-old:label )
      339       .
      340       if ( trim( p-field-list ) <> "":U
      341            and lookup( v-field-name, p-field-list ) > 0
      342          )
      343          or trim( p-field-list ) = "":U
      344       then do:
      345         if h-for-comp <> ? then do:
      346           assign
      347             fh-new      = h-for-comp:buffer-field( v-field-name )
      348             v-new-value = fh-new:buffer-value()
      349           .
      350         end.
      351         else do:
      352           assign
      353             v-new-value = "":U
      354           .
      355         end.
      356           if p-act-create = true then do:
      357             assign
      358               v-old-value = "":U
      359             .
      360           end.
      361           if p-act-delete = true then do:
      362             assign
      363               v-new-value = "":U
      364             .
      365           end.
      366         if v-old-value <> v-new-value
      367         then do:
      368           create temp-changes.
      369           assign
      370             temp-changes.t_name = p-main-table
      371             temp-changes.f_name = v-field-name
      372             temp-changes.l_name = replace( v-label, "&":U, "":U )
      373             temp-changes.v_old  = trim( v-old-value )
      374             temp-changes.v_new  = trim( v-new-value )
      375             temp-changes.num_   = 0
      376             temp-changes.fNotChange = v-old-value eq v-new-value
      377           .
      378         end.
      379       end.
      380     end.
      381     assign
      382       v-num-entries = num-entries( p-label-form, chr(8) )
      383     .
      384     do v-ind = 1 to v-num-entries
      385     on error undo, return error return-value
      386     :
      387       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      388         assign
      389           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      390           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      391           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      392         .
      393         find first temp-changes
      394           where temp-changes.f_name = v-field-name
      395           no-error .
      396         if available temp-changes then do:
      397           if trim( v-field-lvl ) <> "":U then do:
      398             assign
      399               temp-changes.l_name = v-field-lvl
      400             .
      401           end.
      402           if trim( v-field-form ) <> "":U then do:
      403             assign
      404               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      405             .
      406             if h-for-comp <> ? then do:
      407               assign
      408                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      409               .
      410             end.
      411           end.
      412         end.
      413       end.
      414       else do:
      415         message
      416           vss-workfile vss-revision vss-description skip
      417           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      418           substitute( "список для поля '&1': '&2'"
      419                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      420                       ,entry( v-ind, p-label-form, chr(8) )
      421                     ) skip
      422           substitute( "полный список: &2", p-label-form ) skip
      423           view-as alert-box error .
      424       end.
      425     end.
      426     delete object h-new-buf .
      427     delete object h-main-buf .
      428   END PROCEDURE.
      429   if p-action = integer('99':U) then return.
      430   find first buf_c-tax-hist no-lock where
      431             buf_c-tax-hist.tax-code = p-tax-code
      432         AND buf_c-tax-hist.rate-code = p-rate-code
      433         AND buf_c-tax-hist.chip-num = p-chip-num
      434         AND buf_c-tax-hist.corr-user-db-num = p-corr-user-db-num
      435         AND buf_c-tax-hist.host-code = p-host-code
      436         AND buf_c-tax-hist.obj-type = p-obj-type
      437         AND buf_c-tax-hist.obj-code = p-obj-code
      438         AND buf_c-tax-hist.subject  = p-subject no-error .
      439   if not available buf_c-tax-hist then do:
      440     return error .
      441   end.
      442   CASE p-subject:
      443     when 'tax':U then do:
      444       run tax-proc in this-procedure(output p-description) no-error .
      445     end.
      446     when 'tax-rate':U then do:
      447       run tax-rate-proc in this-procedure(output p-description) no-error .
      448     end.
      449     when 'tax-rate-value':U then do:
      450       run tax-rate-value-proc in this-procedure(output p-description) no-error .
      451     end.
      452     when 'tax-units':U then do:
      453       run tax-units-proc in this-procedure(output p-description) no-error .
      454     end.
      455   END CASE.
      456   if error-status:error then do:
      457     return error .
      458   end.
      459   procedure tax-proc :
      460   define output parameter p-description as character no-undo .
      461   define buffer current_c-tax for ub.c-tax  .
      462     do
      463     on error undo, return error
      464     :
      465       find first current_c-tax no-lock where
      466                  current_c-tax.tax-code = p-tax-code
      467              AND current_c-tax.chip-num = p-chip-num
      468              AND current_c-tax.corr-user-db-num = p-corr-user-db-num
      469              no-error .
      470       if not avail current_c-tax then do:
      471          v-mess = "Неверная ссылка на c-tax в таблице c-tax-hist".
      472          run err-mess in this-procedure ( input-output v-mess ).
      473          return error (if p-silent then v-mess else '':U).
      474       end.
      475   define variable v-label-param as character no-undo .
      476   v-label-param =
      477     "individual" + chr(4) + "Индивидуальный" + chr(4) + "" + chr(8)
      478    + "status_" + chr(4) + "Статус" + chr(4) + "" + chr(8)
      479    + "tax-code" + chr(4) + "Код" + chr(4) + "" + chr(8)
      480    + "tax-name" + chr(4) + "Название" + chr(4) + "" + chr(8)
      481    + "tax-type" + chr(4) + "Тип" + chr(4) + "" + chr(8)
      482    + "to-cashdesk" + chr(4) + "Посылать ли на кассу" + chr(4) + ""  .
      483    run proc-full-temp-changes in this-procedure (
      484                                                input  (buf_c-tax-hist.action = integer('1':U))
      485                                               ,input  (buf_c-tax-hist.action = integer('99':U))
      486                                               ,input  buffer current_c-tax:handle
      487                                               ,input  'tax':U
      488                                               ,input  "individual,status_,tax-code,tax-name,tax-type,to-cashdesk"
      489                                               ,input  v-label-param).
      490   end.
      491   end procedure.
      492   procedure tax-rate-value-proc :
      493   define output parameter p-description as character no-undo .
      494   define variable v-first as logical no-undo .
      495   define variable v-tooltip as character no-undo .
      496   define variable v-label as character no-undo .
      497   define variable v-is-created as logical no-undo .
      498   define variable v-old-rate-value like ub.tax-rate-value.rate-value no-undo .
      499   define variable v-new-rate-value like ub.tax-rate-value.rate-value no-undo .
      500   define variable v-field-name as character no-undo .
      501   define variable v-field-function as character no-undo .
      502   define variable jj as integer no-undo .
      503   define variable v-field-label  as character no-undo .
      504   define variable v-field-list as character no-undo .
      505   define buffer curr_c-tax-rate-value for ub.tax-rate-value  .
      506   define buffer prev_c-tax-rate-value for ub.tax-rate-value.
      507   define buffer buf_tax for ub.tax.
      508     do
      509     on error undo, return error
      510     :
      511       find first buf_tax no-lock where buf_tax.tax-code = p-tax-code .
      512       assign
      513       p-description = substitute("&1, ставка &2", buf_tax.tax-name, p-rate-code)
      514       .
      515       find first curr_c-tax-rate-value no-lock where
      516                 curr_c-tax-rate-value.tax-code =  p-tax-code
      517              AND curr_c-tax-rate-value.rate-code = p-rate-code
      518              AND curr_c-tax-rate-value.host-code = p-host-code
      519              AND curr_c-tax-rate-value.obj-type = p-obj-type
      520              AND curr_c-tax-rate-value.obj-code  = p-obj-code
      521              AND curr_c-tax-rate-value.chip-num = p-chip-num
      522              AND curr_c-tax-rate-value.corr-user-db-num = p-corr-user-db-num
      523              no-error .
      524       if available curr_c-tax-rate-value then do:
      525         find last prev_c-tax-rate-value no-lock where
      526                     prev_c-tax-rate-value.tax-code = p-rate-code
      527                 AND prev_c-tax-rate-value.rate-code = p-rate-code
      528                 AND prev_c-tax-rate-value.host-code = p-host-code
      529                 AND prev_c-tax-rate-value.obj-type = p-obj-type
      530                 AND prev_c-tax-rate-value.obj-code  = p-obj-code
      531                 AND prev_c-tax-rate-value.fact-order < curr_c-tax-rate-value.fact-order
      532                 no-error.
      533         if not avail prev_c-tax-rate-value then do:
      534           assign
      535           v-first = yes
      536           .
      537         end.
      538       end.
      539       if available curr_c-tax-rate-value
      540       and available prev_c-tax-rate-value then do:
      541         buffer-compare curr_c-tax-rate-value except chip-num corr-date corr-time corr-user-name corr-user-db-num corr-time
      542         to prev_c-tax-rate-value
      543         save result in v-chg-fields.
      544       end.
      545       else do:
      546         assign
      547         v-chg-fields =  "rate-value,fact-date" .
      548       end.
      549   _ii:
      550     do ii = 1 to num-entries(v-chg-fields):
      551       assign
      552       v-field-name = entry(ii, v-chg-fields)
      553       jj = lookup(v-field-name, "rate-value,fact-date,status_").
      554       if jj = 0 then next _ii.
      555       assign
      556       v-field-label = entry(jj, "Значение,Дата включения,Статус")
      557       v-field-function = entry(jj, ",,")
      558       .
      559       create temp-changes.
      560       assign
      561       temp-changes.f_name = v-field-name
      562       temp-changes.l_name = v-field-label
      563       temp-changes.v_old =  (if (v-first or temp-changes.f_name  <> "rate-value")
      564                              then '':U
      565                             else  (if temp-changes.f_name = "rate-value":U
      566                                    then string(v-old-rate-value)
      567                                    else  string(buffer prev_c-tax-rate-value:buffer-field(v-field-name):buffer-value)
      568                                    )
      569                             )
      570       temp-changes.v_new =  if available curr_c-tax-rate-value
      571                             then string(buffer curr_c-tax-rate-value:buffer-field(v-field-name):buffer-value)
      572                             else chr(63)
      573       .
      574       if v-field-function <> '':U then do:
      575         assign
      576         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
      577         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
      578         .
      579       end.
      580     end.
      581   end.
      582   end procedure.
      583   procedure tax-rate-proc :
      584   define output parameter p-description as character no-undo .
      585   define buffer current_c-tax-rate for ub.c-tax-rate  .
      586   define buffer buf_tax for ub.tax.
      587     do
      588     on error undo, return error
      589     :
      590       find first buf_tax no-lock where buf_tax.tax-code = p-tax-code .
      591       assign
      592       p-description = substitute("&1, ставка &2", buf_tax.tax-name, p-rate-code)
      593       .
      594       find first current_c-tax-rate no-lock where
      595                  current_c-tax-rate.tax-code = p-tax-code
      596              AND current_c-tax-rate.rate-code = p-rate-code
      597              AND current_c-tax-rate.chip-num = p-chip-num
      598              AND current_c-tax-rate.corr-user-db-num = p-corr-user-db-num
      599              no-error .
      600       if not avail current_c-tax-rate then do:
      601          v-mess = "Неверная ссылка на c-tax-rate в таблице c-tax-hist".
      602          run err-mess in this-procedure ( input-output v-mess ).
      603          return error (if p-silent then v-mess else '':U).
      604       end.
      605   define variable v-label-param as character no-undo .
      606   v-label-param =
      607     "rate-code" + chr(4) + "Код ставки" + chr(4) + "" + chr(8)
      608    + "rate-name" + chr(4) + "Название" + chr(4) + "" + chr(8)
      609    + "status_" + chr(4) + "Статус" + chr(4) + "" + chr(8)
      610    + "tax-code" + chr(4) + "Код налога" + chr(4) + ""  .
      611    run proc-full-temp-changes in this-procedure (
      612                                                input  (buf_c-tax-hist.action = integer('1':U))
      613                                               ,input  (buf_c-tax-hist.action = integer('99':U))
      614                                               ,input  buffer current_c-tax-rate:handle
      615                                               ,input  'tax-rate':U
      616                                               ,input  "rate-code,rate-name,status_,tax-code"
      617                                               ,input  v-label-param).
      618   end.
      619   end procedure.
      620   procedure tax-units-proc :
      621   define output parameter p-description as character no-undo .
      622   define buffer current_c-tax-units for ub.c-tax-units  .
      623     do
      624     on error undo, return error
      625     :
      626       find first current_c-tax-units no-lock where
      627                  current_c-tax-units.tax-code = p-tax-code
      628              AND current_c-tax-units.TYPE = buf_c-tax-hist.type
      629              AND current_c-tax-units.chip-num = p-chip-num
      630              AND current_c-tax-units.corr-user-db-num = p-corr-user-db-num
      631              no-error .
      632       if not avail current_c-tax-units then do:
      633          v-mess = "Неверная ссылка на c-tax-units в таблице c-tax-hist".
      634          run err-mess in this-procedure ( input-output v-mess).
      635          return error (if p-silent then v-mess else '':U).
      636       end.
      637   define variable v-label-param as character no-undo .
      638   v-label-param =
      639     "type" + chr(4) + "Тип" + chr(4) + "" + chr(8)
      640    + "tax-code" + chr(4) + "Код налога" + chr(4) + ""  .
      641    run proc-full-temp-changes in this-procedure (
      642                                                input  (buf_c-tax-hist.action = integer('1':U))
      643                                               ,input  (buf_c-tax-hist.action = integer('99':U))
      644                                               ,input  buffer current_c-tax-units:handle
      645                                               ,input  'tax-units':U
      646                                               ,input  "type,tax-code"
      647                                               ,input  v-label-param).
      648   end.
      649   end procedure.
      650   PROCEDURE err-mess:
      651     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      652     CASE p-silent:
      653       when yes then do:
      654         assign
      655         p-mess =
      656         substitute("История налога &1 ставка &2: щепка &3 БД:&4 фирма: &5 объект &6&7 Предмет изменений &8",
      657                    p-tax-code, p-rate-code,  p-chip-num, p-corr-user-db-num, p-host-code, p-obj-type, p-obj-code, p-subject) +
      658                    chr(10) + p-mess.
      659       end.
      660       otherwise do:
      661         message
      662         p-mess
      663         view-as alert-box error .
      664       end.
      665     end.
      666   END PROCEDURE.
