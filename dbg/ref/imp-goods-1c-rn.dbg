     1649   procedure create-smart-route-link :
     1650   define input parameter p-tbl-name as character no-undo .
     1651   define input parameter p-bh_tbl-name as handle no-undo .
     1652   define input parameter p-key-field as character no-undo .
     1653   define input parameter p-rec-ord as integer no-undo .
     1654   define input parameter p-is-smart as logical no-undo .
     1655   define variable v-key-rec as character no-undo .
     1656   define buffer buf_temp-smart-link for temp-smart-link.
     1657     do
     1658     on error undo, return error
     1659     :
     1660       run gen-key-rec in this-procedure ( input p-tbl-name
     1661                                          ,input p-bh_tbl-name
     1662                                          ,output v-key-rec     ).
     1663      find first buf_temp-smart-link where
     1664                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1665              and buf_temp-smart-link.key-field = p-key-field
     1666              and buf_temp-smart-link.rec-ord = p-rec-ord
     1667              no-error .
     1668      if not available buf_temp-smart-link then do:
     1669        create buf_temp-smart-link.
     1670        assign
     1671        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1672        buf_temp-smart-link.key-field = p-key-field
     1673        buf_temp-smart-link.rec-ord = p-rec-ord
     1674        buf_temp-smart-link.is-smart = p-is-smart
     1675        .
     1676      end.
     1677     end.
     1678   end procedure.
     1679   procedure create-nws-outline :
     1680   define input parameter p-cmd-proc-handle as handle no-undo .
     1681   define input parameter p-cmd-code as integer no-undo .
     1682   define input parameter p-outline-type as character no-undo .
     1683   define input parameter p-charkey_one as character no-undo .
     1684   define input parameter p-charkey_two as character no-undo .
     1685   define input parameter p-charkey_three as character no-undo .
     1686   define input parameter p-key#_one as integer no-undo .
     1687   define input parameter p-key#_two as integer no-undo .
     1688   define input parameter p-key#_three as integer no-undo .
     1689   define variable v-no-id as integer no-undo .
     1690   define variable v-rec-ord as integer no-undo .
     1691     do
     1692     on error undo, return error return-value
     1693     :
     1694       find last temp-nws-outline use-index pi no-error .
     1695       v-no-id = (if available temp-nws-outline
     1696                  then (temp-nws-outline.no-id  + 1)
     1697                  else 1).
     1698       create temp-nws-outline.
     1699       assign
     1700       temp-nws-outline.charkeY_one = p-charkey_one
     1701       temp-nws-outline.charkeY_two = p-charkey_two
     1702       temp-nws-outline.charkeY_three = p-charkey_three
     1703       temp-nws-outline.key#_one = p-key#_one
     1704       temp-nws-outline.key#_two = p-key#_two
     1705       temp-nws-outline.key#_three = p-key#_three
     1706       temp-nws-outline.no-id = v-no-id
     1707       temp-nws-outline.outline-type = p-outline-type
     1708       .
     1709                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1710       run  create-smart-route in this-procedure (
     1711                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1712                                                  ,input -1).
     1713       run create-smart-route-link in this-procedure (
     1714                                                      input 'nws-outline':U
     1715                                                     ,input (buffer temp-nws-outline:handle)
     1716                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1717                                                     ,input v-rec-ord
     1718                                                     ,input no
     1719                                                     ).
     1720     end.
     1721   end procedure.
     1722   procedure create-no-route :
     1723   define input parameter p-rec-ord as integer no-undo .
     1724   define input parameter p-db-num as integer no-undo .
     1725   define buffer buf_temp-no-route for temp-no-route.
     1726   do
     1727   on error undo, return error
     1728   :
     1729      find first buf_temp-no-route where
     1730                 buf_temp-no-route.rec-ord = p-rec-ord
     1731              and buf_temp-no-route.db-num = p-db-num no-error .
     1732      if not available buf_temp-no-route then do:
     1733        create buf_temp-no-route.
     1734        assign
     1735        buf_temp-no-route.rec-ord = p-rec-ord
     1736        buf_temp-no-route.db-num = p-db-num
     1737        .
     1738      end.
