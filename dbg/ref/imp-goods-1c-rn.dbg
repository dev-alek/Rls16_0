     7377   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
     7378   define variable v-param-types   as character  no-undo.
     7379   define variable v-value-char    as character  no-undo.
     7380   define variable v-val-date      as date       no-undo.
     7381   define variable v-val-decimal   as decimal    no-undo.
     7382   define variable v-val-integer   as integer    no-undo.
     7383   define variable v-val-logical   as logical    no-undo.
     7384   define variable v-tthd          as handle     no-undo.
     7385   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
     7386   PROCEDURE imagelist_loaddef:
     7387       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
     7388       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
     7389       ASSIGN
     7390           vPar-val  = "":U
     7391           vPar-type = "":U
     7392           .
     7393   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7394     (input  'photo':u
     7395     ,input  '':u
     7396     ,input  '':u
     7397     ,input  0
     7398     ,input  '':u
     7399     ,input  '':u
     7400     ,input  '':u
     7401     ,input  no
     7402     ,output vPar-val
     7403     ,output vPar-type
     7404     ) no-error .
     7405           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
     7406       IF mImagePh THEN .
     7407       ELSE RETURN.
     7408       ASSIGN
     7409           vPar-val  = "":U
     7410           vPar-type = "":U
     7411           .
     7412   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7413     (input  'ph-dir':u
     7414     ,input  '':u
     7415     ,input  '':u
     7416     ,input  0
     7417     ,input  '':u
     7418     ,input  '':u
     7419     ,input  '':u
     7420     ,input  NO
     7421     ,output vPar-val
     7422     ,output vPar-type
     7423     ) no-error .
     7424       IF LENGTH (vPar-val) = 0 THEN
     7425           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
     7426       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
     7427       ASSIGN
     7428           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
     7429           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
     7430           mImagePreDir = mImagePath
     7431           mImageDir    = mImagePreDir
     7432           mImageTrash  = mImagePath + "trash\":U
     7433           .
