     6589       assign
     6590       tt-tax.rate-code = v-nds-rate-code
     6591       .
     6592       if    v-gds-mode = 'ИЗМЕНЕНИЕ':U
     6593         and (   p-GdsObj:prod-code ne buf_goods.prod-code
     6594              or p-GdsObj:artic     ne buf_goods.artic )
