     7443           ,input  'shema-foto':U
     7444           ,output v-value-char
     7445           ,output v-val-date
     7446           ,output v-val-decimal
     7447           ,output v-val-integer
     7448           ,output v-val-logical
     7449           ,output v-param-types
     7450           ,INPUT-OUTPUT table-handle v-tthd
