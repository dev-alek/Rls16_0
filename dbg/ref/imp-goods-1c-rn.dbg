     6444     parparentproc = this-procedure:handle .
     6445     v-unit-spl-code = p-GdsObj:unit-spl-code no-error.
     6446     if v-unit-spl-code = ? or v-unit-spl-code = "" then v-unit-spl-code = p-GdsObj:unit-code .
     6447     find first ub.clients no-lock where ub.clients.db-num   = ibs.th.gbl.gbl-var:g#db-num
     6448                                     and ub.clients.obj-type = 'маг':U
     6449                                     and ub.clients.stts = 0  no-error.
     6450     if not available ub.clients
     6451     then do:
     6452         undo, return error substitute("Не найден ни один активный магазин для бд &1", ibs.th.gbl.gbl-var:g#db-num ) .
     6453     end.
     6454     for first buf_gds-prt field (node-code) no-lock
     6455         where buf_gds-prt.root = true
     6456           and buf_gds-prt.node-name = '_Пустая шкала':U :
     6457         assign
     6458           v-node-code = buf_gds-prt.node-code
     6459           v-ok = yes
     6460         .
     6461     end.
     6462     if not v-ok
     6463     then do:
     6464         undo, return error substitute("&1 не найдена", '_Пустая шкала':U ) .
     6465     end.
     6466     v-gds-code = integer(p-GdsObj:code_) .
     6467     find first buf_goods no-lock where buf_goods.gds-code = v-gds-code no-error.
     6468     if not available buf_goods
     6469     then do :
     6470       find first ub.prod-bc no-lock where ub.prod-bc.b-str = string(v-gds-code) no-error .
     6471       if available (ub.prod-bc) then do:
     6472         find first ub.goods no-lock where ub.goods.gds-code = ub.prod-bc.b-code no-error .
     6473         v-err-mess = substitute(
     6474           "Уже есть товар &1 &2 с доп. кодом &3 - товар &3 &4 не будет добавлен в систему &5"
     6475           , ub.goods.gds-code
     6476           , ub.goods.gds-name
     6477           , v-gds-code
     6478           , p-GdsObj:name_
     6479           , chr(10)
     6480         ) .
     6481          undo, return error v-err-mess .
     6482       end.
     6483         assign
     6484           v-gds-mode = 'ДОБАВЛЕНИЕ':U
     6485           v-rid = ?
     6486         .
     6487     end.
     6488     else do :
     6489         assign
     6490           v-gds-mode = 'ИЗМЕНЕНИЕ':U
     6491           v-rid = recid(buf_goods)
     6492         .
     6493     end.
     6494     find first buf_units no-lock where buf_units.unit-name = p-GdsObj:unit-code no-error.
     6495     if not available buf_units
     6496     then do :
     6497         undo, return error ("Нет единицы измерения " + p-GdsObj:unit-code) .
     6498     end.
     6499     assign v-is-petrl = ( if lookup( 'топ':U, buf_units.type ) > 0 then yes else no ).
     6500     if lookup( 'шту':U, buf_units.type ) = 0 then do:
     6501         if v-is-petrl = yes and lookup( 'дро':U, buf_units.type ) = 0 then do:
     6502           undo, return error substitute( 'Неверная связка типов единиц измерения для топлива: "&1" .',
     6503                                          buf_units.type ).
     6504         end.
     6505     end.
     6506     if p-GdsObj:gds-type = "н" and not v-is-petrl
     6507     then do :
     6508         undo, return error ("Тип товара в файле - нефтепродукт, но указана нетопливная единица измерения. Товар с кодом " + p-GdsObj:code_) .
     6509     end.
     6510   v-nds-rate-code = ? .
     6511   if p-GdsObj:nds-code = -1 then
     6512   do:
     6513     for each buf_tax-rate-attr no-lock where buf_tax-rate-attr.tax-code = integer('1':U)
     6514       and buf_tax-rate-attr.attr-code = "envd":
     6515       find last ub.tax-rate-value no-lock where ub.tax-rate-value.rate-code = buf_tax-rate-attr.rate-code
     6516         and ub.tax-rate-value.tax-code = integer('1':U)
     6517         and ub.tax-rate-value.status_ <> 'удал':U
     6518         use-index i-status no-error .
     6519       if available ub.tax-rate-value and v-nds-rate-code = ? then v-nds-rate-code = ub.tax-rate-value.rate-code .
     6520     end.
     6521   end.
     6522   else
     6523   do:
     6524     for each ub.tax-rate-value no-lock where ub.tax-rate-value.rate-value = p-GdsObj:nds-code
     6525       and ub.tax-rate-value.tax-code = integer('1':U)
     6526       and ub.tax-rate-value.status_ <> 'удал':U
     6527       use-index i-status by ub.tax-rate-value.corr-date desc:
     6528       if available ub.tax-rate-value then
     6529       do:
     6530         if p-GdsObj:nds-code <> 0 and v-nds-rate-code = ? then
     6531         do:
     6532           v-nds-rate-code = ub.tax-rate-value.rate-code .
     6533         end.
     6534         else do:
     6535           find first buf_tax-rate-attr no-lock where buf_tax-rate-attr.tax-code = integer('1':U)
     6536           and buf_tax-rate-attr.attr-code = "envd" and buf_tax-rate-attr.rate-code = ub.tax-rate-value.rate-code no-error .
     6537           if not available (buf_tax-rate-attr) and v-nds-rate-code = ? then v-nds-rate-code = ub.tax-rate-value.rate-code .
     6538         end.
     6539       end.
     6540     end.
