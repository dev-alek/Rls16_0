     7512             ,output v-value-integer
     7513             ,output v-value-logical
     7514             ,output v-param-type
     7515             ,INPUT-OUTPUT table-handle v-tth
     7516             ) no-error .
     7517       delete object v-tth no-error.
     7518       if trim(v-value-character) > ""
     7519       then do :
     7520         v-dir1-name = trim(v-value-character, "\") .
