     7532         os-create-dir value(right-trim(v-dir1-name, "\")) .
     7533         if os-error <> 0 then do:
     7534           v-err-mess = substitute("Невозможно создать директорию &1 для изображений &2&3&2&4"
     7535                                       , v-dir1-name
