     4930   FIELD to-cashdesk like ub.tax.to-cashdesk
     4931   FIELD fact-date like ub.tax-rate-value.fact-date
     4932   FIELD fact-order like ub.tax-rate-value.fact-order
     4933   FIELD next-order like ub.tax-rate-value.fact-order
     4934   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
     4935   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
     4936   FIELD corr-date like ub.tax-rate-gds.corr-date
