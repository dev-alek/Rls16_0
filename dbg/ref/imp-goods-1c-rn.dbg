     6669                     , input ""
     6670                     , input v-unit-spl-code
     6671                     , input p-GdsObj:unit-k
     6672                     , input ?
     6673                     , input ""
     6674                     , input no
     6675                     , input no
     6676                     , input no
     6677                     , input yes
     6678                     , input "no"
     6679                     , input no
     6680                     , input no
     6681                     , input no
     6682                     , input 2
     6683                     , input-output v-rid
     6684                     , output v-nbc
     6685                   ) no-error .
     6686     if error-status :error then do:
     6687         v-err-mess = substitute("Ошибка при сохранении goods &1&2&3&2&4"
     6688                                   , p-GdsObj:code_
     6689                                   , chr(10)
     6690                                   , error-status:get-message(1)
     6691                                   , replace(return-value,chr(4)," ") ).
     6692         undo, return error v-err-mess .
     6693     end.
     6694     find first ub.goods no-lock where ub.goods.gds-code = v-gds-code no-error.
     6695     if available ub.goods then do:
     6696       run fill-gds-list in mImp2CdH ( buffer ub.goods).
     6697     end.
     6698     if v-nbc = 0 or v-nbc = ? then v-nbc = v-gds-code .
     6699     if p-GdsObj:fuel-type eq ? or p-GdsObj:fuel-type =  0
     6700     then v-fuel-type = ? .
     6701     else do:
     6702        v-fuel-type = entry(p-GdsObj:fuel-type,'petrol,diesel-sum,diesel-wint,metan,propan,lgas,diesel,arctic,megsesson':U) no-error.
     6703        if error-status :error then do:
     6704        v-err-mess = substitute("Ошибка при сохранении goods &1&2 Неизвестный тип топлива &3"
     6705                                   , p-GdsObj:code_
     6706                                   , chr(10)
     6707                                   ,p-GdsObj:fuel-type ).
     6708         undo, return error v-err-mess .
     6709     end.
     6710     end.
     6711     if v-fuel-type <> ?
     6712     then do :
     6713       RUN gds-attr-write (v-nbc, 'fuel-type':U, v-fuel-type).
     6714     end.
     6715     else do :
     6716       RUN gds-attr-delete (v-nbc, 'fuel-type':U, output v-attr-del).
     6717     end.
     6718     if v-is-petrl then RUN gds-attr-write (v-nbc, 'dflt-insalepr':U, 'yes').
     6719     case p-GdsObj:srvc-type :
     6720       when 1 then v-srvc-type = 'oss-pay':U.
     6721       when 2 then v-srvc-type = 'card-act':U .
     6722       when 3 then v-srvc-type = 'tso-ret':U .
     6723       otherwise v-srvc-type = ? .
     6724     end case.
     6725     if v-srvc-type <> ?
     6726     then do :
     6727       RUN gds-attr-write (v-nbc, 'office-type':U, v-srvc-type).
     6728     end.
     6729     else do :
     6730       RUN gds-attr-delete (v-nbc, 'office-type':U, output v-attr-del).
     6731     end.
     6732     v-mark-type = MarkType:GetNameProp(p-GdsObj:mark-type) no-error.
     6733     if v-mark-type <> ?
     6734     and v-mark-type <> "not-type"
     6735     and v-mark-type <>  "Unknow"
     6736     then do :
     6737       RUN gds-attr-write (v-nbc, 'mark-type':U, v-mark-type).
     6738     end.
     6739     else do :
     6740       RUN gds-attr-delete (v-nbc, 'mark-type':U, output v-attr-del).
     6741     end.
     6742     if p-GdsObj:emc-type <> ?
     6743     then do :
     6744       define variable mEMRC as character no-undo.
     6745       define variable mOK as logical no-undo.
     6746       define variable merror-code as character no-undo.
     6747       mEMRC = trim(string(int64(p-GdsObj:emc-type),">>>>>>>>>>>>>>>>999")) no-error.
     6748       if error-status:error
     6749       then
     6750          mEMRC = p-GdsObj:emc-type.
     6751       run gds-attr_check-emrc-type(v-nbc,
     6752                                 'emrc-type':U,
     6753                                 mEMRC,
     6754                                 'ИЗМЕНЕНИЕ':U,
     6755                                 output mOK,
     6756                                 output merror-code).
     6757       if not mOK
     6758       then
     6759          undo, return error
     6760                   (merror-code + " Товар " + p-GdsObj:code_) .
     6761       find first ub.goods-attr no-lock where ub.goods-attr.gds-code  = v-gds-code
     6762                                and ub.goods-attr.attr-code = "emrc-type"
     6763                                and ub.goods-attr.attr-value = mEMRC no-error.
     6764       if not available ub.goods-attr then s-gds-code = v-gds-code.
     6765       RUN gds-attr-write (v-nbc, 'emrc-type':U, mEMRC).
     6766       find first ub.goods no-lock where ub.goods.gds-code = s-gds-code no-error.
     6767             if available ub.goods then do:
     6768                run fill-g-list in mImp2CdH ( input ub.goods.gds-code, input ?, input ?).
     6769             end.
     6770     end.
     6771     else do :
     6772       RUN gds-attr-delete (v-nbc, 'emrc-type':U, output v-attr-del).
     6773     end.
     6774     if p-GdsObj:IS18Plus = 1
     6775     then do:
     6776       RUN gds-attr-write (v-nbc, 'IS18Plus':U, p-GdsObj:IS18Plus).
     6777     end.
     6778     if p-GdsObj:IS18Plus = 0 or p-GdsObj:IS18Plus = ?
     6779     then do:
     6780        RUN gds-attr-delete (v-nbc, 'IS18Plus':U, output v-attr-del).
     6781     end.
     6782     if p-GdsObj:loyalty-gift = 1
     6783      then do:
     6784        RUN gds-attr-write (v-nbc, 'loyalty-gift':U, p-GdsObj:loyalty-gift).
     6785        run fill-g-list in mImp2CdH ( input v-nbc, input ?, input ?).
     6786     end.
     6787     if p-GdsObj:loyalty-gift = 0 or p-GdsObj:loyalty-gift = ?
     6788      then do:
     6789       RUN gds-attr-delete (v-nbc, 'loyalty-gift':U, output v-attr-del).
     6790       run fill-g-list in mImp2CdH ( input v-nbc, input ?, input ?).
     6791     end.
     6792     if p-GdsObj:oil-grp <> ?
     6793     then do:
     6794       RUN gds-attr-write (v-nbc, 'group-np':U, p-GdsObj:oil-grp).
     6795     end.
     6796     else do:
     6797       RUN gds-attr-delete (v-nbc, 'group-np':U, output v-attr-del).
     6798     end.
     6799     if p-GdsObj:gds-type = "б":U then do:
     6800          for each buf-clients no-lock where buf-clients.db-num = g#db-num
     6801                                     and buf-clients.obj-type = 'маг':U
     6802                                     and buf-clients.stts = 0 :
     6803              find first  fbr-gds-obj where fbr-gds-obj.gds-code =  v-nbc
     6804                                           and fbr-gds-obj.obj-type = buf-clients.obj-type
     6805                                           and fbr-gds-obj.obj-code = buf-clients.obj-code
     6806                                           no-lock no-error.
     6807              par-recid-fbr    =  if available fbr-gds-obj then recid(fbr-gds-obj) else ?.
     6808              run ref/fgdsobj1.p (
     6809                               input-output par-recid-fbr
     6810                           , input (if available fbr-gds-obj
     6811                                       then 'ИЗМЕНЕНИЕ':U
     6812                                       else 'ДОБАВЛЕНИЕ':U)
     6813                           , input no
     6814                           , input v-nbc
     6815                           , input buf-clients.obj-type
     6816                           , input buf-clients.obj-code
     6817                           , input if available fbr-gds-obj then fbr-gds-obj.fbr-grp-code else 0
     6818                           , input buf-clients.obj-type
     6819                           , input buf-clients.obj-code
     6820                           , input if available fbr-gds-obj then fbr-gds-obj.is-cd else no
     6821                           , input true
     6822                           , input if available fbr-gds-obj then fbr-gds-obj.is-modificator else no
     6823                           , input if available fbr-gds-obj then fbr-gds-obj.is-null-price else no
     6824                           , input if available fbr-gds-obj then fbr-gds-obj.is-season else no
     6825                           , input if available fbr-gds-obj then fbr-gds-obj.is-semi-finished else no
     6826                           ) no-error.
     6827          end.
     6828     end.
     6829     DEFINE TEMP-TABLE ttKF NO-UNDO
     6830     FIELD bar_code  AS INTEGER
     6831     FIELD unit_code AS CHARACTER
     6832     FIELD coef      AS INTEGER.
     6833     v-barcode-list = "" .
     6834     v-barcodes = p-GdsObj:barcode .
     6835     if valid-object (v-barcodes)
     6836     then do :
     6837         find base-bar-code no-lock where
     6838              base-bar-code.b-code = v-nbc.
     6839         find ub.goods no-lock where
     6840              ub.goods.gds-code = base-bar-code.gds-code.
     6841         find ub.gds-prt no-lock where
     6842              ub.gds-prt.node-code = base-bar-code.node-code.
     6843         ii_ :
     6844         do ii = 1 to v-barcodes:iCounter:
     6845           v-barcodes:Get(ii) .
     6846           v-barcode = cast (v-barcodes:SubjectObjCurr, goods_barcode).
     6847            find first buf_units no-lock where buf_units.unit-name = v-barcode:unit-code no-error.
     6848            if not available buf_units
     6849            then do :
     6850            undo, return error ("Нет единицы измерения " + v-barcode:unit-code) .
     6851            end.
     6852            if lookup( 'топ':U, buf_units.type ) > 0 and length(v-barcode:bcode) > 2 then do:
     6853            undo, return error substitute( 'Для топливной ед. измерения невозможно создать баркод  &1 .', v-barcode:bcode ).
     6854            end.
     6855            if length (v-barcode:bcode) <= 2
     6856            then do :
     6857                 next ii_ .
     6858               end.
     6859           v-barcode-list = v-barcode-list + v-barcode:bcode + "," .
     6860           v-bc-mode = "".
     6861           find first ub.prod-bc exclusive-lock where ub.prod-bc.b-str = v-barcode:bcode no-error.
     6862           if not available ub.prod-bc
     6863           then do :
     6864               v-bc-mode = 'ДОБАВЛЕНИЕ':U .
     6865           end.
     6866           else do :
     6867               find first ub.bar-code no-lock where ub.bar-code.b-code = ub.prod-bc.b-code no-error .
     6868               if not available ub.bar-code
     6869               then do :
     6870                   undo, return error
     6871                   ("Ошибка при определении баркода для собственного кода " +
     6872                    v-barcode:bcode + " . Товар " + p-GdsObj:code_) .
     6873               end.
     6874               else do :
     6875                 if ub.bar-code.gds-code = v-gds-code
     6876                 and ub.bar-code.unit-cli = v-barcode:unit-code
     6877                 then do :
     6878                 CREATE ttKF.
     6879                 ASSIGN
     6880                 ttKF.bar_code   = ub.bar-code.b-code
     6881                 ttKF.unit_code  = v-barcode:unit-code
     6882                 ttKF.coef       = v-barcode:coeff
     6883                 .
     6884                     ub.prod-bc.bc-on = true .
     6885                     ub.prod-bc.bc-on-type = (if p-GdsObj:gds-type = "н" then 'ptlc':U else if v-barcode:barcode-type = 1 then 'GTIN':U else "").
     6886                     v-b-str = v-barcode:bcode .
     6887                     def var vmaken as logical no-undo.
     6888                     vmaken = if v-barcode:barcode-type = 2 then yes else no.
     6889                     find first prod-bc-attr where prod-bc-attr.b-str     eq v-b-str
     6890                                               and prod-bc-attr.b-code    eq bar-code.b-code
     6891                                              and prod-bc-attr.attr-code eq 'mark':U
     6892                     no-lock no-error.
     6893                    if not available prod-bc-attr
     6894                    then do:
     6895                       create prod-bc-attr.
     6896                       assign
     6897                          prod-bc-attr.b-str  = v-b-str
     6898                          prod-bc-attr.b-code = bar-code.b-code
     6899                          prod-bc-attr.attr-code = 'mark':U
     6900                          prod-bc-attr.attr-value = string(vmaken)
     6901                       .
     6902                    end.
     6903                    else if prod-bc-attr.attr-value ne string(vmaken)
     6904                    then do:
     6905                       find current prod-bc-attr exclusive-lock no-error.
     6906                       if available prod-bc-attr
     6907                       then
     6908                          prod-bc-attr.attr-value = string(vmaken).
     6909                    end.
     6910                     v-rid-pbc = recid(ub.prod-bc).
     6911                     if    ub.prod-bc.bc-on
     6912                       and send-ref
     6913                     then do:
     6914                        run fill-pbc-list in mImp2CdH
     6915                        (v-rid-pbc,
     6916                        bar-code.gds-code,
     6917                        prod-bc.b-code,
     6918                        prod-bc.b-str,
     6919                        prod-bc.bc-on,
     6920                        no).
     6921                     end.
     6922                     next ii_ .
     6923                 end.
     6924                 else do :
     6925                   delete ub.prod-bc no-error .
     6926                   if error-status:error
     6927                   then do :
     6928                     undo, return error
     6929                     ("Ошибка при удалении собственного кода " +
     6930                      v-barcode:bcode + " товара " + string(ub.bar-code.gds-code) + " для перепривязки его к товару " + p-GdsObj:code_) .
     6931                   end .
     6932                   v-bc-mode = 'ДОБАВЛЕНИЕ':U .
     6933                 end.
     6934               end.
     6935               if v-bc-mode = "" then v-bc-mode = 'ИЗМЕНЕНИЕ':U .
     6936           end.
     6937           if ub.goods.unit-base <> v-barcode:unit-code and v-bc-mode = 'ДОБАВЛЕНИЕ':U
     6938           then do :
     6939               find first ub.bar-code where ub.bar-code.gds-code = v-gds-code
     6940                                        and ub.bar-code.unit-cli = v-barcode:unit-code
     6941                                        no-error.
     6942               if not available ub.bar-code
     6943               then do :
     6944                 CREATE ttKF.
     6945                 ASSIGN
     6946                 ttKF.bar_code   = v-gds-code
     6947                 ttKF.unit_code  = v-barcode:unit-code
     6948                 ttKF.coef       = v-barcode:coeff
     6949                 .
     6950                 run ref/barcode1.p (
     6951                                        input v-bc-mode
     6952                                       ,input yes
     6953                                       ,input ""
     6954                                       ,input ub.goods.gds-code
     6955                                       ,input ub.gds-prt.node-code
     6956                                       ,input base-bar-code.part-code
     6957                                       ,input base-bar-code.in-code
     6958                                       ,input v-barcode:unit-code
     6959                                       ,input v-barcode:coeff
     6960                                       ,output v-bc-rid) no-error.
     6961                   if error-status :error
     6962                   then do :
     6963                       v-err-mess = substitute("Ошибка при сохранении бар-кода &1&2&3&2&4"
     6964                                           , v-barcode:bcode
     6965                                           , chr(10)
     6966                                           , error-status:get-message(1)
     6967                                           , return-value ).
     6968                       undo, return error v-err-mess .
     6969                   end.
     6970                   find first ub.bar-code where recid(ub.bar-code) = v-bc-rid.
     6971                   if send-ref
     6972                   then do:
     6973                      run fill-bar-code in mImp2CdH (
     6974                                                   input   ub.bar-code.b-code
     6975                                                  ,input   ub.bar-code.gds-code
     6976                                                  ,input  (if  ub.bar-code.stts_ = integer('99':U)
     6977                                                           then yes
     6978                                                           else no)
     6979                                                  ,input   ub.bar-code.node-code
     6980                                                  ,input   ub.bar-code.in-code
     6981                                                  ,input   ub.bar-code.part-code
     6982                                                  ,input   ub.bar-code.cli-base-rate
     6983                                                  ,input   ub.bar-code.unit-cli
     6984                                                   ) no-error.
     6985                   end.
     6986               end.
     6987               else do:
     6988                 run ref/barcode1.p (
     6989                    input 'ИЗМЕНЕНИЕ':U
     6990                   ,input yes
     6991                   ,input ""
     6992                   ,input ub.goods.gds-code
     6993                   ,input ub.gds-prt.node-code
     6994                   ,input base-bar-code.part-code
     6995                   ,input base-bar-code.in-code
     6996                   ,input v-barcode:unit-code
     6997                   ,input v-barcode:coeff
     6998                   ,output v-bc-rid
     6999                 ) no-error.
     7000                 if error-status :error
     7001                 then do :
     7002                    v-err-mess = substitute("Ошибка при обновлении бар-кода &1&2&3&2&4"
     7003                                           , v-barcode:bcode
     7004                                           , chr(10)
     7005                                           , error-status:get-message(1)
     7006                                           , return-value ).
     7007                    undo, return error v-err-mess .
     7008                 end.
     7009               end.
     7010               v-b-str = v-barcode:bcode .
     7011               run trg/prod-bc2.p (
     7012                                    input  parparentproc
     7013                                   ,input yes
     7014                                   ,input ?
     7015                                   ,input ?
     7016                                   ,input send-ref
     7017                                   ,input (if p-GdsObj:gds-type = "н" then 'ptlc':U else if v-barcode:barcode-type = 1 then 'GTIN':U else "")
     7018                                   ,input ""
     7019                                   ,buffer ub.goods
     7020                                   ,input ub.bar-code.b-code
     7021                                   ,input (if v-barcode:barcode-type = 2 then yes else no)
     7022                                   ,input-output v-b-str
     7023                                   ,output v-rid-pbc
     7024                                   ) no-error.
     7025               if error-status :error
     7026               or v-rid-pbc = ? then do:
     7027                 v-err-mess = substitute("Ошибка при сохранении бар-кода &1&2&3&2&4"
     7028                                       , v-barcode:bcode
     7029                                       , chr(10)
     7030                                       , error-status:get-message(1)
     7031                                       , return-value ).
     7032                   undo, return error v-err-mess .
     7033               end.
     7034               else do:
     7035                 find first buf_prod-bc no-lock
     7036                       where recid(buf_prod-bc) = v-rid-pbc.
     7037                 if  buf_prod-bc.bc-on
     7038                 and send-ref
     7039                 then do:
     7040                    run fill-pbc-list in mImp2CdH
     7041                        (v-rid-pbc,
     7042                        ub.bar-code.gds-code,
     7043                        buf_prod-bc.b-code,
     7044                        buf_prod-bc.b-str,
     7045                        buf_prod-bc.bc-on,
     7046                        no).
     7047                 end.
     7048               end.
     7049           end.
     7050           if ub.goods.unit-base = v-barcode:unit-code
     7051           then do :
     7052               v-b-str = v-barcode:bcode .
     7053               run trg/prod-bc2.p (
     7054                                    input  parparentproc
     7055                                   ,input yes
     7056                                   ,input ?
     7057                                   ,input ?
     7058                                   ,input send-ref
     7059                                   ,input (if p-GdsObj:gds-type = "н" then 'ptlc':U else if v-barcode:barcode-type = 1 then 'GTIN':U else "")
     7060                                   ,input ""
     7061                                   ,buffer ub.goods
     7062                                   ,input base-bar-code.b-code
     7063                                   ,input (if v-barcode:barcode-type = 2 then yes else no)
     7064                                   ,input-output v-b-str
     7065                                   ,output v-rid-pbc
     7066                                   ) no-error.
     7067               if error-status :error
     7068               or v-rid-pbc = ? then do:
     7069                 v-err-mess = substitute("Ошибка при сохранении бар-кода &1&2&3&2&4"
     7070                                       , v-barcode:bcode
     7071                                       , chr(10)
     7072                                       , error-status:get-message(1)
     7073                                       , return-value ).
     7074                   undo, return error v-err-mess .
     7075               end.
     7076               else do:
     7077                 find first buf_prod-bc no-lock
     7078                       where recid(buf_prod-bc) = v-rid-pbc.
     7079                 if  buf_prod-bc.bc-on
     7080                 and send-ref
     7081                 then do:
     7082                       run fill-pbc-list in mImp2CdH
     7083                        (v-rid-pbc,
     7084                        ub.goods.gds-code,
     7085                        buf_prod-bc.b-code,
     7086                        buf_prod-bc.b-str,
     7087                        buf_prod-bc.bc-on,
     7088                        no).
     7089                 end.
     7090               end.
     7091           end.
     7092         end.
     7093     end.
     7094     for each buf_bar-code no-lock where buf_bar-code.gds-code = v-gds-code,
     7095       each buf_prod-bc exclusive-lock where buf_prod-bc.b-code = buf_bar-code.b-code :
     7096        if lookup( buf_prod-bc.b-str, v-barcode-list ) = 0
     7097           and length (buf_prod-bc.b-str) > 2
     7098        then do :
     7099          buf_prod-bc.bc-on = false .
     7100                    run fill-pbc-list in mImp2CdH
     7101                        (v-rid-pbc,
     7102                        v-gds-code,
     7103                        buf_prod-bc.b-code,
     7104                        buf_prod-bc.b-str,
     7105                        buf_prod-bc.bc-on,
     7106                        no).
     7107        end.
     7108     end.
     7109      DEFINE VARIABLE current-coef AS INTEGER   NO-UNDO.
     7110      DEFINE VARIABLE unit-list    AS CHARACTER NO-UNDO.
     7111      DEFINE TEMP-TABLE ttToDel
     7112      FIELD unit_code AS CHARACTER.
     7113      FOR EACH ttKF NO-LOCK
     7114          BREAK BY ttKF.unit_code:
     7115          IF FIRST-OF(ttKF.unit_code) THEN DO:
     7116              ASSIGN current-coef = ttKF.coef.
     7117          END.
     7118          IF ttKF.coef <> current-coef THEN DO:
     7119               CREATE ttToDel.
     7120               ttToDel.unit_code = ttKF.unit_code .
     7121              LEAVE.
     7122          END.
     7123      END.
     7124       unit-list = "" .
     7125       FOR EACH ttToDel:
     7126       FOR EACH ttKF WHERE ttToDel.unit_code = ttKF.unit_code:
     7127           unit-list = unit-list + ttToDel.unit_code + " = " + string(ttKF.coef) + " " .
     7128           DELETE ttKF.
     7129       END.
     7130       END.
     7131       run str/imp2cdgeth.p(output mImp2CdH).
     7132       FOR EACH ttKF:
     7133       FIND FIRST ub.bar-code exclusive-lock WHERE ub.bar-code.b-code = ttKF.bar_code no-error.
     7134           if available (ub.bar-code) then do:
     7135               find first ub.goods no-lock where ub.bar-code.gds-code = ub.goods.gds-code
     7136                    and ub.bar-code.unit-cli <> goods.unit-base no-error.
     7137                  if available ub.goods
     7138                  then  do:
     7139                     ub.bar-code.cli-base-rate = ttKF.coef .
     7140                     run fill-g-list in mImp2CdH  ( input ub.goods.gds-code, input ?, input ?).
     7141                  END.
     7142           END.
     7143       END.
