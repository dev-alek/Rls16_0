     1815   procedure get-gate-file-name :
     1816   define input parameter p-gate-rec as character no-undo .
     1817   define output  parameter p-gate-file-name as character no-undo .
     1818   define buffer buf_clob-data for ub.clob-data.
     1819   define variable v-tbl-row as rowid no-undo .
     1820   define variable v-tbl-name as character no-undo .
     1821   run gen-row-keyr in this-procedure ( input p-gate-rec
     1822                                       ,input ?
     1823                                       ,input "ub"
     1824                                       ,input ?
     1825                                       ,input no-lock
     1826                                       ,output v-tbl-row
     1827                                       ,output v-tbl-name) no-error.
     1828   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1829                                                           ,vss-include-info12
     1830                                                           ,p-gate-rec).
     1831   find first buf_clob-data no-lock where
     1832             rowid(buf_clob-data) = v-tbl-row no-error.
     1833   if not available buf_clob-data then do:
     1834     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1835                                                             ,vss-include-info12
     1836                                                             ,p-gate-rec).
     1837   end.
     1838   p-gate-file-name = buf_clob-data.file-name.
     1839   end procedure.
     1840   procedure get-gate-rec :
     1841   define input  parameter p-gate-name as character no-undo .
     1842   define output parameter p-gate-rec as character no-undo .
     1843   define buffer buf_clob-bind for ub.clob-bind.
     1844   define buffer buf_clob-data for ub.clob-data.
     1845   main-block:
     1846   do
     1847   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1))
     1848   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info12 )
     1849   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info12 )
     1850   :
     1851       find first buf_clob-bind no-lock where
     1852                 buf_clob-bind.uniq-key-rec = p-gate-name
     1853             and buf_clob-bind.field-name = '':U
     1854             and buf_clob-bind.part-num = 1
     1855             and buf_clob-bind.resource-type = 'gate':U
     1856             no-error.
     1857       if not available buf_clob-bind then do:
     1858         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1859                                         , p-gate-name
     1860                                         ).
     1861       end.
     1862       find first buf_clob-data no-lock where
     1863                 buf_clob-data.db-num = buf_clob-bind.db-num
     1864             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1865       if not available buf_clob-data then do:
     1866         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1867                                         , buf_clob-bind.db-num
     1868                                         , buf_clob-bind.int64-id
     1869                                         , p-gate-name
     1870                                         ).
     1871       end.
     1872       run gen-key-rec in this-procedure ( input 'clob-data':U
     1873                                 ,input buffer buf_clob-data:handle
     1874                                 ,output p-gate-rec).
     1875   end.
     1876   end procedure.
     1877   procedure get-gate-by-name :
     1878   define input  parameter p-gate-name as character no-undo .
     1879   define output parameter p-gate-rec as character no-undo .
     1880   define output parameter p-dsh as handle no-undo .
     1881   define input-output  parameter p-xmlh as handle no-undo .
     1882   define variable v-ii as integer   no-undo .
     1883   define variable glog as logical   no-undo .
     1884   define variable v-longchar as longchar no-undo .
     1885   define variable v-txmlh as handle no-undo .
     1886   define variable v-db-num as integer no-undo .
     1887   define variable v-int64-id as int64 no-undo .
     1888   define buffer buf_clob-bind for ub.clob-bind.
     1889   define buffer buf_clob-data for ub.clob-data.
     1890   main-block:
     1891   do
     1892   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1))
     1893   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info12 )
     1894   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info12 )
     1895   :
     1896       find first buf_clob-bind no-lock where
     1897                 buf_clob-bind.uniq-key-rec = p-gate-name
     1898             and buf_clob-bind.field-name = '':U
     1899             and buf_clob-bind.part-num = 1
     1900             and buf_clob-bind.resource-type = 'gate':U
     1901             no-error.
     1902       if not available buf_clob-bind then do:
     1903         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1904                                         , p-gate-name
     1905                                         ).
     1906       end.
     1907       find first buf_clob-data no-lock where
     1908                 buf_clob-data.db-num = buf_clob-bind.db-num
     1909             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1910       if not available buf_clob-data then do:
     1911         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1912                                         , buf_clob-bind.db-num
     1913                                         , buf_clob-bind.int64-id
     1914                                         , p-gate-name
     1915                                         ).
     1916       end.
     1917       assign
     1918       v-longchar = buf_clob-data.cdata
     1919       .
     1920       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1921       if error-status :error then do:
     1922         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1923       end.
     1924       create dataset p-dsh .
     1925       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1926                                     , v-longchar
     1927                                     , ?
     1928                                     , ?
     1929                                     , ?
     1930                                     ) no-error.
     1931       v-longchar = '':U.
     1932       if error-status :error
     1933       or not glog
     1934       then do:
     1935         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1936       end.
     1937       if not valid-handle(p-xmlh)
     1938       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1939         create temp-table v-txmlh.
     1940         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1941         v-txmlh:temp-table-prepare("temp-xml-tables").
     1942         p-xmlh = v-txmlh:default-buffer-handle.
     1943       end.
     1944       run gen-key-rec in this-procedure ( input 'clob-data':U
     1945                                 ,input buffer buf_clob-data:handle
     1946                                 ,output p-gate-rec).
     1947       do v-ii = 1 to p-dsh:num-buffers:
     1948         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1949         if not p-xmlh:available then do:
     1950           p-xmlh:buffer-create().
     1951           assign
     1952           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1953           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1954           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1955           p-xmlh::gate-handle_ = p-dsh
     1956           p-xmlh::uniq-gate-rec = p-gate-rec
     1957           p-xmlh::gate-name = p-dsh:name
     1958           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1959           .
     1960           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1961             assign
     1962             p-xmlh::order = -3.
     1963           end.
     1964         end.
     1965       end.
     1966   end.
     1967   end procedure.
     1968   procedure get-gate-by-rec :
     1969   define input  parameter p-gate-rec as character no-undo .
     1970   define output parameter p-dsh as handle no-undo .
     1971   define input-output  parameter p-xmlh as handle no-undo .
     1972   define input-output parameter p-longchar  as longchar no-undo .
     1973   define variable v-ii as integer   no-undo .
     1974   define variable glog as logical   no-undo .
     1975   define variable v-rowid as rowid no-undo .
     1976   define variable v-tbl-name as character no-undo .
     1977   define variable v-longchar as longchar no-undo .
     1978   define variable v-txmlh as handle no-undo .
     1979   define buffer buf_clob-data for ub.clob-data.
     1980   main-block:
     1981   do
     1982   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1))
     1983   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info12 )
     1984   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info12 )
     1985   :
     1986     run gen-row-keyr in this-procedure (
     1987                                           input  p-gate-rec
     1988                                           ,input  ?
     1989                                           ,input  "ub"
     1990                                           ,input  ?
     1991                                           ,input  NO-LOCK
     1992                                           ,output v-rowid
     1993                                           ,output v-tbl-name   ) no-error.
     1994       find first buf_clob-data no-lock where
     1995                 rowid(buf_clob-data) = v-rowid  no-error.
     1996       if not available buf_clob-data then do:
     1997         undo, return error substitute("Не найден CLOB  &1"
     1998                                         , p-gate-rec
     1999                                         ).
     2000       end.
     2001       assign
     2002       v-longchar = buf_clob-data.cdata
     2003       .
     2004       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2005       if error-status :error then do:
     2006         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2007       end.
     2008       create dataset p-dsh .
     2009       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2010                                     , v-longchar
     2011                                     , ?
     2012                                     , ?
     2013                                     , ?
     2014                                     ) no-error.
     2015       define variable v-esm as character no-undo .
     2016       v-esm = error-status:get-message(1) .
     2017       if p-longchar <> ? then do:
     2018         p-longchar = v-longchar.
     2019       end.
     2020       v-longchar = '':U.
     2021       if error-status :error
     2022       or not glog
     2023       then do:
     2024         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2025                                      , p-gate-rec
     2026                                      , p-gate-rec
     2027                                      , v-esm
     2028                                      ).
     2029       end.
     2030       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     2031       if not valid-handle(p-xmlh)
     2032       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2033         create temp-table v-txmlh.
     2034         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2035         v-txmlh:temp-table-prepare("temp-xml-tables").
     2036         p-xmlh = v-txmlh:default-buffer-handle.
     2037       end.
     2038       do v-ii = 1 to p-dsh:num-buffers:
     2039         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2040         if not p-xmlh:available then do:
     2041           p-xmlh:buffer-create().
     2042           assign
     2043           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2044           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2045           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2046           p-xmlh::gate-handle_ = p-dsh
     2047           p-xmlh::uniq-gate-rec = p-gate-rec
     2048           p-xmlh::gate-name = p-dsh:name
     2049           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2050           .
     2051           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2052             assign
     2053             p-xmlh::order = -3.
     2054           end.
     2055           p-xmlh:buffer-release().
     2056         end.
     2057       end.
     2058   end.
     2059   end procedure.
     2060   procedure get-gate-by-file :
     2061   define input  parameter p-schema-file-name as character no-undo .
     2062   define input  parameter p-gate-rec as character no-undo .
     2063   define output parameter p-dsh as handle no-undo .
     2064   define input-output  parameter p-xmlh as handle no-undo .
     2065   define variable v-ii as integer   no-undo .
     2066   define variable glog as logical   no-undo .
     2067   define variable v-rowid as rowid no-undo .
     2068   define variable v-tbl-name as character no-undo .
     2069   define variable v-longchar as longchar no-undo .
     2070   define variable v-txmlh as handle no-undo .
     2071   main-block:
     2072   do
     2073   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1))
     2074   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info12 )
     2075   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info12 )
     2076   :
     2077       COPY-LOB
     2078       FROM  FILE p-schema-file-name
     2079       TO  OBJECT v-longchar
     2080       no-convert
     2081       NO-ERROR .
     2082       if error-status :error then do:
     2083           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     2084                                     , p-schema-file-name
     2085                                 , chr(10)
     2086                                 , error-status:get-message(1) ).
     2087       end.
     2088       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2089       if error-status :error then do:
     2090         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     2091       end.
     2092       create dataset p-dsh .
     2093       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     2094                                     , v-longchar
     2095                                     , ?
     2096                                     , ?
     2097                                     , ?
     2098                                     ) no-error.
     2099       v-longchar = ''.
     2100       if error-status :error
     2101       or not glog
     2102       then do:
     2103         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     2104                                      , p-schema-file-name
     2105                                      ,chr(10)
     2106                                      , error-status:get-message(1)
     2107                                      ).
     2108       end.
     2109       if not valid-handle(p-xmlh)
     2110       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2111         create temp-table v-txmlh.
     2112         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2113         v-txmlh:temp-table-prepare("temp-xml-tables").
     2114         p-xmlh = v-txmlh:default-buffer-handle.
     2115       end.
     2116       do v-ii = 1 to p-dsh:num-buffers:
     2117         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     2118                                      ,p-dsh:get-buffer-handle(v-ii):name
     2119                                      ,p-gate-rec
     2120                                      )) no-error.
     2121         if not p-xmlh:available then do:
     2122           p-xmlh:buffer-create().
     2123           assign
     2124           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     2125           p-xmlh::uniq-gate-rec = p-gate-rec
     2126           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2127           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2128           p-xmlh::gate-handle_ = p-dsh
     2129           p-xmlh::gate-name = p-dsh:name
     2130           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2131           .
     2132           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2133             assign
     2134             p-xmlh::order = -3.
     2135           end.
     2136           p-xmlh:buffer-release().
     2137         end.
     2138       end.
     2139   end.
     2140   end procedure.
     2141   procedure gate-clear :
     2142   define input  parameter p-dsh as handle no-undo .
     2143   define input  parameter p-xmlh as handle no-undo .
     2144   define variable v-dsh as handle no-undo .
     2145   define variable v-th as handle no-undo .
     2146     do
     2147     on error undo, return error return-value
     2148     :
     2149       if valid-handle(p-dsh) then do:
     2150         delete object p-dsh.
     2151         v-dsh = p-dsh.
     2152         p-dsh = ?.
     2153       end.
     2154       repeat while true:
     2155         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     2156                            , share-lock) no-error.
     2157         if p-xmlh:available then do:
     2158           assign
     2159           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     2160           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     2161           and valid-handle(v-th)
     2162           and v-th:dynamic = yes
     2163           then do:
     2164             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     2165             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     2166           end.
     2167           p-xmlh:buffer-delete().
     2168         end.
     2169         else do:
     2170           leave.
     2171         end.
     2172       end.
     2173       if p-xmlh:dynamic = yes
     2174       and valid-handle(p-xmlh)
     2175       then do:
     2176         delete object p-xmlh:table-handle.
     2177         p-xmlh = ?.
     2178       end.
     2179       v-dsh = ?.
     2180     end.
     2181   end procedure.
     2182   procedure all-gates-clear :
     2183   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     2184   do
     2185   on error undo, return error
     2186   :
     2187     for each buf_temp-xml-tables
     2188     break
     2189     by buf_temp-xml-tables.uniq-gate-rec
     2190     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2191     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2192     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2193     :
     2194         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     2195           delete object buf_temp-xml-tables.gate-handle_.
     2196           buf_temp-xml-tables.gate-handle_ = ?.
     2197         end.
     2198         if valid-handle(buf_temp-xml-tables.table-handle_)
     2199         and buf_temp-xml-tables.table-handle_:dynamic = no
     2200         then do:
     2201           delete object buf_temp-xml-tables.table-handle_.
     2202           buf_temp-xml-tables.table-handle_ = ?.
     2203         end.
     2204         delete buf_temp-xml-tables.
     2205     end.
     2206   end.
     2207   end procedure.
     2208   procedure fix-schemalocation :
     2209   define input-output  parameter p-longchar as longchar no-undo .
     2210   DEFINE VARIABLE hdoc AS HANDLE.
     2211   DEFINE VARIABLE hroot AS HANDLE.
     2212   DEFINE VARIABLE hnode-child AS HANDLE.
     2213   DEFINE VARIABLE hnode-attr AS HANDLE.
     2214   define variable v-jj as integer   no-undo .
     2215   define variable ok as logical   no-undo .
     2216   define variable v-path1                    as character                no-undo .
     2217   DEFINE VARIABLE v-full-path1               as character                no-undo .
     2218   DEFINE VARIABLE v-file-name1               as character                no-undo .
     2219   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     2220   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     2221   define variable v-schema-location          as character                no-undo .
     2222   do
     2223   on error undo, return error return-value
     2224   :
     2225     CREATE X-DOCUMENT hdoc.
     2226     CREATE X-noderef hroot.
     2227     CREATE X-noderef hnode-child.
     2228     CREATE X-noderef hnode-attr.
     2229     hdoc:load("longchar", p-longchar, no) no-error.
     2230     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     2231     hdoc:get-document-element(hroot).
     2232     _repeat:
     2233     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     2234       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     2235       if not ok then next.
     2236       if hNode-Child:local-name = "include"
     2237       then do:
     2238         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     2239           v-schema-location = hnode-attr:node-value.
     2240           run gbl/filename.p (
     2241                           input "exe/" + hnode-attr:node-value
     2242                         ,output v-full-path1
     2243                         ,output v-path1
     2244                         ,output v-file-name1
     2245                         ,output v-file-name-no-ext1
     2246                         ,output v-file-name-ext1
     2247                         ) no-error .
     2248           if error-status :error then do:
     2249             delete object hnode-attr.
     2250             delete object hnode-child.
     2251             delete object hroot.
     2252             delete object hdoc.
     2253             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     2254           end.
     2255         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     2256         leave  _repeat.
     2257       end.
     2258     END.
     2259     hdoc:save("longchar", p-longchar).
     2260     delete object hnode-attr.
     2261     delete object hnode-child.
     2262     delete object hroot.
     2263     delete object hdoc.
     2264   end.
     2265   end procedure.
     2266   procedure gate-clb_fill-xml-tables :
     2267   define input parameter p-dsh as handle no-undo .
     2268   define input-output parameter p-xmlh as handle no-undo .
     2269   define variable v-ii as integer no-undo .
     2270     do
     2271     on error undo, return error
     2272     :
     2273       do v-ii = 1 to p-dsh:num-buffers:
     2274         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2275         if not p-xmlh:available then do:
     2276           p-xmlh:buffer-create().
     2277           assign
     2278           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2279           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2280           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2281           p-xmlh::gate-handle_ = p-dsh
     2282           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     2283           p-xmlh::gate-name = p-dsh:name
     2284           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2285           .
     2286           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2287             assign
     2288             p-xmlh::order = -3.
     2289           end.
     2290           p-xmlh:buffer-release().
     2291         end.
     2292       end.
     2293     end.
     2294   end procedure.
     2295   procedure all-gates-empty :
     2296   define buffer buf_temp-xml-tables for temp-xml-tables.
     2297   do
     2298   on error undo, return error
     2299   :
     2300     for each buf_temp-xml-tables
     2301     break
     2302     by buf_temp-xml-tables.uniq-gate-rec
     2303     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2304     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2305     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2306     :
     2307       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     2308         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     2309       end.
     2310     end.
     2311   end.
     2312   end procedure.
     2313   define variable vss-include-info15 as character format "X(65)" no-undo
     2314   initial "@(#)$Workfile$ $Revision$".
     2315   define temp-table temp_grplib_grp no-undo
     2316       field sel           as character
     2317       field nabor         as character
     2318       field full-name     as character
     2319       field print-code    as character
     2320       field sort-name     as character
     2321       field node-code     as integer
     2322       field upper-code    as integer
     2323       field calc-method   as character
     2324       field round-method  as character
     2325       field increase-pc   as decimal
     2326       field min-marg      as character
     2327       field max-marg      as character
     2328       field cli-type      as character
     2329       field cli-code      as integer
     2330       field notcorr      as character
     2331       field name          as character
     2332       field level         as integer
     2333       field mark          as character
     2334       index pi is primary unique sort-name
     2335       index fn full-name
     2336       index nc is unique node-code
     2337       index sl sel
     2338       index uc upper-code
     2339   .
     2340   define temp-table temp_grplib_found-grp no-undo
     2341       field full-name   as character
     2342       field sort-name   as character
     2343       field node-code   as integer
     2344       field level       as integer
     2345       field is-terminal as logical
     2346       index pi is primary unique sort-name
     2347       index fn full-name
     2348       index lv level
     2349       index it is-terminal
     2350   .
     2351   define temp-table temp_found-result-nodelist no-undo
     2352       field node-code     as recid
     2353       field processed     as logical
     2354       field sort-name     as character
     2355       field full-name     as character
     2356       index pi is primary unique node-code
     2357       index ps processed
     2358   .
     2359   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     2360   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     2361   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     2362   procedure grplib-get-parameters :
     2363   define input parameter p-store-type     as character        no-undo.
     2364   define input parameter p-store-code     as integer          no-undo.
     2365   do
     2366   on error undo, return error
     2367   :
     2368       assign
     2369           v-grplib-not-fill-extra-info = no
     2370       .
     2371   end.
     2372   end procedure.
     2373   procedure grplib-get-sort-name :
     2374   do
     2375   on error undo, return error
     2376   :
     2377   define input parameter p-node-code  as integer      no-undo.
     2378   define output parameter p-sort-name as character    no-undo.
     2379       define variable v-upper-code    as integer           no-undo.
     2380       define buffer buf_gds-grp       for ub.gds-grp.
     2381       define buffer buf_upper_gds-grp for ub.gds-grp.
     2382       find first buf_gds-grp no-lock
     2383            where buf_gds-grp.node-code = p-node-code
     2384       no-error.
     2385       if not available buf_gds-grp
     2386       then do:
     2387           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2388       end.
     2389       assign
     2390           p-sort-name  = ""
     2391           v-upper-code = 1
     2392       .
     2393       do while buf_gds-grp.upper-code <> 0
     2394       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     2395       :
     2396           assign
     2397               p-sort-name  = buf_gds-grp.node-name
     2398                            + (if p-sort-name <> "" then chr(2) else "")
     2399                            + p-sort-name
     2400               v-upper-code = buf_gds-grp.upper-code
     2401           .
     2402           find first buf_gds-grp no-lock
     2403                where buf_gds-grp.node-code = v-upper-code
     2404           no-error.
     2405           if not available buf_gds-grp
     2406           then do:
     2407               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     2408                                   + string( v-upper-code )
     2409                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2410           end.
     2411       end.
     2412   end.
     2413   end procedure.
     2414   define variable vss-include-info16 as character format "X(65)" no-undo
     2415   initial "@(#)$Workfile$ $Revision$".
     2416   procedure grplib-get-full-name :
     2417      define input parameter p-node-code  as integer      no-undo.
     2418      define output parameter p-full-name as character    no-undo.
     2419      do
     2420   on error undo, return error
     2421   :
     2422       define variable v-upper-code    as integer           no-undo.
     2423       define buffer buf_gds-grp       for ub.gds-grp.
     2424       define buffer buf_upper_gds-grp for ub.gds-grp.
     2425       find first buf_gds-grp no-lock
     2426            where buf_gds-grp.node-code = p-node-code
     2427       no-error.
     2428       if not available buf_gds-grp
     2429       then do:
     2430           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2431       end.
     2432       assign
     2433           p-full-name  = ""
     2434           v-upper-code = 1
     2435       .
     2436       do while buf_gds-grp.upper-code <> 0
     2437       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2438       :
     2439           assign
     2440               p-full-name  = buf_gds-grp.node-name
     2441                            + (if p-full-name <> "" then chr(47) else "")
     2442                            + p-full-name
     2443               v-upper-code = buf_gds-grp.upper-code
     2444           .
     2445           find first buf_gds-grp no-lock
     2446                where buf_gds-grp.node-code = v-upper-code
     2447           no-error.
     2448           if not available buf_gds-grp
     2449           then do:
     2450               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2451                                   + string( v-upper-code )
     2452                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2453           end.
     2454       end.
     2455       assign
     2456       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2457       .
     2458   end.
     2459   end .
     2460   procedure grplib-get-node-from-full-name :
     2461   define input parameter p-full-name as character no-undo .
     2462   define output parameter p-node-code as integer no-undo .
     2463   define variable v-ii as integer no-undo .
     2464   define variable v-upper-code as integer no-undo .
     2465   define variable v-root-code as integer no-undo .
     2466   define variable v-entry as character no-undo .
     2467   define buffer buf_gds-grp       for ub.gds-grp.
     2468   do
     2469   on error undo, return error
     2470   :
     2471     find first buf_gds-grp no-lock
     2472         where buf_gds-grp.upper-code = 0
     2473     no-error .
     2474     if not available buf_gds-grp
     2475     then do:
     2476         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2477     end.
     2478     else do:
     2479       assign
     2480       v-root-code = buf_gds-grp.node-code
     2481       .
     2482     end.
     2483     v-upper-code = v-root-code.
     2484     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2485       assign
     2486       v-entry = entry(v-ii, p-full-name, chr(47)).
     2487       if v-entry = '' then leave.
     2488       find first buf_gds-grp no-lock where
     2489                 buf_gds-grp.node-name = v-entry
     2490             and buf_gds-grp.upper-code = v-upper-code
     2491             no-error.
     2492       if not available buf_gds-grp then do:
     2493         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2494       end.
     2495       else do:
     2496         p-node-code = buf_gds-grp.node-code.
     2497         v-upper-code = buf_gds-grp.node-code.
     2498       end.
     2499     end.
     2500   end.
     2501   end .
     2502   procedure grplib-get-root-code :
     2503   do
     2504   on error undo, return error
     2505   :
     2506   define output parameter p-root-code as integer      no-undo.
     2507       define buffer buf_gds-grp       for ub.gds-grp.
     2508       find first buf_gds-grp no-lock
     2509           where buf_gds-grp.upper-code = 0
     2510       no-error .
     2511       if not available buf_gds-grp
     2512       then do:
     2513           undo, return error .
     2514       end.
     2515       else do:
     2516           assign
     2517               p-root-code = buf_gds-grp.node-code
     2518           .
     2519       end.
     2520   end.
     2521   end procedure.
     2522   procedure grplib-find-grp-by-full-name :
     2523   do
     2524   on error undo, return error
     2525   :
     2526   define input parameter p-search-name  as character    no-undo.
     2527   define input parameter p-fill-path    as logical      no-undo.
     2528   define output parameter p-found       as logical      no-undo.
     2529       define variable v-upper-code    as integer          no-undo.
     2530       define variable v-counter       as integer           no-undo.
     2531       define variable v-level         as integer           no-undo.
     2532       define variable v-full-name     as character         no-undo.
     2533       define variable v-sort-name     as character         no-undo.
     2534       define buffer buf_gds-grp       for ub.gds-grp.
     2535       assign
     2536           p-search-name = replace( p-search-name, chr(47), chr(2) )
     2537       .
     2538       run grplib-get-root-code ( output v-upper-code ) no-error .
     2539       if error-status :error
     2540       then do:
     2541           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     2542       end.
     2543       assign
     2544           v-full-name  = ""
     2545           v-level      = num-entries( p-search-name, chr(2) )
     2546       .
     2547       for each temp_grplib_found-grp
     2548       :
     2549           delete temp_grplib_found-grp.
     2550       end.
     2551       start-name-analyze:
     2552       do v-counter = 1 to v-level
     2553       :
     2554           if v-counter < v-level
     2555           then do:
     2556               find first buf_gds-grp no-lock
     2557                    where buf_gds-grp.upper-code = v-upper-code
     2558                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     2559               no-error .
     2560               if not available buf_gds-grp
     2561               then do:
     2562                   assign
     2563                       v-full-name  = p-search-name
     2564                       v-sort-name  = p-search-name
     2565                   .
     2566                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     2567               end.
     2568               else do:
     2569                   assign
     2570                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     2571                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     2572                       v-upper-code = buf_gds-grp.node-code
     2573                   .
     2574                   if p-fill-path = yes
     2575                   then do:
     2576                       create temp_grplib_found-grp.
     2577                       assign
     2578                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     2579                           temp_grplib_found-grp.sort-name = v-sort-name
     2580                           temp_grplib_found-grp.node-code = v-upper-code
     2581                           temp_grplib_found-grp.level     = v-counter
     2582                       .
     2583                   end.
     2584               end.
     2585           end.
     2586           else do:
     2587               for each buf_gds-grp no-lock
     2588                  where buf_gds-grp.upper-code = v-upper-code
     2589                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     2590               :
     2591                   assign
     2592                       p-found = yes
     2593                   .
     2594                   create temp_grplib_found-grp.
     2595                   assign
     2596                       temp_grplib_found-grp.full-name = v-full-name
     2597                                                           + (if v-full-name = "" then "" else chr(47) )
     2598                                                           + buf_gds-grp.node-name + chr(47)
     2599                       temp_grplib_found-grp.sort-name = v-sort-name
     2600                                                           + ( if v-sort-name = "" then "" else chr(2) )
     2601                                                           + buf_gds-grp.node-name
     2602                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     2603                       temp_grplib_found-grp.level     = v-level
     2604                   .
     2605               end.
     2606               if p-found = no
     2607               then do:
     2608                   assign
     2609                       v-full-name  = p-search-name
     2610                       v-sort-name  = p-search-name
     2611                   .
     2612                   for each temp_grplib_found-grp
     2613                   :
     2614                       delete temp_grplib_found-grp.
     2615                   end.
     2616                   assign
     2617                       p-found = no
     2618                   .
     2619               end.
     2620           end.
     2621       end.
     2622   end.
     2623   end procedure.
     2624   procedure grplib-find-all-subgroup :
     2625   do
     2626   on error undo, return error
     2627   :
     2628   define input parameter p-start-node-code    as integer      no-undo.
     2629   define input parameter p-terminal-only      as logical      no-undo.
     2630       define variable v-start-full-name   as character     no-undo.
     2631       define variable v-start-sort-name   as character     no-undo.
     2632       define variable v-not-found         as logical       no-undo.
     2633       define variable v-is-terminal       as logical       no-undo.
     2634       define buffer buf_gds-grp           for ub.gds-grp.
     2635       create temp_found-result-nodelist.
     2636       assign
     2637           temp_found-result-nodelist.node-code = p-start-node-code
     2638           temp_found-result-nodelist.processed = no
     2639       .
     2640       run grplib-get-full-name in this-procedure (
     2641             input p-start-node-code
     2642           , output v-start-full-name
     2643       ).
     2644       run grplib-get-full-name in this-procedure (
     2645             input p-start-node-code
     2646           , output v-start-sort-name
     2647       ).
     2648       process-nodes:
     2649       do while yes
     2650       :
     2651           find first temp_found-result-nodelist
     2652                where temp_found-result-nodelist.node-code = p-start-node-code
     2653           .
     2654           assign
     2655               temp_found-result-nodelist.processed = yes
     2656           .
     2657           for each buf_gds-grp no-lock
     2658              where buf_gds-grp.upper-code = p-start-node-code
     2659           on error undo, return error
     2660           :
     2661               run grplib-is-terminal in this-procedure (
     2662                     input buf_gds-grp.node-code
     2663                   , output v-is-terminal
     2664               ).
     2665               if v-is-terminal = yes
     2666               then do:
     2667                   create temp_grplib_found-grp.
     2668                   assign
     2669                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2670                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     2671                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2672                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     2673                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     2674                       temp_grplib_found-grp.is-terminal = yes
     2675                   .
     2676               end.
     2677               else do:
     2678                   create temp_found-result-nodelist.
     2679                   assign
     2680                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     2681                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     2682                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     2683                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     2684                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     2685                       temp_found-result-nodelist.processed = no
     2686                   .
     2687                   if p-terminal-only = no
     2688                   then do:
     2689                       create temp_grplib_found-grp.
     2690                       assign
     2691                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2692                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     2693                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2694                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     2695                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     2696                           temp_grplib_found-grp.is-terminal = no
     2697                       .
     2698                   end.
     2699               end.
     2700           end.
     2701           find first temp_found-result-nodelist
     2702                where temp_found-result-nodelist.processed = no
     2703           no-error.
     2704           if not available temp_found-result-nodelist
     2705           then do:
     2706               leave process-nodes.
     2707           end.
     2708           else do:
     2709               assign
     2710                   p-start-node-code = temp_found-result-nodelist.node-code
     2711                   v-start-full-name = temp_found-result-nodelist.full-name
     2712                   v-start-sort-name = temp_found-result-nodelist.sort-name
     2713               .
     2714           end.
     2715       end.
     2716   end.
     2717   end procedure.
     2718   procedure grplib-expand-name :
     2719   define input parameter p-start-name as character        no-undo.
     2720   define output parameter p-end-name  as character        no-undo.
     2721       define variable v-is-terminal   as logical      no-undo.
     2722       define variable v-found         as character    no-undo.
     2723       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     2724   do
     2725   for buf_temp_grplib_found-grp
     2726   on error undo, return error
     2727   :
     2728       run grplib-find-grp-by-full-name in this-procedure (
     2729             input p-start-name
     2730           , input no
     2731           , output v-found
     2732       ) no-error.
     2733       run grplib-get-max-substring in this-procedure (
     2734                   input length( p-start-name )
     2735                 , output p-end-name
     2736       ) no-error .
     2737       if error-status :error
     2738       then do:
     2739           assign
     2740               p-end-name = ""
     2741           .
     2742       end.
     2743       else do:
     2744           find first temp_grplib_found-grp
     2745               where temp_grplib_found-grp.full-name = p-end-name
     2746           no-error.
     2747           if available temp_grplib_found-grp
     2748           then do:
     2749               find first buf_temp_grplib_found-grp
     2750                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     2751                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     2752               no-error.
     2753               if not available buf_temp_grplib_found-grp
     2754               then do:
     2755                   run grplib-is-terminal in this-procedure (
     2756                       input temp_grplib_found-grp.node-code
     2757                       , output v-is-terminal
     2758                   ).
     2759               end.
     2760           end.
     2761       end.
     2762   end.
     2763   end procedure.
     2764   procedure grplib-get-max-substring :
     2765   do
     2766   on error undo, return error
     2767   :
     2768   define input parameter p-min-substring-length   as integer      no-undo.
     2769   define output parameter p-substring             as character    no-undo.
     2770           define variable v-char-counter  as integer           no-undo.
     2771           define variable v-current-char  as character         no-undo.
     2772           define variable v-names-counter  as integer           no-undo.
     2773           define variable v-base-string   as character         no-undo.
     2774           assign
     2775               v-char-counter  = p-min-substring-length
     2776           .
     2777           find first temp_grplib_found-grp no-error.
     2778           if not available temp_grplib_found-grp
     2779           then do:
     2780               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     2781           end.
     2782           else do:
     2783               assign
     2784                   v-base-string  = temp_grplib_found-grp.full-name
     2785                   v-char-counter = 0
     2786               .
     2787               counter-block:
     2788               do while yes
     2789               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2790               :
     2791                   assign
     2792                       v-char-counter  = v-char-counter + 1
     2793                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2794                       v-names-counter = 0
     2795                   .
     2796                   compare-block:
     2797                   for each temp_grplib_found-grp
     2798                   :
     2799                       assign
     2800                           v-names-counter = v-names-counter + 1
     2801                       .
     2802                       if v-names-counter = 1
     2803                       then do:
     2804                           next compare-block.
     2805                       end.
     2806                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2807                       then do:
     2808                           leave counter-block.
     2809                       end.
     2810                   end.
     2811                   if v-names-counter = 1
     2812                   then do:
     2813                       assign
     2814                           p-substring = v-base-string
     2815                       .
     2816                       return.
     2817                   end.
     2818               end.
     2819               assign
     2820                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2821               .
     2822           end.
     2823   end.
     2824   end procedure.
     2825   procedure grplib-is-terminal :
     2826   do
     2827   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     2828   :
     2829   define input parameter p-node-code      as integer      no-undo.
     2830   define output parameter p-is-terminal   as logical      no-undo.
     2831       define buffer buf_gds-grp       for ub.gds-grp.
     2832       find first buf_gds-grp no-lock
     2833           where buf_gds-grp.upper-code = p-node-code
     2834       no-error .
     2835       if not available buf_gds-grp
     2836       then do:
     2837           assign
     2838               p-is-terminal = yes
     2839           .
     2840       end.
     2841       else do:
     2842           assign
     2843               p-is-terminal = no
     2844           .
     2845       end.
     2846   end.
     2847   end procedure.
     2848   procedure grplib-have-goods :
     2849   do
     2850   on error undo, return error
     2851   :
     2852   define input parameter p-node-code      as integer      no-undo.
     2853   define output parameter p-have-goods   as logical      no-undo.
     2854       define buffer buf_goods         for ub.goods.
     2855       find first buf_goods no-lock
     2856            where buf_goods.grp-code = p-node-code
     2857       no-error .
     2858       if available buf_goods
     2859       then do:
     2860           assign
     2861               p-have-goods = yes
     2862           .
     2863       end.
     2864       else do:
     2865           assign
     2866               p-have-goods = no
     2867           .
     2868       end.
     2869   end.
     2870   end procedure.
     2871   procedure grplib-find-by-substring :
     2872   do
     2873   on error undo, return error
     2874   :
     2875   define input parameter p-start-code         as integer      no-undo.
     2876   define input parameter p-full-search-string as character    no-undo.
     2877   define output parameter p-found-code        as integer      no-undo.
     2878   define output parameter p-full-name         as character    no-undo.
     2879       define variable v-start-code     as integer           no-undo.
     2880       define variable v-found          as logical  init no  no-undo.
     2881       define buffer buf_gds-grp       for ub.gds-grp.
     2882       search-grp:
     2883       for each buf_gds-grp no-lock
     2884           where buf_gds-grp.node-code > p-start-code
     2885       :
     2886           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     2887           then do:
     2888               assign
     2889                   p-found-code = buf_gds-grp.node-code
     2890                   v-found      = yes
     2891               .
     2892               run grplib-get-full-name in this-procedure (
     2893                     input p-found-code
     2894                   , output p-full-name
     2895               ) no-error .
     2896               if error-status :error
     2897               then do:
     2898                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2899               end.
     2900               leave search-grp.
     2901           end.
     2902       end.
     2903       if v-found = yes
     2904       then do:
     2905       end.
     2906       else do:
     2907           assign
     2908               p-full-name  = ""
     2909               p-found-code = 0
     2910           .
     2911       end.
     2912   end.
     2913   end procedure.
     2914   procedure grplib-analyze-grp-name :
     2915   do
     2916   on error undo, return error
     2917   :
     2918   define input parameter p-grp-name       as character            no-undo.
     2919   define input parameter p-upper-code     as integer              no-undo.
     2920   define output parameter p-error-message as character init ""    no-undo.
     2921       define variable v-char-list     as character    no-undo.
     2922       define variable v-char-counter  as integer      no-undo.
     2923       define variable v-full-name     as character    no-undo.
     2924       if p-grp-name = "" then do:
     2925           assign
     2926               p-error-message = "Название группы не может быть пустым.".
     2927           .
     2928       end.
     2929       else do:
     2930           assign
     2931               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2932           .
     2933           do v-char-counter = 1 to num-entries( v-char-list )
     2934           :
     2935               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2936               then do:
     2937                   assign
     2938                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2939                   .
     2940                   return.
     2941               end.
     2942           end.
     2943           if p-upper-code > 0
     2944           then do:
     2945               run grplib-get-full-name in this-procedure (
     2946                     input p-upper-code
     2947                   , output v-full-name
     2948               ) no-error .
     2949               if error-status :error
     2950               then do:
     2951                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     2952               end.
     2953               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     2954               then do:
     2955                   assign
     2956                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     2957                   .
     2958               end.
     2959           end.
     2960       end.
     2961   end.
     2962   end procedure.
     2963   procedure grplib-get-lvl-num :
     2964   define input parameter p-node-code  as integer      no-undo.
     2965   define output parameter p-lvl-num   as integer      no-undo.
     2966       define variable v-full-name    as character    no-undo.
     2967   do
     2968   on error undo, return error
     2969   :
     2970       run grplib-get-full-name in this-procedure (
     2971             input p-node-code
     2972           , output v-full-name
     2973       ).
     2974       assign
     2975           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     2976       .
     2977       if p-lvl-num = -1
     2978       then do:
     2979           assign
     2980               p-lvl-num = 0
     2981           .
     2982       end.
     2983   end.
     2984   end procedure.
     2985   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2986   define temp-table THpck-sent no-undo
     2987   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     2988   .
     2989   define temp-table THcurr-pack no-undo
     2990   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     2991   .
     2992   define temp-table THpck-rcvd no-undo
     2993   field THfilename as character
     2994   field THesys-id  as integer
     2995   field THcrc-pack as character
     2996   field THpack-num  as integer
     2997   field THrcvd-recs  as integer
     2998   field THrcvd as logical
     2999   field THtotal-recs  as integer
     3000   field THrcvddate  as date
     3001   field THrcvdtimeint as integer
     3002   field THrcvdtime  as character
     3003   index pi is unique primary
     3004   THesys-id
     3005   THpack-num
     3006   index rcvd
     3007   THesys-id
     3008   THrcvd
     3009   .
     3010   procedure get-header-by-rec :
     3011   define input  parameter p-gate-rec as character no-undo .
     3012   define output parameter p-tth as handle no-undo .
     3013   define variable v-ii as integer   no-undo .
     3014   define variable glog as logical   no-undo .
     3015   define variable v-rowid as rowid no-undo .
     3016   define variable v-tbl-name as character no-undo .
     3017   define variable v-longchar as longchar no-undo .
     3018   define variable v-txmlh as handle no-undo .
     3019   define buffer buf_clob-data for ub.clob-data.
     3020   main-block:
     3021   do
     3022   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info17, return-value, chr(10), error-status :get-message (1))
     3023   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info17 )
     3024   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info17 )
     3025   :
     3026     run gen-row-keyr in  this-procedure  (
     3027                                           input  p-gate-rec
     3028                                           ,input  ?
     3029                                           ,input  "ub"
     3030                                           ,input  ?
     3031                                           ,input  NO-LOCK
     3032                                           ,output v-rowid
     3033                                           ,output v-tbl-name   ) no-error.
     3034       find first buf_clob-data no-lock where
     3035                 rowid(buf_clob-data) = v-rowid  no-error.
     3036       if not available buf_clob-data then do:
     3037         undo, return error substitute("Не найден CLOB  &1"
     3038                                         , p-gate-rec
     3039                                         ).
     3040       end.
     3041       assign
     3042       v-longchar = buf_clob-data.cdata
     3043       .
     3044       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     3045       if error-status :error then do:
     3046         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     3047       end.
     3048       create temp-table p-tth .
     3049       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     3050                                     , v-longchar
     3051                                     , ?
     3052                                     , ?
     3053                                     , ?
     3054                                     ) no-error.
     3055       v-longchar = '':U.
     3056       define variable v-esm as character no-undo .
     3057       v-esm = error-status:get-message(1).
     3058       if error-status :error
     3059       or not glog
     3060       then do:
     3061         delete object p-tth no-error.
     3062         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     3063                                    , p-gate-rec
     3064                                    , buf_clob-data.file-name_
     3065                                    , chr(10)
     3066                                    , v-esm
     3067                                     ).
     3068       end.
     3069   end.
     3070   end procedure.
     3071   define variable vss-include-info18 as character format "X(65)" no-undo
     3072   initial "@(#)$Workfile$ $Revision$".
     3073   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3074   define stream stmXMLOut.
     3075   define stream stmXMLLog.
     3076   define stream strXMLIn.
     3077   define temp-table temp_xmllib_rec-list no-undo
     3078       field recName       as character
     3079       field recLevel      as integer
     3080       field recOpenLine   as integer
     3081       field recCloseLine  as integer
     3082       field closed        as logical
     3083       index pi is primary unique
     3084           recName
     3085           recLevel
     3086       index cl
     3087           closed
     3088   .
     3089   define temp-table temp_xmllib_rec-fld-list no-undo
     3090       field recName       as character
     3091       field recLevel      as integer
     3092       field fldName       as character
     3093       field fldOpenLine   as integer
     3094       field fldCloseLine  as integer
     3095       field closed        as logical
     3096       index pi is primary unique
     3097           recName
     3098           recLevel
     3099           fldName
     3100       index fn
     3101           fldName
     3102       index cl
     3103           closed
     3104   .
     3105   define temp-table temp_xmllib_rec no-undo
     3106       field rec-key       as integer
     3107       field recLevel      as integer
     3108       field recOpenLine   as integer
     3109       field recCloseLine  as integer
     3110       field recName       as character
     3111       field closed        as logical
     3112       index pi is primary unique
     3113           rec-key
     3114       index nm
     3115           recName
     3116           closed
     3117           rec-key
     3118       index cl
     3119           closed
     3120       index rlv
     3121           recName
     3122           recLevel
     3123           closed
     3124           rec-key
     3125   .
     3126   define temp-table temp_xmllib_rec-fld no-undo
     3127       field fld-key       as integer
     3128       field rec-key       as integer
     3129       field fldOpenLine   as integer
     3130       field fldCloseLine  as integer
     3131       field fldName       as character
     3132       field fldValue      as character
     3133       field closed        as logical
     3134       index pi is primary unique
     3135           fld-key
     3136       index nm
     3137           rec-key
     3138           fldName
     3139           closed
     3140           fld-key
     3141       index cl
     3142           closed
     3143   .
     3144   define variable v-xmllib-rec-key            as integer      no-undo .
     3145   define variable v-xmllib-rec-fld-key        as integer      no-undo .
     3146   define variable v-xmllib-dirname            as character    no-undo .
     3147   define variable v-xmllib-filename           as character    no-undo .
     3148   define variable v-xmllib-log-filename       as character    no-undo .
     3149   define variable v-xmllib-log-handle         as handle       no-undo .
     3150   define variable v-xmllib-log-proc-name      as character    no-undo .
     3151   define variable v-xmllib-error-status       as logical      no-undo .
     3152   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
     3153   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
     3154   define variable v-xmllib-codepage-convert   as logical      no-undo .
     3155   define variable v-xmllib-codepage-source    as character    no-undo .
     3156   define variable v-xmllib-codepage-target    as character    no-undo .
     3157   procedure xmllib-clear-parse-data :
     3158   do
     3159   on error undo, return error
     3160   :
     3161       empty temp-table temp_xmllib_rec-list.
     3162       empty temp-table temp_xmllib_rec-fld-list.
     3163       empty temp-table temp_xmllib_rec.
     3164       empty temp-table temp_xmllib_rec-fld.
     3165   end.
     3166   end procedure.
     3167   procedure xmllib-add-rec-fld :
     3168   define input parameter p-rec-name       as character        no-undo.
     3169   define input parameter p-rec-fld-name   as character        no-undo.
     3170       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3171       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3172   do
     3173   for buf_rec-list
     3174     , buf_rec-fld-list
     3175   on error undo, return error
     3176   :
     3177       find first buf_rec-list
     3178            where buf_rec-list.recName = p-rec-name
     3179       no-error.
     3180       if not available buf_rec-list
     3181       then do:
     3182           create buf_rec-list.
     3183           assign
     3184               buf_rec-list.recName        = p-rec-name
     3185               buf_rec-list.recOpenLine    = 0
     3186               buf_rec-list.recCloseLine   = 0
     3187               buf_rec-list.closed         = yes
     3188           .
     3189       end.
     3190       find first buf_rec-fld-list
     3191            where buf_rec-fld-list.recName = p-rec-name
     3192              and buf_rec-fld-list.fldName = p-rec-fld-name
     3193       no-error.
     3194       if not available buf_rec-fld-list
     3195       then do:
     3196           create buf_rec-fld-list.
     3197           assign
     3198               buf_rec-fld-list.recName        = p-rec-name
     3199               buf_rec-fld-list.fldName        = p-rec-fld-name
     3200               buf_rec-fld-list.fldOpenLine    = 0
     3201               buf_rec-fld-list.fldCloseLine   = 0
     3202               buf_rec-fld-list.closed         = yes
     3203           .
     3204       end.
     3205   end.
     3206   end procedure.
     3207   procedure xmllib-tag-open:
     3208   define input parameter v-tag-level  as integer      no-undo.
     3209   define input parameter v-tag-name   as character    no-undo.
     3210   define input parameter v-tag-value  as character    no-undo.
     3211   do
     3212   on error undo, return error
     3213   :
     3214       assign
     3215           v-tag-name = trim( v-tag-name )
     3216       .
     3217       put stream stmXMLOut unformatted
     3218           substitute( "&1&2<&3&4&5>"
     3219               , chr(10)
     3220               , fill(" ", 4 * v-tag-level)
     3221               , v-tag-name
     3222               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     3223               , v-tag-value
     3224           )
     3225       .
     3226   end.
     3227   end procedure.
     3228   procedure xmllib-tag-put:
     3229   define input parameter v-tag-level      as integer      no-undo.
     3230   define input parameter v-tag-name       as character    no-undo.
     3231   define input parameter v-tag-value      as character    no-undo.
     3232   define input parameter v-empty-mode     as integer      no-undo.
     3233   do
     3234   on error undo, return error
     3235   :
     3236       assign
     3237           v-tag-name = trim( v-tag-name )
     3238       .
     3239       if  v-empty-mode = 1
     3240       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     3241       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     3242       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     3243       then do:
     3244           run xmlchar-encode in this-procedure (
     3245                 input v-tag-value
     3246               , output v-tag-value
     3247           ).
     3248           put stream stmXMLOut unformatted
     3249               substitute( "&1&2<&3>&4</&3>"
     3250                   , chr(10)
     3251                   , fill(" ":U, 4 * v-tag-level)
     3252                   , v-tag-name
     3253                   , v-tag-value
     3254               )
     3255           .
     3256       end.
     3257   end.
     3258   end procedure.
     3259   procedure xmllib-tag-put-null :
     3260   define input parameter p-tag-level  as integer      no-undo.
     3261   define input parameter p-tag-name   as character    no-undo.
     3262   do
     3263   on error undo, return error
     3264   :
     3265       assign
     3266           p-tag-name = trim( p-tag-name )
     3267       .
     3268       put stream stmXMLOut unformatted
     3269           substitute( '&1&2<&3 nil="true" /&3>'
     3270               , chr(10)
     3271               , fill(" ":U, 4 * p-tag-level)
     3272               , p-tag-name
     3273           )
     3274       .
     3275   end.
     3276   end procedure.
     3277   procedure xmllib-tag-close:
     3278   define input parameter v-tag-level as integer      no-undo.
     3279   define input parameter v-tag-name  as character    no-undo.
     3280   do
     3281   on error undo, return error
     3282   :
     3283       assign
     3284           v-tag-name = trim( v-tag-name )
     3285       .
     3286       put stream stmXMLOut unformatted
     3287           substitute( "&1&2</&3>"
     3288               , chr(10)
     3289               , fill( " ":U, 4 * v-tag-level)
     3290               , v-tag-name
     3291           )
     3292       .
     3293   end.
     3294   end procedure.
     3295   procedure xmllib-write-log:
     3296   define input parameter v-filename   as character    no-undo.
     3297   define input parameter v-log-level  as integer      no-undo.
     3298   define input parameter v-out-string as character    no-undo.
     3299   do
     3300   on error undo, return error
     3301   :
     3302       output stream stmXMLLog to value( v-filename ) append.
     3303       put stream stmXMLLog unformatted
     3304           chr(10)
     3305       .
     3306       put stream stmXMLLog unformatted
     3307           ( if v-log-level = 0
     3308             or v-out-string = "&DLine":U
     3309             or v-out-string = "&Line":U
     3310             then "":U
     3311             else cur-time-string-sec() + " ":U )
     3312       .
     3313       put stream stmXMLLog unformatted
     3314           ( if v-out-string = "&Line":U
     3315             then fill( "-":U, 80 )
     3316             else if v-out-string = "&DLine":U
     3317                  then fill( "=":U, 80 )
     3318                  else v-out-string )
     3319       .
     3320       output stream stmXMLLog close.
     3321   end.
     3322   end procedure.
     3323   procedure xmllib-write-edt:
     3324   define input parameter v-editor-handle    as handle       no-undo.
     3325   define input parameter v-log-level        as integer      no-undo.
     3326   define input parameter v-out-string       as character    no-undo.
     3327   do
     3328   on error undo, return error
     3329   :
     3330       if valid-handle ( v-editor-handle )
     3331       then do:
     3332           v-editor-handle :move-to-eof().
     3333           v-editor-handle :insert-string( ( if v-log-level = 0
     3334                                             or v-out-string = "&DLine":U
     3335                                             or v-out-string = "&Line":U
     3336                                             then "":U
     3337                                             else cur-time-string-sec() + " ":U
     3338                                         ) ).
     3339           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     3340                                             then fill( "-":U, 80 )
     3341                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     3342                                             else fill( " ":U, v-log-level) + v-out-string
     3343                                         ) ).
     3344           v-editor-handle :insert-string( chr(10) ).
     3345       end.
     3346   end.
     3347   end procedure.
     3348   procedure xmllib-show-cnt:
     3349   define input parameter v-fillin-handle     as handle   no-undo.
     3350   do
     3351   on error undo, return error
     3352   :
     3353       if valid-handle( v-fillin-handle )
     3354       then do:
     3355           assign
     3356               v-fillin-handle :visible = true
     3357           .
     3358       end.
     3359   end.
     3360   end procedure.
     3361   procedure xmllib-hide-cnt:
     3362   define input parameter v-fillin-handle     as handle   no-undo.
     3363   do
     3364   on error undo, return error
     3365   :
     3366       if valid-handle( v-fillin-handle )
     3367       then do:
     3368           assign v-fillin-handle :visible = false.
     3369       end.
     3370   end.
     3371   end procedure.
     3372   procedure xmllib-write-cnt:
     3373   define input parameter v-fillin-handle    as handle       no-undo.
     3374   define input parameter v-fillin-string    as character    no-undo.
     3375   do
     3376   on error undo, return error
     3377   :
     3378       if valid-handle( v-fillin-handle )
     3379       then do:
     3380           assign
     3381               v-fillin-handle :SCREEN-value = v-fillin-string
     3382           .
     3383       end.
     3384   end.
     3385   end procedure.
     3386   procedure xmllib-write-header:
     3387   define input parameter p-first-file     as logical      no-undo.
     3388   define input parameter p-xml-file-name  as character    no-undo.
     3389   define input parameter p-list-file-name as character    no-undo.
     3390   define input parameter p-file-number    as integer      no-undo.
     3391   define input parameter p-have-prev      as logical      no-undo.
     3392   define input parameter p-prev-filename  as character    no-undo.
     3393   define input parameter p-parameter-list as character    no-undo.
     3394       define variable v-counter    as integer        no-undo.
     3395   do
     3396   on error undo, return error
     3397   :
     3398       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     3399       put stream stmXMLOut unformatted
     3400           "<?xml version='1.0' encoding='windows-1251'?>"
     3401       .
     3402       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     3403       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     3404       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     3405       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     3406       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     3407       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     3408       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     3409       :
     3410           run xmllib-tag-put(
     3411                 input 1
     3412               , input entry( 2 * v-counter, p-parameter-list )
     3413               , input entry( 2 * v-counter + 1, p-parameter-list )
     3414               , input 0
     3415           ).
     3416       end.
     3417       run xmllib-tag-close( input 0, input "THheader" ).
     3418       output stream stmXMLOut close.
     3419       if p-list-file-name <> "":U
     3420       then do:
     3421           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     3422           if p-first-file = yes
     3423           then do:
     3424               put stream stmXMLOut unformatted
     3425                   "<?xml version='1.0' encoding='windows-1251'?>"
     3426               .
     3427               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     3428           end.
     3429           run xmllib-tag-open( input 1, input "THfile", input "" ).
     3430           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     3431           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     3432           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     3433           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     3434           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     3435           :
     3436               run xmllib-tag-put(
     3437                   input 2
     3438                   , input entry( 2 * v-counter, p-parameter-list )
     3439                   , input entry( 2 * v-counter + 1, p-parameter-list )
     3440                   , input 0
     3441               ).
     3442           end.
     3443           run xmllib-tag-close( input 1, input "THfile" ).
     3444           output stream stmXMLOut close.
     3445       end.
     3446   end.
     3447   end procedure.
     3448   procedure xmllib-write-footer:
     3449   define input parameter p-last-file      as logical      no-undo.
     3450   define input parameter p-xml-file-name  as character    no-undo.
     3451   define input parameter p-list-file-name as character    no-undo.
     3452   define input parameter p-have-next      as logical      no-undo.
     3453   define input parameter p-next-file-name as character    no-undo.
     3454       define variable v-error-num     as integer           no-undo.
     3455   do
     3456   on error undo, return error
     3457   :
     3458       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     3459       if p-have-next = yes
     3460       then do:
     3461           run xmllib-tag-open( input 0, input "footer", "" ).
     3462           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     3463           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     3464           run xmllib-tag-close( input 0, input "footer" ).
     3465       end.
     3466       run xmllib-tag-close( input 0, input "root" ).
     3467       output stream stmXMLOut close.
     3468       run bge/os_copy.p (
     3469             input "M"
     3470           , input p-xml-file-name + "tmp"
     3471           , input p-xml-file-name + "xml"
     3472           , output v-error-num
     3473       ).
     3474       if p-last-file = yes
     3475       and p-list-file-name <> "":U
     3476       then do:
     3477           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     3478               run xmllib-tag-close( input 0, input "OpenXML" ).
     3479           output stream stmXMLOut close.
     3480           run bge/os_copy.p (
     3481                 input "M"
     3482               , input p-list-file-name + "tmp"
     3483               , input p-list-file-name + "xml":U
     3484               , output v-error-num
     3485           ).
     3486       end.
     3487   end.
     3488   end procedure.
     3489   procedure xmllib-filename :
     3490   define input parameter p-subdir             as character        no-undo.
     3491   define input parameter p-prefix             as character    no-undo.
     3492   define output parameter p-xml-file-name     as character    no-undo.
     3493   define output parameter p-log-file-name     as character    no-undo.
     3494   define output parameter p-list-file-name    as character    no-undo.
     3495       define variable v-home-dir  as character    no-undo.
     3496       define variable v-error-num as integer      no-undo.
     3497   do
     3498   on error undo, return error
     3499   :
     3500       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     3501       if v-home-dir = ?
     3502       then do:
     3503           message
     3504             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     3505             skip "Нет параметра oxml-dir в секции [OXML]."
     3506             skip(1)
     3507             skip "Обратитесь к администратору."
     3508           view-as alert-box error.
     3509           undo, return error .
     3510       end.
     3511       if p-subdir <> "":U
     3512       then do:
     3513           assign
     3514               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     3515           .
     3516       end.
     3517       run gbl/dir-cre.p (
     3518           input v-home-dir
     3519       ) no-error.
     3520       if error-status :error
     3521       then do:
     3522           message
     3523             skip "Неверно задан каталог экспорта в ini-файле."
     3524             skip "Не удаётся создать каталог, указанный параметром"
     3525             skip "oxml-dir в секции [OXML]."
     3526             skip(1)
     3527             skip "Обратитесь к администратору."
     3528           view-as alert-box error.
     3529           undo, return error .
     3530       end.
     3531       run bge/genfname.p (
     3532             input v-home-dir
     3533           , input p-prefix
     3534           , input ""
     3535           , input "xml"
     3536           , input "tmp"
     3537           , output p-xml-file-name
     3538       ).
     3539       assign
     3540           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     3541           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     3542           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     3543       .
     3544   end.
     3545   end procedure.
     3546   procedure xmllib-check-file-size :
     3547   define input parameter p-out-filename   as character    no-undo.
     3548   define output parameter p-is-big        as logical      no-undo.
     3549       define variable v-current-position    as integer        no-undo.
     3550   do
     3551   on error undo, return error
     3552   :
     3553       assign
     3554           v-current-position = seek( stmXMLOut )
     3555       .
     3556       if v-current-position / 1024 / 1024  >= 100
     3557       then do:
     3558           assign
     3559               p-is-big = yes
     3560           .
     3561       end.
     3562   end.
     3563   end procedure.
     3564   procedure xmllib-parse-file :
     3565   define input parameter p-full-filename      as character        no-undo.
     3566       define variable v-num-dirs              as integer      no-undo .
     3567       define variable v-str                   as character    no-undo .
     3568       define variable v-str-count             as int64        no-undo .
     3569   do
     3570   on error undo, return error
     3571   :
     3572       assign
     3573           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     3574           v-xmllib-error-status   = no
     3575       .
     3576       if v-num-dirs > 1
     3577       then do:
     3578           assign
     3579               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     3580               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     3581           .
     3582       end.
     3583       else do:
     3584           assign
     3585               v-xmllib-filename = p-full-filename
     3586               v-xmllib-dirname  = "":U
     3587           .
     3588       end.
     3589       if valid-handle(v-xmllib-prg-bar-handle)
     3590       then do:
     3591   if session :set-wait-state( "compiler" ) then.
     3592         input stream strXMLIn from value(p-full-filename) .
     3593         repeat
     3594         :
     3595           import stream strXMLIn unformatted v-str no-error .
     3596           assign
     3597             v-str-count = v-str-count + 1
     3598           .
     3599         end.
     3600         input stream strXMLIn close .
     3601   if session :set-wait-state( "" ) then.
     3602         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     3603         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     3604         run prg-bar_show in this-procedure .
     3605       end.
     3606       create sax-reader v-xmllib-sax-reader-handle.
     3607       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     3608       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     3609       if error-status :error
     3610       then do:
     3611           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     3612                                                                       ,vss-workfile
     3613                                                                       ,vss-revision
     3614                                                                       ,vss-description
     3615                                                                       ,chr(10)
     3616                                                                       ,return-value
     3617                                                                       ,trim(error-status :get-message(1))
     3618                                                                       ,trim(error-status :get-message(2))
     3619                                                                       ,trim(error-status :get-message(3)))
     3620                                                     ).
     3621           undo, return error .
     3622       end.
     3623       if v-xmllib-error-status <> no
     3624       then do:
     3625           run xmllib-parse-error in this-procedure (
     3626               input "*** При обработке XML файла были ошибки."
     3627           ).
     3628           delete object v-xmllib-sax-reader-handle.
     3629       end.
     3630       delete object v-xmllib-sax-reader-handle.
     3631       if valid-handle(v-xmllib-prg-bar-handle)
     3632       then do:
     3633         run prg-bar_delete in this-procedure .
     3634       end.
     3635   end.
     3636   end procedure.
     3637   procedure xmllib-parse-progressive :
     3638   define input parameter p-full-filename      as character no-undo .
     3639   define input parameter p-pack-data          as memptr no-undo .
     3640   define input parameter p-parse-first        as logical no-undo .
     3641   define input parameter p-first-err          as logical no-undo .
     3642   define output parameter p-parse-status as integer no-undo .
     3643   define variable v-num-dirs              as integer no-undo .
     3644   define variable glog                    as logical no-undo .
     3645   define variable v-pack-size             as int64 no-undo .
     3646   do
     3647   on error undo, return error
     3648   :
     3649     if p-parse-first then do:
     3650       if valid-handle(v-xmllib-sax-reader-handle)
     3651       then do:
     3652       end.
     3653       assign
     3654           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     3655           v-xmllib-error-status   = no
     3656       .
     3657       if v-num-dirs > 1
     3658       then do:
     3659           assign
     3660               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     3661               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     3662           .
     3663       end.
     3664       else do:
     3665           assign
     3666               v-xmllib-filename = p-full-filename
     3667               v-xmllib-dirname  = "":U
     3668           .
     3669       end.
     3670       create sax-reader v-xmllib-sax-reader-handle.
     3671       v-pack-size = get-size (p-pack-data) .
     3672       if v-pack-size > 0 then
     3673         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     3674       else
     3675         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     3676       if error-status :error
     3677       or not glog
     3678       then do:
     3679         delete object v-xmllib-sax-reader-handle.
     3680         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     3681                                                                     ,vss-workfile
     3682                                                                     ,vss-revision
     3683                                                                     ,vss-description
     3684                                                                     ,chr(10)
     3685                                                                     ,return-value
     3686                                                                     ,trim(error-status :get-message(1))
     3687                                                                     ,trim(error-status :get-message(2))
     3688                                                                     ,trim(error-status :get-message(3)) )
     3689                                                   ).
     3690         undo, return error .
     3691       end.
     3692       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     3693     end.
     3694     else do:
     3695       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     3696     end.
     3697     if error-status :error
     3698     then do:
     3699       delete object v-xmllib-sax-reader-handle.
     3700       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     3701                                                                   ,vss-workfile
     3702                                                                   ,vss-revision
     3703                                                                   ,vss-description
     3704                                                                   ,chr(10)
     3705                                                                   ,return-value
     3706                                                                   ,trim(error-status :get-message(1))
     3707                                                                   ,trim(error-status :get-message(2))
     3708                                                                   ,trim(error-status :get-message(3)) )
     3709                                                 ).
     3710       undo, return error .
     3711     end.
     3712     if v-xmllib-error-status <> no
     3713     then do:
     3714       run xmllib-parse-error in this-procedure (
     3715           input "*** При обработке XML файла были ошибки."
     3716       ).
     3717       if p-first-err then do:
     3718         delete object v-xmllib-sax-reader-handle.
     3719       end.
     3720       else do:
     3721         v-xmllib-error-status = no.
     3722       end.
     3723     end.
     3724     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     3725       p-parse-status = SAX-COMPLETE.
     3726       delete object v-xmllib-sax-reader-handle.
     3727       return '':U.
     3728     end.
     3729     else do:
     3730       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     3731       return '':U.
     3732     end.
     3733   end.
     3734   end procedure.
     3735   procedure StartElement :
     3736   define input parameter p-name-space     as character        no-undo.
     3737   define input parameter p-local-name     as character        no-undo.
     3738   define input parameter p-q-name         as character        no-undo.
     3739   define input parameter p-attributes     as handle           no-undo.
     3740       define buffer buf_rec             for temp_xmllib_rec.
     3741       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     3742       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3743       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3744   do
     3745   for buf_rec
     3746     , buf_rec-fld
     3747     , buf_rec-list
     3748     , buf_rec-fld-list
     3749   on error undo, return error
     3750   :
     3751       if valid-handle(v-xmllib-prg-bar-handle)
     3752       then do:
     3753         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     3754       end.
     3755       find first buf_rec-list
     3756            where buf_rec-list.recName = p-q-name
     3757       no-error.
     3758       if available buf_rec-list
     3759       then do:
     3760           if buf_rec-list.closed = no
     3761           then do:
     3762               find first buf_rec-fld-list
     3763                    where buf_rec-fld-list.recName = buf_rec-list.recName
     3764                      and buf_rec-fld-list.fldName = p-q-name
     3765               no-error.
     3766               if available buf_rec-fld-list
     3767               and buf_rec-list.recName = buf_rec-fld-list.recName
     3768               then do:
     3769                   if buf_rec-fld-list.closed = no
     3770                   then do:
     3771                       run xmllib-parse-error in this-procedure (
     3772                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     3773                                           , p-q-name
     3774                                           , p-q-name
     3775                                           , buf_rec-fld-list.fldOpenLine
     3776                                           )
     3777                       ).
     3778                   end.
     3779                   else do:
     3780                       run xmllib-parse-rec-fld-open in this-procedure (
     3781                             input buf_rec-list.recName
     3782                           , input buf_rec-list.recLevel
     3783                           , input buf_rec-fld-list.fldName
     3784                       ).
     3785                       assign
     3786                           buf_rec-fld-list.closed         = no
     3787                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3788                           buf_rec-fld-list.fldCloseLine   = 0
     3789                       .
     3790                   end.
     3791               end.
     3792               else do:
     3793                   assign
     3794                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     3795                   .
     3796                   run xmllib-parse-rec-open in this-procedure (
     3797                         input buf_rec-list.recName
     3798                       , input buf_rec-list.recLevel
     3799                   ).
     3800                   assign
     3801                       buf_rec-list.closed         = no
     3802                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3803                       buf_rec-list.recCloseLine   = 0
     3804                   .
     3805               end.
     3806           end.
     3807           else do:
     3808               run xmllib-parse-rec-open in this-procedure (
     3809                     input buf_rec-list.recName
     3810                   , input buf_rec-list.recLevel
     3811               ).
     3812               assign
     3813                   buf_rec-list.closed         = no
     3814                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3815                   buf_rec-list.recCloseLine   = 0
     3816               .
     3817           end.
     3818       end.
     3819       else do:
     3820           open-record:
     3821           for each buf_rec-fld-list
     3822              where buf_rec-fld-list.fldName = p-q-name
     3823           :
     3824               find first buf_rec-list
     3825                    where buf_rec-list.recName = buf_rec-fld-list.recName
     3826                      and buf_rec-list.closed  = no
     3827               no-error.
     3828               if available buf_rec-list
     3829               then do:
     3830                   run xmllib-parse-rec-fld-open in this-procedure (
     3831                         input buf_rec-list.recName
     3832                       , input buf_rec-list.recLevel
     3833                       , input buf_rec-fld-list.fldName
     3834                   ).
     3835                   assign
     3836                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     3837                       buf_rec-fld-list.closed         = no
     3838                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3839                       buf_rec-fld-list.fldCloseLine   = 0
     3840                   .
     3841                   leave open-record.
     3842               end.
     3843           end.
     3844       end.
     3845   end.
     3846   end procedure.
     3847   procedure Characters :
     3848   define input parameter p-char-data  as memptr.
     3849   define input parameter p-numchars   as integer.
     3850       define variable v-data-string    as character    no-undo.
     3851       define variable v-cp-utf8           as integer no-undo init 65001 .
     3852       define variable v-cp-windows1251    as integer no-undo init 1251 .
     3853       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     3854       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     3855       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     3856       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     3857   do
     3858   for buf_xmllib_rec
     3859     , buf_xmllib_rec-fld
     3860     , buf_xmllib_rec-list
     3861     , buf_xmllib_rec-fld-list
     3862   on error undo, return error
     3863   :
     3864       find first buf_xmllib_rec-list
     3865            where buf_xmllib_rec-list.closed = no
     3866       no-error.
     3867       if available buf_xmllib_rec-list
     3868       then do:
     3869           find first buf_xmllib_rec-fld-list
     3870                where buf_xmllib_rec-fld-list.closed = no
     3871           no-error.
     3872           if available buf_xmllib_rec-fld-list
     3873           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     3874           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     3875           then do:
     3876               find last buf_xmllib_rec
     3877                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     3878                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     3879                     and buf_xmllib_rec.closed   = no
     3880               use-index nm
     3881               no-error.
     3882               if available buf_xmllib_rec
     3883               then do:
     3884                   find last buf_xmllib_rec-fld
     3885                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     3886                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     3887                         and buf_xmllib_rec-fld.closed = no
     3888                   use-index nm
     3889                   no-error.
     3890                   if available buf_xmllib_rec-fld
     3891                   then do:
     3892                       assign
     3893                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     3894                       .
     3895                       if v-xmllib-codepage-convert = yes
     3896                       then do:
     3897                         assign
     3898                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     3899                         .
     3900                       end.
     3901                       run xmlchar-decode in this-procedure (
     3902                           input v-data-string
     3903                           , output v-data-string
     3904                       ).
     3905                       assign
     3906                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     3907                       .
     3908                   end.
     3909               end.
     3910           end.
     3911       end.
     3912   end.
     3913   end procedure.
     3914   procedure EndElement :
     3915   define input parameter p-name-space     as character        no-undo.
     3916   define input parameter p-local-name     as character        no-undo.
     3917   define input parameter p-q-name         as character        no-undo.
     3918       define buffer buf_rec             for temp_xmllib_rec.
     3919       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     3920       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3921       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3922   do
     3923   for buf_rec
     3924     , buf_rec-fld
     3925     , buf_rec-list
     3926     , buf_rec-fld-list
     3927   on error undo, return error
     3928   :
     3929       find last buf_rec-list
     3930           where buf_rec-list.recName = p-q-name
     3931       use-index pi
     3932       no-error.
     3933       if available buf_rec-list
     3934       then do:
     3935           if buf_rec-list.closed = yes
     3936           then do:
     3937               run xmllib-parse-error in this-procedure (
     3938                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     3939                                   , p-q-name
     3940                                   )
     3941               ).
     3942           end.
     3943           else do:
     3944               find last buf_rec
     3945                   where buf_rec.recName  = buf_rec-list.recName
     3946                     and buf_rec.recLevel = buf_rec-list.recLevel
     3947                     and buf_rec.closed   = no
     3948               use-index nm
     3949               no-error.
     3950               if not available buf_rec
     3951               then do:
     3952                   run xmllib-parse-error in this-procedure (
     3953                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     3954                                       , p-q-name
     3955                                       , buf_rec-list.recLevel
     3956                                       )
     3957                   ).
     3958               end.
     3959               else do:
     3960                   find first buf_rec-fld-list
     3961                        where buf_rec-fld-list.recName  = buf_rec.recName
     3962                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     3963                          and buf_rec-fld-list.fldName  = p-q-name
     3964                          and buf_rec-fld-list.closed   = no
     3965                   no-error.
     3966                   if not available buf_rec-fld-list
     3967                   then do:
     3968                       if buf_rec.recName <> p-q-name
     3969                       then do:
     3970                           run xmllib-parse-error in this-procedure (
     3971                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     3972                                               , buf_rec.recName
     3973                                               )
     3974                           ).
     3975                       end.
     3976                       else do:
     3977                           assign
     3978                               buf_rec.closed              = yes
     3979                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3980                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3981                           .
     3982                           if buf_rec-list.recLevel > 0
     3983                           then do:
     3984                               assign
     3985                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     3986                               .
     3987                               for each buf_rec-fld-list
     3988                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     3989                               :
     3990                                   assign
     3991                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     3992                                   .
     3993                               end.
     3994                           end.
     3995                           else do:
     3996                               assign
     3997                                   buf_rec-list.closed         = yes
     3998                               .
     3999                           end.
     4000                       end.
     4001                   end.
     4002                   else do:
     4003                       find last buf_rec-fld
     4004                           where buf_rec-fld.rec-key = buf_rec.rec-key
     4005                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     4006                             and buf_rec-fld.closed  = no
     4007                       use-index nm
     4008                       no-error.
     4009                       if not available buf_rec-fld
     4010                       then do:
     4011                           run xmllib-parse-error in this-procedure (
     4012                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     4013                                               , buf_rec-fld-list.fldName
     4014                                               , buf_rec.recName
     4015                                               , buf_rec.recLevel
     4016                                               )
     4017                           ).
     4018                       end.
     4019                       else do:
     4020                           assign
     4021                               buf_rec-fld.closed              = yes
     4022                               buf_rec-fld-list.closed         = yes
     4023                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     4024                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     4025                           .
     4026                       end.
     4027                   end.
     4028               end.
     4029           end.
     4030       end.
     4031       else do:
     4032           close-field-rec:
     4033           for each buf_rec-fld-list
     4034              where buf_rec-fld-list.fldName = p-q-name
     4035           :
     4036               find first buf_rec-list
     4037                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     4038                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     4039                      and buf_rec-list.closed   = no
     4040               no-error.
     4041               if available buf_rec-list
     4042               then do:
     4043                   find last buf_rec
     4044                       where buf_rec.recName  = buf_rec-list.recName
     4045                         and buf_rec.recLevel = buf_rec-list.recLevel
     4046                         and buf_rec.closed   = no
     4047                   use-index nm
     4048                   no-error.
     4049                   if not available buf_rec
     4050                   then do:
     4051                       run xmllib-parse-error in this-procedure (
     4052                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     4053                                           , p-q-name
     4054                                           )
     4055                       ).
     4056                   end.
     4057                   else do:
     4058                       find last buf_rec-fld
     4059                           where buf_rec-fld.rec-key = buf_rec.rec-key
     4060                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     4061                             and buf_rec-fld.closed  = no
     4062                       use-index nm
     4063                       no-error.
     4064                       if not available buf_rec-fld
     4065                       then do:
     4066                           run xmllib-parse-error in this-procedure (
     4067                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     4068                                               , buf_rec-fld-list.fldName
     4069                                               , buf_rec.recName
     4070                                               , buf_rec.recLevel
     4071                                               )
     4072                           ).
     4073                       end.
     4074                       else do:
     4075                           assign
     4076                               buf_rec-fld.closed              = yes
     4077                               buf_rec-fld-list.closed         = yes
     4078                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     4079                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     4080                           .
     4081                       end.
     4082                   end.
     4083                   leave close-field-rec.
     4084               end.
     4085           end.
     4086       end.
     4087   end.
     4088   end procedure.
     4089   procedure Error :
     4090   define input parameter p-error-message     as character        no-undo.
     4091   do
     4092   on error undo, return error
     4093   :
     4094       run xmllib-parse-error in this-procedure (
     4095           input p-error-message
     4096       ).
     4097       assign
     4098           v-xmllib-error-status = yes
     4099       .
     4100   end.
     4101   end procedure.
     4102   procedure xmllib-parse-error :
     4103   define input parameter p-err-message    as character        no-undo.
     4104   do
     4105   on error undo, return error
     4106   :
     4107       if valid-handle(v-xmllib-log-handle) then do:
     4108         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     4109                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     4110                                    ,chr(10)
     4111                                    ,v-xmllib-dirname
     4112                                    ,v-xmllib-filename
     4113                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     4114                                      then v-xmllib-sax-reader-handle :locator-line-number
     4115                                      else ?)
     4116                                    ,p-err-message)).
     4117       end.
     4118       else do:
     4119         if v-xmllib-log-filename = "":U
     4120         then do:
     4121             message
     4122                     vss-workfile vss-revision vss-description
     4123                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     4124                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     4125                                  then v-xmllib-sax-reader-handle :locator-line-number
     4126                                  else ?)
     4127                 skip(1)
     4128                 skip p-err-message
     4129                 skip return-value
     4130                 skip trim( error-status :get-message( 1 ) )
     4131                     trim( error-status :get-message( 2 ) )
     4132                     trim( error-status :get-message( 3 ) )
     4133             view-as alert-box error.
     4134             undo, return error.
     4135         end.
     4136         else do:
     4137           output to value( v-xmllib-log-filename ).
     4138           put unformatted
     4139               substitute( "&1&2", chr(10), p-err-message )
     4140           .
     4141           output close.
     4142         end.
     4143       end.
     4144   end.
     4145   end procedure.
     4146   procedure xmllib-set-log-filename :
     4147   define input parameter p-log-filename   as character        no-undo.
     4148   do
     4149   on error undo, return error
     4150   :
     4151       run gbl/fileapnd.p (
     4152             input p-log-filename
     4153           , input "":U
     4154           , input 10
     4155       ) no-error.
     4156       if error-status :error
     4157       then do:
     4158           assign
     4159               v-xmllib-log-filename = "":U
     4160           .
     4161       end.
     4162       else do:
     4163           assign
     4164               v-xmllib-log-filename = p-log-filename
     4165           .
     4166       end.
     4167   end.
     4168   end procedure.
     4169   procedure xmllib-set-log-handle :
     4170   define input parameter p-log-handle    as handle        no-undo.
     4171   define input parameter p-log-proc-name as character no-undo .
     4172   do
     4173   on error undo, return error
     4174   :
     4175       if valid-handle(p-log-handle)
     4176       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     4177       then do:
     4178         assign
     4179         v-xmllib-log-handle    = p-log-handle
     4180         v-xmllib-log-proc-name = p-log-proc-name
     4181         .
     4182       end.
     4183       else do:
     4184         assign
     4185         v-xmllib-log-handle    = ?
     4186         v-xmllib-log-proc-name = '':U
     4187         .
     4188       end.
     4189   end.
     4190   end procedure.
     4191   procedure xmllib-set-prg-bar-handle :
     4192   define input parameter p-handle    as handle        no-undo.
     4193   do
     4194   on error undo, return error
     4195   :
     4196       if valid-handle(p-handle)
     4197       then do:
     4198         assign
     4199           v-xmllib-prg-bar-handle = p-handle
     4200         .
     4201       end.
     4202       else do:
     4203         assign
     4204           v-xmllib-prg-bar-handle = ?
     4205         .
     4206       end.
     4207   end.
     4208   end procedure.
     4209   procedure xmllib-set-codepage-convert :
     4210     define input  parameter p-codepage-source as character no-undo .
     4211     define input  parameter p-codepage-target as character no-undo .
     4212   do
     4213   on error undo, return error return-value
     4214   :
     4215     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     4216     then do:
     4217       assign
     4218         v-xmllib-codepage-convert = yes
     4219         v-xmllib-codepage-source  = p-codepage-source
     4220         v-xmllib-codepage-target  = p-codepage-target
     4221       .
     4222     end.
     4223     else do:
     4224       assign
     4225         v-xmllib-codepage-convert = no
     4226         v-xmllib-codepage-source  = ""
     4227         v-xmllib-codepage-target  = ""
     4228       .
     4229     end.
     4230   end.
     4231   end procedure.
     4232   procedure xmllib-parse-rec-open :
     4233   define input parameter p-rec-name   as character        no-undo.
     4234   define input parameter p-rec-level  as integer          no-undo.
     4235       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     4236   do
     4237   for buf_temp_xmllib_rec
     4238   on error undo, return error
     4239   :
     4240        find first buf_temp_xmllib_rec
     4241            where buf_temp_xmllib_rec.recName = p-rec-name
     4242              and buf_temp_xmllib_rec.recLevel = p-rec-level
     4243              and buf_temp_xmllib_rec.closed  = no
     4244       use-index nm
     4245       no-error.
     4246       if available buf_temp_xmllib_rec
     4247       then do:
     4248           run xmllib-parse-error in this-procedure (
     4249               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     4250                               , p-rec-name
     4251                               , p-rec-level
     4252                               , buf_temp_xmllib_rec.recOpenLine
     4253                               )
     4254           ).
     4255       end.
     4256       else do:
     4257           assign
     4258               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     4259           .
     4260           create buf_temp_xmllib_rec.
     4261           assign
     4262               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     4263               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     4264               buf_temp_xmllib_rec.recCloseLine    = 0
     4265               buf_temp_xmllib_rec.recName         = p-rec-name
     4266               buf_temp_xmllib_rec.recLevel        = p-rec-level
     4267               buf_temp_xmllib_rec.closed          = no
     4268           .
     4269       end.
     4270   end.
     4271   end procedure.
     4272   procedure xmllib-parse-rec-fld-open :
     4273   define input parameter p-rec-name   as character        no-undo.
     4274   define input parameter p-rec-level  as integer          no-undo.
     4275   define input parameter p-fld-name   as character        no-undo.
     4276       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     4277       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     4278   do
     4279   for buf_temp_xmllib_rec
     4280     , buf_temp_xmllib_rec-fld
     4281   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     4282                                           , return-value
     4283                                           , trim( error-status :get-message( 1 ) )
     4284                                           , trim( error-status :get-message( 2 ) ) )
     4285   :
     4286       find last buf_temp_xmllib_rec
     4287           where buf_temp_xmllib_rec.recName   = p-rec-name
     4288             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     4289             and buf_temp_xmllib_rec.closed    = no
     4290       use-index nm
     4291       no-error.
     4292       if not available buf_temp_xmllib_rec
     4293       then do:
     4294           run xmllib-parse-error in this-procedure (
     4295               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     4296                               , p-rec-name
     4297                               , p-fld-name
     4298                               , p-rec-level
     4299                               )
     4300           ).
     4301       end.
     4302       else do:
     4303           find last buf_temp_xmllib_rec-fld
     4304               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     4305                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     4306                 and buf_temp_xmllib_rec-fld.closed   = no
     4307           use-index nm
     4308           no-error.
     4309           if available buf_temp_xmllib_rec-fld
     4310           then do:
     4311               run xmllib-parse-error in this-procedure (
     4312                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     4313                                   , p-rec-name
     4314                                   , p-fld-name
     4315                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     4316                                   )
     4317               ).
     4318           end.
     4319           else do:
     4320               assign
     4321                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     4322               .
     4323               create buf_temp_xmllib_rec-fld.
     4324               assign
     4325                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     4326                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     4327                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     4328                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     4329                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     4330                   buf_temp_xmllib_rec-fld.closed          = no
     4331               .
     4332           end.
     4333       end.
     4334   end.
     4335   end procedure.
     4336   define variable vss-include-info20 as character format "X(65)" no-undo
     4337   initial "@(#)$Workfile$ $Revision$".
     4338   procedure xmlchar-test :
     4339   define input parameter p-in-string          as character        no-undo.
     4340   define output parameter p-out-string-enc    as character        no-undo.
     4341   define output parameter p-out-string-dec    as character        no-undo.
     4342   do
     4343   on error undo, return error
     4344   :
     4345          run xmlchar-encode in this-procedure
     4346       (
     4347             input p-in-string
     4348           , output p-out-string-enc
     4349       ).
     4350          run xmlchar-decode in this-procedure
     4351       (
     4352             input p-out-string-enc
     4353           , output p-out-string-dec
     4354       ).
     4355   end.
     4356   end .
     4357   procedure xmlchar-encode :
     4358   define input parameter p-in-string      as character        no-undo.
     4359   define output parameter p-out-string    as character        no-undo.
     4360       define variable v-position      as integer      no-undo.
     4361       define variable v-current-char  as character    no-undo.
     4362   do
     4363   on error undo, return error
     4364   :
     4365       assign
     4366           p-out-string = "":U
     4367       .
     4368       case p-in-string
     4369       :
     4370           when ?
     4371           then do:
     4372               assign
     4373                   p-out-string = "?":U
     4374               .
     4375           end.
     4376           when "?":U
     4377           then do:
     4378               assign
     4379                   p-out-string = "&#63;":U
     4380               .
     4381           end.
     4382           otherwise do:
     4383               do v-position = 1 to length( p-in-string )
     4384               :
     4385                   assign
     4386                       v-current-char = substring( p-in-string, v-position, 1 )
     4387                   .
     4388                   case v-current-char
     4389                   :
     4390                       when "&":U
     4391                       then do:
     4392                           assign
     4393                               p-out-string = p-out-string + "&amp;":U
     4394                           .
     4395                       end.
     4396                       when ">":U
     4397                       then do:
     4398                           assign
     4399                               p-out-string = p-out-string + "&gt;":U
     4400                           .
     4401                       end.
     4402                       when "<":U
     4403                       then do:
     4404                           assign
     4405                               p-out-string = p-out-string + "&lt;":U
     4406                           .
     4407                       end.
     4408                       when "'":U
     4409                       then do:
     4410                           assign
     4411                               p-out-string = p-out-string + "&apos;":U
     4412                           .
     4413                       end.
     4414                       when '"':U
     4415                       then do:
     4416                           assign
     4417                               p-out-string = p-out-string + "&quot;":U
     4418                           .
     4419                       end.
     4420                       when chr(1)
     4421                       then do:
     4422                           assign
     4423                               p-out-string = p-out-string + "":U
     4424                           .
     4425                       end.
     4426                       when chr(2)
     4427                       then do:
     4428                           assign
     4429                               p-out-string = p-out-string + "":U
     4430                           .
     4431                       end.
     4432                       when chr(3)
     4433                       then do:
     4434                           assign
     4435                               p-out-string = p-out-string + "":U
     4436                           .
     4437                       end.
     4438                       when chr(4)
     4439                       then do:
     4440                           assign
     4441                               p-out-string = p-out-string + "":U
     4442                           .
     4443                       end.
     4444                       when chr(5)
     4445                       then do:
     4446                           assign
     4447                               p-out-string = p-out-string + "":U
     4448                           .
     4449                       end.
     4450                       when chr(6)
     4451                       then do:
     4452                           assign
     4453                               p-out-string = p-out-string + "":U
     4454                           .
     4455                       end.
     4456                       when chr(7)
     4457                       then do:
     4458                           assign
     4459                               p-out-string = p-out-string + "":U
     4460                           .
     4461                       end.
     4462                       when chr(8)
     4463                       then do:
     4464                           assign
     4465                               p-out-string = p-out-string + "":U
     4466                           .
     4467                       end.
     4468                       when chr(9)
     4469                       then do:
     4470                           assign
     4471                               p-out-string = p-out-string + "":U
     4472                           .
     4473                       end.
     4474                       when chr(29)
     4475                       then do:
     4476                           assign
     4477                               p-out-string = p-out-string + "":U
     4478                           .
     4479                       end.
     4480                       when chr(10)
     4481                       then do:
     4482                           assign
     4483                               p-out-string = p-out-string + "&#10;":U
     4484                           .
     4485                       end.
     4486                       when chr(13)
     4487                       then do:
     4488                           assign
     4489                               p-out-string = p-out-string + "&#13;":U
     4490                           .
     4491                       end.
     4492                       otherwise do:
     4493                           assign
     4494                               p-out-string = p-out-string + v-current-char
     4495                           .
     4496                       end.
     4497                   end case.
     4498               end.
     4499           end.
     4500       end case.
     4501   end.
     4502   end .
     4503   procedure xmlchar-encode-1c :
     4504   define input parameter p-in-string      as character        no-undo.
     4505   define output parameter p-out-string    as character        no-undo.
     4506       define variable v-position      as integer      no-undo.
     4507       define variable v-current-char  as character    no-undo.
     4508   do
     4509   on error undo, return error
     4510   :
     4511       assign
     4512           p-out-string = "":U
     4513       .
     4514       case p-in-string
     4515       :
     4516           when ?
     4517           then do:
     4518               assign
     4519                   p-out-string = "?":U
     4520               .
     4521           end.
     4522           otherwise do:
     4523               do v-position = 1 to length( p-in-string )
     4524               :
     4525                   assign
     4526                       v-current-char = substring( p-in-string, v-position, 1 )
     4527                   .
     4528                   case v-current-char
     4529                   :
     4530                       when chr(1)
     4531                       then do:
     4532                           assign
     4533                               p-out-string = p-out-string + " ":U
     4534                           .
     4535                       end.
     4536                       when chr(2)
     4537                       then do:
     4538                           assign
     4539                               p-out-string = p-out-string + " ":U
     4540                           .
     4541                       end.
     4542                       when chr(3)
     4543                       then do:
     4544                           assign
     4545                               p-out-string = p-out-string + " ":U
     4546                           .
     4547                       end.
     4548                       when chr(4)
     4549                       then do:
     4550                           assign
     4551                               p-out-string = p-out-string + " ":U
     4552                           .
     4553                       end.
     4554                       when chr(5)
     4555                       then do:
     4556                           assign
     4557                               p-out-string = p-out-string + " ":U
     4558                           .
     4559                       end.
     4560                       when chr(6)
     4561                       then do:
     4562                           assign
     4563                               p-out-string = p-out-string + " ":U
     4564                           .
     4565                       end.
     4566                       when chr(7)
     4567                       then do:
     4568                           assign
     4569                               p-out-string = p-out-string + " ":U
     4570                           .
     4571                       end.
     4572                       when chr(8)
     4573                       then do:
     4574                           assign
     4575                               p-out-string = p-out-string + " ":U
     4576                           .
     4577                       end.
     4578                       when chr(9)
     4579                       then do:
     4580                           assign
     4581                               p-out-string = p-out-string + " ":U
     4582                           .
     4583                       end.
     4584                       when chr(29)
     4585                       then do:
     4586                           assign
     4587                               p-out-string = p-out-string + " ":U
     4588                           .
     4589                       end.
     4590                       when chr(10)
     4591                       then do:
     4592                           assign
     4593                               p-out-string = p-out-string + " ":U
     4594                           .
     4595                       end.
     4596                       when chr(13)
     4597                       then do:
     4598                           assign
     4599                               p-out-string = p-out-string + " ":U
     4600                           .
     4601                       end.
     4602                       otherwise do:
     4603                           assign
     4604                               p-out-string = p-out-string + v-current-char
     4605                           .
     4606                       end.
     4607                   end case.
     4608               end.
     4609           end.
     4610       end case.
     4611   end.
     4612   end .
     4613   procedure xmlchar-decode :
     4614   define input parameter p-in-string      as character        no-undo.
     4615   define output parameter p-out-string    as character        no-undo.
     4616       define variable v-position      as integer      no-undo.
     4617       define variable v-last-position as integer      no-undo.
     4618       define variable v-temp-integer  as integer      no-undo.
     4619       define variable v-current-char  as character    no-undo.
     4620       define variable v-next-char     as character    no-undo.
     4621       define variable v-success       as logical      no-undo.
     4622   do
     4623   on error undo, return error
     4624   :
     4625       assign
     4626           p-out-string = "":U
     4627           v-position   = 0
     4628       .
     4629       replace-cycle:
     4630       do while yes
     4631       on error undo, return error
     4632       :
     4633           assign
     4634               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     4635           .
     4636           if v-last-position <= v-position
     4637           then do:
     4638               if v-position = 0
     4639               then do:
     4640                   assign
     4641                       p-out-string = p-in-string
     4642                   .
     4643               end.
     4644               else do:
     4645                   assign
     4646                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     4647                   .
     4648               end.
     4649               leave replace-cycle.
     4650           end.
     4651           else do:
     4652               assign
     4653                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     4654                   v-position      = v-last-position
     4655                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     4656               .
     4657               if v-current-char = "#":U
     4658               then do:
     4659                   assign
     4660                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     4661                   .
     4662                   if v-last-position > 0
     4663                   then do:
     4664                       run xmlchar-read-integer in this-procedure
     4665                        (
     4666                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     4667                           , output v-temp-integer
     4668                           , output v-success
     4669                       ).
     4670                       if v-success = yes
     4671                       and v-temp-integer >= 1
     4672                       and v-temp-integer <= 255
     4673                       then do:
     4674                           assign
     4675                               p-out-string = p-out-string + chr( v-temp-integer )
     4676                               v-position   = v-last-position + 1
     4677                           .
     4678                       end.
     4679                       else do:
     4680                           assign
     4681                               p-out-string = p-out-string + "&":U
     4682                               v-position   = v-position   + 1
     4683                           .
     4684                       end.
     4685                   end.
     4686                   else do:
     4687                       assign
     4688                           p-out-string = p-out-string + "&":U
     4689                           v-position   = v-position   + 1
     4690                       .
     4691                   end.
     4692               end.
     4693               else do:
     4694                   case substring( p-in-string, v-position + 1, 3 )
     4695                   :
     4696                       when "lt;":U
     4697                       then do:
     4698                           assign
     4699                               p-out-string = p-out-string + "<":U
     4700                               v-position   = v-position   + 3
     4701                           .
     4702                       end.
     4703                       when "gt;":U
     4704                       then do:
     4705                           assign
     4706                               p-out-string = p-out-string + ">":U
     4707                               v-position   = v-position   + 3
     4708                           .
     4709                       end.
     4710                       otherwise do:
     4711                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     4712                           then do:
     4713                               assign
     4714                                   p-out-string = p-out-string + "&":U
     4715                                   v-position   = v-position   + 4
     4716                               .
     4717                           end.
     4718                           else do:
     4719                               case substring( p-in-string, v-position + 1, 5 )
     4720                               :
     4721                                   when "quot;":U
     4722                                   then do:
     4723                                       assign
     4724                                           p-out-string = p-out-string + '"':U
     4725                                           v-position   = v-position   + 5
     4726                                       .
     4727                                   end.
     4728                                   when "apos;":U
     4729                                   then do:
     4730                                       assign
     4731                                           p-out-string = p-out-string + "'":U
     4732                                           v-position   = v-position   + 5
     4733                                       .
     4734                                   end.
     4735                                   otherwise do:
     4736                                       assign
     4737                                           p-out-string = p-out-string + "&":U
     4738                                       .
     4739                                   end.
     4740                               end case.
     4741                           end.
     4742                       end.
     4743                   end case.
     4744               end.
     4745           end.
     4746       end.
     4747   end.
     4748   end .
     4749   procedure xmlchar-read-integer :
     4750   define input parameter p-input-string      as character        no-undo.
     4751   define output parameter p-output-integer   as integer          no-undo.
     4752   define output parameter p-success       as logical          no-undo.
     4753   do
     4754   on error undo, return error
     4755   :
     4756       assign
     4757           p-output-integer = integer( p-input-string )
     4758       no-error.
     4759       if error-status :error
     4760       then do:
     4761           assign
     4762               p-success           = no
     4763               p-output-integer    = 0
     4764           .
     4765       end.
     4766       else do:
     4767           assign
     4768               p-success           = yes
     4769           .
     4770       end.
     4771   end.
     4772   end.
     4773   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4774   define temp-table temp-rel-handle no-undo
     4775   field dh as handle
     4776   field ii as integer
     4777   field active_ as logical
     4778   field child-buffer_ as character
     4779   field parent-buffer_ as character
     4780   field child-buffer-handle as handle
     4781   field parent-buffer-handle as handle
     4782   field name_ as character
     4783   field nested_ as logical
     4784   field relation-fields_ as character
     4785   field reposition_ as logical
     4786   field type_ as character
     4787   field query_ as handle
     4788   field where-string_ as character
     4789   field tbl-handle_ as handle
     4790   index pi is unique primary
     4791   ii
     4792   index iparentname parent-buffer_ child-buffer_
     4793   index iparenthandle parent-buffer-handle child-buffer-handle
     4794   .
     4795   procedure tmpreldf_get-relations :
     4796   define input parameter p-dataseth as handle no-undo .
     4797   define variable v-ii as integer no-undo .
     4798   define buffer buf_temp-rel-handle for temp-rel-handle.
     4799   do
     4800   on error undo, return error
     4801   :
     4802     if not valid-handle(p-dataseth)
     4803     or p-dataseth:type <> "DATASET"
     4804     then do:
     4805       return error substitute("Не определен dataset с handle &1", p-dataseth).
     4806     end.
     4807     for each buf_temp-rel-handle where
     4808             buf_temp-rel-handle.dh = p-dataseth:
     4809       delete buf_temp-rel-handle.
     4810     end.
     4811     do v-ii = 1 to p-dataseth:num-relations:
     4812       create buf_temp-rel-handle.
     4813       assign
     4814       buf_temp-rel-handle.ii = v-ii
     4815       buf_temp-rel-handle.dh = p-dataseth
     4816       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
     4817       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
     4818       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
     4819       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
     4820       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
     4821       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
     4822       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
     4823       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
     4824       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
     4825       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
     4826       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
     4827       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
     4828       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
     4829       .
     4830     end.
     4831   end.
     4832   end procedure.
     4833   procedure tmpreldf_set-relations :
     4834   define input parameter p-srcdataseth as handle no-undo .
     4835   define input parameter p-trgdataseth as handle no-undo .
     4836   define variable gh as handle no-undo .
     4837   define buffer buf_temp-rel-handle for temp-rel-handle.
     4838   do
     4839   on error undo, return error
     4840   :
     4841     if not valid-handle(p-srcdataseth)
     4842     or p-srcdataseth:type <> "DATASET"
     4843     then do:
     4844       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
     4845     end.
     4846     if not valid-handle(p-trgdataseth)
     4847     or p-trgdataseth:type <> "DATASET"
     4848     then do:
     4849       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
     4850     end.
     4851     for each buf_temp-rel-handle no-lock where
     4852             buf_temp-rel-handle.dh = p-srcdataseth
     4853     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4854     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     4855     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     4856     :
     4857       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
     4858                                         , buf_temp-rel-handle.child-buffer-handle
     4859                                         , buf_temp-rel-handle.relation-fields_
     4860                                         , buf_temp-rel-handle.reposition_
     4861                                         , buf_temp-rel-handle.nested_).
     4862      if error-status:error
     4863      or not valid-handle(gh) then do:
     4864        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
     4865      end.
     4866     end.
     4867   end.
     4868   end procedure.
     4869   procedure tmpreld2_query :
     4870   define  parameter buffer buf_temp-rel-handle for temp-rel-handle.
     4871   define input-output parameter p-child-qh as handle no-undo .
     4872   define variable glog as logical no-undo .
     4873   define variable v-mess as character no-undo .
     4874   _main:
     4875   do
     4876   on error undo, return error
     4877   :
     4878     create query p-child-qh .
     4879     glog = p-child-qh:set-buffers( buf_temp-rel-handle.child-buffer-handle) no-error.
     4880     if error-status:error
     4881     or
     4882     not glog then do:
     4883       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     4884                           , buf_temp-rel-handle.child-buffer_
     4885                           , chr(10)
     4886                           , error-status:get-message(1)
     4887                           ).
     4888       delete object p-child-qh no-error.
     4889       undo _main, return error v-mess.
     4890     end.
     4891     glog = p-child-qh:query-prepare( substitute( "for each &1 &2 "
     4892                                               , buf_temp-rel-handle.child-buffer_
     4893                                               , buf_temp-rel-handle.where-string_
     4894                                               )) no-error .
     4895     if error-status:error
     4896     or
     4897     not glog then do:
     4898       v-mess =  substitute("Ошибка при попытке получить записи &1&2&3"
     4899                           , buf_temp-rel-handle.child-buffer_
     4900                           , chr(10)
     4901                           , error-status:get-message(1)
     4902                           ).
     4903       delete object p-child-qh no-error.
     4904       undo _main, return error v-mess.
     4905     end.
     4906     glog = p-child-qh:query-open no-error .
     4907     if error-status:error
     4908     or
     4909     not glog then do:
     4910       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     4911                           , buf_temp-rel-handle.child-buffer_
     4912                           , chr(10)
     4913                           , error-status:get-message(1)
     4914                           ).
     4915       delete object p-child-qh no-error.
     4916       undo _main, return error v-mess.
     4917     end.
     4918   end.
     4919   end procedure.
     4920   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4921     define new SHARED temp-table  tt-tax no-undo
     4922   field tax-code    like ub.tax.tax-code
     4923   FIELD individual  like ub.tax.individual
     4924   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
     4925   field rate-code   like ub.tax-rate.rate-code
     4926   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
     4927   FIELD tax-type    like ub.tax.tax-type
     4928   field rate-value  like ub.tax-rate-value.rate-value
