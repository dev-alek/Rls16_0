     7172         undo, throw new Progress.Lang.AppError( substitute(
     7173           "Дополнительная единица измерения [&1] товара [&2] отсутствует в справочнике единиц измерения."
     7174           , v-add-unit-name, v-gds-code
     7175         ) ) .
     7176         if buf_goods.unit-base = v-add-unit-name then
     7177         undo, throw new Progress.Lang.AppError( substitute(
     7178           "Дополнительная единица измерения [&1] товара [&2] совпадает с учётной единицей измерения товара."
     7179           , v-add-unit-name, v-gds-code
     7180         ) ) .
     7181         v-unitsub = new ibs.th.str.mercury.unitsub () .
     7182         v-unitsub:UnitName = v-add-unit-name .
     7183         v-unitsub:UnitCoef = v-add-unit-k .
     7184         v-unitsubs:AddItem(v-unitsub) .
     7185       end . // end_of_p-GdsObj:unit-add-codes[]
     7186       v-unitstore = new ibs.th.gbl.storage.unitmercstr () .
