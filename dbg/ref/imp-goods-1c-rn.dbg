     4939   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4940   DEFINE new SHARED TEMP-TABLE TT-tnved NO-UNDO
     4941   FIELD tnved  AS CHAR FORMAT "X(10)"  LABEL 'Код ТНВЭД':U
     4942   FIELD f-name AS CHAR FORMAT "X(255)" LABEL 'Полное наименование':U
