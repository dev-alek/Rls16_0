     7454   END PROCEDURE.
     7455   PROCEDURE imagelist_decode:
     7456       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     7457       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
     7458       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     7459       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     7460       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     7461       ASSIGN
     7462           oImageList = iImageList
     7463           .
     7464       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     7465           vCh =ENTRY (vInt, iImageList, ",":U).
     7466           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
     7467           ELSE
     7468           DO:
     7469               ASSIGN
     7470                   vCh = REPLACE (vCh, "~/":U, "\":U)
     7471                   vCh = REPLACE (vCh, "~\":U, "\":U)
     7472                   .
     7473               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
     7474               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
     7475               ENTRY (vInt, oImageList, ",":U) = vCh.
     7476           END.
     7477       END.
     7478   END PROCEDURE.
     7479   PROCEDURE imagelist_encode:
     7480       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     7481       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     7482       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     7483       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     7484       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
     7485       ASSIGN
     7486           oImageList = iImageList
     7487           vLen       = LENGTH (mImageDir)
     7488           .
     7489       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     7490           vCh =ENTRY (vInt, iImageList, ",":U).
     7491           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
     7492               ENTRY (vInt, oImageList, ",":U) =
     7493                   SUBSTRING (vCh, vLen + 1).
     7494       END.
     7495   END PROCEDURE.
     7496     if trim(p-GdsObj:img) > ''
     7497     then do :
