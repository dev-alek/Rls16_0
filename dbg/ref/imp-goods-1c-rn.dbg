     6278   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6279   PROCEDURE verify-ini-entry:
     6280   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     6281   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     6282   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     6283   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     6284   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     6285   define variable v-mess as character no-undo .
     6286   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     6287   if ini-entry-value = ? and ini-key-name begins "spl"
     6288   then
     6289   get-key-value section ini-section-name key "splall" value ini-entry-value.
     6290   if ini-entry-value = ? and ini-key-name begins "sav"
     6291   then
     6292   get-key-value section ini-section-name key "savall" value ini-entry-value.
     6293   if ini-entry-value = ? then do:
     6294     assign
     6295     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     6296                       , chr(10)
     6297                       , ini-section-name
     6298                       , ini-key-name
     6299                       , error-msg-text).
     6300       if not silence then do:
     6301         message
     6302         v-mess
     6303         view-as alert-box ERROR  .
     6304         return error.
     6305       end.
     6306       else do:
     6307         return error v-mess.
     6308       end.
     6309   end.
     6310   END PROCEDURE.
     6311   PROCEDURE verify-file:
     6312   DEFINE INPUT  PARAMETER filename       as character no-undo.
     6313   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     6314   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     6315   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     6316   file-info:file-name = filename.
     6317   found = NOT (file-info:full-pathname = ?).
     6318   if NOT found  then do:
     6319     if not silence then do:
     6320       message error-msg-text
     6321       view-as alert-box ERROR.
     6322       return error.
     6323     end.
     6324     else return error error-msg-text.
     6325   end.
     6326   END PROCEDURE.
