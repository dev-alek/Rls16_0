     1763   procedure library-cls_get-handle :
     1764   define input parameter p-library-name as character no-undo .
     1765   define output parameter p-library-handle as handle no-undo .
     1766     do
     1767     on error undo, return error
     1768     :
     1769       CASE p-library-name:
     1770         when "library" then do:
     1771           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1772           p-library-handle = g#library.
     1773         end.
     1774         when "library2" then do:
     1775           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1776           p-library-handle = g#library2.
     1777         end.
     1778       end case.
     1779     end.
     1780   end procedure.
     1781   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1782   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
