     1740   end procedure.
     1741   procedure clear-from-rec-ord :
     1742   define input parameter p-rec-ord as integer no-undo .
     1743   define buffer buf_temp-no-route for temp-no-route.
     1744   define buffer buf_temp-smart-link for temp-smart-link.
     1745   do
     1746   on error undo, return error
     1747   :
     1748   for each buf_temp-no-route where
     1749           buf_temp-no-route.rec-ord > p-rec-ord:
     1750     delete buf_temp-no-route.
     1751   end.
     1752   for each buf_temp-smart-link where
     1753           buf_temp-smart-link.rec-ord > p-rec-ord:
     1754      delete buf_temp-smart-link.
     1755   end.
     1756   end.
     1757   end procedure.
