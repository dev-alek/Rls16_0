     4944   def var vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4945   procedure progs-name :
     4946     define input  parameter p-action-code         as character no-undo .
     4947     define output parameter p-main-prog-name      as character no-undo .
     4948     define output parameter p-list-db-proc-name   as character no-undo .
     4949     define output parameter p-commit-proc-name    as character no-undo .
     4950     define output parameter p-execution-proc-name as character no-undo .
     4951     define output parameter p-recover-proc-name   as character no-undo .
     4952     define output parameter p-after-proc-name     as character no-undo .
     4953     do
     4954     on error undo, return error
     4955     :
     4956       case p-action-code :
     4957               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
     4958               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
     4959               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
     4960               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
     4961               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
     4962               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
     4963               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
     4964               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
     4965               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
     4966               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
     4967               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
     4968               otherwise do:
     4969           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info24, p-action-code ).
     4970         end.
     4971       end case.
     4972     end.
     4973     return.
     4974   end procedure.
     4975   procedure progs-title :
     4976     define input  parameter p-action-code         as character no-undo .
     4977     define output parameter p-action-title      as character no-undo .
     4978     do
     4979     on error undo, return error
     4980     :
     4981       case p-action-code :
     4982               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     4983               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     4984               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     4985               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     4986               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     4987               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     4988               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     4989               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     4990               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     4991               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     4992               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     4993               otherwise do:
     4994           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info24, p-action-code ).
     4995         end.
     4996       end case.
     4997     end.
     4998     return.
     4999   end procedure.
     5000   FUNCTION progs-title-function returns character(
     5001      input  p-action-code         as character):
     5002   define variable p-action-title      as character no-undo .
     5003     do
     5004     on error undo, return error
     5005     :
     5006       case p-action-code :
     5007               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     5008               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     5009               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     5010               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     5011               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     5012               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     5013               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     5014               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     5015               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     5016               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     5017               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     5018               otherwise do:
     5019           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info24, p-action-code ).
     5020         end.
     5021       end case.
     5022     end.
     5023     return p-action-title.
     5024   end FUNCTION.
     5025   procedure get-row-keyr-string :
     5026    define input  parameter p-key-rec  as character no-undo.
     5027    define output parameter p-tbl-title as character no-undo.
     5028    define output parameter p-rec-string  as character no-undo.
     5029     do
     5030     on error undo, return error
     5031     :
     5032       define variable v-full-tbl-name as character no-undo .
     5033       define variable bh_tbl-name     as handle    no-undo .
     5034       define variable fh              as handle    no-undo .
     5035       define variable v-ok            as logical   no-undo .
     5036       define variable v-field-num     as integer   no-undo .
     5037       define variable v-count-fld     as integer   no-undo .
     5038       define variable v-tbl-name as character no-undo.
     5039       if p-key-rec = ?
     5040         or p-key-rec = "":U
     5041       then do:
     5042         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info24 ).
     5043       end.
     5044       assign
     5045         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     5046         v-full-tbl-name = "ub.":U + v-tbl-name
     5047         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
     5048         p-rec-string         = "":U
     5049         v-count-fld     = 0
     5050       .
     5051       find ub._file
     5052         where ub._file._file-name = v-tbl-name
     5053         no-error.
     5054       if not available ub._file then do:
     5055         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info24, v-tbl-name ).
     5056       end.
     5057       assign
     5058       p-tbl-title = ub._file._file-label
     5059       .
     5060       find ub._index
     5061         where recid( ub._index  ) = ub._file._prime-index
     5062         no-error.
     5063       if not available ub._index
     5064         or LC( ub._index._index-name ) = "default":U
     5065       then do:
     5066         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info24, v-tbl-name ).
     5067       end.
     5068       block_where :
     5069       for each ub._index-field of ub._index  ,
     5070           each ub._field of _index-field
     5071           break by _index-seq
     5072       on error undo, return error
     5073       :
     5074         assign
     5075           v-count-fld = v-count-fld + 1
     5076         .
     5077         if v-count-fld > v-field-num then do:
     5078           leave block_where.
     5079         end.
     5080         if p-rec-string = "":U then do:
     5081           assign
     5082             p-rec-string = "":U
     5083           .
     5084         end.
     5085         else do:
     5086           assign
     5087             p-rec-string = p-rec-string + chr(32) + chr(44)
     5088           .
     5089         end.
     5090         assign
     5091           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
     5092         .
     5093       end.
     5094       if v-count-fld <> v-field-num then do:
     5095         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info24, v-tbl-name ).
     5096       end.
     5097     end.
     5098     return.
     5099   end procedure.
     5100   FUNCTION uniq-key-rec-string-f returns character(
     5101      input  p-uniq-key-rec         as character):
     5102   define variable v-tbl-title as character no-undo .
     5103   define variable v-rec-string as character no-undo .
     5104     do
     5105     on error undo, return error
     5106     :
     5107       run get-row-keyr-string in this-procedure (
     5108                                                 input p-uniq-key-rec
     5109                                                 ,output v-tbl-title
     5110                                                 ,output v-rec-string).
     5111       assign
     5112       v-rec-string = (if v-tbl-title <> ? and
     5113                       v-tbl-title <> "":U
     5114                       then (v-tbl-title + ":")
     5115                      else "":U) + chr(32) + v-rec-string
     5116       .
     5117     end.
     5118     return v-rec-string.
     5119   end FUNCTION.
     5120   procedure create_db-rec_route :
     5121     define input parameter p1-uniq-key-rec as character no-undo .
     5122     define input parameter p1-action       as character no-undo .
     5123     define input parameter p1-operation    as character no-undo .
     5124     define input parameter p1-send-db-list as character no-undo .
     5125     define input parameter p1-db-init      as integer   no-undo .
     5126     define input parameter p1-parameters   as character no-undo .
     5127     define input parameter p1-answer-code  as integer   no-undo .
     5128     define input parameter p1-answer-msg   as character no-undo .
     5129     do
     5130     on error undo, return error
     5131     :
     5132       define variable v-command     as character no-undo .
     5133       define variable v-ind         as integer   no-undo .
     5134       define variable v-num-entries as integer   no-undo .
     5135       define variable v-curr-db     as integer   no-undo .
     5136       define variable v-db-for-send as character no-undo .
     5137       define variable v-db-num      as integer   no-undo .
     5138       define variable v-db-num-char as character no-undo .
     5139       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5140       find first buf_sys-ctrl no-lock .
     5141       assign
     5142         v-curr-db     = buf_sys-ctrl.db-num
     5143         v-db-for-send = "":U
     5144       .
     5145       if v-curr-db = 0 then do:
     5146         if p1-answer-code >= 0 then do:
     5147           if v-curr-db <> p1-db-init then do:
     5148             assign
     5149               v-db-for-send = string( p1-db-init )
     5150             .
     5151           end.
     5152         end.
     5153         else do:
     5154           assign
     5155             v-num-entries = num-entries( p1-send-db-list, chr(44) )
     5156           .
     5157           do v-ind = 1 to v-num-entries:
     5158             assign
     5159               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
     5160               v-db-num      = integer( v-db-num-char )
     5161             .
     5162             if v-db-num <> v-curr-db
     5163               and v-db-num <> p1-db-init
     5164             then do:
     5165               if v-db-for-send = "":U then do:
     5166                 assign
     5167                   v-db-for-send = v-db-num-char
     5168                 .
     5169               end.
     5170               else do:
     5171                 assign
     5172                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     5173                 .
     5174               end.
     5175             end.
     5176           end.
     5177         end.
     5178       end.
     5179       else do:
     5180         assign
     5181           v-db-for-send = "0":U
     5182         .
     5183       end.
     5184       if v-db-for-send <> "":U then do:
     5185         assign
     5186           v-command = "command":U + chr(1)
     5187                       + "two-commit":U + chr(1)
     5188                       + p1-action + chr(1)
     5189                       + p1-operation + chr(1)
     5190                       + p1-uniq-key-rec + chr(1)
     5191                       + string( p1-db-init ) + chr(1)
     5192                       + p1-parameters + chr(1)
     5193                       + string( p1-answer-code ) + chr(1)
     5194                       + p1-answer-msg
     5195         .
     5196         run nws/cr-route.p ( input 'send-cmd':U
     5197                       ,input v-command
     5198                       ,input ?
     5199                       ,input v-db-for-send
     5200                       ) no-error .
     5201         if error-status :error then do:
     5202           return error return-value.
     5203         end.
     5204       end.
     5205     end.
     5206     return.
     5207   end procedure.
     5208   procedure create_msg_route :
     5209     define input parameter p2-send-db-list as character no-undo .
     5210     define input parameter p2-msg          as character no-undo .
     5211     do
     5212     on error undo, return error
     5213     :
     5214       define variable v-msg-command as character no-undo .
     5215       define variable v-ind         as integer   no-undo .
     5216       define variable v-num-entries as integer   no-undo .
     5217       define variable v-curr-db     as integer   no-undo .
     5218       define variable v-db-for-send as character no-undo .
     5219       define variable v-db-num      as integer   no-undo .
     5220       define variable v-db-num-char as character no-undo .
     5221       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5222       find first buf_sys-ctrl no-lock .
     5223       assign
     5224         v-curr-db     = buf_sys-ctrl.db-num
     5225         v-db-for-send = "":U
     5226       .
     5227       if v-curr-db = 0 then do:
     5228         assign
     5229           v-num-entries = num-entries( p2-send-db-list, chr(44) )
     5230         .
     5231         do v-ind = 1 to v-num-entries:
     5232           assign
     5233             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
     5234             v-db-num      = integer( v-db-num-char )
     5235           .
     5236           if v-db-num <> v-curr-db then do:
     5237             if v-db-for-send = "":U then do:
     5238               assign
     5239                 v-db-for-send = v-db-num-char
     5240               .
     5241             end.
     5242             else do:
     5243               assign
     5244                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     5245               .
     5246             end.
     5247           end.
     5248         end.
     5249       end.
     5250       else do:
     5251         assign
     5252           v-db-for-send = "0":U
     5253         .
     5254       end.
     5255       if v-db-for-send <> "":U then do:
     5256         assign
     5257           v-msg-command = "command":U + chr(1)
     5258                           + "message-to-log":U + chr(1)
     5259                           + p2-msg
     5260         .
     5261         run nws/cr-route.p ( input 'send-cmd':U
     5262                       ,input v-msg-command
     5263                       ,input ?
     5264                       ,input v-db-for-send
     5265                       ) no-error .
     5266         if error-status :error then do:
     5267           return error substitute( "&1&2&3"
     5268                                     , return-value
     5269                                     , chr(10)
     5270                                     , error-status :get-message(1)
     5271                                   ).
     5272         end.
     5273       end.
     5274     end.
     5275     return.
     5276   end procedure.
     5277   function get-send-db-list returns character
     5278     ( input p-curr-db     as integer
     5279      ,input p-all-db-list as character
     5280     )
     5281   :
     5282     define variable v-send-db-list as character no-undo .
     5283     if p-curr-db = 0 then do:
     5284       assign
     5285         v-send-db-list = p-all-db-list
     5286       .
     5287     end.
     5288     else do:
     5289       assign
     5290         v-send-db-list = string(p-curr-db)
     5291       .
     5292     end.
     5293     return v-send-db-list .
     5294   end function .
