     7537                                       , error-status:get-message(1)
     7538                                       , return-value ).
     7539           undo, return error v-err-mess .
     7540         end.
     7541       end.
     7542       file-info:file-name = v-dir-name .
     7543       if file-info:full-pathname = ?
     7544       then do :
     7545         os-create-dir value(right-trim(v-dir-name, "\")) .
     7546         if os-error <> 0 then do:
     7547           v-err-mess = substitute("Невозможно создать директорию &1 для изображений &2&3&2&4"
     7548                                       , v-dir-name
     7549                                       , chr(10)
     7550                                       , error-status:get-message(1)
     7551                                       , return-value ).
     7552           undo, return error v-err-mess .
     7553         end.
     7554       end.
     7555       v-file-name = v-dir-name + string(ub.goods.gds-code) + ".png" .
     7556       v-size = length(p-GdsObj:img) .
     7557       set-size(mem1) = integer(8 / 6 * v-size) + 1.
     7558       mem1 = BASE64-DECODE(p-GdsObj:img).
     7559       copy-lob from mem1 to file v-file-name no-convert no-error .
     7560       if error-status:error
     7561       then do :
     7562         os-delete value(v-file-name) .
     7563         if os-error <> 0
     7564         then do :
     7565           v-err-mess = substitute("Не могу обновить изображение &1&2&3&2&4"
     7566                                       , v-file-name
     7567                                       , chr(10)
     7568                                       , error-status:get-message(1)
     7569                                       , return-value ).
     7570           undo, return error v-err-mess .
     7571         end.
     7572         copy-lob from mem1 to file v-file-name no-convert no-error .
     7573         if error-status:error
     7574         then do :
     7575           v-err-mess = substitute("Не могу сохранить изображение &1&2&3&2&4"
     7576                                       , v-file-name
     7577                                       , chr(10)
     7578                                       , error-status:get-message(1)
     7579                                       , return-value ).
     7580           undo, return error v-err-mess .
     7581         end.
     7582       end .
     7583       keyrecObj = new keyrec ().
     7584       keyrecObj:GenKeyRec('goods':U, buffer ub.goods:handle, output keyrec).
     7585       delete object keyrecObj.
     7586       find first buf_blob-bind exclusive-lock where buf_blob-bind.uniq-key-rec = keyrec
     7587                                                 and buf_blob-bind.field-name_  = 'gds-collec-image':U
     7588                                                 no-error .
     7589       if available buf_blob-bind
     7590       then do :
     7591         v-blob-db-num = buf_blob-bind.db-num .
     7592         v-int64-id = buf_blob-bind.int64-id .
     7593         v-part-num = buf_blob-bind.part-num .
     7594         run gbl/file2blb.p ( input 'ИЗМЕНЕНИЕ':U
     7595                             ,input  "override"
     7596                             ,input (buffer ub.goods:handle)
     7597                             ,input keyrec
     7598                             ,input 'gds-collec-image':U
     7599                             ,input 'gds-collec-image':U
     7600                             ,input-output v-part-num
     7601                             ,input 'data':U
     7602                             ,input-output v-blob-db-num
     7603                             ,input-output v-int64-id
     7604                             ,input v-file-name
     7605                             ) no-error .
     7606         if error-status :error then do:
     7607           v-err-mess = substitute("Не могу обновить изображение &1 в базе &2&3&2&4"
     7608                                       , v-file-name
     7609                                       , chr(10)
     7610                                       , error-status:get-message(1)
     7611                                       , return-value ).
     7612           undo, return error v-err-mess .
     7613         end.
     7614       end.
     7615       else do :
     7616         v-blob-db-num = ? .
     7617         v-int64-id = 0 .
     7618         run gbl/file2blb.p ( input 'ДОБАВЛЕНИЕ':U
     7619                             ,input  "yes"
     7620                             ,input (buffer ub.goods:handle)
     7621                             ,input keyrec
     7622                             ,input 'gds-collec-image':U
     7623                             ,input 'gds-collec-image':U
     7624                             ,input-output v-part-num
     7625                             ,input 'data':U
     7626                             ,input-output v-blob-db-num
     7627                             ,input-output v-int64-id
     7628                             ,input v-file-name
     7629                             ) no-error .
     7630         if error-status :error then do:
     7631           v-err-mess = substitute("Не могу сохранить изображение &1 в базу &2&3&2&4"
     7632                                       , v-file-name
     7633                                       , chr(10)
     7634                                       , error-status:get-message(1)
     7635                                       , return-value ).
     7636           undo, return error v-err-mess .
     7637         end.
     7638       end.
     7639       v-blob-db-num = ? .
     7640       v-int64-id = 0 .
     7641       run gbl/file2blb.p ( input 'ДОБАВЛЕНИЕ':U
     7642                           ,input  "yes"
     7643                           ,input (buffer ub.goods:handle)
     7644                           ,input keyrec
     7645                           ,input 'gds-collec-image':U
     7646                           ,input 'gds-collec-image':U
     7647                           ,input-output v-part-num
     7648                           ,input 'data':U
     7649                           ,input-output v-blob-db-num
     7650                           ,input-output v-int64-id
     7651                           ,input v-file-name
     7652                           ) no-error .
     7653       if error-status :error then do:
     7654         v-err-mess = substitute("Не могу сохранить изображение &1 в базу &2&3&2&4"
     7655                                       , v-file-name
     7656                                       , chr(10)
     7657                                       , error-status:get-message(1)
     7658                                       , return-value ).
     7659         undo, return error v-err-mess .
     7660       end.
     7661       find first buf_gds-season no-lock where buf_gds-season.db-num = ibs.th.gbl.gbl-var:g#db-num
     7662                                           and buf_gds-season.gds-code = ub.goods.gds-code
     7663                                           no-error .
     7664       if not available buf_gds-season
     7665       then do :
     7666         os-delete value(v-file-name) no-error .
     7667       end .
     7668       else do :
     7669         RUN imagelist_encode IN THIS-PROCEDURE (INPUT v-file-name, OUTPUT v-file-name).
     7670         RUN gds-attr-write (v-nbc, "image-list":U, v-file-name).
     7671       end .
     7672     end .
     7673     procedure mainmenu_getcntxt :
     7674     // @FUTU дописать перечень мест, из которых вызывается данная процедура
     7675       define output parameter v-cntxt-db-num        as integer   no-undo .
     7676       define output parameter v-cntxt-userid        as character no-undo .
     7677       define output parameter v-cntxt-level         as character no-undo .
     7678       define output parameter v-cntxt-host-code-obj as integer   no-undo .
     7679       define output parameter v-cntxt-obj-type      as character no-undo .
     7680       define output parameter v-cntxt-obj-code      as integer   no-undo .
     7681       define output parameter v-cntxt-db-num-obj    as integer   no-undo .
     7682       define output parameter v-cntxt-is-admin      as logical   no-undo .
     7683       v-cntxt-db-num = ibs.th.gbl.gbl-var:g#db-num .
     7684       v-cntxt-userid = ibs.th.gbl.gbl-var:g#userid .
     7685       v-cntxt-level = ? .
     7686       v-cntxt-host-code-obj = ub.clients.host-code .
     7687       v-cntxt-obj-type = ub.clients.obj-type .
     7688       v-cntxt-obj-code = ub.clients.obj-code .
     7689       v-cntxt-db-num-obj = ub.clients.db-num .
     7690       v-cntxt-is-admin =  ? .
     7691     end procedure .
     7692     procedure cb_get-gds-list :
     7693       define input parameter p-handle as handle no-undo .
     7694       for each gds-list:
     7695         run cb_set-gds-list in p-handle ( input (buffer gds-list:handle)).
     7696       end.
     7697     end procedure.
     7698     procedure write-log-and-file :
     7699       define input parameter p-tabs as integer no-undo .
     7700       define input parameter p-log-file as character no-undo .
     7701       define input parameter p-int2 as integer no-undo .
     7702       define input parameter p-mess as character no-undo .
     7703     end procedure.
     7704     procedure show-counter :
     7705     end procedure.
     7706     procedure write-counter :
     7707       define input parameter p-counter-string     as character    no-undo.
     7708     end procedure.
