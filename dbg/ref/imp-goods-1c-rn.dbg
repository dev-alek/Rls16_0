        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Загрузка товара из ERP 1C RN".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define  variable garbcoll_ii as integer no-undo .
       82   define  temp-table temp-gc no-undo
       83   field ii as integer
       84   field obj-r as handle
       85   field cn as character
       86   index pi is unique primary
       87   ii
       88   index icn
       89   cn.
       90   procedure garbcoll_create-gc-entry :
       91   define input parameter p-cn as character no-undo .
       92   define input parameter p-obj-r as handle no-undo .
       93     do
       94     on error undo, return error
       95     :
       96       create temp-gc.
       97       assign
       98       temp-gc.ii = garbcoll_ii
       99       garbcoll_ii = garbcoll_ii + 1
      100       temp-gc.cn = p-cn
      101       temp-gc.obj-r = p-obj-r
      102       .
      103     end.
      104   end procedure.
      105   procedure garbcoll_clear :
      106     do
      107     on error undo, return error
      108     :
      109       for each temp-gc:
      110         delete object temp-gc.obj-r.
      111         delete temp-gc.
      112       end.
      113     end.
      114   end procedure.
      115   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   procedure cur-time :
      117      define output parameter p-today as date      no-undo .
      118      define output parameter p-time  as integer   no-undo .
      119     do
      120     on error undo, return error
      121     :
      122       define variable v-date1 as date      no-undo .
      123       define variable v-date2 as date      no-undo .
      124       define variable v-time  as integer   no-undo .
      125       assign
      126         v-date1 = today
      127         v-time  = time
      128         v-date2 = today
      129       .
      130       if v-date1 <> v-date2
      131       then do:
      132         assign
      133           v-date1 = today
      134           v-time  = v-time
      135         .
      136       end.
      137       assign
      138         p-today = v-date1
      139         p-time  = v-time
      140       .
      141     end.
      142   end.
      143   function cur-time-date returns character
      144   :
      145     return string(today, '99/99/9999':U) .
      146   end.
      147   function cur-time-mjd returns decimal
      148   :
      149     define variable v-date as date      no-undo .
      150     define variable v-time as integer   no-undo .
      151     run cur-time in this-procedure
      152       (output v-date
      153       ,output v-time
      154       ) .
      155     return integer(v-date) - 2400002 + (v-time / 86400) .
      156   end.
      157   function cur-time-get-ending-index returns integer
      158   (input p-number as integer
      159   )
      160   :
      161     if p-number < 0
      162     or p-number = ?
      163     then do:
      164       return 1 .
      165     end.
      166     define variable v-rest as integer   no-undo .
      167     assign
      168       p-number = p-number modulo 100
      169     .
      170     if p-number < 20
      171     then do:
      172       assign
      173         v-rest = p-number
      174       .
      175     end.
      176     else do:
      177       assign
      178         v-rest = p-number modulo 10
      179       .
      180     end.
      181     case v-rest :
      182       when 1
      183       then do:
      184         return 2 .
      185       end.
      186       when 2 or
      187       when 3 or
      188       when 4
      189       then do:
      190         return 3 .
      191       end.
      192       otherwise do:
      193         return 1 .
      194       end.
      195     end case .
      196   end.
      197   procedure cur-time-mjd-to-date :
      198      define input  parameter i-mjd-diff as decimal no-undo.
      199      define output parameter o-Date     as date    no-undo.
      200      define output parameter o-Time     as integer no-undo.
      201      define variable v-day-number as integer   no-undo .
      202      if    i-mjd-diff < 0
      203         or i-mjd-diff = ?
      204      then do:
      205         return "?" .
      206      end.
      207      assign
      208         v-day-number = truncate(i-mjd-diff,0).
      209         o-Date = date(v-day-number + 2400002).
      210         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      211     .
      212   end.
      213   function cur-time-mjd-to-string returns character
      214   (input p-mjd-diff as decimal
      215   )
      216   :
      217     define variable v-day-number as integer   no-undo .
      218     define variable v-seconds    as integer   no-undo .
      219     define variable v-hour       as integer   no-undo .
      220     define variable v-min        as integer   no-undo .
      221     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      222     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      223     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      224     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      225     if p-mjd-diff < 0
      226     or p-mjd-diff = ?
      227     then do:
      228       return "?" .
      229     end.
      230     assign
      231       v-day-number = integer(truncate(p-mjd-diff,0))
      232       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      233     .
      234     if v-seconds > 86400
      235     then do:
      236       assign
      237         v-seconds = 86400 - 1
      238       .
      239     end.
      240     if v-seconds < 0
      241     then do:
      242       assign
      243         v-seconds = 0
      244       .
      245     end.
      246     assign
      247       v-hour = truncate(v-seconds / 3600, 0)
      248     .
      249     assign
      250       v-seconds = v-seconds modulo 3600
      251     .
      252     assign
      253       v-min = truncate(v-seconds / 60, 0)
      254     .
      255     assign
      256       v-seconds = v-seconds modulo 60
      257     .
      258     return
      259         (if v-day-number <> 0
      260           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      261           else ""
      262         )
      263       + (if v-day-number <> 0 or v-hour <> 0
      264           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      265           else ""
      266         )
      267       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      268           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      269           else ""
      270         )
      271       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      272       .
      273   end.
      274   function cur-time-string returns character
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      283   end.
      284   function cur-time-string-sec returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      293   end.
      294   function cur-time-custom  returns character
      295   (input p-prefix as character
      296   ,input p-date-format as character
      297   ,input p-delimiter as character
      298   ,input p-time-format as character
      299   ,input p-suffix as character
      300   )
      301   :
      302     define variable v-date as date      no-undo .
      303     define variable v-time as integer   no-undo .
      304     run cur-time in this-procedure
      305       (output v-date
      306       ,output v-time
      307       ) .
      308     return
      309       p-prefix
      310       + string(v-date, p-date-format)
      311       + p-delimiter
      312       + string(v-time, p-time-format)
      313       + p-suffix
      314       .
      315   end.
      316   function cur-time-print  returns character
      317   :
      318     define variable v-date as date      no-undo .
      319     define variable v-time as integer   no-undo .
      320     run cur-time in this-procedure
      321       (output v-date
      322       ,output v-time
      323       ) .
      324     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      325   end.
      326   function cur-time-datetime returns datetime
      327   :
      328     define variable v-char as character no-undo .
      329     define variable v-datetime as datetime no-undo .
      330     v-char = cur-time-string().
      331     v-datetime = datetime(v-char).
      332     return  v-datetime.
      333   end.
      334   function cur-time-string-msec returns character
      335   :
      336     define variable v-date as datetime  no-undo .
      337     v-date = now.
      338     return string(v-date) .
      339   end.
      340   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      341   define new global shared variable g#lib-nws as handle no-undo .
      342   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      343   procedure gen-b-code :
      344     define input  parameter type-code like ub.code-range.range-type no-undo .
      345     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      346     do
      347     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      348     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      349     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      350     :
      351       define buffer buf_thbj-attr     for ub.thbj-attr .
      352       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      353       define buffer buf_code-range for ub.code-range .
      354       define variable l-code         as   integer              no-undo .
      355       define variable v-db-num       like ub.db.db-num         no-undo .
      356       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      357       if type-code = 'sslc':U
      358       or type-code = 'ssgb':U
      359       then do:
      360         message
      361           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      362           "Обратитесь к администратору системы."
      363           view-as alert-box error .
      364         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      365       end.
      366       run trg/getpcode.p ( input  type-code
      367                      ,output cfg-param-code
      368                     ).
      369       run get-next-seq( input  type-code,
      370                         output l-code
      371                       ).
      372       find first buf_sys-ctrl no-lock.
      373       if type-code = 'sclc':U
      374       or type-code = 'pglc':U
      375       then do:
      376         assign
      377           v-db-num = 0
      378         .
      379       end.
      380       else do:
      381         assign
      382           v-db-num = buf_sys-ctrl.db-num
      383         .
      384       end.
      385       find first buf_code-range no-lock
      386         where buf_code-range.db-num     = v-db-num
      387           and buf_code-range.range-type = type-code
      388           and buf_code-range.stts       = "a"
      389         use-index stts
      390         no-error .
      391       if available buf_code-range
      392          and l-code <= buf_code-range.last-code
      393          and l-code >= buf_code-range.first-code then do:
      394         assign
      395           p-b-code = l-code
      396         .
      397       end.
      398       else do:
      399         if available buf_code-range
      400            and l-code < buf_code-range.last-code then do:
      401           message
      402             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      403             "Обратитесь к администратору системы."
      404             view-as alert-box error .
      405           undo, return error "sequence":U .
      406         end.
      407         do transaction
      408         on error undo, return error
      409         :
      410           find first buf_thbj-attr exclusive-lock
      411             where buf_thbj-attr.upper-prop-code = 'code-range':U
      412               and buf_thbj-attr.prop-code = cfg-param-code
      413               and buf_thbj-attr.obj-type   = 'БД':U
      414               and buf_thbj-attr.obj-code   = v-db-num
      415             no-error .
      416           if not available buf_thbj-attr then do:
      417             find first buf_thbj-attr exclusive-lock
      418               where buf_thbj-attr.upper-prop-code = 'code-range':U
      419                 and buf_thbj-attr.prop-code = cfg-param-code
      420                 and buf_thbj-attr.obj-type   = ''
      421                 and buf_thbj-attr.obj-code   = 0
      422               no-error .
      423             if not available buf_thbj-attr then do:
      424               if not locked buf_thbj-attr then do:
      425                 message
      426                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      427                   "Обратитесь к администратору системы."
      428                   view-as alert-box error .
      429               end.
      430               undo, return error "config":U .
      431             end.
      432           end.
      433           run get-next-seq( input type-code,
      434                             output l-code
      435                           ).
      436           find first buf_code-range
      437             where buf_code-range.db-num     = v-db-num
      438               and buf_code-range.range-type = type-code
      439               and buf_code-range.stts       = "a"
      440             use-index stts
      441             no-error .
      442           if available buf_code-range
      443           and l-code <= buf_code-range.last-code
      444           and l-code >= buf_code-range.first-code
      445           then do:
      446             assign
      447               p-b-code = l-code
      448             .
      449           end.
      450           else do:
      451             if available buf_code-range then do:
      452               assign
      453                 buf_code-range.stts = "u"
      454               .
      455             end.
      456             find first buf_code-range
      457               where buf_code-range.db-num     = v-db-num
      458                 and buf_code-range.range-type = type-code
      459                 and buf_code-range.stts       = "f"
      460               use-index stts
      461               no-error .
      462             if not available buf_code-range then do:
      463               message
      464                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      465                 "Обратитесь к администратору системы"
      466                 view-as alert-box error .
      467               undo, return error "code-range":U .
      468             end.
      469             assign
      470               buf_code-range.stts           = "a"
      471             .
      472             if buf_code-range.first-code = 1 then do:
      473               run set-seq-cr( input type-code,
      474                               input buf_code-range.first-code
      475                             ).
      476               assign
      477                 p-b-code = 1
      478               .
      479             end.
      480             else do:
      481               run set-seq-cr( input type-code,
      482                               input ( buf_code-range.first-code - 1 )
      483                             ).
      484               run get-next-seq( input type-code,
      485                                 output p-b-code
      486                               ).
      487             end.
      488           end.
      489         end.
      490       end.
      491     end.
      492   end procedure.
      493   procedure get-next-seq :
      494     define input  parameter type-code like ub.code-range.range-type no-undo .
      495     define output parameter next-seq  as   integer                  no-undo .
      496     do
      497     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      498     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      499     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      500     :
      501       case type-code:
      502         when 'bcgb':U then do:
      503           assign
      504             next-seq = next-value(s-bcgb-code, ub)
      505           .
      506         end.
      507         when 'scgb':U then do:
      508           assign
      509             next-seq = next-value(s-scgb-code, ub)
      510           .
      511         end.
      512         when 'sclc':U then do:
      513           assign
      514             next-seq = next-value(s-sclc-code, ub)
      515           .
      516         end.
      517         when 'pglc':U then do:
      518           assign
      519             next-seq = next-value(s-pglc-code, ub)
      520           .
      521         end.
      522         when 'dcgb':U then do:
      523           assign
      524             next-seq = next-value(s-dcgb-code, ub)
      525           .
      526         end.
      527         when 'ctgb':U then do:
      528           assign
      529             next-seq = next-value(s-ctgb-code, ub)
      530           .
      531         end.
      532         when 'drgb':U then do:
      533           assign
      534             next-seq = next-value(s-drgb-code, ub)
      535           .
      536         end.
      537         when 'fmgb':U then do:
      538           assign
      539             next-seq = next-value(s-fmgb-code, ub)
      540           .
      541         end.
      542         when 'pngb':U then do:
      543           assign
      544             next-seq = next-value(s-pngb-code, ub)
      545           .
      546         end.
      547         when 'cagb':U then do:
      548           assign
      549             next-seq = next-value(s-cagb-code, ub)
      550           .
      551         end.
      552         when 'fdgb':U then do:
      553           assign
      554             next-seq = next-value(s-fin-doc, ub)
      555           .
      556         end.
      557       end case.
      558     end.
      559   end procedure.
      560   procedure set-seq-cr :
      561     define input parameter type-code like ub.code-range.range-type no-undo .
      562     define input parameter set-val   like ub.code-range.first-code no-undo .
      563     do
      564     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      565     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      566     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      567     :
      568       case type-code:
      569         when 'bcgb':U then do:
      570           assign
      571             current-value(s-bcgb-code, ub) = set-val
      572           .
      573         end.
      574         when 'scgb':U then do:
      575           assign
      576             current-value(s-scgb-code, ub) = set-val
      577           .
      578         end.
      579         when 'sclc':U then do:
      580           assign
      581             current-value(s-sclc-code, ub) = set-val
      582           .
      583         end.
      584         when 'pglc':U then do:
      585           assign
      586             current-value(s-pglc-code, ub) = set-val
      587           .
      588         end.
      589         when 'dcgb':U then do:
      590           assign
      591             current-value(s-dcgb-code, ub) = set-val
      592           .
      593         end.
      594         when 'ctgb':U then do:
      595           assign
      596             current-value(s-ctgb-code, ub) = set-val
      597           .
      598         end.
      599         when 'drgb':U then do:
      600           assign
      601             current-value(s-drgb-code, ub) = set-val
      602           .
      603         end.
      604         when 'fmgb':U then do:
      605           assign
      606             current-value(s-fmgb-code, ub) = set-val
      607           .
      608         end.
      609         when 'pngb':U then do:
      610           assign
      611             current-value(s-pngb-code, ub) = set-val
      612           .
      613         end.
      614         when 'cagb':U then do:
      615           assign
      616             current-value(s-cagb-code, ub) = set-val
      617           .
      618         end.
      619         when 'fdgb':U then do:
      620           assign
      621             current-value(s-fin-doc, ub) = set-val
      622           .
      623         end.
      624       end case.
      625     end.
      626   end procedure.
      627   procedure new-bcod-gen-code-range :
      628     do
      629     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      630     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      631     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      632     :
      633       define input parameter p-db-num  like ub.db.db-num             no-undo .
      634       define input parameter type-code like ub.code-range.range-type no-undo .
      635       define buffer buf_code-range      for ub.code-range .
      636       define buffer last_code-range     for ub.code-range .
      637       define buffer last-1_code-range   for ub.code-range .
      638       define buffer last-2_code-range   for ub.code-range .
      639       define buffer last-3_code-range   for ub.code-range .
      640       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      641       define variable conf-par       as character no-undo .
      642       define variable par-type       as character no-undo .
      643       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      644       define variable v-cre-cdrg as logical   no-undo .
      645       define variable v-cre-str  as character no-undo .
      646       define variable v-cr1      as integer no-undo .
      647       define variable v-cr2      as integer no-undo .
      648       define variable v-cr3      as integer no-undo .
      649       define variable v-cmax     as integer no-undo .
      650       find first buf_sys-ctrl no-lock .
      651       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      652         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      653                                       ,vss-workfile
      654                                       ,vss-revision
      655                                       ,vss-description
      656                                       ,chr(10)
      657                                       , p-db-num
      658                                      ).
      659       end.
      660       run trg/getpcode.p ( input  type-code
      661                      ,output cfg-param-code
      662                     ).
      663       for each buf_code-range
      664         where buf_code-range.db-num     = -1
      665           and buf_code-range.range-type = type-code
      666           and buf_code-range.stts       = "f"
      667       by buf_code-range.first-code
      668       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      669       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      670       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      671       :
      672         assign
      673           buf_code-range.db-num = p-db-num
      674         .
      675         return .
      676       end.
      677       assign
      678         v-cre-cdrg = TRUE
      679       .
      680       case type-code:
      681         when 'sclc':U
      682         or when 'scgb':U
      683         or when 'pglc':U
      684         then do:
      685           find last last-1_code-range no-lock
      686             where last-1_code-range.range-type = 'sclc':U
      687             no-error .
      688           if available last-1_code-range then do:
      689             v-cr1 = last-1_code-range.last-code.
      690           end.
      691           find last last-2_code-range no-lock
      692             where last-2_code-range.range-type = 'scgb':U
      693             no-error .
      694           if available last-2_code-range then do:
      695             v-cr2 = last-2_code-range.last-code.
      696             end.
      697           find last last-3_code-range no-lock
      698             where last-3_code-range.range-type = 'pglc':U
      699             no-error .
      700           if available last-3_code-range then do:
      701             v-cr3 = last-3_code-range.last-code.
      702           end.
      703           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      704           .
      705           if v-cmax = v-cr1  then do:
      706               find last last_code-range no-lock
      707                 where recid( last_code-range ) = recid( last-1_code-range )
      708                 .
      709             end.
      710           if v-cmax = v-cr2  then do:
      711               find last last_code-range no-lock
      712                 where recid( last_code-range ) = recid( last-2_code-range )
      713                 .
      714             end.
      715           if v-cmax = v-cr3  then do:
      716             find last last_code-range no-lock
      717               where recid( last_code-range ) = recid( last-3_code-range )
      718               .
      719           end.
      720           if last_code-range.last-code + 1 > 99999 then do:
      721             assign
      722               v-cre-cdrg = FALSE
      723             .
      724           end.
      725         end.
      726         when 'bcgb':U
      727         or when 'sslc':U
      728         or when 'ssgb':U
      729         then do:
      730           find last last-1_code-range no-lock
      731             where last-1_code-range.range-type = 'sslc':U
      732             no-error .
      733           if available last-1_code-range then do:
      734             v-cr1 = last-1_code-range.last-code.
      735           end.
      736           find last last-2_code-range no-lock
      737             where last-2_code-range.range-type = 'bcgb':U
      738             no-error .
      739           if available last-2_code-range then do:
      740             v-cr2 = last-2_code-range.last-code.
      741             end.
      742           find last last-3_code-range no-lock
      743             where last-3_code-range.range-type = 'ssgb':U
      744             no-error .
      745           if available last-3_code-range then do:
      746             v-cr3 = last-3_code-range.last-code.
      747           end.
      748           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      749           .
      750           if v-cmax = v-cr1  then do:
      751               find last last_code-range no-lock
      752                 where recid( last_code-range ) = recid( last-1_code-range )
      753                 .
      754             end.
      755           if v-cmax = v-cr2  then do:
      756               find last last_code-range no-lock
      757                 where recid( last_code-range ) = recid( last-2_code-range )
      758                 .
      759             end.
      760           if v-cmax = v-cr3  then do:
      761             find last last_code-range no-lock
      762               where recid( last_code-range ) = recid( last-3_code-range )
      763               .
      764           end.
      765         end.
      766         otherwise do:
      767           find last last_code-range no-lock
      768             where last_code-range.range-type = type-code
      769             no-error .
      770         end.
      771       end case.
      772       if not available last_code-range then do:
      773         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      774                                       ,vss-workfile
      775                                       ,vss-revision
      776                                       ,vss-description
      777                                       , chr(10)
      778                                       , type-code
      779                                      ) .
      780       end.
      781       define variable v-mes3 as character no-undo .
      782       define variable v-param-type3 as character no-undo .
      783       define variable v-value-character3 as INTEGER no-undo .
      784       define variable v-value-date3 as date no-undo .
      785       define variable v-value-decimal3 as decimal no-undo .
      786       define variable v-value-integer3 AS integer no-undo .
      787       define variable v-value-logical3 AS LOGICAL no-undo .
      788       define variable v-tth3 as handle no-undo .
      789       run adm/shattri.p (
      790           input "get":U
      791           ,input  'БД':U
      792           ,input  p-db-num
      793           ,input  'code-range':U
      794           ,input  cfg-param-code
      795           ,output v-value-character3
      796           ,output v-value-date3
      797           ,output v-value-decimal3
      798           ,output v-value-integer3
      799           ,output v-value-logical3
      800           ,output v-param-type3
      801           ,INPUT-OUTPUT table-handle v-tth3
      802           ) no-error .
      803       if error-status :error then do:
      804         delete object v-tth3.
      805         v-mes3 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      806                            , error-status:get-message(1)
      807                            , chr(10)
      808                            , return-value ).
      809         undo, return error v-mes3.
      810       end.
      811       delete object v-tth3.
      812       if v-cre-cdrg = TRUE then do:
      813         create buf_code-range .
      814         assign
      815           buf_code-range.db-num     = p-db-num
      816           buf_code-range.range-type = type-code
      817           buf_code-range.stts       = "f"
      818           buf_code-range.first-code = last_code-range.last-code + 1
      819           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer3)
      820           v-cre-str = "Свободный диапазон успешно создан"
      821         .
      822       end.
      823       else do:
      824         assign
      825           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      826                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      827         .
      828       end.
      829     end.
      830     return v-cre-str .
      831   end procedure.
      832   procedure gen-new-code-range-if-neces :
      833     define input parameter v-db-num           like ub.db.db-num             no-undo .
      834     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      835     define input parameter v-cur-code         as   integer                  no-undo .
      836     define input parameter v-g#news           as   logical                  no-undo .
      837     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      838     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      839     do
      840     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      841     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      842     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      843     :
      844       define variable l-code-range-exist as logical   no-undo init false .
      845       define variable v-db-for-send      as character no-undo .
      846       define buffer buf_code-range  for ub.code-range .
      847       define buffer buf1_code-range for ub.code-range .
      848       define buffer buf_db          for ub.db .
      849       find first buf_code-range
      850         where buf_code-range.range-type = v-range-type
      851           and buf_code-range.last-code >= v-cur-code
      852         use-index last-codei
      853         no-error .
      854       if
      855       (
      856          available buf_code-range
      857          and
      858         (buf_code-range.db-num = v-db-num
      859           and
      860         buf_code-range.first-code <= v-cur-code
      861         )
      862       or
      863         (
      864           v-range-type = 'drgb':U
      865           AND
      866           v-cur-code = 0
      867         )
      868      )
      869      then do:
      870         assign
      871           l-code-range-exist = true
      872         .
      873         if v-g#news
      874         and buf_code-range.stts = "f" then do:
      875           assign
      876             buf_code-range.stts = "u"
      877           .
      878         end.
      879       end.
      880       if not l-code-range-exist
      881          and v-g#news-source-db <> 0
      882       then do:
      883         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      884                                       ,vss-workfile
      885                                       ,vss-revision
      886                                       ,vss-description
      887                                       ,chr(10)
      888                                       ,v-db-num
      889                                       ,v-range-type
      890                                       ,v-cur-code
      891                                      ).
      892       end.
      893       if (not l-code-range-exist
      894           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      895          )
      896       and ( not can-find (first buf1_code-range no-lock
      897                           where buf1_code-range.db-num = v-db-num
      898                             and buf1_code-range.range-type = v-range-type
      899                             and buf1_code-range.stts = "f"
      900                          )
      901           )
      902       then do:
      903         if v-g#db-num = 0 then do:
      904           run new-bcod-gen-code-range in this-procedure
      905             (input v-db-num,
      906              input v-range-type
      907             ) no-error .
      908           if error-status :error then do:
      909             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      910                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      911                                           ,v-db-num
      912                                           ,v-range-type
      913                                           ,v-cur-code
      914                                           ,chr(10)
      915                                           ,error-status:get-message(1)
      916                                           ,return-value
      917                                          ).
      918           end.
      919         end.
      920         else do:
      921           if v-range-type = 'sclc':U
      922           or v-range-type = 'pglc':U
      923           then do:
      924             assign
      925               v-db-for-send = "":U
      926             .
      927             if v-g#db-num = 0 then do:
      928               for each buf_db no-lock
      929                 where buf_db.db-num > 0
      930                   and buf_db.db-num <> v-g#news-source-db
      931               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      932               :
      933                 assign
      934                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      935                 .
      936               end.
      937               assign
      938                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      939               .
      940             end.
      941             else do:
      942               if not v-g#news then do:
      943                 assign
      944                   v-db-for-send = "0":U
      945                 .
      946               end.
      947             end.
      948             run nws/cr-route.p ( input 'send-cmd':U
      949                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      950                                  "code-range":U + chr(1) +
      951                                  (if v-range-type = 'sclc':U
      952                                   then string( current-value(s-sclc-code, ub))
      953                                   else string( current-value(s-pglc-code, ub))
      954                                   ) + chr(1) +
      955                                   v-range-type)
      956                           ,input ?
      957                           ,input v-db-for-send
      958                           ) no-error .
      959             if error-status :error then do:
      960               undo, return error return-value.
      961             end.
      962           end.
      963         end.
      964       end.
      965     end.
      966   end procedure.
      967   procedure cre-loc-sc-code-range :
      968     define input parameter v-cur-code as integer no-undo .
      969   define input parameter p-cdrg-type as character no-undo .
      970     do
      971     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      972     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      973     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      974     :
      975       define buffer buf_code-range for ub.code-range .
      976       find first buf_code-range
      977            where buf_code-range.range-type = p-cdrg-type
      978              and buf_code-range.first-code >= v-cur-code
      979            no-error .
      980       if not available buf_code-range then do:
      981         run new-bcod-gen-code-range in this-procedure
      982           ( input 0,
      983             input p-cdrg-type
      984           ) no-error .
      985         if error-status :error then do:
      986           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      987                                          + "Код &2&1&3 &4"
      988                                         , chr(10)
      989                                         , v-cur-code
      990                                         , error-status:get-message(1)
      991                                         , return-value
      992                                        ) .
      993         end.
      994       end.
      995     end.
      996   end procedure.
      997   procedure mark-used-if-need :
      998   define input parameter p-cur-code as integer no-undo .
      999   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1000   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1001     do
     1002     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1003     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1004     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1005     :
     1006       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1007       define buffer buf_code-range for ub.code-range .
     1008       assign
     1009       v-db-num = if p-range-type = 'sclc':U
     1010                  then 0
     1011                  else p-db-num
     1012       .
     1013   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1014   define buffer locK-batchprocess4 for ub.batchprocess.
     1015   run gbl/lock-prc.p
     1016       (input 'lscc':U
     1017       ,input 0
     1018       ,input 0
     1019       ,input 0
     1020       ,input ""
     1021       ,input ""
     1022       ,input ""
     1023       ,input (
     1024               ",,,Вкл/выкл лок. вес. кодов"
     1025              )
     1026       ,input true
     1027       ,buffer lock-batchprocess4
     1028       ) no-error .
     1029     if error-status :error then do:
     1030       message
     1031         vss-workfile vss-revision vss-description skip
     1032         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1033         view-as alert-box error .
     1034       undo, return error .
     1035     end.
     1036       find first buf_code-range
     1037            where buf_code-range.range-type = p-range-type
     1038              and buf_code-range.first-code >= p-cur-code
     1039              and buf_code-range.last-code <= p-cur-code
     1040              and buf_code-range.db-num = v-db-num
     1041            no-error .
     1042       if not available buf_code-range then do:
     1043         message
     1044           vss-workfile vss-revision vss-description skip
     1045           "Ошибка при создании поиске диапазона" skip
     1046           "База данных" p-db-num skip
     1047           "Код" p-cur-code skip
     1048           "Тип" p-range-type
     1049           error-status :get-message(1) skip
     1050           return-value skip
     1051           view-as alert-box error .
     1052         undo, return error .
     1053       end.
     1054       if buf_code-range.stts = "f":U then do:
     1055         assign
     1056         buf_code-range.stts = "u":U
     1057         .
     1058       end.
     1059     end.
     1060   end procedure.
     1061   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1062   define variable send-ref as logical no-undo.
     1063     define variable dops as character no-undo format "X(250)".
     1064     define variable dopst as character no-undo format "X(1)".
     1065   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1066     (input  'send-ref'
     1067     ,input  0
     1068     ,input  ''
     1069     ,input  0
     1070     ,input  ''
     1071     ,input  ''
     1072     ,input  ''
     1073     ,input  no
     1074     ,output dops
     1075     ,output dopst
     1076     ) no-error .
     1077     send-ref = (IF error-status:error or dops <> "yes" then no else yes).
     1078   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   procedure gen-key-rec :
     1081     define input  parameter p-tbl-name    as character no-undo.
     1082     define input  parameter p-bh_tbl-name as handle    no-undo.
     1083     define output parameter p-key-rec     as character no-undo.
     1084     do
     1085     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1086     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1087     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1088     :
     1089       define variable fh               as handle    no-undo .
     1090       define variable v-ok             as logical   no-undo .
     1091       define variable v-inform         as character no-undo .
     1092       define variable v-ind            as integer   no-undo .
     1093       define variable v-idx-field-qnty as integer   no-undo .
     1094       if p-tbl-name = ?
     1095         or p-tbl-name = "":U
     1096       then do:
     1097         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
     1098       end.
     1099       if not p-bh_tbl-name:available then do:
     1100         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
     1101       end.
     1102       assign
     1103         p-key-rec = p-tbl-name
     1104         v-inform  = p-bh_tbl-name:index-information(1)
     1105         v-ind     = 2
     1106       .
     1107       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1108       on error undo, return error
     1109       :
     1110         assign
     1111           v-inform = p-bh_tbl-name:index-information( v-ind )
     1112           v-ind    = v-ind + 1
     1113         .
     1114       end.
     1115       if v-inform = ?
     1116         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1117         or entry( 3, v-inform, ",":U ) <> "1":U
     1118       then do:
     1119         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
     1120       end.
     1121       else do:
     1122         assign
     1123           v-idx-field-qnty = num-entries( v-inform ) - 4
     1124         .
     1125         if v-idx-field-qnty < 2 then do:
     1126           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
     1127         end.
     1128         do v-ind = 1 to v-idx-field-qnty by 2
     1129         on error undo, return error
     1130         :
     1131           assign
     1132             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1133             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1134           .
     1135         end.
     1136       end.
     1137       if p-key-rec = ? then do:
     1138         assign
     1139           p-key-rec = "":U
     1140         .
     1141         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
     1142       end.
     1143     end.
     1144     return.
     1145   end procedure.
     1146   procedure gen-where-keyr-tab :
     1147     define input  parameter i-tableSerach as character no-undo.
     1148     define input  parameter i-tablekey   as character  no-undo.
     1149     define input  parameter p-key-rec    as character  no-undo.
     1150     define input  parameter p-key-handle as handle     no-undo .
     1151     define input  parameter p-db-name    as character  no-undo .
     1152     define input  parameter p-tt-handle  as handle     no-undo .
     1153     define output parameter o-Where      as character  no-undo.
     1154     do
     1155     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1156     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1157     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1158     :
     1159       define variable v-full-tbl-name  as character no-undo .
     1160       define variable bh_tbl-name      as handle    no-undo .
     1161       define variable fh_key           as handle    no-undo .
     1162       define variable fh_search        as handle    no-undo .
     1163       define variable v-field-num      as integer   no-undo .
     1164       define variable v-count-fld      as integer   no-undo .
     1165       define variable v-inform         as character no-undo .
     1166       define variable v-ind            as integer   no-undo .
     1167       define variable v-idx-field-qnty as integer   no-undo .
     1168       define variable v-field-name     as character no-undo .
     1169       define variable v-field-val      as character no-undo .
     1170       define variable v-word-link      as character no-undo .
     1171       define variable vTable           as character no-undo.
     1172       define variable bh_tbl-key       as handle    no-undo .
     1173       assign
     1174         p-key-rec = trim( p-key-rec )
     1175       .
     1176       if p-key-handle <> ? then do:
     1177         if not valid-handle(p-key-handle)
     1178            or p-key-handle:type <> "buffer"
     1179         then do:
     1180           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
     1181         end.
     1182         if num-entries( p-key-rec, chr(3) ) > 1
     1183           or p-key-rec = ?
     1184           or p-key-rec = "":U
     1185         then do:
     1186           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
     1187         end.
     1188       end.
     1189       else do:
     1190         if p-key-rec = ?
     1191           or p-key-rec = "":U
     1192         then do:
     1193           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1194         end.
     1195       end.
     1196       assign
     1197         vTable = entry( 1 , p-key-rec, chr(3) )
     1198       .
     1199       if p-tt-handle <> ?
     1200         and ( not valid-handle(p-tt-handle)
     1201               or p-tt-handle:type <> "buffer"
     1202             )
     1203       then do:
     1204         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
     1205       end.
     1206       if p-tt-handle = ? then do:
     1207         assign
     1208           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1209         .
     1210         create buffer bh_tbl-name for table v-full-tbl-name .
     1211       end.
     1212       else do:
     1213         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1214       end.
     1215       assign
     1216         v-inform = bh_tbl-name:index-information(1)
     1217         v-ind    = 2
     1218       .
     1219       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1220       on error undo, return error
     1221       :
     1222         assign
     1223           v-inform = bh_tbl-name:index-information( v-ind )
     1224           v-ind    = v-ind + 1
     1225         .
     1226       end.
     1227       if v-inform = ?
     1228         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1229         or entry( 3, v-inform, ",":U ) <> "1":U
     1230       then do:
     1231         delete object bh_tbl-name no-error.
     1232         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
     1233       end.
     1234       assign
     1235         v-idx-field-qnty = num-entries( v-inform ) - 4
     1236       .
     1237       if v-idx-field-qnty < 2 then do:
     1238         delete object bh_tbl-name no-error.
     1239         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
     1240       end.
     1241       assign
     1242         o-where     = "where":U
     1243         v-word-link = "":U
     1244         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1245         v-count-fld = 0
     1246       .
     1247       if i-tablekey ne "" and i-tablekey ne ?
     1248       then do:
     1249         assign
     1250           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1251         .
     1252         create buffer bh_tbl-key for table v-full-tbl-name .
     1253       end.
     1254       if i-tableSerach ne "" and i-tableSerach ne ?
     1255       then do:
     1256         delete object bh_tbl-name no-error.
     1257         assign
     1258           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1259         .
     1260         create buffer bh_tbl-name for table v-full-tbl-name .
     1261       end.
     1262       block_where:
     1263       do v-ind = 1 to v-idx-field-qnty by 2
     1264       on error undo, return error
     1265       :
     1266         assign
     1267           v-count-fld = v-count-fld + 1
     1268         .
     1269         if p-key-handle = ?
     1270           and v-count-fld > v-field-num
     1271         then do:
     1272           leave block_where.
     1273         end.
     1274         define variable VfieldKeyTable as handle no-undo.
     1275         assign
     1276           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1277           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1278         .
     1279         if     bh_tbl-key ne ?
     1280         then do:
     1281            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1282            if VfieldKeyTable eq ?
     1283            then next block_where.
     1284         end.
     1285         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1286         then
     1287            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1288         else
     1289            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1290         if p-key-handle = ? then do:
     1291           assign
     1292             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1293           .
     1294         end.
     1295         else do:
     1296           assign
     1297             fh_key = p-key-handle:buffer-field( v-field-name )
     1298           .
     1299           if fh_key = ?
     1300             or not valid-handle( fh_key )
     1301           then do:
     1302             delete object bh_tbl-name.
     1303             if     bh_tbl-key ne ?
     1304             then
     1305                delete object bh_tbl-key.
     1306             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
     1307           end.
     1308           assign
     1309             v-field-val = fh_key:buffer-value
     1310           .
     1311         end.
     1312         if fh_search:data-type ="character":U then do:
     1313           assign
     1314             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1315             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1316             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1317             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1318             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1319             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1320             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1321             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1322             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1323             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1324             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1325             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1326             v-field-val = substitute( '"&1"', v-field-val )
     1327           .
     1328         end.
     1329         assign
     1330           o-where = substitute( "&1 &2", o-where, v-field-val )
     1331         .
     1332         if v-word-link = "":U then do:
     1333           assign
     1334             v-word-link = "and":U
     1335           .
     1336         end.
     1337       end.
     1338       delete object bh_tbl-name.
     1339       if     bh_tbl-key ne ?
     1340       then
     1341          delete object bh_tbl-key.
     1342       if p-key-handle = ?
     1343         and v-count-fld <> v-field-num
     1344       then do:
     1345         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
     1346       end.
     1347     end.
     1348   end procedure.
     1349   procedure gen-hn-keyr-tab :
     1350     define input  parameter i-tableSerach as character no-undo.
     1351     define input  parameter i-tablekey   as character no-undo.
     1352     define input  parameter p-key-rec    as character no-undo.
     1353     define input  parameter p-key-handle as handle    no-undo .
     1354     define input  parameter p-db-name    as character no-undo .
     1355     define input  parameter p-tt-handle  as handle    no-undo .
     1356     define input  parameter p-stts-lock  as integer   no-undo .
     1357     define output parameter o-hn         as handle    no-undo.
     1358     define variable v-full-tbl-name as character no-undo.
     1359     define variable v-where         as character no-undo.
     1360     define variable bh_tbl-name     as handle    no-undo.
     1361     define variable vTable          as character no-undo.
     1362     do
     1363     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1364     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1365     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1366         run gen-where-keyr-tab(i-tableSerach,
     1367                                i-tablekey,
     1368                                p-key-rec,
     1369                                p-key-handle,
     1370                                p-db-name,
     1371                                p-tt-handle,
     1372                                output v-where).
     1373         if i-tableSerach ne "" and i-tableSerach ne ?
     1374         then do:
     1375            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1376            create buffer bh_tbl-name for table v-full-tbl-name .
     1377         end.
     1378         else do:
     1379            if p-tt-handle = ? then do:
     1380               assign
     1381                  vTable = entry( 1 , p-key-rec, chr(3) )
     1382               .
     1383               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1384               create buffer bh_tbl-name for table v-full-tbl-name .
     1385            end.
     1386            else do:
     1387               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1388            end.
     1389         end.
     1390         if p-tt-handle = ? then do:
     1391            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1392         end.
     1393         else do:
     1394            bh_tbl-name:find-first( v-where ) no-error .
     1395         end.
     1396         o-hn = bh_tbl-name.
     1397      end.
     1398   end procedure.
     1399   procedure gen-hn-keyr :
     1400     define input  parameter p-key-rec    as character no-undo.
     1401     define input  parameter p-key-handle as handle    no-undo .
     1402     define input  parameter p-db-name    as character no-undo .
     1403     define input  parameter p-tt-handle  as handle    no-undo .
     1404     define input  parameter p-stts-lock  as integer   no-undo .
     1405     define output parameter o-hn         as handle    no-undo.
     1406     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1407   end.
     1408   procedure gen-row-keyr :
     1409     define input  parameter p-key-rec    as character no-undo.
     1410     define input  parameter p-key-handle as handle    no-undo .
     1411     define input  parameter p-db-name    as character no-undo .
     1412     define input  parameter p-tt-handle  as handle    no-undo .
     1413     define input  parameter p-stts-lock  as integer   no-undo .
     1414     define output parameter p-tbl-row    as rowid     no-undo.
     1415     define output parameter p-tbl-name   as character no-undo.
     1416     define variable vHn as handle no-undo.
     1417       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1418       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1419       p-tbl-name =  vHn:table.
     1420       delete object vHn no-error.
     1421     if p-tbl-row = ? then do:
     1422       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1423     end.
     1424     else do:
     1425       return.
     1426     end.
     1427   end procedure.
     1428   procedure gen-key-fv :
     1429     define input  parameter p-key-rec    as character no-undo .
     1430     define output parameter p-field-list as character no-undo .
     1431     define output parameter p-value-list as character no-undo.
     1432     do
     1433     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1434     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1435     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1436     :
     1437       define variable v-full-tbl-name  as character no-undo .
     1438       define variable bh_tbl-name      as handle    no-undo .
     1439       define variable v-tbl-name       as character no-undo .
     1440       define variable v-field-num      as integer   no-undo .
     1441       define variable v-count-fld      as integer   no-undo .
     1442       define variable v-inform         as character no-undo .
     1443       define variable v-ind            as integer   no-undo .
     1444       define variable v-idx-field-qnty as integer   no-undo .
     1445       define variable v-delim-key      as character no-undo .
     1446       if p-key-rec = ?
     1447         or p-key-rec = "":U
     1448       then do:
     1449         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1450       end.
     1451       assign
     1452         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1453         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1454       .
     1455       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1456       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1457       assign
     1458         v-inform = bh_tbl-name:index-information(1)
     1459         v-ind    = 2
     1460       .
     1461       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1462       on error undo, return error
     1463       :
     1464         assign
     1465           v-inform = bh_tbl-name:index-information( v-ind )
     1466           v-ind    = v-ind + 1
     1467         .
     1468       end.
     1469       if v-inform = ?
     1470         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1471         or entry( 3, v-inform, ",":U ) <> "1":U
     1472       then do:
     1473         delete object bh_tbl-name no-error.
     1474         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1475       end.
     1476       assign
     1477         v-idx-field-qnty = num-entries( v-inform ) - 4
     1478       .
     1479       if v-idx-field-qnty < 2 then do:
     1480         delete object bh_tbl-name no-error.
     1481         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1482       end.
     1483       assign
     1484         p-field-list = "":U
     1485         p-value-list = "":U
     1486         v-delim-key  = "":U
     1487         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1488         v-count-fld  = 0
     1489       .
     1490       block_where:
     1491       do v-ind = 1 to v-idx-field-qnty by 2
     1492       on error undo, return error
     1493       :
     1494         assign
     1495           v-count-fld = v-count-fld + 1
     1496         .
     1497         if v-count-fld > v-field-num then do:
     1498           leave block_where.
     1499         end.
     1500         assign
     1501           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1502           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1503         .
     1504         if v-ind = 1 then do:
     1505           assign
     1506             v-delim-key = chr(3)
     1507           .
     1508         end.
     1509       end.
     1510       delete object bh_tbl-name.
     1511       if v-count-fld <> v-field-num then do:
     1512         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1513       end.
     1514     end.
     1515   end procedure.
     1516   procedure gen-key-field :
     1517     define input  parameter p-table      as character no-undo .
     1518     define output parameter p-field-list as character no-undo .
     1519     do
     1520     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1521     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1522     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1523     :
     1524       define variable v-full-tbl-name  as character no-undo .
     1525       define variable bh_tbl-name      as handle    no-undo .
     1526       define variable v-tbl-name       as character no-undo .
     1527       define variable v-field-num      as integer   no-undo .
     1528       define variable v-count-fld      as integer   no-undo .
     1529       define variable v-inform         as character no-undo .
     1530       define variable v-ind            as integer   no-undo .
     1531       define variable v-idx-field-qnty as integer   no-undo .
     1532       define variable v-delim-key      as character no-undo .
     1533       if p-table = ?
     1534         or p-table = "":U
     1535       then do:
     1536         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1537       end.
     1538       assign
     1539         v-tbl-name      = p-table
     1540         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1541       .
     1542       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1543       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1544       assign
     1545         v-inform = bh_tbl-name:index-information(1)
     1546         v-ind    = 2
     1547       .
     1548       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1549       on error undo, return error
     1550       :
     1551         assign
     1552           v-inform = bh_tbl-name:index-information( v-ind )
     1553           v-ind    = v-ind + 1
     1554         .
     1555       end.
     1556       if v-inform = ?
     1557         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1558         or entry( 3, v-inform, ",":U ) <> "1":U
     1559       then do:
     1560         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1561       end.
     1562       assign
     1563         v-idx-field-qnty = num-entries( v-inform ) - 4
     1564       .
     1565       if v-idx-field-qnty < 2 then do:
     1566         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1567       end.
     1568       assign
     1569         p-field-list = "":U
     1570         v-delim-key  = "":U
     1571         v-count-fld  = 0
     1572       .
     1573       block_where:
     1574       do v-ind = 1 to v-idx-field-qnty by 2
     1575       on error undo, return error
     1576       :
     1577         assign
     1578           v-count-fld = v-count-fld + 1
     1579         .
     1580         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1581         if v-ind = 1 then do:
     1582           assign
     1583             v-delim-key = chr(3)
     1584           .
     1585         end.
     1586       end.
     1587       delete object bh_tbl-name.
     1588     end.
     1589   end procedure.
