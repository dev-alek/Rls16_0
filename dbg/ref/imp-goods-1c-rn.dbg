     7154     v-addunits = p-GdsObj:unit-add-codes .
     7155     if valid-object (v-addunits) then do :
     7156       // буфер с импортируемым товаром мог уйти с записи в цикле создания баркодов
     7157       find first buf_goods no-lock where buf_goods.gds-code = v-gds-code no-error .
     7158       if not available buf_goods then
