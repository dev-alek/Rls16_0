        1   DEFINE BUFFER X_rule-profile FOR ub.rule-profile.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-bttns as character no-undo .
        4   define input parameter p-list-mode as character no-undo .
        5   DEFINE INPUT-OUTPUT PARAMETER p-ref-list AS CHARACTER NO-UNDO.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Список частных итогов для типов ДК".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define variable v-waitfram-action01         as character   no-undo .
       68   define variable v-waitfram-action02         as character   no-undo .
       69   define variable v-waitfram-action03         as character   no-undo .
       70   define variable mWaitFramTextBeg            as character   no-undo.
       71   define variable mWaitFramTextEnd            as character   no-undo.
       72   define variable mWaitFramView               as logical     no-undo.
       73   define variable mWaitProcEvent              as logical     no-undo init yes.
       74   define variable mWaitFramInterval           as integer     no-undo init 1 .
       75   define variable mWaitFramStop               as logical     no-undo.
       76   define variable mWaitFramStopUser           as logical     no-undo.
       77   define variable mWaitFramStopTimeOut        as logical     no-undo.
       78   define variable mWaitFramStartProc          as datetime-tz no-undo.
       79   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       80   define button B-WaitFramStop auto-end-key
       81        label "Стоп"
       82        size 10 by 1 tooltip "Остоновить процесс".
       83   define button B-viewProcInfo
       84        label "Информация"
       85        size 15 by 1 tooltip "Информация о процесс".
       86   define frame waitfram
       87     v-waitfram-action01 format "x(72)" no-label skip
       88     v-waitfram-action02 format "x(72)" no-label skip
       89     v-waitfram-action03 format "x(72)" no-label skip
       90     B-viewProcInfo
       91     B-WaitFramStop at row 4 col 30
       92     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       93     .
       94   define new global shared variable mBatchMode as logical no-undo init ?.
       95   define variable mFramBachModHandle as handle no-undo.
       96   mFramBachModHandle = frame waitfram:handle.
       97   define variable mFameOldVis as logical no-undo.
       98   define variable mVisCUrentVin as logical no-undo.
       99   if session:batch-mode
      100   then
      101      mBatchMode = yes.
      102   if mBatchMode = ? then do:
      103     mVisCUrentVin = current-window:visible.
      104     mFameOldVis = mFramBachModHandle:visible.
      105     mFramBachModHandle:visible  = yes.
      106     mBatchMode = mFramBachModHandle:visible ne yes.
      107     mFramBachModHandle:visible = mFameOldVis.
      108     current-window:visible = mVisCUrentVin.
      109   end.
      110    if  log-manager:logfile-name ne ?
      111     then DO:
      112         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      113         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      114         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      115     end.
      116   on choose of B-WaitFramStop in frame waitfram
      117   do:
      118     mWaitFramStop = yes.
      119     mWaitFramStopUser = yes.
      120   end.
      121   function waitfram-check-timeout returns logical():
      122      define variable vtime as int64 no-undo.
      123      if mWaitFramStopTimeOut
      124      then
      125         return yes.
      126      vtime = ( now - mWaitFramStartProc ) / 1000 .
      127      if     mWaitFramTimeOut ne ?
      128         and mWaitFramTimeOut ne 0
      129         and mWaitFramTimeOut lt vtime
      130      then do:
      131         mWaitFramStopTimeOut = yes.
      132      end.
      133      return mWaitFramStopTimeOut.
      134   end.
      135   procedure waitfram-hide :
      136     if not session:batch-mode
      137     then do
      138     on error undo, return error return-value
      139     :
      140       pause 0 before-hide .
      141       if not mBatchMode then
      142         hide frame waitfram .
      143     if     not mWaitFramView
      144        and mWaitProcEvent
      145     then
      146       process events .
      147     end.
      148   end procedure.
      149   procedure waitfram-show :
      150     define input  parameter p-message as character no-undo .
      151     define variable v-left-margin as integer   no-undo .
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       if length(p-message) <= 70 then do:
      157         assign
      158           v-left-margin = integer((70 - length(p-message)) / 2)
      159         .
      160         assign
      161           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      162         .
      163         assign
      164           v-waitfram-action01 = " "
      165           v-waitfram-action02 = " "
      166                                    + fill(" ", v-left-margin)
      167                                    + p-message
      168           v-waitfram-action03 = " "
      169         .
      170       end.
      171       else do:
      172         define variable vRindex1 as integer no-undo.
      173         define variable vRindex2 as integer no-undo.
      174         vRindex1 = r-index(p-message," ",70).
      175         if vRindex1 = 0
      176         then
      177            vRindex1 = 70.
      178         if length(p-message)  <= vRindex1 + 70 then do:
      179           assign
      180             v-waitfram-action01 = " "
      181             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      182             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      183           .
      184         end.
      185         else do:
      186           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      187           if vRindex2 <= vRindex1
      188           then
      189              vRindex2 = vRindex1 + 70.
      190           assign
      191             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      192             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      194           .
      195         end.
      196       end.
      197       B-viewProcInfo:visible   in frame waitfram = no.
      198       B-viewProcInfo:sensitive in frame waitfram = no.
      199       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       if  (   mWaitFramView
      202          or  mWaitProcEvent)
      203          and not mBatchMode
      204       then
      205          display
      206             v-waitfram-action01 skip
      207             v-waitfram-action02 skip
      208             v-waitfram-action03 skip
      209          with frame waitfram .
      210       if     mWaitFramView
      211          then do:
      212             if     mWaitFramInterval ne ?
      213                and not mBatchMode
      214             then
      215                wait-for go of frame waitfram pause mWaitFramInterval.
      216          end.
      217          else
      218             if     mWaitProcEvent
      219                and not mBatchMode
      220             then
      221                process events .
      222     end.
      223   end procedure.
      224      procedure waitfram-show-this:
      225         define input  parameter iInterval as int64 no-undo.
      226         define variable vtime as int64 no-undo.
      227         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      228         mWaitFramInterval = iInterval.
      229         run waitfram-show (substitute("&1&2 &3&4" ,
      230                                       mWaitFramTextBeg ,
      231                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      232                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      233                                       mWaitFramTextEnd
      234                                      )
      235                           ).
      236      end.
      237      procedure WaitFramRunPause:
      238         define input  parameter iInterval as dec no-undo.
      239         define variable vStart  as datetime-tz no-undo.
      240         define variable vend    as datetime-tz no-undo.
      241         define variable vint as int64 no-undo.
      242         define variable vOk as logical no-undo.
      243         vStart = now.
      244         vend   = vStart.
      245         publish "WaitFramPause" (iInterval,output vOk).
      246         vend   =  now.
      247         vint = vend - vStart.
      248         vint = iInterval - vint / 1000.
      249         if     not mWaitFramStop
      250            and (   vint > 0
      251                 or (    not vOk
      252                     and iInterval eq ?
      253                     )
      254                 )
      255         then
      256            run waitfram-show-this (iInterval).
      257         vend   =  now.
      258         vint = vend - vStart.
      259         vint = iInterval - vint / 1000.
      260         if     not mWaitFramStop
      261            and vint > 0
      262         then do:
      263            run gbl/pause.p (vint * 1000).
      264         end.
      265         if iInterval ne ?
      266         then
      267            publish "WaitFramStop".
      268         waitfram-check-timeout().
      269      end.
      270      procedure WaitFramWaitFor:
      271         define input  parameter iInterval as dec no-undo.
      272         assign
      273            mWaitFramStartProc   = now
      274            mWaitFramStopUser    = no
      275            mWaitFramStopTimeOut = no
      276         .
      277         block-wait:
      278         do while not mWaitFramStop:
      279            run WaitFramRunPause (iInterval).
      280            if  waitfram-check-timeout()
      281            then do:
      282               leave block-wait.
      283            end.
      284         end.
      285         run waitfram-hide.
      286      end.
      287   procedure waitfram-join :
      288     define input  parameter p-line-1  as character no-undo .
      289     define input  parameter p-line-2  as character no-undo .
      290     define input  parameter p-line-3  as character no-undo .
      291     define output parameter p-message as character no-undo .
      292     do
      293     on error undo, return error return-value
      294     :
      295       assign
      296         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      299       .
      300     end.
      301   end procedure.
      302   function waitfram-join-function returns character
      303     (input p-line-1 as character
      304     ,input p-line-2 as character
      305     ,input p-line-3 as character
      306     ).
      307     define variable v-message as character no-undo .
      308     run waitfram-join in this-procedure
      309       (input  p-line-1
      310       ,input  p-line-2
      311       ,input  p-line-3
      312       ,output v-message
      313       ) .
      314     return v-message .
      315   end function .
      316   define new global shared variable g#language as character no-undo .
      317   if g#language <> '' and g#language <> 'rus':U then do:
      318     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      319   end.
      320   define new global shared variable g#library  as handle no-undo .
      321   define new global shared variable g#library2 as handle no-undo .
      322   procedure proc-alt-shift-f2:
      323     if not ibs.th.gbl.gbl-var:rcode
      324   then
      325     run gbl\inidebug.p .
      326   end.
      327   procedure proc-alt-shift-f3:
      328     run gbl/prvssinf.p
      329       ( input this-procedure
      330       ) .
      331   end.
      332   define variable v-inform-launched as logical no-undo initial false .
      333   procedure proc-alt-shift-f4:
      334     define variable v-action as character no-undo .
      335     if v-inform-launched = false then do:
      336       assign
      337         v-inform-launched = true
      338       .
      339       run gbl/d-inform.w
      340         (  input self
      341         ,  input this-procedure
      342         , output v-action
      343         ) no-error .
      344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      345       assign
      346         v-inform-launched = false
      347       .
      348     end.
      349   end.
      350   procedure proc-alt-f1:
      351     run gbl/corrhelp.p
      352       (input this-procedure
      353       ) .
      354   end .
      355   on alt-shift-f2 anywhere do:
      356     run proc-alt-shift-f2.
      357   end.
      358   on alt-shift-f3 anywhere do:
      359     run proc-alt-shift-f3 in this-procedure .
      360   end.
      361   on alt-shift-f4 anywhere do:
      362     run proc-alt-shift-f4 in this-procedure.
      363   end.
      364   on alt-f1 anywhere do:
      365     run proc-alt-f1 in this-procedure .
      366   end.
      367   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368     define variable v-cntxt-db-num        as integer   no-undo .
      369     define variable v-cntxt-userid        as character no-undo .
      370     define variable v-cntxt-level         as character no-undo .
      371     define variable v-cntxt-host-code-obj as integer   no-undo .
      372     define variable v-cntxt-obj-type      as character no-undo .
      373     define variable v-cntxt-obj-code      as integer   no-undo .
      374     define variable v-cntxt-db-num-obj    as integer   no-undo .
      375     define variable v-cntxt-is-admin      as logical   no-undo .
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      378   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      379   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      380   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      381   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      382   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      383   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      384   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      385   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      386   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      387   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      388   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      389   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      390   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      391   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      392   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      393   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      394   DEFINE VARIABLE ri AS RECID NO-UNDO.
      395   define variable v-ref-list as character no-undo .
      396   define variable v-obj-mode as logical no-undo .
      397   DEFINE BUTTON B-Help
      398        LABEL "Помо&щь"
      399        SIZE 3 BY 1
      400        BGCOLOR 8 .
      401   DEFINE BUTTON b-lkp
      402        LABEL "&Просмотр"
      403        SIZE 10 BY 1.
      404   DEFINE BUTTON B-mark
      405        LABEL "*"
      406        SIZE 3 BY 1.
      407   DEFINE BUTTON B-quit AUTO-END-KEY
      408        LABEL "&Выход"
      409        SIZE 10 BY 1
      410        BGCOLOR 8 .
      411   DEFINE BUTTON B-sel AUTO-GO
      412        LABEL "Вы&бор"
      413        SIZE 10 BY 1.
      414   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>9":U INITIAL 0
      415         VIEW-AS TEXT
      416        SIZE 9.9 BY 1 NO-UNDO.
      417   DEFINE QUERY br-rule-profile FOR X_rule-profile
      418          SCROLLING.
      419   DEFINE BROWSE br-rule-profile
      420     QUERY br-rule-profile NO-LOCK DISPLAY
      421         (IF ( CAN-DO (v-ref-list, string( recid( X_rule-profile ) ) ) ) THEN ("*") ELSE (" ")) COLUMN-LABEL "*" FORMAT "x(1)":U
      422   X_rule-profile.name COLUMN-LABEL "Название" FORMAT "X(85)":U
      423   X_rule-profile.profile_id COLUMN-LABEL "Код" FORMAT ">>9":U
      424   X_rule-profile.IS_dynamic COLUMN-LABEL "Отклю!чаемый" FORMAT "+/"
      425       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16 FIT-LAST-COLUMN.
      426   DEFINE FRAME Dialog-Frame
      427        B-quit AT ROW 1 COL 1
      428        B-mark AT ROW 1 COL 11
      429        B-sel AT ROW 1 COL 14
      430        b-lkp AT ROW 1 COL 41 WIDGET-ID 2
      431        B-Help AT ROW 1 COL 95
      432        br-rule-profile AT ROW 3 COL 1
      433        mark-num AT ROW 2 COL 2.9 NO-LABEL
      434        SPACE(86.82) SKIP(16.49)
      435       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      436            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      437            TITLE ""
      438            DEFAULT-BUTTON B-quit.
      439   ASSIGN
      440          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      441          FRAME Dialog-Frame:HIDDEN           = TRUE.
      442   ON GO OF FRAME Dialog-Frame
      443   DO:
      444     p-ref-list = v-ref-list.
      445   END.
      446   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      447   DO:
      448     APPLY "END-ERROR":U TO SELF.
      449   END.
      450   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      451   DO:
      452     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      453     IF NOT AVAILABLE X_rule-profile THEN RETURN NO-APPLY.
      454     v-rec = recid(X_rule-profile).
      455     run rul/rule-profile-i.w ( input parparentproc
      456                          ,input 'ПРОСМОТР':U
      457                          ,input X_rule-profile.profile_id
      458                          ,input-output v-rec) no-error.
      459   END.
      460   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      461   DO:
      462   DEFINE VARIABLE loc#log as logical no-undo.
      463   if available X_rule-profile then do:
      464   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      465   define variable v-str-recid4 as character no-undo .
      466   define variable v-num-entry4 as integer   no-undo .
      467   assign
      468     v-str-recid4 = trim( string( recid( X_rule-profile ) , "->>>>>>>>>>>9":U ) )
      469     v-num-entry4 = lookup( v-str-recid4 , v-ref-list )
      470   .
      471   if v-num-entry4 > 0 then do:
      472     assign
      473       entry( v-num-entry4, v-ref-list ) = "":U
      474       v-ref-list = trim( replace( v-ref-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      475     .
      476   end.
      477   else do:
      478     assign
      479       v-ref-list = v-ref-list + ( if v-ref-list = "":U then "":U else chr(44) ) + v-str-recid4
      480     .
      481   end.
      482     loc#log = br-rule-profile:refresh() .
      483     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      484         loc#log = br-rule-profile:select-next-row ().
      485         apply "iteration-changed" to br-rule-profile in frame Dialog-Frame.
      486     end.
      487     if num-entries( v-ref-list ) = 0
      488     then
      489         hide mark-num in frame Dialog-Frame.
      490     else
      491         disp num-entries( v-ref-list ) @ mark-num with frame Dialog-Frame.
      492   end.
      493   apply "entry" to br-rule-profile in frame Dialog-Frame.
      494   END.
      495   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      496   DO:
      497   if available X_rule-profile and
      498   (v-ref-list = ""
      499   or b-mark:sensitive = no)
      500   then do:
      501       v-ref-list = string(recid( X_rule-profile)).
      502   end.
      503   END.
      504   ON ROW-DISPLAY OF br-rule-profile IN frame Dialog-Frame
      505   DO:
      506     IF AVAIL X_rule-profile THEN DO:
      507       RUN set-row-color IN THIS-PROCEDURE ( INPUT X_rule-profile.parent-feature).
      508     END.
      509   END.
      510   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      511   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      512   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      513   on help of frame Dialog-Frame
      514   do:
      515     run gbl/app_help.p
      516       (input this-procedure :file-name
      517       ,input ''
      518       ,input ?
      519       ) no-error.
      520     if error-status :error then do:
      521       message
      522         "Ошибка при вызове помощи"
      523         error-status :get-message(1)
      524         view-as alert-box .
      525     end.
      526   end.
      527   run minbtn-set in this-procedure .
      528   on choose of b-help in frame Dialog-Frame
      529   do:
      530     apply "help":u to frame Dialog-Frame .
      531   end.
      532   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      533   procedure minbtn-set :
      534       do
      535           on error undo, return error return-value
      536           :
      537           define variable ii              as integer       no-undo .
      538           define variable fh              as widget-handle no-undo .
      539           define variable hh              as widget-handle no-undo .
      540           define variable v-h             as handle        extent 4 no-undo .
      541           define variable v-name-button   as character     no-undo .
      542           define variable v-help-old-x    as decimal       no-undo .
      543           define variable v-help-old-y    as decimal       no-undo .
      544           define variable v-help-old-size as decimal       no-undo .
      545           define variable v-frame-width   as decimal       no-undo .
      546           define variable jj              as integer       no-undo .
      547           do
      548               on error undo, return error
      549               :
      550               assign
      551                   v-frame-width = frame Dialog-Frame:width - 0.3
      552                   fh            = frame Dialog-Frame:first-child
      553                   hh            = fh:first-child
      554                   ii            = 1
      555                   .
      556               do while valid-handle(hh):
      557                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      558                   do:
      559                       case lc(hh:name) :
      560                           when "b-help" then
      561                               do:
      562                                   hh:load-image-up("cmp/b-help.bmp":u) .
      563                                   hh:load-image-down("cmp/b-help.bmp":u) .
      564                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      565                                   hh:TOOLTIP = "Помощь" .
      566                                   v-help-old-x = hh:column .
      567                                   v-help-old-y = hh:row    .
      568                                   v-help-old-size = hh:width .
      569                                   hh:width-chars = 2.5 .
      570                               end.
      571                           when "b-print" then
      572                               do:
      573                                   hh:load-image("cmp/b-print.bmp":u) .
      574                                   hh:TOOLTIP = "Печать" .
      575                                   v-h[ii] = hh:handle .
      576                                   ii = ii + 1 .
      577                                   hh:width-chars = 3 .
      578                               end.
      579                           when "b-history" or
      580                           when "b-hist" then
      581                               do:
      582                                   hh:load-image("cmp/b-hist.bmp":u) .
      583                                   hh:TOOLTIP = "История" .
      584                                   v-h[ii] = hh:handle .
      585                                   ii = ii + 1 .
      586                                   hh:width-chars = 3 .
      587                               end.
      588                           when "b-sch" then
      589                               do:
      590                                   hh:load-image("cmp/b-sch.bmp":u) .
      591                                   hh:TOOLTIP = "Установка Фильтра" .
      592                                   v-h[ii] = hh:handle .
      593                                   ii = ii + 1 .
      594                                   hh:width-chars = 3 .
      595                               end.
      596                           when "b-hist-user" then
      597                               do:
      598                                   hh:load-image("cmp/b-hist.bmp":u) .
      599                                   hh:TOOLTIP = "История пользователя" .
      600                                   ii = ii + 1 .
      601                               end.
      602                       end case.
      603                   end.
      604                   hh = hh:next-sibling.
      605               end.
      606               b-help:column = v-frame-width - b-help:width-chars.
      607               jj = 0.
      608               repeat ii = 4 to 1 by -1 :
      609                   if valid-handle (v-h[ii] ) then
      610                   do:
      611                       jj  = jj + 1 .
      612                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      613                       v-h[ii]:row    = v-help-old-y .
      614                   end.
      615               end.
      616           end.
      617       end.
      618   end procedure.
      619   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      620   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      621   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      622   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      623   define variable v-diasize-current-frame-width  as decimal   no-undo .
      624   define variable v-diasize-current-frame-height as decimal   no-undo .
      625   define variable v-diasize-change-size          as logical   no-undo .
      626   define variable v-diasize-resize-button        as handle    no-undo .
      627   define variable v-diasize-wndmax               as logical   no-undo .
      628   define variable v-diasize-wndstore             as logical   no-undo .
      629   define variable v-diasize-proc-name            as character no-undo .
      630   define variable v-diasize-browse-handle        as handle    no-undo .
      631   define variable v-diasize-browse-number        as integer   no-undo .
      632   define variable v-diasize-need-full-display    as logical   no-undo init false .
      633   define temp-table temp-diasize-handle no-undo
      634     field handle-value  as handle
      635     field save-position as decimal
      636     index xpk is primary unique handle-value
      637     .
      638   define temp-table temp-browse-handle no-undo
      639     field browse-type   as character
      640     field browse-number as integer
      641     field browse-handle as handle
      642     field original-size as decimal
      643     index xpk is primary unique browse-type browse-number
      644     index xie browse-type browse-handle
      645   .
      646   procedure diasize_change-height :
      647     define input  parameter p-change-value  as decimal   no-undo .
      648     define input  parameter p-move-resize   as logical   no-undo .
      649     define variable v-field-group-handle    as handle    no-undo .
      650     define variable v-object-handle         as handle    no-undo .
      651     define variable v-frame-height          as decimal   no-undo .
      652     define variable v-frame-virtual-height  as decimal   no-undo .
      653     define variable v-browse-height         as decimal   no-undo .
      654     define variable v-window-height         as decimal   no-undo .
      655     define variable v-window-virtual-height as decimal   no-undo .
      656     define variable v-change-sign           as integer   no-undo .
      657     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      658     define buffer buf_temp-browse-handle  for temp-browse-handle .
      659     if p-change-value > 0
      660     then do:
      661       if frame Dialog-Frame :height + p-change-value
      662           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      663       then do:
      664         assign
      665           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      666                           - (frame Dialog-Frame :height-chars)
      667         .
      668         if p-change-value <= 0
      669         then do:
      670           run diasize_position-resize-button in this-procedure .
      671           return .
      672         end.
      673       end.
      674     end.
      675     if p-change-value < 0
      676     then do:
      677       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      678       then do:
      679         assign
      680           p-change-value = v-diasize-orig-frame-height
      681                          - (frame Dialog-Frame :height-chars)
      682         .
      683         if p-change-value >= 0
      684         then do:
      685           run diasize_position-resize-button in this-procedure .
      686           return .
      687         end.
      688       end.
      689     end.
      690     if p-change-value >= 0
      691     then do:
      692       assign
      693         v-change-sign = 1
      694       .
      695     end.
      696     else do:
      697       assign
      698         v-change-sign = -1
      699       .
      700     end.
      701     assign
      702       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      703     .
      704     if p-change-value = 0
      705     then do:
      706       run diasize_position-resize-button in this-procedure .
      707       return .
      708     end.
      709     move_block:
      710     do
      711     on error undo move_block, retry move_block
      712     :
      713       if retry
      714       then do:
      715         do
      716         on error undo move_block, leave move_block
      717         :
      718           if p-change-value > 0
      719           then do:
      720             for each buf_temp-diasize-handle
      721             on error undo, next
      722             :
      723               assign
      724                 v-object-handle = buf_temp-diasize-handle.handle-value
      725               .
      726               if v-object-handle <> v-diasize-resize-button
      727               then do:
      728                 assign
      729                   v-object-handle :row = buf_temp-diasize-handle.save-position
      730                 .
      731               end.
      732             end.
      733             assign
      734               v-diasize-browse-handle :height = v-browse-height
      735             .
      736             for each buf_temp-browse-handle
      737               where buf_temp-browse-handle.browse-type = 'height':u
      738             on error undo, next
      739             :
      740               assign
      741                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      742               .
      743             end.
      744             assign
      745               frame Dialog-Frame :height = v-frame-height
      746             .
      747             if frame Dialog-Frame :scrollable = true
      748             then do:
      749               assign
      750                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      751               .
      752             end.
      753             run diasize_position-resize-button in this-procedure .
      754           end.
      755           else do:
      756             if frame Dialog-Frame :scrollable = true
      757             then do:
      758               assign
      759                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      760               .
      761             end.
      762             assign
      763               frame Dialog-Frame :height = v-frame-height
      764             .
      765             assign
      766               v-diasize-browse-handle :height = v-browse-height
      767             .
      768             for each buf_temp-browse-handle
      769               where buf_temp-browse-handle.browse-type = 'height':u
      770             on error undo, next
      771             :
      772               assign
      773                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      774               .
      775             end.
      776             for each buf_temp-diasize-handle
      777             on error undo, next
      778             :
      779               assign
      780                 v-object-handle = buf_temp-diasize-handle.handle-value
      781               .
      782               if v-object-handle <> v-diasize-resize-button
      783               then do:
      784                 assign
      785                   v-object-handle :row = buf_temp-diasize-handle.save-position
      786                 .
      787               end.
      788             end.
      789             run diasize_position-resize-button in this-procedure .
      790           end.
      791           assign
      792             v-diasize-change-size = false
      793           .
      794           leave move_block .
      795         end.
      796       end.
      797       assign
      798         v-diasize-need-full-display = true
      799       .
      800       if v-diasize-change-size = false
      801       then do:
      802         assign
      803           v-diasize-change-size = true
      804         .
      805       end.
      806       else do:
      807         return .
      808       end.
      809       assign
      810         v-frame-height = frame Dialog-Frame :height
      811         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      812         v-browse-height = v-diasize-browse-handle :height
      813       .
      814       for each buf_temp-browse-handle
      815         where buf_temp-browse-handle.browse-type = 'height':u
      816       :
      817         assign
      818           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      819         .
      820       end.
      821       for each buf_temp-diasize-handle
      822       :
      823         delete buf_temp-diasize-handle .
      824       end.
      825       assign
      826         v-field-group-handle = frame Dialog-Frame :first-child
      827       .
      828       do while valid-handle(v-field-group-handle)
      829       :
      830         assign
      831           v-object-handle = v-field-group-handle :first-child
      832         .
      833         do while valid-handle(v-object-handle)
      834         :
      835           if  v-object-handle <> v-diasize-browse-handle :handle
      836           and can-query(v-object-handle, "row")
      837           and can-query(v-object-handle, "height")
      838           and ( v-object-handle :row > v-diasize-browse-handle :row )
      839           then do:
      840             find first buf_temp-browse-handle
      841               where buf_temp-browse-handle.browse-type   = 'height':u
      842                 and buf_temp-browse-handle.browse-handle = v-object-handle
      843               no-error .
      844             if available buf_temp-browse-handle
      845             then do:
      846             end.
      847             else do:
      848               create buf_temp-diasize-handle .
      849               assign
      850                 buf_temp-diasize-handle.handle-value  = v-object-handle
      851                 buf_temp-diasize-handle.save-position = v-object-handle :row
      852               .
      853             end.
      854           end.
      855           assign
      856             v-object-handle = v-object-handle :next-sibling
      857           .
      858         end.
      859         assign
      860           v-field-group-handle = v-field-group-handle :next-sibling
      861         .
      862       end.
      863       do with frame Dialog-Frame
      864       :
      865         hide v-diasize-resize-button .
      866         assign
      867           v-diasize-resize-button :row    = 1
      868           v-diasize-resize-button :column = 1
      869         .
      870       end.
      871       if p-change-value > 0
      872       then do:
      873         if frame Dialog-Frame :scrollable = true
      874         then do:
      875           assign
      876             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      877             no-error .
      878           if error-status :error
      879           or error-status :get-message(1) <> ""
      880           then do:
      881             undo move_block, retry move_block .
      882           end.
      883         end.
      884         assign
      885           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      886           no-error .
      887         if error-status :error
      888         or error-status :get-message(1) <> ""
      889         then do:
      890           undo move_block, retry move_block .
      891         end.
      892         assign
      893           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      894           no-error .
      895         if error-status :error
      896         or error-status :get-message(1) <> ""
      897         then do:
      898           undo move_block, retry move_block .
      899         end.
      900         for each buf_temp-browse-handle
      901           where buf_temp-browse-handle.browse-type = 'height':u
      902         on error undo move_block, retry move_block
      903         :
      904           assign
      905             buf_temp-browse-handle.browse-handle :height
      906               = buf_temp-browse-handle.browse-handle :height + p-change-value
      907             no-error .
      908           if error-status :error
      909           or error-status :get-message(1) <> ""
      910           then do:
      911             undo move_block, retry move_block .
      912           end.
      913         end.
      914         for each buf_temp-diasize-handle
      915         on error undo move_block, retry move_block
      916         :
      917           assign
      918             v-object-handle = buf_temp-diasize-handle.handle-value
      919           .
      920           if v-object-handle <> v-diasize-resize-button
      921           then do:
      922             assign
      923               v-object-handle :row = v-object-handle :row + p-change-value
      924               no-error .
      925             if error-status :error
      926             or error-status :get-message(1) <> ""
      927             then do:
      928               undo move_block, retry move_block .
      929             end.
      930           end.
      931         end.
      932       end.
      933       else do:
      934         for each buf_temp-diasize-handle
      935         on error undo move_block, retry move_block
      936         :
      937           assign
      938             v-object-handle = buf_temp-diasize-handle.handle-value
      939           .
      940           if v-object-handle <> v-diasize-resize-button
      941           then do:
      942             assign
      943               v-object-handle :row = v-object-handle :row + p-change-value
      944               no-error .
      945             if error-status :error
      946             or error-status :get-message(1) <> ""
      947             then do:
      948               undo move_block, retry move_block .
      949             end.
      950           end.
      951         end.
      952         assign
      953           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      954           no-error .
      955         if error-status :error
      956         or error-status :get-message(1) <> ""
      957         then do:
      958           undo move_block, retry move_block .
      959         end.
      960         for each buf_temp-browse-handle
      961           where buf_temp-browse-handle.browse-type = 'height':u
      962         on error undo move_block, retry move_block
      963         :
      964           assign
      965             buf_temp-browse-handle.browse-handle :height
      966               = buf_temp-browse-handle.browse-handle :height + p-change-value
      967             no-error .
      968           if error-status :error
      969           or error-status :get-message(1) <> ""
      970           then do:
      971             undo move_block, retry move_block .
      972           end.
      973         end.
      974         assign
      975           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      976           no-error .
      977         if error-status :error
      978         or error-status :get-message(1) <> ""
      979         then do:
      980           undo move_block, retry move_block .
      981         end.
      982         if frame Dialog-Frame :scrollable = true
      983         then do:
      984           assign
      985             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      986             no-error .
      987           if error-status :error
      988           or error-status :get-message(1) <> ""
      989           then do:
      990             undo move_block, retry move_block .
      991           end.
      992         end.
      993       end.
      994       if p-move-resize = true
      995       then do:
      996         run diasize_position-resize-button in this-procedure .
      997       end.
      998       if v-diasize-wndstore = true
      999       then do:
     1000         if connected("ub") = true
     1001         then do:
     1002           define variable v-cntxt-db-num        as integer   no-undo .
     1003           define variable v-cntxt-userid        as character no-undo .
     1004           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1005                                             , OUTPUT v-cntxt-userid
     1006                                             ) .
     1007           run gbl/wndsizew.p
     1008             (input  v-cntxt-db-num
     1009             ,input  v-cntxt-userid
     1010             ,input  v-diasize-proc-name
     1011             ,input  'height':u
     1012             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1013             ) .
     1014         end.
     1015       end.
     1016     end.
     1017     assign
     1018       v-diasize-change-size = false
     1019     .
     1020   end procedure.
     1021   procedure diasize_set-height :
     1022     define input  parameter p-new-height  as decimal   no-undo .
     1023     define input  parameter p-move-resize as logical   no-undo .
     1024     do
     1025     on error undo, return error return-value
     1026     :
     1027       run diasize_change-height in this-procedure
     1028         (input  (p-new-height - frame Dialog-Frame :height)
     1029         ,input  p-move-resize
     1030         ) .
     1031     end.
     1032   end procedure.
     1033   procedure diasize_change-width :
     1034     define input  parameter p-change-value as decimal   no-undo .
     1035     define input  parameter p-move-resize  as logical   no-undo .
     1036     define variable v-field-group-handle   as handle    no-undo .
     1037     define variable v-object-handle        as handle    no-undo .
     1038     define variable v-frame-width          as decimal   no-undo .
     1039     define variable v-frame-virtual-width  as decimal   no-undo .
     1040     define variable v-browse-width         as decimal   no-undo .
     1041     define variable v-window-width         as decimal   no-undo .
     1042     define variable v-window-virtual-width as decimal   no-undo .
     1043     define variable v-change-sign          as integer   no-undo .
     1044     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1045     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1046     if p-change-value > 0
     1047     then do:
     1048       if frame Dialog-Frame :width + p-change-value >
     1049           session :width-chars
     1050       then do:
     1051         assign
     1052           p-change-value = session :width-chars - frame Dialog-Frame :width
     1053         .
     1054         if p-change-value <= 0
     1055         then do:
     1056           run diasize_position-resize-button in this-procedure .
     1057           return .
     1058         end.
     1059       end.
     1060     end.
     1061     if p-change-value < 0
     1062     then do:
     1063       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1064       then do:
     1065         assign
     1066           p-change-value = v-diasize-orig-frame-width
     1067                          - frame Dialog-Frame :width
     1068         .
     1069         if p-change-value >= 0
     1070         then do:
     1071           run diasize_position-resize-button in this-procedure .
     1072           return .
     1073         end.
     1074       end.
     1075     end.
     1076     if p-change-value >= 0
     1077     then do:
     1078       assign
     1079         v-change-sign = 1
     1080       .
     1081     end.
     1082     else do:
     1083       assign
     1084         v-change-sign = -1
     1085       .
     1086     end.
     1087     assign
     1088       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1089     .
     1090     if p-change-value = 0
     1091     then do:
     1092       run diasize_position-resize-button in this-procedure .
     1093       return .
     1094     end.
     1095     move_block:
     1096     do
     1097     on error undo move_block, leave move_block
     1098     :
     1099       if retry
     1100       then do:
     1101         do
     1102         on error undo move_block, leave move_block
     1103         :
     1104           if p-change-value > 0
     1105           then do:
     1106             for each buf_temp-diasize-handle
     1107             on error undo, next
     1108             :
     1109               assign
     1110                 v-object-handle = buf_temp-diasize-handle.handle-value
     1111               .
     1112               if v-object-handle <> v-diasize-resize-button
     1113               then do:
     1114                 assign
     1115                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1116                 .
     1117               end.
     1118             end.
     1119             assign
     1120               v-diasize-browse-handle :width = v-browse-width
     1121             .
     1122             for each buf_temp-browse-handle
     1123               where buf_temp-browse-handle.browse-type = 'width':u
     1124             on error undo, next
     1125             :
     1126               assign
     1127                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1128               .
     1129             end.
     1130             assign
     1131               frame Dialog-Frame :width = v-frame-width
     1132             .
     1133             if frame Dialog-Frame :scrollable = true
     1134             then do:
     1135               assign
     1136                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1137               .
     1138             end.
     1139             run diasize_position-resize-button in this-procedure .
     1140           end.
     1141           else do:
     1142             if frame Dialog-Frame :scrollable = true
     1143             then do:
     1144               assign
     1145                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1146               .
     1147             end.
     1148             assign
     1149               frame Dialog-Frame :width = v-frame-width
     1150             .
     1151             for each buf_temp-browse-handle
     1152               where buf_temp-browse-handle.browse-type = 'width':u
     1153             on error undo, next
     1154             :
     1155               assign
     1156                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1157               .
     1158             end.
     1159             assign
     1160               v-diasize-browse-handle :width = v-browse-width
     1161             .
     1162             for each buf_temp-diasize-handle
     1163             on error undo, next
     1164             :
     1165               assign
     1166                 v-object-handle = buf_temp-diasize-handle.handle-value
     1167               .
     1168               if v-object-handle <> v-diasize-resize-button
     1169               then do:
     1170                 assign
     1171                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1172                 .
     1173               end.
     1174             end.
     1175             run diasize_position-resize-button in this-procedure .
     1176           end.
     1177           assign
     1178             v-diasize-change-size = false
     1179           .
     1180           leave move_block .
     1181         end.
     1182       end.
     1183       assign
     1184         v-diasize-need-full-display = true
     1185       .
     1186       if v-diasize-change-size = false
     1187       then do:
     1188         assign
     1189           v-diasize-change-size = true
     1190         .
     1191       end.
     1192       else do:
     1193         return .
     1194       end.
     1195       assign
     1196         v-frame-width = frame Dialog-Frame :width
     1197         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1198         v-browse-width = v-diasize-browse-handle :width
     1199       .
     1200       for each buf_temp-browse-handle
     1201         where buf_temp-browse-handle.browse-type = 'width':u
     1202       :
     1203         assign
     1204           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1205         .
     1206       end.
     1207       for each buf_temp-diasize-handle
     1208       :
     1209         delete buf_temp-diasize-handle .
     1210       end.
     1211       assign
     1212         v-field-group-handle = frame Dialog-Frame :first-child
     1213       .
     1214       do while valid-handle(v-field-group-handle)
     1215       :
     1216         assign
     1217           v-object-handle = v-field-group-handle :first-child
     1218         .
     1219         do while valid-handle(v-object-handle)
     1220         :
     1221           if  v-object-handle <> v-diasize-browse-handle :handle
     1222           and v-object-handle <> v-diasize-resize-button
     1223           and can-query(v-object-handle, "row")
     1224           and can-query(v-object-handle, "height")
     1225           and ( v-object-handle :col + v-object-handle :width
     1226                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1227               )
     1228           then do:
     1229             find first buf_temp-browse-handle
     1230               where buf_temp-browse-handle.browse-type   = 'width':u
     1231                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1232               no-error .
     1233             if available buf_temp-browse-handle
     1234             then do:
     1235             end.
     1236             else do:
     1237               create buf_temp-diasize-handle .
     1238               assign
     1239                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1240                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1241               .
     1242             end.
     1243           end.
     1244           assign
     1245             v-object-handle = v-object-handle :next-sibling
     1246           .
     1247         end.
     1248         assign
     1249           v-field-group-handle = v-field-group-handle :next-sibling
     1250         .
     1251       end.
     1252       do with frame Dialog-Frame
     1253       :
     1254         hide v-diasize-resize-button .
     1255         v-diasize-resize-button :row = 1.
     1256         v-diasize-resize-button :column = 1.
     1257       end.
     1258       if p-change-value > 0
     1259       then do:
     1260         if frame Dialog-Frame :scrollable = true
     1261         then do:
     1262           assign
     1263             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1264             no-error .
     1265           if error-status :error
     1266           or error-status :get-message(1) <> ""
     1267           then do:
     1268             undo move_block, retry move_block.
     1269           end.
     1270         end.
     1271         assign
     1272           frame Dialog-Frame :width = v-frame-width + p-change-value
     1273           no-error .
     1274         if error-status :error
     1275         or error-status :get-message(1) <> ""
     1276         then do:
     1277           undo move_block, retry move_block.
     1278         end.
     1279         assign
     1280           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1281         no-error .
     1282         if error-status :error
     1283         or error-status :get-message(1) <> ""
     1284         then do:
     1285           undo move_block, retry move_block.
     1286         end.
     1287         for each buf_temp-browse-handle
     1288           where buf_temp-browse-handle.browse-type = 'width':u
     1289         on error undo move_block, retry move_block
     1290         :
     1291           assign
     1292             buf_temp-browse-handle.browse-handle :width
     1293               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1294             no-error .
     1295           if error-status :error
     1296           or error-status :get-message(1) <> ""
     1297           then do:
     1298             undo move_block, retry move_block .
     1299           end.
     1300         end.
     1301         for each buf_temp-diasize-handle
     1302         on error undo move_block, retry move_block
     1303         :
     1304           assign
     1305             v-object-handle = buf_temp-diasize-handle.handle-value
     1306           .
     1307           if v-object-handle <> v-diasize-resize-button
     1308           then do:
     1309             assign
     1310               v-object-handle :col = v-object-handle :col + p-change-value
     1311               no-error .
     1312             if error-status :error
     1313             or error-status :get-message(1) <> ""
     1314             then do:
     1315               undo move_block, retry move_block .
     1316             end.
     1317           end.
     1318         end.
     1319       end.
     1320       else do:
     1321         for each buf_temp-diasize-handle
     1322         on error undo move_block, retry move_block
     1323         :
     1324           assign
     1325             v-object-handle = buf_temp-diasize-handle.handle-value
     1326           .
     1327           if v-object-handle <> v-diasize-resize-button
     1328           then do:
     1329             assign
     1330               v-object-handle :col = v-object-handle :col + p-change-value
     1331               no-error .
     1332             if error-status :error
     1333             or error-status :get-message(1) <> ""
     1334             then do:
     1335               undo move_block, retry move_block .
     1336             end.
     1337           end.
     1338         end.
     1339         for each buf_temp-browse-handle
     1340           where buf_temp-browse-handle.browse-type = 'width':u
     1341         on error undo move_block, retry move_block
     1342         :
     1343           assign
     1344             buf_temp-browse-handle.browse-handle :width
     1345               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1346             no-error .
     1347           if error-status :error
     1348           or error-status :get-message(1) <> ""
     1349           then do:
     1350             undo move_block, retry move_block .
     1351           end.
     1352         end.
     1353         assign
     1354           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1355           no-error .
     1356         if error-status :error
     1357         or error-status :get-message(1) <> ""
     1358         then do:
     1359           undo move_block, retry move_block.
     1360         end.
     1361         assign
     1362           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1363         no-error .
     1364         if error-status :error
     1365         or error-status :get-message(1) <> ""
     1366         then do:
     1367           undo move_block, retry move_block.
     1368         end.
     1369         if frame Dialog-Frame :scrollable = true
     1370         then do:
     1371           assign
     1372             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1373           no-error .
     1374           if error-status :error
     1375           or error-status :get-message(1) <> ""
     1376           then do:
     1377             undo move_block, retry move_block.
     1378           end.
     1379         end.
     1380       end.
     1381       if p-move-resize
     1382       then do:
     1383         run diasize_position-resize-button in this-procedure .
     1384       end.
     1385       if v-diasize-wndstore = true
     1386       then do:
     1387         if connected("ub") = true
     1388         then do:
     1389           define variable v-cntxt-db-num        as integer   no-undo .
     1390           define variable v-cntxt-userid        as character no-undo .
     1391           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1392                                             , OUTPUT v-cntxt-userid
     1393                                             ) .
     1394           run gbl/wndsizew.p
     1395             (input  v-cntxt-db-num
     1396             ,input  v-cntxt-userid
     1397             ,input  v-diasize-proc-name
     1398             ,input  'width':u
     1399             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1400             ) .
     1401         end.
     1402       end.
     1403     end.
     1404     assign
     1405       v-diasize-change-size = false
     1406     .
     1407   end procedure.
     1408   procedure diasize_set-width :
     1409     define input  parameter p-new-width  as decimal   no-undo .
     1410     define input  parameter p-move-resize as logical   no-undo .
     1411     do
     1412     on error undo, return error return-value
     1413     :
     1414       run diasize_change-width in this-procedure
     1415         (input  (p-new-width - frame Dialog-Frame :width)
     1416         ,input  p-move-resize
     1417         ) .
     1418     end.
     1419   end procedure.
     1420   procedure diasize_position-resize-button :
     1421     do with frame Dialog-Frame
     1422     :
     1423       hide v-diasize-resize-button .
     1424       assign
     1425         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1426                     - 1
     1427                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1428         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1429                     - 1
     1430                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1431       .
     1432       view v-diasize-resize-button .
     1433     end.
     1434   end procedure.
     1435   on alt-right anywhere
     1436   do:
     1437     run diasize_change-width in this-procedure
     1438       (input 1
     1439       ,input true
     1440       ) .
     1441     return no-apply .
     1442   end.
     1443   on alt-left anywhere
     1444   do:
     1445     run diasize_change-width in this-procedure
     1446       (input -1
     1447       ,input true
     1448       ) .
     1449     return no-apply .
     1450   end.
     1451   on alt-down anywhere
     1452   do:
     1453     run diasize_change-height in this-procedure
     1454       (input 1
     1455       ,input true
     1456       ) .
     1457     return no-apply .
     1458   end.
     1459   on alt-up anywhere
     1460   do:
     1461     run diasize_change-height in this-procedure
     1462       (input -1
     1463       ,input true
     1464       ) .
     1465     return no-apply .
     1466   end.
     1467   on alt-enter of frame Dialog-Frame
     1468   do:
     1469     run diasize_maximize in this-procedure
     1470       (input  ?
     1471       ).
     1472     return no-apply .
     1473   end.
     1474   procedure diasize_end-move :
     1475     do
     1476     on error undo, return error return-value
     1477     :
     1478       define variable v-row-delta as decimal   no-undo .
     1479       define variable v-col-delta as decimal   no-undo .
     1480       define variable v-new-row as decimal   no-undo .
     1481       define variable v-new-col as decimal   no-undo .
     1482       assign
     1483         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1484         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1485       .
     1486       assign
     1487         v-row-delta = v-new-row - frame Dialog-Frame :height
     1488         v-col-delta = v-new-col - frame Dialog-Frame :width
     1489       .
     1490       run diasize_change-height in this-procedure
     1491         (input v-row-delta
     1492         ,input true
     1493         ) .
     1494       run diasize_change-width in this-procedure
     1495         (input v-col-delta
     1496         ,input true
     1497         ) .
     1498     end.
     1499   end procedure.
     1500   procedure diasize_maximize :
     1501     define input  parameter p-action as logical   no-undo .
     1502     do
     1503     on error undo, return error return-value
     1504     :
     1505       if p-action = ?
     1506       then do:
     1507         if v-diasize-need-maximize = true
     1508         then do:
     1509           assign
     1510             p-action = true
     1511           .
     1512         end.
     1513         else do:
     1514           assign
     1515             p-action = false
     1516           .
     1517         end.
     1518       end.
     1519       if p-action = true
     1520       then do:
     1521         run diasize_change-height in this-procedure
     1522           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1523               - frame Dialog-Frame :height-chars
     1524           ,input true
     1525           ) .
     1526         run diasize_change-width in this-procedure
     1527           (input session :width-chars
     1528               - frame Dialog-Frame :width-chars
     1529           ,input true
     1530           ) .
     1531         assign
     1532           v-diasize-need-maximize = false
     1533         .
     1534       end.
     1535       else do:
     1536         run diasize_change-width in this-procedure
     1537           (input v-diasize-orig-frame-width
     1538               - frame Dialog-Frame :width-chars
     1539           ,input true
     1540           ) .
     1541         run diasize_change-height in this-procedure
     1542           (input v-diasize-orig-frame-height
     1543               - frame Dialog-Frame :height-chars
     1544           ,input true
     1545           ) .
     1546         assign
     1547           v-diasize-need-maximize = true
     1548         .
     1549       end.
     1550     end.
     1551   end procedure.
     1552   procedure diasize_restore-orig-size :
     1553     do
     1554     on error undo, return error return-value
     1555     :
     1556       assign
     1557         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1558         v-diasize-current-frame-height = frame Dialog-Frame :height
     1559       .
     1560       run diasize_set-height in this-procedure
     1561         (input  v-diasize-orig-frame-height
     1562         ,input  true
     1563         ) .
     1564       run diasize_set-width in this-procedure
     1565         (input  v-diasize-orig-frame-width
     1566         ,input  true
     1567         ) .
     1568     end.
     1569   end procedure.
     1570   procedure diasize_restore-current-size :
     1571     do
     1572     on error undo, return error return-value
     1573     :
     1574       run diasize_set-height in this-procedure
     1575         (input  v-diasize-current-frame-height
     1576         ,input  true
     1577         ) .
     1578       run diasize_set-width in this-procedure
     1579         (input  v-diasize-current-frame-width
     1580         ,input  true
     1581         ) .
     1582     end.
     1583   end procedure.
     1584   procedure diasize_set-browse-handle :
     1585     define input  parameter p-browse-handle as handle   no-undo .
     1586     define buffer buf_temp-browse-handle for temp-browse-handle .
     1587     do
     1588     on error undo, return error return-value
     1589     :
     1590       assign
     1591         v-diasize-browse-handle = p-browse-handle
     1592       .
     1593       for each buf_temp-browse-handle
     1594       on error undo, return error return-value
     1595       :
     1596         delete buf_temp-browse-handle .
     1597       end.
     1598     end.
     1599   end procedure.
     1600   procedure diasize_add_browse :
     1601     define input  parameter p-browse-type   as character no-undo .
     1602     define input  parameter p-browse-handle as handle    no-undo .
     1603     define buffer buf_temp-browse-handle for temp-browse-handle .
     1604     do
     1605     on error undo, return error return-value
     1606     :
     1607       assign
     1608         v-diasize-browse-number = v-diasize-browse-number + 1
     1609       .
     1610       create buf_temp-browse-handle .
     1611       assign
     1612         buf_temp-browse-handle.browse-type   = p-browse-type
     1613         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1614         buf_temp-browse-handle.browse-handle = p-browse-handle
     1615       .
     1616     end.
     1617   end procedure.
     1618   procedure diasize_init :
     1619     define variable v-default-value    as logical   no-undo .
     1620     define variable v-restore-saved    as logical   no-undo .
     1621     define variable v-resize-value-str as character no-undo .
     1622     do
     1623     on error undo, return error return-value
     1624     :
     1625       do with frame Dialog-Frame
     1626       :
     1627         assign
     1628           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1629           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1630           v-diasize-browse-handle     = browse br-rule-profile :handle
     1631         .
     1632         create button v-diasize-resize-button
     1633         assign
     1634           parent        = frame Dialog-Frame :first-child
     1635           label         = "s"
     1636           height-pixels = 16
     1637           width-pixels  = 16
     1638           visible       = true
     1639           sensitive     = true
     1640           movable       = true
     1641           triggers:
     1642             on end-move persistent run diasize_end-move in this-procedure .
     1643           end triggers.
     1644         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1645         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1646         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1647         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1648         assign
     1649           v-diasize-wndmax = false
     1650         .
     1651         if connected("ub") = true
     1652         then do:
     1653           define variable v-cntxt-db-num        as integer   no-undo .
     1654           define variable v-cntxt-userid        as character no-undo .
     1655           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1656                                             , OUTPUT v-cntxt-userid
     1657                                             ) .
     1658           run gbl/wndpar_r.p
     1659             (input  v-cntxt-db-num
     1660             ,input  v-cntxt-userid
     1661             ,input  'wndmax':U
     1662             ,output v-diasize-wndmax
     1663             ,output v-default-value
     1664             ) .
     1665         end.
     1666         assign
     1667           v-diasize-wndstore = false
     1668         .
     1669         if connected("ub") = true
     1670         then do:
     1671           run gbl/wndpar_r.p
     1672             (input  v-cntxt-db-num
     1673             ,input  v-cntxt-userid
     1674             ,input  'wndstore':U
     1675             ,output v-diasize-wndstore
     1676             ,output v-default-value
     1677             ) .
     1678         end.
     1679         assign
     1680           v-diasize-proc-name = entry(1, program-name(2), '.')
     1681         .
     1682         if v-diasize-wndstore = true
     1683         then do:
     1684           assign
     1685             v-restore-saved = false
     1686           .
     1687           if connected("ub") = true
     1688           then do:
     1689             run gbl/wndsizer.p
     1690               (input  v-cntxt-db-num
     1691               ,input  v-cntxt-userid
     1692               ,input  v-diasize-proc-name
     1693               ,input  'height':u
     1694               ,output v-resize-value-str
     1695               ) .
     1696             if v-resize-value-str <> '':U
     1697             then do:
     1698               run diasize_change-height in this-procedure
     1699                 (input  integer(v-resize-value-str)
     1700                 ,input  true
     1701                 ) .
     1702               assign
     1703                 v-restore-saved = true
     1704               .
     1705             end.
     1706           end.
     1707           if connected("ub") = true
     1708           then do:
     1709             run gbl/wndsizer.p
     1710               (input  v-cntxt-db-num
     1711               ,input  v-cntxt-userid
     1712               ,input  v-diasize-proc-name
     1713               ,input  'width':u
     1714               ,output v-resize-value-str
     1715               ) .
     1716             if v-resize-value-str <> '':U
     1717             then do:
     1718               run diasize_change-width in this-procedure
     1719                 (input  integer(v-resize-value-str)
     1720                 ,input  true
     1721                 ) .
     1722               assign
     1723                 v-restore-saved = true
     1724               .
     1725             end.
     1726           end.
     1727           if v-restore-saved <> true
     1728           then do:
     1729             if v-diasize-wndmax = true
     1730             then do:
     1731               run diasize_maximize in this-procedure
     1732                 (input  true
     1733                 ) .
     1734             end.
     1735           end.
     1736         end.
     1737         else do:
     1738           if v-diasize-wndmax = true
     1739           then do:
     1740             run diasize_maximize in this-procedure
     1741               (input  true
     1742               ) .
     1743           end.
     1744         end.
     1745       end.
     1746     end.
     1747   end procedure.
     1748   procedure diasize_need-full-display :
     1749     define output parameter p-need-full-display as logical   no-undo .
     1750     do
     1751     on error undo, return error return-value
     1752     :
     1753       assign
     1754         p-need-full-display = v-diasize-need-full-display
     1755       .
     1756       assign
     1757         v-diasize-need-full-display = false
     1758       .
     1759     end.
     1760   end procedure.
     1761   procedure get-context :
     1762      define output parameter p-db-num as integer          no-undo.
     1763      define output parameter p-user-id as character        no-undo.
     1764      define variable v-login               as character    no-undo.
     1765      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1766      define buffer buf_user-login  for ub.user-login .
     1767      do
     1768      on error undo, return error
     1769      :
     1770            FIND FIRST buf_sys-ctrl no-lock.
     1771            ASSIGN
     1772               v-login = USERID("ub")
     1773               p-db-num = buf_sys-ctrl.db-num
     1774            .
     1775            FIND FIRST buf_user-login
     1776                 WHERE buf_user-login.db-num = p-db-num
     1777                   AND buf_user-login.user-login = v-login
     1778                 no-lock
     1779                 no-error
     1780                 .
     1781            IF AVAILABLE buf_user-login
     1782            THEN DO:
     1783               assign
     1784                  p-user-id = buf_user-login.user-id
     1785               .
     1786            END.
     1787      end.
     1788   end procedure.
     1789       run diasize_init in this-procedure .
     1790   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1791   on INS of frame Dialog-Frame anywhere do:
     1792     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1793     return no-apply.
     1794   end.
     1795   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1796   on F2 of frame Dialog-Frame anywhere do:
     1797     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     1798     return no-apply.
     1799   end.
     1800   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1801   on F2 of frame Dialog-Frame anywhere do:
     1802     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     1803     return no-apply.
     1804   end.
     1805   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1806   on F3 of frame Dialog-Frame anywhere do:
     1807     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     1808     return no-apply.
     1809   end.
     1810   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1811   do:
     1812     br-rule-profile :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1813   end.
     1814   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1815   on f5 of frame Dialog-Frame anywhere
     1816   do:
     1817      if available X_rule-profile then ri = recid(X_rule-profile).     RUn OpenBr in this-procedure .     reposition br-rule-profile to recid ri no-error.
     1818       apply "VALUE-CHANGED" to br-rule-profile.
     1819   end.
     1820   MAIN-BLOCK:
     1821   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1822      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1823   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1824     run mainmenu_getcntxt in parparentproc
     1825       (output v-cntxt-db-num
     1826       ,output v-cntxt-userid
     1827       ,output v-cntxt-level
     1828       ,output v-cntxt-host-code-obj
     1829       ,output v-cntxt-obj-type
     1830       ,output v-cntxt-obj-code
     1831       ,output v-cntxt-db-num-obj
     1832       ,output v-cntxt-is-admin
     1833       ) .
     1834    if num-entries(p-list-mode, chr(4)) > 1 then do:
     1835      v-obj-mode = entry(2, p-list-mode, chr(4)) = 'маг':U
     1836                  or
     1837                  entry(2, p-list-mode, chr(4)) = 'скл':U.
     1838      p-list-mode = entry(1, p-list-mode, chr(4) ).
     1839    end.
     1840    IF LOOKUP(p-list-mode, 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U) = 0 THEN DO:
     1841      message
     1842      vss-workfile vss-revision vss-description skip
     1843      "Неверный параметр вызова p-list-mode" p-list-mode
     1844       view-as alert-box ERROR.
     1845       return error.
     1846     END.
     1847     v-ref-list = p-ref-list.
     1848     run Myenable IN THIS-PROCEDURE .
     1849     run openbr IN THIS-PROCEDURE.
     1850       if num-entries (v-ref-list) = 0 then
     1851           hide mark-num in frame Dialog-Frame.
     1852       else
     1853           disp
     1854           num-entries (v-ref-list) @ mark-num
     1855           with frame Dialog-Frame.
     1856     WAIT-FOR GO OF FRAME Dialog-Frame.
     1857   END.
     1858   run disable_UI in this-procedure.
     1859   PROCEDURE disable_UI :
     1860     HIDE FRAME Dialog-Frame.
     1861   END PROCEDURE.
     1862   PROCEDURE enable_UI :
     1863     DISPLAY mark-num
     1864         WITH FRAME Dialog-Frame.
     1865     ENABLE B-quit B-mark B-sel b-lkp B-Help br-rule-profile mark-num
     1866         WITH FRAME Dialog-Frame.
     1867     VIEW FRAME Dialog-Frame.
     1868     OPEN QUERY br-rule-profile FOR EACH X_rule-profile NO-LOCK INDEXED-REPOSITION.
     1869   END PROCEDURE.
     1870   PROCEDURE MyEnable :
     1871   DEFINE VARIABLE ch AS WIDGET-HANDLE NO-UNDO.
     1872   DEFINE VARIABLE ii AS integer NO-UNDO.
     1873   assign
     1874   X_rule-profile.name:resizable in browse br-rule-profile = yes.
     1875   FRAME Dialog-Frame:TITLE = substitute("Профайлы с типом: &1", entry (lookup (p-list-mode, 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U) + 1, ',' + 'Тип диск.карты,Товар,Клиент,Группа товаров,Группа клиентов,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,Оп-рации с док-тами и эл.документооборот,Справочники и классификаторы IBS TH,ДНЦ и переоценки,Отчеты,Заказы,Комбинации разнотипных алгоритмов,Оп-рации с фин док-тами':U)).
     1876   DISPLAY mark-num
     1877   WITH FRAME Dialog-Frame.
     1878   ENABLE
     1879   B-quit
     1880   B-mark WHEN lookup('b-mark', p-bttns) > 0
     1881   B-sel WHEN lookup('b-sel', p-bttns) > 0
     1882   b-lkp
     1883   B-Help
     1884   br-rule-profile
     1885   WITH FRAME Dialog-Frame.
     1886   VIEW FRAME Dialog-Frame.
     1887   END PROCEDURE.
     1888   PROCEDURE OpenBr :
     1889   if v-obj-mode then do:
     1890   OPEN QUERY br-rule-profile
     1891   FOR EACH X_rule-profile where
     1892           X_rule-profile.profile-type = p-list-mode
     1893        and  lookup("obj", X_rule-profile.short-name)  > 0
     1894   by X_rule-profile.profile_id.
     1895   end.
     1896   else do:
     1897     OPEN QUERY br-rule-profile
     1898     FOR EACH X_rule-profile where
     1899             X_rule-profile.profile-type = p-list-mode
     1900     by X_rule-profile.profile_id.
     1901   end.
     1902   END PROCEDURE.
     1903   PROCEDURE set-row-color :
     1904   DEFINE INPUT PARAMETER p-parent-feature AS integer NO-UNDO.
     1905   if p-parent-feature = integer('1':U) then do:
     1906     assign
     1907     X_rule-profile.name:BGCOLOR IN BROWSE br-rule-profile = GRAY_COLOR
     1908       .
     1909   end.
     1910   else do:
     1911     assign
     1912     X_rule-profile.name:BGCOLOR IN BROWSE br-rule-profile = ?
     1913       .
     1914   end.
     1915   END PROCEDURE.
