     1173   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1174     run mainmenu_getcntxt in parparentproc
     1175       (output v-cntxt-db-num
     1176       ,output v-cntxt-userid
     1177       ,output v-cntxt-level
     1178       ,output v-cntxt-host-code-obj
     1179       ,output v-cntxt-obj-type
     1180       ,output v-cntxt-obj-code
     1181       ,output v-cntxt-db-num-obj
     1182       ,output v-cntxt-is-admin
     1183       ) .
     1184   MAIN-BLOCK:
     1185   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1186      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1187     define buffer bf_clients for ub.clients.
     1188     define buffer bf_alc-type for ub.alc-type.
     1189     define buffer bf_alc-supp-lic-type for ub.alc-supp-lic-type.
     1190     if p-mode = 'ИЗМЕНЕНИЕ':U then do
     1191     transaction:
     1192        if p-rr = ? then do:
     1193           return error "ссылка на лицензию не передана".
     1194        end.
     1195        find first buf_alc-supp-lic
     1196             where recid(buf_alc-supp-lic) = p-rr
     1197             exclusive-lock
     1198             no-error
     1199             .
     1200        if not available buf_alc-supp-lic then do:
     1201           return error "неправильная ссылка на лицензию".
     1202        end.
     1203        assign
     1204          f-seria       = buf_alc-supp-lic.seria
     1205          f-number      = buf_alc-supp-lic.number
     1206          f-date-get    = buf_alc-supp-lic.date-get
     1207          f-who-are-got = buf_alc-supp-lic.who-are-got
     1208          f-date-from   = buf_alc-supp-lic.date-from
     1209          f-date-to     = buf_alc-supp-lic.date-to
     1210          t-all         = if buf_alc-supp-lic.all-type >= 1 then true else false
     1211        .
     1212        find first bf_clients
     1213             where bf_clients.obj-type = buf_alc-supp-lic.cli-type
     1214               and bf_clients.obj-code = buf_alc-supp-lic.cli-code
     1215             no-lock
     1216             no-error
     1217             .
     1218        if not available bf_clients then do:
     1219           return error substitute ("Поставщик &1&2 не найден.", buf_alc-supp-lic.cli-code, buf_alc-supp-lic.cli-type).
     1220        end.
     1221        assign
     1222           f-client = substitute( "&1&2, &3", bf_clients.obj-code, bf_clients.obj-type, bf_clients.obj-name )
     1223        .
     1224   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1225   define variable v-str-recid11 as character no-undo .
     1226   define variable v-num-entry11 as integer   no-undo .
     1227   assign
     1228     v-str-recid11 = trim( string( recid( bf_clients ) , "->>>>>>>>>>>9":U ) )
     1229     v-num-entry11 = lookup( v-str-recid11 , rid-list-supp )
     1230   .
     1231   if v-num-entry11 > 0 then do:
     1232     assign
     1233       entry( v-num-entry11, rid-list-supp ) = "":U
     1234       rid-list-supp = trim( replace( rid-list-supp , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1235     .
     1236   end.
     1237   else do:
     1238     assign
     1239       rid-list-supp = rid-list-supp + ( if rid-list-supp = "":U then "":U else chr(44) ) + v-str-recid11
     1240     .
     1241   end.
     1242        if t-all
     1243         then do:
     1244            assign
     1245               f-types = "выбраны"
     1246            .
     1247         end.
     1248         else do:
     1249            for each  bf_alc-supp-lic-type
     1250                where bf_alc-supp-lic-type.alc-supp-lic-code = buf_alc-supp-lic.alc-supp-lic-code
     1251                no-lock,
     1252                first bf_alc-type
     1253                where bf_alc-type.alc-type-inner-code = bf_alc-supp-lic-type.alc-type-inner-code
     1254                no-lock
     1255                :
     1256   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1257   define variable v-str-recid13 as character no-undo .
     1258   define variable v-num-entry13 as integer   no-undo .
     1259   assign
     1260     v-str-recid13 = trim( string( recid( bf_alc-type ) , "->>>>>>>>>>>9":U ) )
     1261     v-num-entry13 = lookup( v-str-recid13 , RowID-list )
     1262   .
     1263   if v-num-entry13 > 0 then do:
     1264     assign
     1265       entry( v-num-entry13, RowID-list ) = "":U
     1266       RowID-list = trim( replace( RowID-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1267     .
     1268   end.
     1269   else do:
     1270     assign
     1271       RowID-list = RowID-list + ( if RowID-list = "":U then "":U else chr(44) ) + v-str-recid13
     1272     .
     1273   end.
     1274            end.
     1275            if RowID-list = "" then DO:
     1276               assign
     1277                  f-types = "не выбраны"
     1278               .
     1279            end.
     1280            else do:
     1281               assign
     1282                  f-types = "выбраны"
     1283               .
     1284            end.
     1285         end.
     1286     end.
     1287     RUN enable_UI.
     1288     WAIT-FOR GO OF FRAME Dialog-Frame.
     1289   END.
     1290   RUN disable_UI.
     1291   PROCEDURE create-lic :
     1292       define buffer buf_clients for ub.clients .
     1293       define variable v-code as integer no-undo .
     1294        find first buf_clients
     1295             where recid(buf_clients) = INTEGER(ENTRY(1, rid-list-supp))
     1296             no-lock
     1297             no-error
     1298             .
     1299        v-code = next-value(s-alc-supp-lic, ub).
     1300        create buf_alc-supp-lic.
     1301        assign
     1302          buf_alc-supp-lic.alc-supp-lic-code = v-code
     1303          buf_alc-supp-lic.seria       = f-seria
     1304          buf_alc-supp-lic.number      = f-number
     1305          buf_alc-supp-lic.date-get    = f-date-get
     1306          buf_alc-supp-lic.who-are-got = f-who-are-got
     1307          buf_alc-supp-lic.date-from   = f-date-from
     1308          buf_alc-supp-lic.date-to     = f-date-to
     1309          buf_alc-supp-lic.all-type    = if t-all  then 1 else 0
     1310          buf_alc-supp-lic.cli-code    = buf_clients.obj-code
     1311          buf_alc-supp-lic.cli-type    = buf_clients.obj-type
     1312          buf_alc-supp-lic.create-user-db-num = v-cntxt-db-num
     1313          buf_alc-supp-lic.lic-status         = 0
     1314          buf_alc-supp-lic.create-user        = v-cntxt-userid
     1315          buf_alc-supp-lic.corr-user-name     = v-cntxt-userid
     1316          buf_alc-supp-lic.create-date        = today
     1317          buf_alc-supp-lic.corr-date          = today
     1318          buf_alc-supp-lic.create-time        = time
     1319          buf_alc-supp-lic.corr-time          = time
     1320        .
     1321         assign
     1322            p-rr = recid (buf_alc-supp-lic)
     1323         .
     1324   END PROCEDURE.
     1325   PROCEDURE disable_UI :
     1326     HIDE FRAME Dialog-Frame.
     1327   END PROCEDURE.
     1328   PROCEDURE enable_UI :
     1329     DISPLAY f-seria f-number f-date-get f-who-are-got f-date-from f-date-to t-all
     1330             f-client f-types
     1331         WITH FRAME Dialog-Frame.
     1332     ENABLE b-exit b-quit b-help b-supp f-seria f-number f-date-get f-who-are-got
     1333            f-date-from f-date-to b-types t-all f-client f-types
     1334         WITH FRAME Dialog-Frame.
     1335     VIEW FRAME Dialog-Frame.
     1336   END PROCEDURE.
     1337   PROCEDURE update-alc-type :
     1338   define buffer buf_alc-supp-lic-type for ub.alc-supp-lic-type .
     1339   define buffer buf_alc-type     for ub.alc-type     .
     1340     define variable v-count as integer no-undo .
     1341       for each  buf_alc-supp-lic-type
     1342           where buf_alc-supp-lic-type.alc-supp-lic-code = buf_alc-supp-lic.alc-supp-lic-code
     1343           exclusive-lock,
     1344           first buf_alc-type
     1345           where buf_alc-type.alc-type-inner-code = buf_alc-supp-lic-type.alc-type-inner-code
     1346           no-lock
     1347           :
     1348           if index(RowID-list, trim( string( recid(buf_alc-type) , "->>>>>>>>>>>9":U ) )) = 0 THEN do:
     1349              delete buf_alc-supp-lic-type.
     1350           end.
     1351       end.
     1352       DO v-count = 1 TO NUM-ENTRIES(RowID-list)
     1353       on error undo, next
     1354       :
     1355         find first buf_alc-type
     1356            where recid( buf_alc-type ) = INTEGER(ENTRY(v-count, RowID-list))
     1357            NO-LOCK
     1358            no-error.
     1359         IF AVAILABLE buf_alc-type
     1360         and not can-find( first buf_alc-supp-lic-type
     1361                           where buf_alc-supp-lic-type.alc-supp-lic-code   = buf_alc-supp-lic.alc-supp-lic-code
     1362                             and buf_alc-supp-lic-type.alc-type-inner-code = buf_alc-type.alc-type-inner-code)
     1363         THEN DO:
     1364            CREATE buf_alc-supp-lic-type.
     1365            ASSIGN
     1366               buf_alc-supp-lic-type.alc-supp-lic-code   = buf_alc-supp-lic.alc-supp-lic-code
     1367               buf_alc-supp-lic-type.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     1368               buf_alc-supp-lic-type.corr-date = today
     1369               buf_alc-supp-lic-type.corr-time = time
     1370               buf_alc-supp-lic-type.corr-user-name  = v-cntxt-userid
     1371               buf_alc-supp-lic-type.create-alc-type-user-db-num = v-cntxt-db-num
     1372               buf_alc-supp-lic-type.create-date = today
     1373               buf_alc-supp-lic-type.create-time = time
     1374               buf_alc-supp-lic-type.create-user = v-cntxt-userid
     1375               buf_alc-supp-lic-type.create-user-db-num = v-cntxt-db-num
     1376            .
     1377         END.
     1378       end.
     1379       FOR EACH buf_alc-supp-lic-type
     1380           EXCLUSIVE-LOCK
     1381           :
     1382           find first buf_alc-type
     1383                where buf_alc-type.alc-type-inner-code = buf_alc-supp-lic-type.alc-type-inner-code
     1384                NO-LOCK
     1385                no-error
     1386                .
     1387            IF NOT AVAILABLE buf_alc-type
     1388            OR INDEX( RowID-list, STRING(recid( buf_alc-type ))) = 0
     1389            THEN DO:
     1390               DELETE buf_alc-supp-lic-type.
     1391            END.
     1392       END.
     1393   END PROCEDURE.
     1394   PROCEDURE update-lic :
     1395       define buffer buf_clients for ub.clients .
     1396        find first buf_clients
     1397             where recid(buf_clients) = INTEGER(ENTRY(1, rid-list-supp))
     1398             no-lock
     1399             no-error
     1400             .
     1401        assign
     1402          buf_alc-supp-lic.seria       = f-seria
     1403          buf_alc-supp-lic.number      = f-number
     1404          buf_alc-supp-lic.date-get    = f-date-get
     1405          buf_alc-supp-lic.who-are-got = f-who-are-got
     1406          buf_alc-supp-lic.date-from   = f-date-from
     1407          buf_alc-supp-lic.date-to     = f-date-to
     1408          buf_alc-supp-lic.all-type    = if t-all  then 1 else 0
     1409          buf_alc-supp-lic.cli-code    = buf_clients.obj-code
     1410          buf_alc-supp-lic.cli-type    = buf_clients.obj-type
     1411          buf_alc-supp-lic.corr-user-name     = v-cntxt-userid
     1412          buf_alc-supp-lic.corr-date          = today
     1413          buf_alc-supp-lic.corr-time          = time
     1414        .
     1415   END PROCEDURE.
