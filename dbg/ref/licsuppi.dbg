        1   define input parameter parparentproc  as widget-handle no-undo .
        2   define input parameter p-mode as character no-undo.
        3   define input-output parameter p-rr      as  recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Редактирование лицензий на поставку алкоголя".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable RowID-list   as character no-undo .
      125   define variable rid-list-supp as character no-undo .
      126   define buffer buf_alc-supp-lic for ub.alc-supp-lic .
      127   DEFINE BUTTON b-exit AUTO-GO
      128        LABEL "Ввод"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON b-help
      132        LABEL "&Помощь"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE BUTTON b-quit AUTO-END-KEY
      136        LABEL "Отмена"
      137        SIZE 10 BY 1
      138        BGCOLOR 8 .
      139   DEFINE BUTTON b-supp
      140        IMAGE-UP FILE "btn-down-arrow":U
      141        IMAGE-DOWN FILE "btn-down-arrow":U
      142        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      143        LABEL "BUTTON-obj"
      144        SIZE 3 BY .88.
      145   DEFINE BUTTON b-types
      146        IMAGE-UP FILE "btn-down-arrow":U
      147        IMAGE-DOWN FILE "btn-down-arrow":U
      148        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      149        LABEL "типы"
      150        SIZE 3 BY .88 TOOLTIP "типы алкоголя, разрешенные к поставке по этой лицензии".
      151   DEFINE VARIABLE f-client AS CHARACTER FORMAT "X(40)":U  INITIAL "Не выбран поставщик"
      152         VIEW-AS TEXT
      153        SIZE 41.3 BY 1 NO-UNDO.
      154   DEFINE VARIABLE f-date-from AS DATE FORMAT "99/99/9999":U INITIAL ?
      155        LABEL "Дествует с"
      156        VIEW-AS FILL-IN
      157        SIZE 14 BY 1 NO-UNDO.
      158   DEFINE VARIABLE f-date-get AS DATE FORMAT "99/99/9999":U INITIAL ?
      159        LABEL "Дата выдачи"
      160        VIEW-AS FILL-IN
      161        SIZE 14 BY 1 NO-UNDO.
      162   DEFINE VARIABLE f-date-to AS DATE FORMAT "99/99/9999":U INITIAL ?
      163        LABEL "по"
      164        VIEW-AS FILL-IN
      165        SIZE 14 BY 1 NO-UNDO.
      166   DEFINE VARIABLE f-number AS CHARACTER FORMAT "X(16)":U
      167        LABEL "номер"
      168        VIEW-AS FILL-IN
      169        SIZE 16 BY 1 NO-UNDO.
      170   DEFINE VARIABLE f-seria AS CHARACTER FORMAT "X(16)":U
      171        LABEL "Серия"
      172        VIEW-AS FILL-IN
      173        SIZE 16 BY 1 NO-UNDO.
      174   DEFINE VARIABLE f-types AS CHARACTER FORMAT "X(10)":U INITIAL "не выбраны"
      175         VIEW-AS TEXT
      176        SIZE 10 BY 1 NO-UNDO.
      177   DEFINE VARIABLE f-who-are-got AS CHARACTER FORMAT "X(30)":U
      178        LABEL "Кем выдана"
      179        VIEW-AS FILL-IN
      180        SIZE 30 BY 1 NO-UNDO.
      181   DEFINE VARIABLE t-all AS LOGICAL INITIAL no
      182        LABEL "все типы алкоголя"
      183        VIEW-AS TOGGLE-BOX
      184        SIZE 20 BY 1 NO-UNDO.
      185   DEFINE FRAME Dialog-Frame
      186        b-exit AT ROW 1 COL 1
      187        b-quit AT ROW 1 COL 11
      188        b-help AT ROW 1 COL 42
      189        b-supp AT ROW 2.08 COL 1 WIDGET-ID 4
      190        f-seria AT ROW 3.13 COL 5 WIDGET-ID 2
      191        f-number AT ROW 3.13 COL 34.5 COLON-ALIGNED WIDGET-ID 8
      192        f-date-get AT ROW 4.21 COL 12 COLON-ALIGNED WIDGET-ID 10
      193        f-who-are-got AT ROW 5.25 COL 12 COLON-ALIGNED WIDGET-ID 12
      194        f-date-from AT ROW 6.33 COL 12 COLON-ALIGNED WIDGET-ID 14
      195        f-date-to AT ROW 6.33 COL 30.5 COLON-ALIGNED WIDGET-ID 16
      196        b-types AT ROW 7.42 COL 22.5 WIDGET-ID 20
      197        t-all AT ROW 7.5 COL 2 WIDGET-ID 18
      198        f-client AT ROW 2 COL 10 COLON-ALIGNED NO-LABEL WIDGET-ID 26
      199        f-types AT ROW 7.42 COL 32 COLON-ALIGNED NO-LABEL WIDGET-ID 24
      200        SPACE(9.30) SKIP(0.08)
      201       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      202            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      203            TITLE "Лицензия поставщика алкоголя"
      204            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      205   ASSIGN
      206          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      207          FRAME Dialog-Frame:HIDDEN           = TRUE.
      208   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      209   DO:
      210     APPLY "END-ERROR":U TO SELF.
      211   END.
      212   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      213   DO:
      214      assign
      215         f-seria
      216         f-number
      217         f-date-get
      218         f-who-are-got
      219         f-date-from
      220         f-date-to
      221         t-all
      222      .
      223     IF rid-list-supp = "" then DO:
      224        message "Выберите поставщика"
      225        view-as alert-box error.
      226        apply "entry"  to b-supp.
      227        return no-apply.
      228     end.
      229     if f-seria = "" then do:
      230        message "Введите серию лицензии"
      231        view-as alert-box error.
      232        apply "entry"  to f-seria.
      233        return no-apply.
      234     end.
      235     if f-number = "" then do:
      236        message "Введите номер лицензии"
      237        view-as alert-box error.
      238        apply "entry"  to f-number.
      239        return no-apply.
      240     end.
      241     if f-date-get = ? then do:
      242        message "Введите дату выдачи лицензии"
      243        view-as alert-box error.
      244        apply "entry"  to f-date-get.
      245        return no-apply.
      246     end.
      247     if f-date-from = ? then do:
      248        message "Введите дату начала действия лицензии"
      249        view-as alert-box error.
      250        apply "entry"  to f-date-from.
      251        return no-apply.
      252     end.
      253     if f-date-to = ? then do:
      254        message "Введите дату окончания действия лицензии"
      255        view-as alert-box error.
      256        apply "entry"  to f-date-to.
      257        return no-apply.
      258     end.
      259     if f-who-are-got = "" then do:
      260        message "Введите кем выдана лицензия"
      261        view-as alert-box error.
      262        apply "entry"  to f-who-are-got.
      263        return no-apply.
      264     end.
      265     if not t-all
      266     and RowID-list = "" then do:
      267        message "Введите типы алкоголя, разрешенные к поставке по этой лицензии"
      268        view-as alert-box error.
      269        apply "entry"  to b-types.
      270        return no-apply.
      271     end.
      272     do
      273     transaction:
      274      if p-rr = ? then do:
      275         run create-lic in this-procedure.
      276      end.
      277      else do:
      278         run update-lic in this-procedure.
      279      end.
      280      run update-alc-type in this-procedure.
      281     end.
      282   END.
      283   ON CHOOSE OF b-supp IN FRAME Dialog-Frame
      284   DO:
      285      define buffer buf_clients for ub.clients .
      286         run ref/cli-all.w ( input  parparentproc
      287                         , input  "b-sel"
      288                         , input  'все':U
      289                         , input  'все':U
      290                         , input  'текущие':U
      291                         , input  ?
      292                         , input  ",,,,,,NO,,"
      293                         , input  ""
      294                         , output rid-list-supp
      295                         ) .
      296         IF rid-list-supp <> "" then DO:
      297            find first buf_clients
      298                 where recid(buf_clients) = INTEGER(ENTRY(1, rid-list-supp))
      299                 no-lock
      300                 no-error
      301                 .
      302            if available buf_clients then DO:
      303               assign
      304                   f-client = substitute( "&1&2, &3", buf_clients.obj-code, buf_clients.obj-type, buf_clients.obj-name )
      305               .
      306            end.
      307         END.
      308      assign
      309         f-seria
      310         f-number
      311         f-date-get
      312         f-who-are-got
      313         f-date-from
      314         f-date-to
      315         t-all
      316      .
      317     RUN enable_UI.
      318   END.
      319   ON CHOOSE OF b-types IN FRAME Dialog-Frame
      320   DO:
      321     define buffer buf_alc-supp-lic-type for ub.alc-supp-lic-type .
      322     define buffer buf_alc-type     for ub.alc-type .
      323     define variable v-ok as logical no-undo .
      324     define variable v-count as integer no-undo .
      325     if t-all then do:
      326        message 'Выставлен признак "все типы алкоголя" ' SKIP
      327                'Снять признак и продолжить выбор типов алкоголя?'
      328        view-as alert-box question
      329        buttons ok-cancel
      330        update v-ok
      331        .
      332        if not v-ok then do:
      333           return no-apply.
      334        end.
      335        else do:
      336            assign
      337               t-all = false
      338            .
      339        end.
      340     end.
      341     run ref/alc-type.w
      342       ( input Parparentproc
      343       , input "b-sel,b-mark"
      344       , input-OUTPUT RowID-list
      345       , output v-ok
      346         ).
      347     if RowID-list = ""
      348     and not t-all
      349     then do:
      350       assign
      351        f-types = "не выбраны"
      352       .
      353     end.
      354     else do:
      355       assign
      356        f-types = "выбраны"
      357        .
      358     end.
      359      assign
      360         f-seria
      361         f-number
      362         f-date-get
      363         f-who-are-got
      364         f-date-from
      365         f-date-to
      366         t-all
      367      .
      368     RUN enable_UI.
      369   END.
      370   ON VALUE-CHANGED OF t-all IN FRAME Dialog-Frame
      371   DO:
      372      assign
      373         f-seria
      374         f-number
      375         f-date-get
      376         f-who-are-got
      377         f-date-from
      378         f-date-to
      379         t-all
      380      .
      381      IF t-all
      382      THEN DO:
      383         ASSIGN
      384            RowID-list = ""
      385            f-types = "выбраны"
      386         .
      387      END.
      388      ELSE DO:
      389         assign
      390            f-types = "не выбраны"
      391         .
      392      END.
      393      RUN enable_UI.
      394   END.
      395   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      396   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      397   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   on help of frame Dialog-Frame
      399   do:
      400     run gbl/app_help.p
      401       (input this-procedure :file-name
      402       ,input ''
      403       ,input ?
      404       ) no-error.
      405     if error-status :error then do:
      406       message
      407         "Ошибка при вызове помощи"
      408         error-status :get-message(1)
      409         view-as alert-box .
      410     end.
      411   end.
      412   run minbtn-set in this-procedure .
      413   on choose of b-help in frame Dialog-Frame
      414   do:
      415     apply "help":u to frame Dialog-Frame .
      416   end.
      417   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   procedure minbtn-set :
      419       do
      420           on error undo, return error return-value
      421           :
      422           define variable ii              as integer       no-undo .
      423           define variable fh              as widget-handle no-undo .
      424           define variable hh              as widget-handle no-undo .
      425           define variable v-h             as handle        extent 4 no-undo .
      426           define variable v-name-button   as character     no-undo .
      427           define variable v-help-old-x    as decimal       no-undo .
      428           define variable v-help-old-y    as decimal       no-undo .
      429           define variable v-help-old-size as decimal       no-undo .
      430           define variable v-frame-width   as decimal       no-undo .
      431           define variable jj              as integer       no-undo .
      432           do
      433               on error undo, return error
      434               :
      435               assign
      436                   v-frame-width = frame Dialog-Frame:width - 0.3
      437                   fh            = frame Dialog-Frame:first-child
      438                   hh            = fh:first-child
      439                   ii            = 1
      440                   .
      441               do while valid-handle(hh):
      442                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      443                   do:
      444                       case lc(hh:name) :
      445                           when "b-help" then
      446                               do:
      447                                   hh:load-image-up("cmp/b-help.bmp":u) .
      448                                   hh:load-image-down("cmp/b-help.bmp":u) .
      449                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      450                                   hh:TOOLTIP = "Помощь" .
      451                                   v-help-old-x = hh:column .
      452                                   v-help-old-y = hh:row    .
      453                                   v-help-old-size = hh:width .
      454                                   hh:width-chars = 2.5 .
      455                               end.
      456                           when "b-print" then
      457                               do:
      458                                   hh:load-image("cmp/b-print.bmp":u) .
      459                                   hh:TOOLTIP = "Печать" .
      460                                   v-h[ii] = hh:handle .
      461                                   ii = ii + 1 .
      462                                   hh:width-chars = 3 .
      463                               end.
      464                           when "b-history" or
      465                           when "b-hist" then
      466                               do:
      467                                   hh:load-image("cmp/b-hist.bmp":u) .
      468                                   hh:TOOLTIP = "История" .
      469                                   v-h[ii] = hh:handle .
      470                                   ii = ii + 1 .
      471                                   hh:width-chars = 3 .
      472                               end.
      473                           when "b-sch" then
      474                               do:
      475                                   hh:load-image("cmp/b-sch.bmp":u) .
      476                                   hh:TOOLTIP = "Установка Фильтра" .
      477                                   v-h[ii] = hh:handle .
      478                                   ii = ii + 1 .
      479                                   hh:width-chars = 3 .
      480                               end.
      481                           when "b-hist-user" then
      482                               do:
      483                                   hh:load-image("cmp/b-hist.bmp":u) .
      484                                   hh:TOOLTIP = "История пользователя" .
      485                                   ii = ii + 1 .
      486                               end.
      487                       end case.
      488                   end.
      489                   hh = hh:next-sibling.
      490               end.
      491               b-help:column = v-frame-width - b-help:width-chars.
      492               jj = 0.
      493               repeat ii = 4 to 1 by -1 :
      494                   if valid-handle (v-h[ii] ) then
      495                   do:
      496                       jj  = jj + 1 .
      497                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      498                       v-h[ii]:row    = v-help-old-y .
      499                   end.
      500               end.
      501           end.
      502       end.
      503   end procedure.
      504   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      505   on ' ' of f-date-from in frame Dialog-Frame
      506   do:
      507     if (can-query (self, "sensitive")
      508        and
      509        self :sensitive = true
      510        )
      511     or (can-query (self, "read-only")
      512        and
      513        self :read-only = false
      514        )
      515     then do:
      516       assign
      517         self :screen-value = ?
      518       .
      519     end.
      520     return no-apply.
      521   end.
      522   on delete-character of f-date-from in frame Dialog-Frame
      523   do:
      524     if (can-query (self, "sensitive")
      525        and
      526        self :sensitive = true
      527        )
      528     or (can-query (self, "read-only")
      529        and
      530        self :read-only = false
      531        )
      532     then do:
      533       assign
      534         self :screen-value = ?
      535       .
      536     end.
      537     return no-apply.
      538   end.
      539   on ctrl-d of f-date-from in frame Dialog-Frame
      540   do:
      541     define variable v-curr-sv-date as date no-undo .
      542     if (can-query (self, "sensitive")
      543        and
      544        self :sensitive = true
      545        )
      546     or (can-query (self, "read-only")
      547        and
      548        self :read-only = false
      549        )
      550     then do:
      551       if self :handle <> focus :handle
      552       then do:
      553         apply "entry":u to self .
      554       end.
      555       run gbl/getcurdt.p
      556         (output v-curr-sv-date
      557         ) .
      558       assign
      559         self :screen-value = string(v-curr-sv-date) .
      560       .
      561     end.
      562     return no-apply.
      563   end.
      564   on ctrl-b of f-date-from in frame Dialog-Frame
      565   do:
      566     if (can-query (self, "sensitive")
      567        and
      568        self :sensitive = true
      569        )
      570     or (can-query (self, "read-only")
      571        and
      572        self :read-only = false
      573        )
      574     then do:
      575       if self :handle <> focus :handle
      576       then do:
      577         apply "entry":u to self .
      578       end.
      579       define variable v-curr-sv-date as date no-undo .
      580       define variable v-new-sv-date  as date no-undo .
      581       assign
      582         v-curr-sv-date = date(self :screen-value) no-error
      583       .
      584       if v-curr-sv-date = ?
      585       then do:
