     5012      RUN proc-title IN THIS-PROCEDURE.
     5013   END PROCEDURE.
     5014   PROCEDURE proc-b-add :
     5015      define input parameter p-table as character no-undo.
     5016      define variable attr-type           as character no-undo .
     5017      define variable attr-format         as character no-undo .
     5018      define variable attr-label          as character no-undo .
     5019      DEFINE VARIABLE attr-range          as integer   no-undo .
     5020      define variable attr-user-can-edit  as logical   no-undo .
     5021      define variable attr-output-display as logical   no-undo .
     5022      define variable attr-other          as char      no-undo .
     5023      define var      loc#log             as logical   no-undo.
     5024      define variable loc-action          as logical   no-undo.
     5025      DEFINE VARIABLE jj                  as integer   no-undo .
     5026      DEFINE VARIABLE v-spr               as character no-undo .
     5027      DEFINE VARIABLE v-spr-param         as character no-undo .
     5028      DEFINE VARIABLE v-add-option        as character no-undo .
     5029      DEFINE VARIABLE v-deleted           as logical   no-undo .
     5030      define buffer buf_temp-attr for temp-attr.
     5031      do
     5032         on error undo, return error
     5033         :
     5034         if add-option = "" then
     5035         do:
     5036            run gbl/pop-up.p ( input self:handle, input no) no-error.
     5037         end.
     5038         if add-option = "":U then return error.
     5039         assign
     5040            v-add-option = add-option
     5041            .
     5042         run tempattr-exist in this-procedure (
     5043            input add-option
     5044            ,input add-host
     5045            ,input add-obj-type
     5046            ,input add-obj-code
     5047            ,output loc#log
     5048            ,output loc-action)  no-error.
     5049         if error-status:error or loc#log then
     5050         do:
     5051            if not error-status:error then
     5052               message
     5053                  "Атрибут уже присутствует" skip
     5054                  string(if loc-action = yes
     5055                  then "в списке атрибутов, подлежащих установке/изменению"
     5056                  else "в списке атрибутов, подлежащих удалению"
     5057                  )
     5058                  view-as alert-box ERROR.
     5059            undo, return error.
     5060         end.
     5061         CASE p-table:
     5062            when 'gds-obj-attr':U then
     5063               do:
     5064                  run gdsoattr-name in this-procedure (
     5065                     input  add-option
     5066                     ,output attr-type
     5067                     ,output attr-format
     5068                     ,output attr-label
     5069                     ,output attr-user-can-edit
     5070                     ,output attr-output-display
     5071                     ,output attr-other
     5072                     ) no-error .
     5073                  if error-status :error then
     5074                  do:
     5075                     undo, return error .
     5076                  end.
     5077               end.
     5078            when 'gds-host-attr':U then
     5079               do:
     5080                  run gdshattr-name in this-procedure (
     5081                     input  add-option
     5082                     ,output attr-type
     5083                     ,output attr-format
     5084                     ,output attr-label
     5085                     ,output attr-user-can-edit
     5086                     ,output attr-output-display
     5087                     ,output attr-other
     5088                     ) no-error .
     5089                  if error-status :error then
     5090                  do:
     5091                     undo, return error.
     5092                  end.
     5093               end.
     5094            when 'clients-attr':U then
     5095               do:
     5096                  run clntattr-code in this-procedure (
     5097                     input  add-option
     5098                     ,output attr-type
     5099                     ,output attr-format
     5100                     ,output attr-label
     5101                     ,output attr-user-can-edit
     5102                     ,output attr-output-display
     5103                     ,output attr-other
     5104                     ) no-error .
     5105                  if error-status :error then
     5106                  do:
     5107                     return no-apply .
     5108                  end.
     5109               end.
     5110            when 'goods-attr':U then
     5111               do:
     5112                  run gds-attr-name in this-procedure (
     5113                     input  add-option
     5114                     ,output attr-type
     5115                     ,output attr-format
     5116                     ,output attr-label
     5117                     ,output attr-user-can-edit
     5118                     ,output attr-output-display
     5119                     ,output attr-other
     5120                     ) no-error .
     5121                  if error-status :error then
     5122                  do:
     5123                     undo, return error .
     5124                  end.
     5125               end.
     5126         END CASE.
     5127         run tempattr-write in this-procedure (
     5128            input yes
     5129            ,input add-option
     5130            ,input add-host
     5131            ,input add-obj-type
     5132            ,input add-obj-code
     5133            ,input (if attr-type = 'L':U
     5134            then "yes":U
     5135            else
     5136            (
     5137            if attr-type = 'T':U
     5138            then ?
     5139            else string(0)
     5140            )
     5141            )
     5142            ,input yes
     5143            ) no-error .
     5144         IF ERROR-STATUS:ERROR THEN
     5145         DO:
     5146            message "Ошибка при определении названия и типа атрибута !"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     5147            undo,  return error.
     5148         END.
     5149         updated = yes.
     5150         find first buf_temp-attr no-lock where
     5151            buf_temp-attr.attr-code = add-option no-error.
     5152         if avail buf_temp-attr then
     5153            temp-doc-rec = recid(buf_temp-attr).
     5154         else temp-doc-rec = ?.
     5155         Run init-proc in this-procedure no-error.
     5156         if error-status:error then
     5157         do:
     5158            undo, return error.
     5159         end.
     5160         REPOSITION br-add to recid temp-doc-rec no-error.
     5161         run proc-b-chg in this-procedure ( input "":U) no-error.
     5162         if error-status:error then
     5163         do:
     5164            run tempattr-delete in this-procedure (
     5165               input v-add-option
     5166               ,input 0
     5167               ,input "":U
     5168               ,input 0
     5169               ,output v-deleted
     5170               ) no-error .
     5171            Run init-proc in this-procedure no-error.
     5172            undo, return error.
     5173         end.
     5174         APPLY "ENTRY" to br-add in frame Dialog-Frame.
     5175      end.
     5176   END PROCEDURE.
