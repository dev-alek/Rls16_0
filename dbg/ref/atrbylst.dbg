     4915                  ,input parobj-code).
     4916               assign
     4917                  v-edit-proc-name     = 'gdsoattr-batch-edit'
     4918                  v-tooltip-proc-name  = 'gdsoattr-tooltip'
     4919                  v-attr-list-pre-name = 'scales-code,fbr-cost-rubl,gds-margins,free-price,sum-grp,increase-pc,round-method,petrol-purse,min-zapas,need-auth,proprietor,no-income-goods,taracode,calories-o,protein-o,fat-o,carbohydrate-o,doc-tickets,normal-wastage-o,dop-alt-name-o,dt-seasons,change-dt-seasons,mark-collect-type':u
     4920                  .
