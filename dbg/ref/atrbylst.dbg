     5387                  ,output attr-output-display
     5388                  ,output attr-other
     5389                  ) no-error .
     5390               if error-status :error then
     5391               do:
     5392                  return error .
     5393               end.
     5394               run tempattr-write in this-procedure (
     5395                  input yes
     5396                  ,input add-option
     5397                  ,input 0
     5398                  ,input "":U
     5399                  ,input 0
     5400                  ,input (if attr-type = 'L':U
     5401                  then "yes":U
     5402                  else
     5403                  (
     5404                  if attr-type = 'T':U
     5405                  then ?
     5406                  else string(0)
     5407                  )
     5408                  )
     5409                  ,input no
     5410                  )  no-error.
     5411               IF ERROR-STATUS:ERROR THEN
     5412               DO:
     5413                  message "Ошибка при определении названия и типа атрибута !"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     5414                  return error.
     5415               END.
     5416            END.
     5417      END CASE.
     5418      updated = yes.
     5419      find first buf_temp-attr no-lock where
     5420         buf_temp-attr.attr-code = add-option
     5421         AND buf_temp-attr.HOST-CODE = add-HOST
     5422         and buf_temp-attr.OBJ-TYPE = add-OBJ-TYPE
     5423         and buf_temp-attr.OBJ-CODE = add-OBJ-CODE  no-error.
     5424      if avail buf_temp-attr then
     5425         temp-doc-rec = recid(buf_temp-attr).
     5426      else temp-doc-rec = ?.
     5427      Run init-proc in this-procedure .
     5428      reposition BR-del to recid temp-doc-rec no-error.
     5429      if error-status:error then return error.
     5430      APPLY "ENTRY" to br-del in frame Dialog-Frame .
     5431   END PROCEDURE.
     5432   PROCEDURE proc-b-chg :
     5433      define input parameter p-mode as character no-undo .
     5434      define variable attr-value          as character no-undo .
     5435      define variable attr-type           as character no-undo .
     5436      define variable attr-format         as character no-undo .
     5437      define variable attr-label          as character no-undo .
     5438      DEFINE VARIABLE attr-range          as integer   no-undo .
     5439      define variable attr-user-can-edit  as logical   no-undo .
     5440      define variable attr-output-display as logical   no-undo .
     5441      define variable attr-other          as char      no-undo .
     5442      DEFINE VARIABLE jj                  as integer   no-undo .
     5443      DEFINE VARIABLE v-spr               as character no-undo .
     5444      DEFINE VARIABLE v-spr-ext           as character no-undo .
     5445      DEFINE VARIABLE v-spr-param         as character no-undo .
     5446      define variable v-setted            as logical   no-undo .
     5447      define variable v-check             as character no-undo .
     5448      define variable v-attr-entry        as character no-undo .
     5449      if not avail temp-attr then return error.
     5450      CASE par-subject:
     5451         when 'gds-obj-attr':U then
     5452            do:
     5453               run gdsoattr-name in this-procedure (
     5454                  input  TEMP-attr.attr-code
     5455                  ,output attr-type
     5456                  ,output attr-format
     5457                  ,output attr-label
     5458                  ,output attr-user-can-edit
     5459                  ,output attr-output-display
     5460                  ,output attr-other
     5461                  ) no-error .
     5462            end.
     5463         when 'gds-host-attr':U then
     5464            do:
     5465               run gdshattr-name in this-procedure (
     5466                  input  TEMP-attr.attr-code
     5467                  ,output attr-type
     5468                  ,output attr-format
     5469                  ,output attr-label
     5470                  ,output attr-user-can-edit
     5471                  ,output attr-output-display
     5472                  ,output attr-other
     5473                  ) no-error .
     5474            end.
     5475         when 'clients-attr':U then
     5476            do:
     5477               run clntattr-code in this-procedure (
     5478                  input TEMP-attr.attr-code
     5479                  ,output attr-type
     5480                  ,output attr-format
     5481                  ,output attr-label
     5482                  ,output attr-user-can-edit
     5483                  ,output attr-output-display
     5484                  ,output attr-other
     5485                  ) no-error.
     5486            end.
     5487         WHEN 'goods-attr':U THEN
     5488            DO:
     5489               run gds-attr-name in this-procedure (
     5490                  input  TEMP-attr.attr-code
     5491                  ,output attr-type
     5492                  ,output attr-format
     5493                  ,output attr-label
     5494                  ,output attr-user-can-edit
     5495                  ,output attr-output-display
     5496                  ,output attr-other
     5497                  ) no-error .
     5498            END.
     5499      END CASE.
     5500      IF ERROR-STATUS:ERROR THEN
     5501      DO:
     5502         message "Ошибка при определении названия и типа атрибута !"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     5503         return error.
     5504      END.
     5505      RUN tempATTR-VALUE IN THIS-PROCEDURE (
     5506         input TEMP-attr.attr-code
     5507         ,input temp-attr.host-code
     5508         ,input temp-attr.obj-type
     5509         ,input temp-attr.obj-code
     5510         ,input p-mode
     5511         ,OUTPUT ATTR-VALUE
     5512         ,OUTPUT attr-type) NO-ERROR.
     5513      IF ERROR-STATUS:ERROR THEN
     5514      DO:
     5515         if return-value <> "not-set":U then
     5516         do:
     5517            message "Ошибка при определении значения атрибута !"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     5518         end.
     5519         RETURN error.
     5520      END.
     5521      if return-value = "not-set":U
     5522         and p-mode <> "change":U then
     5523      do:
     5524         delete temp-attr.
     5525         glog = br-add:refresh() in frame Dialog-Frame no-error .
     5526         return .
     5527      end.
     5528      IF attr-user-can-edit Then
     5529      DO:
     5530         do jj = 1 to num-entries(attr-other, chr(47)):
     5531            v-attr-entry = entry(jj, attr-other, chr(47)) .
     5532            if entry(1, v-attr-entry, "=":U) = "spr":U then
     5533            do:
     5534               assign
     5535                  v-spr = string(entry(2, v-attr-entry, "=":U))
     5536                  .
     5537            end.
     5538            if entry(1, v-attr-entry, "=":U) = "spr-ext":U then
     5539            do:
     5540               assign
     5541                  v-spr-ext = entry(2, v-attr-entry, "=":U)
     5542                  .
     5543            end.
     5544            if entry(1, v-attr-entry, "=":U) = "spr-param":U then
     5545            do:
     5546               assign
     5547                  v-spr-param = entry(2, v-attr-entry, "=":U)
     5548                  .
     5549            end.
     5550         end.
     5551         if v-spr = "":U and v-spr-ext = "" then
     5552         do:
     5553            run gbl/d-prompt.w (
     5554               'title=':u + "Изменение атрибута" + '\':u
     5555               + 'text1=':u + attr-label + '\':u
     5556               + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     5557               + 'type=' + attr-type + '\':u
     5558               + 'fillin_row=2\':u
     5559               + 'fillin_col=4\':u
     5560               + 'fillin_width=20\':u
     5561               + 'fillin_height=1\':u
     5562               + 'max-chars=70\':u
     5563               + 'readonly=no' + '\':u
     5564               , input-output attr-value
     5565               ).
     5566            if return-value = 'false':u then return error.
     5567         end.
     5568         else
     5569         do:
     5570            attr-value = "" .
     5571            if v-spr = '':u then
     5572            do:
     5573               if v-spr-param = "":U then
     5574               do:
     5575                  run  value(v-spr-ext)  (
     5576                     input ('ДОБАВЛЕНИЕ':U)
     5577                     ,input 0
     5578                     ,input-output attr-value
     5579                     ,output v-setted) no-error .
     5580               end.
     5581               else
     5582               do:
     5583                  run  value(v-spr-ext) (
     5584                     input ('ДОБАВЛЕНИЕ':U)
     5585                     ,input 0
     5586                     ,input v-spr-param
     5587                     ,input-output attr-value
     5588                     ,output v-setted) no-error .
     5589               end.
     5590               if not v-setted then return error.
     5591            end.
     5592            if v-spr-ext = '':U then
     5593            do:
     5594               if v-spr-param = "":U then
     5595               do:
     5596                  run  value(v-spr) in this-procedure (
     5597                     input 0
     5598                     ,input-output attr-value
     5599                     ,output v-setted) no-error .
     5600               end.
     5601               else
     5602               do:
     5603                  run  value(v-spr) in this-procedure (
     5604                     input 0
     5605                     ,input v-spr-param
     5606                     ,input-output attr-value
     5607                     ,output v-setted) no-error .
     5608               end.
     5609               if not v-setted then return error.
     5610            end.
     5611         end.
     5612         run tempattr-write (
     5613            input no
     5614            ,input temp-attr.attr-code
     5615            ,input temp-attr.host-code
     5616            ,input temp-attr.obj-type
     5617            ,input temp-attr.obj-code
     5618            ,input attr-value
     5619            ,input temp-attr.action) no-error.
     5620         IF not error-status:error then
     5621         do:
     5622            assign
     5623               updated = yes
     5624               .
     5625         END.
     5626         glog = br-add:refresh() in frame Dialog-Frame no-error .
     5627      End.
     5628      Else
     5629         message "Изменение атрибута невозможно !"
     5630            view-as alert-box error.
     5631      APPLY "ENTRY" to br-add.
     5632   END PROCEDURE.
     5633   PROCEDURE proc-b-exit :
     5634      define variable loc#log      as logical no-undo .
     5635      define variable v-not-all-ok as logical no-undo .
     5636      define variable v-num-list   as integer no-undo .
     5637      define variable v-delete-ok  as logical no-undo .
     5638      if not can-find(first temp-attr) then
     5639      do:
     5640         message "Вы не определили список атрибутов для изменения (добавления, удаления)"
     5641            view-as alert-box.
     5642         return no-apply.
     5643      end.
     5644      if t-delete-ok:visible in frame Dialog-Frame then
     5645         ASSIGN
     5646            FRAME Dialog-Frame t-delete-ok.
     5647      assign
     5648         v-delete-ok = t-delete-ok.
     5649      CASE par-subject:
     5650         when 'gds-obj-attr':U then
     5651            do:
     5652               if not can-find(first gds-list) then
     5653               do:
     5654                  message "Вы не определили список товаров"
     5655                     view-as alert-box.
     5656                  return no-apply.
     5657               end.
     5658               if not can-find(first obj-list) then
     5659               do:
     5660                  message "Вы не определили список объектов"
     5661                     view-as alert-box.
     5662                  return no-apply.
     5663               end.
     5664               message
     5665                  "Вы уверены, что Вы хотите провести изменение (добавление, удаление) атрибутов товара на объекте" SKIP
     5666                  "по всему определенному Вами списку?"
     5667                  view-as alert-box QUESTION buttons YES-NO update loc#log.
     5668               for each obj-list :
     5669                  v-num-list = v-num-list + 1.
     5670                  if v-num-list > 1 then leave.
     5671               end.
     5672               if loc#log then
     5673               do:
     5674                  run str/diallog.w (
     5675                     input parparentproc
     5676                     , input this-procedure
     5677                     , input "ref/goatrlst.p":U
     5678                     , input (string(parhost-code) + chr(4) + parobj-type + chr(4) + string(parobj-code) + chr(4) + string(v-delete-ok))
     5679                     , input no
     5680                     , input "&Стоп":U
     5681                     , input substitute("Изменение атрибутов товаров по списку товаров"
     5682                     )
     5683                     ) no-error.
     5684                  assign
     5685                     v-not-all-ok = can-find(first gds-list) AND v-num-list = 1.
     5686               end.
     5687            end.
     5688         when 'gds-host-attr':U then
     5689            do:
     5690               if not can-find(first gds-list) then
     5691               do:
     5692                  message "Вы не определили список товаров"
     5693                     view-as alert-box.
     5694                  return no-apply.
     5695               end.
     5696               if not can-find(first obj-list) then
     5697               do:
     5698                  message "Вы не определили список фирм"
     5699                     view-as alert-box.
     5700                  return no-apply.
     5701               end.
     5702               message
     5703                  "Вы уверены, что Вы хотите провести изменение (добавление, удаление) атрибутов товара на фирме" SKIP
     5704                  "по всему определенному Вами списку?"
     5705                  view-as alert-box QUESTION buttons YES-NO update loc#log.
     5706               for each obj-list
     5707                  :
     5708                  v-num-list = v-num-list + 1.
     5709                  if v-num-list > 1 then leave.
     5710               end.
     5711               if loc#log then
     5712               do:
     5713                  run str/diallog.w (
     5714                     input parparentproc
     5715                     , input this-procedure
     5716                     , input "ref/ghatrlst.p":U
     5717                     , input (string(parhost-code) + chr(4) + parobj-type + chr(4) + string(parobj-code) + chr(4) + string(v-delete-ok))
     5718                     , input no
     5719                     , input "&Стоп":U
     5720                     , input substitute("Изменение атрибутов товаров на фирме по списку товаров"
     5721                     )
     5722                     ) no-error.
     5723                  assign
     5724                     v-not-all-ok = can-find(first gds-list) AND v-num-list = 1.
     5725               end.
     5726            end.
     5727         when 'clients-attr':U then
     5728            do:
     5729               if not can-find(first cli-list) then
     5730               do:
     5731                  message "Вы не определили список клиентов"
     5732                     view-as alert-box.
     5733                  return no-apply.
     5734               end.
     5735               message
     5736                  "Вы уверены, что Вы хотите провести изменение (добавление, удаление) атрибутов клиентов" SKIP
     5737                  "по всему определенному Вами списку?"
     5738                  view-as alert-box QUESTION buttons YES-NO update loc#log.
     5739               if loc#log then
     5740               do:
     5741                  run str/diallog.w (
     5742                     input parparentproc
     5743                     , input this-procedure
     5744                     , input "ref/clatrlst.p":U
     5745                     , input (string(parhost-code) + chr(4) + parobj-type + chr(4) + string(parobj-code) + chr(4) + string(v-delete-ok))
     5746                     , input no
     5747                     , input "&Стоп":U
     5748                     , input substitute("Изменение атрибутов клиентов по списку клиентов"
     5749                     )
     5750                     ) no-error.
     5751                  assign
     5752                     v-not-all-ok = can-find(first cli-list).
     5753               end.
     5754            end.
     5755         WHEN 'goods-attr':U THEN
     5756            DO:
     5757               if not can-find(first gds-list) then
     5758               do:
     5759                  message "Вы не определили список товаров"
     5760                     view-as alert-box.
     5761                  return no-apply.
     5762               end.
     5763               message
     5764                  "Вы уверены, что Вы хотите провести изменение (добавление, удаление) глобальных атрибутов товара" SKIP
     5765                  "по всему определенному Вами списку?"
     5766                  view-as alert-box QUESTION buttons YES-NO update loc#log.
     5767               if loc#log then
     5768               do:
     5769                  run str/diallog.w (
     5770                     input parparentproc
     5771                     , input this-procedure
     5772                     , input "ref/g-atrlst.p":U
     5773                     , input (string(parhost-code) + chr(4) + parobj-type + chr(4) + string(parobj-code) + chr(4) + string(v-delete-ok))
     5774                     , input no
     5775                     , input "&Стоп":U
     5776                     , input substitute("Изменение глобальных атрибутов товара по списку товаров"
     5777                     , parobj-type
     5778                     , parobj-code
     5779                     )
     5780                     ) no-error.
     5781                  assign
     5782                     v-not-all-ok = can-find(first gds-list).
     5783               end.
     5784            END.
     5785      END CASE.
     5786      if v-not-all-ok and v-delete-ok then
     5787      do:
     5788         assign
     5789            b-list:width = 30
     5790            b-list:label = "Список неизменившихся".
     5791      end.
     5792   END PROCEDURE.
     5793   PROCEDURE proc-title :
     5794      CASE par-subject:
     5795         WHEN 'gds-obj-attr':U THEN
     5796            DO:
     5797               frame Dialog-Frame:title = substitute("Изменение атрибутов товара на объекте по списку товаров") .
     5798               assign
     5799                  v-tab-order = "b-exit,b-quit,b-list,b-list-obj,b-help,T-delete-ok,b-add,b-add-2".
     5800            END.
     5801         WHEN 'gds-host-attr':U THEN
     5802            DO:
     5803               frame Dialog-Frame:title = substitute("Изменение атрибутов товара на фирме по списку товаров"
     5804                  ,parhost-code).
     5805               assign
     5806                  v-tab-order = "b-exit,b-quit,b-list,b-list-obj,b-help,T-delete-ok,b-add,b-add-2".
     5807            END.
     5808         when 'clients-attr':U then
     5809            do:
     5810               frame Dialog-Frame:title = "Изменение атрибутов клиента по списку клиентов".
     5811               assign
     5812                  v-tab-order  = "b-exit,b-quit,b-list,b-help,T-delete-ok,b-add,b-add-2"
     5813                  b-list:label = "Список клиентов".
     5814            end.
     5815         WHEN 'goods-attr':U THEN
     5816            DO:
     5817               frame Dialog-Frame:title = substitute("Изменение глобальных атрибутов товара по списку товаров") .
     5818               assign
     5819                  v-tab-order = "b-exit,b-quit,b-list,b-help,T-delete-ok,b-add,b-add-2".
     5820            END.
     5821      END CASE.
     5822      APPLY "ENTRY" TO b-add IN FRAME Dialog-Frame.
     5823   END PROCEDURE.
     5824   PROCEDURE proc-write :
     5825   END PROCEDURE.
