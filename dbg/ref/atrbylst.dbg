     4957         when 'clients-attr':U then
     4958            do:
     4959               disable
     4960                  b-list-obj
     4961                  with frame Dialog-Frame .
     4962            end.
     4963         when 'goods-attr':U then
     4964            do:
     4965               disable
     4966                  b-list-obj
     4967                  with frame Dialog-Frame .
     4968   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4969     (input  'alcohol'
     4970     ,input  ''
     4971     ,input  ''
     4972     ,input  0
     4973     ,input  ''
     4974     ,input  ''
     4975     ,input  ''
     4976     ,input  no
     4977     ,output alco-val
     4978     ,output alco-type
     4979     ) no-error .
     4980               assign
     4981                  alco-val-log = logical(alco-val) no-error
     4982                  .
     4983               if alco-val-log <> yes then
     4984               do:
     4985                  for each tt-attr-property where
     4986                     tt-attr-property.table-name = 'goods-attr':U
     4987                     and tt-attr-property.attr-code = 'alcohol-prod':U :
     4988                     assign
     4989                        tt-attr-property.menu-item-handle:sensitive = no
     4990                        .
     4991                  end.
     4992               end.
     4993            end.
     4994         when 'gds-obj-attr':U then
     4995            do:
     4996              if not glog and glog-obj then do:
