     4859         .
     4860      APPLY "CHOOSE" to b-add-2 in frame Dialog-Frame .
     4861   END PROCEDURE.
     4862   PROCEDURE disable_UI :
     4863      HIDE FRAME Dialog-Frame.
     4864   END PROCEDURE.
     4865   PROCEDURE enable_UI :
     4866      DISPLAY T-delete-ok E-obj F-obj-name
     4867         WITH FRAME Dialog-Frame.
     4868      ENABLE B-exit b-quit B-list B-list-obj B-Help T-delete-ok b-add B-chg B-del
     4869         BR-add b-add-2 B-del-2 E-obj BR-del F-obj-name
     4870         WITH FRAME Dialog-Frame.
     4871      VIEW FRAME Dialog-Frame.
     4872      OPEN QUERY BR-add FOR EACH temp-attr where temp-attr.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-attr where del_temp-attr.action = no NO-LOCK.
     4873   END PROCEDURE.
     4874   PROCEDURE init-proc :
     4875      define var attr-type           as character no-undo .
     4876      define var attr-format         as character no-undo .
     4877      define var attr-label          as character no-undo .
     4878      define var attr-value          as character no-undo .
     4879      define var attr-user-can-edit  as logical   no-undo .
     4880      define var attr-output-display as logical   no-undo .
     4881      define var attr-other          as char      no-undo .
     4882      assign
     4883         add-option   = ""
     4884         add-host     = 0
     4885         add-obj-type = "":U
     4886         add-obj-code = 0
     4887         .
     4888      OPEN QUERY BR-add FOR EACH temp-attr where temp-attr.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-attr where del_temp-attr.action = no NO-LOCK.
     4889   END PROCEDURE.
     4890   PROCEDURE MyEnable :
     4891      define variable v-edit-proc-name     as character no-undo .
     4892      define variable v-tooltip-proc-name  as character no-undo .
