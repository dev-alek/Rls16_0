      219   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      220   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      221   def var vl_bin as char no-undo init "".
      222   if vl_int < 0 OR vl_int = ? then return ?.
      223   do while vl_int > 0:
      224     assign
      225     vl_bin = (if vl_int modulo 2 = 0
      226                 then "0":U
      227                 else "1":U) + vl_bin
      228     vl_int = truncate(vl_int / 2,0).
      229   end.
      230   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      231   END FUNCTION.
      232   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      233                                    input vl_binm as character):
      234   DEFINE VARIABLE vl_bin as character no-undo.
      235   DEFINE VARIABLE ii as integer no-undo.
      236   DEFINE VARIABLE ii-len as integer no-undo.
      237   DEFINE VARIABLE ii-lenm as integer no-undo.
      238   DEFINE VARIABLE mchar as character no-undo.
      239   DEFINE VARIABLE ichar as character no-undo.
      240   if vl_binm = ? then return ?.
      241   vl_bin = CIntBinS(vl_int).
      242   if vl_bin = ? then return ?.
      243   assign
      244   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      245   ii-lenm = LENGTH(vl_binm)
      246   ii-len = LENGTH(vl_bin) - ii-lenm
      247   .
      248   if II-LENM > 32 THEN RETURN ?.
      249   DO II = 1 to II-LENm:
      250     assign
      251     mchar = SUBSTR(vl_binm, ii, 1)
      252     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      253     .
      254     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      255     IF ichar <> mchar AND mchar <> "X":U then return no.
      256   END.
      257   return yes.
      258   END FUNCTION.
      259   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      260   define NEW SHARED temp-table temp-attr no-undo
      261   field attr-code like ub.gds-obj-attr.attr-code
      262   field attr-value like ub.gds-obj-attr.attr-value
      263   field host-code as integer
      264   field obj-type as character
      265   field obj-code as integer
      266   field user-can-edit as log
      267   field code as char
      268   field action as logical
      269   field other-inf as character
      270   index pi is  unique primary
      271   attr-code host-code obj-type obj-code ASCENDING
      272   index action
      273   action
      274   .
      275   procedure tempattr-value :
      276    do
      277     on error undo, return error
      278     :
      279       define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      280       define input  parameter p-host-code as integer no-undo .
      281       define input  parameter p-obj-type as character no-undo .
      282       define input  parameter p-obj-code as integer no-undo .
      283       define input  parameter p-mode      as character no-undo .
      284       define output parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
      285       define output parameter p-type     as character no-undo .
      286       define buffer buf_temp-attr for temp-attr .
      287       define variable v-format         as character no-undo .
      288       define variable v-label          as character no-undo .
      289       define variable v-user-can-edit  as logical   no-undo .
      290       define variable v-output-display as logical   no-undo .
      291       define variable v-other          as character no-undo .
      292       define variable v-range          as integer   no-undo .
      293       define variable jj               as integer   no-undo .
      294       define variable v-spr            as logical   no-undo .
      295       define variable v-spr-name       as character no-undo .
      296       define variable v-spr-param      as character no-undo .
      297       define variable v-setted         as logical   no-undo .
      298       case par-subject:
      299         when 'gds-obj-attr':U
      300         then do:
      301           run gdsoattr-name in this-procedure
      302             (input  p-code
      303             ,output p-type
      304             ,output v-format
      305             ,output v-label
      306             ,output v-user-can-edit
      307             ,output v-output-display
      308             ,output v-other
      309             ) no-error .
      310         end.
      311         when 'gds-host-attr':U
      312         then do:
      313           run gdshattr-name in this-procedure
      314             (input  p-code
      315             ,output p-type
      316             ,output v-format
      317             ,output v-label
      318             ,output v-user-can-edit
      319             ,output v-output-display
      320             ,output v-other
      321             ) no-error .
      322         end.
      323         when 'clients-attr':U
      324         then do:
      325           run clntattr-code in this-procedure
      326             (input  p-code
      327             ,output p-type
      328             ,output v-format
      329             ,output v-label
      330             ,output v-user-can-edit
      331             ,output v-output-display
      332             ,output v-other
      333             ) no-error .
      334         end.
      335         when 'goods-attr':U
      336         then do:
      337           run gds-attr-name in this-procedure
      338             (input  p-code
      339             ,output p-type
      340             ,output v-format
      341             ,output v-label
      342             ,output v-user-can-edit
      343             ,output v-output-display
      344             ,output v-other
      345             ) no-error .
      346         end.
      347         otherwise do:
      348           undo, return error .
      349         end.
      350       end case.
      351       if error-status :error
      352       then do:
      353         undo, return error return-value .
      354       end.
      355       if v-user-can-edit
      356       then do:
      357         do jj = 1 to num-entries(v-other, chr(47)):
      358           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "spr":U then do:
      359             assign
      360             v-spr-name = entry(2, entry(jj, v-other, chr(47)), "=":U)
      361             .
      362           end.
      363           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "spr-param":U then do:
      364             assign
      365             v-spr-param = entry(2, entry(jj, v-other, chr(47)), "=":U)
      366             .
      367           end.
      368        end.
      369         if v-spr-name <> "":U then do:
      370           if p-mode = "change":U
      371           then do:
      372             find first buf_temp-attr no-lock where
      373                       buf_temp-attr.attr-code = p-code
      374                   and buf_temp-attr.host-code = p-host-code
      375                   and buf_temp-attr.obj-type = p-obj-type
      376                   and buf_temp-attr.obj-code = p-obj-code
      377               no-error .
      378             if avail buf_temp-attr then do:
      379               assign
      380                 p-value =  buf_temp-attr.attr-value
      381               .
      382             end.
      383             else do:
      384               assign
      385                 p-value = if p-type = 'L':U then "no":U else ""
      386               .
      387             end.
      388           end.
      389           CASE par-subject:
      390             when 'gds-obj-attr':U then do:
      391               if v-spr-param = "":U then do:
      392                 run value (
      393                             v-spr-name)
      394                             in this-procedure (
      395                                                   input 0
      396                                                 ,input parobj-type
      397                                                 ,input parobj-code
      398                                                 ,input-output p-value
      399                                                 ,output v-setted) no-error .
      400               end.
      401               else do:
      402                 run value (
      403                             v-spr-name)
      404                             in this-procedure (
      405                                                   input 0
      406                                                 ,input parobj-type
      407                                                 ,input parobj-code
      408                                                 ,input v-spr-param
      409                                                 ,input-output p-value
      410                                                 ,output v-setted) no-error .
      411               end.
      412               if error-status :error then do:
      413                 undo, return error "Неизвестный справочник для получения значения атрибут товара на объекте" + " " + p-code .
      414               end.
      415             end.
      416             when 'clients-attr':U then do:
      417             if v-spr-param = "":U then do:
      418               run   value ( v-spr-name ) in this-procedure
      419                   (  input 0
      420                     ,input parobj-type
      421                     ,input parobj-code
      422                     ,input-output p-value
      423                     ,output v-setted )
      424                     no-error .
      425             end.
      426             end.
      427             END CASE.
      428           if v-setted = no then do:
      429             return "not-set":U.
      430           end.
      431           assign
      432           v-spr = yes
      433           .
      434         end.
      435       end.
      436       if not v-spr then do:
      437         find first buf_temp-attr no-lock where
      438                   buf_temp-attr.attr-code = p-code
      439               and buf_temp-attr.host-code = p-host-code
      440               and buf_temp-attr.obj-type = p-obj-type
      441               and buf_temp-attr.obj-code = p-obj-code
      442           no-error .
      443         if avail buf_temp-attr then do:
      444           assign
      445             p-value =  buf_temp-attr.attr-value
      446           .
      447         end.
      448         else do:
      449           assign
      450             p-value = if p-type = 'L':U then "no":U else ""
      451           .
      452         end.
      453       end.
      454     end.
      455   end procedure.
      456   procedure tempattr-write :
      457     do
      458     on error undo, return error
      459     :
      460       define input parameter p-add      as logical no-undo .
      461       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      462       define input parameter p-host-code as integer no-undo .
      463       define input parameter p-obj-type as character no-undo .
      464       define input parameter p-obj-code as integer no-undo .
      465       define input parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
      466       define input parameter p-action   like temp-attr.action no-undo .
      467       define buffer buf_temp-attr for temp-attr .
      468       define variable v-type           as character no-undo .
      469       define variable v-format         as character no-undo .
      470       define variable v-label          as character no-undo .
      471       define variable v-user-can-edit  as logical   no-undo .
      472       define variable v-output-display as logical   no-undo .
      473       define variable v-other          as character no-undo .
      474       define variable v-range          as integer   no-undo .
      475       define variable var-region  as character no-undo.
      476       DEFINE VARIABLE v-sel-vals as character no-undo .
      477       DEFINE VARIABLE v-sel-labels as character no-undo .
      478       define variable varhost-code like ub.sysconf.host-code no-undo.
      479       define variable varobj-type like ub.clients.obj-type no-undo.
      480       define variable varobj-code like ub.clients.obj-code no-undo.
      481       define variable choice as integer no-undo .
      482       case par-subject:
      483         when 'gds-obj-attr':U
      484         then do:
      485           run gdsoattr-name in this-procedure
      486             (input  p-code
      487             ,output v-type
      488             ,output v-format
      489             ,output v-label
      490             ,output v-user-can-edit
      491             ,output v-output-display
      492             ,output v-other
      493             ) no-error .
      494         end.
      495         when 'gds-host-attr':U
      496         then do:
      497           run gdshattr-name in this-procedure
      498             (input  p-code
      499             ,output v-type
      500             ,output v-format
      501             ,output v-label
      502             ,output v-user-can-edit
      503             ,output v-output-display
      504             ,output v-other
      505             ) no-error .
      506         end.
      507         when 'clients-attr':U
      508         then do:
      509           run clntattr-code in this-procedure
      510             (input  p-code
      511             ,output v-type
      512             ,output v-format
      513             ,output v-label
      514             ,output v-user-can-edit
      515             ,output v-output-display
      516             ,output v-other
      517             ) no-error .
      518         end.
      519         when 'goods-attr':U
      520         then do:
      521           run gds-attr-name in this-procedure
      522             (input  p-code
      523             ,output v-type
      524             ,output v-format
      525             ,output v-label
      526             ,output v-user-can-edit
      527             ,output v-output-display
      528             ,output v-other
      529             ) no-error .
      530         end.
      531         otherwise do:
      532           undo, return error .
      533         end.
      534       END CASE.
      535       if error-status :error then do:
      536         undo, return error return-value .
      537       end.
      538       if not v-user-can-edit then do:
      539         message
      540         "Запрещено редактировать атрибут" v-label
      541         view-as alert-box error .
      542         undo, return error.
      543       end.
      544       find first buf_temp-attr exclusive-lock where
      545                  buf_temp-attr.attr-code = p-code
      546               and buf_temp-attr.host-code = p-host-code
      547               and buf_temp-attr.obj-type = p-obj-type
      548               and buf_temp-attr.obj-code = p-obj-code no-error .
      549       if not available buf_temp-attr then do:
      550         create buf_temp-attr .
      551         assign
      552           buf_temp-attr.attr-code = p-code
      553           buf_temp-attr.host-code = p-host-code
      554           buf_temp-attr.obj-type = p-obj-type
      555           buf_temp-attr.obj-code = p-obj-code
      556           buf_temp-attr.attr-value = p-value
      557           buf_temp-attr.action = p-action
      558           buf_temp-attr.code = v-label
      559           buf_temp-attr.other-inf = v-other
      560           no-error
      561         .
      562       end.
      563       ELSE
      564       ASSIGN
      565       buf_temp-attr.attr-value = p-value no-error.
      566     end.
      567   end procedure.
      568   procedure tempattr-exist :
      569     do
      570     on error undo, return error
      571     :
      572       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      573       define input parameter p-host-code as integer no-undo .
      574       define input parameter p-obj-type as character no-undo .
      575       define input parameter p-obj-code as integer no-undo .
      576       define output parameter p-exist    as logical no-undo .
      577       define output parameter p-action as logical no-undo .
      578       define buffer buf_temp-attr for temp-attr .
      579       define variable v-type           as character no-undo .
      580       define variable v-format         as character no-undo .
      581       define variable v-label          as character no-undo .
      582       define variable v-user-can-edit  as logical   no-undo .
      583       define variable v-output-display as logical   no-undo .
      584       define variable v-other          as character no-undo .
      585       define variable v-range          as integer   no-undo .
      586       case par-subject:
      587         when 'gds-obj-attr':U then do:
      588           run gdsoattr-name in this-procedure
      589             (input  p-code
      590             ,output v-type
      591             ,output v-format
      592             ,output v-label
      593             ,output v-user-can-edit
      594             ,output v-output-display
      595             ,output v-other
      596             ) no-error .
      597         end.
      598         when 'gds-host-attr':U
      599         then do:
      600           run gdshattr-name in this-procedure
      601             (input  p-code
      602             ,output v-type
      603             ,output v-format
      604             ,output v-label
      605             ,output v-user-can-edit
      606             ,output v-output-display
      607             ,output v-other
      608             ) no-error .
      609         end.
      610         when 'clients-attr':U
      611         then do:
      612           run clntattr-code in this-procedure
      613             (input  p-code
      614             ,output v-type
      615             ,output v-format
      616             ,output v-label
      617             ,output v-user-can-edit
      618             ,output v-output-display
      619             ,output v-other
      620             ) no-error .
