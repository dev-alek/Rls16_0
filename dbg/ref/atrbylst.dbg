     4899         b-add-2:MENU-MOUSE in frame Dialog-Frame = 1
     4900         b-add:POPUP-MENU IN FRAME Dialog-Frame   = MENU MENU-b-add:HANDLE.
     4901      b-add-2:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-add-2:HANDLE.
