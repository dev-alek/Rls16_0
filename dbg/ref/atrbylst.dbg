     4940      run attr-pop-create-items in this-procedure  (
     4941         input par-subject
     4942         ,input v-edit-proc-name
     4943         ,input v-tooltip-proc-name
     4944         ,input 'choose-to-add'
     4945         ,input menu menu-b-add:handle
     4946         ,input v-attr-list-pre-name
     4947         ).
