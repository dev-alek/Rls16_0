     1180   define temp-table userobjs_temp-user-obj no-undo
     1181     field obj-type as character
     1182     field obj-code as integer
     1183     index xpk is primary unique obj-type obj-code
     1184     .
     1185   procedure userobjs_clear :
     1186     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1187     do
     1188     on error undo, return error return-value
     1189     :
     1190       for each buf_userobjs_temp-user-obj
     1191       on error undo, return error return-value
     1192       :
     1193         delete buf_userobjs_temp-user-obj .
     1194       end.
     1195     end.
     1196   end .
     1197   procedure userobjs_object-count :
     1198     define output parameter p-total-count as integer   no-undo .
     1199     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1200     do
     1201     on error undo, return error return-value
     1202     :
     1203       assign
     1204         p-total-count = 0
     1205       .
     1206       for each buf_userobjs_temp-user-obj
     1207       on error undo, return error return-value
     1208       :
     1209         assign
     1210           p-total-count = p-total-count + 1
     1211         .
     1212       end.
     1213     end.
     1214   end.
     1215   procedure userobjs_append :
     1216      define input  parameter p-obj-type as character no-undo .
     1217      define input  parameter p-obj-code as integer   no-undo .
     1218     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1219     do
     1220     on error undo, return error return-value
     1221     :
     1222       find first buf_userobjs_temp-user-obj
     1223         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1224           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1225         no-error .
     1226       if not available buf_userobjs_temp-user-obj
     1227       then do:
     1228         create buf_userobjs_temp-user-obj .
     1229         assign
     1230           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1231           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1232         .
     1233       end.
     1234     end.
     1235   end.
     1236   procedure userobjs_object-exist :
     1237     define output parameter p-object-exist as logical   no-undo .
     1238     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1239     do
     1240     on error undo, return error return-value
     1241     :
     1242       find first buf_userobjs_temp-user-obj
     1243         no-error .
     1244       if not available buf_userobjs_temp-user-obj
     1245       then do:
     1246         assign
     1247           p-object-exist = false
     1248         .
     1249       end.
     1250       else do:
     1251         assign
     1252           p-object-exist = true
     1253         .
     1254       end.
     1255     end.
     1256   end.
     1257   procedure userobjs_transfer :
     1258     define input  parameter p-callback-handle as handle no-undo .
     1259     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1260     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1261     do
     1262     on error undo, return error return-value
     1263     :
     1264       if valid-handle(p-callback-handle) <> true
     1265       then do:
     1266         message
     1267           vss-workfile vss-revision vss-description skip
     1268           "Ошибка задания входных параметров" skip
     1269           "Неизвестный указатель на процедуру" skip
     1270           view-as alert-box error .
     1271         undo, return error return-value .
     1272       end.
     1273       if p-callback-handle :get-signature("userobjs_append") = ""
     1274       then do:
     1275         message
     1276           vss-workfile vss-revision vss-description skip
     1277           "Ошибка задания входных параметров" skip
     1278           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1279                     ,p-callback-handle :file-name
     1280                     ) skip
     1281           view-as alert-box error .
     1282         undo, return error return-value .
     1283       end.
     1284       for each buf_userobjs_temp-user-obj
     1285       on error undo, return error return-value
     1286       :
     1287         run userobjs_append in p-callback-handle
     1288           (input  buf_userobjs_temp-user-obj.obj-type
     1289           ,input  buf_userobjs_temp-user-obj.obj-code
     1290           ) .
     1291       end.
     1292     end.
     1293   end procedure.
     1294   procedure userobjs_select-one :
     1295      define input  parameter parparentproc     as widget-handle no-undo .
     1296      define input  parameter p-db-num          as integer   no-undo .
     1297      define input  parameter p-user-id         as character no-undo .
     1298      define input  parameter p-host-code-obj   as integer   no-undo .
     1299      define input  parameter p-obj-type        as character no-undo .
     1300      define input  parameter p-obj-code        as integer   no-undo .
