      622         when 'goods-attr':U then do:
      623           run gds-attr-name in this-procedure
      624             (input  p-code
      625             ,output v-type
      626             ,output v-format
      627             ,output v-label
      628             ,output v-user-can-edit
      629             ,output v-output-display
      630             ,output v-other
      631             ) no-error .
      632         end.
      633         otherwise do:
      634           undo, return error .
      635         end.
      636       end case.
      637       if error-status :error
      638       then do:
      639         undo, return error return-value .
      640       end.
      641       find first buf_temp-attr no-lock where
      642                  buf_temp-attr.attr-code = p-code
      643               and buf_temp-attr.host-code = p-host-code
      644               and buf_temp-attr.obj-type = p-obj-type
      645               and buf_temp-attr.obj-code = p-obj-code no-error .
      646       if available buf_temp-attr then do:
      647         P-EXIST = YES.
      648         p-action = buf_temp-attr.action.
      649       end.
      650     end.
      651   end procedure.
      652   procedure tempattr-delete :
      653     do
      654     on error undo, return error
      655     :
      656       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      657       define input parameter p-host-code as integer no-undo .
      658       define input parameter p-obj-type as character no-undo .
      659       define input parameter p-obj-code as integer no-undo .
      660       define output parameter p-deleted  as logical no-undo .
      661       define buffer buf_temp-attr for temp-attr .
      662       define variable v-type           as character no-undo .
      663       define variable v-format         as character no-undo .
      664       define variable v-label          as character no-undo .
      665       define variable v-user-can-edit  as logical   no-undo .
      666       define variable v-output-display as logical   no-undo .
      667       define variable v-other          as character no-undo .
      668       define variable v-range          as integer   no-undo .
      669       case par-subject:
      670         when 'gds-obj-attr':U
      671         then do:
      672           run gdsoattr-name in this-procedure
      673             (input  p-code
      674             ,output v-type
      675             ,output v-format
      676             ,output v-label
      677             ,output v-user-can-edit
      678             ,output v-output-display
      679             ,output v-other
      680             ) no-error .
      681         end.
      682         when 'gds-host-attr':U
      683         then do:
      684           run gdshattr-name in this-procedure
      685             (input  p-code
      686             ,output v-type
      687             ,output v-format
      688             ,output v-label
      689             ,output v-user-can-edit
      690             ,output v-output-display
      691             ,output v-other
      692             ) no-error .
      693         end.
      694         when 'clients-attr':U
      695         then do:
      696           run clntattr-code in this-procedure
      697             (input  p-code
      698             ,output v-type
      699             ,output v-format
      700             ,output v-label
      701             ,output v-user-can-edit
      702             ,output v-output-display
      703             ,output v-other
      704             ) no-error .
      705         end.
      706         when 'goods-attr':U
      707         then do:
      708           run gds-attr-name in this-procedure
      709             (input  p-code
      710             ,output v-type
      711             ,output v-format
      712             ,output v-label
      713             ,output v-user-can-edit
      714             ,output v-output-display
      715             ,output v-other
      716             ) no-error .
      717         end.
      718         otherwise do:
      719           undo, return error .
      720         end.
      721       END CASE.
      722       if error-status :error then do:
      723         undo, return error return-value .
      724       end.
      725       find first buf_temp-attr exclusive-lock where
      726                  buf_temp-attr.attr-code = p-code
      727               and buf_temp-attr.host-code = p-host-code
      728               and buf_temp-attr.obj-type = p-obj-type
      729               and buf_temp-attr.obj-code = p-obj-code no-error .
      730       if not available buf_temp-attr then do:
      731         P-DELETED = NO.
      732       end.
      733       ELSE DO:
      734          delete buf_temp-attr.
      735          P-DELETED = YES.
      736       END.
      737     end.
      738   end procedure.
