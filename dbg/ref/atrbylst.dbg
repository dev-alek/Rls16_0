     4497   procedure get-context :
     4498      define output parameter p-db-num as integer          no-undo.
     4499      define output parameter p-user-id as character        no-undo.
     4500      define variable v-login               as character    no-undo.
     4501      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4502      define buffer buf_user-login  for ub.user-login .
     4503      do
     4504      on error undo, return error
     4505      :
     4506            FIND FIRST buf_sys-ctrl no-lock.
     4507            ASSIGN
     4508               v-login = USERID("ub")
     4509               p-db-num = buf_sys-ctrl.db-num
     4510            .
     4511            FIND FIRST buf_user-login
     4512                 WHERE buf_user-login.db-num = p-db-num
     4513                   AND buf_user-login.user-login = v-login
     4514                 no-lock
     4515                 no-error
     4516                 .
     4517            IF AVAILABLE buf_user-login
     4518            THEN DO:
     4519               assign
     4520                  p-user-id = buf_user-login.user-id
     4521               .
     4522            END.
     4523      end.
     4524   end procedure.
     4525       run diasize_init in this-procedure .
     4526   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4527   ON RETURN ANYWHERE
     4528   DO:
     4529   define variable ii as integer no-undo .
     4530   define variable fh as widget-handle no-undo .
     4531   define variable hh as widget-handle no-undo .
     4532   define variable v-next-widget-name as character no-undo .
     4533     if v-tab-order <> '' then do:
     4534       assign
     4535       ii = lookup(self:name, v-tab-order).
     4536       if ii = num-entries(v-tab-order) then do:
     4537           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     4538           return no-apply.
     4539       end.
     4540       if self:type <> "BUTTON" and
     4541         self:type <> "EDITOR"  then do:
     4542         run proc-move-forward in this-procedure .
     4543         return no-apply.
     4544       end.
     4545       if self:type = "BUTTON" then do:
     4546         APPLY "CHOOSE" to self.
     4547       end.
     4548       if self:type = "TOGGLE-BOX" then
     4549       self:BGCOLOR = ?.
     4550       assign
     4551       ii = ii + 1
     4552       v-next-widget-name = entry(ii, v-tab-order)
     4553       no-error .
     4554       if error-status:error then do:
     4555         assign
     4556         ii = 1
     4557         v-next-widget-name = entry( ii, v-tab-order)
     4558         .
     4559       end.
     4560       assign
     4561       fh = frame Dialog-Frame:first-child
     4562       hh = fh:first-child
     4563       .
     4564       do while valid-handle(hh):
     4565         if hh:name = v-next-widget-name then do:
     4566           if hh:sensitive  = yes
     4567           AND hh:visible = yes then do:
     4568             if hh:type = "TOGGLE-BOX":U then do:
     4569               assign
     4570               hh:BGcolor = 1
     4571               .
     4572             end.
     4573             APPLY "ENTRY" to hh.
     4574             return no-apply.
     4575           end.
     4576           else do:
     4577             APPLY "TAB" to hh.
     4578             return no-apply.
     4579           end.
     4580         end.
     4581         hh = hh:next-sibling.
     4582       end.
     4583     end.
     4584   END.
     4585   procedure proc-move-forward :
     4586   define variable ii as integer no-undo .
     4587   define variable fh as widget-handle no-undo .
     4588   define variable hh as widget-handle no-undo .
     4589   define variable v-next-widget-name as character no-undo .
     4590   do
     4591   on error undo, return error
     4592   :
     4593     if v-tab-order <> '' then do:
     4594       if self:type = "TOGGLE-BOX" then
     4595       self:BGCOLOR = ?.
     4596       assign
     4597       ii = lookup(self:name, v-tab-order).
     4598       assign
     4599       ii = ii + 1
     4600       v-next-widget-name = entry(ii, v-tab-order)
     4601       no-error .
     4602       if error-status:error then do:
     4603         assign
     4604         ii = 1
     4605         v-next-widget-name = entry( ii, v-tab-order)
     4606         .
     4607       end.
     4608       assign
     4609       fh = frame Dialog-Frame:first-child
     4610       hh = fh:first-child
     4611       .
     4612       do while valid-handle(hh):
     4613         if hh:name = v-next-widget-name then do:
     4614           if hh:sensitive  = yes
     4615           AND hh:visible = yes then do:
     4616             if hh:type = "TOGGLE-BOX":U then do:
     4617               assign
     4618               hh:BGcolor = 1
     4619               .
     4620             end.
     4621             APPLY "ENTRY" to hh.
     4622             return.
     4623           end.
     4624           else do:
     4625             assign
     4626             ii = ii + 1
     4627             v-next-widget-name = entry(ii, v-tab-order)
     4628             no-error .
     4629             if error-status:error then do:
     4630               assign
     4631               ii = 1
     4632               v-next-widget-name = entry( ii, v-tab-order)
     4633               .
     4634             end.
     4635           end.
     4636         end.
     4637         hh = hh:next-sibling.
     4638       end.
     4639     end.
     4640   end.
     4641   end procedure.
