     2654     define input  parameter p-obj-code like ub.gds-obj-attr.obj-code no-undo .
     2655     define input-output parameter p-value as character no-undo .
     2656     define output parameter p-setted as logical no-undo .
     2657     do
     2658     on error undo, return error
     2659     :
     2660           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-obj-dt-seasons in g#attr-lib
     2661         (input parparentproc
     2662         ,input p-gds-code
     2663         ,input p-obj-type
     2664         ,input p-obj-code
     2665         ,input-output p-value
     2666         ,output p-setted
     2667         ) no-error .
     2668       if error-status :error
     2669       then do:
     2670         undo, return error return-value .
     2671       end.
     2672     end.
     2673   end.
     2674   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2675   define temp-table tt-attr-property  no-undo
     2676   field upper-attr-code as character
     2677   field attr-code as character
     2678   field table-name as character
     2679   field edit-menu-section-num as integer
     2680   field attr-label as character
     2681   field menu-item-handle as widget-handle
     2682   field user-can-edit as logical
     2683   field menu-name as character
     2684   field parent-handle as handle
     2685   index pi is unique primary
     2686   table-name
     2687   menu-name
     2688   upper-attr-code
     2689   attr-code
     2690   index i-section
     2691   edit-menu-section-num
     2692   .
     2693   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2694   procedure attr-pop-create-items :
     2695   define input parameter p-table-name as character no-undo .
     2696   define input parameter p-get-section-num-proc-name as character no-undo .
     2697   define input parameter p-get-attr-label-proc-name as character no-undo .
     2698   define input parameter p-attr-choose-proc-name as character no-undo .
     2699   define input parameter p-menu-handle as widget-handle no-undo .
     2700   define input parameter p-attr-list as character no-undo .
     2701   define variable ii as integer no-undo .
     2702   define variable V-CREATED as logical no-undo .
     2703   define variable v-tool-tip as character no-undo .
     2704   define variable v-dop as character no-undo .
     2705   define variable v-attr-item as character no-undo .
     2706   define variable p-upper-attr-code as character no-undo .
     2707   define buffer buf_tt-attr-property for tt-attr-property.
     2708     do
     2709     on error undo, return error return-value
     2710     :
     2711        do ii = 1 to num-entries (p-attr-list):
     2712          v-attr-item = entry(ii, p-attr-list) .
     2713          find first tt-attr-property where
     2714                    tt-attr-property.table-name = p-table-name
     2715                and tt-attr-property.attr-code = v-attr-item
     2716                and tt-attr-property.upper-attr-code = p-upper-attr-code
     2717                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
     2718          if not available tt-attr-property then do:
     2719            create tt-attr-property.
     2720            assign
     2721            tt-attr-property.table-name = p-table-name
     2722            tt-attr-property.attr-code = v-attr-item
     2723            tt-attr-property.upper-attr-code = p-upper-attr-code
     2724            tt-attr-property.menu-name = p-menu-handle:name
     2725            .
     2726            run value ( p-get-section-num-proc-name) (
     2727                                                      input tt-attr-property.attr-code
     2728                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
     2729            run value ( p-get-attr-label-proc-name ) (
     2730                                           input tt-attr-property.attr-code
     2731                                          ,output v-tool-tip
     2732                                          ,output tt-attr-property.attr-label
     2733                                         ) no-error .
     2734            release tt-attr-property.
     2735          end.
     2736        end.
     2737        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
     2738        break
     2739        by  tt-attr-property.edit-menu-section-num
     2740        by  tt-attr-property.attr-label
     2741        :
     2742          if tt-attr-property.edit-menu-section-num > 0
     2743          then do:
     2744             if not valid-handle(tt-attr-property.menu-item-handle) then do:
     2745               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
     2746               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
     2747               then do:
     2748                 find first buf_tt-attr-property where
     2749                           buf_tt-attr-property.table-name = p-table-name
     2750                       and buf_tt-attr-property.menu-name = p-menu-handle:name
     2751                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
     2752                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
     2753                 if not available buf_tt-attr-property then do:
     2754                   create buf_tt-attr-property.
     2755                   assign
     2756                   buf_tt-attr-property.table-name = p-table-name
     2757                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
     2758                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
     2759                   buf_tt-attr-property.menu-name = p-menu-handle:name
     2760                   .
     2761                   create sub-menu buf_tt-attr-property.menu-item-handle
     2762                   assign
     2763                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
     2764                   parent = p-menu-handle.
     2765                 end.
     2766                 create menu-item tt-attr-property.menu-item-handle
     2767                 assign
     2768                 label = tt-attr-property.attr-label
     2769                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
     2770                 parent = buf_tt-attr-property.menu-item-handle
     2771                 triggers:
     2772                   on choose
     2773                     persistent run value(p-attr-choose-proc-name + "-2") (
     2774                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
     2775                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
     2776                                                                             ) .
     2777                 end triggers.
     2778                 assign
     2779                 v-created = yes.
     2780               end.
     2781               else do:
     2782                 create menu-item tt-attr-property.menu-item-handle
     2783                 assign
     2784                 label = tt-attr-property.attr-label
     2785                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
     2786                 parent = p-menu-handle
     2787                 triggers:
     2788                   on choose
     2789                     persistent run value(p-attr-choose-proc-name) (
     2790                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
     2791                 end triggers.
     2792                 assign
     2793                 v-created = yes.
     2794               end.
     2795             end.
     2796             if last-of(tt-attr-property.edit-menu-section-num)
     2797               then do:
     2798               find first buf_tt-attr-property where
     2799                         buf_tt-attr-property.table-name = p-table-name
     2800                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
     2801                                                            , p-table-name
     2802                                                            , tt-attr-property.edit-menu-section-num
     2803                                                            , p-menu-handle:name
     2804                                                            )
     2805                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
     2806               if not available buf_tt-attr-property then do:
     2807                 create buf_tt-attr-property.
     2808                 assign
     2809                 buf_tt-attr-property.table-name = p-table-name
     2810                 buf_tt-attr-property.edit-menu-section-num =  - 1
     2811                 buf_tt-attr-property.menu-name = p-menu-handle:name
     2812                 buf_tt-attr-property.upper-attr-code = ''
     2813                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
     2814                                                             , p-table-name
     2815                                                             , tt-attr-property.edit-menu-section-num
     2816                                                             , p-menu-handle:name
     2817                                                             )
     2818                 .
     2819                 create menu-item buf_tt-attr-property.menu-item-handle
     2820                 assign
     2821                 subtype = "rule"
     2822                 parent = p-menu-handle
     2823                 .
     2824               end.
     2825             end.
     2826          end.
     2827        end.
     2828        if not v-created then do:
     2829           run attr-pop-clean-up in this-procedure ( input p-table-name).
     2830        end.
     2831     end.
     2832   end procedure.
     2833   procedure attr-pop-clean-up :
     2834   define input parameter p-table-name as character no-undo .
     2835     for each tt-attr-property where
     2836             tt-attr-property.table-name = p-table-name
     2837       and tt-attr-property.edit-menu-section-num > 0:
     2838       if valid-handle ( tt-attr-property.menu-item-handle) then do:
     2839         delete widget tt-attr-property.menu-item-handle.
     2840       end.
     2841       delete tt-attr-property.
     2842     end.
     2843     for each tt-attr-property where
     2844              tt-attr-property.table-name = p-table-name
     2845          and tt-attr-property.edit-menu-section-num =  - 1:
     2846       if valid-handle ( tt-attr-property.menu-item-handle) then do:
     2847         delete widget tt-attr-property.menu-item-handle.
     2848       end.
     2849       delete tt-attr-property.
     2850     end.
     2851   end procedure.
     2852   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2853   def
     2854   NEW shared
     2855   temp-table  obj-list no-undo
     2856     field obj-type like ub.clients.obj-type
     2857     field obj-code like ub.clients.obj-code
     2858     field obj-name like ub.clients.obj-name
     2859     field obj-id   as integer
     2860     field db-num   as integer
     2861     index pi is primary unique obj-id
     2862     index ie1 obj-type obj-code
     2863     index ie2 obj-name
     2864   .
     2865   procedure create_obj-list :
     2866      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2867      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2868      do
     2869      on error undo, return error return-value
     2870      :
     2871         define buffer cli-obj for ub.clients .
     2872         define variable p-var as integer no-undo .
     2873         define buffer buf_obj-list for obj-list .
     2874         find last buf_obj-list  use-index pi no-error .
     2875         if available buf_obj-list
     2876         then
     2877            p-var = buf_obj-list.obj-id + 1.
     2878         else
     2879            p-var = 1.
     2880         find first cli-obj where
     2881                   cli-obj.obj-type = p-obj-type
     2882               and cli-obj.obj-code = p-obj-code
     2883         no-lock no-error.
     2884         if available cli-obj
     2885         then do:
     2886            create buf_obj-list.
     2887            assign
     2888               buf_obj-list.obj-id   = p-var
     2889               buf_obj-list.obj-code = cli-obj.obj-code
     2890               buf_obj-list.obj-type = cli-obj.obj-type
     2891               buf_obj-list.obj-name = cli-obj.obj-name
     2892               buf_obj-list.db-num   = cli-obj.db-num
     2893            .
     2894         end.
     2895      end.
     2896   end.
     2897   define variable add-option   as char    no-undo.
     2898   DEFINE VARIABLE add-host     like ub.sysconf.host-code no-undo .
     2899   DEFINE VARIABLE add-obj-type like ub.clients.obj-type no-undo .
     2900   DEFINE VARIABLE add-obj-code like ub.clients.obj-code no-undo .
     2901   define variable updated      as logical no-undo.
     2902   define variable temp-doc-rec as recid   no-undo.
     2903   define buffer del_temp-attr for temp-attr.
     2904   define variable glog        as logical   no-undo .
     2905   define variable glog-obj    as logical   no-undo .
     2906   define variable v-tab-order AS character no-undo.
     2907   DEFINE MENU menu-b-add.
     2908   DEFINE MENU menu-b-add-2.
     2909   DEFINE BUTTON b-add
     2910      LABEL "&Добавить":L
     2911      SIZE 10 BY 1 TOOLTIP "Выбрать атрибут для добавления".
     2912   DEFINE BUTTON b-add-2
     2913      LABEL "&Добавить":L
     2914      SIZE 10 BY 1 TOOLTIP "Выбрать атрибут для удаления".
     2915   DEFINE BUTTON B-chg
     2916      LABEL "&Изменить"
     2917      SIZE 10 BY 1.
     2918   DEFINE BUTTON B-del
     2919      LABEL "&Удалить"
     2920      SIZE 10 BY 1.
     2921   DEFINE BUTTON B-del-2
     2922      LABEL "&Удалить"
     2923      SIZE 10 BY 1.
     2924   DEFINE BUTTON B-exit
     2925      LABEL "&Ввод"
     2926      SIZE 10 BY 1 TOOLTIP "Установить/изменить/удалить атрибуты по списку"
     2927      BGCOLOR 8 .
     2928   DEFINE BUTTON B-Help
     2929      LABEL "Помо&щь"
     2930      SIZE 3 BY 1
     2931      BGCOLOR 8 .
     2932   DEFINE BUTTON B-list
     2933      LABEL "&Список товаров"
     2934      SIZE 20 BY 1 TOOLTIP "Создание списка".
     2935   DEFINE BUTTON B-list-obj
     2936      LABEL "Список о&бъектов"
     2937      SIZE 20 BY 1 TOOLTIP "Создание списка объектов".
     2938   DEFINE BUTTON b-quit AUTO-END-KEY
     2939      LABEL "&Отмена"
     2940      SIZE 10 BY 1
     2941      BGCOLOR 8 .
     2942   DEFINE VARIABLE E-obj       AS CHARACTER
     2943      VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     2944      SIZE 29 BY 8.13 NO-UNDO.
     2945   DEFINE VARIABLE F-obj-name  AS CHARACTER FORMAT "X(256)":U
     2946      VIEW-AS TEXT
     2947      SIZE 52.5 BY .67
     2948      FGCOLOR 4 NO-UNDO.
     2949   DEFINE VARIABLE T-delete-ok AS LOGICAL   INITIAL no
     2950      LABEL "Удалять записи списка в случае удачного изменения"
     2951      VIEW-AS TOGGLE-BOX
     2952      SIZE 52 BY 1 NO-UNDO.
     2953   DEFINE QUERY BR-add FOR
     2954      temp-attr SCROLLING.
     2955   DEFINE QUERY BR-del FOR
     2956      del_temp-attr SCROLLING.
     2957   DEFINE BROWSE BR-add
     2958      QUERY BR-add DISPLAY
     2959      temp-attr.code column-label "Атрибут"  format "X(50)"
     2960      temp-attr.attr-value column-label "Значение"
     2961       WITH NO-ROW-MARKERS SEPARATORS SIZE 84 BY 8
     2962            TITLE "Будут добавлены/изменены атрибуты".
     2963   DEFINE BROWSE BR-del
     2964      QUERY BR-del DISPLAY
     2965      del_temp-attr.code  column-label "Атрибут" format "X(50)"
     2966       WITH NO-ROW-MARKERS SEPARATORS SIZE 53 BY 8
     2967            TITLE "Будут удалены атрибуты".
     2968   DEFINE FRAME Dialog-Frame
     2969      B-exit AT ROW 1 COL 1
     2970      b-quit AT ROW 1 COL 11
     2971      B-list AT ROW 1 COL 31
     2972      B-list-obj AT ROW 1 COL 51 WIDGET-ID 2
     2973      B-Help AT ROW 1 COL 71
     2974      T-delete-ok AT ROW 3.5 COL 1.5
     2975      b-add AT ROW 4.77 COL 1
     2976      B-chg AT ROW 4.77 COL 11
     2977      B-del AT ROW 4.77 COL 21
     2978      BR-add AT ROW 5.77 COL 1
     2979      b-add-2 AT ROW 14 COL 1
     2980      B-del-2 AT ROW 14 COL 11
     2981      E-obj AT ROW 14.87 COL 55 NO-LABEL WIDGET-ID 4
     2982      BR-del AT ROW 15 COL 1
     2983      F-obj-name AT ROW 2.27 COL 30 COLON-ALIGNED NO-LABEL
     2984      SPACE(0.50) SKIP(20.06)
     2985      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2986      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2987      TITLE "<insert dialog title>"
     2988      DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     2989   ASSIGN
     2990      FRAME Dialog-Frame:SCROLLABLE = FALSE
     2991      FRAME Dialog-Frame:HIDDEN     = TRUE.
     2992   ASSIGN
     2993      E-obj:READ-ONLY IN FRAME Dialog-Frame = TRUE.
     2994   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2995      DO:
     2996         APPLY "END-ERROR":U TO SELF.
     2997      END.
     2998   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     2999      DO:
     3000         run proc-b-add in this-procedure ( input par-subject) no-error .
     3001         if error-status:error then return no-apply.
     3002      END.
     3003   ON CHOOSE OF b-add-2 IN FRAME Dialog-Frame
     3004      DO:
     3005         run proc-b-add-2 in this-procedure ( input par-subject) no-error .
     3006         if error-status:error then return no-apply.
     3007      END.
     3008   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     3009      DO:
     3010         run proc-b-chg in this-procedure ( input "change":U) no-error.
     3011         if error-status:error then return no-apply.
     3012      END.
     3013   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     3014      DO:
     3015         define variable loc#log as logical no-undo.
     3016         if not avail temp-attr then return no-apply.
     3017         loc#log = no.
     3018         message "Вы уверены, что хотите удалить атрибут"  "<" temp-attr.code ">" skip
     3019            "из списка атрибутов подлежащих установке/изменению?"  skip
     3020            view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     3021         if NOT loc#log then return no-apply.
     3022         run tempattr-delete in this-procedure (
     3023            input temp-attr.attr-code
     3024            ,input temp-attr.host-code
     3025            ,input temp-attr.obj-type
     3026            ,input temp-attr.obj-code
     3027            ,output loc#log) no-error .
     3028         if error-status:error or not loc#log then
     3029         do:
     3030            return no-apply.
     3031         end.
     3032         updated = yes.
     3033         run init-proc in this-procedure .
     3034         APPLY "ENTRY" to br-add.
     3035      END.
     3036   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
     3037      DO:
     3038         define variable loc#log as logical no-undo.
     3039         if not avail del_temp-attr then return no-apply.
     3040         loc#log = no.
     3041         message "Вы уверены, что хотите удалить атрибут" "<" del_temp-attr.code ">" skip
     3042            "из списка атрибутов, подлежащих удалению?" skip
     3043            view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     3044         if NOT loc#log then return no-apply.
     3045         run tempattr-delete in this-procedure (
     3046            input del_temp-attr.attr-code
     3047            ,input del_temp-attr.host-code
     3048            ,input del_temp-attr.obj-type
     3049            ,input del_temp-attr.obj-code
     3050            ,output loc#log) no-error .
     3051         if error-status:error or not loc#log then
     3052         do:
     3053            return no-apply.
     3054         end.
     3055         updated = yes.
     3056         run init-proc in this-procedure .
     3057         APPLY "ENTRY" to br-del.
     3058      END.
     3059   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     3060      DO:
     3061         RUN proc-b-exit IN THIS-PROCEDURE NO-ERROR.
     3062         IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     3063      END.
     3064   ON CHOOSE OF B-list IN FRAME Dialog-Frame
     3065      DO:
     3066         CASE par-subject:
     3067            when 'gds-obj-attr':U
     3068            or
     3069            when 'gds-host-attr':U
     3070            or
     3071            when 'goods-attr':U
     3072            then
     3073               do:
     3074                  run str/gds-list.w ( input parparentproc, input parhost-code, input parobj-type, input parobj-code).
     3075                  b-list:label = "&Список товаров".
     3076               end.
     3077            when 'clients-attr':U then
     3078               do:
     3079                  run str/cli-list.w ( input parparentproc, parhost-code, parobj-type, parobj-code).
     3080                  b-list:label = "Список клиентов".
     3081               end.
     3082         END CASE.
     3083      END.
     3084   ON CHOOSE OF B-list-obj IN FRAME Dialog-Frame
     3085      DO:
     3086         DEFINE buffer buf_clients for ub.clients  .
     3087         define buffer buf_sysconf for ub.sysconf  .
     3088         define variable v-list      as character no-undo .
     3089         define variable v-host-code as integer   no-undo .
     3090         define variable v-num       as integer   no-undo .
     3091         define variable ii          as integer   no-undo .
     3092         define variable v-rid       as recid     no-undo .
     3093         define variable v-ii        as integer   no-undo .
     3094         assign t-delete-ok.
     3095         CASE par-subject:
     3096            when 'gds-obj-attr':U THEN
     3097               DO:
     3098                  for each obj-list :
     3099                     delete obj-list.
     3100                  end.
     3101                  if v-cntxt-db-num = 0 then
     3102                  do:
     3103                     run ref/thobjs.w
     3104                        ( input parparentproc
     3105                        , input this-procedure:handle
     3106                        , input "b-mark,b-sel"
     3107                        , input 'все':U
     3108                        , input ''
     3109                        , input ?
     3110                        , input ?
     3111                        , input-output v-list ) no-error .
     3112                  end.
     3113                  else
     3114                  do:
     3115                     run ref/thobjs.w
     3116                        ( input parparentproc
     3117                        , input this-procedure:handle
     3118                        , input "b-mark,b-sel"
     3119                        , input 'все':U
     3120                        , input ''
     3121                        , input v-cntxt-db-num
     3122                        , input ?
     3123                        , input-output v-list ) no-error .
     3124                  end.
     3125                  assign
     3126                     e-obj:screen-value = ''.
     3127                  for each obj-list:
     3128                     delete obj-list.
     3129                  end.
     3130                  define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj.
     3131                  for each buf_userobjs_temp-user-obj:
     3132                     run create_obj-list ( buf_userobjs_temp-user-obj.obj-type, buf_userobjs_temp-user-obj.obj-code) .
     3133                     v-ii = v-ii + 1.
     3134                     e-obj:screen-value in frame Dialog-Frame = e-obj:screen-value in frame Dialog-Frame +
     3135                        (if e-obj:screen-value = '' then '' else chr(10)) +
     3136                        buf_userobjs_temp-user-obj.obj-type + string(buf_userobjs_temp-user-obj.obj-code).
     3137                  end.
     3138               END.
     3139            when 'gds-host-attr':U then
     3140               do:
     3141                  for each obj-list:
     3142                     find first buf_sysconf no-lock where
     3143                        buf_sysconf.host-code = obj-list.obj-code no-error.
     3144                     if available buf_sysconf then
     3145                     do:
     3146                        assign
     3147                           v-list = v-list + (if v-list = '' then '' else chr(44)) +  string(recid(buf_sysconf)).
     3148                     end.
     3149                  end.
     3150                  run adm/sconfs.w (
     3151                     input  parparentproc
     3152                     ,input  'b-sel,b-mark':U
     3153                     ,input  no
     3154                     ,input  v-cntxt-host-code-obj
     3155                     ,output v-host-code
     3156                     ,input-output v-list
     3157                     ) .
     3158                  if v-list = "" then return no-apply .
     3159                  assign
     3160                     v-num = num-entries (v-list) .
     3161                  do ii = 1 to v-num :
     3162                     find first buf_sysconf no-lock where RECID(buf_sysconf) = integer(entry(ii, v-list)) no-error.
     3163                     find first obj-list where
     3164                        obj-list.obj-type = 'орг':U
     3165                        and obj-list.obj-code = buf_sysconf.host-code no-error.
     3166                     if not available obj-list then
     3167                     do:
     3168                        run create_obj-list ( input 'орг':U, input buf_sysconf.host-code) .
     3169                     end.
     3170                  end.
     3171                  assign
     3172                     e-obj:screen-value = ''.
     3173                  for each obj-list:
     3174                     v-ii = v-ii + 1.
     3175                     e-obj:screen-value in frame Dialog-Frame = e-obj:screen-value in frame Dialog-Frame +
     3176                        (if e-obj:screen-value = '' then '' else chr(10)) +
     3177                        obj-list.obj-type + string(obj-list.obj-code).
     3178                  end.
     3179               end.
     3180         END CASE.
     3181         if v-ii > 1 then
     3182         do:
     3183            assign
     3184               t-delete-ok = no.
     3185            display
     3186               t-delete-ok
     3187               with frame Dialog-Frame .
     3188            disable
     3189               t-delete-ok
     3190               with frame Dialog-Frame .
     3191            case par-subject:
     3192               when 'gds-obj-attr':U then
     3193                  do:
     3194                     find first tt-attr-property where
     3195                        tt-attr-property.table-name = 'gds-obj-attr':U
     3196                        and tt-attr-property.attr-code = 'proprietor':U no-error.
     3197                     if available tt-attr-property then
     3198                     do:
     3199                        assign
     3200                           tt-attr-property.menu-item-handle:sensitive = no
     3201                           .
     3202                     end.
     3203                     define buffer buf_temp-attr for temp-attr.
     3204                     for each buf_temp-attr where
     3205                        buf_temp-attr.attr-code = 'proprietor':U :
     3206                        message
     3207                           substitute("Нельзя устанавливать атрибут &1 для списка объектов, если объектов в списке больше 1&1Удаляю..."
     3208                           , buf_temp-attr.code)
     3209                           view-as alert-box error .
     3210                        delete buf_temp-attr.
     3211                     end.
     3212                     OPEN QUERY BR-add FOR EACH temp-attr where temp-attr.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-attr where del_temp-attr.action = no NO-LOCK.
     3213                  end.
     3214            end case.
     3215         end.
     3216         else
     3217         do:
     3218            case par-subject:
     3219               when 'gds-obj-attr':U then
     3220                  do:
     3221                     define variable v-is-tpsi-object as logical no-undo .
     3222                     run gbl/tpsi-obj.p (
     3223                        input parobj-type
     3224                        ,input parobj-code
     3225                        ,output v-is-tpsi-object
     3226                        ) no-error .
     3227                     find first tt-attr-property where
     3228                        tt-attr-property.table-name = 'gds-obj-attr':U
     3229                        and tt-attr-property.attr-code = 'proprietor':U no-error.
     3230                     if available tt-attr-property then
     3231                     do:
     3232                        assign
     3233                           tt-attr-property.menu-item-handle:sensitive = v-is-tpsi-object
     3234                           .
     3235                     end.
     3236                  end.
     3237            end case.
     3238            display
     3239               t-delete-ok
     3240               with frame Dialog-Frame .
     3241            enable
     3242               t-delete-ok
     3243               with frame Dialog-Frame .
     3244         end.
     3245      END.
     3246   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3247      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3248   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3249   on help of frame Dialog-Frame
     3250   do:
     3251     run gbl/app_help.p
     3252       (input this-procedure :file-name
     3253       ,input ''
     3254       ,input ?
     3255       ) no-error.
     3256     if error-status :error then do:
     3257       message
     3258         "Ошибка при вызове помощи"
     3259         error-status :get-message(1)
     3260         view-as alert-box .
     3261     end.
     3262   end.
     3263   run minbtn-set in this-procedure .
     3264   on choose of b-help in frame Dialog-Frame
     3265   do:
     3266     apply "help":u to frame Dialog-Frame .
     3267   end.
     3268   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3269   procedure minbtn-set :
     3270       do
     3271           on error undo, return error return-value
     3272           :
     3273           define variable ii              as integer       no-undo .
     3274           define variable fh              as widget-handle no-undo .
     3275           define variable hh              as widget-handle no-undo .
     3276           define variable v-h             as handle        extent 4 no-undo .
     3277           define variable v-name-button   as character     no-undo .
     3278           define variable v-help-old-x    as decimal       no-undo .
     3279           define variable v-help-old-y    as decimal       no-undo .
     3280           define variable v-help-old-size as decimal       no-undo .
     3281           define variable v-frame-width   as decimal       no-undo .
     3282           define variable jj              as integer       no-undo .
     3283           do
     3284               on error undo, return error
     3285               :
     3286               assign
     3287                   v-frame-width = frame Dialog-Frame:width - 0.3
     3288                   fh            = frame Dialog-Frame:first-child
     3289                   hh            = fh:first-child
     3290                   ii            = 1
     3291                   .
     3292               do while valid-handle(hh):
     3293                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3294                   do:
     3295                       case lc(hh:name) :
     3296                           when "b-help" then
     3297                               do:
     3298                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3299                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3300                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3301                                   hh:TOOLTIP = "Помощь" .
     3302                                   v-help-old-x = hh:column .
     3303                                   v-help-old-y = hh:row    .
     3304                                   v-help-old-size = hh:width .
     3305                                   hh:width-chars = 2.5 .
     3306                               end.
     3307                           when "b-print" then
     3308                               do:
     3309                                   hh:load-image("cmp/b-print.bmp":u) .
     3310                                   hh:TOOLTIP = "Печать" .
     3311                                   v-h[ii] = hh:handle .
     3312                                   ii = ii + 1 .
     3313                                   hh:width-chars = 3 .
     3314                               end.
     3315                           when "b-history" or
     3316                           when "b-hist" then
     3317                               do:
     3318                                   hh:load-image("cmp/b-hist.bmp":u) .
     3319                                   hh:TOOLTIP = "История" .
     3320                                   v-h[ii] = hh:handle .
     3321                                   ii = ii + 1 .
     3322                                   hh:width-chars = 3 .
     3323                               end.
     3324                           when "b-sch" then
     3325                               do:
     3326                                   hh:load-image("cmp/b-sch.bmp":u) .
     3327                                   hh:TOOLTIP = "Установка Фильтра" .
     3328                                   v-h[ii] = hh:handle .
     3329                                   ii = ii + 1 .
     3330                                   hh:width-chars = 3 .
     3331                               end.
     3332                           when "b-hist-user" then
     3333                               do:
     3334                                   hh:load-image("cmp/b-hist.bmp":u) .
     3335                                   hh:TOOLTIP = "История пользователя" .
     3336                                   ii = ii + 1 .
     3337                               end.
     3338                       end case.
     3339                   end.
     3340                   hh = hh:next-sibling.
     3341               end.
     3342               b-help:column = v-frame-width - b-help:width-chars.
     3343               jj = 0.
     3344               repeat ii = 4 to 1 by -1 :
     3345                   if valid-handle (v-h[ii] ) then
     3346                   do:
     3347                       jj  = jj + 1 .
     3348                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3349                       v-h[ii]:row    = v-help-old-y .
     3350                   end.
     3351               end.
     3352           end.
     3353       end.
     3354   end procedure.
     3355   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3356   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3357   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3358   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3359   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3360   define variable v-diasize-current-frame-height as decimal   no-undo .
     3361   define variable v-diasize-change-size          as logical   no-undo .
     3362   define variable v-diasize-resize-button        as handle    no-undo .
     3363   define variable v-diasize-wndmax               as logical   no-undo .
     3364   define variable v-diasize-wndstore             as logical   no-undo .
     3365   define variable v-diasize-proc-name            as character no-undo .
     3366   define variable v-diasize-browse-handle        as handle    no-undo .
     3367   define variable v-diasize-browse-number        as integer   no-undo .
     3368   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3369   define temp-table temp-diasize-handle no-undo
     3370     field handle-value  as handle
     3371     field save-position as decimal
     3372     index xpk is primary unique handle-value
     3373     .
     3374   define temp-table temp-browse-handle no-undo
     3375     field browse-type   as character
     3376     field browse-number as integer
     3377     field browse-handle as handle
     3378     field original-size as decimal
     3379     index xpk is primary unique browse-type browse-number
     3380     index xie browse-type browse-handle
     3381   .
     3382   procedure diasize_change-height :
     3383     define input  parameter p-change-value  as decimal   no-undo .
     3384     define input  parameter p-move-resize   as logical   no-undo .
     3385     define variable v-field-group-handle    as handle    no-undo .
     3386     define variable v-object-handle         as handle    no-undo .
     3387     define variable v-frame-height          as decimal   no-undo .
     3388     define variable v-frame-virtual-height  as decimal   no-undo .
     3389     define variable v-browse-height         as decimal   no-undo .
     3390     define variable v-window-height         as decimal   no-undo .
     3391     define variable v-window-virtual-height as decimal   no-undo .
     3392     define variable v-change-sign           as integer   no-undo .
     3393     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3394     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3395     if p-change-value > 0
     3396     then do:
     3397       if frame Dialog-Frame :height + p-change-value
     3398           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3399       then do:
     3400         assign
     3401           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3402                           - (frame Dialog-Frame :height-chars)
     3403         .
     3404         if p-change-value <= 0
     3405         then do:
     3406           run diasize_position-resize-button in this-procedure .
     3407           return .
     3408         end.
     3409       end.
     3410     end.
     3411     if p-change-value < 0
     3412     then do:
     3413       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3414       then do:
     3415         assign
     3416           p-change-value = v-diasize-orig-frame-height
     3417                          - (frame Dialog-Frame :height-chars)
     3418         .
     3419         if p-change-value >= 0
     3420         then do:
     3421           run diasize_position-resize-button in this-procedure .
     3422           return .
     3423         end.
     3424       end.
     3425     end.
     3426     if p-change-value >= 0
     3427     then do:
     3428       assign
     3429         v-change-sign = 1
     3430       .
     3431     end.
     3432     else do:
     3433       assign
     3434         v-change-sign = -1
     3435       .
     3436     end.
     3437     assign
     3438       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3439     .
     3440     if p-change-value = 0
     3441     then do:
     3442       run diasize_position-resize-button in this-procedure .
     3443       return .
     3444     end.
     3445     move_block:
     3446     do
     3447     on error undo move_block, retry move_block
     3448     :
     3449       if retry
     3450       then do:
     3451         do
     3452         on error undo move_block, leave move_block
     3453         :
     3454           if p-change-value > 0
     3455           then do:
     3456             for each buf_temp-diasize-handle
     3457             on error undo, next
     3458             :
     3459               assign
     3460                 v-object-handle = buf_temp-diasize-handle.handle-value
     3461               .
     3462               if v-object-handle <> v-diasize-resize-button
     3463               then do:
     3464                 assign
     3465                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3466                 .
     3467               end.
     3468             end.
     3469             assign
     3470               v-diasize-browse-handle :height = v-browse-height
     3471             .
     3472             for each buf_temp-browse-handle
     3473               where buf_temp-browse-handle.browse-type = 'height':u
     3474             on error undo, next
     3475             :
     3476               assign
     3477                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3478               .
     3479             end.
     3480             assign
     3481               frame Dialog-Frame :height = v-frame-height
     3482             .
     3483             if frame Dialog-Frame :scrollable = true
     3484             then do:
     3485               assign
     3486                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3487               .
     3488             end.
     3489             run diasize_position-resize-button in this-procedure .
     3490           end.
     3491           else do:
     3492             if frame Dialog-Frame :scrollable = true
     3493             then do:
     3494               assign
     3495                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3496               .
     3497             end.
     3498             assign
     3499               frame Dialog-Frame :height = v-frame-height
     3500             .
     3501             assign
     3502               v-diasize-browse-handle :height = v-browse-height
     3503             .
     3504             for each buf_temp-browse-handle
     3505               where buf_temp-browse-handle.browse-type = 'height':u
     3506             on error undo, next
     3507             :
     3508               assign
     3509                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3510               .
     3511             end.
     3512             for each buf_temp-diasize-handle
     3513             on error undo, next
     3514             :
     3515               assign
     3516                 v-object-handle = buf_temp-diasize-handle.handle-value
     3517               .
     3518               if v-object-handle <> v-diasize-resize-button
     3519               then do:
     3520                 assign
     3521                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3522                 .
     3523               end.
     3524             end.
     3525             run diasize_position-resize-button in this-procedure .
     3526           end.
     3527           assign
     3528             v-diasize-change-size = false
     3529           .
     3530           leave move_block .
     3531         end.
     3532       end.
     3533       assign
     3534         v-diasize-need-full-display = true
     3535       .
     3536       if v-diasize-change-size = false
     3537       then do:
     3538         assign
     3539           v-diasize-change-size = true
     3540         .
     3541       end.
     3542       else do:
     3543         return .
     3544       end.
     3545       assign
     3546         v-frame-height = frame Dialog-Frame :height
     3547         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3548         v-browse-height = v-diasize-browse-handle :height
     3549       .
     3550       for each buf_temp-browse-handle
     3551         where buf_temp-browse-handle.browse-type = 'height':u
     3552       :
     3553         assign
     3554           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3555         .
     3556       end.
     3557       for each buf_temp-diasize-handle
     3558       :
     3559         delete buf_temp-diasize-handle .
     3560       end.
     3561       assign
     3562         v-field-group-handle = frame Dialog-Frame :first-child
     3563       .
     3564       do while valid-handle(v-field-group-handle)
     3565       :
     3566         assign
     3567           v-object-handle = v-field-group-handle :first-child
     3568         .
     3569         do while valid-handle(v-object-handle)
     3570         :
     3571           if  v-object-handle <> v-diasize-browse-handle :handle
     3572           and can-query(v-object-handle, "row")
     3573           and can-query(v-object-handle, "height")
     3574           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3575           then do:
     3576             find first buf_temp-browse-handle
     3577               where buf_temp-browse-handle.browse-type   = 'height':u
     3578                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3579               no-error .
     3580             if available buf_temp-browse-handle
     3581             then do:
     3582             end.
     3583             else do:
     3584               create buf_temp-diasize-handle .
     3585               assign
     3586                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3587                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3588               .
     3589             end.
     3590           end.
     3591           assign
     3592             v-object-handle = v-object-handle :next-sibling
     3593           .
     3594         end.
     3595         assign
     3596           v-field-group-handle = v-field-group-handle :next-sibling
     3597         .
     3598       end.
     3599       do with frame Dialog-Frame
     3600       :
     3601         hide v-diasize-resize-button .
     3602         assign
     3603           v-diasize-resize-button :row    = 1
     3604           v-diasize-resize-button :column = 1
     3605         .
     3606       end.
     3607       if p-change-value > 0
     3608       then do:
     3609         if frame Dialog-Frame :scrollable = true
     3610         then do:
     3611           assign
     3612             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3613             no-error .
     3614           if error-status :error
     3615           or error-status :get-message(1) <> ""
     3616           then do:
     3617             undo move_block, retry move_block .
     3618           end.
     3619         end.
     3620         assign
     3621           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3622           no-error .
     3623         if error-status :error
     3624         or error-status :get-message(1) <> ""
     3625         then do:
     3626           undo move_block, retry move_block .
     3627         end.
     3628         assign
     3629           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3630           no-error .
     3631         if error-status :error
     3632         or error-status :get-message(1) <> ""
     3633         then do:
     3634           undo move_block, retry move_block .
     3635         end.
     3636         for each buf_temp-browse-handle
     3637           where buf_temp-browse-handle.browse-type = 'height':u
     3638         on error undo move_block, retry move_block
     3639         :
     3640           assign
     3641             buf_temp-browse-handle.browse-handle :height
     3642               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3643             no-error .
     3644           if error-status :error
     3645           or error-status :get-message(1) <> ""
     3646           then do:
     3647             undo move_block, retry move_block .
     3648           end.
     3649         end.
     3650         for each buf_temp-diasize-handle
     3651         on error undo move_block, retry move_block
     3652         :
     3653           assign
     3654             v-object-handle = buf_temp-diasize-handle.handle-value
     3655           .
     3656           if v-object-handle <> v-diasize-resize-button
     3657           then do:
     3658             assign
     3659               v-object-handle :row = v-object-handle :row + p-change-value
     3660               no-error .
     3661             if error-status :error
     3662             or error-status :get-message(1) <> ""
     3663             then do:
     3664               undo move_block, retry move_block .
     3665             end.
     3666           end.
     3667         end.
     3668       end.
     3669       else do:
     3670         for each buf_temp-diasize-handle
     3671         on error undo move_block, retry move_block
     3672         :
     3673           assign
     3674             v-object-handle = buf_temp-diasize-handle.handle-value
     3675           .
     3676           if v-object-handle <> v-diasize-resize-button
     3677           then do:
     3678             assign
     3679               v-object-handle :row = v-object-handle :row + p-change-value
     3680               no-error .
     3681             if error-status :error
     3682             or error-status :get-message(1) <> ""
     3683             then do:
     3684               undo move_block, retry move_block .
     3685             end.
     3686           end.
     3687         end.
     3688         assign
     3689           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3690           no-error .
     3691         if error-status :error
     3692         or error-status :get-message(1) <> ""
     3693         then do:
     3694           undo move_block, retry move_block .
     3695         end.
     3696         for each buf_temp-browse-handle
     3697           where buf_temp-browse-handle.browse-type = 'height':u
     3698         on error undo move_block, retry move_block
     3699         :
     3700           assign
     3701             buf_temp-browse-handle.browse-handle :height
     3702               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3703             no-error .
     3704           if error-status :error
     3705           or error-status :get-message(1) <> ""
     3706           then do:
     3707             undo move_block, retry move_block .
     3708           end.
     3709         end.
     3710         assign
     3711           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3712           no-error .
     3713         if error-status :error
     3714         or error-status :get-message(1) <> ""
     3715         then do:
     3716           undo move_block, retry move_block .
     3717         end.
     3718         if frame Dialog-Frame :scrollable = true
     3719         then do:
     3720           assign
     3721             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3722             no-error .
     3723           if error-status :error
     3724           or error-status :get-message(1) <> ""
     3725           then do:
     3726             undo move_block, retry move_block .
     3727           end.
     3728         end.
     3729       end.
     3730       if p-move-resize = true
     3731       then do:
     3732         run diasize_position-resize-button in this-procedure .
     3733       end.
     3734       if v-diasize-wndstore = true
     3735       then do:
     3736         if connected("ub") = true
     3737         then do:
     3738           define variable v-cntxt-db-num        as integer   no-undo .
     3739           define variable v-cntxt-userid        as character no-undo .
     3740           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3741                                             , OUTPUT v-cntxt-userid
     3742                                             ) .
     3743           run gbl/wndsizew.p
     3744             (input  v-cntxt-db-num
     3745             ,input  v-cntxt-userid
     3746             ,input  v-diasize-proc-name
     3747             ,input  'height':u
     3748             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3749             ) .
     3750         end.
     3751       end.
     3752     end.
     3753     assign
     3754       v-diasize-change-size = false
     3755     .
     3756   end procedure.
     3757   procedure diasize_set-height :
     3758     define input  parameter p-new-height  as decimal   no-undo .
     3759     define input  parameter p-move-resize as logical   no-undo .
     3760     do
     3761     on error undo, return error return-value
     3762     :
     3763       run diasize_change-height in this-procedure
     3764         (input  (p-new-height - frame Dialog-Frame :height)
     3765         ,input  p-move-resize
     3766         ) .
     3767     end.
     3768   end procedure.
     3769   procedure diasize_change-width :
     3770     define input  parameter p-change-value as decimal   no-undo .
     3771     define input  parameter p-move-resize  as logical   no-undo .
     3772     define variable v-field-group-handle   as handle    no-undo .
     3773     define variable v-object-handle        as handle    no-undo .
     3774     define variable v-frame-width          as decimal   no-undo .
     3775     define variable v-frame-virtual-width  as decimal   no-undo .
     3776     define variable v-browse-width         as decimal   no-undo .
     3777     define variable v-window-width         as decimal   no-undo .
     3778     define variable v-window-virtual-width as decimal   no-undo .
     3779     define variable v-change-sign          as integer   no-undo .
     3780     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3781     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3782     if p-change-value > 0
     3783     then do:
     3784       if frame Dialog-Frame :width + p-change-value >
     3785           session :width-chars
     3786       then do:
     3787         assign
     3788           p-change-value = session :width-chars - frame Dialog-Frame :width
     3789         .
     3790         if p-change-value <= 0
     3791         then do:
     3792           run diasize_position-resize-button in this-procedure .
     3793           return .
     3794         end.
     3795       end.
     3796     end.
     3797     if p-change-value < 0
     3798     then do:
     3799       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3800       then do:
     3801         assign
     3802           p-change-value = v-diasize-orig-frame-width
     3803                          - frame Dialog-Frame :width
     3804         .
     3805         if p-change-value >= 0
     3806         then do:
     3807           run diasize_position-resize-button in this-procedure .
     3808           return .
     3809         end.
     3810       end.
     3811     end.
     3812     if p-change-value >= 0
     3813     then do:
     3814       assign
     3815         v-change-sign = 1
     3816       .
     3817     end.
     3818     else do:
     3819       assign
     3820         v-change-sign = -1
     3821       .
     3822     end.
     3823     assign
     3824       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3825     .
     3826     if p-change-value = 0
     3827     then do:
     3828       run diasize_position-resize-button in this-procedure .
     3829       return .
     3830     end.
     3831     move_block:
     3832     do
     3833     on error undo move_block, leave move_block
     3834     :
     3835       if retry
     3836       then do:
     3837         do
     3838         on error undo move_block, leave move_block
     3839         :
     3840           if p-change-value > 0
     3841           then do:
     3842             for each buf_temp-diasize-handle
     3843             on error undo, next
     3844             :
     3845               assign
     3846                 v-object-handle = buf_temp-diasize-handle.handle-value
     3847               .
     3848               if v-object-handle <> v-diasize-resize-button
     3849               then do:
     3850                 assign
     3851                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3852                 .
     3853               end.
     3854             end.
     3855             assign
     3856               v-diasize-browse-handle :width = v-browse-width
     3857             .
     3858             for each buf_temp-browse-handle
     3859               where buf_temp-browse-handle.browse-type = 'width':u
     3860             on error undo, next
     3861             :
     3862               assign
     3863                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3864               .
     3865             end.
     3866             assign
     3867               frame Dialog-Frame :width = v-frame-width
     3868             .
     3869             if frame Dialog-Frame :scrollable = true
     3870             then do:
     3871               assign
     3872                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3873               .
     3874             end.
     3875             run diasize_position-resize-button in this-procedure .
     3876           end.
     3877           else do:
     3878             if frame Dialog-Frame :scrollable = true
     3879             then do:
     3880               assign
     3881                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3882               .
     3883             end.
     3884             assign
     3885               frame Dialog-Frame :width = v-frame-width
     3886             .
     3887             for each buf_temp-browse-handle
     3888               where buf_temp-browse-handle.browse-type = 'width':u
     3889             on error undo, next
     3890             :
     3891               assign
     3892                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3893               .
     3894             end.
     3895             assign
     3896               v-diasize-browse-handle :width = v-browse-width
     3897             .
     3898             for each buf_temp-diasize-handle
     3899             on error undo, next
     3900             :
     3901               assign
     3902                 v-object-handle = buf_temp-diasize-handle.handle-value
     3903               .
     3904               if v-object-handle <> v-diasize-resize-button
     3905               then do:
     3906                 assign
     3907                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3908                 .
     3909               end.
     3910             end.
     3911             run diasize_position-resize-button in this-procedure .
     3912           end.
     3913           assign
     3914             v-diasize-change-size = false
     3915           .
     3916           leave move_block .
     3917         end.
     3918       end.
     3919       assign
     3920         v-diasize-need-full-display = true
     3921       .
     3922       if v-diasize-change-size = false
     3923       then do:
     3924         assign
     3925           v-diasize-change-size = true
     3926         .
     3927       end.
     3928       else do:
     3929         return .
     3930       end.
     3931       assign
     3932         v-frame-width = frame Dialog-Frame :width
     3933         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3934         v-browse-width = v-diasize-browse-handle :width
     3935       .
     3936       for each buf_temp-browse-handle
     3937         where buf_temp-browse-handle.browse-type = 'width':u
     3938       :
     3939         assign
     3940           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3941         .
     3942       end.
     3943       for each buf_temp-diasize-handle
     3944       :
     3945         delete buf_temp-diasize-handle .
     3946       end.
     3947       assign
     3948         v-field-group-handle = frame Dialog-Frame :first-child
     3949       .
     3950       do while valid-handle(v-field-group-handle)
     3951       :
     3952         assign
     3953           v-object-handle = v-field-group-handle :first-child
     3954         .
     3955         do while valid-handle(v-object-handle)
     3956         :
     3957           if  v-object-handle <> v-diasize-browse-handle :handle
     3958           and v-object-handle <> v-diasize-resize-button
     3959           and can-query(v-object-handle, "row")
     3960           and can-query(v-object-handle, "height")
     3961           and ( v-object-handle :col + v-object-handle :width
     3962                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3963               )
     3964           then do:
     3965             find first buf_temp-browse-handle
     3966               where buf_temp-browse-handle.browse-type   = 'width':u
     3967                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3968               no-error .
     3969             if available buf_temp-browse-handle
     3970             then do:
     3971             end.
     3972             else do:
     3973               create buf_temp-diasize-handle .
     3974               assign
     3975                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3976                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3977               .
     3978             end.
     3979           end.
     3980           assign
     3981             v-object-handle = v-object-handle :next-sibling
     3982           .
     3983         end.
     3984         assign
     3985           v-field-group-handle = v-field-group-handle :next-sibling
     3986         .
     3987       end.
     3988       do with frame Dialog-Frame
     3989       :
     3990         hide v-diasize-resize-button .
     3991         v-diasize-resize-button :row = 1.
     3992         v-diasize-resize-button :column = 1.
     3993       end.
     3994       if p-change-value > 0
     3995       then do:
     3996         if frame Dialog-Frame :scrollable = true
     3997         then do:
     3998           assign
     3999             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4000             no-error .
     4001           if error-status :error
     4002           or error-status :get-message(1) <> ""
     4003           then do:
     4004             undo move_block, retry move_block.
     4005           end.
     4006         end.
     4007         assign
     4008           frame Dialog-Frame :width = v-frame-width + p-change-value
     4009           no-error .
     4010         if error-status :error
     4011         or error-status :get-message(1) <> ""
     4012         then do:
     4013           undo move_block, retry move_block.
     4014         end.
     4015         assign
     4016           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4017         no-error .
     4018         if error-status :error
     4019         or error-status :get-message(1) <> ""
     4020         then do:
     4021           undo move_block, retry move_block.
     4022         end.
     4023         for each buf_temp-browse-handle
     4024           where buf_temp-browse-handle.browse-type = 'width':u
     4025         on error undo move_block, retry move_block
     4026         :
     4027           assign
     4028             buf_temp-browse-handle.browse-handle :width
     4029               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4030             no-error .
     4031           if error-status :error
     4032           or error-status :get-message(1) <> ""
     4033           then do:
     4034             undo move_block, retry move_block .
     4035           end.
     4036         end.
     4037         for each buf_temp-diasize-handle
     4038         on error undo move_block, retry move_block
     4039         :
     4040           assign
     4041             v-object-handle = buf_temp-diasize-handle.handle-value
     4042           .
     4043           if v-object-handle <> v-diasize-resize-button
     4044           then do:
     4045             assign
     4046               v-object-handle :col = v-object-handle :col + p-change-value
     4047               no-error .
     4048             if error-status :error
     4049             or error-status :get-message(1) <> ""
     4050             then do:
     4051               undo move_block, retry move_block .
     4052             end.
     4053           end.
     4054         end.
     4055       end.
     4056       else do:
     4057         for each buf_temp-diasize-handle
     4058         on error undo move_block, retry move_block
     4059         :
     4060           assign
     4061             v-object-handle = buf_temp-diasize-handle.handle-value
     4062           .
     4063           if v-object-handle <> v-diasize-resize-button
     4064           then do:
     4065             assign
     4066               v-object-handle :col = v-object-handle :col + p-change-value
     4067               no-error .
     4068             if error-status :error
     4069             or error-status :get-message(1) <> ""
     4070             then do:
     4071               undo move_block, retry move_block .
     4072             end.
     4073           end.
     4074         end.
     4075         for each buf_temp-browse-handle
     4076           where buf_temp-browse-handle.browse-type = 'width':u
     4077         on error undo move_block, retry move_block
     4078         :
     4079           assign
     4080             buf_temp-browse-handle.browse-handle :width
     4081               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4082             no-error .
     4083           if error-status :error
     4084           or error-status :get-message(1) <> ""
     4085           then do:
     4086             undo move_block, retry move_block .
     4087           end.
     4088         end.
     4089         assign
     4090           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4091           no-error .
     4092         if error-status :error
     4093         or error-status :get-message(1) <> ""
     4094         then do:
     4095           undo move_block, retry move_block.
     4096         end.
     4097         assign
     4098           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4099         no-error .
     4100         if error-status :error
     4101         or error-status :get-message(1) <> ""
     4102         then do:
     4103           undo move_block, retry move_block.
     4104         end.
     4105         if frame Dialog-Frame :scrollable = true
     4106         then do:
     4107           assign
     4108             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4109           no-error .
     4110           if error-status :error
     4111           or error-status :get-message(1) <> ""
     4112           then do:
     4113             undo move_block, retry move_block.
     4114           end.
     4115         end.
     4116       end.
     4117       if p-move-resize
     4118       then do:
     4119         run diasize_position-resize-button in this-procedure .
     4120       end.
     4121       if v-diasize-wndstore = true
     4122       then do:
     4123         if connected("ub") = true
     4124         then do:
     4125           define variable v-cntxt-db-num        as integer   no-undo .
     4126           define variable v-cntxt-userid        as character no-undo .
     4127           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4128                                             , OUTPUT v-cntxt-userid
     4129                                             ) .
     4130           run gbl/wndsizew.p
     4131             (input  v-cntxt-db-num
     4132             ,input  v-cntxt-userid
     4133             ,input  v-diasize-proc-name
     4134             ,input  'width':u
     4135             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4136             ) .
     4137         end.
     4138       end.
     4139     end.
     4140     assign
     4141       v-diasize-change-size = false
     4142     .
     4143   end procedure.
     4144   procedure diasize_set-width :
     4145     define input  parameter p-new-width  as decimal   no-undo .
     4146     define input  parameter p-move-resize as logical   no-undo .
     4147     do
     4148     on error undo, return error return-value
     4149     :
     4150       run diasize_change-width in this-procedure
     4151         (input  (p-new-width - frame Dialog-Frame :width)
     4152         ,input  p-move-resize
     4153         ) .
     4154     end.
     4155   end procedure.
     4156   procedure diasize_position-resize-button :
     4157     do with frame Dialog-Frame
     4158     :
     4159       hide v-diasize-resize-button .
     4160       assign
     4161         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4162                     - 1
     4163                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4164         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4165                     - 1
     4166                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4167       .
     4168       view v-diasize-resize-button .
     4169     end.
     4170   end procedure.
     4171   on alt-right anywhere
     4172   do:
     4173     run diasize_change-width in this-procedure
     4174       (input 1
     4175       ,input true
     4176       ) .
     4177     return no-apply .
     4178   end.
     4179   on alt-left anywhere
     4180   do:
     4181     run diasize_change-width in this-procedure
     4182       (input -1
     4183       ,input true
     4184       ) .
     4185     return no-apply .
     4186   end.
     4187   on alt-down anywhere
     4188   do:
     4189     run diasize_change-height in this-procedure
     4190       (input 1
     4191       ,input true
     4192       ) .
     4193     return no-apply .
     4194   end.
     4195   on alt-up anywhere
     4196   do:
     4197     run diasize_change-height in this-procedure
     4198       (input -1
     4199       ,input true
     4200       ) .
     4201     return no-apply .
     4202   end.
     4203   on alt-enter of frame Dialog-Frame
     4204   do:
     4205     run diasize_maximize in this-procedure
     4206       (input  ?
     4207       ).
     4208     return no-apply .
     4209   end.
     4210   procedure diasize_end-move :
     4211     do
     4212     on error undo, return error return-value
     4213     :
     4214       define variable v-row-delta as decimal   no-undo .
     4215       define variable v-col-delta as decimal   no-undo .
     4216       define variable v-new-row as decimal   no-undo .
     4217       define variable v-new-col as decimal   no-undo .
     4218       assign
     4219         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4220         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4221       .
     4222       assign
     4223         v-row-delta = v-new-row - frame Dialog-Frame :height
     4224         v-col-delta = v-new-col - frame Dialog-Frame :width
     4225       .
     4226       run diasize_change-height in this-procedure
     4227         (input v-row-delta
     4228         ,input true
     4229         ) .
     4230       run diasize_change-width in this-procedure
     4231         (input v-col-delta
     4232         ,input true
     4233         ) .
     4234     end.
     4235   end procedure.
     4236   procedure diasize_maximize :
     4237     define input  parameter p-action as logical   no-undo .
     4238     do
     4239     on error undo, return error return-value
     4240     :
     4241       if p-action = ?
     4242       then do:
     4243         if v-diasize-need-maximize = true
     4244         then do:
     4245           assign
     4246             p-action = true
     4247           .
     4248         end.
     4249         else do:
     4250           assign
     4251             p-action = false
     4252           .
     4253         end.
     4254       end.
     4255       if p-action = true
     4256       then do:
     4257         run diasize_change-height in this-procedure
     4258           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4259               - frame Dialog-Frame :height-chars
     4260           ,input true
     4261           ) .
     4262         run diasize_change-width in this-procedure
     4263           (input session :width-chars
     4264               - frame Dialog-Frame :width-chars
     4265           ,input true
     4266           ) .
     4267         assign
     4268           v-diasize-need-maximize = false
     4269         .
     4270       end.
     4271       else do:
     4272         run diasize_change-width in this-procedure
     4273           (input v-diasize-orig-frame-width
     4274               - frame Dialog-Frame :width-chars
     4275           ,input true
     4276           ) .
     4277         run diasize_change-height in this-procedure
     4278           (input v-diasize-orig-frame-height
     4279               - frame Dialog-Frame :height-chars
     4280           ,input true
     4281           ) .
     4282         assign
     4283           v-diasize-need-maximize = true
     4284         .
     4285       end.
     4286     end.
     4287   end procedure.
     4288   procedure diasize_restore-orig-size :
     4289     do
     4290     on error undo, return error return-value
     4291     :
     4292       assign
     4293         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4294         v-diasize-current-frame-height = frame Dialog-Frame :height
     4295       .
     4296       run diasize_set-height in this-procedure
     4297         (input  v-diasize-orig-frame-height
     4298         ,input  true
     4299         ) .
     4300       run diasize_set-width in this-procedure
     4301         (input  v-diasize-orig-frame-width
     4302         ,input  true
     4303         ) .
     4304     end.
     4305   end procedure.
     4306   procedure diasize_restore-current-size :
     4307     do
     4308     on error undo, return error return-value
     4309     :
     4310       run diasize_set-height in this-procedure
     4311         (input  v-diasize-current-frame-height
     4312         ,input  true
     4313         ) .
     4314       run diasize_set-width in this-procedure
     4315         (input  v-diasize-current-frame-width
     4316         ,input  true
     4317         ) .
     4318     end.
     4319   end procedure.
     4320   procedure diasize_set-browse-handle :
     4321     define input  parameter p-browse-handle as handle   no-undo .
     4322     define buffer buf_temp-browse-handle for temp-browse-handle .
     4323     do
     4324     on error undo, return error return-value
     4325     :
     4326       assign
     4327         v-diasize-browse-handle = p-browse-handle
     4328       .
     4329       for each buf_temp-browse-handle
     4330       on error undo, return error return-value
     4331       :
     4332         delete buf_temp-browse-handle .
     4333       end.
     4334     end.
     4335   end procedure.
     4336   procedure diasize_add_browse :
     4337     define input  parameter p-browse-type   as character no-undo .
     4338     define input  parameter p-browse-handle as handle    no-undo .
     4339     define buffer buf_temp-browse-handle for temp-browse-handle .
     4340     do
     4341     on error undo, return error return-value
     4342     :
     4343       assign
     4344         v-diasize-browse-number = v-diasize-browse-number + 1
     4345       .
     4346       create buf_temp-browse-handle .
     4347       assign
     4348         buf_temp-browse-handle.browse-type   = p-browse-type
     4349         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4350         buf_temp-browse-handle.browse-handle = p-browse-handle
     4351       .
     4352     end.
     4353   end procedure.
     4354   procedure diasize_init :
     4355     define variable v-default-value    as logical   no-undo .
     4356     define variable v-restore-saved    as logical   no-undo .
     4357     define variable v-resize-value-str as character no-undo .
     4358     do
     4359     on error undo, return error return-value
     4360     :
     4361       do with frame Dialog-Frame
     4362       :
     4363         assign
     4364           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4365           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4366           v-diasize-browse-handle     = browse BR-add :handle
     4367         .
     4368         create button v-diasize-resize-button
     4369         assign
     4370           parent        = frame Dialog-Frame :first-child
     4371           label         = "s"
     4372           height-pixels = 16
     4373           width-pixels  = 16
     4374           visible       = true
     4375           sensitive     = true
     4376           movable       = true
     4377           triggers:
     4378             on end-move persistent run diasize_end-move in this-procedure .
     4379           end triggers.
     4380         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4381         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4382         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4383         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4384         assign
     4385           v-diasize-wndmax = false
     4386         .
     4387         if connected("ub") = true
     4388         then do:
     4389           define variable v-cntxt-db-num        as integer   no-undo .
     4390           define variable v-cntxt-userid        as character no-undo .
     4391           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4392                                             , OUTPUT v-cntxt-userid
     4393                                             ) .
     4394           run gbl/wndpar_r.p
     4395             (input  v-cntxt-db-num
     4396             ,input  v-cntxt-userid
     4397             ,input  'wndmax':U
     4398             ,output v-diasize-wndmax
     4399             ,output v-default-value
     4400             ) .
     4401         end.
     4402         assign
     4403           v-diasize-wndstore = false
     4404         .
     4405         if connected("ub") = true
     4406         then do:
     4407           run gbl/wndpar_r.p
     4408             (input  v-cntxt-db-num
     4409             ,input  v-cntxt-userid
     4410             ,input  'wndstore':U
     4411             ,output v-diasize-wndstore
     4412             ,output v-default-value
     4413             ) .
     4414         end.
     4415         assign
     4416           v-diasize-proc-name = entry(1, program-name(2), '.')
     4417         .
     4418         if v-diasize-wndstore = true
     4419         then do:
     4420           assign
     4421             v-restore-saved = false
     4422           .
     4423           if connected("ub") = true
     4424           then do:
     4425             run gbl/wndsizer.p
     4426               (input  v-cntxt-db-num
     4427               ,input  v-cntxt-userid
     4428               ,input  v-diasize-proc-name
     4429               ,input  'height':u
     4430               ,output v-resize-value-str
     4431               ) .
     4432             if v-resize-value-str <> '':U
     4433             then do:
     4434               run diasize_change-height in this-procedure
     4435                 (input  integer(v-resize-value-str)
     4436                 ,input  true
     4437                 ) .
     4438               assign
     4439                 v-restore-saved = true
     4440               .
     4441             end.
     4442           end.
     4443           if connected("ub") = true
     4444           then do:
     4445             run gbl/wndsizer.p
     4446               (input  v-cntxt-db-num
     4447               ,input  v-cntxt-userid
     4448               ,input  v-diasize-proc-name
     4449               ,input  'width':u
     4450               ,output v-resize-value-str
     4451               ) .
     4452             if v-resize-value-str <> '':U
     4453             then do:
     4454               run diasize_change-width in this-procedure
     4455                 (input  integer(v-resize-value-str)
     4456                 ,input  true
     4457                 ) .
     4458               assign
     4459                 v-restore-saved = true
     4460               .
     4461             end.
     4462           end.
     4463           if v-restore-saved <> true
     4464           then do:
     4465             if v-diasize-wndmax = true
     4466             then do:
     4467               run diasize_maximize in this-procedure
     4468                 (input  true
     4469                 ) .
     4470             end.
     4471           end.
     4472         end.
     4473         else do:
     4474           if v-diasize-wndmax = true
     4475           then do:
     4476             run diasize_maximize in this-procedure
     4477               (input  true
     4478               ) .
     4479           end.
     4480         end.
     4481       end.
     4482     end.
     4483   end procedure.
     4484   procedure diasize_need-full-display :
     4485     define output parameter p-need-full-display as logical   no-undo .
     4486     do
     4487     on error undo, return error return-value
     4488     :
