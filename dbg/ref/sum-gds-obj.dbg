        1   define input parameter parParentProc  as widget-handle no-undo.
        2   define input parameter p-attr-code  like ub.gds-obj-attr.attr-code    no-undo.
        3   define input parameter p-attr-value like ub.gds-obj-attr.attr-value   no-undo.
        4   define input parameter p-host-code  like ub.dis-grp-rule.host-code  no-undo .
        5   define input parameter p-obj-type   like ub.dis-grp-rule.obj-type   no-undo.
        6   define input parameter p-obj-code   like ub.dis-grp-rule.obj-code   no-undo.
        7   define input parameter p-name       like ub.sum-group.name          no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Привязка товаров к группам товаров на кассе объектные".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
