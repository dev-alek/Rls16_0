      492   procedure gds-attr_check-code-dt-seasons :
      493     define input  parameter p-code     like ub.goods.gds-code   no-undo .
      494     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
      495     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
      496     define output parameter p-gds-code like ub.goods.gds-code   no-undo .
