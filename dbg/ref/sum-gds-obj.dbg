      514   define variable rid-list    as  character no-undo .
      515   define variable log-res     as log no-undo.
      516   define variable rr          as recid no-undo.
      517   define variable v-log       as logical   no-undo .
      518   define variable line-mode   as character no-undo .
      519   define variable doc-rec     as recid no-undo .
      520   define variable gds-rec     as recid no-undo .
      521   define variable lns-cnt     as integer   no-undo .
      522   define variable g#log       as logical   no-undo .
      523   define variable varschartic like ub.price-list.artic initial " " no-undo.
      524   define variable ref-list    as character                     no-undo.
      525   define variable sch-field   as character no-undo.
      526   define variable sort-column-name as character no-undo .
      527   define variable list-option as character no-undo.
      528   define variable v-del       as logical no-undo .
      529   define variable v-rid-list  as character no-undo COLUMN-LABEL "*" .
      530   define stream sout.
      531   define temp-table tt-gds-list no-undo like ub.goods
      532   field nn as integer
      533   index by-nn nn
      534   index by_gds-code gds-code
      535   .
      536   define temp-table temp-goods no-undo
      537     field gds-code as integer
      538     index xpk is primary unique gds-code
      539     .
      540   define buffer buf_gds-obj-attr          for ub.gds-obj-attr.
      541   define buffer buf_goods               for ub.goods.
      542   define buffer buf_sum-group-attr      for ub.sum-group-attr.
      543   FUNCTION mark-string RETURNS CHARACTER
      544     ( p-gds-code as integer)  FORWARD.
      545   DEFINE BUTTON b-add
      546        LABEL "&Добавить":L
      547        SIZE 10 BY 1.
      548   DEFINE BUTTON b-del
      549        LABEL "&Удалить":L
      550        SIZE 10 BY 1.
      551   DEFINE BUTTON b-exit AUTO-GO
      552        LABEL "&Выход ":L
      553        SIZE 10 BY 1.
      554   DEFINE BUTTON b-help
      555        LABEL "Помо&щь":L
      556        SIZE 10 BY 1.
      557   DEFINE BUTTON b-mark
      558        LABEL "&*":L
      559        SIZE 3 BY 1.
      560   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>9":U INITIAL 0
      561        VIEW-AS FILL-IN
      562        SIZE 6 BY 1 NO-UNDO.
      563   DEFINE BUTTON b-print
      564        LABEL "Пе&чать":L
      565        SIZE 10 BY 1.
      566   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск по"
      567         VIEW-AS TEXT
      568        SIZE 8.88 BY .67 NO-UNDO.
      569   DEFINE VARIABLE s-artic AS CHARACTER FORMAT "X(256)":U
      570        VIEW-AS FILL-IN
      571        SIZE 29.88 BY 1 NO-UNDO.
      572   DEFINE VARIABLE s-code AS CHARACTER FORMAT "X(256)":U
      573        VIEW-AS FILL-IN
      574        SIZE 29.88 BY 1 NO-UNDO.
      575   DEFINE VARIABLE s-name AS CHARACTER FORMAT "X(256)":U
      576        VIEW-AS FILL-IN
      577        SIZE 29.88 BY 1 NO-UNDO.
      578   DEFINE VARIABLE s-name-cnt AS CHARACTER FORMAT "X(256)":U
      579        LABEL ""
      580        VIEW-AS FILL-IN
      581        SIZE 29.88 BY 1 NO-UNDO.
      582   DEFINE VARIABLE r-sort AS INTEGER
      583        VIEW-AS RADIO-SET HORIZONTAL
      584        RADIO-BUTTONS
      585             "Код", 1,
      586   "Артикул", 2,
      587   "Нач.назв", 3
      588        SIZE 38.75 BY .96 TOOLTIP "Поиск по" NO-UNDO.
      589   DEFINE QUERY BROWSE-2 FOR
      590         gds-obj-attr,
      591         goods SCROLLING.
      592   DEFINE BROWSE BROWSE-2
      593     QUERY BROWSE-2 NO-LOCK DISPLAY
      594         mark-string(goods.gds-code) @ v-rid-list FORMAT "X(3)":U
      595         goods.artic FORMAT "X(16)":U
      596         goods.gds-name FORMAT "X(46)":U
      597         goods.gds-code FORMAT "999999999":U
      598       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.5 BY 18.92
      599            BGCOLOR 15 .
      600   DEFINE FRAME Dialog-Frame
      601        b-exit AT ROW 1 COL 1
      602        b-mark AT ROW 1 COL 11 WIDGET-ID 16
      603        b-add AT ROW 1 COL 14.13
      604        b-del AT ROW 1 COL 24.13
      605        b-print AT ROW 1 COL 60.75
      606        b-help AT ROW 1 COL 70.75
      607        r-sort AT ROW 2.04 COL 10.75 NO-LABEL WIDGET-ID 4
      608        s-artic AT ROW 2.04 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 10
      609        s-name AT ROW 2.04 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 8
      610        s-name-cnt AT ROW 2.04 COL 49 COLON-ALIGNED WIDGET-ID 12
      611        s-code AT ROW 2.04 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      612        BROWSE-2 AT ROW 3.21 COL 1.5
      613        FILL-IN-2 AT ROW 2.21 COL 1 NO-LABEL WIDGET-ID 2
      614        SPACE(72.11) SKIP(20.61)
      615       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      616            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      617            TITLE "Товары ".
      618   ASSIGN
      619          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      620          FRAME Dialog-Frame:HIDDEN           = TRUE.
      621   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      622   DO:
      623     APPLY "END-ERROR":U TO SELF.
      624   END.
      625   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      626   DO:
      627   assign
      628     line-mode = 'ДОБАВЛЕНИЕ':U
      629   .
      630   run str/chsgdsls.w
      631   (   input parParentProc ,
      632       input "p-attr-code" ,
      633       input "Группа товаров на кассе: " + p-name  ,
      634       input ? ,
      635       input ? ,
      636       input v-cntxt-host-code-obj,
      637       input-output varschartic,
      638       output ref-list,
      639       output table tt-gds-list,
      640       false )
      641       .
      642       if ref-list <> "" then do:
      643          run cycle-add in this-procedure no-error.
      644         if error-status:error then do:
      645            message
      646               vss-workfile vss-revision vss-description skip
      647               "Ошибка при вызове процедуры создания товара" skip
      648               error-status :get-message(1) skip
      649               return-value skip
      650               view-as alert-box error .
      651            return no-apply.
      652         end.
      653          OPEN QUERY BROWSE-2 FOR EACH gds-obj-attr       WHERE gds-obj-attr.attr-code = p-attr-code and gds-obj-attr.attr-value = p-attr-value and gds-obj-attr.obj-code = p-obj-code and gds-obj-attr.obj-type = p-obj-type NO-LOCK,       EACH goods WHERE goods.gds-code = gds-obj-attr.gds-code NO-LOCK     .
      654       end.
      655   END.
      656   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      657   DO:
      658   define variable g-log as logical   no-undo .
      659   define buffer buf_temp-goods for temp-goods .
      660   define variable v-del as logical   no-undo .
      661   if not available gds-obj-attr then  return no-apply.
      662         message "Удалить запись ? "
      663         view-as alert-box question
      664         buttons yes-no
      665         update g-log.
      666         if g-log = false then return no-apply.
      667     define variable v-recid as integer no-undo .
      668     define variable ii as integer no-undo .
      669     define variable cur-number as integer no-undo.
      670        for each temp-goods:
      671           run gdsoattr-delete ( input temp-goods.gds-code
      672                               ,input p-obj-type
      673                               ,input p-obj-code
      674                               ,input p-attr-code
      675                               ,output v-del
      676                               ) no-error .
      677        end.
      678         if not v-del then do:
      679           find current gds-obj-attr exclusive-lock no-error .
      680           run gdsoattr-delete ( input gds-obj-attr.gds-code
      681                               ,input p-obj-type
      682                               ,input p-obj-code
      683                               ,input p-attr-code
      684                               ,output v-del
      685                               ) no-error .
      686         end.
      687     apply "HOME" to BROWSE-2 in frame Dialog-Frame.
      688   END.
      689   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      690   DO:
      691     run choose-mark in this-procedure
      692       no-error .
      693     if error-status :error
      694     then do:
      695       return no-apply .
      696     end.
      697   END.
      698   ON VALUE-CHANGED OF r-sort IN FRAME Dialog-Frame
      699   DO:
      700     Assign frame Dialog-Frame r-sort.
      701     case r-sort :
      702     when 1 then do:
      703           if sch-field = "s-name-cnt" then do:
      704                          assign frame Dialog-Frame:title = "Товары >> Группа товаров на кассе - " + p-name.
      705                         OPEN QUERY BROWSE-2 FOR EACH gds-obj-attr       WHERE gds-obj-attr.attr-code = p-attr-code and gds-obj-attr.attr-value = p-attr-value and gds-obj-attr.obj-code = p-obj-code and gds-obj-attr.obj-type = p-obj-type NO-LOCK,       EACH goods WHERE goods.gds-code = gds-obj-attr.gds-code NO-LOCK     .
      706                         end.
      707           enable s-code with frame Dialog-Frame.
      708               Hide s-name  s-name-cnt s-artic in frame Dialog-Frame.
      709           display s-code with frame Dialog-Frame.
      710           apply "entry" to s-code in frame Dialog-Frame.
      711      end.
      712     when 2 then do:
      713           if sch-field = "s-name-cnt" then do:
      714                          assign frame Dialog-Frame:title = "Товары >> Группа товаров на кассе - " + p-name.
      715                         OPEN QUERY BROWSE-2 FOR EACH gds-obj-attr       WHERE gds-obj-attr.attr-code = p-attr-code and gds-obj-attr.attr-value = p-attr-value and gds-obj-attr.obj-code = p-obj-code and gds-obj-attr.obj-type = p-obj-type NO-LOCK,       EACH goods WHERE goods.gds-code = gds-obj-attr.gds-code NO-LOCK     .
      716                         end.
      717           enable s-artic with frame Dialog-Frame.
      718               Hide s-name  s-name-cnt s-code in frame Dialog-Frame.
      719           display s-artic with frame Dialog-Frame.
      720           apply "entry" to s-artic in frame Dialog-Frame.
      721      end.
      722     when 3 then do:
      723       if sch-field = "s-name-cnt" then do:
      724                    assign frame Dialog-Frame:title = "Товары >> Группа товаров на кассе - " + p-name.
      725                   OPEN QUERY BROWSE-2 FOR EACH gds-obj-attr       WHERE gds-obj-attr.attr-code = p-attr-code and gds-obj-attr.attr-value = p-attr-value and gds-obj-attr.obj-code = p-obj-code and gds-obj-attr.obj-type = p-obj-type NO-LOCK,       EACH goods WHERE goods.gds-code = gds-obj-attr.gds-code NO-LOCK     .
      726                   end.
      727           enable s-name with frame Dialog-Frame.
      728           hide s-artic  s-name-cnt s-code in frame Dialog-Frame.
      729           display s-name with frame Dialog-Frame.
      730           apply "entry" to s-name in frame Dialog-Frame.
      731      end.
      732     when 4 then do:
      733           enable s-name-cnt with frame Dialog-Frame.
      734           hide s-artic  s-name s-code in frame Dialog-Frame.
      735           display s-name-cnt with frame Dialog-Frame.
      736           apply "entry" to s-name-cnt in frame Dialog-Frame.
      737      end.
      738     end case.
      739   END.
      740   ON MOUSE-SELECT-DBLCLICK OF s-artic IN FRAME Dialog-Frame
      741   OR  RETURN OF s-artic IN FRAME Dialog-Frame
      742   DO:
      743     if s-artic <> input frame Dialog-Frame s-artic or sch-field <> "s-artic" then do:
      744    sch-field = "s-artic".
      745    assign s-artic = input frame Dialog-Frame s-artic.
      746    doc-rec = ?.
      747    for each buf_gds-obj-attr where buf_gds-obj-attr.attr-code = p-attr-code and buf_gds-obj-attr.obj-code = p-obj-code and buf_gds-obj-attr.obj-type = p-obj-type,
      748               first buf_goods where buf_gds-obj-attr.gds-code = buf_goods.gds-code and
      749                                     buf_goods.artic begins s-artic :
      750            doc-rec = recid(buf_gds-obj-attr) .
      751            leave.
      752    end.
      753     if doc-rec = ? then message "Товар не найден !"  .
      754     else
      755         reposition BROWSE-2 to recid doc-rec no-error.
      756   return no-apply.
      757   end.
      758   END.
      759   ON MOUSE-SELECT-DBLCLICK OF s-code IN FRAME Dialog-Frame
      760   OR  RETURN OF s-code IN FRAME Dialog-Frame
      761   DO:
      762     if s-code <> input frame Dialog-Frame s-code or sch-field <> "s-code" then do:
      763    sch-field = "s-code".
      764    assign s-code = input frame Dialog-Frame s-code.
      765    doc-rec = ?.
      766    for each buf_gds-obj-attr where buf_gds-obj-attr.attr-code = p-attr-code and buf_gds-obj-attr.obj-code = p-obj-code and buf_gds-obj-attr.obj-type = p-obj-type,
      767               first buf_goods where buf_gds-obj-attr.gds-code = buf_goods.gds-code and
      768                                     buf_goods.gds-code = integer(s-code) :
      769            doc-rec = recid(buf_gds-obj-attr) .
      770            leave.
      771    end.
      772     if doc-rec = ? then message "Товар не найден !"  .
      773     else
      774         reposition BROWSE-2 to recid doc-rec no-error.
      775   return no-apply.
      776   end.
      777   END.
      778   ON MOUSE-SELECT-DBLCLICK OF s-name IN FRAME Dialog-Frame
      779   OR  RETURN OF s-name IN FRAME Dialog-Frame
      780   DO:
      781     if s-name <> input frame Dialog-Frame s-name or sch-field <> "s-name" then do:
      782    sch-field = "s-name".
      783    assign s-name = input frame Dialog-Frame s-name.
      784    doc-rec = ?.
      785    for each buf_gds-obj-attr where buf_gds-obj-attr.attr-code = p-attr-code and buf_gds-obj-attr.obj-code = p-obj-code and buf_gds-obj-attr.obj-type = p-obj-type,
      786               first buf_goods where buf_gds-obj-attr.gds-code = buf_goods.gds-code and
      787                                     buf_goods.gds-name begins s-name :
      788            doc-rec = recid(buf_gds-obj-attr) .
      789            leave.
      790    end.
      791     if doc-rec = ? then message "Товар не найден !"  .
      792     else
      793         reposition BROWSE-2 to recid doc-rec no-error.
      794   return no-apply.
      795   end.
      796   END.
      797   ON MOUSE-SELECT-DBLCLICK OF s-name-cnt IN FRAME Dialog-Frame
      798   OR  RETURN OF s-name-cnt IN FRAME Dialog-Frame
      799   DO:
      800     if s-name-cnt <> input frame Dialog-Frame s-name-cnt or sch-field <> "s-name-cnt" then do:
      801    sch-field = "s-name-cnt".
      802    assign s-name-cnt = input frame Dialog-Frame s-name-cnt.
      803    doc-rec = ?.
      804    for each buf_gds-obj-attr where buf_gds-obj-attr.attr-code = p-attr-code and buf_gds-obj-attr.obj-code = p-obj-code and buf_gds-obj-attr.obj-type = p-obj-type,
      805               first buf_goods where
      806                  buf_gds-obj-attr.gds-code = buf_goods.gds-code and
      807                INDEX(buf_goods.gds-name,s-name-cnt) > 0 :
      808            doc-rec = recid(buf_gds-obj-attr) .
      809            leave.
      810    end.
      811     if doc-rec = ? then message "Товар не найден !"  .
      812     else do:
      813        assign frame Dialog-Frame:title = "Товары >> Группы товаров на кассе - " + p-name + " , содержащие в названии " + s-name-cnt .
      814        end.
      815   return no-apply.
      816   end.
      817   END.
      818   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      819   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      820   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      821   on help of frame Dialog-Frame
      822   do:
      823     run gbl/app_help.p
      824       (input this-procedure :file-name
      825       ,input ''
      826       ,input ?
      827       ) no-error.
      828     if error-status :error then do:
      829       message
      830         "Ошибка при вызове помощи"
      831         error-status :get-message(1)
      832         view-as alert-box .
      833     end.
      834   end.
      835   run minbtn-set in this-procedure .
      836   on choose of b-help in frame Dialog-Frame
      837   do:
      838     apply "help":u to frame Dialog-Frame .
      839   end.
      840   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   procedure minbtn-set :
      842       do
      843           on error undo, return error return-value
      844           :
      845           define variable ii              as integer       no-undo .
      846           define variable fh              as widget-handle no-undo .
      847           define variable hh              as widget-handle no-undo .
      848           define variable v-h             as handle        extent 4 no-undo .
      849           define variable v-name-button   as character     no-undo .
      850           define variable v-help-old-x    as decimal       no-undo .
      851           define variable v-help-old-y    as decimal       no-undo .
      852           define variable v-help-old-size as decimal       no-undo .
      853           define variable v-frame-width   as decimal       no-undo .
      854           define variable jj              as integer       no-undo .
      855           do
      856               on error undo, return error
      857               :
      858               assign
      859                   v-frame-width = frame Dialog-Frame:width - 0.3
      860                   fh            = frame Dialog-Frame:first-child
      861                   hh            = fh:first-child
      862                   ii            = 1
      863                   .
      864               do while valid-handle(hh):
      865                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      866                   do:
      867                       case lc(hh:name) :
      868                           when "b-help" then
      869                               do:
      870                                   hh:load-image-up("cmp/b-help.bmp":u) .
      871                                   hh:load-image-down("cmp/b-help.bmp":u) .
      872                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      873                                   hh:TOOLTIP = "Помощь" .
      874                                   v-help-old-x = hh:column .
      875                                   v-help-old-y = hh:row    .
      876                                   v-help-old-size = hh:width .
      877                                   hh:width-chars = 2.5 .
      878                               end.
      879                           when "b-print" then
      880                               do:
      881                                   hh:load-image("cmp/b-print.bmp":u) .
      882                                   hh:TOOLTIP = "Печать" .
      883                                   v-h[ii] = hh:handle .
      884                                   ii = ii + 1 .
      885                                   hh:width-chars = 3 .
      886                               end.
      887                           when "b-history" or
      888                           when "b-hist" then
      889                               do:
      890                                   hh:load-image("cmp/b-hist.bmp":u) .
      891                                   hh:TOOLTIP = "История" .
      892                                   v-h[ii] = hh:handle .
      893                                   ii = ii + 1 .
      894                                   hh:width-chars = 3 .
      895                               end.
      896                           when "b-sch" then
      897                               do:
      898                                   hh:load-image("cmp/b-sch.bmp":u) .
      899                                   hh:TOOLTIP = "Установка Фильтра" .
      900                                   v-h[ii] = hh:handle .
      901                                   ii = ii + 1 .
      902                                   hh:width-chars = 3 .
      903                               end.
      904                           when "b-hist-user" then
      905                               do:
      906                                   hh:load-image("cmp/b-hist.bmp":u) .
      907                                   hh:TOOLTIP = "История пользователя" .
      908                                   ii = ii + 1 .
      909                               end.
      910                       end case.
      911                   end.
      912                   hh = hh:next-sibling.
      913               end.
      914               b-help:column = v-frame-width - b-help:width-chars.
      915               jj = 0.
      916               repeat ii = 4 to 1 by -1 :
      917                   if valid-handle (v-h[ii] ) then
      918                   do:
      919                       jj  = jj + 1 .
      920                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      921                       v-h[ii]:row    = v-help-old-y .
      922                   end.
      923               end.
      924           end.
      925       end.
      926   end procedure.
      927   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      928   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      929   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      930   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      931   define variable v-diasize-current-frame-width  as decimal   no-undo .
      932   define variable v-diasize-current-frame-height as decimal   no-undo .
      933   define variable v-diasize-change-size          as logical   no-undo .
      934   define variable v-diasize-resize-button        as handle    no-undo .
      935   define variable v-diasize-wndmax               as logical   no-undo .
      936   define variable v-diasize-wndstore             as logical   no-undo .
      937   define variable v-diasize-proc-name            as character no-undo .
      938   define variable v-diasize-browse-handle        as handle    no-undo .
      939   define variable v-diasize-browse-number        as integer   no-undo .
      940   define variable v-diasize-need-full-display    as logical   no-undo init false .
      941   define temp-table temp-diasize-handle no-undo
      942     field handle-value  as handle
      943     field save-position as decimal
      944     index xpk is primary unique handle-value
      945     .
      946   define temp-table temp-browse-handle no-undo
      947     field browse-type   as character
      948     field browse-number as integer
      949     field browse-handle as handle
      950     field original-size as decimal
      951     index xpk is primary unique browse-type browse-number
      952     index xie browse-type browse-handle
      953   .
      954   procedure diasize_change-height :
      955     define input  parameter p-change-value  as decimal   no-undo .
      956     define input  parameter p-move-resize   as logical   no-undo .
      957     define variable v-field-group-handle    as handle    no-undo .
      958     define variable v-object-handle         as handle    no-undo .
      959     define variable v-frame-height          as decimal   no-undo .
      960     define variable v-frame-virtual-height  as decimal   no-undo .
      961     define variable v-browse-height         as decimal   no-undo .
      962     define variable v-window-height         as decimal   no-undo .
      963     define variable v-window-virtual-height as decimal   no-undo .
      964     define variable v-change-sign           as integer   no-undo .
      965     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      966     define buffer buf_temp-browse-handle  for temp-browse-handle .
      967     if p-change-value > 0
      968     then do:
      969       if frame Dialog-Frame :height + p-change-value
      970           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      971       then do:
      972         assign
      973           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      974                           - (frame Dialog-Frame :height-chars)
      975         .
      976         if p-change-value <= 0
      977         then do:
      978           run diasize_position-resize-button in this-procedure .
      979           return .
      980         end.
      981       end.
      982     end.
      983     if p-change-value < 0
      984     then do:
      985       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      986       then do:
      987         assign
      988           p-change-value = v-diasize-orig-frame-height
      989                          - (frame Dialog-Frame :height-chars)
      990         .
      991         if p-change-value >= 0
      992         then do:
      993           run diasize_position-resize-button in this-procedure .
      994           return .
      995         end.
      996       end.
      997     end.
      998     if p-change-value >= 0
      999     then do:
     1000       assign
     1001         v-change-sign = 1
     1002       .
     1003     end.
     1004     else do:
     1005       assign
     1006         v-change-sign = -1
     1007       .
     1008     end.
     1009     assign
     1010       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1011     .
     1012     if p-change-value = 0
     1013     then do:
     1014       run diasize_position-resize-button in this-procedure .
     1015       return .
     1016     end.
     1017     move_block:
     1018     do
     1019     on error undo move_block, retry move_block
     1020     :
     1021       if retry
     1022       then do:
     1023         do
     1024         on error undo move_block, leave move_block
     1025         :
     1026           if p-change-value > 0
     1027           then do:
     1028             for each buf_temp-diasize-handle
     1029             on error undo, next
     1030             :
     1031               assign
     1032                 v-object-handle = buf_temp-diasize-handle.handle-value
     1033               .
     1034               if v-object-handle <> v-diasize-resize-button
     1035               then do:
     1036                 assign
     1037                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1038                 .
     1039               end.
     1040             end.
     1041             assign
     1042               v-diasize-browse-handle :height = v-browse-height
     1043             .
     1044             for each buf_temp-browse-handle
     1045               where buf_temp-browse-handle.browse-type = 'height':u
     1046             on error undo, next
     1047             :
     1048               assign
     1049                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1050               .
     1051             end.
     1052             assign
     1053               frame Dialog-Frame :height = v-frame-height
     1054             .
     1055             if frame Dialog-Frame :scrollable = true
     1056             then do:
     1057               assign
     1058                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1059               .
     1060             end.
     1061             run diasize_position-resize-button in this-procedure .
     1062           end.
     1063           else do:
     1064             if frame Dialog-Frame :scrollable = true
     1065             then do:
     1066               assign
     1067                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1068               .
     1069             end.
     1070             assign
     1071               frame Dialog-Frame :height = v-frame-height
     1072             .
     1073             assign
     1074               v-diasize-browse-handle :height = v-browse-height
     1075             .
     1076             for each buf_temp-browse-handle
     1077               where buf_temp-browse-handle.browse-type = 'height':u
     1078             on error undo, next
     1079             :
     1080               assign
     1081                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1082               .
     1083             end.
     1084             for each buf_temp-diasize-handle
     1085             on error undo, next
     1086             :
     1087               assign
     1088                 v-object-handle = buf_temp-diasize-handle.handle-value
     1089               .
     1090               if v-object-handle <> v-diasize-resize-button
     1091               then do:
     1092                 assign
     1093                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1094                 .
     1095               end.
     1096             end.
     1097             run diasize_position-resize-button in this-procedure .
     1098           end.
     1099           assign
     1100             v-diasize-change-size = false
     1101           .
     1102           leave move_block .
     1103         end.
     1104       end.
     1105       assign
     1106         v-diasize-need-full-display = true
     1107       .
     1108       if v-diasize-change-size = false
     1109       then do:
     1110         assign
     1111           v-diasize-change-size = true
     1112         .
     1113       end.
     1114       else do:
     1115         return .
     1116       end.
     1117       assign
     1118         v-frame-height = frame Dialog-Frame :height
     1119         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1120         v-browse-height = v-diasize-browse-handle :height
     1121       .
     1122       for each buf_temp-browse-handle
     1123         where buf_temp-browse-handle.browse-type = 'height':u
     1124       :
     1125         assign
     1126           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1127         .
     1128       end.
     1129       for each buf_temp-diasize-handle
     1130       :
     1131         delete buf_temp-diasize-handle .
     1132       end.
     1133       assign
     1134         v-field-group-handle = frame Dialog-Frame :first-child
     1135       .
     1136       do while valid-handle(v-field-group-handle)
     1137       :
     1138         assign
     1139           v-object-handle = v-field-group-handle :first-child
     1140         .
     1141         do while valid-handle(v-object-handle)
     1142         :
     1143           if  v-object-handle <> v-diasize-browse-handle :handle
     1144           and can-query(v-object-handle, "row")
     1145           and can-query(v-object-handle, "height")
     1146           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1147           then do:
     1148             find first buf_temp-browse-handle
     1149               where buf_temp-browse-handle.browse-type   = 'height':u
     1150                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1151               no-error .
     1152             if available buf_temp-browse-handle
     1153             then do:
     1154             end.
     1155             else do:
     1156               create buf_temp-diasize-handle .
     1157               assign
     1158                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1159                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1160               .
     1161             end.
     1162           end.
     1163           assign
     1164             v-object-handle = v-object-handle :next-sibling
     1165           .
     1166         end.
     1167         assign
     1168           v-field-group-handle = v-field-group-handle :next-sibling
     1169         .
     1170       end.
     1171       do with frame Dialog-Frame
     1172       :
     1173         hide v-diasize-resize-button .
     1174         assign
     1175           v-diasize-resize-button :row    = 1
     1176           v-diasize-resize-button :column = 1
     1177         .
     1178       end.
     1179       if p-change-value > 0
     1180       then do:
     1181         if frame Dialog-Frame :scrollable = true
     1182         then do:
     1183           assign
     1184             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1185             no-error .
     1186           if error-status :error
     1187           or error-status :get-message(1) <> ""
     1188           then do:
     1189             undo move_block, retry move_block .
     1190           end.
     1191         end.
     1192         assign
     1193           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1194           no-error .
     1195         if error-status :error
     1196         or error-status :get-message(1) <> ""
     1197         then do:
     1198           undo move_block, retry move_block .
     1199         end.
     1200         assign
     1201           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1202           no-error .
     1203         if error-status :error
     1204         or error-status :get-message(1) <> ""
     1205         then do:
     1206           undo move_block, retry move_block .
     1207         end.
     1208         for each buf_temp-browse-handle
     1209           where buf_temp-browse-handle.browse-type = 'height':u
     1210         on error undo move_block, retry move_block
     1211         :
     1212           assign
     1213             buf_temp-browse-handle.browse-handle :height
     1214               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1215             no-error .
     1216           if error-status :error
     1217           or error-status :get-message(1) <> ""
     1218           then do:
     1219             undo move_block, retry move_block .
     1220           end.
     1221         end.
     1222         for each buf_temp-diasize-handle
     1223         on error undo move_block, retry move_block
     1224         :
     1225           assign
     1226             v-object-handle = buf_temp-diasize-handle.handle-value
     1227           .
     1228           if v-object-handle <> v-diasize-resize-button
     1229           then do:
     1230             assign
     1231               v-object-handle :row = v-object-handle :row + p-change-value
     1232               no-error .
     1233             if error-status :error
     1234             or error-status :get-message(1) <> ""
     1235             then do:
     1236               undo move_block, retry move_block .
     1237             end.
     1238           end.
     1239         end.
     1240       end.
     1241       else do:
     1242         for each buf_temp-diasize-handle
     1243         on error undo move_block, retry move_block
     1244         :
     1245           assign
     1246             v-object-handle = buf_temp-diasize-handle.handle-value
     1247           .
     1248           if v-object-handle <> v-diasize-resize-button
     1249           then do:
     1250             assign
     1251               v-object-handle :row = v-object-handle :row + p-change-value
     1252               no-error .
     1253             if error-status :error
     1254             or error-status :get-message(1) <> ""
     1255             then do:
     1256               undo move_block, retry move_block .
     1257             end.
     1258           end.
     1259         end.
     1260         assign
     1261           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1262           no-error .
     1263         if error-status :error
     1264         or error-status :get-message(1) <> ""
     1265         then do:
     1266           undo move_block, retry move_block .
     1267         end.
     1268         for each buf_temp-browse-handle
     1269           where buf_temp-browse-handle.browse-type = 'height':u
     1270         on error undo move_block, retry move_block
     1271         :
     1272           assign
     1273             buf_temp-browse-handle.browse-handle :height
     1274               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1275             no-error .
     1276           if error-status :error
     1277           or error-status :get-message(1) <> ""
     1278           then do:
     1279             undo move_block, retry move_block .
     1280           end.
     1281         end.
     1282         assign
     1283           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1284           no-error .
     1285         if error-status :error
     1286         or error-status :get-message(1) <> ""
     1287         then do:
     1288           undo move_block, retry move_block .
     1289         end.
     1290         if frame Dialog-Frame :scrollable = true
     1291         then do:
     1292           assign
     1293             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1294             no-error .
     1295           if error-status :error
     1296           or error-status :get-message(1) <> ""
     1297           then do:
     1298             undo move_block, retry move_block .
     1299           end.
     1300         end.
     1301       end.
     1302       if p-move-resize = true
     1303       then do:
     1304         run diasize_position-resize-button in this-procedure .
     1305       end.
     1306       if v-diasize-wndstore = true
     1307       then do:
     1308         if connected("ub") = true
     1309         then do:
     1310           define variable v-cntxt-db-num        as integer   no-undo .
     1311           define variable v-cntxt-userid        as character no-undo .
     1312           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1313                                             , OUTPUT v-cntxt-userid
     1314                                             ) .
     1315           run gbl/wndsizew.p
     1316             (input  v-cntxt-db-num
     1317             ,input  v-cntxt-userid
     1318             ,input  v-diasize-proc-name
     1319             ,input  'height':u
     1320             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1321             ) .
     1322         end.
     1323       end.
     1324     end.
     1325     assign
     1326       v-diasize-change-size = false
     1327     .
     1328   end procedure.
     1329   procedure diasize_set-height :
     1330     define input  parameter p-new-height  as decimal   no-undo .
     1331     define input  parameter p-move-resize as logical   no-undo .
     1332     do
     1333     on error undo, return error return-value
     1334     :
     1335       run diasize_change-height in this-procedure
     1336         (input  (p-new-height - frame Dialog-Frame :height)
     1337         ,input  p-move-resize
     1338         ) .
     1339     end.
     1340   end procedure.
     1341   procedure diasize_change-width :
     1342     define input  parameter p-change-value as decimal   no-undo .
     1343     define input  parameter p-move-resize  as logical   no-undo .
     1344     define variable v-field-group-handle   as handle    no-undo .
     1345     define variable v-object-handle        as handle    no-undo .
     1346     define variable v-frame-width          as decimal   no-undo .
     1347     define variable v-frame-virtual-width  as decimal   no-undo .
     1348     define variable v-browse-width         as decimal   no-undo .
     1349     define variable v-window-width         as decimal   no-undo .
     1350     define variable v-window-virtual-width as decimal   no-undo .
     1351     define variable v-change-sign          as integer   no-undo .
     1352     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1353     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1354     if p-change-value > 0
     1355     then do:
     1356       if frame Dialog-Frame :width + p-change-value >
     1357           session :width-chars
     1358       then do:
     1359         assign
     1360           p-change-value = session :width-chars - frame Dialog-Frame :width
     1361         .
     1362         if p-change-value <= 0
     1363         then do:
     1364           run diasize_position-resize-button in this-procedure .
     1365           return .
     1366         end.
     1367       end.
     1368     end.
     1369     if p-change-value < 0
     1370     then do:
     1371       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1372       then do:
     1373         assign
     1374           p-change-value = v-diasize-orig-frame-width
     1375                          - frame Dialog-Frame :width
     1376         .
     1377         if p-change-value >= 0
     1378         then do:
     1379           run diasize_position-resize-button in this-procedure .
     1380           return .
     1381         end.
     1382       end.
     1383     end.
     1384     if p-change-value >= 0
     1385     then do:
     1386       assign
     1387         v-change-sign = 1
     1388       .
     1389     end.
     1390     else do:
     1391       assign
     1392         v-change-sign = -1
     1393       .
     1394     end.
     1395     assign
     1396       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1397     .
     1398     if p-change-value = 0
     1399     then do:
     1400       run diasize_position-resize-button in this-procedure .
     1401       return .
     1402     end.
     1403     move_block:
     1404     do
     1405     on error undo move_block, leave move_block
     1406     :
     1407       if retry
     1408       then do:
     1409         do
     1410         on error undo move_block, leave move_block
     1411         :
     1412           if p-change-value > 0
     1413           then do:
     1414             for each buf_temp-diasize-handle
     1415             on error undo, next
     1416             :
     1417               assign
     1418                 v-object-handle = buf_temp-diasize-handle.handle-value
     1419               .
     1420               if v-object-handle <> v-diasize-resize-button
     1421               then do:
     1422                 assign
     1423                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1424                 .
     1425               end.
     1426             end.
     1427             assign
     1428               v-diasize-browse-handle :width = v-browse-width
     1429             .
     1430             for each buf_temp-browse-handle
     1431               where buf_temp-browse-handle.browse-type = 'width':u
     1432             on error undo, next
     1433             :
     1434               assign
     1435                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1436               .
     1437             end.
     1438             assign
     1439               frame Dialog-Frame :width = v-frame-width
     1440             .
     1441             if frame Dialog-Frame :scrollable = true
     1442             then do:
     1443               assign
     1444                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1445               .
     1446             end.
     1447             run diasize_position-resize-button in this-procedure .
     1448           end.
     1449           else do:
     1450             if frame Dialog-Frame :scrollable = true
     1451             then do:
     1452               assign
     1453                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1454               .
     1455             end.
     1456             assign
     1457               frame Dialog-Frame :width = v-frame-width
     1458             .
     1459             for each buf_temp-browse-handle
     1460               where buf_temp-browse-handle.browse-type = 'width':u
     1461             on error undo, next
     1462             :
     1463               assign
     1464                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1465               .
     1466             end.
     1467             assign
     1468               v-diasize-browse-handle :width = v-browse-width
     1469             .
     1470             for each buf_temp-diasize-handle
     1471             on error undo, next
     1472             :
     1473               assign
     1474                 v-object-handle = buf_temp-diasize-handle.handle-value
     1475               .
     1476               if v-object-handle <> v-diasize-resize-button
     1477               then do:
     1478                 assign
     1479                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1480                 .
     1481               end.
     1482             end.
     1483             run diasize_position-resize-button in this-procedure .
     1484           end.
     1485           assign
     1486             v-diasize-change-size = false
     1487           .
     1488           leave move_block .
     1489         end.
     1490       end.
     1491       assign
     1492         v-diasize-need-full-display = true
     1493       .
     1494       if v-diasize-change-size = false
     1495       then do:
     1496         assign
     1497           v-diasize-change-size = true
     1498         .
     1499       end.
     1500       else do:
     1501         return .
     1502       end.
     1503       assign
     1504         v-frame-width = frame Dialog-Frame :width
     1505         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1506         v-browse-width = v-diasize-browse-handle :width
     1507       .
     1508       for each buf_temp-browse-handle
     1509         where buf_temp-browse-handle.browse-type = 'width':u
     1510       :
     1511         assign
     1512           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1513         .
     1514       end.
     1515       for each buf_temp-diasize-handle
     1516       :
     1517         delete buf_temp-diasize-handle .
     1518       end.
     1519       assign
     1520         v-field-group-handle = frame Dialog-Frame :first-child
     1521       .
     1522       do while valid-handle(v-field-group-handle)
     1523       :
     1524         assign
     1525           v-object-handle = v-field-group-handle :first-child
     1526         .
     1527         do while valid-handle(v-object-handle)
     1528         :
     1529           if  v-object-handle <> v-diasize-browse-handle :handle
     1530           and v-object-handle <> v-diasize-resize-button
     1531           and can-query(v-object-handle, "row")
     1532           and can-query(v-object-handle, "height")
     1533           and ( v-object-handle :col + v-object-handle :width
     1534                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1535               )
     1536           then do:
     1537             find first buf_temp-browse-handle
     1538               where buf_temp-browse-handle.browse-type   = 'width':u
     1539                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1540               no-error .
     1541             if available buf_temp-browse-handle
     1542             then do:
     1543             end.
     1544             else do:
     1545               create buf_temp-diasize-handle .
     1546               assign
     1547                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1548                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1549               .
     1550             end.
     1551           end.
     1552           assign
     1553             v-object-handle = v-object-handle :next-sibling
     1554           .
     1555         end.
     1556         assign
     1557           v-field-group-handle = v-field-group-handle :next-sibling
     1558         .
     1559       end.
     1560       do with frame Dialog-Frame
     1561       :
     1562         hide v-diasize-resize-button .
     1563         v-diasize-resize-button :row = 1.
     1564         v-diasize-resize-button :column = 1.
     1565       end.
     1566       if p-change-value > 0
     1567       then do:
     1568         if frame Dialog-Frame :scrollable = true
     1569         then do:
     1570           assign
     1571             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1572             no-error .
     1573           if error-status :error
     1574           or error-status :get-message(1) <> ""
     1575           then do:
     1576             undo move_block, retry move_block.
     1577           end.
     1578         end.
     1579         assign
     1580           frame Dialog-Frame :width = v-frame-width + p-change-value
     1581           no-error .
     1582         if error-status :error
     1583         or error-status :get-message(1) <> ""
     1584         then do:
     1585           undo move_block, retry move_block.
     1586         end.
     1587         assign
     1588           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1589         no-error .
     1590         if error-status :error
     1591         or error-status :get-message(1) <> ""
     1592         then do:
     1593           undo move_block, retry move_block.
     1594         end.
     1595         for each buf_temp-browse-handle
     1596           where buf_temp-browse-handle.browse-type = 'width':u
     1597         on error undo move_block, retry move_block
     1598         :
     1599           assign
     1600             buf_temp-browse-handle.browse-handle :width
     1601               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1602             no-error .
     1603           if error-status :error
     1604           or error-status :get-message(1) <> ""
     1605           then do:
     1606             undo move_block, retry move_block .
     1607           end.
     1608         end.
     1609         for each buf_temp-diasize-handle
     1610         on error undo move_block, retry move_block
     1611         :
     1612           assign
     1613             v-object-handle = buf_temp-diasize-handle.handle-value
     1614           .
     1615           if v-object-handle <> v-diasize-resize-button
     1616           then do:
     1617             assign
     1618               v-object-handle :col = v-object-handle :col + p-change-value
     1619               no-error .
     1620             if error-status :error
     1621             or error-status :get-message(1) <> ""
     1622             then do:
     1623               undo move_block, retry move_block .
     1624             end.
     1625           end.
     1626         end.
     1627       end.
     1628       else do:
     1629         for each buf_temp-diasize-handle
     1630         on error undo move_block, retry move_block
     1631         :
     1632           assign
     1633             v-object-handle = buf_temp-diasize-handle.handle-value
     1634           .
     1635           if v-object-handle <> v-diasize-resize-button
     1636           then do:
     1637             assign
     1638               v-object-handle :col = v-object-handle :col + p-change-value
     1639               no-error .
     1640             if error-status :error
     1641             or error-status :get-message(1) <> ""
     1642             then do:
     1643               undo move_block, retry move_block .
     1644             end.
     1645           end.
     1646         end.
     1647         for each buf_temp-browse-handle
     1648           where buf_temp-browse-handle.browse-type = 'width':u
     1649         on error undo move_block, retry move_block
     1650         :
     1651           assign
     1652             buf_temp-browse-handle.browse-handle :width
     1653               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1654             no-error .
     1655           if error-status :error
     1656           or error-status :get-message(1) <> ""
     1657           then do:
     1658             undo move_block, retry move_block .
     1659           end.
     1660         end.
     1661         assign
     1662           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1663           no-error .
     1664         if error-status :error
     1665         or error-status :get-message(1) <> ""
     1666         then do:
     1667           undo move_block, retry move_block.
     1668         end.
     1669         assign
     1670           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1671         no-error .
     1672         if error-status :error
     1673         or error-status :get-message(1) <> ""
     1674         then do:
     1675           undo move_block, retry move_block.
     1676         end.
     1677         if frame Dialog-Frame :scrollable = true
     1678         then do:
     1679           assign
     1680             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1681           no-error .
     1682           if error-status :error
     1683           or error-status :get-message(1) <> ""
     1684           then do:
     1685             undo move_block, retry move_block.
     1686           end.
     1687         end.
     1688       end.
     1689       if p-move-resize
     1690       then do:
     1691         run diasize_position-resize-button in this-procedure .
     1692       end.
     1693       if v-diasize-wndstore = true
     1694       then do:
     1695         if connected("ub") = true
     1696         then do:
     1697           define variable v-cntxt-db-num        as integer   no-undo .
     1698           define variable v-cntxt-userid        as character no-undo .
     1699           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1700                                             , OUTPUT v-cntxt-userid
     1701                                             ) .
     1702           run gbl/wndsizew.p
     1703             (input  v-cntxt-db-num
     1704             ,input  v-cntxt-userid
     1705             ,input  v-diasize-proc-name
     1706             ,input  'width':u
     1707             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1708             ) .
     1709         end.
     1710       end.
     1711     end.
     1712     assign
     1713       v-diasize-change-size = false
     1714     .
     1715   end procedure.
     1716   procedure diasize_set-width :
     1717     define input  parameter p-new-width  as decimal   no-undo .
     1718     define input  parameter p-move-resize as logical   no-undo .
     1719     do
     1720     on error undo, return error return-value
     1721     :
     1722       run diasize_change-width in this-procedure
     1723         (input  (p-new-width - frame Dialog-Frame :width)
     1724         ,input  p-move-resize
     1725         ) .
     1726     end.
     1727   end procedure.
     1728   procedure diasize_position-resize-button :
     1729     do with frame Dialog-Frame
     1730     :
     1731       hide v-diasize-resize-button .
     1732       assign
     1733         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1734                     - 1
     1735                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1736         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1737                     - 1
     1738                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1739       .
     1740       view v-diasize-resize-button .
     1741     end.
     1742   end procedure.
     1743   on alt-right anywhere
     1744   do:
     1745     run diasize_change-width in this-procedure
     1746       (input 1
     1747       ,input true
     1748       ) .
     1749     return no-apply .
     1750   end.
     1751   on alt-left anywhere
     1752   do:
     1753     run diasize_change-width in this-procedure
     1754       (input -1
     1755       ,input true
     1756       ) .
     1757     return no-apply .
     1758   end.
     1759   on alt-down anywhere
     1760   do:
     1761     run diasize_change-height in this-procedure
     1762       (input 1
     1763       ,input true
     1764       ) .
     1765     return no-apply .
     1766   end.
     1767   on alt-up anywhere
     1768   do:
     1769     run diasize_change-height in this-procedure
     1770       (input -1
     1771       ,input true
     1772       ) .
     1773     return no-apply .
     1774   end.
     1775   on alt-enter of frame Dialog-Frame
     1776   do:
     1777     run diasize_maximize in this-procedure
     1778       (input  ?
     1779       ).
     1780     return no-apply .
     1781   end.
     1782   procedure diasize_end-move :
     1783     do
     1784     on error undo, return error return-value
     1785     :
     1786       define variable v-row-delta as decimal   no-undo .
     1787       define variable v-col-delta as decimal   no-undo .
     1788       define variable v-new-row as decimal   no-undo .
     1789       define variable v-new-col as decimal   no-undo .
     1790       assign
     1791         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1792         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1793       .
     1794       assign
     1795         v-row-delta = v-new-row - frame Dialog-Frame :height
     1796         v-col-delta = v-new-col - frame Dialog-Frame :width
     1797       .
     1798       run diasize_change-height in this-procedure
     1799         (input v-row-delta
     1800         ,input true
     1801         ) .
     1802       run diasize_change-width in this-procedure
     1803         (input v-col-delta
     1804         ,input true
     1805         ) .
     1806     end.
     1807   end procedure.
     1808   procedure diasize_maximize :
     1809     define input  parameter p-action as logical   no-undo .
     1810     do
     1811     on error undo, return error return-value
     1812     :
     1813       if p-action = ?
     1814       then do:
     1815         if v-diasize-need-maximize = true
     1816         then do:
     1817           assign
     1818             p-action = true
     1819           .
     1820         end.
     1821         else do:
     1822           assign
     1823             p-action = false
     1824           .
     1825         end.
     1826       end.
     1827       if p-action = true
     1828       then do:
     1829         run diasize_change-height in this-procedure
     1830           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1831               - frame Dialog-Frame :height-chars
     1832           ,input true
     1833           ) .
     1834         run diasize_change-width in this-procedure
     1835           (input session :width-chars
     1836               - frame Dialog-Frame :width-chars
     1837           ,input true
     1838           ) .
     1839         assign
     1840           v-diasize-need-maximize = false
     1841         .
     1842       end.
     1843       else do:
     1844         run diasize_change-width in this-procedure
     1845           (input v-diasize-orig-frame-width
     1846               - frame Dialog-Frame :width-chars
     1847           ,input true
     1848           ) .
     1849         run diasize_change-height in this-procedure
     1850           (input v-diasize-orig-frame-height
     1851               - frame Dialog-Frame :height-chars
     1852           ,input true
     1853           ) .
     1854         assign
     1855           v-diasize-need-maximize = true
     1856         .
     1857       end.
     1858     end.
     1859   end procedure.
     1860   procedure diasize_restore-orig-size :
     1861     do
     1862     on error undo, return error return-value
     1863     :
     1864       assign
     1865         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1866         v-diasize-current-frame-height = frame Dialog-Frame :height
     1867       .
     1868       run diasize_set-height in this-procedure
     1869         (input  v-diasize-orig-frame-height
     1870         ,input  true
     1871         ) .
     1872       run diasize_set-width in this-procedure
     1873         (input  v-diasize-orig-frame-width
     1874         ,input  true
     1875         ) .
     1876     end.
     1877   end procedure.
     1878   procedure diasize_restore-current-size :
     1879     do
     1880     on error undo, return error return-value
     1881     :
     1882       run diasize_set-height in this-procedure
     1883         (input  v-diasize-current-frame-height
     1884         ,input  true
     1885         ) .
     1886       run diasize_set-width in this-procedure
     1887         (input  v-diasize-current-frame-width
     1888         ,input  true
     1889         ) .
     1890     end.
     1891   end procedure.
     1892   procedure diasize_set-browse-handle :
     1893     define input  parameter p-browse-handle as handle   no-undo .
     1894     define buffer buf_temp-browse-handle for temp-browse-handle .
     1895     do
     1896     on error undo, return error return-value
     1897     :
     1898       assign
     1899         v-diasize-browse-handle = p-browse-handle
     1900       .
     1901       for each buf_temp-browse-handle
     1902       on error undo, return error return-value
     1903       :
     1904         delete buf_temp-browse-handle .
     1905       end.
     1906     end.
     1907   end procedure.
     1908   procedure diasize_add_browse :
     1909     define input  parameter p-browse-type   as character no-undo .
     1910     define input  parameter p-browse-handle as handle    no-undo .
     1911     define buffer buf_temp-browse-handle for temp-browse-handle .
     1912     do
     1913     on error undo, return error return-value
     1914     :
     1915       assign
     1916         v-diasize-browse-number = v-diasize-browse-number + 1
     1917       .
     1918       create buf_temp-browse-handle .
     1919       assign
     1920         buf_temp-browse-handle.browse-type   = p-browse-type
     1921         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1922         buf_temp-browse-handle.browse-handle = p-browse-handle
     1923       .
     1924     end.
     1925   end procedure.
     1926   procedure diasize_init :
     1927     define variable v-default-value    as logical   no-undo .
     1928     define variable v-restore-saved    as logical   no-undo .
     1929     define variable v-resize-value-str as character no-undo .
     1930     do
     1931     on error undo, return error return-value
     1932     :
     1933       do with frame Dialog-Frame
     1934       :
     1935         assign
     1936           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1937           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1938           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1939         .
     1940         create button v-diasize-resize-button
     1941         assign
     1942           parent        = frame Dialog-Frame :first-child
     1943           label         = "s"
     1944           height-pixels = 16
     1945           width-pixels  = 16
     1946           visible       = true
     1947           sensitive     = true
     1948           movable       = true
     1949           triggers:
     1950             on end-move persistent run diasize_end-move in this-procedure .
     1951           end triggers.
     1952         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1953         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1954         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1955         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1956         assign
     1957           v-diasize-wndmax = false
     1958         .
     1959         if connected("ub") = true
     1960         then do:
     1961           define variable v-cntxt-db-num        as integer   no-undo .
     1962           define variable v-cntxt-userid        as character no-undo .
     1963           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1964                                             , OUTPUT v-cntxt-userid
     1965                                             ) .
     1966           run gbl/wndpar_r.p
     1967             (input  v-cntxt-db-num
     1968             ,input  v-cntxt-userid
     1969             ,input  'wndmax':U
     1970             ,output v-diasize-wndmax
     1971             ,output v-default-value
     1972             ) .
     1973         end.
     1974         assign
     1975           v-diasize-wndstore = false
     1976         .
     1977         if connected("ub") = true
     1978         then do:
     1979           run gbl/wndpar_r.p
     1980             (input  v-cntxt-db-num
     1981             ,input  v-cntxt-userid
     1982             ,input  'wndstore':U
     1983             ,output v-diasize-wndstore
     1984             ,output v-default-value
     1985             ) .
     1986         end.
     1987         assign
     1988           v-diasize-proc-name = entry(1, program-name(2), '.')
     1989         .
     1990         if v-diasize-wndstore = true
     1991         then do:
     1992           assign
     1993             v-restore-saved = false
     1994           .
     1995           if connected("ub") = true
     1996           then do:
     1997             run gbl/wndsizer.p
     1998               (input  v-cntxt-db-num
     1999               ,input  v-cntxt-userid
     2000               ,input  v-diasize-proc-name
     2001               ,input  'height':u
     2002               ,output v-resize-value-str
     2003               ) .
     2004             if v-resize-value-str <> '':U
     2005             then do:
     2006               run diasize_change-height in this-procedure
     2007                 (input  integer(v-resize-value-str)
     2008                 ,input  true
     2009                 ) .
     2010               assign
     2011                 v-restore-saved = true
     2012               .
     2013             end.
     2014           end.
     2015           if connected("ub") = true
     2016           then do:
     2017             run gbl/wndsizer.p
     2018               (input  v-cntxt-db-num
     2019               ,input  v-cntxt-userid
     2020               ,input  v-diasize-proc-name
     2021               ,input  'width':u
     2022               ,output v-resize-value-str
     2023               ) .
     2024             if v-resize-value-str <> '':U
     2025             then do:
     2026               run diasize_change-width in this-procedure
     2027                 (input  integer(v-resize-value-str)
     2028                 ,input  true
     2029                 ) .
     2030               assign
     2031                 v-restore-saved = true
     2032               .
     2033             end.
     2034           end.
     2035           if v-restore-saved <> true
     2036           then do:
     2037             if v-diasize-wndmax = true
     2038             then do:
     2039               run diasize_maximize in this-procedure
     2040                 (input  true
     2041                 ) .
     2042             end.
     2043           end.
     2044         end.
     2045         else do:
     2046           if v-diasize-wndmax = true
     2047           then do:
     2048             run diasize_maximize in this-procedure
     2049               (input  true
     2050               ) .
     2051           end.
     2052         end.
     2053       end.
     2054     end.
     2055   end procedure.
     2056   procedure diasize_need-full-display :
     2057     define output parameter p-need-full-display as logical   no-undo .
     2058     do
     2059     on error undo, return error return-value
     2060     :
     2061       assign
     2062         p-need-full-display = v-diasize-need-full-display
     2063       .
     2064       assign
     2065         v-diasize-need-full-display = false
     2066       .
     2067     end.
     2068   end procedure.
     2069   procedure get-context :
     2070      define output parameter p-db-num as integer          no-undo.
     2071      define output parameter p-user-id as character        no-undo.
     2072      define variable v-login               as character    no-undo.
     2073      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2074      define buffer buf_user-login  for ub.user-login .
     2075      do
     2076      on error undo, return error
     2077      :
     2078            FIND FIRST buf_sys-ctrl no-lock.
     2079            ASSIGN
     2080               v-login = USERID("ub")
     2081               p-db-num = buf_sys-ctrl.db-num
     2082            .
     2083            FIND FIRST buf_user-login
     2084                 WHERE buf_user-login.db-num = p-db-num
     2085                   AND buf_user-login.user-login = v-login
     2086                 no-lock
     2087                 no-error
     2088                 .
     2089            IF AVAILABLE buf_user-login
     2090            THEN DO:
     2091               assign
     2092                  p-user-id = buf_user-login.user-id
     2093               .
     2094            END.
     2095      end.
     2096   end procedure.
     2097       run diasize_init in this-procedure .
     2098   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2099   on INS of frame Dialog-Frame anywhere do:
     2100     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2101     return no-apply.
     2102   end.
     2103   assign
     2104      frame Dialog-Frame:title = "Товары >> " + p-name
     2105   .
     2106   def var sort-labelBROWSE-2   as character no-undo .
     2107   def var sort-clmnBROWSE-2    as handle    no-undo .
     2108   def var cur-clmnBROWSE-2     as handle    no-undo .
     2109   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     2110   def var re-queryBROWSE-2     as logical   initial no no-undo .
     2111   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     2112      run sort-brBROWSE-2
     2113        (input (if available gds-obj-attr
     2114                then recid(gds-obj-attr)
     2115                else ?
     2116               )
     2117        ).
     2118   end.
     2119   PROCEDURE sort-brBROWSE-2 :
     2120     define input parameter p-recid as recid no-undo .
     2121     if re-queryBROWSE-2 = no then do:
     2122       assign
     2123          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     2124       .
     2125       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     2126       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     2127         assign
     2128            sort-labelBROWSE-2 = ""
     2129            sort-clmnBROWSE-2 = ?
     2130         .
     2131        end.
     2132        else do:
     2133          assign
     2134            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     2135            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     2136            sort-clmnBROWSE-2:column-fgcolor = 4
     2137          .
     2138        end.
     2139      end.
     2140     assign
     2141       cur-clmn-locBROWSE-2 = 1
     2142     .
     2143     def var column-handle as handle no-undo .
     2144     column-handle = BROWSE-2:first-column.
     2145     do while valid-handle(column-handle) :
     2146       if column-handle = cur-clmnBROWSE-2 then do:
     2147         leave .
     2148       end.
     2149       column-handle = column-handle:NEXT-COLUMN.
     2150       assign
     2151         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     2152       .
     2153     end.
     2154     case sort-labelBROWSE-2:
     2155           when goods.artic:label in browse BROWSE-2 then DO:   assign     sort-column-name = "goods.artic"   .   run OpenBr.   . END.
     2156           when goods.gds-name:label in browse BROWSE-2 then DO:   assign     sort-column-name = "goods.gds-name"   .   run OpenBr.   . END.
     2157       otherwise do:
     2158         assign
     2159           sort-column-name = ""
     2160         .
     2161         run OpenBr.
     2162         if sort-labelBROWSE-2 <> "" then do:
     2163           assign
     2164             cur-clmnBROWSE-2:column-fgcolor = 0
     2165           .
     2166         end.
     2167         assign
     2168           cur-clmn-locBROWSE-2 = ?
     2169         .
     2170       end.
     2171     end case.
     2172     if p-recid <> ? then do:
     2173       reposition BROWSE-2 to recid p-recid no-error.
     2174       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     2175     end.
     2176     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     2177   END PROCEDURE.
     2178   procedure re-open-query-srt-clmnBROWSE-2:
     2179   if cur-clmnBROWSE-2 = ? then do:
     2180      run OpenBr.
     2181   end.
     2182   else do:
     2183      assign re-queryBROWSE-2 = yes.
     2184      run sort-brBROWSE-2
     2185        (input (if available gds-obj-attr
     2186                then recid(gds-obj-attr)
     2187                else ?
     2188               )
     2189        ).
     2190      assign re-queryBROWSE-2 = no.
     2191   end.
     2192   end.
     2193   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2194   on F9 of frame Dialog-Frame anywhere do:
     2195     if not available ub.goods then
     2196       return no-apply.
     2197     gds-rec = recid (ub.goods).
     2198     run ref/gds-form.w ( input parParentProc
     2199                         ,input 'ПРОСМОТР':U
     2200                         ,input ?
     2201                         ,input ?
     2202                         ,input ?
     2203                         ,input-output gds-rec).
     2204     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     2205     return no-apply.
     2206   end.
     2207   MAIN-BLOCK:
     2208   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2209      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2210      run enable_UI in this-procedure .
     2211      run post_enable_UI in this-procedure .
     2212      enable  s-code with frame Dialog-Frame.
     2213      Hide    s-name  s-name-cnt s-artic in frame Dialog-Frame.
     2214      display s-code with frame Dialog-Frame.
     2215      WAIT-FOR GO OF FRAME Dialog-Frame.
     2216   END.
     2217   run disable_UI in this-procedure .
     2218   PROCEDURE cycle-add :
     2219   define variable v-num   as integer no-undo .
     2220   define variable v-flag as logical   no-undo init false .
     2221   define variable v-count as integer no-undo .
     2222      define buffer bb_gds-obj-attr   for ub.gds-obj-attr .
     2223      define buffer buf_goods       for ub.goods .
     2224      run gbl/d-askw.w
     2225         (input "Вопрос"
     2226         ,input "Если товар уже прикреплен к Группе товаров на кассе, пропускаем его?"
     2227         ,input "|^"
     2228         ,input "Не добавлять|Добавлять|Остановка"
     2229         ,input "Не добавляем товар к новой группе товаров на кассе, товар остается в старой группе товаров|"
     2230            + "Добавляем товар к новой группе товаров на кассе и открепляем от старой|"
     2231            + "Остановить добавление товаров, если встречаются товары прикрепленные к другим группам товар на кассе."
     2232         ,input 1
     2233         ,input 2
     2234         ,output v-num
     2235         ).
     2236       case v-num :
     2237         when 1 then do :
     2238             for each tt-gds-list no-lock  by tt-gds-list.nn :
     2239               lns-cnt  =  lns-cnt + 1 .
     2240               if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2241                 v-flag = false .
     2242                 for each bb_gds-obj-attr no-lock where
     2243                          bb_gds-obj-attr.gds-code = tt-gds-list.gds-code
     2244                 :
     2245                   v-flag = true.
     2246                   leave.
     2247                 end.
     2248                 if v-flag = false then do :
     2249                   find first bb_gds-obj-attr no-lock
     2250                       where bb_gds-obj-attr.gds-code = tt-gds-list.gds-code
     2251                         and bb_gds-obj-attr.attr-code = p-attr-code
     2252                         and bb_gds-obj-attr.obj-code = p-obj-code
     2253                         and bb_gds-obj-attr.obj-type = p-obj-type
     2254                         no-error.
     2255                   if not available bb_gds-obj-attr then do :
     2256                       run gdsoattr-write (input tt-gds-list.gds-code
     2257                                          ,input p-obj-type
     2258                                          ,input p-obj-code
     2259                                          ,input p-attr-code
     2260                                          ,input p-attr-value
     2261                                           ) no-error.
     2262                   end.
     2263                 end.
     2264             end.
     2265         end.
     2266         when 2 then do :
     2267             for each tt-gds-list no-lock  by tt-gds-list.nn :
     2268               lns-cnt  =  lns-cnt + 1 .
     2269               if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2270                 v-flag = false .
     2271                 for each bb_gds-obj-attr exclusive-lock
     2272                       where bb_gds-obj-attr.gds-code = tt-gds-list.gds-code
     2273                         and bb_gds-obj-attr.attr-code = p-attr-code
     2274                         and bb_gds-obj-attr.obj-code = p-obj-code
     2275                         and bb_gds-obj-attr.obj-type = p-obj-type
     2276                 :
     2277                   run gdsoattr-delete ( input tt-gds-list.gds-code
     2278                                       ,input p-obj-type
     2279                                       ,input p-obj-code
     2280                                       ,input p-attr-code
     2281                                       ,output v-del
     2282                                       ) no-error .
     2283                 end.
     2284               find first bb_gds-obj-attr no-lock
     2285                    where bb_gds-obj-attr.gds-code = tt-gds-list.gds-code
     2286                      and bb_gds-obj-attr.attr-code = p-attr-code
     2287                      and bb_gds-obj-attr.obj-code = p-obj-code
     2288                      and bb_gds-obj-attr.obj-type = p-obj-type
     2289                      no-error.
     2290               if not available bb_gds-obj-attr then do :
     2291                       run gdsoattr-write (input tt-gds-list.gds-code
     2292                                          ,input p-obj-type
     2293                                          ,input p-obj-code
     2294                                          ,input p-attr-code
     2295                                          ,input p-attr-value
     2296                                           ) no-error.
     2297               end.
     2298             end.
     2299         end.
     2300         when 3 then do :
     2301             for each tt-gds-list no-lock  by tt-gds-list.nn :
     2302               lns-cnt  =  lns-cnt + 1 .
     2303               if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2304                 v-flag = false .
     2305                 for each bb_gds-obj-attr no-lock
     2306                       where bb_gds-obj-attr.gds-code = tt-gds-list.gds-code
     2307                         and bb_gds-obj-attr.attr-code = p-attr-code
     2308                         and bb_gds-obj-attr.obj-code = p-obj-code
     2309                         and bb_gds-obj-attr.obj-type = p-obj-type
     2310                 :
     2311                   v-flag = true .
     2312                   leave.
     2313                 end.
     2314               if v-flag = true then do :
     2315                 leave.
     2316               end.
     2317             end.
     2318             if v-flag <> true then do :
     2319             for each tt-gds-list no-lock  by tt-gds-list.nn :
     2320               find first bb_gds-obj-attr no-lock
     2321                       where bb_gds-obj-attr.gds-code = tt-gds-list.gds-code
     2322                         and bb_gds-obj-attr.attr-code = p-attr-code
     2323                         and bb_gds-obj-attr.obj-code = p-obj-code
     2324                         and bb_gds-obj-attr.obj-type = p-obj-type
     2325                      no-error.
     2326               if not available bb_gds-obj-attr then do :
     2327                       run gdsoattr-write (input tt-gds-list.gds-code
     2328                                          ,input p-obj-type
     2329                                          ,input p-obj-code
     2330                                          ,input p-attr-code
     2331                                          ,input p-attr-value
     2332                                           ) no-error.
     2333               end.
     2334             end.
     2335             end.
     2336         end.
     2337       end case.
     2338   end procedure.
     2339   PROCEDURE disable_UI :
     2340     HIDE FRAME Dialog-Frame.
     2341   END PROCEDURE.
     2342   PROCEDURE enable_UI :
     2343     DISPLAY r-sort s-artic s-name s-name-cnt s-code FILL-IN-2
     2344         WITH FRAME Dialog-Frame.
     2345     ENABLE b-exit b-mark b-add b-del b-help r-sort s-artic s-code BROWSE-2
     2346            FILL-IN-2
     2347         WITH FRAME Dialog-Frame.
     2348     VIEW FRAME Dialog-Frame.
     2349     OPEN QUERY BROWSE-2 FOR EACH gds-obj-attr       WHERE gds-obj-attr.attr-code = p-attr-code and gds-obj-attr.attr-value = p-attr-value and gds-obj-attr.obj-code = p-obj-code and gds-obj-attr.obj-type = p-obj-type NO-LOCK,       EACH goods WHERE goods.gds-code = gds-obj-attr.gds-code NO-LOCK     .
     2350   END PROCEDURE.
     2351   PROCEDURE OpenBr :
     2352   define variable t-ret as logical no-undo .
     2353   t-ret =  session:SET-WAIT-STATE("GENERAL") .
     2354   case sort-column-name :
     2355     when "goods.artic" then do:
     2356           assign frame Dialog-Frame:title = "Товары >> " + p-name.    OPEN QUERY BROWSE-2 FOR EACH gds-obj-attr       WHERE gds-obj-attr.attr-code = p-attr-code and gds-obj-attr.attr-value = p-attr-value and gds-obj-attr.obj-code = p-obj-code and gds-obj-attr.obj-type = p-obj-type NO-LOCK,       EACH goods WHERE goods.gds-code = gds-obj-attr.gds-code NO-LOCK     by goods.artic.    .
     2357     end.
     2358     when "goods.gds-name" then do:
     2359           assign frame Dialog-Frame:title = "Товары >> " + p-name.    OPEN QUERY BROWSE-2 FOR EACH gds-obj-attr       WHERE gds-obj-attr.attr-code = p-attr-code and gds-obj-attr.attr-value = p-attr-value and gds-obj-attr.obj-code = p-obj-code and gds-obj-attr.obj-type = p-obj-type NO-LOCK,       EACH goods WHERE goods.gds-code = gds-obj-attr.gds-code NO-LOCK     by goods.gds-name.    .
     2360     end.
     2361     otherwise do:
     2362           assign frame Dialog-Frame:title = "Товары >> " + p-name.    OPEN QUERY BROWSE-2 FOR EACH gds-obj-attr       WHERE gds-obj-attr.attr-code = p-attr-code and gds-obj-attr.attr-value = p-attr-value and gds-obj-attr.obj-code = p-obj-code and gds-obj-attr.obj-type = p-obj-type NO-LOCK,       EACH goods WHERE goods.gds-code = gds-obj-attr.gds-code NO-LOCK     .    .
     2363     end.
     2364   end case.
     2365   t-ret =  session:SET-WAIT-STATE("") .
     2366   apply "HOME" to BROWSE-2 in frame Dialog-Frame.
     2367   END PROCEDURE.
     2368   PROCEDURE post_enable_UI :
     2369   END PROCEDURE.
     2370   PROCEDURE get-mark-string :
     2371     define input  parameter p-gds-code    as integer   no-undo .
     2372     define output parameter p-mark-string as character no-undo .
     2373     do
     2374     on error undo, return error return-value
     2375     :
     2376       find first temp-goods
     2377         where temp-goods.gds-code = p-gds-code
     2378         no-error .
     2379       if available temp-goods
     2380       then do:
     2381         assign
     2382           p-mark-string = '*':U
     2383         .
     2384       end.
     2385       else do:
     2386         assign
     2387           p-mark-string = '':U
     2388         .
     2389       end.
     2390     end.
     2391   END PROCEDURE.
     2392   PROCEDURE choose-mark :
     2393     define variable v-log as logical no-undo .
     2394     do
     2395     on error undo, return error return-value
     2396     :
     2397       if available goods
     2398       then do:
     2399         find first temp-goods
     2400           where temp-goods.gds-code = goods.gds-code
     2401           no-error .
     2402         if available temp-goods
     2403         then do:
     2404           run goods_delete in this-procedure
     2405             (input  goods.gds-code
     2406             ) .
     2407         end.
     2408         else do:
     2409           run goods_append in this-procedure
     2410             (input  goods.gds-code
     2411             ) .
     2412         end.
     2413         v-log = Browse-2:refresh() in frame Dialog-Frame.
     2414         if last-event :function <> "MOUSE-SELECT-DBLCLICK"
     2415         then do:
     2416           v-log = browse-2:select-next-row ().
     2417           apply "iteration-changed" to browse-2 in frame Dialog-Frame.
     2418         end.
     2419         apply "entry" to browse-2 in frame Dialog-Frame.
     2420       end.
     2421     end.
     2422   END PROCEDURE.
     2423   PROCEDURE goods_append :
     2424     define input  parameter p-gds-code as integer no-undo .
     2425     do
     2426     on error undo, return error return-value
     2427     :
     2428       find first temp-goods
     2429         where temp-goods.gds-code = p-gds-code
     2430         no-error .
     2431       if not available temp-goods
     2432       then do:
     2433         create temp-goods .
     2434         assign
     2435           temp-goods.gds-code = p-gds-code
     2436         .
     2437       end.
     2438     end.
     2439   END PROCEDURE.
     2440   PROCEDURE goods_delete :
     2441     define input  parameter p-gds-code as integer   no-undo .
     2442     do
     2443     on error undo, return error return-value
     2444     :
     2445       find first temp-goods
     2446         where temp-goods.gds-code = p-gds-code
     2447           no-error .
     2448       if available temp-goods
     2449       then do:
     2450         delete temp-goods .
     2451       end.
     2452     end.
     2453   END PROCEDURE.
     2454   FUNCTION mark-string RETURNS CHARACTER
     2455     ( p-gds-code as integer ) :
     2456     define variable v-mark-string as character no-undo .
     2457     run get-mark-string in this-procedure
     2458       (input  p-gds-code
     2459       ,output v-mark-string
     2460       ) .
     2461     return v-mark-string .
     2462   END FUNCTION.
