      438     on error undo, return error
      439     :
      440           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-margin-value in g#attr-lib
      441         (input  p-gds-code
      442         ,input  p-obj-type
      443         ,input  p-obj-code
      444         ,output p-min-value
      445         ,output p-max-value
      446         ,output p-increase-pc
      447         ,output p-rmethod
      448         ,output p-base
      449         ,output p-range-margin
      450         ,output p-exists-margin
      451         ,output p-range-increase
      452         ,output p-exists-increase
      453         ,output p-range-rmethod
      454         ,output p-exists-rmethod
      455         ) no-error .
      456       if error-status :error
