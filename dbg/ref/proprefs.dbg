     4545   FUNCTION get-dtm-name RETURNS CHARACTER
     4546     ( INPUT p-dtm-code AS integer ) :
     4547   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     4548   FIND first buf_prop-head NO-LOCK WHERE
     4549               buf_prop-head.dtm-code = p-dtm-code NO-ERROR.
     4550   IF NOT AVAILABLE buf_prop-head  THEN  RETURN "!!!Неизвестный объект".
     4551   RETURN buf_prop-head.prop-label.
     4552   END FUNCTION.
