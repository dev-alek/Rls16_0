        1   DEFINE TEMP-TABLE tt-prop-ref NO-UNDO LIKE ub.prop-ref.
        2   DEFINE BUFFER X_prop-head FOR ub.prop-head.
        3   DEFINE BUFFER X_prop-ref FOR ub.prop-ref.
        4   DEFINE BUFFER X_prop-ref-call FOR ub.prop-ref-call.
        5   define input parameter parparentproc as widget-handle no-undo .
        6   define input parameter p-bttns as character no-undo .
        7   define input parameter p-list-mode as character no-undo .
        8   define input parameter p-dtm-code as integer no-undo .
        9   define input parameter p-sum-id as character no-undo .
       10   define input parameter p-call-id as character no-undo .
       11   DEFINE INPUT-OUTPUT PARAMETER p-rid-list AS CHARACTER NO-UNDO.
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Срезы данных для объектов системы лояльности".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable v-waitfram-action01         as character   no-undo .
       74   define variable v-waitfram-action02         as character   no-undo .
       75   define variable v-waitfram-action03         as character   no-undo .
       76   define variable mWaitFramTextBeg            as character   no-undo.
       77   define variable mWaitFramTextEnd            as character   no-undo.
       78   define variable mWaitFramView               as logical     no-undo.
       79   define variable mWaitProcEvent              as logical     no-undo init yes.
       80   define variable mWaitFramInterval           as integer     no-undo init 1 .
       81   define variable mWaitFramStop               as logical     no-undo.
       82   define variable mWaitFramStopUser           as logical     no-undo.
       83   define variable mWaitFramStopTimeOut        as logical     no-undo.
       84   define variable mWaitFramStartProc          as datetime-tz no-undo.
       85   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       86   define button B-WaitFramStop auto-end-key
       87        label "Стоп"
       88        size 10 by 1 tooltip "Остоновить процесс".
       89   define button B-viewProcInfo
       90        label "Информация"
       91        size 15 by 1 tooltip "Информация о процесс".
       92   define frame waitfram
       93     v-waitfram-action01 format "x(72)" no-label skip
       94     v-waitfram-action02 format "x(72)" no-label skip
       95     v-waitfram-action03 format "x(72)" no-label skip
       96     B-viewProcInfo
       97     B-WaitFramStop at row 4 col 30
       98     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       99     .
      100   define new global shared variable mBatchMode as logical no-undo init ?.
      101   define variable mFramBachModHandle as handle no-undo.
      102   mFramBachModHandle = frame waitfram:handle.
      103   define variable mFameOldVis as logical no-undo.
      104   define variable mVisCUrentVin as logical no-undo.
      105   if session:batch-mode
      106   then
      107      mBatchMode = yes.
      108   if mBatchMode = ? then do:
      109     mVisCUrentVin = current-window:visible.
      110     mFameOldVis = mFramBachModHandle:visible.
      111     mFramBachModHandle:visible  = yes.
      112     mBatchMode = mFramBachModHandle:visible ne yes.
      113     mFramBachModHandle:visible = mFameOldVis.
      114     current-window:visible = mVisCUrentVin.
      115   end.
      116    if  log-manager:logfile-name ne ?
      117     then DO:
      118         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      119         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      120         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      121     end.
      122   on choose of B-WaitFramStop in frame waitfram
      123   do:
      124     mWaitFramStop = yes.
      125     mWaitFramStopUser = yes.
      126   end.
      127   function waitfram-check-timeout returns logical():
      128      define variable vtime as int64 no-undo.
      129      if mWaitFramStopTimeOut
      130      then
      131         return yes.
      132      vtime = ( now - mWaitFramStartProc ) / 1000 .
      133      if     mWaitFramTimeOut ne ?
      134         and mWaitFramTimeOut ne 0
      135         and mWaitFramTimeOut lt vtime
      136      then do:
      137         mWaitFramStopTimeOut = yes.
      138      end.
      139      return mWaitFramStopTimeOut.
      140   end.
      141   procedure waitfram-hide :
      142     if not session:batch-mode
      143     then do
      144     on error undo, return error return-value
      145     :
      146       pause 0 before-hide .
      147       if not mBatchMode then
      148         hide frame waitfram .
      149     if     not mWaitFramView
      150        and mWaitProcEvent
      151     then
      152       process events .
      153     end.
      154   end procedure.
      155   procedure waitfram-show :
      156     define input  parameter p-message as character no-undo .
      157     define variable v-left-margin as integer   no-undo .
      158     if not session:batch-mode
      159     then do
      160     on error undo, return error return-value
      161     :
      162       if length(p-message) <= 70 then do:
      163         assign
      164           v-left-margin = integer((70 - length(p-message)) / 2)
      165         .
      166         assign
      167           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      168         .
      169         assign
      170           v-waitfram-action01 = " "
      171           v-waitfram-action02 = " "
      172                                    + fill(" ", v-left-margin)
      173                                    + p-message
      174           v-waitfram-action03 = " "
      175         .
      176       end.
      177       else do:
      178         define variable vRindex1 as integer no-undo.
      179         define variable vRindex2 as integer no-undo.
      180         vRindex1 = r-index(p-message," ",70).
      181         if vRindex1 = 0
      182         then
      183            vRindex1 = 70.
      184         if length(p-message)  <= vRindex1 + 70 then do:
      185           assign
      186             v-waitfram-action01 = " "
      187             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      189           .
      190         end.
      191         else do:
      192           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      193           if vRindex2 <= vRindex1
      194           then
      195              vRindex2 = vRindex1 + 70.
      196           assign
      197             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      199             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      200           .
      201         end.
      202       end.
      203       B-viewProcInfo:visible   in frame waitfram = no.
      204       B-viewProcInfo:sensitive in frame waitfram = no.
      205       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       if  (   mWaitFramView
      208          or  mWaitProcEvent)
      209          and not mBatchMode
      210       then
      211          display
      212             v-waitfram-action01 skip
      213             v-waitfram-action02 skip
      214             v-waitfram-action03 skip
      215          with frame waitfram .
      216       if     mWaitFramView
      217          then do:
      218             if     mWaitFramInterval ne ?
      219                and not mBatchMode
      220             then
      221                wait-for go of frame waitfram pause mWaitFramInterval.
      222          end.
      223          else
      224             if     mWaitProcEvent
      225                and not mBatchMode
      226             then
      227                process events .
      228     end.
      229   end procedure.
      230      procedure waitfram-show-this:
      231         define input  parameter iInterval as int64 no-undo.
      232         define variable vtime as int64 no-undo.
      233         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      234         mWaitFramInterval = iInterval.
      235         run waitfram-show (substitute("&1&2 &3&4" ,
      236                                       mWaitFramTextBeg ,
      237                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      238                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      239                                       mWaitFramTextEnd
      240                                      )
      241                           ).
      242      end.
      243      procedure WaitFramRunPause:
      244         define input  parameter iInterval as dec no-undo.
      245         define variable vStart  as datetime-tz no-undo.
      246         define variable vend    as datetime-tz no-undo.
      247         define variable vint as int64 no-undo.
      248         define variable vOk as logical no-undo.
      249         vStart = now.
      250         vend   = vStart.
      251         publish "WaitFramPause" (iInterval,output vOk).
      252         vend   =  now.
      253         vint = vend - vStart.
      254         vint = iInterval - vint / 1000.
      255         if     not mWaitFramStop
      256            and (   vint > 0
      257                 or (    not vOk
      258                     and iInterval eq ?
      259                     )
      260                 )
      261         then
      262            run waitfram-show-this (iInterval).
      263         vend   =  now.
      264         vint = vend - vStart.
      265         vint = iInterval - vint / 1000.
      266         if     not mWaitFramStop
      267            and vint > 0
      268         then do:
      269            run gbl/pause.p (vint * 1000).
      270         end.
      271         if iInterval ne ?
      272         then
      273            publish "WaitFramStop".
      274         waitfram-check-timeout().
      275      end.
      276      procedure WaitFramWaitFor:
      277         define input  parameter iInterval as dec no-undo.
      278         assign
      279            mWaitFramStartProc   = now
      280            mWaitFramStopUser    = no
      281            mWaitFramStopTimeOut = no
      282         .
      283         block-wait:
      284         do while not mWaitFramStop:
      285            run WaitFramRunPause (iInterval).
      286            if  waitfram-check-timeout()
      287            then do:
      288               leave block-wait.
      289            end.
      290         end.
      291         run waitfram-hide.
      292      end.
      293   procedure waitfram-join :
      294     define input  parameter p-line-1  as character no-undo .
      295     define input  parameter p-line-2  as character no-undo .
      296     define input  parameter p-line-3  as character no-undo .
      297     define output parameter p-message as character no-undo .
      298     do
      299     on error undo, return error return-value
      300     :
      301       assign
      302         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      305       .
      306     end.
      307   end procedure.
      308   function waitfram-join-function returns character
      309     (input p-line-1 as character
      310     ,input p-line-2 as character
      311     ,input p-line-3 as character
      312     ).
      313     define variable v-message as character no-undo .
      314     run waitfram-join in this-procedure
      315       (input  p-line-1
      316       ,input  p-line-2
      317       ,input  p-line-3
      318       ,output v-message
      319       ) .
      320     return v-message .
      321   end function .
      322   define new global shared variable g#language as character no-undo .
      323   if g#language <> '' and g#language <> 'rus':U then do:
      324     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      325   end.
      326   define new global shared variable g#library  as handle no-undo .
      327   define new global shared variable g#library2 as handle no-undo .
      328   procedure proc-alt-shift-f2:
      329     if not ibs.th.gbl.gbl-var:rcode
      330   then
      331     run gbl\inidebug.p .
      332   end.
      333   procedure proc-alt-shift-f3:
      334     run gbl/prvssinf.p
      335       ( input this-procedure
      336       ) .
      337   end.
      338   define variable v-inform-launched as logical no-undo initial false .
      339   procedure proc-alt-shift-f4:
      340     define variable v-action as character no-undo .
      341     if v-inform-launched = false then do:
      342       assign
      343         v-inform-launched = true
      344       .
      345       run gbl/d-inform.w
      346         (  input self
      347         ,  input this-procedure
      348         , output v-action
      349         ) no-error .
      350       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      351       assign
      352         v-inform-launched = false
      353       .
      354     end.
      355   end.
      356   procedure proc-alt-f1:
      357     run gbl/corrhelp.p
      358       (input this-procedure
      359       ) .
      360   end .
      361   on alt-shift-f2 anywhere do:
      362     run proc-alt-shift-f2.
      363   end.
      364   on alt-shift-f3 anywhere do:
      365     run proc-alt-shift-f3 in this-procedure .
      366   end.
      367   on alt-shift-f4 anywhere do:
      368     run proc-alt-shift-f4 in this-procedure.
      369   end.
      370   on alt-f1 anywhere do:
      371     run proc-alt-f1 in this-procedure .
      372   end.
      373   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374     define variable v-cntxt-db-num        as integer   no-undo .
      375     define variable v-cntxt-userid        as character no-undo .
      376     define variable v-cntxt-level         as character no-undo .
      377     define variable v-cntxt-host-code-obj as integer   no-undo .
      378     define variable v-cntxt-obj-type      as character no-undo .
      379     define variable v-cntxt-obj-code      as integer   no-undo .
      380     define variable v-cntxt-db-num-obj    as integer   no-undo .
      381     define variable v-cntxt-is-admin      as logical   no-undo .
      382   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   FUNCTION mark-string RETURNS CHARACTER
      384     ( input p-recid as recid, input mark-list as character  ) :
      385     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      386   END FUNCTION.
      387   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388   procedure gen-key-rec :
      389     define input  parameter p-tbl-name    as character no-undo.
      390     define input  parameter p-bh_tbl-name as handle    no-undo.
      391     define output parameter p-key-rec     as character no-undo.
      392     do
      393     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      394     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      395     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      396     :
      397       define variable fh               as handle    no-undo .
      398       define variable v-ok             as logical   no-undo .
      399       define variable v-inform         as character no-undo .
      400       define variable v-ind            as integer   no-undo .
      401       define variable v-idx-field-qnty as integer   no-undo .
      402       if p-tbl-name = ?
      403         or p-tbl-name = "":U
      404       then do:
      405         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      406       end.
      407       if not p-bh_tbl-name:available then do:
      408         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      409       end.
      410       assign
      411         p-key-rec = p-tbl-name
      412         v-inform  = p-bh_tbl-name:index-information(1)
      413         v-ind     = 2
      414       .
      415       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      416       on error undo, return error
      417       :
      418         assign
      419           v-inform = p-bh_tbl-name:index-information( v-ind )
      420           v-ind    = v-ind + 1
      421         .
      422       end.
      423       if v-inform = ?
      424         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      425         or entry( 3, v-inform, ",":U ) <> "1":U
      426       then do:
      427         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      428       end.
      429       else do:
      430         assign
      431           v-idx-field-qnty = num-entries( v-inform ) - 4
      432         .
      433         if v-idx-field-qnty < 2 then do:
      434           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      435         end.
      436         do v-ind = 1 to v-idx-field-qnty by 2
      437         on error undo, return error
      438         :
      439           assign
      440             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      441             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      442           .
      443         end.
      444       end.
      445       if p-key-rec = ? then do:
      446         assign
      447           p-key-rec = "":U
      448         .
      449         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      450       end.
      451     end.
      452     return.
      453   end procedure.
      454   procedure gen-where-keyr-tab :
      455     define input  parameter i-tableSerach as character no-undo.
      456     define input  parameter i-tablekey   as character  no-undo.
      457     define input  parameter p-key-rec    as character  no-undo.
      458     define input  parameter p-key-handle as handle     no-undo .
      459     define input  parameter p-db-name    as character  no-undo .
      460     define input  parameter p-tt-handle  as handle     no-undo .
      461     define output parameter o-Where      as character  no-undo.
      462     do
      463     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      464     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      465     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      466     :
      467       define variable v-full-tbl-name  as character no-undo .
      468       define variable bh_tbl-name      as handle    no-undo .
      469       define variable fh_key           as handle    no-undo .
      470       define variable fh_search        as handle    no-undo .
      471       define variable v-field-num      as integer   no-undo .
      472       define variable v-count-fld      as integer   no-undo .
      473       define variable v-inform         as character no-undo .
      474       define variable v-ind            as integer   no-undo .
      475       define variable v-idx-field-qnty as integer   no-undo .
      476       define variable v-field-name     as character no-undo .
      477       define variable v-field-val      as character no-undo .
      478       define variable v-word-link      as character no-undo .
      479       define variable vTable           as character no-undo.
      480       define variable bh_tbl-key       as handle    no-undo .
      481       assign
      482         p-key-rec = trim( p-key-rec )
      483       .
      484       if p-key-handle <> ? then do:
      485         if not valid-handle(p-key-handle)
      486            or p-key-handle:type <> "buffer"
      487         then do:
      488           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      489         end.
      490         if num-entries( p-key-rec, chr(3) ) > 1
      491           or p-key-rec = ?
      492           or p-key-rec = "":U
      493         then do:
      494           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      495         end.
      496       end.
      497       else do:
      498         if p-key-rec = ?
      499           or p-key-rec = "":U
      500         then do:
      501           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      502         end.
      503       end.
      504       assign
      505         vTable = entry( 1 , p-key-rec, chr(3) )
      506       .
      507       if p-tt-handle <> ?
      508         and ( not valid-handle(p-tt-handle)
      509               or p-tt-handle:type <> "buffer"
      510             )
      511       then do:
      512         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      513       end.
      514       if p-tt-handle = ? then do:
      515         assign
      516           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      517         .
      518         create buffer bh_tbl-name for table v-full-tbl-name .
      519       end.
      520       else do:
      521         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      522       end.
      523       assign
      524         v-inform = bh_tbl-name:index-information(1)
      525         v-ind    = 2
      526       .
      527       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      528       on error undo, return error
      529       :
      530         assign
      531           v-inform = bh_tbl-name:index-information( v-ind )
      532           v-ind    = v-ind + 1
      533         .
      534       end.
      535       if v-inform = ?
      536         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      537         or entry( 3, v-inform, ",":U ) <> "1":U
      538       then do:
      539         delete object bh_tbl-name no-error.
      540         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      541       end.
      542       assign
      543         v-idx-field-qnty = num-entries( v-inform ) - 4
      544       .
      545       if v-idx-field-qnty < 2 then do:
      546         delete object bh_tbl-name no-error.
      547         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      548       end.
      549       assign
      550         o-where     = "where":U
      551         v-word-link = "":U
      552         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      553         v-count-fld = 0
      554       .
      555       if i-tablekey ne "" and i-tablekey ne ?
      556       then do:
      557         assign
      558           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      559         .
      560         create buffer bh_tbl-key for table v-full-tbl-name .
      561       end.
      562       if i-tableSerach ne "" and i-tableSerach ne ?
      563       then do:
      564         delete object bh_tbl-name no-error.
      565         assign
      566           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      567         .
      568         create buffer bh_tbl-name for table v-full-tbl-name .
      569       end.
      570       block_where:
      571       do v-ind = 1 to v-idx-field-qnty by 2
      572       on error undo, return error
      573       :
      574         assign
      575           v-count-fld = v-count-fld + 1
      576         .
      577         if p-key-handle = ?
      578           and v-count-fld > v-field-num
      579         then do:
      580           leave block_where.
      581         end.
      582         define variable VfieldKeyTable as handle no-undo.
      583         assign
      584           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      585           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      586         .
      587         if     bh_tbl-key ne ?
      588         then do:
      589            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      590            if VfieldKeyTable eq ?
      591            then next block_where.
      592         end.
      593         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      594         then
      595            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      596         else
      597            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      598         if p-key-handle = ? then do:
      599           assign
      600             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      601           .
      602         end.
      603         else do:
      604           assign
      605             fh_key = p-key-handle:buffer-field( v-field-name )
      606           .
      607           if fh_key = ?
      608             or not valid-handle( fh_key )
      609           then do:
      610             delete object bh_tbl-name.
      611             if     bh_tbl-key ne ?
      612             then
      613                delete object bh_tbl-key.
      614             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      615           end.
      616           assign
      617             v-field-val = fh_key:buffer-value
      618           .
      619         end.
      620         if fh_search:data-type ="character":U then do:
      621           assign
      622             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      623             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      624             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      625             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      626             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      627             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      628             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      629             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      630             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      631             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      632             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      633             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      634             v-field-val = substitute( '"&1"', v-field-val )
      635           .
      636         end.
      637         assign
      638           o-where = substitute( "&1 &2", o-where, v-field-val )
      639         .
      640         if v-word-link = "":U then do:
      641           assign
      642             v-word-link = "and":U
      643           .
      644         end.
      645       end.
      646       delete object bh_tbl-name.
      647       if     bh_tbl-key ne ?
      648       then
      649          delete object bh_tbl-key.
      650       if p-key-handle = ?
      651         and v-count-fld <> v-field-num
      652       then do:
      653         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      654       end.
      655     end.
      656   end procedure.
      657   procedure gen-hn-keyr-tab :
      658     define input  parameter i-tableSerach as character no-undo.
      659     define input  parameter i-tablekey   as character no-undo.
      660     define input  parameter p-key-rec    as character no-undo.
      661     define input  parameter p-key-handle as handle    no-undo .
      662     define input  parameter p-db-name    as character no-undo .
      663     define input  parameter p-tt-handle  as handle    no-undo .
      664     define input  parameter p-stts-lock  as integer   no-undo .
      665     define output parameter o-hn         as handle    no-undo.
      666     define variable v-full-tbl-name as character no-undo.
      667     define variable v-where         as character no-undo.
      668     define variable bh_tbl-name     as handle    no-undo.
      669     define variable vTable          as character no-undo.
      670     do
      671     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      672     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      673     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      674         run gen-where-keyr-tab(i-tableSerach,
      675                                i-tablekey,
      676                                p-key-rec,
      677                                p-key-handle,
      678                                p-db-name,
      679                                p-tt-handle,
      680                                output v-where).
      681         if i-tableSerach ne "" and i-tableSerach ne ?
      682         then do:
      683            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      684            create buffer bh_tbl-name for table v-full-tbl-name .
      685         end.
      686         else do:
      687            if p-tt-handle = ? then do:
      688               assign
      689                  vTable = entry( 1 , p-key-rec, chr(3) )
      690               .
      691               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      692               create buffer bh_tbl-name for table v-full-tbl-name .
      693            end.
      694            else do:
      695               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      696            end.
      697         end.
      698         if p-tt-handle = ? then do:
      699            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      700         end.
      701         else do:
      702            bh_tbl-name:find-first( v-where ) no-error .
      703         end.
      704         o-hn = bh_tbl-name.
      705      end.
      706   end procedure.
      707   procedure gen-hn-keyr :
      708     define input  parameter p-key-rec    as character no-undo.
      709     define input  parameter p-key-handle as handle    no-undo .
      710     define input  parameter p-db-name    as character no-undo .
      711     define input  parameter p-tt-handle  as handle    no-undo .
      712     define input  parameter p-stts-lock  as integer   no-undo .
      713     define output parameter o-hn         as handle    no-undo.
      714     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      715   end.
      716   procedure gen-row-keyr :
      717     define input  parameter p-key-rec    as character no-undo.
      718     define input  parameter p-key-handle as handle    no-undo .
      719     define input  parameter p-db-name    as character no-undo .
      720     define input  parameter p-tt-handle  as handle    no-undo .
      721     define input  parameter p-stts-lock  as integer   no-undo .
      722     define output parameter p-tbl-row    as rowid     no-undo.
      723     define output parameter p-tbl-name   as character no-undo.
      724     define variable vHn as handle no-undo.
      725       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      726       p-tbl-row = if vHn:available then vHn:rowid else ?.
      727       p-tbl-name =  vHn:table.
      728       delete object vHn no-error.
      729     if p-tbl-row = ? then do:
      730       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      731     end.
      732     else do:
      733       return.
      734     end.
      735   end procedure.
      736   procedure gen-key-fv :
      737     define input  parameter p-key-rec    as character no-undo .
      738     define output parameter p-field-list as character no-undo .
      739     define output parameter p-value-list as character no-undo.
      740     do
      741     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      742     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      743     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      744     :
      745       define variable v-full-tbl-name  as character no-undo .
      746       define variable bh_tbl-name      as handle    no-undo .
      747       define variable v-tbl-name       as character no-undo .
      748       define variable v-field-num      as integer   no-undo .
      749       define variable v-count-fld      as integer   no-undo .
      750       define variable v-inform         as character no-undo .
      751       define variable v-ind            as integer   no-undo .
      752       define variable v-idx-field-qnty as integer   no-undo .
      753       define variable v-delim-key      as character no-undo .
      754       if p-key-rec = ?
      755         or p-key-rec = "":U
      756       then do:
      757         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      758       end.
      759       assign
      760         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      761         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      762       .
      763       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      764       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      765       assign
      766         v-inform = bh_tbl-name:index-information(1)
      767         v-ind    = 2
      768       .
      769       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      770       on error undo, return error
      771       :
      772         assign
      773           v-inform = bh_tbl-name:index-information( v-ind )
      774           v-ind    = v-ind + 1
      775         .
      776       end.
      777       if v-inform = ?
      778         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      779         or entry( 3, v-inform, ",":U ) <> "1":U
      780       then do:
      781         delete object bh_tbl-name no-error.
      782         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      783       end.
      784       assign
      785         v-idx-field-qnty = num-entries( v-inform ) - 4
      786       .
      787       if v-idx-field-qnty < 2 then do:
      788         delete object bh_tbl-name no-error.
      789         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      790       end.
      791       assign
      792         p-field-list = "":U
      793         p-value-list = "":U
      794         v-delim-key  = "":U
      795         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      796         v-count-fld  = 0
      797       .
      798       block_where:
      799       do v-ind = 1 to v-idx-field-qnty by 2
      800       on error undo, return error
      801       :
      802         assign
      803           v-count-fld = v-count-fld + 1
      804         .
      805         if v-count-fld > v-field-num then do:
      806           leave block_where.
      807         end.
      808         assign
      809           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      810           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      811         .
      812         if v-ind = 1 then do:
      813           assign
      814             v-delim-key = chr(3)
      815           .
      816         end.
      817       end.
      818       delete object bh_tbl-name.
      819       if v-count-fld <> v-field-num then do:
      820         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      821       end.
      822     end.
      823   end procedure.
      824   procedure gen-key-field :
      825     define input  parameter p-table      as character no-undo .
      826     define output parameter p-field-list as character no-undo .
      827     do
      828     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      829     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      830     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      831     :
      832       define variable v-full-tbl-name  as character no-undo .
      833       define variable bh_tbl-name      as handle    no-undo .
      834       define variable v-tbl-name       as character no-undo .
      835       define variable v-field-num      as integer   no-undo .
      836       define variable v-count-fld      as integer   no-undo .
      837       define variable v-inform         as character no-undo .
      838       define variable v-ind            as integer   no-undo .
      839       define variable v-idx-field-qnty as integer   no-undo .
      840       define variable v-delim-key      as character no-undo .
      841       if p-table = ?
      842         or p-table = "":U
      843       then do:
      844         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      845       end.
      846       assign
      847         v-tbl-name      = p-table
      848         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      849       .
      850       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      851       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      852       assign
      853         v-inform = bh_tbl-name:index-information(1)
      854         v-ind    = 2
      855       .
      856       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      857       on error undo, return error
      858       :
      859         assign
      860           v-inform = bh_tbl-name:index-information( v-ind )
      861           v-ind    = v-ind + 1
      862         .
      863       end.
      864       if v-inform = ?
      865         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      866         or entry( 3, v-inform, ",":U ) <> "1":U
      867       then do:
      868         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      869       end.
      870       assign
      871         v-idx-field-qnty = num-entries( v-inform ) - 4
      872       .
      873       if v-idx-field-qnty < 2 then do:
      874         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      875       end.
      876       assign
      877         p-field-list = "":U
      878         v-delim-key  = "":U
      879         v-count-fld  = 0
      880       .
      881       block_where:
      882       do v-ind = 1 to v-idx-field-qnty by 2
      883       on error undo, return error
      884       :
      885         assign
      886           v-count-fld = v-count-fld + 1
      887         .
      888         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      889         if v-ind = 1 then do:
      890           assign
      891             v-delim-key = chr(3)
      892           .
      893         end.
      894       end.
      895       delete object bh_tbl-name.
      896     end.
      897   end procedure.
      898   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      899   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      901   FUNCTION get-region RETURNS CHARACTER
      902     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      903     define variable par-region as character no-undo.
      904     if parhost-code = 0 and
      905          parobj-type = "":U and
      906          parobj-code = 0 then do:
      907          par-region = "Глобально".
      908          return par-region.
      909       end.
      910       if parobj-type = 'орг':U then do:
      911          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      912          return par-region.
      913       end.
      914       if parobj-type = 'регион':U
      915       then do:
      916          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      917          return par-region.
      918       end.
      919       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      920       return par-region.
      921   END FUNCTION.
      922   FUNCTION get-objregion RETURNS CHARACTER
      923     (  input parobj-type as character, input parobj-code as integer ) :
      924     define variable par-region as character no-undo.
      925     if  parobj-type = "":U and
      926         parobj-code = 0
      927     then do:
      928        par-region = "Глобально".
      929     end.
      930     else if parobj-type = 'орг':U
      931     then do:
      932        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      933     end.
      934     else if parobj-type = 'регион':U
      935     then do:
      936        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      937     end.
      938     else
      939        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      940     return par-region.
      941   END FUNCTION.
      942   FUNCTION calldscr returns character ( input p-call-id as character):
      943   define variable v-descr as character no-undo .
      944   define variable v-field-list as character no-undo .
      945   define variable v-value-list as character no-undo.
      946   define variable v-prop-label as character no-undo .
      947   define variable v-node-label as character no-undo .
      948   define variable v-dt-code as integer no-undo .
      949   define variable v-host-code as integer no-undo .
      950   define variable v-obj-type as character no-undo .
      951   define variable v-obj-code as integer no-undo .
      952   define variable v-label as character no-undo .
      953   define variable v-node-code as integer no-undo .
      954   define buffer buf_prop-head for ub.prop-head.
      955   define buffer buf_prop-ref for ub.prop-ref.
      956   define buffer buf_prop-map for ub.prop-map.
      957   run gen-key-fv in this-procedure ( input p-call-id
      958                                     ,output v-field-list
      959                                     ,output v-value-list) no-error .
      960   if error-status:error then return p-call-id.
      961   CASE entry(1, p-call-id, chr(3)):
      962     when 'dis-card-type':U then do:
      963       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      964                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      965                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      966                            ).
      967     end.
      968     when 'dis-card':U then do:
      969       v-descr = substitute("ДК: № &1"
      970                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      971                            ).
      972     end.
      973     when 'dis-card-property':U then do:
      974       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      975       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      976       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      977       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      978       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      979       find first buf_prop-ref no-lock where
      980                 buf_prop-ref.dt-code = v-dt-code no-error .
      981       if available buf_prop-ref then do:
      982         find first buf_prop-head no-lock where
      983                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      984         v-prop-label = buf_prop-head.prop-label.
      985         find first buf_prop-map no-lock where
      986                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      987               and buf_prop-map.node-code = v-node-code no-error .
      988         if available buf_prop-map then do:
      989           v-label = buf_prop-map.node-label.
      990         end.
      991       end.
      992       v-descr = substitute("ДК: № &1 &2:&3 &4"
      993                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      994                            ,v-prop-label
      995                            ,v-label
      996                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      997                            ).
      998     end.
      999     when 'clients':U then do:
     1000       v-descr = substitute("&1&2"
     1001                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1002                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1003                            ).
     1004     end.
     1005     when 'ext-system':U then do:
     1006       v-descr = substitute("Внешняя система &1"
     1007                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1008                            ).
     1009     end.
     1010     WHEN 'thbj-attr':U then do:
     1011       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1012       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1013       then do:
     1014         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1015           v-descr = "Операции с товарами".
     1016         end.
     1017         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1018           v-descr = "Операции с клиентами".
     1019         end.
     1020         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1021           v-descr = "Операции с группами товаров".
     1022         end.
     1023         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1024           v-descr = "Операции с группами клиентов".
     1025         end.
     1026         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1027           v-descr = "Операции с чеками на POS IBS-TH".
     1028         end.
     1029         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1030           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1031         end.
     1032         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1033           v-descr = "Операции в системе электронного документооборота".
     1034         end.
     1035         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1036           v-descr = "Операции со справочниками".
     1037         end.
     1038         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1039           v-descr = "Операции с ДНЦ и переоценками".
     1040         end.
     1041         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1042           v-descr = "Отчеты".
     1043         end.
     1044         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1045           v-descr = "Операции с заказами".
     1046         end.
     1047       end.
     1048     end.
     1049     when 'cash-desk':U then do:
     1050       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1051                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1052                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1053                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1054                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1055                            ).
     1056     end.
     1057     when 'ext-file':U then do:
     1058       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1059                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1060                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1061                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1062                            ).
     1063     end.
     1064   end case.
     1065   return v-descr.
     1066   end function.
     1067   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1068   define variable c-point  as character no-undo .
     1069   define variable tbl      as character no-undo .
     1070   define variable join-tbl as character no-undo .
     1071   define variable fld      as character no-undo .
     1072   define variable lab      as character no-undo .
     1073   define variable spr      as character no-undo .
     1074   define variable dim      as character no-undo .
     1075   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1076   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1077   procedure fltopend_fltopend :
     1078   define input parameter p-parent-handle as handle no-undo .
     1079   define input parameter p-qh as handle no-undo .
     1080   define input parameter p-flt-open-open-query  as character no-undo .
     1081   define input parameter p-where-cond as character no-undo .
     1082   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1083   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1084   define input parameter p-indexed-reposition as character no-undo .
     1085     do
     1086     on error undo, return error
     1087     :
     1088   define variable v-prepare-string as character no-undo .
     1089   define variable glog as logical no-undo .
     1090   assign
     1091   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1092                      p-where-cond + chr(32)  +
     1093                      p-use-indFIRST-query-tail + chr(32) +
     1094                      p-use-ind-sort-clmn-by + chr(32) +
     1095                      p-indexed-reposition
     1096   .
     1097   assign
     1098   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1099   if not glog
     1100   or error-status:error then do:
     1101     message error-status:get-message(1) view-as alert-box .
     1102     undo, return error .
     1103   end.
     1104   assign
     1105   glog = p-qh:query-open no-error .
     1106   if not glog
     1107   or error-status:error then do:
     1108     message error-status:get-message(1) view-as alert-box .
     1109     undo, return error .
     1110   end.
     1111     end.
     1112   end procedure.
     1113   procedure fltopend_fltfindd :
     1114   define input parameter p-parent-handle as handle no-undo .
     1115   define input parameter p-qh as handle no-undo .
     1116   define input parameter p-rowid as rowid no-undo .
     1117   define input parameter p-next as logical no-undo .
     1118   define input parameter p-lock as integer no-undo .
     1119   define input parameter p-bh as handle no-undo .
     1120   define input parameter p-where-cond as character no-undo .
     1121   define input parameter p-use-index-phrase as character no-undo .
     1122   define variable glog as logical no-undo .
     1123   define variable v-qh as handle no-undo .
     1124   define variable v-bh as handle no-undo .
     1125   define variable v-recid as recid no-undo .
     1126   define variable v-prepare-string as character no-undo .
     1127   do
     1128   on error undo, return error
     1129   on stop undo, return error
     1130   :
     1131     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1132     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1133     create query v-qh.
     1134     v-qh:set-buffers(v-bh).
     1135     v-prepare-string = substitute("for each &1 &2 &3"
     1136                                     ,v-bh:name
     1137                                     ,p-where-cond
     1138                                     ,p-use-index-phrase).
     1139     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1140     if not glog then do:
     1141       delete object v-qh.
     1142       delete object v-bh.
     1143       undo, return error .
     1144     end.
     1145     glog = v-qh:query-open no-error .
     1146     if not glog then do:
     1147       delete object v-qh.
     1148       delete object v-bh.
     1149       undo, return error .
     1150     end.
     1151     if p-next then do:
     1152       v-qh:reposition-to-rowid(p-rowid) no-error .
     1153       glog = v-qh:get-next( p-lock) no-error .
     1154       glog = v-qh:get-next( p-lock) no-error .
     1155       if not glog or v-qh:query-off-end = yes then do:
     1156         glog = v-qh:get-first( p-lock) no-error .
     1157       end.
     1158     end.
     1159     else do:
     1160       glog = v-qh:get-first( p-lock) no-error .
     1161     end.
     1162     v-recid = v-bh:recid no-error .
     1163     delete object v-qh.
     1164     delete object v-bh.
     1165     return string(v-recid) .
     1166   end.
     1167   end procedure.
     1168   procedure fltopend_fltfindq :
     1169   define input parameter p-parent-handle as handle no-undo .
     1170   define input parameter p-qh as handle no-undo .
     1171   define input parameter p-next as logical no-undo .
     1172   define input parameter p-lock as integer no-undo .
     1173   define input parameter p-flt-open-open-query  as character no-undo .
     1174   define input parameter p-where-cond as character no-undo .
     1175   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1176   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1177   define input parameter p-indexed-reposition as character no-undo .
     1178   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1179   define variable glog as logical no-undo .
     1180   define variable v-qh as handle no-undo .
     1181   define variable v-bh as handle no-undo extent 18.
     1182   define variable v-rowid as rowid no-undo extent 18.
     1183   define variable v-ii as integer no-undo .
     1184   define variable v-prepare-string as character no-undo .
     1185   do
     1186   on error undo, return error
     1187   on stop undo, return error
     1188   :
     1189     create query v-qh.
     1190     do v-ii = 1 to p-qh:num-buffers:
     1191       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1192       assign
     1193       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1194       no-error.
     1195       v-qh:add-buffer(v-bh[v-ii]).
     1196     end.
     1197     assign
     1198     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1199                       p-where-cond + chr(32)  +
     1200                       p-use-indFIRST-query-tail + chr(32) +
     1201                       p-use-ind-sort-clmn-by + chr(32) +
     1202                       p-indexed-reposition
     1203     .
     1204     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1205     if not glog then do:
     1206       delete object v-qh.
     1207       do v-ii = 1 to p-qh:num-buffers:
     1208         delete object v-bh[v-ii].
     1209       end.
     1210       undo, return error .
     1211     end.
     1212     glog = v-qh:query-open no-error .
     1213     if not glog then do:
     1214       delete object v-qh.
     1215       do v-ii = 1 to p-qh:num-buffers:
     1216         delete object v-bh[v-ii].
     1217       end.
     1218       undo, return error .
     1219     end.
     1220     if p-next then do:
     1221       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1222       glog = v-qh:get-next( p-lock) no-error .
     1223       glog = v-qh:get-next( p-lock) no-error .
     1224       if not glog or v-qh:query-off-end = yes then do:
     1225         glog = v-qh:get-first( p-lock) no-error .
     1226       end.
     1227     end.
     1228     else do:
     1229       glog = v-qh:get-first( p-lock) no-error .
     1230     end.
     1231     do v-ii = 1 to p-qh:num-buffers:
     1232       assign
     1233       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1234       no-error.
     1235     end.
     1236     delete object v-qh.
     1237     do v-ii = 1 to p-qh:num-buffers:
     1238       delete object v-bh[v-ii].
     1239     end.
     1240   end.
     1241   end procedure.
     1242   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1243   FUNCTION proprefd_sum-id-des RETURNS CHARACTER
     1244     ( INPUT p-sum-id AS CHARACTER, INPUT p-ref-type AS CHARACTER ) :
     1245   CASE p-ref-type:
     1246       WHEN 'one-ptrl':U THEN DO:
     1247          DEFINE BUFFER buf_goods FOR ub.goods.
     1248          FIND FIRST buf_goods NO-LOCK WHERE
     1249                    buf_goods.gds-code = integer(ENTRY(2, p-sum-id, "-")) NO-ERROR.
     1250          IF NOT AVAILABLE buf_goods  THEN DO:
     1251              RETURN "Неизвестное топливо".
     1252          END.
     1253          RETURN buf_goods.gds-name.
     1254       END.
     1255       OTHERWISE DO:
     1256          RETURN "".
     1257       END.
     1258   END CASE.
     1259   END FUNCTION.
     1260   FUNCTION proprefd_sum-id-des2 RETURNS CHARACTER
     1261     ( INPUT p-sum-id AS CHARACTER, INPUT p-ref-type AS CHARACTER ) :
     1262   CASE p-ref-type:
     1263       WHEN 'one-ptrl':U THEN DO:
     1264          DEFINE BUFFER buf_goods FOR ub.goods.
     1265          FIND FIRST buf_goods NO-LOCK WHERE
     1266                    buf_goods.gds-code = integer(ENTRY(2, p-sum-id, "-")) NO-ERROR.
     1267          IF NOT AVAILABLE buf_goods  THEN DO:
     1268              RETURN "Неизвестное топливо".
     1269          END.
     1270          RETURN buf_goods.gds-name.
     1271       END.
     1272       OTHERWISE DO:
     1273          RETURN p-sum-id.
     1274       END.
     1275   END CASE.
     1276   END FUNCTION.
     1277   DEFINE VARIABLE ri AS RECID NO-UNDO.
     1278   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1279   define variable sort-column-name as character no-undo .
     1280   DEFINE VARIABLE template-recid AS RECID NO-UNDO.
     1281   define variable v-doc-rec as recid no-undo .
     1282   define variable filter-point as character no-undo .
     1283   FUNCTION get-dtm-name RETURNS CHARACTER
     1284     ( INPUT p-dtm-code AS integer )  FORWARD.
     1285   DEFINE BUTTON b-add
     1286        LABEL "&Добавить"
     1287        SIZE 10 BY 1.
     1288   DEFINE BUTTON b-chg
     1289        LABEL "&Изменить"
     1290        SIZE 10 BY 1.
     1291   DEFINE BUTTON b-del
     1292        LABEL "&Удалить"
     1293        SIZE 10 BY 1.
     1294   DEFINE BUTTON B-Help
     1295        LABEL "Помо&щь"
     1296        SIZE 3 BY 1
     1297        BGCOLOR 8 .
     1298   DEFINE BUTTON B-mark
     1299        LABEL "*"
     1300        SIZE 3 BY 1.
     1301   DEFINE BUTTON B-quit AUTO-END-KEY
     1302        LABEL "&Выход"
     1303        SIZE 10 BY 1
     1304        BGCOLOR 8 .
     1305   DEFINE BUTTON B-sel AUTO-GO
     1306        LABEL "Вы&бор"
     1307        SIZE 10 BY 1.
     1308   DEFINE BUTTON b-use
     1309        LABEL "Используют"
     1310        SIZE 15 BY 1.
     1311   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>9":U INITIAL 0
     1312         VIEW-AS TEXT
     1313        SIZE 9.88 BY 1 NO-UNDO.
     1314   DEFINE QUERY br-prop-ref FOR
     1315         X_prop-ref,
     1316         X_prop-head,
     1317         X_prop-ref-call SCROLLING.
     1318   DEFINE BROWSE br-prop-ref
     1319     QUERY br-prop-ref NO-LOCK DISPLAY
     1320         mark-string(recid(X_prop-ref), v-rid-list) COLUMN-LABEL '*' FORMAT "X(1)":U
     1321   X_prop-ref.sum-id COLUMN-LABEL 'Идентификатор!итога' FORMAT "X(21)":U WIDTH 22
     1322   X_prop-ref.dt-code COLUMN-LABEL 'Код!итога' FORMAT ">>>>>>>>9":U WIDTH 9
     1323   X_prop-ref.dtm-code COLUMN-LABEL 'Код!объекта!операнда' FORMAT ">>9" WIDTH 9
     1324   get-dtm-name( INPUT X_prop-ref.dtm-code) COLUMN-LABEL 'Код-операнд' FORMAT "X(255)" WIDTH 35
     1325   proprefd_sum-id-des(X_prop-ref.sum-id, X_prop-ref.ref-type) COLUMN-LABEL 'Описание' FORMAT "X(255)" WIDTH 30
     1326   X_prop-ref.caller_id COLUMN-LABEL 'Доп!идентификатор' FORMAT "X(20)":U
     1327   calldscr(X_prop-ref-call.CALL_id) COLUMN-LABEL 'Задействован' FORMAT "X(50)":U
     1328   ENABLE
     1329   X_prop-ref.sum-id
     1330       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16 FIT-LAST-COLUMN.
     1331   DEFINE FRAME Dialog-Frame
     1332        B-quit AT ROW 1 COL 1
     1333        B-mark AT ROW 1 COL 11
     1334        B-sel AT ROW 1 COL 14
     1335        b-add AT ROW 1 COL 31 WIDGET-ID 2
     1336        b-chg AT ROW 1 COL 41 WIDGET-ID 4
     1337        b-del AT ROW 1 COL 51 WIDGET-ID 6
     1338        b-use AT ROW 1 COL 61 WIDGET-ID 8
     1339        B-Help AT ROW 1 COL 95
     1340        br-prop-ref AT ROW 3 COL 1
     1341        mark-num AT ROW 2 COL 2.88 NO-LABEL
     1342        SPACE(86.24) SKIP(16.49)
     1343       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1344            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1345            TITLE ""
     1346            DEFAULT-BUTTON B-quit.
     1347   ASSIGN
     1348          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1349          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1350   ASSIGN
     1351          b-chg:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1352   ON GO OF FRAME Dialog-Frame
     1353   DO:
     1354     p-rid-list = v-rid-list.
     1355   END.
     1356   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1357   DO:
     1358     APPLY "END-ERROR":U TO SELF.
     1359   END.
     1360   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1361   DO:
     1362     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1363     define variable glog as logical no-undo .
     1364   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1365   do:
     1366     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1367       (input  v-cntxt-db-num
     1368       ,input  v-cntxt-userid
     1369       ,input  0
     1370       ,input  'actn_prop-ref_work':U
     1371       ,input  'global':U
     1372       ,input  0
     1373       ,input  '':U
     1374       ,input  0
     1375       ,input  0
     1376       ,input  0
     1377       ,input  0
     1378       ,input  true
     1379       ,output glog
     1380       )  .
     1381   end.
     1382     if not glog then return no-apply.
     1383     run rul/prop-ref-i.w ( INPUT parparentproc
     1384                            ,INPUT 'ДОБАВЛЕНИЕ':U
     1385                            ,INPUT (if p-list-mode = "dtm-code"
     1386                                    then p-dtm-code
     1387                                    else 0)
     1388                            ,input 0
     1389                            ,INPUT p-call-id
     1390                            ,INPUT-OUTPUT v-rec) NO-ERROR.
     1391     IF v-rec <> ? THEN DO:
     1392         RUN openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     1393         REPOSITION br-prop-ref TO RECID v-rec NO-ERROR.
     1394         APPLY "entry" TO br-prop-ref.
     1395     END.
     1396   END.
     1397   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1398   DO:
     1399     IF NOT AVAILABLE X_prop-ref THEN RETURN NO-APPLY.
     1400     DEFINE variable glog as logical no-undo .
     1401   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   do:
     1403     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1404       (input  v-cntxt-db-num
     1405       ,input  v-cntxt-userid
     1406       ,input  0
     1407       ,input  'actn_prop-ref_work':U
     1408       ,input  'global':U
     1409       ,input  0
     1410       ,input  '':U
     1411       ,input  0
     1412       ,input  0
     1413       ,input  0
     1414       ,input  0
     1415       ,input  true
     1416       ,output glog
     1417       )  .
     1418   end.
     1419     if not glog then return no-apply.
     1420     run rul/prop-ref3.p ( INPUT NO
     1421                          ,INPUT recid(X_prop-ref)) NO-ERROR.
     1422     IF error-status:error THEN RETURN NO-APPLY.
     1423     RUN openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     1424     APPLY "entry" TO br-prop-ref.
     1425   END.
     1426   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1427   DO:
     1428   DEFINE VARIABLE loc#log as logical no-undo.
     1429       if available X_prop-ref then do:
     1430   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1431   define variable v-str-recid14 as character no-undo .
     1432   define variable v-num-entry14 as integer   no-undo .
     1433   assign
     1434     v-str-recid14 = trim( string( recid( X_prop-ref ) , "->>>>>>>>>>>9":U ) )
     1435     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1436   .
     1437   if v-num-entry14 > 0 then do:
     1438     assign
     1439       entry( v-num-entry14, v-rid-list ) = "":U
     1440       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1441     .
     1442   end.
     1443   else do:
     1444     assign
     1445       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1446     .
     1447   end.
     1448         loc#log = br-prop-ref:refresh() .
     1449         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1450             loc#log = br-prop-ref:select-next-row ().
     1451             apply "iteration-changed" to br-prop-ref in frame Dialog-Frame.
     1452         end.
     1453         if num-entries( v-rid-list ) = 0
     1454         then
     1455             hide mark-num in frame Dialog-Frame.
     1456         else
     1457             disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1458       end.
     1459       apply "entry" to br-prop-ref in frame Dialog-Frame.
     1460   END.
     1461   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1462   DO:
     1463     if available X_prop-ref then do:
     1464       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1465       then  v-rid-list = string( recid( X_prop-ref ) ) .
     1466     end.
     1467     else do:
     1468       bell.
     1469       return no-apply.
     1470     end.
     1471   END.
     1472   ON CHOOSE OF b-use IN FRAME Dialog-Frame
     1473   DO:
     1474     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1475     IF NOT AVAILABLE X_prop-ref THEN RETURN NO-APPLY.
     1476   run ref/proprefs.w ( INPUT parparentproc
     1477                     ,INPUT ""
     1478                     ,INPUT 'prop-ref-call':U
     1479                     ,INPUT X_prop-ref.dtm-code
     1480                     ,input X_prop-ref.sum-id
     1481                     ,INPUT X_prop-ref.caller_id
     1482                     ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1483   END.
     1484   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1485   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1486   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1487   on help of frame Dialog-Frame
     1488   do:
     1489     run gbl/app_help.p
     1490       (input this-procedure :file-name
     1491       ,input ''
     1492       ,input ?
     1493       ) no-error.
     1494     if error-status :error then do:
     1495       message
     1496         "Ошибка при вызове помощи"
     1497         error-status :get-message(1)
     1498         view-as alert-box .
     1499     end.
     1500   end.
     1501   run minbtn-set in this-procedure .
     1502   on choose of b-help in frame Dialog-Frame
     1503   do:
     1504     apply "help":u to frame Dialog-Frame .
     1505   end.
     1506   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1507   procedure minbtn-set :
     1508       do
     1509           on error undo, return error return-value
     1510           :
     1511           define variable ii              as integer       no-undo .
     1512           define variable fh              as widget-handle no-undo .
     1513           define variable hh              as widget-handle no-undo .
     1514           define variable v-h             as handle        extent 4 no-undo .
     1515           define variable v-name-button   as character     no-undo .
     1516           define variable v-help-old-x    as decimal       no-undo .
     1517           define variable v-help-old-y    as decimal       no-undo .
     1518           define variable v-help-old-size as decimal       no-undo .
     1519           define variable v-frame-width   as decimal       no-undo .
     1520           define variable jj              as integer       no-undo .
     1521           do
     1522               on error undo, return error
     1523               :
     1524               assign
     1525                   v-frame-width = frame Dialog-Frame:width - 0.3
     1526                   fh            = frame Dialog-Frame:first-child
     1527                   hh            = fh:first-child
     1528                   ii            = 1
     1529                   .
     1530               do while valid-handle(hh):
     1531                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1532                   do:
     1533                       case lc(hh:name) :
     1534                           when "b-help" then
     1535                               do:
     1536                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1537                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1538                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1539                                   hh:TOOLTIP = "Помощь" .
     1540                                   v-help-old-x = hh:column .
     1541                                   v-help-old-y = hh:row    .
     1542                                   v-help-old-size = hh:width .
     1543                                   hh:width-chars = 2.5 .
     1544                               end.
     1545                           when "b-print" then
     1546                               do:
     1547                                   hh:load-image("cmp/b-print.bmp":u) .
     1548                                   hh:TOOLTIP = "Печать" .
     1549                                   v-h[ii] = hh:handle .
     1550                                   ii = ii + 1 .
     1551                                   hh:width-chars = 3 .
     1552                               end.
     1553                           when "b-history" or
     1554                           when "b-hist" then
     1555                               do:
     1556                                   hh:load-image("cmp/b-hist.bmp":u) .
     1557                                   hh:TOOLTIP = "История" .
     1558                                   v-h[ii] = hh:handle .
     1559                                   ii = ii + 1 .
     1560                                   hh:width-chars = 3 .
     1561                               end.
     1562                           when "b-sch" then
     1563                               do:
     1564                                   hh:load-image("cmp/b-sch.bmp":u) .
     1565                                   hh:TOOLTIP = "Установка Фильтра" .
     1566                                   v-h[ii] = hh:handle .
     1567                                   ii = ii + 1 .
     1568                                   hh:width-chars = 3 .
     1569                               end.
     1570                           when "b-hist-user" then
     1571                               do:
     1572                                   hh:load-image("cmp/b-hist.bmp":u) .
     1573                                   hh:TOOLTIP = "История пользователя" .
     1574                                   ii = ii + 1 .
     1575                               end.
     1576                       end case.
     1577                   end.
     1578                   hh = hh:next-sibling.
     1579               end.
     1580               b-help:column = v-frame-width - b-help:width-chars.
     1581               jj = 0.
     1582               repeat ii = 4 to 1 by -1 :
     1583                   if valid-handle (v-h[ii] ) then
     1584                   do:
     1585                       jj  = jj + 1 .
     1586                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1587                       v-h[ii]:row    = v-help-old-y .
     1588                   end.
     1589               end.
     1590           end.
     1591       end.
     1592   end procedure.
     1593   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1594   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1595   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1596   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1597   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1598   define variable v-diasize-current-frame-height as decimal   no-undo .
     1599   define variable v-diasize-change-size          as logical   no-undo .
     1600   define variable v-diasize-resize-button        as handle    no-undo .
     1601   define variable v-diasize-wndmax               as logical   no-undo .
     1602   define variable v-diasize-wndstore             as logical   no-undo .
     1603   define variable v-diasize-proc-name            as character no-undo .
     1604   define variable v-diasize-browse-handle        as handle    no-undo .
     1605   define variable v-diasize-browse-number        as integer   no-undo .
     1606   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1607   define temp-table temp-diasize-handle no-undo
     1608     field handle-value  as handle
     1609     field save-position as decimal
     1610     index xpk is primary unique handle-value
     1611     .
     1612   define temp-table temp-browse-handle no-undo
     1613     field browse-type   as character
     1614     field browse-number as integer
     1615     field browse-handle as handle
     1616     field original-size as decimal
     1617     index xpk is primary unique browse-type browse-number
     1618     index xie browse-type browse-handle
     1619   .
     1620   procedure diasize_change-height :
     1621     define input  parameter p-change-value  as decimal   no-undo .
     1622     define input  parameter p-move-resize   as logical   no-undo .
     1623     define variable v-field-group-handle    as handle    no-undo .
     1624     define variable v-object-handle         as handle    no-undo .
     1625     define variable v-frame-height          as decimal   no-undo .
     1626     define variable v-frame-virtual-height  as decimal   no-undo .
     1627     define variable v-browse-height         as decimal   no-undo .
     1628     define variable v-window-height         as decimal   no-undo .
     1629     define variable v-window-virtual-height as decimal   no-undo .
     1630     define variable v-change-sign           as integer   no-undo .
     1631     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1632     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1633     if p-change-value > 0
     1634     then do:
     1635       if frame Dialog-Frame :height + p-change-value
     1636           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1637       then do:
     1638         assign
     1639           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1640                           - (frame Dialog-Frame :height-chars)
     1641         .
     1642         if p-change-value <= 0
     1643         then do:
     1644           run diasize_position-resize-button in this-procedure .
     1645           return .
     1646         end.
     1647       end.
     1648     end.
     1649     if p-change-value < 0
     1650     then do:
     1651       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1652       then do:
     1653         assign
     1654           p-change-value = v-diasize-orig-frame-height
     1655                          - (frame Dialog-Frame :height-chars)
     1656         .
     1657         if p-change-value >= 0
     1658         then do:
     1659           run diasize_position-resize-button in this-procedure .
     1660           return .
     1661         end.
     1662       end.
     1663     end.
     1664     if p-change-value >= 0
     1665     then do:
     1666       assign
     1667         v-change-sign = 1
     1668       .
     1669     end.
     1670     else do:
     1671       assign
     1672         v-change-sign = -1
     1673       .
     1674     end.
     1675     assign
     1676       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1677     .
     1678     if p-change-value = 0
     1679     then do:
     1680       run diasize_position-resize-button in this-procedure .
     1681       return .
     1682     end.
     1683     move_block:
     1684     do
     1685     on error undo move_block, retry move_block
     1686     :
     1687       if retry
     1688       then do:
     1689         do
     1690         on error undo move_block, leave move_block
     1691         :
     1692           if p-change-value > 0
     1693           then do:
     1694             for each buf_temp-diasize-handle
     1695             on error undo, next
     1696             :
     1697               assign
     1698                 v-object-handle = buf_temp-diasize-handle.handle-value
     1699               .
     1700               if v-object-handle <> v-diasize-resize-button
     1701               then do:
     1702                 assign
     1703                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1704                 .
     1705               end.
     1706             end.
     1707             assign
     1708               v-diasize-browse-handle :height = v-browse-height
     1709             .
     1710             for each buf_temp-browse-handle
     1711               where buf_temp-browse-handle.browse-type = 'height':u
     1712             on error undo, next
     1713             :
     1714               assign
     1715                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1716               .
     1717             end.
     1718             assign
     1719               frame Dialog-Frame :height = v-frame-height
     1720             .
     1721             if frame Dialog-Frame :scrollable = true
     1722             then do:
     1723               assign
     1724                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1725               .
     1726             end.
     1727             run diasize_position-resize-button in this-procedure .
     1728           end.
     1729           else do:
     1730             if frame Dialog-Frame :scrollable = true
     1731             then do:
     1732               assign
     1733                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1734               .
     1735             end.
     1736             assign
     1737               frame Dialog-Frame :height = v-frame-height
     1738             .
     1739             assign
     1740               v-diasize-browse-handle :height = v-browse-height
     1741             .
     1742             for each buf_temp-browse-handle
     1743               where buf_temp-browse-handle.browse-type = 'height':u
     1744             on error undo, next
     1745             :
     1746               assign
     1747                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1748               .
     1749             end.
     1750             for each buf_temp-diasize-handle
     1751             on error undo, next
     1752             :
     1753               assign
     1754                 v-object-handle = buf_temp-diasize-handle.handle-value
     1755               .
     1756               if v-object-handle <> v-diasize-resize-button
     1757               then do:
     1758                 assign
     1759                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1760                 .
     1761               end.
     1762             end.
     1763             run diasize_position-resize-button in this-procedure .
     1764           end.
     1765           assign
     1766             v-diasize-change-size = false
     1767           .
     1768           leave move_block .
     1769         end.
     1770       end.
     1771       assign
     1772         v-diasize-need-full-display = true
     1773       .
     1774       if v-diasize-change-size = false
     1775       then do:
     1776         assign
     1777           v-diasize-change-size = true
     1778         .
     1779       end.
     1780       else do:
     1781         return .
     1782       end.
     1783       assign
     1784         v-frame-height = frame Dialog-Frame :height
     1785         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1786         v-browse-height = v-diasize-browse-handle :height
     1787       .
     1788       for each buf_temp-browse-handle
     1789         where buf_temp-browse-handle.browse-type = 'height':u
     1790       :
     1791         assign
     1792           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1793         .
     1794       end.
     1795       for each buf_temp-diasize-handle
     1796       :
     1797         delete buf_temp-diasize-handle .
     1798       end.
     1799       assign
     1800         v-field-group-handle = frame Dialog-Frame :first-child
     1801       .
     1802       do while valid-handle(v-field-group-handle)
     1803       :
     1804         assign
     1805           v-object-handle = v-field-group-handle :first-child
     1806         .
     1807         do while valid-handle(v-object-handle)
     1808         :
     1809           if  v-object-handle <> v-diasize-browse-handle :handle
     1810           and can-query(v-object-handle, "row")
     1811           and can-query(v-object-handle, "height")
     1812           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1813           then do:
     1814             find first buf_temp-browse-handle
     1815               where buf_temp-browse-handle.browse-type   = 'height':u
     1816                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1817               no-error .
     1818             if available buf_temp-browse-handle
     1819             then do:
     1820             end.
     1821             else do:
     1822               create buf_temp-diasize-handle .
     1823               assign
     1824                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1825                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1826               .
     1827             end.
     1828           end.
     1829           assign
     1830             v-object-handle = v-object-handle :next-sibling
     1831           .
     1832         end.
     1833         assign
     1834           v-field-group-handle = v-field-group-handle :next-sibling
     1835         .
     1836       end.
     1837       do with frame Dialog-Frame
     1838       :
     1839         hide v-diasize-resize-button .
     1840         assign
     1841           v-diasize-resize-button :row    = 1
     1842           v-diasize-resize-button :column = 1
     1843         .
     1844       end.
     1845       if p-change-value > 0
     1846       then do:
     1847         if frame Dialog-Frame :scrollable = true
     1848         then do:
     1849           assign
     1850             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1851             no-error .
     1852           if error-status :error
     1853           or error-status :get-message(1) <> ""
     1854           then do:
     1855             undo move_block, retry move_block .
     1856           end.
     1857         end.
     1858         assign
     1859           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1860           no-error .
     1861         if error-status :error
     1862         or error-status :get-message(1) <> ""
     1863         then do:
     1864           undo move_block, retry move_block .
     1865         end.
     1866         assign
     1867           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1868           no-error .
     1869         if error-status :error
     1870         or error-status :get-message(1) <> ""
     1871         then do:
     1872           undo move_block, retry move_block .
     1873         end.
     1874         for each buf_temp-browse-handle
     1875           where buf_temp-browse-handle.browse-type = 'height':u
     1876         on error undo move_block, retry move_block
     1877         :
     1878           assign
     1879             buf_temp-browse-handle.browse-handle :height
     1880               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1881             no-error .
     1882           if error-status :error
     1883           or error-status :get-message(1) <> ""
     1884           then do:
     1885             undo move_block, retry move_block .
     1886           end.
     1887         end.
     1888         for each buf_temp-diasize-handle
     1889         on error undo move_block, retry move_block
     1890         :
     1891           assign
     1892             v-object-handle = buf_temp-diasize-handle.handle-value
     1893           .
     1894           if v-object-handle <> v-diasize-resize-button
     1895           then do:
     1896             assign
     1897               v-object-handle :row = v-object-handle :row + p-change-value
     1898               no-error .
     1899             if error-status :error
     1900             or error-status :get-message(1) <> ""
     1901             then do:
     1902               undo move_block, retry move_block .
     1903             end.
     1904           end.
     1905         end.
     1906       end.
     1907       else do:
     1908         for each buf_temp-diasize-handle
     1909         on error undo move_block, retry move_block
     1910         :
     1911           assign
     1912             v-object-handle = buf_temp-diasize-handle.handle-value
     1913           .
     1914           if v-object-handle <> v-diasize-resize-button
     1915           then do:
     1916             assign
     1917               v-object-handle :row = v-object-handle :row + p-change-value
     1918               no-error .
     1919             if error-status :error
     1920             or error-status :get-message(1) <> ""
     1921             then do:
     1922               undo move_block, retry move_block .
     1923             end.
     1924           end.
     1925         end.
     1926         assign
     1927           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1928           no-error .
     1929         if error-status :error
     1930         or error-status :get-message(1) <> ""
     1931         then do:
     1932           undo move_block, retry move_block .
     1933         end.
     1934         for each buf_temp-browse-handle
     1935           where buf_temp-browse-handle.browse-type = 'height':u
     1936         on error undo move_block, retry move_block
     1937         :
     1938           assign
     1939             buf_temp-browse-handle.browse-handle :height
     1940               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1941             no-error .
     1942           if error-status :error
     1943           or error-status :get-message(1) <> ""
     1944           then do:
     1945             undo move_block, retry move_block .
     1946           end.
     1947         end.
     1948         assign
     1949           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1950           no-error .
     1951         if error-status :error
     1952         or error-status :get-message(1) <> ""
     1953         then do:
     1954           undo move_block, retry move_block .
     1955         end.
     1956         if frame Dialog-Frame :scrollable = true
     1957         then do:
     1958           assign
     1959             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1960             no-error .
     1961           if error-status :error
     1962           or error-status :get-message(1) <> ""
     1963           then do:
     1964             undo move_block, retry move_block .
     1965           end.
     1966         end.
     1967       end.
     1968       if p-move-resize = true
     1969       then do:
     1970         run diasize_position-resize-button in this-procedure .
     1971       end.
     1972       if v-diasize-wndstore = true
     1973       then do:
     1974         if connected("ub") = true
     1975         then do:
     1976           define variable v-cntxt-db-num        as integer   no-undo .
     1977           define variable v-cntxt-userid        as character no-undo .
     1978           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1979                                             , OUTPUT v-cntxt-userid
     1980                                             ) .
     1981           run gbl/wndsizew.p
     1982             (input  v-cntxt-db-num
     1983             ,input  v-cntxt-userid
     1984             ,input  v-diasize-proc-name
     1985             ,input  'height':u
     1986             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1987             ) .
     1988         end.
     1989       end.
     1990     end.
     1991     assign
     1992       v-diasize-change-size = false
     1993     .
     1994   end procedure.
     1995   procedure diasize_set-height :
     1996     define input  parameter p-new-height  as decimal   no-undo .
     1997     define input  parameter p-move-resize as logical   no-undo .
     1998     do
     1999     on error undo, return error return-value
     2000     :
     2001       run diasize_change-height in this-procedure
     2002         (input  (p-new-height - frame Dialog-Frame :height)
     2003         ,input  p-move-resize
     2004         ) .
     2005     end.
     2006   end procedure.
     2007   procedure diasize_change-width :
     2008     define input  parameter p-change-value as decimal   no-undo .
     2009     define input  parameter p-move-resize  as logical   no-undo .
     2010     define variable v-field-group-handle   as handle    no-undo .
     2011     define variable v-object-handle        as handle    no-undo .
     2012     define variable v-frame-width          as decimal   no-undo .
     2013     define variable v-frame-virtual-width  as decimal   no-undo .
     2014     define variable v-browse-width         as decimal   no-undo .
     2015     define variable v-window-width         as decimal   no-undo .
     2016     define variable v-window-virtual-width as decimal   no-undo .
     2017     define variable v-change-sign          as integer   no-undo .
     2018     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2019     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2020     if p-change-value > 0
     2021     then do:
     2022       if frame Dialog-Frame :width + p-change-value >
     2023           session :width-chars
     2024       then do:
     2025         assign
     2026           p-change-value = session :width-chars - frame Dialog-Frame :width
     2027         .
     2028         if p-change-value <= 0
     2029         then do:
     2030           run diasize_position-resize-button in this-procedure .
     2031           return .
     2032         end.
     2033       end.
     2034     end.
     2035     if p-change-value < 0
     2036     then do:
     2037       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2038       then do:
     2039         assign
     2040           p-change-value = v-diasize-orig-frame-width
     2041                          - frame Dialog-Frame :width
     2042         .
     2043         if p-change-value >= 0
     2044         then do:
     2045           run diasize_position-resize-button in this-procedure .
     2046           return .
     2047         end.
     2048       end.
     2049     end.
     2050     if p-change-value >= 0
     2051     then do:
     2052       assign
     2053         v-change-sign = 1
     2054       .
     2055     end.
     2056     else do:
     2057       assign
     2058         v-change-sign = -1
     2059       .
     2060     end.
     2061     assign
     2062       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2063     .
     2064     if p-change-value = 0
     2065     then do:
     2066       run diasize_position-resize-button in this-procedure .
     2067       return .
     2068     end.
     2069     move_block:
     2070     do
     2071     on error undo move_block, leave move_block
     2072     :
     2073       if retry
     2074       then do:
     2075         do
     2076         on error undo move_block, leave move_block
     2077         :
     2078           if p-change-value > 0
     2079           then do:
     2080             for each buf_temp-diasize-handle
     2081             on error undo, next
     2082             :
     2083               assign
     2084                 v-object-handle = buf_temp-diasize-handle.handle-value
     2085               .
     2086               if v-object-handle <> v-diasize-resize-button
     2087               then do:
     2088                 assign
     2089                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2090                 .
     2091               end.
     2092             end.
     2093             assign
     2094               v-diasize-browse-handle :width = v-browse-width
     2095             .
     2096             for each buf_temp-browse-handle
     2097               where buf_temp-browse-handle.browse-type = 'width':u
     2098             on error undo, next
     2099             :
     2100               assign
     2101                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2102               .
     2103             end.
     2104             assign
     2105               frame Dialog-Frame :width = v-frame-width
     2106             .
     2107             if frame Dialog-Frame :scrollable = true
     2108             then do:
     2109               assign
     2110                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2111               .
     2112             end.
     2113             run diasize_position-resize-button in this-procedure .
     2114           end.
     2115           else do:
     2116             if frame Dialog-Frame :scrollable = true
     2117             then do:
     2118               assign
     2119                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2120               .
     2121             end.
     2122             assign
     2123               frame Dialog-Frame :width = v-frame-width
     2124             .
     2125             for each buf_temp-browse-handle
     2126               where buf_temp-browse-handle.browse-type = 'width':u
     2127             on error undo, next
     2128             :
     2129               assign
     2130                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2131               .
     2132             end.
     2133             assign
     2134               v-diasize-browse-handle :width = v-browse-width
     2135             .
     2136             for each buf_temp-diasize-handle
     2137             on error undo, next
     2138             :
     2139               assign
     2140                 v-object-handle = buf_temp-diasize-handle.handle-value
     2141               .
     2142               if v-object-handle <> v-diasize-resize-button
     2143               then do:
     2144                 assign
     2145                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2146                 .
     2147               end.
     2148             end.
     2149             run diasize_position-resize-button in this-procedure .
     2150           end.
     2151           assign
     2152             v-diasize-change-size = false
     2153           .
     2154           leave move_block .
     2155         end.
     2156       end.
     2157       assign
     2158         v-diasize-need-full-display = true
     2159       .
     2160       if v-diasize-change-size = false
     2161       then do:
     2162         assign
     2163           v-diasize-change-size = true
     2164         .
     2165       end.
     2166       else do:
     2167         return .
     2168       end.
     2169       assign
     2170         v-frame-width = frame Dialog-Frame :width
     2171         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2172         v-browse-width = v-diasize-browse-handle :width
     2173       .
     2174       for each buf_temp-browse-handle
     2175         where buf_temp-browse-handle.browse-type = 'width':u
     2176       :
     2177         assign
     2178           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2179         .
     2180       end.
     2181       for each buf_temp-diasize-handle
     2182       :
     2183         delete buf_temp-diasize-handle .
     2184       end.
     2185       assign
     2186         v-field-group-handle = frame Dialog-Frame :first-child
     2187       .
     2188       do while valid-handle(v-field-group-handle)
     2189       :
     2190         assign
     2191           v-object-handle = v-field-group-handle :first-child
     2192         .
     2193         do while valid-handle(v-object-handle)
     2194         :
     2195           if  v-object-handle <> v-diasize-browse-handle :handle
     2196           and v-object-handle <> v-diasize-resize-button
     2197           and can-query(v-object-handle, "row")
     2198           and can-query(v-object-handle, "height")
     2199           and ( v-object-handle :col + v-object-handle :width
     2200                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2201               )
     2202           then do:
     2203             find first buf_temp-browse-handle
     2204               where buf_temp-browse-handle.browse-type   = 'width':u
     2205                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2206               no-error .
     2207             if available buf_temp-browse-handle
     2208             then do:
     2209             end.
     2210             else do:
     2211               create buf_temp-diasize-handle .
     2212               assign
     2213                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2214                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2215               .
     2216             end.
     2217           end.
     2218           assign
     2219             v-object-handle = v-object-handle :next-sibling
     2220           .
     2221         end.
     2222         assign
     2223           v-field-group-handle = v-field-group-handle :next-sibling
     2224         .
     2225       end.
     2226       do with frame Dialog-Frame
     2227       :
     2228         hide v-diasize-resize-button .
     2229         v-diasize-resize-button :row = 1.
     2230         v-diasize-resize-button :column = 1.
     2231       end.
     2232       if p-change-value > 0
     2233       then do:
     2234         if frame Dialog-Frame :scrollable = true
     2235         then do:
     2236           assign
     2237             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2238             no-error .
     2239           if error-status :error
     2240           or error-status :get-message(1) <> ""
     2241           then do:
     2242             undo move_block, retry move_block.
     2243           end.
     2244         end.
     2245         assign
     2246           frame Dialog-Frame :width = v-frame-width + p-change-value
     2247           no-error .
     2248         if error-status :error
     2249         or error-status :get-message(1) <> ""
     2250         then do:
     2251           undo move_block, retry move_block.
     2252         end.
     2253         assign
     2254           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2255         no-error .
     2256         if error-status :error
     2257         or error-status :get-message(1) <> ""
     2258         then do:
     2259           undo move_block, retry move_block.
     2260         end.
     2261         for each buf_temp-browse-handle
     2262           where buf_temp-browse-handle.browse-type = 'width':u
     2263         on error undo move_block, retry move_block
     2264         :
     2265           assign
     2266             buf_temp-browse-handle.browse-handle :width
     2267               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2268             no-error .
     2269           if error-status :error
     2270           or error-status :get-message(1) <> ""
     2271           then do:
     2272             undo move_block, retry move_block .
     2273           end.
     2274         end.
     2275         for each buf_temp-diasize-handle
     2276         on error undo move_block, retry move_block
     2277         :
     2278           assign
     2279             v-object-handle = buf_temp-diasize-handle.handle-value
     2280           .
     2281           if v-object-handle <> v-diasize-resize-button
     2282           then do:
     2283             assign
     2284               v-object-handle :col = v-object-handle :col + p-change-value
     2285               no-error .
     2286             if error-status :error
     2287             or error-status :get-message(1) <> ""
     2288             then do:
     2289               undo move_block, retry move_block .
     2290             end.
     2291           end.
     2292         end.
     2293       end.
     2294       else do:
     2295         for each buf_temp-diasize-handle
     2296         on error undo move_block, retry move_block
     2297         :
     2298           assign
     2299             v-object-handle = buf_temp-diasize-handle.handle-value
     2300           .
     2301           if v-object-handle <> v-diasize-resize-button
     2302           then do:
     2303             assign
     2304               v-object-handle :col = v-object-handle :col + p-change-value
     2305               no-error .
     2306             if error-status :error
     2307             or error-status :get-message(1) <> ""
     2308             then do:
     2309               undo move_block, retry move_block .
     2310             end.
     2311           end.
     2312         end.
     2313         for each buf_temp-browse-handle
     2314           where buf_temp-browse-handle.browse-type = 'width':u
     2315         on error undo move_block, retry move_block
     2316         :
     2317           assign
     2318             buf_temp-browse-handle.browse-handle :width
     2319               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2320             no-error .
     2321           if error-status :error
     2322           or error-status :get-message(1) <> ""
     2323           then do:
     2324             undo move_block, retry move_block .
     2325           end.
     2326         end.
     2327         assign
     2328           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2329           no-error .
     2330         if error-status :error
     2331         or error-status :get-message(1) <> ""
     2332         then do:
     2333           undo move_block, retry move_block.
     2334         end.
     2335         assign
     2336           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2337         no-error .
     2338         if error-status :error
     2339         or error-status :get-message(1) <> ""
     2340         then do:
     2341           undo move_block, retry move_block.
     2342         end.
     2343         if frame Dialog-Frame :scrollable = true
     2344         then do:
     2345           assign
     2346             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2347           no-error .
     2348           if error-status :error
     2349           or error-status :get-message(1) <> ""
     2350           then do:
     2351             undo move_block, retry move_block.
     2352           end.
     2353         end.
     2354       end.
     2355       if p-move-resize
     2356       then do:
     2357         run diasize_position-resize-button in this-procedure .
     2358       end.
     2359       if v-diasize-wndstore = true
     2360       then do:
     2361         if connected("ub") = true
     2362         then do:
     2363           define variable v-cntxt-db-num        as integer   no-undo .
     2364           define variable v-cntxt-userid        as character no-undo .
     2365           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2366                                             , OUTPUT v-cntxt-userid
     2367                                             ) .
     2368           run gbl/wndsizew.p
     2369             (input  v-cntxt-db-num
     2370             ,input  v-cntxt-userid
     2371             ,input  v-diasize-proc-name
     2372             ,input  'width':u
     2373             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2374             ) .
     2375         end.
     2376       end.
     2377     end.
     2378     assign
     2379       v-diasize-change-size = false
     2380     .
     2381   end procedure.
     2382   procedure diasize_set-width :
     2383     define input  parameter p-new-width  as decimal   no-undo .
     2384     define input  parameter p-move-resize as logical   no-undo .
     2385     do
     2386     on error undo, return error return-value
     2387     :
     2388       run diasize_change-width in this-procedure
     2389         (input  (p-new-width - frame Dialog-Frame :width)
     2390         ,input  p-move-resize
     2391         ) .
     2392     end.
     2393   end procedure.
     2394   procedure diasize_position-resize-button :
     2395     do with frame Dialog-Frame
     2396     :
     2397       hide v-diasize-resize-button .
     2398       assign
     2399         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2400                     - 1
     2401                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2402         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2403                     - 1
     2404                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2405       .
     2406       view v-diasize-resize-button .
     2407     end.
     2408   end procedure.
     2409   on alt-right anywhere
     2410   do:
     2411     run diasize_change-width in this-procedure
     2412       (input 1
     2413       ,input true
     2414       ) .
     2415     return no-apply .
     2416   end.
     2417   on alt-left anywhere
     2418   do:
     2419     run diasize_change-width in this-procedure
     2420       (input -1
     2421       ,input true
     2422       ) .
     2423     return no-apply .
     2424   end.
     2425   on alt-down anywhere
     2426   do:
     2427     run diasize_change-height in this-procedure
     2428       (input 1
     2429       ,input true
     2430       ) .
     2431     return no-apply .
     2432   end.
     2433   on alt-up anywhere
     2434   do:
     2435     run diasize_change-height in this-procedure
     2436       (input -1
     2437       ,input true
     2438       ) .
     2439     return no-apply .
     2440   end.
     2441   on alt-enter of frame Dialog-Frame
     2442   do:
     2443     run diasize_maximize in this-procedure
     2444       (input  ?
     2445       ).
     2446     return no-apply .
     2447   end.
     2448   procedure diasize_end-move :
     2449     do
     2450     on error undo, return error return-value
     2451     :
     2452       define variable v-row-delta as decimal   no-undo .
     2453       define variable v-col-delta as decimal   no-undo .
     2454       define variable v-new-row as decimal   no-undo .
     2455       define variable v-new-col as decimal   no-undo .
     2456       assign
     2457         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2458         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2459       .
     2460       assign
     2461         v-row-delta = v-new-row - frame Dialog-Frame :height
     2462         v-col-delta = v-new-col - frame Dialog-Frame :width
     2463       .
     2464       run diasize_change-height in this-procedure
     2465         (input v-row-delta
     2466         ,input true
     2467         ) .
     2468       run diasize_change-width in this-procedure
     2469         (input v-col-delta
     2470         ,input true
     2471         ) .
     2472     end.
     2473   end procedure.
     2474   procedure diasize_maximize :
     2475     define input  parameter p-action as logical   no-undo .
     2476     do
     2477     on error undo, return error return-value
     2478     :
     2479       if p-action = ?
     2480       then do:
     2481         if v-diasize-need-maximize = true
     2482         then do:
     2483           assign
     2484             p-action = true
     2485           .
     2486         end.
     2487         else do:
     2488           assign
     2489             p-action = false
     2490           .
     2491         end.
     2492       end.
     2493       if p-action = true
     2494       then do:
     2495         run diasize_change-height in this-procedure
     2496           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2497               - frame Dialog-Frame :height-chars
     2498           ,input true
     2499           ) .
     2500         run diasize_change-width in this-procedure
     2501           (input session :width-chars
     2502               - frame Dialog-Frame :width-chars
     2503           ,input true
     2504           ) .
     2505         assign
     2506           v-diasize-need-maximize = false
     2507         .
     2508       end.
     2509       else do:
     2510         run diasize_change-width in this-procedure
     2511           (input v-diasize-orig-frame-width
     2512               - frame Dialog-Frame :width-chars
     2513           ,input true
     2514           ) .
     2515         run diasize_change-height in this-procedure
     2516           (input v-diasize-orig-frame-height
     2517               - frame Dialog-Frame :height-chars
     2518           ,input true
     2519           ) .
     2520         assign
     2521           v-diasize-need-maximize = true
     2522         .
     2523       end.
     2524     end.
     2525   end procedure.
     2526   procedure diasize_restore-orig-size :
     2527     do
     2528     on error undo, return error return-value
     2529     :
     2530       assign
     2531         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2532         v-diasize-current-frame-height = frame Dialog-Frame :height
     2533       .
     2534       run diasize_set-height in this-procedure
     2535         (input  v-diasize-orig-frame-height
     2536         ,input  true
     2537         ) .
     2538       run diasize_set-width in this-procedure
     2539         (input  v-diasize-orig-frame-width
     2540         ,input  true
     2541         ) .
     2542     end.
     2543   end procedure.
     2544   procedure diasize_restore-current-size :
     2545     do
     2546     on error undo, return error return-value
     2547     :
     2548       run diasize_set-height in this-procedure
     2549         (input  v-diasize-current-frame-height
     2550         ,input  true
     2551         ) .
     2552       run diasize_set-width in this-procedure
     2553         (input  v-diasize-current-frame-width
     2554         ,input  true
     2555         ) .
     2556     end.
     2557   end procedure.
     2558   procedure diasize_set-browse-handle :
     2559     define input  parameter p-browse-handle as handle   no-undo .
     2560     define buffer buf_temp-browse-handle for temp-browse-handle .
     2561     do
     2562     on error undo, return error return-value
     2563     :
     2564       assign
     2565         v-diasize-browse-handle = p-browse-handle
     2566       .
     2567       for each buf_temp-browse-handle
     2568       on error undo, return error return-value
     2569       :
     2570         delete buf_temp-browse-handle .
     2571       end.
     2572     end.
     2573   end procedure.
     2574   procedure diasize_add_browse :
     2575     define input  parameter p-browse-type   as character no-undo .
     2576     define input  parameter p-browse-handle as handle    no-undo .
     2577     define buffer buf_temp-browse-handle for temp-browse-handle .
     2578     do
     2579     on error undo, return error return-value
     2580     :
     2581       assign
     2582         v-diasize-browse-number = v-diasize-browse-number + 1
     2583       .
     2584       create buf_temp-browse-handle .
     2585       assign
     2586         buf_temp-browse-handle.browse-type   = p-browse-type
     2587         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2588         buf_temp-browse-handle.browse-handle = p-browse-handle
     2589       .
     2590     end.
     2591   end procedure.
     2592   procedure diasize_init :
     2593     define variable v-default-value    as logical   no-undo .
     2594     define variable v-restore-saved    as logical   no-undo .
     2595     define variable v-resize-value-str as character no-undo .
     2596     do
     2597     on error undo, return error return-value
     2598     :
     2599       do with frame Dialog-Frame
     2600       :
     2601         assign
     2602           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2603           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2604           v-diasize-browse-handle     = browse br-prop-ref :handle
     2605         .
     2606         create button v-diasize-resize-button
     2607         assign
     2608           parent        = frame Dialog-Frame :first-child
     2609           label         = "s"
     2610           height-pixels = 16
     2611           width-pixels  = 16
     2612           visible       = true
     2613           sensitive     = true
     2614           movable       = true
     2615           triggers:
     2616             on end-move persistent run diasize_end-move in this-procedure .
     2617           end triggers.
     2618         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2619         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2620         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2621         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2622         assign
     2623           v-diasize-wndmax = false
     2624         .
     2625         if connected("ub") = true
     2626         then do:
     2627           define variable v-cntxt-db-num        as integer   no-undo .
     2628           define variable v-cntxt-userid        as character no-undo .
     2629           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2630                                             , OUTPUT v-cntxt-userid
     2631                                             ) .
     2632           run gbl/wndpar_r.p
     2633             (input  v-cntxt-db-num
     2634             ,input  v-cntxt-userid
     2635             ,input  'wndmax':U
     2636             ,output v-diasize-wndmax
     2637             ,output v-default-value
     2638             ) .
     2639         end.
     2640         assign
     2641           v-diasize-wndstore = false
     2642         .
     2643         if connected("ub") = true
     2644         then do:
     2645           run gbl/wndpar_r.p
     2646             (input  v-cntxt-db-num
     2647             ,input  v-cntxt-userid
     2648             ,input  'wndstore':U
     2649             ,output v-diasize-wndstore
     2650             ,output v-default-value
     2651             ) .
     2652         end.
     2653         assign
     2654           v-diasize-proc-name = entry(1, program-name(2), '.')
     2655         .
     2656         if v-diasize-wndstore = true
     2657         then do:
     2658           assign
     2659             v-restore-saved = false
     2660           .
     2661           if connected("ub") = true
     2662           then do:
     2663             run gbl/wndsizer.p
     2664               (input  v-cntxt-db-num
     2665               ,input  v-cntxt-userid
     2666               ,input  v-diasize-proc-name
     2667               ,input  'height':u
     2668               ,output v-resize-value-str
     2669               ) .
     2670             if v-resize-value-str <> '':U
     2671             then do:
     2672               run diasize_change-height in this-procedure
     2673                 (input  integer(v-resize-value-str)
     2674                 ,input  true
     2675                 ) .
     2676               assign
     2677                 v-restore-saved = true
     2678               .
     2679             end.
     2680           end.
     2681           if connected("ub") = true
     2682           then do:
     2683             run gbl/wndsizer.p
     2684               (input  v-cntxt-db-num
     2685               ,input  v-cntxt-userid
     2686               ,input  v-diasize-proc-name
     2687               ,input  'width':u
     2688               ,output v-resize-value-str
     2689               ) .
     2690             if v-resize-value-str <> '':U
     2691             then do:
     2692               run diasize_change-width in this-procedure
     2693                 (input  integer(v-resize-value-str)
     2694                 ,input  true
     2695                 ) .
     2696               assign
     2697                 v-restore-saved = true
     2698               .
     2699             end.
     2700           end.
     2701           if v-restore-saved <> true
     2702           then do:
     2703             if v-diasize-wndmax = true
     2704             then do:
     2705               run diasize_maximize in this-procedure
     2706                 (input  true
     2707                 ) .
     2708             end.
     2709           end.
     2710         end.
     2711         else do:
     2712           if v-diasize-wndmax = true
     2713           then do:
     2714             run diasize_maximize in this-procedure
     2715               (input  true
     2716               ) .
     2717           end.
     2718         end.
     2719       end.
     2720     end.
     2721   end procedure.
     2722   procedure diasize_need-full-display :
     2723     define output parameter p-need-full-display as logical   no-undo .
     2724     do
     2725     on error undo, return error return-value
     2726     :
     2727       assign
     2728         p-need-full-display = v-diasize-need-full-display
     2729       .
     2730       assign
     2731         v-diasize-need-full-display = false
     2732       .
     2733     end.
     2734   end procedure.
     2735   procedure get-context :
     2736      define output parameter p-db-num as integer          no-undo.
     2737      define output parameter p-user-id as character        no-undo.
     2738      define variable v-login               as character    no-undo.
     2739      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2740      define buffer buf_user-login  for ub.user-login .
     2741      do
     2742      on error undo, return error
     2743      :
     2744            FIND FIRST buf_sys-ctrl no-lock.
     2745            ASSIGN
     2746               v-login = USERID("ub")
     2747               p-db-num = buf_sys-ctrl.db-num
     2748            .
     2749            FIND FIRST buf_user-login
     2750                 WHERE buf_user-login.db-num = p-db-num
     2751                   AND buf_user-login.user-login = v-login
     2752                 no-lock
     2753                 no-error
     2754                 .
     2755            IF AVAILABLE buf_user-login
     2756            THEN DO:
     2757               assign
     2758                  p-user-id = buf_user-login.user-id
     2759               .
     2760            END.
     2761      end.
     2762   end procedure.
     2763       run diasize_init in this-procedure .
     2764   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2765   on INS of frame Dialog-Frame anywhere do:
     2766     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2767     return no-apply.
     2768   end.
     2769   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2770   on F2 of frame Dialog-Frame anywhere do:
     2771     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2772     return no-apply.
     2773   end.
     2774   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2775   on F2 of frame Dialog-Frame anywhere do:
     2776     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2777     return no-apply.
     2778   end.
     2779   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2780   do:
     2781     br-prop-ref :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2782   end.
     2783   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2784   on f5 of frame Dialog-Frame anywhere
     2785   do:
     2786      if available X_prop-ref then ri = recid(X_prop-ref).     RUn OpenBr in this-procedure ( input yes, input no, input '':U) .     reposition br-prop-ref to recid ri no-error.
     2787       apply "VALUE-CHANGED" to br-prop-ref.
     2788   end.
     2789   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2790   procedure set-filter-name :
     2791   define input parameter p-filter-name as character no-undo .
     2792     do with frame Dialog-Frame:
     2793       if p-filter-name > "" then do:
     2794         assign
     2795           frame Dialog-Frame:title
     2796             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2797         .
     2798       end.
     2799       else do:
     2800       end.
     2801     end.
     2802   end procedure.
     2803   def var sort-labelbr-prop-ref   as character no-undo .
     2804   def var sort-clmnbr-prop-ref    as handle    no-undo .
     2805   def var cur-clmnbr-prop-ref     as handle    no-undo .
     2806   def var cur-clmn-locbr-prop-ref as integer   no-undo .
     2807   def var re-querybr-prop-ref     as logical   initial no no-undo .
     2808   on start-search, ctrl-o of br-prop-ref in frame Dialog-Frame do:
     2809      run sort-brbr-prop-ref
     2810        (input (if available X_prop-ref
     2811                then recid(X_prop-ref)
     2812                else ?
     2813               )
     2814        ).
     2815   end.
     2816   PROCEDURE sort-brbr-prop-ref :
     2817     define input parameter p-recid as recid no-undo .
     2818     if re-querybr-prop-ref = no then do:
     2819       assign
     2820          cur-clmnbr-prop-ref = br-prop-ref:current-column in frame Dialog-Frame
     2821       .
     2822       if sort-clmnbr-prop-ref <> ? then sort-clmnbr-prop-ref:column-fgcolor = 0.
     2823       if cur-clmnbr-prop-ref = sort-clmnbr-prop-ref then do:
     2824         assign
     2825            sort-labelbr-prop-ref = ""
     2826            sort-clmnbr-prop-ref = ?
     2827         .
     2828        end.
     2829        else do:
     2830          assign
     2831            sort-labelbr-prop-ref = cur-clmnbr-prop-ref:label
     2832            sort-clmnbr-prop-ref  = cur-clmnbr-prop-ref
     2833            sort-clmnbr-prop-ref:column-fgcolor = 4
     2834          .
     2835        end.
     2836      end.
     2837     assign
     2838       cur-clmn-locbr-prop-ref = 1
     2839     .
     2840     def var column-handle as handle no-undo .
     2841     column-handle = br-prop-ref:first-column.
     2842     do while valid-handle(column-handle) :
     2843       if column-handle = cur-clmnbr-prop-ref then do:
     2844         leave .
     2845       end.
     2846       column-handle = column-handle:NEXT-COLUMN.
     2847       assign
     2848         cur-clmn-locbr-prop-ref = cur-clmn-locbr-prop-ref + 1
     2849       .
     2850     end.
     2851     case sort-labelbr-prop-ref:
     2852           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(X_prop-ref), &1&2&1)', chr(34), v-rid-list)     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
     2853           when 'Идентификатор!итога'  then DO:    assign       sort-column-name = "X_prop-ref.sum-id"     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
     2854           when 'Код!итога'  then DO:    assign       sort-column-name = "X_prop-ref.dt-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
     2855           when 'Код!объекта!операнда'  then DO:    assign       sort-column-name = "X_prop-ref.dtm-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
     2856           when 'Доп!идентификатор'  then DO:    assign       sort-column-name = "X_prop-ref.caller_id"     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
     2857           when 'Задействован'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1calldscr&1, X_prop-ref.call_id)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
     2858           when 'Описание'  then DO:    assign       sort-column-name = "proprefd_sum-id-des(X_prop-ref.sum-id, X_prop-ref.ref-type)"     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
     2859           when 'Код-операнд'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-dtm-name&1, X_prop-ref.dtm-code)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
     2860       otherwise do:
     2861         assign
     2862           sort-column-name = ""
     2863         .
     2864         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2865         if sort-labelbr-prop-ref <> "" then do:
     2866           assign
     2867             cur-clmnbr-prop-ref:column-fgcolor = 0
     2868           .
     2869         end.
     2870         assign
     2871           cur-clmn-locbr-prop-ref = ?
     2872         .
     2873       end.
     2874     end case.
     2875     if p-recid <> ? then do:
     2876       reposition br-prop-ref to recid p-recid no-error.
     2877       apply "value-changed" to br-prop-ref in frame Dialog-Frame.
     2878     end.
     2879     apply "entry" to br-prop-ref in frame Dialog-Frame.
     2880   END PROCEDURE.
     2881   procedure re-open-query-srt-clmnbr-prop-ref:
     2882   if cur-clmnbr-prop-ref = ? then do:
     2883      run OpenBr in this-procedure ( input yes, input no, input '':U).
     2884   end.
     2885   else do:
     2886      assign re-querybr-prop-ref = yes.
     2887      run sort-brbr-prop-ref
     2888        (input (if available X_prop-ref
     2889                then recid(X_prop-ref)
     2890                else ?
     2891               )
     2892        ).
     2893      assign re-querybr-prop-ref = no.
     2894   end.
     2895   end.
     2896   MAIN-BLOCK:
     2897   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2898      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2899   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2900     run mainmenu_getcntxt in parparentproc
     2901       (output v-cntxt-db-num
     2902       ,output v-cntxt-userid
     2903       ,output v-cntxt-level
     2904       ,output v-cntxt-host-code-obj
     2905       ,output v-cntxt-obj-type
     2906       ,output v-cntxt-obj-code
     2907       ,output v-cntxt-db-num-obj
     2908       ,output v-cntxt-is-admin
     2909       ) .
     2910    IF LOOKUP(p-list-mode, 'все':U + chr(44) + "dis-tot" + chr(44) + "sum-id" + chr(44) +
     2911              'dis-card-property':U + chr(44) + "call_id" + chr(44) +
     2912              ('dis-card-property':U + chr(4) + 'call_id':U + chr(44) + "dtm-code" + chr(44) +
     2913               'prop-ref-call':U)
     2914              ) = 0 THEN DO:
     2915      message
     2916      vss-workfile vss-revision vss-description skip
     2917      "Неверный параметр вызова p-list-mode" p-list-mode
     2918       view-as alert-box ERROR.
     2919       return error.
     2920     END.
     2921     run gbl/dftempl.p ( input 'prop-ref-call':U, output template-recid) no-error.
     2922     v-rid-list = p-rid-list.
     2923     run Myenable IN THIS-PROCEDURE .
     2924     run openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     2925       if num-entries (v-rid-list) = 0 then
     2926           hide mark-num in frame Dialog-Frame.
     2927       else
     2928           disp
     2929           num-entries (v-rid-list) @ mark-num
     2930           with frame Dialog-Frame.
     2931     WAIT-FOR GO OF FRAME Dialog-Frame.
     2932   END.
     2933   run disable_UI in this-procedure.
     2934   PROCEDURE disable_UI :
     2935     HIDE FRAME Dialog-Frame.
     2936   END PROCEDURE.
     2937   PROCEDURE enable_UI :
     2938     DISPLAY mark-num
     2939         WITH FRAME Dialog-Frame.
     2940     ENABLE B-quit B-mark B-sel b-add b-chg b-del b-use B-Help br-prop-ref
     2941            mark-num
     2942         WITH FRAME Dialog-Frame.
     2943     VIEW FRAME Dialog-Frame.
     2944     OPEN QUERY br-prop-ref FOR EACH X_prop-ref NO-LOCK,        FIRST X_prop-head,        FIRST X_prop-ref-call INDEXED-REPOSITION.
     2945   END PROCEDURE.
     2946   PROCEDURE MyEnable :
     2947   DEFINE VARIABLE ch AS WIDGET-HANDLE NO-UNDO.
     2948   DEFINE VARIABLE v-h AS WIDGET-HANDLE NO-UNDO.
     2949   DEFINE VARIABLE ii AS integer NO-UNDO.
     2950   FRAME Dialog-Frame:TITLE = "Список поддерживаемых срезов(итогов)".
     2951   ASSIGN
     2952   X_prop-ref.sum-id:READ-ONLY IN BROWSE br-prop-ref = YES.
     2953   ASSIGN
     2954   v-h = br-prop-ref:FIRST-COLUMN IN FRAME Dialog-Frame
     2955   .
     2956   DO while valid-handle(v-h) :
     2957     if v-h:LABEL = 'Задействован' then do:
     2958       v-h:visible = (p-list-mode = 'prop-ref-call':U).
     2959     end.
     2960     ELSE DO:
     2961       v-h:visible = (p-list-mode <> 'prop-ref-call':U).
     2962     END.
     2963     if v-h:LABEL = 'Код!объекта!операнда'
     2964     OR v-h:LABEL = 'Код-операнд'
     2965       then do:
     2966       v-h:visible = (p-list-mode <> "dtm-code").
     2967     end.
     2968     if v-h:LABEL = 'Описание'
     2969      OR
     2970     v-h:LABEL = 'Код-операнд'
     2971         then do:
     2972       v-h:RESIZAble = YES.
     2973     END.
     2974     v-h = v-h:NEXT-COLUMN.
     2975   END.
     2976   DISPLAY mark-num
     2977   WITH FRAME Dialog-Frame.
     2978   ENABLE
     2979   B-quit
     2980   B-mark WHEN lookup('b-mark', p-bttns) > 0
     2981   B-sel WHEN lookup('b-sel', p-bttns) > 0
     2982   b-del WHEN lookup('b-add', p-bttns) > 0 AND v-cntxt-db-num = 0 and not transaction and p-list-mode <> "call_id"
     2983   b-add WHEN lookup('b-add', p-bttns) > 0 AND v-cntxt-db-num = 0 and not transaction and p-list-mode <> "call_id"
     2984   B-Help
     2985   b-use WHEN p-list-mode <> 'prop-ref-call':U
     2986   br-prop-ref
     2987   WITH FRAME Dialog-Frame.
     2988   VIEW FRAME Dialog-Frame.
     2989   END PROCEDURE.
     2990   PROCEDURE OpenBr :
     2991   define input  parameter p-open-query     as logical   no-undo .
     2992   define input  parameter p-find-next      as logical   no-undo .
     2993   define input  parameter p-find-condition as character no-undo .
     2994   define variable l-query-was-opened as logical no-undo .
     2995   run waitfram-show in this-procedure ("Ждите...").
     2996   define variable sort-column-phrase as character no-undo .
     2997   define buffer buf_prop-head for ub.prop-head.
     2998   define buffer buf_prop-ref for ub.prop-ref.
     2999   case sort-column-name :
     3000     when "" then do:
     3001       assign
     3002         sort-column-phrase = ""
     3003       .
     3004     end.
     3005     otherwise do:
     3006       assign
     3007         sort-column-phrase = "by " + sort-column-name
     3008       .
     3009     end.
     3010   end case.
     3011   define variable l-open-query as logical   no-undo .
     3012   CASE p-list-mode :
     3013     WHEN 'все':U        THEN DO:
     3014   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3015   define variable  l-disable-where-26  as logical   no-undo .
     3016   define variable  l-filter-open-26    as logical   .
     3017   define variable  flt-rec-26       as recid     no-undo .
     3018   define variable  filter-name-26      as character no-undo .
     3019   define variable  where-phrase-26     as character no-undo .
     3020   define variable  sort-phrase-26      as character no-undo .
     3021   define variable  where-phrase-rus-26 as character no-undo .
     3022   define variable  sort-phrase-rus-26  as character no-undo .
     3023     run waitfram-show in this-procedure
     3024       (input "ЖДИТЕ ..."
     3025       ).
     3026   run gbl/flt-get.p
     3027     (input filter-point
     3028     ,output flt-rec-26
     3029     ,output filter-name-26
     3030     ,output where-phrase-26
     3031     ,output sort-phrase-26
     3032     ,output where-phrase-rus-26
     3033     ,output sort-phrase-rus-26
     3034     ).
     3035   if p-open-query then do:
     3036       run set-filter-name in this-procedure
     3037         (INPUT filter-name-26
     3038         ) no-error .
     3039     assign
     3040       l-filter-open-26 = false
     3041     .
     3042     if flt-rec-26 <> ?
     3043       or sort-column-phrase > ""
     3044     then do:
     3045       define variable  parameter-2-26 as character no-undo .
     3046       define variable  parameter-3-26 as character no-undo .
     3047       define variable  parameter-4-26 as character no-undo .
     3048       define variable  parameter-5-26 as character no-undo .
     3049       define variable  parameter-6-26 as character no-undo .
     3050       define variable  parameter-7-26 as character no-undo .
     3051         assign
     3052         parameter-3-26 =
     3053                                 "FOR EACH X_prop-ref"
     3054         parameter-4-26 =
     3055           (
     3056             if (" true " + " " + where-phrase-26) <> ""
     3057             then " true " + " " + where-phrase-26
     3058             else "true"
     3059           )
     3060         parameter-5-26 = (" " + "" + " " +  substitute(', FIRST X_prop-head WHERE             X_prop-head.dtm-code = X_prop-ref.dtm-code         ,FIRST X_prop-ref-call NO-LOCK WHERE RECID(X_prop-ref-call) = &1', template-recid ))
     3061         parameter-6-26 = if sort-phrase-26 = ''
     3062                              then
     3063           (
     3064           " " + "  " +
     3065             " " + sort-column-phrase +
     3066           " " + "  "
     3067           )
     3068                              else
     3069           (
     3070           " " + "  " +
