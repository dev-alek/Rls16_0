     3296      find first buf_place where
     3297                 buf_place.obj-type = p-obj-type
     3298             and buf_place.obj-code = p-obj-code
     3299             and buf_place.pl-code  = p-pl-code
     3300           no-lock no-error.
     3301      FRAME f-pl-level-mm:TITLE = SUBSTITUTE  ( "&1 &2 (&3) &4 &5"
     3302                                                , FRAME f-pl-level-mm:TITLE
     3303                                                , p-pl-code
     3304                                                , buf_place.loc1
     3305                                                , p-obj-code
     3306                                                , p-obj-type
     3307                                                ).
     3308     run enable_UI in this-procedure .
     3309     find first buf_pl-level-mm where
     3310                buf_pl-level-mm.obj-type = p-obj-type
     3311            and buf_pl-level-mm.obj-code = p-obj-code
     3312            and buf_pl-level-mm.pl-code = p-pl-code
     3313          no-lock no-error.
     3314     if available buf_pl-level-mm
     3315     then do :
     3316       disable
     3317         b-load b-add b-upd b-del b-clear
     3318       WITH FRAME f-pl-level-mm .
     3319     end .
     3320     WAIT-FOR GO OF FRAME f-pl-level-mm focus br-pl-level-mm.
     3321   END.
     3322   run disable_UI in this-procedure .
     3323   PROCEDURE disable_UI :
     3324     HIDE FRAME f-pl-level-mm.
     3325   END PROCEDURE.
     3326   PROCEDURE enable_UI :
     3327     define buffer b_pl-level-mm for ub.pl-level-mm.
     3328     find first b_pl-level-mm where
     3329                b_pl-level-mm.obj-type = p-obj-type
     3330            and b_pl-level-mm.obj-code = p-obj-code
     3331            and b_pl-level-mm.pl-code = p-pl-code
     3332          no-lock no-error.
     3333     ENABLE
     3334       br-pl-level-mm
     3335       b-exit
     3336       b-help
     3337       b-load WHEN imode eq 'ИЗМЕНЕНИЕ':U and isRights
     3338       b-add WHEN imode eq 'ИЗМЕНЕНИЕ':U and isRights
     3339       b-upd when avail b_pl-level-mm
     3340       b-del when imode eq 'ИЗМЕНЕНИЕ':U and isRights
     3341       b-clear when imode eq 'ИЗМЕНЕНИЕ':U and isRights
     3342       WITH FRAME f-pl-level-mm
     3343     .
     3344     if not avail b_pl-level-mm then do:
     3345       disable
     3346         b-upd
     3347         b-del
     3348         b-clear WITH FRAME f-pl-level-mm
     3349       .
     3350       assign v-new = yes .
     3351       ri = ?.
     3352     end.
     3353     if imode = 'ПРОСМОТР':U or not isRights then do:
     3354       b-upd:label = "Просмотр".
     3355     end.
     3356     OPEN QUERY br-pl-level-mm FOR EACH buf_pl-level-mm NO-LOCK   WHERE buf_pl-level-mm.obj-type = p-obj-type     and buf_pl-level-mm.obj-code = p-obj-code     and buf_pl-level-mm.pl-code = p-pl-code   BY buf_pl-level-mm.zone BY buf_pl-level-mm.level.
     3357     if ri <> ? then
     3358       reposition br-pl-level-mm to recid ri.
     3359     else if avail b_pl-level-mm then
     3360       reposition br-pl-level-mm to row 1.
     3361   END PROCEDURE.
     3362   PROCEDURE importExcel :
     3363   define input parameter fileImport as character no-undo.
     3364   define variable mExcelApplication as component-handle no-undo.
     3365   define variable mWorkBook         as component-handle no-undo.
     3366   define variable mWorkSheet        as component-handle no-undo.
     3367   define variable cntLine           as integer   no-undo.
     3368   define variable vLine             as character no-undo.
     3369   define variable vErr              as character no-undo.
     3370   define variable vZone             like ub.pl-level-mm.zone no-undo.
     3371   define variable vMinLevel         like ub.pl-level-mm.min-level no-undo.
     3372   define variable vMaxLevel         like ub.pl-level-mm.max-level no-undo.
     3373   define variable vLevel            like ub.pl-level-mm.level no-undo.
     3374   define variable vCapacity         as   decimal              no-undo extent 9.
     3375   define buffer b_pl-level-mm for ub.pl-level-mm.
     3376   create "Excel.Application":U mExcelApplication no-error.
     3377   if error-status :error then
     3378   do:
     3379    return error "Ошибка при запуске Excel".
     3380   end.
     3381   ASSIGN
     3382    mExcelApplication:DisplayAlerts = NO
     3383    mWorkbook                       = mExcelApplication:WorkBooks:Add(fileImport)
     3384    mWorkSheet                      = mWorkbook:Sheets:Item(1)
     3385   .
     3386   if trim(mWorkSheet:Range("A1"):VALUE) <> "№ пояса" or
     3387      trim(mWorkSheet:Range("A2"):VALUE) = "" then
     3388   do:
     3389     return error "В выбранном файле нет таблиц поясов.~nТаблицы не загружены.".
     3390   end.
     3391   cntLine = 2.
     3392   IMP:
     3393   do transaction on error undo IMP, leave IMP:
     3394     repeat:
     3395       assign
     3396         vLine        = string(cntLine)
     3397         vZone        = mWorkSheet:Range("A" + vLine):VALUE
     3398         vMinLevel    = mWorkSheet:Range("B" + vLine):VALUE
     3399         vMaxLevel    = mWorkSheet:Range("C" + vLine):VALUE
     3400         vCapacity[1] = mWorkSheet:Range("D" + vLine):VALUE
     3401         vCapacity[2] = mWorkSheet:Range("E" + vLine):VALUE
     3402         vCapacity[3] = mWorkSheet:Range("F" + vLine):VALUE
     3403         vCapacity[4] = mWorkSheet:Range("G" + vLine):VALUE
     3404         vCapacity[5] = mWorkSheet:Range("H" + vLine):VALUE
     3405         vCapacity[6] = mWorkSheet:Range("I" + vLine):VALUE
     3406         vCapacity[7] = mWorkSheet:Range("J" + vLine):VALUE
     3407         vCapacity[8] = mWorkSheet:Range("K" + vLine):VALUE
     3408         vCapacity[9] = mWorkSheet:Range("L" + vLine):VALUE
     3409       no-error.
     3410       if error-status:error then
     3411       do:
     3412         vErr = "Ошибка при чтении строки: " + error-status:get-message(1).
     3413         undo IMP, leave IMP.
     3414       end.
     3415      find first b_pl-level-mm where
     3416                 b_pl-level-mm.obj-type  = p-obj-type
     3417             and b_pl-level-mm.obj-code  = p-obj-code
     3418             and b_pl-level-mm.pl-code   = p-pl-code
     3419             and ((b_pl-level-mm.min-level = vMinLevel and
     3420                   b_pl-level-mm.max-level = vMaxLevel) or
     3421                  (b_pl-level-mm.min-level <= vMinLevel and
     3422                   b_pl-level-mm.max-level >= vMinLevel and
     3423                   b_pl-level-mm.zone <> vZone) or
     3424                  (b_pl-level-mm.min-level <= vMaxLevel and
     3425                   b_pl-level-mm.max-level >= vMaxLevel and
     3426                   b_pl-level-mm.zone <> vZone))
     3427           no-lock no-error.
     3428       if avail b_pl-level-mm then
     3429       do:
     3430         vErr = substitute(
     3431           "Найдено пересечение поясов № &1 и № &2 по уровню пояса &3. Сохранение невозможно!~n",
     3432           b_pl-level-mm.zone, vZone, b_pl-level-mm.max-level)
     3433         .
     3434         undo IMP, leave IMP.
     3435       end.
     3436       if vZone = ? and vMinLevel = ? and vMaxLevel = ? then
     3437         leave IMP.
     3438       do vLevel = 1 to 9:
     3439         create b_pl-level-mm.
     3440         assign
     3441           b_pl-level-mm.obj-type  = p-obj-type
     3442           b_pl-level-mm.obj-code  = p-obj-code
     3443           b_pl-level-mm.pl-code   = p-pl-code
     3444           b_pl-level-mm.zone      = vZone
     3445           b_pl-level-mm.min-level = vMinLevel
     3446           b_pl-level-mm.max-level = vMaxLevel
     3447           b_pl-level-mm.level     = vLevel
     3448           b_pl-level-mm.capacity  = round(vCapacity[vLevel] * 1000, 0)
     3449         no-error.
     3450         if not error-status:error then
     3451           validate b_pl-level-mm no-error.
     3452         if error-status:error then
     3453         do:
     3454           vErr = "Ошибка при записи в БД: " + error-status:get-message(1).
     3455           undo IMP, leave IMP.
     3456         end.
     3457       end.
     3458       cntLine = cntLine + 1.
     3459     end.
     3460   end.
     3461   mExcelApplication:Quit().
     3462   release object mExcelApplication.
     3463   if vErr = "" then
     3464   do:
     3465     run refreshbrowse in this-procedure.
     3466     isUpdate = yes.
     3467   end.
     3468   else
     3469     return error vErr.
     3470   END PROCEDURE.
     3471   PROCEDURE importTxt :
     3472     define input parameter fileImport as character no-undo.
     3473     define variable cnt       as integer   no-undo.
     3474     define variable strImp    as character no-undo.
     3475     define variable strErr    as character no-undo.
     3476     define variable delim     as character no-undo.
     3477     define buffer buf_pl-level-mm for ub.pl-level-mm.
     3478     define buffer buf_place       for ub.place .
     3479     define variable v-user-name            as character no-undo .
     3480     define variable v-computer-name        as character no-undo .
     3481     define variable v-computer-login-name  as character no-undo .
     3482     define variable v-computer-process-pid as integer   no-undo .
     3483     define variable v-list-rates           as character no-undo.
     3484     define variable v-exist-pl-code        as logical   no-undo init no.
     3485     find first buf_place where
     3486                buf_place.obj-type = p-obj-type
     3487            and buf_place.obj-code = p-obj-code
     3488            and buf_place.pl-code  = p-pl-code
     3489          no-lock no-error.
     3490     input from value(search(fileImport)).
     3491     IMP:
     3492     do transaction on error undo IMP, leave IMP:
     3493       repeat:
     3494         strErr = "".
     3495         import unformatted strImp no-error.
     3496         if strImp = "" then next.
     3497         if delim = "" then
     3498         do:
     3499           if index(strImp," ") > 0 then
     3500             delim = " ".
     3501           else if index(strImp,chr(9)) > 0 then
     3502             delim = chr(9).
     3503         end.
     3504         if delim = "" or num-entries(strImp,delim) <> 6 then
     3505           strErr = "Неверный формат строки. Должно быть 6 атрибутов~n".
     3506         if strErr = "" and buf_place.loc1 = entry(1,strImp,delim) then
     3507         do:
     3508             v-exist-pl-code = yes.
     3509             find first buf_pl-level-mm where
     3510                        buf_pl-level-mm.obj-type  = p-obj-type
     3511                    and buf_pl-level-mm.obj-code  = p-obj-code
     3512                    and buf_pl-level-mm.pl-code   = p-pl-code
     3513                    and ((buf_pl-level-mm.min-level = dec(entry(3,strImp,delim)) and
     3514                          buf_pl-level-mm.max-level = dec(entry(4,strImp,delim)) and
     3515                          buf_pl-level-mm.level     = int(entry(5,strImp,delim))) or
     3516                         (buf_pl-level-mm.min-level <= dec(entry(3,strImp,delim)) and
     3517                          buf_pl-level-mm.max-level >= dec(entry(3,strImp,delim)) and
     3518                          buf_pl-level-mm.zone <> int(entry(2,strImp,delim))) or
     3519                         (buf_pl-level-mm.min-level <= dec(entry(4,strImp,delim)) and
     3520                          buf_pl-level-mm.max-level >= dec(entry(4,strImp,delim)) and
     3521                          buf_pl-level-mm.zone <> int(entry(2,strImp,delim))))
     3522                  no-lock no-error.
     3523             if avail buf_pl-level-mm then
     3524             do:
     3525               strErr = strErr + substitute(
     3526                 "Найдено пересечение поясов № &1 и № &2 по уровню пояса &3. Сохранение невозможно!~n",
     3527                 buf_pl-level-mm.zone, entry(2,strImp,delim), buf_pl-level-mm.max-level)
     3528               .
     3529             end.
     3530             if strErr = "" then
     3531             do:
     3532               create buf_pl-level-mm.
     3533               assign
     3534                 buf_pl-level-mm.obj-type  = p-obj-type
     3535                 buf_pl-level-mm.obj-code  = p-obj-code
     3536                 buf_pl-level-mm.pl-code   = p-pl-code
     3537                 buf_pl-level-mm.zone      = int(entry(2,strImp,delim))
     3538                 buf_pl-level-mm.min-level = dec(entry(3,strImp,delim))
     3539                 buf_pl-level-mm.max-level = dec(entry(4,strImp,delim))
     3540                 buf_pl-level-mm.level     = int(entry(5,strImp,delim))
     3541                 buf_pl-level-mm.capacity = dec(entry(6,strImp,delim)) * 1000
     3542               no-error.
     3543               if error-status:error then
     3544                 strErr = error-status:get-message(1).
     3545               validate buf_pl-level-mm no-error.
     3546               if error-status:error then
     3547                 strErr = error-status:get-message(1).
     3548             end.
     3549         end.
     3550         if strErr <> "" then do:
     3551           undo IMP, leave IMP.
     3552         end.
     3553       end.
     3554     end.
     3555     input close.
     3556     strErr = right-trim(StrErr,"~n").
     3557     if strErr = "" then
     3558     do:
     3559       if v-exist-pl-code then
     3560       do:
     3561           run refreshbrowse in this-procedure.
     3562           isUpdate = yes.
     3563       end.
     3564       else
     3565       do:
     3566         strErr = substitute("В файле нет таблицы поясов для резервуара &1 &2 &3 (&4).~nТаблицы не загружены"
     3567                             , p-obj-type
     3568                             , p-obj-code
     3569                             , p-pl-code
     3570                             , buf_place.loc1).
     3571         return error strErr.
     3572       end.
     3573     end.
     3574     else
     3575       return error strErr.
     3576   END PROCEDURE.
     3577   PROCEDURE refreshbrowse :
     3578      run enable_UI.
     3579      if avail buf_pl-level-mm then
     3580        apply "ENTRY" to br-pl-level-mm in frame f-pl-level-mm.
     3581   END PROCEDURE.
