     3015             on end-move persistent run diasize_end-move in this-procedure .
     3016           end triggers.
     3017         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3018         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3019         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3020         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3021         assign
     3022           v-diasize-wndmax = false
     3023         .
     3024         if connected("ub") = true
     3025         then do:
     3026           define variable v-cntxt-db-num        as integer   no-undo .
     3027           define variable v-cntxt-userid        as character no-undo .
     3028           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3029                                             , OUTPUT v-cntxt-userid
     3030                                             ) .
     3031           run gbl/wndpar_r.p
     3032             (input  v-cntxt-db-num
     3033             ,input  v-cntxt-userid
     3034             ,input  'wndmax':U
     3035             ,output v-diasize-wndmax
     3036             ,output v-default-value
     3037             ) .
     3038         end.
     3039         assign
     3040           v-diasize-wndstore = false
     3041         .
     3042         if connected("ub") = true
     3043         then do:
     3044           run gbl/wndpar_r.p
     3045             (input  v-cntxt-db-num
     3046             ,input  v-cntxt-userid
     3047             ,input  'wndstore':U
     3048             ,output v-diasize-wndstore
     3049             ,output v-default-value
     3050             ) .
     3051         end.
     3052         assign
     3053           v-diasize-proc-name = entry(1, program-name(2), '.')
     3054         .
     3055         if v-diasize-wndstore = true
     3056         then do:
     3057           assign
     3058             v-restore-saved = false
     3059           .
     3060           if connected("ub") = true
     3061           then do:
     3062             run gbl/wndsizer.p
     3063               (input  v-cntxt-db-num
     3064               ,input  v-cntxt-userid
     3065               ,input  v-diasize-proc-name
     3066               ,input  'height':u
     3067               ,output v-resize-value-str
     3068               ) .
     3069             if v-resize-value-str <> '':U
     3070             then do:
     3071               run diasize_change-height in this-procedure
     3072                 (input  integer(v-resize-value-str)
     3073                 ,input  true
     3074                 ) .
     3075               assign
     3076                 v-restore-saved = true
     3077               .
     3078             end.
     3079           end.
     3080           if connected("ub") = true
     3081           then do:
     3082             run gbl/wndsizer.p
     3083               (input  v-cntxt-db-num
     3084               ,input  v-cntxt-userid
     3085               ,input  v-diasize-proc-name
     3086               ,input  'width':u
     3087               ,output v-resize-value-str
     3088               ) .
     3089             if v-resize-value-str <> '':U
     3090             then do:
     3091               run diasize_change-width in this-procedure
     3092                 (input  integer(v-resize-value-str)
     3093                 ,input  true
     3094                 ) .
     3095               assign
     3096                 v-restore-saved = true
     3097               .
     3098             end.
     3099           end.
     3100           if v-restore-saved <> true
     3101           then do:
     3102             if v-diasize-wndmax = true
     3103             then do:
     3104               run diasize_maximize in this-procedure
     3105                 (input  true
     3106                 ) .
     3107             end.
     3108           end.
     3109         end.
     3110         else do:
     3111           if v-diasize-wndmax = true
     3112           then do:
     3113             run diasize_maximize in this-procedure
     3114               (input  true
     3115               ) .
     3116           end.
     3117         end.
     3118       end.
     3119     end.
     3120   end procedure.
     3121   procedure diasize_need-full-display :
