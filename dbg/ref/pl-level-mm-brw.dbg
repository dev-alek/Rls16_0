     1230       End.
     1231       run gbl/prnfilen.w
     1232         (input  ""
     1233         ,input  p-DisabledOptions
     1234         ,input  string(v-report-name )
     1235         ,input  7
     1236         ,output v-user-action
     1237         ,output v-printed
     1238         ) .
