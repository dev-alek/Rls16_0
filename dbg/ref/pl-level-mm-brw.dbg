     1249   procedure prn-lib-open-stream :
     1250     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1251     define input parameter p-page-size    as integer no-undo .
     1252     define input parameter p-is-stream    as logical no-undo .
     1253     define input parameter p-append       as logical no-undo .
     1254     define variable v-report-name as character no-undo .
     1255     do
     1256       on error undo, return error
     1257       :
     1258       run prn-lib-get-report-name  in this-procedure (
     1259         input parParentProc
     1260         ,output v-report-name
     1261         ).
     1262       if p-is-stream then
     1263       do:
     1264         if p-append then
     1265         do:
     1266           output stream PrnLibStream to value( v-report-name )
     1267             page-size value(p-page-size) append .
     1268         end.
     1269         if not p-append then
     1270         do:
     1271           output stream PrnLibStream to value( v-report-name )
     1272             page-size value(p-page-size) .
     1273         end.
     1274       end.
     1275       if not p-is-stream then
     1276       do:
     1277         if p-append then
     1278         do:
     1279           output to value( v-report-name )
     1280             page-size value(p-page-size) append .
     1281         end.
     1282         if not p-append then
     1283         do:
     1284           output to value( v-report-name )
     1285             page-size value(p-page-size) .
     1286         end.
     1287       end.
     1288     end.
     1289   end procedure.
     1290   procedure prn-lib-open-exp :
     1291     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1292     define input parameter p-is-stream    as logical no-undo .
     1293     define input parameter p-is-append    as logical no-undo .
     1294     define output parameter p-ReportFileName as char init "report" no-undo.
     1295     define output parameter p-process as logical no-undo .
     1296     define variable glog as logical no-undo .
     1297     do
     1298       on error undo, return error
     1299       :
     1300       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1301         TITLE      "Укажите путь"
     1302         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1303         ASK-OVERWRITE
     1304         CREATE-TEST-FILE
     1305         SAVE-AS
     1306         USE-FILENAME
     1307         DEFAULT-EXTENSION "txt"
     1308         UPDATE glog
     1309         .
     1310       if not glog then  return.
     1311       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1312       if p-is-stream then
     1313       do:
     1314         if p-is-append then
     1315         do:
     1316           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1317         end.
     1318         else
     1319         do:
     1320           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1321         end.
     1322       end.
     1323       else
     1324       do:
     1325         if p-is-append then
     1326         do:
     1327           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1328         end.
     1329         else
     1330         do:
     1331           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1332         end.
     1333       end.
     1334       p-process = yes.
     1335     end.
     1336   end procedure.
     1337   procedure prn-lib-get-report-name :
     1338     define input parameter parParentProc  as widget-handle no-undo.
     1339     define output parameter p-report-name as character no-undo .
     1340     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1341   end procedure.
     1342   procedure prn-lib-reportviewer-report-name :
     1343     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1344     define input parameter p-report-name-html as character no-undo .
     1345     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
