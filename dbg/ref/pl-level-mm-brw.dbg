     1203   define  stream PrnLibStream.
     1204   procedure prn-lib-prn-file :
     1205     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1206     define input parameter p-DIsabledoptions as integer no-undo .
     1207     define variable v-report-name as character no-undo .
     1208     define variable v-user-action as character no-undo .
     1209     define variable v-printed     as logical   no-undo .
     1210     define variable v-exist       as logical   no-undo .
     1211     do
     1212       on error undo, return error
     1213       :
     1214       run prn-lib-get-report-name  in this-procedure (
     1215         input parParentProc
     1216         ,output v-report-name
     1217         ).
     1218   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1219   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1220     (input  v-report-name
     1221     ,input  2
     1222     ,output v-exist
     1223     )  .
