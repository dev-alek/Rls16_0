     3134   procedure get-context :
     3135      define output parameter p-db-num as integer          no-undo.
     3136      define output parameter p-user-id as character        no-undo.
     3137      define variable v-login               as character    no-undo.
     3138      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3139      define buffer buf_user-login  for ub.user-login .
     3140      do
     3141      on error undo, return error
     3142      :
     3143            FIND FIRST buf_sys-ctrl no-lock.
     3144            ASSIGN
     3145               v-login = USERID("ub")
     3146               p-db-num = buf_sys-ctrl.db-num
     3147            .
     3148            FIND FIRST buf_user-login
     3149                 WHERE buf_user-login.db-num = p-db-num
     3150                   AND buf_user-login.user-login = v-login
     3151                 no-lock
     3152                 no-error
     3153                 .
     3154            IF AVAILABLE buf_user-login
     3155            THEN DO:
     3156               assign
     3157                  p-user-id = buf_user-login.user-id
     3158               .
     3159            END.
     3160      end.
     3161   end procedure.
