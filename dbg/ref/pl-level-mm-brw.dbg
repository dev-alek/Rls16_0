     1347   procedure prn-lib-reportviewer :
     1348     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1349     define input parameter p-report-name-html as character no-undo .
     1350     define input parameter p-param        as character no-undo .
     1351     define variable v-excel           as character no-undo init 'TRUE' .
     1352     define variable v-value-character as character no-undo .
     1353     define variable v-value-integer   as character no-undo .
     1354     define variable v-value-date      as date      no-undo .
     1355     define variable v-value-decimal   as decimal   no-undo .
     1356     define variable rep-excel         as logical   no-undo .
     1357     define variable excel-string      as character no-undo .
     1358     define variable v-param-type      as character no-undo .
     1359     define variable v-tth             as handle    no-undo .
     1360     run adm/shattri.p (
     1361       input "get":U
     1362       ,input  ""
     1363       ,input  0
     1364       ,input  'report-glob':U
     1365       ,input  'rep-excel':U
     1366       ,output v-value-character
     1367       ,output v-value-date
     1368       ,output v-value-decimal
     1369       ,output v-value-integer
     1370       ,output rep-excel
     1371       ,output v-param-type
     1372       ,INPUT-OUTPUT table-handle v-tth
     1373       )  .
     1374     if rep-excel then v-excel = "TRUE" .
     1375     else v-excel = "FALSE" .
     1376     if p-param eq ""
     1377     then
     1378        p-param = "EXCEL:" + v-excel.
     1379     else
     1380        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1381     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1382   end procedure.
     1383   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1384   define variable v-waitfram-action01         as character   no-undo .
     1385   define variable v-waitfram-action02         as character   no-undo .
     1386   define variable v-waitfram-action03         as character   no-undo .
     1387   define variable mWaitFramTextBeg            as character   no-undo.
     1388   define variable mWaitFramTextEnd            as character   no-undo.
     1389   define variable mWaitFramView               as logical     no-undo.
     1390   define variable mWaitProcEvent              as logical     no-undo init yes.
     1391   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1392   define variable mWaitFramStop               as logical     no-undo.
     1393   define variable mWaitFramStopUser           as logical     no-undo.
     1394   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1395   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1396   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1397   define button B-WaitFramStop auto-end-key
     1398        label "Стоп"
     1399        size 10 by 1 tooltip "Остоновить процесс".
     1400   define button B-viewProcInfo
     1401        label "Информация"
     1402        size 15 by 1 tooltip "Информация о процесс".
     1403   define frame waitfram
     1404     v-waitfram-action01 format "x(72)" no-label skip
     1405     v-waitfram-action02 format "x(72)" no-label skip
     1406     v-waitfram-action03 format "x(72)" no-label skip
     1407     B-viewProcInfo
     1408     B-WaitFramStop at row 4 col 30
     1409     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1410     .
     1411   define new global shared variable mBatchMode as logical no-undo init ?.
     1412   define variable mFramBachModHandle as handle no-undo.
     1413   mFramBachModHandle = frame waitfram:handle.
     1414   define variable mFameOldVis as logical no-undo.
     1415   define variable mVisCUrentVin as logical no-undo.
     1416   if session:batch-mode
     1417   then
     1418      mBatchMode = yes.
     1419   if mBatchMode = ? then do:
     1420     mVisCUrentVin = current-window:visible.
     1421     mFameOldVis = mFramBachModHandle:visible.
     1422     mFramBachModHandle:visible  = yes.
     1423     mBatchMode = mFramBachModHandle:visible ne yes.
     1424     mFramBachModHandle:visible = mFameOldVis.
     1425     current-window:visible = mVisCUrentVin.
     1426   end.
     1427    if  log-manager:logfile-name ne ?
     1428     then DO:
     1429         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1430         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1431         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1432     end.
     1433   on choose of B-WaitFramStop in frame waitfram
     1434   do:
     1435     mWaitFramStop = yes.
     1436     mWaitFramStopUser = yes.
     1437   end.
     1438   function waitfram-check-timeout returns logical():
     1439      define variable vtime as int64 no-undo.
     1440      if mWaitFramStopTimeOut
     1441      then
     1442         return yes.
     1443      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1444      if     mWaitFramTimeOut ne ?
     1445         and mWaitFramTimeOut ne 0
     1446         and mWaitFramTimeOut lt vtime
     1447      then do:
     1448         mWaitFramStopTimeOut = yes.
     1449      end.
     1450      return mWaitFramStopTimeOut.
     1451   end.
     1452   procedure waitfram-hide :
     1453     if not session:batch-mode
     1454     then do
     1455     on error undo, return error return-value
     1456     :
     1457       pause 0 before-hide .
     1458       if not mBatchMode then
     1459         hide frame waitfram .
     1460     if     not mWaitFramView
     1461        and mWaitProcEvent
     1462     then
     1463       process events .
     1464     end.
     1465   end procedure.
     1466   procedure waitfram-show :
     1467     define input  parameter p-message as character no-undo .
     1468     define variable v-left-margin as integer   no-undo .
     1469     if not session:batch-mode
     1470     then do
     1471     on error undo, return error return-value
     1472     :
     1473       if length(p-message) <= 70 then do:
     1474         assign
     1475           v-left-margin = integer((70 - length(p-message)) / 2)
     1476         .
     1477         assign
     1478           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1479         .
     1480         assign
     1481           v-waitfram-action01 = " "
     1482           v-waitfram-action02 = " "
     1483                                    + fill(" ", v-left-margin)
     1484                                    + p-message
     1485           v-waitfram-action03 = " "
     1486         .
     1487       end.
     1488       else do:
     1489         define variable vRindex1 as integer no-undo.
     1490         define variable vRindex2 as integer no-undo.
     1491         vRindex1 = r-index(p-message," ",70).
     1492         if vRindex1 = 0
     1493         then
     1494            vRindex1 = 70.
     1495         if length(p-message)  <= vRindex1 + 70 then do:
     1496           assign
     1497             v-waitfram-action01 = " "
     1498             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1499             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1500           .
     1501         end.
     1502         else do:
     1503           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1504           if vRindex2 <= vRindex1
     1505           then
     1506              vRindex2 = vRindex1 + 70.
     1507           assign
     1508             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1509             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1510             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1511           .
     1512         end.
     1513       end.
     1514       B-viewProcInfo:visible   in frame waitfram = no.
     1515       B-viewProcInfo:sensitive in frame waitfram = no.
     1516       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1517       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1518       if  (   mWaitFramView
     1519          or  mWaitProcEvent)
     1520          and not mBatchMode
     1521       then
     1522          display
     1523             v-waitfram-action01 skip
     1524             v-waitfram-action02 skip
     1525             v-waitfram-action03 skip
     1526          with frame waitfram .
     1527       if     mWaitFramView
     1528          then do:
     1529             if     mWaitFramInterval ne ?
     1530                and not mBatchMode
     1531             then
     1532                wait-for go of frame waitfram pause mWaitFramInterval.
     1533          end.
     1534          else
     1535             if     mWaitProcEvent
     1536                and not mBatchMode
     1537             then
     1538                process events .
     1539     end.
     1540   end procedure.
     1541      procedure waitfram-show-this:
     1542         define input  parameter iInterval as int64 no-undo.
     1543         define variable vtime as int64 no-undo.
     1544         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1545         mWaitFramInterval = iInterval.
     1546         run waitfram-show (substitute("&1&2 &3&4" ,
     1547                                       mWaitFramTextBeg ,
     1548                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1549                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1550                                       mWaitFramTextEnd
     1551                                      )
     1552                           ).
     1553      end.
     1554      procedure WaitFramRunPause:
     1555         define input  parameter iInterval as dec no-undo.
     1556         define variable vStart  as datetime-tz no-undo.
     1557         define variable vend    as datetime-tz no-undo.
     1558         define variable vint as int64 no-undo.
     1559         define variable vOk as logical no-undo.
     1560         vStart = now.
     1561         vend   = vStart.
     1562         publish "WaitFramPause" (iInterval,output vOk).
     1563         vend   =  now.
     1564         vint = vend - vStart.
     1565         vint = iInterval - vint / 1000.
     1566         if     not mWaitFramStop
     1567            and (   vint > 0
     1568                 or (    not vOk
     1569                     and iInterval eq ?
     1570                     )
     1571                 )
     1572         then
     1573            run waitfram-show-this (iInterval).
     1574         vend   =  now.
     1575         vint = vend - vStart.
     1576         vint = iInterval - vint / 1000.
     1577         if     not mWaitFramStop
     1578            and vint > 0
     1579         then do:
     1580            run gbl/pause.p (vint * 1000).
     1581         end.
     1582         if iInterval ne ?
     1583         then
     1584            publish "WaitFramStop".
     1585         waitfram-check-timeout().
     1586      end.
     1587      procedure WaitFramWaitFor:
     1588         define input  parameter iInterval as dec no-undo.
     1589         assign
     1590            mWaitFramStartProc   = now
     1591            mWaitFramStopUser    = no
     1592            mWaitFramStopTimeOut = no
     1593         .
     1594         block-wait:
     1595         do while not mWaitFramStop:
     1596            run WaitFramRunPause (iInterval).
     1597            if  waitfram-check-timeout()
     1598            then do:
     1599               leave block-wait.
     1600            end.
     1601         end.
     1602         run waitfram-hide.
     1603      end.
     1604   procedure waitfram-join :
     1605     define input  parameter p-line-1  as character no-undo .
     1606     define input  parameter p-line-2  as character no-undo .
     1607     define input  parameter p-line-3  as character no-undo .
     1608     define output parameter p-message as character no-undo .
     1609     do
     1610     on error undo, return error return-value
     1611     :
     1612       assign
     1613         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1614                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1615                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1616       .
     1617     end.
     1618   end procedure.
     1619   function waitfram-join-function returns character
     1620     (input p-line-1 as character
     1621     ,input p-line-2 as character
     1622     ,input p-line-3 as character
     1623     ).
     1624     define variable v-message as character no-undo .
     1625     run waitfram-join in this-procedure
     1626       (input  p-line-1
     1627       ,input  p-line-2
     1628       ,input  p-line-3
     1629       ,output v-message
     1630       ) .
     1631     return v-message .
     1632   end function .
     1633   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1634   FUNCTION mark-string RETURNS CHARACTER
     1635     ( input p-recid as recid, input mark-list as character  ) :
     1636     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1637   END FUNCTION.
     1638   define variable isUpdate            as logical no-undo init no.
     1639   define variable v-chk-act-host-code as integer no-undo.
     1640   define variable ri                  as recid   no-undo.
     1641   define variable isRights            as logical no-undo.
     1642   define variable v-new               as logical no-undo init no .
     1643   define variable v-ok                as logical no-undo .
     1644   define buffer buf_pl-level-mm for ub.pl-level-mm.
     1645   define buffer buf_place       for ub.place.
     1646   DEFINE BUTTON b-add
     1647        LABEL "&Добавить":L
     1648        SIZE 12 BY 1.
     1649   DEFINE BUTTON b-clear
     1650        LABEL "&Очистить":L
     1651        SIZE 12 BY .95.
     1652   DEFINE BUTTON b-del
     1653        LABEL "&Удалить":L
     1654        SIZE 12 BY 1.
     1655   DEFINE BUTTON b-exit AUTO-GO
     1656        LABEL "&Выход ":L
     1657        SIZE 10 BY 1.
     1658   DEFINE BUTTON b-help
     1659        LABEL "Помо&щь"
     1660        SIZE 10 BY 1
     1661        BGCOLOR 8 .
     1662   DEFINE BUTTON b-load
     1663        LABEL "&Загрузить":L
     1664        SIZE 12 BY 1.
     1665   DEFINE BUTTON b-upd
     1666        LABEL "&Изменить":L
     1667        SIZE 12 BY 1.
     1668   DEFINE QUERY br-pl-level-mm FOR
     1669         buf_pl-level-mm SCROLLING.
     1670   DEFINE BROWSE br-pl-level-mm
     1671     QUERY br-pl-level-mm DISPLAY
     1672         buf_pl-level-mm.zone COLUMN-LABEL "Номер пояса" FORMAT ">>>>>>9":U
     1673     buf_pl-level-mm.min-level COLUMN-LABEL "Нижний уровень,см" FORMAT ">>>>>>9":U
     1674     buf_pl-level-mm.max-level COLUMN-LABEL "Верхний уровень,см" FORMAT ">>>>>>9":U
     1675     buf_pl-level-mm.level COLUMN-LABEL "Уровень,мм" FORMAT ">>>>>>9":U
     1676     buf_pl-level-mm.capacity COLUMN-LABEL "Поясная вместимость, л" FORMAT ">>>>>>9":U
     1677       WITH SEPARATORS SIZE 83 BY 14.38 ROW-HEIGHT-CHARS .62.
     1678   DEFINE FRAME f-pl-level-mm
     1679        b-exit AT ROW 1.24 COL 2.6
     1680        b-add AT ROW 1.24 COL 13.6
     1681        b-upd AT ROW 1.24 COL 25.6
     1682        b-del AT ROW 1.24 COL 37.6 WIDGET-ID 2
     1683        b-load AT ROW 1.24 COL 49.6 WIDGET-ID 22
     1684        b-clear AT ROW 1.24 COL 61.6 WIDGET-ID 6
     1685        b-help AT ROW 1.24 COL 75.6 WIDGET-ID 24
     1686        br-pl-level-mm AT ROW 2.43 COL 1
     1687        SPACE(1.99) SKIP(0.80)
     1688       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1689            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1690            TITLE "Таблица поясов для резервуара":L.
     1691   ASSIGN
     1692          FRAME f-pl-level-mm:SCROLLABLE       = FALSE.
     1693   ON CHOOSE OF b-exit IN FRAME f-pl-level-mm
     1694       DO:
     1695           if AVAILABLE (buf_pl-level-mm) and isUpdate then
     1696           do:
     1697             if v-new
     1698             then do :
     1699               message "Внимание! После подтверждения завершения работы по вводу данных дальнейшая корректировка таблицы поясов резервуара будет возможна только в ИС УРТ. Подтвердите завершение работы!"
     1700               view-as alert-box question buttons yes-no update v-ok .
     1701               if not v-ok
     1702               then do :
     1703                 return no-apply .
     1704               end .
     1705             end .
     1706   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     1707     (input ?
     1708     ,input this-procedure:handle
     1709     ,input ?
     1710     ,input 'ref-event':U
     1711     ,input  buffer buf_pl-level-mm:handle
     1712     ,input  buffer buf_pl-level-mm:handle
     1713     ,input ''
     1714     ,input ''
     1715     ) no-error .
     1716               if error-status :error
     1717                   then
     1718               do:
     1719                   message
     1720                       error-status:get-message(1) skip
     1721                       return-value
     1722                       view-as alert-box error .
     1723                   return no-apply .
     1724               end.
     1725           end.
     1726       END.
     1727   ON CHOOSE OF b-add IN FRAME f-pl-level-mm
     1728   DO:
     1729      ri = ?.
     1730      run ref/pl-level-mm-frm.w (input parparentproc
     1731                               , p-obj-type
     1732                               , p-obj-code
     1733                               , p-pl-code
     1734                               , buf_place.loc1
     1735                               , input 'ДОБАВЛЕНИЕ':U
     1736                               , input-output ri).
     1737      run refreshbrowse.
     1738      isUpdate = yes.
     1739   END.
     1740   ON CHOOSE OF b-clear IN FRAME f-pl-level-mm
     1741   DO:
     1742     define buffer b_pl-level-mm for ub.pl-level-mm.
     1743     define variable v-ok as logical no-undo.
     1744     if not avail buf_pl-level-mm then return no-apply.
     1745     message
     1746       "Удалить все записи для выбранного резервуара?"
     1747       view-as alert-box question
     1748       BUTTONS yes-no
     1749       TITLE "Подтвердить"
     1750       UPDATE v-ok .
     1751     if not v-ok then return no-apply.
     1752     _DEL:
     1753     do transaction
     1754        on error undo _DEL, return
     1755        on stop undo _DEL, return:
     1756       for each b_pl-level-mm where
     1757                b_pl-level-mm.obj-type = p-obj-type
     1758            and b_pl-level-mm.obj-code = p-obj-code
     1759            and b_pl-level-mm.pl-code = p-pl-code
     1760            exclusive-lock:
     1761         delete b_pl-level-mm no-error.
     1762         if error-status:error then
     1763         do:
     1764           message
     1765              return-value skip
     1766              "Очищение отменено."
     1767              view-as alert-box.
     1768           undo _DEL, return.
     1769         end.
     1770       end.
     1771       run refreshbrowse.
     1772       isUpdate = yes.
     1773     end.
     1774   END.
     1775   ON CHOOSE OF b-del IN FRAME f-pl-level-mm
     1776   DO:
     1777     define buffer b_pl-level-mm for ub.pl-level-mm.
     1778     define variable v-ok as logical no-undo.
     1779     if not avail buf_pl-level-mm then return no-apply.
     1780     message
     1781       "Удалить запись?"
     1782       view-as alert-box question
     1783       BUTTONS yes-no
     1784       TITLE "Подтвердить"
     1785       UPDATE v-ok .
     1786     if not v-ok then return no-apply.
     1787     do on error undo, return
     1788     on stop undo, return:
     1789       find first b_pl-level-mm where recid(b_pl-level-mm) = recid(buf_pl-level-mm) exclusive-lock no-error.
     1790       if avail b_pl-level-mm then
     1791       do:
     1792         delete b_pl-level-mm no-error.
     1793         if error-status:error then
     1794         do:
     1795         message
     1796            return-value
     1797            view-as alert-box.
     1798            return no-apply.
     1799         end.
     1800         ri = ?.
     1801         run refreshbrowse.
     1802         isUpdate = yes.
     1803       end.
     1804       else do:
     1805         message
     1806           "Запись занята другим пользователем?" skip
     1807           "Попробуйте позже."
     1808            view-as alert-box.
     1809       end.
     1810     end.
     1811   END.
     1812   ON CHOOSE OF b-load IN FRAME f-pl-level-mm
     1813   DO:
     1814     define variable fileImport as character no-undo .
     1815     define variable isOk       as logical   no-undo .
     1816     define buffer bf_pl-level-mm for ub.pl-level-mm.
     1817     if can-find(first bf_pl-level-mm where
     1818                     bf_pl-level-mm.obj-type = p-obj-type
     1819                 and bf_pl-level-mm.obj-code = p-obj-code
     1820                 and bf_pl-level-mm.pl-code  = p-pl-code) then
     1821     do:
     1822       message "Для резервуара уже есть данные поясной вместимости." skip
     1823               "Для загрузки новых данных очистите таблицу."
     1824               view-as alert-box message
     1825               buttons ok
     1826               title "Ошибка импорта".
     1827       return no-apply.
     1828     end.
     1829     system-dialog get-file fileImport
     1830       filters "Файл импорта (*.txt,*.xlsx)" "*.txt;*.xlsx"
     1831       title "Выберите имя файла для импорта"
     1832       update isOk
     1833     .
     1834     if isOk and fileImport <> "" then
     1835     do:
     1836       case entry(num-entries(fileImport,"."),fileImport,"."):
     1837         when "txt" then
     1838         do:
     1839           run importTxt in this-procedure (fileImport) no-error.
     1840         end.
     1841         when "xlsx" then
     1842         do:
     1843           run importExcel in this-procedure (fileImport) no-error.
     1844         end.
     1845         otherwise
     1846         do:
     1847           return-value = "Неизвестный формат файла!".
     1848         end.
     1849       end case.
     1850       if error-status:error or return-value <> "" then
     1851       do:
     1852         message error-status:get-message(1)
     1853                 return-value
     1854                 view-as alert-box message
     1855                 buttons ok
     1856                 title "Ошибка импорта".
     1857         return no-apply.
     1858       end.
     1859     end.
     1860     else do:
     1861       return no-apply.
     1862     end.
     1863   END.
     1864   ON CHOOSE OF b-upd IN FRAME f-pl-level-mm
     1865   DO:
     1866      ri = recid(buf_pl-level-mm).
     1867      run ref/pl-level-mm-frm.w (
     1868                               input parparentproc
     1869                               , p-obj-type
     1870                               , p-obj-code
     1871                               , p-pl-code
     1872                               , buf_place.loc1
     1873                               , input if replace(b-upd:label,"&","") = "Изменить"
     1874                                       then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U
     1875                               , input-output ri).
     1876      run refreshbrowse.
     1877      isUpdate = yes.
     1878   END.
     1879   ON RETURN OF br-pl-level-mm IN FRAME f-pl-level-mm
     1880   DO:
     1881       apply "DEFAULT-ACTION":U to self.
     1882   END.
     1883   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME f-pl-level-mm:PARENT eq ?
     1884     THEN FRAME f-pl-level-mm:PARENT = ACTIVE-WINDOW.
     1885   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1886   on help of frame f-pl-level-mm
     1887   do:
     1888     run gbl/app_help.p
     1889       (input this-procedure :file-name
     1890       ,input ''
     1891       ,input ?
     1892       ) no-error.
     1893     if error-status :error then do:
     1894       message
     1895         "Ошибка при вызове помощи"
     1896         error-status :get-message(1)
     1897         view-as alert-box .
     1898     end.
     1899   end.
     1900   run minbtn-set in this-procedure .
     1901   on choose of b-help in frame f-pl-level-mm
     1902   do:
     1903     apply "help":u to frame f-pl-level-mm .
     1904   end.
     1905   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1906   procedure minbtn-set :
     1907       do
     1908           on error undo, return error return-value
     1909           :
     1910           define variable ii              as integer       no-undo .
     1911           define variable fh              as widget-handle no-undo .
     1912           define variable hh              as widget-handle no-undo .
     1913           define variable v-h             as handle        extent 4 no-undo .
     1914           define variable v-name-button   as character     no-undo .
     1915           define variable v-help-old-x    as decimal       no-undo .
     1916           define variable v-help-old-y    as decimal       no-undo .
     1917           define variable v-help-old-size as decimal       no-undo .
     1918           define variable v-frame-width   as decimal       no-undo .
     1919           define variable jj              as integer       no-undo .
     1920           do
     1921               on error undo, return error
     1922               :
     1923               assign
     1924                   v-frame-width = frame f-pl-level-mm:width - 0.3
     1925                   fh            = frame f-pl-level-mm:first-child
     1926                   hh            = fh:first-child
     1927                   ii            = 1
     1928                   .
     1929               do while valid-handle(hh):
     1930                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1931                   do:
     1932                       case lc(hh:name) :
     1933                           when "b-help" then
     1934                               do:
     1935                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1936                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1937                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1938                                   hh:TOOLTIP = "Помощь" .
     1939                                   v-help-old-x = hh:column .
     1940                                   v-help-old-y = hh:row    .
     1941                                   v-help-old-size = hh:width .
     1942                                   hh:width-chars = 2.5 .
     1943                               end.
     1944                           when "b-print" then
     1945                               do:
     1946                                   hh:load-image("cmp/b-print.bmp":u) .
     1947                                   hh:TOOLTIP = "Печать" .
     1948                                   v-h[ii] = hh:handle .
     1949                                   ii = ii + 1 .
     1950                                   hh:width-chars = 3 .
     1951                               end.
     1952                           when "b-history" or
     1953                           when "b-hist" then
     1954                               do:
     1955                                   hh:load-image("cmp/b-hist.bmp":u) .
     1956                                   hh:TOOLTIP = "История" .
     1957                                   v-h[ii] = hh:handle .
     1958                                   ii = ii + 1 .
     1959                                   hh:width-chars = 3 .
     1960                               end.
     1961                           when "b-sch" then
     1962                               do:
     1963                                   hh:load-image("cmp/b-sch.bmp":u) .
     1964                                   hh:TOOLTIP = "Установка Фильтра" .
     1965                                   v-h[ii] = hh:handle .
     1966                                   ii = ii + 1 .
     1967                                   hh:width-chars = 3 .
     1968                               end.
     1969                           when "b-hist-user" then
     1970                               do:
     1971                                   hh:load-image("cmp/b-hist.bmp":u) .
     1972                                   hh:TOOLTIP = "История пользователя" .
     1973                                   ii = ii + 1 .
     1974                               end.
     1975                       end case.
     1976                   end.
     1977                   hh = hh:next-sibling.
     1978               end.
     1979               b-help:column = v-frame-width - b-help:width-chars.
     1980               jj = 0.
     1981               repeat ii = 4 to 1 by -1 :
     1982                   if valid-handle (v-h[ii] ) then
     1983                   do:
     1984                       jj  = jj + 1 .
     1985                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1986                       v-h[ii]:row    = v-help-old-y .
     1987                   end.
     1988               end.
     1989           end.
     1990       end.
     1991   end procedure.
     1992   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1993   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1994   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1995   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1996   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1997   define variable v-diasize-current-frame-height as decimal   no-undo .
     1998   define variable v-diasize-change-size          as logical   no-undo .
     1999   define variable v-diasize-resize-button        as handle    no-undo .
     2000   define variable v-diasize-wndmax               as logical   no-undo .
     2001   define variable v-diasize-wndstore             as logical   no-undo .
     2002   define variable v-diasize-proc-name            as character no-undo .
     2003   define variable v-diasize-browse-handle        as handle    no-undo .
     2004   define variable v-diasize-browse-number        as integer   no-undo .
     2005   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2006   define temp-table temp-diasize-handle no-undo
     2007     field handle-value  as handle
     2008     field save-position as decimal
     2009     index xpk is primary unique handle-value
     2010     .
     2011   define temp-table temp-browse-handle no-undo
     2012     field browse-type   as character
     2013     field browse-number as integer
     2014     field browse-handle as handle
     2015     field original-size as decimal
     2016     index xpk is primary unique browse-type browse-number
     2017     index xie browse-type browse-handle
     2018   .
     2019   procedure diasize_change-height :
     2020     define input  parameter p-change-value  as decimal   no-undo .
     2021     define input  parameter p-move-resize   as logical   no-undo .
     2022     define variable v-field-group-handle    as handle    no-undo .
     2023     define variable v-object-handle         as handle    no-undo .
     2024     define variable v-frame-height          as decimal   no-undo .
     2025     define variable v-frame-virtual-height  as decimal   no-undo .
     2026     define variable v-browse-height         as decimal   no-undo .
     2027     define variable v-window-height         as decimal   no-undo .
     2028     define variable v-window-virtual-height as decimal   no-undo .
     2029     define variable v-change-sign           as integer   no-undo .
     2030     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2031     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2032     if p-change-value > 0
     2033     then do:
     2034       if frame f-pl-level-mm :height + p-change-value
     2035           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2036       then do:
     2037         assign
     2038           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2039                           - (frame f-pl-level-mm :height-chars)
     2040         .
     2041         if p-change-value <= 0
     2042         then do:
     2043           run diasize_position-resize-button in this-procedure .
     2044           return .
     2045         end.
     2046       end.
     2047     end.
     2048     if p-change-value < 0
     2049     then do:
     2050       if frame f-pl-level-mm :height + p-change-value < v-diasize-orig-frame-height
     2051       then do:
     2052         assign
     2053           p-change-value = v-diasize-orig-frame-height
     2054                          - (frame f-pl-level-mm :height-chars)
     2055         .
     2056         if p-change-value >= 0
     2057         then do:
     2058           run diasize_position-resize-button in this-procedure .
     2059           return .
     2060         end.
     2061       end.
     2062     end.
     2063     if p-change-value >= 0
     2064     then do:
     2065       assign
     2066         v-change-sign = 1
     2067       .
     2068     end.
     2069     else do:
     2070       assign
     2071         v-change-sign = -1
     2072       .
     2073     end.
     2074     assign
     2075       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2076     .
     2077     if p-change-value = 0
     2078     then do:
     2079       run diasize_position-resize-button in this-procedure .
     2080       return .
     2081     end.
     2082     move_block:
     2083     do
     2084     on error undo move_block, retry move_block
     2085     :
     2086       if retry
     2087       then do:
     2088         do
     2089         on error undo move_block, leave move_block
     2090         :
     2091           if p-change-value > 0
     2092           then do:
     2093             for each buf_temp-diasize-handle
     2094             on error undo, next
     2095             :
     2096               assign
     2097                 v-object-handle = buf_temp-diasize-handle.handle-value
     2098               .
     2099               if v-object-handle <> v-diasize-resize-button
     2100               then do:
     2101                 assign
     2102                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2103                 .
     2104               end.
     2105             end.
     2106             assign
     2107               v-diasize-browse-handle :height = v-browse-height
     2108             .
     2109             for each buf_temp-browse-handle
     2110               where buf_temp-browse-handle.browse-type = 'height':u
     2111             on error undo, next
     2112             :
     2113               assign
     2114                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2115               .
     2116             end.
     2117             assign
     2118               frame f-pl-level-mm :height = v-frame-height
     2119             .
     2120             if frame f-pl-level-mm :scrollable = true
     2121             then do:
     2122               assign
     2123                 frame f-pl-level-mm :virtual-height = v-frame-virtual-height
     2124               .
     2125             end.
     2126             run diasize_position-resize-button in this-procedure .
     2127           end.
     2128           else do:
     2129             if frame f-pl-level-mm :scrollable = true
     2130             then do:
     2131               assign
     2132                 frame f-pl-level-mm :virtual-height = v-frame-virtual-height
     2133               .
     2134             end.
     2135             assign
     2136               frame f-pl-level-mm :height = v-frame-height
