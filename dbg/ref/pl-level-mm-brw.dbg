     2735           frame f-pl-level-mm :width = frame f-pl-level-mm :width + p-change-value
     2736         no-error .
     2737         if error-status :error
     2738         or error-status :get-message(1) <> ""
     2739         then do:
     2740           undo move_block, retry move_block.
     2741         end.
     2742         if frame f-pl-level-mm :scrollable = true
     2743         then do:
     2744           assign
     2745             frame f-pl-level-mm :virtual-width = frame f-pl-level-mm :virtual-width + p-change-value
     2746           no-error .
     2747           if error-status :error
     2748           or error-status :get-message(1) <> ""
     2749           then do:
     2750             undo move_block, retry move_block.
     2751           end.
     2752         end.
     2753       end.
     2754       if p-move-resize
     2755       then do:
     2756         run diasize_position-resize-button in this-procedure .
     2757       end.
     2758       if v-diasize-wndstore = true
     2759       then do:
     2760         if connected("ub") = true
     2761         then do:
     2762           define variable v-cntxt-db-num        as integer   no-undo .
     2763           define variable v-cntxt-userid        as character no-undo .
     2764           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2765                                             , OUTPUT v-cntxt-userid
     2766                                             ) .
     2767           run gbl/wndsizew.p
     2768             (input  v-cntxt-db-num
     2769             ,input  v-cntxt-userid
     2770             ,input  v-diasize-proc-name
     2771             ,input  'width':u
     2772             ,input  string(frame f-pl-level-mm :width - v-diasize-orig-frame-width)
     2773             ) .
     2774         end.
     2775       end.
     2776     end.
     2777     assign
     2778       v-diasize-change-size = false
     2779     .
     2780   end procedure.
     2781   procedure diasize_set-width :
     2782     define input  parameter p-new-width  as decimal   no-undo .
     2783     define input  parameter p-move-resize as logical   no-undo .
     2784     do
     2785     on error undo, return error return-value
     2786     :
     2787       run diasize_change-width in this-procedure
     2788         (input  (p-new-width - frame f-pl-level-mm :width)
     2789         ,input  p-move-resize
     2790         ) .
     2791     end.
     2792   end procedure.
     2793   procedure diasize_position-resize-button :
     2794     do with frame f-pl-level-mm
     2795     :
     2796       hide v-diasize-resize-button .
     2797       assign
     2798         v-diasize-resize-button :row = frame f-pl-level-mm :height - v-diasize-resize-button :height
     2799                     - 1
     2800                     - (frame f-pl-level-mm :border-bottom-pixels / session :pixels-per-row)
     2801         v-diasize-resize-button :col = frame f-pl-level-mm :width - v-diasize-resize-button :width
     2802                     - 1
     2803                     - (frame f-pl-level-mm :border-right-pixels / session :pixels-per-column)
     2804       .
     2805       view v-diasize-resize-button .
     2806     end.
     2807   end procedure.
     2808   on alt-right anywhere
     2809   do:
     2810     run diasize_change-width in this-procedure
     2811       (input 1
     2812       ,input true
     2813       ) .
     2814     return no-apply .
     2815   end.
     2816   on alt-left anywhere
     2817   do:
     2818     run diasize_change-width in this-procedure
     2819       (input -1
     2820       ,input true
     2821       ) .
     2822     return no-apply .
     2823   end.
     2824   on alt-down anywhere
     2825   do:
     2826     run diasize_change-height in this-procedure
     2827       (input 1
     2828       ,input true
     2829       ) .
     2830     return no-apply .
     2831   end.
     2832   on alt-up anywhere
     2833   do:
     2834     run diasize_change-height in this-procedure
     2835       (input -1
     2836       ,input true
     2837       ) .
     2838     return no-apply .
     2839   end.
     2840   on alt-enter of frame f-pl-level-mm
     2841   do:
     2842     run diasize_maximize in this-procedure
     2843       (input  ?
     2844       ).
     2845     return no-apply .
     2846   end.
     2847   procedure diasize_end-move :
     2848     do
     2849     on error undo, return error return-value
     2850     :
     2851       define variable v-row-delta as decimal   no-undo .
     2852       define variable v-col-delta as decimal   no-undo .
     2853       define variable v-new-row as decimal   no-undo .
     2854       define variable v-new-col as decimal   no-undo .
     2855       assign
     2856         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2857         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2858       .
     2859       assign
     2860         v-row-delta = v-new-row - frame f-pl-level-mm :height
     2861         v-col-delta = v-new-col - frame f-pl-level-mm :width
     2862       .
     2863       run diasize_change-height in this-procedure
     2864         (input v-row-delta
     2865         ,input true
     2866         ) .
     2867       run diasize_change-width in this-procedure
     2868         (input v-col-delta
     2869         ,input true
     2870         ) .
     2871     end.
     2872   end procedure.
     2873   procedure diasize_maximize :
     2874     define input  parameter p-action as logical   no-undo .
     2875     do
     2876     on error undo, return error return-value
     2877     :
     2878       if p-action = ?
     2879       then do:
     2880         if v-diasize-need-maximize = true
     2881         then do:
     2882           assign
     2883             p-action = true
     2884           .
     2885         end.
     2886         else do:
     2887           assign
     2888             p-action = false
     2889           .
     2890         end.
     2891       end.
     2892       if p-action = true
     2893       then do:
     2894         run diasize_change-height in this-procedure
     2895           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2896               - frame f-pl-level-mm :height-chars
     2897           ,input true
     2898           ) .
     2899         run diasize_change-width in this-procedure
     2900           (input session :width-chars
     2901               - frame f-pl-level-mm :width-chars
     2902           ,input true
     2903           ) .
     2904         assign
     2905           v-diasize-need-maximize = false
     2906         .
     2907       end.
     2908       else do:
     2909         run diasize_change-width in this-procedure
     2910           (input v-diasize-orig-frame-width
     2911               - frame f-pl-level-mm :width-chars
     2912           ,input true
     2913           ) .
     2914         run diasize_change-height in this-procedure
     2915           (input v-diasize-orig-frame-height
     2916               - frame f-pl-level-mm :height-chars
     2917           ,input true
     2918           ) .
     2919         assign
     2920           v-diasize-need-maximize = true
     2921         .
     2922       end.
     2923     end.
     2924   end procedure.
     2925   procedure diasize_restore-orig-size :
     2926     do
     2927     on error undo, return error return-value
     2928     :
     2929       assign
     2930         v-diasize-current-frame-width  = frame f-pl-level-mm :width
     2931         v-diasize-current-frame-height = frame f-pl-level-mm :height
     2932       .
     2933       run diasize_set-height in this-procedure
     2934         (input  v-diasize-orig-frame-height
     2935         ,input  true
     2936         ) .
     2937       run diasize_set-width in this-procedure
     2938         (input  v-diasize-orig-frame-width
     2939         ,input  true
     2940         ) .
     2941     end.
     2942   end procedure.
     2943   procedure diasize_restore-current-size :
     2944     do
     2945     on error undo, return error return-value
     2946     :
     2947       run diasize_set-height in this-procedure
     2948         (input  v-diasize-current-frame-height
     2949         ,input  true
     2950         ) .
     2951       run diasize_set-width in this-procedure
     2952         (input  v-diasize-current-frame-width
     2953         ,input  true
     2954         ) .
     2955     end.
     2956   end procedure.
     2957   procedure diasize_set-browse-handle :
     2958     define input  parameter p-browse-handle as handle   no-undo .
     2959     define buffer buf_temp-browse-handle for temp-browse-handle .
     2960     do
     2961     on error undo, return error return-value
     2962     :
     2963       assign
     2964         v-diasize-browse-handle = p-browse-handle
     2965       .
     2966       for each buf_temp-browse-handle
     2967       on error undo, return error return-value
     2968       :
     2969         delete buf_temp-browse-handle .
     2970       end.
     2971     end.
     2972   end procedure.
     2973   procedure diasize_add_browse :
     2974     define input  parameter p-browse-type   as character no-undo .
     2975     define input  parameter p-browse-handle as handle    no-undo .
     2976     define buffer buf_temp-browse-handle for temp-browse-handle .
     2977     do
     2978     on error undo, return error return-value
     2979     :
     2980       assign
     2981         v-diasize-browse-number = v-diasize-browse-number + 1
     2982       .
     2983       create buf_temp-browse-handle .
     2984       assign
     2985         buf_temp-browse-handle.browse-type   = p-browse-type
     2986         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2987         buf_temp-browse-handle.browse-handle = p-browse-handle
     2988       .
     2989     end.
     2990   end procedure.
     2991   procedure diasize_init :
     2992     define variable v-default-value    as logical   no-undo .
     2993     define variable v-restore-saved    as logical   no-undo .
     2994     define variable v-resize-value-str as character no-undo .
     2995     do
     2996     on error undo, return error return-value
     2997     :
     2998       do with frame f-pl-level-mm
     2999       :
     3000         assign
     3001           v-diasize-orig-frame-height = frame f-pl-level-mm :height
     3002           v-diasize-orig-frame-width  = frame f-pl-level-mm :width
     3003           v-diasize-browse-handle     = browse br-pl-level-mm :handle
     3004         .
