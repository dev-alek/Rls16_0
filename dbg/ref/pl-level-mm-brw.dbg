     2414     define variable v-window-width         as decimal   no-undo .
     2415     define variable v-window-virtual-width as decimal   no-undo .
     2416     define variable v-change-sign          as integer   no-undo .
     2417     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2418     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2419     if p-change-value > 0
     2420     then do:
     2421       if frame f-pl-level-mm :width + p-change-value >
     2422           session :width-chars
     2423       then do:
     2424         assign
     2425           p-change-value = session :width-chars - frame f-pl-level-mm :width
     2426         .
     2427         if p-change-value <= 0
     2428         then do:
     2429           run diasize_position-resize-button in this-procedure .
     2430           return .
     2431         end.
     2432       end.
     2433     end.
     2434     if p-change-value < 0
     2435     then do:
     2436       if frame f-pl-level-mm :width + p-change-value < v-diasize-orig-frame-width
     2437       then do:
     2438         assign
     2439           p-change-value = v-diasize-orig-frame-width
     2440                          - frame f-pl-level-mm :width
     2441         .
     2442         if p-change-value >= 0
     2443         then do:
     2444           run diasize_position-resize-button in this-procedure .
     2445           return .
     2446         end.
     2447       end.
     2448     end.
     2449     if p-change-value >= 0
     2450     then do:
     2451       assign
     2452         v-change-sign = 1
     2453       .
     2454     end.
     2455     else do:
     2456       assign
     2457         v-change-sign = -1
     2458       .
     2459     end.
     2460     assign
     2461       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2462     .
     2463     if p-change-value = 0
     2464     then do:
     2465       run diasize_position-resize-button in this-procedure .
     2466       return .
     2467     end.
