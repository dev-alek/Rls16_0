        1   DEFINE TEMP-TABLE tt-code NO-UNDO LIKE Code
        2          field status-name as character.
        3   define input parameter Parparentproc as handle    no-undo.
        4   define input parameter p-obj-type  like ub.pl-level-mm.obj-type no-undo.
        5   define input parameter p-obj-code  like ub.pl-level-mm.obj-code no-undo.
        6   define input parameter p-pl-code   like ub.pl-level-mm.pl-code  no-undo.
        7   define input parameter imode         as character               no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: $":U .
        9   define variable vss-author      as character no-undo init "$Author: $":U .
       10   define variable vss-date        as character no-undo init "$Date: $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: $":U .
       13   define variable vss-description as character no-undo init "Код сезонов ДТ".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define new shared variable g#auto-pid           as integer   no-undo .
       85   define new shared variable conn-par             as character no-undo .
       86   define new shared variable g#auto-user-id       as character no-undo .
       87   define new shared variable g#auto-user-login    as character no-undo .
       88   define new shared variable g#auto-user-password as character no-undo .
       89   define new shared variable v-socket             as logical   no-undo .
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define new shared variable auto-window-h     as handle    no-undo .
       92   define new shared variable auto-log-msg-h    as handle    no-undo .
       93   define new shared variable hand-log-msg-h    as handle    no-undo .
       94   define new shared variable log-file-name     as character no-undo initial ? .
       95   define new shared variable add-log-file-name as character no-undo initial ? .
       96   define new shared variable writelogvalue     as character no-undo initial ? .
       97   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   procedure cur-time :
       99      define output parameter p-today as date      no-undo .
      100      define output parameter p-time  as integer   no-undo .
      101     do
      102     on error undo, return error
      103     :
      104       define variable v-date1 as date      no-undo .
      105       define variable v-date2 as date      no-undo .
      106       define variable v-time  as integer   no-undo .
      107       assign
      108         v-date1 = today
      109         v-time  = time
      110         v-date2 = today
      111       .
      112       if v-date1 <> v-date2
      113       then do:
      114         assign
      115           v-date1 = today
      116           v-time  = v-time
      117         .
      118       end.
      119       assign
      120         p-today = v-date1
      121         p-time  = v-time
      122       .
      123     end.
      124   end.
      125   function cur-time-date returns character
      126   :
      127     return string(today, '99/99/9999':U) .
      128   end.
      129   function cur-time-mjd returns decimal
      130   :
      131     define variable v-date as date      no-undo .
      132     define variable v-time as integer   no-undo .
      133     run cur-time in this-procedure
      134       (output v-date
      135       ,output v-time
      136       ) .
      137     return integer(v-date) - 2400002 + (v-time / 86400) .
      138   end.
      139   function cur-time-get-ending-index returns integer
      140   (input p-number as integer
      141   )
      142   :
      143     if p-number < 0
      144     or p-number = ?
      145     then do:
      146       return 1 .
      147     end.
      148     define variable v-rest as integer   no-undo .
      149     assign
      150       p-number = p-number modulo 100
      151     .
      152     if p-number < 20
      153     then do:
      154       assign
      155         v-rest = p-number
      156       .
      157     end.
      158     else do:
      159       assign
      160         v-rest = p-number modulo 10
      161       .
      162     end.
      163     case v-rest :
      164       when 1
      165       then do:
      166         return 2 .
      167       end.
      168       when 2 or
      169       when 3 or
      170       when 4
      171       then do:
      172         return 3 .
      173       end.
      174       otherwise do:
      175         return 1 .
      176       end.
      177     end case .
      178   end.
      179   procedure cur-time-mjd-to-date :
      180      define input  parameter i-mjd-diff as decimal no-undo.
      181      define output parameter o-Date     as date    no-undo.
      182      define output parameter o-Time     as integer no-undo.
      183      define variable v-day-number as integer   no-undo .
      184      if    i-mjd-diff < 0
      185         or i-mjd-diff = ?
      186      then do:
      187         return "?" .
      188      end.
      189      assign
      190         v-day-number = truncate(i-mjd-diff,0).
      191         o-Date = date(v-day-number + 2400002).
      192         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194   end.
      195   function cur-time-mjd-to-string returns character
      196   (input p-mjd-diff as decimal
      197   )
      198   :
      199     define variable v-day-number as integer   no-undo .
      200     define variable v-seconds    as integer   no-undo .
      201     define variable v-hour       as integer   no-undo .
      202     define variable v-min        as integer   no-undo .
      203     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      204     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      205     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      206     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      207     if p-mjd-diff < 0
      208     or p-mjd-diff = ?
      209     then do:
      210       return "?" .
      211     end.
      212     assign
      213       v-day-number = integer(truncate(p-mjd-diff,0))
      214       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      215     .
      216     if v-seconds > 86400
      217     then do:
      218       assign
      219         v-seconds = 86400 - 1
      220       .
      221     end.
      222     if v-seconds < 0
      223     then do:
      224       assign
      225         v-seconds = 0
      226       .
      227     end.
      228     assign
      229       v-hour = truncate(v-seconds / 3600, 0)
      230     .
      231     assign
      232       v-seconds = v-seconds modulo 3600
      233     .
      234     assign
      235       v-min = truncate(v-seconds / 60, 0)
      236     .
      237     assign
      238       v-seconds = v-seconds modulo 60
      239     .
      240     return
      241         (if v-day-number <> 0
      242           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      243           else ""
      244         )
      245       + (if v-day-number <> 0 or v-hour <> 0
      246           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      247           else ""
      248         )
      249       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      250           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      251           else ""
      252         )
      253       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      254       .
      255   end.
      256   function cur-time-string returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      265   end.
      266   function cur-time-string-sec returns character
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      275   end.
      276   function cur-time-custom  returns character
      277   (input p-prefix as character
      278   ,input p-date-format as character
      279   ,input p-delimiter as character
      280   ,input p-time-format as character
      281   ,input p-suffix as character
      282   )
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return
      291       p-prefix
      292       + string(v-date, p-date-format)
      293       + p-delimiter
      294       + string(v-time, p-time-format)
      295       + p-suffix
      296       .
      297   end.
      298   function cur-time-print  returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      307   end.
      308   function cur-time-datetime returns datetime
      309   :
      310     define variable v-char as character no-undo .
      311     define variable v-datetime as datetime no-undo .
      312     v-char = cur-time-string().
      313     v-datetime = datetime(v-char).
      314     return  v-datetime.
      315   end.
      316   function cur-time-string-msec returns character
      317   :
      318     define variable v-date as datetime  no-undo .
      319     v-date = now.
      320     return string(v-date) .
      321   end.
      322   define stream LogStream .
      323   define variable mNoTime as logical no-undo.
      324   procedure write-to-log-notime :
      325     define input param i-str as character no-undo .
      326     mNoTime = yes.
      327     run write-to-log (i-str).
      328     mNoTime = no.
      329   end.
      330   procedure write-to-log :
      331     define input param p-str as character no-undo .
      332     do
      333     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      334     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      335     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      336     :
      337       define variable log-res        as logical   no-undo .
      338       define variable v-jj           as integer   no-undo .
      339       if    mNoTime
      340          or writelogvalue eq "AsyncProc"
      341       then
      342          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      343       else
      344          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      345       if auto-log-msg-h <> ? then do:
      346         log-res = auto-log-msg-h:move-to-eof( ) .
      347         log-res = auto-log-msg-h:insert-string( p-str ).
      348       end.
      349       if hand-log-msg-h <> ? then do:
      350         log-res = hand-log-msg-h:move-to-eof( ) .
      351         log-res = hand-log-msg-h:insert-string( p-str ).
      352       end.
      353       assign
      354         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      355         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      356         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      357       .
      358       if add-log-file-name <> ? then do:
      359         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      360           run gbl/fileapnd.p
      361             ( input entry(v-jj, add-log-file-name, chr(1) )
      362             ,input p-str
      363             ,input 20
      364             ) no-error .
      365           if error-status:error then do:
      366             return error return-value .
      367           end.
      368         end.
      369       end.
      370       if writelogvalue eq "AsyncProc"
      371       then do:
      372          p-str = trim(p-str, (chr(13) + chr(10)) )
      373       .
      374          Publish "WriteLogAsunc" (p-str,yes).
      375       end.
      376       else if writelogvalue <> "yes" then do:
      377         run gbl/fileapnd.p
      378           ( input log-file-name
      379           ,input p-str
      380           ,input 20
      381           ) no-error .
      382         if error-status:error then do:
      383           return error return-value .
      384         end.
      385       end.
      386     end.
      387   end procedure.
      388   procedure write-to-screen :
      389     define input param p-str as character no-undo .
      390     do
      391     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      392     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      393     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      394     :
      395       define variable log-res as logical no-undo.
      396       assign
      397         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      398       .
      399       if auto-log-msg-h <> ?
      400       then do:
      401         log-res = auto-log-msg-h:move-to-eof( ) .
      402         log-res = auto-log-msg-h:insert-string( p-str ).
      403       end.
      404       if hand-log-msg-h <> ?
      405       then do:
      406         log-res = hand-log-msg-h:move-to-eof( ) .
      407         log-res = hand-log-msg-h:insert-string( p-str ).
      408       end.
      409     end.
      410   end procedure.
      411   procedure send-msg-to-email :
      412     define input  parameter p-subject      as character no-undo .
      413     define input  parameter p-text-err     as character no-undo .
      414     define input  parameter p-attach-files as character no-undo .
      415     do
      416     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      417     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      418     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      419     :
      420       define variable v-tth             as handle    no-undo .
      421       define variable v-value-character as character no-undo .
      422       define variable v-value-date      as date      no-undo .
      423       define variable v-value-decimal   as decimal   no-undo .
      424       define variable v-value-integer   as integer   no-undo .
      425       define variable v-value-logical   as logical   no-undo .
      426       define variable v-param-type      as character no-undo .
      427       define variable v-email       as character no-undo .
      428       define variable v-tmp-str     as character no-undo .
      429       define variable v-tmp1-str    as character no-undo .
      430       define variable v-ind         as integer   no-undo .
      431       define variable v-num-entries as integer   no-undo .
      432       delete object v-tth no-error.
      433       run adm/shattri.p
      434         ( input "get":U
      435          ,input  "":U
      436          ,input  0
      437          ,input  'auto-task':U
      438          ,input  'send-msg-to-email':U
      439          ,output v-value-character
      440          ,output v-value-date
      441          ,output v-value-decimal
      442          ,output v-value-integer
      443          ,output v-value-logical
      444          ,output v-param-type
      445          ,input-output table-handle v-tth
      446         ) no-error .
      447       if not error-status :error  then do:
      448         assign
      449           v-tmp-str = v-value-character
      450         .
      451       end.
      452       delete object v-tth no-error.
      453       assign
      454         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      455         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      456         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      457         v-num-entries = num-entries( v-tmp-str, chr(44) )
      458         v-email       = "":U
      459       .
      460       do v-ind = 1 to v-num-entries
      461       :
      462         assign
      463           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      464         .
      465         if trim( v-tmp1-str ) <> "":U then do:
      466           if v-email = "":U then do:
      467             assign
      468               v-email = v-tmp1-str
      469             .
      470           end.
      471           else do:
      472             assign
      473               v-email = v-email + chr(44) + v-tmp1-str
      474             .
      475           end.
      476         end.
      477       end.
      478       if v-email <> "":U then do:
      479         run gbl/sendmail.p
      480           ( input v-email
      481           , input p-subject
      482           , input p-text-err
      483           , input p-attach-files
      484           ) no-error .
      485         if error-status :error
      486           or return-value <> "":U
      487         then do:
      488           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      489         end.
      490       end.
      491     end.
      492   end procedure.
      493   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   define variable v-loc-counter as integer no-undo .
      495   define variable v-counter-visible as logical no-undo .
      496   define variable v-view-log as logical no-undo .
      497   define stream auto2dia.
      498   PROCEDURE write-log-and-file :
      499   do
      500   on error undo, return error
      501   :
      502     define input parameter p-tab-position   as integer   no-undo.
      503     define input parameter p-file-name      as character no-undo .
      504     define input parameter p-log-level      as integer   no-undo .
      505     define input parameter p-log-string     AS CHARacter NO-UNDO.
      506     define variable v-jj as integer   no-undo .
      507     run write-to-screen in this-procedure( input ( fill( chr(32), p-tab-position) + p-log-string)) .
      508     if p-file-name <> '':U then do:
      509       do v-jj = 1 to num-entries(p-file-name, chr(1)):
      510         run  auto2dia-writefile in this-procedure (
      511                                         input entry(v-jj, p-file-name, chr(1))
      512                                         ,input p-log-level
      513                                         ,input (p-log-string + chr(10))
      514                                       ) no-error .
      515       end.
      516     end.
      517     if writelogvalue eq "AsyncProc"
      518     then
      519        run write-to-log in this-procedure( p-log-string) .
      520   end.
      521   END PROCEDURE.
      522   PROCEDURE get-title :
      523   do
      524   on error undo, return error
      525   :
      526   define output parameter p-title     as character    no-undo.
      527   end.
      528   END PROCEDURE.
      529   PROCEDURE set-title :
      530   do
      531   on error undo, return error
      532   :
      533   define input parameter p-title     as character    no-undo.
      534   run write-to-log in this-procedure( input ( fill( chr(32), 15) + p-title)) .
      535   end.
      536   END PROCEDURE.
      537   PROCEDURE get-counter-value :
      538   do
      539   on error undo, return error
      540   :
      541   define output parameter p-counter     as integer    no-undo.
      542       assign
      543       p-counter  = v-loc-counter
      544       .
      545   end.
      546   END PROCEDURE.
      547   PROCEDURE set-counter-value :
      548   do
      549   on error undo, return error
      550   :
      551   define input parameter p-counter     as integer    no-undo.
      552       assign
      553       v-loc-counter = p-counter
      554       .
      555   end.
      556   END PROCEDURE.
      557   PROCEDURE show-counter :
      558   do
      559   on error undo, return error
      560   :
      561       assign
      562       v-counter-visible = true
      563       .
      564       process events.
      565   end.
      566   END PROCEDURE.
      567   PROCEDURE hide-counter :
      568   do
      569   on error undo, return error
      570   :
      571       assign
      572       v-counter-visible = false
      573       .
      574       run hide-message in parparentproc .
      575       process events.
      576   end.
      577   END PROCEDURE.
      578   PROCEDURE write-counter :
      579   do
      580   on error undo, return error
      581   :
      582   define input parameter p-counter-string     as character    no-undo.
      583   if v-counter-visible then
      584   run write-message in parparentproc ( input p-counter-string) .
      585   process events.
      586   end.
      587   END PROCEDURE.
      588   PROCEDURE get-stop-state :
      589   do
      590   on error undo, return error
      591   :
      592   define output parameter p-stop-state    as logical      no-undo.
      593   end.
      594   END PROCEDURE.
      595   PROCEDURE set-view-log :
      596   do
      597   on error undo, return error
      598   :
      599   define input parameter p-view-log     as logical    no-undo.
      600       assign
      601       v-view-log = p-view-log
      602       .
      603   end.
      604   END PROCEDURE.
      605   PROCEDURE get-view-log :
      606   do
      607   on error undo, return error
      608   :
      609   define output parameter p-view-log     as logical    no-undo.
      610       assign
      611       p-view-log = v-view-log
      612       .
      613   end.
      614   END PROCEDURE.
      615   PROCEDURE write-log :
      616   do
      617   on error undo, return error
      618   :
      619   define input parameter p-tab-position   as integer      no-undo.
      620   define input parameter p-log-string     as character    no-undo.
      621   run write-to-log in this-procedure( input ( fill( chr(32), 1  * p-tab-position)  +
      622                                       (IF p-log-string = "&Line" THEN FILL("-", 80)
      623                                       ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      624                                       ELSE p-log-string))).
      625   end.
      626   END PROCEDURE.
      627   procedure writelog :
      628   do
      629   on error undo, return error
      630   :
      631   define input parameter p-file-name AS CHAR     NO-UNDO.
      632   define input parameter p-log-level AS INTEGER  NO-UNDO.
      633   define input parameter p-log-string  AS CHAR     NO-UNDO.
      634     if p-file-name <> "" then
      635     run  auto2dia-Writefile in this-procedure (
      636                                       input p-file-name
      637                                     ,input p-log-level
      638                                     ,input p-log-string
      639                                   ) no-error .
      640      process events.
      641   end.
      642   end procedure.
      643   PROCEDURE auto2dia-writefile:
      644     define input parameter sFileName AS CHAR     NO-UNDO.
      645     define input parameter iLogLevel AS INTEGER  NO-UNDO.
      646     define input parameter sToWrite  AS CHAR     NO-UNDO.
      647     define variable v-SlashPos  as integer no-undo .
      648     define variable v-lDirName  as character no-undo .
      649     define variable v-lDirName2 as character no-undo .
      650     v-SlashPos  = maximum (  r-index(sFileName, "\"),  r-index(sFileName, "/")  ) .
      651     v-lDirName  = if v-SlashPos > 0 then substring (sFileName, 1, v-SlashPos - 1) else "".
      652     FILE-INFO:FILE-NAME = v-lDirName .
      653     v-lDirName2 = FILE-INFO:FULL-PATHNAME .
      654     if v-lDirName2 <> ? then do :
      655   OUTPUT STREAM auto2dia TO VALUE(sFileName) APPEND.
      656       PUT STREAM auto2dia UNFORMATTED chr(10).
      657       PUT STREAM auto2dia UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      658                                         OR sToWrite = "&Line") THEN "" ELSE
      659                                         cur-time-string-sec() + " ").
      660       PUT STREAM auto2dia UNFORMATTED
      661               (IF sToWrite = "&Line" THEN FILL("-", 80)
      662                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      663                ELSE sToWrite).
      664   OUTPUT STREAM auto2dia CLOSE.
      665     end .
      666   END PROCEDURE.
      667   procedure proc-alt-shift-f2:
      668     if not ibs.th.gbl.gbl-var:rcode
      669   then
      670     run gbl\inidebug.p .
      671   end.
      672   procedure proc-alt-shift-f3:
      673     run gbl/prvssinf.p
      674       ( input this-procedure
      675       ) .
      676   end.
      677   define variable v-inform-launched as logical no-undo initial false .
      678   procedure proc-alt-shift-f4:
      679     define variable v-action as character no-undo .
      680     if v-inform-launched = false then do:
      681       assign
      682         v-inform-launched = true
      683       .
      684       run gbl/d-inform.w
      685         (  input self
      686         ,  input this-procedure
      687         , output v-action
      688         ) no-error .
      689       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      690       assign
      691         v-inform-launched = false
      692       .
      693     end.
      694   end.
      695   procedure proc-alt-f1:
      696     run gbl/corrhelp.p
      697       (input this-procedure
      698       ) .
      699   end .
      700   on alt-shift-f2 anywhere do:
      701     run proc-alt-shift-f2.
      702   end.
      703   on alt-shift-f3 anywhere do:
      704     run proc-alt-shift-f3 in this-procedure .
      705   end.
      706   on alt-shift-f4 anywhere do:
      707     run proc-alt-shift-f4 in this-procedure.
      708   end.
      709   on alt-f1 anywhere do:
      710     run proc-alt-f1 in this-procedure .
      711   end.
      712   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      714   define new shared variable RepPathName        as character no-undo .
      715   define new shared variable PrintRubl          as logical   no-undo .
      716   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      717   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      718   procedure sys-time_get-sys :
      719     define output parameter p-year         as integer   no-undo .
      720     define output parameter p-month        as integer   no-undo .
      721     define output parameter p-day          as integer   no-undo .
      722     define output parameter p-hour         as integer   no-undo .
      723     define output parameter p-minute       as integer   no-undo .
      724     define output parameter p-second       as integer   no-undo .
      725     define output parameter p-milliseconds as integer   no-undo .
      726     define variable v-system-time-structure as memptr    no-undo.
      727     do
      728     on error undo, return error return-value
      729     :
      730       assign
      731         set-size(v-system-time-structure) = 16
      732       .
      733       run GetSystemTime
      734         (input  get-pointer-value(v-system-time-structure)
      735         ) .
      736       assign
      737         p-year         = get-short(v-system-time-structure,  1)
      738         p-month        = get-short(v-system-time-structure,  3)
      739         p-day          = get-short(v-system-time-structure,  7)
      740         p-hour         = get-short(v-system-time-structure,  9)
      741         p-minute       = get-short(v-system-time-structure, 11)
      742         p-second       = get-short(v-system-time-structure, 13)
      743         p-milliseconds = get-short(v-system-time-structure, 15)
      744       .
      745       assign
      746         set-size(v-system-time-structure) = 0
      747       .
      748     end.
      749   end procedure.
      750   procedure sys-time_get-comp-user-name :
      751     define output parameter p-computer-name as character no-undo .
      752     define output parameter p-user-name     as character no-undo .
      753     define output parameter p-process-pid   as integer   no-undo .
      754     define variable v-return-value  as integer   no-undo .
      755     define variable v-buffer-length as integer   no-undo .
      756     define variable v-buffer-memptr as memptr    no-undo .
      757     do
      758     on error undo, return error return-value
      759     :
      760       assign
      761         v-buffer-length = 1024
      762         set-size(v-buffer-memptr) = v-buffer-length + 4
      763       .
      764       assign
      765         put-long(v-buffer-memptr, 1) = v-buffer-length
      766       .
      767       run GetComputerNameA
      768         (input  get-pointer-value(v-buffer-memptr) + 4
      769         ,input  get-pointer-value(v-buffer-memptr)
      770         ,output v-return-value
      771         ) .
      772       if v-return-value <> 0
      773       then do:
      774         assign
      775           p-computer-name = get-string(v-buffer-memptr, 5)
      776         .
      777       end.
      778       assign
      779         put-long(v-buffer-memptr, 1) = v-buffer-length
      780       .
      781       run GetUserNameA
      782         (input  get-pointer-value(v-buffer-memptr) + 4
      783         ,input  get-pointer-value(v-buffer-memptr)
      784         ,output v-return-value
      785         ) .
      786       if v-return-value <> 0
      787       then do:
      788         assign
      789           p-user-name = get-string(v-buffer-memptr, 5)
      790         .
      791       end.
      792       run GetCurrentProcessId
      793         (output p-process-pid
      794         ) .
      795       assign
      796         set-size(v-buffer-memptr) = 0
      797       .
      798     end.
      799   end procedure.
      800   procedure sys-time_get-http :
      801     define output parameter p-http-time as character no-undo .
      802     define variable v-year         as integer   no-undo .
      803     define variable v-month        as integer   no-undo .
      804     define variable v-day-of-week  as integer   no-undo .
      805     define variable v-day          as integer   no-undo .
      806     define variable v-hour         as integer   no-undo .
      807     define variable v-minute       as integer   no-undo .
      808     define variable v-second       as integer   no-undo .
      809     define variable v-milliseconds as integer   no-undo .
      810     do
      811     on error undo, return error return-value
      812     :
      813       run sys-time_get-sys in this-procedure
      814         (output v-year
      815         ,output v-month
      816         ,output v-day
      817         ,output v-hour
      818         ,output v-minute
      819         ,output v-second
      820         ,output v-milliseconds
      821         ) .
      822       assign
      823         v-day-of-week = weekday(date(v-month, v-day, v-year))
      824         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      825                     + ', ':u
      826                     + string(v-day, '99':u)
      827                     + ' ':u
      828                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      829                     + ' ':u
      830                     + string(v-year, '9999':u)
      831                     + ' ':u
      832                     + string(v-hour, '99':u)
      833                     + ':':u
      834                     + string(v-minute, '99':u)
      835                     + ':':u
      836                     + string(v-second, '99':u)
      837                     + ' ':u
      838                     + 'GMT':u
      839       .
      840     end.
      841   end procedure.
      842   procedure sys-time_set-sys :
      843     define input  parameter p-year         as integer   no-undo .
      844     define input  parameter p-month        as integer   no-undo .
      845     define input  parameter p-day          as integer   no-undo .
      846     define input  parameter p-hour         as integer   no-undo .
      847     define input  parameter p-minute       as integer   no-undo .
      848     define input  parameter p-second       as integer   no-undo .
      849     define input  parameter p-milliseconds as integer   no-undo .
      850     define variable v-system-time-structure as memptr    no-undo.
      851     define variable v-return-value as integer   no-undo .
      852     define variable v-day-of-week  as integer   no-undo .
      853     do
      854     on error undo, return error return-value
      855     :
      856       assign
      857         v-day-of-week = weekday(date(p-month, p-day, p-year))
      858       .
      859       assign
      860         set-size(v-system-time-structure) = 16
      861       .
      862       assign
      863         put-short(v-system-time-structure,  1) = p-year
      864         put-short(v-system-time-structure,  3) = p-month
      865         put-short(v-system-time-structure,  5) = v-day-of-week
      866         put-short(v-system-time-structure,  7) = p-day
      867         put-short(v-system-time-structure,  9) = p-hour
      868         put-short(v-system-time-structure, 11) = p-minute
      869         put-short(v-system-time-structure, 13) = p-second
      870         put-short(v-system-time-structure, 15) = p-milliseconds
      871       .
      872       run SetSystemTime
      873         (input  get-pointer-value(v-system-time-structure)
      874         ,output v-return-value
      875         ) .
      876       assign
      877         set-size(v-system-time-structure) = 0
      878       .
      879       if v-return-value = 0
      880       then do:
      881         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      882       end.
      883     end.
      884   end procedure.
      885   procedure sys-time_sys-to-mjd :
      886     define input  parameter p-year         as integer   no-undo .
      887     define input  parameter p-month        as integer   no-undo .
      888     define input  parameter p-day          as integer   no-undo .
      889     define input  parameter p-hour         as integer   no-undo .
      890     define input  parameter p-minute       as integer   no-undo .
      891     define input  parameter p-second       as integer   no-undo .
      892     define input  parameter p-milliseconds as integer   no-undo .
      893     define output parameter p-mjd          as decimal   no-undo .
      894     define variable v-year-correction as decimal   no-undo .
      895     define variable v-shift-year as decimal   no-undo .
      896     do
      897     on error undo, return error return-value
      898     :
      899       assign
      900         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      901         v-shift-year      = decimal(p-year) + v-year-correction
      902         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      903               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      904               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      905               + decimal(p-day) - 2432076.0
      906               + p-hour / 24.0
      907               + p-minute / 1440.0
      908               + p-second / 86400.0
      909               + p-milliseconds / 86400000.0
      910       .
      911     end.
      912   end procedure.
      913   procedure sys-time_sys-to-loc :
      914     define input  parameter p-sys-year         as integer   no-undo .
      915     define input  parameter p-sys-month        as integer   no-undo .
      916     define input  parameter p-sys-day          as integer   no-undo .
      917     define input  parameter p-sys-hour         as integer   no-undo .
      918     define input  parameter p-sys-minute       as integer   no-undo .
      919     define input  parameter p-sys-second       as integer   no-undo .
      920     define input  parameter p-sys-milliseconds as integer   no-undo .
      921     define output parameter p-loc-year         as integer   no-undo .
      922     define output parameter p-loc-month        as integer   no-undo .
      923     define output parameter p-loc-day          as integer   no-undo .
      924     define output parameter p-loc-hour         as integer   no-undo .
      925     define output parameter p-loc-minute       as integer   no-undo .
      926     define output parameter p-loc-second       as integer   no-undo .
      927     define output parameter p-loc-milliseconds as integer   no-undo .
      928     define variable v-system-time-structure as memptr    no-undo.
      929     define variable v-return-value          as integer   no-undo .
      930     define variable v-sys-day-of-week       as integer   no-undo .
      931     do
      932     on error undo, return error return-value
      933     :
      934       assign
      935         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      936       .
      937       assign
      938         set-size(v-system-time-structure) = 32
      939       .
      940       assign
      941         put-short(v-system-time-structure,  1) = p-sys-year
      942         put-short(v-system-time-structure,  3) = p-sys-month
      943         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      944         put-short(v-system-time-structure,  7) = p-sys-day
      945         put-short(v-system-time-structure,  9) = p-sys-hour
      946         put-short(v-system-time-structure, 11) = p-sys-minute
      947         put-short(v-system-time-structure, 13) = p-sys-second
      948         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      949       .
      950       run SystemTimeToTzSpecificLocalTime
      951         (input  0
      952         ,input  get-pointer-value(v-system-time-structure)
      953         ,input  get-pointer-value(v-system-time-structure) + 16
      954         ,output v-return-value
      955         ) .
      956       assign
      957         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      958         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      959         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      960         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      961         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      962         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      963         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      964       .
      965       assign
      966         set-size(v-system-time-structure) = 0
      967       .
      968       if v-return-value = 0
      969       then do:
      970         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      971       end.
      972     end.
      973   end procedure.
      974   procedure sys-time_mjd-to-sys :
      975     define input  parameter p-mjd          as decimal   no-undo .
      976     define output parameter p-year         as integer   no-undo .
      977     define output parameter p-month        as integer   no-undo .
      978     define output parameter p-day          as integer   no-undo .
      979     define output parameter p-hour         as integer   no-undo .
      980     define output parameter p-minute       as integer   no-undo .
      981     define output parameter p-second       as integer   no-undo .
      982     define output parameter p-milliseconds as integer   no-undo .
      983     define variable v-year-correction as decimal   no-undo .
      984     define variable v-shift-year      as decimal   no-undo .
      985     define variable v-conv-date     as date      no-undo .
      986     define variable v-int-part      as integer   no-undo .
      987     define variable v-fraction-part as decimal   no-undo .
      988     do
      989     on error undo, return error return-value
      990     :
      991       assign
      992         v-int-part      = integer(truncate(p-mjd, 0))
      993         v-fraction-part = p-mjd - v-int-part
      994         v-conv-date     = date(11, 17, 1858) + v-int-part
      995         p-year          = year(v-conv-date)
      996         p-month         = month(v-conv-date)
      997         p-day           = day(v-conv-date)
      998         v-fraction-part = v-fraction-part * 24.0
      999         p-hour          = integer(truncate(v-fraction-part, 0))
     1000         v-fraction-part = (v-fraction-part - p-hour) * 60.0
     1001         p-minute        = integer(truncate(v-fraction-part, 0))
     1002         v-fraction-part = (v-fraction-part - p-minute) * 60.0
     1003         p-second        = integer(truncate(v-fraction-part, 0))
     1004         v-fraction-part = (v-fraction-part - p-second) * 1000.0
     1005         p-milliseconds  = integer(v-fraction-part)
     1006       .
     1007     end.
     1008   end procedure.
     1009   procedure sys-time_mjd-to-loc :
     1010     define input  parameter p-mjd              as decimal   no-undo .
     1011     define output parameter p-loc-year         as integer   no-undo .
     1012     define output parameter p-loc-month        as integer   no-undo .
     1013     define output parameter p-loc-day          as integer   no-undo .
     1014     define output parameter p-loc-hour         as integer   no-undo .
     1015     define output parameter p-loc-minute       as integer   no-undo .
     1016     define output parameter p-loc-second       as integer   no-undo .
     1017     define output parameter p-loc-milliseconds as integer   no-undo .
     1018     define variable v-sys-year         as integer   no-undo .
     1019     define variable v-sys-month        as integer   no-undo .
     1020     define variable v-sys-day          as integer   no-undo .
     1021     define variable v-sys-hour         as integer   no-undo .
     1022     define variable v-sys-minute       as integer   no-undo .
     1023     define variable v-sys-second       as integer   no-undo .
     1024     define variable v-sys-milliseconds as integer   no-undo .
     1025     do
     1026     on error undo, return error return-value
     1027     :
     1028       run sys-time_mjd-to-sys
     1029         (input  p-mjd
     1030         ,output v-sys-year
     1031         ,output v-sys-month
     1032         ,output v-sys-day
     1033         ,output v-sys-hour
     1034         ,output v-sys-minute
     1035         ,output v-sys-second
     1036         ,output v-sys-milliseconds
     1037         ) .
     1038       run sys-time_sys-to-loc
     1039         (input  v-sys-year
     1040         ,input  v-sys-month
     1041         ,input  v-sys-day
     1042         ,input  v-sys-hour
     1043         ,input  v-sys-minute
     1044         ,input  v-sys-second
     1045         ,input  v-sys-milliseconds
     1046         ,output p-loc-year
     1047         ,output p-loc-month
     1048         ,output p-loc-day
     1049         ,output p-loc-hour
     1050         ,output p-loc-minute
     1051         ,output p-loc-second
     1052         ,output p-loc-milliseconds
     1053         ) .
     1054     end.
     1055   end procedure.
     1056   function sys-time_get-mjd-func returns decimal
     1057   :
     1058     define variable v-year         as integer   no-undo .
     1059     define variable v-month        as integer   no-undo .
     1060     define variable v-day          as integer   no-undo .
     1061     define variable v-hour         as integer   no-undo .
     1062     define variable v-minute       as integer   no-undo .
     1063     define variable v-second       as integer   no-undo .
     1064     define variable v-milliseconds as integer   no-undo .
     1065     define variable v-mjd          as decimal   no-undo .
     1066     run sys-time_get-sys in this-procedure
     1067       (output v-year
     1068       ,output v-month
     1069       ,output v-day
     1070       ,output v-hour
     1071       ,output v-minute
     1072       ,output v-second
     1073       ,output v-milliseconds
     1074       ) .
     1075     run sys-time_sys-to-mjd in this-procedure
     1076       (input  v-year
     1077       ,input  v-month
     1078       ,input  v-day
     1079       ,input  v-hour
     1080       ,input  v-minute
     1081       ,input  v-second
     1082       ,input  v-milliseconds
     1083       ,output v-mjd
     1084       ) .
     1085     return v-mjd .
     1086   end function .
     1087   function sys-time_get-sys-str-func returns character
     1088   :
     1089     define variable v-utc-time as character no-undo .
     1090     define variable v-year         as integer   no-undo .
     1091     define variable v-month        as integer   no-undo .
     1092     define variable v-day          as integer   no-undo .
     1093     define variable v-hour         as integer   no-undo .
     1094     define variable v-minute       as integer   no-undo .
     1095     define variable v-second       as integer   no-undo .
     1096     define variable v-milliseconds as integer   no-undo .
     1097     run sys-time_get-sys in this-procedure
     1098       (output v-year
     1099       ,output v-month
     1100       ,output v-day
     1101       ,output v-hour
     1102       ,output v-minute
     1103       ,output v-second
     1104       ,output v-milliseconds
     1105       ) .
     1106     assign
     1107       v-utc-time  = 'UTC ':u
     1108                   + string(v-year,         '9999':u)
     1109                   + '/':u
     1110                   + string(v-month,        '99':u)
     1111                   + '/':u
     1112                   + string(v-day,          '99':u)
     1113                   + ' ':u
     1114                   + string(v-hour,         '99':u)
     1115                   + ':':u
     1116                   + string(v-minute,       '99':u)
     1117                   + ':':u
     1118                   + string(v-second,       '99':u)
     1119                   + ' ':u
     1120                   + string(v-milliseconds, '999':u)
     1121     .
     1122     return v-utc-time.
     1123   end function .
     1124   function sys-time_mjd-to-loc-str-func returns character
     1125     (v-sys-mjd as decimal)
     1126   :
     1127     define variable v-loc-str          as character no-undo .
     1128     define variable v-loc-year         as integer   no-undo .
     1129     define variable v-loc-month        as integer   no-undo .
     1130     define variable v-loc-day          as integer   no-undo .
     1131     define variable v-loc-hour         as integer   no-undo .
     1132     define variable v-loc-minute       as integer   no-undo .
     1133     define variable v-loc-second       as integer   no-undo .
     1134     define variable v-loc-milliseconds as integer   no-undo .
     1135     run sys-time_mjd-to-loc in this-procedure
     1136       (input  v-sys-mjd
     1137       ,output v-loc-year
     1138       ,output v-loc-month
     1139       ,output v-loc-day
     1140       ,output v-loc-hour
     1141       ,output v-loc-minute
     1142       ,output v-loc-second
     1143       ,output v-loc-milliseconds
     1144       ) .
     1145     assign
     1146       v-loc-str = substitute('&1/&2/&3 &4:&5'
     1147                             ,string(v-loc-day,    '99':U)
     1148                             ,string(v-loc-month,  '99':U)
     1149                             ,string(v-loc-year,   '9999':U)
     1150                             ,string(v-loc-hour,   '99':U)
     1151                             ,string(v-loc-minute, '99':U)
     1152                             )
     1153     .
     1154     return v-loc-str .
     1155   end function .
