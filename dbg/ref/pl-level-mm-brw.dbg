     2394   procedure diasize_set-height :
     2395     define input  parameter p-new-height  as decimal   no-undo .
     2396     define input  parameter p-move-resize as logical   no-undo .
     2397     do
     2398     on error undo, return error return-value
     2399     :
     2400       run diasize_change-height in this-procedure
     2401         (input  (p-new-height - frame f-pl-level-mm :height)
     2402         ,input  p-move-resize
     2403         ) .
     2404     end.
     2405   end procedure.
     2406   procedure diasize_change-width :
     2407     define input  parameter p-change-value as decimal   no-undo .
     2408     define input  parameter p-move-resize  as logical   no-undo .
     2409     define variable v-field-group-handle   as handle    no-undo .
     2410     define variable v-object-handle        as handle    no-undo .
