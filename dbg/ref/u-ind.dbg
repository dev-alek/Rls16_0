        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-obj-type    as character no-undo .
        4   define input parameter p-obj-code    as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: u-ind.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/u-ind.p $":U .
       10   define variable vss-description as character no-undo init "Изменение ИЖТ по списку товаров".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define new shared temp-table gds-list no-undo like ub.goods
       82     field qnty   as decimal
       83     field to-del as logical
       84     field order-num as integer
       85     field to-sel as logical
       86     field promo-code as character
       87     field ActionId  as int64
       88     field db-num as integer
       89     index art  is primary unique artic prod-type prod-code
       90     index code is         unique gds-code
       91     index oi order-num
       92     index isel to-sel
       93     .
       94   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   define  new shared  temp-table gds-list-hist no-undo
       96   field list-table as character
       97   field id as integer
       98   field line as integer
       99   field hist-mode as character
      100   field des as character
      101   field num-recs as integer
      102   field option_ as character
      103   field item_ as character
      104   field status_ as character
      105   field num-add as integer
      106   field num-ignored as integer
      107   field done as logical
      108   field err_ as logical
      109   field err-mes as character
      110   index pi is primary
      111   id
      112   line
      113   index isdone
      114   done
      115   .
      116   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   def
      118   new shared
      119   temp-table  obj-list no-undo
      120     field obj-type like ub.clients.obj-type
      121     field obj-code like ub.clients.obj-code
      122     field obj-name like ub.clients.obj-name
      123     field obj-id   as integer
      124     field db-num   as integer
      125     index pi is primary unique obj-id
      126     index ie1 obj-type obj-code
      127     index ie2 obj-name
      128   .
      129   procedure create_obj-list :
      130      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      131      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      132      do
      133      on error undo, return error return-value
      134      :
      135         define buffer cli-obj for ub.clients .
      136         define variable p-var as integer no-undo .
      137         define buffer buf_obj-list for obj-list .
      138         find last buf_obj-list  use-index pi no-error .
      139         if available buf_obj-list
      140         then
      141            p-var = buf_obj-list.obj-id + 1.
      142         else
      143            p-var = 1.
      144         find first cli-obj where
      145                   cli-obj.obj-type = p-obj-type
      146               and cli-obj.obj-code = p-obj-code
      147         no-lock no-error.
      148         if available cli-obj
      149         then do:
      150            create buf_obj-list.
      151            assign
      152               buf_obj-list.obj-id   = p-var
      153               buf_obj-list.obj-code = cli-obj.obj-code
      154               buf_obj-list.obj-type = cli-obj.obj-type
      155               buf_obj-list.obj-name = cli-obj.obj-name
      156               buf_obj-list.db-num   = cli-obj.db-num
      157            .
      158         end.
      159      end.
      160   end.
      161   define variable  v-old as character no-undo .
      162   define variable  v-new as character no-undo .
      163   define variable v-host-code like ub.sysconf.host-code no-undo .
      164   run create_obj-list ( p-obj-type , p-obj-code ) .
      165     run ref/graf-igt.w
      166         (output v-old, output v-new ).
      167     if not(v-old = "" and v-new = "")  then do:
      168   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      170     (input  p-obj-type
      171     ,input  p-obj-code
      172     ,output v-host-code
      173     )  .
      174         run str/gds-list.w
      175             (input parparentproc, input v-host-code, input p-obj-type, input p-obj-code ).
      176         run ref/chg-igt.p
      177             (input v-old, input v-new ,input true ) no-error  .
      178             if error-status :error then do:
      179                 message vss-workfile vss-revision vss-description skip
      180                 error-status :get-message(1)
      181                 return-value
      182                 .
      183             return .
      184             end.
      185     message "Изменение ИЖТ по списку товаров на объекте " + p-obj-type + " " + string(p-obj-code) + " завершено ." view-as alert-box information .
      186     end.
