        1   define input parameter PictName as char no-undo .
        2   DEFINE INPUT PARAMETER p-extension AS CHARACTER NO-UNDO.
        3   DEFINE INPUT PARAMETER bttn AS CHARACTER NO-UNDO.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Просмотр картинки".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   DEFINE VARIABLE v-image-order      AS CHARACTER NO-UNDO INIT "jpg,bmp":U.
      115   define variable v-image-format     as character extent 62 init
      116   [
      117    "Windows bitmap                                                          ", "*.bmp"
      118   ,"Computer-aided Acquisition and Logistics Support                        ", "*.cal"
      119   ,"Microsoft Windows Clipboard                                             ", "*.clp"
      120   ,"Halo CUT                                                                ", "*.cut"
      121   ,"Intel FAX format                                                        ", "*.dcx"
      122   ,"Windows device-independent bitmap                                       ", "*.dib"
      123   ,"Encapsulated PostScript                                                 ", "*.eps"
      124   ,"1 Graphics Interchange Format                                           ", "*.gif"
      125   ,"IBM IOCA                                                                ", "*.ica"
      126   ,"Microsoft Icon File format                                              ", "*.ico"
      127   ,"Amiga IFF                                                               ", "*.iff"
      128   ,"GEM bitmap                                                              ", "*.img"
      129   ,"Joint Bi-level Image Experts Group                                      ", "*.jbig"
      130   ,"JPEG                                                                    ", "*.jpg"
      131   ,"serView                                                                 ", "*.lv "
      132   ,"Macintosh MacPaint                                                      ", "*.mac"
      133   ,"Microsoft Windows Paint                                                 ", "*.msp"
      134   ,"Kodak Photo CD                                                          ", "*.pcd"
      135   ,"Macintosh PICT                                                          ", "*.pct"
      136   ,"PC Paintbrush                                                           ", "*.pcx"
      137   ,"GIF (Graphics Interchange Format) replacement                           ", "*.png"
      138   ,"Adobe Photoshop                                                         ", "*.psd"
      139   ,"Sun Raster (1-, 8-, 24-, or 32-bit Standard, BGR, RGB, and byte encoded)", "*.ras"
      140   ,"TARGA                                                                   ", "*.tga"
      141   ,"Tag image file format                                                   ", "*.tif"
      142   ,"Windows bitmap for wireless devices                                     ", "*.wbmp"
      143   ,"Windows metafiles                                                       ", "*.wmf"
      144   ,"WordPerfect graphics                                                    ", "*.wpg"
      145   ,"(also .bm) X bitmap                                                     ", "*.xbm"
      146   ,"Pixmap                                                                  ", "*.xpm"
      147   ,"UNIX X Window Dump File format                                          ", "*.xwd"
      148   ] no-undo.
      149   procedure get-custom-img-order :
      150   define output parameter p-descriptions as character no-undo .
      151   define output parameter p-extensiond   as character no-undo .
      152   define output parameter p-extensiont   as character no-undo .
      153   define variable ii as integer no-undo .
      154   define variable v-entry as integer no-undo .
      155     do
      156     on error undo, return error
      157     :
      158       assign
      159       p-descriptions = fill(chr(4), 30)
      160       p-extensiond   = fill(chr(4), 30)
      161       p-extensiont   = fill(chr(4), 30)
      162       .
      163       do ii = 2 to 62 by 2:
      164         assign
      165         v-entry = lookup(left-trim(v-image-format[ii], ".*"), v-image-order)
      166         .
      167         if v-entry > 0 then do:
      168           assign
      169           entry(v-entry, p-descriptions, chr(4)) = substitute("&1 &2", trim(v-image-format[ii - 1]), v-image-format[ii])
      170           entry(v-entry, p-extensiond, chr(4)) = v-image-format[ii]
      171           entry(v-entry, p-extensiont, chr(4)) = left-trim(v-image-format[ii], ".*")
      172           .
      173         end.
      174       end.
      175       assign
      176       p-descriptions = trim(p-descriptions, chr(4))
      177       p-extensiond   = trim(p-extensiond, chr(4))
      178       p-extensiont   = trim(p-extensiont, chr(4))
      179       p-descriptions = replace(p-descriptions, (chr(4) + chr(4)), chr(4))
      180       p-extensiond   = replace(p-extensiond, (chr(4) + chr(4)),  chr(4))
      181       p-extensiont   = replace(p-extensiont, (chr(4) + chr(4)), chr(4))
      182       .
      183     end.
      184   end procedure.
      185   define variable stat as log no-undo .
      186   define variable v-param-type as character no-undo .
      187   define variable v-value-date as date no-undo .
      188   define variable v-value-decimal as decimal no-undo .
      189   define variable v-value-integer as INTEGER no-undo .
      190   define variable v-value-logical AS LOGICAL no-undo .
      191   define variable v-tth as handle no-undo .
      192   define variable v-descriptions as character no-undo .
      193   define variable v-extensiond   as character no-undo .
      194   define variable v-extensiont   as character no-undo .
      195   DEFINE BUTTON b-help
      196        LABEL "&Помощь"
      197        SIZE 10 BY 1.
      198   DEFINE BUTTON B-update
      199        LABEL "&Изменить"
      200        SIZE 10.5 BY 1.
      201   DEFINE BUTTON Btn_Close AUTO-GO
      202        LABEL "&Выход ":L
      203        SIZE 10 BY 1
      204        BGCOLOR 8 .
      205   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U
      206        LABEL "Файл"
      207         VIEW-AS TEXT
      208        SIZE 35.5 BY .67
      209        FGCOLOR 4  NO-UNDO.
      210   DEFINE IMAGE IMAGE-1
      211        STRETCH-TO-FIT RETAIN-SHAPE
      212        SIZE 65.8 BY 16.77.
      213   DEFINE FRAME DLGCLOSE
      214        Btn_Close AT ROW 1 COL 1
      215        B-update AT ROW 1 COL 29
      216        b-help AT ROW 1 COL 57 WIDGET-ID 2
      217        FILL-IN-1 AT ROW 2.27 COL 15.5 COLON-ALIGNED
      218        IMAGE-1 AT ROW 3.77 COL 1
      219        SPACE(0.57) SKIP(0.33)
      220       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      221            SIDE-LABELS THREE-D  SCROLLABLE
      222            BGCOLOR 8
      223            TITLE BGCOLOR 8 "":L
      224            DEFAULT-BUTTON Btn_Close.
      225   ASSIGN
      226          FRAME DLGCLOSE:SCROLLABLE       = FALSE
      227          FRAME DLGCLOSE:PRIVATE-DATA     =
      228                   "DLGCLOSE".
      229   ASSIGN
      230          Btn_Close:PRIVATE-DATA IN FRAME DLGCLOSE     =
      231                   "Btn_Close".
      232   ASSIGN
      233          IMAGE-1:RESIZABLE IN FRAME DLGCLOSE        = TRUE.
      234   ON CHOOSE OF B-update IN FRAME DLGCLOSE
      235   DO:
      236     DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
      237     DEFINE VARIABLE stat-chr AS CHARACTER NO-UNDO.
      238     DEFINE VARIABLE stat AS logical NO-UNDO.
      239     assign
      240     fill-in-1.
      241     run ref/photo-n.w ( input fill-in-1, input 'ИЗМЕНЕНИЕ':U ) .
      242     IF RETURN-VALUE = "error" THEN RETURN NO-APPLY.
      243     assign
      244     stat-chr = search( return-value  )
      245     .
      246     if stat-chr = ? then do:
      247       return no-apply.
      248     end.
      249     fill-in-1 = stat-chr.
      250     stat = image-1:load-image("cmp/MATRIX-RELOADED.jpg") .
      251     stat = image-1:load-image( return-value ) .
      252     DISPLAY
      253     image-1
      254     fill-in-1
      255     WITH FRAME DLGCLOSE.
      256   END.
      257   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGCLOSE:PARENT eq ?
      258   THEN FRAME DLGCLOSE:PARENT = ACTIVE-WINDOW.
      259   ON WINDOW-CLOSE OF FRAME DLGCLOSE APPLY "END-ERROR":U TO SELF.
      260   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   on help of frame DLGCLOSE
      262   do:
      263     run gbl/app_help.p
      264       (input this-procedure :file-name
      265       ,input ''
      266       ,input ?
      267       ) no-error.
      268     if error-status :error then do:
      269       message
      270         "Ошибка при вызове помощи"
      271         error-status :get-message(1)
      272         view-as alert-box .
      273     end.
      274   end.
      275   run minbtn-set in this-procedure .
      276   on choose of b-help in frame DLGCLOSE
      277   do:
      278     apply "help":u to frame DLGCLOSE .
      279   end.
      280   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      281   procedure minbtn-set :
      282       do
      283           on error undo, return error return-value
      284           :
      285           define variable ii              as integer       no-undo .
      286           define variable fh              as widget-handle no-undo .
      287           define variable hh              as widget-handle no-undo .
      288           define variable v-h             as handle        extent 4 no-undo .
      289           define variable v-name-button   as character     no-undo .
      290           define variable v-help-old-x    as decimal       no-undo .
      291           define variable v-help-old-y    as decimal       no-undo .
      292           define variable v-help-old-size as decimal       no-undo .
      293           define variable v-frame-width   as decimal       no-undo .
      294           define variable jj              as integer       no-undo .
      295           do
      296               on error undo, return error
      297               :
      298               assign
      299                   v-frame-width = frame DLGCLOSE:width - 0.3
      300                   fh            = frame DLGCLOSE:first-child
      301                   hh            = fh:first-child
      302                   ii            = 1
      303                   .
      304               do while valid-handle(hh):
      305                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      306                   do:
      307                       case lc(hh:name) :
      308                           when "b-help" then
      309                               do:
      310                                   hh:load-image-up("cmp/b-help.bmp":u) .
      311                                   hh:load-image-down("cmp/b-help.bmp":u) .
      312                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      313                                   hh:TOOLTIP = "Помощь" .
      314                                   v-help-old-x = hh:column .
      315                                   v-help-old-y = hh:row    .
      316                                   v-help-old-size = hh:width .
      317                                   hh:width-chars = 2.5 .
      318                               end.
      319                           when "b-print" then
      320                               do:
      321                                   hh:load-image("cmp/b-print.bmp":u) .
      322                                   hh:TOOLTIP = "Печать" .
      323                                   v-h[ii] = hh:handle .
      324                                   ii = ii + 1 .
      325                                   hh:width-chars = 3 .
      326                               end.
      327                           when "b-history" or
      328                           when "b-hist" then
      329                               do:
      330                                   hh:load-image("cmp/b-hist.bmp":u) .
      331                                   hh:TOOLTIP = "История" .
      332                                   v-h[ii] = hh:handle .
      333                                   ii = ii + 1 .
      334                                   hh:width-chars = 3 .
      335                               end.
      336                           when "b-sch" then
      337                               do:
      338                                   hh:load-image("cmp/b-sch.bmp":u) .
      339                                   hh:TOOLTIP = "Установка Фильтра" .
      340                                   v-h[ii] = hh:handle .
      341                                   ii = ii + 1 .
      342                                   hh:width-chars = 3 .
      343                               end.
      344                           when "b-hist-user" then
      345                               do:
      346                                   hh:load-image("cmp/b-hist.bmp":u) .
      347                                   hh:TOOLTIP = "История пользователя" .
      348                                   ii = ii + 1 .
      349                               end.
      350                       end case.
      351                   end.
      352                   hh = hh:next-sibling.
      353               end.
      354               b-help:column = v-frame-width - b-help:width-chars.
      355               jj = 0.
      356               repeat ii = 4 to 1 by -1 :
      357                   if valid-handle (v-h[ii] ) then
      358                   do:
      359                       jj  = jj + 1 .
      360                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      361                       v-h[ii]:row    = v-help-old-y .
      362                   end.
      363               end.
      364           end.
      365       end.
      366   end procedure.
      367   MAIN-BLOCK:
      368   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      369      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      370       run adm/shattri.p (
      371           input "get":U
      372           ,input  ''
      373           ,input  0
      374           ,input  'images':U
      375           ,input  'imgorder':U
      376           ,output v-image-order
      377           ,output v-value-date
      378           ,output v-value-decimal
      379           ,output v-value-integer
      380           ,output v-value-logical
      381           ,output v-param-type
      382           ,INPUT-OUTPUT table-handle v-tth
      383           ) no-error .
      384       delete object v-tth.
      385       if error-status:error
      386       or v-image-order = '':U then
      387       v-image-order = "jpg,bmp".
      388       run get-custom-img-order IN THIS-PROCEDURE(OUTPUT v-descriptions, OUTPUT v-extensiond, OUTPUT v-extensiont).
      389       stat = image-1:load-image( PictName + ".":U + p-extension) .
      390       FILL-IN-1 = PictName + ".":U + p-extension .
      391       run enable_UI in this-procedure .
      392       IF LOOKUP("b-update", bttn) = 0 THEN DO:
      393           DISABLE
      394           b-update
      395           WITH FRAME DLGCLOSE.
      396       END.
      397       WAIT-FOR GO OF FRAME DLGCLOSE.
      398   END.
      399   run disable_UI in this-procedure .
      400   PROCEDURE disable_UI :
      401     HIDE FRAME DLGCLOSE.
      402   END PROCEDURE.
      403   PROCEDURE enable_UI :
      404     DISPLAY FILL-IN-1
      405         WITH FRAME DLGCLOSE.
      406     ENABLE Btn_Close IMAGE-1 B-update b-help FILL-IN-1
      407         WITH FRAME DLGCLOSE.
      408   END PROCEDURE.
