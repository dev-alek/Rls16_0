     1373   procedure gds-attr_check-code-dt-seasons :
     1374     define input  parameter p-code     like ub.goods.gds-code   no-undo .
     1375     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
     1376     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
