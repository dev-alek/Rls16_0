     1394   end.
     1395   define variable ii as integer no-undo.
     1396   define buffer for-pbc for ub.prod-bc.
     1397   define variable v-found as logical no-undo .
     1398   define variable v-on as logical no-undo .
     1399   define variable v-b-str like ub.prod-bc.b-str no-undo .
     1400   define buffer buf_scales-gds for ub.scales-gds.
     1401   define buffer buf_goods for ub.goods.
     1402   define buffer buf_units for ub.units.
     1403   _main:
     1404   DO ON ERROR undo, leave on stop undo, leave:
     1405   CASE p-mode:
     1406       when 'ДОБАВЛЕНИЕ':U then do:
     1407         FIND FIRST buf_goods No-LOCK where buf_goods.gds-code = bc.gds-code .
     1408         find first buf_units no-lock where buf_units.unit-name = buf_goods.unit-base.
     1409         if lookup('шту':U, buf_units.unit-name) > 0
     1410         and lookup(sc.scales-type, 'DIGI-SM,CAS_CL5000J,CAS_CL5000,TIGER-SPCT1,TIGER-SPCT2':U) = 0 then do:
     1411          undo _main, return error substitute("На весы типа &1 нельзя добавлять штучный товар", sc.scales-type).
     1412         end.
     1413   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1414   define variable v-rid4 as recid no-undo .
     1415   v-found = no.
     1416   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1417   define buffer locK-batchprocess5 for ub.batchprocess.
     1418   run gbl/lock-prc.p
     1419       (input 'lscc':U
     1420       ,input 0
     1421       ,input 0
     1422       ,input 0
     1423       ,input ""
     1424       ,input ""
     1425       ,input ""
     1426       ,input (
     1427               ",,,Вкл/выкл лок. вес. кодов"
     1428              )
     1429       ,input true
     1430       ,buffer lock-batchprocess5
     1431       ) no-error .
     1432     if error-status :error then do:
     1433       message
     1434         vss-workfile vss-revision vss-description skip
     1435         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1436         view-as alert-box error .
     1437       undo, return error .
     1438     end.
     1439   if lookup('вес':U, buf_units.type) > 0 then do:
     1440     run trg/isvescod.p ( input bc.b-code
     1441                         ,input yes
     1442                         ,input no
     1443                         ,input yes
     1444                         ,input ""
     1445                         ,output v-found
     1446                         ,output v-on
     1447                         ,output v-b-str) no-error.
     1448   end.
     1449   else do:
     1450     run trg/ispgwcod.p (input bc.b-code
     1451                       ,input yes
     1452                       ,input no
     1453                       ,input yes
     1454                       ,input ""
     1455                       ,output v-found
     1456                       ,output v-on
     1457                       ,output v-b-str ) no-error.
     1458   end.
     1459   if error-status:error then do:
     1460     return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1461   end.
     1462   if v-found and v-on = no then do:
     1463     find first ub.prod-bc exclusive-lock where
     1464                ub.prod-bc.b-code = bc.b-code
     1465           AND  ub.prod-bc.b-str = v-b-str no-error no-wait.
     1466     if not avail prod-bc then do:
     1467       assign
     1468       v-found = no
     1469       .
     1470     end.
     1471     else do:
     1472       if prod-bc.bc-on = no then do:
     1473         run trg/bc-upd.p (
     1474                                  input parparentproc
     1475                   ,input bc.b-code
     1476                   ,input  ub.prod-bc.b-str
     1477                   ,input yes
     1478                   ,input yes
     1479                   ,input no
     1480                   ,input ?
     1481                   ,input ?
     1482                   ) no-error.
     1483         if error-status:error then do:
     1484           assign
     1485           v-found = no
     1486           .
     1487         end.
     1488       end.
     1489     end.
     1490   end.
     1491   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1492   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1493     (input  p-obj-type
     1494     ,input  p-obj-code
     1495     ,input  buf_goods.artic
     1496     ,input  buf_goods.prod-type
     1497     ,input  buf_goods.prod-code
     1498     ,buffer ub.gds-obj
     1499     ) no-error .
     1500   release ub.gds-obj.
     1501   if lookup('вес':U, buf_units.type) = 0
     1502   or v-found = yes
     1503   then do:
     1504     define variable v-exist4 as logical no-undo .
     1505     run gdsoattr-exist in this-procedure (
     1506                                           input buf_goods.gds-code
     1507                                          ,input p-obj-type
     1508                                          ,input p-obj-code
     1509                                          ,input 'scales-code':U
     1510                                          ,output v-exist4
     1511                                         ) .
     1512     if not v-exist4 then do:
     1513   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run sclcdattr in g#library
     1515     (input  buf_goods.gds-code
     1516     ,input  p-obj-type
     1517     ,input  p-obj-code
     1518     ,input  v-b-str
     1519     ,input  no
     1520     ) no-error .
     1521   end.
     1522   if error-status:error then do:
     1523     return error '':U.
     1524   end.
     1525   end.
     1526   if not v-found
     1527   and lookup('вес':U, buf_units.type) > 0
     1528   then do:
     1529     v-rid4 = ?.
     1530     run trg/prod-bc1.p ( input parparentproc
     1531                         ,input yes
     1532                         ,input ?
     1533                         ,input ?
     1534                         ,input no
     1535                         ,input 'sclc':U
     1536                         ,input ""
     1537                         ,buffer buf_goods
     1538                         ,input bc.b-code
     1539                         ,input-output v-b-str
     1540                         ,output v-rid4
     1541                         ) no-error.
     1542     if error-status:error
     1543     or v-rid4 = ? then do:
     1544       return error substitute("Ошибка при сохранении ДопБК для весов&2&1&2&3", error-status:get-message(1) , chr(10), return-value ).
     1545     end.
     1546     find first prod-bc exclusive-lock where
     1547               recid(prod-bc) = v-rid4.
     1548   end.
     1549         create buf_scales-gds.
     1550         assign
     1551         sc.tot-gds  = sc.tot-gds + 1
     1552         buf_scales-gds.obj-type  = p-obj-type
     1553         buf_scales-gds.obj-code =  p-obj-code
     1554         buf_scales-gds.b-code = bc.b-code
     1555         buf_scales-gds.scales-num = sc.scales-num
     1556         buf_scales-gds.db-num = sc.db-num
     1557         buf_scales-gds.to-send = TRUE
     1558         buf_scales-gds.plu-type = (if lookup('вес':U, buf_units.type) > 0
     1559                                          then integer('0':U)
     1560                                          else integer('1':U)
     1561                                          )
     1562         sc.to-send = TRUE
     1563         buf_scales-gds.to-del = FALSE
     1564         buf_scales-gds.deadline = (if p-deadline = ? and p-deadflag = integer('0':U)
     1565                                     then buf_goods.deadline
     1566                                     else p-deadline)
     1567         buf_scales-gds.deaddate = (if p-deaddate <> ? and p-deadflag = integer('1':U)
     1568                                     then p-deaddate
     1569                                     else buf_scales-gds.deaddate)
     1570         buf_scales-gds.deadflag = (if p-deadflag <> ? then p-deadflag else buf_scales-gds.deadflag)
     1571         buf_scales-gds.wt-cart = if lookup('вес':U, buf_units.type) > 0
     1572                                  then  (if p-wt-cart = ?
     1573                                         then buf_goods.wt-cart
     1574                                         else p-wt-cart)
     1575                                  else 0
     1576         .
     1577         DO ii = 1 to sc.max-gds :
     1578             if not ( can-find ( ub.scales-gds WHERE
     1579             ub.scales-gds.db-num = sc.db-num AND
     1580             ub.scales-gds.scales-num = sc.scales-num AND
     1581             ub.scales-gds.plu-code = ii ) ) then LEAVE .
     1582         END .
     1583         if ii > sc.max-gds then do:
     1584             message
     1585             substitute("Превышено&1максимально допустимое количество&1товаров для весов &2."
     1586                         , chr(10)
     1587                         , sc.scales-num)
     1588             view-as alert-box ERROR .
     1589             undo _main, return error "max-gds":U.
     1590         end.
     1591         assign
     1592         buf_scales-gds.PLU-code = ii
     1593         sc.max-plu  = Maximum(sc.max-plu, ii)
     1594         .
     1595       end.
     1596       when 'ИЗМЕНЕНИЕ':U then do:
     1597         find first buf_scales-gds where
     1598                 buf_scales-gds.b-code = bc.b-code
     1599             and buf_scales-gds.scales-num = sc.scales-num
     1600             and buf_scales-gds.db-num     = sc.db-num
     1601             and buf_scales-gds.obj-type   = p-obj-type
     1602             and buf_scales-gds.obj-code   = p-obj-code
     1603             .
     1604         assign
     1605         buf_scales-gds.deadline = (if p-deadline <> ? and p-deadflag = integer('0':U)
     1606                                     then p-deadline
     1607                                     else buf_scales-gds.deadline)
     1608         buf_scales-gds.deaddate = (if p-deaddate <> ? and p-deadflag = integer('1':U)
     1609                                     then p-deaddate
     1610                                     else buf_scales-gds.deaddate)
     1611         buf_scales-gds.deadflag = (if p-deadflag <> ? then p-deadflag else buf_scales-gds.deadflag)
     1612         buf_scales-gds.wt-cart = (if p-wt-cart <> ? and buf_scales-gds.plu-type = integer('0':U)
     1613                                   then p-wt-cart
     1614                                   else buf_scales-gds.wt-cart)
     1615         buf_scales-gds.to-send  = true
     1616         sc.to-send = TRUE
     1617         .
     1618       end.
     1619     END CASE.
     1620   END.
