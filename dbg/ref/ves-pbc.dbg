        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode        as character no-undo .
        4   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        5   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        6   define input parameter p-deadline like ub.scales-gds.deadline no-undo .
        7   define input parameter p-deaddate like ub.scales-gds.deaddate no-undo .
        8   define input parameter p-deadflag like ub.scales-gds.deadflag no-undo .
        9   define input parameter p-wt-cart  like ub.scales-gds.wt-cart no-undo .
       10   define parameter buffer bc for ub.bar-code.
       11   define parameter buffer sc for ub.scales.
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: ves-pbc.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: ref/ves-pbc.p $":U .
       17   define variable vss-description as character no-undo init "Создание весового кода на товар".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure gen-b-code :
       89     define input  parameter type-code like ub.code-range.range-type no-undo .
       90     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
       91     do
       92     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       93     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
       94     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
       95     :
       96       define buffer buf_thbj-attr     for ub.thbj-attr .
       97       define buffer buf_sys-ctrl   for ub.sys-ctrl .
       98       define buffer buf_code-range for ub.code-range .
       99       define variable l-code         as   integer              no-undo .
      100       define variable v-db-num       like ub.db.db-num         no-undo .
      101       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      102       if type-code = 'sslc':U
      103       or type-code = 'ssgb':U
      104       then do:
      105         message
      106           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      107           "Обратитесь к администратору системы."
      108           view-as alert-box error .
      109         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      110       end.
      111       run trg/getpcode.p ( input  type-code
      112                      ,output cfg-param-code
      113                     ).
      114       run get-next-seq( input  type-code,
      115                         output l-code
      116                       ).
      117       find first buf_sys-ctrl no-lock.
      118       if type-code = 'sclc':U
      119       or type-code = 'pglc':U
      120       then do:
      121         assign
      122           v-db-num = 0
      123         .
      124       end.
      125       else do:
      126         assign
      127           v-db-num = buf_sys-ctrl.db-num
      128         .
      129       end.
      130       find first buf_code-range no-lock
      131         where buf_code-range.db-num     = v-db-num
      132           and buf_code-range.range-type = type-code
      133           and buf_code-range.stts       = "a"
      134         use-index stts
      135         no-error .
      136       if available buf_code-range
      137          and l-code <= buf_code-range.last-code
      138          and l-code >= buf_code-range.first-code then do:
      139         assign
      140           p-b-code = l-code
      141         .
      142       end.
      143       else do:
      144         if available buf_code-range
      145            and l-code < buf_code-range.last-code then do:
      146           message
      147             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      148             "Обратитесь к администратору системы."
      149             view-as alert-box error .
      150           undo, return error "sequence":U .
      151         end.
      152         do transaction
      153         on error undo, return error
      154         :
      155           find first buf_thbj-attr exclusive-lock
      156             where buf_thbj-attr.upper-prop-code = 'code-range':U
      157               and buf_thbj-attr.prop-code = cfg-param-code
      158               and buf_thbj-attr.obj-type   = 'БД':U
      159               and buf_thbj-attr.obj-code   = v-db-num
      160             no-error .
      161           if not available buf_thbj-attr then do:
      162             find first buf_thbj-attr exclusive-lock
      163               where buf_thbj-attr.upper-prop-code = 'code-range':U
      164                 and buf_thbj-attr.prop-code = cfg-param-code
      165                 and buf_thbj-attr.obj-type   = ''
      166                 and buf_thbj-attr.obj-code   = 0
      167               no-error .
      168             if not available buf_thbj-attr then do:
      169               if not locked buf_thbj-attr then do:
      170                 message
      171                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      172                   "Обратитесь к администратору системы."
      173                   view-as alert-box error .
      174               end.
      175               undo, return error "config":U .
      176             end.
      177           end.
      178           run get-next-seq( input type-code,
      179                             output l-code
      180                           ).
      181           find first buf_code-range
      182             where buf_code-range.db-num     = v-db-num
      183               and buf_code-range.range-type = type-code
      184               and buf_code-range.stts       = "a"
      185             use-index stts
      186             no-error .
      187           if available buf_code-range
      188           and l-code <= buf_code-range.last-code
      189           and l-code >= buf_code-range.first-code
      190           then do:
      191             assign
      192               p-b-code = l-code
      193             .
      194           end.
      195           else do:
      196             if available buf_code-range then do:
      197               assign
      198                 buf_code-range.stts = "u"
      199               .
      200             end.
      201             find first buf_code-range
      202               where buf_code-range.db-num     = v-db-num
      203                 and buf_code-range.range-type = type-code
      204                 and buf_code-range.stts       = "f"
      205               use-index stts
      206               no-error .
      207             if not available buf_code-range then do:
      208               message
      209                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      210                 "Обратитесь к администратору системы"
      211                 view-as alert-box error .
      212               undo, return error "code-range":U .
      213             end.
      214             assign
      215               buf_code-range.stts           = "a"
      216             .
      217             if buf_code-range.first-code = 1 then do:
      218               run set-seq-cr( input type-code,
      219                               input buf_code-range.first-code
      220                             ).
      221               assign
      222                 p-b-code = 1
      223               .
      224             end.
      225             else do:
      226               run set-seq-cr( input type-code,
      227                               input ( buf_code-range.first-code - 1 )
      228                             ).
      229               run get-next-seq( input type-code,
      230                                 output p-b-code
      231                               ).
      232             end.
      233           end.
      234         end.
      235       end.
      236     end.
      237   end procedure.
      238   procedure get-next-seq :
      239     define input  parameter type-code like ub.code-range.range-type no-undo .
      240     define output parameter next-seq  as   integer                  no-undo .
      241     do
      242     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      243     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      244     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      245     :
      246       case type-code:
      247         when 'bcgb':U then do:
      248           assign
      249             next-seq = next-value(s-bcgb-code, ub)
      250           .
      251         end.
      252         when 'scgb':U then do:
      253           assign
      254             next-seq = next-value(s-scgb-code, ub)
      255           .
      256         end.
      257         when 'sclc':U then do:
      258           assign
      259             next-seq = next-value(s-sclc-code, ub)
      260           .
      261         end.
      262         when 'pglc':U then do:
      263           assign
      264             next-seq = next-value(s-pglc-code, ub)
      265           .
      266         end.
      267         when 'dcgb':U then do:
      268           assign
      269             next-seq = next-value(s-dcgb-code, ub)
      270           .
      271         end.
      272         when 'ctgb':U then do:
      273           assign
      274             next-seq = next-value(s-ctgb-code, ub)
      275           .
      276         end.
      277         when 'drgb':U then do:
      278           assign
      279             next-seq = next-value(s-drgb-code, ub)
      280           .
      281         end.
      282         when 'fmgb':U then do:
      283           assign
      284             next-seq = next-value(s-fmgb-code, ub)
      285           .
      286         end.
      287         when 'pngb':U then do:
      288           assign
      289             next-seq = next-value(s-pngb-code, ub)
      290           .
      291         end.
      292         when 'cagb':U then do:
      293           assign
      294             next-seq = next-value(s-cagb-code, ub)
      295           .
      296         end.
      297         when 'fdgb':U then do:
      298           assign
      299             next-seq = next-value(s-fin-doc, ub)
      300           .
      301         end.
      302       end case.
      303     end.
      304   end procedure.
      305   procedure set-seq-cr :
      306     define input parameter type-code like ub.code-range.range-type no-undo .
      307     define input parameter set-val   like ub.code-range.first-code no-undo .
      308     do
      309     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      310     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      311     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      312     :
      313       case type-code:
      314         when 'bcgb':U then do:
      315           assign
      316             current-value(s-bcgb-code, ub) = set-val
      317           .
      318         end.
      319         when 'scgb':U then do:
      320           assign
      321             current-value(s-scgb-code, ub) = set-val
      322           .
      323         end.
      324         when 'sclc':U then do:
      325           assign
      326             current-value(s-sclc-code, ub) = set-val
      327           .
      328         end.
      329         when 'pglc':U then do:
      330           assign
      331             current-value(s-pglc-code, ub) = set-val
      332           .
      333         end.
      334         when 'dcgb':U then do:
      335           assign
      336             current-value(s-dcgb-code, ub) = set-val
      337           .
      338         end.
      339         when 'ctgb':U then do:
      340           assign
      341             current-value(s-ctgb-code, ub) = set-val
      342           .
      343         end.
      344         when 'drgb':U then do:
      345           assign
      346             current-value(s-drgb-code, ub) = set-val
      347           .
      348         end.
      349         when 'fmgb':U then do:
      350           assign
      351             current-value(s-fmgb-code, ub) = set-val
      352           .
      353         end.
      354         when 'pngb':U then do:
      355           assign
      356             current-value(s-pngb-code, ub) = set-val
      357           .
      358         end.
      359         when 'cagb':U then do:
      360           assign
      361             current-value(s-cagb-code, ub) = set-val
      362           .
      363         end.
      364         when 'fdgb':U then do:
      365           assign
      366             current-value(s-fin-doc, ub) = set-val
      367           .
      368         end.
      369       end case.
      370     end.
      371   end procedure.
      372   procedure new-bcod-gen-code-range :
      373     do
      374     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      375     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      376     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      377     :
      378       define input parameter p-db-num  like ub.db.db-num             no-undo .
      379       define input parameter type-code like ub.code-range.range-type no-undo .
      380       define buffer buf_code-range      for ub.code-range .
      381       define buffer last_code-range     for ub.code-range .
      382       define buffer last-1_code-range   for ub.code-range .
      383       define buffer last-2_code-range   for ub.code-range .
      384       define buffer last-3_code-range   for ub.code-range .
      385       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      386       define variable conf-par       as character no-undo .
      387       define variable par-type       as character no-undo .
      388       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      389       define variable v-cre-cdrg as logical   no-undo .
      390       define variable v-cre-str  as character no-undo .
      391       define variable v-cr1      as integer no-undo .
      392       define variable v-cr2      as integer no-undo .
      393       define variable v-cr3      as integer no-undo .
      394       define variable v-cmax     as integer no-undo .
      395       find first buf_sys-ctrl no-lock .
      396       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      397         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      398                                       ,vss-workfile
      399                                       ,vss-revision
      400                                       ,vss-description
      401                                       ,chr(10)
      402                                       , p-db-num
      403                                      ).
      404       end.
      405       run trg/getpcode.p ( input  type-code
      406                      ,output cfg-param-code
      407                     ).
      408       for each buf_code-range
      409         where buf_code-range.db-num     = -1
      410           and buf_code-range.range-type = type-code
      411           and buf_code-range.stts       = "f"
      412       by buf_code-range.first-code
      413       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      414       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      415       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      416       :
      417         assign
      418           buf_code-range.db-num = p-db-num
      419         .
      420         return .
      421       end.
      422       assign
      423         v-cre-cdrg = TRUE
      424       .
      425       case type-code:
      426         when 'sclc':U
      427         or when 'scgb':U
      428         or when 'pglc':U
      429         then do:
      430           find last last-1_code-range no-lock
      431             where last-1_code-range.range-type = 'sclc':U
      432             no-error .
      433           if available last-1_code-range then do:
      434             v-cr1 = last-1_code-range.last-code.
      435           end.
      436           find last last-2_code-range no-lock
      437             where last-2_code-range.range-type = 'scgb':U
      438             no-error .
      439           if available last-2_code-range then do:
      440             v-cr2 = last-2_code-range.last-code.
      441             end.
      442           find last last-3_code-range no-lock
      443             where last-3_code-range.range-type = 'pglc':U
      444             no-error .
      445           if available last-3_code-range then do:
      446             v-cr3 = last-3_code-range.last-code.
      447           end.
      448           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      449           .
      450           if v-cmax = v-cr1  then do:
      451               find last last_code-range no-lock
      452                 where recid( last_code-range ) = recid( last-1_code-range )
      453                 .
      454             end.
      455           if v-cmax = v-cr2  then do:
      456               find last last_code-range no-lock
      457                 where recid( last_code-range ) = recid( last-2_code-range )
      458                 .
      459             end.
      460           if v-cmax = v-cr3  then do:
      461             find last last_code-range no-lock
      462               where recid( last_code-range ) = recid( last-3_code-range )
      463               .
      464           end.
      465           if last_code-range.last-code + 1 > 99999 then do:
      466             assign
      467               v-cre-cdrg = FALSE
      468             .
      469           end.
      470         end.
      471         when 'bcgb':U
      472         or when 'sslc':U
      473         or when 'ssgb':U
      474         then do:
      475           find last last-1_code-range no-lock
      476             where last-1_code-range.range-type = 'sslc':U
      477             no-error .
      478           if available last-1_code-range then do:
      479             v-cr1 = last-1_code-range.last-code.
      480           end.
      481           find last last-2_code-range no-lock
      482             where last-2_code-range.range-type = 'bcgb':U
      483             no-error .
      484           if available last-2_code-range then do:
      485             v-cr2 = last-2_code-range.last-code.
      486             end.
      487           find last last-3_code-range no-lock
      488             where last-3_code-range.range-type = 'ssgb':U
      489             no-error .
      490           if available last-3_code-range then do:
      491             v-cr3 = last-3_code-range.last-code.
      492           end.
      493           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      494           .
      495           if v-cmax = v-cr1  then do:
      496               find last last_code-range no-lock
      497                 where recid( last_code-range ) = recid( last-1_code-range )
      498                 .
      499             end.
      500           if v-cmax = v-cr2  then do:
      501               find last last_code-range no-lock
      502                 where recid( last_code-range ) = recid( last-2_code-range )
      503                 .
      504             end.
      505           if v-cmax = v-cr3  then do:
      506             find last last_code-range no-lock
      507               where recid( last_code-range ) = recid( last-3_code-range )
      508               .
      509           end.
      510         end.
      511         otherwise do:
      512           find last last_code-range no-lock
      513             where last_code-range.range-type = type-code
      514             no-error .
      515         end.
      516       end case.
      517       if not available last_code-range then do:
      518         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      519                                       ,vss-workfile
      520                                       ,vss-revision
      521                                       ,vss-description
      522                                       , chr(10)
      523                                       , type-code
      524                                      ) .
      525       end.
      526       define variable v-mes0 as character no-undo .
      527       define variable v-param-type0 as character no-undo .
      528       define variable v-value-character0 as INTEGER no-undo .
      529       define variable v-value-date0 as date no-undo .
      530       define variable v-value-decimal0 as decimal no-undo .
      531       define variable v-value-integer0 AS integer no-undo .
      532       define variable v-value-logical0 AS LOGICAL no-undo .
      533       define variable v-tth0 as handle no-undo .
      534       run adm/shattri.p (
      535           input "get":U
      536           ,input  'БД':U
      537           ,input  p-db-num
      538           ,input  'code-range':U
      539           ,input  cfg-param-code
      540           ,output v-value-character0
      541           ,output v-value-date0
      542           ,output v-value-decimal0
      543           ,output v-value-integer0
      544           ,output v-value-logical0
      545           ,output v-param-type0
      546           ,INPUT-OUTPUT table-handle v-tth0
      547           ) no-error .
      548       if error-status :error then do:
      549         delete object v-tth0.
      550         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      551                            , error-status:get-message(1)
      552                            , chr(10)
      553                            , return-value ).
      554         undo, return error v-mes0.
      555       end.
      556       delete object v-tth0.
      557       if v-cre-cdrg = TRUE then do:
      558         create buf_code-range .
      559         assign
      560           buf_code-range.db-num     = p-db-num
      561           buf_code-range.range-type = type-code
      562           buf_code-range.stts       = "f"
      563           buf_code-range.first-code = last_code-range.last-code + 1
      564           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      565           v-cre-str = "Свободный диапазон успешно создан"
      566         .
      567       end.
      568       else do:
      569         assign
      570           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      571                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      572         .
      573       end.
      574     end.
      575     return v-cre-str .
      576   end procedure.
      577   procedure gen-new-code-range-if-neces :
      578     define input parameter v-db-num           like ub.db.db-num             no-undo .
      579     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      580     define input parameter v-cur-code         as   integer                  no-undo .
      581     define input parameter v-g#news           as   logical                  no-undo .
      582     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      583     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      584     do
      585     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      586     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      587     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      588     :
      589       define variable l-code-range-exist as logical   no-undo init false .
      590       define variable v-db-for-send      as character no-undo .
      591       define buffer buf_code-range  for ub.code-range .
      592       define buffer buf1_code-range for ub.code-range .
      593       define buffer buf_db          for ub.db .
      594       find first buf_code-range
      595         where buf_code-range.range-type = v-range-type
      596           and buf_code-range.last-code >= v-cur-code
      597         use-index last-codei
      598         no-error .
      599       if
      600       (
      601          available buf_code-range
      602          and
      603         (buf_code-range.db-num = v-db-num
      604           and
      605         buf_code-range.first-code <= v-cur-code
      606         )
      607       or
      608         (
      609           v-range-type = 'drgb':U
      610           AND
      611           v-cur-code = 0
      612         )
      613      )
      614      then do:
      615         assign
      616           l-code-range-exist = true
      617         .
      618         if v-g#news
      619         and buf_code-range.stts = "f" then do:
      620           assign
      621             buf_code-range.stts = "u"
      622           .
      623         end.
      624       end.
      625       if not l-code-range-exist
      626          and v-g#news-source-db <> 0
      627       then do:
      628         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      629                                       ,vss-workfile
      630                                       ,vss-revision
      631                                       ,vss-description
      632                                       ,chr(10)
      633                                       ,v-db-num
      634                                       ,v-range-type
      635                                       ,v-cur-code
      636                                      ).
      637       end.
      638       if (not l-code-range-exist
      639           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      640          )
      641       and ( not can-find (first buf1_code-range no-lock
      642                           where buf1_code-range.db-num = v-db-num
      643                             and buf1_code-range.range-type = v-range-type
      644                             and buf1_code-range.stts = "f"
      645                          )
      646           )
      647       then do:
      648         if v-g#db-num = 0 then do:
      649           run new-bcod-gen-code-range in this-procedure
      650             (input v-db-num,
      651              input v-range-type
      652             ) no-error .
      653           if error-status :error then do:
      654             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      655                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      656                                           ,v-db-num
      657                                           ,v-range-type
      658                                           ,v-cur-code
      659                                           ,chr(10)
      660                                           ,error-status:get-message(1)
      661                                           ,return-value
      662                                          ).
      663           end.
      664         end.
      665         else do:
      666           if v-range-type = 'sclc':U
      667           or v-range-type = 'pglc':U
      668           then do:
      669             assign
      670               v-db-for-send = "":U
      671             .
      672             if v-g#db-num = 0 then do:
      673               for each buf_db no-lock
      674                 where buf_db.db-num > 0
      675                   and buf_db.db-num <> v-g#news-source-db
      676               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      677               :
      678                 assign
      679                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      680                 .
      681               end.
      682               assign
      683                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      684               .
      685             end.
      686             else do:
      687               if not v-g#news then do:
      688                 assign
      689                   v-db-for-send = "0":U
      690                 .
      691               end.
      692             end.
      693             run nws/cr-route.p ( input 'send-cmd':U
      694                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      695                                  "code-range":U + chr(1) +
      696                                  (if v-range-type = 'sclc':U
      697                                   then string( current-value(s-sclc-code, ub))
      698                                   else string( current-value(s-pglc-code, ub))
      699                                   ) + chr(1) +
      700                                   v-range-type)
      701                           ,input ?
      702                           ,input v-db-for-send
      703                           ) no-error .
      704             if error-status :error then do:
      705               undo, return error return-value.
      706             end.
      707           end.
      708         end.
      709       end.
      710     end.
      711   end procedure.
      712   procedure cre-loc-sc-code-range :
      713     define input parameter v-cur-code as integer no-undo .
      714   define input parameter p-cdrg-type as character no-undo .
      715     do
      716     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      717     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      718     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      719     :
      720       define buffer buf_code-range for ub.code-range .
      721       find first buf_code-range
      722            where buf_code-range.range-type = p-cdrg-type
      723              and buf_code-range.first-code >= v-cur-code
      724            no-error .
      725       if not available buf_code-range then do:
      726         run new-bcod-gen-code-range in this-procedure
      727           ( input 0,
      728             input p-cdrg-type
      729           ) no-error .
      730         if error-status :error then do:
      731           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      732                                          + "Код &2&1&3 &4"
      733                                         , chr(10)
      734                                         , v-cur-code
      735                                         , error-status:get-message(1)
      736                                         , return-value
      737                                        ) .
      738         end.
      739       end.
      740     end.
      741   end procedure.
      742   procedure mark-used-if-need :
      743   define input parameter p-cur-code as integer no-undo .
      744   define input parameter p-range-type like ub.code-range.range-type no-undo .
      745   define input parameter p-db-num like ub.code-range.db-num no-undo .
      746     do
      747     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      748     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      749     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      750     :
      751       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      752       define buffer buf_code-range for ub.code-range .
      753       assign
      754       v-db-num = if p-range-type = 'sclc':U
      755                  then 0
      756                  else p-db-num
      757       .
      758   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      759   define buffer locK-batchprocess1 for ub.batchprocess.
      760   run gbl/lock-prc.p
      761       (input 'lscc':U
      762       ,input 0
      763       ,input 0
      764       ,input 0
      765       ,input ""
      766       ,input ""
      767       ,input ""
      768       ,input (
      769               ",,,Вкл/выкл лок. вес. кодов"
      770              )
      771       ,input true
      772       ,buffer lock-batchprocess1
      773       ) no-error .
      774     if error-status :error then do:
      775       message
      776         vss-workfile vss-revision vss-description skip
      777         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      778         view-as alert-box error .
      779       undo, return error .
      780     end.
      781       find first buf_code-range
      782            where buf_code-range.range-type = p-range-type
      783              and buf_code-range.first-code >= p-cur-code
      784              and buf_code-range.last-code <= p-cur-code
      785              and buf_code-range.db-num = v-db-num
      786            no-error .
      787       if not available buf_code-range then do:
      788         message
      789           vss-workfile vss-revision vss-description skip
      790           "Ошибка при создании поиске диапазона" skip
      791           "База данных" p-db-num skip
      792           "Код" p-cur-code skip
      793           "Тип" p-range-type
      794           error-status :get-message(1) skip
      795           return-value skip
      796           view-as alert-box error .
      797         undo, return error .
      798       end.
      799       if buf_code-range.stts = "f":U then do:
      800         assign
      801         buf_code-range.stts = "u":U
      802         .
      803       end.
      804     end.
      805   end procedure.
      806   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      807   define variable v-waitfram-action01         as character   no-undo .
      808   define variable v-waitfram-action02         as character   no-undo .
      809   define variable v-waitfram-action03         as character   no-undo .
      810   define variable mWaitFramTextBeg            as character   no-undo.
      811   define variable mWaitFramTextEnd            as character   no-undo.
      812   define variable mWaitFramView               as logical     no-undo.
      813   define variable mWaitProcEvent              as logical     no-undo init yes.
      814   define variable mWaitFramInterval           as integer     no-undo init 1 .
      815   define variable mWaitFramStop               as logical     no-undo.
      816   define variable mWaitFramStopUser           as logical     no-undo.
      817   define variable mWaitFramStopTimeOut        as logical     no-undo.
      818   define variable mWaitFramStartProc          as datetime-tz no-undo.
      819   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      820   define button B-WaitFramStop auto-end-key
      821        label "Стоп"
      822        size 10 by 1 tooltip "Остоновить процесс".
      823   define button B-viewProcInfo
      824        label "Информация"
      825        size 15 by 1 tooltip "Информация о процесс".
      826   define frame waitfram
      827     v-waitfram-action01 format "x(72)" no-label skip
      828     v-waitfram-action02 format "x(72)" no-label skip
      829     v-waitfram-action03 format "x(72)" no-label skip
      830     B-viewProcInfo
      831     B-WaitFramStop at row 4 col 30
      832     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      833     .
      834   define new global shared variable mBatchMode as logical no-undo init ?.
      835   define variable mFramBachModHandle as handle no-undo.
      836   mFramBachModHandle = frame waitfram:handle.
      837   define variable mFameOldVis as logical no-undo.
      838   define variable mVisCUrentVin as logical no-undo.
      839   if session:batch-mode
      840   then
      841      mBatchMode = yes.
      842   if mBatchMode = ? then do:
      843     mVisCUrentVin = current-window:visible.
      844     mFameOldVis = mFramBachModHandle:visible.
      845     mFramBachModHandle:visible  = yes.
      846     mBatchMode = mFramBachModHandle:visible ne yes.
      847     mFramBachModHandle:visible = mFameOldVis.
      848     current-window:visible = mVisCUrentVin.
      849   end.
      850    if  log-manager:logfile-name ne ?
      851     then DO:
      852         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      853         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      854         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      855     end.
      856   on choose of B-WaitFramStop in frame waitfram
      857   do:
      858     mWaitFramStop = yes.
      859     mWaitFramStopUser = yes.
      860   end.
      861   function waitfram-check-timeout returns logical():
      862      define variable vtime as int64 no-undo.
      863      if mWaitFramStopTimeOut
      864      then
      865         return yes.
      866      vtime = ( now - mWaitFramStartProc ) / 1000 .
      867      if     mWaitFramTimeOut ne ?
      868         and mWaitFramTimeOut ne 0
      869         and mWaitFramTimeOut lt vtime
      870      then do:
      871         mWaitFramStopTimeOut = yes.
      872      end.
      873      return mWaitFramStopTimeOut.
      874   end.
      875   procedure waitfram-hide :
      876     if not session:batch-mode
      877     then do
      878     on error undo, return error return-value
      879     :
      880       pause 0 before-hide .
      881       if not mBatchMode then
      882         hide frame waitfram .
      883     if     not mWaitFramView
      884        and mWaitProcEvent
      885     then
      886       process events .
      887     end.
      888   end procedure.
      889   procedure waitfram-show :
      890     define input  parameter p-message as character no-undo .
      891     define variable v-left-margin as integer   no-undo .
      892     if not session:batch-mode
      893     then do
      894     on error undo, return error return-value
      895     :
      896       if length(p-message) <= 70 then do:
      897         assign
      898           v-left-margin = integer((70 - length(p-message)) / 2)
      899         .
      900         assign
      901           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      902         .
      903         assign
      904           v-waitfram-action01 = " "
      905           v-waitfram-action02 = " "
      906                                    + fill(" ", v-left-margin)
      907                                    + p-message
      908           v-waitfram-action03 = " "
      909         .
      910       end.
      911       else do:
      912         define variable vRindex1 as integer no-undo.
      913         define variable vRindex2 as integer no-undo.
      914         vRindex1 = r-index(p-message," ",70).
      915         if vRindex1 = 0
      916         then
      917            vRindex1 = 70.
      918         if length(p-message)  <= vRindex1 + 70 then do:
      919           assign
      920             v-waitfram-action01 = " "
      921             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      922             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      923           .
      924         end.
      925         else do:
      926           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      927           if vRindex2 <= vRindex1
      928           then
      929              vRindex2 = vRindex1 + 70.
      930           assign
      931             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      932             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      933             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      934           .
      935         end.
      936       end.
      937       B-viewProcInfo:visible   in frame waitfram = no.
      938       B-viewProcInfo:sensitive in frame waitfram = no.
      939       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      940       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      941       if  (   mWaitFramView
      942          or  mWaitProcEvent)
      943          and not mBatchMode
      944       then
      945          display
      946             v-waitfram-action01 skip
      947             v-waitfram-action02 skip
      948             v-waitfram-action03 skip
      949          with frame waitfram .
      950       if     mWaitFramView
      951          then do:
      952             if     mWaitFramInterval ne ?
      953                and not mBatchMode
      954             then
      955                wait-for go of frame waitfram pause mWaitFramInterval.
      956          end.
      957          else
      958             if     mWaitProcEvent
      959                and not mBatchMode
      960             then
      961                process events .
      962     end.
      963   end procedure.
      964      procedure waitfram-show-this:
      965         define input  parameter iInterval as int64 no-undo.
      966         define variable vtime as int64 no-undo.
      967         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      968         mWaitFramInterval = iInterval.
      969         run waitfram-show (substitute("&1&2 &3&4" ,
      970                                       mWaitFramTextBeg ,
      971                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      972                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      973                                       mWaitFramTextEnd
      974                                      )
      975                           ).
      976      end.
      977      procedure WaitFramRunPause:
      978         define input  parameter iInterval as dec no-undo.
      979         define variable vStart  as datetime-tz no-undo.
      980         define variable vend    as datetime-tz no-undo.
      981         define variable vint as int64 no-undo.
      982         define variable vOk as logical no-undo.
      983         vStart = now.
      984         vend   = vStart.
      985         publish "WaitFramPause" (iInterval,output vOk).
      986         vend   =  now.
      987         vint = vend - vStart.
      988         vint = iInterval - vint / 1000.
      989         if     not mWaitFramStop
      990            and (   vint > 0
      991                 or (    not vOk
      992                     and iInterval eq ?
      993                     )
      994                 )
      995         then
      996            run waitfram-show-this (iInterval).
      997         vend   =  now.
      998         vint = vend - vStart.
      999         vint = iInterval - vint / 1000.
     1000         if     not mWaitFramStop
     1001            and vint > 0
     1002         then do:
     1003            run gbl/pause.p (vint * 1000).
     1004         end.
     1005         if iInterval ne ?
     1006         then
     1007            publish "WaitFramStop".
     1008         waitfram-check-timeout().
     1009      end.
     1010      procedure WaitFramWaitFor:
     1011         define input  parameter iInterval as dec no-undo.
     1012         assign
     1013            mWaitFramStartProc   = now
     1014            mWaitFramStopUser    = no
     1015            mWaitFramStopTimeOut = no
     1016         .
     1017         block-wait:
     1018         do while not mWaitFramStop:
     1019            run WaitFramRunPause (iInterval).
     1020            if  waitfram-check-timeout()
     1021            then do:
     1022               leave block-wait.
     1023            end.
     1024         end.
     1025         run waitfram-hide.
     1026      end.
     1027   procedure waitfram-join :
     1028     define input  parameter p-line-1  as character no-undo .
     1029     define input  parameter p-line-2  as character no-undo .
     1030     define input  parameter p-line-3  as character no-undo .
     1031     define output parameter p-message as character no-undo .
     1032     do
     1033     on error undo, return error return-value
     1034     :
     1035       assign
     1036         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1037                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1038                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1039       .
     1040     end.
     1041   end procedure.
     1042   function waitfram-join-function returns character
     1043     (input p-line-1 as character
     1044     ,input p-line-2 as character
     1045     ,input p-line-3 as character
     1046     ).
     1047     define variable v-message as character no-undo .
     1048     run waitfram-join in this-procedure
     1049       (input  p-line-1
     1050       ,input  p-line-2
     1051       ,input  p-line-3
     1052       ,output v-message
     1053       ) .
     1054     return v-message .
     1055   end function .
     1056   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1057   define new global shared variable g#attr-lib  as handle no-undo .
     1058   define variable v-attr-lib-variable as handle no-undo .
     1059   procedure gdsoattr-name :
     1060     define input  parameter p-code           as character no-undo .
     1061     define output parameter p-type           as character no-undo .
     1062     define output parameter p-format         as character no-undo .
