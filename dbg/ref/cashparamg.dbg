      573   if mBatchMode = ? then do:
      574     mVisCUrentVin = current-window:visible.
      575     mFameOldVis = mFramBachModHandle:visible.
      576     mFramBachModHandle:visible  = yes.
      577     mBatchMode = mFramBachModHandle:visible ne yes.
      578     mFramBachModHandle:visible = mFameOldVis.
      579     current-window:visible = mVisCUrentVin.
      580   end.
      581    if  log-manager:logfile-name ne ?
      582     then DO:
      583         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      584         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      585         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      586     end.
      587   on choose of B-WaitFramStop in frame waitfram
      588   do:
      589     mWaitFramStop = yes.
      590     mWaitFramStopUser = yes.
      591   end.
      592   function waitfram-check-timeout returns logical():
      593      define variable vtime as int64 no-undo.
      594      if mWaitFramStopTimeOut
      595      then
      596         return yes.
      597      vtime = ( now - mWaitFramStartProc ) / 1000 .
      598      if     mWaitFramTimeOut ne ?
      599         and mWaitFramTimeOut ne 0
      600         and mWaitFramTimeOut lt vtime
      601      then do:
      602         mWaitFramStopTimeOut = yes.
      603      end.
      604      return mWaitFramStopTimeOut.
      605   end.
      606   procedure waitfram-hide :
      607     if not session:batch-mode
      608     then do
      609     on error undo, return error return-value
      610     :
      611       pause 0 before-hide .
      612       if not mBatchMode then
      613         hide frame waitfram .
      614     if     not mWaitFramView
      615        and mWaitProcEvent
      616     then
      617       process events .
      618     end.
      619   end procedure.
      620   procedure waitfram-show :
      621     define input  parameter p-message as character no-undo .
      622     define variable v-left-margin as integer   no-undo .
      623     if not session:batch-mode
      624     then do
      625     on error undo, return error return-value
      626     :
      627       if length(p-message) <= 70 then do:
      628         assign
      629           v-left-margin = integer((70 - length(p-message)) / 2)
      630         .
      631         assign
      632           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      633         .
      634         assign
      635           v-waitfram-action01 = " "
      636           v-waitfram-action02 = " "
      637                                    + fill(" ", v-left-margin)
      638                                    + p-message
      639           v-waitfram-action03 = " "
      640         .
      641       end.
      642       else do:
      643         define variable vRindex1 as integer no-undo.
      644         define variable vRindex2 as integer no-undo.
      645         vRindex1 = r-index(p-message," ",70).
      646         if vRindex1 = 0
      647         then
      648            vRindex1 = 70.
      649         if length(p-message)  <= vRindex1 + 70 then do:
      650           assign
      651             v-waitfram-action01 = " "
      652             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      653             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      654           .
      655         end.
      656         else do:
      657           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      658           if vRindex2 <= vRindex1
      659           then
      660              vRindex2 = vRindex1 + 70.
      661           assign
      662             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      663             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      664             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      665           .
      666         end.
      667       end.
      668       B-viewProcInfo:visible   in frame waitfram = no.
      669       B-viewProcInfo:sensitive in frame waitfram = no.
      670       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      671       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      672       if  (   mWaitFramView
      673          or  mWaitProcEvent)
      674          and not mBatchMode
      675       then
      676          display
      677             v-waitfram-action01 skip
      678             v-waitfram-action02 skip
      679             v-waitfram-action03 skip
      680          with frame waitfram .
      681       if     mWaitFramView
      682          then do:
      683             if     mWaitFramInterval ne ?
      684                and not mBatchMode
      685             then
      686                wait-for go of frame waitfram pause mWaitFramInterval.
      687          end.
      688          else
      689             if     mWaitProcEvent
      690                and not mBatchMode
      691             then
      692                process events .
      693     end.
      694   end procedure.
      695      procedure waitfram-show-this:
      696         define input  parameter iInterval as int64 no-undo.
      697         define variable vtime as int64 no-undo.
      698         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      699         mWaitFramInterval = iInterval.
      700         run waitfram-show (substitute("&1&2 &3&4" ,
      701                                       mWaitFramTextBeg ,
      702                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      703                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      704                                       mWaitFramTextEnd
      705                                      )
      706                           ).
      707      end.
      708      procedure WaitFramRunPause:
      709         define input  parameter iInterval as dec no-undo.
      710         define variable vStart  as datetime-tz no-undo.
      711         define variable vend    as datetime-tz no-undo.
      712         define variable vint as int64 no-undo.
      713         define variable vOk as logical no-undo.
      714         vStart = now.
      715         vend   = vStart.
      716         publish "WaitFramPause" (iInterval,output vOk).
      717         vend   =  now.
      718         vint = vend - vStart.
      719         vint = iInterval - vint / 1000.
      720         if     not mWaitFramStop
      721            and (   vint > 0
      722                 or (    not vOk
      723                     and iInterval eq ?
      724                     )
      725                 )
      726         then
      727            run waitfram-show-this (iInterval).
      728         vend   =  now.
      729         vint = vend - vStart.
      730         vint = iInterval - vint / 1000.
      731         if     not mWaitFramStop
      732            and vint > 0
      733         then do:
      734            run gbl/pause.p (vint * 1000).
      735         end.
      736         if iInterval ne ?
      737         then
      738            publish "WaitFramStop".
      739         waitfram-check-timeout().
      740      end.
      741      procedure WaitFramWaitFor:
      742         define input  parameter iInterval as dec no-undo.
      743         assign
      744            mWaitFramStartProc   = now
      745            mWaitFramStopUser    = no
      746            mWaitFramStopTimeOut = no
      747         .
      748         block-wait:
      749         do while not mWaitFramStop:
      750            run WaitFramRunPause (iInterval).
      751            if  waitfram-check-timeout()
      752            then do:
      753               leave block-wait.
      754            end.
      755         end.
      756         run waitfram-hide.
      757      end.
      758   procedure waitfram-join :
      759     define input  parameter p-line-1  as character no-undo .
      760     define input  parameter p-line-2  as character no-undo .
      761     define input  parameter p-line-3  as character no-undo .
      762     define output parameter p-message as character no-undo .
      763     do
      764     on error undo, return error return-value
      765     :
      766       assign
      767         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      768                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      769                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      770       .
      771     end.
      772   end procedure.
      773   function waitfram-join-function returns character
      774     (input p-line-1 as character
      775     ,input p-line-2 as character
      776     ,input p-line-3 as character
      777     ).
      778     define variable v-message as character no-undo .
      779     run waitfram-join in this-procedure
      780       (input  p-line-1
      781       ,input  p-line-2
      782       ,input  p-line-3
      783       ,output v-message
      784       ) .
      785     return v-message .
      786   end function .
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   FUNCTION mark-string RETURNS CHARACTER
      789     ( input p-recid as recid, input mark-list as character  ) :
      790     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      791   END FUNCTION.
      792   define variable log-res     as log       no-undo.
      793   define variable ri          as recid     no-undo.
      794   define variable v-rid       as recid     no-undo .
      795   define variable v-db-num like ub.db.db-num no-undo .
      796   DEFINE BUTTON b-add
      797        LABEL "&Добавить":L
      798        SIZE 10 BY 1.
      799   DEFINE BUTTON b-chiled
      800        LABEL "&Открыть"
      801        SIZE 10 BY 1.
      802   DEFINE BUTTON b-del
      803        LABEL "&Удалить":L
      804        SIZE 10 BY 1.
      805   DEFINE BUTTON b-exit AUTO-GO
      806        LABEL "&Выход ":L
      807        SIZE 10 BY 1.
      808   DEFINE BUTTON b-help
      809        LABEL "Помо&щь":L
      810        SIZE 3 BY 1.
      811   DEFINE BUTTON b-sel
      812        LABEL "Вы&бор ":L
      813        SIZE 10 BY 1.
      814   DEFINE BUTTON b-upd
      815        LABEL "&Изменить":L
      816        SIZE 10 BY 1.
      817   define variable mSearch   as character       format "x(60)":U
      818      label "Поиск"
      819      view-as fill-in
      820      size 60 by 1 no-undo.
      821   define button b-hist
      822      label "Ис&тория"
      823      size 3 by 1.
      824   define menu POPUP-MENU-b-hist
      825       menu-item mHistOne     label "История этой записи"
      826       menu-item mHistChiled  label "История потомков"
      827   .
      828    define  temp-table tmprecid
      829       field Frecid as recid init ?
      830       field fnum as character
      831       field fTable as character
      832    index num  fnum Frecid
      833    index itable is primary unique fTable Frecid
      834    .
      835   define variable fSelect as logical no-undo format "*/" column-label "".
      836   function isSelect return logical
      837       (iBuffer as handle  ):
      838       define buffer tmprecid for tmprecid.
      839       if iBuffer:available
      840       then
      841          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      842                                and tmprecid.Frecid = iBuffer:recid
      843          no-lock no-error.
      844       return available tmprecid.
      845    end.
      846   function setSelect return logical
      847       (iBuffer as handle  ):
      848       define buffer tmprecid for tmprecid.
      849       if iBuffer:available
      850       then do:
      851          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      852                                and tmprecid.Frecid = iBuffer:recid
      853          no-lock no-error.
      854          if available tmprecid
      855          then
      856             delete tmprecid.
      857          else do:
      858             create tmprecid.
      859             assign
      860                tmprecid.fTable = iBuffer:TABLE
      861                tmprecid.Frecid = iBuffer:recid
      862             .
      863          end.
      864       end.
      865       return available tmprecid.
      866    end.
      867    procedure rid-keep :
      868        run gbl/rid-keep.p (input table tmprecid) no-error.
      869    end.
      870    procedure rid-rest :
      871         run gbl/rid-rest.p (output table tmprecid) no-error.
      872    end.
      873   DEFINE QUERY BROWSE-Code FOR
      874         Code SCROLLING.
      875   DEFINE BROWSE BROWSE-Code
      876     QUERY BROWSE-Code NO-LOCK DISPLAY
      877         isSelect(buffer code:handle) @ fSelect
      878         Code.code FORMAT "x(8)":U column-label "Название группы"
      879         Code.CodeName FORMAT "x(60)":U WIDTH 54.13 column-label "Описание группы"
      880       WITH NO-ROW-MARKERS SEPARATORS SIZE 73 BY 20 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      881   DEFINE FRAME f-c-p
      882        b-exit AT ROW 1 COL 1
      883        b-sel AT ROW 1 COL 14
      884        b-add AT ROW 1 COL 24
      885        b-del AT ROW 1 COL 34 WIDGET-ID 2
      886        b-upd AT ROW 1 COL 44.13
      887        b-hist at row 1 col 65.4
      888        b-help AT ROW 1 COL 71
      889        b-chiled AT ROW 1 COL 54.13 WIDGET-ID 10
      890        mSearch AT ROW 2.5 col 1
      891        BROWSE-Code AT ROW 4 COL 1 WIDGET-ID 300
      892       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      893            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      894            TITLE "Группы параметров":L.
      895   ASSIGN
      896          FRAME f-c-p:SCROLLABLE       = FALSE.
      897   on choose of menu-item mHistOne
      898   do:
      899      define variable v-rid-list as character no-undo.
      900      if avail Code then
      901      do:
      902         run ref/ccode.w (
      903                   Code.parent,
      904                   Code.code,
      905                   parparentproc,
      906                   0,
      907                   "",
      908                   0,
      909                   "",
      910                   "one",
      911                   ?,
      912                   "",
      913                   "" ,
      914                   v-cntxt-db-num,
      915                   ?,
      916                   input-output v-rid-list ) .
      917      end.
      918   end.
      919   on choose of menu-item mHistChiled
      920   do:
      921      define variable v-rid-list as character no-undo.
      922      if avail Code then
      923      do:
      924         run ref/ccode.w (
      925                   Code.parent,
      926                   Code.code,
      927                   parparentproc,
      928                   0,
      929                   "",
      930                   0,
      931                   "",
      932                   "parentBeg",
      933                   ?,
      934                   "",
      935                   "" ,
      936                   v-cntxt-db-num,
      937                   ?,
      938                   input-output v-rid-list ) .
      939      end.
      940   end.
      941   ON go OF FRAME f-c-p
      942   do:
      943   end.
      944   ON choose OF b-add IN FRAME f-c-p
      945   do:
      946      define buffer b1-code for code.
      947      define buffer btt-code for code.
      948      define variable vRec as recid no-undo.
      949      define variable v-ok as logical no-undo.
      950      run ref/cashparamgu.w (
      951                               input parparentproc
      952                             , input 'ДОБАВЛЕНИЕ':U
      953                             , input iparent + chr(4) + icode
      954                             , input-output vRec).
      955      if vRec <> ? then  do:
      956               OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = iparent + chr(4) + icode NO-LOCK INDEXED-REPOSITION.
      957               reposition BROWSE-Code to recid vRec.
      958               apply "ENTRY" to BROWSE-Code.
      959      end.
      960   end.
      961   ON choose OF b-chiled IN FRAME f-c-p
      962   do:
      963      if not available code then return.
      964        if imode eq 'ВЫБОР':U
      965     then
      966        run rid-keep no-error.
      967      run ref/cashparam.w (
      968                             input parparentproc
      969                           , input imode
      970                           , input code.parent
      971                           , input code.code
      972                           , input ?).
      973        if imode eq 'ВЫБОР':U
      974     then
      975        run rid-rest no-error.
      976   end.
      977   ON choose OF b-del IN FRAME f-c-p
      978   do:
      979      define buffer b1-code for code.
      980      if not avail code then return.
      981      define variable v-ok as logical no-undo.
      982      message "Удалить запись " code.code " (" code.codename ")?"
      983         view-as alert-box question
      984         buttons yes-no
      985         title "Удаление"
      986         update v-ok .
      987      if not v-ok then return no-apply.
      988      do on error undo, return
      989      on stop undo, return:
      990         find first b1-code of code exclusive-lock no-wait no-error.
      991         if locked b1-code then do:
      992            message
      993               vss-workfile vss-revision vss-description skip
      994               "Группа занята"
      995            view-as alert-box error .
      996            undo, return.
      997         end.
      998         if not available b1-code then do:
      999            message
     1000               vss-workfile vss-revision vss-description skip
     1001               "Не найдена запись группы"
     1002            view-as alert-box error .
     1003            undo, return.
     1004         end.
     1005         delete b1-code.
     1006         OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = iparent + chr(4) + icode NO-LOCK INDEXED-REPOSITION.
     1007         apply "ENTRY" to BROWSE-Code.
     1008      end.
     1009   end.
     1010   ON choose OF b-sel IN FRAME f-c-p
     1011   do:
     1012       setSelect(buffer code:handle).
     1013       BROWSE-Code:refresh ().
     1014   end.
     1015   ON choose OF b-upd IN FRAME f-c-p
     1016   do:
     1017      define variable vRec as recid no-undo.
     1018      if not avail code then return.
     1019      define variable v-ok as logical no-undo.
     1020      vRec = recid(code).
     1021      run ref/cashparamgu.w (
     1022                               input parparentproc
     1023                             , input 'ИЗМЕНЕНИЕ':U
     1024                             , input iparent + chr(4) + icode
     1025                             , input-output vRec).
     1026            OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = iparent + chr(4) + icode NO-LOCK INDEXED-REPOSITION.
     1027            reposition BROWSE-Code to recid vRec.
     1028            apply "ENTRY" to BROWSE-Code.
     1029         end.
     1030   on mouse-select-dblclick of BROWSE-Code in frame f-c-p
     1031   or return of b-upd in frame f-c-p
     1032   do:
     1033     apply "choose" to b-chiled in frame f-c-p.
     1034   end.
     1035   on ENTER of mSearch in frame f-c-p
     1036   do:
     1037         define buffer buf-code-search for ub.code.
     1038      assign
     1039        msearch
     1040      .
     1041      define variable vRec as recid no-undo init ?.
     1042      block-code:
     1043      for each buf-code-search where (buf-code-search.parent = iparent + chr(4) + icode and buf-code-search.code     begins msearch)
     1044                                 or (buf-code-search.parent = iparent + chr(4) + icode and buf-code-search.CodeName begins msearch)
     1045      no-lock:
     1046         vRec = recid(buf-code-search).
     1047         leave block-code.
     1048      end.
     1049         if vRec eq ?
     1050      then do:
     1051         message "Запись не найдена"
     1052         view-as alert-box.
     1053      end.
     1054      else do:
     1055         reposition BROWSE-Code to recid vRec no-error .
     1056         apply "ENTRY" to BROWSE-Code.
     1057      end.
     1058   end.
     1059   if valid-handle(active-window) and frame f-c-p:PARENT eq ?
     1060     then frame f-c-p:PARENT = active-window.
     1061   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1062   on help of frame f-c-p
     1063   do:
     1064     run gbl/app_help.p
     1065       (input this-procedure :file-name
     1066       ,input ''
     1067       ,input ?
     1068       ) no-error.
     1069     if error-status :error then do:
     1070       message
     1071         "Ошибка при вызове помощи"
     1072         error-status :get-message(1)
     1073         view-as alert-box .
     1074     end.
     1075   end.
     1076   run minbtn-set in this-procedure .
     1077   on choose of b-help in frame f-c-p
     1078   do:
     1079     apply "help":u to frame f-c-p .
     1080   end.
     1081   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1082   procedure minbtn-set :
     1083       do
     1084           on error undo, return error return-value
     1085           :
     1086           define variable ii              as integer       no-undo .
     1087           define variable fh              as widget-handle no-undo .
     1088           define variable hh              as widget-handle no-undo .
     1089           define variable v-h             as handle        extent 4 no-undo .
     1090           define variable v-name-button   as character     no-undo .
     1091           define variable v-help-old-x    as decimal       no-undo .
     1092           define variable v-help-old-y    as decimal       no-undo .
     1093           define variable v-help-old-size as decimal       no-undo .
     1094           define variable v-frame-width   as decimal       no-undo .
     1095           define variable jj              as integer       no-undo .
     1096           do
     1097               on error undo, return error
     1098               :
     1099               assign
     1100                   v-frame-width = frame f-c-p:width - 0.3
     1101                   fh            = frame f-c-p:first-child
     1102                   hh            = fh:first-child
     1103                   ii            = 1
     1104                   .
     1105               do while valid-handle(hh):
     1106                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1107                   do:
     1108                       case lc(hh:name) :
     1109                           when "b-help" then
     1110                               do:
     1111                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1112                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1113                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1114                                   hh:TOOLTIP = "Помощь" .
     1115                                   v-help-old-x = hh:column .
     1116                                   v-help-old-y = hh:row    .
     1117                                   v-help-old-size = hh:width .
     1118                                   hh:width-chars = 2.5 .
     1119                               end.
     1120                           when "b-print" then
     1121                               do:
     1122                                   hh:load-image("cmp/b-print.bmp":u) .
     1123                                   hh:TOOLTIP = "Печать" .
     1124                                   v-h[ii] = hh:handle .
     1125                                   ii = ii + 1 .
     1126                                   hh:width-chars = 3 .
     1127                               end.
     1128                           when "b-history" or
     1129                           when "b-hist" then
     1130                               do:
     1131                                   hh:load-image("cmp/b-hist.bmp":u) .
     1132                                   hh:TOOLTIP = "История" .
     1133                                   v-h[ii] = hh:handle .
     1134                                   ii = ii + 1 .
     1135                                   hh:width-chars = 3 .
     1136                               end.
     1137                           when "b-sch" then
     1138                               do:
     1139                                   hh:load-image("cmp/b-sch.bmp":u) .
     1140                                   hh:TOOLTIP = "Установка Фильтра" .
     1141                                   v-h[ii] = hh:handle .
     1142                                   ii = ii + 1 .
     1143                                   hh:width-chars = 3 .
     1144                               end.
     1145                           when "b-hist-user" then
     1146                               do:
     1147                                   hh:load-image("cmp/b-hist.bmp":u) .
     1148                                   hh:TOOLTIP = "История пользователя" .
     1149                                   ii = ii + 1 .
     1150                               end.
     1151                       end case.
     1152                   end.
     1153                   hh = hh:next-sibling.
     1154               end.
     1155               b-help:column = v-frame-width - b-help:width-chars.
     1156               jj = 0.
     1157               repeat ii = 4 to 1 by -1 :
     1158                   if valid-handle (v-h[ii] ) then
     1159                   do:
     1160                       jj  = jj + 1 .
     1161                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1162                       v-h[ii]:row    = v-help-old-y .
     1163                   end.
     1164               end.
     1165           end.
     1166       end.
     1167   end procedure.
     1168   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1169   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1170   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1171   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1172   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1173   define variable v-diasize-current-frame-height as decimal   no-undo .
     1174   define variable v-diasize-change-size          as logical   no-undo .
     1175   define variable v-diasize-resize-button        as handle    no-undo .
     1176   define variable v-diasize-wndmax               as logical   no-undo .
     1177   define variable v-diasize-wndstore             as logical   no-undo .
     1178   define variable v-diasize-proc-name            as character no-undo .
     1179   define variable v-diasize-browse-handle        as handle    no-undo .
     1180   define variable v-diasize-browse-number        as integer   no-undo .
     1181   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1182   define temp-table temp-diasize-handle no-undo
     1183     field handle-value  as handle
     1184     field save-position as decimal
     1185     index xpk is primary unique handle-value
     1186     .
     1187   define temp-table temp-browse-handle no-undo
     1188     field browse-type   as character
     1189     field browse-number as integer
     1190     field browse-handle as handle
     1191     field original-size as decimal
     1192     index xpk is primary unique browse-type browse-number
     1193     index xie browse-type browse-handle
     1194   .
     1195   procedure diasize_change-height :
     1196     define input  parameter p-change-value  as decimal   no-undo .
     1197     define input  parameter p-move-resize   as logical   no-undo .
     1198     define variable v-field-group-handle    as handle    no-undo .
     1199     define variable v-object-handle         as handle    no-undo .
     1200     define variable v-frame-height          as decimal   no-undo .
     1201     define variable v-frame-virtual-height  as decimal   no-undo .
     1202     define variable v-browse-height         as decimal   no-undo .
     1203     define variable v-window-height         as decimal   no-undo .
     1204     define variable v-window-virtual-height as decimal   no-undo .
     1205     define variable v-change-sign           as integer   no-undo .
     1206     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1207     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1208     if p-change-value > 0
     1209     then do:
     1210       if frame f-c-p :height + p-change-value
     1211           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1212       then do:
     1213         assign
     1214           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1215                           - (frame f-c-p :height-chars)
     1216         .
     1217         if p-change-value <= 0
     1218         then do:
     1219           run diasize_position-resize-button in this-procedure .
     1220           return .
     1221         end.
     1222       end.
     1223     end.
     1224     if p-change-value < 0
     1225     then do:
     1226       if frame f-c-p :height + p-change-value < v-diasize-orig-frame-height
     1227       then do:
     1228         assign
     1229           p-change-value = v-diasize-orig-frame-height
     1230                          - (frame f-c-p :height-chars)
     1231         .
     1232         if p-change-value >= 0
     1233         then do:
     1234           run diasize_position-resize-button in this-procedure .
     1235           return .
     1236         end.
     1237       end.
     1238     end.
     1239     if p-change-value >= 0
     1240     then do:
     1241       assign
     1242         v-change-sign = 1
     1243       .
     1244     end.
     1245     else do:
     1246       assign
     1247         v-change-sign = -1
     1248       .
     1249     end.
     1250     assign
     1251       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1252     .
     1253     if p-change-value = 0
     1254     then do:
     1255       run diasize_position-resize-button in this-procedure .
     1256       return .
     1257     end.
     1258     move_block:
     1259     do
     1260     on error undo move_block, retry move_block
     1261     :
     1262       if retry
     1263       then do:
     1264         do
     1265         on error undo move_block, leave move_block
     1266         :
     1267           if p-change-value > 0
     1268           then do:
     1269             for each buf_temp-diasize-handle
     1270             on error undo, next
     1271             :
     1272               assign
     1273                 v-object-handle = buf_temp-diasize-handle.handle-value
     1274               .
     1275               if v-object-handle <> v-diasize-resize-button
     1276               then do:
     1277                 assign
     1278                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1279                 .
     1280               end.
     1281             end.
     1282             assign
     1283               v-diasize-browse-handle :height = v-browse-height
     1284             .
     1285             for each buf_temp-browse-handle
     1286               where buf_temp-browse-handle.browse-type = 'height':u
     1287             on error undo, next
     1288             :
     1289               assign
     1290                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1291               .
     1292             end.
     1293             assign
     1294               frame f-c-p :height = v-frame-height
     1295             .
     1296             if frame f-c-p :scrollable = true
     1297             then do:
     1298               assign
     1299                 frame f-c-p :virtual-height = v-frame-virtual-height
     1300               .
     1301             end.
     1302             run diasize_position-resize-button in this-procedure .
     1303           end.
     1304           else do:
     1305             if frame f-c-p :scrollable = true
     1306             then do:
     1307               assign
     1308                 frame f-c-p :virtual-height = v-frame-virtual-height
     1309               .
     1310             end.
     1311             assign
     1312               frame f-c-p :height = v-frame-height
     1313             .
     1314             assign
     1315               v-diasize-browse-handle :height = v-browse-height
     1316             .
     1317             for each buf_temp-browse-handle
     1318               where buf_temp-browse-handle.browse-type = 'height':u
     1319             on error undo, next
     1320             :
     1321               assign
     1322                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1323               .
     1324             end.
     1325             for each buf_temp-diasize-handle
     1326             on error undo, next
     1327             :
     1328               assign
     1329                 v-object-handle = buf_temp-diasize-handle.handle-value
     1330               .
     1331               if v-object-handle <> v-diasize-resize-button
     1332               then do:
     1333                 assign
     1334                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1335                 .
     1336               end.
     1337             end.
     1338             run diasize_position-resize-button in this-procedure .
     1339           end.
     1340           assign
     1341             v-diasize-change-size = false
     1342           .
     1343           leave move_block .
     1344         end.
     1345       end.
     1346       assign
     1347         v-diasize-need-full-display = true
     1348       .
     1349       if v-diasize-change-size = false
     1350       then do:
     1351         assign
     1352           v-diasize-change-size = true
     1353         .
     1354       end.
     1355       else do:
     1356         return .
     1357       end.
     1358       assign
     1359         v-frame-height = frame f-c-p :height
     1360         v-frame-virtual-height = frame f-c-p :virtual-height
     1361         v-browse-height = v-diasize-browse-handle :height
     1362       .
     1363       for each buf_temp-browse-handle
     1364         where buf_temp-browse-handle.browse-type = 'height':u
     1365       :
     1366         assign
     1367           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1368         .
     1369       end.
     1370       for each buf_temp-diasize-handle
     1371       :
     1372         delete buf_temp-diasize-handle .
     1373       end.
     1374       assign
     1375         v-field-group-handle = frame f-c-p :first-child
     1376       .
     1377       do while valid-handle(v-field-group-handle)
     1378       :
     1379         assign
     1380           v-object-handle = v-field-group-handle :first-child
     1381         .
     1382         do while valid-handle(v-object-handle)
     1383         :
     1384           if  v-object-handle <> v-diasize-browse-handle :handle
     1385           and can-query(v-object-handle, "row")
     1386           and can-query(v-object-handle, "height")
     1387           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1388           then do:
     1389             find first buf_temp-browse-handle
     1390               where buf_temp-browse-handle.browse-type   = 'height':u
     1391                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1392               no-error .
     1393             if available buf_temp-browse-handle
     1394             then do:
     1395             end.
     1396             else do:
     1397               create buf_temp-diasize-handle .
     1398               assign
     1399                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1400                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1401               .
     1402             end.
     1403           end.
     1404           assign
     1405             v-object-handle = v-object-handle :next-sibling
     1406           .
     1407         end.
     1408         assign
     1409           v-field-group-handle = v-field-group-handle :next-sibling
     1410         .
     1411       end.
     1412       do with frame f-c-p
     1413       :
     1414         hide v-diasize-resize-button .
     1415         assign
     1416           v-diasize-resize-button :row    = 1
     1417           v-diasize-resize-button :column = 1
     1418         .
     1419       end.
     1420       if p-change-value > 0
     1421       then do:
     1422         if frame f-c-p :scrollable = true
     1423         then do:
     1424           assign
     1425             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1426             no-error .
     1427           if error-status :error
     1428           or error-status :get-message(1) <> ""
     1429           then do:
     1430             undo move_block, retry move_block .
     1431           end.
     1432         end.
     1433         assign
     1434           frame f-c-p :height = frame f-c-p :height + p-change-value
     1435           no-error .
     1436         if error-status :error
     1437         or error-status :get-message(1) <> ""
     1438         then do:
     1439           undo move_block, retry move_block .
     1440         end.
     1441         assign
     1442           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1443           no-error .
     1444         if error-status :error
     1445         or error-status :get-message(1) <> ""
     1446         then do:
     1447           undo move_block, retry move_block .
     1448         end.
     1449         for each buf_temp-browse-handle
     1450           where buf_temp-browse-handle.browse-type = 'height':u
     1451         on error undo move_block, retry move_block
     1452         :
     1453           assign
     1454             buf_temp-browse-handle.browse-handle :height
     1455               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1456             no-error .
     1457           if error-status :error
     1458           or error-status :get-message(1) <> ""
     1459           then do:
     1460             undo move_block, retry move_block .
     1461           end.
     1462         end.
     1463         for each buf_temp-diasize-handle
     1464         on error undo move_block, retry move_block
     1465         :
     1466           assign
     1467             v-object-handle = buf_temp-diasize-handle.handle-value
     1468           .
     1469           if v-object-handle <> v-diasize-resize-button
     1470           then do:
     1471             assign
     1472               v-object-handle :row = v-object-handle :row + p-change-value
     1473               no-error .
     1474             if error-status :error
     1475             or error-status :get-message(1) <> ""
     1476             then do:
     1477               undo move_block, retry move_block .
     1478             end.
     1479           end.
     1480         end.
     1481       end.
     1482       else do:
     1483         for each buf_temp-diasize-handle
     1484         on error undo move_block, retry move_block
     1485         :
     1486           assign
     1487             v-object-handle = buf_temp-diasize-handle.handle-value
     1488           .
     1489           if v-object-handle <> v-diasize-resize-button
     1490           then do:
     1491             assign
     1492               v-object-handle :row = v-object-handle :row + p-change-value
     1493               no-error .
     1494             if error-status :error
     1495             or error-status :get-message(1) <> ""
     1496             then do:
     1497               undo move_block, retry move_block .
     1498             end.
     1499           end.
     1500         end.
     1501         assign
     1502           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1503           no-error .
     1504         if error-status :error
     1505         or error-status :get-message(1) <> ""
     1506         then do:
     1507           undo move_block, retry move_block .
     1508         end.
     1509         for each buf_temp-browse-handle
     1510           where buf_temp-browse-handle.browse-type = 'height':u
     1511         on error undo move_block, retry move_block
     1512         :
     1513           assign
     1514             buf_temp-browse-handle.browse-handle :height
     1515               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1516             no-error .
     1517           if error-status :error
     1518           or error-status :get-message(1) <> ""
     1519           then do:
     1520             undo move_block, retry move_block .
     1521           end.
     1522         end.
     1523         assign
     1524           frame f-c-p :height = frame f-c-p :height + p-change-value
     1525           no-error .
     1526         if error-status :error
     1527         or error-status :get-message(1) <> ""
     1528         then do:
     1529           undo move_block, retry move_block .
     1530         end.
     1531         if frame f-c-p :scrollable = true
     1532         then do:
     1533           assign
     1534             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1535             no-error .
     1536           if error-status :error
     1537           or error-status :get-message(1) <> ""
     1538           then do:
     1539             undo move_block, retry move_block .
     1540           end.
     1541         end.
     1542       end.
     1543       if p-move-resize = true
     1544       then do:
     1545         run diasize_position-resize-button in this-procedure .
     1546       end.
     1547       if v-diasize-wndstore = true
     1548       then do:
     1549         if connected("ub") = true
     1550         then do:
     1551           define variable v-cntxt-db-num        as integer   no-undo .
     1552           define variable v-cntxt-userid        as character no-undo .
     1553           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1554                                             , OUTPUT v-cntxt-userid
     1555                                             ) .
     1556           run gbl/wndsizew.p
     1557             (input  v-cntxt-db-num
     1558             ,input  v-cntxt-userid
     1559             ,input  v-diasize-proc-name
     1560             ,input  'height':u
     1561             ,input  string(frame f-c-p :height - v-diasize-orig-frame-height)
     1562             ) .
     1563         end.
     1564       end.
     1565     end.
     1566     assign
     1567       v-diasize-change-size = false
     1568     .
     1569   end procedure.
     1570   procedure diasize_set-height :
     1571     define input  parameter p-new-height  as decimal   no-undo .
     1572     define input  parameter p-move-resize as logical   no-undo .
     1573     do
     1574     on error undo, return error return-value
     1575     :
     1576       run diasize_change-height in this-procedure
     1577         (input  (p-new-height - frame f-c-p :height)
     1578         ,input  p-move-resize
     1579         ) .
     1580     end.
     1581   end procedure.
     1582   procedure diasize_change-width :
     1583     define input  parameter p-change-value as decimal   no-undo .
     1584     define input  parameter p-move-resize  as logical   no-undo .
     1585     define variable v-field-group-handle   as handle    no-undo .
     1586     define variable v-object-handle        as handle    no-undo .
     1587     define variable v-frame-width          as decimal   no-undo .
     1588     define variable v-frame-virtual-width  as decimal   no-undo .
     1589     define variable v-browse-width         as decimal   no-undo .
     1590     define variable v-window-width         as decimal   no-undo .
     1591     define variable v-window-virtual-width as decimal   no-undo .
     1592     define variable v-change-sign          as integer   no-undo .
     1593     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1594     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1595     if p-change-value > 0
     1596     then do:
     1597       if frame f-c-p :width + p-change-value >
     1598           session :width-chars
     1599       then do:
     1600         assign
     1601           p-change-value = session :width-chars - frame f-c-p :width
     1602         .
     1603         if p-change-value <= 0
     1604         then do:
     1605           run diasize_position-resize-button in this-procedure .
     1606           return .
     1607         end.
     1608       end.
     1609     end.
     1610     if p-change-value < 0
     1611     then do:
     1612       if frame f-c-p :width + p-change-value < v-diasize-orig-frame-width
     1613       then do:
     1614         assign
     1615           p-change-value = v-diasize-orig-frame-width
     1616                          - frame f-c-p :width
     1617         .
     1618         if p-change-value >= 0
     1619         then do:
     1620           run diasize_position-resize-button in this-procedure .
     1621           return .
     1622         end.
     1623       end.
     1624     end.
     1625     if p-change-value >= 0
     1626     then do:
     1627       assign
     1628         v-change-sign = 1
     1629       .
     1630     end.
     1631     else do:
     1632       assign
     1633         v-change-sign = -1
     1634       .
     1635     end.
     1636     assign
     1637       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1638     .
     1639     if p-change-value = 0
     1640     then do:
     1641       run diasize_position-resize-button in this-procedure .
     1642       return .
     1643     end.
     1644     move_block:
     1645     do
     1646     on error undo move_block, leave move_block
     1647     :
     1648       if retry
     1649       then do:
     1650         do
     1651         on error undo move_block, leave move_block
     1652         :
     1653           if p-change-value > 0
     1654           then do:
     1655             for each buf_temp-diasize-handle
     1656             on error undo, next
     1657             :
     1658               assign
     1659                 v-object-handle = buf_temp-diasize-handle.handle-value
     1660               .
     1661               if v-object-handle <> v-diasize-resize-button
     1662               then do:
     1663                 assign
     1664                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1665                 .
     1666               end.
     1667             end.
     1668             assign
     1669               v-diasize-browse-handle :width = v-browse-width
     1670             .
     1671             for each buf_temp-browse-handle
     1672               where buf_temp-browse-handle.browse-type = 'width':u
     1673             on error undo, next
     1674             :
     1675               assign
     1676                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1677               .
     1678             end.
     1679             assign
     1680               frame f-c-p :width = v-frame-width
     1681             .
     1682             if frame f-c-p :scrollable = true
     1683             then do:
     1684               assign
     1685                 frame f-c-p :virtual-width = v-frame-virtual-width
     1686               .
     1687             end.
     1688             run diasize_position-resize-button in this-procedure .
     1689           end.
     1690           else do:
     1691             if frame f-c-p :scrollable = true
     1692             then do:
     1693               assign
     1694                 frame f-c-p :virtual-width = v-frame-virtual-width
     1695               .
     1696             end.
     1697             assign
     1698               frame f-c-p :width = v-frame-width
     1699             .
     1700             for each buf_temp-browse-handle
     1701               where buf_temp-browse-handle.browse-type = 'width':u
     1702             on error undo, next
     1703             :
     1704               assign
     1705                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1706               .
     1707             end.
     1708             assign
     1709               v-diasize-browse-handle :width = v-browse-width
     1710             .
     1711             for each buf_temp-diasize-handle
     1712             on error undo, next
     1713             :
     1714               assign
     1715                 v-object-handle = buf_temp-diasize-handle.handle-value
     1716               .
     1717               if v-object-handle <> v-diasize-resize-button
     1718               then do:
     1719                 assign
     1720                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1721                 .
     1722               end.
     1723             end.
     1724             run diasize_position-resize-button in this-procedure .
     1725           end.
     1726           assign
     1727             v-diasize-change-size = false
     1728           .
     1729           leave move_block .
     1730         end.
     1731       end.
     1732       assign
     1733         v-diasize-need-full-display = true
     1734       .
     1735       if v-diasize-change-size = false
     1736       then do:
     1737         assign
     1738           v-diasize-change-size = true
     1739         .
     1740       end.
     1741       else do:
     1742         return .
     1743       end.
     1744       assign
     1745         v-frame-width = frame f-c-p :width
     1746         v-frame-virtual-width = frame f-c-p :virtual-width
     1747         v-browse-width = v-diasize-browse-handle :width
     1748       .
     1749       for each buf_temp-browse-handle
     1750         where buf_temp-browse-handle.browse-type = 'width':u
     1751       :
     1752         assign
     1753           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1754         .
     1755       end.
     1756       for each buf_temp-diasize-handle
     1757       :
     1758         delete buf_temp-diasize-handle .
     1759       end.
     1760       assign
     1761         v-field-group-handle = frame f-c-p :first-child
     1762       .
     1763       do while valid-handle(v-field-group-handle)
     1764       :
     1765         assign
     1766           v-object-handle = v-field-group-handle :first-child
     1767         .
     1768         do while valid-handle(v-object-handle)
     1769         :
     1770           if  v-object-handle <> v-diasize-browse-handle :handle
     1771           and v-object-handle <> v-diasize-resize-button
     1772           and can-query(v-object-handle, "row")
     1773           and can-query(v-object-handle, "height")
     1774           and ( v-object-handle :col + v-object-handle :width
     1775                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1776               )
     1777           then do:
     1778             find first buf_temp-browse-handle
     1779               where buf_temp-browse-handle.browse-type   = 'width':u
     1780                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1781               no-error .
     1782             if available buf_temp-browse-handle
     1783             then do:
     1784             end.
     1785             else do:
     1786               create buf_temp-diasize-handle .
     1787               assign
     1788                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1789                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1790               .
     1791             end.
     1792           end.
     1793           assign
     1794             v-object-handle = v-object-handle :next-sibling
     1795           .
     1796         end.
     1797         assign
     1798           v-field-group-handle = v-field-group-handle :next-sibling
     1799         .
     1800       end.
     1801       do with frame f-c-p
     1802       :
     1803         hide v-diasize-resize-button .
     1804         v-diasize-resize-button :row = 1.
     1805         v-diasize-resize-button :column = 1.
     1806       end.
     1807       if p-change-value > 0
     1808       then do:
     1809         if frame f-c-p :scrollable = true
     1810         then do:
     1811           assign
     1812             frame f-c-p :virtual-width = frame f-c-p :virtual-width + p-change-value
     1813             no-error .
     1814           if error-status :error
     1815           or error-status :get-message(1) <> ""
     1816           then do:
     1817             undo move_block, retry move_block.
     1818           end.
     1819         end.
     1820         assign
     1821           frame f-c-p :width = v-frame-width + p-change-value
     1822           no-error .
     1823         if error-status :error
     1824         or error-status :get-message(1) <> ""
     1825         then do:
     1826           undo move_block, retry move_block.
     1827         end.
     1828         assign
     1829           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1830         no-error .
     1831         if error-status :error
     1832         or error-status :get-message(1) <> ""
     1833         then do:
     1834           undo move_block, retry move_block.
     1835         end.
     1836         for each buf_temp-browse-handle
     1837           where buf_temp-browse-handle.browse-type = 'width':u
     1838         on error undo move_block, retry move_block
     1839         :
     1840           assign
     1841             buf_temp-browse-handle.browse-handle :width
     1842               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1843             no-error .
     1844           if error-status :error
     1845           or error-status :get-message(1) <> ""
     1846           then do:
     1847             undo move_block, retry move_block .
     1848           end.
     1849         end.
     1850         for each buf_temp-diasize-handle
     1851         on error undo move_block, retry move_block
     1852         :
     1853           assign
     1854             v-object-handle = buf_temp-diasize-handle.handle-value
     1855           .
     1856           if v-object-handle <> v-diasize-resize-button
     1857           then do:
     1858             assign
     1859               v-object-handle :col = v-object-handle :col + p-change-value
     1860               no-error .
     1861             if error-status :error
     1862             or error-status :get-message(1) <> ""
     1863             then do:
     1864               undo move_block, retry move_block .
     1865             end.
     1866           end.
     1867         end.
     1868       end.
     1869       else do:
     1870         for each buf_temp-diasize-handle
     1871         on error undo move_block, retry move_block
     1872         :
     1873           assign
     1874             v-object-handle = buf_temp-diasize-handle.handle-value
     1875           .
     1876           if v-object-handle <> v-diasize-resize-button
     1877           then do:
     1878             assign
     1879               v-object-handle :col = v-object-handle :col + p-change-value
     1880               no-error .
     1881             if error-status :error
     1882             or error-status :get-message(1) <> ""
     1883             then do:
     1884               undo move_block, retry move_block .
     1885             end.
     1886           end.
     1887         end.
     1888         for each buf_temp-browse-handle
     1889           where buf_temp-browse-handle.browse-type = 'width':u
     1890         on error undo move_block, retry move_block
     1891         :
     1892           assign
     1893             buf_temp-browse-handle.browse-handle :width
     1894               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1895             no-error .
     1896           if error-status :error
     1897           or error-status :get-message(1) <> ""
     1898           then do:
     1899             undo move_block, retry move_block .
     1900           end.
     1901         end.
     1902         assign
     1903           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1904           no-error .
     1905         if error-status :error
     1906         or error-status :get-message(1) <> ""
     1907         then do:
     1908           undo move_block, retry move_block.
     1909         end.
     1910         assign
     1911           frame f-c-p :width = frame f-c-p :width + p-change-value
     1912         no-error .
     1913         if error-status :error
     1914         or error-status :get-message(1) <> ""
     1915         then do:
     1916           undo move_block, retry move_block.
     1917         end.
     1918         if frame f-c-p :scrollable = true
     1919         then do:
     1920           assign
     1921             frame f-c-p :virtual-width = frame f-c-p :virtual-width + p-change-value
     1922           no-error .
     1923           if error-status :error
     1924           or error-status :get-message(1) <> ""
     1925           then do:
     1926             undo move_block, retry move_block.
     1927           end.
     1928         end.
     1929       end.
     1930       if p-move-resize
     1931       then do:
     1932         run diasize_position-resize-button in this-procedure .
     1933       end.
     1934       if v-diasize-wndstore = true
     1935       then do:
     1936         if connected("ub") = true
     1937         then do:
     1938           define variable v-cntxt-db-num        as integer   no-undo .
     1939           define variable v-cntxt-userid        as character no-undo .
     1940           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1941                                             , OUTPUT v-cntxt-userid
     1942                                             ) .
     1943           run gbl/wndsizew.p
     1944             (input  v-cntxt-db-num
     1945             ,input  v-cntxt-userid
     1946             ,input  v-diasize-proc-name
     1947             ,input  'width':u
     1948             ,input  string(frame f-c-p :width - v-diasize-orig-frame-width)
     1949             ) .
     1950         end.
     1951       end.
     1952     end.
     1953     assign
     1954       v-diasize-change-size = false
     1955     .
     1956   end procedure.
     1957   procedure diasize_set-width :
     1958     define input  parameter p-new-width  as decimal   no-undo .
     1959     define input  parameter p-move-resize as logical   no-undo .
     1960     do
     1961     on error undo, return error return-value
     1962     :
     1963       run diasize_change-width in this-procedure
     1964         (input  (p-new-width - frame f-c-p :width)
     1965         ,input  p-move-resize
     1966         ) .
     1967     end.
     1968   end procedure.
     1969   procedure diasize_position-resize-button :
     1970     do with frame f-c-p
     1971     :
     1972       hide v-diasize-resize-button .
     1973       assign
     1974         v-diasize-resize-button :row = frame f-c-p :height - v-diasize-resize-button :height
     1975                     - 1
     1976                     - (frame f-c-p :border-bottom-pixels / session :pixels-per-row)
     1977         v-diasize-resize-button :col = frame f-c-p :width - v-diasize-resize-button :width
     1978                     - 1
     1979                     - (frame f-c-p :border-right-pixels / session :pixels-per-column)
     1980       .
     1981       view v-diasize-resize-button .
     1982     end.
     1983   end procedure.
     1984   on alt-right anywhere
     1985   do:
     1986     run diasize_change-width in this-procedure
     1987       (input 1
     1988       ,input true
     1989       ) .
     1990     return no-apply .
     1991   end.
     1992   on alt-left anywhere
     1993   do:
     1994     run diasize_change-width in this-procedure
     1995       (input -1
     1996       ,input true
     1997       ) .
     1998     return no-apply .
     1999   end.
     2000   on alt-down anywhere
     2001   do:
     2002     run diasize_change-height in this-procedure
     2003       (input 1
     2004       ,input true
     2005       ) .
     2006     return no-apply .
     2007   end.
     2008   on alt-up anywhere
     2009   do:
     2010     run diasize_change-height in this-procedure
     2011       (input -1
     2012       ,input true
     2013       ) .
     2014     return no-apply .
     2015   end.
     2016   on alt-enter of frame f-c-p
     2017   do:
     2018     run diasize_maximize in this-procedure
     2019       (input  ?
     2020       ).
     2021     return no-apply .
     2022   end.
     2023   procedure diasize_end-move :
     2024     do
     2025     on error undo, return error return-value
     2026     :
     2027       define variable v-row-delta as decimal   no-undo .
     2028       define variable v-col-delta as decimal   no-undo .
     2029       define variable v-new-row as decimal   no-undo .
     2030       define variable v-new-col as decimal   no-undo .
     2031       assign
     2032         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2033         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2034       .
     2035       assign
     2036         v-row-delta = v-new-row - frame f-c-p :height
     2037         v-col-delta = v-new-col - frame f-c-p :width
     2038       .
     2039       run diasize_change-height in this-procedure
     2040         (input v-row-delta
     2041         ,input true
     2042         ) .
     2043       run diasize_change-width in this-procedure
     2044         (input v-col-delta
     2045         ,input true
     2046         ) .
     2047     end.
     2048   end procedure.
     2049   procedure diasize_maximize :
     2050     define input  parameter p-action as logical   no-undo .
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054       if p-action = ?
     2055       then do:
     2056         if v-diasize-need-maximize = true
     2057         then do:
     2058           assign
     2059             p-action = true
     2060           .
     2061         end.
     2062         else do:
     2063           assign
     2064             p-action = false
     2065           .
     2066         end.
     2067       end.
     2068       if p-action = true
     2069       then do:
     2070         run diasize_change-height in this-procedure
     2071           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2072               - frame f-c-p :height-chars
     2073           ,input true
     2074           ) .
     2075         run diasize_change-width in this-procedure
     2076           (input session :width-chars
     2077               - frame f-c-p :width-chars
     2078           ,input true
     2079           ) .
     2080         assign
     2081           v-diasize-need-maximize = false
     2082         .
     2083       end.
     2084       else do:
     2085         run diasize_change-width in this-procedure
     2086           (input v-diasize-orig-frame-width
     2087               - frame f-c-p :width-chars
     2088           ,input true
     2089           ) .
     2090         run diasize_change-height in this-procedure
     2091           (input v-diasize-orig-frame-height
     2092               - frame f-c-p :height-chars
     2093           ,input true
     2094           ) .
     2095         assign
     2096           v-diasize-need-maximize = true
     2097         .
     2098       end.
     2099     end.
     2100   end procedure.
     2101   procedure diasize_restore-orig-size :
     2102     do
     2103     on error undo, return error return-value
     2104     :
     2105       assign
     2106         v-diasize-current-frame-width  = frame f-c-p :width
     2107         v-diasize-current-frame-height = frame f-c-p :height
     2108       .
     2109       run diasize_set-height in this-procedure
     2110         (input  v-diasize-orig-frame-height
     2111         ,input  true
     2112         ) .
     2113       run diasize_set-width in this-procedure
     2114         (input  v-diasize-orig-frame-width
     2115         ,input  true
     2116         ) .
     2117     end.
     2118   end procedure.
     2119   procedure diasize_restore-current-size :
     2120     do
     2121     on error undo, return error return-value
     2122     :
     2123       run diasize_set-height in this-procedure
     2124         (input  v-diasize-current-frame-height
     2125         ,input  true
     2126         ) .
     2127       run diasize_set-width in this-procedure
     2128         (input  v-diasize-current-frame-width
     2129         ,input  true
     2130         ) .
     2131     end.
     2132   end procedure.
     2133   procedure diasize_set-browse-handle :
     2134     define input  parameter p-browse-handle as handle   no-undo .
     2135     define buffer buf_temp-browse-handle for temp-browse-handle .
     2136     do
     2137     on error undo, return error return-value
     2138     :
     2139       assign
     2140         v-diasize-browse-handle = p-browse-handle
     2141       .
     2142       for each buf_temp-browse-handle
     2143       on error undo, return error return-value
     2144       :
     2145         delete buf_temp-browse-handle .
     2146       end.
     2147     end.
     2148   end procedure.
     2149   procedure diasize_add_browse :
     2150     define input  parameter p-browse-type   as character no-undo .
     2151     define input  parameter p-browse-handle as handle    no-undo .
     2152     define buffer buf_temp-browse-handle for temp-browse-handle .
     2153     do
     2154     on error undo, return error return-value
     2155     :
     2156       assign
     2157         v-diasize-browse-number = v-diasize-browse-number + 1
     2158       .
     2159       create buf_temp-browse-handle .
     2160       assign
     2161         buf_temp-browse-handle.browse-type   = p-browse-type
     2162         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2163         buf_temp-browse-handle.browse-handle = p-browse-handle
     2164       .
     2165     end.
     2166   end procedure.
     2167   procedure diasize_init :
     2168     define variable v-default-value    as logical   no-undo .
     2169     define variable v-restore-saved    as logical   no-undo .
     2170     define variable v-resize-value-str as character no-undo .
     2171     do
     2172     on error undo, return error return-value
     2173     :
     2174       do with frame f-c-p
     2175       :
     2176         assign
     2177           v-diasize-orig-frame-height = frame f-c-p :height
     2178           v-diasize-orig-frame-width  = frame f-c-p :width
     2179           v-diasize-browse-handle     = browse BROWSE-Code :handle
     2180         .
     2181         create button v-diasize-resize-button
     2182         assign
     2183           parent        = frame f-c-p :first-child
     2184           label         = "s"
     2185           height-pixels = 16
     2186           width-pixels  = 16
     2187           visible       = true
     2188           sensitive     = true
     2189           movable       = true
     2190           triggers:
     2191             on end-move persistent run diasize_end-move in this-procedure .
     2192           end triggers.
     2193         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2194         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2195         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2196         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2197         assign
     2198           v-diasize-wndmax = false
     2199         .
     2200         if connected("ub") = true
     2201         then do:
     2202           define variable v-cntxt-db-num        as integer   no-undo .
     2203           define variable v-cntxt-userid        as character no-undo .
     2204           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2205                                             , OUTPUT v-cntxt-userid
     2206                                             ) .
     2207           run gbl/wndpar_r.p
     2208             (input  v-cntxt-db-num
     2209             ,input  v-cntxt-userid
     2210             ,input  'wndmax':U
     2211             ,output v-diasize-wndmax
     2212             ,output v-default-value
     2213             ) .
     2214         end.
     2215         assign
     2216           v-diasize-wndstore = false
     2217         .
     2218         if connected("ub") = true
     2219         then do:
     2220           run gbl/wndpar_r.p
     2221             (input  v-cntxt-db-num
     2222             ,input  v-cntxt-userid
     2223             ,input  'wndstore':U
     2224             ,output v-diasize-wndstore
     2225             ,output v-default-value
     2226             ) .
     2227         end.
     2228         assign
     2229           v-diasize-proc-name = entry(1, program-name(2), '.')
     2230         .
     2231         if v-diasize-wndstore = true
     2232         then do:
     2233           assign
     2234             v-restore-saved = false
     2235           .
     2236           if connected("ub") = true
     2237           then do:
     2238             run gbl/wndsizer.p
     2239               (input  v-cntxt-db-num
     2240               ,input  v-cntxt-userid
     2241               ,input  v-diasize-proc-name
     2242               ,input  'height':u
     2243               ,output v-resize-value-str
     2244               ) .
     2245             if v-resize-value-str <> '':U
     2246             then do:
     2247               run diasize_change-height in this-procedure
     2248                 (input  integer(v-resize-value-str)
     2249                 ,input  true
     2250                 ) .
     2251               assign
     2252                 v-restore-saved = true
     2253               .
     2254             end.
     2255           end.
     2256           if connected("ub") = true
     2257           then do:
     2258             run gbl/wndsizer.p
     2259               (input  v-cntxt-db-num
     2260               ,input  v-cntxt-userid
     2261               ,input  v-diasize-proc-name
     2262               ,input  'width':u
     2263               ,output v-resize-value-str
     2264               ) .
     2265             if v-resize-value-str <> '':U
     2266             then do:
     2267               run diasize_change-width in this-procedure
     2268                 (input  integer(v-resize-value-str)
     2269                 ,input  true
     2270                 ) .
     2271               assign
     2272                 v-restore-saved = true
     2273               .
     2274             end.
     2275           end.
     2276           if v-restore-saved <> true
     2277           then do:
     2278             if v-diasize-wndmax = true
     2279             then do:
     2280               run diasize_maximize in this-procedure
     2281                 (input  true
     2282                 ) .
     2283             end.
     2284           end.
     2285         end.
     2286         else do:
     2287           if v-diasize-wndmax = true
     2288           then do:
     2289             run diasize_maximize in this-procedure
     2290               (input  true
     2291               ) .
     2292           end.
     2293         end.
     2294       end.
     2295     end.
     2296   end procedure.
     2297   procedure diasize_need-full-display :
     2298     define output parameter p-need-full-display as logical   no-undo .
     2299     do
     2300     on error undo, return error return-value
     2301     :
     2302       assign
     2303         p-need-full-display = v-diasize-need-full-display
     2304       .
     2305       assign
     2306         v-diasize-need-full-display = false
     2307       .
     2308     end.
     2309   end procedure.
     2310   procedure get-context :
     2311      define output parameter p-db-num as integer          no-undo.
     2312      define output parameter p-user-id as character        no-undo.
     2313      define variable v-login               as character    no-undo.
     2314      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2315      define buffer buf_user-login  for ub.user-login .
     2316      do
     2317      on error undo, return error
     2318      :
     2319            FIND FIRST buf_sys-ctrl no-lock.
     2320            ASSIGN
     2321               v-login = USERID("ub")
     2322               p-db-num = buf_sys-ctrl.db-num
     2323            .
     2324            FIND FIRST buf_user-login
     2325                 WHERE buf_user-login.db-num = p-db-num
     2326                   AND buf_user-login.user-login = v-login
     2327                 no-lock
     2328                 no-error
     2329                 .
     2330            IF AVAILABLE buf_user-login
     2331            THEN DO:
     2332               assign
     2333                  p-user-id = buf_user-login.user-id
     2334               .
     2335            END.
     2336      end.
     2337   end procedure.
     2338       run diasize_init in this-procedure .
     2339   on window-close of frame f-c-p
     2340     apply "END-ERROR":U to self.
     2341   MAIN-BLOCK:
     2342   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2343     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2344     if imode eq 'ВЫБОР':U
     2345     then
     2346        run rid-rest no-error.
     2347   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2348     run mainmenu_getcntxt in parparentproc
     2349       (output v-cntxt-db-num
     2350       ,output v-cntxt-userid
     2351       ,output v-cntxt-level
     2352       ,output v-cntxt-host-code-obj
     2353       ,output v-cntxt-obj-type
     2354       ,output v-cntxt-obj-code
     2355       ,output v-cntxt-db-num-obj
     2356       ,output v-cntxt-is-admin
     2357       ) .
     2358   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2360     (output v-db-num
     2361     )  .
     2362     run enable_UI in this-procedure .
     2363     wait-for go of frame f-c-p focus BROWSE-Code.
     2364     if imode eq 'ВЫБОР':U
     2365     then
     2366        run rid-keep no-error.
     2367   end.
     2368   run disable_UI in this-procedure .
     2369   PROCEDURE disable_UI :
     2370     HIDE FRAME f-c-p.
     2371   END PROCEDURE.
     2372   PROCEDURE enable_UI :
     2373     enable
     2374       mSearch
     2375       BROWSE-Code
     2376       b-exit
     2377       b-chiled
     2378       b-hist
     2379       b-sel
     2380       when iMode eq 'ВЫБОР':U
     2381       b-add
     2382       when iMode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2383       b-del
     2384       when iMode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2385       b-upd
     2386       when iMode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2387       b-help
     2388       with frame f-c-p.
     2389   b-hist:POPUP-MENU in frame f-c-p = menu POPUP-MENU-b-hist:HANDLE.
     2390   fselect                :visible in browse BROWSE-Code = imode eq 'ВЫБОР':U.
     2391      b-hist:MENU-MOUSE = 1.
     2392     OPEN QUERY BROWSE-Code FOR EACH code       where code.parent = iparent + chr(4) + icode NO-LOCK INDEXED-REPOSITION.
     2393   end procedure.
