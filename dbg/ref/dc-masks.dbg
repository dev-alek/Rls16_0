     2992   PROCEDURE OpenBr :
     2993   define input  parameter p-open-query     as logical   no-undo .
     2994   define input  parameter p-find-next      as logical   no-undo .
     2995   define input  parameter p-find-condition as character no-undo .
     2996   define variable l-query-was-opened as logical no-undo .
     2997   define variable title0 as character no-undo.
     2998   title0 = "Маски дисконтных карт" + chr(32).
     2999   run waitfram-show in this-procedure ("Ждите...").
     3000   define variable sort-column-phrase as character no-undo .
     3001   case sort-column-name :
     3002     when "" then do:
     3003       assign
     3004         sort-column-phrase = ""
     3005       .
     3006     end.
     3007     otherwise do:
     3008       assign
     3009         sort-column-phrase = "by " + sort-column-name
     3010       .
     3011     end.
     3012   end case.
     3013   define variable l-open-query as logical   no-undo .
     3014     CASE p-ref-mode :
     3015       WHEN 'все':U        THEN DO:
     3016        assign
     3017        frame Dialog-Frame:title = title0
     3018        filter-point = filter-point0 + p-ref-mode
     3019        filter-label = substitute("&1", filter-label0)
     3020        .
     3021        IF p-stts = ?  THEN DO:
     3022   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3023   define variable  l-disable-where-33  as logical   no-undo .
     3024   define variable  l-filter-open-33    as logical   .
     3025   define variable  flt-rec-33       as recid     no-undo .
     3026   define variable  filter-name-33      as character no-undo .
     3027   define variable  where-phrase-33     as character no-undo .
     3028   define variable  sort-phrase-33      as character no-undo .
     3029   define variable  where-phrase-rus-33 as character no-undo .
     3030   define variable  sort-phrase-rus-33  as character no-undo .
     3031     run waitfram-show in this-procedure
     3032       (input "ЖДИТЕ ..."
     3033       ).
     3034   run gbl/flt-get.p
     3035     (input filter-point
     3036     ,output flt-rec-33
     3037     ,output filter-name-33
     3038     ,output where-phrase-33
     3039     ,output sort-phrase-33
     3040     ,output where-phrase-rus-33
     3041     ,output sort-phrase-rus-33
     3042     ).
     3043   if p-open-query then do:
     3044       run set-filter-name in this-procedure
     3045         (INPUT filter-name-33
     3046         ) no-error .
     3047     assign
     3048       l-filter-open-33 = false
     3049     .
     3050     if flt-rec-33 <> ?
     3051       or sort-column-phrase > ""
     3052     then do:
     3053       define variable  parameter-2-33 as character no-undo .
     3054       define variable  parameter-3-33 as character no-undo .
     3055       define variable  parameter-4-33 as character no-undo .
     3056       define variable  parameter-5-33 as character no-undo .
     3057       define variable  parameter-6-33 as character no-undo .
     3058       define variable  parameter-7-33 as character no-undo .
     3059         assign
     3060         parameter-3-33 =
     3061                                 "FOR EACH X_dis-card-mask"
     3062         parameter-4-33 =
     3063           (
     3064             if (" TRUE " + " " + where-phrase-33) <> ""
     3065             then " TRUE " + " " + where-phrase-33
     3066             else "true"
     3067           )
     3068         parameter-5-33 = (" " + "" + " " + "")
     3069         parameter-6-33 = if sort-phrase-33 = ''
     3070                              then
     3071           (
     3072           " " + "  " +
     3073             " " + sort-column-phrase +
     3074           " " + " by X_dis-card-mask.rank "
     3075           )
     3076                              else
     3077           (
     3078           " " + "  " +
     3079             " " + sort-column-phrase +
     3080           " " + sort-phrase-33
     3081           )
     3082         parameter-7-33 =
     3083           " indexed-reposition  "
     3084       .
     3085       do
     3086       on stop undo, leave
     3087       on error undo, leave
     3088       :
     3089         assign
     3090           l-disable-where-33 =
     3091             (" TRUE " + " " + where-phrase-33 = "")
     3092         .
     3093         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3094                             ,input QUERY br-masks:handle
     3095                             ,input parameter-3-33
     3096                             ,input parameter-4-33
     3097                             ,input parameter-5-33
     3098                             ,input parameter-6-33
     3099                             ,input parameter-7-33
     3100                             )
     3101         .
     3102         assign
     3103           l-filter-open-33 = true
     3104         .
     3105       end.
     3106       if l-filter-open-33 = false then do:
     3107         message
     3108           "Ошибка при фильтрации / сортировке" skip
     3109           "Будут показаны записи без учета фильтра" skip
     3110           view-as alert-box .
     3111       end.
     3112       else do:
     3113           assign
     3114             l-query-was-opened = true
     3115           .
     3116       end.
     3117     end.
     3118     if l-filter-open-33 = false then do:
     3119       OPEN QUERY br-masks FOR EACH X_dis-card-mask
     3120         where  TRUE
     3121          by X_dis-card-mask.rank
     3122         indexed-reposition
     3123     .
     3124         assign
     3125           l-query-was-opened = true
     3126         .
     3127     end.
     3128   end.
     3129   else do:
     3130     assign
     3131       v-doc-rec = recid( X_dis-card-mask )
     3132     .
     3133     do
     3134     on stop undo, leave
     3135     on error undo, leave
     3136     :
     3137       if QUERY br-masks:handle:get-buffer-handle(1) = (buffer X_dis-card-mask:handle) then do:
     3138         assign
     3139         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3140         parameter-4-33 =
     3141           "where ":u + " TRUE " + " ":u + where-phrase-33 + " ":u + p-find-condition + " " + ""
     3142         parameter-5-33 = "  "
     3143       .
     3144         run fltopend_fltfindd in this-procedure  (
     3145                             input this-procedure:handle
     3146                             ,input QUERY br-masks:handle
     3147                             ,input rowid(X_dis-card-mask)
     3148                             ,input logical(parameter-2-33)
     3149                             ,input no-lock
     3150                             ,input (buffer X_dis-card-mask:handle)
     3151                             ,input parameter-4-33
     3152                             ,input parameter-5-33
     3153                             ) no-error.
     3154         .
     3155         assign
     3156           v-doc-rec = integer(return-value)
     3157           v-fltopend-rowid[1] = ?
     3158         .
     3159       end.
     3160       else do:
     3161         assign
     3162         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3163         parameter-3-33 =  "FOR EACH X_dis-card-mask"
     3164         parameter-4-33 =
     3165           (
     3166             if (" TRUE " + " " + where-phrase-33) <> ""
     3167             then " TRUE " + " " + where-phrase-33
     3168             else "true"
     3169           )
     3170         parameter-5-33 = (" " + "" + " " + "" + " " + p-find-condition)
     3171         parameter-6-33 = if sort-phrase-33 = ''
     3172                              then
     3173           (
     3174           " " + "  " +
     3175             " " + sort-column-phrase +
     3176           " " + " by X_dis-card-mask.rank "
     3177           )
     3178                              else
     3179           (
     3180           " " + "  " +
     3181             " " + sort-column-phrase +
     3182           " " + sort-phrase-33
     3183           )
     3184         parameter-7-33 =
     3185           " indexed-reposition  "
     3186       .
     3187         run fltopend_fltfindq in this-procedure  (
     3188                             input this-procedure:handle
     3189                             ,input QUERY br-masks:handle
     3190                             ,input logical(parameter-2-33)
     3191                             ,input no-lock
     3192                             ,input parameter-3-33
     3193                             ,input parameter-4-33
     3194                             ,input parameter-5-33
     3195                             ,input parameter-6-33
     3196                             ,input parameter-7-33
     3197                             ,output v-fltopend-rowid
     3198                             ) no-error.
     3199         .
     3200         v-doc-rec = ?.
     3201       end.
     3202       assign
     3203         l-query-was-opened = true
     3204       .
     3205     end.
     3206   end.
     3207     run waitfram-hide in this-procedure .
     3208        END.
     3209        ELSE DO:
     3210             ASSIGN
     3211             frame Dialog-Frame:TITLE = title0 + chr(32) + entry (lookup (STRING(p-stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U).
     3212   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
