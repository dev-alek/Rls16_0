      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129     define variable v-cntxt-db-num        as integer   no-undo .
      130     define variable v-cntxt-userid        as character no-undo .
      131     define variable v-cntxt-level         as character no-undo .
      132     define variable v-cntxt-host-code-obj as integer   no-undo .
      133     define variable v-cntxt-obj-type      as character no-undo .
      134     define variable v-cntxt-obj-code      as integer   no-undo .
      135     define variable v-cntxt-db-num-obj    as integer   no-undo .
      136     define variable v-cntxt-is-admin      as logical   no-undo .
      137   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      139   define new shared variable RepPathName        as character no-undo .
      140   define new shared variable PrintRubl          as logical   no-undo .
      141   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   define variable v-waitfram-action01         as character   no-undo .
      143   define variable v-waitfram-action02         as character   no-undo .
      144   define variable v-waitfram-action03         as character   no-undo .
      145   define variable mWaitFramTextBeg            as character   no-undo.
      146   define variable mWaitFramTextEnd            as character   no-undo.
      147   define variable mWaitFramView               as logical     no-undo.
      148   define variable mWaitProcEvent              as logical     no-undo init yes.
      149   define variable mWaitFramInterval           as integer     no-undo init 1 .
      150   define variable mWaitFramStop               as logical     no-undo.
      151   define variable mWaitFramStopUser           as logical     no-undo.
      152   define variable mWaitFramStopTimeOut        as logical     no-undo.
      153   define variable mWaitFramStartProc          as datetime-tz no-undo.
      154   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      155   define button B-WaitFramStop auto-end-key
      156        label "Стоп"
      157        size 10 by 1 tooltip "Остоновить процесс".
      158   define button B-viewProcInfo
      159        label "Информация"
      160        size 15 by 1 tooltip "Информация о процесс".
      161   define frame waitfram
      162     v-waitfram-action01 format "x(72)" no-label skip
      163     v-waitfram-action02 format "x(72)" no-label skip
      164     v-waitfram-action03 format "x(72)" no-label skip
      165     B-viewProcInfo
      166     B-WaitFramStop at row 4 col 30
      167     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      168     .
      169   define new global shared variable mBatchMode as logical no-undo init ?.
      170   define variable mFramBachModHandle as handle no-undo.
      171   mFramBachModHandle = frame waitfram:handle.
      172   define variable mFameOldVis as logical no-undo.
      173   define variable mVisCUrentVin as logical no-undo.
      174   if session:batch-mode
      175   then
      176      mBatchMode = yes.
      177   if mBatchMode = ? then do:
      178     mVisCUrentVin = current-window:visible.
      179     mFameOldVis = mFramBachModHandle:visible.
      180     mFramBachModHandle:visible  = yes.
      181     mBatchMode = mFramBachModHandle:visible ne yes.
      182     mFramBachModHandle:visible = mFameOldVis.
      183     current-window:visible = mVisCUrentVin.
      184   end.
      185    if  log-manager:logfile-name ne ?
      186     then DO:
      187         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      188         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      189         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      190     end.
      191   on choose of B-WaitFramStop in frame waitfram
      192   do:
      193     mWaitFramStop = yes.
      194     mWaitFramStopUser = yes.
      195   end.
      196   function waitfram-check-timeout returns logical():
      197      define variable vtime as int64 no-undo.
      198      if mWaitFramStopTimeOut
      199      then
      200         return yes.
      201      vtime = ( now - mWaitFramStartProc ) / 1000 .
      202      if     mWaitFramTimeOut ne ?
      203         and mWaitFramTimeOut ne 0
      204         and mWaitFramTimeOut lt vtime
      205      then do:
      206         mWaitFramStopTimeOut = yes.
      207      end.
      208      return mWaitFramStopTimeOut.
      209   end.
      210   procedure waitfram-hide :
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       pause 0 before-hide .
      216       if not mBatchMode then
      217         hide frame waitfram .
      218     if     not mWaitFramView
      219        and mWaitProcEvent
      220     then
      221       process events .
      222     end.
      223   end procedure.
      224   procedure waitfram-show :
      225     define input  parameter p-message as character no-undo .
      226     define variable v-left-margin as integer   no-undo .
      227     if not session:batch-mode
      228     then do
      229     on error undo, return error return-value
      230     :
      231       if length(p-message) <= 70 then do:
      232         assign
      233           v-left-margin = integer((70 - length(p-message)) / 2)
      234         .
      235         assign
      236           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      237         .
      238         assign
      239           v-waitfram-action01 = " "
      240           v-waitfram-action02 = " "
      241                                    + fill(" ", v-left-margin)
      242                                    + p-message
      243           v-waitfram-action03 = " "
      244         .
      245       end.
      246       else do:
      247         define variable vRindex1 as integer no-undo.
      248         define variable vRindex2 as integer no-undo.
      249         vRindex1 = r-index(p-message," ",70).
      250         if vRindex1 = 0
      251         then
      252            vRindex1 = 70.
      253         if length(p-message)  <= vRindex1 + 70 then do:
      254           assign
      255             v-waitfram-action01 = " "
      256             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      257             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      258           .
      259         end.
      260         else do:
      261           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      262           if vRindex2 <= vRindex1
      263           then
      264              vRindex2 = vRindex1 + 70.
      265           assign
      266             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      267             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      268             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      269           .
      270         end.
      271       end.
      272       B-viewProcInfo:visible   in frame waitfram = no.
      273       B-viewProcInfo:sensitive in frame waitfram = no.
      274       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      275       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      276       if  (   mWaitFramView
      277          or  mWaitProcEvent)
      278          and not mBatchMode
      279       then
      280          display
      281             v-waitfram-action01 skip
      282             v-waitfram-action02 skip
      283             v-waitfram-action03 skip
      284          with frame waitfram .
      285       if     mWaitFramView
      286          then do:
      287             if     mWaitFramInterval ne ?
      288                and not mBatchMode
      289             then
      290                wait-for go of frame waitfram pause mWaitFramInterval.
      291          end.
      292          else
      293             if     mWaitProcEvent
      294                and not mBatchMode
      295             then
      296                process events .
      297     end.
      298   end procedure.
      299      procedure waitfram-show-this:
      300         define input  parameter iInterval as int64 no-undo.
      301         define variable vtime as int64 no-undo.
      302         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      303         mWaitFramInterval = iInterval.
      304         run waitfram-show (substitute("&1&2 &3&4" ,
      305                                       mWaitFramTextBeg ,
      306                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      307                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      308                                       mWaitFramTextEnd
      309                                      )
      310                           ).
      311      end.
      312      procedure WaitFramRunPause:
      313         define input  parameter iInterval as dec no-undo.
      314         define variable vStart  as datetime-tz no-undo.
      315         define variable vend    as datetime-tz no-undo.
      316         define variable vint as int64 no-undo.
      317         define variable vOk as logical no-undo.
      318         vStart = now.
      319         vend   = vStart.
      320         publish "WaitFramPause" (iInterval,output vOk).
      321         vend   =  now.
      322         vint = vend - vStart.
      323         vint = iInterval - vint / 1000.
      324         if     not mWaitFramStop
      325            and (   vint > 0
      326                 or (    not vOk
      327                     and iInterval eq ?
      328                     )
      329                 )
      330         then
      331            run waitfram-show-this (iInterval).
      332         vend   =  now.
      333         vint = vend - vStart.
      334         vint = iInterval - vint / 1000.
      335         if     not mWaitFramStop
      336            and vint > 0
      337         then do:
      338            run gbl/pause.p (vint * 1000).
      339         end.
      340         if iInterval ne ?
      341         then
      342            publish "WaitFramStop".
      343         waitfram-check-timeout().
      344      end.
      345      procedure WaitFramWaitFor:
      346         define input  parameter iInterval as dec no-undo.
      347         assign
      348            mWaitFramStartProc   = now
      349            mWaitFramStopUser    = no
      350            mWaitFramStopTimeOut = no
      351         .
      352         block-wait:
      353         do while not mWaitFramStop:
      354            run WaitFramRunPause (iInterval).
      355            if  waitfram-check-timeout()
      356            then do:
      357               leave block-wait.
      358            end.
      359         end.
      360         run waitfram-hide.
      361      end.
      362   procedure waitfram-join :
      363     define input  parameter p-line-1  as character no-undo .
      364     define input  parameter p-line-2  as character no-undo .
      365     define input  parameter p-line-3  as character no-undo .
      366     define output parameter p-message as character no-undo .
      367     do
      368     on error undo, return error return-value
      369     :
      370       assign
      371         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      372                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      373                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      374       .
      375     end.
      376   end procedure.
      377   function waitfram-join-function returns character
      378     (input p-line-1 as character
      379     ,input p-line-2 as character
      380     ,input p-line-3 as character
      381     ).
      382     define variable v-message as character no-undo .
      383     run waitfram-join in this-procedure
      384       (input  p-line-1
      385       ,input  p-line-2
      386       ,input  p-line-3
      387       ,output v-message
      388       ) .
      389     return v-message .
      390   end function .
      391   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   define  stream PrnLibStream.
      393   procedure prn-lib-prn-file :
      394     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      395     define input parameter p-DIsabledoptions as integer no-undo .
      396     define variable v-report-name as character no-undo .
      397     define variable v-user-action as character no-undo .
      398     define variable v-printed     as logical   no-undo .
      399     define variable v-exist       as logical   no-undo .
