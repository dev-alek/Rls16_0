       15   define input parameter p-stts              like ub.dis-card-mask.stts no-undo .
       16   DEFINE input-output    PARAMETER p-rid-list As char NO-UNDO.
       17   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       18   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
