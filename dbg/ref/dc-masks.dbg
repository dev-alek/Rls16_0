      536   procedure prn-lib-reportviewer :
      537     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      538     define input parameter p-report-name-html as character no-undo .
      539     define input parameter p-param        as character no-undo .
      540     define variable v-excel           as character no-undo init 'TRUE' .
      541     define variable v-value-character as character no-undo .
      542     define variable v-value-integer   as character no-undo .
      543     define variable v-value-date      as date      no-undo .
      544     define variable v-value-decimal   as decimal   no-undo .
      545     define variable rep-excel         as logical   no-undo .
      546     define variable excel-string      as character no-undo .
      547     define variable v-param-type      as character no-undo .
      548     define variable v-tth             as handle    no-undo .
      549     run adm/shattri.p (
      550       input "get":U
      551       ,input  ""
      552       ,input  0
      553       ,input  'report-glob':U
      554       ,input  'rep-excel':U
      555       ,output v-value-character
      556       ,output v-value-date
      557       ,output v-value-decimal
      558       ,output v-value-integer
      559       ,output rep-excel
      560       ,output v-param-type
      561       ,INPUT-OUTPUT table-handle v-tth
      562       )  .
      563     if rep-excel then v-excel = "TRUE" .
      564     else v-excel = "FALSE" .
      565     if p-param eq ""
      566     then
      567        p-param = "EXCEL:" + v-excel.
      568     else
      569        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      570     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      571   end procedure.
      572   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   procedure cur-time :
      574      define output parameter p-today as date      no-undo .
      575      define output parameter p-time  as integer   no-undo .
      576     do
      577     on error undo, return error
      578     :
      579       define variable v-date1 as date      no-undo .
      580       define variable v-date2 as date      no-undo .
      581       define variable v-time  as integer   no-undo .
      582       assign
      583         v-date1 = today
      584         v-time  = time
      585         v-date2 = today
      586       .
      587       if v-date1 <> v-date2
      588       then do:
      589         assign
      590           v-date1 = today
      591           v-time  = v-time
      592         .
      593       end.
      594       assign
      595         p-today = v-date1
      596         p-time  = v-time
      597       .
      598     end.
      599   end.
      600   function cur-time-date returns character
      601   :
      602     return string(today, '99/99/9999':U) .
      603   end.
      604   function cur-time-mjd returns decimal
      605   :
      606     define variable v-date as date      no-undo .
      607     define variable v-time as integer   no-undo .
      608     run cur-time in this-procedure
      609       (output v-date
      610       ,output v-time
      611       ) .
      612     return integer(v-date) - 2400002 + (v-time / 86400) .
      613   end.
      614   function cur-time-get-ending-index returns integer
      615   (input p-number as integer
      616   )
      617   :
      618     if p-number < 0
      619     or p-number = ?
      620     then do:
      621       return 1 .
      622     end.
      623     define variable v-rest as integer   no-undo .
      624     assign
      625       p-number = p-number modulo 100
      626     .
      627     if p-number < 20
      628     then do:
      629       assign
      630         v-rest = p-number
      631       .
      632     end.
      633     else do:
      634       assign
      635         v-rest = p-number modulo 10
      636       .
      637     end.
      638     case v-rest :
      639       when 1
      640       then do:
      641         return 2 .
      642       end.
      643       when 2 or
      644       when 3 or
      645       when 4
      646       then do:
      647         return 3 .
      648       end.
      649       otherwise do:
      650         return 1 .
      651       end.
      652     end case .
      653   end.
      654   procedure cur-time-mjd-to-date :
      655      define input  parameter i-mjd-diff as decimal no-undo.
      656      define output parameter o-Date     as date    no-undo.
      657      define output parameter o-Time     as integer no-undo.
      658      define variable v-day-number as integer   no-undo .
      659      if    i-mjd-diff < 0
      660         or i-mjd-diff = ?
      661      then do:
      662         return "?" .
      663      end.
      664      assign
      665         v-day-number = truncate(i-mjd-diff,0).
      666         o-Date = date(v-day-number + 2400002).
      667         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      668     .
      669   end.
      670   function cur-time-mjd-to-string returns character
      671   (input p-mjd-diff as decimal
      672   )
      673   :
      674     define variable v-day-number as integer   no-undo .
      675     define variable v-seconds    as integer   no-undo .
      676     define variable v-hour       as integer   no-undo .
      677     define variable v-min        as integer   no-undo .
      678     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      679     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      680     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      681     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      682     if p-mjd-diff < 0
      683     or p-mjd-diff = ?
      684     then do:
      685       return "?" .
      686     end.
      687     assign
      688       v-day-number = integer(truncate(p-mjd-diff,0))
      689       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      690     .
      691     if v-seconds > 86400
      692     then do:
      693       assign
      694         v-seconds = 86400 - 1
      695       .
      696     end.
      697     if v-seconds < 0
      698     then do:
      699       assign
      700         v-seconds = 0
      701       .
      702     end.
      703     assign
      704       v-hour = truncate(v-seconds / 3600, 0)
      705     .
      706     assign
      707       v-seconds = v-seconds modulo 3600
      708     .
      709     assign
      710       v-min = truncate(v-seconds / 60, 0)
      711     .
      712     assign
      713       v-seconds = v-seconds modulo 60
      714     .
      715     return
      716         (if v-day-number <> 0
      717           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      718           else ""
      719         )
      720       + (if v-day-number <> 0 or v-hour <> 0
      721           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      722           else ""
      723         )
      724       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      725           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      726           else ""
      727         )
      728       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      729       .
      730   end.
      731   function cur-time-string returns character
      732   :
      733     define variable v-date as date      no-undo .
      734     define variable v-time as integer   no-undo .
      735     run cur-time in this-procedure
      736       (output v-date
      737       ,output v-time
      738       ) .
      739     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      740   end.
      741   function cur-time-string-sec returns character
      742   :
      743     define variable v-date as date      no-undo .
      744     define variable v-time as integer   no-undo .
      745     run cur-time in this-procedure
      746       (output v-date
      747       ,output v-time
      748       ) .
      749     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      750   end.
      751   function cur-time-custom  returns character
      752   (input p-prefix as character
      753   ,input p-date-format as character
      754   ,input p-delimiter as character
      755   ,input p-time-format as character
      756   ,input p-suffix as character
      757   )
      758   :
      759     define variable v-date as date      no-undo .
      760     define variable v-time as integer   no-undo .
      761     run cur-time in this-procedure
      762       (output v-date
      763       ,output v-time
      764       ) .
      765     return
      766       p-prefix
      767       + string(v-date, p-date-format)
      768       + p-delimiter
      769       + string(v-time, p-time-format)
      770       + p-suffix
      771       .
      772   end.
      773   function cur-time-print  returns character
      774   :
      775     define variable v-date as date      no-undo .
      776     define variable v-time as integer   no-undo .
      777     run cur-time in this-procedure
      778       (output v-date
      779       ,output v-time
      780       ) .
      781     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      782   end.
      783   function cur-time-datetime returns datetime
      784   :
      785     define variable v-char as character no-undo .
      786     define variable v-datetime as datetime no-undo .
      787     v-char = cur-time-string().
      788     v-datetime = datetime(v-char).
      789     return  v-datetime.
      790   end.
      791   function cur-time-string-msec returns character
      792   :
      793     define variable v-date as datetime  no-undo .
      794     v-date = now.
      795     return string(v-date) .
      796   end.
