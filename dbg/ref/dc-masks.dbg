     2970   PROCEDURE MyEnable :
     2971   DISPLAY mark-num
     2972   WITH FRAME Dialog-Frame.
     2973   ENABLE
     2974   b-quit
     2975   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2976   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2977   B-add when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2978   B-lookup
     2979   B-chg when (LOOKUP("b-add":U, bttns) > 0 or
     2980               LOOKUP("b-chg":U, bttns) > 0 )
     2981              and v-db-num = 0
     2982   B-del when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2983   B-print
     2984   B-Help
     2985   B-hist
     2986   b-sch
     2987   br-masks
     2988   mark-num
     2989   with FRAME Dialog-Frame.
     2990   VIEW FRAME Dialog-Frame.
