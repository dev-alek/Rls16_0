     2858   MAIN-BLOCK:
     2859   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2860      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2861   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2862     run mainmenu_getcntxt in parparentproc
     2863       (output v-cntxt-db-num
     2864       ,output v-cntxt-userid
     2865       ,output v-cntxt-level
     2866       ,output v-cntxt-host-code-obj
     2867       ,output v-cntxt-obj-type
     2868       ,output v-cntxt-obj-code
     2869       ,output v-cntxt-db-num-obj
     2870       ,output v-cntxt-is-admin
     2871       ) .
     2872     find first X_curr_clients no-lock where
     2873               X_curr_clients.obj-type = p-curr-obj-type
     2874          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     2875     if not available X_curr_clients then do:
     2876       message
     2877       vss-workfile vss-revision vss-description skip
     2878       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     2879       p-curr-obj-type p-curr-obj-code
     2880       view-as alert-box ERROR.
     2881       return error .
     2882     end.
     2883   find first X_sysconf no-lock where
     2884               X_sysconf.host-code = p-curr-host-code no-error.
     2885     if not available X_sysconf OR X_sysconf.host-code <> X_curr_clients.host-code then do:
     2886       message
     2887       vss-workfile vss-revision vss-description skip
     2888       "Неверное значение параметра вызова p-curr-host-code"
     2889       p-curr-host-code
     2890       view-as alert-box ERROR.
     2891       return error .
     2892     end.
     2893   find first X_clients_sysconf no-lock where
     2894               X_clients_sysconf.obj-type = 'орг':U
     2895          AND X_clients_sysconf.obj-code = p-curr-host-code no-error.
     2896     if not available X_clients_sysconf then do:
     2897       message
     2898       vss-workfile vss-revision vss-description skip
     2899       "Неверное значение параметра вызова p-curr-host-code - не найдена фирма"
     2900       p-curr-host-code
     2901       view-as alert-box ERROR.
     2902       return error .
     2903     end.
     2904    if LOOKUP(p-ref-mode, ('все':U + chr(4) +
     2905                       "one":U + chr(4) +
     2906                       'объект':U + chr(4) +
     2907                       'фирма':U + chr(4)
     2908                       ) ,
     2909                   chr(4)) = 0
     2910        then dO:
     2911       message
     2912       vss-workfile vss-revision vss-description skip
     2913       "Неверное значение параметров вызова p-mode"
     2914       p-ref-mode
     2915       view-as alert-box ERROR.
     2916       return error .
     2917    end.
     2918    IF p-ref-mode = "one"
     2919    THEN DO:
     2920        FIND FIRST X_dis-card-type NO-LOCK WHERE
     2921                   X_dis-card-type.TYPE = p-type
