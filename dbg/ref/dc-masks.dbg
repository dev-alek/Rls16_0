     4571   PROCEDURE proc-b-del :
     4572   define variable loc#log as logical no-undo.
     4573   define variable v-stts like ub.dis-card-mask.stts no-undo .
     4574   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     4575   if not available X_dis-card-mask then return error.
     4576   do
     4577   on error undo, return error
     4578   on stop undo, return error
     4579   :
     4580   define variable vss-include-info48 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4581   do:
     4582     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4583       (input  v-cntxt-db-num
     4584       ,input  v-cntxt-userid
     4585       ,input  0
     4586       ,input  'actn_reference-dc-type_input-deletion-updating':U
     4587       ,input  'global':U
     4588       ,input  0
     4589       ,input  '':U
     4590       ,input  0
     4591       ,input  0
     4592       ,input  0
     4593       ,input  0
     4594       ,input  true
     4595       ,output loc#log
     4596       )  .
     4597   end.
     4598   if not loc#log then return error.
     4599     assign
     4600     v-stts = ?
     4601     loc-doc-rec = RECID(X_dis-card-mask)
     4602     .
     4603     run ref/dc-mask2.p (
     4604                      input parparentproc
     4605                     ,input recid(X_dis-card-mask)
     4606                     ,input-output v-stts
     4607                    ) no-error .
     4608     if error-status:error then undo, return error.
     4609     run OpenBr in this-procedure ( input yes, input no, input no).
     4610     REPOSITION br-masks to recid loc-doc-rec No-error.
     4611     if error-status:error then do:                           find first pos_dis-card-mask no-lock where                                   recid(pos_dis-card-mask) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи МАСКА КАРТЫ" skip                            string(if avail pos_dis-card-mask                                     then  substitute("Вн номер: &1 ", pos_dis-card-mask.mask-num )                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     4612     if available X_dis-card-mask then do:
     4613       loc#log = br-masks:select-focused-row( ) IN FRAME Dialog-Frame.
     4614     end.
     4615     apply "ENTRY" to br-masks.
     4616   end.
     4617   END PROCEDURE.
     4618   PROCEDURE proc-b-print :
     4619   define variable v-doc-rec as recid no-undo .
     4620   define variable accum-count as integer.
     4621   define variable date_string     as      char    no-undo.
     4622   define variable Line            as      char    no-undo.
     4623   DEFINE VARIABLE v-stts-chr AS CHARACTER NO-UNDO.
     4624   define variable v-cli AS CHARACTER no-undo.
     4625   define variable v-emitent-name like ub.clients.obj-name no-undo .
     4626   define variable v-region as character no-undo .
     4627   define variable v-mask-only as character no-undo .
     4628   define variable v-cli-mask-only as character no-undo .
     4629   define variable v-use-on-cd as character no-undo .
     4630   DEFINE FRAME dis-card-mask-f
     4631   X_dis-card-mask.type COLUMN-LABEL "Тип карты" FORMAT "X(8)":U
     4632   X_dis-card-mask.emitent-host-code COLUMN-LABEL "Код!эмитента" FORMAT "99999":U
     4633   v-emitent-name COLUMN-LABEL "Эмитент" FORMAT "X(15)":U
     4634   v-mask-only FORMAT "X(19)":U
     4635   v-use-on-cd FORMAT "X(20)":U
     4636   X_dis-card-mask.rank FORMAT ">>>9":U
     4637   X_dis-card-mask.mask-num COLUMN-LABEL "Номер!маски" FORMAT ">>>>>>>>9":U
     4638   v-region COLUMN-LABEL "Область!действия" FORMAT "X(14)":U
     4639   v-stts-chr COLUMN-LABEL "Статус" FORMAT "X(8)":U
     4640   X_dis-card-mask.cli-mask COLUMN-LABEL "Маска КОРОТКОГО!номера" FORMAT "X(10)":U
     4641   v-cli COLUMN-LABEL "Контрагент" FORMAT "X(12)":U
     4642   HEADER  date_string AT 5 format "X(35)"
     4643    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4644   Line format "X(195)" AT 1
     4645   with width 232 down stream-io use-text    .
     4646   Line = fill("-", 195).
     4647   date_string = cur-time-print() .
     4648   run prn-lib-open-stream  in this-procedure (
     4649                                                input parParentProc
     4650                                               ,input 43
     4651                                               ,input yes
     4652                                               ,input no
     4653                                               ).
     4654   PUT  STREAM PrnLibStream
     4655   SPACE(25) ( frame Dialog-Frame:title )
     4656   format "x(90)" SKIP(1) .
     4657   FORM HEADER
     4658   Line format "X(195)" AT 1 SKIP
     4659   "Продолжение - на следующей странице" AT 30 SKIP
     4660   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4661   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4662   FORM with FRAME dis-card-mask-f  .
     4663   run waitfram-show in this-procedure ("Ждите...").
     4664   v-doc-rec = recid(X_dis-card-mask).
     4665   DO WHILE available X_dis-card-mask :
     4666     GET prev br-masks.
     4667   END.
     4668   GET next br-masks.
     4669   DO WHILE available X_dis-card-mask :
     4670     Display STREAM PrnLibStream
     4671     X_dis-card-mask.type
     4672     X_dis-card-mask.emitent-host-code
     4673     get-emitent(X_dis-card-mask.emitent-host-code) @ v-emitent-name
     4674     X_dis-card-mask.mask @ v-mask-only
     4675     get-use-on-cd(X_dis-card-mask.use-on) @ v-use-on-cd
     4676     X_dis-card-mask.rank
     4677     X_dis-card-mask.mask-num
     4678     get-region(X_dis-card-mask.host-code, X_dis-card-mask.obj-type, X_dis-card-mask.obj-code) @ v-region
     4679     entry (lookup (STRING(p-stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ v-stts-chr
     4680     X_dis-card-mask.cli-mask @ v-mask-only
     4681     (X_dis-card-mask.cli-type + string(X_dis-card-mask.cli-code)) @ v-cli
     4682     with FRAME dis-card-mask-f .
     4683     DOWN STREAM PrnLibStream 1
     4684     with FRAME dis-card-mask-f  .
     4685     assign
     4686     accum-count = accum-count + 1
     4687     .
     4688     GET next br-masks.
     4689   END.
     4690   UNDERLINE  STREAM PrnLibStream
     4691   X_dis-card-mask.type
     4692   X_dis-card-mask.emitent-host-code
     4693   v-emitent-name
     4694   v-mask-only
     4695   v-use-on-cd
     4696   X_dis-card-mask.rank
     4697   X_dis-card-mask.mask-num
     4698   v-region
     4699   v-stts-chr
     4700   X_dis-card-mask.cli-mask
     4701   v-cli
     4702   with FRAME dis-card-mask-f .
     4703   DISPLAY STREAM PrnLibStream
     4704   accum-count @ v-stts-chr
     4705   with frame dis-card-mask-f.
     4706   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4707   HIDE  STREAM PrnLibStream FRAME dis-card-mask-f.
     4708   output  STREAM PrnLibStream CLOSE.
     4709   REPOSITION br-masks to recid v-doc-rec no-error.
     4710   APPLY "entry" to br-masks.
     4711   run waitfram-hide in this-procedure .
     4712   run prn-lib-prn-file in this-procedure (
     4713                                             input parParentProc
     4714                                             ,input 8
     4715                                             ).
     4716   END PROCEDURE.
     4717   PROCEDURE proc-b-sch :
     4718   assign
     4719     tbl = 'dis-card-mask'
     4720     join-tbl = 'X_dis-card-mask'
     4721     fld = ""
     4722     lab = ""
     4723     spr = ""
     4724     dim = '0'
     4725     .
     4726   run fltfield-add in this-procedure('mask', 'Маска карты', 'function_character',
     4727   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4728   run fltfield-add in this-procedure('mask-num', 'Номер маски', '',
     4729   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4730   run fltfield-add in this-procedure('emitent-host-code', 'Код фирмы-эмитента', '',
     4731   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4732   run fltfield-add in this-procedure('type', 'Тип карты', '',
     4733   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4734   run fltfield-add in this-procedure('rank', 'Ранг', '',
     4735   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4736   run fltfield-add in this-procedure('host-code', 'Фирма', '',
     4737   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4738   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект действия', 'cli',
     4739   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4740   run fltfield-add in this-procedure('stts', 'Статус', '',
     4741   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4742   run fltfield-add in this-procedure('cli-type*cli-code', 'Контрагент', 'cli',
     4743   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4744   run fltfield-add in this-procedure('cli-mask', 'Маска КОРОТКОГО номера', '',
     4745   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4746   Filter-Block:
     4747   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4748       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4749       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4750     run gbl/filter.w ( INPUT parparentproc
     4751                       ,INPUT (filter-point + chr(4) +
     4752                           filter-label + chr(4) + string(yes))
     4753                      , INPUT tbl
     4754                      , INPUT join-tbl
     4755                      , INPUT fld
     4756                      , INPUT lab
     4757                      , INPUT spr
     4758                      , INPUT dim ).
     4759     run OpenBr in this-procedure ( input yes, input no, input '':U).
     4760   END.
     4761   END PROCEDURE.
     4762   PROCEDURE proc-br-masks :
     4763   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4764   if b-sel:sensitive in frame Dialog-Frame then dO:
     4765       if b-mark:sensitive then do:
     4766           apply "choose" to b-mark in frame Dialog-Frame.
     4767       end.
     4768       else do:
     4769           apply "choose" to b-sel in frame Dialog-Frame.
     4770       end.
     4771   end.
     4772   else do:
     4773       if b-lookup:sensitive then
     4774       apply "choose" to b-lookup in frame Dialog-Frame.
     4775   end.
     4776   END PROCEDURE.
     4777   FUNCTION get-emitent RETURNS CHARACTER
     4778     ( input par-emitent-host-code  as integer ) :
     4779   if par-emitent-host-code = 0 then return "Глобальная".
     4780   find first ub.clients no-lock where
     4781               ub.clients.obj-type = 'орг':U and
     4782               ub.clients.obj-code = par-emitent-host-code no-error.
     4783   if not avail ub.clients then return "?".
     4784   return ub.clients.obj-name.
     4785   END FUNCTION.
     4786   FUNCTION get-region RETURNS CHARACTER
     4787     ( input p-host-code as integer, input p-obj-type as character, input p-obj-code as integer ) :
     4788   define variable par-region as character no-undo.
     4789     if p-host-code = 0 and
     4790          p-obj-type = "":U and
     4791          p-obj-code = 0 then do:
     4792          par-region = "Глобально".
     4793          return par-region.
     4794       end.
     4795       if p-obj-type = "" and
     4796          p-obj-code = 0 then do:
     4797          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(p-host-code).
     4798          return par-region.
     4799       end.
     4800       par-region = fill(chr(32), 4) + p-obj-type + chr(32) + string(p-obj-code).
     4801       return par-region.
     4802   END FUNCTION.
     4803   FUNCTION get-use-on-cd RETURNS CHARACTER
     4804     ( INPUT p-mask-field AS INTEGER ) :
     4805    RETURN entry (lookup (string(p-mask-field), '0,1,2':U), 'Касса_и_TH,ТОЛЬКО_касса,ТОЛЬКО_TH':U).
     4806   END FUNCTION.
