     1120     APPLY "END-ERROR":U TO SELF.
     1121   END.
     1122   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1123   DO:
     1124     define variable loc#log as logical no-undo.
     1125   define variable loc-doc-rec as recid no-undo .
     1126   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127   do:
     1128     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1129       (input  v-cntxt-db-num
     1130       ,input  v-cntxt-userid
     1131       ,input  0
     1132       ,input  'actn_reference-dc-type_input-deletion-updating':U
     1133       ,input  'global':U
     1134       ,input  0
     1135       ,input  '':U
     1136       ,input  0
     1137       ,input  0
     1138       ,input  0
     1139       ,input  0
     1140       ,input  true
     1141       ,output loc#log
     1142       )  .
     1143   end.
     1144   if not loc#log then return no-apply.
     1145   run ref/dc-maski.w
     1146                 (
     1147                    input parParentProc
     1148                   ,input p-curr-host-code
     1149                   ,input p-curr-obj-type
     1150                   ,input p-curr-obj-code
     1151                   ,input 'ДОБАВЛЕНИЕ':U
     1152                   ,input (if p-ref-mode = "one":U then X_dis-card-type.emitent-host-code else ?)
     1153                   ,input (if p-ref-mode = "one":U then X_dis-card-type.type else "":U)
     1154                   ,input 0
     1155                   ,input-output loc-doc-rec
     1156                               ) no-error
     1157   .
     1158   if loc-doc-rec <> ? then do:
     1159     run openbr in this-procedure ( input yes, input no, input '':U).
     1160     reposition br-masks to recid loc-doc-rec no-error.
     1161     if error-status:error then do:                           find first pos_dis-card-mask no-lock where                                   recid(pos_dis-card-mask) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи МАСКА КАРТЫ" skip                            string(if avail pos_dis-card-mask                                     then  substitute("Вн номер: &1 ", pos_dis-card-mask.mask-num )                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1162   end.
     1163   apply "entry" to br-masks in frame Dialog-Frame.
     1164   apply "value-changed" to br-masks in frame Dialog-Frame.
     1165   END.
     1166   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1167   DO:
     1168     DEFINE variable loc#log as logical no-undo.
     1169   define variable loc-doc-rec as recid no-undo .
     1170   if not available X_dis-card-mask then return no-apply.
     1171   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1172   do:
     1173     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1174       (input  v-cntxt-db-num
     1175       ,input  v-cntxt-userid
     1176       ,input  0
     1177       ,input  'actn_reference-dc-type_input-deletion-updating':U
     1178       ,input  'global':U
     1179       ,input  0
     1180       ,input  '':U
     1181       ,input  0
     1182       ,input  0
     1183       ,input  0
     1184       ,input  0
     1185       ,input  true
     1186       ,output loc#log
     1187       )  .
     1188   end.
     1189   if not loc#log then return no-apply.
     1190   assign
     1191   loc-doc-rec = recid(X_dis-card-mask).
     1192   run ref/dc-maski.w
     1193                 (
     1194                    input parParentProc
     1195                   ,input p-curr-host-code
     1196                   ,input p-curr-obj-type
     1197                   ,input p-curr-obj-code
     1198                   ,input 'ИЗМЕНЕНИЕ':U
     1199                   ,input X_dis-card-mask.emitent-host-code
     1200                   ,input X_dis-card-mask.type
     1201                   ,input X_dis-card-mask.mask-num
     1202                   ,input-output loc-doc-rec
     1203                               ) no-error
     1204   .
     1205   if loc-doc-rec <> ? then do:
     1206       run OpenBR in this-procedure ( input yes, input no, input no).
     1207       reposition br-masks to recid loc-doc-rec no-error.
     1208       if error-status:error then do:                           find first pos_dis-card-mask no-lock where                                   recid(pos_dis-card-mask) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи МАСКА КАРТЫ" skip                            string(if avail pos_dis-card-mask                                     then  substitute("Вн номер: &1 ", pos_dis-card-mask.mask-num )                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1209    end.
     1210   apply "entry" to br-masks in frame Dialog-Frame.
     1211   apply "value-changed" to br-masks in frame Dialog-Frame.
     1212   END.
     1213   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1214   DO:
     1215       run proc-b-del in this-procedure no-error.
     1216     if error-status:error then return no-apply.
     1217   END.
     1218   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1219   DO:
     1220     define variable loc-doc-rec as recid no-undo .
     1221   define variable v-rid-list as character no-undo.
     1222     if NOT available X_dis-card-mask then return no-apply.
     1223     loc-doc-rec = recid (X_dis-card-mask).
     1224     .
     1225     run ref/dccmasks.w
     1226                   (
     1227                    input parParentProc
     1228                   ,input p-curr-host-code
     1229                   ,input p-curr-obj-type
     1230                   ,input p-curr-obj-code
     1231                   ,input "":U
     1232                   ,input "one":U
     1233                   ,input X_dis-card-mask.type
     1234                   ,input X_dis-card-mask.emitent-host-code
     1235                   ,input X_dis-card-mask.mask-num
     1236                   ,input-output v-rid-list
     1237                                 )
     1238   .
     1239     reposition br-masks to recid loc-doc-rec no-error.
     1240     apply "entry" to br-masks in frame Dialog-Frame.
     1241     apply "value-changed" to br-masks in frame Dialog-Frame.
     1242   END.
     1243   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1244   DO:
     1245     DEFINE variable loc#log as logical no-undo.
     1246   define variable loc-doc-rec as recid no-undo .
     1247   if not available X_dis-card-mask then return no-apply.
     1248   assign
     1249   loc-doc-rec = recid(X_dis-card-mask).
     1250   run ref/dc-maski.w
     1251                 (
     1252                    input parParentProc
     1253                   ,input p-curr-host-code
     1254                   ,input p-curr-obj-type
     1255                   ,input p-curr-obj-code
     1256                   ,input 'ПРОСМОТР':U
     1257                   ,input X_dis-card-mask.emitent-host-code
     1258                   ,input X_dis-card-mask.type
     1259                   ,input X_dis-card-mask.mask-num
     1260                   ,input-output loc-doc-rec
     1261                               )
     1262   .
     1263   apply "entry" to br-masks in frame Dialog-Frame.
     1264   END.
     1265   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1266   DO:
     1267     define variable loc#log as logical no-undo .
     1268     if available X_dis-card-mask then do:
     1269   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1270   define variable v-str-recid14 as character no-undo .
     1271   define variable v-num-entry14 as integer   no-undo .
     1272   assign
     1273     v-str-recid14 = trim( string( recid( X_dis-card-mask ) , "->>>>>>>>>>>9":U ) )
     1274     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1275   .
     1276   if v-num-entry14 > 0 then do:
     1277     assign
     1278       entry( v-num-entry14, v-rid-list ) = "":U
     1279       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1280     .
     1281   end.
     1282   else do:
     1283     assign
     1284       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1285     .
     1286   end.
     1287       loc#log = br-masks:refresh() .
     1288       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1289           loc#log = br-masks:select-next-row ().
     1290           apply "VALUE-CHANGED" to br-masks in frame Dialog-Frame.
     1291       end.
     1292       if num-entries( v-rid-list ) = 0
     1293       then
     1294           hide mark-num in frame Dialog-Frame.
     1295       else
     1296           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1297     end.
     1298     apply "entry" to br-masks in frame Dialog-Frame.
     1299   END.
     1300   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1301   DO:
     1302     run proc-b-print in this-procedure no-error.
     1303     if error-status:error then do:
     1304       return no-apply.
     1305     end.
     1306     APPLY "ENTRY" to br-masks.
     1307   END.
     1308   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1309   DO:
     1310     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1311     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1312   END.
     1313   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1314   DO:
     1315       if ( available X_dis-card-mask ) then do:
     1316       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1317       then
     1318       v-rid-list = string( recid( X_dis-card-mask ) ) .
     1319     end.
     1320   END.
     1321   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1322   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1323   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1324   on help of frame Dialog-Frame
     1325   do:
     1326     run gbl/app_help.p
     1327       (input this-procedure :file-name
     1328       ,input ''
     1329       ,input ?
     1330       ) no-error.
     1331     if error-status :error then do:
     1332       message
     1333         "Ошибка при вызове помощи"
     1334         error-status :get-message(1)
     1335         view-as alert-box .
     1336     end.
     1337   end.
     1338   run minbtn-set in this-procedure .
     1339   on choose of b-help in frame Dialog-Frame
     1340   do:
     1341     apply "help":u to frame Dialog-Frame .
     1342   end.
     1343   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1344   procedure minbtn-set :
     1345       do
     1346           on error undo, return error return-value
     1347           :
     1348           define variable ii              as integer       no-undo .
     1349           define variable fh              as widget-handle no-undo .
     1350           define variable hh              as widget-handle no-undo .
     1351           define variable v-h             as handle        extent 4 no-undo .
     1352           define variable v-name-button   as character     no-undo .
     1353           define variable v-help-old-x    as decimal       no-undo .
     1354           define variable v-help-old-y    as decimal       no-undo .
     1355           define variable v-help-old-size as decimal       no-undo .
     1356           define variable v-frame-width   as decimal       no-undo .
     1357           define variable jj              as integer       no-undo .
     1358           do
     1359               on error undo, return error
     1360               :
     1361               assign
     1362                   v-frame-width = frame Dialog-Frame:width - 0.3
     1363                   fh            = frame Dialog-Frame:first-child
     1364                   hh            = fh:first-child
     1365                   ii            = 1
     1366                   .
     1367               do while valid-handle(hh):
     1368                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1369                   do:
     1370                       case lc(hh:name) :
     1371                           when "b-help" then
     1372                               do:
     1373                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1374                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1375                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1376                                   hh:TOOLTIP = "Помощь" .
     1377                                   v-help-old-x = hh:column .
     1378                                   v-help-old-y = hh:row    .
     1379                                   v-help-old-size = hh:width .
     1380                                   hh:width-chars = 2.5 .
     1381                               end.
     1382                           when "b-print" then
     1383                               do:
     1384                                   hh:load-image("cmp/b-print.bmp":u) .
     1385                                   hh:TOOLTIP = "Печать" .
     1386                                   v-h[ii] = hh:handle .
     1387                                   ii = ii + 1 .
     1388                                   hh:width-chars = 3 .
     1389                               end.
     1390                           when "b-history" or
     1391                           when "b-hist" then
     1392                               do:
     1393                                   hh:load-image("cmp/b-hist.bmp":u) .
     1394                                   hh:TOOLTIP = "История" .
     1395                                   v-h[ii] = hh:handle .
     1396                                   ii = ii + 1 .
     1397                                   hh:width-chars = 3 .
     1398                               end.
     1399                           when "b-sch" then
     1400                               do:
     1401                                   hh:load-image("cmp/b-sch.bmp":u) .
     1402                                   hh:TOOLTIP = "Установка Фильтра" .
     1403                                   v-h[ii] = hh:handle .
     1404                                   ii = ii + 1 .
     1405                                   hh:width-chars = 3 .
     1406                               end.
     1407                           when "b-hist-user" then
     1408                               do:
     1409                                   hh:load-image("cmp/b-hist.bmp":u) .
     1410                                   hh:TOOLTIP = "История пользователя" .
     1411                                   ii = ii + 1 .
     1412                               end.
     1413                       end case.
     1414                   end.
     1415                   hh = hh:next-sibling.
     1416               end.
     1417               b-help:column = v-frame-width - b-help:width-chars.
     1418               jj = 0.
     1419               repeat ii = 4 to 1 by -1 :
     1420                   if valid-handle (v-h[ii] ) then
     1421                   do:
     1422                       jj  = jj + 1 .
     1423                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1424                       v-h[ii]:row    = v-help-old-y .
     1425                   end.
     1426               end.
     1427           end.
     1428       end.
     1429   end procedure.
     1430   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1431   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1432   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1433   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1434   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1435   define variable v-diasize-current-frame-height as decimal   no-undo .
     1436   define variable v-diasize-change-size          as logical   no-undo .
     1437   define variable v-diasize-resize-button        as handle    no-undo .
     1438   define variable v-diasize-wndmax               as logical   no-undo .
     1439   define variable v-diasize-wndstore             as logical   no-undo .
     1440   define variable v-diasize-proc-name            as character no-undo .
     1441   define variable v-diasize-browse-handle        as handle    no-undo .
     1442   define variable v-diasize-browse-number        as integer   no-undo .
     1443   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1444   define temp-table temp-diasize-handle no-undo
     1445     field handle-value  as handle
     1446     field save-position as decimal
     1447     index xpk is primary unique handle-value
     1448     .
     1449   define temp-table temp-browse-handle no-undo
     1450     field browse-type   as character
     1451     field browse-number as integer
     1452     field browse-handle as handle
     1453     field original-size as decimal
     1454     index xpk is primary unique browse-type browse-number
     1455     index xie browse-type browse-handle
     1456   .
     1457   procedure diasize_change-height :
     1458     define input  parameter p-change-value  as decimal   no-undo .
     1459     define input  parameter p-move-resize   as logical   no-undo .
     1460     define variable v-field-group-handle    as handle    no-undo .
     1461     define variable v-object-handle         as handle    no-undo .
     1462     define variable v-frame-height          as decimal   no-undo .
     1463     define variable v-frame-virtual-height  as decimal   no-undo .
     1464     define variable v-browse-height         as decimal   no-undo .
     1465     define variable v-window-height         as decimal   no-undo .
     1466     define variable v-window-virtual-height as decimal   no-undo .
     1467     define variable v-change-sign           as integer   no-undo .
     1468     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1469     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1470     if p-change-value > 0
     1471     then do:
     1472       if frame Dialog-Frame :height + p-change-value
     1473           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1474       then do:
     1475         assign
     1476           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1477                           - (frame Dialog-Frame :height-chars)
     1478         .
     1479         if p-change-value <= 0
     1480         then do:
     1481           run diasize_position-resize-button in this-procedure .
     1482           return .
     1483         end.
     1484       end.
     1485     end.
     1486     if p-change-value < 0
     1487     then do:
     1488       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1489       then do:
     1490         assign
     1491           p-change-value = v-diasize-orig-frame-height
     1492                          - (frame Dialog-Frame :height-chars)
     1493         .
     1494         if p-change-value >= 0
     1495         then do:
     1496           run diasize_position-resize-button in this-procedure .
     1497           return .
     1498         end.
     1499       end.
     1500     end.
     1501     if p-change-value >= 0
     1502     then do:
     1503       assign
     1504         v-change-sign = 1
     1505       .
     1506     end.
     1507     else do:
     1508       assign
     1509         v-change-sign = -1
     1510       .
     1511     end.
     1512     assign
     1513       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1514     .
     1515     if p-change-value = 0
     1516     then do:
     1517       run diasize_position-resize-button in this-procedure .
     1518       return .
     1519     end.
     1520     move_block:
     1521     do
     1522     on error undo move_block, retry move_block
     1523     :
     1524       if retry
     1525       then do:
     1526         do
     1527         on error undo move_block, leave move_block
     1528         :
     1529           if p-change-value > 0
     1530           then do:
     1531             for each buf_temp-diasize-handle
     1532             on error undo, next
     1533             :
     1534               assign
     1535                 v-object-handle = buf_temp-diasize-handle.handle-value
     1536               .
     1537               if v-object-handle <> v-diasize-resize-button
     1538               then do:
     1539                 assign
     1540                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1541                 .
     1542               end.
     1543             end.
     1544             assign
     1545               v-diasize-browse-handle :height = v-browse-height
     1546             .
     1547             for each buf_temp-browse-handle
     1548               where buf_temp-browse-handle.browse-type = 'height':u
     1549             on error undo, next
     1550             :
     1551               assign
     1552                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1553               .
     1554             end.
     1555             assign
