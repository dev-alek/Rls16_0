     1881         then do:
     1882           run diasize_position-resize-button in this-procedure .
     1883           return .
     1884         end.
     1885       end.
     1886     end.
     1887     if p-change-value >= 0
     1888     then do:
     1889       assign
     1890         v-change-sign = 1
     1891       .
     1892     end.
     1893     else do:
     1894       assign
     1895         v-change-sign = -1
     1896       .
     1897     end.
     1898     assign
     1899       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1900     .
