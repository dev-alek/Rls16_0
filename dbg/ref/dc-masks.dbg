     1087   entry (lookup (STRING(X_dis-card-mask.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) COLUMN-LABEL "Статус" FORMAT "X(8)":U
     1088   X_dis-card-mask.cli-mask COLUMN-LABEL 'Маска короткого!номера' FORMAT "X(19)":U
     1089   WIDTH 21
     1090   X_dis-card-mask.cli-type + string(X_dis-card-mask.cli-code) COLUMN-LABEL "Контрагент" FORMAT "X(12)":U
     1091       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 19.25 FIT-LAST-COLUMN.
     1092   DEFINE FRAME Dialog-Frame
     1093        b-quit AT ROW 1 COL 1
     1094        B-mark AT ROW 1 COL 11
     1095        B-sel AT ROW 1 COL 21
     1096        B-add AT ROW 1 COL 31
     1097        B-lookup AT ROW 1 COL 41
     1098        B-chg AT ROW 1 COL 51
     1099        B-del AT ROW 1 COL 61
     1100        B-print AT ROW 1 COL 86
     1101        B-hist AT ROW 1 COL 89
     1102        B-sch AT ROW 1 COL 92
     1103        B-Help AT ROW 1 COL 95
     1104        BR-masks AT ROW 2.25 COL 1
     1105        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1106        SPACE(78.50) SKIP(20.02)
     1107       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1108            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1109            TITLE "Маски дисконтных карт"
     1110            CANCEL-BUTTON b-quit.
     1111   ASSIGN
     1112          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1113          FRAME Dialog-Frame:HIDDEN           = TRUE.
