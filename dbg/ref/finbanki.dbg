     1118   PROCEDURE proc-save :
     1119   define input parameter p-save as logical no-undo .
     1120   if p-mode = 'ПРОСМОТР':U then do:
     1121       return error.
     1122   end.
     1123   if not available tt-fin-bank then do:
     1124       create tt-fin-bank.
     1125   end.
     1126   assign
     1127   tt-fin-bank.addres frame Dialog-Frame
     1128   tt-fin-bank.bank-city
     1129   tt-fin-bank.addres1
     1130   tt-fin-bank.bank-name
     1131   tt-fin-bank.bik
     1132   tt-fin-bank.cor-acc
     1133   tt-fin-bank.e-mail
     1134   tt-fin-bank.fax
