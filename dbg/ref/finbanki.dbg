      514   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      515   DO:
      516   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      517   if lookup(self :type
      518            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      519            ) = 0
      520   then do:
      521     message
      522       "$Workfile$"
      523       "Указанному интерфейсному элементу фокус не может быть передан" skip
      524       "Интерфейсный элемент" self :name  skip
      525       "Тип" self :type  skip
      526       "Процедура" this-procedure :file-name skip
      527       view-as alert-box .
      528   end.
      529   else do:
      530     apply "entry":u to self  .
      531     if focus :handle <> self :handle  then do:
      532       return no-apply .
      533     end.
      534   end.
      535     run proc-save in this-procedure(yes) no-error.
      536     if error-status:error then return no-apply.
      537   END.
      538   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      539   DO:
      540   define variable v-rid-list as character no-undo.
      541   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      542   if lookup(self :type
      543            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      544            ) = 0
      545   then do:
      546     message
      547       "$Workfile$"
      548       "Указанному интерфейсному элементу фокус не может быть передан" skip
      549       "Интерфейсный элемент" self :name  skip
      550       "Тип" self :type  skip
      551       "Процедура" this-procedure :file-name skip
      552       view-as alert-box .
      553   end.
      554   else do:
      555     apply "entry":u to self  .
      556     if focus :handle <> self :handle  then do:
      557       return no-apply .
      558     end.
      559   end.
      560       run ref/fincbnks.w
      561                   (
      562                    input parParentProc
      563                   ,input p-curr-host-code
      564                   ,input "":U
      565                   ,input "one":U
      566                   ,input locked_fin-bank.host-code
      567                   ,input locked_fin-bank.code-bank
      568                   ,input-output v-rid-list
      569                                 )
      570    .
      571   END.
      572   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      573   DO:
      574   define variable v-log as logical no-undo .
      575   define variable v-cmp as character no-undo .
      576   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   if lookup(self :type
      578            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      579            ) = 0
      580   then do:
      581     message
      582       "$Workfile$"
      583       "Указанному интерфейсному элементу фокус не может быть передан" skip
      584       "Интерфейсный элемент" self :name  skip
      585       "Тип" self :type  skip
      586       "Процедура" this-procedure :file-name skip
      587       view-as alert-box .
      588   end.
      589   else do:
      590     apply "entry":u to self  .
      591     if focus :handle <> self :handle  then do:
      592       return no-apply .
      593     end.
      594   end.
      595   run proc-save in this-procedure (no) no-error.
      596   buffer-compare tt-fin-bank to locked_fin-bank
      597   case-sensitive
      598   save result in v-cmp .
      599   if v-cmp <> "":U then do:
      600     message
      601     "Вы изменили запись БАНК, но не сохранили ее" skip
      602     "сохранить перед печатью?"
      603     view-as alert-box QUESTION buttons YES-NO update v-log.
      604   end.
      605   run proc-save in this-procedure (v-log) no-error.
      606       run ref/finbankp.p (
      607                    INPUT parParentProc
      608                    ,input locked_fin-bank.host-code
      609                    ,input locked_fin-bank.code-bank
      610                 ) no-error.
      611   if error-status:error then do:
      612     return no-apply.
      613   end.
      614   END.
      615   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      616   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      617   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      618   on help of frame Dialog-Frame
      619   do:
      620     run gbl/app_help.p
      621       (input this-procedure :file-name
      622       ,input ''
      623       ,input ?
      624       ) no-error.
      625     if error-status :error then do:
      626       message
      627         "Ошибка при вызове помощи"
      628         error-status :get-message(1)
      629         view-as alert-box .
      630     end.
      631   end.
      632   run minbtn-set in this-procedure .
      633   on choose of b-help in frame Dialog-Frame
      634   do:
      635     apply "help":u to frame Dialog-Frame .
      636   end.
      637   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      638   procedure minbtn-set :
      639       do
      640           on error undo, return error return-value
      641           :
      642           define variable ii              as integer       no-undo .
      643           define variable fh              as widget-handle no-undo .
      644           define variable hh              as widget-handle no-undo .
      645           define variable v-h             as handle        extent 4 no-undo .
      646           define variable v-name-button   as character     no-undo .
      647           define variable v-help-old-x    as decimal       no-undo .
      648           define variable v-help-old-y    as decimal       no-undo .
      649           define variable v-help-old-size as decimal       no-undo .
      650           define variable v-frame-width   as decimal       no-undo .
      651           define variable jj              as integer       no-undo .
      652           do
      653               on error undo, return error
      654               :
      655               assign
      656                   v-frame-width = frame Dialog-Frame:width - 0.3
      657                   fh            = frame Dialog-Frame:first-child
      658                   hh            = fh:first-child
      659                   ii            = 1
      660                   .
      661               do while valid-handle(hh):
      662                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      663                   do:
      664                       case lc(hh:name) :
      665                           when "b-help" then
      666                               do:
      667                                   hh:load-image-up("cmp/b-help.bmp":u) .
      668                                   hh:load-image-down("cmp/b-help.bmp":u) .
      669                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      670                                   hh:TOOLTIP = "Помощь" .
      671                                   v-help-old-x = hh:column .
      672                                   v-help-old-y = hh:row    .
      673                                   v-help-old-size = hh:width .
      674                                   hh:width-chars = 2.5 .
      675                               end.
      676                           when "b-print" then
      677                               do:
      678                                   hh:load-image("cmp/b-print.bmp":u) .
      679                                   hh:TOOLTIP = "Печать" .
      680                                   v-h[ii] = hh:handle .
      681                                   ii = ii + 1 .
      682                                   hh:width-chars = 3 .
      683                               end.
      684                           when "b-history" or
      685                           when "b-hist" then
      686                               do:
      687                                   hh:load-image("cmp/b-hist.bmp":u) .
      688                                   hh:TOOLTIP = "История" .
      689                                   v-h[ii] = hh:handle .
      690                                   ii = ii + 1 .
      691                                   hh:width-chars = 3 .
      692                               end.
      693                           when "b-sch" then
      694                               do:
      695                                   hh:load-image("cmp/b-sch.bmp":u) .
      696                                   hh:TOOLTIP = "Установка Фильтра" .
      697                                   v-h[ii] = hh:handle .
      698                                   ii = ii + 1 .
      699                                   hh:width-chars = 3 .
      700                               end.
      701                           when "b-hist-user" then
      702                               do:
      703                                   hh:load-image("cmp/b-hist.bmp":u) .
      704                                   hh:TOOLTIP = "История пользователя" .
      705                                   ii = ii + 1 .
      706                               end.
      707                       end case.
      708                   end.
      709                   hh = hh:next-sibling.
      710               end.
      711               b-help:column = v-frame-width - b-help:width-chars.
      712               jj = 0.
      713               repeat ii = 4 to 1 by -1 :
      714                   if valid-handle (v-h[ii] ) then
      715                   do:
      716                       jj  = jj + 1 .
      717                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      718                       v-h[ii]:row    = v-help-old-y .
      719                   end.
      720               end.
      721           end.
      722       end.
      723   end procedure.
      724   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      725   ON TAB ANYWHERE
      726   DO:
      727   define variable ii as integer no-undo .
      728   define variable fh as widget-handle no-undo .
      729   define variable hh as widget-handle no-undo .
      730   define variable v-next-widget-name as character no-undo .
      731   if v-tab-order <> '' then do:
      732     if self:type = "TOGGLE-BOX" then
      733     self:BGCOLOR = ?.
      734     assign
      735     ii = lookup(self:name, v-tab-order).
      736     assign
      737     ii = ii + 1
      738     v-next-widget-name = entry(ii, v-tab-order)
      739     no-error .
      740     if error-status:error then do:
      741       assign
      742       ii = 1
      743       v-next-widget-name = entry( ii, v-tab-order)
      744       .
      745     end.
      746     assign
      747     fh = frame Dialog-Frame:first-child
      748     hh = fh:first-child
      749     .
      750     do while valid-handle(hh):
      751       if hh:name = v-next-widget-name then do:
      752         if hh:sensitive  = yes
      753         AND hh:visible = yes then do:
      754           if hh:type = "TOGGLE-BOX":U then do:
      755             assign
      756             hh:BGcolor = 1
      757             .
      758           end.
      759           APPLY "ENTRY" to hh.
      760           return no-apply.
      761         end.
      762         else do:
      763           APPLY "TAB" to hh.
      764           return no-apply.
      765         end.
      766       end.
      767       hh = hh:next-sibling.
      768     end.
      769   end.
      770   END.
      771   ON BACK-TAB ANYWHERE
      772   DO:
      773   define variable ii as integer no-undo .
      774   define variable fh as widget-handle no-undo .
      775   define variable hh as widget-handle no-undo .
      776   define variable v-next-widget-name as character no-undo .
      777   if v-tab-order <> '' then do:
      778     assign
      779     ii = lookup(self:name, v-tab-order).
      780     .
      781     assign
      782     ii = (if ii = 1
      783           then  num-entries(v-tab-order)
      784           else ii - 1
      785           )
      786     v-next-widget-name = entry(ii, v-tab-order)
      787     .
      788     assign
      789     fh = frame Dialog-Frame:first-child
      790     hh = fh:first-child
      791     .
      792     do while valid-handle(hh):
      793       if hh:name = v-next-widget-name then do:
      794         if hh:sensitive  = yes
      795         AND hh:visible = yes then do:
      796           if hh:type = "TOGGLE-BOX":U then do:
      797             assign
      798             hh:BGcolor = 1
      799             .
      800           end.
      801           APPLY "ENTRY" to hh.
      802           return no-apply.
      803         end.
      804         else do:
      805         APPLY "BACK-TAB" to hh.
      806         return no-apply.
      807         end.
      808       end.
      809       hh = hh:next-sibling.
      810     end.
      811     end.
      812   END.
      813   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      814   ON RETURN ANYWHERE
      815   DO:
      816   define variable ii as integer no-undo .
      817   define variable fh as widget-handle no-undo .
      818   define variable hh as widget-handle no-undo .
      819   define variable v-next-widget-name as character no-undo .
      820     if v-tab-order <> '' then do:
      821       assign
      822       ii = lookup(self:name, v-tab-order).
      823       if ii = num-entries(v-tab-order) then do:
      824           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      825           return no-apply.
      826       end.
      827       if self:type <> "BUTTON" and
      828         self:type <> "EDITOR"  then do:
      829         run proc-move-forward in this-procedure .
      830         return no-apply.
      831       end.
      832       if self:type = "BUTTON" then do:
      833         APPLY "CHOOSE" to self.
      834       end.
      835       if self:type = "TOGGLE-BOX" then
      836       self:BGCOLOR = ?.
      837       assign
      838       ii = ii + 1
      839       v-next-widget-name = entry(ii, v-tab-order)
      840       no-error .
      841       if error-status:error then do:
      842         assign
      843         ii = 1
      844         v-next-widget-name = entry( ii, v-tab-order)
      845         .
      846       end.
      847       assign
      848       fh = frame Dialog-Frame:first-child
      849       hh = fh:first-child
      850       .
      851       do while valid-handle(hh):
      852         if hh:name = v-next-widget-name then do:
      853           if hh:sensitive  = yes
      854           AND hh:visible = yes then do:
      855             if hh:type = "TOGGLE-BOX":U then do:
      856               assign
      857               hh:BGcolor = 1
      858               .
      859             end.
      860             APPLY "ENTRY" to hh.
      861             return no-apply.
      862           end.
      863           else do:
      864             APPLY "TAB" to hh.
      865             return no-apply.
      866           end.
      867         end.
      868         hh = hh:next-sibling.
      869       end.
      870     end.
      871   END.
      872   procedure proc-move-forward :
      873   define variable ii as integer no-undo .
      874   define variable fh as widget-handle no-undo .
      875   define variable hh as widget-handle no-undo .
      876   define variable v-next-widget-name as character no-undo .
      877   do
      878   on error undo, return error
      879   :
      880     if v-tab-order <> '' then do:
      881       if self:type = "TOGGLE-BOX" then
      882       self:BGCOLOR = ?.
      883       assign
      884       ii = lookup(self:name, v-tab-order).
      885       assign
      886       ii = ii + 1
      887       v-next-widget-name = entry(ii, v-tab-order)
      888       no-error .
      889       if error-status:error then do:
      890         assign
      891         ii = 1
      892         v-next-widget-name = entry( ii, v-tab-order)
      893         .
      894       end.
      895       assign
      896       fh = frame Dialog-Frame:first-child
      897       hh = fh:first-child
      898       .
      899       do while valid-handle(hh):
      900         if hh:name = v-next-widget-name then do:
      901           if hh:sensitive  = yes
      902           AND hh:visible = yes then do:
      903             if hh:type = "TOGGLE-BOX":U then do:
      904               assign
      905               hh:BGcolor = 1
      906               .
      907             end.
      908             APPLY "ENTRY" to hh.
      909             return.
      910           end.
      911           else do:
      912             assign
      913             ii = ii + 1
      914             v-next-widget-name = entry(ii, v-tab-order)
      915             no-error .
      916             if error-status:error then do:
      917               assign
      918               ii = 1
      919               v-next-widget-name = entry( ii, v-tab-order)
      920               .
      921             end.
      922           end.
      923         end.
      924         hh = hh:next-sibling.
      925       end.
      926     end.
      927   end.
      928   end procedure.
      929   MAIN-BLOCK:
      930   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      931      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      932    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      933    and p-mode <> 'ИЗМЕНЕНИЕ':U
      934    and p-mode <> 'ПРОСМОТР':U
      935    then do:
      936       message
      937       vss-workfile vss-revision vss-description skip
      938       "Неверное значение параметров вызова p-mode"  p-mode
      939       view-as alert-box ERROR.
      940       undo, return error.
      941    end.
      942   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      943   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      944     (output v-db-num
      945     )  .
      946   find first X_curr_sysconf no-lock where
      947                   X_curr_sysconf.host-code = p-curr-host-code.
      948   find first X_sysconf no-lock where
      949                   X_sysconf.host-code = p-host-code.
      950    if p-mode <> 'ПРОСМОТР':U then do:
      951       if X_curr_sysconf.host-code <> p-host-code
      952       or v-db-num <> X_sysconf.firm-db-num
      953       then do:
      954         message
      955         vss-workfile vss-revision vss-description skip
      956         "Неверное значение параметров вызова p-mode и/или p-host-code и/или p-curr-host-code" p-mode p-host-code  p-curr-host-code
      957         view-as alert-box ERROR.
      958         undo, return error.
      959       end.
      960     end.
      961     for each tt-fin-bank:
      962           delete tt-fin-bank.
      963       end.
      964     if p-mode = 'ИЗМЕНЕНИЕ':U
      965     or p-mode = 'ПРОСМОТР':U then do:
      966       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      967         find first locked_fin-bank EXclusive-lock where
      968                      recid(locked_fin-bank) = p-doc-rec no-wait no-error.
      969         if locked locked_fin-bank then do:
      970           message
      971           vss-workfile vss-revision vss-description skip
      972            "Запись БАНК занята"
      973           view-as alert-box error .
      974           undo, return error.
      975         end.
      976       end.
      977       else do:
      978         find first locked_fin-bank no-lock where
      979                          recid(locked_fin-bank) = p-doc-rec no-error .
      980         if not avail locked_fin-bank then do:
      981           find first locked_fin-bank where
      982                     locKed_fin-bank.host-code = p-host-code
      983                  AND locKed_fin-bank.code-bank = p-code-bank no-error .
      984         end.
      985       end.
      986       if not available locked_fin-bank then do:
      987         message
      988         vss-workfile vss-revision vss-description skip
      989         "Не найдена запись БАНК"
      990         view-as alert-box error .
      991         undo, return error.
      992       end.
      993       create tt-fin-bank.
      994       buffer-copy locked_fin-bank to tt-fin-bank.
      995      end.
      996     RUN MYEnable.
      997     WAIT-FOR GO OF FRAME Dialog-Frame.
      998   END.
      999   RUN disable_UI.
     1000   PROCEDURE disable_UI :
     1001     HIDE FRAME Dialog-Frame.
     1002   END PROCEDURE.
     1003   PROCEDURE enable_UI :
     1004     OPEN QUERY Dialog-Frame FOR EACH tt-fin-bank WHERE TRUE  SHARE-LOCK.
     1005     GET FIRST Dialog-Frame.
     1006     DISPLAY f-host-name
     1007         WITH FRAME Dialog-Frame.
     1008     IF AVAILABLE tt-fin-bank THEN
     1009       DISPLAY tt-fin-bank.host-code tt-fin-bank.code-bank tt-fin-bank.bik
     1010             tt-fin-bank.inn tt-fin-bank.kpp tt-fin-bank.cor-acc tt-fin-bank.rkc
     1011             tt-fin-bank.bank-name tt-fin-bank.short-name tt-fin-bank.licenz
     1012             tt-fin-bank.bank-city tt-fin-bank.addres tt-fin-bank.addres1
     1013             tt-fin-bank.phone tt-fin-bank.fax tt-fin-bank.e-mail
     1014             tt-fin-bank.cl-bank tt-fin-bank.okato tt-fin-bank.okonx
     1015             tt-fin-bank.okpo tt-fin-bank.PS
     1016         WITH FRAME Dialog-Frame.
     1017     ENABLE B-exit b-quit B-print B-hist B-Help tt-fin-bank.bik tt-fin-bank.inn
     1018            tt-fin-bank.kpp tt-fin-bank.cor-acc tt-fin-bank.rkc
     1019            tt-fin-bank.bank-name tt-fin-bank.short-name tt-fin-bank.licenz
     1020            tt-fin-bank.bank-city tt-fin-bank.addres tt-fin-bank.addres1
     1021            tt-fin-bank.phone tt-fin-bank.fax tt-fin-bank.e-mail
     1022            tt-fin-bank.cl-bank tt-fin-bank.okato tt-fin-bank.okonx
     1023            tt-fin-bank.okpo tt-fin-bank.PS
     1024         WITH FRAME Dialog-Frame.
     1025     VIEW FRAME Dialog-Frame.
     1026   END PROCEDURE.
     1027   PROCEDURE MyEnable :
     1028   DEFINE VARIABLE v-list-items AS CHARACTER NO-UNDO.
     1029   DEFINE VARIABLE v-ii         AS INTEGER   NO-UNDO.
     1030   assign
     1031   v-list-items = "нет системы КЛИЕНТ-БАНК" + chr(44) + '':U.
     1032   DO v-ii = 1 TO NUM-ENTRIES('1s':U):
     1033       ASSIGN
     1034       v-list-items = v-list-items + chr(44) +
     1035                      ENTRY(v-ii, '1С':U) + chr(44) +
     1036                      ENTRY(v-ii, '1s':U).
     1037   END.
     1038   assign
     1039   tt-fin-bank.okonx:label in frame Dialog-Frame = "ОКОНХ"
     1040   tt-fin-bank.inn:label  in frame Dialog-Frame  = "ИНН"
     1041   tt-fin-bank.kpp:label  in frame Dialog-Frame  = "КПП"
     1042   tt-fin-bank.cl-bank:list-item-pairs in frame Dialog-Frame = v-list-items
     1043   .
     1044   find first X_clients no-lock where
     1045               X_clients.obj-type = 'орг':U
     1046           AND X_clients.obj-code = p-host-code.
     1047     DISPLAY
     1048     X_clients.obj-name @  f-host-name
     1049      WITH FRAME Dialog-Frame.
     1050   case p-mode:
     1051     when 'ДОБАВЛЕНИЕ':U then do:
     1052       DISPLAY
     1053       p-host-code @ tt-fin-bank.host-code
     1054       ? @ tt-fin-bank.code-bank
     1055       WITH FRAME Dialog-Frame.
     1056     end.
     1057     otherwise do:
     1058       DISPLAY
     1059       tt-fin-bank.bank-city
     1060       tt-fin-bank.host-code
     1061       tt-fin-bank.code-bank
     1062       tt-fin-bank.addres
     1063       tt-fin-bank.addres1
     1064       tt-fin-bank.bank-name
     1065       tt-fin-bank.bik
     1066       tt-fin-bank.cor-acc
     1067       tt-fin-bank.e-mail
     1068       tt-fin-bank.fax
     1069       tt-fin-bank.inn
     1070       tt-fin-bank.kpp
     1071       tt-fin-bank.licenz
     1072       tt-fin-bank.okato
     1073       tt-fin-bank.okonx
     1074       tt-fin-bank.okpo
     1075       tt-fin-bank.phone
     1076       tt-fin-bank.PS
     1077       tt-fin-bank.rkc
     1078       tt-fin-bank.short-name
     1079       tt-fin-bank.cl-bank
     1080       WITH FRAME Dialog-Frame.
     1081     end.
     1082   END CASE.
     1083   if p-mode = 'ПРОСМОТР':U then do:
     1084   assign
     1085   b-quit:label = "&Выход"
     1086   .
     1087   hide
     1088   b-exit in frame Dialog-Frame.
     1089   end.
     1090   ENABLE
     1091   b-quit
     1092   B-exit when p-mode <> 'ПРОСМОТР':U
     1093   b-print when p-mode <> 'ДОБАВЛЕНИЕ':U
