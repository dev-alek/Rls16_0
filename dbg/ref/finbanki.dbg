     1142   tt-fin-bank.PS
     1143   tt-fin-bank.rkc
     1144   tt-fin-bank.short-name
     1145   tt-fin-bank.cl-bank
     1146   .
     1147   if not p-save then return .
     1148   run ref/finbank1.p (
     1149   input-output p-doc-rec
     1150   ,input p-mode
     1151   ,input no
     1152   ,input "bik"
     1153   ,input "":U
