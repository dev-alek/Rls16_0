     1175   ,input tt-fin-bank.cl-bank
     1176   )
     1177   no-error.
     1178   if error-status:error then do:
     1179   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   define variable fh as widget-handle no-undo .
     1181   define variable hh as widget-handle no-undo .
     1182   define variable rv as character no-undo .
     1183   assign
     1184   rv = entry(1, return-value , chr(4)).
     1185   if rv <> "":U then do:
     1186     assign
     1187     fh = frame Dialog-Frame:first-child
     1188     hh = fh:first-child
     1189     .
     1190     do while valid-handle(hh):
     1191       if hh:name = rv then do:
     1192         APPLY "ENTRY" to hh.
     1193         undo ,
     1194         return error.
     1195       end.
     1196       hh = hh:next-sibling.
     1197     end.
     1198   end.
     1199     undo, return error.
     1200   end.
     1201   END PROCEDURE.
