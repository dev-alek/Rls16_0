     1163   ,input tt-fin-bank.fax
     1164   ,input tt-fin-bank.inn
     1165   ,input tt-fin-bank.kpp
     1166   ,input tt-fin-bank.licenz
     1167   ,input tt-fin-bank.okato
     1168   ,input tt-fin-bank.okonx
     1169   ,input tt-fin-bank.okpo
     1170   ,input tt-fin-bank.otdel
