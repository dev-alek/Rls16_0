     1429                           , INPUT X_fin-bank.host-code
     1430                           , INPUT X_fin-bank.code-bank
     1431                           ) NO-ERROR.
     1432        IF ERROR-STATUS:ERROR
     1433        THEN DO:
     1434            message
     1435               vss-workfile vss-revision vss-description skip
     1436               "Ошибка при создании счета для инкассации" skip
     1437               error-status :get-message(1) skip
     1438               return-value skip
     1439               view-as alert-box error .
     1440            return no-apply.
     1441        END.
     1442     END.
     1443   END.
     1444   ON CHOOSE OF B-copy IN FRAME Dialog-Frame
