      700   procedure prn-lib-open-stream :
      701     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      702     define input parameter p-page-size    as integer no-undo .
      703     define input parameter p-is-stream    as logical no-undo .
      704     define input parameter p-append       as logical no-undo .
      705     define variable v-report-name as character no-undo .
      706     do
      707       on error undo, return error
      708       :
      709       run prn-lib-get-report-name  in this-procedure (
      710         input parParentProc
      711         ,output v-report-name
      712         ).
      713       if p-is-stream then
      714       do:
      715         if p-append then
      716         do:
      717           output stream PrnLibStream to value( v-report-name )
      718             page-size value(p-page-size) append .
      719         end.
      720         if not p-append then
      721         do:
      722           output stream PrnLibStream to value( v-report-name )
      723             page-size value(p-page-size) .
      724         end.
      725       end.
      726       if not p-is-stream then
      727       do:
      728         if p-append then
      729         do:
      730           output to value( v-report-name )
      731             page-size value(p-page-size) append .
      732         end.
      733         if not p-append then
      734         do:
      735           output to value( v-report-name )
      736             page-size value(p-page-size) .
      737         end.
      738       end.
      739     end.
      740   end procedure.
      741   procedure prn-lib-open-exp :
      742     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      743     define input parameter p-is-stream    as logical no-undo .
      744     define input parameter p-is-append    as logical no-undo .
      745     define output parameter p-ReportFileName as char init "report" no-undo.
      746     define output parameter p-process as logical no-undo .
      747     define variable glog as logical no-undo .
      748     do
      749       on error undo, return error
      750       :
      751       SYSTEM-DIALOG GET-FILE p-ReportFileName
      752         TITLE      "Укажите путь"
      753         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      754         ASK-OVERWRITE
      755         CREATE-TEST-FILE
      756         SAVE-AS
      757         USE-FILENAME
      758         DEFAULT-EXTENSION "txt"
      759         UPDATE glog
      760         .
      761       if not glog then  return.
      762       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      763       if p-is-stream then
      764       do:
      765         if p-is-append then
      766         do:
      767           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      768         end.
      769         else
      770         do:
      771           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      772         end.
      773       end.
      774       else
      775       do:
      776         if p-is-append then
      777         do:
      778           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      779         end.
      780         else
      781         do:
      782           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      783         end.
      784       end.
      785       p-process = yes.
      786     end.
      787   end procedure.
      788   procedure prn-lib-get-report-name :
      789     define input parameter parParentProc  as widget-handle no-undo.
      790     define output parameter p-report-name as character no-undo .
      791     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      792   end procedure.
      793   procedure prn-lib-reportviewer-report-name :
      794     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      795     define input parameter p-report-name-html as character no-undo .
      796     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
