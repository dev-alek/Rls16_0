     1288         mark-string(recid(X_fin-bank), v-rid-list) FORMAT "X(1)":U
     1289               WIDTH 1
     1290         X_fin-bank.host-code COLUMN-LABEL "Код!фирмы" FORMAT ">>>>>9999999999":U
     1291         X_fin-bank.code-bank COLUMN-LABEL "Код!банка" FORMAT "999999999":U
     1292         X_fin-bank.bank-name COLUMN-LABEL "Наименование банка" FORMAT "X(60)":U
     1293         X_fin-bank.bik FORMAT "X(9)":U
     1294         X_fin-bank.status_ FORMAT "X(8)":U
     1295     ENABLE
     1296         X_fin-bank.bik
     1297       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 14.38.
     1298   DEFINE FRAME Dialog-Frame
     1299        b-quit AT ROW 1 COL 1
     1300        B-mark AT ROW 1 COL 11
     1301        b-sel AT ROW 1 COL 21
     1302        B-add AT ROW 1 COL 31
     1303        B-lookup AT ROW 1 COL 41
     1304        B-chg AT ROW 1 COL 51
     1305        B-del AT ROW 1 COL 61
