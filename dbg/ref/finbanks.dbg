     1254        LABEL "Вы&бор"
     1255        SIZE 10 BY 1
     1256        BGCOLOR 8 .
     1257   DEFINE VARIABLE ED-notes AS CHARACTER
     1258        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1259        SIZE 98 BY 2
     1260        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1261   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1262         VIEW-AS TEXT
     1263        SIZE 6 BY 1
     1264        FGCOLOR 4  NO-UNDO.
     1265   DEFINE VARIABLE sch-BIK AS CHARACTER FORMAT "X(9)":U
     1266        LABEL "БИК"
     1267        VIEW-AS FILL-IN
     1268        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1269   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1270        LABEL "коду"
     1271        VIEW-AS FILL-IN
     1272        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1273   DEFINE VARIABLE sch-name AS CHARACTER FORMAT "X(35)":U
     1274        LABEL "нач.назван"
     1275        VIEW-AS FILL-IN
     1276        SIZE 41.88 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1277   DEFINE VARIABLE RS-status_ AS CHARACTER
     1278        VIEW-AS RADIO-SET HORIZONTAL
     1279        RADIO-BUTTONS
     1280             "Item 1", "1",
     1281   "Item 2", "2",
     1282   "Item 3", "3"
     1283        SIZE 33.5 BY 1 NO-UNDO.
     1284   DEFINE QUERY BR-bank FOR
     1285         X_fin-bank SCROLLING.
