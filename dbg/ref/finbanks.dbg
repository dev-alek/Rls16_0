     1307        B-print AT ROW 1 COL 86
     1308        B-hist AT ROW 1 COL 89
     1309        B-sch AT ROW 1 COL 92
     1310        B-Help AT ROW 1 COL 95
     1311        B-schet AT ROW 2 COL 51
     1312        B-copy AT ROW 2 COL 61
     1313        RS-status_ AT ROW 3 COL 1.5 NO-LABEL
     1314        BR-bank AT ROW 4.21 COL 1.38
     1315        ED-notes AT ROW 18.67 COL 1 NO-LABEL
     1316        sch-code AT ROW 20.79 COL 34 COLON-ALIGNED
     1317        sch-BIK AT ROW 20.83 COL 14.88 COLON-ALIGNED
     1318        sch-name AT ROW 20.83 COL 54 COLON-ALIGNED
     1319        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1320        "ПОИСК ПО" VIEW-AS TEXT
