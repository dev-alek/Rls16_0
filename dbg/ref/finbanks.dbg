     1454   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1455   DO:
     1456   define variable loc-doc-rec as recid no-undo .
     1457   define variable v-rid-list as character no-undo.
     1458     if NOT available X_fin-bank then do:
     1459       message
     1460       "Неправильно выбран банк."
     1461       view-as alert-box ERROR.
     1462       return no-apply.
     1463     end.
     1464     loc-doc-rec = recid (X_fin-bank).
     1465     .
     1466     run ref/fincbnks.w
     1467                   (
     1468                    input parParentProc
     1469                   ,input p-curr-host-code
     1470                   ,input "":U
     1471                   ,input "one":U
     1472                   ,input X_fin-bank.host-code
     1473                   ,input X_fin-bank.code-bank
     1474                   ,input-output v-rid-list
     1475                                 )
     1476     .
     1477     reposition br-bank to recid loc-doc-rec no-error.
     1478     apply "entry" to br-bank in frame Dialog-Frame.
     1479     apply "value-changed" to br-bank in frame Dialog-Frame.
     1480   END.
     1481   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1482   DO:
     1483   define variable loc-doc-rec as recid no-undo .
     1484     if NOT available X_fin-bank then do:
     1485       message
     1486       "Неправильно выбран банк."
     1487       view-as alert-box ERROR.
     1488       return no-apply.
     1489     end.
     1490     loc-doc-rec = recid (X_fin-bank).
     1491     .
     1492     run ref/finbanki.w
     1493                   (
     1494                    input parParentProc
     1495                   ,input p-curr-host-code
     1496                   ,input 'ПРОСМОТР':U
     1497                   ,input X_fin-bank.host-code
     1498                   ,input X_fin-bank.code-bank
     1499                   ,input-output loc-doc-rec
     1500                                 )
     1501     .
     1502     reposition br-bank to recid loc-doc-rec no-error.
     1503     apply "entry" to br-bank in frame Dialog-Frame.
     1504     apply "value-changed" to br-bank in frame Dialog-Frame.
     1505   END.
     1506   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1507   DO:
     1508   define variable loc#log as logical no-undo .
     1509     if available X_fin-bank then do:
     1510   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1511   define variable v-str-recid14 as character no-undo .
     1512   define variable v-num-entry14 as integer   no-undo .
     1513   assign
     1514     v-str-recid14 = trim( string( recid( X_fin-bank ) , "->>>>>>>>>>>9":U ) )
     1515     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1516   .
     1517   if v-num-entry14 > 0 then do:
     1518     assign
     1519       entry( v-num-entry14, v-rid-list ) = "":U
     1520       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1521     .
     1522   end.
     1523   else do:
     1524     assign
     1525       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1526     .
     1527   end.
     1528       loc#log = br-bank:refresh() .
     1529       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1530           loc#log = br-bank:select-next-row ().
     1531           apply "VALUE-CHANGED" to br-bank in frame Dialog-Frame.
     1532       end.
     1533       if num-entries( v-rid-list ) = 0
     1534       then
     1535           hide mark-num in frame Dialog-Frame.
     1536       else
     1537           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1538     end.
     1539     apply "entry" to br-bank in frame Dialog-Frame.
     1540   END.
     1541   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1542   DO:
     1543     if not avail X_fin-bank then return no-apply.
     1544     if print-option = '':U then do:
     1545           run gbl/pop-up.p (self:handle, no) no-error.
     1546     end.
     1547     if print-option = '':U then return no-apply.
     1548     run proc-b-print in this-procedure (input print-option) no-error.
     1549     if error-status:error then do:
     1550       print-option = '':U.
     1551       return no-apply.
     1552     end.
     1553     APPLY "ENTRY" to br-bank.
     1554   END.
     1555   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1556   DO:
     1557       run gbl/markqwa.p (
     1558                    input b-mark:sensitive
     1559                  , input v-rid-list) no-error.
     1560     if error-status:error then return no-apply.
     1561   END.
     1562   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1563   DO:
     1564     run proc-b-sch in this-procedure no-error.
     1565     if error-status:error then return no-apply.
     1566   END.
     1567   ON CHOOSE OF B-schet IN FRAME Dialog-Frame
     1568   DO:
     1569   define variable v-rid-list as character no-undo.
     1570   define variable v-status_ like ub.fin-schet.status_ no-undo init 'все':U.
     1571   if not available X_fin-bank then return no-apply.
     1572     run ref/finschts.w (
     1573                                   INPUT      parParentProc
     1574                                   ,p-curr-host-code
     1575                                   ,"b-add"
     1576                                   ,"bank":U
     1577                                   ,input "":U
     1578                                   ,input 0
     1579                                   ,input ?
     1580                                   ,input X_fin-bank.host-code
     1581                                   ,input X_fin-bank.code-bank
     1582                                   ,input-output v-status_
     1583                                   ,input-output v-rid-list
     1584                                   ) no-error.
     1585   if error-status:error then return no-apply.
     1586   END.
     1587   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1588   DO:
     1589     if ( available X_fin-bank ) then do:
     1590       if ( v-rid-list = "" ) or b-mark:sensitive = no then
     1591       v-rid-list = string( recid( X_fin-bank ) ) .
     1592     end.
     1593   END.
     1594   ON RETURN OF BR-bank IN FRAME Dialog-Frame
     1595   or MOUSE-SELECT-DBLCLICK OF Br-bank IN FRAME Dialog-Frame
     1596   DO:
     1597     run proc-br-bank no-error.
     1598     if error-status:error then return no-apply.
     1599   END.
     1600   ON VALUE-CHANGED OF BR-bank IN FRAME Dialog-Frame
     1601   DO:
     1602        DEFINE VARIABLE dops as character no-undo .
     1603     dops = if available X_fin-bank then X_fin-bank.ps else '':U.
     1604     ED-notes:screen-value = dops.
     1605   END.
     1606   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1607   DO:
     1608     define buffer ps_fin-bank for ub.fin-bank.
     1609     if not available X_fin-bank then return no-apply.
     1610      DO on stop undo, return no-apply:
     1611         FIND PS_fin-bank where
     1612              recid (ps_fin-bank) = recid(X_fin-bank) exclusive.
     1613         if ps_fin-bank.PS <> input frame Dialog-Frame ed-notes then
     1614         assign
     1615         ps_fin-bank.PS = input frame Dialog-Frame ed-notes
     1616         .
     1617      END.
     1618   END.
     1619   ON CHOOSE OF MENU-ITEM m_list
     1620   DO:
     1621      assign
     1622     print-option = 'LIST':U.
     1623     APPLY "CHOOSE" to b-print  in frame Dialog-Frame.
     1624   END.
     1625   ON CHOOSE OF MENU-ITEM m_one
     1626   DO:
     1627      assign
     1628     print-option = 'ONE':U.
     1629     APPLY "CHOOSE" to b-print  in frame Dialog-Frame.
     1630   END.
     1631   ON VALUE-CHANGED OF RS-status_ IN FRAME Dialog-Frame
     1632   DO:
     1633     ASSIGN
     1634     rs-status_
     1635     p-status_ = rs-status_
     1636     .
     1637     RUN openbr IN THIS-PROCEDURE ( input YES, input NO, input "":U) NO-ERROR.
     1638     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1639   END.
     1640   ON CTRL-J OF sch-BIK IN FRAME Dialog-Frame
     1641   DO:
     1642     run proc-find-bik in this-procedure(yes, input frame Dialog-Frame sch-bik) no-error.
     1643     if error-status:error then return no-apply.
     1644   END.
     1645   ON RETURN OF sch-BIK IN FRAME Dialog-Frame
     1646   DO:
     1647     run proc-find-bik in this-procedure(no, input frame Dialog-Frame sch-bik) no-error.
     1648     if error-status:error then return no-apply.
     1649   END.
     1650   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1651   DO:
     1652     run proc-find-code in this-procedure(yes, input frame Dialog-Frame sch-code) no-error.
     1653     if error-status:error then return no-apply.
     1654   END.
     1655   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1656   DO:
     1657     run proc-find-code in this-procedure(no, input frame Dialog-Frame sch-code) no-error.
     1658     if error-status:error then return no-apply.
     1659   END.
     1660   ON CTRL-J OF sch-name IN FRAME Dialog-Frame
     1661   DO:
     1662     run proc-find-name in this-procedure(yes, input frame Dialog-Frame sch-name) no-error.
     1663     if error-status:error then return no-apply.
     1664   END.
     1665   ON RETURN OF sch-name IN FRAME Dialog-Frame
     1666   DO:
     1667     run proc-find-name in this-procedure(no, input frame Dialog-Frame sch-name) no-error.
     1668     if error-status:error then return no-apply.
     1669   END.
     1670   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1671   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1672   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1673   on help of frame Dialog-Frame
     1674   do:
     1675     run gbl/app_help.p
     1676       (input this-procedure :file-name
     1677       ,input ''
     1678       ,input ?
     1679       ) no-error.
     1680     if error-status :error then do:
     1681       message
     1682         "Ошибка при вызове помощи"
     1683         error-status :get-message(1)
     1684         view-as alert-box .
     1685     end.
     1686   end.
     1687   run minbtn-set in this-procedure .
     1688   on choose of b-help in frame Dialog-Frame
     1689   do:
     1690     apply "help":u to frame Dialog-Frame .
     1691   end.
     1692   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   procedure minbtn-set :
     1694       do
     1695           on error undo, return error return-value
     1696           :
     1697           define variable ii              as integer       no-undo .
     1698           define variable fh              as widget-handle no-undo .
     1699           define variable hh              as widget-handle no-undo .
     1700           define variable v-h             as handle        extent 4 no-undo .
     1701           define variable v-name-button   as character     no-undo .
     1702           define variable v-help-old-x    as decimal       no-undo .
     1703           define variable v-help-old-y    as decimal       no-undo .
     1704           define variable v-help-old-size as decimal       no-undo .
     1705           define variable v-frame-width   as decimal       no-undo .
     1706           define variable jj              as integer       no-undo .
     1707           do
     1708               on error undo, return error
     1709               :
     1710               assign
     1711                   v-frame-width = frame Dialog-Frame:width - 0.3
     1712                   fh            = frame Dialog-Frame:first-child
     1713                   hh            = fh:first-child
     1714                   ii            = 1
     1715                   .
     1716               do while valid-handle(hh):
     1717                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1718                   do:
     1719                       case lc(hh:name) :
     1720                           when "b-help" then
     1721                               do:
     1722                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1723                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1724                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1725                                   hh:TOOLTIP = "Помощь" .
     1726                                   v-help-old-x = hh:column .
     1727                                   v-help-old-y = hh:row    .
     1728                                   v-help-old-size = hh:width .
     1729                                   hh:width-chars = 2.5 .
     1730                               end.
     1731                           when "b-print" then
     1732                               do:
     1733                                   hh:load-image("cmp/b-print.bmp":u) .
     1734                                   hh:TOOLTIP = "Печать" .
     1735                                   v-h[ii] = hh:handle .
     1736                                   ii = ii + 1 .
     1737                                   hh:width-chars = 3 .
     1738                               end.
     1739                           when "b-history" or
     1740                           when "b-hist" then
     1741                               do:
     1742                                   hh:load-image("cmp/b-hist.bmp":u) .
     1743                                   hh:TOOLTIP = "История" .
     1744                                   v-h[ii] = hh:handle .
     1745                                   ii = ii + 1 .
     1746                                   hh:width-chars = 3 .
     1747                               end.
     1748                           when "b-sch" then
     1749                               do:
     1750                                   hh:load-image("cmp/b-sch.bmp":u) .
     1751                                   hh:TOOLTIP = "Установка Фильтра" .
     1752                                   v-h[ii] = hh:handle .
     1753                                   ii = ii + 1 .
     1754                                   hh:width-chars = 3 .
     1755                               end.
     1756                           when "b-hist-user" then
     1757                               do:
     1758                                   hh:load-image("cmp/b-hist.bmp":u) .
     1759                                   hh:TOOLTIP = "История пользователя" .
     1760                                   ii = ii + 1 .
     1761                               end.
     1762                       end case.
     1763                   end.
     1764                   hh = hh:next-sibling.
     1765               end.
     1766               b-help:column = v-frame-width - b-help:width-chars.
     1767               jj = 0.
     1768               repeat ii = 4 to 1 by -1 :
     1769                   if valid-handle (v-h[ii] ) then
     1770                   do:
     1771                       jj  = jj + 1 .
     1772                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1773                       v-h[ii]:row    = v-help-old-y .
     1774                   end.
     1775               end.
     1776           end.
     1777       end.
     1778   end procedure.
     1779   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1780   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1781   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1782   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1783   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1784   define variable v-diasize-current-frame-height as decimal   no-undo .
     1785   define variable v-diasize-change-size          as logical   no-undo .
     1786   define variable v-diasize-resize-button        as handle    no-undo .
     1787   define variable v-diasize-wndmax               as logical   no-undo .
     1788   define variable v-diasize-wndstore             as logical   no-undo .
     1789   define variable v-diasize-proc-name            as character no-undo .
     1790   define variable v-diasize-browse-handle        as handle    no-undo .
     1791   define variable v-diasize-browse-number        as integer   no-undo .
     1792   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1793   define temp-table temp-diasize-handle no-undo
     1794     field handle-value  as handle
     1795     field save-position as decimal
     1796     index xpk is primary unique handle-value
     1797     .
     1798   define temp-table temp-browse-handle no-undo
     1799     field browse-type   as character
     1800     field browse-number as integer
     1801     field browse-handle as handle
     1802     field original-size as decimal
     1803     index xpk is primary unique browse-type browse-number
     1804     index xie browse-type browse-handle
     1805   .
     1806   procedure diasize_change-height :
     1807     define input  parameter p-change-value  as decimal   no-undo .
     1808     define input  parameter p-move-resize   as logical   no-undo .
     1809     define variable v-field-group-handle    as handle    no-undo .
     1810     define variable v-object-handle         as handle    no-undo .
     1811     define variable v-frame-height          as decimal   no-undo .
     1812     define variable v-frame-virtual-height  as decimal   no-undo .
     1813     define variable v-browse-height         as decimal   no-undo .
     1814     define variable v-window-height         as decimal   no-undo .
     1815     define variable v-window-virtual-height as decimal   no-undo .
     1816     define variable v-change-sign           as integer   no-undo .
     1817     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1818     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1819     if p-change-value > 0
     1820     then do:
     1821       if frame Dialog-Frame :height + p-change-value
     1822           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1823       then do:
     1824         assign
     1825           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1826                           - (frame Dialog-Frame :height-chars)
     1827         .
     1828         if p-change-value <= 0
     1829         then do:
     1830           run diasize_position-resize-button in this-procedure .
     1831           return .
     1832         end.
     1833       end.
     1834     end.
     1835     if p-change-value < 0
     1836     then do:
     1837       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1838       then do:
     1839         assign
     1840           p-change-value = v-diasize-orig-frame-height
     1841                          - (frame Dialog-Frame :height-chars)
     1842         .
     1843         if p-change-value >= 0
     1844         then do:
     1845           run diasize_position-resize-button in this-procedure .
     1846           return .
     1847         end.
     1848       end.
     1849     end.
     1850     if p-change-value >= 0
     1851     then do:
     1852       assign
     1853         v-change-sign = 1
     1854       .
     1855     end.
     1856     else do:
     1857       assign
     1858         v-change-sign = -1
     1859       .
     1860     end.
     1861     assign
     1862       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1863     .
     1864     if p-change-value = 0
     1865     then do:
     1866       run diasize_position-resize-button in this-procedure .
     1867       return .
     1868     end.
     1869     move_block:
     1870     do
     1871     on error undo move_block, retry move_block
     1872     :
     1873       if retry
     1874       then do:
     1875         do
     1876         on error undo move_block, leave move_block
     1877         :
     1878           if p-change-value > 0
     1879           then do:
     1880             for each buf_temp-diasize-handle
     1881             on error undo, next
     1882             :
     1883               assign
     1884                 v-object-handle = buf_temp-diasize-handle.handle-value
     1885               .
     1886               if v-object-handle <> v-diasize-resize-button
     1887               then do:
     1888                 assign
     1889                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1890                 .
     1891               end.
     1892             end.
     1893             assign
     1894               v-diasize-browse-handle :height = v-browse-height
     1895             .
     1896             for each buf_temp-browse-handle
     1897               where buf_temp-browse-handle.browse-type = 'height':u
     1898             on error undo, next
     1899             :
     1900               assign
     1901                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1902               .
     1903             end.
     1904             assign
     1905               frame Dialog-Frame :height = v-frame-height
     1906             .
     1907             if frame Dialog-Frame :scrollable = true
     1908             then do:
     1909               assign
     1910                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1911               .
     1912             end.
     1913             run diasize_position-resize-button in this-procedure .
     1914           end.
     1915           else do:
     1916             if frame Dialog-Frame :scrollable = true
     1917             then do:
     1918               assign
     1919                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1920               .
     1921             end.
     1922             assign
     1923               frame Dialog-Frame :height = v-frame-height
     1924             .
     1925             assign
     1926               v-diasize-browse-handle :height = v-browse-height
     1927             .
     1928             for each buf_temp-browse-handle
     1929               where buf_temp-browse-handle.browse-type = 'height':u
     1930             on error undo, next
     1931             :
     1932               assign
     1933                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1934               .
     1935             end.
     1936             for each buf_temp-diasize-handle
     1937             on error undo, next
     1938             :
     1939               assign
     1940                 v-object-handle = buf_temp-diasize-handle.handle-value
     1941               .
     1942               if v-object-handle <> v-diasize-resize-button
     1943               then do:
     1944                 assign
     1945                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1946                 .
     1947               end.
     1948             end.
     1949             run diasize_position-resize-button in this-procedure .
     1950           end.
     1951           assign
     1952             v-diasize-change-size = false
     1953           .
     1954           leave move_block .
     1955         end.
     1956       end.
     1957       assign
     1958         v-diasize-need-full-display = true
     1959       .
     1960       if v-diasize-change-size = false
     1961       then do:
     1962         assign
     1963           v-diasize-change-size = true
     1964         .
     1965       end.
     1966       else do:
     1967         return .
     1968       end.
     1969       assign
     1970         v-frame-height = frame Dialog-Frame :height
     1971         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1972         v-browse-height = v-diasize-browse-handle :height
     1973       .
     1974       for each buf_temp-browse-handle
     1975         where buf_temp-browse-handle.browse-type = 'height':u
     1976       :
     1977         assign
     1978           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1979         .
     1980       end.
     1981       for each buf_temp-diasize-handle
     1982       :
     1983         delete buf_temp-diasize-handle .
     1984       end.
     1985       assign
     1986         v-field-group-handle = frame Dialog-Frame :first-child
     1987       .
     1988       do while valid-handle(v-field-group-handle)
     1989       :
     1990         assign
     1991           v-object-handle = v-field-group-handle :first-child
     1992         .
     1993         do while valid-handle(v-object-handle)
     1994         :
     1995           if  v-object-handle <> v-diasize-browse-handle :handle
     1996           and can-query(v-object-handle, "row")
     1997           and can-query(v-object-handle, "height")
     1998           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1999           then do:
     2000             find first buf_temp-browse-handle
     2001               where buf_temp-browse-handle.browse-type   = 'height':u
     2002                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2003               no-error .
     2004             if available buf_temp-browse-handle
     2005             then do:
     2006             end.
     2007             else do:
     2008               create buf_temp-diasize-handle .
     2009               assign
     2010                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2011                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2012               .
     2013             end.
     2014           end.
     2015           assign
     2016             v-object-handle = v-object-handle :next-sibling
     2017           .
     2018         end.
     2019         assign
     2020           v-field-group-handle = v-field-group-handle :next-sibling
     2021         .
     2022       end.
     2023       do with frame Dialog-Frame
     2024       :
     2025         hide v-diasize-resize-button .
     2026         assign
     2027           v-diasize-resize-button :row    = 1
     2028           v-diasize-resize-button :column = 1
     2029         .
     2030       end.
     2031       if p-change-value > 0
     2032       then do:
     2033         if frame Dialog-Frame :scrollable = true
     2034         then do:
     2035           assign
     2036             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2037             no-error .
     2038           if error-status :error
     2039           or error-status :get-message(1) <> ""
     2040           then do:
     2041             undo move_block, retry move_block .
     2042           end.
     2043         end.
     2044         assign
     2045           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2046           no-error .
     2047         if error-status :error
     2048         or error-status :get-message(1) <> ""
     2049         then do:
     2050           undo move_block, retry move_block .
     2051         end.
     2052         assign
     2053           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2054           no-error .
     2055         if error-status :error
     2056         or error-status :get-message(1) <> ""
     2057         then do:
     2058           undo move_block, retry move_block .
     2059         end.
     2060         for each buf_temp-browse-handle
     2061           where buf_temp-browse-handle.browse-type = 'height':u
     2062         on error undo move_block, retry move_block
     2063         :
     2064           assign
     2065             buf_temp-browse-handle.browse-handle :height
     2066               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2067             no-error .
     2068           if error-status :error
     2069           or error-status :get-message(1) <> ""
     2070           then do:
     2071             undo move_block, retry move_block .
     2072           end.
     2073         end.
     2074         for each buf_temp-diasize-handle
     2075         on error undo move_block, retry move_block
     2076         :
     2077           assign
     2078             v-object-handle = buf_temp-diasize-handle.handle-value
     2079           .
     2080           if v-object-handle <> v-diasize-resize-button
     2081           then do:
     2082             assign
     2083               v-object-handle :row = v-object-handle :row + p-change-value
     2084               no-error .
     2085             if error-status :error
     2086             or error-status :get-message(1) <> ""
     2087             then do:
     2088               undo move_block, retry move_block .
     2089             end.
     2090           end.
     2091         end.
     2092       end.
     2093       else do:
     2094         for each buf_temp-diasize-handle
     2095         on error undo move_block, retry move_block
     2096         :
     2097           assign
     2098             v-object-handle = buf_temp-diasize-handle.handle-value
     2099           .
     2100           if v-object-handle <> v-diasize-resize-button
     2101           then do:
     2102             assign
     2103               v-object-handle :row = v-object-handle :row + p-change-value
     2104               no-error .
     2105             if error-status :error
     2106             or error-status :get-message(1) <> ""
     2107             then do:
     2108               undo move_block, retry move_block .
     2109             end.
     2110           end.
     2111         end.
     2112         assign
     2113           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2114           no-error .
     2115         if error-status :error
     2116         or error-status :get-message(1) <> ""
     2117         then do:
     2118           undo move_block, retry move_block .
     2119         end.
     2120         for each buf_temp-browse-handle
     2121           where buf_temp-browse-handle.browse-type = 'height':u
     2122         on error undo move_block, retry move_block
     2123         :
     2124           assign
     2125             buf_temp-browse-handle.browse-handle :height
     2126               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2127             no-error .
     2128           if error-status :error
     2129           or error-status :get-message(1) <> ""
     2130           then do:
     2131             undo move_block, retry move_block .
     2132           end.
     2133         end.
     2134         assign
     2135           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2136           no-error .
     2137         if error-status :error
     2138         or error-status :get-message(1) <> ""
     2139         then do:
     2140           undo move_block, retry move_block .
     2141         end.
     2142         if frame Dialog-Frame :scrollable = true
     2143         then do:
     2144           assign
     2145             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2146             no-error .
     2147           if error-status :error
     2148           or error-status :get-message(1) <> ""
     2149           then do:
     2150             undo move_block, retry move_block .
     2151           end.
     2152         end.
     2153       end.
     2154       if p-move-resize = true
     2155       then do:
     2156         run diasize_position-resize-button in this-procedure .
     2157       end.
     2158       if v-diasize-wndstore = true
     2159       then do:
     2160         if connected("ub") = true
     2161         then do:
     2162           define variable v-cntxt-db-num        as integer   no-undo .
     2163           define variable v-cntxt-userid        as character no-undo .
     2164           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2165                                             , OUTPUT v-cntxt-userid
     2166                                             ) .
     2167           run gbl/wndsizew.p
     2168             (input  v-cntxt-db-num
     2169             ,input  v-cntxt-userid
     2170             ,input  v-diasize-proc-name
     2171             ,input  'height':u
     2172             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2173             ) .
     2174         end.
     2175       end.
     2176     end.
     2177     assign
     2178       v-diasize-change-size = false
     2179     .
     2180   end procedure.
     2181   procedure diasize_set-height :
     2182     define input  parameter p-new-height  as decimal   no-undo .
     2183     define input  parameter p-move-resize as logical   no-undo .
     2184     do
     2185     on error undo, return error return-value
     2186     :
     2187       run diasize_change-height in this-procedure
     2188         (input  (p-new-height - frame Dialog-Frame :height)
     2189         ,input  p-move-resize
     2190         ) .
     2191     end.
     2192   end procedure.
     2193   procedure diasize_change-width :
     2194     define input  parameter p-change-value as decimal   no-undo .
     2195     define input  parameter p-move-resize  as logical   no-undo .
     2196     define variable v-field-group-handle   as handle    no-undo .
     2197     define variable v-object-handle        as handle    no-undo .
     2198     define variable v-frame-width          as decimal   no-undo .
     2199     define variable v-frame-virtual-width  as decimal   no-undo .
     2200     define variable v-browse-width         as decimal   no-undo .
     2201     define variable v-window-width         as decimal   no-undo .
     2202     define variable v-window-virtual-width as decimal   no-undo .
     2203     define variable v-change-sign          as integer   no-undo .
     2204     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2205     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2206     if p-change-value > 0
     2207     then do:
     2208       if frame Dialog-Frame :width + p-change-value >
     2209           session :width-chars
     2210       then do:
     2211         assign
     2212           p-change-value = session :width-chars - frame Dialog-Frame :width
     2213         .
     2214         if p-change-value <= 0
     2215         then do:
     2216           run diasize_position-resize-button in this-procedure .
     2217           return .
     2218         end.
     2219       end.
     2220     end.
     2221     if p-change-value < 0
     2222     then do:
     2223       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2224       then do:
     2225         assign
     2226           p-change-value = v-diasize-orig-frame-width
     2227                          - frame Dialog-Frame :width
     2228         .
     2229         if p-change-value >= 0
     2230         then do:
     2231           run diasize_position-resize-button in this-procedure .
     2232           return .
     2233         end.
     2234       end.
     2235     end.
     2236     if p-change-value >= 0
     2237     then do:
     2238       assign
     2239         v-change-sign = 1
     2240       .
     2241     end.
     2242     else do:
     2243       assign
     2244         v-change-sign = -1
     2245       .
     2246     end.
     2247     assign
     2248       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2249     .
     2250     if p-change-value = 0
     2251     then do:
     2252       run diasize_position-resize-button in this-procedure .
     2253       return .
     2254     end.
     2255     move_block:
     2256     do
     2257     on error undo move_block, leave move_block
     2258     :
     2259       if retry
     2260       then do:
     2261         do
     2262         on error undo move_block, leave move_block
     2263         :
     2264           if p-change-value > 0
     2265           then do:
     2266             for each buf_temp-diasize-handle
     2267             on error undo, next
     2268             :
     2269               assign
     2270                 v-object-handle = buf_temp-diasize-handle.handle-value
     2271               .
     2272               if v-object-handle <> v-diasize-resize-button
     2273               then do:
     2274                 assign
     2275                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2276                 .
     2277               end.
     2278             end.
     2279             assign
     2280               v-diasize-browse-handle :width = v-browse-width
     2281             .
     2282             for each buf_temp-browse-handle
     2283               where buf_temp-browse-handle.browse-type = 'width':u
     2284             on error undo, next
     2285             :
     2286               assign
     2287                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2288               .
     2289             end.
     2290             assign
     2291               frame Dialog-Frame :width = v-frame-width
     2292             .
     2293             if frame Dialog-Frame :scrollable = true
     2294             then do:
     2295               assign
     2296                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2297               .
     2298             end.
     2299             run diasize_position-resize-button in this-procedure .
     2300           end.
     2301           else do:
     2302             if frame Dialog-Frame :scrollable = true
     2303             then do:
     2304               assign
     2305                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2306               .
     2307             end.
     2308             assign
     2309               frame Dialog-Frame :width = v-frame-width
     2310             .
     2311             for each buf_temp-browse-handle
     2312               where buf_temp-browse-handle.browse-type = 'width':u
     2313             on error undo, next
     2314             :
     2315               assign
     2316                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2317               .
     2318             end.
     2319             assign
     2320               v-diasize-browse-handle :width = v-browse-width
     2321             .
     2322             for each buf_temp-diasize-handle
     2323             on error undo, next
     2324             :
     2325               assign
     2326                 v-object-handle = buf_temp-diasize-handle.handle-value
     2327               .
     2328               if v-object-handle <> v-diasize-resize-button
     2329               then do:
     2330                 assign
     2331                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2332                 .
     2333               end.
     2334             end.
     2335             run diasize_position-resize-button in this-procedure .
     2336           end.
     2337           assign
     2338             v-diasize-change-size = false
     2339           .
     2340           leave move_block .
     2341         end.
     2342       end.
     2343       assign
     2344         v-diasize-need-full-display = true
     2345       .
     2346       if v-diasize-change-size = false
     2347       then do:
     2348         assign
     2349           v-diasize-change-size = true
     2350         .
     2351       end.
     2352       else do:
     2353         return .
     2354       end.
     2355       assign
     2356         v-frame-width = frame Dialog-Frame :width
     2357         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2358         v-browse-width = v-diasize-browse-handle :width
     2359       .
     2360       for each buf_temp-browse-handle
     2361         where buf_temp-browse-handle.browse-type = 'width':u
     2362       :
     2363         assign
     2364           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2365         .
     2366       end.
     2367       for each buf_temp-diasize-handle
     2368       :
     2369         delete buf_temp-diasize-handle .
     2370       end.
     2371       assign
     2372         v-field-group-handle = frame Dialog-Frame :first-child
     2373       .
     2374       do while valid-handle(v-field-group-handle)
     2375       :
     2376         assign
     2377           v-object-handle = v-field-group-handle :first-child
     2378         .
     2379         do while valid-handle(v-object-handle)
     2380         :
     2381           if  v-object-handle <> v-diasize-browse-handle :handle
     2382           and v-object-handle <> v-diasize-resize-button
     2383           and can-query(v-object-handle, "row")
     2384           and can-query(v-object-handle, "height")
     2385           and ( v-object-handle :col + v-object-handle :width
     2386                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2387               )
     2388           then do:
     2389             find first buf_temp-browse-handle
     2390               where buf_temp-browse-handle.browse-type   = 'width':u
     2391                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2392               no-error .
     2393             if available buf_temp-browse-handle
     2394             then do:
     2395             end.
     2396             else do:
     2397               create buf_temp-diasize-handle .
     2398               assign
     2399                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2400                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2401               .
     2402             end.
     2403           end.
     2404           assign
     2405             v-object-handle = v-object-handle :next-sibling
     2406           .
     2407         end.
     2408         assign
     2409           v-field-group-handle = v-field-group-handle :next-sibling
     2410         .
     2411       end.
     2412       do with frame Dialog-Frame
     2413       :
     2414         hide v-diasize-resize-button .
     2415         v-diasize-resize-button :row = 1.
     2416         v-diasize-resize-button :column = 1.
     2417       end.
     2418       if p-change-value > 0
     2419       then do:
     2420         if frame Dialog-Frame :scrollable = true
     2421         then do:
     2422           assign
     2423             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2424             no-error .
     2425           if error-status :error
     2426           or error-status :get-message(1) <> ""
     2427           then do:
     2428             undo move_block, retry move_block.
     2429           end.
     2430         end.
     2431         assign
     2432           frame Dialog-Frame :width = v-frame-width + p-change-value
     2433           no-error .
     2434         if error-status :error
     2435         or error-status :get-message(1) <> ""
     2436         then do:
     2437           undo move_block, retry move_block.
     2438         end.
     2439         assign
     2440           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2441         no-error .
     2442         if error-status :error
     2443         or error-status :get-message(1) <> ""
     2444         then do:
     2445           undo move_block, retry move_block.
     2446         end.
     2447         for each buf_temp-browse-handle
     2448           where buf_temp-browse-handle.browse-type = 'width':u
     2449         on error undo move_block, retry move_block
     2450         :
     2451           assign
     2452             buf_temp-browse-handle.browse-handle :width
     2453               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2454             no-error .
     2455           if error-status :error
     2456           or error-status :get-message(1) <> ""
     2457           then do:
     2458             undo move_block, retry move_block .
     2459           end.
     2460         end.
     2461         for each buf_temp-diasize-handle
     2462         on error undo move_block, retry move_block
     2463         :
     2464           assign
     2465             v-object-handle = buf_temp-diasize-handle.handle-value
     2466           .
     2467           if v-object-handle <> v-diasize-resize-button
     2468           then do:
     2469             assign
     2470               v-object-handle :col = v-object-handle :col + p-change-value
     2471               no-error .
     2472             if error-status :error
     2473             or error-status :get-message(1) <> ""
     2474             then do:
     2475               undo move_block, retry move_block .
     2476             end.
     2477           end.
     2478         end.
     2479       end.
     2480       else do:
     2481         for each buf_temp-diasize-handle
     2482         on error undo move_block, retry move_block
     2483         :
     2484           assign
     2485             v-object-handle = buf_temp-diasize-handle.handle-value
     2486           .
     2487           if v-object-handle <> v-diasize-resize-button
     2488           then do:
     2489             assign
     2490               v-object-handle :col = v-object-handle :col + p-change-value
     2491               no-error .
     2492             if error-status :error
     2493             or error-status :get-message(1) <> ""
     2494             then do:
     2495               undo move_block, retry move_block .
     2496             end.
     2497           end.
     2498         end.
     2499         for each buf_temp-browse-handle
     2500           where buf_temp-browse-handle.browse-type = 'width':u
     2501         on error undo move_block, retry move_block
     2502         :
     2503           assign
     2504             buf_temp-browse-handle.browse-handle :width
     2505               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2506             no-error .
     2507           if error-status :error
     2508           or error-status :get-message(1) <> ""
     2509           then do:
     2510             undo move_block, retry move_block .
     2511           end.
     2512         end.
     2513         assign
     2514           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2515           no-error .
     2516         if error-status :error
     2517         or error-status :get-message(1) <> ""
     2518         then do:
     2519           undo move_block, retry move_block.
     2520         end.
     2521         assign
     2522           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2523         no-error .
     2524         if error-status :error
     2525         or error-status :get-message(1) <> ""
     2526         then do:
     2527           undo move_block, retry move_block.
     2528         end.
     2529         if frame Dialog-Frame :scrollable = true
     2530         then do:
     2531           assign
     2532             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2533           no-error .
     2534           if error-status :error
     2535           or error-status :get-message(1) <> ""
     2536           then do:
     2537             undo move_block, retry move_block.
     2538           end.
     2539         end.
     2540       end.
     2541       if p-move-resize
     2542       then do:
     2543         run diasize_position-resize-button in this-procedure .
     2544       end.
     2545       if v-diasize-wndstore = true
     2546       then do:
     2547         if connected("ub") = true
     2548         then do:
     2549           define variable v-cntxt-db-num        as integer   no-undo .
     2550           define variable v-cntxt-userid        as character no-undo .
     2551           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2552                                             , OUTPUT v-cntxt-userid
     2553                                             ) .
     2554           run gbl/wndsizew.p
     2555             (input  v-cntxt-db-num
     2556             ,input  v-cntxt-userid
     2557             ,input  v-diasize-proc-name
     2558             ,input  'width':u
     2559             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2560             ) .
     2561         end.
     2562       end.
     2563     end.
     2564     assign
     2565       v-diasize-change-size = false
     2566     .
     2567   end procedure.
     2568   procedure diasize_set-width :
     2569     define input  parameter p-new-width  as decimal   no-undo .
     2570     define input  parameter p-move-resize as logical   no-undo .
     2571     do
     2572     on error undo, return error return-value
     2573     :
     2574       run diasize_change-width in this-procedure
     2575         (input  (p-new-width - frame Dialog-Frame :width)
     2576         ,input  p-move-resize
     2577         ) .
     2578     end.
     2579   end procedure.
     2580   procedure diasize_position-resize-button :
     2581     do with frame Dialog-Frame
     2582     :
     2583       hide v-diasize-resize-button .
     2584       assign
     2585         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2586                     - 1
     2587                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2588         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2589                     - 1
     2590                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2591       .
     2592       view v-diasize-resize-button .
     2593     end.
     2594   end procedure.
     2595   on alt-right anywhere
     2596   do:
     2597     run diasize_change-width in this-procedure
     2598       (input 1
     2599       ,input true
     2600       ) .
     2601     return no-apply .
     2602   end.
     2603   on alt-left anywhere
     2604   do:
     2605     run diasize_change-width in this-procedure
     2606       (input -1
     2607       ,input true
     2608       ) .
     2609     return no-apply .
     2610   end.
     2611   on alt-down anywhere
     2612   do:
     2613     run diasize_change-height in this-procedure
     2614       (input 1
     2615       ,input true
     2616       ) .
     2617     return no-apply .
     2618   end.
     2619   on alt-up anywhere
     2620   do:
     2621     run diasize_change-height in this-procedure
     2622       (input -1
     2623       ,input true
     2624       ) .
     2625     return no-apply .
     2626   end.
     2627   on alt-enter of frame Dialog-Frame
     2628   do:
     2629     run diasize_maximize in this-procedure
     2630       (input  ?
     2631       ).
     2632     return no-apply .
     2633   end.
     2634   procedure diasize_end-move :
     2635     do
     2636     on error undo, return error return-value
     2637     :
     2638       define variable v-row-delta as decimal   no-undo .
     2639       define variable v-col-delta as decimal   no-undo .
     2640       define variable v-new-row as decimal   no-undo .
     2641       define variable v-new-col as decimal   no-undo .
     2642       assign
     2643         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2644         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2645       .
     2646       assign
     2647         v-row-delta = v-new-row - frame Dialog-Frame :height
     2648         v-col-delta = v-new-col - frame Dialog-Frame :width
     2649       .
     2650       run diasize_change-height in this-procedure
     2651         (input v-row-delta
     2652         ,input true
     2653         ) .
     2654       run diasize_change-width in this-procedure
     2655         (input v-col-delta
     2656         ,input true
     2657         ) .
     2658     end.
     2659   end procedure.
     2660   procedure diasize_maximize :
     2661     define input  parameter p-action as logical   no-undo .
     2662     do
     2663     on error undo, return error return-value
     2664     :
     2665       if p-action = ?
     2666       then do:
     2667         if v-diasize-need-maximize = true
     2668         then do:
     2669           assign
     2670             p-action = true
     2671           .
     2672         end.
     2673         else do:
     2674           assign
     2675             p-action = false
     2676           .
     2677         end.
     2678       end.
     2679       if p-action = true
     2680       then do:
     2681         run diasize_change-height in this-procedure
     2682           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2683               - frame Dialog-Frame :height-chars
     2684           ,input true
     2685           ) .
     2686         run diasize_change-width in this-procedure
     2687           (input session :width-chars
     2688               - frame Dialog-Frame :width-chars
     2689           ,input true
     2690           ) .
     2691         assign
     2692           v-diasize-need-maximize = false
     2693         .
     2694       end.
     2695       else do:
     2696         run diasize_change-width in this-procedure
     2697           (input v-diasize-orig-frame-width
     2698               - frame Dialog-Frame :width-chars
     2699           ,input true
     2700           ) .
     2701         run diasize_change-height in this-procedure
     2702           (input v-diasize-orig-frame-height
     2703               - frame Dialog-Frame :height-chars
     2704           ,input true
     2705           ) .
     2706         assign
     2707           v-diasize-need-maximize = true
     2708         .
     2709       end.
     2710     end.
     2711   end procedure.
     2712   procedure diasize_restore-orig-size :
     2713     do
     2714     on error undo, return error return-value
     2715     :
     2716       assign
     2717         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2718         v-diasize-current-frame-height = frame Dialog-Frame :height
     2719       .
     2720       run diasize_set-height in this-procedure
     2721         (input  v-diasize-orig-frame-height
     2722         ,input  true
     2723         ) .
     2724       run diasize_set-width in this-procedure
     2725         (input  v-diasize-orig-frame-width
     2726         ,input  true
     2727         ) .
     2728     end.
     2729   end procedure.
     2730   procedure diasize_restore-current-size :
     2731     do
     2732     on error undo, return error return-value
     2733     :
     2734       run diasize_set-height in this-procedure
     2735         (input  v-diasize-current-frame-height
     2736         ,input  true
     2737         ) .
     2738       run diasize_set-width in this-procedure
     2739         (input  v-diasize-current-frame-width
     2740         ,input  true
     2741         ) .
     2742     end.
     2743   end procedure.
     2744   procedure diasize_set-browse-handle :
     2745     define input  parameter p-browse-handle as handle   no-undo .
     2746     define buffer buf_temp-browse-handle for temp-browse-handle .
     2747     do
     2748     on error undo, return error return-value
     2749     :
     2750       assign
     2751         v-diasize-browse-handle = p-browse-handle
     2752       .
     2753       for each buf_temp-browse-handle
     2754       on error undo, return error return-value
     2755       :
     2756         delete buf_temp-browse-handle .
     2757       end.
     2758     end.
     2759   end procedure.
     2760   procedure diasize_add_browse :
     2761     define input  parameter p-browse-type   as character no-undo .
     2762     define input  parameter p-browse-handle as handle    no-undo .
     2763     define buffer buf_temp-browse-handle for temp-browse-handle .
     2764     do
     2765     on error undo, return error return-value
     2766     :
     2767       assign
     2768         v-diasize-browse-number = v-diasize-browse-number + 1
     2769       .
     2770       create buf_temp-browse-handle .
     2771       assign
     2772         buf_temp-browse-handle.browse-type   = p-browse-type
     2773         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2774         buf_temp-browse-handle.browse-handle = p-browse-handle
     2775       .
     2776     end.
     2777   end procedure.
     2778   procedure diasize_init :
     2779     define variable v-default-value    as logical   no-undo .
     2780     define variable v-restore-saved    as logical   no-undo .
     2781     define variable v-resize-value-str as character no-undo .
     2782     do
     2783     on error undo, return error return-value
     2784     :
     2785       do with frame Dialog-Frame
     2786       :
     2787         assign
     2788           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2789           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2790           v-diasize-browse-handle     = browse BR-bank :handle
     2791         .
     2792         create button v-diasize-resize-button
     2793         assign
     2794           parent        = frame Dialog-Frame :first-child
     2795           label         = "s"
     2796           height-pixels = 16
     2797           width-pixels  = 16
     2798           visible       = true
     2799           sensitive     = true
     2800           movable       = true
     2801           triggers:
     2802             on end-move persistent run diasize_end-move in this-procedure .
     2803           end triggers.
     2804         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2805         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2806         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2807         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2808         assign
     2809           v-diasize-wndmax = false
     2810         .
     2811         if connected("ub") = true
     2812         then do:
     2813           define variable v-cntxt-db-num        as integer   no-undo .
     2814           define variable v-cntxt-userid        as character no-undo .
     2815           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2816                                             , OUTPUT v-cntxt-userid
     2817                                             ) .
     2818           run gbl/wndpar_r.p
     2819             (input  v-cntxt-db-num
     2820             ,input  v-cntxt-userid
     2821             ,input  'wndmax':U
     2822             ,output v-diasize-wndmax
     2823             ,output v-default-value
     2824             ) .
     2825         end.
     2826         assign
     2827           v-diasize-wndstore = false
     2828         .
     2829         if connected("ub") = true
     2830         then do:
     2831           run gbl/wndpar_r.p
     2832             (input  v-cntxt-db-num
     2833             ,input  v-cntxt-userid
     2834             ,input  'wndstore':U
     2835             ,output v-diasize-wndstore
     2836             ,output v-default-value
     2837             ) .
     2838         end.
     2839         assign
     2840           v-diasize-proc-name = entry(1, program-name(2), '.')
     2841         .
     2842         if v-diasize-wndstore = true
     2843         then do:
     2844           assign
     2845             v-restore-saved = false
     2846           .
     2847           if connected("ub") = true
     2848           then do:
     2849             run gbl/wndsizer.p
     2850               (input  v-cntxt-db-num
     2851               ,input  v-cntxt-userid
     2852               ,input  v-diasize-proc-name
     2853               ,input  'height':u
     2854               ,output v-resize-value-str
     2855               ) .
     2856             if v-resize-value-str <> '':U
     2857             then do:
     2858               run diasize_change-height in this-procedure
     2859                 (input  integer(v-resize-value-str)
     2860                 ,input  true
     2861                 ) .
     2862               assign
     2863                 v-restore-saved = true
     2864               .
     2865             end.
     2866           end.
     2867           if connected("ub") = true
     2868           then do:
     2869             run gbl/wndsizer.p
     2870               (input  v-cntxt-db-num
     2871               ,input  v-cntxt-userid
     2872               ,input  v-diasize-proc-name
     2873               ,input  'width':u
     2874               ,output v-resize-value-str
     2875               ) .
     2876             if v-resize-value-str <> '':U
     2877             then do:
     2878               run diasize_change-width in this-procedure
     2879                 (input  integer(v-resize-value-str)
     2880                 ,input  true
     2881                 ) .
     2882               assign
     2883                 v-restore-saved = true
     2884               .
     2885             end.
     2886           end.
     2887           if v-restore-saved <> true
     2888           then do:
     2889             if v-diasize-wndmax = true
     2890             then do:
     2891               run diasize_maximize in this-procedure
     2892                 (input  true
     2893                 ) .
     2894             end.
     2895           end.
     2896         end.
     2897         else do:
     2898           if v-diasize-wndmax = true
     2899           then do:
     2900             run diasize_maximize in this-procedure
     2901               (input  true
     2902               ) .
     2903           end.
     2904         end.
     2905       end.
     2906     end.
     2907   end procedure.
     2908   procedure diasize_need-full-display :
     2909     define output parameter p-need-full-display as logical   no-undo .
     2910     do
     2911     on error undo, return error return-value
     2912     :
     2913       assign
     2914         p-need-full-display = v-diasize-need-full-display
     2915       .
     2916       assign
     2917         v-diasize-need-full-display = false
     2918       .
     2919     end.
     2920   end procedure.
     2921   procedure get-context :
     2922      define output parameter p-db-num as integer          no-undo.
     2923      define output parameter p-user-id as character        no-undo.
     2924      define variable v-login               as character    no-undo.
     2925      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2926      define buffer buf_user-login  for ub.user-login .
     2927      do
     2928      on error undo, return error
     2929      :
     2930            FIND FIRST buf_sys-ctrl no-lock.
     2931            ASSIGN
     2932               v-login = USERID("ub")
     2933               p-db-num = buf_sys-ctrl.db-num
     2934            .
     2935            FIND FIRST buf_user-login
     2936                 WHERE buf_user-login.db-num = p-db-num
     2937                   AND buf_user-login.user-login = v-login
     2938                 no-lock
     2939                 no-error
     2940                 .
     2941            IF AVAILABLE buf_user-login
     2942            THEN DO:
     2943               assign
     2944                  p-user-id = buf_user-login.user-id
     2945               .
     2946            END.
     2947      end.
     2948   end procedure.
     2949       run diasize_init in this-procedure .
     2950   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2951   procedure set-filter-name :
     2952   define input parameter p-filter-name as character no-undo .
