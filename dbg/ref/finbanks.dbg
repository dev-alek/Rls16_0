      798   procedure prn-lib-reportviewer :
      799     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      800     define input parameter p-report-name-html as character no-undo .
      801     define input parameter p-param        as character no-undo .
      802     define variable v-excel           as character no-undo init 'TRUE' .
      803     define variable v-value-character as character no-undo .
      804     define variable v-value-integer   as character no-undo .
      805     define variable v-value-date      as date      no-undo .
      806     define variable v-value-decimal   as decimal   no-undo .
      807     define variable rep-excel         as logical   no-undo .
      808     define variable excel-string      as character no-undo .
      809     define variable v-param-type      as character no-undo .
      810     define variable v-tth             as handle    no-undo .
      811     run adm/shattri.p (
      812       input "get":U
      813       ,input  ""
      814       ,input  0
      815       ,input  'report-glob':U
      816       ,input  'rep-excel':U
      817       ,output v-value-character
      818       ,output v-value-date
      819       ,output v-value-decimal
      820       ,output v-value-integer
      821       ,output rep-excel
      822       ,output v-param-type
      823       ,INPUT-OUTPUT table-handle v-tth
      824       )  .
      825     if rep-excel then v-excel = "TRUE" .
      826     else v-excel = "FALSE" .
      827     if p-param eq ""
      828     then
      829        p-param = "EXCEL:" + v-excel.
      830     else
      831        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      832     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      833   end procedure.
      834   function diff-list returns character (
      835     input parfirst-list  as character,
      836     input parsecond-list as character,
      837     input pardelim       as character).
      838     if pardelim = ""
      839     or pardelim = ?
      840     then do:
      841       assign
      842         pardelim = ","
      843       .
      844     end.
      845     def var ind as integer no-undo .
      846     def var v-elem as character no-undo .
      847     def var v-result-list as character no-undo init "".
      848     def var v-num-parfirst-list as integer no-undo .
      849     assign
      850       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      851     .
      852     do ind = 1 to v-num-parfirst-list
      853     :
      854       assign
      855         v-elem = entry(ind, parfirst-list, pardelim)
      856       .
      857       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      858         assign
      859           v-result-list = v-result-list
      860                         + (if v-result-list > "" then pardelim else "")
      861                         + v-elem
      862         .
      863       end.
      864     end.
      865     return v-result-list .
      866   end function.
      867   function add-list returns character (
      868    input parfirst-list  as character,
      869    input parsecond-list as character,
      870    input pardelim       as character).
      871     if pardelim = ""
      872     or pardelim = ?
      873     then do:
      874       assign
      875         pardelim = ","
      876       .
      877     end.
      878     def var ind as integer no-undo .
      879     def var v-elem as character no-undo .
      880     def var v-result-list as character no-undo init "".
      881     def var v-num-parfirst-list as integer no-undo .
      882     assign
      883       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      884     .
      885     do ind = 1 to v-num-parfirst-list
      886     :
      887       assign
      888         v-elem = entry(ind, parfirst-list, pardelim)
      889       .
      890       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      891         assign
      892           v-result-list = v-result-list
      893                         + (if v-result-list > "" then pardelim else "")
      894                         + v-elem
      895         .
      896       end.
      897     end.
      898     def var v-num-parsecond-list as integer no-undo .
      899     assign
      900       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      901     .
      902     do ind = 1 to v-num-parsecond-list
      903     :
      904       assign
      905         v-elem = entry(ind, parsecond-list, pardelim)
      906       .
      907       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      908         assign
      909           v-result-list = v-result-list
      910                         + (if v-result-list > "" then pardelim else "")
      911                         + v-elem
      912         .
      913       end.
      914     end.
      915     return v-result-list .
      916   end function.
      917   function cross-list returns character (
      918    input parfirst-list  as character,
      919    input parsecond-list as character,
      920    input pardelim       as character).
      921     if pardelim = ""
      922     or pardelim = ?
      923     then do:
      924       assign
      925         pardelim = ","
      926       .
      927     end.
      928     def var ind as integer no-undo .
      929     def var v-elem as character no-undo .
      930     def var v-result-list as character no-undo init "".
      931     def var v-num-parfirst-list as integer no-undo .
      932     assign
      933       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      934     .
      935     do ind = 1 to v-num-parfirst-list
      936     :
      937       assign
      938         v-elem = entry(ind, parfirst-list, pardelim)
      939       .
      940       if lookup(v-elem, v-result-list, pardelim) = 0
      941       and lookup(v-elem, parsecond-list, pardelim) > 0
      942       then do:
      943         assign
      944           v-result-list = v-result-list
      945                         + (if v-result-list > "" then pardelim else "")
      946                         + v-elem
      947         .
      948       end.
      949     end.
      950     return v-result-list .
      951   end function.
      952   function radio-label returns character (
      953    input par-rs-value  as character,
      954    input par-rs-radio-buttons as character)
      955    .
      956    DEFINE variable v-result-label as character no-undo.
      957    assign
      958    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      959                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      960                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      961                             ), par-rs-radio-buttons
      962                           )
      963    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      964    .
      965   return v-result-label.
      966   end function.
      967   function m-radio-label returns character (
      968    input par-rs-value  as character,
      969    input par-rs-radio-buttons as character,
      970    input par-delim as character
      971    )
      972    .
      973    DEFINE variable v-result-label as character no-undo.
      974    assign
      975    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      976                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      977                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      978                             ), par-rs-radio-buttons, par-delim
      979                           )
      980    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      981    .
      982   return v-result-label.
      983   end function.
      984   FUNCTION mixlist returns character
      985   (
      986    input parfirst-list  as character
      987    ,input parsecond-list as character
      988    ,input pardelim       as character
      989    ,input pardelim-result as character ) :
      990     if pardelim = ""
      991     or pardelim = ?
      992     then do:
      993       assign
      994         pardelim = ","
      995       .
      996     end.
      997     def var ind as integer no-undo .
      998     def var v-elem1 as character no-undo .
      999     def var v-elem2 as character no-undo .
     1000     def var v-result-list as character no-undo init "".
     1001     do ind = 1 to num-entries(parfirst-list, pardelim)
     1002     :
     1003       assign
     1004         v-elem1 = entry(ind, parfirst-list, pardelim)
     1005         v-elem2 = entry(ind, parsecond-list, pardelim)
     1006       .
     1007         assign
     1008           v-result-list = v-result-list
     1009                         + (if v-result-list > "" then pardelim-result else "")
     1010                         + v-elem1 + pardelim-result + v-elem2
     1011         .
     1012     end.
     1013     return v-result-list .
     1014   END FUNCTION.
