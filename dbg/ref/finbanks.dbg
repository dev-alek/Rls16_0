     1339   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1340   DO:
     1341   define variable loc#log as logical no-undo.
     1342   define variable loc-doc-rec as recid no-undo .
     1343   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1344   do:
     1345     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1346       (input  v-cntxt-db-num
     1347       ,input  v-cntxt-userid
     1348       ,input  0
     1349       ,input  'actn_fin-bank-accounts_add-def':U
     1350       ,input  'firm':U
     1351       ,input  p-curr-host-code
     1352       ,input  '':U
     1353       ,input  0
     1354       ,input  0
     1355       ,input  0
     1356       ,input  0
     1357       ,input  true
     1358       ,output loc#log
     1359       )  .
     1360   end.
     1361   if not loc#log then return no-apply.
     1362   run ref/finbanki.w
     1363                 (
     1364                    input parParentProc
     1365                   ,input p-curr-host-code
     1366                   ,input 'ДОБАВЛЕНИЕ':U
     1367                   ,input p-curr-host-code
     1368                   ,input 0
     1369                   ,input-output loc-doc-rec
     1370                               )
     1371   .
     1372   if loc-doc-rec <> ? then do:
     1373     RUn OpenBR in this-procedure ( input yes, input no, Input "").
     1374     reposition br-bank to recid loc-doc-rec no-error.
     1375     if error-status:error then do:                           find first pos_fin-bank no-lock where                                   recid(pos_fin-bank) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи БАНК" skip                            string(if avail pos_fin-bank                                     then  substitute("Код фирмы: &1, вн. код банка &2"                                                     , pos_fin-bank.host-code                                                      , pos_fin-bank.code-bank)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1376   end.
     1377   apply "entry" to br-bank in frame Dialog-Frame.
     1378   apply "value-changed" to br-bank in frame Dialog-Frame.
     1379   END.
     1380   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1381   DO:
     1382   define variable loc#log as logical no-undo.
     1383   define variable loc-doc-rec as recid no-undo .
     1384   if not available X_fin-bank then return no-apply.
     1385   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1386   do:
     1387     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1388       (input  v-cntxt-db-num
     1389       ,input  v-cntxt-userid
     1390       ,input  0
     1391       ,input  'actn_fin-bank-accounts_update':U
     1392       ,input  'firm':U
     1393       ,input  p-curr-host-code
     1394       ,input  '':U
     1395       ,input  0
     1396       ,input  0
     1397       ,input  0
     1398       ,input  0
     1399       ,input  true
     1400       ,output loc#log
     1401       )  .
     1402   end.
     1403   if not loc#log then return no-apply.
     1404   assign
     1405   loc-doc-rec = recid(X_fin-bank).
     1406   run ref/finbanki.w
     1407                 (
     1408                    input parParentProc
     1409                   ,input p-curr-host-code
     1410                   ,input 'ИЗМЕНЕНИЕ':U
     1411                   ,input X_fin-bank.host-code
     1412                   ,input X_fin-bank.code-bank
     1413                   ,input-output loc-doc-rec
     1414                               )
     1415   .
     1416   if loc-doc-rec <> ? then do:
     1417     RUn OpenBR in this-procedure ( input yes, input no, input "").
     1418     reposition br-bank to recid loc-doc-rec no-error.
     1419     if error-status:error then do:                           find first pos_fin-bank no-lock where                                   recid(pos_fin-bank) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи БАНК" skip                            string(if avail pos_fin-bank                                     then  substitute("Код фирмы: &1, вн. код банка &2"                                                     , pos_fin-bank.host-code                                                      , pos_fin-bank.code-bank)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1420   end.
     1421   apply "entry" to br-bank in frame Dialog-Frame.
     1422   apply "value-changed" to br-bank in frame Dialog-Frame.
     1423   END.
     1424   ON CHOOSE OF b-collect IN FRAME Dialog-Frame
     1425   DO:
     1426     IF AVAILABLE X_fin-bank
     1427     THEN DO:
