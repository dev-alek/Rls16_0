     4244   PROCEDURE proc-br-bank :
     4245   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4246   if b-sel:sensitive in frame Dialog-Frame then dO:
     4247       if b-mark:sensitive then do:
     4248           apply "choose" to b-mark in frame Dialog-Frame.
     4249       end.
     4250       else do:
     4251           apply "choose" to b-sel in frame Dialog-Frame.
     4252       end.
     4253   end.
     4254   else do:
     4255       if b-lookup:sensitive then
     4256       apply "choose" to b-lookup in frame Dialog-Frame.
     4257   end.
     4258   END PROCEDURE.
     4259   PROCEDURE proc-copy :
     4260   define variable p-fin-code as integer no-undo .
     4261   define variable p-out-host-code like ub.sysconf.host-code no-undo.
     4262   define variable firm-rid-list as char no-undo.
     4263   define variable p-ok as logical no-undo .
     4264   define variable ii as integer no-undo .
     4265   define variable Jj as integer no-undo .
     4266   define variable kk as integer no-undo .
     4267   define variable p-ret as logical no-undo .
     4268   define variable glog as logical no-undo.
     4269   define variable v-out-host-code like ub.sysconf.host-code no-undo .
     4270   define variable v-recid-schet as recid no-undo.
     4271   define variable v-recid-bank as recid no-undo.
     4272   define variable v-new-rid-list as character no-undo .
     4273   define variable v-final-rid-list as character no-undo .
     4274   define variable v-stay-doc-rec as recid no-undo.
     4275   define buffer buf_sysconf  for ub.sysconf.
     4276   define buffer buf_fin-bank for ub.fin-bank.
     4277   define buffer buf2_fin-bank for ub.fin-bank.
     4278   define variable vss-include-info34 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4279   do:
     4280     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4281       (input  v-cntxt-db-num
     4282       ,input  v-cntxt-userid
     4283       ,input  0
     4284       ,input  'actn_fin-bank-accounts_add-copy':U
     4285       ,input  'firm':U
     4286       ,input  p-host-code
     4287       ,input  '':U
     4288       ,input  0
     4289       ,input  0
     4290       ,input  0
     4291       ,input  0
     4292       ,input  true
     4293       ,output glog
     4294       )  .
     4295   end.
     4296   if not glog then  return .
     4297   assign
     4298   v-stay-doc-rec = recid(X_fin-bank)
     4299   .
     4300   if num-entries(v-rid-list) = 0 then do:
     4301     message
     4302     "Не отмечены записи для копирования !!!"
     4303     view-as alert-box error.
     4304     return error.
     4305   end.
     4306   run adm/sconfs.w (
     4307                  input parparentproc
     4308                , input "b-mark,b-sel":U
     4309                , input no
     4310                , input p-curr-host-code
     4311                , output v-out-host-code
     4312                , input-output firm-rid-list) .
     4313   if num-entries(firm-rid-list) = 0 then do:
     4314    message "Не выбрана фирмы для копирования !!!" .
     4315    return error.
     4316   end.
     4317   message
     4318   "Вы отметили " num-entries(firm-rid-list) " фирмы. " skip
     4319   "Скопировать выбранные банки в эти фирмы ?"
     4320   view-as alert-box question
     4321   buttons yes-no
     4322   update p-ok.
     4323   kk = 0.
     4324   if p-ok = false then return.
     4325   _ii:
     4326   repeat ii = 1 to num-entries(firm-rid-list) :
     4327     find first buf_sysconf no-lock where
     4328               recid(buf_sysconf) = integer(entry(ii, firm-rid-list)) no-error .
     4329     if not available buf_sysconf then next _ii.
     4330     if buf_sysconf.host-code = p-host-code then do:
     4331       message
     4332       "Нельзя скопировать банки в свою собственную фирму" buf_sysconf.host-code
     4333       view-as alert-box error .
     4334       next _ii.
     4335     end.
     4336     if buf_sysconf.firm-db-num <> X_sysconf.firm-db-num then do:
     4337       message
     4338       "Нельзя скопировать банки на фирму" buf_sysconf.host-code  skip
     4339       "Текущая БД " v-db-num "Главная БД данной фирмы" buf_sysconf.firm-db-num
     4340       view-as alert-box error .
     4341       next _ii.
     4342     end.
     4343   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4344   do:
     4345     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4346       (input  v-cntxt-db-num
     4347       ,input  v-cntxt-userid
     4348       ,input  0
     4349       ,input  'actn_fin-bank-accounts_add-copy':U
     4350       ,input  'firm':U
     4351       ,input  buf_sysconf.host-code
     4352       ,input  '':U
     4353       ,input  0
     4354       ,input  0
     4355       ,input  0
     4356       ,input  0
     4357       ,input  false
     4358       ,output glog
     4359       )  .
     4360   end.
     4361     if not glog then do:
     4362       message
     4363       "Нельзя скопировать банки на фирму" buf_sysconf.host-code  skip
     4364       "У Вас нет прав на добавление банков и банковских счетов в фирме" buf_sysconf.host-code
     4365       view-as alert-box error .
     4366       next _ii.
     4367     end.
     4368     _rr:
     4369     repeat jj = 1 to num-entries(v-rid-list) :
     4370       for each buf_fin-bank where
     4371             recid(buf_fin-bank) =  integer(entry(jj, v-rid-list)):
     4372         if buf_fin-bank.status_ = 'удал':U then do:
     4373           message
     4374           "Нельзя скопировать банк" buf_fin-bank.code-bank "на фирму" buf_sysconf.host-code  skip
     4375           "Банк имеет статус" 'удал':U "в фирме" p-host-code
     4376           view-as alert-box error .
     4377           assign
     4378           v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(jj, v-rid-list)
     4379           .
     4380           next _rr.
     4381         end.
     4382         find first buf2_fin-bank no-lock where
     4383                   buf2_fin-bank.host-code = buf_sysconf.host-code
     4384               AND buf2_fin-bank.bik = buf_fin-bank.bik
     4385               AND buf2_fin-bank.cor-acc = buf_fin-bank.cor-acc no-error .
     4386         if not available buf2_fin-bank then do:
     4387           assign
     4388           v-recid-bank = ?.
     4389           run ref/finbank1.p (
     4390           input-output v-recid-bank
     4391           ,input 'ДОБАВЛЕНИЕ':U
     4392           ,input no
     4393           ,input "bik"
     4394           ,input "":U
     4395           ,input buf_sysconf.host-code
     4396           ,input 0
     4397           ,input buf_fin-bank.addres
     4398                   ,input buf_fin-bank.bank-city
     4399           ,input buf_fin-bank.addres1
     4400           ,input buf_fin-bank.bank-name
     4401           ,input buf_fin-bank.bik
     4402           ,input buf_fin-bank.cor-acc
     4403           ,input buf_fin-bank.e-mail
     4404           ,input buf_fin-bank.fax
     4405           ,input buf_fin-bank.inn
     4406           ,input buf_fin-bank.kpp
     4407           ,input buf_fin-bank.licenz
     4408           ,input buf_fin-bank.okato
     4409           ,input buf_fin-bank.okonx
     4410           ,input buf_fin-bank.okpo
     4411           ,input buf_fin-bank.otdel
     4412           ,input buf_fin-bank.phone
     4413           ,input (substitute("@Копирование с фирмы &1@ &2", p-host-code, buf_fin-bank.PS))
     4414           ,input buf_fin-bank.rkc
     4415           ,input buf_fin-bank.short-name
     4416           ,input buf_fin-bank.cl-bank
     4417           )
     4418           no-error.
     4419           if error-status:error then do:
     4420             assign
     4421             v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(jj, v-rid-list)
     4422             .
     4423             next _rr.
     4424           end.
     4425           find first buf2_fin-bank no-lock where
     4426                     recid(buf2_fin-bank) = v-recid-bank no-error.
     4427           if available buf2_fin-bank then do:
     4428             assign
     4429             kk = kk + 1
     4430             .
     4431           end.
     4432         end.
     4433       end.
     4434     end.
     4435     assign
     4436     v-final-rid-list = cross-list(v-rid-list, v-new-rid-list, chr(44))
     4437     .
     4438   end.
     4439   v-rid-list = v-final-rid-list.
     4440   run OpenBr in this-procedure ( input yes, input no, input '':U).
     4441   reposition br-bank to recid v-stay-doc-rec no-error.
     4442   message
     4443   "Скопировано " kk  "записей" view-as alert-box .
     4444   END PROCEDURE.
     4445   PROCEDURE proc-find-bik :
     4446   define input parameter p-next as logical no-undo.
     4447   define input parameter p-bik like ub.fin-bank.bik no-undo.
     4448   display
     4449   "0":U @ sch-code
     4450   "":U @ sch-name
     4451   with frame Dialog-Frame.
     4452   assign
     4453   p-bik = replace(p-bik, chr(34), "":U)
     4454   p-bik = replace(p-bik, chr(39), chr(39) + chr(39))
     4455   p-bik = chr(34) + p-bik + chr(34).
     4456   run OpenBr in this-procedure
     4457       (input false
     4458       ,input p-next
     4459       ,input substitute("and X_fin-bank.bik   begins &1 "
     4460         , p-bik)
     4461       ).
     4462   apply "entry":u to sch-bik in frame Dialog-Frame .
     4463   END PROCEDURE.
     4464   PROCEDURE proc-find-code :
     4465   define input parameter p-next as logical no-undo.
     4466   define input parameter p-code-bank like ub.fin-bank.code-bank no-undo.
     4467   define variable v-code-bank as character no-undo.
     4468   display
     4469   "":U @ sch-BIK
     4470   "":U @ sch-name
     4471   with frame Dialog-Frame.
     4472   assign
     4473   v-code-bank = string(p-code-bank).
     4474   run OpenBr in this-procedure
     4475       (input false
     4476       ,input p-next
     4477       ,input substitute("and X_fin-bank.code-bank = &1 "
     4478         , v-code-bank)
     4479       ).
     4480   apply "entry":u to sch-code in frame Dialog-Frame .
     4481   END PROCEDURE.
     4482   PROCEDURE proc-find-name :
     4483   define input parameter p-next as logical no-undo.
     4484   define input parameter p-name as character no-undo.
     4485   display
     4486   "0":U @ sch-code
     4487   "":U @ sch-bik
     4488   with frame Dialog-Frame.
     4489   assign
     4490   p-name = replace(p-name, chr(34), chr(34) + chr(34))
     4491   p-name = replace(p-name, chr(39), chr(39) + chr(39))
     4492   p-name = chr(34) + p-name + chr(34).
     4493   run OpenBr in this-procedure
     4494       (input false
     4495       ,input p-next
     4496       ,input substitute("and X_fin-bank.bank-name begins &1 "
     4497         , p-name)
     4498       ).
     4499   apply "entry":u to sch-name in frame Dialog-Frame .
     4500   END PROCEDURE.
     4501   PROCEDURE proc-print-list :
     4502   define variable v-doc-rec as recid no-undo .
     4503   define variable accum-count as integer.
     4504   define variable date_string     as      char    no-undo.
     4505   define variable Line            as      char    no-undo.
     4506   DEFINE FRAME fin-bank-list
     4507   X_fin-bank.host-code COLUMN-LABEL "Код!фирмы"  format ">>>>>>>>>>9"
     4508   X_fin-bank.code-bank COLUMN-LABEL "Код банка"  format ">>>>>>>>>>9"
     4509   X_fin-bank.bank-name format "X(160)"
     4510   X_fin-bank.status_
     4511   X_fin-bank.BIK
     4512   HEADER  date_string AT 5 format "X(35)"
     4513    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4514   Line format "X(195)" AT 1
     4515   with width 232 down stream-io use-text    .
     4516   Line = fill("-", 195).
     4517   date_string = cur-time-print() .
     4518   run prn-lib-open-stream  in this-procedure (
     4519                                                input parParentProc
     4520                                               ,input 43
     4521                                               ,input yes
     4522                                               ,input no
     4523                                               ).
     4524   PUT  STREAM PrnLibStream
     4525   SPACE(25) ( frame Dialog-Frame:title )
     4526   format "x(90)" SKIP(1) .
     4527   FORM HEADER
     4528   Line format "X(195)" AT 1 SKIP
     4529   "Продолжение - на следующей странице" AT 30 SKIP
     4530   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4531   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4532   FORM with FRAME fin-bank-list  .
     4533   run waitfram-show in this-procedure ("Ждите...").
     4534   v-doc-rec = recid(X_fin-bank).
     4535   DO WHILE available X_fin-bank :
     4536     GET prev br-bank.
     4537   END.
     4538   GET next br-bank.
     4539   DO WHILE available X_fin-bank :
     4540     Display STREAM PrnLibStream
     4541     X_fin-bank.host-code
     4542     X_fin-bank.code-bank
     4543     X_fin-bank.bank-name
     4544     X_fin-bank.status_
     4545     X_fin-bank.BIK
     4546     with FRAME fin-bank-list .
     4547     DOWN STREAM PrnLibStream 1
     4548     with FRAME fin-bank-list  .
     4549     assign
     4550     accum-count = accum-count + 1
     4551     .
     4552     GET next br-bank.
     4553   END.
     4554   UNDERLINE  STREAM PrnLibStream
     4555   X_fin-bank.host-code
     4556   X_fin-bank.code-bank
     4557   X_fin-bank.bank-name
     4558   X_fin-bank.status_
     4559   X_fin-bank.BIK
     4560   with FRAME fin-bank-list .
     4561   DISPLAY STREAM PrnLibStream
     4562   "ИТОГО" @ X_fin-bank.host-code
     4563   accum-count @ X_fin-bank.code-bank
     4564   with frame fin-bank-list.
     4565   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4566   HIDE  STREAM PrnLibStream FRAME fin-bank-List.
     4567   output  STREAM PrnLibStream CLOSE.
     4568   REPOSITION br-bank to recid v-doc-rec no-error.
     4569   APPLY "entry" to br-bank.
     4570   run waitfram-hide in this-procedure .
     4571   run prn-lib-prn-file in this-procedure (
     4572                                             input parParentProc
     4573                                             ,input 8
     4574                                             ).
     4575   END PROCEDURE.
     4576   PROCEDURE proc-print-one :
     4577   if not available X_fin-bank then return error.
     4578   run ref/finbankp.p (
     4579                    INPUT parParentProc
     4580                    ,input X_fin-bank.host-code
     4581                    ,input X_fin-bank.code-bank
     4582                 ) no-error.
     4583   if error-status:error then do:
     4584     return error.
     4585   end.
     4586   END PROCEDURE.
