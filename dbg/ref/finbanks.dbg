     1025   FUNCTION mark-string RETURNS CHARACTER
     1026     ( input p-recid as recid, input mark-list as character  ) :
     1027     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1028   END FUNCTION.
     1029   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1031   procedure fltopend_fltopend :
     1032   define input parameter p-parent-handle as handle no-undo .
     1033   define input parameter p-qh as handle no-undo .
     1034   define input parameter p-flt-open-open-query  as character no-undo .
     1035   define input parameter p-where-cond as character no-undo .
     1036   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1037   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1038   define input parameter p-indexed-reposition as character no-undo .
     1039     do
     1040     on error undo, return error
     1041     :
     1042   define variable v-prepare-string as character no-undo .
     1043   define variable glog as logical no-undo .
     1044   assign
     1045   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1046                      p-where-cond + chr(32)  +
     1047                      p-use-indFIRST-query-tail + chr(32) +
     1048                      p-use-ind-sort-clmn-by + chr(32) +
     1049                      p-indexed-reposition
     1050   .
     1051   assign
     1052   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1053   if not glog
     1054   or error-status:error then do:
     1055     message error-status:get-message(1) view-as alert-box .
     1056     undo, return error .
     1057   end.
     1058   assign
     1059   glog = p-qh:query-open no-error .
     1060   if not glog
     1061   or error-status:error then do:
     1062     message error-status:get-message(1) view-as alert-box .
     1063     undo, return error .
     1064   end.
     1065     end.
     1066   end procedure.
     1067   procedure fltopend_fltfindd :
     1068   define input parameter p-parent-handle as handle no-undo .
     1069   define input parameter p-qh as handle no-undo .
     1070   define input parameter p-rowid as rowid no-undo .
     1071   define input parameter p-next as logical no-undo .
     1072   define input parameter p-lock as integer no-undo .
     1073   define input parameter p-bh as handle no-undo .
     1074   define input parameter p-where-cond as character no-undo .
     1075   define input parameter p-use-index-phrase as character no-undo .
     1076   define variable glog as logical no-undo .
     1077   define variable v-qh as handle no-undo .
     1078   define variable v-bh as handle no-undo .
     1079   define variable v-recid as recid no-undo .
     1080   define variable v-prepare-string as character no-undo .
     1081   do
     1082   on error undo, return error
     1083   on stop undo, return error
     1084   :
     1085     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1086     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1087     create query v-qh.
     1088     v-qh:set-buffers(v-bh).
     1089     v-prepare-string = substitute("for each &1 &2 &3"
     1090                                     ,v-bh:name
     1091                                     ,p-where-cond
     1092                                     ,p-use-index-phrase).
     1093     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1094     if not glog then do:
     1095       delete object v-qh.
     1096       delete object v-bh.
     1097       undo, return error .
     1098     end.
     1099     glog = v-qh:query-open no-error .
     1100     if not glog then do:
     1101       delete object v-qh.
     1102       delete object v-bh.
     1103       undo, return error .
     1104     end.
     1105     if p-next then do:
     1106       v-qh:reposition-to-rowid(p-rowid) no-error .
     1107       glog = v-qh:get-next( p-lock) no-error .
     1108       glog = v-qh:get-next( p-lock) no-error .
     1109       if not glog or v-qh:query-off-end = yes then do:
     1110         glog = v-qh:get-first( p-lock) no-error .
     1111       end.
     1112     end.
     1113     else do:
     1114       glog = v-qh:get-first( p-lock) no-error .
     1115     end.
     1116     v-recid = v-bh:recid no-error .
     1117     delete object v-qh.
     1118     delete object v-bh.
     1119     return string(v-recid) .
     1120   end.
     1121   end procedure.
     1122   procedure fltopend_fltfindq :
     1123   define input parameter p-parent-handle as handle no-undo .
     1124   define input parameter p-qh as handle no-undo .
     1125   define input parameter p-next as logical no-undo .
     1126   define input parameter p-lock as integer no-undo .
     1127   define input parameter p-flt-open-open-query  as character no-undo .
     1128   define input parameter p-where-cond as character no-undo .
     1129   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1130   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1131   define input parameter p-indexed-reposition as character no-undo .
     1132   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1133   define variable glog as logical no-undo .
     1134   define variable v-qh as handle no-undo .
     1135   define variable v-bh as handle no-undo extent 18.
     1136   define variable v-rowid as rowid no-undo extent 18.
     1137   define variable v-ii as integer no-undo .
     1138   define variable v-prepare-string as character no-undo .
     1139   do
     1140   on error undo, return error
     1141   on stop undo, return error
     1142   :
     1143     create query v-qh.
     1144     do v-ii = 1 to p-qh:num-buffers:
     1145       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1146       assign
     1147       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1148       no-error.
     1149       v-qh:add-buffer(v-bh[v-ii]).
     1150     end.
     1151     assign
     1152     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1153                       p-where-cond + chr(32)  +
     1154                       p-use-indFIRST-query-tail + chr(32) +
     1155                       p-use-ind-sort-clmn-by + chr(32) +
     1156                       p-indexed-reposition
     1157     .
     1158     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1159     if not glog then do:
     1160       delete object v-qh.
     1161       do v-ii = 1 to p-qh:num-buffers:
     1162         delete object v-bh[v-ii].
     1163       end.
     1164       undo, return error .
     1165     end.
     1166     glog = v-qh:query-open no-error .
     1167     if not glog then do:
     1168       delete object v-qh.
     1169       do v-ii = 1 to p-qh:num-buffers:
     1170         delete object v-bh[v-ii].
     1171       end.
     1172       undo, return error .
     1173     end.
     1174     if p-next then do:
     1175       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1176       glog = v-qh:get-next( p-lock) no-error .
     1177       glog = v-qh:get-next( p-lock) no-error .
     1178       if not glog or v-qh:query-off-end = yes then do:
     1179         glog = v-qh:get-first( p-lock) no-error .
     1180       end.
     1181     end.
     1182     else do:
     1183       glog = v-qh:get-first( p-lock) no-error .
     1184     end.
     1185     do v-ii = 1 to p-qh:num-buffers:
     1186       assign
     1187       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1188       no-error.
     1189     end.
     1190     delete object v-qh.
     1191     do v-ii = 1 to p-qh:num-buffers:
     1192       delete object v-bh[v-ii].
     1193     end.
     1194   end.
     1195   end procedure.
     1196   define variable filter-point as character no-undo init "Список банков" .
