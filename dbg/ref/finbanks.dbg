     4114   PROCEDURE proc-b-del :
     4115   define variable loc#log as logical no-undo.
     4116   define variable v-status_ like ub.fin-bank.status_ no-undo .
     4117   define variable loc-doc-rec as recid no-undo .
     4118   if not available X_fin-bank then return error.
     4119   do
     4120   on error undo, return error
     4121   on stop undo, return error
     4122   :
     4123   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4124   do:
     4125     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4126       (input  v-cntxt-db-num
     4127       ,input  v-cntxt-userid
     4128       ,input  0
     4129       ,input  'actn_fin-bank-accounts_deletion':U
     4130       ,input  'firm':U
     4131       ,input  p-curr-host-code
     4132       ,input  '':U
     4133       ,input  0
     4134       ,input  0
     4135       ,input  0
     4136       ,input  0
     4137       ,input  true
     4138       ,output loc#log
     4139       )  .
     4140   end.
     4141   if not loc#log then return error.
     4142     assign
     4143     v-status_ = "":U
     4144     loc-doc-rec = recid(X_fin-bank)
     4145     .
     4146     run ref/finbank2.p (
     4147                     input recid(X_fin-bank)
     4148                     ,input-output v-status_
     4149                    ) no-error .
     4150     if error-status:error then undo, return error.
     4151     if v-status_ <> p-status_ then do:
     4152       RUn OpenBR in this-procedure ( input yes, input no, input no).
     4153       reposition br-bank to recid loc-doc-rec no-error.
     4154       if error-status:error then do:                           find first pos_fin-bank no-lock where                                   recid(pos_fin-bank) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи БАНК" skip                            string(if avail pos_fin-bank                                     then  substitute("Код фирмы: &1, вн. код банка &2"                                                     , pos_fin-bank.host-code                                                      , pos_fin-bank.code-bank)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     4155     end.
     4156     else do:
     4157       display
     4158       X_fin-bank.status_
     4159       with browse br-bank.
     4160     end.
     4161   end.
     4162   END PROCEDURE.
     4163   PROCEDURE proc-b-print :
     4164   DEFINE INPUT PARAMETER loc-option as character no-undo.
     4165   if loc-option = '':U then return error.
     4166   CASE loc-option:
     4167   when 'ONE':U then do:
     4168     run proc-print-one in this-procedure .
     4169   end.
     4170   when 'LIST':U then do:
     4171     run proc-print-list no-error.
     4172   end.
     4173   end case.
     4174   loc-option = ''.
     4175   END PROCEDURE.
