     2961         .
     2962       end.
     2963       else do:
     2964         assign
     2965           b-sch :tooltip = ""
     2966         .
     2967       end.
     2968     end.
     2969   end procedure.
     2970   def var sort-labelBR-bank   as character no-undo .
     2971   def var sort-clmnBR-bank    as handle    no-undo .
     2972   def var cur-clmnBR-bank     as handle    no-undo .
     2973   def var cur-clmn-locBR-bank as integer   no-undo .
     2974   def var re-queryBR-bank     as logical   initial no no-undo .
     2975   on start-search, ctrl-o of BR-bank in frame Dialog-Frame do:
     2976      run sort-brBR-bank
     2977        (input (if available X_fin-bank
     2978                then recid(X_fin-bank)
     2979                else ?
     2980               )
     2981        ).
     2982   end.
     2983   PROCEDURE sort-brBR-bank :
     2984     define input parameter p-recid as recid no-undo .
     2985     if re-queryBR-bank = no then do:
     2986       assign
     2987          cur-clmnBR-bank = BR-bank:current-column in frame Dialog-Frame
     2988       .
     2989       if sort-clmnBR-bank <> ? then sort-clmnBR-bank:column-fgcolor = 0.
     2990       if cur-clmnBR-bank = sort-clmnBR-bank then do:
     2991         assign
     2992            sort-labelBR-bank = ""
     2993            sort-clmnBR-bank = ?
     2994         .
     2995        end.
     2996        else do:
     2997          assign
     2998            sort-labelBR-bank = cur-clmnBR-bank:label
     2999            sort-clmnBR-bank  = cur-clmnBR-bank
     3000            sort-clmnBR-bank:column-fgcolor = 4
     3001          .
     3002        end.
     3003      end.
     3004     assign
     3005       cur-clmn-locBR-bank = 1
     3006     .
     3007     def var column-handle as handle no-undo .
     3008     column-handle = BR-bank:first-column.
     3009     do while valid-handle(column-handle) :
     3010       if column-handle = cur-clmnBR-bank then do:
     3011         leave .
     3012       end.
     3013       column-handle = column-handle:NEXT-COLUMN.
     3014       assign
     3015         cur-clmn-locBR-bank = cur-clmn-locBR-bank + 1
     3016       .
     3017     end.
     3018     case sort-labelBR-bank:
     3019           when X_fin-bank.bank-name:label in browse BR-bank then DO:    assign       sort-column-name = "X_fin-bank.bank-name"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     3020           when X_fin-bank.bik:label in browse BR-bank then DO:    assign       sort-column-name = "X_fin-bank.bik"     .     run OpenBr in this-procedure ( input yes, input no, input '').   . END.
     3021       otherwise do:
     3022         assign
     3023           sort-column-name = ""
     3024         .
     3025         run OpenBr in this-procedure ( input yes, input no, input '').
     3026           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-bank') then do:
     3027             run mv-brw-defaultBR-bank.
     3028           end.
     3029         if sort-labelBR-bank <> "" then do:
     3030           assign
     3031             cur-clmnBR-bank:column-fgcolor = 0
     3032           .
     3033         end.
     3034         assign
     3035           cur-clmn-locBR-bank = ?
     3036         .
     3037       end.
     3038     end case.
     3039       if cur-clmn-locBR-bank <> ? then do:
     3040         if can-do( this-procedure:internal-entries, 'ch-clmnBR-bank') then do:
     3041           run ch-clmnBR-bank in this-procedure (cur-clmn-locBR-bank).
     3042         end.
     3043       end.
     3044     if p-recid <> ? then do:
     3045       reposition BR-bank to recid p-recid no-error.
     3046       apply "value-changed" to BR-bank in frame Dialog-Frame.
     3047     end.
     3048     apply "entry" to BR-bank in frame Dialog-Frame.
     3049   END PROCEDURE.
     3050   procedure re-open-query-srt-clmnBR-bank:
     3051   if cur-clmnBR-bank = ? then do:
     3052      run OpenBr in this-procedure ( input yes, input no, input '').
     3053   end.
     3054   else do:
     3055      assign re-queryBR-bank = yes.
     3056      run sort-brBR-bank
     3057        (input (if available X_fin-bank
     3058                then recid(X_fin-bank)
     3059                else ?
     3060               )
     3061        ).
     3062      assign re-queryBR-bank = no.
     3063   end.
     3064   end.
     3065   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3066   do:
     3067     BR-bank :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3068   end.
     3069   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3070   on f5 of frame Dialog-Frame anywhere
     3071   do:
     3072     v-doc-rec = recid(X_fin-bank). run OpenBr in this-procedure ( input yes, input no, input '':U). reposition br-bank to recid v-doc-rec no-error. v-doc-rec = ?.
     3073       apply "VALUE-CHANGED" to BR-bank.
     3074   end.
     3075   MAIN-BLOCK:
     3076   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3077      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3078   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3079     run mainmenu_getcntxt in parparentproc
     3080       (output v-cntxt-db-num
     3081       ,output v-cntxt-userid
     3082       ,output v-cntxt-level
     3083       ,output v-cntxt-host-code-obj
     3084       ,output v-cntxt-obj-type
     3085       ,output v-cntxt-obj-code
     3086       ,output v-cntxt-db-num-obj
     3087       ,output v-cntxt-is-admin
     3088       ) .
     3089    if p-mode <> 'все':U and p-mode <> 'фирма':U then dO:
     3090       message
     3091       vss-workfile vss-revision vss-description skip
     3092       "Неверное значение параметров вызова p-mode"
     3093       p-mode
     3094       view-as alert-box ERROR.
     3095       return.
     3096    end.
     3097   find first X_curr_sysconf no-lock where
     3098                   X_curr_sysconf.host-code = p-curr-host-code no-error.
     3099   if not available X_curr_sysconf then do:
     3100     message
     3101     vss-workfile vss-revision vss-description skip
     3102     "Неверное значение параметра вызова p-curr-host-code"
     3103     p-curr-host-code
     3104     view-as alert-box ERROR.
     3105     return.
     3106   end.
     3107    if p-mode = 'фирма':U then do:
     3108     find first X_clients no-lock where
     3109                   X_clients.obj-type = 'орг':U
     3110               and X_clients.obj-code = p-host-code no-error.
     3111       if not available X_clients then do:
     3112           message
     3113           vss-workfile vss-revision vss-description skip
     3114           "Неверное значение параметра вызова p-host-code"
     3115           p-mode p-host-code
     3116           view-as alert-box ERROR.
     3117           return.
     3118       end.
     3119       find first X_sysconf no-lock where
     3120                       X_sysconf.host-code = p-host-code no-error.
     3121       if not available X_sysconf then do:
     3122         message
     3123         vss-workfile vss-revision vss-description skip
     3124         "Неверное значение параметра вызова p-host-code"
     3125         p-host-code
     3126         view-as alert-box ERROR.
     3127         return.
     3128       end.
     3129     end.
     3130     v-rid-list = p-rid-list.
     3131     if v-rid-list <> "" then do:
     3132         FIND FIRST find_fin-bank No-LOCK where
     3133                    recid(find_fin-bank) = integer(entry(1, v-rid-list)) No-ERROR.
     3134         if not avail find_fin-bank then do:
     3135           message
     3136           vss-workfile vss-revision vss-description skip
     3137           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3138           view-as alert-box error .
     3139           return error.
     3140         end.
     3141         v-doc-rec = integer(entry(1, v-rid-list)).
     3142       end.
     3143   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3144   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3145     (output v-db-num
     3146     )  .
     3147     RUN MyEnable.
     3148     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     3149     HIDE mark-num in frame Dialog-Frame .
     3150     if v-rid-list <> "":U then
     3151     REPOSITION br-bank to recid integer(entry(1, v-rid-list)) No-ERROR.
     3152   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3153   DEF VAR cur-clmn-numbr-bank as INT EXTENT 6 no-undo.
     3154   DEF VAR varmvibr-bank       as INT no-undo.
     3155   DEF VAR varmvjbr-bank       as INT no-undo.
     3156   DEF VAR varmvkbr-bank       as INT no-undo.
     3157   DEF VAR varmvlbr-bank       as INT no-undo.
     3158   DEF VAR move-elementbr-bank as INT no-undo.
     3159   def var jjbr-bank           as int no-undo.
     3160   do varmvibr-bank = 1 to EXTENT(cur-clmn-numbr-bank):
     3161     ASSIGN cur-clmn-numbr-bank[varmvibr-bank] = varmvibr-bank.
     3162   END.
     3163   RUN start-mv-clmnbr-bank.
     3164   PROCEDURE start-mv-clmnbr-bank:
     3165   def var old-session as logical no-undo.
     3166      old-session = SESSION:IMMEDIATE-DISPLAY.
     3167      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3168          IF  p-mode = 'все':U  THEN DO:
     3169      DO jjbr-bank = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     3170        RUN re-move-clmnbr-bank ( cur-clmn-numbr-bank[INTEGER(ENTRY (jjbr-bank, '1,2,3,4,5,6'))] , 1).
     3171      END.
     3172          END.
     3173          IF  p-mode = 'фирма':U  THEN DO:
     3174      DO jjbr-bank = NUM-ENTRIES('1,3,4,5,6,2') TO 1 BY -1:
     3175        RUN re-move-clmnbr-bank ( cur-clmn-numbr-bank[INTEGER(ENTRY (jjbr-bank, '1,3,4,5,6,2'))] , 1).
     3176      END.
     3177          END.
     3178      SESSION:IMMEDIATE-DISPLAY = old-session.
     3179   END.
     3180   ON ctrl-cursor-right OF BROWSE br-bank do:
     3181     RUN re-move-clmnbr-bank ( 1, 6).
     3182   END.
     3183   ON ctrl-cursor-left OF BROWSE br-bank do:
     3184     RUN re-move-clmnbr-bank (6, 1).
     3185   END.
     3186   PROCEDURE re-move-clmnbr-bank:
     3187     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3188     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3189     DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3190       if cur-clmn-numbr-bank[varmvibr-bank] = source-column THEN cur-clmn-numbr-bank[varmvibr-bank] = -1.
     3191     END.
     3192     if br-bank:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3193     if source-column > target-column THEN
     3194     DO varmvjbr-bank = source-column - 1 to target-column BY -1:
     3195       DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3196           if cur-clmn-numbr-bank[varmvibr-bank] = varmvjbr-bank THEN DO:
     3197             cur-clmn-numbr-bank[varmvibr-bank] = cur-clmn-numbr-bank[varmvibr-bank] + 1.
     3198           END.
     3199       END.
     3200     END.
     3201     ELSE
     3202     DO varmvjbr-bank = source-column + 1 to target-column:
     3203       DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3204         if cur-clmn-numbr-bank[varmvibr-bank] = varmvjbr-bank THEN DO:
     3205           cur-clmn-numbr-bank[varmvibr-bank] = cur-clmn-numbr-bank[varmvibr-bank] - 1.
     3206         END.
     3207       END.
     3208     END.
     3209     DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3210       if cur-clmn-numbr-bank[varmvibr-bank] = -1 THEN cur-clmn-numbr-bank[varmvibr-bank] = target-column.
     3211     END.
     3212   END PROCEDURE.
     3213   PROCEDURE ch-clmnbr-bank:
     3214     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3215     if cur-clmn-loc <= 1 then do:
     3216       return .
     3217     end.
     3218     DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3219       if cur-clmn-numbr-bank[varmvibr-bank] = cur-clmn-loc THEN move-elementbr-bank = varmvibr-bank.
     3220     END.
     3221     RUN re-move-clmnbr-bank (cur-clmn-loc, 1).
     3222   END PROCEDURE.
     3223   PROCEDURE mv-brw-defaultbr-bank:
     3224   def var old-session as logical no-undo.
     3225     old-session = SESSION:IMMEDIATE-DISPLAY.
     3226     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3227     do varmvlbr-bank = 1 to EXTENT(cur-clmn-numbr-bank):
     3228       RUN re-move-clmnbr-bank (cur-clmn-numbr-bank[varmvlbr-bank], varmvlbr-bank).
     3229     END.
     3230     RUN start-mv-clmnbr-bank.
     3231     SESSION:IMMEDIATE-DISPLAY = old-session.
     3232   END PROCEDURE.
     3233   .
     3234     WAIT-FOR GO OF FRAME Dialog-Frame.
     3235   END.
     3236   RUN disable_UI.
     3237   PROCEDURE disable_UI :
     3238     HIDE FRAME Dialog-Frame.
     3239   END PROCEDURE.
     3240   PROCEDURE enable_UI :
     3241     DISPLAY RS-status_ ED-notes sch-code sch-BIK sch-name mark-num
     3242         WITH FRAME Dialog-Frame.
     3243     ENABLE b-quit B-mark b-sel B-add B-lookup B-chg B-del b-collect B-print
     3244            B-hist B-sch B-Help B-schet B-copy RS-status_ BR-bank ED-notes
     3245            sch-code sch-BIK sch-name mark-num
     3246         WITH FRAME Dialog-Frame.
     3247     VIEW FRAME Dialog-Frame.
     3248   END PROCEDURE.
     3249   PROCEDURE MyEnable :
     3250   ASSIGN
     3251   b-print:MENU-MOUSE in frame Dialog-Frame = 1
     3252   br-bank:num-locked-columns = 1
     3253   X_fin-bank.bik:read-only in browse br-bank = yes
     3254   rs-status_:RADIO-BUTTONS IN FRAME Dialog-Frame
     3255                          = "Текущие&+" + chr(44) +  'тек':U + chr(44) +
     3256                          "Все&!" + chr(44) + 'все':U + chr(44) +
     3257                           "Удаленные&-" + chr(44) + 'удал':U
     3258   rs-status_ = p-status_
     3259   .
     3260     DISPLAY
     3261     ED-notes
     3262     sch-code
     3263     sch-BIK
     3264     sch-name
     3265     mark-num
     3266     WITH FRAME Dialog-Frame.
     3267     ENABLE
     3268     b-quit
     3269     B-mark when lookup("b-mark":U, bttns) > 0
     3270     b-sel when lookup("b-sel":U, bttns) > 0
     3271     B-add when (p-mode = 'фирма':U
     3272                AND X_sysconf.firm-db-num = v-db-num
     3273                AND lookup("b-add":U, bttns) > 0 and not transaction
     3274                 )
     3275      b-copy when    (p-mode = 'фирма':U
     3276                AND X_sysconf.firm-db-num = v-db-num
     3277                AND lookup("b-copy":U, bttns) > 0  and not transaction
     3278                 )
     3279     B-lookup
     3280     B-chg when (p-mode = 'фирма':U
     3281                 AND X_sysconf.firm-db-num = v-db-num
     3282                 AND lookup("b-add":U, bttns) > 0  and not transaction
     3283                 )
     3284     B-del when (p-mode = 'фирма':U
     3285                 AND X_sysconf.firm-db-num = v-db-num
     3286                 AND lookup("b-add":U, bttns) > 0  and not transaction
     3287                 )
     3288     b-collect
     3289     B-sch
     3290     B-print
     3291     B-schet
     3292     B-Help
     3293     b-hist
     3294     BR-bank
     3295     ED-notes
     3296     sch-code
     3297     sch-BIK
     3298     sch-name
     3299     mark-num
     3300     RS-status_
     3301     WITH FRAME Dialog-Frame.
     3302     VIEW FRAME Dialog-Frame.
     3303   END PROCEDURE.
     3304   PROCEDURE OpenBr :
     3305   define input  parameter p-open-query     as logical   no-undo .
     3306   define input  parameter p-find-next      as logical   no-undo .
     3307   define input  parameter p-find-condition as character no-undo .
     3308   define variable l-query-was-opened as logical no-undo .
     3309   define variable title0 as character no-undo.
     3310   title0 = "Список банков" + chr(32).
     3311   run waitfram-show in this-procedure ("Ждите...").
     3312   define variable sort-column-phrase as character no-undo .
     3313   case sort-column-name :
     3314     when "" then do:
     3315       assign
     3316         sort-column-phrase = ""
     3317       .
     3318     end.
     3319     otherwise do:
     3320       assign
     3321         sort-column-phrase = "by " + sort-column-name
     3322       .
     3323     end.
     3324   end case.
     3325   define variable l-open-query as logical   no-undo .
     3326     CASE p-mode :
     3327       WHEN 'все':U        THEN DO:
     3328        assign
     3329        filter-point = filter-point0 + p-mode
     3330        filter-label = substitute("&1", filter-label0)
     3331        .
     3332        if p-open-query then do:
     3333          assign
     3334          frame Dialog-Frame:TITLE = title0 +
     3335                                     chr(32)  + (if p-status_ = 'все':U then "":U else p-status_)
     3336          .
     3337        end.
     3338        IF p-status_ = 'все':U THEN DO:
     3339   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3340   define variable  l-disable-where-25  as logical   no-undo .
     3341   define variable  l-filter-open-25    as logical   .
     3342   define variable  flt-rec-25       as recid     no-undo .
     3343   define variable  filter-name-25      as character no-undo .
     3344   define variable  where-phrase-25     as character no-undo .
     3345   define variable  sort-phrase-25      as character no-undo .
     3346   define variable  where-phrase-rus-25 as character no-undo .
     3347   define variable  sort-phrase-rus-25  as character no-undo .
     3348     run waitfram-show in this-procedure
     3349       (input "ЖДИТЕ ..."
     3350       ).
     3351   run gbl/flt-get.p
     3352     (input filter-point
     3353     ,output flt-rec-25
     3354     ,output filter-name-25
     3355     ,output where-phrase-25
     3356     ,output sort-phrase-25
     3357     ,output where-phrase-rus-25
     3358     ,output sort-phrase-rus-25
     3359     ).
     3360   if p-open-query then do:
     3361       run set-filter-name in this-procedure
     3362         (INPUT filter-name-25
     3363         ) no-error .
     3364     assign
     3365       l-filter-open-25 = false
     3366     .
     3367     if flt-rec-25 <> ?
     3368       or sort-column-phrase > ""
     3369     then do:
     3370       define variable  parameter-2-25 as character no-undo .
     3371       define variable  parameter-3-25 as character no-undo .
     3372       define variable  parameter-4-25 as character no-undo .
     3373       define variable  parameter-5-25 as character no-undo .
     3374       define variable  parameter-6-25 as character no-undo .
     3375       define variable  parameter-7-25 as character no-undo .
     3376         assign
     3377         parameter-3-25 =
     3378                                 "FOR EACH X_fin-bank"
     3379         parameter-4-25 =
     3380           (
     3381             if (" TRUE " + " " + where-phrase-25) <> ""
     3382             then " TRUE " + " " + where-phrase-25
     3383             else "true"
     3384           )
     3385         parameter-5-25 = (" " + "" + " " + "")
     3386         parameter-6-25 = if sort-phrase-25 = ''
     3387                              then
     3388           (
     3389           " " + "  " +
     3390             " " + sort-column-phrase +
     3391           " " + "  "
     3392           )
     3393                              else
     3394           (
     3395           " " + "  " +
     3396             " " + sort-column-phrase +
     3397           " " + sort-phrase-25
     3398           )
     3399         parameter-7-25 =
     3400           " indexed-reposition  "
     3401       .
     3402       do
     3403       on stop undo, leave
     3404       on error undo, leave
     3405       :
     3406         assign
     3407           l-disable-where-25 =
     3408             (" TRUE " + " " + where-phrase-25 = "")
     3409         .
     3410         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3411                             ,input QUERY br-bank:handle
     3412                             ,input parameter-3-25
     3413                             ,input parameter-4-25
     3414                             ,input parameter-5-25
     3415                             ,input parameter-6-25
     3416                             ,input parameter-7-25
     3417                             )
     3418         .
     3419         assign
     3420           l-filter-open-25 = true
     3421         .
     3422       end.
     3423       if l-filter-open-25 = false then do:
     3424         message
     3425           "Ошибка при фильтрации / сортировке" skip
     3426           "Будут показаны записи без учета фильтра" skip
     3427           view-as alert-box .
     3428       end.
     3429       else do:
     3430           assign
     3431             l-query-was-opened = true
     3432           .
     3433       end.
     3434     end.
     3435     if l-filter-open-25 = false then do:
     3436       OPEN QUERY br-bank FOR EACH X_fin-bank
     3437         where  TRUE
     3438         indexed-reposition
     3439     .
     3440         assign
     3441           l-query-was-opened = true
     3442         .
     3443     end.
     3444   end.
     3445   else do:
     3446     assign
     3447       v-doc-rec = recid( X_fin-bank )
     3448     .
     3449     do
     3450     on stop undo, leave
     3451     on error undo, leave
     3452     :
     3453       if QUERY br-bank:handle:get-buffer-handle(1) = (buffer X_fin-bank:handle) then do:
     3454         assign
     3455         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     3456         parameter-4-25 =
     3457           "where ":u + " TRUE " + " ":u + where-phrase-25 + " ":u + p-find-condition + " " + ""
     3458         parameter-5-25 = "  "
     3459       .
     3460         run fltopend_fltfindd in this-procedure  (
     3461                             input this-procedure:handle
     3462                             ,input QUERY br-bank:handle
     3463                             ,input rowid(X_fin-bank)
     3464                             ,input logical(parameter-2-25)
     3465                             ,input no-lock
     3466                             ,input (buffer X_fin-bank:handle)
     3467                             ,input parameter-4-25
     3468                             ,input parameter-5-25
     3469                             ) no-error.
     3470         .
     3471         assign
     3472           v-doc-rec = integer(return-value)
     3473           v-fltopend-rowid[1] = ?
     3474         .
     3475       end.
     3476       else do:
     3477         assign
     3478         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     3479         parameter-3-25 =  "FOR EACH X_fin-bank"
     3480         parameter-4-25 =
     3481           (
     3482             if (" TRUE " + " " + where-phrase-25) <> ""
     3483             then " TRUE " + " " + where-phrase-25
     3484             else "true"
     3485           )
     3486         parameter-5-25 = (" " + "" + " " + "" + " " + p-find-condition)
     3487         parameter-6-25 = if sort-phrase-25 = ''
     3488                              then
     3489           (
     3490           " " + "  " +
     3491             " " + sort-column-phrase +
     3492           " " + "  "
     3493           )
     3494                              else
     3495           (
     3496           " " + "  " +
     3497             " " + sort-column-phrase +
     3498           " " + sort-phrase-25
     3499           )
     3500         parameter-7-25 =
     3501           " indexed-reposition  "
     3502       .
     3503         run fltopend_fltfindq in this-procedure  (
     3504                             input this-procedure:handle
     3505                             ,input QUERY br-bank:handle
     3506                             ,input logical(parameter-2-25)
     3507                             ,input no-lock
     3508                             ,input parameter-3-25
     3509                             ,input parameter-4-25
     3510                             ,input parameter-5-25
     3511                             ,input parameter-6-25
     3512                             ,input parameter-7-25
     3513                             ,output v-fltopend-rowid
     3514                             ) no-error.
     3515         .
     3516         v-doc-rec = ?.
     3517       end.
     3518       assign
     3519         l-query-was-opened = true
     3520       .
     3521     end.
     3522   end.
     3523     run waitfram-hide in this-procedure .
     3524        END.
     3525        ELSE DO:
     3526   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3527   define variable  l-disable-where-27  as logical   no-undo .
