        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode         as character no-undo .
        4   define input parameter p-silent       as logical no-undo .
        5   define input parameter p-grp-code     as integer no-undo .
        6   define input parameter p-grp-name     as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: sumgrp01.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: ref/sumgrp01.p $":U .
       12   define variable vss-description as character no-undo init "Сохранение изменений в карточке суммовой группы".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable v-err-mess as character no-undo .
       72   define buffer buf_sum-grp for ub.sum-grp.
       73   define buffer buf_sys-ctrl for ub.sys-ctrl.
       74   main-block:
       75   do
       76   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status:get-message (1))
       77   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       78   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       79   :
       80     if p-mode <> 'ДОБАВЛЕНИЕ':U
       81     AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       82       message
       83       vss-workfile vss-revision vss-description skip
       84       "Неверный параметр p-mode" p-mode
       85       view-as alert-box error .
       86       undo main-block, return error '':u.
       87     end.
       88     find first buf_sys-ctrl no-lock.
       89     if buf_sys-ctrl.db-num <> 0 then do:
       90       v-err-mess = "Создание и редактирование суммовых групп разрешено только в ГБД".
       91       run err-mess in this-procedure ( input-output v-err-mess).
       92       undo main-block, return error (if p-silent then v-err-mess else '':U).
       93     end.
       94     if p-grp-code <= 0
       95     OR p-grp-code = ?  then do:
       96       v-err-mess = "Код группы товаров должен быть больше 0 !".
       97       run err-mess in this-procedure ( input-output v-err-mess).
       98       undo main-block, return error (if p-silent then v-err-mess else 'grp-code':U).
       99     end.
      100     if p-grp-code >= 1000 then do:
      101       v-err-mess = "Код группы товаров должен быть меньше 1000 !".
      102       run err-mess in this-procedure ( input-output v-err-mess).
      103       undo main-block, return error (if p-silent then v-err-mess else 'grp-code':U).
      104     end.
      105     if can-find( FIRST ub.sum-grp WHERE
      106                         ub.sum-grp.grp-code = p-grp-code
      107                     AND p-mode = 'ДОБАВЛЕНИЕ':U ) then do:
      108       v-err-mess = substitute("Суммовая группа с кодом &1 уже существует"
      109                              ,p-grp-code ).
      110       run err-mess in this-procedure ( input-output v-err-mess).
      111       undo main-block, return error (if p-silent then v-err-mess else 'grp-code':U).
      112     end.
      113     if p-grp-name = ""  then do:
      114       v-err-mess = substitute("Название суммовой группы не может быть пустым").
      115       run err-mess in this-procedure ( input-output v-err-mess).
      116       undo main-block, return error (if p-silent then v-err-mess else 'grp-name':U).
      117     end.
      118     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      119       create buf_sum-grp.
      120       assign
      121       buf_sum-grp.grp-code = p-grp-code
      122       buf_sum-grp.grp-name = p-grp-name
      123       p-doc-rec = recid(buf_sum-grp)
      124       .
      125     end.
      126     else do:
      127       FIND FIRST buf_sum-grp where
      128                 recid(buf_sum-grp) = p-doc-rec No-ERROR.
      129       if p-grp-code <> buf_sum-grp.grp-code then do:
      130         assign
      131         v-err-mess = "Нельзя изменять код группы для уже имеющейся записи".
      132         run err-mess in this-procedure ( input-output v-err-mess).
      133         undo main-block, return error (if p-silent then v-err-mess else 'grp-code':U).
      134       end.
      135       assign
      136       buf_sum-grp.grp-name    = p-grp-name
      137       .
      138     end.
      139     release buf_Sum-grp no-error.
      140     if error-status:error then do:
      141       v-err-mess = substitute("&1 &2 &3&4" +
      142                               "Ошибка при сохранении записи СУММОВОЙ ГРУППЫ&4" +
      143                               "&5&4&6&4"
      144                               ,vss-workfile
      145                               ,vss-revision
      146                               ,vss-description
      147                               ,chr(10)
      148                               , error-status:get-message(1)
      149                               , return-value ).
      150       run err-mess in this-procedure ( input-output v-err-mess).
      151       undo main-block, return error (if p-silent then v-err-mess else "":U).
      152     end.
      153   end.
      154   PROCEDURE err-mess:
      155   DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      156   p-mess = substitute("Ошибка при сохранении/изменении СУММОВОЙ ГРУППЫ с кодом № &1&2&3"
      157                     , p-grp-code
      158                     , chr(10)
      159                     , p-mess) .
      160   if not p-silent then
      161   message
      162   p-mess
      163   view-as alert-box error .
      164   END PROCEDURE.
