      363   DEFINE VARIABLE loc#log as logical no-undo .
      364   DEFINE BUFFER bf_fin-schet for ub.fin-schet.
      365   DEFINE VARIABLE choice as logical no-undo .
      366   DEFINE VARIABLE varold-status_ like ub.fin-schet.status_ no-undo .
      367   define variable v-err-mess as character no-undo .
      368   define variable v1-mainholder as character no-undo .
      369   define variable v2-mainholder as character no-undo .
      370   define variable v1type as character no-undo .
      371   define variable v2type as character no-undo .
      372   define variable v-dop1 as character no-undo .
      373   define buffer buf-db_fin-schet for ub.fin-schet.
      374   do
      375   on error undo, return error
      376   :
      377   FIND FIRST bf_fin-schet WHERE
      378              recid(bf_fin-schet) = p-recid No-ERROR.
      379   if not avail bf_fin-schet then return error.
      380   varold-status_ = bf_fin-schet.status_.
      381   if p-status_ = ?
      382   or p-status_ = "":U
      383   then do:
      384     CASE varold-status_:
      385       when 'тек':U then do:
      386         assign
      387         p-status_ = 'удал':U.
      388       end.
      389       when 'удал':U then do:
      390         assign
      391         p-status_ = 'тек':U.
      392       end.
      393     END CASE.
      394   end.
      395   _main:
      396   do
      397   on error undo, return error
      398   :
      399   CASE p-status_:
      400     WHEN 'тек':U then do:
      401       if 'тек':U = bf_fin-schet.status_  then do:
      402         if not p-silent then do:
      403         p-status_ = "".
      404           v-err-mess = substitute("БАНКОВСКИЙ СЧЕТ уже имеет статус ТЕКУЩИЙ!").
      405           run err-mess in this-procedure ( input-output v-err-mess ).
      406           undo _main, return error (if p-silent then v-err-mess else "status_").
      407         end.
      408       end.
      409       else do:
      410         if not p-silent then do:
      411         message
      412         "Восстановить удаленный счет?"
      413         view-as alert-box question buttons yES-NO  update choice.
      414         end.
      415         else do:
      416           choice = yes.
      417         end.
      418         if choice then do:
      419           if p-check-option <> "no-check" then do:
      420             for each buf-db_fin-schet where buf-db_fin-schet.host-code = bf_fin-schet.host-code and
      421                                               buf-db_fin-schet.r-schet   = bf_fin-schet.r-schet   and
      422                                               buf-db_fin-schet.code-bank = bf_fin-schet.code-bank and
      423                                               buf-db_fin-schet.status_   = 'тек':U
      424                                         :
      425               if buf-db_fin-schet.code-schet   = bf_fin-schet.code-schet    then next.
      426               run clntattr-value in this-procedure (
      427                                                       input bf_fin-schet.cli-type
      428                                                     ,input bf_fin-schet.cli-code
      429                                                     ,input 'main-accholder':U
      430                                                     ,output v1-mainholder
      431                                                     ,output v1type) no-error.
      432               run clntattr-value in this-procedure (
      433                                                       input buf-db_fin-schet.cli-type
      434                                                     ,input buf-db_fin-schet.cli-code
      435                                                     ,input 'main-accholder':U
      436                                                     ,output v2-mainholder
      437                                                     ,output v2type) no-error.
      438               if v1-mainholder = v2-mainholder
      439               and v1-mainholder <> '':U
      440               and v2-mainholder <> '':U
      441               and buf-db_Fin-schet.dop1 <> bf_fin-schet.dop1
      442               and buf-db_Fin-schet.dop1 <> '':U
      443               and bf_fin-schet.dop1 <> '':U
      444               then next.
      445               leave.
      446             end.
      447             if available buf-db_fin-schet then do:
      448               v-err-mess = substitute("Уже есть расчетный счет &1 по фирме &2 в том же банке.&3" +
      449                                             "Вн.номер счета: &4"
      450                                             , bf_fin-schet.r-schet
      451                                             , bf_fin-schet.host-code
      452                                             , chr(10)
      453                                             ,buf-db_fin-schet.code-schet).
      454               undo, return error (if p-silent = yes then v-err-mess else 'r-schet':U).
      455             end.
      456           end.
      457         assign
      458         bf_fin-schet.status_ = 'тек':U .
      459         end.
      460         else do:
      461           undo _main, return error .
      462         end.
      463       end.
      464     end.
      465     WHEN 'удал':U then do:
      466       choice = FALSE .
      467       if not p-silent then do:
      468       message "Удалить банковский счет, Вы уверены?" skip
      469       view-as alert-box WARNING
      470       buttons OK-Cancel update choice .
      471       end.
      472       else do:
      473         choice = yes.
      474       end.
      475       if choice then  do:
      476         bf_fin-schet.status_ = 'удал':U .
      477       end.
      478       else do:
      479         undo _main, return error .
      480       end.
      481     end.
      482   END CASE.
      483   release bf_fin-schet no-error .
      484   if error-status:error then do:
      485     v-err-mess = substitute("Ошибка при сохранении записи БАНКОВСКИЙ СЧЕТ&1&2&1&3"
      486                         , chr(10)
      487                         , error-status:get-message(1)
      488                         , return-value ).
      489     run err-mess in this-procedure ( input-output v-err-mess ).
      490     undo _main, return error (if p-silent then v-err-mess else '').
      491   end.
      492   p-status_ = "".
      493   end.
      494   end.
      495   PROCEDURE err-mess:
      496     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      497     CASE p-silent:
      498       when yes then do:
      499         p-mess = substitute("Счет вн.№ &1: фирма: &2:&3&4"
      500                            , bf_fin-schet.code-schet
      501                            , bf_fin-schet.host-code
      502                            , chr(10)
      503                            , p-mess
      504                            ).
      505       end.
      506       otherwise do:
      507         message
      508         p-mess
      509         view-as alert-box error .
      510       end.
      511     end.
      512   END PROCEDURE.
