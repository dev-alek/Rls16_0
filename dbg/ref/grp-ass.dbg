     2003   procedure prn-lib-reportviewer :
     2004     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2005     define input parameter p-report-name-html as character no-undo .
     2006     define input parameter p-param        as character no-undo .
     2007     define variable v-excel           as character no-undo init 'TRUE' .
     2008     define variable v-value-character as character no-undo .
     2009     define variable v-value-integer   as character no-undo .
     2010     define variable v-value-date      as date      no-undo .
     2011     define variable v-value-decimal   as decimal   no-undo .
     2012     define variable rep-excel         as logical   no-undo .
     2013     define variable excel-string      as character no-undo .
     2014     define variable v-param-type      as character no-undo .
     2015     define variable v-tth             as handle    no-undo .
     2016     run adm/shattri.p (
     2017       input "get":U
     2018       ,input  ""
     2019       ,input  0
     2020       ,input  'report-glob':U
     2021       ,input  'rep-excel':U
     2022       ,output v-value-character
     2023       ,output v-value-date
     2024       ,output v-value-decimal
     2025       ,output v-value-integer
     2026       ,output rep-excel
     2027       ,output v-param-type
     2028       ,INPUT-OUTPUT table-handle v-tth
     2029       )  .
     2030     if rep-excel then v-excel = "TRUE" .
     2031     else v-excel = "FALSE" .
     2032     if p-param eq ""
     2033     then
     2034        p-param = "EXCEL:" + v-excel.
     2035     else
     2036        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     2037     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     2038   end procedure.
