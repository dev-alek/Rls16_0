     3331       end.
     3332   if session :set-wait-state( "" ) then.
     3333       OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     3334   END.
     3335   ON CHOOSE OF b-find-by-full-name IN FRAME Dlg-grp
     3336   DO:
     3337       define variable v-new-name as character no-undo.
     3338       run grplib-expand-name in this-procedure (
     3339             input fi-search :screen-value
     3340           , output v-new-name
     3341       ) no-error.
     3342       if error-status :error
     3343       then do:
     3344           message return-value.
     3345           undo, return no-apply.
     3346       end.
     3347       if v-new-name = ""
     3348       then do:
     3349           message
     3350               "Не найдена группа с полным именем, начинающимся на"
     3351               skip "'" + fi-search :screen-value + "'"
     3352           view-as alert-box information.
     3353           assign
     3354               v-new-name = fi-search :screen-value
     3355           .
     3356       end.
     3357       assign
     3358           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     3359           fi-search :cursor-offset = length( v-new-name ) + 1
     3360       .
     3361   END.
     3362   ON LEAVE OF b-find-by-full-name IN FRAME Dlg-grp
