     7736       delete buf_temp_grplib_grp.
     7737   end.
     7738   create buf_temp_grplib_grp.
     7739   assign
     7740       buf_temp_grplib_grp.node-code   = buf_gds-grp.node-code
     7741       buf_temp_grplib_grp.upper-code  = buf_gds-grp.upper-code
     7742       buf_temp_grplib_grp.level       = 0
     7743       buf_temp_grplib_grp.mark        = ( if v-have-goods = yes then "•" else " " )
     7744       buf_temp_grplib_grp.full-name   = chr(4)
     7745       buf_temp_grplib_grp.sort-name   = chr(4)
     7746       buf_temp_grplib_grp.name        = buf_gds-grp.node-name
     7747       buf_temp_grplib_grp.increase-pc = buf_gds-grp.increase-pc
     7748       buf_temp_grplib_grp.calc-method = buf_gds-grp.calc-method
     7749   .
     7750   for each buf_gds-grp no-lock
     7751      where buf_gds-grp.upper-code = v-root-code
     7752   :
     7753       run grplib-get-full-name in this-procedure (
     7754             input buf_gds-grp.node-code
     7755           , output v-full-name
     7756       ) no-error .
     7757       if error-status :error
     7758       then do:
     7759           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
     7760       end.
     7761       run grplib-get-sort-name in this-procedure (
     7762             input buf_gds-grp.node-code
     7763           , output v-sort-name
     7764       ) no-error .
     7765       if error-status :error
     7766       then do:
     7767           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
     7768       end.
     7769       run create-new-line in this-procedure (
     7770             input buf_gds-grp.node-code
     7771           , input buf_gds-grp.upper-code
     7772           , input 1
     7773           , input buf_gds-grp.is-term
     7774           , input buf_gds-grp.node-name
     7775           , input buf_gds-grp.increase-pc
     7776           , input buf_gds-grp.calc-method
     7777           , input "":U
     7778           , input "":U
     7779       ) no-error .
     7780       if error-status :error
     7781       then do:
     7782           message
     7783             vss-workfile vss-revision vss-description
     7784             skip "UI-on: Ошибка добавления строки в список групп."
     7785             skip return-value
     7786             skip trim(error-status :get-message(1))
     7787                  trim(error-status :get-message(2))
     7788                  trim(error-status :get-message(3))
     7789                  trim(error-status :get-message(4))
     7790                  trim(error-status :get-message(5))
     7791           view-as alert-box error.
     7792           undo, return error .
     7793       end.
     7794   end.
     7795       assign
     7796           v-reposition-row = 1
     7797           v-focused-row    = 1
     7798       .
     7799       for each buf_gds-grp no-lock
     7800            :
     7801           run expand-tree-for-grp in this-procedure (
     7802               input buf_gds-grp.node-code
     7803               , output v-focused-row
     7804               , output v-reposition-row
     7805               , output v-reposition-to-recid
     7806           ) no-error .
     7807           if error-status :error
     7808           then do:
     7809               undo, return error "UI-on: Не удалось раскрыть дерево групп." + chr(10) + return-value.
     7810           end.
     7811       end.
     7812   run enable_UI.
     7813   hide
     7814           b-mark      in frame Dlg-grp
     7815        .
     7816   case p-button-list
     7817   :
     7818   when "buttons-for-move"
     7819   then do:
     7820       disable
     7821           b-exit    with frame Dlg-grp
     7822       .
     7823   end.
     7824   when "buttons-for-admin"
     7825   then do:
     7826   end.
     7827   when 'терм':U + ",b-scales"
     7828   then do:
     7829   end.
     7830   when 'терм':U + ",b-sel" or when "b-sel"
     7831   then do:
     7832   end.
     7833   when "b-sel,b-mark"
     7834   then do:
     7835       view
     7836           b-mark in frame Dlg-grp
     7837       .
     7838   end.
     7839   end case.
     7840   if v-current-store-code = 0
     7841   or transaction
     7842   then do:
     7843   end.
     7844   br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     7845   run recalc-marg-ass.
     7846   if v-reposition-to-recid = no
     7847   then do:
     7848       reposition br-list to row v-reposition-row.
     7849   end.
     7850   else do:
     7851       reposition br-list to recid v-reposition-row.
     7852   end.
     7853   OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     7854   end.
     7855   for each temp_grplib_grp :
     7856       find first temp_cons where temp_cons.node-code = temp_grplib_grp.node-code no-error .
     7857           if not available temp_cons then create temp_cons.
     7858           assign
     7859               temp_cons.full-name  = temp_grplib_grp.full-name
     7860               temp_cons.node-code  = temp_grplib_grp.node-code
     7861               temp_cons.upper-code = temp_grplib_grp.upper-code
     7862               temp_cons.min-marg   = temp_grplib_grp.min-marg
     7863               temp_cons.max-marg   = temp_grplib_grp.max-marg
     7864               temp_cons.cli-type   = temp_grplib_grp.cli-type
     7865           .
     7866   end.
     7867   run recalc-lim in this-procedure .
     7868   END PROCEDURE.
     7869   PROCEDURE ver-attr :
     7870   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7871   define VARIABLE v-old-grp as integer   no-undo .
     7872   define VARIABLE v-new-grp as integer   no-undo .
     7873   define VARIABLE v-ok      as logical    no-undo .
     7874   find first buf1_gds-grp-obj-attr no-lock where
     7875              buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
     7876              buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
     7877              buf1_gds-grp-obj-attr.obj-code  = p-db-num and
     7878              buf1_gds-grp-obj-attr.host-code = 0 no-error .
     7879   if not available buf1_gds-grp-obj-attr then do:
     7880      run utl/uassmgrp.p ( v-old-grp, v-new-grp, p-id , p-db-num, output v-ok ) no-error.
     7881      if error-status :error then message
     7882        vss-workfile vss-revision vss-description skip
     7883        error-status :get-message(1) skip
     7884        return-value skip
     7885        ""
     7886        view-as alert-box error
     7887      .
     7888   end.
     7889   END PROCEDURE.
     7890   PROCEDURE ver-db :
     7891   if v-cntxt-db-num <> 0 then do:
     7892       if  buf_matrix.asmt-type = 'Шаблон':U  then do:
     7893           if v-cntxt-db-num <> buf_matrix.asmt-db-num-create then do:
     7894             message
     7895               "Нельзя редактировать ШАБЛОН Ассортиментная матрица созданный в чужой УБД"
     7896               view-as alert-box error.
     7897               return  error.
     7898           end.
     7899       end.
     7900       else do:
     7901           define variable obj-db-num as integer   no-undo .
     7902   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7903   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     7904     (input  buf_matrix.obj-type
     7905     ,input  buf_matrix.obj-code
     7906     ,output obj-db-num
     7907     )  .
     7908           if v-cntxt-db-num <> 0 and  v-cntxt-db-num <> obj-db-num  then do:
     7909             message
     7910               "Нельзя редактировать запись Ассортиментная матрица чужой УБД"
     7911               view-as alert-box error.
     7912               return  error.
     7913           end.
     7914       end.
     7915   end.
     7916   END PROCEDURE.
     7917   PROCEDURE ver-db1 :
     7918   define variable vss-include-info42 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7919   do:
     7920     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7921       (input  v-cntxt-db-num
     7922       ,input  v-cntxt-userid
     7923       ,input  0
     7924       ,input  'actn_assort-matr-grp_update':U
     7925       ,input  'global':U
     7926       ,input  0
     7927       ,input  '':U
     7928       ,input  0
     7929       ,input  0
     7930       ,input  0
     7931       ,input  0
     7932       ,input  true
     7933       ,output v-log
     7934       )  .
     7935   end.
     7936    if not v-log then temp_grplib_grp.cli-type:read-only in browse br-list = true .
     7937   if v-cntxt-db-num <> 0 then do:
     7938       if  buf_matrix.asmt-type = 'Шаблон':U  then do:
     7939           if v-cntxt-db-num <> buf_matrix.asmt-db-num-create then do:
     7940              temp_grplib_grp.cli-type:read-only in browse br-list = true .
     7941           end.
     7942       end.
     7943       else do:
     7944           define variable obj-db-num as integer   no-undo .
     7945   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7946   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     7947     (input  buf_matrix.obj-type
     7948     ,input  buf_matrix.obj-code
     7949     ,output obj-db-num
     7950     )  .
     7951           if v-cntxt-db-num <> 0 and  v-cntxt-db-num <> obj-db-num  then do:
     7952              temp_grplib_grp.cli-type:read-only in browse br-list = true .
     7953           end.
     7954       end.
     7955   end.
     7956   END PROCEDURE.
     7957   PROCEDURE init-gds-rec :
     7958   if available buf_goods then do:
     7959      gds-rec = recid (buf_goods) .
     7960   end.
     7961   END PROCEDURE.
     7962   PROCEDURE recalc-add :
     7963   define variable v-qntyAssgrp as integer  no-undo .
     7964   define buffer buf2_goods for ub.goods  .
     7965   define buffer loc_temp_grplib_grp for temp_cons  .
     7966   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7967   define variable v-recid as recid no-undo .
     7968   v-recid = recid (temp_grplib_grp) .
     7969       for each loc_temp_grplib_grp :
     7970           v-qntyAssgrp = 0.
     7971           find first buf1_gds-grp-obj-attr no-lock where
     7972                      buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
     7973                      buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
     7974                      buf1_gds-grp-obj-attr.obj-code  = p-db-num and
     7975                      buf1_gds-grp-obj-attr.host-code = 0 and
     7976                      buf1_gds-grp-obj-attr.node-code = loc_temp_grplib_grp.node-code
     7977           no-error .
     7978           if available buf1_gds-grp-obj-attr then v-qntyAssgrp = int(buf1_gds-grp-obj-attr.attr-value) .
     7979           assign
     7980             loc_temp_grplib_grp.max-marg = string(v-qntyAssgrp)
     7981           .
     7982       end.
     7983   find first temp_grplib_grp where recid(temp_grplib_grp)  = v-recid no-error .
     7984   OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     7985   reposition BR-list to recid v-recid no-error.
     7986   OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     7987   END PROCEDURE.
