     2846   define variable p-time-upd as character no-undo .
     2847   define variable p-time-cr  as character no-undo .
     2848   define variable p-status as character no-undo .
     2849   define variable gds-rec as recid no-undo .
     2850   define variable v-indicator-life-gds like  ub.gds-obj-prop.gdop-igt        column-label "ИЖТ" format "x(25)" no-undo .
     2851   define variable v-assort-min         like  ub.gds-obj-prop.gdop-assort-min column-label "AMin" format "*/ " no-undo .
     2852   define variable p-name as character no-undo .
     2853   v-err-ext = false  .
     2854   v-longchar = "" .
     2855   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     2856      .
     2857   define temp-table tt-gds-list no-undo like goods
