     2903        LABEL "&*"
     2904        SIZE 3 BY 1.
     2905   DEFINE BUTTON B-print
     2906        LABEL "Пе&чать"
     2907        SIZE 2.5 BY 1.
     2908   DEFINE BUTTON b-recalc
     2909        LABEL "Пе&ресчитать"
     2910        SIZE 13.5 BY 1 TOOLTIP "Пересчитать количество товара по всем уровням"
     2911        BGCOLOR 8 .
     2912   DEFINE BUTTON b-search
     2913        LABEL "Поиск"
     2914        SIZE 10 BY 1.04
     2915        BGCOLOR 8 .
     2916   DEFINE BUTTON b-verify
     2917        LABEL "Проверить"
     2918        SIZE 13.5 BY 1 TOOLTIP "Проверить ограниечения по уровням групп"
     2919        BGCOLOR 8 .
     2920   DEFINE VARIABLE fi-search AS CHARACTER FORMAT "X(256)":U
     2921        VIEW-AS FILL-IN
     2922        SIZE 69.75 BY 1
     2923        FGCOLOR 1  NO-UNDO.
     2924   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
     2925         VIEW-AS TEXT
     2926        SIZE 7.5 BY 1
     2927        FGCOLOR 4  NO-UNDO.
     2928   DEFINE VARIABLE RS-sts AS CHARACTER INITIAL "0"
     2929        VIEW-AS RADIO-SET HORIZONTAL EXPAND
     2930        RADIO-BUTTONS
     2931             "Item 1", "0",
     2932   "Item 2", "1",
     2933   "Item 3", "2"
     2934        SIZE 33.5 BY 1 NO-UNDO.
     2935   DEFINE QUERY br-list FOR
     2936         temp_grplib_grp SCROLLING.
     2937   DEFINE QUERY BROWSE-am-goods FOR
     2938         buf_Matrix-goods,
     2939         buf_goods SCROLLING.
     2940   DEFINE BROWSE br-list
     2941     QUERY br-list DISPLAY
     2942         temp_grplib_grp.name          format "X(63)"       COLUMN-label "Наименование группы! "
     2943         temp_grplib_grp.cli-type                           COLUMN-label "Ограничение!по группе"
     2944         temp_grplib_grp.min-marg                           COLUMN-label "По нижним!уровням"
     2945         temp_grplib_grp.max-marg                           COLUMN-label "Кол-во в группе!без ИЖТ на вывод"
     2946         ENABLE
     2947         temp_grplib_grp.cli-type
     2948       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 8.38.
     2949   DEFINE BROWSE BROWSE-am-goods
     2950     QUERY BROWSE-am-goods NO-LOCK DISPLAY
     2951         mark-string(recid( buf_Matrix-goods) , p-rid-list) @ p-mark COLUMN-LABEL "*" FORMAT "x(1)":U
     2952         Buf_goods.artic FORMAT "X(16)":U
     2953         STRING ( if Buf_goods.stts <> 0 then substring(Buf_goods.gds-name,1,15) + " <УДАЛЕН>"  else Buf_goods.gds-name ) @ p-name COLUMN-LABEL "Название" FORMAT "X(30)":U
     2954         Buf_matrix-goods.asmg-date-update COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
     2955         STRING (buf_Matrix-goods.asmg-time-update, 'HH:MM' ) FORMAT "x(5)":U
     2956         Buf_matrix-goods.asmg-db-num-update COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     2957         Buf_matrix-goods.asmg-date-create COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     2958          STRING (buf_Matrix-goods.asmg-time-create, 'HH:MM' )  FORMAT "x(5)":U
     2959         v-indicator-life-gds
     2960         v-assort-min COLUMN-LABEL "Acc!Min" FORMAT "*/":U
     2961         Buf_matrix-goods.asmg-db-num-create COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
     2962         entry (lookup (STRING(buf_Matrix-goods.asmg-status), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ p-status COLUMN-LABEL "Статус" FORMAT "x(6)":U
     2963         Buf_goods.grp-name COLUMN-LABEL "Группа! " FORMAT "x(45)":U
     2964     ENABLE
     2965         Buf_matrix-goods.asmg-db-num-update
     2966       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 97 BY 8.25 FIT-LAST-COLUMN.
     2967   DEFINE FRAME Dlg-grp
     2968        b-exit AT ROW 1 COL 1
     2969        b-mark AT ROW 1 COL 11
     2970        b-verify AT ROW 1 COL 66 WIDGET-ID 22
     2971        b-recalc AT ROW 1 COL 79.88 WIDGET-ID 14
     2972        B-print AT ROW 1 COL 94 WIDGET-ID 12
     2973        b-help AT ROW 1 COL 96.5
     2974        b-expand AT ROW 2.08 COL 1.63
     2975        b-expand-all AT ROW 2.08 COL 5.13
     2976        fi-search AT ROW 2.08 COL 13.38 NO-LABEL
     2977        b-find-by-full-name AT ROW 2.08 COL 83.38
     2978        b-find-by-substring AT ROW 2.08 COL 86.38
     2979        b-search AT ROW 2.08 COL 89.38
     2980        br-list AT ROW 3.38 COL 1.88
     2981        B-add AT ROW 12.5 COL 2 WIDGET-ID 2
     2982        B-lookup AT ROW 12.5 COL 12 WIDGET-ID 10
     2983        B-chg AT ROW 12.5 COL 22 WIDGET-ID 4
     2984        B-del AT ROW 12.5 COL 32 WIDGET-ID 8
     2985        B-copy AT ROW 12.5 COL 42.13 WIDGET-ID 6
     2986        RS-sts AT ROW 12.5 COL 65.5 NO-LABEL WIDGET-ID 18
     2987        BROWSE-am-goods AT ROW 13.58 COL 2 WIDGET-ID 100
     2988        FILL-IN-1 AT ROW 12.5 COL 57.5 NO-LABEL WIDGET-ID 16
     2989        SPACE(35.00) SKIP(8.57)
     2990       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2991            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2992            TITLE "Ассортиментная Матрица по группам товаров".
     2993   ASSIGN
     2994          FRAME Dlg-grp:SCROLLABLE       = FALSE
     2995          FRAME Dlg-grp:HIDDEN           = TRUE.
     2996   ON ENDKEY OF FRAME Dlg-grp
     2997   DO:
     2998       run gbl/markqwa.p (
     2999                              input b-mark:visible
     3000                             , input p-recid-list) no-error.
     3001       if error-status:error then return no-apply.
     3002   END.
     3003   ON WINDOW-CLOSE OF FRAME Dlg-grp
     3004   DO:
     3005     apply "end-error":U to self.
     3006   END.
     3007   ON CHOOSE OF B-add IN FRAME Dlg-grp
     3008   DO:
     3009     define variable loc#log as logical no-undo.
     3010     define variable loc-doc-rec as recid no-undo .
     3011   if  buf_matrix.asmt-status = 1  then do:
     3012       message "Добавлять можно  в  АССОРТИМЕНТНУЮ МАТРИЦУ в статусе тек."
     3013       view-as alert-box information .
     3014       return no-apply.
     3015   end.
     3016   run ver-db no-error .
     3017   if error-status :error then return no-apply .
     3018   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3019   do:
     3020     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3021       (input  v-cntxt-db-num
     3022       ,input  v-cntxt-userid
     3023       ,input  0
     3024       ,input  'actn_assort-matr-gds_add-def':U
     3025       ,input  'global':U
     3026       ,input  0
     3027       ,input  '':U
     3028       ,input  0
     3029       ,input  0
     3030       ,input  0
     3031       ,input  0
     3032       ,input  true
     3033       ,output v-log
     3034       )  .
     3035   end.
     3036    if not v-log then return no-apply .
     3037     run save-attr in this-procedure .
     3038     run proc-add in this-procedure (output loc-doc-rec ) no-error  .
     3039     if error-status :error then DO:
     3040        message
     3041     error-status :get-message(1)
     3042     return-value
     3043     view-as alert-box error
     3044     .
     3045        RETURN NO-APPLY.
     3046     END.
     3047     if loc-doc-rec <> ? THEN DO:
     3048       OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     3049     END.
     3050     run recalc-add.
     3051     run recalc-marg-ass.
     3052     apply "entry" to BROWSE-am-goods in frame Dlg-grp.
     3053     apply "value-changed" to BROWSE-am-goods in frame Dlg-grp.
     3054   END.
     3055   ON CHOOSE OF B-chg IN FRAME Dlg-grp
     3056   DO:
     3057      define variable loc#log as logical no-undo.
     3058      define variable loc-doc-rec as recid no-undo .
     3059   if not available Buf_matrix-goods then return no-apply.
     3060   if  Buf_matrix-goods.asmg-status = 1  then do:
     3061       message "Корректировать можно только запись в статусе  ТЕК."
