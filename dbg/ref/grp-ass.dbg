     3180   ON CHOOSE OF b-exit IN FRAME Dlg-grp
     3181   DO:
     3182   define variable  v-str as character no-undo .
     3183   define variable v-i as integer   no-undo .
     3184   for each temp_grplib_grp :
     3185       find first temp_cons where temp_cons.node-code = temp_grplib_grp.node-code no-error .
     3186           if available temp_cons then do:
     3187           if temp_cons.max-marg <>  temp_grplib_grp.max-marg then do:
     3188           assign
     3189               temp_cons.full-name  = temp_grplib_grp.full-name
     3190               temp_cons.node-code  = temp_grplib_grp.node-code
     3191               temp_cons.upper-code = temp_grplib_grp.upper-code
     3192               temp_cons.min-marg   = temp_grplib_grp.min-marg
     3193               temp_cons.max-marg   = temp_grplib_grp.max-marg
     3194               temp_cons.cli-type   = temp_grplib_grp.cli-type
     3195           .
     3196           end.
     3197           end.
     3198   end.
     3199   v-str = "".
     3200   v-i =0.
     3201   for each temp_cons where int(temp_cons.cli-type) < int(temp_cons.min-marg)
     3202    and int(temp_cons.cli-type) <> ?
     3203    and temp_cons.cli-type <> ""
     3204    and int(temp_cons.min-marg) <> ?
     3205   :
     3206     v-i = v-i + 1.
     3207     v-str = v-str + trim(temp_cons.full-name) + ": ограничение-" + temp_cons.cli-type + ", должно быть >= " + temp_cons.min-marg + "." + chr(10) .
     3208   end.
     3209   for each temp_cons where int(temp_cons.cli-type) < int(temp_cons.max-marg)
     3210    and int(temp_cons.cli-type) <> ?
     3211    and temp_cons.cli-type <> ""
     3212    and int(temp_cons.max-marg) <> ?
     3213   :
     3214     v-i = v-i + 1.
     3215     v-str = v-str + trim(temp_cons.full-name) + ": ограничение-" + temp_cons.cli-type + ", а товара в группе-" + temp_cons.max-marg + "." + chr(10) .
     3216   end.
     3217   if v-i <> 0 then do:
     3218       message substitute("Внимание ! Ограничения по Матрице  &1 назначены некорректно !!!", buf_matrix.asmt-name ) view-as alert-box error .
     3219       run gbl/notes.w ('ПРОСМОТР':U,input-output v-str) .
