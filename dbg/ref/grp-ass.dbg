     3156   ON CHOOSE OF B-del IN FRAME Dlg-grp
     3157   DO:
     3158   run save-attr in this-procedure .
     3159   define variable is-many as logical   no-undo .
     3160   is-many = false .
     3161   if  buf_matrix.asmt-status = 1  then do:
     3162       message "Корректировать и удалять можно  в  АССОРТИМЕНТНОЙ МАТРИЦЕ в статусе тек."
     3163       view-as alert-box information .
     3164       return no-apply.
     3165   end.
     3166   run ver-db no-error .
     3167   if error-status :error then return no-apply .
     3168   if num-entries(p-rid-list) > 0 then do:
     3169      message "Удалять выделенные записи ?"
     3170      view-as alert-box question
     3171      Buttons yes-no update v-logq as log.
     3172      if v-logq = false then return .
     3173      is-many = true .
     3174   end.
     3175     run proc-b-del in this-procedure ( p-rid-list , is-many ) no-error.
     3176     if error-status:error then return no-apply.
