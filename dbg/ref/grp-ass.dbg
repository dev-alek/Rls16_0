     2820   define variable v-from-b-gds as logical no-undo .
     2821   define variable v-old-recid-list as character no-undo .
     2822   define variable v-old-recid as recid no-undo .
     2823   define variable v-current-arm-code          as character    no-undo.
     2824   define variable v-current-store-type        as character    no-undo.
     2825   define variable v-current-store-code        as integer      no-undo.
     2826   define variable v-current-host-code         as integer      no-undo.
     2827   define variable is-flora     as character no-undo .
     2828   define variable par-type     as character no-undo.
     2829   define variable v-obj-host-code as integer   no-undo .
     2830   define variable p-sts   as integer   no-undo .
     2831   define variable p-rid-list                    as character no-undo .
     2832   define variable v-gdop-min-stock              as decimal   no-undo .
     2833   define variable v-grop-max-stock              as decimal   no-undo .
     2834   define variable v-grop-level-always-presence  as decimal   no-undo .
     2835   define variable v-grop-min-order              as decimal   no-undo .
     2836   define variable v-log as logical   no-undo .
