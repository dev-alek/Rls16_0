     3369   ON CHOOSE OF b-find-by-substring IN FRAME Dlg-grp
     3370   DO:
     3371       define variable v-new-name      as character    no-undo.
     3372       define variable v-new-code      as integer      no-undo.
     3373       define variable v-err-message   as character    no-undo.
     3374       if v-full-search-next = no
     3375       then do:
     3376           assign
     3377               v-full-search-string     = fi-search :screen-value
     3378               v-full-search-next       = yes
     3379               v-full-search-start-code = 0
     3380           .
     3381       end.
     3382       run grplib-analyze-grp-name in this-procedure (
     3383             input v-full-search-string
     3384           , input -1
     3385           , output v-err-message
     3386       ).
     3387       if v-err-message = "":U
     3388       then do:
     3389   if session :set-wait-state( "compiler" ) then.
     3390           run grplib-find-by-substring in this-procedure (
     3391               input v-full-search-start-code
     3392               , input v-full-search-string
     3393               , output v-new-code
     3394               , output v-new-name
     3395           ) no-error.
     3396           if error-status :error
     3397           then do:
     3398   if session :set-wait-state( "" ) then.
     3399               message return-value.
     3400               undo, return no-apply.
     3401           end.
     3402   if session :set-wait-state( "" ) then.
     3403           if v-new-code = 0
     3404           then do:
     3405               message
     3406                   skip "Не найдена строка '" v-full-search-string "' в имени группы."
     3407               view-as alert-box information
     3408               title "Поиск завершен".
     3409               assign
     3410                   v-new-name               = fi-search :screen-value
     3411                   v-full-search-string     = ""
     3412                   v-full-search-next       = no
     3413                   v-full-search-start-code = 0
     3414               .
     3415           end.
     3416           else do:
     3417               assign
     3418                   v-full-search-start-code = v-new-code
     3419               .
     3420           end.
     3421           assign
     3422               fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     3423               fi-search :cursor-offset = length( v-new-name ) + 1
     3424           .
     3425       end.
     3426       else do:
     3427           message
     3428               v-err-message
     3429               skip(1)
     3430               "Поиск в названиях групп производится по подстроке,"
     3431               skip "введённой в поле названия группы."
     3432           view-as alert-box information.
     3433       end.
     3434   END.
