     3316       ) no-error .
     3317       if error-status :error
     3318       then do:
     3319           message
     3320             vss-workfile vss-revision vss-description
     3321             skip "Ошибка при раскрытии дерева групп."
     3322             skip return-value
     3323             skip trim(error-status :get-message(1))
     3324                  trim(error-status :get-message(2))
     3325                  trim(error-status :get-message(3))
     3326                  trim(error-status :get-message(4))
     3327                  trim(error-status :get-message(5))
     3328           view-as alert-box error.
     3329   if session :set-wait-state( "" ) then.
