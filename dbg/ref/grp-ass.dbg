     2839   define variable filter-point as character no-undo init "Ассортиментная матрица" .
     2840   define variable filter-point0 as character no-undo init "Состав_ассортиментной_матрицы" .
     2841   define variable sort-column-name as character no-undo .
     2842   define variable v-db-num LIKE ub.db.db-num no-undo.
     2843   define variable v-type as character no-undo .
     2844   define variable p-mark as character no-undo .
