     2257   procedure correct-message :
     2258   define input  parameter p-longchar as longchar no-undo .
     2259   define variable v-longchar as longchar no-undo .
     2260   define variable v-err-ext  as logical  no-undo .
     2261     do
     2262     on error undo, return error return-value
     2263     :
     2264      run get-long-message in this-procedure  (output v-longchar ).
     2265       v-longchar = v-longchar + p-longchar.
     2266       v-err-ext  = true .
     2267       run set-long-message  in this-procedure  (input v-longchar,  input v-err-ext ).
     2268     end.
     2269   end procedure.
     2270   define variable v-longchar as longchar no-undo .
     2271   define variable v-err-ext as logical   no-undo .
     2272   procedure get-long-message  :
     2273   define output parameter p-longchar  as longchar no-undo .
     2274     do
     2275     on error undo, return error return-value
     2276     :
     2277        p-longchar = v-longchar .
     2278     end.
     2279   end procedure.
     2280   procedure set-long-message :
     2281   define input  parameter  p-longchar as longchar   no-undo .
     2282   define input  parameter  p-err-ext as logical   no-undo .
     2283     do
     2284     on error undo, return error return-value
     2285     :
     2286       v-longchar  =  p-longchar .
     2287       v-err-ext   =  p-err-ext  .
     2288     end.
     2289   end procedure.
