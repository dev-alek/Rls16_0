     3909                           , output v-new-name
     3910       ) no-error.
     3911       if error-status :error
     3912       then do:
     3913   if session :set-wait-state( "" ) then.
     3914           message return-value.
     3915           undo, return no-apply.
     3916       end.
     3917   if session :set-wait-state( "" ) then.
     3918       if v-new-code = 0
     3919       then do:
     3920           message
     3921               skip "Не найдена строка '" v-full-search-string "' в имени группы."
     3922           view-as alert-box information
     3923           title "Поиск завершен".
     3924           assign
     3925               v-new-name               = fi-search :screen-value
     3926               v-full-search-string     = ""
     3927               v-full-search-next       = no
     3928               v-full-search-start-code = 0
     3929           .
     3930       end.
     3931       else do:
     3932           assign
     3933               v-full-search-start-code = v-new-code
     3934           .
     3935       end.
     3936       assign
     3937           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     3938           fi-search :cursor-offset = length( v-new-name ) + 1
     3939       .
     3940   END.
     3941   ON LEAVE OF fi-search IN FRAME Dlg-grp
     3942   DO:
     3943       if fi-search :screen-value <> v-full-search-string
     3944       then do:
     3945           assign
     3946               v-full-search-string     = ""
     3947               v-full-search-next       = no
     3948               v-full-search-start-code = 0
     3949           .
     3950       end.
     3951   END.
     3952   ON RETURN OF fi-search IN FRAME Dlg-grp
     3953   DO:
     3954       define variable v-found    as logical      no-undo.
     3955       if fi-search :screen-value = ""
     3956       or fi-search :screen-value = ?
     3957       then do:
     3958           return no-apply.
     3959       end.
     3960       run find-grp-in-browse in this-procedure (
     3961             input fi-search :screen-value
     3962           , output v-found
     3963       ) no-error.
     3964       if error-status :error
     3965       then do:
     3966           message
     3967                    vss-workfile vss-revision vss-description
     3968               skip(1)
     3969               skip "Ошибка поиска группы."
     3970               skip return-value
     3971               skip trim(error-status :get-message(1))
     3972                    trim(error-status :get-message(2))
     3973                    trim(error-status :get-message(3))
     3974           view-as alert-box error.
     3975           undo, return no-apply .
     3976       end.
     3977       if v-found = no
     3978       then do:
     3979           message
     3980             skip "Группа не найдена."
     3981           view-as alert-box information.
     3982       end.
     3983       apply "ENTRY" to b-search in frame Dlg-grp.
     3984       return no-apply.
     3985   END.
     3986   ON VALUE-CHANGED OF RS-sts IN FRAME Dlg-grp
     3987   DO:
     3988     assign rs-sts.
     3989     OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     3990     END.
     3991   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dlg-grp:PARENT eq ?
     3992   THEN FRAME Dlg-grp:PARENT = ACTIVE-WINDOW.
     3993   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3994   on help of frame Dlg-grp
     3995   do:
     3996     run gbl/app_help.p
     3997       (input this-procedure :file-name
     3998       ,input ''
     3999       ,input ?
     4000       ) no-error.
     4001     if error-status :error then do:
     4002       message
     4003         "Ошибка при вызове помощи"
     4004         error-status :get-message(1)
     4005         view-as alert-box .
     4006     end.
     4007   end.
     4008   run minbtn-set in this-procedure .
     4009   on choose of b-help in frame Dlg-grp
     4010   do:
     4011     apply "help":u to frame Dlg-grp .
     4012   end.
     4013   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4014   procedure minbtn-set :
     4015       do
     4016           on error undo, return error return-value
     4017           :
     4018           define variable ii              as integer       no-undo .
     4019           define variable fh              as widget-handle no-undo .
     4020           define variable hh              as widget-handle no-undo .
     4021           define variable v-h             as handle        extent 4 no-undo .
     4022           define variable v-name-button   as character     no-undo .
     4023           define variable v-help-old-x    as decimal       no-undo .
     4024           define variable v-help-old-y    as decimal       no-undo .
     4025           define variable v-help-old-size as decimal       no-undo .
     4026           define variable v-frame-width   as decimal       no-undo .
     4027           define variable jj              as integer       no-undo .
     4028           do
     4029               on error undo, return error
     4030               :
     4031               assign
     4032                   v-frame-width = frame Dlg-grp:width - 0.3
     4033                   fh            = frame Dlg-grp:first-child
     4034                   hh            = fh:first-child
     4035                   ii            = 1
     4036                   .
     4037               do while valid-handle(hh):
     4038                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4039                   do:
     4040                       case lc(hh:name) :
     4041                           when "b-help" then
     4042                               do:
     4043                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4044                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4045                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4046                                   hh:TOOLTIP = "Помощь" .
     4047                                   v-help-old-x = hh:column .
     4048                                   v-help-old-y = hh:row    .
     4049                                   v-help-old-size = hh:width .
     4050                                   hh:width-chars = 2.5 .
     4051                               end.
     4052                           when "b-print" then
     4053                               do:
     4054                                   hh:load-image("cmp/b-print.bmp":u) .
     4055                                   hh:TOOLTIP = "Печать" .
     4056                                   v-h[ii] = hh:handle .
     4057                                   ii = ii + 1 .
     4058                                   hh:width-chars = 3 .
     4059                               end.
     4060                           when "b-history" or
     4061                           when "b-hist" then
     4062                               do:
     4063                                   hh:load-image("cmp/b-hist.bmp":u) .
     4064                                   hh:TOOLTIP = "История" .
     4065                                   v-h[ii] = hh:handle .
     4066                                   ii = ii + 1 .
     4067                                   hh:width-chars = 3 .
     4068                               end.
     4069                           when "b-sch" then
     4070                               do:
     4071                                   hh:load-image("cmp/b-sch.bmp":u) .
     4072                                   hh:TOOLTIP = "Установка Фильтра" .
     4073                                   v-h[ii] = hh:handle .
     4074                                   ii = ii + 1 .
     4075                                   hh:width-chars = 3 .
     4076                               end.
     4077                           when "b-hist-user" then
     4078                               do:
     4079                                   hh:load-image("cmp/b-hist.bmp":u) .
     4080                                   hh:TOOLTIP = "История пользователя" .
     4081                                   ii = ii + 1 .
     4082                               end.
     4083                       end case.
     4084                   end.
     4085                   hh = hh:next-sibling.
     4086               end.
     4087               b-help:column = v-frame-width - b-help:width-chars.
     4088               jj = 0.
     4089               repeat ii = 4 to 1 by -1 :
     4090                   if valid-handle (v-h[ii] ) then
     4091                   do:
     4092                       jj  = jj + 1 .
     4093                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4094                       v-h[ii]:row    = v-help-old-y .
     4095                   end.
     4096               end.
     4097           end.
     4098       end.
     4099   end procedure.
     4100   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4101   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4102   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4103   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4104   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4105   define variable v-diasize-current-frame-height as decimal   no-undo .
     4106   define variable v-diasize-change-size          as logical   no-undo .
     4107   define variable v-diasize-resize-button        as handle    no-undo .
     4108   define variable v-diasize-wndmax               as logical   no-undo .
     4109   define variable v-diasize-wndstore             as logical   no-undo .
     4110   define variable v-diasize-proc-name            as character no-undo .
     4111   define variable v-diasize-browse-handle        as handle    no-undo .
     4112   define variable v-diasize-browse-number        as integer   no-undo .
     4113   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4114   define temp-table temp-diasize-handle no-undo
     4115     field handle-value  as handle
     4116     field save-position as decimal
     4117     index xpk is primary unique handle-value
     4118     .
     4119   define temp-table temp-browse-handle no-undo
     4120     field browse-type   as character
     4121     field browse-number as integer
     4122     field browse-handle as handle
     4123     field original-size as decimal
     4124     index xpk is primary unique browse-type browse-number
     4125     index xie browse-type browse-handle
     4126   .
     4127   procedure diasize_change-height :
     4128     define input  parameter p-change-value  as decimal   no-undo .
     4129     define input  parameter p-move-resize   as logical   no-undo .
     4130     define variable v-field-group-handle    as handle    no-undo .
     4131     define variable v-object-handle         as handle    no-undo .
     4132     define variable v-frame-height          as decimal   no-undo .
     4133     define variable v-frame-virtual-height  as decimal   no-undo .
     4134     define variable v-browse-height         as decimal   no-undo .
     4135     define variable v-window-height         as decimal   no-undo .
     4136     define variable v-window-virtual-height as decimal   no-undo .
     4137     define variable v-change-sign           as integer   no-undo .
     4138     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4139     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4140     if p-change-value > 0
     4141     then do:
     4142       if frame Dlg-grp :height + p-change-value
     4143           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4144       then do:
     4145         assign
     4146           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4147                           - (frame Dlg-grp :height-chars)
     4148         .
     4149         if p-change-value <= 0
     4150         then do:
     4151           run diasize_position-resize-button in this-procedure .
     4152           return .
     4153         end.
     4154       end.
     4155     end.
     4156     if p-change-value < 0
     4157     then do:
     4158       if frame Dlg-grp :height + p-change-value < v-diasize-orig-frame-height
     4159       then do:
     4160         assign
     4161           p-change-value = v-diasize-orig-frame-height
     4162                          - (frame Dlg-grp :height-chars)
     4163         .
     4164         if p-change-value >= 0
     4165         then do:
     4166           run diasize_position-resize-button in this-procedure .
     4167           return .
     4168         end.
     4169       end.
     4170     end.
     4171     if p-change-value >= 0
     4172     then do:
     4173       assign
     4174         v-change-sign = 1
     4175       .
     4176     end.
     4177     else do:
     4178       assign
     4179         v-change-sign = -1
     4180       .
     4181     end.
     4182     assign
     4183       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4184     .
     4185     if p-change-value = 0
     4186     then do:
     4187       run diasize_position-resize-button in this-procedure .
     4188       return .
     4189     end.
     4190     move_block:
     4191     do
     4192     on error undo move_block, retry move_block
     4193     :
     4194       if retry
     4195       then do:
     4196         do
     4197         on error undo move_block, leave move_block
     4198         :
     4199           if p-change-value > 0
     4200           then do:
     4201             for each buf_temp-diasize-handle
     4202             on error undo, next
     4203             :
     4204               assign
     4205                 v-object-handle = buf_temp-diasize-handle.handle-value
     4206               .
     4207               if v-object-handle <> v-diasize-resize-button
     4208               then do:
     4209                 assign
     4210                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4211                 .
     4212               end.
     4213             end.
     4214             assign
     4215               v-diasize-browse-handle :height = v-browse-height
     4216             .
     4217             for each buf_temp-browse-handle
     4218               where buf_temp-browse-handle.browse-type = 'height':u
     4219             on error undo, next
     4220             :
     4221               assign
     4222                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4223               .
     4224             end.
     4225             assign
     4226               frame Dlg-grp :height = v-frame-height
     4227             .
     4228             if frame Dlg-grp :scrollable = true
     4229             then do:
     4230               assign
     4231                 frame Dlg-grp :virtual-height = v-frame-virtual-height
     4232               .
     4233             end.
     4234             run diasize_position-resize-button in this-procedure .
     4235           end.
     4236           else do:
     4237             if frame Dlg-grp :scrollable = true
     4238             then do:
     4239               assign
     4240                 frame Dlg-grp :virtual-height = v-frame-virtual-height
     4241               .
     4242             end.
     4243             assign
     4244               frame Dlg-grp :height = v-frame-height
     4245             .
     4246             assign
     4247               v-diasize-browse-handle :height = v-browse-height
     4248             .
     4249             for each buf_temp-browse-handle
     4250               where buf_temp-browse-handle.browse-type = 'height':u
     4251             on error undo, next
     4252             :
     4253               assign
     4254                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4255               .
     4256             end.
     4257             for each buf_temp-diasize-handle
     4258             on error undo, next
     4259             :
     4260               assign
     4261                 v-object-handle = buf_temp-diasize-handle.handle-value
     4262               .
     4263               if v-object-handle <> v-diasize-resize-button
     4264               then do:
     4265                 assign
     4266                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4267                 .
     4268               end.
     4269             end.
     4270             run diasize_position-resize-button in this-procedure .
     4271           end.
     4272           assign
     4273             v-diasize-change-size = false
     4274           .
     4275           leave move_block .
     4276         end.
     4277       end.
     4278       assign
     4279         v-diasize-need-full-display = true
     4280       .
     4281       if v-diasize-change-size = false
     4282       then do:
     4283         assign
     4284           v-diasize-change-size = true
     4285         .
     4286       end.
     4287       else do:
     4288         return .
     4289       end.
     4290       assign
     4291         v-frame-height = frame Dlg-grp :height
     4292         v-frame-virtual-height = frame Dlg-grp :virtual-height
     4293         v-browse-height = v-diasize-browse-handle :height
     4294       .
     4295       for each buf_temp-browse-handle
     4296         where buf_temp-browse-handle.browse-type = 'height':u
     4297       :
     4298         assign
     4299           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     4300         .
     4301       end.
     4302       for each buf_temp-diasize-handle
     4303       :
     4304         delete buf_temp-diasize-handle .
     4305       end.
     4306       assign
     4307         v-field-group-handle = frame Dlg-grp :first-child
     4308       .
     4309       do while valid-handle(v-field-group-handle)
     4310       :
     4311         assign
     4312           v-object-handle = v-field-group-handle :first-child
     4313         .
     4314         do while valid-handle(v-object-handle)
     4315         :
     4316           if  v-object-handle <> v-diasize-browse-handle :handle
     4317           and can-query(v-object-handle, "row")
     4318           and can-query(v-object-handle, "height")
     4319           and ( v-object-handle :row > v-diasize-browse-handle :row )
     4320           then do:
     4321             find first buf_temp-browse-handle
     4322               where buf_temp-browse-handle.browse-type   = 'height':u
     4323                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4324               no-error .
     4325             if available buf_temp-browse-handle
     4326             then do:
     4327             end.
     4328             else do:
     4329               create buf_temp-diasize-handle .
     4330               assign
     4331                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4332                 buf_temp-diasize-handle.save-position = v-object-handle :row
     4333               .
     4334             end.
     4335           end.
     4336           assign
     4337             v-object-handle = v-object-handle :next-sibling
     4338           .
     4339         end.
     4340         assign
     4341           v-field-group-handle = v-field-group-handle :next-sibling
     4342         .
     4343       end.
     4344       do with frame Dlg-grp
     4345       :
     4346         hide v-diasize-resize-button .
     4347         assign
     4348           v-diasize-resize-button :row    = 1
     4349           v-diasize-resize-button :column = 1
     4350         .
     4351       end.
     4352       if p-change-value > 0
     4353       then do:
     4354         if frame Dlg-grp :scrollable = true
     4355         then do:
     4356           assign
     4357             frame Dlg-grp :virtual-height = frame Dlg-grp :virtual-height + p-change-value
     4358             no-error .
     4359           if error-status :error
     4360           or error-status :get-message(1) <> ""
     4361           then do:
     4362             undo move_block, retry move_block .
     4363           end.
     4364         end.
     4365         assign
     4366           frame Dlg-grp :height = frame Dlg-grp :height + p-change-value
     4367           no-error .
     4368         if error-status :error
     4369         or error-status :get-message(1) <> ""
     4370         then do:
     4371           undo move_block, retry move_block .
     4372         end.
     4373         assign
     4374           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4375           no-error .
     4376         if error-status :error
     4377         or error-status :get-message(1) <> ""
     4378         then do:
     4379           undo move_block, retry move_block .
     4380         end.
     4381         for each buf_temp-browse-handle
     4382           where buf_temp-browse-handle.browse-type = 'height':u
     4383         on error undo move_block, retry move_block
     4384         :
     4385           assign
     4386             buf_temp-browse-handle.browse-handle :height
     4387               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4388             no-error .
     4389           if error-status :error
     4390           or error-status :get-message(1) <> ""
     4391           then do:
     4392             undo move_block, retry move_block .
     4393           end.
     4394         end.
     4395         for each buf_temp-diasize-handle
     4396         on error undo move_block, retry move_block
     4397         :
     4398           assign
     4399             v-object-handle = buf_temp-diasize-handle.handle-value
     4400           .
     4401           if v-object-handle <> v-diasize-resize-button
     4402           then do:
     4403             assign
     4404               v-object-handle :row = v-object-handle :row + p-change-value
     4405               no-error .
     4406             if error-status :error
     4407             or error-status :get-message(1) <> ""
     4408             then do:
     4409               undo move_block, retry move_block .
     4410             end.
     4411           end.
     4412         end.
     4413       end.
     4414       else do:
     4415         for each buf_temp-diasize-handle
     4416         on error undo move_block, retry move_block
     4417         :
     4418           assign
     4419             v-object-handle = buf_temp-diasize-handle.handle-value
     4420           .
     4421           if v-object-handle <> v-diasize-resize-button
     4422           then do:
     4423             assign
     4424               v-object-handle :row = v-object-handle :row + p-change-value
     4425               no-error .
     4426             if error-status :error
     4427             or error-status :get-message(1) <> ""
     4428             then do:
     4429               undo move_block, retry move_block .
     4430             end.
     4431           end.
     4432         end.
     4433         assign
     4434           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4435           no-error .
     4436         if error-status :error
     4437         or error-status :get-message(1) <> ""
     4438         then do:
     4439           undo move_block, retry move_block .
     4440         end.
     4441         for each buf_temp-browse-handle
     4442           where buf_temp-browse-handle.browse-type = 'height':u
     4443         on error undo move_block, retry move_block
     4444         :
     4445           assign
     4446             buf_temp-browse-handle.browse-handle :height
     4447               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4448             no-error .
     4449           if error-status :error
     4450           or error-status :get-message(1) <> ""
     4451           then do:
     4452             undo move_block, retry move_block .
     4453           end.
     4454         end.
     4455         assign
     4456           frame Dlg-grp :height = frame Dlg-grp :height + p-change-value
     4457           no-error .
     4458         if error-status :error
     4459         or error-status :get-message(1) <> ""
     4460         then do:
     4461           undo move_block, retry move_block .
     4462         end.
     4463         if frame Dlg-grp :scrollable = true
     4464         then do:
     4465           assign
     4466             frame Dlg-grp :virtual-height = frame Dlg-grp :virtual-height + p-change-value
     4467             no-error .
     4468           if error-status :error
     4469           or error-status :get-message(1) <> ""
     4470           then do:
     4471             undo move_block, retry move_block .
     4472           end.
     4473         end.
     4474       end.
     4475       if p-move-resize = true
     4476       then do:
     4477         run diasize_position-resize-button in this-procedure .
     4478       end.
     4479       if v-diasize-wndstore = true
     4480       then do:
     4481         if connected("ub") = true
     4482         then do:
     4483           define variable v-cntxt-db-num        as integer   no-undo .
     4484           define variable v-cntxt-userid        as character no-undo .
     4485           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4486                                             , OUTPUT v-cntxt-userid
     4487                                             ) .
     4488           run gbl/wndsizew.p
     4489             (input  v-cntxt-db-num
     4490             ,input  v-cntxt-userid
     4491             ,input  v-diasize-proc-name
     4492             ,input  'height':u
     4493             ,input  string(frame Dlg-grp :height - v-diasize-orig-frame-height)
     4494             ) .
     4495         end.
     4496       end.
     4497     end.
     4498     assign
     4499       v-diasize-change-size = false
     4500     .
     4501   end procedure.
     4502   procedure diasize_set-height :
     4503     define input  parameter p-new-height  as decimal   no-undo .
     4504     define input  parameter p-move-resize as logical   no-undo .
     4505     do
     4506     on error undo, return error return-value
     4507     :
     4508       run diasize_change-height in this-procedure
     4509         (input  (p-new-height - frame Dlg-grp :height)
     4510         ,input  p-move-resize
     4511         ) .
     4512     end.
     4513   end procedure.
     4514   procedure diasize_change-width :
     4515     define input  parameter p-change-value as decimal   no-undo .
     4516     define input  parameter p-move-resize  as logical   no-undo .
     4517     define variable v-field-group-handle   as handle    no-undo .
     4518     define variable v-object-handle        as handle    no-undo .
     4519     define variable v-frame-width          as decimal   no-undo .
     4520     define variable v-frame-virtual-width  as decimal   no-undo .
     4521     define variable v-browse-width         as decimal   no-undo .
     4522     define variable v-window-width         as decimal   no-undo .
     4523     define variable v-window-virtual-width as decimal   no-undo .
     4524     define variable v-change-sign          as integer   no-undo .
     4525     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4526     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4527     if p-change-value > 0
     4528     then do:
     4529       if frame Dlg-grp :width + p-change-value >
     4530           session :width-chars
     4531       then do:
     4532         assign
     4533           p-change-value = session :width-chars - frame Dlg-grp :width
     4534         .
     4535         if p-change-value <= 0
     4536         then do:
     4537           run diasize_position-resize-button in this-procedure .
     4538           return .
     4539         end.
     4540       end.
     4541     end.
     4542     if p-change-value < 0
     4543     then do:
     4544       if frame Dlg-grp :width + p-change-value < v-diasize-orig-frame-width
     4545       then do:
     4546         assign
     4547           p-change-value = v-diasize-orig-frame-width
     4548                          - frame Dlg-grp :width
     4549         .
     4550         if p-change-value >= 0
     4551         then do:
     4552           run diasize_position-resize-button in this-procedure .
     4553           return .
     4554         end.
     4555       end.
     4556     end.
     4557     if p-change-value >= 0
     4558     then do:
     4559       assign
     4560         v-change-sign = 1
     4561       .
     4562     end.
     4563     else do:
     4564       assign
     4565         v-change-sign = -1
     4566       .
     4567     end.
     4568     assign
     4569       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4570     .
     4571     if p-change-value = 0
     4572     then do:
     4573       run diasize_position-resize-button in this-procedure .
     4574       return .
     4575     end.
     4576     move_block:
     4577     do
     4578     on error undo move_block, leave move_block
     4579     :
     4580       if retry
     4581       then do:
     4582         do
     4583         on error undo move_block, leave move_block
     4584         :
     4585           if p-change-value > 0
     4586           then do:
     4587             for each buf_temp-diasize-handle
     4588             on error undo, next
     4589             :
     4590               assign
     4591                 v-object-handle = buf_temp-diasize-handle.handle-value
     4592               .
     4593               if v-object-handle <> v-diasize-resize-button
     4594               then do:
     4595                 assign
     4596                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4597                 .
     4598               end.
     4599             end.
     4600             assign
     4601               v-diasize-browse-handle :width = v-browse-width
     4602             .
     4603             for each buf_temp-browse-handle
     4604               where buf_temp-browse-handle.browse-type = 'width':u
     4605             on error undo, next
     4606             :
     4607               assign
     4608                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4609               .
     4610             end.
     4611             assign
     4612               frame Dlg-grp :width = v-frame-width
     4613             .
     4614             if frame Dlg-grp :scrollable = true
     4615             then do:
     4616               assign
     4617                 frame Dlg-grp :virtual-width = v-frame-virtual-width
     4618               .
     4619             end.
     4620             run diasize_position-resize-button in this-procedure .
     4621           end.
     4622           else do:
     4623             if frame Dlg-grp :scrollable = true
     4624             then do:
     4625               assign
     4626                 frame Dlg-grp :virtual-width = v-frame-virtual-width
     4627               .
     4628             end.
     4629             assign
     4630               frame Dlg-grp :width = v-frame-width
     4631             .
     4632             for each buf_temp-browse-handle
     4633               where buf_temp-browse-handle.browse-type = 'width':u
     4634             on error undo, next
     4635             :
     4636               assign
     4637                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4638               .
     4639             end.
     4640             assign
     4641               v-diasize-browse-handle :width = v-browse-width
     4642             .
     4643             for each buf_temp-diasize-handle
     4644             on error undo, next
     4645             :
     4646               assign
     4647                 v-object-handle = buf_temp-diasize-handle.handle-value
     4648               .
     4649               if v-object-handle <> v-diasize-resize-button
     4650               then do:
     4651                 assign
     4652                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4653                 .
     4654               end.
     4655             end.
     4656             run diasize_position-resize-button in this-procedure .
     4657           end.
     4658           assign
     4659             v-diasize-change-size = false
     4660           .
     4661           leave move_block .
     4662         end.
     4663       end.
     4664       assign
     4665         v-diasize-need-full-display = true
     4666       .
     4667       if v-diasize-change-size = false
     4668       then do:
     4669         assign
     4670           v-diasize-change-size = true
     4671         .
     4672       end.
     4673       else do:
     4674         return .
     4675       end.
     4676       assign
     4677         v-frame-width = frame Dlg-grp :width
     4678         v-frame-virtual-width = frame Dlg-grp :virtual-width
     4679         v-browse-width = v-diasize-browse-handle :width
     4680       .
     4681       for each buf_temp-browse-handle
     4682         where buf_temp-browse-handle.browse-type = 'width':u
     4683       :
     4684         assign
     4685           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4686         .
     4687       end.
     4688       for each buf_temp-diasize-handle
     4689       :
     4690         delete buf_temp-diasize-handle .
     4691       end.
     4692       assign
     4693         v-field-group-handle = frame Dlg-grp :first-child
     4694       .
     4695       do while valid-handle(v-field-group-handle)
     4696       :
     4697         assign
     4698           v-object-handle = v-field-group-handle :first-child
     4699         .
     4700         do while valid-handle(v-object-handle)
     4701         :
     4702           if  v-object-handle <> v-diasize-browse-handle :handle
     4703           and v-object-handle <> v-diasize-resize-button
     4704           and can-query(v-object-handle, "row")
     4705           and can-query(v-object-handle, "height")
     4706           and ( v-object-handle :col + v-object-handle :width
     4707                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4708               )
     4709           then do:
     4710             find first buf_temp-browse-handle
     4711               where buf_temp-browse-handle.browse-type   = 'width':u
     4712                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4713               no-error .
     4714             if available buf_temp-browse-handle
     4715             then do:
     4716             end.
     4717             else do:
     4718               create buf_temp-diasize-handle .
     4719               assign
     4720                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4721                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4722               .
     4723             end.
     4724           end.
     4725           assign
     4726             v-object-handle = v-object-handle :next-sibling
     4727           .
     4728         end.
     4729         assign
     4730           v-field-group-handle = v-field-group-handle :next-sibling
     4731         .
     4732       end.
     4733       do with frame Dlg-grp
     4734       :
     4735         hide v-diasize-resize-button .
     4736         v-diasize-resize-button :row = 1.
     4737         v-diasize-resize-button :column = 1.
     4738       end.
     4739       if p-change-value > 0
     4740       then do:
     4741         if frame Dlg-grp :scrollable = true
     4742         then do:
     4743           assign
     4744             frame Dlg-grp :virtual-width = frame Dlg-grp :virtual-width + p-change-value
     4745             no-error .
     4746           if error-status :error
     4747           or error-status :get-message(1) <> ""
     4748           then do:
     4749             undo move_block, retry move_block.
     4750           end.
     4751         end.
     4752         assign
     4753           frame Dlg-grp :width = v-frame-width + p-change-value
     4754           no-error .
     4755         if error-status :error
     4756         or error-status :get-message(1) <> ""
     4757         then do:
     4758           undo move_block, retry move_block.
     4759         end.
     4760         assign
     4761           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4762         no-error .
     4763         if error-status :error
     4764         or error-status :get-message(1) <> ""
     4765         then do:
     4766           undo move_block, retry move_block.
     4767         end.
     4768         for each buf_temp-browse-handle
     4769           where buf_temp-browse-handle.browse-type = 'width':u
     4770         on error undo move_block, retry move_block
     4771         :
     4772           assign
     4773             buf_temp-browse-handle.browse-handle :width
     4774               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4775             no-error .
     4776           if error-status :error
     4777           or error-status :get-message(1) <> ""
     4778           then do:
     4779             undo move_block, retry move_block .
     4780           end.
     4781         end.
     4782         for each buf_temp-diasize-handle
     4783         on error undo move_block, retry move_block
     4784         :
     4785           assign
     4786             v-object-handle = buf_temp-diasize-handle.handle-value
     4787           .
     4788           if v-object-handle <> v-diasize-resize-button
     4789           then do:
     4790             assign
     4791               v-object-handle :col = v-object-handle :col + p-change-value
     4792               no-error .
     4793             if error-status :error
     4794             or error-status :get-message(1) <> ""
     4795             then do:
     4796               undo move_block, retry move_block .
     4797             end.
     4798           end.
     4799         end.
     4800       end.
     4801       else do:
     4802         for each buf_temp-diasize-handle
     4803         on error undo move_block, retry move_block
     4804         :
     4805           assign
     4806             v-object-handle = buf_temp-diasize-handle.handle-value
     4807           .
     4808           if v-object-handle <> v-diasize-resize-button
     4809           then do:
     4810             assign
     4811               v-object-handle :col = v-object-handle :col + p-change-value
     4812               no-error .
     4813             if error-status :error
     4814             or error-status :get-message(1) <> ""
     4815             then do:
     4816               undo move_block, retry move_block .
     4817             end.
     4818           end.
     4819         end.
     4820         for each buf_temp-browse-handle
     4821           where buf_temp-browse-handle.browse-type = 'width':u
     4822         on error undo move_block, retry move_block
     4823         :
     4824           assign
     4825             buf_temp-browse-handle.browse-handle :width
     4826               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4827             no-error .
     4828           if error-status :error
     4829           or error-status :get-message(1) <> ""
     4830           then do:
     4831             undo move_block, retry move_block .
     4832           end.
     4833         end.
     4834         assign
     4835           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4836           no-error .
     4837         if error-status :error
     4838         or error-status :get-message(1) <> ""
     4839         then do:
     4840           undo move_block, retry move_block.
     4841         end.
     4842         assign
     4843           frame Dlg-grp :width = frame Dlg-grp :width + p-change-value
     4844         no-error .
     4845         if error-status :error
     4846         or error-status :get-message(1) <> ""
     4847         then do:
     4848           undo move_block, retry move_block.
     4849         end.
     4850         if frame Dlg-grp :scrollable = true
     4851         then do:
     4852           assign
     4853             frame Dlg-grp :virtual-width = frame Dlg-grp :virtual-width + p-change-value
     4854           no-error .
     4855           if error-status :error
     4856           or error-status :get-message(1) <> ""
     4857           then do:
     4858             undo move_block, retry move_block.
     4859           end.
     4860         end.
     4861       end.
     4862       if p-move-resize
     4863       then do:
     4864         run diasize_position-resize-button in this-procedure .
     4865       end.
     4866       if v-diasize-wndstore = true
     4867       then do:
     4868         if connected("ub") = true
     4869         then do:
     4870           define variable v-cntxt-db-num        as integer   no-undo .
     4871           define variable v-cntxt-userid        as character no-undo .
     4872           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4873                                             , OUTPUT v-cntxt-userid
     4874                                             ) .
     4875           run gbl/wndsizew.p
     4876             (input  v-cntxt-db-num
     4877             ,input  v-cntxt-userid
     4878             ,input  v-diasize-proc-name
     4879             ,input  'width':u
     4880             ,input  string(frame Dlg-grp :width - v-diasize-orig-frame-width)
     4881             ) .
     4882         end.
     4883       end.
     4884     end.
     4885     assign
     4886       v-diasize-change-size = false
     4887     .
     4888   end procedure.
     4889   procedure diasize_set-width :
     4890     define input  parameter p-new-width  as decimal   no-undo .
     4891     define input  parameter p-move-resize as logical   no-undo .
     4892     do
     4893     on error undo, return error return-value
     4894     :
     4895       run diasize_change-width in this-procedure
     4896         (input  (p-new-width - frame Dlg-grp :width)
     4897         ,input  p-move-resize
     4898         ) .
     4899     end.
     4900   end procedure.
     4901   procedure diasize_position-resize-button :
     4902     do with frame Dlg-grp
     4903     :
     4904       hide v-diasize-resize-button .
     4905       assign
     4906         v-diasize-resize-button :row = frame Dlg-grp :height - v-diasize-resize-button :height
     4907                     - 1
     4908                     - (frame Dlg-grp :border-bottom-pixels / session :pixels-per-row)
     4909         v-diasize-resize-button :col = frame Dlg-grp :width - v-diasize-resize-button :width
     4910                     - 1
     4911                     - (frame Dlg-grp :border-right-pixels / session :pixels-per-column)
     4912       .
     4913       view v-diasize-resize-button .
     4914     end.
     4915   end procedure.
     4916   on alt-right anywhere
     4917   do:
     4918     run diasize_change-width in this-procedure
     4919       (input 1
     4920       ,input true
     4921       ) .
     4922     return no-apply .
     4923   end.
     4924   on alt-left anywhere
     4925   do:
     4926     run diasize_change-width in this-procedure
     4927       (input -1
     4928       ,input true
     4929       ) .
     4930     return no-apply .
     4931   end.
     4932   on alt-down anywhere
     4933   do:
     4934     run diasize_change-height in this-procedure
     4935       (input 1
     4936       ,input true
     4937       ) .
     4938     return no-apply .
     4939   end.
     4940   on alt-up anywhere
     4941   do:
     4942     run diasize_change-height in this-procedure
     4943       (input -1
     4944       ,input true
     4945       ) .
     4946     return no-apply .
     4947   end.
     4948   on alt-enter of frame Dlg-grp
     4949   do:
     4950     run diasize_maximize in this-procedure
     4951       (input  ?
     4952       ).
     4953     return no-apply .
     4954   end.
     4955   procedure diasize_end-move :
     4956     do
     4957     on error undo, return error return-value
     4958     :
     4959       define variable v-row-delta as decimal   no-undo .
     4960       define variable v-col-delta as decimal   no-undo .
     4961       define variable v-new-row as decimal   no-undo .
     4962       define variable v-new-col as decimal   no-undo .
     4963       assign
     4964         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4965         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4966       .
     4967       assign
     4968         v-row-delta = v-new-row - frame Dlg-grp :height
     4969         v-col-delta = v-new-col - frame Dlg-grp :width
     4970       .
     4971       run diasize_change-height in this-procedure
     4972         (input v-row-delta
     4973         ,input true
     4974         ) .
     4975       run diasize_change-width in this-procedure
     4976         (input v-col-delta
     4977         ,input true
     4978         ) .
     4979     end.
     4980   end procedure.
     4981   procedure diasize_maximize :
     4982     define input  parameter p-action as logical   no-undo .
     4983     do
     4984     on error undo, return error return-value
     4985     :
     4986       if p-action = ?
     4987       then do:
     4988         if v-diasize-need-maximize = true
     4989         then do:
     4990           assign
     4991             p-action = true
     4992           .
     4993         end.
     4994         else do:
     4995           assign
     4996             p-action = false
     4997           .
     4998         end.
     4999       end.
     5000       if p-action = true
     5001       then do:
     5002         run diasize_change-height in this-procedure
     5003           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5004               - frame Dlg-grp :height-chars
     5005           ,input true
     5006           ) .
     5007         run diasize_change-width in this-procedure
     5008           (input session :width-chars
     5009               - frame Dlg-grp :width-chars
     5010           ,input true
     5011           ) .
     5012         assign
     5013           v-diasize-need-maximize = false
     5014         .
     5015       end.
     5016       else do:
     5017         run diasize_change-width in this-procedure
     5018           (input v-diasize-orig-frame-width
     5019               - frame Dlg-grp :width-chars
     5020           ,input true
     5021           ) .
     5022         run diasize_change-height in this-procedure
     5023           (input v-diasize-orig-frame-height
     5024               - frame Dlg-grp :height-chars
     5025           ,input true
     5026           ) .
     5027         assign
     5028           v-diasize-need-maximize = true
     5029         .
     5030       end.
     5031     end.
     5032   end procedure.
     5033   procedure diasize_restore-orig-size :
     5034     do
     5035     on error undo, return error return-value
     5036     :
     5037       assign
     5038         v-diasize-current-frame-width  = frame Dlg-grp :width
     5039         v-diasize-current-frame-height = frame Dlg-grp :height
     5040       .
     5041       run diasize_set-height in this-procedure
     5042         (input  v-diasize-orig-frame-height
     5043         ,input  true
     5044         ) .
     5045       run diasize_set-width in this-procedure
     5046         (input  v-diasize-orig-frame-width
     5047         ,input  true
     5048         ) .
     5049     end.
     5050   end procedure.
     5051   procedure diasize_restore-current-size :
     5052     do
     5053     on error undo, return error return-value
     5054     :
     5055       run diasize_set-height in this-procedure
     5056         (input  v-diasize-current-frame-height
     5057         ,input  true
     5058         ) .
     5059       run diasize_set-width in this-procedure
     5060         (input  v-diasize-current-frame-width
     5061         ,input  true
     5062         ) .
     5063     end.
     5064   end procedure.
     5065   procedure diasize_set-browse-handle :
     5066     define input  parameter p-browse-handle as handle   no-undo .
     5067     define buffer buf_temp-browse-handle for temp-browse-handle .
     5068     do
     5069     on error undo, return error return-value
     5070     :
     5071       assign
     5072         v-diasize-browse-handle = p-browse-handle
     5073       .
     5074       for each buf_temp-browse-handle
     5075       on error undo, return error return-value
     5076       :
     5077         delete buf_temp-browse-handle .
     5078       end.
     5079     end.
     5080   end procedure.
     5081   procedure diasize_add_browse :
     5082     define input  parameter p-browse-type   as character no-undo .
     5083     define input  parameter p-browse-handle as handle    no-undo .
     5084     define buffer buf_temp-browse-handle for temp-browse-handle .
     5085     do
     5086     on error undo, return error return-value
     5087     :
     5088       assign
     5089         v-diasize-browse-number = v-diasize-browse-number + 1
     5090       .
     5091       create buf_temp-browse-handle .
     5092       assign
     5093         buf_temp-browse-handle.browse-type   = p-browse-type
     5094         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5095         buf_temp-browse-handle.browse-handle = p-browse-handle
     5096       .
     5097     end.
     5098   end procedure.
     5099   procedure diasize_init :
     5100     define variable v-default-value    as logical   no-undo .
     5101     define variable v-restore-saved    as logical   no-undo .
     5102     define variable v-resize-value-str as character no-undo .
     5103     do
     5104     on error undo, return error return-value
     5105     :
     5106       do with frame Dlg-grp
     5107       :
     5108         assign
     5109           v-diasize-orig-frame-height = frame Dlg-grp :height
     5110           v-diasize-orig-frame-width  = frame Dlg-grp :width
     5111           v-diasize-browse-handle     = browse br-list :handle
     5112         .
     5113         create button v-diasize-resize-button
     5114         assign
     5115           parent        = frame Dlg-grp :first-child
     5116           label         = "s"
     5117           height-pixels = 16
     5118           width-pixels  = 16
     5119           visible       = true
     5120           sensitive     = true
     5121           movable       = true
     5122           triggers:
     5123             on end-move persistent run diasize_end-move in this-procedure .
     5124           end triggers.
     5125         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5126         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5127         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5128         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5129         assign
     5130           v-diasize-wndmax = false
     5131         .
     5132         if connected("ub") = true
     5133         then do:
     5134           define variable v-cntxt-db-num        as integer   no-undo .
     5135           define variable v-cntxt-userid        as character no-undo .
     5136           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5137                                             , OUTPUT v-cntxt-userid
     5138                                             ) .
     5139           run gbl/wndpar_r.p
     5140             (input  v-cntxt-db-num
     5141             ,input  v-cntxt-userid
     5142             ,input  'wndmax':U
     5143             ,output v-diasize-wndmax
     5144             ,output v-default-value
     5145             ) .
     5146         end.
     5147         assign
     5148           v-diasize-wndstore = false
     5149         .
     5150         if connected("ub") = true
     5151         then do:
     5152           run gbl/wndpar_r.p
     5153             (input  v-cntxt-db-num
     5154             ,input  v-cntxt-userid
     5155             ,input  'wndstore':U
     5156             ,output v-diasize-wndstore
     5157             ,output v-default-value
     5158             ) .
     5159         end.
     5160         assign
     5161           v-diasize-proc-name = entry(1, program-name(2), '.')
     5162         .
     5163         if v-diasize-wndstore = true
     5164         then do:
     5165           assign
     5166             v-restore-saved = false
     5167           .
     5168           if connected("ub") = true
     5169           then do:
     5170             run gbl/wndsizer.p
     5171               (input  v-cntxt-db-num
     5172               ,input  v-cntxt-userid
     5173               ,input  v-diasize-proc-name
     5174               ,input  'height':u
     5175               ,output v-resize-value-str
     5176               ) .
     5177             if v-resize-value-str <> '':U
     5178             then do:
     5179               run diasize_change-height in this-procedure
     5180                 (input  integer(v-resize-value-str)
     5181                 ,input  true
     5182                 ) .
     5183               assign
     5184                 v-restore-saved = true
     5185               .
     5186             end.
     5187           end.
     5188           if connected("ub") = true
     5189           then do:
     5190             run gbl/wndsizer.p
     5191               (input  v-cntxt-db-num
     5192               ,input  v-cntxt-userid
     5193               ,input  v-diasize-proc-name
     5194               ,input  'width':u
     5195               ,output v-resize-value-str
     5196               ) .
     5197             if v-resize-value-str <> '':U
     5198             then do:
     5199               run diasize_change-width in this-procedure
     5200                 (input  integer(v-resize-value-str)
     5201                 ,input  true
     5202                 ) .
     5203               assign
     5204                 v-restore-saved = true
     5205               .
     5206             end.
     5207           end.
     5208           if v-restore-saved <> true
     5209           then do:
     5210             if v-diasize-wndmax = true
     5211             then do:
     5212               run diasize_maximize in this-procedure
     5213                 (input  true
     5214                 ) .
     5215             end.
     5216           end.
     5217         end.
     5218         else do:
     5219           if v-diasize-wndmax = true
     5220           then do:
     5221             run diasize_maximize in this-procedure
     5222               (input  true
     5223               ) .
     5224           end.
     5225         end.
     5226       end.
     5227     end.
     5228   end procedure.
     5229   procedure diasize_need-full-display :
     5230     define output parameter p-need-full-display as logical   no-undo .
     5231     do
     5232     on error undo, return error return-value
     5233     :
     5234       assign
     5235         p-need-full-display = v-diasize-need-full-display
     5236       .
     5237       assign
     5238         v-diasize-need-full-display = false
     5239       .
     5240     end.
     5241   end procedure.
     5242   procedure get-context :
     5243      define output parameter p-db-num as integer          no-undo.
     5244      define output parameter p-user-id as character        no-undo.
     5245      define variable v-login               as character    no-undo.
     5246      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5247      define buffer buf_user-login  for ub.user-login .
     5248      do
     5249      on error undo, return error
     5250      :
     5251            FIND FIRST buf_sys-ctrl no-lock.
     5252            ASSIGN
     5253               v-login = USERID("ub")
     5254               p-db-num = buf_sys-ctrl.db-num
     5255            .
     5256            FIND FIRST buf_user-login
     5257                 WHERE buf_user-login.db-num = p-db-num
     5258                   AND buf_user-login.user-login = v-login
     5259                 no-lock
     5260                 no-error
     5261                 .
     5262            IF AVAILABLE buf_user-login
     5263            THEN DO:
     5264               assign
     5265                  p-user-id = buf_user-login.user-id
     5266               .
     5267            END.
     5268      end.
     5269   end procedure.
     5270   run diasize_add_browse in this-procedure
     5271     (input  'width':u
     5272     ,input  browse BROWSE-am-goods:handle
     5273     ) .
     5274   run diasize_init in this-procedure .
     5275   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5276   on F9 of frame Dlg-grp anywhere do:
     5277     run init-gds-rec.
     5278     if gds-rec = ? then
     5279       return no-apply.
     5280     run ref/gds-form.w ( input parParentProc
     5281                         ,input 'ПРОСМОТР':U
     5282                         ,input ?
     5283                         ,input ?
     5284                         ,input ?
     5285                         ,input-output gds-rec).
     5286     apply "entry" to br-list in frame Dlg-grp.
     5287     return no-apply.
     5288   end.
     5289   MAIN-BLOCK:
     5290   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5291      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5292   Buf_matrix-goods.asmg-db-num-update:read-only in browse BROWSE-am-goods = true .
     5293   v-indicator-life-gds:resizable in browse BROWSE-am-goods = true .
     5294   p-name:resizable  in browse BROWSE-am-goods = true .
     5295   v-indicator-life-gds:width in browse BROWSE-am-goods = 8 .
     5296   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5297     run mainmenu_getcntxt in parparentproc
     5298       (output v-cntxt-db-num
     5299       ,output v-cntxt-userid
     5300       ,output v-cntxt-level
     5301       ,output v-cntxt-host-code-obj
     5302       ,output v-cntxt-obj-type
     5303       ,output v-cntxt-obj-code
     5304       ,output v-cntxt-db-num-obj
     5305       ,output v-cntxt-is-admin
     5306       ) .
     5307   ASSIGN
     5308   rs-sts:RADIO-BUTTONS IN FRAME Dlg-grp
     5309       = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     5310         "Все&!" + chr(44) + 'все':U + chr(44) +
     5311         "Удаленные&-" + chr(44) + '1':U
     5312   .
     5313   rs-sts = '0':U .
     5314   display RS-sts WITH FRAME Dlg-grp.
     5315   enable  RS-sts WITH FRAME Dlg-grp.
     5316   run ver-db1 in this-procedure .
     5317   run ver-attr in this-procedure .
     5318   frame Dlg-grp:TITLE = frame Dlg-grp:TITLE + " " + buf_matrix.asmt-name .
     5319       if p-current-obj-code = 0
     5320       then do:
     5321          assign
     5322          v-current-store-type = v-cntxt-obj-type
     5323          v-current-store-code = v-cntxt-obj-code
     5324          v-current-host-code = v-cntxt-host-code-obj
     5325          .
     5326       end.
     5327       else do:
     5328           assign
     5329               v-current-store-type = p-current-obj-type
     5330               v-current-store-code = p-current-obj-code
     5331           .
     5332   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5333   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5334     (input  v-current-store-type
     5335     ,input  v-current-store-code
     5336     ,output v-current-host-code
     5337     )  .
     5338       end.
     5339       run grplib-get-parameters in this-procedure (
     5340             input v-current-store-type
     5341           , input v-current-store-code
     5342       ) no-error.
     5343       if error-status :error
     5344       then do:
     5345           message
     5346               "Ошибка чтения параметров для списка групп товаров."
     5347               skip (1)
     5348               "Для параметров списка будут приняты значения по умолчанию."
     5349           view-as alert-box warning.
     5350       end.
     5351       run UI-on-0 in this-procedure no-error .
     5352       if error-status :error
     5353       then do:
     5354           message
     5355               vss-workfile vss-revision vss-description
     5356               skip "Ошибка при загрузке дерева групп."
     5357               skip return-value
     5358               skip trim(error-status :get-message(1))
     5359                   trim(error-status :get-message(2))
     5360                   trim(error-status :get-message(3))
     5361                   trim(error-status :get-message(4))
     5362                   trim(error-status :get-message(5))
     5363           view-as alert-box error.
     5364           undo, return error .
     5365       end.
     5366       OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     5367       WAIT-FOR GO OF FRAME Dlg-grp.
     5368   END.
     5369   RUN disable_UI.
     5370   PROCEDURE add-grp :
     5371   do
     5372   on error undo, return error
     5373   :
     5374   define input parameter p-node-code  as integer      no-undo.
     5375       define variable v-gds-grp-recid     as recid    no-undo.
     5376       define variable v-focused-row       as integer  no-undo.
     5377       define variable v-repositioned-row  as integer  no-undo.
     5378       define variable v-have-goods        as logical  no-undo.
     5379       define variable v-have-rights       as logical       no-undo.
     5380       define buffer buf_gds-grp           for gds-grp.
     5381       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     5382       run check-rights-for-change-grp in this-procedure (
     5383           input  p-node-code
     5384           ,output v-have-rights
     5385       ) no-error.
     5386       if error-status :error
     5387       or v-have-rights = no
     5388       then do:
     5389           message
     5390             vss-workfile vss-revision vss-description
     5391             skip "Нет прав на изменение справочника групп товаров."
     5392             skip "Удаление группы невозможно."
     5393             skip return-value
     5394             skip trim(error-status :get-message(1))
     5395                  trim(error-status :get-message(2))
     5396                  trim(error-status :get-message(3))
     5397           view-as alert-box error.
     5398           undo, return error .
     5399       end.
     5400       assign
     5401           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5402           v-repositioned-row = current-result-row( "br-list" )
     5403       .
     5404       run grplib-have-goods in this-procedure (
     5405             input p-node-code
     5406           , output v-have-goods
     5407       ) no-error .
     5408       if error-status :error
     5409       then do:
     5410           undo, return error "add-grp: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     5411       end.
     5412       if v-have-goods = yes
     5413       then do:
     5414           message "В данной группе есть товары. Добавить в нее подгруппу,"
     5415                   "включающую эти товары ?"
     5416           view-as alert-box question
     5417           buttons OK-Cancel
     5418           update v-yesno as logical.
     5419           if v-yesno = no
     5420           then do:
     5421               apply "entry" to br-list in frame Dlg-grp.
     5422               return no-apply.
     5423           end.
     5424       end.
     5425       find first buf_temp_grplib_grp
     5426            where buf_temp_grplib_grp.node-code = p-node-code
     5427       no-error .
     5428       if not available buf_temp_grplib_grp
     5429       then do:
     5430           undo, return error "add-grp: Не найдена группа в browse.".
     5431       end.
     5432       if buf_temp_grplib_grp.mark = "»"
     5433       then do:
     5434           run expand-item in this-procedure ( input p-node-code, input no ) no-error.
     5435           if error-status :error
     5436           then do:
     5437               undo, return error "add-grp: Не удается раскрыть группу.".
     5438           end.
     5439       end.
     5440       run ref/g-grp-f.w (
     5441             input parparentproc
     5442           , input v-current-store-type
     5443           , input v-current-store-code
     5444           , input 'ДОБАВЛЕНИЕ':U
     5445           , input p-node-code
     5446           , input-output v-gds-grp-recid
     5447       ) no-error .
     5448       if v-gds-grp-recid = ?
     5449       then do:
     5450           apply "entry" to br-list in frame Dlg-grp.
     5451           return no-apply.
     5452       end.
     5453       find first buf_gds-grp
     5454            where recid ( buf_gds-grp ) =  v-gds-grp-recid
     5455       no-error.
     5456       if not available buf_gds-grp
     5457       then do:
     5458           undo, return error "add-grp: Ошибка добавления группы.".
     5459       end.
     5460       run create-new-line in this-procedure (
     5461             input buf_gds-grp.node-code
     5462           , input buf_gds-grp.upper-code
     5463           , input buf_temp_grplib_grp.level + 1
     5464           , input buf_gds-grp.is-term
     5465           , input buf_gds-grp.node-name
     5466           , input buf_gds-grp.increase-pc
     5467           , input buf_gds-grp.calc-method
     5468           , input buf_temp_grplib_grp.full-name
     5469           , input buf_temp_grplib_grp.sort-name
     5470       ) no-error .
     5471       if error-status :error
     5472       then do:
     5473           undo, return error "add-grp: Ошибка добавления строки в список групп.".
     5474       end.
     5475       if buf_temp_grplib_grp.level > 0
     5476       then do:
     5477           assign
     5478               buf_temp_grplib_grp.mark = "«"
     5479               buf_temp_grplib_grp.name = substring( buf_temp_grplib_grp.name, 1, buf_temp_grplib_grp.level * 4 )
     5480                                   + "«"
     5481                                   + substring( buf_temp_grplib_grp.name, buf_temp_grplib_grp.level * 4 + 2 )
     5482           .
     5483       end.
     5484       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.    OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     5485       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5486       reposition br-list to row v-repositioned-row.
     5487       OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     5488   end.
     5489   END PROCEDURE.
     5490   PROCEDURE bind-to-scales :
     5491   do
     5492   on error undo, return error
     5493   :
     5494   define input parameter p-node-code as integer      no-undo.
     5495       define variable v-is-terminal   as logical           no-undo.
     5496       run grplib-is-terminal (  input p-node-code
     5497                               , output v-is-terminal
     5498       ) no-error .
     5499       if error-status :error
     5500       then do:
     5501           message
     5502           vss-workfile vss-revision vss-description
     5503           skip "Ошибка при определении типа группы (терм/корн)"
     5504           skip return-value
     5505           skip trim(error-status :get-message(1))
     5506               trim(error-status :get-message(2))
     5507               trim(error-status :get-message(3))
     5508               trim(error-status :get-message(4))
     5509               trim(error-status :get-message(5))
     5510           view-as alert-box error.
     5511           undo, return error .
     5512       end.
     5513       if v-is-terminal = no
     5514       then do:
     5515           message
     5516               "Требуется выбрать самую подробную группу товаров,"
     5517               skip "в которой НЕТ других групп."
     5518           view-as alert-box information .
     5519           apply "entry" to br-list in frame Dlg-grp.
     5520           return no-apply.
     5521       end.
     5522       run ref/scal-grp.w (
     5523             input parparentproc
     5524           , input 'b-add'
     5525           , input v-current-store-type
     5526           , input v-current-store-code
     5527           , input ('db':U + chr(44) + 'gds-grp':U)
     5528           , input g#db-num
     5529           , input 0
     5530           , input p-node-code
     5531       ) no-error .
     5532       if error-status :error
     5533       then do:
     5534           undo, return error return-value.
     5535       end.
     5536   end.
     5537   END PROCEDURE.
     5538   PROCEDURE calc-down-lim :
     5539   define input  parameter p-node-code as integer   no-undo .
     5540   define output parameter kk as integer   no-undo .
     5541   define variable kk2 as integer   no-undo .
     5542   define buffer d_temp_grplib_grp for temp_cons  .
     5543   define buffer curr_temp_grplib_grp for temp_cons  .
     5544   define variable v-is-terminal as logical   no-undo .
     5545     do
     5546     on error undo, return error return-value
     5547     :
     5548       find first curr_temp_grplib_grp where curr_temp_grplib_grp.node-code =  p-node-code no-error .
     5549       kk = 0 .
     5550       for each d_temp_grplib_grp where
     5551                d_temp_grplib_grp.upper-code = p-node-code :
     5552              if not ( d_temp_grplib_grp.cli-type =  ?  or  trim(d_temp_grplib_grp.cli-type) = "" )
     5553              then do:
     5554                     kk = kk +  int(d_temp_grplib_grp.cli-type).
     5555              end.
     5556              else do:
     5557                 run grplib-is-terminal in this-procedure (
     5558                     input d_temp_grplib_grp.node-code
     5559                   , output v-is-terminal ) .
     5560                   if v-is-terminal = true then kk = ? .
     5561                   else do:
     5562                      run calc-down-lim (input d_temp_grplib_grp.node-code , output kk2) .
     5563                      kk = kk + kk2.
     5564                   end.
     5565              end.
     5566       end.
     5567     end.
     5568   END PROCEDURE.
     5569   PROCEDURE check-rights-for-change-grp :
     5570   do
     5571   on error undo, return error
     5572   :
     5573   define input  parameter p-node-code     as integer      no-undo.
     5574   define output parameter p-have-rights   as logical      no-undo.
     5575       define variable v-enable-change-grp as logical       no-undo.
     5576       if g#db-num <> 0
     5577       then do:
     5578           message
     5579             vss-workfile vss-revision vss-description
     5580             skip "Операция определена только в ГБД."
     5581             skip return-value
     5582             skip trim(error-status :get-message(1))
     5583                  trim(error-status :get-message(2))
     5584                  trim(error-status :get-message(3))
     5585           view-as alert-box error.
     5586           assign
     5587               p-have-rights = no
     5588           .
     5589       end.
     5590       else do:
     5591   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5592   do:
     5593     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5594       (input  v-cntxt-db-num
     5595       ,input  v-cntxt-userid
     5596       ,input  0
     5597       ,input  'actn_reference_groups-edit':U
     5598       ,input  'firm':U
     5599       ,input  v-cntxt-host-code-obj
     5600       ,input  '':U
     5601       ,input  0
     5602       ,input  0
     5603       ,input  p-node-code
     5604       ,input  0
     5605       ,input  no
     5606       ,output p-have-rights
     5607       )  .
     5608   end.
     5609       end.
     5610   end.
     5611   END PROCEDURE.
     5612   PROCEDURE collapse-all-on-first-level :
     5613   do
     5614   on error undo, return error
     5615   :
     5616       define buffer buf_gds-grp       for gds-grp.
     5617       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     5618       for each buf_temp_grplib_grp no-lock
     5619          where buf_temp_grplib_grp.upper-code = v-root-code
     5620       :
     5621           run collapse-item in this-procedure (
     5622                 input buf_temp_grplib_grp.node-code
     5623               , input no
     5624           ) no-error .
     5625           if error-status :error
     5626           then do:
     5627               undo, return error "Не удалось закрыть подуровни группы "
     5628                                   + chr(10) + "'" + buf_temp_grplib_grp.full-name + "'"
     5629                                   + chr(10) + return-value.
     5630           end.
     5631       end.
     5632       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.    OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     5633   end.
     5634   END PROCEDURE.
     5635   PROCEDURE collapse-item :
     5636   do
     5637   on error undo, return error
     5638   :
     5639   define input parameter p-node-code as integer      no-undo.
     5640   define input parameter p-refresh    as logical      no-undo.
     5641       define variable v-focused-row       as integer              no-undo.
     5642       define variable v-repositioned-row  as integer              no-undo.
     5643       define buffer buf_del_temp_grplib_grp   for temp_grplib_grp.
     5644       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     5645       find first buf_temp_grplib_grp
     5646            where buf_temp_grplib_grp.node-code = p-node-code
     5647       no-error.
     5648       if error-status :error
     5649       then do:
     5650           undo, return error "collapse-item: Неверно передан код группы. Нет группы с кодом " + string( p-node-code ).
     5651       end.
     5652       assign
     5653           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5654           v-repositioned-row = current-result-row( "br-list" )
     5655       .
     5656       for each buf_del_temp_grplib_grp
     5657          where buf_del_temp_grplib_grp.full-name begins buf_temp_grplib_grp.full-name
     5658            and buf_del_temp_grplib_grp.full-name <> buf_temp_grplib_grp.full-name
     5659            and buf_del_temp_grplib_grp.level     <> buf_temp_grplib_grp.level
     5660       :
     5661           delete buf_del_temp_grplib_grp.
     5662       end.
     5663       assign
     5664           buf_temp_grplib_grp.mark = "»"
     5665           buf_temp_grplib_grp.name = replace( buf_temp_grplib_grp.name
     5666                                           , "«"
     5667                                           , "»"
     5668                                           )
     5669       .
     5670       if p-refresh = yes
     5671       then do:
     5672           OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.    OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     5673           br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5674           reposition br-list to row v-repositioned-row.
     5675           OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     5676       end.
     5677   end.
     5678   END PROCEDURE.
     5679   PROCEDURE create-new-line :
     5680   do
     5681   on error undo, return error
     5682   :
     5683   define input parameter p-node-code      as integer      no-undo.
     5684   define input parameter p-upper-code     as integer      no-undo.
     5685   define input parameter p-level          as integer      no-undo.
     5686   define input parameter p-is-terminal    as logical      no-undo.
     5687   define input parameter p-node-name      as character    no-undo.
     5688   define input parameter p-increase-pc    as decimal      no-undo.
     5689   define input parameter p-calc-method    as character    no-undo.
     5690   define input parameter p-full-name      as character    no-undo.
     5691   define input parameter p-sort-name      as character    no-undo.
     5692   define variable v-margins-range     as integer           no-undo.
     5693   define variable v-margins-exists    as logical           no-undo.
     5694   define variable v-increase-range    as integer           no-undo.
     5695   define variable v-increase-exists   as logical           no-undo.
     5696   define variable v-min-marg          as decimal           no-undo.
     5697   define variable v-max-marg          as decimal           no-undo.
     5698   define variable v-increase-pc       as decimal           no-undo.
     5699   define variable v-round-method      as character         no-undo .
     5700   define variable v-base              as decimal           no-undo .
     5701   define variable v-rmethod-range     as integer           no-undo.
     5702   define variable v-rmethod-exists    as logical           no-undo.
     5703   define variable  v-cli-type          as character no-undo .
     5704   define variable  v-cli-code          as integer no-undo .
     5705   define variable  v-income-cli-range  as integer no-undo .
     5706   define variable  v-income-cli-exists as logical no-undo .
     5707   define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     5708       create buf_temp_grplib_grp.
     5709       assign
     5710           buf_temp_grplib_grp.node-code   = p-node-code
     5711           buf_temp_grplib_grp.upper-code  = p-upper-code
     5712           buf_temp_grplib_grp.level       = p-level
     5713           buf_temp_grplib_grp.full-name   = p-full-name + (if p-full-name <> "" then chr(47)         else "") + p-node-name
     5714           buf_temp_grplib_grp.sort-name   = p-sort-name + (if p-full-name <> "" then chr(2)  else "") + p-node-name
     5715           buf_temp_grplib_grp.calc-method = p-calc-method
     5716           buf_temp_grplib_grp.increase-pc = p-increase-pc
     5717         .
     5718       find first temp_cons where temp_cons.node-code = p-node-code no-error .
     5719       if available temp_cons then do:
     5720           assign
     5721             buf_temp_grplib_grp.min-marg = temp_cons.min-marg
     5722             buf_temp_grplib_grp.max-marg = temp_cons.max-marg
     5723             buf_temp_grplib_grp.cli-type = temp_cons.cli-type
     5724           .
     5725       end.
     5726       run get-first-char in this-procedure (
     5727             input p-node-code
     5728           , input p-is-terminal
     5729           , input no
     5730           , output buf_temp_grplib_grp.mark
     5731       ) no-error.
     5732       if error-status :error
     5733       then do:
     5734           undo, return error "create-new-line: Ошибка вычисления первого символа для отображения группы." .
     5735       end.
     5736       assign
     5737           buf_temp_grplib_grp.name = fill( " ", 4 * p-level )
     5738                                           + buf_temp_grplib_grp.mark
     5739                                           + " "
     5740                                           + p-node-name
     5741       .
     5742   end.
     5743   END PROCEDURE.
     5744   PROCEDURE delete-grp :
     5745   do
     5746   on error undo, return error
     5747   :
     5748   define input parameter p-node-code  as integer      no-undo.
     5749   define input parameter p-refresh    as logical      no-undo.
     5750       define variable v-gds-grp-recid     as recid    no-undo.
     5751       define variable v-focused-row       as integer  no-undo.
     5752       define variable v-repositioned-row  as integer  no-undo.
     5753       define variable v-upper-code        as integer  no-undo.
     5754       define variable v-answer            as logical  no-undo.
     5755       define variable v-is-terminal       as logical  no-undo.
     5756       define variable v-have-goods        as logical  no-undo.
     5757       define variable v-counter           as integer  no-undo.
     5758       define variable v-have-rights       as logical  no-undo.
     5759       define buffer buf_gds-grp           for gds-grp.
     5760       define buffer buf_same_gds-grp      for gds-grp.
     5761       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     5762       run check-rights-for-change-grp in this-procedure (
     5763           input p-node-code
     5764           ,output v-have-rights
     5765       ) no-error.
     5766       if error-status :error
     5767       or v-have-rights = no
     5768       then do:
     5769           message
     5770             vss-workfile vss-revision vss-description
     5771             skip "Нет прав на изменение справочника групп товаров."
     5772             skip "Удаление группы невозможно."
     5773             skip return-value
     5774             skip trim(error-status :get-message(1))
     5775                  trim(error-status :get-message(2))
     5776                  trim(error-status :get-message(3))
     5777           view-as alert-box error.
     5778           undo, return error .
     5779       end.
     5780       assign
     5781           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5782           v-repositioned-row = current-result-row( "br-list" )
     5783       .
     5784       if p-node-code = v-root-code
     5785       then do:
     5786           message
     5787               "Нельзя удалить корневую группу."
     5788           view-as alert-box.
     5789           undo, return.
     5790       end.
     5791       find first buf_temp_grplib_grp
     5792            where buf_temp_grplib_grp.node-code = p-node-code
     5793       no-error .
     5794       if error-status :error
     5795       then do:
     5796           undo, return error "Неверно выбрана группа." .
     5797       end.
     5798       if buf_temp_grplib_grp.upper-code = v-root-code
     5799       then do:
     5800           assign
     5801               v-counter = v-counter + 1
     5802           .
     5803           count-first-level-grp:
     5804           for each buf_gds-grp no-lock
     5805              where buf_gds-grp.upper-code = v-root-code
     5806           :
     5807               assign
     5808                   v-counter = v-counter + 1
     5809               .
     5810               if v-counter > 1
     5811               then do:
     5812                   leave count-first-level-grp.
     5813               end.
     5814               else do:
     5815                   message
     5816                       "Нельзя удалить последнюю группу первого уровня."
     5817                   view-as alert-box.
     5818                   return error.
     5819               end.
     5820           end.
     5821       end.
     5822       find first buf_gds-grp no-lock
     5823            where buf_gds-grp.node-code = p-node-code
     5824       no-error.
     5825       if error-status :error
     5826       then do:
     5827           undo, return error "change-grp: Нет группы БД, соответствующей значению в списке.".
     5828       end.
     5829       assign
     5830           v-upper-code    = buf_gds-grp.upper-code
     5831           v-answer        = no
     5832       .
     5833       run grplib-is-terminal in this-procedure ( input p-node-code, output v-is-terminal ) no-error.
     5834       if error-status :error
     5835       then do:
     5836           undo, return error return-value.
     5837       end.
     5838       if v-is-terminal = no
     5839       then do:
     5840           for each buf_gds-grp
     5841           where buf_gds-grp.upper-code = v-upper-code
     5842             and buf_gds-grp.node-code <> p-node-code
     5843           :
     5844               find first buf_same_gds-grp no-lock
     5845                   where buf_same_gds-grp.upper-code  = p-node-code
     5846                   and buf_same_gds-grp.node-name   = buf_gds-grp.node-name
     5847               no-error.
     5848               if available buf_same_gds-grp
     5849               then do:
     5850                   message
     5851                       "Одна из подгрупп удаляемой группы имеет название:" buf_gds-grp.node-name "-" skip
     5852                       "такое же, как одна из соседних к удаляемой групп." skip
     5853                       "После удаления получились бы 2 группы на одном уровне, имеющие одинаковые названия, что запрещено."
     5854                   view-as alert-box error.
     5855                   return no-apply.
     5856               end.
     5857           end.
     5858           message "Текущая группа будет удалена."
     5859               skip "Ее подгруппы будут перенесены в вышестоящую группу."
     5860               skip (1) "Слить группу с вышестоящей?"
     5861           view-as alert-box question buttons yes-no update v-answer.
     5862       end.
     5863       if v-is-terminal = yes
     5864       then do:
     5865           run grplib-have-goods in this-procedure (
     5866                 input p-node-code
     5867               , output v-have-goods
     5868           ) no-error .
     5869           if error-status :error
     5870           then do:
     5871               undo, return error "delete-grp: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     5872           end.
     5873           if v-have-goods = yes
     5874           then do:
     5875               find first buf_gds-grp no-lock
     5876                    where buf_gds-grp.upper-code = v-upper-code
     5877                      and buf_gds-grp.node-code <> p-node-code
     5878               no-error .
     5879               if available buf_gds-grp
     5880               then do:
     5881                   message "В одной группе не могут быть одновременно подгруппы и товары."
     5882                       skip "Эта группа не может быть слита с вышестоящей."
     5883                   view-as alert-box error.
     5884                   apply "entry" to br-list in frame Dlg-grp.
     5885                   return no-apply.
     5886               end.
     5887               message "Текущая группа будет удалена."
     5888                   skip "Товары будут перенесены в вышестоящую группу."
     5889                   skip (1) "Слить группу с вышестоящей?"
     5890               view-as alert-box question buttons yes-no update v-answer.
     5891           end.
     5892           else do:
     5893               message "Удалить группу ? Вы уверены ?"
     5894               view-as alert-box question buttons yes-no update v-answer.
     5895           end.
     5896       end.
     5897       if not v-answer
     5898       then do:
     5899           apply "entry" to br-list in frame Dlg-grp.
     5900           return no-apply.
     5901       end.
     5902       delete-from-base:
     5903       do
     5904       ON ERROR UNDO delete-from-base, return no-apply
     5905       ON stop UNDO delete-from-base, return no-apply:
     5906           find first buf_gds-grp exclusive-lock
     5907                where buf_gds-grp.node-code = p-node-code
     5908           no-error.
     5909           if error-status :error
     5910           then do:
     5911               undo, return error "change-grp: Нет группы БД, соответствующей значению в списке.".
     5912           end.
     5913           delete buf_gds-grp.
     5914       end.
     5915       if p-refresh = yes
     5916       then do:
     5917           find first buf_gds-grp no-lock
     5918                where buf_gds-grp.node-code = v-upper-code
     5919           no-error.
     5920           if not available buf_gds-grp
     5921           then do:
     5922               undo, return error "delete-grp: Не найдена группа в БД".
     5923           end.
     5924           assign
     5925               p-recid-list = string( recid( buf_gds-grp ) )
     5926               gds-grp-row  = recid( buf_gds-grp )
     5927           .
     5928           run UI-on in this-procedure no-error .
     5929           if error-status :error
     5930           then do:
     5931               undo, return error "delete-grp: Ошибка при загрузке дерева групп.".
     5932           end.
     5933       end.
     5934   end.
     5935   END PROCEDURE.
     5936   PROCEDURE disable_UI :
     5937     HIDE FRAME Dlg-grp.
     5938   END PROCEDURE.
     5939   PROCEDURE enable_UI :
     5940     DISPLAY fi-search RS-sts FILL-IN-1
     5941         WITH FRAME Dlg-grp.
     5942     ENABLE b-exit b-mark b-verify b-recalc B-print b-help b-expand b-expand-all
     5943            fi-search b-find-by-full-name b-find-by-substring b-search br-list
     5944            B-add B-lookup B-chg B-del B-copy RS-sts BROWSE-am-goods FILL-IN-1
     5945         WITH FRAME Dlg-grp.
     5946     VIEW FRAME Dlg-grp.
     5947     OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.    OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     5948   END PROCEDURE.
     5949   PROCEDURE expand-all-from-current :
     5950   do
     5951   on error undo, return error
     5952   :
     5953   define input parameter p-node-code as integer      no-undo.
     5954       define variable v-full-name         as character    no-undo.
     5955       define variable v-focused-row       as integer      no-undo.
     5956       define variable v-repositioned-row  as integer      no-undo.
     5957       define variable v-grp-counter       as integer      no-undo.
     5958       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     5959       assign
     5960           v-grplib-no-warning-grp-amount = no
     5961       .
     5962       run expand-item in this-procedure (
     5963             input p-node-code
     5964           , input no
     5965       ) no-error .
     5966       if error-status :error
     5967       then do:
     5968           undo, return error "expand-all-from-current: Не удалось раскрыть подуровни группы.".
     5969       end.
     5970       assign
     5971           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5972           v-repositioned-row = current-result-row( "br-list" )
     5973       .
     5974       run grplib-get-full-name in this-procedure (
     5975             input p-node-code
     5976           , output v-full-name
     5977       ) no-error .
     5978       if error-status :error
     5979       then do:
     5980           undo, return error "expand-all-from-current: Ошибка вычисления полного имени группы".
     5981       end.
     5982       assign
     5983           v-grplib-grp-amount-for-load = 1
     5984       .
     5985       load-grp-list:
     5986       for each buf_temp_grplib_grp
     5987          where buf_temp_grplib_grp.full-name begins v-full-name
     5988       :
     5989           assign
     5990               v-grp-counter = v-grp-counter + 1
     5991           .
     5992           run expand-item in this-procedure (
     5993                 input buf_temp_grplib_grp.node-code
     5994               , input no
     5995           ) no-error .
     5996           if error-status :error
     5997           then do:
     5998               undo, return error "expand-all-from-current: Не удалось раскрыть подуровни группы.".
     5999           end.
     6000           if v-grp-counter > 1000
     6001           and v-grplib-grp-amount-for-load <> 0
     6002           then do:
     6003               define variable v-choice    as integer      no-undo.
     6004               run gbl/d-askw.w (
     6005                     input "Большой список групп"
     6006                   , input substitute( "В список добавлено более &2 групп&1&1Вы можете добавить следующие &2 групп,&1заполнить весь список&1или остановить создание списка.", chr(10), 1000 )
     6007                   , input "|^":U
     6008                   , input substitute( "Следующие &1|Заполнить все|Прервать", 1000 )
     6009                   , input substitute( "Загрузить список следующих &1 групп|Загрузить список всех групп|Не загружать список полностью", 1000 )
     6010                   , input 1
     6011                   , input 3
     6012                   , output v-choice
     6013               ).
     6014               case v-choice
     6015               :
     6016                   when 1
     6017                   then do:
     6018                       assign
     6019                           v-grplib-grp-amount-for-load    = 1
     6020                           v-grp-counter                   = 0
     6021                       .
     6022                   end.
     6023                   when 2
     6024                   then do:
     6025                       assign
     6026                           v-grplib-grp-amount-for-load    = 0
     6027                       .
     6028                   end.
     6029                   otherwise do:
     6030                       leave load-grp-list.
     6031                   end.
     6032               end case.
     6033           end.
     6034       end.
     6035       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.    OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6036       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6037       reposition br-list to row v-repositioned-row.
     6038       OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6039   end.
     6040   END PROCEDURE.
     6041   PROCEDURE expand-item :
     6042   do
     6043   on error undo, return error
     6044   :
     6045   define input parameter p-node-code  as integer      no-undo.
     6046   define input parameter p-refresh    as logical      no-undo.
     6047       define variable v-focused-row       as integer              no-undo.
     6048       define variable v-repositioned-row  as integer              no-undo.
     6049       define buffer buf_gds-grp           for gds-grp.
     6050       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     6051   if session :set-wait-state( "compiler" ) then.
     6052       assign
     6053           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6054           v-repositioned-row = current-result-row( "br-list" )
     6055       .
     6056       find first buf_temp_grplib_grp
     6057            where buf_temp_grplib_grp.node-code = p-node-code
     6058       no-error .
     6059       if not available buf_temp_grplib_grp
     6060       then do:
     6061           undo, return error "expand-item: Неверно задан код группы.".
     6062       end.
     6063       if buf_temp_grplib_grp.mark <> "»"
     6064       then do:
     6065       end.
     6066       else do:
     6067           for each buf_gds-grp no-lock
     6068              where buf_gds-grp.upper-code = p-node-code
     6069           on error undo, return error
     6070           :
     6071               run create-new-line in this-procedure (
     6072                     input buf_gds-grp.node-code
     6073                   , input buf_gds-grp.upper-code
     6074                   , input buf_temp_grplib_grp.level + 1
     6075                   , input buf_gds-grp.is-term
     6076                   , input buf_gds-grp.node-name
     6077                   , input buf_gds-grp.increase-pc
     6078                   , input buf_gds-grp.calc-method
     6079                   , input buf_temp_grplib_grp.full-name
     6080                   , input buf_temp_grplib_grp.sort-name
     6081               ) no-error .
     6082               if error-status :error
     6083               then do:
     6084                   message
     6085                   vss-workfile vss-revision vss-description
     6086                   skip "expand-item: Ошибка добавления строки в список групп."
     6087                   skip return-value
     6088                   skip trim(error-status :get-message(1))
     6089                       trim(error-status :get-message(2))
     6090                       trim(error-status :get-message(3))
     6091                       trim(error-status :get-message(4))
     6092                       trim(error-status :get-message(5))
     6093                   view-as alert-box error.
     6094   if session :set-wait-state( "" ) then.
     6095                   undo, return error .
     6096               end.
     6097           end.
     6098           assign
     6099               buf_temp_grplib_grp.mark = "«"
     6100               buf_temp_grplib_grp.name = replace( buf_temp_grplib_grp.name
     6101                                               , "»"
     6102                                               , "«"
     6103                                               )
     6104           .
     6105           if p-refresh = yes
     6106           then do:
     6107               OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.    OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6108               if v-focused-row > br-list :height - 2
     6109               then do:
     6110                   assign
     6111                       v-focused-row       = br-list :height - 2
     6112                   .
     6113               end.
     6114               br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6115               reposition br-list to row v-repositioned-row.
     6116               OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6117           end.
     6118       end.
     6119   if session :set-wait-state( "" ) then.
     6120   end.
     6121   END PROCEDURE.
     6122   PROCEDURE expand-or-collapse-item :
     6123   do
     6124   on error undo, return error
     6125   :
     6126       case temp_grplib_grp.mark
     6127       :
     6128       when "»"
     6129       then do:
     6130           run expand-item in this-procedure ( input temp_grplib_grp.node-code, input yes ) no-error .
     6131           if error-status :error
     6132           then do:
     6133               undo, return error "Не удалось раскрыть подуровни группы.".
     6134           end.
     6135       end.
     6136       when "«"
     6137       then do:
     6138           run collapse-item in this-procedure ( input temp_grplib_grp.node-code, input yes ) no-error .
     6139           if error-status :error
     6140           then do:
     6141               undo, return error "Не удалось закрыть подуровни группы.".
     6142           end.
     6143       end.
     6144       end case.
     6145   end.
     6146   END PROCEDURE.
     6147   PROCEDURE expand-tree-for-grp :
     6148   do
     6149   on error undo, return error
     6150   :
     6151   define input parameter p-node-code              as integer          no-undo.
     6152   define output parameter p-focused-row           as integer          no-undo.
     6153   define output parameter p-reposition-row        as integer          no-undo.
     6154   define output parameter p-reposition-to-recid   as logical init no  no-undo.
     6155   define variable v-full-name     as character    no-undo.
     6156   define variable v-found         as logical      no-undo.
     6157   define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     6158       run grplib-get-full-name in this-procedure ( input p-node-code, output v-full-name ) no-error .
     6159       if error-status :error
     6160       then do:
     6161       end.
     6162       else do:
     6163           run grplib-find-grp-by-full-name in this-procedure (
     6164                 input right-trim( v-full-name, chr(47) )
     6165               , input yes
     6166               , output v-found
     6167           ) no-error .
     6168           if v-found = no
     6169           then do:
     6170           end.
     6171           else do:
     6172               process-initial-grp:
     6173               for each temp_grplib_found-grp
     6174               break by temp_grplib_found-grp.level
     6175               on error undo, leave process-initial-grp :
     6176                   if last ( temp_grplib_found-grp.level )
     6177                   then do:
     6178                       assign
     6179                           p-focused-row       = integer( br-list :height in frame Dlg-grp / 2 ) + 1
     6180                       .
     6181                       find first buf_temp_grplib_grp
     6182                            where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     6183                       no-error .
     6184                       if error-status :error
     6185                       then do:
     6186                           leave process-initial-grp.
     6187                       end.
     6188                       assign
     6189                           p-reposition-row = recid( buf_temp_grplib_grp )
     6190                           p-reposition-to-recid = yes
     6191                       .
     6192                       leave process-initial-grp.
     6193                   end.
     6194                   else do:
     6195                       run expand-item in this-procedure ( input temp_grplib_found-grp.node-code, input no ) no-error .
     6196                       if error-status :error
     6197                       then do:
     6198                           leave process-initial-grp.
     6199                       end.
     6200                       find first buf_temp_grplib_grp
     6201                               where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     6202                       no-error .
     6203                       if error-status :error
     6204                       then do:
     6205                           leave process-initial-grp.
     6206                       end.
     6207                       assign
     6208                           p-reposition-row = recid( buf_temp_grplib_grp )
     6209                           p-reposition-to-recid = yes
     6210                       .
     6211                   end.
     6212               end.
     6213           end.
     6214       end.
     6215   end.
     6216   END PROCEDURE.
     6217   PROCEDURE fill-db :
     6218   do
     6219   on error undo, return error
     6220   :
     6221   define input parameter parnode-code like ub.gds-grp.node-code no-undo .
     6222   define input parameter parupper-code like ub.gds-grp.node-code no-undo .
     6223     run ref/dtaxgrpu.p (input parnode-code,
     6224                    input parupper-code,
     6225                    input yes,
     6226                    input v-current-host-code,
     6227                    v-current-store-type,
     6228                    v-current-store-code) no-error.
     6229   end.
     6230   END PROCEDURE.
     6231   PROCEDURE fill-marg :
     6232   do
     6233   on error undo, return error
     6234   :
     6235   define input parameter p-node-code as integer      no-undo.
     6236       define variable v-focused-row       as integer  no-undo.
     6237       define variable v-repositioned-row  as integer  no-undo.
     6238       define variable v-margins-range     as integer  no-undo.
     6239       define variable v-margins-exists    as logical  no-undo.
     6240       define variable v-increase-range     as integer  no-undo.
     6241       define variable v-increase-exists    as logical  no-undo.
     6242       define variable v-min-marg          as decimal  no-undo.
     6243       define variable v-max-marg          as decimal  no-undo.
     6244       define variable v-increase-pc          as decimal  no-undo.
     6245       define variable v-round-method      as character   no-undo .
     6246       define variable v-base              as decimal     no-undo .
     6247       define variable v-rmethod-range     as integer     no-undo.
     6248       define variable v-rmethod-exists    as logical     no-undo.
     6249       define variable v-cli-type           as character no-undo .
     6250       define variable v-cli-code           as integer no-undo .
     6251       define variable v-income-cli-range   as integer no-undo .
     6252       define variable v-income-cli-exists  as logical no-undo .
     6253       define buffer buf_gds-grp           for ub.gds-grp.
     6254       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     6255       assign
     6256           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6257           v-repositioned-row = current-result-row( "br-list" )
     6258       .
     6259       run ref/pr-marg.w (
     6260             input parparentproc
     6261           , input p-node-code
     6262       ) no-error.
     6263       if error-status :error
     6264       then do:
     6265           undo, return error "fill-marg: Ошибка при установке диапазона торговых наценок." + chr(10) + return-value.
     6266       end.
     6267       find first buf_temp_grplib_grp
     6268            where buf_temp_grplib_grp.node-code = p-node-code
     6269       no-error .
     6270       if error-status :error
     6271       then do:
     6272           undo, return error "fill-marg: Неверно задан код группы.".
     6273       end.
     6274       OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.    OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6275       br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     6276       reposition br-list to row v-repositioned-row.
     6277       OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6278   end.
     6279   END PROCEDURE.
     6280   PROCEDURE fill-output-parameters-on-exit :
     6281   do
     6282   on error undo, return error
     6283   :
     6284   define input parameter p-node-code as integer      no-undo.
     6285       define variable v-selected      as logical  init no  no-undo.
     6286       define variable v-is-terminal    as logical           no-undo.
     6287       define buffer buf_gds-grp           for gds-grp.
     6288       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     6289       run grplib-is-terminal in this-procedure ( input p-node-code, output v-is-terminal ) no-error.
     6290       if error-status :error
     6291       then do:
     6292           undo, return error "fill-output-parameters-on-exit: Не удается определить, корневая группа или терминальная." + chr(10) + return-value.
     6293       end.
     6294       if lookup ( 'терм':U, p-button-list ) <> 0 and v-is-terminal = no
     6295       then do:
     6296               message "Требуется выбрать группу товаров, в которой нет других групп.".
     6297               apply "entry" to br-list in frame Dlg-grp.
     6298               undo, return "no-term".
     6299       end.
     6300       assign
     6301           p-recid-list = ""
     6302       .
     6303       for each buf_temp_grplib_grp
     6304          where buf_temp_grplib_grp.sel = "*"
     6305       :
     6306           find first buf_gds-grp no-lock
     6307                where buf_gds-grp.node-code = buf_temp_grplib_grp.node-code
     6308           no-error .
     6309           if error-status :error
     6310           then do:
     6311               undo, return error "fill-output-parameters-on-exit: Не найдена запись выбранной группы '"
     6312                                   + "'" + buf_temp_grplib_grp.full-name + "'".
     6313           end.
     6314           assign
     6315               p-recid-list = p-recid-list + ( if p-recid-list = "" then "" else "," ) + string( recid( buf_gds-grp ) )
     6316               v-selected = yes
     6317           .
     6318       end.
     6319       if v-selected = no
     6320       then do:
     6321           find first buf_gds-grp no-lock
     6322                where buf_gds-grp.node-code = p-node-code
     6323           no-error .
     6324           if not available buf_gds-grp
     6325           then do:
     6326               find first buf_temp_grplib_grp
     6327                    where buf_temp_grplib_grp.node-code = p-node-code
     6328               no-error .
     6329               if not available buf_temp_grplib_grp
     6330               then do:
     6331                   undo, return error "fill-output-parameters-on-exit: Неверно выбрана группа с кодом "
     6332                                       + string( p-node-code ).
     6333               end.
     6334               undo, return error "fill-output-parameters-on-exit: Не найдена запись выбранной группы '"
     6335                               + buf_temp_grplib_grp.full-name + "'".
     6336           end.
     6337           assign
     6338               p-recid-list = string( recid( buf_gds-grp ) )
     6339           .
     6340       end.
     6341       assign
     6342           gds-grp-row  = integer( entry( 1, p-recid-list ) )
     6343       .
     6344   assign
     6345   v-uf-List_ = (if gds-grp-row = ? then chr(63) else string(gds-grp-row))
     6346   .
     6347   run uf-set in this-procedure(
     6348       input  'gds-grp-p':U
     6349       ,input  g#userid
     6350       ,input v-uf-List_
     6351       ,input v-uf-Naim
     6352       ,input v-uf-print-graft
     6353       ,input v-uf-sort-gr
     6354       ,input v-uf-type-price
     6355       ,input v-uf-type-val
     6356   )  no-error .
     6357   end.
     6358   END PROCEDURE.
     6359   PROCEDURE fill-tt :
     6360   do
     6361   on error undo, return error
     6362   :
     6363   define input parameter parnode-code like ub.gds-grp.node-code no-undo .
     6364   define input parameter parupper-code like ub.gds-grp.node-code no-undo .
     6365   run ref/dtaxgrps.p (parnode-code,
     6366                  parupper-code,
     6367                  v-current-host-code,
     6368                  v-current-store-type,
     6369                  v-current-store-code) no-error.
     6370   end.
     6371   END PROCEDURE.
     6372   PROCEDURE find-grp-in-browse :
     6373   do
     6374   on error undo, return error
     6375   :
     6376   define input parameter p-search-grp-full-name   as character        no-undo.
     6377   define output parameter p-found                 as logical          no-undo.
     6378       define variable v-focused-row       as integer      no-undo.
     6379       define variable v-repositioned-row  as integer      no-undo.
     6380       define variable v-counter           as integer      no-undo.
     6381       define variable v-level             as integer      no-undo.
     6382       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     6383       assign
     6384           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6385           v-repositioned-row = current-result-row( "br-list" )
     6386       .
     6387       assign
     6388       v-level = num-entries( right-trim(p-search-grp-full-name, chr(47) ) , chr(47))
     6389       .
     6390       if v-found-grp-num  <> 0
     6391       then do:
     6392           assign
     6393               v-counter = 0
     6394           .
     6395           find first temp_grplib_found-grp
     6396                where temp_grplib_found-grp.level = v-level
     6397           no-error .
     6398           if not available temp_grplib_found-grp
     6399           then do:
     6400               undo, return error "Не найдено ни одной группы уровня " + string( v-level ).
     6401           end.
     6402           do v-counter = 1 to v-found-grp-num
     6403           :
     6404               find next temp_grplib_found-grp
     6405                   where temp_grplib_found-grp.level = v-level
     6406               no-error .
     6407               if not available temp_grplib_found-grp
     6408               then do:
     6409                   undo, return error "Не найдена следующая группа уровня " + string( v-level ).
     6410               end.
     6411           end.
     6412           find first buf_temp_grplib_grp
     6413                   where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     6414           no-error .
     6415           if not available buf_temp_grplib_grp
     6416           then do:
     6417               undo, return error "Найденной группы нет в списке групп".
     6418           end.
     6419           OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.    OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6420           br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6421           reposition br-list to recid recid( buf_temp_grplib_grp ).
     6422           OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6423       end.
     6424       else do:
     6425           run grplib-find-grp-by-full-name (
     6426                 input fi-search :screen-value in frame Dlg-grp
     6427               , input yes
     6428               , output p-found
     6429           ).
     6430           if p-found = yes
     6431           then do:
     6432               found-group:
     6433               for each temp_grplib_found-grp no-lock
     6434               by temp_grplib_found-grp.level
     6435               :
     6436                   if temp_grplib_found-grp.level = v-level
     6437                   then do:
     6438                       leave.
     6439                   end.
     6440                   run expand-item in this-procedure (
     6441                         input temp_grplib_found-grp.node-code
     6442                       , input no
     6443                   ).
     6444               end.
     6445               find first temp_grplib_found-grp
     6446                    where temp_grplib_found-grp.level = v-level
     6447               no-error .
     6448               if not available temp_grplib_found-grp
     6449               then do:
     6450                   undo, return error "Нет последней найденной группы для уровня " + string( v-level ).
     6451               end.
     6452               find first buf_temp_grplib_grp
     6453                    where buf_temp_grplib_grp.node-code = temp_grplib_found-grp.node-code
     6454               no-error .
     6455               if not available buf_temp_grplib_grp
     6456               then do:
     6457                   undo, return error "Найденной группы нет в списке групп".
     6458               end.
     6459               OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.    OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6460               br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6461               reposition br-list to recid recid( buf_temp_grplib_grp ).
     6462               OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6463           end.
     6464       end.
     6465       find next temp_grplib_found-grp
     6466           where temp_grplib_found-grp.level = v-level
     6467       no-error .
     6468       if available temp_grplib_found-grp
     6469       then do:
     6470           assign
     6471               v-found-grp-num  = v-found-grp-num + 1
     6472               b-search :label = "Далее"
     6473           .
     6474       end.
     6475       else do:
     6476           assign
     6477               v-found-grp-num  = 0
     6478               b-search :label = "Поиск"
     6479           .
     6480       end.
     6481   end.
     6482   END PROCEDURE.
     6483   PROCEDURE get-current-recid :
     6484   do
     6485   on error undo, return error
     6486   :
     6487   define input parameter p-node-code as integer      no-undo.
     6488   define output parameter p-gds-grp-recid as recid   no-undo.
     6489       define buffer buf_gds-grp       for gds-grp.
     6490       find first buf_gds-grp no-lock
     6491            where buf_gds-grp.node-code = p-node-code
     6492       no-error .
     6493       if not available buf_gds-grp
     6494       then do:
     6495           undo, return error "get-current-recid: Не найдена группа." .
     6496       end.
     6497       assign
     6498           p-gds-grp-recid = recid( buf_gds-grp )
     6499       .
     6500   end.
     6501   END PROCEDURE.
     6502   PROCEDURE get-first-char :
     6503   do
     6504   on error undo, return error
     6505   :
     6506   define input parameter p-node-code      as integer      no-undo.
     6507   define input parameter p-terminal       as logical      no-undo.
     6508   define input parameter p-calc-terminal  as logical      no-undo.
     6509   define output parameter p-prefix        as character    no-undo.
     6510   define variable v-name          as character    no-undo.
     6511   define variable v-is-terminal   as logical      no-undo.
     6512   define variable v-have-goods    as logical      no-undo.
     6513   define buffer buf_gds-grp               for gds-grp.
     6514   define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     6515   if p-calc-terminal = yes
     6516   then do:
     6517       run grplib-is-terminal in this-procedure (
     6518             input p-node-code
     6519           , output v-is-terminal
     6520       ) no-error .
     6521       if error-status :error
     6522       then do:
     6523           undo, return error "get-first-char: Ошибка при определении типа группы (терм/корн).".
     6524       end.
     6525   end.
     6526   else do:
     6527       assign
     6528           v-is-terminal = p-terminal
     6529       .
     6530   end.
     6531   if v-is-terminal = yes
     6532   then do:
     6533       run grplib-have-goods in this-procedure (
     6534             input p-node-code
     6535           , output v-have-goods
     6536       ) no-error .
     6537       if error-status :error
     6538       then do:
     6539           undo, return error "get-first-char: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     6540       end.
     6541       if v-have-goods = yes
     6542       then do:
     6543           assign
     6544               p-prefix = "•"
     6545           .
     6546       end.
     6547       else do:
     6548           assign
     6549               p-prefix = " "
     6550           .
     6551       end.
     6552   end.
     6553   else do:
     6554       find first buf_temp_grplib_grp no-lock
     6555            where buf_temp_grplib_grp.upper-code = p-node-code
     6556       no-error.
     6557       if available buf_temp_grplib_grp
     6558       then do:
     6559           assign
     6560               p-prefix = "«"
     6561           .
     6562       end.
     6563       else do:
     6564           assign
     6565               p-prefix = "»"
     6566           .
     6567       end.
     6568   end.
     6569   end.
     6570   END PROCEDURE.
     6571   PROCEDURE get-row-amount :
     6572   do
     6573   on error undo, return error
     6574   :
     6575   define output parameter p-row-amount as integer      no-undo.
     6576       define buffer buf_temp_grplib_grp       for temp_grplib_grp.
     6577       for each buf_temp_grplib_grp
     6578       :
     6579           assign
     6580               p-row-amount = p-row-amount + 1
     6581           .
     6582       end.
     6583   end.
     6584   END PROCEDURE.
     6585   PROCEDURE init-tt :
     6586    define buffer buf_gds-grp-obj-attr  for ub.gds-grp-obj-attr  .
     6587       for each temp_grplib_grp :
     6588           find first buf_gds-grp-obj-attr no-lock  where
     6589                      buf_gds-grp-obj-attr.attr-code = 'LimAssMat':U and
     6590                      buf_gds-grp-obj-attr.obj-type  = string(buf_matrix.asmt-id) and
     6591                      buf_gds-grp-obj-attr.obj-code  = buf_matrix.db-num and
     6592                      buf_gds-grp-obj-attr.host-code = 0 and
     6593                      buf_gds-grp-obj-attr.node-code = temp_grplib_grp.node-code no-error .
     6594           if not available buf_gds-grp-obj-attr then temp_grplib_grp.cli-type  = "".
     6595           else temp_grplib_grp.cli-type = buf_gds-grp-obj-attr.attr-value .
     6596       end.
     6597   END PROCEDURE.
     6598   PROCEDURE move-item :
     6599   do
     6600   on error undo, return error
     6601   :
     6602   define input parameter p-node-code  as integer      no-undo.
     6603   define input parameter p-upper-code as integer      no-undo.
     6604       define variable v-node-full-name    as character    no-undo.
     6605       define variable v-upper-full-name   as character    no-undo.
     6606       define variable v-focused-row       as integer      no-undo.
     6607       define variable v-repositioned-row  as integer      no-undo.
     6608       define variable v-have-goods        as logical      no-undo.
     6609       define buffer buf_gds-grp           for gds-grp.
     6610       define buffer buf_upper_gds-grp     for gds-grp.
     6611       define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     6612   if session :set-wait-state( "compiler" ) then.
     6613       run grplib-have-goods in this-procedure (
     6614             input p-upper-code
     6615           , output v-have-goods
     6616       ) no-error .
     6617       if error-status :error
     6618       then do:
     6619           undo, return error "move-item: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     6620       end.
     6621       if v-have-goods = yes
     6622       then do:
     6623               message
     6624                   "В эту группу переместить нельзя, т.к. в одной группе"
     6625                   skip "не могут быть одновременно подгруппы и товары.".
     6626               apply "entry" to br-list in frame Dlg-grp.
     6627               return no-apply.
     6628       end.
     6629       run grplib-get-full-name in this-procedure (
     6630               input p-node-code
     6631               , output v-node-full-name
     6632       ) no-error .
     6633       if error-status :error
     6634       then do:
     6635           undo, return error "move-item: Ошибка вычисления полного имени перемещаемой группы".
     6636       end.
     6637       run grplib-get-full-name in this-procedure (
     6638               input p-upper-code
     6639               , output v-upper-full-name
     6640       ) no-error .
     6641       if error-status :error
     6642       then do:
     6643           undo, return error "move-item: Ошибка вычисления полного имени группы".
     6644       end.
     6645       if v-upper-full-name begins v-node-full-name
     6646       then do:
     6647           message
     6648           "Группу нельзя переместить в ее собственную подгруппу."
     6649           view-as alert-box.
     6650           undo, return.
     6651       end.
     6652       do transaction
     6653       on error undo, return error "move-item: Ошибка перемещения группы.".
     6654           find first buf_gds-grp exclusive-lock
     6655               where buf_gds-grp.node-code = p-node-code
     6656           no-error .
     6657           if not available buf_gds-grp
     6658           then do:
     6659               undo, return error "move-item: Не найдена группа для перемещения.".
     6660           end.
     6661           assign
     6662               buf_gds-grp.upper-code = p-upper-code
     6663           .
     6664       end.
     6665       assign
     6666           p-recid-list = string( recid( buf_gds-grp ) )
     6667           gds-grp-row  = recid( buf_gds-grp )
     6668       .
     6669       run UI-on in this-procedure no-error .
     6670       if error-status :error
     6671       then do:
     6672           undo, return error "move-item: Ошибка при загрузке дерева групп." + chr(10) + return-value.
     6673       end.
     6674   end.
     6675   END PROCEDURE.
     6676   PROCEDURE print-browse :
     6677   define variable Line as character no-undo.
     6678   define variable v-vat-pc as decimal no-undo .
     6679   define variable v-slt-pc as decimal no-undo .
     6680   define variable date_string as character no-undo.
     6681   define buffer buf_temp_grplib_grp for temp_grplib_grp.
     6682   define buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp.
     6683   DEFINE FRAME brFrame
     6684   buf_temp_grplib_grp.name          format "X(71)"      column-label " Наименование группы"
     6685   buf_temp_grplib_grp.calc-method   format "X(11)"      column-label " Исходная"
     6686   buf_temp_grplib_grp.increase-pc   format "->>>>9.99"  column-label " Наценка"
     6687   buf_temp_grplib_grp.min-marg      format "X(10)"  column-label " Мин.Нац."
     6688   buf_temp_grplib_grp.max-marg      format "X(10)"  column-label " Макс.Нац."
     6689   buf_temp_grplib_grp.round-method  format "X(22)"  column-label "Метод округл"
     6690   v-vat-pc                          format "99.99"  column-label "НДС"
     6691   v-slt-pc                          format "99.99"  column-label "НП"
     6692   HEADER  date_string AT 5 format "X(35)"
     6693   string( "Страница " ) format "X(9)" AT 85 PAGE-NUMBER(PrnLibStream) AT 95 FORMAT ">>9" SKIP
     6694   Line format "X(150)" AT 1
     6695   with width 232 down stream-io use-text    .
     6696   Line = fill("-", 150).
     6697   date_string = cur-time-print() .
     6698   run prn-lib-open-stream  in this-procedure (
     6699         input parparentproc
     6700       , input 43
     6701       , input yes
     6702       , input no
     6703   ).
     6704   PUT  STREAM PrnLibStream
     6705       SPACE(25) ( frame Dlg-grp:title )
     6706       format "x(90)" SKIP(1)
     6707   .
     6708   FORM HEADER
     6709   Line format "X(150)" AT 1 SKIP
     6710   "Продолжение - на следующей странице" AT 30 SKIP
     6711   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     6712   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     6713   FORM with FRAME BrFrame  .
     6714   run waitfram-show in this-procedure ("Ждите...").
     6715   FOR EACH buf_temp_grplib_grp :
     6716     FIND LAST buf_tax-rate-gds-grp No-LOCK WHERE
     6717               buf_tax-rate-gds-grp.node-code = buf_temp_grplib_grp.node-code AND
     6718               buf_tax-rate-gds-grp.tax-code = integer('1':U) AND
     6719               buf_tax-rate-gds-grp.host-code = 0 AND
     6720               buf_tax-rate-gds-grp.obj-type = "" AND
     6721               buf_tax-rate-gds-grp.obj-code = 0 NO-ERROR.
     6722     if avail buf_tax-rate-gds-grp then do:
     6723   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6724   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     6725     (input  ?
     6726     ,input  buf_tax-rate-gds-grp.tax-code
     6727     ,input  buf_tax-rate-gds-grp.rate-code
     6728     ,input  ?
     6729     ,input  v-current-host-code
     6730     ,input  v-current-store-type
     6731     ,input  v-current-store-code
     6732     ,output v-vat-pc
     6733     ) no-error .
     6734     end.
     6735     FIND LAST buf_tax-rate-gds-grp No-LOCK WHERE
     6736               buf_tax-rate-gds-grp.node-code = buf_temp_grplib_grp.node-code AND
     6737               buf_tax-rate-gds-grp.tax-code = integer('2':U) AND
     6738               buf_tax-rate-gds-grp.host-code = 0 AND
     6739               buf_tax-rate-gds-grp.obj-type = "" AND
     6740               buf_tax-rate-gds-grp.obj-code = 0 NO-ERROR.
     6741     if avail buf_tax-rate-gds-grp then do:
     6742   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     6744     (input  ?
     6745     ,input  buf_tax-rate-gds-grp.tax-code
     6746     ,input  buf_tax-rate-gds-grp.rate-code
     6747     ,input  ?
     6748     ,input  v-current-host-code
     6749     ,input  v-current-store-type
     6750     ,input  v-current-store-code
     6751     ,output v-slt-pc
     6752     ) no-error .
     6753     end.
     6754     DISPLAY stream PrnLibStream
     6755     buf_temp_grplib_grp.name
     6756     buf_temp_grplib_grp.calc-method
     6757     buf_temp_grplib_grp.increase-pc
     6758     buf_temp_grplib_grp.min-marg
     6759     buf_temp_grplib_grp.max-marg
     6760     buf_temp_grplib_grp.round-method
     6761     v-vat-pc
     6762     v-slt-pc
     6763     with frame BrFrame.
     6764     down stream PrnLibStream
     6765     with frame BrFrame.
     6766   END.
     6767   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     6768   HIDE  STREAM PrnLibStream FRAME BrFrame.
     6769   output  STREAM PrnLibStream CLOSE.
     6770   run waitfram-hide in this-procedure .
     6771   run prn-lib-prn-file in this-procedure (
     6772         input parparentproc
     6773       , input 8
     6774   ).
     6775   END PROCEDURE.
     6776   PROCEDURE proc-add :
     6777   define output parameter p-doc-rec as recid no-undo .
     6778   define variable v-host-code as integer   no-undo .
     6779   DEFINE VARIABLE cError as CHARACTER NO-UNDO INITIAL "".
     6780   DEFINE VARIABLE iDelta as INTEGER   NO-UNDO INITIAL 0.
     6781   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6782   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6783     (input  p-current-obj-type
     6784     ,input  p-current-obj-code
     6785     ,output v-host-code
     6786     )  .
     6787   for each tt-gds-list :
     6788      delete tt-gds-list.
     6789   end.
     6790   run str/chsgdsls.w
     6791   (   parParentProc ,
     6792       input "gds-matr" ,
     6793       input "Ассортиментная матрица " + buf_matrix.asmt-name  , ? , ? ,
     6794       input v-host-code,
     6795       input-output varschartic,
     6796       output ref-list,
     6797       output table tt-gds-list,
     6798       false )
     6799        no-error .
     6800        if error-status :error then do:
     6801        message
     6802           vss-workfile vss-revision vss-description skip
     6803           error-status :get-message(1) skip
     6804           return-value skip
     6805           view-as alert-box error
     6806           .
     6807        end.
     6808   RUN Get-Gl-Param-Proc-Otkl in THIS-PROCEDURE(
     6809       p-Id,
     6810       p-Db-num,
     6811       OUTPUT cError
     6812       ).
     6813   if cError <> "" THEN DO:
     6814      RETURN ERROR cError.
     6815   END.
     6816   DEFINE VARIABLE vss-include-info36 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     6817   FOR EACH tt-gds-list NO-LOCK:
     6818       IF NOT CAN-FIND(FIRST ub.Assortment-matrix-goods WHERE
     6819                             ub.Assortment-matrix-goods.Asmt-id      = buf_matrix.Asmt-id
     6820                         AND ub.Assortment-matrix-goods.Db-num       = buf_matrix.db-num
     6821                         AND ub.Assortment-matrix-goods.gds-code     = tt-gds-list.gds-code
     6822                         AND ub.Assortment-matrix-goods.asmg-status  = INTEGER('0':U)
     6823                         NO-LOCK) THEN DO:
     6824          ASSIGN
     6825             iDelta = iDelta + 1.
     6826       END.
     6827   END.
     6828    RUN Cntrl-AM-Add-1 IN THIS-PROCEDURE(
     6829        iDelta,
     6830        OUTPUT cError
     6831        ).
     6832    if cError <> "" THEN DO:
     6833       RETURN ERROR cError.
     6834    END.
     6835    run waitfram-show in this-procedure  ("Добавление товаров в ассортиментную матрицу ... " ) .
     6836    for each tt-gds-list:
     6837   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
     6838    (input this-procedure
     6839    ,input-output p-doc-rec
     6840    ,input 'ДОБАВЛЕНИЕ':U
     6841    ,input buf_matrix.asmt-id
     6842    ,input buf_matrix.db-num
     6843    ,input tt-gds-list.gds-code
     6844    ,input ''
     6845     ) no-error .
     6846           if error-status :error then do:
     6847               message return-value view-as alert-box information .
     6848               run waitfram-hide in this-procedure .
     6849               return.
     6850           end.
     6851    end.
     6852   run waitfram-hide in this-procedure .
     6853   END PROCEDURE.
     6854   PROCEDURE proc-b-del :
     6855   define input  parameter p-recid as character no-undo .
     6856   define input  parameter p-model as logical   no-undo .
     6857   define variable loc#log as logical no-undo.
     6858   define variable v-log as logical   no-undo .
     6859   define variable v-sts like ub.assortment-matrix-goods.asmg-status no-undo .
     6860   define variable loc-doc-rec as recid no-undo.
     6861   define variable i as integer   no-undo .
     6862   if not available buf_matrix-goods then return error.
     6863   do
     6864   on error undo, return error
     6865   on stop undo, return error
     6866   :
     6867   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6868   do:
     6869     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6870       (input  v-cntxt-db-num
     6871       ,input  v-cntxt-userid
     6872       ,input  0
     6873       ,input  'actn_assort-matr-gds_deletion':U
     6874       ,input  'global':U
     6875       ,input  0
     6876       ,input  '':U
     6877       ,input  0
     6878       ,input  0
     6879       ,input  0
     6880       ,input  0
     6881       ,input  true
     6882       ,output v-log
     6883       )  .
     6884   end.
     6885    if not v-log then return no-apply .
     6886      assign
     6887       v-sts = ?
     6888       loc-doc-rec = RECID(buf_Matrix-goods)
     6889       .
     6890     if p-model = false then do:
     6891   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     6892    (input this-procedure
     6893    ,input recid(buf_Matrix-goods)
     6894    ,input-output v-sts
     6895    ,input true
     6896     ) no-error .
     6897       if error-status:error then do:
     6898          message return-value view-as alert-box information .
     6899          undo, return error.
     6900       end.
     6901     end.
     6902     else do:
     6903         v-err-ext = false  .
     6904         v-longchar = "".
     6905         repeat i = 1 to num-entries(p-recid) :
     6906         find first buf_Matrix-goods no-lock where
     6907              recid(buf_Matrix-goods) = integer(entry(i,p-recid )) no-error .
     6908           if buf_Matrix-goods.asmg-status = 0 then do:
     6909   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     6910    (input this-procedure
     6911    ,input entry(i,p-recid)
     6912    ,input-output v-sts
     6913    ,input false
     6914     ) no-error .
     6915                 if error-status :error then do:
     6916                    v-err-ext = true .
     6917                    v-longchar = v-longchar  + return-value + chr(10) .
     6918                 end.
     6919           end.
     6920         end.
     6921       p-recid = "" .
     6922       p-rid-list = "" .
     6923       if v-err-ext = true  then do:
     6924       define variable v-ok as logical   no-undo .
     6925         run gbl/d-longchar.w (
     6926               ?,
     6927               'Editor_row=2\':u
     6928             + 'title=При корректировке в Ассортиментные матрицы\':u
     6929             + 'Editor_col=1\':u
     6930             + 'Editor_width=96\':u
     6931             + 'Editor_height=21\':u
     6932             + 'readonly=yes\':u
     6933           ,input-output v-longchar
     6934           ,output v-ok ) no-error .
     6935           v-longchar = "" .
     6936   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     6937      .
     6938       end.
     6939     end.
     6940     OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     6941     REPOSITION BROWSE-am-goods to recid loc-doc-rec No-error.
     6942     if error-status:error then do:                           find first pos_assortment-matrix no-lock where                                   recid(pos_assortment-matrix) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи AM" skip                            string(if avail pos_assortment-matrix                                     then  substitute("Вн код AM: &1"                                                     , pos_assortment-matrix.asmt-id)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     6943     if available buf_Matrix-goods then do:
     6944       loc#log = BROWSE-am-goods:select-focused-row( ) IN FRAME Dlg-grp.
     6945       loc#log = BROWSE-am-goods:refresh() .
     6946     end.
     6947     apply "ENTRY" to BROWSE-am-goods.
     6948   end.
     6949   END PROCEDURE.
     6950   PROCEDURE proc-b-print :
     6951   define variable v-doc-rec as recid no-undo .
     6952   define variable accum-count as integer.
     6953   define variable date_string     as      character    no-undo.
     6954   define variable Line            as      character    no-undo.
     6955   define variable v-time-cr as character no-undo .
     6956   define variable v-time-up as character no-undo .
     6957   define variable v-st      as character no-undo .
     6958   DEFINE FRAME buf_Matrix-list
     6959         Buf_goods.artic FORMAT "X(16)":U
     6960         Buf_goods.gds-name FORMAT "X(30)":U
     6961         Buf_matrix-goods.asmg-who-update COLUMN-LABEL "Кто!изменил" FORMAT "X(8)":U
     6962         Buf_matrix-goods.asmg-date-update COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
     6963         p-time-upd COLUMN-LABEL "Время" FORMAT "x(5)":U
     6964         Buf_matrix-goods.asmg-db-num-update COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     6965         Buf_matrix-goods.asmg-date-create COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     6966         p-time-cr COLUMN-LABEL "Время" FORMAT "x(5)":U
     6967         Buf_matrix-goods.asmg-who-create COLUMN-LABEL "Кто!создал" FORMAT "X(8)":U
     6968         Buf_matrix-goods.asmg-db-num-create COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
     6969         p-status COLUMN-LABEL "Статус" FORMAT "x(6)":U
     6970         v-indicator-life-gds COLUMN-LABEL "ИЖТ" FORMAT "x(20)":U
     6971         v-assort-min         column-label "AMin" format "*/ "
     6972   HEADER  date_string AT 5 format "X(35)"
     6973    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     6974   Line format "X(195)" AT 1
     6975   with width 232 down stream-io use-text    .
     6976   Line = fill("-", 195).
     6977   date_string = cur-time-print() .
     6978   run prn-lib-open-stream  in this-procedure (
     6979                                                input parParentProc
     6980                                               ,input 43
     6981                                               ,input yes
     6982                                               ,input no
     6983                                               ).
     6984   PUT  STREAM PrnLibStream
     6985   SPACE(25) ( frame Dlg-grp:title )
     6986   format "x(90)" SKIP(1) .
     6987   FORM HEADER
     6988   Line format "X(195)" AT 1 SKIP
     6989   "Продолжение - на следующей странице" AT 30 SKIP
     6990   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     6991   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     6992   FORM with FRAME buf_Matrix-list  .
     6993   run waitfram-show in this-procedure ("Ждите...").
     6994   v-doc-rec = recid(buf_Matrix-goods).
     6995   DO WHILE available buf_Matrix-goods :
     6996     GET prev BROWSE-am-goods.
     6997   END.
     6998   GET next BROWSE-am-goods.
     6999   DO WHILE available buf_Matrix-goods :
     7000   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7001   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     7002     (input  buf_matrix.obj-type
     7003     ,input  buf_matrix.obj-code
     7004     ,input  ?
     7005     ,input  ?
     7006     ,input  ?
     7007     ,input  buf_Matrix-goods.gds-code
     7008     ,output v-assort-min
     7009     ,output v-indicator-life-gds
     7010     ,output v-gdop-min-stock
     7011     ,output v-grop-max-stock
     7012     ,output v-grop-level-always-presence
     7013     ,output v-grop-min-order
     7014     )  .
     7015     Display STREAM PrnLibStream
     7016       STRING (buf_Matrix-goods.asmg-time-create,'HH:MM') @ p-time-cr
     7017       STRING (buf_Matrix-goods.asmg-time-update,'HH:MM') @ p-time-upd
     7018              entry (lookup (STRING(buf_Matrix-goods.asmg-status), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ p-status
     7019               Buf_goods.artic
     7020               Buf_goods.gds-name
     7021               Buf_matrix-goods.asmg-who-update
     7022               Buf_matrix-goods.asmg-date-update
     7023               Buf_matrix-goods.asmg-db-num-update
     7024               Buf_matrix-goods.asmg-date-create
     7025               Buf_matrix-goods.asmg-who-create
     7026               Buf_matrix-goods.asmg-db-num-create
     7027               v-indicator-life-gds
     7028               v-assort-min
     7029    with FRAME buf_Matrix-list .
     7030     DOWN STREAM PrnLibStream 1
     7031     with FRAME buf_Matrix-list  .
     7032     assign
     7033     accum-count = accum-count + 1
     7034     .
     7035     GET next BROWSE-am-goods.
     7036   END.
     7037   UNDERLINE  STREAM PrnLibStream
     7038       p-time-cr
     7039       p-time-upd
     7040       p-status
     7041       Buf_goods.artic
     7042       Buf_goods.gds-name
     7043       Buf_matrix-goods.asmg-who-update
     7044       Buf_matrix-goods.asmg-date-update
     7045       Buf_matrix-goods.asmg-db-num-update
     7046       Buf_matrix-goods.asmg-date-create
     7047       Buf_matrix-goods.asmg-who-create
     7048       Buf_matrix-goods.asmg-db-num-create
     7049       v-indicator-life-gds
     7050       v-assort-min
     7051   with FRAME buf_Matrix-list .
     7052   DISPLAY STREAM PrnLibStream
     7053   "ИТОГО"     @ Buf_goods.artic
     7054   accum-count @ Buf_goods.gds-name
     7055   with frame buf_Matrix-list.
     7056   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     7057   HIDE  STREAM PrnLibStream FRAME buf_Matrix-List.
     7058   output  STREAM PrnLibStream CLOSE.
     7059   REPOSITION BROWSE-am-goods to recid v-doc-rec no-error.
     7060   APPLY "entry" to BROWSE-am-goods.
     7061   run waitfram-hide in this-procedure .
     7062   run prn-lib-prn-file in this-procedure (
     7063                                             input parParentProc
     7064                                             ,input 8
     7065                                             ).
     7066   END PROCEDURE.
     7067   PROCEDURE proc-copy :
     7068   define output parameter p-doc-rec as recid no-undo .
     7069   define variable  v-rid-list as character no-undo .
     7070   define buffer bb_assortment-matrix for assortment-matrix.
     7071   define buffer bb_assortment-matrix-goods for assortment-matrix-goods.
     7072   define variable v-calc0    as integer   no-undo init 1 .
     7073   define variable v-calc     as integer   no-undo init 0 .
     7074   define variable v-calc-err as integer   no-undo init 0 .
     7075   DEFINE VARIABLE cError as CHARACTER NO-UNDO INITIAL "".
     7076   DEFINE VARIABLE iDelta as INTEGER   NO-UNDO INITIAL 0.
     7077   RUN Get-Gl-Param-Proc-Otkl in THIS-PROCEDURE(
     7078       p-Id,
     7079       p-Db-num,
     7080       OUTPUT cError
     7081       ).
     7082   if cError <> "" THEN DO:
     7083      RETURN ERROR cError.
     7084   END.
     7085   run ref/assmatr.w ( input parParentProc , input 'b-sel', p-current-obj-type , p-current-obj-code , ? ,  ?, input-output  v-rid-list ).
     7086   if v-rid-list <> "" then do:
     7087      find first bb_assortment-matrix no-lock where recid(bb_assortment-matrix) = int(v-rid-list) no-error .
     7088      if available bb_assortment-matrix then do:
     7089         RUN Get-Delta-Gds-2-Matrix in THIS-PROCEDURE(
     7090             BUFFER bb_assortment-matrix,
     7091             BUFFER buf_matrix,
     7092             OUTPUT iDelta
     7093             ).
     7094         RUN Cntrl-AM-Add-1 IN THIS-PROCEDURE(
     7095             iDelta,
     7096             OUTPUT cError
     7097             ).
     7098         IF cError <> "" THEN DO:
     7099            RETURN ERROR cError.
     7100         END.
     7101         for each  bb_assortment-matrix-goods no-lock where
     7102                   bb_assortment-matrix-goods.asmg-status  = 0 and
     7103                   bb_assortment-matrix-goods.db-num = bb_assortment-matrix.db-num and
     7104                   bb_assortment-matrix-goods.asmt-id = bb_assortment-matrix.asmt-id :
     7105               run waitfram-show in this-procedure  ("Копирование из ассортиментной матрицы " + bb_assortment-matrix.asmt-name + " " + string(v-calc0) ) .
     7106   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
     7107    (input this-procedure
     7108    ,input-output p-doc-rec
     7109    ,input 'ДОБАВЛЕНИЕ':U
     7110    ,input buf_matrix.asmt-id
     7111    ,input buf_matrix.db-num
     7112    ,input bb_assortment-matrix-goods.gds-code
     7113    ,input bb_assortment-matrix-goods.asmg-des
     7114     ) no-error .
     7115                       if error-status :error then do:
     7116                          v-calc-err = v-calc-err + 1 .
     7117                          v-err-ext  = true .
     7118                          v-longchar = v-longchar + return-value  + chr(10) .
     7119                       end.
     7120                       else  do:
     7121                         v-calc = v-calc + 1 .
     7122                       end.
     7123                     v-calc0 = v-calc0 + 1 .
     7124         end.
     7125         run waitfram-hide in this-procedure .
     7126         message
     7127         "Скопировано" v-calc "товаров" skip
     7128         "Ошибок"      v-calc-err       skip
     7129         view-as alert-box information .
     7130         if v-err-ext = true  then do:
     7131         define variable v-ok as logical   no-undo .
     7132           run gbl/d-longchar.w (
     7133                 ?,
     7134                 'Editor_row=2\':u
     7135               + 'title=При добавлении в Ассортиментные матрицы\':u
     7136               + 'Editor_col=1\':u
     7137               + 'Editor_width=96\':u
     7138               + 'Editor_height=21\':u
     7139               + 'readonly=yes\':u
     7140             ,input-output v-longchar
     7141             ,output v-ok ) no-error .
     7142              v-longchar = "" .
     7143   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     7144      .
     7145         end.
     7146      end.
     7147   end.
     7148   END PROCEDURE.
     7149   PROCEDURE recalc-lim :
     7150   define buffer loc_temp_grplib_grp for temp_grplib_grp  .
     7151   define variable v-recid as recid no-undo .
     7152   v-recid = recid (temp_grplib_grp) .
     7153   for each temp_cons  :
     7154     run calc-down-lim ( input temp_cons.node-code , output temp_cons.min-marg).
     7155     find first loc_temp_grplib_grp where
     7156                loc_temp_grplib_grp.node-code = temp_cons.node-code no-error .
     7157         if available loc_temp_grplib_grp then loc_temp_grplib_grp.min-marg  = temp_cons.min-marg .
     7158   end.
     7159   find first temp_grplib_grp where recid (temp_grplib_grp)  = v-recid no-error .
     7160   OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     7161   reposition BR-list to recid v-recid no-error.
     7162   END PROCEDURE.
     7163   PROCEDURE recalc-marg-ass :
     7164   define variable v-qntyAssgrp as integer  no-undo .
     7165   define variable ll as integer   no-undo .
     7166   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
     7167   define buffer buf2_goods for ub.goods  .
     7168   define buffer loc_temp_grplib_grp for  temp_grplib_grp .
     7169   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     7170   define variable v-recid as recid no-undo .
     7171   v-recid = recid (temp_grplib_grp) .
     7172       for each loc_temp_grplib_grp :
     7173         run calc-down-lim   (
     7174             input loc_temp_grplib_grp.node-code ,
     7175             output loc_temp_grplib_grp.min-marg).
     7176           v-qntyAssgrp = 0.
     7177           find first buf1_gds-grp-obj-attr no-lock where
     7178                      buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
     7179                      buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
     7180                      buf1_gds-grp-obj-attr.obj-code  = p-db-num and
     7181                      buf1_gds-grp-obj-attr.host-code = 0 and
     7182                      buf1_gds-grp-obj-attr.node-code = loc_temp_grplib_grp.node-code
     7183           no-error .
     7184           if available buf1_gds-grp-obj-attr then v-qntyAssgrp = int(buf1_gds-grp-obj-attr.attr-value) .
     7185           assign
     7186             loc_temp_grplib_grp.max-marg = string(v-qntyAssgrp)
     7187           .
     7188       end.
     7189   run init-tt.
     7190   find first temp_grplib_grp where recid(temp_grplib_grp)  = v-recid no-error .
     7191   OPEN QUERY br-list FOR EACH temp_grplib_grp NO-LOCK by temp_grplib_grp.sort-name.
     7192   reposition BR-list to recid v-recid no-error.
     7193   OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     7194   END PROCEDURE.
     7195   PROCEDURE save-alla :
     7196   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr .
     7197   if temp_grplib_grp.cli-type:read-only in browse br-list = false then do:
     7198     for each temp_cons :
     7199           find first buf_gds-grp-obj-attr exclusive-lock where
     7200                      buf_gds-grp-obj-attr.attr-code = 'LimAssMat':U and
     7201                      buf_gds-grp-obj-attr.obj-type  = string(buf_matrix.asmt-id) and
     7202                      buf_gds-grp-obj-attr.obj-code  = buf_matrix.db-num and
     7203                      buf_gds-grp-obj-attr.host-code = 0 and
     7204                      buf_gds-grp-obj-attr.node-code = temp_cons.node-code no-error .
     7205           if not available buf_gds-grp-obj-attr then create buf_gds-grp-obj-attr.
     7206           assign
     7207               buf_gds-grp-obj-attr.attr-code = 'LimAssMat':U
     7208               buf_gds-grp-obj-attr.obj-type  = string(buf_matrix.asmt-id)
     7209               buf_gds-grp-obj-attr.obj-code  = buf_matrix.db-num
     7210               buf_gds-grp-obj-attr.host-code = 0
     7211               buf_gds-grp-obj-attr.node-code  = temp_cons.node-code
     7212               buf_gds-grp-obj-attr.attr-value = temp_cons.cli-type
     7213           .
     7214     end.
     7215     end.
     7216   END PROCEDURE.
     7217   PROCEDURE save-attr :
     7218   define buffer buf_gds-grp-obj-attr  for ub.gds-grp-obj-attr  .
     7219   if temp_grplib_grp.cli-type:read-only in browse br-list = false then do:
     7220       if available  temp_grplib_grp then do:
     7221           find first buf_gds-grp-obj-attr exclusive-lock where
     7222                      buf_gds-grp-obj-attr.attr-code = 'LimAssMat':U and
     7223                      buf_gds-grp-obj-attr.obj-type  = string(buf_matrix.asmt-id) and
     7224                      buf_gds-grp-obj-attr.obj-code  = buf_matrix.db-num and
     7225                      buf_gds-grp-obj-attr.host-code = 0 and
     7226                      buf_gds-grp-obj-attr.node-code = temp_grplib_grp.node-code no-error .
     7227           if not available buf_gds-grp-obj-attr then create buf_gds-grp-obj-attr.
     7228           assign
     7229               buf_gds-grp-obj-attr.attr-code = 'LimAssMat':U
     7230               buf_gds-grp-obj-attr.obj-type  = string(buf_matrix.asmt-id)
     7231               buf_gds-grp-obj-attr.obj-code  = buf_matrix.db-num
     7232               buf_gds-grp-obj-attr.host-code = 0
     7233               buf_gds-grp-obj-attr.node-code = temp_grplib_grp.node-code
     7234               buf_gds-grp-obj-attr.attr-value = temp_grplib_grp.cli-type
     7235           .
     7236        end.
     7237     end.
     7238   END PROCEDURE.
     7239   PROCEDURE select-and-move-item :
     7240   do
     7241   on error undo, return error
     7242   :
     7243   define input parameter p-node-code as integer      no-undo.
     7244       define variable v-upper-code        as integer           no-undo.
     7245       define variable v-upper-recid-list  as character         no-undo.
     7246       define variable v-yesno             as logical           no-undo.
     7247       define variable v-node-full-name    as character         no-undo.
     7248       define variable v-upper-full-name   as character         no-undo.
     7249       define buffer buf_gds-grp       for gds-grp.
     7250       if p-node-code = v-root-code
     7251       then do:
     7252           message
     7253           "Корневую группу переместить невозможно."
     7254           view-as alert-box warning.
     7255           undo, return .
     7256       end.
     7257       find first buf_gds-grp no-lock
     7258            where buf_gds-grp.node-code = p-node-code
     7259       no-error .
     7260       if error-status :error
     7261       then do:
     7262           undo, return error "select-and-move-item: Группа не найдена в базе данных.".
     7263       end.
     7264       assign
     7265           v-upper-recid-list = string( recid( buf_gds-grp ) )
     7266       .
     7267       run ref/gds-grp.w (
     7268             input parparentproc
     7269           , input "buttons-for-move"
     7270           , input p-current-obj-type
     7271           , input p-current-obj-code
     7272           , input-output v-upper-recid-list
     7273       ) no-error .
     7274       if error-status :error
     7275       then do:
     7276           message
     7277             vss-workfile vss-revision vss-description
     7278             skip "Ошибка выбора группы для перемещения."
     7279             skip return-value
     7280             skip trim(error-status :get-message(1))
     7281                  trim(error-status :get-message(2))
     7282                  trim(error-status :get-message(3))
     7283                  trim(error-status :get-message(4))
     7284                  trim(error-status :get-message(5))
     7285           view-as alert-box error.
     7286           undo, return no-apply .
     7287       end.
     7288       find first buf_gds-grp no-lock
     7289            where recid( buf_gds-grp ) = integer( entry( 1, v-upper-recid-list ) )
     7290       no-error .
     7291       if error-status :error
     7292       then do:
     7293           undo, return error "Группа не найдена.".
     7294       end.
     7295       run grplib-get-full-name in this-procedure (  input p-node-code
     7296                                                   , output v-node-full-name
     7297       ) no-error .
     7298       if error-status :error
     7299       then do:
     7300           undo, return error "Ошибка вычисления полного имени перемещаемой группы.".
     7301       end.
     7302       run grplib-get-full-name in this-procedure (  input buf_gds-grp.node-code
     7303                                                   , output v-upper-full-name
     7304       ) no-error .
     7305       if error-status :error
     7306       then do:
     7307           undo, return error "Ошибка вычисления полного имени новой группы".
     7308       end.
     7309       message
     7310           "Переместить группу"
     7311           skip "    '" + v-node-full-name + "'"
     7312           skip "в группу"
     7313           skip "    '" + v-upper-full-name + "'"
     7314       view-as alert-box question
     7315       buttons yes-no
     7316       title "Перемещение группы"
     7317       update v-yesno.
     7318       if v-yesno = no
     7319       then do:
     7320       end.
     7321       else do:
     7322           run move-item in this-procedure ( input p-node-code
     7323                                           , input buf_gds-grp.node-code
     7324           ) no-error.
     7325           if error-status :error
     7326           then do:
     7327               message
     7328               vss-workfile vss-revision vss-description
     7329               skip "Ошибка перемещения группы."
     7330               skip return-value
     7331               skip trim(error-status :get-message(1))
     7332                   trim(error-status :get-message(2))
     7333                   trim(error-status :get-message(3))
     7334                   trim(error-status :get-message(4))
     7335                   trim(error-status :get-message(5))
     7336               view-as alert-box error.
     7337               undo, return no-apply .
     7338           end.
     7339       end.
     7340   end.
     7341   END PROCEDURE.
     7342   PROCEDURE UI-on :
     7343   do
     7344   on error undo, return error
     7345   :
     7346   define variable v-reposition-row        as integer          no-undo.
     7347   define variable v-focused-row           as integer          no-undo.
     7348   define variable v-reposition-to-recid   as logical init no  no-undo.
     7349   define variable v-enable-change-grp     as logical          no-undo.
     7350   define variable v-margins-range         as integer          no-undo.
     7351   define variable v-margins-exists        as logical          no-undo.
     7352   define variable v-increase-range         as integer          no-undo.
     7353   define variable v-increase-exists        as logical          no-undo.
     7354   define variable v-min-marg              as decimal          no-undo.
     7355   define variable v-max-marg              as decimal          no-undo.
     7356   define variable v-increase-pc              as decimal          no-undo.
     7357   define variable v-have-goods            as logical          no-undo.
     7358   define variable v-round-method      as character   no-undo .
     7359   define variable v-base                  as decimal no-undo .
     7360   define variable v-rmethod-range     as integer     no-undo.
     7361   define variable v-rmethod-exists    as logical     no-undo.
     7362   define variable v-cli-type          as character no-undo .
     7363   define variable v-cli-code          as integer     no-undo.
     7364   define variable v-income-cli-range    as integer  no-undo.
     7365   define variable v-income-cli-exists   as logical  no-undo.
     7366   define variable v-dop                   as character no-undo .
     7367   define variable v-full-name             as character    no-undo.
     7368   define variable v-sort-name             as character    no-undo.
     7369   define buffer buf_gds-grp           for gds-grp.
     7370   define buffer buf_temp_grplib_grp   for temp_grplib_grp.
     7371   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7372   do:
     7373     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7374       (input  v-cntxt-db-num
     7375       ,input  v-cntxt-userid
     7376       ,input  0
     7377       ,input  'actn_reference_groups-edit':U
     7378       ,input  'firm':U
     7379       ,input  v-cntxt-host-code-obj
     7380       ,input  '':U
     7381       ,input  0
     7382       ,input  0
     7383       ,input  0
     7384       ,input  0
     7385       ,input  no
     7386       ,output v-enable-change-grp
     7387       )  .
     7388   end.
     7389   run grplib-get-root-code in this-procedure ( output v-root-code ) no-error.
     7390   if error-status :error
     7391   then do:
     7392       undo, return error "Не найден корневой узел." + chr(10) + return-value.
     7393   end.
     7394   if v-from-b-gds then do:
     7395     run uf-get in this-procedure(
     7396         input  'gds-grp-p':U
     7397         ,input  g#userid
     7398         ,output v-uf-List_
     7399         ,output v-uf-Naim
     7400         ,output v-uf-print-graft
     7401         ,output v-uf-sort-gr
     7402         ,output v-uf-type-price
     7403         ,output v-uf-type-val
     7404     )  no-error .
     7405     if not error-status:error then
     7406     assign
     7407     v-dop = string((if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_)))
     7408     .
     7409     if v-dop = v-old-recid-list then do:
     7410       assign
     7411       gds-grp-row = v-old-recid
     7412       .
     7413     end.
     7414     else do:
     7415       assign
     7416       gds-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
     7417       .
     7418     end.
     7419     assign
     7420         p-recid-list = string( gds-grp-row )
     7421     .
     7422     assign
     7423     v-from-b-gds = no
     7424     v-old-recid-list = "":U.
     7425   end.
     7426   else do:
     7427     run uf-get in this-procedure(
     7428         input  'gds-grp-p':U
     7429         ,input  g#userid
     7430         ,output v-uf-List_
     7431         ,output v-uf-Naim
     7432         ,output v-uf-print-graft
     7433         ,output v-uf-sort-gr
     7434         ,output v-uf-type-price
     7435         ,output v-uf-type-val
     7436     )  no-error .
     7437     if not error-status:error then
     7438     assign
     7439     gds-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
     7440     .
     7441     assign
     7442         p-recid-list = string( gds-grp-row )
     7443     .
     7444   end.
     7445   find first buf_gds-grp no-lock
     7446        where buf_gds-grp.node-code = v-root-code
     7447   no-error .
     7448   if error-status :error
     7449   then do:
     7450       message
     7451         vss-workfile vss-revision vss-description
     7452         skip "Не найдена запись корневого узла."
     7453         skip return-value
     7454         skip trim(error-status :get-message(1))
     7455              trim(error-status :get-message(2))
     7456              trim(error-status :get-message(3))
     7457              trim(error-status :get-message(4))
     7458              trim(error-status :get-message(5))
     7459       view-as alert-box error.
     7460       undo, return error .
     7461   end.
     7462   if buf_gds-grp.is-term = yes
     7463   then do:
     7464       run grplib-have-goods in this-procedure (
     7465             input buf_gds-grp.node-code
     7466           , output v-have-goods
     7467       ) no-error .
     7468       if error-status :error
     7469       then do:
     7470           undo, return error "move-item: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     7471       end.
     7472   end.
     7473   for each buf_temp_grplib_grp
     7474   :
     7475       delete buf_temp_grplib_grp.
     7476   end.
     7477   create buf_temp_grplib_grp.
     7478   assign
     7479       buf_temp_grplib_grp.node-code   = buf_gds-grp.node-code
     7480       buf_temp_grplib_grp.upper-code  = buf_gds-grp.upper-code
     7481       buf_temp_grplib_grp.level       = 0
     7482       buf_temp_grplib_grp.mark        = ( if v-have-goods = yes then "•" else " " )
     7483       buf_temp_grplib_grp.full-name   = chr(4)
     7484       buf_temp_grplib_grp.sort-name   = chr(4)
     7485       buf_temp_grplib_grp.name        = buf_gds-grp.node-name
     7486       buf_temp_grplib_grp.increase-pc = buf_gds-grp.increase-pc
     7487       buf_temp_grplib_grp.calc-method = buf_gds-grp.calc-method
     7488   .
     7489   for each buf_gds-grp no-lock
     7490      where buf_gds-grp.upper-code = v-root-code
     7491   :
     7492       run grplib-get-full-name in this-procedure (
     7493             input buf_gds-grp.node-code
     7494           , output v-full-name
     7495       ) no-error .
     7496       if error-status :error
     7497       then do:
     7498           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
     7499       end.
     7500       run grplib-get-sort-name in this-procedure (
     7501             input buf_gds-grp.node-code
     7502           , output v-sort-name
     7503       ) no-error .
     7504       if error-status :error
     7505       then do:
     7506           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
     7507       end.
     7508       run create-new-line in this-procedure (
     7509             input buf_gds-grp.node-code
     7510           , input buf_gds-grp.upper-code
     7511           , input 1
     7512           , input buf_gds-grp.is-term
     7513           , input buf_gds-grp.node-name
     7514           , input buf_gds-grp.increase-pc
     7515           , input buf_gds-grp.calc-method
     7516           , input "":U
     7517           , input "":U
     7518       ) no-error .
     7519       if error-status :error
     7520       then do:
     7521           message
     7522             vss-workfile vss-revision vss-description
     7523             skip "UI-on: Ошибка добавления строки в список групп."
     7524             skip return-value
     7525             skip trim(error-status :get-message(1))
     7526                  trim(error-status :get-message(2))
     7527                  trim(error-status :get-message(3))
     7528                  trim(error-status :get-message(4))
     7529                  trim(error-status :get-message(5))
     7530           view-as alert-box error.
     7531           undo, return error .
     7532       end.
     7533   end.
     7534   if  p-recid-list <> "" and p-recid-list <> ?
     7535   then do:
     7536       assign
     7537           v-reposition-row = 1
     7538           v-focused-row    = 1
     7539       .
     7540       find first buf_gds-grp no-lock
     7541            where recid( buf_gds-grp ) = integer( entry( num-entries( p-recid-list ), p-recid-list ) )
     7542       no-error .
     7543       if not available buf_gds-grp
     7544       then do:
     7545       end.
     7546       else do:
     7547           run expand-tree-for-grp in this-procedure (
     7548               input buf_gds-grp.node-code
     7549               , output v-focused-row
     7550               , output v-reposition-row
     7551               , output v-reposition-to-recid
     7552           ) no-error .
     7553           if error-status :error
     7554           then do:
     7555               undo, return error "UI-on: Не удалось раскрыть дерево групп." + chr(10) + return-value.
     7556           end.
     7557       end.
     7558   end.
     7559   run enable_UI.
     7560   hide
     7561           b-mark      in frame Dlg-grp
     7562        .
     7563   case p-button-list
     7564   :
     7565   when "buttons-for-move"
     7566   then do:
     7567       disable
     7568           b-exit    with frame Dlg-grp
     7569       .
     7570   end.
     7571   when "buttons-for-admin"
     7572   then do:
     7573   end.
     7574   when 'терм':U + ",b-scales"
     7575   then do:
     7576   end.
     7577   when 'терм':U + ",b-sel" or when "b-sel"
     7578   then do:
     7579   end.
     7580   when "b-sel,b-mark"
     7581   then do:
     7582       view
     7583           b-mark in frame Dlg-grp
     7584       .
     7585   end.
     7586   end case.
     7587   if v-current-store-code = 0
     7588   or transaction
     7589   then do:
     7590   end.
     7591   br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     7592   run recalc-marg-ass.
     7593   if v-reposition-to-recid = no
     7594   then do:
     7595       reposition br-list to row v-reposition-row.
     7596   end.
     7597   else do:
     7598       reposition br-list to recid v-reposition-row.
     7599   end.
     7600   OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     7601   end.
     7602   END PROCEDURE.
