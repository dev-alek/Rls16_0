     2864   define buffer pos_assortment-matrix for ub.assortment-matrix.
     2865   DEFINE BUTTON B-add
     2866        LABEL "&Добавить"
     2867        SIZE 10 BY 1.
     2868   DEFINE BUTTON B-chg
