     2467   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2468   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2469   DEFINE VARIABLE vss-include-info19 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     2470   FUNCTION indicator-life-gds-n RETURNS CHARACTER ( input p-rec as recid ) FORWARD.
     2471   DEFINE VARIABLE v-gl-iProc-Otkl AS DECIMAL NO-UNDO INITIAL 0.
     2472   DEFINE VARIABLE v-gl-lAM-Is-Obj         AS LOGICAL NO-UNDO INITIAL FALSE.
     2473   DEFINE VARIABLE v-gl-iAM-Gds-All        AS INTEGER NO-UNDO INITIAL 0.
     2474   DEFINE VARIABLE v-gl-iAM-Sbl-Gds-All    AS INTEGER NO-UNDO INITIAL 0.
     2475   DEFINE VARIABLE v-gl-iAM-Gds-Vyv        AS INTEGER NO-UNDO INITIAL 0.
     2476   DEFINE VARIABLE v-gl-lAM-Ref-Shablon    AS LOGICAL NO-UNDO INITIAL FALSE.
     2477   DEFINE VARIABLE v-gl-dAM-Proc-Otkl      AS DECIMAL NO-UNDO INITIAL 0.
     2478   DEFINE VARIABLE v-gl-dAM-Proc-Otkl-Ras  AS DECIMAL NO-UNDO INITIAL 0.
     2479   FUNCTION Is-Gds-In-AssMatr RETURN LOGICAL(
     2480      p-Gds-code AS INTEGER,
     2481      p-Asmt-id  AS INTEGER,
     2482      p-Db-num   AS INTEGER):
     2483      DEFINE BUFFER buf_Gds FOR Ub.Assortment-matrix-goods.
     2484      RETURN CAN-FIND(FIRST buf_Gds WHERE
     2485                            buf_Gds.Asmt-id     = p-Asmt-id
     2486                        AND buf_Gds.Db-num      = p-Db-num
     2487                        AND buf_Gds.Gds-code    = p-Gds-code
     2488                        AND buf_Gds.Asmg-status = INTEGER('0':U)
     2489                      NO-LOCK).
     2490   END FUNCTION.
     2491   PROCEDURE Get-Delta-Gds-2-Matrix:
     2492      DEFINE PARAMETER BUFFER buf_AM-1 FOR ub.Assortment-matrix.
     2493      DEFINE PARAMETER BUFFER buf_AM-2 FOR ub.Assortment-matrix.
     2494      DEFINE OUTPUT PARAMETER iDelta AS INTEGER NO-UNDO INITIAL 0.
     2495      DEFINE BUFFER buf_Gds-1 FOR ub.Assortment-matrix-goods.
     2496      DEFINE BUFFER buf_Gds-2 FOR ub.Assortment-matrix-goods.
     2497      FOR EACH buf_Gds-1 WHERE
     2498               buf_Gds-1.Asmt-id = buf_AM-1.Asmt-id
     2499           AND buf_Gds-1.Db-num  = buf_AM-1.Db-num
     2500           AND buf_Gds-1.Asmg-status = INTEGER('0':U)
     2501          NO-LOCK:
     2502          IF NOT CAN-FIND(FIRST buf_Gds-2 WHERE
     2503                                buf_Gds-2.Asmt-id     = buf_AM-2.Asmt-id
     2504                            AND buf_Gds-2.Db-num      = buf_AM-2.Db-num
     2505                            AND buf_Gds-2.Gds-code    = buf_Gds-1.Gds-code
     2506                            AND buf_Gds-2.Asmg-status = INTEGER('0':U)
     2507                            NO-LOCK) THEN DO:
     2508             ASSIGN
     2509                iDelta = iDelta + 1.
     2510          END.
     2511      END.
     2512      RETURN.
     2513   END PROCEDURE.
     2514   PROCEDURE Cntrl-AM-Add-1:
     2515      DEFINE INPUT PARAMETER iDelta  AS INTEGER   NO-UNDO.
     2516      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2517      IF v-gl-iProc-Otkl = 0      THEN RETURN.
     2518      IF NOT v-gl-lAM-Is-Obj      THEN RETURN.
     2519      IF NOT v-gl-lAM-Ref-Shablon THEN RETURN.
     2520      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(iDelta).
     2521      IF iDelta = 0 THEN DO:
     2522         IF v-gl-dAM-Proc-Otkl >= v-gl-iProc-Otkl THEN DO:
     2523            cError = "В данной матрице процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl) + ")" + chr(10) +
     2524                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl) +  ")." + chr(10) +
     2525                     "Добавление товаров невозможно !".
     2526         END.
     2527      END. ELSE DO:
     2528         IF v-gl-dAM-Proc-Otkl-Ras >= v-gl-iProc-Otkl THEN DO:
     2529            cError = "В данной матрице будущий расчетный процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl-Ras) + ")" + chr(10) +
     2530                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl ) +  ")." + chr(10) +
     2531                     " Добавление товаров невозможно !".
     2532         END.
     2533      END.
     2534      RETURN.
     2535   END PROCEDURE.
     2536   PROCEDURE Get-Gl-Param-Proc-Otkl:
     2537      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2538      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2539      DEFINE OUTPUT PARAMETER  cError    AS CHARACTER  NO-UNDO INITIAL "".
     2540      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2541      FIND FIRST buf_AM WHERE
     2542                 buf_AM.asmt-id = p-Asmt-id
     2543             AND buf_AM.db-num  = p-Db-num
     2544           NO-LOCK NO-ERROR.
     2545      IF NOT AVAILABLE buf_AM THEN DO:
     2546         cError = PROGRAM-NAME(1) +  ":Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2547         RETURN.
     2548      END.
     2549      RUN Get-Gl-Set-Proc-Otkl IN THIS-PROCEDURE(
     2550          buf_AM.obj-type,
     2551          buf_AM.obj-code
     2552          ).
     2553      RUN Get-Gl-Param-AM-All in THIS-PROCEDURE(
     2554          buf_AM.Asmt-id,
     2555          buf_AM.db-num
     2556          ).
     2557      RETURN.
     2558   END PROCEDURE.
     2559   PROCEDURE Get-Gl-Param-AM-All:
     2560      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2561      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2562      DEFINE VARIABLE lIsAmObj    AS LOGICAL    NO-UNDO INITIAL FALSE.
     2563      DEFINE VARIABLE iSh-Asmt-id AS INTEGER    NO-UNDO INITIAL 0.
     2564      DEFINE VARIABLE iSh-Db-num  AS INTEGER    NO-UNDO INITIAL 0.
     2565      DEFINE VARIABLE cSh-Type    AS CHARACTER  NO-UNDO INITIAL "".
     2566      DEFINE VARIABLE cError      AS CHARACTER  NO-UNDO INITIAL "".
     2567      DEFINE VARIABLE dAmt        AS DECIMAL    EXTENT 2  NO-UNDO INITIAL 0.
     2568      DEFINE VARIABLE cMode       AS CHARACTER  NO-UNDO INITIAL "".
     2569      ASSIGN
     2570         v-gl-iAM-Gds-All     = 0
     2571         v-gl-iAM-Sbl-Gds-All = 0
     2572         v-gl-iAM-Gds-Vyv     = 0
     2573         v-gl-dAM-Proc-Otkl   = 0
     2574         v-gl-lAM-Ref-Shablon = FALSE
     2575         .
     2576      RUN Get-Param-AM IN THIS-PROCEDURE (
     2577          p-Asmt-id,
     2578          p-Db-num,
     2579          OUTPUT lIsAmObj,
     2580          OUTPUT iSh-Asmt-id,
     2581          OUTPUT iSh-Db-num,
     2582          OUTPUT cSh-Type,
     2583          OUTPUT cError
     2584          ).
     2585      IF cError <> "" THEN DO:
     2586         MESSAGE
     2587            PROGRAM-NAME(1) ":" SKIP
     2588            "Такого быть не должно !!!" SKIP
     2589            cError SKIP
     2590            VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2591         RETURN.
     2592      END.
     2593      ASSIGN
     2594         cMode                 = (IF lIsAmObj THEN "IL_GDS":U ELSE "")
     2595         v-gl-lAM-Ref-Shablon  = (IF iSh-Asmt-id = 0 THEN FALSE ELSE TRUE)
     2596         .
     2597      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2598          p-Asmt-Id,
     2599          p-Db-num,
     2600          '0':U,
     2601          cMode,
     2602          OUTPUT dAmt
     2603          ).
     2604      ASSIGN
     2605         v-gl-iAM-Gds-All = dAmt[1]
     2606         v-gl-iAM-Gds-Vyv = (IF lIsAmObj THEN dAmt[2] ELSE 0)
     2607         .
     2608       IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2609          RETURN.
     2610       END.
     2611      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2612          iSh-Asmt-id,
     2613          iSh-Db-num,
     2614          '0':U,
     2615          "",
     2616          OUTPUT dAmt
     2617          ).
     2618      ASSIGN
     2619         v-gl-iAM-Sbl-Gds-All = dAmt[1].
     2620      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(0).
     2621      RETURN.
     2622   END PROCEDURE.
     2623   PROCEDURE Get-Param-AM-Gds:
     2624      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2625      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2626      DEFINE INPUT PARAMETER   p-Stat    AS INTEGER    NO-UNDO.
     2627      DEFINE INPUT PARAMETER   p-Mode    AS CHARACTER  NO-UNDO.
     2628      DEFINE OUTPUT PARAMETER  o-dAmt    AS DECIMAL    EXTENT 2 NO-UNDO INITIAL 0.
     2629      DEFINE BUFFER buf_AM-goods FOR ub.Assortment-matrix-goods.
     2630      FOR EACH buf_AM-goods WHERE
     2631               buf_AM-goods.Asmt-id      = p-Asmt-Id
     2632           AND buf_AM-goods.Db-num       = p-Db-num
     2633           AND buf_AM-goods.asmg-status  = p-Stat
     2634          NO-LOCK:
     2635          ASSIGN
     2636             o-dAmt[1] = o-dAmt[1] + 1.
     2637          IF CAN-DO("IL_GDS":U, p-Mode) THEN DO:
     2638             IF Indicator-life-gds-n(recid(buf_AM-goods)) = 'На вывод из ассортимента':U THEN DO:
     2639                ASSIGN
     2640                   o-dAmt[2] = o-dAmt[2] + 1.
     2641             END.
     2642          END.
     2643      END.
     2644      RETURN.
     2645   END PROCEDURE.
     2646   PROCEDURE Get-Param-AM:
     2647      DEFINE INPUT  PARAMETER  p-Asmt-id   AS INTEGER   NO-UNDO.
     2648      DEFINE INPUT  PARAMETER  p-Db-num    AS INTEGER   NO-UNDO.
     2649      DEFINE OUTPUT PARAMETER  lIsObj      AS LOGICAL   NO-UNDO INITIAL FALSE.
     2650      DEFINE OUTPUT PARAMETER  o-Asmt-id   AS INTEGER   NO-UNDO INITIAL 0.
     2651      DEFINE OUTPUT PARAMETER  o-Db-Num    AS INTEGER   NO-UNDO INITIAL 0.
     2652      DEFINE OUTPUT PARAMETER  v-Type      AS CHARACTER NO-UNDO INITIAL "".
     2653      DEFINE OUTPUT PARAMETER  cError      AS CHARACTER NO-UNDO INITIAL "".
     2654      DEFINE VARIABLE v-value AS  CHARACTER NO-UNDO INITIAL "".
     2655      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2656      DEFINE BUFFER buf_AM-2 FOR ub.Assortment-Matrix.
     2657      ASSIGN
     2658         v-gl-lAM-Is-Obj = FALSE.
     2659      FIND FIRST buf_AM WHERE
     2660                 buf_AM.asmt-id = p-Asmt-id
     2661             AND buf_AM.db-num  = p-Db-num
     2662           NO-LOCK NO-ERROR.
     2663      IF NOT AVAILABLE buf_AM THEN DO:
     2664         cError = "Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2665         RETURN.
     2666      END.
     2667      IF buf_AM.asmt-type <> 'Объект':U THEN DO:
     2668         RETURN.
     2669      END. ELSE DO:
     2670         ASSIGN
     2671            lIsObj           = TRUE
     2672            v-gl-lAM-Is-Obj  = TRUE
     2673            .
     2674      END.
     2675      run assmatat-value (
     2676          input buf_AM.asmt-id
     2677         ,input buf_AM.db-num
     2678         ,input 'RootShablon':U
     2679         ,output v-value
     2680         ,output v-type
     2681         ) .
     2682      IF v-value = "" OR v-value = ? THEN DO:
     2683         RETURN.
     2684      END.
     2685      ASSIGN
     2686         o-Asmt-id = INTEGER(ENTRY(1, v-value, chr(4)))
     2687         o-Db-num  = INTEGER(ENTRY(2, v-value, chr(4)))
     2688         NO-ERROR.
     2689      IF ERROR-STATUS:ERROR THEN DO:
     2690         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1).
     2691         RETURN.
     2692      END.
     2693      FIND FIRST buf_AM-2 WHERE
     2694                 buf_AM-2.asmt-id = o-Asmt-id
     2695             AND buf_AM-2.db-num  = o-Db-num
     2696           NO-LOCK NO-ERROR.
     2697      IF NOT AVAILABLE buf_AM-2 THEN DO:
     2698         cError = "Не найден шаблон АМ id=" + STRING(o-Asmt-id) + " db-num=" + STRING(o-Db-num).
     2699         RETURN.
     2700      END.
     2701      RETURN.
     2702   END PROCEDURE.
     2703   PROCEDURE Get-Gl-Set-Proc-Otkl:
     2704      DEFINE INPUT PARAMETER  cObj-type AS CHARACTER NO-UNDO.
     2705      DEFINE INPUT PARAMETER  iObj-code AS INTEGER   NO-UNDO.
     2706      DEFINE VARIABLE v-Character   AS CHARACTER  NO-UNDO .
     2707      DEFINE VARIABLE v-Date        AS DATE       NO-UNDO .
     2708      DEFINE VARIABLE v-Decimal     AS DECIMAL    NO-UNDO .
     2709      DEFINE VARIABLE v-Integer     AS INTEGER    NO-UNDO .
     2710      DEFINE VARIABLE v-Logical     AS LOGICAL    NO-UNDO .
     2711      DEFINE VARIABLE v-Param-Type  AS CHARACTER  NO-UNDO .
     2712      ASSIGN
     2713         v-gl-iProc-Otkl = 0
     2714         .
     2715      EMPTY TEMP-TABLE thbjattr_thbj-attr .
     2716      RUN adm/shattri.p (
     2717              INPUT  "get":U,
     2718              INPUT  cObj-type,
     2719              INPUT  iObj-code,
     2720              INPUT  'Ass-obj':U,
     2721              INPUT  'ass-proc-matr-shabl':U ,
     2722              OUTPUT v-Character,
     2723              OUTPUT v-Date,
     2724              OUTPUT v-Decimal,
     2725              OUTPUT v-Integer,
     2726              OUTPUT v-Logical,
     2727              OUTPUT v-Param-Type,
     2728              INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2729          ) NO-ERROR.
     2730      IF ERROR-STATUS:ERROR THEN DO:
     2731         ASSIGN
     2732            v-Integer  = 0
     2733            v-Decimal  = 0.
     2734      END. ELSE DO:
     2735         ASSIGN
     2736            v-gl-iProc-Otkl = v-Integer
     2737            .
     2738      END.
     2739      RETURN.
     2740   END PROCEDURE.
     2741   PROCEDURE Calc-Proc-Otkl:
     2742      DEFINE INPUT PARAMETER iDeltaGds AS INTEGER NO-UNDO.
     2743      DEFINE VARIABLE iTmp AS INTEGER NO-UNDO INITIAL 0.
     2744      ASSIGN
     2745         v-gl-dAM-Proc-Otkl     = 0
     2746         v-gl-dAM-Proc-Otkl-Ras = 0
     2747         .
     2748      IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2749         RETURN.
     2750      END.
     2751      IF v-gl-iAM-Sbl-Gds-All = 0 THEN DO:
     2752         ASSIGN
     2753            v-gl-dAM-Proc-Otkl     = 999999
     2754            v-gl-dAM-Proc-Otkl-Ras = 999999
     2755            .
     2756         RETURN.
     2757      END.
     2758      ASSIGN
     2759         iTmp = (v-gl-iAM-Gds-All - v-gl-iAM-Sbl-Gds-All)
     2760         v-gl-dAM-Proc-Otkl     = ROUND(iTmp * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2761         v-gl-dAM-Proc-Otkl-Ras = ROUND((iTmp + iDeltaGds)  * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2762         .
     2763      RETURN.
     2764   END PROCEDURE.
     2765   FUNCTION indicator-life-gds-n RETURNS CHARACTER
     2766   ( input p-rec as recid ) :
     2767   define buffer buf_matrix-goods for ub.assortment-matrix-goods .
     2768   define variable v-gdop-min-stock              as decimal   no-undo .
     2769   define variable v-grop-max-stock              as decimal   no-undo .
     2770   define variable v-grop-level-always-presence  as decimal   no-undo .
     2771   define variable v-grop-min-order              as decimal   no-undo .
     2772   define variable v-assort-min                  as LOGICAL   NO-UNDO.
     2773   DEFINE variable v-indicator-life-gds          as CHARACTER NO-UNDO.
     2774   find first buf_matrix-goods no-lock where recid (buf_matrix-goods) = p-rec no-error .
     2775   if error-status :error then return '' .
     2776   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2777   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     2778     (input  buf_Matrix-goods.obj-type
     2779     ,input  buf_Matrix-goods.obj-code
     2780     ,input  ?
     2781     ,input  ?
     2782     ,input  ?
     2783     ,input  buf_Matrix-goods.gds-code
     2784     ,output v-assort-min
     2785     ,output v-indicator-life-gds
     2786     ,output v-gdop-min-stock
     2787     ,output v-grop-max-stock
     2788     ,output v-grop-level-always-presence
     2789     ,output v-grop-min-order
     2790     )  .
     2791     return v-indicator-life-gds.
     2792   end function.
