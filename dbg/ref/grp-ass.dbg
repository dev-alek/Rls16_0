     7693         ,output v-uf-print-graft
     7694         ,output v-uf-sort-gr
     7695         ,output v-uf-type-price
     7696         ,output v-uf-type-val
     7697     )  no-error .
     7698     if not error-status:error then
     7699     assign
     7700     gds-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
