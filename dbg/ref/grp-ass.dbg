     3523   ON CHOOSE OF b-verify IN FRAME Dlg-grp
     3524   DO:
     3525   message "Запутить утилиту проверки проставленных ограничений по всем уровням ? "
     3526    view-as alert-box question
     3527          BUTTONS yes-no
     3528         update v-ok as logical.
     3529     if not v-ok then return .
     3530   define variable v-str as character no-undo .
     3531   define variable v-i as integer   no-undo .
     3532   v-str = "" .
     3533   v-i   = 0  .
     3534   for each temp_grplib_grp :
     3535       find first temp_cons where temp_cons.node-code = temp_grplib_grp.node-code no-error .
     3536           if not available temp_cons then create temp_cons.
     3537           assign
     3538               temp_cons.full-name  = temp_grplib_grp.full-name
     3539               temp_cons.node-code  = temp_grplib_grp.node-code
     3540               temp_cons.upper-code = temp_grplib_grp.upper-code
     3541               temp_cons.min-marg   = temp_grplib_grp.min-marg
     3542               temp_cons.max-marg   = temp_grplib_grp.max-marg
     3543               temp_cons.cli-type   = temp_grplib_grp.cli-type
     3544           .
     3545   end.
     3546     for each temp_cons where
     3547             int(temp_cons.cli-type) < int(temp_cons.min-marg)
     3548         and int(temp_cons.cli-type) <> ?
     3549         and temp_cons.cli-type <> ""
     3550         and int(temp_cons.min-marg) <> ?
     3551         :
     3552           v-i = v-i + 1.
     3553           v-str = v-str + trim(temp_cons.full-name) + ": ограничение-" + temp_cons.cli-type + " должно быть >= " + temp_cons.min-marg + chr(10) .
     3554     end.
     3555   for each temp_cons where
     3556           int(temp_cons.cli-type) < int(temp_cons.max-marg)
     3557       and int(temp_cons.cli-type) <> ?
     3558       and temp_cons.cli-type <> ""
     3559       and int(temp_cons.max-marg) <> ?
     3560       :
     3561     v-i = v-i + 1.
     3562     v-str = v-str + trim(temp_cons.full-name) + ": ограничение-" + temp_cons.cli-type + ", а товара в группе - " + temp_cons.max-marg + "." + chr(10) .
     3563   end.
     3564      if v-i > 0 then
     3565      run gbl/notes.w ('ПРОСМОТР':U,input-output v-str) .
     3566      else message "Все ОК!" view-as alert-box information .
     3567   END.
