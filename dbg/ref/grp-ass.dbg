     3734             skip trim(error-status :get-message(1))
     3735                  trim(error-status :get-message(2))
     3736                  trim(error-status :get-message(3))
     3737                  trim(error-status :get-message(4))
     3738                  trim(error-status :get-message(5))
     3739           view-as alert-box error.
     3740           undo, return no-apply .
     3741       end.
     3742       reposition br-list to row v-row-amount.
     3743       OPEN QUERY BROWSE-am-goods FOR EACH buf_Matrix-goods       WHERE buf_Matrix-goods.asmt-id = p-id and             buf_Matrix-goods.db-num  = p-db-num and             (RS-sts = 'все':U or buf_matrix-goods.asmg-status = int(RS-sts))             NO-LOCK,              FIRST buf_goods OF buf_Matrix-goods       WHERE temp_grplib_grp.level = 0 OR        ( buf_goods.grp-name begins temp_grplib_grp.full-name ) NO-LOCK INDEXED-REPOSITION.
     3744   END.
