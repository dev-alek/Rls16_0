        1   DEFINE BUFFER X_clob-bind FOR ub.clob-bind.
        2   DEFINE BUFFER X_clob-data FOR ub.clob-data.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   DEFINE INPUT PARAMETER p-parent-handle AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter bttns as character no-undo .
        6   define input parameter p-list-mode as character no-undo.
        7   define input parameter p-mode as character no-undo.
        8   define input parameter p-resource-type as character no-undo.
        9   define input parameter p-uniq-key-rec as character no-undo.
       10   define input parameter p-db-num as integer no-undo.
       11   define input-output  parameter p-rid-list as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Список CLOB-DATA".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable v-waitfram-action01         as character   no-undo .
       74   define variable v-waitfram-action02         as character   no-undo .
       75   define variable v-waitfram-action03         as character   no-undo .
       76   define variable mWaitFramTextBeg            as character   no-undo.
       77   define variable mWaitFramTextEnd            as character   no-undo.
       78   define variable mWaitFramView               as logical     no-undo.
       79   define variable mWaitProcEvent              as logical     no-undo init yes.
       80   define variable mWaitFramInterval           as integer     no-undo init 1 .
       81   define variable mWaitFramStop               as logical     no-undo.
       82   define variable mWaitFramStopUser           as logical     no-undo.
       83   define variable mWaitFramStopTimeOut        as logical     no-undo.
       84   define variable mWaitFramStartProc          as datetime-tz no-undo.
       85   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       86   define button B-WaitFramStop auto-end-key
       87        label "Стоп"
       88        size 10 by 1 tooltip "Остоновить процесс".
       89   define button B-viewProcInfo
       90        label "Информация"
       91        size 15 by 1 tooltip "Информация о процесс".
       92   define frame waitfram
       93     v-waitfram-action01 format "x(72)" no-label skip
       94     v-waitfram-action02 format "x(72)" no-label skip
       95     v-waitfram-action03 format "x(72)" no-label skip
       96     B-viewProcInfo
       97     B-WaitFramStop at row 4 col 30
       98     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       99     .
      100   define new global shared variable mBatchMode as logical no-undo init ?.
      101   define variable mFramBachModHandle as handle no-undo.
      102   mFramBachModHandle = frame waitfram:handle.
      103   define variable mFameOldVis as logical no-undo.
      104   define variable mVisCUrentVin as logical no-undo.
      105   if session:batch-mode
      106   then
      107      mBatchMode = yes.
      108   if mBatchMode = ? then do:
      109     mVisCUrentVin = current-window:visible.
      110     mFameOldVis = mFramBachModHandle:visible.
      111     mFramBachModHandle:visible  = yes.
      112     mBatchMode = mFramBachModHandle:visible ne yes.
      113     mFramBachModHandle:visible = mFameOldVis.
      114     current-window:visible = mVisCUrentVin.
      115   end.
      116    if  log-manager:logfile-name ne ?
      117     then DO:
      118         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      119         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      120         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      121     end.
      122   on choose of B-WaitFramStop in frame waitfram
      123   do:
      124     mWaitFramStop = yes.
      125     mWaitFramStopUser = yes.
      126   end.
      127   function waitfram-check-timeout returns logical():
      128      define variable vtime as int64 no-undo.
      129      if mWaitFramStopTimeOut
      130      then
      131         return yes.
      132      vtime = ( now - mWaitFramStartProc ) / 1000 .
      133      if     mWaitFramTimeOut ne ?
      134         and mWaitFramTimeOut ne 0
      135         and mWaitFramTimeOut lt vtime
      136      then do:
      137         mWaitFramStopTimeOut = yes.
      138      end.
      139      return mWaitFramStopTimeOut.
      140   end.
      141   procedure waitfram-hide :
      142     if not session:batch-mode
      143     then do
      144     on error undo, return error return-value
      145     :
      146       pause 0 before-hide .
      147       if not mBatchMode then
      148         hide frame waitfram .
      149     if     not mWaitFramView
      150        and mWaitProcEvent
      151     then
      152       process events .
      153     end.
      154   end procedure.
      155   procedure waitfram-show :
      156     define input  parameter p-message as character no-undo .
      157     define variable v-left-margin as integer   no-undo .
      158     if not session:batch-mode
      159     then do
      160     on error undo, return error return-value
      161     :
      162       if length(p-message) <= 70 then do:
      163         assign
      164           v-left-margin = integer((70 - length(p-message)) / 2)
      165         .
      166         assign
      167           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      168         .
      169         assign
      170           v-waitfram-action01 = " "
      171           v-waitfram-action02 = " "
      172                                    + fill(" ", v-left-margin)
      173                                    + p-message
      174           v-waitfram-action03 = " "
      175         .
      176       end.
      177       else do:
      178         define variable vRindex1 as integer no-undo.
      179         define variable vRindex2 as integer no-undo.
      180         vRindex1 = r-index(p-message," ",70).
      181         if vRindex1 = 0
      182         then
      183            vRindex1 = 70.
      184         if length(p-message)  <= vRindex1 + 70 then do:
      185           assign
      186             v-waitfram-action01 = " "
      187             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      189           .
      190         end.
      191         else do:
      192           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      193           if vRindex2 <= vRindex1
      194           then
      195              vRindex2 = vRindex1 + 70.
      196           assign
      197             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      199             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      200           .
      201         end.
      202       end.
      203       B-viewProcInfo:visible   in frame waitfram = no.
      204       B-viewProcInfo:sensitive in frame waitfram = no.
      205       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       if  (   mWaitFramView
      208          or  mWaitProcEvent)
      209          and not mBatchMode
      210       then
      211          display
      212             v-waitfram-action01 skip
      213             v-waitfram-action02 skip
      214             v-waitfram-action03 skip
      215          with frame waitfram .
      216       if     mWaitFramView
      217          then do:
      218             if     mWaitFramInterval ne ?
      219                and not mBatchMode
      220             then
      221                wait-for go of frame waitfram pause mWaitFramInterval.
      222          end.
      223          else
      224             if     mWaitProcEvent
      225                and not mBatchMode
      226             then
      227                process events .
      228     end.
      229   end procedure.
      230      procedure waitfram-show-this:
      231         define input  parameter iInterval as int64 no-undo.
      232         define variable vtime as int64 no-undo.
      233         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      234         mWaitFramInterval = iInterval.
      235         run waitfram-show (substitute("&1&2 &3&4" ,
      236                                       mWaitFramTextBeg ,
      237                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      238                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      239                                       mWaitFramTextEnd
      240                                      )
      241                           ).
      242      end.
      243      procedure WaitFramRunPause:
      244         define input  parameter iInterval as dec no-undo.
      245         define variable vStart  as datetime-tz no-undo.
      246         define variable vend    as datetime-tz no-undo.
      247         define variable vint as int64 no-undo.
      248         define variable vOk as logical no-undo.
      249         vStart = now.
      250         vend   = vStart.
      251         publish "WaitFramPause" (iInterval,output vOk).
      252         vend   =  now.
      253         vint = vend - vStart.
      254         vint = iInterval - vint / 1000.
      255         if     not mWaitFramStop
      256            and (   vint > 0
      257                 or (    not vOk
      258                     and iInterval eq ?
      259                     )
      260                 )
      261         then
      262            run waitfram-show-this (iInterval).
      263         vend   =  now.
      264         vint = vend - vStart.
      265         vint = iInterval - vint / 1000.
      266         if     not mWaitFramStop
      267            and vint > 0
      268         then do:
      269            run gbl/pause.p (vint * 1000).
      270         end.
      271         if iInterval ne ?
      272         then
      273            publish "WaitFramStop".
      274         waitfram-check-timeout().
      275      end.
      276      procedure WaitFramWaitFor:
      277         define input  parameter iInterval as dec no-undo.
      278         assign
      279            mWaitFramStartProc   = now
      280            mWaitFramStopUser    = no
      281            mWaitFramStopTimeOut = no
      282         .
      283         block-wait:
      284         do while not mWaitFramStop:
      285            run WaitFramRunPause (iInterval).
      286            if  waitfram-check-timeout()
      287            then do:
      288               leave block-wait.
      289            end.
      290         end.
      291         run waitfram-hide.
      292      end.
      293   procedure waitfram-join :
      294     define input  parameter p-line-1  as character no-undo .
      295     define input  parameter p-line-2  as character no-undo .
      296     define input  parameter p-line-3  as character no-undo .
      297     define output parameter p-message as character no-undo .
      298     do
      299     on error undo, return error return-value
      300     :
      301       assign
      302         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      305       .
      306     end.
      307   end procedure.
      308   function waitfram-join-function returns character
      309     (input p-line-1 as character
      310     ,input p-line-2 as character
      311     ,input p-line-3 as character
      312     ).
      313     define variable v-message as character no-undo .
      314     run waitfram-join in this-procedure
      315       (input  p-line-1
      316       ,input  p-line-2
      317       ,input  p-line-3
      318       ,output v-message
      319       ) .
      320     return v-message .
      321   end function .
      322   define new global shared variable g#language as character no-undo .
      323   if g#language <> '' and g#language <> 'rus':U then do:
      324     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      325   end.
      326   define new global shared variable g#library  as handle no-undo .
      327   define new global shared variable g#library2 as handle no-undo .
      328   define   shared variable g#auto as logical no-undo.
      329   define   shared variable g#news as logical no-undo.
      330   define   shared variable g#oxml as logical no-undo.
      331   define   shared variable g#esys as logical no-undo.
      332   define   shared variable g#news-source-db as integer no-undo.
      333   define   shared variable g#esys-source-esys as integer no-undo.
      334   define   shared variable g#db-num as integer   no-undo .
      335   define   shared variable g#userid as character no-undo .
      336   define   shared variable g#passwd as character no-undo .
      337   procedure proc-alt-shift-f2:
      338     if not ibs.th.gbl.gbl-var:rcode
      339   then
      340     run gbl\inidebug.p .
      341   end.
      342   procedure proc-alt-shift-f3:
      343     run gbl/prvssinf.p
      344       ( input this-procedure
      345       ) .
      346   end.
      347   define variable v-inform-launched as logical no-undo initial false .
      348   procedure proc-alt-shift-f4:
      349     define variable v-action as character no-undo .
      350     if v-inform-launched = false then do:
      351       assign
      352         v-inform-launched = true
      353       .
      354       run gbl/d-inform.w
      355         (  input self
      356         ,  input this-procedure
      357         , output v-action
      358         ) no-error .
      359       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      360       assign
      361         v-inform-launched = false
      362       .
      363     end.
      364   end.
      365   procedure proc-alt-f1:
      366     run gbl/corrhelp.p
      367       (input this-procedure
      368       ) .
      369   end .
      370   on alt-shift-f2 anywhere do:
      371     run proc-alt-shift-f2.
      372   end.
      373   on alt-shift-f3 anywhere do:
      374     run proc-alt-shift-f3 in this-procedure .
      375   end.
      376   on alt-shift-f4 anywhere do:
      377     run proc-alt-shift-f4 in this-procedure.
      378   end.
      379   on alt-f1 anywhere do:
      380     run proc-alt-f1 in this-procedure .
      381   end.
      382   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383     define variable v-cntxt-db-num        as integer   no-undo .
      384     define variable v-cntxt-userid        as character no-undo .
      385     define variable v-cntxt-level         as character no-undo .
      386     define variable v-cntxt-host-code-obj as integer   no-undo .
      387     define variable v-cntxt-obj-type      as character no-undo .
      388     define variable v-cntxt-obj-code      as integer   no-undo .
      389     define variable v-cntxt-db-num-obj    as integer   no-undo .
      390     define variable v-cntxt-is-admin      as logical   no-undo .
      391   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   procedure cur-time :
      393      define output parameter p-today as date      no-undo .
      394      define output parameter p-time  as integer   no-undo .
      395     do
      396     on error undo, return error
      397     :
      398       define variable v-date1 as date      no-undo .
      399       define variable v-date2 as date      no-undo .
      400       define variable v-time  as integer   no-undo .
      401       assign
      402         v-date1 = today
      403         v-time  = time
      404         v-date2 = today
      405       .
      406       if v-date1 <> v-date2
      407       then do:
      408         assign
      409           v-date1 = today
      410           v-time  = v-time
      411         .
      412       end.
      413       assign
      414         p-today = v-date1
      415         p-time  = v-time
      416       .
      417     end.
      418   end.
      419   function cur-time-date returns character
      420   :
      421     return string(today, '99/99/9999':U) .
      422   end.
      423   function cur-time-mjd returns decimal
      424   :
      425     define variable v-date as date      no-undo .
      426     define variable v-time as integer   no-undo .
      427     run cur-time in this-procedure
      428       (output v-date
      429       ,output v-time
      430       ) .
      431     return integer(v-date) - 2400002 + (v-time / 86400) .
      432   end.
      433   function cur-time-get-ending-index returns integer
      434   (input p-number as integer
      435   )
      436   :
      437     if p-number < 0
      438     or p-number = ?
      439     then do:
      440       return 1 .
      441     end.
      442     define variable v-rest as integer   no-undo .
      443     assign
      444       p-number = p-number modulo 100
      445     .
      446     if p-number < 20
      447     then do:
      448       assign
      449         v-rest = p-number
      450       .
      451     end.
      452     else do:
      453       assign
      454         v-rest = p-number modulo 10
      455       .
      456     end.
      457     case v-rest :
      458       when 1
      459       then do:
      460         return 2 .
      461       end.
      462       when 2 or
      463       when 3 or
      464       when 4
      465       then do:
      466         return 3 .
      467       end.
      468       otherwise do:
      469         return 1 .
      470       end.
      471     end case .
      472   end.
      473   procedure cur-time-mjd-to-date :
      474      define input  parameter i-mjd-diff as decimal no-undo.
      475      define output parameter o-Date     as date    no-undo.
      476      define output parameter o-Time     as integer no-undo.
      477      define variable v-day-number as integer   no-undo .
      478      if    i-mjd-diff < 0
      479         or i-mjd-diff = ?
      480      then do:
      481         return "?" .
      482      end.
      483      assign
      484         v-day-number = truncate(i-mjd-diff,0).
      485         o-Date = date(v-day-number + 2400002).
      486         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      487     .
      488   end.
      489   function cur-time-mjd-to-string returns character
      490   (input p-mjd-diff as decimal
      491   )
      492   :
      493     define variable v-day-number as integer   no-undo .
      494     define variable v-seconds    as integer   no-undo .
      495     define variable v-hour       as integer   no-undo .
      496     define variable v-min        as integer   no-undo .
      497     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      498     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      499     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      500     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      501     if p-mjd-diff < 0
      502     or p-mjd-diff = ?
      503     then do:
      504       return "?" .
      505     end.
      506     assign
      507       v-day-number = integer(truncate(p-mjd-diff,0))
      508       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      509     .
      510     if v-seconds > 86400
      511     then do:
      512       assign
      513         v-seconds = 86400 - 1
      514       .
      515     end.
      516     if v-seconds < 0
      517     then do:
      518       assign
      519         v-seconds = 0
      520       .
      521     end.
      522     assign
      523       v-hour = truncate(v-seconds / 3600, 0)
      524     .
      525     assign
      526       v-seconds = v-seconds modulo 3600
      527     .
      528     assign
      529       v-min = truncate(v-seconds / 60, 0)
      530     .
      531     assign
      532       v-seconds = v-seconds modulo 60
      533     .
      534     return
      535         (if v-day-number <> 0
      536           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      537           else ""
      538         )
      539       + (if v-day-number <> 0 or v-hour <> 0
      540           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      541           else ""
      542         )
      543       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      544           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      545           else ""
      546         )
      547       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      548       .
      549   end.
      550   function cur-time-string returns character
      551   :
      552     define variable v-date as date      no-undo .
      553     define variable v-time as integer   no-undo .
      554     run cur-time in this-procedure
      555       (output v-date
      556       ,output v-time
      557       ) .
      558     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      559   end.
      560   function cur-time-string-sec returns character
      561   :
      562     define variable v-date as date      no-undo .
      563     define variable v-time as integer   no-undo .
      564     run cur-time in this-procedure
      565       (output v-date
      566       ,output v-time
      567       ) .
      568     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      569   end.
      570   function cur-time-custom  returns character
      571   (input p-prefix as character
      572   ,input p-date-format as character
      573   ,input p-delimiter as character
      574   ,input p-time-format as character
      575   ,input p-suffix as character
      576   )
      577   :
      578     define variable v-date as date      no-undo .
      579     define variable v-time as integer   no-undo .
      580     run cur-time in this-procedure
      581       (output v-date
      582       ,output v-time
      583       ) .
      584     return
      585       p-prefix
      586       + string(v-date, p-date-format)
      587       + p-delimiter
      588       + string(v-time, p-time-format)
      589       + p-suffix
      590       .
      591   end.
      592   function cur-time-print  returns character
      593   :
      594     define variable v-date as date      no-undo .
      595     define variable v-time as integer   no-undo .
      596     run cur-time in this-procedure
      597       (output v-date
      598       ,output v-time
      599       ) .
      600     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      601   end.
      602   function cur-time-datetime returns datetime
      603   :
      604     define variable v-char as character no-undo .
      605     define variable v-datetime as datetime no-undo .
      606     v-char = cur-time-string().
      607     v-datetime = datetime(v-char).
      608     return  v-datetime.
      609   end.
      610   function cur-time-string-msec returns character
      611   :
      612     define variable v-date as datetime  no-undo .
      613     v-date = now.
      614     return string(v-date) .
      615   end.
      616   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      617   procedure progs-name :
      618     define input  parameter p-action-code         as character no-undo .
      619     define output parameter p-main-prog-name      as character no-undo .
      620     define output parameter p-list-db-proc-name   as character no-undo .
      621     define output parameter p-commit-proc-name    as character no-undo .
      622     define output parameter p-execution-proc-name as character no-undo .
      623     define output parameter p-recover-proc-name   as character no-undo .
      624     define output parameter p-after-proc-name     as character no-undo .
      625     do
      626     on error undo, return error
      627     :
      628       case p-action-code :
      629               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
      630               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
      631               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
      632               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
      633               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
      634               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
      635               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      636               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      637               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      638               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      639               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      640               otherwise do:
      641           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info3, p-action-code ).
      642         end.
      643       end case.
      644     end.
      645     return.
      646   end procedure.
      647   procedure progs-title :
      648     define input  parameter p-action-code         as character no-undo .
      649     define output parameter p-action-title      as character no-undo .
      650     do
      651     on error undo, return error
      652     :
      653       case p-action-code :
      654               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      655               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      656               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      657               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      658               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      659               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      660               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      661               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      662               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      663               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      664               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      665               otherwise do:
      666           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info3, p-action-code ).
      667         end.
      668       end case.
      669     end.
      670     return.
      671   end procedure.
      672   FUNCTION progs-title-function returns character(
      673      input  p-action-code         as character):
      674   define variable p-action-title      as character no-undo .
      675     do
      676     on error undo, return error
      677     :
      678       case p-action-code :
      679               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      680               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      681               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      682               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      683               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      684               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      685               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      686               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      687               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      688               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      689               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      690               otherwise do:
      691           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info3, p-action-code ).
      692         end.
      693       end case.
      694     end.
      695     return p-action-title.
      696   end FUNCTION.
      697   procedure get-row-keyr-string :
      698    define input  parameter p-key-rec  as character no-undo.
      699    define output parameter p-tbl-title as character no-undo.
      700    define output parameter p-rec-string  as character no-undo.
      701     do
      702     on error undo, return error
      703     :
      704       define variable v-full-tbl-name as character no-undo .
      705       define variable bh_tbl-name     as handle    no-undo .
      706       define variable fh              as handle    no-undo .
      707       define variable v-ok            as logical   no-undo .
      708       define variable v-field-num     as integer   no-undo .
      709       define variable v-count-fld     as integer   no-undo .
      710       define variable v-tbl-name as character no-undo.
      711       if p-key-rec = ?
      712         or p-key-rec = "":U
      713       then do:
      714         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      715       end.
      716       assign
      717         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      718         v-full-tbl-name = "ub.":U + v-tbl-name
      719         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      720         p-rec-string         = "":U
      721         v-count-fld     = 0
      722       .
      723       find ub._file
      724         where ub._file._file-name = v-tbl-name
      725         no-error.
      726       if not available ub._file then do:
      727         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info3, v-tbl-name ).
      728       end.
      729       assign
      730       p-tbl-title = ub._file._file-label
      731       .
      732       find ub._index
      733         where recid( ub._index  ) = ub._file._prime-index
      734         no-error.
      735       if not available ub._index
      736         or LC( ub._index._index-name ) = "default":U
      737       then do:
      738         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      739       end.
      740       block_where :
      741       for each ub._index-field of ub._index  ,
      742           each ub._field of _index-field
      743           break by _index-seq
      744       on error undo, return error
      745       :
      746         assign
      747           v-count-fld = v-count-fld + 1
      748         .
      749         if v-count-fld > v-field-num then do:
      750           leave block_where.
      751         end.
      752         if p-rec-string = "":U then do:
      753           assign
      754             p-rec-string = "":U
      755           .
      756         end.
      757         else do:
      758           assign
      759             p-rec-string = p-rec-string + chr(32) + chr(44)
      760           .
      761         end.
      762         assign
      763           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      764         .
      765       end.
      766       if v-count-fld <> v-field-num then do:
      767         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      768       end.
      769     end.
      770     return.
      771   end procedure.
      772   FUNCTION uniq-key-rec-string-f returns character(
      773      input  p-uniq-key-rec         as character):
      774   define variable v-tbl-title as character no-undo .
      775   define variable v-rec-string as character no-undo .
      776     do
      777     on error undo, return error
      778     :
      779       run get-row-keyr-string in this-procedure (
      780                                                 input p-uniq-key-rec
      781                                                 ,output v-tbl-title
      782                                                 ,output v-rec-string).
      783       assign
      784       v-rec-string = (if v-tbl-title <> ? and
      785                       v-tbl-title <> "":U
      786                       then (v-tbl-title + ":")
      787                      else "":U) + chr(32) + v-rec-string
      788       .
      789     end.
      790     return v-rec-string.
      791   end FUNCTION.
      792   procedure create_db-rec_route :
      793     define input parameter p1-uniq-key-rec as character no-undo .
      794     define input parameter p1-action       as character no-undo .
      795     define input parameter p1-operation    as character no-undo .
      796     define input parameter p1-send-db-list as character no-undo .
      797     define input parameter p1-db-init      as integer   no-undo .
      798     define input parameter p1-parameters   as character no-undo .
      799     define input parameter p1-answer-code  as integer   no-undo .
      800     define input parameter p1-answer-msg   as character no-undo .
      801     do
      802     on error undo, return error
      803     :
      804       define variable v-command     as character no-undo .
      805       define variable v-ind         as integer   no-undo .
      806       define variable v-num-entries as integer   no-undo .
      807       define variable v-curr-db     as integer   no-undo .
      808       define variable v-db-for-send as character no-undo .
      809       define variable v-db-num      as integer   no-undo .
      810       define variable v-db-num-char as character no-undo .
      811       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      812       find first buf_sys-ctrl no-lock .
      813       assign
      814         v-curr-db     = buf_sys-ctrl.db-num
      815         v-db-for-send = "":U
      816       .
      817       if v-curr-db = 0 then do:
      818         if p1-answer-code >= 0 then do:
      819           if v-curr-db <> p1-db-init then do:
      820             assign
      821               v-db-for-send = string( p1-db-init )
      822             .
      823           end.
      824         end.
      825         else do:
      826           assign
      827             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      828           .
      829           do v-ind = 1 to v-num-entries:
      830             assign
      831               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      832               v-db-num      = integer( v-db-num-char )
      833             .
      834             if v-db-num <> v-curr-db
      835               and v-db-num <> p1-db-init
      836             then do:
      837               if v-db-for-send = "":U then do:
      838                 assign
      839                   v-db-for-send = v-db-num-char
      840                 .
      841               end.
      842               else do:
      843                 assign
      844                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      845                 .
      846               end.
      847             end.
      848           end.
      849         end.
      850       end.
      851       else do:
      852         assign
      853           v-db-for-send = "0":U
      854         .
      855       end.
      856       if v-db-for-send <> "":U then do:
      857         assign
      858           v-command = "command":U + chr(1)
      859                       + "two-commit":U + chr(1)
      860                       + p1-action + chr(1)
      861                       + p1-operation + chr(1)
      862                       + p1-uniq-key-rec + chr(1)
      863                       + string( p1-db-init ) + chr(1)
      864                       + p1-parameters + chr(1)
      865                       + string( p1-answer-code ) + chr(1)
      866                       + p1-answer-msg
      867         .
      868         run nws/cr-route.p ( input 'send-cmd':U
      869                       ,input v-command
      870                       ,input ?
      871                       ,input v-db-for-send
      872                       ) no-error .
      873         if error-status :error then do:
      874           return error return-value.
      875         end.
      876       end.
      877     end.
      878     return.
      879   end procedure.
      880   procedure create_msg_route :
      881     define input parameter p2-send-db-list as character no-undo .
      882     define input parameter p2-msg          as character no-undo .
      883     do
      884     on error undo, return error
      885     :
      886       define variable v-msg-command as character no-undo .
      887       define variable v-ind         as integer   no-undo .
      888       define variable v-num-entries as integer   no-undo .
      889       define variable v-curr-db     as integer   no-undo .
      890       define variable v-db-for-send as character no-undo .
      891       define variable v-db-num      as integer   no-undo .
      892       define variable v-db-num-char as character no-undo .
      893       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      894       find first buf_sys-ctrl no-lock .
      895       assign
      896         v-curr-db     = buf_sys-ctrl.db-num
      897         v-db-for-send = "":U
      898       .
      899       if v-curr-db = 0 then do:
      900         assign
      901           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      902         .
      903         do v-ind = 1 to v-num-entries:
      904           assign
      905             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      906             v-db-num      = integer( v-db-num-char )
      907           .
      908           if v-db-num <> v-curr-db then do:
      909             if v-db-for-send = "":U then do:
      910               assign
      911                 v-db-for-send = v-db-num-char
      912               .
      913             end.
      914             else do:
      915               assign
      916                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      917               .
      918             end.
      919           end.
      920         end.
      921       end.
      922       else do:
      923         assign
      924           v-db-for-send = "0":U
      925         .
      926       end.
      927       if v-db-for-send <> "":U then do:
      928         assign
      929           v-msg-command = "command":U + chr(1)
      930                           + "message-to-log":U + chr(1)
      931                           + p2-msg
      932         .
      933         run nws/cr-route.p ( input 'send-cmd':U
      934                       ,input v-msg-command
      935                       ,input ?
      936                       ,input v-db-for-send
      937                       ) no-error .
      938         if error-status :error then do:
      939           return error substitute( "&1&2&3"
      940                                     , return-value
      941                                     , chr(10)
      942                                     , error-status :get-message(1)
      943                                   ).
      944         end.
      945       end.
      946     end.
      947     return.
      948   end procedure.
      949   function get-send-db-list returns character
      950     ( input p-curr-db     as integer
      951      ,input p-all-db-list as character
      952     )
      953   :
      954     define variable v-send-db-list as character no-undo .
      955     if p-curr-db = 0 then do:
      956       assign
      957         v-send-db-list = p-all-db-list
      958       .
      959     end.
      960     else do:
      961       assign
      962         v-send-db-list = string(p-curr-db)
      963       .
      964     end.
      965     return v-send-db-list .
      966   end function .
      967   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      968   function usrfulnf returns character ( input p-user-id as character):
      969   define variable v-user-name as character no-undo .
      970   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      971   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      972     (input  p-user-id
      973     ,output v-user-name
      974     ) no-error .
      975   if error-status:error
      976   or v-user-name = ""
      977   then do:
      978     return p-user-id.
      979   end.
      980   else do:
      981     return v-user-name.
      982   end.
      983   end function.
      984   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      985   procedure clbdattd_two-commit-del :
      986   define parameter buffer buf_clob-data for ub.clob-data.
      987   define input parameter p-error-mode as integer no-undo .
      988   define variable v-key-rec as character no-undo .
      989   define variable v-param as character no-undo .
      990   define variable v-ext-prg-handle as handle no-undo .
      991   define variable v-rec as recid no-undo .
      992   define variable l-is-used as logical   no-undo init yes.
      993   define variable v-db-num as integer no-undo .
      994   define variable v-int64-id as int64 no-undo .
      995   define variable v-curr-db as integer   no-undo .
      996   define buffer buf2_clob-data for ub.clob-data.
      997   define buffer buf_sys-ctrl for ub.sys-ctrl .
      998   define buffer buf_db-rec-attr for ub.db-rec-attr .
      999   main-block:
     1000   do
     1001   on error undo, return error return-value
     1002   :
     1003     if can-find(first ub.db where ub.db.db-num > 0) then do:
     1004       run gen-key-rec( input 'clob-data':U
     1005                       ,input (buffer buf_clob-data:handle )
     1006                       ,output v-key-rec
     1007                     ) no-error.
     1008       if error-status :error then do:
     1009         undo main-block, return error substitute("&1 &2 &3&4Ошибка при генерации уникального ключа для clob-data4&5&6&5&7"
     1010                                                   ,vss-workfile
     1011                                                   ,vss-revision
     1012                                                   ,vss-description
     1013                                                   , buf_clob-data.file-name_
     1014                                                   ,chr(10)
     1015                                                   , error-status:get-message(1)
     1016                                                   , return-value ).
     1017       end.
     1018       assign
     1019       v-param = string(buf_clob-data.db-num) + chr(4) +
     1020                 string(buf_clob-data.int64-id) + chr(4) +
     1021                 buf_clob-data.crc-field
     1022       v-db-num = buf_clob-data.db-num
     1023       v-int64-id = buf_clob-data.int64-id
     1024       .
     1025       run nws/db-rec.p (
     1026                           input 'delete_nu-clob-data':U
     1027                           ,input v-key-rec
     1028                           ,input v-param
     1029                         ) no-error .
     1030       if error-status:error then do:
     1031         if p-error-mode = 0 then do:
     1032           find first buf_sys-ctrl no-lock .
     1033           assign
     1034             v-curr-db  = buf_sys-ctrl.db-num.
     1035           find first buf_db-rec-attr exclusive-lock
     1036             where buf_db-rec-attr.db-num       = v-curr-db
     1037               and buf_db-rec-attr.uniq-key-rec = v-key-rec
     1038               and buf_db-rec-attr.attr-code    = 'delete_nu-clob-data':U
     1039             no-wait no-error.
     1040           if available buf_db-rec-attr
     1041             or ( not available buf_db-rec-attr
     1042                 and locked buf_db-rec-attr
     1043               )
     1044           then do:
     1045             return.
     1046           end.
     1047         end.
     1048         else do:
     1049         undo, return error substitute("&1&2&3"
     1050                                        ,error-status:get-message(1)
     1051                                        ,chr(10)
     1052                                        , return-value ).
     1053       end.
     1054       end.
     1055       find first buf2_clob-data no-lock where
     1056                 buf2_clob-data.db-num = buf_clob-data.db-num
     1057             and buf2_clob-data.int64-id = buf_clob-data.int64-id no-error.
     1058       if available buf2_clob-data
     1059       and buf2_clob-data.crc-field > '':U
     1060       and p-error-mode = 1
     1061       then do:
     1062         message return-value
     1063         view-as alert-box .
     1064       end.
     1065     end.
     1066     else do:
     1067       run trg/clobdatt.p persistent set v-ext-prg-handle .
     1068       find current buf_clob-data  exclusive-lock.
     1069       assign
     1070       v-rec = recid(buf_clob-data)
     1071       buf_clob-data.crc-field = '':U
     1072       .
     1073       release buf_clob-data.
     1074       find first buf_clob-data where
     1075               recid(buf_clob-data) = v-rec.
     1076       run value( "proc-is-used-clob-data" ) in v-ext-prg-handle (
     1077                                                                   buffer buf_clob-data
     1078                                                                 , input g#db-num
     1079                                                                 , output l-is-used) no-error .
     1080       if not error-status:error
     1081       and not l-is-used then do:
     1082         delete buf_clob-data no-error .
     1083       end.
     1084       if valid-handle(v-ext-prg-handle) then do:
     1085         delete procedure v-ext-prg-handle  .
     1086       end.
     1087       find first buf2_clob-data no-lock where
     1088                 buf2_clob-data.db-num = buf_clob-data.db-num
     1089             and buf2_clob-data.int64-id = buf_clob-data.int64-id no-error.
     1090       if available buf2_clob-data
     1091       and buf2_clob-data.crc-field > '':U
     1092       and p-error-mode = 1
     1093       then do:
     1094         message return-value
     1095         view-as alert-box .
     1096       end.
     1097       else do:
     1098         error-status:error = no.
     1099       end.
     1100     end.
     1101     if error-status :error then do:
     1102       undo, return error substitute("Ошибка при запуске удаления clob-data &1&2&3&4&3&5"
     1103                                     ,v-db-num
     1104                                     ,v-int64-id
     1105                                     ,chr(10)
     1106                                     , error-status:get-message(1)
     1107                                     , return-value ).
     1108     end.
     1109   end.
     1110   end procedure.
     1111   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1112   procedure gen-key-rec :
     1113     define input  parameter p-tbl-name    as character no-undo.
     1114     define input  parameter p-bh_tbl-name as handle    no-undo.
     1115     define output parameter p-key-rec     as character no-undo.
     1116     do
     1117     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1118     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1119     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1120     :
     1121       define variable fh               as handle    no-undo .
     1122       define variable v-ok             as logical   no-undo .
     1123       define variable v-inform         as character no-undo .
     1124       define variable v-ind            as integer   no-undo .
     1125       define variable v-idx-field-qnty as integer   no-undo .
     1126       if p-tbl-name = ?
     1127         or p-tbl-name = "":U
     1128       then do:
     1129         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
     1130       end.
     1131       if not p-bh_tbl-name:available then do:
     1132         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
     1133       end.
     1134       assign
     1135         p-key-rec = p-tbl-name
     1136         v-inform  = p-bh_tbl-name:index-information(1)
     1137         v-ind     = 2
     1138       .
     1139       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1140       on error undo, return error
     1141       :
     1142         assign
     1143           v-inform = p-bh_tbl-name:index-information( v-ind )
     1144           v-ind    = v-ind + 1
     1145         .
     1146       end.
     1147       if v-inform = ?
     1148         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1149         or entry( 3, v-inform, ",":U ) <> "1":U
     1150       then do:
     1151         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
     1152       end.
     1153       else do:
     1154         assign
     1155           v-idx-field-qnty = num-entries( v-inform ) - 4
     1156         .
     1157         if v-idx-field-qnty < 2 then do:
     1158           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
     1159         end.
     1160         do v-ind = 1 to v-idx-field-qnty by 2
     1161         on error undo, return error
     1162         :
     1163           assign
     1164             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1165             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1166           .
     1167         end.
     1168       end.
     1169       if p-key-rec = ? then do:
     1170         assign
     1171           p-key-rec = "":U
     1172         .
     1173         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
     1174       end.
     1175     end.
     1176     return.
     1177   end procedure.
     1178   procedure gen-where-keyr-tab :
     1179     define input  parameter i-tableSerach as character no-undo.
     1180     define input  parameter i-tablekey   as character  no-undo.
     1181     define input  parameter p-key-rec    as character  no-undo.
     1182     define input  parameter p-key-handle as handle     no-undo .
     1183     define input  parameter p-db-name    as character  no-undo .
     1184     define input  parameter p-tt-handle  as handle     no-undo .
     1185     define output parameter o-Where      as character  no-undo.
     1186     do
     1187     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1188     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1189     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1190     :
     1191       define variable v-full-tbl-name  as character no-undo .
     1192       define variable bh_tbl-name      as handle    no-undo .
     1193       define variable fh_key           as handle    no-undo .
     1194       define variable fh_search        as handle    no-undo .
     1195       define variable v-field-num      as integer   no-undo .
     1196       define variable v-count-fld      as integer   no-undo .
     1197       define variable v-inform         as character no-undo .
     1198       define variable v-ind            as integer   no-undo .
     1199       define variable v-idx-field-qnty as integer   no-undo .
     1200       define variable v-field-name     as character no-undo .
     1201       define variable v-field-val      as character no-undo .
     1202       define variable v-word-link      as character no-undo .
     1203       define variable vTable           as character no-undo.
     1204       define variable bh_tbl-key       as handle    no-undo .
     1205       assign
     1206         p-key-rec = trim( p-key-rec )
     1207       .
     1208       if p-key-handle <> ? then do:
     1209         if not valid-handle(p-key-handle)
     1210            or p-key-handle:type <> "buffer"
     1211         then do:
     1212           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
     1213         end.
     1214         if num-entries( p-key-rec, chr(3) ) > 1
     1215           or p-key-rec = ?
     1216           or p-key-rec = "":U
     1217         then do:
     1218           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
     1219         end.
     1220       end.
     1221       else do:
     1222         if p-key-rec = ?
     1223           or p-key-rec = "":U
     1224         then do:
     1225           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1226         end.
     1227       end.
     1228       assign
     1229         vTable = entry( 1 , p-key-rec, chr(3) )
     1230       .
     1231       if p-tt-handle <> ?
     1232         and ( not valid-handle(p-tt-handle)
     1233               or p-tt-handle:type <> "buffer"
     1234             )
     1235       then do:
     1236         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
     1237       end.
     1238       if p-tt-handle = ? then do:
     1239         assign
     1240           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1241         .
     1242         create buffer bh_tbl-name for table v-full-tbl-name .
     1243       end.
     1244       else do:
     1245         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1246       end.
     1247       assign
     1248         v-inform = bh_tbl-name:index-information(1)
     1249         v-ind    = 2
     1250       .
     1251       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1252       on error undo, return error
     1253       :
     1254         assign
     1255           v-inform = bh_tbl-name:index-information( v-ind )
     1256           v-ind    = v-ind + 1
     1257         .
     1258       end.
     1259       if v-inform = ?
     1260         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1261         or entry( 3, v-inform, ",":U ) <> "1":U
     1262       then do:
     1263         delete object bh_tbl-name no-error.
     1264         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
     1265       end.
     1266       assign
     1267         v-idx-field-qnty = num-entries( v-inform ) - 4
     1268       .
     1269       if v-idx-field-qnty < 2 then do:
     1270         delete object bh_tbl-name no-error.
     1271         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
     1272       end.
     1273       assign
     1274         o-where     = "where":U
     1275         v-word-link = "":U
     1276         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1277         v-count-fld = 0
     1278       .
     1279       if i-tablekey ne "" and i-tablekey ne ?
     1280       then do:
     1281         assign
     1282           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1283         .
     1284         create buffer bh_tbl-key for table v-full-tbl-name .
     1285       end.
     1286       if i-tableSerach ne "" and i-tableSerach ne ?
     1287       then do:
     1288         delete object bh_tbl-name no-error.
     1289         assign
     1290           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1291         .
     1292         create buffer bh_tbl-name for table v-full-tbl-name .
     1293       end.
     1294       block_where:
     1295       do v-ind = 1 to v-idx-field-qnty by 2
     1296       on error undo, return error
     1297       :
     1298         assign
     1299           v-count-fld = v-count-fld + 1
     1300         .
     1301         if p-key-handle = ?
     1302           and v-count-fld > v-field-num
     1303         then do:
     1304           leave block_where.
     1305         end.
     1306         define variable VfieldKeyTable as handle no-undo.
     1307         assign
     1308           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1309           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1310         .
     1311         if     bh_tbl-key ne ?
     1312         then do:
     1313            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1314            if VfieldKeyTable eq ?
     1315            then next block_where.
     1316         end.
     1317         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1318         then
     1319            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1320         else
     1321            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1322         if p-key-handle = ? then do:
     1323           assign
     1324             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1325           .
     1326         end.
     1327         else do:
     1328           assign
     1329             fh_key = p-key-handle:buffer-field( v-field-name )
     1330           .
     1331           if fh_key = ?
     1332             or not valid-handle( fh_key )
     1333           then do:
     1334             delete object bh_tbl-name.
     1335             if     bh_tbl-key ne ?
     1336             then
     1337                delete object bh_tbl-key.
     1338             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
     1339           end.
     1340           assign
     1341             v-field-val = fh_key:buffer-value
     1342           .
     1343         end.
     1344         if fh_search:data-type ="character":U then do:
     1345           assign
     1346             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1347             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1348             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1349             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1350             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1351             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1352             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1353             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1354             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1355             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1356             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1357             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1358             v-field-val = substitute( '"&1"', v-field-val )
     1359           .
     1360         end.
     1361         assign
     1362           o-where = substitute( "&1 &2", o-where, v-field-val )
     1363         .
     1364         if v-word-link = "":U then do:
     1365           assign
     1366             v-word-link = "and":U
     1367           .
     1368         end.
     1369       end.
     1370       delete object bh_tbl-name.
     1371       if     bh_tbl-key ne ?
     1372       then
     1373          delete object bh_tbl-key.
     1374       if p-key-handle = ?
     1375         and v-count-fld <> v-field-num
     1376       then do:
     1377         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
     1378       end.
     1379     end.
     1380   end procedure.
     1381   procedure gen-hn-keyr-tab :
     1382     define input  parameter i-tableSerach as character no-undo.
     1383     define input  parameter i-tablekey   as character no-undo.
     1384     define input  parameter p-key-rec    as character no-undo.
     1385     define input  parameter p-key-handle as handle    no-undo .
     1386     define input  parameter p-db-name    as character no-undo .
     1387     define input  parameter p-tt-handle  as handle    no-undo .
     1388     define input  parameter p-stts-lock  as integer   no-undo .
     1389     define output parameter o-hn         as handle    no-undo.
     1390     define variable v-full-tbl-name as character no-undo.
     1391     define variable v-where         as character no-undo.
     1392     define variable bh_tbl-name     as handle    no-undo.
     1393     define variable vTable          as character no-undo.
     1394     do
     1395     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1396     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1397     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1398         run gen-where-keyr-tab(i-tableSerach,
     1399                                i-tablekey,
     1400                                p-key-rec,
     1401                                p-key-handle,
     1402                                p-db-name,
     1403                                p-tt-handle,
     1404                                output v-where).
     1405         if i-tableSerach ne "" and i-tableSerach ne ?
     1406         then do:
     1407            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1408            create buffer bh_tbl-name for table v-full-tbl-name .
     1409         end.
     1410         else do:
     1411            if p-tt-handle = ? then do:
     1412               assign
     1413                  vTable = entry( 1 , p-key-rec, chr(3) )
     1414               .
     1415               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1416               create buffer bh_tbl-name for table v-full-tbl-name .
     1417            end.
     1418            else do:
     1419               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1420            end.
     1421         end.
     1422         if p-tt-handle = ? then do:
     1423            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1424         end.
     1425         else do:
     1426            bh_tbl-name:find-first( v-where ) no-error .
     1427         end.
     1428         o-hn = bh_tbl-name.
     1429      end.
     1430   end procedure.
     1431   procedure gen-hn-keyr :
     1432     define input  parameter p-key-rec    as character no-undo.
     1433     define input  parameter p-key-handle as handle    no-undo .
     1434     define input  parameter p-db-name    as character no-undo .
     1435     define input  parameter p-tt-handle  as handle    no-undo .
     1436     define input  parameter p-stts-lock  as integer   no-undo .
     1437     define output parameter o-hn         as handle    no-undo.
     1438     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1439   end.
     1440   procedure gen-row-keyr :
     1441     define input  parameter p-key-rec    as character no-undo.
     1442     define input  parameter p-key-handle as handle    no-undo .
     1443     define input  parameter p-db-name    as character no-undo .
     1444     define input  parameter p-tt-handle  as handle    no-undo .
     1445     define input  parameter p-stts-lock  as integer   no-undo .
     1446     define output parameter p-tbl-row    as rowid     no-undo.
     1447     define output parameter p-tbl-name   as character no-undo.
     1448     define variable vHn as handle no-undo.
     1449       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1450       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1451       p-tbl-name =  vHn:table.
     1452       delete object vHn no-error.
     1453     if p-tbl-row = ? then do:
     1454       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1455     end.
     1456     else do:
     1457       return.
     1458     end.
     1459   end procedure.
     1460   procedure gen-key-fv :
     1461     define input  parameter p-key-rec    as character no-undo .
     1462     define output parameter p-field-list as character no-undo .
     1463     define output parameter p-value-list as character no-undo.
     1464     do
     1465     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1466     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1467     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1468     :
     1469       define variable v-full-tbl-name  as character no-undo .
     1470       define variable bh_tbl-name      as handle    no-undo .
     1471       define variable v-tbl-name       as character no-undo .
     1472       define variable v-field-num      as integer   no-undo .
     1473       define variable v-count-fld      as integer   no-undo .
     1474       define variable v-inform         as character no-undo .
     1475       define variable v-ind            as integer   no-undo .
     1476       define variable v-idx-field-qnty as integer   no-undo .
     1477       define variable v-delim-key      as character no-undo .
     1478       if p-key-rec = ?
     1479         or p-key-rec = "":U
     1480       then do:
     1481         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1482       end.
     1483       assign
     1484         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1485         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1486       .
     1487       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1488       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1489       assign
     1490         v-inform = bh_tbl-name:index-information(1)
     1491         v-ind    = 2
     1492       .
     1493       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1494       on error undo, return error
     1495       :
     1496         assign
     1497           v-inform = bh_tbl-name:index-information( v-ind )
     1498           v-ind    = v-ind + 1
     1499         .
     1500       end.
     1501       if v-inform = ?
     1502         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1503         or entry( 3, v-inform, ",":U ) <> "1":U
     1504       then do:
     1505         delete object bh_tbl-name no-error.
     1506         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1507       end.
     1508       assign
     1509         v-idx-field-qnty = num-entries( v-inform ) - 4
     1510       .
     1511       if v-idx-field-qnty < 2 then do:
     1512         delete object bh_tbl-name no-error.
     1513         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1514       end.
     1515       assign
     1516         p-field-list = "":U
     1517         p-value-list = "":U
     1518         v-delim-key  = "":U
     1519         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1520         v-count-fld  = 0
     1521       .
     1522       block_where:
     1523       do v-ind = 1 to v-idx-field-qnty by 2
     1524       on error undo, return error
     1525       :
     1526         assign
     1527           v-count-fld = v-count-fld + 1
     1528         .
     1529         if v-count-fld > v-field-num then do:
     1530           leave block_where.
     1531         end.
     1532         assign
     1533           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1534           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1535         .
     1536         if v-ind = 1 then do:
     1537           assign
     1538             v-delim-key = chr(3)
     1539           .
     1540         end.
     1541       end.
     1542       delete object bh_tbl-name.
     1543       if v-count-fld <> v-field-num then do:
     1544         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1545       end.
     1546     end.
     1547   end procedure.
     1548   procedure gen-key-field :
     1549     define input  parameter p-table      as character no-undo .
     1550     define output parameter p-field-list as character no-undo .
     1551     do
     1552     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1553     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1554     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1555     :
     1556       define variable v-full-tbl-name  as character no-undo .
     1557       define variable bh_tbl-name      as handle    no-undo .
     1558       define variable v-tbl-name       as character no-undo .
     1559       define variable v-field-num      as integer   no-undo .
     1560       define variable v-count-fld      as integer   no-undo .
     1561       define variable v-inform         as character no-undo .
     1562       define variable v-ind            as integer   no-undo .
     1563       define variable v-idx-field-qnty as integer   no-undo .
     1564       define variable v-delim-key      as character no-undo .
     1565       if p-table = ?
     1566         or p-table = "":U
     1567       then do:
     1568         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1569       end.
     1570       assign
     1571         v-tbl-name      = p-table
     1572         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1573       .
     1574       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1575       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1576       assign
     1577         v-inform = bh_tbl-name:index-information(1)
     1578         v-ind    = 2
     1579       .
     1580       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1581       on error undo, return error
     1582       :
     1583         assign
     1584           v-inform = bh_tbl-name:index-information( v-ind )
     1585           v-ind    = v-ind + 1
     1586         .
     1587       end.
     1588       if v-inform = ?
     1589         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1590         or entry( 3, v-inform, ",":U ) <> "1":U
     1591       then do:
     1592         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1593       end.
     1594       assign
     1595         v-idx-field-qnty = num-entries( v-inform ) - 4
     1596       .
     1597       if v-idx-field-qnty < 2 then do:
     1598         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1599       end.
     1600       assign
     1601         p-field-list = "":U
     1602         v-delim-key  = "":U
     1603         v-count-fld  = 0
     1604       .
     1605       block_where:
     1606       do v-ind = 1 to v-idx-field-qnty by 2
     1607       on error undo, return error
     1608       :
     1609         assign
     1610           v-count-fld = v-count-fld + 1
     1611         .
     1612         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1613         if v-ind = 1 then do:
     1614           assign
     1615             v-delim-key = chr(3)
     1616           .
     1617         end.
     1618       end.
     1619       delete object bh_tbl-name.
     1620     end.
     1621   end procedure.
     1622   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1623   FUNCTION mark-string RETURNS CHARACTER
     1624     ( input p-recid as recid, input mark-list as character  ) :
     1625     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1626   END FUNCTION.
     1627   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1628   define variable c-point  as character no-undo .
     1629   define variable tbl      as character no-undo .
     1630   define variable join-tbl as character no-undo .
     1631   define variable fld      as character no-undo .
     1632   define variable lab      as character no-undo .
     1633   define variable spr      as character no-undo .
     1634   define variable dim      as character no-undo .
     1635   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1636   procedure fltfield-clear :
     1637     define output parameter loc-fld as character no-undo.
     1638     define output parameter loc-lab as character no-undo .
     1639     define output parameter loc-spr as character no-undo .
     1640     define output parameter loc-dim as character no-undo .
     1641     assign
     1642       loc-fld = ""
     1643       loc-lab = ""
     1644       loc-spr = ""
     1645       loc-dim = "0"
     1646     .
     1647   end procedure .
     1648   procedure fltfield-add :
     1649     define input        parameter par-fld as character no-undo.
     1650     define input        parameter par-lab as character no-undo .
     1651     define input        parameter par-spr as character no-undo .
     1652     define input-output parameter loc-fld as character no-undo.
     1653     define input-output parameter loc-lab as character no-undo .
     1654     define input-output parameter loc-spr as character no-undo .
     1655     define input-output parameter loc-dim as character no-undo .
     1656     do
     1657     on error undo, return error
     1658     :
     1659       assign
     1660       loc-fld = if loc-dim = '0'
     1661                 then par-fld
     1662                 else (loc-fld + chr(44) + par-fld)
     1663       loc-lab = if loc-dim = '0'
     1664                 then par-lab
     1665                 else (loc-lab + chr(44) + par-lab)
     1666       loc-spr = if loc-dim = '0'
     1667                 then par-spr
     1668                 else (loc-spr + chr(44) + par-spr)
     1669       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1670                 string(integer(if num-entries(loc-dim) > 1
     1671                               then entry(2, loc-dim)
     1672                               else entry(1, loc-dim)
     1673                               ) + 1)
     1674       no-error
     1675       .
     1676     end.
     1677   end procedure.
     1678   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1679   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1680   procedure fltopend_fltopend :
     1681   define input parameter p-parent-handle as handle no-undo .
     1682   define input parameter p-qh as handle no-undo .
     1683   define input parameter p-flt-open-open-query  as character no-undo .
     1684   define input parameter p-where-cond as character no-undo .
     1685   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1686   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1687   define input parameter p-indexed-reposition as character no-undo .
     1688     do
     1689     on error undo, return error
     1690     :
     1691   define variable v-prepare-string as character no-undo .
     1692   define variable glog as logical no-undo .
     1693   assign
     1694   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1695                      p-where-cond + chr(32)  +
     1696                      p-use-indFIRST-query-tail + chr(32) +
     1697                      p-use-ind-sort-clmn-by + chr(32) +
     1698                      p-indexed-reposition
     1699   .
     1700   assign
     1701   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1702   if not glog
     1703   or error-status:error then do:
     1704     message error-status:get-message(1) view-as alert-box .
     1705     undo, return error .
     1706   end.
     1707   assign
     1708   glog = p-qh:query-open no-error .
     1709   if not glog
     1710   or error-status:error then do:
     1711     message error-status:get-message(1) view-as alert-box .
     1712     undo, return error .
     1713   end.
     1714     end.
     1715   end procedure.
     1716   procedure fltopend_fltfindd :
     1717   define input parameter p-parent-handle as handle no-undo .
     1718   define input parameter p-qh as handle no-undo .
     1719   define input parameter p-rowid as rowid no-undo .
     1720   define input parameter p-next as logical no-undo .
     1721   define input parameter p-lock as integer no-undo .
     1722   define input parameter p-bh as handle no-undo .
     1723   define input parameter p-where-cond as character no-undo .
     1724   define input parameter p-use-index-phrase as character no-undo .
     1725   define variable glog as logical no-undo .
     1726   define variable v-qh as handle no-undo .
     1727   define variable v-bh as handle no-undo .
     1728   define variable v-recid as recid no-undo .
     1729   define variable v-prepare-string as character no-undo .
     1730   do
     1731   on error undo, return error
     1732   on stop undo, return error
     1733   :
     1734     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1735     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1736     create query v-qh.
     1737     v-qh:set-buffers(v-bh).
     1738     v-prepare-string = substitute("for each &1 &2 &3"
     1739                                     ,v-bh:name
     1740                                     ,p-where-cond
     1741                                     ,p-use-index-phrase).
     1742     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1743     if not glog then do:
     1744       delete object v-qh.
     1745       delete object v-bh.
     1746       undo, return error .
     1747     end.
     1748     glog = v-qh:query-open no-error .
     1749     if not glog then do:
     1750       delete object v-qh.
     1751       delete object v-bh.
     1752       undo, return error .
     1753     end.
     1754     if p-next then do:
     1755       v-qh:reposition-to-rowid(p-rowid) no-error .
     1756       glog = v-qh:get-next( p-lock) no-error .
     1757       glog = v-qh:get-next( p-lock) no-error .
     1758       if not glog or v-qh:query-off-end = yes then do:
     1759         glog = v-qh:get-first( p-lock) no-error .
     1760       end.
     1761     end.
     1762     else do:
     1763       glog = v-qh:get-first( p-lock) no-error .
     1764     end.
     1765     v-recid = v-bh:recid no-error .
     1766     delete object v-qh.
     1767     delete object v-bh.
     1768     return string(v-recid) .
     1769   end.
     1770   end procedure.
     1771   procedure fltopend_fltfindq :
     1772   define input parameter p-parent-handle as handle no-undo .
     1773   define input parameter p-qh as handle no-undo .
     1774   define input parameter p-next as logical no-undo .
     1775   define input parameter p-lock as integer no-undo .
     1776   define input parameter p-flt-open-open-query  as character no-undo .
     1777   define input parameter p-where-cond as character no-undo .
     1778   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1779   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1780   define input parameter p-indexed-reposition as character no-undo .
     1781   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1782   define variable glog as logical no-undo .
     1783   define variable v-qh as handle no-undo .
     1784   define variable v-bh as handle no-undo extent 18.
     1785   define variable v-rowid as rowid no-undo extent 18.
     1786   define variable v-ii as integer no-undo .
     1787   define variable v-prepare-string as character no-undo .
     1788   do
     1789   on error undo, return error
     1790   on stop undo, return error
     1791   :
     1792     create query v-qh.
     1793     do v-ii = 1 to p-qh:num-buffers:
     1794       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1795       assign
     1796       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1797       no-error.
     1798       v-qh:add-buffer(v-bh[v-ii]).
     1799     end.
     1800     assign
     1801     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1802                       p-where-cond + chr(32)  +
     1803                       p-use-indFIRST-query-tail + chr(32) +
     1804                       p-use-ind-sort-clmn-by + chr(32) +
     1805                       p-indexed-reposition
     1806     .
     1807     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1808     if not glog then do:
     1809       delete object v-qh.
     1810       do v-ii = 1 to p-qh:num-buffers:
     1811         delete object v-bh[v-ii].
     1812       end.
     1813       undo, return error .
     1814     end.
     1815     glog = v-qh:query-open no-error .
     1816     if not glog then do:
     1817       delete object v-qh.
     1818       do v-ii = 1 to p-qh:num-buffers:
     1819         delete object v-bh[v-ii].
     1820       end.
     1821       undo, return error .
     1822     end.
     1823     if p-next then do:
     1824       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1825       glog = v-qh:get-next( p-lock) no-error .
     1826       glog = v-qh:get-next( p-lock) no-error .
     1827       if not glog or v-qh:query-off-end = yes then do:
     1828         glog = v-qh:get-first( p-lock) no-error .
     1829       end.
     1830     end.
     1831     else do:
     1832       glog = v-qh:get-first( p-lock) no-error .
     1833     end.
     1834     do v-ii = 1 to p-qh:num-buffers:
     1835       assign
     1836       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1837       no-error.
     1838     end.
     1839     delete object v-qh.
     1840     do v-ii = 1 to p-qh:num-buffers:
     1841       delete object v-bh[v-ii].
     1842     end.
     1843   end.
     1844   end procedure.
