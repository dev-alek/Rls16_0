     2053   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     2054   DO:
     2055   define variable glog as logical   no-undo .
     2056   define variable v-list-type as character no-undo .
     2057   define variable v-list-types as character no-undo .
     2058   define variable v-list-labels as character no-undo .
     2059   define variable v-title as character no-undo .
     2060    if not (p-resource-type = 'list':U
     2061    or p-resource-type = 'list-macro':U)
     2062    then do:
     2063      message
     2064      "Нельзя добавлять ресурсы типа" p-resource-type
     2065      view-as alert-box error .
     2066      undo, return no-apply.
     2067    end.
     2068   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2069   do:
     2070     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2071       (input  v-cntxt-db-num
     2072       ,input  v-cntxt-userid
     2073       ,input  0
     2074       ,input  'actn_clob-list_work':U
     2075       ,input  'object':U
     2076       ,input  0
     2077       ,input  '':U
     2078       ,input  0
     2079       ,input  0
     2080       ,input  0
     2081       ,input  0
     2082       ,input  true
     2083       ,output glog
     2084       )  .
     2085   end.
     2086     if not glog then undo, return no-apply.
     2087     if p-uniq-key-rec = ''
     2088     and lookup("managed", bttns) > 0 then do:
     2089       assign
     2090       v-list-types = "gds-list" + chr(44) +
     2091                     "cli-list" + chr(44) +
     2092                     "dc-list"
     2093       .
     2094       if p-resource-type = 'list':U then do:
     2095         assign
     2096         v-title = "Выберите тип хранимого списка"
     2097         v-list-labels  = "Хранимый список товаров" + chr(44) +
     2098                         "Хранимый список клиентов" + chr(44) +
     2099                         "Хранимый список ДК"
     2100                         .
     2101       end.
     2102       else do:
     2103         assign
     2104         v-title = "Выберите тип хранимого макроса формирования списка"
     2105         v-list-labels  = "Хранимый макрос формирования списка товаров" + chr(44) +
     2106                         "Хранимый макрос формирования списка клиентов" + chr(44) +
     2107                         "Хранимый макрос формирования списка ДК"
     2108                         .
     2109       end.
     2110       run gbl/d-list.w ( input "b-sel"
     2111                         ,input v-title
     2112                         ,input v-list-types
     2113                         ,input v-list-labels
     2114                         ,input chr(44)
     2115                         ,input ''
     2116                         ,output v-list-type) no-error.
     2117       if error-status:error
     2118       or v-list-type = ''
     2119       then do:
     2120         return .
     2121       end.
     2122     end.
     2123     else do:
     2124       v-list-type = p-uniq-key-rec.
     2125     end.
     2126     message
     2127     "По умолчанию список/макрос сохраняется ТОЛЬКО в текущей БД"
     2128     "Для доступности в других БД - выберите опцию ГЛОБАЛЬНЫЙ"
