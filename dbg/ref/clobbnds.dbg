     2377       ,input  v-cntxt-userid
     2378       ,input  0
     2379       ,input  'actn_clob-list_send':U
     2380       ,input  'object':U
     2381       ,input  0
     2382       ,input  '':U
     2383       ,input  0
     2384       ,input  0
     2385       ,input  0
     2386       ,input  0
     2387       ,input  true
     2388       ,output glog
     2389       )  .
     2390   end.
     2391     if not glog then undo, return no-apply.
     2392     run proc-b-send in this-procedure no-error.
     2393     if error-status:error then return no-apply.
     2394   END.
     2395   ON VALUE-CHANGED OF br-clobs IN FRAME Dialog-Frame
     2396   DO:
     2397     if available X_clob-bind then do:
     2398       e-descr:screen-value = X_clob-bind.descr.
     2399     end.
     2400     else do:
     2401       e-descr:screen-value = "".
     2402     end.
     2403   END.
     2404   ON CHOOSE OF MENU-ITEM m_data
     2405   DO:
     2406      ASSIGN
     2407     chg-option = "data".
     2408     apply "CHOOSE" to b-chg in frame Dialog-Frame .
     2409     ASSIGN
     2410     chg-option = '':U.
     2411   END.
     2412   ON CHOOSE OF MENU-ITEM m_descr
     2413   DO:
     2414      ASSIGN
     2415     chg-option = "descr".
     2416     apply "CHOOSE" to b-chg in frame Dialog-Frame .
     2417     ASSIGN
     2418     chg-option = '':U.
     2419   END.
     2420   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2421   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2422   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2423   on help of frame Dialog-Frame
     2424   do:
     2425     run gbl/app_help.p
     2426       (input this-procedure :file-name
     2427       ,input ''
     2428       ,input ?
     2429       ) no-error.
     2430     if error-status :error then do:
     2431       message
     2432         "Ошибка при вызове помощи"
     2433         error-status :get-message(1)
     2434         view-as alert-box .
     2435     end.
     2436   end.
     2437   run minbtn-set in this-procedure .
     2438   on choose of b-help in frame Dialog-Frame
     2439   do:
     2440     apply "help":u to frame Dialog-Frame .
     2441   end.
     2442   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2443   procedure minbtn-set :
     2444       do
     2445           on error undo, return error return-value
     2446           :
     2447           define variable ii              as integer       no-undo .
     2448           define variable fh              as widget-handle no-undo .
     2449           define variable hh              as widget-handle no-undo .
     2450           define variable v-h             as handle        extent 4 no-undo .
     2451           define variable v-name-button   as character     no-undo .
     2452           define variable v-help-old-x    as decimal       no-undo .
     2453           define variable v-help-old-y    as decimal       no-undo .
     2454           define variable v-help-old-size as decimal       no-undo .
     2455           define variable v-frame-width   as decimal       no-undo .
     2456           define variable jj              as integer       no-undo .
     2457           do
     2458               on error undo, return error
     2459               :
     2460               assign
     2461                   v-frame-width = frame Dialog-Frame:width - 0.3
     2462                   fh            = frame Dialog-Frame:first-child
     2463                   hh            = fh:first-child
     2464                   ii            = 1
     2465                   .
     2466               do while valid-handle(hh):
     2467                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2468                   do:
     2469                       case lc(hh:name) :
     2470                           when "b-help" then
     2471                               do:
     2472                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2473                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2474                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2475                                   hh:TOOLTIP = "Помощь" .
     2476                                   v-help-old-x = hh:column .
     2477                                   v-help-old-y = hh:row    .
     2478                                   v-help-old-size = hh:width .
     2479                                   hh:width-chars = 2.5 .
     2480                               end.
     2481                           when "b-print" then
     2482                               do:
     2483                                   hh:load-image("cmp/b-print.bmp":u) .
     2484                                   hh:TOOLTIP = "Печать" .
     2485                                   v-h[ii] = hh:handle .
     2486                                   ii = ii + 1 .
     2487                                   hh:width-chars = 3 .
     2488                               end.
     2489                           when "b-history" or
     2490                           when "b-hist" then
     2491                               do:
     2492                                   hh:load-image("cmp/b-hist.bmp":u) .
     2493                                   hh:TOOLTIP = "История" .
     2494                                   v-h[ii] = hh:handle .
     2495                                   ii = ii + 1 .
     2496                                   hh:width-chars = 3 .
     2497                               end.
     2498                           when "b-sch" then
     2499                               do:
     2500                                   hh:load-image("cmp/b-sch.bmp":u) .
     2501                                   hh:TOOLTIP = "Установка Фильтра" .
     2502                                   v-h[ii] = hh:handle .
     2503                                   ii = ii + 1 .
     2504                                   hh:width-chars = 3 .
     2505                               end.
     2506                           when "b-hist-user" then
     2507                               do:
     2508                                   hh:load-image("cmp/b-hist.bmp":u) .
     2509                                   hh:TOOLTIP = "История пользователя" .
     2510                                   ii = ii + 1 .
     2511                               end.
     2512                       end case.
     2513                   end.
     2514                   hh = hh:next-sibling.
     2515               end.
     2516               b-help:column = v-frame-width - b-help:width-chars.
     2517               jj = 0.
     2518               repeat ii = 4 to 1 by -1 :
     2519                   if valid-handle (v-h[ii] ) then
     2520                   do:
     2521                       jj  = jj + 1 .
     2522                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2523                       v-h[ii]:row    = v-help-old-y .
     2524                   end.
     2525               end.
     2526           end.
     2527       end.
     2528   end procedure.
     2529   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2530   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2531   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2532   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2533   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2534   define variable v-diasize-current-frame-height as decimal   no-undo .
     2535   define variable v-diasize-change-size          as logical   no-undo .
     2536   define variable v-diasize-resize-button        as handle    no-undo .
     2537   define variable v-diasize-wndmax               as logical   no-undo .
     2538   define variable v-diasize-wndstore             as logical   no-undo .
     2539   define variable v-diasize-proc-name            as character no-undo .
     2540   define variable v-diasize-browse-handle        as handle    no-undo .
     2541   define variable v-diasize-browse-number        as integer   no-undo .
     2542   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2543   define temp-table temp-diasize-handle no-undo
     2544     field handle-value  as handle
     2545     field save-position as decimal
     2546     index xpk is primary unique handle-value
     2547     .
     2548   define temp-table temp-browse-handle no-undo
     2549     field browse-type   as character
     2550     field browse-number as integer
     2551     field browse-handle as handle
     2552     field original-size as decimal
     2553     index xpk is primary unique browse-type browse-number
     2554     index xie browse-type browse-handle
     2555   .
     2556   procedure diasize_change-height :
     2557     define input  parameter p-change-value  as decimal   no-undo .
     2558     define input  parameter p-move-resize   as logical   no-undo .
     2559     define variable v-field-group-handle    as handle    no-undo .
     2560     define variable v-object-handle         as handle    no-undo .
     2561     define variable v-frame-height          as decimal   no-undo .
     2562     define variable v-frame-virtual-height  as decimal   no-undo .
     2563     define variable v-browse-height         as decimal   no-undo .
     2564     define variable v-window-height         as decimal   no-undo .
     2565     define variable v-window-virtual-height as decimal   no-undo .
     2566     define variable v-change-sign           as integer   no-undo .
     2567     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2568     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2569     if p-change-value > 0
     2570     then do:
     2571       if frame Dialog-Frame :height + p-change-value
     2572           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2573       then do:
     2574         assign
     2575           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2576                           - (frame Dialog-Frame :height-chars)
     2577         .
     2578         if p-change-value <= 0
     2579         then do:
     2580           run diasize_position-resize-button in this-procedure .
     2581           return .
     2582         end.
     2583       end.
     2584     end.
     2585     if p-change-value < 0
     2586     then do:
     2587       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2588       then do:
     2589         assign
     2590           p-change-value = v-diasize-orig-frame-height
     2591                          - (frame Dialog-Frame :height-chars)
     2592         .
     2593         if p-change-value >= 0
     2594         then do:
     2595           run diasize_position-resize-button in this-procedure .
     2596           return .
     2597         end.
     2598       end.
     2599     end.
     2600     if p-change-value >= 0
     2601     then do:
     2602       assign
     2603         v-change-sign = 1
     2604       .
     2605     end.
     2606     else do:
     2607       assign
     2608         v-change-sign = -1
     2609       .
     2610     end.
     2611     assign
     2612       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2613     .
     2614     if p-change-value = 0
     2615     then do:
     2616       run diasize_position-resize-button in this-procedure .
     2617       return .
     2618     end.
     2619     move_block:
     2620     do
     2621     on error undo move_block, retry move_block
     2622     :
     2623       if retry
     2624       then do:
     2625         do
     2626         on error undo move_block, leave move_block
     2627         :
     2628           if p-change-value > 0
     2629           then do:
     2630             for each buf_temp-diasize-handle
     2631             on error undo, next
     2632             :
     2633               assign
     2634                 v-object-handle = buf_temp-diasize-handle.handle-value
     2635               .
     2636               if v-object-handle <> v-diasize-resize-button
     2637               then do:
     2638                 assign
     2639                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2640                 .
     2641               end.
     2642             end.
     2643             assign
     2644               v-diasize-browse-handle :height = v-browse-height
     2645             .
     2646             for each buf_temp-browse-handle
     2647               where buf_temp-browse-handle.browse-type = 'height':u
     2648             on error undo, next
     2649             :
     2650               assign
     2651                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2652               .
     2653             end.
     2654             assign
     2655               frame Dialog-Frame :height = v-frame-height
     2656             .
     2657             if frame Dialog-Frame :scrollable = true
     2658             then do:
     2659               assign
     2660                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2661               .
     2662             end.
     2663             run diasize_position-resize-button in this-procedure .
     2664           end.
     2665           else do:
     2666             if frame Dialog-Frame :scrollable = true
     2667             then do:
     2668               assign
     2669                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2670               .
     2671             end.
     2672             assign
     2673               frame Dialog-Frame :height = v-frame-height
     2674             .
     2675             assign
     2676               v-diasize-browse-handle :height = v-browse-height
     2677             .
     2678             for each buf_temp-browse-handle
     2679               where buf_temp-browse-handle.browse-type = 'height':u
     2680             on error undo, next
     2681             :
     2682               assign
     2683                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2684               .
     2685             end.
     2686             for each buf_temp-diasize-handle
     2687             on error undo, next
     2688             :
     2689               assign
     2690                 v-object-handle = buf_temp-diasize-handle.handle-value
     2691               .
     2692               if v-object-handle <> v-diasize-resize-button
     2693               then do:
     2694                 assign
     2695                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2696                 .
     2697               end.
     2698             end.
     2699             run diasize_position-resize-button in this-procedure .
     2700           end.
     2701           assign
     2702             v-diasize-change-size = false
     2703           .
     2704           leave move_block .
     2705         end.
     2706       end.
     2707       assign
     2708         v-diasize-need-full-display = true
     2709       .
     2710       if v-diasize-change-size = false
     2711       then do:
     2712         assign
     2713           v-diasize-change-size = true
     2714         .
     2715       end.
     2716       else do:
     2717         return .
     2718       end.
     2719       assign
     2720         v-frame-height = frame Dialog-Frame :height
     2721         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2722         v-browse-height = v-diasize-browse-handle :height
     2723       .
     2724       for each buf_temp-browse-handle
     2725         where buf_temp-browse-handle.browse-type = 'height':u
     2726       :
     2727         assign
     2728           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2729         .
     2730       end.
     2731       for each buf_temp-diasize-handle
     2732       :
     2733         delete buf_temp-diasize-handle .
     2734       end.
     2735       assign
     2736         v-field-group-handle = frame Dialog-Frame :first-child
     2737       .
     2738       do while valid-handle(v-field-group-handle)
     2739       :
     2740         assign
     2741           v-object-handle = v-field-group-handle :first-child
     2742         .
     2743         do while valid-handle(v-object-handle)
     2744         :
     2745           if  v-object-handle <> v-diasize-browse-handle :handle
     2746           and can-query(v-object-handle, "row")
     2747           and can-query(v-object-handle, "height")
     2748           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2749           then do:
     2750             find first buf_temp-browse-handle
     2751               where buf_temp-browse-handle.browse-type   = 'height':u
     2752                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2753               no-error .
     2754             if available buf_temp-browse-handle
     2755             then do:
     2756             end.
     2757             else do:
     2758               create buf_temp-diasize-handle .
     2759               assign
     2760                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2761                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2762               .
     2763             end.
     2764           end.
     2765           assign
     2766             v-object-handle = v-object-handle :next-sibling
     2767           .
     2768         end.
     2769         assign
     2770           v-field-group-handle = v-field-group-handle :next-sibling
     2771         .
     2772       end.
     2773       do with frame Dialog-Frame
     2774       :
     2775         hide v-diasize-resize-button .
     2776         assign
     2777           v-diasize-resize-button :row    = 1
     2778           v-diasize-resize-button :column = 1
     2779         .
     2780       end.
     2781       if p-change-value > 0
     2782       then do:
     2783         if frame Dialog-Frame :scrollable = true
     2784         then do:
     2785           assign
     2786             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2787             no-error .
     2788           if error-status :error
     2789           or error-status :get-message(1) <> ""
     2790           then do:
     2791             undo move_block, retry move_block .
     2792           end.
     2793         end.
     2794         assign
     2795           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2796           no-error .
     2797         if error-status :error
     2798         or error-status :get-message(1) <> ""
     2799         then do:
     2800           undo move_block, retry move_block .
     2801         end.
     2802         assign
     2803           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2804           no-error .
     2805         if error-status :error
     2806         or error-status :get-message(1) <> ""
     2807         then do:
     2808           undo move_block, retry move_block .
     2809         end.
     2810         for each buf_temp-browse-handle
     2811           where buf_temp-browse-handle.browse-type = 'height':u
     2812         on error undo move_block, retry move_block
     2813         :
     2814           assign
     2815             buf_temp-browse-handle.browse-handle :height
     2816               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2817             no-error .
     2818           if error-status :error
     2819           or error-status :get-message(1) <> ""
     2820           then do:
     2821             undo move_block, retry move_block .
     2822           end.
     2823         end.
     2824         for each buf_temp-diasize-handle
     2825         on error undo move_block, retry move_block
     2826         :
     2827           assign
     2828             v-object-handle = buf_temp-diasize-handle.handle-value
     2829           .
     2830           if v-object-handle <> v-diasize-resize-button
     2831           then do:
     2832             assign
     2833               v-object-handle :row = v-object-handle :row + p-change-value
     2834               no-error .
     2835             if error-status :error
     2836             or error-status :get-message(1) <> ""
     2837             then do:
     2838               undo move_block, retry move_block .
     2839             end.
     2840           end.
     2841         end.
     2842       end.
     2843       else do:
     2844         for each buf_temp-diasize-handle
     2845         on error undo move_block, retry move_block
     2846         :
     2847           assign
     2848             v-object-handle = buf_temp-diasize-handle.handle-value
     2849           .
     2850           if v-object-handle <> v-diasize-resize-button
     2851           then do:
     2852             assign
     2853               v-object-handle :row = v-object-handle :row + p-change-value
     2854               no-error .
     2855             if error-status :error
     2856             or error-status :get-message(1) <> ""
     2857             then do:
     2858               undo move_block, retry move_block .
     2859             end.
     2860           end.
     2861         end.
     2862         assign
     2863           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2864           no-error .
     2865         if error-status :error
     2866         or error-status :get-message(1) <> ""
     2867         then do:
     2868           undo move_block, retry move_block .
     2869         end.
     2870         for each buf_temp-browse-handle
     2871           where buf_temp-browse-handle.browse-type = 'height':u
     2872         on error undo move_block, retry move_block
     2873         :
     2874           assign
     2875             buf_temp-browse-handle.browse-handle :height
     2876               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2877             no-error .
     2878           if error-status :error
     2879           or error-status :get-message(1) <> ""
     2880           then do:
     2881             undo move_block, retry move_block .
     2882           end.
     2883         end.
     2884         assign
     2885           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2886           no-error .
     2887         if error-status :error
     2888         or error-status :get-message(1) <> ""
     2889         then do:
     2890           undo move_block, retry move_block .
     2891         end.
     2892         if frame Dialog-Frame :scrollable = true
     2893         then do:
     2894           assign
     2895             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2896             no-error .
     2897           if error-status :error
     2898           or error-status :get-message(1) <> ""
     2899           then do:
     2900             undo move_block, retry move_block .
     2901           end.
     2902         end.
     2903       end.
     2904       if p-move-resize = true
     2905       then do:
     2906         run diasize_position-resize-button in this-procedure .
     2907       end.
     2908       if v-diasize-wndstore = true
     2909       then do:
     2910         if connected("ub") = true
     2911         then do:
     2912           define variable v-cntxt-db-num        as integer   no-undo .
     2913           define variable v-cntxt-userid        as character no-undo .
     2914           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2915                                             , OUTPUT v-cntxt-userid
     2916                                             ) .
     2917           run gbl/wndsizew.p
     2918             (input  v-cntxt-db-num
     2919             ,input  v-cntxt-userid
     2920             ,input  v-diasize-proc-name
     2921             ,input  'height':u
     2922             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2923             ) .
     2924         end.
     2925       end.
     2926     end.
     2927     assign
     2928       v-diasize-change-size = false
     2929     .
     2930   end procedure.
     2931   procedure diasize_set-height :
     2932     define input  parameter p-new-height  as decimal   no-undo .
     2933     define input  parameter p-move-resize as logical   no-undo .
     2934     do
     2935     on error undo, return error return-value
     2936     :
     2937       run diasize_change-height in this-procedure
     2938         (input  (p-new-height - frame Dialog-Frame :height)
     2939         ,input  p-move-resize
     2940         ) .
     2941     end.
     2942   end procedure.
     2943   procedure diasize_change-width :
     2944     define input  parameter p-change-value as decimal   no-undo .
     2945     define input  parameter p-move-resize  as logical   no-undo .
     2946     define variable v-field-group-handle   as handle    no-undo .
     2947     define variable v-object-handle        as handle    no-undo .
     2948     define variable v-frame-width          as decimal   no-undo .
     2949     define variable v-frame-virtual-width  as decimal   no-undo .
     2950     define variable v-browse-width         as decimal   no-undo .
     2951     define variable v-window-width         as decimal   no-undo .
     2952     define variable v-window-virtual-width as decimal   no-undo .
     2953     define variable v-change-sign          as integer   no-undo .
     2954     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2955     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2956     if p-change-value > 0
     2957     then do:
     2958       if frame Dialog-Frame :width + p-change-value >
     2959           session :width-chars
     2960       then do:
     2961         assign
     2962           p-change-value = session :width-chars - frame Dialog-Frame :width
     2963         .
     2964         if p-change-value <= 0
     2965         then do:
     2966           run diasize_position-resize-button in this-procedure .
     2967           return .
     2968         end.
     2969       end.
     2970     end.
     2971     if p-change-value < 0
     2972     then do:
     2973       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2974       then do:
     2975         assign
     2976           p-change-value = v-diasize-orig-frame-width
     2977                          - frame Dialog-Frame :width
     2978         .
     2979         if p-change-value >= 0
     2980         then do:
     2981           run diasize_position-resize-button in this-procedure .
     2982           return .
     2983         end.
     2984       end.
     2985     end.
     2986     if p-change-value >= 0
     2987     then do:
     2988       assign
     2989         v-change-sign = 1
     2990       .
     2991     end.
     2992     else do:
     2993       assign
     2994         v-change-sign = -1
     2995       .
     2996     end.
     2997     assign
     2998       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2999     .
     3000     if p-change-value = 0
     3001     then do:
     3002       run diasize_position-resize-button in this-procedure .
     3003       return .
     3004     end.
     3005     move_block:
     3006     do
     3007     on error undo move_block, leave move_block
     3008     :
     3009       if retry
     3010       then do:
     3011         do
     3012         on error undo move_block, leave move_block
     3013         :
     3014           if p-change-value > 0
     3015           then do:
     3016             for each buf_temp-diasize-handle
     3017             on error undo, next
     3018             :
     3019               assign
     3020                 v-object-handle = buf_temp-diasize-handle.handle-value
     3021               .
     3022               if v-object-handle <> v-diasize-resize-button
     3023               then do:
     3024                 assign
     3025                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3026                 .
     3027               end.
     3028             end.
     3029             assign
     3030               v-diasize-browse-handle :width = v-browse-width
     3031             .
     3032             for each buf_temp-browse-handle
     3033               where buf_temp-browse-handle.browse-type = 'width':u
     3034             on error undo, next
     3035             :
     3036               assign
     3037                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3038               .
     3039             end.
     3040             assign
     3041               frame Dialog-Frame :width = v-frame-width
     3042             .
     3043             if frame Dialog-Frame :scrollable = true
     3044             then do:
     3045               assign
     3046                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3047               .
     3048             end.
     3049             run diasize_position-resize-button in this-procedure .
     3050           end.
     3051           else do:
     3052             if frame Dialog-Frame :scrollable = true
     3053             then do:
     3054               assign
     3055                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3056               .
     3057             end.
     3058             assign
     3059               frame Dialog-Frame :width = v-frame-width
     3060             .
     3061             for each buf_temp-browse-handle
     3062               where buf_temp-browse-handle.browse-type = 'width':u
     3063             on error undo, next
     3064             :
     3065               assign
     3066                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3067               .
     3068             end.
     3069             assign
     3070               v-diasize-browse-handle :width = v-browse-width
     3071             .
     3072             for each buf_temp-diasize-handle
     3073             on error undo, next
     3074             :
     3075               assign
     3076                 v-object-handle = buf_temp-diasize-handle.handle-value
     3077               .
     3078               if v-object-handle <> v-diasize-resize-button
     3079               then do:
     3080                 assign
     3081                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3082                 .
     3083               end.
     3084             end.
     3085             run diasize_position-resize-button in this-procedure .
     3086           end.
     3087           assign
     3088             v-diasize-change-size = false
     3089           .
     3090           leave move_block .
     3091         end.
     3092       end.
     3093       assign
     3094         v-diasize-need-full-display = true
     3095       .
     3096       if v-diasize-change-size = false
     3097       then do:
     3098         assign
     3099           v-diasize-change-size = true
     3100         .
     3101       end.
     3102       else do:
     3103         return .
     3104       end.
     3105       assign
     3106         v-frame-width = frame Dialog-Frame :width
     3107         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3108         v-browse-width = v-diasize-browse-handle :width
     3109       .
     3110       for each buf_temp-browse-handle
     3111         where buf_temp-browse-handle.browse-type = 'width':u
     3112       :
     3113         assign
     3114           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3115         .
     3116       end.
     3117       for each buf_temp-diasize-handle
     3118       :
     3119         delete buf_temp-diasize-handle .
     3120       end.
     3121       assign
     3122         v-field-group-handle = frame Dialog-Frame :first-child
     3123       .
     3124       do while valid-handle(v-field-group-handle)
     3125       :
     3126         assign
     3127           v-object-handle = v-field-group-handle :first-child
     3128         .
     3129         do while valid-handle(v-object-handle)
     3130         :
     3131           if  v-object-handle <> v-diasize-browse-handle :handle
     3132           and v-object-handle <> v-diasize-resize-button
     3133           and can-query(v-object-handle, "row")
     3134           and can-query(v-object-handle, "height")
     3135           and ( v-object-handle :col + v-object-handle :width
     3136                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3137               )
     3138           then do:
     3139             find first buf_temp-browse-handle
     3140               where buf_temp-browse-handle.browse-type   = 'width':u
     3141                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3142               no-error .
     3143             if available buf_temp-browse-handle
     3144             then do:
     3145             end.
     3146             else do:
     3147               create buf_temp-diasize-handle .
     3148               assign
     3149                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3150                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3151               .
     3152             end.
     3153           end.
     3154           assign
     3155             v-object-handle = v-object-handle :next-sibling
     3156           .
     3157         end.
     3158         assign
     3159           v-field-group-handle = v-field-group-handle :next-sibling
     3160         .
     3161       end.
     3162       do with frame Dialog-Frame
     3163       :
     3164         hide v-diasize-resize-button .
     3165         v-diasize-resize-button :row = 1.
     3166         v-diasize-resize-button :column = 1.
     3167       end.
     3168       if p-change-value > 0
     3169       then do:
     3170         if frame Dialog-Frame :scrollable = true
     3171         then do:
     3172           assign
     3173             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3174             no-error .
     3175           if error-status :error
     3176           or error-status :get-message(1) <> ""
     3177           then do:
     3178             undo move_block, retry move_block.
     3179           end.
     3180         end.
     3181         assign
     3182           frame Dialog-Frame :width = v-frame-width + p-change-value
     3183           no-error .
     3184         if error-status :error
     3185         or error-status :get-message(1) <> ""
     3186         then do:
     3187           undo move_block, retry move_block.
     3188         end.
     3189         assign
     3190           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3191         no-error .
     3192         if error-status :error
     3193         or error-status :get-message(1) <> ""
     3194         then do:
     3195           undo move_block, retry move_block.
     3196         end.
     3197         for each buf_temp-browse-handle
     3198           where buf_temp-browse-handle.browse-type = 'width':u
     3199         on error undo move_block, retry move_block
     3200         :
     3201           assign
     3202             buf_temp-browse-handle.browse-handle :width
     3203               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3204             no-error .
     3205           if error-status :error
     3206           or error-status :get-message(1) <> ""
     3207           then do:
     3208             undo move_block, retry move_block .
     3209           end.
     3210         end.
     3211         for each buf_temp-diasize-handle
     3212         on error undo move_block, retry move_block
     3213         :
     3214           assign
     3215             v-object-handle = buf_temp-diasize-handle.handle-value
     3216           .
     3217           if v-object-handle <> v-diasize-resize-button
     3218           then do:
     3219             assign
     3220               v-object-handle :col = v-object-handle :col + p-change-value
     3221               no-error .
     3222             if error-status :error
     3223             or error-status :get-message(1) <> ""
     3224             then do:
     3225               undo move_block, retry move_block .
     3226             end.
     3227           end.
     3228         end.
     3229       end.
     3230       else do:
     3231         for each buf_temp-diasize-handle
     3232         on error undo move_block, retry move_block
     3233         :
     3234           assign
     3235             v-object-handle = buf_temp-diasize-handle.handle-value
     3236           .
     3237           if v-object-handle <> v-diasize-resize-button
     3238           then do:
     3239             assign
     3240               v-object-handle :col = v-object-handle :col + p-change-value
     3241               no-error .
     3242             if error-status :error
     3243             or error-status :get-message(1) <> ""
     3244             then do:
     3245               undo move_block, retry move_block .
     3246             end.
     3247           end.
     3248         end.
     3249         for each buf_temp-browse-handle
     3250           where buf_temp-browse-handle.browse-type = 'width':u
     3251         on error undo move_block, retry move_block
     3252         :
     3253           assign
     3254             buf_temp-browse-handle.browse-handle :width
     3255               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3256             no-error .
     3257           if error-status :error
     3258           or error-status :get-message(1) <> ""
     3259           then do:
     3260             undo move_block, retry move_block .
     3261           end.
     3262         end.
     3263         assign
     3264           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3265           no-error .
     3266         if error-status :error
     3267         or error-status :get-message(1) <> ""
     3268         then do:
     3269           undo move_block, retry move_block.
     3270         end.
     3271         assign
     3272           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3273         no-error .
     3274         if error-status :error
     3275         or error-status :get-message(1) <> ""
     3276         then do:
     3277           undo move_block, retry move_block.
     3278         end.
     3279         if frame Dialog-Frame :scrollable = true
     3280         then do:
