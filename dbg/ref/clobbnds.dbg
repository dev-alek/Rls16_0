     2156                                ,input this-procedure:handle
     2157                                ,input v-cntxt-host-code-obj
     2158                                ,input v-cntxt-obj-type
     2159                                ,input v-cntxt-obj-code
     2160                                ,input p-resource-type + chr(44) +  "clobbnds_add"
     2161                                ,input substitute("СПИСОК КЛИЕНТОВ - добавление/изменение &1"
     2162                                                  , (if p-resource-type = 'list':U
     2163                                                     then "хранимого списка"
     2164                                                     else "хранимого макроса формирования списка")
     2165                                                    )
     2166                                ,input no).
     2167         end.
     2168         when "dc-list" then do:
     2169            run str/dc-listp.w ( input parparentproc
     2170                                ,input this-procedure:handle
     2171                                ,input v-cntxt-host-code-obj
     2172                                ,input v-cntxt-obj-type
     2173                                ,input v-cntxt-obj-code
     2174                                ,input p-resource-type + chr(44) + "clobbnds_add"
     2175                                ,input substitute("СПИСОК ДК - добавление/изменение &1"
     2176                                                  , (if p-resource-type = 'list':U
     2177                                                     then "хранимого списка"
     2178                                                     else "хранимого макроса формирования списка")
     2179                                                   )
     2180                                ,input no).
     2181         end.
     2182       end case.
     2183     end.
     2184     else do:
     2185       run clobbnds_add in this-procedure ( input ?
     2186                                         ,input p-resource-type
     2187                                         ,input v-list-type
     2188                                         ) no-error.
     2189     end.
     2190   END.
