     3283           no-error .
     3284           if error-status :error
     3285           or error-status :get-message(1) <> ""
     3286           then do:
     3287             undo move_block, retry move_block.
     3288           end.
     3289         end.
     3290       end.
     3291       if p-move-resize
     3292       then do:
     3293         run diasize_position-resize-button in this-procedure .
     3294       end.
     3295       if v-diasize-wndstore = true
     3296       then do:
     3297         if connected("ub") = true
     3298         then do:
     3299           define variable v-cntxt-db-num        as integer   no-undo .
     3300           define variable v-cntxt-userid        as character no-undo .
     3301           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3302                                             , OUTPUT v-cntxt-userid
     3303                                             ) .
     3304           run gbl/wndsizew.p
     3305             (input  v-cntxt-db-num
     3306             ,input  v-cntxt-userid
     3307             ,input  v-diasize-proc-name
     3308             ,input  'width':u
     3309             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3310             ) .
     3311         end.
     3312       end.
     3313     end.
     3314     assign
     3315       v-diasize-change-size = false
     3316     .
     3317   end procedure.
     3318   procedure diasize_set-width :
     3319     define input  parameter p-new-width  as decimal   no-undo .
     3320     define input  parameter p-move-resize as logical   no-undo .
     3321     do
     3322     on error undo, return error return-value
     3323     :
     3324       run diasize_change-width in this-procedure
     3325         (input  (p-new-width - frame Dialog-Frame :width)
     3326         ,input  p-move-resize
     3327         ) .
     3328     end.
     3329   end procedure.
     3330   procedure diasize_position-resize-button :
     3331     do with frame Dialog-Frame
     3332     :
     3333       hide v-diasize-resize-button .
     3334       assign
     3335         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3336                     - 1
     3337                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3338         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3339                     - 1
     3340                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3341       .
     3342       view v-diasize-resize-button .
     3343     end.
     3344   end procedure.
     3345   on alt-right anywhere
     3346   do:
     3347     run diasize_change-width in this-procedure
     3348       (input 1
     3349       ,input true
     3350       ) .
     3351     return no-apply .
     3352   end.
     3353   on alt-left anywhere
     3354   do:
     3355     run diasize_change-width in this-procedure
     3356       (input -1
     3357       ,input true
     3358       ) .
     3359     return no-apply .
     3360   end.
     3361   on alt-down anywhere
     3362   do:
     3363     run diasize_change-height in this-procedure
     3364       (input 1
     3365       ,input true
     3366       ) .
     3367     return no-apply .
     3368   end.
     3369   on alt-up anywhere
     3370   do:
     3371     run diasize_change-height in this-procedure
     3372       (input -1
     3373       ,input true
     3374       ) .
     3375     return no-apply .
     3376   end.
     3377   on alt-enter of frame Dialog-Frame
     3378   do:
     3379     run diasize_maximize in this-procedure
     3380       (input  ?
     3381       ).
     3382     return no-apply .
     3383   end.
     3384   procedure diasize_end-move :
     3385     do
     3386     on error undo, return error return-value
     3387     :
     3388       define variable v-row-delta as decimal   no-undo .
     3389       define variable v-col-delta as decimal   no-undo .
     3390       define variable v-new-row as decimal   no-undo .
     3391       define variable v-new-col as decimal   no-undo .
     3392       assign
     3393         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3394         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3395       .
     3396       assign
     3397         v-row-delta = v-new-row - frame Dialog-Frame :height
     3398         v-col-delta = v-new-col - frame Dialog-Frame :width
     3399       .
     3400       run diasize_change-height in this-procedure
     3401         (input v-row-delta
     3402         ,input true
     3403         ) .
     3404       run diasize_change-width in this-procedure
     3405         (input v-col-delta
     3406         ,input true
     3407         ) .
     3408     end.
     3409   end procedure.
     3410   procedure diasize_maximize :
     3411     define input  parameter p-action as logical   no-undo .
     3412     do
     3413     on error undo, return error return-value
     3414     :
     3415       if p-action = ?
     3416       then do:
     3417         if v-diasize-need-maximize = true
     3418         then do:
     3419           assign
     3420             p-action = true
     3421           .
     3422         end.
     3423         else do:
     3424           assign
     3425             p-action = false
     3426           .
     3427         end.
     3428       end.
     3429       if p-action = true
     3430       then do:
     3431         run diasize_change-height in this-procedure
     3432           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3433               - frame Dialog-Frame :height-chars
     3434           ,input true
     3435           ) .
     3436         run diasize_change-width in this-procedure
     3437           (input session :width-chars
     3438               - frame Dialog-Frame :width-chars
     3439           ,input true
     3440           ) .
     3441         assign
     3442           v-diasize-need-maximize = false
     3443         .
     3444       end.
     3445       else do:
     3446         run diasize_change-width in this-procedure
     3447           (input v-diasize-orig-frame-width
     3448               - frame Dialog-Frame :width-chars
     3449           ,input true
     3450           ) .
     3451         run diasize_change-height in this-procedure
     3452           (input v-diasize-orig-frame-height
     3453               - frame Dialog-Frame :height-chars
     3454           ,input true
     3455           ) .
     3456         assign
     3457           v-diasize-need-maximize = true
     3458         .
     3459       end.
     3460     end.
     3461   end procedure.
     3462   procedure diasize_restore-orig-size :
     3463     do
     3464     on error undo, return error return-value
     3465     :
     3466       assign
     3467         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3468         v-diasize-current-frame-height = frame Dialog-Frame :height
     3469       .
     3470       run diasize_set-height in this-procedure
     3471         (input  v-diasize-orig-frame-height
     3472         ,input  true
     3473         ) .
     3474       run diasize_set-width in this-procedure
     3475         (input  v-diasize-orig-frame-width
     3476         ,input  true
     3477         ) .
     3478     end.
     3479   end procedure.
     3480   procedure diasize_restore-current-size :
     3481     do
     3482     on error undo, return error return-value
     3483     :
     3484       run diasize_set-height in this-procedure
     3485         (input  v-diasize-current-frame-height
     3486         ,input  true
     3487         ) .
     3488       run diasize_set-width in this-procedure
     3489         (input  v-diasize-current-frame-width
     3490         ,input  true
     3491         ) .
     3492     end.
     3493   end procedure.
     3494   procedure diasize_set-browse-handle :
     3495     define input  parameter p-browse-handle as handle   no-undo .
     3496     define buffer buf_temp-browse-handle for temp-browse-handle .
     3497     do
     3498     on error undo, return error return-value
     3499     :
     3500       assign
     3501         v-diasize-browse-handle = p-browse-handle
     3502       .
     3503       for each buf_temp-browse-handle
     3504       on error undo, return error return-value
     3505       :
     3506         delete buf_temp-browse-handle .
     3507       end.
     3508     end.
     3509   end procedure.
     3510   procedure diasize_add_browse :
     3511     define input  parameter p-browse-type   as character no-undo .
     3512     define input  parameter p-browse-handle as handle    no-undo .
     3513     define buffer buf_temp-browse-handle for temp-browse-handle .
     3514     do
     3515     on error undo, return error return-value
     3516     :
     3517       assign
     3518         v-diasize-browse-number = v-diasize-browse-number + 1
     3519       .
     3520       create buf_temp-browse-handle .
     3521       assign
     3522         buf_temp-browse-handle.browse-type   = p-browse-type
     3523         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3524         buf_temp-browse-handle.browse-handle = p-browse-handle
     3525       .
     3526     end.
     3527   end procedure.
     3528   procedure diasize_init :
     3529     define variable v-default-value    as logical   no-undo .
     3530     define variable v-restore-saved    as logical   no-undo .
     3531     define variable v-resize-value-str as character no-undo .
     3532     do
     3533     on error undo, return error return-value
     3534     :
     3535       do with frame Dialog-Frame
     3536       :
     3537         assign
     3538           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3539           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3540           v-diasize-browse-handle     = browse br-clobs :handle
     3541         .
     3542         create button v-diasize-resize-button
     3543         assign
     3544           parent        = frame Dialog-Frame :first-child
     3545           label         = "s"
     3546           height-pixels = 16
     3547           width-pixels  = 16
     3548           visible       = true
     3549           sensitive     = true
     3550           movable       = true
     3551           triggers:
     3552             on end-move persistent run diasize_end-move in this-procedure .
     3553           end triggers.
     3554         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3555         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3556         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3557         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3558         assign
     3559           v-diasize-wndmax = false
     3560         .
     3561         if connected("ub") = true
     3562         then do:
     3563           define variable v-cntxt-db-num        as integer   no-undo .
     3564           define variable v-cntxt-userid        as character no-undo .
     3565           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3566                                             , OUTPUT v-cntxt-userid
     3567                                             ) .
     3568           run gbl/wndpar_r.p
     3569             (input  v-cntxt-db-num
     3570             ,input  v-cntxt-userid
     3571             ,input  'wndmax':U
     3572             ,output v-diasize-wndmax
     3573             ,output v-default-value
     3574             ) .
     3575         end.
     3576         assign
     3577           v-diasize-wndstore = false
     3578         .
     3579         if connected("ub") = true
     3580         then do:
     3581           run gbl/wndpar_r.p
     3582             (input  v-cntxt-db-num
     3583             ,input  v-cntxt-userid
     3584             ,input  'wndstore':U
     3585             ,output v-diasize-wndstore
     3586             ,output v-default-value
     3587             ) .
     3588         end.
     3589         assign
     3590           v-diasize-proc-name = entry(1, program-name(2), '.')
     3591         .
     3592         if v-diasize-wndstore = true
     3593         then do:
     3594           assign
     3595             v-restore-saved = false
     3596           .
     3597           if connected("ub") = true
     3598           then do:
     3599             run gbl/wndsizer.p
     3600               (input  v-cntxt-db-num
     3601               ,input  v-cntxt-userid
     3602               ,input  v-diasize-proc-name
     3603               ,input  'height':u
     3604               ,output v-resize-value-str
     3605               ) .
     3606             if v-resize-value-str <> '':U
     3607             then do:
     3608               run diasize_change-height in this-procedure
     3609                 (input  integer(v-resize-value-str)
     3610                 ,input  true
     3611                 ) .
     3612               assign
     3613                 v-restore-saved = true
     3614               .
     3615             end.
     3616           end.
     3617           if connected("ub") = true
     3618           then do:
     3619             run gbl/wndsizer.p
     3620               (input  v-cntxt-db-num
     3621               ,input  v-cntxt-userid
     3622               ,input  v-diasize-proc-name
     3623               ,input  'width':u
     3624               ,output v-resize-value-str
     3625               ) .
     3626             if v-resize-value-str <> '':U
     3627             then do:
     3628               run diasize_change-width in this-procedure
     3629                 (input  integer(v-resize-value-str)
     3630                 ,input  true
     3631                 ) .
     3632               assign
     3633                 v-restore-saved = true
     3634               .
     3635             end.
     3636           end.
     3637           if v-restore-saved <> true
     3638           then do:
     3639             if v-diasize-wndmax = true
     3640             then do:
     3641               run diasize_maximize in this-procedure
     3642                 (input  true
     3643                 ) .
     3644             end.
     3645           end.
     3646         end.
     3647         else do:
     3648           if v-diasize-wndmax = true
     3649           then do:
     3650             run diasize_maximize in this-procedure
     3651               (input  true
     3652               ) .
     3653           end.
     3654         end.
     3655       end.
     3656     end.
     3657   end procedure.
     3658   procedure diasize_need-full-display :
     3659     define output parameter p-need-full-display as logical   no-undo .
     3660     do
     3661     on error undo, return error return-value
     3662     :
     3663       assign
     3664         p-need-full-display = v-diasize-need-full-display
     3665       .
     3666       assign
     3667         v-diasize-need-full-display = false
     3668       .
     3669     end.
     3670   end procedure.
     3671   procedure get-context :
     3672      define output parameter p-db-num as integer          no-undo.
     3673      define output parameter p-user-id as character        no-undo.
     3674      define variable v-login               as character    no-undo.
     3675      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3676      define buffer buf_user-login  for ub.user-login .
     3677      do
     3678      on error undo, return error
     3679      :
     3680            FIND FIRST buf_sys-ctrl no-lock.
     3681            ASSIGN
     3682               v-login = USERID("ub")
     3683               p-db-num = buf_sys-ctrl.db-num
     3684            .
     3685            FIND FIRST buf_user-login
     3686                 WHERE buf_user-login.db-num = p-db-num
     3687                   AND buf_user-login.user-login = v-login
     3688                 no-lock
     3689                 no-error
     3690                 .
     3691            IF AVAILABLE buf_user-login
     3692            THEN DO:
     3693               assign
     3694                  p-user-id = buf_user-login.user-id
     3695               .
     3696            END.
     3697      end.
     3698   end procedure.
     3699       run diasize_init in this-procedure .
     3700   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3701   procedure set-filter-name :
     3702   define input parameter p-filter-name as character no-undo .
     3703     do with frame Dialog-Frame:
     3704       if p-filter-name > "" then do:
     3705         assign
     3706           frame Dialog-Frame:title
     3707             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3708         .
     3709         assign
     3710           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3711         .
     3712       end.
     3713       else do:
     3714         assign
     3715           b-sch :tooltip = ""
     3716         .
     3717       end.
     3718     end.
     3719   end procedure.
     3720   def var sort-labelbr-clobs   as character no-undo .
     3721   def var sort-clmnbr-clobs    as handle    no-undo .
     3722   def var cur-clmnbr-clobs     as handle    no-undo .
     3723   def var cur-clmn-locbr-clobs as integer   no-undo .
     3724   def var re-querybr-clobs     as logical   initial no no-undo .
     3725   on start-search, ctrl-o of br-clobs in frame Dialog-Frame do:
     3726      run sort-brbr-clobs
     3727        (input (if available X_clob-bind
     3728                then recid(X_clob-bind)
     3729                else ?
     3730               )
     3731        ).
     3732   end.
     3733   PROCEDURE sort-brbr-clobs :
     3734     define input parameter p-recid as recid no-undo .
     3735     if re-querybr-clobs = no then do:
     3736       assign
     3737          cur-clmnbr-clobs = br-clobs:current-column in frame Dialog-Frame
     3738       .
     3739       if sort-clmnbr-clobs <> ? then sort-clmnbr-clobs:column-fgcolor = 0.
     3740       if cur-clmnbr-clobs = sort-clmnbr-clobs then do:
     3741         assign
     3742            sort-labelbr-clobs = ""
     3743            sort-clmnbr-clobs = ?
     3744         .
     3745        end.
     3746        else do:
     3747          assign
     3748            sort-labelbr-clobs = cur-clmnbr-clobs:label
     3749            sort-clmnbr-clobs  = cur-clmnbr-clobs
     3750            sort-clmnbr-clobs:column-fgcolor = 4
     3751          .
     3752        end.
     3753      end.
     3754     assign
     3755       cur-clmn-locbr-clobs = 1
     3756     .
     3757     def var column-handle as handle no-undo .
     3758     column-handle = br-clobs:first-column.
     3759     do while valid-handle(column-handle) :
     3760       if column-handle = cur-clmnbr-clobs then do:
     3761         leave .
     3762       end.
     3763       column-handle = column-handle:NEXT-COLUMN.
     3764       assign
     3765         cur-clmn-locbr-clobs = cur-clmn-locbr-clobs + 1
     3766       .
     3767     end.
     3768     case sort-labelbr-clobs:
     3769           when X_clob-bind.field-name_:label in browse br-clobs then DO:    assign       sort-column-name = "X_clob-bind.field-name_"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3770           when X_clob-bind.descr:label in browse br-clobs then DO:    assign       sort-column-name = "X_clob-bind.descr"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3771           when X_clob-bind.sys-date:label in browse br-clobs then DO:    assign       sort-column-name = "X_clob-bind.sys-date"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3772           when X_clob-bind.sys-time:label in browse br-clobs then DO:    assign       sort-column-name = "X_clob-bind.sys-time"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3773           when 'Создал'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1usrfulnf&1, X_clob-bind.user-name)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3774           when 'Изменил'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1usrfulnf&1, X_clob-data.user-name)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     3775       otherwise do:
     3776         assign
     3777           sort-column-name = ""
     3778         .
     3779         run OpenBr in this-procedure ( input yes, input no, input no).
     3780         if sort-labelbr-clobs <> "" then do:
     3781           assign
     3782             cur-clmnbr-clobs:column-fgcolor = 0
     3783           .
     3784         end.
     3785         assign
     3786           cur-clmn-locbr-clobs = ?
     3787         .
     3788       end.
     3789     end case.
     3790     if p-recid <> ? then do:
     3791       reposition br-clobs to recid p-recid no-error.
     3792       apply "value-changed" to br-clobs in frame Dialog-Frame.
     3793     end.
     3794     apply "entry" to br-clobs in frame Dialog-Frame.
     3795   END PROCEDURE.
     3796   procedure re-open-query-srt-clmnbr-clobs:
     3797   if cur-clmnbr-clobs = ? then do:
     3798      run OpenBr in this-procedure ( input yes, input no, input no).
     3799   end.
     3800   else do:
     3801      assign re-querybr-clobs = yes.
     3802      run sort-brbr-clobs
     3803        (input (if available X_clob-bind
     3804                then recid(X_clob-bind)
     3805                else ?
     3806               )
     3807        ).
     3808      assign re-querybr-clobs = no.
     3809   end.
     3810   end.
     3811   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3812   do:
     3813     br-clobs :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3814   end.
     3815   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3816   on f5 of frame Dialog-Frame anywhere
     3817   do:
     3818      if available X_clob-bind then v-rec = recid(X_clob-bind). Run openbr in this-procedure  ( input yes, input no, input '':U).
     3819       apply "VALUE-CHANGED" to br-clobs.
     3820   end.
     3821   MAIN-BLOCK:
     3822   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3823      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3824   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3825     run mainmenu_getcntxt in parparentproc
     3826       (output v-cntxt-db-num
     3827       ,output v-cntxt-userid
     3828       ,output v-cntxt-level
     3829       ,output v-cntxt-host-code-obj
     3830       ,output v-cntxt-obj-type
     3831       ,output v-cntxt-obj-code
     3832       ,output v-cntxt-db-num-obj
     3833       ,output v-cntxt-is-admin
     3834       ) .
     3835      if lookup(p-resource-type, 'report':U + chr(44) +
     3836                               'report-xml':U + chr(44) +
     3837                               'list':U + chr(44) +
     3838                               'list-macro':U
     3839                               ) = 0 then do:
     3840       message
     3841       substitute("Неверный тип параметра p-resource-type=&1", p-resource-type)
     3842       view-as alert-box error.
     3843       undo main-block, return error.
     3844     end.
     3845     if lookup(p-uniq-key-rec , "gds-list,cli-list,dc-list,obj-list,,") = 0 then do:
     3846       message
     3847       substitute("Неверный тип параметра p-uniq-key-rec=&1", p-uniq-key-rec)
     3848       view-as alert-box error.
     3849       undo main-block, return error.
     3850     end.
     3851      if lookup(p-resource-type, 'report':U + chr(44) +
     3852                               'report-xml':U
     3853                               ) > 0
     3854      and p-uniq-key-rec >  ""
     3855      then do:
     3856       message
     3857       substitute("Неверный тип параметра p-resource-type=&1 или p-uniq-key-rec=&2"
     3858                , p-resource-type
     3859                , p-uniq-key-rec)
     3860       view-as alert-box error.
     3861       undo main-block, return error.
     3862     end.
     3863     if lookup(p-uniq-key-rec, "gds-list,cli-list,dc-list,obj-list") = 0
     3864     and p-mode <> ''
     3865     then do:
     3866       message
     3867       substitute("Неверный тип параметра p-mode=&1 или p-uniq-key-rec=&2"
     3868                , p-mode
     3869                , p-uniq-key-rec)
     3870       view-as alert-box error.
     3871       undo main-block, return error.
     3872     end.
     3873     if lookup(p-uniq-key-rec, "gds-list,cli-list,dc-list,obj-list") > 0
     3874     and not (p-mode = '' or p-mode = 'ИЗМЕНЕНИЕ':U)
     3875     then do:
     3876       message
     3877       substitute("Неверный тип параметра p-mode=&1 или p-uniq-key-rec=&2"
     3878                , p-mode
     3879                , p-uniq-key-rec)
     3880       view-as alert-box error.
     3881       undo main-block, return error.
     3882     end.
     3883     v-rid-list = p-rid-list.
     3884     if p-rid-list <> '' then do:
     3885     end.
     3886     v-rec = integer(entry(1, p-rid-list)).
     3887     if lookup("managed", bttns) > 0 then do:
     3888       v-list-proc-handle = ?.
     3889     end.
     3890     else do:
     3891       v-list-proc-handle = p-parent-handle.
     3892     end.
     3893     RUN Myenable.
     3894     WAIT-FOR GO OF FRAME Dialog-Frame.
     3895   END.
     3896   RUN disable_UI.
     3897   PROCEDURE disable_UI :
     3898     HIDE FRAME Dialog-Frame.
     3899   END PROCEDURE.
     3900   PROCEDURE enable_UI :
     3901     DISPLAY mark-num E-descr
     3902         WITH FRAME Dialog-Frame.
     3903     ENABLE b-quit B-mark b-sel b-add b-chg b-lkp b-del b-send B-sch B-Help
     3904            mark-num br-clobs E-descr
     3905         WITH FRAME Dialog-Frame.
     3906     VIEW FRAME Dialog-Frame.
     3907   END PROCEDURE.
     3908   PROCEDURE MyEnable :
     3909   define variable v-res-title as character no-undo.
     3910   define variable v-mode-title as character no-undo.
     3911   define variable v-db-title as character no-undo.
     3912   case p-resource-type:
     3913     when 'report':U then do:
     3914        assign
     3915        v-res-title = "Хранимые отчеты".
     3916     end.
     3917     when 'report-xml':U then do:
     3918        assign
     3919        v-res-title  = "Хранимые отчеты-XML".
     3920     end.
     3921     when 'list':U then do:
     3922        assign
     3923        v-res-title  = "Хранимые списки".
     3924     end.
     3925     when 'list-macro':U then do:
     3926        assign
     3927        v-res-title  = "Хранимые макросы формирования списков".
     3928     end.
     3929   end case.
     3930   filter-label = v-res-title.
     3931   filter-label0 = v-res-title .
     3932   case p-list-mode:
     3933      when 'все':U then do:
     3934      end.
     3935      when "uniq-key-rec" then do:
     3936         case p-uniq-key-rec:
     3937            when "gds-list" then do:
     3938               assign
     3939               v-mode-title = "Список товаров".
     3940            end.
     3941            when "cli-list" then do:
     3942               assign
     3943               v-mode-title = "Список клиентов".
     3944            end.
     3945            when "dc-list" then do:
     3946               assign
     3947               v-mode-title = "Список карт".
     3948            end.
     3949            when "obj-list" then do:
     3950               assign
     3951               v-mode-title = "Список объектов".
     3952            end.
     3953         end.
     3954      end.
     3955   end case.
     3956   case p-db-num:
     3957      when -1 then do:
     3958        v-db-title = "".
     3959      end.
     3960      otherwise do:
     3961         v-db-title = substitute("БД &1", p-db-num).
     3962      end.
     3963   end case.
     3964   assign
     3965   frame Dialog-Frame:title = substitute("&1, &2&3 &4"
     3966                                        , v-res-title
     3967                                        , v-mode-title
     3968                                        , (if v-db-title = '' then '' else chr(44))
     3969                                        , v-db-title).
     3970   assign
     3971   b-del:menu-mouse in frame Dialog-Frame  = 1
     3972   E-descr:read-only in frame Dialog-Frame = yes
     3973   X_clob-bind.uniq-key-rec:visible in browse br-clobs = (if ((p-resource-type = 'list':U
     3974                                                          or p-resource-type = 'list-macro':U)
     3975                                                             and p-uniq-key-rec <> '')
     3976                                                          then no else yes)
     3977   X_clob-bind.descr:read-only in browse br-clobs = yes
     3978   X_clob-bind.descr:resizable in browse br-clobs = yes
     3979   X_clob-bind.field-name_:resizable in browse br-clobs = yes
     3980   b-chg:menu-mouse in frame Dialog-Frame = 1
     3981   menu-item m_descr:sensitive in menu menu-b-chg = (not (p-resource-type = 'report':U or p-resource-type = 'report-xml':U) and not transaction)
     3982   menu-item m_data:sensitive in menu menu-b-chg = (lookup("b-add", bttns ) > 0
     3983                                                    and not (p-resource-type = 'report':U or p-resource-type = 'report-xml':U)
     3984                                                    and not transaction)
     3985   X_clob-bind.uniq-key-rec:width in browse br-clobs = (if p-resource-type = 'list':U
     3986                                                         or p-resource-type = 'list-macro':U
     3987                                                         then 8
     3988                                                         else (X_clob-bind.uniq-key-rec:width in browse br-clobs))
     3989   .
     3990   ENABLE
     3991   b-quit
     3992   b-add when lookup("b-add", bttns ) > 0
     3993                     and not (p-resource-type = 'report':U or p-resource-type = 'report-xml':U
     3994                     and not transaction
     3995                     )
     3996   b-chg when (not (p-resource-type = 'report':U or p-resource-type = 'report-xml':U)
     3997              and not transaction)
     3998   b-del when (lookup("b-add", bttns ) > 0
     3999               and not (p-resource-type = 'report':U or p-resource-type = 'report-xml':U)
     4000               and not transaction)
     4001   b-sel when (lookup("b-sel", bttns) > 0)
     4002   b-mark when (lookup("b-mark", bttns) > 0
     4003                and not transaction)
     4004   b-lkp
     4005   b-sch
     4006   B-Help
     4007   b-send when   not (p-resource-type = 'report':U or p-resource-type = 'report-xml':U
     4008                and lookup("b-add", bttns ) > 0
     4009                and not transaction
     4010                 )
     4011   br-clobs
     4012   E-descr
     4013   WITH FRAME Dialog-Frame.
     4014   VIEW FRAME Dialog-Frame.
     4015   Run openbr in this-procedure  ( input yes, input no, input '':U).
     4016   apply "value-changed" to br-clobs.
     4017   END PROCEDURE.
     4018   PROCEDURE OpenBr :
     4019   define input  parameter p-open-query     as logical   no-undo .
     4020   define input  parameter p-find-next      as logical   no-undo .
     4021   define input  parameter p-find-condition as character no-undo .
     4022   define variable l-query-was-opened as logical no-undo .
     4023   define variable sort-column-phrase as character no-undo .
     4024   case sort-column-name :
     4025     when "" then do:
     4026       assign
     4027         sort-column-phrase = ""
     4028       .
     4029     end.
     4030     otherwise do:
     4031       assign
     4032         sort-column-phrase = "by " + sort-column-name
     4033       .
     4034     end.
     4035   end case.
     4036   filter-point = filter-point0 + p-resource-type.
     4037   CASE p-list-mode:
     4038     when 'все':U then do:
     4039   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4040   define variable  l-disable-where-33  as logical   no-undo .
     4041   define variable  l-filter-open-33    as logical   .
     4042   define variable  flt-rec-33       as recid     no-undo .
     4043   define variable  filter-name-33      as character no-undo .
     4044   define variable  where-phrase-33     as character no-undo .
     4045   define variable  sort-phrase-33      as character no-undo .
     4046   define variable  where-phrase-rus-33 as character no-undo .
     4047   define variable  sort-phrase-rus-33  as character no-undo .
     4048     run waitfram-show in this-procedure
     4049       (input "ЖДИТЕ ..."
     4050       ).
     4051   run gbl/flt-get.p
     4052     (input filter-point
     4053     ,output flt-rec-33
     4054     ,output filter-name-33
     4055     ,output where-phrase-33
     4056     ,output sort-phrase-33
     4057     ,output where-phrase-rus-33
     4058     ,output sort-phrase-rus-33
     4059     ).
     4060       run set-filter-name in this-procedure
     4061         (INPUT filter-name-33
     4062         ) no-error .
     4063     assign
     4064       l-filter-open-33 = false
     4065     .
     4066     if flt-rec-33 <> ?
     4067       or sort-column-phrase > ""
     4068     then do:
     4069       define variable  parameter-2-33 as character no-undo .
     4070       define variable  parameter-3-33 as character no-undo .
     4071       define variable  parameter-4-33 as character no-undo .
     4072       define variable  parameter-5-33 as character no-undo .
     4073       define variable  parameter-6-33 as character no-undo .
     4074       define variable  parameter-7-33 as character no-undo .
     4075         assign
     4076         parameter-3-33 =
     4077                                 "FOR EACH X_clob-bind no-lock"
     4078         parameter-4-33 =
     4079           (
     4080             if (" X_clob-bind.resource-type = p-resource-type and                       (p-db-num = -1 or X_clob-bind.db-num = p-db-num) " + " " + where-phrase-33) <> ""
     4081             then  substitute(' X_clob-bind.resource-type = &1&2&1 and                          ( &3 = -1 or X_clob-bind.db-num = &3)', chr(34), p-resource-type, p-db-num)  + " " + where-phrase-33
     4082             else "true"
     4083           )
     4084         parameter-5-33 = (" " + "" + " " + ", first X_clob-data NO-LOCK where       (X_clob-data.db-num = X_clob-bind.db-num   and X_clob-data.int64-id = X_clob-bind.int64-id )")
     4085         parameter-6-33 = if sort-phrase-33 = ''
     4086                              then
     4087           (
     4088           " " + "  " +
     4089             " " + sort-column-phrase +
     4090           " " + " "
     4091           )
     4092                              else
     4093           (
     4094           " " + "  " +
     4095             " " + sort-column-phrase +
     4096           " " + sort-phrase-33
     4097           )
     4098         parameter-7-33 =
     4099           "   "
     4100       .
     4101       do
     4102       on stop undo, leave
     4103       on error undo, leave
     4104       :
     4105         assign
     4106           l-disable-where-33 =
     4107             (" X_clob-bind.resource-type = p-resource-type and                       (p-db-num = -1 or X_clob-bind.db-num = p-db-num) " + " " + where-phrase-33 = "")
     4108         .
     4109         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4110                             ,input query br-clobs:handle
     4111                             ,input parameter-3-33
     4112                             ,input parameter-4-33
     4113                             ,input parameter-5-33
     4114                             ,input parameter-6-33
     4115                             ,input parameter-7-33
     4116                             )
     4117         .
     4118         assign
     4119           l-filter-open-33 = true
     4120         .
     4121       end.
     4122       if l-filter-open-33 = false then do:
     4123         message
     4124           "Ошибка при фильтрации / сортировке" skip
     4125           "Будут показаны записи без учета фильтра" skip
     4126           view-as alert-box .
     4127       end.
     4128       else do:
     4129           assign
     4130             l-query-was-opened = true
     4131           .
     4132       end.
     4133     end.
     4134     if l-filter-open-33 = false then do:
     4135       OPEN QUERY br-clobs FOR EACH X_clob-bind no-lock
     4136         where  X_clob-bind.resource-type = p-resource-type and                       (p-db-num = -1 or X_clob-bind.db-num = p-db-num)
     4137       , first X_clob-data NO-LOCK where       (X_clob-data.db-num = X_clob-bind.db-num   and X_clob-data.int64-id = X_clob-bind.int64-id )
     4138     .
     4139         assign
     4140           l-query-was-opened = true
     4141         .
     4142     end.
     4143     run waitfram-hide in this-procedure .
     4144     END.
     4145     when "uniq-key-rec" then do:
     4146   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4147   define variable  l-disable-where-35  as logical   no-undo .
     4148   define variable  l-filter-open-35    as logical   .
     4149   define variable  flt-rec-35       as recid     no-undo .
     4150   define variable  filter-name-35      as character no-undo .
     4151   define variable  where-phrase-35     as character no-undo .
     4152   define variable  sort-phrase-35      as character no-undo .
     4153   define variable  where-phrase-rus-35 as character no-undo .
     4154   define variable  sort-phrase-rus-35  as character no-undo .
     4155     run waitfram-show in this-procedure
     4156       (input "ЖДИТЕ ..."
     4157       ).
     4158   run gbl/flt-get.p
     4159     (input filter-point
     4160     ,output flt-rec-35
     4161     ,output filter-name-35
     4162     ,output where-phrase-35
     4163     ,output sort-phrase-35
     4164     ,output where-phrase-rus-35
     4165     ,output sort-phrase-rus-35
     4166     ).
     4167       run set-filter-name in this-procedure
     4168         (INPUT filter-name-35
     4169         ) no-error .
     4170     assign
     4171       l-filter-open-35 = false
     4172     .
     4173     if flt-rec-35 <> ?
     4174       or sort-column-phrase > ""
     4175     then do:
     4176       define variable  parameter-2-35 as character no-undo .
     4177       define variable  parameter-3-35 as character no-undo .
     4178       define variable  parameter-4-35 as character no-undo .
     4179       define variable  parameter-5-35 as character no-undo .
     4180       define variable  parameter-6-35 as character no-undo .
     4181       define variable  parameter-7-35 as character no-undo .
     4182         assign
     4183         parameter-3-35 =
     4184                                 "FOR EACH X_clob-bind no-lock"
     4185         parameter-4-35 =
     4186           (
     4187             if (" X_clob-bind.resource-type = p-resource-type and                     X_clob-bind.uniq-key-rec = p-uniq-key-rec and       (p-db-num = -1 or X_clob-bind.db-num = p-db-num)  " + " " + where-phrase-35) <> ""
     4188             then  substitute(' X_clob-bind.resource-type = &1&2&1 and                                       X_clob-bind.uniq-key-rec = &1&3&1 and       (&4 = -1 or X_clob-bind.db-num = &4)', chr(34), p-resource-type, p-uniq-key-rec, p-db-num)  + " " + where-phrase-35
     4189             else "true"
     4190           )
     4191         parameter-5-35 = (" " + "" + " " + ", first X_clob-data NO-LOCK where       (X_clob-data.db-num = X_clob-bind.db-num   and X_clob-data.int64-id = X_clob-bind.int64-id )")
     4192         parameter-6-35 = if sort-phrase-35 = ''
     4193                              then
     4194           (
     4195           " " + "  " +
     4196             " " + sort-column-phrase +
     4197           " " + "  "
     4198           )
     4199                              else
     4200           (
     4201           " " + "  " +
     4202             " " + sort-column-phrase +
     4203           " " + sort-phrase-35
     4204           )
     4205         parameter-7-35 =
     4206           "   "
     4207       .
     4208       do
     4209       on stop undo, leave
     4210       on error undo, leave
     4211       :
     4212         assign
     4213           l-disable-where-35 =
     4214             (" X_clob-bind.resource-type = p-resource-type and                     X_clob-bind.uniq-key-rec = p-uniq-key-rec and       (p-db-num = -1 or X_clob-bind.db-num = p-db-num)  " + " " + where-phrase-35 = "")
     4215         .
     4216         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4217                             ,input query br-clobs:handle
     4218                             ,input parameter-3-35
     4219                             ,input parameter-4-35
     4220                             ,input parameter-5-35
     4221                             ,input parameter-6-35
     4222                             ,input parameter-7-35
     4223                             )
     4224         .
     4225         assign
     4226           l-filter-open-35 = true
     4227         .
     4228       end.
     4229       if l-filter-open-35 = false then do:
     4230         message
     4231           "Ошибка при фильтрации / сортировке" skip
     4232           "Будут показаны записи без учета фильтра" skip
     4233           view-as alert-box .
     4234       end.
     4235       else do:
     4236           assign
     4237             l-query-was-opened = true
     4238           .
     4239       end.
     4240     end.
     4241     if l-filter-open-35 = false then do:
     4242       OPEN QUERY br-clobs FOR EACH X_clob-bind no-lock
     4243         where  X_clob-bind.resource-type = p-resource-type and                     X_clob-bind.uniq-key-rec = p-uniq-key-rec and       (p-db-num = -1 or X_clob-bind.db-num = p-db-num)
     4244       , first X_clob-data NO-LOCK where       (X_clob-data.db-num = X_clob-bind.db-num   and X_clob-data.int64-id = X_clob-bind.int64-id )
     4245     .
     4246         assign
     4247           l-query-was-opened = true
     4248         .
     4249     end.
     4250     run waitfram-hide in this-procedure .
     4251     END.
     4252   END CASE.
     4253   apply "entry" to br-clobs in frame Dialog-Frame.
     4254   if v-rec <> ? then reposition br-clobs to recid v-rec no-error.
     4255   if error-status:error then do:
     4256     reposition br-clobs to row 1 no-error.
     4257   end.
     4258   run waitfram-hide in this-procedure .
     4259   if avail X_clob-data then
     4260   APPLY "VALUE-CHANGED":U to br-clobs.
     4261   END PROCEDURE.
     4262   PROCEDURE clobbnds_add :
     4263   define input parameter p-list-handle as handle no-undo .
     4264   define input parameter p-resource-type as character no-undo .
     4265   define input parameter p-list-type as character no-undo .
     4266   define variable v-part-num as integer   no-undo .
     4267   define variable v-clob-db-num as integer   no-undo init ?.
     4268   define variable v-int64-id as int64 no-undo .
     4269   define variable v-descr                   as character                no-undo .
     4270   define variable v-path                    as character                no-undo .
     4271   DEFINE VARIABLE v-full-path               as character                no-undo .
     4272   DEFINE VARIABLE v-file-name               as character                no-undo .
     4273   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     4274   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     4275   define buffer buf_clob-bind for ub.clob-bind.
     4276   run gbl/d-prompt.w (
     4277       'title=':u + "Добавление списка/макроса" + '\':u
     4278     + 'text1=':u + "Введите описание" + '\':u
     4279     + 'format=X(90)\':u
     4280     + 'type=char\':u
     4281     + 'fillin_row=1\':u
     4282     + 'fillin_col=1\':u
     4283     + 'fillin_width=92\':u
     4284     + 'fillin_height=1\':u
     4285     + 'max-chars=90\':u
     4286     ,input-output v-descr
     4287     ).
     4288   if return-value = 'false':u
     4289   then do:
     4290     return 'quit'.
     4291   end.
     4292   run gbl/_tmpfile.p ( input ""
     4293                       ,input "tmp"
     4294                       ,output v-file-name) .
     4295   output to value(v-file-name).
     4296   put 1 skip.
     4297   output close.
     4298   run gbl/filename.p (
     4299                 input v-file-name
     4300                 ,output v-full-path
     4301                 ,output v-path
     4302                 ,output v-file-name
     4303                 ,output v-file-name-no-ext
     4304                 ,output v-file-name-ext
     4305                 ) no-error .
     4306   if error-status:error then do:
     4307     undo, return error .
     4308   end.
     4309   if p-list-handle = ? then do:
     4310     p-list-handle = p-parent-handle.
     4311   end.
     4312   case p-resource-type:
     4313     when 'list':U then do:
     4314       run cb_fill-lob-res-list in p-list-handle ( input v-full-path) no-error.
     4315     end.
     4316     when 'list-macro':U then do:
     4317       run cb_fill-lob-res-list-macro in p-list-handle ( input v-full-path) no-error.
     4318     end.
     4319   end case.
     4320   if error-status:error then do:
     4321     os-delete value(v-full-path) no-error.
     4322     return no-apply.
     4323   end.
     4324   run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     4325                       ,input ",no"
     4326                       ,input ?
     4327                       ,input p-list-type
     4328                       ,input '':U
     4329                       ,input v-descr
     4330                       ,input-output v-part-num
     4331                       ,input p-resource-type
     4332                       ,input-output v-clob-db-num
     4333                       ,input-output v-int64-id
     4334                       ,input v-full-path
     4335                       ,input ?
     4336                       ) no-error .
     4337   if error-status:error then do:
     4338     message error-status :error  skip
     4339     return-value
     4340     view-as alert-box error .
     4341     undo, return error  .
     4342   end.
     4343   v-start = no.
     4344   find first buf_clob-bind no-lock where
     4345             buf_clob-bind.db-num = v-clob-db-num
     4346         and buf_clob-bind.int64-id = v-int64-id no-error.
     4347   if available buf_clob-bind then do:
     4348     v-rec = recid(buf_clob-bind).
     4349   end.
     4350   run OpenBr in this-procedure  ( input yes, input no, input '':U).
     4351   apply "value-changed" to br-clobs in frame Dialog-Frame .
     4352   END PROCEDURE.
     4353   PROCEDURE proc-b-chg :
     4354   define input parameter p-chg-option as character no-undo.
     4355   define variable v-part-num as integer   no-undo .
     4356   define variable v-clob-db-num as integer   no-undo .
     4357   define variable v-int64-id as int64 no-undo .
     4358   define variable v-old-clob-db-num as integer   no-undo .
     4359   define variable v-old-int64-id as int64 no-undo .
     4360   define variable lns-cnt as integer no-undo .
     4361   define variable line-rec as recid no-undo .
     4362   define variable v-longchar as longchar no-undo.
     4363   define variable v-str as character no-undo.
     4364   define variable v-prod-type like ub.goods.prod-type.
     4365   define variable v-prod-code like ub.goods.prod-code.
     4366   define variable v-artic     like ub.goods.artic.
     4367   define variable v-obj-type  like ub.clients.obj-type.
     4368   define variable v-obj-code  like ub.clients.obj-code.
     4369   define variable v-cli-type  like ub.clients.obj-type.
     4370   define variable v-cli-code  like ub.clients.obj-code.
     4371   define variable v-d-card    like ub.dis-card.d-card.
     4372   define variable v-descr as character no-undo .
     4373   define variable v-file-name0 as character no-undo .
     4374   define variable v-ok as logical   no-undo .
     4375   define variable v-path                    as character                no-undo .
     4376   DEFINE VARIABLE v-full-path               as character                no-undo .
     4377   DEFINE VARIABLE v-file-name               as character                no-undo .
     4378   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     4379   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     4380   define buffer buf_clob-data for ub.clob-data.
     4381   define buffer buf_clob-bind for ub.clob-bind.
     4382   define buffer buf_goods for ub.goods.
     4383   assign
     4384   v-old-clob-db-num = X_clob-bind.db-num
     4385   v-old-int64-id = X_clob-bind.int64-id
     4386   v-clob-db-num = X_clob-bind.db-num
     4387   v-int64-id = X_clob-bind.int64-id
     4388   v-part-num = X_clob-bind.part-num
     4389   v-descr = X_clob-bind.descr
     4390   v-rec = recid(X_clob-bind)
     4391   .
     4392   if (g#db-num > 0 and X_clob-bind.db-num <> g#db-num)
     4393   or (g#db-num = 0 and X_clob-bind.db-num > 0 and can-find( first ub.db where ub.db.db-num = X_clob-bind.db-num))
     4394   then do:
     4395     message
     4396     "Нельзя изменить список или отчет, созданный в другой БД!"
     4397     view-as alert-box error  .
     4398     undo, return error .
     4399   end.
     4400   find first buf_clob-data share-lock where
     4401             buf_clob-data.db-num = X_clob-bind.db-num
     4402         and buf_clob-data.int64-id = X_clob-bind.int64-id .
     4403   if buf_clob-data.crc-field = '' then do:
     4404       message
     4405       "В настоящий момент работает распределенная команда УДАЛЕНИЯ данного файла" skip
     4406       "Изменение невозможно"
     4407       view-as alert-box error .
     4408       undo, return error .
     4409   end.
     4410   case p-chg-option:
     4411   when "descr" then do:
     4412       run gbl/d-prompt.w (
     4413           'title=':u + "Изменение описания списка макроса" + '\':u
     4414         + 'text1=':u + "Можете изменить описание" + '\':u
     4415         + 'format=X(90)\':u
     4416         + 'type=char\':u
     4417         + 'fillin_row=1\':u
     4418         + 'fillin_col=1\':u
     4419         + 'fillin_width=92\':u
     4420         + 'fillin_height=1\':u
     4421         + 'max-chars=90\':u
     4422         ,input-output v-descr
     4423         ).
     4424       if return-value = 'false':u
     4425       then do:
     4426         return 'quit'.
     4427       end.
     4428       find first buf_clob-bind where
     4429                   recid(buf_clob-bind) = recid(X_clob-bind).
     4430       assign
     4431       buf_clob-bind.descr = v-descr.
     4432       release buf_clob-bind.
     4433   end.
     4434   when "data" then do:
     4435       define variable v-list-type as character no-undo .
     4436       if p-uniq-key-rec = '' then do:
     4437         v-list-type = X_clob-bind.uniq-key-rec.
     4438       end.
     4439       else do:
     4440         v-list-type = p-uniq-key-rec.
     4441       end.
     4442       v-longchar = X_clob-data.cdata.
     4443       if lookup("managed", bttns) > 0 then do:
     4444         case v-list-type:
     4445           when "gds-list" then do:
     4446             run gbl/_tmpfile.p ( input ""
     4447                                 ,input "txt"
     4448                                 ,output v-file-name) .
     4449             output to value(v-file-name).
     4450             put 1 skip.
     4451             output close.
     4452             run gbl/filename.p (
     4453                           input v-file-name
     4454                           ,output v-full-path
     4455                           ,output v-path
     4456                           ,output v-file-name
     4457                           ,output v-file-name-no-ext
     4458                           ,output v-file-name-ext
     4459                           ) no-error .
     4460             if error-status:error then do:
     4461               undo, return error .
     4462             end.
     4463             copy-lob
     4464             FROM object v-longchar
     4465             to FILE v-full-path
     4466             no-convert
     4467             NO-ERROR.
     4468             input from value(v-full-path) .
     4469               repeat :
     4470                 import  v-prod-type v-prod-code v-artic   .
     4471                 find buf_goods where buf_goods.prod-type = v-prod-type
     4472                                   and buf_goods.prod-code = v-prod-code
     4473                                   and buf_goods.artic     = v-artic no-error.
     4474                 if available buf_goods then do :
     4475   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4476   find gds-list
     4477     where gds-list.prod-type = buf_goods.prod-type
     4478       and gds-list.prod-code = buf_goods.prod-code
     4479       and gds-list.artic     = buf_goods.artic
     4480     no-error .
     4481   if available gds-list then do:
     4482     assign
     4483       gds-list.to-del = no
     4484     .
     4485   end.
     4486   else do:
     4487     define variable v-last36 as integer no-undo .
     4488     find last gds-list use-index oi no-error.
     4489     if available gds-list then do:
     4490       v-last36 = gds-list.order-num .
     4491     end.
     4492     else do:
     4493       v-last36 = 0 .
     4494     end.
     4495     create gds-list .
     4496     buffer-copy buf_goods to gds-list
     4497     assign
     4498       gds-list.to-del = no
     4499       gds-list.order-num = v-last36 + 1
     4500     .
     4501     assign
     4502       lns-cnt = lns-cnt + 1
     4503       line-rec = recid (gds-list)
     4504     .
     4505   end.
     4506                 end.
     4507               end.
     4508             input close.
     4509             os-delete value(v-full-path).
     4510             run str/gdslistp.w ( input parparentproc
     4511                                 ,input this-procedure:handle
     4512                                 ,input v-cntxt-host-code-obj
     4513                                 ,input v-cntxt-obj-type
     4514                                 ,input v-cntxt-obj-code
     4515                                 ,input p-resource-type + chr(44) + "clobbnds_chg"
     4516                                 ,input "HH"
     4517                                 ,input no).
     4518             for each gds-list :
     4519               delete gds-list.
     4520             end.
     4521           end.
     4522           when "cli-list" then do:
     4523             run gbl/_tmpfile.p ( input ""
     4524                                 ,input "txt"
     4525                                 ,output v-file-name) .
     4526             output to value(v-file-name).
     4527             put 1 skip.
     4528             output close.
     4529             run gbl/filename.p (
     4530                           input v-file-name
     4531                           ,output v-full-path
     4532                           ,output v-path
     4533                           ,output v-file-name
     4534                           ,output v-file-name-no-ext
     4535                           ,output v-file-name-ext
     4536                           ) no-error .
     4537             if error-status:error then do:
     4538               undo, return error .
     4539             end.
     4540             copy-lob
     4541             FROM object v-longchar
     4542             to FILE v-full-path
     4543             no-convert
     4544             NO-ERROR.
     4545             input from value(v-full-path) .
     4546               repeat :
     4547                 import  v-obj-type v-obj-code .
     4548                 find clients where clients.obj-type = v-obj-type
     4549                                and clients.obj-code = v-obj-code no-lock.
     4550                 if available clients then do :
     4551   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4552   find cli-list
     4553     where cli-list.obj-type = clients.obj-type
     4554       and cli-list.obj-code = clients.obj-code
     4555     no-error .
     4556   if available cli-list then do:
     4557     assign
     4558       cli-list.to-del = no
     4559     .
     4560   end.
     4561   else do:
     4562     create cli-list .
     4563     buffer-copy clients to cli-list
     4564     assign
     4565       cli-list.to-del = no
     4566     .
     4567     assign
     4568       lns-cnt = lns-cnt + 1
     4569       line-rec = recid (cli-list)
     4570     .
     4571   end.
     4572                 end.
     4573               end.
     4574             input close.
     4575             os-delete value(v-full-path).
     4576             run str/clilistp.w ( input parparentproc
     4577                                 ,input this-procedure:handle
     4578                                 ,input v-cntxt-host-code-obj
     4579                                 ,input v-cntxt-obj-type
     4580                                 ,input v-cntxt-obj-code
     4581                                 ,input p-resource-type + chr(44) + "clobbnds_chg"
     4582                                 ,input "HH"
     4583                                 ,input no).
     4584             for each cli-list :
     4585               delete cli-list.
     4586             end.
     4587           end.
     4588           when "dc-list" then do:
     4589             run gbl/_tmpfile.p ( input ""
     4590                                 ,input "txt"
     4591                                 ,output v-file-name) .
     4592             output to value(v-file-name).
     4593             put 1 skip.
     4594             output close.
     4595             run gbl/filename.p (
     4596                           input v-file-name
     4597                           ,output v-full-path
     4598                           ,output v-path
     4599                           ,output v-file-name
     4600                           ,output v-file-name-no-ext
     4601                           ,output v-file-name-ext
     4602                           ) no-error .
     4603             if error-status:error then do:
     4604               undo, return error .
     4605             end.
     4606             copy-lob
     4607             FROM object v-longchar
     4608             to FILE v-full-path
     4609             no-convert
     4610             NO-ERROR.
     4611             input from value(v-full-path) .
     4612               repeat :
     4613                 import  v-d-card v-cli-type v-cli-code .
     4614                 find dis-card where dis-card.d-card   = v-d-card
     4615                                 and dis-card.cli-type = v-cli-type
     4616                                 and dis-card.cli-code = v-cli-code no-lock.
     4617                 if available dis-card then do :
     4618   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4619   find dc-list
     4620     where dc-list.d-card = dis-card.d-card
     4621     no-error .
     4622   if available dc-list then do:
     4623     assign
     4624       dc-list.to-del = no
     4625     .
     4626   end.
     4627   else do:
     4628     create dc-list .
     4629     buffer-copy dis-card to dc-list
     4630     assign
     4631       dc-list.to-del = no
     4632     .
     4633     assign
     4634       lns-cnt = lns-cnt + 1
     4635       line-rec = recid (dc-list)
     4636     .
     4637   end.
     4638                 end.
     4639               end.
     4640             input close.
     4641             os-delete value(v-full-path).
     4642             run str/dc-listp.w ( input parparentproc
     4643                                 ,input this-procedure:handle
     4644                                 ,input v-cntxt-host-code-obj
     4645                                 ,input v-cntxt-obj-type
     4646                                 ,input v-cntxt-obj-code
     4647                                 ,input p-resource-type + chr(44) + "clobbnds_chg"
     4648                                 ,input "HH"
     4649                                 ,input no).
     4650             for each dc-list :
     4651               delete dc-list.
     4652             end.
     4653           end.
     4654         end case.
     4655       end.
     4656       else do:
     4657         run clobbnds_chg in this-procedure ( input ?).
     4658       end.
     4659     end.
     4660   end case.
     4661   v-longchar = '':U.
     4662   run OpenBr in this-procedure  ( input yes, input no, input '':U).
     4663   apply "value-changed" to br-clobs in frame Dialog-Frame .
     4664   END PROCEDURE.
     4665   PROCEDURE clobbnds_chg :
     4666   define input parameter p-list-handle as handle no-undo .
     4667   define variable v-part-num as integer   no-undo .
     4668   define variable v-clob-db-num as integer   no-undo .
     4669   define variable v-int64-id as int64 no-undo .
     4670   define variable v-old-clob-db-num as integer   no-undo .
     4671   define variable v-old-int64-id as int64 no-undo .
     4672   define variable v-descr as character no-undo .
     4673   define variable v-file-name0 as character no-undo .
     4674   define variable v-ok as logical   no-undo .
     4675   define variable v-path                    as character                no-undo .
     4676   DEFINE VARIABLE v-full-path               as character                no-undo .
     4677   DEFINE VARIABLE v-file-name               as character                no-undo .
     4678   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     4679   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     4680   define buffer buf_clob-data for ub.clob-data.
     4681   define buffer buf_clob-bind for ub.clob-bind.
     4682   assign
     4683   v-old-clob-db-num = X_clob-bind.db-num
     4684   v-old-int64-id = X_clob-bind.int64-id
     4685   v-clob-db-num = X_clob-bind.db-num
     4686   v-int64-id = X_clob-bind.int64-id
     4687   v-part-num = X_clob-bind.part-num
     4688   v-descr = X_clob-bind.descr
     4689   v-rec = recid(X_clob-bind)
     4690   .
     4691       run gbl/_tmpfile.p ( input ""
     4692                           ,input "tmp"
     4693                           ,output v-file-name) .
     4694       output to value(v-file-name).
     4695       put 1 skip.
     4696       output close.
     4697       run gbl/filename.p (
     4698                     input v-file-name
     4699                     ,output v-full-path
     4700                     ,output v-path
     4701                     ,output v-file-name
     4702                     ,output v-file-name-no-ext
     4703                     ,output v-file-name-ext
     4704                     ) no-error .
     4705       if error-status:error then do:
     4706         undo, return error .
     4707       end.
     4708   if p-list-handle = ? then do:
     4709     p-list-handle = p-parent-handle.
     4710   end.
     4711       case p-resource-type:
     4712         when 'list':U then do:
     4713       run cb_fill-lob-res-list in p-list-handle ( input v-full-path) no-error.
     4714         end.
     4715         when 'list-macro':U then do:
     4716       run cb_fill-lob-res-list-macro in p-list-handle ( input v-full-path) no-error.
     4717         end.
     4718       end case.
     4719       if error-status:error then do:
     4720         os-delete value(v-full-path) no-error.
     4721         return no-apply.
     4722       end.
     4723       run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
     4724                           ,input "add-new,no"
     4725                           ,input ?
     4726                       ,input X_clob-bind.uniq-key-rec
     4727                           ,input X_clob-bind.field-name_
     4728                           ,input v-descr
     4729                           ,input-output v-part-num
     4730                           ,input p-resource-type
     4731                           ,input-output v-clob-db-num
     4732                           ,input-output v-int64-id
     4733                           ,input v-full-path
     4734                           ,input ?
     4735                           ) no-error .
     4736       if error-status:error then do:
     4737         message error-status :error  skip
     4738         return-value
     4739         view-as alert-box error .
     4740         undo, return error  .
     4741       end.
     4742       find first buf_clob-data no-lock where
     4743                 buf_clob-data.db-num = v-old-clob-db-num
     4744             and buf_clob-data.int64-id = v-old-int64-id no-error.
     4745       if available buf_clob-data then do:
     4746         run clbdattd_two-commit-del in this-procedure ( buffer buf_clob-data, input 1) no-error.
     4747         if error-status :error then do:
     4748           undo , return error substitute("Ошибка при попытке запустить удаление неиспользуемых clob-data &1 (&2&3)(2)&4&5&4&6"
     4749                                                     ,buf_clob-data.file-name_
     4750                                                     ,buf_clob-data.db-num
     4751                                                     ,buf_clob-data.int64-id
     4752                                                     ,chr(10)
     4753                                                     , error-status:get-message(1)
     4754                                                     , return-value ).
     4755         end.
     4756       end.
     4757       v-start = no.
     4758   END PROCEDURE.
     4759   PROCEDURE proc-b-del :
     4760   define variable v-clob-db-num as integer   no-undo .
     4761   define variable v-int64-id as int64 no-undo .
     4762   define variable v-part-num as integer   no-undo .
     4763   define buffer buf_clob-data for ub.clob-data.
     4764   if (g#db-num > 0 and X_clob-bind.db-num <> g#db-num)
     4765   or (g#db-num = 0 and X_clob-bind.db-num > 0 and can-find( first ub.db where ub.db.db-num = X_clob-bind.db-num))
     4766   then do:
     4767     message
     4768     "Нельзя удалить список или отчет, созданный в другой БД!"
     4769     view-as alert-box error
     4770     .
     4771     undo, return error .
     4772   end.
     4773   find first buf_clob-data share-lock where
     4774           buf_clob-data.db-num = X_clob-bind.db-num
     4775       and buf_clob-data.int64-id = X_clob-bind.int64-id no-error.
     4776   if buf_clob-data.crc-field = '' then do:
     4777     message
     4778     "В настоящий момент УЖЕ работает распределенная команда УДАЛЕНИЯ данного файла" skip
     4779     view-as alert-box error .
     4780     undo, return error .
     4781   end.
     4782   assign
     4783   v-clob-db-num = X_clob-bind.db-num
     4784   v-int64-id = X_clob-bind.int64-id
     4785   v-part-num = X_clob-bind.part-num
     4786   .
     4787   run gbl/file2clb.p ( input 'удаление':U
     4788                       ,input "delete"
     4789                       ,input ?
     4790                       ,input X_clob-bind.uniq-key-rec
     4791                       ,input X_clob-bind.field-name
     4792                       ,input '':U
     4793                       ,input-output v-part-num
     4794                       ,input p-resource-type
     4795                       ,input-output v-clob-db-num
     4796                       ,input-output v-int64-id
     4797                       ,input X_clob-bind.uniq-key-rec
     4798                       ,input ?
     4799                       ) no-error .
     4800   if error-status :error then do:
     4801     message
     4802     error-status:get-message(1) skip
     4803     return-value
     4804     view-as alert-box error .
     4805     undo , return error return-value .
     4806   end.
     4807   if available buf_clob-data then do:
     4808     run clbdattd_two-commit-del in this-procedure ( buffer buf_clob-data, input 1) no-error.
     4809     if error-status :error then do:
     4810       undo , return error substitute("Ошибка при попытке запустить удаление неиспользуемых хранимых данных &1 (&2&3)(2)&4&5&4&6"
     4811                                                 ,buf_clob-data.file-name_
     4812                                                 ,buf_clob-data.db-num
     4813                                                 ,buf_clob-data.int64-id
     4814                                                 ,chr(10)
     4815                                                 , error-status:get-message(1)
     4816                                                 , return-value ).
     4817     end.
     4818   end.
     4819   v-rec = ?.
     4820   run OpenBr in this-procedure  ( input yes, input no, input '':U).
     4821   apply "value-changed" to br-clobs in frame Dialog-Frame .
     4822   END PROCEDURE.
     4823   PROCEDURE proc-b-sch :
     4824   assign
     4825   tbl = 'clob-bind'
     4826   join-tbl = 'X_clob-bind'
     4827   fld = ""
     4828   lab = ""
     4829   spr = ""
     4830   dim = '0'
     4831   .
     4832   run fltfield-add in this-procedure('uniq-key-rec', 'Тип', '',
     4833   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4834   run fltfield-add in this-procedure('field-name_', 'ID', '',
     4835   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4836   run fltfield-add in this-procedure('db-num', 'БД', '',
     4837   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4838   run fltfield-add in this-procedure('user-name', 'Создал', 'usr',
     4839   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4840   DO on stop undo, leave:
     4841       run gbl/filter.w ( input parparentproc
     4842                         ,input (filter-point + chr(4) +
     4843                            filter-label  + chr(4) +
     4844                            string(yes))
     4845                         ,input tbl
     4846                         ,input join-tbl
     4847                         ,input fld
     4848                         ,input lab
     4849                         ,input spr
     4850                         ,input dim).
     4851       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4852   END .
     4853   END PROCEDURE.
     4854   PROCEDURE proc-b-send :
     4855   define variable v-old-is-cs as logical no-undo .
     4856   define buffer buf_clob-data for ub.clob-data.
     4857   main-block:
     4858   do transaction:
     4859     find first buf_clob-data share-lock where
     4860               recid(buf_clob-data) = recid(X_clob-data).
     4861       if buf_clob-data.crc-field = '' then do:
     4862         message
     4863         "В настоящий момент работает распределенная команда УДАЛЕНИЯ данного файла" skip
     4864         "Отсылка невозможна"
     4865         view-as alert-box error .
     4866         undo, return error .
     4867       end.
     4868     assign
     4869     v-old-is-cs = buf_clob-data.is-cs
     4870     buf_clob-data.is-cs = yes.
     4871     if v-old-is-cs = no then do:
     4872        run str/callnews.p ( input 'clob-bind':U
     4873                           ,input (buffer X_clob-bind:handle)
     4874                           ) no-error .
     4875       if error-status:error then do:
     4876         if error-status :get-message(1) <> ""
     4877         then do:
     4878           message
     4879             vss-workfile vss-revision vss-description skip
     4880             "Ошибка при вызове callnews.p" skip
     4881             error-status :get-message(1) skip
     4882             return-value skip
     4883             view-as alert-box error .
     4884         end.
     4885         undo,  return error return-value .
     4886       end.
     4887       release buf_clob-data.
     4888       find first buf_clob-data share-lock where
     4889                 recid(buf_clob-data) = recid(X_clob-data).
     4890      run str/callnews.p ( input 'clob-bind':U
     4891                           ,input (buffer X_clob-bind:handle)
     4892                           ) no-error .
     4893       if error-status:error then do:
     4894         if error-status :get-message(1) <> ""
     4895         then do:
     4896           message
     4897             vss-workfile vss-revision vss-description skip
     4898             "Ошибка при вызове callnews.p" skip
     4899             error-status :get-message(1) skip
     4900             return-value skip
     4901             view-as alert-box error .
     4902         end.
     4903         undo main-block,  return error return-value .
     4904       end.
     4905       end.
     4906     br-clobs:refresh() in frame Dialog-Frame .
     4907   end.
     4908   END PROCEDURE.
