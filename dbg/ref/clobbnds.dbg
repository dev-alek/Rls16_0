     1888   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1889   define  new shared  temp-table dc-list-hist no-undo
     1890   field list-table as character
     1891   field id as integer
     1892   field line as integer
     1893   field hist-mode as character
