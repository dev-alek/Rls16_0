        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-type      as character no-undo .
        4   define input parameter p-mode      as character no-undo .
        5   define input parameter p-gds-code  like ub.goods.gds-code no-undo .
        6   define input parameter p-host-code like ub.sysconf.host-code no-undo.
        7   define input parameter p-obj-type  like ub.gds-obj-prop.obj-type  no-undo .
        8   define input parameter p-obj-code  like ub.gds-obj-prop.obj-code  no-undo .
        9   define input parameter p-update-on-exit as logical no-undo .
       10   define output parameter p-modified as logical no-undo .
       11   define output parameter p-is-error as logical no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: gds-indr.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: ref/gds-indr.p $":U .
       17   define variable vss-description as character no-undo init "Запуск интерфейса редактирования атрибутов товара на объекте".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define variable v-update-attr as logical no-undo .
       77   define temp-table tt0-gds-obj-prop no-undo like ub.gds-obj-prop.
       78   define buffer buf_gds-obj-prop for ub.gds-obj-prop.
       79   define temp-table tt0-gds-obj-prop-attr no-undo like ub.gds-obj-prop-attr.
       80   define buffer buf_gds-obj-prop-attr for ub.gds-obj-prop-attr.
       81   do
       82   on error undo, return error return-value
       83   on stop undo, return error return-value
       84   :
       85     for each tt0-gds-obj-prop:
       86       delete tt0-gds-obj-prop.
       87     end.
       88     CASE p-mode:
       89       when 'ИЗМЕНЕНИЕ':U then do:
       90         do transaction on error undo, return error :
       91           FOR EACH buf_gds-obj-prop exclusive-lock  where
       92                   buf_gds-obj-prop.gds-code = p-gds-code
       93               AND buf_gds-obj-prop.obj-type = p-obj-type
       94               AND buf_gds-obj-prop.obj-code = p-obj-code
       95           on error undo, return error:
       96             CREATE tt0-gds-obj-prop.
       97             BUFFER-COPY buf_gds-obj-prop TO tt0-gds-obj-prop.
       98           END.
       99           if p-type = "orders":U
      100           then do:
      101             FOR EACH buf_gds-obj-prop-attr exclusive-lock  where
      102                     buf_gds-obj-prop-attr.gds-code = p-gds-code
      103                 AND buf_gds-obj-prop-attr.obj-type = p-obj-type
      104                 AND buf_gds-obj-prop-attr.obj-code = p-obj-code
      105             on error undo, return error:
      106               if lookup(buf_gds-obj-prop-attr.attr-code, 'CorrIztDel':u) > 0 then next.
      107               CREATE tt0-gds-obj-prop-attr.
      108               BUFFER-COPY buf_gds-obj-prop-attr TO tt0-gds-obj-prop-attr.
      109             END.
      110         end.
      111         end.
      112         if p-type = "orders":U
      113         or p-type = "ordersf":U then do:
      114             run ref/ord-ind.w (
      115                         input parparentproc
      116                       , input p-mode
      117                       , input p-gds-code
      118                       , input p-host-code
      119                       , input p-obj-type
      120                       , input p-obj-code
      121                       , input p-update-on-exit
      122                       , output p-modified
      123                       , input-output table tt0-gds-obj-prop
      124                     , input-output table tt0-gds-obj-prop-attr
      125                             ) no-error.
      126        end.
      127        else do:
      128         run ref/gds-ind.w (
      129                         input parparentproc
      130                       , input p-mode
      131                       , input p-gds-code
      132                       , input p-host-code
      133                       , input p-obj-type
      134                       , input p-obj-code
      135                       , input p-update-on-exit
      136                       , output p-modified
      137                       , input-output table tt0-gds-obj-prop
      138                             ) no-error.
      139        end.
      140         if error-status:error then do:
      141           assign
      142           p-is-error = yes
      143           .
      144         end.
      145         for each tt0-gds-obj-prop:
      146           delete tt0-gds-obj-prop.
      147         end.
      148         for each tt0-gds-obj-prop-attr:
      149           delete tt0-gds-obj-prop-attr.
      150         end.
      151         if p-is-error then do:
      152           return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      153         end.
      154       end.
      155       when 'ПРОСМОТР':U then do:
      156         FOR EACH buf_gds-obj-prop no-lock where
      157                 buf_gds-obj-prop.gds-code = p-gds-code
      158             AND buf_gds-obj-prop.obj-type = p-obj-type
      159             AND buf_gds-obj-prop.obj-code = p-obj-code :
      160             CREATE tt0-gds-obj-prop.
      161             BUFFER-COPY buf_gds-obj-prop TO tt0-gds-obj-prop.
      162         END.
      163         if p-type = "orders":U
      164         then do:
      165           FOR EACH buf_gds-obj-prop-attr no-lock where
      166                   buf_gds-obj-prop-attr.gds-code = p-gds-code
      167               AND buf_gds-obj-prop-attr.obj-type = p-obj-type
      168               AND buf_gds-obj-prop-attr.obj-code = p-obj-code :
      169             if lookup(buf_gds-obj-prop-attr.attr-code, 'CorrIztDel':u) > 0 then next.
      170               CREATE tt0-gds-obj-prop-attr.
      171               BUFFER-COPY buf_gds-obj-prop-attr TO tt0-gds-obj-prop-attr.
      172           END.
      173         end.
      174         if p-type = "orders":U
      175         or p-type = "ordersf":U then do:
      176            run ref/ord-ind.w (
      177                         input parparentproc
      178                       , input p-mode
      179                       , input p-gds-code
      180                       , input p-host-code
      181                       , input p-obj-type
      182                       , input p-obj-code
      183                       , input p-update-on-exit
      184                       , output p-modified
      185                       , input-output table tt0-gds-obj-prop
      186                       , input-output table tt0-gds-obj-prop-attr
      187                             ) no-error.
      188         end.
      189         else do:
      190           run ref/gds-ind.w (
      191                         input parparentproc
      192                       , input p-mode
      193                       , input p-gds-code
      194                       , input p-host-code
      195                       , input p-obj-type
      196                       , input p-obj-code
      197                       , input p-update-on-exit
      198                       , output p-modified
      199                       , input-output table tt0-gds-obj-prop
      200                             ) no-error.
      201         end.
      202         if error-status:error then do:
      203           assign
      204           p-is-error = yes.
      205         end.
      206         for each tt0-gds-obj-prop:
      207           delete tt0-gds-obj-prop.
      208         end.
      209         for each tt0-gds-obj-prop-attr:
      210           delete tt0-gds-obj-prop-attr.
      211         end.
      212         if p-is-error then do:
      213           return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      214         end.
      215       end.
      216     end CASE.
      217   end.
