        1   block-level on error undo, throw.
        2   SESSION:ERROR-STACK-TRACE=YES.
        3   define input  parameter parparentproc as handle no-undo .
        4   define input  parameter iChange as logical  no-undo .
        5   define output parameter oSubs   as class ibs.th.ref.promo.promoActionSubs no-undo .
        6     define variable v-listact-brw as class ibs.th.ref.promo.wListActions no-undo .
        7     v-listact-brw = new ibs.th.ref.promo.wListActions (
        8     ).
        9     //iChange = not iChange.
       10     v-listact-brw:parparentproc = parparentproc.
       11     v-listact-brw:Visual_Buttons(iChange).
       12     wait-for  v-listact-brw:ShowDialog() .
       13     if iChange
       14     then
       15        oSubs = v-listact-brw:oPromoActionSubs.
       16   define variable v-err-msg as character no-undo .
       17     catch exAppErrors as class Progress.Lang.AppError :
       18       v-err-msg = exAppErrors:ReturnValue .
       19       if v-err-msg > "" then . else do :
       20         v-err-msg = exAppErrors:GetMessage(1) .
       21         if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\promo.p" .
       22       end .
       23       message v-err-msg  view-as alert-box.
       24     end catch .
       25     catch exProErrors as class Progress.Lang.ProError :
       26       v-err-msg = exProErrors:GetMessage(1) .
       27       if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\promo.p" .
       28       message "ProError" skip(1) v-err-msg  view-as alert-box.
       29     end catch .
       30     catch exAnyErrors as class Progress.Lang.Error:
       31       v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\promo.p " + exAnyErrors:GetMessage(1).
       32       message "LangError" skip(1) v-err-msg  view-as alert-box.
       33     end catch .
       34   finally:
       35       SESSION:ERROR-STACK-TRACE=no.
       36      if valid-object(v-listact-brw) then delete object v-listact-brw no-error .
       37   end finally.
