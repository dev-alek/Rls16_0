     3215   run adm/shattri.p (
     3216       input "get":U
     3217       ,input  parobj-type
     3218       ,input  parobj-code
     3219       ,input  'get-chk':U
     3220       ,input  'cas-shft':U
     3221       ,output v-value-character32
     3222       ,output v-value-date32
     3223       ,output v-value-decimal32
     3224       ,output v-value-integer32
     3225       ,output cas-shft
     3226       ,output v-param-type32
     3227       ,INPUT-OUTPUT table-handle v-tth32
     3228       )  .
     3229   delete object v-tth32.
     3230   END PROCEDURE.
     3231   PROCEDURE MyEnable :
     3232   ASSIGN
     3233   cb-chk-type:LIST-ITEM-PAIRS  in frame Dialog-Frame =  "Все типы чеков" + chr(44) + '0':U + chr(44) +
     3234                                                          'Продажа,1,Возврат,6,ВзврСпис,96,СбросТрнзкц,14,Перелив,15,ПеревТрнзкц,16,РазблТрнзкц,36,ТехПролив,17,Списание,69,Аннуляция,8,Инвентаризация,11,Z-отчет,12,_Продажа,101,_Возврат,106,_ВзврСпис,196,_СбросТрнзкц,114,_Перелив,115,_ПеревТрнзкц,116,_ТехПролив,117,_Списание,169,_Аннуляция,108,_Инвентаризация,111,_Z-отчет,112,_СбросТрнзкц,114,_РазблТрнзкц,136,>Продажа,201,>Возврат,206,>Аннуляция,208,>>Продажа,301,>>Возврат,306':U
     3235   cb-chk-type = string(0)
     3236   p-chk-type = integer(cb-chk-type)
     3237   br-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 6
     3238   b-print:MENU-MOUSE = 1
     3239   b-del:MENU-MOUSE = 1
     3240   c-doc.cashier:READ-ONLY IN BROWSE BR-docs = YES
     3241   RS-Sort = "doc-code":U
     3242   .
     3243   if lookup ('продажа':U, par-mode) > 0 then do:
     3244       assign
     3245       v-doc-rec = ?
     3246       .
     3247   end.
     3248   DISPLAY
     3249   ED-notes
     3250   sch-code
     3251   sch-date
     3252   sch-price
     3253   mark-num
     3254   Rs-sort
     3255   cb-chk-type when par-mode <> 'все':U
     3256   WITH FRAME Dialog-Frame .
     3257   ENABLE
     3258   b-allgood when v-cycle = no
     3259   b-quit
     3260   b-lkp
     3261   b-sch
     3262   b-sale when par-mode <> 'продажа':U
     3263   b-help
     3264   br-docs
     3265   b-sel  when LOOKUP("b-sel":U, bttns) > 0
     3266   b-mark when LOOKUP("b-mark":U, bttns) > 0
     3267   b-del WHEN LOOKUP("b-del":U, bttns) > 0 and lookup ('продажа':U, par-mode) > 0 AND buf_Inkas.STATUS_ <> 'факт':U and buf_inkas.status_ <> 'запрос':U
     3268   sch-code
     3269   sch-date
     3270   sch-price
     3271   ed-notes
     3272   b-print
     3273   Rs-sort
     3274   cb-chk-type when par-mode <> 'все':U
     3275   WITH FRAME Dialog-Frame.
     3276   IF lookup ('продажа':U, par-mode) = 0 THEN DO:
     3277       HIDE
     3278       b-del
     3279       IN FRAME Dialog-Frame.
     3280   END.
     3281   if par-mode = 'все':U then do:
     3282     hide
     3283     cb-chk-type
     3284     in frame Dialog-Frame .
     3285   end.
     3286   VIEW FRAME Dialog-Frame .
     3287   END PROCEDURE.
     3288   PROCEDURE OpenBr :
     3289   define input  parameter p-open-query     as logical   no-undo .
     3290   define input  parameter p-find-next      as logical   no-undo .
     3291   define input  parameter p-find-condition as character no-undo .
     3292   DEFINE VARIABLE l-query-was-opened as logical no-undo .
     3293   define variable title0 as character no-undo.
     3294   title0 = "Список чеков по бар-коду:" + chr(32) + string (b-c) + chr(32) +
     3295            "Артикул:" + chr(32) + buf_goods.artic + chr(32) + buf_goods.gds-name + chr(32) .
     3296   run waitfram-show in this-procedure ( input "Ждите...").
     3297   DEFINE VARIABLE sort-column-phrase as character no-undo .
     3298   case sort-column-name :
     3299     when "" then do:
     3300       assign
     3301         sort-column-phrase = ""
     3302       .
     3303     end.
     3304     otherwise do:
     3305       assign
     3306         sort-column-phrase = "by " + sort-column-name
     3307       .
     3308     end.
     3309   end case.
     3310   define variable l-open-query as logical   no-undo .
     3311   CASE Rs-sort:
     3312     when "unsort":U then do:
     3313         CASE par-mode :
     3314           WHEN 'все':U        THEN DO:
     3315            assign
     3316           filter-point = filter-point0 + par-mode
     3317           filter-label = substitute("&1", filter-label0)
     3318           .
     3319           if p-open-query then do:
     3320             ASSIGN frame Dialog-Frame:TITLE = substitute("&1", title0).
     3321           end.
     3322   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3323   define variable  l-disable-where-34  as logical   no-undo .
     3324   define variable  l-filter-open-34    as logical   .
     3325   define variable  flt-rec-34       as recid     no-undo .
     3326   define variable  filter-name-34      as character no-undo .
     3327   define variable  where-phrase-34     as character no-undo .
     3328   define variable  sort-phrase-34      as character no-undo .
     3329   define variable  where-phrase-rus-34 as character no-undo .
     3330   define variable  sort-phrase-rus-34  as character no-undo .
     3331   run gbl/flt-get.p
     3332     (input filter-point
     3333     ,output flt-rec-34
     3334     ,output filter-name-34
     3335     ,output where-phrase-34
     3336     ,output sort-phrase-34
     3337     ,output where-phrase-rus-34
     3338     ,output sort-phrase-rus-34
     3339     ).
     3340   if p-open-query then do:
     3341       run set-filter-name in this-procedure
     3342         (INPUT filter-name-34
     3343         ) no-error .
     3344     assign
     3345       l-filter-open-34 = false
     3346     .
     3347     if flt-rec-34 <> ?
     3348       or sort-column-phrase > ""
     3349     then do:
     3350       define variable  parameter-2-34 as character no-undo .
     3351       define variable  parameter-3-34 as character no-undo .
     3352       define variable  parameter-4-34 as character no-undo .
     3353       define variable  parameter-5-34 as character no-undo .
     3354       define variable  parameter-6-34 as character no-undo .
     3355       define variable  parameter-7-34 as character no-undo .
     3356         assign
     3357         parameter-3-34 =
     3358                                 "FOR EACH chk-gds"
     3359         parameter-4-34 =
     3360           (
     3361             if (" chk-gds.b-code = buf_bar-code.b-code " + " " + where-phrase-34) <> ""
     3362             then  substitute('chk-gds.b-code = &1', buf_bar-code.b-code)  + " " + where-phrase-34
     3363             else "true"
     3364           )
     3365         parameter-5-34 = (" " + "" + " " + ", FIRST c-doc No-LOCK WHERE c-doc.doc-code = chk-gds.doc-code")
     3366         parameter-6-34 = if sort-phrase-34 = ''
     3367                              then
     3368           (
     3369           " " + "  " +
     3370             " " + sort-column-phrase +
     3371           " " + " "
     3372           )
     3373                              else
     3374           (
     3375           " " + "  " +
     3376             " " + sort-column-phrase +
     3377           " " + sort-phrase-34
     3378           )
     3379         parameter-7-34 =
     3380           "   "
     3381       .
     3382       do
     3383       on stop undo, leave
     3384       on error undo, leave
     3385       :
     3386         assign
     3387           l-disable-where-34 =
     3388             (" chk-gds.b-code = buf_bar-code.b-code " + " " + where-phrase-34 = "")
     3389         .
     3390         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3391                             ,input query br-docs:handle
     3392                             ,input parameter-3-34
     3393                             ,input parameter-4-34
     3394                             ,input parameter-5-34
     3395                             ,input parameter-6-34
     3396                             ,input parameter-7-34
     3397                             )
     3398         .
     3399         assign
     3400           l-filter-open-34 = true
     3401         .
     3402       end.
     3403       if l-filter-open-34 = false then do:
     3404         message
     3405           "Ошибка при фильтрации / сортировке" skip
     3406           "Будут показаны записи без учета фильтра" skip
     3407           view-as alert-box .
     3408       end.
     3409       else do:
     3410           assign
     3411             l-query-was-opened = true
     3412           .
     3413       end.
     3414     end.
     3415     if l-filter-open-34 = false then do:
     3416       OPEN QUERY br-docs FOR EACH chk-gds
     3417         where  chk-gds.b-code = buf_bar-code.b-code
     3418       , FIRST c-doc No-LOCK WHERE c-doc.doc-code = chk-gds.doc-code
     3419     .
     3420         assign
     3421           l-query-was-opened = true
     3422         .
     3423     end.
     3424   end.
     3425   else do:
     3426     assign
     3427       v-doc-rec = recid( chk-gds )
     3428     .
     3429     do
     3430     on stop undo, leave
     3431     on error undo, leave
     3432     :
     3433       if query br-docs:handle:get-buffer-handle(1) = (buffer chk-gds:handle) then do:
     3434         assign
     3435         parameter-2-34 = (if p-find-next then "true":u else "false":u )
     3436         parameter-4-34 =
     3437           "where ":u +  substitute('chk-gds.b-code = &1', buf_bar-code.b-code)  + " ":u + where-phrase-34 + " ":u + p-find-condition + " " + ""
     3438         parameter-5-34 = "  "
     3439       .
     3440         run fltopend_fltfindd in this-procedure  (
     3441                             input this-procedure:handle
     3442                             ,input query br-docs:handle
     3443                             ,input rowid(chk-gds)
     3444                             ,input logical(parameter-2-34)
     3445                             ,input no-lock
     3446                             ,input (buffer chk-gds:handle)
     3447                             ,input parameter-4-34
     3448                             ,input parameter-5-34
     3449                             ) no-error.
     3450         .
     3451         assign
     3452           v-doc-rec = integer(return-value)
     3453           v-fltopend-rowid[1] = ?
     3454         .
     3455       end.
     3456       else do:
     3457         assign
     3458         parameter-2-34 = (if p-find-next then "true":u else "false":u )
     3459         parameter-3-34 =  "FOR EACH chk-gds"
     3460         parameter-4-34 =
     3461           (
     3462             if (" chk-gds.b-code = buf_bar-code.b-code " + " " + where-phrase-34) <> ""
     3463             then  substitute('chk-gds.b-code = &1', buf_bar-code.b-code)  + " " + where-phrase-34
     3464             else "true"
     3465           )
     3466         parameter-5-34 = (" " + "" + " " + ", FIRST c-doc No-LOCK WHERE c-doc.doc-code = chk-gds.doc-code" + " " + p-find-condition)
     3467         parameter-6-34 = if sort-phrase-34 = ''
     3468                              then
     3469           (
     3470           " " + "  " +
     3471             " " + sort-column-phrase +
     3472           " " + " "
     3473           )
     3474                              else
     3475           (
     3476           " " + "  " +
     3477             " " + sort-column-phrase +
     3478           " " + sort-phrase-34
     3479           )
     3480         parameter-7-34 =
     3481           "   "
     3482       .
     3483         run fltopend_fltfindq in this-procedure  (
     3484                             input this-procedure:handle
     3485                             ,input query br-docs:handle
     3486                             ,input logical(parameter-2-34)
     3487                             ,input no-lock
     3488                             ,input parameter-3-34
     3489                             ,input parameter-4-34
     3490                             ,input parameter-5-34
     3491                             ,input parameter-6-34
     3492                             ,input parameter-7-34
     3493                             ,output v-fltopend-rowid
     3494                             ) no-error.
     3495         .
     3496         v-doc-rec = ?.
     3497       end.
     3498       assign
     3499         l-query-was-opened = true
     3500       .
     3501     end.
     3502   end.
     3503             v-print-host-code = 0.
     3504           END.
     3505           WHEN 'объект':U THEN DO:
     3506   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3508     (input  parobj-type
     3509     ,input  parobj-code
     3510     ,output v-print-host-code
     3511     )  .
     3512             assign
     3513             filter-point = filter-point0 + par-mode
     3514             filter-label = substitute("&1 Один объект", filter-label0)
     3515             .
     3516             if p-open-query then do:
     3517               ASSIGN frame Dialog-Frame:TITLE = substitute("&1 Объект: &2&3 &4"
     3518                                                           , title0
     3519                                                           , parobj-type
     3520                                                           , parobj-code
     3521                                                           , (if p-chk-type = 0 then '':u else entry (lookup (string(p-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U))
     3522                                                           )
     3523               .
     3524             end.
     3525   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3526   define variable  l-disable-where-37  as logical   no-undo .
     3527   define variable  l-filter-open-37    as logical   .
     3528   define variable  flt-rec-37       as recid     no-undo .
     3529   define variable  filter-name-37      as character no-undo .
     3530   define variable  where-phrase-37     as character no-undo .
     3531   define variable  sort-phrase-37      as character no-undo .
     3532   define variable  where-phrase-rus-37 as character no-undo .
     3533   define variable  sort-phrase-rus-37  as character no-undo .
     3534   run gbl/flt-get.p
     3535     (input filter-point
     3536     ,output flt-rec-37
     3537     ,output filter-name-37
     3538     ,output where-phrase-37
