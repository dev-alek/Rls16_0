     2914   def var sort-labelBR-docs   as character no-undo .
     2915   def var sort-clmnBR-docs    as handle    no-undo .
     2916   def var cur-clmnBR-docs     as handle    no-undo .
     2917   def var cur-clmn-locBR-docs as integer   no-undo .
     2918   def var re-queryBR-docs     as logical   initial no no-undo .
     2919   on start-search, ctrl-o of BR-docs in frame Dialog-Frame do:
     2920      run sort-brBR-docs
     2921        (input (if available chk-gds
     2922                then recid(chk-gds)
     2923                else ?
     2924               )
     2925        ).
     2926   end.
     2927   PROCEDURE sort-brBR-docs :
     2928     define input parameter p-recid as recid no-undo .
     2929     if re-queryBR-docs = no then do:
     2930       assign
     2931          cur-clmnBR-docs = BR-docs:current-column in frame Dialog-Frame
     2932       .
     2933       if sort-clmnBR-docs <> ? then sort-clmnBR-docs:column-fgcolor = 0.
     2934       if cur-clmnBR-docs = sort-clmnBR-docs then do:
     2935         assign
     2936            sort-labelBR-docs = ""
     2937            sort-clmnBR-docs = ?
     2938         .
     2939        end.
     2940        else do:
     2941          assign
     2942            sort-labelBR-docs = cur-clmnBR-docs:label
     2943            sort-clmnBR-docs  = cur-clmnBR-docs
     2944            sort-clmnBR-docs:column-fgcolor = 4
     2945          .
     2946        end.
     2947      end.
     2948     assign
     2949       cur-clmn-locBR-docs = 1
     2950     .
     2951     def var column-handle as handle no-undo .
     2952     column-handle = BR-docs:first-column.
     2953     do while valid-handle(column-handle) :
     2954       if column-handle = cur-clmnBR-docs then do:
     2955         leave .
     2956       end.
     2957       column-handle = column-handle:NEXT-COLUMN.
     2958       assign
     2959         cur-clmn-locBR-docs = cur-clmn-locBR-docs + 1
     2960       .
     2961     end.
     2962     case sort-labelBR-docs:
     2963           when c-doc.office:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.office"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2964           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(chk-gds), &1&2&1)', chr(34), rid-list)     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2965           when c-doc.doc-code:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.doc-code"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2966           when 'Тип_чека'  then DO:    assign       sort-column-name = "entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2967           when c-doc.chk-num:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.chk-num"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2968           when c-doc.chk-date:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.chk-date"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2969           when 'Время'  then DO:    assign       sort-column-name = "(string (c-doc.chk-time, 'HH:MM'))"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2970           when chk-gds.doc-qnty:label in browse BR-docs then DO:    assign       sort-column-name = "chk-gds.doc-qnty"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2971           when chk-gds.price-base:label in browse BR-docs then DO:    assign       sort-column-name = "chk-gds.price-base"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2972           when chk-gds.discnt:label in browse BR-docs then DO:    assign       sort-column-name = "chk-gds.discnt"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2973           when '%'  then DO:    assign       sort-column-name = "(chk-gds.discnt / chk-gds.price-base * 100)"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2974           when 'Нетто цена'  then DO:    assign       sort-column-name = "(chk-gds.price-base - chk-gds.discnt)"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2975           when 'ТРК'  then DO:    assign       sort-column-name = "chk-gds.pump"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2976           when 'Пист'  then DO:    assign       sort-column-name = "chk-gds.nozzle-code"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2977           when 'Рез'  then DO:    assign       sort-column-name = "chk-gds.loc1"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2978           when 'Код_спис'  then DO:    assign       sort-column-name = "entry (lookup (string(chk-gds.write-off-code),  '?,0,1,-6,-9,2,-2,3,-3,-4,17':U), ',,Без_оплаты,Отмена_позиции,Полн_Отмена,Модификатор,Модификатор,Модификатор(+спис),Модификатор(-спис),Модификатор(-спис),Техпролив':U)"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2979           when c-doc.shift-date:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.shift-date"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2980           when c-doc.pay-desk:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.pay-desk"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2981           when c-doc.cashier:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.cashier"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2982           when c-doc.sales-man:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.sales-man"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2983           when c-doc.out-code:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.out-code"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2984           when c-doc.d-card:label in browse BR-docs then DO:    assign       sort-column-name = "c-doc.d-card"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     2985       otherwise do:
     2986         assign
     2987           sort-column-name = ""
     2988         .
     2989         run OpenBr in this-procedure ( input yes, input no, input '').
     2990         if sort-labelBR-docs <> "" then do:
     2991           assign
     2992             cur-clmnBR-docs:column-fgcolor = 0
     2993           .
     2994         end.
     2995         assign
     2996           cur-clmn-locBR-docs = ?
     2997         .
     2998       end.
     2999     end case.
     3000     if p-recid <> ? then do:
     3001       reposition BR-docs to recid p-recid no-error.
     3002       apply "value-changed" to BR-docs in frame Dialog-Frame.
     3003     end.
     3004     apply "entry" to BR-docs in frame Dialog-Frame.
     3005   END PROCEDURE.
     3006   procedure re-open-query-srt-clmnBR-docs:
     3007   if cur-clmnBR-docs = ? then do:
     3008      run OpenBr in this-procedure ( input yes, input no, input '').
     3009   end.
     3010   else do:
     3011      assign re-queryBR-docs = yes.
     3012      run sort-brBR-docs
     3013        (input (if available chk-gds
     3014                then recid(chk-gds)
     3015                else ?
     3016               )
     3017        ).
     3018      assign re-queryBR-docs = no.
     3019   end.
     3020   end.
     3021   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3022   DEF VAR cur-clmn-numbr-docs as INT EXTENT 28 no-undo.
     3023   DEF VAR varmvibr-docs       as INT no-undo.
     3024   DEF VAR varmvjbr-docs       as INT no-undo.
     3025   DEF VAR varmvkbr-docs       as INT no-undo.
     3026   DEF VAR varmvlbr-docs       as INT no-undo.
     3027   DEF VAR move-elementbr-docs as INT no-undo.
     3028   def var jjbr-docs           as int no-undo.
     3029   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     3030     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
     3031   END.
     3032   RUN start-mv-clmnbr-docs.
     3033   PROCEDURE start-mv-clmnbr-docs:
     3034   def var old-session as logical no-undo.
     3035      old-session = SESSION:IMMEDIATE-DISPLAY.
     3036      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3037      SESSION:IMMEDIATE-DISPLAY = old-session.
     3038   END.
     3039   ON ctrl-cursor-right OF BROWSE br-docs do:
     3040     RUN re-move-clmnbr-docs ( 10, 28).
     3041   END.
     3042   ON ctrl-cursor-left OF BROWSE br-docs do:
     3043     RUN re-move-clmnbr-docs (28, 10).
     3044   END.
     3045   PROCEDURE re-move-clmnbr-docs:
     3046     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3047     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3048     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3049       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
     3050     END.
     3051     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3052     if source-column > target-column THEN
     3053     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
     3054       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3055           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3056             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
     3057           END.
     3058       END.
     3059     END.
     3060     ELSE
     3061     DO varmvjbr-docs = source-column + 1 to target-column:
     3062       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3063         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3064           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
     3065         END.
     3066       END.
     3067     END.
     3068     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3069       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
     3070     END.
     3071   END PROCEDURE.
     3072   PROCEDURE ch-clmnbr-docs:
     3073     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3074     if cur-clmn-loc <= 10 then do:
     3075       return .
     3076     end.
     3077     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3078       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
     3079     END.
     3080     RUN re-move-clmnbr-docs (cur-clmn-loc, 10).
     3081   END PROCEDURE.
     3082   PROCEDURE mv-brw-defaultbr-docs:
     3083   def var old-session as logical no-undo.
     3084     old-session = SESSION:IMMEDIATE-DISPLAY.
     3085     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3086     do varmvlbr-docs = 10 to EXTENT(cur-clmn-numbr-docs):
     3087       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
     3088     END.
     3089     RUN start-mv-clmnbr-docs.
     3090     SESSION:IMMEDIATE-DISPLAY = old-session.
     3091   END PROCEDURE.
     3092   .
     3093   MAIN-BLOCK:
     3094   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3095      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3096   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3097     run mainmenu_getcntxt in parparentproc
     3098       (output v-cntxt-db-num
     3099       ,output v-cntxt-userid
     3100       ,output v-cntxt-level
     3101       ,output v-cntxt-host-code-obj
     3102       ,output v-cntxt-obj-type
     3103       ,output v-cntxt-obj-code
     3104       ,output v-cntxt-db-num-obj
     3105       ,output v-cntxt-is-admin
     3106       ) .
     3107   if entry(1, par-mode) = "gds-chks":u then do:
     3108     assign
     3109     v-cycle = yes
     3110     par-mode = substr(par-mode, 10)
     3111     .
     3112   end.
     3113   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3114   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3115     (output v-curr-r-b
     3116     )  .
     3117     find buf_bar-code where
     3118          buf_bar-code.b-code = b-c no-lock no-error.
     3119     if not available buf_bar-code then do:
     3120       return error.
     3121     end.
     3122     find FIRST buf_goods where
     3123                buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK.
     3124     find FIRST buf_gds-prt where
     3125                buf_gds-prt.node-code = buf_bar-code.node-code no-lock.
     3126   CASE par-mode:
     3127       WHEN 'все':U        THEN DO:
     3128       END.
     3129       WHEN 'объект':U or when "free":U THEN DO:
     3130         FIND FIRST buf_obj No-LOCK WHERE
     3131                     buf_obj.obj-type = parobj-type and
     3132                     buf_obj.obj-code = parobj-code No-ERROR.
     3133         if not avail buf_obj then do:
     3134           message vss-workfile vss-revision vss-description skip
     3135           "Неверное значение параметров вызова parobj-type и/или parobj-code"
     3136           parobj-type parobj-code
     3137           view-as alert-box ERROR.
     3138           return.
     3139         end.
     3140       END.
     3141       when "d-card":U or when ("d-card" + chr(44) + 'продажа':U) then do:
     3142           FIND FIRST buf_dis-card where
     3143                             buf_dis-card.d-card = pard-card No-LOCK NO-ERROR.
     3144         if not avail buf_dis-card then do:
     3145             message vss-workfile vss-revision vss-description skip
     3146             "Неверное значение параметра вызова pard-card" pard-card
     3147             view-as alert-box ERROR.
     3148             return.
     3149         end.
     3150          FIND FIrst  buf_clients NO-LOCK WHERE
     3151                           buf_clients.obj-type = buf_dis-card.cli-type AND
     3152                           buf_clients.obj-code = buf_dis-card.cli-code No-ERROR.
     3153       end.
     3154       WHEN 'продажа':U  or when ("d-card" + chr(44) + 'продажа':U) then do:
     3155           FIND buf_inkas where buf_inkas.inkas-code = parout-code NO-LOCK no-error.
     3156         if not avail buf_inkas then do:
     3157             message vss-workfile vss-revision vss-description skip
     3158             "Неверное значение параметра вызова parout-code" parout-code
     3159             view-as alert-box ERROR.
     3160             return.
     3161         end.
     3162         assign
     3163         v-inkas-host-code = buf_inkas.host-code
     3164         v-inkas-obj-type = buf_inkas.obj-type
     3165         v-inkas-obj-code = buf_inkas.obj-code
     3166         .
     3167       end.
     3168       otherwise do:
     3169         message vss-workfile vss-revision vss-description skip
     3170         "Неверный вызов - par-mode=" par-mode
     3171         view-as alert-box ERROR.
     3172         return.
     3173       end.
     3174     end CASE.
     3175       if pardoc-rec <> ? then do:
     3176         FIND FIRST find_chk-gds No-LOCK where
     3177                    recid(find_chk-gds) = pardoc-rec No-ERROR.
     3178         if not avail find_chk-gds then do:
     3179           message
     3180           vss-workfile vss-revision vss-description skip
     3181           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3182           view-as alert-box error .
     3183           return error.
     3184         end.
     3185         v-doc-rec = pardoc-rec.
     3186       end.
     3187     RUN MyEnable in this-procedure .
     3188     RUn OpenBR  in this-procedure ( input yes, input no, input '':U).
     3189     HIDE mark-num in frame Dialog-Frame .
     3190     if pardoc-rec <> ? then
     3191     REPOSITION br-docs to recid v-doc-rec No-ERROR.
     3192     WAIT-FOR GO OF FRAME Dialog-Frame.
     3193   END.
     3194   RUN disable_UI.
     3195   PROCEDURE disable_UI :
     3196     HIDE FRAME Dialog-Frame.
     3197   END PROCEDURE.
     3198   PROCEDURE enable_UI :
     3199     DISPLAY Cb-chk-type RS-sort ED-notes sch-code sch-date sch-price mark-num
     3200         WITH FRAME Dialog-Frame.
     3201     ENABLE b-quit B-mark b-sel b-lkp b-allgood B-del B-sale B-print B-sch B-Help
     3202            Cb-chk-type RS-sort BR-docs ED-notes sch-code sch-date sch-price
     3203            mark-num
     3204         WITH FRAME Dialog-Frame.
     3205     VIEW FRAME Dialog-Frame.
     3206   END PROCEDURE.
     3207   PROCEDURE get-params :
     3208   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3209   define variable v-param-type32 as character no-undo .
     3210   define variable v-value-character32 as character no-undo .
     3211   define variable v-value-date32 as date no-undo .
     3212   define variable v-value-decimal32 as decimal no-undo .
     3213   define variable v-value-integer32 as INTEGER no-undo .
