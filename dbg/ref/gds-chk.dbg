     5801       c-doc.office
     5802       (if v-one-time
     5803       then c-doc.doc-code
     5804       else (string(c-doc.doc-code, "X(20)") + chr(32) + string(chk-gds.line-num, "-99"))) @ c-doc.doc-code
     5805       entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) @ v-receipt-name
     5806       c-doc.chk-num
     5807       c-doc.chk-date
     5808       string(c-doc.chk-time, "HH:mm") @ for-time
     5809       c-doc.shift-date
     5810       shift-name-no-err(buffer c-doc) @ v-shift-name-num
     5811       c-doc.tot-doc
     5812       c-doc.discnt
     5813       c-doc.sub-discnt
     5814       c-doc.netto
     5815       c-doc.pay-desk
     5816       c-doc.cashier
     5817       c-doc.sales-man
     5818       if c-doc.out-code <> ? then c-doc.out-code else "" @ c-doc.out-code
     5819       c-doc.d-card
     5820       with FRAME Chk-List .
     5821       DOWN STREAM PrnLibStream 1 with FRAME CHk-List  .
     5822       assign
     5823       accum-count = accum-count + 1
     5824       accum-tot-doc = accum-tot-doc + c-doc.tot-doc
     5825       accum-discnt = accum-discnt + c-doc.discnt
     5826       accum-sub-discnt = accum-sub-discnt + c-doc.sub-discnt
     5827       accum-netto = accum-netto + c-doc.netto.
     5828     end.
     5829     assign
     5830     v-doc-code = chk-gds.doc-code
     5831     .
     5832     GET next br-docs no-lock.
     5833   END.
     5834   if v-one-time then do:
     5835     UNDERLINE  STREAM PrnLibStream
     5836     c-doc.office
     5837     c-doc.doc-code
     5838     v-receipt-name
     5839     c-doc.chk-num
     5840     c-doc.chk-date
     5841     for-time
     5842     c-doc.shift-date
     5843     v-shift-name-num
     5844     c-doc.tot-doc
     5845     c-doc.discnt
     5846     c-doc.sub-discnt
     5847     c-doc.netto
     5848     c-doc.pay-desk
     5849     c-doc.cashier
     5850     c-doc.sales-man
     5851     c-doc.out-code
     5852     c-doc.d-card
     5853     with FRAME Chk-List .
     5854     DISPLAY STREAM PrnLibStream
     5855     "ИТОГО"  @ c-doc.doc-code
     5856     accum-count @ c-doc.chk-num
     5857     "_" @ c-doc.chk-date
     5858     "_ " @ for-time
     5859     "_" @ c-doc.shift-date
     5860     "_____" @ v-shift-name-num
     5861     accum-tot-doc @ c-doc.tot-doc
     5862     accum-discnt @ c-doc.discnt
     5863     accum-sub-discnt @ c-doc.sub-discnt
     5864     accum-netto @ c-doc.netto
     5865     with frame Chk-List.
     5866   end.
     5867   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5868   HIDE  STREAM PrnLibStream FRAME CheckList.
     5869   output  STREAM PrnLibStream CLOSE.
     5870   run waitfram-hide in this-procedure .
     5871   run prn-lib-prn-file in this-procedure (
     5872                                             input parParentProc
     5873                                             ,input 8
     5874                                             ).
     5875   END PROCEDURE.
     5876   PROCEDURE PrintProcGds :
     5877   DEFINE VARIABLE date_string     as      char    no-undo.
     5878   DEFINE VARIABLE Line                as      char    no-undo.
     5879   DEFINE VARIABLE for-time as char no-undo.
     5880   DEFINE VARIABLE accum-count as integer no-undo.
     5881   DEFINE VARIABLE accum-qnty as decimal no-undo.
     5882   DEFINE VARIABLE accum-tot-doc as decimal no-undo.
     5883   DEFINE VARIABLE accum-discnt as decimal no-undo.
     5884   DEFINE VARIABLE accum-netto as decimal no-undo.
     5885   DEFINE VARIABLE fgds-discnt-pc as decimal no-undo.
     5886   DEFINE VARIABLE for-gds-price like ub.chk-gds.price-base no-undo.
     5887   DEFINE VARIABLE for-gds-brutto like ub.chk-doc.netto no-undo.
     5888   DEFINE VARIABLE for-gds-netto like ub.chk-doc.netto no-undo.
     5889   DEFINE VARIABLE for-gds-discnt like ub.chk-doc.netto no-undo.
     5890   define variable v-write-off as logical no-undo .
     5891   define variable v-header-base-curr as character no-undo .
     5892   define variable v-base-code like ub.sysconf.host-code no-undo .
     5893   define variable v-base-type like ub.currency.curr-abbr no-undo .
     5894   define buffer buf_currency for ub.currency.
     5895   if v-curr-r-b = 'base':U then do:
     5896     if v-print-host-code <> ? then do:
     5897   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5898   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5899     (input  v-print-host-code
     5900     ,output v-base-code
     5901     )  .
     5902       find first buf_currency where
     5903               buf_currency.curr-code = v-base-code.
     5904       assign
     5905       v-base-type = buf_currency.curr-abbr.
     5906     end.
     5907   end.
     5908   assign
     5909   v-header-base-curr = string( "( Б.Вал. - " + caps( v-base-type ) + " )" )
     5910   .
     5911   DEFINE FRAME Goods-Frame
     5912   chk-gds.doc-code column-label "Номер_чека" FORMAT "X(18)"
     5913   chk-gds.line-num column-label "NN" format "-99"
     5914   chk-gds.is-error COLUMN-LABEL "Ош" FORMAT "+/ "
     5915   chk-gds.src-code Column-label "Код в спул-файле" FORMAT "X(16)"
     5916   chk-gds.pump column-label "ТРК"
     5917   chk-gds.nozzle-code column-label "Пист"
     5918   chk-gds.loc1 column-label "Рез"
     5919   chk-gds.doc-qnty
     5920   chk-gds.price-base
     5921   chk-gds.discnt
     5922   fgds-discnt-pc COLUMn-LABEL "% ск."  FORMAT "->9.99%"
     5923   for-gds-price COLUMN-LABEL "Цена нетто"
     5924   v-write-off COLUMn-LABEL "Сп" FORMAT "+/"
     5925   chk-gds.road-tax
     5926   for-gds-brutto COLUMN-LABEL "Сумма брутто"
     5927   for-gds-discnt COLUMN-LABEL "Сумма скидки"
     5928   for-gds-netto COLUMN-LABEL "Сумма нетто"
     5929   HEADER  date_string AT 5 format "X(35)"
     5930   v-header-base-curr        format "X(20)"
     5931   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5932    Line format "X(230)" AT 1
     5933   with width 232 down stream-io use-text .
     5934   Line = fill("-", 183).
     5935   date_string = cur-time-print() .
     5936   run prn-lib-open-stream  in this-procedure (
     5937                                                input parParentProc
     5938                                               ,input 43
     5939                                               ,input yes
     5940                                               ,input no
     5941                                               ).
     5942   PUT  STREAM PrnLibStream
     5943   (frame Dialog-Frame:title + chr(32) + "- строки чеков")
     5944   format "x(180)" SKIP(1) .
     5945   FORM HEADER
     5946   Line format "X(230)" AT 1 SKIP
     5947   "Продолжение - на следующей странице" AT 30 SKIP
     5948   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5949   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5950   FORM with FRAME Goods-Frame  .
     5951   run waitfram-show in this-procedure ( input "Ждите..." ).
     5952   GET next br-docs no-lock.
     5953   DO WHILE available chk-gds :
     5954       assign
     5955       fgds-discnt-pc = (chk-gds.discnt / (chk-gds.price-base + chk-gds.price-service) * 100)
     5956       for-gds-brutto = (chk-gds.price-base + chk-gds.price-service) * chk-gds.doc-qnty
     5957       for-gds-discnt = chk-gds.discnt * chk-gds.doc-qnty
     5958       for-gds-netto = (chk-gds.price-base + chk-gds.price-service - chk-gds.discnt) * chk-gds.doc-qnty
     5959       for-gds-price = chk-gds.price-base + chk-gds.price-service - chk-gds.discnt
     5960       .
     5961       DISPLAY Stream PrnLibStream
     5962       chk-gds.doc-code
     5963       chk-gds.line-num
     5964       chk-gds.is-error
     5965       chk-gds.src-code
     5966       chk-gds.pump
     5967       chk-gds.nozzle-code
     5968       chk-gds.loc1
     5969       chk-gds.doc-qnty
     5970       (chk-gds.price-base + chk-gds.price-service) @ chk-gds.price-base
     5971       chk-gds.discnt
     5972       fgds-discnt-pc
     5973       for-gds-price
     5974       (if chk-gds.write-off-code <> ?
     5975       and chk-gds.write-off-code <> 0
     5976       then yes
     5977       else no
     5978       )  @ v-write-off
     5979       chk-gds.road-tax
     5980       for-gds-brutto
     5981       for-gds-discnt
     5982       for-gds-netto
     5983       WITH FRAME Goods-Frame.
     5984       DOWN STREAM PrnLibStream with FRAME Goods-Frame .
     5985       assign
     5986       accum-count = accum-count + 1
     5987       accum-qnty = accum-qnty + chk-gds.doc-qnty
     5988       accum-tot-doc = accum-tot-doc + chk-gds.doc-qnty * (chk-gds.price-base + price-service)
     5989       accum-discnt = accum-discnt + chk-gds.doc-qnty * chk-gds.discnt
     5990       accum-netto = accum-netto + chk-gds.doc-qnty * (chk-gds.price-base + chk-gds.price-service - chk-gds.discnt)
     5991       .
     5992     GET next br-docs no-lock.
     5993   END.
     5994   UNDERLINE  STREAM PrnLibStream
     5995   chk-gds.doc-code
     5996   chk-gds.line-num
     5997   chk-gds.is-error
     5998   chk-gds.src-code
     5999   chk-gds.pump
     6000   chk-gds.nozzle-code
     6001   chk-gds.loc1
     6002   chk-gds.doc-qnty
     6003   chk-gds.price-base
     6004   chk-gds.discnt
     6005   fgds-discnt-pc
     6006   for-gds-price
     6007   v-write-off
     6008   chk-gds.road-tax
     6009   for-gds-brutto
     6010   for-gds-discnt
     6011   for-gds-netto
     6012   with FRAME Goods-Frame .
     6013   DISPLAY STREAM PrnLibStream
     6014   "ИТОГО"  @ chk-gds.doc-code
     6015   "_" @ chk-gds.line-num
     6016   "_" @ chk-gds.is-error
     6017   string(accum-count) @ chk-gds.src-code
     6018   "__" @ chk-gds.pump
     6019   "___" @ chk-gds.nozzle-code
     6020   "___" @ chk-gds.loc1
     6021   "_" @ chk-gds.price-base
     6022   "_" @ chk-gds.discnt
     6023   "_" @ fgds-discnt-pc
     6024   "_" @ for-gds-price
     6025   "_" @ v-write-off
     6026   "_" @ chk-gds.road-tax
     6027   ACCUM-qnty @ chk-gds.doc-qnty
     6028   accum-tot-doc @ for-gds-brutto
     6029   accum-discnt @ for-gds-discnt
     6030   accum-netto @ for-gds-netto
     6031   WITH FRAME Goods-Frame.
     6032   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     6033   HIDE  STREAM PrnLibStream FRAME Goods-Frame.
     6034   output  STREAM PrnLibStream CLOSE.
     6035   run waitfram-hide in this-procedure .
     6036   run prn-lib-prn-file in this-procedure (
     6037                                             input parParentProc
     6038                                             ,input 8
     6039                                             ).
     6040   END PROCEDURE.
     6041   PROCEDURE proc-b-del :
     6042   define input parameter del-type as character no-undo.
     6043   define variable old-netto as decimal no-undo.
     6044   define  variable old-tot-doc as decimal no-undo.
     6045   define  variable old-discnt as decimal no-undo.
     6046   define variable glog as logical no-undo .
     6047   define buffer buf_inkas for ub.inkas .
     6048   define buffer del_chk-doc for ub.chk-doc.
     6049   define variable v-rec as recid no-undo .
     6050   IF par-mode = 'продажа':U then do:
     6051   CASE del-type:
     6052      when "list":U then do:
     6053           if index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0 then do:
     6054          message
     6055          "Вы хотите исключить ВСЕ чеки с товаром, проданным по данному бар-коду из продажи!" skip
     6056          "Эта процедура может занять долгое время! Продолжать?"
     6057          view-as alert-box WARNING buttons YES-NO update glog.
     6058          if NOT glog then return error.
     6059        end.
     6060        ELSE DO:
     6061          message
     6062          "Вы действительно хотите исключить ВСЕ чеки текущему списка с товаром, проданным по данному бар-коду из продажи?!" skip
     6063          view-as alert-box WARNING buttons YES-NO update glog.
     6064          if NOT glog then return error.
     6065        END.
     6066         DO WHILE available c-doc :
     6067               GET prev br-docs no-lock.
     6068         END.
     6069         GET next br-docs.
     6070         _list0:
     6071         DO WHILE available c-doc
     6072         on error undo, next _list0
     6073         on stop undo, next _list0
     6074         :
     6075           v-doc-rec = recid( c-doc ).
     6076           FIND FIRST del_chk-doc where
     6077                             recid (del_chk-doc) = v-doc-rec No-ERROR.
     6078           if not avail del_chk-doc then NEXT _list0.
     6079           if del_chk-doc.out-code <> ? then DO  :
     6080             run waitfram-show in this-procedure ( input "Ждите...").
     6081             FIND FIRST buf_inkas No-LOCK WHERE
     6082                             buf_inkas.inkas-code = del_chk-doc.out-code No-ERROR.
     6083             assign
     6084             old-netto = buf_inkas.netto
     6085             old-tot-doc = buf_inkas.tot-doc
     6086             old-discnt = buf_inkas.discnt.
     6087             run str/excl-chk.p (
     6088                                 input parparentproc
     6089                               , input v-curr-r-b
     6090                              , buffer del_chk-doc) no-error.
     6091             if error-status:error OR
     6092             buf_inkas.netto <> old-netto  - del_chk-doc.netto OR
     6093             buf_inkas.tot-doc <> old-tot-doc  - del_chk-doc.tot-doc OR
     6094             buf_inkas.discnt <> old-discnt - del_chk-doc.discnt then do:
     6095               message
     6096               substitute("Исключение чека &1 из продажи &2 не удалось:&3&4 &5"
     6097                        ,del_chk-doc.doc-code
     6098                        ,buf_inkas.inkas-code
     6099                        , chr(10)
     6100                        ,error-status:get-message(1)
     6101                        ,return-value
     6102                        )
     6103               view-as alert-box ERROR.
     6104               undo, NEXT.
     6105             end.
     6106             deleted = yes.
     6107           END.
     6108           GET next br-docs.
     6109         END.
     6110         run waitfram-hide in this-procedure .
     6111         del-type = "".
     6112         RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6113         APPLY "page-UP"   to br-docs.
     6114         APPLY "page-down"   to br-docs.
     6115         reposition br-docs to row 1 no-error.
     6116         apply "entry" to br-docs in frame Dialog-Frame.
     6117      end.
     6118      when "one":U then do:
     6119       if c-doc.out-code <> ? then do:
     6120       v-doc-rec = recid (c-doc).
     6121          get prev br-docs .
     6122          v-rec = ?.
     6123          if not available chk-gds then get first br-docs.
     6124          else do :
     6125           v-rec = recid(chk-gds).
     6126          end.
     6127          FIND FIRST del_chk-doc where
     6128                     recid (del_chk-doc) = v-doc-rec No-ERROR.
     6129          if not avail del_chk-doc then return error.
     6130          FIND FIRST buf_inkas No-LOCK WHERE
     6131                     buf_inkas.inkas-code = del_chk-doc.out-code No-ERROR.
     6132          assign
     6133          old-netto = buf_inkas.netto
     6134          old-tot-doc = buf_inkas.tot-doc
     6135          old-discnt = buf_inkas.discnt.
     6136          del-type = "".
     6137          run str/excl-chk.p (   input parparentproc
     6138                           , input v-curr-r-b
     6139                           , buffer del_chk-doc) no-error.
     6140          if error-status:error  OR
     6141          buf_inkas.netto <> old-netto  - del_chk-doc.netto OR
     6142          buf_inkas.tot-doc <> old-tot-doc  - del_chk-doc.tot-doc OR
     6143          buf_inkas.discnt <> old-discnt - del_chk-doc.discnt then do:
     6144            message
     6145            substitute("Исключение чека &1 из продажи &2 не удалось:&3&4 &5"
     6146                        ,del_chk-doc.doc-code
     6147                        ,buf_inkas.inkas-code
     6148                        , chr(10)
     6149                        ,error-status:get-message(1)
     6150                        ,return-value
     6151                        )
     6152            view-as alert-box ERROR.
     6153            return error.
     6154          end.
     6155          deleted = yes.
     6156          RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6157          if v-rec <> ? then reposition br-docs to recid v-rec no-error.
     6158          do with frame dialog-frame:
     6159             apply "entry":u to browse br-docs .
     6160             apply "VALUE-CHANGED":u to browse br-docs .
     6161          end.
     6162       end.
     6163     end.
     6164   END CASE.
     6165   end.
     6166   END PROCEDURE.
     6167   PROCEDURE proc-b-sch :
     6168   assign
     6169     tbl = 'chk-gds'
     6170     join-tbl = 'chk-gds'
     6171     fld = ""
     6172     lab = ""
     6173     spr = ""
     6174     dim = '0'
     6175     .
     6176   run fltfield-add in this-procedure('doc-code', 'Номер в базе', '',
     6177   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6178   run fltfield-add in this-procedure('chk-date', 'Дата чека', '',
     6179   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6180   run fltfield-add in this-procedure('out-code', 'Номер продажи', '',
     6181   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6182   run fltfield-add in this-procedure('line-num', 'Номер строки', '',
     6183   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6184   run fltfield-add in this-procedure('src-code', 'Исходный код', '',
     6185   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6186   run fltfield-add in this-procedure('doc-qnty', 'Кол-во', '',
     6187   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6188   run fltfield-add in this-procedure('price-base', 'Цена продажи', '',
     6189   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6190   run fltfield-add in this-procedure('pump', 'N ТРК', '',
     6191   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6192   run fltfield-add in this-procedure('nozzle-code', 'Пистолет', '',
     6193   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6194   run fltfield-add in this-procedure('loc1', 'Резервуар', '',
     6195   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6196   Filter-Block:
     6197   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     6198       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     6199       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     6200     run gbl/filter.w ( INPUT parparentproc
     6201                     , INPUT (filter-point + chr(4) + filter-label)
     6202                     , INPUT tbl
     6203                     , INPUT join-tbl
     6204                     , INPUT fld
     6205                     , INPUT lab
     6206                     , INPUT spr
     6207                     , INPUT dim ).
     6208     if return-value = 'undo':U then return error.
     6209     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6210   END.
     6211   END PROCEDURE.
     6212   PROCEDURE proc-find-code :
     6213   define input parameter par-next as logical no-undo.
     6214   define input parameter pardoc-code like ub.chk-doc.doc-code no-undo.
     6215   display
     6216   "  /  /":U @ sch-date
     6217   0 @ sch-price
     6218   with frame Dialog-Frame.
     6219   assign
     6220   pardoc-code = chr(34) + pardoc-code + chr(34).
     6221   run OpenBr in this-procedure (
     6222        input false
     6223       ,input par-next
     6224       ,input substitute("and chk-gds.doc-code   begins &1 "
     6225         , pardoc-code)
     6226       ).
     6227   apply "entry":u to sch-code in frame Dialog-Frame .
     6228   END PROCEDURE.
     6229   PROCEDURE proc-find-date :
     6230   define input parameter par-next as logical no-undo.
     6231   define input parameter parchk-date like ub.chk-doc.chk-date no-undo.
     6232   define variable varchk-datechr as character no-undo.
     6233   display
     6234   '':U @ sch-code
     6235   0 @ sch-price
     6236   with frame Dialog-Frame.
     6237   assign
     6238   varchk-datechr = string(day(parchk-date)) + chr(47) +
     6239                    string(month(parchk-date)) + chr(47) +
     6240                    string(year(parchk-date)).
     6241   run OpenBr in this-procedure (
     6242      input false
     6243     ,input true
     6244     ,input substitute("and chk-gds.chk-date = &1 "
     6245       , varchk-datechr)
     6246     ).
     6247   apply "entry":u to sch-date in frame Dialog-Frame.
     6248   END PROCEDURE.
     6249   PROCEDURE proc-find-price :
     6250   define input parameter par-next as logical no-undo.
     6251   define input parameter par-price-base like ub.chk-gds.price-base no-undo.
     6252   display
     6253   "  /  /":U @ sch-date
     6254   "":U @ sch-code
     6255   with frame Dialog-Frame.
     6256   run OpenBr in this-procedure (
     6257        input false
     6258       ,input par-next
     6259       ,input substitute("and chk-gds.price-base = &1 "
     6260         , par-price-base)
     6261       ).
     6262   apply "entry":u to sch-price in frame Dialog-Frame .
     6263   END PROCEDURE.
     6264   PROCEDURE reposition-chk-doc :
     6265   define input  parameter p-direction   as character no-undo .
     6266   define output parameter p-chk-doc-recid as recid no-undo .
     6267   define variable v-chk-gds-recid  as recid no-undo .
     6268     case p-direction :
     6269       when "first":U
     6270       then do:
     6271         get first br-docs.
     6272       end.
     6273       when "last":U
     6274       then do:
     6275         get last br-docs.
     6276       end.
     6277       when "prev":U
     6278       then do:
     6279         get prev br-docs.
     6280         if not available c-doc then do:
     6281           message
     6282           "Это первый чек списка"
     6283           view-as alert-box.
     6284         end.
     6285       end.
     6286       when "next":U
     6287       then do:
     6288         get next br-docs.
     6289         if not available c-doc then do:
     6290           message
     6291           "Это последний чек списка"
     6292           view-as alert-box.
     6293         end.
     6294       end.
     6295     end case .
     6296     assign
     6297     p-chk-doc-recid = recid(c-doc)
     6298     v-chk-gds-recid = recid (chk-gds)
     6299     .
     6300     run reposition-query in this-procedure
     6301       (input v-chk-gds-recid
     6302       ).
     6303   END PROCEDURE.
     6304   PROCEDURE reposition-query :
     6305   define input parameter p-recid as recid no-undo .
     6306     if p-recid <> ?
     6307     then do:
     6308       reposition br-docs to recid p-recid no-error.
     6309     end.
     6310     do with frame Dialog-Frame:
     6311       apply "entry":u to browse BR-docs .
     6312       apply "VALUE-CHANGED":u to browse BR-docs .
     6313     end.
     6314   END PROCEDURE.
