     3545         (INPUT filter-name-37
     3546         ) no-error .
     3547     assign
     3548       l-filter-open-37 = false
     3549     .
     3550     if flt-rec-37 <> ?
     3551       or sort-column-phrase > ""
     3552     then do:
     3553       define variable  parameter-2-37 as character no-undo .
     3554       define variable  parameter-3-37 as character no-undo .
     3555       define variable  parameter-4-37 as character no-undo .
     3556       define variable  parameter-5-37 as character no-undo .
     3557       define variable  parameter-6-37 as character no-undo .
     3558       define variable  parameter-7-37 as character no-undo .
     3559         assign
     3560         parameter-3-37 =
     3561                                 "FOR EACH chk-gds"
     3562         parameter-4-37 =
     3563           (
     3564             if (" chk-gds.b-code = buf_bar-code.b-code " + " " + where-phrase-37) <> ""
     3565             then  substitute('chk-gds.b-code = &1', buf_bar-code.b-code)  + " " + where-phrase-37
