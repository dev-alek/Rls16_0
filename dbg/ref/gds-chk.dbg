     5721   PROCEDURE PrintProc :
     5722   DEFINE VARIABLE date_string     as      char    no-undo.
     5723   DEFINE VARIABLE Line                as      char    no-undo.
     5724   DEFINE VARIABLE for-time as char.
     5725   DEFINE VARIABLE accum-count as integer.
     5726   DEFINE VARIABLE accum-tot-doc as decimal.
     5727   DEFINE VARIABLE accum-discnt as decima.
     5728   DEFINE VARIABLE accum-sub-discnt as decimal.
     5729   DEFINE VARIABLE accum-netto as decimal.
     5730   define variable v-shift-name-num as character no-undo .
     5731   DEFINE VARIABLE v-doc-code like ub.chk-doc.doc-code no-undo .
     5732   define variable v-header-base-curr as character no-undo .
     5733   define variable v-base-code like ub.sysconf.host-code no-undo .
     5734   define variable v-base-type like ub.currency.curr-abbr no-undo .
     5735   define variable V-RECEIPT-NAME as character no-undo .
     5736   define buffer buf_currency for ub.currency.
     5737   if v-curr-r-b = 'base':U then do:
     5738     if v-print-host-code <> ? then do:
     5739   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5740   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5741     (input  v-print-host-code
     5742     ,output v-base-code
     5743     )  .
     5744       find first buf_currency where
     5745               buf_currency.curr-code = v-base-code.
     5746       assign
     5747       v-base-type = buf_currency.curr-abbr.
     5748     end.
     5749   end.
     5750   assign
     5751   v-header-base-curr = string( "( Б.Вал. - " + caps( v-base-type ) + " )" )
     5752   .
     5753   DEFINE FRAME Chk-List
     5754   c-doc.office        column-label "Тип"                format "X(8)"
     5755   c-doc.doc-code      column-label "Номер_чека/Номер_строки"  format "X(23)"
     5756   V-RECEIPT-NAME      COLUMN-LABEL "Тип_чека" format "X(8)"
     5757   c-doc.chk-num       column-label "N_касс" format "->>>>>>9"
     5758   c-doc.chk-date      column-label "Дата" format "99/99/9999"
     5759   for-time            column-label "Время"   format "X(5)"
     5760   c-doc.shift-date    column-label "Смена_от" format "99/99/9999"
     5761   v-shift-name-num    column-label "№_см." FORMAT "X(6)"
     5762   c-doc.tot-doc       column-label "Сумма_товарная"
     5763   c-doc.discnt        column-label "Скидка_общая"
     5764   c-doc.sub-discnt    column-label "Списания"
     5765   c-doc.netto         column-label "Сумма_оплат"
     5766   c-doc.pay-desk      column-label "Касса"
     5767   c-doc.cashier       column-label "Кассир"       format ">>>>9"
     5768   c-doc.sales-man     column-label "Прод-ц"       format ">>>>9"
     5769   c-doc.out-code      column-label "Номер_РН"
     5770   c-doc.d-card        column-label "Номер_диск.карты" format "X(16)" space(0)
     5771   HEADER  date_string AT 5 format "X(35)"
     5772   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5773   v-header-base-curr        format "X(20)"
     5774   Line format "X(198)" AT 1
     5775   with width 232 down stream-io use-text    .
     5776   Line = fill("-", 198).
     5777   date_string = cur-time-print() .
     5778   run prn-lib-open-stream  in this-procedure (
     5779                                                input parParentProc
     5780                                               ,input 43
     5781                                               ,input yes
     5782                                               ,input no
     5783                                               ).
     5784   PUT  STREAM PrnLibStream
     5785   ( frame Dialog-Frame:title )
     5786   format "x(198)" SKIP(1) .
     5787   FORM HEADER
     5788   Line format "X(198)" AT 1 SKIP
     5789   "Продолжение - на следующей странице" AT 30 SKIP
     5790   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5791   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5792   FORM with FRAME Chk-List  .
     5793   run waitfram-show in this-procedure ( input "Ждите...").
     5794   GET next br-docs no-lock.
     5795   assign
