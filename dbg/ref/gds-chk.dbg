     1073   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074   define new shared temp-table gds-list no-undo like ub.goods
     1075     field qnty   as decimal
     1076     field to-del as logical
     1077     field order-num as integer
     1078     field to-sel as logical
     1079     field promo-code as character
     1080     field ActionId  as int64
     1081     field db-num as integer
     1082     index art  is primary unique artic prod-type prod-code
     1083     index code is         unique gds-code
     1084     index oi order-num
     1085     index isel to-sel
     1086     .
     1087   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1088   define  new shared  temp-table gds-list-hist no-undo
     1089   field list-table as character
     1090   field id as integer
     1091   field line as integer
     1092   field hist-mode as character
     1093   field des as character
     1094   field num-recs as integer
     1095   field option_ as character
     1096   field item_ as character
     1097   field status_ as character
     1098   field num-add as integer
     1099   field num-ignored as integer
     1100   field done as logical
     1101   field err_ as logical
     1102   field err-mes as character
     1103   index pi is primary
     1104   id
     1105   line
     1106   index isdone
     1107   done
     1108   .
     1109   def temp-table gds-bar no-undo
     1110   field b-code like ub.bar-code.b-code
     1111   field qnty   as decimal
     1112   index art is unique b-code .
     1113   DEFINE MENU m-print
     1114          MENU-ITEM m-gds          LABEL "Список строк чеков"
     1115          RULE
     1116          MENU-ITEM m-one-time     LABEL "Игнорировать повторение строк чеков"
     1117                 TOGGLE-BOX
     1118          MENU-ITEM m-list         LABEL "Список чеков"
     1119          RULE
     1120          MENU-ITEM m-one          LABEL "Чек"
     1121          MENU-ITEM m-spcf         LABEL "Спецификация"  .
     1122   DEFINE MENU MENU-B-del
     1123          MENU-ITEM m_one          LABEL "Один чек"
     1124          MENU-ITEM m_list         LABEL "Список чеков"  .
     1125   DEFINE BUTTON b-allgood
     1126        LABEL "Все &БК"
     1127        SIZE 10 BY 1.
     1128   DEFINE BUTTON B-del
     1129        LABEL "Искл&ючить"
     1130        SIZE 10 BY 1.
     1131   DEFINE BUTTON B-Help
     1132        LABEL "Помо&щь"
     1133        SIZE 3 BY 1
     1134        BGCOLOR 8 .
     1135   DEFINE BUTTON b-lkp
     1136        LABEL "&Просмотр"
     1137        SIZE 10 BY 1.
     1138   DEFINE BUTTON B-mark
     1139        LABEL "&*"
     1140        SIZE 3 BY 1.
     1141   DEFINE BUTTON B-print
     1142        LABEL "Пе&чать"
     1143        SIZE 3 BY 1.
     1144   DEFINE BUTTON b-quit AUTO-END-KEY
     1145        LABEL "&Выход"
     1146        SIZE 10 BY 1
     1147        BGCOLOR 8 .
     1148   DEFINE BUTTON B-sale
     1149        LABEL "П&родажа"
     1150        SIZE 10 BY 1.
     1151   DEFINE BUTTON B-sch
     1152        LABEL "&Фильтр"
     1153        SIZE 3 BY 1.
     1154   DEFINE BUTTON b-sel AUTO-GO
     1155        LABEL "Вы&бор"
     1156        SIZE 10 BY 1
     1157        BGCOLOR 8 .
     1158   DEFINE VARIABLE Cb-chk-type AS CHARACTER FORMAT "X(256)":U
     1159        VIEW-AS COMBO-BOX INNER-LINES 10
     1160        LIST-ITEMS "Item 1"
     1161        DROP-DOWN-LIST
     1162        SIZE 19 BY 1
     1163        BGCOLOR 15  NO-UNDO.
     1164   DEFINE VARIABLE ED-notes AS CHARACTER
     1165        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1166        SIZE 98 BY 2
     1167        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1168   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1169         VIEW-AS TEXT
     1170        SIZE 6 BY 1
     1171        FGCOLOR 4  NO-UNDO.
     1172   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(20)":U
     1173        LABEL "номеру"
     1174        VIEW-AS FILL-IN
     1175        SIZE 19.1 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1176   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U
     1177        LABEL "дате"
     1178        VIEW-AS FILL-IN
     1179        SIZE 11.6 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1180   DEFINE VARIABLE sch-price AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
     1181        LABEL "цене"
     1182        VIEW-AS FILL-IN
     1183        SIZE 19.1 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1184   DEFINE VARIABLE RS-sort AS CHARACTER
     1185        VIEW-AS RADIO-SET HORIZONTAL
     1186        RADIO-BUTTONS
     1187             "Без сортировки/по фильтру", "unsort",
     1188   "По коду чека в БД", "doc-code"
     1189        SIZE 51.9 BY 1.13 NO-UNDO.
     1190   DEFINE QUERY BR-docs FOR
     1191                   ub.chk-gds,
     1192                   ub.c-doc SCROLLING.
     1193   DEFINE BROWSE BR-docs
     1194     QUERY BR-docs DISPLAY
     1195         c-doc.office FORMAT "X(7)":U
     1196     mark-string(recid(chk-gds), rid-list) COLUMN-LABEL '*' FORMAT "X(1)":U
     1197     c-doc.doc-code COLUMN-LABEL "Номер_чека" FORMAT "X(20)":U
     1198     entry (lookup (string(c-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U) COLUMN-LABEL 'Тип_чека' FORMAT "X(8)":U
     1199     chk-gds.line-num COLUMN-LABEL "NN" FORMAT "->>9":U
     1200     c-doc.chk-num COLUMN-LABEL "N_по_кассе" FORMAT "->>>>>>>>9":U
     1201     c-doc.chk-date FORMAT "99/99/9999":U
     1202     (string (c-doc.chk-time, 'HH:MM')) COLUMN-LABEL 'Время'
     1203     chk-gds.doc-qnty FORMAT "->>,>>>,>>9.<<<":U
     1204     chk-gds.price-base FORMAT "->>>,>>>,>>9.99":U
     1205     chk-gds.discnt FORMAT "->>>,>>>,>>9.99":U
     1206     (chk-gds.discnt / chk-gds.price-base * 100) COLUMN-LABEL '%' FORMAT "->>9.<%":U
     1207     (chk-gds.price-base - chk-gds.discnt) COLUMN-LABEL 'Нетто цена' FORMAT "->>>,>>>,>>9.99":U
     1208     chk-gds.pump COLUMN-LABEL 'ТРК' FORMAT ">9":U
     1209     chk-gds.nozzle-code COLUMN-LABEL 'Пист' FORMAT ">>9":U
     1210     chk-gds.loc1 COLUMN-LABEL 'Рез' FORMAT "X(3)":U
     1211     entry (lookup (string(chk-gds.write-off-code),  '?,0,1,-6,-9,2,-2,3,-3,-4,17':U), ',,Без_оплаты,Отмена_позиции,Полн_Отмена,Модификатор,Модификатор,Модификатор(+спис),Модификатор(-спис),Модификатор(-спис),Техпролив':U) COLUMN-LABEL 'Код_спис' FORMAT "X(10)":U
     1212     c-doc.shift-date COLUMN-LABEL "Смена_от" FORMAT "99/99/9999":U
     1213    shift-name-no-err( buffer c-doc) COLUMN-LABEL "№_см." FORMAT "X(6)":U
     1214     c-doc.shift-date COLUMN-LABEL "Смена_от" FORMAT "99/99/9999":U
     1215     c-doc.shift-num COLUMN-LABEL "П" FORMAT ">9":U
     1216     c-doc.netto COLUMN-LABEL "Сумма_оплат" FORMAT "->>>,>>>,>>9.99":U
     1217     c-doc.tot-doc COLUMN-LABEL "Сумма_товарная" FORMAT "->>>,>>>,>>9.99":U
     1218     c-doc.discnt COLUMN-LABEL "Скидка_общая" FORMAT "->>>,>>>,>>9.99":U
     1219     c-doc.sub-discnt COLUMN-LABEL "Списания" FORMAT "->>>,>>>,>>9.99":U
     1220     c-doc.pay-desk FORMAT ">>>9":U
     1221     c-doc.cashier FORMAT "99999":U
     1222     c-doc.sales-man COLUMN-LABEL "Прод-w" FORMAT "99999":U
     1223     c-doc.out-code COLUMN-LABEL "Номер_РН" FORMAT "X(14)":U
     1224     c-doc.d-card COLUMN-LABEL "N_диск._карты" FORMAT "X(19)":U
     1225     c-doc.doc-num COLUMN-LABEL "№_док-та" FORMAT "X(19)":U
     1226     ENABLE
     1227     c-doc.cashier
     1228       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.03.
     1229   DEFINE FRAME Dialog-Frame
     1230        b-quit AT ROW 1 COL 1
     1231        B-mark AT ROW 1 COL 11
     1232        b-sel AT ROW 1 COL 21
     1233        b-lkp AT ROW 1 COL 31
     1234        b-allgood AT ROW 1 COL 41
     1235        B-del AT ROW 1 COL 51
     1236        B-sale AT ROW 1 COL 61
     1237        B-print AT ROW 1 COL 89
     1238        B-sch AT ROW 1 COL 92
     1239        B-Help AT ROW 1 COL 95
     1240        Cb-chk-type AT ROW 2 COL 1 NO-LABEL
     1241        RS-sort AT ROW 2.03 COL 45 NO-LABEL
     1242        BR-docs AT ROW 3.3 COL 1
     1243        ED-notes AT ROW 18.67 COL 1 NO-LABEL
     1244        sch-code AT ROW 20.8 COL 17.6 COLON-ALIGNED
     1245        sch-date AT ROW 20.83 COL 48.3 COLON-ALIGNED
     1246        sch-price AT ROW 20.83 COL 77.5 COLON-ALIGNED
     1247        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1248        "ПОИСК ПО" VIEW-AS TEXT
     1249             SIZE 9.3 BY 1 AT ROW 20.8 COL 1.5
     1250             FGCOLOR 4
     1251        "Сортировка" VIEW-AS TEXT
     1252             SIZE 12.8 BY .8 AT ROW 2.3 COL 30
     1253             FGCOLOR 4
     1254        SPACE(56.20) SKIP(18.89)
     1255       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1256            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1257            TITLE ""
     1258            CANCEL-BUTTON b-quit.
     1259   ASSIGN
     1260          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1261          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1262   ASSIGN
     1263          B-del:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-del:HANDLE.
     1264   ASSIGN
     1265          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-print:HANDLE.
     1266   ON ENDKEY OF FRAME Dialog-Frame
     1267   DO:
     1268     if deleted then return "deleted".
     1269   END.
     1270   ON GO OF FRAME Dialog-Frame
     1271   DO:
     1272     if deleted then return "deleted".
     1273   END.
     1274   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1275   DO:
     1276     APPLY "END-ERROR":U TO SELF.
     1277   END.
     1278   ON CHOOSE OF b-allgood IN FRAME Dialog-Frame
     1279   DO:
     1280   DEFINE VARIABLE rid-list as character no-undo .
     1281      run ref/gds-chks.w ( input parparentproc
     1282                     ,input recid(buf_goods)
     1283                     ,input bttns
     1284                     ,input "gds-chk":U + chr(44) + par-mode
     1285                     ,input ?
     1286                     ,input parobj-type
     1287                     ,input parobj-code
     1288                     ,input parout-code
     1289                     ,input pard-card
     1290                     ,output rid-list
     1291                       ).
     1292   END.
     1293   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1294   DO:
     1295      if not available c-doc then return no-apply.
     1296    if del-type = "" then do:
     1297       run gbl/pop-up.p ( input b-del:handle, input no) no-error.
     1298       if error-status:error then return no-apply.
     1299    end.
     1300    if del-type = "" then return no-apply.
     1301    run proc-b-del in this-procedure ( input del-type) no-error.
     1302     if error-status:error then do:
     1303       del-type = '':U.
     1304       return no-apply.
     1305   end.
     1306   END.
     1307   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1308   DO:
     1309   define variable next-prev as character no-undo .
     1310     next-prev = '':U.
     1311     DO WHILE next-prev = '':U:
     1312           if NOT available c-doc then do:
     1313                   message "Неправильно выбран чек." view-as alert-box ERROR.
     1314                   return no-apply.
     1315           end.
     1316           v-doc-rec = recid (c-doc).
     1317           .
     1318          run str/superchk.w
     1319                         (
     1320                           input parparentproc
     1321                          ,input 'ПРОСМОТР':U
     1322                          ,input c-doc.obj-type
     1323                          ,input c-doc.obj-code
     1324                          ,input-output v-doc-rec
     1325                          ,input this-procedure:handle
     1326                          ,input-output next-prev
     1327                                       ).
     1328     END .
     1329     apply "entry" to br-docs in frame Dialog-Frame.
     1330     apply "value-changed" to br-docs in frame Dialog-Frame.
     1331   END.
     1332   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1333   DO:
     1334   define variable glog as logical no-undo .
     1335       if available chk-gds then do:
     1336   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1337   define variable v-str-recid16 as character no-undo .
     1338   define variable v-num-entry16 as integer   no-undo .
     1339   assign
     1340     v-str-recid16 = trim( string( recid( chk-gds ) , "->>>>>>>>>>>9":U ) )
     1341     v-num-entry16 = lookup( v-str-recid16 , rid-list )
     1342   .
     1343   if v-num-entry16 > 0 then do:
     1344     assign
     1345       entry( v-num-entry16, rid-list ) = "":U
     1346       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1347     .
     1348   end.
     1349   else do:
     1350     assign
     1351       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1352     .
     1353   end.
     1354         glog = br-docs:refresh() .
     1355         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1356             glog = br-docs:select-next-row ().
     1357             apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1358         end.
     1359         if num-entries( rid-list ) = 0
     1360         then
     1361             hide mark-num in frame Dialog-Frame.
     1362         else
     1363             disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     1364       end.
     1365       apply "entry" to br-docs in frame Dialog-Frame.
     1366   END.
     1367   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1368   DO:
     1369   define variable glog as logical no-undo .
     1370   define variable v-doc-rec as recid no-undo .
     1371     def buffer s-doc for ub.trn-doc.
     1372     if not avail chk-gds then do:
     1373       print-type = "":U.
     1374       return no-apply.
     1375     end.
     1376      if print-type = "" then do:
     1377        run gbl/pop-up.p ( input self:handle, input no) no-error.
     1378      end.
     1379      if print-type = "list":U or print-type = "gds":U then do:
     1380         if (par-mode = 'объект':U or par-mode = 'все':U) and index(frame Dialog-Frame:title,"ФИЛЬТР" ) = 0 then do:
     1381           CASE print-type:
     1382             when "list":U then do:
     1383                  message "Вы хотите напечатать весь список чеков при невключенном фильтре!" skip
     1384                  "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1385                 WARNING buttons YES-NO update glog.
     1386                 if NOT glog then return no-apply.
     1387             end.
     1388             when "gds":U then do:
     1389                  message "Вы хотите напечатать все строки чеков при невключенном фильтре!" skip
     1390                  "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1391                 WARNING buttons YES-NO update glog.
     1392                 if NOT glog then return no-apply.
     1393             end.
     1394           END CASE.
     1395         end.
     1396         v-doc-rec = recid( chk-gds ).
     1397         DO WHILE available chk-gds :
     1398               GET prev br-docs no-lock.
     1399         END.
     1400         CASE print-type:
     1401           when "list":U then do:
     1402             run PrintProc in this-procedure.
     1403           end.
     1404           when "gds":U then do:
     1405             run PrintProcGds in this-procedure.
     1406           end.
     1407        END CASE.
     1408         print-type = "".
     1409         reposition br-docs to recid v-doc-rec no-error.
     1410         apply "entry" to br-docs in frame Dialog-Frame.
     1411       end.
     1412       else do:
     1413           if NOT available c-doc then do:
     1414               message "Неправильно выбран чек." view-as alert-box ERROR.
     1415               return no-apply.
     1416           end.
     1417           CASE print-type:
     1418               when "one":U then do:
     1419                   run str/checkp.p ( input parparentproc, input c-doc.doc-code) no-error.
     1420                   print-type = "".
     1421               end.
     1422               when "spcf":U then do:
     1423                  if can-do( 'т':U, c-doc.office ) AND ( c-doc.d-card <> "" ) then
     1424                  run rep/r-specsr.p ( input parparentproc, input recid( c-doc ), input 'касс':U ) .
     1425                 else
     1426                 message "Чек все еще ошибочный ! " view-as alert-box ERROR.
     1427               end.
     1428           END CASE.
     1429       end.
     1430   END.
     1431   ON CHOOSE OF B-sale IN FRAME Dialog-Frame
     1432   DO:
     1433       if NOT available chk-gds then do:
     1434           message "Неправильно выбран чек." view-as alert-box ERROR.
     1435           return no-apply.
     1436       end.
     1437       FIND find_inkas where
     1438               find_inkas.inkas-code = chk-gds.out-code NO-LOCK no-error.
     1439       if NOT available find_inkas then do:
     1440               message "Для данного чека нет отчета о продаже.".
     1441               return no-apply.
     1442        end.
     1443       run str/ink-lkp.p ( input parparentproc
     1444                     ,input recid(find_inkas) ).
     1445   END.
     1446   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1447   DO:
     1448     run proc-b-sch in this-procedure no-error.
     1449     if error-status:error then return no-apply.
     1450   END.
     1451   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1452   DO:
     1453     if ( available chk-gds ) AND ( rid-list = "" ) then
     1454       rid-list = string( recid( chk-gds ) ) .
     1455   END.
     1456   ON ANY-PRINTABLE OF BR-docs IN FRAME Dialog-Frame
     1457   DO:
     1458       sch-code:screen-value = sch-code:screen-value + last-event:label.
     1459       apply "entry" to sch-code in frame Dialog-Frame.
     1460   apply "end" to sch-code in frame Dialog-Frame.
     1461   END.
     1462   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     1463   DO:
     1464     if b-mark:sensitive in frame Dialog-Frame then
     1465     APPLY "CHOOSE" to b-mark.
     1466   END.
     1467   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     1468   DO:
     1469     if b-mark:sensitive in frame Dialog-Frame then
     1470     APPLY "CHOOSE" to b-mark.
     1471       else do:
     1472         if b-sel:sensitive in frame Dialog-Frame then
     1473         APPLY "CHOOSE" to b-sel.
     1474       end.
     1475   END.
     1476   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1477   OR MOUSE-SELECT-DBLCLICK OF BR-docs IN FRAME Dialog-Frame
     1478   DO:
     1479         if b-sel:sensitive in frame Dialog-Frame  = yes then
     1480           apply "choose" to b-sel in frame Dialog-Frame.
     1481       else
     1482           apply "choose" to b-lkp in frame Dialog-Frame.
     1483   END.
     1484   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1485   DO:
     1486       DEFINE VARIABLE dops as character no-undo .
     1487     dops = if available c-doc then c-doc.ps else '':U.
     1488     ED-notes:screen-value = dops.
     1489   END.
     1490   ON VALUE-CHANGED OF Cb-chk-type IN FRAME Dialog-Frame
     1491   DO:
     1492     ASSIGN
     1493     CB-chk-type
     1494     p-chk-type = integer(cb-chk-type)
     1495     .
     1496     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1497   END.
     1498   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1499   DO:
     1500     define buffer ps_chk-doc for ub.chk-doc.
     1501      DO on stop undo, return no-apply:
     1502           FIND PS_chk-doc where recid (ps_chk-doc) = recid(c-doc) exclusive.
     1503           if ps_CHk-doc.PS <> input frame Dialog-Frame ed-notes then
     1504           ps_chk-doc.PS = input frame Dialog-Frame ed-notes.
     1505       END.
     1506   END.
     1507   ON CHOOSE OF MENU-ITEM m-gds
     1508   DO:
     1509       print-type = "gds":U.
     1510       apply "choose" to b-print in frame Dialog-Frame.
     1511   END.
     1512   ON CHOOSE OF MENU-ITEM m-list
     1513   DO:
     1514       print-type = "list":U.
     1515       apply "choose" to b-print in frame Dialog-Frame.
     1516   END.
     1517   ON CHOOSE OF MENU-ITEM m-one
     1518   DO:
     1519       print-type = "one":U.
     1520       apply "choose" to b-print in frame Dialog-Frame.
     1521   END.
     1522   ON VALUE-CHANGED OF MENU-ITEM m-one-time
     1523   DO:
     1524     assign
     1525     v-one-time = menu-item m-one-time:checked in menu m-print.
     1526   END.
     1527   ON CHOOSE OF MENU-ITEM m_list
     1528   DO:
     1529       del-type = "list":U.
     1530       apply "choose" to b-del in frame Dialog-Frame.
     1531   END.
     1532   ON CHOOSE OF MENU-ITEM m_one
     1533   DO:
     1534       del-type = "one":U.
     1535       apply "choose" to b-del in frame Dialog-Frame.
     1536   END.
     1537   ON VALUE-CHANGED OF RS-sort IN FRAME Dialog-Frame
     1538   DO:
     1539     assign
     1540     RS-sort.
     1541     Run OpenBr in this-procedure ( input yes, input no, input '':U).
     1542   END.
     1543   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1544   DO:
     1545     run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1546     if error-status:error then return no-apply.
     1547   END.
     1548   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1549   DO:
     1550     run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1551     if error-status:error then return no-apply.
     1552   END.
     1553   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     1554   DO:
     1555       run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-date) no-error.
     1556     if error-status:error then return no-apply.
     1557   END.
     1558   ON RETURN OF sch-date IN FRAME Dialog-Frame
     1559   DO:
     1560     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-date) no-error.
     1561     if error-status:error then return no-apply.
     1562   END.
     1563   ON CTRL-J OF sch-price IN FRAME Dialog-Frame
     1564   DO:
     1565     run proc-find-price in this-procedure ( input yes, input frame Dialog-Frame sch-price) no-error.
     1566     if error-status:error then return no-apply.
     1567   END.
     1568   ON RETURN OF sch-price IN FRAME Dialog-Frame
     1569   DO:
     1570     run proc-find-price in this-procedure ( input no, input frame Dialog-Frame sch-price) no-error.
     1571     if error-status:error then return no-apply.
     1572   END.
     1573   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1574   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1575   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1576   on help of frame Dialog-Frame
     1577   do:
     1578     run gbl/app_help.p
     1579       (input this-procedure :file-name
     1580       ,input ''
     1581       ,input ?
     1582       ) no-error.
     1583     if error-status :error then do:
     1584       message
     1585         "Ошибка при вызове помощи"
     1586         error-status :get-message(1)
     1587         view-as alert-box .
     1588     end.
     1589   end.
     1590   run minbtn-set in this-procedure .
     1591   on choose of b-help in frame Dialog-Frame
     1592   do:
     1593     apply "help":u to frame Dialog-Frame .
     1594   end.
     1595   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1596   procedure minbtn-set :
     1597       do
     1598           on error undo, return error return-value
     1599           :
     1600           define variable ii              as integer       no-undo .
     1601           define variable fh              as widget-handle no-undo .
     1602           define variable hh              as widget-handle no-undo .
     1603           define variable v-h             as handle        extent 4 no-undo .
     1604           define variable v-name-button   as character     no-undo .
     1605           define variable v-help-old-x    as decimal       no-undo .
     1606           define variable v-help-old-y    as decimal       no-undo .
     1607           define variable v-help-old-size as decimal       no-undo .
     1608           define variable v-frame-width   as decimal       no-undo .
     1609           define variable jj              as integer       no-undo .
     1610           do
     1611               on error undo, return error
     1612               :
     1613               assign
     1614                   v-frame-width = frame Dialog-Frame:width - 0.3
     1615                   fh            = frame Dialog-Frame:first-child
     1616                   hh            = fh:first-child
     1617                   ii            = 1
     1618                   .
     1619               do while valid-handle(hh):
     1620                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1621                   do:
     1622                       case lc(hh:name) :
     1623                           when "b-help" then
     1624                               do:
     1625                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1626                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1627                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1628                                   hh:TOOLTIP = "Помощь" .
     1629                                   v-help-old-x = hh:column .
     1630                                   v-help-old-y = hh:row    .
     1631                                   v-help-old-size = hh:width .
     1632                                   hh:width-chars = 2.5 .
     1633                               end.
     1634                           when "b-print" then
     1635                               do:
     1636                                   hh:load-image("cmp/b-print.bmp":u) .
     1637                                   hh:TOOLTIP = "Печать" .
     1638                                   v-h[ii] = hh:handle .
     1639                                   ii = ii + 1 .
     1640                                   hh:width-chars = 3 .
     1641                               end.
     1642                           when "b-history" or
     1643                           when "b-hist" then
     1644                               do:
     1645                                   hh:load-image("cmp/b-hist.bmp":u) .
     1646                                   hh:TOOLTIP = "История" .
     1647                                   v-h[ii] = hh:handle .
     1648                                   ii = ii + 1 .
     1649                                   hh:width-chars = 3 .
     1650                               end.
     1651                           when "b-sch" then
     1652                               do:
     1653                                   hh:load-image("cmp/b-sch.bmp":u) .
     1654                                   hh:TOOLTIP = "Установка Фильтра" .
     1655                                   v-h[ii] = hh:handle .
     1656                                   ii = ii + 1 .
     1657                                   hh:width-chars = 3 .
     1658                               end.
     1659                           when "b-hist-user" then
     1660                               do:
     1661                                   hh:load-image("cmp/b-hist.bmp":u) .
     1662                                   hh:TOOLTIP = "История пользователя" .
     1663                                   ii = ii + 1 .
     1664                               end.
     1665                       end case.
     1666                   end.
     1667                   hh = hh:next-sibling.
     1668               end.
     1669               b-help:column = v-frame-width - b-help:width-chars.
     1670               jj = 0.
     1671               repeat ii = 4 to 1 by -1 :
     1672                   if valid-handle (v-h[ii] ) then
     1673                   do:
     1674                       jj  = jj + 1 .
     1675                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1676                       v-h[ii]:row    = v-help-old-y .
     1677                   end.
     1678               end.
     1679           end.
     1680       end.
     1681   end procedure.
     1682   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1683   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1684   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1685   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1686   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1687   define variable v-diasize-current-frame-height as decimal   no-undo .
     1688   define variable v-diasize-change-size          as logical   no-undo .
     1689   define variable v-diasize-resize-button        as handle    no-undo .
     1690   define variable v-diasize-wndmax               as logical   no-undo .
     1691   define variable v-diasize-wndstore             as logical   no-undo .
     1692   define variable v-diasize-proc-name            as character no-undo .
     1693   define variable v-diasize-browse-handle        as handle    no-undo .
     1694   define variable v-diasize-browse-number        as integer   no-undo .
     1695   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1696   define temp-table temp-diasize-handle no-undo
     1697     field handle-value  as handle
     1698     field save-position as decimal
     1699     index xpk is primary unique handle-value
     1700     .
     1701   define temp-table temp-browse-handle no-undo
     1702     field browse-type   as character
     1703     field browse-number as integer
     1704     field browse-handle as handle
     1705     field original-size as decimal
     1706     index xpk is primary unique browse-type browse-number
     1707     index xie browse-type browse-handle
     1708   .
     1709   procedure diasize_change-height :
     1710     define input  parameter p-change-value  as decimal   no-undo .
     1711     define input  parameter p-move-resize   as logical   no-undo .
     1712     define variable v-field-group-handle    as handle    no-undo .
     1713     define variable v-object-handle         as handle    no-undo .
     1714     define variable v-frame-height          as decimal   no-undo .
     1715     define variable v-frame-virtual-height  as decimal   no-undo .
     1716     define variable v-browse-height         as decimal   no-undo .
     1717     define variable v-window-height         as decimal   no-undo .
     1718     define variable v-window-virtual-height as decimal   no-undo .
     1719     define variable v-change-sign           as integer   no-undo .
     1720     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1721     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1722     if p-change-value > 0
     1723     then do:
     1724       if frame Dialog-Frame :height + p-change-value
     1725           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1726       then do:
     1727         assign
     1728           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1729                           - (frame Dialog-Frame :height-chars)
     1730         .
     1731         if p-change-value <= 0
     1732         then do:
     1733           run diasize_position-resize-button in this-procedure .
     1734           return .
     1735         end.
     1736       end.
     1737     end.
     1738     if p-change-value < 0
     1739     then do:
     1740       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1741       then do:
     1742         assign
     1743           p-change-value = v-diasize-orig-frame-height
     1744                          - (frame Dialog-Frame :height-chars)
     1745         .
     1746         if p-change-value >= 0
     1747         then do:
     1748           run diasize_position-resize-button in this-procedure .
     1749           return .
     1750         end.
     1751       end.
     1752     end.
     1753     if p-change-value >= 0
     1754     then do:
     1755       assign
     1756         v-change-sign = 1
     1757       .
     1758     end.
     1759     else do:
     1760       assign
     1761         v-change-sign = -1
     1762       .
     1763     end.
     1764     assign
     1765       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1766     .
     1767     if p-change-value = 0
     1768     then do:
     1769       run diasize_position-resize-button in this-procedure .
     1770       return .
     1771     end.
     1772     move_block:
     1773     do
     1774     on error undo move_block, retry move_block
     1775     :
     1776       if retry
     1777       then do:
     1778         do
     1779         on error undo move_block, leave move_block
     1780         :
     1781           if p-change-value > 0
     1782           then do:
     1783             for each buf_temp-diasize-handle
     1784             on error undo, next
     1785             :
     1786               assign
     1787                 v-object-handle = buf_temp-diasize-handle.handle-value
     1788               .
     1789               if v-object-handle <> v-diasize-resize-button
     1790               then do:
     1791                 assign
     1792                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1793                 .
     1794               end.
     1795             end.
     1796             assign
     1797               v-diasize-browse-handle :height = v-browse-height
     1798             .
     1799             for each buf_temp-browse-handle
     1800               where buf_temp-browse-handle.browse-type = 'height':u
     1801             on error undo, next
     1802             :
     1803               assign
     1804                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1805               .
     1806             end.
     1807             assign
     1808               frame Dialog-Frame :height = v-frame-height
     1809             .
     1810             if frame Dialog-Frame :scrollable = true
     1811             then do:
     1812               assign
     1813                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1814               .
     1815             end.
     1816             run diasize_position-resize-button in this-procedure .
     1817           end.
     1818           else do:
     1819             if frame Dialog-Frame :scrollable = true
     1820             then do:
     1821               assign
     1822                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1823               .
     1824             end.
     1825             assign
     1826               frame Dialog-Frame :height = v-frame-height
     1827             .
     1828             assign
     1829               v-diasize-browse-handle :height = v-browse-height
     1830             .
     1831             for each buf_temp-browse-handle
     1832               where buf_temp-browse-handle.browse-type = 'height':u
     1833             on error undo, next
     1834             :
     1835               assign
     1836                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1837               .
     1838             end.
     1839             for each buf_temp-diasize-handle
     1840             on error undo, next
     1841             :
     1842               assign
     1843                 v-object-handle = buf_temp-diasize-handle.handle-value
     1844               .
     1845               if v-object-handle <> v-diasize-resize-button
     1846               then do:
     1847                 assign
     1848                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1849                 .
     1850               end.
     1851             end.
     1852             run diasize_position-resize-button in this-procedure .
     1853           end.
     1854           assign
     1855             v-diasize-change-size = false
     1856           .
     1857           leave move_block .
     1858         end.
     1859       end.
     1860       assign
     1861         v-diasize-need-full-display = true
     1862       .
     1863       if v-diasize-change-size = false
     1864       then do:
     1865         assign
     1866           v-diasize-change-size = true
     1867         .
     1868       end.
     1869       else do:
     1870         return .
     1871       end.
     1872       assign
     1873         v-frame-height = frame Dialog-Frame :height
     1874         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1875         v-browse-height = v-diasize-browse-handle :height
     1876       .
     1877       for each buf_temp-browse-handle
     1878         where buf_temp-browse-handle.browse-type = 'height':u
     1879       :
     1880         assign
     1881           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1882         .
     1883       end.
     1884       for each buf_temp-diasize-handle
     1885       :
     1886         delete buf_temp-diasize-handle .
     1887       end.
     1888       assign
     1889         v-field-group-handle = frame Dialog-Frame :first-child
     1890       .
     1891       do while valid-handle(v-field-group-handle)
     1892       :
     1893         assign
     1894           v-object-handle = v-field-group-handle :first-child
     1895         .
     1896         do while valid-handle(v-object-handle)
     1897         :
     1898           if  v-object-handle <> v-diasize-browse-handle :handle
     1899           and can-query(v-object-handle, "row")
     1900           and can-query(v-object-handle, "height")
     1901           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1902           then do:
     1903             find first buf_temp-browse-handle
     1904               where buf_temp-browse-handle.browse-type   = 'height':u
     1905                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1906               no-error .
     1907             if available buf_temp-browse-handle
     1908             then do:
     1909             end.
     1910             else do:
     1911               create buf_temp-diasize-handle .
     1912               assign
     1913                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1914                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1915               .
     1916             end.
     1917           end.
     1918           assign
     1919             v-object-handle = v-object-handle :next-sibling
     1920           .
     1921         end.
     1922         assign
     1923           v-field-group-handle = v-field-group-handle :next-sibling
     1924         .
     1925       end.
     1926       do with frame Dialog-Frame
     1927       :
     1928         hide v-diasize-resize-button .
     1929         assign
     1930           v-diasize-resize-button :row    = 1
     1931           v-diasize-resize-button :column = 1
     1932         .
     1933       end.
     1934       if p-change-value > 0
     1935       then do:
     1936         if frame Dialog-Frame :scrollable = true
     1937         then do:
     1938           assign
     1939             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1940             no-error .
     1941           if error-status :error
     1942           or error-status :get-message(1) <> ""
     1943           then do:
     1944             undo move_block, retry move_block .
     1945           end.
     1946         end.
     1947         assign
     1948           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1949           no-error .
     1950         if error-status :error
     1951         or error-status :get-message(1) <> ""
     1952         then do:
     1953           undo move_block, retry move_block .
     1954         end.
     1955         assign
     1956           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1957           no-error .
     1958         if error-status :error
     1959         or error-status :get-message(1) <> ""
     1960         then do:
     1961           undo move_block, retry move_block .
     1962         end.
     1963         for each buf_temp-browse-handle
     1964           where buf_temp-browse-handle.browse-type = 'height':u
     1965         on error undo move_block, retry move_block
     1966         :
     1967           assign
     1968             buf_temp-browse-handle.browse-handle :height
     1969               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1970             no-error .
     1971           if error-status :error
     1972           or error-status :get-message(1) <> ""
     1973           then do:
     1974             undo move_block, retry move_block .
     1975           end.
     1976         end.
     1977         for each buf_temp-diasize-handle
     1978         on error undo move_block, retry move_block
     1979         :
     1980           assign
     1981             v-object-handle = buf_temp-diasize-handle.handle-value
     1982           .
     1983           if v-object-handle <> v-diasize-resize-button
     1984           then do:
     1985             assign
     1986               v-object-handle :row = v-object-handle :row + p-change-value
     1987               no-error .
     1988             if error-status :error
     1989             or error-status :get-message(1) <> ""
     1990             then do:
     1991               undo move_block, retry move_block .
     1992             end.
     1993           end.
     1994         end.
     1995       end.
     1996       else do:
     1997         for each buf_temp-diasize-handle
     1998         on error undo move_block, retry move_block
     1999         :
     2000           assign
     2001             v-object-handle = buf_temp-diasize-handle.handle-value
     2002           .
     2003           if v-object-handle <> v-diasize-resize-button
     2004           then do:
     2005             assign
     2006               v-object-handle :row = v-object-handle :row + p-change-value
     2007               no-error .
     2008             if error-status :error
     2009             or error-status :get-message(1) <> ""
     2010             then do:
     2011               undo move_block, retry move_block .
     2012             end.
     2013           end.
     2014         end.
     2015         assign
     2016           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2017           no-error .
     2018         if error-status :error
     2019         or error-status :get-message(1) <> ""
     2020         then do:
     2021           undo move_block, retry move_block .
     2022         end.
     2023         for each buf_temp-browse-handle
     2024           where buf_temp-browse-handle.browse-type = 'height':u
     2025         on error undo move_block, retry move_block
     2026         :
     2027           assign
     2028             buf_temp-browse-handle.browse-handle :height
     2029               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2030             no-error .
     2031           if error-status :error
     2032           or error-status :get-message(1) <> ""
     2033           then do:
     2034             undo move_block, retry move_block .
     2035           end.
     2036         end.
     2037         assign
     2038           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2039           no-error .
     2040         if error-status :error
     2041         or error-status :get-message(1) <> ""
     2042         then do:
     2043           undo move_block, retry move_block .
     2044         end.
     2045         if frame Dialog-Frame :scrollable = true
     2046         then do:
     2047           assign
     2048             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2049             no-error .
     2050           if error-status :error
     2051           or error-status :get-message(1) <> ""
     2052           then do:
     2053             undo move_block, retry move_block .
     2054           end.
     2055         end.
     2056       end.
     2057       if p-move-resize = true
     2058       then do:
     2059         run diasize_position-resize-button in this-procedure .
     2060       end.
     2061       if v-diasize-wndstore = true
     2062       then do:
     2063         if connected("ub") = true
     2064         then do:
     2065           define variable v-cntxt-db-num        as integer   no-undo .
     2066           define variable v-cntxt-userid        as character no-undo .
     2067           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2068                                             , OUTPUT v-cntxt-userid
     2069                                             ) .
     2070           run gbl/wndsizew.p
     2071             (input  v-cntxt-db-num
     2072             ,input  v-cntxt-userid
     2073             ,input  v-diasize-proc-name
     2074             ,input  'height':u
     2075             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2076             ) .
     2077         end.
     2078       end.
     2079     end.
     2080     assign
     2081       v-diasize-change-size = false
     2082     .
     2083   end procedure.
     2084   procedure diasize_set-height :
     2085     define input  parameter p-new-height  as decimal   no-undo .
     2086     define input  parameter p-move-resize as logical   no-undo .
     2087     do
     2088     on error undo, return error return-value
     2089     :
     2090       run diasize_change-height in this-procedure
     2091         (input  (p-new-height - frame Dialog-Frame :height)
     2092         ,input  p-move-resize
     2093         ) .
     2094     end.
     2095   end procedure.
     2096   procedure diasize_change-width :
     2097     define input  parameter p-change-value as decimal   no-undo .
     2098     define input  parameter p-move-resize  as logical   no-undo .
     2099     define variable v-field-group-handle   as handle    no-undo .
     2100     define variable v-object-handle        as handle    no-undo .
     2101     define variable v-frame-width          as decimal   no-undo .
     2102     define variable v-frame-virtual-width  as decimal   no-undo .
     2103     define variable v-browse-width         as decimal   no-undo .
     2104     define variable v-window-width         as decimal   no-undo .
     2105     define variable v-window-virtual-width as decimal   no-undo .
     2106     define variable v-change-sign          as integer   no-undo .
     2107     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2108     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2109     if p-change-value > 0
     2110     then do:
     2111       if frame Dialog-Frame :width + p-change-value >
     2112           session :width-chars
     2113       then do:
     2114         assign
     2115           p-change-value = session :width-chars - frame Dialog-Frame :width
     2116         .
     2117         if p-change-value <= 0
     2118         then do:
     2119           run diasize_position-resize-button in this-procedure .
     2120           return .
     2121         end.
     2122       end.
     2123     end.
     2124     if p-change-value < 0
     2125     then do:
     2126       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2127       then do:
     2128         assign
     2129           p-change-value = v-diasize-orig-frame-width
     2130                          - frame Dialog-Frame :width
     2131         .
     2132         if p-change-value >= 0
     2133         then do:
     2134           run diasize_position-resize-button in this-procedure .
     2135           return .
     2136         end.
     2137       end.
     2138     end.
     2139     if p-change-value >= 0
     2140     then do:
     2141       assign
     2142         v-change-sign = 1
     2143       .
     2144     end.
     2145     else do:
     2146       assign
     2147         v-change-sign = -1
     2148       .
     2149     end.
     2150     assign
     2151       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2152     .
     2153     if p-change-value = 0
     2154     then do:
     2155       run diasize_position-resize-button in this-procedure .
     2156       return .
     2157     end.
     2158     move_block:
     2159     do
     2160     on error undo move_block, leave move_block
     2161     :
     2162       if retry
     2163       then do:
     2164         do
     2165         on error undo move_block, leave move_block
     2166         :
     2167           if p-change-value > 0
     2168           then do:
     2169             for each buf_temp-diasize-handle
     2170             on error undo, next
     2171             :
     2172               assign
     2173                 v-object-handle = buf_temp-diasize-handle.handle-value
     2174               .
     2175               if v-object-handle <> v-diasize-resize-button
     2176               then do:
     2177                 assign
     2178                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2179                 .
     2180               end.
     2181             end.
     2182             assign
     2183               v-diasize-browse-handle :width = v-browse-width
     2184             .
     2185             for each buf_temp-browse-handle
     2186               where buf_temp-browse-handle.browse-type = 'width':u
     2187             on error undo, next
     2188             :
     2189               assign
     2190                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2191               .
     2192             end.
     2193             assign
     2194               frame Dialog-Frame :width = v-frame-width
     2195             .
     2196             if frame Dialog-Frame :scrollable = true
     2197             then do:
     2198               assign
     2199                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2200               .
     2201             end.
     2202             run diasize_position-resize-button in this-procedure .
     2203           end.
     2204           else do:
     2205             if frame Dialog-Frame :scrollable = true
     2206             then do:
     2207               assign
     2208                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2209               .
     2210             end.
     2211             assign
     2212               frame Dialog-Frame :width = v-frame-width
     2213             .
     2214             for each buf_temp-browse-handle
     2215               where buf_temp-browse-handle.browse-type = 'width':u
     2216             on error undo, next
     2217             :
     2218               assign
     2219                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2220               .
     2221             end.
     2222             assign
     2223               v-diasize-browse-handle :width = v-browse-width
     2224             .
     2225             for each buf_temp-diasize-handle
     2226             on error undo, next
     2227             :
     2228               assign
     2229                 v-object-handle = buf_temp-diasize-handle.handle-value
     2230               .
     2231               if v-object-handle <> v-diasize-resize-button
     2232               then do:
     2233                 assign
     2234                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2235                 .
     2236               end.
     2237             end.
     2238             run diasize_position-resize-button in this-procedure .
     2239           end.
     2240           assign
     2241             v-diasize-change-size = false
     2242           .
     2243           leave move_block .
     2244         end.
     2245       end.
     2246       assign
     2247         v-diasize-need-full-display = true
     2248       .
     2249       if v-diasize-change-size = false
     2250       then do:
     2251         assign
     2252           v-diasize-change-size = true
     2253         .
     2254       end.
     2255       else do:
     2256         return .
     2257       end.
     2258       assign
     2259         v-frame-width = frame Dialog-Frame :width
     2260         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2261         v-browse-width = v-diasize-browse-handle :width
     2262       .
     2263       for each buf_temp-browse-handle
     2264         where buf_temp-browse-handle.browse-type = 'width':u
     2265       :
     2266         assign
     2267           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2268         .
     2269       end.
     2270       for each buf_temp-diasize-handle
     2271       :
     2272         delete buf_temp-diasize-handle .
     2273       end.
     2274       assign
     2275         v-field-group-handle = frame Dialog-Frame :first-child
     2276       .
     2277       do while valid-handle(v-field-group-handle)
     2278       :
     2279         assign
     2280           v-object-handle = v-field-group-handle :first-child
     2281         .
     2282         do while valid-handle(v-object-handle)
     2283         :
     2284           if  v-object-handle <> v-diasize-browse-handle :handle
     2285           and v-object-handle <> v-diasize-resize-button
     2286           and can-query(v-object-handle, "row")
     2287           and can-query(v-object-handle, "height")
     2288           and ( v-object-handle :col + v-object-handle :width
     2289                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2290               )
     2291           then do:
     2292             find first buf_temp-browse-handle
     2293               where buf_temp-browse-handle.browse-type   = 'width':u
     2294                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2295               no-error .
     2296             if available buf_temp-browse-handle
     2297             then do:
     2298             end.
     2299             else do:
     2300               create buf_temp-diasize-handle .
     2301               assign
     2302                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2303                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2304               .
     2305             end.
     2306           end.
     2307           assign
     2308             v-object-handle = v-object-handle :next-sibling
     2309           .
     2310         end.
     2311         assign
     2312           v-field-group-handle = v-field-group-handle :next-sibling
     2313         .
     2314       end.
     2315       do with frame Dialog-Frame
     2316       :
     2317         hide v-diasize-resize-button .
     2318         v-diasize-resize-button :row = 1.
     2319         v-diasize-resize-button :column = 1.
     2320       end.
     2321       if p-change-value > 0
     2322       then do:
     2323         if frame Dialog-Frame :scrollable = true
     2324         then do:
     2325           assign
     2326             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2327             no-error .
     2328           if error-status :error
     2329           or error-status :get-message(1) <> ""
     2330           then do:
     2331             undo move_block, retry move_block.
     2332           end.
     2333         end.
     2334         assign
     2335           frame Dialog-Frame :width = v-frame-width + p-change-value
     2336           no-error .
     2337         if error-status :error
     2338         or error-status :get-message(1) <> ""
     2339         then do:
     2340           undo move_block, retry move_block.
     2341         end.
     2342         assign
     2343           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2344         no-error .
     2345         if error-status :error
     2346         or error-status :get-message(1) <> ""
     2347         then do:
     2348           undo move_block, retry move_block.
     2349         end.
     2350         for each buf_temp-browse-handle
     2351           where buf_temp-browse-handle.browse-type = 'width':u
     2352         on error undo move_block, retry move_block
     2353         :
     2354           assign
     2355             buf_temp-browse-handle.browse-handle :width
     2356               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2357             no-error .
     2358           if error-status :error
     2359           or error-status :get-message(1) <> ""
     2360           then do:
     2361             undo move_block, retry move_block .
     2362           end.
     2363         end.
     2364         for each buf_temp-diasize-handle
     2365         on error undo move_block, retry move_block
     2366         :
     2367           assign
     2368             v-object-handle = buf_temp-diasize-handle.handle-value
     2369           .
     2370           if v-object-handle <> v-diasize-resize-button
     2371           then do:
     2372             assign
     2373               v-object-handle :col = v-object-handle :col + p-change-value
     2374               no-error .
     2375             if error-status :error
     2376             or error-status :get-message(1) <> ""
     2377             then do:
     2378               undo move_block, retry move_block .
     2379             end.
     2380           end.
     2381         end.
     2382       end.
     2383       else do:
     2384         for each buf_temp-diasize-handle
     2385         on error undo move_block, retry move_block
     2386         :
     2387           assign
     2388             v-object-handle = buf_temp-diasize-handle.handle-value
     2389           .
     2390           if v-object-handle <> v-diasize-resize-button
     2391           then do:
     2392             assign
     2393               v-object-handle :col = v-object-handle :col + p-change-value
     2394               no-error .
     2395             if error-status :error
     2396             or error-status :get-message(1) <> ""
     2397             then do:
     2398               undo move_block, retry move_block .
     2399             end.
     2400           end.
     2401         end.
     2402         for each buf_temp-browse-handle
     2403           where buf_temp-browse-handle.browse-type = 'width':u
     2404         on error undo move_block, retry move_block
     2405         :
     2406           assign
     2407             buf_temp-browse-handle.browse-handle :width
     2408               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2409             no-error .
     2410           if error-status :error
     2411           or error-status :get-message(1) <> ""
     2412           then do:
     2413             undo move_block, retry move_block .
     2414           end.
     2415         end.
     2416         assign
     2417           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2418           no-error .
     2419         if error-status :error
     2420         or error-status :get-message(1) <> ""
     2421         then do:
     2422           undo move_block, retry move_block.
     2423         end.
     2424         assign
     2425           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2426         no-error .
     2427         if error-status :error
     2428         or error-status :get-message(1) <> ""
     2429         then do:
     2430           undo move_block, retry move_block.
     2431         end.
     2432         if frame Dialog-Frame :scrollable = true
     2433         then do:
     2434           assign
     2435             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2436           no-error .
     2437           if error-status :error
     2438           or error-status :get-message(1) <> ""
     2439           then do:
     2440             undo move_block, retry move_block.
     2441           end.
     2442         end.
     2443       end.
     2444       if p-move-resize
     2445       then do:
     2446         run diasize_position-resize-button in this-procedure .
     2447       end.
     2448       if v-diasize-wndstore = true
     2449       then do:
     2450         if connected("ub") = true
     2451         then do:
     2452           define variable v-cntxt-db-num        as integer   no-undo .
     2453           define variable v-cntxt-userid        as character no-undo .
     2454           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2455                                             , OUTPUT v-cntxt-userid
     2456                                             ) .
     2457           run gbl/wndsizew.p
     2458             (input  v-cntxt-db-num
     2459             ,input  v-cntxt-userid
     2460             ,input  v-diasize-proc-name
     2461             ,input  'width':u
     2462             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2463             ) .
     2464         end.
     2465       end.
     2466     end.
     2467     assign
     2468       v-diasize-change-size = false
     2469     .
     2470   end procedure.
     2471   procedure diasize_set-width :
     2472     define input  parameter p-new-width  as decimal   no-undo .
     2473     define input  parameter p-move-resize as logical   no-undo .
     2474     do
     2475     on error undo, return error return-value
     2476     :
     2477       run diasize_change-width in this-procedure
     2478         (input  (p-new-width - frame Dialog-Frame :width)
     2479         ,input  p-move-resize
     2480         ) .
     2481     end.
     2482   end procedure.
     2483   procedure diasize_position-resize-button :
     2484     do with frame Dialog-Frame
     2485     :
     2486       hide v-diasize-resize-button .
     2487       assign
     2488         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2489                     - 1
     2490                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2491         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2492                     - 1
     2493                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2494       .
     2495       view v-diasize-resize-button .
     2496     end.
     2497   end procedure.
     2498   on alt-right anywhere
     2499   do:
     2500     run diasize_change-width in this-procedure
     2501       (input 1
     2502       ,input true
     2503       ) .
     2504     return no-apply .
     2505   end.
     2506   on alt-left anywhere
     2507   do:
     2508     run diasize_change-width in this-procedure
     2509       (input -1
     2510       ,input true
     2511       ) .
     2512     return no-apply .
     2513   end.
     2514   on alt-down anywhere
     2515   do:
     2516     run diasize_change-height in this-procedure
     2517       (input 1
     2518       ,input true
     2519       ) .
     2520     return no-apply .
     2521   end.
     2522   on alt-up anywhere
     2523   do:
     2524     run diasize_change-height in this-procedure
     2525       (input -1
     2526       ,input true
     2527       ) .
     2528     return no-apply .
     2529   end.
     2530   on alt-enter of frame Dialog-Frame
     2531   do:
     2532     run diasize_maximize in this-procedure
     2533       (input  ?
     2534       ).
     2535     return no-apply .
     2536   end.
     2537   procedure diasize_end-move :
     2538     do
     2539     on error undo, return error return-value
     2540     :
     2541       define variable v-row-delta as decimal   no-undo .
     2542       define variable v-col-delta as decimal   no-undo .
     2543       define variable v-new-row as decimal   no-undo .
     2544       define variable v-new-col as decimal   no-undo .
     2545       assign
     2546         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2547         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2548       .
     2549       assign
     2550         v-row-delta = v-new-row - frame Dialog-Frame :height
     2551         v-col-delta = v-new-col - frame Dialog-Frame :width
     2552       .
     2553       run diasize_change-height in this-procedure
     2554         (input v-row-delta
     2555         ,input true
     2556         ) .
     2557       run diasize_change-width in this-procedure
     2558         (input v-col-delta
     2559         ,input true
     2560         ) .
     2561     end.
     2562   end procedure.
     2563   procedure diasize_maximize :
     2564     define input  parameter p-action as logical   no-undo .
     2565     do
     2566     on error undo, return error return-value
     2567     :
     2568       if p-action = ?
     2569       then do:
     2570         if v-diasize-need-maximize = true
     2571         then do:
     2572           assign
     2573             p-action = true
     2574           .
     2575         end.
     2576         else do:
     2577           assign
     2578             p-action = false
     2579           .
     2580         end.
     2581       end.
     2582       if p-action = true
     2583       then do:
     2584         run diasize_change-height in this-procedure
     2585           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2586               - frame Dialog-Frame :height-chars
     2587           ,input true
     2588           ) .
     2589         run diasize_change-width in this-procedure
     2590           (input session :width-chars
     2591               - frame Dialog-Frame :width-chars
     2592           ,input true
     2593           ) .
     2594         assign
     2595           v-diasize-need-maximize = false
     2596         .
     2597       end.
     2598       else do:
     2599         run diasize_change-width in this-procedure
     2600           (input v-diasize-orig-frame-width
     2601               - frame Dialog-Frame :width-chars
     2602           ,input true
     2603           ) .
     2604         run diasize_change-height in this-procedure
     2605           (input v-diasize-orig-frame-height
     2606               - frame Dialog-Frame :height-chars
     2607           ,input true
     2608           ) .
     2609         assign
     2610           v-diasize-need-maximize = true
     2611         .
     2612       end.
     2613     end.
     2614   end procedure.
     2615   procedure diasize_restore-orig-size :
     2616     do
     2617     on error undo, return error return-value
     2618     :
     2619       assign
     2620         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2621         v-diasize-current-frame-height = frame Dialog-Frame :height
     2622       .
     2623       run diasize_set-height in this-procedure
     2624         (input  v-diasize-orig-frame-height
     2625         ,input  true
     2626         ) .
     2627       run diasize_set-width in this-procedure
     2628         (input  v-diasize-orig-frame-width
     2629         ,input  true
     2630         ) .
     2631     end.
     2632   end procedure.
     2633   procedure diasize_restore-current-size :
     2634     do
     2635     on error undo, return error return-value
     2636     :
     2637       run diasize_set-height in this-procedure
     2638         (input  v-diasize-current-frame-height
     2639         ,input  true
     2640         ) .
     2641       run diasize_set-width in this-procedure
     2642         (input  v-diasize-current-frame-width
     2643         ,input  true
     2644         ) .
     2645     end.
     2646   end procedure.
     2647   procedure diasize_set-browse-handle :
     2648     define input  parameter p-browse-handle as handle   no-undo .
     2649     define buffer buf_temp-browse-handle for temp-browse-handle .
     2650     do
     2651     on error undo, return error return-value
     2652     :
     2653       assign
     2654         v-diasize-browse-handle = p-browse-handle
     2655       .
     2656       for each buf_temp-browse-handle
     2657       on error undo, return error return-value
     2658       :
     2659         delete buf_temp-browse-handle .
     2660       end.
     2661     end.
     2662   end procedure.
     2663   procedure diasize_add_browse :
     2664     define input  parameter p-browse-type   as character no-undo .
     2665     define input  parameter p-browse-handle as handle    no-undo .
     2666     define buffer buf_temp-browse-handle for temp-browse-handle .
     2667     do
     2668     on error undo, return error return-value
     2669     :
     2670       assign
     2671         v-diasize-browse-number = v-diasize-browse-number + 1
     2672       .
     2673       create buf_temp-browse-handle .
     2674       assign
     2675         buf_temp-browse-handle.browse-type   = p-browse-type
     2676         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2677         buf_temp-browse-handle.browse-handle = p-browse-handle
     2678       .
     2679     end.
     2680   end procedure.
     2681   procedure diasize_init :
     2682     define variable v-default-value    as logical   no-undo .
     2683     define variable v-restore-saved    as logical   no-undo .
     2684     define variable v-resize-value-str as character no-undo .
     2685     do
     2686     on error undo, return error return-value
     2687     :
     2688       do with frame Dialog-Frame
     2689       :
     2690         assign
     2691           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2692           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2693           v-diasize-browse-handle     = browse BR-docs :handle
     2694         .
     2695         create button v-diasize-resize-button
     2696         assign
     2697           parent        = frame Dialog-Frame :first-child
     2698           label         = "s"
     2699           height-pixels = 16
     2700           width-pixels  = 16
     2701           visible       = true
     2702           sensitive     = true
     2703           movable       = true
     2704           triggers:
     2705             on end-move persistent run diasize_end-move in this-procedure .
     2706           end triggers.
     2707         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2708         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2709         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2710         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2711         assign
     2712           v-diasize-wndmax = false
     2713         .
     2714         if connected("ub") = true
     2715         then do:
     2716           define variable v-cntxt-db-num        as integer   no-undo .
     2717           define variable v-cntxt-userid        as character no-undo .
     2718           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2719                                             , OUTPUT v-cntxt-userid
     2720                                             ) .
     2721           run gbl/wndpar_r.p
     2722             (input  v-cntxt-db-num
     2723             ,input  v-cntxt-userid
     2724             ,input  'wndmax':U
     2725             ,output v-diasize-wndmax
     2726             ,output v-default-value
     2727             ) .
     2728         end.
     2729         assign
     2730           v-diasize-wndstore = false
     2731         .
     2732         if connected("ub") = true
     2733         then do:
     2734           run gbl/wndpar_r.p
     2735             (input  v-cntxt-db-num
     2736             ,input  v-cntxt-userid
     2737             ,input  'wndstore':U
     2738             ,output v-diasize-wndstore
     2739             ,output v-default-value
     2740             ) .
     2741         end.
     2742         assign
     2743           v-diasize-proc-name = entry(1, program-name(2), '.')
     2744         .
     2745         if v-diasize-wndstore = true
     2746         then do:
     2747           assign
     2748             v-restore-saved = false
     2749           .
     2750           if connected("ub") = true
     2751           then do:
     2752             run gbl/wndsizer.p
     2753               (input  v-cntxt-db-num
     2754               ,input  v-cntxt-userid
     2755               ,input  v-diasize-proc-name
     2756               ,input  'height':u
     2757               ,output v-resize-value-str
     2758               ) .
     2759             if v-resize-value-str <> '':U
     2760             then do:
     2761               run diasize_change-height in this-procedure
     2762                 (input  integer(v-resize-value-str)
     2763                 ,input  true
     2764                 ) .
     2765               assign
     2766                 v-restore-saved = true
     2767               .
     2768             end.
     2769           end.
     2770           if connected("ub") = true
     2771           then do:
     2772             run gbl/wndsizer.p
     2773               (input  v-cntxt-db-num
     2774               ,input  v-cntxt-userid
     2775               ,input  v-diasize-proc-name
     2776               ,input  'width':u
     2777               ,output v-resize-value-str
     2778               ) .
     2779             if v-resize-value-str <> '':U
     2780             then do:
     2781               run diasize_change-width in this-procedure
     2782                 (input  integer(v-resize-value-str)
     2783                 ,input  true
     2784                 ) .
     2785               assign
     2786                 v-restore-saved = true
     2787               .
     2788             end.
     2789           end.
     2790           if v-restore-saved <> true
     2791           then do:
     2792             if v-diasize-wndmax = true
     2793             then do:
     2794               run diasize_maximize in this-procedure
     2795                 (input  true
     2796                 ) .
     2797             end.
     2798           end.
     2799         end.
     2800         else do:
     2801           if v-diasize-wndmax = true
     2802           then do:
     2803             run diasize_maximize in this-procedure
     2804               (input  true
     2805               ) .
     2806           end.
     2807         end.
     2808       end.
     2809     end.
     2810   end procedure.
     2811   procedure diasize_need-full-display :
     2812     define output parameter p-need-full-display as logical   no-undo .
     2813     do
     2814     on error undo, return error return-value
     2815     :
     2816       assign
     2817         p-need-full-display = v-diasize-need-full-display
     2818       .
     2819       assign
     2820         v-diasize-need-full-display = false
     2821       .
     2822     end.
