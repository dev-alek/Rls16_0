     2824   procedure get-context :
     2825      define output parameter p-db-num as integer          no-undo.
     2826      define output parameter p-user-id as character        no-undo.
     2827      define variable v-login               as character    no-undo.
     2828      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2829      define buffer buf_user-login  for ub.user-login .
     2830      do
     2831      on error undo, return error
     2832      :
     2833            FIND FIRST buf_sys-ctrl no-lock.
     2834            ASSIGN
     2835               v-login = USERID("ub")
     2836               p-db-num = buf_sys-ctrl.db-num
     2837            .
     2838            FIND FIRST buf_user-login
     2839                 WHERE buf_user-login.db-num = p-db-num
     2840                   AND buf_user-login.user-login = v-login
     2841                 no-lock
     2842                 no-error
     2843                 .
     2844            IF AVAILABLE buf_user-login
     2845            THEN DO:
     2846               assign
     2847                  p-user-id = buf_user-login.user-id
     2848               .
     2849            END.
     2850      end.
     2851   end procedure.
     2852       run diasize_init in this-procedure .
