       17   define input parameter parout-code like ub.chk-doc.out-code no-undo.
       18   define input parameter pard-card like ub.chk-doc.d-card no-undo.
       19   define output param rid-list    as  char no-undo .
       20   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       21   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       22   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
