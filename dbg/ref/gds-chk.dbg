      369   define  stream PrnLibStream.
      370   procedure prn-lib-prn-file :
      371     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      372     define input parameter p-DIsabledoptions as integer no-undo .
      373     define variable v-report-name as character no-undo .
      374     define variable v-user-action as character no-undo .
      375     define variable v-printed     as logical   no-undo .
      376     define variable v-exist       as logical   no-undo .
      377     do
      378       on error undo, return error
      379       :
      380       run prn-lib-get-report-name  in this-procedure (
      381         input parParentProc
      382         ,output v-report-name
      383         ).
      384   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      386     (input  v-report-name
      387     ,input  2
      388     ,output v-exist
      389     )  .
      390       if NOT v-exist then
      391       DO:
      392         Message
      393           "Нет заданий на печать ! "
      394           view-as alert-box .
      395         Return  .
      396       End.
      397       run gbl/prnfilen.w
      398         (input  ""
      399         ,input  p-DisabledOptions
      400         ,input  string(v-report-name )
      401         ,input  7
      402         ,output v-user-action
      403         ,output v-printed
      404         ) .
      405       if v-printed then
      406       do:
      407         return "YES" .
      408       end.
      409       else
      410       do:
      411         return "NO" .
      412       end.
      413     end.
      414   end procedure.
      415   procedure prn-lib-open-stream :
      416     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      417     define input parameter p-page-size    as integer no-undo .
      418     define input parameter p-is-stream    as logical no-undo .
      419     define input parameter p-append       as logical no-undo .
      420     define variable v-report-name as character no-undo .
      421     do
      422       on error undo, return error
      423       :
      424       run prn-lib-get-report-name  in this-procedure (
      425         input parParentProc
      426         ,output v-report-name
      427         ).
      428       if p-is-stream then
      429       do:
      430         if p-append then
      431         do:
      432           output stream PrnLibStream to value( v-report-name )
      433             page-size value(p-page-size) append .
      434         end.
      435         if not p-append then
      436         do:
      437           output stream PrnLibStream to value( v-report-name )
      438             page-size value(p-page-size) .
      439         end.
      440       end.
      441       if not p-is-stream then
      442       do:
      443         if p-append then
      444         do:
      445           output to value( v-report-name )
      446             page-size value(p-page-size) append .
      447         end.
      448         if not p-append then
      449         do:
      450           output to value( v-report-name )
      451             page-size value(p-page-size) .
      452         end.
      453       end.
      454     end.
      455   end procedure.
      456   procedure prn-lib-open-exp :
      457     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      458     define input parameter p-is-stream    as logical no-undo .
      459     define input parameter p-is-append    as logical no-undo .
      460     define output parameter p-ReportFileName as char init "report" no-undo.
      461     define output parameter p-process as logical no-undo .
      462     define variable glog as logical no-undo .
      463     do
      464       on error undo, return error
      465       :
      466       SYSTEM-DIALOG GET-FILE p-ReportFileName
      467         TITLE      "Укажите путь"
      468         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      469         ASK-OVERWRITE
      470         CREATE-TEST-FILE
      471         SAVE-AS
      472         USE-FILENAME
      473         DEFAULT-EXTENSION "txt"
      474         UPDATE glog
      475         .
      476       if not glog then  return.
      477       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      478       if p-is-stream then
      479       do:
      480         if p-is-append then
      481         do:
      482           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      483         end.
      484         else
      485         do:
      486           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      487         end.
      488       end.
      489       else
      490       do:
      491         if p-is-append then
      492         do:
      493           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      494         end.
      495         else
      496         do:
      497           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      498         end.
      499       end.
      500       p-process = yes.
      501     end.
      502   end procedure.
      503   procedure prn-lib-get-report-name :
      504     define input parameter parParentProc  as widget-handle no-undo.
      505     define output parameter p-report-name as character no-undo .
      506     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      507   end procedure.
      508   procedure prn-lib-reportviewer-report-name :
      509     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      510     define input parameter p-report-name-html as character no-undo .
      511     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      512   end procedure.
      513   procedure prn-lib-reportviewer :
      514     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      515     define input parameter p-report-name-html as character no-undo .
      516     define input parameter p-param        as character no-undo .
      517     define variable v-excel           as character no-undo init 'TRUE' .
      518     define variable v-value-character as character no-undo .
      519     define variable v-value-integer   as character no-undo .
      520     define variable v-value-date      as date      no-undo .
      521     define variable v-value-decimal   as decimal   no-undo .
      522     define variable rep-excel         as logical   no-undo .
      523     define variable excel-string      as character no-undo .
      524     define variable v-param-type      as character no-undo .
      525     define variable v-tth             as handle    no-undo .
      526     run adm/shattri.p (
      527       input "get":U
      528       ,input  ""
      529       ,input  0
      530       ,input  'report-glob':U
      531       ,input  'rep-excel':U
      532       ,output v-value-character
      533       ,output v-value-date
      534       ,output v-value-decimal
      535       ,output v-value-integer
      536       ,output rep-excel
      537       ,output v-param-type
      538       ,INPUT-OUTPUT table-handle v-tth
      539       )  .
      540     if rep-excel then v-excel = "TRUE" .
      541     else v-excel = "FALSE" .
      542     if p-param eq ""
      543     then
      544        p-param = "EXCEL:" + v-excel.
      545     else
      546        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      547     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      548   end procedure.
      549   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      550   procedure fltfield-clear :
      551     define output parameter loc-fld as character no-undo.
      552     define output parameter loc-lab as character no-undo .
      553     define output parameter loc-spr as character no-undo .
      554     define output parameter loc-dim as character no-undo .
      555     assign
      556       loc-fld = ""
      557       loc-lab = ""
      558       loc-spr = ""
      559       loc-dim = "0"
      560     .
      561   end procedure .
      562   procedure fltfield-add :
      563     define input        parameter par-fld as character no-undo.
      564     define input        parameter par-lab as character no-undo .
      565     define input        parameter par-spr as character no-undo .
      566     define input-output parameter loc-fld as character no-undo.
      567     define input-output parameter loc-lab as character no-undo .
      568     define input-output parameter loc-spr as character no-undo .
      569     define input-output parameter loc-dim as character no-undo .
      570     do
      571     on error undo, return error
      572     :
      573       assign
      574       loc-fld = if loc-dim = '0'
      575                 then par-fld
      576                 else (loc-fld + chr(44) + par-fld)
      577       loc-lab = if loc-dim = '0'
      578                 then par-lab
      579                 else (loc-lab + chr(44) + par-lab)
      580       loc-spr = if loc-dim = '0'
      581                 then par-spr
      582                 else (loc-spr + chr(44) + par-spr)
      583       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      584                 string(integer(if num-entries(loc-dim) > 1
      585                               then entry(2, loc-dim)
      586                               else entry(1, loc-dim)
      587                               ) + 1)
      588       no-error
      589       .
      590     end.
      591   end procedure.
      592   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   define variable v-waitfram-action01         as character   no-undo .
      594   define variable v-waitfram-action02         as character   no-undo .
      595   define variable v-waitfram-action03         as character   no-undo .
      596   define variable mWaitFramTextBeg            as character   no-undo.
      597   define variable mWaitFramTextEnd            as character   no-undo.
      598   define variable mWaitFramView               as logical     no-undo.
      599   define variable mWaitProcEvent              as logical     no-undo init yes.
      600   define variable mWaitFramInterval           as integer     no-undo init 1 .
      601   define variable mWaitFramStop               as logical     no-undo.
      602   define variable mWaitFramStopUser           as logical     no-undo.
      603   define variable mWaitFramStopTimeOut        as logical     no-undo.
      604   define variable mWaitFramStartProc          as datetime-tz no-undo.
      605   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      606   define button B-WaitFramStop auto-end-key
      607        label "Стоп"
      608        size 10 by 1 tooltip "Остоновить процесс".
      609   define button B-viewProcInfo
      610        label "Информация"
      611        size 15 by 1 tooltip "Информация о процесс".
      612   define frame waitfram
      613     v-waitfram-action01 format "x(72)" no-label skip
      614     v-waitfram-action02 format "x(72)" no-label skip
      615     v-waitfram-action03 format "x(72)" no-label skip
      616     B-viewProcInfo
      617     B-WaitFramStop at row 4 col 30
      618     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      619     .
      620   define new global shared variable mBatchMode as logical no-undo init ?.
      621   define variable mFramBachModHandle as handle no-undo.
      622   mFramBachModHandle = frame waitfram:handle.
      623   define variable mFameOldVis as logical no-undo.
      624   define variable mVisCUrentVin as logical no-undo.
      625   if session:batch-mode
      626   then
      627      mBatchMode = yes.
      628   if mBatchMode = ? then do:
      629     mVisCUrentVin = current-window:visible.
      630     mFameOldVis = mFramBachModHandle:visible.
      631     mFramBachModHandle:visible  = yes.
      632     mBatchMode = mFramBachModHandle:visible ne yes.
      633     mFramBachModHandle:visible = mFameOldVis.
      634     current-window:visible = mVisCUrentVin.
      635   end.
      636    if  log-manager:logfile-name ne ?
      637     then DO:
      638         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      639         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      640         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      641     end.
      642   on choose of B-WaitFramStop in frame waitfram
      643   do:
      644     mWaitFramStop = yes.
      645     mWaitFramStopUser = yes.
      646   end.
      647   function waitfram-check-timeout returns logical():
      648      define variable vtime as int64 no-undo.
      649      if mWaitFramStopTimeOut
      650      then
      651         return yes.
      652      vtime = ( now - mWaitFramStartProc ) / 1000 .
      653      if     mWaitFramTimeOut ne ?
      654         and mWaitFramTimeOut ne 0
      655         and mWaitFramTimeOut lt vtime
      656      then do:
      657         mWaitFramStopTimeOut = yes.
      658      end.
      659      return mWaitFramStopTimeOut.
      660   end.
      661   procedure waitfram-hide :
      662     if not session:batch-mode
      663     then do
      664     on error undo, return error return-value
      665     :
      666       pause 0 before-hide .
      667       if not mBatchMode then
      668         hide frame waitfram .
      669     if     not mWaitFramView
      670        and mWaitProcEvent
      671     then
      672       process events .
      673     end.
      674   end procedure.
      675   procedure waitfram-show :
      676     define input  parameter p-message as character no-undo .
      677     define variable v-left-margin as integer   no-undo .
      678     if not session:batch-mode
      679     then do
      680     on error undo, return error return-value
      681     :
      682       if length(p-message) <= 70 then do:
      683         assign
      684           v-left-margin = integer((70 - length(p-message)) / 2)
      685         .
      686         assign
      687           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      688         .
      689         assign
      690           v-waitfram-action01 = " "
      691           v-waitfram-action02 = " "
      692                                    + fill(" ", v-left-margin)
      693                                    + p-message
      694           v-waitfram-action03 = " "
      695         .
      696       end.
      697       else do:
      698         define variable vRindex1 as integer no-undo.
      699         define variable vRindex2 as integer no-undo.
      700         vRindex1 = r-index(p-message," ",70).
      701         if vRindex1 = 0
      702         then
      703            vRindex1 = 70.
      704         if length(p-message)  <= vRindex1 + 70 then do:
      705           assign
      706             v-waitfram-action01 = " "
      707             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      708             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      709           .
      710         end.
      711         else do:
      712           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      713           if vRindex2 <= vRindex1
      714           then
      715              vRindex2 = vRindex1 + 70.
      716           assign
      717             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      718             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      719             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      720           .
      721         end.
      722       end.
      723       B-viewProcInfo:visible   in frame waitfram = no.
      724       B-viewProcInfo:sensitive in frame waitfram = no.
      725       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      726       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      727       if  (   mWaitFramView
      728          or  mWaitProcEvent)
      729          and not mBatchMode
      730       then
      731          display
      732             v-waitfram-action01 skip
      733             v-waitfram-action02 skip
      734             v-waitfram-action03 skip
      735          with frame waitfram .
      736       if     mWaitFramView
      737          then do:
      738             if     mWaitFramInterval ne ?
      739                and not mBatchMode
      740             then
      741                wait-for go of frame waitfram pause mWaitFramInterval.
      742          end.
      743          else
      744             if     mWaitProcEvent
      745                and not mBatchMode
      746             then
      747                process events .
      748     end.
      749   end procedure.
      750      procedure waitfram-show-this:
      751         define input  parameter iInterval as int64 no-undo.
      752         define variable vtime as int64 no-undo.
      753         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      754         mWaitFramInterval = iInterval.
      755         run waitfram-show (substitute("&1&2 &3&4" ,
      756                                       mWaitFramTextBeg ,
      757                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      758                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      759                                       mWaitFramTextEnd
      760                                      )
      761                           ).
      762      end.
      763      procedure WaitFramRunPause:
      764         define input  parameter iInterval as dec no-undo.
      765         define variable vStart  as datetime-tz no-undo.
      766         define variable vend    as datetime-tz no-undo.
      767         define variable vint as int64 no-undo.
      768         define variable vOk as logical no-undo.
      769         vStart = now.
      770         vend   = vStart.
      771         publish "WaitFramPause" (iInterval,output vOk).
      772         vend   =  now.
      773         vint = vend - vStart.
      774         vint = iInterval - vint / 1000.
      775         if     not mWaitFramStop
      776            and (   vint > 0
      777                 or (    not vOk
      778                     and iInterval eq ?
      779                     )
      780                 )
      781         then
      782            run waitfram-show-this (iInterval).
      783         vend   =  now.
      784         vint = vend - vStart.
      785         vint = iInterval - vint / 1000.
      786         if     not mWaitFramStop
      787            and vint > 0
      788         then do:
      789            run gbl/pause.p (vint * 1000).
      790         end.
      791         if iInterval ne ?
      792         then
      793            publish "WaitFramStop".
      794         waitfram-check-timeout().
      795      end.
      796      procedure WaitFramWaitFor:
      797         define input  parameter iInterval as dec no-undo.
      798         assign
      799            mWaitFramStartProc   = now
      800            mWaitFramStopUser    = no
      801            mWaitFramStopTimeOut = no
      802         .
      803         block-wait:
      804         do while not mWaitFramStop:
      805            run WaitFramRunPause (iInterval).
      806            if  waitfram-check-timeout()
      807            then do:
      808               leave block-wait.
      809            end.
      810         end.
      811         run waitfram-hide.
      812      end.
      813   procedure waitfram-join :
      814     define input  parameter p-line-1  as character no-undo .
      815     define input  parameter p-line-2  as character no-undo .
      816     define input  parameter p-line-3  as character no-undo .
      817     define output parameter p-message as character no-undo .
      818     do
      819     on error undo, return error return-value
      820     :
      821       assign
      822         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      823                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      824                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      825       .
      826     end.
      827   end procedure.
      828   function waitfram-join-function returns character
      829     (input p-line-1 as character
      830     ,input p-line-2 as character
      831     ,input p-line-3 as character
      832     ).
      833     define variable v-message as character no-undo .
      834     run waitfram-join in this-procedure
      835       (input  p-line-1
      836       ,input  p-line-2
      837       ,input  p-line-3
      838       ,output v-message
      839       ) .
      840     return v-message .
      841   end function .
      842   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   FUNCTION mark-string RETURNS CHARACTER
      844     ( input p-recid as recid, input mark-list as character  ) :
      845     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      846   END FUNCTION.
