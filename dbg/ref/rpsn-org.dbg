        1   DEFINE BUFFER X_firm FOR ub.firm.
        2   DEFINE INPUT PARAMETER parparentproc AS   WIDGET-HANDLE       NO-UNDO.
        3   DEFINE INPUT PARAMETER p-obj-code    LIKE ub.clients.obj-code NO-UNDO.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Список организаций по торговому представителю".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65   define variable v-waitfram-action01         as character   no-undo .
       66   define variable v-waitfram-action02         as character   no-undo .
       67   define variable v-waitfram-action03         as character   no-undo .
       68   define variable mWaitFramTextBeg            as character   no-undo.
       69   define variable mWaitFramTextEnd            as character   no-undo.
       70   define variable mWaitFramView               as logical     no-undo.
       71   define variable mWaitProcEvent              as logical     no-undo init yes.
       72   define variable mWaitFramInterval           as integer     no-undo init 1 .
       73   define variable mWaitFramStop               as logical     no-undo.
       74   define variable mWaitFramStopUser           as logical     no-undo.
       75   define variable mWaitFramStopTimeOut        as logical     no-undo.
       76   define variable mWaitFramStartProc          as datetime-tz no-undo.
       77   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       78   define button B-WaitFramStop auto-end-key
       79        label "Стоп"
       80        size 10 by 1 tooltip "Остоновить процесс".
       81   define button B-viewProcInfo
       82        label "Информация"
       83        size 15 by 1 tooltip "Информация о процесс".
       84   define frame waitfram
       85     v-waitfram-action01 format "x(72)" no-label skip
       86     v-waitfram-action02 format "x(72)" no-label skip
       87     v-waitfram-action03 format "x(72)" no-label skip
       88     B-viewProcInfo
       89     B-WaitFramStop at row 4 col 30
       90     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       91     .
       92   define new global shared variable mBatchMode as logical no-undo init ?.
       93   define variable mFramBachModHandle as handle no-undo.
       94   mFramBachModHandle = frame waitfram:handle.
       95   define variable mFameOldVis as logical no-undo.
       96   define variable mVisCUrentVin as logical no-undo.
       97   if session:batch-mode
       98   then
       99      mBatchMode = yes.
      100   if mBatchMode = ? then do:
      101     mVisCUrentVin = current-window:visible.
      102     mFameOldVis = mFramBachModHandle:visible.
      103     mFramBachModHandle:visible  = yes.
      104     mBatchMode = mFramBachModHandle:visible ne yes.
      105     mFramBachModHandle:visible = mFameOldVis.
      106     current-window:visible = mVisCUrentVin.
      107   end.
      108    if  log-manager:logfile-name ne ?
      109     then DO:
      110         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      111         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      112         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      113     end.
      114   on choose of B-WaitFramStop in frame waitfram
      115   do:
      116     mWaitFramStop = yes.
      117     mWaitFramStopUser = yes.
      118   end.
      119   function waitfram-check-timeout returns logical():
      120      define variable vtime as int64 no-undo.
      121      if mWaitFramStopTimeOut
      122      then
      123         return yes.
      124      vtime = ( now - mWaitFramStartProc ) / 1000 .
      125      if     mWaitFramTimeOut ne ?
      126         and mWaitFramTimeOut ne 0
      127         and mWaitFramTimeOut lt vtime
      128      then do:
      129         mWaitFramStopTimeOut = yes.
      130      end.
      131      return mWaitFramStopTimeOut.
      132   end.
      133   procedure waitfram-hide :
      134     if not session:batch-mode
      135     then do
      136     on error undo, return error return-value
      137     :
      138       pause 0 before-hide .
      139       if not mBatchMode then
      140         hide frame waitfram .
      141     if     not mWaitFramView
      142        and mWaitProcEvent
      143     then
      144       process events .
      145     end.
      146   end procedure.
      147   procedure waitfram-show :
      148     define input  parameter p-message as character no-undo .
      149     define variable v-left-margin as integer   no-undo .
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       if length(p-message) <= 70 then do:
      155         assign
      156           v-left-margin = integer((70 - length(p-message)) / 2)
      157         .
      158         assign
      159           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      160         .
      161         assign
      162           v-waitfram-action01 = " "
      163           v-waitfram-action02 = " "
      164                                    + fill(" ", v-left-margin)
      165                                    + p-message
      166           v-waitfram-action03 = " "
      167         .
      168       end.
      169       else do:
      170         define variable vRindex1 as integer no-undo.
      171         define variable vRindex2 as integer no-undo.
      172         vRindex1 = r-index(p-message," ",70).
      173         if vRindex1 = 0
      174         then
      175            vRindex1 = 70.
      176         if length(p-message)  <= vRindex1 + 70 then do:
      177           assign
      178             v-waitfram-action01 = " "
      179             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      180             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      181           .
      182         end.
      183         else do:
      184           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      185           if vRindex2 <= vRindex1
      186           then
      187              vRindex2 = vRindex1 + 70.
      188           assign
      189             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      191             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      192           .
      193         end.
      194       end.
      195       B-viewProcInfo:visible   in frame waitfram = no.
      196       B-viewProcInfo:sensitive in frame waitfram = no.
      197       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       if  (   mWaitFramView
      200          or  mWaitProcEvent)
      201          and not mBatchMode
      202       then
      203          display
      204             v-waitfram-action01 skip
      205             v-waitfram-action02 skip
      206             v-waitfram-action03 skip
      207          with frame waitfram .
      208       if     mWaitFramView
      209          then do:
      210             if     mWaitFramInterval ne ?
      211                and not mBatchMode
      212             then
      213                wait-for go of frame waitfram pause mWaitFramInterval.
      214          end.
      215          else
      216             if     mWaitProcEvent
      217                and not mBatchMode
      218             then
      219                process events .
      220     end.
      221   end procedure.
      222      procedure waitfram-show-this:
      223         define input  parameter iInterval as int64 no-undo.
      224         define variable vtime as int64 no-undo.
      225         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      226         mWaitFramInterval = iInterval.
      227         run waitfram-show (substitute("&1&2 &3&4" ,
      228                                       mWaitFramTextBeg ,
      229                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      230                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      231                                       mWaitFramTextEnd
      232                                      )
      233                           ).
      234      end.
      235      procedure WaitFramRunPause:
      236         define input  parameter iInterval as dec no-undo.
      237         define variable vStart  as datetime-tz no-undo.
      238         define variable vend    as datetime-tz no-undo.
      239         define variable vint as int64 no-undo.
      240         define variable vOk as logical no-undo.
      241         vStart = now.
      242         vend   = vStart.
      243         publish "WaitFramPause" (iInterval,output vOk).
      244         vend   =  now.
      245         vint = vend - vStart.
      246         vint = iInterval - vint / 1000.
      247         if     not mWaitFramStop
      248            and (   vint > 0
      249                 or (    not vOk
      250                     and iInterval eq ?
      251                     )
      252                 )
      253         then
      254            run waitfram-show-this (iInterval).
      255         vend   =  now.
      256         vint = vend - vStart.
      257         vint = iInterval - vint / 1000.
      258         if     not mWaitFramStop
      259            and vint > 0
      260         then do:
      261            run gbl/pause.p (vint * 1000).
      262         end.
      263         if iInterval ne ?
      264         then
      265            publish "WaitFramStop".
      266         waitfram-check-timeout().
      267      end.
      268      procedure WaitFramWaitFor:
      269         define input  parameter iInterval as dec no-undo.
      270         assign
      271            mWaitFramStartProc   = now
      272            mWaitFramStopUser    = no
      273            mWaitFramStopTimeOut = no
      274         .
      275         block-wait:
      276         do while not mWaitFramStop:
      277            run WaitFramRunPause (iInterval).
      278            if  waitfram-check-timeout()
      279            then do:
      280               leave block-wait.
      281            end.
      282         end.
      283         run waitfram-hide.
      284      end.
      285   procedure waitfram-join :
      286     define input  parameter p-line-1  as character no-undo .
      287     define input  parameter p-line-2  as character no-undo .
      288     define input  parameter p-line-3  as character no-undo .
      289     define output parameter p-message as character no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       assign
      294         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      297       .
      298     end.
      299   end procedure.
      300   function waitfram-join-function returns character
      301     (input p-line-1 as character
      302     ,input p-line-2 as character
      303     ,input p-line-3 as character
      304     ).
      305     define variable v-message as character no-undo .
      306     run waitfram-join in this-procedure
      307       (input  p-line-1
      308       ,input  p-line-2
      309       ,input  p-line-3
      310       ,output v-message
      311       ) .
      312     return v-message .
      313   end function .
      314   define new global shared variable g#language as character no-undo .
      315   if g#language <> '' and g#language <> 'rus':U then do:
      316     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      317   end.
      318   procedure proc-alt-shift-f2:
      319     if not ibs.th.gbl.gbl-var:rcode
      320   then
      321     run gbl\inidebug.p .
      322   end.
      323   procedure proc-alt-shift-f3:
      324     run gbl/prvssinf.p
      325       ( input this-procedure
      326       ) .
      327   end.
      328   define variable v-inform-launched as logical no-undo initial false .
      329   procedure proc-alt-shift-f4:
      330     define variable v-action as character no-undo .
      331     if v-inform-launched = false then do:
      332       assign
      333         v-inform-launched = true
      334       .
      335       run gbl/d-inform.w
      336         (  input self
      337         ,  input this-procedure
      338         , output v-action
      339         ) no-error .
      340       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      341       assign
      342         v-inform-launched = false
      343       .
      344     end.
      345   end.
      346   procedure proc-alt-f1:
      347     run gbl/corrhelp.p
      348       (input this-procedure
      349       ) .
      350   end .
      351   on alt-shift-f2 anywhere do:
      352     run proc-alt-shift-f2.
      353   end.
      354   on alt-shift-f3 anywhere do:
      355     run proc-alt-shift-f3 in this-procedure .
      356   end.
      357   on alt-shift-f4 anywhere do:
      358     run proc-alt-shift-f4 in this-procedure.
      359   end.
      360   on alt-f1 anywhere do:
      361     run proc-alt-f1 in this-procedure .
      362   end.
      363   define new global shared variable g#library  as handle no-undo .
      364   define new global shared variable g#library2 as handle no-undo .
      365   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   define  stream PrnLibStream.
      367   procedure prn-lib-prn-file :
      368     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      369     define input parameter p-DIsabledoptions as integer no-undo .
      370     define variable v-report-name as character no-undo .
      371     define variable v-user-action as character no-undo .
      372     define variable v-printed     as logical   no-undo .
      373     define variable v-exist       as logical   no-undo .
      374     do
      375       on error undo, return error
      376       :
      377       run prn-lib-get-report-name  in this-procedure (
      378         input parParentProc
      379         ,output v-report-name
      380         ).
      381   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      383     (input  v-report-name
      384     ,input  2
      385     ,output v-exist
      386     )  .
      387       if NOT v-exist then
      388       DO:
      389         Message
      390           "Нет заданий на печать ! "
      391           view-as alert-box .
      392         Return  .
      393       End.
      394       run gbl/prnfilen.w
      395         (input  ""
      396         ,input  p-DisabledOptions
      397         ,input  string(v-report-name )
      398         ,input  7
      399         ,output v-user-action
      400         ,output v-printed
      401         ) .
      402       if v-printed then
      403       do:
      404         return "YES" .
      405       end.
      406       else
      407       do:
      408         return "NO" .
      409       end.
      410     end.
      411   end procedure.
      412   procedure prn-lib-open-stream :
      413     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      414     define input parameter p-page-size    as integer no-undo .
      415     define input parameter p-is-stream    as logical no-undo .
      416     define input parameter p-append       as logical no-undo .
      417     define variable v-report-name as character no-undo .
      418     do
      419       on error undo, return error
      420       :
      421       run prn-lib-get-report-name  in this-procedure (
      422         input parParentProc
      423         ,output v-report-name
      424         ).
      425       if p-is-stream then
      426       do:
      427         if p-append then
      428         do:
      429           output stream PrnLibStream to value( v-report-name )
      430             page-size value(p-page-size) append .
      431         end.
      432         if not p-append then
      433         do:
      434           output stream PrnLibStream to value( v-report-name )
      435             page-size value(p-page-size) .
      436         end.
      437       end.
      438       if not p-is-stream then
      439       do:
      440         if p-append then
      441         do:
      442           output to value( v-report-name )
      443             page-size value(p-page-size) append .
      444         end.
      445         if not p-append then
      446         do:
      447           output to value( v-report-name )
      448             page-size value(p-page-size) .
      449         end.
      450       end.
      451     end.
      452   end procedure.
      453   procedure prn-lib-open-exp :
      454     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      455     define input parameter p-is-stream    as logical no-undo .
      456     define input parameter p-is-append    as logical no-undo .
      457     define output parameter p-ReportFileName as char init "report" no-undo.
      458     define output parameter p-process as logical no-undo .
      459     define variable glog as logical no-undo .
      460     do
      461       on error undo, return error
      462       :
      463       SYSTEM-DIALOG GET-FILE p-ReportFileName
      464         TITLE      "Укажите путь"
      465         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      466         ASK-OVERWRITE
      467         CREATE-TEST-FILE
      468         SAVE-AS
      469         USE-FILENAME
      470         DEFAULT-EXTENSION "txt"
      471         UPDATE glog
      472         .
      473       if not glog then  return.
      474       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      475       if p-is-stream then
      476       do:
      477         if p-is-append then
      478         do:
      479           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      480         end.
      481         else
      482         do:
      483           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      484         end.
      485       end.
      486       else
      487       do:
      488         if p-is-append then
      489         do:
      490           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      491         end.
      492         else
      493         do:
      494           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      495         end.
      496       end.
      497       p-process = yes.
      498     end.
      499   end procedure.
      500   procedure prn-lib-get-report-name :
      501     define input parameter parParentProc  as widget-handle no-undo.
      502     define output parameter p-report-name as character no-undo .
      503     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      504   end procedure.
      505   procedure prn-lib-reportviewer-report-name :
      506     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      507     define input parameter p-report-name-html as character no-undo .
      508     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      509   end procedure.
      510   procedure prn-lib-reportviewer :
      511     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      512     define input parameter p-report-name-html as character no-undo .
      513     define input parameter p-param        as character no-undo .
      514     define variable v-excel           as character no-undo init 'TRUE' .
      515     define variable v-value-character as character no-undo .
      516     define variable v-value-integer   as character no-undo .
      517     define variable v-value-date      as date      no-undo .
      518     define variable v-value-decimal   as decimal   no-undo .
      519     define variable rep-excel         as logical   no-undo .
      520     define variable excel-string      as character no-undo .
      521     define variable v-param-type      as character no-undo .
      522     define variable v-tth             as handle    no-undo .
      523     run adm/shattri.p (
      524       input "get":U
      525       ,input  ""
      526       ,input  0
      527       ,input  'report-glob':U
      528       ,input  'rep-excel':U
      529       ,output v-value-character
      530       ,output v-value-date
      531       ,output v-value-decimal
      532       ,output v-value-integer
      533       ,output rep-excel
      534       ,output v-param-type
      535       ,INPUT-OUTPUT table-handle v-tth
      536       )  .
      537     if rep-excel then v-excel = "TRUE" .
      538     else v-excel = "FALSE" .
      539     if p-param eq ""
      540     then
      541        p-param = "EXCEL:" + v-excel.
      542     else
      543        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      544     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      545   end procedure.
      546   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      547   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      548   define  shared variable RepPathName        as character no-undo .
      549   define  shared variable PrintRubl          as logical   no-undo .
      550   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      551     define variable v-cntxt-db-num        as integer   no-undo .
      552     define variable v-cntxt-userid        as character no-undo .
      553     define variable v-cntxt-level         as character no-undo .
      554     define variable v-cntxt-host-code-obj as integer   no-undo .
      555     define variable v-cntxt-obj-type      as character no-undo .
      556     define variable v-cntxt-obj-code      as integer   no-undo .
      557     define variable v-cntxt-db-num-obj    as integer   no-undo .
      558     define variable v-cntxt-is-admin      as logical   no-undo .
      559   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      560   procedure cur-time :
      561      define output parameter p-today as date      no-undo .
      562      define output parameter p-time  as integer   no-undo .
      563     do
      564     on error undo, return error
      565     :
      566       define variable v-date1 as date      no-undo .
      567       define variable v-date2 as date      no-undo .
      568       define variable v-time  as integer   no-undo .
      569       assign
      570         v-date1 = today
      571         v-time  = time
      572         v-date2 = today
      573       .
      574       if v-date1 <> v-date2
      575       then do:
      576         assign
      577           v-date1 = today
      578           v-time  = v-time
      579         .
      580       end.
      581       assign
      582         p-today = v-date1
      583         p-time  = v-time
      584       .
      585     end.
      586   end.
      587   function cur-time-date returns character
      588   :
      589     return string(today, '99/99/9999':U) .
      590   end.
      591   function cur-time-mjd returns decimal
      592   :
      593     define variable v-date as date      no-undo .
      594     define variable v-time as integer   no-undo .
      595     run cur-time in this-procedure
      596       (output v-date
      597       ,output v-time
      598       ) .
      599     return integer(v-date) - 2400002 + (v-time / 86400) .
      600   end.
      601   function cur-time-get-ending-index returns integer
      602   (input p-number as integer
      603   )
      604   :
      605     if p-number < 0
      606     or p-number = ?
      607     then do:
      608       return 1 .
      609     end.
      610     define variable v-rest as integer   no-undo .
      611     assign
      612       p-number = p-number modulo 100
      613     .
      614     if p-number < 20
      615     then do:
      616       assign
      617         v-rest = p-number
      618       .
      619     end.
      620     else do:
      621       assign
      622         v-rest = p-number modulo 10
      623       .
      624     end.
      625     case v-rest :
      626       when 1
      627       then do:
      628         return 2 .
      629       end.
      630       when 2 or
      631       when 3 or
      632       when 4
      633       then do:
      634         return 3 .
      635       end.
      636       otherwise do:
      637         return 1 .
      638       end.
      639     end case .
      640   end.
      641   procedure cur-time-mjd-to-date :
      642      define input  parameter i-mjd-diff as decimal no-undo.
      643      define output parameter o-Date     as date    no-undo.
      644      define output parameter o-Time     as integer no-undo.
      645      define variable v-day-number as integer   no-undo .
      646      if    i-mjd-diff < 0
      647         or i-mjd-diff = ?
      648      then do:
      649         return "?" .
      650      end.
      651      assign
      652         v-day-number = truncate(i-mjd-diff,0).
      653         o-Date = date(v-day-number + 2400002).
      654         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      655     .
      656   end.
      657   function cur-time-mjd-to-string returns character
      658   (input p-mjd-diff as decimal
      659   )
      660   :
      661     define variable v-day-number as integer   no-undo .
      662     define variable v-seconds    as integer   no-undo .
      663     define variable v-hour       as integer   no-undo .
      664     define variable v-min        as integer   no-undo .
      665     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      666     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      667     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      668     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      669     if p-mjd-diff < 0
      670     or p-mjd-diff = ?
      671     then do:
      672       return "?" .
      673     end.
      674     assign
      675       v-day-number = integer(truncate(p-mjd-diff,0))
      676       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      677     .
      678     if v-seconds > 86400
      679     then do:
      680       assign
      681         v-seconds = 86400 - 1
      682       .
      683     end.
      684     if v-seconds < 0
      685     then do:
      686       assign
      687         v-seconds = 0
      688       .
      689     end.
      690     assign
      691       v-hour = truncate(v-seconds / 3600, 0)
      692     .
      693     assign
      694       v-seconds = v-seconds modulo 3600
      695     .
      696     assign
      697       v-min = truncate(v-seconds / 60, 0)
      698     .
      699     assign
      700       v-seconds = v-seconds modulo 60
      701     .
      702     return
      703         (if v-day-number <> 0
      704           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      705           else ""
      706         )
      707       + (if v-day-number <> 0 or v-hour <> 0
      708           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      709           else ""
      710         )
      711       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      712           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      713           else ""
      714         )
      715       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      716       .
      717   end.
      718   function cur-time-string returns character
      719   :
      720     define variable v-date as date      no-undo .
      721     define variable v-time as integer   no-undo .
      722     run cur-time in this-procedure
      723       (output v-date
      724       ,output v-time
      725       ) .
      726     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      727   end.
      728   function cur-time-string-sec returns character
      729   :
      730     define variable v-date as date      no-undo .
      731     define variable v-time as integer   no-undo .
      732     run cur-time in this-procedure
      733       (output v-date
      734       ,output v-time
      735       ) .
      736     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      737   end.
      738   function cur-time-custom  returns character
      739   (input p-prefix as character
      740   ,input p-date-format as character
      741   ,input p-delimiter as character
      742   ,input p-time-format as character
      743   ,input p-suffix as character
      744   )
      745   :
      746     define variable v-date as date      no-undo .
      747     define variable v-time as integer   no-undo .
      748     run cur-time in this-procedure
      749       (output v-date
      750       ,output v-time
      751       ) .
      752     return
      753       p-prefix
      754       + string(v-date, p-date-format)
      755       + p-delimiter
      756       + string(v-time, p-time-format)
      757       + p-suffix
      758       .
      759   end.
      760   function cur-time-print  returns character
      761   :
      762     define variable v-date as date      no-undo .
      763     define variable v-time as integer   no-undo .
      764     run cur-time in this-procedure
      765       (output v-date
      766       ,output v-time
      767       ) .
      768     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      769   end.
      770   function cur-time-datetime returns datetime
      771   :
      772     define variable v-char as character no-undo .
      773     define variable v-datetime as datetime no-undo .
      774     v-char = cur-time-string().
      775     v-datetime = datetime(v-char).
      776     return  v-datetime.
      777   end.
      778   function cur-time-string-msec returns character
      779   :
      780     define variable v-date as datetime  no-undo .
      781     v-date = now.
      782     return string(v-date) .
      783   end.
      784   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      785   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      786   procedure fltopend_fltopend :
      787   define input parameter p-parent-handle as handle no-undo .
      788   define input parameter p-qh as handle no-undo .
      789   define input parameter p-flt-open-open-query  as character no-undo .
      790   define input parameter p-where-cond as character no-undo .
      791   define input parameter p-use-indFIRST-query-tail as character no-undo .
      792   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      793   define input parameter p-indexed-reposition as character no-undo .
      794     do
      795     on error undo, return error
      796     :
      797   define variable v-prepare-string as character no-undo .
      798   define variable glog as logical no-undo .
      799   assign
      800   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      801                      p-where-cond + chr(32)  +
      802                      p-use-indFIRST-query-tail + chr(32) +
      803                      p-use-ind-sort-clmn-by + chr(32) +
      804                      p-indexed-reposition
      805   .
      806   assign
      807   glog = p-qh:query-prepare(v-prepare-string) no-error .
      808   if not glog
      809   or error-status:error then do:
      810     message error-status:get-message(1) view-as alert-box .
      811     undo, return error .
      812   end.
      813   assign
      814   glog = p-qh:query-open no-error .
      815   if not glog
      816   or error-status:error then do:
      817     message error-status:get-message(1) view-as alert-box .
      818     undo, return error .
      819   end.
      820     end.
      821   end procedure.
      822   procedure fltopend_fltfindd :
      823   define input parameter p-parent-handle as handle no-undo .
      824   define input parameter p-qh as handle no-undo .
      825   define input parameter p-rowid as rowid no-undo .
      826   define input parameter p-next as logical no-undo .
      827   define input parameter p-lock as integer no-undo .
      828   define input parameter p-bh as handle no-undo .
      829   define input parameter p-where-cond as character no-undo .
      830   define input parameter p-use-index-phrase as character no-undo .
      831   define variable glog as logical no-undo .
      832   define variable v-qh as handle no-undo .
      833   define variable v-bh as handle no-undo .
      834   define variable v-recid as recid no-undo .
      835   define variable v-prepare-string as character no-undo .
      836   do
      837   on error undo, return error
      838   on stop undo, return error
      839   :
      840     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      841     create buffer v-bh for table p-bh buffer-name p-bh:name.
      842     create query v-qh.
      843     v-qh:set-buffers(v-bh).
      844     v-prepare-string = substitute("for each &1 &2 &3"
      845                                     ,v-bh:name
      846                                     ,p-where-cond
      847                                     ,p-use-index-phrase).
      848     glog = v-qh:query-prepare(v-prepare-string) no-error.
      849     if not glog then do:
      850       delete object v-qh.
      851       delete object v-bh.
      852       undo, return error .
      853     end.
      854     glog = v-qh:query-open no-error .
      855     if not glog then do:
      856       delete object v-qh.
      857       delete object v-bh.
      858       undo, return error .
      859     end.
      860     if p-next then do:
      861       v-qh:reposition-to-rowid(p-rowid) no-error .
      862       glog = v-qh:get-next( p-lock) no-error .
      863       glog = v-qh:get-next( p-lock) no-error .
      864       if not glog or v-qh:query-off-end = yes then do:
      865         glog = v-qh:get-first( p-lock) no-error .
      866       end.
      867     end.
      868     else do:
      869       glog = v-qh:get-first( p-lock) no-error .
      870     end.
      871     v-recid = v-bh:recid no-error .
      872     delete object v-qh.
      873     delete object v-bh.
      874     return string(v-recid) .
      875   end.
      876   end procedure.
      877   procedure fltopend_fltfindq :
      878   define input parameter p-parent-handle as handle no-undo .
      879   define input parameter p-qh as handle no-undo .
      880   define input parameter p-next as logical no-undo .
      881   define input parameter p-lock as integer no-undo .
      882   define input parameter p-flt-open-open-query  as character no-undo .
      883   define input parameter p-where-cond as character no-undo .
      884   define input parameter p-use-indFIRST-query-tail as character no-undo .
      885   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      886   define input parameter p-indexed-reposition as character no-undo .
      887   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      888   define variable glog as logical no-undo .
      889   define variable v-qh as handle no-undo .
      890   define variable v-bh as handle no-undo extent 18.
      891   define variable v-rowid as rowid no-undo extent 18.
      892   define variable v-ii as integer no-undo .
      893   define variable v-prepare-string as character no-undo .
      894   do
      895   on error undo, return error
      896   on stop undo, return error
      897   :
      898     create query v-qh.
      899     do v-ii = 1 to p-qh:num-buffers:
      900       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      901       assign
      902       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      903       no-error.
      904       v-qh:add-buffer(v-bh[v-ii]).
      905     end.
      906     assign
      907     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      908                       p-where-cond + chr(32)  +
      909                       p-use-indFIRST-query-tail + chr(32) +
      910                       p-use-ind-sort-clmn-by + chr(32) +
      911                       p-indexed-reposition
      912     .
      913     glog = v-qh:query-prepare( v-prepare-string) no-error .
      914     if not glog then do:
      915       delete object v-qh.
      916       do v-ii = 1 to p-qh:num-buffers:
      917         delete object v-bh[v-ii].
      918       end.
      919       undo, return error .
      920     end.
      921     glog = v-qh:query-open no-error .
      922     if not glog then do:
      923       delete object v-qh.
      924       do v-ii = 1 to p-qh:num-buffers:
      925         delete object v-bh[v-ii].
      926       end.
      927       undo, return error .
      928     end.
      929     if p-next then do:
      930       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      931       glog = v-qh:get-next( p-lock) no-error .
      932       glog = v-qh:get-next( p-lock) no-error .
      933       if not glog or v-qh:query-off-end = yes then do:
      934         glog = v-qh:get-first( p-lock) no-error .
      935       end.
      936     end.
      937     else do:
      938       glog = v-qh:get-first( p-lock) no-error .
      939     end.
      940     do v-ii = 1 to p-qh:num-buffers:
      941       assign
      942       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      943       no-error.
      944     end.
      945     delete object v-qh.
      946     do v-ii = 1 to p-qh:num-buffers:
      947       delete object v-bh[v-ii].
      948     end.
      949   end.
      950   end procedure.
      951   DEFINE VARIABLE tobj-name LIKE ub.clients.obj-name NO-UNDO.
      952   DEFINE VARIABLE sort-column-name AS CHARACTER NO-UNDO.
      953   DEFINE VARIABLE v-doc-rec          AS RECID     NO-UNDO.
      954   DEFINE VARIABLE get-limkrit-all AS DECIMAL   NO-UNDO .
      955   DEFINE VARIABLE get-limkrit-cnt AS INTEGER   NO-UNDO .
      956   define variable filter-point as character no-undo init "rpsn-org".
      957   DEFINE BUFFER buf_clients FOR ub.clients.
      958   DEFINE BUFFER buf_firm FOR ub.firm.
      959   FUNCTION get-firm-name RETURNS CHARACTER
      960     ( INPUT p-firm-code AS integer )  FORWARD.
      961   FUNCTION get-limkr RETURNS DECIMAL
      962     ( INPUT p-firm-code AS integer )  FORWARD.
      963   DEFINE BUTTON B-Help
      964        LABEL "Помо&щь"
      965        SIZE 3 BY 1
      966        BGCOLOR 8 .
      967   DEFINE BUTTON b-hist
      968        LABEL "Ис&тория"
      969        SIZE 3 BY 1.
      970   DEFINE BUTTON b-lkp
      971        LABEL "&Просмотр"
      972        SIZE 10 BY 1.
      973   DEFINE BUTTON b-print
      974        LABEL "Пе&чать"
      975        SIZE 3 BY 1.
      976   DEFINE BUTTON b-quit AUTO-END-KEY
      977        LABEL "&Выход"
      978        SIZE 10 BY 1
      979        BGCOLOR 8 .
      980   DEFINE VARIABLE get-limkr-label AS CHARACTER
      981        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      982        SIZE 98 BY 4 NO-UNDO.
      983   DEFINE QUERY br-psn-org FOR
      984         X_firm SCROLLING.
      985   DEFINE BROWSE br-psn-org
      986     QUERY br-psn-org DISPLAY
      987         X_firm.firm-code  COLUMN-LABEL 'Код'  FORMAT ">>>>>>>>9":U
      988   get-firm-name( X_firm.firm-code )  COLUMN-LABEL 'Название фирмы'  FORMAT "x(60)":U
      989   X_firm.city  COLUMN-LABEL 'Страна, город'  FORMAT "x(40)":U
      990   TRIM( X_firm.addres1 ) + ' ':U + TRIM( X_firm.addres2 )  COLUMN-LABEL 'Юридический Адрес'  FORMAT "x(100)":U
      991   TRIM( X_firm.post-addr1 ) + ' ':U + TRIM( X_firm.post-addr2 )  COLUMN-LABEL 'Почтовый Адрес'  FORMAT "x(100)":U
      992   X_firm.ind  COLUMN-LABEL 'Индекс'  FORMAT "999999":U
      993   X_firm.inn  COLUMN-LABEL 'ИНН'  FORMAT "x(15)":U
      994   X_firm.kpp  COLUMN-LABEL 'КПП'  FORMAT "x(9)":U
      995   X_firm.okonh  COLUMN-LABEL 'ОКОНХ'  FORMAT "x(100)":U
      996   X_firm.okpo COLUMN-LABEL 'ОКПО' FORMAT "x(8)":U
      997   X_firm.director COLUMN-LABEL 'Руководитель' FORMAT "x(25)":U
      998   X_firm.gen-acct COLUMN-LABEL 'Главный бухгалтер' FORMAT "x(100)":U
      999   X_firm.fax COLUMN-LABEL 'Факс' FORMAT "x(20)":U
     1000   X_firm.phone COLUMN-LABEL 'Телефон' FORMAT "x(20)":U
     1001   X_firm.phone1-note COLUMN-LABEL 'Примечание' FORMAT "x(22)":U
     1002   get-limkr( X_firm.firm-code ) COLUMN-LABEL 'Лимит кредита' FORMAT "->>,>>>,>>>,>>>,>>9.99":U
     1003   ENABLE
     1004   X_firm.city
     1005       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16 FIT-LAST-COLUMN.
     1006   DEFINE FRAME Dialog-Frame
     1007        b-quit AT ROW 1 COL 1
     1008        b-lkp AT ROW 1 COL 31 WIDGET-ID 2
     1009        b-hist AT ROW 1 COL 89 WIDGET-ID 4
     1010        b-print AT ROW 1 COL 92 WIDGET-ID 6
     1011        B-Help AT ROW 1 COL 95
     1012        br-psn-org AT ROW 3 COL 1 WIDGET-ID 100
     1013        get-limkr-label AT ROW 19.13 COL 1 NO-LABEL WIDGET-ID 10
     1014        SPACE(0.70) SKIP(0.09)
     1015       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1016            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1017            TITLE ""
     1018            CANCEL-BUTTON b-quit.
     1019   ASSIGN
     1020          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1021          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1022   ASSIGN
     1023          get-limkr-label:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1024   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1025   DO:
     1026     APPLY "END-ERROR":U TO SELF.
     1027   END.
     1028   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
     1029   DO:
     1030   define variable v-rid-list as character no-undo .
     1031     IF NOT AVAILABLE X_firm THEN RETURN NO-APPLY.
     1032     run ref/cclihist.w ( INPUT     parparentproc
     1033                          ,INPUT        0
     1034                          ,INPUT        "":U
     1035                          ,INPUT        0
     1036                          ,INPUT        "":U
     1037                          ,INPUT        "one":U
     1038                          ,INPUT        'орг':U
     1039                          ,INPUT        X_firm.firm-code
     1040                          ,INPUT        ?
     1041                          ,INPUT        ?
     1042                          ,INPUT        "":U
     1043                          ,INPUT        "":U
     1044                          ,INPUT        v-cntxt-db-num
     1045                          ,INPUT-OUTPUT v-rid-list          ) NO-ERROR.
     1046   END.
     1047   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1048   DO:
     1049   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1050   IF NOT AVAILABLE X_firm  THEN RETURN NO-APPLY.
     1051   run ref/showcli.p ( INPUT        parparentproc
     1052                    ,INPUT        'орг':U
     1053                    ,INPUT        X_firm.firm-code).
     1054   END.
     1055   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1056   DO:
     1057     ASSIGN
     1058     v-doc-rec = RECID( X_firm ) NO-ERROR.
     1059     RUN proc-b-print IN THIS-PROCEDURE.
     1060     REPOSITION br-psn-org TO RECID v-doc-rec NO-ERROR.
     1061     APPLY "ENTRY":U TO br-psn-org IN FRAME Dialog-Frame.
     1062   END.
     1063   ON DEFAULT-ACTION OF br-psn-org IN FRAME Dialog-Frame
     1064   DO:
     1065       APPLY "CHOOSE":U TO b-lkp IN FRAME Dialog-Frame.
     1066   END.
     1067   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1068   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1069   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1070   on help of frame Dialog-Frame
     1071   do:
     1072     run gbl/app_help.p
     1073       (input this-procedure :file-name
     1074       ,input ''
     1075       ,input ?
     1076       ) no-error.
     1077     if error-status :error then do:
     1078       message
     1079         "Ошибка при вызове помощи"
     1080         error-status :get-message(1)
     1081         view-as alert-box .
     1082     end.
     1083   end.
     1084   run minbtn-set in this-procedure .
     1085   on choose of b-help in frame Dialog-Frame
     1086   do:
     1087     apply "help":u to frame Dialog-Frame .
     1088   end.
     1089   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1090   procedure minbtn-set :
     1091       do
     1092           on error undo, return error return-value
     1093           :
     1094           define variable ii              as integer       no-undo .
     1095           define variable fh              as widget-handle no-undo .
     1096           define variable hh              as widget-handle no-undo .
     1097           define variable v-h             as handle        extent 4 no-undo .
     1098           define variable v-name-button   as character     no-undo .
     1099           define variable v-help-old-x    as decimal       no-undo .
     1100           define variable v-help-old-y    as decimal       no-undo .
     1101           define variable v-help-old-size as decimal       no-undo .
     1102           define variable v-frame-width   as decimal       no-undo .
     1103           define variable jj              as integer       no-undo .
     1104           do
     1105               on error undo, return error
     1106               :
     1107               assign
     1108                   v-frame-width = frame Dialog-Frame:width - 0.3
     1109                   fh            = frame Dialog-Frame:first-child
     1110                   hh            = fh:first-child
     1111                   ii            = 1
     1112                   .
     1113               do while valid-handle(hh):
     1114                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1115                   do:
     1116                       case lc(hh:name) :
     1117                           when "b-help" then
     1118                               do:
     1119                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1120                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1121                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1122                                   hh:TOOLTIP = "Помощь" .
     1123                                   v-help-old-x = hh:column .
     1124                                   v-help-old-y = hh:row    .
     1125                                   v-help-old-size = hh:width .
     1126                                   hh:width-chars = 2.5 .
     1127                               end.
     1128                           when "b-print" then
     1129                               do:
     1130                                   hh:load-image("cmp/b-print.bmp":u) .
     1131                                   hh:TOOLTIP = "Печать" .
     1132                                   v-h[ii] = hh:handle .
     1133                                   ii = ii + 1 .
     1134                                   hh:width-chars = 3 .
     1135                               end.
     1136                           when "b-history" or
     1137                           when "b-hist" then
     1138                               do:
     1139                                   hh:load-image("cmp/b-hist.bmp":u) .
     1140                                   hh:TOOLTIP = "История" .
     1141                                   v-h[ii] = hh:handle .
     1142                                   ii = ii + 1 .
     1143                                   hh:width-chars = 3 .
     1144                               end.
     1145                           when "b-sch" then
     1146                               do:
     1147                                   hh:load-image("cmp/b-sch.bmp":u) .
     1148                                   hh:TOOLTIP = "Установка Фильтра" .
     1149                                   v-h[ii] = hh:handle .
     1150                                   ii = ii + 1 .
     1151                                   hh:width-chars = 3 .
     1152                               end.
     1153                           when "b-hist-user" then
     1154                               do:
     1155                                   hh:load-image("cmp/b-hist.bmp":u) .
     1156                                   hh:TOOLTIP = "История пользователя" .
     1157                                   ii = ii + 1 .
     1158                               end.
     1159                       end case.
     1160                   end.
     1161                   hh = hh:next-sibling.
     1162               end.
     1163               b-help:column = v-frame-width - b-help:width-chars.
     1164               jj = 0.
     1165               repeat ii = 4 to 1 by -1 :
     1166                   if valid-handle (v-h[ii] ) then
     1167                   do:
     1168                       jj  = jj + 1 .
     1169                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1170                       v-h[ii]:row    = v-help-old-y .
     1171                   end.
     1172               end.
     1173           end.
     1174       end.
     1175   end procedure.
     1176   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1177   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1178   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1179   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1180   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1181   define variable v-diasize-current-frame-height as decimal   no-undo .
     1182   define variable v-diasize-change-size          as logical   no-undo .
     1183   define variable v-diasize-resize-button        as handle    no-undo .
     1184   define variable v-diasize-wndmax               as logical   no-undo .
     1185   define variable v-diasize-wndstore             as logical   no-undo .
     1186   define variable v-diasize-proc-name            as character no-undo .
     1187   define variable v-diasize-browse-handle        as handle    no-undo .
     1188   define variable v-diasize-browse-number        as integer   no-undo .
     1189   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1190   define temp-table temp-diasize-handle no-undo
     1191     field handle-value  as handle
     1192     field save-position as decimal
     1193     index xpk is primary unique handle-value
     1194     .
     1195   define temp-table temp-browse-handle no-undo
     1196     field browse-type   as character
     1197     field browse-number as integer
     1198     field browse-handle as handle
     1199     field original-size as decimal
     1200     index xpk is primary unique browse-type browse-number
     1201     index xie browse-type browse-handle
     1202   .
     1203   procedure diasize_change-height :
     1204     define input  parameter p-change-value  as decimal   no-undo .
     1205     define input  parameter p-move-resize   as logical   no-undo .
     1206     define variable v-field-group-handle    as handle    no-undo .
     1207     define variable v-object-handle         as handle    no-undo .
     1208     define variable v-frame-height          as decimal   no-undo .
     1209     define variable v-frame-virtual-height  as decimal   no-undo .
     1210     define variable v-browse-height         as decimal   no-undo .
     1211     define variable v-window-height         as decimal   no-undo .
     1212     define variable v-window-virtual-height as decimal   no-undo .
     1213     define variable v-change-sign           as integer   no-undo .
     1214     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1215     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1216     if p-change-value > 0
     1217     then do:
     1218       if frame Dialog-Frame :height + p-change-value
     1219           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1220       then do:
     1221         assign
     1222           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1223                           - (frame Dialog-Frame :height-chars)
     1224         .
     1225         if p-change-value <= 0
     1226         then do:
     1227           run diasize_position-resize-button in this-procedure .
     1228           return .
     1229         end.
     1230       end.
     1231     end.
     1232     if p-change-value < 0
     1233     then do:
     1234       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1235       then do:
     1236         assign
     1237           p-change-value = v-diasize-orig-frame-height
     1238                          - (frame Dialog-Frame :height-chars)
     1239         .
     1240         if p-change-value >= 0
     1241         then do:
     1242           run diasize_position-resize-button in this-procedure .
     1243           return .
     1244         end.
     1245       end.
     1246     end.
     1247     if p-change-value >= 0
     1248     then do:
     1249       assign
     1250         v-change-sign = 1
     1251       .
     1252     end.
     1253     else do:
     1254       assign
     1255         v-change-sign = -1
     1256       .
     1257     end.
     1258     assign
     1259       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1260     .
     1261     if p-change-value = 0
     1262     then do:
     1263       run diasize_position-resize-button in this-procedure .
     1264       return .
     1265     end.
     1266     move_block:
     1267     do
     1268     on error undo move_block, retry move_block
     1269     :
     1270       if retry
     1271       then do:
     1272         do
     1273         on error undo move_block, leave move_block
     1274         :
     1275           if p-change-value > 0
     1276           then do:
     1277             for each buf_temp-diasize-handle
     1278             on error undo, next
     1279             :
     1280               assign
     1281                 v-object-handle = buf_temp-diasize-handle.handle-value
     1282               .
     1283               if v-object-handle <> v-diasize-resize-button
     1284               then do:
     1285                 assign
     1286                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1287                 .
     1288               end.
     1289             end.
     1290             assign
     1291               v-diasize-browse-handle :height = v-browse-height
     1292             .
     1293             for each buf_temp-browse-handle
     1294               where buf_temp-browse-handle.browse-type = 'height':u
     1295             on error undo, next
     1296             :
     1297               assign
     1298                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1299               .
     1300             end.
     1301             assign
     1302               frame Dialog-Frame :height = v-frame-height
     1303             .
     1304             if frame Dialog-Frame :scrollable = true
     1305             then do:
     1306               assign
     1307                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1308               .
     1309             end.
     1310             run diasize_position-resize-button in this-procedure .
     1311           end.
     1312           else do:
     1313             if frame Dialog-Frame :scrollable = true
     1314             then do:
     1315               assign
     1316                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1317               .
     1318             end.
     1319             assign
     1320               frame Dialog-Frame :height = v-frame-height
     1321             .
     1322             assign
     1323               v-diasize-browse-handle :height = v-browse-height
     1324             .
     1325             for each buf_temp-browse-handle
     1326               where buf_temp-browse-handle.browse-type = 'height':u
     1327             on error undo, next
     1328             :
     1329               assign
     1330                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1331               .
     1332             end.
     1333             for each buf_temp-diasize-handle
     1334             on error undo, next
     1335             :
     1336               assign
     1337                 v-object-handle = buf_temp-diasize-handle.handle-value
     1338               .
     1339               if v-object-handle <> v-diasize-resize-button
     1340               then do:
     1341                 assign
     1342                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1343                 .
     1344               end.
     1345             end.
     1346             run diasize_position-resize-button in this-procedure .
     1347           end.
     1348           assign
     1349             v-diasize-change-size = false
     1350           .
     1351           leave move_block .
     1352         end.
     1353       end.
     1354       assign
     1355         v-diasize-need-full-display = true
     1356       .
     1357       if v-diasize-change-size = false
     1358       then do:
     1359         assign
     1360           v-diasize-change-size = true
     1361         .
     1362       end.
     1363       else do:
     1364         return .
     1365       end.
     1366       assign
     1367         v-frame-height = frame Dialog-Frame :height
     1368         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1369         v-browse-height = v-diasize-browse-handle :height
     1370       .
     1371       for each buf_temp-browse-handle
     1372         where buf_temp-browse-handle.browse-type = 'height':u
     1373       :
     1374         assign
     1375           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1376         .
     1377       end.
     1378       for each buf_temp-diasize-handle
     1379       :
     1380         delete buf_temp-diasize-handle .
     1381       end.
     1382       assign
     1383         v-field-group-handle = frame Dialog-Frame :first-child
     1384       .
     1385       do while valid-handle(v-field-group-handle)
     1386       :
     1387         assign
     1388           v-object-handle = v-field-group-handle :first-child
     1389         .
     1390         do while valid-handle(v-object-handle)
     1391         :
     1392           if  v-object-handle <> v-diasize-browse-handle :handle
     1393           and can-query(v-object-handle, "row")
     1394           and can-query(v-object-handle, "height")
     1395           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1396           then do:
     1397             find first buf_temp-browse-handle
     1398               where buf_temp-browse-handle.browse-type   = 'height':u
     1399                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1400               no-error .
     1401             if available buf_temp-browse-handle
     1402             then do:
     1403             end.
     1404             else do:
     1405               create buf_temp-diasize-handle .
     1406               assign
     1407                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1408                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1409               .
     1410             end.
     1411           end.
     1412           assign
     1413             v-object-handle = v-object-handle :next-sibling
     1414           .
     1415         end.
     1416         assign
     1417           v-field-group-handle = v-field-group-handle :next-sibling
     1418         .
     1419       end.
     1420       do with frame Dialog-Frame
     1421       :
     1422         hide v-diasize-resize-button .
     1423         assign
     1424           v-diasize-resize-button :row    = 1
     1425           v-diasize-resize-button :column = 1
     1426         .
     1427       end.
     1428       if p-change-value > 0
     1429       then do:
     1430         if frame Dialog-Frame :scrollable = true
     1431         then do:
     1432           assign
     1433             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1434             no-error .
     1435           if error-status :error
     1436           or error-status :get-message(1) <> ""
     1437           then do:
     1438             undo move_block, retry move_block .
     1439           end.
     1440         end.
     1441         assign
     1442           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1443           no-error .
     1444         if error-status :error
     1445         or error-status :get-message(1) <> ""
     1446         then do:
     1447           undo move_block, retry move_block .
     1448         end.
     1449         assign
     1450           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1451           no-error .
     1452         if error-status :error
     1453         or error-status :get-message(1) <> ""
     1454         then do:
     1455           undo move_block, retry move_block .
     1456         end.
     1457         for each buf_temp-browse-handle
     1458           where buf_temp-browse-handle.browse-type = 'height':u
     1459         on error undo move_block, retry move_block
     1460         :
     1461           assign
     1462             buf_temp-browse-handle.browse-handle :height
     1463               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1464             no-error .
     1465           if error-status :error
     1466           or error-status :get-message(1) <> ""
     1467           then do:
     1468             undo move_block, retry move_block .
     1469           end.
     1470         end.
     1471         for each buf_temp-diasize-handle
     1472         on error undo move_block, retry move_block
     1473         :
     1474           assign
     1475             v-object-handle = buf_temp-diasize-handle.handle-value
     1476           .
     1477           if v-object-handle <> v-diasize-resize-button
     1478           then do:
     1479             assign
     1480               v-object-handle :row = v-object-handle :row + p-change-value
     1481               no-error .
     1482             if error-status :error
     1483             or error-status :get-message(1) <> ""
     1484             then do:
     1485               undo move_block, retry move_block .
     1486             end.
     1487           end.
     1488         end.
     1489       end.
     1490       else do:
     1491         for each buf_temp-diasize-handle
     1492         on error undo move_block, retry move_block
     1493         :
     1494           assign
     1495             v-object-handle = buf_temp-diasize-handle.handle-value
     1496           .
     1497           if v-object-handle <> v-diasize-resize-button
     1498           then do:
     1499             assign
     1500               v-object-handle :row = v-object-handle :row + p-change-value
     1501               no-error .
     1502             if error-status :error
     1503             or error-status :get-message(1) <> ""
     1504             then do:
     1505               undo move_block, retry move_block .
     1506             end.
     1507           end.
     1508         end.
     1509         assign
     1510           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1511           no-error .
     1512         if error-status :error
     1513         or error-status :get-message(1) <> ""
     1514         then do:
     1515           undo move_block, retry move_block .
     1516         end.
     1517         for each buf_temp-browse-handle
     1518           where buf_temp-browse-handle.browse-type = 'height':u
     1519         on error undo move_block, retry move_block
     1520         :
     1521           assign
     1522             buf_temp-browse-handle.browse-handle :height
     1523               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1524             no-error .
     1525           if error-status :error
     1526           or error-status :get-message(1) <> ""
     1527           then do:
     1528             undo move_block, retry move_block .
     1529           end.
     1530         end.
     1531         assign
     1532           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1533           no-error .
     1534         if error-status :error
     1535         or error-status :get-message(1) <> ""
     1536         then do:
     1537           undo move_block, retry move_block .
     1538         end.
     1539         if frame Dialog-Frame :scrollable = true
     1540         then do:
     1541           assign
     1542             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1543             no-error .
     1544           if error-status :error
     1545           or error-status :get-message(1) <> ""
     1546           then do:
     1547             undo move_block, retry move_block .
     1548           end.
     1549         end.
     1550       end.
     1551       if p-move-resize = true
     1552       then do:
     1553         run diasize_position-resize-button in this-procedure .
     1554       end.
     1555       if v-diasize-wndstore = true
     1556       then do:
     1557         if connected("ub") = true
     1558         then do:
     1559           define variable v-cntxt-db-num        as integer   no-undo .
     1560           define variable v-cntxt-userid        as character no-undo .
     1561           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1562                                             , OUTPUT v-cntxt-userid
     1563                                             ) .
     1564           run gbl/wndsizew.p
     1565             (input  v-cntxt-db-num
     1566             ,input  v-cntxt-userid
     1567             ,input  v-diasize-proc-name
     1568             ,input  'height':u
     1569             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1570             ) .
     1571         end.
     1572       end.
     1573     end.
     1574     assign
     1575       v-diasize-change-size = false
     1576     .
     1577   end procedure.
     1578   procedure diasize_set-height :
     1579     define input  parameter p-new-height  as decimal   no-undo .
     1580     define input  parameter p-move-resize as logical   no-undo .
     1581     do
     1582     on error undo, return error return-value
     1583     :
     1584       run diasize_change-height in this-procedure
     1585         (input  (p-new-height - frame Dialog-Frame :height)
     1586         ,input  p-move-resize
     1587         ) .
     1588     end.
     1589   end procedure.
     1590   procedure diasize_change-width :
     1591     define input  parameter p-change-value as decimal   no-undo .
     1592     define input  parameter p-move-resize  as logical   no-undo .
     1593     define variable v-field-group-handle   as handle    no-undo .
     1594     define variable v-object-handle        as handle    no-undo .
     1595     define variable v-frame-width          as decimal   no-undo .
     1596     define variable v-frame-virtual-width  as decimal   no-undo .
     1597     define variable v-browse-width         as decimal   no-undo .
     1598     define variable v-window-width         as decimal   no-undo .
     1599     define variable v-window-virtual-width as decimal   no-undo .
     1600     define variable v-change-sign          as integer   no-undo .
     1601     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1602     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1603     if p-change-value > 0
     1604     then do:
     1605       if frame Dialog-Frame :width + p-change-value >
     1606           session :width-chars
     1607       then do:
     1608         assign
     1609           p-change-value = session :width-chars - frame Dialog-Frame :width
     1610         .
     1611         if p-change-value <= 0
     1612         then do:
     1613           run diasize_position-resize-button in this-procedure .
     1614           return .
     1615         end.
     1616       end.
     1617     end.
     1618     if p-change-value < 0
     1619     then do:
     1620       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1621       then do:
     1622         assign
     1623           p-change-value = v-diasize-orig-frame-width
     1624                          - frame Dialog-Frame :width
     1625         .
     1626         if p-change-value >= 0
     1627         then do:
     1628           run diasize_position-resize-button in this-procedure .
     1629           return .
     1630         end.
     1631       end.
     1632     end.
     1633     if p-change-value >= 0
     1634     then do:
     1635       assign
     1636         v-change-sign = 1
     1637       .
     1638     end.
     1639     else do:
     1640       assign
     1641         v-change-sign = -1
     1642       .
     1643     end.
     1644     assign
     1645       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1646     .
     1647     if p-change-value = 0
     1648     then do:
     1649       run diasize_position-resize-button in this-procedure .
     1650       return .
     1651     end.
     1652     move_block:
     1653     do
     1654     on error undo move_block, leave move_block
     1655     :
     1656       if retry
     1657       then do:
     1658         do
     1659         on error undo move_block, leave move_block
     1660         :
     1661           if p-change-value > 0
     1662           then do:
     1663             for each buf_temp-diasize-handle
     1664             on error undo, next
     1665             :
     1666               assign
     1667                 v-object-handle = buf_temp-diasize-handle.handle-value
     1668               .
     1669               if v-object-handle <> v-diasize-resize-button
     1670               then do:
     1671                 assign
     1672                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1673                 .
     1674               end.
     1675             end.
     1676             assign
     1677               v-diasize-browse-handle :width = v-browse-width
     1678             .
     1679             for each buf_temp-browse-handle
     1680               where buf_temp-browse-handle.browse-type = 'width':u
     1681             on error undo, next
     1682             :
     1683               assign
     1684                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1685               .
     1686             end.
     1687             assign
     1688               frame Dialog-Frame :width = v-frame-width
     1689             .
     1690             if frame Dialog-Frame :scrollable = true
     1691             then do:
     1692               assign
     1693                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1694               .
     1695             end.
     1696             run diasize_position-resize-button in this-procedure .
     1697           end.
     1698           else do:
     1699             if frame Dialog-Frame :scrollable = true
     1700             then do:
     1701               assign
     1702                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1703               .
     1704             end.
     1705             assign
     1706               frame Dialog-Frame :width = v-frame-width
     1707             .
     1708             for each buf_temp-browse-handle
     1709               where buf_temp-browse-handle.browse-type = 'width':u
     1710             on error undo, next
     1711             :
     1712               assign
     1713                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1714               .
     1715             end.
     1716             assign
     1717               v-diasize-browse-handle :width = v-browse-width
     1718             .
     1719             for each buf_temp-diasize-handle
     1720             on error undo, next
     1721             :
     1722               assign
     1723                 v-object-handle = buf_temp-diasize-handle.handle-value
     1724               .
     1725               if v-object-handle <> v-diasize-resize-button
     1726               then do:
     1727                 assign
     1728                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1729                 .
     1730               end.
     1731             end.
     1732             run diasize_position-resize-button in this-procedure .
     1733           end.
     1734           assign
     1735             v-diasize-change-size = false
     1736           .
     1737           leave move_block .
     1738         end.
     1739       end.
     1740       assign
     1741         v-diasize-need-full-display = true
     1742       .
     1743       if v-diasize-change-size = false
     1744       then do:
     1745         assign
     1746           v-diasize-change-size = true
     1747         .
     1748       end.
     1749       else do:
     1750         return .
     1751       end.
     1752       assign
     1753         v-frame-width = frame Dialog-Frame :width
     1754         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1755         v-browse-width = v-diasize-browse-handle :width
     1756       .
     1757       for each buf_temp-browse-handle
     1758         where buf_temp-browse-handle.browse-type = 'width':u
     1759       :
     1760         assign
     1761           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1762         .
     1763       end.
     1764       for each buf_temp-diasize-handle
     1765       :
     1766         delete buf_temp-diasize-handle .
     1767       end.
     1768       assign
     1769         v-field-group-handle = frame Dialog-Frame :first-child
     1770       .
     1771       do while valid-handle(v-field-group-handle)
     1772       :
     1773         assign
     1774           v-object-handle = v-field-group-handle :first-child
     1775         .
     1776         do while valid-handle(v-object-handle)
     1777         :
     1778           if  v-object-handle <> v-diasize-browse-handle :handle
     1779           and v-object-handle <> v-diasize-resize-button
     1780           and can-query(v-object-handle, "row")
     1781           and can-query(v-object-handle, "height")
     1782           and ( v-object-handle :col + v-object-handle :width
     1783                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1784               )
     1785           then do:
     1786             find first buf_temp-browse-handle
     1787               where buf_temp-browse-handle.browse-type   = 'width':u
     1788                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1789               no-error .
     1790             if available buf_temp-browse-handle
     1791             then do:
     1792             end.
     1793             else do:
     1794               create buf_temp-diasize-handle .
     1795               assign
     1796                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1797                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1798               .
     1799             end.
     1800           end.
     1801           assign
     1802             v-object-handle = v-object-handle :next-sibling
     1803           .
     1804         end.
     1805         assign
     1806           v-field-group-handle = v-field-group-handle :next-sibling
     1807         .
     1808       end.
     1809       do with frame Dialog-Frame
     1810       :
     1811         hide v-diasize-resize-button .
     1812         v-diasize-resize-button :row = 1.
     1813         v-diasize-resize-button :column = 1.
     1814       end.
     1815       if p-change-value > 0
     1816       then do:
     1817         if frame Dialog-Frame :scrollable = true
     1818         then do:
     1819           assign
     1820             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1821             no-error .
     1822           if error-status :error
     1823           or error-status :get-message(1) <> ""
     1824           then do:
     1825             undo move_block, retry move_block.
     1826           end.
     1827         end.
     1828         assign
     1829           frame Dialog-Frame :width = v-frame-width + p-change-value
     1830           no-error .
     1831         if error-status :error
     1832         or error-status :get-message(1) <> ""
     1833         then do:
     1834           undo move_block, retry move_block.
     1835         end.
     1836         assign
     1837           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1838         no-error .
     1839         if error-status :error
     1840         or error-status :get-message(1) <> ""
     1841         then do:
     1842           undo move_block, retry move_block.
     1843         end.
     1844         for each buf_temp-browse-handle
     1845           where buf_temp-browse-handle.browse-type = 'width':u
     1846         on error undo move_block, retry move_block
     1847         :
     1848           assign
     1849             buf_temp-browse-handle.browse-handle :width
     1850               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1851             no-error .
     1852           if error-status :error
     1853           or error-status :get-message(1) <> ""
     1854           then do:
     1855             undo move_block, retry move_block .
     1856           end.
     1857         end.
     1858         for each buf_temp-diasize-handle
     1859         on error undo move_block, retry move_block
     1860         :
     1861           assign
     1862             v-object-handle = buf_temp-diasize-handle.handle-value
     1863           .
     1864           if v-object-handle <> v-diasize-resize-button
     1865           then do:
     1866             assign
     1867               v-object-handle :col = v-object-handle :col + p-change-value
     1868               no-error .
     1869             if error-status :error
     1870             or error-status :get-message(1) <> ""
     1871             then do:
     1872               undo move_block, retry move_block .
     1873             end.
     1874           end.
     1875         end.
     1876       end.
     1877       else do:
     1878         for each buf_temp-diasize-handle
     1879         on error undo move_block, retry move_block
     1880         :
     1881           assign
     1882             v-object-handle = buf_temp-diasize-handle.handle-value
     1883           .
     1884           if v-object-handle <> v-diasize-resize-button
     1885           then do:
     1886             assign
     1887               v-object-handle :col = v-object-handle :col + p-change-value
     1888               no-error .
     1889             if error-status :error
     1890             or error-status :get-message(1) <> ""
     1891             then do:
     1892               undo move_block, retry move_block .
     1893             end.
     1894           end.
     1895         end.
     1896         for each buf_temp-browse-handle
     1897           where buf_temp-browse-handle.browse-type = 'width':u
     1898         on error undo move_block, retry move_block
     1899         :
     1900           assign
     1901             buf_temp-browse-handle.browse-handle :width
     1902               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1903             no-error .
     1904           if error-status :error
     1905           or error-status :get-message(1) <> ""
     1906           then do:
     1907             undo move_block, retry move_block .
     1908           end.
     1909         end.
     1910         assign
     1911           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1912           no-error .
     1913         if error-status :error
     1914         or error-status :get-message(1) <> ""
     1915         then do:
     1916           undo move_block, retry move_block.
     1917         end.
     1918         assign
     1919           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1920         no-error .
     1921         if error-status :error
     1922         or error-status :get-message(1) <> ""
     1923         then do:
     1924           undo move_block, retry move_block.
     1925         end.
     1926         if frame Dialog-Frame :scrollable = true
     1927         then do:
     1928           assign
     1929             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1930           no-error .
     1931           if error-status :error
     1932           or error-status :get-message(1) <> ""
     1933           then do:
     1934             undo move_block, retry move_block.
     1935           end.
     1936         end.
     1937       end.
     1938       if p-move-resize
     1939       then do:
     1940         run diasize_position-resize-button in this-procedure .
     1941       end.
     1942       if v-diasize-wndstore = true
     1943       then do:
     1944         if connected("ub") = true
     1945         then do:
     1946           define variable v-cntxt-db-num        as integer   no-undo .
     1947           define variable v-cntxt-userid        as character no-undo .
     1948           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1949                                             , OUTPUT v-cntxt-userid
     1950                                             ) .
     1951           run gbl/wndsizew.p
     1952             (input  v-cntxt-db-num
     1953             ,input  v-cntxt-userid
     1954             ,input  v-diasize-proc-name
     1955             ,input  'width':u
     1956             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1957             ) .
     1958         end.
     1959       end.
     1960     end.
     1961     assign
     1962       v-diasize-change-size = false
     1963     .
     1964   end procedure.
     1965   procedure diasize_set-width :
     1966     define input  parameter p-new-width  as decimal   no-undo .
     1967     define input  parameter p-move-resize as logical   no-undo .
     1968     do
     1969     on error undo, return error return-value
     1970     :
     1971       run diasize_change-width in this-procedure
     1972         (input  (p-new-width - frame Dialog-Frame :width)
     1973         ,input  p-move-resize
     1974         ) .
     1975     end.
     1976   end procedure.
     1977   procedure diasize_position-resize-button :
     1978     do with frame Dialog-Frame
     1979     :
     1980       hide v-diasize-resize-button .
     1981       assign
     1982         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1983                     - 1
     1984                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1985         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1986                     - 1
     1987                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1988       .
     1989       view v-diasize-resize-button .
     1990     end.
     1991   end procedure.
     1992   on alt-right anywhere
     1993   do:
     1994     run diasize_change-width in this-procedure
     1995       (input 1
     1996       ,input true
     1997       ) .
     1998     return no-apply .
     1999   end.
     2000   on alt-left anywhere
     2001   do:
     2002     run diasize_change-width in this-procedure
     2003       (input -1
     2004       ,input true
     2005       ) .
     2006     return no-apply .
     2007   end.
     2008   on alt-down anywhere
     2009   do:
     2010     run diasize_change-height in this-procedure
     2011       (input 1
     2012       ,input true
     2013       ) .
     2014     return no-apply .
     2015   end.
     2016   on alt-up anywhere
     2017   do:
     2018     run diasize_change-height in this-procedure
     2019       (input -1
     2020       ,input true
     2021       ) .
     2022     return no-apply .
     2023   end.
     2024   on alt-enter of frame Dialog-Frame
     2025   do:
     2026     run diasize_maximize in this-procedure
     2027       (input  ?
     2028       ).
     2029     return no-apply .
     2030   end.
     2031   procedure diasize_end-move :
     2032     do
     2033     on error undo, return error return-value
     2034     :
     2035       define variable v-row-delta as decimal   no-undo .
     2036       define variable v-col-delta as decimal   no-undo .
     2037       define variable v-new-row as decimal   no-undo .
     2038       define variable v-new-col as decimal   no-undo .
     2039       assign
     2040         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2041         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2042       .
     2043       assign
     2044         v-row-delta = v-new-row - frame Dialog-Frame :height
     2045         v-col-delta = v-new-col - frame Dialog-Frame :width
     2046       .
     2047       run diasize_change-height in this-procedure
     2048         (input v-row-delta
     2049         ,input true
     2050         ) .
     2051       run diasize_change-width in this-procedure
     2052         (input v-col-delta
     2053         ,input true
     2054         ) .
     2055     end.
     2056   end procedure.
     2057   procedure diasize_maximize :
     2058     define input  parameter p-action as logical   no-undo .
     2059     do
     2060     on error undo, return error return-value
     2061     :
     2062       if p-action = ?
     2063       then do:
     2064         if v-diasize-need-maximize = true
     2065         then do:
     2066           assign
     2067             p-action = true
     2068           .
     2069         end.
     2070         else do:
     2071           assign
     2072             p-action = false
     2073           .
     2074         end.
     2075       end.
     2076       if p-action = true
     2077       then do:
     2078         run diasize_change-height in this-procedure
     2079           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2080               - frame Dialog-Frame :height-chars
     2081           ,input true
     2082           ) .
     2083         run diasize_change-width in this-procedure
     2084           (input session :width-chars
     2085               - frame Dialog-Frame :width-chars
     2086           ,input true
     2087           ) .
     2088         assign
     2089           v-diasize-need-maximize = false
     2090         .
     2091       end.
     2092       else do:
     2093         run diasize_change-width in this-procedure
     2094           (input v-diasize-orig-frame-width
     2095               - frame Dialog-Frame :width-chars
     2096           ,input true
     2097           ) .
     2098         run diasize_change-height in this-procedure
     2099           (input v-diasize-orig-frame-height
     2100               - frame Dialog-Frame :height-chars
     2101           ,input true
     2102           ) .
     2103         assign
     2104           v-diasize-need-maximize = true
     2105         .
     2106       end.
     2107     end.
     2108   end procedure.
     2109   procedure diasize_restore-orig-size :
     2110     do
     2111     on error undo, return error return-value
     2112     :
     2113       assign
     2114         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2115         v-diasize-current-frame-height = frame Dialog-Frame :height
     2116       .
     2117       run diasize_set-height in this-procedure
     2118         (input  v-diasize-orig-frame-height
     2119         ,input  true
     2120         ) .
     2121       run diasize_set-width in this-procedure
     2122         (input  v-diasize-orig-frame-width
     2123         ,input  true
     2124         ) .
     2125     end.
     2126   end procedure.
     2127   procedure diasize_restore-current-size :
     2128     do
     2129     on error undo, return error return-value
     2130     :
     2131       run diasize_set-height in this-procedure
     2132         (input  v-diasize-current-frame-height
     2133         ,input  true
     2134         ) .
     2135       run diasize_set-width in this-procedure
     2136         (input  v-diasize-current-frame-width
     2137         ,input  true
     2138         ) .
     2139     end.
     2140   end procedure.
     2141   procedure diasize_set-browse-handle :
     2142     define input  parameter p-browse-handle as handle   no-undo .
     2143     define buffer buf_temp-browse-handle for temp-browse-handle .
     2144     do
     2145     on error undo, return error return-value
     2146     :
     2147       assign
     2148         v-diasize-browse-handle = p-browse-handle
     2149       .
     2150       for each buf_temp-browse-handle
     2151       on error undo, return error return-value
     2152       :
     2153         delete buf_temp-browse-handle .
     2154       end.
     2155     end.
     2156   end procedure.
     2157   procedure diasize_add_browse :
     2158     define input  parameter p-browse-type   as character no-undo .
     2159     define input  parameter p-browse-handle as handle    no-undo .
     2160     define buffer buf_temp-browse-handle for temp-browse-handle .
     2161     do
     2162     on error undo, return error return-value
     2163     :
     2164       assign
     2165         v-diasize-browse-number = v-diasize-browse-number + 1
     2166       .
     2167       create buf_temp-browse-handle .
     2168       assign
     2169         buf_temp-browse-handle.browse-type   = p-browse-type
     2170         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2171         buf_temp-browse-handle.browse-handle = p-browse-handle
     2172       .
     2173     end.
     2174   end procedure.
     2175   procedure diasize_init :
     2176     define variable v-default-value    as logical   no-undo .
     2177     define variable v-restore-saved    as logical   no-undo .
     2178     define variable v-resize-value-str as character no-undo .
     2179     do
     2180     on error undo, return error return-value
     2181     :
     2182       do with frame Dialog-Frame
     2183       :
     2184         assign
     2185           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2186           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2187           v-diasize-browse-handle     = browse br-psn-org :handle
     2188         .
     2189         create button v-diasize-resize-button
     2190         assign
     2191           parent        = frame Dialog-Frame :first-child
     2192           label         = "s"
     2193           height-pixels = 16
     2194           width-pixels  = 16
     2195           visible       = true
     2196           sensitive     = true
     2197           movable       = true
     2198           triggers:
     2199             on end-move persistent run diasize_end-move in this-procedure .
     2200           end triggers.
     2201         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2202         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2203         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2204         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2205         assign
     2206           v-diasize-wndmax = false
     2207         .
     2208         if connected("ub") = true
     2209         then do:
     2210           define variable v-cntxt-db-num        as integer   no-undo .
     2211           define variable v-cntxt-userid        as character no-undo .
     2212           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2213                                             , OUTPUT v-cntxt-userid
     2214                                             ) .
     2215           run gbl/wndpar_r.p
     2216             (input  v-cntxt-db-num
     2217             ,input  v-cntxt-userid
     2218             ,input  'wndmax':U
     2219             ,output v-diasize-wndmax
     2220             ,output v-default-value
     2221             ) .
     2222         end.
     2223         assign
     2224           v-diasize-wndstore = false
     2225         .
     2226         if connected("ub") = true
     2227         then do:
     2228           run gbl/wndpar_r.p
     2229             (input  v-cntxt-db-num
     2230             ,input  v-cntxt-userid
     2231             ,input  'wndstore':U
     2232             ,output v-diasize-wndstore
     2233             ,output v-default-value
     2234             ) .
     2235         end.
     2236         assign
     2237           v-diasize-proc-name = entry(1, program-name(2), '.')
     2238         .
     2239         if v-diasize-wndstore = true
     2240         then do:
     2241           assign
     2242             v-restore-saved = false
     2243           .
     2244           if connected("ub") = true
     2245           then do:
     2246             run gbl/wndsizer.p
     2247               (input  v-cntxt-db-num
     2248               ,input  v-cntxt-userid
     2249               ,input  v-diasize-proc-name
     2250               ,input  'height':u
     2251               ,output v-resize-value-str
     2252               ) .
     2253             if v-resize-value-str <> '':U
     2254             then do:
     2255               run diasize_change-height in this-procedure
     2256                 (input  integer(v-resize-value-str)
     2257                 ,input  true
     2258                 ) .
     2259               assign
     2260                 v-restore-saved = true
     2261               .
     2262             end.
     2263           end.
     2264           if connected("ub") = true
     2265           then do:
     2266             run gbl/wndsizer.p
     2267               (input  v-cntxt-db-num
     2268               ,input  v-cntxt-userid
     2269               ,input  v-diasize-proc-name
     2270               ,input  'width':u
     2271               ,output v-resize-value-str
     2272               ) .
     2273             if v-resize-value-str <> '':U
     2274             then do:
     2275               run diasize_change-width in this-procedure
     2276                 (input  integer(v-resize-value-str)
     2277                 ,input  true
     2278                 ) .
     2279               assign
     2280                 v-restore-saved = true
     2281               .
     2282             end.
     2283           end.
     2284           if v-restore-saved <> true
     2285           then do:
     2286             if v-diasize-wndmax = true
     2287             then do:
     2288               run diasize_maximize in this-procedure
     2289                 (input  true
     2290                 ) .
     2291             end.
     2292           end.
     2293         end.
     2294         else do:
     2295           if v-diasize-wndmax = true
     2296           then do:
     2297             run diasize_maximize in this-procedure
     2298               (input  true
     2299               ) .
     2300           end.
     2301         end.
     2302       end.
     2303     end.
     2304   end procedure.
     2305   procedure diasize_need-full-display :
     2306     define output parameter p-need-full-display as logical   no-undo .
     2307     do
     2308     on error undo, return error return-value
     2309     :
     2310       assign
     2311         p-need-full-display = v-diasize-need-full-display
     2312       .
     2313       assign
     2314         v-diasize-need-full-display = false
     2315       .
     2316     end.
     2317   end procedure.
     2318   procedure get-context :
     2319      define output parameter p-db-num as integer          no-undo.
     2320      define output parameter p-user-id as character        no-undo.
     2321      define variable v-login               as character    no-undo.
     2322      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2323      define buffer buf_user-login  for ub.user-login .
     2324      do
     2325      on error undo, return error
     2326      :
     2327            FIND FIRST buf_sys-ctrl no-lock.
     2328            ASSIGN
     2329               v-login = USERID("ub")
     2330               p-db-num = buf_sys-ctrl.db-num
     2331            .
     2332            FIND FIRST buf_user-login
     2333                 WHERE buf_user-login.db-num = p-db-num
     2334                   AND buf_user-login.user-login = v-login
     2335                 no-lock
     2336                 no-error
     2337                 .
     2338            IF AVAILABLE buf_user-login
     2339            THEN DO:
     2340               assign
     2341                  p-user-id = buf_user-login.user-id
     2342               .
     2343            END.
     2344      end.
     2345   end procedure.
     2346       run diasize_init in this-procedure .
     2347   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2348   DEF VAR cur-clmn-numbr-psn-org as INT EXTENT 16 no-undo.
     2349   DEF VAR varmvibr-psn-org       as INT no-undo.
     2350   DEF VAR varmvjbr-psn-org       as INT no-undo.
     2351   DEF VAR varmvkbr-psn-org       as INT no-undo.
     2352   DEF VAR varmvlbr-psn-org       as INT no-undo.
     2353   DEF VAR move-elementbr-psn-org as INT no-undo.
     2354   def var jjbr-psn-org           as int no-undo.
     2355   do varmvibr-psn-org = 1 to EXTENT(cur-clmn-numbr-psn-org):
     2356     ASSIGN cur-clmn-numbr-psn-org[varmvibr-psn-org] = varmvibr-psn-org.
     2357   END.
     2358   RUN start-mv-clmnbr-psn-org.
     2359   PROCEDURE start-mv-clmnbr-psn-org:
     2360   def var old-session as logical no-undo.
     2361      old-session = SESSION:IMMEDIATE-DISPLAY.
     2362      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2363      SESSION:IMMEDIATE-DISPLAY = old-session.
     2364   END.
     2365   ON ctrl-cursor-right OF BROWSE br-psn-org do:
     2366     RUN re-move-clmnbr-psn-org ( 1, 16).
     2367   END.
     2368   ON ctrl-cursor-left OF BROWSE br-psn-org do:
     2369     RUN re-move-clmnbr-psn-org (16, 1).
     2370   END.
     2371   PROCEDURE re-move-clmnbr-psn-org:
     2372     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2373     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2374     DO varmvibr-psn-org = 1 TO EXTENT(cur-clmn-numbr-psn-org):
     2375       if cur-clmn-numbr-psn-org[varmvibr-psn-org] = source-column THEN cur-clmn-numbr-psn-org[varmvibr-psn-org] = -1.
     2376     END.
     2377     if br-psn-org:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2378     if source-column > target-column THEN
     2379     DO varmvjbr-psn-org = source-column - 1 to target-column BY -1:
     2380       DO varmvibr-psn-org = 1 TO EXTENT(cur-clmn-numbr-psn-org):
     2381           if cur-clmn-numbr-psn-org[varmvibr-psn-org] = varmvjbr-psn-org THEN DO:
     2382             cur-clmn-numbr-psn-org[varmvibr-psn-org] = cur-clmn-numbr-psn-org[varmvibr-psn-org] + 1.
     2383           END.
     2384       END.
     2385     END.
     2386     ELSE
     2387     DO varmvjbr-psn-org = source-column + 1 to target-column:
     2388       DO varmvibr-psn-org = 1 TO EXTENT(cur-clmn-numbr-psn-org):
     2389         if cur-clmn-numbr-psn-org[varmvibr-psn-org] = varmvjbr-psn-org THEN DO:
     2390           cur-clmn-numbr-psn-org[varmvibr-psn-org] = cur-clmn-numbr-psn-org[varmvibr-psn-org] - 1.
     2391         END.
     2392       END.
     2393     END.
     2394     DO varmvibr-psn-org = 1 TO EXTENT(cur-clmn-numbr-psn-org):
     2395       if cur-clmn-numbr-psn-org[varmvibr-psn-org] = -1 THEN cur-clmn-numbr-psn-org[varmvibr-psn-org] = target-column.
     2396     END.
     2397   END PROCEDURE.
     2398   PROCEDURE ch-clmnbr-psn-org:
     2399     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2400     if cur-clmn-loc <= 1 then do:
     2401       return .
     2402     end.
     2403     DO varmvibr-psn-org = 1 TO EXTENT(cur-clmn-numbr-psn-org):
     2404       if cur-clmn-numbr-psn-org[varmvibr-psn-org] = cur-clmn-loc THEN move-elementbr-psn-org = varmvibr-psn-org.
     2405     END.
     2406     RUN re-move-clmnbr-psn-org (cur-clmn-loc, 1).
     2407   END PROCEDURE.
     2408   PROCEDURE mv-brw-defaultbr-psn-org:
     2409   def var old-session as logical no-undo.
     2410     old-session = SESSION:IMMEDIATE-DISPLAY.
     2411     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2412     do varmvlbr-psn-org = 1 to EXTENT(cur-clmn-numbr-psn-org):
     2413       RUN re-move-clmnbr-psn-org (cur-clmn-numbr-psn-org[varmvlbr-psn-org], varmvlbr-psn-org).
     2414     END.
     2415     RUN start-mv-clmnbr-psn-org.
     2416     SESSION:IMMEDIATE-DISPLAY = old-session.
     2417   END PROCEDURE.
     2418   .
     2419   def var sort-labelbr-psn-org   as character no-undo .
     2420   def var sort-clmnbr-psn-org    as handle    no-undo .
     2421   def var cur-clmnbr-psn-org     as handle    no-undo .
     2422   def var cur-clmn-locbr-psn-org as integer   no-undo .
     2423   def var re-querybr-psn-org     as logical   initial no no-undo .
     2424   on start-search, ctrl-o of br-psn-org in frame Dialog-Frame do:
     2425      run sort-brbr-psn-org
     2426        (input (if available X_firm
     2427                then recid(X_firm)
     2428                else ?
     2429               )
     2430        ).
     2431   end.
     2432   PROCEDURE sort-brbr-psn-org :
     2433     define input parameter p-recid as recid no-undo .
     2434     if re-querybr-psn-org = no then do:
     2435       assign
     2436          cur-clmnbr-psn-org = br-psn-org:current-column in frame Dialog-Frame
     2437       .
     2438       if sort-clmnbr-psn-org <> ? then sort-clmnbr-psn-org:column-fgcolor = 0.
     2439       if cur-clmnbr-psn-org = sort-clmnbr-psn-org then do:
     2440         assign
     2441            sort-labelbr-psn-org = ""
     2442            sort-clmnbr-psn-org = ?
     2443         .
     2444        end.
     2445        else do:
     2446          assign
     2447            sort-labelbr-psn-org = cur-clmnbr-psn-org:label
     2448            sort-clmnbr-psn-org  = cur-clmnbr-psn-org
     2449            sort-clmnbr-psn-org:column-fgcolor = 4
     2450          .
     2451        end.
     2452      end.
     2453     assign
     2454       cur-clmn-locbr-psn-org = 1
     2455     .
     2456     def var column-handle as handle no-undo .
     2457     column-handle = br-psn-org:first-column.
     2458     do while valid-handle(column-handle) :
     2459       if column-handle = cur-clmnbr-psn-org then do:
     2460         leave .
     2461       end.
     2462       column-handle = column-handle:NEXT-COLUMN.
     2463       assign
     2464         cur-clmn-locbr-psn-org = cur-clmn-locbr-psn-org + 1
     2465       .
     2466     end.
     2467     case sort-labelbr-psn-org:
     2468           when 'Код'  then DO:   assign     sort-column-name = "X_firm.firm-code"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2469           when 'Название фирмы'  then DO:   assign     sort-column-name = "get-firm-name( X_firm.firm-code )"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2470           when 'Страна, город'  then DO:   assign     sort-column-name = "X_firm.city"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2471           when 'Юридический Адрес'  then DO:   assign     sort-column-name = "TRIM( X_firm.addres1 ) + ' ':U + TRIM( X_firm.addres2 )"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2472           when 'Почтовый Адрес'  then DO:   assign     sort-column-name = "TRIM( X_firm.post-addr1 ) + ' ':U + TRIM( X_firm.post-addr2 )"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2473           when 'Индекс'  then DO:   assign     sort-column-name = "X_firm.ind"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2474           when 'ИНН'  then DO:   assign     sort-column-name = "X_firm.inn"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2475           when 'КПП'  then DO:   assign     sort-column-name = "X_firm.kpp"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2476           when 'ОКОНХ'  then DO:   assign     sort-column-name = "X_firm.okonh"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2477           when 'ОКПО'  then DO:   assign     sort-column-name = "X_firm.okpo"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2478           when 'Руководитель'  then DO:   assign     sort-column-name = "X_firm.director"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2479           when 'Главный бухгалтер'  then DO:   assign     sort-column-name = "X_firm.gen-acct"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2480           when 'Факс'  then DO:   assign     sort-column-name = "X_firm.fax"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2481           when 'Телефон'  then DO:   assign     sort-column-name = "X_firm.phone"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2482           when 'Примечание'  then DO:   assign     sort-column-name = "X_firm.phone1-note"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2483           when 'Лимит кредита'  then DO:   assign     sort-column-name = "get-limkr( X_firm.firm-code )"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
     2484       otherwise do:
     2485         assign
     2486           sort-column-name = ""
     2487         .
     2488         RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).
     2489           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-psn-org') then do:
     2490             run mv-brw-defaultbr-psn-org.
     2491           end.
     2492         if sort-labelbr-psn-org <> "" then do:
     2493           assign
     2494             cur-clmnbr-psn-org:column-fgcolor = 0
     2495           .
     2496         end.
     2497         assign
     2498           cur-clmn-locbr-psn-org = ?
     2499         .
     2500       end.
     2501     end case.
     2502     if p-recid <> ? then do:
     2503       reposition br-psn-org to recid p-recid no-error.
     2504       apply "value-changed" to br-psn-org in frame Dialog-Frame.
     2505     end.
     2506     apply "entry" to br-psn-org in frame Dialog-Frame.
     2507   END PROCEDURE.
     2508   procedure re-open-query-srt-clmnbr-psn-org:
     2509   if cur-clmnbr-psn-org = ? then do:
     2510      RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).
     2511   end.
     2512   else do:
     2513      assign re-querybr-psn-org = yes.
     2514      run sort-brbr-psn-org
     2515        (input (if available X_firm
     2516                then recid(X_firm)
     2517                else ?
     2518               )
     2519        ).
     2520      assign re-querybr-psn-org = no.
     2521   end.
     2522   end.
     2523   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2524   on F3 of frame Dialog-Frame anywhere do:
     2525     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     2526     return no-apply.
     2527   end.
     2528   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2529   on F1 of frame Dialog-Frame anywhere do:
     2530     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame Dialog-Frame. END.
     2531     return no-apply.
     2532   end.
     2533   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2534   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     2535     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     2536     return no-apply.
     2537   end.
     2538   MAIN-BLOCK:
     2539   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2540      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2541   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2542     run mainmenu_getcntxt in parparentproc
     2543       (output v-cntxt-db-num
     2544       ,output v-cntxt-userid
     2545       ,output v-cntxt-level
     2546       ,output v-cntxt-host-code-obj
     2547       ,output v-cntxt-obj-type
     2548       ,output v-cntxt-obj-code
     2549       ,output v-cntxt-db-num-obj
     2550       ,output v-cntxt-is-admin
     2551       ) .
     2552     FIND FIRST buf_clients NO-LOCK WHERE
     2553          buf_clients.obj-type = 'чел':U AND
     2554          buf_clients.obj-code = p-obj-code NO-ERROR.
     2555     IF NOT AVAILABLE buf_Clients THEN DO:
     2556       MESSAGE
     2557       "Неверное значение параметра p-obj-code" p-obj-code
     2558       VIEW-AS ALERT-BOX ERROR.
     2559       UNDO, RETURN ERROR.
     2560     END.
     2561     ASSIGN tobj-name = buf_clients.obj-name.
     2562     run waitfram-show in this-procedure ( "Ждите..." ).
     2563     FOR EACH buf_firm NO-LOCK WHERE buf_firm.tobj-code = p-obj-code :
     2564       FIND FIRST buf_clients NO-LOCK WHERE
     2565            buf_clients.obj-type = 'орг':U AND
     2566            buf_clients.obj-code = buf_firm.firm-code NO-ERROR.
     2567       IF NOT AVAILABLE buf_clients THEN DO:
     2568           NEXT.
     2569       END.
     2570       ASSIGN
     2571       get-limkrit-all = get-limkrit-all + buf_clients.lim-kr
     2572       get-limkrit-cnt = get-limkrit-cnt + 1
     2573       .
     2574     END.
     2575     IF get-limkrit-cnt = 0 THEN DO:
     2576       run waitfram-hide in this-procedure .
     2577       MESSAGE
     2578       substitute('Нет организаций по торговому представителю &1!'
     2579                  , tobj-name )
     2580        VIEW-AS ALERT-BOX ERROR.
     2581       UNDO Main-Block, LEAVE Main-Block.
     2582     END.
     2583     ASSIGN get-limkr-label = substitute("Количество фирм по торговому представителю: &1&2" +
     2584                                         "Общий лимит кредита &3"
     2585                                         ,get-limkrit-cnt
     2586                                         ,chr(10)
     2587                                         ,get-limkrit-all).
     2588      run waitfram-hide in this-procedure .
     2589     RUN Myenable.
     2590     WAIT-FOR GO OF FRAME Dialog-Frame.
     2591   END.
     2592   RUN disable_UI.
     2593   PROCEDURE disable_UI :
     2594     HIDE FRAME Dialog-Frame.
     2595   END PROCEDURE.
     2596   PROCEDURE enable_UI :
     2597     DISPLAY get-limkr-label
     2598         WITH FRAME Dialog-Frame.
     2599     ENABLE b-quit b-lkp b-hist b-print B-Help br-psn-org get-limkr-label
     2600         WITH FRAME Dialog-Frame.
     2601     VIEW FRAME Dialog-Frame.
     2602     OPEN QUERY br-psn-org FOR EACH X_firm NO-LOCK INDEXED-REPOSITION.
     2603   END PROCEDURE.
     2604   PROCEDURE MyEnable PRIVATE :
     2605   ASSIGN
     2606   br-psn-org:NUM-LOCKED-COLUMNS IN FRAME  Dialog-Frame  = 1
     2607   X_firm.city:READ-ONLY IN BROWSE br-psn-org = YES
     2608   FRAME Dialog-Frame :TITLE = substitute('Организации по торговому представителю &1', tobj-name)
     2609   .
     2610   DISPLAY
     2611   get-limkr-label
     2612   WITH FRAME Dialog-Frame.
     2613   ENABLE
     2614   b-quit
     2615   b-lkp
     2616   b-hist
     2617   b-print
     2618   B-Help
     2619   br-psn-org
     2620   get-limkr-label
     2621   WITH FRAME Dialog-Frame.
     2622   VIEW FRAME Dialog-Frame.
     2623   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).
     2624   REPOSITION br-psn-org TO ROW 1 NO-ERROR.
     2625   APPLY "ENTRY" TO br-psn-org.
     2626   END PROCEDURE.
     2627   PROCEDURE Openbr :
     2628   DEFINE INPUT PARAMETER p-open-query     AS LOGICAL   NO-UNDO.
     2629   DEFINE INPUT PARAMETER p-find-next      AS LOGICAL   NO-UNDO.
     2630   DEFINE INPUT PARAMETER p-find-condition AS CHARACTER NO-UNDO.
     2631   DEFINE VARIABLE l-query-was-opened AS LOGICAL   NO-UNDO.
     2632   DEFINE VARIABLE sort-column-phrase AS CHARACTER NO-UNDO.
     2633   DEFINE VARIABLE p-proc-hand        AS HANDLE    NO-UNDO.
     2634   RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Ждите..." ).
     2635   ASSIGN p-proc-hand = THIS-PROCEDURE :HANDLE.
     2636   CASE sort-column-name :
     2637     WHEN "":U THEN DO:
     2638        ASSIGN sort-column-phrase = "":U.
     2639     END.
     2640     OTHERWISE      DO:
     2641       ASSIGN
     2642       sort-column-phrase = "BY " + sort-column-name.
     2643     END.
     2644   END CASE.
     2645   DEFINE VARIABLE l-open-query AS LOGICAL NO-UNDO.
     2646   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2647   define variable  l-disable-where-17  as logical   no-undo .
     2648   define variable  l-filter-open-17    as logical   .
     2649   define variable  flt-rec-17       as recid     no-undo .
     2650   define variable  filter-name-17      as character no-undo .
     2651   define variable  where-phrase-17     as character no-undo .
     2652   define variable  sort-phrase-17      as character no-undo .
     2653   define variable  where-phrase-rus-17 as character no-undo .
     2654   define variable  sort-phrase-rus-17  as character no-undo .
     2655     run waitfram-show in this-procedure
     2656       (input "ЖДИТЕ ..."
     2657       ).
     2658   run gbl/flt-get.p
     2659     (input filter-point
     2660     ,output flt-rec-17
     2661     ,output filter-name-17
     2662     ,output where-phrase-17
     2663     ,output sort-phrase-17
     2664     ,output where-phrase-rus-17
     2665     ,output sort-phrase-rus-17
     2666     ).
     2667   if p-open-query then do:
     2668     assign
     2669       l-filter-open-17 = false
     2670     .
     2671     if flt-rec-17 <> ?
     2672       or sort-column-phrase > ""
     2673     then do:
     2674       define variable  parameter-2-17 as character no-undo .
     2675       define variable  parameter-3-17 as character no-undo .
     2676       define variable  parameter-4-17 as character no-undo .
     2677       define variable  parameter-5-17 as character no-undo .
     2678       define variable  parameter-6-17 as character no-undo .
     2679       define variable  parameter-7-17 as character no-undo .
     2680         assign
     2681         parameter-3-17 =
     2682                                 "FOR EACH X_firm"
     2683         parameter-4-17 =
     2684           (
     2685             if (" X_firm.tobj-code = p-obj-code " + " " + where-phrase-17) <> ""
     2686             then  substitute('X_firm.tobj-code = &1', p-obj-code ) + " " + where-phrase-17
     2687             else "true"
     2688           )
     2689         parameter-5-17 = (" " + "" + " " + "")
     2690         parameter-6-17 = if sort-phrase-17 = ''
     2691                              then
     2692           (
     2693           " " + "  " +
     2694             " " + sort-column-phrase +
     2695           " " + "  "
     2696           )
     2697                              else
     2698           (
     2699           " " + "  " +
     2700             " " + sort-column-phrase +
     2701           " " + sort-phrase-17
     2702           )
     2703         parameter-7-17 =
     2704           " INDEXED-REPOSITION  "
     2705       .
     2706       do
     2707       on stop undo, leave
     2708       on error undo, leave
     2709       :
     2710         assign
     2711           l-disable-where-17 =
     2712             (" X_firm.tobj-code = p-obj-code " + " " + where-phrase-17 = "")
     2713         .
     2714         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2715                             ,input QUERY br-psn-org:handle
     2716                             ,input parameter-3-17
     2717                             ,input parameter-4-17
     2718                             ,input parameter-5-17
     2719                             ,input parameter-6-17
     2720                             ,input parameter-7-17
     2721                             )
     2722         .
     2723         assign
     2724           l-filter-open-17 = true
     2725         .
     2726       end.
     2727       if l-filter-open-17 = false then do:
     2728         message
     2729           "Ошибка при фильтрации / сортировке" skip
     2730           "Будут показаны записи без учета фильтра" skip
     2731           view-as alert-box .
     2732       end.
     2733       else do:
     2734           assign
     2735             l-query-was-opened = true
     2736           .
     2737       end.
     2738     end.
     2739     if l-filter-open-17 = false then do:
     2740       OPEN QUERY br-psn-org FOR EACH X_firm
     2741         where  X_firm.tobj-code = p-obj-code
     2742         INDEXED-REPOSITION
     2743     .
     2744         assign
     2745           l-query-was-opened = true
     2746         .
     2747     end.
     2748   end.
     2749   else do:
     2750     assign
     2751       v-doc-rec = recid( X_firm )
     2752     .
     2753     do
     2754     on stop undo, leave
     2755     on error undo, leave
     2756     :
     2757       if QUERY br-psn-org:handle:get-buffer-handle(1) = (buffer X_firm:handle) then do:
     2758         assign
     2759         parameter-2-17 = (if p-find-next then "true":u else "false":u )
     2760         parameter-4-17 =
     2761           "where ":u +  substitute('X_firm.tobj-code = &1', p-obj-code ) + " ":u + where-phrase-17 + " ":u + p-find-condition + " " + ""
     2762         parameter-5-17 = "  "
     2763       .
     2764         run fltopend_fltfindd in this-procedure  (
     2765                             input this-procedure:handle
     2766                             ,input QUERY br-psn-org:handle
     2767                             ,input rowid(X_firm)
     2768                             ,input logical(parameter-2-17)
     2769                             ,input NO-LOCK
     2770                             ,input (buffer X_firm:handle)
     2771                             ,input parameter-4-17
     2772                             ,input parameter-5-17
     2773                             ) no-error.
     2774         .
     2775         assign
     2776           v-doc-rec = integer(return-value)
     2777           v-fltopend-rowid[1] = ?
     2778         .
     2779       end.
     2780       else do:
     2781         assign
     2782         parameter-2-17 = (if p-find-next then "true":u else "false":u )
     2783         parameter-3-17 =  "FOR EACH X_firm"
     2784         parameter-4-17 =
     2785           (
     2786             if (" X_firm.tobj-code = p-obj-code " + " " + where-phrase-17) <> ""
     2787             then  substitute('X_firm.tobj-code = &1', p-obj-code ) + " " + where-phrase-17
     2788             else "true"
     2789           )
     2790         parameter-5-17 = (" " + "" + " " + "" + " " + p-find-condition)
     2791         parameter-6-17 = if sort-phrase-17 = ''
     2792                              then
     2793           (
     2794           " " + "  " +
     2795             " " + sort-column-phrase +
     2796           " " + "  "
     2797           )
     2798                              else
     2799           (
     2800           " " + "  " +
     2801             " " + sort-column-phrase +
     2802           " " + sort-phrase-17
     2803           )
     2804         parameter-7-17 =
     2805           " INDEXED-REPOSITION  "
     2806       .
     2807         run fltopend_fltfindq in this-procedure  (
     2808                             input this-procedure:handle
     2809                             ,input QUERY br-psn-org:handle
     2810                             ,input logical(parameter-2-17)
     2811                             ,input NO-LOCK
     2812                             ,input parameter-3-17
     2813                             ,input parameter-4-17
     2814                             ,input parameter-5-17
     2815                             ,input parameter-6-17
     2816                             ,input parameter-7-17
     2817                             ,output v-fltopend-rowid
     2818                             ) no-error.
     2819         .
     2820         v-doc-rec = ?.
     2821       end.
     2822       assign
     2823         l-query-was-opened = true
     2824       .
     2825     end.
     2826   end.
     2827     run waitfram-hide in this-procedure .
     2828   IF NOT p-open-query THEN DO:
     2829      REPOSITION br-psn-org TO RECID v-doc-rec NO-ERROR.
     2830   END.
     2831   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2832   query br-psn-org:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     2833   RUN WaitFram-Hide IN THIS-PROCEDURE.
     2834   APPLY "VALUE-CHANGED":U TO br-psn-org IN FRAME Dialog-Frame.
     2835   APPLY "ENTRY":U         TO br-psn-org IN FRAME Dialog-Frame.
     2836   END PROCEDURE.
     2837   PROCEDURE proc-b-print :
     2838   DEFINE VARIABLE sym1 AS CHARACTER NO-UNDO INITIAL ":" COLUMN-LABEL ":!:" FORMAT "x(1)":U.
     2839   DEFINE VARIABLE sym2 AS CHARACTER NO-UNDO INITIAL ":" COLUMN-LABEL ":!:" FORMAT "x(1)":U.
     2840   DEFINE VARIABLE sym3 AS CHARACTER NO-UNDO INITIAL ":" COLUMN-LABEL ":!:" FORMAT "x(1)":U.
     2841   DEFINE VARIABLE sym4 AS CHARACTER NO-UNDO INITIAL ":" COLUMN-LABEL ":!:" FORMAT "x(1)":U.
     2842   DEFINE VARIABLE sym5 AS CHARACTER NO-UNDO INITIAL ":" COLUMN-LABEL ":!:" FORMAT "x(1)":U.
     2843   DEFINE VARIABLE sym6 AS CHARACTER NO-UNDO INITIAL ":" COLUMN-LABEL ":!:" FORMAT "x(1)":U.
     2844   DEFINE VARIABLE Line AS CHARACTER NO-UNDO.
     2845   DEFINE VARIABLE accum-count AS INTEGER NO-UNDO.
     2846   define variable date_string as character no-undo .
     2847   DEFINE BUFFER buf_clients FOR ub.clients.
     2848   DEFINE FRAME f-prn
     2849   sym1 X_firm.firm-code
     2850   sym2 buf_clients.obj-name
     2851   sym3 X_firm.addres1
     2852        X_firm.addres2
     2853   sym4 X_firm.city
     2854   sym5 buf_clients.lim-kr   sym6
     2855   HEADER  date_string AT 5 format "X(35)"
     2856   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     2857   Line format "X(198)" AT 1
     2858   with width 232 down stream-io use-text no-box   .
     2859   ASSIGN Line = FILL( "-", 135 ).
     2860   run waitfram-show in this-procedure ( input "Ждите...").
     2861   RUN prn-lib-open-stream IN THIS-PROCEDURE ( INPUT parparentproc
     2862                                                 ,INPUT 62
     2863                                                 ,INPUT YES
     2864                                                 ,INPUT NO    ).
     2865   PUT  STREAM PrnLibStream
     2866   SPACE(25) ( frame Dialog-Frame:title )
     2867   format "x(90)" SKIP(1) .
     2868   FORM HEADER
     2869   Line format "X(177)" AT 1 SKIP
     2870   "Продолжение - на следующей странице" AT 30 SKIP
     2871   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2872   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2873   FORM with FRAME f-prn  .
     2874   DO WHILE available X_firm :
     2875     GET prev br-psn-org no-lock.
     2876   end.
     2877   GET next br-psn-org  no-lock.
     2878   DO WHILE available X_firm :
     2879     accum-count = accum-count + 1.
     2880     FIND FIRST buf_clients NO-LOCK WHERE
     2881                 buf_clients.obj-type = 'орг':U
     2882           AND buf_clients.obj-code = X_firm.firm-code NO-ERROR.
     2883     DISPLAY STREAM
     2884     PrnLibStream
     2885     sym1 X_firm.firm-code
     2886     sym2 buf_clients.obj-name
     2887     sym3 X_firm.addres1
     2888     sym4 X_firm.city
     2889     sym5 buf_clients.lim-kr
     2890     sym6 X_firm.addres2
     2891     WITH FRAME f-prn.
     2892     DOWN
     2893     STREAM PrnLibStream
     2894     WITH FRAME f-prn.
     2895     GET next br-psn-org  no-lock.
     2896   END.
     2897   UNDERLINE
     2898   STREAM PrnLibStream
     2899   X_firm.firm-code
     2900   buf_clients.obj-name
     2901   buf_clients.lim-kr
     2902   WITH FRAME f-prn.
     2903   DOWN
     2904   STREAM PrnLibStream WITH FRAME f-prn.
     2905   DISPLAY
     2906   STREAM PrnLibStream
     2907   get-limkr-label @ ub.clients.obj-name
     2908   get-limkrit-all @ ub.clients.lim-kr
     2909   WITH FRAME f-prn.
     2910   DOWN      STREAM PrnLibStream WITH FRAME f-prn.
     2911   PUT    STREAM PrnLibStream Line FORMAT "x(232)":U SKIP.
     2912   OUTPUT STREAM PrnLibStream CLOSE.
     2913   run waitfram-hide in this-procedure .
     2914   RUN prn-lib-prn-file IN THIS-PROCEDURE ( INPUT parparentproc
     2915                                          , INPUT 0 ).
     2916   END PROCEDURE.
     2917   FUNCTION get-firm-name RETURNS CHARACTER
     2918     ( INPUT p-firm-code AS integer ) :
     2919   DEFINE BUFFER buf_clients FOR ub.clients.
     2920   FIND FIRST buf_clients NO-LOCK WHERE
     2921               buf_clients.obj-type = 'орг':U
     2922         AND buf_clients.obj-code = p-firm-code NO-ERROR.
     2923   IF AVAILABLE buf_clients THEN DO:
     2924     RETURN buf_clients.obj-name.
     2925   END.
     2926   RETURN substitute("!!!ОРГАНИЗАЦИЯ &1 НЕ НАЙДЕНА", p-firm-code).
     2927   END FUNCTION.
     2928   FUNCTION get-limkr RETURNS DECIMAL
     2929     ( INPUT p-firm-code AS integer ) :
     2930   DEFINE BUFFER buf_clients FOR ub.clients.
     2931   FIND FIRST buf_clients NO-LOCK WHERE
     2932          buf_clients.obj-type = 'орг':U AND
     2933          buf_clients.obj-code = p-firm-code NO-ERROR.
     2934   IF AVAILABLE buf_clients THEN RETURN buf_clients.lim-kr.
     2935   RETURN 0.00.
     2936   END FUNCTION.
