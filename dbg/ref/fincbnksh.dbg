     2877         assign
     2878           b-sch :tooltip = ""
     2879         .
     2880       end.
     2881     end.
     2882   end procedure.
     2883   def var sort-labelBR-bank   as character no-undo .
     2884   def var sort-clmnBR-bank    as handle    no-undo .
     2885   def var cur-clmnBR-bank     as handle    no-undo .
     2886   def var cur-clmn-locBR-bank as integer   no-undo .
     2887   def var re-queryBR-bank     as logical   initial no no-undo .
     2888   on start-search, ctrl-o of BR-bank in frame Dialog-Frame do:
     2889      run sort-brBR-bank
     2890        (input (if available X_c-fin-bank
     2891                then recid(X_c-fin-bank)
     2892                else ?
     2893               )
     2894        ).
     2895   end.
     2896   PROCEDURE sort-brBR-bank :
     2897     define input parameter p-recid as recid no-undo .
     2898     if re-queryBR-bank = no then do:
     2899       assign
     2900          cur-clmnBR-bank = BR-bank:current-column in frame Dialog-Frame
     2901       .
     2902       if sort-clmnBR-bank <> ? then sort-clmnBR-bank:column-fgcolor = 0.
     2903       if cur-clmnBR-bank = sort-clmnBR-bank then do:
     2904         assign
     2905            sort-labelBR-bank = ""
     2906            sort-clmnBR-bank = ?
     2907         .
     2908        end.
     2909        else do:
     2910          assign
     2911            sort-labelBR-bank = cur-clmnBR-bank:label
     2912            sort-clmnBR-bank  = cur-clmnBR-bank
     2913            sort-clmnBR-bank:column-fgcolor = 4
     2914          .
     2915        end.
     2916      end.
     2917     assign
     2918       cur-clmn-locBR-bank = 1
     2919     .
     2920     def var column-handle as handle no-undo .
     2921     column-handle = BR-bank:first-column.
     2922     do while valid-handle(column-handle) :
     2923       if column-handle = cur-clmnBR-bank then do:
     2924         leave .
     2925       end.
     2926       column-handle = column-handle:NEXT-COLUMN.
     2927       assign
     2928         cur-clmn-locBR-bank = cur-clmn-locBR-bank + 1
     2929       .
     2930     end.
     2931     case sort-labelBR-bank:
     2932           when X_c-fin-bank.bank-name:label in browse BR-bank then DO:    assign       sort-column-name = "X_c-fin-bank.bank-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2933           when X_c-fin-bank.bik:label in browse BR-bank then DO:    assign       sort-column-name = "X_c-fin-bank.bik"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2934           when X_c-fin-bank.corr-date:label in browse BR-bank then DO:    assign       sort-column-name = "X_c-fin-bank.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2935       otherwise do:
     2936         assign
     2937           sort-column-name = ""
     2938         .
     2939         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2940           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-bank') then do:
     2941             run mv-brw-defaultBR-bank.
     2942           end.
     2943         if sort-labelBR-bank <> "" then do:
     2944           assign
     2945             cur-clmnBR-bank:column-fgcolor = 0
     2946           .
     2947         end.
     2948         assign
     2949           cur-clmn-locBR-bank = ?
     2950         .
     2951       end.
     2952     end case.
     2953       if cur-clmn-locBR-bank <> ? then do:
     2954         if can-do( this-procedure:internal-entries, 'ch-clmnBR-bank') then do:
     2955           run ch-clmnBR-bank in this-procedure (cur-clmn-locBR-bank).
     2956         end.
     2957       end.
     2958     if p-recid <> ? then do:
     2959       reposition BR-bank to recid p-recid no-error.
     2960       apply "value-changed" to BR-bank in frame Dialog-Frame.
     2961     end.
     2962     apply "entry" to BR-bank in frame Dialog-Frame.
     2963   END PROCEDURE.
     2964   procedure re-open-query-srt-clmnBR-bank:
     2965   if cur-clmnBR-bank = ? then do:
     2966      run OpenBr in this-procedure ( input yes, input no, input '':U).
     2967   end.
     2968   else do:
     2969      assign re-queryBR-bank = yes.
     2970      run sort-brBR-bank
     2971        (input (if available X_c-fin-bank
     2972                then recid(X_c-fin-bank)
     2973                else ?
     2974               )
     2975        ).
     2976      assign re-queryBR-bank = no.
     2977   end.
     2978   end.
     2979   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2980   do:
     2981     BR-bank :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2982   end.
     2983   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2984   on INS of frame Dialog-Frame anywhere do:
     2985     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2986     return no-apply.
     2987   end.
     2988   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2989   on F2 of frame Dialog-Frame anywhere do:
     2990     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2991     return no-apply.
     2992   end.
     2993   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2994   on F2 of frame Dialog-Frame anywhere do:
     2995     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2996     return no-apply.
     2997   end.
     2998   MAIN-BLOCK:
     2999   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3000      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3001    if p-mode <> 'все':U
     3002    and p-mode <> 'фирма':U
     3003    and p-mode <> "one":U
     3004    then dO:
     3005       message
     3006       vss-workfile vss-revision vss-description skip
     3007       "Неверное значение параметров вызова p-mode"
     3008       p-mode
     3009       view-as alert-box ERROR.
     3010       return.
     3011    end.
     3012    if p-mode = "one":U then do:
     3013     find first X_fin-bank no-lock where
     3014                   X_fin-bank.host-code = p-host-code
     3015               and X_fin-bank.code-bank = p-code-bank no-error.
     3016       if not available X_fin-bank then do:
     3017           message
     3018           vss-workfile vss-revision vss-description skip
     3019           "Неверное значение параметра вызова p-host-code и/или p-code-bank "
     3020           p-host-code p-code-bank
     3021           view-as alert-box ERROR.
     3022           return.
     3023       end.
     3024     end.
     3025     v-rid-list = p-rid-list.
     3026     if v-rid-list <> "" then do:
     3027         FIND FIRST find_c-fin-bank No-LOCK where
     3028                    recid(find_c-fin-bank) = integer(entry(1, v-rid-list)) No-ERROR.
     3029         if not avail find_c-fin-bank then do:
     3030           message
     3031           vss-workfile vss-revision vss-description skip
     3032           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3033           view-as alert-box error .
     3034           return error.
     3035         end.
     3036         v-doc-rec = integer(entry(1, v-rid-list)).
     3037       end.
     3038   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3039   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3040     (output v-db-num
     3041     )  .
     3042     RUN MyEnable in this-procedure .
     3043     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     3044     HIDE mark-num in frame Dialog-Frame .
     3045     if v-rid-list <> "":U then
     3046     REPOSITION br-bank to recid integer(entry(1, v-rid-list)) No-ERROR.
     3047   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3048   DEF VAR cur-clmn-numbr-bank as INT EXTENT 9 no-undo.
     3049   DEF VAR varmvibr-bank       as INT no-undo.
     3050   DEF VAR varmvjbr-bank       as INT no-undo.
     3051   DEF VAR varmvkbr-bank       as INT no-undo.
     3052   DEF VAR varmvlbr-bank       as INT no-undo.
     3053   DEF VAR move-elementbr-bank as INT no-undo.
     3054   def var jjbr-bank           as int no-undo.
     3055   do varmvibr-bank = 1 to EXTENT(cur-clmn-numbr-bank):
     3056     ASSIGN cur-clmn-numbr-bank[varmvibr-bank] = varmvibr-bank.
     3057   END.
     3058   RUN start-mv-clmnbr-bank.
     3059   PROCEDURE start-mv-clmnbr-bank:
     3060   def var old-session as logical no-undo.
     3061      old-session = SESSION:IMMEDIATE-DISPLAY.
     3062      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3063          IF  p-mode = 'все':U  THEN DO:
     3064      DO jjbr-bank = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     3065        RUN re-move-clmnbr-bank ( cur-clmn-numbr-bank[INTEGER(ENTRY (jjbr-bank, '1,2,3,4,5,6,7,8,9'))] , 1).
     3066      END.
     3067          END.
     3068          IF  p-mode = 'фирма':U  THEN DO:
     3069      DO jjbr-bank = NUM-ENTRIES('1,3,4,5,6,7,8,9,2') TO 1 BY -1:
     3070        RUN re-move-clmnbr-bank ( cur-clmn-numbr-bank[INTEGER(ENTRY (jjbr-bank, '1,3,4,5,6,7,8,9,2'))] , 1).
     3071      END.
     3072          END.
     3073          IF  p-mode = 'one':U  THEN DO:
     3074      DO jjbr-bank = NUM-ENTRIES('1,4,5,6,7,8,9,2,3') TO 1 BY -1:
     3075        RUN re-move-clmnbr-bank ( cur-clmn-numbr-bank[INTEGER(ENTRY (jjbr-bank, '1,4,5,6,7,8,9,2,3'))] , 1).
     3076      END.
     3077          END.
     3078      SESSION:IMMEDIATE-DISPLAY = old-session.
     3079   END.
     3080   ON ctrl-cursor-right OF BROWSE br-bank do:
     3081     RUN re-move-clmnbr-bank ( 1, 9).
     3082   END.
     3083   ON ctrl-cursor-left OF BROWSE br-bank do:
     3084     RUN re-move-clmnbr-bank (9, 1).
     3085   END.
     3086   PROCEDURE re-move-clmnbr-bank:
     3087     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3088     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3089     DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3090       if cur-clmn-numbr-bank[varmvibr-bank] = source-column THEN cur-clmn-numbr-bank[varmvibr-bank] = -1.
     3091     END.
     3092     if br-bank:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3093     if source-column > target-column THEN
     3094     DO varmvjbr-bank = source-column - 1 to target-column BY -1:
     3095       DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3096           if cur-clmn-numbr-bank[varmvibr-bank] = varmvjbr-bank THEN DO:
     3097             cur-clmn-numbr-bank[varmvibr-bank] = cur-clmn-numbr-bank[varmvibr-bank] + 1.
     3098           END.
     3099       END.
     3100     END.
     3101     ELSE
     3102     DO varmvjbr-bank = source-column + 1 to target-column:
     3103       DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3104         if cur-clmn-numbr-bank[varmvibr-bank] = varmvjbr-bank THEN DO:
     3105           cur-clmn-numbr-bank[varmvibr-bank] = cur-clmn-numbr-bank[varmvibr-bank] - 1.
     3106         END.
     3107       END.
     3108     END.
     3109     DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3110       if cur-clmn-numbr-bank[varmvibr-bank] = -1 THEN cur-clmn-numbr-bank[varmvibr-bank] = target-column.
     3111     END.
     3112   END PROCEDURE.
     3113   PROCEDURE ch-clmnbr-bank:
     3114     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3115     if cur-clmn-loc <= 1 then do:
     3116       return .
     3117     end.
     3118     DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3119       if cur-clmn-numbr-bank[varmvibr-bank] = cur-clmn-loc THEN move-elementbr-bank = varmvibr-bank.
     3120     END.
     3121     RUN re-move-clmnbr-bank (cur-clmn-loc, 1).
     3122   END PROCEDURE.
     3123   PROCEDURE mv-brw-defaultbr-bank:
     3124   def var old-session as logical no-undo.
     3125     old-session = SESSION:IMMEDIATE-DISPLAY.
     3126     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3127     do varmvlbr-bank = 1 to EXTENT(cur-clmn-numbr-bank):
     3128       RUN re-move-clmnbr-bank (cur-clmn-numbr-bank[varmvlbr-bank], varmvlbr-bank).
     3129     END.
     3130     RUN start-mv-clmnbr-bank.
     3131     SESSION:IMMEDIATE-DISPLAY = old-session.
     3132   END PROCEDURE.
     3133   .
     3134     run diasize_add_browse in this-procedure
     3135       (input  'width':u
     3136       ,input  browse br-changes :handle
     3137       ) .
     3138     run diasize_init in this-procedure .
     3139     WAIT-FOR GO OF FRAME Dialog-Frame.
     3140   END.
     3141   RUN disable_UI.
     3142   PROCEDURE disable_UI :
     3143     HIDE FRAME Dialog-Frame.
     3144   END PROCEDURE.
     3145   PROCEDURE enable_UI :
