     3689       end.
     3690   end.
     3691   else do:
     3692       if b-lkp:sensitive then
     3693       apply "choose" to b-lkp in frame Dialog-Frame.
     3694   end.
     3695   END PROCEDURE.
     3696   PROCEDURE proc-find-bik :
     3697   define input parameter p-next as logical no-undo.
     3698   define input parameter p-bik like ub.fin-bank.bik no-undo.
     3699   display
     3700   "0":U @ sch-code
     3701   with frame Dialog-Frame.
     3702   assign
     3703   p-bik = replace(p-bik, chr(34), "":U)
     3704   p-bik = replace(p-bik, chr(39), chr(39) + chr(39))
     3705   p-bik = chr(34) + p-bik + chr(34).
     3706   run OpenBr in this-procedure
     3707       (input false
     3708       ,input p-next
     3709       ,input substitute("and X_c-fin-bank.bik   begins &1 "
     3710         , p-bik)
     3711       ).
     3712   apply "entry":u to sch-bik in frame Dialog-Frame .
     3713   END PROCEDURE.
