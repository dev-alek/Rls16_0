      611   procedure fltfield-clear :
      612     define output parameter loc-fld as character no-undo.
      613     define output parameter loc-lab as character no-undo .
      614     define output parameter loc-spr as character no-undo .
      615     define output parameter loc-dim as character no-undo .
      616     assign
      617       loc-fld = ""
      618       loc-lab = ""
      619       loc-spr = ""
      620       loc-dim = "0"
      621     .
      622   end procedure .
      623   procedure fltfield-add :
      624     define input        parameter par-fld as character no-undo.
      625     define input        parameter par-lab as character no-undo .
      626     define input        parameter par-spr as character no-undo .
      627     define input-output parameter loc-fld as character no-undo.
      628     define input-output parameter loc-lab as character no-undo .
      629     define input-output parameter loc-spr as character no-undo .
      630     define input-output parameter loc-dim as character no-undo .
      631     do
      632     on error undo, return error
      633     :
      634       assign
      635       loc-fld = if loc-dim = '0'
      636                 then par-fld
      637                 else (loc-fld + chr(44) + par-fld)
      638       loc-lab = if loc-dim = '0'
      639                 then par-lab
      640                 else (loc-lab + chr(44) + par-lab)
      641       loc-spr = if loc-dim = '0'
      642                 then par-spr
      643                 else (loc-spr + chr(44) + par-spr)
      644       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      645                 string(integer(if num-entries(loc-dim) > 1
      646                               then entry(2, loc-dim)
      647                               else entry(1, loc-dim)
      648                               ) + 1)
      649       no-error
      650       .
      651     end.
      652   end procedure.
