     3156     X_c-fin-bank.corr-date:read-only in browse br-bank = yes
     3157     temp-changes.l_name:resizable in browse br-changes = true
     3158     temp-changes.v_old:resizable in browse br-changes = true
     3159     temp-changes.v_new:resizable in browse br-changes = true
