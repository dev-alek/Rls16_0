     1096     define variable v-old-value       as character no-undo case-sensitive.
     1097     define variable v-new-value       as character no-undo case-sensitive.
     1098     define variable v-chg-fields as character no-undo.
     1099     for each temp-changes:
     1100       delete temp-changes.
     1101     end.
     1102     if not p-hst-handle:available then do:
     1103       return .
     1104     end.
     1105     create buffer h-new-buf  for table p-hst-handle .
     1106     create buffer h-main-buf for table p-main-table .
     1107     assign
     1108       v-inform = h-main-buf:index-information(1)
     1109       v-ind    = 2
     1110     .
     1111     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1112     on error undo, return error
     1113     :
     1114       assign
     1115         v-inform = h-main-buf:index-information( v-ind )
     1116         v-ind    = v-ind + 1
     1117       .
     1118     end.
     1119     if v-inform = ?
     1120       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1121       or entry( 3, v-inform, ",":U ) <> "1":U
     1122     then do:
     1123       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1124     end.
     1125     assign
     1126       v-idx-field-qnty = num-entries( v-inform ) - 4
     1127     .
     1128     if v-idx-field-qnty < 2 then do:
     1129       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1130     end.
     1131     assign
     1132       v-srch-main   = "where":U
     1133       v-word-link   = "":U
     1134       v-av-chip-num = false
     1135       v-delim-list  = "":U
     1136     .
     1137     do v-ind = 1 to v-idx-field-qnty by 2
     1138     on error undo, return error
     1139     :
     1140       assign
     1141         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1142         fh                = p-hst-handle:buffer-field( v-field-name )
     1143         fh-main           = h-main-buf:buffer-field( v-field-name )
     1144         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1145         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1146       .
     1147       if fh:data-type ="character":U then do:
     1148         assign
     1149           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1150         .
     1151       end.
     1152       else do:
     1153         assign
     1154           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1155         .
     1156       end.
     1157       if v-delim-list = "":U then do:
     1158         assign
     1159           v-delim-list = ",":U
     1160         .
     1161       end.
     1162       if v-word-link = "":U then do:
     1163         assign
     1164           v-word-link = "and":U
     1165         .
     1166       end.
     1167     end.
     1168     assign
     1169       v-delim-list  = "":U
     1170     .
     1171     do v-ind = 1 to h-main-buf:num-fields
     1172     on error undo, return error
     1173     :
     1174       assign
     1175         fh-main      = h-main-buf:buffer-field( v-ind )
     1176         v-field-name = fh-main:name
     1177       .
     1178         assign
     1179           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1180         .
     1181         if v-delim-list = "":U then do:
     1182           assign
     1183             v-delim-list = ",":U
     1184           .
     1185         end.
     1186     end.
     1187     assign
     1188       v-inform = p-hst-handle:index-information(1)
     1189       v-ind    = 2
     1190     .
     1191     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1192     on error undo, return error
     1193     :
     1194       assign
     1195         v-inform = p-hst-handle:index-information( v-ind )
     1196         v-ind    = v-ind + 1
     1197       .
     1198     end.
     1199     if v-inform = ?
     1200       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1201       or entry( 3, v-inform, ",":U ) <> "1":U
     1202     then do:
     1203       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1204     end.
     1205     assign
     1206       v-idx-field-qnty = num-entries( v-inform ) - 4
     1207     .
     1208     if v-idx-field-qnty < 2 then do:
     1209       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1210     end.
     1211     assign
     1212       v-search-exp  = "where":U
     1213       v-word-link   = "":U
     1214       v-av-chip-num = false
     1215     .
     1216     do v-ind = 1 to v-idx-field-qnty by 2
     1217     on error undo, return error
     1218     :
     1219       assign
     1220         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1221         fh           = p-hst-handle:buffer-field( v-field-name )
     1222         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1223       .
     1224       if v-field-name = "chip-num":U then do:
     1225         assign
     1226           v-search-exp  = substitute( "&1 >", v-search-exp )
     1227           v-av-chip-num = true
     1228         .
     1229       end.
     1230       else do:
     1231         assign
     1232           v-search-exp = substitute( "&1 =", v-search-exp )
     1233         .
     1234       end.
     1235       if fh:data-type ="character":U then do:
     1236         assign
     1237           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1238         .
     1239       end.
     1240       else do:
     1241         assign
     1242           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1243         .
     1244       end.
     1245       if v-word-link = "":U then do:
     1246         assign
     1247           v-word-link = "and":U
     1248         .
     1249       end.
     1250     end.
     1251     if v-av-chip-num = false then do:
     1252       message
     1253         vss-workfile vss-revision vss-description skip
     1254         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1255         "Использование данной процедуры невозможно!" skip
     1256         view-as alert-box error .
     1257       return error .
     1258     end.
     1259     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1260     if not h-new-buf:available then do:
     1261       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1262       if not h-main-buf:available then do:
     1263         assign
     1264           h-for-comp = ?
     1265         .
     1266       end.
     1267       else do:
     1268         assign
     1269           h-for-comp = h-main-buf
     1270         .
     1271       end.
     1272     end.
     1273     else do:
     1274       assign
     1275         h-for-comp = h-new-buf
     1276       .
     1277     end.
     1278     assign
     1279       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1280     .
     1281     do v-ind = 1 to v-num-entries
     1282     on error undo, return error return-value
     1283     :
     1284       assign
     1285         v-field-name = entry( v-ind, v-main-fld-lst )
     1286         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1287         v-old-value  = fh-old:buffer-value()
     1288         v-label      = trim( fh-old:label )
     1289       .
     1290       if ( trim( p-field-list ) <> "":U
     1291            and lookup( v-field-name, p-field-list ) > 0
     1292          )
     1293          or trim( p-field-list ) = "":U
     1294       then do:
     1295         if h-for-comp <> ? then do:
     1296           assign
     1297             fh-new      = h-for-comp:buffer-field( v-field-name )
     1298             v-new-value = fh-new:buffer-value()
     1299           .
     1300         end.
     1301         else do:
     1302           assign
     1303             v-new-value = "":U
     1304           .
     1305         end.
     1306         if v-old-value <> v-new-value
     1307         then do:
     1308           create temp-changes.
     1309           assign
     1310             temp-changes.t_name = p-main-table
     1311             temp-changes.f_name = v-field-name
     1312             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1313             temp-changes.v_old  = trim( v-old-value )
     1314             temp-changes.v_new  = trim( v-new-value )
     1315             temp-changes.num_   = 0
     1316             temp-changes.fNotChange = v-old-value eq v-new-value
     1317           .
     1318         end.
     1319       end.
     1320     end.
     1321     assign
     1322       v-num-entries = num-entries( p-label-form, chr(8) )
     1323     .
     1324     do v-ind = 1 to v-num-entries
     1325     on error undo, return error return-value
     1326     :
     1327       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1328         assign
     1329           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1330           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1331           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1332         .
     1333         find first temp-changes
     1334           where temp-changes.f_name = v-field-name
     1335           no-error .
     1336         if available temp-changes then do:
     1337           if trim( v-field-lvl ) <> "":U then do:
     1338             assign
     1339               temp-changes.l_name = v-field-lvl
     1340             .
     1341           end.
     1342           if trim( v-field-form ) <> "":U then do:
     1343             assign
     1344               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1345             .
     1346             if h-for-comp <> ? then do:
     1347               assign
     1348                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1349               .
     1350             end.
     1351           end.
     1352         end.
     1353       end.
     1354       else do:
     1355         message
     1356           vss-workfile vss-revision vss-description skip
     1357           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1358           substitute( "список для поля '&1': '&2'"
     1359                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1360                       ,entry( v-ind, p-label-form, chr(8) )
     1361                     ) skip
     1362           substitute( "полный список: &2", p-label-form ) skip
     1363           view-as alert-box error .
     1364       end.
     1365     end.
     1366     delete object h-new-buf .
     1367     delete object h-main-buf .
     1368   END PROCEDURE.
     1369   DEFINE BUTTON B-Help
     1370        LABEL "Помо&щь"
     1371        SIZE 3 BY 1
     1372        BGCOLOR 8 .
     1373   DEFINE BUTTON b-lkp
     1374        LABEL "&Просмотр"
     1375        SIZE 10 BY 1.
     1376   DEFINE BUTTON B-mark
     1377        LABEL "&*"
     1378        SIZE 3 BY 1.
     1379   DEFINE BUTTON b-quit AUTO-END-KEY
     1380        LABEL "&Выход"
     1381        SIZE 10 BY 1
     1382        BGCOLOR 8 .
     1383   DEFINE BUTTON B-sch
     1384        LABEL "&Фильтр"
     1385        SIZE 3 BY 1.
     1386   DEFINE BUTTON b-sel AUTO-GO
     1387        LABEL "Вы&бор"
     1388        SIZE 10 BY 1
     1389        BGCOLOR 8 .
     1390   DEFINE VARIABLE ED-notes AS CHARACTER
     1391        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1392        SIZE 98 BY 2
     1393        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1394   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1395         VIEW-AS TEXT
     1396        SIZE 6 BY 1
     1397        FGCOLOR 4  NO-UNDO.
     1398   DEFINE VARIABLE sch-BIK AS CHARACTER FORMAT "X(9)":U
     1399        LABEL "БИК"
     1400        VIEW-AS FILL-IN
     1401        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1402   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1403        LABEL "коду"
     1404        VIEW-AS FILL-IN
     1405        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1406   DEFINE VARIABLE sch-name AS CHARACTER FORMAT "X(35)":U
     1407        LABEL "нач.назв."
     1408        VIEW-AS FILL-IN
     1409        SIZE 41.88 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1410   DEFINE QUERY BR-bank FOR
     1411         X_c-fin-bank SCROLLING.
     1412   DEFINE QUERY BR-changes FOR
     1413         temp-changes SCROLLING.
     1414   DEFINE BROWSE BR-bank
     1415     QUERY BR-bank DISPLAY
     1416         mark-string(recid(X_c-fin-bank), v-rid-list) FORMAT "X(1)":U
     1417         X_c-fin-bank.host-code COLUMN-LABEL "Фирма" FORMAT "999999999":U
     1418         X_c-fin-bank.code-bank COLUMN-LABEL "Код!банка" FORMAT "9999999":U
     1419         X_c-fin-bank.bank-name FORMAT "X(40)":U
     1420         X_c-fin-bank.bik FORMAT "X(9)":U
     1421         X_c-fin-bank.status_ FORMAT "X(8)":U
     1422         usrfulnf(X_c-fin-bank.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1423         X_c-fin-bank.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1424         string(X_c-fin-bank.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1425     ENABLE
     1426         X_c-fin-bank.corr-date
     1427       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10.04.
     1428   DEFINE BROWSE BR-changes
     1429     QUERY BR-changes DISPLAY
     1430         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1431   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1432   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1433       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1434   DEFINE FRAME Dialog-Frame
     1435        b-quit AT ROW 1 COL 1
     1436        B-mark AT ROW 1 COL 11
     1437        b-sel AT ROW 1 COL 21
     1438        b-lkp AT ROW 1 COL 41
     1439        B-sch AT ROW 1 COL 92
     1440        B-Help AT ROW 1 COL 95
     1441        BR-bank AT ROW 2.21 COL 1
     1442        ED-notes AT ROW 12.42 COL 1.13 NO-LABEL
     1443        sch-code AT ROW 14.5 COL 33.63 COLON-ALIGNED
     1444        sch-BIK AT ROW 14.54 COL 14.5 COLON-ALIGNED
     1445        sch-name AT ROW 14.54 COL 53.5 COLON-ALIGNED
     1446        BR-changes AT ROW 16.04 COL 1
     1447        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1448        "ПОИСК ПО" VIEW-AS TEXT
     1449             SIZE 9.25 BY 1 AT ROW 14.58 COL 1.5
     1450             FGCOLOR 4
     1451        SPACE(88.49) SKIP(6.46)
     1452       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1453            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1454            TITLE "Список истории банков"
     1455            CANCEL-BUTTON b-quit.
     1456   ASSIGN
     1457          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1458          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1459   ASSIGN
     1460          BR-bank:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1461   ASSIGN
     1462          ED-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1463   ON GO OF FRAME Dialog-Frame
     1464   DO:
     1465     p-rid-list = v-rid-list.
     1466   END.
     1467   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1468   DO:
     1469   define variable loc#log as logical no-undo .
     1470     if available X_c-fin-bank then do:
     1471   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1472   define variable v-str-recid14 as character no-undo .
     1473   define variable v-num-entry14 as integer   no-undo .
     1474   assign
     1475     v-str-recid14 = trim( string( recid( X_c-fin-bank ) , "->>>>>>>>>>>9":U ) )
     1476     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1477   .
     1478   if v-num-entry14 > 0 then do:
     1479     assign
     1480       entry( v-num-entry14, v-rid-list ) = "":U
     1481       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1482     .
     1483   end.
     1484   else do:
     1485     assign
     1486       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1487     .
     1488   end.
     1489       loc#log = br-bank:refresh() .
     1490       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1491           loc#log = br-bank:select-next-row ().
     1492           apply "VALUE-CHANGED" to br-bank in frame Dialog-Frame.
     1493       end.
     1494       if num-entries( v-rid-list ) = 0
     1495       then
     1496           hide mark-num in frame Dialog-Frame.
     1497       else
     1498           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1499     end.
     1500     apply "entry" to br-bank in frame Dialog-Frame.
     1501   END.
     1502   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1503   DO:
     1504         run gbl/markqwa.p (
     1505                    input b-mark:sensitive
     1506                  , input v-rid-list) no-error.
     1507     if error-status:error then return no-apply.
     1508   END.
     1509   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1510   DO:
     1511     run proc-b-sch in this-procedure no-error.
     1512     if error-status:error then return no-apply.
     1513   END.
     1514   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1515   DO:
     1516     if ( available X_c-fin-bank ) then do:
     1517       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1518       then
     1519       v-rid-list = string( recid( X_c-fin-bank ) ) .
     1520     end.
     1521   END.
     1522   ON RETURN OF BR-bank IN FRAME Dialog-Frame
     1523   or MOUSE-SELECT-DBLCLICK OF Br-bank IN FRAME Dialog-Frame
     1524   DO:
     1525     run proc-br-bank no-error.
     1526     if error-status:error then return no-apply.
     1527   END.
     1528   ON VALUE-CHANGED OF BR-bank IN FRAME Dialog-Frame
     1529   DO:
     1530      DEFINE VARIABLE dops as character no-undo .
     1531     dops = if available X_c-fin-bank then X_c-fin-bank.ps else '':U.
     1532     ED-notes:screen-value = dops.
     1533     run proc-view-changes in this-procedure no-error.
     1534   END.
     1535   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1536   DO:
     1537     define buffer ps_fin-bank for ub.fin-bank.
     1538     if not available X_c-fin-bank then return no-apply.
     1539      DO on stop undo, return no-apply:
     1540         FIND PS_fin-bank where
     1541              recid (ps_fin-bank) = recid(X_c-fin-bank) exclusive.
     1542         if ps_fin-bank.PS <> input frame Dialog-Frame ed-notes then
     1543         assign
     1544         ps_fin-bank.PS = input frame Dialog-Frame ed-notes
     1545         .
     1546      END.
     1547   END.
     1548   ON CTRL-J OF sch-BIK IN FRAME Dialog-Frame
     1549   DO:
     1550     run proc-find-bik in this-procedure ( input yes, input frame Dialog-Frame sch-bik) no-error.
     1551     if error-status:error then return no-apply.
     1552   END.
     1553   ON RETURN OF sch-BIK IN FRAME Dialog-Frame
     1554   DO:
     1555     run proc-find-bik in this-procedure ( input no, input frame Dialog-Frame sch-bik) no-error.
     1556     if error-status:error then return no-apply.
     1557   END.
     1558   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1559   DO:
     1560     run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1561     if error-status:error then return no-apply.
     1562   END.
     1563   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1564   DO:
     1565     run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1566     if error-status:error then return no-apply.
     1567   END.
     1568   ON CTRL-J OF sch-name IN FRAME Dialog-Frame
     1569   DO:
     1570     run proc-find-name in this-procedure ( input yes, input frame Dialog-Frame sch-name) no-error.
     1571     if error-status:error then return no-apply.
     1572   END.
     1573   ON RETURN OF sch-name IN FRAME Dialog-Frame
     1574   DO:
     1575     run proc-find-name in this-procedure ( input no, input frame Dialog-Frame sch-name) no-error.
     1576     if error-status:error then return no-apply.
     1577   END.
     1578   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1579   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1580   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1581   on help of frame Dialog-Frame
     1582   do:
     1583     run gbl/app_help.p
     1584       (input this-procedure :file-name
     1585       ,input ''
     1586       ,input ?
     1587       ) no-error.
     1588     if error-status :error then do:
     1589       message
     1590         "Ошибка при вызове помощи"
     1591         error-status :get-message(1)
     1592         view-as alert-box .
     1593     end.
     1594   end.
     1595   run minbtn-set in this-procedure .
     1596   on choose of b-help in frame Dialog-Frame
     1597   do:
     1598     apply "help":u to frame Dialog-Frame .
     1599   end.
     1600   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1601   procedure minbtn-set :
     1602       do
     1603           on error undo, return error return-value
     1604           :
     1605           define variable ii              as integer       no-undo .
     1606           define variable fh              as widget-handle no-undo .
     1607           define variable hh              as widget-handle no-undo .
     1608           define variable v-h             as handle        extent 4 no-undo .
     1609           define variable v-name-button   as character     no-undo .
     1610           define variable v-help-old-x    as decimal       no-undo .
     1611           define variable v-help-old-y    as decimal       no-undo .
     1612           define variable v-help-old-size as decimal       no-undo .
     1613           define variable v-frame-width   as decimal       no-undo .
     1614           define variable jj              as integer       no-undo .
     1615           do
     1616               on error undo, return error
     1617               :
     1618               assign
     1619                   v-frame-width = frame Dialog-Frame:width - 0.3
     1620                   fh            = frame Dialog-Frame:first-child
     1621                   hh            = fh:first-child
     1622                   ii            = 1
     1623                   .
     1624               do while valid-handle(hh):
     1625                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1626                   do:
     1627                       case lc(hh:name) :
     1628                           when "b-help" then
     1629                               do:
     1630                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1631                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1632                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1633                                   hh:TOOLTIP = "Помощь" .
     1634                                   v-help-old-x = hh:column .
     1635                                   v-help-old-y = hh:row    .
     1636                                   v-help-old-size = hh:width .
     1637                                   hh:width-chars = 2.5 .
     1638                               end.
     1639                           when "b-print" then
     1640                               do:
     1641                                   hh:load-image("cmp/b-print.bmp":u) .
     1642                                   hh:TOOLTIP = "Печать" .
     1643                                   v-h[ii] = hh:handle .
     1644                                   ii = ii + 1 .
     1645                                   hh:width-chars = 3 .
     1646                               end.
     1647                           when "b-history" or
     1648                           when "b-hist" then
     1649                               do:
     1650                                   hh:load-image("cmp/b-hist.bmp":u) .
     1651                                   hh:TOOLTIP = "История" .
     1652                                   v-h[ii] = hh:handle .
     1653                                   ii = ii + 1 .
     1654                                   hh:width-chars = 3 .
     1655                               end.
     1656                           when "b-sch" then
     1657                               do:
     1658                                   hh:load-image("cmp/b-sch.bmp":u) .
     1659                                   hh:TOOLTIP = "Установка Фильтра" .
     1660                                   v-h[ii] = hh:handle .
     1661                                   ii = ii + 1 .
     1662                                   hh:width-chars = 3 .
     1663                               end.
     1664                           when "b-hist-user" then
     1665                               do:
     1666                                   hh:load-image("cmp/b-hist.bmp":u) .
     1667                                   hh:TOOLTIP = "История пользователя" .
     1668                                   ii = ii + 1 .
     1669                               end.
     1670                       end case.
     1671                   end.
     1672                   hh = hh:next-sibling.
     1673               end.
     1674               b-help:column = v-frame-width - b-help:width-chars.
     1675               jj = 0.
     1676               repeat ii = 4 to 1 by -1 :
     1677                   if valid-handle (v-h[ii] ) then
     1678                   do:
     1679                       jj  = jj + 1 .
     1680                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1681                       v-h[ii]:row    = v-help-old-y .
     1682                   end.
     1683               end.
     1684           end.
     1685       end.
     1686   end procedure.
     1687   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1688   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1689   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1690   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1691   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1692   define variable v-diasize-current-frame-height as decimal   no-undo .
     1693   define variable v-diasize-change-size          as logical   no-undo .
     1694   define variable v-diasize-resize-button        as handle    no-undo .
     1695   define variable v-diasize-wndmax               as logical   no-undo .
     1696   define variable v-diasize-wndstore             as logical   no-undo .
     1697   define variable v-diasize-proc-name            as character no-undo .
     1698   define variable v-diasize-browse-handle        as handle    no-undo .
     1699   define variable v-diasize-browse-number        as integer   no-undo .
     1700   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1701   define temp-table temp-diasize-handle no-undo
     1702     field handle-value  as handle
     1703     field save-position as decimal
     1704     index xpk is primary unique handle-value
     1705     .
     1706   define temp-table temp-browse-handle no-undo
     1707     field browse-type   as character
     1708     field browse-number as integer
     1709     field browse-handle as handle
     1710     field original-size as decimal
     1711     index xpk is primary unique browse-type browse-number
     1712     index xie browse-type browse-handle
     1713   .
     1714   procedure diasize_change-height :
     1715     define input  parameter p-change-value  as decimal   no-undo .
     1716     define input  parameter p-move-resize   as logical   no-undo .
     1717     define variable v-field-group-handle    as handle    no-undo .
     1718     define variable v-object-handle         as handle    no-undo .
     1719     define variable v-frame-height          as decimal   no-undo .
     1720     define variable v-frame-virtual-height  as decimal   no-undo .
     1721     define variable v-browse-height         as decimal   no-undo .
     1722     define variable v-window-height         as decimal   no-undo .
     1723     define variable v-window-virtual-height as decimal   no-undo .
     1724     define variable v-change-sign           as integer   no-undo .
     1725     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1726     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1727     if p-change-value > 0
     1728     then do:
     1729       if frame Dialog-Frame :height + p-change-value
     1730           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1731       then do:
     1732         assign
     1733           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1734                           - (frame Dialog-Frame :height-chars)
     1735         .
     1736         if p-change-value <= 0
     1737         then do:
     1738           run diasize_position-resize-button in this-procedure .
     1739           return .
     1740         end.
     1741       end.
     1742     end.
     1743     if p-change-value < 0
     1744     then do:
     1745       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1746       then do:
     1747         assign
     1748           p-change-value = v-diasize-orig-frame-height
     1749                          - (frame Dialog-Frame :height-chars)
     1750         .
     1751         if p-change-value >= 0
     1752         then do:
     1753           run diasize_position-resize-button in this-procedure .
     1754           return .
     1755         end.
     1756       end.
     1757     end.
     1758     if p-change-value >= 0
     1759     then do:
     1760       assign
     1761         v-change-sign = 1
     1762       .
     1763     end.
     1764     else do:
     1765       assign
     1766         v-change-sign = -1
     1767       .
     1768     end.
     1769     assign
     1770       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1771     .
     1772     if p-change-value = 0
     1773     then do:
     1774       run diasize_position-resize-button in this-procedure .
     1775       return .
     1776     end.
     1777     move_block:
     1778     do
     1779     on error undo move_block, retry move_block
     1780     :
     1781       if retry
     1782       then do:
     1783         do
     1784         on error undo move_block, leave move_block
     1785         :
     1786           if p-change-value > 0
     1787           then do:
     1788             for each buf_temp-diasize-handle
     1789             on error undo, next
     1790             :
     1791               assign
     1792                 v-object-handle = buf_temp-diasize-handle.handle-value
     1793               .
     1794               if v-object-handle <> v-diasize-resize-button
     1795               then do:
     1796                 assign
     1797                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1798                 .
     1799               end.
     1800             end.
     1801             assign
     1802               v-diasize-browse-handle :height = v-browse-height
     1803             .
     1804             for each buf_temp-browse-handle
     1805               where buf_temp-browse-handle.browse-type = 'height':u
     1806             on error undo, next
     1807             :
     1808               assign
     1809                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1810               .
     1811             end.
     1812             assign
     1813               frame Dialog-Frame :height = v-frame-height
     1814             .
     1815             if frame Dialog-Frame :scrollable = true
     1816             then do:
     1817               assign
     1818                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1819               .
     1820             end.
     1821             run diasize_position-resize-button in this-procedure .
     1822           end.
     1823           else do:
     1824             if frame Dialog-Frame :scrollable = true
     1825             then do:
     1826               assign
     1827                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1828               .
     1829             end.
     1830             assign
     1831               frame Dialog-Frame :height = v-frame-height
     1832             .
     1833             assign
     1834               v-diasize-browse-handle :height = v-browse-height
     1835             .
     1836             for each buf_temp-browse-handle
     1837               where buf_temp-browse-handle.browse-type = 'height':u
     1838             on error undo, next
     1839             :
     1840               assign
     1841                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1842               .
     1843             end.
     1844             for each buf_temp-diasize-handle
     1845             on error undo, next
     1846             :
     1847               assign
     1848                 v-object-handle = buf_temp-diasize-handle.handle-value
     1849               .
     1850               if v-object-handle <> v-diasize-resize-button
     1851               then do:
     1852                 assign
     1853                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1854                 .
     1855               end.
     1856             end.
     1857             run diasize_position-resize-button in this-procedure .
     1858           end.
     1859           assign
     1860             v-diasize-change-size = false
     1861           .
     1862           leave move_block .
     1863         end.
     1864       end.
     1865       assign
     1866         v-diasize-need-full-display = true
     1867       .
     1868       if v-diasize-change-size = false
     1869       then do:
     1870         assign
     1871           v-diasize-change-size = true
     1872         .
     1873       end.
     1874       else do:
     1875         return .
     1876       end.
     1877       assign
     1878         v-frame-height = frame Dialog-Frame :height
     1879         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1880         v-browse-height = v-diasize-browse-handle :height
     1881       .
     1882       for each buf_temp-browse-handle
     1883         where buf_temp-browse-handle.browse-type = 'height':u
     1884       :
     1885         assign
     1886           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1887         .
     1888       end.
     1889       for each buf_temp-diasize-handle
     1890       :
     1891         delete buf_temp-diasize-handle .
     1892       end.
     1893       assign
     1894         v-field-group-handle = frame Dialog-Frame :first-child
     1895       .
     1896       do while valid-handle(v-field-group-handle)
     1897       :
     1898         assign
     1899           v-object-handle = v-field-group-handle :first-child
     1900         .
     1901         do while valid-handle(v-object-handle)
     1902         :
     1903           if  v-object-handle <> v-diasize-browse-handle :handle
     1904           and can-query(v-object-handle, "row")
     1905           and can-query(v-object-handle, "height")
     1906           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1907           then do:
     1908             find first buf_temp-browse-handle
     1909               where buf_temp-browse-handle.browse-type   = 'height':u
     1910                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1911               no-error .
     1912             if available buf_temp-browse-handle
     1913             then do:
     1914             end.
     1915             else do:
     1916               create buf_temp-diasize-handle .
     1917               assign
     1918                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1919                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1920               .
     1921             end.
     1922           end.
     1923           assign
     1924             v-object-handle = v-object-handle :next-sibling
     1925           .
     1926         end.
     1927         assign
     1928           v-field-group-handle = v-field-group-handle :next-sibling
     1929         .
     1930       end.
     1931       do with frame Dialog-Frame
     1932       :
     1933         hide v-diasize-resize-button .
     1934         assign
     1935           v-diasize-resize-button :row    = 1
     1936           v-diasize-resize-button :column = 1
     1937         .
     1938       end.
     1939       if p-change-value > 0
     1940       then do:
     1941         if frame Dialog-Frame :scrollable = true
     1942         then do:
     1943           assign
     1944             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1945             no-error .
     1946           if error-status :error
     1947           or error-status :get-message(1) <> ""
     1948           then do:
     1949             undo move_block, retry move_block .
     1950           end.
     1951         end.
     1952         assign
     1953           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1954           no-error .
     1955         if error-status :error
     1956         or error-status :get-message(1) <> ""
     1957         then do:
     1958           undo move_block, retry move_block .
     1959         end.
     1960         assign
     1961           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1962           no-error .
     1963         if error-status :error
     1964         or error-status :get-message(1) <> ""
     1965         then do:
     1966           undo move_block, retry move_block .
     1967         end.
     1968         for each buf_temp-browse-handle
     1969           where buf_temp-browse-handle.browse-type = 'height':u
     1970         on error undo move_block, retry move_block
     1971         :
     1972           assign
     1973             buf_temp-browse-handle.browse-handle :height
     1974               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1975             no-error .
     1976           if error-status :error
     1977           or error-status :get-message(1) <> ""
     1978           then do:
     1979             undo move_block, retry move_block .
     1980           end.
     1981         end.
     1982         for each buf_temp-diasize-handle
     1983         on error undo move_block, retry move_block
     1984         :
     1985           assign
     1986             v-object-handle = buf_temp-diasize-handle.handle-value
     1987           .
     1988           if v-object-handle <> v-diasize-resize-button
     1989           then do:
     1990             assign
     1991               v-object-handle :row = v-object-handle :row + p-change-value
     1992               no-error .
     1993             if error-status :error
     1994             or error-status :get-message(1) <> ""
     1995             then do:
     1996               undo move_block, retry move_block .
     1997             end.
     1998           end.
     1999         end.
     2000       end.
     2001       else do:
     2002         for each buf_temp-diasize-handle
     2003         on error undo move_block, retry move_block
     2004         :
     2005           assign
     2006             v-object-handle = buf_temp-diasize-handle.handle-value
     2007           .
     2008           if v-object-handle <> v-diasize-resize-button
     2009           then do:
     2010             assign
     2011               v-object-handle :row = v-object-handle :row + p-change-value
     2012               no-error .
     2013             if error-status :error
     2014             or error-status :get-message(1) <> ""
     2015             then do:
     2016               undo move_block, retry move_block .
     2017             end.
     2018           end.
     2019         end.
     2020         assign
     2021           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2022           no-error .
     2023         if error-status :error
     2024         or error-status :get-message(1) <> ""
     2025         then do:
     2026           undo move_block, retry move_block .
     2027         end.
     2028         for each buf_temp-browse-handle
     2029           where buf_temp-browse-handle.browse-type = 'height':u
     2030         on error undo move_block, retry move_block
     2031         :
     2032           assign
     2033             buf_temp-browse-handle.browse-handle :height
     2034               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2035             no-error .
     2036           if error-status :error
     2037           or error-status :get-message(1) <> ""
     2038           then do:
     2039             undo move_block, retry move_block .
     2040           end.
     2041         end.
     2042         assign
     2043           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2044           no-error .
     2045         if error-status :error
     2046         or error-status :get-message(1) <> ""
     2047         then do:
     2048           undo move_block, retry move_block .
     2049         end.
     2050         if frame Dialog-Frame :scrollable = true
     2051         then do:
     2052           assign
     2053             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2054             no-error .
     2055           if error-status :error
     2056           or error-status :get-message(1) <> ""
     2057           then do:
     2058             undo move_block, retry move_block .
     2059           end.
     2060         end.
     2061       end.
     2062       if p-move-resize = true
     2063       then do:
     2064         run diasize_position-resize-button in this-procedure .
     2065       end.
     2066       if v-diasize-wndstore = true
     2067       then do:
     2068         if connected("ub") = true
     2069         then do:
     2070           define variable v-cntxt-db-num        as integer   no-undo .
     2071           define variable v-cntxt-userid        as character no-undo .
     2072           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2073                                             , OUTPUT v-cntxt-userid
     2074                                             ) .
     2075           run gbl/wndsizew.p
     2076             (input  v-cntxt-db-num
     2077             ,input  v-cntxt-userid
     2078             ,input  v-diasize-proc-name
     2079             ,input  'height':u
     2080             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2081             ) .
     2082         end.
     2083       end.
     2084     end.
     2085     assign
     2086       v-diasize-change-size = false
     2087     .
     2088   end procedure.
     2089   procedure diasize_set-height :
     2090     define input  parameter p-new-height  as decimal   no-undo .
     2091     define input  parameter p-move-resize as logical   no-undo .
     2092     do
     2093     on error undo, return error return-value
     2094     :
     2095       run diasize_change-height in this-procedure
     2096         (input  (p-new-height - frame Dialog-Frame :height)
     2097         ,input  p-move-resize
     2098         ) .
     2099     end.
     2100   end procedure.
     2101   procedure diasize_change-width :
     2102     define input  parameter p-change-value as decimal   no-undo .
     2103     define input  parameter p-move-resize  as logical   no-undo .
     2104     define variable v-field-group-handle   as handle    no-undo .
     2105     define variable v-object-handle        as handle    no-undo .
     2106     define variable v-frame-width          as decimal   no-undo .
     2107     define variable v-frame-virtual-width  as decimal   no-undo .
     2108     define variable v-browse-width         as decimal   no-undo .
     2109     define variable v-window-width         as decimal   no-undo .
     2110     define variable v-window-virtual-width as decimal   no-undo .
     2111     define variable v-change-sign          as integer   no-undo .
     2112     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2113     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2114     if p-change-value > 0
     2115     then do:
     2116       if frame Dialog-Frame :width + p-change-value >
     2117           session :width-chars
     2118       then do:
     2119         assign
     2120           p-change-value = session :width-chars - frame Dialog-Frame :width
     2121         .
     2122         if p-change-value <= 0
     2123         then do:
     2124           run diasize_position-resize-button in this-procedure .
     2125           return .
     2126         end.
     2127       end.
     2128     end.
     2129     if p-change-value < 0
     2130     then do:
     2131       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2132       then do:
     2133         assign
     2134           p-change-value = v-diasize-orig-frame-width
     2135                          - frame Dialog-Frame :width
     2136         .
     2137         if p-change-value >= 0
     2138         then do:
     2139           run diasize_position-resize-button in this-procedure .
     2140           return .
     2141         end.
     2142       end.
     2143     end.
     2144     if p-change-value >= 0
     2145     then do:
     2146       assign
     2147         v-change-sign = 1
     2148       .
     2149     end.
     2150     else do:
     2151       assign
     2152         v-change-sign = -1
     2153       .
     2154     end.
     2155     assign
     2156       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2157     .
     2158     if p-change-value = 0
     2159     then do:
     2160       run diasize_position-resize-button in this-procedure .
     2161       return .
     2162     end.
     2163     move_block:
     2164     do
     2165     on error undo move_block, leave move_block
     2166     :
     2167       if retry
     2168       then do:
     2169         do
     2170         on error undo move_block, leave move_block
     2171         :
     2172           if p-change-value > 0
     2173           then do:
     2174             for each buf_temp-diasize-handle
     2175             on error undo, next
     2176             :
     2177               assign
     2178                 v-object-handle = buf_temp-diasize-handle.handle-value
     2179               .
     2180               if v-object-handle <> v-diasize-resize-button
     2181               then do:
     2182                 assign
     2183                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2184                 .
     2185               end.
     2186             end.
     2187             assign
     2188               v-diasize-browse-handle :width = v-browse-width
     2189             .
     2190             for each buf_temp-browse-handle
     2191               where buf_temp-browse-handle.browse-type = 'width':u
     2192             on error undo, next
     2193             :
     2194               assign
     2195                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2196               .
     2197             end.
     2198             assign
     2199               frame Dialog-Frame :width = v-frame-width
     2200             .
     2201             if frame Dialog-Frame :scrollable = true
     2202             then do:
     2203               assign
     2204                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2205               .
     2206             end.
     2207             run diasize_position-resize-button in this-procedure .
     2208           end.
     2209           else do:
     2210             if frame Dialog-Frame :scrollable = true
     2211             then do:
     2212               assign
     2213                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2214               .
     2215             end.
     2216             assign
     2217               frame Dialog-Frame :width = v-frame-width
     2218             .
     2219             for each buf_temp-browse-handle
     2220               where buf_temp-browse-handle.browse-type = 'width':u
     2221             on error undo, next
     2222             :
     2223               assign
     2224                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2225               .
     2226             end.
     2227             assign
     2228               v-diasize-browse-handle :width = v-browse-width
     2229             .
     2230             for each buf_temp-diasize-handle
     2231             on error undo, next
     2232             :
     2233               assign
     2234                 v-object-handle = buf_temp-diasize-handle.handle-value
     2235               .
     2236               if v-object-handle <> v-diasize-resize-button
     2237               then do:
     2238                 assign
     2239                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2240                 .
     2241               end.
     2242             end.
     2243             run diasize_position-resize-button in this-procedure .
     2244           end.
     2245           assign
     2246             v-diasize-change-size = false
     2247           .
     2248           leave move_block .
     2249         end.
     2250       end.
     2251       assign
     2252         v-diasize-need-full-display = true
     2253       .
     2254       if v-diasize-change-size = false
     2255       then do:
     2256         assign
     2257           v-diasize-change-size = true
     2258         .
     2259       end.
     2260       else do:
     2261         return .
     2262       end.
     2263       assign
     2264         v-frame-width = frame Dialog-Frame :width
     2265         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2266         v-browse-width = v-diasize-browse-handle :width
     2267       .
     2268       for each buf_temp-browse-handle
     2269         where buf_temp-browse-handle.browse-type = 'width':u
     2270       :
     2271         assign
     2272           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2273         .
     2274       end.
     2275       for each buf_temp-diasize-handle
     2276       :
     2277         delete buf_temp-diasize-handle .
     2278       end.
     2279       assign
     2280         v-field-group-handle = frame Dialog-Frame :first-child
     2281       .
     2282       do while valid-handle(v-field-group-handle)
     2283       :
     2284         assign
     2285           v-object-handle = v-field-group-handle :first-child
     2286         .
     2287         do while valid-handle(v-object-handle)
     2288         :
     2289           if  v-object-handle <> v-diasize-browse-handle :handle
     2290           and v-object-handle <> v-diasize-resize-button
     2291           and can-query(v-object-handle, "row")
     2292           and can-query(v-object-handle, "height")
     2293           and ( v-object-handle :col + v-object-handle :width
     2294                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2295               )
     2296           then do:
     2297             find first buf_temp-browse-handle
     2298               where buf_temp-browse-handle.browse-type   = 'width':u
     2299                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2300               no-error .
     2301             if available buf_temp-browse-handle
     2302             then do:
     2303             end.
     2304             else do:
     2305               create buf_temp-diasize-handle .
     2306               assign
     2307                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2308                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2309               .
     2310             end.
     2311           end.
     2312           assign
     2313             v-object-handle = v-object-handle :next-sibling
     2314           .
     2315         end.
     2316         assign
     2317           v-field-group-handle = v-field-group-handle :next-sibling
     2318         .
     2319       end.
     2320       do with frame Dialog-Frame
     2321       :
     2322         hide v-diasize-resize-button .
     2323         v-diasize-resize-button :row = 1.
     2324         v-diasize-resize-button :column = 1.
     2325       end.
     2326       if p-change-value > 0
     2327       then do:
     2328         if frame Dialog-Frame :scrollable = true
     2329         then do:
     2330           assign
     2331             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2332             no-error .
     2333           if error-status :error
     2334           or error-status :get-message(1) <> ""
     2335           then do:
     2336             undo move_block, retry move_block.
     2337           end.
     2338         end.
     2339         assign
     2340           frame Dialog-Frame :width = v-frame-width + p-change-value
     2341           no-error .
     2342         if error-status :error
     2343         or error-status :get-message(1) <> ""
     2344         then do:
     2345           undo move_block, retry move_block.
     2346         end.
     2347         assign
     2348           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2349         no-error .
     2350         if error-status :error
     2351         or error-status :get-message(1) <> ""
     2352         then do:
     2353           undo move_block, retry move_block.
     2354         end.
     2355         for each buf_temp-browse-handle
     2356           where buf_temp-browse-handle.browse-type = 'width':u
     2357         on error undo move_block, retry move_block
     2358         :
     2359           assign
     2360             buf_temp-browse-handle.browse-handle :width
     2361               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2362             no-error .
     2363           if error-status :error
     2364           or error-status :get-message(1) <> ""
     2365           then do:
     2366             undo move_block, retry move_block .
     2367           end.
     2368         end.
     2369         for each buf_temp-diasize-handle
     2370         on error undo move_block, retry move_block
     2371         :
     2372           assign
     2373             v-object-handle = buf_temp-diasize-handle.handle-value
     2374           .
     2375           if v-object-handle <> v-diasize-resize-button
     2376           then do:
     2377             assign
     2378               v-object-handle :col = v-object-handle :col + p-change-value
     2379               no-error .
     2380             if error-status :error
     2381             or error-status :get-message(1) <> ""
     2382             then do:
     2383               undo move_block, retry move_block .
     2384             end.
     2385           end.
     2386         end.
     2387       end.
     2388       else do:
     2389         for each buf_temp-diasize-handle
     2390         on error undo move_block, retry move_block
     2391         :
     2392           assign
     2393             v-object-handle = buf_temp-diasize-handle.handle-value
     2394           .
     2395           if v-object-handle <> v-diasize-resize-button
     2396           then do:
     2397             assign
     2398               v-object-handle :col = v-object-handle :col + p-change-value
     2399               no-error .
     2400             if error-status :error
     2401             or error-status :get-message(1) <> ""
     2402             then do:
     2403               undo move_block, retry move_block .
     2404             end.
     2405           end.
     2406         end.
     2407         for each buf_temp-browse-handle
     2408           where buf_temp-browse-handle.browse-type = 'width':u
     2409         on error undo move_block, retry move_block
     2410         :
     2411           assign
     2412             buf_temp-browse-handle.browse-handle :width
     2413               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2414             no-error .
     2415           if error-status :error
     2416           or error-status :get-message(1) <> ""
     2417           then do:
     2418             undo move_block, retry move_block .
     2419           end.
     2420         end.
     2421         assign
     2422           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2423           no-error .
     2424         if error-status :error
     2425         or error-status :get-message(1) <> ""
     2426         then do:
     2427           undo move_block, retry move_block.
     2428         end.
     2429         assign
     2430           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2431         no-error .
     2432         if error-status :error
     2433         or error-status :get-message(1) <> ""
     2434         then do:
     2435           undo move_block, retry move_block.
     2436         end.
     2437         if frame Dialog-Frame :scrollable = true
     2438         then do:
     2439           assign
     2440             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2441           no-error .
     2442           if error-status :error
     2443           or error-status :get-message(1) <> ""
     2444           then do:
     2445             undo move_block, retry move_block.
     2446           end.
     2447         end.
     2448       end.
     2449       if p-move-resize
     2450       then do:
     2451         run diasize_position-resize-button in this-procedure .
     2452       end.
     2453       if v-diasize-wndstore = true
     2454       then do:
     2455         if connected("ub") = true
     2456         then do:
     2457           define variable v-cntxt-db-num        as integer   no-undo .
     2458           define variable v-cntxt-userid        as character no-undo .
     2459           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2460                                             , OUTPUT v-cntxt-userid
     2461                                             ) .
     2462           run gbl/wndsizew.p
     2463             (input  v-cntxt-db-num
     2464             ,input  v-cntxt-userid
     2465             ,input  v-diasize-proc-name
     2466             ,input  'width':u
     2467             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2468             ) .
     2469         end.
     2470       end.
     2471     end.
     2472     assign
     2473       v-diasize-change-size = false
     2474     .
     2475   end procedure.
     2476   procedure diasize_set-width :
     2477     define input  parameter p-new-width  as decimal   no-undo .
     2478     define input  parameter p-move-resize as logical   no-undo .
     2479     do
     2480     on error undo, return error return-value
     2481     :
     2482       run diasize_change-width in this-procedure
     2483         (input  (p-new-width - frame Dialog-Frame :width)
     2484         ,input  p-move-resize
     2485         ) .
     2486     end.
     2487   end procedure.
     2488   procedure diasize_position-resize-button :
     2489     do with frame Dialog-Frame
     2490     :
     2491       hide v-diasize-resize-button .
     2492       assign
     2493         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2494                     - 1
     2495                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2496         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2497                     - 1
     2498                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2499       .
     2500       view v-diasize-resize-button .
     2501     end.
     2502   end procedure.
     2503   on alt-right anywhere
     2504   do:
     2505     run diasize_change-width in this-procedure
     2506       (input 1
     2507       ,input true
     2508       ) .
     2509     return no-apply .
     2510   end.
     2511   on alt-left anywhere
     2512   do:
     2513     run diasize_change-width in this-procedure
     2514       (input -1
     2515       ,input true
     2516       ) .
     2517     return no-apply .
     2518   end.
     2519   on alt-down anywhere
     2520   do:
     2521     run diasize_change-height in this-procedure
     2522       (input 1
     2523       ,input true
     2524       ) .
     2525     return no-apply .
     2526   end.
     2527   on alt-up anywhere
     2528   do:
     2529     run diasize_change-height in this-procedure
     2530       (input -1
     2531       ,input true
     2532       ) .
     2533     return no-apply .
     2534   end.
     2535   on alt-enter of frame Dialog-Frame
     2536   do:
     2537     run diasize_maximize in this-procedure
     2538       (input  ?
     2539       ).
     2540     return no-apply .
     2541   end.
     2542   procedure diasize_end-move :
     2543     do
     2544     on error undo, return error return-value
     2545     :
     2546       define variable v-row-delta as decimal   no-undo .
     2547       define variable v-col-delta as decimal   no-undo .
     2548       define variable v-new-row as decimal   no-undo .
     2549       define variable v-new-col as decimal   no-undo .
     2550       assign
     2551         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2552         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2553       .
     2554       assign
     2555         v-row-delta = v-new-row - frame Dialog-Frame :height
     2556         v-col-delta = v-new-col - frame Dialog-Frame :width
     2557       .
     2558       run diasize_change-height in this-procedure
     2559         (input v-row-delta
     2560         ,input true
     2561         ) .
     2562       run diasize_change-width in this-procedure
     2563         (input v-col-delta
     2564         ,input true
     2565         ) .
     2566     end.
     2567   end procedure.
     2568   procedure diasize_maximize :
     2569     define input  parameter p-action as logical   no-undo .
     2570     do
     2571     on error undo, return error return-value
     2572     :
     2573       if p-action = ?
     2574       then do:
     2575         if v-diasize-need-maximize = true
     2576         then do:
     2577           assign
     2578             p-action = true
     2579           .
     2580         end.
     2581         else do:
     2582           assign
     2583             p-action = false
     2584           .
     2585         end.
     2586       end.
     2587       if p-action = true
     2588       then do:
     2589         run diasize_change-height in this-procedure
     2590           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2591               - frame Dialog-Frame :height-chars
     2592           ,input true
     2593           ) .
     2594         run diasize_change-width in this-procedure
     2595           (input session :width-chars
     2596               - frame Dialog-Frame :width-chars
     2597           ,input true
     2598           ) .
     2599         assign
     2600           v-diasize-need-maximize = false
     2601         .
     2602       end.
     2603       else do:
     2604         run diasize_change-width in this-procedure
     2605           (input v-diasize-orig-frame-width
     2606               - frame Dialog-Frame :width-chars
     2607           ,input true
     2608           ) .
     2609         run diasize_change-height in this-procedure
     2610           (input v-diasize-orig-frame-height
     2611               - frame Dialog-Frame :height-chars
     2612           ,input true
     2613           ) .
     2614         assign
     2615           v-diasize-need-maximize = true
     2616         .
     2617       end.
     2618     end.
     2619   end procedure.
     2620   procedure diasize_restore-orig-size :
     2621     do
     2622     on error undo, return error return-value
     2623     :
     2624       assign
     2625         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2626         v-diasize-current-frame-height = frame Dialog-Frame :height
     2627       .
     2628       run diasize_set-height in this-procedure
     2629         (input  v-diasize-orig-frame-height
     2630         ,input  true
     2631         ) .
     2632       run diasize_set-width in this-procedure
     2633         (input  v-diasize-orig-frame-width
     2634         ,input  true
     2635         ) .
     2636     end.
     2637   end procedure.
     2638   procedure diasize_restore-current-size :
     2639     do
     2640     on error undo, return error return-value
     2641     :
     2642       run diasize_set-height in this-procedure
     2643         (input  v-diasize-current-frame-height
     2644         ,input  true
     2645         ) .
     2646       run diasize_set-width in this-procedure
     2647         (input  v-diasize-current-frame-width
     2648         ,input  true
     2649         ) .
     2650     end.
     2651   end procedure.
     2652   procedure diasize_set-browse-handle :
     2653     define input  parameter p-browse-handle as handle   no-undo .
     2654     define buffer buf_temp-browse-handle for temp-browse-handle .
     2655     do
     2656     on error undo, return error return-value
     2657     :
     2658       assign
     2659         v-diasize-browse-handle = p-browse-handle
     2660       .
     2661       for each buf_temp-browse-handle
     2662       on error undo, return error return-value
     2663       :
     2664         delete buf_temp-browse-handle .
     2665       end.
     2666     end.
     2667   end procedure.
     2668   procedure diasize_add_browse :
     2669     define input  parameter p-browse-type   as character no-undo .
     2670     define input  parameter p-browse-handle as handle    no-undo .
     2671     define buffer buf_temp-browse-handle for temp-browse-handle .
     2672     do
     2673     on error undo, return error return-value
     2674     :
     2675       assign
     2676         v-diasize-browse-number = v-diasize-browse-number + 1
     2677       .
     2678       create buf_temp-browse-handle .
     2679       assign
     2680         buf_temp-browse-handle.browse-type   = p-browse-type
     2681         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2682         buf_temp-browse-handle.browse-handle = p-browse-handle
     2683       .
     2684     end.
     2685   end procedure.
     2686   procedure diasize_init :
     2687     define variable v-default-value    as logical   no-undo .
     2688     define variable v-restore-saved    as logical   no-undo .
     2689     define variable v-resize-value-str as character no-undo .
     2690     do
     2691     on error undo, return error return-value
     2692     :
     2693       do with frame Dialog-Frame
     2694       :
     2695         assign
     2696           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2697           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2698           v-diasize-browse-handle     = browse BR-bank :handle
     2699         .
     2700         create button v-diasize-resize-button
     2701         assign
     2702           parent        = frame Dialog-Frame :first-child
     2703           label         = "s"
     2704           height-pixels = 16
     2705           width-pixels  = 16
     2706           visible       = true
     2707           sensitive     = true
     2708           movable       = true
     2709           triggers:
     2710             on end-move persistent run diasize_end-move in this-procedure .
     2711           end triggers.
     2712         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2713         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2714         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2715         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2716         assign
     2717           v-diasize-wndmax = false
     2718         .
     2719         if connected("ub") = true
     2720         then do:
     2721           define variable v-cntxt-db-num        as integer   no-undo .
     2722           define variable v-cntxt-userid        as character no-undo .
     2723           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2724                                             , OUTPUT v-cntxt-userid
     2725                                             ) .
     2726           run gbl/wndpar_r.p
     2727             (input  v-cntxt-db-num
     2728             ,input  v-cntxt-userid
     2729             ,input  'wndmax':U
     2730             ,output v-diasize-wndmax
     2731             ,output v-default-value
     2732             ) .
     2733         end.
     2734         assign
     2735           v-diasize-wndstore = false
     2736         .
     2737         if connected("ub") = true
     2738         then do:
     2739           run gbl/wndpar_r.p
     2740             (input  v-cntxt-db-num
     2741             ,input  v-cntxt-userid
     2742             ,input  'wndstore':U
     2743             ,output v-diasize-wndstore
     2744             ,output v-default-value
     2745             ) .
     2746         end.
     2747         assign
     2748           v-diasize-proc-name = entry(1, program-name(2), '.')
     2749         .
     2750         if v-diasize-wndstore = true
     2751         then do:
     2752           assign
     2753             v-restore-saved = false
     2754           .
     2755           if connected("ub") = true
     2756           then do:
     2757             run gbl/wndsizer.p
     2758               (input  v-cntxt-db-num
     2759               ,input  v-cntxt-userid
     2760               ,input  v-diasize-proc-name
     2761               ,input  'height':u
     2762               ,output v-resize-value-str
     2763               ) .
     2764             if v-resize-value-str <> '':U
     2765             then do:
     2766               run diasize_change-height in this-procedure
     2767                 (input  integer(v-resize-value-str)
     2768                 ,input  true
     2769                 ) .
     2770               assign
     2771                 v-restore-saved = true
     2772               .
     2773             end.
     2774           end.
     2775           if connected("ub") = true
     2776           then do:
     2777             run gbl/wndsizer.p
     2778               (input  v-cntxt-db-num
     2779               ,input  v-cntxt-userid
     2780               ,input  v-diasize-proc-name
     2781               ,input  'width':u
     2782               ,output v-resize-value-str
     2783               ) .
     2784             if v-resize-value-str <> '':U
     2785             then do:
     2786               run diasize_change-width in this-procedure
     2787                 (input  integer(v-resize-value-str)
     2788                 ,input  true
     2789                 ) .
