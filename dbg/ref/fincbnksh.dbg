     1057   FUNCTION get-all-fields returns character (p-file-name as character ):
     1058   define variable v-dop as character no-undo .
     1059     find first _file no-lock where _file._file-name = p-file-name no-error .
     1060     if not available _file then return "":U.
     1061     for each _field no-lock where
     1062              _field._file-recid = recid(_file) :
     1063       assign
     1064       v-dop = v-dop + _field._field-name + chr(44)
     1065       .
     1066     end.
     1067     return trim(v-dop).
     1068   END FUNCTION.
