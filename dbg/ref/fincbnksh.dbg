     3187   PROCEDURE OpenBr :
     3188   define input  parameter p-open-query     as logical   no-undo .
     3189   define input  parameter p-find-next      as logical   no-undo .
     3190   define input  parameter p-find-condition as character no-undo .
     3191   define variable l-query-was-opened as logical no-undo .
     3192   define variable title0 as character no-undo.
     3193   title0 = "Список истории изменения банков" + chr(32).
     3194   run waitfram-show in this-procedure ( input "Ждите...").
     3195   define variable sort-column-phrase as character no-undo .
     3196   case sort-column-name :
     3197     when "" then do:
     3198       assign
     3199         sort-column-phrase = ""
     3200       .
     3201     end.
     3202     otherwise do:
     3203       assign
     3204         sort-column-phrase = "by " + sort-column-name
     3205       .
     3206     end.
     3207   end case.
     3208   define variable l-open-query as logical   no-undo .
     3209     CASE p-mode :
     3210       WHEN 'все':U        THEN DO:
     3211        assign
     3212        filter-point = filter-point0 + p-mode
     3213        filter-label = substitute("&1", filter-label0)
     3214        .
     3215   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3216   define variable  l-disable-where-27  as logical   no-undo .
     3217   define variable  l-filter-open-27    as logical   .
     3218   define variable  flt-rec-27       as recid     no-undo .
     3219   define variable  filter-name-27      as character no-undo .
     3220   define variable  where-phrase-27     as character no-undo .
     3221   define variable  sort-phrase-27      as character no-undo .
     3222   define variable  where-phrase-rus-27 as character no-undo .
     3223   define variable  sort-phrase-rus-27  as character no-undo .
     3224     run waitfram-show in this-procedure
     3225       (input "ЖДИТЕ ..."
     3226       ).
     3227   run gbl/flt-get.p
     3228     (input filter-point
     3229     ,output flt-rec-27
     3230     ,output filter-name-27
     3231     ,output where-phrase-27
     3232     ,output sort-phrase-27
     3233     ,output where-phrase-rus-27
     3234     ,output sort-phrase-rus-27
     3235     ).
     3236   if p-open-query then do:
     3237       run set-filter-name in this-procedure
     3238         (INPUT filter-name-27
     3239         ) no-error .
     3240     assign
     3241       l-filter-open-27 = false
     3242     .
     3243     if flt-rec-27 <> ?
     3244       or sort-column-phrase > ""
     3245     then do:
     3246       define variable  parameter-2-27 as character no-undo .
     3247       define variable  parameter-3-27 as character no-undo .
     3248       define variable  parameter-4-27 as character no-undo .
     3249       define variable  parameter-5-27 as character no-undo .
     3250       define variable  parameter-6-27 as character no-undo .
     3251       define variable  parameter-7-27 as character no-undo .
     3252         assign
     3253         parameter-3-27 =
     3254                                 "FOR EACH X_c-fin-bank"
     3255         parameter-4-27 =
     3256           (
     3257             if (" TRUE " + " " + where-phrase-27) <> ""
     3258             then " TRUE " + " " + where-phrase-27
     3259             else "true"
     3260           )
     3261         parameter-5-27 = (" " + "" + " " + "")
     3262         parameter-6-27 = if sort-phrase-27 = ''
     3263                              then
     3264           (
