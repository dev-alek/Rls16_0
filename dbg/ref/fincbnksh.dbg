     2798             then do:
     2799               run diasize_maximize in this-procedure
     2800                 (input  true
     2801                 ) .
     2802             end.
     2803           end.
     2804         end.
     2805         else do:
     2806           if v-diasize-wndmax = true
     2807           then do:
     2808             run diasize_maximize in this-procedure
     2809               (input  true
     2810               ) .
     2811           end.
     2812         end.
     2813       end.
     2814     end.
     2815   end procedure.
     2816   procedure diasize_need-full-display :
     2817     define output parameter p-need-full-display as logical   no-undo .
     2818     do
     2819     on error undo, return error return-value
     2820     :
     2821       assign
     2822         p-need-full-display = v-diasize-need-full-display
     2823       .
     2824       assign
     2825         v-diasize-need-full-display = false
     2826       .
     2827     end.
