     2829   procedure get-context :
     2830      define output parameter p-db-num as integer          no-undo.
     2831      define output parameter p-user-id as character        no-undo.
     2832      define variable v-login               as character    no-undo.
     2833      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2834      define buffer buf_user-login  for ub.user-login .
     2835      do
     2836      on error undo, return error
     2837      :
     2838            FIND FIRST buf_sys-ctrl no-lock.
     2839            ASSIGN
     2840               v-login = USERID("ub")
     2841               p-db-num = buf_sys-ctrl.db-num
     2842            .
     2843            FIND FIRST buf_user-login
     2844                 WHERE buf_user-login.db-num = p-db-num
     2845                   AND buf_user-login.user-login = v-login
     2846                 no-lock
     2847                 no-error
     2848                 .
     2849            IF AVAILABLE buf_user-login
     2850            THEN DO:
     2851               assign
     2852                  p-user-id = buf_user-login.user-id
     2853               .
     2854            END.
     2855      end.
     2856   end procedure.
     2857   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2858   on f5 of frame Dialog-Frame anywhere
     2859   do:
     2860     v-doc-rec = recid(X_c-fin-bank). run OpenBr in this-procedure ( input yes, input no, input '':U). reposition br-bank to recid v-doc-rec no-error. v-doc-rec = ?.
     2861       apply "VALUE-CHANGED" to BR-bank.
     2862   end.
     2863   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2864   procedure set-filter-name :
     2865   define input parameter p-filter-name as character no-undo .
     2866     do with frame Dialog-Frame:
     2867       if p-filter-name > "" then do:
