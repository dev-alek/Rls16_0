      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define variable c-point  as character no-undo .
      125   define variable tbl      as character no-undo .
      126   define variable join-tbl as character no-undo .
      127   define variable fld      as character no-undo .
      128   define variable lab      as character no-undo .
      129   define variable spr      as character no-undo .
      130   define variable dim      as character no-undo .
      131   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   procedure cur-time :
      133      define output parameter p-today as date      no-undo .
      134      define output parameter p-time  as integer   no-undo .
      135     do
      136     on error undo, return error
      137     :
      138       define variable v-date1 as date      no-undo .
      139       define variable v-date2 as date      no-undo .
      140       define variable v-time  as integer   no-undo .
      141       assign
      142         v-date1 = today
      143         v-time  = time
      144         v-date2 = today
      145       .
      146       if v-date1 <> v-date2
      147       then do:
      148         assign
      149           v-date1 = today
      150           v-time  = v-time
      151         .
      152       end.
      153       assign
      154         p-today = v-date1
      155         p-time  = v-time
      156       .
      157     end.
      158   end.
      159   function cur-time-date returns character
      160   :
      161     return string(today, '99/99/9999':U) .
      162   end.
      163   function cur-time-mjd returns decimal
      164   :
      165     define variable v-date as date      no-undo .
      166     define variable v-time as integer   no-undo .
      167     run cur-time in this-procedure
      168       (output v-date
      169       ,output v-time
      170       ) .
      171     return integer(v-date) - 2400002 + (v-time / 86400) .
      172   end.
      173   function cur-time-get-ending-index returns integer
      174   (input p-number as integer
      175   )
      176   :
      177     if p-number < 0
      178     or p-number = ?
      179     then do:
      180       return 1 .
      181     end.
      182     define variable v-rest as integer   no-undo .
      183     assign
      184       p-number = p-number modulo 100
      185     .
      186     if p-number < 20
      187     then do:
      188       assign
      189         v-rest = p-number
      190       .
      191     end.
      192     else do:
      193       assign
      194         v-rest = p-number modulo 10
      195       .
      196     end.
      197     case v-rest :
      198       when 1
      199       then do:
      200         return 2 .
      201       end.
      202       when 2 or
      203       when 3 or
      204       when 4
      205       then do:
      206         return 3 .
      207       end.
      208       otherwise do:
      209         return 1 .
      210       end.
      211     end case .
      212   end.
      213   procedure cur-time-mjd-to-date :
      214      define input  parameter i-mjd-diff as decimal no-undo.
      215      define output parameter o-Date     as date    no-undo.
      216      define output parameter o-Time     as integer no-undo.
      217      define variable v-day-number as integer   no-undo .
      218      if    i-mjd-diff < 0
      219         or i-mjd-diff = ?
      220      then do:
      221         return "?" .
      222      end.
      223      assign
      224         v-day-number = truncate(i-mjd-diff,0).
      225         o-Date = date(v-day-number + 2400002).
      226         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      227     .
      228   end.
      229   function cur-time-mjd-to-string returns character
      230   (input p-mjd-diff as decimal
      231   )
      232   :
      233     define variable v-day-number as integer   no-undo .
      234     define variable v-seconds    as integer   no-undo .
      235     define variable v-hour       as integer   no-undo .
      236     define variable v-min        as integer   no-undo .
      237     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      238     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      239     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      240     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      241     if p-mjd-diff < 0
      242     or p-mjd-diff = ?
      243     then do:
      244       return "?" .
      245     end.
      246     assign
      247       v-day-number = integer(truncate(p-mjd-diff,0))
      248       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      249     .
      250     if v-seconds > 86400
      251     then do:
      252       assign
      253         v-seconds = 86400 - 1
      254       .
      255     end.
      256     if v-seconds < 0
      257     then do:
      258       assign
      259         v-seconds = 0
      260       .
      261     end.
      262     assign
      263       v-hour = truncate(v-seconds / 3600, 0)
      264     .
      265     assign
      266       v-seconds = v-seconds modulo 3600
      267     .
      268     assign
      269       v-min = truncate(v-seconds / 60, 0)
      270     .
      271     assign
      272       v-seconds = v-seconds modulo 60
      273     .
      274     return
      275         (if v-day-number <> 0
      276           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      277           else ""
      278         )
      279       + (if v-day-number <> 0 or v-hour <> 0
      280           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      281           else ""
      282         )
      283       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      284           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      285           else ""
      286         )
      287       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      288       .
      289   end.
      290   function cur-time-string returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      299   end.
      300   function cur-time-string-sec returns character
      301   :
      302     define variable v-date as date      no-undo .
      303     define variable v-time as integer   no-undo .
      304     run cur-time in this-procedure
      305       (output v-date
      306       ,output v-time
      307       ) .
      308     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      309   end.
      310   function cur-time-custom  returns character
      311   (input p-prefix as character
      312   ,input p-date-format as character
      313   ,input p-delimiter as character
      314   ,input p-time-format as character
      315   ,input p-suffix as character
      316   )
      317   :
      318     define variable v-date as date      no-undo .
      319     define variable v-time as integer   no-undo .
      320     run cur-time in this-procedure
      321       (output v-date
      322       ,output v-time
      323       ) .
      324     return
      325       p-prefix
      326       + string(v-date, p-date-format)
      327       + p-delimiter
      328       + string(v-time, p-time-format)
      329       + p-suffix
      330       .
      331   end.
      332   function cur-time-print  returns character
      333   :
      334     define variable v-date as date      no-undo .
      335     define variable v-time as integer   no-undo .
      336     run cur-time in this-procedure
      337       (output v-date
      338       ,output v-time
      339       ) .
      340     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      341   end.
      342   function cur-time-datetime returns datetime
      343   :
      344     define variable v-char as character no-undo .
      345     define variable v-datetime as datetime no-undo .
      346     v-char = cur-time-string().
      347     v-datetime = datetime(v-char).
      348     return  v-datetime.
      349   end.
      350   function cur-time-string-msec returns character
      351   :
      352     define variable v-date as datetime  no-undo .
      353     v-date = now.
      354     return string(v-date) .
      355   end.
      356   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      358   define new shared variable RepPathName        as character no-undo .
      359   define new shared variable PrintRubl          as logical   no-undo .
      360   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   define variable v-waitfram-action01         as character   no-undo .
      362   define variable v-waitfram-action02         as character   no-undo .
      363   define variable v-waitfram-action03         as character   no-undo .
      364   define variable mWaitFramTextBeg            as character   no-undo.
      365   define variable mWaitFramTextEnd            as character   no-undo.
      366   define variable mWaitFramView               as logical     no-undo.
      367   define variable mWaitProcEvent              as logical     no-undo init yes.
      368   define variable mWaitFramInterval           as integer     no-undo init 1 .
      369   define variable mWaitFramStop               as logical     no-undo.
      370   define variable mWaitFramStopUser           as logical     no-undo.
      371   define variable mWaitFramStopTimeOut        as logical     no-undo.
      372   define variable mWaitFramStartProc          as datetime-tz no-undo.
      373   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      374   define button B-WaitFramStop auto-end-key
      375        label "Стоп"
      376        size 10 by 1 tooltip "Остоновить процесс".
      377   define button B-viewProcInfo
      378        label "Информация"
      379        size 15 by 1 tooltip "Информация о процесс".
      380   define frame waitfram
      381     v-waitfram-action01 format "x(72)" no-label skip
      382     v-waitfram-action02 format "x(72)" no-label skip
      383     v-waitfram-action03 format "x(72)" no-label skip
      384     B-viewProcInfo
      385     B-WaitFramStop at row 4 col 30
      386     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      387     .
      388   define new global shared variable mBatchMode as logical no-undo init ?.
      389   define variable mFramBachModHandle as handle no-undo.
      390   mFramBachModHandle = frame waitfram:handle.
      391   define variable mFameOldVis as logical no-undo.
      392   define variable mVisCUrentVin as logical no-undo.
      393   if session:batch-mode
      394   then
      395      mBatchMode = yes.
      396   if mBatchMode = ? then do:
      397     mVisCUrentVin = current-window:visible.
      398     mFameOldVis = mFramBachModHandle:visible.
      399     mFramBachModHandle:visible  = yes.
      400     mBatchMode = mFramBachModHandle:visible ne yes.
      401     mFramBachModHandle:visible = mFameOldVis.
      402     current-window:visible = mVisCUrentVin.
      403   end.
      404    if  log-manager:logfile-name ne ?
      405     then DO:
      406         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      407         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      408         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      409     end.
      410   on choose of B-WaitFramStop in frame waitfram
      411   do:
      412     mWaitFramStop = yes.
      413     mWaitFramStopUser = yes.
      414   end.
      415   function waitfram-check-timeout returns logical():
      416      define variable vtime as int64 no-undo.
      417      if mWaitFramStopTimeOut
      418      then
      419         return yes.
      420      vtime = ( now - mWaitFramStartProc ) / 1000 .
      421      if     mWaitFramTimeOut ne ?
      422         and mWaitFramTimeOut ne 0
      423         and mWaitFramTimeOut lt vtime
      424      then do:
      425         mWaitFramStopTimeOut = yes.
      426      end.
      427      return mWaitFramStopTimeOut.
      428   end.
      429   procedure waitfram-hide :
      430     if not session:batch-mode
      431     then do
      432     on error undo, return error return-value
      433     :
      434       pause 0 before-hide .
      435       if not mBatchMode then
      436         hide frame waitfram .
      437     if     not mWaitFramView
      438        and mWaitProcEvent
      439     then
      440       process events .
      441     end.
      442   end procedure.
      443   procedure waitfram-show :
      444     define input  parameter p-message as character no-undo .
      445     define variable v-left-margin as integer   no-undo .
      446     if not session:batch-mode
      447     then do
      448     on error undo, return error return-value
      449     :
      450       if length(p-message) <= 70 then do:
      451         assign
      452           v-left-margin = integer((70 - length(p-message)) / 2)
      453         .
      454         assign
      455           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      456         .
      457         assign
      458           v-waitfram-action01 = " "
      459           v-waitfram-action02 = " "
      460                                    + fill(" ", v-left-margin)
      461                                    + p-message
      462           v-waitfram-action03 = " "
      463         .
      464       end.
      465       else do:
      466         define variable vRindex1 as integer no-undo.
      467         define variable vRindex2 as integer no-undo.
      468         vRindex1 = r-index(p-message," ",70).
      469         if vRindex1 = 0
      470         then
      471            vRindex1 = 70.
      472         if length(p-message)  <= vRindex1 + 70 then do:
      473           assign
      474             v-waitfram-action01 = " "
      475             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      476             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      477           .
      478         end.
      479         else do:
      480           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      481           if vRindex2 <= vRindex1
      482           then
      483              vRindex2 = vRindex1 + 70.
      484           assign
      485             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      486             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      487             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      488           .
      489         end.
      490       end.
      491       B-viewProcInfo:visible   in frame waitfram = no.
      492       B-viewProcInfo:sensitive in frame waitfram = no.
      493       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      494       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      495       if  (   mWaitFramView
      496          or  mWaitProcEvent)
      497          and not mBatchMode
      498       then
      499          display
      500             v-waitfram-action01 skip
      501             v-waitfram-action02 skip
      502             v-waitfram-action03 skip
      503          with frame waitfram .
      504       if     mWaitFramView
      505          then do:
      506             if     mWaitFramInterval ne ?
      507                and not mBatchMode
      508             then
      509                wait-for go of frame waitfram pause mWaitFramInterval.
      510          end.
      511          else
      512             if     mWaitProcEvent
      513                and not mBatchMode
      514             then
      515                process events .
      516     end.
      517   end procedure.
      518      procedure waitfram-show-this:
      519         define input  parameter iInterval as int64 no-undo.
      520         define variable vtime as int64 no-undo.
      521         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      522         mWaitFramInterval = iInterval.
      523         run waitfram-show (substitute("&1&2 &3&4" ,
      524                                       mWaitFramTextBeg ,
      525                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      526                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      527                                       mWaitFramTextEnd
      528                                      )
      529                           ).
      530      end.
      531      procedure WaitFramRunPause:
      532         define input  parameter iInterval as dec no-undo.
      533         define variable vStart  as datetime-tz no-undo.
      534         define variable vend    as datetime-tz no-undo.
      535         define variable vint as int64 no-undo.
      536         define variable vOk as logical no-undo.
      537         vStart = now.
      538         vend   = vStart.
      539         publish "WaitFramPause" (iInterval,output vOk).
      540         vend   =  now.
      541         vint = vend - vStart.
      542         vint = iInterval - vint / 1000.
      543         if     not mWaitFramStop
      544            and (   vint > 0
      545                 or (    not vOk
      546                     and iInterval eq ?
      547                     )
      548                 )
      549         then
      550            run waitfram-show-this (iInterval).
      551         vend   =  now.
      552         vint = vend - vStart.
      553         vint = iInterval - vint / 1000.
      554         if     not mWaitFramStop
      555            and vint > 0
      556         then do:
      557            run gbl/pause.p (vint * 1000).
      558         end.
      559         if iInterval ne ?
      560         then
      561            publish "WaitFramStop".
      562         waitfram-check-timeout().
      563      end.
      564      procedure WaitFramWaitFor:
      565         define input  parameter iInterval as dec no-undo.
      566         assign
      567            mWaitFramStartProc   = now
      568            mWaitFramStopUser    = no
      569            mWaitFramStopTimeOut = no
      570         .
      571         block-wait:
      572         do while not mWaitFramStop:
      573            run WaitFramRunPause (iInterval).
      574            if  waitfram-check-timeout()
      575            then do:
      576               leave block-wait.
      577            end.
      578         end.
      579         run waitfram-hide.
      580      end.
      581   procedure waitfram-join :
      582     define input  parameter p-line-1  as character no-undo .
      583     define input  parameter p-line-2  as character no-undo .
      584     define input  parameter p-line-3  as character no-undo .
      585     define output parameter p-message as character no-undo .
      586     do
      587     on error undo, return error return-value
      588     :
      589       assign
      590         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      591                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      592                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      593       .
      594     end.
      595   end procedure.
      596   function waitfram-join-function returns character
      597     (input p-line-1 as character
      598     ,input p-line-2 as character
      599     ,input p-line-3 as character
      600     ).
      601     define variable v-message as character no-undo .
      602     run waitfram-join in this-procedure
      603       (input  p-line-1
      604       ,input  p-line-2
      605       ,input  p-line-3
      606       ,output v-message
      607       ) .
      608     return v-message .
      609   end function .
