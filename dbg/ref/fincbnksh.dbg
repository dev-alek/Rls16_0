     3161     temp-changes.v_old:width in browse br-changes = 40
     3162     temp-changes.v_new:width in browse br-changes = 40
     3163     .
     3164     DISPLAY
     3165     ED-notes
     3166     sch-code
     3167     sch-BIK
     3168     sch-name
     3169     mark-num
     3170     br-changes
