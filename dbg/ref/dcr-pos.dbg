        1   block-level on error undo, throw.
        2   define input parameter p-mode as character no-undo .
        3   define input parameter p-silent as logical no-undo .
        4   define input parameter p-templ-rl-root as integer no-undo .
        5   define input parameter p-host-code as integer no-undo .
        6   define input parameter p-obj-type as character no-undo .
        7   define input parameter p-obj-code as integer no-undo .
        8   define input parameter p-sts as integer no-undo .
        9   define input parameter p-rule-num as integer no-undo .
       10   define output parameter p-pos-type as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: dcr-pos.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: ref/dcr-pos.p $":U .
       16   define variable vss-description as character no-undo init "".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable v-cont-det-pos as logical no-undo .
       76   define variable v-ii as integer no-undo .
       77   define variable glog as logical no-undo .
       78   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
       79   define buffer buf_dis-thbj-rule  for ub.dis-thbj-rule.
       80   if can-find( first ub.dis-cfg-rule no-lock where
       81                      ub.dis-cfg-rule.templ-rl-root = p-templ-rl-root
       82                  and ub.dis-cfg-rule.table-name = 'dis-thbj-rule':U)
       83   or p-mode = 'ДОБАВЛЕНИЕ':U then do:
       84     if p-mode = 'ИЗМЕНЕНИЕ':U
       85     or p-mode = 'ПРОСМОТР':U then do:
       86       if p-sts <> integer('1':U) then do:
       87         if can-find( first ub.dis-cfg-rule no-lock where
       88                           ub.dis-cfg-rule.templ-rl-root = p-templ-rl-root
       89                       and ub.dis-cfg-rule.table-name = 'dis-thbj-rule':U) then do:
       90           find first buf_dis-thbj-rule no-lock where
       91                     buf_dis-thbj-rule.host-code = p-host-code
       92                 and buf_dis-thbj-rule.obj-type = p-obj-type
       93                 and buf_dis-thbj-rule.obj-code = p-obj-code
       94                 and buf_dis-thbj-rule.rule-num = p-rule-num no-error.
       95           if not available buf_Dis-thbj-rule then do:
       96             p-pos-type = '':U.
       97             v-cont-det-pos = yes.
       98           end.
       99           else do:
      100             p-pos-type = buf_Dis-thbj-rule.pos-type.
      101           end.
      102         end.
      103       end.
      104     end.
      105     if p-mode = 'ДОБАВЛЕНИЕ':U
      106     or v-cont-det-pos then do:
      107       _v-ii:
      108       do v-ii = 1 to num-entries('bo':U):
      109         find first  buf_dis-cfg-rule no-lock where
      110                   buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      111               and buf_dis-cfg-rule.pos-type = entry(v-ii, 'bo':U) no-error .
      112         if available buf_dis-cfg-rule then do:
      113           assign
      114           p-pos-type = buf_dis-cfg-rule.pos-type.
      115           leave _v-ii.
      116         end.
      117       end.
      118       if p-pos-type = '':U then do:
      119         if p-obj-code > 0 then do:
      120           if p-obj-type = 'скл':U then do:
      121             p-pos-type = '-':U.
      122           end.
      123           else do:
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable v-param-type0 as character no-undo .
      126   define variable v-value-date0 as date no-undo .
      127   define variable v-value-decimal0 as decimal no-undo .
      128   define variable v-value-integer0 as INTEGER no-undo .
      129   define variable v-value-logical0 AS LOGICAL no-undo .
      130   define variable v-tth0 as handle no-undo .
      131   run adm/shattri.p (
      132       input "get":U
      133       ,input  p-obj-type
      134       ,input  p-obj-code
      135       ,input  'cd-sending':U
      136       ,input  'dflt-cd':U
      137       ,output p-pos-type
      138       ,output v-value-date0
      139       ,output v-value-decimal0
      140       ,output v-value-integer0
      141       ,output v-value-logical0
      142       ,output v-param-type0
      143       ,INPUT-OUTPUT table-handle v-tth0
      144       )  .
      145   delete object v-tth0 no-error.
      146               find first  buf_dis-cfg-rule no-lock where
      147                         buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      148                     and buf_dis-cfg-rule.pos-type = p-pos-type no-error .
      149             if not available buf_dis-cfg-rule then do:
      150               find first  buf_dis-cfg-rule no-lock where
      151                         buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      152                     and buf_dis-cfg-rule.pos-type = '-':U no-error .
      153               if available buf_dis-cfg-rule then do:
      154                 if p-mode <> 'ПРОСМОТР':U then do:
      155                   if not p-silent then do:
      156                     message
      157                     substitute("Правило скидки по данному шаблону неприменимо для типа касс, работающих на &1&2&3" +
      158                                 "использование данного правила будет возможно только при расчете скидок по накладной&3" +
      159                                 "все равно хотите добавить/изменить правило скидки?"
      160                                 ,p-obj-type
      161                                 ,p-obj-code
      162                                 ,chr(10))
      163                     view-as alert-box question buttons yes-no update glog.
      164                     if not glog then undo,  return error.
      165                   end.
      166                 end.
      167                 p-pos-type = buf_dis-cfg-rule.pos-type.
      168               end.
      169               else do:
      170                 if p-mode <> 'ПРОСМОТР':U and p-pos-type = '' then do:
      171                   message
      172                   substitute("Правило скидки по данному шаблону невозможно ввести:&1" +
      173                               "неопределено для какого типа касс возможно его использование&1"
      174                               ,chr(10))
      175                   view-as alert-box error .
      176                   undo,  return error.
      177                 end.
      178               end.
      179             end.
      180           end.
      181         end.
      182         else do:
      183           if p-mode <> 'ПРОСМОТР':U then do:
      184             find   buf_dis-cfg-rule no-lock where
      185                       buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      186                   and buf_dis-cfg-rule.pos-type <> '-':U no-error .
      187             if not available buf_dis-cfg-rule
      188             and ambiguous  buf_Dis-cfg-rule then do:
      189               run ref/sel-cdt.w ( input p-templ-rl-root
      190                                 ,output p-pos-type) no-error.
      191               if p-pos-type = '':U then do:
      192                 return error.
      193               end.
      194             end.
      195             else do:
      196               p-pos-type = buf_dis-cfg-rule.pos-type.
      197             end.
      198           end.
      199         end.
      200       end.
      201     end.
      202     if p-pos-type = '':U
      203     and p-mode <> 'ПРОСМОТР':U
      204     then do:
      205       return error substitute("Не удалось определить место действия для правила скидки &1", p-rule-num).
      206     end.
      207   end.
