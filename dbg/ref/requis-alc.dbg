      652   define variable v-tab-order  as character no-undo.
      653   define variable v-dop        as character no-undo.
      654   define variable v-attr-value as character no-undo .
      655   define variable v-attr-type  as character no-undo .
      656   DEFINE BUTTON B-exit AUTO-GO
      657        LABEL "&Ввод"
      658        SIZE 10 BY 1
      659        BGCOLOR 8 .
      660   DEFINE BUTTON B-Help
      661        LABEL "Помо&щь"
      662        SIZE 10 BY 1
      663        BGCOLOR 8 .
      664   DEFINE BUTTON b-quit AUTO-END-KEY
      665        LABEL "&Отмена"
      666        SIZE 10 BY 1
      667        BGCOLOR 8 .
      668   DEFINE BUTTON btn-region-code
      669        IMAGE-UP FILE "btn-down-arrow":U
      670        IMAGE-DOWN FILE "btn-down-arrow":U
      671        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      672        LABEL ""
      673        SIZE 3 BY .88.
      674   DEFINE VARIABLE f-apartment AS INTEGER FORMAT ">>>>9":U INITIAL 0
      675        LABEL "Квартира"
      676        VIEW-AS FILL-IN
      677        SIZE 14 BY 1 NO-UNDO.
      678   DEFINE VARIABLE f-area AS CHARACTER FORMAT "X(250)":U
      679        LABEL "Район"
      680        VIEW-AS FILL-IN
      681        SIZE 62.63 BY 1 NO-UNDO.
      682   DEFINE VARIABLE f-case AS CHARACTER FORMAT "X(256)":U
      683        LABEL "Корпус"
      684        VIEW-AS FILL-IN
      685        SIZE 14 BY 1 NO-UNDO.
      686   DEFINE VARIABLE f-city AS CHARACTER FORMAT "X(256)":U
      687        LABEL "Город"
      688        VIEW-AS FILL-IN
      689        SIZE 33 BY 1 NO-UNDO.
      690   DEFINE VARIABLE f-city2 AS CHARACTER FORMAT "X(250)":U
      691        LABEL "Населенный пункт"
      692        VIEW-AS FILL-IN
      693        SIZE 35.63 BY 1 NO-UNDO.
      694   DEFINE VARIABLE f-country AS INTEGER FORMAT "999":U INITIAL 0
      695        LABEL "Код страны"
      696        VIEW-AS FILL-IN
      697        SIZE 11 BY 1 NO-UNDO.
      698   DEFINE VARIABLE f-f-accountant AS CHARACTER FORMAT "X(256)":U
      699        VIEW-AS FILL-IN
      700        SIZE 25 BY .96 NO-UNDO.
      701   DEFINE VARIABLE f-f-direcotr AS CHARACTER FORMAT "X(256)":U
      702        VIEW-AS FILL-IN
      703        SIZE 25 BY .96 NO-UNDO.
      704   DEFINE VARIABLE f-house AS CHARACTER FORMAT "X(256)":U
      705        LABEL "Дом"
      706        VIEW-AS FILL-IN
      707        SIZE 14 BY 1 NO-UNDO.
      708   DEFINE VARIABLE f-i-accountant AS CHARACTER FORMAT "X(256)":U
      709        VIEW-AS FILL-IN
      710        SIZE 25 BY .96 NO-UNDO.
      711   DEFINE VARIABLE f-i-direcotr AS CHARACTER FORMAT "X(256)":U
      712        VIEW-AS FILL-IN
      713        SIZE 25 BY .96 NO-UNDO.
      714   DEFINE VARIABLE f-index AS INTEGER FORMAT "999999":U INITIAL 0
      715        LABEL "Индекс"
      716        VIEW-AS FILL-IN
      717        SIZE 16 BY 1 NO-UNDO.
      718   DEFINE VARIABLE f-litera AS CHARACTER FORMAT "X(256)":U
      719        LABEL "Литера"
      720        VIEW-AS FILL-IN
      721        SIZE 14 BY .96 NO-UNDO.
      722   DEFINE VARIABLE f-o-accountant AS CHARACTER FORMAT "X(256)":U
      723        VIEW-AS FILL-IN
      724        SIZE 25 BY .96 NO-UNDO.
      725   DEFINE VARIABLE f-o-direcotr AS CHARACTER FORMAT "X(256)":U
      726        VIEW-AS FILL-IN
      727        SIZE 25 BY .96 NO-UNDO.
      728   DEFINE VARIABLE f-post AS CHARACTER FORMAT "X(250)":U
      729        VIEW-AS FILL-IN
      730        SIZE 69 BY 1 NO-UNDO.
      731   DEFINE VARIABLE f-region-code AS INTEGER FORMAT "99":U INITIAL 0
      732        LABEL "Код региона"
      733        VIEW-AS FILL-IN
      734        SIZE 14 BY 1 NO-UNDO.
      735   DEFINE VARIABLE f-sobstv AS CHARACTER FORMAT "X(25)":U
      736        LABEL "Вид собственности"
      737        VIEW-AS FILL-IN
      738        SIZE 26.25 BY 1 NO-UNDO.
      739   DEFINE VARIABLE f-street AS CHARACTER FORMAT "X(256)":U
      740        LABEL "Улица"
      741        VIEW-AS FILL-IN
      742        SIZE 61.75 BY 1 NO-UNDO.
      743   DEFINE VARIABLE region-code-name AS CHARACTER FORMAT "X(256)":U
      744         VIEW-AS TEXT
      745        SIZE 44.5 BY .67 NO-UNDO.
      746   DEFINE FRAME Dialog-Frame
      747        B-exit AT ROW 1 COL 1
      748        b-quit AT ROW 1 COL 11
      749        B-Help AT ROW 1 COL 91
      750        f-post AT ROW 3.13 COL 2 NO-LABEL WIDGET-ID 22
      751        f-sobstv AT ROW 4.5 COL 1.38 WIDGET-ID 24
      752        f-country AT ROW 4.5 COL 50.25 WIDGET-ID 2
      753        f-index AT ROW 4.5 COL 76.25 WIDGET-ID 4
      754        f-region-code AT ROW 5.96 COL 1.25 WIDGET-ID 6
      755        btn-region-code AT ROW 6.04 COL 28.5 WIDGET-ID 50
      756        f-area AT ROW 7.33 COL 1.5 WIDGET-ID 8
      757        f-city2 AT ROW 8.88 COL 47.75 WIDGET-ID 12
      758        f-city AT ROW 8.92 COL 1.38 WIDGET-ID 10
      759        f-street AT ROW 10.38 COL 1 WIDGET-ID 14
      760        f-house AT ROW 11.92 COL 2.13 WIDGET-ID 16
      761        f-litera AT ROW 11.92 COL 29 COLON-ALIGNED WIDGET-ID 28
      762        f-case AT ROW 11.92 COL 47.88 WIDGET-ID 18
      763        f-apartment AT ROW 11.92 COL 73.25 WIDGET-ID 20
      764        f-f-direcotr AT ROW 13.38 COL 24 COLON-ALIGNED NO-LABEL WIDGET-ID 38
      765        f-i-direcotr AT ROW 13.38 COL 50 COLON-ALIGNED NO-LABEL WIDGET-ID 40
      766        f-o-direcotr AT ROW 13.38 COL 76 COLON-ALIGNED NO-LABEL WIDGET-ID 42
      767        f-f-accountant AT ROW 14.54 COL 24 COLON-ALIGNED NO-LABEL WIDGET-ID 44
      768        f-i-accountant AT ROW 14.54 COL 50 COLON-ALIGNED NO-LABEL WIDGET-ID 46
      769        f-o-accountant AT ROW 14.54 COL 76 COLON-ALIGNED NO-LABEL WIDGET-ID 48
      770        region-code-name AT ROW 6.21 COL 30.88 COLON-ALIGNED NO-LABEL WIDGET-ID 52
      771        "Наименование объекта/организации" VIEW-AS TEXT
      772             SIZE 51 BY .63 AT ROW 2.33 COL 2 WIDGET-ID 26
      773        "Ф.И.О. Руководителя" VIEW-AS TEXT
      774             SIZE 22 BY .96 AT ROW 13.38 COL 2 WIDGET-ID 36
      775        "Ф.И.О. Бухгалтера" VIEW-AS TEXT
      776             SIZE 22 BY .96 AT ROW 14.54 COL 2 WIDGET-ID 30
      777        SPACE(83.79) SKIP(0.68)
      778       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      779            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      780            TITLE "Реквизиты для алкогольной декларации"
      781            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      782   ASSIGN
      783          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      784          FRAME Dialog-Frame:HIDDEN           = TRUE.
      785   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      786   DO:
      787     APPLY "END-ERROR":U TO SELF.
      788   END.
      789   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      790   DO:
      791       ASSIGN
      792           f-post
      793           f-sobstv
      794           f-country
      795           f-index
      796           f-region-code
      797                   region-code-name
      798           f-area
      799           f-city
      800           f-city2
      801           f-street
      802           f-house
      803           f-case
      804           f-apartment
      805           f-litera
      806           f-f-direcotr
      807           f-i-direcotr
      808           f-o-direcotr
      809           f-f-accountant
      810           f-i-accountant
      811           f-o-accountant.
      812       p-value = f-post + "|" + f-sobstv + "|" .
      813       if f-country <> 0 then p-value = p-value + string (f-country, "999") + "|" .
      814       else p-value = p-value + "|" .
      815       if f-index <> 0 then p-value = p-value + string (f-index, "999999") + "|" .
      816       else p-value = p-value + "|" .
      817       if f-region-code <> 0 then p-value = p-value + string (f-region-code, "99") + "|" .
      818       else p-value = p-value + "|" .
      819       p-value = p-value + f-area + "|" + f-city + "|" + f-city2 + "|" + f-street + "|" + f-house  + "|" + f-case + "|" .
      820       if f-apartment <> 0 then p-value = p-value + string (f-apartment) + "|".
      821       else p-value = p-value + "|" .
      822       p-value = p-value + f-litera + "|".
      823       p-value = p-value + f-f-direcotr + "|" + f-i-direcotr + "|" + f-o-direcotr
      824                         + "|" + f-f-accountant + "|" + f-i-accountant + "|" + f-o-accountant.
      825   END.
      826   ON CHOOSE OF btn-region-code IN FRAME Dialog-Frame
      827   do:
      828     RUN proc-btn-region-code IN THIS-PROCEDURE NO-ERROR.
      829     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      830   end.
      831   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      832   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      833   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      834   on help of frame Dialog-Frame
      835   do:
      836     run gbl/app_help.p
      837       (input this-procedure :file-name
      838       ,input ''
      839       ,input ?
      840       ) no-error.
      841     if error-status :error then do:
      842       message
      843         "Ошибка при вызове помощи"
      844         error-status :get-message(1)
      845         view-as alert-box .
      846     end.
      847   end.
      848   run minbtn-set in this-procedure .
      849   on choose of b-help in frame Dialog-Frame
      850   do:
      851     apply "help":u to frame Dialog-Frame .
      852   end.
      853   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   procedure minbtn-set :
      855       do
      856           on error undo, return error return-value
      857           :
      858           define variable ii              as integer       no-undo .
      859           define variable fh              as widget-handle no-undo .
      860           define variable hh              as widget-handle no-undo .
      861           define variable v-h             as handle        extent 4 no-undo .
      862           define variable v-name-button   as character     no-undo .
      863           define variable v-help-old-x    as decimal       no-undo .
      864           define variable v-help-old-y    as decimal       no-undo .
      865           define variable v-help-old-size as decimal       no-undo .
      866           define variable v-frame-width   as decimal       no-undo .
      867           define variable jj              as integer       no-undo .
      868           do
      869               on error undo, return error
      870               :
      871               assign
      872                   v-frame-width = frame Dialog-Frame:width - 0.3
      873                   fh            = frame Dialog-Frame:first-child
      874                   hh            = fh:first-child
      875                   ii            = 1
      876                   .
      877               do while valid-handle(hh):
      878                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      879                   do:
      880                       case lc(hh:name) :
      881                           when "b-help" then
      882                               do:
      883                                   hh:load-image-up("cmp/b-help.bmp":u) .
      884                                   hh:load-image-down("cmp/b-help.bmp":u) .
      885                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      886                                   hh:TOOLTIP = "Помощь" .
      887                                   v-help-old-x = hh:column .
      888                                   v-help-old-y = hh:row    .
      889                                   v-help-old-size = hh:width .
      890                                   hh:width-chars = 2.5 .
      891                               end.
      892                           when "b-print" then
      893                               do:
      894                                   hh:load-image("cmp/b-print.bmp":u) .
      895                                   hh:TOOLTIP = "Печать" .
      896                                   v-h[ii] = hh:handle .
      897                                   ii = ii + 1 .
      898                                   hh:width-chars = 3 .
      899                               end.
      900                           when "b-history" or
      901                           when "b-hist" then
      902                               do:
      903                                   hh:load-image("cmp/b-hist.bmp":u) .
      904                                   hh:TOOLTIP = "История" .
      905                                   v-h[ii] = hh:handle .
      906                                   ii = ii + 1 .
      907                                   hh:width-chars = 3 .
      908                               end.
      909                           when "b-sch" then
      910                               do:
      911                                   hh:load-image("cmp/b-sch.bmp":u) .
      912                                   hh:TOOLTIP = "Установка Фильтра" .
      913                                   v-h[ii] = hh:handle .
      914                                   ii = ii + 1 .
      915                                   hh:width-chars = 3 .
      916                               end.
      917                           when "b-hist-user" then
      918                               do:
      919                                   hh:load-image("cmp/b-hist.bmp":u) .
      920                                   hh:TOOLTIP = "История пользователя" .
      921                                   ii = ii + 1 .
      922                               end.
      923                       end case.
      924                   end.
      925                   hh = hh:next-sibling.
      926               end.
      927               b-help:column = v-frame-width - b-help:width-chars.
      928               jj = 0.
      929               repeat ii = 4 to 1 by -1 :
      930                   if valid-handle (v-h[ii] ) then
      931                   do:
      932                       jj  = jj + 1 .
      933                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      934                       v-h[ii]:row    = v-help-old-y .
      935                   end.
      936               end.
      937           end.
      938       end.
      939   end procedure.
      940   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   ON TAB ANYWHERE
      942   DO:
      943   define variable ii as integer no-undo .
      944   define variable fh as widget-handle no-undo .
      945   define variable hh as widget-handle no-undo .
      946   define variable v-next-widget-name as character no-undo .
      947   if v-tab-order <> '' then do:
      948     if self:type = "TOGGLE-BOX" then
      949     self:BGCOLOR = ?.
      950     assign
      951     ii = lookup(self:name, v-tab-order).
      952     assign
      953     ii = ii + 1
      954     v-next-widget-name = entry(ii, v-tab-order)
      955     no-error .
      956     if error-status:error then do:
      957       assign
      958       ii = 1
      959       v-next-widget-name = entry( ii, v-tab-order)
      960       .
      961     end.
      962     assign
      963     fh = frame Dialog-Frame:first-child
      964     hh = fh:first-child
      965     .
      966     do while valid-handle(hh):
      967       if hh:name = v-next-widget-name then do:
      968         if hh:sensitive  = yes
      969         AND hh:visible = yes then do:
      970           if hh:type = "TOGGLE-BOX":U then do:
      971             assign
      972             hh:BGcolor = 1
      973             .
      974           end.
      975           APPLY "ENTRY" to hh.
      976           return no-apply.
      977         end.
      978         else do:
      979           APPLY "TAB" to hh.
      980           return no-apply.
      981         end.
      982       end.
      983       hh = hh:next-sibling.
      984     end.
      985   end.
      986   END.
      987   ON BACK-TAB ANYWHERE
      988   DO:
      989   define variable ii as integer no-undo .
      990   define variable fh as widget-handle no-undo .
      991   define variable hh as widget-handle no-undo .
      992   define variable v-next-widget-name as character no-undo .
      993   if v-tab-order <> '' then do:
      994     assign
      995     ii = lookup(self:name, v-tab-order).
      996     .
      997     assign
      998     ii = (if ii = 1
      999           then  num-entries(v-tab-order)
     1000           else ii - 1
     1001           )
     1002     v-next-widget-name = entry(ii, v-tab-order)
     1003     .
     1004     assign
     1005     fh = frame Dialog-Frame:first-child
     1006     hh = fh:first-child
     1007     .
     1008     do while valid-handle(hh):
     1009       if hh:name = v-next-widget-name then do:
     1010         if hh:sensitive  = yes
     1011         AND hh:visible = yes then do:
     1012           if hh:type = "TOGGLE-BOX":U then do:
     1013             assign
     1014             hh:BGcolor = 1
     1015             .
     1016           end.
     1017           APPLY "ENTRY" to hh.
     1018           return no-apply.
     1019         end.
     1020         else do:
     1021         APPLY "BACK-TAB" to hh.
     1022         return no-apply.
     1023         end.
     1024       end.
     1025       hh = hh:next-sibling.
     1026     end.
     1027     end.
     1028   END.
     1029   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   ON RETURN ANYWHERE
     1031   DO:
     1032   define variable ii as integer no-undo .
     1033   define variable fh as widget-handle no-undo .
     1034   define variable hh as widget-handle no-undo .
     1035   define variable v-next-widget-name as character no-undo .
     1036     if v-tab-order <> '' then do:
     1037       assign
     1038       ii = lookup(self:name, v-tab-order).
     1039       if ii = num-entries(v-tab-order) then do:
     1040           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1041           return no-apply.
     1042       end.
     1043       if self:type <> "BUTTON" and
     1044         self:type <> "EDITOR"  then do:
     1045         run proc-move-forward in this-procedure .
     1046         return no-apply.
     1047       end.
     1048       if self:type = "BUTTON" then do:
     1049         APPLY "CHOOSE" to self.
     1050       end.
     1051       if self:type = "TOGGLE-BOX" then
     1052       self:BGCOLOR = ?.
     1053       assign
     1054       ii = ii + 1
     1055       v-next-widget-name = entry(ii, v-tab-order)
     1056       no-error .
     1057       if error-status:error then do:
     1058         assign
     1059         ii = 1
     1060         v-next-widget-name = entry( ii, v-tab-order)
     1061         .
     1062       end.
     1063       assign
     1064       fh = frame Dialog-Frame:first-child
     1065       hh = fh:first-child
     1066       .
     1067       do while valid-handle(hh):
     1068         if hh:name = v-next-widget-name then do:
     1069           if hh:sensitive  = yes
     1070           AND hh:visible = yes then do:
     1071             if hh:type = "TOGGLE-BOX":U then do:
     1072               assign
     1073               hh:BGcolor = 1
     1074               .
     1075             end.
     1076             APPLY "ENTRY" to hh.
     1077             return no-apply.
     1078           end.
     1079           else do:
     1080             APPLY "TAB" to hh.
     1081             return no-apply.
     1082           end.
     1083         end.
     1084         hh = hh:next-sibling.
     1085       end.
     1086     end.
     1087   END.
     1088   procedure proc-move-forward :
     1089   define variable ii as integer no-undo .
     1090   define variable fh as widget-handle no-undo .
     1091   define variable hh as widget-handle no-undo .
     1092   define variable v-next-widget-name as character no-undo .
     1093   do
     1094   on error undo, return error
     1095   :
     1096     if v-tab-order <> '' then do:
     1097       if self:type = "TOGGLE-BOX" then
     1098       self:BGCOLOR = ?.
     1099       assign
     1100       ii = lookup(self:name, v-tab-order).
     1101       assign
     1102       ii = ii + 1
     1103       v-next-widget-name = entry(ii, v-tab-order)
     1104       no-error .
     1105       if error-status:error then do:
     1106         assign
     1107         ii = 1
     1108         v-next-widget-name = entry( ii, v-tab-order)
     1109         .
     1110       end.
     1111       assign
     1112       fh = frame Dialog-Frame:first-child
     1113       hh = fh:first-child
     1114       .
     1115       do while valid-handle(hh):
     1116         if hh:name = v-next-widget-name then do:
     1117           if hh:sensitive  = yes
     1118           AND hh:visible = yes then do:
     1119             if hh:type = "TOGGLE-BOX":U then do:
     1120               assign
     1121               hh:BGcolor = 1
     1122               .
     1123             end.
     1124             APPLY "ENTRY" to hh.
     1125             return.
     1126           end.
     1127           else do:
     1128             assign
     1129             ii = ii + 1
     1130             v-next-widget-name = entry(ii, v-tab-order)
     1131             no-error .
     1132             if error-status:error then do:
     1133               assign
     1134               ii = 1
     1135               v-next-widget-name = entry( ii, v-tab-order)
     1136               .
     1137             end.
     1138           end.
     1139         end.
     1140         hh = hh:next-sibling.
     1141       end.
     1142     end.
     1143   end.
     1144   end procedure.
     1145   MAIN-BLOCK:
     1146   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1147      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1148       if p-value = "" or p-value = ? then do:
     1149           find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     1150                                          and   buf_clients.obj-type = p-obj-type no-error.
     1151           assign
     1152               f-post = buf_clients.obj-name.
     1153           run clntattr-value in this-procedure ( input p-obj-type, input p-obj-code, input 'region-code':U, output v-attr-value, output v-attr-type ) .
     1154           assign
     1155               f-region-code = integer (v-attr-value).
     1156           FIND ub.regions WHERE ub.regions.reg-code = f-region-code no-error.
     1157           if f-region-code <> 0 then do:
     1158               DISPLAY ub.regions.reg-name @ region-code-name with frame Dialog-Frame.
     1159               assign
     1160                   region-code-name
     1161               .
     1162           end.
     1163           if p-obj-type = 'орг':U then do:
     1164               find first buf_firm no-lock where buf_firm.firm-code = p-obj-code no-error.
     1165               assign
     1166                   f-index = buf_firm.ind
     1167                   f-f-direcotr = entry(1,buf_firm.director," ")
     1168                   f-i-direcotr = entry(2,buf_firm.director," ")
     1169                   f-o-direcotr = entry(3,buf_firm.director," ") no-error.
     1170           end.
     1171           if p-obj-type = 'орг':U then do:
     1172               find first buf_sysconf no-lock where buf_sysconf.host-code = p-obj-code no-error.
     1173               assign
     1174                   f-f-accountant = entry(1,buf_sysconf.snr-accnt," ")
     1175                   f-i-accountant = entry(2,buf_sysconf.snr-accnt," ")
     1176                   f-o-accountant = entry(3,buf_sysconf.snr-accnt," ") no-error.
     1177           end.
     1178           if p-obj-type = 'чел':U then do:
     1179               find first buf_person no-lock where buf_person.psn-code = p-obj-code no-error.
     1180               assign
     1181                   f-index = buf_person.ind.
     1182           end.
     1183       end.
     1184       else do:
     1185           assign
     1186               f-post         = entry (1,p-value,"|")
     1187               f-sobstv       = entry (2,p-value,"|")
     1188               f-country      = integer (entry (3,p-value,"|"))
     1189               f-index        = integer (entry (4,p-value,"|"))
     1190               f-region-code  = integer (entry (5,p-value,"|"))
     1191               f-area         = entry (6,p-value,"|")
     1192               f-city         = entry (7,p-value,"|")
     1193               f-city2        = entry (8,p-value,"|")
     1194               f-street       = entry (9,p-value,"|")
     1195               f-house        = entry (10,p-value,"|")
     1196               f-case         = entry (11,p-value,"|")
     1197               f-apartment    = integer (entry (12,p-value,"|"))
     1198               f-litera       = entry (13,p-value,"|")
     1199               f-f-direcotr   = entry (14,p-value,"|")
     1200               f-i-direcotr   = entry (15,p-value,"|")
     1201               f-o-direcotr   = entry (16,p-value,"|")
     1202               f-f-accountant = entry (17,p-value,"|")
     1203               f-i-accountant = entry (18,p-value,"|")
     1204               f-o-accountant = entry (19,p-value,"|") no-error.
     1205           FIND ub.regions WHERE ub.regions.reg-code = f-region-code no-error.
     1206           if f-region-code <> 0 then do:
     1207               DISPLAY ub.regions.reg-name @ region-code-name with frame Dialog-Frame.
     1208               assign
     1209                   region-code-name
     1210               .
     1211           end.
     1212       end.
     1213       RUN enable_ui.
     1214       run my_enable.
     1215       WAIT-FOR GO OF FRAME Dialog-Frame.
     1216   END.
     1217   RUN disable_UI.
     1218   PROCEDURE disable_UI :
     1219     HIDE FRAME Dialog-Frame.
     1220   END PROCEDURE.
     1221   PROCEDURE enable_UI :
     1222     DISPLAY f-post f-sobstv f-country f-index f-region-code f-area f-city2 f-city
     1223             f-street f-house f-litera f-case f-apartment f-f-direcotr f-i-direcotr
     1224             f-o-direcotr f-f-accountant f-i-accountant f-o-accountant
     1225             region-code-name
     1226         WITH FRAME Dialog-Frame.
     1227     ENABLE B-exit b-quit B-Help f-post f-sobstv f-country f-index f-region-code
     1228            btn-region-code f-area f-city2 f-city f-street f-house f-litera f-case
     1229            f-apartment f-f-direcotr f-i-direcotr f-o-direcotr f-f-accountant
     1230            f-i-accountant f-o-accountant
     1231         WITH FRAME Dialog-Frame.
     1232     VIEW FRAME Dialog-Frame.
     1233   END PROCEDURE.
     1234   PROCEDURE my_enable :
     1235   if p-obj-type <> 'орг':U then do:
     1236         disable
     1237         f-f-direcotr
     1238         f-i-direcotr
     1239         f-o-direcotr
     1240         f-f-accountant
     1241         f-i-accountant
     1242         f-o-accountant
     1243         with frame Dialog-Frame.
     1244   end.
     1245   end procedure.
     1246   PROCEDURE proc-btn-region-code :
     1247   define variable parparentproc as widget-handle no-undo .
     1248   define variable v-reg-code as integer no-undo .
     1249   run ref/regions.w (
     1250             input parparentproc
     1251            ,input 'выбор':U
     1252            ,output v-reg-code).
     1253   if v-reg-code = ? then  do:
     1254     apply "entry" to f-region-code in frame Dialog-Frame.
     1255     return error.
     1256   end.
     1257   FIND ub.regions WHERE ub.regions.reg-code = v-reg-code no-error.
     1258   if available ub.regions then do:
     1259       DISPLAY ub.regions.reg-code @ f-region-code with frame Dialog-Frame.
     1260       DISPLAY ub.regions.reg-name @ region-code-name with frame Dialog-Frame.
     1261       assign
     1262           f-region-code
     1263           region-code-name
     1264       .
     1265   end.
     1266   END PROCEDURE.
