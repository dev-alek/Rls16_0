      499   procedure clntattr-copy-to :
      500     define input  parameter p-obj-type as character no-undo .
      501     define input  parameter p-obj-code as integer   no-undo .
      502     define input  parameter p-code     as character no-undo .
      503     define input  parameter p-bh       as handle no-undo .
