      757   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      758   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      759   procedure fltopend_fltopend :
      760   define input parameter p-parent-handle as handle no-undo .
      761   define input parameter p-qh as handle no-undo .
      762   define input parameter p-flt-open-open-query  as character no-undo .
      763   define input parameter p-where-cond as character no-undo .
      764   define input parameter p-use-indFIRST-query-tail as character no-undo .
      765   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      766   define input parameter p-indexed-reposition as character no-undo .
      767     do
      768     on error undo, return error
      769     :
      770   define variable v-prepare-string as character no-undo .
      771   define variable glog as logical no-undo .
      772   assign
      773   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      774                      p-where-cond + chr(32)  +
      775                      p-use-indFIRST-query-tail + chr(32) +
      776                      p-use-ind-sort-clmn-by + chr(32) +
      777                      p-indexed-reposition
      778   .
      779   assign
      780   glog = p-qh:query-prepare(v-prepare-string) no-error .
      781   if not glog
      782   or error-status:error then do:
      783     message error-status:get-message(1) view-as alert-box .
      784     undo, return error .
      785   end.
      786   assign
      787   glog = p-qh:query-open no-error .
      788   if not glog
      789   or error-status:error then do:
      790     message error-status:get-message(1) view-as alert-box .
      791     undo, return error .
      792   end.
      793     end.
      794   end procedure.
      795   procedure fltopend_fltfindd :
      796   define input parameter p-parent-handle as handle no-undo .
      797   define input parameter p-qh as handle no-undo .
      798   define input parameter p-rowid as rowid no-undo .
      799   define input parameter p-next as logical no-undo .
      800   define input parameter p-lock as integer no-undo .
      801   define input parameter p-bh as handle no-undo .
      802   define input parameter p-where-cond as character no-undo .
      803   define input parameter p-use-index-phrase as character no-undo .
      804   define variable glog as logical no-undo .
      805   define variable v-qh as handle no-undo .
      806   define variable v-bh as handle no-undo .
      807   define variable v-recid as recid no-undo .
      808   define variable v-prepare-string as character no-undo .
      809   do
      810   on error undo, return error
      811   on stop undo, return error
      812   :
      813     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      814     create buffer v-bh for table p-bh buffer-name p-bh:name.
      815     create query v-qh.
      816     v-qh:set-buffers(v-bh).
      817     v-prepare-string = substitute("for each &1 &2 &3"
      818                                     ,v-bh:name
      819                                     ,p-where-cond
      820                                     ,p-use-index-phrase).
      821     glog = v-qh:query-prepare(v-prepare-string) no-error.
      822     if not glog then do:
      823       delete object v-qh.
      824       delete object v-bh.
      825       undo, return error .
      826     end.
      827     glog = v-qh:query-open no-error .
      828     if not glog then do:
      829       delete object v-qh.
      830       delete object v-bh.
      831       undo, return error .
      832     end.
      833     if p-next then do:
      834       v-qh:reposition-to-rowid(p-rowid) no-error .
      835       glog = v-qh:get-next( p-lock) no-error .
      836       glog = v-qh:get-next( p-lock) no-error .
      837       if not glog or v-qh:query-off-end = yes then do:
      838         glog = v-qh:get-first( p-lock) no-error .
      839       end.
      840     end.
      841     else do:
      842       glog = v-qh:get-first( p-lock) no-error .
      843     end.
      844     v-recid = v-bh:recid no-error .
      845     delete object v-qh.
      846     delete object v-bh.
      847     return string(v-recid) .
      848   end.
      849   end procedure.
      850   procedure fltopend_fltfindq :
      851   define input parameter p-parent-handle as handle no-undo .
      852   define input parameter p-qh as handle no-undo .
      853   define input parameter p-next as logical no-undo .
      854   define input parameter p-lock as integer no-undo .
      855   define input parameter p-flt-open-open-query  as character no-undo .
      856   define input parameter p-where-cond as character no-undo .
      857   define input parameter p-use-indFIRST-query-tail as character no-undo .
      858   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      859   define input parameter p-indexed-reposition as character no-undo .
      860   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      861   define variable glog as logical no-undo .
      862   define variable v-qh as handle no-undo .
      863   define variable v-bh as handle no-undo extent 18.
      864   define variable v-rowid as rowid no-undo extent 18.
      865   define variable v-ii as integer no-undo .
      866   define variable v-prepare-string as character no-undo .
      867   do
      868   on error undo, return error
      869   on stop undo, return error
      870   :
      871     create query v-qh.
      872     do v-ii = 1 to p-qh:num-buffers:
      873       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      874       assign
      875       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      876       no-error.
      877       v-qh:add-buffer(v-bh[v-ii]).
      878     end.
      879     assign
      880     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      881                       p-where-cond + chr(32)  +
      882                       p-use-indFIRST-query-tail + chr(32) +
      883                       p-use-ind-sort-clmn-by + chr(32) +
      884                       p-indexed-reposition
      885     .
      886     glog = v-qh:query-prepare( v-prepare-string) no-error .
      887     if not glog then do:
      888       delete object v-qh.
      889       do v-ii = 1 to p-qh:num-buffers:
      890         delete object v-bh[v-ii].
      891       end.
      892       undo, return error .
      893     end.
      894     glog = v-qh:query-open no-error .
      895     if not glog then do:
      896       delete object v-qh.
      897       do v-ii = 1 to p-qh:num-buffers:
      898         delete object v-bh[v-ii].
      899       end.
      900       undo, return error .
      901     end.
      902     if p-next then do:
      903       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      904       glog = v-qh:get-next( p-lock) no-error .
      905       glog = v-qh:get-next( p-lock) no-error .
      906       if not glog or v-qh:query-off-end = yes then do:
      907         glog = v-qh:get-first( p-lock) no-error .
      908       end.
      909     end.
      910     else do:
      911       glog = v-qh:get-first( p-lock) no-error .
      912     end.
      913     do v-ii = 1 to p-qh:num-buffers:
      914       assign
      915       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      916       no-error.
      917     end.
      918     delete object v-qh.
      919     do v-ii = 1 to p-qh:num-buffers:
      920       delete object v-bh[v-ii].
      921     end.
      922   end.
      923   end procedure.
      924   define variable log-res as log no-undo.
      925   define variable rr as recid no-undo.
      926   define variable jj as integer no-undo .
      927   define variable str as character no-undo.
      928   define variable conf-par as character no-undo.
      929   define variable par-type as character no-undo.
      930   define variable vartbl-name as character no-undo.
      931   define variable varact      as character no-undo.
      932   define variable filter-point0 as character no-undo  init "cscalgds".
      933   define variable filter-point as character no-undo init "cscalgds".
      934   define variable filter-label0 as character no-undo  init "Справочник_истории_товара_на_весах".
      935   define variable filter-label as character no-undo init "Справочник_истории_товара_на_весах".
      936   define variable sort-column-name as character no-undo .
      937   define variable v-doc-rec as recid no-undo .
      938   define variable v-rid-list as character no-undo .
      939   define buffer X_scales-gds for ub.scales-gds.
      940   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   define NEW SHARED temp-table temp-changes no-undo
      942   field f_name as character
      943   field l_name as character
      944   field v_old as character
      945   field v_new as character
      946   field t_name as character
      947   field num_ as integer
      948   field uniq-key-rec as character
      949   field action as integer
      950   field fNotChange as logical
      951   index pi is unique primary
      952   num_
      953   t_name
      954   f_name
      955   index
      956   Chan
      957   fnotChange
      958   t_name
      959   f_name
      960   index imain uniq-key-rec
      961   .
      962   FUNCTION get-all-fields returns character (p-file-name as character ):
      963   define variable v-dop as character no-undo .
      964     find first _file no-lock where _file._file-name = p-file-name no-error .
      965     if not available _file then return "":U.
      966     for each _field no-lock where
      967              _field._file-recid = recid(_file) :
      968       assign
      969       v-dop = v-dop + _field._field-name + chr(44)
      970       .
      971     end.
      972     return trim(v-dop).
      973   END FUNCTION.
      974   PROCEDURE proc-full-temp-changes :
      975     define input  parameter p-act-create as logical   no-undo .
      976     define input  parameter p-act-delete as logical   no-undo .
      977     define input  parameter p-hst-handle as handle    no-undo .
      978     define input  parameter p-main-table as character no-undo .
      979     define input  parameter p-field-list as character no-undo .
      980     define input  parameter p-label-form as character no-undo .
      981     define variable h-new-buf         as handle    no-undo .
      982     define variable h-main-buf        as handle    no-undo .
      983     define variable h-for-comp        as handle    no-undo .
      984     define variable v-inform          as character no-undo .
      985     define variable v-ind             as integer   no-undo .
      986     define variable v-idx-field-qnty  as integer   no-undo .
      987     define variable v-num-entries     as integer   no-undo .
      988     define variable fh                as handle    no-undo .
      989     define variable fh-main           as handle    no-undo .
      990     define variable fh-old            as handle    no-undo .
      991     define variable fh-new            as handle    no-undo .
      992     define variable v-field-name      as character no-undo .
      993     define variable v-field-lvl       as character no-undo .
      994     define variable v-field-form      as character no-undo .
      995     define variable v-search-exp      as character no-undo .
      996     define variable v-srch-main       as character no-undo .
      997     define variable v-word-link       as character no-undo .
      998     define variable v-av-chip-num     as logical   no-undo .
      999     define variable v-main-pi-fld-lst as character no-undo .
     1000     define variable v-main-fld-lst    as character no-undo .
     1001     define variable v-delim-list      as character no-undo .
     1002     define variable v-label           as character no-undo .
     1003     define variable v-old-value       as character no-undo case-sensitive.
     1004     define variable v-new-value       as character no-undo case-sensitive.
     1005     define variable v-chg-fields as character no-undo.
     1006     for each temp-changes:
     1007       delete temp-changes.
     1008     end.
     1009     if not p-hst-handle:available then do:
     1010       return .
     1011     end.
     1012     create buffer h-new-buf  for table p-hst-handle .
     1013     create buffer h-main-buf for table p-main-table .
     1014     assign
     1015       v-inform = h-main-buf:index-information(1)
     1016       v-ind    = 2
     1017     .
     1018     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1019     on error undo, return error
     1020     :
     1021       assign
     1022         v-inform = h-main-buf:index-information( v-ind )
     1023         v-ind    = v-ind + 1
     1024       .
     1025     end.
     1026     if v-inform = ?
     1027       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1028       or entry( 3, v-inform, ",":U ) <> "1":U
     1029     then do:
     1030       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1031     end.
     1032     assign
     1033       v-idx-field-qnty = num-entries( v-inform ) - 4
     1034     .
     1035     if v-idx-field-qnty < 2 then do:
     1036       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1037     end.
     1038     assign
     1039       v-srch-main   = "where":U
     1040       v-word-link   = "":U
     1041       v-av-chip-num = false
     1042       v-delim-list  = "":U
     1043     .
     1044     do v-ind = 1 to v-idx-field-qnty by 2
     1045     on error undo, return error
     1046     :
     1047       assign
     1048         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1049         fh                = p-hst-handle:buffer-field( v-field-name )
     1050         fh-main           = h-main-buf:buffer-field( v-field-name )
     1051         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1052         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1053       .
     1054       if fh:data-type ="character":U then do:
     1055         assign
     1056           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1057         .
     1058       end.
     1059       else do:
     1060         assign
     1061           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1062         .
     1063       end.
     1064       if v-delim-list = "":U then do:
     1065         assign
     1066           v-delim-list = ",":U
     1067         .
     1068       end.
     1069       if v-word-link = "":U then do:
     1070         assign
     1071           v-word-link = "and":U
     1072         .
     1073       end.
     1074     end.
     1075     assign
     1076       v-delim-list  = "":U
     1077     .
     1078     do v-ind = 1 to h-main-buf:num-fields
     1079     on error undo, return error
     1080     :
     1081       assign
     1082         fh-main      = h-main-buf:buffer-field( v-ind )
     1083         v-field-name = fh-main:name
     1084       .
     1085         assign
     1086           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1087         .
     1088         if v-delim-list = "":U then do:
     1089           assign
     1090             v-delim-list = ",":U
     1091           .
     1092         end.
     1093     end.
     1094     assign
     1095       v-inform = p-hst-handle:index-information(1)
     1096       v-ind    = 2
     1097     .
     1098     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1099     on error undo, return error
     1100     :
     1101       assign
     1102         v-inform = p-hst-handle:index-information( v-ind )
     1103         v-ind    = v-ind + 1
     1104       .
     1105     end.
     1106     if v-inform = ?
     1107       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1108       or entry( 3, v-inform, ",":U ) <> "1":U
     1109     then do:
     1110       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1111     end.
     1112     assign
     1113       v-idx-field-qnty = num-entries( v-inform ) - 4
     1114     .
     1115     if v-idx-field-qnty < 2 then do:
     1116       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1117     end.
     1118     assign
     1119       v-search-exp  = "where":U
     1120       v-word-link   = "":U
     1121       v-av-chip-num = false
     1122     .
     1123     do v-ind = 1 to v-idx-field-qnty by 2
     1124     on error undo, return error
     1125     :
     1126       assign
     1127         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1128         fh           = p-hst-handle:buffer-field( v-field-name )
     1129         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1130       .
     1131       if v-field-name = "chip-num":U then do:
     1132         assign
     1133           v-search-exp  = substitute( "&1 >", v-search-exp )
     1134           v-av-chip-num = true
     1135         .
     1136       end.
     1137       else do:
     1138         assign
     1139           v-search-exp = substitute( "&1 =", v-search-exp )
     1140         .
     1141       end.
     1142       if fh:data-type ="character":U then do:
     1143         assign
     1144           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1145         .
     1146       end.
     1147       else do:
     1148         assign
     1149           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1150         .
     1151       end.
     1152       if v-word-link = "":U then do:
     1153         assign
     1154           v-word-link = "and":U
     1155         .
     1156       end.
     1157     end.
     1158     if v-av-chip-num = false then do:
     1159       message
     1160         vss-workfile vss-revision vss-description skip
     1161         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1162         "Использование данной процедуры невозможно!" skip
     1163         view-as alert-box error .
     1164       return error .
     1165     end.
     1166     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1167     if not h-new-buf:available then do:
     1168       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1169       if not h-main-buf:available then do:
     1170         assign
     1171           h-for-comp = ?
     1172         .
     1173       end.
     1174       else do:
     1175         assign
     1176           h-for-comp = h-main-buf
     1177         .
     1178       end.
     1179     end.
     1180     else do:
     1181       assign
     1182         h-for-comp = h-new-buf
     1183       .
     1184     end.
     1185     assign
     1186       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1187     .
     1188     do v-ind = 1 to v-num-entries
     1189     on error undo, return error return-value
     1190     :
     1191       assign
     1192         v-field-name = entry( v-ind, v-main-fld-lst )
     1193         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1194         v-old-value  = fh-old:buffer-value()
     1195         v-label      = trim( fh-old:label )
     1196       .
     1197       if ( trim( p-field-list ) <> "":U
     1198            and lookup( v-field-name, p-field-list ) > 0
     1199          )
     1200          or trim( p-field-list ) = "":U
     1201       then do:
     1202         if h-for-comp <> ? then do:
     1203           assign
     1204             fh-new      = h-for-comp:buffer-field( v-field-name )
     1205             v-new-value = fh-new:buffer-value()
     1206           .
     1207         end.
     1208         else do:
     1209           assign
     1210             v-new-value = "":U
     1211           .
     1212         end.
     1213           if p-act-create = true then do:
     1214             assign
     1215               v-old-value = "":U
     1216             .
     1217           end.
     1218           if p-act-delete = true then do:
     1219             assign
     1220               v-new-value = "":U
     1221             .
     1222           end.
     1223         if v-old-value <> v-new-value
     1224         then do:
     1225           create temp-changes.
     1226           assign
     1227             temp-changes.t_name = p-main-table
     1228             temp-changes.f_name = v-field-name
     1229             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1230             temp-changes.v_old  = trim( v-old-value )
     1231             temp-changes.v_new  = trim( v-new-value )
     1232             temp-changes.num_   = 0
     1233             temp-changes.fNotChange = v-old-value eq v-new-value
     1234           .
     1235         end.
     1236       end.
     1237     end.
     1238     assign
     1239       v-num-entries = num-entries( p-label-form, chr(8) )
     1240     .
     1241     do v-ind = 1 to v-num-entries
     1242     on error undo, return error return-value
     1243     :
     1244       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1245         assign
     1246           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1247           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1248           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1249         .
     1250         find first temp-changes
     1251           where temp-changes.f_name = v-field-name
     1252           no-error .
     1253         if available temp-changes then do:
     1254           if trim( v-field-lvl ) <> "":U then do:
     1255             assign
     1256               temp-changes.l_name = v-field-lvl
     1257             .
     1258           end.
     1259           if trim( v-field-form ) <> "":U then do:
     1260             assign
     1261               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1262             .
     1263             if h-for-comp <> ? then do:
     1264               assign
     1265                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1266               .
     1267             end.
     1268           end.
     1269         end.
     1270       end.
     1271       else do:
     1272         message
     1273           vss-workfile vss-revision vss-description skip
     1274           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1275           substitute( "список для поля '&1': '&2'"
     1276                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1277                       ,entry( v-ind, p-label-form, chr(8) )
     1278                     ) skip
     1279           substitute( "полный список: &2", p-label-form ) skip
     1280           view-as alert-box error .
     1281       end.
     1282     end.
     1283     delete object h-new-buf .
     1284     delete object h-main-buf .
     1285   END PROCEDURE.
     1286   FUNCTION get-action RETURNS CHARACTER
     1287     ( INPUT p-action AS INTEGER )  FORWARD.
     1288   DEFINE BUTTON B-Help
     1289        LABEL "Помо&щь"
     1290        SIZE 3 BY 1
     1291        BGCOLOR 8 .
     1292   DEFINE BUTTON B-mark
     1293        LABEL "&*"
     1294        SIZE 3 BY 1.
     1295   DEFINE BUTTON b-quit AUTO-END-KEY
     1296        LABEL "&Выход"
     1297        SIZE 10 BY 1
     1298        BGCOLOR 8 .
     1299   DEFINE BUTTON B-sch
     1300        LABEL "&Фильтр"
     1301        SIZE 3 BY 1.
     1302   DEFINE BUTTON b-sel AUTO-GO
     1303        LABEL "Вы&бор"
     1304        SIZE 10 BY 1.
     1305   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1306        VIEW-AS FILL-IN
     1307        SIZE 9 BY 1
     1308        FGCOLOR 4  NO-UNDO.
     1309   DEFINE QUERY BR-c-scales-gds FOR
     1310         X_c-scales-gds,
     1311         X_c-scales SCROLLING.
     1312   DEFINE QUERY BR-changes FOR
     1313         temp-changes SCROLLING.
     1314   DEFINE BROWSE BR-c-scales-gds
     1315     QUERY BR-c-scales-gds NO-LOCK DISPLAY
     1316         mark-string( recid(X_c-scales-gds), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1317   X_c-scales-gds.corr-user-db-num COLUMN-LABEL "БД" FORMAT ">>>>9":U
     1318   X_c-scales-gds.scales-num COLUMN-LABEL "Весы" FORMAT ">>>>9":U
     1319   X_c-scales-gds.PLU-code COLUMN-LABEL "PLU" FORMAT ">>>>9":U
     1320   get-action(X_c-scales.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1321   X_c-scales-gds.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
     1322   usrfulnf(X_c-scales-gds.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1323   string(X_c-scales-gds.corr-time, "HH:MM")
     1324       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.33.
     1325   DEFINE BROWSE BR-changes
     1326     QUERY BR-changes DISPLAY
     1327         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(30)"
     1328   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1329   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1330       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1331   DEFINE FRAME Dialog-Frame
     1332        b-quit AT ROW 1 COL 1
     1333        B-mark AT ROW 1 COL 11
     1334        b-sel AT ROW 1 COL 14
     1335        B-sch AT ROW 1 COL 92
     1336        B-Help AT ROW 1 COL 95
     1337        mark-num AT ROW 2.25 COL 9 COLON-ALIGNED NO-LABEL
     1338        BR-c-scales-gds AT ROW 3.42 COL 1
     1339        BR-changes AT ROW 16.04 COL 1
     1340        SPACE(0.24) SKIP(0.00)
     1341       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1342            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1343            TITLE "Справочник истории товара на весах"
     1344            CANCEL-BUTTON b-quit.
     1345   ASSIGN
     1346          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1347          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1348   ON GO OF FRAME Dialog-Frame
     1349   DO:
     1350     p-rid-list = v-rid-list.
     1351   END.
     1352   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1353   DO:
     1354     APPLY "END-ERROR":U TO SELF.
     1355   END.
     1356   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1357   DO:
     1358   define variable glog as logical no-undo .
     1359    if not available X_c-scales-gds then return no-apply.
     1360   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361   define variable v-str-recid13 as character no-undo .
     1362   define variable v-num-entry13 as integer   no-undo .
     1363   assign
     1364     v-str-recid13 = trim( string( recid( X_c-scales-gds ) , "->>>>>>>>>>>9":U ) )
     1365     v-num-entry13 = lookup( v-str-recid13 , v-rid-list )
     1366   .
     1367   if v-num-entry13 > 0 then do:
     1368     assign
     1369       entry( v-num-entry13, v-rid-list ) = "":U
     1370       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1371     .
     1372   end.
     1373   else do:
     1374     assign
     1375       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid13
     1376     .
     1377   end.
     1378    glog = br-c-scales-gds :refresh( )  in frame Dialog-Frame.
     1379     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1380       glog = br-c-scales-gds:select-next-row () in frame Dialog-Frame.
     1381       apply "value-changed" to br-c-scales-gds in frame Dialog-Frame.
     1382     end.
     1383     if num-entries (v-rid-list) = 0 then
     1384         hide mark-num in frame Dialog-Frame.
     1385     else
     1386     disp num-entries (v-rid-list) @ mark-num
     1387     with frame Dialog-Frame.
     1388     apply "entry" to br-c-scales-gds in frame Dialog-Frame.
     1389   END.
     1390   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1391   DO:
     1392     run proc-b-sch in this-procedure no-error.
     1393     if error-status:error then return no-apply.
     1394   END.
     1395   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1396   DO:
     1397       if ( available X_c-scales-gds ) AND ( v-rid-list = "" ) then
     1398           v-rid-list = string( recid( X_c-scales-gds ) ) .
     1399   END.
     1400   ON RETURN OF BR-c-scales-gds IN FRAME Dialog-Frame
     1401   DO:
     1402         apply "DEFAULT-ACTION":U to self.
     1403   END.
     1404   ON VALUE-CHANGED OF BR-c-scales-gds IN FRAME Dialog-Frame
     1405   DO:
     1406     run proc-view-changes in this-procedure no-error.
     1407   END.
     1408   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1409   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1410   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   on help of frame Dialog-Frame
     1412   do:
     1413     run gbl/app_help.p
     1414       (input this-procedure :file-name
     1415       ,input ''
     1416       ,input ?
     1417       ) no-error.
     1418     if error-status :error then do:
     1419       message
     1420         "Ошибка при вызове помощи"
     1421         error-status :get-message(1)
     1422         view-as alert-box .
     1423     end.
     1424   end.
     1425   run minbtn-set in this-procedure .
     1426   on choose of b-help in frame Dialog-Frame
     1427   do:
     1428     apply "help":u to frame Dialog-Frame .
     1429   end.
     1430   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1431   procedure minbtn-set :
     1432       do
     1433           on error undo, return error return-value
     1434           :
     1435           define variable ii              as integer       no-undo .
     1436           define variable fh              as widget-handle no-undo .
     1437           define variable hh              as widget-handle no-undo .
     1438           define variable v-h             as handle        extent 4 no-undo .
     1439           define variable v-name-button   as character     no-undo .
     1440           define variable v-help-old-x    as decimal       no-undo .
     1441           define variable v-help-old-y    as decimal       no-undo .
     1442           define variable v-help-old-size as decimal       no-undo .
     1443           define variable v-frame-width   as decimal       no-undo .
     1444           define variable jj              as integer       no-undo .
     1445           do
     1446               on error undo, return error
     1447               :
     1448               assign
     1449                   v-frame-width = frame Dialog-Frame:width - 0.3
     1450                   fh            = frame Dialog-Frame:first-child
     1451                   hh            = fh:first-child
     1452                   ii            = 1
     1453                   .
     1454               do while valid-handle(hh):
     1455                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1456                   do:
     1457                       case lc(hh:name) :
     1458                           when "b-help" then
     1459                               do:
     1460                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1461                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1462                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1463                                   hh:TOOLTIP = "Помощь" .
     1464                                   v-help-old-x = hh:column .
     1465                                   v-help-old-y = hh:row    .
     1466                                   v-help-old-size = hh:width .
     1467                                   hh:width-chars = 2.5 .
     1468                               end.
     1469                           when "b-print" then
     1470                               do:
     1471                                   hh:load-image("cmp/b-print.bmp":u) .
     1472                                   hh:TOOLTIP = "Печать" .
     1473                                   v-h[ii] = hh:handle .
     1474                                   ii = ii + 1 .
     1475                                   hh:width-chars = 3 .
     1476                               end.
     1477                           when "b-history" or
     1478                           when "b-hist" then
     1479                               do:
     1480                                   hh:load-image("cmp/b-hist.bmp":u) .
     1481                                   hh:TOOLTIP = "История" .
     1482                                   v-h[ii] = hh:handle .
     1483                                   ii = ii + 1 .
     1484                                   hh:width-chars = 3 .
     1485                               end.
     1486                           when "b-sch" then
     1487                               do:
     1488                                   hh:load-image("cmp/b-sch.bmp":u) .
     1489                                   hh:TOOLTIP = "Установка Фильтра" .
     1490                                   v-h[ii] = hh:handle .
     1491                                   ii = ii + 1 .
     1492                                   hh:width-chars = 3 .
     1493                               end.
     1494                           when "b-hist-user" then
     1495                               do:
     1496                                   hh:load-image("cmp/b-hist.bmp":u) .
     1497                                   hh:TOOLTIP = "История пользователя" .
     1498                                   ii = ii + 1 .
     1499                               end.
     1500                       end case.
     1501                   end.
     1502                   hh = hh:next-sibling.
     1503               end.
     1504               b-help:column = v-frame-width - b-help:width-chars.
     1505               jj = 0.
     1506               repeat ii = 4 to 1 by -1 :
     1507                   if valid-handle (v-h[ii] ) then
     1508                   do:
     1509                       jj  = jj + 1 .
     1510                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1511                       v-h[ii]:row    = v-help-old-y .
     1512                   end.
     1513               end.
     1514           end.
     1515       end.
     1516   end procedure.
     1517   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1518   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1519   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1520   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1521   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1522   define variable v-diasize-current-frame-height as decimal   no-undo .
     1523   define variable v-diasize-change-size          as logical   no-undo .
     1524   define variable v-diasize-resize-button        as handle    no-undo .
     1525   define variable v-diasize-wndmax               as logical   no-undo .
     1526   define variable v-diasize-wndstore             as logical   no-undo .
     1527   define variable v-diasize-proc-name            as character no-undo .
     1528   define variable v-diasize-browse-handle        as handle    no-undo .
     1529   define variable v-diasize-browse-number        as integer   no-undo .
     1530   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1531   define temp-table temp-diasize-handle no-undo
     1532     field handle-value  as handle
     1533     field save-position as decimal
     1534     index xpk is primary unique handle-value
     1535     .
     1536   define temp-table temp-browse-handle no-undo
     1537     field browse-type   as character
     1538     field browse-number as integer
     1539     field browse-handle as handle
     1540     field original-size as decimal
     1541     index xpk is primary unique browse-type browse-number
     1542     index xie browse-type browse-handle
     1543   .
     1544   procedure diasize_change-height :
     1545     define input  parameter p-change-value  as decimal   no-undo .
     1546     define input  parameter p-move-resize   as logical   no-undo .
     1547     define variable v-field-group-handle    as handle    no-undo .
     1548     define variable v-object-handle         as handle    no-undo .
     1549     define variable v-frame-height          as decimal   no-undo .
     1550     define variable v-frame-virtual-height  as decimal   no-undo .
     1551     define variable v-browse-height         as decimal   no-undo .
     1552     define variable v-window-height         as decimal   no-undo .
     1553     define variable v-window-virtual-height as decimal   no-undo .
     1554     define variable v-change-sign           as integer   no-undo .
     1555     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1556     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1557     if p-change-value > 0
     1558     then do:
     1559       if frame Dialog-Frame :height + p-change-value
     1560           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1561       then do:
     1562         assign
     1563           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1564                           - (frame Dialog-Frame :height-chars)
     1565         .
     1566         if p-change-value <= 0
     1567         then do:
     1568           run diasize_position-resize-button in this-procedure .
     1569           return .
     1570         end.
     1571       end.
     1572     end.
     1573     if p-change-value < 0
     1574     then do:
     1575       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1576       then do:
     1577         assign
     1578           p-change-value = v-diasize-orig-frame-height
     1579                          - (frame Dialog-Frame :height-chars)
     1580         .
     1581         if p-change-value >= 0
     1582         then do:
     1583           run diasize_position-resize-button in this-procedure .
     1584           return .
     1585         end.
     1586       end.
     1587     end.
     1588     if p-change-value >= 0
     1589     then do:
     1590       assign
     1591         v-change-sign = 1
     1592       .
     1593     end.
     1594     else do:
     1595       assign
     1596         v-change-sign = -1
     1597       .
     1598     end.
     1599     assign
     1600       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1601     .
     1602     if p-change-value = 0
     1603     then do:
     1604       run diasize_position-resize-button in this-procedure .
     1605       return .
     1606     end.
     1607     move_block:
     1608     do
     1609     on error undo move_block, retry move_block
     1610     :
     1611       if retry
     1612       then do:
     1613         do
     1614         on error undo move_block, leave move_block
     1615         :
     1616           if p-change-value > 0
     1617           then do:
     1618             for each buf_temp-diasize-handle
     1619             on error undo, next
     1620             :
     1621               assign
     1622                 v-object-handle = buf_temp-diasize-handle.handle-value
     1623               .
     1624               if v-object-handle <> v-diasize-resize-button
     1625               then do:
     1626                 assign
     1627                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1628                 .
     1629               end.
     1630             end.
     1631             assign
     1632               v-diasize-browse-handle :height = v-browse-height
     1633             .
     1634             for each buf_temp-browse-handle
     1635               where buf_temp-browse-handle.browse-type = 'height':u
     1636             on error undo, next
     1637             :
     1638               assign
     1639                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1640               .
     1641             end.
     1642             assign
     1643               frame Dialog-Frame :height = v-frame-height
     1644             .
     1645             if frame Dialog-Frame :scrollable = true
     1646             then do:
     1647               assign
     1648                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1649               .
     1650             end.
     1651             run diasize_position-resize-button in this-procedure .
     1652           end.
     1653           else do:
     1654             if frame Dialog-Frame :scrollable = true
     1655             then do:
     1656               assign
     1657                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1658               .
     1659             end.
     1660             assign
     1661               frame Dialog-Frame :height = v-frame-height
     1662             .
     1663             assign
     1664               v-diasize-browse-handle :height = v-browse-height
     1665             .
     1666             for each buf_temp-browse-handle
     1667               where buf_temp-browse-handle.browse-type = 'height':u
     1668             on error undo, next
     1669             :
     1670               assign
     1671                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1672               .
     1673             end.
     1674             for each buf_temp-diasize-handle
     1675             on error undo, next
     1676             :
     1677               assign
     1678                 v-object-handle = buf_temp-diasize-handle.handle-value
     1679               .
     1680               if v-object-handle <> v-diasize-resize-button
     1681               then do:
     1682                 assign
     1683                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1684                 .
     1685               end.
     1686             end.
     1687             run diasize_position-resize-button in this-procedure .
     1688           end.
     1689           assign
     1690             v-diasize-change-size = false
     1691           .
     1692           leave move_block .
     1693         end.
     1694       end.
     1695       assign
     1696         v-diasize-need-full-display = true
     1697       .
     1698       if v-diasize-change-size = false
     1699       then do:
     1700         assign
     1701           v-diasize-change-size = true
     1702         .
     1703       end.
     1704       else do:
     1705         return .
     1706       end.
     1707       assign
     1708         v-frame-height = frame Dialog-Frame :height
     1709         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1710         v-browse-height = v-diasize-browse-handle :height
     1711       .
     1712       for each buf_temp-browse-handle
     1713         where buf_temp-browse-handle.browse-type = 'height':u
     1714       :
     1715         assign
     1716           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1717         .
     1718       end.
     1719       for each buf_temp-diasize-handle
     1720       :
     1721         delete buf_temp-diasize-handle .
     1722       end.
     1723       assign
     1724         v-field-group-handle = frame Dialog-Frame :first-child
     1725       .
     1726       do while valid-handle(v-field-group-handle)
     1727       :
     1728         assign
     1729           v-object-handle = v-field-group-handle :first-child
     1730         .
     1731         do while valid-handle(v-object-handle)
     1732         :
     1733           if  v-object-handle <> v-diasize-browse-handle :handle
     1734           and can-query(v-object-handle, "row")
     1735           and can-query(v-object-handle, "height")
     1736           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1737           then do:
     1738             find first buf_temp-browse-handle
     1739               where buf_temp-browse-handle.browse-type   = 'height':u
     1740                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1741               no-error .
     1742             if available buf_temp-browse-handle
     1743             then do:
     1744             end.
     1745             else do:
     1746               create buf_temp-diasize-handle .
     1747               assign
     1748                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1749                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1750               .
     1751             end.
     1752           end.
     1753           assign
     1754             v-object-handle = v-object-handle :next-sibling
     1755           .
     1756         end.
     1757         assign
     1758           v-field-group-handle = v-field-group-handle :next-sibling
     1759         .
     1760       end.
     1761       do with frame Dialog-Frame
     1762       :
     1763         hide v-diasize-resize-button .
     1764         assign
     1765           v-diasize-resize-button :row    = 1
     1766           v-diasize-resize-button :column = 1
     1767         .
     1768       end.
     1769       if p-change-value > 0
     1770       then do:
     1771         if frame Dialog-Frame :scrollable = true
     1772         then do:
     1773           assign
     1774             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1775             no-error .
     1776           if error-status :error
     1777           or error-status :get-message(1) <> ""
     1778           then do:
     1779             undo move_block, retry move_block .
     1780           end.
     1781         end.
     1782         assign
     1783           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1784           no-error .
     1785         if error-status :error
     1786         or error-status :get-message(1) <> ""
     1787         then do:
     1788           undo move_block, retry move_block .
     1789         end.
     1790         assign
     1791           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1792           no-error .
     1793         if error-status :error
     1794         or error-status :get-message(1) <> ""
     1795         then do:
     1796           undo move_block, retry move_block .
     1797         end.
     1798         for each buf_temp-browse-handle
     1799           where buf_temp-browse-handle.browse-type = 'height':u
     1800         on error undo move_block, retry move_block
     1801         :
     1802           assign
     1803             buf_temp-browse-handle.browse-handle :height
     1804               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1805             no-error .
     1806           if error-status :error
     1807           or error-status :get-message(1) <> ""
     1808           then do:
     1809             undo move_block, retry move_block .
     1810           end.
     1811         end.
     1812         for each buf_temp-diasize-handle
     1813         on error undo move_block, retry move_block
     1814         :
     1815           assign
     1816             v-object-handle = buf_temp-diasize-handle.handle-value
     1817           .
     1818           if v-object-handle <> v-diasize-resize-button
     1819           then do:
     1820             assign
     1821               v-object-handle :row = v-object-handle :row + p-change-value
     1822               no-error .
     1823             if error-status :error
     1824             or error-status :get-message(1) <> ""
     1825             then do:
     1826               undo move_block, retry move_block .
     1827             end.
     1828           end.
     1829         end.
     1830       end.
     1831       else do:
     1832         for each buf_temp-diasize-handle
     1833         on error undo move_block, retry move_block
     1834         :
     1835           assign
     1836             v-object-handle = buf_temp-diasize-handle.handle-value
     1837           .
     1838           if v-object-handle <> v-diasize-resize-button
     1839           then do:
     1840             assign
     1841               v-object-handle :row = v-object-handle :row + p-change-value
     1842               no-error .
     1843             if error-status :error
     1844             or error-status :get-message(1) <> ""
     1845             then do:
     1846               undo move_block, retry move_block .
     1847             end.
     1848           end.
     1849         end.
     1850         assign
     1851           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1852           no-error .
     1853         if error-status :error
     1854         or error-status :get-message(1) <> ""
     1855         then do:
     1856           undo move_block, retry move_block .
     1857         end.
     1858         for each buf_temp-browse-handle
     1859           where buf_temp-browse-handle.browse-type = 'height':u
     1860         on error undo move_block, retry move_block
     1861         :
     1862           assign
     1863             buf_temp-browse-handle.browse-handle :height
     1864               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1865             no-error .
     1866           if error-status :error
     1867           or error-status :get-message(1) <> ""
     1868           then do:
     1869             undo move_block, retry move_block .
     1870           end.
     1871         end.
     1872         assign
     1873           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1874           no-error .
     1875         if error-status :error
     1876         or error-status :get-message(1) <> ""
     1877         then do:
     1878           undo move_block, retry move_block .
     1879         end.
     1880         if frame Dialog-Frame :scrollable = true
     1881         then do:
     1882           assign
     1883             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1884             no-error .
     1885           if error-status :error
     1886           or error-status :get-message(1) <> ""
     1887           then do:
     1888             undo move_block, retry move_block .
     1889           end.
     1890         end.
     1891       end.
     1892       if p-move-resize = true
     1893       then do:
     1894         run diasize_position-resize-button in this-procedure .
     1895       end.
     1896       if v-diasize-wndstore = true
     1897       then do:
     1898         if connected("ub") = true
     1899         then do:
     1900           define variable v-cntxt-db-num        as integer   no-undo .
     1901           define variable v-cntxt-userid        as character no-undo .
     1902           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1903                                             , OUTPUT v-cntxt-userid
     1904                                             ) .
     1905           run gbl/wndsizew.p
     1906             (input  v-cntxt-db-num
     1907             ,input  v-cntxt-userid
     1908             ,input  v-diasize-proc-name
     1909             ,input  'height':u
     1910             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1911             ) .
     1912         end.
     1913       end.
     1914     end.
     1915     assign
     1916       v-diasize-change-size = false
     1917     .
     1918   end procedure.
     1919   procedure diasize_set-height :
     1920     define input  parameter p-new-height  as decimal   no-undo .
     1921     define input  parameter p-move-resize as logical   no-undo .
     1922     do
     1923     on error undo, return error return-value
     1924     :
     1925       run diasize_change-height in this-procedure
     1926         (input  (p-new-height - frame Dialog-Frame :height)
     1927         ,input  p-move-resize
     1928         ) .
     1929     end.
     1930   end procedure.
     1931   procedure diasize_change-width :
     1932     define input  parameter p-change-value as decimal   no-undo .
     1933     define input  parameter p-move-resize  as logical   no-undo .
     1934     define variable v-field-group-handle   as handle    no-undo .
     1935     define variable v-object-handle        as handle    no-undo .
     1936     define variable v-frame-width          as decimal   no-undo .
     1937     define variable v-frame-virtual-width  as decimal   no-undo .
     1938     define variable v-browse-width         as decimal   no-undo .
     1939     define variable v-window-width         as decimal   no-undo .
     1940     define variable v-window-virtual-width as decimal   no-undo .
     1941     define variable v-change-sign          as integer   no-undo .
     1942     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1943     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1944     if p-change-value > 0
     1945     then do:
     1946       if frame Dialog-Frame :width + p-change-value >
     1947           session :width-chars
     1948       then do:
     1949         assign
     1950           p-change-value = session :width-chars - frame Dialog-Frame :width
     1951         .
     1952         if p-change-value <= 0
     1953         then do:
     1954           run diasize_position-resize-button in this-procedure .
     1955           return .
     1956         end.
     1957       end.
     1958     end.
     1959     if p-change-value < 0
     1960     then do:
     1961       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1962       then do:
     1963         assign
     1964           p-change-value = v-diasize-orig-frame-width
     1965                          - frame Dialog-Frame :width
     1966         .
     1967         if p-change-value >= 0
     1968         then do:
     1969           run diasize_position-resize-button in this-procedure .
     1970           return .
     1971         end.
     1972       end.
     1973     end.
     1974     if p-change-value >= 0
     1975     then do:
     1976       assign
     1977         v-change-sign = 1
     1978       .
     1979     end.
     1980     else do:
     1981       assign
     1982         v-change-sign = -1
     1983       .
     1984     end.
     1985     assign
     1986       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1987     .
     1988     if p-change-value = 0
     1989     then do:
     1990       run diasize_position-resize-button in this-procedure .
     1991       return .
     1992     end.
     1993     move_block:
     1994     do
     1995     on error undo move_block, leave move_block
     1996     :
     1997       if retry
     1998       then do:
     1999         do
     2000         on error undo move_block, leave move_block
     2001         :
     2002           if p-change-value > 0
     2003           then do:
     2004             for each buf_temp-diasize-handle
     2005             on error undo, next
     2006             :
     2007               assign
     2008                 v-object-handle = buf_temp-diasize-handle.handle-value
     2009               .
     2010               if v-object-handle <> v-diasize-resize-button
     2011               then do:
     2012                 assign
     2013                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2014                 .
     2015               end.
     2016             end.
     2017             assign
     2018               v-diasize-browse-handle :width = v-browse-width
     2019             .
     2020             for each buf_temp-browse-handle
     2021               where buf_temp-browse-handle.browse-type = 'width':u
     2022             on error undo, next
     2023             :
     2024               assign
     2025                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2026               .
     2027             end.
     2028             assign
     2029               frame Dialog-Frame :width = v-frame-width
     2030             .
     2031             if frame Dialog-Frame :scrollable = true
     2032             then do:
     2033               assign
     2034                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2035               .
     2036             end.
     2037             run diasize_position-resize-button in this-procedure .
     2038           end.
     2039           else do:
     2040             if frame Dialog-Frame :scrollable = true
     2041             then do:
     2042               assign
     2043                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2044               .
     2045             end.
     2046             assign
     2047               frame Dialog-Frame :width = v-frame-width
     2048             .
     2049             for each buf_temp-browse-handle
     2050               where buf_temp-browse-handle.browse-type = 'width':u
     2051             on error undo, next
     2052             :
     2053               assign
     2054                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2055               .
     2056             end.
     2057             assign
     2058               v-diasize-browse-handle :width = v-browse-width
     2059             .
     2060             for each buf_temp-diasize-handle
     2061             on error undo, next
     2062             :
     2063               assign
     2064                 v-object-handle = buf_temp-diasize-handle.handle-value
     2065               .
     2066               if v-object-handle <> v-diasize-resize-button
     2067               then do:
     2068                 assign
     2069                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2070                 .
     2071               end.
     2072             end.
     2073             run diasize_position-resize-button in this-procedure .
     2074           end.
     2075           assign
     2076             v-diasize-change-size = false
     2077           .
     2078           leave move_block .
     2079         end.
     2080       end.
     2081       assign
     2082         v-diasize-need-full-display = true
     2083       .
     2084       if v-diasize-change-size = false
     2085       then do:
     2086         assign
     2087           v-diasize-change-size = true
     2088         .
     2089       end.
     2090       else do:
     2091         return .
     2092       end.
     2093       assign
     2094         v-frame-width = frame Dialog-Frame :width
     2095         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2096         v-browse-width = v-diasize-browse-handle :width
     2097       .
     2098       for each buf_temp-browse-handle
     2099         where buf_temp-browse-handle.browse-type = 'width':u
     2100       :
     2101         assign
     2102           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2103         .
     2104       end.
     2105       for each buf_temp-diasize-handle
     2106       :
     2107         delete buf_temp-diasize-handle .
     2108       end.
     2109       assign
     2110         v-field-group-handle = frame Dialog-Frame :first-child
     2111       .
     2112       do while valid-handle(v-field-group-handle)
     2113       :
     2114         assign
     2115           v-object-handle = v-field-group-handle :first-child
     2116         .
     2117         do while valid-handle(v-object-handle)
     2118         :
     2119           if  v-object-handle <> v-diasize-browse-handle :handle
     2120           and v-object-handle <> v-diasize-resize-button
     2121           and can-query(v-object-handle, "row")
     2122           and can-query(v-object-handle, "height")
     2123           and ( v-object-handle :col + v-object-handle :width
     2124                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2125               )
     2126           then do:
     2127             find first buf_temp-browse-handle
     2128               where buf_temp-browse-handle.browse-type   = 'width':u
     2129                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2130               no-error .
     2131             if available buf_temp-browse-handle
     2132             then do:
     2133             end.
     2134             else do:
     2135               create buf_temp-diasize-handle .
     2136               assign
     2137                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2138                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2139               .
     2140             end.
     2141           end.
     2142           assign
     2143             v-object-handle = v-object-handle :next-sibling
     2144           .
     2145         end.
     2146         assign
     2147           v-field-group-handle = v-field-group-handle :next-sibling
     2148         .
     2149       end.
     2150       do with frame Dialog-Frame
     2151       :
     2152         hide v-diasize-resize-button .
     2153         v-diasize-resize-button :row = 1.
     2154         v-diasize-resize-button :column = 1.
     2155       end.
     2156       if p-change-value > 0
     2157       then do:
     2158         if frame Dialog-Frame :scrollable = true
     2159         then do:
     2160           assign
     2161             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2162             no-error .
     2163           if error-status :error
     2164           or error-status :get-message(1) <> ""
     2165           then do:
     2166             undo move_block, retry move_block.
     2167           end.
     2168         end.
     2169         assign
     2170           frame Dialog-Frame :width = v-frame-width + p-change-value
     2171           no-error .
     2172         if error-status :error
     2173         or error-status :get-message(1) <> ""
     2174         then do:
     2175           undo move_block, retry move_block.
     2176         end.
     2177         assign
     2178           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2179         no-error .
     2180         if error-status :error
     2181         or error-status :get-message(1) <> ""
     2182         then do:
     2183           undo move_block, retry move_block.
     2184         end.
     2185         for each buf_temp-browse-handle
     2186           where buf_temp-browse-handle.browse-type = 'width':u
     2187         on error undo move_block, retry move_block
     2188         :
     2189           assign
     2190             buf_temp-browse-handle.browse-handle :width
     2191               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2192             no-error .
     2193           if error-status :error
     2194           or error-status :get-message(1) <> ""
     2195           then do:
     2196             undo move_block, retry move_block .
     2197           end.
     2198         end.
     2199         for each buf_temp-diasize-handle
     2200         on error undo move_block, retry move_block
     2201         :
     2202           assign
     2203             v-object-handle = buf_temp-diasize-handle.handle-value
     2204           .
     2205           if v-object-handle <> v-diasize-resize-button
     2206           then do:
     2207             assign
     2208               v-object-handle :col = v-object-handle :col + p-change-value
     2209               no-error .
     2210             if error-status :error
     2211             or error-status :get-message(1) <> ""
     2212             then do:
     2213               undo move_block, retry move_block .
     2214             end.
     2215           end.
     2216         end.
     2217       end.
     2218       else do:
     2219         for each buf_temp-diasize-handle
     2220         on error undo move_block, retry move_block
     2221         :
     2222           assign
     2223             v-object-handle = buf_temp-diasize-handle.handle-value
     2224           .
     2225           if v-object-handle <> v-diasize-resize-button
     2226           then do:
     2227             assign
     2228               v-object-handle :col = v-object-handle :col + p-change-value
     2229               no-error .
     2230             if error-status :error
     2231             or error-status :get-message(1) <> ""
     2232             then do:
     2233               undo move_block, retry move_block .
     2234             end.
     2235           end.
     2236         end.
     2237         for each buf_temp-browse-handle
     2238           where buf_temp-browse-handle.browse-type = 'width':u
     2239         on error undo move_block, retry move_block
     2240         :
     2241           assign
     2242             buf_temp-browse-handle.browse-handle :width
     2243               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2244             no-error .
     2245           if error-status :error
     2246           or error-status :get-message(1) <> ""
     2247           then do:
     2248             undo move_block, retry move_block .
     2249           end.
     2250         end.
     2251         assign
     2252           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2253           no-error .
     2254         if error-status :error
     2255         or error-status :get-message(1) <> ""
     2256         then do:
     2257           undo move_block, retry move_block.
     2258         end.
     2259         assign
     2260           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2261         no-error .
     2262         if error-status :error
     2263         or error-status :get-message(1) <> ""
     2264         then do:
     2265           undo move_block, retry move_block.
     2266         end.
     2267         if frame Dialog-Frame :scrollable = true
     2268         then do:
     2269           assign
     2270             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2271           no-error .
     2272           if error-status :error
     2273           or error-status :get-message(1) <> ""
     2274           then do:
     2275             undo move_block, retry move_block.
     2276           end.
     2277         end.
     2278       end.
     2279       if p-move-resize
     2280       then do:
     2281         run diasize_position-resize-button in this-procedure .
     2282       end.
     2283       if v-diasize-wndstore = true
     2284       then do:
     2285         if connected("ub") = true
     2286         then do:
     2287           define variable v-cntxt-db-num        as integer   no-undo .
     2288           define variable v-cntxt-userid        as character no-undo .
     2289           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2290                                             , OUTPUT v-cntxt-userid
     2291                                             ) .
     2292           run gbl/wndsizew.p
     2293             (input  v-cntxt-db-num
     2294             ,input  v-cntxt-userid
     2295             ,input  v-diasize-proc-name
     2296             ,input  'width':u
     2297             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2298             ) .
     2299         end.
     2300       end.
     2301     end.
     2302     assign
     2303       v-diasize-change-size = false
     2304     .
     2305   end procedure.
     2306   procedure diasize_set-width :
     2307     define input  parameter p-new-width  as decimal   no-undo .
     2308     define input  parameter p-move-resize as logical   no-undo .
     2309     do
     2310     on error undo, return error return-value
     2311     :
     2312       run diasize_change-width in this-procedure
     2313         (input  (p-new-width - frame Dialog-Frame :width)
     2314         ,input  p-move-resize
     2315         ) .
     2316     end.
     2317   end procedure.
     2318   procedure diasize_position-resize-button :
     2319     do with frame Dialog-Frame
     2320     :
     2321       hide v-diasize-resize-button .
     2322       assign
     2323         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2324                     - 1
     2325                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2326         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2327                     - 1
     2328                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2329       .
     2330       view v-diasize-resize-button .
     2331     end.
     2332   end procedure.
     2333   on alt-right anywhere
     2334   do:
     2335     run diasize_change-width in this-procedure
     2336       (input 1
     2337       ,input true
     2338       ) .
     2339     return no-apply .
     2340   end.
     2341   on alt-left anywhere
     2342   do:
     2343     run diasize_change-width in this-procedure
     2344       (input -1
     2345       ,input true
     2346       ) .
     2347     return no-apply .
     2348   end.
     2349   on alt-down anywhere
     2350   do:
     2351     run diasize_change-height in this-procedure
     2352       (input 1
     2353       ,input true
     2354       ) .
     2355     return no-apply .
     2356   end.
     2357   on alt-up anywhere
     2358   do:
     2359     run diasize_change-height in this-procedure
     2360       (input -1
     2361       ,input true
     2362       ) .
     2363     return no-apply .
     2364   end.
     2365   on alt-enter of frame Dialog-Frame
     2366   do:
     2367     run diasize_maximize in this-procedure
     2368       (input  ?
     2369       ).
     2370     return no-apply .
     2371   end.
     2372   procedure diasize_end-move :
     2373     do
     2374     on error undo, return error return-value
     2375     :
     2376       define variable v-row-delta as decimal   no-undo .
     2377       define variable v-col-delta as decimal   no-undo .
     2378       define variable v-new-row as decimal   no-undo .
     2379       define variable v-new-col as decimal   no-undo .
     2380       assign
     2381         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2382         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2383       .
     2384       assign
     2385         v-row-delta = v-new-row - frame Dialog-Frame :height
     2386         v-col-delta = v-new-col - frame Dialog-Frame :width
     2387       .
     2388       run diasize_change-height in this-procedure
     2389         (input v-row-delta
     2390         ,input true
     2391         ) .
     2392       run diasize_change-width in this-procedure
     2393         (input v-col-delta
     2394         ,input true
     2395         ) .
     2396     end.
     2397   end procedure.
     2398   procedure diasize_maximize :
     2399     define input  parameter p-action as logical   no-undo .
     2400     do
     2401     on error undo, return error return-value
     2402     :
     2403       if p-action = ?
     2404       then do:
     2405         if v-diasize-need-maximize = true
     2406         then do:
     2407           assign
     2408             p-action = true
     2409           .
     2410         end.
     2411         else do:
     2412           assign
     2413             p-action = false
     2414           .
     2415         end.
     2416       end.
     2417       if p-action = true
     2418       then do:
     2419         run diasize_change-height in this-procedure
     2420           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2421               - frame Dialog-Frame :height-chars
     2422           ,input true
     2423           ) .
     2424         run diasize_change-width in this-procedure
     2425           (input session :width-chars
     2426               - frame Dialog-Frame :width-chars
     2427           ,input true
     2428           ) .
     2429         assign
     2430           v-diasize-need-maximize = false
     2431         .
     2432       end.
     2433       else do:
     2434         run diasize_change-width in this-procedure
     2435           (input v-diasize-orig-frame-width
     2436               - frame Dialog-Frame :width-chars
     2437           ,input true
     2438           ) .
     2439         run diasize_change-height in this-procedure
     2440           (input v-diasize-orig-frame-height
     2441               - frame Dialog-Frame :height-chars
     2442           ,input true
     2443           ) .
     2444         assign
     2445           v-diasize-need-maximize = true
     2446         .
     2447       end.
     2448     end.
     2449   end procedure.
     2450   procedure diasize_restore-orig-size :
     2451     do
     2452     on error undo, return error return-value
     2453     :
     2454       assign
     2455         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2456         v-diasize-current-frame-height = frame Dialog-Frame :height
     2457       .
     2458       run diasize_set-height in this-procedure
     2459         (input  v-diasize-orig-frame-height
     2460         ,input  true
     2461         ) .
     2462       run diasize_set-width in this-procedure
     2463         (input  v-diasize-orig-frame-width
     2464         ,input  true
     2465         ) .
     2466     end.
     2467   end procedure.
     2468   procedure diasize_restore-current-size :
     2469     do
     2470     on error undo, return error return-value
     2471     :
     2472       run diasize_set-height in this-procedure
     2473         (input  v-diasize-current-frame-height
     2474         ,input  true
     2475         ) .
     2476       run diasize_set-width in this-procedure
     2477         (input  v-diasize-current-frame-width
     2478         ,input  true
     2479         ) .
     2480     end.
     2481   end procedure.
     2482   procedure diasize_set-browse-handle :
     2483     define input  parameter p-browse-handle as handle   no-undo .
     2484     define buffer buf_temp-browse-handle for temp-browse-handle .
     2485     do
     2486     on error undo, return error return-value
     2487     :
     2488       assign
     2489         v-diasize-browse-handle = p-browse-handle
     2490       .
     2491       for each buf_temp-browse-handle
     2492       on error undo, return error return-value
     2493       :
     2494         delete buf_temp-browse-handle .
     2495       end.
     2496     end.
     2497   end procedure.
     2498   procedure diasize_add_browse :
     2499     define input  parameter p-browse-type   as character no-undo .
     2500     define input  parameter p-browse-handle as handle    no-undo .
     2501     define buffer buf_temp-browse-handle for temp-browse-handle .
     2502     do
     2503     on error undo, return error return-value
     2504     :
     2505       assign
     2506         v-diasize-browse-number = v-diasize-browse-number + 1
     2507       .
     2508       create buf_temp-browse-handle .
     2509       assign
     2510         buf_temp-browse-handle.browse-type   = p-browse-type
     2511         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2512         buf_temp-browse-handle.browse-handle = p-browse-handle
     2513       .
     2514     end.
     2515   end procedure.
     2516   procedure diasize_init :
     2517     define variable v-default-value    as logical   no-undo .
     2518     define variable v-restore-saved    as logical   no-undo .
     2519     define variable v-resize-value-str as character no-undo .
     2520     do
     2521     on error undo, return error return-value
     2522     :
     2523       do with frame Dialog-Frame
     2524       :
     2525         assign
     2526           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2527           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2528           v-diasize-browse-handle     = browse br-c-scales-gds :handle
     2529         .
     2530         create button v-diasize-resize-button
     2531         assign
     2532           parent        = frame Dialog-Frame :first-child
     2533           label         = "s"
     2534           height-pixels = 16
     2535           width-pixels  = 16
     2536           visible       = true
     2537           sensitive     = true
     2538           movable       = true
     2539           triggers:
     2540             on end-move persistent run diasize_end-move in this-procedure .
     2541           end triggers.
     2542         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2543         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2544         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2545         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2546         assign
     2547           v-diasize-wndmax = false
     2548         .
     2549         if connected("ub") = true
     2550         then do:
     2551           define variable v-cntxt-db-num        as integer   no-undo .
     2552           define variable v-cntxt-userid        as character no-undo .
     2553           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2554                                             , OUTPUT v-cntxt-userid
     2555                                             ) .
     2556           run gbl/wndpar_r.p
     2557             (input  v-cntxt-db-num
     2558             ,input  v-cntxt-userid
     2559             ,input  'wndmax':U
     2560             ,output v-diasize-wndmax
     2561             ,output v-default-value
     2562             ) .
     2563         end.
     2564         assign
     2565           v-diasize-wndstore = false
     2566         .
     2567         if connected("ub") = true
     2568         then do:
     2569           run gbl/wndpar_r.p
     2570             (input  v-cntxt-db-num
     2571             ,input  v-cntxt-userid
     2572             ,input  'wndstore':U
     2573             ,output v-diasize-wndstore
     2574             ,output v-default-value
     2575             ) .
     2576         end.
     2577         assign
     2578           v-diasize-proc-name = entry(1, program-name(2), '.')
     2579         .
     2580         if v-diasize-wndstore = true
     2581         then do:
     2582           assign
     2583             v-restore-saved = false
     2584           .
     2585           if connected("ub") = true
     2586           then do:
     2587             run gbl/wndsizer.p
     2588               (input  v-cntxt-db-num
     2589               ,input  v-cntxt-userid
     2590               ,input  v-diasize-proc-name
     2591               ,input  'height':u
     2592               ,output v-resize-value-str
     2593               ) .
     2594             if v-resize-value-str <> '':U
     2595             then do:
     2596               run diasize_change-height in this-procedure
     2597                 (input  integer(v-resize-value-str)
     2598                 ,input  true
     2599                 ) .
     2600               assign
     2601                 v-restore-saved = true
     2602               .
     2603             end.
     2604           end.
     2605           if connected("ub") = true
     2606           then do:
     2607             run gbl/wndsizer.p
     2608               (input  v-cntxt-db-num
     2609               ,input  v-cntxt-userid
     2610               ,input  v-diasize-proc-name
     2611               ,input  'width':u
     2612               ,output v-resize-value-str
     2613               ) .
     2614             if v-resize-value-str <> '':U
     2615             then do:
     2616               run diasize_change-width in this-procedure
     2617                 (input  integer(v-resize-value-str)
     2618                 ,input  true
     2619                 ) .
     2620               assign
     2621                 v-restore-saved = true
     2622               .
     2623             end.
     2624           end.
     2625           if v-restore-saved <> true
     2626           then do:
     2627             if v-diasize-wndmax = true
     2628             then do:
     2629               run diasize_maximize in this-procedure
     2630                 (input  true
     2631                 ) .
     2632             end.
     2633           end.
     2634         end.
     2635         else do:
     2636           if v-diasize-wndmax = true
     2637           then do:
     2638             run diasize_maximize in this-procedure
     2639               (input  true
     2640               ) .
     2641           end.
     2642         end.
     2643       end.
     2644     end.
     2645   end procedure.
     2646   procedure diasize_need-full-display :
     2647     define output parameter p-need-full-display as logical   no-undo .
     2648     do
     2649     on error undo, return error return-value
     2650     :
     2651       assign
     2652         p-need-full-display = v-diasize-need-full-display
     2653       .
     2654       assign
     2655         v-diasize-need-full-display = false
     2656       .
     2657     end.
     2658   end procedure.
     2659   procedure get-context :
     2660      define output parameter p-db-num as integer          no-undo.
     2661      define output parameter p-user-id as character        no-undo.
     2662      define variable v-login               as character    no-undo.
     2663      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2664      define buffer buf_user-login  for ub.user-login .
     2665      do
     2666      on error undo, return error
     2667      :
     2668            FIND FIRST buf_sys-ctrl no-lock.
     2669            ASSIGN
     2670               v-login = USERID("ub")
     2671               p-db-num = buf_sys-ctrl.db-num
     2672            .
     2673            FIND FIRST buf_user-login
     2674                 WHERE buf_user-login.db-num = p-db-num
     2675                   AND buf_user-login.user-login = v-login
     2676                 no-lock
     2677                 no-error
     2678                 .
     2679            IF AVAILABLE buf_user-login
     2680            THEN DO:
     2681               assign
     2682                  p-user-id = buf_user-login.user-id
     2683               .
     2684            END.
     2685      end.
     2686   end procedure.
     2687   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2688   on f5 of frame Dialog-Frame anywhere
     2689   do:
     2690     v-doc-rec = recid(X_c-scales-gds). run openbr in this-procedure  ( INPUT yes, input no, input '':U). reposition br-c-scales-gds to recid v-doc-rec no-error.
     2691       apply "VALUE-CHANGED" to BR-c-scales-gds.
     2692   end.
     2693   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2694   do:
     2695     BR-c-scales-gds :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2696   end.
     2697   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2698   procedure set-filter-name :
     2699   define input parameter p-filter-name as character no-undo .
     2700     do with frame Dialog-Frame:
     2701       if p-filter-name > "" then do:
     2702         assign
     2703           frame Dialog-Frame:title
     2704             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2705         .
     2706         assign
     2707           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2708         .
     2709       end.
     2710       else do:
     2711         assign
     2712           b-sch :tooltip = ""
     2713         .
     2714       end.
     2715     end.
     2716   end procedure.
     2717   def var sort-labelbr-c-scales-gds   as character no-undo .
     2718   def var sort-clmnbr-c-scales-gds    as handle    no-undo .
     2719   def var cur-clmnbr-c-scales-gds     as handle    no-undo .
     2720   def var cur-clmn-locbr-c-scales-gds as integer   no-undo .
     2721   def var re-querybr-c-scales-gds     as logical   initial no no-undo .
     2722   on start-search, ctrl-o of br-c-scales-gds in frame Dialog-Frame do:
     2723      run sort-brbr-c-scales-gds
     2724        (input (if available X_c-scales-gds
     2725                then recid(X_c-scales-gds)
     2726                else ?
     2727               )
     2728        ).
     2729   end.
     2730   PROCEDURE sort-brbr-c-scales-gds :
     2731     define input parameter p-recid as recid no-undo .
     2732     if re-querybr-c-scales-gds = no then do:
     2733       assign
     2734          cur-clmnbr-c-scales-gds = br-c-scales-gds:current-column in frame Dialog-Frame
     2735       .
     2736       if sort-clmnbr-c-scales-gds <> ? then sort-clmnbr-c-scales-gds:column-fgcolor = 0.
     2737       if cur-clmnbr-c-scales-gds = sort-clmnbr-c-scales-gds then do:
     2738         assign
     2739            sort-labelbr-c-scales-gds = ""
     2740            sort-clmnbr-c-scales-gds = ?
     2741         .
     2742        end.
     2743        else do:
     2744          assign
     2745            sort-labelbr-c-scales-gds = cur-clmnbr-c-scales-gds:label
     2746            sort-clmnbr-c-scales-gds  = cur-clmnbr-c-scales-gds
     2747            sort-clmnbr-c-scales-gds:column-fgcolor = 4
     2748          .
     2749        end.
     2750      end.
     2751     assign
     2752       cur-clmn-locbr-c-scales-gds = 1
     2753     .
     2754     def var column-handle as handle no-undo .
     2755     column-handle = br-c-scales-gds:first-column.
     2756     do while valid-handle(column-handle) :
     2757       if column-handle = cur-clmnbr-c-scales-gds then do:
     2758         leave .
     2759       end.
     2760       column-handle = column-handle:NEXT-COLUMN.
     2761       assign
     2762         cur-clmn-locbr-c-scales-gds = cur-clmn-locbr-c-scales-gds + 1
     2763       .
     2764     end.
     2765     case sort-labelbr-c-scales-gds:
     2766           when X_c-scales-gds.corr-date:label in browse br-c-scales-gds then DO:    assign       sort-column-name = "X_c-scales-gds.corr-date"     .     run OpenBr in this-procedure ( INPUT yes, input no, input '':U).   . END.
     2767       otherwise do:
     2768         assign
     2769           sort-column-name = ""
     2770         .
     2771         run OpenBr in this-procedure  ( INPUT yes, input no, input '':U).
     2772         if sort-labelbr-c-scales-gds <> "" then do:
     2773           assign
     2774             cur-clmnbr-c-scales-gds:column-fgcolor = 0
     2775           .
     2776         end.
     2777         assign
     2778           cur-clmn-locbr-c-scales-gds = ?
     2779         .
     2780       end.
     2781     end case.
     2782     if p-recid <> ? then do:
     2783       reposition br-c-scales-gds to recid p-recid no-error.
     2784       apply "value-changed" to br-c-scales-gds in frame Dialog-Frame.
     2785     end.
     2786     apply "entry" to br-c-scales-gds in frame Dialog-Frame.
     2787   END PROCEDURE.
     2788   procedure re-open-query-srt-clmnbr-c-scales-gds:
     2789   if cur-clmnbr-c-scales-gds = ? then do:
     2790      run OpenBr in this-procedure  ( INPUT yes, input no, input '':U).
     2791   end.
     2792   else do:
     2793      assign re-querybr-c-scales-gds = yes.
     2794      run sort-brbr-c-scales-gds
     2795        (input (if available X_c-scales-gds
     2796                then recid(X_c-scales-gds)
     2797                else ?
     2798               )
     2799        ).
     2800      assign re-querybr-c-scales-gds = no.
     2801   end.
     2802   end.
     2803   MAIN-BLOCK:
     2804   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2805      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2806     CASE parref-mode:
     2807      WHEN 'все':U        THEN DO:
     2808      END.
     2809      WHEN "one":U THEN DO:
     2810        find first X_scales-gds no-lock where
     2811                   X_scales-gds.db-num = pardb-num
     2812              AND  X_scales-gds.scales-num = parscales-num no-error .
     2813        if not available X_scales-gds then do:
     2814           message
     2815           vss-workfile vss-revision vss-description skip
     2816           "Неверный значение параметров pardb-num parscales-num"
     2817           view-as alert-box ERROR.
     2818           return.
     2819        end.
     2820      END.
     2821      otherwise do:
     2822         message vss-workfile vss-revision vss-description skip
     2823         "Неверный вызов - parref-mode=" parref-mode
     2824         view-as alert-box ERROR.
     2825         return.
     2826       end.
     2827     end case.
     2828     v-rid-list = p-rid-list.
     2829     RUN MyEnable.
     2830     HIDE mark-num in frame Dialog-Frame .
     2831     run OpenBR in this-procedure  ( INPUT yes, input no, input '':U).
     2832     run diasize_add_browse in this-procedure
     2833       (input  'width':u
     2834       ,input  browse br-changes :handle
     2835       ) .
     2836     run diasize_init in this-procedure .
     2837     WAIT-FOR GO OF FRAME Dialog-Frame.
     2838   END.
     2839   RUN disable_UI.
     2840   PROCEDURE disable_UI :
     2841     HIDE FRAME Dialog-Frame.
     2842   END PROCEDURE.
     2843   PROCEDURE enable_UI :
     2844     DISPLAY mark-num
     2845         WITH FRAME Dialog-Frame.
     2846     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num BR-c-scales-gds BR-changes
     2847         WITH FRAME Dialog-Frame.
     2848     VIEW FRAME Dialog-Frame.
     2849   END PROCEDURE.
     2850   PROCEDURE MyEnable :
     2851   br-changes:title in frame Dialog-Frame  = "":U.
     2852   assign
     2853   temp-changes.l_name:resizable in browse br-changes = true
     2854   temp-changes.v_old:resizable in browse br-changes = true
     2855   temp-changes.v_new:resizable in browse br-changes = true
     2856   temp-changes.l_name:width in browse br-changes = 30
     2857   temp-changes.v_old:width in browse br-changes = 40
     2858   temp-changes.v_new:width in browse br-changes = 40
     2859   .
     2860   DISPLAY
     2861   mark-num
     2862   br-changes
     2863   WITH FRAME Dialog-Frame.
     2864   ENABLE
     2865   B-quit
     2866   B-mark when lookup('b-mark':U, bttns) >0
     2867   B-sel when lookup('b-sel':U, bttns) >0
     2868   B-sch
     2869   B-Help
     2870   BR-c-scales-gds
     2871   br-changes
     2872   mark-num
     2873   WITH FRAME Dialog-Frame.
     2874   VIEW FRAME Dialog-Frame.
     2875   END PROCEDURE.
     2876   PROCEDURE OpenBr :
     2877   define input  parameter p-open-query     as logical   no-undo .
     2878   define input  parameter p-find-next      as logical   no-undo .
     2879   define input  parameter p-find-condition as character no-undo .
     2880   define variable l-query-was-opened as logical no-undo .
     2881   define variable sort-column-phrase as character no-undo .
     2882   case sort-column-name :
     2883     when "" then do:
     2884       assign
     2885         sort-column-phrase = ""
     2886       .
     2887     end.
     2888     otherwise do:
     2889       assign
     2890         sort-column-phrase = "by " + sort-column-name
     2891       .
     2892     end.
     2893   end case.
     2894   CASE parref-mode:
     2895       when 'все':U then do:
     2896           ASSIGN frame Dialog-Frame:TITLE = "Справочник истории товара на весах"
     2897           filter-point = filter-point0 + parref-mode
     2898           filter-label = substitute("&1", filter-label0)
     2899           .
     2900   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2901   define variable  l-disable-where-21  as logical   no-undo .
     2902   define variable  l-filter-open-21    as logical   .
     2903   define variable  flt-rec-21       as recid     no-undo .
     2904   define variable  filter-name-21      as character no-undo .
     2905   define variable  where-phrase-21     as character no-undo .
     2906   define variable  sort-phrase-21      as character no-undo .
     2907   define variable  where-phrase-rus-21 as character no-undo .
     2908   define variable  sort-phrase-rus-21  as character no-undo .
     2909     run waitfram-show in this-procedure
     2910       (input "ЖДИТЕ ..."
     2911       ).
     2912   run gbl/flt-get.p
     2913     (input filter-point
     2914     ,output flt-rec-21
     2915     ,output filter-name-21
     2916     ,output where-phrase-21
     2917     ,output sort-phrase-21
     2918     ,output where-phrase-rus-21
     2919     ,output sort-phrase-rus-21
     2920     ).
     2921       run set-filter-name in this-procedure
     2922         (INPUT filter-name-21
     2923         ) no-error .
     2924     assign
     2925       l-filter-open-21 = false
     2926     .
     2927     if flt-rec-21 <> ?
     2928       or sort-column-phrase > ""
     2929     then do:
     2930       define variable  parameter-2-21 as character no-undo .
     2931       define variable  parameter-3-21 as character no-undo .
     2932       define variable  parameter-4-21 as character no-undo .
     2933       define variable  parameter-5-21 as character no-undo .
     2934       define variable  parameter-6-21 as character no-undo .
     2935       define variable  parameter-7-21 as character no-undo .
     2936         assign
     2937         parameter-3-21 =
     2938                                 "FOR EACH X_c-scales-gds NO-LOCK"
     2939         parameter-4-21 =
     2940           (
     2941             if (" TRUE " + " " + where-phrase-21) <> ""
     2942             then " TRUE " + " " + where-phrase-21
     2943             else "true"
     2944           )
     2945         parameter-5-21 = (" " + "" + " " + ", FIRST X_c-scales NO-LOCK WHERE   X_c-scales.db-num = X_c-scales-gds.db-num       AND X_c-scales.scales-num = X_c-scales-gds.scales-num       AND X_c-scales.chip-num = X_c-scales-gds.chip-num       AND X_c-scales.corr-user-db-num = X_c-scales-gds.corr-user-db-num")
     2946         parameter-6-21 = if sort-phrase-21 = ''
     2947                              then
     2948           (
     2949           " " + "  " +
     2950             " " + sort-column-phrase +
     2951           " " + "  "
     2952           )
     2953                              else
     2954           (
     2955           " " + "  " +
     2956             " " + sort-column-phrase +
     2957           " " + sort-phrase-21
     2958           )
     2959         parameter-7-21 =
     2960           "   "
     2961       .
     2962       do
     2963       on stop undo, leave
     2964       on error undo, leave
     2965       :
     2966         assign
     2967           l-disable-where-21 =
     2968             (" TRUE " + " " + where-phrase-21 = "")
     2969         .
     2970         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2971                             ,input query br-c-scales-gds:handle
     2972                             ,input parameter-3-21
     2973                             ,input parameter-4-21
     2974                             ,input parameter-5-21
     2975                             ,input parameter-6-21
     2976                             ,input parameter-7-21
     2977                             )
     2978         .
     2979         assign
     2980           l-filter-open-21 = true
     2981         .
     2982       end.
     2983       if l-filter-open-21 = false then do:
     2984         message
     2985           "Ошибка при фильтрации / сортировке" skip
     2986           "Будут показаны записи без учета фильтра" skip
     2987           view-as alert-box .
     2988       end.
     2989       else do:
     2990           assign
     2991             l-query-was-opened = true
     2992           .
     2993       end.
     2994     end.
     2995     if l-filter-open-21 = false then do:
     2996       OPEN QUERY br-c-scales-gds FOR EACH X_c-scales-gds NO-LOCK
     2997         where  TRUE
     2998       , FIRST X_c-scales NO-LOCK WHERE   X_c-scales.db-num = X_c-scales-gds.db-num       AND X_c-scales.scales-num = X_c-scales-gds.scales-num       AND X_c-scales.chip-num = X_c-scales-gds.chip-num       AND X_c-scales.corr-user-db-num = X_c-scales-gds.corr-user-db-num
     2999     .
     3000         assign
     3001           l-query-was-opened = true
     3002         .
     3003     end.
     3004     run waitfram-hide in this-procedure .
     3005       end.
     3006       when "one":U then do:
     3007           ASSIGN frame Dialog-Frame:TITLE = substitute("Справочник истории товара на весах: БД &1 весы &2 PLU &3"
     3008                                                          ,pardb-num
     3009                                                          ,parscales-num)
     3010           filter-point = filter-point0 + parref-mode
     3011           filter-label = substitute("&1 Один весы один товар", filter-label0)
     3012           .
     3013   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3014   define variable  l-disable-where-23  as logical   no-undo .
     3015   define variable  l-filter-open-23    as logical   .
     3016   define variable  flt-rec-23       as recid     no-undo .
     3017   define variable  filter-name-23      as character no-undo .
     3018   define variable  where-phrase-23     as character no-undo .
     3019   define variable  sort-phrase-23      as character no-undo .
     3020   define variable  where-phrase-rus-23 as character no-undo .
     3021   define variable  sort-phrase-rus-23  as character no-undo .
     3022     run waitfram-show in this-procedure
     3023       (input "ЖДИТЕ ..."
     3024       ).
     3025   run gbl/flt-get.p
     3026     (input filter-point
     3027     ,output flt-rec-23
     3028     ,output filter-name-23
     3029     ,output where-phrase-23
     3030     ,output sort-phrase-23
     3031     ,output where-phrase-rus-23
     3032     ,output sort-phrase-rus-23
     3033     ).
     3034       run set-filter-name in this-procedure
     3035         (INPUT filter-name-23
     3036         ) no-error .
     3037     assign
     3038       l-filter-open-23 = false
     3039     .
     3040     if flt-rec-23 <> ?
     3041       or sort-column-phrase > ""
     3042     then do:
     3043       define variable  parameter-2-23 as character no-undo .
     3044       define variable  parameter-3-23 as character no-undo .
     3045       define variable  parameter-4-23 as character no-undo .
     3046       define variable  parameter-5-23 as character no-undo .
     3047       define variable  parameter-6-23 as character no-undo .
     3048       define variable  parameter-7-23 as character no-undo .
     3049         assign
     3050         parameter-3-23 =
     3051                                 "FOR EACH X_c-scales-gds NO-LOCK"
     3052         parameter-4-23 =
     3053           (
     3054             if (" X_c-scales-gds.db-num = pardb-num AND X_c-scales-gds.scales-num = parscales-num                             and X_c-scales-gds.PLU-code = parplu-code" + " " + where-phrase-23) <> ""
     3055             then  substitute('X_c-scales-gds.db-num = &1 AND X_c-scales-gds.scales-num = &2                             and X_c-scales-gds.PLU-code = &3', pardb-num, parscales-num, parplu-code) + " " + where-phrase-23
     3056             else "true"
     3057           )
     3058         parameter-5-23 = (" " + "" + " " + ", FIRST X_c-scales NO-LOCK WHERE   X_c-scales.db-num = X_c-scales-gds.db-num       AND X_c-scales.scales-num = X_c-scales-gds.scales-num       AND X_c-scales.chip-num = X_c-scales-gds.chip-num       AND X_c-scales.corr-user-db-num = X_c-scales-gds.corr-user-db-num")
     3059         parameter-6-23 = if sort-phrase-23 = ''
     3060                              then
     3061           (
     3062           " " + "  " +
     3063             " " + sort-column-phrase +
     3064           " " + "  "
     3065           )
     3066                              else
     3067           (
     3068           " " + "  " +
     3069             " " + sort-column-phrase +
     3070           " " + sort-phrase-23
     3071           )
     3072         parameter-7-23 =
     3073           "   "
     3074       .
     3075       do
     3076       on stop undo, leave
     3077       on error undo, leave
     3078       :
     3079         assign
     3080           l-disable-where-23 =
     3081             (" X_c-scales-gds.db-num = pardb-num AND X_c-scales-gds.scales-num = parscales-num                             and X_c-scales-gds.PLU-code = parplu-code" + " " + where-phrase-23 = "")
     3082         .
     3083         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3084                             ,input query br-c-scales-gds:handle
     3085                             ,input parameter-3-23
     3086                             ,input parameter-4-23
     3087                             ,input parameter-5-23
     3088                             ,input parameter-6-23
     3089                             ,input parameter-7-23
     3090                             )
     3091         .
     3092         assign
     3093           l-filter-open-23 = true
     3094         .
     3095       end.
     3096       if l-filter-open-23 = false then do:
     3097         message
     3098           "Ошибка при фильтрации / сортировке" skip
     3099           "Будут показаны записи без учета фильтра" skip
     3100           view-as alert-box .
     3101       end.
     3102       else do:
     3103           assign
     3104             l-query-was-opened = true
     3105           .
     3106       end.
     3107     end.
     3108     if l-filter-open-23 = false then do:
     3109       OPEN QUERY br-c-scales-gds FOR EACH X_c-scales-gds NO-LOCK
     3110         where  X_c-scales-gds.db-num = pardb-num AND X_c-scales-gds.scales-num = parscales-num                             and X_c-scales-gds.PLU-code = parplu-code
     3111       , FIRST X_c-scales NO-LOCK WHERE   X_c-scales.db-num = X_c-scales-gds.db-num       AND X_c-scales.scales-num = X_c-scales-gds.scales-num       AND X_c-scales.chip-num = X_c-scales-gds.chip-num       AND X_c-scales.corr-user-db-num = X_c-scales-gds.corr-user-db-num
     3112     .
     3113         assign
     3114           l-query-was-opened = true
     3115         .
     3116     end.
     3117     run waitfram-hide in this-procedure .
     3118       end.
     3119   END CASE.
     3120   apply "entry" to br-c-scales-gds in frame Dialog-Frame.
     3121   reposition br-c-scales-gds to row 1 no-error.
     3122   APPLY "VALUE-CHANGED":U to br-c-scales-gds.
     3123   END PROCEDURE.
     3124   PROCEDURE proc-b-sch :
     3125   assign
     3126   tbl = 'c-scales-gds'
     3127   join-tbl = 'X_c-scales-gds'
     3128   fld = ""
     3129   lab = ""
     3130   spr = ""
     3131   dim = '0'
     3132   .
     3133   run fltfield-add in this-procedure('db-num', 'БД', '',
     3134   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3135   run fltfield-add in this-procedure('scales-num', 'Номер', '',
     3136   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3137   run fltfield-add in this-procedure('corr-date', 'Дата изменений', '',
     3138   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3139   run fltfield-add in this-procedure('corr-time', 'Время изменений', 'time',
     3140   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3141   run fltfield-add in this-procedure('corr-user-db-num', 'БД изменений', '',
     3142   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3143   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3144   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3145   run fltfield-add in this-procedure('is-del', 'Удаленная запись', '',
     3146   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3147   DO on stop undo, leave:
     3148       run gbl/filter.w ( input parparentproc
     3149                        , input (filter-point + chr(4) + filter-label)
     3150                        , input tbl
     3151                        , input join-tbl
     3152                        , input fld
     3153                        , input lab
     3154                        , input spr
     3155                        , input dim).
     3156       RUN OpenBr in this-procedure ( INPUT yes, input no, input '':U).
     3157   END .
     3158   END PROCEDURE.
     3159   PROCEDURE proc-view-changes :
     3160   define buffer buf_c-scales for ub.c-scales.
     3161   for each temp-changes:
     3162     delete temp-changes.
     3163   END.
     3164   if not available X_c-scales-gds then do:
     3165     Open QUery br-changes for each temp-changes.
     3166     return.
     3167   end.
     3168   if not available X_c-scales then do:
     3169     Open QUery br-changes for each temp-changes.
     3170     return.
     3171   end.
     3172   define variable v-label-param as character no-undo .
     3173   v-label-param =
     3174     "b-code" + chr(4) + "Бар-код" + chr(4) + "" + chr(8)
     3175    + "deadline" + chr(4) + "Срок хранения" + chr(4) + "" + chr(8)
     3176    + "obj-code" + chr(4) + "Магазин" + chr(4) + "" + chr(8)
     3177    + "to-send" + chr(4) + "Требует обновления" + chr(4) + "" + chr(8)
     3178    + "to-del" + chr(4) + "Удаляется" + chr(4) + "" + chr(8)
     3179    + "wt-cart" + chr(4) + "Вес упаковки" + chr(4) + ""  .
     3180    run proc-full-temp-changes in this-procedure (
     3181                                                input  X_c-scales.action = integer('1':U)
     3182                                               ,input  X_c-scales.action = integer('99':U)
     3183                                               ,input  buffer X_c-scales-gds:handle
     3184                                               ,input  'scales-gds':U
     3185                                               ,input  "b-code,deadline,obj-code,to-send,to-del,wt-cart"
     3186                                               ,input  v-label-param).
     3187   Open QUery br-changes for each temp-changes.
     3188   END PROCEDURE.
     3189   FUNCTION get-action RETURNS CHARACTER
     3190     ( INPUT p-action AS INTEGER ) :
     3191       define variable dops as character no-undo.
     3192   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     3193   RETURN dops.
     3194   END FUNCTION.
