      418   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parfact-date    like ub.wth-line.fact-date    no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      419   end procedure.
      420   procedure wth-lib_full-inf-calend-date-place:
      421   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code  like ub.wth-line.w-p-code  no-undo.                        define input parameter parfact-date like ub.wth-line.fact-date no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      422   end procedure.
      423   FUNCTION get-curr RETURNS CHARACTER
      424     (buffer loc-wealth for ub.wealth ) :
      425   define buffer buf_currency for ub.currency.
      426   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      427   return loc-wealth.unit-base.
      428   FIND FIRST buf_currency no-lock where
      429             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      430   if avail buf_currency then
      431     RETURN buf_currency.curr-abbr.
      432   else return "".
      433   END FUNCTION.
      434   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      435   define variable c-point  as character no-undo .
      436   define variable tbl      as character no-undo .
      437   define variable join-tbl as character no-undo .
      438   define variable fld      as character no-undo .
      439   define variable lab      as character no-undo .
      440   define variable spr      as character no-undo .
      441   define variable dim      as character no-undo .
      442   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   procedure fltfield-clear :
      444     define output parameter loc-fld as character no-undo.
      445     define output parameter loc-lab as character no-undo .
      446     define output parameter loc-spr as character no-undo .
      447     define output parameter loc-dim as character no-undo .
      448     assign
      449       loc-fld = ""
      450       loc-lab = ""
      451       loc-spr = ""
      452       loc-dim = "0"
      453     .
      454   end procedure .
      455   procedure fltfield-add :
      456     define input        parameter par-fld as character no-undo.
      457     define input        parameter par-lab as character no-undo .
      458     define input        parameter par-spr as character no-undo .
      459     define input-output parameter loc-fld as character no-undo.
      460     define input-output parameter loc-lab as character no-undo .
      461     define input-output parameter loc-spr as character no-undo .
      462     define input-output parameter loc-dim as character no-undo .
      463     do
      464     on error undo, return error
      465     :
      466       assign
      467       loc-fld = if loc-dim = '0'
      468                 then par-fld
      469                 else (loc-fld + chr(44) + par-fld)
      470       loc-lab = if loc-dim = '0'
      471                 then par-lab
      472                 else (loc-lab + chr(44) + par-lab)
      473       loc-spr = if loc-dim = '0'
      474                 then par-spr
      475                 else (loc-spr + chr(44) + par-spr)
      476       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      477                 string(integer(if num-entries(loc-dim) > 1
      478                               then entry(2, loc-dim)
      479                               else entry(1, loc-dim)
      480                               ) + 1)
      481       no-error
      482       .
      483     end.
      484   end procedure.
      485   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      486   define variable v-waitfram-action01         as character   no-undo .
      487   define variable v-waitfram-action02         as character   no-undo .
      488   define variable v-waitfram-action03         as character   no-undo .
      489   define variable mWaitFramTextBeg            as character   no-undo.
      490   define variable mWaitFramTextEnd            as character   no-undo.
      491   define variable mWaitFramView               as logical     no-undo.
      492   define variable mWaitProcEvent              as logical     no-undo init yes.
      493   define variable mWaitFramInterval           as integer     no-undo init 1 .
      494   define variable mWaitFramStop               as logical     no-undo.
      495   define variable mWaitFramStopUser           as logical     no-undo.
      496   define variable mWaitFramStopTimeOut        as logical     no-undo.
      497   define variable mWaitFramStartProc          as datetime-tz no-undo.
      498   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      499   define button B-WaitFramStop auto-end-key
      500        label "Стоп"
      501        size 10 by 1 tooltip "Остоновить процесс".
      502   define button B-viewProcInfo
      503        label "Информация"
      504        size 15 by 1 tooltip "Информация о процесс".
      505   define frame waitfram
      506     v-waitfram-action01 format "x(72)" no-label skip
      507     v-waitfram-action02 format "x(72)" no-label skip
      508     v-waitfram-action03 format "x(72)" no-label skip
      509     B-viewProcInfo
      510     B-WaitFramStop at row 4 col 30
      511     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      512     .
      513   define new global shared variable mBatchMode as logical no-undo init ?.
      514   define variable mFramBachModHandle as handle no-undo.
      515   mFramBachModHandle = frame waitfram:handle.
      516   define variable mFameOldVis as logical no-undo.
      517   define variable mVisCUrentVin as logical no-undo.
      518   if session:batch-mode
      519   then
      520      mBatchMode = yes.
      521   if mBatchMode = ? then do:
      522     mVisCUrentVin = current-window:visible.
      523     mFameOldVis = mFramBachModHandle:visible.
      524     mFramBachModHandle:visible  = yes.
      525     mBatchMode = mFramBachModHandle:visible ne yes.
      526     mFramBachModHandle:visible = mFameOldVis.
      527     current-window:visible = mVisCUrentVin.
      528   end.
      529    if  log-manager:logfile-name ne ?
      530     then DO:
      531         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      532         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      533         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      534     end.
      535   on choose of B-WaitFramStop in frame waitfram
      536   do:
      537     mWaitFramStop = yes.
      538     mWaitFramStopUser = yes.
      539   end.
      540   function waitfram-check-timeout returns logical():
      541      define variable vtime as int64 no-undo.
      542      if mWaitFramStopTimeOut
      543      then
      544         return yes.
      545      vtime = ( now - mWaitFramStartProc ) / 1000 .
      546      if     mWaitFramTimeOut ne ?
      547         and mWaitFramTimeOut ne 0
      548         and mWaitFramTimeOut lt vtime
      549      then do:
      550         mWaitFramStopTimeOut = yes.
      551      end.
      552      return mWaitFramStopTimeOut.
      553   end.
      554   procedure waitfram-hide :
      555     if not session:batch-mode
      556     then do
      557     on error undo, return error return-value
      558     :
      559       pause 0 before-hide .
      560       if not mBatchMode then
      561         hide frame waitfram .
      562     if     not mWaitFramView
      563        and mWaitProcEvent
      564     then
      565       process events .
      566     end.
      567   end procedure.
      568   procedure waitfram-show :
      569     define input  parameter p-message as character no-undo .
      570     define variable v-left-margin as integer   no-undo .
      571     if not session:batch-mode
      572     then do
      573     on error undo, return error return-value
      574     :
      575       if length(p-message) <= 70 then do:
      576         assign
      577           v-left-margin = integer((70 - length(p-message)) / 2)
      578         .
      579         assign
      580           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      581         .
      582         assign
      583           v-waitfram-action01 = " "
      584           v-waitfram-action02 = " "
      585                                    + fill(" ", v-left-margin)
      586                                    + p-message
      587           v-waitfram-action03 = " "
      588         .
      589       end.
      590       else do:
      591         define variable vRindex1 as integer no-undo.
      592         define variable vRindex2 as integer no-undo.
      593         vRindex1 = r-index(p-message," ",70).
      594         if vRindex1 = 0
      595         then
      596            vRindex1 = 70.
      597         if length(p-message)  <= vRindex1 + 70 then do:
      598           assign
      599             v-waitfram-action01 = " "
      600             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      601             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      602           .
      603         end.
      604         else do:
      605           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      606           if vRindex2 <= vRindex1
      607           then
      608              vRindex2 = vRindex1 + 70.
      609           assign
      610             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      611             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      612             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      613           .
      614         end.
      615       end.
      616       B-viewProcInfo:visible   in frame waitfram = no.
      617       B-viewProcInfo:sensitive in frame waitfram = no.
      618       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      619       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      620       if  (   mWaitFramView
      621          or  mWaitProcEvent)
      622          and not mBatchMode
      623       then
      624          display
      625             v-waitfram-action01 skip
      626             v-waitfram-action02 skip
      627             v-waitfram-action03 skip
      628          with frame waitfram .
      629       if     mWaitFramView
      630          then do:
      631             if     mWaitFramInterval ne ?
      632                and not mBatchMode
      633             then
      634                wait-for go of frame waitfram pause mWaitFramInterval.
      635          end.
      636          else
      637             if     mWaitProcEvent
      638                and not mBatchMode
      639             then
      640                process events .
      641     end.
      642   end procedure.
      643      procedure waitfram-show-this:
      644         define input  parameter iInterval as int64 no-undo.
      645         define variable vtime as int64 no-undo.
      646         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      647         mWaitFramInterval = iInterval.
      648         run waitfram-show (substitute("&1&2 &3&4" ,
      649                                       mWaitFramTextBeg ,
      650                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      651                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      652                                       mWaitFramTextEnd
      653                                      )
      654                           ).
      655      end.
      656      procedure WaitFramRunPause:
      657         define input  parameter iInterval as dec no-undo.
      658         define variable vStart  as datetime-tz no-undo.
      659         define variable vend    as datetime-tz no-undo.
      660         define variable vint as int64 no-undo.
      661         define variable vOk as logical no-undo.
      662         vStart = now.
      663         vend   = vStart.
      664         publish "WaitFramPause" (iInterval,output vOk).
      665         vend   =  now.
      666         vint = vend - vStart.
      667         vint = iInterval - vint / 1000.
      668         if     not mWaitFramStop
      669            and (   vint > 0
      670                 or (    not vOk
      671                     and iInterval eq ?
      672                     )
      673                 )
      674         then
      675            run waitfram-show-this (iInterval).
      676         vend   =  now.
      677         vint = vend - vStart.
      678         vint = iInterval - vint / 1000.
      679         if     not mWaitFramStop
      680            and vint > 0
      681         then do:
      682            run gbl/pause.p (vint * 1000).
      683         end.
      684         if iInterval ne ?
      685         then
      686            publish "WaitFramStop".
      687         waitfram-check-timeout().
      688      end.
      689      procedure WaitFramWaitFor:
      690         define input  parameter iInterval as dec no-undo.
      691         assign
      692            mWaitFramStartProc   = now
      693            mWaitFramStopUser    = no
      694            mWaitFramStopTimeOut = no
      695         .
      696         block-wait:
      697         do while not mWaitFramStop:
      698            run WaitFramRunPause (iInterval).
      699            if  waitfram-check-timeout()
      700            then do:
      701               leave block-wait.
      702            end.
      703         end.
      704         run waitfram-hide.
      705      end.
      706   procedure waitfram-join :
      707     define input  parameter p-line-1  as character no-undo .
      708     define input  parameter p-line-2  as character no-undo .
      709     define input  parameter p-line-3  as character no-undo .
      710     define output parameter p-message as character no-undo .
      711     do
      712     on error undo, return error return-value
      713     :
      714       assign
      715         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      716                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      717                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      718       .
      719     end.
      720   end procedure.
      721   function waitfram-join-function returns character
      722     (input p-line-1 as character
      723     ,input p-line-2 as character
      724     ,input p-line-3 as character
      725     ).
      726     define variable v-message as character no-undo .
      727     run waitfram-join in this-procedure
      728       (input  p-line-1
      729       ,input  p-line-2
      730       ,input  p-line-3
      731       ,output v-message
      732       ) .
      733     return v-message .
      734   end function .
      735   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      736   FUNCTION mark-string RETURNS CHARACTER
      737     ( input p-recid as recid, input mark-list as character  ) :
      738     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      739   END FUNCTION.
