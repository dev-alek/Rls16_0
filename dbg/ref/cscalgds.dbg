        1   DEFINE BUFFER buf_cli FOR ub.clients.
        2   DEFINE BUFFER for-c-scales-gds FOR ub.c-scales-gds.
        3   DEFINE BUFFER X_c-scales FOR ub.c-scales.
        4   DEFINE BUFFER X_c-scales-gds FOR ub.c-scales-gds.
        5   define input parameter parparentproc as widget-handle no-undo .
        6   DEFINE INPUT PARAMETER bttns  as character  no-undo .
        7   DEFINE INPUT PARAMETER parref-mode as character no-undo.
        8   DEFINE OUTPUT PARAMETER  p-rid-list    as  char no-undo .
        9   DEFINE INPUT PARAMETER pardb-num     like ub.sys-ctrl.db-num no-undo.
       10   define input parameter parscales-num like ub.scales-gds.scales-num no-undo .
       11   define input parameter parplu-code   like ub.scales-gds.plu-code no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":u .
       13   define variable vss-author      as character no-undo init "$Author$":u .
       14   define variable vss-date        as character no-undo init "$Date$":u .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       16   define variable vss-archive     as character no-undo init "$Archive$":u .
       17   define variable vss-description as character no-undo init "Справочник истории товара на весах" .
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   procedure cur-time :
      125      define output parameter p-today as date      no-undo .
      126      define output parameter p-time  as integer   no-undo .
      127     do
      128     on error undo, return error
      129     :
      130       define variable v-date1 as date      no-undo .
      131       define variable v-date2 as date      no-undo .
      132       define variable v-time  as integer   no-undo .
      133       assign
      134         v-date1 = today
      135         v-time  = time
      136         v-date2 = today
      137       .
      138       if v-date1 <> v-date2
      139       then do:
      140         assign
      141           v-date1 = today
      142           v-time  = v-time
      143         .
      144       end.
      145       assign
      146         p-today = v-date1
      147         p-time  = v-time
      148       .
      149     end.
      150   end.
      151   function cur-time-date returns character
      152   :
      153     return string(today, '99/99/9999':U) .
      154   end.
      155   function cur-time-mjd returns decimal
      156   :
      157     define variable v-date as date      no-undo .
      158     define variable v-time as integer   no-undo .
      159     run cur-time in this-procedure
      160       (output v-date
      161       ,output v-time
      162       ) .
      163     return integer(v-date) - 2400002 + (v-time / 86400) .
      164   end.
      165   function cur-time-get-ending-index returns integer
      166   (input p-number as integer
      167   )
      168   :
      169     if p-number < 0
      170     or p-number = ?
      171     then do:
      172       return 1 .
      173     end.
      174     define variable v-rest as integer   no-undo .
      175     assign
      176       p-number = p-number modulo 100
      177     .
      178     if p-number < 20
      179     then do:
      180       assign
      181         v-rest = p-number
      182       .
      183     end.
      184     else do:
      185       assign
      186         v-rest = p-number modulo 10
      187       .
      188     end.
      189     case v-rest :
      190       when 1
      191       then do:
      192         return 2 .
      193       end.
      194       when 2 or
      195       when 3 or
      196       when 4
      197       then do:
      198         return 3 .
      199       end.
      200       otherwise do:
      201         return 1 .
      202       end.
      203     end case .
      204   end.
      205   procedure cur-time-mjd-to-date :
      206      define input  parameter i-mjd-diff as decimal no-undo.
      207      define output parameter o-Date     as date    no-undo.
      208      define output parameter o-Time     as integer no-undo.
      209      define variable v-day-number as integer   no-undo .
      210      if    i-mjd-diff < 0
      211         or i-mjd-diff = ?
      212      then do:
      213         return "?" .
      214      end.
      215      assign
      216         v-day-number = truncate(i-mjd-diff,0).
      217         o-Date = date(v-day-number + 2400002).
      218         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      219     .
      220   end.
      221   function cur-time-mjd-to-string returns character
      222   (input p-mjd-diff as decimal
      223   )
      224   :
      225     define variable v-day-number as integer   no-undo .
      226     define variable v-seconds    as integer   no-undo .
      227     define variable v-hour       as integer   no-undo .
      228     define variable v-min        as integer   no-undo .
      229     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      230     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      231     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      232     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      233     if p-mjd-diff < 0
      234     or p-mjd-diff = ?
      235     then do:
      236       return "?" .
      237     end.
      238     assign
      239       v-day-number = integer(truncate(p-mjd-diff,0))
      240       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      241     .
      242     if v-seconds > 86400
      243     then do:
      244       assign
      245         v-seconds = 86400 - 1
      246       .
      247     end.
      248     if v-seconds < 0
      249     then do:
      250       assign
      251         v-seconds = 0
      252       .
      253     end.
      254     assign
      255       v-hour = truncate(v-seconds / 3600, 0)
      256     .
      257     assign
      258       v-seconds = v-seconds modulo 3600
      259     .
      260     assign
      261       v-min = truncate(v-seconds / 60, 0)
      262     .
      263     assign
      264       v-seconds = v-seconds modulo 60
      265     .
      266     return
      267         (if v-day-number <> 0
      268           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      269           else ""
      270         )
      271       + (if v-day-number <> 0 or v-hour <> 0
      272           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      273           else ""
      274         )
      275       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      276           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      277           else ""
      278         )
      279       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      280       .
      281   end.
      282   function cur-time-string returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-string-sec returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      301   end.
      302   function cur-time-custom  returns character
      303   (input p-prefix as character
      304   ,input p-date-format as character
      305   ,input p-delimiter as character
      306   ,input p-time-format as character
      307   ,input p-suffix as character
      308   )
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return
      317       p-prefix
      318       + string(v-date, p-date-format)
      319       + p-delimiter
      320       + string(v-time, p-time-format)
      321       + p-suffix
      322       .
      323   end.
      324   function cur-time-print  returns character
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      333   end.
      334   function cur-time-datetime returns datetime
      335   :
      336     define variable v-char as character no-undo .
      337     define variable v-datetime as datetime no-undo .
      338     v-char = cur-time-string().
      339     v-datetime = datetime(v-char).
      340     return  v-datetime.
      341   end.
      342   function cur-time-string-msec returns character
      343   :
      344     define variable v-date as datetime  no-undo .
      345     v-date = now.
      346     return string(v-date) .
      347   end.
      348   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      350   define new shared variable RepPathName        as character no-undo .
      351   define new shared variable PrintRubl          as logical   no-undo .
      352   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   procedure wth-lib_cur-stock-place:
      354   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      355   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      356   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
      357   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
      358   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
      359   define buffer bf_wth-pobj for ub.wth-pobj.
      360   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
      361                                bf_wth-pobj.obj-code = parobj-code and
      362                                bf_wth-pobj.w-p-code = parw-p-code and
      363                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
      364   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
      365                            else assign parstock = 0.
      366   end procedure.
      367   procedure wth-lib_cur-stock-obj:
      368   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      369   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      370   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
      371   define output parameter parstock    like ub.wth-obj.income     no-undo.
      372   define buffer bf_wth-obj for ub.wth-obj.
      373   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      374                               bf_wth-obj.obj-code = parobj-code and
      375                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      376   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
      377                           else assign parstock = 0.
      378   end.
      379   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
      380                                                        INPUT parobj-code AS INTEGER,
      381                                                        INPUT parwth-code AS INTEGER):
      382   define buffer bf_wth-obj for ub.wth-obj.
      383   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      384                               bf_wth-obj.obj-code = parobj-code and
      385                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      386   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
      387                           else return 0.00.
      388   end function.
      389   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
      390                                                         INPUT parwth-code  AS INTEGER):
      391   define buffer bf_wth-obj for ub.wth-obj.
      392   define variable v-stock like ub.wth-obj.income no-undo.
      393   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
      394                                     bf_wth-obj.wth-code = parwth-code :
      395     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
      396   end.
      397   return v-stock.
      398   end function.
      399   procedure wth-lib_full-inf-shift:
      400   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date and                        cur_wth-line.shift-num  = parshift-num  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      401   end procedure.
      402   procedure wth-lib_full-inf-shift-inter:
      403   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                        define input  parameter parshift-date1  like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num1   like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                     