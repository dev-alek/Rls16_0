        1   define input parameter  parparentproc as widget-handle no-undo .
        2   define output parameter p-rid-list as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Список активных резервуаров".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   procedure cur-time :
      116      define output parameter p-today as date      no-undo .
      117      define output parameter p-time  as integer   no-undo .
      118     do
      119     on error undo, return error
      120     :
      121       define variable v-date1 as date      no-undo .
      122       define variable v-date2 as date      no-undo .
      123       define variable v-time  as integer   no-undo .
      124       assign
      125         v-date1 = today
      126         v-time  = time
      127         v-date2 = today
      128       .
      129       if v-date1 <> v-date2
      130       then do:
      131         assign
      132           v-date1 = today
      133           v-time  = v-time
      134         .
      135       end.
      136       assign
      137         p-today = v-date1
      138         p-time  = v-time
      139       .
      140     end.
      141   end.
      142   function cur-time-date returns character
      143   :
      144     return string(today, '99/99/9999':U) .
      145   end.
      146   function cur-time-mjd returns decimal
      147   :
      148     define variable v-date as date      no-undo .
      149     define variable v-time as integer   no-undo .
      150     run cur-time in this-procedure
      151       (output v-date
      152       ,output v-time
      153       ) .
      154     return integer(v-date) - 2400002 + (v-time / 86400) .
      155   end.
      156   function cur-time-get-ending-index returns integer
      157   (input p-number as integer
      158   )
      159   :
      160     if p-number < 0
      161     or p-number = ?
      162     then do:
      163       return 1 .
      164     end.
      165     define variable v-rest as integer   no-undo .
      166     assign
      167       p-number = p-number modulo 100
      168     .
      169     if p-number < 20
      170     then do:
      171       assign
      172         v-rest = p-number
      173       .
      174     end.
      175     else do:
      176       assign
      177         v-rest = p-number modulo 10
      178       .
      179     end.
      180     case v-rest :
      181       when 1
      182       then do:
      183         return 2 .
      184       end.
      185       when 2 or
      186       when 3 or
      187       when 4
      188       then do:
      189         return 3 .
      190       end.
      191       otherwise do:
      192         return 1 .
      193       end.
      194     end case .
      195   end.
      196   procedure cur-time-mjd-to-date :
      197      define input  parameter i-mjd-diff as decimal no-undo.
      198      define output parameter o-Date     as date    no-undo.
      199      define output parameter o-Time     as integer no-undo.
      200      define variable v-day-number as integer   no-undo .
      201      if    i-mjd-diff < 0
      202         or i-mjd-diff = ?
      203      then do:
      204         return "?" .
      205      end.
      206      assign
      207         v-day-number = truncate(i-mjd-diff,0).
      208         o-Date = date(v-day-number + 2400002).
      209         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      210     .
      211   end.
      212   function cur-time-mjd-to-string returns character
      213   (input p-mjd-diff as decimal
      214   )
      215   :
      216     define variable v-day-number as integer   no-undo .
      217     define variable v-seconds    as integer   no-undo .
      218     define variable v-hour       as integer   no-undo .
      219     define variable v-min        as integer   no-undo .
      220     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      221     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      222     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      223     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      224     if p-mjd-diff < 0
      225     or p-mjd-diff = ?
      226     then do:
      227       return "?" .
      228     end.
      229     assign
      230       v-day-number = integer(truncate(p-mjd-diff,0))
      231       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      232     .
      233     if v-seconds > 86400
      234     then do:
      235       assign
      236         v-seconds = 86400 - 1
      237       .
      238     end.
      239     if v-seconds < 0
      240     then do:
      241       assign
      242         v-seconds = 0
      243       .
      244     end.
      245     assign
      246       v-hour = truncate(v-seconds / 3600, 0)
      247     .
      248     assign
      249       v-seconds = v-seconds modulo 3600
      250     .
      251     assign
      252       v-min = truncate(v-seconds / 60, 0)
      253     .
      254     assign
      255       v-seconds = v-seconds modulo 60
      256     .
      257     return
      258         (if v-day-number <> 0
      259           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      260           else ""
      261         )
      262       + (if v-day-number <> 0 or v-hour <> 0
      263           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      264           else ""
      265         )
      266       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      267           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      268           else ""
      269         )
      270       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      271       .
      272   end.
      273   function cur-time-string returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      282   end.
      283   function cur-time-string-sec returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      292   end.
      293   function cur-time-custom  returns character
      294   (input p-prefix as character
      295   ,input p-date-format as character
      296   ,input p-delimiter as character
      297   ,input p-time-format as character
      298   ,input p-suffix as character
      299   )
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return
      308       p-prefix
      309       + string(v-date, p-date-format)
      310       + p-delimiter
      311       + string(v-time, p-time-format)
      312       + p-suffix
      313       .
      314   end.
      315   function cur-time-print  returns character
      316   :
      317     define variable v-date as date      no-undo .
      318     define variable v-time as integer   no-undo .
      319     run cur-time in this-procedure
      320       (output v-date
      321       ,output v-time
      322       ) .
      323     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      324   end.
      325   function cur-time-datetime returns datetime
      326   :
      327     define variable v-char as character no-undo .
      328     define variable v-datetime as datetime no-undo .
      329     v-char = cur-time-string().
      330     v-datetime = datetime(v-char).
      331     return  v-datetime.
      332   end.
      333   function cur-time-string-msec returns character
      334   :
      335     define variable v-date as datetime  no-undo .
      336     v-date = now.
      337     return string(v-date) .
      338   end.
      339   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340     define variable v-cntxt-db-num        as integer   no-undo .
      341     define variable v-cntxt-userid        as character no-undo .
      342     define variable v-cntxt-level         as character no-undo .
      343     define variable v-cntxt-host-code-obj as integer   no-undo .
      344     define variable v-cntxt-obj-type      as character no-undo .
      345     define variable v-cntxt-obj-code      as integer   no-undo .
      346     define variable v-cntxt-db-num-obj    as integer   no-undo .
      347     define variable v-cntxt-is-admin      as logical   no-undo .
      348   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349     run mainmenu_getcntxt in parparentproc
      350       (output v-cntxt-db-num
      351       ,output v-cntxt-userid
      352       ,output v-cntxt-level
      353       ,output v-cntxt-host-code-obj
      354       ,output v-cntxt-obj-type
      355       ,output v-cntxt-obj-code
      356       ,output v-cntxt-db-num-obj
      357       ,output v-cntxt-is-admin
      358       ) .
      359   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   define variable v-waitfram-action01         as character   no-undo .
      361   define variable v-waitfram-action02         as character   no-undo .
      362   define variable v-waitfram-action03         as character   no-undo .
      363   define variable mWaitFramTextBeg            as character   no-undo.
      364   define variable mWaitFramTextEnd            as character   no-undo.
      365   define variable mWaitFramView               as logical     no-undo.
      366   define variable mWaitProcEvent              as logical     no-undo init yes.
      367   define variable mWaitFramInterval           as integer     no-undo init 1 .
      368   define variable mWaitFramStop               as logical     no-undo.
      369   define variable mWaitFramStopUser           as logical     no-undo.
      370   define variable mWaitFramStopTimeOut        as logical     no-undo.
      371   define variable mWaitFramStartProc          as datetime-tz no-undo.
      372   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      373   define button B-WaitFramStop auto-end-key
      374        label "Стоп"
      375        size 10 by 1 tooltip "Остоновить процесс".
      376   define button B-viewProcInfo
      377        label "Информация"
      378        size 15 by 1 tooltip "Информация о процесс".
      379   define frame waitfram
      380     v-waitfram-action01 format "x(72)" no-label skip
      381     v-waitfram-action02 format "x(72)" no-label skip
      382     v-waitfram-action03 format "x(72)" no-label skip
      383     B-viewProcInfo
      384     B-WaitFramStop at row 4 col 30
      385     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      386     .
      387   define new global shared variable mBatchMode as logical no-undo init ?.
      388   define variable mFramBachModHandle as handle no-undo.
      389   mFramBachModHandle = frame waitfram:handle.
      390   define variable mFameOldVis as logical no-undo.
      391   define variable mVisCUrentVin as logical no-undo.
      392   if session:batch-mode
      393   then
      394      mBatchMode = yes.
      395   if mBatchMode = ? then do:
      396     mVisCUrentVin = current-window:visible.
      397     mFameOldVis = mFramBachModHandle:visible.
      398     mFramBachModHandle:visible  = yes.
      399     mBatchMode = mFramBachModHandle:visible ne yes.
      400     mFramBachModHandle:visible = mFameOldVis.
      401     current-window:visible = mVisCUrentVin.
      402   end.
      403    if  log-manager:logfile-name ne ?
      404     then DO:
      405         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      406         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      407         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      408     end.
      409   on choose of B-WaitFramStop in frame waitfram
      410   do:
      411     mWaitFramStop = yes.
      412     mWaitFramStopUser = yes.
      413   end.
      414   function waitfram-check-timeout returns logical():
      415      define variable vtime as int64 no-undo.
      416      if mWaitFramStopTimeOut
      417      then
      418         return yes.
      419      vtime = ( now - mWaitFramStartProc ) / 1000 .
      420      if     mWaitFramTimeOut ne ?
      421         and mWaitFramTimeOut ne 0
      422         and mWaitFramTimeOut lt vtime
      423      then do:
      424         mWaitFramStopTimeOut = yes.
      425      end.
      426      return mWaitFramStopTimeOut.
      427   end.
      428   procedure waitfram-hide :
      429     if not session:batch-mode
      430     then do
      431     on error undo, return error return-value
      432     :
      433       pause 0 before-hide .
      434       if not mBatchMode then
      435         hide frame waitfram .
      436     if     not mWaitFramView
      437        and mWaitProcEvent
      438     then
      439       process events .
      440     end.
      441   end procedure.
      442   procedure waitfram-show :
      443     define input  parameter p-message as character no-undo .
      444     define variable v-left-margin as integer   no-undo .
      445     if not session:batch-mode
      446     then do
      447     on error undo, return error return-value
      448     :
      449       if length(p-message) <= 70 then do:
      450         assign
      451           v-left-margin = integer((70 - length(p-message)) / 2)
      452         .
      453         assign
      454           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      455         .
      456         assign
      457           v-waitfram-action01 = " "
      458           v-waitfram-action02 = " "
      459                                    + fill(" ", v-left-margin)
      460                                    + p-message
      461           v-waitfram-action03 = " "
      462         .
      463       end.
      464       else do:
      465         define variable vRindex1 as integer no-undo.
      466         define variable vRindex2 as integer no-undo.
      467         vRindex1 = r-index(p-message," ",70).
      468         if vRindex1 = 0
      469         then
      470            vRindex1 = 70.
      471         if length(p-message)  <= vRindex1 + 70 then do:
      472           assign
      473             v-waitfram-action01 = " "
      474             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      475             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      476           .
      477         end.
      478         else do:
      479           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      480           if vRindex2 <= vRindex1
      481           then
      482              vRindex2 = vRindex1 + 70.
      483           assign
      484             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      485             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      486             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      487           .
      488         end.
      489       end.
      490       B-viewProcInfo:visible   in frame waitfram = no.
      491       B-viewProcInfo:sensitive in frame waitfram = no.
      492       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      493       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      494       if  (   mWaitFramView
      495          or  mWaitProcEvent)
      496          and not mBatchMode
      497       then
      498          display
      499             v-waitfram-action01 skip
      500             v-waitfram-action02 skip
      501             v-waitfram-action03 skip
      502          with frame waitfram .
      503       if     mWaitFramView
      504          then do:
      505             if     mWaitFramInterval ne ?
      506                and not mBatchMode
      507             then
      508                wait-for go of frame waitfram pause mWaitFramInterval.
      509          end.
      510          else
      511             if     mWaitProcEvent
      512                and not mBatchMode
      513             then
      514                process events .
      515     end.
      516   end procedure.
      517      procedure waitfram-show-this:
      518         define input  parameter iInterval as int64 no-undo.
      519         define variable vtime as int64 no-undo.
      520         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      521         mWaitFramInterval = iInterval.
      522         run waitfram-show (substitute("&1&2 &3&4" ,
      523                                       mWaitFramTextBeg ,
      524                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      525                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      526                                       mWaitFramTextEnd
      527                                      )
      528                           ).
      529      end.
      530      procedure WaitFramRunPause:
      531         define input  parameter iInterval as dec no-undo.
      532         define variable vStart  as datetime-tz no-undo.
      533         define variable vend    as datetime-tz no-undo.
      534         define variable vint as int64 no-undo.
      535         define variable vOk as logical no-undo.
      536         vStart = now.
      537         vend   = vStart.
      538         publish "WaitFramPause" (iInterval,output vOk).
      539         vend   =  now.
      540         vint = vend - vStart.
      541         vint = iInterval - vint / 1000.
      542         if     not mWaitFramStop
      543            and (   vint > 0
      544                 or (    not vOk
      545                     and iInterval eq ?
      546                     )
      547                 )
      548         then
      549            run waitfram-show-this (iInterval).
      550         vend   =  now.
      551         vint = vend - vStart.
      552         vint = iInterval - vint / 1000.
      553         if     not mWaitFramStop
      554            and vint > 0
      555         then do:
      556            run gbl/pause.p (vint * 1000).
      557         end.
      558         if iInterval ne ?
      559         then
      560            publish "WaitFramStop".
      561         waitfram-check-timeout().
      562      end.
      563      procedure WaitFramWaitFor:
      564         define input  parameter iInterval as dec no-undo.
      565         assign
      566            mWaitFramStartProc   = now
      567            mWaitFramStopUser    = no
      568            mWaitFramStopTimeOut = no
      569         .
      570         block-wait:
      571         do while not mWaitFramStop:
      572            run WaitFramRunPause (iInterval).
      573            if  waitfram-check-timeout()
      574            then do:
      575               leave block-wait.
      576            end.
      577         end.
      578         run waitfram-hide.
      579      end.
      580   procedure waitfram-join :
      581     define input  parameter p-line-1  as character no-undo .
      582     define input  parameter p-line-2  as character no-undo .
      583     define input  parameter p-line-3  as character no-undo .
      584     define output parameter p-message as character no-undo .
      585     do
      586     on error undo, return error return-value
      587     :
      588       assign
      589         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      590                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      591                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      592       .
      593     end.
      594   end procedure.
      595   function waitfram-join-function returns character
      596     (input p-line-1 as character
      597     ,input p-line-2 as character
      598     ,input p-line-3 as character
      599     ).
      600     define variable v-message as character no-undo .
      601     run waitfram-join in this-procedure
      602       (input  p-line-1
      603       ,input  p-line-2
      604       ,input  p-line-3
      605       ,output v-message
      606       ) .
      607     return v-message .
      608   end function .
