      610   FUNCTION mark-string RETURNS CHARACTER
      611     ( input p-recid as recid, input mark-list as character  ) :
      612     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      613   END FUNCTION.
