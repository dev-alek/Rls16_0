      687   procedure create_obj-list :
      688      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      689      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      690      do
      691      on error undo, return error return-value
      692      :
      693         define buffer cli-obj for ub.clients .
      694         define variable p-var as integer no-undo .
      695         define buffer buf_obj-list for obj-list .
      696         find last buf_obj-list  use-index pi no-error .
      697         if available buf_obj-list
      698         then
      699            p-var = buf_obj-list.obj-id + 1.
      700         else
      701            p-var = 1.
      702         find first cli-obj where
      703                   cli-obj.obj-type = p-obj-type
      704               and cli-obj.obj-code = p-obj-code
      705         no-lock no-error.
      706         if available cli-obj
      707         then do:
      708            create buf_obj-list.
      709            assign
      710               buf_obj-list.obj-id   = p-var
      711               buf_obj-list.obj-code = cli-obj.obj-code
      712               buf_obj-list.obj-type = cli-obj.obj-type
      713               buf_obj-list.obj-name = cli-obj.obj-name
      714               buf_obj-list.db-num   = cli-obj.db-num
      715            .
      716         end.
      717      end.
      718   end.
