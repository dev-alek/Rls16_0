     1079     Col-name[228]=   'HT':U
     1080     Col-name[229]=   'HU':U
     1081     Col-name[230]=   'HV':U
     1082     Col-name[231]=   'HW':U
     1083     Col-name[232]=   'HX':U
     1084     Col-name[233]=   'HY':U
     1085     Col-name[234]=   'HZ':U
     1086     Col-name[235]=   'IA':U
     1087     Col-name[236]=   'IB':U
     1088     Col-name[237]=   'IC':U
     1089     Col-name[238]=   'ID':U
     1090     Col-name[239]=   'IE':U
