     1108     .
     1109    end.
     1110   end procedure.
     1111   define variable var-report-r-b as character no-undo .
     1112   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1113   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1114     (output var-report-r-b
     1115     )  .
     1116   define variable row_place  as recid     no-undo .
     1117   define variable v-rid-list as character no-undo .
     1118   define buffer tt-place for ub.place .
     1119   FUNCTION obj-name RETURNS CHARACTER
     1120     ( input p-obj-code as integer, input p-obj-type as character )  FORWARD.
     1121   DEFINE BUTTON b-exit AUTO-GO
     1122     LABEL "&Выход ":L
     1123     SIZE 10 BY 1.
     1124   DEFINE BUTTON b-mark
     1125     LABEL "&*"
     1126     SIZE 3 BY 1.
     1127   DEFINE BUTTON b-sel AUTO-GO
     1128     LABEL "&Выбор":L
     1129     SIZE 10 BY 1.
     1130   DEFINE BUTTON bt-not-sel-all
     1131     LABEL "+"
     1132     SIZE 3 BY 1 TOOLTIP "Выбрать все".
     1133   DEFINE BUTTON bt-not-sel-desel-all
     1134     LABEL "-"
     1135     SIZE 3 BY 1 TOOLTIP "Отменить выбор".
     1136   DEFINE QUERY br-pl FOR
     1137     obj-list,
     1138     tt-place SCROLLING.
     1139   DEFINE BROWSE br-pl
     1140     QUERY br-pl NO-LOCK DISPLAY
     1141     mark-string( input recid(tt-place), input v-rid-list) column-label "*" format "X(1)":U
     1142     tt-place.obj-code COLUMN-LABEL "Код объекта" FORMAT "9999999999":U
     1143     WIDTH 11.25
     1144     obj-name(input tt-place.obj-code, input tt-place.obj-type) COLUMN-LABEL "Наименование объекта" FORMAT "X(256)":U
     1145     WIDTH 21
     1146     tt-place.pl-code COLUMN-LABEL "Код резервуара" FORMAT "999999999999999":U
     1147     WIDTH 17
     1148     tt-place.loc1 FORMAT "X(8)":U WIDTH 22
     1149     tt-place.pl-name COLUMN-LABEL "Наименование резервуара" FORMAT "X(40)":U
     1150     WIDTH 54.88
     1151       WITH NO-ROW-MARKERS SEPARATORS SIZE 131 BY 16.5 FIT-LAST-COLUMN.
     1152   DEFINE FRAME d-place
     1153     b-exit AT ROW 1 COL 1.63 WIDGET-ID 2
     1154     b-sel AT ROW 1 COL 11.38 WIDGET-ID 302
     1155     bt-not-sel-all AT ROW 2.25 COL 1.63 WIDGET-ID 10 NO-TAB-STOP
     1156     bt-not-sel-desel-all AT ROW 2.25 COL 4.63 WIDGET-ID 12 NO-TAB-STOP
     1157     b-mark AT ROW 2.25 COL 7.63 WIDGET-ID 4 NO-TAB-STOP
     1158     br-pl AT ROW 3.25 COL 1.25 WIDGET-ID 200
     1159     SPACE(0.00) SKIP(0.32)
     1160     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1161     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1162     TITLE "Список активных резервуаров" WIDGET-ID 100.
     1163   ASSIGN
     1164     FRAME d-place:SCROLLABLE = FALSE
     1165     FRAME d-place:HIDDEN     = TRUE.
     1166   ASSIGN
     1167     br-pl:COLUMN-RESIZABLE IN FRAME d-place = TRUE.
     1168   ON WINDOW-CLOSE OF FRAME d-place
     1169     DO:
     1170       APPLY "END-ERROR":U TO SELF.
     1171     END.
     1172   ON CHOOSE OF b-mark IN FRAME d-place
     1173     DO:
     1174       define variable loc#log as logical no-undo .
     1175       if available tt-place then
     1176       do:
     1177   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1178   define variable v-str-recid13 as character no-undo .
     1179   define variable v-num-entry13 as integer   no-undo .
     1180   assign
     1181     v-str-recid13 = trim( string( recid( tt-place ) , "->>>>>>>>>>>9":U ) )
     1182     v-num-entry13 = lookup( v-str-recid13 , v-rid-list )
     1183   .
     1184   if v-num-entry13 > 0 then do:
     1185     assign
     1186       entry( v-num-entry13, v-rid-list ) = "":U
     1187       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1188     .
     1189   end.
     1190   else do:
     1191     assign
     1192       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid13
     1193     .
     1194   end.
     1195         row_place = recid(tt-place).
     1196         loc#log = br-pl:refresh() .
     1197         reposition br-pl to recid row_place no-error.
     1198         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
     1199         do:
     1200           loc#log = br-pl:select-next-row ().
     1201           apply "VALUE-CHANGED" to br-pl in frame d-place.
     1202         end.
     1203       end.
     1204       apply "entry" to br-pl in frame d-place.
     1205     END.
     1206   ON CHOOSE OF b-sel IN FRAME d-place
     1207     DO:
     1208       define buffer buf_place for ub.place .
     1209       define variable vv       as integer   no-undo .
     1210       define variable rid-list as character no-undo .
     1211       if v-rid-list = "" then
     1212       do:
     1213         if available (tt-place) then
     1214         do:
     1215           v-rid-list = string(recid(tt-place)) .
     1216         end.
     1217       end.
     1218       p-rid-list = v-rid-list .
     1219     END.
     1220   ON CHOOSE OF bt-not-sel-all IN FRAME d-place
     1221     DO:
     1222       define variable loc#log as logical no-undo .
     1223       if available tt-place then
     1224       do:
     1225         v-rid-list = "" .
     1226         for each tt-place no-lock:
     1227   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1228   define variable v-str-recid15 as character no-undo .
     1229   define variable v-num-entry15 as integer   no-undo .
     1230   assign
     1231     v-str-recid15 = trim( string( recid( tt-place ) , "->>>>>>>>>>>9":U ) )
     1232     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1233   .
     1234   if v-num-entry15 > 0 then do:
     1235     assign
     1236       entry( v-num-entry15, v-rid-list ) = "":U
     1237       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1238     .
     1239   end.
     1240   else do:
     1241     assign
     1242       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1243     .
     1244   end.
     1245           loc#log = br-pl:refresh() .
     1246         end.
     1247       end.
     1248     END.
     1249   ON CHOOSE OF bt-not-sel-desel-all IN FRAME d-place
     1250     DO:
     1251       define variable loc#log as logical no-undo .
     1252       v-rid-list = "" .
     1253       loc#log = br-pl:refresh() .
     1254     END.
     1255   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-place:PARENT eq ?
     1256     THEN FRAME d-place:PARENT = ACTIVE-WINDOW.
     1257   MAIN-BLOCK:
     1258   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1259     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1260   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1261   do:
     1262     br-pl :SET-REPOSITIONED-ROW(9, "CONDITIONAL") .
     1263   end.
     1264     RUN enable_UI.
     1265     WAIT-FOR GO OF FRAME d-place.
     1266   END.
     1267   RUN disable_UI.
     1268   PROCEDURE disable_UI :
     1269     HIDE FRAME d-place.
     1270   END PROCEDURE.
     1271   PROCEDURE enable_UI :
     1272     ENABLE b-exit b-sel b-mark br-pl bt-not-sel-desel-all bt-not-sel-all
     1273       WITH FRAME d-place.
     1274     VIEW FRAME d-place.
     1275     OPEN QUERY br-pl FOR EACH                           obj-list NO-LOCK,                                  EACH tt-place WHERE                           tt-place.obj-code = obj-list.obj-code and                           tt-place.obj-type = obj-list.obj-type                           NO-LOCK.
     1276   END PROCEDURE.
     1277   FUNCTION obj-name RETURNS CHARACTER
     1278     ( input p-obj-code as integer,
     1279     input p-obj-type as character ) :
     1280     find first ub.clients no-lock where ub.clients.obj-code = p-obj-code and
     1281       ub.clients.obj-type = p-obj-type no-error .
     1282     if available (ub.clients) then return ub.clients.obj-name .
     1283   END FUNCTION.
