        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo.
        3   define input  parameter iMode as character no-undo.
        4   define input  parameter i-id as int64 no-undo.
        5   define input  parameter i-obj-code as integer no-undo.
        6   define input  parameter i-obj-type as character no-undo.
        7       define variable v-brw as class ibs.th.ref.cashbookobj no-undo .
        8       v-brw = new ibs.th.ref.cashbookobj (parparentproc, iMode, i-id, i-obj-code, i-obj-type ).
        9       subscribe   to "getNextseq"     anywhere run-procedure "local-getNextseq".
       10       wait-for  v-brw:ShowDialog() .
       11       unsubscribe to "getNextseq".
       12    define variable mSeqSave as integer no-undo init ?.
       13     procedure local-getNextseq:
       14        define input  parameter iseqnamehist    as character no-undo.
       15        define input  parameter idb-name_schema as character no-undo.
       16        define output parameter oSeq            as int64 no-undo.
       17        if iseqnamehist ne "s-c-cashbook-chip-num"
       18        then
       19           oSeq = ?.
       20        else if mSeqSave = ?
       21        then
       22           assign
       23              mSeqSave = dynamic-next-value (iseqnamehist, idb-name_schema)
       24              oSeq     = mSeqSave
       25           .
       26        else
       27           oSeq = mSeqSave.
       28    end.
       29       define variable v-err-msg as character no-undo .
       30       catch exAppErrors as class Progress.Lang.AppError :
       31         v-err-msg = exAppErrors:ReturnValue .
       32         if v-err-msg > "" then .
       33         else
       34         do :
       35           v-err-msg = exAppErrors:GetMessage(1) .
       36           if v-err-msg > "" then .
       37           else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\cashbookobj.p" .
       38         end .
       39         message v-err-msg  view-as alert-box.
       40       end catch .
       41       catch exProErrors as class Progress.Lang.ProError :
       42         v-err-msg = exProErrors:GetMessage(1) .
       43         if v-err-msg > "" then .
       44         else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\cashbookobj.p" .
       45         message "ProError" skip(1) v-err-msg  view-as alert-box.
       46       end catch .
       47       catch exAnyErrors as class Progress.Lang.Error:
       48         v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\cashbookobj.p " + exAnyErrors:GetMessage(1).
       49         message "LangError" skip(1) v-err-msg  view-as alert-box.
       50       end catch .
       51       finally:
       52         if valid-object(v-brw) then delete object v-brw no-error .
       53       end finally.
