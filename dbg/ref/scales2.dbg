        1   block-level on error undo, throw.
        2   define input parameter par-recid as recid no-undo.
        3   define input-output parameter par-sts like ub.scales.sts no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: scales2.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: ref/scales2.p $":U .
        9   define variable vss-description as character no-undo init "Изменение статуса весов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   DEFINE VARIABLE loc#log as logical no-undo .
       80   DEFINE BUFFER bf_scales for ub.scales.
       81   DEFINE VARIABLE choice as logical no-undo .
       82   DEFINE VARIABLE varold-sts like ub.scales.sts no-undo .
       83   define variable v-to-send as logical no-undo .
       84   define variable v-scales-num as integer no-undo .
       85   define variable v-scales-name as character no-undo .
       86   define variable v-scales-master as integer no-undo .
       87   _main:
       88   do
       89   on error undo, return error
       90   :
       91   FIND FIRST bf_scales WHERE
       92              recid(bf_scales) = par-recid.
       93   v-scales-num = bf_scales.scales-num.
       94   v-scales-name = bf_scales.scales-name.
       95   v-scales-master = bf_scales.master.
       96   varold-sts = bf_scales.sts.
       97   if par-sts = ? then do:
       98     CASE varold-sts:
       99       when integer('0':U) then do:
      100         assign
      101         par-sts = integer('1':U).
      102       end.
      103       when integer('1':U) then do:
      104         assign
      105         par-sts = integer('0':U).
      106       end.
      107     END CASE.
      108   end.
      109   CASE par-sts:
      110     WHEN integer('0':U) then do:
      111       if integer('0':U) = bf_scales.sts  then do:
      112         message "Весы уже имеют статус ТЕКУЩИЙ!"
      113         view-as alert-box ERROR.
      114         par-sts = ?.
      115         return error.
      116       end.
      117       else do:
      118         if bf_scales.master <> 0 then do:
      119           assign
      120           v-to-send = yes.
      121         end.
      122         message
      123         "Весы удалены - восстановить?"
      124         view-as alert-box QUestion buttons YEs-no update choice.
      125       end.
      126     end.
      127     WHEN integer('1':U) then do:
      128       if integer('1':U) = bf_scales.sts  then do:
      129         message "Весы уже имеют статус УДАЛЕН!"
      130         view-as alert-box ERROR.
      131         par-sts = ?.
      132         return error.
      133       end.
      134       else do:
      135         message
      136         "Выключить весы?" skip
      137         string(if can-find(first ub.scales no-lock where
      138                               ub.scales.db-num = bf_scales.db-num
      139                            AND ub.scales.master = bf_scales.scales-num)
      140         then "При выключении ГЛАВНЫХ весов Вы не сможете пересылать товары на подчиненные весы"
      141         else "":U)
      142         view-as alert-box QUestion buttons yes-no update choice.
      143       end.
      144     end.
      145   END CASE.
      146   if choice then do:
      147     run proc-on-off in this-procedure (input-output par-sts) no-error.
      148   end.
      149   if error-status:error then do:
      150     undo _main, return error return-value .
      151   end.
      152   par-sts = ?.
      153   if v-to-send then do:
      154     message
      155     substitute("Для корректной работы весов №&1 &2,&3" +
      156               "которые являются подчиненными,&3"  +
      157               "необходимо переслать ВСЕ ТОВАРЫ&4на их ГЛАВНЫЕ весы №4"
      158               , v-scales-num
      159               , v-scales-name
      160               , chr(10)
      161               , v-scales-master)
      162     view-as alert-box WARNING.
      163   end.
      164   end.
      165   procedure proc-on-off:
      166   define input-output parameter par-sts like ub.scales.sts no-undo .
      167   define variable num-scls as integer no-undo .
      168   define variable ii-num-scls as integer no-undo .
      169   define variable conf-par as character no-undo .
      170   define variable par-type as character no-undo .
      171   define buffer buf_scales for ub.scales.
      172     do
      173     on error undo, return error
      174     :
      175       if par-sts = integer('0':U) then do:
      176   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      177     (input  'num-scls'
      178     ,input  ''
      179     ,input  ''
      180     ,input  0
      181     ,input  ''
      182     ,input  ''
      183     ,input  '':U
      184     ,input  yes
      185     ,output conf-par
      186     ,output par-type
      187     ) no-error .
      188         if error-status:error then undo, return error substitute("Ошибка при чтении значения параметра num-scls&1&2&3"
      189                                                                  , chr(10)
      190                                                                  , error-status:get-message(1)
      191                                                                  ,return-value ).
      192         if par-type <> "I" then do:
      193           message
      194           "Неправильный тип параметра num-scls (должно быть integer)."
      195           view-as alert-box error.
      196           undo , return error "":U.
      197         end.
      198         assign
      199         num-scls = integer(conf-par)
      200         no-error .
      201         if error-status:error then do:
      202           message
      203           substitute("Неправильное значение параметра num-scls:&1 (должно быть integer).", conf-par)
      204           view-as alert-box error.
      205           undo , return error "":U.
      206         end.
      207         if num-scls = 0 then do:
      208           undo , return error substitute("В Вашей системе запрещена работа с весами в данной БД: значение параметра num-scls = &1", num-scls).
      209         end.
      210         else do:
      211         end.
      212       end.
      213       assign
      214       bf_scales.sts = par-sts.
      215       release bf_scales no-error .
      216       if error-status:error then do:
      217         undo , return error return-value  .
      218       end.
      219       par-sts = ?.
      220     end.
      221   end procedure.
