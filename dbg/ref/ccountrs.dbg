        1   DEFINE BUFFER X_c-country FOR ub.c-country.
        2   DEFINE BUFFER X_country FOR ub.country.
        3   DEFINE BUFFER X_curr_clients FOR ub.clients.
        4   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter bttns  as char   no-undo .
