      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      131   define new shared variable RepPathName        as character no-undo .
      132   define new shared variable PrintRubl          as logical   no-undo .
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define variable v-waitfram-action01         as character   no-undo .
      135   define variable v-waitfram-action02         as character   no-undo .
      136   define variable v-waitfram-action03         as character   no-undo .
      137   define variable mWaitFramTextBeg            as character   no-undo.
      138   define variable mWaitFramTextEnd            as character   no-undo.
      139   define variable mWaitFramView               as logical     no-undo.
      140   define variable mWaitProcEvent              as logical     no-undo init yes.
      141   define variable mWaitFramInterval           as integer     no-undo init 1 .
      142   define variable mWaitFramStop               as logical     no-undo.
      143   define variable mWaitFramStopUser           as logical     no-undo.
      144   define variable mWaitFramStopTimeOut        as logical     no-undo.
      145   define variable mWaitFramStartProc          as datetime-tz no-undo.
      146   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      147   define button B-WaitFramStop auto-end-key
      148        label "Стоп"
      149        size 10 by 1 tooltip "Остоновить процесс".
      150   define button B-viewProcInfo
      151        label "Информация"
      152        size 15 by 1 tooltip "Информация о процесс".
      153   define frame waitfram
      154     v-waitfram-action01 format "x(72)" no-label skip
      155     v-waitfram-action02 format "x(72)" no-label skip
      156     v-waitfram-action03 format "x(72)" no-label skip
      157     B-viewProcInfo
      158     B-WaitFramStop at row 4 col 30
      159     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      160     .
      161   define new global shared variable mBatchMode as logical no-undo init ?.
      162   define variable mFramBachModHandle as handle no-undo.
      163   mFramBachModHandle = frame waitfram:handle.
      164   define variable mFameOldVis as logical no-undo.
      165   define variable mVisCUrentVin as logical no-undo.
      166   if session:batch-mode
      167   then
      168      mBatchMode = yes.
      169   if mBatchMode = ? then do:
      170     mVisCUrentVin = current-window:visible.
      171     mFameOldVis = mFramBachModHandle:visible.
      172     mFramBachModHandle:visible  = yes.
      173     mBatchMode = mFramBachModHandle:visible ne yes.
      174     mFramBachModHandle:visible = mFameOldVis.
      175     current-window:visible = mVisCUrentVin.
      176   end.
      177    if  log-manager:logfile-name ne ?
      178     then DO:
      179         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      180         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      181         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      182     end.
      183   on choose of B-WaitFramStop in frame waitfram
      184   do:
      185     mWaitFramStop = yes.
      186     mWaitFramStopUser = yes.
      187   end.
      188   function waitfram-check-timeout returns logical():
      189      define variable vtime as int64 no-undo.
      190      if mWaitFramStopTimeOut
      191      then
      192         return yes.
      193      vtime = ( now - mWaitFramStartProc ) / 1000 .
      194      if     mWaitFramTimeOut ne ?
      195         and mWaitFramTimeOut ne 0
      196         and mWaitFramTimeOut lt vtime
      197      then do:
      198         mWaitFramStopTimeOut = yes.
      199      end.
      200      return mWaitFramStopTimeOut.
      201   end.
      202   procedure waitfram-hide :
      203     if not session:batch-mode
      204     then do
      205     on error undo, return error return-value
      206     :
      207       pause 0 before-hide .
      208       if not mBatchMode then
      209         hide frame waitfram .
      210     if     not mWaitFramView
      211        and mWaitProcEvent
      212     then
      213       process events .
      214     end.
      215   end procedure.
      216   procedure waitfram-show :
      217     define input  parameter p-message as character no-undo .
      218     define variable v-left-margin as integer   no-undo .
      219     if not session:batch-mode
      220     then do
      221     on error undo, return error return-value
      222     :
      223       if length(p-message) <= 70 then do:
      224         assign
      225           v-left-margin = integer((70 - length(p-message)) / 2)
      226         .
      227         assign
      228           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      229         .
      230         assign
      231           v-waitfram-action01 = " "
      232           v-waitfram-action02 = " "
      233                                    + fill(" ", v-left-margin)
      234                                    + p-message
      235           v-waitfram-action03 = " "
      236         .
      237       end.
      238       else do:
      239         define variable vRindex1 as integer no-undo.
      240         define variable vRindex2 as integer no-undo.
      241         vRindex1 = r-index(p-message," ",70).
      242         if vRindex1 = 0
      243         then
      244            vRindex1 = 70.
      245         if length(p-message)  <= vRindex1 + 70 then do:
      246           assign
      247             v-waitfram-action01 = " "
      248             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      249             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      250           .
      251         end.
      252         else do:
      253           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      254           if vRindex2 <= vRindex1
      255           then
      256              vRindex2 = vRindex1 + 70.
      257           assign
      258             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      259             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      260             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      261           .
      262         end.
      263       end.
      264       B-viewProcInfo:visible   in frame waitfram = no.
      265       B-viewProcInfo:sensitive in frame waitfram = no.
      266       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      267       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      268       if  (   mWaitFramView
      269          or  mWaitProcEvent)
      270          and not mBatchMode
      271       then
      272          display
      273             v-waitfram-action01 skip
      274             v-waitfram-action02 skip
      275             v-waitfram-action03 skip
      276          with frame waitfram .
      277       if     mWaitFramView
      278          then do:
      279             if     mWaitFramInterval ne ?
      280                and not mBatchMode
      281             then
      282                wait-for go of frame waitfram pause mWaitFramInterval.
      283          end.
      284          else
      285             if     mWaitProcEvent
      286                and not mBatchMode
      287             then
      288                process events .
      289     end.
      290   end procedure.
      291      procedure waitfram-show-this:
      292         define input  parameter iInterval as int64 no-undo.
      293         define variable vtime as int64 no-undo.
      294         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      295         mWaitFramInterval = iInterval.
      296         run waitfram-show (substitute("&1&2 &3&4" ,
      297                                       mWaitFramTextBeg ,
      298                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      299                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      300                                       mWaitFramTextEnd
      301                                      )
      302                           ).
      303      end.
      304      procedure WaitFramRunPause:
      305         define input  parameter iInterval as dec no-undo.
      306         define variable vStart  as datetime-tz no-undo.
      307         define variable vend    as datetime-tz no-undo.
      308         define variable vint as int64 no-undo.
      309         define variable vOk as logical no-undo.
      310         vStart = now.
      311         vend   = vStart.
      312         publish "WaitFramPause" (iInterval,output vOk).
      313         vend   =  now.
      314         vint = vend - vStart.
      315         vint = iInterval - vint / 1000.
      316         if     not mWaitFramStop
      317            and (   vint > 0
      318                 or (    not vOk
      319                     and iInterval eq ?
      320                     )
      321                 )
      322         then
      323            run waitfram-show-this (iInterval).
      324         vend   =  now.
      325         vint = vend - vStart.
      326         vint = iInterval - vint / 1000.
      327         if     not mWaitFramStop
      328            and vint > 0
      329         then do:
      330            run gbl/pause.p (vint * 1000).
      331         end.
      332         if iInterval ne ?
      333         then
      334            publish "WaitFramStop".
      335         waitfram-check-timeout().
      336      end.
      337      procedure WaitFramWaitFor:
      338         define input  parameter iInterval as dec no-undo.
      339         assign
      340            mWaitFramStartProc   = now
      341            mWaitFramStopUser    = no
      342            mWaitFramStopTimeOut = no
      343         .
      344         block-wait:
      345         do while not mWaitFramStop:
      346            run WaitFramRunPause (iInterval).
      347            if  waitfram-check-timeout()
      348            then do:
      349               leave block-wait.
      350            end.
      351         end.
      352         run waitfram-hide.
      353      end.
      354   procedure waitfram-join :
      355     define input  parameter p-line-1  as character no-undo .
      356     define input  parameter p-line-2  as character no-undo .
      357     define input  parameter p-line-3  as character no-undo .
      358     define output parameter p-message as character no-undo .
      359     do
      360     on error undo, return error return-value
      361     :
      362       assign
      363         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      364                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      365                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      366       .
      367     end.
      368   end procedure.
      369   function waitfram-join-function returns character
      370     (input p-line-1 as character
      371     ,input p-line-2 as character
      372     ,input p-line-3 as character
      373     ).
      374     define variable v-message as character no-undo .
      375     run waitfram-join in this-procedure
      376       (input  p-line-1
      377       ,input  p-line-2
      378       ,input  p-line-3
      379       ,output v-message
      380       ) .
      381     return v-message .
      382   end function .
      383   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   define  stream PrnLibStream.
      385   procedure prn-lib-prn-file :
      386     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      387     define input parameter p-DIsabledoptions as integer no-undo .
      388     define variable v-report-name as character no-undo .
      389     define variable v-user-action as character no-undo .
      390     define variable v-printed     as logical   no-undo .
      391     define variable v-exist       as logical   no-undo .
      392     do
      393       on error undo, return error
      394       :
      395       run prn-lib-get-report-name  in this-procedure (
      396         input parParentProc
      397         ,output v-report-name
      398         ).
      399   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      401     (input  v-report-name
      402     ,input  2
      403     ,output v-exist
      404     )  .
      405       if NOT v-exist then
      406       DO:
      407         Message
      408           "Нет заданий на печать ! "
      409           view-as alert-box .
      410         Return  .
      411       End.
      412       run gbl/prnfilen.w
      413         (input  ""
      414         ,input  p-DisabledOptions
      415         ,input  string(v-report-name )
      416         ,input  7
      417         ,output v-user-action
      418         ,output v-printed
      419         ) .
      420       if v-printed then
      421       do:
      422         return "YES" .
      423       end.
      424       else
      425       do:
      426         return "NO" .
      427       end.
      428     end.
      429   end procedure.
      430   procedure prn-lib-open-stream :
      431     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      432     define input parameter p-page-size    as integer no-undo .
      433     define input parameter p-is-stream    as logical no-undo .
      434     define input parameter p-append       as logical no-undo .
      435     define variable v-report-name as character no-undo .
      436     do
      437       on error undo, return error
      438       :
      439       run prn-lib-get-report-name  in this-procedure (
      440         input parParentProc
      441         ,output v-report-name
      442         ).
      443       if p-is-stream then
      444       do:
      445         if p-append then
      446         do:
      447           output stream PrnLibStream to value( v-report-name )
      448             page-size value(p-page-size) append .
      449         end.
      450         if not p-append then
      451         do:
      452           output stream PrnLibStream to value( v-report-name )
      453             page-size value(p-page-size) .
      454         end.
      455       end.
      456       if not p-is-stream then
      457       do:
      458         if p-append then
      459         do:
      460           output to value( v-report-name )
      461             page-size value(p-page-size) append .
      462         end.
      463         if not p-append then
      464         do:
      465           output to value( v-report-name )
      466             page-size value(p-page-size) .
      467         end.
      468       end.
      469     end.
      470   end procedure.
      471   procedure prn-lib-open-exp :
      472     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      473     define input parameter p-is-stream    as logical no-undo .
      474     define input parameter p-is-append    as logical no-undo .
      475     define output parameter p-ReportFileName as char init "report" no-undo.
      476     define output parameter p-process as logical no-undo .
      477     define variable glog as logical no-undo .
      478     do
      479       on error undo, return error
      480       :
      481       SYSTEM-DIALOG GET-FILE p-ReportFileName
      482         TITLE      "Укажите путь"
      483         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      484         ASK-OVERWRITE
      485         CREATE-TEST-FILE
      486         SAVE-AS
      487         USE-FILENAME
      488         DEFAULT-EXTENSION "txt"
      489         UPDATE glog
      490         .
      491       if not glog then  return.
      492       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      493       if p-is-stream then
      494       do:
      495         if p-is-append then
      496         do:
      497           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      498         end.
      499         else
      500         do:
      501           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      502         end.
      503       end.
      504       else
      505       do:
      506         if p-is-append then
      507         do:
      508           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      509         end.
      510         else
      511         do:
      512           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      513         end.
      514       end.
      515       p-process = yes.
      516     end.
      517   end procedure.
      518   procedure prn-lib-get-report-name :
      519     define input parameter parParentProc  as widget-handle no-undo.
      520     define output parameter p-report-name as character no-undo .
      521     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      522   end procedure.
      523   procedure prn-lib-reportviewer-report-name :
      524     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      525     define input parameter p-report-name-html as character no-undo .
      526     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      527   end procedure.
      528   procedure prn-lib-reportviewer :
      529     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      530     define input parameter p-report-name-html as character no-undo .
      531     define input parameter p-param        as character no-undo .
      532     define variable v-excel           as character no-undo init 'TRUE' .
      533     define variable v-value-character as character no-undo .
      534     define variable v-value-integer   as character no-undo .
      535     define variable v-value-date      as date      no-undo .
      536     define variable v-value-decimal   as decimal   no-undo .
      537     define variable rep-excel         as logical   no-undo .
      538     define variable excel-string      as character no-undo .
      539     define variable v-param-type      as character no-undo .
      540     define variable v-tth             as handle    no-undo .
      541     run adm/shattri.p (
      542       input "get":U
      543       ,input  ""
      544       ,input  0
      545       ,input  'report-glob':U
      546       ,input  'rep-excel':U
      547       ,output v-value-character
      548       ,output v-value-date
      549       ,output v-value-decimal
      550       ,output v-value-integer
      551       ,output rep-excel
      552       ,output v-param-type
      553       ,INPUT-OUTPUT table-handle v-tth
      554       )  .
      555     if rep-excel then v-excel = "TRUE" .
      556     else v-excel = "FALSE" .
      557     if p-param eq ""
      558     then
      559        p-param = "EXCEL:" + v-excel.
      560     else
      561        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      562     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      563   end procedure.
      564   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   procedure cur-time :
      566      define output parameter p-today as date      no-undo .
      567      define output parameter p-time  as integer   no-undo .
      568     do
      569     on error undo, return error
      570     :
      571       define variable v-date1 as date      no-undo .
      572       define variable v-date2 as date      no-undo .
      573       define variable v-time  as integer   no-undo .
      574       assign
      575         v-date1 = today
      576         v-time  = time
      577         v-date2 = today
      578       .
      579       if v-date1 <> v-date2
      580       then do:
      581         assign
      582           v-date1 = today
      583           v-time  = v-time
      584         .
      585       end.
      586       assign
      587         p-today = v-date1
      588         p-time  = v-time
      589       .
      590     end.
      591   end.
      592   function cur-time-date returns character
      593   :
      594     return string(today, '99/99/9999':U) .
      595   end.
      596   function cur-time-mjd returns decimal
      597   :
      598     define variable v-date as date      no-undo .
      599     define variable v-time as integer   no-undo .
      600     run cur-time in this-procedure
      601       (output v-date
      602       ,output v-time
      603       ) .
      604     return integer(v-date) - 2400002 + (v-time / 86400) .
      605   end.
      606   function cur-time-get-ending-index returns integer
      607   (input p-number as integer
      608   )
      609   :
      610     if p-number < 0
      611     or p-number = ?
      612     then do:
      613       return 1 .
      614     end.
      615     define variable v-rest as integer   no-undo .
      616     assign
      617       p-number = p-number modulo 100
      618     .
      619     if p-number < 20
      620     then do:
      621       assign
      622         v-rest = p-number
      623       .
      624     end.
      625     else do:
      626       assign
      627         v-rest = p-number modulo 10
      628       .
      629     end.
      630     case v-rest :
      631       when 1
      632       then do:
      633         return 2 .
      634       end.
      635       when 2 or
      636       when 3 or
      637       when 4
      638       then do:
      639         return 3 .
      640       end.
      641       otherwise do:
      642         return 1 .
      643       end.
      644     end case .
      645   end.
      646   procedure cur-time-mjd-to-date :
      647      define input  parameter i-mjd-diff as decimal no-undo.
      648      define output parameter o-Date     as date    no-undo.
      649      define output parameter o-Time     as integer no-undo.
      650      define variable v-day-number as integer   no-undo .
      651      if    i-mjd-diff < 0
      652         or i-mjd-diff = ?
      653      then do:
      654         return "?" .
      655      end.
      656      assign
      657         v-day-number = truncate(i-mjd-diff,0).
      658         o-Date = date(v-day-number + 2400002).
      659         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      660     .
      661   end.
      662   function cur-time-mjd-to-string returns character
      663   (input p-mjd-diff as decimal
      664   )
      665   :
      666     define variable v-day-number as integer   no-undo .
      667     define variable v-seconds    as integer   no-undo .
      668     define variable v-hour       as integer   no-undo .
      669     define variable v-min        as integer   no-undo .
      670     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      671     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      672     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      673     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      674     if p-mjd-diff < 0
      675     or p-mjd-diff = ?
      676     then do:
      677       return "?" .
      678     end.
      679     assign
      680       v-day-number = integer(truncate(p-mjd-diff,0))
      681       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      682     .
      683     if v-seconds > 86400
      684     then do:
      685       assign
      686         v-seconds = 86400 - 1
      687       .
      688     end.
      689     if v-seconds < 0
      690     then do:
      691       assign
      692         v-seconds = 0
      693       .
      694     end.
      695     assign
      696       v-hour = truncate(v-seconds / 3600, 0)
      697     .
      698     assign
      699       v-seconds = v-seconds modulo 3600
      700     .
      701     assign
      702       v-min = truncate(v-seconds / 60, 0)
      703     .
      704     assign
      705       v-seconds = v-seconds modulo 60
      706     .
      707     return
      708         (if v-day-number <> 0
      709           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      710           else ""
      711         )
      712       + (if v-day-number <> 0 or v-hour <> 0
      713           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      714           else ""
      715         )
      716       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      717           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      718           else ""
      719         )
      720       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      721       .
      722   end.
      723   function cur-time-string returns character
      724   :
      725     define variable v-date as date      no-undo .
      726     define variable v-time as integer   no-undo .
      727     run cur-time in this-procedure
      728       (output v-date
      729       ,output v-time
      730       ) .
      731     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      732   end.
      733   function cur-time-string-sec returns character
      734   :
      735     define variable v-date as date      no-undo .
      736     define variable v-time as integer   no-undo .
      737     run cur-time in this-procedure
      738       (output v-date
      739       ,output v-time
      740       ) .
      741     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      742   end.
      743   function cur-time-custom  returns character
      744   (input p-prefix as character
      745   ,input p-date-format as character
      746   ,input p-delimiter as character
      747   ,input p-time-format as character
      748   ,input p-suffix as character
      749   )
      750   :
      751     define variable v-date as date      no-undo .
      752     define variable v-time as integer   no-undo .
      753     run cur-time in this-procedure
      754       (output v-date
      755       ,output v-time
      756       ) .
      757     return
      758       p-prefix
      759       + string(v-date, p-date-format)
      760       + p-delimiter
      761       + string(v-time, p-time-format)
      762       + p-suffix
      763       .
      764   end.
      765   function cur-time-print  returns character
      766   :
      767     define variable v-date as date      no-undo .
      768     define variable v-time as integer   no-undo .
      769     run cur-time in this-procedure
      770       (output v-date
      771       ,output v-time
      772       ) .
      773     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      774   end.
      775   function cur-time-datetime returns datetime
      776   :
      777     define variable v-char as character no-undo .
      778     define variable v-datetime as datetime no-undo .
      779     v-char = cur-time-string().
      780     v-datetime = datetime(v-char).
      781     return  v-datetime.
      782   end.
      783   function cur-time-string-msec returns character
      784   :
      785     define variable v-date as datetime  no-undo .
      786     v-date = now.
      787     return string(v-date) .
      788   end.
      789   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   FUNCTION mark-string RETURNS CHARACTER
      791     ( input p-recid as recid, input mark-list as character  ) :
      792     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      793   END FUNCTION.
      794   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795   function usrfulnf returns character ( input p-user-id as character):
      796   define variable v-user-name as character no-undo .
      797   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      798   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      799     (input  p-user-id
      800     ,output v-user-name
      801     ) no-error .
      802   if error-status:error
      803   or v-user-name = ""
      804   then do:
      805     return p-user-id.
      806   end.
      807   else do:
      808     return v-user-name.
      809   end.
      810   end function.
      811   define variable v-rid-list as character no-undo .
      812   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      813   define variable sort-column-name as character no-undo .
      814   define variable v-db-num LIKE ub.db.db-num no-undo.
      815   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816   define  temp-table temp-changes no-undo
      817   field f_name as character
      818   field l_name as character
      819   field v_old as character
      820   field v_new as character
      821   field t_name as character
      822   field num_ as integer
      823   field uniq-key-rec as character
      824   field action as integer
      825   field fNotChange as logical
      826   index pi is unique primary
      827   num_
      828   t_name
      829   f_name
      830   index
      831   Chan
      832   fnotChange
      833   t_name
      834   f_name
      835   index imain uniq-key-rec
      836   .
      837   FUNCTION get-all-fields returns character (p-file-name as character ):
      838   define variable v-dop as character no-undo .
      839     find first _file no-lock where _file._file-name = p-file-name no-error .
      840     if not available _file then return "":U.
      841     for each _field no-lock where
      842              _field._file-recid = recid(_file) :
      843       assign
      844       v-dop = v-dop + _field._field-name + chr(44)
      845       .
      846     end.
      847     return trim(v-dop).
      848   END FUNCTION.
      849   PROCEDURE proc-full-temp-changes :
      850     define input  parameter p-hst-handle as handle    no-undo .
      851     define input  parameter p-main-table as character no-undo .
      852     define input  parameter p-field-list as character no-undo .
      853     define input  parameter p-label-form as character no-undo .
      854     define variable h-new-buf         as handle    no-undo .
      855     define variable h-main-buf        as handle    no-undo .
      856     define variable h-for-comp        as handle    no-undo .
      857     define variable v-inform          as character no-undo .
      858     define variable v-ind             as integer   no-undo .
      859     define variable v-idx-field-qnty  as integer   no-undo .
      860     define variable v-num-entries     as integer   no-undo .
      861     define variable fh                as handle    no-undo .
      862     define variable fh-main           as handle    no-undo .
      863     define variable fh-old            as handle    no-undo .
      864     define variable fh-new            as handle    no-undo .
      865     define variable v-field-name      as character no-undo .
      866     define variable v-field-lvl       as character no-undo .
      867     define variable v-field-form      as character no-undo .
      868     define variable v-search-exp      as character no-undo .
      869     define variable v-srch-main       as character no-undo .
      870     define variable v-word-link       as character no-undo .
      871     define variable v-av-chip-num     as logical   no-undo .
      872     define variable v-main-pi-fld-lst as character no-undo .
      873     define variable v-main-fld-lst    as character no-undo .
      874     define variable v-delim-list      as character no-undo .
      875     define variable v-label           as character no-undo .
      876     define variable v-old-value       as character no-undo case-sensitive.
      877     define variable v-new-value       as character no-undo case-sensitive.
      878     define variable v-chg-fields as character no-undo.
      879     for each temp-changes:
      880       delete temp-changes.
      881     end.
      882     if not p-hst-handle:available then do:
      883       return .
      884     end.
      885     create buffer h-new-buf  for table p-hst-handle .
      886     create buffer h-main-buf for table p-main-table .
      887     assign
      888       v-inform = h-main-buf:index-information(1)
      889       v-ind    = 2
      890     .
      891     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      892     on error undo, return error
      893     :
      894       assign
      895         v-inform = h-main-buf:index-information( v-ind )
      896         v-ind    = v-ind + 1
      897       .
      898     end.
      899     if v-inform = ?
      900       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      901       or entry( 3, v-inform, ",":U ) <> "1":U
      902     then do:
      903       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      904     end.
      905     assign
      906       v-idx-field-qnty = num-entries( v-inform ) - 4
      907     .
      908     if v-idx-field-qnty < 2 then do:
      909       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      910     end.
      911     assign
      912       v-srch-main   = "where":U
      913       v-word-link   = "":U
      914       v-av-chip-num = false
      915       v-delim-list  = "":U
      916     .
      917     do v-ind = 1 to v-idx-field-qnty by 2
      918     on error undo, return error
      919     :
      920       assign
      921         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      922         fh                = p-hst-handle:buffer-field( v-field-name )
      923         fh-main           = h-main-buf:buffer-field( v-field-name )
      924         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      925         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      926       .
      927       if fh:data-type ="character":U then do:
      928         assign
      929           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      930         .
      931       end.
      932       else do:
      933         assign
      934           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      935         .
      936       end.
      937       if v-delim-list = "":U then do:
      938         assign
      939           v-delim-list = ",":U
      940         .
      941       end.
      942       if v-word-link = "":U then do:
      943         assign
      944           v-word-link = "and":U
      945         .
      946       end.
      947     end.
      948     assign
      949       v-delim-list  = "":U
      950     .
      951     do v-ind = 1 to h-main-buf:num-fields
      952     on error undo, return error
      953     :
      954       assign
      955         fh-main      = h-main-buf:buffer-field( v-ind )
      956         v-field-name = fh-main:name
      957       .
      958         assign
      959           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      960         .
      961         if v-delim-list = "":U then do:
      962           assign
      963             v-delim-list = ",":U
      964           .
      965         end.
      966     end.
      967     assign
      968       v-inform = p-hst-handle:index-information(1)
      969       v-ind    = 2
      970     .
      971     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      972     on error undo, return error
      973     :
      974       assign
      975         v-inform = p-hst-handle:index-information( v-ind )
      976         v-ind    = v-ind + 1
      977       .
      978     end.
      979     if v-inform = ?
      980       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      981       or entry( 3, v-inform, ",":U ) <> "1":U
      982     then do:
      983       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      984     end.
      985     assign
      986       v-idx-field-qnty = num-entries( v-inform ) - 4
      987     .
      988     if v-idx-field-qnty < 2 then do:
      989       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      990     end.
      991     assign
      992       v-search-exp  = "where":U
      993       v-word-link   = "":U
      994       v-av-chip-num = false
      995     .
      996     do v-ind = 1 to v-idx-field-qnty by 2
      997     on error undo, return error
      998     :
      999       assign
     1000         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1001         fh           = p-hst-handle:buffer-field( v-field-name )
     1002         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1003       .
     1004       if v-field-name = "chip-num":U then do:
     1005         assign
     1006           v-search-exp  = substitute( "&1 >", v-search-exp )
     1007           v-av-chip-num = true
     1008         .
     1009       end.
     1010       else do:
     1011         assign
     1012           v-search-exp = substitute( "&1 =", v-search-exp )
     1013         .
     1014       end.
     1015       if fh:data-type ="character":U then do:
     1016         assign
     1017           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1018         .
     1019       end.
     1020       else do:
     1021         assign
     1022           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1023         .
     1024       end.
     1025       if v-word-link = "":U then do:
     1026         assign
     1027           v-word-link = "and":U
     1028         .
     1029       end.
     1030     end.
     1031     if v-av-chip-num = false then do:
     1032       message
     1033         vss-workfile vss-revision vss-description skip
     1034         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1035         "Использование данной процедуры невозможно!" skip
     1036         view-as alert-box error .
     1037       return error .
     1038     end.
     1039     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1040     if not h-new-buf:available then do:
     1041       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1042       if not h-main-buf:available then do:
     1043         assign
     1044           h-for-comp = ?
     1045         .
     1046       end.
     1047       else do:
     1048         assign
     1049           h-for-comp = h-main-buf
     1050         .
     1051       end.
     1052     end.
     1053     else do:
     1054       assign
     1055         h-for-comp = h-new-buf
     1056       .
     1057     end.
     1058     assign
     1059       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1060     .
     1061     do v-ind = 1 to v-num-entries
     1062     on error undo, return error return-value
     1063     :
     1064       assign
     1065         v-field-name = entry( v-ind, v-main-fld-lst )
     1066         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1067         v-old-value  = fh-old:buffer-value()
     1068         v-label      = trim( fh-old:label )
     1069       .
     1070       if ( trim( p-field-list ) <> "":U
     1071            and lookup( v-field-name, p-field-list ) > 0
     1072          )
     1073          or trim( p-field-list ) = "":U
     1074       then do:
     1075         if h-for-comp <> ? then do:
     1076           assign
     1077             fh-new      = h-for-comp:buffer-field( v-field-name )
     1078             v-new-value = fh-new:buffer-value()
     1079           .
     1080         end.
     1081         else do:
     1082           assign
     1083             v-new-value = "":U
     1084           .
     1085         end.
     1086         if v-old-value <> v-new-value
     1087         then do:
     1088           create temp-changes.
     1089           assign
     1090             temp-changes.t_name = p-main-table
     1091             temp-changes.f_name = v-field-name
     1092             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1093             temp-changes.v_old  = trim( v-old-value )
     1094             temp-changes.v_new  = trim( v-new-value )
     1095             temp-changes.num_   = 0
     1096             temp-changes.fNotChange = v-old-value eq v-new-value
     1097           .
     1098         end.
     1099       end.
     1100     end.
     1101     assign
     1102       v-num-entries = num-entries( p-label-form, chr(8) )
     1103     .
     1104     do v-ind = 1 to v-num-entries
     1105     on error undo, return error return-value
     1106     :
     1107       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1108         assign
     1109           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1110           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1111           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1112         .
     1113         find first temp-changes
     1114           where temp-changes.f_name = v-field-name
     1115           no-error .
     1116         if available temp-changes then do:
     1117           if trim( v-field-lvl ) <> "":U then do:
     1118             assign
     1119               temp-changes.l_name = v-field-lvl
     1120             .
     1121           end.
     1122           if trim( v-field-form ) <> "":U then do:
     1123             assign
     1124               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1125             .
     1126             if h-for-comp <> ? then do:
     1127               assign
     1128                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1129               .
     1130             end.
     1131           end.
     1132         end.
     1133       end.
     1134       else do:
     1135         message
     1136           vss-workfile vss-revision vss-description skip
     1137           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1138           substitute( "список для поля '&1': '&2'"
     1139                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1140                       ,entry( v-ind, p-label-form, chr(8) )
     1141                     ) skip
     1142           substitute( "полный список: &2", p-label-form ) skip
     1143           view-as alert-box error .
     1144       end.
     1145     end.
     1146     delete object h-new-buf .
     1147     delete object h-main-buf .
     1148   END PROCEDURE.
     1149   DEFINE BUTTON B-Help
     1150        LABEL "Помо&щь"
     1151        SIZE 3 BY 1
     1152        BGCOLOR 8 .
     1153   DEFINE BUTTON B-lookup
     1154        LABEL "&Просмотр"
     1155        SIZE 10 BY 1.
     1156   DEFINE BUTTON B-mark
     1157        LABEL "&*"
     1158        SIZE 3 BY 1.
     1159   DEFINE BUTTON b-quit AUTO-END-KEY
     1160        LABEL "&Выход"
     1161        SIZE 10 BY 1
     1162        BGCOLOR 8 .
     1163   DEFINE BUTTON B-sel AUTO-GO
     1164        LABEL "Вы&бор"
     1165        SIZE 10 BY 1.
     1166   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1167         VIEW-AS TEXT
     1168        SIZE 6 BY 1
     1169        FGCOLOR 4  NO-UNDO.
     1170   DEFINE QUERY br-ccountry FOR
     1171         X_c-country SCROLLING.
     1172   DEFINE QUERY BR-changes FOR
     1173         temp-changes SCROLLING.
     1174   DEFINE BROWSE br-ccountry
     1175     QUERY br-ccountry NO-LOCK DISPLAY
     1176         mark-string(recid(X_c-country), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1177         usrfulnf(X_c-country.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1178         X_c-country.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1179         string(X_c-country.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1180         X_c-country.short-name FORMAT "X(25)":U
     1181         X_c-country.long-name FORMAT "X(40)":U
     1182         X_c-country.num-code COLUMN-LABEL "Цифровой!код страны" FORMAT "999":U
     1183       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25 FIT-LAST-COLUMN.
     1184   DEFINE BROWSE BR-changes
     1185     QUERY BR-changes DISPLAY
     1186         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1187   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1188   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1189       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1190   DEFINE FRAME Dialog-Frame
     1191        b-quit AT ROW 1 COL 1
     1192        B-mark AT ROW 1 COL 11
     1193        B-sel AT ROW 1 COL 21
     1194        B-lookup AT ROW 1 COL 61
     1195        B-Help AT ROW 1 COL 95
     1196        br-ccountry AT ROW 3 COL 1
     1197        BR-changes AT ROW 13 COL 1
     1198        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1199        SPACE(78.62) SKIP(20.04)
     1200       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1201            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1202            TITLE "История стран"
     1203            CANCEL-BUTTON b-quit.
     1204   ASSIGN
     1205          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1206          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1207   ASSIGN
     1208          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1209   ON GO OF FRAME Dialog-Frame
     1210   DO:
     1211     p-rid-list = v-rid-list.
     1212   END.
     1213   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1214   DO:
     1215     APPLY "END-ERROR":U TO SELF.
     1216   END.
     1217   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1218   DO:
     1219     define variable loc#log as logical no-undo .
     1220     if available X_c-country then do:
     1221   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1222   define variable v-str-recid10 as character no-undo .
     1223   define variable v-num-entry10 as integer   no-undo .
     1224   assign
     1225     v-str-recid10 = trim( string( recid( X_c-country ) , "->>>>>>>>>>>9":U ) )
     1226     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
     1227   .
     1228   if v-num-entry10 > 0 then do:
     1229     assign
     1230       entry( v-num-entry10, v-rid-list ) = "":U
     1231       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1232     .
     1233   end.
     1234   else do:
     1235     assign
     1236       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1237     .
     1238   end.
     1239       loc#log = br-ccountry:refresh() .
     1240       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1241           loc#log = br-ccountry:select-next-row ().
     1242           apply "VALUE-CHANGED" to br-ccountry in frame Dialog-Frame.
     1243       end.
     1244       if num-entries( v-rid-list ) = 0
     1245       then
     1246           hide mark-num in frame Dialog-Frame.
     1247       else
     1248           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1249     end.
     1250     apply "entry" to br-ccountry in frame Dialog-Frame.
     1251   END.
     1252   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1253   DO:
     1254       if ( available X_c-country ) then do:
     1255       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1256       then
     1257       v-rid-list = string( recid( X_c-country ) ) .
     1258     end.
     1259   END.
     1260   ON RETURN OF br-ccountry IN FRAME Dialog-Frame
     1261   or MOUSE-SELECT-DBLCLICK OF br-ccountry IN FRAME Dialog-Frame
     1262       DO:
     1263       run proc-br-ccountry no-error.
     1264     if error-status:error then return no-apply.
     1265   END.
     1266   ON VALUE-CHANGED OF br-ccountry IN FRAME Dialog-Frame
     1267   DO:
     1268     run proc-view-changes in this-procedure no-error.
     1269   END.
     1270   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1271   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1272   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1273   on help of frame Dialog-Frame
     1274   do:
     1275     run gbl/app_help.p
     1276       (input this-procedure :file-name
     1277       ,input ''
     1278       ,input ?
     1279       ) no-error.
     1280     if error-status :error then do:
     1281       message
     1282         "Ошибка при вызове помощи"
     1283         error-status :get-message(1)
     1284         view-as alert-box .
     1285     end.
     1286   end.
     1287   run minbtn-set in this-procedure .
     1288   on choose of b-help in frame Dialog-Frame
     1289   do:
     1290     apply "help":u to frame Dialog-Frame .
     1291   end.
     1292   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   procedure minbtn-set :
     1294       do
     1295           on error undo, return error return-value
     1296           :
     1297           define variable ii              as integer       no-undo .
     1298           define variable fh              as widget-handle no-undo .
     1299           define variable hh              as widget-handle no-undo .
     1300           define variable v-h             as handle        extent 4 no-undo .
     1301           define variable v-name-button   as character     no-undo .
     1302           define variable v-help-old-x    as decimal       no-undo .
     1303           define variable v-help-old-y    as decimal       no-undo .
     1304           define variable v-help-old-size as decimal       no-undo .
     1305           define variable v-frame-width   as decimal       no-undo .
     1306           define variable jj              as integer       no-undo .
     1307           do
     1308               on error undo, return error
     1309               :
     1310               assign
     1311                   v-frame-width = frame Dialog-Frame:width - 0.3
     1312                   fh            = frame Dialog-Frame:first-child
     1313                   hh            = fh:first-child
     1314                   ii            = 1
     1315                   .
     1316               do while valid-handle(hh):
     1317                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1318                   do:
     1319                       case lc(hh:name) :
     1320                           when "b-help" then
     1321                               do:
     1322                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1323                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1324                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1325                                   hh:TOOLTIP = "Помощь" .
     1326                                   v-help-old-x = hh:column .
     1327                                   v-help-old-y = hh:row    .
     1328                                   v-help-old-size = hh:width .
     1329                                   hh:width-chars = 2.5 .
     1330                               end.
     1331                           when "b-print" then
     1332                               do:
     1333                                   hh:load-image("cmp/b-print.bmp":u) .
     1334                                   hh:TOOLTIP = "Печать" .
     1335                                   v-h[ii] = hh:handle .
     1336                                   ii = ii + 1 .
     1337                                   hh:width-chars = 3 .
     1338                               end.
     1339                           when "b-history" or
     1340                           when "b-hist" then
     1341                               do:
     1342                                   hh:load-image("cmp/b-hist.bmp":u) .
     1343                                   hh:TOOLTIP = "История" .
     1344                                   v-h[ii] = hh:handle .
     1345                                   ii = ii + 1 .
     1346                                   hh:width-chars = 3 .
     1347                               end.
     1348                           when "b-sch" then
     1349                               do:
     1350                                   hh:load-image("cmp/b-sch.bmp":u) .
     1351                                   hh:TOOLTIP = "Установка Фильтра" .
     1352                                   v-h[ii] = hh:handle .
     1353                                   ii = ii + 1 .
     1354                                   hh:width-chars = 3 .
     1355                               end.
     1356                           when "b-hist-user" then
     1357                               do:
     1358                                   hh:load-image("cmp/b-hist.bmp":u) .
     1359                                   hh:TOOLTIP = "История пользователя" .
     1360                                   ii = ii + 1 .
     1361                               end.
     1362                       end case.
     1363                   end.
     1364                   hh = hh:next-sibling.
     1365               end.
     1366               b-help:column = v-frame-width - b-help:width-chars.
     1367               jj = 0.
     1368               repeat ii = 4 to 1 by -1 :
     1369                   if valid-handle (v-h[ii] ) then
     1370                   do:
     1371                       jj  = jj + 1 .
     1372                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1373                       v-h[ii]:row    = v-help-old-y .
     1374                   end.
     1375               end.
     1376           end.
     1377       end.
     1378   end procedure.
     1379   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1380   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1381   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1382   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1383   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1384   define variable v-diasize-current-frame-height as decimal   no-undo .
     1385   define variable v-diasize-change-size          as logical   no-undo .
     1386   define variable v-diasize-resize-button        as handle    no-undo .
     1387   define variable v-diasize-wndmax               as logical   no-undo .
     1388   define variable v-diasize-wndstore             as logical   no-undo .
     1389   define variable v-diasize-proc-name            as character no-undo .
     1390   define variable v-diasize-browse-handle        as handle    no-undo .
     1391   define variable v-diasize-browse-number        as integer   no-undo .
     1392   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1393   define temp-table temp-diasize-handle no-undo
     1394     field handle-value  as handle
     1395     field save-position as decimal
     1396     index xpk is primary unique handle-value
     1397     .
     1398   define temp-table temp-browse-handle no-undo
     1399     field browse-type   as character
     1400     field browse-number as integer
     1401     field browse-handle as handle
     1402     field original-size as decimal
     1403     index xpk is primary unique browse-type browse-number
     1404     index xie browse-type browse-handle
     1405   .
     1406   procedure diasize_change-height :
     1407     define input  parameter p-change-value  as decimal   no-undo .
     1408     define input  parameter p-move-resize   as logical   no-undo .
     1409     define variable v-field-group-handle    as handle    no-undo .
     1410     define variable v-object-handle         as handle    no-undo .
     1411     define variable v-frame-height          as decimal   no-undo .
     1412     define variable v-frame-virtual-height  as decimal   no-undo .
     1413     define variable v-browse-height         as decimal   no-undo .
     1414     define variable v-window-height         as decimal   no-undo .
     1415     define variable v-window-virtual-height as decimal   no-undo .
     1416     define variable v-change-sign           as integer   no-undo .
     1417     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1418     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1419     if p-change-value > 0
     1420     then do:
     1421       if frame Dialog-Frame :height + p-change-value
     1422           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1423       then do:
     1424         assign
     1425           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1426                           - (frame Dialog-Frame :height-chars)
     1427         .
     1428         if p-change-value <= 0
     1429         then do:
     1430           run diasize_position-resize-button in this-procedure .
     1431           return .
     1432         end.
     1433       end.
     1434     end.
     1435     if p-change-value < 0
     1436     then do:
     1437       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1438       then do:
     1439         assign
     1440           p-change-value = v-diasize-orig-frame-height
     1441                          - (frame Dialog-Frame :height-chars)
     1442         .
     1443         if p-change-value >= 0
     1444         then do:
     1445           run diasize_position-resize-button in this-procedure .
     1446           return .
     1447         end.
     1448       end.
     1449     end.
     1450     if p-change-value >= 0
     1451     then do:
     1452       assign
     1453         v-change-sign = 1
     1454       .
     1455     end.
     1456     else do:
     1457       assign
     1458         v-change-sign = -1
     1459       .
     1460     end.
     1461     assign
     1462       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1463     .
     1464     if p-change-value = 0
     1465     then do:
     1466       run diasize_position-resize-button in this-procedure .
     1467       return .
     1468     end.
     1469     move_block:
     1470     do
     1471     on error undo move_block, retry move_block
     1472     :
     1473       if retry
     1474       then do:
     1475         do
     1476         on error undo move_block, leave move_block
     1477         :
     1478           if p-change-value > 0
     1479           then do:
     1480             for each buf_temp-diasize-handle
     1481             on error undo, next
     1482             :
     1483               assign
     1484                 v-object-handle = buf_temp-diasize-handle.handle-value
     1485               .
     1486               if v-object-handle <> v-diasize-resize-button
     1487               then do:
     1488                 assign
     1489                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1490                 .
     1491               end.
     1492             end.
     1493             assign
     1494               v-diasize-browse-handle :height = v-browse-height
     1495             .
     1496             for each buf_temp-browse-handle
     1497               where buf_temp-browse-handle.browse-type = 'height':u
     1498             on error undo, next
     1499             :
     1500               assign
     1501                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1502               .
     1503             end.
     1504             assign
     1505               frame Dialog-Frame :height = v-frame-height
     1506             .
     1507             if frame Dialog-Frame :scrollable = true
     1508             then do:
     1509               assign
     1510                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1511               .
     1512             end.
     1513             run diasize_position-resize-button in this-procedure .
     1514           end.
     1515           else do:
     1516             if frame Dialog-Frame :scrollable = true
     1517             then do:
     1518               assign
     1519                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1520               .
     1521             end.
     1522             assign
     1523               frame Dialog-Frame :height = v-frame-height
     1524             .
     1525             assign
     1526               v-diasize-browse-handle :height = v-browse-height
     1527             .
     1528             for each buf_temp-browse-handle
     1529               where buf_temp-browse-handle.browse-type = 'height':u
     1530             on error undo, next
     1531             :
     1532               assign
     1533                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1534               .
     1535             end.
     1536             for each buf_temp-diasize-handle
     1537             on error undo, next
     1538             :
     1539               assign
     1540                 v-object-handle = buf_temp-diasize-handle.handle-value
     1541               .
     1542               if v-object-handle <> v-diasize-resize-button
     1543               then do:
     1544                 assign
     1545                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1546                 .
     1547               end.
     1548             end.
     1549             run diasize_position-resize-button in this-procedure .
     1550           end.
     1551           assign
     1552             v-diasize-change-size = false
     1553           .
     1554           leave move_block .
     1555         end.
     1556       end.
     1557       assign
     1558         v-diasize-need-full-display = true
     1559       .
     1560       if v-diasize-change-size = false
     1561       then do:
     1562         assign
     1563           v-diasize-change-size = true
     1564         .
     1565       end.
     1566       else do:
     1567         return .
     1568       end.
     1569       assign
     1570         v-frame-height = frame Dialog-Frame :height
     1571         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1572         v-browse-height = v-diasize-browse-handle :height
     1573       .
     1574       for each buf_temp-browse-handle
     1575         where buf_temp-browse-handle.browse-type = 'height':u
     1576       :
     1577         assign
     1578           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1579         .
     1580       end.
     1581       for each buf_temp-diasize-handle
     1582       :
     1583         delete buf_temp-diasize-handle .
     1584       end.
     1585       assign
     1586         v-field-group-handle = frame Dialog-Frame :first-child
     1587       .
     1588       do while valid-handle(v-field-group-handle)
     1589       :
     1590         assign
     1591           v-object-handle = v-field-group-handle :first-child
     1592         .
     1593         do while valid-handle(v-object-handle)
     1594         :
     1595           if  v-object-handle <> v-diasize-browse-handle :handle
     1596           and can-query(v-object-handle, "row")
     1597           and can-query(v-object-handle, "height")
     1598           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1599           then do:
     1600             find first buf_temp-browse-handle
     1601               where buf_temp-browse-handle.browse-type   = 'height':u
     1602                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1603               no-error .
     1604             if available buf_temp-browse-handle
     1605             then do:
     1606             end.
     1607             else do:
     1608               create buf_temp-diasize-handle .
     1609               assign
     1610                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1611                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1612               .
     1613             end.
     1614           end.
     1615           assign
     1616             v-object-handle = v-object-handle :next-sibling
     1617           .
     1618         end.
     1619         assign
     1620           v-field-group-handle = v-field-group-handle :next-sibling
     1621         .
     1622       end.
     1623       do with frame Dialog-Frame
     1624       :
     1625         hide v-diasize-resize-button .
     1626         assign
     1627           v-diasize-resize-button :row    = 1
     1628           v-diasize-resize-button :column = 1
     1629         .
     1630       end.
     1631       if p-change-value > 0
     1632       then do:
     1633         if frame Dialog-Frame :scrollable = true
     1634         then do:
     1635           assign
     1636             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1637             no-error .
     1638           if error-status :error
     1639           or error-status :get-message(1) <> ""
     1640           then do:
     1641             undo move_block, retry move_block .
     1642           end.
     1643         end.
     1644         assign
     1645           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1646           no-error .
     1647         if error-status :error
     1648         or error-status :get-message(1) <> ""
     1649         then do:
     1650           undo move_block, retry move_block .
     1651         end.
     1652         assign
     1653           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1654           no-error .
     1655         if error-status :error
     1656         or error-status :get-message(1) <> ""
     1657         then do:
     1658           undo move_block, retry move_block .
     1659         end.
     1660         for each buf_temp-browse-handle
     1661           where buf_temp-browse-handle.browse-type = 'height':u
     1662         on error undo move_block, retry move_block
     1663         :
     1664           assign
     1665             buf_temp-browse-handle.browse-handle :height
     1666               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1667             no-error .
     1668           if error-status :error
     1669           or error-status :get-message(1) <> ""
     1670           then do:
     1671             undo move_block, retry move_block .
     1672           end.
     1673         end.
     1674         for each buf_temp-diasize-handle
     1675         on error undo move_block, retry move_block
     1676         :
     1677           assign
     1678             v-object-handle = buf_temp-diasize-handle.handle-value
     1679           .
     1680           if v-object-handle <> v-diasize-resize-button
     1681           then do:
     1682             assign
     1683               v-object-handle :row = v-object-handle :row + p-change-value
     1684               no-error .
     1685             if error-status :error
     1686             or error-status :get-message(1) <> ""
     1687             then do:
     1688               undo move_block, retry move_block .
     1689             end.
     1690           end.
     1691         end.
     1692       end.
     1693       else do:
     1694         for each buf_temp-diasize-handle
     1695         on error undo move_block, retry move_block
     1696         :
     1697           assign
     1698             v-object-handle = buf_temp-diasize-handle.handle-value
     1699           .
     1700           if v-object-handle <> v-diasize-resize-button
     1701           then do:
     1702             assign
     1703               v-object-handle :row = v-object-handle :row + p-change-value
     1704               no-error .
     1705             if error-status :error
     1706             or error-status :get-message(1) <> ""
     1707             then do:
     1708               undo move_block, retry move_block .
     1709             end.
     1710           end.
     1711         end.
     1712         assign
     1713           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1714           no-error .
     1715         if error-status :error
     1716         or error-status :get-message(1) <> ""
     1717         then do:
     1718           undo move_block, retry move_block .
     1719         end.
     1720         for each buf_temp-browse-handle
     1721           where buf_temp-browse-handle.browse-type = 'height':u
     1722         on error undo move_block, retry move_block
     1723         :
     1724           assign
     1725             buf_temp-browse-handle.browse-handle :height
     1726               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1727             no-error .
     1728           if error-status :error
     1729           or error-status :get-message(1) <> ""
     1730           then do:
     1731             undo move_block, retry move_block .
     1732           end.
     1733         end.
     1734         assign
     1735           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1736           no-error .
     1737         if error-status :error
     1738         or error-status :get-message(1) <> ""
     1739         then do:
     1740           undo move_block, retry move_block .
     1741         end.
     1742         if frame Dialog-Frame :scrollable = true
     1743         then do:
     1744           assign
     1745             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1746             no-error .
     1747           if error-status :error
     1748           or error-status :get-message(1) <> ""
     1749           then do:
     1750             undo move_block, retry move_block .
     1751           end.
     1752         end.
     1753       end.
     1754       if p-move-resize = true
     1755       then do:
     1756         run diasize_position-resize-button in this-procedure .
     1757       end.
     1758       if v-diasize-wndstore = true
     1759       then do:
     1760         if connected("ub") = true
     1761         then do:
     1762           define variable v-cntxt-db-num        as integer   no-undo .
     1763           define variable v-cntxt-userid        as character no-undo .
     1764           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1765                                             , OUTPUT v-cntxt-userid
     1766                                             ) .
     1767           run gbl/wndsizew.p
     1768             (input  v-cntxt-db-num
     1769             ,input  v-cntxt-userid
     1770             ,input  v-diasize-proc-name
     1771             ,input  'height':u
     1772             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1773             ) .
     1774         end.
     1775       end.
     1776     end.
     1777     assign
     1778       v-diasize-change-size = false
     1779     .
     1780   end procedure.
     1781   procedure diasize_set-height :
     1782     define input  parameter p-new-height  as decimal   no-undo .
     1783     define input  parameter p-move-resize as logical   no-undo .
     1784     do
     1785     on error undo, return error return-value
     1786     :
     1787       run diasize_change-height in this-procedure
     1788         (input  (p-new-height - frame Dialog-Frame :height)
     1789         ,input  p-move-resize
     1790         ) .
     1791     end.
     1792   end procedure.
     1793   procedure diasize_change-width :
     1794     define input  parameter p-change-value as decimal   no-undo .
     1795     define input  parameter p-move-resize  as logical   no-undo .
     1796     define variable v-field-group-handle   as handle    no-undo .
     1797     define variable v-object-handle        as handle    no-undo .
     1798     define variable v-frame-width          as decimal   no-undo .
     1799     define variable v-frame-virtual-width  as decimal   no-undo .
     1800     define variable v-browse-width         as decimal   no-undo .
     1801     define variable v-window-width         as decimal   no-undo .
     1802     define variable v-window-virtual-width as decimal   no-undo .
     1803     define variable v-change-sign          as integer   no-undo .
     1804     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1805     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1806     if p-change-value > 0
     1807     then do:
     1808       if frame Dialog-Frame :width + p-change-value >
     1809           session :width-chars
     1810       then do:
     1811         assign
     1812           p-change-value = session :width-chars - frame Dialog-Frame :width
     1813         .
     1814         if p-change-value <= 0
     1815         then do:
     1816           run diasize_position-resize-button in this-procedure .
     1817           return .
     1818         end.
     1819       end.
     1820     end.
     1821     if p-change-value < 0
     1822     then do:
     1823       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1824       then do:
     1825         assign
     1826           p-change-value = v-diasize-orig-frame-width
     1827                          - frame Dialog-Frame :width
     1828         .
     1829         if p-change-value >= 0
     1830         then do:
     1831           run diasize_position-resize-button in this-procedure .
     1832           return .
     1833         end.
     1834       end.
     1835     end.
     1836     if p-change-value >= 0
     1837     then do:
     1838       assign
     1839         v-change-sign = 1
     1840       .
     1841     end.
     1842     else do:
     1843       assign
     1844         v-change-sign = -1
     1845       .
     1846     end.
     1847     assign
     1848       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1849     .
     1850     if p-change-value = 0
     1851     then do:
     1852       run diasize_position-resize-button in this-procedure .
     1853       return .
     1854     end.
     1855     move_block:
     1856     do
     1857     on error undo move_block, leave move_block
     1858     :
     1859       if retry
     1860       then do:
     1861         do
     1862         on error undo move_block, leave move_block
     1863         :
     1864           if p-change-value > 0
     1865           then do:
     1866             for each buf_temp-diasize-handle
     1867             on error undo, next
     1868             :
     1869               assign
     1870                 v-object-handle = buf_temp-diasize-handle.handle-value
     1871               .
     1872               if v-object-handle <> v-diasize-resize-button
     1873               then do:
     1874                 assign
     1875                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1876                 .
     1877               end.
     1878             end.
     1879             assign
     1880               v-diasize-browse-handle :width = v-browse-width
     1881             .
     1882             for each buf_temp-browse-handle
     1883               where buf_temp-browse-handle.browse-type = 'width':u
     1884             on error undo, next
     1885             :
     1886               assign
     1887                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1888               .
     1889             end.
     1890             assign
     1891               frame Dialog-Frame :width = v-frame-width
     1892             .
     1893             if frame Dialog-Frame :scrollable = true
     1894             then do:
     1895               assign
     1896                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1897               .
     1898             end.
     1899             run diasize_position-resize-button in this-procedure .
     1900           end.
     1901           else do:
     1902             if frame Dialog-Frame :scrollable = true
     1903             then do:
     1904               assign
     1905                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1906               .
     1907             end.
     1908             assign
     1909               frame Dialog-Frame :width = v-frame-width
     1910             .
     1911             for each buf_temp-browse-handle
     1912               where buf_temp-browse-handle.browse-type = 'width':u
     1913             on error undo, next
     1914             :
     1915               assign
     1916                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1917               .
     1918             end.
     1919             assign
     1920               v-diasize-browse-handle :width = v-browse-width
     1921             .
     1922             for each buf_temp-diasize-handle
     1923             on error undo, next
     1924             :
     1925               assign
     1926                 v-object-handle = buf_temp-diasize-handle.handle-value
     1927               .
     1928               if v-object-handle <> v-diasize-resize-button
     1929               then do:
     1930                 assign
     1931                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1932                 .
     1933               end.
     1934             end.
     1935             run diasize_position-resize-button in this-procedure .
     1936           end.
     1937           assign
     1938             v-diasize-change-size = false
     1939           .
     1940           leave move_block .
     1941         end.
     1942       end.
     1943       assign
     1944         v-diasize-need-full-display = true
     1945       .
     1946       if v-diasize-change-size = false
     1947       then do:
     1948         assign
     1949           v-diasize-change-size = true
     1950         .
     1951       end.
     1952       else do:
     1953         return .
     1954       end.
     1955       assign
     1956         v-frame-width = frame Dialog-Frame :width
     1957         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1958         v-browse-width = v-diasize-browse-handle :width
     1959       .
     1960       for each buf_temp-browse-handle
     1961         where buf_temp-browse-handle.browse-type = 'width':u
     1962       :
     1963         assign
     1964           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1965         .
     1966       end.
     1967       for each buf_temp-diasize-handle
     1968       :
     1969         delete buf_temp-diasize-handle .
     1970       end.
     1971       assign
     1972         v-field-group-handle = frame Dialog-Frame :first-child
     1973       .
     1974       do while valid-handle(v-field-group-handle)
     1975       :
     1976         assign
     1977           v-object-handle = v-field-group-handle :first-child
     1978         .
     1979         do while valid-handle(v-object-handle)
     1980         :
     1981           if  v-object-handle <> v-diasize-browse-handle :handle
     1982           and v-object-handle <> v-diasize-resize-button
     1983           and can-query(v-object-handle, "row")
     1984           and can-query(v-object-handle, "height")
     1985           and ( v-object-handle :col + v-object-handle :width
     1986                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1987               )
     1988           then do:
     1989             find first buf_temp-browse-handle
     1990               where buf_temp-browse-handle.browse-type   = 'width':u
     1991                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1992               no-error .
     1993             if available buf_temp-browse-handle
     1994             then do:
     1995             end.
     1996             else do:
     1997               create buf_temp-diasize-handle .
     1998               assign
     1999                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2000                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2001               .
     2002             end.
     2003           end.
     2004           assign
     2005             v-object-handle = v-object-handle :next-sibling
     2006           .
     2007         end.
     2008         assign
     2009           v-field-group-handle = v-field-group-handle :next-sibling
     2010         .
     2011       end.
     2012       do with frame Dialog-Frame
     2013       :
     2014         hide v-diasize-resize-button .
     2015         v-diasize-resize-button :row = 1.
     2016         v-diasize-resize-button :column = 1.
     2017       end.
     2018       if p-change-value > 0
     2019       then do:
     2020         if frame Dialog-Frame :scrollable = true
     2021         then do:
     2022           assign
     2023             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2024             no-error .
     2025           if error-status :error
     2026           or error-status :get-message(1) <> ""
     2027           then do:
     2028             undo move_block, retry move_block.
     2029           end.
     2030         end.
     2031         assign
     2032           frame Dialog-Frame :width = v-frame-width + p-change-value
     2033           no-error .
     2034         if error-status :error
     2035         or error-status :get-message(1) <> ""
     2036         then do:
     2037           undo move_block, retry move_block.
     2038         end.
     2039         assign
     2040           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2041         no-error .
     2042         if error-status :error
     2043         or error-status :get-message(1) <> ""
     2044         then do:
     2045           undo move_block, retry move_block.
     2046         end.
     2047         for each buf_temp-browse-handle
     2048           where buf_temp-browse-handle.browse-type = 'width':u
     2049         on error undo move_block, retry move_block
     2050         :
     2051           assign
     2052             buf_temp-browse-handle.browse-handle :width
     2053               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2054             no-error .
     2055           if error-status :error
     2056           or error-status :get-message(1) <> ""
     2057           then do:
     2058             undo move_block, retry move_block .
     2059           end.
     2060         end.
     2061         for each buf_temp-diasize-handle
     2062         on error undo move_block, retry move_block
     2063         :
     2064           assign
     2065             v-object-handle = buf_temp-diasize-handle.handle-value
     2066           .
     2067           if v-object-handle <> v-diasize-resize-button
     2068           then do:
     2069             assign
     2070               v-object-handle :col = v-object-handle :col + p-change-value
     2071               no-error .
     2072             if error-status :error
     2073             or error-status :get-message(1) <> ""
     2074             then do:
     2075               undo move_block, retry move_block .
     2076             end.
     2077           end.
     2078         end.
     2079       end.
     2080       else do:
     2081         for each buf_temp-diasize-handle
     2082         on error undo move_block, retry move_block
     2083         :
     2084           assign
     2085             v-object-handle = buf_temp-diasize-handle.handle-value
     2086           .
     2087           if v-object-handle <> v-diasize-resize-button
     2088           then do:
     2089             assign
     2090               v-object-handle :col = v-object-handle :col + p-change-value
     2091               no-error .
     2092             if error-status :error
     2093             or error-status :get-message(1) <> ""
     2094             then do:
     2095               undo move_block, retry move_block .
     2096             end.
     2097           end.
     2098         end.
     2099         for each buf_temp-browse-handle
     2100           where buf_temp-browse-handle.browse-type = 'width':u
     2101         on error undo move_block, retry move_block
     2102         :
     2103           assign
     2104             buf_temp-browse-handle.browse-handle :width
     2105               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2106             no-error .
     2107           if error-status :error
     2108           or error-status :get-message(1) <> ""
     2109           then do:
     2110             undo move_block, retry move_block .
     2111           end.
     2112         end.
     2113         assign
     2114           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2115           no-error .
     2116         if error-status :error
     2117         or error-status :get-message(1) <> ""
     2118         then do:
     2119           undo move_block, retry move_block.
     2120         end.
     2121         assign
     2122           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2123         no-error .
     2124         if error-status :error
     2125         or error-status :get-message(1) <> ""
     2126         then do:
     2127           undo move_block, retry move_block.
     2128         end.
     2129         if frame Dialog-Frame :scrollable = true
     2130         then do:
     2131           assign
     2132             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2133           no-error .
     2134           if error-status :error
     2135           or error-status :get-message(1) <> ""
     2136           then do:
     2137             undo move_block, retry move_block.
     2138           end.
     2139         end.
     2140       end.
     2141       if p-move-resize
     2142       then do:
     2143         run diasize_position-resize-button in this-procedure .
     2144       end.
     2145       if v-diasize-wndstore = true
     2146       then do:
     2147         if connected("ub") = true
     2148         then do:
     2149           define variable v-cntxt-db-num        as integer   no-undo .
     2150           define variable v-cntxt-userid        as character no-undo .
     2151           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2152                                             , OUTPUT v-cntxt-userid
     2153                                             ) .
     2154           run gbl/wndsizew.p
     2155             (input  v-cntxt-db-num
     2156             ,input  v-cntxt-userid
     2157             ,input  v-diasize-proc-name
     2158             ,input  'width':u
     2159             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2160             ) .
     2161         end.
     2162       end.
     2163     end.
     2164     assign
     2165       v-diasize-change-size = false
     2166     .
     2167   end procedure.
     2168   procedure diasize_set-width :
     2169     define input  parameter p-new-width  as decimal   no-undo .
     2170     define input  parameter p-move-resize as logical   no-undo .
     2171     do
     2172     on error undo, return error return-value
     2173     :
     2174       run diasize_change-width in this-procedure
     2175         (input  (p-new-width - frame Dialog-Frame :width)
     2176         ,input  p-move-resize
     2177         ) .
     2178     end.
     2179   end procedure.
     2180   procedure diasize_position-resize-button :
     2181     do with frame Dialog-Frame
     2182     :
     2183       hide v-diasize-resize-button .
     2184       assign
     2185         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2186                     - 1
     2187                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2188         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2189                     - 1
     2190                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2191       .
     2192       view v-diasize-resize-button .
     2193     end.
     2194   end procedure.
     2195   on alt-right anywhere
     2196   do:
     2197     run diasize_change-width in this-procedure
     2198       (input 1
     2199       ,input true
     2200       ) .
     2201     return no-apply .
     2202   end.
     2203   on alt-left anywhere
     2204   do:
     2205     run diasize_change-width in this-procedure
     2206       (input -1
     2207       ,input true
     2208       ) .
     2209     return no-apply .
     2210   end.
     2211   on alt-down anywhere
     2212   do:
     2213     run diasize_change-height in this-procedure
     2214       (input 1
     2215       ,input true
     2216       ) .
     2217     return no-apply .
     2218   end.
     2219   on alt-up anywhere
     2220   do:
     2221     run diasize_change-height in this-procedure
     2222       (input -1
     2223       ,input true
     2224       ) .
     2225     return no-apply .
     2226   end.
     2227   on alt-enter of frame Dialog-Frame
     2228   do:
     2229     run diasize_maximize in this-procedure
     2230       (input  ?
     2231       ).
     2232     return no-apply .
     2233   end.
     2234   procedure diasize_end-move :
     2235     do
     2236     on error undo, return error return-value
     2237     :
     2238       define variable v-row-delta as decimal   no-undo .
     2239       define variable v-col-delta as decimal   no-undo .
     2240       define variable v-new-row as decimal   no-undo .
     2241       define variable v-new-col as decimal   no-undo .
     2242       assign
     2243         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2244         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2245       .
     2246       assign
     2247         v-row-delta = v-new-row - frame Dialog-Frame :height
     2248         v-col-delta = v-new-col - frame Dialog-Frame :width
     2249       .
     2250       run diasize_change-height in this-procedure
     2251         (input v-row-delta
     2252         ,input true
     2253         ) .
     2254       run diasize_change-width in this-procedure
     2255         (input v-col-delta
     2256         ,input true
     2257         ) .
     2258     end.
     2259   end procedure.
     2260   procedure diasize_maximize :
     2261     define input  parameter p-action as logical   no-undo .
     2262     do
     2263     on error undo, return error return-value
     2264     :
     2265       if p-action = ?
     2266       then do:
     2267         if v-diasize-need-maximize = true
     2268         then do:
     2269           assign
     2270             p-action = true
     2271           .
     2272         end.
     2273         else do:
     2274           assign
     2275             p-action = false
     2276           .
     2277         end.
     2278       end.
     2279       if p-action = true
     2280       then do:
     2281         run diasize_change-height in this-procedure
     2282           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2283               - frame Dialog-Frame :height-chars
     2284           ,input true
     2285           ) .
     2286         run diasize_change-width in this-procedure
     2287           (input session :width-chars
     2288               - frame Dialog-Frame :width-chars
     2289           ,input true
     2290           ) .
     2291         assign
     2292           v-diasize-need-maximize = false
     2293         .
     2294       end.
     2295       else do:
     2296         run diasize_change-width in this-procedure
     2297           (input v-diasize-orig-frame-width
     2298               - frame Dialog-Frame :width-chars
     2299           ,input true
     2300           ) .
     2301         run diasize_change-height in this-procedure
     2302           (input v-diasize-orig-frame-height
     2303               - frame Dialog-Frame :height-chars
     2304           ,input true
     2305           ) .
     2306         assign
     2307           v-diasize-need-maximize = true
     2308         .
     2309       end.
     2310     end.
     2311   end procedure.
     2312   procedure diasize_restore-orig-size :
     2313     do
     2314     on error undo, return error return-value
     2315     :
     2316       assign
     2317         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2318         v-diasize-current-frame-height = frame Dialog-Frame :height
     2319       .
     2320       run diasize_set-height in this-procedure
     2321         (input  v-diasize-orig-frame-height
     2322         ,input  true
     2323         ) .
     2324       run diasize_set-width in this-procedure
     2325         (input  v-diasize-orig-frame-width
     2326         ,input  true
     2327         ) .
     2328     end.
     2329   end procedure.
     2330   procedure diasize_restore-current-size :
     2331     do
     2332     on error undo, return error return-value
     2333     :
     2334       run diasize_set-height in this-procedure
     2335         (input  v-diasize-current-frame-height
     2336         ,input  true
     2337         ) .
     2338       run diasize_set-width in this-procedure
     2339         (input  v-diasize-current-frame-width
     2340         ,input  true
     2341         ) .
     2342     end.
     2343   end procedure.
     2344   procedure diasize_set-browse-handle :
     2345     define input  parameter p-browse-handle as handle   no-undo .
     2346     define buffer buf_temp-browse-handle for temp-browse-handle .
     2347     do
     2348     on error undo, return error return-value
     2349     :
     2350       assign
     2351         v-diasize-browse-handle = p-browse-handle
     2352       .
     2353       for each buf_temp-browse-handle
     2354       on error undo, return error return-value
     2355       :
     2356         delete buf_temp-browse-handle .
     2357       end.
     2358     end.
     2359   end procedure.
     2360   procedure diasize_add_browse :
     2361     define input  parameter p-browse-type   as character no-undo .
     2362     define input  parameter p-browse-handle as handle    no-undo .
     2363     define buffer buf_temp-browse-handle for temp-browse-handle .
     2364     do
     2365     on error undo, return error return-value
     2366     :
     2367       assign
     2368         v-diasize-browse-number = v-diasize-browse-number + 1
     2369       .
     2370       create buf_temp-browse-handle .
     2371       assign
     2372         buf_temp-browse-handle.browse-type   = p-browse-type
     2373         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2374         buf_temp-browse-handle.browse-handle = p-browse-handle
     2375       .
     2376     end.
     2377   end procedure.
     2378   procedure diasize_init :
     2379     define variable v-default-value    as logical   no-undo .
     2380     define variable v-restore-saved    as logical   no-undo .
     2381     define variable v-resize-value-str as character no-undo .
     2382     do
     2383     on error undo, return error return-value
     2384     :
     2385       do with frame Dialog-Frame
     2386       :
     2387         assign
     2388           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2389           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2390           v-diasize-browse-handle     = browse br-ccountry :handle
     2391         .
     2392         create button v-diasize-resize-button
     2393         assign
     2394           parent        = frame Dialog-Frame :first-child
     2395           label         = "s"
     2396           height-pixels = 16
     2397           width-pixels  = 16
     2398           visible       = true
     2399           sensitive     = true
     2400           movable       = true
     2401           triggers:
     2402             on end-move persistent run diasize_end-move in this-procedure .
     2403           end triggers.
     2404         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2405         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2406         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2407         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2408         assign
     2409           v-diasize-wndmax = false
     2410         .
     2411         if connected("ub") = true
     2412         then do:
     2413           define variable v-cntxt-db-num        as integer   no-undo .
     2414           define variable v-cntxt-userid        as character no-undo .
     2415           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2416                                             , OUTPUT v-cntxt-userid
     2417                                             ) .
     2418           run gbl/wndpar_r.p
     2419             (input  v-cntxt-db-num
     2420             ,input  v-cntxt-userid
     2421             ,input  'wndmax':U
     2422             ,output v-diasize-wndmax
     2423             ,output v-default-value
     2424             ) .
     2425         end.
     2426         assign
     2427           v-diasize-wndstore = false
     2428         .
     2429         if connected("ub") = true
     2430         then do:
     2431           run gbl/wndpar_r.p
     2432             (input  v-cntxt-db-num
     2433             ,input  v-cntxt-userid
     2434             ,input  'wndstore':U
     2435             ,output v-diasize-wndstore
     2436             ,output v-default-value
     2437             ) .
     2438         end.
     2439         assign
     2440           v-diasize-proc-name = entry(1, program-name(2), '.')
     2441         .
     2442         if v-diasize-wndstore = true
     2443         then do:
     2444           assign
     2445             v-restore-saved = false
     2446           .
     2447           if connected("ub") = true
     2448           then do:
     2449             run gbl/wndsizer.p
     2450               (input  v-cntxt-db-num
     2451               ,input  v-cntxt-userid
     2452               ,input  v-diasize-proc-name
     2453               ,input  'height':u
     2454               ,output v-resize-value-str
     2455               ) .
     2456             if v-resize-value-str <> '':U
     2457             then do:
     2458               run diasize_change-height in this-procedure
     2459                 (input  integer(v-resize-value-str)
     2460                 ,input  true
     2461                 ) .
     2462               assign
     2463                 v-restore-saved = true
     2464               .
     2465             end.
     2466           end.
     2467           if connected("ub") = true
     2468           then do:
     2469             run gbl/wndsizer.p
     2470               (input  v-cntxt-db-num
     2471               ,input  v-cntxt-userid
     2472               ,input  v-diasize-proc-name
     2473               ,input  'width':u
     2474               ,output v-resize-value-str
     2475               ) .
     2476             if v-resize-value-str <> '':U
     2477             then do:
     2478               run diasize_change-width in this-procedure
     2479                 (input  integer(v-resize-value-str)
     2480                 ,input  true
     2481                 ) .
     2482               assign
     2483                 v-restore-saved = true
     2484               .
     2485             end.
     2486           end.
     2487           if v-restore-saved <> true
     2488           then do:
     2489             if v-diasize-wndmax = true
     2490             then do:
     2491               run diasize_maximize in this-procedure
     2492                 (input  true
     2493                 ) .
     2494             end.
     2495           end.
     2496         end.
     2497         else do:
     2498           if v-diasize-wndmax = true
     2499           then do:
     2500             run diasize_maximize in this-procedure
     2501               (input  true
     2502               ) .
     2503           end.
     2504         end.
     2505       end.
     2506     end.
     2507   end procedure.
     2508   procedure diasize_need-full-display :
     2509     define output parameter p-need-full-display as logical   no-undo .
     2510     do
     2511     on error undo, return error return-value
     2512     :
     2513       assign
     2514         p-need-full-display = v-diasize-need-full-display
     2515       .
     2516       assign
     2517         v-diasize-need-full-display = false
     2518       .
     2519     end.
     2520   end procedure.
     2521   procedure get-context :
     2522      define output parameter p-db-num as integer          no-undo.
     2523      define output parameter p-user-id as character        no-undo.
     2524      define variable v-login               as character    no-undo.
     2525      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2526      define buffer buf_user-login  for ub.user-login .
     2527      do
     2528      on error undo, return error
     2529      :
     2530            FIND FIRST buf_sys-ctrl no-lock.
     2531            ASSIGN
     2532               v-login = USERID("ub")
     2533               p-db-num = buf_sys-ctrl.db-num
     2534            .
     2535            FIND FIRST buf_user-login
     2536                 WHERE buf_user-login.db-num = p-db-num
     2537                   AND buf_user-login.user-login = v-login
     2538                 no-lock
     2539                 no-error
     2540                 .
     2541            IF AVAILABLE buf_user-login
     2542            THEN DO:
     2543               assign
     2544                  p-user-id = buf_user-login.user-id
     2545               .
     2546            END.
     2547      end.
     2548   end procedure.
     2549   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2550   on f5 of frame Dialog-Frame anywhere
     2551   do:
     2552     v-doc-rec = recid(X_country). run openbr in this-procedure. reposition br-ccountry to recid v-doc-rec no-error.              apply 'value-changed' to br-ccountry.
     2553       apply "VALUE-CHANGED" to br-ccountry.
     2554   end.
     2555   def var sort-labelbr-ccountry   as character no-undo .
     2556   def var sort-clmnbr-ccountry    as handle    no-undo .
     2557   def var cur-clmnbr-ccountry     as handle    no-undo .
     2558   def var cur-clmn-locbr-ccountry as integer   no-undo .
     2559   def var re-querybr-ccountry     as logical   initial no no-undo .
     2560   on start-search, ctrl-o of br-ccountry in frame Dialog-Frame do:
     2561      run sort-brbr-ccountry
     2562        (input (if available X_c-country
     2563                then recid(X_c-country)
     2564                else ?
     2565               )
     2566        ).
     2567   end.
     2568   PROCEDURE sort-brbr-ccountry :
     2569     define input parameter p-recid as recid no-undo .
     2570     if re-querybr-ccountry = no then do:
     2571       assign
     2572          cur-clmnbr-ccountry = br-ccountry:current-column in frame Dialog-Frame
     2573       .
     2574       if sort-clmnbr-ccountry <> ? then sort-clmnbr-ccountry:column-fgcolor = 0.
     2575       if cur-clmnbr-ccountry = sort-clmnbr-ccountry then do:
     2576         assign
     2577            sort-labelbr-ccountry = ""
     2578            sort-clmnbr-ccountry = ?
     2579         .
     2580        end.
     2581        else do:
     2582          assign
     2583            sort-labelbr-ccountry = cur-clmnbr-ccountry:label
     2584            sort-clmnbr-ccountry  = cur-clmnbr-ccountry
     2585            sort-clmnbr-ccountry:column-fgcolor = 4
     2586          .
     2587        end.
     2588      end.
     2589     assign
     2590       cur-clmn-locbr-ccountry = 1
     2591     .
     2592     def var column-handle as handle no-undo .
     2593     column-handle = br-ccountry:first-column.
     2594     do while valid-handle(column-handle) :
     2595       if column-handle = cur-clmnbr-ccountry then do:
     2596         leave .
     2597       end.
     2598       column-handle = column-handle:NEXT-COLUMN.
     2599       assign
     2600         cur-clmn-locbr-ccountry = cur-clmn-locbr-ccountry + 1
     2601       .
     2602     end.
     2603     case sort-labelbr-ccountry:
     2604           when X_c-country.short-name:label in browse br-ccountry then DO:   assign     sort-column-name = "X_c-country.short-name"   .   run OpenBr.   . END.
     2605           when X_c-country.corr-date:label in browse br-ccountry then DO:   assign     sort-column-name = "X_c-country.corr-date"   .   run OpenBr.   . END.
     2606       otherwise do:
     2607         assign
     2608           sort-column-name = ""
     2609         .
     2610         run OpenBr.
     2611           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-ccountry') then do:
     2612             run mv-brw-defaultbr-ccountry.
     2613           end.
     2614         if sort-labelbr-ccountry <> "" then do:
     2615           assign
     2616             cur-clmnbr-ccountry:column-fgcolor = 0
     2617           .
     2618         end.
     2619         assign
     2620           cur-clmn-locbr-ccountry = ?
     2621         .
     2622       end.
     2623     end case.
     2624       if cur-clmn-locbr-ccountry <> ? then do:
     2625         if can-do( this-procedure:internal-entries, 'ch-clmnbr-ccountry') then do:
     2626           run ch-clmnbr-ccountry in this-procedure (cur-clmn-locbr-ccountry).
     2627         end.
     2628       end.
     2629     if p-recid <> ? then do:
     2630       reposition br-ccountry to recid p-recid no-error.
     2631       apply "value-changed" to br-ccountry in frame Dialog-Frame.
     2632     end.
     2633     apply "entry" to br-ccountry in frame Dialog-Frame.
     2634   END PROCEDURE.
     2635   procedure re-open-query-srt-clmnbr-ccountry:
     2636   if cur-clmnbr-ccountry = ? then do:
     2637      run OpenBr.
     2638   end.
     2639   else do:
     2640      assign re-querybr-ccountry = yes.
     2641      run sort-brbr-ccountry
     2642        (input (if available X_c-country
     2643                then recid(X_c-country)
     2644                else ?
     2645               )
     2646        ).
     2647      assign re-querybr-ccountry = no.
     2648   end.
     2649   end.
     2650   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2651   do:
     2652     br-ccountry :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2653   end.
     2654   MAIN-BLOCK:
     2655   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2656      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2657    if LOOKUP(p-mode, 'one':U,
     2658                   chr(4)) = 0
     2659        then dO:
     2660       message
     2661       vss-workfile vss-revision vss-description skip
     2662       "Неверное значение параметров вызова p-mode"
     2663       p-mode
     2664       view-as alert-box ERROR.
     2665       return error .
     2666    end.
     2667    if p-mode = "one":U then do:
     2668     find first X_country no-lock where
     2669                   X_country.num-code = p-num-code no-error.
     2670       if not available X_country then do:
     2671           message
     2672           vss-workfile vss-revision vss-description skip
     2673           "Неверное значение параметра вызова p-num-code"
     2674           p-num-code
     2675           view-as alert-box ERROR.
     2676           return.
     2677       end.
     2678     end.
     2679   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2680   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2681     (output v-db-num
     2682     )  .
     2683    v-rid-list = p-rid-list.
     2684     RUN MyEnable.
     2685     RUn OpenBR.
     2686     HIDE mark-num in frame Dialog-Frame .
     2687     if v-doc-rec <> ? then
     2688     REPOSITION br-ccountry to recid v-doc-rec No-ERROR.
     2689   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2690   DEF VAR cur-clmn-numbr-ccountry as INT EXTENT 7 no-undo.
     2691   DEF VAR varmvibr-ccountry       as INT no-undo.
     2692   DEF VAR varmvjbr-ccountry       as INT no-undo.
     2693   DEF VAR varmvkbr-ccountry       as INT no-undo.
     2694   DEF VAR varmvlbr-ccountry       as INT no-undo.
     2695   DEF VAR move-elementbr-ccountry as INT no-undo.
     2696   def var jjbr-ccountry           as int no-undo.
     2697   do varmvibr-ccountry = 1 to EXTENT(cur-clmn-numbr-ccountry):
     2698     ASSIGN cur-clmn-numbr-ccountry[varmvibr-ccountry] = varmvibr-ccountry.
     2699   END.
     2700   RUN start-mv-clmnbr-ccountry.
     2701   PROCEDURE start-mv-clmnbr-ccountry:
     2702   def var old-session as logical no-undo.
     2703      old-session = SESSION:IMMEDIATE-DISPLAY.
     2704      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2705          IF  p-mode = 'one'  THEN DO:
     2706      DO jjbr-ccountry = NUM-ENTRIES('1,2,3,4,5,6,7') TO 1 BY -1:
     2707        RUN re-move-clmnbr-ccountry ( cur-clmn-numbr-ccountry[INTEGER(ENTRY (jjbr-ccountry, '1,2,3,4,5,6,7'))] , 1).
     2708      END.
     2709          END.
     2710      SESSION:IMMEDIATE-DISPLAY = old-session.
     2711   END.
     2712   ON ctrl-cursor-right OF BROWSE br-ccountry do:
     2713     RUN re-move-clmnbr-ccountry ( 1, 7).
     2714   END.
     2715   ON ctrl-cursor-left OF BROWSE br-ccountry do:
     2716     RUN re-move-clmnbr-ccountry (7, 1).
     2717   END.
     2718   PROCEDURE re-move-clmnbr-ccountry:
     2719     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2720     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2721     DO varmvibr-ccountry = 1 TO EXTENT(cur-clmn-numbr-ccountry):
     2722       if cur-clmn-numbr-ccountry[varmvibr-ccountry] = source-column THEN cur-clmn-numbr-ccountry[varmvibr-ccountry] = -1.
     2723     END.
     2724     if br-ccountry:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2725     if source-column > target-column THEN
     2726     DO varmvjbr-ccountry = source-column - 1 to target-column BY -1:
     2727       DO varmvibr-ccountry = 1 TO EXTENT(cur-clmn-numbr-ccountry):
     2728           if cur-clmn-numbr-ccountry[varmvibr-ccountry] = varmvjbr-ccountry THEN DO:
     2729             cur-clmn-numbr-ccountry[varmvibr-ccountry] = cur-clmn-numbr-ccountry[varmvibr-ccountry] + 1.
     2730           END.
     2731       END.
     2732     END.
     2733     ELSE
     2734     DO varmvjbr-ccountry = source-column + 1 to target-column:
     2735       DO varmvibr-ccountry = 1 TO EXTENT(cur-clmn-numbr-ccountry):
     2736         if cur-clmn-numbr-ccountry[varmvibr-ccountry] = varmvjbr-ccountry THEN DO:
     2737           cur-clmn-numbr-ccountry[varmvibr-ccountry] = cur-clmn-numbr-ccountry[varmvibr-ccountry] - 1.
     2738         END.
     2739       END.
     2740     END.
     2741     DO varmvibr-ccountry = 1 TO EXTENT(cur-clmn-numbr-ccountry):
     2742       if cur-clmn-numbr-ccountry[varmvibr-ccountry] = -1 THEN cur-clmn-numbr-ccountry[varmvibr-ccountry] = target-column.
     2743     END.
     2744   END PROCEDURE.
     2745   PROCEDURE ch-clmnbr-ccountry:
     2746     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2747     if cur-clmn-loc <= 1 then do:
     2748       return .
     2749     end.
     2750     DO varmvibr-ccountry = 1 TO EXTENT(cur-clmn-numbr-ccountry):
     2751       if cur-clmn-numbr-ccountry[varmvibr-ccountry] = cur-clmn-loc THEN move-elementbr-ccountry = varmvibr-ccountry.
     2752     END.
     2753     RUN re-move-clmnbr-ccountry (cur-clmn-loc, 1).
     2754   END PROCEDURE.
     2755   PROCEDURE mv-brw-defaultbr-ccountry:
     2756   def var old-session as logical no-undo.
     2757     old-session = SESSION:IMMEDIATE-DISPLAY.
     2758     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2759     do varmvlbr-ccountry = 1 to EXTENT(cur-clmn-numbr-ccountry):
     2760       RUN re-move-clmnbr-ccountry (cur-clmn-numbr-ccountry[varmvlbr-ccountry], varmvlbr-ccountry).
     2761     END.
     2762     RUN start-mv-clmnbr-ccountry.
     2763     SESSION:IMMEDIATE-DISPLAY = old-session.
     2764   END PROCEDURE.
     2765   .
     2766    run diasize_add_browse in this-procedure
     2767       (input  'width':u
     2768       ,input  browse br-changes :handle
     2769       ) .
     2770    run diasize_init in this-procedure .
     2771   WAIT-FOR GO OF FRAME Dialog-Frame.
     2772   END.
     2773   RUN disable_UI.
     2774   PROCEDURE disable_UI :
     2775     HIDE FRAME Dialog-Frame.
     2776   END PROCEDURE.
     2777   PROCEDURE enable_UI :
     2778     DISPLAY mark-num
     2779         WITH FRAME Dialog-Frame.
     2780     ENABLE b-quit B-mark B-sel B-Help br-ccountry BR-changes mark-num
     2781         WITH FRAME Dialog-Frame.
     2782     VIEW FRAME Dialog-Frame.
     2783     OPEN QUERY br-ccountry FOR EACH X_c-country NO-LOCK INDEXED-REPOSITION.
     2784   END PROCEDURE.
     2785   PROCEDURE MyEnable :
     2786   assign
     2787   temp-changes.l_name:resizable in browse br-changes = true
     2788   temp-changes.v_old:resizable in browse br-changes = true
     2789   temp-changes.v_new:resizable in browse br-changes = true
     2790   temp-changes.l_name:width in browse br-changes = 30
     2791   temp-changes.v_old:width in browse br-changes = 40
     2792   temp-changes.v_new:width in browse br-changes = 40
     2793   .
     2794   DISPLAY mark-num
     2795   WITH FRAME Dialog-Frame.
     2796   ENABLE
     2797   b-quit
     2798   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2799   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2800   B-Help
     2801   br-ccountry mark-num
     2802   br-changes
     2803   with FRAME Dialog-Frame .
     2804   VIEW FRAME Dialog-Frame .
     2805   END PROCEDURE.
     2806   PROCEDURE OpenBr :
     2807   OPEN QUERY br-ccountry FOR EACH X_c-country NO-LOCK where
     2808                                  X_c-country.num-code = p-num-code
     2809                              AND X_c-country.corr-user-db-num = 0
     2810                                 INDEXED-REPOSITION.
     2811   APPLY "VALUE-CHANGED" TO br-ccountry in frame Dialog-Frame.
     2812   APPLY "ENTRY" TO br-ccountry.
     2813   END PROCEDURE.
     2814   PROCEDURE proc-br-ccountry :
     2815   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2816   if b-sel:sensitive in frame Dialog-Frame then dO:
     2817       if b-mark:sensitive then do:
     2818           apply "choose" to b-mark in frame Dialog-Frame.
     2819       end.
     2820       else do:
     2821           apply "choose" to b-sel in frame Dialog-Frame.
     2822       end.
     2823   end.
     2824   else do:
     2825       if b-lookup:sensitive then
     2826       apply "choose" to b-lookup in frame Dialog-Frame.
     2827   end.
     2828   END PROCEDURE.
     2829   PROCEDURE proc-view-changes :
     2830   for each temp-changes:
     2831       delete temp-changes.
     2832   END.
     2833   if not available X_c-country then do:
     2834     Open QUery br-changes for each temp-changes.
     2835     return.
     2836   end.
     2837   define variable v-label-param as character no-undo .
     2838   v-label-param =
     2839     "long-name" + chr(4) + "Название" + chr(4) + "" + chr(8)
     2840    + "num-code" + chr(4) + "Цифровой код" + chr(4) + "" + chr(8)
     2841    + "alpha1" + chr(4) + "Код страны" + chr(4) + "" + chr(8)
     2842    + "alpha2" + chr(4) + "Код страны-2" + chr(4) + "" + chr(8)
     2843    + "short-name" + chr(4) + "Короткое название" + chr(4) + ""  .
     2844    run proc-full-temp-changes in this-procedure (
     2845                                                input  buffer X_c-country:handle
     2846                                               ,input  'country':U
     2847                                               ,input  "long-name,num-code,alpha1,alpha2,short-name"
     2848                                               ,input  v-label-param).
     2849   Open QUery br-changes for each temp-changes.
     2850   END PROCEDURE.
