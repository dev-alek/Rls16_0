        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-gr-per-val-code like ub.group-period-validity.gr-per-val-code no-undo .
        5   define input parameter p-gr-per-val-name like ub.group-period-validity.gr-per-val-name no-undo .
        6   define input parameter p-des like ub.group-period-validity.des no-undo .
        7   define input parameter p-gr-per-from like ub.group-period-validity.gr-per-from no-undo .
        8   define input parameter p-gr-per-to   like ub.group-period-validity.gr-per-to no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: gperval1.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: ref/gperval1.p $":U .
       14   define variable vss-description as character no-undo init "Сохранение изменений в карточке группы сроков годности".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable v-db-num like ub.db.db-num no-undo .
       76   if p-mode <> 'ДОБАВЛЕНИЕ':U
       77   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       78     message
       79     vss-workfile vss-revision vss-description skip
       80     "Неверный параметр p-mode" p-mode
       81     view-as alert-box error .
       82     return error '':u.
       83   end.
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       86     (output v-db-num
       87     )  .
       88   if v-db-num <> 0 then do:
       89     run err-mess (substitute("Нельзя изменять запись ГРУППЫ СРОКОВ ГОДНОСТИ в УБД: Номер текущей БД &1"
       90                   , v-db-num) ).
       91     undo, return error "":U.
       92   end.
       93   if
       94   p-gr-per-from > p-gr-per-to then do:
       95     run err-mess (substitute("Неверно задан диапазон дней количества срока годности: &1 &2"
       96                  , string(p-gr-per-from)
       97                  , string(p-gr-per-to)) ).
       98     return error "gr-per-from":U.
       99   end.
      100   if p-gr-per-val-name = "":U then do:
      101     run err-mess ("Название ГРУППЫ СРОКОВ ГОДНОСТИ не может быть пустым").
      102     return error "gr-per-val-name":U.
      103   end.
      104   _MAIN:
      105   DO ON ERROR UNDO, RETURN ERROR
      106   ON STOP UNDO, RETURN ERROR:
      107     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      108       create ub.group-period-validity.
      109       assign
      110       ub.group-period-validity.gr-per-val-code = next-value(delivery, ub)
      111       p-doc-rec = recid(ub.group-period-validity)
      112       .
      113     end.
      114     else do:
      115       FIND FIRST ub.group-period-validity where
      116                 recid(ub.group-period-validity) = p-doc-rec No-ERROR.
      117       if not available ub.group-period-validity then do:
      118         message
      119         vss-workfile vss-revision vss-description skip
      120         "Не найдена запись ГРУППЫ СРОКОВ ГОДНОСТИ - p-doc-rec" p-doc-rec
      121         view-as alert-box error .
      122         undo, return error '':u.
      123       end.
      124       if ub.group-period-validity.gr-per-val-code <> p-gr-per-val-code
      125       then do:
      126         message
      127         vss-workfile vss-revision vss-description skip
      128         "Для уже имеющейся записи нельзя изменить"
      129         "внутренний код группы" skip
      130         view-as alert-box ERROR.
      131         undo, return error '':U.
      132       end.
      133     end.
      134     assign
      135     ub.group-period-validity.gr-per-val-name     = p-gr-per-val-name
      136     ub.group-period-validity.des                 = p-des
      137     ub.group-period-validity.gr-per-from         = p-gr-per-from
      138     ub.group-period-validity.gr-per-to           = p-gr-per-to
      139     ub.group-period-validity.sts                 =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      140                                then 0
      141                                else ub.group-period-validity.sts)
      142     .
      143     release ub.group-period-validity no-error.
      144     if error-status:error then do:
      145        run err-mess(substitute("Ошибка при сохранении записи ГРУППЫ СРОКОВ ГОДНОСТИ с кодом &1: &2: &3"
      146                                , p-gr-per-val-code
      147                                , ERROR-STATUS:GET-message(1)
      148                                , return-value
      149                                )).
      150       undo, return error "":U.
      151    end.
      152   end.
      153   PROCEDURE err-mess:
      154     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      155         message
      156         p-mess
      157         view-as alert-box error .
      158   END PROCEDURE.
