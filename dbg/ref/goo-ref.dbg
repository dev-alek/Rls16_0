     4300   define buffer buf_bar-code for ub.bar-code .
     4301   define buffer buf_prod-bc for ub.prod-bc.
     4302   define buffer buf_place for ub.place.
     4303     assign
     4304     frame d-goo-doc-ref
     4305     loc-code
     4306     a-n-c.
     4307     if a-n-c = "datamatrix"
     4308     then do:
     4309   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     4310   (
     4311    input  parparentproc
     4312   ,input  loc-code
     4313   ,input  ?
     4314   ,input  p-obj-type
     4315   ,input  p-obj-code
     4316   ,input  yes
     4317   ,input  no
     4318   ,input  varscales-pref25
     4319   ,input  varpgscales-pref25
     4320   ,output varresult
     4321   ,output vartype-bc
     4322   ,output varweight
     4323   ,buffer buf_bar-code
     4324   ,buffer buf_prod-bc
