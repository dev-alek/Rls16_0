     4045   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4046   DEF VAR cur-clmn-numbr-gds as INT EXTENT 16 no-undo.
     4047   DEF VAR varmvibr-gds       as INT no-undo.
     4048   DEF VAR varmvjbr-gds       as INT no-undo.
     4049   DEF VAR varmvkbr-gds       as INT no-undo.
     4050   DEF VAR varmvlbr-gds       as INT no-undo.
     4051   DEF VAR move-elementbr-gds as INT no-undo.
     4052   def var jjbr-gds           as int no-undo.
     4053   do varmvibr-gds = 1 to EXTENT(cur-clmn-numbr-gds):
     4054     ASSIGN cur-clmn-numbr-gds[varmvibr-gds] = varmvibr-gds.
     4055   END.
     4056   RUN start-mv-clmnbr-gds.
     4057   PROCEDURE start-mv-clmnbr-gds:
     4058   def var old-session as logical no-undo.
     4059      old-session = SESSION:IMMEDIATE-DISPLAY.
     4060      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4061      SESSION:IMMEDIATE-DISPLAY = old-session.
     4062   END.
     4063   ON ctrl-cursor-right OF BROWSE br-gds do:
     4064     RUN re-move-clmnbr-gds ( 6, 16).
     4065   END.
     4066   ON ctrl-cursor-left OF BROWSE br-gds do:
     4067     RUN re-move-clmnbr-gds (16, 6).
     4068   END.
     4069   PROCEDURE re-move-clmnbr-gds:
     4070     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4071     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4072     DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     4073       if cur-clmn-numbr-gds[varmvibr-gds] = source-column THEN cur-clmn-numbr-gds[varmvibr-gds] = -1.
     4074     END.
     4075     if br-gds:MOVE-COLUMN(source-column, target-column) IN FRAME d-goo-doc-ref then.
     4076     if source-column > target-column THEN
     4077     DO varmvjbr-gds = source-column - 1 to target-column BY -1:
     4078       DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     4079           if cur-clmn-numbr-gds[varmvibr-gds] = varmvjbr-gds THEN DO:
     4080             cur-clmn-numbr-gds[varmvibr-gds] = cur-clmn-numbr-gds[varmvibr-gds] + 1.
     4081           END.
     4082       END.
     4083     END.
     4084     ELSE
     4085     DO varmvjbr-gds = source-column + 1 to target-column:
     4086       DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     4087         if cur-clmn-numbr-gds[varmvibr-gds] = varmvjbr-gds THEN DO:
     4088           cur-clmn-numbr-gds[varmvibr-gds] = cur-clmn-numbr-gds[varmvibr-gds] - 1.
     4089         END.
     4090       END.
     4091     END.
     4092     DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     4093       if cur-clmn-numbr-gds[varmvibr-gds] = -1 THEN cur-clmn-numbr-gds[varmvibr-gds] = target-column.
     4094     END.
     4095   END PROCEDURE.
     4096   PROCEDURE ch-clmnbr-gds:
     4097     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4098     if cur-clmn-loc <= 6 then do:
     4099       return .
     4100     end.
     4101     DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     4102       if cur-clmn-numbr-gds[varmvibr-gds] = cur-clmn-loc THEN move-elementbr-gds = varmvibr-gds.
     4103     END.
     4104     RUN re-move-clmnbr-gds (cur-clmn-loc, 6).
     4105   END PROCEDURE.
     4106   PROCEDURE mv-brw-defaultbr-gds:
     4107   def var old-session as logical no-undo.
     4108     old-session = SESSION:IMMEDIATE-DISPLAY.
     4109     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4110     do varmvlbr-gds = 6 to EXTENT(cur-clmn-numbr-gds):
     4111       RUN re-move-clmnbr-gds (cur-clmn-numbr-gds[varmvlbr-gds], varmvlbr-gds).
     4112     END.
     4113     RUN start-mv-clmnbr-gds.
     4114     SESSION:IMMEDIATE-DISPLAY = old-session.
     4115   END PROCEDURE.
     4116   .
