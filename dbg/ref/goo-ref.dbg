     3594   define variable v-val-logical   as logical    no-undo.
     3595   define variable v-tthd          as handle     no-undo.
     3596   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
     3597   PROCEDURE imagelist_loaddef:
     3598       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
     3599       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
     3600       ASSIGN
     3601           vPar-val  = "":U
     3602           vPar-type = "":U
     3603           .
     3604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3605     (input  'photo':u
     3606     ,input  '':u
     3607     ,input  '':u
     3608     ,input  0
     3609     ,input  '':u
     3610     ,input  '':u
     3611     ,input  '':u
     3612     ,input  no
     3613     ,output vPar-val
     3614     ,output vPar-type
     3615     ) no-error .
     3616           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
     3617       IF mImagePh THEN .
     3618       ELSE RETURN.
     3619       ASSIGN
     3620           vPar-val  = "":U
     3621           vPar-type = "":U
     3622           .
     3623   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3624     (input  'ph-dir':u
     3625     ,input  '':u
     3626     ,input  '':u
     3627     ,input  0
     3628     ,input  '':u
     3629     ,input  '':u
     3630     ,input  '':u
     3631     ,input  NO
     3632     ,output vPar-val
     3633     ,output vPar-type
     3634     ) no-error .
     3635       IF LENGTH (vPar-val) = 0 THEN
     3636           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
     3637       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
     3638       ASSIGN
     3639           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
     3640           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
     3641           mImagePreDir = mImagePath
     3642           mImageDir    = mImagePreDir
     3643           mImageTrash  = mImagePath + "trash\":U
     3644           .
     3645       ASSIGN
     3646           vPar-val  = "":U
     3647           vPar-type = "":U
     3648           .
     3649               run adm/shattri.p (
     3650           input "get":U
     3651           ,input  '':U
     3652           ,input  0
     3653           ,input  'gds-ref':U
     3654           ,input  'shema-foto':U
     3655           ,output v-value-char
     3656           ,output v-val-date
     3657           ,output v-val-decimal
     3658           ,output v-val-integer
     3659           ,output v-val-logical
     3660           ,output v-param-types
     3661           ,INPUT-OUTPUT table-handle v-tthd
     3662           ) no-error.
     3663           delete object v-tthd.
     3664           mPhotomgd = IF v-val-integer = 2 then yes else no.
     3665   END PROCEDURE.
     3666   PROCEDURE imagelist_decode:
     3667       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     3668       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
     3669       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     3670       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     3671       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     3672       ASSIGN
     3673           oImageList = iImageList
     3674           .
     3675       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     3676           vCh =ENTRY (vInt, iImageList, ",":U).
     3677           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
     3678           ELSE
     3679           DO:
     3680               ASSIGN
     3681                   vCh = REPLACE (vCh, "~/":U, "\":U)
     3682                   vCh = REPLACE (vCh, "~\":U, "\":U)
     3683                   .
     3684               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
     3685               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
     3686               ENTRY (vInt, oImageList, ",":U) = vCh.
     3687           END.
     3688       END.
     3689   END PROCEDURE.
     3690   PROCEDURE imagelist_encode:
     3691       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     3692       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     3693       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     3694       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     3695       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
     3696       ASSIGN
     3697           oImageList = iImageList
     3698           vLen       = LENGTH (mImageDir)
     3699           .
     3700       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     3701           vCh =ENTRY (vInt, iImageList, ",":U).
     3702           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
     3703               ENTRY (vInt, oImageList, ",":U) =
     3704                   SUBSTRING (vCh, vLen + 1).
     3705       END.
     3706   END PROCEDURE.
