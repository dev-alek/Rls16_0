     4181   PROCEDURE proc-valchg-a-n-c:
     4182     case input frame d-goo-doc-ref a-n-c :
     4183       when "art" then do:
     4184         apply "entry" to br-gds in frame d-goo-doc-ref.
     4185         hide loc-name loc-code
     4186         in frame d-goo-doc-ref.
     4187         loc-art = "".
     4188           NameContext = "" .
     4189           hide NameContext in frame d-goo-doc-ref.
     4190           if a-n-c <> a-n-c:screen-value then do:
     4191             assign a-n-c.
     4192             RUN openbr in this-procedure ( input no, input yes ,input no, input '').
     4193           end.
     4194       end.
     4195       when "name" then do:
     4196         enable loc-name with frame d-goo-doc-ref.
     4197         disp loc-name with frame d-goo-doc-ref.
     4198         hide loc-art loc-code
     4199         in frame d-goo-doc-ref.
     4200         NameContext = "" .
     4201         hide NameContext in frame d-goo-doc-ref.
     4202         if a-n-c <> a-n-c:screen-value then do:
     4203           assign a-n-c.
     4204           RUN openbr in this-procedure ( input no, input yes ,input no, input '').
     4205         end.
     4206         apply "entry" to loc-name in frame d-goo-doc-ref.
     4207       end.
     4208       when "code"
     4209    or when "DataMatrix" then
     4210       do:
     4211         enable loc-code with frame d-goo-doc-ref.
     4212         disp loc-code with frame d-goo-doc-ref.
     4213         hide loc-art loc-name
     4214         in frame d-goo-doc-ref.
     4215         NameContext = "" .
     4216         hide NameContext in frame d-goo-doc-ref.
     4217         if a-n-c <> a-n-c:screen-value then do:
     4218           assign a-n-c.
     4219           RUN openbr in this-procedure ( input no, input yes ,input no, input '').
     4220         end.
     4221         apply "entry" to loc-code in frame d-goo-doc-ref.
     4222       end.
     4223       when "context" then do:
     4224         assign a-n-c .
     4225         enable NameContext with frame d-goo-doc-ref.
     4226         disp NameContext with frame d-goo-doc-ref.
     4227         apply "entry" to NameContext in frame d-goo-doc-ref.
     4228         HIDE loc-art loc-name loc-code in frame d-goo-doc-ref.
     4229       end .
     4230     end CASE.
     4231   END PROCEDURE.
     4232   PROCEDURE proc-any-printable-br-gds :
     4233     if input frame d-goo-doc-ref a-n-c = "art" then do:
     4234       if last-event:label = " " and
     4235          loc-art = "" then
     4236       return error.
     4237   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4238     case g-list :
     4239       when 'все':U then do:
     4240   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4241   find first l-goo-doc where true AND (if g-stat = 'все':U then true else (if g-stat = 'текущие':U then (l-goo-doc.stts = 0) else (l-goo-doc.stts = 1)))
     4242                                     and l-goo-doc.artic begins (loc-art + last-event:label) no-lock no-error.
     4243       end.
     4244       when 'Производитель':U then do:
     4245   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4246   find first l-goo-doc where l-goo-doc.prod-type = g-producer.obj-type                                and l-goo-doc.prod-code = g-producer.obj-code AND (if g-stat = 'все':U then true else (if g-stat = 'текущие':U then (l-goo-doc.stts = 0) else (l-goo-doc.stts = 1)))
     4247                                     and l-goo-doc.artic begins (loc-art + last-event:label) no-lock no-error.
     4248       end.
     4249       when 'группа':U then do:
     4250   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4251   find first l-goo-doc where l-goo-doc.grp-name begins g-grp AND (if g-stat = 'все':U then true else (if g-stat = 'текущие':U then (l-goo-doc.stts = 0) else (l-goo-doc.stts = 1)))
     4252                                     and l-goo-doc.artic begins (loc-art + last-event:label) no-lock no-error.
     4253       end.
     4254     end.
     4255       if available l-goo-doc then do:
     4256         loc-art = loc-art + last-event:label.
     4257         disp loc-art with frame d-goo-doc-ref.
     4258         line-rec = recid (l-goo-doc).
     4259         reposition br-gds to recid line-rec no-error.
     4260         if error-status:error then do:     run ref/gdsrepos.p (input 1,                    input g-cond,                    input g-list,                    input g-stat,                    input flt-rec,                    output g#log,                    output contin).     if g#log then do:       run full-sch.       return error.     end.   end.   apply "VALUE-changed" to br-gds in frame d-goo-doc-ref.
     4261       end.
     4262     end.
     4263   END PROCEDURE.
     4264   PROCEDURE proc-backspace-br-gds:
