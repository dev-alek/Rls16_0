     4035   ASSIGN FRAME d-goo-doc-ref :SCROLLABLE = FALSE.
     4036   ASSIGN br-gds :NUM-LOCKED-COLUMNS IN FRAME d-goo-doc-ref = 4 .
     4037   ASSIGN b-rest  :POPUP-MENU IN FRAME d-goo-doc-ref = MENU m-ostatki :HANDLE.
