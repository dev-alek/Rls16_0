     7989                              loc-goo-doc.artic     = loc-gob-doc.artic     AND
     7990                              loc-goo-doc.prod-type = loc-gob-doc.prod-type AND
     7991                              loc-goo-doc.prod-code = loc-gob-doc.prod-code AND
     7992                              loc-gob-doc.obj-type  = p-obj-type            AND
     7993                              loc-gob-doc.obj-code  = p-obj-code            NO-ERROR.
     7994                   assign
     7995                     g-rep = ( if available loc-gob-doc then recid( loc-gob-doc ) else g-rep )
     7996                   .
     7997               a-n-c = "".
     7998               apply "go":U to frame d-goo-doc-ref.
     7999               return error.
