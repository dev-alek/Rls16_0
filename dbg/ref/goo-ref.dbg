     8809   v-indicator-life-gds:resizable in browse br-gds = true .
     8810   v-indicator-life-gds:width in browse br-gds = 8 .
     8811   .
     8812   RUN enable_UI IN THIS-PROCEDURE.
     8813   RUN buttons   IN THIS-PROCEDURE.
     8814   g#log = ( if rs-cond :screen-value in frame d-goo-doc-ref = 'все':U
     8815             and dbtype("ub") = 'PROGRESS'
     8816             then a-n-c :enable(  "Нач.слова" )
