     4327        if varresult eq "prod-bc"
     4328        then
     4329           loc-code:screen-value in frame d-goo-doc-ref = buf_prod-bc.b-str.
     4330     end.
     4331     else do:
     4332   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     4333   (
     4334    input  parparentproc
     4335   ,input  loc-code
     4336   ,input  ?
     4337   ,input  p-obj-type
     4338   ,input  p-obj-code
     4339   ,input  yes
     4340   ,input  no
