     5827         then do:
     5828           assign
     5829             frame d-goo-doc-ref :virtual-width = frame d-goo-doc-ref :virtual-width + p-change-value
     5830           no-error .
     5831           if error-status :error
     5832           or error-status :get-message(1) <> ""
     5833           then do:
     5834             undo move_block, retry move_block.
     5835           end.
     5836         end.
     5837       end.
     5838       if p-move-resize
     5839       then do:
     5840         run diasize_position-resize-button in this-procedure .
     5841       end.
     5842       if v-diasize-wndstore = true
     5843       then do:
     5844         if connected("ub") = true
     5845         then do:
     5846           define variable v-cntxt-db-num        as integer   no-undo .
     5847           define variable v-cntxt-userid        as character no-undo .
     5848           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5849                                             , OUTPUT v-cntxt-userid
     5850                                             ) .
     5851           run gbl/wndsizew.p
     5852             (input  v-cntxt-db-num
     5853             ,input  v-cntxt-userid
     5854             ,input  v-diasize-proc-name
     5855             ,input  'width':u
     5856             ,input  string(frame d-goo-doc-ref :width - v-diasize-orig-frame-width)
     5857             ) .
     5858         end.
     5859       end.
     5860     end.
     5861     assign
     5862       v-diasize-change-size = false
     5863     .
     5864   end procedure.
     5865   procedure diasize_set-width :
     5866     define input  parameter p-new-width  as decimal   no-undo .
     5867     define input  parameter p-move-resize as logical   no-undo .
     5868     do
     5869     on error undo, return error return-value
     5870     :
     5871       run diasize_change-width in this-procedure
     5872         (input  (p-new-width - frame d-goo-doc-ref :width)
     5873         ,input  p-move-resize
     5874         ) .
     5875     end.
     5876   end procedure.
     5877   procedure diasize_position-resize-button :
     5878     do with frame d-goo-doc-ref
     5879     :
     5880       hide v-diasize-resize-button .
     5881       assign
     5882         v-diasize-resize-button :row = frame d-goo-doc-ref :height - v-diasize-resize-button :height
     5883                     - 1
     5884                     - (frame d-goo-doc-ref :border-bottom-pixels / session :pixels-per-row)
     5885         v-diasize-resize-button :col = frame d-goo-doc-ref :width - v-diasize-resize-button :width
     5886                     - 1
     5887                     - (frame d-goo-doc-ref :border-right-pixels / session :pixels-per-column)
     5888       .
     5889       view v-diasize-resize-button .
     5890     end.
     5891   end procedure.
     5892   on alt-right anywhere
     5893   do:
     5894     run diasize_change-width in this-procedure
     5895       (input 1
     5896       ,input true
     5897       ) .
     5898     return no-apply .
     5899   end.
     5900   on alt-left anywhere
     5901   do:
     5902     run diasize_change-width in this-procedure
     5903       (input -1
     5904       ,input true
     5905       ) .
     5906     return no-apply .
     5907   end.
     5908   on alt-down anywhere
     5909   do:
     5910     run diasize_change-height in this-procedure
     5911       (input 1
     5912       ,input true
     5913       ) .
     5914     return no-apply .
     5915   end.
     5916   on alt-up anywhere
     5917   do:
     5918     run diasize_change-height in this-procedure
     5919       (input -1
     5920       ,input true
     5921       ) .
     5922     return no-apply .
     5923   end.
     5924   on alt-enter of frame d-goo-doc-ref
     5925   do:
     5926     run diasize_maximize in this-procedure
     5927       (input  ?
     5928       ).
     5929     return no-apply .
     5930   end.
     5931   procedure diasize_end-move :
     5932     do
     5933     on error undo, return error return-value
     5934     :
     5935       define variable v-row-delta as decimal   no-undo .
     5936       define variable v-col-delta as decimal   no-undo .
     5937       define variable v-new-row as decimal   no-undo .
     5938       define variable v-new-col as decimal   no-undo .
     5939       assign
     5940         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5941         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5942       .
     5943       assign
     5944         v-row-delta = v-new-row - frame d-goo-doc-ref :height
     5945         v-col-delta = v-new-col - frame d-goo-doc-ref :width
     5946       .
     5947       run diasize_change-height in this-procedure
     5948         (input v-row-delta
     5949         ,input true
     5950         ) .
     5951       run diasize_change-width in this-procedure
     5952         (input v-col-delta
     5953         ,input true
     5954         ) .
     5955     end.
     5956   end procedure.
     5957   procedure diasize_maximize :
     5958     define input  parameter p-action as logical   no-undo .
     5959     do
     5960     on error undo, return error return-value
     5961     :
     5962       if p-action = ?
     5963       then do:
     5964         if v-diasize-need-maximize = true
     5965         then do:
     5966           assign
     5967             p-action = true
     5968           .
     5969         end.
     5970         else do:
     5971           assign
     5972             p-action = false
     5973           .
     5974         end.
     5975       end.
     5976       if p-action = true
     5977       then do:
     5978         run diasize_change-height in this-procedure
     5979           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5980               - frame d-goo-doc-ref :height-chars
     5981           ,input true
     5982           ) .
     5983         run diasize_change-width in this-procedure
     5984           (input session :width-chars
     5985               - frame d-goo-doc-ref :width-chars
     5986           ,input true
     5987           ) .
     5988         assign
     5989           v-diasize-need-maximize = false
     5990         .
     5991       end.
     5992       else do:
     5993         run diasize_change-width in this-procedure
     5994           (input v-diasize-orig-frame-width
     5995               - frame d-goo-doc-ref :width-chars
     5996           ,input true
     5997           ) .
     5998         run diasize_change-height in this-procedure
     5999           (input v-diasize-orig-frame-height
     6000               - frame d-goo-doc-ref :height-chars
     6001           ,input true
     6002           ) .
     6003         assign
     6004           v-diasize-need-maximize = true
     6005         .
     6006       end.
     6007     end.
     6008   end procedure.
     6009   procedure diasize_restore-orig-size :
     6010     do
     6011     on error undo, return error return-value
     6012     :
     6013       assign
     6014         v-diasize-current-frame-width  = frame d-goo-doc-ref :width
     6015         v-diasize-current-frame-height = frame d-goo-doc-ref :height
     6016       .
     6017       run diasize_set-height in this-procedure
     6018         (input  v-diasize-orig-frame-height
     6019         ,input  true
     6020         ) .
     6021       run diasize_set-width in this-procedure
     6022         (input  v-diasize-orig-frame-width
     6023         ,input  true
     6024         ) .
     6025     end.
     6026   end procedure.
     6027   procedure diasize_restore-current-size :
     6028     do
     6029     on error undo, return error return-value
     6030     :
     6031       run diasize_set-height in this-procedure
     6032         (input  v-diasize-current-frame-height
     6033         ,input  true
     6034         ) .
     6035       run diasize_set-width in this-procedure
     6036         (input  v-diasize-current-frame-width
     6037         ,input  true
     6038         ) .
     6039     end.
     6040   end procedure.
     6041   procedure diasize_set-browse-handle :
     6042     define input  parameter p-browse-handle as handle   no-undo .
     6043     define buffer buf_temp-browse-handle for temp-browse-handle .
     6044     do
     6045     on error undo, return error return-value
     6046     :
     6047       assign
     6048         v-diasize-browse-handle = p-browse-handle
     6049       .
     6050       for each buf_temp-browse-handle
     6051       on error undo, return error return-value
     6052       :
     6053         delete buf_temp-browse-handle .
     6054       end.
     6055     end.
     6056   end procedure.
     6057   procedure diasize_add_browse :
     6058     define input  parameter p-browse-type   as character no-undo .
     6059     define input  parameter p-browse-handle as handle    no-undo .
     6060     define buffer buf_temp-browse-handle for temp-browse-handle .
     6061     do
     6062     on error undo, return error return-value
     6063     :
     6064       assign
     6065         v-diasize-browse-number = v-diasize-browse-number + 1
     6066       .
     6067       create buf_temp-browse-handle .
     6068       assign
     6069         buf_temp-browse-handle.browse-type   = p-browse-type
     6070         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     6071         buf_temp-browse-handle.browse-handle = p-browse-handle
     6072       .
     6073     end.
     6074   end procedure.
     6075   procedure diasize_init :
     6076     define variable v-default-value    as logical   no-undo .
     6077     define variable v-restore-saved    as logical   no-undo .
     6078     define variable v-resize-value-str as character no-undo .
     6079     do
     6080     on error undo, return error return-value
     6081     :
     6082       do with frame d-goo-doc-ref
     6083       :
     6084         assign
     6085           v-diasize-orig-frame-height = frame d-goo-doc-ref :height
     6086           v-diasize-orig-frame-width  = frame d-goo-doc-ref :width
     6087           v-diasize-browse-handle     = browse br-gds :handle
     6088         .
     6089         create button v-diasize-resize-button
     6090         assign
     6091           parent        = frame d-goo-doc-ref :first-child
     6092           label         = "s"
     6093           height-pixels = 16
     6094           width-pixels  = 16
     6095           visible       = true
     6096           sensitive     = true
     6097           movable       = true
     6098           triggers:
     6099             on end-move persistent run diasize_end-move in this-procedure .
     6100           end triggers.
     6101         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     6102         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     6103         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     6104         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     6105         assign
     6106           v-diasize-wndmax = false
     6107         .
     6108         if connected("ub") = true
     6109         then do:
     6110           define variable v-cntxt-db-num        as integer   no-undo .
     6111           define variable v-cntxt-userid        as character no-undo .
     6112           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6113                                             , OUTPUT v-cntxt-userid
     6114                                             ) .
     6115           run gbl/wndpar_r.p
     6116             (input  v-cntxt-db-num
     6117             ,input  v-cntxt-userid
     6118             ,input  'wndmax':U
     6119             ,output v-diasize-wndmax
     6120             ,output v-default-value
     6121             ) .
     6122         end.
     6123         assign
     6124           v-diasize-wndstore = false
     6125         .
     6126         if connected("ub") = true
     6127         then do:
     6128           run gbl/wndpar_r.p
     6129             (input  v-cntxt-db-num
     6130             ,input  v-cntxt-userid
     6131             ,input  'wndstore':U
     6132             ,output v-diasize-wndstore
     6133             ,output v-default-value
     6134             ) .
     6135         end.
     6136         assign
     6137           v-diasize-proc-name = entry(1, program-name(2), '.')
     6138         .
     6139         if v-diasize-wndstore = true
     6140         then do:
     6141           assign
     6142             v-restore-saved = false
     6143           .
     6144           if connected("ub") = true
     6145           then do:
     6146             run gbl/wndsizer.p
     6147               (input  v-cntxt-db-num
     6148               ,input  v-cntxt-userid
     6149               ,input  v-diasize-proc-name
     6150               ,input  'height':u
     6151               ,output v-resize-value-str
     6152               ) .
     6153             if v-resize-value-str <> '':U
     6154             then do:
     6155               run diasize_change-height in this-procedure
     6156                 (input  integer(v-resize-value-str)
     6157                 ,input  true
     6158                 ) .
     6159               assign
     6160                 v-restore-saved = true
     6161               .
     6162             end.
     6163           end.
     6164           if connected("ub") = true
     6165           then do:
     6166             run gbl/wndsizer.p
     6167               (input  v-cntxt-db-num
     6168               ,input  v-cntxt-userid
     6169               ,input  v-diasize-proc-name
     6170               ,input  'width':u
     6171               ,output v-resize-value-str
     6172               ) .
     6173             if v-resize-value-str <> '':U
     6174             then do:
     6175               run diasize_change-width in this-procedure
     6176                 (input  integer(v-resize-value-str)
     6177                 ,input  true
     6178                 ) .
     6179               assign
     6180                 v-restore-saved = true
     6181               .
     6182             end.
     6183           end.
     6184           if v-restore-saved <> true
     6185           then do:
     6186             if v-diasize-wndmax = true
     6187             then do:
     6188               run diasize_maximize in this-procedure
     6189                 (input  true
     6190                 ) .
     6191             end.
     6192           end.
     6193         end.
     6194         else do:
     6195           if v-diasize-wndmax = true
     6196           then do:
     6197             run diasize_maximize in this-procedure
     6198               (input  true
     6199               ) .
     6200           end.
     6201         end.
     6202       end.
     6203     end.
     6204   end procedure.
     6205   procedure diasize_need-full-display :
     6206     define output parameter p-need-full-display as logical   no-undo .
     6207     do
     6208     on error undo, return error return-value
     6209     :
     6210       assign
     6211         p-need-full-display = v-diasize-need-full-display
     6212       .
     6213       assign
     6214         v-diasize-need-full-display = false
     6215       .
     6216     end.
     6217   end procedure.
     6218   procedure get-context :
     6219      define output parameter p-db-num as integer          no-undo.
     6220      define output parameter p-user-id as character        no-undo.
     6221      define variable v-login               as character    no-undo.
     6222      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     6223      define buffer buf_user-login  for ub.user-login .
     6224      do
     6225      on error undo, return error
     6226      :
     6227            FIND FIRST buf_sys-ctrl no-lock.
     6228            ASSIGN
     6229               v-login = USERID("ub")
     6230               p-db-num = buf_sys-ctrl.db-num
     6231            .
     6232            FIND FIRST buf_user-login
     6233                 WHERE buf_user-login.db-num = p-db-num
     6234                   AND buf_user-login.user-login = v-login
     6235                 no-lock
     6236                 no-error
     6237                 .
     6238            IF AVAILABLE buf_user-login
     6239            THEN DO:
     6240               assign
     6241                  p-user-id = buf_user-login.user-id
     6242               .
     6243            END.
     6244      end.
     6245   end procedure.
     6246       run diasize_init in this-procedure .
     6247   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6248   do:
     6249     br-gds :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     6250   end.
     6251   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6252   on f5 of frame d-goo-doc-ref anywhere
     6253   do:
     6254      if available goo-doc then gds-rec = recid(goo-doc). RUN openbr IN THIS-PROCEDURE ( INPUT YES, input yes, input no, input '' ).
     6255       apply "VALUE-CHANGED" to br-gds.
     6256   end.
     6257   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6258   procedure set-filter-name :
     6259   define input parameter p-filter-name as character no-undo .
     6260     do with frame d-goo-doc-ref:
     6261       if p-filter-name > "" then do:
     6262         assign
     6263           frame d-goo-doc-ref:title
     6264             = frame d-goo-doc-ref:title + "   ФИЛЬТР: " + p-filter-name.
     6265         .
     6266         assign
     6267           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     6268         .
     6269       end.
     6270       else do:
     6271         assign
     6272           b-sch :tooltip = ""
     6273         .
     6274       end.
     6275     end.
     6276   end procedure.
     6277   MAIN-BLOCK:
     6278   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6279      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6280   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6281     run mainmenu_getcntxt in parparentproc
     6282       (output v-cntxt-db-num
     6283       ,output v-cntxt-userid
     6284       ,output v-cntxt-level
     6285       ,output v-cntxt-host-code-obj
     6286       ,output v-cntxt-obj-type
     6287       ,output v-cntxt-obj-code
     6288       ,output v-cntxt-db-num-obj
     6289       ,output v-cntxt-is-admin
     6290       ) .
     6291     run main-block-proc in this-procedure no-error.
     6292     if error-status :error then do: return error. end.
     6293     WAIT-FOR GO OF FRAME d-goo-doc-ref FOCUS br-gds.
     6294   END.
     6295   assign
     6296   p-gds-name-width = gds-n:width in browse br-gds
     6297   p-grp-name-width = goo-doc.grp-name:width in browse br-gds
     6298   .
     6299   RUN disable_UI IN THIS-PROCEDURE.
     6300   PROCEDURE disable_UI :
     6301     HIDE FRAME d-goo-doc-ref NO-PAUSE.
     6302   END PROCEDURE.
     6303   PROCEDURE openbr :
     6304   define input parameter p-repos-message as logical no-undo .
     6305   define input parameter p-open-query as logical   no-undo .
     6306   define input parameter p-find-next as logical   no-undo .
     6307   define input parameter p-find-condition as character no-undo .
     6308   DEFINE VARIABLE pos-rec AS RECID NO-UNDO .
     6309   define buffer pos_goods for ub.goods.
     6310   define buffer cur-obj   for ub.clients.
     6311   FIND FIRST cur-obj NO-LOCK WHERE
     6312             cur-obj.obj-type = p-obj-type
     6313         AND cur-obj.obj-code = p-obj-code .
     6314   ASSIGN
     6315   FRAME d-goo-doc-ref rs-sort
     6316   .
     6317   assign
     6318     filter-point = "goo-doc" + "_" + string( g-stat )
     6319     filter-label = "Все_товары" + "_" + string( g-stat )
     6320   .
     6321     run ref/gds-refo.p ( input  p-open-query                         ,input  p-find-next                         ,input  p-find-condition                                                  ,input a-n-c                         ,input NameContext                         ,input rs-sort                         ,input g-cond                          ,input g-list                          ,input g-stat                          ,input g-grp                           ,input p-obj-type                         ,input p-obj-code                         ,buffer g-producer                         ,buffer cur-obj                            ,output for-title                                                  ,input filter-point                          ,input filter-point0                         ,input sort-column-name                         ,output v-filter-name                         ,input-output g-rep                         ).
     6322   assign
     6323   frame d-goo-doc-ref :title = for-title
     6324   .
     6325   if g-list = "ptrl"
     6326   or g-list = "lgas"
     6327   or g-list = "ptrlsug"
     6328   or g-list = "only-np"
     6329   then do:
     6330     assign
     6331     rs-list = 'все':U
     6332     rs-stat = 'текущие':U
     6333     rs-cond = 'все':U
     6334     .
     6335     DISPLAY
     6336     rs-list rs-cond rs-stat
     6337     WITH FRAME d-goo-doc-ref.
     6338     disable
     6339     rs-list rs-cond rs-stat
     6340     WITH FRAME d-goo-doc-ref.
     6341   end.
     6342   else do:
     6343     assign
     6344     rs-list = g-list
     6345     rs-stat = g-stat
     6346     rs-cond = g-cond
     6347     .
     6348     DISPLAY
     6349     rs-list rs-cond rs-stat
     6350     WITH FRAME d-goo-doc-ref.
     6351   end.
     6352   run set-filter-name in this-procedure (INPUT v-filter-name) no-error .
     6353   if g-rep <> ? then do:
     6354     reposition br-gds to recid g-rep no-error.
     6355     if error-status :error then do:
     6356       if p-repos-message and g-rep = v-chg-rec then do:
     6357         pos-rec = g-rep.
     6358         find first pos_goods no-lock where       recid( pos_goods ) = pos-rec no-error .   message     "Невозможно позиционироваться на товаре" skip      string( if available pos_goods              then  ( pos_goods.artic + chr(32) + pos_goods.prod-type + " ":U +              string( pos_goods.prod-code ) + " ":U + pos_goods.gds-name )              else "":U ) skip     "Товар был добавлен (или изменен или удален) -" skip     "и теперь не попадает в текущую выборку"   view-as alert-box WARNING.
     6359         v-chg-rec = ?.
     6360       end.
     6361       if num-results( "br-gds" ) <> 0 then do:
     6362         g#log = br-gds :select-row( 1 ) .
     6363         g#log = br-gds :scroll-to-selected-row( 1 ) .
     6364       end.
     6365     end.
     6366   end.
     6367   apply "entry":U to br-gds in frame d-goo-doc-ref.
     6368   if available goo-doc then do:
     6369     assign
     6370       g#log = br-gds :SELECT-PREV-ROW( )
     6371     .
     6372     if g#log = yes then do:
     6373       assign
     6374         g#log = br-gds :SELECT-NEXT-ROW( )
     6375       .
     6376     end.
     6377   end.
     6378   apply "value-changed":U to br-gds in frame d-goo-doc-ref.
     6379   if ( g-list = g-cond or ( g-cond = 'объект':U and g-list = 'все':U ) ) and rs-sort = 'Артикул':U then do:
     6380     assign
     6381       start = yes
     6382     .
     6383   end.
     6384   if start and not from-b-sch then do:
     6385     run UI-on in this-procedure.
     6386     if v-chg-rec <> ? then do:
     6387       reposition br-gds to recid v-chg-rec no-error.
     6388       if error-status :error then do:
     6389         if p-repos-message then do:
     6390           pos-rec = v-chg-rec.
     6391           find first pos_goods no-lock where       recid( pos_goods ) = pos-rec no-error .   message     "Невозможно позиционироваться на товаре" skip      string( if available pos_goods              then  ( pos_goods.artic + chr(32) + pos_goods.prod-type + " ":U +              string( pos_goods.prod-code ) + " ":U + pos_goods.gds-name )              else "":U ) skip     "Товар был добавлен (или изменен или удален) -" skip     "и теперь не попадает в текущую выборку"   view-as alert-box WARNING.
     6392         end.
     6393         if num-results( "br-gds" ) <> 0 then do:
     6394           assign
     6395           g#log = br-gds :select-row( 1 )
     6396           .
     6397           assign
     6398           g#log = br-gds :scroll-to-selected-row( 1 )
     6399           .
     6400         end.
     6401       end.
     6402       assign
     6403       v-chg-rec = ?
     6404       .
     6405     end.
     6406   end.
     6407   RUN buttons IN THIS-PROCEDURE.
     6408   assign
     6409   start = no
     6410   .
     6411   END PROCEDURE.
     6412   PROCEDURE full-sch :
     6413           assign
     6414             g-rep  = recid( l-goo-doc )
     6415             g-list = 'все':U
     6416             g-stat = 'все':U
     6417           .
     6418           RUN openbr IN THIS-PROCEDURE ( INPUT YES , input yes, input no, input '':U).
     6419   END PROCEDURE.
     6420   PROCEDURE buttons :
     6421     if lookup( "b-add", bttns ) > 0
     6422     AND ub.db.add-goods AND NOT transaction and lookup( "no-object":U, p-other, chr(4) ) = 0
     6423     then do:
     6424       enable
     6425       b-add
     6426       b-add-office
     6427       b-grp
     6428       b-del    b-copy b-chg
     6429       with frame d-goo-doc-ref.
     6430     end.
     6431     else do:
     6432       disable
     6433       b-add
     6434       b-add-office
     6435       b-grp
     6436       b-del
     6437       b-copy
     6438       b-chg
     6439       with frame d-goo-doc-ref.
     6440     end.
     6441     if not ub.db.add-goods
     6442     and v-cntxt-db-num = 0 then do:
     6443       enable
     6444       b-grp
     6445       with frame d-goo-doc-ref .
     6446     end.
     6447     if is-fbr = yes then do:
     6448       enable
     6449         b-recip
     6450       with frame d-goo-doc-ref.
     6451     end.
     6452     else do:
     6453       disable
     6454         b-recip
     6455       with frame d-goo-doc-ref.
     6456     end.
     6457     if is-fbr <> yes then do:
     6458       assign
     6459       menu-item m-dopinf-lfgds :sensitive in menu m-dopinf = no
     6460       menu-item m-dopinf-lscoef :sensitive in menu m-dopinf = no
     6461       menu-item m-dopinf-cfgds :sensitive in menu m-dopinf = no
     6462       menu-item m-dopinf-cscoef :sensitive in menu m-dopinf = no
     6463       .
     6464     end.
     6465   END PROCEDURE.
     6466   PROCEDURE controls :
     6467   ENABLE
     6468   b-exit b-arch b-price b-rest b-card b-chk b-lkp b-prt b-parts b-gdsreffi b-place b-dinamo b-sert b-hist add-inf
     6469   b-alt-bc
     6470   b-help
     6471   rs-list rs-cond rs-stat rs-sort a-n-c br-gds
     6472   b-sch
     6473   b-sel  WHEN LOOKUP( "b-sel",  bttns ) > 0
     6474   b-mark WHEN LOOKUP( "b-mark", bttns ) > 0
     6475   b-extart
     6476   WITH FRAME d-goo-doc-ref.
     6477   IF mImagePh THEN
     6478       ASSIGN
     6479           g-image:HIDDEN     = NO
     6480           g-image:VISIBLE    = YES
     6481           g-image:SENSITIVE  = YES
     6482           .
     6483   ELSE
     6484       ASSIGN
     6485           g-image:HIDDEN     = YES
     6486           g-image:VISIBLE    = NO
     6487           g-image:SENSITIVE  = NO
     6488           .
     6489   if lookup( "no-object":U, p-other, chr(4) ) > 0 then do:
     6490     if v-obj-name = "":U then do:
     6491       run proc-b-obj in this-procedure ( input "":U ).
     6492     end.
     6493     hide
     6494     b-add b-add-office
     6495     b-grp b-del b-copy b-chg
     6496     in frame d-goo-doc-ref .
     6497     display
     6498     b-obj
     6499     v-obj-type
     6500     v-obj-code
     6501     v-obj-name
     6502     with frame d-goo-doc-ref .
     6503     enable
     6504     b-obj
     6505     with frame d-goo-doc-ref .
     6506   end.
     6507   if a-n-c = "art" then do:
     6508     display
     6509     loc-art
     6510     with frame d-goo-doc-ref.
     6511   end.
     6512   else do:
     6513     hide loc-art loc-name loc-code NameContext in frame d-goo-doc-ref.
     6514   end.
     6515   CASE g-cond :
     6516     when 'все':U then do:
     6517       assign
     6518       rs-sort = 'Артикул':U
     6519       .
     6520       display
     6521       rs-sort
     6522       with frame d-goo-doc-ref .
     6523       disable
     6524       rs-sort
     6525       with frame d-goo-doc-ref .
     6526     end.
     6527     when 'объект':U then do:
     6528       assign
     6529       rs-sort = 'Артикул':U
     6530       .
     6531       enable
     6532       rs-sort
     6533       with frame d-goo-doc-ref .
     6534       assign
     6535       g#log = rs-sort :disable("Количество")
     6536       .
     6537       display
     6538       rs-sort
     6539       with frame d-goo-doc-ref .
     6540     end.
     6541     otherwise do:
     6542       enable
     6543       rs-sort
     6544       with frame d-goo-doc-ref .
     6545       assign
     6546       g#log = rs-sort :enable("Количество")
     6547       .
     6548       display
     6549       rs-sort
     6550       with frame d-goo-doc-ref .
     6551     end.
     6552   END CASE .
     6553   END PROCEDURE.
     6554   PROCEDURE enable_UI :
     6555   RUN buttons  IN THIS-PROCEDURE.
     6556   RUN controls IN THIS-PROCEDURE.
     6557   RUN openbr  IN THIS-PROCEDURE ( INPUT NO, input yes, input no, input '':U).
     6558   END PROCEDURE.
     6559   PROCEDURE UI-on :
     6560   DEFINE VARIABLE var-disable-sort AS LOGICAL NO-UNDO .
     6561   if from-b-sch then do:
     6562     RUN openbr IN THIS-PROCEDURE ( INPUT YES , input yes, input no, input '':U) .
     6563   end.
     6564   apply "entry":U             to br-gds in frame d-goo-doc-ref.
     6565   apply "value-changed":U to br-gds in frame d-goo-doc-ref.
     6566   END PROCEDURE.
     6567   PROCEDURE b-mark-proc:
     6568       if not available goo-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. assign   gds-rec = recid( goo-doc ) .
     6569       define variable v-num-entry as integer no-undo .
     6570       assign
     6571         v-num-entry = lookup( string( recid( goo-doc ) ), rid-list )
     6572       .
     6573       if v-num-entry > 0 then do:
     6574         assign
     6575           entry( v-num-entry, rid-list ) = "":U
     6576         .
     6577         assign
     6578           rid-list = trim( replace( rid-list, chr(44) + chr(44), chr(44) ), chr(44) )
     6579         .
     6580       end.
     6581       else do:
     6582         if num-entries( rid-list ) >= 4000 then do:
     6583           message "Превышено максимально допустимое количество выбранных товаров"
     6584                   "Воспользуйстесь добавлением товаров через список товаров, если это возможно"
     6585           view-as alert-box WARNING.
     6586           undo, return error.
     6587         end.
     6588         assign
     6589           rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + string( recid( goo-doc) )
     6590         .
     6591       end.
     6592       assign
     6593         g#log = br-gds :refresh( ) in frame d-goo-doc-ref
     6594       .
     6595       if num-entries( rid-list ) = 0 then do:
     6596           hide
     6597             mark-num in frame d-goo-doc-ref.
     6598       end.
     6599       else do:
     6600           display
     6601             num-entries( rid-list ) @ mark-num
     6602           with frame d-goo-doc-ref.
     6603       end.
     6604       if lookup( last-event :function, "MOUSE-SELECT-DBLCLICK,Return" ) = 0 then
     6605           do:
     6606               assign
     6607                 g#log = br-gds :select-next-row () in frame d-goo-doc-ref
     6608               .
     6609               apply "value-changed":U to br-gds in frame d-goo-doc-ref.
     6610           end.
     6611       apply "entry":U to br-gds in frame d-goo-doc-ref.
     6612   END PROCEDURE.
     6613   PROCEDURE b-del-proc:
     6614     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6615     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6616     define variable v-stts like ub.goods.stts no-undo .
     6617     define buffer loc_gds-obj for ub.gds-obj.
     6618       if not available loc-goo-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. assign   gds-rec = recid( loc-goo-doc ) .
     6619       assign
     6620         g#log = FALSE
     6621       .
     6622       CASE loc-goo-doc.gds-type :
     6623         when 'т':U then do:
     6624   define variable vss-include-info52 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6625   do:
     6626     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6627       (input  v-cntxt-db-num
     6628       ,input  v-cntxt-userid
     6629       ,input  0
     6630       ,input  'actn_reference_deletion':U
     6631       ,input  'object':U
     6632       ,input  0
     6633       ,input  '':U
     6634       ,input  0
     6635       ,input  0
     6636       ,input  loc-goo-doc.grp-code
     6637       ,input  0
     6638       ,input  true
     6639       ,output g#log
     6640       )  .
     6641   end.
     6642         end.
     6643         when 'у':U then do:
     6644   define variable vss-include-info53 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6645   do:
     6646     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6647       (input  v-cntxt-db-num
     6648       ,input  v-cntxt-userid
     6649       ,input  0
     6650       ,input  'actn_reference-services_deletion':U
     6651       ,input  'object':U
     6652       ,input  0
     6653       ,input  '':U
     6654       ,input  0
     6655       ,input  0
     6656       ,input  loc-goo-doc.grp-code
     6657       ,input  0
     6658       ,input  true
     6659       ,output g#log
     6660       )  .
     6661   end.
     6662         end.
     6663         otherwise do:
     6664           message
     6665             vss-workfile vss-revision vss-description skip
     6666             "Неизвестный тип товара" skip
     6667             "Тип товара" loc-goo-doc.gds-type skip
     6668             "Код товара" loc-goo-doc.gds-code skip
     6669             view-as alert-box error .
     6670           undo, return error return-value .
     6671         end.
     6672       END CASE.
     6673       if NOT g#log then do: return error . end.
     6674       v-stts = ?.
     6675       run ref/goods02.p (
     6676                      input gds-rec
     6677                     ,input no
     6678                     ,input-output v-stts) no-error.
     6679       if error-status:error then do:
     6680         apply "entry":U to br-gds in frame d-goo-doc-ref.
     6681         return error.
     6682       end.
     6683       assign
     6684       g-rep            = recid( loc-goo-doc )
     6685       v-chg-rec        = g-rep.
     6686   END PROCEDURE.
     6687   PROCEDURE local-find:
     6688     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6689     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6690     assign
     6691       vat-p = ?
     6692       SLT-p = ?
     6693     .
     6694     FIND FIRST loc-goo-doc NO-LOCK WHERE
     6695                loc-goo-doc.artic     = loc-gob-doc.artic     AND
     6696                loc-goo-doc.prod-code = loc-gob-doc.prod-code AND
     6697                loc-goo-doc.prod-type = loc-gob-doc.prod-type
     6698                                     USE-INDEX pi NO-ERROR.
     6699   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6700   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6701     (input  loc-goo-doc.gds-code
     6702     ,input  '1':U
     6703     ,input  ?
     6704     ,input  v-host-code
     6705     ,input  p-obj-type
     6706     ,input  p-obj-code
     6707     ,output vat-p
     6708     ) no-error .
     6709   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6710   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6711     (input  loc-goo-doc.gds-code
     6712     ,input  '2':U
     6713     ,input  ?
     6714     ,input  v-host-code
     6715     ,input  p-obj-type
     6716     ,input  p-obj-code
     6717     ,output slt-p
     6718     ) no-error .
     6719     assign
     6720       e-name = loc-goo-doc.engl-name
     6721       gds-n  = (if loc-goo-doc.stts = 0 then loc-goo-doc.gds-name else  (substring( loc-goo-doc.gds-name, 1, 15 ) + chr(32) + '<':U + CAPS(entry (lookup (string(loc-goo-doc.stts), '0,1,50,51':U), 'тек,удал,блок.для.смены.арт.,смена.арт.':U)) + '>':U  ))
     6722       gds-t  = ( if loc-goo-doc.gds-type = 'т':U then "-" else "+" )
     6723       unit-b = loc-goo-doc.unit-base
     6724       qnty-c = loc-goo-doc.qnty-cart
     6725     .
     6726   END PROCEDURE.
     6727   PROCEDURE b-chk-proc:
     6728     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6729     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6730     DEFINE VARIABLE rid-list    AS   CHARACTER          NO-UNDO .
     6731     DEFINE VARIABLE v-main-code LIKE ub.bar-code.b-code NO-UNDO .
     6732     DEFINE BUFFER buf_units FOR ub.units.
     6733     do
     6734     on error undo, return error
     6735     :
     6736       if not available loc-goo-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. assign   gds-rec = recid( loc-goo-doc ) .
     6737   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6738     (input  loc-goo-doc.gds-code
     6739     ,input  ?
     6740     ,output v-main-code
     6741     )  .
     6742       FIND FIRST ub.gds-prt NO-LOCK WHERE
     6743                  ub.gds-prt.upper-code = loc-goo-doc.prt-root.
     6744       find first buf_units No-LOCK WHERE
     6745                  buf_units.unit-name = loc-goo-doc.unit-base .
     6746       if ub.gds-prt.node-name = '_Пустая шкала':U
     6747       or not v-doc-prt = yes then do:
     6748         if lookup( 'сер':U, buf_units.type ) > 0 then do:
     6749           run ref/gds-chks.w (  INPUT parparentproc
     6750                          ,  INPUT RECID( loc-goo-doc )
     6751                          ,  INPUT "":U
     6752                          ,  INPUT 'объект':U
     6753                          ,  INPUT ?
     6754                          ,  INPUT p-obj-type
     6755                          ,  INPUT p-obj-code
     6756                          ,  INPUT "":U
     6757                          ,  INPUT "":U
     6758                          , OUTPUT rid-list
     6759                          ) .
     6760         end.
     6761         else do:
     6762           run ref/gds-chk.w (  INPUT parparentproc
     6763                         ,  INPUT v-main-code
     6764                         ,  INPUT "":U
     6765                         ,  INPUT 'объект':U
     6766                         ,  INPUT ?
     6767                         ,  INPUT p-obj-type
     6768                         ,  INPUT p-obj-code
     6769                         ,  INPUT "":U
     6770                         ,  INPUT "":U
     6771                         , OUTPUT rid-list
     6772                         ) .
     6773         end.
     6774       end.
     6775       else do:
     6776         message
     6777           "Товар делится на признаки - смотрите чеки через шкалу."
     6778         view-as alert-box.
     6779       end.
     6780       apply "entry":U to br-gds in frame d-goo-doc-ref.
     6781     end.
     6782   END PROCEDURE.
     6783   PROCEDURE proc-m-ostatki-1:
     6784     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6785     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6786       if not available loc-goo-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return error. end. assign   gds-rec = recid( loc-goo-doc ) .
     6787       FIND FIRST ub.gds-prt NO-LOCK WHERE
     6788                  ub.gds-prt.upper-code = loc-goo-doc.prt-root .
     6789       run rep/gds-objs.w (
     6790                        INPUT parparentproc,
     6791                        INPUT loc-goo-doc.artic,
     6792                        INPUT loc-goo-doc.prod-type,
     6793                        INPUT loc-goo-doc.prod-code,
     6794                        INPUT v-host-code,
     6795                        INPUT -1
     6796                      ).
     6797       apply "entry":U to br-gds in frame d-goo-doc-ref.
     6798   END PROCEDURE.
     6799   PROCEDURE proc-m-ostatki-2:
     6800     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6801     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6802     if not available loc-goo-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return error. end. assign   gds-rec = recid( loc-goo-doc ) .
     6803     run ref/cli-gdss.w
     6804                    (input parparentproc
     6805                    ,input 'Товар,Остатки':U
     6806                    ,input recid( loc-goo-doc )
     6807                    ,input ?
     6808                    )
     6809     .
     6810     apply "entry":U to br-gds in frame d-goo-doc-ref.
     6811   END PROCEDURE.
     6812   PROCEDURE proc-m-oborot-1:
     6813     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6814     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6815     if not available loc-goo-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return error. end. assign   gds-rec = recid( loc-goo-doc ) .
     6816     assign
     6817       g#log = no
     6818     .
     6819     message "Вывод отчета предполагает РАСЧЕТ АРХИВОВ по товарам" skip
     6820             "Продолжать?"
     6821     view-as alert-box QUESTION buttons YES-NO update g#log.
     6822     if g#log = yes then do:
     6823       run rep/e-good2.w ( input parParentProc,
     6824                       input loc-goo-doc.artic,
     6825                       input loc-goo-doc.prod-type,
     6826                       input loc-goo-doc.prod-code,
     6827                       input ?,
     6828                       input ?,
     6829                       input p-obj-type,
     6830                       input p-obj-code          ) no-error.
     6831     end.
     6832     apply "entry":U to br-gds in frame d-goo-doc-ref.
     6833   END PROCEDURE.
     6834   PROCEDURE proc-m-oborot-2:
     6835     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6836     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6837     if not available loc-goo-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return error. end. assign   gds-rec = recid( loc-goo-doc ) .
     6838     run ref/cli-gdss.w (
     6839                      input parparentproc
     6840                    , input 'Товар,Обороты':U
     6841                    , input recid( loc-goo-doc )
     6842                    , input ?
     6843                    ).
     6844     apply "entry":U to br-gds in frame d-goo-doc-ref.
     6845   END PROCEDURE.
     6846   PROCEDURE proc-b-sch:
     6847   run init-flt in this-procedure no-error.
     6848   if error-status :error then do:
     6849     return error.
     6850    end.
     6851   DO ON STOP UNDO, LEAVE :
     6852     run gbl/filter.w ( INPUT parparentproc
     6853                       ,INPUT (filter-point + chr(4) + filter-label)
     6854                       ,INPUT tbl
     6855                       ,INPUT join-tbl
     6856                       ,INPUT fld
     6857                       ,INPUT lab
     6858                       ,INPUT spr
     6859                       ,INPUT dim
     6860                       )
     6861                           .
     6862     ASSIGN
     6863     from-b-sch = YES
     6864     .
     6865     RUN UI-on IN THIS-PROCEDURE.
     6866     ASSIGN
     6867     from-b-sch = NO
     6868     .
     6869   END.
     6870   run buttons in this-procedure.
     6871   END PROCEDURE.
     6872   PROCEDURE proc-find:
     6873     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6874     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6875     define variable for-last-pcnt as decimal column-label "Торг.наценка" format "->>>,>>9.99%" no-undo.
     6876     assign
     6877       val-vat = ?
     6878       val-SLT = ?
     6879     .
     6880     FIND FIRST ub.recipe NO-LOCK WHERE
     6881                ub.recipe.prod-type = loc-goo-doc.prod-type
     6882            AND ub.recipe.prod-code = loc-goo-doc.prod-code
     6883            AND ub.recipe.artic     = loc-goo-doc.artic
     6884            NO-ERROR.
     6885       assign
     6886         mark-recipe = ( if available ub.recipe then ub.recipe.recipe-type else "":U )
     6887         mark        = ( if lookup( string( recid( loc-goo-doc ) ), rid-list ) > 0 then "*" else "":U )
     6888       .
     6889   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6890   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6891     (input  loc-goo-doc.gds-code
     6892     ,input  '1':U
     6893     ,input  ?
     6894     ,input  v-host-code
     6895     ,input  p-obj-type
     6896     ,input  p-obj-code
     6897     ,output val-vat
     6898     ) no-error .
     6899   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6900   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6901     (input  loc-goo-doc.gds-code
     6902     ,input  '2':U
     6903     ,input  ?
     6904     ,input  v-host-code
     6905     ,input  p-obj-type
     6906     ,input  p-obj-code
     6907     ,output val-slt
     6908     ) no-error .
     6909           FIND FIRST loc-gob-doc WHERE
     6910                      loc-gob-doc.obj-type  = p-obj-type            AND
     6911                      loc-gob-doc.obj-code  = p-obj-code            AND
     6912                      loc-gob-doc.prod-type = loc-goo-doc.prod-type AND
     6913                      loc-gob-doc.prod-code = loc-goo-doc.prod-code AND
     6914                      loc-gob-doc.artic     = loc-goo-doc.artic     NO-LOCK NO-ERROR.
     6915       if available loc-gob-doc then do:
     6916         assign
     6917           fact-q         = loc-gob-doc.fact-qnty
     6918           free-q         = loc-gob-doc.free-qnty
     6919           price          = loc-gob-doc.price-sale
     6920           for-cash-parts = loc-gob-doc.cash-parts
     6921           for-last-price = ( if v-lookup-cost then loc-gob-doc.last-base else ? )
     6922           for-last-pcnt  = ( if v-lookup-cost then ( price /
     6923                            ( if v-curr-r-b = 'base':U then loc-gob-doc.last-base else loc-gob-doc.last-rubl ) *
     6924                              100 - 100 )      else ? )
     6925         .
     6926         if abs( for-last-pcnt ) > 999999.99 then do:
     6927           assign
     6928             for-last-pcnt-str = "############":U
     6929           .
     6930         end.
     6931         else do:
     6932           assign
     6933             for-last-pcnt-str = string( for-last-pcnt, "->>>,>>9.99%":U )
     6934           .
     6935         end.
     6936         if v-is-ptrl = "yes" then do:
     6937           run get-petrol-weight-qty in this-procedure ( buffer loc-goo-doc,
     6938                                                         buffer loc-gob-doc,
     6939                                                         output free-q-cli,
     6940                                                         output fact-q-cli ) no-error.
     6941           if error-status :error then do: return error return-value. end.
     6942         end.
     6943       end.
     6944       else do:
     6945         assign
     6946           fact-q         = 0
     6947           free-q         = 0
     6948           price          = 0
     6949           for-cash-parts = no
     6950           for-last-price = 0
     6951           for-last-pcnt  = ?
     6952           free-q-cli    = 0.0
     6953           fact-q-cli    = 0.0
     6954           v-indicator-life-gds = ""
     6955           v-assort-min         = no
     6956         .
     6957       end.
     6958   END PROCEDURE.
     6959   PROCEDURE b-recip-proc:
     6960   DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6961   DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6962   if is-fbr then do:
     6963     if not available loc-goo-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. assign   gds-rec = recid( loc-goo-doc ) .
     6964     if loc-goo-doc.gds-type = 'у':U then do:
     6965       BELL.
     6966       return error.
     6967     end.
     6968     FIND FIRST ub.units NO-LOCK WHERE ub.units.unit-name = loc-goo-doc.unit-base .
     6969     if lookup( ub.units.type, 'сер':U ) > 0 then do:
     6970       message "Для серийного товара" skip
     6971               "рецепт задать нельзя !"
     6972       view-as alert-box INFORMATION .
     6973     end.
     6974     else do:
     6975       FIND FIRST ub.gds-prt NO-LOCK WHERE ub.gds-prt.upper-code = loc-goo-doc.prt-root .
     6976       if lookup( ub.gds-prt.node-name, '_Пустая шкала':U ) > 0 then do:
     6977         run ref/rcp-all.w (
     6978                         input parparentproc
     6979                       , input ( if loc-goo-doc.stts = 0
     6980                                     AND ub.db.add-goods
     6981                                     AND NOT transaction
     6982                                   then "b-add"
     6983                                   else "":U )
     6984                       , input 'все':U
     6985                       , input recid( loc-goo-doc )
     6986                       , input p-obj-type
     6987                       , input p-obj-code
     6988                       , output ref-list
     6989                       ) .
     6990         FIND FIRST ub.recipe NO-LOCK WHERE
     6991                     ub.recipe.prod-type = loc-goo-doc.prod-type
     6992                 AND ub.recipe.prod-code = loc-goo-doc.prod-code
     6993                 AND ub.recipe.artic     = loc-goo-doc.artic
     6994                 NO-ERROR.
     6995         assign
     6996           mark-recipe = ( if available ub.recipe then substring( ub.recipe.recipe-type, 1, 1 ) else " ":U )
     6997         .
     6998         DISPLAY
     6999           mark-recipe
     7000         WITH BROWSE br-gds.
     7001       end.
     7002       else do:
     7003         message "Рецепт можно определить" skip
     7004                 "только для товара БЕЗ ПРИЗНАКОВ."
     7005         view-as alert-box INFORMATION .
     7006       end.
     7007     end.
     7008     apply "entry":U to br-gds in frame d-goo-doc-ref.
     7009   end.
     7010   END PROCEDURE.
     7011   PROCEDURE proc-rs-list:
     7012     define variable i-rs-list like rs-list no-undo .
     7013     define variable ref-rec   as   recid   no-undo .
     7014       assign
     7015           i-rs-list = input frame d-goo-doc-ref rs-list
     7016       .
     7017       CASE i-rs-list :
     7018           when 'Производитель':U then do:
     7019             assign
     7020               ref-list = "":U
     7021             .
     7022             run ref/cli-all.w (
     7023                              input parparentproc
     7024                           ,  input "b-sel"
     7025                           ,  input 'про':U
     7026                           ,  input 'все':U
     7027                           ,  input 'текущие':U
     7028                           ,  input ?
     7029                           ,  input ",,,,,,NO,,,"
     7030                           ,  input ?
     7031                           , output ref-list
     7032                           ) .
     7033             if ref-list = "":U then do:
     7034               assign
     7035                 g-list = 'все':U
     7036               .
     7037               RUN enable_UI IN THIS-PROCEDURE.
     7038               return error.
     7039             end.
     7040             ref-rec = integer( ref-list ).
     7041             FIND FIRST g-producer NO-LOCK WHERE
     7042                 RECID( g-producer ) = ref-rec .
     7043             if available g-producer then do:
     7044               assign
     7045                 p-producer-type = g-producer.obj-type
     7046                 p-producer-code = g-producer.obj-code
     7047               .
     7048             end.
     7049           end.
     7050           when 'группа':U then do:
     7051             ASSIGN
     7052               g-grp = "":U
     7053             .
     7054             run ref/gds-grp.w ( input parparentproc
     7055                             ,INPUT "b-sel"
     7056                             , input p-obj-type
     7057                             , input p-obj-code
     7058                             , INPUT-OUTPUT g-grp ).
     7059             IF g-grp = "":U THEN DO:
     7060               ASSIGN
     7061                 g-list = 'все':U
     7062               .
     7063               RUN enable_UI IN THIS-PROCEDURE.
     7064               RETURN ERROR.
     7065             END.
     7066             FIND FIRST ub.gds-grp NO-LOCK WHERE
     7067                 RECID( ub.gds-grp ) = INTEGER( g-grp ) .
     7068             ASSIGN
     7069               g-grp = "":U
     7070             .
     7071             RUN grplib-get-full-name IN THIS-PROCEDURE ( INPUT gds-grp.node-code, OUTPUT g-grp ).
     7072           end.
     7073       END CASE .
     7074       assign
     7075         g-list = input frame d-goo-doc-ref rs-list
     7076         a-n-c :screen-value = "art"
     7077       .
     7078       apply "value-changed":U to a-n-c in frame d-goo-doc-ref .
     7079       RUN enable_UI IN THIS-PROCEDURE.
     7080   END PROCEDURE.
     7081   FUNCTION Get-good RETURNS CHARACTER
     7082     ( buffer loc-goods for goo-doc, buffer loc-gds-obj for gob-doc ) :
     7083     define variable for-last-pcnt as decimal column-label "Торг.наценка" format "->>>,>>9.99%" no-undo.
     7084     DEFINE VARIABLE vImageList AS CHARACTER  NO-UNDO.
     7085     DEFINE VARIABLE vCh        AS CHARACTER  NO-UNDO.
     7086     mphcol = NO.
     7087       gds-n  = (if loc-goods.stts = 0 then loc-goods.gds-name else  (substring( loc-goods.gds-name, 1, 15 ) + chr(32) + '<':U + CAPS(entry (lookup (string(loc-goods.stts), '0,1,50,51':U), 'тек,удал,блок.для.смены.арт.,смена.арт.':U)) + '>':U )).
     7088       FIND FIRST ub.recipe NO-LOCK WHERE
     7089                  ub.recipe.prod-type = loc-goods.prod-type
     7090              AND ub.recipe.prod-code = loc-goods.prod-code
     7091              AND ub.recipe.artic     = loc-goods.artic
     7092                  NO-ERROR.
     7093       assign
     7094         mark-recipe = ( if available ub.recipe then ub.recipe.recipe-type else "":U )
     7095         mark        = ( if lookup( string( recid( loc-goods ) ), rid-list ) > 0 then "*" else "":U )
     7096       .
     7097   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7098   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     7099     (input  loc-goods.gds-code
     7100     ,input  '1':U
     7101     ,input  ?
     7102     ,input  v-host-code
     7103     ,input  p-obj-type
     7104     ,input  p-obj-code
     7105     ,output vat-p
     7106     ) no-error .
     7107   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7108   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     7109     (input  loc-goods.gds-code
     7110     ,input  '2':U
     7111     ,input  ?
     7112     ,input  v-host-code
     7113     ,input  p-obj-type
     7114     ,input  p-obj-code
     7115     ,output slt-p
     7116     ) no-error .
     7117           FIND FIRST loc-gds-obj WHERE
     7118                      loc-gds-obj.obj-type  = p-obj-type          AND
     7119                      loc-gds-obj.obj-code  = p-obj-code          AND
     7120                      loc-gds-obj.prod-type = loc-goods.prod-type AND
     7121                      loc-gds-obj.prod-code = loc-goods.prod-code AND
     7122                      loc-gds-obj.artic     = loc-goods.artic     NO-LOCK NO-ERROR.
     7123       if available loc-gds-obj then do:
     7124         assign
     7125           fact-q         = loc-gds-obj.fact-qnty
     7126           free-q         = loc-gds-obj.free-qnty
     7127           price          = loc-gds-obj.price-sale
     7128           for-cash-parts = loc-gds-obj.cash-parts
     7129           for-last-price = ( if v-lookup-cost then loc-gds-obj.last-base  else ? )
     7130           for-last-pcnt  = ( if v-lookup-cost then ( price /
     7131                            ( if v-curr-r-b = 'base':U then loc-gds-obj.last-base else loc-gds-obj.last-rubl ) *
     7132                                                               100 - 100 ) else ? )
     7133         .
     7134         if abs(for-last-pcnt) > 999999.99 then do:
     7135           assign
     7136             for-last-pcnt-str = "############":U
     7137           .
     7138         end.
     7139         else do:
     7140           assign
     7141             for-last-pcnt-str = string( for-last-pcnt, "->>>,>>9.99%":U )
     7142           .
     7143         end.
     7144         if v-is-ptrl = "yes" then do:
     7145           run get-petrol-weight-qty in this-procedure ( buffer loc-goods,
     7146                                                         buffer loc-gds-obj,
     7147                                                         output free-q-cli,
     7148                                                         output fact-q-cli ) no-error.
     7149           if error-status :error then do: return error return-value. end.
     7150         end.
     7151       end.
     7152       else do:
     7153         assign
     7154           fact-q         = 0
     7155           free-q         = 0
     7156           price          = 0
     7157           for-cash-parts = no
     7158           for-last-price = 0
     7159           for-last-pcnt  = ?
     7160           fact-q-cli    = 0.0
     7161           free-q-cli    = 0.0
     7162           v-indicator-life-gds = ""
     7163           v-assort-min         = no
     7164         .
     7165       end.
     7166          IF mImagePh THEN
     7167         DO:
     7168           RUN gds-attr-value (loc-goods.gds-code, "image-list":U, OUTPUT vImageList, OUTPUT vCh).
     7169           mphcol = LENGTH (vImageList) > 0.
     7170         END.
     7171    RETURN mark.
     7172   END FUNCTION.
