     3541   procedure fltfield-clear :
     3542     define output parameter loc-fld as character no-undo.
     3543     define output parameter loc-lab as character no-undo .
     3544     define output parameter loc-spr as character no-undo .
     3545     define output parameter loc-dim as character no-undo .
     3546     assign
     3547       loc-fld = ""
     3548       loc-lab = ""
     3549       loc-spr = ""
     3550       loc-dim = "0"
     3551     .
     3552   end procedure .
     3553   procedure fltfield-add :
     3554     define input        parameter par-fld as character no-undo.
     3555     define input        parameter par-lab as character no-undo .
     3556     define input        parameter par-spr as character no-undo .
     3557     define input-output parameter loc-fld as character no-undo.
     3558     define input-output parameter loc-lab as character no-undo .
     3559     define input-output parameter loc-spr as character no-undo .
     3560     define input-output parameter loc-dim as character no-undo .
     3561     do
     3562     on error undo, return error
     3563     :
     3564       assign
     3565       loc-fld = if loc-dim = '0'
     3566                 then par-fld
     3567                 else (loc-fld + chr(44) + par-fld)
     3568       loc-lab = if loc-dim = '0'
     3569                 then par-lab
     3570                 else (loc-lab + chr(44) + par-lab)
     3571       loc-spr = if loc-dim = '0'
     3572                 then par-spr
     3573                 else (loc-spr + chr(44) + par-spr)
     3574       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     3575                 string(integer(if num-entries(loc-dim) > 1
     3576                               then entry(2, loc-dim)
     3577                               else entry(1, loc-dim)
     3578                               ) + 1)
     3579       no-error
     3580       .
     3581     end.
     3582   end procedure.
