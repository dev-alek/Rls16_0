     4350     end.
     4351     if available buf_bar-code then do:
     4352           find first l-goods where
     4353                     l-goods.gds-code =
     4354     buf_bar-code.gds-code No-LOCK.
     4355           find first l-goo-doc where
     4356                     l-goo-doc.artic = l-goods.artic AND
     4357                     l-goo-doc.prod-type = l-goods.prod-type AND
     4358                     l-goo-doc.prod-code = l-goods.prod-code no-lock no-error.
     4359       if available l-goo-doc then do:
     4360         line-rec = recid (l-goo-doc).
     4361         reposition br-gds to recid line-rec no-error.
     4362         if error-status:error then do:     run ref/gdsrepos.p (input 1,                    input g-cond,                    input g-list,                    input g-stat,                    input flt-rec,                    output g#log,                    output contin).     if g#log then do:       run full-sch.       return error.     end.   end.   apply "VALUE-changed" to br-gds in frame d-goo-doc-ref.
     4363         if b-mark:sensitive then apply "choose" to b-mark in frame d-goo-doc-ref.
     4364       end.
     4365       else do:
     4366         message "Строка не найдена."
     4367                 view-as alert-box error.
     4368       end.
     4369     end.
     4370     else
     4371       message "Бар-код не найден."
     4372               view-as alert-box error.
     4373     apply "entry" to loc-code in frame d-goo-doc-ref.
     4374   END PROCEDURE.
     4375   PROCEDURE  proc-mouse-dbl-click-loc-name:
     4376     if
     4377     frame d-goo-doc-ref
     4378     loc-name <> loc-name:screen-value OR
     4379        last-event:label = "Ctrl-J" then
     4380       contin = no.
     4381     assign
     4382     frame d-goo-doc-ref
     4383     loc-name.
     4384     REPEAT :
     4385   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4386     case g-list :
     4387       when 'все':U then do:
     4388   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4389     if last-event:label = "Ctrl-J" or contin then do:
     4390       find next l-goo-doc where true
     4391                                 and l-goo-doc.gds-name begins loc-name no-lock no-error.
     4392       if avail(l-goo-doc) then contin = no.
     4393     end.
     4394     else do:
     4395       find first l-goo-doc where true
     4396                                 and l-goo-doc.gds-name begins loc-name no-lock no-error.
     4397           contin = no.
     4398     end.
     4399       end.
     4400       when 'Производитель':U then do:
     4401   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4402     if last-event:label = "Ctrl-J" or contin then do:
     4403       find next l-goo-doc where l-goo-doc.prod-type = g-producer.obj-type                                and l-goo-doc.prod-code = g-producer.obj-code
     4404                                 and l-goo-doc.gds-name begins loc-name no-lock no-error.
     4405       if avail(l-goo-doc) then contin = no.
     4406     end.
     4407     else do:
     4408       find first l-goo-doc where l-goo-doc.prod-type = g-producer.obj-type                                and l-goo-doc.prod-code = g-producer.obj-code
     4409                                 and l-goo-doc.gds-name begins loc-name no-lock no-error.
     4410           contin = no.
     4411     end.
     4412       end.
     4413       when 'группа':U then do:
     4414   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4415     if last-event:label = "Ctrl-J" or contin then do:
     4416       find next l-goo-doc where l-goo-doc.grp-name begins g-grp
     4417                                 and l-goo-doc.gds-name begins loc-name no-lock no-error.
     4418       if avail(l-goo-doc) then contin = no.
     4419     end.
     4420     else do:
     4421       find first l-goo-doc where l-goo-doc.grp-name begins g-grp
     4422                                 and l-goo-doc.gds-name begins loc-name no-lock no-error.
     4423           contin = no.
     4424     end.
     4425       end.
     4426     end.
     4427       if available l-goo-doc then do:
     4428         line-rec = recid (l-goo-doc).
     4429         reposition br-gds to recid line-rec no-error.
     4430            if error-status:error then do:     run ref/gdsrepos.p (input 2,                    input g-cond,                    input g-list,                    input g-stat,                    input flt-rec,                    output g#log,                    output contin).     if not contin then do:       run full-sch.       return error.     end.     end.   apply "VALUE-changed" to br-gds in frame d-goo-doc-ref.
     4431       end.
     4432       else do:
     4433         message "Строка не найдена."
     4434                 view-as alert-box error.
     4435         contin = no.
     4436       end.
     4437       if not contin then
     4438         leave.
     4439       if contin = ? then
     4440         return error.
     4441     end.
     4442     apply "entry" to loc-name in frame d-goo-doc-ref.
     4443   END PROCEDURE.
     4444   PROCEDURE proc-mouse-dbl-click-namec:
