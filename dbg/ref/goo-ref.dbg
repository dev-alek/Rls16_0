     8401                    input loc-goo-doc.gds-code
     8402                    ,INPUT 'emrc-type':U
     8403                    ,INPUT v-value-emrc ) NO-ERROR.
     8404                 end.
     8405                    END.
     8406                 WHEN 2 THEN
