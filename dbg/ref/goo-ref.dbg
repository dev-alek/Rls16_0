     8409                    input loc-goo-doc.gds-code
     8410                    ,INPUT 'emrc-type':U
     8411                    ,INPUT v-attr-emrc ) .
     8412                    END.
     8413                 OTHERWISE DO:
     8414                 loc-goo-doc.grp-code = v-old-code .
     8415                 end.
     8416              END CASE.
     8417           end.
     8418        end.
     8419     END .
