     4969   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4970   on help of frame d-goo-doc-ref
     4971   do:
     4972     run gbl/app_help.p
     4973       (input this-procedure :file-name
     4974       ,input ''
     4975       ,input ?
     4976       ) no-error.
     4977     if error-status :error then do:
     4978       message
     4979         "Ошибка при вызове помощи"
     4980         error-status :get-message(1)
     4981         view-as alert-box .
     4982     end.
     4983   end.
     4984   run minbtn-set in this-procedure .
     4985   on choose of b-help in frame d-goo-doc-ref
     4986   do:
     4987     apply "help":u to frame d-goo-doc-ref .
     4988   end.
     4989   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4990   procedure minbtn-set :
     4991       do
     4992           on error undo, return error return-value
     4993           :
     4994           define variable ii              as integer       no-undo .
     4995           define variable fh              as widget-handle no-undo .
     4996           define variable hh              as widget-handle no-undo .
     4997           define variable v-h             as handle        extent 4 no-undo .
     4998           define variable v-name-button   as character     no-undo .
     4999           define variable v-help-old-x    as decimal       no-undo .
     5000           define variable v-help-old-y    as decimal       no-undo .
     5001           define variable v-help-old-size as decimal       no-undo .
     5002           define variable v-frame-width   as decimal       no-undo .
     5003           define variable jj              as integer       no-undo .
     5004           do
     5005               on error undo, return error
     5006               :
     5007               assign
     5008                   v-frame-width = frame d-goo-doc-ref:width - 0.3
     5009                   fh            = frame d-goo-doc-ref:first-child
     5010                   hh            = fh:first-child
     5011                   ii            = 1
     5012                   .
     5013               do while valid-handle(hh):
     5014                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5015                   do:
     5016                       case lc(hh:name) :
     5017                           when "b-help" then
     5018                               do:
     5019                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5020                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5021                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5022                                   hh:TOOLTIP = "Помощь" .
     5023                                   v-help-old-x = hh:column .
     5024                                   v-help-old-y = hh:row    .
     5025                                   v-help-old-size = hh:width .
     5026                                   hh:width-chars = 2.5 .
     5027                               end.
     5028                           when "b-print" then
     5029                               do:
     5030                                   hh:load-image("cmp/b-print.bmp":u) .
     5031                                   hh:TOOLTIP = "Печать" .
     5032                                   v-h[ii] = hh:handle .
     5033                                   ii = ii + 1 .
     5034                                   hh:width-chars = 3 .
     5035                               end.
     5036                           when "b-history" or
     5037                           when "b-hist" then
     5038                               do:
     5039                                   hh:load-image("cmp/b-hist.bmp":u) .
     5040                                   hh:TOOLTIP = "История" .
     5041                                   v-h[ii] = hh:handle .
     5042                                   ii = ii + 1 .
     5043                                   hh:width-chars = 3 .
     5044                               end.
     5045                           when "b-sch" then
     5046                               do:
     5047                                   hh:load-image("cmp/b-sch.bmp":u) .
     5048                                   hh:TOOLTIP = "Установка Фильтра" .
     5049                                   v-h[ii] = hh:handle .
     5050                                   ii = ii + 1 .
     5051                                   hh:width-chars = 3 .
     5052                               end.
     5053                           when "b-hist-user" then
     5054                               do:
     5055                                   hh:load-image("cmp/b-hist.bmp":u) .
     5056                                   hh:TOOLTIP = "История пользователя" .
     5057                                   ii = ii + 1 .
     5058                               end.
     5059                       end case.
     5060                   end.
     5061                   hh = hh:next-sibling.
     5062               end.
     5063               b-help:column = v-frame-width - b-help:width-chars.
     5064               jj = 0.
     5065               repeat ii = 4 to 1 by -1 :
     5066                   if valid-handle (v-h[ii] ) then
     5067                   do:
     5068                       jj  = jj + 1 .
     5069                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5070                       v-h[ii]:row    = v-help-old-y .
     5071                   end.
     5072               end.
     5073           end.
     5074       end.
     5075   end procedure.
     5076   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     5077   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     5078   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     5079   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     5080   define variable v-diasize-current-frame-width  as decimal   no-undo .
     5081   define variable v-diasize-current-frame-height as decimal   no-undo .
     5082   define variable v-diasize-change-size          as logical   no-undo .
     5083   define variable v-diasize-resize-button        as handle    no-undo .
     5084   define variable v-diasize-wndmax               as logical   no-undo .
     5085   define variable v-diasize-wndstore             as logical   no-undo .
     5086   define variable v-diasize-proc-name            as character no-undo .
     5087   define variable v-diasize-browse-handle        as handle    no-undo .
     5088   define variable v-diasize-browse-number        as integer   no-undo .
     5089   define variable v-diasize-need-full-display    as logical   no-undo init false .
     5090   define temp-table temp-diasize-handle no-undo
     5091     field handle-value  as handle
     5092     field save-position as decimal
     5093     index xpk is primary unique handle-value
     5094     .
     5095   define temp-table temp-browse-handle no-undo
     5096     field browse-type   as character
     5097     field browse-number as integer
     5098     field browse-handle as handle
     5099     field original-size as decimal
     5100     index xpk is primary unique browse-type browse-number
     5101     index xie browse-type browse-handle
     5102   .
     5103   procedure diasize_change-height :
     5104     define input  parameter p-change-value  as decimal   no-undo .
     5105     define input  parameter p-move-resize   as logical   no-undo .
     5106     define variable v-field-group-handle    as handle    no-undo .
     5107     define variable v-object-handle         as handle    no-undo .
     5108     define variable v-frame-height          as decimal   no-undo .
     5109     define variable v-frame-virtual-height  as decimal   no-undo .
     5110     define variable v-browse-height         as decimal   no-undo .
     5111     define variable v-window-height         as decimal   no-undo .
     5112     define variable v-window-virtual-height as decimal   no-undo .
     5113     define variable v-change-sign           as integer   no-undo .
     5114     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5115     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5116     if p-change-value > 0
     5117     then do:
     5118       if frame d-goo-doc-ref :height + p-change-value
     5119           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     5120       then do:
     5121         assign
     5122           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     5123                           - (frame d-goo-doc-ref :height-chars)
     5124         .
     5125         if p-change-value <= 0
     5126         then do:
     5127           run diasize_position-resize-button in this-procedure .
     5128           return .
     5129         end.
     5130       end.
     5131     end.
     5132     if p-change-value < 0
     5133     then do:
     5134       if frame d-goo-doc-ref :height + p-change-value < v-diasize-orig-frame-height
     5135       then do:
     5136         assign
     5137           p-change-value = v-diasize-orig-frame-height
     5138                          - (frame d-goo-doc-ref :height-chars)
     5139         .
     5140         if p-change-value >= 0
     5141         then do:
     5142           run diasize_position-resize-button in this-procedure .
     5143           return .
     5144         end.
     5145       end.
     5146     end.
     5147     if p-change-value >= 0
     5148     then do:
     5149       assign
     5150         v-change-sign = 1
     5151       .
     5152     end.
     5153     else do:
     5154       assign
     5155         v-change-sign = -1
     5156       .
     5157     end.
     5158     assign
     5159       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5160     .
     5161     if p-change-value = 0
     5162     then do:
     5163       run diasize_position-resize-button in this-procedure .
     5164       return .
     5165     end.
     5166     move_block:
     5167     do
     5168     on error undo move_block, retry move_block
     5169     :
     5170       if retry
     5171       then do:
     5172         do
     5173         on error undo move_block, leave move_block
     5174         :
     5175           if p-change-value > 0
     5176           then do:
     5177             for each buf_temp-diasize-handle
     5178             on error undo, next
     5179             :
     5180               assign
     5181                 v-object-handle = buf_temp-diasize-handle.handle-value
     5182               .
     5183               if v-object-handle <> v-diasize-resize-button
     5184               then do:
     5185                 assign
     5186                   v-object-handle :row = buf_temp-diasize-handle.save-position
     5187                 .
     5188               end.
     5189             end.
     5190             assign
     5191               v-diasize-browse-handle :height = v-browse-height
     5192             .
     5193             for each buf_temp-browse-handle
     5194               where buf_temp-browse-handle.browse-type = 'height':u
     5195             on error undo, next
     5196             :
     5197               assign
     5198                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     5199               .
     5200             end.
     5201             assign
     5202               frame d-goo-doc-ref :height = v-frame-height
     5203             .
     5204             if frame d-goo-doc-ref :scrollable = true
     5205             then do:
     5206               assign
     5207                 frame d-goo-doc-ref :virtual-height = v-frame-virtual-height
     5208               .
     5209             end.
     5210             run diasize_position-resize-button in this-procedure .
     5211           end.
     5212           else do:
     5213             if frame d-goo-doc-ref :scrollable = true
     5214             then do:
     5215               assign
     5216                 frame d-goo-doc-ref :virtual-height = v-frame-virtual-height
     5217               .
     5218             end.
     5219             assign
     5220               frame d-goo-doc-ref :height = v-frame-height
     5221             .
     5222             assign
     5223               v-diasize-browse-handle :height = v-browse-height
     5224             .
     5225             for each buf_temp-browse-handle
     5226               where buf_temp-browse-handle.browse-type = 'height':u
     5227             on error undo, next
     5228             :
     5229               assign
