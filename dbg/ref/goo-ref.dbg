     4167     return no-apply.
     4168   end.
     4169   ON return OF loc-code IN FRAME d-goo-doc-ref do:
     4170     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     4171     return no-apply.
     4172   end.
     4173   ON return, Ctrl-J OF loc-name IN FRAME d-goo-doc-ref do:
     4174     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     4175     return no-apply.
     4176   end.
     4177   ON return OF NameContext IN FRAME d-goo-doc-ref do:
