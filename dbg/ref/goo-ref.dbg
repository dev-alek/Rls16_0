     1786   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
     1787   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     1788   procedure uf-name :
     1789     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1790     define output parameter p-use-List_     as logical   no-undo .
     1791     define output parameter p-type-List_     as character no-undo .
     1792     define output parameter p-format-List_   as character no-undo .
     1793     define output parameter p-use-Naim      as logical   no-undo .
     1794     define output parameter p-type-Naim      as character no-undo .
     1795     define output parameter p-format-Naim    as character no-undo .
