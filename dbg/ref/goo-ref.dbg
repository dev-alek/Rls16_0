     8904   procedure proc-b-obj :
     8905     define input parameter p-mode as character no-undo .
     8906     define variable v-host-code   as integer   no-undo .
     8907     define variable v-user-select as logical   no-undo .
     8908     define variable v-obj-type    as character no-undo .
     8909     define variable v-obj-code    as integer   no-undo .
     8910     define buffer buf_clients  for ub.clients.
     8911     do
     8912     on error undo, return error
     8913     :
     8914       if p-mode = "change":U
     8915       then do:
     8916   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8917   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8918     (input  p-obj-type
     8919     ,input  p-obj-code
     8920     ,output v-host-code
     8921     )  .
     8922   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8923   run userobjs_select-one in this-procedure
     8924     (input  parparentproc
     8925     ,input  v-cntxt-db-num
     8926     ,input  v-cntxt-userid
     8927     ,input  v-cntxt-host-code-obj
     8928     ,input  v-cntxt-obj-type
     8929     ,input  v-cntxt-obj-code
     8930     ,output v-user-select
     8931     ,output v-obj-type
     8932     ,output v-obj-code
     8933     )  .
     8934         if v-user-select <> true
     8935         then do:
     8936           return .
     8937         end.
     8938       end.
     8939       else do:
     8940         assign
     8941           v-obj-type = p-obj-type
     8942           v-obj-code = p-obj-code
     8943         .
     8944       end.
     8945       find first buf_clients no-lock
     8946         where buf_clients.obj-type = v-obj-type
     8947           and buf_clients.obj-code = v-obj-code
     8948         no-error .
     8949       if not available buf_clients
     8950       then do:
     8951         undo, return error.
     8952       end.
     8953       assign
     8954         p-obj-type = buf_clients.obj-type
     8955         p-obj-code = buf_clients.obj-code
     8956         v-obj-type = buf_clients.obj-type
     8957         v-obj-code = buf_clients.obj-code
     8958         v-obj-name = buf_clients.obj-name
     8959       .
     8960       run main-block-proc in this-procedure .
     8961     end.
     8962   end procedure.
     8963   procedure get-petrol-weight-qty :
     8964     define        parameter buffer loc-goo-doc   for ub.goods.
     8965     define        parameter buffer loc-gob-doc   for ub.gds-obj.
     8966     define output parameter        p-free-q-cli as  decimal no-undo initial 0.0.
     8967     define output parameter        p-fact-q-cli as  decimal no-undo initial 0.0.
     8968     define variable is-petrol as logical no-undo.
     8969     define variable is-pieces as logical no-undo.
     8970     define buffer buf_pl-gds for ub.pl-gds .
     8971     do on error undo, return error return-value :
     8972       if available loc-goo-doc then do:
     8973         assign
     8974           p-free-q-cli = 0.0
     8975           p-fact-q-cli = 0.0
     8976         .
     8977         if v-is-ptrl = "yes" then do:
     8978   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     8979     (
     8980        input loc-goo-doc.artic
     8981     ,  input loc-goo-doc.prod-type
     8982     ,  input loc-goo-doc.prod-code
     8983     , output is-petrol
     8984     , output is-pieces
     8985     ) no-error.
     8986           if error-status :error then do:
     8987             return error return-value.
     8988           end.
     8989           if is-petrol = true
     8990             and is-pieces = false
     8991           then do:
     8992             for each buf_pl-gds no-lock
     8993               where buf_pl-gds.gds-code = loc-goo-doc.gds-code
     8994                 and buf_pl-gds.obj-type = p-obj-type
     8995                 and buf_pl-gds.obj-code = p-obj-code
     8996             on error undo, return error return-value
     8997             :
     8998               assign
     8999                 p-fact-q-cli = p-fact-q-cli + buf_pl-gds.cli-fact-qnty
     9000                 p-free-q-cli = p-free-q-cli + buf_pl-gds.cli-free-qnty
     9001               .
     9002             end.
     9003           end.
     9004         end.
     9005       end.
     9006     end.
     9007   end procedure.
     9008   procedure assort-polit :
     9009   do
     9010   on error undo, return error return-value
     9011   :
     9012   define input  parameter p-gds-code as integer   no-undo .
     9013   define input  parameter p-obj-type as character no-undo .
     9014   define input  parameter p-obj-code as integer   no-undo .
     9015   define output parameter p-indicator-life-gds like  ub.gds-obj-prop.gdop-igt                     no-undo .
     9016   define output parameter p-assort-min         like  ub.gds-obj-prop.gdop-assort-min format "*/ " no-undo .
     9017    define variable p-gdop-min-stock              as decimal   no-undo .
     9018    define variable p-grop-max-stock              as decimal   no-undo .
     9019    define variable p-grop-level-always-presence  as decimal   no-undo .
     9020    define variable p-grop-min-order              as decimal   no-undo .
     9021   if p-gds-code = 0 or p-gds-code = ? then message 444.
     9022   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9023   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     9024     (input  p-obj-type
     9025     ,input  p-obj-code
     9026     ,input  ?
     9027     ,input  ?
     9028     ,input  ?
     9029     ,input  p-gds-code
     9030     ,output p-assort-min
     9031     ,output p-indicator-life-gds
     9032     ,output p-gdop-min-stock
     9033     ,output p-grop-max-stock
     9034     ,output p-grop-level-always-presence
     9035     ,output p-grop-min-order
     9036     )  .
     9037   end.
     9038   end procedure.
     9039   PROCEDURE reposition-goods :
     9040   define input  parameter p-direction   as character no-undo .
     9041   define output parameter p-recid as recid no-undo .
     9042     case p-direction :
     9043       when "first":U
     9044       then do:
     9045         get first br-gds.
     9046       end.
     9047       when "last":U
     9048       then do:
     9049         get last br-gds.
     9050       end.
     9051       when "prev":U
     9052       then do:
     9053         get prev br-gds.
     9054         if not available goo-doc then do:
     9055           message
     9056           "Это первый товар списка"
     9057           view-as alert-box.
     9058         end.
     9059       end.
     9060       when "next":U
     9061       then do:
     9062         get next br-gds.
     9063         if not available goo-doc then do:
     9064           message
     9065           "Это последний товар списка"
     9066           view-as alert-box.
     9067         end.
     9068       end.
     9069     end case .
     9070     run reposition-query in this-procedure
     9071       (input recid(goo-doc)
     9072       ).
     9073     assign
     9074     p-recid = recid(goo-doc)
     9075     .
     9076   END PROCEDURE.
     9077   PROCEDURE reposition-query :
     9078   define input parameter p-recid as recid no-undo .
     9079   if p-recid <> ?
     9080   then do:
     9081     reposition br-gds to recid p-recid no-error.
     9082   end.
     9083   do with frame d-goo-doc-ref:
     9084     apply "entry":u to browse br-gds .
     9085     apply "VALUE-CHANGED":u to browse br-gds .
     9086   end.
     9087   END PROCEDURE.
     9088   procedure recalc-assgds :
     9089   define input  parameter p-gds-code as integer   no-undo .
     9090   define input  parameter p-old-grp as integer   no-undo .
     9091   define input  parameter p-new-grp as integer   no-undo .
     9092   define output parameter p-ok      as logical    no-undo .
     9093   define buffer buf_assortment-matrix       for ub.assortment-matrix  .
     9094   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
     9095     do
     9096     on error undo, return error return-value
     9097     :
     9098     find first buf_assortment-matrix-goods no-lock where
     9099                  buf_assortment-matrix-goods.gds-code =  p-gds-code and
     9100                  buf_assortment-matrix-goods.obj-type <> "" and
     9101                  buf_assortment-matrix-goods.asmg-status =  0 no-error.
     9102     if not AVAILABLE buf_assortment-matrix-goods then do: p-ok = yes .
     9103     end.
     9104     else do:
     9105     for each buf_assortment-matrix-goods no-lock where
     9106              buf_assortment-matrix-goods.gds-code =  p-gds-code and
     9107              buf_assortment-matrix-goods.obj-type <> "" and
     9108              buf_assortment-matrix-goods.asmg-status =  0 ,
     9109         first buf_assortment-matrix no-lock where
     9110               buf_assortment-matrix.asmt-status =  0 and
     9111               buf_assortment-matrix.obj-type <> "" and
     9112               buf_assortment-matrix.asmt-id = buf_assortment-matrix-goods.asmt-id  and
     9113               buf_assortment-matrix.db-num  = buf_assortment-matrix-goods.db-num
     9114              :
     9115          run utl/uassmgrp.p ( p-old-grp, p-new-grp, buf_assortment-matrix.asmt-id , buf_assortment-matrix.db-num, output p-ok ) no-error.
     9116     end.
     9117     end.
     9118     end.
     9119   end procedure.
