     2189   FUNCTION gdsreffi_last-pcnt returns decimal ( buffer buf_goods for ub.goods
     2190                                             ,input p-obj-type as character
     2191                                             ,input p-obj-code as integer):
     2192   define buffer buf_gds-obj for ub.gds-obj.
     2193   define variable v-value as decimal no-undo .
     2194   find first buf_gds-obj no-lock where
     2195               buf_gds-obj.gds-code = buf_goods.gds-code
     2196         AND  buf_gds-obj.obj-type = p-obj-type
     2197         AND  buf_gds-obj.obj-code = p-obj-code no-error .
     2198   if available buf_gds-obj then do:
     2199     assign
     2200     v-value =
     2201               (buf_gds-obj.price-sale / (if v-curr-r-b = 'base':U
     2202                                         then buf_gds-obj.last-base
     2203                                         else buf_gds-obj.last-rubl)
     2204                 * 100 - 100)
     2205     no-error
     2206     .
     2207   end.
     2208   else do:
     2209     v-value = ?  .
     2210   end.
     2211   return v-value.
     2212   end FUNCTION.
     2213   FUNCTION gdsreffi_in-doc-cli-name returns character ( buffer buf_goods for ub.goods
     2214                                             ,input p-obj-type as character
     2215                                             ,input p-obj-code as integer):
     2216   define buffer buf_gds-obj for ub.gds-obj.
     2217   define buffer buf_trn-doc for ub.trn-doc.
     2218   define buffer buf_clients for ub.clients.
     2219   define buffer buf_parts for ub.parts.
     2220   define variable v-value as decimal no-undo .
     2221   for first buf_gds-obj no-lock where
     2222               buf_gds-obj.gds-code = buf_goods.gds-code
     2223         AND  buf_gds-obj.obj-type = p-obj-type
     2224         AND  buf_gds-obj.obj-code = p-obj-code ,
     2225             first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_gds-obj.in-code,
     2226             first buf_clients no-lock where buf_clients.obj-type = buf_trn-doc.cli-type and  buf_clients.obj-code = buf_trn-doc.cli-code:
     2227           return buf_clients.obj-name .
     2228   end.
     2229   for first buf_parts no-lock where
     2230              buf_parts.artic = buf_goods.artic
     2231         and  buf_parts.prod-type = buf_goods.prod-type
     2232         and  buf_parts.prod-code = buf_goods.prod-code
     2233         AND  buf_parts.obj-type = p-obj-type
     2234         AND  buf_parts.obj-code = p-obj-code
     2235         and  buf_parts.out-code = 'free-zone':U ,
     2236             first buf_clients no-lock where buf_clients.obj-type = buf_parts.supp-type and  buf_clients.obj-code = buf_parts.supp-code:
     2237           return buf_clients.obj-name .
     2238   end.
     2239   end FUNCTION.
     2240   PROCEDURE gds-ref-fi:
     2241   DEFINE PARAMETER BUFFER fi-goods for ub.goods.
     2242   DEFINE PARAMETER BUFFER fi-gds-obj for ub.gds-obj.
     2243   DEFINE INPUT PARAMETER v-obj-type like ub.clients.obj-type.
     2244   DEFINE INPUT PARAMETER v-obj-code like ub.clients.obj-code.
     2245   DEFINE INPUT PARAMETER v-gds-ref-fi as char no-undo.
     2246   define input parameter p-excel as logical no-undo .
     2247   DEFINE INPUT-OUTPUT PARAMETER fi-1 as char no-undo.
     2248   DEFINE INPUT-OUTPUT PARAMETER fi-2 as char no-undo.
     2249   DEFINE INPUT-OUTPUT PARAMETER fi-3 as char no-undo.
     2250   DEFINE INPUT-OUTPUT PARAMETER fi-4 as char no-undo.
     2251   DEFINE INPUT-OUTPUT PARAMETER fi-5 as char no-undo.
     2252   DEFINE INPUT-OUTPUT PARAMETER fi-6 as char no-undo.
     2253   DEFINE INPUT-OUTPUT PARAMETER fi-7 as char no-undo.
     2254   DEFINE INPUT-OUTPUT PARAMETER fi-8 as char no-undo.
     2255   DEFINE VARiable II AS INTEGER NO-UNDO.
     2256   DEFINE BUFFER fi-gds-prt for ub.gds-prt.
     2257   define buffer fi-condition-keeping for ub.condition-keeping .
     2258   DEFINE variable myfi as char no-undo extent 8.
     2259   DEFINE VARiable jj as integer no-undo init 1.
     2260   DEFINE variable Myformat as character no-undo.
     2261   DEFINE VARiable vNum-entries as integer no-undo.
     2262   DEFINE VARiable entry-ii as character no-undo.
     2263   DEFINE VARiable vvalue as character no-undo.
     2264   DEFINE VARiable vtype as character no-undo.
     2265   DEFINE VARiable vlabel as character no-undo.
     2266   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     2267     IF v-gds-ref-fi = "" then
     2268     v-gds-ref-fi = 'goods.gds-name,goods.#prod-name,goods.#prt-root-name,goods.negative-rest,gds-obj.#VAT-PC,goods.ALPHA1,gds-obj.in-date':U.
     2269    if avail fi-goods then do:
     2270         FIND FIRST fi-gds-obj NO-LOCK where
     2271                    fi-gds-obj.gds-code = fi-goods.gds-code AND
     2272                    fi-gds-obj.obj-type = p-obj-type AND
     2273                    fi-gds-obj.obj-code = p-obj-code NO-ERROR.
     2274   vNum-entries = NUm-ENTRIES(v-gds-ref-fi).
     2275     DO ii = 1 to vNum-entries:
     2276       entry-ii = ENTRY(ii, v-gds-ref-fi).
     2277       find first buf_usr-flt_custom-labels where
     2278                 buf_usr-flt_custom-labels.tbl-name = entry(1, entry-ii, ".")
     2279            and  buf_usr-flt_custom-labels.fld-name = entry(2, entry-ii, ".")
     2280            and  buf_usr-flt_custom-labels.call-point =  'gdsreffi':U
     2281            and  buf_usr-flt_custom-labels.call-type = 'add-fields':U no-error.
     2282       if  available buf_usr-flt_custom-labels then do:
     2283         case buf_usr-flt_custom-labels.tbl-name:
     2284           when 'goods':U then do:
     2285             if entry(2, entry-ii, ".") begins "#" then do:
     2286               assign
     2287               myfi[jj] =
     2288               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2289                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func, buffer fi-goods)
     2290                                 , buf_usr-flt_custom-labels.custom-format) no-error .
     2291             end.
     2292             else do:
     2293               myfi[jj] =
     2294               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2295                           string(buffer fi-goods:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2296             end.
     2297           end.
     2298           when 'gds-obj':U then do:
     2299             if entry(2, entry-ii, ".") begins "#" then do:
     2300               assign
     2301               myfi[jj] =
     2302               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2303                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func
     2304                                         ,buffer fi-goods
     2305                                         ,input v-obj-type
     2306                                         ,input v-obj-code
     2307                                         )
     2308                          , buf_usr-flt_custom-labels.custom-format) no-error .
     2309             end.
     2310             else do:
     2311               if available fi-gds-obj then do:
     2312                 myfi[jj] =
     2313                             buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2314                             string(buffer fi-gds-obj:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2315               end.
     2316               else do:
     2317                 myfi[jj] =
     2318                 buf_usr-flt_custom-labels.custom-label +
     2319                 ""
     2320                 .
     2321               end.
     2322             end.
     2323           end.
     2324           when 'goods-attr':U then do:
     2325             if entry(2, entry-ii, ".") begins "#" then do:
     2326             end.
     2327             else do:
     2328               vvalue = "[!!Ошибка]".
     2329               run gds-attr-value in this-procedure ( fi-goods.gds-code
     2330                                                     ,input entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2331                                                     ,output vvalue
     2332                                                     ,output vtype) no-error.
     2333               myfi[jj] =
     2334               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2335                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2336             end.
     2337           end.
     2338           when 'gds-obj-attr':U then do:
     2339             if entry(2, entry-ii, ".") begins "#" then do:
     2340             end.
     2341             else do:
     2342               vvalue = "[!!Ошибка]".
     2343               run gdsoattr-value in this-procedure (
     2344                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2345                                                    ,input  fi-goods.gds-code
     2346                                                    ,input v-obj-type
     2347                                                    ,input v-obj-code
     2348                                                    ,output vvalue
     2349                                                    ,output vtype
     2350                                                    ) no-error .
     2351               myfi[jj] =
     2352               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2353                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2354             end.
     2355           end.
     2356           when 'gds-host-attr':U then do:
     2357             if entry(2, entry-ii, ".") begins "#" then do:
     2358             end.
     2359             else do:
     2360               vvalue = "[!!Ошибка]".
     2361               run gdshattr-value in this-procedure (
     2362                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2363                                                    ,input  fi-goods.gds-code
     2364                                                    ,input v-obj-type
     2365                                                    ,input v-obj-code
     2366                                                    ,output vvalue
     2367                                                    ,output vtype
     2368                                                    ) no-error .
     2369               myfi[jj] =
     2370               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2371                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2372             end.
     2373           end.
     2374         end case.
     2375         if p-excel then do:
     2376           if buf_usr-flt_custom-labels.fld-data-type = 'decimal':U
     2377           or buf_usr-flt_custom-labels.fld-data-type = 'integer':U
     2378           then do:
     2379             myfi[jj] = replace(myfi[jj], chr(44), "").
     2380           end.
     2381         end.
     2382         jj = jj + 1.
     2383         if jj = 9 then LEAVE.
     2384       end.
     2385         else if entry(1, entry-ii, ".") = 'goods-attr':U then  do:
     2386           vvalue = "[!!Ошибка]".
     2387                   run gds-attr-value in this-procedure ( fi-goods.gds-code
     2388                                                         ,input (SUBSTRING (entry-ii,INDEX(entry-ii,"_") + 1))
     2389                                                         ,output vvalue
     2390                                                         ,output vtype) no-error.
     2391                   myfi[jj] = vvalue.
     2392         end.
     2393     END.
     2394     end.
     2395     assign
     2396     fi-1 = myfi[1]
     2397     fi-2 = myfi[2]
     2398     fi-3 = myfi[3]
     2399     fi-4 = myfi[4]
     2400     fi-5 = myfi[5]
     2401     fi-6 = myfi[6]
     2402     fi-7 = myfi[7]
     2403     fi-8 = myfi[8]
     2404     .
     2405   END PROCEDURE.
     2406   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2407   PROCEDURE gds-ref-to:
     2408   DEFINE INPUT PARAMETER v-gds-ref-fi as char no-undo.
     2409   DEFINE INPUT-OUTPUT PARAMETER to-1 as char no-undo.
     2410   DEFINE INPUT-OUTPUT PARAMETER to-2 as char no-undo.
     2411   DEFINE INPUT-OUTPUT PARAMETER to-3 as char no-undo.
     2412   DEFINE INPUT-OUTPUT PARAMETER to-4 as char no-undo.
     2413   DEFINE INPUT-OUTPUT PARAMETER to-5 as char no-undo.
     2414   DEFINE INPUT-OUTPUT PARAMETER to-6 as char no-undo.
     2415   DEFINE INPUT-OUTPUT PARAMETER to-7 as char no-undo.
     2416   DEFINE INPUT-OUTPUT PARAMETER to-8 as char no-undo.
     2417   DEFINE VARiable II AS INTEGER NO-UNDO.
     2418   DEFINE variable myto as char no-undo extent 8.
     2419   DEFINE variable mypr as char no-undo extent 8.
     2420   DEFINE VARiable jj as integer no-undo init 1.
     2421   DEFINE VARiable vNum-entries as integer no-undo.
     2422   DEFINE VARiable entry-ii as char no-undo.
     2423   define buffer buf_custom-labels for ub.custom-labels.
     2424   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     2425   IF v-gds-ref-fi = "" then
     2426   v-gds-ref-fi = 'goods.gds-name,goods.#prod-name,goods.#prt-root-name,goods.negative-rest,gds-obj.#VAT-PC,goods.ALPHA1,gds-obj.in-date':U.
     2427   vNum-entries = NUm-ENTRIES(v-gds-ref-fi).
     2428   for each usr-flt_custom-labels:
     2429     delete usr-flt_custom-labels.
     2430   end.
     2431   DO ii = 1 to vNum-entries:
     2432      entry-ii = ENTRY(ii, v-gds-ref-fi).
     2433     find first buf_custom-labels no-lock where
     2434             buf_custom-labels.tbl-name = entry(1, entry-ii, ".":U)
     2435         and buf_custom-labels.fld-name = entry(2, entry-ii, ".":U)
     2436         and buf_custom-labels.call-point = 'gdsreffi':U
     2437         and buf_custom-labels.call-type = 'add-fields':U
     2438         no-error.
     2439      if available buf_custom-labels then do:
     2440        create buf_usr-flt_custom-labels.
     2441        buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     2442         assign
     2443         myto[jj] =  buf_custom-labels.custom-tooltip
     2444         .
     2445      end.
     2446      else do:
     2447       message "Для пользователя " v-cntxt-userid skip "настройки доп.поле справочника товаров содержат неопознанный элемент " ENTRY-ii skip "Обратитесь к администратору системы" skip error-status:get-message(1) skip return-value skip view-as alert-box ERROR.
     2448      END.
     2449      jj = jj + 1.
     2450      if jj = 9 then LEAVE.
     2451   END.
     2452   assign
     2453   to-1 = myto[1]
     2454   to-2 = myto[2]
     2455   to-3 = myto[3]
     2456   to-4 = myto[4]
     2457   to-5 = myto[5]
     2458   to-6 = myto[6]
     2459   to-7 = myto[7]
     2460   to-8 = myto[8]
     2461   .
     2462   END PROCEDURE.
     2463   PROCEDURE gds-ref-to-description:
     2464   define variable v-ok  as logical no-undo .
     2465     run ref/cstmlabs.w ( input parparentproc
     2466                        ,input 'add-fields':U
     2467                        ,input 'gdsreffi':U
     2468                        ,input no
     2469                        ,input 8
     2470                        ,output v-ok
     2471                        ) no-error.
     2472   if v-ok then do:
     2473     message
     2474     "Изменения вступят в силу при следующем входе в справочник товаров"
     2475     view-as alert-box warning.
     2476   end.
     2477   END PROCEDURE.
     2478   define new global shared variable g#libbcrcn as handle no-undo .
     2479   define new global shared variable g#lib-trn  as handle no-undo .
     2480   define new global shared variable g#lib-trn2 as handle no-undo .
     2481   define new global shared variable g#lib-trn3 as handle no-undo .
     2482   define new global shared variable g#lib-trn4 as handle no-undo .
     2483   define variable vss-include-info16 as character format "X(65)" no-undo
     2484   initial "@(#)$Workfile$ $Revision$".
     2485   procedure grplib-get-full-name :
     2486      define input parameter p-node-code  as integer      no-undo.
     2487      define output parameter p-full-name as character    no-undo.
     2488      do
     2489   on error undo, return error
     2490   :
     2491       define variable v-upper-code    as integer           no-undo.
     2492       define buffer buf_gds-grp       for ub.gds-grp.
     2493       define buffer buf_upper_gds-grp for ub.gds-grp.
     2494       find first buf_gds-grp no-lock
     2495            where buf_gds-grp.node-code = p-node-code
     2496       no-error.
     2497       if not available buf_gds-grp
     2498       then do:
     2499           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2500       end.
     2501       assign
     2502           p-full-name  = ""
     2503           v-upper-code = 1
     2504       .
     2505       do while buf_gds-grp.upper-code <> 0
     2506       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2507       :
     2508           assign
     2509               p-full-name  = buf_gds-grp.node-name
     2510                            + (if p-full-name <> "" then chr(47) else "")
     2511                            + p-full-name
     2512               v-upper-code = buf_gds-grp.upper-code
     2513           .
     2514           find first buf_gds-grp no-lock
     2515                where buf_gds-grp.node-code = v-upper-code
     2516           no-error.
     2517           if not available buf_gds-grp
     2518           then do:
     2519               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2520                                   + string( v-upper-code )
     2521                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2522           end.
     2523       end.
     2524       assign
     2525       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2526       .
     2527   end.
     2528   end .
     2529   procedure grplib-get-node-from-full-name :
     2530   define input parameter p-full-name as character no-undo .
     2531   define output parameter p-node-code as integer no-undo .
     2532   define variable v-ii as integer no-undo .
     2533   define variable v-upper-code as integer no-undo .
     2534   define variable v-root-code as integer no-undo .
     2535   define variable v-entry as character no-undo .
     2536   define buffer buf_gds-grp       for ub.gds-grp.
     2537   do
     2538   on error undo, return error
     2539   :
     2540     find first buf_gds-grp no-lock
     2541         where buf_gds-grp.upper-code = 0
     2542     no-error .
     2543     if not available buf_gds-grp
     2544     then do:
     2545         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2546     end.
     2547     else do:
     2548       assign
     2549       v-root-code = buf_gds-grp.node-code
     2550       .
     2551     end.
     2552     v-upper-code = v-root-code.
     2553     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2554       assign
     2555       v-entry = entry(v-ii, p-full-name, chr(47)).
     2556       if v-entry = '' then leave.
     2557       find first buf_gds-grp no-lock where
     2558                 buf_gds-grp.node-name = v-entry
     2559             and buf_gds-grp.upper-code = v-upper-code
     2560             no-error.
     2561       if not available buf_gds-grp then do:
     2562         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2563       end.
     2564       else do:
     2565         p-node-code = buf_gds-grp.node-code.
     2566         v-upper-code = buf_gds-grp.node-code.
     2567       end.
     2568     end.
     2569   end.
     2570   end .
     2571   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2572   define variable v-waitfram-action01         as character   no-undo .
     2573   define variable v-waitfram-action02         as character   no-undo .
     2574   define variable v-waitfram-action03         as character   no-undo .
     2575   define variable mWaitFramTextBeg            as character   no-undo.
     2576   define variable mWaitFramTextEnd            as character   no-undo.
     2577   define variable mWaitFramView               as logical     no-undo.
     2578   define variable mWaitProcEvent              as logical     no-undo init yes.
     2579   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2580   define variable mWaitFramStop               as logical     no-undo.
     2581   define variable mWaitFramStopUser           as logical     no-undo.
     2582   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2583   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2584   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2585   define button B-WaitFramStop auto-end-key
     2586        label "Стоп"
     2587        size 10 by 1 tooltip "Остоновить процесс".
     2588   define button B-viewProcInfo
     2589        label "Информация"
     2590        size 15 by 1 tooltip "Информация о процесс".
     2591   define frame waitfram
     2592     v-waitfram-action01 format "x(72)" no-label skip
     2593     v-waitfram-action02 format "x(72)" no-label skip
     2594     v-waitfram-action03 format "x(72)" no-label skip
     2595     B-viewProcInfo
     2596     B-WaitFramStop at row 4 col 30
     2597     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2598     .
     2599   define new global shared variable mBatchMode as logical no-undo init ?.
     2600   define variable mFramBachModHandle as handle no-undo.
     2601   mFramBachModHandle = frame waitfram:handle.
     2602   define variable mFameOldVis as logical no-undo.
     2603   define variable mVisCUrentVin as logical no-undo.
     2604   if session:batch-mode
     2605   then
     2606      mBatchMode = yes.
     2607   if mBatchMode = ? then do:
     2608     mVisCUrentVin = current-window:visible.
     2609     mFameOldVis = mFramBachModHandle:visible.
     2610     mFramBachModHandle:visible  = yes.
     2611     mBatchMode = mFramBachModHandle:visible ne yes.
     2612     mFramBachModHandle:visible = mFameOldVis.
     2613     current-window:visible = mVisCUrentVin.
     2614   end.
     2615    if  log-manager:logfile-name ne ?
     2616     then DO:
     2617         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2618         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2619         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2620     end.
     2621   on choose of B-WaitFramStop in frame waitfram
     2622   do:
     2623     mWaitFramStop = yes.
     2624     mWaitFramStopUser = yes.
     2625   end.
     2626   function waitfram-check-timeout returns logical():
     2627      define variable vtime as int64 no-undo.
     2628      if mWaitFramStopTimeOut
     2629      then
     2630         return yes.
     2631      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2632      if     mWaitFramTimeOut ne ?
     2633         and mWaitFramTimeOut ne 0
     2634         and mWaitFramTimeOut lt vtime
     2635      then do:
     2636         mWaitFramStopTimeOut = yes.
     2637      end.
     2638      return mWaitFramStopTimeOut.
     2639   end.
     2640   procedure waitfram-hide :
     2641     if not session:batch-mode
     2642     then do
     2643     on error undo, return error return-value
     2644     :
     2645       pause 0 before-hide .
     2646       if not mBatchMode then
     2647         hide frame waitfram .
     2648     if     not mWaitFramView
     2649        and mWaitProcEvent
     2650     then
     2651       process events .
     2652     end.
     2653   end procedure.
     2654   procedure waitfram-show :
     2655     define input  parameter p-message as character no-undo .
     2656     define variable v-left-margin as integer   no-undo .
     2657     if not session:batch-mode
     2658     then do
     2659     on error undo, return error return-value
     2660     :
     2661       if length(p-message) <= 70 then do:
     2662         assign
     2663           v-left-margin = integer((70 - length(p-message)) / 2)
     2664         .
     2665         assign
     2666           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2667         .
     2668         assign
     2669           v-waitfram-action01 = " "
     2670           v-waitfram-action02 = " "
     2671                                    + fill(" ", v-left-margin)
     2672                                    + p-message
     2673           v-waitfram-action03 = " "
     2674         .
     2675       end.
     2676       else do:
     2677         define variable vRindex1 as integer no-undo.
     2678         define variable vRindex2 as integer no-undo.
     2679         vRindex1 = r-index(p-message," ",70).
     2680         if vRindex1 = 0
     2681         then
     2682            vRindex1 = 70.
     2683         if length(p-message)  <= vRindex1 + 70 then do:
     2684           assign
     2685             v-waitfram-action01 = " "
     2686             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2687             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2688           .
     2689         end.
     2690         else do:
     2691           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2692           if vRindex2 <= vRindex1
     2693           then
     2694              vRindex2 = vRindex1 + 70.
     2695           assign
     2696             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2697             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2698             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2699           .
     2700         end.
     2701       end.
     2702       B-viewProcInfo:visible   in frame waitfram = no.
     2703       B-viewProcInfo:sensitive in frame waitfram = no.
     2704       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2705       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2706       if  (   mWaitFramView
     2707          or  mWaitProcEvent)
     2708          and not mBatchMode
     2709       then
     2710          display
     2711             v-waitfram-action01 skip
     2712             v-waitfram-action02 skip
     2713             v-waitfram-action03 skip
     2714          with frame waitfram .
     2715       if     mWaitFramView
     2716          then do:
     2717             if     mWaitFramInterval ne ?
     2718                and not mBatchMode
     2719             then
     2720                wait-for go of frame waitfram pause mWaitFramInterval.
     2721          end.
     2722          else
     2723             if     mWaitProcEvent
     2724                and not mBatchMode
     2725             then
     2726                process events .
     2727     end.
     2728   end procedure.
     2729      procedure waitfram-show-this:
     2730         define input  parameter iInterval as int64 no-undo.
     2731         define variable vtime as int64 no-undo.
     2732         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2733         mWaitFramInterval = iInterval.
     2734         run waitfram-show (substitute("&1&2 &3&4" ,
     2735                                       mWaitFramTextBeg ,
     2736                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2737                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2738                                       mWaitFramTextEnd
     2739                                      )
     2740                           ).
     2741      end.
     2742      procedure WaitFramRunPause:
     2743         define input  parameter iInterval as dec no-undo.
     2744         define variable vStart  as datetime-tz no-undo.
     2745         define variable vend    as datetime-tz no-undo.
     2746         define variable vint as int64 no-undo.
     2747         define variable vOk as logical no-undo.
     2748         vStart = now.
     2749         vend   = vStart.
     2750         publish "WaitFramPause" (iInterval,output vOk).
     2751         vend   =  now.
     2752         vint = vend - vStart.
     2753         vint = iInterval - vint / 1000.
     2754         if     not mWaitFramStop
     2755            and (   vint > 0
     2756                 or (    not vOk
     2757                     and iInterval eq ?
     2758                     )
     2759                 )
     2760         then
     2761            run waitfram-show-this (iInterval).
     2762         vend   =  now.
     2763         vint = vend - vStart.
     2764         vint = iInterval - vint / 1000.
     2765         if     not mWaitFramStop
     2766            and vint > 0
     2767         then do:
     2768            run gbl/pause.p (vint * 1000).
     2769         end.
     2770         if iInterval ne ?
     2771         then
     2772            publish "WaitFramStop".
     2773         waitfram-check-timeout().
     2774      end.
     2775      procedure WaitFramWaitFor:
     2776         define input  parameter iInterval as dec no-undo.
     2777         assign
     2778            mWaitFramStartProc   = now
     2779            mWaitFramStopUser    = no
     2780            mWaitFramStopTimeOut = no
     2781         .
     2782         block-wait:
     2783         do while not mWaitFramStop:
     2784            run WaitFramRunPause (iInterval).
     2785            if  waitfram-check-timeout()
     2786            then do:
     2787               leave block-wait.
     2788            end.
     2789         end.
     2790         run waitfram-hide.
     2791      end.
     2792   procedure waitfram-join :
     2793     define input  parameter p-line-1  as character no-undo .
     2794     define input  parameter p-line-2  as character no-undo .
     2795     define input  parameter p-line-3  as character no-undo .
     2796     define output parameter p-message as character no-undo .
     2797     do
     2798     on error undo, return error return-value
     2799     :
     2800       assign
     2801         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2802                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2803                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2804       .
     2805     end.
     2806   end procedure.
     2807   function waitfram-join-function returns character
     2808     (input p-line-1 as character
     2809     ,input p-line-2 as character
     2810     ,input p-line-3 as character
     2811     ).
     2812     define variable v-message as character no-undo .
     2813     run waitfram-join in this-procedure
     2814       (input  p-line-1
     2815       ,input  p-line-2
     2816       ,input  p-line-3
     2817       ,output v-message
     2818       ) .
     2819     return v-message .
     2820   end function .
     2821   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2822   FUNCTION prep-nameorcode RETURNS CHARACTER
     2823     ( input p-nameorcode as character ) :
     2824   define variable v-nameorcode as character no-undo .
     2825   define variable v-dopi as character no-undo .
     2826   if trim(p-nameorcode) = '' then  return ''.
     2827   v-nameorcode = trim( trim( p-NameOrCode) , "*" ) .
     2828   if index(v-NameOrCode, chr(34) ,1 ) = 1
     2829   and R-index(v-NameOrCode, chr(34) ,1 ) = 1 then do:
     2830     assign
     2831     v-NameOrCode = trim(v-NameOrCode, chr(34))
     2832     .
     2833   end.
     2834   assign
     2835   v-dopi = substring(v-NameOrCode, length(v-NameOrCode), 1)
     2836   .
     2837   if index("abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя", v-dopi) > 0
     2838   or index("1234567890", v-dopi) > 0
     2839   then do:
     2840     v-NameOrCode = v-NameOrCOde + "*".
     2841   end.
     2842   v-NameOrCode = LC(v-NameOrCode).
     2843   RETURN v-nameorcode.
     2844   END FUNCTION.
     2845   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2846   procedure gen-key-rec :
     2847     define input  parameter p-tbl-name    as character no-undo.
     2848     define input  parameter p-bh_tbl-name as handle    no-undo.
     2849     define output parameter p-key-rec     as character no-undo.
     2850     do
     2851     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2852     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2853     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2854     :
     2855       define variable fh               as handle    no-undo .
     2856       define variable v-ok             as logical   no-undo .
     2857       define variable v-inform         as character no-undo .
     2858       define variable v-ind            as integer   no-undo .
     2859       define variable v-idx-field-qnty as integer   no-undo .
     2860       if p-tbl-name = ?
     2861         or p-tbl-name = "":U
     2862       then do:
     2863         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info19 ).
     2864       end.
     2865       if not p-bh_tbl-name:available then do:
     2866         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info19, p-tbl-name ).
     2867       end.
     2868       assign
     2869         p-key-rec = p-tbl-name
     2870         v-inform  = p-bh_tbl-name:index-information(1)
     2871         v-ind     = 2
     2872       .
     2873       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2874       on error undo, return error
     2875       :
     2876         assign
     2877           v-inform = p-bh_tbl-name:index-information( v-ind )
     2878           v-ind    = v-ind + 1
     2879         .
     2880       end.
     2881       if v-inform = ?
     2882         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2883         or entry( 3, v-inform, ",":U ) <> "1":U
     2884       then do:
     2885         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info19, p-tbl-name ).
     2886       end.
     2887       else do:
     2888         assign
     2889           v-idx-field-qnty = num-entries( v-inform ) - 4
     2890         .
     2891         if v-idx-field-qnty < 2 then do:
     2892           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, p-tbl-name ).
     2893         end.
     2894         do v-ind = 1 to v-idx-field-qnty by 2
     2895         on error undo, return error
     2896         :
     2897           assign
     2898             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2899             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2900           .
     2901         end.
     2902       end.
     2903       if p-key-rec = ? then do:
     2904         assign
     2905           p-key-rec = "":U
     2906         .
     2907         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info19, p-tbl-name ).
     2908       end.
     2909     end.
     2910     return.
     2911   end procedure.
     2912   procedure gen-where-keyr-tab :
     2913     define input  parameter i-tableSerach as character no-undo.
     2914     define input  parameter i-tablekey   as character  no-undo.
     2915     define input  parameter p-key-rec    as character  no-undo.
     2916     define input  parameter p-key-handle as handle     no-undo .
     2917     define input  parameter p-db-name    as character  no-undo .
     2918     define input  parameter p-tt-handle  as handle     no-undo .
     2919     define output parameter o-Where      as character  no-undo.
     2920     do
     2921     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2922     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2923     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2924     :
     2925       define variable v-full-tbl-name  as character no-undo .
     2926       define variable bh_tbl-name      as handle    no-undo .
     2927       define variable fh_key           as handle    no-undo .
     2928       define variable fh_search        as handle    no-undo .
     2929       define variable v-field-num      as integer   no-undo .
     2930       define variable v-count-fld      as integer   no-undo .
     2931       define variable v-inform         as character no-undo .
     2932       define variable v-ind            as integer   no-undo .
     2933       define variable v-idx-field-qnty as integer   no-undo .
     2934       define variable v-field-name     as character no-undo .
     2935       define variable v-field-val      as character no-undo .
     2936       define variable v-word-link      as character no-undo .
     2937       define variable vTable           as character no-undo.
     2938       define variable bh_tbl-key       as handle    no-undo .
     2939       assign
     2940         p-key-rec = trim( p-key-rec )
     2941       .
     2942       if p-key-handle <> ? then do:
     2943         if not valid-handle(p-key-handle)
     2944            or p-key-handle:type <> "buffer"
     2945         then do:
     2946           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info19 ).
     2947         end.
     2948         if num-entries( p-key-rec, chr(3) ) > 1
     2949           or p-key-rec = ?
     2950           or p-key-rec = "":U
     2951         then do:
     2952           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info19, p-key-rec ).
     2953         end.
     2954       end.
     2955       else do:
     2956         if p-key-rec = ?
     2957           or p-key-rec = "":U
     2958         then do:
     2959           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info19 ).
     2960         end.
     2961       end.
     2962       assign
     2963         vTable = entry( 1 , p-key-rec, chr(3) )
     2964       .
     2965       if p-tt-handle <> ?
     2966         and ( not valid-handle(p-tt-handle)
     2967               or p-tt-handle:type <> "buffer"
     2968             )
     2969       then do:
     2970         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info19, vTable, chr(10) ).
     2971       end.
     2972       if p-tt-handle = ? then do:
     2973         assign
     2974           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2975         .
     2976         create buffer bh_tbl-name for table v-full-tbl-name .
     2977       end.
     2978       else do:
     2979         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2980       end.
     2981       assign
     2982         v-inform = bh_tbl-name:index-information(1)
     2983         v-ind    = 2
     2984       .
     2985       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2986       on error undo, return error
     2987       :
     2988         assign
     2989           v-inform = bh_tbl-name:index-information( v-ind )
     2990           v-ind    = v-ind + 1
     2991         .
     2992       end.
     2993       if v-inform = ?
     2994         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2995         or entry( 3, v-inform, ",":U ) <> "1":U
     2996       then do:
     2997         delete object bh_tbl-name no-error.
     2998         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info19, vTable ).
     2999       end.
     3000       assign
     3001         v-idx-field-qnty = num-entries( v-inform ) - 4
     3002       .
     3003       if v-idx-field-qnty < 2 then do:
     3004         delete object bh_tbl-name no-error.
     3005         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, vTable ).
     3006       end.
     3007       assign
     3008         o-where     = "where":U
     3009         v-word-link = "":U
     3010         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     3011         v-count-fld = 0
     3012       .
     3013       if i-tablekey ne "" and i-tablekey ne ?
     3014       then do:
     3015         assign
     3016           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     3017         .
     3018         create buffer bh_tbl-key for table v-full-tbl-name .
     3019       end.
     3020       if i-tableSerach ne "" and i-tableSerach ne ?
     3021       then do:
     3022         delete object bh_tbl-name no-error.
     3023         assign
     3024           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     3025         .
     3026         create buffer bh_tbl-name for table v-full-tbl-name .
     3027       end.
     3028       block_where:
     3029       do v-ind = 1 to v-idx-field-qnty by 2
     3030       on error undo, return error
     3031       :
     3032         assign
     3033           v-count-fld = v-count-fld + 1
     3034         .
     3035         if p-key-handle = ?
     3036           and v-count-fld > v-field-num
     3037         then do:
     3038           leave block_where.
     3039         end.
     3040         define variable VfieldKeyTable as handle no-undo.
     3041         assign
     3042           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3043           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     3044         .
     3045         if     bh_tbl-key ne ?
     3046         then do:
     3047            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     3048            if VfieldKeyTable eq ?
     3049            then next block_where.
     3050         end.
     3051         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     3052         then
     3053            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     3054         else
     3055            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     3056         if p-key-handle = ? then do:
     3057           assign
     3058             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     3059           .
     3060         end.
     3061         else do:
     3062           assign
     3063             fh_key = p-key-handle:buffer-field( v-field-name )
     3064           .
     3065           if fh_key = ?
     3066             or not valid-handle( fh_key )
     3067           then do:
     3068             delete object bh_tbl-name.
     3069             if     bh_tbl-key ne ?
     3070             then
     3071                delete object bh_tbl-key.
     3072             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info19, p-key-handle:name, v-field-name ).
     3073           end.
     3074           assign
     3075             v-field-val = fh_key:buffer-value
     3076           .
     3077         end.
     3078         if fh_search:data-type ="character":U then do:
     3079           assign
     3080             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     3081             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     3082             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     3083             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     3084             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     3085             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     3086             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     3087             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     3088             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     3089             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     3090             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     3091             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     3092             v-field-val = substitute( '"&1"', v-field-val )
     3093           .
     3094         end.
     3095         assign
     3096           o-where = substitute( "&1 &2", o-where, v-field-val )
     3097         .
     3098         if v-word-link = "":U then do:
     3099           assign
     3100             v-word-link = "and":U
     3101           .
     3102         end.
     3103       end.
     3104       delete object bh_tbl-name.
     3105       if     bh_tbl-key ne ?
     3106       then
     3107          delete object bh_tbl-key.
     3108       if p-key-handle = ?
     3109         and v-count-fld <> v-field-num
     3110       then do:
     3111         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info19, vTable ).
     3112       end.
     3113     end.
     3114   end procedure.
     3115   procedure gen-hn-keyr-tab :
     3116     define input  parameter i-tableSerach as character no-undo.
     3117     define input  parameter i-tablekey   as character no-undo.
     3118     define input  parameter p-key-rec    as character no-undo.
     3119     define input  parameter p-key-handle as handle    no-undo .
     3120     define input  parameter p-db-name    as character no-undo .
     3121     define input  parameter p-tt-handle  as handle    no-undo .
     3122     define input  parameter p-stts-lock  as integer   no-undo .
     3123     define output parameter o-hn         as handle    no-undo.
     3124     define variable v-full-tbl-name as character no-undo.
     3125     define variable v-where         as character no-undo.
     3126     define variable bh_tbl-name     as handle    no-undo.
     3127     define variable vTable          as character no-undo.
     3128     do
     3129     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3130     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3131     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     3132         run gen-where-keyr-tab(i-tableSerach,
     3133                                i-tablekey,
     3134                                p-key-rec,
     3135                                p-key-handle,
     3136                                p-db-name,
     3137                                p-tt-handle,
     3138                                output v-where).
     3139         if i-tableSerach ne "" and i-tableSerach ne ?
     3140         then do:
     3141            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     3142            create buffer bh_tbl-name for table v-full-tbl-name .
     3143         end.
     3144         else do:
     3145            if p-tt-handle = ? then do:
     3146               assign
     3147                  vTable = entry( 1 , p-key-rec, chr(3) )
     3148               .
     3149               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     3150               create buffer bh_tbl-name for table v-full-tbl-name .
     3151            end.
     3152            else do:
     3153               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3154            end.
     3155         end.
     3156         if p-tt-handle = ? then do:
     3157            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     3158         end.
     3159         else do:
     3160            bh_tbl-name:find-first( v-where ) no-error .
     3161         end.
     3162         o-hn = bh_tbl-name.
     3163      end.
     3164   end procedure.
     3165   procedure gen-hn-keyr :
     3166     define input  parameter p-key-rec    as character no-undo.
     3167     define input  parameter p-key-handle as handle    no-undo .
     3168     define input  parameter p-db-name    as character no-undo .
     3169     define input  parameter p-tt-handle  as handle    no-undo .
     3170     define input  parameter p-stts-lock  as integer   no-undo .
     3171     define output parameter o-hn         as handle    no-undo.
     3172     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     3173   end.
     3174   procedure gen-row-keyr :
     3175     define input  parameter p-key-rec    as character no-undo.
     3176     define input  parameter p-key-handle as handle    no-undo .
     3177     define input  parameter p-db-name    as character no-undo .
     3178     define input  parameter p-tt-handle  as handle    no-undo .
     3179     define input  parameter p-stts-lock  as integer   no-undo .
     3180     define output parameter p-tbl-row    as rowid     no-undo.
     3181     define output parameter p-tbl-name   as character no-undo.
     3182     define variable vHn as handle no-undo.
     3183       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     3184       p-tbl-row = if vHn:available then vHn:rowid else ?.
     3185       p-tbl-name =  vHn:table.
     3186       delete object vHn no-error.
     3187     if p-tbl-row = ? then do:
     3188       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info19, p-tbl-name, p-key-rec ).
     3189     end.
     3190     else do:
     3191       return.
     3192     end.
     3193   end procedure.
     3194   procedure gen-key-fv :
     3195     define input  parameter p-key-rec    as character no-undo .
     3196     define output parameter p-field-list as character no-undo .
     3197     define output parameter p-value-list as character no-undo.
     3198     do
     3199     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3200     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3201     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3202     :
     3203       define variable v-full-tbl-name  as character no-undo .
     3204       define variable bh_tbl-name      as handle    no-undo .
     3205       define variable v-tbl-name       as character no-undo .
     3206       define variable v-field-num      as integer   no-undo .
     3207       define variable v-count-fld      as integer   no-undo .
     3208       define variable v-inform         as character no-undo .
     3209       define variable v-ind            as integer   no-undo .
     3210       define variable v-idx-field-qnty as integer   no-undo .
     3211       define variable v-delim-key      as character no-undo .
     3212       if p-key-rec = ?
     3213         or p-key-rec = "":U
     3214       then do:
     3215         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info19 ).
     3216       end.
     3217       assign
     3218         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3219         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3220       .
     3221       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3222       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info19 ).
     3223       assign
     3224         v-inform = bh_tbl-name:index-information(1)
     3225         v-ind    = 2
     3226       .
     3227       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3228       on error undo, return error
     3229       :
     3230         assign
     3231           v-inform = bh_tbl-name:index-information( v-ind )
     3232           v-ind    = v-ind + 1
     3233         .
     3234       end.
     3235       if v-inform = ?
     3236         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3237         or entry( 3, v-inform, ",":U ) <> "1":U
     3238       then do:
     3239         delete object bh_tbl-name no-error.
     3240         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info19, v-tbl-name ).
     3241       end.
     3242       assign
     3243         v-idx-field-qnty = num-entries( v-inform ) - 4
     3244       .
     3245       if v-idx-field-qnty < 2 then do:
     3246         delete object bh_tbl-name no-error.
     3247         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, v-tbl-name ).
     3248       end.
     3249       assign
     3250         p-field-list = "":U
     3251         p-value-list = "":U
     3252         v-delim-key  = "":U
     3253         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3254         v-count-fld  = 0
     3255       .
     3256       block_where:
     3257       do v-ind = 1 to v-idx-field-qnty by 2
     3258       on error undo, return error
     3259       :
     3260         assign
     3261           v-count-fld = v-count-fld + 1
     3262         .
     3263         if v-count-fld > v-field-num then do:
     3264           leave block_where.
     3265         end.
     3266         assign
     3267           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3268           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3269         .
     3270         if v-ind = 1 then do:
     3271           assign
     3272             v-delim-key = chr(3)
     3273           .
     3274         end.
     3275       end.
     3276       delete object bh_tbl-name.
     3277       if v-count-fld <> v-field-num then do:
     3278         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info19, v-tbl-name ).
     3279       end.
     3280     end.
     3281   end procedure.
     3282   procedure gen-key-field :
     3283     define input  parameter p-table      as character no-undo .
     3284     define output parameter p-field-list as character no-undo .
     3285     do
     3286     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3287     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3288     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3289     :
     3290       define variable v-full-tbl-name  as character no-undo .
     3291       define variable bh_tbl-name      as handle    no-undo .
     3292       define variable v-tbl-name       as character no-undo .
     3293       define variable v-field-num      as integer   no-undo .
     3294       define variable v-count-fld      as integer   no-undo .
     3295       define variable v-inform         as character no-undo .
     3296       define variable v-ind            as integer   no-undo .
     3297       define variable v-idx-field-qnty as integer   no-undo .
     3298       define variable v-delim-key      as character no-undo .
     3299       if p-table = ?
     3300         or p-table = "":U
     3301       then do:
     3302         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info19 ).
     3303       end.
     3304       assign
     3305         v-tbl-name      = p-table
     3306         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3307       .
     3308       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3309       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info19 ).
     3310       assign
     3311         v-inform = bh_tbl-name:index-information(1)
     3312         v-ind    = 2
     3313       .
     3314       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3315       on error undo, return error
     3316       :
     3317         assign
     3318           v-inform = bh_tbl-name:index-information( v-ind )
     3319           v-ind    = v-ind + 1
     3320         .
     3321       end.
     3322       if v-inform = ?
     3323         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3324         or entry( 3, v-inform, ",":U ) <> "1":U
     3325       then do:
     3326         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info19, v-tbl-name ).
     3327       end.
     3328       assign
     3329         v-idx-field-qnty = num-entries( v-inform ) - 4
     3330       .
     3331       if v-idx-field-qnty < 2 then do:
     3332         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, v-tbl-name ).
     3333       end.
     3334       assign
     3335         p-field-list = "":U
     3336         v-delim-key  = "":U
     3337         v-count-fld  = 0
     3338       .
     3339       block_where:
     3340       do v-ind = 1 to v-idx-field-qnty by 2
     3341       on error undo, return error
     3342       :
     3343         assign
     3344           v-count-fld = v-count-fld + 1
     3345         .
     3346         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3347         if v-ind = 1 then do:
     3348           assign
     3349             v-delim-key = chr(3)
     3350           .
     3351         end.
     3352       end.
     3353       delete object bh_tbl-name.
     3354     end.
     3355   end procedure.
     3356   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3357   PROCEDURE verify-ini-entry:
     3358   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     3359   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     3360   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     3361   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     3362   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     3363   define variable v-mess as character no-undo .
     3364   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     3365   if ini-entry-value = ? and ini-key-name begins "spl"
     3366   then
     3367   get-key-value section ini-section-name key "splall" value ini-entry-value.
     3368   if ini-entry-value = ? and ini-key-name begins "sav"
     3369   then
     3370   get-key-value section ini-section-name key "savall" value ini-entry-value.
     3371   if ini-entry-value = ? then do:
     3372     assign
     3373     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     3374                       , chr(10)
     3375                       , ini-section-name
     3376                       , ini-key-name
     3377                       , error-msg-text).
     3378       if not silence then do:
     3379         message
     3380         v-mess
     3381         view-as alert-box ERROR  .
     3382         return error.
     3383       end.
     3384       else do:
     3385         return error v-mess.
     3386       end.
     3387   end.
     3388   END PROCEDURE.
     3389   PROCEDURE verify-file:
     3390   DEFINE INPUT  PARAMETER filename       as character no-undo.
     3391   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     3392   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     3393   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     3394   file-info:file-name = filename.
     3395   found = NOT (file-info:full-pathname = ?).
     3396   if NOT found  then do:
     3397     if not silence then do:
     3398       message error-msg-text
     3399       view-as alert-box ERROR.
     3400       return error.
     3401     end.
     3402     else return error error-msg-text.
     3403   end.
     3404   END PROCEDURE.
     3405   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3406   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     3407       define variable v-upper-code as int no-undo.
     3408       define variable v-value as character no-undo.
     3409       define variable v-type as character no-undo.
     3410       define buffer lc_gds-grp for ub.gds-grp.
     3411       define buffer lc_goods for ub.goods.
     3412      if p-gds-code <> 0 then do:
     3413       find first lc_goods where lc_goods.gds-code = p-gds-code.
     3414       v-upper-code = lc_goods.grp-code.
     3415       do while v-upper-code > 0 :
     3416           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     3417           run ggoattr-value(
     3418             input lc_gds-grp.node-code,
     3419             input 0,
     3420             input "",
     3421             input 0,
     3422             input 'ban-sales-via-cd':U,
     3423             output v-value,
     3424             output v-type
     3425           ).
     3426          if v-value = "yes" then
     3427             return true.
     3428          else
     3429          do:
     3430             run ggoattr-value(
     3431                input lc_gds-grp.node-code,
     3432                input v-cntxt-host-code-obj,
     3433                input "",
     3434                input 0,
     3435                input 'ban-sales-via-cd':U,
     3436                output v-value,
     3437                output v-type
     3438                ).
     3439             if v-value = "yes" then
     3440                return true.
     3441             else
     3442             do:
     3443                run ggoattr-value(
     3444                   input lc_gds-grp.node-code,
     3445                   input v-cntxt-host-code-obj,
     3446                   input v-cntxt-obj-type,
     3447                   input v-cntxt-obj-code,
     3448                   input 'ban-sales-via-cd':U,
     3449                   output v-value,
     3450                   output v-type
     3451                   ).
     3452                if v-value = "yes" then
     3453                   return true.
     3454                else v-upper-code = lc_gds-grp.upper-code.
     3455             end .
     3456          end.
     3457         end.
     3458       end.
     3459       if v-value = "" or logical(v-value) = false then return false .
     3460   end.
     3461   FUNCTION check-ban-sales-via-cd-grp return logical ( input p-grp-code as integer ) :
     3462       define variable v-upper-code as int no-undo.
     3463       define variable v-value as character no-undo.
     3464       define variable v-type as character no-undo.
     3465       define buffer lc_gds-grp for ub.gds-grp.
     3466       define buffer lc_goods for ub.goods.
     3467       v-upper-code = p-grp-code.
     3468       do while v-upper-code > 0 :
     3469           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     3470           run ggoattr-value(
     3471             input lc_gds-grp.node-code,
     3472             input 0,
     3473             input "",
     3474             input 0,
     3475             input 'ban-sales-via-cd':U,
     3476             output v-value,
     3477             output v-type
     3478           ).
     3479          if v-value = "yes" then
     3480             return true.
     3481          else
     3482          do:
     3483             run ggoattr-value(
     3484                input lc_gds-grp.node-code,
     3485                input v-cntxt-host-code-obj,
     3486                input "",
     3487                input 0,
     3488                input 'ban-sales-via-cd':U,
     3489                output v-value,
     3490                output v-type
     3491                ).
     3492             if v-value = "yes" then
     3493                return true.
     3494             else
     3495             do:
     3496                run ggoattr-value(
     3497                   input lc_gds-grp.node-code,
     3498                   input v-cntxt-host-code-obj,
     3499                   input v-cntxt-obj-type,
     3500                   input v-cntxt-obj-code,
     3501                   input 'ban-sales-via-cd':U,
     3502                   output v-value,
     3503                   output v-type
     3504                   ).
     3505                if v-value = "yes" then
     3506                   return true.
     3507                else v-upper-code = lc_gds-grp.upper-code.
     3508             end .
     3509          end.
     3510         end.
     3511   end.
