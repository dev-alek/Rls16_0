     8285     if NOT g#log then do:
     8286       return no-apply .
     8287     end.
     8288     assign
     8289       g#log = yes
     8290     .
     8291     assign
     8292       lns-cnt = 1
     8293     .
     8294   if session :set-wait-state( "compiler" ) then.
     8295     DO TRANSACTION WHILE lns-cnt <= NUM-ENTRIES( rid-list ) :
     8296       assign
     8297         gds-rec = integer( entry( lns-cnt, rid-list ) )
     8298       .
     8299       FIND FIRST loc-goo-doc WHERE RECID( loc-goo-doc ) = gds-rec.
     8300       IF loc-goo-doc.stts <> 0 then do:
     8301         assign
     8302           was-deleted = was-deleted + 1
     8303           lns-cnt     = lns-cnt     + 1
     8304         .
     8305         next.
     8306       end.
     8307       FIND FIRST loc-goo-doc WHERE RECID( loc-goo-doc ) = gds-rec .
     8308       assign
     8309         lns-cnt   = lns-cnt + 1
     8310         v-chg-rec = gds-rec
     8311       .
     8312       run recalc-assgds in this-procedure  ( input loc-goo-doc.gds-code,
     8313                                              input loc-goo-doc.grp-code,
     8314                                              input buf_gds-grp.node-code,
     8315                                              output v-ok    ) .
     8316       if v-ok then loc-goo-doc.grp-code = buf_gds-grp.node-code.
     8317            if check-ban-sales-via-cd-grp(loc-goo-doc.grp-code) then do:
     8318              run str/diallog.w (parparentproc, this-procedure, 'str/del-grp.p':U, string(v-cntxt-obj-code) + chr(4) + string(loc-goo-doc.grp-code), no,
     8319                                'Прервать', 'Удаление товаров с касс') .
     8320           end.
     8321        define variable v-value-emrc as character no-undo .
     8322        define variable v-type-emrc  as character no-undo .
     8323        old-value-emrc = "" .
     8324        for first ub.gds-grp-obj-attr no-lock
     8325           where ub.gds-grp-obj-attr.node-code   = v-old-code
     8326           and ub.gds-grp-obj-attr.host-code   = 0
     8327           and ub.gds-grp-obj-attr.obj-type    = ""
     8328           and ub.gds-grp-obj-attr.obj-code    = 0
     8329           and ub.gds-grp-obj-attr.attr-code   = 'emrc-type':U:
     8330           old-value-emrc = ub.gds-grp-obj-attr.attr-value .
     8331        end.
     8332        for first ub.gds-grp exclusive-lock where ub.gds-grp.node-code = loc-goo-doc.grp-code:
     8333           for first ub.gds-grp-obj-attr no-lock
     8334              where ub.gds-grp-obj-attr.node-code   = loc-goo-doc.grp-code
     8335              and ub.gds-grp-obj-attr.host-code   = 0
     8336              and ub.gds-grp-obj-attr.obj-type    = ""
     8337              and ub.gds-grp-obj-attr.obj-code    = 0
     8338              and ub.gds-grp-obj-attr.attr-code   = 'emrc-type':U:
     8339              v-value-emrc = ub.gds-grp-obj-attr.attr-value .
     8340           end.
     8341           define variable v-attr-emrc as character no-undo .
     8342           define variable v-attr-type as character no-undo .
     8343           define variable v-del       as logical   no-undo .
     8344           define buffer buf_goods-attr for ub.goods-attr .
     8345           define variable v-emrc-name as character no-undo .
     8346           for first buf_goods-attr no-lock where buf_goods-attr.attr-code = 'emrc-type':U and
     8347              buf_goods-attr.gds-code = loc-goo-doc.gds-code:
     8348              v-attr-emrc = buf_goods-attr.attr-value .
     8349           end.
     8350           if v-value-emrc <> old-value-emrc and v-attr-emrc = "" then
     8351           do:
     8352              find first ub.code no-lock where ub.Code.parent = "EMC" and ub.Code.code = v-value-emrc no-error .
     8353              if not available (ub.Code) then v-emrc-name = "Нет" .
     8354              else v-emrc-name = ub.Code.CodeName .
     8355              message "При переносе в группу " + string(ub.gds-grp.node-name) + " для товара " + string(loc-goo-doc.gds-name) skip
     8356                 "будет наследоваться значение новой группы тип ЕМЦ - " + v-emrc-name + ". " skip
     8357                 "При утвердительном ответе товар переносится в новую группу, значение тип ЕМЦ - " + v-emrc-name
     8358                 view-as alert-box question buttons yes-no-cancel update choice as logical .
     8359              CASE choice:
     8360                 WHEN TRUE THEN
     8361                    DO:
     8362                    END.
     8363                 WHEN FALSE THEN
     8364                    DO:
     8365                       run gds-attr-write IN THIS-PROCEDURE(
     8366                          input loc-goo-doc.gds-code
     8367                          ,INPUT 'emrc-type':U
     8368                          ,INPUT old-value-emrc ) .
     8369                    END.
     8370                 OTHERWISE
     8371                 DO:
     8372                    loc-goo-doc.grp-code = v-old-code .
     8373                 end.
     8374              END CASE.
     8375           end.
     8376           if v-value-emrc <> v-attr-emrc and v-attr-emrc <> "" then do:
     8377              define variable ichoice as integer no-undo .
     8378              find first ub.code no-lock where ub.Code.parent = "EMC" and ub.Code.code = v-attr-emrc no-error .
     8379              if not available (ub.Code) then v-emrc-name = "Нет" .
     8380              else v-emrc-name = ub.Code.CodeName .
     8381                     run gbl/d-askw.w (
     8382                        input "Сообщение"
     8383                        ,input  "На товар установлен атрибут «тип ЕМЦ» - " + v-emrc-name + ". При переносе товара значение может быть изменено."
     8384                        ,input "|"
     8385                        ,input "Наследовать|Оставить|Отмена"
     8386                        ,input "Наследовать атрибут от новой группы|Оставить текущее значение атрибута|Отмена"
     8387                        ,input 1
     8388                        ,input 3
     8389                        ,output ichoice).
     8390              CASE iChoice:
     8391                 WHEN 1 THEN
     8392                    DO:
     8393                 if v-value-emrc = "" then do:
     8394                 run gds-attr-delete IN THIS-PROCEDURE(
     8395                    input loc-goo-doc.gds-code
