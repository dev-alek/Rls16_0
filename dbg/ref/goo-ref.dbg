     4272   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4273   find first l-goo-doc where true AND (if g-stat = 'все':U then true else (if g-stat = 'текущие':U then (l-goo-doc.stts = 0)else (l-goo-doc.stts = 1)))
     4274                                     and l-goo-doc.artic begins loc-art no-lock no-error.
     4275       end.
