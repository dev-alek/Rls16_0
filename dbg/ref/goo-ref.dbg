     8742   RUN gds-ref-to IN THIS-PROCEDURE (
     8743                                        INPUT        gdsreffi
     8744                                       ,INPUT-OUTPUT myto[1]
     8745                                       ,INPUT-OUTPUT myto[2]
     8746                                       ,INPUT-OUTPUT myto[3]
     8747                                       ,INPUT-OUTPUT myto[4]
     8748                                       ,INPUT-OUTPUT myto[5]
     8749                                       ,INPUT-OUTPUT myto[6]
     8750                                       ,INPUT-OUTPUT myto[7]
     8751                                       ,INPUT-OUTPUT myto[8]
     8752                                     ) NO-ERROR.
     8753   assign
     8754   fi-1 :tooltip in frame d-goo-doc-ref = myto[1]
     8755   fi-2 :tooltip      = myto[2]
     8756   fi-3 :tooltip      = myto[3]
     8757   fi-4 :tooltip      = myto[4]
     8758   fi-5 :tooltip      = myto[5]
     8759   fi-6 :tooltip      = myto[6]
     8760   fi-7 :tooltip      = myto[7]
     8761   fi-8 :tooltip      = myto[8]
     8762   .
     8763   find first g-producer no-lock where
     8764               g-producer.obj-type = p-producer-type
     8765         AND  g-producer.obj-code = p-producer-code no-error.
     8766   if ( g-list = 'Производитель':U ) AND ( NOT available g-producer ) then do:
     8767     assign
     8768       g-list = 'все':U
     8769     .
     8770   end.
     8771   if num-entries (rid-list) = 0 then do:
     8772     hide mark-num in frame d-goo-doc-ref.
     8773   end.
     8774   else do:
     8775     display
     8776       num-entries( rid-list ) @ mark-num
     8777     with frame d-goo-doc-ref.
     8778   end.
     8779   br-gds :SET-REPOSITIONED-ROW( 5, "CONDITIONAL":U ).
     8780   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     8781     (input  'is-ptrl'
     8782     ,input  ''
     8783     ,input  ''
     8784     ,input  0
     8785     ,input  ''
     8786     ,input  ''
     8787     ,input  ''
     8788     ,input  no
     8789     ,output v-is-ptrl
     8790     ,output v-data-type
     8791     ) no-error .
     8792   if error-status :error or v-data-type <> "L" or lookup( v-is-ptrl, "yes,no" ) = 0 then do:
     8793     assign
     8794       v-is-ptrl = "no"
     8795     .
     8796   end.
     8797   if v-is-ptrl <> "yes" then do:
