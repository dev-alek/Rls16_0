     7212                    , input        ?
     7213                    , input        ?
     7214                    , input        ?
     7215                    , input        ?
     7216                    , input        "":U
     7217                    , input        "":U
     7218                    , input        v-cntxt-db-num
     7219                    , input-output v-rid-list
     7220                    ) no-error .
     7221   END PROCEDURE.
     7222   PROCEDURE proc-b-add-inf:
     7223     DEFINE INPUT-OUTPUT PARAMETER loc-DOPINF-option AS CHARACTER NO-UNDO.
     7224     define input parameter         loc-mode         as character no-undo .
     7225     define variable destin_         like ub.goods.destin         no-undo .
     7226     define variable attrib_         like ub.goods.attrib         no-undo .
     7227     define variable user-rule_      like ub.goods.user-rule      no-undo .
     7228     define variable sert_           like ub.goods.sert           no-undo .
     7229     define variable struct_         like ub.goods.struct         no-undo .
     7230     define variable deadline_       like ub.goods.deadline       no-undo .
     7231     define variable sort_           like ub.goods.sort           no-undo .
     7232     define variable proof_          like ub.goods.proof          no-undo .
     7233     define variable tnved_          like ub.goods.tnved          no-undo format "x(10)":U .
     7234     define variable unit-cst_       like ub.goods.unit-cst       no-undo .
     7235     define variable cst-base-rate_  like ub.goods.cst-base-rate  no-undo .
     7236     define variable nationality_    like ub.goods.nationality    no-undo .
     7237     define variable normal-wastage_ like ub.goods.normal-wastage no-undo .
     7238     define variable normal-waste_   like ub.goods.normal-waste   no-undo .
     7239     define variable cond-keep-code_ like ub.goods.cond-keep-code no-undo .
     7240     define variable is-alc          as logical                   no-undo .
     7241     define variable is-alc-mark     as logical                   no-undo .
     7242     define variable choose-alc-prod_ as integer                  no-undo .
     7243     define variable prodaddress as character no-undo .
     7244     define variable v-recid     as recid     no-undo .
     7245     define variable v-template  as character no-undo .
     7246     define variable loc#log     as logical no-undo .
     7247     define variable v-update-attr as logical no-undo .
     7248     define variable v-update-dgr as logical no-undo .
     7249     define variable v-is-error as logical no-undo .
     7250     define buffer loc-goods   for ub.goods.
     7251     define buffer buf_clients for ub.clients.
     7252     define buffer buf_firm    for ub.firm.
     7253     define buffer buf_person  for ub.person.
     7254     case LOC-DOPINF-option:
     7255       when "dop-inf":U then do:
     7256           if loc-mode = 'ИЗМЕНЕНИЕ':U then do:
     7257   define variable vss-include-info61 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7258   do:
     7259     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7260       (input  v-cntxt-db-num
     7261       ,input  v-cntxt-userid
     7262       ,input  0
     7263       ,input  'actn_reference_update_dopinfo':U
     7264       ,input  'object':U
     7265       ,input  v-cntxt-host-code-obj
     7266       ,input  v-cntxt-obj-type
     7267       ,input  v-cntxt-obj-code
     7268       ,input  0
     7269       ,input  goo-doc.grp-code
     7270       ,input  0
     7271       ,input  true
     7272       ,output g#log
     7273       )  .
     7274   end.
     7275                 if not g#log then do: return error . end.
     7276           end.
     7277         find first loc-goods no-lock where
     7278                    loc-goods.gds-code = goo-doc.gds-code no-error .
     7279         if available loc-goods then do:
     7280           find first buf_clients no-lock where
     7281                      buf_clients.obj-type = loc-goods.prod-type
     7282                 AND  buf_clients.obj-code = loc-goods.prod-code no-error .
     7283           if available buf_clients then do:
     7284             case buf_clients.obj-type :
     7285               when 'орг':U then do:
     7286                 find first buf_firm no-lock where
