     7974         .
     7975       end.
     7976       else do:
     7977         assign
     7978           g#log = a-n-c :disable( "Нач.слова" )
     7979         .
     7980       end.
     7981       DISPLAY
     7982         a-n-c
     7983       WITH FRAME d-goo-doc-ref .
     7984       if input frame d-goo-doc-ref rs-cond = 'все':U or g-cond = 'все':U then do:
     7985               assign
