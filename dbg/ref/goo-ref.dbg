     1873               when 'prphoto':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(2256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(2256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Прайс-лист с фото товаров"     p-tooltip = "Прайс-лист с фото товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1874               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1875               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1876               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1877                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1878               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1879         otherwise do:
     1880           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1881         end.
     1882       end CASE.
     1883     end.
     1884   end procedure.
     1885   procedure uf-get :
     1886     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1887     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1888     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1889     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1890     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1891     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1892     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1893     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1894     do
     1895     on error undo, return error
     1896     :
     1897       define buffer buf_usr-flt for ubflt.usr-flt .
     1898       define variable v-use-List_     as logical   no-undo .
     1899       define variable v-type-List_     as character no-undo .
     1900       define variable v-format-List_   as character no-undo .
     1901       define variable v-use-Naim      as logical   no-undo .
     1902       define variable v-type-Naim      as character no-undo .
     1903       define variable v-format-Naim    as character no-undo .
     1904       define variable v-use-print-graft as logical   no-undo .
     1905       define variable v-use-sort-gr     as logical   no-undo .
     1906       define variable v-use-type-price  as logical   no-undo .
     1907       define variable v-use-type-val    as logical   no-undo .
     1908       define variable v-label          as character no-undo .
     1909       define variable v-tooltip        as character no-undo .
     1910       define variable v-user-can-edit  as logical   no-undo .
     1911       define variable v-output-display as logical   no-undo .
     1912       define variable v-other          as character no-undo .
     1913       run uf-name in this-procedure
     1914          (input  entry(1, p-code, chr(4))
     1915         ,output v-use-List_
     1916         ,output v-type-List_
     1917         ,output v-format-List_
     1918         ,output v-use-Naim
     1919         ,output v-type-Naim
     1920         ,output v-format-Naim
     1921         ,output v-use-print-graft
     1922         ,output v-use-sort-gr
     1923         ,output v-use-type-price
     1924         ,output v-use-type-val
     1925         ,output v-label
     1926         ,output v-tooltip
     1927         ,output v-user-can-edit
     1928         ,output v-output-display
     1929         ,output v-other
     1930         ) no-error .
     1931       if error-status :error then do:
     1932         undo, return error return-value .
     1933       end.
     1934       find first buf_usr-flt no-lock where
     1935                  buf_usr-flt.Call-point     = p-code AND
     1936                  buf_usr-flt.user-name       = p-user-name
     1937         no-error .
     1938       if avail buf_usr-flt then do:
     1939         assign
     1940         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1941         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1942         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1943         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1944         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1945         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1946         .
     1947       end.
     1948       else do:
     1949         assign
     1950         p-List_        = (if v-use-List_       then "":U                    else ?)
     1951         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1952         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1953         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1954         p-type-price   = (if v-use-type-price  then no                      else ?)
     1955         p-type-val     = (if v-use-List_       then no                      else ?)
     1956         .
     1957       end.
     1958     end.
     1959   end procedure.
     1960   procedure uf-set :
     1961     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1962     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1963     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1964     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1965     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1966     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1967     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1968     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1969     do
     1970     on error undo, return error
     1971     :
     1972       define buffer buf_usr-flt for ubflt.usr-flt .
     1973       define variable v-use-List_     as logical   no-undo .
     1974       define variable v-type-List_     as character no-undo .
     1975       define variable v-format-List_   as character no-undo .
     1976       define variable v-use-Naim      as logical   no-undo .
     1977       define variable v-type-Naim      as character no-undo .
     1978       define variable v-format-Naim    as character no-undo .
     1979       define variable v-use-print-graft as logical   no-undo .
     1980       define variable v-use-sort-gr   as logical   no-undo .
     1981       define variable v-use-type-price as logical   no-undo .
     1982       define variable v-use-type-val  as logical   no-undo .
     1983       define variable v-tooltip        as character no-undo .
     1984       define variable v-label          as character no-undo .
     1985       define variable v-user-can-edit  as logical   no-undo .
     1986       define variable v-output-display as logical   no-undo .
     1987       define variable v-other          as character no-undo .
     1988       run uf-name in this-procedure
     1989         (input  entry(1, p-code, chr(4))
     1990         ,output v-use-List_
     1991         ,output v-type-List_
     1992         ,output v-format-List_
     1993         ,output v-use-Naim
     1994         ,output v-type-Naim
     1995         ,output v-format-Naim
     1996         ,output v-use-print-graft
     1997         ,output v-use-sort-gr
     1998         ,output v-use-type-price
     1999         ,output v-use-type-val
     2000         ,output v-label
     2001         ,output v-tooltip
     2002         ,output v-user-can-edit
     2003         ,output v-output-display
     2004         ,output v-other
     2005         ) no-error .
     2006       if error-status :error then do:
     2007         undo, return error return-value .
     2008       end.
     2009       find first buf_usr-flt where
     2010                  buf_usr-flt.Call-point     = p-code AND
     2011                  buf_usr-flt.user-name       = p-user-name
     2012         no-error .
     2013       if not avail buf_usr-flt then do:
     2014           create buf_usr-flt .
     2015           assign
     2016           buf_usr-flt.call-point = p-code
     2017           buf_usr-flt.user-name  = p-user-name
     2018           .
     2019       end.
     2020       if avail buf_usr-flt then do:
     2021        assign
     2022        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     2023        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     2024        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     2025        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     2026        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     2027        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     2028       .
     2029       release buf_usr-flt.
     2030       end.
     2031       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     2032     end.
     2033   end procedure.
     2034   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2035   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2036   function native-string returns character ( input p-string as character
     2037                                             ,input p-data-type as character
     2038                                             ,input p-format as character):
     2039   define variable v-string as character no-undo .
     2040   case p-data-type:
     2041     when 'character':U then do:
     2042       assign
     2043       v-string = string(p-string, p-format)
     2044       no-error .
     2045     end.
     2046     when 'date':U then do:
     2047       assign
     2048       v-string = string(date(p-string), p-format)
     2049       no-error .
     2050     end.
     2051     when 'decimal':U then do:
     2052       assign
     2053       v-string = string(decimal(p-string), p-format)
     2054       no-error .
     2055     end.
     2056     when 'integer':U then do:
     2057       assign
     2058       v-string = string(integer(p-string), p-format)
     2059       no-error .
     2060     end.
     2061     when 'logical':U then do:
     2062       assign
     2063       v-string = string(logical(p-string), p-format)
     2064       no-error .
     2065     end.
     2066   end case.
     2067   return v-string.
     2068   end function.
     2069   FUNCTION gdsreffi_cond-keep-name returns character ( buffer buf_goods for ub.goods):
     2070   define buffer buf_condition-keeping for ub.condition-keeping.
     2071   find first buf_condition-keeping no-lock where
     2072            buf_condition-keeping.cond-keep-code = buf_goods.cond-keep-code no-error.
     2073   IF AVAIL buf_condition-keeping then do:
     2074     return buf_condition-keeping.cond-keep-name.
     2075   end.
     2076   return "[!!Неизвестные УСЛОВИЯ ХРАНЕНИЯ]".
     2077   end function.
     2078   function gdsreffi_prod-grp-name returns character ( buffer buf_goods for ub.goods):
     2079   define buffer buf_clients for ub.clients.
     2080   find first buf_clients no-lock WHERE
     2081             buf_clients.obj-type = buf_goods.prod-type
     2082         and buf_clients.obj-code = buf_goods.prod-code no-error.
     2083   if available buf_clients then do:
     2084     return buf_clients.grp-name.
     2085   end.
     2086   return "[!!Неизвестная группа ПРОИЗВОДИТЕЛЯ]".
     2087   end function.
     2088   function gdsreffi_prod-name returns character ( buffer buf_goods for ub.goods):
     2089   define buffer buf_clients for ub.clients.
     2090   find first buf_clients no-lock WHERE
     2091             buf_clients.obj-type = buf_goods.prod-type
     2092         and buf_clients.obj-code = buf_goods.prod-code no-error.
     2093   if available buf_clients then do:
     2094     return buf_clients.obj-name.
     2095   end.
     2096   return "[!!Неизвестный ПРОИЗВОДИТЕЛЬ]".
     2097   end function.
     2098   function gdsreffi_prt-root-name returns character ( buffer buf_goods for ub.goods):
     2099   define buffer buf_gds-prt for ub.gds-prt.
     2100   find first buf_gds-prt no-lock where
     2101           buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     2102   if available buf_gds-prt then do:
     2103     return buf_gds-prt.node-name.
     2104   end.
     2105   return "[!!Неизвестный корень ШКАЛЫ]".
     2106   end function.
     2107   function gdsreffi_last-inv returns character ( buffer buf_goods for ub.goods
     2108                                                 ,input p-obj-type as character
     2109                                                 ,input p-obj-code as integer  ):
     2110   define variable v-last-inv-date-num as character format "X(45)" no-undo.
     2111   define buffer buf_doc-line for ub.doc-line.
     2112   define buffer buf_trn-doc  for ub.trn-doc.
     2113   find last buf_doc-line no-lock where
     2114             buf_doc-line.artic = buf_goods.artic
     2115         and buf_doc-line.prod-code = buf_goods.prod-code
     2116         and buf_doc-line.prod-type = buf_goods.prod-type
     2117         and buf_doc-line.obj-code = p-obj-code
     2118         and buf_doc-line.obj-type = p-obj-type
     2119         and buf_doc-line.status_ = 'факт':U
     2120         and buf_doc-line.ext-doc-type = 'vt':U no-error.
     2121   if available buf_doc-line then do :
     2122     find first buf_trn-doc no-lock where
     2123                buf_trn-doc.doc-code = buf_doc-line.doc-code no-error.
     2124     if available buf_trn-doc then do :
     2125       assign
     2126         v-last-inv-date-num = string(buf_trn-doc.fact-date) + " № " + buf_trn-doc.doc-code
     2127       .
     2128       return v-last-inv-date-num.
     2129     end.
     2130   end.
     2131   return "[!!Нет инвентаризаций по данному товару]" .
     2132   end function.
