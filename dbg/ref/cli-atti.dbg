      567   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      568   define temp-table tt-attr-property  no-undo
      569   field upper-attr-code as character
      570   field attr-code as character
      571   field table-name as character
      572   field edit-menu-section-num as integer
      573   field attr-label as character
      574   field menu-item-handle as widget-handle
      575   field user-can-edit as logical
      576   field menu-name as character
      577   field parent-handle as handle
      578   index pi is unique primary
      579   table-name
      580   menu-name
      581   upper-attr-code
      582   attr-code
      583   index i-section
      584   edit-menu-section-num
      585   .
      586   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      587   procedure attr-pop-create-items :
      588   define input parameter p-table-name as character no-undo .
      589   define input parameter p-get-section-num-proc-name as character no-undo .
      590   define input parameter p-get-attr-label-proc-name as character no-undo .
      591   define input parameter p-attr-choose-proc-name as character no-undo .
      592   define input parameter p-menu-handle as widget-handle no-undo .
      593   define input parameter p-attr-list as character no-undo .
      594   define variable ii as integer no-undo .
      595   define variable V-CREATED as logical no-undo .
      596   define variable v-tool-tip as character no-undo .
      597   define variable v-dop as character no-undo .
      598   define variable v-attr-item as character no-undo .
      599   define variable p-upper-attr-code as character no-undo .
      600   define buffer buf_tt-attr-property for tt-attr-property.
      601     do
      602     on error undo, return error return-value
      603     :
      604        do ii = 1 to num-entries (p-attr-list):
      605          v-attr-item = entry(ii, p-attr-list) .
      606          find first tt-attr-property where
      607                    tt-attr-property.table-name = p-table-name
      608                and tt-attr-property.attr-code = v-attr-item
      609                and tt-attr-property.upper-attr-code = p-upper-attr-code
      610                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
      611          if not available tt-attr-property then do:
      612            create tt-attr-property.
      613            assign
      614            tt-attr-property.table-name = p-table-name
      615            tt-attr-property.attr-code = v-attr-item
      616            tt-attr-property.upper-attr-code = p-upper-attr-code
      617            tt-attr-property.menu-name = p-menu-handle:name
      618            .
      619            run value ( p-get-section-num-proc-name) (
      620                                                      input tt-attr-property.attr-code
      621                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
      622            run value ( p-get-attr-label-proc-name ) (
      623                                           input tt-attr-property.attr-code
      624                                          ,output v-tool-tip
      625                                          ,output tt-attr-property.attr-label
      626                                         ) no-error .
      627            release tt-attr-property.
      628          end.
      629        end.
      630        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
      631        break
      632        by  tt-attr-property.edit-menu-section-num
      633        by  tt-attr-property.attr-label
      634        :
      635          if tt-attr-property.edit-menu-section-num > 0
      636          then do:
      637             if not valid-handle(tt-attr-property.menu-item-handle) then do:
      638               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
      639               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
      640               then do:
      641                 find first buf_tt-attr-property where
      642                           buf_tt-attr-property.table-name = p-table-name
      643                       and buf_tt-attr-property.menu-name = p-menu-handle:name
      644                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      645                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
      646                 if not available buf_tt-attr-property then do:
      647                   create buf_tt-attr-property.
      648                   assign
      649                   buf_tt-attr-property.table-name = p-table-name
      650                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
      651                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      652                   buf_tt-attr-property.menu-name = p-menu-handle:name
      653                   .
      654                   create sub-menu buf_tt-attr-property.menu-item-handle
      655                   assign
      656                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
      657                   parent = p-menu-handle.
      658                 end.
      659                 create menu-item tt-attr-property.menu-item-handle
      660                 assign
      661                 label = tt-attr-property.attr-label
      662                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
      663                 parent = buf_tt-attr-property.menu-item-handle
      664                 triggers:
      665                   on choose
      666                     persistent run value(p-attr-choose-proc-name + "-2") (
      667                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
      668                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
      669                                                                             ) .
      670                 end triggers.
      671                 assign
      672                 v-created = yes.
      673               end.
      674               else do:
      675                 create menu-item tt-attr-property.menu-item-handle
      676                 assign
      677                 label = tt-attr-property.attr-label
      678                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
      679                 parent = p-menu-handle
      680                 triggers:
      681                   on choose
      682                     persistent run value(p-attr-choose-proc-name) (
      683                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
      684                 end triggers.
      685                 assign
      686                 v-created = yes.
      687               end.
      688             end.
      689             if last-of(tt-attr-property.edit-menu-section-num)
      690               then do:
      691               find first buf_tt-attr-property where
      692                         buf_tt-attr-property.table-name = p-table-name
      693                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
      694                                                            , p-table-name
      695                                                            , tt-attr-property.edit-menu-section-num
      696                                                            , p-menu-handle:name
      697                                                            )
      698                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
      699               if not available buf_tt-attr-property then do:
      700                 create buf_tt-attr-property.
      701                 assign
      702                 buf_tt-attr-property.table-name = p-table-name
      703                 buf_tt-attr-property.edit-menu-section-num =  - 1
      704                 buf_tt-attr-property.menu-name = p-menu-handle:name
      705                 buf_tt-attr-property.upper-attr-code = ''
      706                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
      707                                                             , p-table-name
      708                                                             , tt-attr-property.edit-menu-section-num
      709                                                             , p-menu-handle:name
      710                                                             )
      711                 .
      712                 create menu-item buf_tt-attr-property.menu-item-handle
      713                 assign
      714                 subtype = "rule"
      715                 parent = p-menu-handle
      716                 .
      717               end.
      718             end.
      719          end.
      720        end.
      721        if not v-created then do:
      722           run attr-pop-clean-up in this-procedure ( input p-table-name).
      723        end.
      724     end.
      725   end procedure.
      726   procedure attr-pop-clean-up :
      727   define input parameter p-table-name as character no-undo .
      728     for each tt-attr-property where
      729             tt-attr-property.table-name = p-table-name
      730       and tt-attr-property.edit-menu-section-num > 0:
      731       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      732         delete widget tt-attr-property.menu-item-handle.
      733       end.
      734       delete tt-attr-property.
      735     end.
      736     for each tt-attr-property where
      737              tt-attr-property.table-name = p-table-name
      738          and tt-attr-property.edit-menu-section-num =  - 1:
      739       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      740         delete widget tt-attr-property.menu-item-handle.
      741       end.
      742       delete tt-attr-property.
      743     end.
      744   end procedure.
      745   define variable updated as logical no-undo.
      746   define variable add-option as char no-undo.
      747   define variable temp-doc-rec as recid no-undo.
      748   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      749   DEFINE MENU MENU-b-ins .
      750   DEFINE BUTTON b-add
      751        LABEL "&Добавить":L
      752        SIZE 10 BY 1 TOOLTIP "Добавить атрибут клиента".
      753   DEFINE BUTTON b-chg
      754        LABEL "&Изменить":L
      755        SIZE 10 BY 1 TOOLTIP "Изменить атрибут клиента".
      756   DEFINE BUTTON b-del
      757        LABEL "&Удалить":L
      758        SIZE 10 BY 1 TOOLTIP "Удалить  атрибут клиента".
      759   DEFINE BUTTON B-exit AUTO-GO
      760        LABEL "&Ввод"
      761        SIZE 10 BY 1.
      762   DEFINE BUTTON b-help
      763        LABEL "Помо&щь":L
      764        SIZE 3 BY 1.
      765   DEFINE BUTTON b-quit AUTO-END-KEY
      766        LABEL "&Отмена":L
      767        SIZE 10 BY 1 TOOLTIP "Выход из режима".
      768   DEFINE VARIABLE clients-code AS INTEGER FORMAT ">>>>>>>>>":U INITIAL 0
      769         VIEW-AS TEXT
      770        SIZE 9.6 BY 1
      771        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      772   DEFINE VARIABLE clients-name AS CHARACTER FORMAT "X(60)":U
      773         VIEW-AS TEXT
      774        SIZE 46.8 BY 1
      775        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      776   DEFINE VARIABLE clients-type AS CHARACTER FORMAT "X(3)":U
      777         VIEW-AS TEXT
      778        SIZE 3.8 BY 1
      779        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      780   DEFINE QUERY BR-attr FOR
      781         Temp-hattr SCROLLING.
      782   DEFINE BROWSE BR-attr
      783     QUERY BR-attr DISPLAY
      784         Temp-hattr.attr-code COLUMN-LABEL "Атрибут" FORMAT "X(255)":U WIDTH 50
      785         Temp-hattr.attr-value COLUMN-LABEL "Значение" FORMAT "X(255)":U WIDTH 48
      786       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.33.
      787   DEFINE FRAME Dialog-Frame
      788        B-exit AT ROW 1 COL 1
      789        b-quit AT ROW 1 COL 11
      790        b-add AT ROW 1 COL 21
      791        b-chg AT ROW 1 COL 31
      792        b-del AT ROW 1 COL 41
      793        b-help AT ROW 1 COL 95
      794        BR-attr AT ROW 4.47 COL 1
      795        clients-type AT ROW 3.3 COL 19 NO-LABEL
      796        clients-code AT ROW 3.3 COL 23.4 NO-LABEL
      797        clients-name AT ROW 3.3 COL 33.8 NO-LABEL
      798        SPACE(18.49) SKIP(15.66)
      799       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      800            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      801            TITLE "Атрибуты клиента".
      802   ASSIGN
      803          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      804          FRAME Dialog-Frame:HIDDEN           = TRUE.
      805   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      806   DO:
      807     APPLY "END-ERROR":U TO SELF.
      808   END.
      809   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      810   DO:
      811   define variable attr-type as character no-undo .
      812   define variable attr-format as character no-undo .
      813   define variable attr-label as character no-undo .
      814   define variable attr-user-can-edit as logical no-undo .
      815   define variable attr-output-display as logical no-undo .
      816   define variable attr-other as char no-undo .
      817   define variable loc#log as logical no-undo.
      818   define buffer buf_temp-hattr for temp-hattr.
      819   if add-option = "" then do:
      820     run gbl/pop-up.p ( input self:handle, input no) no-error.
      821   end.
      822   if add-option = "":U then return no-apply.
      823   run proc-add-chg in this-procedure ( input yes) no-error .
      824   if error-status:error then do:
      825     add-option = "":U.
      826     return no-apply.
      827   end.
      828   OPEN QUERY BR-attr FOR EACH Temp-hattr NO-LOCK WHERE temp-hattr.output-display = YES     BY Temp-hattr.attr-code.
      829   find first buf_temp-hattr no-lock where
      830                           buf_temp-hattr.code = add-option no-error.
      831   add-option = "":U.
      832   if avail buf_temp-hattr then
      833       temp-doc-rec = recid(buf_temp-hattr).
      834       else temp-doc-rec = ?.
      835   reposition BR-attr to recid temp-doc-rec no-error.
      836   if error-status:error then return no-apply.
      837   END.
      838   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      839   DO:
      840     if not avail temp-hattr then return no-apply.
      841     run proc-add-chg in this-procedure ( input no ) no-error.
      842     if error-status:error then return no-apply.
      843   END.
      844   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      845   DO:
      846   define variable loc#log as logical no-undo.
      847   define variable attr-type as character no-undo .
      848   define variable attr-format as character no-undo .
      849   define variable attr-label as character no-undo .
      850   define variable attr-user-can-edit as logical no-undo .
      851   define variable attr-output-display as logical no-undo .
      852   define variable attr-other as char no-undo .
      853   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      854     if not avail temp-hattr then return no-apply.
      855     run clntattr-code in this-procedure (
      856                                           input  temp-hattr.code
      857                                           ,output attr-type
      858                                           ,output attr-format
      859                                           ,output attr-label
      860                                           ,output attr-user-can-edit
      861                                           ,output attr-output-display
      862                                           ,output attr-other
      863                                           ) .
      864     if not attr-user-can-edit then do:
      865       message
      866       "Атрибут нельзя удалить вручную"
      867       view-as alert-box error .
      868       return no-apply.
      869     end.
      870     glog = no.
      871     message
      872     "Вы уверены, что хотите удалить атрибут " temp-hattr.attr-code skip
      873     " для клиента " clients-name
      874     view-as alert-box QUESTIOn buttons YES-NO update glog.
      875     if NOT glog then return no-apply.
      876       DELETE temp-hattr.
      877       updated = yes.
      878      OPEN QUERY BR-attr FOR EACH Temp-hattr NO-LOCK WHERE temp-hattr.output-display = YES     BY Temp-hattr.attr-code.
      879   END.
      880   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      881   DO:
      882      RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      883     IF ERROR-STATUS:ERROR THEN DO:
      884        RETURN NO-APPLY.
      885     END.
      886   END.
      887   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      888   DO:
      889   END.
      890   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      891   on help of frame Dialog-Frame
      892   do:
      893     run gbl/app_help.p
      894       (input this-procedure :file-name
      895       ,input ''
      896       ,input ?
      897       ) no-error.
      898     if error-status :error then do:
      899       message
      900         "Ошибка при вызове помощи"
      901         error-status :get-message(1)
      902         view-as alert-box .
      903     end.
      904   end.
      905   run minbtn-set in this-procedure .
      906   on choose of b-help in frame Dialog-Frame
      907   do:
      908     apply "help":u to frame Dialog-Frame .
      909   end.
      910   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911   procedure minbtn-set :
      912       do
      913           on error undo, return error return-value
      914           :
      915           define variable ii              as integer       no-undo .
      916           define variable fh              as widget-handle no-undo .
      917           define variable hh              as widget-handle no-undo .
      918           define variable v-h             as handle        extent 4 no-undo .
      919           define variable v-name-button   as character     no-undo .
      920           define variable v-help-old-x    as decimal       no-undo .
      921           define variable v-help-old-y    as decimal       no-undo .
      922           define variable v-help-old-size as decimal       no-undo .
      923           define variable v-frame-width   as decimal       no-undo .
      924           define variable jj              as integer       no-undo .
      925           do
      926               on error undo, return error
      927               :
      928               assign
      929                   v-frame-width = frame Dialog-Frame:width - 0.3
      930                   fh            = frame Dialog-Frame:first-child
      931                   hh            = fh:first-child
      932                   ii            = 1
      933                   .
      934               do while valid-handle(hh):
      935                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      936                   do:
      937                       case lc(hh:name) :
      938                           when "b-help" then
      939                               do:
      940                                   hh:load-image-up("cmp/b-help.bmp":u) .
      941                                   hh:load-image-down("cmp/b-help.bmp":u) .
      942                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      943                                   hh:TOOLTIP = "Помощь" .
      944                                   v-help-old-x = hh:column .
      945                                   v-help-old-y = hh:row    .
      946                                   v-help-old-size = hh:width .
      947                                   hh:width-chars = 2.5 .
      948                               end.
      949                           when "b-print" then
      950                               do:
      951                                   hh:load-image("cmp/b-print.bmp":u) .
      952                                   hh:TOOLTIP = "Печать" .
      953                                   v-h[ii] = hh:handle .
      954                                   ii = ii + 1 .
      955                                   hh:width-chars = 3 .
      956                               end.
      957                           when "b-history" or
      958                           when "b-hist" then
      959                               do:
      960                                   hh:load-image("cmp/b-hist.bmp":u) .
      961                                   hh:TOOLTIP = "История" .
      962                                   v-h[ii] = hh:handle .
      963                                   ii = ii + 1 .
      964                                   hh:width-chars = 3 .
      965                               end.
      966                           when "b-sch" then
      967                               do:
      968                                   hh:load-image("cmp/b-sch.bmp":u) .
      969                                   hh:TOOLTIP = "Установка Фильтра" .
      970                                   v-h[ii] = hh:handle .
      971                                   ii = ii + 1 .
      972                                   hh:width-chars = 3 .
      973                               end.
      974                           when "b-hist-user" then
      975                               do:
      976                                   hh:load-image("cmp/b-hist.bmp":u) .
      977                                   hh:TOOLTIP = "История пользователя" .
      978                                   ii = ii + 1 .
      979                               end.
      980                       end case.
      981                   end.
      982                   hh = hh:next-sibling.
      983               end.
      984               b-help:column = v-frame-width - b-help:width-chars.
      985               jj = 0.
      986               repeat ii = 4 to 1 by -1 :
      987                   if valid-handle (v-h[ii] ) then
      988                   do:
      989                       jj  = jj + 1 .
      990                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      991                       v-h[ii]:row    = v-help-old-y .
      992                   end.
      993               end.
      994           end.
      995       end.
      996   end procedure.
      997   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      998   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      999   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1000   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1001   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1002   define variable v-diasize-current-frame-height as decimal   no-undo .
     1003   define variable v-diasize-change-size          as logical   no-undo .
     1004   define variable v-diasize-resize-button        as handle    no-undo .
     1005   define variable v-diasize-wndmax               as logical   no-undo .
     1006   define variable v-diasize-wndstore             as logical   no-undo .
     1007   define variable v-diasize-proc-name            as character no-undo .
     1008   define variable v-diasize-browse-handle        as handle    no-undo .
     1009   define variable v-diasize-browse-number        as integer   no-undo .
     1010   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1011   define temp-table temp-diasize-handle no-undo
     1012     field handle-value  as handle
     1013     field save-position as decimal
     1014     index xpk is primary unique handle-value
     1015     .
     1016   define temp-table temp-browse-handle no-undo
     1017     field browse-type   as character
     1018     field browse-number as integer
     1019     field browse-handle as handle
     1020     field original-size as decimal
     1021     index xpk is primary unique browse-type browse-number
     1022     index xie browse-type browse-handle
     1023   .
     1024   procedure diasize_change-height :
     1025     define input  parameter p-change-value  as decimal   no-undo .
     1026     define input  parameter p-move-resize   as logical   no-undo .
     1027     define variable v-field-group-handle    as handle    no-undo .
     1028     define variable v-object-handle         as handle    no-undo .
     1029     define variable v-frame-height          as decimal   no-undo .
     1030     define variable v-frame-virtual-height  as decimal   no-undo .
     1031     define variable v-browse-height         as decimal   no-undo .
     1032     define variable v-window-height         as decimal   no-undo .
     1033     define variable v-window-virtual-height as decimal   no-undo .
     1034     define variable v-change-sign           as integer   no-undo .
     1035     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1036     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1037     if p-change-value > 0
     1038     then do:
     1039       if frame Dialog-Frame :height + p-change-value
     1040           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1041       then do:
     1042         assign
     1043           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1044                           - (frame Dialog-Frame :height-chars)
     1045         .
     1046         if p-change-value <= 0
     1047         then do:
     1048           run diasize_position-resize-button in this-procedure .
     1049           return .
     1050         end.
     1051       end.
     1052     end.
     1053     if p-change-value < 0
     1054     then do:
     1055       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1056       then do:
     1057         assign
     1058           p-change-value = v-diasize-orig-frame-height
     1059                          - (frame Dialog-Frame :height-chars)
     1060         .
     1061         if p-change-value >= 0
     1062         then do:
     1063           run diasize_position-resize-button in this-procedure .
     1064           return .
     1065         end.
     1066       end.
     1067     end.
     1068     if p-change-value >= 0
     1069     then do:
     1070       assign
     1071         v-change-sign = 1
     1072       .
     1073     end.
     1074     else do:
     1075       assign
     1076         v-change-sign = -1
     1077       .
     1078     end.
     1079     assign
     1080       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1081     .
     1082     if p-change-value = 0
     1083     then do:
     1084       run diasize_position-resize-button in this-procedure .
     1085       return .
     1086     end.
     1087     move_block:
     1088     do
     1089     on error undo move_block, retry move_block
     1090     :
     1091       if retry
     1092       then do:
     1093         do
     1094         on error undo move_block, leave move_block
     1095         :
     1096           if p-change-value > 0
     1097           then do:
     1098             for each buf_temp-diasize-handle
     1099             on error undo, next
     1100             :
     1101               assign
     1102                 v-object-handle = buf_temp-diasize-handle.handle-value
     1103               .
     1104               if v-object-handle <> v-diasize-resize-button
     1105               then do:
     1106                 assign
     1107                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1108                 .
     1109               end.
     1110             end.
     1111             assign
     1112               v-diasize-browse-handle :height = v-browse-height
     1113             .
     1114             for each buf_temp-browse-handle
     1115               where buf_temp-browse-handle.browse-type = 'height':u
     1116             on error undo, next
     1117             :
     1118               assign
     1119                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1120               .
     1121             end.
     1122             assign
     1123               frame Dialog-Frame :height = v-frame-height
     1124             .
     1125             if frame Dialog-Frame :scrollable = true
     1126             then do:
     1127               assign
     1128                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1129               .
     1130             end.
     1131             run diasize_position-resize-button in this-procedure .
     1132           end.
     1133           else do:
     1134             if frame Dialog-Frame :scrollable = true
     1135             then do:
     1136               assign
     1137                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1138               .
     1139             end.
     1140             assign
     1141               frame Dialog-Frame :height = v-frame-height
     1142             .
     1143             assign
     1144               v-diasize-browse-handle :height = v-browse-height
     1145             .
     1146             for each buf_temp-browse-handle
     1147               where buf_temp-browse-handle.browse-type = 'height':u
     1148             on error undo, next
     1149             :
     1150               assign
     1151                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1152               .
     1153             end.
     1154             for each buf_temp-diasize-handle
     1155             on error undo, next
     1156             :
     1157               assign
     1158                 v-object-handle = buf_temp-diasize-handle.handle-value
     1159               .
     1160               if v-object-handle <> v-diasize-resize-button
     1161               then do:
     1162                 assign
     1163                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1164                 .
     1165               end.
     1166             end.
     1167             run diasize_position-resize-button in this-procedure .
     1168           end.
     1169           assign
     1170             v-diasize-change-size = false
     1171           .
     1172           leave move_block .
     1173         end.
     1174       end.
     1175       assign
     1176         v-diasize-need-full-display = true
     1177       .
     1178       if v-diasize-change-size = false
     1179       then do:
     1180         assign
     1181           v-diasize-change-size = true
     1182         .
     1183       end.
     1184       else do:
     1185         return .
     1186       end.
     1187       assign
     1188         v-frame-height = frame Dialog-Frame :height
     1189         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1190         v-browse-height = v-diasize-browse-handle :height
     1191       .
     1192       for each buf_temp-browse-handle
     1193         where buf_temp-browse-handle.browse-type = 'height':u
     1194       :
     1195         assign
     1196           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1197         .
     1198       end.
     1199       for each buf_temp-diasize-handle
     1200       :
     1201         delete buf_temp-diasize-handle .
     1202       end.
     1203       assign
     1204         v-field-group-handle = frame Dialog-Frame :first-child
     1205       .
     1206       do while valid-handle(v-field-group-handle)
     1207       :
     1208         assign
     1209           v-object-handle = v-field-group-handle :first-child
     1210         .
     1211         do while valid-handle(v-object-handle)
     1212         :
     1213           if  v-object-handle <> v-diasize-browse-handle :handle
     1214           and can-query(v-object-handle, "row")
     1215           and can-query(v-object-handle, "height")
     1216           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1217           then do:
     1218             find first buf_temp-browse-handle
     1219               where buf_temp-browse-handle.browse-type   = 'height':u
     1220                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1221               no-error .
     1222             if available buf_temp-browse-handle
     1223             then do:
     1224             end.
     1225             else do:
     1226               create buf_temp-diasize-handle .
     1227               assign
     1228                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1229                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1230               .
     1231             end.
     1232           end.
     1233           assign
     1234             v-object-handle = v-object-handle :next-sibling
     1235           .
     1236         end.
     1237         assign
     1238           v-field-group-handle = v-field-group-handle :next-sibling
     1239         .
     1240       end.
     1241       do with frame Dialog-Frame
     1242       :
     1243         hide v-diasize-resize-button .
     1244         assign
     1245           v-diasize-resize-button :row    = 1
     1246           v-diasize-resize-button :column = 1
     1247         .
     1248       end.
     1249       if p-change-value > 0
     1250       then do:
     1251         if frame Dialog-Frame :scrollable = true
     1252         then do:
     1253           assign
     1254             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1255             no-error .
     1256           if error-status :error
     1257           or error-status :get-message(1) <> ""
     1258           then do:
     1259             undo move_block, retry move_block .
     1260           end.
     1261         end.
     1262         assign
     1263           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1264           no-error .
     1265         if error-status :error
     1266         or error-status :get-message(1) <> ""
     1267         then do:
     1268           undo move_block, retry move_block .
     1269         end.
     1270         assign
     1271           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1272           no-error .
     1273         if error-status :error
     1274         or error-status :get-message(1) <> ""
     1275         then do:
     1276           undo move_block, retry move_block .
     1277         end.
     1278         for each buf_temp-browse-handle
     1279           where buf_temp-browse-handle.browse-type = 'height':u
     1280         on error undo move_block, retry move_block
     1281         :
     1282           assign
     1283             buf_temp-browse-handle.browse-handle :height
     1284               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1285             no-error .
     1286           if error-status :error
     1287           or error-status :get-message(1) <> ""
     1288           then do:
     1289             undo move_block, retry move_block .
     1290           end.
     1291         end.
     1292         for each buf_temp-diasize-handle
     1293         on error undo move_block, retry move_block
     1294         :
     1295           assign
     1296             v-object-handle = buf_temp-diasize-handle.handle-value
     1297           .
     1298           if v-object-handle <> v-diasize-resize-button
     1299           then do:
     1300             assign
     1301               v-object-handle :row = v-object-handle :row + p-change-value
     1302               no-error .
     1303             if error-status :error
     1304             or error-status :get-message(1) <> ""
     1305             then do:
     1306               undo move_block, retry move_block .
     1307             end.
     1308           end.
     1309         end.
     1310       end.
     1311       else do:
     1312         for each buf_temp-diasize-handle
     1313         on error undo move_block, retry move_block
     1314         :
     1315           assign
     1316             v-object-handle = buf_temp-diasize-handle.handle-value
     1317           .
     1318           if v-object-handle <> v-diasize-resize-button
     1319           then do:
     1320             assign
     1321               v-object-handle :row = v-object-handle :row + p-change-value
     1322               no-error .
     1323             if error-status :error
     1324             or error-status :get-message(1) <> ""
     1325             then do:
     1326               undo move_block, retry move_block .
     1327             end.
     1328           end.
     1329         end.
     1330         assign
     1331           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1332           no-error .
     1333         if error-status :error
     1334         or error-status :get-message(1) <> ""
     1335         then do:
     1336           undo move_block, retry move_block .
     1337         end.
     1338         for each buf_temp-browse-handle
     1339           where buf_temp-browse-handle.browse-type = 'height':u
     1340         on error undo move_block, retry move_block
     1341         :
     1342           assign
     1343             buf_temp-browse-handle.browse-handle :height
     1344               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1345             no-error .
     1346           if error-status :error
     1347           or error-status :get-message(1) <> ""
     1348           then do:
     1349             undo move_block, retry move_block .
     1350           end.
     1351         end.
     1352         assign
     1353           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1354           no-error .
     1355         if error-status :error
     1356         or error-status :get-message(1) <> ""
     1357         then do:
     1358           undo move_block, retry move_block .
     1359         end.
     1360         if frame Dialog-Frame :scrollable = true
     1361         then do:
     1362           assign
     1363             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1364             no-error .
     1365           if error-status :error
     1366           or error-status :get-message(1) <> ""
     1367           then do:
     1368             undo move_block, retry move_block .
     1369           end.
     1370         end.
     1371       end.
     1372       if p-move-resize = true
     1373       then do:
     1374         run diasize_position-resize-button in this-procedure .
     1375       end.
     1376       if v-diasize-wndstore = true
     1377       then do:
     1378         if connected("ub") = true
     1379         then do:
     1380           define variable v-cntxt-db-num        as integer   no-undo .
     1381           define variable v-cntxt-userid        as character no-undo .
     1382           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1383                                             , OUTPUT v-cntxt-userid
     1384                                             ) .
     1385           run gbl/wndsizew.p
     1386             (input  v-cntxt-db-num
     1387             ,input  v-cntxt-userid
     1388             ,input  v-diasize-proc-name
     1389             ,input  'height':u
     1390             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1391             ) .
     1392         end.
     1393       end.
     1394     end.
     1395     assign
     1396       v-diasize-change-size = false
     1397     .
     1398   end procedure.
     1399   procedure diasize_set-height :
     1400     define input  parameter p-new-height  as decimal   no-undo .
     1401     define input  parameter p-move-resize as logical   no-undo .
     1402     do
     1403     on error undo, return error return-value
     1404     :
     1405       run diasize_change-height in this-procedure
     1406         (input  (p-new-height - frame Dialog-Frame :height)
     1407         ,input  p-move-resize
     1408         ) .
     1409     end.
     1410   end procedure.
     1411   procedure diasize_change-width :
     1412     define input  parameter p-change-value as decimal   no-undo .
     1413     define input  parameter p-move-resize  as logical   no-undo .
     1414     define variable v-field-group-handle   as handle    no-undo .
     1415     define variable v-object-handle        as handle    no-undo .
     1416     define variable v-frame-width          as decimal   no-undo .
     1417     define variable v-frame-virtual-width  as decimal   no-undo .
     1418     define variable v-browse-width         as decimal   no-undo .
     1419     define variable v-window-width         as decimal   no-undo .
     1420     define variable v-window-virtual-width as decimal   no-undo .
     1421     define variable v-change-sign          as integer   no-undo .
     1422     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1423     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1424     if p-change-value > 0
     1425     then do:
     1426       if frame Dialog-Frame :width + p-change-value >
     1427           session :width-chars
     1428       then do:
     1429         assign
     1430           p-change-value = session :width-chars - frame Dialog-Frame :width
     1431         .
     1432         if p-change-value <= 0
     1433         then do:
     1434           run diasize_position-resize-button in this-procedure .
     1435           return .
     1436         end.
     1437       end.
     1438     end.
     1439     if p-change-value < 0
     1440     then do:
     1441       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1442       then do:
     1443         assign
     1444           p-change-value = v-diasize-orig-frame-width
     1445                          - frame Dialog-Frame :width
     1446         .
     1447         if p-change-value >= 0
     1448         then do:
     1449           run diasize_position-resize-button in this-procedure .
     1450           return .
     1451         end.
     1452       end.
     1453     end.
     1454     if p-change-value >= 0
     1455     then do:
     1456       assign
     1457         v-change-sign = 1
     1458       .
     1459     end.
     1460     else do:
     1461       assign
     1462         v-change-sign = -1
     1463       .
     1464     end.
     1465     assign
     1466       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1467     .
     1468     if p-change-value = 0
     1469     then do:
     1470       run diasize_position-resize-button in this-procedure .
     1471       return .
     1472     end.
     1473     move_block:
     1474     do
     1475     on error undo move_block, leave move_block
     1476     :
     1477       if retry
     1478       then do:
     1479         do
     1480         on error undo move_block, leave move_block
     1481         :
     1482           if p-change-value > 0
     1483           then do:
     1484             for each buf_temp-diasize-handle
     1485             on error undo, next
     1486             :
     1487               assign
     1488                 v-object-handle = buf_temp-diasize-handle.handle-value
     1489               .
     1490               if v-object-handle <> v-diasize-resize-button
     1491               then do:
     1492                 assign
     1493                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1494                 .
     1495               end.
     1496             end.
     1497             assign
     1498               v-diasize-browse-handle :width = v-browse-width
     1499             .
     1500             for each buf_temp-browse-handle
     1501               where buf_temp-browse-handle.browse-type = 'width':u
     1502             on error undo, next
     1503             :
     1504               assign
     1505                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1506               .
     1507             end.
     1508             assign
     1509               frame Dialog-Frame :width = v-frame-width
     1510             .
     1511             if frame Dialog-Frame :scrollable = true
     1512             then do:
     1513               assign
     1514                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1515               .
     1516             end.
     1517             run diasize_position-resize-button in this-procedure .
     1518           end.
     1519           else do:
     1520             if frame Dialog-Frame :scrollable = true
     1521             then do:
     1522               assign
     1523                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1524               .
     1525             end.
     1526             assign
     1527               frame Dialog-Frame :width = v-frame-width
     1528             .
     1529             for each buf_temp-browse-handle
     1530               where buf_temp-browse-handle.browse-type = 'width':u
     1531             on error undo, next
     1532             :
     1533               assign
     1534                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1535               .
     1536             end.
     1537             assign
     1538               v-diasize-browse-handle :width = v-browse-width
     1539             .
     1540             for each buf_temp-diasize-handle
     1541             on error undo, next
     1542             :
     1543               assign
     1544                 v-object-handle = buf_temp-diasize-handle.handle-value
     1545               .
     1546               if v-object-handle <> v-diasize-resize-button
     1547               then do:
     1548                 assign
     1549                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1550                 .
     1551               end.
     1552             end.
     1553             run diasize_position-resize-button in this-procedure .
     1554           end.
     1555           assign
     1556             v-diasize-change-size = false
     1557           .
     1558           leave move_block .
     1559         end.
     1560       end.
     1561       assign
     1562         v-diasize-need-full-display = true
     1563       .
     1564       if v-diasize-change-size = false
     1565       then do:
     1566         assign
     1567           v-diasize-change-size = true
     1568         .
     1569       end.
     1570       else do:
     1571         return .
     1572       end.
     1573       assign
     1574         v-frame-width = frame Dialog-Frame :width
     1575         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1576         v-browse-width = v-diasize-browse-handle :width
     1577       .
     1578       for each buf_temp-browse-handle
     1579         where buf_temp-browse-handle.browse-type = 'width':u
     1580       :
     1581         assign
     1582           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1583         .
     1584       end.
     1585       for each buf_temp-diasize-handle
     1586       :
     1587         delete buf_temp-diasize-handle .
     1588       end.
     1589       assign
     1590         v-field-group-handle = frame Dialog-Frame :first-child
     1591       .
     1592       do while valid-handle(v-field-group-handle)
     1593       :
     1594         assign
     1595           v-object-handle = v-field-group-handle :first-child
     1596         .
     1597         do while valid-handle(v-object-handle)
     1598         :
     1599           if  v-object-handle <> v-diasize-browse-handle :handle
     1600           and v-object-handle <> v-diasize-resize-button
     1601           and can-query(v-object-handle, "row")
     1602           and can-query(v-object-handle, "height")
     1603           and ( v-object-handle :col + v-object-handle :width
     1604                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1605               )
     1606           then do:
     1607             find first buf_temp-browse-handle
     1608               where buf_temp-browse-handle.browse-type   = 'width':u
     1609                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1610               no-error .
     1611             if available buf_temp-browse-handle
     1612             then do:
     1613             end.
     1614             else do:
     1615               create buf_temp-diasize-handle .
     1616               assign
     1617                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1618                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1619               .
     1620             end.
     1621           end.
     1622           assign
     1623             v-object-handle = v-object-handle :next-sibling
     1624           .
     1625         end.
     1626         assign
     1627           v-field-group-handle = v-field-group-handle :next-sibling
     1628         .
     1629       end.
     1630       do with frame Dialog-Frame
     1631       :
     1632         hide v-diasize-resize-button .
     1633         v-diasize-resize-button :row = 1.
     1634         v-diasize-resize-button :column = 1.
     1635       end.
     1636       if p-change-value > 0
     1637       then do:
     1638         if frame Dialog-Frame :scrollable = true
     1639         then do:
     1640           assign
     1641             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1642             no-error .
     1643           if error-status :error
     1644           or error-status :get-message(1) <> ""
     1645           then do:
     1646             undo move_block, retry move_block.
     1647           end.
     1648         end.
     1649         assign
     1650           frame Dialog-Frame :width = v-frame-width + p-change-value
     1651           no-error .
     1652         if error-status :error
     1653         or error-status :get-message(1) <> ""
     1654         then do:
     1655           undo move_block, retry move_block.
     1656         end.
     1657         assign
     1658           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1659         no-error .
     1660         if error-status :error
     1661         or error-status :get-message(1) <> ""
     1662         then do:
     1663           undo move_block, retry move_block.
     1664         end.
     1665         for each buf_temp-browse-handle
     1666           where buf_temp-browse-handle.browse-type = 'width':u
     1667         on error undo move_block, retry move_block
     1668         :
     1669           assign
     1670             buf_temp-browse-handle.browse-handle :width
     1671               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1672             no-error .
     1673           if error-status :error
     1674           or error-status :get-message(1) <> ""
     1675           then do:
     1676             undo move_block, retry move_block .
     1677           end.
     1678         end.
     1679         for each buf_temp-diasize-handle
     1680         on error undo move_block, retry move_block
     1681         :
     1682           assign
     1683             v-object-handle = buf_temp-diasize-handle.handle-value
     1684           .
     1685           if v-object-handle <> v-diasize-resize-button
     1686           then do:
     1687             assign
     1688               v-object-handle :col = v-object-handle :col + p-change-value
     1689               no-error .
     1690             if error-status :error
     1691             or error-status :get-message(1) <> ""
     1692             then do:
     1693               undo move_block, retry move_block .
     1694             end.
     1695           end.
     1696         end.
     1697       end.
     1698       else do:
     1699         for each buf_temp-diasize-handle
     1700         on error undo move_block, retry move_block
     1701         :
     1702           assign
     1703             v-object-handle = buf_temp-diasize-handle.handle-value
     1704           .
     1705           if v-object-handle <> v-diasize-resize-button
     1706           then do:
     1707             assign
     1708               v-object-handle :col = v-object-handle :col + p-change-value
     1709               no-error .
     1710             if error-status :error
     1711             or error-status :get-message(1) <> ""
     1712             then do:
     1713               undo move_block, retry move_block .
     1714             end.
     1715           end.
     1716         end.
     1717         for each buf_temp-browse-handle
     1718           where buf_temp-browse-handle.browse-type = 'width':u
     1719         on error undo move_block, retry move_block
     1720         :
     1721           assign
     1722             buf_temp-browse-handle.browse-handle :width
     1723               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1724             no-error .
     1725           if error-status :error
     1726           or error-status :get-message(1) <> ""
     1727           then do:
     1728             undo move_block, retry move_block .
     1729           end.
     1730         end.
     1731         assign
     1732           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1733           no-error .
     1734         if error-status :error
     1735         or error-status :get-message(1) <> ""
     1736         then do:
     1737           undo move_block, retry move_block.
     1738         end.
     1739         assign
     1740           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1741         no-error .
     1742         if error-status :error
     1743         or error-status :get-message(1) <> ""
     1744         then do:
     1745           undo move_block, retry move_block.
     1746         end.
     1747         if frame Dialog-Frame :scrollable = true
     1748         then do:
     1749           assign
     1750             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1751           no-error .
     1752           if error-status :error
     1753           or error-status :get-message(1) <> ""
     1754           then do:
     1755             undo move_block, retry move_block.
     1756           end.
     1757         end.
     1758       end.
     1759       if p-move-resize
     1760       then do:
     1761         run diasize_position-resize-button in this-procedure .
     1762       end.
     1763       if v-diasize-wndstore = true
     1764       then do:
     1765         if connected("ub") = true
     1766         then do:
     1767           define variable v-cntxt-db-num        as integer   no-undo .
     1768           define variable v-cntxt-userid        as character no-undo .
     1769           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1770                                             , OUTPUT v-cntxt-userid
     1771                                             ) .
     1772           run gbl/wndsizew.p
     1773             (input  v-cntxt-db-num
     1774             ,input  v-cntxt-userid
     1775             ,input  v-diasize-proc-name
     1776             ,input  'width':u
     1777             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1778             ) .
     1779         end.
     1780       end.
     1781     end.
     1782     assign
     1783       v-diasize-change-size = false
     1784     .
     1785   end procedure.
     1786   procedure diasize_set-width :
     1787     define input  parameter p-new-width  as decimal   no-undo .
     1788     define input  parameter p-move-resize as logical   no-undo .
     1789     do
     1790     on error undo, return error return-value
     1791     :
     1792       run diasize_change-width in this-procedure
     1793         (input  (p-new-width - frame Dialog-Frame :width)
     1794         ,input  p-move-resize
     1795         ) .
     1796     end.
     1797   end procedure.
     1798   procedure diasize_position-resize-button :
     1799     do with frame Dialog-Frame
     1800     :
     1801       hide v-diasize-resize-button .
     1802       assign
     1803         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1804                     - 1
     1805                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1806         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1807                     - 1
     1808                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1809       .
     1810       view v-diasize-resize-button .
     1811     end.
     1812   end procedure.
     1813   on alt-right anywhere
     1814   do:
     1815     run diasize_change-width in this-procedure
     1816       (input 1
     1817       ,input true
     1818       ) .
     1819     return no-apply .
     1820   end.
     1821   on alt-left anywhere
     1822   do:
     1823     run diasize_change-width in this-procedure
     1824       (input -1
     1825       ,input true
     1826       ) .
     1827     return no-apply .
     1828   end.
     1829   on alt-down anywhere
     1830   do:
     1831     run diasize_change-height in this-procedure
     1832       (input 1
     1833       ,input true
     1834       ) .
     1835     return no-apply .
     1836   end.
     1837   on alt-up anywhere
     1838   do:
     1839     run diasize_change-height in this-procedure
     1840       (input -1
     1841       ,input true
     1842       ) .
     1843     return no-apply .
     1844   end.
     1845   on alt-enter of frame Dialog-Frame
     1846   do:
     1847     run diasize_maximize in this-procedure
     1848       (input  ?
     1849       ).
     1850     return no-apply .
     1851   end.
     1852   procedure diasize_end-move :
     1853     do
     1854     on error undo, return error return-value
     1855     :
     1856       define variable v-row-delta as decimal   no-undo .
     1857       define variable v-col-delta as decimal   no-undo .
     1858       define variable v-new-row as decimal   no-undo .
     1859       define variable v-new-col as decimal   no-undo .
     1860       assign
     1861         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1862         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1863       .
     1864       assign
     1865         v-row-delta = v-new-row - frame Dialog-Frame :height
     1866         v-col-delta = v-new-col - frame Dialog-Frame :width
     1867       .
     1868       run diasize_change-height in this-procedure
     1869         (input v-row-delta
     1870         ,input true
     1871         ) .
     1872       run diasize_change-width in this-procedure
     1873         (input v-col-delta
     1874         ,input true
     1875         ) .
     1876     end.
     1877   end procedure.
     1878   procedure diasize_maximize :
     1879     define input  parameter p-action as logical   no-undo .
     1880     do
     1881     on error undo, return error return-value
     1882     :
     1883       if p-action = ?
     1884       then do:
     1885         if v-diasize-need-maximize = true
     1886         then do:
     1887           assign
     1888             p-action = true
     1889           .
     1890         end.
     1891         else do:
     1892           assign
     1893             p-action = false
     1894           .
     1895         end.
     1896       end.
     1897       if p-action = true
     1898       then do:
     1899         run diasize_change-height in this-procedure
     1900           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1901               - frame Dialog-Frame :height-chars
     1902           ,input true
     1903           ) .
     1904         run diasize_change-width in this-procedure
     1905           (input session :width-chars
     1906               - frame Dialog-Frame :width-chars
     1907           ,input true
     1908           ) .
     1909         assign
     1910           v-diasize-need-maximize = false
     1911         .
     1912       end.
     1913       else do:
     1914         run diasize_change-width in this-procedure
     1915           (input v-diasize-orig-frame-width
     1916               - frame Dialog-Frame :width-chars
     1917           ,input true
     1918           ) .
     1919         run diasize_change-height in this-procedure
     1920           (input v-diasize-orig-frame-height
     1921               - frame Dialog-Frame :height-chars
     1922           ,input true
     1923           ) .
     1924         assign
     1925           v-diasize-need-maximize = true
     1926         .
     1927       end.
     1928     end.
     1929   end procedure.
     1930   procedure diasize_restore-orig-size :
     1931     do
     1932     on error undo, return error return-value
     1933     :
     1934       assign
     1935         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1936         v-diasize-current-frame-height = frame Dialog-Frame :height
     1937       .
     1938       run diasize_set-height in this-procedure
     1939         (input  v-diasize-orig-frame-height
     1940         ,input  true
     1941         ) .
     1942       run diasize_set-width in this-procedure
     1943         (input  v-diasize-orig-frame-width
     1944         ,input  true
     1945         ) .
     1946     end.
     1947   end procedure.
     1948   procedure diasize_restore-current-size :
     1949     do
     1950     on error undo, return error return-value
     1951     :
     1952       run diasize_set-height in this-procedure
     1953         (input  v-diasize-current-frame-height
     1954         ,input  true
     1955         ) .
     1956       run diasize_set-width in this-procedure
     1957         (input  v-diasize-current-frame-width
     1958         ,input  true
     1959         ) .
     1960     end.
     1961   end procedure.
     1962   procedure diasize_set-browse-handle :
     1963     define input  parameter p-browse-handle as handle   no-undo .
     1964     define buffer buf_temp-browse-handle for temp-browse-handle .
     1965     do
     1966     on error undo, return error return-value
     1967     :
     1968       assign
     1969         v-diasize-browse-handle = p-browse-handle
     1970       .
     1971       for each buf_temp-browse-handle
     1972       on error undo, return error return-value
     1973       :
     1974         delete buf_temp-browse-handle .
     1975       end.
     1976     end.
     1977   end procedure.
     1978   procedure diasize_add_browse :
     1979     define input  parameter p-browse-type   as character no-undo .
     1980     define input  parameter p-browse-handle as handle    no-undo .
     1981     define buffer buf_temp-browse-handle for temp-browse-handle .
     1982     do
     1983     on error undo, return error return-value
     1984     :
     1985       assign
     1986         v-diasize-browse-number = v-diasize-browse-number + 1
     1987       .
     1988       create buf_temp-browse-handle .
     1989       assign
     1990         buf_temp-browse-handle.browse-type   = p-browse-type
     1991         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1992         buf_temp-browse-handle.browse-handle = p-browse-handle
     1993       .
     1994     end.
     1995   end procedure.
     1996   procedure diasize_init :
     1997     define variable v-default-value    as logical   no-undo .
     1998     define variable v-restore-saved    as logical   no-undo .
     1999     define variable v-resize-value-str as character no-undo .
     2000     do
     2001     on error undo, return error return-value
     2002     :
     2003       do with frame Dialog-Frame
     2004       :
     2005         assign
     2006           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2007           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2008           v-diasize-browse-handle     = browse BR-attr :handle
     2009         .
     2010         create button v-diasize-resize-button
     2011         assign
     2012           parent        = frame Dialog-Frame :first-child
     2013           label         = "s"
     2014           height-pixels = 16
     2015           width-pixels  = 16
     2016           visible       = true
     2017           sensitive     = true
     2018           movable       = true
     2019           triggers:
     2020             on end-move persistent run diasize_end-move in this-procedure .
     2021           end triggers.
     2022         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2023         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2024         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2025         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2026         assign
     2027           v-diasize-wndmax = false
     2028         .
     2029         if connected("ub") = true
     2030         then do:
     2031           define variable v-cntxt-db-num        as integer   no-undo .
     2032           define variable v-cntxt-userid        as character no-undo .
     2033           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2034                                             , OUTPUT v-cntxt-userid
     2035                                             ) .
     2036           run gbl/wndpar_r.p
     2037             (input  v-cntxt-db-num
     2038             ,input  v-cntxt-userid
     2039             ,input  'wndmax':U
     2040             ,output v-diasize-wndmax
     2041             ,output v-default-value
     2042             ) .
     2043         end.
     2044         assign
     2045           v-diasize-wndstore = false
     2046         .
     2047         if connected("ub") = true
     2048         then do:
     2049           run gbl/wndpar_r.p
     2050             (input  v-cntxt-db-num
     2051             ,input  v-cntxt-userid
     2052             ,input  'wndstore':U
     2053             ,output v-diasize-wndstore
     2054             ,output v-default-value
     2055             ) .
     2056         end.
     2057         assign
     2058           v-diasize-proc-name = entry(1, program-name(2), '.')
     2059         .
     2060         if v-diasize-wndstore = true
     2061         then do:
     2062           assign
     2063             v-restore-saved = false
     2064           .
     2065           if connected("ub") = true
     2066           then do:
     2067             run gbl/wndsizer.p
     2068               (input  v-cntxt-db-num
     2069               ,input  v-cntxt-userid
     2070               ,input  v-diasize-proc-name
     2071               ,input  'height':u
     2072               ,output v-resize-value-str
     2073               ) .
     2074             if v-resize-value-str <> '':U
     2075             then do:
     2076               run diasize_change-height in this-procedure
     2077                 (input  integer(v-resize-value-str)
     2078                 ,input  true
     2079                 ) .
     2080               assign
     2081                 v-restore-saved = true
     2082               .
     2083             end.
     2084           end.
     2085           if connected("ub") = true
     2086           then do:
     2087             run gbl/wndsizer.p
     2088               (input  v-cntxt-db-num
     2089               ,input  v-cntxt-userid
     2090               ,input  v-diasize-proc-name
     2091               ,input  'width':u
     2092               ,output v-resize-value-str
     2093               ) .
     2094             if v-resize-value-str <> '':U
     2095             then do:
     2096               run diasize_change-width in this-procedure
     2097                 (input  integer(v-resize-value-str)
     2098                 ,input  true
     2099                 ) .
     2100               assign
     2101                 v-restore-saved = true
     2102               .
     2103             end.
     2104           end.
     2105           if v-restore-saved <> true
     2106           then do:
     2107             if v-diasize-wndmax = true
     2108             then do:
     2109               run diasize_maximize in this-procedure
     2110                 (input  true
     2111                 ) .
     2112             end.
     2113           end.
     2114         end.
     2115         else do:
     2116           if v-diasize-wndmax = true
     2117           then do:
     2118             run diasize_maximize in this-procedure
     2119               (input  true
     2120               ) .
     2121           end.
     2122         end.
     2123       end.
     2124     end.
     2125   end procedure.
     2126   procedure diasize_need-full-display :
     2127     define output parameter p-need-full-display as logical   no-undo .
     2128     do
     2129     on error undo, return error return-value
     2130     :
     2131       assign
     2132         p-need-full-display = v-diasize-need-full-display
     2133       .
     2134       assign
     2135         v-diasize-need-full-display = false
     2136       .
     2137     end.
     2138   end procedure.
     2139   procedure get-context :
     2140      define output parameter p-db-num as integer          no-undo.
     2141      define output parameter p-user-id as character        no-undo.
     2142      define variable v-login               as character    no-undo.
     2143      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2144      define buffer buf_user-login  for ub.user-login .
     2145      do
     2146      on error undo, return error
     2147      :
     2148            FIND FIRST buf_sys-ctrl no-lock.
     2149            ASSIGN
     2150               v-login = USERID("ub")
     2151               p-db-num = buf_sys-ctrl.db-num
     2152            .
     2153            FIND FIRST buf_user-login
     2154                 WHERE buf_user-login.db-num = p-db-num
     2155                   AND buf_user-login.user-login = v-login
     2156                 no-lock
     2157                 no-error
     2158                 .
     2159            IF AVAILABLE buf_user-login
     2160            THEN DO:
     2161               assign
     2162                  p-user-id = buf_user-login.user-id
     2163               .
     2164            END.
     2165      end.
     2166   end procedure.
     2167       run diasize_init in this-procedure .
     2168   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2169   do:
     2170     BR-attr :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2171   end.
     2172   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2173   ON TAB ANYWHERE
     2174   DO:
     2175   define variable ii as integer no-undo .
     2176   define variable fh as widget-handle no-undo .
     2177   define variable hh as widget-handle no-undo .
     2178   define variable v-next-widget-name as character no-undo .
     2179   if v-tab-order <> '' then do:
     2180     if self:type = "TOGGLE-BOX" then
     2181     self:BGCOLOR = ?.
     2182     assign
     2183     ii = lookup(self:name, v-tab-order).
     2184     assign
     2185     ii = ii + 1
     2186     v-next-widget-name = entry(ii, v-tab-order)
     2187     no-error .
     2188     if error-status:error then do:
     2189       assign
     2190       ii = 1
     2191       v-next-widget-name = entry( ii, v-tab-order)
     2192       .
     2193     end.
     2194     assign
     2195     fh = frame Dialog-Frame:first-child
     2196     hh = fh:first-child
     2197     .
     2198     do while valid-handle(hh):
     2199       if hh:name = v-next-widget-name then do:
     2200         if hh:sensitive  = yes
     2201         AND hh:visible = yes then do:
     2202           if hh:type = "TOGGLE-BOX":U then do:
     2203             assign
     2204             hh:BGcolor = 1
     2205             .
     2206           end.
     2207           APPLY "ENTRY" to hh.
     2208           return no-apply.
     2209         end.
     2210         else do:
     2211           APPLY "TAB" to hh.
     2212           return no-apply.
     2213         end.
     2214       end.
     2215       hh = hh:next-sibling.
     2216     end.
     2217   end.
     2218   END.
     2219   ON BACK-TAB ANYWHERE
     2220   DO:
     2221   define variable ii as integer no-undo .
     2222   define variable fh as widget-handle no-undo .
     2223   define variable hh as widget-handle no-undo .
     2224   define variable v-next-widget-name as character no-undo .
     2225   if v-tab-order <> '' then do:
     2226     assign
     2227     ii = lookup(self:name, v-tab-order).
     2228     .
     2229     assign
     2230     ii = (if ii = 1
     2231           then  num-entries(v-tab-order)
     2232           else ii - 1
     2233           )
     2234     v-next-widget-name = entry(ii, v-tab-order)
     2235     .
     2236     assign
     2237     fh = frame Dialog-Frame:first-child
     2238     hh = fh:first-child
     2239     .
     2240     do while valid-handle(hh):
     2241       if hh:name = v-next-widget-name then do:
     2242         if hh:sensitive  = yes
     2243         AND hh:visible = yes then do:
     2244           if hh:type = "TOGGLE-BOX":U then do:
     2245             assign
     2246             hh:BGcolor = 1
     2247             .
     2248           end.
     2249           APPLY "ENTRY" to hh.
     2250           return no-apply.
     2251         end.
     2252         else do:
     2253         APPLY "BACK-TAB" to hh.
     2254         return no-apply.
     2255         end.
     2256       end.
     2257       hh = hh:next-sibling.
     2258     end.
     2259     end.
     2260   END.
     2261   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2262   ON RETURN ANYWHERE
     2263   DO:
     2264   define variable ii as integer no-undo .
     2265   define variable fh as widget-handle no-undo .
     2266   define variable hh as widget-handle no-undo .
     2267   define variable v-next-widget-name as character no-undo .
     2268     if v-tab-order <> '' then do:
     2269       assign
     2270       ii = lookup(self:name, v-tab-order).
     2271       if ii = num-entries(v-tab-order) then do:
     2272           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2273           return no-apply.
     2274       end.
     2275       if self:type <> "BUTTON" and
     2276         self:type <> "EDITOR"  then do:
     2277         run proc-move-forward in this-procedure .
     2278         return no-apply.
     2279       end.
     2280       if self:type = "BUTTON" then do:
     2281         APPLY "CHOOSE" to self.
     2282       end.
     2283       if self:type = "TOGGLE-BOX" then
     2284       self:BGCOLOR = ?.
     2285       assign
     2286       ii = ii + 1
     2287       v-next-widget-name = entry(ii, v-tab-order)
     2288       no-error .
     2289       if error-status:error then do:
     2290         assign
     2291         ii = 1
     2292         v-next-widget-name = entry( ii, v-tab-order)
     2293         .
     2294       end.
     2295       assign
     2296       fh = frame Dialog-Frame:first-child
     2297       hh = fh:first-child
     2298       .
     2299       do while valid-handle(hh):
     2300         if hh:name = v-next-widget-name then do:
     2301           if hh:sensitive  = yes
     2302           AND hh:visible = yes then do:
     2303             if hh:type = "TOGGLE-BOX":U then do:
     2304               assign
     2305               hh:BGcolor = 1
     2306               .
     2307             end.
     2308             APPLY "ENTRY" to hh.
     2309             return no-apply.
     2310           end.
     2311           else do:
     2312             APPLY "TAB" to hh.
     2313             return no-apply.
     2314           end.
     2315         end.
     2316         hh = hh:next-sibling.
     2317       end.
     2318     end.
     2319   END.
     2320   procedure proc-move-forward :
     2321   define variable ii as integer no-undo .
     2322   define variable fh as widget-handle no-undo .
     2323   define variable hh as widget-handle no-undo .
     2324   define variable v-next-widget-name as character no-undo .
     2325   do
     2326   on error undo, return error
     2327   :
     2328     if v-tab-order <> '' then do:
     2329       if self:type = "TOGGLE-BOX" then
     2330       self:BGCOLOR = ?.
     2331       assign
     2332       ii = lookup(self:name, v-tab-order).
     2333       assign
     2334       ii = ii + 1
     2335       v-next-widget-name = entry(ii, v-tab-order)
     2336       no-error .
     2337       if error-status:error then do:
     2338         assign
     2339         ii = 1
     2340         v-next-widget-name = entry( ii, v-tab-order)
     2341         .
     2342       end.
     2343       assign
     2344       fh = frame Dialog-Frame:first-child
     2345       hh = fh:first-child
     2346       .
     2347       do while valid-handle(hh):
     2348         if hh:name = v-next-widget-name then do:
     2349           if hh:sensitive  = yes
     2350           AND hh:visible = yes then do:
     2351             if hh:type = "TOGGLE-BOX":U then do:
     2352               assign
     2353               hh:BGcolor = 1
     2354               .
     2355             end.
     2356             APPLY "ENTRY" to hh.
     2357             return.
     2358           end.
     2359           else do:
     2360             assign
     2361             ii = ii + 1
     2362             v-next-widget-name = entry(ii, v-tab-order)
     2363             no-error .
     2364             if error-status:error then do:
     2365               assign
     2366               ii = 1
     2367               v-next-widget-name = entry( ii, v-tab-order)
     2368               .
     2369             end.
     2370           end.
     2371         end.
     2372         hh = hh:next-sibling.
     2373       end.
     2374     end.
     2375   end.
     2376   end procedure.
     2377   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2378   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2379   MAIN-BLOCK:
     2380   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2381      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2382    if NOT (p-mode = 'ПРОСМОТР':U
     2383           or p-mode = 'ИЗМЕНЕНИЕ':U
     2384           or p-mode = 'ДОБАВЛЕНИЕ':U
     2385           ) then do:
     2386       message
     2387       vss-workfile vss-revision vss-description skip
     2388       "Неверный параметр вызова p-mode" p-mode
     2389       view-as alert-box ERROR.
     2390       return error.
     2391     end.
     2392   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2393     RUN MyEnable in this-procedure .
     2394     Run init-proc in this-procedure .
     2395     WAIT-FOR GO OF FRAME Dialog-Frame.
     2396   END.
     2397   RUN disable_UI in this-procedure .
     2398   run attr-pop-clean-up in this-procedure ( input 'clients-attr':U ).
     2399   if updated then return 'ИЗМЕНЕНИЕ':U.
     2400   PROCEDURE choose-to-edit :
     2401   define input parameter p-attr-code as character no-undo .
     2402   assign
     2403   add-option = p-attr-code
     2404   .
     2405   APPLY "CHOOSE" to b-add in frame Dialog-Frame .
     2406   END PROCEDURE.
     2407   PROCEDURE disable_UI :
     2408     HIDE FRAME Dialog-Frame.
     2409   END PROCEDURE.
     2410   PROCEDURE enable_UI :
     2411     DISPLAY clients-type clients-code clients-name
     2412         WITH FRAME Dialog-Frame.
     2413     ENABLE B-exit b-quit b-add b-chg b-del b-help clients-type clients-code
     2414            clients-name
     2415         WITH FRAME Dialog-Frame.
     2416     VIEW FRAME Dialog-Frame.
     2417     OPEN QUERY BR-attr FOR EACH Temp-hattr NO-LOCK WHERE temp-hattr.output-display = YES     BY Temp-hattr.attr-code.
     2418   END PROCEDURE.
     2419   PROCEDURE init-proc :
     2420   define var  attr-type as character no-undo .
     2421   define var  attr-format as character no-undo .
     2422   define var  attr-label as character no-undo .
     2423   define var  attr-value as character no-undo .
     2424   define var  attr-user-can-edit as logical no-undo .
     2425   define var  attr-output-display as logical no-undo .
     2426   define var  attr-other as char no-undo .
     2427   DEFINE BUFFER buf_clients FOR ub.clients.
     2428   for each  Temp-hattr:
     2429     delete Temp-hattr.
     2430   end.
     2431   add-option = "".
     2432   IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     2433       find first buf_clients where buf_clients.obj-code =  p-obj-code
     2434                      and buf_clients.obj-type =  p-obj-type
     2435           no-lock no-error .
     2436       Assign
     2437           clients-type = buf_clients.obj-type
     2438           clients-code = buf_clients.obj-code
     2439           clients-name = buf_clients.obj-name
     2440           .
     2441     display
     2442     clients-type
     2443     clients-code
     2444     clients-name
     2445     with frame Dialog-Frame  .
     2446   END.
     2447      For each tt0-clients-attr where
     2448               tt0-clients-attr.obj-code = p-obj-code and
     2449               tt0-clients-attr.obj-type  = p-obj-type
     2450               no-lock :
     2451       run clntattr-code in this-procedure (
     2452                                             input tt0-clients-attr.attr-code
     2453                                             ,output attr-type
     2454                                             ,output attr-format
     2455                                             ,output attr-label
     2456                                             ,output attr-user-can-edit
     2457                                             ,output attr-output-display
     2458                                             ,output attr-other ).
     2459       run clntattr-value in this-procedure (
     2460                             input tt0-clients-attr.obj-type
     2461                           ,input tt0-clients-attr.obj-code
     2462                           ,input tt0-clients-attr.attr-code
     2463                           ,output attr-value
     2464                           ,output attr-type ).
     2465         create Temp-hattr.
     2466         assign
     2467         Temp-hattr.obj-type = tt0-clients-attr.obj-type
     2468         Temp-hattr.obj-code = tt0-clients-attr.obj-code
     2469         Temp-hattr.attr-code = (if attr-output-display
     2470                                 then attr-label
     2471                                 else tt0-clients-attr.attr-code)
     2472         temp-hattr.value_ = attr-value
     2473         Temp-hattr.attr-value = (if attr-type = 'L':U
     2474                                 then string(attr-value = "yes":U, attr-format)
     2475                                 else attr-value)
     2476         Temp-hattr.user-can-edit = attr-user-can-edit
     2477         Temp-hattr.output-display = attr-output-display
     2478         Temp-hattr.code = tt0-clients-attr.attr-code
     2479         .
     2480       End.
     2481       OPEN QUERY BR-attr FOR EACH Temp-hattr NO-LOCK WHERE temp-hattr.output-display = YES     BY Temp-hattr.attr-code.
     2482   END PROCEDURE.
     2483   PROCEDURE MyEnable :
     2484   ASSIGN
     2485   b-add:POPUP-MENU IN FRAME Dialog-Frame  = MENU MENU-b-ins:HANDLE
     2486   b-add:MENU-MOUSE = 1
     2487   Temp-hattr.attr-code:RESIZABLE IN BROWSE br-attr = YES
     2488   Temp-hattr.attr-value:RESIZABLE IN BROWSE br-attr = YES
     2489   .
     2490   assign
     2491   v-tab-order = "b-exit,b-quit,b-add,b-chg,b-del,b-help,br-attr".
     2492   if p-mode <> 'ПРОСМОТР':U then do:
     2493     run attr-pop-create-items in this-procedure  (
     2494                                                    input 'clients-attr':U
     2495                                                   ,input 'clntattr-manual-edit'
     2496                                                   ,input 'clntattr-tooltip'
     2497                                                   ,input 'choose-to-edit'
     2498                                                   ,input menu menu-b-ins:handle
     2499                                                   ,input 'doc-start,arh-detail,arh-start,ahsp-detail,ahsp-start,aht-detail,aht-start,arh-del,ahsp-del,aht-del,arh-calc,ahsp-calc,aht-calc,arh-recalc,ahsp-recalc,aht-recalc,is-inkassator,shftrep2,db,is-superviser,purch-code,als-gds,alien,envd,kpp,pharm,upd-date-time,holdfirm-code,vat-register,bge-incr-last-shift-date,bge-incr-last-shift-num,bge-sap-sng-last-shift,egrip-date,egrip-num,cli-local,cli-alc-producer,region-code,foreign-producer,main-accholder,not-corr-op,veto-man-doc,requisite-alc-decl,division-code,supp-np,own-supp,supp-lgas,tank-farm-for,NPZ,auto-tank-for,code-KSK,code-AIS,owner-code,cli-for-close-fo,cli-clim-grp,cli-decommissioned,exp-isPM-last-date':U
     2500                                                 ).
     2501   end.
     2502   ENABLE
     2503   b-exit when p-mode <> 'ПРОСМОТР':U
     2504   b-quit
     2505   b-del when p-mode <> 'ПРОСМОТР':U
     2506   b-add when p-mode <> 'ПРОСМОТР':U
     2507   b-chg when p-mode <> 'ПРОСМОТР':U
     2508   b-help BR-attr
     2509   WITH FRAME Dialog-Frame .
     2510   VIEW FRAME Dialog-Frame .
     2511   OPEN QUERY BR-attr FOR EACH Temp-hattr NO-LOCK WHERE temp-hattr.output-display = YES     BY Temp-hattr.attr-code.
     2512    if p-mode = 'ПРОСМОТР':U then do:
     2513       hide
     2514       b-exit
     2515       in frame Dialog-Frame .
     2516       assign
     2517       b-quit:label = "&Выход"
     2518       b-quit:col    = 1
     2519       .
     2520     end.
     2521   END PROCEDURE.
     2522   PROCEDURE proc-add-chg :
     2523   define input parameter p-add as logical no-undo .
     2524   define variable attr-type as character no-undo .
     2525   define variable attr-format as character no-undo .
     2526   define variable attr-label as character no-undo .
     2527   define variable attr-user-can-edit as logical no-undo .
     2528   define variable attr-output-display as logical no-undo .
     2529   define variable attr-other as char no-undo .
     2530   define variable attr-value as character no-undo .
     2531   define variable v-attr-value as character no-undo .
     2532   define variable v-init as character no-undo .
     2533   define var loc#log as logical no-undo.
     2534   DEFINE VARIABLE v-spr as character no-undo .
     2535   DEFINE VARIABLE v-setted as logical no-undo .
     2536   define variable jj as integer no-undo .
     2537   case p-add:
     2538     when yes then do:
     2539       run temp-clntattr-exist in this-procedure (
     2540                                                   input p-obj-type
     2541                                                   ,input p-obj-code
     2542                                                   ,input add-option
     2543                                                   ,output loc#log)  no-error.
     2544       if error-status:error or loc#log then return error.
     2545       run clntattr-code in this-procedure (
     2546                                             input  add-option
     2547                                             ,output attr-type
     2548                                             ,output attr-format
     2549                                             ,output attr-label
     2550                                             ,output attr-user-can-edit
     2551                                             ,output attr-output-display
     2552                                             ,output attr-other
     2553                                             ) no-error .
     2554       if error-status :error then do:
     2555         return error .
     2556       end.
     2557       CASE attr-type:
     2558         when 'L':U then do:
     2559           assign
     2560           v-attr-value = "yes":U
     2561           .
     2562         end.
     2563         when 'I':U or when 'D':U then do:
     2564           assign
     2565           v-attr-value = if v-init <> "":U
     2566                         then attr-value
     2567                         else string(0)
     2568           .
     2569         end.
     2570         when 'T':U then do:
     2571           assign
     2572           v-attr-value = ?
     2573           .
     2574         end.
     2575         when 'C':U then do:
     2576           assign
     2577           v-attr-value = if v-init <> "":U
     2578                         then attr-value
     2579                         else "":U
     2580           .
     2581         end.
     2582       END CASE.
     2583       assign
     2584       attr-value = v-attr-value
     2585       .
     2586     end.
     2587     when no then do:
     2588       run clntattr-code in this-procedure (
     2589                                             input TEMP-hattr.code
     2590                                             ,output attr-type
     2591                                             ,output attr-format
     2592                                             ,output attr-label
     2593                                             ,output attr-user-can-edit
     2594                                             ,output attr-output-display
     2595                                             ,output attr-other) no-error.
     2596       IF ERROR-STATUS:ERROR THEN DO:
     2597           message "Ошибка при определении названия и типа атрибута клиента!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2598           return error.
     2599       END.
     2600       assign
     2601       attr-value = temp-hattr.value_
     2602       .
     2603     end.
     2604   END CASE.
     2605   IF attr-user-can-edit Then DO:
     2606     do jj = 1 to num-entries(attr-other, chr(47)):
     2607       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr":U
     2608       then do:
     2609         assign
     2610         v-spr = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2611         .
     2612       end.
     2613     end.
     2614   if v-spr = "":u then do:
     2615     run gbl/d-prompt.w (
     2616       'title=':u + "Изменение атрибута клиента" + '\':u
     2617     + 'text1=':u + attr-label + '\':u
     2618     + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     2619     + 'type=' + attr-type + '\':u
     2620     + 'fillin_row=2\':u
     2621     + 'fillin_col=4\':u
     2622     + 'fillin_width=20\':u
     2623     + 'fillin_height=1\':u
     2624     + 'max-chars=70\':u
     2625     + 'readonly=' + (if p-mode = 'ПРОСМОТР':U then 'yes':u else 'no':u) + '\':u
     2626     , input-output attr-value
     2627         ).
     2628     if return-value = 'false':u then return error.
     2629   end.
     2630   else do:
     2631     run  value(v-spr) in this-procedure (
     2632                                          input p-obj-type
     2633                                         ,input p-obj-code
     2634                                         ,input-output attr-value
     2635                                         ,output v-setted) no-error .
     2636     if not v-setted then return error.
     2637   end.
     2638     run temp-clntattr-write in this-procedure (
     2639                                       input p-obj-type
     2640                                       ,input p-obj-code
     2641                                       ,input (if p-add then add-option else temp-hattr.code)
     2642                                       ,input attr-value
     2643                                      ) no-error .
     2644     IF NOT error-status:error then do:
     2645         assign
     2646         updated = yes
     2647         .
     2648         br-attr:refresh() in frame Dialog-Frame no-error .
     2649     END.
     2650   End.
     2651   Else message "Изменение атрибута невозможно !" view-as alert-box error.
     2652   END PROCEDURE.
     2653   PROCEDURE proc-save :
     2654   DEFINE VARIABLE v-updated AS LOGICAL NO-UNDO.
     2655   define variable v-created as logical no-undo .
     2656   define variable v-deleted as logical no-undo .
     2657   define variable v-updated-str as character no-undo .
     2658   define variable v-type as character no-undo .
     2659   for each temp-hattr NO-LOCK where
     2660          temp-hattr.obj-type = p-obj-type
     2661      AND temp-hattr.obj-code = p-obj-code :
     2662     if temp-hattr.output-display = no then next.
     2663      find first tt0-clients-attr NO-LOCK WHERE
     2664             tt0-clients-attr.obj-type = temp-hattr.obj-type
     2665       AND   tt0-clients-attr.obj-code = temp-hattr.obj-code
     2666       AND   tt0-clients-attr.attr-code = temp-hattr.code no-error.
     2667     assign
     2668     v-updated = no.
     2669     if available  tt0-clients-attr then do:
     2670       BUFFER-COMPARE temp-hattr
     2671                   TO tt0-clients-attr
     2672                   case-sensitive
     2673                   SAVE result IN v-updated-str.
     2674       assign
     2675       v-created = yes
     2676       v-updated = (v-updated-str <> "":U)
     2677       .
     2678     end.
     2679     else do:
     2680       assign
     2681       v-updated = yes.
     2682     end.
     2683     if v-updated then do:
     2684       run tt0-clntattr-write in this-procedure (
     2685                                        input p-obj-type
     2686                                       ,input p-obj-code
     2687                                       ,input temp-hattr.code
     2688                                       ,input temp-hattr.value_)  no-error.
     2689       if error-status:error then do:
     2690         message
     2691         "Ошибка при сохранении атрибута клиента" skip
     2692         "тип" p-obj-type SKIP
     2693         "код" p-obj-code SKIP
     2694         "Атрибут" temp-hattr.attr-code skip
     2695         error-status:get-message(1) skip
     2696         return-value
     2697         view-as alert-box  error .
     2698         undo, return error  .
     2699       end.
     2700       updated = yes.
     2701     end.
     2702     ASSIGN
     2703     p-updated = v-updated OR p-updated.
     2704   End.
     2705   FOR EACH tt0-clients-attr where
     2706            tt0-clients-attr.obj-type = p-obj-type
     2707       AND  tt0-clients-attr.obj-code = p-obj-code:
     2708     FIND FIRST temp-hattr NO-LOCK WHERE
     2709               temp-hattr.obj-type = tt0-clients-attr.obj-type
     2710           AND temp-hattr.obj-code = tt0-clients-attr.obj-code
     2711           AND temp-hattr.code = tt0-clients-attr.attr-code NO-ERROR.
     2712       IF NOT AVAILABLE temp-hattr THEN DO:
     2713         DELETE tt0-clients-attr.
     2714         assign
     2715         v-deleted = yes.
     2716         ASSIGN
     2717         p-updated = (v-deleted OR p-updated).
     2718       END.
     2719   END.
     2720   if p-updated
     2721   and p-update-instantly then do:
     2722     run ref/cli-atr1.p (
     2723                        input p-mode
     2724                       ,input p-obj-type
     2725                       ,input p-obj-code
     2726                       ,INPUT table tt0-clients-attr
     2727                       ) no-error .
     2728     if error-status:error then do:
     2729       message
     2730       substitute("Ошибка при сохранении атрибутов клиента:&1&2&1&3"
     2731                  , chr(10)
     2732                  , error-status:get-message(1)
     2733                  , return-value )
     2734       view-as alert-box
     2735       error .
     2736       undo, return error .
     2737     end.
     2738   end.
     2739   END PROCEDURE.
     2740   PROCEDURE temp-clntattr-exist :
     2741     do
     2742     on error undo, return error return-value
     2743     :
     2744       define input parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     2745       define input parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     2746       define input parameter p-code     like ub.clients-attr.attr-code  no-undo .
     2747       define output parameter p-exist   as logical  no-undo .
     2748       define buffer buf_temp-hattr for temp-hattr .
     2749       define variable v-type           as character no-undo .
     2750       define variable v-format         as character no-undo .
     2751       define variable v-label          as character no-undo .
     2752       define variable v-user-can-edit  as logical   no-undo .
     2753       define variable v-output-display as logical   no-undo .
     2754       define variable v-other          as character no-undo .
     2755       run clntattr-code in this-procedure (
     2756                                             input  p-code
     2757                                             ,output v-type
     2758                                             ,output v-format
     2759                                             ,output v-label
     2760                                             ,output v-user-can-edit
     2761                                             ,output v-output-display
     2762                                             ,output v-other
     2763                                             ) no-error .
     2764       if error-status :error then do:
     2765         undo, return error return-value .
     2766       end.
     2767       find first buf_temp-hattr no-lock
     2768         where buf_temp-hattr.obj-type  = p-obj-type
     2769           and buf_temp-hattr.obj-code  = p-obj-code
     2770           and buf_temp-hattr.attr-code = p-code
     2771         no-error .
     2772       if  available buf_temp-hattr then do:
     2773         p-exist = yes.
     2774       end.
     2775     end.
     2776   END PROCEDURE.
     2777   PROCEDURE temp-clntattr-write :
     2778     do
     2779     on error undo, return error return-value
     2780     :
     2781       define input parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     2782       define input parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     2783       define input parameter p-code     like ub.clients-attr.attr-code  no-undo .
     2784       define input parameter p-value    like ub.clients-attr.attr-value no-undo .
     2785       define buffer buf_temp-hattr for temp-hattr .
     2786       define variable v-type           as character no-undo .
     2787       define variable v-format         as character no-undo .
     2788       define variable v-label          as character no-undo .
     2789       define variable v-user-can-edit  as logical   no-undo .
     2790       define variable v-output-display as logical   no-undo .
     2791       define variable v-other          as character no-undo .
     2792       run clntattr-code in this-procedure (
     2793                                             input  p-code
     2794                                             ,output v-type
     2795                                             ,output v-format
     2796                                             ,output v-label
     2797                                             ,output v-user-can-edit
     2798                                             ,output v-output-display
     2799                                             ,output v-other
     2800                                             ) no-error .
     2801       if error-status :error then do:
     2802         undo, return error return-value .
     2803       end.
     2804       find first buf_temp-hattr exclusive-lock
     2805         where buf_temp-hattr.obj-type  = p-obj-type
     2806           and buf_temp-hattr.obj-code  = p-obj-code
     2807           and buf_temp-hattr.code = p-code
     2808         no-error .
     2809       if not available buf_temp-hattr then do:
     2810         create buf_temp-hattr .
     2811         assign
     2812           buf_temp-hattr.obj-type  = p-obj-type
     2813           buf_temp-hattr.obj-code  = p-obj-code
     2814           buf_temp-hattr.attr-code = v-label
     2815           buf_temp-hattr.code      = p-code
     2816           buf_temp-hattr.attr-value = (if v-type = 'L':U then string(logical(p-value), v-format) else p-value)
     2817           buf_temp-hattr.value_ = p-value
     2818           buf_Temp-hattr.output-display = v-output-display
     2819         .
     2820       end.
     2821       assign
     2822       buf_temp-hattr.value_ = p-value
     2823       buf_temp-hattr.attr-value = (if v-type = 'L':U then string(logical(p-value), v-format) else p-value)
     2824       .
     2825       release buf_temp-hattr no-error.
     2826       if error-status:error then do:
     2827         return error substitute("Ошибка при сохранение атрибута &1 клиента &2&3: &4 &5"
     2828                                , p-code
     2829                                , p-obj-type
     2830                                , p-obj-code
     2831                                , error-status:get-message(1)
     2832                                , return-value ).
     2833       end.
     2834     end.
     2835   END PROCEDURE.
     2836   PROCEDURE tt0-clntattr-write :
     2837     do
     2838     on error undo, return error return-value
     2839     :
     2840       define input parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     2841       define input parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     2842       define input parameter p-code     like ub.clients-attr.attr-code  no-undo .
     2843       define input parameter p-value    like ub.clients-attr.attr-value no-undo .
     2844       define buffer buf_tt0-clients-attr for tt0-clients-attr .
     2845       define variable v-type           as character no-undo .
     2846       define variable v-format         as character no-undo .
     2847       define variable v-label          as character no-undo .
     2848       define variable v-user-can-edit  as logical   no-undo .
     2849       define variable v-output-display as logical   no-undo .
     2850       define variable v-other          as character no-undo .
     2851       run clntattr-code in this-procedure (
     2852                                             input  p-code
     2853                                             ,output v-type
     2854                                             ,output v-format
     2855                                             ,output v-label
     2856                                             ,output v-user-can-edit
     2857                                             ,output v-output-display
     2858                                             ,output v-other
     2859                                             ) no-error .
     2860       if error-status :error then do:
     2861         undo, return error return-value .
     2862       end.
     2863       find first buf_tt0-clients-attr exclusive-lock
     2864         where buf_tt0-clients-attr.obj-type  = p-obj-type
     2865           and buf_tt0-clients-attr.obj-code  = p-obj-code
     2866           and buf_tt0-clients-attr.attr-code = p-code
     2867         no-error .
     2868       if not available buf_tt0-clients-attr then do:
     2869         create buf_tt0-clients-attr .
     2870         assign
     2871           buf_tt0-clients-attr.obj-type  = p-obj-type
     2872           buf_tt0-clients-attr.obj-code  = p-obj-code
     2873           buf_tt0-clients-attr.attr-code = p-code
     2874         .
     2875       end.
     2876       assign
     2877         buf_tt0-clients-attr.attr-value = p-value
     2878       .
     2879       release buf_tt0-clients-attr no-error.
     2880       if error-status:error then do:
     2881         return error RETURN-VALUE.
     2882       end.
     2883     end.
     2884   END PROCEDURE.
