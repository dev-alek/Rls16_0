     3362     on stop undo, leave
     3363     on error undo, leave
     3364     :
     3365       if QUERY br-c-dis-time-rule:handle:get-buffer-handle(1) = (buffer X_c-dis-time-rule:handle) then do:
     3366         assign
     3367         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3368         parameter-4-26 =
     3369           "where ":u + " TRUE " + " ":u + where-phrase-26 + " ":u + p-find-condition + " " + ""
     3370         parameter-5-26 = "  "
     3371       .
     3372         run fltopend_fltfindd in this-procedure  (
     3373                             input this-procedure:handle
     3374                             ,input QUERY br-c-dis-time-rule:handle
     3375                             ,input rowid(X_c-dis-time-rule)
     3376                             ,input logical(parameter-2-26)
     3377                             ,input no-lock
     3378                             ,input (buffer X_c-dis-time-rule:handle)
     3379                             ,input parameter-4-26
