     3036           b-sch :tooltip = ""
     3037         .
     3038       end.
     3039     end.
     3040   end procedure.
     3041   MAIN-BLOCK:
     3042   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3043      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3044    if LOOKUP(p-mode, ('все':U + chr(4) +
     3045                      "upper-rule-num":U + chr(4) +
     3046                      "one":U + chr(4) +
     3047                      'объект':U + chr(4) +
     3048                      "rl-root":U),
     3049                   chr(4)) = 0
     3050        then dO:
     3051       message
     3052       vss-workfile vss-revision vss-description skip
     3053       "Неверное значение параметров вызова p-mode"
     3054       p-mode
     3055       view-as alert-box ERROR.
     3056       return error .
     3057    end.
     3058     if p-mode = "upper-rule-num" then do:
     3059      find first X_upper-dis-time-rule no-lock where
     3060             X_upper-dis-time-rule.time-rule-num = p-upper-rule-num no-error.
     3061      if not available X_upper-dis-time-rule then do:
     3062       message
     3063       vss-workfile vss-revision vss-description skip
     3064       "Неверное значение параметров вызова p-upper-rule-num"
     3065       p-upper-rule-num
     3066       view-as alert-box ERROR.
     3067       return error .
     3068      end.
     3069     end.
     3070     if p-mode = "one" then do:
     3071      find first X_dis-time-rule no-lock where
     3072             X_dis-time-rule.time-rule-num = p-rule-num no-error.
     3073      if not available X_dis-time-rule then do:
     3074       message
     3075       vss-workfile vss-revision vss-description skip
     3076       "Неверное значение параметров вызова p-rule-num"
     3077       p-upper-rule-num
     3078       view-as alert-box ERROR.
     3079       return error .
     3080      end.
     3081     end.
     3082   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3083   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3084     (output v-db-num
     3085     )  .
     3086     RUN MyEnable in this-procedure .
     3087     RUn OpenBR IN THIS-PROCEDURE ( input YES, input NO, input '':U).
     3088     HIDE mark-num in frame Dialog-Frame .
     3089     if v-doc-rec <> ? then
     3090     REPOSITION br-c-dis-time-rule to recid v-doc-rec No-ERROR.
     3091   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3092   DEF VAR cur-clmn-numbr-c-dis-time-rule as INT EXTENT 9 no-undo.
     3093   DEF VAR varmvibr-c-dis-time-rule       as INT no-undo.
     3094   DEF VAR varmvjbr-c-dis-time-rule       as INT no-undo.
     3095   DEF VAR varmvkbr-c-dis-time-rule       as INT no-undo.
     3096   DEF VAR varmvlbr-c-dis-time-rule       as INT no-undo.
     3097   DEF VAR move-elementbr-c-dis-time-rule as INT no-undo.
     3098   def var jjbr-c-dis-time-rule           as int no-undo.
     3099   do varmvibr-c-dis-time-rule = 1 to EXTENT(cur-clmn-numbr-c-dis-time-rule):
     3100     ASSIGN cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] = varmvibr-c-dis-time-rule.
     3101   END.
     3102   RUN start-mv-clmnbr-c-dis-time-rule.
     3103   PROCEDURE start-mv-clmnbr-c-dis-time-rule:
     3104   def var old-session as logical no-undo.
     3105      old-session = SESSION:IMMEDIATE-DISPLAY.
     3106      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3107          IF  p-mode = 'все':U  THEN DO:
     3108      DO jjbr-c-dis-time-rule = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     3109        RUN re-move-clmnbr-c-dis-time-rule ( cur-clmn-numbr-c-dis-time-rule[INTEGER(ENTRY (jjbr-c-dis-time-rule, '1,2,3,4,5,6,7,8,9'))] , 1).
     3110      END.
     3111          END.
     3112          IF  p-mode = 'upper-rule-num':U or p-mode = 'one'  THEN DO:
     3113      DO jjbr-c-dis-time-rule = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     3114        RUN re-move-clmnbr-c-dis-time-rule ( cur-clmn-numbr-c-dis-time-rule[INTEGER(ENTRY (jjbr-c-dis-time-rule, '1,2,3,4,5,6,7,8,9'))] , 1).
     3115      END.
     3116          END.
     3117          IF  p-mode = 'объект':U  THEN DO:
     3118      DO jjbr-c-dis-time-rule = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     3119        RUN re-move-clmnbr-c-dis-time-rule ( cur-clmn-numbr-c-dis-time-rule[INTEGER(ENTRY (jjbr-c-dis-time-rule, '1,2,3,4,5,6,7,8,9'))] , 1).
     3120      END.
     3121          END.
     3122      SESSION:IMMEDIATE-DISPLAY = old-session.
     3123   END.
     3124   ON ctrl-cursor-right OF BROWSE br-c-dis-time-rule do:
     3125     RUN re-move-clmnbr-c-dis-time-rule ( 1, 9).
     3126   END.
     3127   ON ctrl-cursor-left OF BROWSE br-c-dis-time-rule do:
     3128     RUN re-move-clmnbr-c-dis-time-rule (9, 1).
     3129   END.
     3130   PROCEDURE re-move-clmnbr-c-dis-time-rule:
     3131     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3132     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3133     DO varmvibr-c-dis-time-rule = 1 TO EXTENT(cur-clmn-numbr-c-dis-time-rule):
     3134       if cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] = source-column THEN cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] = -1.
     3135     END.
     3136     if br-c-dis-time-rule:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3137     if source-column > target-column THEN
     3138     DO varmvjbr-c-dis-time-rule = source-column - 1 to target-column BY -1:
     3139       DO varmvibr-c-dis-time-rule = 1 TO EXTENT(cur-clmn-numbr-c-dis-time-rule):
     3140           if cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] = varmvjbr-c-dis-time-rule THEN DO:
     3141             cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] = cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] + 1.
     3142           END.
     3143       END.
     3144     END.
     3145     ELSE
     3146     DO varmvjbr-c-dis-time-rule = source-column + 1 to target-column:
     3147       DO varmvibr-c-dis-time-rule = 1 TO EXTENT(cur-clmn-numbr-c-dis-time-rule):
     3148         if cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] = varmvjbr-c-dis-time-rule THEN DO:
     3149           cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] = cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] - 1.
     3150         END.
     3151       END.
     3152     END.
     3153     DO varmvibr-c-dis-time-rule = 1 TO EXTENT(cur-clmn-numbr-c-dis-time-rule):
     3154       if cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] = -1 THEN cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] = target-column.
     3155     END.
     3156   END PROCEDURE.
     3157   PROCEDURE ch-clmnbr-c-dis-time-rule:
     3158     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3159     if cur-clmn-loc <= 1 then do:
     3160       return .
     3161     end.
     3162     DO varmvibr-c-dis-time-rule = 1 TO EXTENT(cur-clmn-numbr-c-dis-time-rule):
     3163       if cur-clmn-numbr-c-dis-time-rule[varmvibr-c-dis-time-rule] = cur-clmn-loc THEN move-elementbr-c-dis-time-rule = varmvibr-c-dis-time-rule.
     3164     END.
     3165     RUN re-move-clmnbr-c-dis-time-rule (cur-clmn-loc, 1).
     3166   END PROCEDURE.
     3167   PROCEDURE mv-brw-defaultbr-c-dis-time-rule:
     3168   def var old-session as logical no-undo.
     3169     old-session = SESSION:IMMEDIATE-DISPLAY.
     3170     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3171     do varmvlbr-c-dis-time-rule = 1 to EXTENT(cur-clmn-numbr-c-dis-time-rule):
     3172       RUN re-move-clmnbr-c-dis-time-rule (cur-clmn-numbr-c-dis-time-rule[varmvlbr-c-dis-time-rule], varmvlbr-c-dis-time-rule).
     3173     END.
     3174     RUN start-mv-clmnbr-c-dis-time-rule.
     3175     SESSION:IMMEDIATE-DISPLAY = old-session.
     3176   END PROCEDURE.
     3177   .
     3178     run diasize_add_browse in this-procedure
     3179       (input  'width':u
     3180       ,input  browse br-changes :handle
     3181       ) .
     3182     run diasize_init in this-procedure .
     3183   WAIT-FOR GO OF FRAME Dialog-Frame.
     3184   END.
     3185   RUN disable_UI.
     3186   PROCEDURE disable_UI :
     3187     HIDE FRAME Dialog-Frame.
     3188   END PROCEDURE.
     3189   PROCEDURE enable_UI :
     3190     OPEN QUERY Dialog-Frame FOR EACH X_c-dis-time-rule SHARE-LOCK.
     3191     GET FIRST Dialog-Frame.
     3192     DISPLAY mark-num
     3193         WITH FRAME Dialog-Frame.
     3194     ENABLE b-quit B-mark B-sel B-sch B-Help br-c-dis-time-rule BR-changes
     3195            mark-num
     3196         WITH FRAME Dialog-Frame.
     3197     VIEW FRAME Dialog-Frame.
     3198     OPEN QUERY br-c-dis-time-rule FOR EACH X_c-dis-time-rule NO-LOCK INDEXED-REPOSITION.
     3199   END PROCEDURE.
     3200   PROCEDURE MyEnable :
     3201   assign
     3202   br-changes:title in frame Dialog-Frame = '':U
     3203   temp-changes.l_name:resizable in browse br-changes = true
     3204   temp-changes.v_old:resizable in browse br-changes = true
     3205   temp-changes.v_new:resizable in browse br-changes = true
     3206   temp-changes.l_name:width in browse br-changes = 30
     3207   temp-changes.v_old:width in browse br-changes = 40
     3208   temp-changes.v_new:width in browse br-changes = 40
     3209   .
     3210   DISPLAY mark-num
     3211   WITH FRAME Dialog-Frame.
     3212   ENABLE
     3213   b-quit
     3214   B-mark when LOOKUP("b-mark":U, bttns) > 0
     3215   B-sel when LOOKUP("b-sel":U, bttns) > 0
     3216   B-Help
     3217   br-c-dis-time-rule
     3218   b-sch
     3219   mark-num
     3220   br-changes
     3221   with FRAME Dialog-Frame.
     3222   VIEW FRAME Dialog-Frame.
     3223   END PROCEDURE.
     3224   PROCEDURE OpenBr :
     3225   define input  parameter p-open-query     as logical   no-undo .
     3226   define input  parameter p-find-next      as logical   no-undo .
     3227   define input  parameter p-find-condition as character no-undo .
     3228   define variable l-query-was-opened as logical no-undo .
     3229   define variable title0 as character no-undo init "Список истории расписаний".
     3230   run waitfram-show in this-procedure ( input "Ждите...").
     3231   define variable sort-column-phrase as character no-undo .
     3232   case sort-column-name :
     3233     when "" then do:
     3234       assign
     3235         sort-column-phrase = ""
     3236       .
     3237     end.
     3238     otherwise do:
     3239       assign
     3240         sort-column-phrase = "by " + sort-column-name
     3241       .
     3242     end.
     3243   end case.
     3244   define variable l-open-query as logical   no-undo .
     3245     CASE p-mode :
     3246       WHEN 'все':U        THEN DO:
     3247         assign
     3248         filter-point = filter-point0 + p-mode
     3249         filter-label = substitute("&1", filter-label0)
     3250         .
     3251   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3252   define variable  l-disable-where-26  as logical   no-undo .
