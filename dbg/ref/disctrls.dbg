     3259   define variable  sort-phrase-rus-26  as character no-undo .
     3260     run waitfram-show in this-procedure
     3261       (input "ЖДИТЕ ..."
     3262       ).
     3263   run gbl/flt-get.p
     3264     (input filter-point
     3265     ,output flt-rec-26
     3266     ,output filter-name-26
     3267     ,output where-phrase-26
     3268     ,output sort-phrase-26
     3269     ,output where-phrase-rus-26
     3270     ,output sort-phrase-rus-26
     3271     ).
     3272   if p-open-query then do:
     3273       run set-filter-name in this-procedure
     3274         (INPUT filter-name-26
     3275         ) no-error .
     3276     assign
     3277       l-filter-open-26 = false
     3278     .
     3279     if flt-rec-26 <> ?
     3280       or sort-column-phrase > ""
     3281     then do:
     3282       define variable  parameter-2-26 as character no-undo .
     3283       define variable  parameter-3-26 as character no-undo .
     3284       define variable  parameter-4-26 as character no-undo .
     3285       define variable  parameter-5-26 as character no-undo .
     3286       define variable  parameter-6-26 as character no-undo .
     3287       define variable  parameter-7-26 as character no-undo .
     3288         assign
     3289         parameter-3-26 =
     3290                                 "FOR EACH X_c-dis-time-rule"
     3291         parameter-4-26 =
     3292           (
     3293             if (" TRUE " + " " + where-phrase-26) <> ""
     3294             then " TRUE " + " " + where-phrase-26
     3295             else "true"
     3296           )
     3297         parameter-5-26 = (" " + "" + " " + "")
     3298         parameter-6-26 = if sort-phrase-26 = ''
     3299                              then
     3300           (
     3301           " " + "  " +
     3302             " " + sort-column-phrase +
     3303           " " + "  "
     3304           )
     3305                              else
     3306           (
     3307           " " + "  " +
     3308             " " + sort-column-phrase +
     3309           " " + sort-phrase-26
     3310           )
     3311         parameter-7-26 =
     3312           " indexed-reposition  "
     3313       .
     3314       do
     3315       on stop undo, leave
     3316       on error undo, leave
     3317       :
     3318         assign
     3319           l-disable-where-26 =
     3320             (" TRUE " + " " + where-phrase-26 = "")
     3321         .
     3322         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3323                             ,input QUERY br-c-dis-time-rule:handle
     3324                             ,input parameter-3-26
     3325                             ,input parameter-4-26
     3326                             ,input parameter-5-26
     3327                             ,input parameter-6-26
     3328                             ,input parameter-7-26
     3329                             )
     3330         .
     3331         assign
     3332           l-filter-open-26 = true
     3333         .
     3334       end.
     3335       if l-filter-open-26 = false then do:
     3336         message
     3337           "Ошибка при фильтрации / сортировке" skip
     3338           "Будут показаны записи без учета фильтра" skip
     3339           view-as alert-box .
     3340       end.
     3341       else do:
     3342           assign
