     4230         IF new_c-dis-time-rule.week-day-5 = ?  THEN DO:
     4231           ASSIGN
     4232           v-chg-fields = REPLACE(v-chg-fields, "week-day-5":U, "":U).
     4233         END.
     4234         IF new_c-dis-time-rule.week-day-6 = ?  THEN DO:
     4235           ASSIGN
     4236           v-chg-fields = REPLACE(v-chg-fields, "week-day-6":U, "":U).
     4237         END.
     4238         IF new_c-dis-time-rule.week-day-7 = ?  THEN DO:
     4239           ASSIGN
     4240           v-chg-fields = REPLACE(v-chg-fields, "week-day-7":U, "":U).
     4241         END.
     4242       end.
     4243   end.
     4244     _ii:
     4245     do ii = 1 to num-entries(v-chg-fields):
     4246       assign
     4247       v-field-name = entry(ii, v-chg-fields)
     4248       jj = lookup(v-field-name, "des,time-rule-num,sts").
     4249       if jj = 0 then next _ii.
     4250       assign
     4251       v-field-label = entry(jj, "Описание,№ расписания,Статус")
     4252       v-field-function = entry(jj, ",,display-int-status")
     4253       .
     4254       create temp-changes.
     4255       assign
     4256       temp-changes.f_name = v-field-name
     4257       temp-changes.l_name = v-field-label
     4258       temp-changes.v_old =  (if v-is-created
     4259                             then "":U
     4260                             else string(buffer X_c-dis-time-rule:buffer-field(v-field-name):buffer-value))
     4261       temp-changes.v_new = (if v-is-deleted
     4262                             then "":U
     4263                             else  (if available new_c-dis-time-rule
     4264                                   then string(buffer new_c-dis-time-rule:buffer-field(v-field-name):buffer-value)
     4265                                   else string(buffer current_dis-time-rule:buffer-field(v-field-name):buffer-value)
     4266                                   )
     4267                            )
     4268       .
     4269       if v-field-function <> '':U then do:
     4270         assign
     4271         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4272         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4273         .
     4274       end.
     4275   end.
     4276   assign
     4277   br-changes:title in frame Dialog-Frame = (if X_c-dis-time-rule.time-rule-num  <= 99999
     4278                                               then "Шаблон"
     4279                                               else (if X_c-dis-time-rule.upper-time-rule-num <= 99999
     4280                                                     then "Расписание"
     4281                                                     else "Детализация"))
     4282   .
     4283   Open QUery br-changes for each temp-changes.
     4284   END PROCEDURE.
     4285   FUNCTION get-action RETURNS CHARACTER
     4286     ( p-action as INTEGER ) :
     4287     define variable dops as character no-undo.
     4288   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4289   RETURN dops.
     4290   END FUNCTION.
