      422   procedure prn-lib-open-stream :
      423     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      424     define input parameter p-page-size    as integer no-undo .
      425     define input parameter p-is-stream    as logical no-undo .
      426     define input parameter p-append       as logical no-undo .
      427     define variable v-report-name as character no-undo .
      428     do
      429       on error undo, return error
      430       :
      431       run prn-lib-get-report-name  in this-procedure (
      432         input parParentProc
      433         ,output v-report-name
      434         ).
      435       if p-is-stream then
      436       do:
      437         if p-append then
      438         do:
      439           output stream PrnLibStream to value( v-report-name )
      440             page-size value(p-page-size) append .
      441         end.
      442         if not p-append then
      443         do:
      444           output stream PrnLibStream to value( v-report-name )
      445             page-size value(p-page-size) .
      446         end.
      447       end.
      448       if not p-is-stream then
      449       do:
      450         if p-append then
      451         do:
      452           output to value( v-report-name )
      453             page-size value(p-page-size) append .
      454         end.
      455         if not p-append then
      456         do:
      457           output to value( v-report-name )
      458             page-size value(p-page-size) .
      459         end.
      460       end.
      461     end.
      462   end procedure.
      463   procedure prn-lib-open-exp :
      464     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      465     define input parameter p-is-stream    as logical no-undo .
      466     define input parameter p-is-append    as logical no-undo .
      467     define output parameter p-ReportFileName as char init "report" no-undo.
      468     define output parameter p-process as logical no-undo .
      469     define variable glog as logical no-undo .
      470     do
      471       on error undo, return error
      472       :
      473       SYSTEM-DIALOG GET-FILE p-ReportFileName
      474         TITLE      "Укажите путь"
      475         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      476         ASK-OVERWRITE
      477         CREATE-TEST-FILE
      478         SAVE-AS
      479         USE-FILENAME
      480         DEFAULT-EXTENSION "txt"
      481         UPDATE glog
      482         .
      483       if not glog then  return.
      484       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      485       if p-is-stream then
      486       do:
      487         if p-is-append then
      488         do:
      489           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      490         end.
      491         else
      492         do:
      493           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      494         end.
      495       end.
      496       else
      497       do:
      498         if p-is-append then
      499         do:
      500           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      501         end.
      502         else
      503         do:
      504           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      505         end.
      506       end.
      507       p-process = yes.
      508     end.
      509   end procedure.
      510   procedure prn-lib-get-report-name :
      511     define input parameter parParentProc  as widget-handle no-undo.
      512     define output parameter p-report-name as character no-undo .
      513     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      514   end procedure.
      515   procedure prn-lib-reportviewer-report-name :
      516     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      517     define input parameter p-report-name-html as character no-undo .
      518     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      519   end procedure.
      520   procedure prn-lib-reportviewer :
      521     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      522     define input parameter p-report-name-html as character no-undo .
      523     define input parameter p-param        as character no-undo .
      524     define variable v-excel           as character no-undo init 'TRUE' .
      525     define variable v-value-character as character no-undo .
      526     define variable v-value-integer   as character no-undo .
      527     define variable v-value-date      as date      no-undo .
      528     define variable v-value-decimal   as decimal   no-undo .
      529     define variable rep-excel         as logical   no-undo .
      530     define variable excel-string      as character no-undo .
      531     define variable v-param-type      as character no-undo .
      532     define variable v-tth             as handle    no-undo .
      533     run adm/shattri.p (
      534       input "get":U
      535       ,input  ""
      536       ,input  0
      537       ,input  'report-glob':U
      538       ,input  'rep-excel':U
      539       ,output v-value-character
      540       ,output v-value-date
      541       ,output v-value-decimal
      542       ,output v-value-integer
      543       ,output rep-excel
      544       ,output v-param-type
      545       ,INPUT-OUTPUT table-handle v-tth
      546       )  .
      547     if rep-excel then v-excel = "TRUE" .
      548     else v-excel = "FALSE" .
      549     if p-param eq ""
      550     then
      551        p-param = "EXCEL:" + v-excel.
      552     else
      553        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      554     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      555   end procedure.
      556   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   procedure cur-time :
      558      define output parameter p-today as date      no-undo .
      559      define output parameter p-time  as integer   no-undo .
      560     do
      561     on error undo, return error
      562     :
      563       define variable v-date1 as date      no-undo .
      564       define variable v-date2 as date      no-undo .
      565       define variable v-time  as integer   no-undo .
      566       assign
      567         v-date1 = today
      568         v-time  = time
      569         v-date2 = today
      570       .
      571       if v-date1 <> v-date2
      572       then do:
      573         assign
      574           v-date1 = today
      575           v-time  = v-time
      576         .
      577       end.
      578       assign
      579         p-today = v-date1
      580         p-time  = v-time
      581       .
      582     end.
      583   end.
      584   function cur-time-date returns character
      585   :
      586     return string(today, '99/99/9999':U) .
      587   end.
      588   function cur-time-mjd returns decimal
      589   :
      590     define variable v-date as date      no-undo .
      591     define variable v-time as integer   no-undo .
      592     run cur-time in this-procedure
      593       (output v-date
      594       ,output v-time
      595       ) .
      596     return integer(v-date) - 2400002 + (v-time / 86400) .
      597   end.
      598   function cur-time-get-ending-index returns integer
      599   (input p-number as integer
      600   )
      601   :
      602     if p-number < 0
      603     or p-number = ?
      604     then do:
      605       return 1 .
      606     end.
      607     define variable v-rest as integer   no-undo .
      608     assign
      609       p-number = p-number modulo 100
      610     .
      611     if p-number < 20
      612     then do:
      613       assign
      614         v-rest = p-number
      615       .
      616     end.
      617     else do:
      618       assign
      619         v-rest = p-number modulo 10
      620       .
      621     end.
      622     case v-rest :
      623       when 1
      624       then do:
      625         return 2 .
      626       end.
      627       when 2 or
      628       when 3 or
      629       when 4
      630       then do:
      631         return 3 .
      632       end.
      633       otherwise do:
      634         return 1 .
      635       end.
      636     end case .
      637   end.
      638   procedure cur-time-mjd-to-date :
      639      define input  parameter i-mjd-diff as decimal no-undo.
      640      define output parameter o-Date     as date    no-undo.
      641      define output parameter o-Time     as integer no-undo.
      642      define variable v-day-number as integer   no-undo .
      643      if    i-mjd-diff < 0
      644         or i-mjd-diff = ?
      645      then do:
      646         return "?" .
      647      end.
      648      assign
      649         v-day-number = truncate(i-mjd-diff,0).
      650         o-Date = date(v-day-number + 2400002).
      651         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      652     .
      653   end.
      654   function cur-time-mjd-to-string returns character
      655   (input p-mjd-diff as decimal
      656   )
      657   :
      658     define variable v-day-number as integer   no-undo .
      659     define variable v-seconds    as integer   no-undo .
      660     define variable v-hour       as integer   no-undo .
      661     define variable v-min        as integer   no-undo .
      662     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      663     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      664     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      665     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      666     if p-mjd-diff < 0
      667     or p-mjd-diff = ?
      668     then do:
      669       return "?" .
      670     end.
      671     assign
      672       v-day-number = integer(truncate(p-mjd-diff,0))
      673       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      674     .
      675     if v-seconds > 86400
      676     then do:
      677       assign
      678         v-seconds = 86400 - 1
      679       .
      680     end.
      681     if v-seconds < 0
      682     then do:
      683       assign
      684         v-seconds = 0
      685       .
      686     end.
      687     assign
      688       v-hour = truncate(v-seconds / 3600, 0)
      689     .
      690     assign
      691       v-seconds = v-seconds modulo 3600
      692     .
      693     assign
      694       v-min = truncate(v-seconds / 60, 0)
      695     .
      696     assign
      697       v-seconds = v-seconds modulo 60
      698     .
      699     return
      700         (if v-day-number <> 0
      701           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      702           else ""
      703         )
      704       + (if v-day-number <> 0 or v-hour <> 0
      705           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      706           else ""
      707         )
      708       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      709           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      710           else ""
      711         )
      712       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      713       .
      714   end.
      715   function cur-time-string returns character
      716   :
      717     define variable v-date as date      no-undo .
      718     define variable v-time as integer   no-undo .
      719     run cur-time in this-procedure
      720       (output v-date
      721       ,output v-time
      722       ) .
      723     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      724   end.
      725   function cur-time-string-sec returns character
      726   :
      727     define variable v-date as date      no-undo .
      728     define variable v-time as integer   no-undo .
      729     run cur-time in this-procedure
      730       (output v-date
      731       ,output v-time
      732       ) .
      733     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      734   end.
      735   function cur-time-custom  returns character
      736   (input p-prefix as character
      737   ,input p-date-format as character
      738   ,input p-delimiter as character
      739   ,input p-time-format as character
      740   ,input p-suffix as character
      741   )
      742   :
      743     define variable v-date as date      no-undo .
      744     define variable v-time as integer   no-undo .
      745     run cur-time in this-procedure
      746       (output v-date
      747       ,output v-time
      748       ) .
      749     return
      750       p-prefix
      751       + string(v-date, p-date-format)
      752       + p-delimiter
      753       + string(v-time, p-time-format)
      754       + p-suffix
      755       .
      756   end.
      757   function cur-time-print  returns character
      758   :
      759     define variable v-date as date      no-undo .
      760     define variable v-time as integer   no-undo .
      761     run cur-time in this-procedure
      762       (output v-date
      763       ,output v-time
      764       ) .
      765     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      766   end.
      767   function cur-time-datetime returns datetime
      768   :
      769     define variable v-char as character no-undo .
      770     define variable v-datetime as datetime no-undo .
      771     v-char = cur-time-string().
      772     v-datetime = datetime(v-char).
      773     return  v-datetime.
      774   end.
      775   function cur-time-string-msec returns character
      776   :
      777     define variable v-date as datetime  no-undo .
      778     v-date = now.
      779     return string(v-date) .
      780   end.
      781   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      782   define variable c-point  as character no-undo .
      783   define variable tbl      as character no-undo .
      784   define variable join-tbl as character no-undo .
      785   define variable fld      as character no-undo .
      786   define variable lab      as character no-undo .
      787   define variable spr      as character no-undo .
      788   define variable dim      as character no-undo .
      789   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   procedure fltfield-clear :
      791     define output parameter loc-fld as character no-undo.
      792     define output parameter loc-lab as character no-undo .
      793     define output parameter loc-spr as character no-undo .
      794     define output parameter loc-dim as character no-undo .
      795     assign
      796       loc-fld = ""
      797       loc-lab = ""
      798       loc-spr = ""
      799       loc-dim = "0"
      800     .
      801   end procedure .
      802   procedure fltfield-add :
      803     define input        parameter par-fld as character no-undo.
      804     define input        parameter par-lab as character no-undo .
      805     define input        parameter par-spr as character no-undo .
      806     define input-output parameter loc-fld as character no-undo.
      807     define input-output parameter loc-lab as character no-undo .
      808     define input-output parameter loc-spr as character no-undo .
      809     define input-output parameter loc-dim as character no-undo .
      810     do
      811     on error undo, return error
      812     :
      813       assign
      814       loc-fld = if loc-dim = '0'
      815                 then par-fld
      816                 else (loc-fld + chr(44) + par-fld)
      817       loc-lab = if loc-dim = '0'
      818                 then par-lab
      819                 else (loc-lab + chr(44) + par-lab)
      820       loc-spr = if loc-dim = '0'
      821                 then par-spr
      822                 else (loc-spr + chr(44) + par-spr)
      823       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      824                 string(integer(if num-entries(loc-dim) > 1
      825                               then entry(2, loc-dim)
      826                               else entry(1, loc-dim)
      827                               ) + 1)
      828       no-error
      829       .
      830     end.
      831   end procedure.
      832   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   procedure dr-code :
      834     do
      835     on error undo, return error
      836     :
      837       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      838       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      839       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      840       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      841       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      842       define output parameter  p-level-1           as character no-undo .
      843       define output parameter  p-level-2           as character no-undo .
      844       define output parameter  p-global             as integer no-undo .
      845       define output parameter  p-host               as integer no-undo .
      846       define output parameter  p-object             as integer no-undo .
      847       define output parameter  p-output-display as logical   no-undo .
      848       define output parameter  p-tree           as char  no-undo .
      849       define output parameter  p-other          as character no-undo .
      850       define variable v-other as character no-undo .
      851       define buffer buf_dis-rule for ub.dis-rule .
      852       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      853       find first buf_dis-rule no-lock where
      854                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      855       find first buf_dis-cfg-rule no-lock where
      856               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      857           and buf_dis-cfg-rule.pos-type = '':U
      858           and buf_dis-cfg-rule.table-name = '':U
      859           and buf_dis-cfg-rule.discnt-role = '':U
      860           and buf_dis-cfg-rule.self-nonunique = '':U
      861               no-error.
      862       if not available buf_Dis-cfg-rule then do:
      863           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      864       end.
      865       assign
      866       p-des = buf_dis-rule.des
      867       p-discnt-type = buf_dis-rule.discnt-type
      868       p-subject-type = buf_dis-rule.subject-type
      869       p-value-type = buf_dis-rule.value-type
      870       p-global = (if available buf_dis-cfg-rule
      871                   then buf_dis-cfg-rule.has-global
      872                   else 0)
      873       p-host = (if available buf_dis-cfg-rule
      874                 then buf_dis-cfg-rule.has-host
      875                 else 0)
      876       p-object = (if available buf_dis-cfg-rule
      877                 then buf_dis-cfg-rule.has-obj
      878                 else 0)
      879       p-output-display = (buf_dis-rule.sts = integer('0':U))
      880       p-tree = buf_Dis-rule.uniq-field
      881       p-other = buf_dis-rule.other-inf
      882       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      883       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      884                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      885                    else '')
      886       .
      887     end.
      888   end procedure.
      889   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      890   procedure disrules-fill-properties:
      891   define input  parameter p-templ-rl-root as integer   no-undo .
      892   define buffer buf_drt-prop for ub.drt-prop.
      893   define buffer buf_temp-drt-prop for temp-drt-prop.
      894   do
      895   on error undo, return error return-value
      896   :
      897     for each buf_temp-drt-prop:
      898       delete buf_temp-drt-prop.
      899     end.
      900     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      901       create buf_temp-drt-prop.
      902       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      903     end.
      904   end.
      905   end procedure.
      906   procedure disrules-get-interface-form :
      907   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      908   define output parameter p-form-name as character no-undo .
      909   define buffer buf_temp-drt-prop for temp-drt-prop.
      910   define buffer buf_drt-prop for ub.drt-prop.
      911   find first buf_temp-drt-prop where
      912             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      913         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      914         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      915   if not available buf_temp-drt-prop then do:
      916     find first buf_drt-prop where
      917               buf_drt-prop.templ-rl-root = p-templ-rl-root
      918           and buf_drt-prop.upper-prop-code = "InputForm"
      919           and buf_drt-prop.prop-code = "FormName" no-error.
      920     if available buf_drt-prop then do:
      921       p-form-name = buf_drt-prop.property-value.
      922     end.
      923     else do:
      924       p-form-name = "ref/dis-ruli.w".
      925     end.
      926   end.
      927   else do:
      928     p-form-name = buf_temp-drt-prop.property-value.
      929   end.
      930   end procedure.
      931   ~
      932   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      933   FUNCTION gtregion RETURNS CHARACTER
      934     ( input parhost-code as integer
      935     , input parobj-type as character
      936     , input parobj-code as integer
      937     , input p-tab as logical
      938     ) :
      939     def var par-region as character no-undo.
      940     if parhost-code = 0 and
      941          parobj-type = "":U and
      942          parobj-code = 0 then do:
      943          par-region = "Глобально".
      944          return par-region.
      945       end.
      946       if parobj-type = "" and
      947          parobj-code = 0 then do:
      948          par-region = if p-tab then fill(chr(32), 2) else "":U +
      949                       "Фирма" + chr(32) + string(parhost-code).
      950          return par-region.
      951       end.
      952       par-region = if p-tab then fill(chr(32), 4) else "":U +
      953                    parobj-type + chr(32) + string(parobj-code).
      954       return par-region.
      955   END FUNCTION.
      956   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   define  temp-table temp-changes no-undo
      958   field f_name as character
      959   field l_name as character
      960   field v_old as character
      961   field v_new as character
      962   field t_name as character
      963   field num_ as integer
      964   field uniq-key-rec as character
      965   field action as integer
      966   field fNotChange as logical
      967   index pi is unique primary
      968   num_
      969   t_name
      970   f_name
      971   index
      972   Chan
      973   fnotChange
      974   t_name
      975   f_name
      976   index imain uniq-key-rec
      977   .
      978   FUNCTION get-all-fields returns character (p-file-name as character ):
      979   define variable v-dop as character no-undo .
      980     find first _file no-lock where _file._file-name = p-file-name no-error .
      981     if not available _file then return "":U.
      982     for each _field no-lock where
      983              _field._file-recid = recid(_file) :
      984       assign
      985       v-dop = v-dop + _field._field-name + chr(44)
      986       .
      987     end.
      988     return trim(v-dop).
      989   END FUNCTION.
      990   PROCEDURE proc-full-temp-changes :
      991     define input  parameter p-hst-handle as handle    no-undo .
      992     define input  parameter p-main-table as character no-undo .
      993     define input  parameter p-field-list as character no-undo .
      994     define input  parameter p-label-form as character no-undo .
      995     define variable h-new-buf         as handle    no-undo .
      996     define variable h-main-buf        as handle    no-undo .
      997     define variable h-for-comp        as handle    no-undo .
      998     define variable v-inform          as character no-undo .
      999     define variable v-ind             as integer   no-undo .
     1000     define variable v-idx-field-qnty  as integer   no-undo .
     1001     define variable v-num-entries     as integer   no-undo .
     1002     define variable fh                as handle    no-undo .
     1003     define variable fh-main           as handle    no-undo .
     1004     define variable fh-old            as handle    no-undo .
     1005     define variable fh-new            as handle    no-undo .
     1006     define variable v-field-name      as character no-undo .
     1007     define variable v-field-lvl       as character no-undo .
     1008     define variable v-field-form      as character no-undo .
     1009     define variable v-search-exp      as character no-undo .
     1010     define variable v-srch-main       as character no-undo .
     1011     define variable v-word-link       as character no-undo .
     1012     define variable v-av-chip-num     as logical   no-undo .
     1013     define variable v-main-pi-fld-lst as character no-undo .
     1014     define variable v-main-fld-lst    as character no-undo .
     1015     define variable v-delim-list      as character no-undo .
     1016     define variable v-label           as character no-undo .
     1017     define variable v-old-value       as character no-undo case-sensitive.
     1018     define variable v-new-value       as character no-undo case-sensitive.
     1019     define variable v-chg-fields as character no-undo.
     1020     for each temp-changes:
     1021       delete temp-changes.
     1022     end.
     1023     if not p-hst-handle:available then do:
     1024       return .
     1025     end.
     1026     create buffer h-new-buf  for table p-hst-handle .
     1027     create buffer h-main-buf for table p-main-table .
     1028     assign
     1029       v-inform = h-main-buf:index-information(1)
     1030       v-ind    = 2
     1031     .
     1032     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1033     on error undo, return error
     1034     :
     1035       assign
     1036         v-inform = h-main-buf:index-information( v-ind )
     1037         v-ind    = v-ind + 1
     1038       .
     1039     end.
     1040     if v-inform = ?
     1041       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1042       or entry( 3, v-inform, ",":U ) <> "1":U
     1043     then do:
     1044       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1045     end.
     1046     assign
     1047       v-idx-field-qnty = num-entries( v-inform ) - 4
     1048     .
     1049     if v-idx-field-qnty < 2 then do:
     1050       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1051     end.
     1052     assign
     1053       v-srch-main   = "where":U
     1054       v-word-link   = "":U
     1055       v-av-chip-num = false
     1056       v-delim-list  = "":U
     1057     .
     1058     do v-ind = 1 to v-idx-field-qnty by 2
     1059     on error undo, return error
     1060     :
     1061       assign
     1062         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1063         fh                = p-hst-handle:buffer-field( v-field-name )
     1064         fh-main           = h-main-buf:buffer-field( v-field-name )
     1065         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1066         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1067       .
     1068       if fh:data-type ="character":U then do:
     1069         assign
     1070           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1071         .
     1072       end.
     1073       else do:
     1074         assign
     1075           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1076         .
     1077       end.
     1078       if v-delim-list = "":U then do:
     1079         assign
     1080           v-delim-list = ",":U
     1081         .
     1082       end.
     1083       if v-word-link = "":U then do:
     1084         assign
     1085           v-word-link = "and":U
     1086         .
     1087       end.
     1088     end.
     1089     assign
     1090       v-delim-list  = "":U
     1091     .
     1092     do v-ind = 1 to h-main-buf:num-fields
     1093     on error undo, return error
     1094     :
     1095       assign
     1096         fh-main      = h-main-buf:buffer-field( v-ind )
     1097         v-field-name = fh-main:name
     1098       .
     1099         assign
     1100           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1101         .
     1102         if v-delim-list = "":U then do:
     1103           assign
     1104             v-delim-list = ",":U
     1105           .
     1106         end.
     1107     end.
     1108     assign
     1109       v-inform = p-hst-handle:index-information(1)
     1110       v-ind    = 2
     1111     .
     1112     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1113     on error undo, return error
     1114     :
     1115       assign
     1116         v-inform = p-hst-handle:index-information( v-ind )
     1117         v-ind    = v-ind + 1
     1118       .
     1119     end.
     1120     if v-inform = ?
     1121       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1122       or entry( 3, v-inform, ",":U ) <> "1":U
     1123     then do:
     1124       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1125     end.
     1126     assign
     1127       v-idx-field-qnty = num-entries( v-inform ) - 4
     1128     .
     1129     if v-idx-field-qnty < 2 then do:
     1130       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1131     end.
     1132     assign
     1133       v-search-exp  = "where":U
     1134       v-word-link   = "":U
     1135       v-av-chip-num = false
     1136     .
     1137     do v-ind = 1 to v-idx-field-qnty by 2
     1138     on error undo, return error
     1139     :
     1140       assign
     1141         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1142         fh           = p-hst-handle:buffer-field( v-field-name )
     1143         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1144       .
     1145       if v-field-name = "chip-num":U then do:
     1146         assign
     1147           v-search-exp  = substitute( "&1 >", v-search-exp )
     1148           v-av-chip-num = true
     1149         .
     1150       end.
     1151       else do:
     1152         assign
     1153           v-search-exp = substitute( "&1 =", v-search-exp )
     1154         .
     1155       end.
     1156       if fh:data-type ="character":U then do:
     1157         assign
     1158           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1159         .
     1160       end.
     1161       else do:
     1162         assign
     1163           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1164         .
     1165       end.
     1166       if v-word-link = "":U then do:
     1167         assign
     1168           v-word-link = "and":U
     1169         .
     1170       end.
     1171     end.
     1172     if v-av-chip-num = false then do:
     1173       message
     1174         vss-workfile vss-revision vss-description skip
     1175         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1176         "Использование данной процедуры невозможно!" skip
     1177         view-as alert-box error .
     1178       return error .
     1179     end.
     1180     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1181     if not h-new-buf:available then do:
     1182       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1183       if not h-main-buf:available then do:
     1184         assign
     1185           h-for-comp = ?
     1186         .
     1187       end.
     1188       else do:
     1189         assign
     1190           h-for-comp = h-main-buf
     1191         .
     1192       end.
     1193     end.
     1194     else do:
     1195       assign
     1196         h-for-comp = h-new-buf
     1197       .
     1198     end.
     1199     assign
     1200       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1201     .
     1202     do v-ind = 1 to v-num-entries
     1203     on error undo, return error return-value
     1204     :
     1205       assign
     1206         v-field-name = entry( v-ind, v-main-fld-lst )
     1207         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1208         v-old-value  = fh-old:buffer-value()
     1209         v-label      = trim( fh-old:label )
     1210       .
     1211       if ( trim( p-field-list ) <> "":U
     1212            and lookup( v-field-name, p-field-list ) > 0
     1213          )
     1214          or trim( p-field-list ) = "":U
     1215       then do:
     1216         if h-for-comp <> ? then do:
     1217           assign
     1218             fh-new      = h-for-comp:buffer-field( v-field-name )
     1219             v-new-value = fh-new:buffer-value()
     1220           .
     1221         end.
     1222         else do:
     1223           assign
     1224             v-new-value = "":U
     1225           .
     1226         end.
     1227         if v-old-value <> v-new-value
     1228         then do:
     1229           create temp-changes.
     1230           assign
     1231             temp-changes.t_name = p-main-table
     1232             temp-changes.f_name = v-field-name
     1233             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1234             temp-changes.v_old  = trim( v-old-value )
     1235             temp-changes.v_new  = trim( v-new-value )
     1236             temp-changes.num_   = 0
     1237             temp-changes.fNotChange = v-old-value eq v-new-value
     1238           .
     1239         end.
     1240       end.
     1241     end.
     1242     assign
     1243       v-num-entries = num-entries( p-label-form, chr(8) )
     1244     .
     1245     do v-ind = 1 to v-num-entries
     1246     on error undo, return error return-value
     1247     :
     1248       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1249         assign
     1250           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1251           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1252           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1253         .
     1254         find first temp-changes
     1255           where temp-changes.f_name = v-field-name
     1256           no-error .
     1257         if available temp-changes then do:
     1258           if trim( v-field-lvl ) <> "":U then do:
     1259             assign
     1260               temp-changes.l_name = v-field-lvl
     1261             .
     1262           end.
     1263           if trim( v-field-form ) <> "":U then do:
     1264             assign
     1265               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1266             .
     1267             if h-for-comp <> ? then do:
     1268               assign
     1269                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1270               .
     1271             end.
     1272           end.
     1273         end.
     1274       end.
     1275       else do:
     1276         message
     1277           vss-workfile vss-revision vss-description skip
     1278           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1279           substitute( "список для поля '&1': '&2'"
     1280                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1281                       ,entry( v-ind, p-label-form, chr(8) )
     1282                     ) skip
     1283           substitute( "полный список: &2", p-label-form ) skip
     1284           view-as alert-box error .
     1285       end.
     1286     end.
     1287     delete object h-new-buf .
     1288     delete object h-main-buf .
     1289   END PROCEDURE.
     1290   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1291   FUNCTION mark-string RETURNS CHARACTER
     1292     ( input p-recid as recid, input mark-list as character  ) :
     1293     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1294   END FUNCTION.
     1295   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1296   function usrfulnf returns character ( input p-user-id as character):
     1297   define variable v-user-name as character no-undo .
     1298   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1299   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1300     (input  p-user-id
     1301     ,output v-user-name
     1302     ) no-error .
     1303   if error-status:error
     1304   or v-user-name = ""
     1305   then do:
     1306     return p-user-id.
     1307   end.
     1308   else do:
     1309     return v-user-name.
     1310   end.
     1311   end function.
     1312   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1314   procedure fltopend_fltopend :
     1315   define input parameter p-parent-handle as handle no-undo .
     1316   define input parameter p-qh as handle no-undo .
     1317   define input parameter p-flt-open-open-query  as character no-undo .
     1318   define input parameter p-where-cond as character no-undo .
     1319   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1320   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1321   define input parameter p-indexed-reposition as character no-undo .
     1322     do
     1323     on error undo, return error
     1324     :
     1325   define variable v-prepare-string as character no-undo .
     1326   define variable glog as logical no-undo .
     1327   assign
     1328   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1329                      p-where-cond + chr(32)  +
     1330                      p-use-indFIRST-query-tail + chr(32) +
     1331                      p-use-ind-sort-clmn-by + chr(32) +
     1332                      p-indexed-reposition
     1333   .
     1334   assign
     1335   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1336   if not glog
     1337   or error-status:error then do:
     1338     message error-status:get-message(1) view-as alert-box .
     1339     undo, return error .
     1340   end.
     1341   assign
     1342   glog = p-qh:query-open no-error .
     1343   if not glog
     1344   or error-status:error then do:
     1345     message error-status:get-message(1) view-as alert-box .
     1346     undo, return error .
     1347   end.
     1348     end.
     1349   end procedure.
     1350   procedure fltopend_fltfindd :
     1351   define input parameter p-parent-handle as handle no-undo .
     1352   define input parameter p-qh as handle no-undo .
     1353   define input parameter p-rowid as rowid no-undo .
     1354   define input parameter p-next as logical no-undo .
     1355   define input parameter p-lock as integer no-undo .
     1356   define input parameter p-bh as handle no-undo .
     1357   define input parameter p-where-cond as character no-undo .
     1358   define input parameter p-use-index-phrase as character no-undo .
     1359   define variable glog as logical no-undo .
     1360   define variable v-qh as handle no-undo .
     1361   define variable v-bh as handle no-undo .
     1362   define variable v-recid as recid no-undo .
     1363   define variable v-prepare-string as character no-undo .
     1364   do
     1365   on error undo, return error
     1366   on stop undo, return error
     1367   :
     1368     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1369     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1370     create query v-qh.
     1371     v-qh:set-buffers(v-bh).
     1372     v-prepare-string = substitute("for each &1 &2 &3"
     1373                                     ,v-bh:name
     1374                                     ,p-where-cond
     1375                                     ,p-use-index-phrase).
     1376     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1377     if not glog then do:
     1378       delete object v-qh.
     1379       delete object v-bh.
     1380       undo, return error .
     1381     end.
     1382     glog = v-qh:query-open no-error .
     1383     if not glog then do:
     1384       delete object v-qh.
     1385       delete object v-bh.
     1386       undo, return error .
     1387     end.
     1388     if p-next then do:
     1389       v-qh:reposition-to-rowid(p-rowid) no-error .
     1390       glog = v-qh:get-next( p-lock) no-error .
     1391       glog = v-qh:get-next( p-lock) no-error .
     1392       if not glog or v-qh:query-off-end = yes then do:
     1393         glog = v-qh:get-first( p-lock) no-error .
     1394       end.
     1395     end.
     1396     else do:
     1397       glog = v-qh:get-first( p-lock) no-error .
     1398     end.
     1399     v-recid = v-bh:recid no-error .
     1400     delete object v-qh.
     1401     delete object v-bh.
     1402     return string(v-recid) .
     1403   end.
     1404   end procedure.
     1405   procedure fltopend_fltfindq :
     1406   define input parameter p-parent-handle as handle no-undo .
     1407   define input parameter p-qh as handle no-undo .
     1408   define input parameter p-next as logical no-undo .
     1409   define input parameter p-lock as integer no-undo .
     1410   define input parameter p-flt-open-open-query  as character no-undo .
     1411   define input parameter p-where-cond as character no-undo .
     1412   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1413   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1414   define input parameter p-indexed-reposition as character no-undo .
     1415   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1416   define variable glog as logical no-undo .
     1417   define variable v-qh as handle no-undo .
     1418   define variable v-bh as handle no-undo extent 18.
     1419   define variable v-rowid as rowid no-undo extent 18.
     1420   define variable v-ii as integer no-undo .
     1421   define variable v-prepare-string as character no-undo .
     1422   do
     1423   on error undo, return error
     1424   on stop undo, return error
     1425   :
     1426     create query v-qh.
     1427     do v-ii = 1 to p-qh:num-buffers:
     1428       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1429       assign
     1430       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1431       no-error.
     1432       v-qh:add-buffer(v-bh[v-ii]).
     1433     end.
     1434     assign
     1435     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1436                       p-where-cond + chr(32)  +
     1437                       p-use-indFIRST-query-tail + chr(32) +
     1438                       p-use-ind-sort-clmn-by + chr(32) +
     1439                       p-indexed-reposition
     1440     .
     1441     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1442     if not glog then do:
     1443       delete object v-qh.
     1444       do v-ii = 1 to p-qh:num-buffers:
     1445         delete object v-bh[v-ii].
     1446       end.
     1447       undo, return error .
     1448     end.
     1449     glog = v-qh:query-open no-error .
     1450     if not glog then do:
     1451       delete object v-qh.
     1452       do v-ii = 1 to p-qh:num-buffers:
     1453         delete object v-bh[v-ii].
     1454       end.
     1455       undo, return error .
     1456     end.
     1457     if p-next then do:
     1458       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1459       glog = v-qh:get-next( p-lock) no-error .
     1460       glog = v-qh:get-next( p-lock) no-error .
     1461       if not glog or v-qh:query-off-end = yes then do:
     1462         glog = v-qh:get-first( p-lock) no-error .
     1463       end.
     1464     end.
     1465     else do:
     1466       glog = v-qh:get-first( p-lock) no-error .
     1467     end.
     1468     do v-ii = 1 to p-qh:num-buffers:
     1469       assign
     1470       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1471       no-error.
     1472     end.
     1473     delete object v-qh.
     1474     do v-ii = 1 to p-qh:num-buffers:
     1475       delete object v-bh[v-ii].
     1476     end.
     1477   end.
     1478   end procedure.
     1479   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1480   define variable sort-column-name as character no-undo .
     1481   define variable v-db-num LIKE ub.db.db-num no-undo.
     1482   define variable filter-label as character no-undo init "История расписаний" .
     1483   define variable filter-label0 as character no-undo init "История расписаний" .
     1484   define variable filter-point0 as character no-undo init "disctrls" .
     1485   define variable filter-point as character no-undo init "disctrls" .
     1486   define variable v-host-code like ub.sysconf.host-code no-undo .
     1487   define variable v-rid-list as character no-undo .
     1488   define buffer pos_c-dis-time-rule for ub.c-dis-time-rule.
     1489   define buffer X_dis-time-rule for ub.dis-time-rule.
     1490   FUNCTION get-action RETURNS CHARACTER
     1491     ( p-action as INTEGER )  FORWARD.
     1492   DEFINE BUTTON B-Help
     1493        LABEL "Помо&щь"
     1494        SIZE 3 BY 1
     1495        BGCOLOR 8 .
     1496   DEFINE BUTTON B-lookup
     1497        LABEL "Button 1"
     1498        SIZE 10 BY 1.
     1499   DEFINE BUTTON B-mark
     1500        LABEL "&*"
     1501        SIZE 3 BY 1.
     1502   DEFINE BUTTON b-quit AUTO-END-KEY
     1503        LABEL "&Выход"
     1504        SIZE 10 BY 1
     1505        BGCOLOR 8 .
     1506   DEFINE BUTTON B-sch
     1507        LABEL "&Фильтр"
     1508        SIZE 3 BY 1.
     1509   DEFINE BUTTON B-sel AUTO-GO
     1510        LABEL "Вы&бор"
     1511        SIZE 10 BY 1.
     1512   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1513         VIEW-AS TEXT
     1514        SIZE 6 BY 1
     1515        FGCOLOR 4  NO-UNDO.
     1516   DEFINE QUERY br-c-dis-time-rule FOR
     1517         X_c-dis-time-rule SCROLLING.
     1518   DEFINE QUERY BR-changes FOR
     1519         temp-changes SCROLLING.
     1520   DEFINE QUERY Dialog-Frame FOR
     1521         X_c-dis-time-rule SCROLLING.
     1522   DEFINE BROWSE br-c-dis-time-rule
     1523     QUERY br-c-dis-time-rule NO-LOCK DISPLAY
     1524         mark-string(recid(X_c-dis-time-rule), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1525         X_c-dis-time-rule.des FORMAT "X(50)":U
     1526         X_c-dis-time-rule.is-news FORMAT "+/":U
     1527         get-action(X_c-dis-time-rule.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1528         X_c-dis-time-rule.corr-user-db-num COLUMN-LABEL "Номер!БД" FORMAT ">>>>9":U
     1529         usrfulnf(X_c-dis-time-rule.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1530         X_c-dis-time-rule.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
     1531         string(X_c-dis-time-rule.corr-time, "HH:MM") COLUMN-LABEL "Время корр" FORMAT "X(10)":U
     1532         X_c-dis-time-rule.time-rule-num FORMAT ">>>>>>>>9":U
     1533       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25.
     1534   DEFINE BROWSE BR-changes
     1535     QUERY BR-changes DISPLAY
     1536         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1537   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1538   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1539       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1540   DEFINE FRAME Dialog-Frame
     1541        b-quit AT ROW 1 COL 1
     1542        B-mark AT ROW 1 COL 11
     1543        B-sel AT ROW 1 COL 21
     1544        B-lookup AT ROW 1 COL 41
     1545        B-sch AT ROW 1 COL 92
     1546        B-Help AT ROW 1 COL 95
     1547        br-c-dis-time-rule AT ROW 3 COL 1
     1548        BR-changes AT ROW 13 COL 1
     1549        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1550        SPACE(78.62) SKIP(20.04)
     1551       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1552            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1553            TITLE "История расписаний"
     1554            CANCEL-BUTTON b-quit.
     1555   ASSIGN
     1556          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1557          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1558   ASSIGN
     1559          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1560   ON GO OF FRAME Dialog-Frame
     1561   DO:
     1562     p-rid-list = v-rid-list.
     1563   END.
     1564   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1565   OR ENDKEY OF FRAME Dialog-Frame DO:
     1566     run gbl/markqwa.p (
     1567                              input b-mark:sensitive
     1568                             , input v-rid-list) no-error.
     1569     if error-status:error then return no-apply.
     1570     APPLY "END-ERROR":U TO SELF.
     1571   END.
     1572   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1573   DO:
     1574     define variable loc#log as logical no-undo .
     1575     if available X_c-dis-time-rule then do:
     1576   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577   define variable v-str-recid16 as character no-undo .
     1578   define variable v-num-entry16 as integer   no-undo .
     1579   assign
     1580     v-str-recid16 = trim( string( recid( X_c-dis-time-rule ) , "->>>>>>>>>>>9":U ) )
     1581     v-num-entry16 = lookup( v-str-recid16 , v-rid-list )
     1582   .
     1583   if v-num-entry16 > 0 then do:
     1584     assign
     1585       entry( v-num-entry16, v-rid-list ) = "":U
     1586       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1587     .
     1588   end.
     1589   else do:
     1590     assign
     1591       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1592     .
     1593   end.
     1594       loc#log = br-c-dis-time-rule:refresh() .
     1595       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1596           loc#log = br-c-dis-time-rule:select-next-row ().
     1597           apply "VALUE-CHANGED" to br-c-dis-time-rule in frame Dialog-Frame.
     1598       end.
     1599       if num-entries( v-rid-list ) = 0
     1600       then
     1601           hide mark-num in frame Dialog-Frame.
     1602       else
     1603           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1604     end.
     1605     apply "entry" to br-c-dis-time-rule in frame Dialog-Frame.
     1606   END.
     1607   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1608   DO:
     1609     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1610     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1611   END.
     1612   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1613   DO:
     1614       if ( available X_c-dis-time-rule ) then do:
     1615       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1616       then
     1617       v-rid-list = string( recid( X_c-dis-time-rule ) ) .
     1618     end.
     1619   END.
     1620   ON RETURN OF br-c-dis-time-rule IN FRAME Dialog-Frame
     1621   or MOUSE-SELECT-DBLCLICK OF br-c-dis-time-rule IN FRAME Dialog-Frame
     1622       DO:
     1623     run proc-br-c-dis-time-rule no-error.
     1624     if error-status:error then return no-apply.
     1625   END.
     1626   ON VALUE-CHANGED OF br-c-dis-time-rule IN FRAME Dialog-Frame
     1627   DO:
     1628     run proc-view-changes in this-procedure no-error.
     1629   END.
     1630   function display-int-status returns character(input p-stts-char as character):
     1631   case p-stts-char :
     1632     when '0':U then return 'тек':U.
     1633     when '1':U then return 'удал':U.
     1634     when '2':U then return 'детализ':U.
     1635     otherwise return chr(63).
     1636   end case.
     1637   END FUNCTION.
     1638   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1639   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1640   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1641   on help of frame Dialog-Frame
     1642   do:
     1643     run gbl/app_help.p
     1644       (input this-procedure :file-name
     1645       ,input ''
     1646       ,input ?
     1647       ) no-error.
     1648     if error-status :error then do:
     1649       message
     1650         "Ошибка при вызове помощи"
     1651         error-status :get-message(1)
     1652         view-as alert-box .
     1653     end.
     1654   end.
     1655   run minbtn-set in this-procedure .
     1656   on choose of b-help in frame Dialog-Frame
     1657   do:
     1658     apply "help":u to frame Dialog-Frame .
     1659   end.
     1660   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   procedure minbtn-set :
     1662       do
     1663           on error undo, return error return-value
     1664           :
     1665           define variable ii              as integer       no-undo .
     1666           define variable fh              as widget-handle no-undo .
     1667           define variable hh              as widget-handle no-undo .
     1668           define variable v-h             as handle        extent 4 no-undo .
     1669           define variable v-name-button   as character     no-undo .
     1670           define variable v-help-old-x    as decimal       no-undo .
     1671           define variable v-help-old-y    as decimal       no-undo .
     1672           define variable v-help-old-size as decimal       no-undo .
     1673           define variable v-frame-width   as decimal       no-undo .
     1674           define variable jj              as integer       no-undo .
     1675           do
     1676               on error undo, return error
     1677               :
     1678               assign
     1679                   v-frame-width = frame Dialog-Frame:width - 0.3
     1680                   fh            = frame Dialog-Frame:first-child
     1681                   hh            = fh:first-child
     1682                   ii            = 1
     1683                   .
     1684               do while valid-handle(hh):
     1685                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1686                   do:
     1687                       case lc(hh:name) :
     1688                           when "b-help" then
     1689                               do:
     1690                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1691                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1692                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1693                                   hh:TOOLTIP = "Помощь" .
     1694                                   v-help-old-x = hh:column .
     1695                                   v-help-old-y = hh:row    .
     1696                                   v-help-old-size = hh:width .
     1697                                   hh:width-chars = 2.5 .
     1698                               end.
     1699                           when "b-print" then
     1700                               do:
     1701                                   hh:load-image("cmp/b-print.bmp":u) .
     1702                                   hh:TOOLTIP = "Печать" .
     1703                                   v-h[ii] = hh:handle .
     1704                                   ii = ii + 1 .
     1705                                   hh:width-chars = 3 .
     1706                               end.
     1707                           when "b-history" or
     1708                           when "b-hist" then
     1709                               do:
     1710                                   hh:load-image("cmp/b-hist.bmp":u) .
     1711                                   hh:TOOLTIP = "История" .
     1712                                   v-h[ii] = hh:handle .
     1713                                   ii = ii + 1 .
     1714                                   hh:width-chars = 3 .
     1715                               end.
     1716                           when "b-sch" then
     1717                               do:
     1718                                   hh:load-image("cmp/b-sch.bmp":u) .
     1719                                   hh:TOOLTIP = "Установка Фильтра" .
     1720                                   v-h[ii] = hh:handle .
     1721                                   ii = ii + 1 .
     1722                                   hh:width-chars = 3 .
     1723                               end.
     1724                           when "b-hist-user" then
     1725                               do:
     1726                                   hh:load-image("cmp/b-hist.bmp":u) .
     1727                                   hh:TOOLTIP = "История пользователя" .
     1728                                   ii = ii + 1 .
     1729                               end.
     1730                       end case.
     1731                   end.
     1732                   hh = hh:next-sibling.
     1733               end.
     1734               b-help:column = v-frame-width - b-help:width-chars.
     1735               jj = 0.
     1736               repeat ii = 4 to 1 by -1 :
     1737                   if valid-handle (v-h[ii] ) then
     1738                   do:
     1739                       jj  = jj + 1 .
     1740                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1741                       v-h[ii]:row    = v-help-old-y .
     1742                   end.
     1743               end.
     1744           end.
     1745       end.
     1746   end procedure.
     1747   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1748   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1749   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1750   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1751   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1752   define variable v-diasize-current-frame-height as decimal   no-undo .
     1753   define variable v-diasize-change-size          as logical   no-undo .
     1754   define variable v-diasize-resize-button        as handle    no-undo .
     1755   define variable v-diasize-wndmax               as logical   no-undo .
     1756   define variable v-diasize-wndstore             as logical   no-undo .
     1757   define variable v-diasize-proc-name            as character no-undo .
     1758   define variable v-diasize-browse-handle        as handle    no-undo .
     1759   define variable v-diasize-browse-number        as integer   no-undo .
     1760   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1761   define temp-table temp-diasize-handle no-undo
     1762     field handle-value  as handle
     1763     field save-position as decimal
     1764     index xpk is primary unique handle-value
     1765     .
     1766   define temp-table temp-browse-handle no-undo
     1767     field browse-type   as character
     1768     field browse-number as integer
     1769     field browse-handle as handle
     1770     field original-size as decimal
     1771     index xpk is primary unique browse-type browse-number
     1772     index xie browse-type browse-handle
     1773   .
     1774   procedure diasize_change-height :
     1775     define input  parameter p-change-value  as decimal   no-undo .
     1776     define input  parameter p-move-resize   as logical   no-undo .
     1777     define variable v-field-group-handle    as handle    no-undo .
     1778     define variable v-object-handle         as handle    no-undo .
     1779     define variable v-frame-height          as decimal   no-undo .
     1780     define variable v-frame-virtual-height  as decimal   no-undo .
     1781     define variable v-browse-height         as decimal   no-undo .
     1782     define variable v-window-height         as decimal   no-undo .
     1783     define variable v-window-virtual-height as decimal   no-undo .
     1784     define variable v-change-sign           as integer   no-undo .
     1785     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1786     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1787     if p-change-value > 0
     1788     then do:
     1789       if frame Dialog-Frame :height + p-change-value
     1790           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1791       then do:
     1792         assign
     1793           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1794                           - (frame Dialog-Frame :height-chars)
     1795         .
     1796         if p-change-value <= 0
     1797         then do:
     1798           run diasize_position-resize-button in this-procedure .
     1799           return .
     1800         end.
     1801       end.
     1802     end.
     1803     if p-change-value < 0
     1804     then do:
     1805       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1806       then do:
     1807         assign
     1808           p-change-value = v-diasize-orig-frame-height
     1809                          - (frame Dialog-Frame :height-chars)
     1810         .
     1811         if p-change-value >= 0
     1812         then do:
     1813           run diasize_position-resize-button in this-procedure .
     1814           return .
     1815         end.
     1816       end.
     1817     end.
     1818     if p-change-value >= 0
     1819     then do:
     1820       assign
     1821         v-change-sign = 1
     1822       .
     1823     end.
     1824     else do:
     1825       assign
     1826         v-change-sign = -1
     1827       .
     1828     end.
     1829     assign
     1830       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1831     .
     1832     if p-change-value = 0
     1833     then do:
     1834       run diasize_position-resize-button in this-procedure .
     1835       return .
     1836     end.
     1837     move_block:
     1838     do
     1839     on error undo move_block, retry move_block
     1840     :
     1841       if retry
     1842       then do:
     1843         do
     1844         on error undo move_block, leave move_block
     1845         :
     1846           if p-change-value > 0
     1847           then do:
     1848             for each buf_temp-diasize-handle
     1849             on error undo, next
     1850             :
     1851               assign
     1852                 v-object-handle = buf_temp-diasize-handle.handle-value
     1853               .
     1854               if v-object-handle <> v-diasize-resize-button
     1855               then do:
     1856                 assign
     1857                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1858                 .
     1859               end.
     1860             end.
     1861             assign
     1862               v-diasize-browse-handle :height = v-browse-height
     1863             .
     1864             for each buf_temp-browse-handle
     1865               where buf_temp-browse-handle.browse-type = 'height':u
     1866             on error undo, next
     1867             :
     1868               assign
     1869                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1870               .
     1871             end.
     1872             assign
     1873               frame Dialog-Frame :height = v-frame-height
     1874             .
     1875             if frame Dialog-Frame :scrollable = true
     1876             then do:
     1877               assign
     1878                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1879               .
     1880             end.
     1881             run diasize_position-resize-button in this-procedure .
     1882           end.
     1883           else do:
     1884             if frame Dialog-Frame :scrollable = true
     1885             then do:
     1886               assign
     1887                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1888               .
     1889             end.
     1890             assign
     1891               frame Dialog-Frame :height = v-frame-height
     1892             .
     1893             assign
     1894               v-diasize-browse-handle :height = v-browse-height
     1895             .
     1896             for each buf_temp-browse-handle
     1897               where buf_temp-browse-handle.browse-type = 'height':u
     1898             on error undo, next
     1899             :
     1900               assign
     1901                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1902               .
     1903             end.
     1904             for each buf_temp-diasize-handle
     1905             on error undo, next
     1906             :
     1907               assign
     1908                 v-object-handle = buf_temp-diasize-handle.handle-value
     1909               .
     1910               if v-object-handle <> v-diasize-resize-button
     1911               then do:
     1912                 assign
     1913                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1914                 .
     1915               end.
     1916             end.
     1917             run diasize_position-resize-button in this-procedure .
     1918           end.
     1919           assign
     1920             v-diasize-change-size = false
     1921           .
     1922           leave move_block .
     1923         end.
     1924       end.
     1925       assign
     1926         v-diasize-need-full-display = true
     1927       .
     1928       if v-diasize-change-size = false
     1929       then do:
     1930         assign
     1931           v-diasize-change-size = true
     1932         .
     1933       end.
     1934       else do:
     1935         return .
     1936       end.
     1937       assign
     1938         v-frame-height = frame Dialog-Frame :height
     1939         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1940         v-browse-height = v-diasize-browse-handle :height
     1941       .
     1942       for each buf_temp-browse-handle
     1943         where buf_temp-browse-handle.browse-type = 'height':u
     1944       :
     1945         assign
     1946           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1947         .
     1948       end.
     1949       for each buf_temp-diasize-handle
     1950       :
     1951         delete buf_temp-diasize-handle .
     1952       end.
     1953       assign
     1954         v-field-group-handle = frame Dialog-Frame :first-child
     1955       .
     1956       do while valid-handle(v-field-group-handle)
     1957       :
     1958         assign
     1959           v-object-handle = v-field-group-handle :first-child
     1960         .
     1961         do while valid-handle(v-object-handle)
     1962         :
     1963           if  v-object-handle <> v-diasize-browse-handle :handle
     1964           and can-query(v-object-handle, "row")
     1965           and can-query(v-object-handle, "height")
     1966           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1967           then do:
     1968             find first buf_temp-browse-handle
     1969               where buf_temp-browse-handle.browse-type   = 'height':u
     1970                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1971               no-error .
     1972             if available buf_temp-browse-handle
     1973             then do:
     1974             end.
     1975             else do:
     1976               create buf_temp-diasize-handle .
     1977               assign
     1978                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1979                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1980               .
     1981             end.
     1982           end.
     1983           assign
     1984             v-object-handle = v-object-handle :next-sibling
     1985           .
     1986         end.
     1987         assign
     1988           v-field-group-handle = v-field-group-handle :next-sibling
     1989         .
     1990       end.
     1991       do with frame Dialog-Frame
     1992       :
     1993         hide v-diasize-resize-button .
     1994         assign
     1995           v-diasize-resize-button :row    = 1
     1996           v-diasize-resize-button :column = 1
     1997         .
     1998       end.
     1999       if p-change-value > 0
     2000       then do:
     2001         if frame Dialog-Frame :scrollable = true
     2002         then do:
     2003           assign
     2004             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2005             no-error .
     2006           if error-status :error
     2007           or error-status :get-message(1) <> ""
     2008           then do:
     2009             undo move_block, retry move_block .
     2010           end.
     2011         end.
     2012         assign
     2013           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2014           no-error .
     2015         if error-status :error
     2016         or error-status :get-message(1) <> ""
     2017         then do:
     2018           undo move_block, retry move_block .
     2019         end.
     2020         assign
     2021           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2022           no-error .
     2023         if error-status :error
     2024         or error-status :get-message(1) <> ""
     2025         then do:
     2026           undo move_block, retry move_block .
     2027         end.
     2028         for each buf_temp-browse-handle
     2029           where buf_temp-browse-handle.browse-type = 'height':u
     2030         on error undo move_block, retry move_block
     2031         :
     2032           assign
     2033             buf_temp-browse-handle.browse-handle :height
     2034               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2035             no-error .
     2036           if error-status :error
     2037           or error-status :get-message(1) <> ""
     2038           then do:
     2039             undo move_block, retry move_block .
     2040           end.
     2041         end.
     2042         for each buf_temp-diasize-handle
     2043         on error undo move_block, retry move_block
     2044         :
     2045           assign
     2046             v-object-handle = buf_temp-diasize-handle.handle-value
     2047           .
     2048           if v-object-handle <> v-diasize-resize-button
     2049           then do:
     2050             assign
     2051               v-object-handle :row = v-object-handle :row + p-change-value
     2052               no-error .
     2053             if error-status :error
     2054             or error-status :get-message(1) <> ""
     2055             then do:
     2056               undo move_block, retry move_block .
     2057             end.
     2058           end.
     2059         end.
     2060       end.
     2061       else do:
     2062         for each buf_temp-diasize-handle
     2063         on error undo move_block, retry move_block
     2064         :
     2065           assign
     2066             v-object-handle = buf_temp-diasize-handle.handle-value
     2067           .
     2068           if v-object-handle <> v-diasize-resize-button
     2069           then do:
     2070             assign
     2071               v-object-handle :row = v-object-handle :row + p-change-value
     2072               no-error .
     2073             if error-status :error
     2074             or error-status :get-message(1) <> ""
     2075             then do:
     2076               undo move_block, retry move_block .
     2077             end.
     2078           end.
     2079         end.
     2080         assign
     2081           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2082           no-error .
     2083         if error-status :error
     2084         or error-status :get-message(1) <> ""
     2085         then do:
     2086           undo move_block, retry move_block .
     2087         end.
     2088         for each buf_temp-browse-handle
     2089           where buf_temp-browse-handle.browse-type = 'height':u
     2090         on error undo move_block, retry move_block
     2091         :
     2092           assign
     2093             buf_temp-browse-handle.browse-handle :height
     2094               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2095             no-error .
     2096           if error-status :error
     2097           or error-status :get-message(1) <> ""
     2098           then do:
     2099             undo move_block, retry move_block .
     2100           end.
     2101         end.
     2102         assign
     2103           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2104           no-error .
     2105         if error-status :error
     2106         or error-status :get-message(1) <> ""
     2107         then do:
     2108           undo move_block, retry move_block .
     2109         end.
     2110         if frame Dialog-Frame :scrollable = true
     2111         then do:
     2112           assign
     2113             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2114             no-error .
     2115           if error-status :error
     2116           or error-status :get-message(1) <> ""
     2117           then do:
     2118             undo move_block, retry move_block .
     2119           end.
     2120         end.
     2121       end.
     2122       if p-move-resize = true
     2123       then do:
     2124         run diasize_position-resize-button in this-procedure .
     2125       end.
     2126       if v-diasize-wndstore = true
     2127       then do:
     2128         if connected("ub") = true
     2129         then do:
     2130           define variable v-cntxt-db-num        as integer   no-undo .
     2131           define variable v-cntxt-userid        as character no-undo .
     2132           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2133                                             , OUTPUT v-cntxt-userid
     2134                                             ) .
     2135           run gbl/wndsizew.p
     2136             (input  v-cntxt-db-num
     2137             ,input  v-cntxt-userid
     2138             ,input  v-diasize-proc-name
     2139             ,input  'height':u
     2140             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2141             ) .
     2142         end.
     2143       end.
     2144     end.
     2145     assign
     2146       v-diasize-change-size = false
     2147     .
     2148   end procedure.
     2149   procedure diasize_set-height :
     2150     define input  parameter p-new-height  as decimal   no-undo .
     2151     define input  parameter p-move-resize as logical   no-undo .
     2152     do
     2153     on error undo, return error return-value
     2154     :
     2155       run diasize_change-height in this-procedure
     2156         (input  (p-new-height - frame Dialog-Frame :height)
     2157         ,input  p-move-resize
     2158         ) .
     2159     end.
     2160   end procedure.
     2161   procedure diasize_change-width :
     2162     define input  parameter p-change-value as decimal   no-undo .
     2163     define input  parameter p-move-resize  as logical   no-undo .
     2164     define variable v-field-group-handle   as handle    no-undo .
     2165     define variable v-object-handle        as handle    no-undo .
     2166     define variable v-frame-width          as decimal   no-undo .
     2167     define variable v-frame-virtual-width  as decimal   no-undo .
     2168     define variable v-browse-width         as decimal   no-undo .
     2169     define variable v-window-width         as decimal   no-undo .
     2170     define variable v-window-virtual-width as decimal   no-undo .
     2171     define variable v-change-sign          as integer   no-undo .
     2172     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2173     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2174     if p-change-value > 0
     2175     then do:
     2176       if frame Dialog-Frame :width + p-change-value >
     2177           session :width-chars
     2178       then do:
     2179         assign
     2180           p-change-value = session :width-chars - frame Dialog-Frame :width
     2181         .
     2182         if p-change-value <= 0
     2183         then do:
     2184           run diasize_position-resize-button in this-procedure .
     2185           return .
     2186         end.
     2187       end.
     2188     end.
     2189     if p-change-value < 0
     2190     then do:
     2191       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2192       then do:
     2193         assign
     2194           p-change-value = v-diasize-orig-frame-width
     2195                          - frame Dialog-Frame :width
     2196         .
     2197         if p-change-value >= 0
     2198         then do:
     2199           run diasize_position-resize-button in this-procedure .
     2200           return .
     2201         end.
     2202       end.
     2203     end.
     2204     if p-change-value >= 0
     2205     then do:
     2206       assign
     2207         v-change-sign = 1
     2208       .
     2209     end.
     2210     else do:
     2211       assign
     2212         v-change-sign = -1
     2213       .
     2214     end.
     2215     assign
     2216       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2217     .
     2218     if p-change-value = 0
     2219     then do:
     2220       run diasize_position-resize-button in this-procedure .
     2221       return .
     2222     end.
     2223     move_block:
     2224     do
     2225     on error undo move_block, leave move_block
     2226     :
     2227       if retry
     2228       then do:
     2229         do
     2230         on error undo move_block, leave move_block
     2231         :
     2232           if p-change-value > 0
     2233           then do:
     2234             for each buf_temp-diasize-handle
     2235             on error undo, next
     2236             :
     2237               assign
     2238                 v-object-handle = buf_temp-diasize-handle.handle-value
     2239               .
     2240               if v-object-handle <> v-diasize-resize-button
     2241               then do:
     2242                 assign
     2243                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2244                 .
     2245               end.
     2246             end.
     2247             assign
     2248               v-diasize-browse-handle :width = v-browse-width
     2249             .
     2250             for each buf_temp-browse-handle
     2251               where buf_temp-browse-handle.browse-type = 'width':u
     2252             on error undo, next
     2253             :
     2254               assign
     2255                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2256               .
     2257             end.
     2258             assign
     2259               frame Dialog-Frame :width = v-frame-width
     2260             .
     2261             if frame Dialog-Frame :scrollable = true
     2262             then do:
     2263               assign
     2264                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2265               .
     2266             end.
     2267             run diasize_position-resize-button in this-procedure .
     2268           end.
     2269           else do:
     2270             if frame Dialog-Frame :scrollable = true
     2271             then do:
     2272               assign
     2273                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2274               .
     2275             end.
     2276             assign
     2277               frame Dialog-Frame :width = v-frame-width
     2278             .
     2279             for each buf_temp-browse-handle
     2280               where buf_temp-browse-handle.browse-type = 'width':u
     2281             on error undo, next
     2282             :
     2283               assign
     2284                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2285               .
     2286             end.
     2287             assign
     2288               v-diasize-browse-handle :width = v-browse-width
     2289             .
     2290             for each buf_temp-diasize-handle
     2291             on error undo, next
     2292             :
     2293               assign
     2294                 v-object-handle = buf_temp-diasize-handle.handle-value
     2295               .
     2296               if v-object-handle <> v-diasize-resize-button
     2297               then do:
     2298                 assign
     2299                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2300                 .
     2301               end.
     2302             end.
     2303             run diasize_position-resize-button in this-procedure .
     2304           end.
     2305           assign
     2306             v-diasize-change-size = false
     2307           .
     2308           leave move_block .
     2309         end.
     2310       end.
     2311       assign
     2312         v-diasize-need-full-display = true
     2313       .
     2314       if v-diasize-change-size = false
     2315       then do:
     2316         assign
     2317           v-diasize-change-size = true
     2318         .
     2319       end.
     2320       else do:
     2321         return .
     2322       end.
     2323       assign
     2324         v-frame-width = frame Dialog-Frame :width
     2325         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2326         v-browse-width = v-diasize-browse-handle :width
     2327       .
     2328       for each buf_temp-browse-handle
     2329         where buf_temp-browse-handle.browse-type = 'width':u
     2330       :
     2331         assign
     2332           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2333         .
     2334       end.
     2335       for each buf_temp-diasize-handle
     2336       :
     2337         delete buf_temp-diasize-handle .
     2338       end.
     2339       assign
     2340         v-field-group-handle = frame Dialog-Frame :first-child
     2341       .
     2342       do while valid-handle(v-field-group-handle)
     2343       :
     2344         assign
     2345           v-object-handle = v-field-group-handle :first-child
     2346         .
     2347         do while valid-handle(v-object-handle)
     2348         :
     2349           if  v-object-handle <> v-diasize-browse-handle :handle
     2350           and v-object-handle <> v-diasize-resize-button
     2351           and can-query(v-object-handle, "row")
     2352           and can-query(v-object-handle, "height")
     2353           and ( v-object-handle :col + v-object-handle :width
     2354                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2355               )
     2356           then do:
     2357             find first buf_temp-browse-handle
     2358               where buf_temp-browse-handle.browse-type   = 'width':u
     2359                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2360               no-error .
     2361             if available buf_temp-browse-handle
     2362             then do:
     2363             end.
     2364             else do:
     2365               create buf_temp-diasize-handle .
     2366               assign
     2367                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2368                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2369               .
     2370             end.
     2371           end.
     2372           assign
     2373             v-object-handle = v-object-handle :next-sibling
     2374           .
     2375         end.
     2376         assign
     2377           v-field-group-handle = v-field-group-handle :next-sibling
     2378         .
     2379       end.
     2380       do with frame Dialog-Frame
     2381       :
     2382         hide v-diasize-resize-button .
     2383         v-diasize-resize-button :row = 1.
     2384         v-diasize-resize-button :column = 1.
     2385       end.
     2386       if p-change-value > 0
     2387       then do:
     2388         if frame Dialog-Frame :scrollable = true
     2389         then do:
     2390           assign
     2391             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2392             no-error .
     2393           if error-status :error
     2394           or error-status :get-message(1) <> ""
     2395           then do:
     2396             undo move_block, retry move_block.
     2397           end.
     2398         end.
     2399         assign
     2400           frame Dialog-Frame :width = v-frame-width + p-change-value
     2401           no-error .
     2402         if error-status :error
     2403         or error-status :get-message(1) <> ""
     2404         then do:
     2405           undo move_block, retry move_block.
     2406         end.
     2407         assign
     2408           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2409         no-error .
     2410         if error-status :error
     2411         or error-status :get-message(1) <> ""
     2412         then do:
     2413           undo move_block, retry move_block.
     2414         end.
     2415         for each buf_temp-browse-handle
     2416           where buf_temp-browse-handle.browse-type = 'width':u
     2417         on error undo move_block, retry move_block
     2418         :
     2419           assign
     2420             buf_temp-browse-handle.browse-handle :width
     2421               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2422             no-error .
     2423           if error-status :error
     2424           or error-status :get-message(1) <> ""
     2425           then do:
     2426             undo move_block, retry move_block .
     2427           end.
     2428         end.
     2429         for each buf_temp-diasize-handle
     2430         on error undo move_block, retry move_block
     2431         :
     2432           assign
     2433             v-object-handle = buf_temp-diasize-handle.handle-value
     2434           .
     2435           if v-object-handle <> v-diasize-resize-button
     2436           then do:
     2437             assign
     2438               v-object-handle :col = v-object-handle :col + p-change-value
     2439               no-error .
     2440             if error-status :error
     2441             or error-status :get-message(1) <> ""
     2442             then do:
     2443               undo move_block, retry move_block .
     2444             end.
     2445           end.
     2446         end.
     2447       end.
     2448       else do:
     2449         for each buf_temp-diasize-handle
     2450         on error undo move_block, retry move_block
     2451         :
     2452           assign
     2453             v-object-handle = buf_temp-diasize-handle.handle-value
     2454           .
     2455           if v-object-handle <> v-diasize-resize-button
     2456           then do:
     2457             assign
     2458               v-object-handle :col = v-object-handle :col + p-change-value
     2459               no-error .
     2460             if error-status :error
     2461             or error-status :get-message(1) <> ""
     2462             then do:
     2463               undo move_block, retry move_block .
     2464             end.
     2465           end.
     2466         end.
     2467         for each buf_temp-browse-handle
     2468           where buf_temp-browse-handle.browse-type = 'width':u
     2469         on error undo move_block, retry move_block
     2470         :
     2471           assign
     2472             buf_temp-browse-handle.browse-handle :width
     2473               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2474             no-error .
     2475           if error-status :error
     2476           or error-status :get-message(1) <> ""
     2477           then do:
     2478             undo move_block, retry move_block .
     2479           end.
     2480         end.
     2481         assign
     2482           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2483           no-error .
     2484         if error-status :error
     2485         or error-status :get-message(1) <> ""
     2486         then do:
     2487           undo move_block, retry move_block.
     2488         end.
     2489         assign
     2490           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2491         no-error .
     2492         if error-status :error
     2493         or error-status :get-message(1) <> ""
     2494         then do:
     2495           undo move_block, retry move_block.
     2496         end.
     2497         if frame Dialog-Frame :scrollable = true
     2498         then do:
     2499           assign
     2500             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2501           no-error .
     2502           if error-status :error
     2503           or error-status :get-message(1) <> ""
     2504           then do:
     2505             undo move_block, retry move_block.
     2506           end.
     2507         end.
     2508       end.
     2509       if p-move-resize
     2510       then do:
     2511         run diasize_position-resize-button in this-procedure .
     2512       end.
     2513       if v-diasize-wndstore = true
     2514       then do:
     2515         if connected("ub") = true
     2516         then do:
     2517           define variable v-cntxt-db-num        as integer   no-undo .
     2518           define variable v-cntxt-userid        as character no-undo .
     2519           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2520                                             , OUTPUT v-cntxt-userid
     2521                                             ) .
     2522           run gbl/wndsizew.p
     2523             (input  v-cntxt-db-num
     2524             ,input  v-cntxt-userid
     2525             ,input  v-diasize-proc-name
     2526             ,input  'width':u
     2527             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2528             ) .
     2529         end.
     2530       end.
     2531     end.
     2532     assign
     2533       v-diasize-change-size = false
     2534     .
     2535   end procedure.
     2536   procedure diasize_set-width :
     2537     define input  parameter p-new-width  as decimal   no-undo .
     2538     define input  parameter p-move-resize as logical   no-undo .
     2539     do
     2540     on error undo, return error return-value
     2541     :
     2542       run diasize_change-width in this-procedure
     2543         (input  (p-new-width - frame Dialog-Frame :width)
     2544         ,input  p-move-resize
     2545         ) .
     2546     end.
     2547   end procedure.
     2548   procedure diasize_position-resize-button :
     2549     do with frame Dialog-Frame
     2550     :
     2551       hide v-diasize-resize-button .
     2552       assign
     2553         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2554                     - 1
     2555                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2556         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2557                     - 1
     2558                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2559       .
     2560       view v-diasize-resize-button .
     2561     end.
     2562   end procedure.
     2563   on alt-right anywhere
     2564   do:
     2565     run diasize_change-width in this-procedure
     2566       (input 1
     2567       ,input true
     2568       ) .
     2569     return no-apply .
     2570   end.
     2571   on alt-left anywhere
     2572   do:
     2573     run diasize_change-width in this-procedure
     2574       (input -1
     2575       ,input true
     2576       ) .
     2577     return no-apply .
     2578   end.
     2579   on alt-down anywhere
     2580   do:
     2581     run diasize_change-height in this-procedure
     2582       (input 1
     2583       ,input true
     2584       ) .
     2585     return no-apply .
     2586   end.
     2587   on alt-up anywhere
     2588   do:
     2589     run diasize_change-height in this-procedure
     2590       (input -1
     2591       ,input true
     2592       ) .
     2593     return no-apply .
     2594   end.
     2595   on alt-enter of frame Dialog-Frame
     2596   do:
     2597     run diasize_maximize in this-procedure
     2598       (input  ?
     2599       ).
     2600     return no-apply .
     2601   end.
     2602   procedure diasize_end-move :
     2603     do
     2604     on error undo, return error return-value
     2605     :
     2606       define variable v-row-delta as decimal   no-undo .
     2607       define variable v-col-delta as decimal   no-undo .
     2608       define variable v-new-row as decimal   no-undo .
     2609       define variable v-new-col as decimal   no-undo .
     2610       assign
     2611         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2612         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2613       .
     2614       assign
     2615         v-row-delta = v-new-row - frame Dialog-Frame :height
     2616         v-col-delta = v-new-col - frame Dialog-Frame :width
     2617       .
     2618       run diasize_change-height in this-procedure
     2619         (input v-row-delta
     2620         ,input true
     2621         ) .
     2622       run diasize_change-width in this-procedure
     2623         (input v-col-delta
     2624         ,input true
     2625         ) .
     2626     end.
     2627   end procedure.
     2628   procedure diasize_maximize :
     2629     define input  parameter p-action as logical   no-undo .
     2630     do
     2631     on error undo, return error return-value
     2632     :
     2633       if p-action = ?
     2634       then do:
     2635         if v-diasize-need-maximize = true
     2636         then do:
     2637           assign
     2638             p-action = true
     2639           .
     2640         end.
     2641         else do:
     2642           assign
     2643             p-action = false
     2644           .
     2645         end.
     2646       end.
     2647       if p-action = true
     2648       then do:
     2649         run diasize_change-height in this-procedure
     2650           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2651               - frame Dialog-Frame :height-chars
     2652           ,input true
     2653           ) .
     2654         run diasize_change-width in this-procedure
     2655           (input session :width-chars
     2656               - frame Dialog-Frame :width-chars
     2657           ,input true
     2658           ) .
     2659         assign
     2660           v-diasize-need-maximize = false
     2661         .
     2662       end.
     2663       else do:
     2664         run diasize_change-width in this-procedure
     2665           (input v-diasize-orig-frame-width
     2666               - frame Dialog-Frame :width-chars
     2667           ,input true
     2668           ) .
     2669         run diasize_change-height in this-procedure
     2670           (input v-diasize-orig-frame-height
     2671               - frame Dialog-Frame :height-chars
     2672           ,input true
     2673           ) .
     2674         assign
     2675           v-diasize-need-maximize = true
     2676         .
     2677       end.
     2678     end.
     2679   end procedure.
     2680   procedure diasize_restore-orig-size :
     2681     do
     2682     on error undo, return error return-value
     2683     :
     2684       assign
     2685         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2686         v-diasize-current-frame-height = frame Dialog-Frame :height
     2687       .
     2688       run diasize_set-height in this-procedure
     2689         (input  v-diasize-orig-frame-height
     2690         ,input  true
     2691         ) .
     2692       run diasize_set-width in this-procedure
     2693         (input  v-diasize-orig-frame-width
     2694         ,input  true
     2695         ) .
     2696     end.
     2697   end procedure.
     2698   procedure diasize_restore-current-size :
     2699     do
     2700     on error undo, return error return-value
     2701     :
     2702       run diasize_set-height in this-procedure
     2703         (input  v-diasize-current-frame-height
     2704         ,input  true
     2705         ) .
     2706       run diasize_set-width in this-procedure
     2707         (input  v-diasize-current-frame-width
     2708         ,input  true
     2709         ) .
     2710     end.
     2711   end procedure.
     2712   procedure diasize_set-browse-handle :
     2713     define input  parameter p-browse-handle as handle   no-undo .
     2714     define buffer buf_temp-browse-handle for temp-browse-handle .
     2715     do
     2716     on error undo, return error return-value
     2717     :
     2718       assign
     2719         v-diasize-browse-handle = p-browse-handle
     2720       .
     2721       for each buf_temp-browse-handle
     2722       on error undo, return error return-value
     2723       :
     2724         delete buf_temp-browse-handle .
     2725       end.
     2726     end.
     2727   end procedure.
     2728   procedure diasize_add_browse :
     2729     define input  parameter p-browse-type   as character no-undo .
     2730     define input  parameter p-browse-handle as handle    no-undo .
     2731     define buffer buf_temp-browse-handle for temp-browse-handle .
     2732     do
     2733     on error undo, return error return-value
     2734     :
     2735       assign
     2736         v-diasize-browse-number = v-diasize-browse-number + 1
     2737       .
     2738       create buf_temp-browse-handle .
     2739       assign
     2740         buf_temp-browse-handle.browse-type   = p-browse-type
     2741         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2742         buf_temp-browse-handle.browse-handle = p-browse-handle
     2743       .
     2744     end.
     2745   end procedure.
     2746   procedure diasize_init :
     2747     define variable v-default-value    as logical   no-undo .
     2748     define variable v-restore-saved    as logical   no-undo .
     2749     define variable v-resize-value-str as character no-undo .
     2750     do
     2751     on error undo, return error return-value
     2752     :
     2753       do with frame Dialog-Frame
     2754       :
     2755         assign
     2756           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2757           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2758           v-diasize-browse-handle     = browse BR-c-dis-time-rule :handle
     2759         .
     2760         create button v-diasize-resize-button
     2761         assign
     2762           parent        = frame Dialog-Frame :first-child
     2763           label         = "s"
     2764           height-pixels = 16
     2765           width-pixels  = 16
     2766           visible       = true
     2767           sensitive     = true
     2768           movable       = true
     2769           triggers:
     2770             on end-move persistent run diasize_end-move in this-procedure .
     2771           end triggers.
     2772         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2773         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2774         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2775         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2776         assign
     2777           v-diasize-wndmax = false
     2778         .
     2779         if connected("ub") = true
     2780         then do:
     2781           define variable v-cntxt-db-num        as integer   no-undo .
     2782           define variable v-cntxt-userid        as character no-undo .
     2783           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2784                                             , OUTPUT v-cntxt-userid
     2785                                             ) .
     2786           run gbl/wndpar_r.p
     2787             (input  v-cntxt-db-num
     2788             ,input  v-cntxt-userid
     2789             ,input  'wndmax':U
     2790             ,output v-diasize-wndmax
     2791             ,output v-default-value
     2792             ) .
     2793         end.
     2794         assign
     2795           v-diasize-wndstore = false
     2796         .
     2797         if connected("ub") = true
     2798         then do:
     2799           run gbl/wndpar_r.p
     2800             (input  v-cntxt-db-num
     2801             ,input  v-cntxt-userid
     2802             ,input  'wndstore':U
     2803             ,output v-diasize-wndstore
     2804             ,output v-default-value
     2805             ) .
     2806         end.
     2807         assign
     2808           v-diasize-proc-name = entry(1, program-name(2), '.')
     2809         .
     2810         if v-diasize-wndstore = true
     2811         then do:
     2812           assign
     2813             v-restore-saved = false
     2814           .
     2815           if connected("ub") = true
     2816           then do:
     2817             run gbl/wndsizer.p
     2818               (input  v-cntxt-db-num
     2819               ,input  v-cntxt-userid
     2820               ,input  v-diasize-proc-name
     2821               ,input  'height':u
     2822               ,output v-resize-value-str
     2823               ) .
     2824             if v-resize-value-str <> '':U
     2825             then do:
     2826               run diasize_change-height in this-procedure
     2827                 (input  integer(v-resize-value-str)
     2828                 ,input  true
     2829                 ) .
     2830               assign
     2831                 v-restore-saved = true
     2832               .
     2833             end.
     2834           end.
     2835           if connected("ub") = true
     2836           then do:
     2837             run gbl/wndsizer.p
     2838               (input  v-cntxt-db-num
     2839               ,input  v-cntxt-userid
     2840               ,input  v-diasize-proc-name
     2841               ,input  'width':u
     2842               ,output v-resize-value-str
     2843               ) .
     2844             if v-resize-value-str <> '':U
     2845             then do:
     2846               run diasize_change-width in this-procedure
     2847                 (input  integer(v-resize-value-str)
     2848                 ,input  true
     2849                 ) .
     2850               assign
     2851                 v-restore-saved = true
     2852               .
     2853             end.
     2854           end.
     2855           if v-restore-saved <> true
     2856           then do:
     2857             if v-diasize-wndmax = true
     2858             then do:
     2859               run diasize_maximize in this-procedure
     2860                 (input  true
     2861                 ) .
     2862             end.
     2863           end.
     2864         end.
     2865         else do:
     2866           if v-diasize-wndmax = true
     2867           then do:
     2868             run diasize_maximize in this-procedure
     2869               (input  true
     2870               ) .
     2871           end.
     2872         end.
     2873       end.
     2874     end.
     2875   end procedure.
     2876   procedure diasize_need-full-display :
     2877     define output parameter p-need-full-display as logical   no-undo .
     2878     do
     2879     on error undo, return error return-value
     2880     :
     2881       assign
     2882         p-need-full-display = v-diasize-need-full-display
     2883       .
     2884       assign
     2885         v-diasize-need-full-display = false
     2886       .
     2887     end.
     2888   end procedure.
     2889   procedure get-context :
     2890      define output parameter p-db-num as integer          no-undo.
     2891      define output parameter p-user-id as character        no-undo.
     2892      define variable v-login               as character    no-undo.
     2893      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2894      define buffer buf_user-login  for ub.user-login .
     2895      do
     2896      on error undo, return error
     2897      :
     2898            FIND FIRST buf_sys-ctrl no-lock.
     2899            ASSIGN
     2900               v-login = USERID("ub")
     2901               p-db-num = buf_sys-ctrl.db-num
     2902            .
     2903            FIND FIRST buf_user-login
     2904                 WHERE buf_user-login.db-num = p-db-num
     2905                   AND buf_user-login.user-login = v-login
     2906                 no-lock
     2907                 no-error
     2908                 .
     2909            IF AVAILABLE buf_user-login
     2910            THEN DO:
     2911               assign
     2912                  p-user-id = buf_user-login.user-id
     2913               .
     2914            END.
     2915      end.
     2916   end procedure.
     2917   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2918   on f5 of frame Dialog-Frame anywhere
     2919   do:
     2920     v-doc-rec = recid(X_c-dis-time-rule). run OpenBr in this-procedure ( input yes, input no, input '':U). reposition br-c-dis-time-rule to recid v-doc-rec no-error. v-doc-rec = ?.               APPLY 'VALUE-CHANGED' to br-c-dis-time-rule.
     2921       apply "VALUE-CHANGED" to br-c-dis-time-rule.
     2922   end.
     2923   def var sort-labelbr-c-dis-time-rule   as character no-undo .
     2924   def var sort-clmnbr-c-dis-time-rule    as handle    no-undo .
     2925   def var cur-clmnbr-c-dis-time-rule     as handle    no-undo .
     2926   def var cur-clmn-locbr-c-dis-time-rule as integer   no-undo .
     2927   def var re-querybr-c-dis-time-rule     as logical   initial no no-undo .
     2928   on start-search, ctrl-o of br-c-dis-time-rule in frame Dialog-Frame do:
     2929      run sort-brbr-c-dis-time-rule
     2930        (input (if available X_c-dis-time-rule
     2931                then recid(X_c-dis-time-rule)
     2932                else ?
     2933               )
     2934        ).
     2935   end.
     2936   PROCEDURE sort-brbr-c-dis-time-rule :
     2937     define input parameter p-recid as recid no-undo .
     2938     if re-querybr-c-dis-time-rule = no then do:
     2939       assign
     2940          cur-clmnbr-c-dis-time-rule = br-c-dis-time-rule:current-column in frame Dialog-Frame
     2941       .
     2942       if sort-clmnbr-c-dis-time-rule <> ? then sort-clmnbr-c-dis-time-rule:column-fgcolor = 0.
     2943       if cur-clmnbr-c-dis-time-rule = sort-clmnbr-c-dis-time-rule then do:
     2944         assign
     2945            sort-labelbr-c-dis-time-rule = ""
     2946            sort-clmnbr-c-dis-time-rule = ?
     2947         .
     2948        end.
     2949        else do:
     2950          assign
     2951            sort-labelbr-c-dis-time-rule = cur-clmnbr-c-dis-time-rule:label
     2952            sort-clmnbr-c-dis-time-rule  = cur-clmnbr-c-dis-time-rule
     2953            sort-clmnbr-c-dis-time-rule:column-fgcolor = 4
     2954          .
     2955        end.
     2956      end.
     2957     assign
     2958       cur-clmn-locbr-c-dis-time-rule = 1
     2959     .
     2960     def var column-handle as handle no-undo .
     2961     column-handle = br-c-dis-time-rule:first-column.
     2962     do while valid-handle(column-handle) :
     2963       if column-handle = cur-clmnbr-c-dis-time-rule then do:
     2964         leave .
     2965       end.
     2966       column-handle = column-handle:NEXT-COLUMN.
     2967       assign
     2968         cur-clmn-locbr-c-dis-time-rule = cur-clmn-locbr-c-dis-time-rule + 1
     2969       .
     2970     end.
     2971     case sort-labelbr-c-dis-time-rule:
     2972           when X_c-dis-time-rule.time-rule-num:label in browse br-c-dis-time-rule then DO:    assign       sort-column-name = "X_c-dis-time-rule.time-rule-num"     .     run OpenBr in this-procedure ( input YES, input NO, input '':U).   . END.
     2973       otherwise do:
     2974         assign
     2975           sort-column-name = ""
     2976         .
     2977         run OpenBr in this-procedure ( input YES, input NO, input '':U).
     2978           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-c-dis-time-rule') then do:
     2979             run mv-brw-defaultbr-c-dis-time-rule.
     2980           end.
     2981         if sort-labelbr-c-dis-time-rule <> "" then do:
     2982           assign
     2983             cur-clmnbr-c-dis-time-rule:column-fgcolor = 0
     2984           .
     2985         end.
     2986         assign
     2987           cur-clmn-locbr-c-dis-time-rule = ?
     2988         .
     2989       end.
     2990     end case.
     2991       if cur-clmn-locbr-c-dis-time-rule <> ? then do:
     2992         if can-do( this-procedure:internal-entries, 'ch-clmnbr-c-dis-time-rule') then do:
     2993           run ch-clmnbr-c-dis-time-rule in this-procedure (cur-clmn-locbr-c-dis-time-rule).
     2994         end.
     2995       end.
     2996     if p-recid <> ? then do:
     2997       reposition br-c-dis-time-rule to recid p-recid no-error.
     2998       apply "value-changed" to br-c-dis-time-rule in frame Dialog-Frame.
     2999     end.
     3000     apply "entry" to br-c-dis-time-rule in frame Dialog-Frame.
     3001   END PROCEDURE.
     3002   procedure re-open-query-srt-clmnbr-c-dis-time-rule:
     3003   if cur-clmnbr-c-dis-time-rule = ? then do:
     3004      run OpenBr in this-procedure ( input YES, input NO, input '':U).
     3005   end.
     3006   else do:
     3007      assign re-querybr-c-dis-time-rule = yes.
     3008      run sort-brbr-c-dis-time-rule
     3009        (input (if available X_c-dis-time-rule
     3010                then recid(X_c-dis-time-rule)
     3011                else ?
     3012               )
     3013        ).
     3014      assign re-querybr-c-dis-time-rule = no.
     3015   end.
     3016   end.
     3017   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3018   do:
     3019     br-c-dis-time-rule :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3020   end.
     3021   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3022   procedure set-filter-name :
     3023   define input parameter p-filter-name as character no-undo .
     3024     do with frame Dialog-Frame:
     3025       if p-filter-name > "" then do:
     3026         assign
     3027           frame Dialog-Frame:title
     3028             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3029         .
     3030         assign
     3031           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3032         .
     3033       end.
