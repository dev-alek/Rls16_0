        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER pcase as integer no-undo.
        3   DEFINE INPUT PARAMETER g-cond as char no-undo.
        4   DEFINE INPUT PARAMETER g-list as char no-undo.
        5   DEFINE INPUT PARAMETER g-stat as char no-undo.
        6   DEFINE INPUT PARAMETER flt-rec as recid no-undo.
        7   DEFINE OUTPUT PARAMETER loc#log as logical no-undo.
        8   DEFINE OUTPUT PARAMETER loc-contin as logical no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: gdsrepos.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: ref/gdsrepos.p $":U .
       14   define variable vss-description as character no-undo init "mess для Справочник товаров.".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   DEFINE VARIABLE choice as integer no-undo.
       74   CASE pcase:
       75     WHEN 1 then do:
       76       loc#log = yes.
       77       if flt-rec <> ? then do:
       78         loc#log = no.
       79         message "Поиск ПО ВСЕМ товарам." skip(1)
       80         "ТОВАР НАЙДЕН." skip (2)
       81         "Но фильтр по кнопке <<ФИЛЬТР>> : включен"
       82         " - поэтому найденный товар не виден." skip (2)
       83         "Выключите фильтр"
       84         view-as alert-box Warning.
       85       end.
       86       else do:
       87         message "Поиск ПО ВСЕМ товарам." skip(1)
       88         "ТОВАР НАЙДЕН." skip (2)
       89         "Но сейчас включено : " skip
       90         "Справочник : " g-list skip
       91         "Статус : " g-stat skip
       92         "Фильтр Все/Объект/Факт/Свободно: " g-cond skip
       93         " - поэтому найденный товар не виден." skip (2)
       94         "Переключить" skip
       95         "Справочник, Статус и Фильтр в положение 'Все' ?"
       96         view-as alert-box question buttons OK-Cancel update loc#log.
       97       end.
       98     END.
       99     WHEN 2 then do:
      100       loc-contin = yes.
      101       if flt-rec <> ? then do:
      102         loc-contin = no.
      103         message "Поиск ПО ВСЕМ товарам." skip(1)
      104         "ТОВАР НАЙДЕН." skip (2)
      105         "Но фильтр по кнопке <<ФИЛЬТР>> : включен" skip
      106         " - поэтому найденный товар не виден." skip (2)
      107         "Выключите фильтр"
      108         view-as alert-box Warning.
      109         loc-contin = ?.
      110       end.
      111       else do:
      112         run gbl/d-askw.w (input "Поиск ПО ВСЕМ товарам",
      113                      input ("ТОВАР НАЙДЕН ." + chr(10) + chr(10) + "Но сейчас включено :" + chr(10) +
      114                             "Справочник : " + g-list + chr(10) + "Статус : " + g-stat +
      115                             chr(10) + "Фильтр : " + g-cond + chr(10) + " - поэтому найденный товар не виден."
      116                             ),
      117                      input "|",
      118                      input ("Продолжать искать|Переключить Справочник, Статус и Фильтр в положение ВСЕ|Отменить"),
      119                      Input "||",
      120                      input 2,
      121                      input 3,
      122                      output choice).
      123         if choice = 1 then loc-contin = yes.
      124         else if choice = 2 then loc-contin = no.
      125         else loc-contin = ?.
      126       end.
      127     END.
      128   END CASE.
