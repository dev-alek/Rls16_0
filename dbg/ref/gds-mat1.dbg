      904      if l_Is-Fin_This-Procedure THEN DO:
      905   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      906   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      907     (output v-db-num
      908     )  .
      909   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      910   do:
      911     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      912       (input  v-db-num
      913       ,input  g#userid
      914       ,input  0
      915       ,input  'actn_assort-matr_add-no-gds':U
      916       ,input  'global':U
      917       ,input  0
      918       ,input  '':U
      919       ,input  0
      920       ,input  0
      921       ,input  0
      922       ,input  0
      923       ,input  false
      924       ,output l_Is-Add-no-gds_This-Procedure
      925       )  .
      926   end.
      927         if NOT l_Is-Add-no-gds_This-Procedure  THEN DO:
      928            ASSIGN
      929               c_Error_This-Procedure = RETURN-VALUE.
      930         END.
      931      END.
      932      RETURN.
      933   END PROCEDURE.
      934   procedure main_gds-mat1 :
      935   define input  parameter p-handle as handle no-undo .
      936   define input-output parameter p-doc-rec   as recid no-undo.
      937   define input parameter p-mode             as character no-undo .
      938   define input parameter p-id               like ub.assortment-matrix.asmt-id   no-undo .
      939   define input parameter p-db-num           like ub.assortment-matrix.db-num    no-undo .
      940   define input parameter p-gds-code         like ub.assortment-matrix-goods.gds-code  no-undo .
      941   define input parameter p-des              like ub.assortment-matrix-goods.asmg-des  no-undo .
      942     do
      943     on error undo, return error return-value
      944     :
      945   if p-mode <> 'ДОБАВЛЕНИЕ':U AND p-mode <> 'ИЗМЕНЕНИЕ':U  then do:
      946     message
      947     vss-workfile vss-revision vss-description skip
      948     "Неверный параметр p-mode" p-mode
      949     view-as alert-box error .
      950     return error '':u.
      951   end.
      952   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      953   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      954     (output v-db-num
      955     )  .
      956   define variable v-date as date no-undo .
      957   define variable v-time as integer no-undo .
      958   define buffer buf_assortment-matrix for ub.assortment-matrix .
      959   define buffer new_assortment-matrix-goods for ub.assortment-matrix-goods  .
      960   define buffer old_assortment-matrix-goods for ub.assortment-matrix-goods  .
      961   define buffer buf_goods for ub.goods  .
      962   define variable v-flaf as logical   no-undo .
      963   v-flaf = false .
      964   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      965   find first buf_assortment-matrix no-lock where
      966              buf_assortment-matrix.asmt-id =  p-id       and
      967              buf_assortment-matrix.db-num  =  p-db-num no-error .
      968              if error-status :error then return error error-status :get-message(1)  .
      969   run cur-time in this-procedure(output v-date, output v-time).
      970     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      971        if l_Is-Fin_This-Procedure
      972           AND (NOT Is-Goods-in-Cont-Spec(p-gds-code))
      973           AND (l_Is-Add-no-gds_This-Procedure <> TRUE )
      974           THEN DO:
      975           RETURN ERROR c_Error_This-Procedure + chr(10) + "Код товара (gds-code)=" + STRING(p-gds-code).
      976        END.
      977     find first new_assortment-matrix-goods exclusive-lock where
      978                new_assortment-matrix-goods.gds-code           = p-gds-code and
      979                new_assortment-matrix-goods.asmt-id            = p-id       and
      980                new_assortment-matrix-goods.db-num             = p-db-num
      981                no-error .
      982           if available new_assortment-matrix-goods then do:
      983               if new_assortment-matrix-goods.asmg-status  = 0 then p-mode = 'ИЗМЕНЕНИЕ':U .
      984               else do:
      985                   run ass-grp-gds-code-yes (
      986                       input  p-gds-code   ,
      987                       input  buf_goods.grp-code ,
      988                       input  p-id         ,
      989                       input  p-db-num     ,
      990                       output p-ask        ) no-error .
      991                       if error-status :error  or p-ask = false  then do:
      992                           return error substitute ( "Нельзя добавлять товар &1 &2 в Ассортиментную матрицу &3(&4) из-за ограничения по ассортименту в группе &5 &6 " ,buf_goods.gds-code  , buf_goods.gds-name , p-id ,p-db-num , return-value , chr(10) ).
      993                       end.
      994               end.
      995               assign
      996                 new_assortment-matrix-goods.asmg-date-update   = v-date
      997                 new_assortment-matrix-goods.asmg-db-num-update = g#db-num
      998                 new_assortment-matrix-goods.asmg-status        = 0
      999                 new_assortment-matrix-goods.asmg-time-update   = v-time
     1000                 new_assortment-matrix-goods.asmg-who-update    = g#userid
     1001                 new_assortment-matrix-goods.asmt-id            = p-id
     1002                 .
     1003           end.
     1004           else do:
     1005               run  ass-grp-gds-code-yes (
     1006                   input  p-gds-code   ,
     1007                   input  buf_goods.grp-code ,
     1008                   input  p-id         ,
     1009                   input  p-db-num     ,
     1010                   output p-ask        ) no-error .
     1011                   if error-status :error  or p-ask = false  then do:
     1012                       return error substitute (
     1013                       "Нельзя добавлять товар &1 &2 в Ассортиментную матрицу &3(&4) из-за ограничения по ассортименту в группе &5&6", buf_goods.gds-code  ,buf_goods.gds-name  , p-id ,p-db-num , return-value , chr(10)  ).
     1014                   end.
     1015               create ub.assortment-matrix-goods.
     1016               assign
     1017                 ub.assortment-matrix-goods.asmg-date-create   = v-date
     1018                 ub.assortment-matrix-goods.asmg-date-update   = v-date
     1019                 ub.assortment-matrix-goods.asmg-db-num-create = g#db-num
     1020                 ub.assortment-matrix-goods.asmg-db-num-update = g#db-num
     1021                 ub.assortment-matrix-goods.asmg-status        = 0
     1022                 ub.assortment-matrix-goods.asmg-time-create   = v-time
     1023                 ub.assortment-matrix-goods.asmg-time-update   = v-time
     1024                 ub.assortment-matrix-goods.asmg-who-create    = g#userid
     1025                 ub.assortment-matrix-goods.asmg-who-update    = g#userid
     1026                 ub.assortment-matrix-goods.asmt-id            = p-id
     1027                 ub.assortment-matrix-goods.db-num             = p-db-num
     1028                 ub.assortment-matrix-goods.gds-code           = p-gds-code
     1029                 ub.assortment-matrix-goods.asmg-des           = p-des
     1030                 .
     1031                 FIND FIRST  new_assortment-matrix-goods exclusive-lock  where
     1032                     new_assortment-matrix-goods.asmt-id  = p-id and
     1033                     new_assortment-matrix-goods.db-num   = p-db-num   no-error .
     1034           end.
     1035           p-doc-rec = recid(new_assortment-matrix-goods)   .
     1036     end.
     1037     else do:
     1038       FIND FIRST  new_assortment-matrix-goods exclusive-lock where
     1039            recid (new_assortment-matrix-goods) = p-doc-rec No-ERROR.
     1040       if not available new_assortment-matrix-goods then do:
     1041          message
     1042           vss-workfile vss-revision vss-description skip
     1043           "Не найдена запись - p-doc-rec" p-doc-rec
     1044           view-as alert-box error .
     1045           undo, return error '':u.
     1046       end.
     1047       if new_assortment-matrix-goods.asmt-id <> p-id
     1048       then do:
     1049         message
     1050           vss-workfile vss-revision vss-description skip
     1051           "Для уже имеющейся записи нельзя изменить"
     1052           "внутренний код" skip
     1053           view-as alert-box ERROR.
     1054           undo, return error '':U.
     1055       end.
     1056       if new_assortment-matrix-goods.asmg-status <> 0 then v-flaf = true .
     1057     end.
     1058     assign
     1059       new_assortment-matrix-goods.asmg-des    = p-des
     1060       new_assortment-matrix-goods.asmg-status = 0
     1061     .
     1062     if v-flaf or p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1063     end.
     1064   end.
     1065   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1066       run chg-izt-proc
     1067       ( p-gds-code,
     1068         buffer buf_assortment-matrix )
     1069         no-error .
     1070         if error-status :error then do:
     1071         end.
     1072   end.
     1073     define variable v-econom as logical   no-undo .
     1074     v-econom = false .
     1075     run econom-mode in p-handle  (output v-econom ) no-error .
     1076     if not v-econom  then do:
     1077        run translate-to-other-gds (
     1078             p-id       ,
     1079             p-db-num   ,
     1080             p-gds-code ,
     1081             0 ) .
     1082          if v-longchar-asstro <> "" then do:
     1083            run correct-message in p-handle  (input v-longchar-asstro ) no-error .
     1084            v-longchar-asstro =  "".
     1085          end.
     1086     end.
     1087   end procedure.
     1088   procedure chg-izt-proc :
     1089   define input     parameter p-gds-code                   as integer   no-undo .
     1090   define parameter buffer buf_assortment-matrix for ub.assortment-matrix .
     1091   define buffer buf_goods for ub.goods.
     1092   define variable v-gds-prop-recid as recid no-undo .
     1093     do
     1094     on error undo, return error return-value
     1095     :
     1096     if buf_assortment-matrix.obj-type <> "" and buf_assortment-matrix.obj-type <> ? then do:
     1097           run gds-ind1
     1098               ( input-output v-gds-prop-recid
     1099               ,  p-gds-code
     1100               ,  buf_assortment-matrix.obj-type
     1101               ,  buf_assortment-matrix.obj-code
     1102               , 'Новинка':U
     1103               , ?
     1104               , ?
     1105               , ?
     1106               , ?
     1107               , ?
     1108               )  no-error .
     1109               if error-status :error then do:
     1110                   message vss-workfile vss-revision vss-description skip
     1111                     error-status :get-message(1) skip
     1112                     return-value
     1113                     skip "Ошибка внутр. процедуры gds-ind1"
     1114                     view-as alert-box error .
     1115               end.
     1116     end.
     1117     end.
     1118   end procedure.
     1119   procedure main_gds-mat2 :
     1120     define input parameter p-handle as handle no-undo .
     1121     define input parameter p-recid  as recid  no-undo.
     1122     define input-output parameter p-asmg-status like ub.assortment-matrix-goods.asmg-status no-undo .
     1123     define input parameter p-mess as logical   no-undo .
     1124     do
     1125     on error undo, return error return-value
     1126     :
     1127   define buffer bf-assortment-matrix-goods for ub.assortment-matrix-goods.
     1128   define variable loc#log as logical no-undo .
     1129   define variable choice as logical no-undo .
     1130   define variable v-old-asmg-status like ub.assortment-matrix-goods.asmg-status no-undo .
     1131   define variable v-db-num as integer   no-undo .
     1132   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1133   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1134     (output v-db-num
     1135     )  .
     1136   define buffer buf_goods for ub.goods  .
     1137   define variable v-gds-code as integer   no-undo .
     1138   define variable v-id       as integer   no-undo .
     1139   define variable v-db-num1  as integer   no-undo .
     1140   find first bf-assortment-matrix-goods exclusive-lock where
     1141              recid(bf-assortment-matrix-goods) = p-recid.
     1142     v-id       = bf-assortment-matrix-goods.asmt-id .
     1143     v-db-num1   = bf-assortment-matrix-goods.db-num  .
     1144   find first buf_goods no-lock where buf_goods.gds-code = bf-assortment-matrix-goods.gds-code no-error .
     1145    v-gds-code  = buf_goods.gds-code .
     1146    choice = true .
     1147   define buffer buf_assortment-matrix for ub.assortment-matrix .
     1148   find first buf_assortment-matrix no-lock where
     1149              buf_assortment-matrix.asmt-id =  bf-assortment-matrix-goods.asmt-id and
     1150              buf_assortment-matrix.db-num  =  bf-assortment-matrix-goods.db-num
     1151              no-error .
     1152              if error-status :error then return error error-status :get-message(1)  .
     1153   v-old-asmg-status = bf-assortment-matrix-goods.asmg-status.
     1154   if p-asmg-status = ? then do:
     1155     CASE v-old-asmg-status:
     1156       when integer('0':U) then do:
     1157         assign
     1158         p-asmg-status = integer('1':U).
     1159       end.
     1160       when integer('1':U) then do:
     1161         assign
     1162         p-asmg-status = integer('0':U).
     1163       end.
     1164     END CASE.
     1165   end.
     1166   CASE p-asmg-status:
     1167     WHEN integer('0':U) then do:
     1168       if integer('0':U) = bf-assortment-matrix-goods.asmg-status  then do:
     1169         if p-mess then message "Запись уже имеет статус ТЕКУЩИЙ!"
     1170                                 view-as alert-box ERROR.
     1171         p-asmg-status = ?.
     1172         return error.
     1173       end.
     1174       else do:
     1175         if p-mess then do:
     1176             message  "Запись уже удалена - восстановить?"
     1177                      view-as alert-box QUestion buttons YEs-no update choice.
     1178          end.
     1179       end.
     1180     end.
     1181     WHEN integer('1':U) then do:
     1182       if integer('1':U) = bf-assortment-matrix-goods.asmg-status  then do:
     1183         if p-mess then message "Запись уже имеет статус УДАЛЕН!"
     1184                                 view-as alert-box ERROR.
     1185         p-asmg-status = ?.
     1186         return error.
     1187       end.
     1188       else do:
     1189         if p-mess then  do:
     1190             message  "Удалить строку в  Ассортиментной матрице?"
     1191                      view-as alert-box QUestion buttons yes-no update choice.
     1192          end.
     1193       end.
     1194     end.
     1195   END CASE.
     1196   if p-asmg-status  = 0 then do:
     1197       define variable p-ask as logical   no-undo .
     1198       run ass-grp-gds-code-yes (
     1199           input  buf_goods.gds-code ,
     1200           input  buf_goods.grp-code ,
     1201           input  v-id          ,
     1202           input  v-db-num1     ,
     1203           output p-ask        ) no-error .
     1204           if error-status :error  or p-ask = false  then do:
     1205             message substitute("Нельзя добавлять товар &1 &2 в Ассортиментную матрицу  &4(&5) из-за ограничения по ассортименту в группе &3", buf_goods.gds-code  ,buf_goods.gds-name , return-value ,
     1206               v-id ,  v-db-num1 ) skip
     1207               return-value skip error-status :get-message(1)
     1208               view-as alert-box information .
     1209               undo , return error substitute("Нельзя добавлять товар &1 &2 в Ассортиментную матрицу  &4(&5) из-за ограничения по ассортименту в группе &3 &6", buf_goods.gds-code  ,buf_goods.gds-name , return-value ,
     1210                                             v-id ,  v-db-num1 , chr(10) ) .
     1211           end.
     1212   end.
     1213   define variable p-ok as logical no-undo .
     1214    define variable v-err-str as character no-undo .
     1215    v-err-str = "" .
     1216   if choice then do:
     1217      if integer('1':U) = p-asmg-status  then do:
     1218         run chg-izt-proc2 (
     1219             buffer buf_assortment-matrix ,
     1220             buffer bf-assortment-matrix-goods ,
     1221             output p-ok ) .
     1222         if p-ok =  false then do:
     1223             assign
     1224               bf-assortment-matrix-goods.asmg-status = p-asmg-status
     1225               v-err-str = ""
     1226             .
     1227         end.
     1228         else do:
     1229            v-err-str =  substitute("НЕ УДАЛИЛИ из матрицы, так как сработало правило в событие <УДАЛЕНИЕ товара из матрицы>  &1" , "" ) .
     1230         end.
     1231      end.
     1232      else do:
     1233         assign
     1234           bf-assortment-matrix-goods.asmg-status = p-asmg-status
     1235         .
     1236       end.
     1237   end.
     1238     release bf-assortment-matrix-goods no-error .
     1239     if error-status:error then do:
     1240       p-asmg-status = ?.
     1241       message
     1242       "Ошибка при сохранении записи Ассортиментной Матрицы" skip
     1243       error-status:get-message(1) skip
     1244       return-value
     1245       view-as alert-box error .
     1246       undo , return error .
     1247     end.
     1248     define variable v-econom as logical   no-undo .
     1249     v-econom = false .
     1250     run econom-mode in p-handle  (output v-econom ) no-error .
     1251     if not v-econom  then do:
     1252        run translate-to-other-gds (
     1253             v-id       ,
     1254             v-db-num   ,
     1255             v-gds-code ,
     1256             p-asmg-status ) no-error .
     1257          if v-longchar-asstro <> "" or v-err-str <> "" then do:
     1258              run correct-message in p-handle  (input v-longchar-asstro + " " + v-err-str) no-error .
     1259          end.
     1260     end.
     1261   return v-err-str .
     1262   end.
     1263   end procedure.
     1264   procedure chg-izt-proc2 :
     1265   define parameter buffer buf_assortment-matrix for ub.assortment-matrix .
     1266   define parameter buffer bf-assortment-matrix-goods for ub.assortment-matrix-goods .
     1267   define output parameter choice2 as logical   no-undo  .
     1268     do
     1269     on error undo, return error return-value
     1270     :
     1271   define buffer buf_goods for ub.goods.
     1272   define buffer buf_gds-obj for ub.gds-obj  .
     1273   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
     1274   define variable v-amin  as logical   no-undo .
     1275   define variable v-izt   as character no-undo .
     1276   define variable v-gdop-min-stock                as decimal   no-undo .
     1277   define variable v-grop-max-stock                as decimal   no-undo .
     1278   define variable v-grop-level-always-presence    as decimal   no-undo .
     1279   define variable v-grop-min-order                as decimal   no-undo .
     1280   define variable p-old  as character no-undo .
     1281   define variable p-new  as character no-undo .
     1282   define variable v-gds-prop-recid as recid no-undo .
     1283   define variable v-event-code as character no-undo .
     1284   define variable v-izt-new    as logical   no-undo .
     1285   define variable v-izt-com    as logical   no-undo .
     1286   define variable v-izt-del    as logical   no-undo .
     1287   define variable v-izt-spec   as logical   no-undo .
     1288   define variable v-izt-empty  as logical   no-undo .
     1289   choice2 = false .
     1290     if buf_assortment-matrix.obj-type <> "" and buf_assortment-matrix.obj-type <> ? then do:
     1291   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1292   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     1293     (input  buf_assortment-matrix.obj-type
     1294     ,input  buf_assortment-matrix.obj-code
     1295     ,input  ?
     1296     ,input  ?
     1297     ,input  ?
     1298     ,input  bf-assortment-matrix-goods.gds-code
     1299     ,output v-amin
     1300     ,output v-izt
     1301     ,output v-gdop-min-stock
     1302     ,output v-grop-max-stock
     1303     ,output v-grop-level-always-presence
     1304     ,output v-grop-min-order
     1305     )  .
     1306         find first buf_goods no-lock where
     1307                    buf_goods.gds-code = bf-assortment-matrix-goods.gds-code no-error .
     1308                    if not available buf_goods then return error error-status :get-message(1) .
     1309         find first buf_gds-obj no-lock where
     1310                    buf_gds-obj.gds-code = bf-assortment-matrix-goods.gds-code and
     1311                    buf_gds-obj.obj-type = buf_assortment-matrix.obj-type and
     1312                    buf_gds-obj.obj-code = buf_assortment-matrix.obj-code
     1313                    no-error .
     1314            if available buf_gds-obj and buf_gds-obj.fact-qnty <> 0 then do:
     1315                v-event-code = 'delete-matr-rest':U .
     1316            end.
     1317            else do:
     1318               v-event-code = 'delete-matr-norest':U .
     1319            end.
     1320   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1321   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run iztrul in g#library2
     1322     (input  v-event-code
     1323     ,output v-izt-new
     1324     ,output v-izt-com
     1325     ,output v-izt-del
     1326     ,output v-izt-spec
     1327     ,output v-izt-empty
     1328     )  .
     1329         case v-izt :
     1330         when 'На вывод из ассортимента':U
     1331         then do:
     1332           choice2 = true .
     1333           if v-izt-del = false then  choice2 = true  .
     1334                                else  choice2 = false .
     1335           if choice2 = true  then do:
     1336           if v-amin = true then do:
     1337               message "У товара " buf_goods.artic  buf_goods.gds-name skip
     1338                         "ИЖТ = " v-izt skip
     1339               substitute ("Остаток товара на  &1 &2 = &3" , buf_gds-obj.obj-type , buf_gds-obj.obj-code , buf_gds-obj.fact-qnty )
     1340               skip
     1341               if v-amin = true then "входит в Ассортиментный минимум" else ""
     1342               skip
     1343               "Оставляем его в Ассортиментной матрице ? "
     1344               view-as alert-box question buttons yes-no update choice2 .
     1345           end.
     1346           end.
     1347         end.
     1348         when "" or when ? or when 'Пусто':U
     1349         then do:
     1350           if v-izt-empty = false then   choice2 = true .
     1351                                  else   choice2 = false .
     1352         end.
     1353         otherwise do:
     1354             message "Удалить можно только тоавары с ИЖТ" 'На вывод из ассортимента':U skip
     1355               buf_goods.artic buf_goods.gds-name "пропускаем"
     1356               view-as alert-box information .
     1357               choice2 = true.
     1358         end.
     1359         end case.
     1360         if choice2 = false then do:
     1361             p-old = 'На вывод из ассортимента':U    .
     1362             p-new = 'Пусто':U  .
     1363           find first buf_gds-obj-prop no-lock  where
     1364                      buf_gds-obj-prop.gds-code = buf_goods.gds-code and
     1365                      buf_gds-obj-prop.obj-code = buf_assortment-matrix.obj-code and
     1366                      buf_gds-obj-prop.obj-type = buf_assortment-matrix.obj-type no-error .
     1367              if not available buf_gds-obj-prop then
     1368              do:
     1369                  run gds-ind1
     1370                   ( input-output v-gds-prop-recid
     1371                   , bf-assortment-matrix-goods.gds-code
     1372                   , buf_assortment-matrix.obj-type
     1373                   , buf_assortment-matrix.obj-code
     1374                   , p-new
     1375                   , ?
     1376                   , ?
     1377                   , ?
     1378                   , ?
     1379                   , ?
     1380                   )   .
     1381                 end.
     1382                 else do:
     1383                     if buf_gds-obj-prop.gdop-igt = p-old then do:
     1384                         run gds-ind1
     1385                             (input-output v-gds-prop-recid
     1386                             ,buf_gds-obj-prop.gds-code
     1387                             ,buf_gds-obj-prop.obj-type
     1388                             ,buf_gds-obj-prop.obj-code
     1389                             ,p-new
     1390                             ,?
     1391                             ,?
     1392                             ,?
     1393                             ,?
     1394                             ,?
     1395                             )  .
     1396                     end.
     1397                 end.
     1398         end.
     1399     end.
     1400     end.
     1401   end procedure.
     1402   procedure clear-longmess :
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406       v-longchar-asstro = "".
     1407     end.
     1408   end procedure.
