        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: gds-mat1.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: ref/gds-mat1.p $":U .
        7   define variable vss-description as character no-undo init "Общая процедура для изменений и добавлений товара в Ассортиментную матрицу".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   procedure cur-time :
       79      define output parameter p-today as date      no-undo .
       80      define output parameter p-time  as integer   no-undo .
       81     do
       82     on error undo, return error
       83     :
       84       define variable v-date1 as date      no-undo .
       85       define variable v-date2 as date      no-undo .
       86       define variable v-time  as integer   no-undo .
       87       assign
       88         v-date1 = today
       89         v-time  = time
       90         v-date2 = today
       91       .
       92       if v-date1 <> v-date2
       93       then do:
       94         assign
       95           v-date1 = today
       96           v-time  = v-time
       97         .
       98       end.
       99       assign
      100         p-today = v-date1
      101         p-time  = v-time
      102       .
      103     end.
      104   end.
      105   function cur-time-date returns character
      106   :
      107     return string(today, '99/99/9999':U) .
      108   end.
      109   function cur-time-mjd returns decimal
      110   :
      111     define variable v-date as date      no-undo .
      112     define variable v-time as integer   no-undo .
      113     run cur-time in this-procedure
      114       (output v-date
      115       ,output v-time
      116       ) .
      117     return integer(v-date) - 2400002 + (v-time / 86400) .
      118   end.
      119   function cur-time-get-ending-index returns integer
      120   (input p-number as integer
      121   )
      122   :
      123     if p-number < 0
      124     or p-number = ?
      125     then do:
      126       return 1 .
      127     end.
      128     define variable v-rest as integer   no-undo .
      129     assign
      130       p-number = p-number modulo 100
      131     .
      132     if p-number < 20
      133     then do:
      134       assign
      135         v-rest = p-number
      136       .
      137     end.
      138     else do:
      139       assign
      140         v-rest = p-number modulo 10
      141       .
      142     end.
      143     case v-rest :
      144       when 1
      145       then do:
      146         return 2 .
      147       end.
      148       when 2 or
      149       when 3 or
      150       when 4
      151       then do:
      152         return 3 .
      153       end.
      154       otherwise do:
      155         return 1 .
      156       end.
      157     end case .
      158   end.
      159   procedure cur-time-mjd-to-date :
      160      define input  parameter i-mjd-diff as decimal no-undo.
      161      define output parameter o-Date     as date    no-undo.
      162      define output parameter o-Time     as integer no-undo.
      163      define variable v-day-number as integer   no-undo .
      164      if    i-mjd-diff < 0
      165         or i-mjd-diff = ?
      166      then do:
      167         return "?" .
      168      end.
      169      assign
      170         v-day-number = truncate(i-mjd-diff,0).
      171         o-Date = date(v-day-number + 2400002).
      172         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      173     .
      174   end.
      175   function cur-time-mjd-to-string returns character
      176   (input p-mjd-diff as decimal
      177   )
      178   :
      179     define variable v-day-number as integer   no-undo .
      180     define variable v-seconds    as integer   no-undo .
      181     define variable v-hour       as integer   no-undo .
      182     define variable v-min        as integer   no-undo .
      183     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      184     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      185     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      186     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      187     if p-mjd-diff < 0
      188     or p-mjd-diff = ?
      189     then do:
      190       return "?" .
      191     end.
      192     assign
      193       v-day-number = integer(truncate(p-mjd-diff,0))
      194       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      195     .
      196     if v-seconds > 86400
      197     then do:
      198       assign
      199         v-seconds = 86400 - 1
      200       .
      201     end.
      202     if v-seconds < 0
      203     then do:
      204       assign
      205         v-seconds = 0
      206       .
      207     end.
      208     assign
      209       v-hour = truncate(v-seconds / 3600, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 3600
      213     .
      214     assign
      215       v-min = truncate(v-seconds / 60, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 60
      219     .
      220     return
      221         (if v-day-number <> 0
      222           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      223           else ""
      224         )
      225       + (if v-day-number <> 0 or v-hour <> 0
      226           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      230           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      231           else ""
      232         )
      233       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      234       .
      235   end.
      236   function cur-time-string returns character
      237   :
      238     define variable v-date as date      no-undo .
      239     define variable v-time as integer   no-undo .
      240     run cur-time in this-procedure
      241       (output v-date
      242       ,output v-time
      243       ) .
      244     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      245   end.
      246   function cur-time-string-sec returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      255   end.
      256   function cur-time-custom  returns character
      257   (input p-prefix as character
      258   ,input p-date-format as character
      259   ,input p-delimiter as character
      260   ,input p-time-format as character
      261   ,input p-suffix as character
      262   )
      263   :
      264     define variable v-date as date      no-undo .
      265     define variable v-time as integer   no-undo .
      266     run cur-time in this-procedure
      267       (output v-date
      268       ,output v-time
      269       ) .
      270     return
      271       p-prefix
      272       + string(v-date, p-date-format)
      273       + p-delimiter
      274       + string(v-time, p-time-format)
      275       + p-suffix
      276       .
      277   end.
      278   function cur-time-print  returns character
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      287   end.
      288   function cur-time-datetime returns datetime
      289   :
      290     define variable v-char as character no-undo .
      291     define variable v-datetime as datetime no-undo .
      292     v-char = cur-time-string().
      293     v-datetime = datetime(v-char).
      294     return  v-datetime.
      295   end.
      296   function cur-time-string-msec returns character
      297   :
      298     define variable v-date as datetime  no-undo .
      299     v-date = now.
      300     return string(v-date) .
      301   end.
      302   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303   define new shared temp-table gds-list no-undo like ub.goods
      304     field qnty   as decimal
      305     field to-del as logical
      306     field order-num as integer
      307     field to-sel as logical
      308     field promo-code as character
      309     field ActionId  as int64
      310     field db-num as integer
      311     index art  is primary unique artic prod-type prod-code
      312     index code is         unique gds-code
      313     index oi order-num
      314     index isel to-sel
      315     .
      316   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      317   define  new shared  temp-table gds-list-hist no-undo
      318   field list-table as character
      319   field id as integer
      320   field line as integer
      321   field hist-mode as character
      322   field des as character
      323   field num-recs as integer
      324   field option_ as character
      325   field item_ as character
      326   field status_ as character
      327   field num-add as integer
      328   field num-ignored as integer
      329   field done as logical
      330   field err_ as logical
      331   field err-mes as character
      332   index pi is primary
      333   id
      334   line
      335   index isdone
      336   done
      337   .
      338   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339   def
      340   new shared
      341   temp-table  obj-list no-undo
      342     field obj-type like ub.clients.obj-type
      343     field obj-code like ub.clients.obj-code
      344     field obj-name like ub.clients.obj-name
      345     field obj-id   as integer
      346     field db-num   as integer
      347     index pi is primary unique obj-id
      348     index ie1 obj-type obj-code
      349     index ie2 obj-name
      350   .
      351   procedure create_obj-list :
      352      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      353      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      354      do
      355      on error undo, return error return-value
      356      :
      357         define buffer cli-obj for ub.clients .
      358         define variable p-var as integer no-undo .
      359         define buffer buf_obj-list for obj-list .
      360         find last buf_obj-list  use-index pi no-error .
      361         if available buf_obj-list
      362         then
      363            p-var = buf_obj-list.obj-id + 1.
      364         else
      365            p-var = 1.
      366         find first cli-obj where
      367                   cli-obj.obj-type = p-obj-type
      368               and cli-obj.obj-code = p-obj-code
      369         no-lock no-error.
      370         if available cli-obj
      371         then do:
      372            create buf_obj-list.
      373            assign
      374               buf_obj-list.obj-id   = p-var
      375               buf_obj-list.obj-code = cli-obj.obj-code
      376               buf_obj-list.obj-type = cli-obj.obj-type
      377               buf_obj-list.obj-name = cli-obj.obj-name
      378               buf_obj-list.db-num   = cli-obj.db-num
      379            .
      380         end.
      381      end.
      382   end.
      383   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   procedure gds-ind1 :
      385   main-block:
      386     do
      387   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      388   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      389   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      390     :
      391   define input-output parameter p-doc-rec  as recid no-undo.
      392   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
      393   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
      394   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
      395   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
      396   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
      397   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
      398   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
      399   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
      400   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
      401   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
      402   define variable v-db-num like ub.db.db-num no-undo .
      403   define variable v-db-num-obj like ub.db.db-num no-undo .
      404   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      406     (output v-db-num
      407     )  .
      408   define variable v-date as date no-undo .
      409   define variable v-time as integer no-undo .
      410   run cur-time in this-procedure(output v-date, output v-time).
      411     find first bufs_gds-obj-prop exclusive-lock where
      412               bufs_gds-obj-prop.gds-code          = p-gds-code   and
      413               bufs_gds-obj-prop.obj-type          = p-obj-type   and
      414               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
      415       if not available bufs_gds-obj-prop then do:
      416           create bufs_gds-obj-prop.
      417           assign
      418               bufs_gds-obj-prop.gds-code           = p-gds-code
      419               bufs_gds-obj-prop.grop-date-update   = v-date
      420               bufs_gds-obj-prop.grop-time-update   = v-time
      421               bufs_gds-obj-prop.grop-db-num-update = v-db-num
      422               bufs_gds-obj-prop.obj-type           = p-obj-type
      423               bufs_gds-obj-prop.obj-code           = p-obj-code
      424           no-error .
      425           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
      426       end.
      427   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
      428   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
      429   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
      430   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
      431   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
      432   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
      433         p-doc-rec = recid(bufs_gds-obj-prop)    .
      434   end.
      435   end procedure.
      436   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      437   procedure ass-grp-gds-code-yes :
      438   define input  parameter p-gds-code   as integer   no-undo .
      439   define input  parameter p-node-code  as integer   no-undo .
      440   define input  parameter p-id         as integer   no-undo .
      441   define input  parameter p-db-num     as integer   no-undo .
      442   define output parameter p-ask        as logical   no-undo .
      443   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      444   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      445   define buffer buf_goods   for ub.goods  .
      446   define buffer buf_gds-grp for ub.gds-grp  .
      447   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
      448   define variable v-grp-qnty as integer   no-undo .
      449   define variable v-grp-lim as integer   no-undo .
      450     do
      451     on error undo, return error return-value
      452     :
      453   p-ask = ? .
      454   find first  ub.assortment-matrix no-lock where
      455               ub.assortment-matrix.asmt-id  = p-id and
      456               ub.assortment-matrix.db-num   = p-db-num and
      457               ub.assortment-matrix.asmt-type =  'Шаблон':U
      458               no-error .
      459   if available ub.assortment-matrix then do:
      460     p-ask = true .
      461     return .
      462   end.
      463   find first buf_gds-obj-prop no-lock where
      464             buf_gds-obj-prop.gds-code = p-gds-code and
      465             buf_gds-obj-prop.obj-type = ub.assortment-matrix.obj-type and
      466             buf_gds-obj-prop.obj-code = ub.assortment-matrix.obj-code and
      467             buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U no-error .
      468   if available buf_gds-obj-prop then do:
      469     p-ask = true .
      470     return .
      471   end.
      472   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code .
      473   find first buf_gds-grp-obj-attr no-lock where
      474              buf_gds-grp-obj-attr.attr-code = 'LimAssMat':U and
      475              buf_gds-grp-obj-attr.obj-type  = string(p-id) and
      476              buf_gds-grp-obj-attr.obj-code  = p-db-num and
      477              buf_gds-grp-obj-attr.host-code = 0 and
      478              buf_gds-grp-obj-attr.node-code = p-node-code no-error .
      479   if error-status :error then do:
      480     p-ask = true .
      481     return .
      482   end.
      483   if buf_gds-grp-obj-attr.attr-value  = "0" then do:
      484     p-ask = false  .
      485     return .
      486   end.
      487     if buf_gds-grp-obj-attr.attr-value  = "" or
      488       buf_gds-grp-obj-attr.attr-value  = ?  or
      489       buf_gds-grp-obj-attr.attr-value  = "?" then do:
      490       find first buf_gds-grp no-lock where
      491                   buf_gds-grp.node-code = p-node-code no-error .
      492         if available buf_gds-grp  then do:
      493             if buf_gds-grp.upper-code = 0 then do:
      494                 p-ask = true .
      495                 return .
      496             end.
      497             else do:
      498                 run ass-grp-gds-code-yes (
      499                    input   p-gds-code
      500                   ,input   buf_gds-grp.upper-code
      501                   ,input   p-id
      502                   ,input   p-db-num
      503                   ,output  p-ask
      504                   ).
      505                 if p-ask <> ? then return .
      506           end.
      507         end.
      508     end.
      509     else do:
      510       v-grp-lim = int (buf_gds-grp-obj-attr.attr-value) no-error  .
      511       if v-grp-lim > 0 then do:
      512           v-grp-qnty = 0 .
      513           find first buf1_gds-grp-obj-attr no-lock where
      514                      buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
      515                      buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
      516                      buf1_gds-grp-obj-attr.obj-code  = p-db-num and
      517                      buf1_gds-grp-obj-attr.host-code = 0 and
      518                      buf1_gds-grp-obj-attr.node-code = p-node-code no-error .
      519           if available buf1_gds-grp-obj-attr then do:
      520             v-grp-qnty = int(buf1_gds-grp-obj-attr.attr-value) .
      521           end.
      522           if v-grp-lim >= v-grp-qnty + 1 then p-ask = true .
      523           else p-ask = false .
      524           return .
      525       end.
      526     end.
      527     end.
      528   end procedure.
      529   procedure recalc-gds-assgrp :
      530   define input  parameter p-action     as character no-undo .
      531   define input  parameter p-gds-code  as integer   no-undo .
      532   define input  parameter p-node-code  as integer   no-undo .
      533   define input  parameter p-id         as integer   no-undo .
      534   define input  parameter p-db-num     as integer   no-undo .
      535   define buffer buf_gds-grp for ub.gds-grp  .
      536   define buffer curr_gds-grp for ub.gds-grp  .
      537   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      538   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
      539   define variable kk as character no-undo .
      540     do
      541     on error undo, return error return-value
      542     :
      543   find first  ub.assortment-matrix no-lock where
      544               ub.assortment-matrix.asmt-id  = p-id and
      545               ub.assortment-matrix.db-num   = p-db-num and
      546               ub.assortment-matrix.asmt-type =  'Шаблон':U
      547               no-error .
      548       if available ub.assortment-matrix then do:
      549         return .
      550       end.
      551       find first buf_gds-obj-prop no-lock where
      552                  buf_gds-obj-prop.gds-code = p-gds-code and
      553                  buf_gds-obj-prop.obj-type = ub.assortment-matrix.obj-type and
      554                  buf_gds-obj-prop.obj-code = ub.assortment-matrix.obj-code and
      555                  buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U
      556                  no-error .
      557       if available buf_gds-obj-prop then do:
      558         if p-action <> '--' then  do:
      559            return .
      560         end.
      561       end.
      562       find first buf1_gds-grp-obj-attr exclusive-lock where
      563                  buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
      564                  buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
      565                  buf1_gds-grp-obj-attr.obj-code  = p-db-num and
      566                  buf1_gds-grp-obj-attr.host-code = 0 and
      567                  buf1_gds-grp-obj-attr.node-code = p-node-code
      568                  no-error .
      569       if available buf1_gds-grp-obj-attr then do:
      570          if p-action = '+' then  do:
      571             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) + 1 ).
      572          end.
      573          else do:
      574             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) - 1 ).
      575          end.
      576          buf1_gds-grp-obj-attr.attr-value = kk .
      577       end.
      578       else do:
      579           if p-action = '+' then  do:
      580               create buf1_gds-grp-obj-attr .
      581                 assign
      582                   buf1_gds-grp-obj-attr.attr-code  = 'QntyAssMat':U
      583                   buf1_gds-grp-obj-attr.obj-type   = string(p-id)
      584                   buf1_gds-grp-obj-attr.obj-code   = p-db-num
      585                   buf1_gds-grp-obj-attr.host-code  = 0
      586                   buf1_gds-grp-obj-attr.node-code  = p-node-code
      587                   buf1_gds-grp-obj-attr.attr-value = "1"
      588                 .
      589           end.
      590       end.
      591      FIND FIRST curr_gds-grp WHERE
      592                 curr_gds-grp.node-code = p-node-code
      593           NO-LOCK NO-ERROR.
      594      if AVAILABLE curr_gds-grp AND curr_gds-grp.upper-code > 0 then do:
      595         run recalc-gds-assgrp (p-action ,p-gds-code , curr_gds-grp.upper-code,p-id,p-db-num ) .
      596      end.
      597     end.
      598   end procedure.
      599   define new global shared variable g#lib-Matrix  as handle no-undo .
      600   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      601   define variable v-longchar-asstro  as longchar no-undo .
      602   define temp-table temp-goods no-undo
      603     field gds-code as integer
      604     field status_  as integer
      605     index pi gds-code
      606   .
      607   PROCEDURE translate-to-other :
      608   define input  parameter p-asmt-id as integer   no-undo .
      609   define input  parameter p-db-num  as integer   no-undo .
      610     do
      611     on error undo, return error return-value
      612     :
      613   define variable v-recid as recid no-undo .
      614   define buffer Oth_assortment-matrix-goods for ub.assortment-matrix-goods  .
      615   define buffer obj_assortment-matrix for ub.assortment-matrix  .
      616   define buffer sh_assortment-matrix for ub.assortment-matrix  .
      617   define buffer bufs_gds-obj-prop for ub.gds-obj-prop  .
      618     find first  sh_assortment-matrix no-lock where
      619                 sh_assortment-matrix.asmt-id = p-asmt-id and
      620                 sh_assortment-matrix.db-num  = p-db-num  and
      621                 sh_assortment-matrix.asmt-status = 0 and
      622                 sh_assortment-matrix.asmt-type = 'Шаблон':U no-error .
      623   if not available sh_assortment-matrix then return .
      624   define variable v-doc-rec as recid no-undo .
      625   define variable v-gds-prop-recid as recid no-undo .
      626   define variable v-stt as integer   no-undo .
      627   v-longchar-asstro = "".
      628      run waitfram-show in this-procedure  ("Передача изменений в связанные матрицы ... " ) .
      629      for each obj_assortment-matrix no-lock where
      630               obj_assortment-matrix.asmt-status = 0 and
      631               obj_assortment-matrix.asmt-type = 'Объект':U ,
      632         first ub.assortment-matrix-attr no-lock where
      633               ub.assortment-matrix-attr.asmt-id    = obj_assortment-matrix.asmt-id and
      634               ub.assortment-matrix-attr.db-num     = obj_assortment-matrix.db-num and
      635               ub.assortment-matrix-attr.attr-code  = 'RootShablon':U and
      636               ub.assortment-matrix-attr.attr-value = substitute("&1&3&2" , p-asmt-id, p-db-num,chr(4))
      637               :
      638           run waitfram-show in this-procedure ( substitute(" Передаю изменения в Матрицу: &1" ,obj_assortment-matrix.asmt-name )) .
      639           for each temp-goods :
      640              if temp-goods.status_ = 0 then do:
      641                   find first Oth_assortment-matrix-goods no-lock where
      642                               Oth_assortment-matrix-goods.asmt-id  = ub.assortment-matrix-attr.asmt-id and
      643                               Oth_assortment-matrix-goods.db-num   = ub.assortment-matrix-attr.db-num  and
      644                               Oth_assortment-matrix-goods.gds-code = temp-goods.gds-code and
      645                               Oth_assortment-matrix-goods.asmg-status = 0 no-error .
      646                       if not available Oth_assortment-matrix-goods then do:
      647   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
      648    (input this-procedure
      649    ,input-output v-doc-rec
      650    ,input 'ДОБАВЛЕНИЕ':U
      651    ,input ub.assortment-matrix-attr.asmt-id
      652    ,input ub.assortment-matrix-attr.db-num
      653    ,input temp-goods.gds-code
      654    ,input ''
      655     ) no-error .
      656                           if error-status :error then do:
      657                             v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
      658                             next.
      659                           end.
      660                       end.
      661                 end.
      662                 else do:
      663                   v-stt = 1.
      664                   find first Oth_assortment-matrix-goods no-lock where
      665                               Oth_assortment-matrix-goods.asmt-id  = ub.assortment-matrix-attr.asmt-id and
      666                               Oth_assortment-matrix-goods.db-num   = ub.assortment-matrix-attr.db-num  and
      667                               Oth_assortment-matrix-goods.gds-code = temp-goods.gds-code and
      668                               Oth_assortment-matrix-goods.asmg-status = 0 no-error .
      669                       if available Oth_assortment-matrix-goods then do:
      670                           v-recid = recid(Oth_assortment-matrix-goods).
      671                           find first bufs_gds-obj-prop exclusive-lock where
      672                                      bufs_gds-obj-prop.gds-code = Oth_assortment-matrix-goods.gds-code   and
      673                                      bufs_gds-obj-prop.obj-type = Oth_assortment-matrix-goods.obj-type   and
      674                                      bufs_gds-obj-prop.obj-code = Oth_assortment-matrix-goods.obj-code  no-error .
      675                           if not available bufs_gds-obj-prop
      676                             or not (bufs_gds-obj-prop.gdop-igt = 'Пусто':U or
      677                                     bufs_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U ) then do:
      678                           v-longchar-asstro = v-longchar-asstro +
      679                           substitute("Принудительная смена ИЖТ_ товара &1  на ПУСТО на объекте &2&3&4" ,
      680                               Oth_assortment-matrix-goods.gds-code ,
      681                               Oth_assortment-matrix-goods.obj-type ,
      682                               Oth_assortment-matrix-goods.obj-code ,
      683                               chr(10)) .
      684                           run gds-ind1
      685                               (input-output v-gds-prop-recid
      686                               ,Oth_assortment-matrix-goods.gds-code
      687                               ,Oth_assortment-matrix-goods.obj-type
      688                               ,Oth_assortment-matrix-goods.obj-code
      689                               ,'Пусто':U
      690                               ,?
      691                               ,?
      692                               ,?
      693                               ,?
      694                               ,?
      695                               ) no-error  .
      696                             end.
      697                             if not error-status :error then do:
      698   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
      699    (input this-procedure
      700    ,input v-recid
      701    ,input-output v-stt
      702    ,input no
      703     ) no-error .
      704                                   if error-status :error then do:
      705                                      v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
      706                                   end.
      707                              end.
      708                              else do:
      709                                 v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
      710                              end.
      711                       end.
      712                  end.
      713           end.
      714      end.
      715      run waitfram-hide in this-procedure.
      716   end.
      717   END PROCEDURE.
