      872   FUNCTION Is-Goods-in-Cont-Spec RETURN LOGICAL(
      873            INPUT p-iGds-Code as INTEGER
      874            ):
      875      DEFINE BUFFER Spec FOR ub.Contract-Specif.
      876      RETURN (CAN-FIND (FIRST Spec WHERE Spec.Gds-code = p-iGds-Code NO-LOCK)).
      877   END FUNCTION.
