     2989   DEFINE VARIABLE T-overissue AS LOGICAL INITIAL no
     2990        LABEL "Перевыпуск"
     2991        VIEW-AS TOGGLE-BOX
     2992        SIZE 15.2 BY .93 NO-UNDO.
     2993   DEFINE QUERY Dialog-Frame FOR
     2994         temp-dis-card SCROLLING.
     2995   DEFINE FRAME Dialog-Frame
     2996        B-exit AT ROW 1 COL 1
     2997        b-quit AT ROW 1 COL 11
     2998        b-prop AT ROW 1 COL 41 WIDGET-ID 2
     2999        B-ltype AT ROW 1 COL 51
     3000        b-long AT ROW 1 COL 61
     3001        B-hist AT ROW 1 COL 92
     3002        B-Help AT ROW 1 COL 95
