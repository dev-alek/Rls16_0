     2140          AND  buf_temp-pers-proc.vpar      = p-parameter:
     2141           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
     2142           delete procedure buf_temp-pers-proc.vproc-handle.
     2143           delete buf_temp-pers-proc.
     2144           v-per-proc-num = v-per-proc-num - 1.
     2145        end.
