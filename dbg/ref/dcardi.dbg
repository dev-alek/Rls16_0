     4173     and ref-mode <> 'КОПИРОВАНИЕ':U
     4174     and ref-mode <> 'ПРОСМОТР':U
     4175     and ref-mode <> ('ИЗМЕНЕНИЕ':U + chr(44) + 'КОПИРОВАНИЕ':U)
     4176     and ref-mode <> ('ДОБАВЛЕНИЕ':U + chr(44) + 'КОПИРОВАНИЕ':U)
     4177     and ref-mode <> '@client':U
     4178     then do:
     4179       message vss-workfile vss-revision vss-description skip
     4180                   "Неверный параметр вызова ref-mode"
     4181       view-as alert-box ERROR.
