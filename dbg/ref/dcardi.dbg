     4333   PROCEDURE enable-lim-kr :
     4334   if temp-dis-card.credit-card:screen-value in frame Dialog-Frame = "yes" and ref-mode <> 'ПРОСМОТР':U
     4335   THEN DO:
     4336       enable
     4337       temp-dis-card.lim-kr with frame Dialog-Frame.
     4338       DISABLE
     4339       temp-dis-card.debet-card
     4340       with frame Dialog-Frame.
     4341   END.
     4342   ELSE DO:
     4343       disable
     4344       temp-dis-card.lim-kr with frame Dialog-Frame.
     4345       IF ref-mode <> 'ПРОСМОТР':U THEN
     4346       ENABLE
     4347       temp-dis-card.debet-card
     4348       with frame Dialog-Frame.
     4349   END.
     4350   END PROCEDURE.
     4351   PROCEDURE enable_UI :
     4352     OPEN QUERY Dialog-Frame FOR EACH temp-dis-card SHARE-LOCK.
