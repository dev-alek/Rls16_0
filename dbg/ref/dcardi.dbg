     3531        and
     3532        self :read-only = false
     3533        )
     3534     then do:
     3535       if self :handle <> focus :handle
     3536       then do:
     3537         apply "entry":u to self .
     3538       end.
     3539       run gbl/getcurdt.p
     3540         (output v-curr-sv-date
     3541         ) .
     3542       assign
     3543         self :screen-value = string(v-curr-sv-date) .
     3544       .
     3545     end.
     3546     return no-apply.
     3547   end.
