     2206   FUNCTION get-all-fields returns character (p-file-name as character ):
     2207   define variable v-dop as character no-undo .
     2208     find first _file no-lock where _file._file-name = p-file-name no-error .
     2209     if not available _file then return "":U.
     2210     for each _field no-lock where
     2211              _field._file-recid = recid(_file) :
     2212       assign
     2213       v-dop = v-dop + _field._field-name + chr(44)
     2214       .
     2215     end.
     2216     return trim(v-dop).
     2217   END FUNCTION.
     2218   procedure tempchgs-create-lable-record :
