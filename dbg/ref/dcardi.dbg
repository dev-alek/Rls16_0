     2147   end procedure.
     2148   procedure perproc-delete-from-parent :
     2149   define input  parameter p-parent-handle as handle no-undo .
     2150   define input  parameter p-proc-name as character no-undo .
     2151   define buffer buf_temp-pers-proc for temp-pers-proc.
     2152     do
     2153     on error undo, return error return-value
     2154     :
     2155        if p-proc-name = "":u then do:
     2156         for each buf_temp-pers-proc where
     2157            buf_temp-pers-proc.vparent-handle      = p-parent-handle:
     2158             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
     2159             delete procedure buf_temp-pers-proc.vproc-handle.
     2160             delete buf_temp-pers-proc.
     2161             v-per-proc-num = v-per-proc-num - 1.
     2162         end.
     2163        end.
     2164        else do:
     2165         for each buf_temp-pers-proc where
     2166                 buf_temp-pers-proc.proc-name = p-proc-name
     2167           AND  buf_temp-pers-proc.vparent-handle      = p-parent-handle:
     2168             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
     2169             delete procedure buf_temp-pers-proc.vproc-handle.
     2170             delete buf_temp-pers-proc.
     2171             v-per-proc-num = v-per-proc-num - 1.
     2172         end.
     2173       end.
     2174     end.
     2175   end procedure.
