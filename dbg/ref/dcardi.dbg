     4228   RUN disable_UI in this-procedure .
     4229   PROCEDURE check-update-prop :
     4230   define input parameter p-exit-without-save as logical no-undo .
     4231   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     4232   define variable v-updated as logical no-undo .
     4233   define variable v-created as logical no-undo .
     4234   define variable v-deleted as logical no-undo .
     4235   define variable v-updated-str as character no-undo .
     4236   define buffer buf_dis-card-property for ub.dis-card-property.
     4237   if ref-mode <> 'ДОБАВЛЕНИЕ':U then do:
     4238     if v-update-property then do:
     4239       for each tt0-dis-card-property NO-LOCK where
     4240               tt0-dis-card-property.d-card = ub.dis-card.d-card:
     4241         if tt0-dis-card-property.dt-code = 0
     4242         and tt0-dis-card-property.node-code = 0
     4243         then next.
     4244         find first buf_dis-card-property NO-LOCK WHERE
     4245                 buf_dis-card-property.d-card = tt0-dis-card-property.d-card
     4246           AND   buf_dis-card-property.host-code = tt0-dis-card-property.host-code
     4247           AND   buf_dis-card-property.obj-type = tt0-dis-card-property.obj-type
     4248           AND   buf_dis-card-property.obj-code = tt0-dis-card-property.obj-code
     4249           AND   buf_dis-card-property.dt-code = tt0-dis-card-property.dt-code
     4250           AND   buf_dis-card-property.node-code = tt0-dis-card-property.node-code
     4251           no-error.
     4252         assign
     4253         v-updated = no.
     4254         if available  buf_dis-card-property then do:
     4255           v-updated-str = "":U.
     4256           BUFFER-COMPARE tt0-dis-card-property
     4257                       TO buf_dis-card-property
     4258                       case-sensitive
     4259                       SAVE result IN v-updated-str.
     4260           assign
     4261           v-created = yes
     4262           v-updated = (v-updated-str <> "":U)
     4263           .
     4264         end.
     4265         else do:
     4266           assign
     4267           v-updated = yes.
     4268         end.
     4269         ASSIGN
     4270         v-update-property = (v-update-property or v-updated).
     4271       End.
     4272       FOR EACH buf_dis-card-property where
     4273               buf_dis-card-property.d-card = dis-card.d-card
     4274               :
     4275         if buf_dis-card-property.dt-code = 0
     4276         and buf_dis-card-property.node-code = 0
     4277         then next.
     4278         FIND FIRST tt0-dis-card-property NO-LOCK WHERE
     4279                   tt0-dis-card-property.d-card   = buf_dis-card-property.d-card
     4280               AND tt0-dis-card-property.host-code = buf_dis-card-property.host-code
     4281               AND tt0-dis-card-property.obj-type = buf_dis-card-property.obj-type
     4282               AND tt0-dis-card-property.obj-code = buf_dis-card-property.obj-code
     4283               AND tt0-dis-card-property.dt-code = buf_dis-card-property.dt-code
     4284               and tt0-dis-card-property.node-code = buf_dis-card-property.node-code   NO-ERROR.
     4285           IF NOT AVAILABLE tt0-dis-card-property THEN DO:
     4286             assign
     4287             v-deleted = yes.
     4288             ASSIGN
     4289             v-update-property = (v-deleted OR v-update-property).
     4290           END.
     4291       END.
     4292     end.
     4293   end.
     4294   if (v-is-sourced or v-is-copy or v-is-subsid) and v-found-copy-prop then v-update-property = yes.
     4295   if ref-mode = 'ДОБАВЛЕНИЕ':U then return.
     4296   if not p-exit-without-save then return.
     4297   IF v-update-property THEN DO:
     4298       MESSAGE
     4299       substitute("Были изменены свойства ДК &1&2"
     4300                 ,(if v-found-copy-prop then " или были унаследованы свойства ДК" else "":U)
     4301                 , chr(10)
     4302                 )
     4303       "Сделанные изменения будут отменены" skip
     4304       "Продолжить?"
     4305       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     4306       IF NOT glog  THEN RETURN error.
     4307   END.
     4308   END PROCEDURE.
     4309   PROCEDURE disable_UI :
     4310     HIDE FRAME Dialog-Frame.
     4311   END PROCEDURE.
     4312   PROCEDURE display-r-b-abbr :
     4313   define variable v-curr-r-b  as character no-undo .
     4314   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4315   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4316     (output v-curr-r-b
     4317     ) no-error .
     4318   if paremitent-host-code = 0
     4319   and v-curr-r-b = 'base':U
     4320   then do:
     4321     var-r-b-abbr = ?.
     4322   end.
     4323   else do:
     4324   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4325   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
     4326     (input  paremitent-host-code
     4327     ,output var-r-b-abbr
     4328     ) no-error .
