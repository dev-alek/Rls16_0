     2242        buf_temp-labels.f_parent = p-f_parent
     2243        buf_temp-labels.f_visible = p-f_visible
     2244        buf_temp-labels.f_root = (if p-f_parent = '':U then p-f_name else p-f_parent)
     2245        buf_temp-labels.num_ = 0
     2246        .
     2247     end.
     2248   end procedure.
