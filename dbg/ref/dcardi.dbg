     1204   procedure disproph_send-nws :
     1205   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
     1206   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
     1207   define parameter buffer buf_Dis-card for ub.dis-card.
     1208   define variable v-dh-hn as integer no-undo .
     1209   main-block:
     1210   do
     1211   on error undo, return error return-value
     1212   :
     1213     if g#news
     1214     and g#db-num > 0
     1215     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
     1216     then return.
     1217     if g#db-num = 0
     1218     or (g#news
     1219         and g#db-num > 0
     1220         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
     1221         )
     1222     then do:
     1223       if not available buf_dis-card then do:
     1224         find first buf_dis-card no-lock where
     1225                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
     1226       end.
     1227       if not available buf_dis-card then do:
     1228         assign
     1229         v-dh-hn = integer('0':U).
     1230       end.
     1231       else do:
     1232   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1233   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     1234     (input  g#db-num
     1235     ,input  'dis-card-property':U
     1236     ,input  0
     1237     ,input  '':U
     1238     ,input  0
     1239     ,input  buf_dis-card.type
     1240     ,input  '':U
     1241     ,input  '':U
     1242     ,input  buf_dis-card.emitent-host-code
     1243     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
     1244     ,input  0
     1245     ,input  'hist-to-nws'
     1246     ,output v-dh-hn
     1247     ) no-error .
     1248       end.
     1249       if v-dh-hn >= 0 then do:
     1250         run str/callnews.p (
     1251           input 'c-dis-card-property':U
     1252           ,input (buffer buf_c-dis-card-property:handle)
     1253           ) no-error .
     1254         if error-status:error then do:
     1255           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     1256         end.
     1257         if available buf_c-dc-hist then do:
     1258           run str/callnews.p (
     1259             input 'c-dc-hist':U
     1260             ,input (buffer buf_c-dc-hist:handle)
     1261             ) no-error .
     1262           if error-status:error then do:
     1263             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     1264           end.
     1265         end.
     1266       end.
     1267     end.
     1268   end.
     1269   end procedure.
     1270   procedure discprop-node-code :
     1271   define input parameter p-dtm-code as integer no-undo .
     1272   define input parameter p-node-code as integer no-undo .
     1273   define output parameter p-data-type as character no-undo .
     1274   define output parameter p-format as character no-undo .
     1275   define output parameter p-label as character no-undo .
     1276   define output parameter p-range as integer no-undo .
     1277   define output parameter p-rw-option as character no-undo .
     1278   define buffer buf_prop-map for ub.prop-map.
     1279   define buffer buf_prop-head for ub.prop-head.
     1280   do
     1281   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1282   :
     1283   find first buf_prop-head no-lock where
     1284             buf_prop-head.dtm-code = p-dtm-code no-error .
     1285   if available buf_prop-head then do:
     1286     if p-node-code > 0 then do:
     1287       find first buf_prop-map no-lock where
     1288                 buf_prop-map.dtm-code = p-dtm-code
     1289             and buf_prop-map.node-code = p-node-code no-error .
     1290       if available buf_prop-map then do:
     1291         assign
     1292         p-data-type = buf_prop-map.node-value-type
     1293         p-format = buf_prop-map.node-format
     1294         p-label = buf_prop-map.node-label
     1295         p-rw-option = buf_prop-map.rw-option
     1296         .
     1297       end.
     1298     end.
     1299     if buf_prop-head.storage-place  = "":U
     1300     and buf_prop-head.storage-place-host  > "":U
     1301     and buf_prop-head.storage-place-obj  > "":U then do:
     1302       p-range =  12.
     1303     end.
     1304     if buf_prop-head.storage-place  > "":U
     1305     and buf_prop-head.storage-place-host  > "":U
     1306     and buf_prop-head.storage-place-obj  > "":U then do:
     1307       p-range =  3.
     1308     end.
     1309     if buf_prop-head.storage-place  > "":U
     1310     and buf_prop-head.storage-place-host  > "":U
     1311     and buf_prop-head.storage-place-obj  = "":U then do:
     1312       p-range =  2.
     1313     end.
     1314     if buf_prop-head.storage-place  = "":U
     1315     and buf_prop-head.storage-place-host  > "":U
     1316     and buf_prop-head.storage-place-obj  = "":U then do:
     1317       p-range =  1.
     1318     end.
     1319     if buf_prop-head.storage-place  > "":U
     1320     and buf_prop-head.storage-place-host  = "":U
     1321     and buf_prop-head.storage-place-obj  = "":U then do:
     1322       p-range =  0.
     1323     end.
     1324   end.
     1325   end.
     1326   end procedure.
     1327   procedure discprop-initial:
     1328   define input parameter p-dtm-code as integer no-undo .
     1329   define input parameter p-node-code as integer no-undo .
     1330   define output parameter p-init-value-character as character no-undo .
     1331   define output parameter p-init-value-date as date no-undo .
     1332   define output parameter p-init-value-decimal as decimal no-undo .
     1333   define output parameter p-init-value-integer as integer no-undo .
     1334   define output parameter p-init-value-logical as logical no-undo .
     1335   define buffer buf_prop-map for ub.prop-map.
     1336   find first buf_prop-map no-lock where
     1337             buf_prop-map.dtm-code = p-dtm-code
     1338         and buf_prop-map.node-code = p-node-code no-error.
     1339   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     1340                                                               , p-node-code
     1341                                                               , p-dtm-code).
     1342   assign
     1343   p-init-value-character = buf_prop-map.init-value-character
     1344   p-init-value-date = buf_prop-map.init-value-date
     1345   p-init-value-decimal = buf_prop-map.init-value-decimal
     1346   p-init-value-integer = buf_prop-map.init-value-integer
     1347   p-init-value-logical = buf_prop-map.init-value-logical
     1348   .
     1349   end procedure.
     1350   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     1351   define buffer buf_attr-prop for ub.attr-prop.
     1352   find first buf_attr-prop no-lock where
     1353             buf_attr-prop.table-name = 'dis-card-property':U
     1354         and buf_attr-prop.templ-rl-root = p-dtm-code
     1355         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     1356         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     1357   if not available buf_attr-prop
     1358   or logical(buf_attr-prop.property-value) = no then do:
     1359     return no.
     1360   end.
     1361   return yes.
     1362   end function.
     1363   procedure discprop-edit :
     1364   define input parameter p-dtm-code-node-name as character no-undo .
     1365   define output parameter p-edit-menu-section-num as integer no-undo .
     1366   define buffer buf_attr-prop for ub.attr-prop.
     1367   do
     1368   on error undo, return error return-value
     1369   :
     1370     find first buf_attr-prop no-lock where
     1371             buf_attr-prop.table-name = 'dis-card-property':U
     1372        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     1373        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     1374        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     1375     if available buf_attr-prop then do:
     1376       assign
     1377       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     1378     end.
     1379   end.
     1380   end procedure.
     1381   procedure discprop-node-name :
     1382   define input parameter p-dtm-code-node-name as character no-undo .
     1383   define output parameter p-tool-tip as character no-undo .
     1384   define output parameter p-node-label as character no-undo .
     1385   define buffer buf_prop-map for ub.prop-map.
     1386   define buffer buf_prop-head for ub.prop-head.
     1387   do
     1388   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1389   :
     1390     find first buf_prop-head no-lock where
     1391               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     1392     assign
     1393     p-tool-tip   = if available buf_prop-head
     1394                    then buf_prop-head.prop-des
     1395                    else entry(1, p-dtm-code-node-name, chr(4) )
     1396     p-node-label = (if available buf_prop-head
     1397                     then buf_prop-head.prop-label
     1398                     else '':U)
     1399     .
     1400     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     1401       find first buf_prop-map no-lock where
     1402                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     1403           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     1404       if available buf_prop-map then do:
     1405         assign
     1406         p-tool-tip   = buf_prop-map.node-description
     1407         p-node-label = (if available buf_prop-head
     1408                         then buf_prop-head.prop-label
     1409                         else '':U) + ":" + buf_prop-map.node-label
     1410         .
     1411       end.
     1412     end.
     1413   end.
     1414   end procedure.
     1415   procedure discprop-write :
     1416   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     1417   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     1418   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     1419   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     1420   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     1421   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     1422   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     1423   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     1424   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     1425   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     1426   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     1427   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     1428   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     1429   define input parameter p-source-type     as character no-undo .
     1430   define input parameter p-source-ref      as character no-undo .
     1431   define input-output parameter p-chip-num as integer no-undo .
     1432   define input-output parameter p-corr-date as date no-undo .
     1433   define input-output parameter p-corr-time as integer no-undo .
     1434   do
     1435   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1436   :
     1437     define buffer buf_dis-card-property for ub.dis-card-property .
     1438     define buffer buf_dis-card for ub.dis-card.
     1439     define buffer buf_prop-ref for ub.prop-ref.
     1440     define variable v-data-type      as character no-undo .
     1441     define variable v-data-type-1    as character no-undo .
     1442     define variable v-format         as character no-undo .
     1443     define variable v-label          as character no-undo .
     1444     define variable v-range          as integer   no-undo .
     1445     define variable v-rw-option      as character no-undo .
     1446     run discprop-node-code in this-procedure
     1447       (
     1448        input  p-dtm-code
     1449       ,input  p-node-code
     1450       ,output v-data-type
     1451       ,output v-format
     1452       ,output v-label
     1453       ,output v-range
     1454       ,output v-rw-option
     1455       ) no-error .
     1456     if error-status :error then do:
     1457       undo, return error return-value .
     1458     end.
     1459     v-data-type-1 = entry(1, v-data-type).
     1460     if p-dt-code = ? then do:
     1461       find buf_prop-ref no-lock where
     1462           buf_prop-ref.dtm-code = p-dtm-code
     1463       and buf_prop-ref.sum-id = p-sum-id no-error.
     1464       if not available buf_prop-ref then do:
     1465         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     1466                                       ,p-dtm-code
     1467                                       ,p-sum-id).
     1468       end.
     1469       assign
     1470       p-dt-code = buf_prop-ref.dt-code.
     1471     end.
     1472     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     1473       undo, return error "Нельзя редактировать свойство в данной БД".
     1474     end.
     1475     run discprop-check in this-procedure (
     1476                                             input v-range
     1477                                           ,input p-d-card
     1478                                           ,input p-host-code
     1479                                           ,input p-obj-type
     1480                                           ,input p-obj-code
     1481                                           ,input p-dtm-code
     1482                                           ,input p-node-code
     1483                                           ,input p-dt-code
     1484                                         ) no-error .
     1485     if error-status:error then undo,  return error return-value .
     1486     find first buf_dis-card-property exclusive-lock
     1487       where buf_dis-card-property.d-card    = p-d-card
     1488         and buf_dis-card-property.host-code = p-host-code
     1489         and buf_dis-card-property.obj-type  = p-obj-type
     1490         and buf_dis-card-property.obj-code  = p-obj-code
     1491         and buf_dis-card-property.dt-code = p-dt-code
     1492         and buf_dis-card-property.node-code = p-node-code
     1493       no-error .
     1494       find first buf_dis-card no-lock where
     1495                   buf_dis-card.d-card = p-d-card.
     1496     if not available buf_dis-card-property then do:
     1497       create buf_dis-card-property .
     1498       assign
     1499         buf_dis-card-property.d-card    = p-d-card
     1500         buf_dis-card-property.host-code = p-host-code
     1501         buf_dis-card-property.obj-type  = p-obj-type
     1502         buf_dis-card-property.obj-code  = p-obj-code
     1503         buf_dis-card-property.dt-code = p-dt-code
     1504         buf_dis-card-property.node-code = p-node-code
     1505         buf_dis-card-property.dtm-code = p-dtm-code
     1506         buf_dis-card-property.sum-id   = p-sum-id
     1507         buf_dis-card-property.card-num  = buf_dis-card.card-num
     1508         buf_dis-card-property.main-card  = buf_dis-card.main-card
     1509         buf_dis-card-property.first-card  = buf_dis-card.first-card
     1510         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     1511       .
     1512     end.
     1513     else do:
     1514       if (v-data-type-1 = 'character':U
     1515       and buf_dis-card-property.property-value-character = p-value-character)
     1516       or  (v-data-type-1 = 'date':U
     1517           and buf_dis-card-property.property-value-date = p-value-date)
     1518       or  (v-data-type-1 = 'decimal':U
     1519           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     1520       or  (v-data-type-1 = 'integer':U
     1521           and buf_dis-card-property.property-value-integer = p-value-integer)
     1522       or  (v-data-type-1 = 'logical':U
     1523           and buf_dis-card-property.property-value-logical = p-value-logical)
     1524       then return.
     1525     end.
     1526     run disproph_write-dis-card-property-proc  in this-procedure (
     1527             buffer buf_dis-card-property
     1528             ,buffer Buf_dis-card
     1529             ,input p-d-card
     1530             ,input p-dt-code
     1531             ,input p-host-code
     1532             ,input p-obj-type
     1533             ,input p-obj-code
     1534             ,input p-dtm-code
     1535             ,input buf_dis-card.card-num
     1536             ,input buf_dis-card.main-card
     1537             ,input buf_dis-card.first-card
     1538             ,input buf_dis-card.first-main-card
     1539             ,input p-node-code
     1540             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     1541             ,input p-source-type
     1542             ,input p-source-ref
     1543             ,input-output p-chip-num
     1544             ,input-output p-corr-date
     1545             ,input-output p-corr-time
     1546             ).
     1547     assign
     1548     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     1549                                                       then p-value-character
     1550                                                       else buf_dis-card-property.property-value-character)
     1551     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     1552                                                       then p-value-date
     1553                                                       else buf_dis-card-property.property-value-date)
     1554     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     1555                                                       then p-value-decimal
     1556                                                       else buf_dis-card-property.property-value-decimal)
     1557     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     1558                                                       then p-value-integer
     1559                                                       else buf_dis-card-property.property-value-integer)
     1560     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     1561                                                       then p-value-logical
     1562                                                       else buf_dis-card-property.property-value-logical)
     1563     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     1564     .
     1565     release buf_dis-card-property no-error .
     1566     if error-status:error then do:
     1567       return error return-value .
     1568     end.
     1569   end.
     1570   end procedure.
     1571   procedure discprop-delete :
     1572   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     1573   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     1574   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     1575   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     1576   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     1577   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     1578   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     1579   define input parameter p-source-type as character no-undo .
     1580   define input parameter p-source-ref as character no-undo .
     1581   define output parameter p-deleted  as logical no-undo.
     1582   define input-output parameter p-chip-num as integer no-undo .
     1583   define input-output parameter p-corr-date as date no-undo .
     1584   define input-output parameter p-corr-time as integer no-undo .
     1585   do
     1586   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1587   :
     1588   define buffer buf_dis-card-property for ub.dis-card-property .
     1589   define buffer buf_dis-card for ub.dis-card.
     1590   define variable v-data-type      as character no-undo .
     1591   define variable v-format         as character no-undo .
     1592   define variable v-label          as character no-undo .
     1593   define variable v-range          as integer   no-undo .
     1594   define variable v-rw-option      as character   no-undo .
     1595     run discprop-node-code in this-procedure
     1596       (input  p-dtm-code
     1597       ,input  p-node-code
     1598       ,output v-data-type
     1599       ,output v-format
     1600       ,output v-label
     1601       ,output v-range
     1602       ,output v-rw-option
     1603       ) no-error .
     1604     if error-status :error then do:
     1605       undo, return error return-value .
     1606     end.
     1607     find first buf_dis-card-property exclusive-lock
     1608       where buf_dis-card-property.d-card    = p-d-card
     1609         and buf_dis-card-property.host-code = p-host-code
     1610         and buf_dis-card-property.obj-type  = p-obj-type
     1611         and buf_dis-card-property.obj-code  = p-obj-code
     1612         and buf_dis-card-property.dt-code = p-dt-code
     1613         and buf_dis-card-property.node-code = p-node-code
     1614       no-error NO-WAIT.
     1615     if not available buf_dis-card-property then do:
     1616       p-deleted = no.
     1617     end.
     1618     else do:
     1619       run disproph_write-dis-card-property-proc  in this-procedure (
     1620            buffer buf_dis-card-property
     1621           ,buffer buf_dis-card
     1622           ,input buf_dis-card-property.d-card
     1623           ,input buf_dis-card-property.dt-code
     1624           ,input buf_dis-card-property.host-code
     1625           ,input buf_dis-card-property.obj-type
     1626           ,input buf_dis-card-property.obj-code
     1627           ,input buf_dis-card-property.dtm-code
     1628           ,input buf_dis-card-property.card-num
     1629           ,input buf_dis-card-property.main-card
     1630           ,input buf_dis-card-property.first-card
     1631           ,input buf_dis-card-property.first-main-card
     1632           ,input buf_dis-card-property.node-code
     1633           ,input integer('99':U)
     1634           ,input p-source-type
     1635           ,input p-source-ref
     1636           ,input-output p-chip-num
     1637           ,input-output p-corr-date
     1638           ,input-output p-corr-time
     1639            ).
     1640       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     1641       delete buf_dis-card-property no-error .
     1642       if error-status:error then do:
     1643         return error return-value.
     1644       end.
     1645       p-deleted = yes.
     1646     end.
     1647   end.
     1648   end procedure.
     1649   procedure discprop-check :
     1650   define input parameter p-range  as integer no-undo .
     1651   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     1652   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     1653   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     1654   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     1655   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     1656   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     1657   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     1658   define variable v-message as character no-undo .
     1659   define buffer buf_sysconf for ub.sysconf.
     1660   define buffer buf_clients for ub.clients.
     1661   define buffer buf_dis-card for ub.dis-card.
     1662   define buffer buf_attr-prop for ub.attr-prop.
     1663   do
     1664   on error undo, return error return-value
     1665   :
     1666     if p-host-code > 0 then do:
     1667       FIND FIRST buf_sysconf No-LOCK WHERE
     1668                 buf_sysconf.host-code = p-host-code No-ERROR.
     1669       IF NOT AVAIL buf_sysconf THEN DO:
     1670         v-message = substitute("Не найдена фирма &1", p-host-code).
     1671         RETURN ERROR v-message.
     1672       END.
     1673     end.
     1674     if p-obj-type <> "":U or
     1675         p-obj-code <> 0 then do:
     1676       find first buf_clients No-LOCK WHERE
     1677                 buf_clients.obj-type = p-obj-type AND
     1678                 buf_clients.obj-code = p-obj-code no-error .
     1679       if not available buf_clients then do:
     1680         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     1681         RETURN ERROR v-message.
     1682       end.
     1683     end.
     1684     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     1685       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     1686                               , p-obj-type
     1687                               , p-obj-code
     1688                               , p-host-code).
     1689       RETURN ERROR v-message.
     1690     end.
     1691     if p-d-card <> "":U then do:
     1692       find first buf_dis-card No-LOCK WHERE
     1693                   buf_dis-card.d-card = p-d-card No-ERROR.
     1694       if not avail buf_dis-card then do:
     1695         v-message =substitute("Не найдена ДК").
     1696         return error  v-message.
     1697       end.
     1698       if buf_dis-card.emitent-host-code <> 0
     1699       and p-host-code <> buf_dis-card.emitent-host-code then do:
     1700         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     1701         return error v-message.
     1702       end.
     1703       if buf_dis-card.emitent-host-code = 0
     1704       and p-range = 1
     1705       and p-host-code <> 0 then do:
     1706         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     1707                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     1708                                 , chr(10)
     1709                               ).
     1710         return error v-message.
     1711       end.
     1712     end.
     1713   end.
     1714   end procedure.
     1715   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1716   define new global shared variable g#attr-lib  as handle no-undo .
     1717   define variable v-attr-lib-variable as handle no-undo .
     1718   procedure clntattr-code :
     1719     define input  parameter p-code           as character no-undo .
     1720     define output parameter p-type           as character no-undo .
     1721     define output parameter p-format         as character no-undo .
     1722     define output parameter p-label          as character no-undo .
     1723     define output parameter p-user-can-edit  as logical   no-undo .
     1724     define output parameter p-output-display as logical   no-undo .
     1725     define output parameter p-other          as character no-undo .
     1726     do
     1727     on error undo, return error return-value
     1728     :
     1729           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     1730         (input  p-code
     1731         ,output p-type
     1732         ,output p-format
     1733         ,output p-label
     1734         ,output p-user-can-edit
     1735         ,output p-output-display
     1736         ,output p-other
     1737         ) no-error .
     1738       if error-status :error
     1739       then do:
     1740         undo, return error return-value .
     1741       end.
     1742     end.
     1743   end procedure.
     1744   procedure clntattr-tooltip :
     1745     define input  parameter p-code    as character no-undo .
     1746     define output parameter p-tooltip as character no-undo .
     1747     define output parameter p-label   as character no-undo .
     1748     do
     1749     on error undo, return error return-value
     1750     :
     1751           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
     1752         (input  p-code
     1753         ,output p-tooltip
     1754         ,output p-label
     1755         ) no-error .
     1756       if error-status :error
     1757       then do:
     1758         undo, return error return-value .
     1759       end.
     1760     end.
     1761   end procedure.
     1762   procedure clntattr-value :
     1763     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1764     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1765     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     1766     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
     1767     define output parameter p-type     as character no-undo .
     1768     do
     1769     on error undo, return error return-value
     1770     :
     1771           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-value in g#attr-lib
     1772         (input  p-obj-type
     1773         ,input  p-obj-code
     1774         ,input  p-code
     1775         ,output p-value
     1776         ,output p-type
     1777         ) no-error .
     1778       if error-status :error
     1779       then do:
     1780         undo, return error return-value .
     1781       end.
     1782     end.
     1783   end procedure.
     1784   procedure clntattr-write :
     1785     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1786     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1787     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     1788     define input  parameter p-value    like ub.clients-attr.attr-value no-undo .
     1789     do
     1790     on error undo, return error return-value
     1791     :
     1792           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-write in g#attr-lib
     1793         (input  p-obj-type
     1794         ,input  p-obj-code
     1795         ,input  p-code
     1796         ,input  p-value
     1797         ) no-error .
     1798       if error-status :error
     1799       then do:
     1800         undo, return error return-value .
     1801       end.
     1802     end.
     1803   end procedure.
     1804   procedure clntattr-exist :
     1805     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1806     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1807     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     1808     define output parameter p-exist    as logical  no-undo .
     1809     do
     1810     on error undo, return error return-value
     1811     :
     1812           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-exist in g#attr-lib
     1813         (input  p-obj-type
