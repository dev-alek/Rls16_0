     3494        )
     3495     or (can-query (self, "read-only")
     3496        and
     3497        self :read-only = false
     3498        )
     3499     then do:
     3500       assign
     3501         self :screen-value = ?
     3502       .
     3503     end.
     3504     return no-apply.
