     3049             VIEW-AS FILL-IN
     3050             SIZE 11.3 BY 1.03
     3051        temp-dis-card.valid-from AT ROW 15.4 COL 46.5 COLON-ALIGNED WIDGET-ID 4
     3052             LABEL "Действует с"
     3053             VIEW-AS FILL-IN
     3054             SIZE 12.6 BY .97
     3055        temp-dis-card.valid-date AT ROW 15.4 COL 75.1 COLON-ALIGNED
     3056             LABEL "Действует до"
     3057             VIEW-AS FILL-IN
     3058             SIZE 12.6 BY .97
     3059        temp-dis-card.issue-code AT ROW 16.83 COL 15.8 COLON-ALIGNED
     3060             LABEL "Выдал магазин"
     3061             VIEW-AS FILL-IN
     3062             SIZE 6.6 BY .93
     3063        B-shop AT ROW 16.83 COL 32.9
     3064        temp-dis-card.cli-message AT ROW 18.63 COL 2.5
     3065             LABEL "Сообщ. для клиента(POS MAGIA)"
     3066             VIEW-AS FILL-IN
     3067             SIZE 45.5 BY 1
     3068        temp-dis-card.first-main-card AT ROW 2.6 COL 74 COLON-ALIGNED
     3069             LABEL "Первичная основная карта"
     3070              VIEW-AS TEXT
     3071             SIZE 20 BY .67
     3072             FGCOLOR 4
     3073        temp-dis-card.type AT ROW 2.67 COL 15.4 COLON-ALIGNED
     3074             LABEL "Тип карты"
     3075              VIEW-AS TEXT
     3076             SIZE 15.1 BY 1 TOOLTIP "Тип карты"
     3077             FGCOLOR 4
     3078        temp-dis-card.first-card AT ROW 3.93 COL 73.5 COLON-ALIGNED
     3079             LABEL "Первичная карта"
     3080              VIEW-AS TEXT
     3081             SIZE 20.5 BY .67
     3082             FGCOLOR 9
     3083        temp-dis-card.emitent-host-code AT ROW 4.03 COL 15.3 COLON-ALIGNED
     3084             LABEL "Эмитент"
     3085                     FORMAT ">>>>>>>>99"
     3086              VIEW-AS TEXT
     3087             SIZE 7.1 BY 1
     3088             FGCOLOR 4
     3089       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3090            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE .
     3091   DEFINE FRAME Dialog-Frame
     3092        emitent-name AT ROW 4.17 COL 20.8 COLON-ALIGNED NO-LABEL
     3093        temp-dis-card.sourced-card AT ROW 6.87 COL 15.5 COLON-ALIGNED
     3094             LABEL "К карте"
     3095              VIEW-AS TEXT
     3096             SIZE 20 BY .67
     3097        temp-dis-card.main-card AT ROW 6.87 COL 64.5 COLON-ALIGNED
     3098             LABEL "Основная"
     3099              VIEW-AS TEXT
     3100             SIZE 25.5 BY .67
     3101             FGCOLOR 4
     3102        var-r-b-abbr AT ROW 13.53 COL 38 COLON-ALIGNED NO-LABEL
     3103        issue-code-name AT ROW 16.83 COL 34.9 COLON-ALIGNED NO-LABEL
     3104        "Использовать скидку" VIEW-AS TEXT
     3105             SIZE 20.9 BY .93 AT ROW 10.47 COL 2.5
     3106        RECT-1 AT ROW 11.67 COL 2
     3107        RECT-2 AT ROW 15.03 COL 2
     3108        RECT-3 AT ROW 2.17 COL 2
     3109        RECT-4 AT ROW 18.37 COL 2
     3110        SPACE(18.29) SKIP(0.02)
     3111       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3112            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3113            TITLE "Дисконтная карта".
     3114   ASSIGN
     3115          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3116          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3117   ASSIGN
     3118          B-scard:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3119   ASSIGN
     3120          temp-dis-card.main-card:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3121   ASSIGN
     3122          temp-dis-card.sourced-card:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3123   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3124   DO:
     3125      RUN check-update-prop IN THIS-PROCEDURE ( input yes) NO-ERROR.
     3126      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     3127      dc-ri = ?.
     3128      run perproc-delete-from-parent (  input this-procedure , input "").
     3129      APPLY "END-ERROR":U TO SELF.
     3130   END.
     3131   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     3132   DO:
     3133     run check-update-prop in this-procedure ( input no) .
     3134     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     3135     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     3136     run perproc-delete-from-parent( input this-procedure , input "").
     3137   END.
     3138   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     3139   DO:
     3140       DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
     3141         run ref/cdchist.w (
     3142                       INPUT parparentproc
     3143                       ,input parhost-code
     3144                       ,input parobj-type
     3145                       ,input parobj-code
     3146                       ,input "":U
     3147                       ,input "one":U
     3148                       ,input temp-dis-card.d-card
     3149                       ,input temp-dis-card.card-num
     3150                       ,input parobj-type
     3151                       ,input parobj-code
     3152                       ,input parhost-code
     3153                       ,input ?
     3154                       ,input "":U
     3155                       ,input "":U
     3156                       ,input ?
     3157                       ,input-output v-list
     3158                    ) no-error .
     3159   END.
     3160   ON CHOOSE OF b-long IN FRAME Dialog-Frame
     3161   DO:
     3162     if not available temp-dis-card then return no-apply.
     3163     run proc-b-long in this-procedure no-error.
     3164   END.
     3165   ON CHOOSE OF B-ltype IN FRAME Dialog-Frame
     3166   DO:
     3167     DEFINE VARIABLE v-ri AS RECID NO-UNDO.
     3168     DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
     3169     IF AVAILABLE temp-dis-card THEN DO:
     3170         FIND FIRST buf_dis-card-type NO-LOCK WHERE
     3171                   buf_dis-card-type.emitent-host-code = input frame Dialog-Frame temp-dis-card.emitent-host-code
     3172             AND buf_dis-card-type.TYPE = input frame Dialog-Frame  temp-dis-card.TYPE
     3173             AND buf_dis-card-type.host-code = 0
     3174             AND buf_dis-card-type.obj-TYPE = "":U
     3175             AND buf_dis-card-type.obj-code = 0
     3176             NO-ERROR.
     3177       IF AVAILABLE buf_dis-card-type  THEN DO:
     3178           ASSIGN
     3179               v-ri = RECID(buf_dis-card-type)
     3180               .
     3181           run ref/dc-typei.w (
     3182                           input parparentproc
     3183                         , input 'ПРОСМОТР':U
     3184                         , input parhost-code
     3185                         , input parobj-type
     3186                         , input parobj-code
     3187                         , INPUT-OUTPUT v-ri ) NO-ERROR.
     3188       END.
     3189     END.
     3190   END.
     3191   ON CHOOSE OF b-prop IN FRAME Dialog-Frame
     3192   DO:
     3193       if not available temp-dis-card then return no-apply.
     3194       run proc-b-prop in this-procedure no-error.
     3195   END.
     3196   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     3197   DO:
     3198     RUN check-update-prop IN THIS-PROCEDURE ( input yes) NO-ERROR.
     3199     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     3200      dc-ri = ?.
     3201      run perproc-delete-from-parent ( input this-procedure , input "").
     3202      apply "go" to frame Dialog-Frame.
     3203   END.
     3204   ON CHOOSE OF B-scard IN FRAME Dialog-Frame
     3205   DO:
     3206    run proc-b-scard in this-procedure no-error.
     3207    if error-status:error then return no-apply.
     3208   END.
     3209   ON CHOOSE OF B-shop IN FRAME Dialog-Frame
     3210   DO:
     3211    RUN local-shop-chk ("issue-code", "button").
     3212     apply "entry" to temp-dis-card.issue-code in FRAME Dialog-Frame.
     3213     return no-apply.
     3214   END.
     3215   ON CHOOSE OF B-type IN FRAME Dialog-Frame
     3216   DO:
     3217    run proc-b-type in this-procedure no-error.
     3218    if error-status:error then return no-apply.
     3219   END.
     3220   ON VALUE-CHANGED OF temp-dis-card.credit-card IN FRAME Dialog-Frame
     3221   DO:
     3222     run enable-lim-kr in this-procedure.
     3223   END.
     3224   ON VALUE-CHANGED OF temp-dis-card.is-subsid IN FRAME Dialog-Frame
     3225   DO:
     3226     ASSIGN t-overissue.
     3227     CASE t-overissue:
     3228       when yes then do:
     3229           VIEW
     3230           temp-dis-card.sourced-card
     3231           In frame Dialog-Frame.
     3232           DISPLAY
     3233           b-scard
     3234           with frame Dialog-Frame.
     3235           ENABLE
     3236           b-scard
     3237           with frame Dialog-Frame.
     3238       end.
     3239       when no then do:
     3240           DISABLE
     3241           b-scard
     3242           temp-dis-card.sourced-card
     3243           with frame Dialog-Frame.
     3244           HIDE
     3245           b-scard
     3246           temp-dis-card.sourced-card
     3247           in frame Dialog-Frame.
     3248       end.
     3249     END CASE.
     3250   END.
     3251   ON LEAVE OF temp-dis-card.issue-code IN FRAME Dialog-Frame
     3252   DO:
     3253       if input frame Dialog-Frame temp-dis-card.issue-code <> temp-dis-card.issue-code then do:
     3254       run local-shop-chk ("issue-code", "leave-message").
     3255     end.
     3256   END.
     3257   ON RETURN OF temp-dis-card.issue-code IN FRAME Dialog-Frame
     3258   DO:
     3259       run local-shop-chk ("issue-code", "ret-mouse").
     3260     apply "entry" to temp-dis-card.issue-code in frame Dialog-Frame.
     3261     return no-apply.
     3262   END.
     3263   ON VALUE-CHANGED OF T-overissue IN FRAME Dialog-Frame
     3264   DO:
     3265     ASSIGN t-overissue.
     3266     CASE t-overissue:
     3267       when yes then do:
     3268           VIEW
     3269           temp-dis-card.sourced-card
     3270           In frame Dialog-Frame.
     3271           DISPLAY
     3272           b-scard
     3273           with frame Dialog-Frame.
     3274           ENABLE
     3275           b-scard
     3276           with frame Dialog-Frame.
     3277       end.
     3278       when no then do:
     3279           DISABLE
     3280           b-scard
     3281           temp-dis-card.sourced-card
     3282           with frame Dialog-Frame.
     3283           HIDE
     3284           b-scard
     3285           temp-dis-card.sourced-card
     3286           in frame Dialog-Frame.
     3287       end.
     3288     END CASE.
     3289   END.
     3290   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3291   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3292   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3293   on help of frame Dialog-Frame
     3294   do:
     3295     run gbl/app_help.p
     3296       (input this-procedure :file-name
     3297       ,input ''
     3298       ,input ?
     3299       ) no-error.
     3300     if error-status :error then do:
     3301       message
     3302         "Ошибка при вызове помощи"
     3303         error-status :get-message(1)
     3304         view-as alert-box .
     3305     end.
     3306   end.
     3307   run minbtn-set in this-procedure .
     3308   on choose of b-help in frame Dialog-Frame
     3309   do:
     3310     apply "help":u to frame Dialog-Frame .
     3311   end.
     3312   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3313   procedure minbtn-set :
     3314       do
     3315           on error undo, return error return-value
     3316           :
     3317           define variable ii              as integer       no-undo .
     3318           define variable fh              as widget-handle no-undo .
     3319           define variable hh              as widget-handle no-undo .
     3320           define variable v-h             as handle        extent 4 no-undo .
     3321           define variable v-name-button   as character     no-undo .
     3322           define variable v-help-old-x    as decimal       no-undo .
     3323           define variable v-help-old-y    as decimal       no-undo .
     3324           define variable v-help-old-size as decimal       no-undo .
     3325           define variable v-frame-width   as decimal       no-undo .
     3326           define variable jj              as integer       no-undo .
     3327           do
     3328               on error undo, return error
     3329               :
     3330               assign
     3331                   v-frame-width = frame Dialog-Frame:width - 0.3
     3332                   fh            = frame Dialog-Frame:first-child
     3333                   hh            = fh:first-child
     3334                   ii            = 1
     3335                   .
     3336               do while valid-handle(hh):
     3337                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3338                   do:
     3339                       case lc(hh:name) :
     3340                           when "b-help" then
     3341                               do:
     3342                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3343                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3344                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3345                                   hh:TOOLTIP = "Помощь" .
     3346                                   v-help-old-x = hh:column .
     3347                                   v-help-old-y = hh:row    .
     3348                                   v-help-old-size = hh:width .
     3349                                   hh:width-chars = 2.5 .
     3350                               end.
     3351                           when "b-print" then
     3352                               do:
     3353                                   hh:load-image("cmp/b-print.bmp":u) .
     3354                                   hh:TOOLTIP = "Печать" .
     3355                                   v-h[ii] = hh:handle .
     3356                                   ii = ii + 1 .
     3357                                   hh:width-chars = 3 .
     3358                               end.
     3359                           when "b-history" or
     3360                           when "b-hist" then
     3361                               do:
     3362                                   hh:load-image("cmp/b-hist.bmp":u) .
     3363                                   hh:TOOLTIP = "История" .
     3364                                   v-h[ii] = hh:handle .
     3365                                   ii = ii + 1 .
     3366                                   hh:width-chars = 3 .
     3367                               end.
     3368                           when "b-sch" then
     3369                               do:
     3370                                   hh:load-image("cmp/b-sch.bmp":u) .
     3371                                   hh:TOOLTIP = "Установка Фильтра" .
     3372                                   v-h[ii] = hh:handle .
     3373                                   ii = ii + 1 .
     3374                                   hh:width-chars = 3 .
     3375                               end.
     3376                           when "b-hist-user" then
     3377                               do:
     3378                                   hh:load-image("cmp/b-hist.bmp":u) .
     3379                                   hh:TOOLTIP = "История пользователя" .
     3380                                   ii = ii + 1 .
     3381                               end.
     3382                       end case.
     3383                   end.
     3384                   hh = hh:next-sibling.
     3385               end.
     3386               b-help:column = v-frame-width - b-help:width-chars.
     3387               jj = 0.
     3388               repeat ii = 4 to 1 by -1 :
     3389                   if valid-handle (v-h[ii] ) then
     3390                   do:
     3391                       jj  = jj + 1 .
     3392                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3393                       v-h[ii]:row    = v-help-old-y .
     3394                   end.
     3395               end.
     3396           end.
     3397       end.
     3398   end procedure.
     3399   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3400   ON TAB ANYWHERE
     3401   DO:
     3402   define variable ii as integer no-undo .
     3403   define variable fh as widget-handle no-undo .
     3404   define variable hh as widget-handle no-undo .
     3405   define variable v-next-widget-name as character no-undo .
     3406   if v-tab-order <> '' then do:
     3407     if self:type = "TOGGLE-BOX" then
     3408     self:BGCOLOR = ?.
     3409     assign
     3410     ii = lookup(self:name, v-tab-order).
     3411     assign
     3412     ii = ii + 1
     3413     v-next-widget-name = entry(ii, v-tab-order)
     3414     no-error .
     3415     if error-status:error then do:
     3416       assign
     3417       ii = 1
     3418       v-next-widget-name = entry( ii, v-tab-order)
     3419       .
     3420     end.
     3421     assign
     3422     fh = frame Dialog-Frame:first-child
     3423     hh = fh:first-child
     3424     .
     3425     do while valid-handle(hh):
     3426       if hh:name = v-next-widget-name then do:
     3427         if hh:sensitive  = yes
     3428         AND hh:visible = yes then do:
     3429           if hh:type = "TOGGLE-BOX":U then do:
     3430             assign
     3431             hh:BGcolor = 1
     3432             .
     3433           end.
     3434           APPLY "ENTRY" to hh.
     3435           return no-apply.
     3436         end.
     3437         else do:
     3438           APPLY "TAB" to hh.
     3439           return no-apply.
     3440         end.
     3441       end.
     3442       hh = hh:next-sibling.
     3443     end.
     3444   end.
     3445   END.
     3446   ON BACK-TAB ANYWHERE
     3447   DO:
     3448   define variable ii as integer no-undo .
     3449   define variable fh as widget-handle no-undo .
     3450   define variable hh as widget-handle no-undo .
     3451   define variable v-next-widget-name as character no-undo .
     3452   if v-tab-order <> '' then do:
     3453     assign
     3454     ii = lookup(self:name, v-tab-order).
     3455     .
     3456     assign
     3457     ii = (if ii = 1
     3458           then  num-entries(v-tab-order)
     3459           else ii - 1
     3460           )
     3461     v-next-widget-name = entry(ii, v-tab-order)
     3462     .
     3463     assign
     3464     fh = frame Dialog-Frame:first-child
     3465     hh = fh:first-child
     3466     .
     3467     do while valid-handle(hh):
     3468       if hh:name = v-next-widget-name then do:
     3469         if hh:sensitive  = yes
     3470         AND hh:visible = yes then do:
     3471           if hh:type = "TOGGLE-BOX":U then do:
     3472             assign
     3473             hh:BGcolor = 1
     3474             .
     3475           end.
     3476           APPLY "ENTRY" to hh.
     3477           return no-apply.
     3478         end.
     3479         else do:
     3480         APPLY "BACK-TAB" to hh.
     3481         return no-apply.
     3482         end.
     3483       end.
     3484       hh = hh:next-sibling.
     3485     end.
     3486     end.
     3487   END.
     3488   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3489   on ' ' of temp-dis-card.issue-date in frame Dialog-Frame
     3490   do:
