     4358             temp-dis-card.cash-d-pcnt temp-dis-card.category
     4359             temp-dis-card.credit-card temp-dis-card.debet-card
     4360             temp-dis-card.staff-card temp-dis-card.lim-kr temp-dis-card.issue-date
     4361             temp-dis-card.valid-from temp-dis-card.valid-date
     4362             temp-dis-card.issue-code temp-dis-card.cli-message
     4363             temp-dis-card.first-main-card temp-dis-card.type
     4364             temp-dis-card.first-card temp-dis-card.emitent-host-code
     4365             temp-dis-card.main-card
     4366         WITH FRAME Dialog-Frame.
     4367     ENABLE B-exit RECT-1 RECT-2 RECT-3 RECT-4 b-quit b-prop B-ltype b-long B-hist
     4368            B-Help B-type temp-dis-card.d-card T-overissue B-scard
     4369            temp-dis-card.d-pcnt temp-dis-card.cash-d-pcnt temp-dis-card.category
     4370            v-pcnt-method temp-dis-card.credit-card temp-dis-card.debet-card
     4371            temp-dis-card.staff-card temp-dis-card.lim-kr temp-dis-card.issue-date
     4372            temp-dis-card.valid-from temp-dis-card.valid-date
     4373            temp-dis-card.issue-code B-shop temp-dis-card.cli-message
     4374            temp-dis-card.type temp-dis-card.first-card
     4375            temp-dis-card.emitent-host-code emitent-name var-r-b-abbr
     4376            issue-code-name
     4377         WITH FRAME Dialog-Frame.
     4378     VIEW FRAME Dialog-Frame.
     4379   END PROCEDURE.
     4380   PROCEDURE fill-tables :
     4381   define variable varalien-str as character no-undo .
     4382   define variable v-type as character no-undo .
     4383   define variable v-exist as logical no-undo .
     4384   define variable v-proc-handle as handle no-undo .
     4385   define variable v-id as integer no-undo .
     4386   define buffer buf_dis-card-type for ub.dis-card-type.
     4387   FOR EACH tt0-dis-card-property:
     4388       DELETE tt0-dis-card-property.
     4389   END.
     4390   FOR EACH temp-dis-card:
     4391       DELETE temp-dis-card.
     4392   END.
     4393   if ref-mode = '@client':U then do:
     4394     find first buf_dis-card-type no-lock where
     4395               buf_dis-card-type.type = '@client':U
     4396           and buf_dis-card-type.emitent-host-code = 0 no-error.
     4397     if not available buf_Dis-card-type then do:
     4398       message
     4399       substitute("В Вашей системе невозможно работать с картами типа КЛИЕНТ-СЧЕТ&1" +
     4400                  "Отсутствует специальный тип карты КЛИЕНТ-СЧЕТ"
     4401                  , chr(10))
     4402       view-as alert-box error .
     4403       undo, return error .
     4404     end.
     4405     FIND ub.clients WHERE recid( ub.clients ) = cli-ri NO-LOCK.
     4406     if not avail ub.clients then do:
     4407       dc-ri = ?.
     4408       undo, return error.
     4409     end.
     4410     if ub.clients.obj-type = 'маг':U OR ub.clients.obj-type = 'скл':U then do:
     4411       dc-ri = ?.
     4412       message
     4413       substitute("Дисконтныe карты выдаются&1"  +
     4414                  "только внешним контрагентам"
     4415                  , chr(10))
     4416       view-as alert-box error.
     4417       undo, return error.
     4418     end.
     4419     find first ub.dis-card no-lock where
     4420              ub.dis-card.d-card = ('K':U + string(if clients.obj-type = 'орг':U then 1 else 0) + string(clients.obj-code, '999999999')) no-error .
     4421     if not available ub.dis-card then do:
     4422       assign
     4423       v-is-dct-client = yes
     4424       ref-mode = 'ДОБАВЛЕНИЕ':U
     4425       .
     4426     end.
     4427     else do:
     4428       find first ub.dis-card exclusive-lock where
     4429               ub.dis-card.d-card = ('K':U + string(if clients.obj-type = 'орг':U then 1 else 0) + string(clients.obj-code, '999999999')) no-error .
     4430       if locked ub.dis-card then do:
     4431         message vss-workfile vss-revision vss-description skip
     4432                 "Запись дисконтной карты занята"
     4433         view-as alert-box error .
     4434         return error.
     4435       end.
     4436       assign
     4437       v-is-dct-client = yes
     4438       ref-mode = 'ИЗМЕНЕНИЕ':U
     4439       dc-ri = recid(dis-card)
     4440       .
     4441     end.
     4442   end.
     4443     CASE ref-mode:
     4444       when 'ИЗМЕНЕНИЕ':U then do:
     4445         find first dis-card exclusive-lock where
     4446                   recid(dis-card) = dc-ri no-wait no-error.
     4447         if locked dis-card then do:
     4448           message vss-workfile vss-revision vss-description skip
     4449                   "Запись дисконтной карты занята"
     4450           view-as alert-box error .
     4451           return error.
     4452         end.
     4453         if not available dis-card then do:
     4454           message vss-workfile vss-revision vss-description skip
     4455                   "Запись дисконтной карты не найдена"
     4456           view-as alert-box error .
     4457           return error.
     4458         end.
     4459         find first clients No-LOCK WHERE
     4460                    clients.obj-type = dis-card.cli-type AND
     4461                    clients.obj-code = dis-card.cli-code no-error .
     4462         if not avail clients then do:
     4463           message vss-workfile vss-revision vss-description skip
     4464                   "Запись клиента дисконтной карты не найдена"
     4465           view-as alert-box error .
     4466           return error.
     4467         end.
     4468         create temp-dis-card.
     4469         buffer-copy dis-card to temp-dis-card.
     4470         assign
     4471         v-initial-type = temp-dis-card.type
     4472         v-initial-emitent-host-code = temp-dis-card.emitent-host-code
     4473         .
     4474       end.
     4475       when 'ПРОСМОТР':U then do:
     4476         find first dis-card No-LOCK where recid(dis-card) = dc-ri no-error.
     4477         if not available dis-card then do:
     4478           message vss-workfile vss-revision vss-description skip
     4479                   "Запись дисконтной карты не найдена"
     4480           view-as alert-box error .
     4481           return error.
     4482         end.
     4483         find first clients No-LOCK WHERE
     4484                    clients.obj-type = dis-card.cli-type AND
     4485                    clients.obj-code = dis-card.cli-code no-error .
     4486         if not avail clients then do:
     4487           message vss-workfile vss-revision vss-description skip
     4488                   "Запись клиента дисконтной карты не найдена"
     4489           view-as alert-box error .
     4490           return error.
     4491         end.
     4492         create temp-dis-card.
     4493         buffer-copy dis-card to temp-dis-card.
     4494       end.
     4495       when 'ДОБАВЛЕНИЕ':U then do:
     4496         if v-is-copy then do:
     4497           find first dis-card No-LOCK where recid(dis-card) = dc-ri no-error.
     4498           if not available dis-card then do:
     4499             message vss-workfile vss-revision vss-description skip
     4500                     "Запись дисконтной карты для копирования не найдена"
     4501             view-as alert-box error .
     4502             return error.
     4503           end.
     4504           if dis-card.type = '@client':U then do:
     4505             message vss-workfile vss-revision vss-description skip
     4506             "Нельзя копировать карту типа КЛИЕНТ-СЧЕТ"
     4507             view-as alert-box error .
     4508             return error.
     4509           end.
     4510           create temp-dis-card.
     4511           if v-is-copy and dis-card.mask-card = yes then
     4512           buffer-copy dis-card
     4513           except cli-type cli-code issue-date sourced-card issue-code valid-from valid-date saldo-base saldo-rubl mask-card
     4514           first-card first-main-card main-card is-subsid overissue-num
     4515           to temp-dis-card.
     4516           else
     4517           buffer-copy dis-card
     4518           except cli-type cli-code d-card issue-date sourced-card issue-code valid-from valid-date saldo-base saldo-rubl mask-card
     4519           first-card first-main-card main-card is-subsid overissue-num
     4520           to temp-dis-card.
     4521         end.
     4522         if v-is-subsid then do:
     4523           find first main_dis-card exclusive-lock where
     4524                     recid(main_dis-card) = dc-ri no-wait no-error.
     4525           if locked main_dis-card then do:
     4526             message vss-workfile vss-revision vss-description skip
     4527                     "Запись основной дисконтной карты занята"
     4528             view-as alert-box error .
     4529             return error.
     4530           end.
     4531           if not available main_dis-card then do:
     4532             message vss-workfile vss-revision vss-description skip
     4533                     "Запись основной дисконтной карты не найдена"
     4534             view-as alert-box error .
     4535             return error.
     4536           end.
     4537           if main_dis-card.mask-card then do:
     4538             message vss-workfile vss-revision vss-description skip
     4539             "Нельзя выпускать дополнительную карту к карте-маске"
     4540             view-as alert-box error .
     4541             return error.
     4542           end.
     4543           if main_dis-card.type = '@client':U then do:
     4544             message vss-workfile vss-revision vss-description skip
     4545             "Нельзя выпускать дополнительную карту к карте типа КЛИЕНТ-СЧЕТ"
     4546             view-as alert-box error .
     4547             return error.
     4548           end.
     4549           find first clients No-LOCK WHERE
     4550                     clients.obj-type = main_dis-card.cli-type AND
     4551                     clients.obj-code = main_dis-card.cli-code no-error .
     4552           if not avail clients then do:
     4553             message vss-workfile vss-revision vss-description skip
     4554                     "Запись клиента основной дисконтной карты не найдена"
     4555             view-as alert-box error .
     4556             return error.
     4557           end.
     4558           create temp-dis-card.
     4559           buffer-copy main_dis-card except d-card cli-type cli-code
     4560           issue-date issue-code valid-from valid-date sourced-card saldo-base saldo-rubl
     4561           to temp-dis-card
     4562           assign
     4563           temp-dis-card.main-card = main_dis-card.d-card
     4564           temp-dis-card.is-subsid = yes
     4565           .
     4566         end.
     4567         if v-is-sourced then do:
     4568           find first sourced_dis-card exclusive-lock where
     4569                     recid(sourced_dis-card) = dc-ri no-wait no-error.
     4570           if locked sourced_dis-card then do:
     4571             message vss-workfile vss-revision vss-description skip
     4572                     "Запись перевыпускаемой дисконтной карты занята"
     4573             view-as alert-box error .
     4574             return error.
     4575           end.
     4576           if not available sourced_dis-card then do:
     4577             message vss-workfile vss-revision vss-description skip
     4578                     "Запись перевыпускаемой дисконтной карты не найдена"
     4579             view-as alert-box error .
     4580             return error.
     4581           end.
     4582           if sourced_dis-card.mask-card then do:
     4583             message vss-workfile vss-revision vss-description skip
     4584             "Нельзя перевыпускать карту-маску"
     4585             view-as alert-box error .
     4586             return error.
     4587           end.
     4588           if sourced_dis-card.type = '@client':U then do:
     4589             message vss-workfile vss-revision vss-description skip
     4590             "Нельзя перевыпускать карту типа КЛИЕНТ-СЧЕТ"
     4591             view-as alert-box error .
     4592             return error.
     4593           end.
     4594           find first clients No-LOCK WHERE
     4595                     clients.obj-type = sourced_dis-card.cli-type AND
     4596                     clients.obj-code = sourced_dis-card.cli-code no-error .
     4597           if not avail clients then do:
     4598             message vss-workfile vss-revision vss-description skip
     4599                     "Запись клиента дисконтной карты не найдена"
     4600             view-as alert-box error .
     4601             return error.
     4602           end.
     4603           create temp-dis-card.
     4604           buffer-copy sourced_dis-card except d-card
     4605           issue-date issue-code valid-from valid-date sourced-card saldo-base saldo-rubl
     4606           to temp-dis-card
     4607           assign
     4608           temp-dis-card.sourced-card = sourced_dis-card.d-card
     4609           .
     4610         end.
     4611         if not v-is-sourced then do:
     4612           FIND clients WHERE recid( clients ) = cli-ri NO-LOCK.
     4613             if not avail clients then do:
     4614               dc-ri = ?.
     4615               return error.
     4616             end.
     4617             if clients.obj-type = 'маг':U OR clients.obj-type = 'скл':U then do:
     4618               dc-ri = ?.
     4619               message "Дисконтную карты выдаются" skip
     4620                       "только внешним контрагентам"
     4621               view-as alert-box error.
     4622               return error.
     4623             end.
     4624           end.
     4625           run clntattr-value in this-procedure (
     4626                                                 input clients.obj-type
     4627                                                 ,input  clients.obj-code
     4628                                                 ,input  'alien':U
     4629                                                 ,output varalien-str
     4630                                                 ,output v-type) no-error .
     4631           if not error-status:error
     4632           AND logical(varalien-str) = yes then do:
     4633             message
     4634             "Нельзя изменять выдать ДК ЧУЖОМУ клиенту/фирме"
     4635             view-as alert-box error .
     4636             undo, return error .
     4637           end.
     4638           if v-is-copy and available temp-dis-card then do:
     4639             assign
     4640             temp-dis-card.cli-type = clients.obj-type
     4641             temp-dis-card.cli-code = clients.obj-code
     4642             .
     4643           end.
     4644         if not avail temp-dis-card then create temp-dis-card.
     4645         assign
     4646         temp-dis-card.cli-type = clients.obj-type
     4647         temp-dis-card.cli-code = clients.obj-code
     4648         .
     4649         if v-is-dct-client then do:
     4650           assign
     4651           temp-dis-card.type = buf_dis-card-type.type
     4652           temp-dis-card.emitent-host-code = buf_dis-card-type.emitent-host-code
     4653           temp-dis-card.d-card = ('K':U + string(if clients.obj-type = 'орг':U then 1 else 0) + string(clients.obj-code, '999999999'))
     4654           .
     4655         end.
     4656       end.
     4657     END CASE.
     4658   END PROCEDURE.
     4659   PROCEDURE local-shop-chk :
     4660   define input parameter p-man    as character no-undo.
     4661   define input parameter p-action as character no-undo.
     4662   DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
     4663   if p-man = "issue-code" and p-action = "ret-mouse" then do:
     4664   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4665   define variable v-ref-rec28   as recid no-undo .
     4666     find first cli-buf where
     4667          cli-buf.obj-code = input frame Dialog-Frame temp-dis-card.issue-code
     4668      and cli-buf.obj-type = 'маг':U  no-lock no-error.
     4669     if not available cli-buf  then do:
     4670       ref-list = string(v-ref-rec28).
     4671       run adm/shops.w (
     4672                  input parparentproc
     4673                , input "b-sel"
     4674                , input-output ref-list
     4675                , no).
     4676       assign v-ref-rec28 = integer( ref-list ).
     4677       find first shop-buf where
     4678               recid (shop-buf) = v-ref-rec28  no-lock no-error.
     4679       if available shop-buf then do:
     4680         find first cli-buf no-lock where
     4681                   cli-buf.obj-type = 'маг':U
     4682               and cli-buf.obj-code = shop-buf.obj-code .
     4683       end.
     4684       else do:
     4685         release cli-buf.
     4686       end.
     4687       if not available shop-buf then do:
     4688         find first cli-buf where
     4689                   cli-buf.obj-code = input frame Dialog-Frame temp-dis-card.issue-code
     4690               and cli-buf.obj-type = 'маг':U
     4691         no-lock no-error.
     4692       end.
     4693       if available cli-buf
     4694       and temp-dis-card.emitent-host-code <> 0
     4695       and cli-buf.host-code <> temp-dis-card.emitent-host-code then do:
     4696         message
     4697         substitute("Магазин должен принадлежать фирме с кодом &1", temp-dis-card.emitent-host-code)
     4698         view-as alert-box error .
     4699         find first cli-buf where
     4700                   cli-buf.obj-code = input frame Dialog-Frame temp-dis-card.issue-code
     4701               and cli-buf.obj-type = 'маг':U
     4702         no-lock no-error.
     4703       end.
     4704     end.
     4705     if available cli-buf then do:
     4706       display
     4707       cli-buf.obj-code @ temp-dis-card.issue-code
     4708       cli-buf.obj-name @ issue-code-name
     4709       with frame Dialog-Frame.
     4710       assign frame Dialog-Frame temp-dis-card.issue-code.
     4711     end.
     4712     else display ? @ temp-dis-card.issue-code
     4713                  ? @ issue-code-name with frame Dialog-Frame.
     4714     apply "entry" to  b-exit  in frame Dialog-Frame.
     4715     return no-apply.
     4716   end.
     4717   if p-man = "issue-code" and p-action = "button" then do:
     4718   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4719   define variable v-ref-rec29   as recid no-undo .
     4720     find cli-buf where
     4721          cli-buf.obj-code = input frame Dialog-Frame temp-dis-card.issue-code
     4722       and cli-buf.obj-type = 'маг':U no-lock no-error.
     4723     if available cli-buf then do:
     4724       find first shop-buf where
     4725               shop-buf.obj-code = cli-buf.obj-code  no-error .
     4726     end.
     4727     assign
     4728     v-ref-rec29 = ( if available shop-buf then recid( shop-buf ) else ? ).
     4729     release cli-buf.
     4730     release shop-buf.
     4731     if not available cli-buf  then do:
     4732       ref-list = string(v-ref-rec29).
     4733       run adm/shops.w (
     4734                  input parparentproc
     4735                , input "b-sel"
     4736                , input-output ref-list
     4737                , no).
     4738       assign v-ref-rec29 = integer( ref-list ).
     4739       find first shop-buf where
     4740               recid (shop-buf) = v-ref-rec29  no-lock no-error.
     4741       if available shop-buf then do:
     4742         find first cli-buf no-lock where
     4743                   cli-buf.obj-type = 'маг':U
     4744               and cli-buf.obj-code = shop-buf.obj-code .
     4745       end.
     4746       else do:
     4747         release cli-buf.
     4748       end.
     4749       if not available shop-buf then do:
     4750         find first cli-buf where
     4751                   cli-buf.obj-code = input frame Dialog-Frame temp-dis-card.issue-code
     4752               and cli-buf.obj-type = 'маг':U
     4753         no-lock no-error.
     4754       end.
     4755       if available cli-buf
     4756       and temp-dis-card.emitent-host-code <> 0
     4757       and cli-buf.host-code <> temp-dis-card.emitent-host-code then do:
     4758         message
     4759         substitute("Магазин должен принадлежать фирме с кодом &1", temp-dis-card.emitent-host-code)
     4760         view-as alert-box error .
     4761         find first cli-buf where
     4762                   cli-buf.obj-code = input frame Dialog-Frame temp-dis-card.issue-code
     4763               and cli-buf.obj-type = 'маг':U
     4764         no-lock no-error.
     4765       end.
     4766     end.
     4767     if available cli-buf then do:
     4768       display
     4769       cli-buf.obj-code @ temp-dis-card.issue-code
     4770       cli-buf.obj-name @ issue-code-name
     4771       with frame Dialog-Frame.
     4772       assign frame Dialog-Frame temp-dis-card.issue-code.
     4773     end.
     4774     else display ? @ temp-dis-card.issue-code
     4775                  ? @ issue-code-name with frame Dialog-Frame.
     4776     apply "entry" to  b-exit  in frame Dialog-Frame.
     4777     return no-apply.
     4778   end.
     4779   if p-man = "issue-code" and p-action = "leave-message" then do:
     4780   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4781   define variable v-ref-rec30   as recid no-undo .
     4782     find first cli-buf where
     4783          cli-buf.obj-code = input frame Dialog-Frame temp-dis-card.issue-code
     4784      and cli-buf.obj-type = 'маг':U  no-lock no-error.
     4785   if available cli-buf then do:
     4786       display
     4787       cli-buf.obj-code @ temp-dis-card.issue-code
     4788       cli-buf.obj-name @ issue-code-name
     4789       with frame Dialog-Frame.
     4790           assign frame Dialog-Frame temp-dis-card.issue-code.
     4791   end.
     4792   else do:
     4793     display
     4794     ? @ temp-dis-card.issue-code
     4795     ? @ issue-code-name
     4796     with frame Dialog-Frame.
     4797   end.
     4798   end.
     4799   END PROCEDURE.
     4800   PROCEDURE Myenable :
     4801   OPEN QUERY Dialog-Frame FOR EACH temp-dis-card SHARE-LOCK.
     4802   DEFINE VARIABLE v-today as date no-undo .
     4803   DEFINE VARIABLE v-time as integer no-undo .
     4804   assign
     4805   v-tab-order =
     4806   "b-quit,b-exit,b-prop,b-long,b-hist,b-ltype,b-help,b-type,":U +
     4807   "type,d-card,t-overissue,b-scard,d-pcnt,cash-d-pcnt,category,v-pcnt-method,credit-card,debet-card,staff-card,lim-kr,":U +
     4808   "valid-from,valid-date,issue-date,issue-code,b-shop,cli-message".
     4809   GET FIRST Dialog-Frame.
     4810   assign
     4811   v-pcnt-method:Radio-buttons in frame Dialog-Frame =
     4812    "Товар" + chr(44) + string('1':U) + chr(44) +
     4813    "Итог_чека" + chr(44) + string('2':U) + chr(44) +
     4814    "Товары_и_итог_чека" + chr(44) + string('3':U)
     4815   v-pcnt-method = (if ref-mode = 'ДОБАВЛЕНИЕ':U and not (v-is-copy or v-is-sourced or v-is-subsid)
     4816                  then '1':U
     4817                  else string(temp-dis-card.d-pcnt-method))
     4818   .
     4819   DISPLAY emitent-name
     4820   WITH FRAME Dialog-Frame.
     4821   if avail temp-dis-card and temp-dis-card.sourced-card <> "" then
     4822   t-overissue = yes.
     4823   IF AVAILABLE temp-dis-card
     4824   THEN
     4825   DISPLAY
     4826   temp-dis-card.d-card
     4827   temp-dis-card.d-pcnt
     4828   temp-dis-card.cash-d-pcnt
     4829   temp-dis-card.category
     4830   temp-dis-card.issue-date
     4831   temp-dis-card.issue-code
     4832   temp-dis-card.category
     4833   temp-dis-card.credit-card
     4834   temp-dis-card.lim-kr
     4835   temp-dis-card.type
     4836   (IF temp-dis-card.cli-message = ? THEN "":U ELSE temp-dis-card.cli-message) temp-dis-card.cli-message
     4837   temp-dis-card.emitent-host-code
     4838   temp-dis-card.valid-from
     4839   temp-dis-card.valid-date
     4840   temp-dis-card.sourced-card
     4841   t-overissue
     4842   v-pcnt-method
     4843   WITH FRAME Dialog-Frame.
     4844   IF temp-dis-card.sourced-card <> '':U THEN DO:
     4845     DISPLAY
     4846     temp-dis-card.first-card
     4847     WITH FRAME Dialog-Frame.
     4848   END.
     4849   ELSE DO:
     4850     HIDE
     4851     temp-dis-card.first-card
     4852      IN FRAME Dialog-Frame.
     4853   END.
     4854   IF temp-dis-card.is-subsid THEN DO:
     4855     DISPLAY
     4856     temp-dis-card.is-subsid
     4857     temp-dis-card.main-card
     4858     WITH FRAME Dialog-Frame.
     4859   END.
     4860   ELSE DO:
     4861     HIDE
     4862     temp-dis-card.is-subsid
     4863     temp-dis-card.main-card
     4864     IN FRAME Dialog-Frame.
     4865   END.
     4866   IF temp-dis-card.sourced-card <> '':U
     4867   and temp-dis-card.is-subsid
     4868   THEN DO:
     4869   DISPLAY
     4870   temp-dis-card.first-main-card
     4871   WITH FRAME Dialog-Frame.
     4872   end.
     4873   else do:
     4874   hide
     4875   temp-dis-card.first-main-card
     4876   in FRAME Dialog-Frame.
     4877   end.
     4878   IF avail temp-dis-card then do:
     4879   if temp-dis-card.debet-card = ? THEN do:
     4880     ASSIGN
     4881     temp-dis-card.debet-card  = NO
     4882     .
     4883   end.
     4884   DISPLAY
     4885   temp-dis-card.debet-card
     4886   WITH FRAME Dialog-Frame.
     4887   if ref-mode = 'ДОБАВЛЕНИЕ':U
     4888   and temp-dis-card.issue-code = 0
     4889   then do:
     4890     temp-dis-card.issue-code = parobj-code.
     4891   end.
     4892   display
     4893   temp-dis-card.issue-code
     4894   with frame Dialog-Frame .
     4895   if not temp-dis-card.mask-card then do:
     4896   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4897   define variable v-ref-rec31   as recid no-undo .
     4898     find first cli-buf where
     4899          cli-buf.obj-code = input frame Dialog-Frame temp-dis-card.issue-code
     4900      and cli-buf.obj-type = 'маг':U  no-lock no-error.
     4901   if not available cli-buf then do:
     4902     if input frame Dialog-Frame temp-dis-card.issue-code <> ""
     4903         and input frame Dialog-Frame temp-dis-card.issue-code <> ? then
     4904       message "Из справочника магазинов Вы должны выбрать магазин.".
     4905     display temp-dis-card.issue-code with frame Dialog-Frame.
     4906     find first cli-buf no-lock where
     4907               cli-buf.obj-code = input frame Dialog-Frame temp-dis-card.issue-code
     4908          and cli-buf.obj-type = 'маг':U no-error.
     4909   end.
     4910   if available cli-buf then do:
     4911       display
     4912       cli-buf.obj-code @ temp-dis-card.issue-code
     4913       cli-buf.obj-name @ issue-code-name
     4914       with frame Dialog-Frame.
     4915   end.
     4916   else do:
     4917     display
     4918     ? @ temp-dis-card.issue-code
     4919     ? @ issue-code-name
     4920     with frame Dialog-Frame.
     4921   end.
     4922   end.
     4923   IF temp-dis-card.staff-card = ? THEN do:
     4924         temp-dis-card.staff-card = NO.
     4925   END.
     4926   DISPLAY
     4927   temp-dis-card.staff-card
     4928   WITH FRAME Dialog-Frame.
     4929   end.
     4930   if ref-mode = 'ДОБАВЛЕНИЕ':U then do:
     4931   run cur-time in this-procedure ( output v-today, output v-time).
     4932     display
     4933     v-today @ temp-dis-card.issue-date
     4934     parobj-code @ temp-dis-card.issue-code
     4935     v-today @ temp-dis-card.valid-from
     4936     WITH FRAME Dialog-Frame.
     4937   end.
     4938   assign
     4939   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(58) + chr(32) + ub.clients.obj-name
     4940   .
     4941   ENABLE
     4942   B-exit when ref-mode <> 'ПРОСМОТР':U
     4943   b-quit
     4944   b-ltype WHEN (ref-mode <> 'ДОБАВЛЕНИЕ':U or v-is-sourced or v-is-subsid)
     4945   b-long
     4946   b-hist WHEN ref-mode <> 'ДОБАВЛЕНИЕ':U
     4947   B-Help
     4948   B-type when ref-mode <> 'ПРОСМОТР':U
     4949   t-overissue when (ref-mode = 'ДОБАВЛЕНИЕ':U and not v-is-copy and not v-is-sourced and not v-is-subsid)
     4950   temp-dis-card.d-card when ref-mode = 'ДОБАВЛЕНИЕ':U
     4951   temp-dis-card.d-pcnt when ref-mode <> 'ПРОСМОТР':U
     4952   temp-dis-card.cash-d-pcnt when ref-mode <> 'ПРОСМОТР':U
     4953   temp-dis-card.category when ref-mode <> 'ПРОСМОТР':U
     4954   temp-dis-card.issue-date when ref-mode <> 'ПРОСМОТР':U
     4955   temp-dis-card.issue-code when (ref-mode <> 'ПРОСМОТР':U and not temp-dis-card.mask-card)
     4956   temp-dis-card.valid-from  when ref-mode <> 'ПРОСМОТР':U
     4957   temp-dis-card.valid-date  when ref-mode <> 'ПРОСМОТР':U
     4958   B-shop when (ref-mode <> 'ПРОСМОТР':U and not temp-dis-card.mask-card)
     4959   temp-dis-card.credit-card when (paremitent-host-code <> 0 and
     4960                                 (ref-mode = 'ДОБАВЛЕНИЕ':U or
     4961                                  (ref-mode = 'ИЗМЕНЕНИЕ':U AND NOT temp-dis-card.credit-card)
     4962                                 )
     4963                                ) and ref-mode <> 'ПРОСМОТР':U
     4964   temp-dis-card.debet-card WHEN    (ref-mode = 'ДОБАВЛЕНИЕ':U or
     4965                                  (ref-mode = 'ИЗМЕНЕНИЕ':U AND NOT temp-dis-card.credit-card))
     4966   temp-dis-card.staff-card when ref-mode <> 'ПРОСМОТР':U
     4967   temp-dis-card.cli-message when ref-mode <> 'ПРОСМОТР':U
     4968   b-prop
     4969   WITH FRAME Dialog-Frame.
     4970   if v-is-dct-client then do:
     4971   disable
     4972   B-type
     4973   t-overissue
     4974   temp-dis-card.d-card
     4975   with frame Dialog-Frame .
     4976   run proc-b-type in this-procedure .
     4977   display
     4978   temp-dis-card.d-card
     4979   with frame Dialog-Frame .
     4980   end.
     4981   CASE ref-mode:
     4982   when 'ПРОСМОТР':U then do:
     4983     b-quit:label = "&Выход".
     4984     Hide b-exit in frame Dialog-Frame.
     4985     apply "entry" to b-quit.
     4986   end.
     4987   when 'ДОБАВЛЕНИЕ':U then do:
     4988     if v-is-sourced then do:
     4989       disable
     4990       b-type
     4991       temp-dis-card.emitent-host-code
     4992       t-overissue
     4993       with frame Dialog-Frame .
     4994     end.
     4995     if v-is-subsid then do:
     4996       disable
     4997       b-type
     4998       temp-dis-card.emitent-host-code
     4999       t-overissue
     5000       with frame Dialog-Frame .
     5001     end.
     5002     APPLY "entry" to temp-dis-card.d-card.
     5003   end.
     5004   when 'ИЗМЕНЕНИЕ':U then do:
     5005     APPLY "entry" to temp-dis-card.d-pcnt.
     5006   end.
     5007   END CASE.
     5008   hide
     5009   b-long in frame Dialog-Frame .
     5010   run enable-lim-kr in this-procedure.
     5011   run display-r-b-abbr in this-procedure no-error.
     5012   VIEW FRAME Dialog-Frame .
     5013   END PROCEDURE.
     5014   PROCEDURE proc-b-long :
     5015   DEFINE VARIABLE v-updated-now AS LOGICAL NO-UNDO.
     5016   define variable v-proc-handle as handle no-undo .
     5017   define variable v-id as integer no-undo .
     5018   define buffer buf_dis-card-long for ub.dis-card-long.
     5019   message
     5020   "Функционал в разработке" view-as alert-box .
     5021   return.
     5022   END PROCEDURE.
     5023   PROCEDURE proc-b-prop :
     5024   define variable v-data-type as character no-undo .
     5025   define variable v-format as character no-undo .
     5026   define variable v-label as character no-undo .
     5027   define variable v-range as integer no-undo .
     5028   define variable v-rw-option as character no-undo .
     5029   DEFINE VARIABLE v-updated-now AS LOGICAL NO-UNDO.
     5030   define variable v-proc-handle as handle no-undo .
     5031   define variable v-id as integer no-undo .
     5032   define buffer buf_dis-card-property for ub.dis-card-property.
     5033     do
     5034     on error undo, return error
     5035     :
     5036   assign frame Dialog-Frame
     5037   temp-dis-card.d-card
     5038   temp-dis-card.emitent-host-code
     5039   .
     5040   if ref-mode = 'ИЗМЕНЕНИЕ':U then do:
     5041     do transaction
     5042     on error undo, return error return-value
     5043     on stop undo, return error return-value
     5044     :
     5045         Find first locked_dis-card-property exclusive-lock  where
     5046                 locked_dis-card-property.d-card = temp-dis-card.d-card
     5047             AND locked_dis-card-property.host-code = 0
     5048             AND locked_dis-card-property.obj-type = '':U
     5049             AND locked_dis-card-property.obj-code = 0
     5050             and locked_dis-card-property.dt-code = 0
     5051             and locked_dis-card-property.node-code = 0
     5052             no-error no-wait.
     5053         if not available locked_dis-card-property
     5054         and not locked locked_dis-card-property then do:
     5055           create locked_dis-card-property.
     5056           assign
     5057           locked_dis-card-property.host-code = 0
     5058           locked_dis-card-property.obj-type =  '':U
     5059           locked_dis-card-property.obj-code = 0
     5060           locked_dis-card-property.d-card =  temp-dis-card.d-card
     5061           locked_dis-card-property.dt-code = 0
     5062           locked_dis-card-property.node-code = 0
     5063           .
     5064         end.
     5065         if locked locked_dis-card-property then do:
     5066         Find first locked_dis-card-property exclusive-lock  where
     5067                 locked_dis-card-property.d-card =  temp-dis-card.d-card
     5068             AND locked_dis-card-property.host-code = 0
     5069             AND locked_dis-card-property.obj-type = '':U
     5070             AND locked_dis-card-property.obj-code = 0
     5071             and locked_dis-card-property.dt-code = 0
     5072             and locked_dis-card-property.node-code = 0
     5073             no-error .
     5074         end.
     5075         run trg/lock-dcp.p persistent set v-proc-handle (recid(locked_dis-card-property)) .
     5076         run perproc-create-proc in this-procedure (
     5077                                                    input  this-procedure
     5078                                                   ,input  "trg/lock-dcp.p"
     5079                                                   ,input  v-proc-handle
     5080                                                   ,input  no
     5081                                                   ,input  "":u
     5082                                                   ,input v-cntxt-userid
     5083                                                   ,input 0
     5084                                                   ,output v-id) .
     5085     end.
     5086   end.
     5087   CASE ref-mode:
     5088     WHEN 'ИЗМЕНЕНИЕ':U or
     5089     when 'ПРОСМОТР':U
     5090     THEN DO:
     5091       if not v-update-property then do:
     5092         FOR EACH buf_dis-card-property no-lock where
     5093         buf_dis-card-property.d-card =  temp-dis-card.d-card :
     5094         if buf_dis-card-property.dt-code = 0 then next.
     5095           CREATE tt0-dis-card-property.
     5096           BUFFER-COPY buf_dis-card-property TO tt0-dis-card-property.
     5097         END.
     5098       end.
     5099     END.
     5100     WHEN 'ДОБАВЛЕНИЕ':U THEN DO:
     5101       if not v-update-property then do:
     5102         FOR EACH buf_dis-card-property no-lock where
     5103               buf_dis-card-property.d-card = (if v-is-copy
     5104                                           then ub.dis-card.d-card
     5105                                           else (if v-is-sourced
     5106                                                 then sourced_dis-card.d-card
     5107                                                 else main_dis-card.d-card))
     5108                                                 :
     5109         if buf_dis-card-property.dt-code = 0 then next.
     5110           run discprop-node-code in this-procedure (
     5111                                               input buf_dis-card-property.dtm-code
     5112                                              ,input buf_dis-card-property.dt-code
     5113                                             ,output v-data-type
     5114                                             ,output v-format
     5115                                             ,output v-label
     5116                                             ,output v-range
     5117                                             ,output v-rw-option
     5118                                             ).
     5119           if error-status:error or lookup("C", v-rw-option) = 0  then next.
     5120           assign
     5121           v-found-copy-prop = yes.
     5122           CREATE tt0-dis-card-property.
     5123           BUFFER-COPY buf_dis-card-property EXCEPT d-card TO tt0-dis-card-property.
     5124         end.
     5125       END.
     5126     END.
     5127   END CASE.
     5128   for each tt0-dis-card-property :
     5129     assign
     5130     tt0-dis-card-property.d-card            = temp-dis-card.d-card
     5131     .
     5132   end.
     5133   run ref/discprpi.w (
     5134                   input parparentproc
     5135                 ,input ref-mode
     5136                 ,input temp-dis-card.d-card
     5137                 ,input temp-dis-card.emitent-host-code
     5138                 ,input temp-dis-card.type
     5139                 ,input parhost-code
     5140                 ,input parobj-type
     5141                 ,input parobj-code
     5142                 ,input no
     5143                 ,output v-updated-now
     5144                 ,input-output table tt0-dis-card-property
     5145                   ) no-error.
     5146   if error-status:error then do:
     5147     return no-apply.
     5148   end.
     5149   ASSIGN
     5150   v-update-property = v-update-property OR v-updated-now
     5151   .
     5152   if v-update-property then do:
     5153   end.
     5154   else do:
     5155     for each tt0-dis-card-property:
     5156       delete tt0-dis-card-property.
     5157     end.
     5158   end.
     5159   end.
     5160   end procedure.
     5161   PROCEDURE proc-b-scard :
     5162   define variable loc#log as logical no-undo.
     5163   define variable cli-list as character no-undo.
     5164   define buffer source_dis-card for ub.dis-card.
     5165   run ref/discards.w (
     5166                        input parparentproc
     5167                      ,input  "b-sel"
     5168                      ,input  "client":U
     5169                      ,input parhost-code
     5170                      ,input parobj-type
     5171                      ,input parobj-code
     5172                      ,input '':U
     5173                      ,input recid(ub.clients)
     5174                      ,output cli-list ) .
     5175   if cli-list = "":U then return.
     5176   FIND FIRST source_dis-card no-lock where
     5177                     recid(source_dis-card) = integer(cli-list).
     5178   if NOT
     5179   (    source_dis-card.cli-type = clients.obj-type and source_dis-card.cli-code = clients.obj-code) then do:
     5180       message "Надо выбрать карту того же клиента"
     5181       view-as alert-box error.
     5182       return error.
     5183   end.
     5184   IF not (source_dis-card.emitent-host-code = paremitent-host-code) then do:
     5185       message "Надо выбрать карту того же эмиттента"
     5186       view-as alert-box error.
     5187       return error.
     5188   end.
     5189   DISPLAY
     5190   source_dis-card.d-card @ temp-dis-card.sourced-card
     5191   with frame Dialog-Frame.
     5192   message
     5193   "Скопировать в новую карту параметры старой карты"
     5194   view-as alert-box QUESTION buttons YES-NO
     5195   update loc#log.
     5196   if loc#log then do:
     5197     FIND FIRST ub.dis-card-type No-LOCK WHERE
     5198                         ub.dis-card-type.type = source_dis-card.type AND
     5199                         ub.dis-card-type.emitent-host-code = source_dis-card.emitent-host-code No-ERROR.
     5200       if not available ub.dis-card-tYpe then do:
     5201           message "Не найден тип дисконтной карты для карты" source_dis-card.d-card
     5202           view-as alert-box error.
     5203           return error.
     5204       end.
     5205       assign
     5206       v-pcnt-method = string(source_dis-card.d-pcnt-method)
     5207       .
     5208       display
     5209       dis-card-type.type @ temp-dis-card.type
     5210       source_dis-card.d-pcnt @ temp-dis-card.d-pcnt
     5211       source_dis-card.cash-d-pcnt @ temp-dis-card.cash-d-pcnt
     5212       source_dis-card.category @ temp-dis-card.category
     5213       v-pcnt-method
     5214       with frame Dialog-Frame.
     5215       temp-dis-card.credit-card:screen-value = string(dis-card-type.dflt-credit-card).
     5216       run enable-lim-kr in this-procedure .
     5217       if temp-dis-card.lim-kr:sensitive in frame Dialog-Frame then
     5218       display
     5219       source_dis-card.lim-kr @ temp-dis-card.lim-kr
     5220       with frame Dialog-Frame.
     5221   end.
     5222   END PROCEDURE.
     5223   PROCEDURE proc-b-type :
     5224   define variable v-rid-list as character no-undo.
     5225   define buffer b_clients for ub.clients.
     5226   DEFINE VARIABLE from-card as decimal no-undo.
     5227   DEFINE VARIABLE for-old as decimal no-undo .
     5228   DEFINE VARIABLE for-new as decimal no-undo .
     5229   DEFINE VARIABLE for-sum as decimal no-undo .
     5230   define variable choice as integer.
     5231   define variable v-ok as logical no-undo .
     5232   define variable v-d-pcnt as decimal no-undo .
     5233   define variable v-cash-d-pcnt as decimal no-undo .
     5234   define variable v-categ as integer no-undo .
     5235   define variable old-emitent-name as character no-undo .
     5236   define buffer buf_dis-card-type for ub.dis-card-type.
     5237   define buffer buf_temp-tables for temp-tables.
     5238   main-block:
     5239   do
     5240   on error undo, return error
     5241   :
     5242     if avail temp-dis-card then do:
     5243       FIND FIRST buf_dis-card-type NO-LOCK WHERE
     5244                 buf_dis-card-type.emitent-host-code = temp-dis-card.emitent-host-code AND
     5245                 buf_dis-card-type.host-code = 0 AND
     5246                 buf_dis-card-type.obj-type = "":U AND
     5247                 buf_dis-card-type.obj-code = 0 AND
     5248                 buf_dis-card-type.type = temp-dis-card.type No-ERROR.
     5249       if not avail buf_dis-card-type then do:
     5250       end.
     5251       v-rid-list = string(recid(buf_dis-card-type)).
     5252     end.
     5253     if NOT V-IS-DCT-CLIENT then do:
     5254       run ref/dc-types.w (
     5255                        input parparentproc
     5256                       ,input (if paremitent-host-code = 0 then 'все':U else 'фирма':U)
     5257                       ,input "b-sel":U
     5258                       ,input paremitent-host-code
     5259                       ,input parhost-code
     5260                       ,input parobj-type
     5261                       ,input parobj-code
     5262                       ,input-output v-rid-list) .
     5263       if v-rid-list = ""
     5264       or (available buf_dis-card-type and v-rid-list = string(recid(buf_dis-card-type)))
     5265       then return no-apply.
     5266       find first buf_dis-card-type no-lock where
     5267                 recid(buf_dis-card-type) = integer(v-rid-list) No-ERROR.
     5268       if not avail buf_dis-card-type then return no-apply.
     5269     end.
     5270     old-emitent-name = emitent-name.
     5271     if buf_dis-card-type.emitent-host-code = 0 then do:
     5272       emitent-name = "Глобальная".
     5273     end.
     5274     else do:
     5275       find first b_clients No-LOCK WHERE
     5276                   b_clients.obj-type = 'орг':U and
     5277                   b_clients.obj-code = buf_dis-card-type.emitent-host-code No-ERROR.
     5278       if not avail buf_dis-card-type then return no-apply.
     5279         emitent-name = b_clients.obj-name.
     5280     end.
     5281     display
     5282     buf_dis-card-type.type @ temp-dis-card.type
     5283     buf_dis-card-type.emitent-host-code @ temp-dis-card.emitent-host-code
     5284     emitent-name
     5285     with frame Dialog-Frame
     5286     .
     5287     if ref-mode = 'ДОБАВЛЕНИЕ':U then do:
     5288         assign
     5289         v-pcnt-method = string(buf_dis-card-type.dflt-d-pcnt-method)
     5290         .
     5291   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5292   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5293     (
     5294      input  buf_dis-card-type.type
     5295     ,input  buf_dis-card-type.emitent-host-code
     5296     ,input  0
     5297     ,input  '':U
     5298     ,input  0
     5299     ,input  'def-pcnt':U
     5300     ,output v-d-pcnt
     5301     )  .
     5302         if v-d-pcnt = ? then do:
     5303           v-d-pcnt = 0.
     5304         end.
     5305   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5306   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5307     (
     5308      input  buf_dis-card-type.type
     5309     ,input  buf_dis-card-type.emitent-host-code
     5310     ,input  0
     5311     ,input  '':U
     5312     ,input  0
     5313     ,input  'def-cash-pcnt':U
     5314     ,output v-cash-d-pcnt
     5315     )  .
     5316         if v-cash-d-pcnt = ? then do:
     5317           v-cash-d-pcnt = 0.
     5318         end.
     5319   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5320   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5321     (
     5322      input  buf_dis-card-type.type
     5323     ,input  buf_dis-card-type.emitent-host-code
     5324     ,input  0
     5325     ,input  '':U
     5326     ,input  0
     5327     ,input  'def-categ':U
     5328     ,output v-categ
     5329     )  .
     5330         if v-categ = ? then do:
     5331           v-categ = 0.
     5332         end.
     5333         display
     5334         v-d-pcnt @ temp-dis-card.d-pcnt
     5335         v-cash-d-pcnt @ temp-dis-card.cash-d-pcnt
     5336         v-categ @ temp-dis-card.category
     5337         v-pcnt-method
     5338         with frame Dialog-Frame.
     5339         ASSIGN
     5340         temp-dis-card.credit-card:screen-value = string(buf_dis-card-type.dflt-credit-card)
     5341         temp-dis-card.debet-card:SCREEN-VALUE  = string(buf_dis-card-type.dflt-debet-card)
     5342         temp-dis-card.staff-card:SCREEN-VALUE  = string(buf_dis-card-type.dflt-staff-card)
     5343         .
     5344         run enable-lim-kr in this-procedure .
     5345         if temp-dis-card.lim-kr:sensitive in frame Dialog-Frame then
     5346         display
     5347         buf_dis-card-type.lim-kr @ temp-dis-card.lim-kr
     5348         with frame Dialog-Frame.
     5349     end.
     5350     if ref-mode = 'ИЗМЕНЕНИЕ':U then do:
     5351       assign
     5352       temp-dis-card.type = v-initial-type
     5353       temp-dis-card.emitent-host-code = v-initial-emitent-host-code
     5354       .
     5355       run str/saledc.p
     5356         (
     5357          input parparentproc
     5358         ,input this-procedure :handle
     5359         ,input ?
     5360         ,input 'one-card-check':U
     5361         ,input buf_dis-card-type.emitent-host-code
     5362         ,input buf_dis-card-type.type
     5363         ,input 0
     5364         ,input 0
     5365         ,input 0
     5366         ,input g#db-num
     5367         ,input temp-dis-card.d-card
     5368         ,input ?
     5369         ,input ?
     5370         ,input ?
     5371         ,input 1
     5372         ,input 1
     5373         ,input no
     5374         ) no-error .
     5375       if error-status:error then do:
     5376         display
     5377         temp-dis-card.type
     5378         temp-dis-card.emitent-host-code
     5379         emitent-name
     5380         with frame Dialog-Frame
     5381         .
     5382         undo main-block, return error return-value .
     5383       end.
     5384       find first buf_temp-tables where buf_temp-tables.tbl-name = 'dis-card':U no-error.
     5385       if available buf_temp-tables then do:
     5386         run ref/view-chg.w ( input parparentproc
     5387                       ,input this-procedure:handle
     5388                       ,input 'dis-card':U
     5389                       ,input buffer temp-dis-card:handle
     5390                       ,input buf_temp-tables.new-tbl-handle
     5391                       ,input 'ИЗМЕНЕНИЕ':U + chr(44) + "available"
     5392                       ,input 0
     5393                       ,input substitute("Изменения в реквизитах карты, вызванные изменением типа карты &1"
     5394                                         , temp-dis-card.d-card)
     5395                       ,input "Текущие реквизиты карты"
     5396                       ,input "Согласно новому типу карты должно быть"
     5397                       ,input '':U
     5398                       ,input substitute("Вы можете подтвердить или отвергнуть изменения,&1" +
     5399                                         "однако после следующей операции пересчета&1" +
     5400                                         "реквизиты карты будут изменены в соответствии с правилами,&1" +
     5401                                         "установленными для ее текущего типа, если только карта не будет находится в статусе &2"
     5402                                         , chr(10)
     5403                                         , 'блок':U
     5404                                         )
     5405                       ,output v-ok
     5406                       ) no-error .
     5407         if error-status:error then do:
     5408           display
     5409           temp-dis-card.type
     5410           temp-dis-card.emitent-host-code
     5411           emitent-name
     5412           with frame Dialog-Frame
     5413           .
     5414           message
     5415           vss-workfile vss-revision vss-description skip
     5416           error-status:get-message(1) skip
     5417           return-value
     5418           view-as alert-box error.
     5419           undo, return error .
     5420         end.
     5421         if v-ok then do:
     5422           for each temp-labels where temp-labels.f_update :
     5423             if temp-labels.f_update then
     5424             assign
     5425             buffer temp-dis-card:handle:buffer-field(temp-labels.f_name):buffer-value = buf_temp-tables.new-tbl-handle:buffer-field(temp-labels.f_name):buffer-value
     5426             .
     5427           end.
     5428           DISPLAY
     5429           temp-dis-card.d-pcnt
     5430           temp-dis-card.cash-d-pcnt
     5431           temp-dis-card.category
     5432           temp-dis-card.issue-date
     5433           temp-dis-card.issue-code
     5434           temp-dis-card.lim-kr
     5435           (IF temp-dis-card.cli-message = ? THEN "":U ELSE temp-dis-card.cli-message) temp-dis-card.cli-message
     5436           temp-dis-card.valid-date
     5437           temp-dis-card.valid-from
     5438           WITH FRAME Dialog-Frame.
     5439         end.
     5440       end.
     5441       for each buf_temp-tables:
     5442         if valid-handle(buf_temp-tables.new-table-handle) then do:
     5443           delete object buf_temp-tables.new-table-handle.
     5444         end.
     5445         delete buf_temp-tables.
     5446       end.
     5447     end.
     5448     assign
     5449     temp-dis-card.type = buf_dis-card-type.type
     5450     temp-dis-card.emitent-host-code = buf_dis-card-type.emitent-host-code
     5451     .
     5452     if buf_dis-card-type.type = '@client':U then do:
     5453       disable
     5454       t-overissue when t-overissue:sensitive
     5455       temp-dis-card.d-card
     5456       with frame Dialog-Frame.
     5457       DISPLAY
     5458       ('K':U + string(if temp-DIs-card.cli-type = 'орг':U then 1 else 0) + string(temp-dis-card.cli-code, '999999999')) @ TEMP-DIS-CARD.D-CARD
     5459       with frame Dialog-Frame.
     5460     end.
     5461     ELSE DO:
     5462       if input temp-dis-card.d-card = ('K':U + string(if temp-DIs-card.cli-type = 'орг':U then 1 else 0) + string(temp-dis-card.cli-code, '999999999')) then do:
     5463         temp-dis-card.d-card:screen-value = ''.
     5464       end.
     5465     END.
     5466   end.
     5467   END PROCEDURE.
     5468   PROCEDURE proc-save :
     5469   define variable choice as integer no-undo .
     5470   define variable glog as logical no-undo .
     5471   define variable v-can-issue as logical no-undo .
     5472   define variable v-data-type as character no-undo .
     5473   define variable v-format as character no-undo .
     5474   define variable v-label as character no-undo .
     5475   define variable v-range as integer no-undo .
     5476   define variable v-rw-option as character no-undo .
     5477   define buffer source_dis-card for ub.dis-card.
     5478   define buffer buf_dis-card-property for ub.dis-card-property.
     5479   define buffer buf_attr-prop for ub.attr-prop.
     5480   assign
     5481   frame Dialog-Frame
     5482   temp-dis-card.type
     5483   temp-dis-card.d-card
     5484   .
     5485   if ref-mode = 'ДОБАВЛЕНИЕ':U
     5486   and not v-update-property then do:
     5487     FOR EACH buf_dis-card-property no-lock where
     5488           buf_dis-card-property.d-card = (if v-is-copy
     5489                                       then ub.dis-card.d-card
     5490                                       else (if v-is-sourced
     5491                                             then sourced_dis-card.d-card
     5492                                             else main_dis-card.d-card)):
     5493       if buf_dis-card-property.dtm-code = 0 then next.
     5494       if discprop-usercanedit( input buf_dis-card-property.dtm-code, input g#db-num) = no then next.
     5495       run discprop-node-code in this-procedure (
     5496                                           input buf_dis-card-property.dtm-code
     5497                                           ,input buf_dis-card-property.dt-code
     5498                                         ,output v-data-type
     5499                                         ,output v-format
     5500                                         ,output v-label
     5501                                         ,output v-range
     5502                                         ,output v-rw-option
     5503                                         ).
     5504       if error-status:error or lookup("C", v-rw-option) = 0  then next.
     5505       assign
     5506       v-found-copy-prop = yes.
     5507       CREATE tt0-dis-card-property.
     5508       BUFFER-COPY buf_dis-card-property to tt0-dis-card-property
     5509       assign
     5510       tt0-dis-card-property.d-card = d-card
     5511       tt0-dis-card-property.main-card = temp-dis-card.main-card
     5512       tt0-dis-card-property.first-card = temp-dis-card.first-card
     5513       tt0-dis-card-property.first-main-card = temp-dis-card.first-main-card
     5514       tt0-dis-card-property.card-num = temp-dis-card.card-num
     5515       .
     5516     end.
     5517   END.
     5518   if (v-is-sourced or v-is-copy or v-is-subsid) and v-found-copy-prop then v-update-property = yes.
     5519   if v-update-property then do:
     5520     run gbl/d-askw.w (
     5521                       input "Сохранение изменений"
     5522                       ,input  "Были изменены свойств ДК" + (if v-found-copy-prop then " или наследуются свойства ДК" else "":U)
     5523                       ,input "|"
     5524                       ,input "Сохранить ВСЕ|Кроме свойств|Отмена"
     5525                       ,input "Сохранить изменения ДК и изменения свойств ДК|Сохранить изменения ДК|Ничего не сохранять"
     5526                       ,input 1
     5527                       ,input 3
     5528                       ,output choice).
     5529     if choice = 2 then v-update-property = no.
     5530     if choice = 3 then return.
     5531   end.
     5532   IF ref-mode = 'ПРОСМОТР':U THEN RETURN .
     5533   find first temp-dis-card  no-error.
     5534   if not avail temp-dis-card then do:
     5535     create temp-dis-card.
     5536     assign
     5537     frame Dialog-Frame v-pcnt-method
     5538     temp-dis-card.cli-type = ub.clients.obj-type
     5539     temp-dis-card.cli-code = ub.clients.obj-code
     5540     temp-dis-card.d-card
     5541     temp-dis-card.emitent-host-code
     5542     temp-dis-card.status_ = 'тек':U
     5543     temp-dis-card.d-pcnt-method = integer(v-pcnt-method)
     5544     .
     5545   end.
     5546   assign
     5547   temp-dis-card.type
     5548   temp-dis-card.d-card
     5549   temp-dis-card.emitent-host-code
     5550   temp-dis-card.d-pcnt
     5551   temp-dis-card.cash-d-pcnt
     5552   temp-dis-card.category
     5553   temp-dis-card.credit-card
     5554   temp-dis-card.lim-kr
     5555   temp-dis-card.debet-card
     5556   temp-dis-card.staff-card
     5557   temp-dis-card.cli-message
     5558   temp-dis-card.issue-date
     5559   temp-dis-card.issue-code
     5560   temp-dis-card.valid-from
     5561   temp-dis-card.valid-date
     5562   v-pcnt-method
     5563   temp-dis-card.d-pcnt-method = integer(v-pcnt-method)
     5564   t-overissue
     5565   .
     5566   if temp-dis-card.type = '':U then do:
     5567     message
     5568     "Не выбран тип ДК"
     5569     view-as alert-box error .
     5570     undo, return error '':U.
     5571   end.
     5572   if ref-mode = 'ДОБАВЛЕНИЕ':U and t-overissue then
     5573   assign
     5574   temp-dis-card.sourced-card
     5575   .
     5576   if ref-mode = 'ДОБАВЛЕНИЕ':U and temp-dis-card.sourced-card <> "":U then do:
     5577     find first source_dis-card no-lock where
     5578               source_dis-card.d-card = temp-dis-card.sourced-card no-error .
     5579     if available source_dis-card then do:
     5580       if source_dis-card.type <> temp-dis-card.type then do:
     5581         message
     5582         substitute("У перевыпускаемой карты &1 - тип &2, а у карты &3, к которой перевыпускается карта &1 - тип &4&5" +
     5583                   "Вы уверены, что хотите перевыпустить карту с другим типом?"
     5584                   , temp-dis-card.d-card
     5585                   , temp-dis-card.type
     5586                   , source_Dis-card.d-card
     5587                   , source_dis-card.type
     5588                   ,chr(10)
     5589                   )
     5590         view-as alert-box question buttons yes-no update glog.
     5591         if not glog then undo, return error .
     5592       end.
     5593       if source_dis-card.status_ = 'удал':U then do:
     5594         message
     5595         substitute("Карта &2, к которой перевыпускается карта &1 - имеет статус &3&4" +
     5596                   "Вы уверены, что хотите перевыпустить карту к удаленной карте?"
     5597                   , temp-dis-card.d-card
     5598                   , source_Dis-card.d-card
     5599                   , source_Dis-card.status_
     5600                   ,chr(10)
     5601                   )
     5602         view-as alert-box question buttons yes-no update glog.
     5603         if not glog then undo, return error .
     5604       end.
     5605     end.
     5606   end.
     5607   if ref-mode = 'ДОБАВЛЕНИЕ':U
     5608   then do:
     5609      run ref/dcardi04.p (
     5610                     input temp-dis-card.d-card
     5611                    ,input temp-dis-card.type
     5612                    ,input temp-dis-card.emitent-host-code
     5613                    ,input temp-dis-card.issue-code
     5614                    ,output v-can-issue) no-error .
     5615      if error-status:error
     5616      or not v-can-issue  then do:
     5617       message
     5618       error-status:get-message(1) skip
     5619       return-value
     5620       view-as alert-box error .
     5621       undo, return error .
     5622      end.
     5623   end.
     5624   for each tt0-dis-card-property :
     5625     assign
     5626     tt0-dis-card-property.d-card            = temp-dis-card.d-card
     5627     .
     5628   end.
     5629   DO ON ERROR UNDO, RETURN ERROR:
     5630     run ref/dcardi01.p (
     5631                      input parparentproc
     5632                     ,input this-procedure
     5633                     ,input ?
     5634                     ,input ?
     5635                     ,input no
     5636                     ,input-output dc-ri
     5637                     ,input ref-mode
     5638                     ,input '':U
     5639                     ,input parobj-type
     5640                     ,input parobj-code
     5641                     ,input temp-dis-card.d-card
     5642                     ,input temp-dis-card.emitent-host-code
     5643                     ,input temp-dis-card.cli-type
     5644                     ,input temp-dis-card.cli-code
     5645                     ,input (if ref-mode = 'ДОБАВЛЕНИЕ':U then 'тек':U else temp-dis-card.status_)
     5646                     ,input temp-dis-card.type
     5647                     ,input temp-dis-card.d-pcnt
     5648                     ,input temp-dis-card.cash-d-pcnt
     5649                     ,input temp-dis-card.category
     5650                     ,input temp-dis-card.d-pcnt-method
     5651                     ,input temp-dis-card.credit-card
     5652                     ,input temp-dis-card.lim-kr
     5653                     ,input temp-dis-card.debet-card
     5654                     ,input temp-dis-card.staff-card
     5655                     ,input temp-dis-card.issue-date
     5656                     ,input temp-dis-card.issue-code
     5657                     ,input temp-dis-card.valid-from
     5658                     ,input temp-dis-card.valid-date
     5659                     ,input temp-dis-card.sourced-card
     5660                     ,input temp-dis-card.cli-message
     5661                     ,input temp-dis-card.mask-card
     5662                     ,input (if v-is-subsid
     5663                             or ref-mode = 'ИЗМЕНЕНИЕ':U
     5664                             then temp-dis-card.main-card
     5665                             else temp-dis-card.d-card)
     5666                     ,input temp-dis-card.is-subsid
     5667                     ,INPUT v-update-property
     5668                     ,INPUT table tt0-dis-card-property
     5669                     ) no-error.
     5670   if error-status:error then do:
     5671   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5672   define variable fh as widget-handle no-undo .
     5673   define variable hh as widget-handle no-undo .
     5674   define variable rv as character no-undo .
     5675   assign
     5676   rv = entry(1, return-value , chr(4)).
     5677   if rv <> "":U then do:
     5678     assign
     5679     fh = frame Dialog-Frame:first-child
     5680     hh = fh:first-child
     5681     .
     5682     do while valid-handle(hh):
     5683       if hh:name = rv then do:
     5684         APPLY "ENTRY" to hh.
     5685         undo ,
     5686         return error.
     5687       end.
     5688       hh = hh:next-sibling.
     5689     end.
     5690   end.
     5691     undo, return error.
     5692   end.
     5693   END.
     5694   END PROCEDURE.
