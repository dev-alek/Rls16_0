     2282     define variable v-num-entries     as integer   no-undo .
     2283     define variable fh                as handle    no-undo .
     2284     define variable fh-main           as handle    no-undo .
     2285     define variable fh-old            as handle    no-undo .
     2286     define variable fh-new            as handle    no-undo .
     2287     define variable v-field-name      as character no-undo .
     2288     define variable v-field-lvl       as character no-undo .
     2289     define variable v-field-form      as character no-undo .
     2290     define variable v-search-exp      as character no-undo .
     2291     define variable v-srch-main       as character no-undo .
     2292     define variable v-word-link       as character no-undo .
     2293     define variable v-av-chip-num     as logical   no-undo .
     2294     define variable v-main-pi-fld-lst as character no-undo .
     2295     define variable v-main-fld-lst    as character no-undo .
     2296     define variable v-delim-list      as character no-undo .
     2297     define variable v-label           as character no-undo .
     2298     define variable v-old-value       as character no-undo case-sensitive.
     2299     define variable v-new-value       as character no-undo case-sensitive.
     2300     define variable v-chg-fields as character no-undo.
     2301     for each temp-changes:
     2302       delete temp-changes.
     2303     end.
     2304     if not p-hst-handle:available then do:
     2305       return .
     2306     end.
     2307     create buffer h-new-buf  for table p-hst-handle .
     2308     create buffer h-main-buf for table p-main-table .
     2309     assign
     2310       v-inform = h-main-buf:index-information(1)
     2311       v-ind    = 2
     2312     .
     2313     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2314     on error undo, return error
     2315     :
     2316       assign
     2317         v-inform = h-main-buf:index-information( v-ind )
     2318         v-ind    = v-ind + 1
     2319       .
     2320     end.
     2321     if v-inform = ?
     2322       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2323       or entry( 3, v-inform, ",":U ) <> "1":U
     2324     then do:
     2325       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     2326     end.
     2327     assign
     2328       v-idx-field-qnty = num-entries( v-inform ) - 4
     2329     .
     2330     if v-idx-field-qnty < 2 then do:
     2331       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     2332     end.
     2333     assign
     2334       v-srch-main   = "where":U
     2335       v-word-link   = "":U
     2336       v-av-chip-num = false
     2337       v-delim-list  = "":U
     2338     .
     2339     do v-ind = 1 to v-idx-field-qnty by 2
     2340     on error undo, return error
     2341     :
     2342       assign
     2343         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     2344         fh                = p-hst-handle:buffer-field( v-field-name )
     2345         fh-main           = h-main-buf:buffer-field( v-field-name )
     2346         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     2347         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     2348       .
     2349       if fh:data-type ="character":U then do:
     2350         assign
     2351           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2352         .
     2353       end.
     2354       else do:
     2355         assign
     2356           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     2357         .
     2358       end.
     2359       if v-delim-list = "":U then do:
     2360         assign
     2361           v-delim-list = ",":U
     2362         .
     2363       end.
     2364       if v-word-link = "":U then do:
     2365         assign
     2366           v-word-link = "and":U
     2367         .
     2368       end.
     2369     end.
     2370     assign
     2371       v-delim-list  = "":U
     2372     .
     2373     do v-ind = 1 to h-main-buf:num-fields
     2374     on error undo, return error
     2375     :
     2376       assign
     2377         fh-main      = h-main-buf:buffer-field( v-ind )
     2378         v-field-name = fh-main:name
     2379       .
     2380         assign
     2381           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     2382         .
     2383         if v-delim-list = "":U then do:
     2384           assign
     2385             v-delim-list = ",":U
     2386           .
     2387         end.
     2388     end.
     2389     assign
     2390       v-inform = p-hst-handle:index-information(1)
     2391       v-ind    = 2
     2392     .
     2393     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2394     on error undo, return error
     2395     :
     2396       assign
     2397         v-inform = p-hst-handle:index-information( v-ind )
     2398         v-ind    = v-ind + 1
     2399       .
     2400     end.
     2401     if v-inform = ?
     2402       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2403       or entry( 3, v-inform, ",":U ) <> "1":U
     2404     then do:
     2405       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     2406     end.
     2407     assign
     2408       v-idx-field-qnty = num-entries( v-inform ) - 4
     2409     .
     2410     if v-idx-field-qnty < 2 then do:
     2411       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     2412     end.
     2413     assign
     2414       v-search-exp  = "where":U
     2415       v-word-link   = "":U
     2416       v-av-chip-num = false
     2417     .
     2418     do v-ind = 1 to v-idx-field-qnty by 2
     2419     on error undo, return error
     2420     :
     2421       assign
     2422         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2423         fh           = p-hst-handle:buffer-field( v-field-name )
     2424         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     2425       .
     2426       if v-field-name = "chip-num":U then do:
     2427         assign
     2428           v-search-exp  = substitute( "&1 >", v-search-exp )
     2429           v-av-chip-num = true
     2430         .
     2431       end.
     2432       else do:
     2433         assign
     2434           v-search-exp = substitute( "&1 =", v-search-exp )
     2435         .
     2436       end.
     2437       if fh:data-type ="character":U then do:
     2438         assign
     2439           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2440         .
     2441       end.
     2442       else do:
     2443         assign
     2444           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     2445         .
     2446       end.
     2447       if v-word-link = "":U then do:
     2448         assign
     2449           v-word-link = "and":U
     2450         .
     2451       end.
     2452     end.
     2453     if v-av-chip-num = false then do:
     2454       message
     2455         vss-workfile vss-revision vss-description skip
     2456         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     2457         "Использование данной процедуры невозможно!" skip
     2458         view-as alert-box error .
     2459       return error .
     2460     end.
     2461     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     2462     if not h-new-buf:available then do:
     2463       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     2464       if not h-main-buf:available then do:
     2465         assign
     2466           h-for-comp = ?
     2467         .
     2468       end.
     2469       else do:
     2470         assign
     2471           h-for-comp = h-main-buf
     2472         .
     2473       end.
     2474     end.
     2475     else do:
     2476       assign
     2477         h-for-comp = h-new-buf
     2478       .
     2479     end.
     2480     assign
     2481       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     2482     .
     2483     do v-ind = 1 to v-num-entries
     2484     on error undo, return error return-value
     2485     :
     2486       assign
     2487         v-field-name = entry( v-ind, v-main-fld-lst )
     2488         fh-old       = p-hst-handle:buffer-field( v-field-name )
     2489         v-old-value  = fh-old:buffer-value()
     2490         v-label      = trim( fh-old:label )
     2491       .
     2492       if ( trim( p-field-list ) <> "":U
     2493            and lookup( v-field-name, p-field-list ) > 0
     2494          )
     2495          or trim( p-field-list ) = "":U
     2496       then do:
     2497         if h-for-comp <> ? then do:
     2498           assign
     2499             fh-new      = h-for-comp:buffer-field( v-field-name )
     2500             v-new-value = fh-new:buffer-value()
     2501           .
     2502         end.
     2503         else do:
     2504           assign
     2505             v-new-value = "":U
     2506           .
     2507         end.
     2508         if v-old-value <> v-new-value
     2509         then do:
     2510           create temp-changes.
     2511           assign
     2512             temp-changes.t_name = p-main-table
     2513             temp-changes.f_name = v-field-name
     2514             temp-changes.l_name = replace( v-label, "&":U, "":U )
     2515             temp-changes.v_old  = trim( v-old-value )
     2516             temp-changes.v_new  = trim( v-new-value )
     2517             temp-changes.num_   = 0
     2518             temp-changes.fNotChange = v-old-value eq v-new-value
     2519           .
     2520         end.
     2521       end.
     2522     end.
     2523     assign
     2524       v-num-entries = num-entries( p-label-form, chr(8) )
     2525     .
     2526     do v-ind = 1 to v-num-entries
     2527     on error undo, return error return-value
     2528     :
     2529       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     2530         assign
     2531           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2532           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2533           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2534         .
     2535         find first temp-changes
     2536           where temp-changes.f_name = v-field-name
     2537           no-error .
     2538         if available temp-changes then do:
     2539           if trim( v-field-lvl ) <> "":U then do:
     2540             assign
     2541               temp-changes.l_name = v-field-lvl
     2542             .
     2543           end.
     2544           if trim( v-field-form ) <> "":U then do:
     2545             assign
     2546               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     2547             .
     2548             if h-for-comp <> ? then do:
     2549               assign
     2550                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     2551               .
     2552             end.
     2553           end.
     2554         end.
     2555       end.
     2556       else do:
     2557         message
     2558           vss-workfile vss-revision vss-description skip
     2559           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     2560           substitute( "список для поля '&1': '&2'"
     2561                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2562                       ,entry( v-ind, p-label-form, chr(8) )
     2563                     ) skip
     2564           substitute( "полный список: &2", p-label-form ) skip
     2565           view-as alert-box error .
     2566       end.
     2567     end.
     2568     delete object h-new-buf .
     2569     delete object h-main-buf .
     2570   END PROCEDURE.
     2571   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2572   define variable tempcont_v-num_ as integer no-undo .
     2573   define  temp-table temp-tables no-undo
     2574   field tbl-name as character
     2575   field new-tbl-handle as handle
     2576   field new-table-handle as handle
     2577   index pi is unique primary
     2578   tbl-name.
     2579   define  temp-table temp-records no-undo
     2580   field tbl-name as character
     2581   field uniq-key-rec as character
     2582   index pi is unique primary
     2583   tbl-name
     2584   uniq-key-rec
     2585   .
     2586   procedure tempcont_create-changes :
     2587   define input  parameter p-tbl-name   as character no-undo.
     2588   define input  parameter p-tbl-handle as handle    no-undo.
     2589   define input  parameter p-ttbl-handle as handle    no-undo.
     2590   define input  parameter p-action as integer no-undo .
     2591   define variable v-chg-fields as character no-undo .
     2592   define variable v-ii as integer no-undo .
     2593   define variable fh-main as handle no-undo .
     2594   define variable fh-temp as handle no-undo .
     2595   define variable fh as handle no-undo .
     2596   define variable th as handle no-undo .
     2597   define variable v-main-value as character no-undo .
     2598   define variable v-temp-value as character no-undo .
     2599   define variable v-uniq-key-rec as character no-undo .
     2600   define variable v-ind as integer no-undo .
     2601   define variable v-keys as character no-undo .
     2602   if p-tbl-handle:available then do:
     2603     if p-tbl-handle:buffer-compare( p-ttbl-handle) = yes then return.
     2604   end.
     2605   do v-ii = 1 to min(p-tbl-handle:num-fields, p-ttbl-handle:num-fields):
     2606     assign
     2607     fh-main      = p-tbl-handle:buffer-field( v-ii )
     2608     fh-temp      = p-ttbl-handle:buffer-field( v-ii )
     2609     .
     2610     if fh-main:name = fh-temp:name
     2611     and fh-main:data-type = fh-temp:data-type then do:
     2612       if fh-main:buffer-value ne fh-temp:buffer-value then do:
     2613         if p-action = integer('1':U) then do:
     2614           assign
     2615           fh = fh-temp
     2616           th = p-ttbl-handle
     2617           v-main-value = fh-main:initial
     2618           v-keys  = p-ttbl-handle:keys
     2619           .
     2620         end.
     2621         else do:
     2622           assign
     2623           fh = fh-main
     2624           th = p-tbl-handle
     2625           v-main-value = fh-main:string-value
     2626           v-keys  = p-tbl-handle:keys
     2627           .
     2628         end.
     2629         assign
     2630         v-temp-value = fh-temp:string-value
     2631        .
     2632        if v-uniq-key-rec = '':U then do:
     2633           v-uniq-key-rec = p-tbl-name.
     2634           do v-ind = 1 to num-entries(v-keys)
     2635           on error undo, return error
     2636           :
     2637             assign
     2638             fh = th:buffer-field(entry(v-ind, v-keys))
     2639             v-uniq-key-rec = v-uniq-key-rec + chr(3) + substitute("&1", fh:buffer-value())
     2640             .
     2641           end.
     2642         end.
     2643         create temp-changes.
     2644         assign
     2645         temp-changes.t_name = p-tbl-name
     2646         temp-changes.f_name = fh-main:name
     2647         temp-changes.l_name = '':U
     2648         temp-changes.v_old  = v-main-value
     2649         temp-changes.v_new  = v-temp-value
     2650         temp-changes.action = p-action
     2651         temp-changes.uniq-key-rec = v-uniq-key-rec
     2652         temp-changes.num_   = tempcont_v-num_ + 1
     2653         tempcont_v-num_     = tempcont_v-num_ + 1
     2654         .
     2655       end.
     2656     end.
     2657   end.
     2658   end procedure.
     2659   procedure tempcont_create-record :
     2660   define input  parameter p-tbl-name   as character no-undo.
     2661   define input  parameter p-new-tbl-handle as handle    no-undo.
     2662   define input  parameter p-action as integer no-undo .
     2663   do
     2664   on error  undo, return error substitute( "&1 (tempcont_create-record). &2&3&4", vss-include-info14, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2665   on stop   undo, return error substitute( "&1 (tempcont_create-record). stop", vss-include-info14 )
     2666   on endkey undo, return error substitute( "&1 (tempcont_create-record). endkey", vss-include-info14 )
     2667   :
     2668     define variable tt-name          as character no-undo .
     2669     define variable tth              as handle    no-undo .
     2670     define variable bh_tt            as handle    no-undo .
     2671     define variable v-ok             as logical   no-undo .
     2672     define variable v-full-tbl-name  as character no-undo .
     2673     define variable v-inform         as character no-undo .
     2674     define variable v-ind            as integer   no-undo .
     2675     define variable v-idx-field-qnty as integer   no-undo .
     2676     define variable v-where          as character no-undo .
     2677     define variable v-word-link      as character no-undo .
     2678     define variable v-field-name     as character no-undo .
     2679     define variable fh_tbl-name      as handle    no-undo .
     2680     define variable fh_tt            as handle    no-undo .
     2681     define variable v-field-val      as character no-undo .
     2682     define variable compare-log      as logical no-undo .
     2683     define buffer buf_temp-tables  for temp-tables.
     2684     if not p-new-tbl-handle:available then do:
     2685       return error substitute( "&1. Переданный буфер таблицы &2 не доступен", vss-include-info14, p-tbl-name ).
     2686     end.
     2687     assign
     2688       v-full-tbl-name = substitute( "ub.&1":U, p-tbl-name )
     2689     .
     2690     find first buf_temp-tables where
     2691               buf_temp-tables.tbl-name = p-tbl-name no-error .
     2692     if not available buf_temp-tables then do:
     2693       create temp-table tth.
     2694       assign
     2695         tt-name = "wt-" + p-tbl-name
     2696         tth:undo = no
     2697       .
     2698       v-ok = yes.
     2699       assign
     2700         v-ok = tth:create-like( v-full-tbl-name ) no-error
     2701       .
     2702       if v-ok <> true then do:
     2703         return error substitute( "&1 (tempcont_create-record). Ошибка при создании временной таблицы &2 (1)", vss-include-info14, tt-name ) .
     2704       end.
     2705       assign
     2706         v-ok = tth:temp-table-prepare( tt-name ) no-error
     2707       .
     2708       if v-ok <> true then do:
     2709         return error substitute( "&1 (tempcont_create-record). Ошибка при создании временной таблицы &2 (2)", vss-include-info14, tt-name ) .
     2710       end.
     2711       create buf_temp-tables.
     2712       assign
     2713       buf_temp-tables.tbl-name = p-tbl-name
     2714       buf_temp-tables.new-tbl-handle = tth:default-buffer-handle
     2715       buf_temp-tables.new-table-handle = tth
     2716       .
     2717       assign
     2718       bh_tt = buf_temp-tables.new-tbl-handle
     2719       .
     2720     end.
     2721     else do:
     2722       if p-new-tbl-handle:table-handle = buf_temp-tables.new-tbl-handle:table-handle then do:
     2723         assign
     2724         bh_tt = p-new-tbl-handle
     2725         .
     2726       end.
     2727       else do:
     2728         assign
     2729         bh_tt = buf_temp-tables.new-tbl-handle
     2730         .
     2731       end.
     2732     end.
     2733     assign
     2734     v-inform = bh_tt:index-information(1)
     2735     v-ind    = 2
     2736     .
     2737     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2738     on error undo, return error
     2739     :
     2740       assign
     2741         v-inform = bh_tt:index-information( v-ind )
     2742         v-ind    = v-ind + 1
     2743       .
     2744     end.
     2745     if v-inform = ?
     2746       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2747       or entry( 3, v-inform, ",":U ) <> "1":U
     2748     then do:
     2749       return error substitute( "&1 (tempcont_create-record). Таблица &2 не имеет первичного ключа в БД", vss-include-info14, p-tbl-name ).
     2750     end.
     2751     assign
     2752       v-idx-field-qnty = num-entries( v-inform ) - 4
     2753     .
     2754     if v-idx-field-qnty < 2 then do:
     2755       return error substitute( "&1 (tempcont_create-record). Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, p-tbl-name ).
     2756     end.
     2757     assign
     2758       v-where     = "where":U
     2759       v-word-link = "":U
     2760     .
     2761     block_where:
     2762     do v-ind = 1 to v-idx-field-qnty by 2
     2763     on error undo, return error
     2764     :
     2765       assign
     2766         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2767         fh_tbl-name  = bh_tt:buffer-field( v-field-name )
     2768         fh_tt        = p-new-tbl-handle:buffer-field( v-field-name )
     2769         v-field-val  = fh_tt:buffer-value
     2770         v-where      = substitute( "&1 &2 &3.&4 =", v-where, v-word-link, fh_tbl-name:table, v-field-name )
     2771       .
     2772       if fh_tbl-name:data-type ="character":U then do:
     2773           assign
     2774           v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2775           v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2776           v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2777           v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2778           v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2779           v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2780           v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2781           v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2782           v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2783           v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2784           v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2785           v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2786           v-field-val = substitute( '"&1"', v-field-val )
     2787           .
     2788       end.
     2789       assign
     2790         v-where = substitute( "&1 &2", v-where, v-field-val )
     2791       .
     2792       if v-word-link = "":U then do:
     2793         assign
     2794           v-word-link = "and":U
     2795         .
     2796       end.
     2797     end.
     2798     bh_tt:find-first( v-where, exclusive-lock ) no-error .
     2799     if not bh_tt:available then do:
     2800       assign
     2801         v-ok = false
     2802       .
     2803       assign
     2804         v-ok = bh_tt:buffer-create no-error
     2805       .
     2806       if v-ok <> true then do:
     2807         return error substitute( "&1 (tempcont_create-record). Ошибка при создании буфера временной таблицы.", vss-include-info14, p-tbl-name ).
     2808       end.
     2809       assign
     2810         compare-log = false
     2811       .
     2812     end.
     2813     else do:
     2814       assign
     2815         compare-log = bh_tt:buffer-compare( p-new-tbl-handle )
     2816       .
     2817     end.
     2818     if compare-log = false then do:
     2819       assign
     2820         v-ok = false
     2821       .
     2822       assign
     2823         v-ok = bh_tt:buffer-copy( p-new-tbl-handle ) no-error
     2824       .
     2825       if v-ok <> true then do:
     2826         return error substitute( "&1 (tempcont_create-record). BUFFER-COPY не прошел для таблицы &2", vss-include-info14, p-tbl-name ).
     2827       end.
     2828     end.
     2829     assign
     2830       v-ok = false
     2831     .
     2832     assign
     2833       v-ok = bh_tt:buffer-release() no-error
     2834     .
     2835     if v-ok <> true then do:
     2836       return error substitute( "&1 (tempcont_create-record). buffer-release не прошел для таблицы &2", vss-include-info14, p-tbl-name ).
     2837     end.
     2838     assign
     2839       v-ok = false
     2840     .
     2841     assign
     2842       fh_tbl-name  = ?
     2843       fh_tt        = ?
     2844       bh_tt        = ?
     2845     .
     2846   end.
     2847   end procedure.
     2848   procedure tempcont_get-buffer-handle :
     2849   define input parameter p-tbl-name as character no-undo .
     2850   define output parameter p-new-tbl-handle as handle no-undo .
     2851   do
     2852   on error undo, return error
     2853   :
     2854     define variable tth              as handle    no-undo .
     2855     define variable tt-name          as character no-undo .
     2856     define variable v-ok             as logical   no-undo .
     2857     define variable v-full-tbl-name  as character no-undo .
     2858     define buffer buf_temp-tables  for temp-tables.
     2859     find first buf_temp-tables where
     2860              buf_temp-tables.tbl-name = p-tbl-name no-error .
     2861     if not available buf_temp-tables then do:
     2862       create temp-table tth.
     2863       assign
     2864       tt-name = "wt-" + p-tbl-name
     2865       tth:undo = no
     2866       v-full-tbl-name = substitute( "ub.&1":U, p-tbl-name )
     2867       .
     2868       v-ok = yes.
     2869       assign
     2870       v-ok = tth:create-like( v-full-tbl-name ) no-error
     2871       .
     2872       if v-ok <> true then do:
     2873         return error substitute( "&1 (tempcont_get-buffer-handle). Ошибка при создании временной таблицы &2 (1)", vss-include-info14, tt-name ) .
     2874       end.
     2875       assign
     2876         v-ok = tth:temp-table-prepare( tt-name ) no-error
     2877       .
     2878       if v-ok <> true then do:
     2879         return error substitute( "&1 (tempcont_get-buffer-handle). Ошибка при создании временной таблицы &2 (2)", vss-include-info14, tt-name ) .
     2880       end.
     2881       create buf_temp-tables.
     2882       assign
     2883       buf_temp-tables.new-table-handle = tth
     2884       buf_temp-tables.tbl-name = p-tbl-name
     2885       buf_temp-tables.new-tbl-handle = tth:default-buffer-handle
     2886       .
     2887     end.
     2888     p-new-tbl-handle = buf_temp-tables.new-tbl-handle.
     2889   end.
     2890   end procedure.
     2891   procedure tempcont_clear :
     2892   define buffer buf_temp-tables for temp-tables.
     2893   do
     2894   on error undo, return error return-value
     2895   :
     2896     for each buf_temp-tables:
     2897       if valid-handle(buf_temp-tables.new-table-handle) then do:
     2898         buf_temp-tables.new-tbl-handle:empty-temp-table().
     2899       end.
     2900       delete object buf_temp-tables.new-table-handle.
     2901     end.
     2902   end.
     2903   end procedure.
     2904   define variable v-curr-r-b as character no-undo .
     2905   define buffer sourced_dis-card for ub.dis-card.
     2906   define buffer main_dis-card for ub.dis-card.
