     2022   .
     2023   define variable v-per-proc-num as integer no-undo .
     2024   procedure perproc-create-proc :
     2025   define input  parameter p-parent-handle as handle no-undo .
     2026   define input  parameter p-proc-name as character no-undo .
     2027   define input  parameter p-proc-handle  as handle no-undo .
     2028   define input  parameter p-run        as logical no-undo .
     2029   define input  parameter p-parameter as character no-undo .
     2030   define input  parameter p-userid as character no-undo .
     2031   define input  parameter p-rank-to-delete as integer no-undo .
     2032   define output parameter p-id as integer   no-undo .
     2033   define variable ii as integer   no-undo .
     2034   define variable v-proc-handle as handle no-undo .
     2035   define buffer buf_temp-pers-proc for temp-pers-proc.
     2036   define buffer buf0_temp-pers-proc for temp-pers-proc.
     2037     do
     2038     on error undo, return error return-value
     2039     :
     2040       if v-per-proc-num > 200 then return error '>'.
     2041       find first buf0_temp-pers-proc no-lock where
     2042                 buf0_temp-pers-proc.proc-name = p-proc-name use-index pi    no-error.
     2043       if not available buf0_temp-pers-proc then do:
     2044         if p-run then do:
     2045           run value(p-proc-name) persistent SET v-proc-handle (input p-parameter) no-error.
     2046           if error-status :error then undo, return error return-value .
     2047         end.
     2048         else v-proc-handle = p-proc-handle.
     2049         find last buf0_temp-pers-proc no-lock use-index iid  no-error.
     2050         create buf_temp-pers-proc.
     2051         assign
     2052         buf_temp-pers-proc.proc-name = p-proc-name
     2053         buf_temp-pers-proc.id = (if not available buf0_temp-pers-proc
     2054                                   then  0
     2055                                   else buf0_temp-pers-proc.id + 1)
     2056         buf_temp-pers-proc.user-name = p-userid
     2057         buf_temp-pers-proc.vpar      = p-parameter
     2058         buf_temp-pers-proc.vparent-handle = p-parent-handle
     2059         buf_temp-pers-proc.vproc-handle = v-proc-handle
     2060         buf_temp-pers-proc.rank-to-delete = p-rank-to-delete
     2061         p-id = buf_temp-pers-proc.id
     2062         v-per-proc-num = v-per-proc-num + 1
     2063         .
     2064       end.
     2065       else p-id = buf0_temp-pers-proc.id.
     2066     end.
     2067   end procedure.
     2068   procedure perproc-delete-proc-user :
     2069   define input  parameter p-proc-name as character no-undo .
     2070   define input  parameter p-user-name as character no-undo .
     2071   define buffer buf_temp-pers-proc for temp-pers-proc.
     2072     do
     2073     on error undo, return error return-value
     2074     :
     2075        for each buf_temp-pers-proc where
     2076               buf_temp-pers-proc.proc-name = p-proc-name
     2077          AND  buf_temp-pers-proc.user-name = p-user-name:
     2078           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
     2079           delete procedure buf_temp-pers-proc.vproc-handle.
     2080           delete buf_temp-pers-proc.
     2081           v-per-proc-num = v-per-proc-num - 1.
     2082        end.
     2083     end.
     2084   end procedure.
     2085   procedure perproc-delete-proc-id :
     2086   define input  parameter p-id        as integer   no-undo .
     2087   define buffer buf_temp-pers-proc for temp-pers-proc.
     2088     do
     2089     on error undo, return error return-value
     2090     :
     2091        for each buf_temp-pers-proc where
     2092           buf_temp-pers-proc.id        = p-id:
     2093           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
     2094           delete procedure buf_temp-pers-proc.vproc-handle.
     2095           delete buf_temp-pers-proc.
     2096           v-per-proc-num = v-per-proc-num - 1.
     2097        end.
     2098     end.
     2099   end procedure.
     2100   procedure perproc-delete-by-rank :
     2101   define buffer buf_temp-pers-proc for temp-pers-proc.
     2102     do
     2103     on error undo, return error return-value
     2104     :
     2105       for each buf_temp-pers-proc where
     2106       by buf_temp-pers-proc.rank-to-delete:
     2107         APPLY "delete" to buf_temp-pers-proc.vproc-handle.
     2108         delete procedure buf_temp-pers-proc.vproc-handle.
     2109         delete buf_temp-pers-proc.
     2110         v-per-proc-num = v-per-proc-num - 1.
     2111       end.
     2112     end.
     2113   end procedure.
