     2120     :
     2121        for each buf_temp-pers-proc where
     2122               buf_temp-pers-proc.proc-name = p-proc-name
     2123          AND  buf_temp-pers-proc.id        = p-id:
     2124           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
