     2909   define variable v-is-subsid as logical no-undo .
     2910   define variable v-tab-order as character no-undo .
     2911   define variable v-update-property as logical no-undo .
     2912   define variable v-found-copy-prop as logical no-undo .
     2913   define variable v-can-edit as logical no-undo .
     2914   define variable v-is-dct-client as logical no-undo .
     2915   define variable v-initial-type as character no-undo .
     2916   define variable v-initial-emitent-host-code as integer no-undo .
