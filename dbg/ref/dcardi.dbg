        1   DEFINE BUFFER locked_dis-card-long FOR ub.dis-card-long.
        2   DEFINE BUFFER locked_dis-card-property FOR ub.dis-card-property.
        3   DEFINE TEMP-TABLE temp-dis-card NO-UNDO LIKE ub.dis-card.
        4   DEFINE TEMP-TABLE tt0-dis-card-long NO-UNDO LIKE ub.dis-card-long.
        5   DEFINE TEMP-TABLE tt0-dis-card-property NO-UNDO LIKE ub.dis-card-property.
        6   define input parameter parparentproc as widget-handle no-undo .
        7   define input parameter ref-mode as char no-undo .
        8   define input parameter paremitent-host-code like ub.sysconf.host-code no-undo.
        9   define input parameter parhost-code like ub.sysconf.host-code no-undo.
       10   define input parameter parobj-type like ub.clients.obj-type no-undo.
       11   define input parameter parobj-code like ub.shop.obj-code no-undo.
       12   define input parameter cli-ri           as recid no-undo .
       13   define input-output parameter dc-ri           as recid no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":u .
       15   define variable vss-author      as character no-undo init "$Author$":u .
       16   define variable vss-date        as character no-undo init "$Date$":u .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       18   define variable vss-archive     as character no-undo init "$Archive$":u .
       19   define variable vss-description as character no-undo init "Дисконтная карта - добавление,изменение" .
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   procedure proc-alt-shift-f2:
       90     if not ibs.th.gbl.gbl-var:rcode
       91   then
       92     run gbl\inidebug.p .
       93   end.
       94   procedure proc-alt-shift-f3:
       95     run gbl/prvssinf.p
       96       ( input this-procedure
       97       ) .
       98   end.
       99   define variable v-inform-launched as logical no-undo initial false .
      100   procedure proc-alt-shift-f4:
      101     define variable v-action as character no-undo .
      102     if v-inform-launched = false then do:
      103       assign
      104         v-inform-launched = true
      105       .
      106       run gbl/d-inform.w
      107         (  input self
      108         ,  input this-procedure
      109         , output v-action
      110         ) no-error .
      111       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      112       assign
      113         v-inform-launched = false
      114       .
      115     end.
      116   end.
      117   procedure proc-alt-f1:
      118     run gbl/corrhelp.p
      119       (input this-procedure
      120       ) .
      121   end .
      122   on alt-shift-f2 anywhere do:
      123     run proc-alt-shift-f2.
      124   end.
      125   on alt-shift-f3 anywhere do:
      126     run proc-alt-shift-f3 in this-procedure .
      127   end.
      128   on alt-shift-f4 anywhere do:
      129     run proc-alt-shift-f4 in this-procedure.
      130   end.
      131   on alt-f1 anywhere do:
      132     run proc-alt-f1 in this-procedure .
      133   end.
      134   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135     define variable v-cntxt-db-num        as integer   no-undo .
      136     define variable v-cntxt-userid        as character no-undo .
      137     define variable v-cntxt-level         as character no-undo .
      138     define variable v-cntxt-host-code-obj as integer   no-undo .
      139     define variable v-cntxt-obj-type      as character no-undo .
      140     define variable v-cntxt-obj-code      as integer   no-undo .
      141     define variable v-cntxt-db-num-obj    as integer   no-undo .
      142     define variable v-cntxt-is-admin      as logical   no-undo .
      143   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   FUNCTION calc-dcpc-1 RETURNS DECIMAL(input  for-sum as decimal,
      145                                      input  n-d-pcnt as decimal,
      146                                      input  sumdiscs as char,
      147                                      output new-d-pcnt     as decimal):
      148   define variable ii as integer no-undo.
      149   ii = 1.
      150   new-d-pcnt = n-d-pcnt.
      151   REPEAT while (ii <= num-entries(sumdiscs, ";")):
      152       IF for-sum >= DECIMAL(ENTRY(1,ENTRY(ii, sumdiscs, ";"), "=")) AND
      153           (ii = NUM-ENTRIES(sumdiscs,";") OR
      154           for-sum < DECIMAL(ENTRY(1,ENTRY(ii + 1, sumdiscs, ";"), "="))
      155             ) THEN do:
      156         assign
      157         new-d-pcnt = decimal(ENTRY(2,ENTRY(ii, sumdiscs, ";"), "=")) NO-ERROR.
      158           LEAVE.
      159       END.
      160       ii = ii + 1.
      161   END.
      162   RETURN new-d-pcnt.
      163   END FUNCTION.
      164   FUNCTION calc-dckat-1 RETURNS INTEGER(input  for-sum as decimal,
      165                                      input  n-kat as integer,
      166                                      input  sumdiscs as char,
      167                                      output new-kat  as integer):
      168   define variable ii as integer no-undo.
      169   ii = 1.
      170   new-kat = n-kat.
      171   REPEAT while (ii <= num-entries(sumdiscs, ";")):
      172       IF for-sum >= DECIMAL(ENTRY(1,ENTRY(ii, sumdiscs, ";"), "=")) AND
      173           (ii = NUM-ENTRIES(sumdiscs,";") OR
      174           for-sum < DECIMAL(ENTRY(1,ENTRY(ii + 1, sumdiscs, ";"), "="))
      175             ) THEN do:
      176         assign
      177         new-kat = integer(ENTRY(2,ENTRY(ii, sumdiscs, ";"), "=")) NO-ERROR.
      178           LEAVE.
      179       END.
      180       ii = ii + 1.
      181   END.
      182   RETURN new-kat.
      183   END FUNCTION.
      184   FUNCTION calc-dcpc-2 RETURNS DECIMAL(input  for-sum as decimal,
      185                                       input  n-d-pcnt as decimal,
      186                                      input  sumdiscs as char,
      187                                      output new-d-pcnt     as decimal):
      188   define variable ii as integer no-undo.
      189   define variable v-new-ii as integer no-undo init -1.
      190   define variable v-old-ii as integer no-undo init -1.
      191   define variable no-support as logical no-undo .
      192   new-d-pcnt = 0.
      193   if n-d-pcnt = ? then do:
      194     no-support = yes.
      195     n-d-pcnt = 0.
      196   end.
      197   ii = 1.
      198   REPEAT while (ii <= num-entries(sumdiscs, ";")):
      199       if ii = 1 and
      200       for-sum < DECIMAL(ENTRY(1, ENTRY(ii, sumdiscs, ";"), "=")) then do:
      201          assign
      202          v-new-ii = 0.
      203       end.
      204       if ii = 1
      205       and  n-d-pcnt < DECIMAL(ENTRY(2, ENTRY(ii, sumdiscs, ";"), "=")) then do:
      206          assign
      207          v-old-ii = 0.
      208       end.
      209       IF for-sum >= DECIMAL(ENTRY(1, ENTRY(ii, sumdiscs, ";"), "=")) AND
      210           (ii = NUM-ENTRIES(sumdiscs, ";") OR
      211           for-sum < DECIMAL(ENTRY(1, ENTRY(ii + 1, sumdiscs, ";"), "="))
      212             ) THEN do:
      213         assign
      214         new-d-pcnt = decimal(ENTRY(2, ENTRY(ii, sumdiscs, ";"), "=")) NO-ERROR.
      215         v-new-ii = ii.
      216       END.
      217       IF n-d-pcnt >= DECIMAL(ENTRY(2, ENTRY(ii, sumdiscs, ";"), "=")) AND
      218           (ii = NUM-ENTRIES(sumdiscs, ";") OR
      219           n-d-pcnt < DECIMAL(ENTRY(2, ENTRY(ii + 1, sumdiscs, ";"), "="))
      220             ) THEN do:
      221         assign
      222         v-old-ii = ii.
      223       end.
      224       if (v-new-ii <> - 1
      225       AND V-OLD-II <>  -1)
      226       and ((v-old-ii - v-new-ii) >= 1
      227             or
      228             new-d-pcnt > n-d-pcnt
      229             or no-support
      230             )
      231       then leave.
      232       ii = ii + 1.
      233   END.
      234   if new-d-pcnt < n-d-pcnt then
      235   new-d-pcnt = decimal(ENTRY(2, ENTRY(v-old-ii - 1, sumdiscs, ";"), "=")) no-error .
      236   RETURN new-d-pcnt.
      237   END FUNCTION.
      238   FUNCTION calc-dckat-2 RETURNS INTEGER(input  for-sum as decimal,
      239                                      input  n-kat as integer,
      240                                      input  sumdiscs as char,
      241                                      output new-kat  as integer):
      242   define variable ii as integer no-undo.
      243   define variable v-new-ii as integer no-undo init -1.
      244   define variable v-old-ii as integer no-undo init -1.
      245   define variable no-support as logical no-undo .
      246   if n-kat = ? then do:
      247     no-support = yes.
      248     n-kat = 0.
      249   end.
      250   ii = 1.
      251   new-kat = 0.
      252   REPEAT while (ii <= num-entries(sumdiscs, ";")):
      253       if ii = 1
      254       and for-sum < DECIMAL(ENTRY(1, ENTRY(ii, sumdiscs, ";"), "=")) then do:
      255          assign
      256          v-new-ii = 0.
      257       end.
      258       if ii = 1
      259       and n-kat < integer(ENTRY(2, ENTRY(ii, sumdiscs, ";"), "=")) then do:
      260          assign
      261          v-old-ii = 0.
      262       end.
      263       IF for-sum >= DECIMAL(ENTRY(1,ENTRY(ii, sumdiscs, ";"), "=")) AND
      264           (ii = NUM-ENTRIES(sumdiscs,";") OR
      265           for-sum < DECIMAL(ENTRY(1,ENTRY(ii + 1, sumdiscs, ";"), "="))
      266             ) THEN do:
      267         assign
      268         new-kat = integer(ENTRY(2,ENTRY(ii, sumdiscs, ";"), "=")) NO-ERROR.
      269         v-new-ii = ii.
      270       END.
      271       IF n-kat >= integer(ENTRY(2, ENTRY(ii, sumdiscs, ";"), "=")) AND
      272           (ii = NUM-ENTRIES(sumdiscs, ";") OR
      273           n-kat < integer(ENTRY(2, ENTRY(ii + 1, sumdiscs, ";"), "="))
      274             ) THEN do:
      275         assign
      276         v-old-ii = ii.
      277       END.
      278       if (v-new-ii <> - 1
      279       AND V-OLD-II <>  -1)
      280       and (abs(v-old-ii - v-new-ii) >= 1
      281            or
      282            no-support)
      283       then leave.
      284       ii = ii + 1.
      285   END.
      286   if v-new-ii < v-old-ii then
      287   new-kat = integer(ENTRY(2, ENTRY(v-old-ii - 1, sumdiscs, ";"), "=")) no-error .
      288   RETURN new-kat.
      289   END FUNCTION.
      290   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      291   procedure cur-time :
      292      define output parameter p-today as date      no-undo .
      293      define output parameter p-time  as integer   no-undo .
      294     do
      295     on error undo, return error
      296     :
      297       define variable v-date1 as date      no-undo .
      298       define variable v-date2 as date      no-undo .
      299       define variable v-time  as integer   no-undo .
      300       assign
      301         v-date1 = today
      302         v-time  = time
      303         v-date2 = today
      304       .
      305       if v-date1 <> v-date2
      306       then do:
      307         assign
      308           v-date1 = today
      309           v-time  = v-time
      310         .
      311       end.
      312       assign
      313         p-today = v-date1
      314         p-time  = v-time
      315       .
      316     end.
      317   end.
      318   function cur-time-date returns character
      319   :
      320     return string(today, '99/99/9999':U) .
      321   end.
      322   function cur-time-mjd returns decimal
      323   :
      324     define variable v-date as date      no-undo .
      325     define variable v-time as integer   no-undo .
      326     run cur-time in this-procedure
      327       (output v-date
      328       ,output v-time
      329       ) .
      330     return integer(v-date) - 2400002 + (v-time / 86400) .
      331   end.
      332   function cur-time-get-ending-index returns integer
      333   (input p-number as integer
      334   )
      335   :
      336     if p-number < 0
      337     or p-number = ?
      338     then do:
      339       return 1 .
      340     end.
      341     define variable v-rest as integer   no-undo .
      342     assign
      343       p-number = p-number modulo 100
      344     .
      345     if p-number < 20
      346     then do:
      347       assign
      348         v-rest = p-number
      349       .
      350     end.
      351     else do:
      352       assign
      353         v-rest = p-number modulo 10
      354       .
      355     end.
      356     case v-rest :
      357       when 1
      358       then do:
      359         return 2 .
      360       end.
      361       when 2 or
      362       when 3 or
      363       when 4
      364       then do:
      365         return 3 .
      366       end.
      367       otherwise do:
      368         return 1 .
      369       end.
      370     end case .
      371   end.
      372   procedure cur-time-mjd-to-date :
      373      define input  parameter i-mjd-diff as decimal no-undo.
      374      define output parameter o-Date     as date    no-undo.
      375      define output parameter o-Time     as integer no-undo.
      376      define variable v-day-number as integer   no-undo .
      377      if    i-mjd-diff < 0
      378         or i-mjd-diff = ?
      379      then do:
      380         return "?" .
      381      end.
      382      assign
      383         v-day-number = truncate(i-mjd-diff,0).
      384         o-Date = date(v-day-number + 2400002).
      385         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      386     .
      387   end.
      388   function cur-time-mjd-to-string returns character
      389   (input p-mjd-diff as decimal
      390   )
      391   :
      392     define variable v-day-number as integer   no-undo .
      393     define variable v-seconds    as integer   no-undo .
      394     define variable v-hour       as integer   no-undo .
      395     define variable v-min        as integer   no-undo .
      396     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      397     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      398     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      399     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      400     if p-mjd-diff < 0
      401     or p-mjd-diff = ?
      402     then do:
      403       return "?" .
      404     end.
      405     assign
      406       v-day-number = integer(truncate(p-mjd-diff,0))
      407       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      408     .
      409     if v-seconds > 86400
      410     then do:
      411       assign
      412         v-seconds = 86400 - 1
      413       .
      414     end.
      415     if v-seconds < 0
      416     then do:
      417       assign
      418         v-seconds = 0
      419       .
      420     end.
      421     assign
      422       v-hour = truncate(v-seconds / 3600, 0)
      423     .
      424     assign
      425       v-seconds = v-seconds modulo 3600
      426     .
      427     assign
      428       v-min = truncate(v-seconds / 60, 0)
      429     .
      430     assign
      431       v-seconds = v-seconds modulo 60
      432     .
      433     return
      434         (if v-day-number <> 0
      435           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      436           else ""
      437         )
      438       + (if v-day-number <> 0 or v-hour <> 0
      439           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      440           else ""
      441         )
      442       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      443           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      444           else ""
      445         )
      446       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      447       .
      448   end.
      449   function cur-time-string returns character
      450   :
      451     define variable v-date as date      no-undo .
      452     define variable v-time as integer   no-undo .
      453     run cur-time in this-procedure
      454       (output v-date
      455       ,output v-time
      456       ) .
      457     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      458   end.
      459   function cur-time-string-sec returns character
      460   :
      461     define variable v-date as date      no-undo .
      462     define variable v-time as integer   no-undo .
      463     run cur-time in this-procedure
      464       (output v-date
      465       ,output v-time
      466       ) .
      467     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      468   end.
      469   function cur-time-custom  returns character
      470   (input p-prefix as character
      471   ,input p-date-format as character
      472   ,input p-delimiter as character
      473   ,input p-time-format as character
      474   ,input p-suffix as character
      475   )
      476   :
      477     define variable v-date as date      no-undo .
      478     define variable v-time as integer   no-undo .
      479     run cur-time in this-procedure
      480       (output v-date
      481       ,output v-time
      482       ) .
      483     return
      484       p-prefix
      485       + string(v-date, p-date-format)
      486       + p-delimiter
      487       + string(v-time, p-time-format)
      488       + p-suffix
      489       .
      490   end.
      491   function cur-time-print  returns character
      492   :
      493     define variable v-date as date      no-undo .
      494     define variable v-time as integer   no-undo .
      495     run cur-time in this-procedure
      496       (output v-date
      497       ,output v-time
      498       ) .
      499     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      500   end.
      501   function cur-time-datetime returns datetime
      502   :
      503     define variable v-char as character no-undo .
      504     define variable v-datetime as datetime no-undo .
      505     v-char = cur-time-string().
      506     v-datetime = datetime(v-char).
      507     return  v-datetime.
      508   end.
      509   function cur-time-string-msec returns character
      510   :
      511     define variable v-date as datetime  no-undo .
      512     v-date = now.
      513     return string(v-date) .
      514   end.
      515   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      516   define variable v-disprop-menu-section-num as integer no-undo .
      517   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      518   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      519   procedure gen-key-rec :
      520     define input  parameter p-tbl-name    as character no-undo.
      521     define input  parameter p-bh_tbl-name as handle    no-undo.
      522     define output parameter p-key-rec     as character no-undo.
      523     do
      524     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      525     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      526     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      527     :
      528       define variable fh               as handle    no-undo .
      529       define variable v-ok             as logical   no-undo .
      530       define variable v-inform         as character no-undo .
      531       define variable v-ind            as integer   no-undo .
      532       define variable v-idx-field-qnty as integer   no-undo .
      533       if p-tbl-name = ?
      534         or p-tbl-name = "":U
      535       then do:
      536         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      537       end.
      538       if not p-bh_tbl-name:available then do:
      539         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      540       end.
      541       assign
      542         p-key-rec = p-tbl-name
      543         v-inform  = p-bh_tbl-name:index-information(1)
      544         v-ind     = 2
      545       .
      546       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      547       on error undo, return error
      548       :
      549         assign
      550           v-inform = p-bh_tbl-name:index-information( v-ind )
      551           v-ind    = v-ind + 1
      552         .
      553       end.
      554       if v-inform = ?
      555         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      556         or entry( 3, v-inform, ",":U ) <> "1":U
      557       then do:
      558         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      559       end.
      560       else do:
      561         assign
      562           v-idx-field-qnty = num-entries( v-inform ) - 4
      563         .
      564         if v-idx-field-qnty < 2 then do:
      565           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      566         end.
      567         do v-ind = 1 to v-idx-field-qnty by 2
      568         on error undo, return error
      569         :
      570           assign
      571             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      572             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      573           .
      574         end.
      575       end.
      576       if p-key-rec = ? then do:
      577         assign
      578           p-key-rec = "":U
      579         .
      580         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      581       end.
      582     end.
      583     return.
      584   end procedure.
      585   procedure gen-where-keyr-tab :
      586     define input  parameter i-tableSerach as character no-undo.
      587     define input  parameter i-tablekey   as character  no-undo.
      588     define input  parameter p-key-rec    as character  no-undo.
      589     define input  parameter p-key-handle as handle     no-undo .
      590     define input  parameter p-db-name    as character  no-undo .
      591     define input  parameter p-tt-handle  as handle     no-undo .
      592     define output parameter o-Where      as character  no-undo.
      593     do
      594     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      595     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      596     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      597     :
      598       define variable v-full-tbl-name  as character no-undo .
      599       define variable bh_tbl-name      as handle    no-undo .
      600       define variable fh_key           as handle    no-undo .
      601       define variable fh_search        as handle    no-undo .
      602       define variable v-field-num      as integer   no-undo .
      603       define variable v-count-fld      as integer   no-undo .
      604       define variable v-inform         as character no-undo .
      605       define variable v-ind            as integer   no-undo .
      606       define variable v-idx-field-qnty as integer   no-undo .
      607       define variable v-field-name     as character no-undo .
      608       define variable v-field-val      as character no-undo .
      609       define variable v-word-link      as character no-undo .
      610       define variable vTable           as character no-undo.
      611       define variable bh_tbl-key       as handle    no-undo .
      612       assign
      613         p-key-rec = trim( p-key-rec )
      614       .
      615       if p-key-handle <> ? then do:
      616         if not valid-handle(p-key-handle)
      617            or p-key-handle:type <> "buffer"
      618         then do:
      619           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      620         end.
      621         if num-entries( p-key-rec, chr(3) ) > 1
      622           or p-key-rec = ?
      623           or p-key-rec = "":U
      624         then do:
      625           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      626         end.
      627       end.
      628       else do:
      629         if p-key-rec = ?
      630           or p-key-rec = "":U
      631         then do:
      632           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      633         end.
      634       end.
      635       assign
      636         vTable = entry( 1 , p-key-rec, chr(3) )
      637       .
      638       if p-tt-handle <> ?
      639         and ( not valid-handle(p-tt-handle)
      640               or p-tt-handle:type <> "buffer"
      641             )
      642       then do:
      643         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      644       end.
      645       if p-tt-handle = ? then do:
      646         assign
      647           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      648         .
      649         create buffer bh_tbl-name for table v-full-tbl-name .
      650       end.
      651       else do:
      652         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      653       end.
      654       assign
      655         v-inform = bh_tbl-name:index-information(1)
      656         v-ind    = 2
      657       .
      658       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      659       on error undo, return error
      660       :
      661         assign
      662           v-inform = bh_tbl-name:index-information( v-ind )
      663           v-ind    = v-ind + 1
      664         .
      665       end.
      666       if v-inform = ?
      667         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      668         or entry( 3, v-inform, ",":U ) <> "1":U
      669       then do:
      670         delete object bh_tbl-name no-error.
      671         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      672       end.
      673       assign
      674         v-idx-field-qnty = num-entries( v-inform ) - 4
      675       .
      676       if v-idx-field-qnty < 2 then do:
      677         delete object bh_tbl-name no-error.
      678         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      679       end.
      680       assign
      681         o-where     = "where":U
      682         v-word-link = "":U
      683         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      684         v-count-fld = 0
      685       .
      686       if i-tablekey ne "" and i-tablekey ne ?
      687       then do:
      688         assign
      689           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      690         .
      691         create buffer bh_tbl-key for table v-full-tbl-name .
      692       end.
      693       if i-tableSerach ne "" and i-tableSerach ne ?
      694       then do:
      695         delete object bh_tbl-name no-error.
      696         assign
      697           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      698         .
      699         create buffer bh_tbl-name for table v-full-tbl-name .
      700       end.
      701       block_where:
      702       do v-ind = 1 to v-idx-field-qnty by 2
      703       on error undo, return error
      704       :
      705         assign
      706           v-count-fld = v-count-fld + 1
      707         .
      708         if p-key-handle = ?
      709           and v-count-fld > v-field-num
      710         then do:
      711           leave block_where.
      712         end.
      713         define variable VfieldKeyTable as handle no-undo.
      714         assign
      715           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      716           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      717         .
      718         if     bh_tbl-key ne ?
      719         then do:
      720            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      721            if VfieldKeyTable eq ?
      722            then next block_where.
      723         end.
      724         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      725         then
      726            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      727         else
      728            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      729         if p-key-handle = ? then do:
      730           assign
      731             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      732           .
      733         end.
      734         else do:
      735           assign
      736             fh_key = p-key-handle:buffer-field( v-field-name )
      737           .
      738           if fh_key = ?
      739             or not valid-handle( fh_key )
      740           then do:
      741             delete object bh_tbl-name.
      742             if     bh_tbl-key ne ?
      743             then
      744                delete object bh_tbl-key.
      745             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      746           end.
      747           assign
      748             v-field-val = fh_key:buffer-value
      749           .
      750         end.
      751         if fh_search:data-type ="character":U then do:
      752           assign
      753             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      754             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      755             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      756             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      757             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      758             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      759             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      760             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      761             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      762             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      763             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      764             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      765             v-field-val = substitute( '"&1"', v-field-val )
      766           .
      767         end.
      768         assign
      769           o-where = substitute( "&1 &2", o-where, v-field-val )
      770         .
      771         if v-word-link = "":U then do:
      772           assign
      773             v-word-link = "and":U
      774           .
      775         end.
      776       end.
      777       delete object bh_tbl-name.
      778       if     bh_tbl-key ne ?
      779       then
      780          delete object bh_tbl-key.
      781       if p-key-handle = ?
      782         and v-count-fld <> v-field-num
      783       then do:
      784         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      785       end.
      786     end.
      787   end procedure.
      788   procedure gen-hn-keyr-tab :
      789     define input  parameter i-tableSerach as character no-undo.
      790     define input  parameter i-tablekey   as character no-undo.
      791     define input  parameter p-key-rec    as character no-undo.
      792     define input  parameter p-key-handle as handle    no-undo .
      793     define input  parameter p-db-name    as character no-undo .
      794     define input  parameter p-tt-handle  as handle    no-undo .
      795     define input  parameter p-stts-lock  as integer   no-undo .
      796     define output parameter o-hn         as handle    no-undo.
      797     define variable v-full-tbl-name as character no-undo.
      798     define variable v-where         as character no-undo.
      799     define variable bh_tbl-name     as handle    no-undo.
      800     define variable vTable          as character no-undo.
      801     do
      802     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      803     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      804     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      805         run gen-where-keyr-tab(i-tableSerach,
      806                                i-tablekey,
      807                                p-key-rec,
      808                                p-key-handle,
      809                                p-db-name,
      810                                p-tt-handle,
      811                                output v-where).
      812         if i-tableSerach ne "" and i-tableSerach ne ?
      813         then do:
      814            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      815            create buffer bh_tbl-name for table v-full-tbl-name .
      816         end.
      817         else do:
      818            if p-tt-handle = ? then do:
      819               assign
      820                  vTable = entry( 1 , p-key-rec, chr(3) )
      821               .
      822               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      823               create buffer bh_tbl-name for table v-full-tbl-name .
      824            end.
      825            else do:
      826               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      827            end.
      828         end.
      829         if p-tt-handle = ? then do:
      830            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      831         end.
      832         else do:
      833            bh_tbl-name:find-first( v-where ) no-error .
      834         end.
      835         o-hn = bh_tbl-name.
      836      end.
      837   end procedure.
      838   procedure gen-hn-keyr :
      839     define input  parameter p-key-rec    as character no-undo.
      840     define input  parameter p-key-handle as handle    no-undo .
      841     define input  parameter p-db-name    as character no-undo .
      842     define input  parameter p-tt-handle  as handle    no-undo .
      843     define input  parameter p-stts-lock  as integer   no-undo .
      844     define output parameter o-hn         as handle    no-undo.
      845     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      846   end.
      847   procedure gen-row-keyr :
      848     define input  parameter p-key-rec    as character no-undo.
      849     define input  parameter p-key-handle as handle    no-undo .
      850     define input  parameter p-db-name    as character no-undo .
      851     define input  parameter p-tt-handle  as handle    no-undo .
      852     define input  parameter p-stts-lock  as integer   no-undo .
      853     define output parameter p-tbl-row    as rowid     no-undo.
      854     define output parameter p-tbl-name   as character no-undo.
      855     define variable vHn as handle no-undo.
      856       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      857       p-tbl-row = if vHn:available then vHn:rowid else ?.
      858       p-tbl-name =  vHn:table.
      859       delete object vHn no-error.
      860     if p-tbl-row = ? then do:
      861       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      862     end.
      863     else do:
      864       return.
      865     end.
      866   end procedure.
      867   procedure gen-key-fv :
      868     define input  parameter p-key-rec    as character no-undo .
      869     define output parameter p-field-list as character no-undo .
      870     define output parameter p-value-list as character no-undo.
      871     do
      872     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      873     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      874     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      875     :
      876       define variable v-full-tbl-name  as character no-undo .
      877       define variable bh_tbl-name      as handle    no-undo .
      878       define variable v-tbl-name       as character no-undo .
      879       define variable v-field-num      as integer   no-undo .
      880       define variable v-count-fld      as integer   no-undo .
      881       define variable v-inform         as character no-undo .
      882       define variable v-ind            as integer   no-undo .
      883       define variable v-idx-field-qnty as integer   no-undo .
      884       define variable v-delim-key      as character no-undo .
      885       if p-key-rec = ?
      886         or p-key-rec = "":U
      887       then do:
      888         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      889       end.
      890       assign
      891         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      892         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      893       .
      894       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      895       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      896       assign
      897         v-inform = bh_tbl-name:index-information(1)
      898         v-ind    = 2
      899       .
      900       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      901       on error undo, return error
      902       :
      903         assign
      904           v-inform = bh_tbl-name:index-information( v-ind )
      905           v-ind    = v-ind + 1
      906         .
      907       end.
      908       if v-inform = ?
      909         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      910         or entry( 3, v-inform, ",":U ) <> "1":U
      911       then do:
      912         delete object bh_tbl-name no-error.
      913         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      914       end.
      915       assign
      916         v-idx-field-qnty = num-entries( v-inform ) - 4
      917       .
      918       if v-idx-field-qnty < 2 then do:
      919         delete object bh_tbl-name no-error.
      920         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      921       end.
      922       assign
      923         p-field-list = "":U
      924         p-value-list = "":U
      925         v-delim-key  = "":U
      926         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      927         v-count-fld  = 0
      928       .
      929       block_where:
      930       do v-ind = 1 to v-idx-field-qnty by 2
      931       on error undo, return error
      932       :
      933         assign
      934           v-count-fld = v-count-fld + 1
      935         .
      936         if v-count-fld > v-field-num then do:
      937           leave block_where.
      938         end.
      939         assign
      940           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      941           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      942         .
      943         if v-ind = 1 then do:
      944           assign
      945             v-delim-key = chr(3)
      946           .
      947         end.
      948       end.
      949       delete object bh_tbl-name.
      950       if v-count-fld <> v-field-num then do:
      951         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      952       end.
      953     end.
      954   end procedure.
      955   procedure gen-key-field :
      956     define input  parameter p-table      as character no-undo .
      957     define output parameter p-field-list as character no-undo .
      958     do
      959     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      960     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      961     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      962     :
      963       define variable v-full-tbl-name  as character no-undo .
      964       define variable bh_tbl-name      as handle    no-undo .
      965       define variable v-tbl-name       as character no-undo .
      966       define variable v-field-num      as integer   no-undo .
      967       define variable v-count-fld      as integer   no-undo .
      968       define variable v-inform         as character no-undo .
      969       define variable v-ind            as integer   no-undo .
      970       define variable v-idx-field-qnty as integer   no-undo .
      971       define variable v-delim-key      as character no-undo .
      972       if p-table = ?
      973         or p-table = "":U
      974       then do:
      975         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      976       end.
      977       assign
      978         v-tbl-name      = p-table
      979         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      980       .
      981       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      982       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      983       assign
      984         v-inform = bh_tbl-name:index-information(1)
      985         v-ind    = 2
      986       .
      987       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      988       on error undo, return error
      989       :
      990         assign
      991           v-inform = bh_tbl-name:index-information( v-ind )
      992           v-ind    = v-ind + 1
      993         .
      994       end.
      995       if v-inform = ?
      996         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      997         or entry( 3, v-inform, ",":U ) <> "1":U
      998       then do:
      999         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1000       end.
     1001       assign
     1002         v-idx-field-qnty = num-entries( v-inform ) - 4
     1003       .
     1004       if v-idx-field-qnty < 2 then do:
     1005         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1006       end.
     1007       assign
     1008         p-field-list = "":U
     1009         v-delim-key  = "":U
     1010         v-count-fld  = 0
     1011       .
     1012       block_where:
     1013       do v-ind = 1 to v-idx-field-qnty by 2
     1014       on error undo, return error
     1015       :
     1016         assign
     1017           v-count-fld = v-count-fld + 1
     1018         .
     1019         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1020         if v-ind = 1 then do:
     1021           assign
     1022             v-delim-key = chr(3)
     1023           .
     1024         end.
     1025       end.
     1026       delete object bh_tbl-name.
     1027     end.
     1028   end procedure.
