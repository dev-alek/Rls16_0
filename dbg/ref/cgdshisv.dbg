     3890   function get-node-code-name returns character ( input p-node-code as integer):
     3891   define variable v-prt-name as character no-undo .
     3892   v-prt-name = "(":U + string(p-node-code) + ")".
     3893   define buffer buf_gds-prt for ub.gds-prt.
     3894   find first buf_gds-prt no-lock where
     3895             buf_gds-prt.node-code = p-node-code no-error.
     3896   if available buf_gds-prt then do:
     3897     assign
     3898     v-prt-name =  (if buf_gds-prt.f-name <> "":U
     3899                   then buf_gds-prt.f-name
     3900                   else buf_gds-prt.node-name) + "(":U + string(p-node-code) + ")"
     3901     .
     3902   end.
     3903   return v-prt-name.
     3904   end function.
