     1339   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1340   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1341   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1342   procedure disrules-fill-properties:
     1343   define input  parameter p-templ-rl-root as integer   no-undo .
     1344   define buffer buf_drt-prop for ub.drt-prop.
     1345   define buffer buf_temp-drt-prop for temp-drt-prop.
     1346   do
     1347   on error undo, return error return-value
     1348   :
     1349     for each buf_temp-drt-prop:
     1350       delete buf_temp-drt-prop.
     1351     end.
     1352     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1353       create buf_temp-drt-prop.
     1354       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1355     end.
     1356   end.
     1357   end procedure.
     1358   ~
     1359   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1360   procedure discfgru-check :
     1361   define input parameter p-table-name as character no-undo .
     1362   define input parameter p-templ-rl-root as integer no-undo .
     1363   define input parameter p-time-templ-rl-root as integer no-undo .
     1364   define input parameter p-pos-type as character no-undo .
     1365   define output parameter p-disnct-role as character no-undo .
     1366   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1367     do
     1368     on error undo, return error return-value
     1369     :
     1370       find first buf_dis-cfg-rule no-lock where
     1371               buf_dis-cfg-rule.table-name = p-table-name
     1372           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1373           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1374           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1375       if not available buf_dis-cfg-rule
     1376       or p-pos-type = "":U
     1377       then do:
     1378          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1379                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1380                                  , p-templ-rl-root
     1381                                  , (if p-time-templ-rl-root = ?
     1382                                     then '':U
     1383                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1384                                     )
     1385                                  ).
     1386       end.
     1387       assign
     1388       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1389       .
     1390     end.
     1391   end procedure.
     1392   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1393   FUNCTION get-region RETURNS CHARACTER
     1394     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1395     define variable par-region as character no-undo.
     1396     if parhost-code = 0 and
     1397          parobj-type = "":U and
     1398          parobj-code = 0 then do:
     1399          par-region = "Глобально".
     1400          return par-region.
     1401       end.
     1402       if parobj-type = 'орг':U then do:
     1403          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1404          return par-region.
     1405       end.
     1406       if parobj-type = 'регион':U
     1407       then do:
     1408          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1409          return par-region.
     1410       end.
     1411       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1412       return par-region.
     1413   END FUNCTION.
     1414   FUNCTION get-objregion RETURNS CHARACTER
     1415     (  input parobj-type as character, input parobj-code as integer ) :
     1416     define variable par-region as character no-undo.
     1417     if  parobj-type = "":U and
     1418         parobj-code = 0
     1419     then do:
     1420        par-region = "Глобально".
     1421     end.
     1422     else if parobj-type = 'орг':U
     1423     then do:
     1424        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1425     end.
     1426     else if parobj-type = 'регион':U
     1427     then do:
     1428        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1429     end.
     1430     else
     1431        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1432     return par-region.
     1433   END FUNCTION.
     1434   procedure disgdsru-name :
     1435   define buffer buf_dis-rule for ub.dis-rule.
     1436   do
     1437     on error undo, return error
     1438     :
     1439     define input  parameter p-templ-rl-root  as integer no-undo .
     1440     define output parameter p-label          as character no-undo .
     1441     find first buf_dis-rule no-lock where
     1442               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1443     if available buf_dis-rule
     1444     then do:
     1445       if buf_dis-rule.rule-num > 0 then
     1446       p-label = buf_dis-rule.des.
     1447     end.
     1448     else do:
     1449       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1450     end.
     1451   end.
     1452   end procedure.
     1453   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1454   define variable v-rule-label as character no-undo .
     1455   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1456                                        ,output v-rule-label) no-error.
     1457   return v-rule-label.
     1458   end function.
     1459   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1460   define variable v-rule-label as character no-undo .
     1461   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1462   end function.
     1463   procedure disgdsru-write :
     1464     do
     1465     on error undo, return error
     1466     :
     1467       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1468       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1469       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1470       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1471       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1472       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1473       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1474       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1475       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1476       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1477       define buffer buf_dis-rule for ub.dis-rule.
     1478       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1479       define variable v-label          as character no-undo .
     1480       define variable v-discnt-role as character no-undo .
     1481       run discfgru-check in this-procedure (
     1482                                             input 'dis-gds-rule':U
     1483                                            ,input p-templ-rl-root
     1484                                            ,input p-time-templ-rl-root
     1485                                            ,input p-pos-type
     1486                                            ,output v-discnt-role
     1487                                             ) no-error .
     1488       if error-status :error then do:
     1489         undo, return error return-value .
     1490       end.
     1491       if p-discnt-role = ? then do:
     1492         p-discnt-role = v-discnt-role.
     1493       end.
     1494       if p-discnt-role <> v-discnt-role then do:
     1495         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1496                                 ,p-gds-code
     1497                                 ,p-obj-type
     1498                                 ,p-obj-code
     1499                                 ,p-pos-type
     1500                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1501                                 ,chr(10)
     1502                                 ,p-templ-rl-root
     1503                                 ,p-rule-num).
     1504       end.
     1505       if p-pos-type = ? then do:
     1506   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1507   define variable v-param-type8 as character no-undo .
     1508   define variable v-value-date8 as date no-undo .
     1509   define variable v-value-decimal8 as decimal no-undo .
     1510   define variable v-value-integer8 as INTEGER no-undo .
     1511   define variable v-value-logical8 AS LOGICAL no-undo .
     1512   define variable v-tth8 as handle no-undo .
     1513   run adm/shattri.p (
     1514       input "get":U
     1515       ,input  p-obj-type
     1516       ,input  p-obj-code
     1517       ,input  'cd-sending':U
     1518       ,input  'dflt-cd':U
     1519       ,output p-pos-type
     1520       ,output v-value-date8
     1521       ,output v-value-decimal8
     1522       ,output v-value-integer8
     1523       ,output v-value-logical8
     1524       ,output v-param-type8
     1525       ,INPUT-OUTPUT table-handle v-tth8
     1526       )  .
     1527   delete object v-tth8 no-error.
     1528       end.
     1529       find first buf_dis-rule no-lock where
     1530                 buf_dis-rule.rule-num = p-rule-num no-error.
     1531       if not available buf_Dis-rule then do:
     1532         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1533                                 ,p-gds-code
     1534                                 ,p-obj-type
     1535                                 ,p-obj-code
     1536                                 ,p-pos-type
     1537                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1538                                 ,chr(10)
     1539                                 ,p-rule-num).
     1540       end.
     1541       if buf_dis-rule.root <> yes then do:
     1542         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1543                                 ,p-gds-code
     1544                                 ,p-obj-type
     1545                                 ,p-obj-code
     1546                                 ,p-pos-type
     1547                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1548                                 ,chr(10)
     1549                                 ,p-rule-num).
     1550       end.
     1551       if not (p-obj-type = buf_dis-rule.obj-type
     1552           and p-obj-code = buf_dis-rule.obj-code)
     1553       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1554                and
     1555                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1556        then do:
     1557         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1558                                 ,p-gds-code
     1559                                 ,p-obj-type
     1560                                 ,p-obj-code
     1561                                 ,p-pos-type
     1562                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1563                                 ,chr(10)
     1564                                 ) +
     1565                             substitute("Правило скидки &1 определено для &2&3" +
     1566                                        "а привязка к товару для &4"
     1567                                        ,buf_dis-rule.rule-num
     1568                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1569                                        ,chr(10)
     1570                                        ,get-objregion( p-obj-type, p-obj-code)
     1571                                        ))
     1572                                 .
     1573       end.
     1574       find first buf_dis-gds-rule exclusive-lock where
     1575                  buf_dis-gds-rule.gds-code  = p-gds-code
     1576              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1577              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1578              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1579              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1580              and buf_dis-gds-rule.nonunique = p-nonunique
     1581              no-error .
     1582       if not available buf_dis-gds-rule then do:
     1583         find first buf_dis-gds-rule exclusive-lock where
     1584                   buf_dis-gds-rule.gds-code  = p-gds-code
     1585               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1586               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1587               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1588               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1589               no-error .
     1590         if available buf_Dis-gds-rule then do:
     1591           if p-nonunique = ''
     1592           and available buf_dis-gds-rule
     1593           then do:
     1594             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1595                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1596                                      , p-gds-code
     1597                                      , buf_Dis-rule.obj-type
     1598                                      , buf_Dis-rule.obj-code
     1599                                      , p-nonunique
     1600                                     ).
     1601           end.
     1602           if available buf_dis-gds-rule
     1603           and buf_dis-gds-rule.nonunique = ''
     1604           and p-nonunique <> ''then do:
     1605             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1606                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1607                                      , p-gds-code
     1608                                      , buf_Dis-rule.obj-type
     1609                                      , buf_Dis-rule.obj-code
     1610                                     ).
     1611           end.
     1612         end.
     1613         create buf_dis-gds-rule .
     1614         assign
     1615         buf_dis-gds-rule.gds-code  = p-gds-code
     1616         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1617         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1618         buf_dis-gds-rule.pos-type = p-pos-type
     1619         buf_dis-gds-rule.discnt-role = v-discnt-role
     1620         buf_dis-gds-rule.rule-num = p-rule-num
     1621         buf_dis-gds-rule.nonunique = p-nonunique
     1622         no-error
     1623         .
     1624       end.
     1625       ASSIGN
     1626       buf_dis-gds-rule.rule-num = p-rule-num
     1627       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1628       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1629       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1630       buf_dis-gds-rule.nonunique = p-nonunique
     1631       no-error.
     1632     end.
     1633   end procedure.
     1634   PROCEDURE cmp-disgdsru-write :
     1635   do
     1636   on error undo, return error
     1637   :
     1638     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1639     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1640     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1641     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1642     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1643     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1644     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1645     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1646     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1647     define variable v-rule-label          as character no-undo .
     1648     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1649     define buffer buf_dis-rule     for ub.dis-rule.
     1650     run disgdsru-name in this-procedure (
     1651                                         input  p-templ-rl-root
     1652                                         ,output v-rule-label
     1653                                         ) no-error .
     1654     if error-status :error then do:
     1655       undo, return error return-value .
     1656     end.
     1657     find first buf_tt0-dis-gds-rule exclusive-lock where
     1658                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1659             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1660             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1661             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1662             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1663             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1664             no-error .
     1665     if not available buf_tt0-dis-gds-rule then do:
     1666       create buf_tt0-dis-gds-rule .
     1667       assign
     1668       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1669       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1670       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1671       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1672       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1673       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1674       no-error
     1675       .
     1676     end.
     1677     find first buf_dis-rule no-lock where
     1678               buf_dis-rule.rule-num = p-rule-num.
     1679     ASSIGN
     1680     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1681     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1682     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1683     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1684     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1685     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1686     no-error.
     1687     release buf_tt0-dis-gds-rule no-error .
     1688     if error-status:error then do:
     1689       undo, return error return-value .
     1690     end.
     1691   end.
     1692   END PROCEDURE.
     1693   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1694   procedure plgdattr-name :
     1695   do
     1696     on error undo, return error
     1697     :
     1698     define input  parameter p-code           as character no-undo .
     1699     define output parameter p-type           as character no-undo .
     1700     define output parameter p-format         as character no-undo .
     1701     define output parameter p-label          as character no-undo .
     1702     define output parameter p-user-can-edit  as logical   no-undo .
     1703     define output parameter p-output-display as logical   no-undo .
     1704     define output parameter p-other          as character no-undo .
     1705       case p-code :
     1706         otherwise do:
     1707           undo, return error substitute("Неизвестный атрибут товара на складском месте &1",  p-code ).
     1708         end.
     1709       end.
     1710     end.
     1711   end procedure.
     1712   procedure plgdattr-tooltip :
     1713   do
     1714     on error undo, return error
     1715     :
     1716       define input  parameter p-code    as character no-undo .
     1717       define output parameter p-tooltip as character no-undo .
     1718       define output parameter p-label   as character no-undo .
     1719       case p-code :
     1720         otherwise do:
     1721           undo, return error substitute("Неизвестный атрибут товара складском месте &1" , p-code ).
     1722         end.
     1723       end.
     1724     end.
     1725   end procedure.
     1726   procedure plgdattr-value :
     1727    do
     1728     on error undo, return error
     1729     :
     1730       define input  parameter p-code     like ub.pl-gds-attr.attr-code  no-undo .
     1731       define input  parameter p-obj-type like ub.pl-gds-attr.obj-type   no-undo .
     1732       define input  parameter p-obj-code like ub.pl-gds-attr.obj-code   no-undo .
     1733       define input  parameter p-pl-code  like ub.pl-gds-attr.pl-code    no-undo .
     1734       define input  parameter p-gds-code like ub.pl-gds-attr.gds-code   no-undo .
     1735       define output parameter p-value    like ub.pl-gds-attr.attr-value no-undo .
     1736       define output parameter p-type     as character no-undo .
     1737       define buffer buf_pl-gds-attr for ub.pl-gds-attr .
     1738       def var v-format         as character no-undo .
     1739       def var v-label          as character no-undo .
     1740       def var v-user-can-edit  as logical   no-undo .
     1741       def var v-output-display as logical   no-undo .
     1742       def var v-other          as character no-undo .
     1743       run plgdattr-name in this-procedure
     1744         (input  p-code
     1745         ,output p-type
     1746         ,output v-format
     1747         ,output v-label
     1748         ,output v-user-can-edit
     1749         ,output v-output-display
     1750         ,output v-other
     1751         ) no-error .
     1752       if error-status :error then do:
     1753         undo, return error return-value .
     1754       end.
     1755       find first buf_pl-gds-attr no-lock where
     1756                  buf_pl-gds-attr.obj-type  = p-obj-type
     1757              AND buf_pl-gds-attr.obj-code  = p-obj-code
     1758              AND buf_pl-gds-attr.pl-code  = p-pl-code
     1759              AND buf_pl-gds-attr.gds-code  = p-gds-code
     1760              AND buf_pl-gds-attr.attr-code = p-code
     1761         no-error .
     1762       if avail buf_pl-gds-attr then do:
     1763         assign
     1764           p-value =  buf_pl-gds-attr.attr-value
     1765         .
     1766       end.
     1767       else do:
     1768         assign
     1769           p-value = if p-type = 'L':U then "no":U else ""
     1770         .
     1771       end.
     1772     end.
     1773   end procedure.
     1774   procedure plgdattr-write :
     1775     do
     1776     on error undo, return error
     1777     :
     1778       define input parameter p-obj-type like ub.pl-gds-attr.obj-type   no-undo .
     1779       define input parameter p-obj-code like ub.pl-gds-attr.obj-code   no-undo .
     1780       define input parameter p-pl-code  like ub.pl-gds-attr.pl-code    no-undo .
     1781       define input parameter p-gds-code like ub.pl-gds-attr.gds-code   no-undo .
     1782       define input parameter p-code     like ub.pl-gds-attr.attr-code  no-undo .
     1783       define input parameter p-value    like ub.pl-gds-attr.attr-value no-undo .
     1784       define buffer buf_pl-gds-attr for ub.pl-gds-attr .
     1785       define buffer lock_pl-gds-attr for ub.pl-gds-attr .
     1786       def var v-type           as character no-undo .
     1787       def var v-format         as character no-undo .
     1788       def var v-label          as character no-undo .
     1789       def var v-user-can-edit  as logical   no-undo .
     1790       def var v-output-display as logical   no-undo .
     1791       def var v-other          as character no-undo .
     1792       run plgdattr-name in this-procedure
     1793         (input  p-code
     1794         ,output v-type
     1795         ,output v-format
     1796         ,output v-label
     1797         ,output v-user-can-edit
     1798         ,output v-output-display
     1799         ,output v-other
     1800         ) no-error .
     1801       if error-status :error then do:
     1802         undo, return error return-value .
     1803       end.
     1804       find first buf_pl-gds-attr exclusive-lock where
     1805                  buf_pl-gds-attr.obj-type  = p-obj-type
     1806              AND buf_pl-gds-attr.obj-code  = p-obj-code
     1807              AND buf_pl-gds-attr.pl-code  = p-pl-code
     1808              AND buf_pl-gds-attr.gds-code  = p-gds-code
     1809              AND buf_pl-gds-attr.attr-code = p-code no-error .
     1810       if not available buf_pl-gds-attr then do:
     1811         create buf_pl-gds-attr .
     1812         assign
     1813         buf_pl-gds-attr.obj-type  = p-obj-type
     1814         buf_pl-gds-attr.obj-code  = p-obj-code
     1815         buf_pl-gds-attr.pl-code  = p-pl-code
     1816         buf_pl-gds-attr.gds-code  = p-gds-code
     1817         buf_pl-gds-attr.attr-code = p-code
     1818         buf_pl-gds-attr.attr-value = p-value no-error
     1819         .
     1820       end.
     1821       ELSE
     1822       ASSIGN
     1823       buf_pl-gds-attr.attr-value = p-value no-error.
     1824     end.
     1825   end procedure.
     1826   procedure plgdattr-exist :
     1827     do
