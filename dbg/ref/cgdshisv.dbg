     3166   define variable v-chg-fields as character no-undo.
     3167   define variable v-chg-fields-name as character no-undo.
     3168   define variable v-old-fields as character no-undo.
     3169   define variable v-new-fields as character no-undo.
     3170   define variable ii as integer no-undo.
     3171   define variable v-mess as character no-undo .
     3172   define buffer buf_c-gds-hist for ub.c-gds-hist.
     3173   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3174   define SHARED temp-table temp-changes no-undo
     3175   field f_name as character
     3176   field l_name as character
     3177   field v_old as character
     3178   field v_new as character
     3179   field t_name as character
     3180   field num_ as integer
     3181   field uniq-key-rec as character
     3182   field action as integer
     3183   field fNotChange as logical
     3184   index pi is unique primary
     3185   num_
     3186   t_name
     3187   f_name
     3188   index
     3189   Chan
     3190   fnotChange
     3191   t_name
     3192   f_name
     3193   index imain uniq-key-rec
     3194   .
     3195   FUNCTION get-all-fields returns character (p-file-name as character ):
     3196   define variable v-dop as character no-undo .
     3197     find first _file no-lock where _file._file-name = p-file-name no-error .
     3198     if not available _file then return "":U.
     3199     for each _field no-lock where
     3200              _field._file-recid = recid(_file) :
     3201       assign
     3202       v-dop = v-dop + _field._field-name + chr(44)
     3203       .
     3204     end.
     3205     return trim(v-dop).
     3206   END FUNCTION.
     3207   PROCEDURE proc-full-temp-changes :
     3208     define input  parameter p-act-create as logical   no-undo .
     3209     define input  parameter p-act-delete as logical   no-undo .
     3210     define input  parameter p-hst-handle as handle    no-undo .
     3211     define input  parameter p-main-table as character no-undo .
     3212     define input  parameter p-field-list as character no-undo .
     3213     define input  parameter p-label-form as character no-undo .
     3214     define variable h-new-buf         as handle    no-undo .
     3215     define variable h-main-buf        as handle    no-undo .
     3216     define variable h-for-comp        as handle    no-undo .
     3217     define variable v-inform          as character no-undo .
     3218     define variable v-ind             as integer   no-undo .
     3219     define variable v-idx-field-qnty  as integer   no-undo .
     3220     define variable v-num-entries     as integer   no-undo .
     3221     define variable fh                as handle    no-undo .
     3222     define variable fh-main           as handle    no-undo .
     3223     define variable fh-old            as handle    no-undo .
     3224     define variable fh-new            as handle    no-undo .
     3225     define variable v-field-name      as character no-undo .
     3226     define variable v-field-lvl       as character no-undo .
     3227     define variable v-field-form      as character no-undo .
     3228     define variable v-search-exp      as character no-undo .
     3229     define variable v-srch-main       as character no-undo .
     3230     define variable v-word-link       as character no-undo .
     3231     define variable v-av-chip-num     as logical   no-undo .
     3232     define variable v-main-pi-fld-lst as character no-undo .
     3233     define variable v-main-fld-lst    as character no-undo .
     3234     define variable v-delim-list      as character no-undo .
     3235     define variable v-label           as character no-undo .
     3236     define variable v-old-value       as character no-undo case-sensitive.
     3237     define variable v-new-value       as character no-undo case-sensitive.
     3238     define variable v-chg-fields as character no-undo.
     3239     for each temp-changes:
     3240       delete temp-changes.
     3241     end.
     3242     if not p-hst-handle:available then do:
     3243       return .
     3244     end.
     3245     create buffer h-new-buf  for table p-hst-handle .
     3246     create buffer h-main-buf for table p-main-table .
     3247     assign
     3248       v-inform = h-main-buf:index-information(1)
     3249       v-ind    = 2
     3250     .
     3251     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3252     on error undo, return error
     3253     :
     3254       assign
     3255         v-inform = h-main-buf:index-information( v-ind )
     3256         v-ind    = v-ind + 1
     3257       .
     3258     end.
     3259     if v-inform = ?
     3260       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3261       or entry( 3, v-inform, ",":U ) <> "1":U
     3262     then do:
     3263       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     3264     end.
     3265     assign
     3266       v-idx-field-qnty = num-entries( v-inform ) - 4
     3267     .
     3268     if v-idx-field-qnty < 2 then do:
     3269       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     3270     end.
     3271     assign
     3272       v-srch-main   = "where":U
     3273       v-word-link   = "":U
     3274       v-av-chip-num = false
     3275       v-delim-list  = "":U
     3276     .
     3277     do v-ind = 1 to v-idx-field-qnty by 2
     3278     on error undo, return error
     3279     :
     3280       assign
     3281         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     3282         fh                = p-hst-handle:buffer-field( v-field-name )
     3283         fh-main           = h-main-buf:buffer-field( v-field-name )
     3284         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     3285         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     3286       .
     3287       if fh:data-type ="character":U then do:
     3288         assign
     3289           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     3290         .
     3291       end.
     3292       else do:
     3293         assign
     3294           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     3295         .
     3296       end.
     3297       if v-delim-list = "":U then do:
     3298         assign
     3299           v-delim-list = ",":U
     3300         .
     3301       end.
     3302       if v-word-link = "":U then do:
     3303         assign
     3304           v-word-link = "and":U
     3305         .
     3306       end.
     3307     end.
     3308     assign
     3309       v-delim-list  = "":U
     3310     .
     3311     do v-ind = 1 to h-main-buf:num-fields
     3312     on error undo, return error
     3313     :
     3314       assign
     3315         fh-main      = h-main-buf:buffer-field( v-ind )
     3316         v-field-name = fh-main:name
     3317       .
     3318         assign
     3319           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     3320         .
     3321         if v-delim-list = "":U then do:
     3322           assign
     3323             v-delim-list = ",":U
     3324           .
     3325         end.
     3326     end.
     3327     assign
     3328       v-inform = p-hst-handle:index-information(1)
     3329       v-ind    = 2
     3330     .
     3331     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3332     on error undo, return error
     3333     :
     3334       assign
     3335         v-inform = p-hst-handle:index-information( v-ind )
     3336         v-ind    = v-ind + 1
     3337       .
     3338     end.
     3339     if v-inform = ?
     3340       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3341       or entry( 3, v-inform, ",":U ) <> "1":U
     3342     then do:
     3343       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     3344     end.
     3345     assign
     3346       v-idx-field-qnty = num-entries( v-inform ) - 4
     3347     .
     3348     if v-idx-field-qnty < 2 then do:
     3349       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     3350     end.
     3351     assign
     3352       v-search-exp  = "where":U
     3353       v-word-link   = "":U
     3354       v-av-chip-num = false
     3355     .
     3356     do v-ind = 1 to v-idx-field-qnty by 2
     3357     on error undo, return error
     3358     :
     3359       assign
     3360         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3361         fh           = p-hst-handle:buffer-field( v-field-name )
     3362         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     3363       .
     3364       if v-field-name = "chip-num":U then do:
     3365         assign
     3366           v-search-exp  = substitute( "&1 >", v-search-exp )
     3367           v-av-chip-num = true
     3368         .
     3369       end.
     3370       else do:
     3371         assign
     3372           v-search-exp = substitute( "&1 =", v-search-exp )
     3373         .
     3374       end.
     3375       if fh:data-type ="character":U then do:
     3376         assign
     3377           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     3378         .
     3379       end.
     3380       else do:
     3381         assign
     3382           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     3383         .
     3384       end.
     3385       if v-word-link = "":U then do:
     3386         assign
     3387           v-word-link = "and":U
     3388         .
     3389       end.
     3390     end.
     3391     if v-av-chip-num = false then do:
     3392       message
     3393         vss-workfile vss-revision vss-description skip
     3394         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     3395         "Использование данной процедуры невозможно!" skip
     3396         view-as alert-box error .
     3397       return error .
     3398     end.
     3399     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     3400     if not h-new-buf:available then do:
     3401       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     3402       if not h-main-buf:available then do:
     3403         assign
     3404           h-for-comp = ?
     3405         .
     3406       end.
     3407       else do:
     3408         assign
     3409           h-for-comp = h-main-buf
     3410         .
     3411       end.
     3412     end.
     3413     else do:
     3414       assign
     3415         h-for-comp = h-new-buf
     3416       .
     3417     end.
     3418     assign
     3419       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     3420     .
     3421     do v-ind = 1 to v-num-entries
     3422     on error undo, return error return-value
     3423     :
     3424       assign
     3425         v-field-name = entry( v-ind, v-main-fld-lst )
     3426         fh-old       = p-hst-handle:buffer-field( v-field-name )
     3427         v-old-value  = fh-old:buffer-value()
     3428         v-label      = trim( fh-old:label )
     3429       .
     3430       if ( trim( p-field-list ) <> "":U
     3431            and lookup( v-field-name, p-field-list ) > 0
     3432          )
     3433          or trim( p-field-list ) = "":U
     3434       then do:
     3435         if h-for-comp <> ? then do:
     3436           assign
     3437             fh-new      = h-for-comp:buffer-field( v-field-name )
     3438             v-new-value = fh-new:buffer-value()
     3439           .
     3440         end.
     3441         else do:
     3442           assign
     3443             v-new-value = "":U
     3444           .
     3445         end.
     3446           if p-act-create = true then do:
     3447             assign
     3448               v-old-value = "":U
     3449             .
     3450           end.
     3451           if p-act-delete = true then do:
     3452             assign
     3453               v-new-value = "":U
     3454             .
     3455           end.
     3456         if v-old-value <> v-new-value
     3457         then do:
     3458           create temp-changes.
     3459           assign
     3460             temp-changes.t_name = p-main-table
     3461             temp-changes.f_name = v-field-name
     3462             temp-changes.l_name = replace( v-label, "&":U, "":U )
     3463             temp-changes.v_old  = trim( v-old-value )
     3464             temp-changes.v_new  = trim( v-new-value )
     3465             temp-changes.num_   = 0
     3466             temp-changes.fNotChange = v-old-value eq v-new-value
     3467           .
     3468         end.
     3469       end.
     3470     end.
     3471     assign
     3472       v-num-entries = num-entries( p-label-form, chr(8) )
     3473     .
     3474     do v-ind = 1 to v-num-entries
     3475     on error undo, return error return-value
     3476     :
     3477       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     3478         assign
     3479           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3480           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3481           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3482         .
     3483         find first temp-changes
     3484           where temp-changes.f_name = v-field-name
     3485           no-error .
     3486         if available temp-changes then do:
     3487           if trim( v-field-lvl ) <> "":U then do:
     3488             assign
     3489               temp-changes.l_name = v-field-lvl
     3490             .
     3491           end.
     3492           if trim( v-field-form ) <> "":U then do:
     3493             assign
     3494               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     3495             .
     3496             if h-for-comp <> ? then do:
     3497               assign
     3498                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     3499               .
     3500             end.
     3501           end.
     3502         end.
     3503       end.
     3504       else do:
     3505         message
     3506           vss-workfile vss-revision vss-description skip
     3507           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     3508           substitute( "список для поля '&1': '&2'"
     3509                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     3510                       ,entry( v-ind, p-label-form, chr(8) )
     3511                     ) skip
     3512           substitute( "полный список: &2", p-label-form ) skip
     3513           view-as alert-box error .
     3514       end.
     3515     end.
     3516     delete object h-new-buf .
     3517     delete object h-main-buf .
     3518   END PROCEDURE.
     3519   find first buf_c-gds-hist no-lock where
     3520             buf_c-gds-hist.gds-code = p-gds-code
     3521         AND buf_c-gds-hist.chip-num = p-chip-num
     3522         AND buf_c-gds-hist.corr-user-db-num = p-corr-user-db-num
     3523         AND buf_c-gds-hist.obj-type = p-obj-type
     3524         AND buf_c-gds-hist.obj-code = p-obj-code
     3525         AND buf_c-gds-hist.subject  = p-subject no-error .
     3526   if not available buf_c-gds-hist then do:
     3527     return error .
     3528   end.
     3529   CASE p-subject:
     3530     when 'goods':U then do:
     3531       run goods-proc in this-procedure(output p-description) no-error .
     3532     end.
     3533     when 'gds-obj-attr':U then do:
     3534       run gds-obj-attr-proc in this-procedure(output p-description) no-error .
     3535     end.
     3536     when 'gds-host-attr':U then do:
     3537       run gds-host-attr-proc in this-procedure(output p-description) no-error .
     3538     end.
     3539     when 'goods-attr':U then do:
     3540       run goods-attr-proc in this-procedure(output p-description) no-error  .
     3541     end.
     3542     when 'fbr-gds-obj':U then do:
     3543       run fbr-gds-obj-proc in this-procedure(output p-description) no-error  .
     3544     end.
     3545     when 's-coeff':U then do:
     3546       run s-coeff-proc in this-procedure(output p-description) no-error  .
     3547     end.
     3548     when 'prod-bc':U then do:
     3549       run prod-bc-proc in this-procedure(output p-description) no-error  .
     3550     end.
     3551     when 'bar-code':U then do:
     3552       run bar-code-proc in this-procedure(output p-description) no-error  .
     3553     end.
     3554     when 'bar-code-attr':U then do:
     3555       run bar-code-attr-proc in this-procedure(output p-description) no-error  .
     3556     end.
     3557     when 'bar-code-obj-attr':U then do:
     3558       run bar-code-obj-attr-proc in this-procedure(output p-description) no-error  .
     3559     end.
     3560     when 'varianty-delivery-gds-obj':U then do:
     3561       run varianty-delivery-gds-obj-proc in this-procedure(output p-description) no-error  .
     3562     end.
     3563     when 'gds-season':U then do:
     3564       run gds-season-proc in this-procedure(output p-description) no-error  .
     3565     end.
     3566     when 'tax-rate-gds':U then do:
     3567       run tax-rate-gds-proc in this-procedure(output p-description) no-error  .
     3568     end.
     3569     when 'assortment-matrix-goods':U then do:
     3570       run ass-matr-proc in this-procedure(output p-description) no-error  .
     3571     end.
     3572     when 'gds-obj-prop':U then do:
     3573       run izt-proc in this-procedure(output p-description) no-error  .
     3574     end.
     3575     when 'pl-gds':U then do:
     3576       run pl-gds-proc in this-procedure(output p-description) no-error  .
     3577     end.
     3578     when 'pl-gds-attr':U then do:
     3579       run pl-gds-attr-proc in this-procedure(output p-description) no-error  .
     3580     end.
     3581     when 'pl-gds-pump':U then do:
     3582       run pl-gds-pump-proc in this-procedure(output p-description) no-error  .
     3583     end.
     3584     when 'dis-gds-rule':U then do:
     3585       run dis-gds-rule-proc in this-procedure(output p-description) no-error  .
     3586     end.
     3587     when 'ext-artic':U then do:
     3588       run ext-artic-proc in this-procedure(output p-description) no-error  .
     3589     end.
     3590     when 'sert-join':U then do:
     3591       run sert-join-proc in this-procedure(output p-description) no-error  .
     3592     end.
     3593     when 'recipe':U then do:
     3594       run recipe-proc in this-procedure(output p-description) no-error  .
     3595     end.
     3596     when 'recipe-gds':U then do:
     3597       run recipe-gds-proc in this-procedure(output p-description) no-error  .
     3598     end.
     3599     when 'ext-classif':U then do:
     3600       run ext-classif-proc in this-procedure(output p-description) no-error  .
     3601     end.
     3602     when 'gds-obj-prop-attr':U then do:
     3603       run gds-obj-prop-attr-proc in this-procedure(output p-description) no-error .
     3604     end.
     3605     when 'gds-obj':U then do:
     3606       run gds-obj-ref-proc in this-procedure(output p-description) no-error  .
     3607     end.
     3608   END CASE.
     3609   if error-status:error then do:
     3610     return error .
     3611   end.
     3612   procedure goods-proc :
     3613   define output parameter p-description as character no-undo .
     3614   define buffer current_c-goods for ub.c-goods  .
     3615   do
     3616   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3617   :
     3618     find first current_c-goods no-lock where
     3619                 current_c-goods.gds-code = p-gds-code
     3620             AND current_c-goods.chip-num = p-chip-num
     3621             AND current_c-goods.corr-user-db-num = p-corr-user-db-num no-error .
     3622     if not avail current_c-goods then do:
     3623       v-mess = "Неверная ссылка на c-goods в таблице c-gds-hist".
     3624       run err-mess in this-procedure ( input-output v-mess).
     3625       return error v-mess.
     3626     end.
     3627   define variable v-label-param as character no-undo .
     3628   v-label-param =
     3629     "prod-type" + chr(4) + "Тип производителя" + chr(4) + "" + chr(8)
     3630    + "prod-code" + chr(4) + "Производитель" + chr(4) + "" + chr(8)
     3631    + "artic" + chr(4) + "Артикул" + chr(4) + "" + chr(8)
     3632    + "gds-name" + chr(4) + "Название товара" + chr(4) + "" + chr(8)
     3633    + "unit-base" + chr(4) + "Основная единица измер" + chr(4) + "" + chr(8)
     3634    + "prt-root" + chr(4) + "Корень шкалы" + chr(4) + "" + chr(8)
     3635    + "grp-code" + chr(4) + "Код группы" + chr(4) + "" + chr(8)
     3636    + "unit-cli" + chr(4) + "Единица измерения пост" + chr(4) + "" + chr(8)
     3637    + "cli-base-rate" + chr(4) + "Коэффициент" + chr(4) + "" + chr(8)
     3638    + "calc-method" + chr(4) + "Способ расчета" + chr(4) + "" + chr(8)
     3639    + "increase-pc" + chr(4) + "Процент наценки" + chr(4) + "" + chr(8)
     3640    + "stts" + chr(4) + "Статус" + chr(4) + "" + chr(8)
     3641    + "qnty-cart" + chr(4) + "Кол. в упак." + chr(4) + "" + chr(8)
     3642    + "wt-cart" + chr(4) + "Вес упаковки" + chr(4) + "" + chr(8)
     3643    + "ms-cart" + chr(4) + "Об'ем упаковки" + chr(4) + "" + chr(8)
     3644    + "engl-name" + chr(4) + "Название англ." + chr(4) + "" + chr(8)
     3645    + "grp-name" + chr(4) + "Название группы" + chr(4) + "" + chr(8)
     3646    + "gds-type" + chr(4) + "Тип" + chr(4) + "" + chr(8)
     3647    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     3648    + "okdp" + chr(4) + "ОКДП" + chr(4) + "" + chr(8)
     3649    + "destin" + chr(4) + "Назначение" + chr(4) + "" + chr(8)
     3650    + "attrib" + chr(4) + "Характеристики" + chr(4) + "" + chr(8)
     3651    + "user-rule" + chr(4) + "Правила эксплутации" + chr(4) + "" + chr(8)
     3652    + "sert" + chr(4) + "Сертификация" + chr(4) + "" + chr(8)
     3653    + "struct" + chr(4) + "Состав (комплектность)" + chr(4) + "" + chr(8)
     3654    + "sort" + chr(4) + "Сорт" + chr(4) + "" + chr(8)
     3655    + "deadline" + chr(4) + "Срок хранения" + chr(4) + "" + chr(8)
     3656    + "negative-rest" + chr(4) + "Разр. отриц.остатки" + chr(4) + "" + chr(8)
     3657    + "cost-calc" + chr(4) + "Расчет учетных цен" + chr(4) + "" + chr(8)
     3658    + "unit-cst" + chr(4) + "Таможенная единица изм" + chr(4) + "" + chr(8)
     3659    + "cst-base-rate" + chr(4) + "Коэффициент" + chr(4) + "" + chr(8)
     3660    + "TNVED" + chr(4) + "Код ТНВЭД" + chr(4) + "" + chr(8)
     3661    + "min-stock" + chr(4) + "Мин. остаток" + chr(4) + "" + chr(8)
     3662    + "nationality" + chr(4) + "Национальность" + chr(4) + "" + chr(8)
     3663    + "label-name" + chr(4) + "Название на ценнике" + chr(4) + "" + chr(8)
     3664    + "alpha1" + chr(4) + "Код страны" + chr(4) + "" + chr(8)
     3665    + "normal-wastage" + chr(4) + "Норма естественной убыли" + chr(4) + "" + chr(8)
     3666    + "normal-waste" + chr(4) + "Норма отходов" + chr(4) + "" + chr(8)
     3667    + "chk-name" + chr(4) + "Название на чеке" + chr(4) + "" + chr(8)
     3668    + "min-rate" + chr(4) + "Мин. кол-во дробн./шт" + chr(4) + "" + chr(8)
     3669    + "max-rate" + chr(4) + "Макс. кол-во дробн./шт" + chr(4) + "" + chr(8)
     3670    + "cr-db-num" + chr(4) + "Номер БД где создан" + chr(4) + "" + chr(8)
     3671    + "cond-keep-code" + chr(4) + "Код условий хранения" + chr(4) + "" + chr(8)
     3672    + "wt-cart" + chr(4) + "Вес штуки" + chr(4) + "" + chr(8)
     3673    + "ms-cart" + chr(4) + "Объем штуки" + chr(4) + ""  .
     3674    run proc-full-temp-changes in this-procedure (
     3675                                                input  (buf_c-gds-hist.action = integer('1':U))
     3676                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     3677                                               ,input  buffer current_c-goods:handle
     3678                                               ,input  'goods':U
     3679                                               ,input  "prod-type,prod-code,artic,gds-name,unit-base,prt-root,"  + "grp-code,unit-cli,cli-base-rate,calc-method,increase-pc,stts,qnty-cart,wt-cart,ms-cart," + "engl-name,grp-name,gds-type,PS.okdp,destin,attrib,user-rule,sert,struct," + "sort,deadline,negative-rest,cost-calc,unit-cst,cst-base-rate,TNVED,min-stock,nationality,label-name," + "alpha1,normal-wastage,normal-waste,chk-name,min-rate,max-rate,cr-db-num,cond-keep-code,wt-cart,ms-cart"
     3680                                               ,input  v-label-param).
     3681   end.
     3682   end procedure.
     3683   procedure gds-obj-attr-proc :
     3684   define output parameter p-description as character no-undo .
     3685   define variable v-tooltip as character no-undo .
     3686   define variable v-label as character no-undo .
     3687   define buffer current_c-gds-obj-attr for ub.c-gds-obj-attr  .
     3688   do
     3689   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3690   :
     3691   find first current_c-gds-obj-attr no-lock where
     3692               current_c-gds-obj-attr.gds-code = p-gds-code
     3693           AND current_c-gds-obj-attr.chip-num = p-chip-num
     3694           AND current_c-gds-obj-attr.corr-user-db-num = p-corr-user-db-num
     3695           AND current_c-gds-obj-attr.obj-type = p-obj-type
     3696           AND current_c-gds-obj-attr.obj-code = p-obj-code
     3697           AND current_c-gds-obj-attr.attr-code = buf_c-gds-hist.attr-code
     3698           no-error .
     3699   define variable v-label-param as character no-undo .
     3700   v-label-param =
     3701     "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     3702    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     3703    + "attr-code" + chr(4) + "Атрибут" + chr(4) + "" + chr(8)
     3704    + "gds-code" + chr(4) + "Код товара" + chr(4) + "" + chr(8)
     3705    + "attr-value" + chr(4) + "Значение атрибута" + chr(4) + ""  .
     3706    run proc-full-temp-changes in this-procedure (
     3707                                                input  (buf_c-gds-hist.action = integer('1':U))
     3708                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     3709                                               ,input  buffer current_c-gds-obj-attr:handle
     3710                                               ,input  'gds-obj-attr':U
     3711                                               ,input  "obj-type,obj-code,attr-code,gds-code,attr-value"
     3712                                               ,input  v-label-param).
     3713       run gdsoattr-tooltip in this-procedure (
     3714                   input  current_c-gds-obj-attr.attr-code
     3715                   ,output v-tooltip
     3716                   ,output v-label
     3717                   ) no-error .
