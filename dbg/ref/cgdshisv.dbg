        1   block-level on error undo, throw.
        2   define input parameter p-gds-code like ub.c-gds-hist.gds-code no-undo .
        3   define input parameter p-chip-num like ub.c-gds-hist.chip-num no-undo .
        4   define input parameter p-corr-user-db-num like ub.c-gds-hist.corr-user-db-num no-undo .
