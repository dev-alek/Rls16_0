     4146   procedure tax-rate-gds-proc :
     4147   define output parameter p-description as character no-undo .
     4148   define variable v-tooltip as character no-undo .
     4149   define variable v-label as character no-undo .
     4150   define variable jj as integer no-undo .
     4151   define variable v-field-label as character no-undo .
     4152   define variable v-field-name as character no-undo .
     4153   define variable v-old-rate-code like ub.tax-rate-gds.rate-code no-undo .
     4154   define variable v-old-fact-order like ub.tax-rate-gds.fact-order no-undo .
     4155   define variable v-old-fact-date as date no-undo .
     4156   define variable v-new-rate-code like ub.tax-rate-gds.rate-code no-undo .
     4157   define variable v-new-fact-order like ub.tax-rate-gds.fact-order no-undo .
     4158   define variable v-new-fact-date as date no-undo .
     4159   define buffer buf_next_tax-rate-gds for ub.tax-rate-gds.
     4160   define buffer buf_tax for ub.tax.
     4161   do
     4162   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4163   :
     4164       find first buf_tax no-lock where
     4165                 buf_tax.tax-code = buf_c-gds-hist.tax-code no-error .
     4166       if available buf_tax then do:
     4167         assign
     4168         p-description = buf_tax.tax-name.
     4169       end.
     4170       assign
     4171       v-old-rate-code = buf_c-gds-hist.rate-code
     4172       v-old-fact-order = buf_c-gds-hist.fact-order
     4173       .
     4174       run factord-to-date in this-procedure (
     4175                                               input v-old-fact-order
     4176                                              ,output v-old-fact-date) no-error .
     4177       assign
     4178       v-chg-fields = "rate-code,fact-date"
     4179       .
     4180       find first buf_next_tax-rate-gds no-lock where
     4181               buf_next_tax-rate-gds.gds-code = p-gds-code
     4182           AND buf_next_tax-rate-gds.host-code        = 0
     4183           AND buf_next_tax-rate-gds.obj-type         = "":U
     4184           AND buf_next_tax-rate-gds.obj-code         = 0
     4185           AND buf_next_tax-rate-gds.tax-code         = buf_c-gds-hist.tax-code
     4186           AND buf_next_tax-rate-gds.fact-order       > buf_c-gds-hist.fact-order no-error .
     4187       if available buf_next_tax-rate-gds then do:
     4188         assign
     4189         v-new-rate-code = buf_next_tax-rate-gds.rate-code
     4190         v-new-fact-order = buf_next_tax-rate-gds.fact-order
     4191         .
     4192         run factord-to-date in this-procedure (
     4193                                                 input v-new-fact-order
     4194                                               ,output v-new-fact-date) no-error .
     4195       end.
     4196     _ii:
     4197     do ii = 1 to num-entries(v-chg-fields):
     4198       assign
     4199       v-field-name = entry(ii, v-chg-fields)
     4200       jj = lookup(v-field-name, "rate-code,fact-date").
     4201       if jj = 0 then next _ii.
     4202       assign
     4203       v-field-label = entry(jj, "Код ставки,Начало действия")
     4204       .
     4205       create temp-changes.
     4206       assign
     4207       temp-changes.f_name = v-field-name
     4208       temp-changes.l_name = v-field-label
     4209       temp-changes.v_old = (if temp-changes.f_name = "rate-code"
     4210                             then string(v-old-rate-code)
     4211                             else string(v-old-fact-date, "99/99/9999")
     4212                             )
     4213       temp-changes.v_new = (if temp-changes.f_name = "rate-code"
     4214                             then string(v-new-rate-code)
     4215                             else string(v-new-fact-date, "99/99/9999")
     4216                             )
     4217       .
     4218     end.
     4219   end.
     4220   end procedure.
