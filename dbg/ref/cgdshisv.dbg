     2874   end procedure.
     2875   procedure bc-oattr_value :
     2876     define input  parameter p-b-code as integer   no-undo .
     2877     define input  parameter p-code     as character no-undo .
     2878     define input  parameter p-obj-type as character no-undo .
     2879     define input  parameter p-obj-code as integer   no-undo .
     2880     define output parameter p-value    as character no-undo .
     2881     define output parameter p-type     as character no-undo .
     2882     do
     2883     on error undo, return error
     2884     :
