     1866   procedure plgdattr-delete :
     1867     do
     1868     on error undo, return error
     1869     :
     1870       define input parameter p-obj-type like ub.pl-gds-attr.obj-type   no-undo .
     1871       define input parameter p-obj-code like ub.pl-gds-attr.obj-code   no-undo .
     1872       define input parameter p-pl-code  like ub.pl-gds-attr.pl-code    no-undo .
     1873       define input parameter p-gds-code like ub.pl-gds-attr.gds-code   no-undo .
     1874       define input parameter p-code     like ub.pl-gds-attr.attr-code  no-undo .
     1875       define output parameter p-deleted  as logical no-undo .
     1876       define buffer buf_pl-gds-attr for ub.pl-gds-attr .
     1877       def var v-type           as character no-undo .
     1878       def var v-format         as character no-undo .
     1879       def var v-label          as character no-undo .
     1880       def var v-user-can-edit  as logical   no-undo .
     1881       def var v-output-display as logical   no-undo .
     1882       def var v-other          as character no-undo .
     1883       run plgdattr-name in this-procedure
     1884         (input  p-code
     1885         ,output v-type
     1886         ,output v-format
     1887         ,output v-label
     1888         ,output v-user-can-edit
     1889         ,output v-output-display
     1890         ,output v-other
     1891         ) no-error .
     1892       if error-status :error then do:
     1893         undo, return error return-value .
     1894       end.
     1895       find first buf_pl-gds-attr exclusive-lock where
     1896                  buf_pl-gds-attr.obj-type  = p-obj-type
     1897              AND buf_pl-gds-attr.obj-code  = p-obj-code
     1898              AND buf_pl-gds-attr.gds-code  = p-gds-code
     1899              AND buf_pl-gds-attr.pl-code  = p-pl-code
     1900              AND buf_pl-gds-attr.attr-code = p-code no-error .
     1901       if not available buf_pl-gds-attr then do:
     1902         P-DELETED = NO.
     1903       end.
     1904       ELSE DO:
     1905          delete buf_pl-gds-attr.
     1906          P-DELETED = YES.
     1907       END.
     1908     end.
     1909   end procedure.
     1910   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1911   procedure factord :
     1912     define input  parameter p-fact-date            as date    no-undo .
     1913     define input  parameter p-fact-time            as integer no-undo .
     1914     define input  parameter p-fact-num             as integer no-undo .
     1915     define input  parameter p-shift-date           as date    no-undo .
     1916     define input  parameter p-shift-num            as integer no-undo .
     1917     define input  parameter p-shift-on             as logical no-undo .
     1918     define output parameter p-fact-order           as decimal no-undo .
     1919     define output parameter p-shift-end-fact-order as decimal no-undo .
     1920     define output parameter p-day-end-fact-order   as decimal no-undo .
     1921     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1922     if p-fact-date = ?
     1923     then do:
     1924       return error "Не указана фактическая дата" .
     1925     end.
     1926     define variable v-fact-date-num as integer no-undo .
     1927     assign
     1928       v-fact-date-num = integer(p-fact-date)
     1929     .
     1930     if p-fact-num = ?
     1931     or p-fact-num = 0
     1932     then do:
     1933       return error "Не задан p-fact-num " + string(p-fact-num) .
     1934     end.
     1935     if p-fact-num < 0
     1936     then do:
     1937       return error "Отрицательный fact-num " + string(p-fact-num) .
     1938     end.
     1939     if p-fact-num >= 100000000
     1940     then do:
     1941       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1942     end.
     1943     if p-shift-on = true
     1944     then do:
     1945       if p-shift-date = ?
     1946       then do:
     1947         return error "Не задана дата смены" .
     1948       end.
     1949       if p-shift-num = ?
     1950       or p-shift-num = 0
     1951       then do:
     1952         return error "Не задан номер смены" .
     1953       end.
     1954     end.
     1955     else do:
     1956       assign
     1957         p-shift-date = p-fact-date
     1958         p-shift-num  = 24
     1959       .
     1960     end.
     1961     define variable v-shift-offset as integer no-undo .
     1962     if p-shift-date = p-fact-date
     1963     then do:
     1964       assign
     1965         v-shift-offset = 1
     1966       .
     1967     end.
     1968     if p-shift-date < p-fact-date
     1969     then do:
     1970       assign
     1971         v-shift-offset = 0
     1972       .
     1973     end.
     1974     if p-shift-date > p-fact-date
     1975     then do:
     1976       message
     1977         vss-workfile vss-revision vss-description skip
     1978         "Неправильная дата закрытия смены" skip
     1979         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1980         view-as alert-box error .
     1981       undo, return error
     1982         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1983           ,string(p-fact-date, '99/99/9999':U)
     1984           ,string(p-shift-date, '99/99/9999':U)
     1985           )
     1986       .
     1987     end.
     1988     if p-shift-num < 1
     1989     or p-shift-num > 24
     1990     then do:
     1991       message
     1992         vss-workfile vss-revision vss-description skip
     1993         "Неправильный номер смены" skip
     1994         "p-shift-num" p-shift-num skip
     1995         view-as alert-box error .
     1996       undo, return error return-value .
     1997     end.
     1998     assign
     1999       p-fact-order           = v-fact-date-num
     2000                              + v-shift-offset * 0.5
     2001                              + p-shift-num    * 0.02 - 0.01
     2002                              + p-fact-num     * 0.0000000001
     2003       p-shift-end-fact-order = v-fact-date-num
     2004                              + v-shift-offset * 0.5
     2005                              + p-shift-num    * 0.02
     2006       p-day-end-fact-order   = v-fact-date-num
     2007                              + 0.99
     2008     .
     2009     if p-fact-order           <= v-fact-date-num
     2010     or p-shift-end-fact-order <= v-fact-date-num
     2011     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2012     or p-shift-end-fact-order >= p-day-end-fact-order
     2013     then do:
     2014       message
     2015         vss-workfile vss-revision vss-description skip
     2016         "Внутренняя ошибка при генерации фактического номера" skip
     2017         "p-fact-date"            p-fact-date            skip
     2018         "p-fact-time"            p-fact-time            skip
     2019         "p-fact-num"             p-fact-num             skip
     2020         "p-shift-date"           p-shift-date           skip
     2021         "p-shift-num"            p-shift-num            skip
     2022         "p-shift-on"             p-shift-on             skip
     2023         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2024         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2025         "v-fact-date-num"        v-fact-date-num        skip
     2026         view-as alert-box error .
     2027       undo, return error return-value .
     2028     end.
     2029   end procedure.
     2030   procedure day-begin-fact-order :
     2031     define input  parameter p-fact-date            as date    no-undo .
     2032     define output parameter p-day-begin-fact-order as decimal no-undo .
     2033     do
     2034     on error undo, return error return-value
     2035     :
     2036       if p-fact-date = ?
     2037       then do:
     2038         assign
     2039           p-day-begin-fact-order = 0
     2040         .
     2041       end.
     2042       else do:
     2043         assign
     2044           p-day-begin-fact-order = integer(p-fact-date)
     2045         .
     2046       end.
     2047     end.
     2048   end procedure.
     2049   procedure factord-max-fact-order :
     2050     define output parameter p-max-fact-order as decimal   no-undo .
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054       run day-begin-fact-order in this-procedure
     2055         (input  date(1, 1, 5000)
     2056         ,output p-max-fact-order
     2057         ) .
     2058     end.
     2059   end procedure.
     2060   procedure factord-cut-archive :
     2061     define input  parameter p-obj-type             as character no-undo .
     2062     define input  parameter p-obj-code             as integer   no-undo .
     2063     define input  parameter p-fact-date            as date      no-undo .
     2064     define output parameter p-shift-on             as logical   no-undo .
     2065     define output parameter p-shift-date           as date      no-undo .
     2066     define output parameter p-shift-num            as integer   no-undo .
     2067     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2068     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2069     define variable v-fact-order as decimal   no-undo .
     2070     define buffer buf_shift-obj for ub.shift-obj .
     2071     do
     2072     on error undo, return error return-value
     2073     :
     2074   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2075   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2076     (input  p-obj-type
     2077     ,input  p-obj-code
     2078     ,input  'shift-on=request'
     2079     ,output p-shift-on
     2080     ) no-error .
     2081       if error-status :error
     2082       then do:
     2083         message
     2084           vss-workfile vss-revision vss-description skip
     2085           "Ошибка при определении атрибута объекта" skip
     2086           "Объект" p-obj-type p-obj-code skip
     2087           error-status :get-message(1) skip
     2088           return-value skip
     2089           view-as alert-box error .
     2090         undo, return error return-value .
     2091       end.
     2092       if p-shift-on = false
     2093       then do:
     2094         assign
     2095           p-shift-date               = ?
     2096           p-shift-num                = 0
     2097         .
     2098       end.
     2099       else do:
     2100         find first buf_shift-obj share-lock
     2101           where buf_shift-obj.obj-type   = p-obj-type
     2102             and buf_shift-obj.obj-code   = p-obj-code
     2103             and buf_shift-obj.shift-date > p-fact-date
     2104           use-index pi
     2105           no-error .
     2106         if not available buf_shift-obj
     2107         or buf_shift-obj.status_ <> 'зкр':U
     2108         then do:
     2109           message
     2110             vss-workfile vss-revision vss-description skip
     2111             "Невозможно вычислить последнюю смену" skip
     2112             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2113             "Объект" p-obj-type p-obj-code skip
     2114             "Дата" p-fact-date skip
     2115             view-as alert-box error .
     2116           undo, return error return-value .
     2117         end.
     2118         find last buf_shift-obj share-lock
     2119           where buf_shift-obj.obj-type = p-obj-type
     2120             and buf_shift-obj.obj-code = p-obj-code
     2121             and buf_shift-obj.shift-date <= p-fact-date
     2122           use-index pi
     2123           no-error .
     2124         if available buf_shift-obj
     2125         then do:
     2126           if  buf_shift-obj.status_ = 'зкр':U
     2127           then do:
     2128             assign
     2129               p-shift-date = buf_shift-obj.shift-date
     2130               p-shift-num  = buf_shift-obj.shift-num
     2131             .
     2132           end.
     2133           else do:
     2134             message
     2135               vss-workfile vss-revision vss-description skip
     2136               "Невозможно вычислить последнюю смену" skip
     2137               "Статус смены отличен от статуса" 'зкр':U skip
     2138               "Объект" p-obj-type p-obj-code skip
     2139               "Дата" p-fact-date skip
     2140               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2141               view-as alert-box error .
     2142             undo, return error return-value .
     2143           end.
     2144         end.
     2145         else do:
     2146           assign
     2147             p-shift-date = p-fact-date - 1
     2148             p-shift-num  = 1
     2149           .
     2150         end.
     2151       end.
     2152       run factord in this-procedure
     2153         (input  p-fact-date
     2154         ,input  1
     2155         ,input  1
     2156         ,input  p-shift-date
     2157         ,input  p-shift-num
     2158         ,input  p-shift-on
     2159         ,output v-fact-order
     2160         ,output p-shift-end-fact-order
     2161         ,output p-day-end-fact-order
     2162         ) no-error .
     2163       if error-status :error
     2164       then do:
     2165         message
     2166           vss-workfile vss-revision vss-description skip
     2167           "Ошибка при вызове процедуры factord"
     2168           error-status :get-message(1) skip
     2169           return-value skip
     2170           view-as alert-box error .
     2171         undo, return error return-value .
     2172       end.
     2173     end.
     2174   end procedure.
     2175   procedure factord-lock-shift :
     2176     define input  parameter p-obj-type  as character no-undo .
     2177     define input  parameter p-obj-code  as integer   no-undo .
     2178     define input  parameter p-fact-date as date      no-undo .
     2179     define parameter buffer buf_shift-obj for ub.shift-obj .
     2180     define variable v-shift-on      as logical   no-undo .
     2181     define variable v-extra-message as character no-undo .
     2182     define variable v-error as character no-undo .
     2183     do
     2184     on error undo, return error return-value
     2185     :
     2186   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2187   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2188     (input  p-obj-type
     2189     ,input  p-obj-code
     2190     ,input  'shift-on=request'
     2191     ,output v-shift-on
     2192     ) no-error .
     2193       if error-status :error
     2194       then do:
     2195         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2196         undo, return error v-error .
     2197       end.
     2198       if v-shift-on = true
     2199       then do:
     2200         find first buf_shift-obj share-lock
     2201           where buf_shift-obj.obj-type   = p-obj-type
     2202             and buf_shift-obj.obj-code   = p-obj-code
     2203             and buf_shift-obj.shift-date > p-fact-date
     2204           use-index pi
     2205           no-error .
     2206         if not available buf_shift-obj
     2207         or buf_shift-obj.status_ <> 'зкр':U
     2208         then do:
     2209           find last buf_shift-obj
     2210             where buf_shift-obj.obj-type = p-obj-type
     2211               and buf_shift-obj.obj-code = p-obj-code
     2212               and buf_shift-obj.status_  = 'зкр':U
     2213             use-index stts
     2214             no-error .
     2215           if available buf_shift-obj
     2216           then do:
     2217             assign
     2218               v-extra-message =
     2219                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2220                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2221                               )
     2222             .
     2223           end.
     2224           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2225           undo, return error v-error .
     2226         end.
     2227       end.
     2228     end.
     2229   end procedure.
     2230   procedure factord-end-day :
     2231     define input  parameter p-fact-date            as date    no-undo .
     2232     define output parameter p-day-end-fact-order   as decimal no-undo .
     2233     do
     2234     on error undo, return error return-value
     2235     :
     2236       if p-fact-date = ?
     2237       then do:
     2238         return error "Не указана фактическая дата" .
     2239       end.
     2240       assign
     2241         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2242       .
     2243     end.
     2244   end procedure.
     2245   procedure factord-to-date :
     2246     define input  parameter p-fact-order as decimal no-undo .
     2247     define output parameter p-fact-date  as date    no-undo .
     2248     define variable v-ref-date  as date      no-undo .
     2249     define variable v-ref-delta as integer   no-undo .
     2250     do
     2251     on error undo, return error return-value
     2252     :
     2253       if p-fact-order = ?
     2254       or p-fact-order = 0
     2255       then do:
     2256         return error "Не указан fact-order" .
     2257       end.
     2258       assign
     2259         v-ref-date  = date(1, 1, 2000)
     2260       .
     2261       assign
     2262         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2263       .
     2264       assign
     2265         p-fact-date = v-ref-date + v-ref-delta
     2266       .
     2267     end.
     2268   end procedure.
     2269   procedure factord-to-fact-num :
     2270     define input  parameter p-fact-order as decimal no-undo .
     2271     define output parameter p-fact-num   as integer no-undo .
     2272     define variable v-fact-order-trunc as decimal no-undo .
     2273     do
     2274     on error undo, return error return-value
     2275     :
     2276       if p-fact-order = ?
     2277       or p-fact-order = 0
     2278       then do:
     2279         return error "Не указан fact-order" .
     2280       end.
     2281       assign
     2282        v-fact-order-trunc = truncate(p-fact-order, 2)
     2283       .
     2284       assign
     2285         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2286       .
     2287     end.
     2288   end procedure.
     2289   procedure factord-to-shift-num :
     2290     define input  parameter p-fact-order as decimal no-undo .
     2291     define output parameter p-shift-num   as integer no-undo .
     2292     define variable  p-shift-numd  as decimal   no-undo .
     2293     define variable v-fact-order-trunc as decimal no-undo .
     2294     do
     2295     on error undo, return error return-value
     2296     :
     2297       if p-fact-order = ?
     2298       or p-fact-order = 0
     2299       then do:
     2300         return error "Не указан fact-order" .
     2301       end.
     2302       assign
     2303        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2304       .
     2305       if v-fact-order-trunc < 0.5 then do:
     2306         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2307       end.
     2308       assign
     2309         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2310         .
     2311        assign
     2312         p-shift-num = truncate (p-shift-numd , 0)
     2313       .
     2314     end.
     2315   end procedure.
     2316   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2317   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2318   procedure gen-key-rec :
     2319     define input  parameter p-tbl-name    as character no-undo.
     2320     define input  parameter p-bh_tbl-name as handle    no-undo.
     2321     define output parameter p-key-rec     as character no-undo.
     2322     do
     2323     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2324     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2325     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2326     :
     2327       define variable fh               as handle    no-undo .
     2328       define variable v-ok             as logical   no-undo .
     2329       define variable v-inform         as character no-undo .
     2330       define variable v-ind            as integer   no-undo .
     2331       define variable v-idx-field-qnty as integer   no-undo .
     2332       if p-tbl-name = ?
     2333         or p-tbl-name = "":U
     2334       then do:
     2335         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info14 ).
     2336       end.
     2337       if not p-bh_tbl-name:available then do:
     2338         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info14, p-tbl-name ).
     2339       end.
     2340       assign
     2341         p-key-rec = p-tbl-name
     2342         v-inform  = p-bh_tbl-name:index-information(1)
     2343         v-ind     = 2
     2344       .
     2345       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2346       on error undo, return error
     2347       :
     2348         assign
     2349           v-inform = p-bh_tbl-name:index-information( v-ind )
     2350           v-ind    = v-ind + 1
     2351         .
     2352       end.
     2353       if v-inform = ?
     2354         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2355         or entry( 3, v-inform, ",":U ) <> "1":U
     2356       then do:
     2357         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, p-tbl-name ).
     2358       end.
     2359       else do:
     2360         assign
     2361           v-idx-field-qnty = num-entries( v-inform ) - 4
     2362         .
     2363         if v-idx-field-qnty < 2 then do:
     2364           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, p-tbl-name ).
     2365         end.
     2366         do v-ind = 1 to v-idx-field-qnty by 2
     2367         on error undo, return error
     2368         :
     2369           assign
     2370             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2371             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2372           .
     2373         end.
     2374       end.
     2375       if p-key-rec = ? then do:
     2376         assign
     2377           p-key-rec = "":U
     2378         .
     2379         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info14, p-tbl-name ).
     2380       end.
     2381     end.
     2382     return.
     2383   end procedure.
     2384   procedure gen-where-keyr-tab :
     2385     define input  parameter i-tableSerach as character no-undo.
     2386     define input  parameter i-tablekey   as character  no-undo.
     2387     define input  parameter p-key-rec    as character  no-undo.
     2388     define input  parameter p-key-handle as handle     no-undo .
     2389     define input  parameter p-db-name    as character  no-undo .
     2390     define input  parameter p-tt-handle  as handle     no-undo .
     2391     define output parameter o-Where      as character  no-undo.
     2392     do
     2393     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2394     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2395     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2396     :
     2397       define variable v-full-tbl-name  as character no-undo .
     2398       define variable bh_tbl-name      as handle    no-undo .
     2399       define variable fh_key           as handle    no-undo .
     2400       define variable fh_search        as handle    no-undo .
     2401       define variable v-field-num      as integer   no-undo .
     2402       define variable v-count-fld      as integer   no-undo .
     2403       define variable v-inform         as character no-undo .
     2404       define variable v-ind            as integer   no-undo .
     2405       define variable v-idx-field-qnty as integer   no-undo .
     2406       define variable v-field-name     as character no-undo .
     2407       define variable v-field-val      as character no-undo .
     2408       define variable v-word-link      as character no-undo .
     2409       define variable vTable           as character no-undo.
     2410       define variable bh_tbl-key       as handle    no-undo .
     2411       assign
     2412         p-key-rec = trim( p-key-rec )
     2413       .
     2414       if p-key-handle <> ? then do:
     2415         if not valid-handle(p-key-handle)
     2416            or p-key-handle:type <> "buffer"
     2417         then do:
     2418           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info14 ).
     2419         end.
     2420         if num-entries( p-key-rec, chr(3) ) > 1
     2421           or p-key-rec = ?
     2422           or p-key-rec = "":U
     2423         then do:
     2424           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info14, p-key-rec ).
     2425         end.
     2426       end.
     2427       else do:
     2428         if p-key-rec = ?
     2429           or p-key-rec = "":U
     2430         then do:
     2431           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     2432         end.
     2433       end.
     2434       assign
     2435         vTable = entry( 1 , p-key-rec, chr(3) )
     2436       .
     2437       if p-tt-handle <> ?
     2438         and ( not valid-handle(p-tt-handle)
     2439               or p-tt-handle:type <> "buffer"
     2440             )
     2441       then do:
     2442         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info14, vTable, chr(10) ).
     2443       end.
     2444       if p-tt-handle = ? then do:
     2445         assign
     2446           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2447         .
     2448         create buffer bh_tbl-name for table v-full-tbl-name .
     2449       end.
     2450       else do:
     2451         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2452       end.
     2453       assign
     2454         v-inform = bh_tbl-name:index-information(1)
     2455         v-ind    = 2
     2456       .
     2457       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2458       on error undo, return error
     2459       :
     2460         assign
     2461           v-inform = bh_tbl-name:index-information( v-ind )
     2462           v-ind    = v-ind + 1
     2463         .
     2464       end.
     2465       if v-inform = ?
     2466         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2467         or entry( 3, v-inform, ",":U ) <> "1":U
     2468       then do:
     2469         delete object bh_tbl-name no-error.
     2470         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info14, vTable ).
     2471       end.
     2472       assign
     2473         v-idx-field-qnty = num-entries( v-inform ) - 4
     2474       .
     2475       if v-idx-field-qnty < 2 then do:
     2476         delete object bh_tbl-name no-error.
     2477         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, vTable ).
     2478       end.
     2479       assign
     2480         o-where     = "where":U
     2481         v-word-link = "":U
     2482         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2483         v-count-fld = 0
     2484       .
     2485       if i-tablekey ne "" and i-tablekey ne ?
     2486       then do:
     2487         assign
     2488           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2489         .
     2490         create buffer bh_tbl-key for table v-full-tbl-name .
     2491       end.
     2492       if i-tableSerach ne "" and i-tableSerach ne ?
     2493       then do:
     2494         delete object bh_tbl-name no-error.
     2495         assign
     2496           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2497         .
     2498         create buffer bh_tbl-name for table v-full-tbl-name .
     2499       end.
     2500       block_where:
     2501       do v-ind = 1 to v-idx-field-qnty by 2
     2502       on error undo, return error
     2503       :
     2504         assign
     2505           v-count-fld = v-count-fld + 1
     2506         .
     2507         if p-key-handle = ?
     2508           and v-count-fld > v-field-num
     2509         then do:
     2510           leave block_where.
     2511         end.
     2512         define variable VfieldKeyTable as handle no-undo.
     2513         assign
     2514           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2515           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2516         .
     2517         if     bh_tbl-key ne ?
     2518         then do:
     2519            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2520            if VfieldKeyTable eq ?
     2521            then next block_where.
     2522         end.
     2523         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2524         then
     2525            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2526         else
     2527            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2528         if p-key-handle = ? then do:
     2529           assign
     2530             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2531           .
     2532         end.
     2533         else do:
     2534           assign
     2535             fh_key = p-key-handle:buffer-field( v-field-name )
     2536           .
     2537           if fh_key = ?
     2538             or not valid-handle( fh_key )
     2539           then do:
     2540             delete object bh_tbl-name.
     2541             if     bh_tbl-key ne ?
     2542             then
     2543                delete object bh_tbl-key.
     2544             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info14, p-key-handle:name, v-field-name ).
     2545           end.
     2546           assign
     2547             v-field-val = fh_key:buffer-value
     2548           .
     2549         end.
     2550         if fh_search:data-type ="character":U then do:
     2551           assign
     2552             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2553             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2554             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2555             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2556             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2557             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2558             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2559             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2560             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2561             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2562             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2563             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2564             v-field-val = substitute( '"&1"', v-field-val )
     2565           .
     2566         end.
     2567         assign
     2568           o-where = substitute( "&1 &2", o-where, v-field-val )
     2569         .
     2570         if v-word-link = "":U then do:
     2571           assign
     2572             v-word-link = "and":U
     2573           .
     2574         end.
     2575       end.
     2576       delete object bh_tbl-name.
     2577       if     bh_tbl-key ne ?
     2578       then
     2579          delete object bh_tbl-key.
     2580       if p-key-handle = ?
     2581         and v-count-fld <> v-field-num
     2582       then do:
     2583         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info14, vTable ).
     2584       end.
     2585     end.
     2586   end procedure.
     2587   procedure gen-hn-keyr-tab :
     2588     define input  parameter i-tableSerach as character no-undo.
     2589     define input  parameter i-tablekey   as character no-undo.
     2590     define input  parameter p-key-rec    as character no-undo.
     2591     define input  parameter p-key-handle as handle    no-undo .
     2592     define input  parameter p-db-name    as character no-undo .
     2593     define input  parameter p-tt-handle  as handle    no-undo .
     2594     define input  parameter p-stts-lock  as integer   no-undo .
     2595     define output parameter o-hn         as handle    no-undo.
     2596     define variable v-full-tbl-name as character no-undo.
     2597     define variable v-where         as character no-undo.
     2598     define variable bh_tbl-name     as handle    no-undo.
     2599     define variable vTable          as character no-undo.
     2600     do
     2601     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2602     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2603     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2604         run gen-where-keyr-tab(i-tableSerach,
     2605                                i-tablekey,
     2606                                p-key-rec,
     2607                                p-key-handle,
     2608                                p-db-name,
     2609                                p-tt-handle,
     2610                                output v-where).
     2611         if i-tableSerach ne "" and i-tableSerach ne ?
     2612         then do:
     2613            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2614            create buffer bh_tbl-name for table v-full-tbl-name .
     2615         end.
     2616         else do:
     2617            if p-tt-handle = ? then do:
     2618               assign
     2619                  vTable = entry( 1 , p-key-rec, chr(3) )
     2620               .
     2621               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2622               create buffer bh_tbl-name for table v-full-tbl-name .
     2623            end.
     2624            else do:
     2625               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2626            end.
     2627         end.
     2628         if p-tt-handle = ? then do:
     2629            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2630         end.
     2631         else do:
     2632            bh_tbl-name:find-first( v-where ) no-error .
     2633         end.
     2634         o-hn = bh_tbl-name.
     2635      end.
     2636   end procedure.
     2637   procedure gen-hn-keyr :
     2638     define input  parameter p-key-rec    as character no-undo.
     2639     define input  parameter p-key-handle as handle    no-undo .
     2640     define input  parameter p-db-name    as character no-undo .
     2641     define input  parameter p-tt-handle  as handle    no-undo .
     2642     define input  parameter p-stts-lock  as integer   no-undo .
     2643     define output parameter o-hn         as handle    no-undo.
     2644     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2645   end.
     2646   procedure gen-row-keyr :
     2647     define input  parameter p-key-rec    as character no-undo.
     2648     define input  parameter p-key-handle as handle    no-undo .
     2649     define input  parameter p-db-name    as character no-undo .
     2650     define input  parameter p-tt-handle  as handle    no-undo .
     2651     define input  parameter p-stts-lock  as integer   no-undo .
     2652     define output parameter p-tbl-row    as rowid     no-undo.
     2653     define output parameter p-tbl-name   as character no-undo.
     2654     define variable vHn as handle no-undo.
     2655       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2656       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2657       p-tbl-name =  vHn:table.
     2658       delete object vHn no-error.
     2659     if p-tbl-row = ? then do:
     2660       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info14, p-tbl-name, p-key-rec ).
     2661     end.
     2662     else do:
     2663       return.
     2664     end.
     2665   end procedure.
     2666   procedure gen-key-fv :
     2667     define input  parameter p-key-rec    as character no-undo .
     2668     define output parameter p-field-list as character no-undo .
     2669     define output parameter p-value-list as character no-undo.
     2670     do
     2671     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2672     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2673     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2674     :
     2675       define variable v-full-tbl-name  as character no-undo .
     2676       define variable bh_tbl-name      as handle    no-undo .
     2677       define variable v-tbl-name       as character no-undo .
     2678       define variable v-field-num      as integer   no-undo .
     2679       define variable v-count-fld      as integer   no-undo .
     2680       define variable v-inform         as character no-undo .
     2681       define variable v-ind            as integer   no-undo .
     2682       define variable v-idx-field-qnty as integer   no-undo .
     2683       define variable v-delim-key      as character no-undo .
     2684       if p-key-rec = ?
     2685         or p-key-rec = "":U
     2686       then do:
     2687         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     2688       end.
     2689       assign
     2690         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2691         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2692       .
     2693       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2694       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info14 ).
     2695       assign
     2696         v-inform = bh_tbl-name:index-information(1)
     2697         v-ind    = 2
     2698       .
     2699       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2700       on error undo, return error
     2701       :
     2702         assign
     2703           v-inform = bh_tbl-name:index-information( v-ind )
     2704           v-ind    = v-ind + 1
     2705         .
     2706       end.
     2707       if v-inform = ?
     2708         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2709         or entry( 3, v-inform, ",":U ) <> "1":U
     2710       then do:
     2711         delete object bh_tbl-name no-error.
     2712         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     2713       end.
     2714       assign
     2715         v-idx-field-qnty = num-entries( v-inform ) - 4
     2716       .
     2717       if v-idx-field-qnty < 2 then do:
     2718         delete object bh_tbl-name no-error.
     2719         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     2720       end.
     2721       assign
     2722         p-field-list = "":U
     2723         p-value-list = "":U
     2724         v-delim-key  = "":U
     2725         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2726         v-count-fld  = 0
     2727       .
     2728       block_where:
     2729       do v-ind = 1 to v-idx-field-qnty by 2
     2730       on error undo, return error
     2731       :
     2732         assign
     2733           v-count-fld = v-count-fld + 1
     2734         .
     2735         if v-count-fld > v-field-num then do:
     2736           leave block_where.
     2737         end.
     2738         assign
     2739           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2740           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2741         .
     2742         if v-ind = 1 then do:
     2743           assign
     2744             v-delim-key = chr(3)
     2745           .
     2746         end.
     2747       end.
     2748       delete object bh_tbl-name.
     2749       if v-count-fld <> v-field-num then do:
     2750         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info14, v-tbl-name ).
     2751       end.
     2752     end.
     2753   end procedure.
     2754   procedure gen-key-field :
     2755     define input  parameter p-table      as character no-undo .
     2756     define output parameter p-field-list as character no-undo .
     2757     do
     2758     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2759     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2760     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2761     :
     2762       define variable v-full-tbl-name  as character no-undo .
     2763       define variable bh_tbl-name      as handle    no-undo .
     2764       define variable v-tbl-name       as character no-undo .
     2765       define variable v-field-num      as integer   no-undo .
     2766       define variable v-count-fld      as integer   no-undo .
     2767       define variable v-inform         as character no-undo .
     2768       define variable v-ind            as integer   no-undo .
     2769       define variable v-idx-field-qnty as integer   no-undo .
     2770       define variable v-delim-key      as character no-undo .
     2771       if p-table = ?
     2772         or p-table = "":U
     2773       then do:
     2774         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info14 ).
     2775       end.
     2776       assign
     2777         v-tbl-name      = p-table
     2778         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2779       .
     2780       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2781       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info14 ).
     2782       assign
     2783         v-inform = bh_tbl-name:index-information(1)
     2784         v-ind    = 2
     2785       .
     2786       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2787       on error undo, return error
     2788       :
     2789         assign
     2790           v-inform = bh_tbl-name:index-information( v-ind )
     2791           v-ind    = v-ind + 1
     2792         .
     2793       end.
     2794       if v-inform = ?
     2795         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2796         or entry( 3, v-inform, ",":U ) <> "1":U
     2797       then do:
     2798         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     2799       end.
     2800       assign
     2801         v-idx-field-qnty = num-entries( v-inform ) - 4
     2802       .
     2803       if v-idx-field-qnty < 2 then do:
     2804         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     2805       end.
     2806       assign
     2807         p-field-list = "":U
     2808         v-delim-key  = "":U
     2809         v-count-fld  = 0
     2810       .
     2811       block_where:
     2812       do v-ind = 1 to v-idx-field-qnty by 2
     2813       on error undo, return error
     2814       :
     2815         assign
     2816           v-count-fld = v-count-fld + 1
     2817         .
     2818         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2819         if v-ind = 1 then do:
     2820           assign
     2821             v-delim-key = chr(3)
     2822           .
     2823         end.
     2824       end.
     2825       delete object bh_tbl-name.
     2826     end.
     2827   end procedure.
     2828   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2829   procedure bc-oattr_name :
     2830     define input  parameter p-code           as character no-undo .
     2831     define output parameter p-type           as character no-undo .
     2832     define output parameter p-format         as character no-undo .
     2833     define output parameter p-label          as character no-undo .
     2834     define output parameter p-range          as integer   no-undo .
     2835     define output parameter p-user-can-edit  as logical   no-undo .
     2836     define output parameter p-output-display as logical   no-undo .
     2837     define output parameter p-other          as character no-undo .
     2838     do
     2839     on error undo, return error
     2840     :
     2841           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bc-oattr_name in g#attr-lib
     2842         (input  p-code
     2843         ,output p-type
     2844         ,output p-format
     2845         ,output p-label
     2846         ,output p-range
     2847         ,output p-user-can-edit
     2848         ,output p-output-display
     2849         ,output p-other
     2850         ) no-error .
     2851       if error-status :error
     2852       then do:
     2853         undo, return error return-value .
     2854       end.
     2855     end.
     2856   end procedure.
     2857   procedure bc-oattr_tooltip :
     2858     define input  parameter p-code    as character no-undo .
     2859     define output parameter p-tooltip as character no-undo .
     2860     define output parameter p-label   as character no-undo .
     2861     do
     2862     on error undo, return error
     2863     :
     2864           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bc-oattr_tooltip in g#attr-lib
     2865         (input  p-code
     2866         ,output p-tooltip
     2867         ,output p-label
     2868         ) no-error .
     2869       if error-status :error
     2870       then do:
