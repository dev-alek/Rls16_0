     4425   :
     4426       find first current_c-dis-gds-rule no-lock where
     4427                  current_c-dis-gds-rule.gds-code = p-gds-code
     4428              AND current_c-dis-gds-rule.chip-num = p-chip-num
     4429              AND current_c-dis-gds-rule.corr-user-db-num = p-corr-user-db-num    no-error .
     4430       if not avail current_c-dis-gds-rule then do:
     4431          v-mess = "Неверная ссылка на c-dis-gds-rule в таблице c-gds-hist".
     4432          run err-mess in this-procedure ( input-output v-mess).
     4433          return error v-mess.
     4434       end.
     4435       run disgdsru-name in this-procedure (
     4436                   input  current_c-dis-gds-rule.templ-rl-root
     4437                   ,output v-label
     4438                   ) no-error .
     4439       assign
     4440       p-description = substitute("Тип скидки &1", v-label)
     4441       .
     4442   define variable v-label-param as character no-undo .
     4443   v-label-param =
     4444     "rule-num" + chr(4) + "Номер правила скидки" + chr(4) + "" + chr(8)
     4445    + "pos-type" + chr(4) + "Место использ." + chr(4) + "" + chr(8)
     4446    + "templ-rl-root" + chr(4) + "Шаблон скидки" + chr(4) + "disgdsru-get-disc-label" + chr(8)
     4447    + "discnt-role" + chr(4) + "Тип скидки" + chr(4) + "disgdsru-get-disc-role-label" + chr(8)
     4448    + "time-templ-rl-root" + chr(4) +  "Тип расписания" + chr(4) +  "":U
     4449    .
     4450    run proc-full-temp-changes in this-procedure (
     4451                                                input  (buf_c-gds-hist.action = integer('1':U))
     4452                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     4453                                               ,input  buffer current_c-dis-gds-rule:handle
     4454                                               ,input  'dis-gds-rule':U
     4455                                               ,input  "rule-num,pos-type,templ-rl-root,discnt-role,time-templ-rl-root"
     4456                                               ,input  v-label-param).
     4457   end.
     4458   end procedure.
     4459   procedure ext-artic-proc :
     4460   define output parameter p-description as character no-undo .
     4461   define buffer current_c-ext-artic for ub.c-ext-artic.
     4462   define buffer buf_clients         for ub.clients.
     4463   do
     4464   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4465   :
     4466     if buf_c-gds-hist.action <> integer('99':U) then do:
     4467       find first current_c-ext-artic no-lock  where
     4468              current_c-ext-artic.gds-code = buf_c-gds-hist.gds-code
     4469           and current_c-ext-artic.corr-user-db-num = buf_c-gds-hist.corr-user-db-num
     4470           and current_c-ext-artic.chip-num = buf_c-gds-hist.chip-num
     4471       no-error .
     4472       if not available current_c-ext-artic then do:
     4473         v-mess = "Неверная ссылка на c-ext-artic в таблице c-gds-hist"  .
     4474         run err-mess in this-procedure ( input-output v-mess).
     4475         return error v-mess.
     4476       end.
     4477   define variable v-label-param as character no-undo .
     4478   v-label-param =
     4479     "ext-artic" + chr(4) + "Внешний артикул" + chr(4) + "" + chr(8)
     4480    + "ps" + chr(4) + "Описание" + chr(4) + "" + chr(8)
     4481    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     4482    run proc-full-temp-changes in this-procedure (
     4483                                                input  (buf_c-gds-hist.action = integer('1':U))
     4484                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     4485                                               ,input  buffer current_c-ext-artic:handle
     4486                                               ,input  'ext-artic':U
     4487                                               ,input  "ext-artic,ps,status_"
     4488                                               ,input  v-label-param).
     4489       find first buf_clients no-lock
     4490         where buf_clients.obj-type = current_c-ext-artic.cli-type
     4491           and buf_clients.obj-code = current_c-ext-artic.cli-code
     4492       no-error .
     4493       assign
     4494         p-description = substitute( "Внешний артикул &1/&2 '&3'"
     4495                                   , current_c-ext-artic.cli-code
     4496                                   , current_c-ext-artic.cli-type
     4497                                   , if available buf_clients then
     4498                                       buf_clients.obj-name
     4499                                     else
     4500                                       "":U
     4501                                   )
     4502       .
     4503     end.
     4504   end.
     4505   end procedure.
     4506   procedure sert-join-proc :
     4507   define output parameter p-description as character no-undo .
     4508   define variable v-tooltip as character no-undo .
     4509   define variable v-label as character no-undo .
     4510   define variable v-field-name as character no-undo .
     4511   define variable v-field-function as character no-undo .
     4512   define variable jj as integer no-undo .
     4513   define variable v-field-label  as character no-undo .
     4514   define variable v-field-list as character no-undo .
     4515   define buffer curr_sert-join   for ub.sert-join  .
     4516   define buffer curr_c-sert for ub.c-sert  .
     4517   define buffer new_c-sert  for ub.c-sert  .
     4518   define buffer buf_c-table-bind for ub.c-table-bind.
     4519   do
     4520   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4521   :
     4522       find first buf_c-table-bind no-lock where
     4523                 buf_c-table-bind.corr-user-db-num = buf_c-gds-hist.corr-user-db-num
     4524             AND buf_c-table-bind.tbl-name-rec     = 'c-gds-hist':U
     4525             AND buf_c-table-bind.chip-num-rec     = buf_c-gds-hist.chip-num no-error .
     4526       if not available buf_c-table-bind then do:
     4527         v-mess = "Неверная ссылка на c-table-bind в таблице c-gds-hist".
     4528         run err-mess in this-procedure ( input-output v-mess).
     4529         return error v-mess.
     4530       end.
     4531     find first curr_c-sert no-lock where
     4532               curr_c-sert.b-code        = buf_c-gds-hist.b-code
     4533           AND curr_c-sert.corr-user-db-num = buf_c-table-bind.corr-user-db-num
     4534           AND curr_c-sert.chip-num        = buf_c-table-bind.chip-num-src   no-error .
     4535     if not avail curr_c-sert then do:
     4536       v-mess = "Неверная ссылка на c-sert-join в таблице c-gds-hist".
     4537       run err-mess in this-procedure ( input-output v-mess).
     4538       return error v-mess.
     4539     end.
     4540     find first new_c-sert no-lock where
     4541                 new_c-sert.b-code = buf_c-gds-hist.b-code
     4542             AND new_c-sert.cli-type = curr_c-sert.cli-type
     4543             AND new_c-sert.cli-code = curr_c-sert.cli-code
     4544             AND new_c-sert.sert-code = curr_c-sert.sert-code
     4545             AND new_c-sert.chip-num > p-chip-num
     4546             AND new_c-sert.corr-user-db-num = p-corr-user-db-num
     4547             no-error.
     4548     if not available new_c-sert then do:
     4549       find first curr_sert-join no-lock where
     4550                   curr_sert-join.b-code = buf_c-gds-hist.b-code
     4551               AND curr_sert-join.cli-type  = curr_c-sert.cli-type
     4552               AND curr_sert-join.cli-code  = curr_c-sert.cli-code
     4553               AND curr_sert-join.sert-code = curr_c-sert.sert-code
     4554               no-error.
     4555       if not available curr_sert-join then do:
     4556           return error.
     4557       end.
     4558       buffer-compare curr_sert-join to curr_c-sert
     4559       case-sensitive
     4560       save result in v-chg-fields.
     4561     end.
     4562     else do:
     4563       buffer-compare new_c-sert
     4564       except chip-num corr-date corr-user-name corr-user-db-num corr-time
     4565       to curr_c-sert
     4566       case-sensitive
     4567       save result in v-chg-fields.
     4568     end.
     4569     _ii:
     4570     do ii = 1 to num-entries(v-chg-fields):
     4571       assign
     4572       v-field-name = entry(ii, v-chg-fields)
     4573       jj = lookup(v-field-name, "b-code,cli-code,cli-type,sert-code").
     4574       if jj = 0 then next _ii.
     4575       assign
     4576       v-field-label = entry(jj, "Бар-код,Код контрагента,Тип контрагента,№ сертификата")
     4577       v-field-function = entry(jj, ",,,")
     4578       .
     4579       create temp-changes.
     4580       assign
     4581       temp-changes.f_name = v-field-name
     4582       temp-changes.l_name = v-field-label
     4583       temp-changes.v_old = (if buf_c-gds-hist.action = integer('1':U)
     4584                             then "":U
     4585                             else string(buffer curr_c-sert:buffer-field(v-field-name):buffer-value))
     4586       temp-changes.v_new =  (if available new_c-sert
     4587                                   then string(buffer new_c-sert:buffer-field(v-field-name):buffer-value)
     4588                                   else string(buffer curr_sert-join:buffer-field(v-field-name):buffer-value)
     4589                              )
     4590       .
     4591       if v-field-function <> '':U then do:
     4592         assign
     4593         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4594         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4595         .
     4596       end.
     4597     end.
     4598   end.
     4599   end procedure.
     4600   procedure recipe-gds-proc :
     4601   define output parameter p-description as character no-undo .
     4602   define variable v-tooltip as character no-undo .
     4603   define variable v-label as character no-undo .
     4604   define variable v-is-created as logical no-undo .
     4605   define variable v-field-name as character no-undo .
     4606   define variable v-field-function as character no-undo .
     4607   define variable jj as integer no-undo .
     4608   define variable v-field-label  as character no-undo .
     4609   define buffer buf_c-table-bind for ub.c-table-bind.
     4610   define buffer curr_recipe-gds for ub.recipe-gds  .
     4611   define buffer curr_c-recipe-gds for ub.c-recipe-gds  .
     4612   define buffer new_c-recipe-gds for ub.c-recipe-gds  .
     4613   do
     4614   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4615   :
     4616       find first buf_c-table-bind no-lock where
     4617                 buf_c-table-bind.corr-user-db-num = buf_c-gds-hist.corr-user-db-num
     4618             AND buf_c-table-bind.tbl-name-rec     = 'c-gds-hist':U
     4619             AND buf_c-table-bind.chip-num-rec     = buf_c-gds-hist.chip-num no-error .
     4620       if not available buf_c-table-bind then do:
     4621         v-mess = "Неверная ссылка на c-table-bind в таблице c-gds-hist".
     4622         run err-mess in this-procedure ( input-output v-mess).
     4623         return error v-mess.
     4624       end.
     4625       find first curr_c-recipe-gds no-lock where
     4626                  curr_c-recipe-gds.gds-code = p-gds-code
     4627              AND curr_c-recipe-gds.corr-user-db-num = buf_c-table-bind.corr-user-db-num
     4628              AND curr_c-recipe-gds.chip-num = buf_c-table-bind.chip-num-src  no-error .
     4629       if not avail curr_c-recipe-gds then do:
     4630         v-mess = "Неверная ссылка на c-recipe-gds в таблице c-table-bind".
     4631         run err-mess in this-procedure ( input-output v-mess).
     4632         return error v-mess.
     4633       end.
     4634       find first new_c-recipe-gds no-lock where
     4635                   new_c-recipe-gds.gds-code = buf_c-gds-hist.gds-code
     4636               AND new_c-recipe-gds.chip-num > buf_c-table-bind.chip-num-src
     4637               AND new_c-recipe-gds.corr-user-db-num = buf_c-table-bind.corr-user-db-num  no-error.
     4638       if not available new_c-recipe-gds then do:
     4639           find first curr_recipe-gds no-lock where
     4640                       curr_recipe-gds.gds-code = buf_c-gds-hist.gds-code
     4641                   no-error.
     4642           if not available curr_recipe-gds then do:
     4643               return error.
     4644           end.
     4645           buffer-compare curr_recipe-gds to curr_c-recipe-gds
     4646           case-sensitive
     4647           save result in v-chg-fields.
     4648       end.
     4649       else do:
     4650           buffer-compare new_c-recipe-gds except chip-num corr-date corr-user-name corr-user-db-num corr-time
     4651           to curr_c-recipe-gds
     4652           case-sensitive
     4653           save result in v-chg-fields.
     4654       end.
     4655     _ii:
     4656     do ii = 1 to num-entries(v-chg-fields):
     4657       assign
     4658       v-field-name = entry(ii, v-chg-fields)
     4659       jj = lookup(v-field-name, "artic,brutto-qnty,calc-method,coeff-waste,is-waste,proc-number,prod-code,prod-type,qnty,recipe-code").
     4660       if jj = 0 then next _ii.
     4661       assign
     4662       v-field-label = entry(jj, "Артикул,Кол-во брутто,Метод расчета брутто,Коэфф.отходов,Флаг ОТХОДЫ,Пор.№ при обработке,Код пр-ля,Тип пр-ля,Кол-во по рецепту,Номер рецепта")
     4663       v-field-function = entry(jj, ",,,,,,,,,")
     4664       .
     4665       create temp-changes.
     4666       assign
     4667       temp-changes.f_name = v-field-name
     4668       temp-changes.l_name = v-field-label
     4669       temp-changes.v_old = (if v-is-created
     4670                             then "":U
     4671                             else string(buffer curr_c-recipe-gds:buffer-field(v-field-name):buffer-value))
     4672       temp-changes.v_new = (if available new_c-recipe-gds
     4673                             then string(buffer new_c-recipe-gds:buffer-field(v-field-name):buffer-value)
     4674                             else string(buffer curr_recipe-gds:buffer-field(v-field-name):buffer-value)
     4675                             )
     4676       .
     4677       if v-field-function <> '':U then do:
     4678         assign
     4679         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4680         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4681         .
     4682       end.
     4683     end.
     4684   end.
     4685   end procedure.
     4686   procedure recipe-proc :
     4687   define output parameter p-description as character no-undo .
     4688   define variable v-tooltip as character no-undo .
     4689   define variable v-label as character no-undo .
     4690   define variable v-is-created as logical no-undo .
     4691   define variable v-field-name as character no-undo .
     4692   define variable v-field-function as character no-undo .
     4693   define variable jj as integer no-undo .
     4694   define variable v-field-label  as character no-undo .
     4695   define buffer buf_c-table-bind for ub.c-table-bind.
     4696   define buffer curr_recipe for ub.recipe  .
     4697   define buffer curr_c-recipe for ub.c-recipe  .
     4698   define buffer new_c-recipe for ub.c-recipe  .
     4699   do
     4700   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4701   :
     4702       find first buf_c-table-bind no-lock where
     4703                 buf_c-table-bind.corr-user-db-num = buf_c-gds-hist.corr-user-db-num
     4704             AND buf_c-table-bind.tbl-name-rec     = 'c-gds-hist':U
     4705             AND buf_c-table-bind.chip-num-rec     = buf_c-gds-hist.chip-num no-error .
     4706       if not available buf_c-table-bind then do:
     4707         v-mess = "Неверная ссылка на c-table-bind в таблице c-gds-hist".
     4708         run err-mess in this-procedure ( input-output v-mess).
     4709         return error v-mess.
     4710       end.
     4711       find first curr_c-recipe no-lock where
     4712                  curr_c-recipe.gds-code = p-gds-code
     4713              AND curr_c-recipe.corr-user-db-num = buf_c-table-bind.corr-user-db-num
     4714              AND curr_c-recipe.chip-num = buf_c-table-bind.chip-num-src  no-error .
     4715       if not avail curr_c-recipe then do:
     4716         v-mess = "Неверная ссылка на c-recipe в таблице c-table-bind".
     4717         run err-mess in this-procedure ( input-output v-mess).
     4718         return error v-mess.
     4719       end.
     4720       find first new_c-recipe no-lock where
     4721                   new_c-recipe.gds-code = buf_c-gds-hist.gds-code
     4722               AND new_c-recipe.chip-num > buf_c-table-bind.chip-num-src
     4723               AND new_c-recipe.corr-user-db-num = buf_c-table-bind.corr-user-db-num  no-error.
     4724       if not available new_c-recipe then do:
     4725           find first curr_recipe no-lock where
     4726                       curr_recipe.gds-code = buf_c-gds-hist.gds-code
     4727                   no-error.
     4728           if not available curr_recipe then do:
     4729               return error.
     4730           end.
     4731           buffer-compare curr_recipe to curr_c-recipe
     4732           case-sensitive
     4733           save result in v-chg-fields.
     4734       end.
     4735       else do:
     4736           buffer-compare new_c-recipe except chip-num corr-date corr-user-name corr-user-db-num corr-time
     4737           to curr_c-recipe
     4738           case-sensitive
     4739           save result in v-chg-fields.
     4740       end.
     4741     _ii:
     4742     do ii = 1 to num-entries(v-chg-fields):
     4743       assign
     4744       v-field-name = entry(ii, v-chg-fields)
     4745       jj = lookup(v-field-name, "host-code,obj-code,obj-type,portion-qnty,portion-weight,recipe-design,recipe-name,recipe-order,recipe-quality,recipe-ref-num,recipe-technique,recipe-template,recipe-type,sale-factor,artic,brutto-qnty,prod-code,prod-type,qnty,recipe-code").
     4746       if jj = 0 then next _ii.
     4747       assign
     4748       v-field-label = entry(jj, "Фирма,Код объекта,Тип объекта,Кол-во порций,Вес порции,Способ оформления,Название,Порядок при обработке,Показатели качества,Номер в справочнике рецептур,Технология,Ссылка на спр.рецептур,Тип рецепта,Кратность при продаже,Артикул,Кол-во брутто,Код пр-ля,Тип пр-ля,Кол-во по рецепту,Номер рецепта")
     4749       v-field-function = entry(jj, ",,,,,,,,,,,,,,,,,,,")
     4750       .
     4751       create temp-changes.
     4752       assign
     4753       temp-changes.f_name = v-field-name
     4754       temp-changes.l_name = v-field-label
     4755       temp-changes.v_old = (if v-is-created
     4756                             then "":U
     4757                             else string(buffer curr_c-recipe:buffer-field(v-field-name):buffer-value))
     4758       temp-changes.v_new = (if available new_c-recipe
     4759                             then string(buffer new_c-recipe:buffer-field(v-field-name):buffer-value)
     4760                             else string(buffer curr_recipe:buffer-field(v-field-name):buffer-value)
     4761                             )
     4762       .
     4763       if v-field-function <> '':U then do:
     4764         assign
     4765         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4766         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4767         .
     4768       end.
     4769     end.
     4770   end.
     4771   end procedure.
     4772   define temp-table temp-goods no-undo like ub.goods.
     4773   procedure ext-classif-proc :
     4774   define output parameter p-description as character no-undo .
     4775   define variable v-uniq-key-rec as character no-undo .
     4776   define variable v-field-list as character no-undo .
     4777   define variable v-value-list as character no-undo .
     4778   define variable v-label-param as character no-undo .
     4779   define buffer curr_c-ext-classif for ub.c-ext-classif  .
     4780   do
     4781   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4782   :
     4783       create temp-goods.
     4784       buffer-copy buf_c-gds-hist to temp-goods.
     4785       run gen-key-rec in this-procedure ( input 'goods':U
     4786                                          ,input (buffer temp-goods:handle)
     4787                                          ,output v-uniq-key-rec).
     4788       delete temp-goods.
     4789       find first curr_c-ext-classif no-lock where
     4790              curr_c-ext-classif.uniq-key-rec = v-uniq-key-rec
     4791              AND curr_c-ext-classif.chip-num = p-chip-num
     4792              AND curr_c-ext-classif.corr-user-db-num = p-corr-user-db-num
     4793              no-error .
     4794       if not avail curr_c-ext-classif then do:
     4795          v-mess = "Неверная ссылка на c-ext-classif в таблице c-gds-hist".
     4796          run err-mess in this-procedure ( input-output v-mess).
     4797          return error v-mess.
     4798       end.
     4799   case curr_c-ext-classif.classif-name:
     4800     when 'exp-accor-gds-code':U then do:
     4801      assign
     4802      v-label-param = "key#_one" + chr(4) + "Код топлива " + chr(4) + ""
     4803      p-description = "Классификатор АККОР"
     4804      .
     4805     end.
     4806   end case.
     4807    run proc-full-temp-changes in this-procedure (
     4808                                                input  (buf_c-gds-hist.action = integer('1':U))
     4809                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     4810                                               ,input  buffer curr_c-ext-classif:handle
     4811                                               ,input  'ext-classif':U
     4812                                               ,input  "key#_one"
     4813                                               ,input  v-label-param).
     4814   end.
     4815   end procedure.
     4816   procedure gds-obj-prop-attr-proc :
     4817   define output parameter p-description as character no-undo .
     4818   define variable v-tooltip as character no-undo .
     4819   define variable v-label as character no-undo .
     4820   define buffer current_c-gds-obj-prop-attr for ub.c-gds-obj-attr .
     4821   do
     4822   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4823   :
     4824   find first current_c-gds-obj-prop-attr no-lock where
     4825               current_c-gds-obj-prop-attr.gds-code = p-gds-code
     4826           AND current_c-gds-obj-prop-attr.chip-num = p-chip-num
     4827           AND current_c-gds-obj-prop-attr.corr-user-db-num = p-corr-user-db-num
     4828           AND current_c-gds-obj-prop-attr.obj-type = p-obj-type
     4829           AND current_c-gds-obj-prop-attr.obj-code = p-obj-code
     4830           AND current_c-gds-obj-prop-attr.attr-code = buf_c-gds-hist.attr-code
     4831           no-error .
     4832   define variable v-label-param as character no-undo .
     4833   v-label-param =
     4834     "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     4835    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     4836    + "attr-code" + chr(4) + "Атрибут" + chr(4) + "" + chr(8)
     4837    + "gds-code" + chr(4) + "Код товара" + chr(4) + "" + chr(8)
     4838    + "attr-value" + chr(4) + "Значение атрибута" + chr(4) + ""  .
     4839    run proc-full-temp-changes in this-procedure (
     4840                                                input  (buf_c-gds-hist.action = integer('1':U))
     4841                                               ,input  (buf_c-gds-hist.action = integer('99':U))
     4842                                               ,input  buffer current_c-gds-obj-prop-attr:handle
     4843                                               ,input  'gds-obj-prop-attr':U
     4844                                               ,input  "obj-type,obj-code,attr-code,gds-code,attr-value"
     4845                                               ,input  v-label-param).
     4846       run gdspoatr-tooltip in this-procedure (
     4847                   input  current_c-gds-obj-prop-attr.attr-code
     4848                   ,output v-tooltip
     4849                   ,output v-label
     4850                   ) no-error .
     4851       assign
     4852       p-description = "Атрибут" + chr(32) + v-label
     4853       .
     4854   end.
     4855   end procedure.
     4856   procedure gds-obj-ref-proc :
     4857   define output parameter p-description as character no-undo .
     4858   define variable v-tooltip as character no-undo .
     4859   define variable v-label as character no-undo .
     4860   define variable v-is-created as logical no-undo .
     4861   define variable v-field-name as character no-undo .
     4862   define variable v-field-label as character no-undo .
     4863   define variable v-field-function as character no-undo .
     4864   define variable jj as integer no-undo .
     4865   define buffer current_c-gds-obj-ref for ub.c-gds-obj-ref  .
     4866   define buffer curr_gds-obj for ub.gds-obj .
     4867   define buffer new_c-gds-obj-ref for ub.c-gds-obj-ref  .
     4868   do
     4869   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4870   :
     4871       find first current_c-gds-obj-ref no-lock where
     4872                  current_c-gds-obj-ref.gds-code = p-gds-code
     4873              AND current_c-gds-obj-ref.chip-num = p-chip-num
     4874              AND current_c-gds-obj-ref.corr-user-db-num = p-corr-user-db-num
     4875              no-error .
     4876       if not avail current_c-gds-obj-ref then do:
     4877         v-mess  = "Неверная ссылка на c-gds-obj-ref в таблице c-gds-hist".
     4878         run err-mess in this-procedure ( input-output v-mess).
     4879         return error v-mess.
     4880       end.
     4881       find first new_c-gds-obj-ref no-lock where
     4882                   new_c-gds-obj-ref.gds-code = p-gds-code
     4883               AND new_c-gds-obj-ref.chip-num > p-chip-num
     4884               AND new_c-gds-obj-ref.corr-user-db-num = p-corr-user-db-num  no-error.
     4885       if not available new_c-gds-obj-ref then do:
     4886         find first curr_gds-obj no-lock where
     4887                     curr_gds-obj.gds-code = buf_c-gds-hist.gds-code
     4888                 and curr_gds-obj.obj-type = buf_c-gds-hist.obj-type
     4889                 and curr_gds-obj.obj-code = buf_c-gds-hist.obj-code
     4890                 no-error.
     4891         if not available curr_gds-obj then do:
     4892             return error.
     4893         end.
     4894         buffer-compare curr_gds-obj to current_c-gds-obj-ref
     4895         case-sensitive
     4896         save result in v-chg-fields.
     4897       end.
     4898       else do:
     4899         buffer-compare new_c-gds-obj-ref except chip-num corr-date corr-user-name corr-user-db-num corr-time
     4900         to current_c-gds-obj-ref
     4901         case-sensitive
     4902         save result in v-chg-fields.
     4903       end.
     4904   v-is-created = (buf_c-gds-hist.action = integer('1':U)).
     4905   if v-chg-fields = '' and
     4906   v-is-created = yes then do:
     4907     v-chg-fields = "obj-type,obj-code".
     4908   end.
     4909     _ii:
     4910     do ii = 1 to num-entries(v-chg-fields):
     4911       assign
     4912       v-field-name = entry(ii, v-chg-fields)
     4913       jj = lookup(v-field-name, "cash-parts,insalepr,place-rsrv,obj-type,obj-code").
     4914       if jj = 0 then next _ii.
     4915       assign
     4916       v-field-label = entry(jj, "Продажа по партиям,Приход по продаж цене,Мин.запас,Резервирование по скл.местам,Тип объекта,Код объекта")
     4917       v-field-function = entry(jj, ",,,,")
     4918       .
     4919       create temp-changes.
     4920       assign
     4921       temp-changes.f_name = v-field-name
     4922       temp-changes.l_name = v-field-label
     4923       temp-changes.v_old = (if v-is-created
     4924                             then "":U
     4925                             else string(buffer current_c-gds-obj-ref:buffer-field(v-field-name):buffer-value))
     4926       temp-changes.v_new = (if available new_c-gds-obj-ref
     4927                             then string(buffer new_c-gds-obj-ref:buffer-field(v-field-name):buffer-value)
     4928                             else string(buffer curr_gds-obj:buffer-field(v-field-name):buffer-value)
     4929                             )
     4930       .
     4931       if v-field-function <> '':U then do:
     4932         assign
     4933         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4934         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4935         .
     4936       end.
     4937     end.
     4938   end.
     4939   end procedure.
     4940   PROCEDURE err-mess:
     4941     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     4942     CASE p-silent:
     4943       when yes then do:
     4944         p-mess =  substitute("История товара с кодом &1: щепка &2 БД:&3 фирма: &4 объект: &5&6 Предмет изменений &7&8&9"
     4945                               ,p-gds-code
     4946                               ,p-chip-num
     4947                               ,p-corr-user-db-num
     4948                               ,p-host-code
     4949                               ,p-obj-type
     4950                               ,p-obj-code
     4951                               ,p-subject
     4952                               ,chr(10)
     4953                               ,p-mess).
     4954       end.
     4955       otherwise do:
     4956         message
     4957         p-mess
     4958         view-as alert-box error .
     4959       end.
     4960     end.
     4961   END PROCEDURE.
