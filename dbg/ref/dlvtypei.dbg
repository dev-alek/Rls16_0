        1   DEFINE BUFFER locked_delivery-type FOR ub.delivery-type.
        2   DEFINE TEMP-TABLE tt-delivery-type NO-UNDO LIKE ub.delivery-type.
        3   DEFINE BUFFER X_curr_clients FOR ub.clients.
        4   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
        6   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
        7   define input parameter p-mode as character no-undo.
        8   DEFINE INPUT PARAMETER p-deliv-type-code LIKE ub.delivery-type.deliv-type-code NO-UNDO.
        9   define input-output parameter p-doc-rec as recid no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Карточка редактирования ТИПА ДОСТАВКИ".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define variable v-tab-order as character no-undo.
      122   define variable v-db-num LIKE ub.db.db-num no-undo.
      123   define variable v-last-code like ub.delivery-type.deliv-type-code no-undo.
      124   DEFINE BUTTON B-exit AUTO-GO
      125        LABEL "&Ввод"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE BUTTON B-Help
      129        LABEL "Помо&щь"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON B-Hist
      133        LABEL "Ис&тория"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON b-quit AUTO-END-KEY
      137        LABEL "&Отмена"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE QUERY Dialog-Frame FOR
      141         tt-delivery-type SCROLLING.
      142   DEFINE FRAME Dialog-Frame
      143        B-exit AT ROW 1 COL 1
      144        b-quit AT ROW 1 COL 11
      145        B-Hist AT ROW 1 COL 51
      146        B-Help AT ROW 1 COL 61
      147        tt-delivery-type.deliv-type-code AT ROW 3 COL 34 COLON-ALIGNED
      148             LABEL "Внутр.код типа доставки"
      149             VIEW-AS FILL-IN
      150             SIZE 11 BY 1
      151        tt-delivery-type.deliv-type-name AT ROW 4.25 COL 34 COLON-ALIGNED
      152             LABEL "Название типа доставки"
      153             VIEW-AS FILL-IN
      154             SIZE 63 BY 1
      155        tt-delivery-type.des AT ROW 10 COL 1 NO-LABEL
      156             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      157             SIZE 98 BY 3.75
      158        "Описание" VIEW-AS TEXT
      159             SIZE 16 BY 1 AT ROW 8.75 COL 1.5
      160        SPACE(81.74) SKIP(4.49)
      161       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      162            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      163            TITLE "Тип доставки"
      164            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      165   ASSIGN
      166          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      167          FRAME Dialog-Frame:HIDDEN           = TRUE.
      168   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      169   DO:
      170     APPLY "END-ERROR":U TO SELF.
      171   END.
      172   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      173   DO:
      174       run proc-save in this-procedure no-error.
      175     if error-status:error then return no-apply.
      176   END.
      177   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      178   DO:
      179     define variable v-rid-list as character no-undo.
      180       run ref/dlvctyps.w
      181                   (
      182                    input parParentProc
      183                   ,INPUT p-curr-obj-type
      184                   ,INPUT p-curr-obj-code
      185                   ,input "":U
      186                   ,input "one":U
      187                   ,input locked_delivery-type.deliv-type-code
      188                   ,input-output v-rid-list
      189                                 )
      190    .
      191   END.
      192   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      193   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      194   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   on help of frame Dialog-Frame
      196   do:
      197     run gbl/app_help.p
      198       (input this-procedure :file-name
      199       ,input ''
      200       ,input ?
      201       ) no-error.
      202     if error-status :error then do:
      203       message
      204         "Ошибка при вызове помощи"
      205         error-status :get-message(1)
      206         view-as alert-box .
      207     end.
      208   end.
      209   run minbtn-set in this-procedure .
      210   on choose of b-help in frame Dialog-Frame
      211   do:
      212     apply "help":u to frame Dialog-Frame .
      213   end.
      214   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      215   procedure minbtn-set :
      216       do
      217           on error undo, return error return-value
      218           :
      219           define variable ii              as integer       no-undo .
      220           define variable fh              as widget-handle no-undo .
      221           define variable hh              as widget-handle no-undo .
      222           define variable v-h             as handle        extent 4 no-undo .
      223           define variable v-name-button   as character     no-undo .
      224           define variable v-help-old-x    as decimal       no-undo .
      225           define variable v-help-old-y    as decimal       no-undo .
      226           define variable v-help-old-size as decimal       no-undo .
      227           define variable v-frame-width   as decimal       no-undo .
      228           define variable jj              as integer       no-undo .
      229           do
      230               on error undo, return error
      231               :
      232               assign
      233                   v-frame-width = frame Dialog-Frame:width - 0.3
      234                   fh            = frame Dialog-Frame:first-child
      235                   hh            = fh:first-child
      236                   ii            = 1
      237                   .
      238               do while valid-handle(hh):
      239                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      240                   do:
      241                       case lc(hh:name) :
      242                           when "b-help" then
      243                               do:
      244                                   hh:load-image-up("cmp/b-help.bmp":u) .
      245                                   hh:load-image-down("cmp/b-help.bmp":u) .
      246                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      247                                   hh:TOOLTIP = "Помощь" .
      248                                   v-help-old-x = hh:column .
      249                                   v-help-old-y = hh:row    .
      250                                   v-help-old-size = hh:width .
      251                                   hh:width-chars = 2.5 .
      252                               end.
      253                           when "b-print" then
      254                               do:
      255                                   hh:load-image("cmp/b-print.bmp":u) .
      256                                   hh:TOOLTIP = "Печать" .
      257                                   v-h[ii] = hh:handle .
      258                                   ii = ii + 1 .
      259                                   hh:width-chars = 3 .
      260                               end.
      261                           when "b-history" or
      262                           when "b-hist" then
      263                               do:
      264                                   hh:load-image("cmp/b-hist.bmp":u) .
      265                                   hh:TOOLTIP = "История" .
      266                                   v-h[ii] = hh:handle .
      267                                   ii = ii + 1 .
      268                                   hh:width-chars = 3 .
      269                               end.
      270                           when "b-sch" then
      271                               do:
      272                                   hh:load-image("cmp/b-sch.bmp":u) .
      273                                   hh:TOOLTIP = "Установка Фильтра" .
      274                                   v-h[ii] = hh:handle .
      275                                   ii = ii + 1 .
      276                                   hh:width-chars = 3 .
      277                               end.
      278                           when "b-hist-user" then
      279                               do:
      280                                   hh:load-image("cmp/b-hist.bmp":u) .
      281                                   hh:TOOLTIP = "История пользователя" .
      282                                   ii = ii + 1 .
      283                               end.
      284                       end case.
      285                   end.
      286                   hh = hh:next-sibling.
      287               end.
      288               b-help:column = v-frame-width - b-help:width-chars.
      289               jj = 0.
      290               repeat ii = 4 to 1 by -1 :
      291                   if valid-handle (v-h[ii] ) then
      292                   do:
      293                       jj  = jj + 1 .
      294                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      295                       v-h[ii]:row    = v-help-old-y .
      296                   end.
      297               end.
      298           end.
      299       end.
      300   end procedure.
      301   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      302   ON TAB ANYWHERE
      303   DO:
      304   define variable ii as integer no-undo .
      305   define variable fh as widget-handle no-undo .
      306   define variable hh as widget-handle no-undo .
      307   define variable v-next-widget-name as character no-undo .
      308   if v-tab-order <> '' then do:
      309     if self:type = "TOGGLE-BOX" then
      310     self:BGCOLOR = ?.
      311     assign
      312     ii = lookup(self:name, v-tab-order).
      313     assign
      314     ii = ii + 1
      315     v-next-widget-name = entry(ii, v-tab-order)
      316     no-error .
      317     if error-status:error then do:
      318       assign
      319       ii = 1
      320       v-next-widget-name = entry( ii, v-tab-order)
      321       .
      322     end.
      323     assign
      324     fh = frame Dialog-Frame:first-child
      325     hh = fh:first-child
      326     .
      327     do while valid-handle(hh):
      328       if hh:name = v-next-widget-name then do:
      329         if hh:sensitive  = yes
      330         AND hh:visible = yes then do:
      331           APPLY "ENTRY" to hh.
      332           return no-apply.
      333         end.
      334         else do:
      335           APPLY "TAB" to hh.
      336           return no-apply.
      337         end.
      338       end.
      339       hh = hh:next-sibling.
      340     end.
      341   end.
      342   END.
      343   ON BACK-TAB ANYWHERE
      344   DO:
      345   define variable ii as integer no-undo .
      346   define variable fh as widget-handle no-undo .
      347   define variable hh as widget-handle no-undo .
      348   define variable v-next-widget-name as character no-undo .
      349   if v-tab-order <> '' then do:
      350     assign
      351     ii = lookup(self:name, v-tab-order).
      352     .
      353     assign
      354     ii = (if ii = 1
      355           then  num-entries(v-tab-order)
      356           else ii - 1
      357           )
      358     v-next-widget-name = entry(ii, v-tab-order)
      359     .
      360     assign
      361     fh = frame Dialog-Frame:first-child
      362     hh = fh:first-child
      363     .
      364     do while valid-handle(hh):
      365       if hh:name = v-next-widget-name then do:
      366         if hh:sensitive  = yes
      367         AND hh:visible = yes then do:
      368           APPLY "ENTRY" to hh.
      369           return no-apply.
      370         end.
      371         else do:
      372         APPLY "BACK-TAB" to hh.
      373         return no-apply.
      374         end.
      375       end.
      376       hh = hh:next-sibling.
      377     end.
      378     end.
      379   END.
      380   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   ON RETURN ANYWHERE
      382   DO:
      383   define variable ii as integer no-undo .
      384   define variable fh as widget-handle no-undo .
      385   define variable hh as widget-handle no-undo .
      386   define variable v-next-widget-name as character no-undo .
      387     if v-tab-order <> '' then do:
      388       assign
      389       ii = lookup(self:name, v-tab-order).
      390       if ii = num-entries(v-tab-order) then do:
      391           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      392           return no-apply.
      393       end.
      394       if self:type <> "BUTTON" and
      395         self:type <> "EDITOR"  then do:
      396         run proc-move-forward in this-procedure .
      397         return no-apply.
      398       end.
      399       if self:type = "BUTTON" then do:
      400         APPLY "CHOOSE" to self.
      401       end.
      402       if self:type = "TOGGLE-BOX" then
      403       self:BGCOLOR = ?.
      404       assign
      405       ii = ii + 1
      406       v-next-widget-name = entry(ii, v-tab-order)
      407       no-error .
      408       if error-status:error then do:
      409         assign
      410         ii = 1
      411         v-next-widget-name = entry( ii, v-tab-order)
      412         .
      413       end.
      414       assign
      415       fh = frame Dialog-Frame:first-child
      416       hh = fh:first-child
      417       .
      418       do while valid-handle(hh):
      419         if hh:name = v-next-widget-name then do:
      420           if hh:sensitive  = yes
      421           AND hh:visible = yes then do:
      422             if hh:type = "TOGGLE-BOX":U then do:
      423               assign
      424               hh:BGcolor = 1
      425               .
      426             end.
      427             APPLY "ENTRY" to hh.
      428             return no-apply.
      429           end.
      430           else do:
      431             APPLY "TAB" to hh.
      432             return no-apply.
      433           end.
      434         end.
      435         hh = hh:next-sibling.
      436       end.
      437     end.
      438   END.
      439   procedure proc-move-forward :
      440   define variable ii as integer no-undo .
      441   define variable fh as widget-handle no-undo .
      442   define variable hh as widget-handle no-undo .
      443   define variable v-next-widget-name as character no-undo .
      444   do
      445   on error undo, return error
      446   :
      447     if v-tab-order <> '' then do:
      448       if self:type = "TOGGLE-BOX" then
      449       self:BGCOLOR = ?.
      450       assign
      451       ii = lookup(self:name, v-tab-order).
      452       assign
      453       ii = ii + 1
      454       v-next-widget-name = entry(ii, v-tab-order)
      455       no-error .
      456       if error-status:error then do:
      457         assign
      458         ii = 1
      459         v-next-widget-name = entry( ii, v-tab-order)
      460         .
      461       end.
      462       assign
      463       fh = frame Dialog-Frame:first-child
      464       hh = fh:first-child
      465       .
      466       do while valid-handle(hh):
      467         if hh:name = v-next-widget-name then do:
      468           if hh:sensitive  = yes
      469           AND hh:visible = yes then do:
      470             if hh:type = "TOGGLE-BOX":U then do:
      471               assign
      472               hh:BGcolor = 1
      473               .
      474             end.
      475             APPLY "ENTRY" to hh.
      476             return.
      477           end.
      478           else do:
      479             assign
      480             ii = ii + 1
      481             v-next-widget-name = entry(ii, v-tab-order)
      482             no-error .
      483             if error-status:error then do:
      484               assign
      485               ii = 1
      486               v-next-widget-name = entry( ii, v-tab-order)
      487               .
      488             end.
      489           end.
      490         end.
      491         hh = hh:next-sibling.
      492       end.
      493     end.
      494   end.
      495   end procedure.
      496   MAIN-BLOCK:
      497   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      498      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      499    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      500    and p-mode <> 'ИЗМЕНЕНИЕ':U
      501    and p-mode <> 'ПРОСМОТР':U
      502    then do:
      503       message
      504       vss-workfile vss-revision vss-description skip
      505       "Неверное значение параметров вызова p-mode"  p-mode
      506       view-as alert-box ERROR.
      507       undo, return error.
      508    end.
      509      find first X_curr_clients no-lock where
      510               X_curr_clients.obj-type = p-curr-obj-type
      511          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
      512     if not available X_curr_clients then do:
      513       message
      514       vss-workfile vss-revision vss-description skip
      515       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
      516       p-curr-obj-type p-curr-obj-code
      517       view-as alert-box ERROR.
      518       return error .
      519     end.
      520   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      521   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      522     (output v-db-num
      523     )  .
      524   IF v-db-num <> 0
      525   AND (p-mode = 'ДОБАВЛЕНИЕ':U
      526        OR p-mode = 'ИЗМЕНЕНИЕ':U ) THEN DO:
      527         message
      528       vss-workfile vss-revision vss-description skip
      529       "Неверное значение параметра вызова p-mode" p-mode skip
      530       "Нельзя редактировать запись ТИП ДОСТАВКИ в УБД"
      531       view-as alert-box ERROR.
      532       return error .
      533   END.
      534     for each tt-delivery-type:
      535       delete tt-delivery-type.
      536     end.
      537     if p-mode = 'ИЗМЕНЕНИЕ':U
      538     or p-mode = 'ПРОСМОТР':U then do:
      539       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      540         find first locked_delivery-type EXclusive-lock where
      541                      recid(locked_delivery-type) = p-doc-rec no-wait no-error.
      542         if locked locked_delivery-type then do:
      543           message
      544           vss-workfile vss-revision vss-description skip
      545            "Запись ТИП ДОСТАВКИ занята"
      546           view-as alert-box error .
      547           undo, return error.
      548         end.
      549       end.
      550       else do:
      551         find first locked_delivery-type no-lock where
      552                          recid(locked_delivery-type) = p-doc-rec no-error .
      553         if not avail locked_delivery-type then do:
      554           find first locked_delivery-type no-lock where
      555                      locked_delivery-type.deliv-type-code = p-deliv-type-code no-error .
      556         end.
      557       end.
      558       if not available locked_delivery-type then do:
      559         message
      560         vss-workfile vss-revision vss-description skip
      561         "Не найдена запись ТИП ДОСТАВКИ"
      562         view-as alert-box error .
      563         undo, return error.
      564       end.
      565       create tt-delivery-type.
      566       buffer-copy locked_delivery-type to tt-delivery-type.
      567      end.
      568      else do:
      569             create tt-delivery-type.
      570             assign
      571            tt-delivery-type.deliv-type-code = v-last-code + 1
      572            .
      573      end.
      574     RUN Myenable.
      575     WAIT-FOR GO OF FRAME Dialog-Frame.
      576   END.
      577   RUN disable_UI.
      578   PROCEDURE disable_UI :
      579     HIDE FRAME Dialog-Frame.
      580   END PROCEDURE.
      581   PROCEDURE enable_UI :
      582     OPEN QUERY Dialog-Frame FOR EACH tt-delivery-type SHARE-LOCK.
      583     GET FIRST Dialog-Frame.
      584     IF AVAILABLE tt-delivery-type THEN
      585       DISPLAY tt-delivery-type.deliv-type-code
      586             tt-delivery-type.deliv-type-name tt-delivery-type.des
      587         WITH FRAME Dialog-Frame.
      588     ENABLE B-exit b-quit B-Hist B-Help tt-delivery-type.deliv-type-code
      589            tt-delivery-type.deliv-type-name tt-delivery-type.des
      590         WITH FRAME Dialog-Frame.
      591     VIEW FRAME Dialog-Frame.
      592   END PROCEDURE.
      593   PROCEDURE MyENable :
      594   case p-mode:
      595     when 'ДОБАВЛЕНИЕ':U then do:
      596       display
      597       ? @ tt-delivery-type.deliv-type-code
      598       WITH FRAME Dialog-Frame.
      599     end.
      600     otherwise do:
      601       IF AVAILABLE tt-delivery-type THEN
      602       DISPLAY
      603       tt-delivery-type.deliv-type-code
      604       tt-delivery-type.deliv-type-name
      605       tt-delivery-type.des
      606       WITH FRAME Dialog-Frame.
      607     end.
      608   END CASE.
      609   if p-mode = 'ПРОСМОТР':U then do:
      610   assign
      611   b-quit:label = "&Выход"
      612   .
      613   hide
      614   b-exit in frame Dialog-Frame.
      615   end.
      616   ENABLE
      617   B-exit when p-mode <> 'ПРОСМОТР':U
      618   b-quit
      619   B-Hist when p-mode <> 'ДОБАВЛЕНИЕ':U
      620   B-Help
      621   tt-delivery-type.deliv-type-name when p-mode <> 'ПРОСМОТР':U
      622   tt-delivery-type.des when p-mode <> 'ПРОСМОТР':U
      623   WITH FRAME Dialog-Frame.
      624   VIEW FRAME Dialog-Frame.
      625   END PROCEDURE.
      626   PROCEDURE Proc-save :
      627   if p-mode = 'ПРОСМОТР':U then do:
      628       return error.
      629   end.
      630   if not available tt-delivery-type then do:
      631       create tt-delivery-type.
      632   end.
      633   assign
      634   tt-delivery-type.deliv-type-code frame Dialog-Frame
      635   tt-delivery-type.deliv-type-name
      636   tt-delivery-type.des = tt-delivery-type.des:SCREEN-VALUE
      637   .
      638    run ref/dlvtype1.p (
      639   input-output p-doc-rec
      640   ,input p-mode
      641   ,input tt-delivery-type.deliv-type-code
      642   ,input tt-delivery-type.deliv-type-name
      643   ,input tt-delivery-type.des
      644   )
      645   no-error.
      646   if error-status:error then do:
      647   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      648   define variable fh as widget-handle no-undo .
      649   define variable hh as widget-handle no-undo .
      650   define variable rv as character no-undo .
      651   assign
      652   rv = entry(1, return-value , chr(4)).
      653   if rv <> "":U then do:
      654     assign
      655     fh = frame Dialog-Frame:first-child
      656     hh = fh:first-child
      657     .
      658     do while valid-handle(hh):
      659       if hh:name = rv then do:
      660         APPLY "ENTRY" to hh.
      661         undo ,
      662         return error.
      663       end.
      664       hh = hh:next-sibling.
      665     end.
      666   end.
      667     undo, return error.
      668   end.
      669   END PROCEDURE.
