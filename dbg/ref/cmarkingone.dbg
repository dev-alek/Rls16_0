     3190     assign
     3191       v-label-handle22 = sch-corr-date :side-label-handle in frame Dialog-Frame
     3192     .
     3193     if valid-handle (v-label-handle22)
     3194     then do:
     3195       if v-label-handle22 :tooltip = ""
     3196       or v-label-handle22 :tooltip = ?
     3197       then do:
