      140   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   define variable c-point  as character no-undo .
      142   define variable tbl      as character no-undo .
      143   define variable join-tbl as character no-undo .
      144   define variable fld      as character no-undo .
      145   define variable lab      as character no-undo .
      146   define variable spr      as character no-undo .
      147   define variable dim      as character no-undo .
      148   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149   procedure cur-time :
      150      define output parameter p-today as date      no-undo .
      151      define output parameter p-time  as integer   no-undo .
      152     do
      153     on error undo, return error
      154     :
      155       define variable v-date1 as date      no-undo .
      156       define variable v-date2 as date      no-undo .
      157       define variable v-time  as integer   no-undo .
      158       assign
      159         v-date1 = today
      160         v-time  = time
      161         v-date2 = today
      162       .
      163       if v-date1 <> v-date2
      164       then do:
      165         assign
      166           v-date1 = today
      167           v-time  = v-time
      168         .
      169       end.
      170       assign
      171         p-today = v-date1
      172         p-time  = v-time
      173       .
      174     end.
      175   end.
      176   function cur-time-date returns character
      177   :
      178     return string(today, '99/99/9999':U) .
      179   end.
      180   function cur-time-mjd returns decimal
      181   :
      182     define variable v-date as date      no-undo .
      183     define variable v-time as integer   no-undo .
      184     run cur-time in this-procedure
      185       (output v-date
      186       ,output v-time
      187       ) .
      188     return integer(v-date) - 2400002 + (v-time / 86400) .
      189   end.
      190   function cur-time-get-ending-index returns integer
      191   (input p-number as integer
      192   )
      193   :
      194     if p-number < 0
      195     or p-number = ?
      196     then do:
      197       return 1 .
      198     end.
      199     define variable v-rest as integer   no-undo .
      200     assign
      201       p-number = p-number modulo 100
      202     .
      203     if p-number < 20
      204     then do:
      205       assign
      206         v-rest = p-number
      207       .
      208     end.
      209     else do:
      210       assign
      211         v-rest = p-number modulo 10
      212       .
      213     end.
      214     case v-rest :
      215       when 1
      216       then do:
      217         return 2 .
      218       end.
      219       when 2 or
      220       when 3 or
      221       when 4
      222       then do:
      223         return 3 .
      224       end.
      225       otherwise do:
      226         return 1 .
      227       end.
      228     end case .
      229   end.
      230   procedure cur-time-mjd-to-date :
      231      define input  parameter i-mjd-diff as decimal no-undo.
      232      define output parameter o-Date     as date    no-undo.
      233      define output parameter o-Time     as integer no-undo.
      234      define variable v-day-number as integer   no-undo .
      235      if    i-mjd-diff < 0
      236         or i-mjd-diff = ?
      237      then do:
      238         return "?" .
      239      end.
      240      assign
      241         v-day-number = truncate(i-mjd-diff,0).
      242         o-Date = date(v-day-number + 2400002).
      243         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      244     .
      245   end.
      246   function cur-time-mjd-to-string returns character
      247   (input p-mjd-diff as decimal
      248   )
      249   :
      250     define variable v-day-number as integer   no-undo .
      251     define variable v-seconds    as integer   no-undo .
      252     define variable v-hour       as integer   no-undo .
      253     define variable v-min        as integer   no-undo .
      254     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      255     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      256     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      257     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      258     if p-mjd-diff < 0
      259     or p-mjd-diff = ?
      260     then do:
      261       return "?" .
      262     end.
      263     assign
      264       v-day-number = integer(truncate(p-mjd-diff,0))
      265       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      266     .
      267     if v-seconds > 86400
      268     then do:
      269       assign
      270         v-seconds = 86400 - 1
      271       .
      272     end.
      273     if v-seconds < 0
      274     then do:
      275       assign
      276         v-seconds = 0
      277       .
      278     end.
      279     assign
      280       v-hour = truncate(v-seconds / 3600, 0)
      281     .
      282     assign
      283       v-seconds = v-seconds modulo 3600
      284     .
      285     assign
      286       v-min = truncate(v-seconds / 60, 0)
      287     .
      288     assign
      289       v-seconds = v-seconds modulo 60
      290     .
      291     return
      292         (if v-day-number <> 0
      293           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      294           else ""
      295         )
      296       + (if v-day-number <> 0 or v-hour <> 0
      297           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      298           else ""
      299         )
      300       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      301           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      302           else ""
      303         )
      304       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      305       .
      306   end.
      307   function cur-time-string returns character
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      316   end.
      317   function cur-time-string-sec returns character
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      326   end.
      327   function cur-time-custom  returns character
      328   (input p-prefix as character
      329   ,input p-date-format as character
      330   ,input p-delimiter as character
      331   ,input p-time-format as character
      332   ,input p-suffix as character
      333   )
      334   :
      335     define variable v-date as date      no-undo .
      336     define variable v-time as integer   no-undo .
      337     run cur-time in this-procedure
      338       (output v-date
      339       ,output v-time
      340       ) .
      341     return
      342       p-prefix
      343       + string(v-date, p-date-format)
      344       + p-delimiter
      345       + string(v-time, p-time-format)
      346       + p-suffix
      347       .
      348   end.
      349   function cur-time-print  returns character
      350   :
      351     define variable v-date as date      no-undo .
      352     define variable v-time as integer   no-undo .
      353     run cur-time in this-procedure
      354       (output v-date
      355       ,output v-time
      356       ) .
      357     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      358   end.
      359   function cur-time-datetime returns datetime
      360   :
      361     define variable v-char as character no-undo .
      362     define variable v-datetime as datetime no-undo .
      363     v-char = cur-time-string().
      364     v-datetime = datetime(v-char).
      365     return  v-datetime.
      366   end.
      367   function cur-time-string-msec returns character
      368   :
      369     define variable v-date as datetime  no-undo .
      370     v-date = now.
      371     return string(v-date) .
      372   end.
      373   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      375   define new shared variable RepPathName        as character no-undo .
      376   define new shared variable PrintRubl          as logical   no-undo .
      377   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   define variable v-waitfram-action01         as character   no-undo .
      379   define variable v-waitfram-action02         as character   no-undo .
      380   define variable v-waitfram-action03         as character   no-undo .
      381   define variable mWaitFramTextBeg            as character   no-undo.
      382   define variable mWaitFramTextEnd            as character   no-undo.
      383   define variable mWaitFramView               as logical     no-undo.
      384   define variable mWaitProcEvent              as logical     no-undo init yes.
      385   define variable mWaitFramInterval           as integer     no-undo init 1 .
      386   define variable mWaitFramStop               as logical     no-undo.
      387   define variable mWaitFramStopUser           as logical     no-undo.
      388   define variable mWaitFramStopTimeOut        as logical     no-undo.
      389   define variable mWaitFramStartProc          as datetime-tz no-undo.
      390   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      391   define button B-WaitFramStop auto-end-key
      392        label "Стоп"
      393        size 10 by 1 tooltip "Остоновить процесс".
      394   define button B-viewProcInfo
      395        label "Информация"
      396        size 15 by 1 tooltip "Информация о процесс".
      397   define frame waitfram
      398     v-waitfram-action01 format "x(72)" no-label skip
      399     v-waitfram-action02 format "x(72)" no-label skip
      400     v-waitfram-action03 format "x(72)" no-label skip
      401     B-viewProcInfo
      402     B-WaitFramStop at row 4 col 30
      403     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      404     .
      405   define new global shared variable mBatchMode as logical no-undo init ?.
      406   define variable mFramBachModHandle as handle no-undo.
      407   mFramBachModHandle = frame waitfram:handle.
      408   define variable mFameOldVis as logical no-undo.
      409   define variable mVisCUrentVin as logical no-undo.
      410   if session:batch-mode
      411   then
      412      mBatchMode = yes.
      413   if mBatchMode = ? then do:
      414     mVisCUrentVin = current-window:visible.
      415     mFameOldVis = mFramBachModHandle:visible.
      416     mFramBachModHandle:visible  = yes.
      417     mBatchMode = mFramBachModHandle:visible ne yes.
      418     mFramBachModHandle:visible = mFameOldVis.
      419     current-window:visible = mVisCUrentVin.
      420   end.
      421    if  log-manager:logfile-name ne ?
      422     then DO:
      423         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      424         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      425         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      426     end.
      427   on choose of B-WaitFramStop in frame waitfram
      428   do:
      429     mWaitFramStop = yes.
      430     mWaitFramStopUser = yes.
      431   end.
      432   function waitfram-check-timeout returns logical():
      433      define variable vtime as int64 no-undo.
      434      if mWaitFramStopTimeOut
      435      then
      436         return yes.
      437      vtime = ( now - mWaitFramStartProc ) / 1000 .
      438      if     mWaitFramTimeOut ne ?
      439         and mWaitFramTimeOut ne 0
      440         and mWaitFramTimeOut lt vtime
      441      then do:
      442         mWaitFramStopTimeOut = yes.
      443      end.
      444      return mWaitFramStopTimeOut.
      445   end.
      446   procedure waitfram-hide :
      447     if not session:batch-mode
      448     then do
      449     on error undo, return error return-value
      450     :
      451       pause 0 before-hide .
      452       if not mBatchMode then
      453         hide frame waitfram .
      454     end.
      455   end procedure.
      456   procedure waitfram-show :
      457     define input  parameter p-message as character no-undo .
      458     define variable v-left-margin as integer   no-undo .
      459     if not session:batch-mode
      460     then do
      461     on error undo, return error return-value
      462     :
      463       if length(p-message) <= 70 then do:
      464         assign
      465           v-left-margin = integer((70 - length(p-message)) / 2)
      466         .
      467         assign
      468           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      469         .
      470         assign
      471           v-waitfram-action01 = " "
      472           v-waitfram-action02 = " "
      473                                    + fill(" ", v-left-margin)
      474                                    + p-message
      475           v-waitfram-action03 = " "
      476         .
      477       end.
      478       else do:
      479         define variable vRindex1 as integer no-undo.
      480         define variable vRindex2 as integer no-undo.
      481         vRindex1 = r-index(p-message," ",70).
      482         if vRindex1 = 0
      483         then
      484            vRindex1 = 70.
      485         if length(p-message)  <= vRindex1 + 70 then do:
      486           assign
      487             v-waitfram-action01 = " "
      488             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      489             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      490           .
      491         end.
      492         else do:
      493           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      494           if vRindex2 <= vRindex1
      495           then
      496              vRindex2 = vRindex1 + 70.
      497           assign
      498             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      499             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      500             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      501           .
      502         end.
      503       end.
      504       B-viewProcInfo:visible   in frame waitfram = no.
      505       B-viewProcInfo:sensitive in frame waitfram = no.
      506       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      507       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      508       if  (   mWaitFramView
      509          or  mWaitProcEvent)
      510          and not mBatchMode
      511       then
      512          display
      513             v-waitfram-action01 skip
      514             v-waitfram-action02 skip
      515             v-waitfram-action03 skip
      516          with frame waitfram .
      517     end.
      518   end procedure.
      519      procedure waitfram-show-this:
      520         define input  parameter iInterval as int64 no-undo.
      521         define variable vtime as int64 no-undo.
      522         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      523         mWaitFramInterval = iInterval.
      524         run waitfram-show (substitute("&1&2 &3&4" ,
      525                                       mWaitFramTextBeg ,
      526                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      527                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      528                                       mWaitFramTextEnd
      529                                      )
      530                           ).
      531      end.
      532      procedure WaitFramRunPause:
      533         define input  parameter iInterval as dec no-undo.
      534         define variable vStart  as datetime-tz no-undo.
      535         define variable vend    as datetime-tz no-undo.
      536         define variable vint as int64 no-undo.
      537         define variable vOk as logical no-undo.
      538         vStart = now.
      539         vend   = vStart.
      540         publish "WaitFramPause" (iInterval,output vOk).
      541         vend   =  now.
      542         vint = vend - vStart.
      543         vint = iInterval - vint / 1000.
      544         if     not mWaitFramStop
      545            and (   vint > 0
      546                 or (    not vOk
      547                     and iInterval eq ?
      548                     )
      549                 )
      550         then
      551            run waitfram-show-this (iInterval).
      552         vend   =  now.
      553         vint = vend - vStart.
      554         vint = iInterval - vint / 1000.
      555         if     not mWaitFramStop
      556            and vint > 0
      557         then do:
      558            run gbl/pause.p (vint * 1000).
      559         end.
      560         if iInterval ne ?
      561         then
      562            publish "WaitFramStop".
      563         waitfram-check-timeout().
      564      end.
      565      procedure WaitFramWaitFor:
      566         define input  parameter iInterval as dec no-undo.
      567         assign
      568            mWaitFramStartProc   = now
      569            mWaitFramStopUser    = no
      570            mWaitFramStopTimeOut = no
      571         .
      572         block-wait:
      573         do while not mWaitFramStop:
      574            run WaitFramRunPause (iInterval).
      575            if  waitfram-check-timeout()
      576            then do:
      577               leave block-wait.
      578            end.
      579         end.
      580         run waitfram-hide.
      581      end.
      582   procedure waitfram-join :
      583     define input  parameter p-line-1  as character no-undo .
      584     define input  parameter p-line-2  as character no-undo .
      585     define input  parameter p-line-3  as character no-undo .
      586     define output parameter p-message as character no-undo .
      587     do
      588     on error undo, return error return-value
      589     :
      590       assign
      591         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      592                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      593                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      594       .
      595     end.
      596   end procedure.
      597   function waitfram-join-function returns character
      598     (input p-line-1 as character
      599     ,input p-line-2 as character
      600     ,input p-line-3 as character
      601     ).
      602     define variable v-message as character no-undo .
      603     run waitfram-join in this-procedure
      604       (input  p-line-1
      605       ,input  p-line-2
      606       ,input  p-line-3
      607       ,output v-message
      608       ) .
      609     return v-message .
      610   end function .
      611   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   procedure fltfield-clear :
      613     define output parameter loc-fld as character no-undo.
      614     define output parameter loc-lab as character no-undo .
      615     define output parameter loc-spr as character no-undo .
      616     define output parameter loc-dim as character no-undo .
      617     assign
      618       loc-fld = ""
      619       loc-lab = ""
      620       loc-spr = ""
      621       loc-dim = "0"
      622     .
      623   end procedure .
      624   procedure fltfield-add :
      625     define input        parameter par-fld as character no-undo.
      626     define input        parameter par-lab as character no-undo .
      627     define input        parameter par-spr as character no-undo .
      628     define input-output parameter loc-fld as character no-undo.
      629     define input-output parameter loc-lab as character no-undo .
      630     define input-output parameter loc-spr as character no-undo .
      631     define input-output parameter loc-dim as character no-undo .
      632     do
      633     on error undo, return error
      634     :
      635       assign
      636       loc-fld = if loc-dim = '0'
      637                 then par-fld
      638                 else (loc-fld + chr(44) + par-fld)
      639       loc-lab = if loc-dim = '0'
      640                 then par-lab
      641                 else (loc-lab + chr(44) + par-lab)
      642       loc-spr = if loc-dim = '0'
      643                 then par-spr
      644                 else (loc-spr + chr(44) + par-spr)
      645       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      646                 string(integer(if num-entries(loc-dim) > 1
      647                               then entry(2, loc-dim)
      648                               else entry(1, loc-dim)
      649                               ) + 1)
      650       no-error
      651       .
      652     end.
      653   end procedure.
