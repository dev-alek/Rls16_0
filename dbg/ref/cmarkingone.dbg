     2938   procedure get-context :
     2939      define output parameter p-db-num as integer          no-undo.
     2940      define output parameter p-user-id as character        no-undo.
     2941      define variable v-login               as character    no-undo.
     2942      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2943      define buffer buf_user-login  for ub.user-login .
     2944      do
     2945      on error undo, return error
     2946      :
     2947            FIND FIRST buf_sys-ctrl no-lock.
     2948            ASSIGN
     2949               v-login = USERID("ub")
     2950               p-db-num = buf_sys-ctrl.db-num
     2951            .
     2952            FIND FIRST buf_user-login
     2953                 WHERE buf_user-login.db-num = p-db-num
     2954                   AND buf_user-login.user-login = v-login
     2955                 no-lock
     2956                 no-error
     2957                 .
     2958            IF AVAILABLE buf_user-login
     2959            THEN DO:
     2960               assign
     2961                  p-user-id = buf_user-login.user-id
     2962               .
     2963            END.
     2964      end.
     2965   end procedure.
