      799   procedure prn-lib-reportviewer :
      800     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      801     define input parameter p-report-name-html as character no-undo .
      802     define input parameter p-param        as character no-undo .
      803     define variable v-excel           as character no-undo init 'TRUE' .
