     3738   define variable  where-phrase-29     as character no-undo .
     3739   define variable  sort-phrase-29      as character no-undo .
     3740   define variable  where-phrase-rus-29 as character no-undo .
     3741   define variable  sort-phrase-rus-29  as character no-undo .
     3742     run waitfram-show in this-procedure
     3743       (input "ЖДИТЕ ..."
     3744       ).
