      876   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      877   procedure fltopend_fltopend :
      878   define input parameter p-parent-handle as handle no-undo .
      879   define input parameter p-qh as handle no-undo .
      880   define input parameter p-flt-open-open-query  as character no-undo .
      881   define input parameter p-where-cond as character no-undo .
      882   define input parameter p-use-indFIRST-query-tail as character no-undo .
      883   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      884   define input parameter p-indexed-reposition as character no-undo .
      885     do
      886     on error undo, return error
      887     :
      888   define variable v-prepare-string as character no-undo .
      889   define variable glog as logical no-undo .
      890   assign
      891   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      892                      p-where-cond + chr(32)  +
      893                      p-use-indFIRST-query-tail + chr(32) +
      894                      p-use-ind-sort-clmn-by + chr(32) +
      895                      p-indexed-reposition
      896   .
      897   assign
      898   glog = p-qh:query-prepare(v-prepare-string) no-error .
      899   if not glog
      900   or error-status:error then do:
      901     message error-status:get-message(1) view-as alert-box .
      902     undo, return error .
      903   end.
      904   assign
      905   glog = p-qh:query-open no-error .
      906   if not glog
      907   or error-status:error then do:
      908     message error-status:get-message(1) view-as alert-box .
      909     undo, return error .
      910   end.
      911     end.
      912   end procedure.
      913   procedure fltopend_fltfindd :
      914   define input parameter p-parent-handle as handle no-undo .
      915   define input parameter p-qh as handle no-undo .
      916   define input parameter p-rowid as rowid no-undo .
      917   define input parameter p-next as logical no-undo .
      918   define input parameter p-lock as integer no-undo .
      919   define input parameter p-bh as handle no-undo .
      920   define input parameter p-where-cond as character no-undo .
      921   define input parameter p-use-index-phrase as character no-undo .
      922   define variable glog as logical no-undo .
      923   define variable v-qh as handle no-undo .
      924   define variable v-bh as handle no-undo .
      925   define variable v-recid as recid no-undo .
      926   define variable v-prepare-string as character no-undo .
      927   do
      928   on error undo, return error
      929   on stop undo, return error
      930   :
      931     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      932     create buffer v-bh for table p-bh buffer-name p-bh:name.
      933     create query v-qh.
      934     v-qh:set-buffers(v-bh).
      935     v-prepare-string = substitute("for each &1 &2 &3"
      936                                     ,v-bh:name
      937                                     ,p-where-cond
      938                                     ,p-use-index-phrase).
      939     glog = v-qh:query-prepare(v-prepare-string) no-error.
      940     if not glog then do:
      941       delete object v-qh.
      942       delete object v-bh.
      943       undo, return error .
      944     end.
      945     glog = v-qh:query-open no-error .
      946     if not glog then do:
      947       delete object v-qh.
      948       delete object v-bh.
      949       undo, return error .
      950     end.
      951     if p-next then do:
      952       v-qh:reposition-to-rowid(p-rowid) no-error .
      953       glog = v-qh:get-next( p-lock) no-error .
      954       glog = v-qh:get-next( p-lock) no-error .
      955       if not glog or v-qh:query-off-end = yes then do:
      956         glog = v-qh:get-first( p-lock) no-error .
      957       end.
      958     end.
      959     else do:
      960       glog = v-qh:get-first( p-lock) no-error .
      961     end.
      962     v-recid = v-bh:recid no-error .
      963     delete object v-qh.
      964     delete object v-bh.
      965     return string(v-recid) .
      966   end.
      967   end procedure.
      968   procedure fltopend_fltfindq :
      969   define input parameter p-parent-handle as handle no-undo .
      970   define input parameter p-qh as handle no-undo .
      971   define input parameter p-next as logical no-undo .
      972   define input parameter p-lock as integer no-undo .
      973   define input parameter p-flt-open-open-query  as character no-undo .
      974   define input parameter p-where-cond as character no-undo .
      975   define input parameter p-use-indFIRST-query-tail as character no-undo .
      976   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      977   define input parameter p-indexed-reposition as character no-undo .
      978   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      979   define variable glog as logical no-undo .
      980   define variable v-qh as handle no-undo .
      981   define variable v-bh as handle no-undo extent 18.
      982   define variable v-rowid as rowid no-undo extent 18.
      983   define variable v-ii as integer no-undo .
      984   define variable v-prepare-string as character no-undo .
      985   do
      986   on error undo, return error
      987   on stop undo, return error
      988   :
      989     create query v-qh.
      990     do v-ii = 1 to p-qh:num-buffers:
      991       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      992       assign
      993       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      994       no-error.
      995       v-qh:add-buffer(v-bh[v-ii]).
      996     end.
      997     assign
      998     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      999                       p-where-cond + chr(32)  +
     1000                       p-use-indFIRST-query-tail + chr(32) +
     1001                       p-use-ind-sort-clmn-by + chr(32) +
     1002                       p-indexed-reposition
     1003     .
     1004     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1005     if not glog then do:
     1006       delete object v-qh.
     1007       do v-ii = 1 to p-qh:num-buffers:
     1008         delete object v-bh[v-ii].
     1009       end.
     1010       undo, return error .
     1011     end.
     1012     glog = v-qh:query-open no-error .
     1013     if not glog then do:
     1014       delete object v-qh.
     1015       do v-ii = 1 to p-qh:num-buffers:
     1016         delete object v-bh[v-ii].
     1017       end.
     1018       undo, return error .
     1019     end.
     1020     if p-next then do:
     1021       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1022       glog = v-qh:get-next( p-lock) no-error .
     1023       glog = v-qh:get-next( p-lock) no-error .
     1024       if not glog or v-qh:query-off-end = yes then do:
     1025         glog = v-qh:get-first( p-lock) no-error .
     1026       end.
     1027     end.
     1028     else do:
     1029       glog = v-qh:get-first( p-lock) no-error .
     1030     end.
     1031     do v-ii = 1 to p-qh:num-buffers:
     1032       assign
     1033       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1034       no-error.
     1035     end.
     1036     delete object v-qh.
     1037     do v-ii = 1 to p-qh:num-buffers:
     1038       delete object v-bh[v-ii].
     1039     end.
     1040   end.
     1041   end procedure.
