        1   define input  parameter iMark as character no-undo.
        2   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
        3   run gbl/getobjsrvhndl.p (input-output ObjSrv).
        4   define temp-table c-marking-hist no-undo like c-marking-attr
        5     field subject as character
        6     field is-news as logical
        7     field source-type as character
        8     field source-ref as character
        9   .
       10   define variable vLabel as character no-undo.
       11   vLabel = "История изменений по марке " + iMark.
       12   define temp-table X_c-obj-hist like c-marking-hist .
       13   DEFINE BUFFER find_c-obj-hist FOR X_c-obj-hist.
       14   DEFINE BUFFER X_curr-sysconf FOR sysconf.
       15   DEFINE BUFFER X_db FOR db.
       16   DEFINE BUFFER X_sysconf FOR sysconf.
       17   define input     parameter parParentProc  as widget-handle no-undo.
       18   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
       19   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       20   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       21   define input parameter bttns  as char   no-undo .
       22   define input parameter p-mode  as char   no-undo .
       23   define input parameter p-corr-user-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       24   define input parameter p-corr-user-name  like ub.c-cli-hist.corr-user-name no-undo .
       25   define input parameter p-subject  like ub.c-cli-hist.subject no-undo .
       26   define input parameter p-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       27   define input parameter p-chip-num  as int64 no-undo.
       28   define input-output param p-rid-list    as  char no-undo .
       29   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       30   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       31   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       32   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       33   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       34   define variable vss-description AS CHAR NO-UNDO INIT "Список полной истории":U.
       35   procedure vss-get-info :
       36     define output parameter p-vss-revision    like vss-revision    no-undo .
       37     define output parameter p-vss-author      like vss-author      no-undo .
       38     define output parameter p-vss-date        like vss-date        no-undo .
       39     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       40     define output parameter p-vss-archive     like vss-archive     no-undo .
       41     define output parameter p-vss-description like vss-description no-undo .
       42     assign
       43       p-vss-revision    = vss-revision
       44       p-vss-author      = vss-author
       45       p-vss-date        = vss-date
       46       p-vss-workfile    = vss-workfile
       47       p-vss-archive     = vss-archive
       48       p-vss-description = vss-description
       49     .
       50   end procedure.
       51   procedure vss-get-parameters :
       52     define output parameter p-vss-parameters as character no-undo .
       53   end procedure.
       54   define new global shared variable g#vssrevis-logger as handle    no-undo .
       55   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       56   define variable v-vssrevis-logger                   as handle    no-undo .
       57   procedure vss-logevent :
       58     define input  parameter p-extra-paramters as character no-undo .
       59     define variable v-vssrevis-parameters as character no-undo .
       60     do
       61     on error undo, return error return-value
       62     :
       63       if  valid-handle(v-vssrevis-logger)
       64       and v-vssrevis-logger :get-signature("logevent") <> ""
       65       then do:
       66         run vss-get-parameters in this-procedure
       67           (output v-vssrevis-parameters
       68           ).
       69         run logevent in v-vssrevis-logger
       70           (input vss-workfile
       71           ,input vss-revision
       72           ,input v-vssrevis-parameters
       73           ,input p-extra-paramters
       74           ).
       75       end.
       76     end.
       77   end procedure.
       78   assign
       79     v-vssrevis-logger = g#vssrevis-logger
       80   .
       81   if  valid-handle(v-vssrevis-logger)
       82   and v-vssrevis-logger :get-signature("logevent") <> ""
       83   then do:
       84     assign
       85       v-vssrevis-logevent = true
       86     .
       87     run vss-logevent in this-procedure (input vss-description) .
       88   end.
       89   define new global shared variable g#language as character no-undo .
       90   if g#language <> '' and g#language <> 'rus':U then do:
       91     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       92   end.
       93   define new global shared variable g#library  as handle no-undo .
       94   define new global shared variable g#library2 as handle no-undo .
       95   procedure proc-alt-shift-f2:
       96     if not ibs.th.gbl.gbl-var:rcode
       97   then
       98     run gbl\inidebug.p .
       99   end.
      100   procedure proc-alt-shift-f3:
      101     run gbl/prvssinf.p
      102       ( input this-procedure
      103       ) .
      104   end.
      105   define variable v-inform-launched as logical no-undo initial false .
