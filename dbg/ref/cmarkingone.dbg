     3175   end.
     3176     define MENU m-ed-date22
     3177       MENU-ITEM m-ed-date22-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3178       MENU-ITEM m-ed-date22-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3179       MENU-ITEM m-ed-date22-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3180       MENU-ITEM m-ed-date22-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     3181       .
