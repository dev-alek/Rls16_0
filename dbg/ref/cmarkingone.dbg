     3082         .
     3083         assign
     3084           self :screen-value = string(v-new-sv-date) .
     3085         .
     3086       end.
     3087     end.
     3088     return no-apply .
     3089   end.
     3090   on ctrl-e of sch-corr-date in frame Dialog-Frame
     3091   do:
     3092     if (can-query (self, "sensitive")
     3093        and
     3094        self :sensitive = true
     3095        )
     3096     or (can-query (self, "read-only")
     3097        and
     3098        self :read-only = false
     3099        )
     3100     then do:
     3101       if self :handle <> focus :handle
     3102       then do:
     3103         apply "entry":u to self .
