     3043       run gbl/getcurdt.p
     3044         (output v-curr-sv-date
     3045         ) .
     3046       assign
     3047         self :screen-value = string(v-curr-sv-date) .
     3048       .
     3049     end.
     3050     return no-apply.
     3051   end.
     3052   on ctrl-b of sch-corr-date in frame Dialog-Frame
     3053   do:
     3054     if (can-query (self, "sensitive")
     3055        and
     3056        self :sensitive = true
     3057        )
     3058     or (can-query (self, "read-only")
     3059        and
     3060        self :read-only = false
     3061        )
     3062     then do:
     3063       if self :handle <> focus :handle
     3064       then do:
     3065         apply "entry":u to self .
     3066       end.
     3067       define variable v-curr-sv-date as date no-undo .
     3068       define variable v-new-sv-date  as date no-undo .
     3069       assign
     3070         v-curr-sv-date = date(self :screen-value) no-error
     3071       .
