     3129   on ctrl-f of sch-corr-date in frame Dialog-Frame
     3130   do:
     3131     if (can-query (self, "sensitive")
     3132        and
     3133        self :sensitive = true
     3134        )
     3135     or (can-query (self, "read-only")
     3136        and
     3137        self :read-only = false
     3138        )
     3139     then do:
     3140       if self :handle <> focus :handle
     3141       then do:
     3142         apply "entry":u to self .
     3143       end.
     3144       define variable v-ok            as logical   no-undo .
     3145       define variable v-curr-sv-date  as date      no-undo .
