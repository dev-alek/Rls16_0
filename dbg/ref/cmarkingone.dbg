     3183     then do:
     3184       ASSIGN
     3185         sch-corr-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date22 :HANDLE
     3186         sch-corr-date :MENU-MOUSE in frame Dialog-Frame = 3
     3187       .
     3188     end.
