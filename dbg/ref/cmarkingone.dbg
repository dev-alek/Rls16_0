     2992   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2993   on ' ' of sch-corr-date in frame Dialog-Frame
     2994   do:
     2995     if (can-query (self, "sensitive")
     2996        and
     2997        self :sensitive = true
     2998        )
     2999     or (can-query (self, "read-only")
     3000        and
     3001        self :read-only = false
     3002        )
     3003     then do:
     3004       assign
     3005         self :screen-value = ?
     3006       .
     3007     end.
     3008     return no-apply.
     3009   end.
     3010   on delete-character of sch-corr-date in frame Dialog-Frame
     3011   do:
     3012     if (can-query (self, "sensitive")
     3013        and
     3014        self :sensitive = true
     3015        )
