     3753     ).
     3754   if p-open-query then do:
     3755       run set-filter-name in this-procedure
     3756         (INPUT filter-name-29
     3757         ) no-error .
     3758     assign
     3759       l-filter-open-29 = false
     3760     .
     3761     if flt-rec-29 <> ?
     3762       or sort-column-phrase > ""
     3763     then do:
     3764       define variable  parameter-2-29 as character no-undo .
     3765       define variable  parameter-3-29 as character no-undo .
     3766       define variable  parameter-4-29 as character no-undo .
     3767       define variable  parameter-5-29 as character no-undo .
     3768       define variable  parameter-6-29 as character no-undo .
     3769       define variable  parameter-7-29 as character no-undo .
     3770         assign
     3771         parameter-3-29 =
     3772                                 "FOR EACH X_c-obj-hist"
     3773         parameter-4-29 =
     3774           (
     3775             if (" TRUE " + " " + where-phrase-29) <> ""
     3776             then " TRUE " + " " + where-phrase-29
     3777             else "true"
     3778           )
     3779         parameter-5-29 = (" " + "" + " " + "")
     3780         parameter-6-29 = if sort-phrase-29 = ''
     3781                              then
     3782           (
     3783           " " + "" +
     3784             " " + sort-column-phrase +
     3785           " " + "  "
     3786           )
     3787                              else
     3788           (
     3789           " " + "" +
     3790             " " + sort-column-phrase +
     3791           " " + sort-phrase-29
     3792           )
     3793         parameter-7-29 =
     3794           " indexed-reposition  "
     3795       .
     3796       do
     3797       on stop undo, leave
     3798       on error undo, leave
     3799       :
     3800         assign
     3801           l-disable-where-29 =
     3802             (" TRUE " + " " + where-phrase-29 = "")
     3803         .
     3804         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3805                             ,input query br-obj-hist:handle
     3806                             ,input parameter-3-29
     3807                             ,input parameter-4-29
     3808                             ,input parameter-5-29
     3809                             ,input parameter-6-29
     3810                             ,input parameter-7-29
     3811                             )
     3812         .
     3813         assign
     3814           l-filter-open-29 = true
     3815         .
     3816       end.
     3817       if l-filter-open-29 = false then do:
     3818         message
     3819           "Ошибка при фильтрации / сортировке" skip
     3820           "Будут показаны записи без учета фильтра" skip
     3821           view-as alert-box .
     3822       end.
     3823       else do:
     3824           assign
     3825             l-query-was-opened = true
     3826           .
     3827       end.
     3828     end.
     3829     if l-filter-open-29 = false then do:
     3830       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3831         where  TRUE
     3832         indexed-reposition
     3833     .
     3834         assign
     3835           l-query-was-opened = true
     3836         .
     3837     end.
     3838   end.
     3839   else do:
     3840     assign
     3841       v-doc-rec = recid( X_c-obj-hist )
     3842     .
     3843     do
     3844     on stop undo, leave
     3845     on error undo, leave
     3846     :
     3847       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3848         assign
     3849         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3850         parameter-4-29 =
     3851           "where ":u + " TRUE " + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3852         parameter-5-29 = ""
     3853       .
     3854         run fltopend_fltfindd in this-procedure  (
     3855                             input this-procedure:handle
     3856                             ,input query br-obj-hist:handle
     3857                             ,input rowid(X_c-obj-hist)
     3858                             ,input logical(parameter-2-29)
     3859                             ,input no-lock
     3860                             ,input (buffer X_c-obj-hist:handle)
     3861                             ,input parameter-4-29
     3862                             ,input parameter-5-29
     3863                             ) no-error.
     3864         .
     3865         assign
     3866           v-doc-rec = integer(return-value)
     3867           v-fltopend-rowid[1] = ?
     3868         .
     3869       end.
     3870       else do:
     3871         assign
     3872         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3873         parameter-3-29 =  "FOR EACH X_c-obj-hist"
     3874         parameter-4-29 =
     3875           (
     3876             if (" TRUE " + " " + where-phrase-29) <> ""
     3877             then " TRUE " + " " + where-phrase-29
     3878             else "true"
     3879           )
     3880         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3881         parameter-6-29 = if sort-phrase-29 = ''
     3882                              then
     3883           (
     3884           " " + "" +
     3885             " " + sort-column-phrase +
     3886           " " + "  "
     3887           )
     3888                              else
     3889           (
     3890           " " + "" +
     3891             " " + sort-column-phrase +
     3892           " " + sort-phrase-29
     3893           )
     3894         parameter-7-29 =
     3895           " indexed-reposition  "
     3896       .
     3897         run fltopend_fltfindq in this-procedure  (
     3898                             input this-procedure:handle
     3899                             ,input query br-obj-hist:handle
     3900                             ,input logical(parameter-2-29)
     3901                             ,input no-lock
     3902                             ,input parameter-3-29
     3903                             ,input parameter-4-29
     3904                             ,input parameter-5-29
     3905                             ,input parameter-6-29
     3906                             ,input parameter-7-29
     3907                             ,output v-fltopend-rowid
     3908                             ) no-error.
     3909         .
     3910         v-doc-rec = ?.
     3911       end.
     3912       assign
     3913         l-query-was-opened = true
     3914       .
     3915     end.
     3916   end.
     3917     run waitfram-hide in this-procedure .
     3918     end.
     3919   end.
     3920   if not p-open-query and v-doc-rec <> ? then
     3921   REPOSITION br-obj-hist to recid v-doc-rec No-ERROR.
     3922   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3923   query br-obj-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3924   run waitfram-hide in this-procedure .
     3925   APPLY "VALUE-CHANGED" TO br-obj-hist in frame Dialog-Frame.
     3926   APPLY "ENTRY" TO br-obj-hist.
     3927   END PROCEDURE.
     3928   PROCEDURE proc-b-print :
     3929   define variable date_string     as      char    no-undo.
     3930   define variable Line                as      char    no-undo.
     3931   define variable for-time as char.
     3932   define variable accum-count as integer.
     3933   define variable v-doc-rec as recid no-undo.
     3934   define variable v-subject-chr as character no-undo .
     3935   define variable v-upd-time as character no-undo .
     3936   define variable v-obj as character no-undo .
     3937   define variable v-action-chr as character no-undo .
     3938   define variable v-source-type as character no-undo .
     3939   DEFINE FRAME HistoryList
     3940   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3941   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     3942   X_c-obj-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     3943   v-source-type COLUMn-LABEL "Источн.!измен"
     3944   X_c-obj-hist.source-ref COLUMn-LABEL "№"
     3945   X_c-obj-hist.corr-date
     3946   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3947   X_c-obj-hist.corr-user-name
     3948   X_c-obj-hist.corr-user-db-num
     3949   HEADER  date_string AT 5 format "X(35)"
     3950   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3951   Line format "X(195)" AT 1
     3952   with width 232 down stream-io use-text    .
     3953   Line = fill("-", 195).
     3954   date_string = cur-time-print() .
     3955   assign
     3956   v-doc-rec = recid( X_c-obj-hist ).
     3957   DO WHILE available X_c-obj-hist :
     3958         GET prev br-obj-hist.
     3959   END.
     3960   run prn-lib-open-stream  in this-procedure (
     3961                                                input parparentProc
     3962                                               ,input 43
     3963                                               ,input yes
     3964                                               ,input no
     3965                                               ).
     3966   PUT  STREAM PrnLibStream
     3967   SPACE(25) ( frame Dialog-Frame:title )
     3968   format "x(90)" SKIP(1) .
     3969   FORM HEADER
     3970   Line format "X(180)" AT 1 SKIP
     3971   "Продолжение - на следующей странице" AT 30 SKIP
     3972   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3973   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3974   FORM with FRAME HistoryList  .
     3975   run waitfram-show in this-procedure ("Ждите...").
     3976     GET next br-obj-hist.
     3977       DO WHILE available X_c-obj-hist :
     3978         Display STREAM PrnLibStream
     3979          get-action(X_c-obj-hist.action) @ v-action-chr
     3980          get-subject(X_c-obj-hist.subject) @ v-subject-chr
     3981         X_c-obj-hist.is-news
     3982         get-source-type(X_c-obj-hist.source-type) @ v-source-type
     3983         X_c-obj-hist.source-ref
     3984         X_c-obj-hist.corr-date
     3985         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3986         X_c-obj-hist.corr-user-name
     3987         X_c-obj-hist.corr-user-db-num
     3988         with FRAME HistoryList .
     3989     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3990     assign
     3991     accum-count = accum-count + 1
     3992     .
     3993     GET next br-obj-hist.
     3994   END.
     3995   UNDERLINE  STREAM PrnLibStream
     3996   v-action-chr
     3997   v-subject-chr
     3998   X_c-obj-hist.is-news
     3999   v-source-type
     4000   X_c-obj-hist.source-ref
     4001   X_c-obj-hist.corr-date
     4002   v-upd-time
     4003   X_c-obj-hist.corr-user-name
     4004   X_c-obj-hist.corr-user-db-num
     4005   with FRAME HistoryList .
     4006   DISPLAY STREAM PrnLibStream
     4007   "ИТОГО"  @ v-obj
     4008   string(accum-count)  @ v-action-chr
     4009   with frame HistoryList.
     4010   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4011   HIDE  STREAM PrnLibStream FRAME CheckList.
     4012   output  STREAM PrnLibStream CLOSE.
     4013   run waitfram-hide in this-procedure.
     4014   run prn-lib-prn-file in this-procedure (
     4015                                             input parparentproc
     4016                                             ,input 8
     4017                                             ).
     4018   reposition br-obj-hist to recid v-doc-rec no-error.
     4019   apply "entry" to br-obj-hist in frame Dialog-Frame.
     4020   END PROCEDURE.
     4021   PROCEDURE proc-b-sch :
     4022   assign
     4023     tbl = "c-marking-hist"
     4024     join-tbl = 'X_c-obj-hist'
     4025     fld = ""
     4026     lab = ""
     4027     spr = ""
     4028     dim = '0'
     4029     .
     4030   run fltfield-add in this-procedure('corr-date', 'Дата корр.', '',
     4031   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4032   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4033   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4034   run fltfield-add in this-procedure('corr-user-db-num', 'БД корр.', '',
     4035   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4036   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4037   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4038   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4039   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4040   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'obj-hist-subject',
     4041   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4042   run fltfield-add in this-procedure('source-type', 'Источник измен-я', 'hist-source-type',
     4043   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4044   run fltfield-add in this-procedure('source-ref', 'Код источника измен-я', '',
     4045   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4046   Filter-Block:
     4047   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4048       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4049       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4050     run gbl/filter.w ( INPUT parparentproc
     4051                      , INPUT filter-point + chr(4) + filter-label
     4052                      , INPUT tbl
     4053                      , INPUT join-tbl
     4054                      , INPUT fld
     4055                      , INPUT lab
     4056                      , INPUT spr
     4057                      , INPUT dim ).
     4058     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4059   END.
     4060   END PROCEDURE.
     4061   PROCEDURE proc-find-corr-date :
     4062   define input parameter p-next as logical no-undo.
     4063   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4064   define variable v-date-chr as character no-undo.
     4065   if p-date = ? then return .
     4066   display
     4067   0 @ sch-obj-code
     4068   0 @ sch-db-num
     4069   "":U @ sch-corr-user-name
     4070   with frame Dialog-Frame.
     4071   assign
     4072   v-date-chr = string(day(p-date)) + chr(47) +
     4073                    string(month(p-date)) + chr(47) +
     4074                    string(year(p-date)).
     4075          run OpenBr in this-procedure
     4076           (input false
     4077           ,input true
     4078           ,input substitute("and X_c-obj-hist.corr-date = &1 "
     4079             , v-date-chr)
     4080           ,input v-corr-user-db-num
     4081           ).
     4082         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4083   END PROCEDURE.
     4084   PROCEDURE proc-find-db-num :
     4085   define input parameter p-next as logical no-undo.
     4086   define input parameter p-db-num like c-marking-hist.corr-user-db-num no-undo.
     4087   define variable v-db-num as character no-undo.
     4088   assign
     4089   sch-corr-date = ?
     4090   .
     4091   display
     4092   "":U @ sch-corr-user-name
     4093   0 @ sch-obj-code
     4094   sch-corr-date
     4095   with frame Dialog-Frame.
     4096   assign
     4097   v-db-num = string(p-db-num).
     4098   run OpenBr in this-procedure
     4099       (input false
     4100       ,input p-next
     4101       ,input substitute("and X_c-obj-hist.corr-user-db-num = &1 "
     4102         , v-db-num)
     4103       ,input v-corr-user-db-num
     4104       ).
     4105   apply "entry":u to sch-db-num in frame Dialog-Frame .
     4106   END PROCEDURE.
     4107   PROCEDURE proc-find-user :
     4108   define input parameter p-next as logical no-undo.
     4109   define input parameter p-user like c-marking-hist.corr-user-name no-undo.
     4110   assign
     4111   sch-corr-date = ?.
     4112   display
     4113   0 @ sch-db-num
     4114   sch-corr-date
     4115   0 @ sch-obj-code
     4116   with frame Dialog-Frame.
     4117   p-user = chr(34) + p-user + chr(34).
     4118   run OpenBr in this-procedure
     4119       (input false
     4120       ,input p-next
     4121       ,input substitute("and X_c-obj-hist.corr-user-name = &1 "
     4122         , p-user)
     4123       ,input v-corr-user-db-num
     4124       ).
     4125   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4126   END PROCEDURE.
     4127   PROCEDURE proc-view-changes :
     4128   define variable v-description as character no-undo .
     4129   for each temp-changes:
     4130       delete temp-changes.
     4131   END.
     4132   if not available X_c-obj-hist then do:
     4133     b-nextlevel:visible IN FRAME Dialog-Frame = no.
     4134     Open QUery br-changes for each temp-changes.
     4135     return.
     4136   end.
     4137   b-nextlevel:visible IN FRAME Dialog-Frame = X_c-obj-hist.subject eq "*" .
     4138   run local-view-cange in this-procedure (output v-description) .
     4139   Open QUery br-changes for each temp-changes by temp-changes.fNotChange.
     4140   assign
     4141   br-changes:title in frame Dialog-Frame = v-description
     4142   .
     4143   END PROCEDURE.
     4144   FUNCTION get-action RETURNS CHARACTER
     4145     ( p-action as integer ) :
     4146   define variable dops as character no-undo.
     4147   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4148   RETURN dops.
     4149   END FUNCTION.
     4150   FUNCTION get-source-type RETURNS CHARACTER
     4151     ( p-source-type as character ) :
     4152   define variable v-dop as character no-undo .
     4153   assign
     4154   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     4155   no-error
     4156   .
     4157   RETURN v-dop.
     4158   END FUNCTION.
     4159   function getStsName returns character (iSts as int ):
     4160     define variable thMarkSts  as class ibs.th.str.marking.sts.mark no-undo.
     4161     thMarkSts = ObjSrv:Env:Marking:Sts:Mark.
     4162     return thMarkSts:GetLabel(iSts).
     4163   end.
     4164   function getOnlineResultName returns character (iOnlineResult as int ):
     4165     define variable vNames as character no-undo
     4166       init "Запрет продажи,Продажа разрешена,Необходимо проверить сроки годности".
     4167     return if iOnlineResult = ? then "null" else entry(iOnlineResult + 1, vNames).
     4168   end.
     4169   function formatLogicalValue returns character (iValue as character ):
     4170     return if iValue = "" then ? else string(logical(iValue),"Да/Нет").
     4171   end.
     4172   function formatValue returns character (iValue as character ):
     4173     define variable vLog as logical no-undo.
     4174     define variable vDec as decimal no-undo.
     4175     define variable vChr as character no-undo.
     4176     vChr = iValue.
     4177     if iValue <> "" then do:
     4178         vLog = logical(iValue) no-error.
     4179         if vLog <> ? then vChr = string(vLog,"Да/Нет").
     4180         else do:
     4181            vDec = decimal(iValue) no-error.
     4182            if vDec <> ? then vChr = string(vDec).
     4183         end.
     4184     end.
     4185     return vChr.
     4186   end.
     4187   function getAttributeName returns character (iCode as character ):
     4188     return
     4189       if iCode = "notOnlineCheck"
     4190         then "Игнорировать результат online-проверки"
     4191         else if iCode = "weight" then "Вес"
     4192         else "Значение атрибута " + iCode.
     4193   end.
     4194   procedure ParentPars:
     4195      define input  parameter iOldBuf as handle no-undo.
     4196      define input  parameter iCurBuf as handle no-undo.
     4197   end.
     4198   function get-subject returns character
     4199     ( p-subject as character ) :
     4200     return if p-subject = "marking" then "Марка" else "Атрибут марки".
     4201   end function.
     4202   procedure local-view-cange:
     4203     define output parameter odescription as character no-undo.
     4204     define buffer current_c-marking for ub.c-marking  .
     4205     define variable v-mess as character no-undo.
     4206      if X_c-obj-hist.subject <> "marking"
     4207      then
     4208         run getMarkingAttr (output odescription).
     4209      else
     4210         run getMarking (output odescription).
     4211   end procedure.
     4212   procedure getMarking:
     4213     define output parameter p-description as character no-undo .
     4214     define buffer current_c-marking for ub.c-marking.
     4215     define variable v-mess as character no-undo.
     4216     do
     4217     on error undo, return error return-value
     4218     :
     4219       find first current_c-marking no-lock where
     4220                  current_c-marking.mark = X_c-obj-hist.mark
     4221              and current_c-marking.chip-num = X_c-obj-hist.chip-num
     4222              and current_c-marking.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     4223       if not avail current_c-marking then do:
     4224           v-mess = "Неверная ссылка на марку в таблице c-marking".
     4225           return error  v-mess .
     4226       end.
     4227           define variable v-label-param as character no-undo .
     4228       v-label-param =
     4229             "sts"   + chr(4) + "Статус" + chr(4) + "getStsName" + chr(8)
     4230           + "last-change" + chr(4) + "Изменен" + chr(4) + "" + chr(8)
     4231           + "online-result" + chr(4) + "Результат ГИС МТ" + chr(4) + "getOnlineResultName".
     4232       run proc-full-temp-changes in this-procedure (
     4233                                                    input current_c-marking.action = integer('1':U)
     4234                                                   ,input current_c-marking.action = integer('99':U)
     4235                                                   ,input  buffer current_c-marking:handle
     4236                                                   ,input  "marking"
     4237                                                   ,input  "sts,last-change,online-result"
     4238                                                   ,input  v-label-param).
     4239     end.
     4240   end procedure.
     4241   procedure getMarkingAttr:
     4242     define output parameter p-description as character no-undo .
     4243     define buffer current_c-marking for ub.c-marking-attr.
     4244     define variable v-mess as character no-undo.
     4245     do
     4246     on error undo, return error return-value
     4247     :
     4248       find first current_c-marking no-lock where
     4249                  current_c-marking.mark = X_c-obj-hist.mark
     4250              and current_c-marking.chip-num = X_c-obj-hist.chip-num
     4251              and current_c-marking.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     4252       if not avail current_c-marking then do:
     4253           v-mess = "Неверная ссылка на марку в таблице c-marking".
     4254           return error  v-mess .
     4255       end.
     4256           define variable v-label-param as character no-undo .
     4257       v-label-param =
     4258             "attr-value"   + chr(4) + getAttributeName(current_c-marking.attr-code) + chr(4)
     4259             + (if current_c-marking.attr-code = "notOnlineCheck" then "formatLogicalValue" else "formatValue").
     4260       run proc-full-temp-changes in this-procedure (
     4261                                                    input current_c-marking.action = integer('1':U)
     4262                                                   ,input current_c-marking.action = integer('99':U)
     4263                                                   ,input  buffer current_c-marking:handle
     4264                                                   ,input  "marking-attr"
     4265                                                   ,input  "attr-value"
     4266                                                   ,input  v-label-param).
     4267     end.
     4268   end procedure.
     4269   PROCEDURE proc-find-obj-code :
     4270   define input parameter p-next as logical no-undo.
     4271   define input parameter p-obj-code as character no-undo.
     4272   if p-obj-code = "" then return .
     4273   run OpenBr in this-procedure
     4274       (input false
     4275       ,input true
     4276       ,input substitute("and X_c-obj-hist.mark begins '&1' "
     4277         , p-obj-code)
     4278       ,input v-corr-user-db-num
     4279       ).
     4280   apply "entry":u to sch-obj-code in frame Dialog-Frame.
     4281   END PROCEDURE.
     4282   function local-open-br returns logical (
     4283     p-open-query     as logical    ,
     4284     p-find-next       as logical    ,
     4285     p-find-condition as character
     4286   ):
     4287     define variable sort-column-phrase as character no-undo .
     4288     define variable l-query-was-opened as logical no-undo .
     4289     for each X_c-obj-hist :
     4290       delete X_c-obj-hist.
     4291     end.
     4292     if p-mode eq "one"
     4293     then do:
     4294           for each c-marking where c-marking.mark               eq iMark
     4295       no-lock:
     4296          create X_c-obj-hist.
     4297          buffer-copy c-marking to X_c-obj-hist
     4298          assign
     4299             X_c-obj-hist.subject = "marking"
     4300          .
     4301       end.
     4302           for each c-marking-attr where c-marking-attr.mark               eq iMark
     4303       no-lock:
     4304          create X_c-obj-hist.
     4305          buffer-copy c-marking-attr to X_c-obj-hist
     4306          assign
     4307             X_c-obj-hist.subject = "marking-attr"
     4308          .
     4309       end.
     4310     end.
     4311   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4312   define variable  l-disable-where-31  as logical   no-undo .
     4313   define variable  l-filter-open-31    as logical   .
     4314   define variable  flt-rec-31       as recid     no-undo .
     4315   define variable  filter-name-31      as character no-undo .
     4316   define variable  where-phrase-31     as character no-undo .
     4317   define variable  sort-phrase-31      as character no-undo .
     4318   define variable  where-phrase-rus-31 as character no-undo .
     4319   define variable  sort-phrase-rus-31  as character no-undo .
     4320     run waitfram-show in this-procedure
     4321       (input "ЖДИТЕ ..."
     4322       ).
     4323   run gbl/flt-get.p
     4324     (input filter-point
     4325     ,output flt-rec-31
     4326     ,output filter-name-31
     4327     ,output where-phrase-31
     4328     ,output sort-phrase-31
     4329     ,output where-phrase-rus-31
     4330     ,output sort-phrase-rus-31
     4331     ).
     4332   if p-open-query then do:
     4333       run set-filter-name in this-procedure
     4334         (INPUT filter-name-31
     4335         ) no-error .
     4336     assign
     4337       l-filter-open-31 = false
     4338     .
     4339     if flt-rec-31 <> ?
     4340       or sort-column-phrase > ""
     4341     then do:
     4342       define variable  parameter-2-31 as character no-undo .
     4343       define variable  parameter-3-31 as character no-undo .
     4344       define variable  parameter-4-31 as character no-undo .
     4345       define variable  parameter-5-31 as character no-undo .
     4346       define variable  parameter-6-31 as character no-undo .
     4347       define variable  parameter-7-31 as character no-undo .
     4348         assign
     4349         parameter-3-31 =
     4350                                 "FOR EACH X_c-obj-hist"
     4351         parameter-4-31 =
     4352           (
     4353             if (" TRUE " + " " + where-phrase-31) <> ""
     4354             then " TRUE " + " " + where-phrase-31
     4355             else "true"
     4356           )
     4357         parameter-5-31 = (" " + "" + " " + "")
     4358         parameter-6-31 = if sort-phrase-31 = ''
     4359                              then
     4360           (
     4361           " " + "" +
     4362             " " + sort-column-phrase +
     4363           " " + " by X_c-obj-hist.corr-date desc by X_c-obj-hist.corr-time desc  "
     4364           )
     4365                              else
     4366           (
     4367           " " + "" +
     4368             " " + sort-column-phrase +
     4369           " " + sort-phrase-31
     4370           )
     4371         parameter-7-31 =
     4372           " indexed-reposition  "
     4373       .
     4374       do
     4375       on stop undo, leave
     4376       on error undo, leave
     4377       :
     4378         assign
     4379           l-disable-where-31 =
     4380             (" TRUE " + " " + where-phrase-31 = "")
     4381         .
     4382         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4383                             ,input query br-obj-hist:handle
     4384                             ,input parameter-3-31
     4385                             ,input parameter-4-31
     4386                             ,input parameter-5-31
     4387                             ,input parameter-6-31
     4388                             ,input parameter-7-31
     4389                             )
     4390         .
     4391         assign
     4392           l-filter-open-31 = true
     4393         .
     4394       end.
     4395       if l-filter-open-31 = false then do:
     4396         message
     4397           "Ошибка при фильтрации / сортировке" skip
     4398           "Будут показаны записи без учета фильтра" skip
     4399           view-as alert-box .
     4400       end.
     4401       else do:
     4402           assign
     4403             l-query-was-opened = true
     4404           .
     4405       end.
     4406     end.
     4407     if l-filter-open-31 = false then do:
     4408       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     4409         where  TRUE
     4410          by X_c-obj-hist.corr-date desc by X_c-obj-hist.corr-time desc
     4411         indexed-reposition
     4412     .
     4413         assign
     4414           l-query-was-opened = true
     4415         .
     4416     end.
     4417   end.
     4418   else do:
     4419     assign
     4420       v-doc-rec = recid( X_c-obj-hist )
     4421     .
     4422     do
     4423     on stop undo, leave
     4424     on error undo, leave
     4425     :
     4426       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     4427         assign
     4428         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     4429         parameter-4-31 =
     4430           "where ":u + " TRUE " + " ":u + where-phrase-31 + " ":u + p-find-condition + " " + ""
     4431         parameter-5-31 = ""
     4432       .
     4433         run fltopend_fltfindd in this-procedure  (
     4434                             input this-procedure:handle
     4435                             ,input query br-obj-hist:handle
     4436                             ,input rowid(X_c-obj-hist)
     4437                             ,input logical(parameter-2-31)
     4438                             ,input no-lock
     4439                             ,input (buffer X_c-obj-hist:handle)
     4440                             ,input parameter-4-31
     4441                             ,input parameter-5-31
     4442                             ) no-error.
     4443         .
     4444         assign
     4445           v-doc-rec = integer(return-value)
     4446           v-fltopend-rowid[1] = ?
     4447         .
     4448       end.
     4449       else do:
     4450         assign
     4451         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     4452         parameter-3-31 =  "FOR EACH X_c-obj-hist"
     4453         parameter-4-31 =
     4454           (
     4455             if (" TRUE " + " " + where-phrase-31) <> ""
     4456             then " TRUE " + " " + where-phrase-31
     4457             else "true"
     4458           )
     4459         parameter-5-31 = (" " + "" + " " + "" + " " + p-find-condition)
     4460         parameter-6-31 = if sort-phrase-31 = ''
     4461                              then
     4462           (
     4463           " " + "" +
     4464             " " + sort-column-phrase +
     4465           " " + " by X_c-obj-hist.corr-date desc by X_c-obj-hist.corr-time desc  "
     4466           )
     4467                              else
     4468           (
     4469           " " + "" +
     4470             " " + sort-column-phrase +
     4471           " " + sort-phrase-31
     4472           )
     4473         parameter-7-31 =
     4474           " indexed-reposition  "
     4475       .
     4476         run fltopend_fltfindq in this-procedure  (
     4477                             input this-procedure:handle
     4478                             ,input query br-obj-hist:handle
     4479                             ,input logical(parameter-2-31)
     4480                             ,input no-lock
     4481                             ,input parameter-3-31
     4482                             ,input parameter-4-31
     4483                             ,input parameter-5-31
     4484                             ,input parameter-6-31
     4485                             ,input parameter-7-31
     4486                             ,output v-fltopend-rowid
     4487                             ) no-error.
     4488         .
     4489         v-doc-rec = ?.
     4490       end.
     4491       assign
     4492         l-query-was-opened = true
     4493       .
     4494     end.
     4495   end.
     4496     run waitfram-hide in this-procedure .
     4497     return true.
     4498   end.
