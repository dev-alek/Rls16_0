     1947   procedure clcprtsl_calc-ttable :
     1948   define input parameter paris-doc           as   logical                 no-undo.
     1949   define input parameter paris-cur           as   logical                 no-undo.
     1950   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     1951   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     1952   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     1953   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     1954   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     1955   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     1956   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     1957   define input parameter parr-b              as   character               no-undo.
     1958   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     1959   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     1960   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     1961   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     1962   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     1963   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     1964   define buffer bf_tt-allsum      for tt-allsum.
     1965   define buffer bf_tt-clcparts    for tt-clcparts.
     1966   define buffer bf_tt-allsum-line for tt-allsum-line.
     1967   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1968   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1969   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1970   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1971   define variable varexcise          like ub.price-list.excise     no-undo.
     1972   do on error undo, return error return-value :
     1973   for each bf_tt-allsum-line
     1974   on error undo, return error return-value
     1975    :
     1976     delete bf_tt-allsum-line.
     1977   end.
     1978   for each bf_tt-allsum
     1979   on error undo, return error return-value
     1980   :
     1981     delete bf_tt-allsum.
     1982   end.
     1983   for each bf_tt-clcparts
     1984   on error undo, return error return-value
     1985   :
     1986   if v-calcbypart then do:
     1987             assign
     1988             parcur-base =   bf_tt-clcparts.part-cur-base
     1989             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     1990             parcur-excise =   bf_tt-clcparts.part-cur-excise
     1991             .
     1992   end.
     1993      run clcprtsl_calc-parts in this-procedure (
     1994        input recid(bf_tt-clcparts),
     1995        input paris-doc,
     1996        input paris-cur,
     1997        input parroad-tax,
     1998        input parexcise,
     1999        input parvat-pc,
     2000        input parcons-vat-pc,
     2001        input parslt-pc,
     2002        input parbase-rate,
     2003        input parbase-scale,
     2004        input parr-b,
     2005        input parcur-base,
     2006        input parcur-road-tax,
     2007        input parcur-excise,
     2008        input parcur-vat-pc,
     2009        input parcurcons-vat-pc,
     2010        input parcurslt-pc
     2011        ) no-error.
     2012     if error-status:error then do:
     2013       message
     2014         vss-workfile vss-revision vss-description skip
     2015         vss-include-info0 skip
     2016         "Ошибка при обсчете партии" skip
     2017         "Документ партии " bf_tt-clcparts.out-code skip
     2018         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2019         return-value skip
     2020         error-status:get-message(1) skip
     2021         error-status:get-message(2) skip
     2022         error-status:get-message(3) skip
     2023         view-as alert-box error .
     2024       undo, return error .
     2025     end.
     2026     for each bf_tt-allsum on error undo, return error return-value :
     2027       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2028       if not available bf_tt-allsum-line then do:
     2029         create bf_tt-allsum-line.
     2030         assign
     2031           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2032       end.
     2033       assign
     2034         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2035         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2036         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2037         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2038         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     2039         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     2040         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     2041         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     2042         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
