      730     varvat-base-factovpcl     = 0
      731     varvatcons-base-factovpcl = 0
      732     vardsc-base-factovpcl     = 0
      733     varsum-base-docovpcl      = 0
      734     varslt-base-docovpcl      = 0
      735     varvat-base-docovpcl      = 0
      736     varvatcons-base-docovpcl  = 0
      737     vardsc-base-docovpcl      = 0
      738     varsum-rubl-factovpcl     = 0
      739     varslt-rubl-factovpcl     = 0
      740     varvat-rubl-factovpcl     = 0
      741     varvatcons-rubl-factovpcl = 0
      742     vardsc-rubl-factovpcl     = 0
      743     varsum-rubl-docovpcl      = 0
      744     varslt-rubl-docovpcl      = 0
      745     varvat-rubl-docovpcl      = 0
      746     varvatcons-rubl-docovpcl  = 0
      747     vardsc-rubl-docovpcl      = 0.
      748   assign
      749     varis-one-gds-dtlcl = no.
      750   find first out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
      751                                        out-vatp_gds-dtlcl.artic     = parartic     and
      752                                        out-vatp_gds-dtlcl.prod-type = parprod-type and
      753                                        out-vatp_gds-dtlcl.prod-code = parprod-code no-lock no-error.
      754   if available out-vatp_gds-dtlcl then do:
      755     find first buf_out-vatp_gds-dtlcl where buf_out-vatp_gds-dtlcl.doc-code  =  pardoc-code                and
      756                                              buf_out-vatp_gds-dtlcl.artic     =  parartic                   and
