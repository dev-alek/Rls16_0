      479   do on error undo, return error return-value :
      480   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      481   for each bf_tt-allsum on error undo, return error return-value :
      482     delete bf_tt-allsum.
      483   end.
      484   assign
      485     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      486     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      487   .
      488   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      489   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      490     (output varinvprbcl
      491     )  .
      492     if cl_tt-clcparts.out-code = 'free-zone':U     or
      493        cl_tt-clcparts.out-code = 'out-zone':U   or
      494        cl_tt-clcparts.doc-type = 'акт':U then do:
      495       assign
      496         in-vatp-have-vat-sltcl = yes.
      497     end.
      498     else do:
      499       find first in-vatp_doc-attrcl no-lock
      500         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      501           and in-vatp_doc-attrcl.attr-code = 'envd':U
      502         no-error .
      503       if not available in-vatp_doc-attrcl then do:
      504         assign
      505           in-vatp-have-vat-sltcl = yes.
      506       end.
      507       else do:
      508            in-vatp-have-vat-sltcl = no.
      509       end.
      510     end.
      511     assign
      512      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      513      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      514     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      515              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      516     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      517             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      518             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      519             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      520             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      521             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      522             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      523       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      524     assign
      525       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      526     assign
      527       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      528       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      529       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      530       transport-cli-loccl  = 0
      531       other-cli-loccl      = 0
      532     .
      533   ASSIGN
      534             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      535       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      536   .
      537   if paris-doc then do:
      538     assign
      539       parartic     = cl_tt-clcparts.artic
      540       parprod-type = cl_tt-clcparts.prod-type
      541       parprod-code = cl_tt-clcparts.prod-code
      542       pardoc-type  = cl_tt-clcparts.doc-type
      543       pardoc-code  = cl_tt-clcparts.out-code
      544       parobj-type  = cl_tt-clcparts.obj-type
      545       parobj-code  = cl_tt-clcparts.obj-code.
      546   if parext-doc-type = 'ot':U or
      547      parext-doc-type = ?                 then do:
      548     assign
      549      out-vatp-have-vat-sltcl = yes.
      550   end.
      551   else do:
      552     find first out-vatp_doc-attrcl no-lock
      553       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      554         and out-vatp_doc-attrcl.attr-code = 'envd':U
      555         no-error .
      556     if not available out-vatp_doc-attrcl then do:
      557       assign
      558         out-vatp-have-vat-sltcl = yes.
      559     end.
      560     else do:
      561        out-vatp-have-vat-sltcl = no.
      562     end.
      563   end.
      564   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      565                                      out-vatp_goodscl.prod-type = parprod-type and
      566                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      567   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      569     (input  parartic
      570     ,input  parprod-type
      571     ,input  parprod-code
      572     ,output varroot-nodecl
      573     ) no-error .
      574   if error-status :error then do:
      575     message
      576       vss-workfile vss-revision vss-description skip
      577       "Ошибка при определении корневого признака товара" skip
      578       "Артикул" parartic parprod-type parprod-code skip
      579       error-status :get-message(1) skip
      580       return-value skip
      581       view-as alert-box error .
      582     undo, return error .
      583   end.
      584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      585     (input  varroot-nodecl
      586     ,input  'empty-scale=request'
      587     ,output varempty-scalecl
      588     ) no-error .
      589   if error-status :error then do:
      590     message
      591       vss-workfile vss-revision vss-description skip
      592       "Ошибка при определении атрибута признака" skip
      593       "Артикул" parartic parprod-type parprod-code skip
      594       "Признак" varroot-nodecl skip
      595       "Запрашивался атрибут" "empty-scale=request" skip
      596       error-status :get-message(1) skip
      597       return-value skip
      598       view-as alert-box error .
      599     undo, return error .
      600   end.
      601   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      603     (output varoutvprbcl
      604     )  .
      605   if varoutvprbcl = "base":u then do:
      606     assign
      607           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
      608       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
      609     .
      610   end.
      611   else do:
      612     assign
      613           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
      614       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
      615     .
      616   end.
      617   if varoutvprbcl = "rubl":u then do:
      618     assign
      619           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * 1)
      620       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * 1) .
      621   end.
      622   else do:
      623     assign
      624           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * parbase-rate / parbase-scale)
      625       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * parbase-rate / parbase-scale) .
      626   end.
      627   assign
      628     varis-cons-parts-havecl =  no.
      629   assign
      630     varfact-qntycl       = 0
      631     varcons-qntycl       = 0
      632     varprice-base-conscl = 0
      633     varprice-rubl-conscl = 0.
      634   find first out-vatp_doc-linecl where
      635              out-vatp_doc-linecl.doc-code   = pardoc-code
      636          and out-vatp_doc-linecl.artic      = parartic
      637          and out-vatp_doc-linecl.prod-type  = parprod-type
      638          and out-vatp_doc-linecl.prod-code  = parprod-code no-lock no-error.
      639   if available out-vatp_doc-linecl           and
      640     (out-vatp_doc-linecl.status_ = 'запрос':U or out-vatp_goodscl.gds-type = 'у':U) then do:
      641     assign
