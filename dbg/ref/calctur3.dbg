     2093   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2094   define variable v-waitfram-action01         as character   no-undo .
     2095   define variable v-waitfram-action02         as character   no-undo .
     2096   define variable v-waitfram-action03         as character   no-undo .
     2097   define variable mWaitFramTextBeg            as character   no-undo.
     2098   define variable mWaitFramTextEnd            as character   no-undo.
     2099   define variable mWaitFramView               as logical     no-undo.
     2100   define variable mWaitProcEvent              as logical     no-undo init yes.
     2101   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2102   define variable mWaitFramStop               as logical     no-undo.
     2103   define variable mWaitFramStopUser           as logical     no-undo.
     2104   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2105   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2106   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2107   define button B-WaitFramStop auto-end-key
     2108        label "Стоп"
     2109        size 10 by 1 tooltip "Остоновить процесс".
     2110   define button B-viewProcInfo
     2111        label "Информация"
     2112        size 15 by 1 tooltip "Информация о процесс".
     2113   define frame waitfram
     2114     v-waitfram-action01 format "x(72)" no-label skip
     2115     v-waitfram-action02 format "x(72)" no-label skip
     2116     v-waitfram-action03 format "x(72)" no-label skip
     2117     B-viewProcInfo
     2118     B-WaitFramStop at row 4 col 30
     2119     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2120     .
     2121   define new global shared variable mBatchMode as logical no-undo init ?.
     2122   define variable mFramBachModHandle as handle no-undo.
     2123   mFramBachModHandle = frame waitfram:handle.
     2124   define variable mFameOldVis as logical no-undo.
     2125   define variable mVisCUrentVin as logical no-undo.
     2126   if session:batch-mode
     2127   then
     2128      mBatchMode = yes.
     2129   if mBatchMode = ? then do:
     2130     mVisCUrentVin = current-window:visible.
     2131     mFameOldVis = mFramBachModHandle:visible.
     2132     mFramBachModHandle:visible  = yes.
     2133     mBatchMode = mFramBachModHandle:visible ne yes.
     2134     mFramBachModHandle:visible = mFameOldVis.
     2135     current-window:visible = mVisCUrentVin.
     2136   end.
     2137    if  log-manager:logfile-name ne ?
     2138     then DO:
     2139         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2140         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2141         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2142     end.
     2143   on choose of B-WaitFramStop in frame waitfram
     2144   do:
     2145     mWaitFramStop = yes.
     2146     mWaitFramStopUser = yes.
     2147   end.
     2148   function waitfram-check-timeout returns logical():
     2149      define variable vtime as int64 no-undo.
     2150      if mWaitFramStopTimeOut
     2151      then
     2152         return yes.
     2153      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2154      if     mWaitFramTimeOut ne ?
     2155         and mWaitFramTimeOut ne 0
     2156         and mWaitFramTimeOut lt vtime
     2157      then do:
     2158         mWaitFramStopTimeOut = yes.
     2159      end.
     2160      return mWaitFramStopTimeOut.
     2161   end.
     2162   procedure waitfram-hide :
     2163     if not session:batch-mode
     2164     then do
     2165     on error undo, return error return-value
     2166     :
     2167       pause 0 before-hide .
     2168       if not mBatchMode then
     2169         hide frame waitfram .
     2170     if     not mWaitFramView
     2171        and mWaitProcEvent
     2172     then
     2173       process events .
     2174     end.
     2175   end procedure.
     2176   procedure waitfram-show :
     2177     define input  parameter p-message as character no-undo .
     2178     define variable v-left-margin as integer   no-undo .
     2179     if not session:batch-mode
     2180     then do
     2181     on error undo, return error return-value
     2182     :
     2183       if length(p-message) <= 70 then do:
     2184         assign
     2185           v-left-margin = integer((70 - length(p-message)) / 2)
     2186         .
     2187         assign
     2188           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2189         .
     2190         assign
     2191           v-waitfram-action01 = " "
     2192           v-waitfram-action02 = " "
     2193                                    + fill(" ", v-left-margin)
     2194                                    + p-message
     2195           v-waitfram-action03 = " "
     2196         .
     2197       end.
     2198       else do:
     2199         define variable vRindex1 as integer no-undo.
     2200         define variable vRindex2 as integer no-undo.
     2201         vRindex1 = r-index(p-message," ",70).
     2202         if vRindex1 = 0
     2203         then
     2204            vRindex1 = 70.
     2205         if length(p-message)  <= vRindex1 + 70 then do:
     2206           assign
     2207             v-waitfram-action01 = " "
     2208             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2209             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2210           .
     2211         end.
     2212         else do:
     2213           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2214           if vRindex2 <= vRindex1
     2215           then
     2216              vRindex2 = vRindex1 + 70.
     2217           assign
     2218             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2219             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2220             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2221           .
     2222         end.
     2223       end.
     2224       B-viewProcInfo:visible   in frame waitfram = no.
     2225       B-viewProcInfo:sensitive in frame waitfram = no.
     2226       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2227       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2228       if  (   mWaitFramView
     2229          or  mWaitProcEvent)
     2230          and not mBatchMode
     2231       then
     2232          display
     2233             v-waitfram-action01 skip
     2234             v-waitfram-action02 skip
     2235             v-waitfram-action03 skip
     2236          with frame waitfram .
     2237       if     mWaitFramView
     2238          then do:
     2239             if     mWaitFramInterval ne ?
     2240                and not mBatchMode
     2241             then
     2242                wait-for go of frame waitfram pause mWaitFramInterval.
     2243          end.
     2244          else
     2245             if     mWaitProcEvent
     2246                and not mBatchMode
     2247             then
     2248                process events .
     2249     end.
     2250   end procedure.
     2251      procedure waitfram-show-this:
     2252         define input  parameter iInterval as int64 no-undo.
     2253         define variable vtime as int64 no-undo.
     2254         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2255         mWaitFramInterval = iInterval.
     2256         run waitfram-show (substitute("&1&2 &3&4" ,
     2257                                       mWaitFramTextBeg ,
     2258                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2259                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2260                                       mWaitFramTextEnd
     2261                                      )
     2262                           ).
     2263      end.
     2264      procedure WaitFramRunPause:
     2265         define input  parameter iInterval as dec no-undo.
     2266         define variable vStart  as datetime-tz no-undo.
     2267         define variable vend    as datetime-tz no-undo.
     2268         define variable vint as int64 no-undo.
     2269         define variable vOk as logical no-undo.
     2270         vStart = now.
     2271         vend   = vStart.
     2272         publish "WaitFramPause" (iInterval,output vOk).
     2273         vend   =  now.
     2274         vint = vend - vStart.
     2275         vint = iInterval - vint / 1000.
     2276         if     not mWaitFramStop
     2277            and (   vint > 0
     2278                 or (    not vOk
     2279                     and iInterval eq ?
     2280                     )
     2281                 )
     2282         then
     2283            run waitfram-show-this (iInterval).
     2284         vend   =  now.
     2285         vint = vend - vStart.
     2286         vint = iInterval - vint / 1000.
     2287         if     not mWaitFramStop
     2288            and vint > 0
     2289         then do:
     2290            run gbl/pause.p (vint * 1000).
     2291         end.
     2292         if iInterval ne ?
     2293         then
     2294            publish "WaitFramStop".
     2295         waitfram-check-timeout().
     2296      end.
     2297      procedure WaitFramWaitFor:
     2298         define input  parameter iInterval as dec no-undo.
     2299         assign
     2300            mWaitFramStartProc   = now
     2301            mWaitFramStopUser    = no
     2302            mWaitFramStopTimeOut = no
     2303         .
     2304         block-wait:
     2305         do while not mWaitFramStop:
     2306            run WaitFramRunPause (iInterval).
     2307            if  waitfram-check-timeout()
     2308            then do:
     2309               leave block-wait.
     2310            end.
     2311         end.
     2312         run waitfram-hide.
     2313      end.
     2314   procedure waitfram-join :
     2315     define input  parameter p-line-1  as character no-undo .
     2316     define input  parameter p-line-2  as character no-undo .
     2317     define input  parameter p-line-3  as character no-undo .
     2318     define output parameter p-message as character no-undo .
     2319     do
     2320     on error undo, return error return-value
     2321     :
     2322       assign
     2323         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2324                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2325                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2326       .
     2327     end.
     2328   end procedure.
     2329   function waitfram-join-function returns character
     2330     (input p-line-1 as character
     2331     ,input p-line-2 as character
     2332     ,input p-line-3 as character
     2333     ).
     2334     define variable v-message as character no-undo .
     2335     run waitfram-join in this-procedure
     2336       (input  p-line-1
     2337       ,input  p-line-2
     2338       ,input  p-line-3
     2339       ,output v-message
     2340       ) .
     2341     return v-message .
     2342   end function .
     2343   define buffer buf_trn-doc for ub.trn-doc  .
     2344   define buffer buf_clients for ub.clients  .
     2345     define variable v-use-grp-buy           as logical   no-undo .
     2346     define variable v-use-oborot-buy        as logical   no-undo .
     2347     define variable v-use-qnty-group        as logical   no-undo .
     2348     define variable v-use-sum-group         as logical   no-undo .
     2349     define variable v-use-add-code          as logical   no-undo .
     2350     define variable v-use-sys-date-time     as logical   no-undo .
     2351     define variable v-use-shift-date-num    as logical   no-undo .
     2352     define variable v-use-cassa             as logical   no-undo .
     2353     define variable v-use-val               as logical   no-undo .
     2354     define variable v-use-pay-type          as logical   no-undo .
     2355     define variable v-use-cash-pay          as logical   no-undo .
     2356     define variable v-use-child             as logical   no-undo .
     2357   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run glstall in g#library
     2359   (  output v-use-grp-buy
     2360    , output v-use-oborot-buy
     2361    , output v-use-qnty-group
     2362    , output v-use-sum-group
     2363    , output v-use-add-code
     2364    , output v-use-sys-date-time
     2365    , output v-use-shift-date-num
     2366    , output v-use-cassa
     2367    , output v-use-val
     2368    , output v-use-pay-type
     2369    , output v-use-cash-pay
     2370    , output v-use-child
     2371           )  .
     2372   if not ( v-use-grp-buy or v-use-oborot-buy )  then return .
     2373   find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-doc-code no-error .
     2374       if error-status :error then return .
     2375   if not ( buf_trn-doc.status_   = 'факт':U and
     2376      ( buf_trn-doc.ext-doc-type = 'ee':U or
     2377        buf_trn-doc.ext-doc-type = 're':U )) then return .
     2378   find buf_clients no-lock where
     2379        buf_clients.obj-code = buf_trn-doc.cli-code and
     2380        buf_clients.obj-type = buf_trn-doc.cli-type no-error .
     2381   if not buf_clients.turnover-buyer then return .
     2382   run waitfram-show ( "Ждите... Расчет оборота по покупателю ..." ) .
     2383   run case-type.
     2384   define variable   v-sum-acc-base       as decimal   no-undo init 0 .
     2385   define variable   v-sum-acc-rubl       as decimal   no-undo init 0 .
     2386   define variable   v-sum-doc-base       as decimal   no-undo init 0 .
     2387   define variable   v-sum-doc-rubl       as decimal   no-undo init 0 .
     2388   define variable   v-sum-slt-acc-base   as decimal   no-undo init 0 .
     2389   define variable   v-sum-slt-acc-rubl   as decimal   no-undo init 0 .
     2390   define variable   v-sum-slt-doc-base   as decimal   no-undo init 0 .
     2391   define variable   v-sum-slt-doc-rubl   as decimal   no-undo init 0 .
     2392   define variable   v-sum-vat-acc-base   as decimal   no-undo init 0 .
     2393   define variable   v-sum-vat-acc-rubl   as decimal   no-undo init 0 .
     2394   define variable   v-sum-vat-doc-base   as decimal   no-undo init 0 .
     2395   define variable   v-sum-vat-doc-rubl   as decimal   no-undo init 0 .
     2396   define variable   v-sum-qnty-doc       as decimal   no-undo init 0 .
     2397   define variable   v-sum-qnty-check     as decimal   no-undo init 0 .
     2398   define buffer buf_turnover-buyer for ub.turnover-buyer  .
     2399   find first buf_turnover-buyer no-lock where
     2400       buf_turnover-buyer.cli-type  =  buf_trn-doc.cli-type and
     2401       buf_turnover-buyer.cli-code  =  buf_trn-doc.cli-code and
     2402       buf_turnover-buyer.obj-type  =  buf_trn-doc.obj-type and
     2403       buf_turnover-buyer.obj-code  =  buf_trn-doc.obj-code and
     2404       buf_turnover-buyer.fact-order < buf_trn-doc.fact-order use-index clients no-error .
     2405       if available buf_turnover-buyer then do:
     2406       assign
     2407           v-sum-acc-base      = buf_turnover-buyer.sum-acc-base-itog
     2408           v-sum-acc-rubl      = buf_turnover-buyer.sum-acc-rubl-itog
     2409           v-sum-doc-base      = buf_turnover-buyer.sum-doc-base-itog
     2410           v-sum-doc-rubl      = buf_turnover-buyer.sum-doc-rubl-itog
     2411           v-sum-slt-acc-base  = buf_turnover-buyer.sum-slt-acc-base-itog
     2412           v-sum-slt-acc-rubl  = buf_turnover-buyer.sum-slt-acc-rubl-itog
     2413           v-sum-slt-doc-base  = buf_turnover-buyer.sum-slt-doc-base-itog
     2414           v-sum-slt-doc-rubl  = buf_turnover-buyer.sum-slt-doc-rubl-itog
     2415           v-sum-vat-acc-base  = buf_turnover-buyer.sum-vat-acc-base-itog
     2416           v-sum-vat-acc-rubl  = buf_turnover-buyer.sum-vat-acc-rubl-itog
     2417           v-sum-vat-doc-base  = buf_turnover-buyer.sum-vat-doc-base-itog
     2418           v-sum-vat-doc-rubl  = buf_turnover-buyer.sum-vat-doc-rubl-itog
     2419           v-sum-qnty-doc      = buf_turnover-buyer.qnty-doc-itog
     2420           v-sum-qnty-check    = buf_turnover-buyer.qnty-check-itog
     2421       .
     2422          if v-sum-qnty-doc      = ?  then v-sum-qnty-doc   = 0 .
     2423          if v-sum-qnty-check    = ?  then v-sum-qnty-check = 0 .
     2424       end.
     2425       else do:
     2426       assign
     2427           v-sum-acc-base      = 0
     2428           v-sum-acc-rubl      = 0
     2429           v-sum-doc-base      = 0
     2430           v-sum-doc-rubl      = 0
     2431           v-sum-slt-acc-base  = 0
     2432           v-sum-slt-acc-rubl  = 0
     2433           v-sum-slt-doc-base  = 0
     2434           v-sum-slt-doc-rubl  = 0
     2435           v-sum-vat-acc-base  = 0
     2436           v-sum-vat-acc-rubl  = 0
     2437           v-sum-vat-doc-base  = 0
     2438           v-sum-vat-doc-rubl  = 0
     2439           v-sum-qnty-doc      = 0
     2440           v-sum-qnty-check    = 0
     2441       .
     2442       end.
     2443       for each ub.turnover-buyer exclusive-lock where
     2444               ub.turnover-buyer.cli-type  = buf_trn-doc.cli-type and
     2445               ub.turnover-buyer.cli-code  = buf_trn-doc.cli-code and
     2446               ub.turnover-buyer.obj-type  = buf_trn-doc.obj-type and
     2447               ub.turnover-buyer.obj-code  = buf_trn-doc.obj-code and
     2448               ub.turnover-buyer.fact-order >= buf_trn-doc.fact-order
     2449               by ub.turnover-buyer.fact-order
     2450               :
     2451         assign
     2452           v-sum-acc-base     =  v-sum-acc-base     + ub.turnover-buyer.sum-acc-base
     2453           v-sum-acc-rubl     =  v-sum-acc-rubl     + ub.turnover-buyer.sum-acc-rubl
     2454           v-sum-doc-base     =  v-sum-doc-base     + ub.turnover-buyer.sum-doc-base
     2455           v-sum-doc-rubl     =  v-sum-doc-rubl     + ub.turnover-buyer.sum-doc-rubl
     2456           v-sum-slt-acc-base =  v-sum-slt-acc-base + ub.turnover-buyer.sum-slt-acc-base
     2457           v-sum-slt-acc-rubl =  v-sum-slt-acc-rubl + ub.turnover-buyer.sum-slt-acc-rubl
     2458           v-sum-slt-doc-base =  v-sum-slt-doc-base + ub.turnover-buyer.sum-slt-doc-base
     2459           v-sum-slt-doc-rubl =  v-sum-slt-doc-rubl + ub.turnover-buyer.sum-slt-doc-rubl
     2460           v-sum-vat-acc-base =  v-sum-vat-acc-base + ub.turnover-buyer.sum-vat-acc-base
     2461           v-sum-vat-acc-rubl =  v-sum-vat-acc-rubl + ub.turnover-buyer.sum-vat-acc-rubl
     2462           v-sum-vat-doc-base =  v-sum-vat-doc-base + ub.turnover-buyer.sum-vat-doc-base
     2463           v-sum-vat-doc-rubl =  v-sum-vat-doc-rubl + ub.turnover-buyer.sum-vat-doc-rubl
     2464           .
     2465           if ub.turnover-buyer.doc-code   <> "" then v-sum-qnty-doc = v-sum-qnty-doc + 1.
     2466           if ub.turnover-buyer.inkas-code <> "" then v-sum-qnty-check = v-sum-qnty-check + 1.
     2467         assign
     2468           ub.turnover-buyer.sum-acc-base-itog      = v-sum-acc-base
     2469           ub.turnover-buyer.sum-acc-rubl-itog      = v-sum-acc-rubl
     2470           ub.turnover-buyer.sum-doc-base-itog      = v-sum-doc-base
     2471           ub.turnover-buyer.sum-doc-rubl-itog      = v-sum-doc-rubl
     2472           ub.turnover-buyer.sum-slt-acc-base-itog  = v-sum-slt-acc-base
     2473           ub.turnover-buyer.sum-slt-acc-rubl-itog  = v-sum-slt-acc-rubl
     2474           ub.turnover-buyer.sum-slt-doc-base-itog  = v-sum-slt-doc-base
     2475           ub.turnover-buyer.sum-slt-doc-rubl-itog  = v-sum-slt-doc-rubl
     2476           ub.turnover-buyer.sum-vat-acc-base-itog  = v-sum-vat-acc-base
     2477           ub.turnover-buyer.sum-vat-acc-rubl-itog  = v-sum-vat-acc-rubl
     2478           ub.turnover-buyer.sum-vat-doc-base-itog  = v-sum-vat-doc-base
     2479           ub.turnover-buyer.sum-vat-doc-rubl-itog  = v-sum-vat-doc-rubl
     2480           ub.turnover-buyer.qnty-doc-itog          = v-sum-qnty-doc
     2481           ub.turnover-buyer.qnty-check-itog        = v-sum-qnty-check
     2482           .
     2483       end.
     2484       find first ub.turnover-buyer-main exclusive-lock where
     2485         ub.turnover-buyer-main.cli-code               = buf_trn-doc.cli-code and
     2486         ub.turnover-buyer-main.cli-type               = buf_trn-doc.cli-type and
     2487         ub.turnover-buyer-main.obj-code               = buf_trn-doc.obj-code and
     2488         ub.turnover-buyer-main.obj-type               = buf_trn-doc.obj-type no-error .
     2489         if not available ub.turnover-buyer-main then  create ub.turnover-buyer-main .
     2490         assign
     2491         ub.turnover-buyer-main.cli-code               = buf_trn-doc.cli-code
     2492         ub.turnover-buyer-main.cli-type               = buf_trn-doc.cli-type
     2493         ub.turnover-buyer-main.des                    = ""
     2494         ub.turnover-buyer-main.obj-code               = buf_trn-doc.obj-code
     2495         ub.turnover-buyer-main.obj-type               = buf_trn-doc.obj-type
     2496         ub.turnover-buyer-main.sum-acc-base-itog     =  v-sum-acc-base
     2497         ub.turnover-buyer-main.sum-acc-rubl-itog     =  v-sum-acc-rubl
     2498         ub.turnover-buyer-main.sum-doc-base-itog     =  v-sum-doc-base
     2499         ub.turnover-buyer-main.sum-doc-rubl-itog     =  v-sum-doc-rubl
     2500         ub.turnover-buyer-main.qnty-doc-itog         = v-sum-qnty-doc
     2501         ub.turnover-buyer-main.qnty-check-itog       = v-sum-qnty-check
     2502         .
     2503   run waitfram-hide .
     2504   procedure case-type :
     2505     do
     2506     on error undo, return error return-value
     2507     :
     2508   define variable   v-sum-acc-base       as decimal   no-undo init 0 .
     2509   define variable   v-sum-acc-rubl       as decimal   no-undo init 0 .
     2510   define variable   v-sum-doc-base       as decimal   no-undo init 0 .
     2511   define variable   v-sum-doc-rubl       as decimal   no-undo init 0 .
     2512   define variable   v-sum-slt-acc-base   as decimal   no-undo init 0 .
     2513   define variable   v-sum-slt-acc-rubl   as decimal   no-undo init 0 .
     2514   define variable   v-sum-slt-doc-base   as decimal   no-undo init 0 .
     2515   define variable   v-sum-slt-doc-rubl   as decimal   no-undo init 0 .
     2516   define variable   v-sum-vat-acc-base   as decimal   no-undo init 0 .
     2517   define variable   v-sum-vat-acc-rubl   as decimal   no-undo init 0 .
     2518   define variable   v-sum-vat-doc-base   as decimal   no-undo init 0 .
     2519   define variable   v-sum-vat-doc-rubl   as decimal   no-undo init 0 .
     2520   define variable   v-acc-base       as decimal   no-undo init 0 .
     2521   define variable   v-acc-rubl       as decimal   no-undo init 0 .
     2522   define variable   v-doc-base       as decimal   no-undo init 0 .
     2523   define variable   v-doc-rubl       as decimal   no-undo init 0 .
     2524   define variable   v-slt-acc-base   as decimal   no-undo init 0 .
     2525   define variable   v-slt-acc-rubl   as decimal   no-undo init 0 .
     2526   define variable   v-slt-doc-base   as decimal   no-undo init 0 .
     2527   define variable   v-slt-doc-rubl   as decimal   no-undo init 0 .
     2528   define variable   v-vat-acc-base   as decimal   no-undo init 0 .
     2529   define variable   v-vat-acc-rubl   as decimal   no-undo init 0 .
     2530   define variable   v-vat-doc-base   as decimal   no-undo init 0 .
     2531   define variable   v-vat-doc-rubl   as decimal   no-undo init 0 .
     2532   define variable v-sign as integer   no-undo .
     2533   define buffer buf_goods for ub.goods  .
     2534   define buffer buf_doc-line for ub.doc-line  .
     2535    for each buf_doc-line no-lock
     2536       where buf_doc-line.doc-code = buf_trn-doc.doc-code  :
     2537       run clcprtsl_calc-line in this-procedure ( input recid( buf_doc-line ) ).
     2538       find first tt-allsum-line
     2539            where tt-allsum-line.sum-type = 'основная_сумма':U
     2540       no-error.
     2541       if not available tt-allsum-line then next.
     2542           assign
     2543             v-acc-base      = tt-allsum-line.sum-dsc-base-acc
     2544             v-acc-rubl      = tt-allsum-line.sum-dsc-rubl-acc
     2545             v-doc-base      = tt-allsum-line.sum-dsc-base-doc
     2546             v-doc-rubl      = tt-allsum-line.sum-dsc-rubl-doc
     2547             v-slt-acc-base  = tt-allsum-line.slt-base-acc
     2548             v-slt-acc-rubl  = tt-allsum-line.slt-rubl-acc
     2549             v-slt-doc-base  = tt-allsum-line.slt-base-doc
     2550             v-slt-doc-rubl  = tt-allsum-line.slt-rubl-doc
     2551             v-vat-acc-base  = tt-allsum-line.vat-base-acc
     2552             v-vat-acc-rubl  = tt-allsum-line.vat-rubl-acc
     2553             v-vat-doc-base  = tt-allsum-line.vat-base-doc
     2554             v-vat-doc-rubl  = tt-allsum-line.vat-rubl-doc
     2555          .
     2556       assign
     2557       v-sum-acc-base     =  v-sum-acc-base     +  v-acc-base
     2558       v-sum-acc-rubl     =  v-sum-acc-rubl     +  v-acc-rubl
     2559       v-sum-doc-base     =  v-sum-doc-base     +  v-doc-base
     2560       v-sum-doc-rubl     =  v-sum-doc-rubl     +  v-doc-rubl
     2561       v-sum-slt-acc-base =  v-sum-slt-acc-base +  v-slt-acc-base
     2562       v-sum-slt-acc-rubl =  v-sum-slt-acc-rubl +  v-slt-acc-rubl
     2563       v-sum-slt-doc-base =  v-sum-slt-doc-base +  v-slt-doc-base
     2564       v-sum-slt-doc-rubl =  v-sum-slt-doc-rubl +  v-slt-doc-rubl
     2565       v-sum-vat-acc-base =  v-sum-vat-acc-base +  v-vat-acc-base
     2566       v-sum-vat-acc-rubl =  v-sum-vat-acc-rubl +  v-vat-acc-rubl
     2567       v-sum-vat-doc-base =  v-sum-vat-doc-base +  v-vat-doc-base
     2568       v-sum-vat-doc-rubl =  v-sum-vat-doc-rubl +  v-vat-doc-rubl
     2569       .
     2570      if buf_clients.turnover-buyer-gds then do :
     2571         find first buf_goods no-lock where
     2572                    buf_goods.artic = buf_doc-line.artic         and
     2573                    buf_goods.prod-type = buf_doc-line.prod-type and
     2574                    buf_goods.prod-code = buf_doc-line.prod-code no-error  .
     2575     if  buf_trn-doc.ext-doc-type =  'ee':U or
     2576         buf_trn-doc.ext-doc-type =  're':U
     2577     then do:
     2578         if buf_trn-doc.ext-doc-type =  're':U then v-sign = (-1) .
     2579           else v-sign = 1 .
     2580         create ub.turnover-buyer-gds .
     2581         assign
     2582         ub.turnover-buyer-gds.gds-code     = buf_goods.gds-code
     2583         ub.turnover-buyer-gds.cli-code     = buf_trn-doc.cli-code
     2584         ub.turnover-buyer-gds.cli-type     = buf_trn-doc.cli-type
     2585         ub.turnover-buyer-gds.d-card       = ""
     2586         ub.turnover-buyer-gds.des          = ""
     2587         ub.turnover-buyer-gds.doc-code     = buf_trn-doc.doc-code
     2588         ub.turnover-buyer-gds.ext-doc-type = buf_trn-doc.ext-doc-type
     2589         ub.turnover-buyer-gds.fact-date    = buf_trn-doc.fact-date
     2590         ub.turnover-buyer-gds.fact-order   = buf_trn-doc.fact-order
     2591         ub.turnover-buyer-gds.inkas-code   = ""
     2592         ub.turnover-buyer-gds.obj-code     = buf_trn-doc.obj-code
     2593         ub.turnover-buyer-gds.obj-type     = buf_trn-doc.obj-type
     2594         ub.turnover-buyer-gds.shift-date       = buf_trn-doc.shift-date
     2595         ub.turnover-buyer-gds.shift-num        = buf_trn-doc.shift-num
     2596         ub.turnover-buyer-gds.shift-name       = buf_trn-doc.shift-name
     2597         ub.turnover-buyer-gds.sum-acc-base     =  v-acc-base
     2598         ub.turnover-buyer-gds.sum-acc-rubl     =  v-acc-rubl
     2599         ub.turnover-buyer-gds.sum-doc-base     =  v-doc-base
     2600         ub.turnover-buyer-gds.sum-doc-rubl     =  v-doc-rubl
     2601         ub.turnover-buyer-gds.sum-slt-acc-base = v-sign * v-slt-acc-base
     2602         ub.turnover-buyer-gds.sum-slt-acc-rubl = v-sign * v-slt-acc-rubl
     2603         ub.turnover-buyer-gds.sum-slt-doc-base = v-sign * v-slt-doc-base
     2604         ub.turnover-buyer-gds.sum-slt-doc-rubl = v-sign * v-slt-doc-rubl
     2605         ub.turnover-buyer-gds.sum-vat-acc-base = v-sign * v-vat-acc-base
     2606         ub.turnover-buyer-gds.sum-vat-acc-rubl = v-sign * v-vat-acc-rubl
     2607         ub.turnover-buyer-gds.sum-vat-doc-base = v-sign * v-vat-doc-base
     2608         ub.turnover-buyer-gds.sum-vat-doc-rubl = v-sign * v-vat-doc-rubl
     2609         ub.turnover-buyer-gds.sum-type         = ""
     2610         ub.turnover-buyer-gds.sys-date         = today
     2611         ub.turnover-buyer-gds.sys-time         = time
     2612         ub.turnover-buyer-gds.sys-time-char    = string(ub.turnover-buyer-gds.sys-time,"hh:mm")
     2613         ub.turnover-buyer-gds.type             = 0
     2614         .
     2615         end.
     2616      end.
     2617    end.
     2618     case buf_trn-doc.ext-doc-type :
     2619         when 'ee':U  then do:
     2620           run create_tbl (
     2621               v-sum-acc-base     ,
     2622               v-sum-acc-rubl     ,
     2623               v-sum-doc-base     ,
     2624               v-sum-doc-rubl     ,
     2625               v-sum-slt-acc-base ,
     2626               v-sum-slt-acc-rubl ,
     2627               v-sum-slt-doc-base ,
     2628               v-sum-slt-doc-rubl ,
     2629               v-sum-vat-acc-base ,
     2630               v-sum-vat-acc-rubl ,
     2631               v-sum-vat-doc-base ,
     2632               v-sum-vat-doc-rubl  ).
     2633         end.
     2634         when 're':U  then do:
     2635           run create_tbl (
     2636               (-1) * v-sum-acc-base     ,
     2637               (-1) * v-sum-acc-rubl     ,
     2638               (-1) * v-sum-doc-base     ,
     2639               (-1) * v-sum-doc-rubl     ,
     2640               (-1) * v-sum-slt-acc-base ,
     2641               (-1) * v-sum-slt-acc-rubl ,
     2642               (-1) * v-sum-slt-doc-base ,
     2643               (-1) * v-sum-slt-doc-rubl ,
     2644               (-1) * v-sum-vat-acc-base ,
     2645               (-1) * v-sum-vat-acc-rubl ,
     2646               (-1) * v-sum-vat-doc-base ,
     2647               (-1) * v-sum-vat-doc-rubl  ).
     2648         end.
     2649     end case.
     2650     end.
     2651   end procedure.
     2652   procedure create_tbl  :
     2653     do
     2654     on error undo, return error return-value
     2655     :
     2656   define input  parameter v-sum-acc-base       as decimal   no-undo .
     2657   define input  parameter v-sum-acc-rubl       as decimal   no-undo .
     2658   define input  parameter v-sum-doc-base       as decimal   no-undo .
     2659   define input  parameter v-sum-doc-rubl       as decimal   no-undo .
     2660   define input  parameter v-sum-slt-acc-base   as decimal   no-undo .
     2661   define input  parameter v-sum-slt-acc-rubl   as decimal   no-undo .
     2662   define input  parameter v-sum-slt-doc-base   as decimal   no-undo .
     2663   define input  parameter v-sum-slt-doc-rubl   as decimal   no-undo .
     2664   define input  parameter v-sum-vat-acc-base   as decimal   no-undo .
     2665   define input  parameter v-sum-vat-acc-rubl   as decimal   no-undo .
     2666   define input  parameter v-sum-vat-doc-base   as decimal   no-undo .
     2667   define input  parameter v-sum-vat-doc-rubl   as decimal   no-undo .
     2668       create ub.turnover-buyer .
     2669       assign
     2670         ub.turnover-buyer.cli-code     = buf_trn-doc.cli-code
     2671         ub.turnover-buyer.cli-type     = buf_trn-doc.cli-type
     2672         ub.turnover-buyer.d-card       = ""
     2673         ub.turnover-buyer.des          = ""
     2674         ub.turnover-buyer.doc-code     = buf_trn-doc.doc-code
     2675         ub.turnover-buyer.ext-doc-type = buf_trn-doc.ext-doc-type
     2676         ub.turnover-buyer.fact-date    = buf_trn-doc.fact-date
     2677         ub.turnover-buyer.fact-order   = buf_trn-doc.fact-order
     2678         ub.turnover-buyer.inkas-code   = ""
     2679         ub.turnover-buyer.obj-code     = buf_trn-doc.obj-code
     2680         ub.turnover-buyer.obj-type     = buf_trn-doc.obj-type
     2681         ub.turnover-buyer.qnty-check       = 0
     2682         ub.turnover-buyer.qnty-doc-itog    = 1
     2683         ub.turnover-buyer.shift-date       = buf_trn-doc.shift-date
     2684         ub.turnover-buyer.shift-num        = buf_trn-doc.shift-num
     2685         ub.turnover-buyer.shift-name       = buf_trn-doc.shift-name
     2686         ub.turnover-buyer.sum-acc-base     =  v-sum-acc-base
     2687         ub.turnover-buyer.sum-acc-rubl     =  v-sum-acc-rubl
     2688         ub.turnover-buyer.sum-doc-base     =  v-sum-doc-base
     2689         ub.turnover-buyer.sum-doc-rubl     =  v-sum-doc-rubl
     2690         ub.turnover-buyer.sum-slt-acc-base =  v-sum-slt-acc-base
     2691         ub.turnover-buyer.sum-slt-acc-rubl =  v-sum-slt-acc-rubl
     2692         ub.turnover-buyer.sum-slt-doc-base =  v-sum-slt-doc-base
     2693         ub.turnover-buyer.sum-slt-doc-rubl =  v-sum-slt-doc-rubl
     2694         ub.turnover-buyer.sum-vat-acc-base =  v-sum-vat-acc-base
     2695         ub.turnover-buyer.sum-vat-acc-rubl =  v-sum-vat-acc-rubl
     2696         ub.turnover-buyer.sum-vat-doc-base =  v-sum-vat-doc-base
     2697         ub.turnover-buyer.sum-vat-doc-rubl =  v-sum-vat-doc-rubl
     2698         ub.turnover-buyer.sum-type         = ""
     2699         ub.turnover-buyer.sys-date         = today
     2700         ub.turnover-buyer.sys-time         = time
     2701         ub.turnover-buyer.sys-time-char    = string(ub.turnover-buyer.sys-time,"hh:mm")
     2702         ub.turnover-buyer.type             = 0
     2703       .
     2704     end.
     2705   end procedure.
