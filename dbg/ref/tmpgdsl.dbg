        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Товары с темпами    ".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define new shared temp-table gds-list no-undo like ub.goods
       69     field qnty   as decimal
       70     field to-del as logical
       71     field order-num as integer
       72     field to-sel as logical
       73     field promo-code as character
       74     field ActionId  as int64
       75     field db-num as integer
       76     index art  is primary unique artic prod-type prod-code
       77     index code is         unique gds-code
       78     index oi order-num
       79     index isel to-sel
       80     .
       81   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define  new shared  temp-table gds-list-hist no-undo
       83   field list-table as character
       84   field id as integer
       85   field line as integer
       86   field hist-mode as character
       87   field des as character
       88   field num-recs as integer
       89   field option_ as character
       90   field item_ as character
       91   field status_ as character
       92   field num-add as integer
       93   field num-ignored as integer
       94   field done as logical
       95   field err_ as logical
       96   field err-mes as character
       97   index pi is primary
       98   id
       99   line
      100   index isdone
      101   done
      102   .
      103   procedure proc-alt-shift-f2:
      104     if not ibs.th.gbl.gbl-var:rcode
      105   then
      106     run gbl\inidebug.p .
      107   end.
      108   procedure proc-alt-shift-f3:
      109     run gbl/prvssinf.p
      110       ( input this-procedure
      111       ) .
      112   end.
      113   define variable v-inform-launched as logical no-undo initial false .
      114   procedure proc-alt-shift-f4:
      115     define variable v-action as character no-undo .
      116     if v-inform-launched = false then do:
      117       assign
      118         v-inform-launched = true
      119       .
      120       run gbl/d-inform.w
      121         (  input self
      122         ,  input this-procedure
      123         , output v-action
      124         ) no-error .
      125       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      126       assign
      127         v-inform-launched = false
      128       .
      129     end.
      130   end.
      131   procedure proc-alt-f1:
      132     run gbl/corrhelp.p
      133       (input this-procedure
      134       ) .
      135   end .
      136   on alt-shift-f2 anywhere do:
      137     run proc-alt-shift-f2.
      138   end.
      139   on alt-shift-f3 anywhere do:
      140     run proc-alt-shift-f3 in this-procedure .
      141   end.
      142   on alt-shift-f4 anywhere do:
      143     run proc-alt-shift-f4 in this-procedure.
      144   end.
      145   on alt-f1 anywhere do:
      146     run proc-alt-f1 in this-procedure .
      147   end.
      148   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149     define variable v-cntxt-db-num        as integer   no-undo .
      150     define variable v-cntxt-userid        as character no-undo .
      151     define variable v-cntxt-level         as character no-undo .
      152     define variable v-cntxt-host-code-obj as integer   no-undo .
      153     define variable v-cntxt-obj-type      as character no-undo .
      154     define variable v-cntxt-obj-code      as integer   no-undo .
      155     define variable v-cntxt-db-num-obj    as integer   no-undo .
      156     define variable v-cntxt-is-admin      as logical   no-undo .
      157   define input  parameter parParentProc  as widget-handle no-undo.
      158   define input  param t-code like ub.tmp-sale.tmp-code no-undo.
      159   define input  param t-name like ub.tmp-sale.desc_ no-undo.
      160   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161     run mainmenu_getcntxt in parparentproc
      162       (output v-cntxt-db-num
      163       ,output v-cntxt-userid
      164       ,output v-cntxt-level
      165       ,output v-cntxt-host-code-obj
      166       ,output v-cntxt-obj-type
      167       ,output v-cntxt-obj-code
      168       ,output v-cntxt-db-num-obj
      169       ,output v-cntxt-is-admin
      170       ) .
      171   define variable  line-mode      as character no-undo .
      172   define variable doc-rec as recid no-undo .
      173   define variable gds-rec as recid no-undo .
      174   define variable v-log as logical   no-undo .
      175   define variable rid-list    as  char no-undo .
      176   define variable log-res as log no-undo.
      177   define variable rr as recid no-undo.
      178   define temp-table tt-gds-list no-undo like ub.goods
      179   field nn as integer
      180   index by-nn nn
      181   index by_gds-code gds-code
      182   .
      183   define variable varschartic       like ub.price-list.artic initial " " no-undo.
      184   define variable ref-list  as char                     no-undo.
      185   define variable sch-field as char no-undo.
      186   def buffer t-s for ub.tmp-sale-gds.
      187   def buffer t-g for ub.goods.
      188   define variable sort-column-name as character no-undo .
      189   define variable list-option as char no-undo.
      190   define stream sout.
      191   DEFINE MENU POPUP-MENU-b-list
      192          MENU-ITEM m_item1        LABEL "Сохранить"
      193          MENU-ITEM m_item2        LABEL "Загрузить"     .
      194   DEFINE BUTTON b-add
      195        LABEL "&Добавить":L
      196        SIZE 10 BY 1.
      197   DEFINE BUTTON b-exit AUTO-GO
      198        LABEL "&Выход ":L
      199        SIZE 10 BY 1.
      200   DEFINE BUTTON b-help
      201        LABEL "Помо&щь":L
      202        SIZE 10 BY 1.
      203   DEFINE BUTTON b-list
      204        LABEL "Список":L
      205        SIZE 10 BY 1.
      206   DEFINE BUTTON B-mark
      207        LABEL "&*"
      208        SIZE 3 BY 1.
      209   DEFINE BUTTON b-print
      210        LABEL "Пе&чать":L
      211        SIZE 10 BY 1.
      212   DEFINE BUTTON b-prt
      213        LABEL "&Шкала":L
      214        SIZE 10 BY 1 TOOLTIP "Признаки товара".
      215   DEFINE BUTTON b-sel AUTO-GO
      216        LABEL "Вы&бор ":L
      217        SIZE 10 BY 1.
      218   DEFINE BUTTON b-upd
      219        LABEL "&Изменить":L
      220        SIZE 10 BY 1.
      221   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск по"
      222         VIEW-AS TEXT
      223        SIZE 8.88 BY .67
      224        FGCOLOR 4  NO-UNDO.
      225   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      226         VIEW-AS TEXT
      227        SIZE 9 BY .67
      228        FGCOLOR 4  NO-UNDO.
      229   DEFINE VARIABLE s-artic AS CHARACTER FORMAT "X(256)":U
      230        VIEW-AS FILL-IN
      231        SIZE 30 BY 1
      232        FGCOLOR 1  NO-UNDO.
      233   DEFINE VARIABLE s-name AS CHARACTER FORMAT "X(256)":U
      234        VIEW-AS FILL-IN
      235        SIZE 30 BY 1
      236        FGCOLOR 1  NO-UNDO.
      237   DEFINE VARIABLE s-name-cnt AS CHARACTER FORMAT "X(256)":U
      238        VIEW-AS FILL-IN
      239        SIZE 30 BY 1
      240        FGCOLOR 1  NO-UNDO.
      241   DEFINE VARIABLE R-sort AS INTEGER
      242        VIEW-AS RADIO-SET HORIZONTAL
      243        RADIO-BUTTONS
      244             "Артик", 1,
      245   "Нач.назв", 2,
      246   "Нач.слова", 3
      247        SIZE 35.25 BY .96 TOOLTIP "Поиск по" NO-UNDO.
      248   DEFINE QUERY BROWSE-2 FOR
      249         ub.tmp-sale-gds,
      250         ub.goods SCROLLING.
      251   DEFINE BROWSE BROWSE-2
      252     QUERY BROWSE-2 NO-LOCK DISPLAY
      253         ub.goods.artic
      254         ub.goods.gds-name FORMAT "X(35)"
      255         ub.goods.unit-base
      256         ub.tmp-sale-gds.tmp-value    format ">>>>>>>>>>9.999"
      257     ENABLE
      258         ub.tmp-sale-gds.tmp-value
      259       WITH NO-ROW-MARKERS SEPARATORS SIZE 87.75 BY 18.75
      260            BGCOLOR 15 .
      261   DEFINE FRAME Dialog-Frame
      262        b-exit AT ROW 1 COL 1
      263        b-sel AT ROW 1 COL 11
      264        B-mark AT ROW 1 COL 21
      265        b-add AT ROW 1 COL 24
      266        b-upd AT ROW 1 COL 34
      267        b-prt AT ROW 1 COL 44
      268        b-print AT ROW 1 COL 54
      269        b-list AT ROW 1 COL 64
      270        b-help AT ROW 1 COL 79.25
      271        R-sort AT ROW 2.13 COL 10.63 NO-LABEL
      272        s-name-cnt AT ROW 2.13 COL 44 COLON-ALIGNED NO-LABEL
      273        s-name AT ROW 2.13 COL 44 COLON-ALIGNED NO-LABEL
      274        s-artic AT ROW 2.13 COL 44 COLON-ALIGNED NO-LABEL
      275        BROWSE-2 AT ROW 3.25 COL 1.5
      276        FILL-IN-2 AT ROW 2.21 COL 1 NO-LABEL
      277        mark-num AT ROW 2.33 COL 76.75 NO-LABEL
      278        SPACE(3.99) SKIP(19.03)
      279       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      280            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      281            TITLE "Товары".
      282   ASSIGN
      283          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      284          FRAME Dialog-Frame:HIDDEN           = TRUE.
      285   ASSIGN
      286          b-list:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-list:HANDLE.
      287   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      288   DO:
      289     APPLY "END-ERROR":U TO SELF.
      290   END.
      291   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      292   DO:
      293   assign
      294     line-mode = 'ДОБАВЛЕНИЕ':U
      295   .
      296   run str/chsgdsls.w
      297   (   parParentProc ,
      298       input "temp" ,
      299       input "Темп продаж " + t-name  , ? , ? ,
      300       input v-cntxt-host-code-obj,
      301       input-output varschartic,
      302       output ref-list,
      303       output table tt-gds-list,
      304       false )
      305       .
      306       run cycle-add in this-procedure .
      307       OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     .
      308   END.
      309   ON CHOOSE OF b-list IN FRAME Dialog-Frame
      310   DO:
      311       if list-option = "" then do:
      312       run gbl/pop-up.p (self:handle, no) no-error.
      313       if error-status:error then return no-apply.
      314     end.
      315   END.
      316   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      317   DO:
      318   END.
      319   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      320   DO:
      321       if ( available ub.tmp-sale ) AND ( rid-list = "" ) then
      322           rid-list = string( recid( ub.tmp-sale ) ) .
      323   END.
      324   ON CHOOSE OF b-upd IN FRAME Dialog-Frame
      325   DO:
      326       if not available ub.tmp-sale THEN
      327           return no-apply.
      328   END.
      329   ON CHOOSE OF MENU-ITEM m_item1
      330   DO:
      331      list-option = "save":U.
      332     run proc-b-list in this-procedure (input list-option) no-error.
      333     if error-status:error then return no-apply.
      334   END.
      335   ON CHOOSE OF MENU-ITEM m_item2
      336   DO:
      337        list-option = "load":U.
      338     run proc-b-list in this-procedure (input list-option) no-error.
      339     if error-status:error then return no-apply.
      340   END.
      341   ON VALUE-CHANGED OF R-sort IN FRAME Dialog-Frame
      342   DO:
      343     Assign frame Dialog-Frame r-sort.
      344     case r-sort :
      345     when 1 then do:
      346           if sch-field = "s-name-cnt" then do:
      347                          assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name.
      348                         OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     .
      349                         end.
      350           enable s-artic with frame Dialog-Frame.
      351               Hide s-name  s-name-cnt in frame Dialog-Frame.
      352           display s-artic with frame Dialog-Frame.
      353      end.
      354     when 2 then do:
      355       if sch-field = "s-name-cnt" then do:
      356                    assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name.
      357                   OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     .
      358                   end.
      359           enable s-name with frame Dialog-Frame.
      360           hide s-artic  s-name-cnt in frame Dialog-Frame.
      361           display s-name with frame Dialog-Frame.
      362      end.
      363     when 3 then do:
      364           enable s-name-cnt with frame Dialog-Frame.
      365           hide s-artic  s-name in frame Dialog-Frame.
      366           display s-name-cnt with frame Dialog-Frame.
      367      end.
      368     end case.
      369   END.
      370   ON MOUSE-SELECT-DBLCLICK OF s-artic IN FRAME Dialog-Frame
      371   OR  RETURN OF s-artic IN FRAME Dialog-Frame
      372   DO:
      373     if s-artic <> input frame Dialog-Frame s-artic or sch-field <> "s-artic" then do:
      374    sch-field = "s-artic".
      375    assign s-artic = input frame Dialog-Frame s-artic.
      376    doc-rec = ?.
      377    for each t-s where t-s.tmp-code = t-code,
      378        first t-g where t-s.artic = t-g.artic and
      379                        t-s.prod-type = t-g.prod-type and
      380                        t-s.prod-code = t-g.prod-code and
      381                        t-g.artic begins s-artic :
      382            doc-rec = recid(t-s) .
      383            leave.
      384    end.
      385     if doc-rec = ? then message "Товар не найден !"  .
      386     else
      387         reposition BROWSE-2 to recid doc-rec no-error.
      388   return no-apply.
      389   end.
      390   END.
      391   ON MOUSE-SELECT-DBLCLICK OF s-name IN FRAME Dialog-Frame
      392   OR  RETURN OF s-name IN FRAME Dialog-Frame
      393   DO:
      394     if s-name <> input frame Dialog-Frame s-name or sch-field <> "s-name" then do:
      395    sch-field = "s-name".
      396    assign s-name = input frame Dialog-Frame s-name.
      397    doc-rec = ?.
      398    for each t-s where t-s.tmp-code = t-code,
      399               first t-g where t-s.artic = t-g.artic and
      400                               t-s.prod-type = t-g.prod-type and
      401                               t-s.prod-code = t-g.prod-code and
      402                               t-g.gds-name begins s-name :
      403            doc-rec = recid(t-s) .
      404            leave.
      405    end.
      406     if doc-rec = ? then message "Товар не найден !"  .
      407     else
      408         reposition BROWSE-2 to recid doc-rec no-error.
      409   return no-apply.
      410   end.
      411   END.
      412   ON MOUSE-SELECT-DBLCLICK OF s-name-cnt IN FRAME Dialog-Frame
      413   OR  RETURN OF s-name-cnt IN FRAME Dialog-Frame
      414   DO:
      415     if s-name-cnt <> input frame Dialog-Frame s-name-cnt or sch-field <> "s-name-cnt" then do:
      416    sch-field = "s-name-cnt".
      417    assign s-name-cnt = input frame Dialog-Frame s-name-cnt.
      418    doc-rec = ?.
      419    for each t-s where t-s.tmp-code = t-code,
      420               first t-g where t-s.artic = t-g.artic and
      421                               t-s.prod-type = t-g.prod-type and
      422                               t-s.prod-code = t-g.prod-code and
      423                               INDEX(t-g.gds-name,s-name-cnt) > 0 :
      424            doc-rec = recid(t-s) .
      425            leave.
      426    end.
      427     if doc-rec = ? then message "Товар не найден !"  .
      428     else do:
      429        assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name + " , содержащие в названии " + s-name-cnt .
      430         OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods where       ub.goods.artic = ub.tmp-sale-gds.artic and       ub.goods.prod-type = ub.tmp-sale-gds.prod-type and       ub.goods.prod-code = ub.tmp-sale-gds.prod-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK .
      431        end.
      432   return no-apply.
      433   end.
      434   END.
      435   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      436   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      437   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   on help of frame Dialog-Frame
      439   do:
      440     run gbl/app_help.p
      441       (input this-procedure :file-name
      442       ,input ''
      443       ,input ?
      444       ) no-error.
      445     if error-status :error then do:
      446       message
      447         "Ошибка при вызове помощи"
      448         error-status :get-message(1)
      449         view-as alert-box .
      450     end.
      451   end.
      452   run minbtn-set in this-procedure .
      453   on choose of b-help in frame Dialog-Frame
      454   do:
      455     apply "help":u to frame Dialog-Frame .
      456   end.
      457   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      458   procedure minbtn-set :
      459       do
      460           on error undo, return error return-value
      461           :
      462           define variable ii              as integer       no-undo .
      463           define variable fh              as widget-handle no-undo .
      464           define variable hh              as widget-handle no-undo .
      465           define variable v-h             as handle        extent 4 no-undo .
      466           define variable v-name-button   as character     no-undo .
      467           define variable v-help-old-x    as decimal       no-undo .
      468           define variable v-help-old-y    as decimal       no-undo .
      469           define variable v-help-old-size as decimal       no-undo .
      470           define variable v-frame-width   as decimal       no-undo .
      471           define variable jj              as integer       no-undo .
      472           do
      473               on error undo, return error
      474               :
      475               assign
      476                   v-frame-width = frame Dialog-Frame:width - 0.3
      477                   fh            = frame Dialog-Frame:first-child
      478                   hh            = fh:first-child
      479                   ii            = 1
      480                   .
      481               do while valid-handle(hh):
      482                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      483                   do:
      484                       case lc(hh:name) :
      485                           when "b-help" then
      486                               do:
      487                                   hh:load-image-up("cmp/b-help.bmp":u) .
      488                                   hh:load-image-down("cmp/b-help.bmp":u) .
      489                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      490                                   hh:TOOLTIP = "Помощь" .
      491                                   v-help-old-x = hh:column .
      492                                   v-help-old-y = hh:row    .
      493                                   v-help-old-size = hh:width .
      494                                   hh:width-chars = 2.5 .
      495                               end.
      496                           when "b-print" then
      497                               do:
      498                                   hh:load-image("cmp/b-print.bmp":u) .
      499                                   hh:TOOLTIP = "Печать" .
      500                                   v-h[ii] = hh:handle .
      501                                   ii = ii + 1 .
      502                                   hh:width-chars = 3 .
      503                               end.
      504                           when "b-history" or
      505                           when "b-hist" then
      506                               do:
      507                                   hh:load-image("cmp/b-hist.bmp":u) .
      508                                   hh:TOOLTIP = "История" .
      509                                   v-h[ii] = hh:handle .
      510                                   ii = ii + 1 .
      511                                   hh:width-chars = 3 .
      512                               end.
      513                           when "b-sch" then
      514                               do:
      515                                   hh:load-image("cmp/b-sch.bmp":u) .
      516                                   hh:TOOLTIP = "Установка Фильтра" .
      517                                   v-h[ii] = hh:handle .
      518                                   ii = ii + 1 .
      519                                   hh:width-chars = 3 .
      520                               end.
      521                           when "b-hist-user" then
      522                               do:
      523                                   hh:load-image("cmp/b-hist.bmp":u) .
      524                                   hh:TOOLTIP = "История пользователя" .
      525                                   ii = ii + 1 .
      526                               end.
      527                       end case.
      528                   end.
      529                   hh = hh:next-sibling.
      530               end.
      531               b-help:column = v-frame-width - b-help:width-chars.
      532               jj = 0.
      533               repeat ii = 4 to 1 by -1 :
      534                   if valid-handle (v-h[ii] ) then
      535                   do:
      536                       jj  = jj + 1 .
      537                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      538                       v-h[ii]:row    = v-help-old-y .
      539                   end.
      540               end.
      541           end.
      542       end.
      543   end procedure.
      544   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      545   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      546   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      547   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      548   define variable v-diasize-current-frame-width  as decimal   no-undo .
      549   define variable v-diasize-current-frame-height as decimal   no-undo .
      550   define variable v-diasize-change-size          as logical   no-undo .
      551   define variable v-diasize-resize-button        as handle    no-undo .
      552   define variable v-diasize-wndmax               as logical   no-undo .
      553   define variable v-diasize-wndstore             as logical   no-undo .
      554   define variable v-diasize-proc-name            as character no-undo .
      555   define variable v-diasize-browse-handle        as handle    no-undo .
      556   define variable v-diasize-browse-number        as integer   no-undo .
      557   define variable v-diasize-need-full-display    as logical   no-undo init false .
      558   define temp-table temp-diasize-handle no-undo
      559     field handle-value  as handle
      560     field save-position as decimal
      561     index xpk is primary unique handle-value
      562     .
      563   define temp-table temp-browse-handle no-undo
      564     field browse-type   as character
      565     field browse-number as integer
      566     field browse-handle as handle
      567     field original-size as decimal
      568     index xpk is primary unique browse-type browse-number
      569     index xie browse-type browse-handle
      570   .
      571   procedure diasize_change-height :
      572     define input  parameter p-change-value  as decimal   no-undo .
      573     define input  parameter p-move-resize   as logical   no-undo .
      574     define variable v-field-group-handle    as handle    no-undo .
      575     define variable v-object-handle         as handle    no-undo .
      576     define variable v-frame-height          as decimal   no-undo .
      577     define variable v-frame-virtual-height  as decimal   no-undo .
      578     define variable v-browse-height         as decimal   no-undo .
      579     define variable v-window-height         as decimal   no-undo .
      580     define variable v-window-virtual-height as decimal   no-undo .
      581     define variable v-change-sign           as integer   no-undo .
      582     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      583     define buffer buf_temp-browse-handle  for temp-browse-handle .
      584     if p-change-value > 0
      585     then do:
      586       if frame Dialog-Frame :height + p-change-value
      587           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      588       then do:
      589         assign
      590           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      591                           - (frame Dialog-Frame :height-chars)
      592         .
      593         if p-change-value <= 0
      594         then do:
      595           run diasize_position-resize-button in this-procedure .
      596           return .
      597         end.
      598       end.
      599     end.
      600     if p-change-value < 0
      601     then do:
      602       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      603       then do:
      604         assign
      605           p-change-value = v-diasize-orig-frame-height
      606                          - (frame Dialog-Frame :height-chars)
      607         .
      608         if p-change-value >= 0
      609         then do:
      610           run diasize_position-resize-button in this-procedure .
      611           return .
      612         end.
      613       end.
      614     end.
      615     if p-change-value >= 0
      616     then do:
      617       assign
      618         v-change-sign = 1
      619       .
      620     end.
      621     else do:
      622       assign
      623         v-change-sign = -1
      624       .
      625     end.
      626     assign
      627       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      628     .
      629     if p-change-value = 0
      630     then do:
      631       run diasize_position-resize-button in this-procedure .
      632       return .
      633     end.
      634     move_block:
      635     do
      636     on error undo move_block, retry move_block
      637     :
      638       if retry
      639       then do:
      640         do
      641         on error undo move_block, leave move_block
      642         :
      643           if p-change-value > 0
      644           then do:
      645             for each buf_temp-diasize-handle
      646             on error undo, next
      647             :
      648               assign
      649                 v-object-handle = buf_temp-diasize-handle.handle-value
      650               .
      651               if v-object-handle <> v-diasize-resize-button
      652               then do:
      653                 assign
      654                   v-object-handle :row = buf_temp-diasize-handle.save-position
      655                 .
      656               end.
      657             end.
      658             assign
      659               v-diasize-browse-handle :height = v-browse-height
      660             .
      661             for each buf_temp-browse-handle
      662               where buf_temp-browse-handle.browse-type = 'height':u
      663             on error undo, next
      664             :
      665               assign
      666                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      667               .
      668             end.
      669             assign
      670               frame Dialog-Frame :height = v-frame-height
      671             .
      672             if frame Dialog-Frame :scrollable = true
      673             then do:
      674               assign
      675                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      676               .
      677             end.
      678             run diasize_position-resize-button in this-procedure .
      679           end.
      680           else do:
      681             if frame Dialog-Frame :scrollable = true
      682             then do:
      683               assign
      684                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      685               .
      686             end.
      687             assign
      688               frame Dialog-Frame :height = v-frame-height
      689             .
      690             assign
      691               v-diasize-browse-handle :height = v-browse-height
      692             .
      693             for each buf_temp-browse-handle
      694               where buf_temp-browse-handle.browse-type = 'height':u
      695             on error undo, next
      696             :
      697               assign
      698                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      699               .
      700             end.
      701             for each buf_temp-diasize-handle
      702             on error undo, next
      703             :
      704               assign
      705                 v-object-handle = buf_temp-diasize-handle.handle-value
      706               .
      707               if v-object-handle <> v-diasize-resize-button
      708               then do:
      709                 assign
      710                   v-object-handle :row = buf_temp-diasize-handle.save-position
      711                 .
      712               end.
      713             end.
      714             run diasize_position-resize-button in this-procedure .
      715           end.
      716           assign
      717             v-diasize-change-size = false
      718           .
      719           leave move_block .
      720         end.
      721       end.
      722       assign
      723         v-diasize-need-full-display = true
      724       .
      725       if v-diasize-change-size = false
      726       then do:
      727         assign
      728           v-diasize-change-size = true
      729         .
      730       end.
      731       else do:
      732         return .
      733       end.
      734       assign
      735         v-frame-height = frame Dialog-Frame :height
      736         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      737         v-browse-height = v-diasize-browse-handle :height
      738       .
      739       for each buf_temp-browse-handle
      740         where buf_temp-browse-handle.browse-type = 'height':u
      741       :
      742         assign
      743           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      744         .
      745       end.
      746       for each buf_temp-diasize-handle
      747       :
      748         delete buf_temp-diasize-handle .
      749       end.
      750       assign
      751         v-field-group-handle = frame Dialog-Frame :first-child
      752       .
      753       do while valid-handle(v-field-group-handle)
      754       :
      755         assign
      756           v-object-handle = v-field-group-handle :first-child
      757         .
      758         do while valid-handle(v-object-handle)
      759         :
      760           if  v-object-handle <> v-diasize-browse-handle :handle
      761           and can-query(v-object-handle, "row")
      762           and can-query(v-object-handle, "height")
      763           and ( v-object-handle :row > v-diasize-browse-handle :row )
      764           then do:
      765             find first buf_temp-browse-handle
      766               where buf_temp-browse-handle.browse-type   = 'height':u
      767                 and buf_temp-browse-handle.browse-handle = v-object-handle
      768               no-error .
      769             if available buf_temp-browse-handle
      770             then do:
      771             end.
      772             else do:
      773               create buf_temp-diasize-handle .
      774               assign
      775                 buf_temp-diasize-handle.handle-value  = v-object-handle
      776                 buf_temp-diasize-handle.save-position = v-object-handle :row
      777               .
      778             end.
      779           end.
      780           assign
      781             v-object-handle = v-object-handle :next-sibling
      782           .
      783         end.
      784         assign
      785           v-field-group-handle = v-field-group-handle :next-sibling
      786         .
      787       end.
      788       do with frame Dialog-Frame
      789       :
      790         hide v-diasize-resize-button .
      791         assign
      792           v-diasize-resize-button :row    = 1
      793           v-diasize-resize-button :column = 1
      794         .
      795       end.
      796       if p-change-value > 0
      797       then do:
      798         if frame Dialog-Frame :scrollable = true
      799         then do:
      800           assign
      801             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      802             no-error .
      803           if error-status :error
      804           or error-status :get-message(1) <> ""
      805           then do:
      806             undo move_block, retry move_block .
      807           end.
      808         end.
      809         assign
      810           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      811           no-error .
      812         if error-status :error
      813         or error-status :get-message(1) <> ""
      814         then do:
      815           undo move_block, retry move_block .
      816         end.
      817         assign
      818           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      819           no-error .
      820         if error-status :error
      821         or error-status :get-message(1) <> ""
      822         then do:
      823           undo move_block, retry move_block .
      824         end.
      825         for each buf_temp-browse-handle
      826           where buf_temp-browse-handle.browse-type = 'height':u
      827         on error undo move_block, retry move_block
      828         :
      829           assign
      830             buf_temp-browse-handle.browse-handle :height
      831               = buf_temp-browse-handle.browse-handle :height + p-change-value
      832             no-error .
      833           if error-status :error
      834           or error-status :get-message(1) <> ""
      835           then do:
      836             undo move_block, retry move_block .
      837           end.
      838         end.
      839         for each buf_temp-diasize-handle
      840         on error undo move_block, retry move_block
      841         :
      842           assign
      843             v-object-handle = buf_temp-diasize-handle.handle-value
      844           .
      845           if v-object-handle <> v-diasize-resize-button
      846           then do:
      847             assign
      848               v-object-handle :row = v-object-handle :row + p-change-value
      849               no-error .
      850             if error-status :error
      851             or error-status :get-message(1) <> ""
      852             then do:
      853               undo move_block, retry move_block .
      854             end.
      855           end.
      856         end.
      857       end.
      858       else do:
      859         for each buf_temp-diasize-handle
      860         on error undo move_block, retry move_block
      861         :
      862           assign
      863             v-object-handle = buf_temp-diasize-handle.handle-value
      864           .
      865           if v-object-handle <> v-diasize-resize-button
      866           then do:
      867             assign
      868               v-object-handle :row = v-object-handle :row + p-change-value
      869               no-error .
      870             if error-status :error
      871             or error-status :get-message(1) <> ""
      872             then do:
      873               undo move_block, retry move_block .
      874             end.
      875           end.
      876         end.
      877         assign
      878           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      879           no-error .
      880         if error-status :error
      881         or error-status :get-message(1) <> ""
      882         then do:
      883           undo move_block, retry move_block .
      884         end.
      885         for each buf_temp-browse-handle
      886           where buf_temp-browse-handle.browse-type = 'height':u
      887         on error undo move_block, retry move_block
      888         :
      889           assign
      890             buf_temp-browse-handle.browse-handle :height
      891               = buf_temp-browse-handle.browse-handle :height + p-change-value
      892             no-error .
      893           if error-status :error
      894           or error-status :get-message(1) <> ""
      895           then do:
      896             undo move_block, retry move_block .
      897           end.
      898         end.
      899         assign
      900           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      901           no-error .
      902         if error-status :error
      903         or error-status :get-message(1) <> ""
      904         then do:
      905           undo move_block, retry move_block .
      906         end.
      907         if frame Dialog-Frame :scrollable = true
      908         then do:
      909           assign
      910             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      911             no-error .
      912           if error-status :error
      913           or error-status :get-message(1) <> ""
      914           then do:
      915             undo move_block, retry move_block .
      916           end.
      917         end.
      918       end.
      919       if p-move-resize = true
      920       then do:
      921         run diasize_position-resize-button in this-procedure .
      922       end.
      923       if v-diasize-wndstore = true
      924       then do:
      925         if connected("ub") = true
      926         then do:
      927           define variable v-cntxt-db-num        as integer   no-undo .
      928           define variable v-cntxt-userid        as character no-undo .
      929           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      930                                             , OUTPUT v-cntxt-userid
      931                                             ) .
      932           run gbl/wndsizew.p
      933             (input  v-cntxt-db-num
      934             ,input  v-cntxt-userid
      935             ,input  v-diasize-proc-name
      936             ,input  'height':u
      937             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      938             ) .
      939         end.
      940       end.
      941     end.
      942     assign
      943       v-diasize-change-size = false
      944     .
      945   end procedure.
      946   procedure diasize_set-height :
      947     define input  parameter p-new-height  as decimal   no-undo .
      948     define input  parameter p-move-resize as logical   no-undo .
      949     do
      950     on error undo, return error return-value
      951     :
      952       run diasize_change-height in this-procedure
      953         (input  (p-new-height - frame Dialog-Frame :height)
      954         ,input  p-move-resize
      955         ) .
      956     end.
      957   end procedure.
      958   procedure diasize_change-width :
      959     define input  parameter p-change-value as decimal   no-undo .
      960     define input  parameter p-move-resize  as logical   no-undo .
      961     define variable v-field-group-handle   as handle    no-undo .
      962     define variable v-object-handle        as handle    no-undo .
      963     define variable v-frame-width          as decimal   no-undo .
      964     define variable v-frame-virtual-width  as decimal   no-undo .
      965     define variable v-browse-width         as decimal   no-undo .
      966     define variable v-window-width         as decimal   no-undo .
      967     define variable v-window-virtual-width as decimal   no-undo .
      968     define variable v-change-sign          as integer   no-undo .
      969     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      970     define buffer buf_temp-browse-handle  for temp-browse-handle .
      971     if p-change-value > 0
      972     then do:
      973       if frame Dialog-Frame :width + p-change-value >
      974           session :width-chars
      975       then do:
      976         assign
      977           p-change-value = session :width-chars - frame Dialog-Frame :width
      978         .
      979         if p-change-value <= 0
      980         then do:
      981           run diasize_position-resize-button in this-procedure .
      982           return .
      983         end.
      984       end.
      985     end.
      986     if p-change-value < 0
      987     then do:
      988       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      989       then do:
      990         assign
      991           p-change-value = v-diasize-orig-frame-width
      992                          - frame Dialog-Frame :width
      993         .
      994         if p-change-value >= 0
      995         then do:
      996           run diasize_position-resize-button in this-procedure .
      997           return .
      998         end.
      999       end.
     1000     end.
     1001     if p-change-value >= 0
     1002     then do:
     1003       assign
     1004         v-change-sign = 1
     1005       .
     1006     end.
     1007     else do:
     1008       assign
     1009         v-change-sign = -1
     1010       .
     1011     end.
     1012     assign
     1013       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1014     .
     1015     if p-change-value = 0
     1016     then do:
     1017       run diasize_position-resize-button in this-procedure .
     1018       return .
     1019     end.
     1020     move_block:
     1021     do
     1022     on error undo move_block, leave move_block
     1023     :
     1024       if retry
     1025       then do:
     1026         do
     1027         on error undo move_block, leave move_block
     1028         :
     1029           if p-change-value > 0
     1030           then do:
     1031             for each buf_temp-diasize-handle
     1032             on error undo, next
     1033             :
     1034               assign
     1035                 v-object-handle = buf_temp-diasize-handle.handle-value
     1036               .
     1037               if v-object-handle <> v-diasize-resize-button
     1038               then do:
     1039                 assign
     1040                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1041                 .
     1042               end.
     1043             end.
     1044             assign
     1045               v-diasize-browse-handle :width = v-browse-width
     1046             .
     1047             for each buf_temp-browse-handle
     1048               where buf_temp-browse-handle.browse-type = 'width':u
     1049             on error undo, next
     1050             :
     1051               assign
     1052                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1053               .
     1054             end.
     1055             assign
     1056               frame Dialog-Frame :width = v-frame-width
     1057             .
     1058             if frame Dialog-Frame :scrollable = true
     1059             then do:
     1060               assign
     1061                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1062               .
     1063             end.
     1064             run diasize_position-resize-button in this-procedure .
     1065           end.
     1066           else do:
     1067             if frame Dialog-Frame :scrollable = true
     1068             then do:
     1069               assign
     1070                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1071               .
     1072             end.
     1073             assign
     1074               frame Dialog-Frame :width = v-frame-width
     1075             .
     1076             for each buf_temp-browse-handle
     1077               where buf_temp-browse-handle.browse-type = 'width':u
     1078             on error undo, next
     1079             :
     1080               assign
     1081                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1082               .
     1083             end.
     1084             assign
     1085               v-diasize-browse-handle :width = v-browse-width
     1086             .
     1087             for each buf_temp-diasize-handle
     1088             on error undo, next
     1089             :
     1090               assign
     1091                 v-object-handle = buf_temp-diasize-handle.handle-value
     1092               .
     1093               if v-object-handle <> v-diasize-resize-button
     1094               then do:
     1095                 assign
     1096                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1097                 .
     1098               end.
     1099             end.
     1100             run diasize_position-resize-button in this-procedure .
     1101           end.
     1102           assign
     1103             v-diasize-change-size = false
     1104           .
     1105           leave move_block .
     1106         end.
     1107       end.
     1108       assign
     1109         v-diasize-need-full-display = true
     1110       .
     1111       if v-diasize-change-size = false
     1112       then do:
     1113         assign
     1114           v-diasize-change-size = true
     1115         .
     1116       end.
     1117       else do:
     1118         return .
     1119       end.
     1120       assign
     1121         v-frame-width = frame Dialog-Frame :width
     1122         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1123         v-browse-width = v-diasize-browse-handle :width
     1124       .
     1125       for each buf_temp-browse-handle
     1126         where buf_temp-browse-handle.browse-type = 'width':u
     1127       :
     1128         assign
     1129           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1130         .
     1131       end.
     1132       for each buf_temp-diasize-handle
     1133       :
     1134         delete buf_temp-diasize-handle .
     1135       end.
     1136       assign
     1137         v-field-group-handle = frame Dialog-Frame :first-child
     1138       .
     1139       do while valid-handle(v-field-group-handle)
     1140       :
     1141         assign
     1142           v-object-handle = v-field-group-handle :first-child
     1143         .
     1144         do while valid-handle(v-object-handle)
     1145         :
     1146           if  v-object-handle <> v-diasize-browse-handle :handle
     1147           and v-object-handle <> v-diasize-resize-button
     1148           and can-query(v-object-handle, "row")
     1149           and can-query(v-object-handle, "height")
     1150           and ( v-object-handle :col + v-object-handle :width
     1151                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1152               )
     1153           then do:
     1154             find first buf_temp-browse-handle
     1155               where buf_temp-browse-handle.browse-type   = 'width':u
     1156                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1157               no-error .
     1158             if available buf_temp-browse-handle
     1159             then do:
     1160             end.
     1161             else do:
     1162               create buf_temp-diasize-handle .
     1163               assign
     1164                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1165                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1166               .
     1167             end.
     1168           end.
     1169           assign
     1170             v-object-handle = v-object-handle :next-sibling
     1171           .
     1172         end.
     1173         assign
     1174           v-field-group-handle = v-field-group-handle :next-sibling
     1175         .
     1176       end.
     1177       do with frame Dialog-Frame
     1178       :
     1179         hide v-diasize-resize-button .
     1180         v-diasize-resize-button :row = 1.
     1181         v-diasize-resize-button :column = 1.
     1182       end.
     1183       if p-change-value > 0
     1184       then do:
     1185         if frame Dialog-Frame :scrollable = true
     1186         then do:
     1187           assign
     1188             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1189             no-error .
     1190           if error-status :error
     1191           or error-status :get-message(1) <> ""
     1192           then do:
     1193             undo move_block, retry move_block.
     1194           end.
     1195         end.
     1196         assign
     1197           frame Dialog-Frame :width = v-frame-width + p-change-value
     1198           no-error .
     1199         if error-status :error
     1200         or error-status :get-message(1) <> ""
     1201         then do:
     1202           undo move_block, retry move_block.
     1203         end.
     1204         assign
     1205           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1206         no-error .
     1207         if error-status :error
     1208         or error-status :get-message(1) <> ""
     1209         then do:
     1210           undo move_block, retry move_block.
     1211         end.
     1212         for each buf_temp-browse-handle
     1213           where buf_temp-browse-handle.browse-type = 'width':u
     1214         on error undo move_block, retry move_block
     1215         :
     1216           assign
     1217             buf_temp-browse-handle.browse-handle :width
     1218               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1219             no-error .
     1220           if error-status :error
     1221           or error-status :get-message(1) <> ""
     1222           then do:
     1223             undo move_block, retry move_block .
     1224           end.
     1225         end.
     1226         for each buf_temp-diasize-handle
     1227         on error undo move_block, retry move_block
     1228         :
     1229           assign
     1230             v-object-handle = buf_temp-diasize-handle.handle-value
     1231           .
     1232           if v-object-handle <> v-diasize-resize-button
     1233           then do:
     1234             assign
     1235               v-object-handle :col = v-object-handle :col + p-change-value
     1236               no-error .
     1237             if error-status :error
     1238             or error-status :get-message(1) <> ""
     1239             then do:
     1240               undo move_block, retry move_block .
     1241             end.
     1242           end.
     1243         end.
     1244       end.
     1245       else do:
     1246         for each buf_temp-diasize-handle
     1247         on error undo move_block, retry move_block
     1248         :
     1249           assign
     1250             v-object-handle = buf_temp-diasize-handle.handle-value
     1251           .
     1252           if v-object-handle <> v-diasize-resize-button
     1253           then do:
     1254             assign
     1255               v-object-handle :col = v-object-handle :col + p-change-value
     1256               no-error .
     1257             if error-status :error
     1258             or error-status :get-message(1) <> ""
     1259             then do:
     1260               undo move_block, retry move_block .
     1261             end.
     1262           end.
     1263         end.
     1264         for each buf_temp-browse-handle
     1265           where buf_temp-browse-handle.browse-type = 'width':u
     1266         on error undo move_block, retry move_block
     1267         :
     1268           assign
     1269             buf_temp-browse-handle.browse-handle :width
     1270               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1271             no-error .
     1272           if error-status :error
     1273           or error-status :get-message(1) <> ""
     1274           then do:
     1275             undo move_block, retry move_block .
     1276           end.
     1277         end.
     1278         assign
     1279           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1280           no-error .
     1281         if error-status :error
     1282         or error-status :get-message(1) <> ""
     1283         then do:
     1284           undo move_block, retry move_block.
     1285         end.
     1286         assign
     1287           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1288         no-error .
     1289         if error-status :error
     1290         or error-status :get-message(1) <> ""
     1291         then do:
     1292           undo move_block, retry move_block.
     1293         end.
     1294         if frame Dialog-Frame :scrollable = true
     1295         then do:
     1296           assign
     1297             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1298           no-error .
     1299           if error-status :error
     1300           or error-status :get-message(1) <> ""
     1301           then do:
     1302             undo move_block, retry move_block.
     1303           end.
     1304         end.
     1305       end.
     1306       if p-move-resize
     1307       then do:
     1308         run diasize_position-resize-button in this-procedure .
     1309       end.
     1310       if v-diasize-wndstore = true
     1311       then do:
     1312         if connected("ub") = true
     1313         then do:
     1314           define variable v-cntxt-db-num        as integer   no-undo .
     1315           define variable v-cntxt-userid        as character no-undo .
     1316           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1317                                             , OUTPUT v-cntxt-userid
     1318                                             ) .
     1319           run gbl/wndsizew.p
     1320             (input  v-cntxt-db-num
     1321             ,input  v-cntxt-userid
     1322             ,input  v-diasize-proc-name
     1323             ,input  'width':u
     1324             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1325             ) .
     1326         end.
     1327       end.
     1328     end.
     1329     assign
     1330       v-diasize-change-size = false
     1331     .
     1332   end procedure.
     1333   procedure diasize_set-width :
     1334     define input  parameter p-new-width  as decimal   no-undo .
     1335     define input  parameter p-move-resize as logical   no-undo .
     1336     do
     1337     on error undo, return error return-value
     1338     :
     1339       run diasize_change-width in this-procedure
     1340         (input  (p-new-width - frame Dialog-Frame :width)
     1341         ,input  p-move-resize
     1342         ) .
     1343     end.
     1344   end procedure.
     1345   procedure diasize_position-resize-button :
     1346     do with frame Dialog-Frame
     1347     :
     1348       hide v-diasize-resize-button .
     1349       assign
     1350         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1351                     - 1
     1352                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1353         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1354                     - 1
     1355                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1356       .
     1357       view v-diasize-resize-button .
     1358     end.
     1359   end procedure.
     1360   on alt-right anywhere
     1361   do:
     1362     run diasize_change-width in this-procedure
     1363       (input 1
     1364       ,input true
     1365       ) .
     1366     return no-apply .
     1367   end.
     1368   on alt-left anywhere
     1369   do:
     1370     run diasize_change-width in this-procedure
     1371       (input -1
     1372       ,input true
     1373       ) .
     1374     return no-apply .
     1375   end.
     1376   on alt-down anywhere
     1377   do:
     1378     run diasize_change-height in this-procedure
     1379       (input 1
     1380       ,input true
     1381       ) .
     1382     return no-apply .
     1383   end.
     1384   on alt-up anywhere
     1385   do:
     1386     run diasize_change-height in this-procedure
     1387       (input -1
     1388       ,input true
     1389       ) .
     1390     return no-apply .
     1391   end.
     1392   on alt-enter of frame Dialog-Frame
     1393   do:
     1394     run diasize_maximize in this-procedure
     1395       (input  ?
     1396       ).
     1397     return no-apply .
     1398   end.
     1399   procedure diasize_end-move :
     1400     do
     1401     on error undo, return error return-value
     1402     :
     1403       define variable v-row-delta as decimal   no-undo .
     1404       define variable v-col-delta as decimal   no-undo .
     1405       define variable v-new-row as decimal   no-undo .
     1406       define variable v-new-col as decimal   no-undo .
     1407       assign
     1408         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1409         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1410       .
     1411       assign
     1412         v-row-delta = v-new-row - frame Dialog-Frame :height
     1413         v-col-delta = v-new-col - frame Dialog-Frame :width
     1414       .
     1415       run diasize_change-height in this-procedure
     1416         (input v-row-delta
     1417         ,input true
     1418         ) .
     1419       run diasize_change-width in this-procedure
     1420         (input v-col-delta
     1421         ,input true
     1422         ) .
     1423     end.
     1424   end procedure.
     1425   procedure diasize_maximize :
     1426     define input  parameter p-action as logical   no-undo .
     1427     do
     1428     on error undo, return error return-value
     1429     :
     1430       if p-action = ?
     1431       then do:
     1432         if v-diasize-need-maximize = true
     1433         then do:
     1434           assign
     1435             p-action = true
     1436           .
     1437         end.
     1438         else do:
     1439           assign
     1440             p-action = false
     1441           .
     1442         end.
     1443       end.
     1444       if p-action = true
     1445       then do:
     1446         run diasize_change-height in this-procedure
     1447           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1448               - frame Dialog-Frame :height-chars
     1449           ,input true
     1450           ) .
     1451         run diasize_change-width in this-procedure
     1452           (input session :width-chars
     1453               - frame Dialog-Frame :width-chars
     1454           ,input true
     1455           ) .
     1456         assign
     1457           v-diasize-need-maximize = false
     1458         .
     1459       end.
     1460       else do:
     1461         run diasize_change-width in this-procedure
     1462           (input v-diasize-orig-frame-width
     1463               - frame Dialog-Frame :width-chars
     1464           ,input true
     1465           ) .
     1466         run diasize_change-height in this-procedure
     1467           (input v-diasize-orig-frame-height
     1468               - frame Dialog-Frame :height-chars
     1469           ,input true
     1470           ) .
     1471         assign
     1472           v-diasize-need-maximize = true
     1473         .
     1474       end.
     1475     end.
     1476   end procedure.
     1477   procedure diasize_restore-orig-size :
     1478     do
     1479     on error undo, return error return-value
     1480     :
     1481       assign
     1482         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1483         v-diasize-current-frame-height = frame Dialog-Frame :height
     1484       .
     1485       run diasize_set-height in this-procedure
     1486         (input  v-diasize-orig-frame-height
     1487         ,input  true
     1488         ) .
     1489       run diasize_set-width in this-procedure
     1490         (input  v-diasize-orig-frame-width
     1491         ,input  true
     1492         ) .
     1493     end.
     1494   end procedure.
     1495   procedure diasize_restore-current-size :
     1496     do
     1497     on error undo, return error return-value
     1498     :
     1499       run diasize_set-height in this-procedure
     1500         (input  v-diasize-current-frame-height
     1501         ,input  true
     1502         ) .
     1503       run diasize_set-width in this-procedure
     1504         (input  v-diasize-current-frame-width
     1505         ,input  true
     1506         ) .
     1507     end.
     1508   end procedure.
     1509   procedure diasize_set-browse-handle :
     1510     define input  parameter p-browse-handle as handle   no-undo .
     1511     define buffer buf_temp-browse-handle for temp-browse-handle .
     1512     do
     1513     on error undo, return error return-value
     1514     :
     1515       assign
     1516         v-diasize-browse-handle = p-browse-handle
     1517       .
     1518       for each buf_temp-browse-handle
     1519       on error undo, return error return-value
     1520       :
     1521         delete buf_temp-browse-handle .
     1522       end.
     1523     end.
     1524   end procedure.
     1525   procedure diasize_add_browse :
     1526     define input  parameter p-browse-type   as character no-undo .
     1527     define input  parameter p-browse-handle as handle    no-undo .
     1528     define buffer buf_temp-browse-handle for temp-browse-handle .
     1529     do
     1530     on error undo, return error return-value
     1531     :
     1532       assign
     1533         v-diasize-browse-number = v-diasize-browse-number + 1
     1534       .
     1535       create buf_temp-browse-handle .
     1536       assign
     1537         buf_temp-browse-handle.browse-type   = p-browse-type
     1538         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1539         buf_temp-browse-handle.browse-handle = p-browse-handle
     1540       .
     1541     end.
     1542   end procedure.
     1543   procedure diasize_init :
     1544     define variable v-default-value    as logical   no-undo .
     1545     define variable v-restore-saved    as logical   no-undo .
     1546     define variable v-resize-value-str as character no-undo .
     1547     do
     1548     on error undo, return error return-value
     1549     :
     1550       do with frame Dialog-Frame
     1551       :
     1552         assign
     1553           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1554           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1555           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1556         .
     1557         create button v-diasize-resize-button
     1558         assign
     1559           parent        = frame Dialog-Frame :first-child
     1560           label         = "s"
     1561           height-pixels = 16
     1562           width-pixels  = 16
     1563           visible       = true
     1564           sensitive     = true
     1565           movable       = true
     1566           triggers:
     1567             on end-move persistent run diasize_end-move in this-procedure .
     1568           end triggers.
     1569         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1570         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1571         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1572         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1573         assign
     1574           v-diasize-wndmax = false
     1575         .
     1576         if connected("ub") = true
     1577         then do:
     1578           define variable v-cntxt-db-num        as integer   no-undo .
     1579           define variable v-cntxt-userid        as character no-undo .
     1580           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1581                                             , OUTPUT v-cntxt-userid
     1582                                             ) .
     1583           run gbl/wndpar_r.p
     1584             (input  v-cntxt-db-num
     1585             ,input  v-cntxt-userid
     1586             ,input  'wndmax':U
     1587             ,output v-diasize-wndmax
     1588             ,output v-default-value
     1589             ) .
     1590         end.
     1591         assign
     1592           v-diasize-wndstore = false
     1593         .
     1594         if connected("ub") = true
     1595         then do:
     1596           run gbl/wndpar_r.p
     1597             (input  v-cntxt-db-num
     1598             ,input  v-cntxt-userid
     1599             ,input  'wndstore':U
     1600             ,output v-diasize-wndstore
     1601             ,output v-default-value
     1602             ) .
     1603         end.
     1604         assign
     1605           v-diasize-proc-name = entry(1, program-name(2), '.')
     1606         .
     1607         if v-diasize-wndstore = true
     1608         then do:
     1609           assign
     1610             v-restore-saved = false
     1611           .
     1612           if connected("ub") = true
     1613           then do:
     1614             run gbl/wndsizer.p
     1615               (input  v-cntxt-db-num
     1616               ,input  v-cntxt-userid
     1617               ,input  v-diasize-proc-name
     1618               ,input  'height':u
     1619               ,output v-resize-value-str
     1620               ) .
     1621             if v-resize-value-str <> '':U
     1622             then do:
     1623               run diasize_change-height in this-procedure
     1624                 (input  integer(v-resize-value-str)
     1625                 ,input  true
     1626                 ) .
     1627               assign
     1628                 v-restore-saved = true
     1629               .
     1630             end.
     1631           end.
     1632           if connected("ub") = true
     1633           then do:
     1634             run gbl/wndsizer.p
     1635               (input  v-cntxt-db-num
     1636               ,input  v-cntxt-userid
     1637               ,input  v-diasize-proc-name
     1638               ,input  'width':u
     1639               ,output v-resize-value-str
     1640               ) .
     1641             if v-resize-value-str <> '':U
     1642             then do:
     1643               run diasize_change-width in this-procedure
     1644                 (input  integer(v-resize-value-str)
     1645                 ,input  true
     1646                 ) .
     1647               assign
     1648                 v-restore-saved = true
     1649               .
     1650             end.
     1651           end.
     1652           if v-restore-saved <> true
     1653           then do:
     1654             if v-diasize-wndmax = true
     1655             then do:
     1656               run diasize_maximize in this-procedure
     1657                 (input  true
     1658                 ) .
     1659             end.
     1660           end.
     1661         end.
     1662         else do:
     1663           if v-diasize-wndmax = true
     1664           then do:
     1665             run diasize_maximize in this-procedure
     1666               (input  true
     1667               ) .
     1668           end.
     1669         end.
     1670       end.
     1671     end.
     1672   end procedure.
     1673   procedure diasize_need-full-display :
     1674     define output parameter p-need-full-display as logical   no-undo .
     1675     do
     1676     on error undo, return error return-value
     1677     :
     1678       assign
     1679         p-need-full-display = v-diasize-need-full-display
     1680       .
     1681       assign
     1682         v-diasize-need-full-display = false
     1683       .
     1684     end.
     1685   end procedure.
     1686   procedure get-context :
     1687      define output parameter p-db-num as integer          no-undo.
     1688      define output parameter p-user-id as character        no-undo.
     1689      define variable v-login               as character    no-undo.
     1690      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1691      define buffer buf_user-login  for ub.user-login .
     1692      do
     1693      on error undo, return error
     1694      :
     1695            FIND FIRST buf_sys-ctrl no-lock.
     1696            ASSIGN
     1697               v-login = USERID("ub")
     1698               p-db-num = buf_sys-ctrl.db-num
     1699            .
     1700            FIND FIRST buf_user-login
     1701                 WHERE buf_user-login.db-num = p-db-num
     1702                   AND buf_user-login.user-login = v-login
     1703                 no-lock
     1704                 no-error
     1705                 .
     1706            IF AVAILABLE buf_user-login
     1707            THEN DO:
     1708               assign
     1709                  p-user-id = buf_user-login.user-id
     1710               .
     1711            END.
     1712      end.
     1713   end procedure.
     1714       run diasize_init in this-procedure .
     1715   assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name.
     1716    ASSIGN b-list:POPUP-MENU IN FRAME Dialog-Frame   = MENU POPUP-MENU-b-list:HANDLE.
     1717    ASSIGN b-list:MENU-MOUSE   = 1.
     1718   def var sort-labelBROWSE-2   as character no-undo .
     1719   def var sort-clmnBROWSE-2    as handle    no-undo .
     1720   def var cur-clmnBROWSE-2     as handle    no-undo .
     1721   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     1722   def var re-queryBROWSE-2     as logical   initial no no-undo .
     1723   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     1724      run sort-brBROWSE-2
     1725        (input (if available ub.tmp-sale-gds
     1726                then recid(ub.tmp-sale-gds)
     1727                else ?
     1728               )
     1729        ).
     1730   end.
     1731   PROCEDURE sort-brBROWSE-2 :
     1732     define input parameter p-recid as recid no-undo .
     1733     if re-queryBROWSE-2 = no then do:
     1734       assign
     1735          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     1736       .
     1737       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     1738       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     1739         assign
     1740            sort-labelBROWSE-2 = ""
     1741            sort-clmnBROWSE-2 = ?
     1742         .
     1743        end.
     1744        else do:
     1745          assign
     1746            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     1747            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     1748            sort-clmnBROWSE-2:column-fgcolor = 4
     1749          .
     1750        end.
     1751      end.
     1752     assign
     1753       cur-clmn-locBROWSE-2 = 1
     1754     .
     1755     def var column-handle as handle no-undo .
     1756     column-handle = BROWSE-2:first-column.
     1757     do while valid-handle(column-handle) :
     1758       if column-handle = cur-clmnBROWSE-2 then do:
     1759         leave .
     1760       end.
     1761       column-handle = column-handle:NEXT-COLUMN.
     1762       assign
     1763         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     1764       .
     1765     end.
     1766     case sort-labelBROWSE-2:
     1767           when ub.goods.artic:label in browse BROWSE-2 then DO:   assign     sort-column-name = "ub.goods.artic"   .   run OpenBr.   . END.
     1768           when ub.goods.gds-name:label in browse BROWSE-2 then DO:   assign     sort-column-name = "ub.goods.gds-name"   .   run OpenBr.   . END.
     1769           when ub.goods.unit-base:label in browse BROWSE-2 then DO:   assign     sort-column-name = "ub.goods.unit-base"   .   run OpenBr.   . END.
     1770           when ub.tmp-sale-gds.tmp-value:label in browse BROWSE-2 then DO:   assign     sort-column-name = "ub.tmp-sale-gds.tmp-value"   .   run OpenBr.   . END.
     1771       otherwise do:
     1772         assign
     1773           sort-column-name = ""
     1774         .
     1775         run OpenBr.
     1776         if sort-labelBROWSE-2 <> "" then do:
     1777           assign
     1778             cur-clmnBROWSE-2:column-fgcolor = 0
     1779           .
     1780         end.
     1781         assign
     1782           cur-clmn-locBROWSE-2 = ?
     1783         .
     1784       end.
     1785     end case.
     1786     if p-recid <> ? then do:
     1787       reposition BROWSE-2 to recid p-recid no-error.
     1788       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     1789     end.
     1790     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     1791   END PROCEDURE.
     1792   procedure re-open-query-srt-clmnBROWSE-2:
     1793   if cur-clmnBROWSE-2 = ? then do:
     1794      run OpenBr.
     1795   end.
     1796   else do:
     1797      assign re-queryBROWSE-2 = yes.
     1798      run sort-brBROWSE-2
     1799        (input (if available ub.tmp-sale-gds
     1800                then recid(ub.tmp-sale-gds)
     1801                else ?
     1802               )
     1803        ).
     1804      assign re-queryBROWSE-2 = no.
     1805   end.
     1806   end.
     1807   MAIN-BLOCK:
     1808   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1809      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1810     run enable_UI in this-procedure .
     1811     enable  s-artic with frame Dialog-Frame.
     1812     Hide      s-name  s-name-cnt in frame Dialog-Frame.
     1813     display s-artic with frame Dialog-Frame.
     1814     WAIT-FOR GO OF FRAME Dialog-Frame.
     1815   END.
     1816   run disable_UI in this-procedure .
     1817   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1818   on F9 of frame Dialog-Frame anywhere do:
     1819     if not available ub.goods then
     1820       return no-apply.
     1821     gds-rec = recid (ub.goods).
     1822     run ref/gds-form.w ( input parParentProc
     1823                         ,input 'ПРОСМОТР':U
     1824                         ,input ?
     1825                         ,input ?
     1826                         ,input ?
     1827                         ,input-output gds-rec).
     1828     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     1829     return no-apply.
     1830   end.
     1831   PROCEDURE cycle-add :
     1832   define variable lns-cnt as integer   no-undo .
     1833   define variable stp-cycl as logical no-undo .
     1834   stp-cycl = false .
     1835   for each tt-gds-list no-lock  by tt-gds-list.nn :
     1836     lns-cnt  =  lns-cnt + 1 .
     1837     if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     1838           if not can-find (first ub.tmp-sale-gds where
     1839                   ub.tmp-sale-gds.artic     = tt-gds-list.artic and
     1840                   ub.tmp-sale-gds.prod-type = tt-gds-list.prod-type and
     1841                   ub.tmp-sale-gds.prod-code = tt-gds-list.prod-code and
     1842                   ub.tmp-sale-gds.tmp-code = t-code no-lock ) then do:
     1843               create ub.tmp-sale-gds.
     1844               assign
     1845                   ub.tmp-sale-gds.artic     = tt-gds-list.artic
     1846                   ub.tmp-sale-gds.prod-type = tt-gds-list.prod-type
     1847                   ub.tmp-sale-gds.prod-code = tt-gds-list.prod-code
     1848                   ub.tmp-sale-gds.tmp-code  = t-code
     1849                   ub.tmp-sale-gds.tmp-value = 0
     1850               .
     1851           end.
     1852     if  stp-cycl = true then leave.
     1853     end.
     1854     ASSIGN lns-cnt = lns-cnt + 1 .
     1855   end procedure.
     1856   PROCEDURE disable_UI :
     1857     HIDE FRAME Dialog-Frame.
     1858   END PROCEDURE.
     1859   PROCEDURE enable_UI :
     1860     DISPLAY R-sort s-name-cnt s-name s-artic FILL-IN-2 mark-num
     1861         WITH FRAME Dialog-Frame.
     1862     ENABLE b-exit b-add b-list b-help R-sort s-artic BROWSE-2 FILL-IN-2 mark-num
     1863         WITH FRAME Dialog-Frame.
     1864     VIEW FRAME Dialog-Frame.
     1865     OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     .
     1866   END PROCEDURE.
     1867   PROCEDURE openBr :
     1868   define variable t-ret as logical no-undo .
     1869   t-ret =  session:SET-WAIT-STATE("GENERAL") .
     1870   case sort-column-name :
     1871     when "" then do:
     1872           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods where       ub.goods.artic = ub.tmp-sale-gds.artic and       ub.goods.prod-type = ub.tmp-sale-gds.prod-type and       ub.goods.prod-code = ub.tmp-sale-gds.prod-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK .     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name.    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     .    end.
     1873     end.
     1874     when "goods.artic" then do:
     1875           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods where       ub.goods.artic = ub.tmp-sale-gds.artic and       ub.goods.prod-type = ub.tmp-sale-gds.prod-type and       ub.goods.prod-code = ub.tmp-sale-gds.prod-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK by ub.goods.artic.     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name.    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     by ub.goods.artic.    end.
     1876     end.
     1877     when "goods.gds-name" then do:
     1878           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods where       ub.goods.artic = ub.tmp-sale-gds.artic and       ub.goods.prod-type = ub.tmp-sale-gds.prod-type and       ub.goods.prod-code = ub.tmp-sale-gds.prod-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK by ub.goods.gds-name.     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name.    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     by ub.goods.gds-name.    end.
     1879     end.
     1880     when "goods.unit-base" then do:
     1881           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods where       ub.goods.artic = ub.tmp-sale-gds.artic and       ub.goods.prod-type = ub.tmp-sale-gds.prod-type and       ub.goods.prod-code = ub.tmp-sale-gds.prod-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK by ub.goods.unit-base.     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name.    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     by ub.goods.unit-base.    end.
     1882     end.
     1883     when "tmp-sale-gds.tmp-value" then do:
     1884           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods where       ub.goods.artic = ub.tmp-sale-gds.artic and       ub.goods.prod-type = ub.tmp-sale-gds.prod-type and       ub.goods.prod-code = ub.tmp-sale-gds.prod-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK by ub.tmp-sale-gds.tmp-value.     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name.    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     by ub.tmp-sale-gds.tmp-value.    end.
     1885     end.
     1886     otherwise do:
     1887           if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods where       ub.goods.artic = ub.tmp-sale-gds.artic and       ub.goods.prod-type = ub.tmp-sale-gds.prod-type and       ub.goods.prod-code = ub.tmp-sale-gds.prod-code and       INDEX(ub.goods.gds-name,s-name-cnt) > 0       NO-LOCK .     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Темп продаж- " + t-name.    OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     .    end.
     1888     end.
     1889   end case.
     1890   t-ret =  session:SET-WAIT-STATE("") .
     1891   apply "HOME" to BROWSE-2 in frame Dialog-Frame.
     1892   END PROCEDURE.
     1893   PROCEDURE proc-b-list :
     1894   do
     1895    on error undo, return error return-value
     1896    :
     1897   define variable v-tmp-code like ub.tmp-sale-gds.tmp-code no-undo.
     1898   define input parameter loc-list-option as character no-undo.
     1899   define variable jj as integer no-undo.
     1900   define variable varrid-tmp-sale-gds as recid no-undo.
     1901   define buffer loc-tmp-sale-gds for ub.tmp-sale-gds.
     1902   define variable f-name as char init "default.cli" no-undo.
     1903   define variable imp-type like ub.goods.prod-type no-undo.
     1904   define variable imp-code like ub.goods.prod-code no-undo.
     1905   define variable       loc-gds-code  like ub.goods.gds-code no-undo.
     1906   define variable       loc-min-stock like ub.tmp-sale-gds.tmp-value no-undo.
     1907   define variable       loc-tmp-code  like ub.tmp-sale-gds.tmp-code no-undo.
     1908   v-tmp-code =  t-code .
     1909   case loc-list-option:
     1910     when "save":U then do:
     1911       v-log = yes.
     1912       message "Сохранить все товары в файле списка"
     1913       view-as alert-box question buttons OK-Cancel update v-log.
     1914       if not v-log then do:
     1915         list-option = "":U.
     1916         return.
     1917       end.
     1918       assign
     1919       f-name = "default.tmg"
     1920       v-log = yes
     1921       .
     1922       system-dialog get-file f-name
     1923       filters "Списки товаров  *.tmg" "*.tmg"
     1924       ask-overwrite
     1925       save-as
     1926       use-filename
     1927       update v-log
     1928       default-extension "tmg".
     1929       if not v-log then do:
     1930         list-option = "":U.
     1931         return.
     1932       end.
     1933       v-log =  session:SET-WAIT-STATE("GENERAL") .
     1934       output stream sout to value (f-name).
     1935         for each loc-tmp-sale-gds No-LOCK WHERE
     1936                    loc-tmp-sale-gds.tmp-code = v-tmp-code :
     1937         find first ub.goods where
     1938                           ub.goods.artic =   loc-tmp-sale-gds.artic and
     1939                           ub.goods.prod-type =   loc-tmp-sale-gds.prod-type and
     1940                           ub.goods.prod-code =   loc-tmp-sale-gds.prod-code no-lock .
     1941         export stream sout
     1942         ub.goods.gds-code
     1943         loc-tmp-sale-gds.tmp-value
     1944         loc-tmp-sale-gds.tmp-code
     1945         .
     1946         END.
     1947         output stream sout close.
     1948         v-log =  session:SET-WAIT-STATE("") .
     1949       end.
     1950       when "load":U then do:
     1951         system-dialog get-file f-name
     1952         filters "Списки клиентов *.tmg" "*.tmg"
     1953         title "Выберите файл списка"
     1954         INITIAL-DIR "."
     1955         return-to-start-dir
     1956         must-exist
     1957         update v-log
     1958         default-extension "tmg".
     1959         if not v-log then do:
     1960          list-option = "":U.
     1961          return.
     1962         end.
     1963         v-log =  session:SET-WAIT-STATE("GENERAL") .
     1964         input stream sout from value (f-name).
     1965         _repeat:
     1966         repeat:
     1967           import stream sout
     1968                         loc-gds-code
     1969                         loc-min-stock
     1970                         loc-tmp-code    no-error.
     1971         find first ub.goods where   ub.goods.gds-code =   loc-gds-code no-lock no-error .
     1972         if error-status :error then do:
     1973            message "Не существует товара с кодом " loc-gds-code view-as alert-box error .
     1974            undo, return error.
     1975            end.
     1976          find first loc-tmp-sale-gds exclusive-LOCK WHERE
     1977               loc-tmp-sale-gds.artic        = ub.goods.artic     and
     1978               loc-tmp-sale-gds.prod-type    = ub.goods.prod-type and
     1979               loc-tmp-sale-gds.prod-code    = ub.goods.prod-code and
     1980               loc-tmp-sale-gds.tmp-code     = v-tmp-code      no-error.
     1981           if not available loc-tmp-sale-gds then create loc-tmp-sale-gds.
     1982           assign
     1983             loc-tmp-sale-gds.artic        = ub.goods.artic
     1984             loc-tmp-sale-gds.prod-type    = ub.goods.prod-type
     1985             loc-tmp-sale-gds.prod-code    = ub.goods.prod-code
     1986             loc-tmp-sale-gds.tmp-value    = loc-min-stock
     1987             loc-tmp-sale-gds.tmp-code     = v-tmp-code
     1988           .
     1989       end.
     1990       input stream sout close.
     1991       v-log =  session:SET-WAIT-STATE("") .
     1992       OPEN QUERY BROWSE-2 FOR EACH ub.tmp-sale-gds       WHERE ub.tmp-sale-gds.tmp-code = t-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = ub.tmp-sale-gds.artic   AND  ub.goods.prod-code = ub.tmp-sale-gds.prod-code   AND ub.goods.prod-type = ub.tmp-sale-gds.prod-type NO-LOCK     .
     1993      end.
     1994   END CASE.
     1995   loc-list-option = "":U.
     1996   end.
     1997   END PROCEDURE.
