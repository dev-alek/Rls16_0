     1700       end.
     1701       if v-curr-sv-date <> ?
     1702       then do:
     1703         run gbl/d-inpday.w
     1704           (input ?
     1705           ,input "Выбор даты"
     1706           ,input v-description
     1707           ,input ""
     1708           ,input-output v-curr-sv-date
     1709           ,output v-ok
     1710           ).
     1711         if v-ok = true
     1712         then do:
     1713           assign
     1714             self :screen-value = string(v-curr-sv-date) .
     1715           .
     1716         end.
     1717       end.
     1718     end.
     1719     return no-apply .
     1720   end.
     1721     define MENU m-ed-date12
     1722       MENU-ITEM m-ed-date12-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1723       MENU-ITEM m-ed-date12-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1724       MENU-ITEM m-ed-date12-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1725       MENU-ITEM m-ed-date12-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1726       .
     1727     if f-date-end :POPUP-MENU in frame Dialog-Frame = ?
     1728     then do:
     1729       ASSIGN
     1730         f-date-end :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date12 :HANDLE
     1731         f-date-end :MENU-MOUSE in frame Dialog-Frame = 3
     1732       .
     1733     end.
     1734     define variable v-label-handle12 as handle no-undo .
     1735     assign
     1736       v-label-handle12 = f-date-end :side-label-handle in frame Dialog-Frame
     1737     .
     1738     if valid-handle (v-label-handle12)
     1739     then do:
     1740       if v-label-handle12 :tooltip = ""
     1741       or v-label-handle12 :tooltip = ?
     1742       then do:
     1743         assign
     1744           v-label-handle12 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1745         .
     1746       end.
     1747     end.
     1748     ON CHOOSE OF MENU-ITEM m-ed-date12-1 in menu m-ed-date12 DO:
     1749       apply "ctrl-b":U to f-date-end in frame Dialog-Frame .
     1750     END.
     1751     ON CHOOSE OF MENU-ITEM m-ed-date12-2 in menu m-ed-date12 DO:
     1752       apply "ctrl-d":U to f-date-end in frame Dialog-Frame .
     1753     END.
     1754     ON CHOOSE OF MENU-ITEM m-ed-date12-3 in menu m-ed-date12 DO:
     1755       apply "ctrl-e":U to f-date-end in frame Dialog-Frame .
     1756     END.
     1757     ON CHOOSE OF MENU-ITEM m-ed-date12-4 in menu m-ed-date12 DO:
     1758       apply "ctrl-f":U to f-date-end in frame Dialog-Frame .
     1759     END.
     1760   MAIN-BLOCK:
     1761   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1762      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1763   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1764     run mainmenu_getcntxt in parparentproc
     1765       (output v-cntxt-db-num
     1766       ,output v-cntxt-userid
     1767       ,output v-cntxt-level
     1768       ,output v-cntxt-host-code-obj
     1769       ,output v-cntxt-obj-type
     1770       ,output v-cntxt-obj-code
     1771       ,output v-cntxt-db-num-obj
     1772       ,output v-cntxt-is-admin
     1773       ) .
     1774     IF lookup(p-mode, 'ДОБАВЛЕНИЕ':U + chr(4) +
     1775                       'ИЗМЕНЕНИЕ':U + chr(4) +
     1776                       'ПРОСМОТР':U +  chr(4) +
     1777                       'ДОБАВЛЕНИЕ':U  + chr(44) + 'temp'
     1778                       , chr(4) ) = 0  THEN DO:
     1779         MESSAGE
     1780         "Неверный параметр p-mode" p-mode
     1781         VIEW-AS ALERT-BOX ERROR.
     1782         RETURN ERROR.
     1783     END.
     1784     if p-mode = 'ДОБАВЛЕНИЕ':U + chr(44) + 'temp':U then do:
     1785         assign
     1786         p-mode = 'ДОБАВЛЕНИЕ':U
     1787         is-temp = yes.
     1788     end.
     1789     CASE p-level :
     1790        when 'db':U then do:
     1791          if p-db-num <> ? then do:
     1792           find first buf_role-db no-lock where
     1793                     buf_role-db.db-num = p-db-num no-error .
     1794           if not available buf_role-db then do:
     1795             message
     1796             substitute("&1&2&3&2&4&2Неверный параметр p-db-num &5 - нет такой БД"
     1797                         , vss-workfile
     1798                         , chr(10)
     1799                         , vss-revision
     1800                         , vss-description
     1801                         , p-db-num)
     1802             view-as alert-box error .
     1803             undo, return error .
     1804           end.
     1805          end.
     1806        end.
     1807        when 'firm':U then do:
     1808          if p-host-code <> 0 then do:
     1809           find first buf_role-sysconf no-lock where
     1810                     buf_role-sysconf.host-code = p-host-code no-error .
     1811           if not available buf_role-sysconf then do:
     1812             message
     1813             substitute("&1&2&3&2&4&2Неверный параметр p-host-code &5 - нет такой ФИРМЫВ"
     1814                         , vss-workfile
     1815                         , chr(10)
     1816                         , vss-revision
     1817                         , vss-description
     1818                         , p-host-code)
     1819             view-as alert-box error .
     1820             undo, return error .
     1821           end.
     1822          end.
     1823        end.
     1824        when 'object':U then do:
     1825          if p-obj-type <> "":U
     1826          or p-obj-code <> 0 then do:
     1827           find first buf_role-clients no-lock where
     1828                     buf_role-clients.obj-type = p-obj-type
     1829                 and buf_role-clients.obj-code = p-obj-code no-error .
     1830           if not available buf_role-clients then do:
     1831             message
     1832             substitute("&1&2&3&2&4&2Неверный параметр p-obj-type p-obj-code &5&6 - нет такого ОБЪЕКТА"
     1833                         , vss-workfile
     1834                         , chr(10)
     1835                         , vss-revision
     1836                         , vss-description
     1837                         , p-obj-type
     1838                         , p-obj-code
     1839                         )
     1840             view-as alert-box error .
     1841             undo, return error .
     1842           end.
     1843          end.
     1844        end.
     1845     END CASE.
     1846     ASSIGN
     1847     f-staff-code = p-staff-code
     1848     f-password = p-password
     1849     f-date-start = p-date-start
     1850     .
     1851     run Myenable in this-procedure .
     1852     WAIT-FOR GO OF FRAME Dialog-Frame.
     1853   END.
     1854   run disable_UI.
     1855   PROCEDURE disable_UI :
     1856     HIDE FRAME Dialog-Frame.
     1857   END PROCEDURE.
     1858   PROCEDURE enable_UI :
     1859     DISPLAY f-db-num f-host-code CB-obj-type f-obj-code f-staff-code f-password
     1860             f-date-start f-date-end E-notes F-host-name F-obj-name fi-screen-pass
     1861         WITH FRAME Dialog-Frame.
     1862     ENABLE B-exit b-quit B-Help B-db B-host CB-obj-type B-obj f-staff-code
     1863            f-password f-date-start f-date-end E-notes F-host-name F-obj-name
     1864            fi-screen-pass
     1865         WITH FRAME Dialog-Frame.
     1866     VIEW FRAME Dialog-Frame.
     1867   END PROCEDURE.
     1868   PROCEDURE fill-codes :
     1869   DEFINE VARIABLE v-last-staff-code AS INTEGER NO-UNDO.
     1870   DEFINE VARIABLE v-work-place AS character NO-UNDO.
     1871     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1872     IF f-staff-code:SCREEN-VALUE IN FRAME Dialog-Frame <> '':U AND v-modified THEN do:
     1873         return.
     1874     END.
     1875     CASE p-level:
     1876       WHEN 'db':U THEN DO:
     1877         ASSIGN
     1878         v-work-place = STRING(f-db-num, '99999').
     1879       END.
     1880       WHEN 'firm':U THEN DO:
     1881         ASSIGN
     1882         v-work-place = STRING(f-host-code, '99999').
     1883       END.
     1884       WHEN 'object':U THEN DO:
     1885         ASSIGN
     1886         v-work-place = cb-obj-type +  STRING(f-obj-CODE, '999999999').
     1887       END.
     1888       WHEN 'global':U THEN DO:
     1889         ASSIGN
     1890         v-work-place = '':U.
     1891       END.
     1892     END CASE.
     1893     IF v-work-place = ?
     1894     OR (v-work-place = '':U AND p-level <> 'global':U) THEN DO:
     1895       ASSIGN
     1896       v-work-place = chr(63).
     1897     END.
     1898     ASSIGN
     1899     v-last-staff-code = gbclcode-get-level-last-code ( INPUT p-role
     1900                                     , INPUT p-level
     1901                                     , INPUT v-work-place
     1902                                     , input ?
     1903                                     ) NO-ERROR.
     1904     IF length(STRING(v-last-staff-code + 1)) <= LENGTH(p-staff-code-format) THEN
     1905     display
     1906     v-last-staff-code + 1 @ f-staff-code
     1907     with frame Dialog-Frame.
     1908   end.
     1909   END PROCEDURE.
     1910   PROCEDURE MyEnable :
     1911   define buffer buf_clients for ub.clients.
     1912   ASSIGN
     1913    fi-screen-pass:WIDTH-CHARS IN FRAME Dialog-Frame = f-password:WIDTH-CHARS IN FRAME Dialog-Frame - 0.5
     1914    fi-screen-pass:HEIGHT-CHARS IN FRAME Dialog-Frame = f-password:HEIGHT-CHARS IN FRAME Dialog-Frame - 0.6
     1915    fi-screen-pass:row IN FRAME Dialog-Frame = f-password:row IN FRAME Dialog-Frame + 0.20
     1916    fi-screen-pass:COL IN FRAME Dialog-Frame = f-password:col IN FRAME Dialog-Frame + 0.25
     1917    .
     1918   ASSIGN
     1919   v-tab-order = "b-exit,b-quit,b-help,b-db,b-host,b-obj,f-staff-code,f-password,f-date-start,f-date-end"
     1920   FRAME Dialog-Frame:TITLE = p-title
     1921   f-staff-code:LABEL = p-staff-code-label
     1922   f-staff-code:format = p-staff-code-format
     1923   f-password:LABEL = p-password-label
     1924   f-password:format = p-password-format
     1925   e-notes:SCREEN-VALUE = p-notes
     1926   f-date-start = p-date-start
     1927   f-date-end = p-date-end
     1928   .
     1929   if p-level = 'object':U
     1930   and  available buf_role-clients then do:
     1931     assign
     1932     v-obj-db-num = buf_role-clients.db-num.
     1933   end.
     1934   DISPLAY
     1935   f-staff-code
     1936   f-password WHEN p-password-option > 0
     1937   f-date-start
     1938   f-date-end WHEN p-date-end <> 12/31/9999
     1939   WITH FRAME Dialog-Frame.
     1940   IF p-notes = '':U THEN DO:
     1941       HIDE
     1942       E-notes
     1943       IN FRAME Dialog-Frame.
     1944   END.
     1945   ENABLE
     1946   B-exit
     1947   b-quit
     1948   B-Help
     1949   b-db WHEN (p-mode = 'ДОБАВЛЕНИЕ':U AND p-level = 'db':U and v-cntxt-db-num = 0)
     1950   b-host WHEN (p-mode <> 'ДОБАВЛЕНИЕ':U AND p-level = 'firm':U and v-cntxt-db-num = 0)
     1951   b-obj WHEN (p-mode <> 'ДОБАВЛЕНИЕ':U AND p-level = 'object':U and
     1952               (v-cntxt-db-num = 0 or v-cntxt-db-num = v-obj-db-num))
     1953   f-staff-code WHEN p-mode = 'ДОБАВЛЕНИЕ':U
     1954   f-password  WHEN (p-mode <> 'ПРОСМОТР':U AND p-password-option > 0)
     1955   f-date-start WHEN p-mode = 'ДОБАВЛЕНИЕ':U
     1956   f-date-end WHEN (p-mode = 'ИЗМЕНЕНИЕ':U AND p-date-end <> 12/31/9999)
     1957   e-notes WHEN p-notes <> '':U
     1958   WITH FRAME Dialog-Frame.
     1959   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1960       ASSIGN
     1961       b-quit:LABEL = "&Выход".
     1962       HIDE b-exit
     1963       IN FRAME Dialog-Frame.
     1964   END.
     1965   if p-level = 'db':U then do:
     1966     assign
     1967     f-db-num = p-db-num.
     1968     display
     1969     f-db-num
     1970     with frame Dialog-Frame .
     1971   end.
     1972   else do:
     1973     hide
     1974     b-db
     1975     f-db-num
     1976     in frame Dialog-Frame .
     1977   end.
     1978   if p-date-end = 12/31/9999 then do:
     1979      hide
     1980      f-date-end
     1981      in frame Dialog-Frame .
     1982   end.
     1983   if p-level = 'firm':U then do:
     1984     assign
     1985     f-host-code = p-host-code.
     1986     find first buf_clients no-lock where
     1987               buf_clients.obj-type = 'орг':U
     1988           and buf_clients.obj-code = p-host-code.
     1989     f-host-name = buf_clients.obj-name.
     1990     display
     1991     f-host-code
     1992     f-host-name
     1993     with frame Dialog-Frame .
     1994   end.
     1995   else do:
     1996     hide
     1997     b-host
     1998     f-host-code
     1999     f-host-name
     2000     in frame Dialog-Frame .
     2001   end.
     2002   if p-level = 'object':U then do:
     2003     assign
     2004     CB-obj-type = p-obj-type
     2005     f-obj-code = p-obj-code
     2006     f-obj-name = buf_role-clients.obj-name.
     2007     display
     2008     f-obj-name
     2009     f-obj-code
     2010     CB-obj-type
     2011     with frame Dialog-Frame .
     2012   end.
     2013   else do:
     2014     hide
     2015     b-obj
     2016     cb-obj-type
     2017     f-obj-code
     2018     f-obj-name
     2019     in frame Dialog-Frame .
     2020   end.
     2021   run fill-codes IN THIS-PROCEDURE NO-ERROR.
     2022   if p-role = 'C':U
     2023   then do :
     2024   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2025   do:
     2026     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2027       (input  v-cntxt-db-num
     2028       ,input  v-cntxt-userid
     2029       ,input  0
     2030       ,input  'actn_client-reference_update':U
     2031       ,input  'global':U
     2032       ,input  0
     2033       ,input  '':U
     2034       ,input  0
     2035       ,input  0
     2036       ,input  0
     2037       ,input  0
     2038       ,input  false
     2039       ,output glog
     2040       )  .
     2041   end.
     2042     if not glog
     2043     then do :
     2044       disable
     2045         b-db
     2046         b-host
     2047         b-obj
     2048         CB-obj-type
     2049         f-date-start
     2050         f-date-end
     2051       with frame Dialog-Frame .
     2052     end.
     2053   end .
     2054   VIEW FRAME Dialog-Frame.
     2055   APPLY "TAB" TO b-help.
     2056   END PROCEDURE.
     2057   PROCEDURE proc-b-db :
     2058   define variable v-ri as recid no-undo .
     2059   define buffer buf_db  for ub.db.
     2060     do
     2061     on error undo, return error
     2062     :
     2063     run adm/dbs.w (
     2064                input parparentproc
     2065              , INPUT 'ПРОСМОТР':U
     2066              , output v-ri).
     2067     if v-ri <> ?
     2068     then do:
     2069       find buf_db where recid (buf_db) = v-ri .
     2070       assign
     2071       f-db-num = buf_db.db-num
     2072       .
     2073       DISPLAY
     2074       f-db-num
     2075       WITH FRAME Dialog-Frame.
     2076     END.
     2077   end.
     2078   run fill-codes IN THIS-PROCEDURE NO-ERROR.
     2079   END PROCEDURE.
     2080   PROCEDURE proc-b-host :
     2081   define VARIABLE v-host-code LIKE ub.sysconf.host-code no-undo .
     2082   define variable v-rid-list as character no-undo .
     2083   define buffer buf_clients  for ub.clients.
     2084     do
     2085     on error undo, return error
     2086     :
     2087           run adm/sconfs.w (
     2088                 input parParentProc
     2089               , input "b-sel":U
     2090               , input no
     2091               , input v-cntxt-host-code-obj
     2092               , output v-host-code
     2093               , input-output v-rid-list
     2094           ) no-error.
     2095         IF v-rid-list = '':U THEN RETURN NO-APPLY.
     2096         FIND FIRST buf_clients NO-LOCK WHERE
     2097                    buf_clients.obj-code = v-host-code
     2098                 AND buf_clients.obj-type = 'орг':U NO-ERROR.
     2099         if not available buf_clients then do:
     2100              return error.
     2101         end.
     2102         assign
     2103         f-host-CODE = v-host-code
     2104         f-host-name = buf_clients.obj-name
     2105         .
     2106         DISPLAY
     2107         f-host-code
     2108         f-host-name
     2109         WITH FRAME Dialog-Frame.
     2110     end.
     2111   run fill-codes IN THIS-PROCEDURE NO-ERROR.
     2112   END PROCEDURE.
     2113   PROCEDURE proc-b-obj :
     2114   define variable v-rid-list as character no-undo .
     2115   define buffer buf_clients  for ub.clients.
     2116     do
     2117     on error undo, return error
     2118     :
     2119          run ref/cli-all.w (
     2120                    INPUT parparentproc
     2121                   ,INPUT "b-sel"
     2122                   ,INPUT 'объект':U
     2123                   ,INPUT 'все':U
     2124                   ,INPUT 'текущие':U
     2125                   ,INPUT ?
     2126                   ,INPUT ",,,,,,NO,,"
     2127                   ,INPUT "lock-cli-type"
     2128                   ,output v-rid-list ) NO-ERROR.
     2129        IF v-rid-list = '':U THEN RETURN error.
     2130         FIND FIRST buf_clients NO-LOCK WHERE
     2131             RECID( buf_clients) = INTEGER( v-rid-list ) NO-ERROR.
     2132         if not available buf_clients then do:
     2133              return error.
     2134         end.
     2135         assign
     2136         f-obj-CODE = buf_clients.obj-code
     2137         CB-obj-type = buf_clients.obj-type
     2138         f-obj-name = buf_clients.obj-name
     2139         .
     2140         DISPLAY
     2141         f-obj-code
     2142         cb-obj-type
     2143         f-obj-name
     2144         WITH FRAME Dialog-Frame.
     2145     end.
     2146   run fill-codes IN THIS-PROCEDURE NO-ERROR.
     2147   END PROCEDURE.
     2148   PROCEDURE proc-save :
     2149   define variable psw-buf as character no-undo .
     2150   DEFINE BUFFER buf_clients for ub.clients.
     2151   DEFINE BUFFER buf_db     FOR ub.db.
     2152   DEFINE BUFFER buf_sysconf     FOR ub.sysconf.
     2153   ASSIGN FRAME Dialog-Frame
     2154   f-db-num when (f-db-num:visible in frame Dialog-Frame
     2155                  and p-mode <> 'ПРОСМОТР':U)
     2156   f-host-code when (f-host-code:visible in frame Dialog-Frame
     2157                  and p-mode <> 'ПРОСМОТР':U)
     2158   CB-obj-type when (cb-obj-type:visible in frame Dialog-Frame
     2159                  and p-mode <> 'ПРОСМОТР':U)
     2160   f-obj-code when (f-obj-code:visible in frame Dialog-Frame
     2161                  and p-mode <> 'ПРОСМОТР':U)
     2162   f-staff-code
     2163   f-date-start WHEN f-date-start:SENSITIVE IN FRAME Dialog-Frame
     2164   f-date-end   WHEN (f-date-end:visible IN FRAME Dialog-Frame
     2165                     and
     2166                     f-date-end:SENSITIVE IN FRAME Dialog-Frame)
     2167   .
     2168   if f-date-start:sensitive IN FRAME Dialog-Frame
     2169   and f-date-end:SENSITIVE IN FRAME Dialog-Frame then do:
     2170     if f-date-end < f-date-start then do:
     2171       message
     2172       "Дата начала работы в данной поли должна быть не больше  даты конца работы в данной роли!"
     2173       view-as alert-box error .
     2174       apply "ENTRY" to f-date-end.
     2175       return error.
     2176     end.
     2177   end.
     2178   IF f-password:VISIBLE IN FRAME Dialog-Frame THEN DO:
     2179       ASSIGN
     2180       f-password.
     2181       if f-password = '' or f-password = ? then do:
     2182           message
     2183           "Пароль НЕ заполнен!"
     2184           view-as alert-box ERROR .
     2185           apply "ENTRY":U to f-password IN frame Dialog-Frame.
     2186           return error.
     2187       end.
     2188       if integer(f-password) < 1000 or integer(f-password) > 32767 then do:
     2189           message
     2190           "Пароль должен быть от 1000 до 32767!"
     2191           view-as alert-box ERROR .
     2192           apply "ENTRY":U to f-password IN frame Dialog-Frame.
     2193           return error.
     2194       end.
     2195       if p-password-option > 1
     2196       or f-password <> '':U
     2197       then do:
     2198         run ref/per-pswd.w ( output psw-buf ) .
     2199         if f-password <> psw-buf then do:
     2200           message
     2201           "Пароль НЕ подтвержден!"
     2202           view-as alert-box ERROR .
     2203           apply "ENTRY":U to f-password IN frame Dialog-Frame.
     2204           return error.
     2205         end.
     2206      end.
     2207   END.
     2208   CASE p-level:
     2209       WHEN 'db':U THEN DO:
     2210          FIND FIRST buf_db NO-LOCK WHERE
     2211                  buf_db.db-num = f-db-num NO-ERROR.
     2212          IF NOT AVAILABLE buf_db THEN DO:
     2213             MESSAGE
     2214             "Неверный номер БД"
     2215             VIEW-AS ALERT-BOX.
     2216             UNDO, RETURN ERROR.
     2217          END.
     2218       END.
     2219       WHEN 'firm':U THEN DO:
     2220           find FIRST buf_sysconf NO-LOCK WHERE
     2221               buf_sysconf.host-code = f-host-code  NO-ERROR.
     2222           IF NOT AVAILABLE buf_sysconf THEN DO:
     2223               MESSAGE
     2224               "Неверный номер фирмы"
     2225               VIEW-AS ALERT-BOX.
     2226               UNDO, RETURN ERROR.
     2227           END.
     2228       END.
     2229       WHEN 'object':U THEN DO:
     2230           find FIRST buf_clients NO-LOCK WHERE
     2231               buf_clients.obj-type = cb-obj-type
     2232           AND buf_clients.obj-code = f-obj-code NO-ERROR.
     2233           IF NOT AVAILABLE buf_clients THEN DO:
     2234               MESSAGE
     2235               "Неверный номер объекта"
     2236               VIEW-AS ALERT-BOX.
     2237               UNDO, RETURN ERROR.
     2238           END.
     2239           IF NOT (buf_clients.obj-type = 'маг':U
     2240                   OR
     2241                   buf_clients.obj-type = 'скл':U)
     2242                   THEN DO:
     2243               message
     2244               "Неверный тип объекта"
     2245               VIEW-AS ALERT-BOX.
     2246               UNDO, RETURN ERROR.
     2247           END.
     2248       END.
     2249   END CASE.
     2250   END PROCEDURE.
