        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE INPUT PARAMETER p-parent-handle AS HANDLE NO-UNDO.
        3   DEFINE INPUT PARAMETER p-role AS CHARACTER NO-UNDO.
        4   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        5   define input parameter p-level as CHARACTEr no-undo .
        6   define INPUT-OUTPUT parameter p-db-num like ub.db.db-num no-undo .
        7   define INPUT-OUTPUT parameter p-host-code like ub.sysconf.host-code no-undo .
        8   define INPUT-OUTPUT parameter p-obj-type like ub.clients.obj-type no-undo .
        9   define INPUT-OUTPUT parameter p-obj-code like ub.clients.obj-code no-undo .
       10   DEFINE INPUT PARAMETER p-title AS CHARACTER NO-UNDO.
       11   DEFINE INPUT PARAMETER p-staff-code-label AS CHARACTER NO-UNDO.
       12   DEFINE INPUT PARAMETER p-staff-code-format AS CHARACTER NO-UNDO.
       13   DEFINE INPUT PARAMETER p-password-option AS integer NO-UNDO.
       14   DEFINE INPUT PARAMETER p-password-label AS CHARACTER NO-UNDO.
       15   DEFINE INPUT PARAMETER p-password-format AS CHARACTER NO-UNDO.
       16   DEFINE INPUT PARAMETER p-notes  AS CHARACTER NO-UNDO.
       17   DEFINE INPUT-OUTPUT PARAMETER p-staff-code AS integer NO-UNDO.
       18   DEFINE INPUT-OUTPUT PARAMETER p-password AS character NO-UNDO.
       19   DEFINE INPUT-OUTPUT PARAMETER p-date-start AS date NO-UNDO.
       20   DEFINE INPUT-OUTPUT PARAMETER p-date-end AS date NO-UNDO.
       21   DEFINE OUTPUT PARAMETER p-ok AS logical NO-UNDO.
       22   define variable vss-revision    as character no-undo init "$Revision$":U .
       23   define variable vss-author      as character no-undo init "$Author$":U .
       24   define variable vss-date        as character no-undo init "$Date$":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       26   define variable vss-archive     as character no-undo init "$Archive$":U .
       27   define variable vss-description as character no-undo init "Редактирование данных по персоналу".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define variable v-waitfram-action01         as character   no-undo .
       84   define variable v-waitfram-action02         as character   no-undo .
       85   define variable v-waitfram-action03         as character   no-undo .
       86   define variable mWaitFramTextBeg            as character   no-undo.
       87   define variable mWaitFramTextEnd            as character   no-undo.
       88   define variable mWaitFramView               as logical     no-undo.
       89   define variable mWaitProcEvent              as logical     no-undo init yes.
       90   define variable mWaitFramInterval           as integer     no-undo init 1 .
       91   define variable mWaitFramStop               as logical     no-undo.
       92   define variable mWaitFramStopUser           as logical     no-undo.
       93   define variable mWaitFramStopTimeOut        as logical     no-undo.
       94   define variable mWaitFramStartProc          as datetime-tz no-undo.
       95   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       96   define button B-WaitFramStop auto-end-key
       97        label "Стоп"
       98        size 10 by 1 tooltip "Остоновить процесс".
       99   define button B-viewProcInfo
      100        label "Информация"
      101        size 15 by 1 tooltip "Информация о процесс".
      102   define frame waitfram
      103     v-waitfram-action01 format "x(72)" no-label skip
      104     v-waitfram-action02 format "x(72)" no-label skip
      105     v-waitfram-action03 format "x(72)" no-label skip
      106     B-viewProcInfo
      107     B-WaitFramStop at row 4 col 30
      108     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      109     .
      110   define new global shared variable mBatchMode as logical no-undo init ?.
      111   define variable mFramBachModHandle as handle no-undo.
      112   mFramBachModHandle = frame waitfram:handle.
      113   define variable mFameOldVis as logical no-undo.
      114   define variable mVisCUrentVin as logical no-undo.
      115   if session:batch-mode
      116   then
      117      mBatchMode = yes.
      118   if mBatchMode = ? then do:
      119     mVisCUrentVin = current-window:visible.
      120     mFameOldVis = mFramBachModHandle:visible.
      121     mFramBachModHandle:visible  = yes.
      122     mBatchMode = mFramBachModHandle:visible ne yes.
      123     mFramBachModHandle:visible = mFameOldVis.
      124     current-window:visible = mVisCUrentVin.
      125   end.
      126    if  log-manager:logfile-name ne ?
      127     then DO:
      128         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      129         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      130         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      131     end.
      132   on choose of B-WaitFramStop in frame waitfram
      133   do:
      134     mWaitFramStop = yes.
      135     mWaitFramStopUser = yes.
      136   end.
      137   function waitfram-check-timeout returns logical():
      138      define variable vtime as int64 no-undo.
      139      if mWaitFramStopTimeOut
      140      then
      141         return yes.
      142      vtime = ( now - mWaitFramStartProc ) / 1000 .
      143      if     mWaitFramTimeOut ne ?
      144         and mWaitFramTimeOut ne 0
      145         and mWaitFramTimeOut lt vtime
      146      then do:
      147         mWaitFramStopTimeOut = yes.
      148      end.
      149      return mWaitFramStopTimeOut.
      150   end.
      151   procedure waitfram-hide :
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       pause 0 before-hide .
      157       if not mBatchMode then
      158         hide frame waitfram .
      159     if     not mWaitFramView
      160        and mWaitProcEvent
      161     then
      162       process events .
      163     end.
      164   end procedure.
      165   procedure waitfram-show :
      166     define input  parameter p-message as character no-undo .
      167     define variable v-left-margin as integer   no-undo .
      168     if not session:batch-mode
      169     then do
      170     on error undo, return error return-value
      171     :
      172       if length(p-message) <= 70 then do:
      173         assign
      174           v-left-margin = integer((70 - length(p-message)) / 2)
      175         .
      176         assign
      177           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      178         .
      179         assign
      180           v-waitfram-action01 = " "
      181           v-waitfram-action02 = " "
      182                                    + fill(" ", v-left-margin)
      183                                    + p-message
      184           v-waitfram-action03 = " "
      185         .
      186       end.
      187       else do:
      188         define variable vRindex1 as integer no-undo.
      189         define variable vRindex2 as integer no-undo.
      190         vRindex1 = r-index(p-message," ",70).
      191         if vRindex1 = 0
      192         then
      193            vRindex1 = 70.
      194         if length(p-message)  <= vRindex1 + 70 then do:
      195           assign
      196             v-waitfram-action01 = " "
      197             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      199           .
      200         end.
      201         else do:
      202           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      203           if vRindex2 <= vRindex1
      204           then
      205              vRindex2 = vRindex1 + 70.
      206           assign
      207             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      208             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      209             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      210           .
      211         end.
      212       end.
      213       B-viewProcInfo:visible   in frame waitfram = no.
      214       B-viewProcInfo:sensitive in frame waitfram = no.
      215       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      216       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      217       if  (   mWaitFramView
      218          or  mWaitProcEvent)
      219          and not mBatchMode
      220       then
      221          display
      222             v-waitfram-action01 skip
      223             v-waitfram-action02 skip
      224             v-waitfram-action03 skip
      225          with frame waitfram .
      226       if     mWaitFramView
      227          then do:
      228             if     mWaitFramInterval ne ?
      229                and not mBatchMode
      230             then
      231                wait-for go of frame waitfram pause mWaitFramInterval.
      232          end.
      233          else
      234             if     mWaitProcEvent
      235                and not mBatchMode
      236             then
      237                process events .
      238     end.
      239   end procedure.
      240      procedure waitfram-show-this:
      241         define input  parameter iInterval as int64 no-undo.
      242         define variable vtime as int64 no-undo.
      243         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      244         mWaitFramInterval = iInterval.
      245         run waitfram-show (substitute("&1&2 &3&4" ,
      246                                       mWaitFramTextBeg ,
      247                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      248                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      249                                       mWaitFramTextEnd
      250                                      )
      251                           ).
      252      end.
      253      procedure WaitFramRunPause:
      254         define input  parameter iInterval as dec no-undo.
      255         define variable vStart  as datetime-tz no-undo.
      256         define variable vend    as datetime-tz no-undo.
      257         define variable vint as int64 no-undo.
      258         define variable vOk as logical no-undo.
      259         vStart = now.
      260         vend   = vStart.
      261         publish "WaitFramPause" (iInterval,output vOk).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and (   vint > 0
      267                 or (    not vOk
      268                     and iInterval eq ?
      269                     )
      270                 )
      271         then
      272            run waitfram-show-this (iInterval).
      273         vend   =  now.
      274         vint = vend - vStart.
      275         vint = iInterval - vint / 1000.
      276         if     not mWaitFramStop
      277            and vint > 0
      278         then do:
      279            run gbl/pause.p (vint * 1000).
      280         end.
      281         if iInterval ne ?
      282         then
      283            publish "WaitFramStop".
      284         waitfram-check-timeout().
      285      end.
      286      procedure WaitFramWaitFor:
      287         define input  parameter iInterval as dec no-undo.
      288         assign
      289            mWaitFramStartProc   = now
      290            mWaitFramStopUser    = no
      291            mWaitFramStopTimeOut = no
      292         .
      293         block-wait:
      294         do while not mWaitFramStop:
      295            run WaitFramRunPause (iInterval).
      296            if  waitfram-check-timeout()
      297            then do:
      298               leave block-wait.
      299            end.
      300         end.
      301         run waitfram-hide.
      302      end.
      303   procedure waitfram-join :
      304     define input  parameter p-line-1  as character no-undo .
      305     define input  parameter p-line-2  as character no-undo .
      306     define input  parameter p-line-3  as character no-undo .
      307     define output parameter p-message as character no-undo .
      308     do
      309     on error undo, return error return-value
      310     :
      311       assign
      312         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      313                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      314                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      315       .
      316     end.
      317   end procedure.
      318   function waitfram-join-function returns character
      319     (input p-line-1 as character
      320     ,input p-line-2 as character
      321     ,input p-line-3 as character
      322     ).
      323     define variable v-message as character no-undo .
      324     run waitfram-join in this-procedure
      325       (input  p-line-1
      326       ,input  p-line-2
      327       ,input  p-line-3
      328       ,output v-message
      329       ) .
      330     return v-message .
      331   end function .
      332   define new global shared variable g#language as character no-undo .
      333   if g#language <> '' and g#language <> 'rus':U then do:
      334     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      335   end.
      336   define new global shared variable g#library  as handle no-undo .
      337   define new global shared variable g#library2 as handle no-undo .
      338   procedure proc-alt-shift-f2:
      339     if not ibs.th.gbl.gbl-var:rcode
      340   then
      341     run gbl\inidebug.p .
      342   end.
      343   procedure proc-alt-shift-f3:
      344     run gbl/prvssinf.p
      345       ( input this-procedure
      346       ) .
      347   end.
      348   define variable v-inform-launched as logical no-undo initial false .
      349   procedure proc-alt-shift-f4:
      350     define variable v-action as character no-undo .
      351     if v-inform-launched = false then do:
      352       assign
      353         v-inform-launched = true
      354       .
      355       run gbl/d-inform.w
      356         (  input self
      357         ,  input this-procedure
      358         , output v-action
      359         ) no-error .
      360       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      361       assign
      362         v-inform-launched = false
      363       .
      364     end.
      365   end.
      366   procedure proc-alt-f1:
      367     run gbl/corrhelp.p
      368       (input this-procedure
      369       ) .
      370   end .
      371   on alt-shift-f2 anywhere do:
      372     run proc-alt-shift-f2.
      373   end.
      374   on alt-shift-f3 anywhere do:
      375     run proc-alt-shift-f3 in this-procedure .
      376   end.
      377   on alt-shift-f4 anywhere do:
      378     run proc-alt-shift-f4 in this-procedure.
      379   end.
      380   on alt-f1 anywhere do:
      381     run proc-alt-f1 in this-procedure .
      382   end.
      383   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384     define variable v-cntxt-db-num        as integer   no-undo .
      385     define variable v-cntxt-userid        as character no-undo .
      386     define variable v-cntxt-level         as character no-undo .
      387     define variable v-cntxt-host-code-obj as integer   no-undo .
      388     define variable v-cntxt-obj-type      as character no-undo .
      389     define variable v-cntxt-obj-code      as integer   no-undo .
      390     define variable v-cntxt-db-num-obj    as integer   no-undo .
      391     define variable v-cntxt-is-admin      as logical   no-undo .
      392   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      394                                                       ,input p-range-type as character
      395                                                       ,input p-code as integer):
      396   define variable v-seq-val as integer no-undo .
      397   define buffer buf_code-range for ub.code-range.
      398   find first buf_code-range no-lock where
      399             buf_code-range.db-num = p-db-num
      400       and  buf_code-range.range-type = p-range-type
      401       and  buf_code-range.stts = 'u'
      402       and buf_code-range.first-code <= p-code
      403       and buf_code-range.last-code >= p-code no-error .
      404   if available buf_code-range then return yes.
      405   CASE p-range-type:
      406     when 'pngb':U then do:
      407       v-seq-val = current-value(s-pngb-code, ub).
      408     end.
      409     when 'fmgb':U then do:
      410       v-seq-val = current-value(s-fmgb-code, ub).
      411     end.
      412   END CASE.
      413   if p-code <= v-seq-val then do:
      414     find first buf_code-range no-lock where
      415               buf_code-range.db-num = p-db-num
      416         and  buf_code-range.range-type = p-range-type
      417         and  buf_code-range.stts = 'a'
      418         and buf_code-range.first-code <= p-code
      419         no-error .
      420    if available buf_code-range then return yes.
      421   end.
      422   find first buf_code-range no-lock where
      423             buf_code-range.db-num = p-db-num
      424       and  buf_code-range.range-type = p-range-type
      425       and  buf_code-range.stts = 'f'
      426       and buf_code-range.first-code <= p-code
      427       and buf_code-range.last-code >= p-code
      428       no-error .
      429   if available buf_code-range then return yes.
      430   return no.
      431   END FUNCTION.
      432   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      433                                                       ,input p-range-type as character
      434                                                       ,input p-code as integer):
      435   define variable v-seq-val as integer no-undo .
      436   define buffer buf_code-range for ub.code-range.
      437   CASE p-range-type:
      438     when 'pngb':U then do:
      439       v-seq-val = current-value(s-pngb-code, ub).
      440     end.
      441     when 'fmgb':U then do:
      442       v-seq-val = current-value(s-fmgb-code, ub).
      443     end.
      444   END CASE.
      445   if p-code <= v-seq-val then do:
      446     find first buf_code-range no-lock where
      447               buf_code-range.db-num = p-db-num
      448         and  buf_code-range.range-type = p-range-type
      449         and buf_code-range.first-code <= p-code
      450         and buf_code-range.last-code >= p-code no-error .
      451     if available buf_code-range then return yes.
      452   end.
      453   return no.
      454   END FUNCTION.
      455   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      456                                                       ,input p-db-num as integer
      457                                                       ,input p-staff-code as integer
      458                                                       ,input p-date as date
      459                                                        ):
      460   define buffer buf_staff for ub.staff.
      461   if p-date = ? then do:
      462     p-date = today .
      463   end.
      464   find first buf_staff no-lock where
      465             buf_staff.role = p-role
      466         and buf_staff.role-level = 'db':U
      467         and buf_staff.db-num = p-db-num
      468         and buf_staff.staff-code = p-staff-code
      469         and buf_staff.date-end >= p-date use-index pi  no-error .
      470   if available buf_staff then do:
      471     return buf_staff.psn-code.
      472   end.
      473   return 0.
      474   end FUNCTION.
      475   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      476                                                             ,input p-db-num as integer
      477                                                             ,input p-date as date
      478                                                                 ):
      479   define buffer buf_staff for ub.staff.
      480   define buffer buf2_staff for ub.staff.
      481   if p-date = ? then do:
      482     p-date = today .
      483   end.
      484   for each  buf_staff no-lock where
      485             buf_staff.role = p-role
      486         and buf_staff.db-num = p-db-num,
      487   first buf2_staff no-lock where
      488         buf2_staff.role = p-role
      489     and buf2_staff.role-level = 'db':U
      490     and buf2_staff.staff-code = buf_staff.staff-code
      491     and buf2_staff.date-start <= p-date
      492     and buf2_staff.date-end >= p-date
      493   by buf_staff.staff-code
      494   by date-start descending:
      495     return buf_staff.staff-code.
      496   end.
      497   end FUNCTION.
      498   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      499                                                  ,input p-db-num as integer
      500                                                  ,input p-psn-code as integer
      501                                                  ,input p-date as date
      502                                                  ,output p-c-password as character
      503                                                        ):
      504   define buffer buf_staff for ub.staff.
      505   if p-date = ? then do:
      506     p-date = today .
      507   end.
      508   find first buf_staff no-lock where
      509             buf_staff.role = p-role
      510         and buf_staff.role-level = 'db':U
      511         and buf_staff.db-num = p-db-num
      512        and buf_staff.date-end >= p-date
      513        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      514   if available buf_staff
      515   then do:
      516     assign
      517     p-c-password = buf_staff.password.
      518     return buf_staff.staff-code.
      519   end.
      520   p-c-password = ''.
      521   return 0.
      522   end FUNCTION.
      523   FUNCTION gbclcode-is-psn-role returns integer (
      524                                                 input p-role as character
      525                                                 ,input p-psn-code as integer
      526                                                 ,input p-date as date
      527                                                     ):
      528   define buffer buf_staff for ub.staff.
      529   if p-date = ? then do:
      530     p-date = today .
      531   end.
      532   for each buf_staff no-lock where
      533             buf_staff.psn-code = p-psn-code
      534        and  buf_staff.role = p-role
      535   by buf_staff.role-level
      536   by buf_staff.date-start
      537        :
      538     if  buf_staff.date-start <= p-date and
      539     buf_staff.date-end >= p-date  then do:
      540       return buf_staff.staff-code.
      541     end.
      542   end.
      543   return 0.
      544   end FUNCTION.
      545   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      546   define variable v-role-name as character no-undo .
      547   assign
      548   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      549   no-error .
      550   return v-role-name.
      551   END.
      552   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   FUNCTION gbclcode-get-position returns character ( input p-role as character
      554                                                     ,input p-role-level as character
      555                                                     ,input p-work-place as character
      556                                                     ,input p-staff-code as integer
      557                                                                ):
      558   define variable v-role-name as character no-undo .
      559   define variable v-role-level as character no-undo .
      560   define variable v-staff-code as integer no-undo .
      561   assign
      562   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      563   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      564   v-staff-code = p-staff-code
      565   no-error .
      566   return substitute("&1, &2, Код &3"
      567                   ,v-role-name
      568                   ,v-role-level
      569                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      570   END.
      571   FUNCTION gbclcode-get-work-place returns character (
      572                                                   input p-role as character
      573                                                  ,input p-role-level as character
      574                                                  ,input p-db-num as integer
      575                                                  ,input p-host-code as integer
      576                                                  ,input p-obj-type as character
      577                                                  ,input p-obj-code as integer
      578                                                  ) :
      579   define variable v-work-place as character no-undo .
      580   define variable v-obj-type as character no-undo .
      581     case p-role-level:
      582       when 'db':U then do:
      583         v-work-place = string(p-db-num, "99999").
      584       end.
      585       when 'firm':U then do:
      586         v-work-place = string(p-host-code, "99999").
      587       end.
      588       when 'object':U then do:
      589         assign
      590         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      591         .
      592       end.
      593     END CASE.
      594     return v-work-place.
      595   END FUNCTION.
      596   FUNCTION gbclcode-get-level-last-code returns integer (
      597                                                           input p-role as character
      598                                                         , input p-role-level as character
      599                                                         , input p-work-place as character
      600                                                         , input p-date-start as date
      601                                                         ):
      602   DEFINE VARIABLE v-today as date no-undo .
      603   define buffer buf_staff for ub.staff.
      604   if p-work-place = chr(63) then return ?.
      605   if p-date-start = ? then do:
      606     v-today = today .
      607   end.
      608   else do:
      609     v-today = p-date-start.
      610   end.
      611   find last buf_staff no-lock where
      612             buf_staff.role = p-role
      613        and  buf_staff.role-level = p-role-level
      614        and  buf_staff.work-place = p-work-place
      615        and  buf_staff.date-start <= v-today + 1
      616        and  buf_staff.date-end >= v-today + 1
      617        use-index pi  no-error .
      618   if available buf_staff
      619   then return buf_staff.staff-code.
      620   return 0.
      621   end FUNCTION.
      622   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      623   procedure cur-time :
      624      define output parameter p-today as date      no-undo .
      625      define output parameter p-time  as integer   no-undo .
      626     do
      627     on error undo, return error
      628     :
      629       define variable v-date1 as date      no-undo .
      630       define variable v-date2 as date      no-undo .
      631       define variable v-time  as integer   no-undo .
      632       assign
      633         v-date1 = today
      634         v-time  = time
      635         v-date2 = today
      636       .
      637       if v-date1 <> v-date2
      638       then do:
      639         assign
      640           v-date1 = today
      641           v-time  = v-time
      642         .
      643       end.
      644       assign
      645         p-today = v-date1
      646         p-time  = v-time
      647       .
      648     end.
      649   end.
      650   function cur-time-date returns character
      651   :
      652     return string(today, '99/99/9999':U) .
      653   end.
      654   function cur-time-mjd returns decimal
      655   :
      656     define variable v-date as date      no-undo .
      657     define variable v-time as integer   no-undo .
      658     run cur-time in this-procedure
      659       (output v-date
      660       ,output v-time
      661       ) .
      662     return integer(v-date) - 2400002 + (v-time / 86400) .
      663   end.
      664   function cur-time-get-ending-index returns integer
      665   (input p-number as integer
      666   )
      667   :
      668     if p-number < 0
      669     or p-number = ?
      670     then do:
      671       return 1 .
      672     end.
      673     define variable v-rest as integer   no-undo .
      674     assign
      675       p-number = p-number modulo 100
      676     .
      677     if p-number < 20
      678     then do:
      679       assign
      680         v-rest = p-number
      681       .
      682     end.
      683     else do:
      684       assign
      685         v-rest = p-number modulo 10
      686       .
      687     end.
      688     case v-rest :
      689       when 1
      690       then do:
      691         return 2 .
      692       end.
      693       when 2 or
      694       when 3 or
      695       when 4
      696       then do:
      697         return 3 .
      698       end.
      699       otherwise do:
      700         return 1 .
      701       end.
      702     end case .
      703   end.
      704   procedure cur-time-mjd-to-date :
      705      define input  parameter i-mjd-diff as decimal no-undo.
      706      define output parameter o-Date     as date    no-undo.
      707      define output parameter o-Time     as integer no-undo.
      708      define variable v-day-number as integer   no-undo .
      709      if    i-mjd-diff < 0
      710         or i-mjd-diff = ?
      711      then do:
      712         return "?" .
      713      end.
      714      assign
      715         v-day-number = truncate(i-mjd-diff,0).
      716         o-Date = date(v-day-number + 2400002).
      717         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      718     .
      719   end.
      720   function cur-time-mjd-to-string returns character
      721   (input p-mjd-diff as decimal
      722   )
      723   :
      724     define variable v-day-number as integer   no-undo .
      725     define variable v-seconds    as integer   no-undo .
      726     define variable v-hour       as integer   no-undo .
      727     define variable v-min        as integer   no-undo .
      728     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      729     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      730     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      731     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      732     if p-mjd-diff < 0
      733     or p-mjd-diff = ?
      734     then do:
      735       return "?" .
      736     end.
      737     assign
      738       v-day-number = integer(truncate(p-mjd-diff,0))
      739       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      740     .
      741     if v-seconds > 86400
      742     then do:
      743       assign
      744         v-seconds = 86400 - 1
      745       .
      746     end.
      747     if v-seconds < 0
      748     then do:
      749       assign
      750         v-seconds = 0
      751       .
      752     end.
      753     assign
      754       v-hour = truncate(v-seconds / 3600, 0)
      755     .
      756     assign
      757       v-seconds = v-seconds modulo 3600
      758     .
      759     assign
      760       v-min = truncate(v-seconds / 60, 0)
      761     .
      762     assign
      763       v-seconds = v-seconds modulo 60
      764     .
      765     return
      766         (if v-day-number <> 0
      767           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      768           else ""
      769         )
      770       + (if v-day-number <> 0 or v-hour <> 0
      771           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      772           else ""
      773         )
      774       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      775           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      776           else ""
      777         )
      778       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      779       .
      780   end.
      781   function cur-time-string returns character
      782   :
      783     define variable v-date as date      no-undo .
      784     define variable v-time as integer   no-undo .
      785     run cur-time in this-procedure
      786       (output v-date
      787       ,output v-time
      788       ) .
      789     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      790   end.
      791   function cur-time-string-sec returns character
      792   :
      793     define variable v-date as date      no-undo .
      794     define variable v-time as integer   no-undo .
      795     run cur-time in this-procedure
      796       (output v-date
      797       ,output v-time
      798       ) .
      799     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      800   end.
      801   function cur-time-custom  returns character
      802   (input p-prefix as character
      803   ,input p-date-format as character
      804   ,input p-delimiter as character
      805   ,input p-time-format as character
      806   ,input p-suffix as character
      807   )
      808   :
      809     define variable v-date as date      no-undo .
      810     define variable v-time as integer   no-undo .
      811     run cur-time in this-procedure
      812       (output v-date
      813       ,output v-time
      814       ) .
      815     return
      816       p-prefix
      817       + string(v-date, p-date-format)
      818       + p-delimiter
      819       + string(v-time, p-time-format)
      820       + p-suffix
      821       .
      822   end.
      823   function cur-time-print  returns character
      824   :
      825     define variable v-date as date      no-undo .
      826     define variable v-time as integer   no-undo .
      827     run cur-time in this-procedure
      828       (output v-date
      829       ,output v-time
      830       ) .
      831     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      832   end.
      833   function cur-time-datetime returns datetime
      834   :
      835     define variable v-char as character no-undo .
      836     define variable v-datetime as datetime no-undo .
      837     v-char = cur-time-string().
      838     v-datetime = datetime(v-char).
      839     return  v-datetime.
      840   end.
      841   function cur-time-string-msec returns character
      842   :
      843     define variable v-date as datetime  no-undo .
      844     v-date = now.
      845     return string(v-date) .
      846   end.
      847   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      848   define variable is-temp as logical no-undo .
      849   define variable glog as logical no-undo .
      850   define variable v-obj-db-num like ub.db.db-num no-undo .
      851   DEFINE VARIABLE v-modified AS LOGICAL NO-UNDO.
      852   define buffer buf_role-db for ub.db.
      853   define buffer buf_role-sysconf for ub.sysconf.
      854   define buffer buf_role-clients for ub.clients.
      855   DEFINE BUTTON B-db
      856        IMAGE-UP FILE "btn-down-arrow":U
      857        IMAGE-DOWN FILE "btn-down-arrow":U
      858        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      859        LABEL "Btn 1"
      860        SIZE 3 BY 1.
      861   DEFINE BUTTON B-exit AUTO-GO
      862        LABEL "&Ввод"
      863        SIZE 10 BY 1
      864        BGCOLOR 8 .
      865   DEFINE BUTTON B-Help
      866        LABEL "Помо&щь"
      867        SIZE 10 BY 1
      868        BGCOLOR 8 .
      869   DEFINE BUTTON B-host
      870        IMAGE-UP FILE "btn-down-arrow":U
      871        IMAGE-DOWN FILE "btn-down-arrow":U
      872        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      873        LABEL "Btn 1"
      874        SIZE 3 BY 1.
      875   DEFINE BUTTON B-obj
      876        IMAGE-UP FILE "btn-down-arrow":U
      877        IMAGE-DOWN FILE "btn-down-arrow":U
      878        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      879        LABEL "Btn 1"
      880        SIZE 3 BY 1.
      881   DEFINE BUTTON b-quit AUTO-END-KEY
      882        LABEL "&Отмена"
      883        SIZE 10 BY 1
      884        BGCOLOR 8 .
      885   DEFINE VARIABLE CB-obj-type AS CHARACTER FORMAT "X(256)":U
      886        VIEW-AS COMBO-BOX INNER-LINES 3
      887        LIST-ITEMS "","Item 1","Item 2"
      888        DROP-DOWN-LIST
      889        SIZE 11 BY 1
      890        BGCOLOR 8  NO-UNDO.
      891   DEFINE VARIABLE E-notes AS CHARACTER
      892        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      893        SIZE 65.5 BY 3.75 NO-UNDO.
      894   DEFINE VARIABLE f-date-end AS DATE FORMAT "99/99/9999":U
      895        LABEL "по"
      896        VIEW-AS FILL-IN
      897        SIZE 12 BY 1 NO-UNDO.
      898   DEFINE VARIABLE f-date-start AS DATE FORMAT "99/99/9999":U INITIAL ?
      899        LABEL "Работает с"
      900        VIEW-AS FILL-IN
      901        SIZE 12 BY 1 NO-UNDO.
      902   DEFINE VARIABLE f-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
      903        LABEL "№ БД"
      904        VIEW-AS FILL-IN
      905        SIZE 7 BY 1
      906        BGCOLOR 8  NO-UNDO.
      907   DEFINE VARIABLE f-host-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
      908        LABEL "Фирма"
      909        VIEW-AS FILL-IN
      910        SIZE 7 BY 1
      911        BGCOLOR 8  NO-UNDO.
      912   DEFINE VARIABLE F-host-name AS CHARACTER FORMAT "X(256)":U
      913         VIEW-AS TEXT
      914        SIZE 56.5 BY .67
      915        FGCOLOR 4  NO-UNDO.
      916   DEFINE VARIABLE f-obj-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
      917        VIEW-AS FILL-IN
      918        SIZE 7 BY 1
      919        BGCOLOR 8  NO-UNDO.
      920   DEFINE VARIABLE F-obj-name AS CHARACTER FORMAT "X(256)":U
      921         VIEW-AS TEXT
      922        SIZE 56.5 BY .67
      923        FGCOLOR 4  NO-UNDO.
      924   DEFINE VARIABLE f-password AS CHARACTER FORMAT "X(10)":U
      925        LABEL "Пароль"
      926        VIEW-AS FILL-IN
      927        SIZE 12 BY 1 NO-UNDO.
      928   DEFINE VARIABLE f-staff-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      929        LABEL "Код персонала"
      930        VIEW-AS FILL-IN
      931        SIZE 11 BY 1 NO-UNDO.
      932   DEFINE VARIABLE fi-screen-pass AS CHARACTER FORMAT "X(256)":U
      933         VIEW-AS TEXT
      934        SIZE 12 BY .29
      935        BGCOLOR 15  NO-UNDO.
      936   DEFINE FRAME Dialog-Frame
      937        B-exit AT ROW 1 COL 1
      938        b-quit AT ROW 1 COL 11
      939        B-Help AT ROW 1 COL 54.88
      940        f-db-num AT ROW 3 COL 13 COLON-ALIGNED
      941        B-db AT ROW 3 COL 23
      942        f-host-code AT ROW 4.5 COL 13 COLON-ALIGNED
      943        B-host AT ROW 4.5 COL 23
      944        CB-obj-type AT ROW 6 COL 2.5 NO-LABEL
      945        f-obj-code AT ROW 6 COL 13 COLON-ALIGNED NO-LABEL
      946        B-obj AT ROW 6 COL 23
      947        f-staff-code AT ROW 8.5 COL 37 COLON-ALIGNED
      948        f-password AT ROW 10.5 COL 37 COLON-ALIGNED BLANK
      949        f-date-start AT ROW 12 COL 37 COLON-ALIGNED
      950        f-date-end AT ROW 12 COL 54 COLON-ALIGNED
      951        E-notes AT ROW 14 COL 1.5 NO-LABEL
      952        F-host-name AT ROW 4.75 COL 24 COLON-ALIGNED NO-LABEL
      953        F-obj-name AT ROW 6.25 COL 24 COLON-ALIGNED NO-LABEL
      954        fi-screen-pass AT ROW 10.58 COL 37 COLON-ALIGNED NO-LABEL
      955        SPACE(33.87) SKIP(7.50)
      956       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      957            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      958            TITLE ""
      959            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      960   ASSIGN
      961          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      962          FRAME Dialog-Frame:HIDDEN           = TRUE.
      963   ASSIGN
      964          E-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      965   ASSIGN
      966          f-db-num:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      967   ASSIGN
      968          f-host-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      969   ASSIGN
      970          f-obj-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      971   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      972   DO:
      973     APPLY "END-ERROR":U TO SELF.
      974   END.
      975   ON CHOOSE OF B-db IN FRAME Dialog-Frame
      976   DO:
      977     run proc-b-db IN THIS-PROCEDURE NO-ERROR.
      978     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      979   END.
      980   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      981   DO:
      982     IF p-mode = 'ПРОСМОТР':U THEN RETURN NO-APPLY.
      983     run proc-save IN THIS-PROCEDURE NO-ERROR.
      984     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      985     ASSIGN
      986     p-ok = YES
      987     p-staff-code = f-staff-code
      988     p-password = f-password
      989     p-date-start = f-date-start
      990     p-date-end = (IF f-date-end:VISIBLE IN FRAME Dialog-Frame THEN f-date-end ELSE p-date-end)
      991     p-db-num = (if p-db-num <> f-db-num then f-db-num else p-db-num)
      992     p-host-code = (if p-host-code <> f-host-code then f-host-code else p-host-code)
      993     p-obj-type = (if p-obj-type <> cb-obj-type then cb-obj-type else p-obj-type)
      994     p-obj-code = (if p-obj-code <> f-obj-code then f-obj-code else p-obj-code)
      995     .
      996   END.
      997   ON CHOOSE OF B-host IN FRAME Dialog-Frame
      998   DO:
      999     run proc-b-host IN THIS-PROCEDURE NO-ERROR.
     1000     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1001   END.
     1002   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
     1003   DO:
     1004     run proc-b-obj IN THIS-PROCEDURE NO-ERROR.
     1005     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1006   END.
     1007   ON ANY-KEY OF f-password IN FRAME Dialog-Frame
     1008   DO:
     1009       assign
     1010       fi-screen-pass :screen-value = fill('*':u, length(f-password :screen-value )).
     1011   END.
     1012   ON VALUE-CHANGED OF f-password IN FRAME Dialog-Frame
     1013   DO:
     1014     assign
     1015       fi-screen-pass :screen-value = fill('*':u, length(f-password :screen-value )).
     1016   END.
     1017   ON ANY-PRINTABLE OF f-staff-code IN FRAME Dialog-Frame
     1018   DO:
     1019     v-modified = YES.
     1020   END.
     1021   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1022   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1023   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1024   on help of frame Dialog-Frame
     1025   do:
     1026     run gbl/app_help.p
     1027       (input this-procedure :file-name
     1028       ,input ''
     1029       ,input ?
     1030       ) no-error.
     1031     if error-status :error then do:
     1032       message
     1033         "Ошибка при вызове помощи"
     1034         error-status :get-message(1)
     1035         view-as alert-box .
     1036     end.
     1037   end.
     1038   run minbtn-set in this-procedure .
     1039   on choose of b-help in frame Dialog-Frame
     1040   do:
     1041     apply "help":u to frame Dialog-Frame .
     1042   end.
     1043   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044   procedure minbtn-set :
     1045       do
     1046           on error undo, return error return-value
     1047           :
     1048           define variable ii              as integer       no-undo .
     1049           define variable fh              as widget-handle no-undo .
     1050           define variable hh              as widget-handle no-undo .
     1051           define variable v-h             as handle        extent 4 no-undo .
     1052           define variable v-name-button   as character     no-undo .
     1053           define variable v-help-old-x    as decimal       no-undo .
     1054           define variable v-help-old-y    as decimal       no-undo .
     1055           define variable v-help-old-size as decimal       no-undo .
     1056           define variable v-frame-width   as decimal       no-undo .
     1057           define variable jj              as integer       no-undo .
     1058           do
     1059               on error undo, return error
     1060               :
     1061               assign
     1062                   v-frame-width = frame Dialog-Frame:width - 0.3
     1063                   fh            = frame Dialog-Frame:first-child
     1064                   hh            = fh:first-child
     1065                   ii            = 1
     1066                   .
     1067               do while valid-handle(hh):
     1068                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1069                   do:
     1070                       case lc(hh:name) :
     1071                           when "b-help" then
     1072                               do:
     1073                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1074                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1075                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1076                                   hh:TOOLTIP = "Помощь" .
     1077                                   v-help-old-x = hh:column .
     1078                                   v-help-old-y = hh:row    .
     1079                                   v-help-old-size = hh:width .
     1080                                   hh:width-chars = 2.5 .
     1081                               end.
     1082                           when "b-print" then
     1083                               do:
     1084                                   hh:load-image("cmp/b-print.bmp":u) .
     1085                                   hh:TOOLTIP = "Печать" .
     1086                                   v-h[ii] = hh:handle .
     1087                                   ii = ii + 1 .
     1088                                   hh:width-chars = 3 .
     1089                               end.
     1090                           when "b-history" or
     1091                           when "b-hist" then
     1092                               do:
     1093                                   hh:load-image("cmp/b-hist.bmp":u) .
     1094                                   hh:TOOLTIP = "История" .
     1095                                   v-h[ii] = hh:handle .
     1096                                   ii = ii + 1 .
     1097                                   hh:width-chars = 3 .
     1098                               end.
     1099                           when "b-sch" then
     1100                               do:
     1101                                   hh:load-image("cmp/b-sch.bmp":u) .
     1102                                   hh:TOOLTIP = "Установка Фильтра" .
     1103                                   v-h[ii] = hh:handle .
     1104                                   ii = ii + 1 .
     1105                                   hh:width-chars = 3 .
     1106                               end.
     1107                           when "b-hist-user" then
     1108                               do:
     1109                                   hh:load-image("cmp/b-hist.bmp":u) .
     1110                                   hh:TOOLTIP = "История пользователя" .
     1111                                   ii = ii + 1 .
     1112                               end.
     1113                       end case.
     1114                   end.
     1115                   hh = hh:next-sibling.
     1116               end.
     1117               b-help:column = v-frame-width - b-help:width-chars.
     1118               jj = 0.
     1119               repeat ii = 4 to 1 by -1 :
     1120                   if valid-handle (v-h[ii] ) then
     1121                   do:
     1122                       jj  = jj + 1 .
     1123                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1124                       v-h[ii]:row    = v-help-old-y .
     1125                   end.
     1126               end.
     1127           end.
     1128       end.
     1129   end procedure.
     1130   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   ON TAB ANYWHERE
     1132   DO:
     1133   define variable ii as integer no-undo .
     1134   define variable fh as widget-handle no-undo .
     1135   define variable hh as widget-handle no-undo .
     1136   define variable v-next-widget-name as character no-undo .
     1137   if v-tab-order <> '' then do:
     1138     if self:type = "TOGGLE-BOX" then
     1139     self:BGCOLOR = ?.
     1140     assign
     1141     ii = lookup(self:name, v-tab-order).
     1142     assign
     1143     ii = ii + 1
     1144     v-next-widget-name = entry(ii, v-tab-order)
     1145     no-error .
     1146     if error-status:error then do:
     1147       assign
     1148       ii = 1
     1149       v-next-widget-name = entry( ii, v-tab-order)
     1150       .
     1151     end.
     1152     assign
     1153     fh = frame Dialog-Frame:first-child
     1154     hh = fh:first-child
     1155     .
     1156     do while valid-handle(hh):
     1157       if hh:name = v-next-widget-name then do:
     1158         if hh:sensitive  = yes
     1159         AND hh:visible = yes then do:
     1160           APPLY "ENTRY" to hh.
     1161           return no-apply.
     1162         end.
     1163         else do:
     1164           APPLY "TAB" to hh.
     1165           return no-apply.
     1166         end.
     1167       end.
     1168       hh = hh:next-sibling.
     1169     end.
     1170   end.
     1171   END.
     1172   ON BACK-TAB ANYWHERE
     1173   DO:
     1174   define variable ii as integer no-undo .
     1175   define variable fh as widget-handle no-undo .
     1176   define variable hh as widget-handle no-undo .
     1177   define variable v-next-widget-name as character no-undo .
     1178   if v-tab-order <> '' then do:
     1179     assign
     1180     ii = lookup(self:name, v-tab-order).
     1181     .
     1182     assign
     1183     ii = (if ii = 1
     1184           then  num-entries(v-tab-order)
     1185           else ii - 1
     1186           )
     1187     v-next-widget-name = entry(ii, v-tab-order)
     1188     .
     1189     assign
     1190     fh = frame Dialog-Frame:first-child
     1191     hh = fh:first-child
     1192     .
     1193     do while valid-handle(hh):
     1194       if hh:name = v-next-widget-name then do:
     1195         if hh:sensitive  = yes
     1196         AND hh:visible = yes then do:
     1197           APPLY "ENTRY" to hh.
     1198           return no-apply.
     1199         end.
     1200         else do:
     1201         APPLY "BACK-TAB" to hh.
     1202         return no-apply.
     1203         end.
     1204       end.
     1205       hh = hh:next-sibling.
     1206     end.
     1207     end.
     1208   END.
     1209   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1210   ON RETURN ANYWHERE
     1211   DO:
     1212   define variable ii as integer no-undo .
     1213   define variable fh as widget-handle no-undo .
     1214   define variable hh as widget-handle no-undo .
     1215   define variable v-next-widget-name as character no-undo .
     1216     if v-tab-order <> '' then do:
     1217       assign
     1218       ii = lookup(self:name, v-tab-order).
     1219       if ii = num-entries(v-tab-order) then do:
     1220           return no-apply.
     1221       end.
     1222       if self:type <> "BUTTON" and
     1223         self:type <> "EDITOR"  then do:
     1224         run proc-move-forward in this-procedure .
     1225         return no-apply.
     1226       end.
     1227       if self:type = "BUTTON" then do:
     1228         APPLY "CHOOSE" to self.
     1229       end.
     1230       if self:type = "TOGGLE-BOX" then
     1231       self:BGCOLOR = ?.
     1232       assign
     1233       ii = ii + 1
     1234       v-next-widget-name = entry(ii, v-tab-order)
     1235       no-error .
     1236       if error-status:error then do:
     1237         assign
     1238         ii = 1
     1239         v-next-widget-name = entry( ii, v-tab-order)
     1240         .
     1241       end.
     1242       assign
     1243       fh = frame Dialog-Frame:first-child
     1244       hh = fh:first-child
     1245       .
     1246       do while valid-handle(hh):
     1247         if hh:name = v-next-widget-name then do:
     1248           if hh:sensitive  = yes
     1249           AND hh:visible = yes then do:
     1250             APPLY "ENTRY" to hh.
     1251             return no-apply.
     1252           end.
     1253           else do:
     1254             APPLY "TAB" to hh.
     1255             return no-apply.
     1256           end.
     1257         end.
     1258         hh = hh:next-sibling.
     1259       end.
     1260     end.
     1261   END.
     1262   procedure proc-move-forward :
     1263   define variable ii as integer no-undo .
     1264   define variable fh as widget-handle no-undo .
     1265   define variable hh as widget-handle no-undo .
     1266   define variable v-next-widget-name as character no-undo .
     1267   do
     1268   on error undo, return error
     1269   :
     1270     if v-tab-order <> '' then do:
     1271       if self:type = "TOGGLE-BOX" then
     1272       self:BGCOLOR = ?.
     1273       assign
     1274       ii = lookup(self:name, v-tab-order).
     1275       assign
     1276       ii = ii + 1
     1277       v-next-widget-name = entry(ii, v-tab-order)
     1278       no-error .
     1279       if error-status:error then do:
     1280         assign
     1281         ii = 1
     1282         v-next-widget-name = entry( ii, v-tab-order)
     1283         .
     1284       end.
     1285       assign
     1286       fh = frame Dialog-Frame:first-child
     1287       hh = fh:first-child
     1288       .
     1289       do while valid-handle(hh):
     1290         if hh:name = v-next-widget-name then do:
     1291           if hh:sensitive  = yes
     1292           AND hh:visible = yes then do:
     1293             APPLY "ENTRY" to hh.
     1294             return.
     1295           end.
     1296           else do:
     1297             assign
     1298             ii = ii + 1
     1299             v-next-widget-name = entry(ii, v-tab-order)
     1300             no-error .
     1301             if error-status:error then do:
     1302               assign
     1303               ii = 1
     1304               v-next-widget-name = entry( ii, v-tab-order)
     1305               .
     1306             end.
     1307           end.
     1308         end.
     1309         hh = hh:next-sibling.
     1310       end.
     1311     end.
     1312   end.
     1313   end procedure.
     1314   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1315   on ' ' of f-date-start in frame Dialog-Frame
     1316   do:
     1317     if (can-query (self, "sensitive")
     1318        and
     1319        self :sensitive = true
     1320        )
     1321     or (can-query (self, "read-only")
     1322        and
     1323        self :read-only = false
     1324        )
     1325     then do:
     1326       assign
     1327         self :screen-value = ?
     1328       .
     1329     end.
     1330     return no-apply.
     1331   end.
     1332   on delete-character of f-date-start in frame Dialog-Frame
     1333   do:
     1334     if (can-query (self, "sensitive")
     1335        and
     1336        self :sensitive = true
     1337        )
     1338     or (can-query (self, "read-only")
     1339        and
     1340        self :read-only = false
     1341        )
     1342     then do:
     1343       assign
     1344         self :screen-value = ?
     1345       .
     1346     end.
     1347     return no-apply.
     1348   end.
     1349   on ctrl-d of f-date-start in frame Dialog-Frame
     1350   do:
     1351     define variable v-curr-sv-date as date no-undo .
     1352     if (can-query (self, "sensitive")
     1353        and
     1354        self :sensitive = true
     1355        )
     1356     or (can-query (self, "read-only")
     1357        and
     1358        self :read-only = false
     1359        )
     1360     then do:
     1361       if self :handle <> focus :handle
     1362       then do:
     1363         apply "entry":u to self .
     1364       end.
     1365       run gbl/getcurdt.p
     1366         (output v-curr-sv-date
     1367         ) .
     1368       assign
     1369         self :screen-value = string(v-curr-sv-date) .
     1370       .
     1371     end.
     1372     return no-apply.
     1373   end.
     1374   on ctrl-b of f-date-start in frame Dialog-Frame
     1375   do:
     1376     if (can-query (self, "sensitive")
     1377        and
     1378        self :sensitive = true
     1379        )
     1380     or (can-query (self, "read-only")
     1381        and
     1382        self :read-only = false
     1383        )
     1384     then do:
     1385       if self :handle <> focus :handle
     1386       then do:
     1387         apply "entry":u to self .
     1388       end.
     1389       define variable v-curr-sv-date as date no-undo .
     1390       define variable v-new-sv-date  as date no-undo .
     1391       assign
     1392         v-curr-sv-date = date(self :screen-value) no-error
     1393       .
     1394       if v-curr-sv-date = ?
     1395       then do:
     1396         run gbl/getcurdt.p
     1397           (output v-curr-sv-date
     1398           ) .
     1399       end.
     1400       if v-curr-sv-date <> ?
     1401       then do:
     1402         assign
     1403           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1404         .
     1405         assign
     1406           self :screen-value = string(v-new-sv-date) .
     1407         .
     1408       end.
     1409     end.
     1410     return no-apply .
     1411   end.
     1412   on ctrl-e of f-date-start in frame Dialog-Frame
     1413   do:
     1414     if (can-query (self, "sensitive")
     1415        and
     1416        self :sensitive = true
     1417        )
     1418     or (can-query (self, "read-only")
     1419        and
     1420        self :read-only = false
     1421        )
     1422     then do:
     1423       if self :handle <> focus :handle
     1424       then do:
     1425         apply "entry":u to self .
     1426       end.
     1427       define variable v-curr-sv-date as date no-undo .
     1428       define variable v-new-sv-date  as date no-undo .
     1429       assign
     1430         v-curr-sv-date = date(self :screen-value) no-error
     1431       .
     1432       if v-curr-sv-date = ?
     1433       then do:
     1434         run gbl/getcurdt.p
     1435           (output v-curr-sv-date
     1436           ) .
     1437       end.
     1438       if v-curr-sv-date <> ?
     1439       then do:
     1440         run gbl/lastdate.p
     1441           (input  v-curr-sv-date
     1442           ,output v-new-sv-date
     1443           ).
     1444         assign
     1445           self :screen-value = string(v-new-sv-date) .
     1446         .
     1447       end.
     1448     end.
     1449     return no-apply .
     1450   end.
     1451   on ctrl-f of f-date-start in frame Dialog-Frame
     1452   do:
     1453     if (can-query (self, "sensitive")
     1454        and
     1455        self :sensitive = true
     1456        )
     1457     or (can-query (self, "read-only")
     1458        and
     1459        self :read-only = false
     1460        )
     1461     then do:
     1462       if self :handle <> focus :handle
     1463       then do:
     1464         apply "entry":u to self .
     1465       end.
     1466       define variable v-ok            as logical   no-undo .
     1467       define variable v-curr-sv-date  as date      no-undo .
     1468       define variable v-description   as character no-undo .
     1469       assign
     1470         v-curr-sv-date = date(self :screen-value) no-error
     1471       .
     1472       if v-curr-sv-date = ?
     1473       then do:
     1474         run gbl/getcurdt.p
     1475           (output v-curr-sv-date
     1476           ) .
     1477       end.
     1478       if v-curr-sv-date <> ?
     1479       then do:
     1480         run gbl/d-inpday.w
     1481           (input ?
     1482           ,input "Выбор даты"
     1483           ,input v-description
     1484           ,input ""
     1485           ,input-output v-curr-sv-date
     1486           ,output v-ok
     1487           ).
     1488         if v-ok = true
     1489         then do:
     1490           assign
     1491             self :screen-value = string(v-curr-sv-date) .
     1492           .
     1493         end.
     1494       end.
     1495     end.
     1496     return no-apply .
     1497   end.
     1498     define MENU m-ed-date10
     1499       MENU-ITEM m-ed-date10-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1500       MENU-ITEM m-ed-date10-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1501       MENU-ITEM m-ed-date10-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1502       MENU-ITEM m-ed-date10-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1503       .
     1504     if f-date-start :POPUP-MENU in frame Dialog-Frame = ?
     1505     then do:
     1506       ASSIGN
     1507         f-date-start :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date10 :HANDLE
     1508         f-date-start :MENU-MOUSE in frame Dialog-Frame = 3
     1509       .
     1510     end.
     1511     define variable v-label-handle10 as handle no-undo .
     1512     assign
     1513       v-label-handle10 = f-date-start :side-label-handle in frame Dialog-Frame
     1514     .
     1515     if valid-handle (v-label-handle10)
     1516     then do:
     1517       if v-label-handle10 :tooltip = ""
     1518       or v-label-handle10 :tooltip = ?
     1519       then do:
     1520         assign
     1521           v-label-handle10 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1522         .
     1523       end.
     1524     end.
     1525     ON CHOOSE OF MENU-ITEM m-ed-date10-1 in menu m-ed-date10 DO:
     1526       apply "ctrl-b":U to f-date-start in frame Dialog-Frame .
     1527     END.
     1528     ON CHOOSE OF MENU-ITEM m-ed-date10-2 in menu m-ed-date10 DO:
     1529       apply "ctrl-d":U to f-date-start in frame Dialog-Frame .
     1530     END.
     1531     ON CHOOSE OF MENU-ITEM m-ed-date10-3 in menu m-ed-date10 DO:
     1532       apply "ctrl-e":U to f-date-start in frame Dialog-Frame .
     1533     END.
     1534     ON CHOOSE OF MENU-ITEM m-ed-date10-4 in menu m-ed-date10 DO:
     1535       apply "ctrl-f":U to f-date-start in frame Dialog-Frame .
     1536     END.
