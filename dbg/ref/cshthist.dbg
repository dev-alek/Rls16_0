      813   procedure prn-lib-reportviewer :
      814     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      815     define input parameter p-report-name-html as character no-undo .
      816     define input parameter p-param        as character no-undo .
      817     define variable v-excel           as character no-undo init 'TRUE' .
      818     define variable v-value-character as character no-undo .
      819     define variable v-value-integer   as character no-undo .
      820     define variable v-value-date      as date      no-undo .
      821     define variable v-value-decimal   as decimal   no-undo .
      822     define variable rep-excel         as logical   no-undo .
      823     define variable excel-string      as character no-undo .
      824     define variable v-param-type      as character no-undo .
      825     define variable v-tth             as handle    no-undo .
      826     run adm/shattri.p (
      827       input "get":U
      828       ,input  ""
      829       ,input  0
      830       ,input  'report-glob':U
      831       ,input  'rep-excel':U
      832       ,output v-value-character
      833       ,output v-value-date
      834       ,output v-value-decimal
      835       ,output v-value-integer
      836       ,output rep-excel
      837       ,output v-param-type
      838       ,INPUT-OUTPUT table-handle v-tth
      839       )  .
      840     if rep-excel then v-excel = "TRUE" .
      841     else v-excel = "FALSE" .
