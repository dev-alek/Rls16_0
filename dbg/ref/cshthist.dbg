      136     run proc-alt-f1 in this-procedure .
      137   end.
      138   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   define variable c-point  as character no-undo .
      140   define variable tbl      as character no-undo .
      141   define variable join-tbl as character no-undo .
      142   define variable fld      as character no-undo .
      143   define variable lab      as character no-undo .
      144   define variable spr      as character no-undo .
      145   define variable dim      as character no-undo .
      146   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147   procedure cur-time :
      148      define output parameter p-today as date      no-undo .
      149      define output parameter p-time  as integer   no-undo .
      150     do
      151     on error undo, return error
      152     :
      153       define variable v-date1 as date      no-undo .
      154       define variable v-date2 as date      no-undo .
      155       define variable v-time  as integer   no-undo .
      156       assign
      157         v-date1 = today
      158         v-time  = time
      159         v-date2 = today
      160       .
      161       if v-date1 <> v-date2
      162       then do:
      163         assign
      164           v-date1 = today
      165           v-time  = v-time
      166         .
      167       end.
      168       assign
      169         p-today = v-date1
      170         p-time  = v-time
      171       .
      172     end.
      173   end.
      174   function cur-time-date returns character
      175   :
      176     return string(today, '99/99/9999':U) .
      177   end.
      178   function cur-time-mjd returns decimal
      179   :
      180     define variable v-date as date      no-undo .
      181     define variable v-time as integer   no-undo .
      182     run cur-time in this-procedure
      183       (output v-date
      184       ,output v-time
      185       ) .
      186     return integer(v-date) - 2400002 + (v-time / 86400) .
      187   end.
      188   function cur-time-get-ending-index returns integer
      189   (input p-number as integer
      190   )
      191   :
      192     if p-number < 0
      193     or p-number = ?
      194     then do:
      195       return 1 .
      196     end.
      197     define variable v-rest as integer   no-undo .
      198     assign
      199       p-number = p-number modulo 100
      200     .
      201     if p-number < 20
      202     then do:
      203       assign
      204         v-rest = p-number
      205       .
      206     end.
      207     else do:
      208       assign
      209         v-rest = p-number modulo 10
      210       .
      211     end.
      212     case v-rest :
      213       when 1
      214       then do:
      215         return 2 .
      216       end.
      217       when 2 or
      218       when 3 or
      219       when 4
      220       then do:
      221         return 3 .
      222       end.
      223       otherwise do:
      224         return 1 .
      225       end.
      226     end case .
      227   end.
      228   procedure cur-time-mjd-to-date :
      229      define input  parameter i-mjd-diff as decimal no-undo.
      230      define output parameter o-Date     as date    no-undo.
      231      define output parameter o-Time     as integer no-undo.
      232      define variable v-day-number as integer   no-undo .
      233      if    i-mjd-diff < 0
      234         or i-mjd-diff = ?
      235      then do:
      236         return "?" .
      237      end.
      238      assign
      239         v-day-number = truncate(i-mjd-diff,0).
      240         o-Date = date(v-day-number + 2400002).
      241         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      242     .
      243   end.
      244   function cur-time-mjd-to-string returns character
      245   (input p-mjd-diff as decimal
      246   )
      247   :
      248     define variable v-day-number as integer   no-undo .
      249     define variable v-seconds    as integer   no-undo .
      250     define variable v-hour       as integer   no-undo .
      251     define variable v-min        as integer   no-undo .
      252     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      253     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      254     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      255     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      256     if p-mjd-diff < 0
      257     or p-mjd-diff = ?
      258     then do:
      259       return "?" .
      260     end.
      261     assign
      262       v-day-number = integer(truncate(p-mjd-diff,0))
      263       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      264     .
      265     if v-seconds > 86400
      266     then do:
      267       assign
      268         v-seconds = 86400 - 1
      269       .
      270     end.
      271     if v-seconds < 0
      272     then do:
      273       assign
      274         v-seconds = 0
      275       .
      276     end.
      277     assign
      278       v-hour = truncate(v-seconds / 3600, 0)
      279     .
      280     assign
      281       v-seconds = v-seconds modulo 3600
      282     .
      283     assign
      284       v-min = truncate(v-seconds / 60, 0)
      285     .
      286     assign
      287       v-seconds = v-seconds modulo 60
      288     .
      289     return
      290         (if v-day-number <> 0
      291           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      292           else ""
      293         )
      294       + (if v-day-number <> 0 or v-hour <> 0
      295           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      296           else ""
      297         )
      298       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      299           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      300           else ""
      301         )
      302       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      303       .
      304   end.
      305   function cur-time-string returns character
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      314   end.
      315   function cur-time-string-sec returns character
      316   :
      317     define variable v-date as date      no-undo .
      318     define variable v-time as integer   no-undo .
      319     run cur-time in this-procedure
      320       (output v-date
      321       ,output v-time
      322       ) .
      323     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      324   end.
      325   function cur-time-custom  returns character
      326   (input p-prefix as character
      327   ,input p-date-format as character
      328   ,input p-delimiter as character
      329   ,input p-time-format as character
      330   ,input p-suffix as character
      331   )
      332   :
      333     define variable v-date as date      no-undo .
      334     define variable v-time as integer   no-undo .
      335     run cur-time in this-procedure
      336       (output v-date
      337       ,output v-time
      338       ) .
      339     return
      340       p-prefix
      341       + string(v-date, p-date-format)
      342       + p-delimiter
      343       + string(v-time, p-time-format)
      344       + p-suffix
      345       .
      346   end.
      347   function cur-time-print  returns character
      348   :
      349     define variable v-date as date      no-undo .
      350     define variable v-time as integer   no-undo .
      351     run cur-time in this-procedure
      352       (output v-date
      353       ,output v-time
      354       ) .
      355     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      356   end.
      357   function cur-time-datetime returns datetime
      358   :
      359     define variable v-char as character no-undo .
      360     define variable v-datetime as datetime no-undo .
      361     v-char = cur-time-string().
      362     v-datetime = datetime(v-char).
      363     return  v-datetime.
      364   end.
      365   function cur-time-string-msec returns character
      366   :
      367     define variable v-date as datetime  no-undo .
      368     v-date = now.
      369     return string(v-date) .
      370   end.
      371   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      373   define new shared variable RepPathName        as character no-undo .
      374   define new shared variable PrintRubl          as logical   no-undo .
      375   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   define variable v-waitfram-action01         as character   no-undo .
      377   define variable v-waitfram-action02         as character   no-undo .
      378   define variable v-waitfram-action03         as character   no-undo .
      379   define variable mWaitFramTextBeg            as character   no-undo.
      380   define variable mWaitFramTextEnd            as character   no-undo.
      381   define variable mWaitFramView               as logical     no-undo.
      382   define variable mWaitProcEvent              as logical     no-undo init yes.
      383   define variable mWaitFramInterval           as integer     no-undo init 1 .
      384   define variable mWaitFramStop               as logical     no-undo.
      385   define variable mWaitFramStopUser           as logical     no-undo.
      386   define variable mWaitFramStopTimeOut        as logical     no-undo.
      387   define variable mWaitFramStartProc          as datetime-tz no-undo.
      388   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      389   define button B-WaitFramStop auto-end-key
      390        label "Стоп"
      391        size 10 by 1 tooltip "Остоновить процесс".
      392   define button B-viewProcInfo
      393        label "Информация"
      394        size 15 by 1 tooltip "Информация о процесс".
      395   define frame waitfram
      396     v-waitfram-action01 format "x(72)" no-label skip
      397     v-waitfram-action02 format "x(72)" no-label skip
      398     v-waitfram-action03 format "x(72)" no-label skip
      399     B-viewProcInfo
      400     B-WaitFramStop at row 4 col 30
      401     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      402     .
      403   define new global shared variable mBatchMode as logical no-undo init ?.
      404   define variable mFramBachModHandle as handle no-undo.
      405   mFramBachModHandle = frame waitfram:handle.
      406   define variable mFameOldVis as logical no-undo.
      407   define variable mVisCUrentVin as logical no-undo.
      408   if session:batch-mode
      409   then
      410      mBatchMode = yes.
      411   if mBatchMode = ? then do:
      412     mVisCUrentVin = current-window:visible.
      413     mFameOldVis = mFramBachModHandle:visible.
      414     mFramBachModHandle:visible  = yes.
      415     mBatchMode = mFramBachModHandle:visible ne yes.
      416     mFramBachModHandle:visible = mFameOldVis.
      417     current-window:visible = mVisCUrentVin.
      418   end.
      419    if  log-manager:logfile-name ne ?
      420     then DO:
      421         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      422         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      423         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      424     end.
      425   on choose of B-WaitFramStop in frame waitfram
      426   do:
      427     mWaitFramStop = yes.
      428     mWaitFramStopUser = yes.
      429   end.
      430   function waitfram-check-timeout returns logical():
      431      define variable vtime as int64 no-undo.
      432      if mWaitFramStopTimeOut
      433      then
      434         return yes.
      435      vtime = ( now - mWaitFramStartProc ) / 1000 .
      436      if     mWaitFramTimeOut ne ?
      437         and mWaitFramTimeOut ne 0
      438         and mWaitFramTimeOut lt vtime
      439      then do:
      440         mWaitFramStopTimeOut = yes.
      441      end.
      442      return mWaitFramStopTimeOut.
      443   end.
      444   procedure waitfram-hide :
      445     if not session:batch-mode
      446     then do
      447     on error undo, return error return-value
      448     :
      449       pause 0 before-hide .
      450       if not mBatchMode then
      451         hide frame waitfram .
      452     if     not mWaitFramView
      453        and mWaitProcEvent
      454     then
      455       process events .
      456     end.
      457   end procedure.
      458   procedure waitfram-show :
      459     define input  parameter p-message as character no-undo .
      460     define variable v-left-margin as integer   no-undo .
      461     if not session:batch-mode
      462     then do
      463     on error undo, return error return-value
      464     :
      465       if length(p-message) <= 70 then do:
      466         assign
      467           v-left-margin = integer((70 - length(p-message)) / 2)
      468         .
      469         assign
      470           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      471         .
      472         assign
      473           v-waitfram-action01 = " "
      474           v-waitfram-action02 = " "
      475                                    + fill(" ", v-left-margin)
      476                                    + p-message
      477           v-waitfram-action03 = " "
      478         .
      479       end.
      480       else do:
      481         define variable vRindex1 as integer no-undo.
      482         define variable vRindex2 as integer no-undo.
      483         vRindex1 = r-index(p-message," ",70).
      484         if vRindex1 = 0
      485         then
      486            vRindex1 = 70.
      487         if length(p-message)  <= vRindex1 + 70 then do:
      488           assign
      489             v-waitfram-action01 = " "
      490             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      491             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      492           .
      493         end.
      494         else do:
      495           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      496           if vRindex2 <= vRindex1
      497           then
      498              vRindex2 = vRindex1 + 70.
      499           assign
      500             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      501             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      502             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      503           .
      504         end.
      505       end.
      506       B-viewProcInfo:visible   in frame waitfram = no.
      507       B-viewProcInfo:sensitive in frame waitfram = no.
      508       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      509       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      510       if  (   mWaitFramView
      511          or  mWaitProcEvent)
      512          and not mBatchMode
      513       then
      514          display
      515             v-waitfram-action01 skip
      516             v-waitfram-action02 skip
      517             v-waitfram-action03 skip
      518          with frame waitfram .
      519       if     mWaitFramView
      520          then do:
      521             if     mWaitFramInterval ne ?
      522                and not mBatchMode
      523             then
      524                wait-for go of frame waitfram pause mWaitFramInterval.
      525          end.
      526          else
      527             if     mWaitProcEvent
      528                and not mBatchMode
      529             then
      530                process events .
      531     end.
      532   end procedure.
      533      procedure waitfram-show-this:
      534         define input  parameter iInterval as int64 no-undo.
      535         define variable vtime as int64 no-undo.
      536         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      537         mWaitFramInterval = iInterval.
      538         run waitfram-show (substitute("&1&2 &3&4" ,
      539                                       mWaitFramTextBeg ,
      540                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      541                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      542                                       mWaitFramTextEnd
      543                                      )
      544                           ).
      545      end.
      546      procedure WaitFramRunPause:
      547         define input  parameter iInterval as dec no-undo.
      548         define variable vStart  as datetime-tz no-undo.
      549         define variable vend    as datetime-tz no-undo.
      550         define variable vint as int64 no-undo.
      551         define variable vOk as logical no-undo.
      552         vStart = now.
      553         vend   = vStart.
      554         publish "WaitFramPause" (iInterval,output vOk).
      555         vend   =  now.
      556         vint = vend - vStart.
      557         vint = iInterval - vint / 1000.
      558         if     not mWaitFramStop
      559            and (   vint > 0
      560                 or (    not vOk
      561                     and iInterval eq ?
      562                     )
      563                 )
      564         then
      565            run waitfram-show-this (iInterval).
      566         vend   =  now.
      567         vint = vend - vStart.
      568         vint = iInterval - vint / 1000.
      569         if     not mWaitFramStop
      570            and vint > 0
      571         then do:
      572            run gbl/pause.p (vint * 1000).
      573         end.
      574         if iInterval ne ?
      575         then
      576            publish "WaitFramStop".
      577         waitfram-check-timeout().
      578      end.
      579      procedure WaitFramWaitFor:
      580         define input  parameter iInterval as dec no-undo.
      581         assign
      582            mWaitFramStartProc   = now
      583            mWaitFramStopUser    = no
      584            mWaitFramStopTimeOut = no
      585         .
      586         block-wait:
      587         do while not mWaitFramStop:
      588            run WaitFramRunPause (iInterval).
      589            if  waitfram-check-timeout()
      590            then do:
      591               leave block-wait.
      592            end.
      593         end.
      594         run waitfram-hide.
      595      end.
      596   procedure waitfram-join :
      597     define input  parameter p-line-1  as character no-undo .
      598     define input  parameter p-line-2  as character no-undo .
      599     define input  parameter p-line-3  as character no-undo .
      600     define output parameter p-message as character no-undo .
      601     do
      602     on error undo, return error return-value
      603     :
      604       assign
      605         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      606                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      607                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      608       .
      609     end.
      610   end procedure.
      611   function waitfram-join-function returns character
      612     (input p-line-1 as character
      613     ,input p-line-2 as character
      614     ,input p-line-3 as character
      615     ).
      616     define variable v-message as character no-undo .
      617     run waitfram-join in this-procedure
      618       (input  p-line-1
      619       ,input  p-line-2
      620       ,input  p-line-3
      621       ,output v-message
      622       ) .
      623     return v-message .
      624   end function .
      625   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626   procedure fltfield-clear :
      627     define output parameter loc-fld as character no-undo.
      628     define output parameter loc-lab as character no-undo .
      629     define output parameter loc-spr as character no-undo .
      630     define output parameter loc-dim as character no-undo .
      631     assign
      632       loc-fld = ""
      633       loc-lab = ""
      634       loc-spr = ""
      635       loc-dim = "0"
      636     .
      637   end procedure .
      638   procedure fltfield-add :
      639     define input        parameter par-fld as character no-undo.
      640     define input        parameter par-lab as character no-undo .
      641     define input        parameter par-spr as character no-undo .
      642     define input-output parameter loc-fld as character no-undo.
      643     define input-output parameter loc-lab as character no-undo .
      644     define input-output parameter loc-spr as character no-undo .
      645     define input-output parameter loc-dim as character no-undo .
      646     do
      647     on error undo, return error
      648     :
      649       assign
      650       loc-fld = if loc-dim = '0'
      651                 then par-fld
      652                 else (loc-fld + chr(44) + par-fld)
      653       loc-lab = if loc-dim = '0'
      654                 then par-lab
      655                 else (loc-lab + chr(44) + par-lab)
      656       loc-spr = if loc-dim = '0'
      657                 then par-spr
      658                 else (loc-spr + chr(44) + par-spr)
      659       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      660                 string(integer(if num-entries(loc-dim) > 1
      661                               then entry(2, loc-dim)
      662                               else entry(1, loc-dim)
      663                               ) + 1)
      664       no-error
      665       .
      666     end.
      667   end procedure.
