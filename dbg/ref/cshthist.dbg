      872   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      873   procedure fltopend_fltopend :
      874   define input parameter p-parent-handle as handle no-undo .
      875   define input parameter p-qh as handle no-undo .
      876   define input parameter p-flt-open-open-query  as character no-undo .
      877   define input parameter p-where-cond as character no-undo .
      878   define input parameter p-use-indFIRST-query-tail as character no-undo .
      879   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      880   define input parameter p-indexed-reposition as character no-undo .
      881     do
      882     on error undo, return error
      883     :
      884   define variable v-prepare-string as character no-undo .
      885   define variable glog as logical no-undo .
      886   assign
      887   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      888                      p-where-cond + chr(32)  +
      889                      p-use-indFIRST-query-tail + chr(32) +
      890                      p-use-ind-sort-clmn-by + chr(32) +
      891                      p-indexed-reposition
      892   .
      893   assign
      894   glog = p-qh:query-prepare(v-prepare-string) no-error .
      895   if not glog
      896   or error-status:error then do:
      897     message error-status:get-message(1) view-as alert-box .
      898     undo, return error .
      899   end.
      900   assign
      901   glog = p-qh:query-open no-error .
      902   if not glog
      903   or error-status:error then do:
      904     message error-status:get-message(1) view-as alert-box .
      905     undo, return error .
      906   end.
      907     end.
      908   end procedure.
      909   procedure fltopend_fltfindd :
      910   define input parameter p-parent-handle as handle no-undo .
      911   define input parameter p-qh as handle no-undo .
      912   define input parameter p-rowid as rowid no-undo .
      913   define input parameter p-next as logical no-undo .
      914   define input parameter p-lock as integer no-undo .
      915   define input parameter p-bh as handle no-undo .
      916   define input parameter p-where-cond as character no-undo .
      917   define input parameter p-use-index-phrase as character no-undo .
      918   define variable glog as logical no-undo .
      919   define variable v-qh as handle no-undo .
      920   define variable v-bh as handle no-undo .
      921   define variable v-recid as recid no-undo .
      922   define variable v-prepare-string as character no-undo .
      923   do
      924   on error undo, return error
      925   on stop undo, return error
      926   :
      927     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      928     create buffer v-bh for table p-bh buffer-name p-bh:name.
      929     create query v-qh.
      930     v-qh:set-buffers(v-bh).
      931     v-prepare-string = substitute("for each &1 &2 &3"
      932                                     ,v-bh:name
      933                                     ,p-where-cond
      934                                     ,p-use-index-phrase).
      935     glog = v-qh:query-prepare(v-prepare-string) no-error.
      936     if not glog then do:
      937       delete object v-qh.
      938       delete object v-bh.
      939       undo, return error .
      940     end.
      941     glog = v-qh:query-open no-error .
      942     if not glog then do:
      943       delete object v-qh.
      944       delete object v-bh.
      945       undo, return error .
      946     end.
      947     if p-next then do:
      948       v-qh:reposition-to-rowid(p-rowid) no-error .
      949       glog = v-qh:get-next( p-lock) no-error .
      950       glog = v-qh:get-next( p-lock) no-error .
      951       if not glog or v-qh:query-off-end = yes then do:
      952         glog = v-qh:get-first( p-lock) no-error .
      953       end.
      954     end.
      955     else do:
      956       glog = v-qh:get-first( p-lock) no-error .
      957     end.
      958     v-recid = v-bh:recid no-error .
      959     delete object v-qh.
      960     delete object v-bh.
      961     return string(v-recid) .
      962   end.
      963   end procedure.
      964   procedure fltopend_fltfindq :
      965   define input parameter p-parent-handle as handle no-undo .
      966   define input parameter p-qh as handle no-undo .
      967   define input parameter p-next as logical no-undo .
      968   define input parameter p-lock as integer no-undo .
      969   define input parameter p-flt-open-open-query  as character no-undo .
      970   define input parameter p-where-cond as character no-undo .
      971   define input parameter p-use-indFIRST-query-tail as character no-undo .
      972   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      973   define input parameter p-indexed-reposition as character no-undo .
      974   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      975   define variable glog as logical no-undo .
      976   define variable v-qh as handle no-undo .
      977   define variable v-bh as handle no-undo extent 18.
      978   define variable v-rowid as rowid no-undo extent 18.
      979   define variable v-ii as integer no-undo .
      980   define variable v-prepare-string as character no-undo .
      981   do
      982   on error undo, return error
      983   on stop undo, return error
      984   :
      985     create query v-qh.
      986     do v-ii = 1 to p-qh:num-buffers:
      987       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      988       assign
      989       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      990       no-error.
      991       v-qh:add-buffer(v-bh[v-ii]).
      992     end.
      993     assign
      994     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      995                       p-where-cond + chr(32)  +
      996                       p-use-indFIRST-query-tail + chr(32) +
      997                       p-use-ind-sort-clmn-by + chr(32) +
      998                       p-indexed-reposition
      999     .
     1000     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1001     if not glog then do:
     1002       delete object v-qh.
     1003       do v-ii = 1 to p-qh:num-buffers:
     1004         delete object v-bh[v-ii].
     1005       end.
     1006       undo, return error .
     1007     end.
     1008     glog = v-qh:query-open no-error .
     1009     if not glog then do:
     1010       delete object v-qh.
     1011       do v-ii = 1 to p-qh:num-buffers:
     1012         delete object v-bh[v-ii].
     1013       end.
     1014       undo, return error .
     1015     end.
     1016     if p-next then do:
     1017       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1018       glog = v-qh:get-next( p-lock) no-error .
     1019       glog = v-qh:get-next( p-lock) no-error .
     1020       if not glog or v-qh:query-off-end = yes then do:
     1021         glog = v-qh:get-first( p-lock) no-error .
     1022       end.
     1023     end.
     1024     else do:
     1025       glog = v-qh:get-first( p-lock) no-error .
     1026     end.
     1027     do v-ii = 1 to p-qh:num-buffers:
     1028       assign
     1029       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1030       no-error.
     1031     end.
     1032     delete object v-qh.
     1033     do v-ii = 1 to p-qh:num-buffers:
     1034       delete object v-bh[v-ii].
     1035     end.
     1036   end.
     1037   end procedure.
