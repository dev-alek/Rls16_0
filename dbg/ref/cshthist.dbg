     1077   FUNCTION get-all-fields returns character (p-file-name as character ):
     1078   define variable v-dop as character no-undo .
     1079     find first _file no-lock where _file._file-name = p-file-name no-error .
     1080     if not available _file then return "":U.
     1081     for each _field no-lock where
     1082              _field._file-recid = recid(_file) :
     1083       assign
     1084       v-dop = v-dop + _field._field-name + chr(44)
     1085       .
     1086     end.
     1087     return trim(v-dop).
     1088   END FUNCTION.
     1089   PROCEDURE proc-full-temp-changes :
     1090     define input  parameter p-hst-handle as handle    no-undo .
     1091     define input  parameter p-main-table as character no-undo .
     1092     define input  parameter p-field-list as character no-undo .
     1093     define input  parameter p-label-form as character no-undo .
     1094     define variable h-new-buf         as handle    no-undo .
     1095     define variable h-main-buf        as handle    no-undo .
     1096     define variable h-for-comp        as handle    no-undo .
     1097     define variable v-inform          as character no-undo .
     1098     define variable v-ind             as integer   no-undo .
     1099     define variable v-idx-field-qnty  as integer   no-undo .
     1100     define variable v-num-entries     as integer   no-undo .
     1101     define variable fh                as handle    no-undo .
     1102     define variable fh-main           as handle    no-undo .
     1103     define variable fh-old            as handle    no-undo .
     1104     define variable fh-new            as handle    no-undo .
     1105     define variable v-field-name      as character no-undo .
     1106     define variable v-field-lvl       as character no-undo .
     1107     define variable v-field-form      as character no-undo .
     1108     define variable v-search-exp      as character no-undo .
     1109     define variable v-srch-main       as character no-undo .
     1110     define variable v-word-link       as character no-undo .
     1111     define variable v-av-chip-num     as logical   no-undo .
     1112     define variable v-main-pi-fld-lst as character no-undo .
     1113     define variable v-main-fld-lst    as character no-undo .
     1114     define variable v-delim-list      as character no-undo .
     1115     define variable v-label           as character no-undo .
     1116     define variable v-old-value       as character no-undo case-sensitive.
     1117     define variable v-new-value       as character no-undo case-sensitive.
     1118     define variable v-chg-fields as character no-undo.
     1119     for each temp-changes:
     1120       delete temp-changes.
     1121     end.
     1122     if not p-hst-handle:available then do:
     1123       return .
     1124     end.
     1125     create buffer h-new-buf  for table p-hst-handle .
     1126     create buffer h-main-buf for table p-main-table .
     1127     assign
     1128       v-inform = h-main-buf:index-information(1)
     1129       v-ind    = 2
     1130     .
     1131     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1132     on error undo, return error
     1133     :
     1134       assign
     1135         v-inform = h-main-buf:index-information( v-ind )
     1136         v-ind    = v-ind + 1
     1137       .
     1138     end.
     1139     if v-inform = ?
     1140       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1141       or entry( 3, v-inform, ",":U ) <> "1":U
     1142     then do:
     1143       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1144     end.
     1145     assign
     1146       v-idx-field-qnty = num-entries( v-inform ) - 4
     1147     .
     1148     if v-idx-field-qnty < 2 then do:
     1149       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1150     end.
     1151     assign
     1152       v-srch-main   = "where":U
     1153       v-word-link   = "":U
     1154       v-av-chip-num = false
     1155       v-delim-list  = "":U
     1156     .
     1157     do v-ind = 1 to v-idx-field-qnty by 2
     1158     on error undo, return error
     1159     :
     1160       assign
     1161         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1162         fh                = p-hst-handle:buffer-field( v-field-name )
     1163         fh-main           = h-main-buf:buffer-field( v-field-name )
     1164         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1165         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1166       .
     1167       if fh:data-type ="character":U then do:
     1168         assign
     1169           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1170         .
     1171       end.
     1172       else do:
     1173         assign
     1174           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1175         .
     1176       end.
     1177       if v-delim-list = "":U then do:
     1178         assign
     1179           v-delim-list = ",":U
     1180         .
     1181       end.
     1182       if v-word-link = "":U then do:
     1183         assign
     1184           v-word-link = "and":U
     1185         .
     1186       end.
     1187     end.
     1188     assign
     1189       v-delim-list  = "":U
     1190     .
     1191     do v-ind = 1 to h-main-buf:num-fields
     1192     on error undo, return error
     1193     :
     1194       assign
     1195         fh-main      = h-main-buf:buffer-field( v-ind )
     1196         v-field-name = fh-main:name
     1197       .
     1198         assign
     1199           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1200         .
     1201         if v-delim-list = "":U then do:
     1202           assign
     1203             v-delim-list = ",":U
     1204           .
     1205         end.
     1206     end.
     1207     assign
     1208       v-inform = p-hst-handle:index-information(1)
     1209       v-ind    = 2
     1210     .
     1211     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1212     on error undo, return error
     1213     :
     1214       assign
     1215         v-inform = p-hst-handle:index-information( v-ind )
     1216         v-ind    = v-ind + 1
     1217       .
     1218     end.
     1219     if v-inform = ?
     1220       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1221       or entry( 3, v-inform, ",":U ) <> "1":U
     1222     then do:
     1223       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1224     end.
     1225     assign
     1226       v-idx-field-qnty = num-entries( v-inform ) - 4
     1227     .
     1228     if v-idx-field-qnty < 2 then do:
     1229       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1230     end.
     1231     assign
     1232       v-search-exp  = "where":U
     1233       v-word-link   = "":U
     1234       v-av-chip-num = false
     1235     .
     1236     do v-ind = 1 to v-idx-field-qnty by 2
     1237     on error undo, return error
     1238     :
     1239       assign
     1240         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1241         fh           = p-hst-handle:buffer-field( v-field-name )
     1242         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1243       .
     1244       if v-field-name = "chip-num":U then do:
     1245         assign
     1246           v-search-exp  = substitute( "&1 >", v-search-exp )
     1247           v-av-chip-num = true
     1248         .
     1249       end.
     1250       else do:
     1251         assign
     1252           v-search-exp = substitute( "&1 =", v-search-exp )
     1253         .
     1254       end.
     1255       if fh:data-type ="character":U then do:
     1256         assign
     1257           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1258         .
     1259       end.
     1260       else do:
     1261         assign
     1262           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1263         .
     1264       end.
     1265       if v-word-link = "":U then do:
     1266         assign
     1267           v-word-link = "and":U
     1268         .
     1269       end.
     1270     end.
     1271     if v-av-chip-num = false then do:
     1272       message
     1273         vss-workfile vss-revision vss-description skip
     1274         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1275         "Использование данной процедуры невозможно!" skip
     1276         view-as alert-box error .
     1277       return error .
     1278     end.
     1279     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1280     if not h-new-buf:available then do:
     1281       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1282       if not h-main-buf:available then do:
     1283         assign
     1284           h-for-comp = ?
     1285         .
     1286       end.
     1287       else do:
     1288         assign
     1289           h-for-comp = h-main-buf
     1290         .
     1291       end.
     1292     end.
     1293     else do:
     1294       assign
     1295         h-for-comp = h-new-buf
     1296       .
     1297     end.
     1298     assign
     1299       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1300     .
     1301     do v-ind = 1 to v-num-entries
     1302     on error undo, return error return-value
     1303     :
     1304       assign
     1305         v-field-name = entry( v-ind, v-main-fld-lst )
     1306         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1307         v-old-value  = fh-old:buffer-value()
     1308         v-label      = trim( fh-old:label )
     1309       .
     1310       if ( trim( p-field-list ) <> "":U
     1311            and lookup( v-field-name, p-field-list ) > 0
     1312          )
     1313          or trim( p-field-list ) = "":U
     1314       then do:
     1315         if h-for-comp <> ? then do:
     1316           assign
     1317             fh-new      = h-for-comp:buffer-field( v-field-name )
     1318             v-new-value = fh-new:buffer-value()
     1319           .
     1320         end.
     1321         else do:
     1322           assign
     1323             v-new-value = "":U
     1324           .
     1325         end.
     1326         if v-old-value <> v-new-value
     1327         then do:
     1328           create temp-changes.
     1329           assign
     1330             temp-changes.t_name = p-main-table
     1331             temp-changes.f_name = v-field-name
     1332             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1333             temp-changes.v_old  = trim( v-old-value )
     1334             temp-changes.v_new  = trim( v-new-value )
     1335             temp-changes.num_   = 0
     1336             temp-changes.fNotChange = v-old-value eq v-new-value
     1337           .
     1338         end.
     1339       end.
     1340     end.
     1341     assign
     1342       v-num-entries = num-entries( p-label-form, chr(8) )
     1343     .
     1344     do v-ind = 1 to v-num-entries
     1345     on error undo, return error return-value
     1346     :
     1347       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1348         assign
     1349           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1350           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1351           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1352         .
     1353         find first temp-changes
     1354           where temp-changes.f_name = v-field-name
     1355           no-error .
     1356         if available temp-changes then do:
     1357           if trim( v-field-lvl ) <> "":U then do:
     1358             assign
     1359               temp-changes.l_name = v-field-lvl
     1360             .
     1361           end.
     1362           if trim( v-field-form ) <> "":U then do:
     1363             assign
     1364               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1365             .
     1366             if h-for-comp <> ? then do:
     1367               assign
     1368                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1369               .
     1370             end.
     1371           end.
     1372         end.
     1373       end.
     1374       else do:
     1375         message
     1376           vss-workfile vss-revision vss-description skip
     1377           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1378           substitute( "список для поля '&1': '&2'"
     1379                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1380                       ,entry( v-ind, p-label-form, chr(8) )
     1381                     ) skip
     1382           substitute( "полный список: &2", p-label-form ) skip
     1383           view-as alert-box error .
     1384       end.
     1385     end.
     1386     delete object h-new-buf .
     1387     delete object h-main-buf .
     1388   END PROCEDURE.
     1389   FUNCTION get-action RETURNS CHARACTER
     1390     ( p-action as integer )  FORWARD.
     1391   FUNCTION get-subject RETURNS CHARACTER
     1392     ( p-subject as character )  FORWARD.
     1393   DEFINE BUTTON B-Help
     1394        LABEL "Помо&щь"
     1395        SIZE 3 BY 1
     1396        BGCOLOR 8 .
     1397   DEFINE BUTTON B-lookup
     1398        LABEL "&Просмотр"
     1399        SIZE 10 BY 1.
     1400   DEFINE BUTTON B-mark
     1401        LABEL "&*"
     1402        SIZE 3 BY 1.
     1403   DEFINE BUTTON B-print
     1404        LABEL "Пе&чать"
     1405        SIZE 3 BY 1.
     1406   DEFINE BUTTON b-quit AUTO-END-KEY
     1407        LABEL "&Выход"
     1408        SIZE 10 BY 1
     1409        BGCOLOR 8 .
     1410   DEFINE BUTTON B-sch
     1411        LABEL "&Фильтр"
     1412        SIZE 3 BY 1.
     1413   DEFINE BUTTON b-sel AUTO-GO
     1414        LABEL "Вы&бор"
     1415        SIZE 10 BY 1
     1416        BGCOLOR 8 .
     1417   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1418         VIEW-AS TEXT
     1419        SIZE 6 BY 1
     1420        FGCOLOR 4  NO-UNDO.
     1421   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1422        LABEL "Дате изменения"
     1423        VIEW-AS FILL-IN
     1424        SIZE 11 BY 1 NO-UNDO.
     1425   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1426        LABEL "пользователю"
     1427        VIEW-AS FILL-IN
     1428        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1429   DEFINE VARIABLE sch-shift-date AS DATE FORMAT "99/99/9999":U
     1430        LABEL "Дате смены"
     1431        VIEW-AS FILL-IN
     1432        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1433   DEFINE QUERY BR-changes FOR
     1434         temp-changes SCROLLING.
     1435   DEFINE QUERY br-sht-hist FOR
     1436         X_c-sht-hist SCROLLING.
     1437   DEFINE BROWSE BR-changes
     1438     QUERY BR-changes DISPLAY
     1439         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1440   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1441   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1442       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1443   DEFINE BROWSE br-sht-hist
     1444     QUERY br-sht-hist NO-LOCK DISPLAY
     1445         mark-string(recid(X_c-sht-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1446         X_c-sht-hist.shift-date FORMAT "99/99/9999":U
     1447         X_c-sht-hist.shift-name COLUMN-LABEL "№!смены" FORMAT "X(2)":U
     1448         X_c-sht-hist.shift-num COLUMN-LABEL "Пор!смены" FORMAT ">9":U
     1449         X_c-sht-hist.corr-date FORMAT "99/99/9999":U
     1450         usrfulnf(X_c-sht-hist.corr-user-name) FORMAT "X(18)":U
     1451         X_c-sht-hist.corr-user-db-num FORMAT ">>>>9":U
     1452         string(X_c-sht-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1453         get-action(X_c-sht-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1454         get-subject(X_c-sht-hist.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(15)":U
     1455         X_c-sht-hist.obj-type + string(X_c-sht-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1456     ENABLE
     1457         X_c-sht-hist.corr-date
     1458       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1459   DEFINE FRAME Dialog-Frame
     1460        b-quit AT ROW 1 COL 1
     1461        B-mark AT ROW 1 COL 11
     1462        b-sel AT ROW 1 COL 21
     1463        B-lookup AT ROW 1 COL 45
     1464        B-print AT ROW 1 COL 89
     1465        B-sch AT ROW 1 COL 92
     1466        B-Help AT ROW 1 COL 95
     1467        br-sht-hist AT ROW 2 COL 1
     1468        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1469        sch-shift-date AT ROW 13.67 COL 56.13 COLON-ALIGNED
     1470        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1471        BR-changes AT ROW 14.79 COL 1
     1472        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1473        "ПОИСК ПО" VIEW-AS TEXT
     1474             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1475             FGCOLOR 4
     1476        SPACE(89.48) SKIP(7.44)
     1477       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1478            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1479            TITLE "Полная история по смене на объекте"
     1480            CANCEL-BUTTON b-quit.
     1481   ASSIGN
     1482          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1483          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1484   ASSIGN
     1485          br-sht-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1486   ON GO OF FRAME Dialog-Frame
     1487   DO:
     1488     p-rid-list = v-rid-list.
     1489   END.
     1490   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1491   DO:
     1492     APPLY "END-ERROR":U TO SELF.
     1493   END.
     1494   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1495   DO:
     1496   define variable loc#log as logical no-undo .
     1497     if available X_c-sht-hist then do:
     1498   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1499   define variable v-str-recid14 as character no-undo .
     1500   define variable v-num-entry14 as integer   no-undo .
     1501   assign
     1502     v-str-recid14 = trim( string( recid( X_c-sht-hist ) , "->>>>>>>>>>>9":U ) )
     1503     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1504   .
     1505   if v-num-entry14 > 0 then do:
     1506     assign
     1507       entry( v-num-entry14, v-rid-list ) = "":U
     1508       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1509     .
     1510   end.
     1511   else do:
     1512     assign
     1513       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1514     .
     1515   end.
     1516       loc#log = br-sht-hist:refresh() .
     1517       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1518           loc#log = br-sht-hist:select-next-row ().
     1519           apply "VALUE-CHANGED" to br-sht-hist in frame Dialog-Frame.
     1520       end.
     1521       if num-entries( v-rid-list ) = 0
     1522       then
     1523           hide mark-num in frame Dialog-Frame.
     1524       else
     1525           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1526     end.
     1527     apply "entry" to br-sht-hist in frame Dialog-Frame.
     1528   END.
     1529   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1530   DO:
     1531       run proc-b-print in this-procedure no-error.
     1532     if error-status:error then return no-apply.
     1533   END.
     1534   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1535   DO:
     1536       run proc-b-sch in this-procedure no-error.
     1537     if error-status:error then return no-apply.
     1538   END.
     1539   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1540   DO:
     1541     if ( available X_c-sht-hist ) then do:
     1542       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1543       then
     1544       v-rid-list = string( recid( X_c-sht-hist ) ) .
     1545     end.
     1546   END.
     1547   ON MOUSE-SELECT-DBLCLICK OF br-sht-hist IN FRAME Dialog-Frame
     1548   DO:
     1549        run proc-br-sht-hist in this-procedure no-error.
     1550     if error-status:error then return no-apply.
     1551   END.
     1552   ON RETURN OF br-sht-hist IN FRAME Dialog-Frame
     1553   DO:
     1554       run proc-br-sht-hist in this-procedure no-error.
     1555     if error-status:error then return no-apply.
     1556   END.
     1557   ON VALUE-CHANGED OF br-sht-hist IN FRAME Dialog-Frame
     1558   DO:
     1559     run proc-view-changes in this-procedure no-error.
     1560   END.
     1561   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1562   DO:
     1563      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1564     if error-status:error then return no-apply.
     1565   END.
     1566   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1567   DO:
     1568     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1569     if error-status:error then return no-apply.
     1570   END.
     1571   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1572   DO:
     1573     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1574     if error-status:error then return no-apply.
     1575   END.
     1576   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1577   DO:
     1578     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1579     if error-status:error then return no-apply.
     1580   END.
     1581   ON CTRL-J OF sch-shift-date IN FRAME Dialog-Frame
     1582   DO:
     1583     run proc-find-shift-date in this-procedure(yes, input frame Dialog-Frame sch-shift-date) no-error.
     1584     if error-status:error then return no-apply.
     1585   END.
     1586   ON RETURN OF sch-shift-date IN FRAME Dialog-Frame
     1587   DO:
     1588     run proc-find-shift-date in this-procedure(no, input frame Dialog-Frame sch-shift-date) no-error.
     1589     if error-status:error then return no-apply.
     1590   END.
     1591   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1592   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1593   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1594   on help of frame Dialog-Frame
     1595   do:
     1596     run gbl/app_help.p
     1597       (input this-procedure :file-name
     1598       ,input ''
     1599       ,input ?
     1600       ) no-error.
     1601     if error-status :error then do:
     1602       message
     1603         "Ошибка при вызове помощи"
     1604         error-status :get-message(1)
     1605         view-as alert-box .
     1606     end.
     1607   end.
     1608   run minbtn-set in this-procedure .
     1609   on choose of b-help in frame Dialog-Frame
     1610   do:
     1611     apply "help":u to frame Dialog-Frame .
     1612   end.
     1613   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1614   procedure minbtn-set :
     1615       do
     1616           on error undo, return error return-value
     1617           :
     1618           define variable ii              as integer       no-undo .
     1619           define variable fh              as widget-handle no-undo .
     1620           define variable hh              as widget-handle no-undo .
     1621           define variable v-h             as handle        extent 4 no-undo .
     1622           define variable v-name-button   as character     no-undo .
     1623           define variable v-help-old-x    as decimal       no-undo .
     1624           define variable v-help-old-y    as decimal       no-undo .
     1625           define variable v-help-old-size as decimal       no-undo .
     1626           define variable v-frame-width   as decimal       no-undo .
     1627           define variable jj              as integer       no-undo .
     1628           do
     1629               on error undo, return error
     1630               :
     1631               assign
     1632                   v-frame-width = frame Dialog-Frame:width - 0.3
     1633                   fh            = frame Dialog-Frame:first-child
     1634                   hh            = fh:first-child
     1635                   ii            = 1
     1636                   .
     1637               do while valid-handle(hh):
     1638                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1639                   do:
     1640                       case lc(hh:name) :
     1641                           when "b-help" then
     1642                               do:
     1643                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1644                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1645                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1646                                   hh:TOOLTIP = "Помощь" .
     1647                                   v-help-old-x = hh:column .
     1648                                   v-help-old-y = hh:row    .
     1649                                   v-help-old-size = hh:width .
     1650                                   hh:width-chars = 2.5 .
     1651                               end.
     1652                           when "b-print" then
     1653                               do:
     1654                                   hh:load-image("cmp/b-print.bmp":u) .
     1655                                   hh:TOOLTIP = "Печать" .
     1656                                   v-h[ii] = hh:handle .
     1657                                   ii = ii + 1 .
     1658                                   hh:width-chars = 3 .
     1659                               end.
     1660                           when "b-history" or
     1661                           when "b-hist" then
     1662                               do:
     1663                                   hh:load-image("cmp/b-hist.bmp":u) .
     1664                                   hh:TOOLTIP = "История" .
     1665                                   v-h[ii] = hh:handle .
     1666                                   ii = ii + 1 .
     1667                                   hh:width-chars = 3 .
     1668                               end.
     1669                           when "b-sch" then
     1670                               do:
     1671                                   hh:load-image("cmp/b-sch.bmp":u) .
     1672                                   hh:TOOLTIP = "Установка Фильтра" .
     1673                                   v-h[ii] = hh:handle .
     1674                                   ii = ii + 1 .
     1675                                   hh:width-chars = 3 .
     1676                               end.
     1677                           when "b-hist-user" then
     1678                               do:
     1679                                   hh:load-image("cmp/b-hist.bmp":u) .
     1680                                   hh:TOOLTIP = "История пользователя" .
     1681                                   ii = ii + 1 .
     1682                               end.
     1683                       end case.
     1684                   end.
     1685                   hh = hh:next-sibling.
     1686               end.
     1687               b-help:column = v-frame-width - b-help:width-chars.
     1688               jj = 0.
     1689               repeat ii = 4 to 1 by -1 :
     1690                   if valid-handle (v-h[ii] ) then
     1691                   do:
     1692                       jj  = jj + 1 .
     1693                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1694                       v-h[ii]:row    = v-help-old-y .
     1695                   end.
     1696               end.
     1697           end.
     1698       end.
     1699   end procedure.
     1700   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1701   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1702   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1703   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1704   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1705   define variable v-diasize-current-frame-height as decimal   no-undo .
     1706   define variable v-diasize-change-size          as logical   no-undo .
     1707   define variable v-diasize-resize-button        as handle    no-undo .
     1708   define variable v-diasize-wndmax               as logical   no-undo .
     1709   define variable v-diasize-wndstore             as logical   no-undo .
     1710   define variable v-diasize-proc-name            as character no-undo .
     1711   define variable v-diasize-browse-handle        as handle    no-undo .
     1712   define variable v-diasize-browse-number        as integer   no-undo .
     1713   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1714   define temp-table temp-diasize-handle no-undo
     1715     field handle-value  as handle
     1716     field save-position as decimal
     1717     index xpk is primary unique handle-value
     1718     .
     1719   define temp-table temp-browse-handle no-undo
     1720     field browse-type   as character
     1721     field browse-number as integer
     1722     field browse-handle as handle
     1723     field original-size as decimal
     1724     index xpk is primary unique browse-type browse-number
     1725     index xie browse-type browse-handle
     1726   .
     1727   procedure diasize_change-height :
     1728     define input  parameter p-change-value  as decimal   no-undo .
     1729     define input  parameter p-move-resize   as logical   no-undo .
     1730     define variable v-field-group-handle    as handle    no-undo .
     1731     define variable v-object-handle         as handle    no-undo .
     1732     define variable v-frame-height          as decimal   no-undo .
     1733     define variable v-frame-virtual-height  as decimal   no-undo .
     1734     define variable v-browse-height         as decimal   no-undo .
     1735     define variable v-window-height         as decimal   no-undo .
     1736     define variable v-window-virtual-height as decimal   no-undo .
     1737     define variable v-change-sign           as integer   no-undo .
     1738     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1739     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1740     if p-change-value > 0
     1741     then do:
     1742       if frame Dialog-Frame :height + p-change-value
     1743           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1744       then do:
     1745         assign
     1746           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1747                           - (frame Dialog-Frame :height-chars)
     1748         .
     1749         if p-change-value <= 0
     1750         then do:
     1751           run diasize_position-resize-button in this-procedure .
     1752           return .
     1753         end.
     1754       end.
     1755     end.
     1756     if p-change-value < 0
     1757     then do:
     1758       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1759       then do:
     1760         assign
     1761           p-change-value = v-diasize-orig-frame-height
     1762                          - (frame Dialog-Frame :height-chars)
     1763         .
     1764         if p-change-value >= 0
     1765         then do:
     1766           run diasize_position-resize-button in this-procedure .
     1767           return .
     1768         end.
     1769       end.
     1770     end.
     1771     if p-change-value >= 0
     1772     then do:
     1773       assign
     1774         v-change-sign = 1
     1775       .
     1776     end.
     1777     else do:
     1778       assign
     1779         v-change-sign = -1
     1780       .
     1781     end.
     1782     assign
     1783       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1784     .
     1785     if p-change-value = 0
     1786     then do:
     1787       run diasize_position-resize-button in this-procedure .
     1788       return .
     1789     end.
     1790     move_block:
     1791     do
     1792     on error undo move_block, retry move_block
     1793     :
     1794       if retry
     1795       then do:
     1796         do
     1797         on error undo move_block, leave move_block
     1798         :
     1799           if p-change-value > 0
     1800           then do:
     1801             for each buf_temp-diasize-handle
     1802             on error undo, next
     1803             :
     1804               assign
     1805                 v-object-handle = buf_temp-diasize-handle.handle-value
     1806               .
     1807               if v-object-handle <> v-diasize-resize-button
     1808               then do:
     1809                 assign
     1810                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1811                 .
     1812               end.
     1813             end.
     1814             assign
     1815               v-diasize-browse-handle :height = v-browse-height
     1816             .
     1817             for each buf_temp-browse-handle
     1818               where buf_temp-browse-handle.browse-type = 'height':u
     1819             on error undo, next
     1820             :
     1821               assign
     1822                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1823               .
     1824             end.
     1825             assign
     1826               frame Dialog-Frame :height = v-frame-height
     1827             .
     1828             if frame Dialog-Frame :scrollable = true
     1829             then do:
     1830               assign
     1831                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1832               .
     1833             end.
     1834             run diasize_position-resize-button in this-procedure .
     1835           end.
     1836           else do:
     1837             if frame Dialog-Frame :scrollable = true
     1838             then do:
     1839               assign
     1840                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1841               .
     1842             end.
     1843             assign
     1844               frame Dialog-Frame :height = v-frame-height
     1845             .
     1846             assign
     1847               v-diasize-browse-handle :height = v-browse-height
     1848             .
     1849             for each buf_temp-browse-handle
     1850               where buf_temp-browse-handle.browse-type = 'height':u
     1851             on error undo, next
     1852             :
     1853               assign
     1854                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1855               .
     1856             end.
     1857             for each buf_temp-diasize-handle
     1858             on error undo, next
     1859             :
     1860               assign
     1861                 v-object-handle = buf_temp-diasize-handle.handle-value
     1862               .
     1863               if v-object-handle <> v-diasize-resize-button
     1864               then do:
     1865                 assign
     1866                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1867                 .
     1868               end.
     1869             end.
     1870             run diasize_position-resize-button in this-procedure .
     1871           end.
     1872           assign
     1873             v-diasize-change-size = false
     1874           .
     1875           leave move_block .
     1876         end.
     1877       end.
     1878       assign
     1879         v-diasize-need-full-display = true
     1880       .
     1881       if v-diasize-change-size = false
     1882       then do:
     1883         assign
     1884           v-diasize-change-size = true
     1885         .
     1886       end.
     1887       else do:
     1888         return .
     1889       end.
     1890       assign
     1891         v-frame-height = frame Dialog-Frame :height
     1892         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1893         v-browse-height = v-diasize-browse-handle :height
     1894       .
     1895       for each buf_temp-browse-handle
     1896         where buf_temp-browse-handle.browse-type = 'height':u
     1897       :
     1898         assign
     1899           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1900         .
     1901       end.
     1902       for each buf_temp-diasize-handle
     1903       :
     1904         delete buf_temp-diasize-handle .
     1905       end.
     1906       assign
     1907         v-field-group-handle = frame Dialog-Frame :first-child
     1908       .
     1909       do while valid-handle(v-field-group-handle)
     1910       :
     1911         assign
     1912           v-object-handle = v-field-group-handle :first-child
     1913         .
     1914         do while valid-handle(v-object-handle)
     1915         :
     1916           if  v-object-handle <> v-diasize-browse-handle :handle
     1917           and can-query(v-object-handle, "row")
     1918           and can-query(v-object-handle, "height")
     1919           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1920           then do:
     1921             find first buf_temp-browse-handle
     1922               where buf_temp-browse-handle.browse-type   = 'height':u
     1923                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1924               no-error .
     1925             if available buf_temp-browse-handle
     1926             then do:
     1927             end.
     1928             else do:
     1929               create buf_temp-diasize-handle .
     1930               assign
     1931                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1932                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1933               .
     1934             end.
     1935           end.
     1936           assign
     1937             v-object-handle = v-object-handle :next-sibling
     1938           .
     1939         end.
     1940         assign
     1941           v-field-group-handle = v-field-group-handle :next-sibling
     1942         .
     1943       end.
     1944       do with frame Dialog-Frame
     1945       :
     1946         hide v-diasize-resize-button .
     1947         assign
     1948           v-diasize-resize-button :row    = 1
     1949           v-diasize-resize-button :column = 1
     1950         .
     1951       end.
     1952       if p-change-value > 0
     1953       then do:
     1954         if frame Dialog-Frame :scrollable = true
     1955         then do:
     1956           assign
     1957             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1958             no-error .
     1959           if error-status :error
     1960           or error-status :get-message(1) <> ""
     1961           then do:
     1962             undo move_block, retry move_block .
     1963           end.
     1964         end.
     1965         assign
     1966           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1967           no-error .
     1968         if error-status :error
     1969         or error-status :get-message(1) <> ""
     1970         then do:
     1971           undo move_block, retry move_block .
     1972         end.
     1973         assign
     1974           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1975           no-error .
     1976         if error-status :error
     1977         or error-status :get-message(1) <> ""
     1978         then do:
     1979           undo move_block, retry move_block .
     1980         end.
     1981         for each buf_temp-browse-handle
     1982           where buf_temp-browse-handle.browse-type = 'height':u
     1983         on error undo move_block, retry move_block
     1984         :
     1985           assign
     1986             buf_temp-browse-handle.browse-handle :height
     1987               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1988             no-error .
     1989           if error-status :error
     1990           or error-status :get-message(1) <> ""
     1991           then do:
     1992             undo move_block, retry move_block .
     1993           end.
     1994         end.
     1995         for each buf_temp-diasize-handle
     1996         on error undo move_block, retry move_block
     1997         :
     1998           assign
     1999             v-object-handle = buf_temp-diasize-handle.handle-value
     2000           .
     2001           if v-object-handle <> v-diasize-resize-button
     2002           then do:
     2003             assign
     2004               v-object-handle :row = v-object-handle :row + p-change-value
     2005               no-error .
     2006             if error-status :error
     2007             or error-status :get-message(1) <> ""
     2008             then do:
     2009               undo move_block, retry move_block .
     2010             end.
     2011           end.
     2012         end.
     2013       end.
     2014       else do:
     2015         for each buf_temp-diasize-handle
     2016         on error undo move_block, retry move_block
     2017         :
     2018           assign
     2019             v-object-handle = buf_temp-diasize-handle.handle-value
     2020           .
     2021           if v-object-handle <> v-diasize-resize-button
     2022           then do:
     2023             assign
     2024               v-object-handle :row = v-object-handle :row + p-change-value
     2025               no-error .
     2026             if error-status :error
     2027             or error-status :get-message(1) <> ""
     2028             then do:
     2029               undo move_block, retry move_block .
     2030             end.
     2031           end.
     2032         end.
     2033         assign
     2034           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2035           no-error .
     2036         if error-status :error
     2037         or error-status :get-message(1) <> ""
     2038         then do:
     2039           undo move_block, retry move_block .
     2040         end.
     2041         for each buf_temp-browse-handle
     2042           where buf_temp-browse-handle.browse-type = 'height':u
     2043         on error undo move_block, retry move_block
     2044         :
     2045           assign
     2046             buf_temp-browse-handle.browse-handle :height
     2047               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2048             no-error .
     2049           if error-status :error
     2050           or error-status :get-message(1) <> ""
     2051           then do:
     2052             undo move_block, retry move_block .
     2053           end.
     2054         end.
     2055         assign
     2056           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2057           no-error .
     2058         if error-status :error
     2059         or error-status :get-message(1) <> ""
     2060         then do:
     2061           undo move_block, retry move_block .
     2062         end.
     2063         if frame Dialog-Frame :scrollable = true
     2064         then do:
     2065           assign
     2066             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2067             no-error .
     2068           if error-status :error
     2069           or error-status :get-message(1) <> ""
     2070           then do:
     2071             undo move_block, retry move_block .
     2072           end.
     2073         end.
     2074       end.
     2075       if p-move-resize = true
     2076       then do:
     2077         run diasize_position-resize-button in this-procedure .
     2078       end.
     2079       if v-diasize-wndstore = true
     2080       then do:
     2081         if connected("ub") = true
     2082         then do:
     2083           define variable v-cntxt-db-num        as integer   no-undo .
     2084           define variable v-cntxt-userid        as character no-undo .
     2085           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2086                                             , OUTPUT v-cntxt-userid
     2087                                             ) .
     2088           run gbl/wndsizew.p
     2089             (input  v-cntxt-db-num
     2090             ,input  v-cntxt-userid
     2091             ,input  v-diasize-proc-name
     2092             ,input  'height':u
     2093             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2094             ) .
     2095         end.
     2096       end.
     2097     end.
     2098     assign
     2099       v-diasize-change-size = false
     2100     .
     2101   end procedure.
     2102   procedure diasize_set-height :
     2103     define input  parameter p-new-height  as decimal   no-undo .
     2104     define input  parameter p-move-resize as logical   no-undo .
     2105     do
     2106     on error undo, return error return-value
     2107     :
     2108       run diasize_change-height in this-procedure
     2109         (input  (p-new-height - frame Dialog-Frame :height)
     2110         ,input  p-move-resize
     2111         ) .
     2112     end.
     2113   end procedure.
     2114   procedure diasize_change-width :
     2115     define input  parameter p-change-value as decimal   no-undo .
     2116     define input  parameter p-move-resize  as logical   no-undo .
     2117     define variable v-field-group-handle   as handle    no-undo .
     2118     define variable v-object-handle        as handle    no-undo .
     2119     define variable v-frame-width          as decimal   no-undo .
     2120     define variable v-frame-virtual-width  as decimal   no-undo .
     2121     define variable v-browse-width         as decimal   no-undo .
     2122     define variable v-window-width         as decimal   no-undo .
     2123     define variable v-window-virtual-width as decimal   no-undo .
     2124     define variable v-change-sign          as integer   no-undo .
     2125     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2126     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2127     if p-change-value > 0
     2128     then do:
     2129       if frame Dialog-Frame :width + p-change-value >
     2130           session :width-chars
     2131       then do:
     2132         assign
     2133           p-change-value = session :width-chars - frame Dialog-Frame :width
     2134         .
     2135         if p-change-value <= 0
     2136         then do:
     2137           run diasize_position-resize-button in this-procedure .
     2138           return .
     2139         end.
     2140       end.
     2141     end.
     2142     if p-change-value < 0
     2143     then do:
     2144       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2145       then do:
     2146         assign
     2147           p-change-value = v-diasize-orig-frame-width
     2148                          - frame Dialog-Frame :width
     2149         .
     2150         if p-change-value >= 0
     2151         then do:
     2152           run diasize_position-resize-button in this-procedure .
     2153           return .
     2154         end.
     2155       end.
     2156     end.
     2157     if p-change-value >= 0
     2158     then do:
     2159       assign
     2160         v-change-sign = 1
     2161       .
     2162     end.
     2163     else do:
     2164       assign
     2165         v-change-sign = -1
     2166       .
     2167     end.
     2168     assign
     2169       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2170     .
     2171     if p-change-value = 0
     2172     then do:
     2173       run diasize_position-resize-button in this-procedure .
     2174       return .
     2175     end.
     2176     move_block:
     2177     do
     2178     on error undo move_block, leave move_block
     2179     :
     2180       if retry
     2181       then do:
     2182         do
     2183         on error undo move_block, leave move_block
     2184         :
     2185           if p-change-value > 0
     2186           then do:
     2187             for each buf_temp-diasize-handle
     2188             on error undo, next
     2189             :
     2190               assign
     2191                 v-object-handle = buf_temp-diasize-handle.handle-value
     2192               .
     2193               if v-object-handle <> v-diasize-resize-button
     2194               then do:
     2195                 assign
     2196                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2197                 .
     2198               end.
     2199             end.
     2200             assign
     2201               v-diasize-browse-handle :width = v-browse-width
     2202             .
     2203             for each buf_temp-browse-handle
     2204               where buf_temp-browse-handle.browse-type = 'width':u
     2205             on error undo, next
     2206             :
     2207               assign
     2208                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2209               .
     2210             end.
     2211             assign
     2212               frame Dialog-Frame :width = v-frame-width
     2213             .
     2214             if frame Dialog-Frame :scrollable = true
     2215             then do:
     2216               assign
     2217                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2218               .
     2219             end.
     2220             run diasize_position-resize-button in this-procedure .
     2221           end.
     2222           else do:
     2223             if frame Dialog-Frame :scrollable = true
     2224             then do:
     2225               assign
     2226                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2227               .
     2228             end.
     2229             assign
     2230               frame Dialog-Frame :width = v-frame-width
     2231             .
     2232             for each buf_temp-browse-handle
     2233               where buf_temp-browse-handle.browse-type = 'width':u
     2234             on error undo, next
     2235             :
     2236               assign
     2237                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2238               .
     2239             end.
     2240             assign
     2241               v-diasize-browse-handle :width = v-browse-width
     2242             .
     2243             for each buf_temp-diasize-handle
     2244             on error undo, next
     2245             :
     2246               assign
     2247                 v-object-handle = buf_temp-diasize-handle.handle-value
     2248               .
     2249               if v-object-handle <> v-diasize-resize-button
     2250               then do:
     2251                 assign
     2252                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2253                 .
     2254               end.
     2255             end.
     2256             run diasize_position-resize-button in this-procedure .
     2257           end.
     2258           assign
     2259             v-diasize-change-size = false
     2260           .
     2261           leave move_block .
     2262         end.
     2263       end.
     2264       assign
     2265         v-diasize-need-full-display = true
     2266       .
     2267       if v-diasize-change-size = false
     2268       then do:
     2269         assign
     2270           v-diasize-change-size = true
     2271         .
     2272       end.
     2273       else do:
     2274         return .
     2275       end.
     2276       assign
     2277         v-frame-width = frame Dialog-Frame :width
     2278         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2279         v-browse-width = v-diasize-browse-handle :width
     2280       .
     2281       for each buf_temp-browse-handle
     2282         where buf_temp-browse-handle.browse-type = 'width':u
     2283       :
     2284         assign
     2285           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2286         .
     2287       end.
     2288       for each buf_temp-diasize-handle
     2289       :
     2290         delete buf_temp-diasize-handle .
     2291       end.
     2292       assign
     2293         v-field-group-handle = frame Dialog-Frame :first-child
     2294       .
     2295       do while valid-handle(v-field-group-handle)
     2296       :
     2297         assign
     2298           v-object-handle = v-field-group-handle :first-child
     2299         .
     2300         do while valid-handle(v-object-handle)
     2301         :
     2302           if  v-object-handle <> v-diasize-browse-handle :handle
     2303           and v-object-handle <> v-diasize-resize-button
     2304           and can-query(v-object-handle, "row")
     2305           and can-query(v-object-handle, "height")
     2306           and ( v-object-handle :col + v-object-handle :width
     2307                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2308               )
     2309           then do:
     2310             find first buf_temp-browse-handle
     2311               where buf_temp-browse-handle.browse-type   = 'width':u
     2312                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2313               no-error .
     2314             if available buf_temp-browse-handle
     2315             then do:
     2316             end.
     2317             else do:
     2318               create buf_temp-diasize-handle .
     2319               assign
     2320                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2321                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2322               .
     2323             end.
     2324           end.
     2325           assign
     2326             v-object-handle = v-object-handle :next-sibling
     2327           .
     2328         end.
     2329         assign
     2330           v-field-group-handle = v-field-group-handle :next-sibling
     2331         .
     2332       end.
     2333       do with frame Dialog-Frame
     2334       :
     2335         hide v-diasize-resize-button .
     2336         v-diasize-resize-button :row = 1.
     2337         v-diasize-resize-button :column = 1.
     2338       end.
     2339       if p-change-value > 0
     2340       then do:
     2341         if frame Dialog-Frame :scrollable = true
     2342         then do:
     2343           assign
     2344             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2345             no-error .
     2346           if error-status :error
     2347           or error-status :get-message(1) <> ""
     2348           then do:
     2349             undo move_block, retry move_block.
     2350           end.
     2351         end.
     2352         assign
     2353           frame Dialog-Frame :width = v-frame-width + p-change-value
     2354           no-error .
     2355         if error-status :error
     2356         or error-status :get-message(1) <> ""
     2357         then do:
     2358           undo move_block, retry move_block.
     2359         end.
     2360         assign
     2361           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2362         no-error .
     2363         if error-status :error
     2364         or error-status :get-message(1) <> ""
     2365         then do:
     2366           undo move_block, retry move_block.
     2367         end.
     2368         for each buf_temp-browse-handle
     2369           where buf_temp-browse-handle.browse-type = 'width':u
     2370         on error undo move_block, retry move_block
     2371         :
     2372           assign
     2373             buf_temp-browse-handle.browse-handle :width
     2374               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2375             no-error .
     2376           if error-status :error
     2377           or error-status :get-message(1) <> ""
     2378           then do:
     2379             undo move_block, retry move_block .
     2380           end.
     2381         end.
     2382         for each buf_temp-diasize-handle
     2383         on error undo move_block, retry move_block
     2384         :
     2385           assign
     2386             v-object-handle = buf_temp-diasize-handle.handle-value
     2387           .
     2388           if v-object-handle <> v-diasize-resize-button
     2389           then do:
     2390             assign
     2391               v-object-handle :col = v-object-handle :col + p-change-value
     2392               no-error .
     2393             if error-status :error
     2394             or error-status :get-message(1) <> ""
     2395             then do:
     2396               undo move_block, retry move_block .
     2397             end.
     2398           end.
     2399         end.
     2400       end.
     2401       else do:
     2402         for each buf_temp-diasize-handle
     2403         on error undo move_block, retry move_block
     2404         :
     2405           assign
     2406             v-object-handle = buf_temp-diasize-handle.handle-value
     2407           .
     2408           if v-object-handle <> v-diasize-resize-button
     2409           then do:
     2410             assign
     2411               v-object-handle :col = v-object-handle :col + p-change-value
     2412               no-error .
     2413             if error-status :error
     2414             or error-status :get-message(1) <> ""
     2415             then do:
     2416               undo move_block, retry move_block .
     2417             end.
     2418           end.
     2419         end.
     2420         for each buf_temp-browse-handle
     2421           where buf_temp-browse-handle.browse-type = 'width':u
     2422         on error undo move_block, retry move_block
     2423         :
     2424           assign
     2425             buf_temp-browse-handle.browse-handle :width
     2426               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2427             no-error .
     2428           if error-status :error
     2429           or error-status :get-message(1) <> ""
     2430           then do:
     2431             undo move_block, retry move_block .
     2432           end.
     2433         end.
     2434         assign
     2435           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2436           no-error .
     2437         if error-status :error
     2438         or error-status :get-message(1) <> ""
     2439         then do:
     2440           undo move_block, retry move_block.
     2441         end.
     2442         assign
     2443           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2444         no-error .
     2445         if error-status :error
     2446         or error-status :get-message(1) <> ""
     2447         then do:
     2448           undo move_block, retry move_block.
     2449         end.
     2450         if frame Dialog-Frame :scrollable = true
     2451         then do:
     2452           assign
     2453             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2454           no-error .
     2455           if error-status :error
     2456           or error-status :get-message(1) <> ""
     2457           then do:
     2458             undo move_block, retry move_block.
     2459           end.
     2460         end.
     2461       end.
     2462       if p-move-resize
     2463       then do:
     2464         run diasize_position-resize-button in this-procedure .
     2465       end.
     2466       if v-diasize-wndstore = true
     2467       then do:
     2468         if connected("ub") = true
     2469         then do:
     2470           define variable v-cntxt-db-num        as integer   no-undo .
     2471           define variable v-cntxt-userid        as character no-undo .
     2472           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2473                                             , OUTPUT v-cntxt-userid
     2474                                             ) .
     2475           run gbl/wndsizew.p
     2476             (input  v-cntxt-db-num
     2477             ,input  v-cntxt-userid
     2478             ,input  v-diasize-proc-name
     2479             ,input  'width':u
     2480             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2481             ) .
     2482         end.
     2483       end.
     2484     end.
     2485     assign
     2486       v-diasize-change-size = false
     2487     .
     2488   end procedure.
     2489   procedure diasize_set-width :
     2490     define input  parameter p-new-width  as decimal   no-undo .
     2491     define input  parameter p-move-resize as logical   no-undo .
     2492     do
     2493     on error undo, return error return-value
     2494     :
     2495       run diasize_change-width in this-procedure
     2496         (input  (p-new-width - frame Dialog-Frame :width)
     2497         ,input  p-move-resize
     2498         ) .
     2499     end.
     2500   end procedure.
     2501   procedure diasize_position-resize-button :
     2502     do with frame Dialog-Frame
     2503     :
     2504       hide v-diasize-resize-button .
     2505       assign
     2506         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2507                     - 1
     2508                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2509         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2510                     - 1
     2511                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2512       .
     2513       view v-diasize-resize-button .
     2514     end.
     2515   end procedure.
     2516   on alt-right anywhere
     2517   do:
     2518     run diasize_change-width in this-procedure
     2519       (input 1
     2520       ,input true
     2521       ) .
     2522     return no-apply .
     2523   end.
     2524   on alt-left anywhere
     2525   do:
     2526     run diasize_change-width in this-procedure
     2527       (input -1
     2528       ,input true
     2529       ) .
     2530     return no-apply .
     2531   end.
     2532   on alt-down anywhere
     2533   do:
     2534     run diasize_change-height in this-procedure
     2535       (input 1
     2536       ,input true
     2537       ) .
     2538     return no-apply .
     2539   end.
     2540   on alt-up anywhere
     2541   do:
     2542     run diasize_change-height in this-procedure
     2543       (input -1
     2544       ,input true
     2545       ) .
     2546     return no-apply .
     2547   end.
     2548   on alt-enter of frame Dialog-Frame
     2549   do:
     2550     run diasize_maximize in this-procedure
     2551       (input  ?
     2552       ).
     2553     return no-apply .
     2554   end.
     2555   procedure diasize_end-move :
     2556     do
     2557     on error undo, return error return-value
     2558     :
     2559       define variable v-row-delta as decimal   no-undo .
     2560       define variable v-col-delta as decimal   no-undo .
     2561       define variable v-new-row as decimal   no-undo .
     2562       define variable v-new-col as decimal   no-undo .
     2563       assign
     2564         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2565         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2566       .
     2567       assign
     2568         v-row-delta = v-new-row - frame Dialog-Frame :height
     2569         v-col-delta = v-new-col - frame Dialog-Frame :width
     2570       .
     2571       run diasize_change-height in this-procedure
     2572         (input v-row-delta
     2573         ,input true
     2574         ) .
     2575       run diasize_change-width in this-procedure
     2576         (input v-col-delta
     2577         ,input true
     2578         ) .
     2579     end.
     2580   end procedure.
     2581   procedure diasize_maximize :
     2582     define input  parameter p-action as logical   no-undo .
     2583     do
     2584     on error undo, return error return-value
     2585     :
     2586       if p-action = ?
     2587       then do:
     2588         if v-diasize-need-maximize = true
     2589         then do:
     2590           assign
     2591             p-action = true
     2592           .
     2593         end.
     2594         else do:
     2595           assign
     2596             p-action = false
     2597           .
     2598         end.
     2599       end.
     2600       if p-action = true
     2601       then do:
     2602         run diasize_change-height in this-procedure
     2603           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2604               - frame Dialog-Frame :height-chars
     2605           ,input true
     2606           ) .
     2607         run diasize_change-width in this-procedure
     2608           (input session :width-chars
     2609               - frame Dialog-Frame :width-chars
     2610           ,input true
     2611           ) .
     2612         assign
     2613           v-diasize-need-maximize = false
     2614         .
     2615       end.
     2616       else do:
     2617         run diasize_change-width in this-procedure
     2618           (input v-diasize-orig-frame-width
     2619               - frame Dialog-Frame :width-chars
     2620           ,input true
     2621           ) .
     2622         run diasize_change-height in this-procedure
     2623           (input v-diasize-orig-frame-height
     2624               - frame Dialog-Frame :height-chars
     2625           ,input true
     2626           ) .
     2627         assign
     2628           v-diasize-need-maximize = true
     2629         .
     2630       end.
     2631     end.
     2632   end procedure.
     2633   procedure diasize_restore-orig-size :
     2634     do
     2635     on error undo, return error return-value
     2636     :
     2637       assign
     2638         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2639         v-diasize-current-frame-height = frame Dialog-Frame :height
     2640       .
     2641       run diasize_set-height in this-procedure
     2642         (input  v-diasize-orig-frame-height
     2643         ,input  true
     2644         ) .
     2645       run diasize_set-width in this-procedure
     2646         (input  v-diasize-orig-frame-width
     2647         ,input  true
     2648         ) .
     2649     end.
     2650   end procedure.
     2651   procedure diasize_restore-current-size :
     2652     do
     2653     on error undo, return error return-value
     2654     :
     2655       run diasize_set-height in this-procedure
     2656         (input  v-diasize-current-frame-height
     2657         ,input  true
     2658         ) .
     2659       run diasize_set-width in this-procedure
     2660         (input  v-diasize-current-frame-width
     2661         ,input  true
     2662         ) .
     2663     end.
     2664   end procedure.
     2665   procedure diasize_set-browse-handle :
     2666     define input  parameter p-browse-handle as handle   no-undo .
     2667     define buffer buf_temp-browse-handle for temp-browse-handle .
     2668     do
     2669     on error undo, return error return-value
     2670     :
     2671       assign
     2672         v-diasize-browse-handle = p-browse-handle
     2673       .
     2674       for each buf_temp-browse-handle
     2675       on error undo, return error return-value
     2676       :
     2677         delete buf_temp-browse-handle .
     2678       end.
     2679     end.
     2680   end procedure.
     2681   procedure diasize_add_browse :
     2682     define input  parameter p-browse-type   as character no-undo .
     2683     define input  parameter p-browse-handle as handle    no-undo .
     2684     define buffer buf_temp-browse-handle for temp-browse-handle .
     2685     do
     2686     on error undo, return error return-value
     2687     :
     2688       assign
     2689         v-diasize-browse-number = v-diasize-browse-number + 1
     2690       .
     2691       create buf_temp-browse-handle .
     2692       assign
     2693         buf_temp-browse-handle.browse-type   = p-browse-type
     2694         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2695         buf_temp-browse-handle.browse-handle = p-browse-handle
     2696       .
     2697     end.
     2698   end procedure.
     2699   procedure diasize_init :
     2700     define variable v-default-value    as logical   no-undo .
     2701     define variable v-restore-saved    as logical   no-undo .
     2702     define variable v-resize-value-str as character no-undo .
     2703     do
     2704     on error undo, return error return-value
     2705     :
     2706       do with frame Dialog-Frame
     2707       :
     2708         assign
     2709           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2710           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2711           v-diasize-browse-handle     = browse br-sht-hist :handle
     2712         .
     2713         create button v-diasize-resize-button
     2714         assign
     2715           parent        = frame Dialog-Frame :first-child
     2716           label         = "s"
     2717           height-pixels = 16
     2718           width-pixels  = 16
     2719           visible       = true
     2720           sensitive     = true
     2721           movable       = true
     2722           triggers:
     2723             on end-move persistent run diasize_end-move in this-procedure .
     2724           end triggers.
     2725         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2726         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2727         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2728         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2729         assign
     2730           v-diasize-wndmax = false
     2731         .
     2732         if connected("ub") = true
     2733         then do:
     2734           define variable v-cntxt-db-num        as integer   no-undo .
     2735           define variable v-cntxt-userid        as character no-undo .
     2736           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2737                                             , OUTPUT v-cntxt-userid
     2738                                             ) .
     2739           run gbl/wndpar_r.p
     2740             (input  v-cntxt-db-num
     2741             ,input  v-cntxt-userid
     2742             ,input  'wndmax':U
     2743             ,output v-diasize-wndmax
     2744             ,output v-default-value
     2745             ) .
     2746         end.
     2747         assign
     2748           v-diasize-wndstore = false
     2749         .
     2750         if connected("ub") = true
     2751         then do:
     2752           run gbl/wndpar_r.p
     2753             (input  v-cntxt-db-num
     2754             ,input  v-cntxt-userid
     2755             ,input  'wndstore':U
     2756             ,output v-diasize-wndstore
     2757             ,output v-default-value
     2758             ) .
     2759         end.
     2760         assign
     2761           v-diasize-proc-name = entry(1, program-name(2), '.')
     2762         .
     2763         if v-diasize-wndstore = true
     2764         then do:
     2765           assign
     2766             v-restore-saved = false
     2767           .
     2768           if connected("ub") = true
     2769           then do:
     2770             run gbl/wndsizer.p
     2771               (input  v-cntxt-db-num
     2772               ,input  v-cntxt-userid
     2773               ,input  v-diasize-proc-name
     2774               ,input  'height':u
     2775               ,output v-resize-value-str
     2776               ) .
     2777             if v-resize-value-str <> '':U
     2778             then do:
     2779               run diasize_change-height in this-procedure
     2780                 (input  integer(v-resize-value-str)
     2781                 ,input  true
     2782                 ) .
     2783               assign
     2784                 v-restore-saved = true
     2785               .
     2786             end.
     2787           end.
     2788           if connected("ub") = true
     2789           then do:
     2790             run gbl/wndsizer.p
     2791               (input  v-cntxt-db-num
     2792               ,input  v-cntxt-userid
     2793               ,input  v-diasize-proc-name
     2794               ,input  'width':u
     2795               ,output v-resize-value-str
     2796               ) .
     2797             if v-resize-value-str <> '':U
     2798             then do:
     2799               run diasize_change-width in this-procedure
     2800                 (input  integer(v-resize-value-str)
     2801                 ,input  true
     2802                 ) .
     2803               assign
     2804                 v-restore-saved = true
     2805               .
     2806             end.
     2807           end.
     2808           if v-restore-saved <> true
     2809           then do:
     2810             if v-diasize-wndmax = true
     2811             then do:
     2812               run diasize_maximize in this-procedure
     2813                 (input  true
     2814                 ) .
     2815             end.
     2816           end.
     2817         end.
     2818         else do:
     2819           if v-diasize-wndmax = true
     2820           then do:
     2821             run diasize_maximize in this-procedure
     2822               (input  true
     2823               ) .
     2824           end.
     2825         end.
     2826       end.
     2827     end.
     2828   end procedure.
     2829   procedure diasize_need-full-display :
     2830     define output parameter p-need-full-display as logical   no-undo .
     2831     do
     2832     on error undo, return error return-value
     2833     :
     2834       assign
     2835         p-need-full-display = v-diasize-need-full-display
     2836       .
     2837       assign
     2838         v-diasize-need-full-display = false
     2839       .
     2840     end.
     2841   end procedure.
     2842   procedure get-context :
     2843      define output parameter p-db-num as integer          no-undo.
     2844      define output parameter p-user-id as character        no-undo.
     2845      define variable v-login               as character    no-undo.
     2846      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2847      define buffer buf_user-login  for ub.user-login .
     2848      do
     2849      on error undo, return error
     2850      :
     2851            FIND FIRST buf_sys-ctrl no-lock.
     2852            ASSIGN
     2853               v-login = USERID("ub")
     2854               p-db-num = buf_sys-ctrl.db-num
     2855            .
     2856            FIND FIRST buf_user-login
     2857                 WHERE buf_user-login.db-num = p-db-num
     2858                   AND buf_user-login.user-login = v-login
     2859                 no-lock
     2860                 no-error
     2861                 .
     2862            IF AVAILABLE buf_user-login
     2863            THEN DO:
     2864               assign
     2865                  p-user-id = buf_user-login.user-id
     2866               .
     2867            END.
     2868      end.
     2869   end procedure.
