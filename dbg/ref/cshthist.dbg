     4316                                 "FOR EACH X_c-sht-hist"
     4317         parameter-4-35 =
     4318           (
     4319             if (" X_c-sht-hist.obj-type = p-obj-type and X_c-sht-hist.obj-code = p-obj-code                      And X_c-sht-hist.shift-date  = p-shift-date and X_c-sht-hist.shift-num  = p-shift-num                      and X_c-sht-hist.subject = p-subject                   " + " " + where-phrase-35) <> ""
     4320             then  substitute('X_c-sht-hist.obj-type = &1&2&1 and X_c-sht-hist.obj-code = &3                      And X_c-sht-hist.shift-date  = &4 and X_c-sht-hist.shift-num  = &5                      and X_c-sht-hist.subject = &1&6&1', chr(34), p-obj-type, p-obj-code, p-shift-date, p-shift-num, p-subject )  + " " + where-phrase-35
     4321             else "true"
     4322           )
     4323         parameter-5-35 = (" " + "" + " " + "")
     4324         parameter-6-35 = if sort-phrase-35 = ''
     4325                              then
     4326           (
     4327           " " + "  " +
     4328             " " + sort-column-phrase +
     4329           " " + "  "
     4330           )
     4331                              else
     4332           (
     4333           " " + "  " +
     4334             " " + sort-column-phrase +
     4335           " " + sort-phrase-35
     4336           )
     4337         parameter-7-35 =
     4338           " indexed-reposition  "
     4339       .
     4340       do
     4341       on stop undo, leave
     4342       on error undo, leave
     4343       :
     4344         assign
     4345           l-disable-where-35 =
     4346             (" X_c-sht-hist.obj-type = p-obj-type and X_c-sht-hist.obj-code = p-obj-code                      And X_c-sht-hist.shift-date  = p-shift-date and X_c-sht-hist.shift-num  = p-shift-num                      and X_c-sht-hist.subject = p-subject                   " + " " + where-phrase-35 = "")
     4347         .
     4348         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4349                             ,input query br-sht-hist:handle
     4350                             ,input parameter-3-35
     4351                             ,input parameter-4-35
     4352                             ,input parameter-5-35
     4353                             ,input parameter-6-35
     4354                             ,input parameter-7-35
     4355                             )
     4356         .
     4357         assign
     4358           l-filter-open-35 = true
     4359         .
     4360       end.
     4361       if l-filter-open-35 = false then do:
     4362         message
     4363           "Ошибка при фильтрации / сортировке" skip
     4364           "Будут показаны записи без учета фильтра" skip
     4365           view-as alert-box .
     4366       end.
     4367       else do:
     4368           assign
     4369             l-query-was-opened = true
     4370           .
     4371       end.
     4372     end.
     4373     if l-filter-open-35 = false then do:
     4374       OPEN QUERY br-sht-hist FOR EACH X_c-sht-hist
     4375         where  X_c-sht-hist.obj-type = p-obj-type and X_c-sht-hist.obj-code = p-obj-code                      And X_c-sht-hist.shift-date  = p-shift-date and X_c-sht-hist.shift-num  = p-shift-num                      and X_c-sht-hist.subject = p-subject
     4376         indexed-reposition
     4377     .
     4378         assign
     4379           l-query-was-opened = true
     4380         .
     4381     end.
     4382   end.
     4383   else do:
     4384     assign
     4385       v-doc-rec = recid( X_c-sht-hist )
     4386     .
     4387     do
     4388     on stop undo, leave
     4389     on error undo, leave
     4390     :
     4391       if query br-sht-hist:handle:get-buffer-handle(1) = (buffer X_c-sht-hist:handle) then do:
     4392         assign
     4393         parameter-2-35 = (if p-find-next then "true":u else "false":u )
     4394         parameter-4-35 =
     4395           "where ":u +  substitute('X_c-sht-hist.obj-type = &1&2&1 and X_c-sht-hist.obj-code = &3                      And X_c-sht-hist.shift-date  = &4 and X_c-sht-hist.shift-num  = &5                      and X_c-sht-hist.subject = &1&6&1', chr(34), p-obj-type, p-obj-code, p-shift-date, p-shift-num, p-subject )  + " ":u + where-phrase-35 + " ":u + p-find-condition + " " + ""
     4396         parameter-5-35 = "  "
     4397       .
     4398         run fltopend_fltfindd in this-procedure  (
     4399                             input this-procedure:handle
     4400                             ,input query br-sht-hist:handle
     4401                             ,input rowid(X_c-sht-hist)
     4402                             ,input logical(parameter-2-35)
     4403                             ,input no-lock
     4404                             ,input (buffer X_c-sht-hist:handle)
     4405                             ,input parameter-4-35
     4406                             ,input parameter-5-35
     4407                             ) no-error.
     4408         .
     4409         assign
     4410           v-doc-rec = integer(return-value)
     4411           v-fltopend-rowid[1] = ?
     4412         .
     4413       end.
     4414       else do:
     4415         assign
     4416         parameter-2-35 = (if p-find-next then "true":u else "false":u )
     4417         parameter-3-35 =  "FOR EACH X_c-sht-hist"
     4418         parameter-4-35 =
     4419           (
     4420             if (" X_c-sht-hist.obj-type = p-obj-type and X_c-sht-hist.obj-code = p-obj-code                      And X_c-sht-hist.shift-date  = p-shift-date and X_c-sht-hist.shift-num  = p-shift-num                      and X_c-sht-hist.subject = p-subject                   " + " " + where-phrase-35) <> ""
     4421             then  substitute('X_c-sht-hist.obj-type = &1&2&1 and X_c-sht-hist.obj-code = &3                      And X_c-sht-hist.shift-date  = &4 and X_c-sht-hist.shift-num  = &5                      and X_c-sht-hist.subject = &1&6&1', chr(34), p-obj-type, p-obj-code, p-shift-date, p-shift-num, p-subject )  + " " + where-phrase-35
     4422             else "true"
     4423           )
     4424         parameter-5-35 = (" " + "" + " " + "" + " " + p-find-condition)
     4425         parameter-6-35 = if sort-phrase-35 = ''
     4426                              then
     4427           (
     4428           " " + "  " +
     4429             " " + sort-column-phrase +
     4430           " " + "  "
     4431           )
     4432                              else
     4433           (
     4434           " " + "  " +
     4435             " " + sort-column-phrase +
     4436           " " + sort-phrase-35
     4437           )
     4438         parameter-7-35 =
     4439           " indexed-reposition  "
     4440       .
     4441         run fltopend_fltfindq in this-procedure  (
     4442                             input this-procedure:handle
     4443                             ,input query br-sht-hist:handle
     4444                             ,input logical(parameter-2-35)
     4445                             ,input no-lock
     4446                             ,input parameter-3-35
     4447                             ,input parameter-4-35
     4448                             ,input parameter-5-35
     4449                             ,input parameter-6-35
     4450                             ,input parameter-7-35
     4451                             ,output v-fltopend-rowid
     4452                             ) no-error.
     4453         .
     4454         v-doc-rec = ?.
     4455       end.
     4456       assign
     4457         l-query-was-opened = true
     4458       .
     4459     end.
     4460   end.
     4461     run waitfram-hide in this-procedure .
     4462     END.
     4463   END CASE.
     4464   if not p-open-query  and v-doc-rec <> ? then
     4465   REPOSITION br-sht-hist to recid v-doc-rec No-ERROR.
     4466   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4467   query br-sht-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4468   run waitfram-hide in this-procedure .
     4469   APPLY "VALUE-CHANGED" TO br-sht-hist in frame Dialog-Frame.
     4470   APPLY "ENTRY" TO br-sht-hist.
     4471   END PROCEDURE.
     4472   PROCEDURE proc-b-print :
     4473   define variable date_string     as      char    no-undo.
     4474   define variable Line                as      char    no-undo.
     4475   define variable for-time as char.
     4476   define variable accum-count as integer.
     4477   define variable v-doc-rec as recid no-undo.
     4478   define variable v-prod as character no-undo .
     4479   define variable v-subject-chr as character no-undo .
     4480   define variable v-upd-time as character no-undo .
     4481   define variable v-obj as character no-undo .
     4482   define variable v-action-chr as character no-undo .
     4483   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     4484   DEFINE FRAME HistoryList
     4485   X_c-sht-hist.shift-date COLUMN-LABEL "Дата смены"
     4486   X_c-sht-hist.shift-num COLUMN-LABEL "№ смены"
     4487   v-action-chr FORMAT "X(10)"  COLUMN-LABEL "Действие"
     4488   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     4489   X_c-sht-hist.corr-date
     4490   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     4491   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     4492   X_c-sht-hist.corr-user-db-num
     4493   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     4494   HEADER  date_string AT 5 format "X(35)"
     4495   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4496   Line format "X(195)" AT 1
     4497   with width 232 down stream-io use-text    .
     4498   Line = fill("-", 195).
     4499   date_string = cur-time-print() .
     4500   assign
     4501   v-doc-rec = recid( X_c-sht-hist ).
     4502   DO WHILE available X_c-sht-hist :
     4503         GET prev br-sht-hist.
     4504   END.
     4505   run prn-lib-open-stream  in this-procedure (
     4506                                                input parparentProc
     4507                                               ,input 43
     4508                                               ,input yes
     4509                                               ,input no
     4510                                               ).
     4511   PUT  STREAM PrnLibStream
     4512   SPACE(25) ( frame Dialog-Frame:title )
     4513   format "x(90)" SKIP(1) .
     4514   FORM HEADER
     4515   Line format "X(180)" AT 1 SKIP
     4516   "Продолжение - на следующей странице" AT 30 SKIP
     4517   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4518   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4519   FORM with FRAME HistoryList  .
     4520   run waitfram-show in this-procedure ("Ждите...").
     4521     GET next br-sht-hist.
     4522       DO WHILE available X_c-sht-hist :
     4523         Display STREAM PrnLibStream
     4524         X_c-sht-hist.shift-date
     4525         X_c-sht-hist.shift-num
     4526         get-action(X_c-sht-hist.action) @ v-action-chr
     4527         get-subject(X_c-sht-hist.subject) @ v-subject-chr
     4528         X_c-sht-hist.corr-date
     4529         string(X_c-sht-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     4530         usrfulnf(X_c-sht-hist.corr-user-name) @ v-for-user-name
     4531         X_c-sht-hist.corr-user-db-num
     4532         X_c-sht-hist.obj-type + string(X_c-sht-hist.obj-code) @ v-obj
     4533         with FRAME HistoryList .
     4534     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     4535     assign
     4536     accum-count = accum-count + 1
     4537     .
     4538     GET next br-sht-hist.
     4539   END.
     4540   UNDERLINE  STREAM PrnLibStream
     4541   X_c-sht-hist.shift-date
     4542   X_c-sht-hist.shift-num
     4543   v-action-chr
     4544   v-subject-chr
     4545   X_c-sht-hist.corr-date
     4546   v-upd-time
     4547   v-for-user-name
     4548   X_c-sht-hist.corr-user-db-num
     4549   v-obj
     4550   with FRAME HistoryList .
     4551   DISPLAY STREAM PrnLibStream
     4552   "ИТОГО"  @ X_c-sht-hist.shift-date
     4553   string(accum-count)  @ v-action-chr
     4554   with frame HistoryList.
     4555   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4556   HIDE  STREAM PrnLibStream FRAME CheckList.
     4557   output  STREAM PrnLibStream CLOSE.
     4558   run waitfram-hide in this-procedure.
     4559   run prn-lib-prn-file in this-procedure (
     4560                                             input parparentproc
     4561                                             ,input 8
     4562                                             ).
     4563   reposition br-sht-hist to recid v-doc-rec no-error.
     4564   apply "entry" to br-sht-hist in frame Dialog-Frame.
     4565   END PROCEDURE.
     4566   PROCEDURE proc-b-sch :
     4567   assign
     4568     tbl = 'c-sht-hist'
     4569     join-tbl = 'X_c-sht-hist'
     4570     fld = ""
     4571     lab = ""
     4572     spr = ""
     4573     dim = '0'
     4574     .
     4575   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     4576   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4577   run fltfield-add in this-procedure('shift-date', 'Дата смены', '',
     4578   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4579   run fltfield-add in this-procedure('shift-num', '№ смены', '',
     4580   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4581   run fltfield-add in this-procedure('corr-date', '', '',
     4582   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4583   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4584   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4585   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4586   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4587   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4588   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4589   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'sht-hist-subject',
     4590   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4591   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4592   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4593   Filter-Block:
     4594   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4595       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4596       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4597     run gbl/filter.w ( INPUT parparentproc
     4598                       ,INPUT (filter-point + chr(4) + filter-label + chr(4) + 'yes':U)
     4599                       ,INPUT tbl
     4600                       ,INPUT join-tbl
     4601                       ,INPUT fld
     4602                       ,INPUT lab
     4603                       ,INPUT spr
     4604                       ,INPUT dim ).
     4605     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4606   END.
     4607   END PROCEDURE.
     4608   PROCEDURE proc-br-sht-hist :
     4609   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4610   if b-sel:sensitive in frame Dialog-Frame then dO:
     4611       if b-mark:sensitive then do:
     4612           apply "choose" to b-mark in frame Dialog-Frame.
     4613       end.
     4614       else do:
     4615           apply "choose" to b-sel in frame Dialog-Frame.
     4616       end.
     4617   end.
     4618   else do:
     4619       if b-lookup:sensitive then
     4620       apply "choose" to b-lookup in frame Dialog-Frame.
     4621   end.
     4622   END PROCEDURE.
     4623   PROCEDURE proc-find-corr-date :
     4624   define input parameter p-next as logical no-undo.
     4625   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4626   define variable v-date-chr as character no-undo.
     4627   if p-date = ? then return .
     4628   assign
     4629   sch-shift-date = ?.
     4630   display
     4631   sch-shift-date
     4632   "":U @ sch-corr-user-name
     4633   with frame Dialog-Frame.
     4634   assign
     4635   v-date-chr = string(day(p-date)) + chr(47) +
     4636                    string(month(p-date)) + chr(47) +
     4637                    string(year(p-date)).
     4638          run OpenBr in this-procedure
     4639           (input false
     4640           ,input true
     4641           ,input substitute("and X_c-sht-hist.corr-date = &1 "
     4642             , v-date-chr)
     4643           ).
     4644         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4645   END PROCEDURE.
     4646   PROCEDURE proc-find-shift-date :
     4647   define input parameter p-next as logical no-undo.
     4648   define input parameter p-shift-date like ub.c-sht-hist.shift-date no-undo.
     4649   define variable v-shift-date as character no-undo.
     4650   if p-shift-date = ? then return.
     4651   assign
     4652   sch-corr-date = ?.
     4653   display
     4654   "":U @ sch-corr-user-name
     4655   sch-corr-date
     4656   with frame Dialog-Frame.
     4657   assign
     4658   v-shift-date = string(day(p-shift-date)) + chr(47) +
     4659                    string(month(p-shift-date)) + chr(47) +
     4660                    string(year(p-shift-date)).
     4661   run OpenBr in this-procedure
     4662       (input false
     4663       ,input p-next
     4664       ,input substitute("and X_c-sht-hist.shift-date = &1 "
     4665         , v-shift-date)
     4666       ).
     4667   apply "entry":u to sch-shift-date in frame Dialog-Frame .
     4668   END PROCEDURE.
     4669   PROCEDURE proc-find-user :
     4670   define input parameter p-next as logical no-undo.
     4671   define input parameter p-user like ub.c-sht-hist.corr-user-name no-undo.
     4672   assign
     4673   sch-corr-date = ?
     4674   sch-shift-date = ?
     4675   .
     4676   display
     4677   sch-corr-date
     4678   sch-shift-date
     4679   with frame Dialog-Frame.
     4680   p-user = chr(34) + p-user + chr(34).
     4681   run OpenBr in this-procedure
     4682       (input false
     4683       ,input p-next
     4684       ,input substitute("and X_c-sht-hist.corr-user-name = &1 "
     4685         , p-user)
     4686       ).
     4687   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4688   END PROCEDURE.
     4689   PROCEDURE proc-view-changes :
     4690   define variable v-description as character no-undo .
     4691   for each temp-changes:
     4692       delete temp-changes.
     4693   END.
     4694   if not available X_c-sht-hist then do:
     4695     Open QUery br-changes for each temp-changes.
     4696     return.
     4697   end.
     4698   run ref/cshthisv.p (
     4699                      input X_c-sht-hist.obj-type
     4700                     ,input X_c-sht-hist.obj-code
     4701                     ,input X_c-sht-hist.shift-date
     4702                     ,input X_c-sht-hist.shift-num
     4703                     ,input X_c-sht-hist.chip-num
     4704                     ,input X_c-sht-hist.corr-user-db-num
     4705                     ,input X_c-sht-hist.subject
     4706                     ,input X_c-sht-hist.action
     4707                     ,input no
     4708                     ,output v-description
     4709                  ) no-error .
     4710   Open QUery br-changes for each temp-changes.
     4711   assign
     4712   br-changes:title in frame Dialog-Frame = v-description
     4713   .
     4714   END PROCEDURE.
     4715   FUNCTION get-action RETURNS CHARACTER
     4716     ( p-action as integer ) :
     4717     define variable dops as character no-undo.
     4718   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4719   RETURN dops.
     4720   END FUNCTION.
     4721   FUNCTION get-subject RETURNS CHARACTER
     4722     ( p-subject as character ) :
     4723     RETURN entry (lookup (p-subject, 'shift-obj,shift-staff':U), 'Смена,Персонал смены':U).
     4724   END FUNCTION.
