      141   DEFINE BUTTON B-exit AUTO-GO
      142        LABEL "&Ввод"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE BUTTON B-Help
      146        LABEL "Помо&щь"
      147        SIZE 10 BY 1
      148        BGCOLOR 8 .
      149   DEFINE BUTTON B-Hist
      150        LABEL "Ис&тория"
      151        SIZE 10 BY 1
      152        BGCOLOR 8 .
