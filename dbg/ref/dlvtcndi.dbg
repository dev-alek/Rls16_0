      157   DEFINE VARIABLE F-cond-keep-name AS CHARACTER FORMAT "X(50)"
      158        LABEL "Название условий хранения"
      159        VIEW-AS FILL-IN
      160        SIZE 63 BY 1 NO-UNDO.
      161   DEFINE VARIABLE F-deliv-type-name AS CHARACTER FORMAT "X(50)"
      162        LABEL "Название типа доставки"
      163        VIEW-AS FILL-IN
      164        SIZE 63 BY 1.
      165   DEFINE QUERY Dialog-Frame FOR
      166         tt-deliv-type-cond-keep,
      167         tt-condition-keeping SCROLLING.
      168   DEFINE FRAME Dialog-Frame
      169        B-exit AT ROW 1 COL 1
      170        b-quit AT ROW 1 COL 11
      171        B-Hist AT ROW 1 COL 51
      172        B-Help AT ROW 1 COL 61
      173        tt-deliv-type-cond-keep.deliv-type-code AT ROW 3 COL 34 COLON-ALIGNED
      174             LABEL "Внутр.код типа доставки"
      175             VIEW-AS FILL-IN
      176             SIZE 11 BY 1
      177        B-deliv-type AT ROW 3 COL 47.5
      178        F-deliv-type-name AT ROW 4.25 COL 34 COLON-ALIGNED
      179        tt-deliv-type-cond-keep.cond-keep-code AT ROW 5.5 COL 34 COLON-ALIGNED
      180             LABEL "Вн.код условий хранения"
      181             VIEW-AS FILL-IN
      182             SIZE 11 BY 1
      183        b-cond-keep AT ROW 5.5 COL 47.5
      184        F-cond-keep-name AT ROW 6.75 COL 34 COLON-ALIGNED
      185        tt-deliv-type-cond-keep.des AT ROW 10 COL 1 NO-LABEL
      186             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      187             SIZE 98 BY 3.75
      188        "Описание" VIEW-AS TEXT
      189             SIZE 16 BY 1 AT ROW 8.75 COL 1.5
      190        SPACE(81.74) SKIP(4.49)
      191       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      192            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      193            TITLE "Возможности доставки по условиям хранения"
      194            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      195   ASSIGN
      196          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      197          FRAME Dialog-Frame:HIDDEN           = TRUE.
      198   ASSIGN
      199          F-cond-keep-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      200   ASSIGN
      201          F-deliv-type-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      202   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      203   DO:
      204     APPLY "END-ERROR":U TO SELF.
      205   END.
      206   ON CHOOSE OF b-cond-keep IN FRAME Dialog-Frame
      207   DO:
      208      define variable v-rid-list as character no-undo.
      209      define variable v-sts as integer no-undo.
      210   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      211   if lookup(self :type
      212            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      213            ) = 0
      214   then do:
      215     message
      216       "$Workfile$"
      217       "Указанному интерфейсному элементу фокус не может быть передан" skip
      218       "Интерфейсный элемент" self :name  skip
      219       "Тип" self :type  skip
      220       "Процедура" this-procedure :file-name skip
      221       view-as alert-box .
      222   end.
      223   else do:
      224     apply "entry":u to self  .
      225     if focus :handle <> self :handle  then do:
      226       return no-apply .
      227     end.
      228   end.
      229   if available locked_condition-keeping then
      230   assign
      231   v-rid-list = string(recid(locked_condition-keeping))
      232   v-sts = locked_condition-keeping.sts
      233   .
      234   run ref/cndkeeps.w (input parParentProc
      235                 , p-curr-obj-type
      236                 , p-curr-obj-code
      237                 , "b-sel":U
      238                 , 'все':U
      239                 , input-output v-sts
      240                 , input-output v-rid-list ) no-error .
      241   if v-rid-list <> "":U then do:
      242       FIND FIRST locked_condition-keeping WHERE
      243           recid( locked_condition-keeping ) = integer(entry(1, v-rid-list)) NO-LOCK .
      244       assign
      245       tt-deliv-type-cond-keep.cond-keep-code = locked_condition-keeping.cond-keep-code
      246       f-cond-keep-name = locked_condition-keeping.cond-keep-name
      247   .
      248       display
      249       tt-deliv-type-cond-keep.cond-keep-code
      250       f-cond-keep-name
      251       with frame Dialog-Frame .
      252   end.
      253   END.
      254   ON CHOOSE OF B-deliv-type IN FRAME Dialog-Frame
      255   DO:
      256     define variable v-rid-list as character no-undo.
      257     define variable v-sts as integer no-undo .
      258   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      259   if lookup(self :type
      260            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      261            ) = 0
      262   then do:
      263     message
      264       "$Workfile$"
      265       "Указанному интерфейсному элементу фокус не может быть передан" skip
      266       "Интерфейсный элемент" self :name  skip
      267       "Тип" self :type  skip
      268       "Процедура" this-procedure :file-name skip
      269       view-as alert-box .
      270   end.
      271   else do:
      272     apply "entry":u to self  .
      273     if focus :handle <> self :handle  then do:
      274       return no-apply .
      275     end.
      276   end.
      277   if available locked_delivery-type then
      278   assign
      279   v-rid-list = string(recid(locked_delivery-type))
      280   v-sts   = locked_delivery-type.sts
      281   .
      282   run ref/dlvtypes.w (input parParentProc
      283                 , p-curr-obj-type
      284                 , p-curr-obj-code
      285                 , "b-sel":U
      286                 , 'все':U
      287                 , input-output v-sts
      288                 , input-output v-rid-list ) no-error .
      289   if v-rid-list <> "":U then do:
      290       FIND FIRST locked_delivery-type WHERE
      291           recid( locked_delivery-type ) = integer(entry(1, v-rid-list)) NO-LOCK .
      292       assign
      293       tt-deliv-type-cond-keep.deliv-type-code = locked_delivery-type.deliv-type-code
      294       f-deliv-type-name = locked_delivery-type.deliv-type-name
      295   .
      296       display
      297       tt-deliv-type-cond-keep.deliv-type-code
      298       f-deliv-type-name
      299       with frame Dialog-Frame .
      300   end.
      301   END.
      302   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      303   DO:
      304       run proc-save in this-procedure no-error.
      305     if error-status:error then return no-apply.
      306   END.
      307   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      308   DO:
      309     define variable v-rid-list as character no-undo.
      310       run ref/dlvctcns.w
      311                   (
      312                    input parParentProc
      313                   ,INPUT p-curr-obj-type
      314                   ,INPUT p-curr-obj-code
      315                   ,input "":U
      316                   ,input "one":U
      317                   ,input locked_deliv-type-cond-keep.deliv-type-code
      318                   ,input locked_deliv-type-cond-keep.cond-keep-code
      319                   ,input-output v-rid-list
      320                                 )
      321    .
      322   END.
      323   ON LEAVE OF tt-deliv-type-cond-keep.cond-keep-code IN FRAME Dialog-Frame
      324   DO:
      325    assign
      326   tt-deliv-type-cond-keep.cond-keep-code.
      327   FIND FIRST locked_condition-keeping WHERE
      328            locked_condition-keeping.cond-keep-code  = tt-deliv-type-cond-keep.cond-keep-code
      329    NO-LOCK NO-error.
      330   if not available locked_condition-keeping then do:
      331     assign
      332     tt-deliv-type-cond-keep.cond-keep-code = ?
      333     f-cond-keep-name = "":U
      334     .
      335       display
      336       tt-deliv-type-cond-keep.cond-keep-code
      337       f-cond-keep-name
      338       with frame Dialog-Frame.
      339       .
      340   end.
      341   else do:
      342       assign
      343       f-cond-keep-name = locked_condition-keeping.cond-keep-name
      344       .
      345       display
      346       tt-deliv-type-cond-keep.cond-keep-code
      347       f-cond-keep-name
      348       with frame Dialog-Frame.
      349       .
      350   end.
      351   END.
      352   ON LEAVE OF tt-deliv-type-cond-keep.deliv-type-code IN FRAME Dialog-Frame
      353   DO:
      354     assign
      355   tt-deliv-type-cond-keep.deliv-type-code.
      356   FIND FIRST locked_delivery-type WHERE
      357            locked_delivery-type.deliv-type-code  = tt-deliv-type-cond-keep.deliv-type-code
      358    NO-LOCK NO-error.
      359   if not available locked_delivery-type then do:
      360     assign
      361     tt-deliv-type-cond-keep.deliv-type-code = ?
      362     f-deliv-type-name = "":U
      363     .
      364       display
      365       tt-deliv-type-cond-keep.deliv-type-code
      366       f-deliv-type-name
      367       with frame Dialog-Frame.
      368       .
      369   end.
      370   else do:
      371       assign
      372       f-deliv-type-name = locked_delivery-type.deliv-type-name
      373       .
      374       display
      375       tt-deliv-type-cond-keep.deliv-type-code
      376       f-deliv-type-name
      377       with frame Dialog-Frame.
      378       .
      379   end.
      380   END.
      381   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      382   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      383   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   on help of frame Dialog-Frame
      385   do:
      386     run gbl/app_help.p
      387       (input this-procedure :file-name
      388       ,input ''
      389       ,input ?
      390       ) no-error.
      391     if error-status :error then do:
      392       message
      393         "Ошибка при вызове помощи"
      394         error-status :get-message(1)
      395         view-as alert-box .
      396     end.
      397   end.
      398   run minbtn-set in this-procedure .
      399   on choose of b-help in frame Dialog-Frame
      400   do:
      401     apply "help":u to frame Dialog-Frame .
      402   end.
      403   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      404   procedure minbtn-set :
      405       do
      406           on error undo, return error return-value
      407           :
      408           define variable ii              as integer       no-undo .
      409           define variable fh              as widget-handle no-undo .
      410           define variable hh              as widget-handle no-undo .
      411           define variable v-h             as handle        extent 4 no-undo .
      412           define variable v-name-button   as character     no-undo .
      413           define variable v-help-old-x    as decimal       no-undo .
      414           define variable v-help-old-y    as decimal       no-undo .
      415           define variable v-help-old-size as decimal       no-undo .
      416           define variable v-frame-width   as decimal       no-undo .
      417           define variable jj              as integer       no-undo .
      418           do
      419               on error undo, return error
      420               :
      421               assign
      422                   v-frame-width = frame Dialog-Frame:width - 0.3
      423                   fh            = frame Dialog-Frame:first-child
      424                   hh            = fh:first-child
      425                   ii            = 1
      426                   .
      427               do while valid-handle(hh):
      428                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      429                   do:
      430                       case lc(hh:name) :
      431                           when "b-help" then
      432                               do:
      433                                   hh:load-image-up("cmp/b-help.bmp":u) .
      434                                   hh:load-image-down("cmp/b-help.bmp":u) .
      435                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      436                                   hh:TOOLTIP = "Помощь" .
      437                                   v-help-old-x = hh:column .
      438                                   v-help-old-y = hh:row    .
      439                                   v-help-old-size = hh:width .
      440                                   hh:width-chars = 2.5 .
      441                               end.
      442                           when "b-print" then
      443                               do:
      444                                   hh:load-image("cmp/b-print.bmp":u) .
      445                                   hh:TOOLTIP = "Печать" .
      446                                   v-h[ii] = hh:handle .
      447                                   ii = ii + 1 .
      448                                   hh:width-chars = 3 .
      449                               end.
      450                           when "b-history" or
      451                           when "b-hist" then
      452                               do:
      453                                   hh:load-image("cmp/b-hist.bmp":u) .
      454                                   hh:TOOLTIP = "История" .
      455                                   v-h[ii] = hh:handle .
      456                                   ii = ii + 1 .
      457                                   hh:width-chars = 3 .
      458                               end.
      459                           when "b-sch" then
      460                               do:
      461                                   hh:load-image("cmp/b-sch.bmp":u) .
      462                                   hh:TOOLTIP = "Установка Фильтра" .
      463                                   v-h[ii] = hh:handle .
      464                                   ii = ii + 1 .
      465                                   hh:width-chars = 3 .
      466                               end.
      467                           when "b-hist-user" then
      468                               do:
      469                                   hh:load-image("cmp/b-hist.bmp":u) .
      470                                   hh:TOOLTIP = "История пользователя" .
      471                                   ii = ii + 1 .
      472                               end.
      473                       end case.
      474                   end.
      475                   hh = hh:next-sibling.
      476               end.
      477               b-help:column = v-frame-width - b-help:width-chars.
      478               jj = 0.
      479               repeat ii = 4 to 1 by -1 :
      480                   if valid-handle (v-h[ii] ) then
      481                   do:
      482                       jj  = jj + 1 .
      483                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      484                       v-h[ii]:row    = v-help-old-y .
      485                   end.
      486               end.
      487           end.
      488       end.
      489   end procedure.
      490   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      491   ON TAB ANYWHERE
      492   DO:
      493   define variable ii as integer no-undo .
      494   define variable fh as widget-handle no-undo .
      495   define variable hh as widget-handle no-undo .
      496   define variable v-next-widget-name as character no-undo .
      497   if v-tab-order <> '' then do:
      498     if self:type = "TOGGLE-BOX" then
      499     self:BGCOLOR = ?.
      500     assign
      501     ii = lookup(self:name, v-tab-order).
      502     assign
      503     ii = ii + 1
      504     v-next-widget-name = entry(ii, v-tab-order)
      505     no-error .
      506     if error-status:error then do:
      507       assign
      508       ii = 1
      509       v-next-widget-name = entry( ii, v-tab-order)
      510       .
      511     end.
      512     assign
      513     fh = frame Dialog-Frame:first-child
      514     hh = fh:first-child
      515     .
      516     do while valid-handle(hh):
      517       if hh:name = v-next-widget-name then do:
      518         if hh:sensitive  = yes
      519         AND hh:visible = yes then do:
      520           APPLY "ENTRY" to hh.
      521           return no-apply.
      522         end.
      523         else do:
      524           APPLY "TAB" to hh.
      525           return no-apply.
      526         end.
      527       end.
      528       hh = hh:next-sibling.
      529     end.
      530   end.
      531   END.
      532   ON BACK-TAB ANYWHERE
      533   DO:
      534   define variable ii as integer no-undo .
      535   define variable fh as widget-handle no-undo .
      536   define variable hh as widget-handle no-undo .
      537   define variable v-next-widget-name as character no-undo .
      538   if v-tab-order <> '' then do:
      539     assign
      540     ii = lookup(self:name, v-tab-order).
      541     .
      542     assign
      543     ii = (if ii = 1
      544           then  num-entries(v-tab-order)
      545           else ii - 1
      546           )
      547     v-next-widget-name = entry(ii, v-tab-order)
      548     .
      549     assign
      550     fh = frame Dialog-Frame:first-child
      551     hh = fh:first-child
      552     .
      553     do while valid-handle(hh):
      554       if hh:name = v-next-widget-name then do:
      555         if hh:sensitive  = yes
      556         AND hh:visible = yes then do:
      557           APPLY "ENTRY" to hh.
      558           return no-apply.
      559         end.
      560         else do:
      561         APPLY "BACK-TAB" to hh.
      562         return no-apply.
      563         end.
      564       end.
      565       hh = hh:next-sibling.
      566     end.
      567     end.
      568   END.
      569   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   ON RETURN ANYWHERE
      571   DO:
      572   define variable ii as integer no-undo .
      573   define variable fh as widget-handle no-undo .
      574   define variable hh as widget-handle no-undo .
      575   define variable v-next-widget-name as character no-undo .
      576     if v-tab-order <> '' then do:
      577       assign
      578       ii = lookup(self:name, v-tab-order).
      579       if ii = num-entries(v-tab-order) then do:
      580           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      581           return no-apply.
      582       end.
      583       if self:type <> "BUTTON" and
      584         self:type <> "EDITOR"  then do:
      585         run proc-move-forward in this-procedure .
      586         return no-apply.
      587       end.
      588       if self:type = "BUTTON" then do:
      589         APPLY "CHOOSE" to self.
      590       end.
      591       if self:type = "TOGGLE-BOX" then
      592       self:BGCOLOR = ?.
      593       assign
      594       ii = ii + 1
      595       v-next-widget-name = entry(ii, v-tab-order)
      596       no-error .
      597       if error-status:error then do:
      598         assign
      599         ii = 1
      600         v-next-widget-name = entry( ii, v-tab-order)
      601         .
      602       end.
      603       assign
      604       fh = frame Dialog-Frame:first-child
      605       hh = fh:first-child
      606       .
      607       do while valid-handle(hh):
      608         if hh:name = v-next-widget-name then do:
      609           if hh:sensitive  = yes
      610           AND hh:visible = yes then do:
      611             if hh:type = "TOGGLE-BOX":U then do:
      612               assign
      613               hh:BGcolor = 1
      614               .
      615             end.
      616             APPLY "ENTRY" to hh.
      617             return no-apply.
      618           end.
      619           else do:
      620             APPLY "TAB" to hh.
      621             return no-apply.
      622           end.
      623         end.
      624         hh = hh:next-sibling.
      625       end.
      626     end.
      627   END.
      628   procedure proc-move-forward :
      629   define variable ii as integer no-undo .
      630   define variable fh as widget-handle no-undo .
      631   define variable hh as widget-handle no-undo .
      632   define variable v-next-widget-name as character no-undo .
      633   do
      634   on error undo, return error
      635   :
      636     if v-tab-order <> '' then do:
      637       if self:type = "TOGGLE-BOX" then
      638       self:BGCOLOR = ?.
      639       assign
      640       ii = lookup(self:name, v-tab-order).
      641       assign
      642       ii = ii + 1
      643       v-next-widget-name = entry(ii, v-tab-order)
      644       no-error .
      645       if error-status:error then do:
      646         assign
      647         ii = 1
      648         v-next-widget-name = entry( ii, v-tab-order)
      649         .
      650       end.
      651       assign
      652       fh = frame Dialog-Frame:first-child
      653       hh = fh:first-child
      654       .
      655       do while valid-handle(hh):
      656         if hh:name = v-next-widget-name then do:
      657           if hh:sensitive  = yes
      658           AND hh:visible = yes then do:
      659             if hh:type = "TOGGLE-BOX":U then do:
      660               assign
      661               hh:BGcolor = 1
      662               .
      663             end.
      664             APPLY "ENTRY" to hh.
      665             return.
      666           end.
      667           else do:
      668             assign
      669             ii = ii + 1
      670             v-next-widget-name = entry(ii, v-tab-order)
      671             no-error .
      672             if error-status:error then do:
      673               assign
      674               ii = 1
      675               v-next-widget-name = entry( ii, v-tab-order)
      676               .
      677             end.
      678           end.
      679         end.
      680         hh = hh:next-sibling.
      681       end.
      682     end.
      683   end.
      684   end procedure.
      685   MAIN-BLOCK:
      686   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      687      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      688    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      689    and p-mode <> 'ИЗМЕНЕНИЕ':U
      690    and p-mode <> 'ПРОСМОТР':U
      691    then do:
      692       message
      693       vss-workfile vss-revision vss-description skip
      694       "Неверное значение параметров вызова p-mode"  p-mode
      695       view-as alert-box ERROR.
      696       undo, return error.
      697    end.
      698      find first X_curr_clients no-lock where
      699               X_curr_clients.obj-type = p-curr-obj-type
      700          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
      701     if not available X_curr_clients then do:
      702       message
      703       vss-workfile vss-revision vss-description skip
      704       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
      705       p-curr-obj-type p-curr-obj-code
      706       view-as alert-box ERROR.
      707       return error .
      708     end.
      709   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      710   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      711     (output v-db-num
      712     )  .
      713   IF v-db-num <> 0
      714   AND (p-mode = 'ДОБАВЛЕНИЕ':U
      715        OR p-mode = 'ИЗМЕНЕНИЕ':U ) THEN DO:
      716       message
      717       vss-workfile vss-revision vss-description skip
      718       "Неверное значение параметра вызова p-mode" p-mode skip
      719       "Нельзя редактировать запись ТИП ДОСТАВКИ ОТ СУБЪЕКТОВ в УБД"
      720       view-as alert-box ERROR.
      721       return error .
      722   END.
      723     for each tt-delivery-type:
      724       delete tt-delivery-type.
      725     end.
      726     for each tt-condition-keeping:
      727       delete tt-condition-keeping.
      728     end.
      729     for each tt-deliv-type-cond-keep:
      730       delete tt-deliv-type-cond-keep.
      731     end.
      732   IF p-deliv-type-code <> 0  OR p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
      733       IF p-mode = 'ДОБАВЛЕНИЕ':U OR p-mode = 'ИЗМЕНЕНИЕ':U  THEN DO:
      734         FIND FIRST LOCKED_delivery-type EXCLUSIVE-LOCK WHERE
      735                   LOCKED_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
      736       END.
      737       IF p-mode = 'ПРОСМОТР':U THEN DO:
      738           FIND FIRST LOCKED_delivery-type no-lock WHERE
      739                           LOCKED_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
      740      END.
      741      IF (p-mode = 'ДОБАВЛЕНИЕ':U
      742       OR p-mode = 'ИЗМЕНЕНИЕ':U )
      743       AND NOT AVAILABLE LOCKED_delivery-type  THEN DO:
      744           IF LOCKED(LOCKED_delivery-type) THEN DO:
      745               message
      746               vss-workfile vss-revision vss-description skip
      747                "Запись ТИП ДОСТАВКИ занята"
      748               view-as alert-box error .
      749               undo, return error.
      750           END.
      751      END.
      752       ELSE DO:
      753         IF NOT AVAILABLE LOCKED_delivery-type THEN DO:
      754               message
      755                   vss-workfile vss-revision vss-description skip
      756                   "Неверное значение параметра вызова p-deliv-type-code" p-deliv-type-code skip
      757                   view-as alert-box ERROR.
      758                   return error .
      759           END.
      760       END.
      761       CREATE tt-delivery-type.
      762       BUFFER-COPY LOCKED_delivery-type TO tt-delivery-type.
      763   END.
      764   IF p-cond-keep-code <> 0
      765   OR p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
      766       IF p-mode = 'ДОБАВЛЕНИЕ':U OR p-mode = 'ИЗМЕНЕНИЕ':U  THEN DO:
      767          FIND FIRST LOCKED_condition-keeping EXCLUSIVE-LOCK WHERE
      768                   LOCKED_condition-keeping.cond-keep-code = p-cond-keep-code NO-ERROR.
      769       END.
      770       IF p-mode = 'ПРОСМОТР':U  THEN DO:
      771           FIND FIRST LOCKED_condition-keeping NO-LOCK WHERE
      772                   LOCKED_condition-keeping.cond-keep-code = p-cond-keep-code NO-ERROR.
      773       END.
      774       IF (p-mode = 'ДОБАВЛЕНИЕ':U
      775       OR p-mode = 'ИЗМЕНЕНИЕ':U )
      776       AND NOT AVAILABLE LOCKED_condition-keeping  THEN DO:
      777           IF LOCKED(LOCKED_condition-keeping) THEN DO:
      778               message
      779               vss-workfile vss-revision vss-description skip
      780                "Запись УСЛОВИЯ ХРАНЕНИЯ занята"
      781               view-as alert-box error .
      782               undo, return error.
      783           END.
      784       END.
      785       ELSE DO:
      786           IF NOT AVAILABLE LOCKED_condition-keeping  THEN DO:
      787               message
      788               vss-workfile vss-revision vss-description skip
      789               "Неверное значение параметра вызова p-cond-keep-code" p-cond-keep-code skip
      790               view-as alert-box ERROR.
      791               return error .
      792           END.
      793       END.
      794       CREATE tt-condition-keeping.
      795       BUFFER-COPY LOCKED_condition-keeping TO tt-condition-keeping.
      796   END.
      797   if p-mode = 'ИЗМЕНЕНИЕ':U
      798     or p-mode = 'ПРОСМОТР':U then do:
      799       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      800         find first locked_deliv-type-cond-keep EXclusive-lock where
      801                      recid(locked_deliv-type-cond-keep) = p-doc-rec no-wait no-error.
      802         if locked locked_deliv-type-cond-keep then do:
      803           message
      804           vss-workfile vss-revision vss-description skip
      805            "Запись ВОЗМОЖНОСТЬ ДОСТАВКИ ПО УСЛОВИЯМ ХРАНЕНИЯ занята"
      806           view-as alert-box error .
      807           undo, return error.
      808         end.
      809       end.
      810       else do:
      811         find first locked_deliv-type-cond-keep no-lock where
      812                          recid(locked_deliv-type-cond-keep) = p-doc-rec no-error .
      813         if not avail locked_deliv-type-cond-keep then do:
      814           find first locked_deliv-type-cond-keep no-lock where
      815                      locked_deliv-type-cond-keep.deliv-type-code = p-deliv-type-code no-error .
      816         end.
      817       end.
      818       if not available locked_deliv-type-cond-keep then do:
      819         message
      820         vss-workfile vss-revision vss-description skip
      821         "Не найдена запись ВОЗМОЖНОСТЬ ДОСТАВКИ ПО УСЛОВИЯМ ХРАНЕНИЯ"
      822         view-as alert-box error .
      823         undo, return error.
      824       end.
      825       create tt-deliv-type-cond-keep.
      826       buffer-copy locked_deliv-type-cond-keep to tt-deliv-type-cond-keep.
      827      end.
      828      else do:
      829        create tt-deliv-type-cond-keep.
      830        assign
      831        tt-deliv-type-cond-keep.deliv-type-code = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-deliv-type-code <> 0
      832                                                    THEN p-deliv-type-code
      833                                                    ELSE tt-deliv-type-cond-keep.deliv-type-code)
      834        tt-deliv-type-cond-keep.cond-keep-code = (IF p-mode = 'ДОБАВЛЕНИЕ':U AND p-cond-keep-code <> 0
      835                                                    THEN p-cond-keep-code
      836                                                    ELSE tt-deliv-type-cond-keep.deliv-type-code)
      837            .
      838      end.
      839     RUN Myenable.
      840     WAIT-FOR GO OF FRAME Dialog-Frame.
      841   END.
      842   RUN disable_UI.
      843   PROCEDURE disable_UI :
      844     HIDE FRAME Dialog-Frame.
      845   END PROCEDURE.
      846   PROCEDURE enable_UI :
      847     OPEN QUERY Dialog-Frame FOR EACH tt-deliv-type-cond-keep SHARE-LOCK,       EACH tt-condition-keeping WHERE TRUE  SHARE-LOCK.
      848     GET FIRST Dialog-Frame.
      849     DISPLAY F-deliv-type-name F-cond-keep-name
      850         WITH FRAME Dialog-Frame.
      851     IF AVAILABLE tt-deliv-type-cond-keep THEN
      852       DISPLAY tt-deliv-type-cond-keep.deliv-type-code
      853             tt-deliv-type-cond-keep.cond-keep-code tt-deliv-type-cond-keep.des
      854         WITH FRAME Dialog-Frame.
      855     ENABLE B-exit b-quit B-Hist B-Help tt-deliv-type-cond-keep.deliv-type-code
      856            B-deliv-type tt-deliv-type-cond-keep.cond-keep-code b-cond-keep
      857            tt-deliv-type-cond-keep.des
      858         WITH FRAME Dialog-Frame.
      859     VIEW FRAME Dialog-Frame.
      860   END PROCEDURE.
      861   PROCEDURE MyENable :
      862   case p-mode:
      863     when 'ДОБАВЛЕНИЕ':U then do:
      864       display
      865       (IF tt-deliv-type-cond-keep.deliv-type-code <> 0
      866        THEN tt-deliv-type-cond-keep.deliv-type-code
      867        ELSE ?) @ tt-deliv-type-cond-keep.deliv-type-code
      868       (IF tt-deliv-type-cond-keep.cond-keep-code <> 0
      869        THEN tt-deliv-type-cond-keep.cond-keep-code
      870        ELSE ?) @ tt-deliv-type-cond-keep.cond-keep-code
      871       (if available locked_delivery-type
      872       then  locked_delivery-type.deliv-type-name
      873       else "":U ) @ f-deliv-type-name
      874       (if available locked_condition-keeping
      875       then  locked_condition-keeping.cond-keep-name
      876       else "":U ) @ f-cond-keep-name
      877       WITH FRAME Dialog-Frame.
      878     end.
      879     otherwise do:
      880       IF AVAILABLE tt-deliv-type-cond-keep THEN
      881       DISPLAY
      882       tt-deliv-type-cond-keep.deliv-type-code
      883       tt-deliv-type-cond-keep.cond-keep-code
      884       locked_delivery-type.deliv-type-name @ f-deliv-type-name
      885       locked_condition-keeping.cond-keep-name @ f-cond-keep-name
      886       tt-deliv-type-cond-keep.des
      887       WITH FRAME Dialog-Frame.
      888     end.
      889   END CASE.
      890   if p-mode = 'ПРОСМОТР':U then do:
      891   assign
      892   b-quit:label = "&Выход"
      893   .
      894   hide
      895   b-exit in frame Dialog-Frame.
      896   end.
      897   ENABLE
      898   B-exit when p-mode <> 'ПРОСМОТР':U
      899   b-quit
      900   B-Hist when p-mode <> 'ДОБАВЛЕНИЕ':U
      901   B-Help
      902   tt-deliv-type-cond-keep.deliv-type-code when (p-mode = 'ДОБАВЛЕНИЕ':U and p-deliv-type-code = 0)
      903   tt-deliv-type-cond-keep.cond-keep-code when (p-mode = 'ДОБАВЛЕНИЕ':U and p-cond-keep-code = 0)
      904   tt-deliv-type-cond-keep.des when p-mode <> 'ПРОСМОТР':U
      905   b-deliv-type when (p-mode = 'ДОБАВЛЕНИЕ':U and p-deliv-type-code = 0)
      906   b-cond-keep when (p-mode = 'ДОБАВЛЕНИЕ':U and p-cond-keep-code = 0)
      907   WITH FRAME Dialog-Frame.
      908   VIEW FRAME Dialog-Frame.
      909   END PROCEDURE.
      910   PROCEDURE Proc-save :
      911   if p-mode = 'ПРОСМОТР':U then do:
      912       return error.
      913   end.
      914   if not available tt-deliv-type-cond-keep then do:
      915       create tt-deliv-type-cond-keep.
      916   end.
      917   assign
      918   frame Dialog-Frame
      919   tt-deliv-type-cond-keep.deliv-type-code
      920   tt-deliv-type-cond-keep.cond-keep-code
      921   tt-deliv-type-cond-keep.des = tt-deliv-type-cond-keep.des:SCREEN-VALUE
      922   .
      923    run ref/dlvtcnd1.p (
      924   input-output p-doc-rec
      925   ,input p-mode
      926   ,input tt-deliv-type-cond-keep.deliv-type-code
      927   ,input tt-deliv-type-cond-keep.cond-keep-code
      928   ,input tt-deliv-type-cond-keep.des
      929   )
      930   no-error.
      931   if error-status:error then do:
      932   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      933   define variable fh as widget-handle no-undo .
      934   define variable hh as widget-handle no-undo .
      935   define variable rv as character no-undo .
      936   assign
      937   rv = entry(1, return-value , chr(4)).
      938   if rv <> "":U then do:
      939     assign
      940     fh = frame Dialog-Frame:first-child
      941     hh = fh:first-child
      942     .
      943     do while valid-handle(hh):
      944       if hh:name = rv then do:
      945         APPLY "ENTRY" to hh.
      946         undo ,
      947         return error.
      948       end.
      949       hh = hh:next-sibling.
      950     end.
      951   end.
      952     undo, return error.
      953   end.
      954   END PROCEDURE.
