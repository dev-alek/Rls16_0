      706   procedure prn-lib-open-stream :
      707     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      708     define input parameter p-page-size    as integer no-undo .
      709     define input parameter p-is-stream    as logical no-undo .
      710     define input parameter p-append       as logical no-undo .
      711     define variable v-report-name as character no-undo .
      712     do
      713       on error undo, return error
      714       :
      715       run prn-lib-get-report-name  in this-procedure (
      716         input parParentProc
      717         ,output v-report-name
      718         ).
      719       if p-is-stream then
      720       do:
      721         if p-append then
      722         do:
      723           output stream PrnLibStream to value( v-report-name )
      724             page-size value(p-page-size) append .
      725         end.
      726         if not p-append then
      727         do:
      728           output stream PrnLibStream to value( v-report-name )
      729             page-size value(p-page-size) .
      730         end.
      731       end.
      732       if not p-is-stream then
      733       do:
      734         if p-append then
      735         do:
      736           output to value( v-report-name )
      737             page-size value(p-page-size) append .
      738         end.
      739         if not p-append then
      740         do:
      741           output to value( v-report-name )
      742             page-size value(p-page-size) .
      743         end.
      744       end.
      745     end.
      746   end procedure.
      747   procedure prn-lib-open-exp :
      748     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      749     define input parameter p-is-stream    as logical no-undo .
      750     define input parameter p-is-append    as logical no-undo .
      751     define output parameter p-ReportFileName as char init "report" no-undo.
      752     define output parameter p-process as logical no-undo .
      753     define variable glog as logical no-undo .
      754     do
      755       on error undo, return error
      756       :
      757       SYSTEM-DIALOG GET-FILE p-ReportFileName
      758         TITLE      "Укажите путь"
      759         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      760         ASK-OVERWRITE
      761         CREATE-TEST-FILE
      762         SAVE-AS
      763         USE-FILENAME
      764         DEFAULT-EXTENSION "txt"
      765         UPDATE glog
      766         .
      767       if not glog then  return.
      768       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      769       if p-is-stream then
      770       do:
      771         if p-is-append then
      772         do:
      773           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      774         end.
      775         else
      776         do:
      777           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      778         end.
      779       end.
      780       else
      781       do:
      782         if p-is-append then
      783         do:
      784           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      785         end.
      786         else
      787         do:
      788           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      789         end.
      790       end.
      791       p-process = yes.
      792     end.
      793   end procedure.
