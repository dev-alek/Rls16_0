     7463   PROCEDURE proc-find-obj-code :
     7464   define input parameter p-next as logical no-undo.
     7465   define input parameter p-obj-code as character no-undo.
     7466   if p-obj-code = "" then return .
     7467   run OpenBr in this-procedure
     7468       (input false
     7469       ,input true
     7470       ,input substitute("and X_c-obj-hist.doc-id = &1 "
     7471         , p-obj-code)
     7472       ,input v-corr-user-db-num
     7473       ).
     7474   apply "entry":u to sch-obj-code in frame Dialog-Frame.
     7475   END PROCEDURE.
