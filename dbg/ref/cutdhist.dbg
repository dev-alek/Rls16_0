        1   define input  parameter p-dB-NUM-utd as int64 no-undo.
        2   define input  parameter p-doc-id-utd as int64 no-undo.
        3   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
        4   run gbl/getobjsrvhndl.p (input-output ObjSrv).
        5   define variable StatusTH   as class     ibs.th.str.utd.sts.th  no-undo .
