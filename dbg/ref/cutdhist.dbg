     4381   procedure xmlchar-test :
     4382   define input parameter p-in-string          as character        no-undo.
     4383   define output parameter p-out-string-enc    as character        no-undo.
     4384   define output parameter p-out-string-dec    as character        no-undo.
     4385   do
     4386   on error undo, return error
     4387   :
     4388          run xmlchar-encode in this-procedure
     4389       (
     4390             input p-in-string
     4391           , output p-out-string-enc
     4392       ).
     4393          run xmlchar-decode in this-procedure
     4394       (
     4395             input p-out-string-enc
     4396           , output p-out-string-dec
     4397       ).
     4398   end.
     4399   end .
     4400   procedure xmlchar-encode :
     4401   define input parameter p-in-string      as character        no-undo.
     4402   define output parameter p-out-string    as character        no-undo.
     4403       define variable v-position      as integer      no-undo.
     4404       define variable v-current-char  as character    no-undo.
     4405   do
     4406   on error undo, return error
     4407   :
     4408       assign
     4409           p-out-string = "":U
     4410       .
     4411       case p-in-string
     4412       :
     4413           when ?
     4414           then do:
     4415               assign
     4416                   p-out-string = "?":U
     4417               .
     4418           end.
     4419           when "?":U
     4420           then do:
     4421               assign
     4422                   p-out-string = "&#63;":U
     4423               .
     4424           end.
     4425           otherwise do:
     4426               do v-position = 1 to length( p-in-string )
     4427               :
     4428                   assign
     4429                       v-current-char = substring( p-in-string, v-position, 1 )
     4430                   .
     4431                   case v-current-char
     4432                   :
     4433                       when "&":U
     4434                       then do:
     4435                           assign
     4436                               p-out-string = p-out-string + "&amp;":U
     4437                           .
     4438                       end.
     4439                       when ">":U
     4440                       then do:
     4441                           assign
     4442                               p-out-string = p-out-string + "&gt;":U
     4443                           .
     4444                       end.
     4445                       when "<":U
     4446                       then do:
     4447                           assign
     4448                               p-out-string = p-out-string + "&lt;":U
     4449                           .
     4450                       end.
     4451                       when "'":U
     4452                       then do:
     4453                           assign
     4454                               p-out-string = p-out-string + "&apos;":U
     4455                           .
     4456                       end.
     4457                       when '"':U
     4458                       then do:
     4459                           assign
     4460                               p-out-string = p-out-string + "&quot;":U
     4461                           .
     4462                       end.
     4463                       when chr(1)
     4464                       then do:
     4465                           assign
     4466                               p-out-string = p-out-string + "":U
     4467                           .
     4468                       end.
     4469                       when chr(2)
     4470                       then do:
     4471                           assign
     4472                               p-out-string = p-out-string + "":U
     4473                           .
     4474                       end.
     4475                       when chr(3)
     4476                       then do:
     4477                           assign
     4478                               p-out-string = p-out-string + "":U
     4479                           .
     4480                       end.
     4481                       when chr(4)
     4482                       then do:
     4483                           assign
     4484                               p-out-string = p-out-string + "":U
     4485                           .
     4486                       end.
     4487                       when chr(5)
     4488                       then do:
     4489                           assign
     4490                               p-out-string = p-out-string + "":U
     4491                           .
     4492                       end.
     4493                       when chr(6)
     4494                       then do:
     4495                           assign
     4496                               p-out-string = p-out-string + "":U
     4497                           .
     4498                       end.
     4499                       when chr(7)
     4500                       then do:
     4501                           assign
     4502                               p-out-string = p-out-string + "":U
     4503                           .
     4504                       end.
     4505                       when chr(8)
     4506                       then do:
     4507                           assign
     4508                               p-out-string = p-out-string + "":U
     4509                           .
     4510                       end.
     4511                       when chr(9)
     4512                       then do:
     4513                           assign
     4514                               p-out-string = p-out-string + "":U
     4515                           .
     4516                       end.
     4517                       when chr(29)
     4518                       then do:
     4519                           assign
     4520                               p-out-string = p-out-string + "":U
     4521                           .
     4522                       end.
     4523                       when chr(10)
     4524                       then do:
     4525                           assign
     4526                               p-out-string = p-out-string + "&#10;":U
     4527                           .
     4528                       end.
     4529                       when chr(13)
     4530                       then do:
     4531                           assign
     4532                               p-out-string = p-out-string + "&#13;":U
     4533                           .
     4534                       end.
     4535                       otherwise do:
     4536                           assign
     4537                               p-out-string = p-out-string + v-current-char
     4538                           .
     4539                       end.
     4540                   end case.
     4541               end.
     4542           end.
     4543       end case.
     4544   end.
     4545   end .
     4546   procedure xmlchar-encode-1c :
     4547   define input parameter p-in-string      as character        no-undo.
     4548   define output parameter p-out-string    as character        no-undo.
     4549       define variable v-position      as integer      no-undo.
     4550       define variable v-current-char  as character    no-undo.
     4551   do
     4552   on error undo, return error
     4553   :
     4554       assign
     4555           p-out-string = "":U
     4556       .
     4557       case p-in-string
     4558       :
     4559           when ?
     4560           then do:
     4561               assign
     4562                   p-out-string = "?":U
     4563               .
     4564           end.
     4565           otherwise do:
     4566               do v-position = 1 to length( p-in-string )
     4567               :
     4568                   assign
     4569                       v-current-char = substring( p-in-string, v-position, 1 )
     4570                   .
