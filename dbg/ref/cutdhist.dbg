     4588                               p-out-string = p-out-string + " ":U
     4589                           .
     4590                       end.
     4591                       when chr(4)
     4592                       then do:
     4593                           assign
     4594                               p-out-string = p-out-string + " ":U
     4595                           .
     4596                       end.
     4597                       when chr(5)
     4598                       then do:
     4599                           assign
     4600                               p-out-string = p-out-string + " ":U
     4601                           .
     4602                       end.
     4603                       when chr(6)
     4604                       then do:
     4605                           assign
     4606                               p-out-string = p-out-string + " ":U
     4607                           .
     4608                       end.
     4609                       when chr(7)
     4610                       then do:
     4611                           assign
     4612                               p-out-string = p-out-string + " ":U
     4613                           .
     4614                       end.
     4615                       when chr(8)
     4616                       then do:
     4617                           assign
     4618                               p-out-string = p-out-string + " ":U
     4619                           .
     4620                       end.
     4621                       when chr(9)
     4622                       then do:
     4623                           assign
     4624                               p-out-string = p-out-string + " ":U
     4625                           .
     4626                       end.
     4627                       when chr(29)
     4628                       then do:
     4629                           assign
     4630                               p-out-string = p-out-string + " ":U
     4631                           .
     4632                       end.
     4633                       when chr(10)
     4634                       then do:
     4635                           assign
     4636                               p-out-string = p-out-string + " ":U
     4637                           .
     4638                       end.
     4639                       when chr(13)
     4640                       then do:
     4641                           assign
     4642                               p-out-string = p-out-string + " ":U
     4643                           .
     4644                       end.
     4645                       otherwise do:
     4646                           assign
     4647                               p-out-string = p-out-string + v-current-char
     4648                           .
     4649                       end.
     4650                   end case.
     4651               end.
     4652           end.
     4653       end case.
     4654   end.
     4655   end .
     4656   procedure xmlchar-decode :
     4657   define input parameter p-in-string      as character        no-undo.
     4658   define output parameter p-out-string    as character        no-undo.
     4659       define variable v-position      as integer      no-undo.
     4660       define variable v-last-position as integer      no-undo.
     4661       define variable v-temp-integer  as integer      no-undo.
     4662       define variable v-current-char  as character    no-undo.
     4663       define variable v-next-char     as character    no-undo.
     4664       define variable v-success       as logical      no-undo.
     4665   do
     4666   on error undo, return error
     4667   :
     4668       assign
     4669           p-out-string = "":U
     4670           v-position   = 0
     4671       .
     4672       replace-cycle:
     4673       do while yes
     4674       on error undo, return error
     4675       :
     4676           assign
     4677               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     4678           .
     4679           if v-last-position <= v-position
     4680           then do:
     4681               if v-position = 0
     4682               then do:
     4683                   assign
     4684                       p-out-string = p-in-string
     4685                   .
     4686               end.
     4687               else do:
     4688                   assign
     4689                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     4690                   .
     4691               end.
     4692               leave replace-cycle.
     4693           end.
     4694           else do:
     4695               assign
     4696                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     4697                   v-position      = v-last-position
     4698                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     4699               .
     4700               if v-current-char = "#":U
     4701               then do:
     4702                   assign
     4703                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     4704                   .
     4705                   if v-last-position > 0
     4706                   then do:
     4707                       run xmlchar-read-integer in this-procedure
     4708                        (
     4709                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     4710                           , output v-temp-integer
     4711                           , output v-success
     4712                       ).
     4713                       if v-success = yes
     4714                       and v-temp-integer >= 1
     4715                       and v-temp-integer <= 255
     4716                       then do:
     4717                           assign
     4718                               p-out-string = p-out-string + chr( v-temp-integer )
     4719                               v-position   = v-last-position + 1
     4720                           .
     4721                       end.
     4722                       else do:
     4723                           assign
     4724                               p-out-string = p-out-string + "&":U
     4725                               v-position   = v-position   + 1
     4726                           .
     4727                       end.
     4728                   end.
     4729                   else do:
     4730                       assign
     4731                           p-out-string = p-out-string + "&":U
     4732                           v-position   = v-position   + 1
     4733                       .
     4734                   end.
     4735               end.
     4736               else do:
     4737                   case substring( p-in-string, v-position + 1, 3 )
     4738                   :
     4739                       when "lt;":U
     4740                       then do:
     4741                           assign
     4742                               p-out-string = p-out-string + "<":U
     4743                               v-position   = v-position   + 3
     4744                           .
     4745                       end.
     4746                       when "gt;":U
     4747                       then do:
     4748                           assign
     4749                               p-out-string = p-out-string + ">":U
     4750                               v-position   = v-position   + 3
     4751                           .
     4752                       end.
     4753                       otherwise do:
     4754                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     4755                           then do:
     4756                               assign
     4757                                   p-out-string = p-out-string + "&":U
     4758                                   v-position   = v-position   + 4
     4759                               .
     4760                           end.
     4761                           else do:
     4762                               case substring( p-in-string, v-position + 1, 5 )
     4763                               :
     4764                                   when "quot;":U
     4765                                   then do:
     4766                                       assign
     4767                                           p-out-string = p-out-string + '"':U
     4768                                           v-position   = v-position   + 5
     4769                                       .
     4770                                   end.
     4771                                   when "apos;":U
     4772                                   then do:
     4773                                       assign
     4774                                           p-out-string = p-out-string + "'":U
     4775                                           v-position   = v-position   + 5
     4776                                       .
     4777                                   end.
     4778                                   otherwise do:
     4779                                       assign
     4780                                           p-out-string = p-out-string + "&":U
     4781                                       .
     4782                                   end.
     4783                               end case.
     4784                           end.
     4785                       end.
     4786                   end case.
     4787               end.
     4788           end.
     4789       end.
     4790   end.
     4791   end .
     4792   procedure xmlchar-read-integer :
     4793   define input parameter p-input-string      as character        no-undo.
     4794   define output parameter p-output-integer   as integer          no-undo.
     4795   define output parameter p-success       as logical          no-undo.
     4796   do
     4797   on error undo, return error
     4798   :
     4799       assign
     4800           p-output-integer = integer( p-input-string )
     4801       no-error.
     4802       if error-status :error
     4803       then do:
     4804           assign
     4805               p-success           = no
     4806               p-output-integer    = 0
     4807           .
     4808       end.
     4809       else do:
     4810           assign
     4811               p-success           = yes
     4812           .
     4813       end.
     4814   end.
     4815   end.
     4816   define variable mMRCCode  as logical    no-undo.
     4817   define variable mTypeMark as character  no-undo.
     4818   function IS-NeedMark returns logical
     4819   ( input ib-code as integer  ,
     4820     input ib-str as character ):
     4821      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     4822      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     4823                                    and buf_prod-bc-attr.b-str  eq ib-str
     4824                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     4825        no-lock no-error.
     4826      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     4827   end.
     4828   function repTegforDm return char
     4829   (iDM as char ):
     4830       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     4831       define variable vteg as character no-undo.
     4832       define variable oDM as character no-undo.
     4833       define variable vi as integer no-undo.
     4834       oDM = iDm.
     4835       do vi = 1 to num-entries(vTeglist):
     4836          vTeg = entry(vi,vTeglist).
     4837          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     4838       end.
     4839       return oDM.
     4840   end.
     4841   function repSpecSimbforDm return char
     4842   (iDM as char ):
     4843       define variable oDM as character no-undo.
     4844     run
     4845       xmlchar-decode(iDM, output oDM).
     4846     return repTegforDm (oDM).
     4847   end.
     4848   function CheckGtin return logical
     4849   (iGtin as char):
     4850      define variable bar_code as character no-undo.
     4851      define variable vGtin as logical no-undo init "yes".
     4852      if length(iGtin) eq 14
     4853      then do:
     4854         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     4855         run str/chk-sum.p
     4856          (input-output bar_code ) no-error .
     4857         if iGtin ne  bar_code
     4858         then
     4859            vGtin = no.
     4860      end.
     4861      else
     4862         vGtin = no.
     4863      return vgtin.
     4864   end.
     4865   function repSpecSimbforXlm return char
     4866   (iDM as char ):
     4867       iDM = replace(iDM,chr(29),"").
     4868       return iDM.
     4869   end.
     4870   function getGtinByDM return char
     4871   (IDM as char):
     4872      define variable VTXT as char no-undo.
     4873      define variable vGtin as char no-undo.
     4874      vTXt = IdM.
     4875      vGtin = IDM.
     4876      if    length(vtxt) > 14
     4877      then do:
     4878         if   vtxt begins "(01)"
     4879                or vtxt begins "(02)"
     4880         then
     4881            vGtin = substring(vtxt,5,14).
     4882         else if   (vtxt begins "01"
     4883                or vtxt begins "02" )
     4884                and (   (    substring(iDm,17,2) eq "21"
     4885                         and length(vtxt) >= 21)
     4886                     or substring(iDm,17,2) eq "37"
     4887                     or substring(iDm,17,4) eq "(37)" )
     4888         then do:
     4889            vGtin = substring(vtxt,3,14).
     4890            if not checkGtin(vGtin)
     4891            then
     4892               vGtin = substring(vtxt,1,14).
     4893         end.
     4894         else if     length(vtxt) eq 14 + 7 + 4 + 4
     4895             or length(vtxt) eq 14 + 7 + 4
     4896             or length(vtxt) eq 14 + 7
     4897         then
     4898            vGtin = substring(vtxt,1,14).
     4899      end.
     4900      if not checkGtin(vGtin)
     4901      then
     4902         vGtin = "".
     4903      return vgtin.
     4904   end.
     4905   function getGdsCodeByGtin return int
     4906   (iGtin as char):
     4907      define buffer prod-bc  for ub.prod-bc.
     4908      define buffer bar-code for ub.bar-code.
     4909      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     4910      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4911      return if avail bar-code then bar-code.gds-code else ?.
     4912   end.
     4913   function getQntyCodeByGtin return decimal
     4914   (iGtin as char):
     4915      define buffer prod-bc  for ub.prod-bc.
     4916      define buffer bar-code for ub.bar-code.
     4917      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     4918      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4919      return if avail bar-code then bar-code.cli-base-rate else ?.
     4920   end.
     4921   function getGdsCodeByDM return int
     4922   (iDm as char):
     4923      define variable vGtin as char no-undo.
     4924      define buffer prod-bc for ub.prod-bc.
     4925      vGtin  = getGtinByDM (IDM ).
     4926      return getGdsCodeByGtin (vGtin).
     4927   end.
     4928   function ChekTypeMarkByGds return logical
     4929   (iGds-code as integer ):
     4930      define buffer goods-attr for ub.goods-attr.
     4931      find first goods-attr where goods-attr.gds-code   = iGds-code
     4932                              and goods-attr.attr-code  = 'mark-type':U
     4933      no-lock no-error.
     4934      if available goods-attr
     4935      then do:
     4936         mTypeMark = goods-attr.attr-value.
     4937         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     4938           .
     4939      end.
     4940      else
     4941         return no.
     4942   end.
     4943   function ChekTypeMarkByDm return logical
     4944   (iDM as char ):
     4945      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     4946   end.
     4947   function ChekTypeMarkByGtin return logical
     4948   (iGtin as char ):
     4949      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     4950   end.
     4951   function GetNextElement return character
     4952     (input iAllTeg        as logical
     4953     ,output oteg          as character
     4954     ,output otegval       as character
     4955     ,input-output pstr    as character
     4956      ):
     4957        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     4958        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     4959        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     4960        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     4961        define variable vTeg as character no-undo.
     4962        define variable vLength as integer no-undo.
     4963        define variable vi as integer no-undo.
     4964        define variable vj as integer no-undo.
     4965        define buffer code for ub.code.
     4966        find first code where Code.parent eq "MarkType"
     4967                          and Code.CodeValue   eq mTypeMark
     4968                          no-lock no-error.
     4969        if     available code
     4970           and Code.misc1 ne ""
     4971           and Code.misc1 ne ?
     4972        then do:
     4973           integer (Code.misc1) no-error.
     4974           if not error-status:error
     4975           then
     4976             entry (4,vlistleng) = Code.misc1.
     4977        end.
     4978        if iAllTeg
     4979        then
     4980           assign
     4981              vlistElem     = vlistElem    + vlistElemDop
     4982              vlistleng     = vlistleng    + vlistlengDop
     4983           .
     4984        else if mMRCCode
     4985        then
     4986           assign
     4987              vlistElem     = vlistElem    + ",(8005),8005"
     4988              vlistleng     = vlistleng    + ",000006,0006"
     4989           .
     4990       block-elem:
     4991       do vi = 1 to num-entries(vlistElem):
     4992          vTeg = entry(vi,vlistElem).
     4993          if pstr begins vTeg
     4994          then do:
     4995             if    vTeg eq "21"
     4996             then
     4997                vLength = index(pstr,chr(29)) - 2 no-error.
     4998             if vLength  <= 0
     4999             then
     5000                vLength = int(entry(vi,vlistleng)).
     5001             otegval = substring (pstr,length(vteg) + 1, vLength).
     5002             oteg = replace(replace(vteg,")",""),"(","").
     5003             vTeg = vteg + otegval.
     5004             otegval = replace(otegval,chr(29),"").
     5005             oteg = replace(replace(oteg,")",""),"(","").
     5006             pstr = substring (pstr,length(vTeg)+ 1).
     5007             vTeg = replace(vTeg,chr(29),"").
     5008             leave block-elem.
     5009          end.
     5010          else
     5011             vTeg = "".
     5012       end.
     5013       return vteg.
     5014   end.
     5015   function GetCodeIdent return character
     5016   (iDm as char):
     5017      define variable Velement   as character no-undo init "first".
     5018      define variable oCodeIdent as character no-undo.
     5019      define variable vteg as character no-undo.
     5020      define variable vtegval as character no-undo.
     5021      define variable vGtin as character no-undo.
     5022      define buffer marking for ub.marking.
     5023      for first marking no-lock where
     5024                marking.mark eq iDm
     5025            and marking.unit-ext = "LEVEL2"
     5026      :
     5027        return iDm.
     5028      end.
     5029      vGtin  = getGtinByDM (iDm ).
     5030      ChekTypeMarkByDm(idm).
     5031      if iDm begins 'tech_':U
     5032      then
     5033         oCodeIdent = iDm.
     5034      else if length(iDm) < 21
     5035      then do:
     5036         find first marking where marking.mark eq idm
     5037         no-lock no-error.
     5038         oCodeIdent = if available marking then marking.mark else  ?.
     5039      end.
     5040      else if     length(iDm) eq 29
     5041         and not iDm begins "01"
     5042         and not iDm begins "02"
     5043      then
     5044         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     5045      else  if     length(iDm) >= 24
     5046               and (  iDm begins "01"
     5047                   or iDm begins "02")
     5048               and  substring(iDm,17,2) ne "21"
     5049      then do:
     5050         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     5051                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     5052         then
     5053            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     5054         else
     5055            oCodeIdent = iDM.
     5056      end.
     5057      else  if     (   length(iDm) eq 25
     5058                    or length(iDm) eq 21)
     5059               and (not iDm begins "01"
     5060               and  not iDm begins "02")
     5061      then
     5062         oCodeIdent = substring(iDm,1,21).
     5063      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     5064      then
     5065         oCodeIdent = substring(iDm,1,21).
     5066      else do while Velement ne "" and idm ne "":
     5067         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     5068         oCodeIdent = oCodeIdent + Velement.
     5069      end.
     5070      return oCodeIdent.
     5071   end.
     5072   function GetTegCod return character
     5073   (icodeIdent as char, iTeg as char):
     5074      define variable Velement   as character no-undo init "first".
     5075      define variable oTeg as character no-undo init ?.
     5076      define variable vteg as character no-undo.
     5077      define variable vtegval as character no-undo.
     5078      if     ((length(icodeIdent) eq 21
     5079         and not icodeIdent begins "01"
     5080         and not icodeIdent begins "02")
     5081         or
     5082             ( length(icodeIdent) eq 25
     5083               and not icodeIdent begins "01"
     5084               and not icodeIdent begins "02"))
     5085      then do:
     5086         if iTeg eq "01" or iTeg eq "02"
     5087         then
     5088            oTeg = substring(icodeIdent,1,21).
     5089         else  if  iTeg eq "21"
     5090         then
     5091            oTeg = substring(icodeIdent,15,7).
     5092      end.
     5093      else do:
     5094         ChekTypeMarkByDm(icodeIdent).
     5095         block-teg:
     5096            do while Velement ne "" and icodeIdent ne "":
     5097            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     5098            if    Velement begins iTeg
     5099               or Velement begins "(" + iTeg + ")"
     5100            then do:
     5101               oTeg = vtegval.
     5102               leave block-teg.
     5103            end.
     5104         end.
     5105      end.
     5106      return oTeg.
     5107   end.
     5108   function isOAD return logical
     5109   (icodeIdent as character):
     5110      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     5111   end.
     5112   function isMark return logical
     5113   (icodeIdent as character):
     5114      define buffer buf_marking for ub.marking.
     5115      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     5116             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     5117   end.
     5118   function addBracketForCode return character
     5119   (icodeIdent as char):
     5120      define variable Velement   as character no-undo init "first".
     5121      define variable oTeg as character no-undo.
     5122      define variable vteg as character no-undo.
     5123      define variable vtegval as character no-undo.
     5124      define buffer marking for ub.marking.
     5125      find first marking no-lock where
     5126                 marking.mark begins icodeIdent no-error.
     5127      if    not ChekTypeMarkByDm(icodeIdent)
     5128         or length(icodeIdent) le 24
     5129         or (avail marking and marking.unit-ext = "LEVEL2")
     5130      then
     5131         oTeg = icodeIdent.
     5132      else do:
     5133         if (  icodeIdent begins "01"
     5134            or icodeIdent begins "02"
     5135            ) and CheckGtin(substring (icodeIdent,3,14))
     5136            and substring (icodeIdent,17,2) eq "21"
     5137         then do:
     5138            mMRCCode = yes.
     5139            ChekTypeMarkByDm(icodeIdent).
     5140            block-teg:
     5141            do while Velement ne "" and icodeIdent ne "":
     5142               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     5143               if vteg ne ""
     5144               then
     5145                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     5146            end.
     5147            mMRCCode = no.
     5148         end.
     5149         else do:
     5150            oTeg = icodeIdent.
     5151         end.
     5152      end.
     5153      return oTeg.
     5154   end.
     5155   function getlevelByCodId return int
     5156   (iCode as char):
     5157      define variable vLength as int no-undo.
     5158      define variable vLevel  as int no-undo.
     5159      if not ChekTypeMarkByDM (icode) then return ?.
     5160      vLength = length(iCode).
     5161      if    vLength eq 18
     5162         or vLength eq 20
     5163      then
     5164         Vlevel = 4.
     5165      else if vLength eq 21
     5166      then
     5167         Vlevel = 1.
     5168      else if vLength eq 25
     5169      then do:
     5170         if  iCode begins "01"
     5171         then
     5172            Vlevel = 3.
     5173         else
     5174            Vlevel = 1.
     5175      end.
     5176      else if     vLength >= 26
     5177              and vLength <= 46
     5178      then do:
     5179         if    substring(iCode,17,2) eq "11"
     5180            or substring(iCode,17,2) eq "13"
     5181            or (    substring(iCode,17,2) eq "21"
     5182                and vLength >= 33
     5183                and substring(iCode,26,4) ne "8005")
     5184         then
     5185            Vlevel = 4.
     5186         else if    vLength eq 31
     5187                 or vLength eq 38
     5188                 or vLength eq 39
     5189                 or vLength eq 45
     5190         then
     5191            Vlevel = 1.
     5192         else if    vLength eq 35
     5193                 or vLength eq 43
     5194         then
     5195            Vlevel = 3.
     5196         else
     5197            Vlevel = ?.
     5198      end.
     5199      else
     5200         Vlevel = ?.
     5201      return Vlevel.
     5202   end.
     5203   function getLevelMotpBycodid return character
     5204   (iDm as char):
     5205      define variable vLevel as integer no-undo.
     5206      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5207      vLevel = getlevelByCodId(iDm).
     5208      if    vLevel eq ?
     5209         or vLevel < 1
     5210         or vLevel > 6
     5211      then
     5212         return ?.
     5213      else
     5214         return entry(vlevel,vList).
     5215   end.
     5216   function getLevelUTDByLevelMotp return character
     5217   (iUnit as char):
     5218      define variable vLevel as integer no-undo.
     5219      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5220      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5221      vLevel = lookup(iUnit,vListMOTP).
     5222      if    vLevel eq ?
     5223         or vLevel < 1
     5224         or vLevel > 4
     5225      then
     5226         return ?.
     5227      else
     5228         return entry(vlevel,vListutd).
     5229   end.
     5230   function getLevelMotpByDM return character
     5231   (iDm as char):
     5232      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     5233   end.
     5234   function getLevelUTDByCodId return character
     5235   (iDm as char):
     5236      define variable vLevel as integer no-undo.
     5237      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5238      vLevel = getlevelByCodId(iDm).
     5239      if    vLevel eq ?
     5240         or vLevel < 1
     5241         or vLevel > 4
     5242      then
     5243         return ?.
     5244      else
     5245         return entry(vlevel,vList).
     5246   end.
     5247   function getLevelUTDByDM return character
     5248   (iDm as char):
     5249      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     5250   end.
     5251   define variable mNotMarkQnty as logical no-undo.
     5252   function getQntyUTDByCodId return decimal
     5253   (iDM as char):
     5254      define variable vLevel as integer no-undo.
     5255      define variable vList as character no-undo init "1,5,10,500".
     5256      define variable vGtin as character no-undo.
     5257      define variable vqnty as decimal no-undo init ?.
     5258      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     5259      if vqnty eq ?
     5260      then do:
     5261         if not mNotMarkQnty
     5262         then do:
     5263            define buffer marking for ub.marking.
     5264            define variable vCodident as character no-undo.
     5265            vCodident = GetCodeIdent(idm).
     5266            find first marking where marking.mark begins vCodident no-lock no-error.
     5267            if     available marking
     5268               and marking.box-qnty ne ?
     5269            then
     5270               return marking.box-qnty.
     5271         end.
     5272         vGtin = getGtinByDm(iDM).
     5273         if ChekTypeMarkByGtin (vGtin)
     5274         then do:
     5275            vLevel = getlevelByCodId(iDM).
     5276            if     vLevel >= 1
     5277               and vLevel <= 4
     5278            then
     5279               vqnty = int(entry(vlevel,vList)).
     5280         end.
     5281         else
     5282            vqnty = getQntyCodeByGtin(vgtin).
     5283      end.
     5284      return vqnty.
     5285   end.
     5286   function getQntyUTDByDM return decimal
     5287   (iDm as char):
     5288      define variable vDM as character no-undo.
     5289      if     length (iDm) ne 25
     5290         and length (iDm) ne 29
     5291         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     5292      then
     5293         vDM = substring (iDm,1,length (iDm) - 6 ).
     5294      else
     5295         vDM = substring (iDm,1,length (iDm) - 4 ).
     5296      return getQntyUTDByCodId(vDM).
     5297   end.
     5298   function getMRC4 return decimal
     5299   (iMRC as char):
     5300      define variable oMrc     as decimal no-undo init ?.
     5301      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     5302      define variable vi       as integer no-undo.
     5303      define variable vfound   as integer no-undo.
     5304      define variable vposStart   as integer no-undo.
     5305      do:
     5306      OMRc = 0.
     5307      do vi = 1 to 4:
     5308         define variable vsimb as character no-undo.
     5309         vsimb = substring(iMRC,vi,1).
     5310         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     5311         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     5312         if vfound > 0
     5313         then
     5314            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     5315         end.
     5316         OMRc = OMRc / 100.
     5317      end.
     5318      return OMRc.
     5319   end.
     5320   function getMRCByDM return decimal
     5321   (iDm as char):
     5322      define variable vMRC     as character no-undo.
     5323      define variable oMrc     as decimal no-undo init ?.
     5324      define variable Velement as character no-undo init "empty".
     5325      define variable vteg as character no-undo.
     5326      define variable vtegval as character no-undo.
     5327      if    length(idm) eq 14 + 7 + 4 + 4
     5328         or length(idm) eq 14 + 7 + 4
     5329      then do:
     5330         vMRC = substring(idm,22,4).
     5331         omrc = getMRC4(vMRC).
     5332      end.
     5333      else do:
     5334          ChekTypeMarkByDm(iDm).
     5335          block-mrc:
     5336          do while Velement ne "" and idm ne "":
     5337             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     5338             if Velement begins "8005"
     5339             then do:
     5340                vMRC = substring(Velement,5,6).
     5341                leave block-mrc.
     5342             end.
     5343             else if Velement begins "(8005)"
     5344             then do:
     5345                vMRC = substring(Velement,7,6).
     5346                leave block-mrc.
     5347             end.
     5348          end.
     5349          if vMRC ne ""
     5350          then
     5351             OMRc = dec(vmrc) / 100 no-error.
     5352      end.
     5353      return OMRc.
     5354   end.
     5355   function MoveDate return Date
     5356   (idate as date,
     5357    iMonth as int64):
     5358      define variable vMonth   as int64 no-undo.
     5359      define variable vYear    as int64 no-undo.
     5360      define variable vDateNew as date  no-undo.
     5361       define variable vDay     as int64 no-undo.
     5362       vMonth = month(iDate) + iMonth.
     5363       vYear =  year(iDate).
     5364       if vMonth <= 0
     5365       then assign
     5366          vMonth = vMonth + 12
     5367           vYear  = vYear - 1
     5368       .
     5369       else if vMonth > 12
     5370       then assign
     5371          vMonth = vMonth - 12
     5372           vYear  = vYear + 1
     5373       .
     5374       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     5375       do while error-status:error eq yes:
     5376          VDay = vDay + 1.
     5377          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     5378       end.
     5379       if VDay > 0
     5380       then
     5381          vDateNew + 1.
     5382       return vDateNew.
     5383   end.
     5384   procedure checkEMRC:
     5385   define input  parameter iDm as character no-undo.
     5386   define output parameter vok as logical   no-undo init yes.
     5387      define variable v-value-emrc as character no-undo.
     5388      define variable v-type-emrc  as character no-undo.
     5389      define variable vDateIso     as character no-undo.
     5390      define variable vMRC         as decimal no-undo.
     5391      define variable vqnty        as decimal no-undo.
     5392      define variable vPrice       as decimal no-undo.
     5393      define variable vparent      as character no-undo.
     5394      define variable vgds-code    as integer no-undo.
     5395      define buffer code for ub.code.
     5396      vMRC = getMRCByDM(iDm).
     5397      if vMRC > 0
     5398      then do:
     5399         vgds-code = getGdsCodeByDM(iDm).
     5400         vqnty     = getQntyUTDByDM(iDm).
     5401               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     5402            (
     5403             input   vgds-code
     5404            ,input   'emrc-type':U
     5405            ,output   v-value-emrc
     5406            ,output   v-type-emrc
     5407          ) no-error.
     5408          if     v-value-emrc ne ""
     5409             and v-value-emrc ne ?
     5410          then do:
     5411             vDateIso = iso-date(today).
     5412             vPrice = vMRC / vqnty.
     5413             vparent ="emc" + chr(4) + v-value-emrc.
     5414             find last code where Code.parent      eq vparent
     5415                              and Code.code        le vDateIso
     5416                              and code.status_  eq 0
     5417             no-lock no-error.
     5418             if not available code or ( vPrice  >= dec(Code.CodeValue))
     5419             then
     5420                vOk = true .
     5421             else do:
     5422                 define variable vText      as character no-undo.
     5423                 define variable vDate      as date no-undo.
     5424                 define variable vDateLast  as character no-undo.
     5425                 define variable vDateFirst as character no-undo.
     5426                 define variable vDate3     as date no-undo.
     5427                 vdate = date(code.misc1).
     5428                 vDateLast = code.misc1.
     5429                 vDate3 = MoveDate(today, - 3 ).
     5430                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     5431                                      string(vDate3  , "99/99/9999"),
     5432                                      string(vDate   , "99/99/9999")
     5433                                      ).
     5434                 vdateIso = iso-date(vdate3).
     5435                 find last code  where Code.parent      eq vparent
     5436                                   and Code.code        le vDateIso
     5437                                   and code.status_  eq 0 no-lock no-error.
     5438                 if available code
     5439                 then
     5440                    vDateIso = code.code.
     5441                 vDateFirst = vDateIso.
     5442                 vDateLast = iso-date(vdate).
     5443                 define variable vGood as logical no-undo.
     5444                 define variable vDateSale as date no-undo.
     5445                 define buffer bcode for code.
     5446                 for last code where Code.parent   eq vparent
     5447                                 and code.status_  eq 0
     5448                                 and code.code     < vDateLast
     5449                                 and code.code     >= vDateFirst
     5450                 no-lock:
     5451                    find first bcode where bCode.parent   eq vparent
     5452                                       and bcode.status_  eq 0
     5453                                       and bcode.code     > code.code no-lock no-error.
     5454                    if available bcode
     5455                    then do:
     5456                       if vPrice < dec(Code.CodeValue)
     5457                       then
     5458                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     5459                                                     chr(10),
     5460                                                     string(    date( code.misc1)       ,"99/99/9999"),
     5461                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     5462                                                     ).
     5463                       else do:
     5464                          vGood = yes.
     5465                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     5466                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     5467                                                     chr(10),
     5468                                                     string(    date( code.misc1)         ,"99/99/9999"),
     5469                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     5470                                                     string(         vDateSale            ,"99/99/9999"),
     5471                                                     string(vDateSale - today)
     5472                                                     ).
     5473                       end.
     5474                    end.
     5475                 end.
     5476                 if vgood
     5477                 then do:
     5478                    define variable choice as integer no-undo .
     5479                    run gbl/d-askw.w (input "Уточнение"
     5480                           ,input  vText
     5481                           ,input "|"
     5482                           ,input "Принять|Вернуть"
     5483                           ,input "Принять данный товар|Вернуть товар постащику"
     5484                           ,input 1
     5485                           ,input 2
     5486                           ,output choice) no-error.
     5487                    vok = choice eq 1.
     5488                 end.
     5489                 else
     5490                    vok =false.
     5491             end.
     5492          end.
     5493      end.
     5494   end.
     5495   function addGs2Mark return character
     5496   (iMark as char):
     5497      define variable vDM   as character no-undo.
     5498      define variable vIdx  as integer   no-undo.
     5499      if index(iMark,chr(29),1) > 0
     5500      then return iMark.
     5501      if substring(iMark,26,4) = "8005" then
     5502      do:
     5503        vIdx = index(iMark,"93",26 + 4 + 5).
     5504        if vIdx > 1 then do:
     5505          vDM = substitute("&1&4&2&4&3",
     5506                           substring(iMark,1,25),
     5507                           substring(iMark,26,vIdx - 25 - 1),
     5508                           substring(iMark,vIdx),
     5509                           chr(29)) no-error.
     5510          vIdx = index(vDm,"240",vIdx + 4).
     5511          if vIdx > 0 then
     5512          do:
     5513            vDM = substitute("&1&3&2",
     5514                             substring(vDm,1,vIdx - 1),
     5515                             substring(vDm,vIdx),
     5516                             chr(29)) no-error.
     5517          end.
     5518        end.
     5519        else
     5520          vDM = substitute("&1&3&2",
     5521                           substring(iMark,1,25),
     5522                           substring(iMark,26),
     5523                           chr(29)) no-error.
     5524      end.
     5525      else if substring(iMark,32,2) = "91" then
     5526      do:
     5527        vIdx = index(iMark,"92",32).
     5528        if vIdx > 1 then
     5529          vDM = substitute("&1&4&2&4&3",
     5530                           substring(iMark,1,31),
     5531                           substring(iMark,32,vIdx - 31 - 1),
     5532                           substring(iMark,vIdx),
     5533                           chr(29)) no-error.
     5534        else
     5535          vDM = substitute("&1&3&2",
     5536                           substring(iMark,1,31),
     5537                           substring(iMark,32),
     5538                           chr(29)) no-error.
     5539      end.
     5540      else if substring(iMark,39,2) = "91" then
     5541      do:
     5542        vIdx = index(iMark,"92",38).
     5543        if vIdx > 1 then
     5544          vDM = substitute("&1&4&2&4&3",
     5545                           substring(iMark,1,38),
     5546                           substring(iMark,39,vIdx - 38 - 1),
     5547                           substring(iMark,vIdx),
     5548                           chr(29)) no-error.
     5549        else
     5550          vDM = substitute("&1&3&2",
     5551                           substring(iMark,1,38),
     5552                           substring(iMark,39),
     5553                           chr(29)) no-error.
     5554      end.
     5555      else if substring(iMark,25,2) = "93" then
     5556      do:
     5557        vIdx = index(iMark,"92",25).
     5558        if vIdx > 1 then
     5559          vDM = substitute("&1&4&2&4&3",
     5560                           substring(iMark,1,24),
     5561                           substring(iMark,25,vIdx - 24 - 1),
     5562                           substring(iMark,vIdx),
     5563                           chr(29)) no-error.
     5564        else
     5565          vIdx = index(iMark,"3103",25).
     5566          if vIdx > 0 then
     5567          vDM = substitute("&1&4&2&4&3",
     5568                           substring(iMark,1,24),
     5569                           substring(iMark,25,vIdx - 24 - 1),
     5570                           substring(iMark,vIdx),
     5571                           chr(29)) no-error.
     5572          else
     5573            vDM = substitute("&1&3&2",
     5574                             substring(iMark,1,24),
     5575                             substring(iMark,25),
     5576                             chr(29)) no-error.
     5577      end.
     5578      else if substring(iMark,32,2) = "93" then
     5579      do:
     5580        vDM = substitute("&1&3&2",
     5581              substring(iMark,1,31),
     5582              substring(iMark,32),
     5583              chr(29)) no-error.
     5584      end.
     5585      return if vDM <> "" then vDm else iMark.
     5586   end.
     5587   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5588   procedure gen-key-rec :
     5589     define input  parameter p-tbl-name    as character no-undo.
     5590     define input  parameter p-bh_tbl-name as handle    no-undo.
     5591     define output parameter p-key-rec     as character no-undo.
     5592     do
     5593     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5594     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     5595     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     5596     :
     5597       define variable fh               as handle    no-undo .
     5598       define variable v-ok             as logical   no-undo .
     5599       define variable v-inform         as character no-undo .
     5600       define variable v-ind            as integer   no-undo .
     5601       define variable v-idx-field-qnty as integer   no-undo .
     5602       if p-tbl-name = ?
     5603         or p-tbl-name = "":U
     5604       then do:
     5605         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info34 ).
     5606       end.
     5607       if not p-bh_tbl-name:available then do:
     5608         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info34, p-tbl-name ).
     5609       end.
     5610       assign
     5611         p-key-rec = p-tbl-name
     5612         v-inform  = p-bh_tbl-name:index-information(1)
     5613         v-ind     = 2
     5614       .
     5615       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5616       on error undo, return error
     5617       :
     5618         assign
     5619           v-inform = p-bh_tbl-name:index-information( v-ind )
     5620           v-ind    = v-ind + 1
     5621         .
     5622       end.
     5623       if v-inform = ?
     5624         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5625         or entry( 3, v-inform, ",":U ) <> "1":U
     5626       then do:
     5627         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, p-tbl-name ).
     5628       end.
     5629       else do:
     5630         assign
     5631           v-idx-field-qnty = num-entries( v-inform ) - 4
     5632         .
     5633         if v-idx-field-qnty < 2 then do:
     5634           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, p-tbl-name ).
     5635         end.
     5636         do v-ind = 1 to v-idx-field-qnty by 2
     5637         on error undo, return error
     5638         :
     5639           assign
     5640             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     5641             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     5642           .
     5643         end.
     5644       end.
     5645       if p-key-rec = ? then do:
     5646         assign
     5647           p-key-rec = "":U
     5648         .
     5649         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info34, p-tbl-name ).
     5650       end.
     5651     end.
     5652     return.
     5653   end procedure.
     5654   procedure gen-where-keyr-tab :
     5655     define input  parameter i-tableSerach as character no-undo.
     5656     define input  parameter i-tablekey   as character  no-undo.
     5657     define input  parameter p-key-rec    as character  no-undo.
     5658     define input  parameter p-key-handle as handle     no-undo .
     5659     define input  parameter p-db-name    as character  no-undo .
     5660     define input  parameter p-tt-handle  as handle     no-undo .
     5661     define output parameter o-Where      as character  no-undo.
     5662     do
     5663     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5664     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5665     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     5666     :
     5667       define variable v-full-tbl-name  as character no-undo .
     5668       define variable bh_tbl-name      as handle    no-undo .
     5669       define variable fh_key           as handle    no-undo .
     5670       define variable fh_search        as handle    no-undo .
     5671       define variable v-field-num      as integer   no-undo .
     5672       define variable v-count-fld      as integer   no-undo .
     5673       define variable v-inform         as character no-undo .
     5674       define variable v-ind            as integer   no-undo .
     5675       define variable v-idx-field-qnty as integer   no-undo .
     5676       define variable v-field-name     as character no-undo .
     5677       define variable v-field-val      as character no-undo .
     5678       define variable v-word-link      as character no-undo .
     5679       define variable vTable           as character no-undo.
     5680       define variable bh_tbl-key       as handle    no-undo .
     5681       assign
     5682         p-key-rec = trim( p-key-rec )
     5683       .
     5684       if p-key-handle <> ? then do:
     5685         if not valid-handle(p-key-handle)
     5686            or p-key-handle:type <> "buffer"
     5687         then do:
     5688           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info34 ).
     5689         end.
     5690         if num-entries( p-key-rec, chr(3) ) > 1
     5691           or p-key-rec = ?
     5692           or p-key-rec = "":U
     5693         then do:
     5694           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info34, p-key-rec ).
     5695         end.
     5696       end.
     5697       else do:
     5698         if p-key-rec = ?
     5699           or p-key-rec = "":U
     5700         then do:
     5701           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info34 ).
     5702         end.
     5703       end.
     5704       assign
     5705         vTable = entry( 1 , p-key-rec, chr(3) )
     5706       .
     5707       if p-tt-handle <> ?
     5708         and ( not valid-handle(p-tt-handle)
     5709               or p-tt-handle:type <> "buffer"
     5710             )
     5711       then do:
     5712         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info34, vTable, chr(10) ).
     5713       end.
     5714       if p-tt-handle = ? then do:
     5715         assign
     5716           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     5717         .
     5718         create buffer bh_tbl-name for table v-full-tbl-name .
     5719       end.
     5720       else do:
     5721         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5722       end.
     5723       assign
     5724         v-inform = bh_tbl-name:index-information(1)
     5725         v-ind    = 2
     5726       .
     5727       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5728       on error undo, return error
     5729       :
     5730         assign
     5731           v-inform = bh_tbl-name:index-information( v-ind )
     5732           v-ind    = v-ind + 1
     5733         .
     5734       end.
     5735       if v-inform = ?
     5736         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5737         or entry( 3, v-inform, ",":U ) <> "1":U
     5738       then do:
     5739         delete object bh_tbl-name no-error.
     5740         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info34, vTable ).
     5741       end.
     5742       assign
     5743         v-idx-field-qnty = num-entries( v-inform ) - 4
     5744       .
     5745       if v-idx-field-qnty < 2 then do:
     5746         delete object bh_tbl-name no-error.
     5747         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, vTable ).
     5748       end.
     5749       assign
     5750         o-where     = "where":U
     5751         v-word-link = "":U
     5752         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     5753         v-count-fld = 0
     5754       .
     5755       if i-tablekey ne "" and i-tablekey ne ?
     5756       then do:
     5757         assign
     5758           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     5759         .
     5760         create buffer bh_tbl-key for table v-full-tbl-name .
     5761       end.
     5762       if i-tableSerach ne "" and i-tableSerach ne ?
     5763       then do:
     5764         delete object bh_tbl-name no-error.
     5765         assign
     5766           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     5767         .
     5768         create buffer bh_tbl-name for table v-full-tbl-name .
     5769       end.
     5770       block_where:
     5771       do v-ind = 1 to v-idx-field-qnty by 2
     5772       on error undo, return error
     5773       :
     5774         assign
     5775           v-count-fld = v-count-fld + 1
     5776         .
     5777         if p-key-handle = ?
     5778           and v-count-fld > v-field-num
     5779         then do:
     5780           leave block_where.
     5781         end.
     5782         define variable VfieldKeyTable as handle no-undo.
     5783         assign
     5784           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     5785           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     5786         .
     5787         if     bh_tbl-key ne ?
     5788         then do:
     5789            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     5790            if VfieldKeyTable eq ?
     5791            then next block_where.
     5792         end.
     5793         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     5794         then
     5795            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     5796         else
     5797            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     5798         if p-key-handle = ? then do:
     5799           assign
     5800             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     5801           .
     5802         end.
     5803         else do:
     5804           assign
     5805             fh_key = p-key-handle:buffer-field( v-field-name )
     5806           .
     5807           if fh_key = ?
     5808             or not valid-handle( fh_key )
     5809           then do:
     5810             delete object bh_tbl-name.
     5811             if     bh_tbl-key ne ?
     5812             then
     5813                delete object bh_tbl-key.
     5814             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info34, p-key-handle:name, v-field-name ).
     5815           end.
     5816           assign
     5817             v-field-val = fh_key:buffer-value
     5818           .
     5819         end.
     5820         if fh_search:data-type ="character":U then do:
     5821           assign
     5822             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     5823             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     5824             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     5825             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     5826             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     5827             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     5828             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     5829             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     5830             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     5831             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     5832             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     5833             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     5834             v-field-val = substitute( '"&1"', v-field-val )
     5835           .
     5836         end.
     5837         assign
     5838           o-where = substitute( "&1 &2", o-where, v-field-val )
     5839         .
     5840         if v-word-link = "":U then do:
     5841           assign
     5842             v-word-link = "and":U
     5843           .
     5844         end.
     5845       end.
     5846       delete object bh_tbl-name.
     5847       if     bh_tbl-key ne ?
     5848       then
     5849          delete object bh_tbl-key.
     5850       if p-key-handle = ?
     5851         and v-count-fld <> v-field-num
     5852       then do:
     5853         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info34, vTable ).
     5854       end.
     5855     end.
     5856   end procedure.
     5857   procedure gen-hn-keyr-tab :
     5858     define input  parameter i-tableSerach as character no-undo.
     5859     define input  parameter i-tablekey   as character no-undo.
     5860     define input  parameter p-key-rec    as character no-undo.
     5861     define input  parameter p-key-handle as handle    no-undo .
     5862     define input  parameter p-db-name    as character no-undo .
     5863     define input  parameter p-tt-handle  as handle    no-undo .
     5864     define input  parameter p-stts-lock  as integer   no-undo .
     5865     define output parameter o-hn         as handle    no-undo.
     5866     define variable v-full-tbl-name as character no-undo.
     5867     define variable v-where         as character no-undo.
     5868     define variable bh_tbl-name     as handle    no-undo.
     5869     define variable vTable          as character no-undo.
     5870     do
     5871     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5872     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5873     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     5874         run gen-where-keyr-tab(i-tableSerach,
     5875                                i-tablekey,
     5876                                p-key-rec,
     5877                                p-key-handle,
     5878                                p-db-name,
     5879                                p-tt-handle,
     5880                                output v-where).
     5881         if i-tableSerach ne "" and i-tableSerach ne ?
     5882         then do:
     5883            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     5884            create buffer bh_tbl-name for table v-full-tbl-name .
     5885         end.
     5886         else do:
     5887            if p-tt-handle = ? then do:
     5888               assign
     5889                  vTable = entry( 1 , p-key-rec, chr(3) )
     5890               .
     5891               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     5892               create buffer bh_tbl-name for table v-full-tbl-name .
     5893            end.
     5894            else do:
     5895               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5896            end.
     5897         end.
     5898         if p-tt-handle = ? then do:
     5899            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     5900         end.
     5901         else do:
     5902            bh_tbl-name:find-first( v-where ) no-error .
     5903         end.
     5904         o-hn = bh_tbl-name.
     5905      end.
     5906   end procedure.
     5907   procedure gen-hn-keyr :
     5908     define input  parameter p-key-rec    as character no-undo.
     5909     define input  parameter p-key-handle as handle    no-undo .
     5910     define input  parameter p-db-name    as character no-undo .
     5911     define input  parameter p-tt-handle  as handle    no-undo .
     5912     define input  parameter p-stts-lock  as integer   no-undo .
     5913     define output parameter o-hn         as handle    no-undo.
     5914     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     5915   end.
     5916   procedure gen-row-keyr :
     5917     define input  parameter p-key-rec    as character no-undo.
     5918     define input  parameter p-key-handle as handle    no-undo .
     5919     define input  parameter p-db-name    as character no-undo .
     5920     define input  parameter p-tt-handle  as handle    no-undo .
     5921     define input  parameter p-stts-lock  as integer   no-undo .
     5922     define output parameter p-tbl-row    as rowid     no-undo.
     5923     define output parameter p-tbl-name   as character no-undo.
     5924     define variable vHn as handle no-undo.
     5925       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     5926       p-tbl-row = if vHn:available then vHn:rowid else ?.
     5927       p-tbl-name =  vHn:table.
     5928       delete object vHn no-error.
     5929     if p-tbl-row = ? then do:
     5930       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info34, p-tbl-name, p-key-rec ).
     5931     end.
     5932     else do:
     5933       return.
     5934     end.
     5935   end procedure.
     5936   procedure gen-key-fv :
     5937     define input  parameter p-key-rec    as character no-undo .
     5938     define output parameter p-field-list as character no-undo .
     5939     define output parameter p-value-list as character no-undo.
     5940     do
     5941     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5942     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5943     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5944     :
     5945       define variable v-full-tbl-name  as character no-undo .
     5946       define variable bh_tbl-name      as handle    no-undo .
     5947       define variable v-tbl-name       as character no-undo .
     5948       define variable v-field-num      as integer   no-undo .
     5949       define variable v-count-fld      as integer   no-undo .
     5950       define variable v-inform         as character no-undo .
     5951       define variable v-ind            as integer   no-undo .
     5952       define variable v-idx-field-qnty as integer   no-undo .
     5953       define variable v-delim-key      as character no-undo .
     5954       if p-key-rec = ?
     5955         or p-key-rec = "":U
     5956       then do:
     5957         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info34 ).
     5958       end.
     5959       assign
     5960         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     5961         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5962       .
     5963       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5964       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info34 ).
     5965       assign
     5966         v-inform = bh_tbl-name:index-information(1)
     5967         v-ind    = 2
     5968       .
     5969       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5970       on error undo, return error
     5971       :
     5972         assign
     5973           v-inform = bh_tbl-name:index-information( v-ind )
     5974           v-ind    = v-ind + 1
     5975         .
     5976       end.
     5977       if v-inform = ?
     5978         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5979         or entry( 3, v-inform, ",":U ) <> "1":U
     5980       then do:
     5981         delete object bh_tbl-name no-error.
     5982         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, v-tbl-name ).
     5983       end.
     5984       assign
     5985         v-idx-field-qnty = num-entries( v-inform ) - 4
     5986       .
     5987       if v-idx-field-qnty < 2 then do:
     5988         delete object bh_tbl-name no-error.
     5989         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, v-tbl-name ).
     5990       end.
     5991       assign
     5992         p-field-list = "":U
     5993         p-value-list = "":U
     5994         v-delim-key  = "":U
     5995         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     5996         v-count-fld  = 0
     5997       .
     5998       block_where:
     5999       do v-ind = 1 to v-idx-field-qnty by 2
     6000       on error undo, return error
     6001       :
     6002         assign
     6003           v-count-fld = v-count-fld + 1
     6004         .
     6005         if v-count-fld > v-field-num then do:
     6006           leave block_where.
     6007         end.
     6008         assign
     6009           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     6010           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     6011         .
     6012         if v-ind = 1 then do:
     6013           assign
     6014             v-delim-key = chr(3)
     6015           .
     6016         end.
     6017       end.
     6018       delete object bh_tbl-name.
     6019       if v-count-fld <> v-field-num then do:
     6020         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info34, v-tbl-name ).
     6021       end.
     6022     end.
     6023   end procedure.
     6024   procedure gen-key-field :
     6025     define input  parameter p-table      as character no-undo .
     6026     define output parameter p-field-list as character no-undo .
     6027     do
     6028     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6029     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     6030     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     6031     :
     6032       define variable v-full-tbl-name  as character no-undo .
     6033       define variable bh_tbl-name      as handle    no-undo .
     6034       define variable v-tbl-name       as character no-undo .
     6035       define variable v-field-num      as integer   no-undo .
     6036       define variable v-count-fld      as integer   no-undo .
     6037       define variable v-inform         as character no-undo .
     6038       define variable v-ind            as integer   no-undo .
     6039       define variable v-idx-field-qnty as integer   no-undo .
     6040       define variable v-delim-key      as character no-undo .
     6041       if p-table = ?
     6042         or p-table = "":U
     6043       then do:
     6044         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info34 ).
     6045       end.
     6046       assign
     6047         v-tbl-name      = p-table
     6048         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     6049       .
     6050       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     6051       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info34 ).
     6052       assign
     6053         v-inform = bh_tbl-name:index-information(1)
     6054         v-ind    = 2
     6055       .
     6056       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     6057       on error undo, return error
     6058       :
     6059         assign
     6060           v-inform = bh_tbl-name:index-information( v-ind )
     6061           v-ind    = v-ind + 1
     6062         .
     6063       end.
     6064       if v-inform = ?
     6065         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     6066         or entry( 3, v-inform, ",":U ) <> "1":U
     6067       then do:
     6068         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, v-tbl-name ).
     6069       end.
     6070       assign
     6071         v-idx-field-qnty = num-entries( v-inform ) - 4
     6072       .
     6073       if v-idx-field-qnty < 2 then do:
     6074         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, v-tbl-name ).
     6075       end.
     6076       assign
     6077         p-field-list = "":U
     6078         v-delim-key  = "":U
     6079         v-count-fld  = 0
     6080       .
     6081       block_where:
     6082       do v-ind = 1 to v-idx-field-qnty by 2
     6083       on error undo, return error
     6084       :
     6085         assign
     6086           v-count-fld = v-count-fld + 1
     6087         .
     6088         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     6089         if v-ind = 1 then do:
     6090           assign
     6091             v-delim-key = chr(3)
     6092           .
     6093         end.
     6094       end.
     6095       delete object bh_tbl-name.
     6096     end.
     6097   end procedure.
     6098   function AddUtdErrForTab returns logical
     6099   (idb-num         as integer ,
     6100    idoc-id         as integer ,
     6101    iTab            as character,
     6102    iObj            as handle ,
     6103    iCheckType      as character,
     6104    iCodeErr        as character,
     6105    iCheckObj       as character ):
     6106      define buffer utd-err for utd-err.
     6107      define buffer utd for utd.
     6108      find first utd where utd.db-num     eq idb-num
     6109                       and utd.doc-id     eq idoc-id
     6110                       and utd.Direction  eq 'Outbound'
     6111      no-lock no-error.
     6112      if available utd
     6113      then
     6114         return no.
     6115      define variable vRecKey as character no-undo.
     6116            run gen-key-rec (input iTab,
     6117                             input  iObj,
     6118                             output vRecKey).
     6119      find first utd-err where utd-err.db-num     eq idb-num
     6120                           and utd-err.doc-id     eq idoc-id
     6121                           and utd-err.CheckType  eq iCheckType
     6122                           and utd-err.CodeErr    eq iCodeErr
     6123                           and utd-err.CheckObj   eq iCheckObj
     6124      exclusive-lock no-error.
     6125      if not available utd-err
     6126      then do:
     6127         create utd-err.
     6128         assign
     6129            utd-err.db-num         = idb-num
     6130            utd-err.doc-id         = idoc-id
     6131            utd-err.CheckType      = iCheckType
     6132            utd-err.CodeErr        = iCodeErr
     6133            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     6134            utd-err.reckey         = vRecKey
     6135            utd-err.qnty           = 1
     6136         .
     6137      end.
     6138      else
     6139         utd-err.qnty = utd-err.qnty + 1.
     6140      return utd-err.qnty eq 1.
     6141   end.
     6142   function AddUtdErr returns logical
     6143   (idb-num         as integer ,
     6144    idoc-id         as integer ,
     6145    iObj            as handle ,
     6146    iCheckType      as character,
     6147    iCodeErr        as character,
     6148    iCheckObj       as character ):
     6149      AddUtdErrForTab
     6150         (idb-num,
     6151          idoc-id,
     6152          iObj:table,
     6153          iObj,
     6154          iCheckType,
     6155          iCodeErr,
     6156          iCheckObj).
     6157   end.
     6158   function ClearUtdErrTypeCode returns logical
     6159   (idb-num         as integer,
     6160    idoc-id         as integer ,
     6161    iCheckType      as character,
     6162    iCodeErr        as character
     6163    ):
     6164      define buffer utd-err for utd-err.
     6165      if    iCheckType eq "*"
     6166         or iCheckType eq ?
     6167      then do:
     6168         if     iCodeErr ne ?
     6169            and iCodeErr ne "*"
     6170         then
     6171            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     6172            view-as alert-box.
     6173         else
     6174         for each utd-err where utd-err.db-num  eq idb-num
     6175                            and utd-err.doc-id  eq idoc-id
     6176         exclusive-lock:
     6177            delete utd-err.
     6178         end.
     6179      end.
     6180      else do:
     6181         if    iCodeErr eq ?
     6182            or iCodeErr eq "*"
     6183         then do:
     6184            for each utd-err where utd-err.db-num     eq idb-num
     6185                               and utd-err.doc-id     eq idoc-id
     6186                               and utd-err.CheckType  eq iCheckType
     6187            exclusive-lock:
     6188               delete utd-err.
     6189            end.
     6190         end.
     6191         else do:
     6192            for each utd-err where utd-err.db-num     eq idb-num
     6193                               and utd-err.doc-id     eq idoc-id
     6194                               and utd-err.CheckType  eq iCheckType
     6195                               and ub.utd-err.CodeErr eq iCodeErr
     6196            exclusive-lock:
     6197               delete utd-err.
     6198            end.
     6199         end.
     6200      end.
     6201   end.
     6202   function ClearUtdErr returns logical
     6203   (idb-num         as integer,
     6204    idoc-id         as integer ,
     6205    iCheckType      as character
     6206    ):
     6207      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     6208   end.
     6209   function GetMesError returns character
     6210   (itxt as character,
     6211    iobj as character ):
     6212    define variable vi as integer no-undo.
     6213    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     6214       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     6215    end.
     6216    return itxt.
     6217   end.
     6218   function GetTextErrorType returns character
     6219   (iCheckType as character,
     6220    iCodeErr   as character,
     6221    iChechObj  as character,
     6222    iType      as character  ):
     6223      define buffer code    for code.
     6224      define variable vError as character no-undo.
     6225      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6226                        and code.code   eq iCodeErr
     6227      no-lock no-error.
     6228      if available code
     6229      then do:
     6230         define variable vType as integer no-undo.
     6231         if code.misc3 eq "error"
     6232         then
     6233            vType = 0.
     6234         else if code.misc3 eq "warning"
     6235         then
     6236            vType = 1.
     6237         else if code.misc3 eq "Hiden"
     6238         then
     6239            vType = 2.
     6240         else
     6241            vtype = int(code.misc3) no-error.
     6242         case itype:
     6243            when "error"
     6244            then do:
     6245               if vtype eq 0
     6246               then
     6247                  vError = GetMesError(Code.CodeValue,iChechObj).
     6248            end.
     6249            when "warning"
     6250            then do:
     6251               if vtype <= 1
     6252               then
     6253                  vError = GetMesError(Code.CodeValue,iChechObj).
     6254            end.
     6255            otherwise do:
     6256               vError = GetMesError(Code.CodeValue,iChechObj).
     6257            end.
     6258         end.
     6259      end.
     6260      else
     6261         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     6262      return vError.
     6263   end.
     6264   function GetTypeError returns integer
     6265   (iCheckType as character,
     6266    iCodeErr   as character):
     6267      define buffer code    for code.
     6268      define variable vType as integer no-undo.
     6269      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6270                        and code.code   eq iCodeErr
     6271      no-lock no-error.
     6272      if     not available code
     6273         and code.misc3 eq "error"
     6274      then
     6275         vType = 0.
     6276      else if code.misc3 eq "warning"
     6277      then
     6278         vType = 1.
     6279      else if code.misc3 eq "Hiden"
     6280      then
     6281         vType = 2.
     6282      else
     6283         vtype = int(code.misc3) no-error.
     6284      return vtype.
     6285   end.
     6286   function GetTextError returns character
     6287   (iCheckType as character,
     6288    iCodeErr   as character,
     6289    iChechObj  as character ):
     6290      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     6291   end.
     6292   function GetErrForUtdStr returns character
     6293   (idb-num     as integer ,
     6294    idoc-id     as integer ,
     6295    iCheckType  as character
     6296    ):
     6297      define buffer utd-err for utd-err.
     6298      define buffer code    for code.
     6299      define variable vHQry as handle no-undo.
     6300      define variable vError as longchar no-undo.
     6301      define variable vErrorOne as longchar  no-undo.
     6302      define variable oError as character no-undo.
     6303      create query vHQry.
     6304      vHQry:set-buffers(buffer utd-err:handle).
     6305      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6306                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6307                               + if    iCheckType eq "*"
     6308                                    or iCheckType eq ?
     6309                                 then       ""
     6310                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6311      vHQry:query-open().
     6312      vHQry:get-first().
     6313      QRY-BLOCK:
     6314      repeat while not vHQry:query-off-end:
     6315         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6316         if     vErrorOne ne ""
     6317            and vErrorOne ne ?
     6318         then
     6319            vError = vError + ", " + vErrorOne.
     6320         vHQry:get-next().
     6321      end.
     6322      oError = substring(vError,3,4002).
     6323      return oError.
     6324   end.
     6325   function GetErrJsonForUtd returns character
     6326   (idb-num         as integer ,
     6327    idoc-id         as integer ,
     6328    iCheckType      as character
     6329    ):
     6330      define buffer utd-err for utd-err.
     6331      define variable vHQry as handle no-undo.
     6332      define variable vError as longchar no-undo.
     6333      define variable oError as character no-undo.
     6334      create query vHQry.
     6335      define variable vi as integer no-undo.
     6336      vHQry:set-buffers(buffer utd-err:handle).
     6337      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6338                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6339                               + if    iCheckType eq "*"
     6340                                    or iCheckType eq ?
     6341                                 then       ""
     6342                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6343      vHQry:query-open().
     6344      vHQry:get-first().
     6345      QRY-BLOCK:
     6346      repeat while not vHQry:query-off-end:
     6347         define variable vErrorOne as character no-undo.
     6348         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6349         if     vErrorOne ne ?
     6350            and vErrorOne ne ""
     6351         then do:
     6352            vi = vi + 1.
     6353            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6354                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     6355                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6356         end.
     6357         vHQry:get-next().
     6358      end.
     6359      for first utd where utd.db-num eq idb-num
     6360                      and utd.doc-id eq idoc-id
     6361                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     6362      no-lock,
     6363         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6364                                  and utd-marking-lines.doc-id eq idoc-id
     6365                                  and utd-marking-lines.doc-level eq 1
     6366      no-lock,
     6367         first marking where marking.mark eq utd-marking-lines.mark
     6368                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6369      no-lock:
     6370         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     6371         if     vErrorOne ne ?
     6372            and vErrorOne ne ""
     6373         then do:
     6374            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     6375                            + '","ОбъектОш":"' + marking.mark
     6376                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6377         end.
     6378      end.
     6379      if vError ne ""
     6380      then
     6381         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     6382      return oError.
     6383   end.
     6384   function GetErrJsonForUtdReturn returns character
     6385   (idb-num         as integer ,
     6386    idoc-id         as integer ,
     6387    iCheckType      as character
     6388    ):
     6389      define buffer utd-err for utd-err.
     6390      define variable vHQry as handle no-undo.
     6391      define variable vError as longchar no-undo.
     6392      define variable oError as character no-undo.
     6393      define variable vi as integer no-undo.
     6394      create query vHQry.
     6395      vHQry:set-buffers(buffer utd-err:handle).
     6396      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6397                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6398                               + if    iCheckType eq "*"
     6399                                    or iCheckType eq ?
     6400                                 then       ""
     6401                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6402      vHQry:query-open().
     6403      vHQry:get-first().
     6404      QRY-BLOCK:
     6405      repeat while not vHQry:query-off-end:
     6406         define variable vErrorOne as character no-undo.
     6407         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6408         if     vErrorOne ne ?
     6409            and vErrorOne ne ""
     6410         then do:
     6411            vi = vi + 1.
     6412            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6413                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     6414                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     6415         end.
     6416         vHQry:get-next().
     6417      end.
     6418      if vError ne ""
     6419      then
     6420         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     6421      return oError.
     6422   end.
     6423   function GetCodeTextError returns character
     6424   (iCheckType as character,
     6425    iCodeErr   as character,
     6426    iChechObj  as character,
     6427    output oCode as character,
     6428    output ovalue as character ):
     6429      define buffer code    for code.
     6430      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6431                        and code.code   eq iCodeErr
     6432      no-lock no-error.
     6433      if     available code
     6434      then do:
     6435         define variable vi as integer no-undo init ?.
     6436         vi = int(Code.misc3) no-error.
     6437         if    code.misc3 ne "error"
     6438            and vi ne 0
     6439         then
     6440            oCode = ?.
     6441         else if     Code.misc1 ne ?
     6442                 and Code.misc1 ne ""
     6443         then
     6444            assign
     6445               oCode  = GetMesError(Code.misc1,iChechObj)
     6446               ovalue = GetMesError(Code.misc2,iChechObj)
     6447            .
     6448      end.
     6449      return if oCode eq ""
     6450             then ""
     6451             else (oCode + "_" + ovalue).
     6452   end.
     6453   define temp-table TT-err no-undo
     6454     field code_ as character
     6455     field text_ as character
     6456   index code_ code_.
     6457   function GetErrTxtForUtd returns character
     6458   (idb-num         as integer ,
     6459    idoc-id         as integer ,
     6460    iCheckType      as character
     6461    ):
     6462      define buffer utd-err for utd-err.
     6463      define variable vHQry as handle no-undo.
     6464      define variable oError as character no-undo.
     6465      create query vHQry.
     6466      define variable vi as integer no-undo.
     6467      for each tt-err :
     6468         delete tt-err.
     6469      end.
     6470      vHQry:set-buffers(buffer utd-err:handle).
     6471      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6472                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6473                               + if    iCheckType eq "*"
     6474                                    or iCheckType eq ?
     6475                                 then       ""
     6476                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6477      vHQry:query-open().
     6478      vHQry:get-first().
     6479      define variable vcode as character no-undo.
     6480      define variable vvalue as character no-undo.
     6481      QRY-BLOCK:
     6482      repeat while not vHQry:query-off-end:
     6483         vi = vi + 1.
     6484         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     6485         if vcode ne ?
     6486         then do:
     6487            find first tt-err where tt-err.code eq vcode
     6488            no-error.
     6489            if not available tt-err
     6490            then do:
     6491               create tt-err.
     6492               assign
     6493                  tt-err.code_ = vcode
     6494                  tt-err.text_ = vvalue
     6495               .
     6496            end.
     6497            else
     6498               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6499         end.
     6500         vHQry:get-next().
     6501      end.
     6502     find first utd where utd.db-num eq idb-num
     6503                         and utd.doc-id eq idoc-id
     6504         no-lock.
     6505      define buffer cancel_utd-lines for utd-lines.
     6506      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     6507                                  and cancel_utd-lines.doc-id eq idoc-id
     6508      no-lock:
     6509         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     6510         then do:
     6511            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6512                                        and utd-marking-lines.doc-id eq idoc-id
     6513                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     6514            no-lock,
     6515               first marking where marking.mark eq utd-marking-lines.mark
     6516                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6517            no-lock:
     6518               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     6519               find first tt-err where tt-err.code eq vcode
     6520               no-error.
     6521               if not available tt-err
     6522               then do:
     6523                  create tt-err.
     6524                  assign
     6525                     tt-err.code_ = vcode
     6526                     tt-err.text_ = vvalue
     6527                  .
     6528               end.
     6529               else
     6530                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6531            end.
     6532         end.
     6533         else do:
     6534            define variable vqnty as decimal no-undo.
     6535            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     6536            if vqnty eq ? then vqnty = 0.
     6537            if vqnty ne cancel_utd-lines.Quantity
     6538            then do:
     6539               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     6540               find first tt-err where tt-err.code eq vcode
     6541               no-error.
     6542               if not available tt-err
     6543               then do:
     6544                  create tt-err.
     6545                  assign
     6546                     tt-err.code_ = vcode
     6547                     tt-err.text_ = vvalue
     6548                  .
     6549               end.
     6550               else
     6551                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6552            end.
     6553         end.
     6554      end.
     6555      for each tt-err:
     6556         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     6557      end.
     6558      return oError.
     6559   end.
     6560   define variable mFormatErr as character no-undo init "text".
     6561   function GetErrForUtd returns character
     6562   (idb-num         as integer ,
     6563    idoc-id         as integer ,
     6564    iType           as character
     6565    ):
     6566      if mFormatErr eq "text"
     6567      then
     6568         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     6569      else do:
     6570         if itype eq "return"
     6571         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     6572         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     6573      end.
     6574   end.
     6575   function GetErrComText returns longchar
     6576   (icomment as character,
     6577    itext    as longchar ):
     6578       define variable vText as longchar no-undo.
     6579      if mFormatErr eq "text"
     6580      then do:
     6581         if icomment ne ""
     6582         then
     6583            icomment = substitute("comment:|&1|",icomment).
     6584         vText = icomment + itext.
     6585      end.
     6586      else do:
     6587         icomment = if icomment begins  '"'
     6588                    then icomment
     6589                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     6590         vText = icomment + "," + itext.
     6591         vText = "~{" + trim(vText,",") + "~}".
     6592      end.
     6593      return vText.
     6594   end.
     6595   function CheckTypeForMarkLineType returns logical
     6596   (iObj            as handle,
     6597    iCheckType      as character,
     6598    iCodeErr        as character ,
     6599    iTypeErr        as character ):
     6600      define variable vRecKey-markLine as character no-undo.
     6601      define variable vGoodMark        as logical no-undo.
     6602      define variable vdb-num          as integer no-undo.
     6603      define variable vdoc-id          as integer no-undo.
     6604      define variable vlinenum         as integer no-undo.
     6605      define variable vErrorOne as character no-undo.
     6606      define buffer buf_utd-err for utd-err.
     6607      run gen-key-rec (input "utd-marking-lines",
     6608                       input  iObj,
     6609                       output vRecKey-markLine).
     6610      vGoodMark = yes.
     6611      vdb-num = iObj::db-num.
     6612      vdoc-id = iObj::doc-id.
     6613      vlinenum = iObj::linenum.
     6614      block-mark-err:
     6615      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6616                               and buf_utd-err.db-num = vdb-num
     6617                               and buf_utd-err.reckey = vRecKey-markLine
     6618                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6619                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6620      no-lock:
     6621         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6622         if     vErrorOne ne ?
     6623            and vErrorOne ne ""
     6624         then do:
     6625            vGoodMark = no.
     6626            leave block-mark-err.
     6627         end.
     6628      end.
     6629      return not vGoodMark.
     6630   end.
     6631   function CheckErrForMarkLineType returns logical
     6632   (iObj            as handle,
     6633    iType           as character  ):
     6634      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     6635   end.
     6636   function CheckErrForMarkLine returns logical
     6637   (iObj            as handle):
     6638      return CheckErrForMarkLineType(iObj,"*").
     6639   end.
     6640   function CheckErrForLineTypeCode returns logical
     6641   (iObj                 as handle,
     6642    iCheckType           as character,
     6643    iCodeErr             as character,
     6644    iTypeErr             as character,
     6645    iOneErr              as logical):
     6646      define variable vRecKey-line     as character no-undo.
     6647      define buffer buf_utd-err for utd-err.
     6648      define variable vUtdlineError as logical no-undo.
     6649      define variable vErrorOne as character no-undo.
     6650            run gen-key-rec (input "utd-lines",
     6651                             input  iObj,
     6652                             output vRecKey-line).
     6653         define variable vdb-num as integer no-undo.
     6654         define variable vdoc-id as integer no-undo.
     6655         define variable vlinenum as integer no-undo.
     6656         vdb-num = iObj::db-num.
     6657         vdoc-id = iObj::doc-id.
     6658         vlinenum = iObj::linenum.
     6659         block-err:
     6660         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6661                                  and buf_utd-err.db-num = vdb-num
     6662                                  and buf_utd-err.reckey = vRecKey-line
     6663                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6664                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6665         no-lock:
     6666            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6667            if     vErrorOne ne ?
     6668               and vErrorOne ne ""
     6669            then do:
     6670               vUtdlineError = yes.
     6671               leave block-err.
     6672            end.
     6673         end.
     6674         if  not vUtdlineError
     6675         then do:
     6676            define variable vGoodMark as logical no-undo.
     6677            vGoodMark = yes.
     6678            block-line-err:
     6679            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     6680                                         and utd-marking-lines.doc-id  eq vdoc-id
     6681                                         and utd-marking-lines.LineNum eq vLineNum
     6682            no-lock:
     6683               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     6684               if     vGoodMark
     6685                  and iOneErr eq no
     6686               then
     6687                  leave block-line-err.
     6688               if     iOneErr = yes
     6689                  and not vGoodMark
     6690               then
     6691                  leave block-line-err.
     6692            end.
     6693            vUtdlineError = not vGoodMark.
     6694         end.
     6695      return vUtdlineError.
     6696   end.
     6697   function getErrForLineType returns character
     6698   (iObj            as handle,
     6699    iType           as character  ):
     6700      define variable vRecKey-line     as character no-undo.
     6701      define buffer buf_utd-err for utd-err.
     6702      define variable vUtdlineError as logical no-undo.
     6703      define variable vErrorOne as character no-undo.
     6704      define variable oError as character no-undo.
     6705            run gen-key-rec (input "utd-lines",
     6706                             input  iObj,
     6707                             output vRecKey-line).
     6708         define variable vdb-num as integer no-undo.
     6709         define variable vdoc-id as integer no-undo.
     6710         define variable vlinenum as integer no-undo.
     6711         vdb-num = iObj::db-num.
     6712         vdoc-id = iObj::doc-id.
     6713         vlinenum = iObj::linenum.
     6714         block-err:
     6715         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6716                                  and buf_utd-err.db-num = vdb-num
     6717                                  and buf_utd-err.reckey = vRecKey-line
     6718                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     6719         no-lock:
     6720            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     6721            if     vErrorOne ne ?
     6722               and vErrorOne ne ""
     6723            then do:
     6724               oError = oError + vErrorOne + " ".
     6725            end.
     6726         end.
     6727      return oError.
     6728   end.
     6729   function CheckErrForLineType returns logical
     6730   (iObj            as handle,
     6731    iType           as character  ):
     6732       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     6733   end.
     6734   function CheckErrForLine returns logical
     6735   (iObj            as handle):
     6736      return CheckErrForLineType(iobj,"*").
     6737   end.
     6738   function CheckErrForUtd returns logical
     6739   (idb-num         as integer ,
     6740    idoc-id         as integer ):
     6741      for each utd-lines where utd-lines.db-num eq idb-num
     6742                           and utd-lines.doc-id eq idoc-id
     6743      no-lock :
     6744         if not CheckErrForLine (buffer ub.utd-lines:handle)
     6745         then
     6746            return no.
     6747      end.
     6748      return yes.
     6749   end.
     6750   function CheckMarkUtd-28rel return logical
     6751    (input idb-num as integer,
     6752    input idoc-id as integer):
     6753    define buffer utd                   for utd.
     6754    define buffer utd-lines             for utd-lines.
     6755    define buffer utd-marking-lines     for utd-marking-lines.
     6756    define variable v-par-type as character no-undo.
     6757    define variable vgdsNoMark as logical no-undo.
     6758    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6759      define variable v-par-val  as character no-undo.
     6760      find first utd where utd.db-num eq idb-num
     6761                       and utd.doc-id eq idoc-id
     6762      no-lock no-error.
     6763      if available utd
     6764      then do:
     6765         if     utd.obj-code ne ?
     6766            and utd.obj-type ne ?
     6767         then do:
     6768            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     6769            Block-utd-lines:
     6770            for each utd-lines where utd-lines.db-num eq idb-num
     6771                                 and utd-lines.doc-id eq idoc-id
     6772            no-lock:
     6773               if     utd-lines.gds-code ne ?
     6774                  and utd-lines.gds-code ne 0
     6775               then do:
     6776                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6777                       ( utd-lines.gds-code,
     6778                         'mark-type':U,
     6779                          output v-par-val,
     6780                          output v-par-type
     6781                       ).
     6782                  if     EDOParSec:IsEdo
     6783                     and EDOParSec:GetIsEDOForType(v-par-val)
     6784                  then do:
     6785                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     6786                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     6787                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     6788                                                    and length(utd-marking-lines.mark) > 13
     6789                     no-lock no-error.
     6790                     if     avail utd-marking-lines
     6791                        and not CheckErrForLine(buffer utd-lines:handle)
     6792                     then
     6793                        leave Block-utd-lines.
     6794                  end.
     6795                  else
     6796                     vgdsNoMark = yes.
     6797               end.
     6798            end.
     6799            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     6800            if vgdsNoMark then return available utd-lines . else return yes .
     6801         end.
     6802      end.
     6803      return yes.
     6804   end.
     6805   function get-subject returns character
     6806     ( p-subject as character ) :
     6807     return p-subject.
     6808   end function.
     6809   procedure local-view-cange:
     6810      define output parameter odescription as character no-undo.
     6811      if X_c-obj-hist.subject eq "utd"
     6812      then
     6813         run utd-proc (output odescription).
     6814      else if X_c-obj-hist.subject eq "utd-err"
     6815      then
     6816         run utd-err-proc (output odescription).
     6817      else if X_c-obj-hist.subject eq "utd-lines"
     6818      then
     6819         run utd-lines-proc (output odescription).
     6820      else if X_c-obj-hist.subject eq "utd-marking-lines"
     6821      then
     6822         run utd-marking-lines-proc (output odescription).
     6823      else if X_c-obj-hist.subject eq "utd-attr"
     6824      then
     6825         run utd-attr-proc (output odescription).
     6826      else if X_c-obj-hist.subject eq "utd-err-attr"
     6827      then
     6828         run utd-err-attr-proc (output odescription).
     6829      else if X_c-obj-hist.subject eq "utd-lines-attr"
     6830      then
     6831         run utd-lines-attr-proc (output odescription).
     6832      else if X_c-obj-hist.subject eq "utd-marking-lines-attr"
     6833      then
     6834         run utd-marking-lines-attr-proc (output odescription).
     6835   end procedure.
     6836   function local-open-br returns logical
     6837   (  p-open-query     as logical    ,
     6838     p-find-next       as logical    ,
     6839     p-find-condition as character ):
     6840        define variable sort-column-phrase as character no-undo .
     6841        define variable l-query-was-opened as logical no-undo .
     6842      for each X_c-obj-hist :
     6843         delete X_c-obj-hist.
     6844      end.
     6845      if p-mode eq "one"
     6846      then do:
     6847         if p-chip-num eq ?
     6848         then do:
     6849            for each c-utd-head where c-utd-head.DB-NUM = p-DB-NUM-utd
     6850                                       and c-utd-head.doc-id = p-doc-id-utd
     6851                                       and c-utd-head.corr-user-db-num = v-corr-user-db-num
     6852            no-lock:
     6853               create X_c-obj-hist.
     6854               buffer-copy c-utd-head to X_c-obj-hist.
     6855            end.
     6856         end.
     6857         else do:
     6858            for each c-utd-head where c-utd-head.corr-user-db-num   eq v-corr-user-db-num
     6859                                       and c-utd-head.chip-num           eq p-chip-num
     6860            no-lock:
     6861                           for each c-utd-err where c-utd-err.corr-user-db-num   eq v-corr-user-db-num
     6862                                      and c-utd-err.chip-num           eq p-chip-num
     6863               no-lock:
     6864                  create X_c-obj-hist.
     6865                  buffer-copy c-utd-head to X_c-obj-hist.
     6866                  buffer-copy c-utd-err to X_c-obj-hist
     6867                  assign
     6868                     X_c-obj-hist.subject = "utd-err"
     6869                  .
     6870               end.
     6871                           for each c-utd-lines where c-utd-lines.corr-user-db-num   eq v-corr-user-db-num
     6872                                      and c-utd-lines.chip-num           eq p-chip-num
     6873               no-lock:
     6874                  create X_c-obj-hist.
     6875                  buffer-copy c-utd-head to X_c-obj-hist.
     6876                  buffer-copy c-utd-lines to X_c-obj-hist
     6877                  assign
     6878                     X_c-obj-hist.subject = "utd-lines"
     6879                  .
     6880               end.
     6881                           for each c-utd-marking-lines where c-utd-marking-lines.corr-user-db-num   eq v-corr-user-db-num
     6882                                      and c-utd-marking-lines.chip-num           eq p-chip-num
     6883               no-lock:
     6884                  create X_c-obj-hist.
     6885                  buffer-copy c-utd-head to X_c-obj-hist.
     6886                  buffer-copy c-utd-marking-lines to X_c-obj-hist
     6887                  assign
     6888                     X_c-obj-hist.subject = "utd-marking-lines"
     6889                  .
     6890               end.
     6891                           for each c-utd-attr where c-utd-attr.corr-user-db-num   eq v-corr-user-db-num
     6892                                      and c-utd-attr.chip-num           eq p-chip-num
     6893               no-lock:
     6894                  create X_c-obj-hist.
     6895                  buffer-copy c-utd-head to X_c-obj-hist.
     6896                  buffer-copy c-utd-attr to X_c-obj-hist
     6897                  assign
     6898                     X_c-obj-hist.subject = "utd-attr"
     6899                  .
     6900               end.
     6901                           for each c-utd-err-attr where c-utd-err-attr.corr-user-db-num   eq v-corr-user-db-num
     6902                                      and c-utd-err-attr.chip-num           eq p-chip-num
     6903               no-lock:
     6904                  create X_c-obj-hist.
     6905                  buffer-copy c-utd-head to X_c-obj-hist.
     6906                  buffer-copy c-utd-err-attr to X_c-obj-hist
     6907                  assign
     6908                     X_c-obj-hist.subject = "utd-err-attr"
     6909                  .
     6910               end.
     6911                           for each c-utd-lines-attr where c-utd-lines-attr.corr-user-db-num   eq v-corr-user-db-num
     6912                                      and c-utd-lines-attr.chip-num           eq p-chip-num
     6913               no-lock:
     6914                  create X_c-obj-hist.
     6915                  buffer-copy c-utd-head to X_c-obj-hist.
     6916                  buffer-copy c-utd-lines-attr to X_c-obj-hist
     6917                  assign
     6918                     X_c-obj-hist.subject = "utd-lines-attr"
     6919                  .
     6920               end.
     6921                           for each c-utd-marking-lines-attr where c-utd-marking-lines-attr.corr-user-db-num   eq v-corr-user-db-num
     6922                                      and c-utd-marking-lines-attr.chip-num           eq p-chip-num
     6923               no-lock:
     6924                  create X_c-obj-hist.
     6925                  buffer-copy c-utd-head to X_c-obj-hist.
     6926                  buffer-copy c-utd-marking-lines-attr to X_c-obj-hist
     6927                  assign
     6928                     X_c-obj-hist.subject = "utd-marking-lines-attr"
     6929                  .
     6930               end.
     6931                           for each c-utd where c-utd.corr-user-db-num   eq v-corr-user-db-num
     6932                                      and c-utd.chip-num           eq p-chip-num
     6933               no-lock:
     6934                  create X_c-obj-hist.
     6935                  buffer-copy c-utd-head to X_c-obj-hist.
     6936                  buffer-copy c-utd to X_c-obj-hist
     6937                  assign
     6938                     X_c-obj-hist.subject = "utd"
     6939                  .
     6940               end.
     6941            end.
     6942         end.
     6943      end.
     6944   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6945   define variable  l-disable-where-36  as logical   no-undo .
     6946   define variable  l-filter-open-36    as logical   .
     6947   define variable  flt-rec-36       as recid     no-undo .
     6948   define variable  filter-name-36      as character no-undo .
     6949   define variable  where-phrase-36     as character no-undo .
     6950   define variable  sort-phrase-36      as character no-undo .
     6951   define variable  where-phrase-rus-36 as character no-undo .
     6952   define variable  sort-phrase-rus-36  as character no-undo .
     6953     run waitfram-show in this-procedure
     6954       (input "ЖДИТЕ ..."
     6955       ).
     6956   run gbl/flt-get.p
     6957     (input filter-point
     6958     ,output flt-rec-36
     6959     ,output filter-name-36
     6960     ,output where-phrase-36
     6961     ,output sort-phrase-36
     6962     ,output where-phrase-rus-36
     6963     ,output sort-phrase-rus-36
     6964     ).
     6965   if p-open-query then do:
     6966       run set-filter-name in this-procedure
     6967         (INPUT filter-name-36
     6968         ) no-error .
     6969     assign
     6970       l-filter-open-36 = false
     6971     .
     6972     if flt-rec-36 <> ?
     6973       or sort-column-phrase > ""
     6974     then do:
     6975       define variable  parameter-2-36 as character no-undo .
     6976       define variable  parameter-3-36 as character no-undo .
     6977       define variable  parameter-4-36 as character no-undo .
     6978       define variable  parameter-5-36 as character no-undo .
     6979       define variable  parameter-6-36 as character no-undo .
     6980       define variable  parameter-7-36 as character no-undo .
     6981         assign
     6982         parameter-3-36 =
     6983                                 "FOR EACH X_c-obj-hist"
     6984         parameter-4-36 =
     6985           (
     6986             if (" TRUE " + " " + where-phrase-36) <> ""
     6987             then " TRUE " + " " + where-phrase-36
     6988             else "true"
     6989           )
     6990         parameter-5-36 = (" " + "" + " " + "")
     6991         parameter-6-36 = if sort-phrase-36 = ''
     6992                              then
     6993           (
     6994           " " + "" +
     6995             " " + sort-column-phrase +
     6996           " " + " by X_c-obj-hist.chip-num  "
     6997           )
     6998                              else
     6999           (
     7000           " " + "" +
     7001             " " + sort-column-phrase +
     7002           " " + sort-phrase-36
     7003           )
     7004         parameter-7-36 =
     7005           " indexed-reposition  "
     7006       .
     7007       do
     7008       on stop undo, leave
     7009       on error undo, leave
     7010       :
     7011         assign
     7012           l-disable-where-36 =
     7013             (" TRUE " + " " + where-phrase-36 = "")
     7014         .
     7015         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     7016                             ,input query br-obj-hist:handle
     7017                             ,input parameter-3-36
     7018                             ,input parameter-4-36
     7019                             ,input parameter-5-36
     7020                             ,input parameter-6-36
     7021                             ,input parameter-7-36
     7022                             )
     7023         .
     7024         assign
     7025           l-filter-open-36 = true
     7026         .
     7027       end.
     7028       if l-filter-open-36 = false then do:
     7029         message
     7030           "Ошибка при фильтрации / сортировке" skip
     7031           "Будут показаны записи без учета фильтра" skip
     7032           view-as alert-box .
     7033       end.
     7034       else do:
     7035           assign
     7036             l-query-was-opened = true
     7037           .
     7038       end.
     7039     end.
     7040     if l-filter-open-36 = false then do:
     7041       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     7042         where  TRUE
     7043          by X_c-obj-hist.chip-num
     7044         indexed-reposition
     7045     .
     7046         assign
     7047           l-query-was-opened = true
     7048         .
     7049     end.
     7050   end.
     7051   else do:
     7052     assign
     7053       v-doc-rec = recid( X_c-obj-hist )
     7054     .
     7055     do
     7056     on stop undo, leave
     7057     on error undo, leave
     7058     :
     7059       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     7060         assign
     7061         parameter-2-36 = (if p-find-next then "true":u else "false":u )
     7062         parameter-4-36 =
     7063           "where ":u + " TRUE " + " ":u + where-phrase-36 + " ":u + p-find-condition + " " + ""
     7064         parameter-5-36 = ""
     7065       .
     7066         run fltopend_fltfindd in this-procedure  (
     7067                             input this-procedure:handle
     7068                             ,input query br-obj-hist:handle
     7069                             ,input rowid(X_c-obj-hist)
     7070                             ,input logical(parameter-2-36)
     7071                             ,input no-lock
     7072                             ,input (buffer X_c-obj-hist:handle)
     7073                             ,input parameter-4-36
     7074                             ,input parameter-5-36
     7075                             ) no-error.
     7076         .
     7077         assign
     7078           v-doc-rec = integer(return-value)
     7079           v-fltopend-rowid[1] = ?
     7080         .
     7081       end.
     7082       else do:
     7083         assign
     7084         parameter-2-36 = (if p-find-next then "true":u else "false":u )
     7085         parameter-3-36 =  "FOR EACH X_c-obj-hist"
     7086         parameter-4-36 =
     7087           (
     7088             if (" TRUE " + " " + where-phrase-36) <> ""
     7089             then " TRUE " + " " + where-phrase-36
     7090             else "true"
     7091           )
     7092         parameter-5-36 = (" " + "" + " " + "" + " " + p-find-condition)
     7093         parameter-6-36 = if sort-phrase-36 = ''
     7094                              then
     7095           (
     7096           " " + "" +
     7097             " " + sort-column-phrase +
     7098           " " + " by X_c-obj-hist.chip-num  "
     7099           )
     7100                              else
     7101           (
     7102           " " + "" +
     7103             " " + sort-column-phrase +
     7104           " " + sort-phrase-36
     7105           )
     7106         parameter-7-36 =
     7107           " indexed-reposition  "
     7108       .
     7109         run fltopend_fltfindq in this-procedure  (
     7110                             input this-procedure:handle
     7111                             ,input query br-obj-hist:handle
     7112                             ,input logical(parameter-2-36)
     7113                             ,input no-lock
     7114                             ,input parameter-3-36
     7115                             ,input parameter-4-36
     7116                             ,input parameter-5-36
     7117                             ,input parameter-6-36
     7118                             ,input parameter-7-36
     7119                             ,output v-fltopend-rowid
     7120                             ) no-error.
     7121         .
     7122         v-doc-rec = ?.
     7123       end.
     7124       assign
     7125         l-query-was-opened = true
     7126       .
     7127     end.
     7128   end.
     7129     run waitfram-hide in this-procedure .
     7130     return true.
     7131   end.
     7132   function  getStsMark returns character (ists as int ):
     7133      return StatusMark:GetLabel(ists).
     7134   end.
     7135   function  getStsTh returns character (ists as int ):
     7136      return StatusTH:GetLabel(ists).
     7137   end.
     7138   function  getStsEdi returns character (ists as int ):
     7139      return if ists eq 0 then "" else StatusEDI:GetLabel(ists).
     7140   end.
     7141   function  getStsEdocType returns character (itype as int ):
     7142      return if itype eq 0 then "" else  EdocType:GetLabel(itype).
     7143   end.
     7144   procedure utd-proc :
     7145   define output parameter p-description as character no-undo .
     7146   define buffer current_c-utd for ub.c-utd  .
     7147   define variable v-mess as character no-undo.
     7148   do
     7149   on error undo, return error return-value
     7150   :
     7151     find first current_c-utd no-lock where
     7152                  current_c-utd.db-num = X_c-obj-hist.db-num
     7153              and current_c-utd.doc-id = X_c-obj-hist.doc-id
     7154             and current_c-utd.chip-num = X_c-obj-hist.chip-num
     7155             and current_c-utd.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     7156     if not avail current_c-utd then do:
     7157         v-mess = "Неверная ссылка на c-utd в таблице c-utd-head".
     7158         return error  v-mess .
     7159     end.
     7160   define variable v-label-param as character no-undo .
     7161     v-label-param =
     7162      "OrganizationExt"     + chr(4) + "ID организации в ЭДО"                              + chr(4) + "" + chr(8)
     7163    + "DocumentExt" + chr(4) + "ID документа в ЭДО"                          + chr(4) + "" + chr(8)
     7164    + "LoadDate"      + chr(4) + "Дата загрузки"    + chr(4) + "" + chr(8)
     7165    + "parentOrganizationExt"     + chr(4) + "ID организации в родительском документе в ЭДО"   + chr(4) + "" + chr(8)
     7166    + "parentDocumentExt"      + chr(4) + "ID родительского документа в ЭДО"                                + chr(4) + "" + chr(8)
     7167    + "RevocationStatus"       + chr(4) + "Статус аннулирования документа" + chr(4) + "" + chr(8)
     7168    + "RecipientResponseStatus"  + chr(4) + "Состояние ответного действия"        + chr(4) + "" + chr(8)
     7169    + "TypeId"  + chr(4) + "Тип документа ЭДО"                    + chr(4) + "" + chr(8)
     7170    + "CounteragentId"     + chr(4) + "Контрагент документа"                       + chr(4) + "" + chr(8)
     7171    + "CustomDocumentId"     + chr(4) + "Идентификатор документа, определяемый внешней системой"                       + chr(4) + "" + chr(8)
     7172    + "DocumentNumber"    + chr(4) + "Номер документа"                            + chr(4) + "" + chr(8)
     7173    + "DocumentDate"     + chr(4) + "Дата документа"                       + chr(4) + "" + chr(8)
     7174    + "Timestamp"    + chr(4) + "Дата и время создания в ЭДО"                            + chr(4) + "" + chr(8)
     7175    + "ReceiptStatus"     + chr(4) + "Состояние ИОП на документ"                       + chr(4) + "" + chr(8)
     7176    + "Direction"    + chr(4) + "Направление документа"                            + chr(4) + "" + chr(8)
     7177    + "ModifyDate"     + chr(4) + "Дата изменения"                       + chr(4) + "" + chr(8)
     7178    + "ModifyTime"     + chr(4) + "Время изменения"                       + chr(4) + "" + chr(8)
     7179    + "PackageId"    + chr(4) + "ID пакета в ЭДО"                            + chr(4) + "" + chr(8)
     7180    + "EDocType"     + chr(4) + "Тип документа"                       + chr(4) + "getStsEdocType" + chr(8)
     7181    + "AmendmentRequested"    + chr(4) + "Зарошена корректировка"                            + chr(4) + "" + chr(8)
     7182    + "BaseDocumentNumber"     + chr(4) + "Номер договора"                       + chr(4) + "" + chr(8)
     7183    + "BaseDocumentName"    + chr(4) + "Наименование договора"                            + chr(4) + "" + chr(8)
     7184    + "BaseDocumentDate"     + chr(4) + "Дата договора"                       + chr(4) + "" + chr(8)
     7185    + "cli-FnsParticipantId"    + chr(4) + "ID подразделения отправителя"                            + chr(4) + "" + chr(8)
     7186    + "cli-info"    + chr(4) + "Инф. отправителя"                            + chr(4) + "" + chr(8)
     7187    + "obj-FnsParticipantId"     + chr(4) + "ID подразделения получателя"                       + chr(4) + "" + chr(8)
     7188    + "obj-info"    + chr(4) + "Инф. получателя"                            + chr(4) + "" + chr(8)
     7189    + "sts"     + chr(4) + "Статус TH"                       + chr(4) + "getStsTh" + chr(8)
     7190    + "sts-edi"    + chr(4) + "Статус ЭДО"                            + chr(4) + "getStsEdi" + chr(8)
     7191    + "cli-type"    + chr(4) + "Тип отправителя"                            + chr(4) + "" + chr(8)
     7192    + "cli-code"     + chr(4) + "Код отправителя"                       + chr(4) + "" + chr(8)
     7193    + "host-code"    + chr(4) + "Фирма"                            + chr(4) + "" + chr(8)
     7194    + "obj-type"     + chr(4) + "Тип объекта"                       + chr(4) + "" + chr(8)
     7195    + "obj-code"    + chr(4) + "Код объекта"                            + chr(4) + "" + chr(8)
     7196    + "doc-code"    + chr(4) + "Номер накладной"                            + chr(4) + "" + chr(8)
     7197    + "total"    + chr(4) + "Сумма"                            + chr(4) + "" + chr(8)
     7198    + "comment"    + chr(4) + "Комментарий"                            + chr(4) + "" + chr(8)
     7199    + "Vat"    + chr(4) + "НДС"                            + chr(4) + "" + chr(8)
     7200    + "AdditInfo"        + chr(4) + "Ошибки"  + chr(4) + ""  + chr(8)
     7201    + "db-num"     + chr(4) + "db-num"  + chr(4) + "" + chr(8)
     7202    + "doc-id"     + chr(4) + "doc-id"  + chr(4) + "".
     7203     run proc-full-temp-changes in this-procedure (
     7204                                                  input current_c-utd.action = integer('1':U)
     7205                                                 ,input current_c-utd.action = integer('99':U)
     7206                                                 ,input  buffer current_c-utd:handle
     7207                                                 ,input  "utd"
     7208                                                 ,input  "DocumentExt,OrganizationExt,LoadDate,parentDocumentExt,parentOrganizationExt,RevocationStatus,RecipientResponseStatus,TypeId,CounteragentId,CustomDocumentId,DocumentNumber,DocumentDate,Timestamp,ReceiptStatus,Direction,ModifyDate,PackageId,EDocType,AmendmentRequested,BaseDocumentNumber,BaseDocumentName,BaseDocumentDate,cli-FnsParticipantId,cli-info,obj-FnsParticipantId,obj-info,sts,sts-edi,cli-type,cli-code,host-code,contract-code,obj-type,obj-code,ModifyTime,doc-code,AdditInfo,comment,db-num,doc-id"
     7209                                                 ,input  v-label-param).
     7210   end.
     7211   end procedure.
     7212   procedure utd-attr-proc :
     7213   define output parameter p-description as character no-undo .
     7214   define buffer current_c-utd-attr for ub.c-utd-attr  .
     7215   define variable v-mess as character no-undo.
     7216      do
     7217      on error undo, return error return-value
     7218      :
     7219        find first current_c-utd-attr no-lock where
     7220                     current_c-utd-attr.db-num = X_c-obj-hist.db-num
     7221                 and current_c-utd-attr.doc-id = X_c-obj-hist.doc-id
     7222                and current_c-utd-attr.attr-code = X_c-obj-hist.attr-code
     7223                and current_c-utd-attr.chip-num = X_c-obj-hist.chip-num
     7224                and current_c-utd-attr.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     7225        if not avail current_c-utd-attr then do:
     7226            v-mess = "Неверная ссылка на c-utd-attr в таблице c-utd-head".
     7227            return error  v-mess .
     7228        end.
     7229      define variable v-label-param as character no-undo .
     7230        v-label-param =
     7231         "attr-code"     + chr(4) + "атрибут"                              + chr(4) + "" + chr(8)
     7232       + "attr-value"        + chr(4) + "Значение атрибута"  + chr(4) + "" .
     7233        run proc-full-temp-changes in this-procedure (
     7234                                                     input current_c-utd-attr.action = integer('1':U)
     7235                                                    ,input current_c-utd-attr.action = integer('99':U)
     7236                                                    ,input  buffer current_c-utd-attr:handle
     7237                                                    ,input  "utd-attr"
     7238                                                    ,input  "attr-code,attr-value"
     7239                                                    ,input  v-label-param).
     7240      end.
     7241   end.
     7242   define variable mCheckType as character no-undo.
     7243   define variable mCodeErr as character no-undo.
     7244   function  err-text returns character (iCheckObj as character ):
     7245      return if iCheckObj  eq "" then "" else GetTextErrortype( mCheckType, mCodeErr, iCheckObj,"all").
     7246   end.
     7247   procedure utd-err-proc :
     7248   define output parameter p-description as character no-undo .
     7249   define buffer current_c-utd-err for ub.c-utd-err  .
     7250   define variable v-mess as character no-undo.
     7251   do
     7252   on error undo, return error return-value
     7253   :
     7254     find first current_c-utd-err no-lock where
     7255                  current_c-utd-err.db-num = X_c-obj-hist.db-num
     7256              and current_c-utd-err.doc-id = X_c-obj-hist.doc-id
     7257          and current_c-utd-err.CheckType = X_c-obj-hist.CheckType
     7258          and current_c-utd-err.CodeErr = X_c-obj-hist.CodeErr
     7259          and current_c-utd-err.CheckObj = X_c-obj-hist.CheckObj
     7260          and current_c-utd-err.reckey = X_c-obj-hist.reckey
     7261             and current_c-utd-err.chip-num = X_c-obj-hist.chip-num
     7262             and current_c-utd-err.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     7263     if not avail current_c-utd-err then do:
     7264         v-mess = "Неверная ссылка на c-utd в таблице c-utd-head".
     7265         return error  v-mess .
     7266     end.
     7267    mCheckType = current_c-utd-err.CheckType.
     7268    mCodeErr = current_c-utd-err.CodeErr.
     7269   define variable v-label-param as character no-undo .
     7270     v-label-param =
     7271      "CheckType"     + chr(4) + "Тип ошибки"                              + chr(4) + "" + chr(8)
