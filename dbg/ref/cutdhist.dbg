      881   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      882   procedure fltopend_fltopend :
      883   define input parameter p-parent-handle as handle no-undo .
      884   define input parameter p-qh as handle no-undo .
      885   define input parameter p-flt-open-open-query  as character no-undo .
      886   define input parameter p-where-cond as character no-undo .
      887   define input parameter p-use-indFIRST-query-tail as character no-undo .
      888   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      889   define input parameter p-indexed-reposition as character no-undo .
      890     do
      891     on error undo, return error
      892     :
      893   define variable v-prepare-string as character no-undo .
      894   define variable glog as logical no-undo .
      895   assign
      896   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      897                      p-where-cond + chr(32)  +
      898                      p-use-indFIRST-query-tail + chr(32) +
      899                      p-use-ind-sort-clmn-by + chr(32) +
      900                      p-indexed-reposition
      901   .
      902   assign
      903   glog = p-qh:query-prepare(v-prepare-string) no-error .
      904   if not glog
      905   or error-status:error then do:
      906     message error-status:get-message(1) view-as alert-box .
      907     undo, return error .
      908   end.
      909   assign
      910   glog = p-qh:query-open no-error .
      911   if not glog
      912   or error-status:error then do:
      913     message error-status:get-message(1) view-as alert-box .
      914     undo, return error .
      915   end.
      916     end.
      917   end procedure.
      918   procedure fltopend_fltfindd :
      919   define input parameter p-parent-handle as handle no-undo .
      920   define input parameter p-qh as handle no-undo .
      921   define input parameter p-rowid as rowid no-undo .
      922   define input parameter p-next as logical no-undo .
      923   define input parameter p-lock as integer no-undo .
      924   define input parameter p-bh as handle no-undo .
      925   define input parameter p-where-cond as character no-undo .
      926   define input parameter p-use-index-phrase as character no-undo .
      927   define variable glog as logical no-undo .
      928   define variable v-qh as handle no-undo .
      929   define variable v-bh as handle no-undo .
      930   define variable v-recid as recid no-undo .
      931   define variable v-prepare-string as character no-undo .
      932   do
      933   on error undo, return error
      934   on stop undo, return error
      935   :
      936     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      937     create buffer v-bh for table p-bh buffer-name p-bh:name.
      938     create query v-qh.
      939     v-qh:set-buffers(v-bh).
      940     v-prepare-string = substitute("for each &1 &2 &3"
      941                                     ,v-bh:name
      942                                     ,p-where-cond
      943                                     ,p-use-index-phrase).
      944     glog = v-qh:query-prepare(v-prepare-string) no-error.
      945     if not glog then do:
      946       delete object v-qh.
      947       delete object v-bh.
      948       undo, return error .
      949     end.
      950     glog = v-qh:query-open no-error .
      951     if not glog then do:
      952       delete object v-qh.
      953       delete object v-bh.
      954       undo, return error .
      955     end.
      956     if p-next then do:
      957       v-qh:reposition-to-rowid(p-rowid) no-error .
      958       glog = v-qh:get-next( p-lock) no-error .
      959       glog = v-qh:get-next( p-lock) no-error .
      960       if not glog or v-qh:query-off-end = yes then do:
      961         glog = v-qh:get-first( p-lock) no-error .
      962       end.
      963     end.
      964     else do:
      965       glog = v-qh:get-first( p-lock) no-error .
      966     end.
      967     v-recid = v-bh:recid no-error .
      968     delete object v-qh.
      969     delete object v-bh.
      970     return string(v-recid) .
      971   end.
      972   end procedure.
      973   procedure fltopend_fltfindq :
      974   define input parameter p-parent-handle as handle no-undo .
      975   define input parameter p-qh as handle no-undo .
      976   define input parameter p-next as logical no-undo .
      977   define input parameter p-lock as integer no-undo .
      978   define input parameter p-flt-open-open-query  as character no-undo .
      979   define input parameter p-where-cond as character no-undo .
      980   define input parameter p-use-indFIRST-query-tail as character no-undo .
      981   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      982   define input parameter p-indexed-reposition as character no-undo .
      983   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      984   define variable glog as logical no-undo .
      985   define variable v-qh as handle no-undo .
      986   define variable v-bh as handle no-undo extent 18.
      987   define variable v-rowid as rowid no-undo extent 18.
      988   define variable v-ii as integer no-undo .
      989   define variable v-prepare-string as character no-undo .
      990   do
      991   on error undo, return error
      992   on stop undo, return error
      993   :
      994     create query v-qh.
      995     do v-ii = 1 to p-qh:num-buffers:
      996       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      997       assign
      998       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      999       no-error.
     1000       v-qh:add-buffer(v-bh[v-ii]).
     1001     end.
     1002     assign
     1003     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1004                       p-where-cond + chr(32)  +
     1005                       p-use-indFIRST-query-tail + chr(32) +
     1006                       p-use-ind-sort-clmn-by + chr(32) +
     1007                       p-indexed-reposition
     1008     .
     1009     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1010     if not glog then do:
     1011       delete object v-qh.
     1012       do v-ii = 1 to p-qh:num-buffers:
     1013         delete object v-bh[v-ii].
     1014       end.
     1015       undo, return error .
     1016     end.
     1017     glog = v-qh:query-open no-error .
     1018     if not glog then do:
     1019       delete object v-qh.
     1020       do v-ii = 1 to p-qh:num-buffers:
     1021         delete object v-bh[v-ii].
     1022       end.
     1023       undo, return error .
     1024     end.
     1025     if p-next then do:
     1026       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1027       glog = v-qh:get-next( p-lock) no-error .
     1028       glog = v-qh:get-next( p-lock) no-error .
     1029       if not glog or v-qh:query-off-end = yes then do:
     1030         glog = v-qh:get-first( p-lock) no-error .
     1031       end.
     1032     end.
     1033     else do:
     1034       glog = v-qh:get-first( p-lock) no-error .
     1035     end.
     1036     do v-ii = 1 to p-qh:num-buffers:
     1037       assign
     1038       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1039       no-error.
     1040     end.
     1041     delete object v-qh.
     1042     do v-ii = 1 to p-qh:num-buffers:
     1043       delete object v-bh[v-ii].
     1044     end.
     1045   end.
     1046   end procedure.
