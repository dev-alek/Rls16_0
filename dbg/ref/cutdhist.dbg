     1067   define buffer X_clients-obj for ub.clients.
     1068   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1069   define   temp-table temp-changes no-undo
     1070   field f_name as character
     1071   field l_name as character
     1072   field v_old as character
     1073   field v_new as character
     1074   field t_name as character
     1075   field num_ as integer
     1076   field uniq-key-rec as character
     1077   field action as integer
     1078   field fNotChange as logical
     1079   index pi is unique primary
     1080   num_
     1081   t_name
     1082   f_name
     1083   index
     1084   Chan
     1085   fnotChange
     1086   t_name
     1087   f_name
     1088   index imain uniq-key-rec
     1089   .
     1090   FUNCTION get-all-fields returns character (p-file-name as character ):
     1091   define variable v-dop as character no-undo .
     1092     find first _file no-lock where _file._file-name = p-file-name no-error .
     1093     if not available _file then return "":U.
     1094     for each _field no-lock where
     1095              _field._file-recid = recid(_file) :
     1096       assign
     1097       v-dop = v-dop + _field._field-name + chr(44)
     1098       .
     1099     end.
     1100     return trim(v-dop).
     1101   END FUNCTION.
     1102   PROCEDURE proc-full-temp-changes :
     1103     define input  parameter p-act-create as logical   no-undo .
     1104     define input  parameter p-act-delete as logical   no-undo .
     1105     define input  parameter p-hst-handle as handle    no-undo .
     1106     define input  parameter p-main-table as character no-undo .
     1107     define input  parameter p-field-list as character no-undo .
     1108     define input  parameter p-label-form as character no-undo .
     1109     define variable h-new-buf         as handle    no-undo .
     1110     define variable h-main-buf        as handle    no-undo .
     1111     define variable h-for-comp        as handle    no-undo .
     1112     define variable v-inform          as character no-undo .
     1113     define variable v-ind             as integer   no-undo .
     1114     define variable v-idx-field-qnty  as integer   no-undo .
     1115     define variable v-num-entries     as integer   no-undo .
     1116     define variable fh                as handle    no-undo .
     1117     define variable fh-main           as handle    no-undo .
     1118     define variable fh-old            as handle    no-undo .
     1119     define variable fh-new            as handle    no-undo .
     1120     define variable v-field-name      as character no-undo .
     1121     define variable v-field-lvl       as character no-undo .
     1122     define variable v-field-form      as character no-undo .
     1123     define variable v-search-exp      as character no-undo .
     1124     define variable v-srch-main       as character no-undo .
     1125     define variable v-word-link       as character no-undo .
     1126     define variable v-av-chip-num     as logical   no-undo .
     1127     define variable v-main-pi-fld-lst as character no-undo .
     1128     define variable v-main-fld-lst    as character no-undo .
     1129     define variable v-delim-list      as character no-undo .
     1130     define variable v-label           as character no-undo .
     1131     define variable v-old-value       as character no-undo case-sensitive.
     1132     define variable v-new-value       as character no-undo case-sensitive.
     1133     define variable v-chg-fields as character no-undo.
     1134     for each temp-changes:
     1135       delete temp-changes.
     1136     end.
     1137     if not p-hst-handle:available then do:
     1138       return .
     1139     end.
     1140     create buffer h-new-buf  for table p-hst-handle .
     1141     create buffer h-main-buf for table p-main-table .
     1142     assign
     1143       v-inform = h-main-buf:index-information(1)
     1144       v-ind    = 2
     1145     .
     1146     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1147     on error undo, return error
     1148     :
     1149       assign
     1150         v-inform = h-main-buf:index-information( v-ind )
     1151         v-ind    = v-ind + 1
     1152       .
     1153     end.
     1154     if v-inform = ?
     1155       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1156       or entry( 3, v-inform, ",":U ) <> "1":U
     1157     then do:
     1158       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1159     end.
     1160     assign
     1161       v-idx-field-qnty = num-entries( v-inform ) - 4
     1162     .
     1163     if v-idx-field-qnty < 2 then do:
     1164       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1165     end.
     1166     assign
     1167       v-srch-main   = "where":U
     1168       v-word-link   = "":U
     1169       v-av-chip-num = false
     1170       v-delim-list  = "":U
     1171     .
     1172     do v-ind = 1 to v-idx-field-qnty by 2
     1173     on error undo, return error
     1174     :
     1175       assign
     1176         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1177         fh                = p-hst-handle:buffer-field( v-field-name )
     1178         fh-main           = h-main-buf:buffer-field( v-field-name )
     1179         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1180         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1181       .
     1182       if fh:data-type ="character":U then do:
     1183         assign
     1184           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1185         .
     1186       end.
     1187       else do:
     1188         assign
     1189           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1190         .
     1191       end.
     1192       if v-delim-list = "":U then do:
     1193         assign
     1194           v-delim-list = ",":U
     1195         .
     1196       end.
     1197       if v-word-link = "":U then do:
     1198         assign
     1199           v-word-link = "and":U
     1200         .
     1201       end.
     1202     end.
     1203     assign
     1204       v-delim-list  = "":U
     1205     .
     1206     do v-ind = 1 to h-main-buf:num-fields
     1207     on error undo, return error
     1208     :
     1209       assign
     1210         fh-main      = h-main-buf:buffer-field( v-ind )
     1211         v-field-name = fh-main:name
     1212       .
     1213         assign
     1214           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1215         .
     1216         if v-delim-list = "":U then do:
     1217           assign
     1218             v-delim-list = ",":U
     1219           .
     1220         end.
     1221     end.
     1222     assign
     1223       v-inform = p-hst-handle:index-information(1)
     1224       v-ind    = 2
     1225     .
     1226     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1227     on error undo, return error
     1228     :
     1229       assign
     1230         v-inform = p-hst-handle:index-information( v-ind )
     1231         v-ind    = v-ind + 1
     1232       .
     1233     end.
     1234     if v-inform = ?
     1235       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1236       or entry( 3, v-inform, ",":U ) <> "1":U
     1237     then do:
     1238       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1239     end.
     1240     assign
     1241       v-idx-field-qnty = num-entries( v-inform ) - 4
     1242     .
     1243     if v-idx-field-qnty < 2 then do:
     1244       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1245     end.
     1246     assign
     1247       v-search-exp  = "where":U
     1248       v-word-link   = "":U
     1249       v-av-chip-num = false
     1250     .
     1251     do v-ind = 1 to v-idx-field-qnty by 2
     1252     on error undo, return error
     1253     :
     1254       assign
     1255         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1256         fh           = p-hst-handle:buffer-field( v-field-name )
     1257         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1258       .
     1259       if v-field-name = "chip-num":U then do:
     1260         assign
     1261           v-search-exp  = substitute( "&1 >", v-search-exp )
     1262           v-av-chip-num = true
     1263         .
     1264       end.
     1265       else do:
     1266         assign
     1267           v-search-exp = substitute( "&1 =", v-search-exp )
     1268         .
     1269       end.
     1270       if fh:data-type ="character":U then do:
     1271         assign
     1272           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1273         .
     1274       end.
     1275       else do:
     1276         assign
     1277           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1278         .
     1279       end.
     1280       if v-word-link = "":U then do:
     1281         assign
     1282           v-word-link = "and":U
     1283         .
     1284       end.
     1285     end.
     1286     if v-av-chip-num = false then do:
     1287       message
     1288         vss-workfile vss-revision vss-description skip
     1289         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1290         "Использование данной процедуры невозможно!" skip
     1291         view-as alert-box error .
     1292       return error .
     1293     end.
     1294     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1295     if not h-new-buf:available then do:
     1296       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1297       if not h-main-buf:available then do:
     1298         assign
     1299           h-for-comp = ?
     1300         .
     1301       end.
     1302       else do:
     1303         assign
     1304           h-for-comp = h-main-buf
     1305         .
     1306       end.
     1307     end.
     1308     else do:
     1309       assign
     1310         h-for-comp = h-new-buf
     1311       .
     1312     end.
     1313     assign
     1314       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1315     .
     1316     do v-ind = 1 to v-num-entries
     1317     on error undo, return error return-value
     1318     :
     1319       assign
     1320         v-field-name = entry( v-ind, v-main-fld-lst )
     1321         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1322         v-old-value  = fh-old:buffer-value()
     1323         v-label      = trim( fh-old:label )
     1324       .
     1325       if ( trim( p-field-list ) <> "":U
     1326            and lookup( v-field-name, p-field-list ) > 0
     1327          )
     1328          or trim( p-field-list ) = "":U
     1329       then do:
     1330         if h-for-comp <> ? then do:
     1331           assign
     1332             fh-new      = h-for-comp:buffer-field( v-field-name )
     1333             v-new-value = fh-new:buffer-value()
     1334           .
     1335         end.
     1336         else do:
     1337           assign
     1338             v-new-value = "":U
     1339           .
     1340         end.
     1341           if p-act-create = true then do:
     1342             assign
     1343               v-old-value = "":U
     1344             .
     1345           end.
     1346           if p-act-delete = true then do:
     1347             assign
     1348               v-new-value = "":U
     1349             .
     1350           end.
     1351         if v-old-value <> v-new-value
     1352           or lookup(v-field-name,v-main-pi-fld-lst) ne 0
     1353         then do:
     1354           create temp-changes.
     1355           assign
     1356             temp-changes.t_name = p-main-table
     1357             temp-changes.f_name = v-field-name
     1358             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1359             temp-changes.v_old  = trim( v-old-value )
     1360             temp-changes.v_new  = trim( v-new-value )
     1361             temp-changes.num_   = 0
     1362             temp-changes.fNotChange = v-old-value eq v-new-value
     1363           .
     1364         end.
     1365       end.
     1366     end.
     1367     assign
     1368       v-num-entries = num-entries( p-label-form, chr(8) )
     1369     .
     1370     do v-ind = 1 to v-num-entries
     1371     on error undo, return error return-value
     1372     :
     1373       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1374         assign
     1375           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1376           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1377           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1378         .
     1379         find first temp-changes
     1380           where temp-changes.f_name = v-field-name
     1381           no-error .
     1382         if available temp-changes then do:
     1383           if trim( v-field-lvl ) <> "":U then do:
     1384             assign
     1385               temp-changes.l_name = v-field-lvl
     1386             .
     1387           end.
     1388           if trim( v-field-form ) <> "":U then do:
     1389             assign
     1390               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1391             .
     1392             if h-for-comp <> ? then do:
     1393               assign
     1394                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1395               .
     1396             end.
     1397           end.
     1398         end.
     1399       end.
     1400       else do:
     1401         message
     1402           vss-workfile vss-revision vss-description skip
     1403           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1404           substitute( "список для поля '&1': '&2'"
     1405                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1406                       ,entry( v-ind, p-label-form, chr(8) )
     1407                     ) skip
     1408           substitute( "полный список: &2", p-label-form ) skip
     1409           view-as alert-box error .
     1410       end.
     1411     end.
     1412     delete object h-new-buf .
     1413     delete object h-main-buf .
     1414   END PROCEDURE.
     1415   FUNCTION get-action RETURNS CHARACTER
     1416     ( p-action as integer )  FORWARD.
     1417   FUNCTION get-source-type RETURNS CHARACTER
     1418     ( p-source-type as character )  FORWARD.
     1419   FUNCTION get-subject RETURNS CHARACTER
     1420     ( p-subject as character )  FORWARD.
     1421   FUNCTION local-open-br RETURNS logical
     1422     (  p-open-query     as logical    ,
     1423     p-find-next       as logical    ,
     1424     p-find-condition as character )  FORWARD.
     1425   DEFINE BUTTON B-Help
     1426        LABEL "Помо&щь"
     1427        SIZE 3 BY 1
     1428        BGCOLOR 8 .
     1429   DEFINE BUTTON B-mark
     1430        LABEL "&*"
     1431        SIZE 3 BY 1.
     1432   DEFINE BUTTON B-print
     1433        LABEL "Пе&чать"
     1434        SIZE 3 BY 1.
     1435   DEFINE BUTTON b-quit AUTO-END-KEY
     1436        LABEL "&Выход"
     1437        SIZE 10 BY 1
     1438        BGCOLOR 8 .
     1439   DEFINE BUTTON b-reason
     1440        LABEL "&Причина"
     1441        SIZE 10 BY 1.
     1442   DEFINE BUTTON B-sch
     1443        LABEL "&Фильтр"
     1444        SIZE 3 BY 1.
     1445   DEFINE BUTTON b-sel AUTO-GO
     1446        LABEL "Вы&бор"
     1447        SIZE 10 BY 1
     1448        BGCOLOR 8 .
     1449   DEFINE BUTTON b-nextlevel
     1450        LABEL "Детали"
     1451        SIZE 10 BY 1
     1452        BGCOLOR 8 .
     1453   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1454         VIEW-AS TEXT
     1455        SIZE 6 BY 1
     1456        FGCOLOR 4  NO-UNDO.
     1457   DEFINE VARIABLE sch-obj-code AS CHARACTER FORMAT "X(50)":U
     1458        LABEL "коду"
     1459        VIEW-AS FILL-IN
     1460        SIZE 10 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1461   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1462        LABEL "Дате изменения"
     1463        VIEW-AS FILL-IN
     1464        SIZE 11 BY 1 NO-UNDO.
     1465   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1466        LABEL "пользователю"
     1467        VIEW-AS FILL-IN
     1468        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1469   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1470        LABEL "БД"
     1471        VIEW-AS FILL-IN
     1472        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1473   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1474        LABEL "по БД"
     1475        VIEW-AS FILL-IN
     1476        SIZE 6 BY 1 NO-UNDO.
     1477   DEFINE QUERY BR-changes FOR
     1478         temp-changes SCROLLING.
     1479   DEFINE QUERY br-obj-hist FOR
     1480         X_c-obj-hist SCROLLING.
     1481   DEFINE BROWSE BR-changes
     1482     QUERY BR-changes DISPLAY
     1483         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(200)" width 40
     1484   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1485   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1486       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1487   DEFINE BROWSE br-obj-hist
     1488     QUERY br-obj-hist NO-LOCK DISPLAY
     1489         mark-string(recid(X_c-obj-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1490         X_c-obj-hist.db-num COLUMN-LABEL 'БД' FORMAT '>>9':U
     1491                         X_c-obj-hist.doc-id COLUMN-LABEL 'Внутр.№' FORMAT '>>>>>>>>9':U
     1492         X_c-obj-hist.corr-date FORMAT "99/99/9999":U COLUMN-LABEL "Дата изм."
     1493         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1494         usrfulnf(X_c-obj-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1495         get-action(X_c-obj-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1496         X_c-obj-hist.corr-user-db-num FORMAT ">>>>9":U COLUMN-LABEL "Дб!созд."
     1497         X_c-obj-hist.is-news FORMAT "+/":U COLUMN-LABEL "Прием.!нов."
     1498         get-source-type(X_c-obj-hist.source-type) COLUMN-LABEL "Источн.!измен." WIDTH 7
     1499         X_c-obj-hist.source-ref FORMAT "X(20)":U COLUMN-LABEL "Ссылка на!источник." WIDTH 9
     1500          get-subject(X_c-obj-hist.subject) COLUMN-LABEL "Предмет изменения" FORMAT "X(35)":U WIDTH 15
     1501     ENABLE
     1502         X_c-obj-hist.corr-date
     1503       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1504   DEFINE FRAME Dialog-Frame
     1505        b-quit AT ROW 1 COL 1
     1506        B-mark AT ROW 1 COL 11
     1507        b-sel AT ROW 1 COL 21
     1508        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1509        b-nextlevel AT ROW 1 COL 70
     1510        b-reason AT ROW 1 COL 59
     1511        B-print AT ROW 1 COL 89
     1512        B-sch AT ROW 1 COL 92
     1513        B-Help AT ROW 1 COL 95
     1514        br-obj-hist AT ROW 2 COL 1
     1515        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1516        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1517        sch-obj-code AT ROW 13.67 COL 45.13 COLON-ALIGNED
     1518        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1519        BR-changes AT ROW 14.79 COL 1
     1520        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1521        "ПОИСК ПО" VIEW-AS TEXT
     1522             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1523             FGCOLOR 4
     1524        SPACE(89.48) SKIP(7.44)
     1525       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1526            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1527            TITLE
     1528            vLabel
     1529            CANCEL-BUTTON b-quit.
     1530   ASSIGN
     1531          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1532          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1533   ASSIGN
     1534          br-obj-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1535   ON GO OF FRAME Dialog-Frame
     1536   DO:
     1537     p-rid-list = v-rid-list.
     1538   END.
     1539   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1540   DO:
     1541     APPLY "END-ERROR":U TO SELF.
     1542   END.
     1543   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1544   DO:
     1545   define variable loc#log as logical no-undo .
     1546     if available X_c-obj-hist then do:
     1547   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1548   define variable v-str-recid15 as character no-undo .
     1549   define variable v-num-entry15 as integer   no-undo .
     1550   assign
     1551     v-str-recid15 = trim( string( recid( X_c-obj-hist ) , "->>>>>>>>>>>9":U ) )
     1552     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1553   .
     1554   if v-num-entry15 > 0 then do:
     1555     assign
     1556       entry( v-num-entry15, v-rid-list ) = "":U
     1557       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1558     .
     1559   end.
     1560   else do:
     1561     assign
     1562       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1563     .
     1564   end.
     1565       loc#log = br-obj-hist:refresh() .
     1566       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1567           loc#log = br-obj-hist:select-next-row ().
     1568           apply "VALUE-CHANGED" to br-obj-hist in frame Dialog-Frame.
     1569       end.
     1570       if num-entries( v-rid-list ) = 0
     1571       then
     1572           hide mark-num in frame Dialog-Frame.
     1573       else
     1574           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1575     end.
     1576     apply "entry" to br-obj-hist in frame Dialog-Frame.
     1577   END.
     1578   ON CHOOSE OF b-nextlevel IN FRAME Dialog-Frame
     1579   DO:
     1580      define variable vRun as character no-undo.
