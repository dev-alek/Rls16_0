      674         ).
      675   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      677     (input  v-report-name
      678     ,input  2
      679     ,output v-exist
      680     )  .
      681       if NOT v-exist then
      682       DO:
      683         Message
      684           "Нет заданий на печать ! "
      685           view-as alert-box .
      686         Return  .
      687       End.
      688       run gbl/prnfilen.w
      689         (input  ""
      690         ,input  p-DisabledOptions
      691         ,input  string(v-report-name )
      692         ,input  7
      693         ,output v-user-action
      694         ,output v-printed
      695         ) .
      696       if v-printed then
