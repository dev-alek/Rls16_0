      617   procedure fltfield-clear :
      618     define output parameter loc-fld as character no-undo.
      619     define output parameter loc-lab as character no-undo .
      620     define output parameter loc-spr as character no-undo .
      621     define output parameter loc-dim as character no-undo .
      622     assign
      623       loc-fld = ""
      624       loc-lab = ""
      625       loc-spr = ""
      626       loc-dim = "0"
      627     .
      628   end procedure .
      629   procedure fltfield-add :
      630     define input        parameter par-fld as character no-undo.
      631     define input        parameter par-lab as character no-undo .
      632     define input        parameter par-spr as character no-undo .
      633     define input-output parameter loc-fld as character no-undo.
      634     define input-output parameter loc-lab as character no-undo .
      635     define input-output parameter loc-spr as character no-undo .
      636     define input-output parameter loc-dim as character no-undo .
      637     do
      638     on error undo, return error
      639     :
      640       assign
      641       loc-fld = if loc-dim = '0'
      642                 then par-fld
      643                 else (loc-fld + chr(44) + par-fld)
      644       loc-lab = if loc-dim = '0'
      645                 then par-lab
      646                 else (loc-lab + chr(44) + par-lab)
      647       loc-spr = if loc-dim = '0'
      648                 then par-spr
      649                 else (loc-spr + chr(44) + par-spr)
      650       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      651                 string(integer(if num-entries(loc-dim) > 1
      652                               then entry(2, loc-dim)
      653                               else entry(1, loc-dim)
      654                               ) + 1)
      655       no-error
      656       .
      657     end.
      658   end procedure.
