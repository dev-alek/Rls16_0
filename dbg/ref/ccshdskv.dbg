      628   define variable v-chg-fields as character no-undo.
      629   define variable v-old-fields as character no-undo.
      630   define variable v-new-fields as character no-undo.
      631   define variable ii as integer no-undo.
      632   define variable v-mess as character no-undo .
      633   define buffer buf_c-cash-desk for ub.c-cash-desk.
      634   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635   define SHARED temp-table temp-changes no-undo
      636   field f_name as character
      637   field l_name as character
      638   field v_old as character
      639   field v_new as character
      640   field t_name as character
      641   field num_ as integer
      642   field uniq-key-rec as character
      643   field action as integer
      644   field fNotChange as logical
      645   index pi is unique primary
      646   num_
      647   t_name
      648   f_name
      649   index
      650   Chan
      651   fnotChange
      652   t_name
      653   f_name
      654   index imain uniq-key-rec
      655   .
      656   FUNCTION get-all-fields returns character (p-file-name as character ):
      657   define variable v-dop as character no-undo .
      658     find first _file no-lock where _file._file-name = p-file-name no-error .
      659     if not available _file then return "":U.
      660     for each _field no-lock where
      661              _field._file-recid = recid(_file) :
      662       assign
      663       v-dop = v-dop + _field._field-name + chr(44)
      664       .
      665     end.
      666     return trim(v-dop).
      667   END FUNCTION.
      668   PROCEDURE proc-full-temp-changes :
      669     define input  parameter p-act-create as logical   no-undo .
      670     define input  parameter p-act-delete as logical   no-undo .
      671     define input  parameter p-hst-handle as handle    no-undo .
      672     define input  parameter p-main-table as character no-undo .
      673     define input  parameter p-field-list as character no-undo .
      674     define input  parameter p-label-form as character no-undo .
      675     define variable h-new-buf         as handle    no-undo .
      676     define variable h-main-buf        as handle    no-undo .
      677     define variable h-for-comp        as handle    no-undo .
      678     define variable v-inform          as character no-undo .
      679     define variable v-ind             as integer   no-undo .
      680     define variable v-idx-field-qnty  as integer   no-undo .
      681     define variable v-num-entries     as integer   no-undo .
      682     define variable fh                as handle    no-undo .
      683     define variable fh-main           as handle    no-undo .
      684     define variable fh-old            as handle    no-undo .
      685     define variable fh-new            as handle    no-undo .
      686     define variable v-field-name      as character no-undo .
      687     define variable v-field-lvl       as character no-undo .
      688     define variable v-field-form      as character no-undo .
      689     define variable v-search-exp      as character no-undo .
      690     define variable v-srch-main       as character no-undo .
      691     define variable v-word-link       as character no-undo .
      692     define variable v-av-chip-num     as logical   no-undo .
      693     define variable v-main-pi-fld-lst as character no-undo .
      694     define variable v-main-fld-lst    as character no-undo .
      695     define variable v-delim-list      as character no-undo .
      696     define variable v-label           as character no-undo .
      697     define variable v-old-value       as character no-undo case-sensitive.
      698     define variable v-new-value       as character no-undo case-sensitive.
      699     define variable v-chg-fields as character no-undo.
      700     for each temp-changes:
      701       delete temp-changes.
      702     end.
      703     if not p-hst-handle:available then do:
      704       return .
      705     end.
      706     create buffer h-new-buf  for table p-hst-handle .
      707     create buffer h-main-buf for table p-main-table .
      708     assign
      709       v-inform = h-main-buf:index-information(1)
      710       v-ind    = 2
      711     .
      712     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      713     on error undo, return error
      714     :
      715       assign
      716         v-inform = h-main-buf:index-information( v-ind )
      717         v-ind    = v-ind + 1
      718       .
      719     end.
      720     if v-inform = ?
      721       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      722       or entry( 3, v-inform, ",":U ) <> "1":U
      723     then do:
      724       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      725     end.
      726     assign
      727       v-idx-field-qnty = num-entries( v-inform ) - 4
      728     .
      729     if v-idx-field-qnty < 2 then do:
      730       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      731     end.
      732     assign
      733       v-srch-main   = "where":U
      734       v-word-link   = "":U
      735       v-av-chip-num = false
      736       v-delim-list  = "":U
      737     .
      738     do v-ind = 1 to v-idx-field-qnty by 2
      739     on error undo, return error
      740     :
      741       assign
      742         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      743         fh                = p-hst-handle:buffer-field( v-field-name )
      744         fh-main           = h-main-buf:buffer-field( v-field-name )
      745         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      746         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      747       .
      748       if fh:data-type ="character":U then do:
      749         assign
      750           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      751         .
      752       end.
      753       else do:
      754         assign
      755           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      756         .
      757       end.
      758       if v-delim-list = "":U then do:
      759         assign
      760           v-delim-list = ",":U
      761         .
      762       end.
      763       if v-word-link = "":U then do:
      764         assign
      765           v-word-link = "and":U
      766         .
      767       end.
      768     end.
      769     assign
      770       v-delim-list  = "":U
      771     .
      772     do v-ind = 1 to h-main-buf:num-fields
      773     on error undo, return error
      774     :
      775       assign
      776         fh-main      = h-main-buf:buffer-field( v-ind )
      777         v-field-name = fh-main:name
      778       .
      779         assign
      780           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      781         .
      782         if v-delim-list = "":U then do:
      783           assign
      784             v-delim-list = ",":U
      785           .
      786         end.
      787     end.
      788     assign
      789       v-inform = p-hst-handle:index-information(1)
      790       v-ind    = 2
      791     .
      792     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      793     on error undo, return error
      794     :
      795       assign
      796         v-inform = p-hst-handle:index-information( v-ind )
      797         v-ind    = v-ind + 1
      798       .
      799     end.
      800     if v-inform = ?
      801       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      802       or entry( 3, v-inform, ",":U ) <> "1":U
      803     then do:
      804       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      805     end.
      806     assign
      807       v-idx-field-qnty = num-entries( v-inform ) - 4
      808     .
      809     if v-idx-field-qnty < 2 then do:
      810       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      811     end.
      812     assign
      813       v-search-exp  = "where":U
      814       v-word-link   = "":U
      815       v-av-chip-num = false
      816     .
      817     do v-ind = 1 to v-idx-field-qnty by 2
      818     on error undo, return error
      819     :
      820       assign
      821         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      822         fh           = p-hst-handle:buffer-field( v-field-name )
      823         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      824       .
      825       if v-field-name = "chip-num":U then do:
      826         assign
      827           v-search-exp  = substitute( "&1 >", v-search-exp )
      828           v-av-chip-num = true
      829         .
      830       end.
      831       else do:
      832         assign
      833           v-search-exp = substitute( "&1 =", v-search-exp )
      834         .
      835       end.
      836       if fh:data-type ="character":U then do:
      837         assign
      838           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      839         .
      840       end.
      841       else do:
      842         assign
      843           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      844         .
      845       end.
      846       if v-word-link = "":U then do:
      847         assign
      848           v-word-link = "and":U
      849         .
      850       end.
      851     end.
      852     if v-av-chip-num = false then do:
      853       message
      854         vss-workfile vss-revision vss-description skip
      855         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      856         "Использование данной процедуры невозможно!" skip
      857         view-as alert-box error .
      858       return error .
      859     end.
      860     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      861     if not h-new-buf:available then do:
      862       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      863       if not h-main-buf:available then do:
      864         assign
      865           h-for-comp = ?
      866         .
      867       end.
      868       else do:
      869         assign
      870           h-for-comp = h-main-buf
      871         .
      872       end.
      873     end.
      874     else do:
      875       assign
      876         h-for-comp = h-new-buf
      877       .
      878     end.
      879     assign
      880       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      881     .
      882     do v-ind = 1 to v-num-entries
      883     on error undo, return error return-value
      884     :
      885       assign
      886         v-field-name = entry( v-ind, v-main-fld-lst )
      887         fh-old       = p-hst-handle:buffer-field( v-field-name )
      888         v-old-value  = fh-old:buffer-value()
      889         v-label      = trim( fh-old:label )
      890       .
      891       if ( trim( p-field-list ) <> "":U
      892            and lookup( v-field-name, p-field-list ) > 0
      893          )
      894          or trim( p-field-list ) = "":U
      895       then do:
      896         if h-for-comp <> ? then do:
      897           assign
      898             fh-new      = h-for-comp:buffer-field( v-field-name )
      899             v-new-value = fh-new:buffer-value()
      900           .
      901         end.
      902         else do:
      903           assign
      904             v-new-value = "":U
      905           .
      906         end.
      907           if p-act-create = true then do:
      908             assign
      909               v-old-value = "":U
      910             .
      911           end.
      912           if p-act-delete = true then do:
      913             assign
      914               v-new-value = "":U
      915             .
      916           end.
      917         if v-old-value <> v-new-value
      918         then do:
      919           create temp-changes.
      920           assign
      921             temp-changes.t_name = p-main-table
      922             temp-changes.f_name = v-field-name
      923             temp-changes.l_name = replace( v-label, "&":U, "":U )
      924             temp-changes.v_old  = trim( v-old-value )
      925             temp-changes.v_new  = trim( v-new-value )
      926             temp-changes.num_   = 0
      927             temp-changes.fNotChange = v-old-value eq v-new-value
      928           .
      929         end.
      930       end.
      931     end.
      932     assign
      933       v-num-entries = num-entries( p-label-form, chr(8) )
      934     .
      935     do v-ind = 1 to v-num-entries
      936     on error undo, return error return-value
      937     :
      938       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      939         assign
      940           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      941           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      942           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      943         .
      944         find first temp-changes
      945           where temp-changes.f_name = v-field-name
      946           no-error .
      947         if available temp-changes then do:
      948           if trim( v-field-lvl ) <> "":U then do:
      949             assign
      950               temp-changes.l_name = v-field-lvl
      951             .
      952           end.
      953           if trim( v-field-form ) <> "":U then do:
      954             assign
      955               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      956             .
      957             if h-for-comp <> ? then do:
      958               assign
      959                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      960               .
      961             end.
      962           end.
      963         end.
      964       end.
      965       else do:
      966         message
      967           vss-workfile vss-revision vss-description skip
      968           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      969           substitute( "список для поля '&1': '&2'"
      970                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      971                       ,entry( v-ind, p-label-form, chr(8) )
      972                     ) skip
      973           substitute( "полный список: &2", p-label-form ) skip
      974           view-as alert-box error .
      975       end.
      976     end.
      977     delete object h-new-buf .
      978     delete object h-main-buf .
      979   END PROCEDURE.
      980   if p-action = integer('99':U) then return.
      981   find first buf_c-cash-desk no-lock where
      982             buf_c-cash-desk.db-num   = p-db-num
      983         AND buf_c-cash-desk.obj-code = p-obj-code
      984         AND buf_c-cash-desk.pos-type = p-pos-type
      985         AND buf_c-cash-desk.cash-num = p-cash-num
      986         AND buf_c-cash-desk.chip-num = p-chip-num
      987         AND buf_c-cash-desk.corr-user-db-num = p-corr-user-db-num
      988         no-error .
      989   if not available buf_c-cash-desk then do:
      990     return error .
      991   end.
      992   CASE p-subject:
      993     when 'cash-desk':U or when "":U then do:
      994       run cash-desk-proc in this-procedure(output p-description) no-error .
      995     end.
      996     when 'cash-desk-attr':U then do:
      997       run cash-desk-attr-proc in this-procedure(output p-description) no-error .
      998     end.
      999   END CASE.
     1000   if error-status:error then do:
     1001     return error .
     1002   end.
     1003   procedure cash-desk-proc :
     1004   define output parameter p-description as character no-undo .
     1005   define buffer current_c-cash-desk for ub.c-cash-desk  .
     1006     do
     1007     on error undo, return error
     1008     :
     1009       find first current_c-cash-desk no-lock where
     1010                  current_c-cash-desk.db-num   = p-db-num
     1011              AND current_c-cash-desk.obj-code = p-obj-code
     1012              AND current_c-cash-desk.pos-type = p-pos-type
     1013              AND current_c-cash-desk.cash-num = p-cash-num
     1014              AND current_c-cash-desk.corr-user-db-num = p-corr-user-db-num
     1015              AND current_c-cash-desk.chip-num = p-chip-num
     1016              no-error .
     1017       if not avail current_c-cash-desk then do:
     1018          v-mess = "Неверная ссылка на c-cash-desk в таблице c-cash-desk".
     1019          run err-mess in this-procedure ( input-output v-mess).
     1020          return error (if p-silent then v-mess else '':U).
     1021       end.
     1022       define variable v-label-param as character no-undo .
     1023   v-label-param =
     1024     "addr-path" + chr(4) + "Адрес/путь к кассе" + chr(4) + "" + chr(8)
     1025    + "autonomy" + chr(4) + "Автономность" + chr(4) + "" + chr(8)
     1026    + "cash-num" + chr(4) + "Номер кассы" + chr(4) + "" + chr(8)
     1027    + "cash-on" + chr(4) + "Вкл/выкл" + chr(4) + "" + chr(8)
     1028    + "cash-os" + chr(4) + "ОС" + chr(4) + "" + chr(8)
     1029    + "db-num" + chr(4) + "БД" + chr(4) + "" + chr(8)
     1030    + "is-del" + chr(4) + "Касса удалена" + chr(4) + "" + chr(8)
     1031    + "obj-code" + chr(4) + "Магазин" + chr(4) + "" + chr(8)
     1032    + "pos-type" + chr(4) + "Тип" + chr(4) + "" + chr(8)
     1033    + "remote" + chr(4) + "Удаленная" + chr(4) + "" + chr(8)
     1034    + "version" + chr(4) + "Версия ПО" + chr(4) + "" + chr(8)
     1035    + "registration-code" + chr(4) + "Регистр.№" + chr(4) + "" + chr(8)
     1036    + "serial-code" + chr(4) + "Сер.№" + chr(4) + ""  .
     1037    run proc-full-temp-changes in this-procedure (
     1038                                                input  (buf_c-cash-desk.action = integer('1':U))
     1039                                               ,input  (buf_c-cash-desk.action = integer('99':U))
     1040                                               ,input  buffer current_c-cash-desk:handle
     1041                                               ,input  'cash-desk':U
     1042                                               ,input  "addr-path,autonomy,cash-num,cash-on,cash-os,db-num,is-del,obj-code,pos-type,remote,version,registration-code,serial-code"
     1043                                               ,input  v-label-param).
     1044    end.
     1045   end procedure.
     1046   procedure cash-desk-attr-proc :
     1047   define output parameter p-description as character no-undo .
     1048   define variable v-tooltip as character no-undo .
     1049   define variable v-label as character no-undo .
     1050   define buffer current_c-cash-desk-attr for ub.c-cash-desk-attr  .
     1051     do
     1052     on error undo, return error
     1053     :
     1054       find first current_c-cash-desk-attr no-lock where
     1055                  current_c-cash-desk-attr.db-num   = p-db-num
     1056              AND current_c-cash-desk-attr.obj-code = p-obj-code
     1057              AND current_c-cash-desk-attr.pos-type = p-pos-type
     1058              AND current_c-cash-desk-attr.cash-num = p-cash-num
     1059              AND current_c-cash-desk-attr.corr-user-db-num = p-corr-user-db-num
     1060              AND current_c-cash-desk-attr.chip-num = p-chip-num
     1061              AND current_c-cash-desk-attr.attr-code  = buf_c-cash-desk.attr-code
     1062              no-error .
     1063       if not avail current_c-cash-desk-attr then do:
     1064          v-mess = "Неверная ссылка на c-cash-desk-attr в таблице c-cash-desk".
     1065          run err-mess in this-procedure ( input-output v-mess).
     1066          return error (if p-silent then v-mess else '':U).
     1067       end.
     1068       run cd-attr-tooltip in this-procedure (
     1069                    input  current_c-cash-desk-attr.upper-attr-code
     1070                   ,input  current_c-cash-desk-attr.attr-code
     1071                   ,output v-tooltip
     1072                   ,output v-label
     1073                   ) no-error .
     1074       assign
     1075       p-description = "Атрибут" + chr(32) + v-label
     1076       .
     1077       define variable v-label-param as character no-undo .
     1078   v-label-param =
     1079     "cash-num" + chr(4) + "Номер кассы" + chr(4) + "" + chr(8)
     1080    + "db-num" + chr(4) + "БД" + chr(4) + "" + chr(8)
     1081    + "obj-code" + chr(4) + "Магазин" + chr(4) + "" + chr(8)
     1082    + "pos-type" + chr(4) + "Тип" + chr(4) + "" + chr(8)
     1083    + "attr-code" + chr(4) + "Атрибут" + chr(4) + "" + chr(8)
     1084    + "upper-attr-code" + chr(4) + "Секция" + chr(4) + "" + chr(8)
     1085    + "attr-value" + chr(4) + "Значение атрибута" + chr(4) + ""  .
     1086    run proc-full-temp-changes in this-procedure (
     1087                                                input  (buf_c-cash-desk.action = integer('1':U))
     1088                                               ,input  (buf_c-cash-desk.action = integer('99':U))
     1089                                               ,input  buffer current_c-cash-desk-attr:handle
     1090                                               ,input  'cash-desk-attr':U
     1091                                               ,input  "cash-num,db-num,obj-code,pos-type,attr-code,upper-attr-code,attr-value"
     1092                                               ,input  v-label-param).
     1093   end.
     1094   end procedure.
     1095   PROCEDURE err-mess:
     1096     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     1097     CASE p-silent:
     1098       when yes then do:
     1099         p-mess =  substitute("История кассы  БД&1 маг&2 тип &3 касса №4: щепка &5 Предмет изменений &6&7&8"
     1100                    , p-db-num
     1101                    , p-obj-code
     1102                    , p-pos-type
     1103                    , p-cash-num
     1104                    , p-chip-num
     1105                    , p-subject
     1106                    , chr(10)
     1107                    , p-mess).
     1108       end.
     1109       otherwise do:
     1110         message
     1111         p-mess
     1112         view-as alert-box error .
     1113       end.
     1114     end.
     1115   END PROCEDURE.
