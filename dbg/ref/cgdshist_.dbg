        1   define input  parameter iGdsCode like ub.goods.gds-code no-undo.
        2   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
        3   run gbl/getobjsrvhndl.p (input-output ObjSrv).
        4   DEFINE BUFFER X_c-obj-hist FOR c-gds-hist.
        5   DEFINE BUFFER find_c-obj-hist FOR c-gds-hist.
        6   DEFINE BUFFER X_curr-sysconf FOR sysconf.
        7   DEFINE BUFFER X_db FOR db.
        8   DEFINE BUFFER X_sysconf FOR sysconf.
        9   define input     parameter parParentProc  as widget-handle no-undo.
       10   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
       11   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       12   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       13   define input parameter bttns  as char   no-undo .
       14   define input parameter p-mode  as char   no-undo .
       15   define input parameter p-corr-user-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       16   define input parameter p-corr-user-name  like ub.c-cli-hist.corr-user-name no-undo .
       17   define input parameter p-subject  like ub.c-cli-hist.subject no-undo .
       18   define input parameter p-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       19   define input parameter p-chip-num  as int64 no-undo.
       20   define input-output param p-rid-list    as  char no-undo .
       21   run ref/cgdshist.w (
       22         input parParentProc
       23       , input p-curr-host-code
       24       , input p-curr-obj-type
       25       , input p-curr-obj-code
       26       , input bttns
       27       , input p-mode
       28       , input iGdsCode
       29       , input ?
       30       , input ?
       31       , input ?
       32       , input p-corr-user-db-num
       33       , input p-corr-user-name
       34       , input p-subject
       35       , input p-db-num
       36       , input-output p-rid-list  ) no-error .
