        1   DEFINE TEMP-TABLE tt_pay-type NO-UNDO LIKE ub.pay-type.
        2   define input        parameter parparentproc as widget-handle no-undo .
        3   define input        parameter ref-mode      as character     no-undo .
        4   define input-output parameter rid           as recid         no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Форма редактирования вида оплаты".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   DEFINE BUTTON b-cancel AUTO-END-KEY
      115        LABEL "&Отмена"
      116        SIZE 10 BY 1.
      117   DEFINE BUTTON B-help
      118        LABEL "Помо&щь"
      119        SIZE 10 BY 1.
      120   DEFINE BUTTON B-hist
      121        LABEL "Ис&тория"
      122        SIZE 10 BY 1.
      123   DEFINE BUTTON b-OK AUTO-GO
      124        LABEL "&Ввод "
      125        SIZE 10 BY 1.
      126   DEFINE QUERY d-pay-type FOR
      127         tt_pay-type SCROLLING.
      128   DEFINE FRAME d-pay-type
      129        b-OK AT ROW 1 COL 1
      130        b-cancel AT ROW 1 COL 11
      131        B-hist AT ROW 1 COL 31
      132        B-help AT ROW 1 COL 51
      133        tt_pay-type.obj-code AT ROW 2.5 COL 8.5 COLON-ALIGNED
      134             LABEL "&Код"
      135             VIEW-AS FILL-IN
      136             SIZE 6 BY 1
      137        tt_pay-type.obj-name AT ROW 3.75 COL 8.5 COLON-ALIGNED
      138             LABEL "О&плата"
      139             VIEW-AS FILL-IN
      140             SIZE 41 BY 1
      141        SPACE(11.12) SKIP(0.82)
      142       WITH VIEW-AS DIALOG-BOX
      143            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      144            TITLE "О П Л А Т А".
      145   ASSIGN
      146          FRAME d-pay-type:SCROLLABLE       = FALSE.
      147   ON CHOOSE OF B-hist IN FRAME d-pay-type
      148   DO:
      149       define variable v-rid-list as character no-undo .
      150           run ref/cpaytyps.w (
      151                        INPUT parparentproc
      152                       ,INPUT '':U
      153                       ,INPUT 'one':U
      154                       ,INPUT tt_pay-type.obj-code
      155                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      156   END.
      157   ON CHOOSE OF b-OK IN FRAME d-pay-type
      158   DO:
      159     assign
      160       tt_pay-type.obj-code
      161       tt_pay-type.obj-name
      162       .
      163      run ref/paytype1.p
      164        ( input-output rid
      165        , input ref-mode
      166        , input no
      167        , input tt_pay-type.obj-code
      168        , input tt_pay-type.obj-name
      169        ) no-error.
      170     if error-status:error then do:
      171       if return-value = "":U then do:
      172         return no-apply.
      173       end.
      174       case return-value:
      175         when "obj-code":U then do:
      176           APPLY "ENTRY" to tt_pay-type.obj-code .
      177         end.
      178         when "obj-name":U then do:
      179           APPLY "ENTRY" to tt_pay-type.obj-name .
      180         end.
      181       end.
      182       return no-apply.
      183     end.
      184   END.
      185   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-pay-type:PARENT eq ?
      186   THEN FRAME d-pay-type:PARENT = ACTIVE-WINDOW.
      187   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      188   on help of frame d-pay-type
      189   do:
      190     run gbl/app_help.p
      191       (input this-procedure :file-name
      192       ,input ''
      193       ,input ?
      194       ) no-error.
      195     if error-status :error then do:
      196       message
      197         "Ошибка при вызове помощи"
      198         error-status :get-message(1)
      199         view-as alert-box .
      200     end.
      201   end.
      202   run minbtn-set in this-procedure .
      203   on choose of b-help in frame d-pay-type
      204   do:
      205     apply "help":u to frame d-pay-type .
      206   end.
      207   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      208   procedure minbtn-set :
      209       do
      210           on error undo, return error return-value
      211           :
      212           define variable ii              as integer       no-undo .
      213           define variable fh              as widget-handle no-undo .
      214           define variable hh              as widget-handle no-undo .
      215           define variable v-h             as handle        extent 4 no-undo .
      216           define variable v-name-button   as character     no-undo .
      217           define variable v-help-old-x    as decimal       no-undo .
      218           define variable v-help-old-y    as decimal       no-undo .
      219           define variable v-help-old-size as decimal       no-undo .
      220           define variable v-frame-width   as decimal       no-undo .
      221           define variable jj              as integer       no-undo .
      222           do
      223               on error undo, return error
      224               :
      225               assign
      226                   v-frame-width = frame d-pay-type:width - 0.3
      227                   fh            = frame d-pay-type:first-child
      228                   hh            = fh:first-child
      229                   ii            = 1
      230                   .
      231               do while valid-handle(hh):
      232                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      233                   do:
      234                       case lc(hh:name) :
      235                           when "b-help" then
      236                               do:
      237                                   hh:load-image-up("cmp/b-help.bmp":u) .
      238                                   hh:load-image-down("cmp/b-help.bmp":u) .
      239                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      240                                   hh:TOOLTIP = "Помощь" .
      241                                   v-help-old-x = hh:column .
      242                                   v-help-old-y = hh:row    .
      243                                   v-help-old-size = hh:width .
      244                                   hh:width-chars = 2.5 .
      245                               end.
      246                           when "b-print" then
      247                               do:
      248                                   hh:load-image("cmp/b-print.bmp":u) .
      249                                   hh:TOOLTIP = "Печать" .
      250                                   v-h[ii] = hh:handle .
      251                                   ii = ii + 1 .
      252                                   hh:width-chars = 3 .
      253                               end.
      254                           when "b-history" or
      255                           when "b-hist" then
      256                               do:
      257                                   hh:load-image("cmp/b-hist.bmp":u) .
      258                                   hh:TOOLTIP = "История" .
      259                                   v-h[ii] = hh:handle .
      260                                   ii = ii + 1 .
      261                                   hh:width-chars = 3 .
      262                               end.
      263                           when "b-sch" then
      264                               do:
      265                                   hh:load-image("cmp/b-sch.bmp":u) .
      266                                   hh:TOOLTIP = "Установка Фильтра" .
      267                                   v-h[ii] = hh:handle .
      268                                   ii = ii + 1 .
      269                                   hh:width-chars = 3 .
      270                               end.
      271                           when "b-hist-user" then
      272                               do:
      273                                   hh:load-image("cmp/b-hist.bmp":u) .
      274                                   hh:TOOLTIP = "История пользователя" .
      275                                   ii = ii + 1 .
      276                               end.
      277                       end case.
      278                   end.
      279                   hh = hh:next-sibling.
      280               end.
      281               b-help:column = v-frame-width - b-help:width-chars.
      282               jj = 0.
      283               repeat ii = 4 to 1 by -1 :
      284                   if valid-handle (v-h[ii] ) then
      285                   do:
      286                       jj  = jj + 1 .
      287                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      288                       v-h[ii]:row    = v-help-old-y .
      289                   end.
      290               end.
      291           end.
      292       end.
      293   end procedure.
      294   ON WINDOW-CLOSE OF FRAME d-pay-type APPLY "END-ERROR":U TO SELF.
      295   MAIN-BLOCK:
      296   DO ON ERROR UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      297   ON END-KEY  UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      298   ON STOP     UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      299     define buffer buf_pay-type for ub.pay-type .
      300     create tt_pay-type.
      301     if ref-mode = 'ДОБАВЛЕНИЕ':U then  do:
      302       assign
      303         rid = ?
      304       .
      305       find last buf_pay-type no-lock
      306         use-index pi
      307         no-error .
      308       if available buf_pay-type then do:
      309         assign
      310           tt_pay-type.obj-code = buf_pay-type.obj-code + 1
      311         .
      312       end.
      313       else do:
      314         assign
      315           tt_pay-type.obj-code = 1
      316         .
      317       end.
      318     end.
      319     else do:
      320       find first buf_pay-type exclusive-lock
      321         where recid( buf_pay-type ) = rid
      322         .
      323       buffer-copy buf_pay-type to tt_pay-type .
      324     end.
      325     session:data-entry-return = yes .
      326     RUN enable_UI.
      327     if ref-mode = 'ДОБАВЛЕНИЕ':U then do:
      328       WAIT-FOR GO OF FRAME d-pay-type FOCUS tt_pay-type.obj-code .
      329     end.
      330     else do:
      331       WAIT-FOR GO OF FRAME d-pay-type FOCUS tt_pay-type.obj-name .
      332     end.
      333   END.
      334   RUN disable_UI.
      335   session:data-entry-return = no .
      336   PROCEDURE disable_UI :
      337     HIDE FRAME d-pay-type.
      338   END PROCEDURE.
      339   PROCEDURE enable_UI :
      340     DISPLAY
      341         tt_pay-type.obj-code
      342         tt_pay-type.obj-name
      343         WITH FRAME d-pay-type.
      344     ENABLE
      345         b-OK
      346         b-cancel
      347         b-hist               WHEN ref-mode <> 'ДОБАВЛЕНИЕ':U
      348         tt_pay-type.obj-code WHEN ref-mode = 'ДОБАВЛЕНИЕ':U
      349         tt_pay-type.obj-name
      350         WITH FRAME d-pay-type.
      351   END PROCEDURE.
