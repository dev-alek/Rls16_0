      364     run proc-alt-f1 in this-procedure .
      365   end.
      366   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile: frmlib.i $ $Revision: aea5316774be, 0, rls $".
      367   FUNCTION Break-n-line RETURNS CHARACTER
      368     ( INPUT p-ost as char,
      369       INPUT p-lengths  as character,
      370       OUTPUT output-num-lines as integer
      371       ) :
      372   define variable ii as integer no-undo.
      373   define variable jj as integer no-undo.
      374   define variable linei as character no-undo extent 10.
      375   define variable line-length as integer no-undo extent 10.
      376   define variable num-line as integer no-undo .
      377   define variable v-line as character no-undo .
      378   do ii = 1 to MIN(num-entries(p-lengths), 10):
      379     assign
      380     line-length[ii] = integer(entry(ii, p-lengths))
      381     num-line = ii
      382     .
      383   end.
      384   do jj = 1 to num-line:
      385     if Length ( p-ost ) <= line-length[jj] then do:
      386       assign
      387       output-num-lines = jj
      388       v-line = v-line + (if jj = 1 then "":U else chr(4)) + p-ost
      389       .
      390       return v-line.
      391     end.
      392     assign
      393     ii = 1
      394     .
      395     if length( entry( ii, p-ost , chr(32)) ) > line-length[jj]
      396     then do:
      397       assign
      398       linei[jj] = substr( p-ost , 1 , line-length[jj] )
      399       p-ost = trim( substr( p-ost , line-length[jj] + 1 ) )
      400       .
      401     end.
      402     else do:
      403       DO WHILE length( linei[jj] + entry( ii, p-ost , chr(32)) ) < ( line-length[jj] + 1 ) :
      404         assign
      405         linei[jj] = linei[jj] + entry( ii, p-ost , chr(32)) + chr(32)
      406         ii = ii + 1
      407         .
      408         if length( entry( ii, p-ost, chr(32) ) ) > line-length[jj] then
      409         assign
      410         linei[jj] = linei[jj] + substr( p-ost , length( linei[jj] ) , line-length[jj] - length( linei[jj] ) + 1 )
      411         .
      412       END.
      413       assign
      414       p-ost = trim( substr( p-ost , length(linei[jj]) + 1  ))
      415       .
      416     end.
      417     assign
      418     v-line = v-line + (if jj = 1 then "":U else chr(4)) + linei[jj]
      419     .
      420     if p-ost = "":U then LEAVE.
      421   end.
      422   assign
      423   output-num-lines = jj.
      424   RETURN v-line.
      425   END FUNCTION.
      426   FUNCTION Center-Field RETURNS CHARACTER
      427     ( INPUT p-str as char,
      428       INPUT p-format as integer,
      429       INPUT p-Length as integer,
      430       INPUT p-fill as character
      431       ) :
      432   define variable v-str as character no-undo .
      433   define variable v-left as integer no-undo .
      434   define variable v-dop as integer no-undo .
      435   assign
      436   p-str = trim(p-str)
      437   .
      438   if p-str = "":U then return fill(p-fill, p-length).
      439   if length(p-str) >= p-format then
      440   p-str = substr(p-str, 1, p-format).
      441   else do:
      442     p-format = length(p-str).
      443   end.
      444   if p-format < p-length then do:
      445     assign
      446     v-left = (p-length - p-format )
      447     v-dop = (if v-left modulo 2 = 1
      448              then 1
      449              else 0)
      450     v-left = (if (v-left modulo 2 = 1)
      451              then (v-left - 1 ) / 2
      452              else v-left / 2)
      453     v-str =  fill(p-fill, v-left) +
      454              string(p-str, "X(":U + string(p-format) + ")":U) +
      455              fill(p-fill, v-left) + fill(p-fill, v-dop)
      456     .
      457     return v-str.
      458   end.
      459   else do:
      460     return string(p-str, "X(":U + string(p-length) + ")":U).
      461   end.
      462   END FUNCTION.
      463   FUNCTION Left-Field RETURNS CHARACTER
      464     ( INPUT p-str as char,
      465       INPUT p-format as integer,
      466       INPUT p-Length as integer,
      467       INPUT p-fill as character
      468       ) :
      469   define variable v-str as character no-undo .
      470   define variable v-left as integer no-undo .
      471   define variable v-dop as integer no-undo .
      472   assign
      473   p-str = trim(p-str)
      474   .
      475   if p-str = "":U then return fill(p-fill, p-length).
      476   if length(p-str) >= p-format then
      477   p-str = substr(p-str, 1, p-format).
      478   else do:
      479     p-format = length(p-str).
      480   end.
      481   if p-format < p-length then do:
      482     assign
      483     v-dop =  p-length - p-format
      484     v-str =  string(p-str, "X(":U + string(p-format) + ")":U) +
      485              fill(p-fill, v-dop)
      486     .
      487     return v-str.
      488   end.
      489   else do:
      490     return string(p-str, "X(":U + string(p-length) + ")":U).
      491   end.
      492   END FUNCTION.
      493   FUNCTION Sum-Rub-Kop-Digit RETURNS CHARACTER
      494     ( INPUT p-sum as decimal,
      495       INPUT p-rub-length as integer,
      496       INPUT p-kop-length as integer,
      497       INPUT p-fill as character,
      498       INPUT p-razr-delim as character,
      499       INPUT p-rub-str  as character,
      500       INPUT p-kop-str  as character
      501       ) :
      502   define variable v-str as character no-undo .
      503   define variable v-format as character no-undo .
      504   define variable v-dopi as integer no-undo .
      505   define variable v-dopi2 as integer no-undo .
      506   assign
      507   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      508   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      509   .
      510   if v-dopi > p-rub-length or p-kop-length < 2 then return "?".
      511   assign
      512   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9":U
      513   v-dopi = length(trim(string(truncate(p-sum, 0), v-format)))
      514   .
      515   assign
      516   v-str = fill(p-fill, p-rub-length - v-dopi) +
      517           string(truncate(p-sum, 0), v-format) +
      518           p-rub-str +
      519           fill(p-fill, p-kop-length - 2) +
      520           string(truncate((ABS(p-sum) - ABS(truncate(p-sum, 0))), 2) * 100, "99":U) + p-kop-str
      521   .
      522   return v-str.
      523   END FUNCTION.
      524   FUNCTION Sum-Invalut-Digit RETURNS CHARACTER
      525     ( INPUT p-sum as decimal,
      526       INPUT p-sum-length as integer,
      527       INPUT p-curr-code as integer,
      528       INPUT p-fill as character,
      529       INPUT p-razr-delim as character
      530       ) :
      531   define variable v-str as character no-undo .
      532   define variable v-format as character no-undo .
      533   define variable v-dopi as integer no-undo .
      534   define variable v-dopi2 as integer no-undo .
      535   define variable v-curr-name as character no-undo .
      536   define buffer buf_currency for ub.currency.
      537   find first buf_currency no-lock where
      538             buf_currency.curr-code = p-curr-code no-error .
      539   if not avail buf_currency
      540   then v-curr-name = "неизвестная валюта".
      541   else
      542   assign
      543   v-curr-name = buf_currency.curr-name
      544   .
      545   assign
      546   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      547   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      548   .
      549   if v-dopi > p-sum-length then return "?".
      550   assign
      551   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9.99":U
      552   v-dopi = length(trim(string(p-sum, v-format)))
      553   .
      554   assign
      555   v-str = "(":U + chr(32) + v-curr-name +  chr(32) + ")":U +
      556           fill(p-fill, p-sum-length - v-dopi - length(v-curr-name) - 4)  +
      557           trim(string(p-sum, v-format))
      558   .
      559   return v-str.
      560   END FUNCTION.
      561   FUNCTION Sum-in-Words-Without-Dec RETURNS CHARACTER
      562   (input v-sum as decimal
      563   ):
      564   define variable v-str as character no-undo .
      565   run gbl/num-rus.p ( input absolute( v-sum ) , output v-str).
      566   v-str = trim( caps( substring( v-str, 1, 1 ) ) ) + substring( v-str, 2 ).
      567   return v-str.
      568   END FUNCTION.
      569   FUNCTION Sum-in-Words-Invalut RETURNS CHARACTER
      570   (input p-sum as decimal
      571    ,input p-curr-code as integer
      572   ):
      573   define variable v-str as character no-undo .
      574   define variable Copeck as character no-undo.
      575   define variable Rouble as character no-undo.
      576   define variable v-Word as character no-undo.
      577   define variable ii as integer init 18 no-undo.
      578   define variable v-str-rubl as character no-undo .
      579   define variable v-kop as integer no-undo .
      580   define buffer buf_currency for ub.currency.
      581   assign
      582   v-Word = string( absolute( p-sum ) , "999999999999999.99" ).
      583   find first buf_currency no-lock where
      584             buf_currency.curr-code = p-curr-code no-error .
      585   if not available buf_currency then return chr(63).
      586   if decimal( substring(v-Word,1,ii - 3) ) <> 0 then do:
      587     CASE substring(v-Word, ii - 3,1):
      588       WHEN "1" THEN DO:
      589         if substring(v-Word, ii - 4,1) = "1" then
      590             Rouble = buf_currency.curr-name-five .
      591         else
      592             Rouble = buf_currency.curr-name-one .
      593       END.
      594       WHEN "2" OR WHEN "3" OR WHEN "4" THEN  DO:
      595         if substring(v-Word, ii - 4,1) = "1" then
      596            Rouble = buf_currency.curr-name-five .
      597            else
      598            Rouble = buf_currency.curr-name-three .
      599         END.
      600       WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN  DO:
      601          Rouble = buf_currency.curr-name-five .
      602       END.
      603     END CASE.
      604   end.
      605   CASE substring(v-Word, ii, 1):
      606     WHEN "1" THEN DO:
      607       if substring(v-Word, ii - 1, 1) = "1" then
      608           Copeck = buf_currency.part-name-five .
      609       else
      610           Copeck = buf_currency.part-name-one .
      611     END.
      612     WHEN "2" OR WHEN "3" OR WHEN "4" THEN DO:
      613       if substring(v-Word, ii - 1, 1) = "1" then
      614           Copeck = buf_currency.part-name-five .
      615       else
      616           Copeck = buf_currency.part-name-three .
      617     END.
      618     WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN DO:
      619       Copeck = buf_currency.part-name-five .
      620     END.
      621   END CASE.
      622   run gbl/num-rus.p ( input absolute( p-sum )
      623                , output v-str-rubl).
      624   assign
      625   v-kop = (absolute( p-sum ) - truncate(absolute(p-sum), 0)
      626           ) * 100
      627   .
      628   v-str = ( if p-Sum < 0 then "- " else "" ) +
      629               caps(substring(v-str-rubl, 1, 1)) +  substring(v-str-rubl, 2) + chr(32) + Rouble + chr(32) +
      630               string(v-kop, "99":U) + chr(32) + Copeck .
      631   return v-str.
      632   END FUNCTION.
      633   FUNCTION Sum-delim-with-defis RETURNS CHARACTER
      634   (input v-sum as decimal,
      635   input v-razr as integer
      636   ):
      637   define variable v-str as character no-undo .
      638   define variable v-dec-separ as character no-undo .
      639   case SESSION:NUMERIC-FORMAT:
      640     when "American":U then do:
      641       assign
      642       v-dec-separ = ".":U
      643       .
      644     end.
      645     when "European":U then do:
      646       assign
      647       v-dec-separ = ",":U
      648       .
      649     end.
      650   END CASE.
      651   assign
      652   v-str = replace(string(v-sum, fill(">":U, v-razr - 1) + "9.99"), v-dec-separ, "-":U)
      653   .
      654   return v-str.
      655   END FUNCTION.
      656   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
      657     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      658     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
      659     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      660   END FUNCTION.
      661   PROCEDURE get-month-name-gen :
      662     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      663     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      664     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
      665     DO ON ERROR UNDO, RETURN ERROR :
      666       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
      667     END.
      668   END PROCEDURE.
      669   def var v-choose as char no-undo.
      670     run gbl/d-list.w (
      671                 INPUT "b-sel":U
      672                 ,INPUT "Выберите тип топлива"
      673                 ,INPUT "petrol,diesel,diesel-sum,diesel-wint,metan,propan,lgas,arctic,megsesson"
      674                 ,INPUT "Бензин,ДТ,ДТ летнее,ДТ зимнее,Метан,Пропан,СУГ,ДТ Арктическое,ДТ Межсезонное"
      675                 ,INPUT chr(44)
      676                 ,INPUT  p-attr-value
      677                 ,output v-choose).
      678   p-attr-value = v-choose.
      679   if p-attr-value > '' then p-setted = yes.
