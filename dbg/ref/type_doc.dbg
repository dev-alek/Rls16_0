        1   DEFINE TEMP-TABLE tt-typeDoc NO-UNDO
        2     field type-code as character
        3     field typeName  as character.
        4   define temp-table  tt-dateZakaz     no-undo
        5   field id as integer
        6   field dateStart as date
        7   field dateEnd as date
        8   index pi id
        9       .
       10   DEFINE TEMP-TABLE tt-typeDocChoose NO-UNDO
       11     field type-code as character
       12     field typeName  as character.
       13   define temp-table gds-list like ub.goods
       14     field minZapas as decimal
       15     field contract as character
       16     field contract-code as integer
       17     field price as decimal
       18     field doc-qnty as decimal
       19     index pi contract gds-code.
       20    define temp-table choose-gds-list like ub.goods
       21     field minZapas as decimal
       22     field contract as character
       23     field contract-code as integer
       24     field price as decimal
       25     field doc-qnty as decimal
       26     index pi contract gds-code.
       27     define temp-table tt-gds-list like ub.goods
       28     field contract-code as integer
       29     field price as decimal
       30     field doc-qnty as decimal
       31     index pi gds-code.
       32   define input  parameter parParentProc  as widget-handle no-undo.
       33   define input-output  PARAMETER TABLE FOR tt-typeDocChoose.
       34   define variable vss-revision    as character no-undo init "$Revision: 998b6172f4a6, 2542, test $":U .
       35   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       36   define variable vss-date        as character no-undo init "$Date: Вт авг 04 12:57:22 2020 +0300 $":U .
       37   define variable vss-workfile    as character no-undo init "$Workfile: collec.w $":U .
       38   define variable vss-archive     as character no-undo init "$Archive: ref/collec.w $":U .
       39   define variable vss-description as character no-undo init "Справочник типов документов".
       40   procedure vss-get-info :
       41     define output parameter p-vss-revision    like vss-revision    no-undo .
       42     define output parameter p-vss-author      like vss-author      no-undo .
       43     define output parameter p-vss-date        like vss-date        no-undo .
       44     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       45     define output parameter p-vss-archive     like vss-archive     no-undo .
       46     define output parameter p-vss-description like vss-description no-undo .
       47     assign
       48       p-vss-revision    = vss-revision
       49       p-vss-author      = vss-author
       50       p-vss-date        = vss-date
       51       p-vss-workfile    = vss-workfile
       52       p-vss-archive     = vss-archive
       53       p-vss-description = vss-description
       54     .
       55   end procedure.
       56   procedure vss-get-parameters :
       57     define output parameter p-vss-parameters as character no-undo .
       58   end procedure.
       59   define new global shared variable g#vssrevis-logger as handle    no-undo .
       60   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       61   define variable v-vssrevis-logger                   as handle    no-undo .
       62   procedure vss-logevent :
       63     define input  parameter p-extra-paramters as character no-undo .
       64     define variable v-vssrevis-parameters as character no-undo .
       65     do
       66     on error undo, return error return-value
       67     :
       68       if  valid-handle(v-vssrevis-logger)
       69       and v-vssrevis-logger :get-signature("logevent") <> ""
       70       then do:
       71         run vss-get-parameters in this-procedure
       72           (output v-vssrevis-parameters
       73           ).
       74         run logevent in v-vssrevis-logger
       75           (input vss-workfile
       76           ,input vss-revision
       77           ,input v-vssrevis-parameters
       78           ,input p-extra-paramters
       79           ).
       80       end.
       81     end.
       82   end procedure.
       83   assign
       84     v-vssrevis-logger = g#vssrevis-logger
       85   .
       86   if  valid-handle(v-vssrevis-logger)
       87   and v-vssrevis-logger :get-signature("logevent") <> ""
       88   then do:
       89     assign
       90       v-vssrevis-logevent = true
       91     .
       92     run vss-logevent in this-procedure (input vss-description) .
       93   end.
       94   define new global shared variable g#language as character no-undo .
       95   if g#language <> '' and g#language <> 'rus':U then do:
       96     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       97   end.
       98   define variable rid-list              as character no-undo.
       99   define variable row_type              as rowid     no-undo .
      100   define variable ii                    as integer   no-undo .
      101   define variable doc-ext-doc-type-list as character no-undo .
      102   DEFINE BUTTON b-exit AUTO-GO
      103     LABEL "&Выход ":L
      104     SIZE 12 BY 1.
      105   DEFINE BUTTON B-mark
      106     LABEL "&*"
      107     SIZE 3 BY 1.
      108   DEFINE BUTTON b-sel AUTO-GO
      109     LABEL "Вы&бор ":L
      110     SIZE 10 BY 1.
      111   DEFINE QUERY br-coll FOR
      112     tt-typeDoc SCROLLING.
      113   DEFINE BROWSE br-coll
      114     QUERY br-coll NO-LOCK DISPLAY
      115         (IF ( CAN-DO (rid-list, string( recid( tt-typeDoc ) ) ) ) THEN ("*") ELSE (" ")) COLUMN-LABEL "*" FORMAT "X(1)":U
      116         tt-typeDoc.typeName column-label "Наименование" FORMAT "X(30)":U WIDTH 50
      117       WITH SEPARATORS SIZE 54.5 BY 19.46
      118            BGCOLOR 15 FGCOLOR 0 .
      119   DEFINE FRAME d-type-tmp
      120     b-exit AT ROW 1 COL 1
      121     B-mark AT ROW 1 COL 13
      122     b-sel AT ROW 1 COL 16.5
      123     br-coll AT ROW 2.25 COL 1.5
      124     SPACE(0.37) SKIP(0.28)
      125     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      126     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      127     TITLE "Типы документов":L.
      128   ASSIGN
      129     FRAME d-type-tmp:SCROLLABLE = FALSE.
      130   ON CHOOSE OF B-mark IN FRAME d-type-tmp
      131     DO:
      132       define variable loc#log as logical no-undo .
      133       if available tt-typeDoc then
      134       do:
      135   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   define variable v-str-recid1 as character no-undo .
      137   define variable v-num-entry1 as integer   no-undo .
      138   assign
      139     v-str-recid1 = trim( string( recid( tt-typeDoc ) , "->>>>>>>>>>>9":U ) )
      140     v-num-entry1 = lookup( v-str-recid1 , rid-list )
      141   .
      142   if v-num-entry1 > 0 then do:
      143     assign
      144       entry( v-num-entry1, rid-list ) = "":U
      145       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      146     .
      147   end.
      148   else do:
      149     assign
      150       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid1
      151     .
      152   end.
      153         row_type = rowid(tt-typeDoc).
      154         loc#log = br-coll:refresh() .
      155         reposition br-coll to rowid row_type.
      156         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
      157         do:
      158           loc#log = br-coll:select-next-row ().
      159           apply "VALUE-CHANGED" to br-coll in frame d-type-tmp.
      160         end.
      161       end.
      162       apply "entry" to br-coll in frame d-type-tmp.
      163     END.
      164   ON CHOOSE OF b-sel IN FRAME d-type-tmp
      165     DO:
      166       empty temp-table tt-typeDocChoose .
      167         do ii = 1 to num-entries (rid-list):
      168           find first tt-typeDoc where recid(tt-typeDoc) = integer(entry(ii,rid-list)) no-error .
      169           if available (tt-typeDoc) then
      170           do:
      171             create tt-typeDocChoose .
      172             buffer-copy tt-typeDoc to tt-typeDocChoose .
      173           end.
      174         end.
      175       find first tt-typeDocChoose no-error .
      176       if not available (tt-typeDocChoose) then do:
      177         message "Не задан тип документа для анализа, расчет невозможен"
      178         view-as alert-box.
      179         return no-apply .
      180       end.
      181     END.
      182   ON MOUSE-SELECT-DBLCLICK OF br-coll IN FRAME d-type-tmp
      183     DO:
      184       apply "choose" to b-sel in frame d-type-tmp .
      185       return no-apply .
      186     END.
      187   ON RETURN OF br-coll IN FRAME d-type-tmp
      188     DO:
      189       apply "choose" to b-sel in frame d-type-tmp .
      190       return no-apply .
      191     END.
      192   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-type-tmp:PARENT eq ?
      193     THEN FRAME d-type-tmp:PARENT = ACTIVE-WINDOW.
      194   ON WINDOW-CLOSE OF FRAME d-type-tmp
      195     APPLY "END-ERROR":U TO SELF.
      196   MAIN-BLOCK:
      197   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      198     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      199     doc-ext-doc-type-list = 'es':U + chr(47) + "расход внешний касса" + chr(44) +
      200       'rs':U + chr(47) + "возврат внешний касса" + chr(44) +
      201       'wm':U + chr(47) + "расход производство" + chr(44) +
      202       'we':U + chr(47) + 'списание':U + chr(44) +
      203       'ee':U + chr(47) + 'расход внешний':U + chr(44) +
      204       're':U + chr(47) + 'возврат внешний':U + chr(44) +
      205       'rv':U + chr(47) + 'возврат внутренний':U + chr(44) +
      206       'ev':U + chr(47) + 'расход внутренний':U .
      207     define variable doc-type as character no-undo .
      208     do ii = 1 to num-entries (doc-ext-doc-type-list,chr(44)):
      209       doc-type = entry (ii,doc-ext-doc-type-list,chr(44)) .
      210       create tt-typeDoc .
      211       assign
      212         tt-typeDoc.type-code = entry (1,doc-type,chr(47))
      213         tt-typeDoc.typeName  = entry (2,doc-type,chr(47))
      214         .
      215     end.
      216     define variable loc#log as logical no-undo .
      217     for each tt-typeDocChoose:
      218       find first tt-typeDoc where tt-typeDoc.type-code = tt-typeDocChoose.type-code no-error .
      219       if available tt-typeDoc then
      220       do:
      221   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   define variable v-str-recid3 as character no-undo .
      223   define variable v-num-entry3 as integer   no-undo .
      224   assign
      225     v-str-recid3 = trim( string( recid( tt-typeDoc ) , "->>>>>>>>>>>9":U ) )
      226     v-num-entry3 = lookup( v-str-recid3 , rid-list )
      227   .
      228   if v-num-entry3 > 0 then do:
      229     assign
      230       entry( v-num-entry3, rid-list ) = "":U
      231       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      232     .
      233   end.
      234   else do:
      235     assign
      236       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid3
      237     .
      238   end.
      239       end.
      240       apply "entry" to br-coll in frame d-type-tmp.
      241     end.
      242     run enable_ui.
      243     APPLY "VALUE-CHANGED":U TO br-coll in frame d-type-tmp.
      244     WAIT-FOR GO OF FRAME d-type-tmp.
      245   END.
      246   run disable_ui.
      247   PROCEDURE disable_UI :
      248     HIDE FRAME d-type-tmp.
      249   END PROCEDURE.
      250   PROCEDURE enable_UI :
      251     ENABLE
      252       br-coll
      253       b-exit
      254       b-sel
      255       b-mark
      256       WITH FRAME  d-type-tmp.
      257     OPEN QUERY br-coll FOR EACH tt-typeDoc NO-LOCK.
      258   END PROCEDURE.
      259   FUNCTION mon-name RETURNS CHARACTER
      260     (input n-mon as int) :
      261     define variable name-mon as char no-undo.
      262     run gbl/monthnam.p ( input n-mon, output name-mon ) .
      263     RETURN name-mon.
      264   END FUNCTION.
