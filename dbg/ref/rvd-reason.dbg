      551   define button B-WaitFramStop auto-end-key
      552        label "Стоп"
      553        size 10 by 1 tooltip "Остоновить процесс".
      554   define button B-viewProcInfo
      555        label "Информация"
      556        size 15 by 1 tooltip "Информация о процесс".
      557   define frame waitfram
      558     v-waitfram-action01 format "x(72)" no-label skip
      559     v-waitfram-action02 format "x(72)" no-label skip
      560     v-waitfram-action03 format "x(72)" no-label skip
