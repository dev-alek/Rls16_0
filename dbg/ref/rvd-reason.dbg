      562     B-WaitFramStop at row 4 col 30
      563     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      564     .
      565   define new global shared variable mBatchMode as logical no-undo init ?.
      566   define variable mFramBachModHandle as handle no-undo.
      567   mFramBachModHandle = frame waitfram:handle.
      568   define variable mFameOldVis as logical no-undo.
      569   define variable mVisCUrentVin as logical no-undo.
      570   if session:batch-mode
      571   then
      572      mBatchMode = yes.
      573   if mBatchMode = ? then do:
      574     mVisCUrentVin = current-window:visible.
      575     mFameOldVis = mFramBachModHandle:visible.
      576     mFramBachModHandle:visible  = yes.
      577     mBatchMode = mFramBachModHandle:visible ne yes.
      578     mFramBachModHandle:visible = mFameOldVis.
      579     current-window:visible = mVisCUrentVin.
      580   end.
      581    if  log-manager:logfile-name ne ?
      582     then DO:
      583         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      584         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      585         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      586     end.
      587   on choose of B-WaitFramStop in frame waitfram
      588   do:
      589     mWaitFramStop = yes.
      590     mWaitFramStopUser = yes.
      591   end.
      592   function waitfram-check-timeout returns logical():
      593      define variable vtime as int64 no-undo.
      594      if mWaitFramStopTimeOut
      595      then
      596         return yes.
      597      vtime = ( now - mWaitFramStartProc ) / 1000 .
      598      if     mWaitFramTimeOut ne ?
      599         and mWaitFramTimeOut ne 0
      600         and mWaitFramTimeOut lt vtime
      601      then do:
      602         mWaitFramStopTimeOut = yes.
      603      end.
      604      return mWaitFramStopTimeOut.
      605   end.
      606   procedure waitfram-hide :
      607     if not session:batch-mode
      608     then do
      609     on error undo, return error return-value
      610     :
      611       pause 0 before-hide .
      612       if not mBatchMode then
      613         hide frame waitfram .
      614     if     not mWaitFramView
      615        and mWaitProcEvent
      616     then
      617       process events .
      618     end.
      619   end procedure.
      620   procedure waitfram-show :
      621     define input  parameter p-message as character no-undo .
      622     define variable v-left-margin as integer   no-undo .
      623     if not session:batch-mode
      624     then do
      625     on error undo, return error return-value
      626     :
      627       if length(p-message) <= 70 then do:
      628         assign
      629           v-left-margin = integer((70 - length(p-message)) / 2)
      630         .
      631         assign
      632           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      633         .
      634         assign
      635           v-waitfram-action01 = " "
      636           v-waitfram-action02 = " "
      637                                    + fill(" ", v-left-margin)
      638                                    + p-message
      639           v-waitfram-action03 = " "
      640         .
      641       end.
      642       else do:
      643         define variable vRindex1 as integer no-undo.
      644         define variable vRindex2 as integer no-undo.
      645         vRindex1 = r-index(p-message," ",70).
      646         if vRindex1 = 0
      647         then
      648            vRindex1 = 70.
      649         if length(p-message)  <= vRindex1 + 70 then do:
      650           assign
      651             v-waitfram-action01 = " "
      652             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      653             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      654           .
      655         end.
      656         else do:
      657           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      658           if vRindex2 <= vRindex1
      659           then
      660              vRindex2 = vRindex1 + 70.
      661           assign
      662             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      663             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      664             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      665           .
      666         end.
      667       end.
      668       B-viewProcInfo:visible   in frame waitfram = no.
      669       B-viewProcInfo:sensitive in frame waitfram = no.
      670       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      671       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      672       if  (   mWaitFramView
      673          or  mWaitProcEvent)
      674          and not mBatchMode
      675       then
      676          display
      677             v-waitfram-action01 skip
      678             v-waitfram-action02 skip
      679             v-waitfram-action03 skip
      680          with frame waitfram .
      681       if     mWaitFramView
      682          then do:
      683             if     mWaitFramInterval ne ?
      684                and not mBatchMode
      685             then
      686                wait-for go of frame waitfram pause mWaitFramInterval.
      687          end.
      688          else
      689             if     mWaitProcEvent
      690                and not mBatchMode
      691             then
      692                process events .
      693     end.
      694   end procedure.
      695      procedure waitfram-show-this:
      696         define input  parameter iInterval as int64 no-undo.
      697         define variable vtime as int64 no-undo.
      698         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      699         mWaitFramInterval = iInterval.
      700         run waitfram-show (substitute("&1&2 &3&4" ,
      701                                       mWaitFramTextBeg ,
      702                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      703                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      704                                       mWaitFramTextEnd
      705                                      )
      706                           ).
      707      end.
      708      procedure WaitFramRunPause:
      709         define input  parameter iInterval as dec no-undo.
      710         define variable vStart  as datetime-tz no-undo.
      711         define variable vend    as datetime-tz no-undo.
      712         define variable vint as int64 no-undo.
      713         define variable vOk as logical no-undo.
      714         vStart = now.
      715         vend   = vStart.
      716         publish "WaitFramPause" (iInterval,output vOk).
      717         vend   =  now.
      718         vint = vend - vStart.
      719         vint = iInterval - vint / 1000.
      720         if     not mWaitFramStop
      721            and (   vint > 0
      722                 or (    not vOk
      723                     and iInterval eq ?
      724                     )
      725                 )
      726         then
      727            run waitfram-show-this (iInterval).
      728         vend   =  now.
      729         vint = vend - vStart.
      730         vint = iInterval - vint / 1000.
      731         if     not mWaitFramStop
      732            and vint > 0
      733         then do:
      734            run gbl/pause.p (vint * 1000).
      735         end.
      736         if iInterval ne ?
      737         then
      738            publish "WaitFramStop".
      739         waitfram-check-timeout().
      740      end.
      741      procedure WaitFramWaitFor:
      742         define input  parameter iInterval as dec no-undo.
      743         assign
      744            mWaitFramStartProc   = now
      745            mWaitFramStopUser    = no
      746            mWaitFramStopTimeOut = no
      747         .
      748         block-wait:
      749         do while not mWaitFramStop:
      750            run WaitFramRunPause (iInterval).
      751            if  waitfram-check-timeout()
      752            then do:
      753               leave block-wait.
      754            end.
      755         end.
      756         run waitfram-hide.
      757      end.
      758   procedure waitfram-join :
      759     define input  parameter p-line-1  as character no-undo .
      760     define input  parameter p-line-2  as character no-undo .
      761     define input  parameter p-line-3  as character no-undo .
      762     define output parameter p-message as character no-undo .
      763     do
      764     on error undo, return error return-value
      765     :
      766       assign
      767         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      768                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      769                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      770       .
      771     end.
      772   end procedure.
      773   function waitfram-join-function returns character
      774     (input p-line-1 as character
      775     ,input p-line-2 as character
      776     ,input p-line-3 as character
      777     ).
      778     define variable v-message as character no-undo .
      779     run waitfram-join in this-procedure
      780       (input  p-line-1
      781       ,input  p-line-2
      782       ,input  p-line-3
      783       ,output v-message
      784       ) .
      785     return v-message .
      786   end function .
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   FUNCTION mark-string RETURNS CHARACTER
      789     ( input p-recid as recid, input mark-list as character  ) :
      790     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      791   END FUNCTION.
      792   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      793   define variable log-res     as log       no-undo.
      794   define variable rr          as recid     no-undo.
      795   define variable v_type      as char      no-undo.
      796   define variable v-is-deploy as logical   no-undo .
      797   define variable v-rid-list  as character no-undo .
      798   DEFINE BUTTON b-add
      799     LABEL "&Добавить":L
      800     SIZE 10 BY 1.
      801   DEFINE BUTTON b-del
      802     LABEL "&Удалить":L
      803     SIZE 10 BY 1.
      804   DEFINE BUTTON b-exit AUTO-GO
      805     LABEL "&Выход ":L
      806     SIZE 10 BY 1.
      807   DEFINE BUTTON b-sel AUTO-GO
      808     LABEL "Вы&бор ":L
      809     SIZE 10 BY 1.
      810   DEFINE BUTTON b-upd
      811     LABEL "&Изменить":L
      812     SIZE 10 BY 1.
      813   DEFINE BUTTON b-mark
      814     LABEL "&*":L
      815     SIZE 3 BY 1.
      816   define variable t-del as logical init no
      817     label "Показывать удаленные":L
      818     view-as toggle-box
      819     size 22 by 1.
      820   DEFINE QUERY br-rvd-reason FOR
      821     X_ext-classif SCROLLING.
      822   function rvd-stat returns character (input p-nonuniq as integer) :
      823     if p-nonuniq = 1
      824     then return "Удал" .
      825     else return "Тек" .
      826   end function .
      827   function rvd-type returns character (input p-type as integer) :
      828     if p-type = 1
      829     then return "ТРК" .
      830     else return "РГС" .
      831   end function .
      832   DEFINE BROWSE br-rvd-reason
      833     QUERY br-rvd-reason NO-LOCK DISPLAY
      834     X_ext-classif.charkey_one COLUMN-LABEL "Код" FORMAT "X(64)":U width 10
      835     X_ext-classif.charkey_two COLUMN-LABEL "Основание/причина" FORMAT "X(255)":U width 35
      836     rvd-stat(X_ext-classif.nonuniq) COLUMN-LABEL "Статус" FORMAT "X(6)":U width 6
      837     rvd-type(X_ext-classif.key#_two) COLUMN-LABEL "Тип" FORMAT "X(4)":U width 4
      838     X_ext-classif.CharKey_Three COLUMN-LABEL "Описание" FORMAT "X(255)":U width 50
      839       WITH SEPARATORS SIZE 72 BY 15.
      840   DEFINE FRAME d-rvd-reason
      841     b-exit AT ROW 1 COL 1
      842     b-mark at row 1 col 11
      843     b-sel AT ROW 1 COL 14
      844     b-add AT ROW 1 COL 24
      845     b-del AT ROW 1 COL 34 WIDGET-ID 2
      846     b-upd AT ROW 1 COL 44
      847     t-del at row 1 col 55
      848     br-rvd-reason AT ROW 3 COL 3
      849     SPACE(1) SKIP(1)
      850     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      851     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      852     TITLE "Причины изменения режима ввода данных":L.
      853   ASSIGN
      854     FRAME d-rvd-reason:SCROLLABLE = FALSE.
      855   ON GO OF FRAME d-rvd-reason
      856     DO:
      857       p-rid-list = v-rid-list.
      858     END.
      859   ON CHOOSE OF b-add IN FRAME d-rvd-reason
      860     DO:
      861       run ref/rvd-reason_upd.w
      862         (  input parparentproc
      863         , input 'ДОБАВЛЕНИЕ':U
      864         , input-output rr ).
      865       if rr <> ? then
      866       do:
      867         if t-del
      868         then do :
      869           OPEN QUERY br-rvd-reason FOR EACH X_ext-classif NO-LOCK where X_ext-classif.classif-subject = 'rvd-reason':U
      870                                                                   and X_ext-classif.classif-name = 'rvd-reason':U
      871                                                                   and (X_ext-classif.key#_Two = p-type or p-type = -1)
      872                                                                   by X_ext-classif.nonuniq BY X_ext-classif.CharKey_One .
      873         end .
      874         else do :
      875           OPEN QUERY br-rvd-reason FOR EACH X_ext-classif NO-LOCK where X_ext-classif.classif-subject = 'rvd-reason':U
      876                                                                   and X_ext-classif.classif-name = 'rvd-reason':U
      877                                                                   and (X_ext-classif.key#_Two = p-type or p-type = -1)
      878                                                                   and X_ext-classif.nonuniq = 0
      879                                                                   by X_ext-classif.nonuniq BY X_ext-classif.CharKey_One .
      880         end .
      881         reposition br-rvd-reason to recid rr.
      882         log-res  = br-rvd-reason:select-focused-row( ).
      883         apply "ENTRY":U to br-rvd-reason.
      884       end.
      885     END.
      886   ON CHOOSE OF b-del IN FRAME d-rvd-reason
      887     DO:
      888       define buffer del_ext-classif for ub.ext-classif .
      889       if v-rid-list = "" then do:
      890         rr = recid( X_ext-classif ) .
      891         find first X_ext-classif exclusive-lock where recid(X_ext-classif) = rr no-error .
      892       end.
      893       else do:
      894         find first X_ext-classif exclusive-lock where recid(X_ext-classif) = integer(v-rid-list) no-error .
      895       end.
      896       if available (X_ext-classif)
      897       then do :
      898         create del_ext-classif .
      899         buffer-copy X_ext-classif to del_ext-classif
      900         assign
      901           del_ext-classif.nonuniq = 1 when X_ext-classif.nonuniq = 0
      902           del_ext-classif.nonuniq = 0 when X_ext-classif.nonuniq = 1
      903         .
      904         delete X_ext-classif .
      905       end .
      906       v-rid-list = "" .
      907       rr = ? .
      908       apply "ENTRY":U to br-rvd-reason.
      909       if t-del
      910       then do :
      911         OPEN QUERY br-rvd-reason FOR EACH X_ext-classif NO-LOCK where X_ext-classif.classif-subject = 'rvd-reason':U
      912                                                                 and X_ext-classif.classif-name = 'rvd-reason':U
      913                                                                 and (X_ext-classif.key#_Two = p-type or p-type = -1)
      914                                                                 by X_ext-classif.nonuniq BY X_ext-classif.CharKey_One .
      915       end .
      916       else do :
      917         OPEN QUERY br-rvd-reason FOR EACH X_ext-classif NO-LOCK where X_ext-classif.classif-subject = 'rvd-reason':U
      918                                                                 and X_ext-classif.classif-name = 'rvd-reason':U
      919                                                                 and (X_ext-classif.key#_Two = p-type or p-type = -1)
      920                                                                 and X_ext-classif.nonuniq = 0
      921                                                                 by X_ext-classif.nonuniq BY X_ext-classif.CharKey_One .
      922       end .
      923     END.
      924   ON CHOOSE OF b-sel IN FRAME d-rvd-reason
      925     DO:
      926       if ( available X_ext-classif )
      927       AND ( v-rid-list = "" or b-mark:sensitive = no )
      928       then
      929         v-rid-list = string( recid( X_ext-classif ) ) .
      930     END.
      931   ON CHOOSE OF b-mark IN FRAME d-rvd-reason
      932     DO:
      933       define variable g-log as logical no-undo.
      934       if available X_ext-classif then
      935       do:
      936   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      937   define variable v-str-recid9 as character no-undo .
      938   define variable v-num-entry9 as integer   no-undo .
      939   assign
      940     v-str-recid9 = trim( string( recid( X_ext-classif ) , "->>>>>>>>>>>9":U ) )
      941     v-num-entry9 = lookup( v-str-recid9 , v-rid-list )
      942   .
      943   if v-num-entry9 > 0 then do:
      944     assign
      945       entry( v-num-entry9, v-rid-list ) = "":U
      946       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      947     .
      948   end.
      949   else do:
      950     assign
      951       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid9
      952     .
      953   end.
      954         g-log = br-rvd-reason:refresh() .
      955         if last-event:function <> "mouse-select-dblclick" then
      956         do:
      957           g-log = br-rvd-reason:select-next-row ().
      958           apply "value-changed" to br-rvd-reason in frame d-rvd-reason.
      959         end.
      960       end.
      961       apply "entry" to br-rvd-reason in frame d-rvd-reason.
      962     END.
      963   ON CHOOSE OF b-upd IN FRAME d-rvd-reason
      964     DO:
      965       define variable glog as logical no-undo .
      966       if not available X_ext-classif THEN  return no-apply.
      967       rr = recid( X_ext-classif ).
      968       run ref/rvd-reason_upd.w
      969         ( input parparentproc
      970         , input 'ИЗМЕНЕНИЕ':U
      971         , input-output rr
      972         ).
      973       if t-del
      974       then do :
      975         OPEN QUERY br-rvd-reason FOR EACH X_ext-classif NO-LOCK where X_ext-classif.classif-subject = 'rvd-reason':U
      976                                                                 and X_ext-classif.classif-name = 'rvd-reason':U
      977                                                                 and (X_ext-classif.key#_Two = p-type or p-type = -1)
      978                                                                 by X_ext-classif.nonuniq BY X_ext-classif.CharKey_One .
      979       end .
      980       else do :
      981         OPEN QUERY br-rvd-reason FOR EACH X_ext-classif NO-LOCK where X_ext-classif.classif-subject = 'rvd-reason':U
      982                                                                 and X_ext-classif.classif-name = 'rvd-reason':U
      983                                                                 and (X_ext-classif.key#_Two = p-type or p-type = -1)
      984                                                                 and X_ext-classif.nonuniq = 0
      985                                                                 by X_ext-classif.nonuniq BY X_ext-classif.CharKey_One .
      986       end .
      987     END.
      988   ON VALUE-CHANGED OF t-del IN FRAME d-rvd-reason
      989   DO:
      990       assign
      991         t-del
      992       .
      993       if t-del
      994       then do :
      995         OPEN QUERY br-rvd-reason FOR EACH X_ext-classif NO-LOCK where X_ext-classif.classif-subject = 'rvd-reason':U
      996                                                                 and X_ext-classif.classif-name = 'rvd-reason':U
      997                                                                 and (X_ext-classif.key#_Two = p-type or p-type = -1)
      998                                                                 by X_ext-classif.nonuniq BY X_ext-classif.CharKey_One .
      999       end .
     1000       else do :
     1001         OPEN QUERY br-rvd-reason FOR EACH X_ext-classif NO-LOCK where X_ext-classif.classif-subject = 'rvd-reason':U
     1002                                                                 and X_ext-classif.classif-name = 'rvd-reason':U
     1003                                                                 and (X_ext-classif.key#_Two = p-type or p-type = -1)
     1004                                                                 and X_ext-classif.nonuniq = 0
     1005                                                                 by X_ext-classif.nonuniq BY X_ext-classif.CharKey_One .
     1006       end .
     1007   END.
     1008   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-rvd-reason:PARENT eq ?
     1009     THEN FRAME d-rvd-reason:PARENT = ACTIVE-WINDOW.
     1010   ON WINDOW-CLOSE OF FRAME d-rvd-reason
     1011     APPLY "END-ERROR":U TO SELF.
     1012   MAIN-BLOCK:
     1013   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1014     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1015   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1016     run mainmenu_getcntxt in parparentproc
     1017       (output v-cntxt-db-num
     1018       ,output v-cntxt-userid
     1019       ,output v-cntxt-level
     1020       ,output v-cntxt-host-code-obj
     1021       ,output v-cntxt-obj-type
     1022       ,output v-cntxt-obj-code
     1023       ,output v-cntxt-db-num-obj
     1024       ,output v-cntxt-is-admin
     1025       ) .
     1026     run enable_UI in this-procedure .
     1027     WAIT-FOR GO OF FRAME d-rvd-reason focus br-rvd-reason.
     1028   END.
     1029   run disable_UI in this-procedure .
     1030   PROCEDURE disable_UI :
     1031     HIDE FRAME d-rvd-reason.
     1032   END PROCEDURE.
     1033   PROCEDURE enable_UI :
     1034     ENABLE
     1035       br-rvd-reason
     1036       b-exit
     1037       b-sel WHEN can-do( bttns, "b-sel" )
     1038       b-mark WHEN can-do( bttns, "b-mark" )
     1039       b-add WHEN can-do( bttns, "b-add" )
     1040       b-del when can-do ( bttns, "b-del" )
     1041       b-upd WHEN can-do( bttns, "b-upd" )
     1042       WITH FRAME d-rvd-reason.
     1043     if p-mode = 'все':U
     1044     then do :
     1045       enable
     1046         t-del
     1047       WITH FRAME d-rvd-reason.
     1048     end .
     1049     OPEN QUERY br-rvd-reason FOR EACH X_ext-classif NO-LOCK where X_ext-classif.classif-subject = 'rvd-reason':U
     1050                                                               and X_ext-classif.classif-name = 'rvd-reason':U
     1051                                                               and (X_ext-classif.key#_Two = p-type or p-type = -1)
     1052                                                               and X_ext-classif.nonuniq = 0
     1053                                                               by X_ext-classif.nonuniq by X_ext-classif.CharKey_One .
     1054     if available X_ext-classif
     1055       then log-res  = br-rvd-reason:select-focused-row( ).
     1056   END PROCEDURE.
