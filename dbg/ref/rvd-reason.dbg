      356   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   define  stream PrnLibStream.
      358   procedure prn-lib-prn-file :
      359     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      360     define input parameter p-DIsabledoptions as integer no-undo .
      361     define variable v-report-name as character no-undo .
      362     define variable v-user-action as character no-undo .
      363     define variable v-printed     as logical   no-undo .
      364     define variable v-exist       as logical   no-undo .
      365     do
      366       on error undo, return error
      367       :
      368       run prn-lib-get-report-name  in this-procedure (
      369         input parParentProc
      370         ,output v-report-name
      371         ).
      372   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      374     (input  v-report-name
      375     ,input  2
      376     ,output v-exist
      377     )  .
      378       if NOT v-exist then
      379       DO:
      380         Message
      381           "Нет заданий на печать ! "
      382           view-as alert-box .
      383         Return  .
      384       End.
      385       run gbl/prnfilen.w
      386         (input  ""
      387         ,input  p-DisabledOptions
      388         ,input  string(v-report-name )
      389         ,input  7
      390         ,output v-user-action
      391         ,output v-printed
      392         ) .
      393       if v-printed then
      394       do:
      395         return "YES" .
      396       end.
      397       else
      398       do:
      399         return "NO" .
      400       end.
      401     end.
      402   end procedure.
      403   procedure prn-lib-open-stream :
      404     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      405     define input parameter p-page-size    as integer no-undo .
      406     define input parameter p-is-stream    as logical no-undo .
      407     define input parameter p-append       as logical no-undo .
      408     define variable v-report-name as character no-undo .
      409     do
      410       on error undo, return error
      411       :
      412       run prn-lib-get-report-name  in this-procedure (
      413         input parParentProc
      414         ,output v-report-name
      415         ).
      416       if p-is-stream then
      417       do:
      418         if p-append then
      419         do:
      420           output stream PrnLibStream to value( v-report-name )
      421             page-size value(p-page-size) append .
      422         end.
      423         if not p-append then
      424         do:
      425           output stream PrnLibStream to value( v-report-name )
      426             page-size value(p-page-size) .
      427         end.
      428       end.
      429       if not p-is-stream then
      430       do:
      431         if p-append then
      432         do:
      433           output to value( v-report-name )
      434             page-size value(p-page-size) append .
      435         end.
      436         if not p-append then
      437         do:
      438           output to value( v-report-name )
      439             page-size value(p-page-size) .
      440         end.
      441       end.
      442     end.
      443   end procedure.
      444   procedure prn-lib-open-exp :
      445     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      446     define input parameter p-is-stream    as logical no-undo .
      447     define input parameter p-is-append    as logical no-undo .
      448     define output parameter p-ReportFileName as char init "report" no-undo.
      449     define output parameter p-process as logical no-undo .
      450     define variable glog as logical no-undo .
      451     do
      452       on error undo, return error
      453       :
      454       SYSTEM-DIALOG GET-FILE p-ReportFileName
      455         TITLE      "Укажите путь"
      456         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      457         ASK-OVERWRITE
      458         CREATE-TEST-FILE
      459         SAVE-AS
      460         USE-FILENAME
      461         DEFAULT-EXTENSION "txt"
      462         UPDATE glog
      463         .
      464       if not glog then  return.
      465       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      466       if p-is-stream then
      467       do:
      468         if p-is-append then
      469         do:
      470           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      471         end.
      472         else
      473         do:
      474           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      475         end.
      476       end.
      477       else
      478       do:
      479         if p-is-append then
      480         do:
      481           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      482         end.
      483         else
      484         do:
      485           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      486         end.
      487       end.
      488       p-process = yes.
      489     end.
      490   end procedure.
      491   procedure prn-lib-get-report-name :
      492     define input parameter parParentProc  as widget-handle no-undo.
      493     define output parameter p-report-name as character no-undo .
      494     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      495   end procedure.
      496   procedure prn-lib-reportviewer-report-name :
      497     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      498     define input parameter p-report-name-html as character no-undo .
      499     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      500   end procedure.
      501   procedure prn-lib-reportviewer :
      502     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      503     define input parameter p-report-name-html as character no-undo .
      504     define input parameter p-param        as character no-undo .
      505     define variable v-excel           as character no-undo init 'TRUE' .
      506     define variable v-value-character as character no-undo .
      507     define variable v-value-integer   as character no-undo .
      508     define variable v-value-date      as date      no-undo .
      509     define variable v-value-decimal   as decimal   no-undo .
      510     define variable rep-excel         as logical   no-undo .
      511     define variable excel-string      as character no-undo .
      512     define variable v-param-type      as character no-undo .
      513     define variable v-tth             as handle    no-undo .
      514     run adm/shattri.p (
      515       input "get":U
      516       ,input  ""
      517       ,input  0
      518       ,input  'report-glob':U
      519       ,input  'rep-excel':U
      520       ,output v-value-character
      521       ,output v-value-date
      522       ,output v-value-decimal
      523       ,output v-value-integer
      524       ,output rep-excel
      525       ,output v-param-type
      526       ,INPUT-OUTPUT table-handle v-tth
      527       )  .
      528     if rep-excel then v-excel = "TRUE" .
      529     else v-excel = "FALSE" .
      530     if p-param eq ""
      531     then
      532        p-param = "EXCEL:" + v-excel.
      533     else
      534        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      535     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      536   end procedure.
      537   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
