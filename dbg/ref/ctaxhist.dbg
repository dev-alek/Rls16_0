        1   DEFINE BUFFER buf_cli FOR ub.clients.
        2   DEFINE BUFFER for-c-tax-hist FOR ub.c-tax-hist.
        3   DEFINE BUFFER X_c-tax-hist FOR ub.c-tax-hist.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   DEFINE INPUT PARAMETER bttns  as character  no-undo .
        6   DEFINE INPUT PARAMETER parref-mode as character no-undo.
        7   DEFINE OUTPUT PARAMETER  p-rid-list    as  char no-undo .
        8   DEFINE INPUT PARAMETER p-tax-code like ub.c-tax-hist.tax-code no-undo.
        9   DEFINE INPUT PARAMETER p-rate-code like ub.c-tax-hist.rate-code no-undo.
       10   define input parameter p-subject   like ub.c-tax-hist.subject no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":u .
       12   define variable vss-author      as character no-undo init "$Author$":u .
       13   define variable vss-date        as character no-undo init "$Date$":u .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       15   define variable vss-archive     as character no-undo init "$Archive$":u .
       16   define variable vss-description as character no-undo init "Справочник истории налогов" .
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   procedure cur-time :
      124      define output parameter p-today as date      no-undo .
      125      define output parameter p-time  as integer   no-undo .
      126     do
      127     on error undo, return error
      128     :
      129       define variable v-date1 as date      no-undo .
      130       define variable v-date2 as date      no-undo .
      131       define variable v-time  as integer   no-undo .
      132       assign
      133         v-date1 = today
      134         v-time  = time
      135         v-date2 = today
      136       .
      137       if v-date1 <> v-date2
      138       then do:
      139         assign
      140           v-date1 = today
      141           v-time  = v-time
      142         .
      143       end.
      144       assign
      145         p-today = v-date1
      146         p-time  = v-time
      147       .
      148     end.
      149   end.
      150   function cur-time-date returns character
      151   :
      152     return string(today, '99/99/9999':U) .
      153   end.
      154   function cur-time-mjd returns decimal
      155   :
      156     define variable v-date as date      no-undo .
      157     define variable v-time as integer   no-undo .
      158     run cur-time in this-procedure
      159       (output v-date
      160       ,output v-time
      161       ) .
      162     return integer(v-date) - 2400002 + (v-time / 86400) .
      163   end.
      164   function cur-time-get-ending-index returns integer
      165   (input p-number as integer
      166   )
      167   :
      168     if p-number < 0
      169     or p-number = ?
      170     then do:
      171       return 1 .
      172     end.
      173     define variable v-rest as integer   no-undo .
      174     assign
      175       p-number = p-number modulo 100
      176     .
      177     if p-number < 20
      178     then do:
      179       assign
      180         v-rest = p-number
      181       .
      182     end.
      183     else do:
      184       assign
      185         v-rest = p-number modulo 10
      186       .
      187     end.
      188     case v-rest :
      189       when 1
      190       then do:
      191         return 2 .
      192       end.
      193       when 2 or
      194       when 3 or
      195       when 4
      196       then do:
      197         return 3 .
      198       end.
      199       otherwise do:
      200         return 1 .
      201       end.
      202     end case .
      203   end.
      204   procedure cur-time-mjd-to-date :
      205      define input  parameter i-mjd-diff as decimal no-undo.
      206      define output parameter o-Date     as date    no-undo.
      207      define output parameter o-Time     as integer no-undo.
      208      define variable v-day-number as integer   no-undo .
      209      if    i-mjd-diff < 0
      210         or i-mjd-diff = ?
      211      then do:
      212         return "?" .
      213      end.
      214      assign
      215         v-day-number = truncate(i-mjd-diff,0).
      216         o-Date = date(v-day-number + 2400002).
      217         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      218     .
      219   end.
      220   function cur-time-mjd-to-string returns character
      221   (input p-mjd-diff as decimal
      222   )
      223   :
      224     define variable v-day-number as integer   no-undo .
      225     define variable v-seconds    as integer   no-undo .
      226     define variable v-hour       as integer   no-undo .
      227     define variable v-min        as integer   no-undo .
      228     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      229     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      230     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      231     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      232     if p-mjd-diff < 0
      233     or p-mjd-diff = ?
      234     then do:
      235       return "?" .
      236     end.
      237     assign
      238       v-day-number = integer(truncate(p-mjd-diff,0))
      239       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      240     .
      241     if v-seconds > 86400
      242     then do:
      243       assign
      244         v-seconds = 86400 - 1
      245       .
      246     end.
      247     if v-seconds < 0
      248     then do:
      249       assign
      250         v-seconds = 0
      251       .
      252     end.
      253     assign
      254       v-hour = truncate(v-seconds / 3600, 0)
      255     .
      256     assign
      257       v-seconds = v-seconds modulo 3600
      258     .
      259     assign
      260       v-min = truncate(v-seconds / 60, 0)
      261     .
      262     assign
      263       v-seconds = v-seconds modulo 60
      264     .
      265     return
      266         (if v-day-number <> 0
      267           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      268           else ""
      269         )
      270       + (if v-day-number <> 0 or v-hour <> 0
      271           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      272           else ""
      273         )
      274       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      275           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      276           else ""
      277         )
      278       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      279       .
      280   end.
      281   function cur-time-string returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-string-sec returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      300   end.
      301   function cur-time-custom  returns character
      302   (input p-prefix as character
      303   ,input p-date-format as character
      304   ,input p-delimiter as character
      305   ,input p-time-format as character
      306   ,input p-suffix as character
      307   )
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return
      316       p-prefix
      317       + string(v-date, p-date-format)
      318       + p-delimiter
      319       + string(v-time, p-time-format)
      320       + p-suffix
      321       .
      322   end.
      323   function cur-time-print  returns character
      324   :
      325     define variable v-date as date      no-undo .
      326     define variable v-time as integer   no-undo .
      327     run cur-time in this-procedure
      328       (output v-date
      329       ,output v-time
      330       ) .
      331     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      332   end.
      333   function cur-time-datetime returns datetime
      334   :
      335     define variable v-char as character no-undo .
      336     define variable v-datetime as datetime no-undo .
      337     v-char = cur-time-string().
      338     v-datetime = datetime(v-char).
      339     return  v-datetime.
      340   end.
      341   function cur-time-string-msec returns character
      342   :
      343     define variable v-date as datetime  no-undo .
      344     v-date = now.
      345     return string(v-date) .
      346   end.
      347   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      349   define new shared variable RepPathName        as character no-undo .
      350   define new shared variable PrintRubl          as logical   no-undo .
      351   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      352   define variable c-point  as character no-undo .
      353   define variable tbl      as character no-undo .
      354   define variable join-tbl as character no-undo .
      355   define variable fld      as character no-undo .
      356   define variable lab      as character no-undo .
      357   define variable spr      as character no-undo .
      358   define variable dim      as character no-undo .
      359   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   procedure fltfield-clear :
      361     define output parameter loc-fld as character no-undo.
      362     define output parameter loc-lab as character no-undo .
      363     define output parameter loc-spr as character no-undo .
      364     define output parameter loc-dim as character no-undo .
      365     assign
      366       loc-fld = ""
      367       loc-lab = ""
      368       loc-spr = ""
      369       loc-dim = "0"
      370     .
      371   end procedure .
      372   procedure fltfield-add :
      373     define input        parameter par-fld as character no-undo.
      374     define input        parameter par-lab as character no-undo .
      375     define input        parameter par-spr as character no-undo .
      376     define input-output parameter loc-fld as character no-undo.
      377     define input-output parameter loc-lab as character no-undo .
      378     define input-output parameter loc-spr as character no-undo .
      379     define input-output parameter loc-dim as character no-undo .
      380     do
      381     on error undo, return error
      382     :
      383       assign
      384       loc-fld = if loc-dim = '0'
      385                 then par-fld
      386                 else (loc-fld + chr(44) + par-fld)
      387       loc-lab = if loc-dim = '0'
      388                 then par-lab
      389                 else (loc-lab + chr(44) + par-lab)
      390       loc-spr = if loc-dim = '0'
      391                 then par-spr
      392                 else (loc-spr + chr(44) + par-spr)
      393       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      394                 string(integer(if num-entries(loc-dim) > 1
      395                               then entry(2, loc-dim)
      396                               else entry(1, loc-dim)
      397                               ) + 1)
      398       no-error
      399       .
      400     end.
      401   end procedure.
      402   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      403   define variable v-waitfram-action01         as character   no-undo .
      404   define variable v-waitfram-action02         as character   no-undo .
      405   define variable v-waitfram-action03         as character   no-undo .
      406   define variable mWaitFramTextBeg            as character   no-undo.
      407   define variable mWaitFramTextEnd            as character   no-undo.
      408   define variable mWaitFramView               as logical     no-undo.
      409   define variable mWaitProcEvent              as logical     no-undo init yes.
      410   define variable mWaitFramInterval           as integer     no-undo init 1 .
      411   define variable mWaitFramStop               as logical     no-undo.
      412   define variable mWaitFramStopUser           as logical     no-undo.
      413   define variable mWaitFramStopTimeOut        as logical     no-undo.
      414   define variable mWaitFramStartProc          as datetime-tz no-undo.
      415   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      416   define button B-WaitFramStop auto-end-key
      417        label "Стоп"
      418        size 10 by 1 tooltip "Остоновить процесс".
      419   define button B-viewProcInfo
      420        label "Информация"
      421        size 15 by 1 tooltip "Информация о процесс".
      422   define frame waitfram
      423     v-waitfram-action01 format "x(72)" no-label skip
      424     v-waitfram-action02 format "x(72)" no-label skip
      425     v-waitfram-action03 format "x(72)" no-label skip
      426     B-viewProcInfo
      427     B-WaitFramStop at row 4 col 30
      428     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      429     .
      430   define new global shared variable mBatchMode as logical no-undo init ?.
      431   define variable mFramBachModHandle as handle no-undo.
      432   mFramBachModHandle = frame waitfram:handle.
      433   define variable mFameOldVis as logical no-undo.
      434   define variable mVisCUrentVin as logical no-undo.
      435   if session:batch-mode
      436   then
      437      mBatchMode = yes.
      438   if mBatchMode = ? then do:
      439     mVisCUrentVin = current-window:visible.
      440     mFameOldVis = mFramBachModHandle:visible.
      441     mFramBachModHandle:visible  = yes.
      442     mBatchMode = mFramBachModHandle:visible ne yes.
      443     mFramBachModHandle:visible = mFameOldVis.
      444     current-window:visible = mVisCUrentVin.
      445   end.
      446    if  log-manager:logfile-name ne ?
      447     then DO:
      448         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      449         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      450         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      451     end.
      452   on choose of B-WaitFramStop in frame waitfram
      453   do:
      454     mWaitFramStop = yes.
      455     mWaitFramStopUser = yes.
      456   end.
      457   function waitfram-check-timeout returns logical():
      458      define variable vtime as int64 no-undo.
      459      if mWaitFramStopTimeOut
      460      then
      461         return yes.
      462      vtime = ( now - mWaitFramStartProc ) / 1000 .
      463      if     mWaitFramTimeOut ne ?
      464         and mWaitFramTimeOut ne 0
      465         and mWaitFramTimeOut lt vtime
      466      then do:
      467         mWaitFramStopTimeOut = yes.
      468      end.
      469      return mWaitFramStopTimeOut.
      470   end.
      471   procedure waitfram-hide :
      472     if not session:batch-mode
      473     then do
      474     on error undo, return error return-value
      475     :
      476       pause 0 before-hide .
      477       if not mBatchMode then
      478         hide frame waitfram .
      479     if     not mWaitFramView
      480        and mWaitProcEvent
      481     then
      482       process events .
      483     end.
      484   end procedure.
      485   procedure waitfram-show :
      486     define input  parameter p-message as character no-undo .
      487     define variable v-left-margin as integer   no-undo .
      488     if not session:batch-mode
      489     then do
      490     on error undo, return error return-value
      491     :
      492       if length(p-message) <= 70 then do:
      493         assign
      494           v-left-margin = integer((70 - length(p-message)) / 2)
      495         .
      496         assign
      497           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      498         .
      499         assign
      500           v-waitfram-action01 = " "
      501           v-waitfram-action02 = " "
      502                                    + fill(" ", v-left-margin)
      503                                    + p-message
      504           v-waitfram-action03 = " "
      505         .
      506       end.
      507       else do:
      508         define variable vRindex1 as integer no-undo.
      509         define variable vRindex2 as integer no-undo.
      510         vRindex1 = r-index(p-message," ",70).
      511         if vRindex1 = 0
      512         then
      513            vRindex1 = 70.
      514         if length(p-message)  <= vRindex1 + 70 then do:
      515           assign
      516             v-waitfram-action01 = " "
      517             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      518             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      519           .
      520         end.
      521         else do:
      522           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      523           if vRindex2 <= vRindex1
      524           then
      525              vRindex2 = vRindex1 + 70.
      526           assign
      527             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      528             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      529             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      530           .
      531         end.
      532       end.
      533       B-viewProcInfo:visible   in frame waitfram = no.
      534       B-viewProcInfo:sensitive in frame waitfram = no.
      535       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      536       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      537       if  (   mWaitFramView
      538          or  mWaitProcEvent)
      539          and not mBatchMode
      540       then
      541          display
      542             v-waitfram-action01 skip
      543             v-waitfram-action02 skip
      544             v-waitfram-action03 skip
      545          with frame waitfram .
      546       if     mWaitFramView
      547          then do:
      548             if     mWaitFramInterval ne ?
      549                and not mBatchMode
      550             then
      551                wait-for go of frame waitfram pause mWaitFramInterval.
      552          end.
      553          else
      554             if     mWaitProcEvent
      555                and not mBatchMode
      556             then
      557                process events .
      558     end.
      559   end procedure.
      560      procedure waitfram-show-this:
      561         define input  parameter iInterval as int64 no-undo.
      562         define variable vtime as int64 no-undo.
      563         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      564         mWaitFramInterval = iInterval.
      565         run waitfram-show (substitute("&1&2 &3&4" ,
      566                                       mWaitFramTextBeg ,
      567                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      568                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      569                                       mWaitFramTextEnd
      570                                      )
      571                           ).
      572      end.
      573      procedure WaitFramRunPause:
      574         define input  parameter iInterval as dec no-undo.
      575         define variable vStart  as datetime-tz no-undo.
      576         define variable vend    as datetime-tz no-undo.
      577         define variable vint as int64 no-undo.
      578         define variable vOk as logical no-undo.
      579         vStart = now.
      580         vend   = vStart.
      581         publish "WaitFramPause" (iInterval,output vOk).
      582         vend   =  now.
      583         vint = vend - vStart.
      584         vint = iInterval - vint / 1000.
      585         if     not mWaitFramStop
      586            and (   vint > 0
      587                 or (    not vOk
      588                     and iInterval eq ?
      589                     )
      590                 )
      591         then
      592            run waitfram-show-this (iInterval).
      593         vend   =  now.
      594         vint = vend - vStart.
      595         vint = iInterval - vint / 1000.
      596         if     not mWaitFramStop
      597            and vint > 0
      598         then do:
      599            run gbl/pause.p (vint * 1000).
      600         end.
      601         if iInterval ne ?
      602         then
      603            publish "WaitFramStop".
      604         waitfram-check-timeout().
      605      end.
      606      procedure WaitFramWaitFor:
      607         define input  parameter iInterval as dec no-undo.
      608         assign
      609            mWaitFramStartProc   = now
      610            mWaitFramStopUser    = no
      611            mWaitFramStopTimeOut = no
      612         .
      613         block-wait:
      614         do while not mWaitFramStop:
      615            run WaitFramRunPause (iInterval).
      616            if  waitfram-check-timeout()
      617            then do:
      618               leave block-wait.
      619            end.
      620         end.
      621         run waitfram-hide.
      622      end.
      623   procedure waitfram-join :
      624     define input  parameter p-line-1  as character no-undo .
      625     define input  parameter p-line-2  as character no-undo .
      626     define input  parameter p-line-3  as character no-undo .
      627     define output parameter p-message as character no-undo .
      628     do
      629     on error undo, return error return-value
      630     :
      631       assign
      632         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      633                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      634                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      635       .
      636     end.
      637   end procedure.
      638   function waitfram-join-function returns character
      639     (input p-line-1 as character
      640     ,input p-line-2 as character
      641     ,input p-line-3 as character
      642     ).
      643     define variable v-message as character no-undo .
      644     run waitfram-join in this-procedure
      645       (input  p-line-1
      646       ,input  p-line-2
      647       ,input  p-line-3
      648       ,output v-message
      649       ) .
      650     return v-message .
      651   end function .
      652   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      653   procedure factord :
      654     define input  parameter p-fact-date            as date    no-undo .
      655     define input  parameter p-fact-time            as integer no-undo .
      656     define input  parameter p-fact-num             as integer no-undo .
      657     define input  parameter p-shift-date           as date    no-undo .
      658     define input  parameter p-shift-num            as integer no-undo .
      659     define input  parameter p-shift-on             as logical no-undo .
      660     define output parameter p-fact-order           as decimal no-undo .
      661     define output parameter p-shift-end-fact-order as decimal no-undo .
      662     define output parameter p-day-end-fact-order   as decimal no-undo .
      663     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      664     if p-fact-date = ?
      665     then do:
      666       return error "Не указана фактическая дата" .
      667     end.
      668     define variable v-fact-date-num as integer no-undo .
      669     assign
      670       v-fact-date-num = integer(p-fact-date)
      671     .
      672     if p-fact-num = ?
      673     or p-fact-num = 0
      674     then do:
      675       return error "Не задан p-fact-num " + string(p-fact-num) .
      676     end.
      677     if p-fact-num < 0
      678     then do:
      679       return error "Отрицательный fact-num " + string(p-fact-num) .
      680     end.
      681     if p-fact-num >= 100000000
      682     then do:
      683       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      684     end.
      685     if p-shift-on = true
      686     then do:
      687       if p-shift-date = ?
      688       then do:
      689         return error "Не задана дата смены" .
      690       end.
      691       if p-shift-num = ?
      692       or p-shift-num = 0
      693       then do:
      694         return error "Не задан номер смены" .
      695       end.
      696     end.
      697     else do:
      698       assign
      699         p-shift-date = p-fact-date
      700         p-shift-num  = 24
      701       .
      702     end.
      703     define variable v-shift-offset as integer no-undo .
      704     if p-shift-date = p-fact-date
      705     then do:
      706       assign
      707         v-shift-offset = 1
      708       .
      709     end.
      710     if p-shift-date < p-fact-date
      711     then do:
      712       assign
      713         v-shift-offset = 0
      714       .
      715     end.
      716     if p-shift-date > p-fact-date
      717     then do:
      718       message
      719         vss-workfile vss-revision vss-description skip
      720         "Неправильная дата закрытия смены" skip
      721         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      722         view-as alert-box error .
      723       undo, return error
      724         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      725           ,string(p-fact-date, '99/99/9999':U)
      726           ,string(p-shift-date, '99/99/9999':U)
      727           )
      728       .
      729     end.
      730     if p-shift-num < 1
      731     or p-shift-num > 24
      732     then do:
      733       message
      734         vss-workfile vss-revision vss-description skip
      735         "Неправильный номер смены" skip
      736         "p-shift-num" p-shift-num skip
      737         view-as alert-box error .
      738       undo, return error return-value .
      739     end.
      740     assign
      741       p-fact-order           = v-fact-date-num
      742                              + v-shift-offset * 0.5
      743                              + p-shift-num    * 0.02 - 0.01
      744                              + p-fact-num     * 0.0000000001
      745       p-shift-end-fact-order = v-fact-date-num
      746                              + v-shift-offset * 0.5
      747                              + p-shift-num    * 0.02
      748       p-day-end-fact-order   = v-fact-date-num
      749                              + 0.99
      750     .
      751     if p-fact-order           <= v-fact-date-num
      752     or p-shift-end-fact-order <= v-fact-date-num
      753     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      754     or p-shift-end-fact-order >= p-day-end-fact-order
      755     then do:
      756       message
      757         vss-workfile vss-revision vss-description skip
      758         "Внутренняя ошибка при генерации фактического номера" skip
      759         "p-fact-date"            p-fact-date            skip
      760         "p-fact-time"            p-fact-time            skip
      761         "p-fact-num"             p-fact-num             skip
      762         "p-shift-date"           p-shift-date           skip
      763         "p-shift-num"            p-shift-num            skip
      764         "p-shift-on"             p-shift-on             skip
      765         "p-shift-end-fact-order" p-shift-end-fact-order skip
      766         "p-day-end-fact-order"   p-day-end-fact-order   skip
      767         "v-fact-date-num"        v-fact-date-num        skip
      768         view-as alert-box error .
      769       undo, return error return-value .
      770     end.
      771   end procedure.
      772   procedure day-begin-fact-order :
      773     define input  parameter p-fact-date            as date    no-undo .
      774     define output parameter p-day-begin-fact-order as decimal no-undo .
      775     do
      776     on error undo, return error return-value
      777     :
      778       if p-fact-date = ?
      779       then do:
      780         assign
      781           p-day-begin-fact-order = 0
      782         .
      783       end.
      784       else do:
      785         assign
      786           p-day-begin-fact-order = integer(p-fact-date)
      787         .
      788       end.
      789     end.
      790   end procedure.
      791   procedure factord-max-fact-order :
      792     define output parameter p-max-fact-order as decimal   no-undo .
      793     do
      794     on error undo, return error return-value
      795     :
      796       run day-begin-fact-order in this-procedure
      797         (input  date(1, 1, 5000)
      798         ,output p-max-fact-order
      799         ) .
      800     end.
      801   end procedure.
      802   procedure factord-cut-archive :
      803     define input  parameter p-obj-type             as character no-undo .
      804     define input  parameter p-obj-code             as integer   no-undo .
      805     define input  parameter p-fact-date            as date      no-undo .
      806     define output parameter p-shift-on             as logical   no-undo .
      807     define output parameter p-shift-date           as date      no-undo .
      808     define output parameter p-shift-num            as integer   no-undo .
      809     define output parameter p-day-end-fact-order   as decimal   no-undo .
      810     define output parameter p-shift-end-fact-order as decimal   no-undo .
      811     define variable v-fact-order as decimal   no-undo .
      812     define buffer buf_shift-obj for ub.shift-obj .
      813     do
      814     on error undo, return error return-value
      815     :
      816   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      817   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      818     (input  p-obj-type
      819     ,input  p-obj-code
      820     ,input  'shift-on=request'
      821     ,output p-shift-on
      822     ) no-error .
      823       if error-status :error
      824       then do:
      825         message
      826           vss-workfile vss-revision vss-description skip
      827           "Ошибка при определении атрибута объекта" skip
      828           "Объект" p-obj-type p-obj-code skip
      829           error-status :get-message(1) skip
      830           return-value skip
      831           view-as alert-box error .
      832         undo, return error return-value .
      833       end.
      834       if p-shift-on = false
      835       then do:
      836         assign
      837           p-shift-date               = ?
      838           p-shift-num                = 0
      839         .
      840       end.
      841       else do:
      842         find first buf_shift-obj share-lock
      843           where buf_shift-obj.obj-type   = p-obj-type
      844             and buf_shift-obj.obj-code   = p-obj-code
      845             and buf_shift-obj.shift-date > p-fact-date
      846           use-index pi
      847           no-error .
      848         if not available buf_shift-obj
      849         or buf_shift-obj.status_ <> 'зкр':U
      850         then do:
      851           message
      852             vss-workfile vss-revision vss-description skip
      853             "Невозможно вычислить последнюю смену" skip
      854             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      855             "Объект" p-obj-type p-obj-code skip
      856             "Дата" p-fact-date skip
      857             view-as alert-box error .
      858           undo, return error return-value .
      859         end.
      860         find last buf_shift-obj share-lock
      861           where buf_shift-obj.obj-type = p-obj-type
      862             and buf_shift-obj.obj-code = p-obj-code
      863             and buf_shift-obj.shift-date <= p-fact-date
      864           use-index pi
      865           no-error .
      866         if available buf_shift-obj
      867         then do:
      868           if  buf_shift-obj.status_ = 'зкр':U
      869           then do:
      870             assign
      871               p-shift-date = buf_shift-obj.shift-date
      872               p-shift-num  = buf_shift-obj.shift-num
      873             .
      874           end.
      875           else do:
      876             message
      877               vss-workfile vss-revision vss-description skip
      878               "Невозможно вычислить последнюю смену" skip
      879               "Статус смены отличен от статуса" 'зкр':U skip
      880               "Объект" p-obj-type p-obj-code skip
      881               "Дата" p-fact-date skip
      882               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      883               view-as alert-box error .
      884             undo, return error return-value .
      885           end.
      886         end.
      887         else do:
      888           assign
      889             p-shift-date = p-fact-date - 1
      890             p-shift-num  = 1
      891           .
      892         end.
      893       end.
      894       run factord in this-procedure
      895         (input  p-fact-date
      896         ,input  1
      897         ,input  1
      898         ,input  p-shift-date
      899         ,input  p-shift-num
      900         ,input  p-shift-on
      901         ,output v-fact-order
      902         ,output p-shift-end-fact-order
      903         ,output p-day-end-fact-order
      904         ) no-error .
      905       if error-status :error
      906       then do:
      907         message
      908           vss-workfile vss-revision vss-description skip
      909           "Ошибка при вызове процедуры factord"
      910           error-status :get-message(1) skip
      911           return-value skip
      912           view-as alert-box error .
      913         undo, return error return-value .
      914       end.
      915     end.
      916   end procedure.
      917   procedure factord-lock-shift :
      918     define input  parameter p-obj-type  as character no-undo .
      919     define input  parameter p-obj-code  as integer   no-undo .
      920     define input  parameter p-fact-date as date      no-undo .
      921     define parameter buffer buf_shift-obj for ub.shift-obj .
      922     define variable v-shift-on      as logical   no-undo .
      923     define variable v-extra-message as character no-undo .
      924     define variable v-error as character no-undo .
      925     do
      926     on error undo, return error return-value
      927     :
      928   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      930     (input  p-obj-type
      931     ,input  p-obj-code
      932     ,input  'shift-on=request'
      933     ,output v-shift-on
      934     ) no-error .
      935       if error-status :error
      936       then do:
      937         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      938         undo, return error v-error .
      939       end.
      940       if v-shift-on = true
      941       then do:
      942         find first buf_shift-obj share-lock
      943           where buf_shift-obj.obj-type   = p-obj-type
      944             and buf_shift-obj.obj-code   = p-obj-code
      945             and buf_shift-obj.shift-date > p-fact-date
      946           use-index pi
      947           no-error .
      948         if not available buf_shift-obj
      949         or buf_shift-obj.status_ <> 'зкр':U
      950         then do:
      951           find last buf_shift-obj
      952             where buf_shift-obj.obj-type = p-obj-type
      953               and buf_shift-obj.obj-code = p-obj-code
      954               and buf_shift-obj.status_  = 'зкр':U
      955             use-index stts
      956             no-error .
      957           if available buf_shift-obj
      958           then do:
      959             assign
      960               v-extra-message =
      961                     substitute("Дата начала последеней закрытой смены на объекте &1"
      962                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      963                               )
      964             .
      965           end.
      966           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      967           undo, return error v-error .
      968         end.
      969       end.
      970     end.
      971   end procedure.
      972   procedure factord-end-day :
      973     define input  parameter p-fact-date            as date    no-undo .
      974     define output parameter p-day-end-fact-order   as decimal no-undo .
      975     do
      976     on error undo, return error return-value
      977     :
      978       if p-fact-date = ?
      979       then do:
      980         return error "Не указана фактическая дата" .
      981       end.
      982       assign
      983         p-day-end-fact-order = integer(p-fact-date) + 0.99
      984       .
      985     end.
      986   end procedure.
      987   procedure factord-to-date :
      988     define input  parameter p-fact-order as decimal no-undo .
      989     define output parameter p-fact-date  as date    no-undo .
      990     define variable v-ref-date  as date      no-undo .
      991     define variable v-ref-delta as integer   no-undo .
      992     do
      993     on error undo, return error return-value
      994     :
      995       if p-fact-order = ?
      996       or p-fact-order = 0
      997       then do:
      998         return error "Не указан fact-order" .
      999       end.
     1000       assign
     1001         v-ref-date  = date(1, 1, 2000)
     1002       .
     1003       assign
     1004         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1005       .
     1006       assign
     1007         p-fact-date = v-ref-date + v-ref-delta
     1008       .
     1009     end.
     1010   end procedure.
     1011   procedure factord-to-fact-num :
     1012     define input  parameter p-fact-order as decimal no-undo .
     1013     define output parameter p-fact-num   as integer no-undo .
     1014     define variable v-fact-order-trunc as decimal no-undo .
     1015     do
     1016     on error undo, return error return-value
     1017     :
     1018       if p-fact-order = ?
     1019       or p-fact-order = 0
     1020       then do:
     1021         return error "Не указан fact-order" .
     1022       end.
     1023       assign
     1024        v-fact-order-trunc = truncate(p-fact-order, 2)
     1025       .
     1026       assign
     1027         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1028       .
     1029     end.
     1030   end procedure.
     1031   procedure factord-to-shift-num :
     1032     define input  parameter p-fact-order as decimal no-undo .
     1033     define output parameter p-shift-num   as integer no-undo .
     1034     define variable  p-shift-numd  as decimal   no-undo .
     1035     define variable v-fact-order-trunc as decimal no-undo .
     1036     do
     1037     on error undo, return error return-value
     1038     :
     1039       if p-fact-order = ?
     1040       or p-fact-order = 0
     1041       then do:
     1042         return error "Не указан fact-order" .
     1043       end.
     1044       assign
     1045        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1046       .
     1047       if v-fact-order-trunc < 0.5 then do:
     1048         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1049       end.
     1050       assign
     1051         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1052         .
     1053        assign
     1054         p-shift-num = truncate (p-shift-numd , 0)
     1055       .
     1056     end.
     1057   end procedure.
     1058   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1059   FUNCTION mark-string RETURNS CHARACTER
     1060     ( input p-recid as recid, input mark-list as character  ) :
     1061     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1062   END FUNCTION.
     1063   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1064   function usrfulnf returns character ( input p-user-id as character):
     1065   define variable v-user-name as character no-undo .
     1066   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1067   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1068     (input  p-user-id
     1069     ,output v-user-name
     1070     ) no-error .
