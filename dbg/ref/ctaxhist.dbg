     3721   PROCEDURE proc-b-sch :
     3722   assign
     3723   tbl = 'c-tax-hist'
     3724   join-tbl = 'X_c-tax-hist'
     3725   fld = ""
     3726   lab = ""
     3727   spr = ""
     3728   dim = '0'
     3729   .
     3730   run fltfield-add in this-procedure('subject', 'Предмет изменений', 'tax-hist-subject',
     3731   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3732   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     3733   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3734   run fltfield-add in this-procedure('tax-code', 'Код налога', '',
     3735   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3736   run fltfield-add in this-procedure('rate-code', 'Код ставки', '',
     3737   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3738   run fltfield-add in this-procedure('corr-date', 'Дата изменений', '',
     3739   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3740   run fltfield-add in this-procedure('corr-time', 'Время изменений', 'time',
     3741   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3742   run fltfield-add in this-procedure('corr-user-db-num', 'БД изменений', '',
     3743   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3744   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3745   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3746   DO on stop undo, leave:
     3747       run gbl/filter.w ( input parparentproc
     3748                         ,input (filter-point + chr(4) + filter-label0)
     3749                         ,input tbl
     3750                         ,input join-tbl
     3751                         ,input fld
     3752                         ,input lab
     3753                         ,input spr
     3754                         ,input dim).
     3755       RUN OpenBr in this-procedure  ( input yes, input no, input '':U).
     3756   END .
     3757   END PROCEDURE.
     3758   PROCEDURE proc-view-changes :
     3759   define variable v-description as character no-undo .
     3760   for each temp-changes:
     3761       delete temp-changes.
     3762   END.
     3763   if not available X_c-tax-hist then do:
     3764     Open QUery br-changes for each temp-changes.
     3765     return.
     3766   end.
     3767   run ref/ctaxhisv.p (
     3768                      input X_c-tax-hist.tax-code
     3769                     ,input X_c-tax-hist.rate-code
     3770                     ,input X_c-tax-hist.corr-user-db-num
     3771                     ,input X_c-tax-hist.chip-num
     3772                     ,input X_c-tax-hist.host-code
     3773                     ,input X_c-tax-hist.obj-type
     3774                     ,input X_c-tax-hist.obj-code
     3775                     ,input X_c-tax-hist.subject
     3776                     ,input X_c-tax-hist.action
     3777                     ,input no
     3778                     ,output v-description
     3779                  ) no-error .
     3780   Open QUery br-changes for each temp-changes.
     3781   assign
     3782   br-changes:title in frame Dialog-Frame = v-description
     3783   .
     3784   END PROCEDURE.
     3785   FUNCTION get-action RETURNS CHARACTER
     3786     (  p-action as integer ) :
     3787     define variable dops as character no-undo.
     3788   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     3789   RETURN dops.
     3790   END FUNCTION.
     3791   FUNCTION get-fact-date-str RETURNS CHARACTER
     3792     ( INPUT p-fact-order AS DECIMAL ) :
     3793   DEFINE VARIABLE v-fact-date AS DATE NO-UNDO.
     3794   DEFINE VARIABLE v-fact-date-str AS character NO-UNDO.
     3795   RUN factord-to-date  IN THIS-PROCEDURE(p-fact-order, OUTPUT v-fact-date) NO-ERROR.
     3796   IF NOT ERROR-STATUS:ERROR  THEN DO:
     3797      ASSIGN
     3798      v-fact-date-str = STRING(v-fact-date, "99/99/9999":U)
     3799      .
     3800      RETURN v-fact-date-str.
     3801   END.
     3802   RETURN chr(63).
     3803   END FUNCTION.
