     2123         or error-status :get-message(1) <> ""
     2124         then do:
     2125           undo move_block, retry move_block .
     2126         end.
     2127         for each buf_temp-browse-handle
     2128           where buf_temp-browse-handle.browse-type = 'height':u
     2129         on error undo move_block, retry move_block
     2130         :
     2131           assign
     2132             buf_temp-browse-handle.browse-handle :height
     2133               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2134             no-error .
     2135           if error-status :error
     2136           or error-status :get-message(1) <> ""
     2137           then do:
     2138             undo move_block, retry move_block .
     2139           end.
     2140         end.
     2141         for each buf_temp-diasize-handle
     2142         on error undo move_block, retry move_block
     2143         :
     2144           assign
     2145             v-object-handle = buf_temp-diasize-handle.handle-value
     2146           .
     2147           if v-object-handle <> v-diasize-resize-button
     2148           then do:
     2149             assign
     2150               v-object-handle :row = v-object-handle :row + p-change-value
     2151               no-error .
     2152             if error-status :error
     2153             or error-status :get-message(1) <> ""
     2154             then do:
     2155               undo move_block, retry move_block .
     2156             end.
     2157           end.
     2158         end.
     2159       end.
     2160       else do:
     2161         for each buf_temp-diasize-handle
     2162         on error undo move_block, retry move_block
     2163         :
     2164           assign
     2165             v-object-handle = buf_temp-diasize-handle.handle-value
     2166           .
     2167           if v-object-handle <> v-diasize-resize-button
     2168           then do:
     2169             assign
     2170               v-object-handle :row = v-object-handle :row + p-change-value
     2171               no-error .
     2172             if error-status :error
     2173             or error-status :get-message(1) <> ""
     2174             then do:
     2175               undo move_block, retry move_block .
     2176             end.
     2177           end.
     2178         end.
     2179         assign
     2180           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2181           no-error .
     2182         if error-status :error
     2183         or error-status :get-message(1) <> ""
     2184         then do:
     2185           undo move_block, retry move_block .
     2186         end.
     2187         for each buf_temp-browse-handle
     2188           where buf_temp-browse-handle.browse-type = 'height':u
     2189         on error undo move_block, retry move_block
     2190         :
     2191           assign
     2192             buf_temp-browse-handle.browse-handle :height
     2193               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2194             no-error .
     2195           if error-status :error
     2196           or error-status :get-message(1) <> ""
     2197           then do:
     2198             undo move_block, retry move_block .
     2199           end.
     2200         end.
