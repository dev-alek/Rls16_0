     2213             no-error .
     2214           if error-status :error
     2215           or error-status :get-message(1) <> ""
     2216           then do:
     2217             undo move_block, retry move_block .
     2218           end.
     2219         end.
     2220       end.
     2221       if p-move-resize = true
     2222       then do:
     2223         run diasize_position-resize-button in this-procedure .
     2224       end.
     2225       if v-diasize-wndstore = true
     2226       then do:
     2227         if connected("ub") = true
     2228         then do:
     2229           define variable v-cntxt-db-num        as integer   no-undo .
     2230           define variable v-cntxt-userid        as character no-undo .
     2231           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2232                                             , OUTPUT v-cntxt-userid
     2233                                             ) .
     2234           run gbl/wndsizew.p
     2235             (input  v-cntxt-db-num
     2236             ,input  v-cntxt-userid
     2237             ,input  v-diasize-proc-name
     2238             ,input  'height':u
     2239             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2240             ) .
     2241         end.
     2242       end.
     2243     end.
     2244     assign
     2245       v-diasize-change-size = false
     2246     .
     2247   end procedure.
     2248   procedure diasize_set-height :
     2249     define input  parameter p-new-height  as decimal   no-undo .
     2250     define input  parameter p-move-resize as logical   no-undo .
     2251     do
     2252     on error undo, return error return-value
     2253     :
     2254       run diasize_change-height in this-procedure
     2255         (input  (p-new-height - frame Dialog-Frame :height)
     2256         ,input  p-move-resize
     2257         ) .
     2258     end.
     2259   end procedure.
     2260   procedure diasize_change-width :
     2261     define input  parameter p-change-value as decimal   no-undo .
     2262     define input  parameter p-move-resize  as logical   no-undo .
     2263     define variable v-field-group-handle   as handle    no-undo .
     2264     define variable v-object-handle        as handle    no-undo .
     2265     define variable v-frame-width          as decimal   no-undo .
     2266     define variable v-frame-virtual-width  as decimal   no-undo .
     2267     define variable v-browse-width         as decimal   no-undo .
     2268     define variable v-window-width         as decimal   no-undo .
     2269     define variable v-window-virtual-width as decimal   no-undo .
     2270     define variable v-change-sign          as integer   no-undo .
     2271     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2272     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2273     if p-change-value > 0
     2274     then do:
     2275       if frame Dialog-Frame :width + p-change-value >
     2276           session :width-chars
     2277       then do:
     2278         assign
     2279           p-change-value = session :width-chars - frame Dialog-Frame :width
     2280         .
     2281         if p-change-value <= 0
     2282         then do:
     2283           run diasize_position-resize-button in this-procedure .
     2284           return .
     2285         end.
     2286       end.
     2287     end.
     2288     if p-change-value < 0
     2289     then do:
     2290       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2291       then do:
     2292         assign
     2293           p-change-value = v-diasize-orig-frame-width
     2294                          - frame Dialog-Frame :width
     2295         .
     2296         if p-change-value >= 0
     2297         then do:
     2298           run diasize_position-resize-button in this-procedure .
     2299           return .
     2300         end.
     2301       end.
     2302     end.
     2303     if p-change-value >= 0
     2304     then do:
     2305       assign
     2306         v-change-sign = 1
     2307       .
     2308     end.
     2309     else do:
     2310       assign
     2311         v-change-sign = -1
     2312       .
     2313     end.
     2314     assign
     2315       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2316     .
     2317     if p-change-value = 0
     2318     then do:
     2319       run diasize_position-resize-button in this-procedure .
     2320       return .
     2321     end.
     2322     move_block:
     2323     do
     2324     on error undo move_block, leave move_block
     2325     :
     2326       if retry
     2327       then do:
     2328         do
     2329         on error undo move_block, leave move_block
     2330         :
     2331           if p-change-value > 0
     2332           then do:
     2333             for each buf_temp-diasize-handle
     2334             on error undo, next
     2335             :
     2336               assign
     2337                 v-object-handle = buf_temp-diasize-handle.handle-value
     2338               .
     2339               if v-object-handle <> v-diasize-resize-button
     2340               then do:
     2341                 assign
     2342                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2343                 .
     2344               end.
     2345             end.
     2346             assign
     2347               v-diasize-browse-handle :width = v-browse-width
     2348             .
     2349             for each buf_temp-browse-handle
     2350               where buf_temp-browse-handle.browse-type = 'width':u
     2351             on error undo, next
     2352             :
     2353               assign
     2354                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2355               .
     2356             end.
     2357             assign
     2358               frame Dialog-Frame :width = v-frame-width
     2359             .
     2360             if frame Dialog-Frame :scrollable = true
     2361             then do:
     2362               assign
     2363                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2364               .
     2365             end.
     2366             run diasize_position-resize-button in this-procedure .
     2367           end.
     2368           else do:
     2369             if frame Dialog-Frame :scrollable = true
     2370             then do:
     2371               assign
     2372                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2373               .
     2374             end.
     2375             assign
     2376               frame Dialog-Frame :width = v-frame-width
     2377             .
     2378             for each buf_temp-browse-handle
     2379               where buf_temp-browse-handle.browse-type = 'width':u
     2380             on error undo, next
     2381             :
     2382               assign
     2383                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2384               .
     2385             end.
     2386             assign
     2387               v-diasize-browse-handle :width = v-browse-width
     2388             .
     2389             for each buf_temp-diasize-handle
     2390             on error undo, next
     2391             :
     2392               assign
     2393                 v-object-handle = buf_temp-diasize-handle.handle-value
     2394               .
     2395               if v-object-handle <> v-diasize-resize-button
     2396               then do:
     2397                 assign
     2398                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2399                 .
     2400               end.
     2401             end.
     2402             run diasize_position-resize-button in this-procedure .
     2403           end.
     2404           assign
     2405             v-diasize-change-size = false
     2406           .
     2407           leave move_block .
     2408         end.
     2409       end.
     2410       assign
     2411         v-diasize-need-full-display = true
     2412       .
     2413       if v-diasize-change-size = false
     2414       then do:
     2415         assign
     2416           v-diasize-change-size = true
     2417         .
     2418       end.
     2419       else do:
     2420         return .
     2421       end.
     2422       assign
     2423         v-frame-width = frame Dialog-Frame :width
     2424         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2425         v-browse-width = v-diasize-browse-handle :width
     2426       .
     2427       for each buf_temp-browse-handle
     2428         where buf_temp-browse-handle.browse-type = 'width':u
     2429       :
     2430         assign
     2431           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2432         .
     2433       end.
     2434       for each buf_temp-diasize-handle
     2435       :
     2436         delete buf_temp-diasize-handle .
     2437       end.
     2438       assign
     2439         v-field-group-handle = frame Dialog-Frame :first-child
     2440       .
     2441       do while valid-handle(v-field-group-handle)
     2442       :
     2443         assign
     2444           v-object-handle = v-field-group-handle :first-child
     2445         .
     2446         do while valid-handle(v-object-handle)
     2447         :
     2448           if  v-object-handle <> v-diasize-browse-handle :handle
     2449           and v-object-handle <> v-diasize-resize-button
     2450           and can-query(v-object-handle, "row")
     2451           and can-query(v-object-handle, "height")
     2452           and ( v-object-handle :col + v-object-handle :width
     2453                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2454               )
     2455           then do:
     2456             find first buf_temp-browse-handle
     2457               where buf_temp-browse-handle.browse-type   = 'width':u
     2458                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2459               no-error .
     2460             if available buf_temp-browse-handle
     2461             then do:
     2462             end.
     2463             else do:
     2464               create buf_temp-diasize-handle .
     2465               assign
     2466                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2467                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2468               .
     2469             end.
     2470           end.
     2471           assign
     2472             v-object-handle = v-object-handle :next-sibling
     2473           .
     2474         end.
     2475         assign
     2476           v-field-group-handle = v-field-group-handle :next-sibling
     2477         .
     2478       end.
     2479       do with frame Dialog-Frame
     2480       :
     2481         hide v-diasize-resize-button .
     2482         v-diasize-resize-button :row = 1.
     2483         v-diasize-resize-button :column = 1.
     2484       end.
     2485       if p-change-value > 0
     2486       then do:
     2487         if frame Dialog-Frame :scrollable = true
     2488         then do:
     2489           assign
     2490             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2491             no-error .
     2492           if error-status :error
     2493           or error-status :get-message(1) <> ""
     2494           then do:
     2495             undo move_block, retry move_block.
     2496           end.
     2497         end.
     2498         assign
     2499           frame Dialog-Frame :width = v-frame-width + p-change-value
     2500           no-error .
     2501         if error-status :error
     2502         or error-status :get-message(1) <> ""
     2503         then do:
     2504           undo move_block, retry move_block.
     2505         end.
     2506         assign
     2507           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2508         no-error .
     2509         if error-status :error
     2510         or error-status :get-message(1) <> ""
     2511         then do:
     2512           undo move_block, retry move_block.
     2513         end.
     2514         for each buf_temp-browse-handle
     2515           where buf_temp-browse-handle.browse-type = 'width':u
     2516         on error undo move_block, retry move_block
     2517         :
     2518           assign
     2519             buf_temp-browse-handle.browse-handle :width
     2520               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2521             no-error .
     2522           if error-status :error
     2523           or error-status :get-message(1) <> ""
     2524           then do:
     2525             undo move_block, retry move_block .
     2526           end.
     2527         end.
     2528         for each buf_temp-diasize-handle
     2529         on error undo move_block, retry move_block
     2530         :
     2531           assign
     2532             v-object-handle = buf_temp-diasize-handle.handle-value
     2533           .
     2534           if v-object-handle <> v-diasize-resize-button
     2535           then do:
     2536             assign
     2537               v-object-handle :col = v-object-handle :col + p-change-value
     2538               no-error .
     2539             if error-status :error
     2540             or error-status :get-message(1) <> ""
     2541             then do:
     2542               undo move_block, retry move_block .
     2543             end.
     2544           end.
     2545         end.
     2546       end.
     2547       else do:
     2548         for each buf_temp-diasize-handle
     2549         on error undo move_block, retry move_block
     2550         :
     2551           assign
     2552             v-object-handle = buf_temp-diasize-handle.handle-value
     2553           .
     2554           if v-object-handle <> v-diasize-resize-button
     2555           then do:
     2556             assign
     2557               v-object-handle :col = v-object-handle :col + p-change-value
     2558               no-error .
     2559             if error-status :error
     2560             or error-status :get-message(1) <> ""
     2561             then do:
     2562               undo move_block, retry move_block .
     2563             end.
     2564           end.
     2565         end.
     2566         for each buf_temp-browse-handle
     2567           where buf_temp-browse-handle.browse-type = 'width':u
     2568         on error undo move_block, retry move_block
     2569         :
     2570           assign
     2571             buf_temp-browse-handle.browse-handle :width
     2572               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2573             no-error .
     2574           if error-status :error
     2575           or error-status :get-message(1) <> ""
     2576           then do:
     2577             undo move_block, retry move_block .
     2578           end.
     2579         end.
     2580         assign
     2581           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2582           no-error .
     2583         if error-status :error
     2584         or error-status :get-message(1) <> ""
     2585         then do:
     2586           undo move_block, retry move_block.
     2587         end.
     2588         assign
     2589           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2590         no-error .
     2591         if error-status :error
     2592         or error-status :get-message(1) <> ""
     2593         then do:
     2594           undo move_block, retry move_block.
     2595         end.
     2596         if frame Dialog-Frame :scrollable = true
     2597         then do:
     2598           assign
     2599             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2600           no-error .
     2601           if error-status :error
     2602           or error-status :get-message(1) <> ""
     2603           then do:
     2604             undo move_block, retry move_block.
     2605           end.
     2606         end.
     2607       end.
     2608       if p-move-resize
     2609       then do:
     2610         run diasize_position-resize-button in this-procedure .
     2611       end.
     2612       if v-diasize-wndstore = true
     2613       then do:
     2614         if connected("ub") = true
     2615         then do:
     2616           define variable v-cntxt-db-num        as integer   no-undo .
     2617           define variable v-cntxt-userid        as character no-undo .
     2618           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2619                                             , OUTPUT v-cntxt-userid
     2620                                             ) .
     2621           run gbl/wndsizew.p
     2622             (input  v-cntxt-db-num
     2623             ,input  v-cntxt-userid
     2624             ,input  v-diasize-proc-name
     2625             ,input  'width':u
     2626             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2627             ) .
     2628         end.
     2629       end.
     2630     end.
     2631     assign
     2632       v-diasize-change-size = false
     2633     .
     2634   end procedure.
     2635   procedure diasize_set-width :
     2636     define input  parameter p-new-width  as decimal   no-undo .
     2637     define input  parameter p-move-resize as logical   no-undo .
     2638     do
     2639     on error undo, return error return-value
     2640     :
     2641       run diasize_change-width in this-procedure
     2642         (input  (p-new-width - frame Dialog-Frame :width)
     2643         ,input  p-move-resize
     2644         ) .
     2645     end.
     2646   end procedure.
     2647   procedure diasize_position-resize-button :
     2648     do with frame Dialog-Frame
     2649     :
     2650       hide v-diasize-resize-button .
     2651       assign
     2652         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2653                     - 1
     2654                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2655         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2656                     - 1
     2657                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2658       .
     2659       view v-diasize-resize-button .
     2660     end.
     2661   end procedure.
     2662   on alt-right anywhere
     2663   do:
     2664     run diasize_change-width in this-procedure
     2665       (input 1
     2666       ,input true
     2667       ) .
     2668     return no-apply .
     2669   end.
     2670   on alt-left anywhere
     2671   do:
     2672     run diasize_change-width in this-procedure
     2673       (input -1
     2674       ,input true
     2675       ) .
     2676     return no-apply .
     2677   end.
     2678   on alt-down anywhere
     2679   do:
     2680     run diasize_change-height in this-procedure
     2681       (input 1
     2682       ,input true
     2683       ) .
     2684     return no-apply .
     2685   end.
     2686   on alt-up anywhere
     2687   do:
     2688     run diasize_change-height in this-procedure
     2689       (input -1
     2690       ,input true
     2691       ) .
     2692     return no-apply .
     2693   end.
     2694   on alt-enter of frame Dialog-Frame
     2695   do:
     2696     run diasize_maximize in this-procedure
     2697       (input  ?
     2698       ).
     2699     return no-apply .
     2700   end.
     2701   procedure diasize_end-move :
     2702     do
     2703     on error undo, return error return-value
     2704     :
     2705       define variable v-row-delta as decimal   no-undo .
     2706       define variable v-col-delta as decimal   no-undo .
     2707       define variable v-new-row as decimal   no-undo .
     2708       define variable v-new-col as decimal   no-undo .
     2709       assign
     2710         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2711         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2712       .
     2713       assign
     2714         v-row-delta = v-new-row - frame Dialog-Frame :height
     2715         v-col-delta = v-new-col - frame Dialog-Frame :width
     2716       .
     2717       run diasize_change-height in this-procedure
     2718         (input v-row-delta
     2719         ,input true
     2720         ) .
     2721       run diasize_change-width in this-procedure
     2722         (input v-col-delta
     2723         ,input true
     2724         ) .
     2725     end.
     2726   end procedure.
     2727   procedure diasize_maximize :
     2728     define input  parameter p-action as logical   no-undo .
     2729     do
     2730     on error undo, return error return-value
     2731     :
     2732       if p-action = ?
     2733       then do:
     2734         if v-diasize-need-maximize = true
     2735         then do:
     2736           assign
     2737             p-action = true
     2738           .
     2739         end.
     2740         else do:
     2741           assign
     2742             p-action = false
     2743           .
     2744         end.
     2745       end.
     2746       if p-action = true
     2747       then do:
     2748         run diasize_change-height in this-procedure
     2749           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2750               - frame Dialog-Frame :height-chars
     2751           ,input true
     2752           ) .
     2753         run diasize_change-width in this-procedure
     2754           (input session :width-chars
     2755               - frame Dialog-Frame :width-chars
     2756           ,input true
     2757           ) .
     2758         assign
     2759           v-diasize-need-maximize = false
     2760         .
     2761       end.
     2762       else do:
     2763         run diasize_change-width in this-procedure
     2764           (input v-diasize-orig-frame-width
     2765               - frame Dialog-Frame :width-chars
     2766           ,input true
     2767           ) .
     2768         run diasize_change-height in this-procedure
     2769           (input v-diasize-orig-frame-height
     2770               - frame Dialog-Frame :height-chars
     2771           ,input true
     2772           ) .
     2773         assign
     2774           v-diasize-need-maximize = true
     2775         .
     2776       end.
     2777     end.
     2778   end procedure.
     2779   procedure diasize_restore-orig-size :
     2780     do
     2781     on error undo, return error return-value
     2782     :
     2783       assign
     2784         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2785         v-diasize-current-frame-height = frame Dialog-Frame :height
     2786       .
     2787       run diasize_set-height in this-procedure
     2788         (input  v-diasize-orig-frame-height
     2789         ,input  true
     2790         ) .
     2791       run diasize_set-width in this-procedure
     2792         (input  v-diasize-orig-frame-width
     2793         ,input  true
     2794         ) .
     2795     end.
     2796   end procedure.
     2797   procedure diasize_restore-current-size :
     2798     do
     2799     on error undo, return error return-value
     2800     :
     2801       run diasize_set-height in this-procedure
     2802         (input  v-diasize-current-frame-height
     2803         ,input  true
     2804         ) .
     2805       run diasize_set-width in this-procedure
     2806         (input  v-diasize-current-frame-width
     2807         ,input  true
     2808         ) .
     2809     end.
     2810   end procedure.
     2811   procedure diasize_set-browse-handle :
     2812     define input  parameter p-browse-handle as handle   no-undo .
     2813     define buffer buf_temp-browse-handle for temp-browse-handle .
     2814     do
     2815     on error undo, return error return-value
     2816     :
     2817       assign
     2818         v-diasize-browse-handle = p-browse-handle
     2819       .
     2820       for each buf_temp-browse-handle
     2821       on error undo, return error return-value
     2822       :
     2823         delete buf_temp-browse-handle .
     2824       end.
     2825     end.
     2826   end procedure.
     2827   procedure diasize_add_browse :
     2828     define input  parameter p-browse-type   as character no-undo .
     2829     define input  parameter p-browse-handle as handle    no-undo .
     2830     define buffer buf_temp-browse-handle for temp-browse-handle .
     2831     do
     2832     on error undo, return error return-value
     2833     :
     2834       assign
     2835         v-diasize-browse-number = v-diasize-browse-number + 1
     2836       .
     2837       create buf_temp-browse-handle .
     2838       assign
     2839         buf_temp-browse-handle.browse-type   = p-browse-type
     2840         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2841         buf_temp-browse-handle.browse-handle = p-browse-handle
     2842       .
     2843     end.
     2844   end procedure.
     2845   procedure diasize_init :
     2846     define variable v-default-value    as logical   no-undo .
     2847     define variable v-restore-saved    as logical   no-undo .
     2848     define variable v-resize-value-str as character no-undo .
     2849     do
     2850     on error undo, return error return-value
     2851     :
     2852       do with frame Dialog-Frame
     2853       :
     2854         assign
     2855           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2856           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2857           v-diasize-browse-handle     = browse BR-c-tax-hist :handle
     2858         .
     2859         create button v-diasize-resize-button
     2860         assign
     2861           parent        = frame Dialog-Frame :first-child
     2862           label         = "s"
     2863           height-pixels = 16
     2864           width-pixels  = 16
     2865           visible       = true
     2866           sensitive     = true
     2867           movable       = true
     2868           triggers:
     2869             on end-move persistent run diasize_end-move in this-procedure .
     2870           end triggers.
     2871         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2872         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2873         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2874         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2875         assign
     2876           v-diasize-wndmax = false
     2877         .
     2878         if connected("ub") = true
     2879         then do:
     2880           define variable v-cntxt-db-num        as integer   no-undo .
     2881           define variable v-cntxt-userid        as character no-undo .
     2882           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2883                                             , OUTPUT v-cntxt-userid
     2884                                             ) .
     2885           run gbl/wndpar_r.p
     2886             (input  v-cntxt-db-num
     2887             ,input  v-cntxt-userid
     2888             ,input  'wndmax':U
     2889             ,output v-diasize-wndmax
     2890             ,output v-default-value
     2891             ) .
     2892         end.
     2893         assign
     2894           v-diasize-wndstore = false
     2895         .
     2896         if connected("ub") = true
     2897         then do:
     2898           run gbl/wndpar_r.p
     2899             (input  v-cntxt-db-num
     2900             ,input  v-cntxt-userid
     2901             ,input  'wndstore':U
     2902             ,output v-diasize-wndstore
     2903             ,output v-default-value
     2904             ) .
     2905         end.
     2906         assign
     2907           v-diasize-proc-name = entry(1, program-name(2), '.')
     2908         .
     2909         if v-diasize-wndstore = true
     2910         then do:
     2911           assign
     2912             v-restore-saved = false
     2913           .
     2914           if connected("ub") = true
     2915           then do:
     2916             run gbl/wndsizer.p
     2917               (input  v-cntxt-db-num
     2918               ,input  v-cntxt-userid
     2919               ,input  v-diasize-proc-name
     2920               ,input  'height':u
     2921               ,output v-resize-value-str
     2922               ) .
     2923             if v-resize-value-str <> '':U
     2924             then do:
     2925               run diasize_change-height in this-procedure
     2926                 (input  integer(v-resize-value-str)
     2927                 ,input  true
     2928                 ) .
     2929               assign
     2930                 v-restore-saved = true
     2931               .
     2932             end.
     2933           end.
     2934           if connected("ub") = true
     2935           then do:
     2936             run gbl/wndsizer.p
     2937               (input  v-cntxt-db-num
     2938               ,input  v-cntxt-userid
     2939               ,input  v-diasize-proc-name
     2940               ,input  'width':u
     2941               ,output v-resize-value-str
     2942               ) .
     2943             if v-resize-value-str <> '':U
     2944             then do:
     2945               run diasize_change-width in this-procedure
     2946                 (input  integer(v-resize-value-str)
     2947                 ,input  true
     2948                 ) .
     2949               assign
     2950                 v-restore-saved = true
     2951               .
     2952             end.
     2953           end.
     2954           if v-restore-saved <> true
     2955           then do:
     2956             if v-diasize-wndmax = true
     2957             then do:
     2958               run diasize_maximize in this-procedure
     2959                 (input  true
     2960                 ) .
     2961             end.
     2962           end.
     2963         end.
     2964         else do:
     2965           if v-diasize-wndmax = true
     2966           then do:
     2967             run diasize_maximize in this-procedure
     2968               (input  true
     2969               ) .
     2970           end.
     2971         end.
     2972       end.
     2973     end.
     2974   end procedure.
     2975   procedure diasize_need-full-display :
     2976     define output parameter p-need-full-display as logical   no-undo .
     2977     do
     2978     on error undo, return error return-value
     2979     :
     2980       assign
     2981         p-need-full-display = v-diasize-need-full-display
     2982       .
     2983       assign
     2984         v-diasize-need-full-display = false
     2985       .
     2986     end.
     2987   end procedure.
     2988   procedure get-context :
     2989      define output parameter p-db-num as integer          no-undo.
     2990      define output parameter p-user-id as character        no-undo.
     2991      define variable v-login               as character    no-undo.
     2992      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2993      define buffer buf_user-login  for ub.user-login .
     2994      do
     2995      on error undo, return error
     2996      :
     2997            FIND FIRST buf_sys-ctrl no-lock.
     2998            ASSIGN
     2999               v-login = USERID("ub")
     3000               p-db-num = buf_sys-ctrl.db-num
     3001            .
     3002            FIND FIRST buf_user-login
     3003                 WHERE buf_user-login.db-num = p-db-num
     3004                   AND buf_user-login.user-login = v-login
     3005                 no-lock
     3006                 no-error
     3007                 .
     3008            IF AVAILABLE buf_user-login
     3009            THEN DO:
     3010               assign
     3011                  p-user-id = buf_user-login.user-id
     3012               .
     3013            END.
     3014      end.
     3015   end procedure.
     3016   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3017   on f5 of frame Dialog-Frame anywhere
     3018   do:
     3019     v-doc-rec = recid(X_c-tax-hist). run OpenBr in this-procedure ( input yes, input no, input '':U). reposition br-c-tax-hist to recid v-doc-rec no-error.
     3020       apply "VALUE-CHANGED" to BR-c-tax-hist.
     3021   end.
     3022   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3023   do:
     3024     BR-c-tax-hist :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3025   end.
     3026   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3027   procedure set-filter-name :
     3028   define input parameter p-filter-name as character no-undo .
     3029     do with frame Dialog-Frame:
     3030       if p-filter-name > "" then do:
     3031         assign
     3032           frame Dialog-Frame:title
     3033             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3034         .
     3035         assign
     3036           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3037         .
     3038       end.
     3039       else do:
     3040         assign
     3041           b-sch :tooltip = ""
     3042         .
     3043       end.
     3044     end.
     3045   end procedure.
     3046   MAIN-BLOCK:
     3047   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3048      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3049     CASE parref-mode:
     3050      WHEN 'все':U        THEN DO:
     3051      END.
     3052      WHEN "tax":U THEN DO:
     3053        find first X_tax no-lock where
     3054                   X_tax.tax-code = p-tax-code
     3055               no-error .
     3056        if not available X_tax then do:
     3057           message
     3058           vss-workfile vss-revision vss-description skip
     3059           "Неверное значение параметра p-tax-code" p-tax-code
     3060           view-as alert-box ERROR.
     3061           return.
     3062        end.
     3063      END.
     3064      WHEN "tax-rate":U
     3065      or when "tax-rate-value"
     3066      THEN DO:
     3067        find first X_tax-rate no-lock where
     3068                   X_tax-rate.tax-code = p-tax-code
     3069                AND X_tax-rate.rate-code = p-rate-code
     3070               no-error .
     3071        if not available X_tax-rate then do:
     3072           message
     3073           vss-workfile vss-revision vss-description skip
     3074           "Неверное значение параметров p-tax-code и/или p-rate-code" p-tax-code p-rate-code
     3075           view-as alert-box ERROR.
     3076           return.
     3077        end.
     3078      END.
     3079      otherwise do:
     3080         message vss-workfile vss-revision vss-description skip
     3081         "Неверный вызов - parref-mode=" parref-mode
     3082         view-as alert-box ERROR.
     3083         return.
     3084       end.
     3085     end case.
     3086     v-rid-list = p-rid-list.
     3087     RUN MyEnable.
     3088     HIDE mark-num in frame Dialog-Frame .
     3089     run diasize_add_browse in this-procedure
     3090       (input  'width':u
     3091       ,input  browse br-changes :handle
     3092       ) .
     3093     run diasize_init in this-procedure .
     3094     run OpenBR in this-procedure ( input yes, input no, input '':U).
     3095     WAIT-FOR GO OF FRAME Dialog-Frame.
     3096   END.
     3097   RUN disable_UI.
     3098   PROCEDURE disable_UI :
     3099     HIDE FRAME Dialog-Frame.
     3100   END PROCEDURE.
     3101   PROCEDURE enable_UI :
     3102     DISPLAY mark-num
     3103         WITH FRAME Dialog-Frame.
     3104     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num BR-c-tax-hist BR-changes
     3105         WITH FRAME Dialog-Frame.
     3106     VIEW FRAME Dialog-Frame.
     3107   END PROCEDURE.
     3108   PROCEDURE MyEnable :
     3109   br-changes:title in frame Dialog-Frame  = "":U.
     3110   assign
     3111   temp-changes.l_name:resizable in browse br-changes = true
     3112   temp-changes.v_old:resizable in browse br-changes = true
     3113   temp-changes.v_new:resizable in browse br-changes = true
     3114   temp-changes.l_name:width in browse br-changes = 30
     3115   temp-changes.v_old:width in browse br-changes = 40
     3116   temp-changes.v_new:width in browse br-changes = 40
     3117   .
     3118   DISPLAY
     3119   mark-num
     3120   br-changes
     3121   WITH FRAME Dialog-Frame.
     3122   ENABLE
     3123   B-quit
     3124   B-mark when lookup('b-mark':U, bttns) >0
     3125   B-sel when lookup('b-sel':U, bttns) >0
     3126   B-sch
     3127   B-Help
     3128   BR-c-tax-hist
     3129   br-changes
     3130   mark-num
     3131   WITH FRAME Dialog-Frame.
     3132   VIEW FRAME Dialog-Frame.
     3133   END PROCEDURE.
     3134   PROCEDURE OpenBr :
     3135   define input  parameter p-open-query     as logical   no-undo .
     3136   define input  parameter p-find-next      as logical   no-undo .
     3137   define input  parameter p-find-condition as character no-undo .
     3138   define variable l-query-was-opened as logical no-undo .
     3139   run waitfram-show in this-procedure ("Ждите...").
     3140   define variable sort-column-phrase as character no-undo .
     3141   case sort-column-name :
     3142     when "" then do:
     3143       assign
     3144         sort-column-phrase = ""
     3145       .
     3146     end.
     3147     otherwise do:
     3148       assign
     3149         sort-column-phrase = "by " + sort-column-name
     3150       .
     3151     end.
     3152   end case.
     3153   CASE parref-mode:
     3154       when 'все':U then do:
     3155           ASSIGN frame Dialog-Frame:TITLE = "Справочник истории категорий и ставок налогов"
     3156           filter-point = filter-point0 + parref-mode
     3157           filter-label = substitute("&1", filter-label0)
     3158           .
     3159   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3160   define variable  l-disable-where-23  as logical   no-undo .
     3161   define variable  l-filter-open-23    as logical   .
     3162   define variable  flt-rec-23       as recid     no-undo .
     3163   define variable  filter-name-23      as character no-undo .
     3164   define variable  where-phrase-23     as character no-undo .
     3165   define variable  sort-phrase-23      as character no-undo .
     3166   define variable  where-phrase-rus-23 as character no-undo .
     3167   define variable  sort-phrase-rus-23  as character no-undo .
     3168     run waitfram-show in this-procedure
     3169       (input "ЖДИТЕ ..."
     3170       ).
     3171   run gbl/flt-get.p
     3172     (input filter-point
     3173     ,output flt-rec-23
     3174     ,output filter-name-23
     3175     ,output where-phrase-23
     3176     ,output sort-phrase-23
     3177     ,output where-phrase-rus-23
     3178     ,output sort-phrase-rus-23
     3179     ).
     3180       run set-filter-name in this-procedure
     3181         (INPUT filter-name-23
     3182         ) no-error .
     3183     assign
     3184       l-filter-open-23 = false
     3185     .
     3186     if flt-rec-23 <> ?
     3187       or sort-column-phrase > ""
     3188     then do:
     3189       define variable  parameter-2-23 as character no-undo .
     3190       define variable  parameter-3-23 as character no-undo .
     3191       define variable  parameter-4-23 as character no-undo .
     3192       define variable  parameter-5-23 as character no-undo .
     3193       define variable  parameter-6-23 as character no-undo .
     3194       define variable  parameter-7-23 as character no-undo .
     3195         assign
     3196         parameter-3-23 =
     3197                                 "FOR EACH X_c-tax-hist"
     3198         parameter-4-23 =
     3199           (
     3200             if (" TRUE " + " " + where-phrase-23) <> ""
     3201             then " TRUE " + " " + where-phrase-23
     3202             else "true"
     3203           )
     3204         parameter-5-23 = (" " + "" + " " + "")
     3205         parameter-6-23 = if sort-phrase-23 = ''
     3206                              then
     3207           (
     3208           " " + "  " +
     3209             " " + sort-column-phrase +
     3210           " " + "  "
     3211           )
     3212                              else
     3213           (
     3214           " " + "  " +
     3215             " " + sort-column-phrase +
     3216           " " + sort-phrase-23
     3217           )
     3218         parameter-7-23 =
     3219           "   "
     3220       .
     3221       do
     3222       on stop undo, leave
     3223       on error undo, leave
     3224       :
     3225         assign
     3226           l-disable-where-23 =
     3227             (" TRUE " + " " + where-phrase-23 = "")
     3228         .
     3229         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3230                             ,input query br-c-tax-hist:handle
     3231                             ,input parameter-3-23
     3232                             ,input parameter-4-23
     3233                             ,input parameter-5-23
     3234                             ,input parameter-6-23
     3235                             ,input parameter-7-23
     3236                             )
     3237         .
     3238         assign
     3239           l-filter-open-23 = true
     3240         .
     3241       end.
     3242       if l-filter-open-23 = false then do:
     3243         message
     3244           "Ошибка при фильтрации / сортировке" skip
     3245           "Будут показаны записи без учета фильтра" skip
     3246           view-as alert-box .
     3247       end.
     3248       else do:
     3249           assign
     3250             l-query-was-opened = true
     3251           .
     3252       end.
     3253     end.
     3254     if l-filter-open-23 = false then do:
     3255       OPEN QUERY br-c-tax-hist FOR EACH X_c-tax-hist
     3256         where  TRUE
     3257     .
     3258         assign
     3259           l-query-was-opened = true
     3260         .
     3261     end.
     3262     run waitfram-hide in this-procedure .
     3263       end.
     3264       when "tax":U then do:
     3265           ASSIGN frame Dialog-Frame:TITLE = substitute("Справочник истории категорий и ставок налогов: код налога &1",
     3266                                                          p-tax-code)
     3267           filter-point = filter-point0 + parref-mode
     3268           filter-label = substitute("&1 Один налог", filter-label0)
     3269           .
     3270   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3271   define variable  l-disable-where-25  as logical   no-undo .
     3272   define variable  l-filter-open-25    as logical   .
     3273   define variable  flt-rec-25       as recid     no-undo .
     3274   define variable  filter-name-25      as character no-undo .
     3275   define variable  where-phrase-25     as character no-undo .
     3276   define variable  sort-phrase-25      as character no-undo .
     3277   define variable  where-phrase-rus-25 as character no-undo .
     3278   define variable  sort-phrase-rus-25  as character no-undo .
     3279     run waitfram-show in this-procedure
     3280       (input "ЖДИТЕ ..."
     3281       ).
     3282   run gbl/flt-get.p
     3283     (input filter-point
     3284     ,output flt-rec-25
     3285     ,output filter-name-25
     3286     ,output where-phrase-25
     3287     ,output sort-phrase-25
     3288     ,output where-phrase-rus-25
     3289     ,output sort-phrase-rus-25
     3290     ).
     3291       run set-filter-name in this-procedure
     3292         (INPUT filter-name-25
     3293         ) no-error .
     3294     assign
     3295       l-filter-open-25 = false
     3296     .
     3297     if flt-rec-25 <> ?
