     1079   end function.
     1080   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1081   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1082   procedure fltopend_fltopend :
     1083   define input parameter p-parent-handle as handle no-undo .
     1084   define input parameter p-qh as handle no-undo .
     1085   define input parameter p-flt-open-open-query  as character no-undo .
     1086   define input parameter p-where-cond as character no-undo .
     1087   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1088   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1089   define input parameter p-indexed-reposition as character no-undo .
     1090     do
     1091     on error undo, return error
     1092     :
     1093   define variable v-prepare-string as character no-undo .
     1094   define variable glog as logical no-undo .
     1095   assign
     1096   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1097                      p-where-cond + chr(32)  +
     1098                      p-use-indFIRST-query-tail + chr(32) +
     1099                      p-use-ind-sort-clmn-by + chr(32) +
     1100                      p-indexed-reposition
     1101   .
     1102   assign
     1103   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1104   if not glog
     1105   or error-status:error then do:
     1106     message error-status:get-message(1) view-as alert-box .
     1107     undo, return error .
     1108   end.
     1109   assign
     1110   glog = p-qh:query-open no-error .
     1111   if not glog
     1112   or error-status:error then do:
     1113     message error-status:get-message(1) view-as alert-box .
     1114     undo, return error .
     1115   end.
     1116     end.
     1117   end procedure.
     1118   procedure fltopend_fltfindd :
     1119   define input parameter p-parent-handle as handle no-undo .
     1120   define input parameter p-qh as handle no-undo .
     1121   define input parameter p-rowid as rowid no-undo .
     1122   define input parameter p-next as logical no-undo .
     1123   define input parameter p-lock as integer no-undo .
     1124   define input parameter p-bh as handle no-undo .
     1125   define input parameter p-where-cond as character no-undo .
     1126   define input parameter p-use-index-phrase as character no-undo .
     1127   define variable glog as logical no-undo .
     1128   define variable v-qh as handle no-undo .
     1129   define variable v-bh as handle no-undo .
     1130   define variable v-recid as recid no-undo .
     1131   define variable v-prepare-string as character no-undo .
     1132   do
     1133   on error undo, return error
     1134   on stop undo, return error
     1135   :
     1136     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1137     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1138     create query v-qh.
     1139     v-qh:set-buffers(v-bh).
     1140     v-prepare-string = substitute("for each &1 &2 &3"
     1141                                     ,v-bh:name
     1142                                     ,p-where-cond
     1143                                     ,p-use-index-phrase).
     1144     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1145     if not glog then do:
     1146       delete object v-qh.
     1147       delete object v-bh.
     1148       undo, return error .
     1149     end.
     1150     glog = v-qh:query-open no-error .
     1151     if not glog then do:
     1152       delete object v-qh.
     1153       delete object v-bh.
     1154       undo, return error .
     1155     end.
     1156     if p-next then do:
     1157       v-qh:reposition-to-rowid(p-rowid) no-error .
     1158       glog = v-qh:get-next( p-lock) no-error .
     1159       glog = v-qh:get-next( p-lock) no-error .
     1160       if not glog or v-qh:query-off-end = yes then do:
     1161         glog = v-qh:get-first( p-lock) no-error .
     1162       end.
     1163     end.
     1164     else do:
     1165       glog = v-qh:get-first( p-lock) no-error .
     1166     end.
     1167     v-recid = v-bh:recid no-error .
     1168     delete object v-qh.
     1169     delete object v-bh.
     1170     return string(v-recid) .
     1171   end.
     1172   end procedure.
     1173   procedure fltopend_fltfindq :
     1174   define input parameter p-parent-handle as handle no-undo .
     1175   define input parameter p-qh as handle no-undo .
     1176   define input parameter p-next as logical no-undo .
     1177   define input parameter p-lock as integer no-undo .
     1178   define input parameter p-flt-open-open-query  as character no-undo .
     1179   define input parameter p-where-cond as character no-undo .
     1180   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1181   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1182   define input parameter p-indexed-reposition as character no-undo .
     1183   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1184   define variable glog as logical no-undo .
     1185   define variable v-qh as handle no-undo .
     1186   define variable v-bh as handle no-undo extent 18.
     1187   define variable v-rowid as rowid no-undo extent 18.
     1188   define variable v-ii as integer no-undo .
     1189   define variable v-prepare-string as character no-undo .
     1190   do
     1191   on error undo, return error
     1192   on stop undo, return error
     1193   :
     1194     create query v-qh.
     1195     do v-ii = 1 to p-qh:num-buffers:
     1196       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1197       assign
     1198       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1199       no-error.
     1200       v-qh:add-buffer(v-bh[v-ii]).
     1201     end.
     1202     assign
     1203     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1204                       p-where-cond + chr(32)  +
     1205                       p-use-indFIRST-query-tail + chr(32) +
     1206                       p-use-ind-sort-clmn-by + chr(32) +
     1207                       p-indexed-reposition
     1208     .
     1209     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1210     if not glog then do:
     1211       delete object v-qh.
     1212       do v-ii = 1 to p-qh:num-buffers:
     1213         delete object v-bh[v-ii].
     1214       end.
     1215       undo, return error .
     1216     end.
     1217     glog = v-qh:query-open no-error .
     1218     if not glog then do:
     1219       delete object v-qh.
     1220       do v-ii = 1 to p-qh:num-buffers:
     1221         delete object v-bh[v-ii].
     1222       end.
     1223       undo, return error .
     1224     end.
     1225     if p-next then do:
     1226       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1227       glog = v-qh:get-next( p-lock) no-error .
     1228       glog = v-qh:get-next( p-lock) no-error .
     1229       if not glog or v-qh:query-off-end = yes then do:
     1230         glog = v-qh:get-first( p-lock) no-error .
     1231       end.
     1232     end.
     1233     else do:
     1234       glog = v-qh:get-first( p-lock) no-error .
     1235     end.
     1236     do v-ii = 1 to p-qh:num-buffers:
     1237       assign
     1238       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1239       no-error.
     1240     end.
     1241     delete object v-qh.
     1242     do v-ii = 1 to p-qh:num-buffers:
     1243       delete object v-bh[v-ii].
     1244     end.
     1245   end.
     1246   end procedure.
     1247   define variable v-rid-list as character no-undo .
     1248   define variable log-res as log no-undo.
     1249   define variable rr as recid no-undo.
     1250   define variable jj as integer no-undo .
     1251   define variable str as char no-undo.
     1252   define variable conf-par as char no-undo.
     1253   define variable par-type as char no-undo.
     1254   define variable vartbl-name as char no-undo.
     1255   define variable varact      as char no-undo.
     1256   define variable filter-point0 as character no-undo init "ctaxhist":U .
     1257   define variable filter-point as character no-undo init "ctaxhist":U .
     1258   define variable filter-label0 as character no-undo init "Справочник истории налогов и ставок":U .
     1259   define variable filter-label as character no-undo init "Справочник истории налогов и ставок":U .
     1260   define variable sort-column-name as character no-undo .
     1261   define variable v-doc-rec as recid no-undo .
     1262   define buffer X_tax for ub.tax.
     1263   define buffer X_tax-rate for ub.tax-rate.
     1264   define buffer X_tax-rate-value for ub.tax-rate-value.
     1265   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   define NEW SHARED temp-table temp-changes no-undo
     1267   field f_name as character
     1268   field l_name as character
     1269   field v_old as character
     1270   field v_new as character
     1271   field t_name as character
     1272   field num_ as integer
     1273   field uniq-key-rec as character
     1274   field action as integer
     1275   field fNotChange as logical
     1276   index pi is unique primary
     1277   num_
     1278   t_name
     1279   f_name
     1280   index
     1281   Chan
     1282   fnotChange
     1283   t_name
     1284   f_name
     1285   index imain uniq-key-rec
     1286   .
     1287   FUNCTION get-all-fields returns character (p-file-name as character ):
     1288   define variable v-dop as character no-undo .
     1289     find first _file no-lock where _file._file-name = p-file-name no-error .
     1290     if not available _file then return "":U.
     1291     for each _field no-lock where
     1292              _field._file-recid = recid(_file) :
     1293       assign
     1294       v-dop = v-dop + _field._field-name + chr(44)
     1295       .
     1296     end.
     1297     return trim(v-dop).
     1298   END FUNCTION.
     1299   PROCEDURE proc-full-temp-changes :
     1300     define input  parameter p-hst-handle as handle    no-undo .
     1301     define input  parameter p-main-table as character no-undo .
     1302     define input  parameter p-field-list as character no-undo .
     1303     define input  parameter p-label-form as character no-undo .
     1304     define variable h-new-buf         as handle    no-undo .
     1305     define variable h-main-buf        as handle    no-undo .
     1306     define variable h-for-comp        as handle    no-undo .
     1307     define variable v-inform          as character no-undo .
     1308     define variable v-ind             as integer   no-undo .
     1309     define variable v-idx-field-qnty  as integer   no-undo .
     1310     define variable v-num-entries     as integer   no-undo .
     1311     define variable fh                as handle    no-undo .
     1312     define variable fh-main           as handle    no-undo .
     1313     define variable fh-old            as handle    no-undo .
     1314     define variable fh-new            as handle    no-undo .
     1315     define variable v-field-name      as character no-undo .
     1316     define variable v-field-lvl       as character no-undo .
     1317     define variable v-field-form      as character no-undo .
     1318     define variable v-search-exp      as character no-undo .
     1319     define variable v-srch-main       as character no-undo .
     1320     define variable v-word-link       as character no-undo .
     1321     define variable v-av-chip-num     as logical   no-undo .
     1322     define variable v-main-pi-fld-lst as character no-undo .
     1323     define variable v-main-fld-lst    as character no-undo .
     1324     define variable v-delim-list      as character no-undo .
     1325     define variable v-label           as character no-undo .
     1326     define variable v-old-value       as character no-undo case-sensitive.
     1327     define variable v-new-value       as character no-undo case-sensitive.
     1328     define variable v-chg-fields as character no-undo.
     1329     for each temp-changes:
     1330       delete temp-changes.
     1331     end.
     1332     if not p-hst-handle:available then do:
     1333       return .
     1334     end.
     1335     create buffer h-new-buf  for table p-hst-handle .
     1336     create buffer h-main-buf for table p-main-table .
     1337     assign
     1338       v-inform = h-main-buf:index-information(1)
     1339       v-ind    = 2
     1340     .
     1341     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1342     on error undo, return error
     1343     :
     1344       assign
     1345         v-inform = h-main-buf:index-information( v-ind )
     1346         v-ind    = v-ind + 1
     1347       .
     1348     end.
     1349     if v-inform = ?
     1350       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1351       or entry( 3, v-inform, ",":U ) <> "1":U
     1352     then do:
     1353       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1354     end.
     1355     assign
     1356       v-idx-field-qnty = num-entries( v-inform ) - 4
     1357     .
     1358     if v-idx-field-qnty < 2 then do:
     1359       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1360     end.
     1361     assign
     1362       v-srch-main   = "where":U
     1363       v-word-link   = "":U
     1364       v-av-chip-num = false
     1365       v-delim-list  = "":U
     1366     .
     1367     do v-ind = 1 to v-idx-field-qnty by 2
     1368     on error undo, return error
     1369     :
     1370       assign
     1371         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1372         fh                = p-hst-handle:buffer-field( v-field-name )
     1373         fh-main           = h-main-buf:buffer-field( v-field-name )
     1374         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1375         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1376       .
     1377       if fh:data-type ="character":U then do:
     1378         assign
     1379           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1380         .
     1381       end.
     1382       else do:
     1383         assign
     1384           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1385         .
     1386       end.
     1387       if v-delim-list = "":U then do:
     1388         assign
     1389           v-delim-list = ",":U
     1390         .
     1391       end.
     1392       if v-word-link = "":U then do:
     1393         assign
     1394           v-word-link = "and":U
     1395         .
     1396       end.
     1397     end.
     1398     assign
     1399       v-delim-list  = "":U
     1400     .
     1401     do v-ind = 1 to h-main-buf:num-fields
     1402     on error undo, return error
     1403     :
     1404       assign
     1405         fh-main      = h-main-buf:buffer-field( v-ind )
     1406         v-field-name = fh-main:name
     1407       .
     1408         assign
     1409           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1410         .
     1411         if v-delim-list = "":U then do:
     1412           assign
     1413             v-delim-list = ",":U
     1414           .
     1415         end.
     1416     end.
     1417     assign
     1418       v-inform = p-hst-handle:index-information(1)
     1419       v-ind    = 2
     1420     .
     1421     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1422     on error undo, return error
     1423     :
     1424       assign
     1425         v-inform = p-hst-handle:index-information( v-ind )
     1426         v-ind    = v-ind + 1
     1427       .
     1428     end.
     1429     if v-inform = ?
     1430       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1431       or entry( 3, v-inform, ",":U ) <> "1":U
     1432     then do:
     1433       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1434     end.
     1435     assign
     1436       v-idx-field-qnty = num-entries( v-inform ) - 4
     1437     .
     1438     if v-idx-field-qnty < 2 then do:
     1439       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1440     end.
     1441     assign
     1442       v-search-exp  = "where":U
     1443       v-word-link   = "":U
     1444       v-av-chip-num = false
     1445     .
     1446     do v-ind = 1 to v-idx-field-qnty by 2
     1447     on error undo, return error
     1448     :
     1449       assign
     1450         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1451         fh           = p-hst-handle:buffer-field( v-field-name )
     1452         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1453       .
     1454       if v-field-name = "chip-num":U then do:
     1455         assign
     1456           v-search-exp  = substitute( "&1 >", v-search-exp )
     1457           v-av-chip-num = true
     1458         .
     1459       end.
     1460       else do:
     1461         assign
     1462           v-search-exp = substitute( "&1 =", v-search-exp )
     1463         .
     1464       end.
     1465       if fh:data-type ="character":U then do:
     1466         assign
     1467           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1468         .
     1469       end.
     1470       else do:
     1471         assign
     1472           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1473         .
     1474       end.
     1475       if v-word-link = "":U then do:
     1476         assign
     1477           v-word-link = "and":U
     1478         .
     1479       end.
     1480     end.
     1481     if v-av-chip-num = false then do:
     1482       message
     1483         vss-workfile vss-revision vss-description skip
     1484         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1485         "Использование данной процедуры невозможно!" skip
     1486         view-as alert-box error .
     1487       return error .
     1488     end.
     1489     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1490     if not h-new-buf:available then do:
     1491       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1492       if not h-main-buf:available then do:
     1493         assign
     1494           h-for-comp = ?
     1495         .
     1496       end.
     1497       else do:
     1498         assign
     1499           h-for-comp = h-main-buf
     1500         .
     1501       end.
     1502     end.
     1503     else do:
     1504       assign
     1505         h-for-comp = h-new-buf
     1506       .
     1507     end.
     1508     assign
     1509       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1510     .
     1511     do v-ind = 1 to v-num-entries
     1512     on error undo, return error return-value
     1513     :
     1514       assign
     1515         v-field-name = entry( v-ind, v-main-fld-lst )
     1516         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1517         v-old-value  = fh-old:buffer-value()
     1518         v-label      = trim( fh-old:label )
     1519       .
     1520       if ( trim( p-field-list ) <> "":U
     1521            and lookup( v-field-name, p-field-list ) > 0
     1522          )
     1523          or trim( p-field-list ) = "":U
     1524       then do:
     1525         if h-for-comp <> ? then do:
     1526           assign
     1527             fh-new      = h-for-comp:buffer-field( v-field-name )
     1528             v-new-value = fh-new:buffer-value()
     1529           .
     1530         end.
     1531         else do:
     1532           assign
     1533             v-new-value = "":U
     1534           .
     1535         end.
     1536         if v-old-value <> v-new-value
     1537         then do:
     1538           create temp-changes.
     1539           assign
     1540             temp-changes.t_name = p-main-table
     1541             temp-changes.f_name = v-field-name
     1542             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1543             temp-changes.v_old  = trim( v-old-value )
     1544             temp-changes.v_new  = trim( v-new-value )
     1545             temp-changes.num_   = 0
     1546             temp-changes.fNotChange = v-old-value eq v-new-value
     1547           .
     1548         end.
     1549       end.
     1550     end.
     1551     assign
     1552       v-num-entries = num-entries( p-label-form, chr(8) )
     1553     .
     1554     do v-ind = 1 to v-num-entries
     1555     on error undo, return error return-value
     1556     :
     1557       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1558         assign
     1559           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1560           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1561           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1562         .
     1563         find first temp-changes
     1564           where temp-changes.f_name = v-field-name
     1565           no-error .
     1566         if available temp-changes then do:
     1567           if trim( v-field-lvl ) <> "":U then do:
     1568             assign
     1569               temp-changes.l_name = v-field-lvl
     1570             .
     1571           end.
     1572           if trim( v-field-form ) <> "":U then do:
     1573             assign
     1574               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1575             .
     1576             if h-for-comp <> ? then do:
     1577               assign
     1578                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1579               .
     1580             end.
     1581           end.
     1582         end.
     1583       end.
     1584       else do:
     1585         message
     1586           vss-workfile vss-revision vss-description skip
     1587           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1588           substitute( "список для поля '&1': '&2'"
     1589                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1590                       ,entry( v-ind, p-label-form, chr(8) )
     1591                     ) skip
     1592           substitute( "полный список: &2", p-label-form ) skip
     1593           view-as alert-box error .
     1594       end.
     1595     end.
     1596     delete object h-new-buf .
     1597     delete object h-main-buf .
     1598   END PROCEDURE.
     1599   FUNCTION get-action RETURNS CHARACTER
     1600     (  p-action as integer )  FORWARD.
     1601   FUNCTION get-fact-date-str RETURNS CHARACTER
     1602     ( INPUT p-fact-order AS DECIMAL )  FORWARD.
     1603   DEFINE BUTTON B-Help
     1604        LABEL "Помо&щь"
     1605        SIZE 3 BY 1
     1606        BGCOLOR 8 .
     1607   DEFINE BUTTON B-mark
     1608        LABEL "&*"
     1609        SIZE 3 BY 1.
     1610   DEFINE BUTTON b-quit AUTO-END-KEY
     1611        LABEL "&Выход"
     1612        SIZE 10 BY 1
     1613        BGCOLOR 8 .
     1614   DEFINE BUTTON B-sch
     1615        LABEL "&Фильтр"
     1616        SIZE 3 BY 1.
     1617   DEFINE BUTTON b-sel AUTO-GO
     1618        LABEL "Вы&бор"
     1619        SIZE 10 BY 1.
     1620   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1621        VIEW-AS FILL-IN
     1622        SIZE 9 BY 1
     1623        FGCOLOR 4  NO-UNDO.
     1624   DEFINE QUERY BR-c-tax-hist FOR
     1625         X_c-tax-hist SCROLLING.
     1626   DEFINE QUERY BR-changes FOR
     1627         temp-changes SCROLLING.
     1628   DEFINE BROWSE BR-c-tax-hist
     1629     QUERY BR-c-tax-hist DISPLAY
     1630         mark-string( recid(X_c-tax-hist), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1631         X_c-tax-hist.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
     1632         usrfulnf(X_c-tax-hist.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1633         X_c-tax-hist.corr-user-db-num COLUMN-LABEL "БД" FORMAT ">>>>9":U
     1634               WIDTH 6
     1635         entry (lookup (X_c-tax-hist.subject, 'tax,tax-rate,tax-rate-value,tax-units':U), 'Налог,Ставка налога,Знач.ставки налога,Налоги на тип ед.изм.':U) COLUMN-LABEL "Предмет изменений" FORMAT "X(12)":U
     1636         X_c-tax-hist.tax-code COLUMN-LABEL "Код!налога" FORMAT "9":U
     1637               WIDTH 7
     1638         get-action(X_c-tax-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1639         string(X_c-tax-hist.corr-time, "HH:MM") COLUMN-LABEL "Время!корр" FORMAT "X(5)":U
     1640               WIDTH 6
     1641         if X_c-tax-hist.subject = 'tax-rate':U or X_c-tax-hist.subject = 'tax-rate-value':U then string(X_c-tax-hist.rate-code) else '':U COLUMN-LABEL "Код!ставки" FORMAT "X(3)":U
     1642               WIDTH 7
     1643         if X_c-tax-hist.subject = 'tax-rate-value':U and X_c-tax-hist.host-code > 0 then string(X_c-tax-hist.host-code) else '':U COLUMN-LABEL "Фирма" FORMAT "X(5)":U
     1644               WIDTH 6
     1645         if X_c-tax-hist.subject = 'tax-rate-value':U and X_c-tax-hist.obj-code > 0 then
     1646   (X_c-tax-hist.obj-type + string(X_c-tax-hist.obj-code)) else '':U COLUMN-LABEL "Объект" FORMAT "X(9)":U
     1647               WIDTH 10
     1648         if X_c-tax-hist.subject = 'tax-rate-value':U then
     1649   get-fact-date-str(X_c-tax-hist.fact-order) else '':U COLUMN-LABEL "Дата факт" FORMAT "X(10)":U
     1650               WIDTH 11
     1651         if X_c-tax-hist.subject = 'tax-rate-value':U then string(X_c-tax-hist.status_) else '':U COLUMN-LABEL "Статус" FORMAT "X(10)":U
     1652               WIDTH 11
     1653       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.33.
     1654   DEFINE BROWSE BR-changes
     1655     QUERY BR-changes DISPLAY
     1656         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1657   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1658   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1659       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1660   DEFINE FRAME Dialog-Frame
     1661        b-quit AT ROW 1 COL 1
     1662        B-mark AT ROW 1 COL 11
     1663        b-sel AT ROW 1 COL 14
     1664        B-sch AT ROW 1 COL 92
     1665        B-Help AT ROW 1 COL 95
     1666        mark-num AT ROW 1.93 COL 9 COLON-ALIGNED NO-LABEL
     1667        BR-c-tax-hist AT ROW 3.43 COL 1
     1668        BR-changes AT ROW 16.03 COL 1
     1669        SPACE(0.24) SKIP(0.01)
     1670       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1671            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1672            TITLE "Справочник истории налогов и ставок"
     1673            CANCEL-BUTTON b-quit.
     1674   ASSIGN
     1675          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1676          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1677   ON GO OF FRAME Dialog-Frame
     1678   DO:
     1679     p-rid-list = v-rid-list.
     1680   END.
     1681   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1682   DO:
     1683     APPLY "END-ERROR":U TO SELF.
     1684   END.
     1685   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1686   DO:
     1687   define variable g#log as logical no-undo .
     1688    if not available X_c-tax-hist then return no-apply.
     1689   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1690   define variable v-str-recid15 as character no-undo .
     1691   define variable v-num-entry15 as integer   no-undo .
     1692   assign
     1693     v-str-recid15 = trim( string( recid( X_c-tax-hist ) , "->>>>>>>>>>>9":U ) )
     1694     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1695   .
     1696   if v-num-entry15 > 0 then do:
     1697     assign
     1698       entry( v-num-entry15, v-rid-list ) = "":U
     1699       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1700     .
     1701   end.
     1702   else do:
     1703     assign
     1704       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1705     .
     1706   end.
     1707    g#log = br-c-tax-hist :refresh( )  in frame Dialog-Frame.
     1708     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1709             g#log = br-c-tax-hist:select-next-row () in frame Dialog-Frame.
     1710             apply "value-changed" to br-c-tax-hist in frame Dialog-Frame.
     1711     end.
     1712     if num-entries (v-rid-list) = 0 then
     1713         hide mark-num in frame Dialog-Frame.
     1714     else
     1715     disp num-entries (v-rid-list) @ mark-num
     1716     with frame Dialog-Frame.
     1717     apply "entry" to br-c-tax-hist in frame Dialog-Frame.
     1718   END.
     1719   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1720   DO:
     1721     run proc-b-sch in this-procedure no-error.
     1722     if error-status:error then return no-apply.
     1723   END.
     1724   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1725   DO:
     1726       if ( available X_c-tax-hist ) AND ( v-rid-list = "" ) then
     1727           v-rid-list = string( recid( X_c-tax-hist ) ) .
     1728   END.
     1729   ON RETURN OF BR-c-tax-hist IN FRAME Dialog-Frame
     1730   DO:
     1731         apply "DEFAULT-ACTION":U to self.
     1732   END.
     1733   ON VALUE-CHANGED OF BR-c-tax-hist IN FRAME Dialog-Frame
     1734   DO:
     1735     run proc-view-changes in this-procedure no-error.
     1736   END.
     1737   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1738   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1739   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1740   on help of frame Dialog-Frame
     1741   do:
     1742     run gbl/app_help.p
     1743       (input this-procedure :file-name
     1744       ,input ''
     1745       ,input ?
     1746       ) no-error.
     1747     if error-status :error then do:
     1748       message
     1749         "Ошибка при вызове помощи"
     1750         error-status :get-message(1)
     1751         view-as alert-box .
     1752     end.
     1753   end.
     1754   run minbtn-set in this-procedure .
     1755   on choose of b-help in frame Dialog-Frame
     1756   do:
     1757     apply "help":u to frame Dialog-Frame .
     1758   end.
     1759   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1760   procedure minbtn-set :
     1761       do
     1762           on error undo, return error return-value
     1763           :
     1764           define variable ii              as integer       no-undo .
     1765           define variable fh              as widget-handle no-undo .
     1766           define variable hh              as widget-handle no-undo .
     1767           define variable v-h             as handle        extent 4 no-undo .
     1768           define variable v-name-button   as character     no-undo .
     1769           define variable v-help-old-x    as decimal       no-undo .
     1770           define variable v-help-old-y    as decimal       no-undo .
     1771           define variable v-help-old-size as decimal       no-undo .
     1772           define variable v-frame-width   as decimal       no-undo .
     1773           define variable jj              as integer       no-undo .
     1774           do
     1775               on error undo, return error
     1776               :
     1777               assign
     1778                   v-frame-width = frame Dialog-Frame:width - 0.3
     1779                   fh            = frame Dialog-Frame:first-child
     1780                   hh            = fh:first-child
     1781                   ii            = 1
     1782                   .
     1783               do while valid-handle(hh):
     1784                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1785                   do:
     1786                       case lc(hh:name) :
     1787                           when "b-help" then
     1788                               do:
     1789                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1790                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1791                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1792                                   hh:TOOLTIP = "Помощь" .
     1793                                   v-help-old-x = hh:column .
     1794                                   v-help-old-y = hh:row    .
     1795                                   v-help-old-size = hh:width .
     1796                                   hh:width-chars = 2.5 .
     1797                               end.
     1798                           when "b-print" then
     1799                               do:
     1800                                   hh:load-image("cmp/b-print.bmp":u) .
     1801                                   hh:TOOLTIP = "Печать" .
     1802                                   v-h[ii] = hh:handle .
     1803                                   ii = ii + 1 .
     1804                                   hh:width-chars = 3 .
     1805                               end.
     1806                           when "b-history" or
     1807                           when "b-hist" then
     1808                               do:
     1809                                   hh:load-image("cmp/b-hist.bmp":u) .
     1810                                   hh:TOOLTIP = "История" .
     1811                                   v-h[ii] = hh:handle .
     1812                                   ii = ii + 1 .
     1813                                   hh:width-chars = 3 .
     1814                               end.
     1815                           when "b-sch" then
     1816                               do:
     1817                                   hh:load-image("cmp/b-sch.bmp":u) .
     1818                                   hh:TOOLTIP = "Установка Фильтра" .
     1819                                   v-h[ii] = hh:handle .
     1820                                   ii = ii + 1 .
     1821                                   hh:width-chars = 3 .
     1822                               end.
     1823                           when "b-hist-user" then
     1824                               do:
     1825                                   hh:load-image("cmp/b-hist.bmp":u) .
     1826                                   hh:TOOLTIP = "История пользователя" .
     1827                                   ii = ii + 1 .
     1828                               end.
     1829                       end case.
     1830                   end.
     1831                   hh = hh:next-sibling.
     1832               end.
     1833               b-help:column = v-frame-width - b-help:width-chars.
     1834               jj = 0.
     1835               repeat ii = 4 to 1 by -1 :
     1836                   if valid-handle (v-h[ii] ) then
     1837                   do:
     1838                       jj  = jj + 1 .
     1839                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1840                       v-h[ii]:row    = v-help-old-y .
     1841                   end.
     1842               end.
     1843           end.
     1844       end.
     1845   end procedure.
     1846   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1847   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1848   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1849   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1850   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1851   define variable v-diasize-current-frame-height as decimal   no-undo .
     1852   define variable v-diasize-change-size          as logical   no-undo .
     1853   define variable v-diasize-resize-button        as handle    no-undo .
     1854   define variable v-diasize-wndmax               as logical   no-undo .
     1855   define variable v-diasize-wndstore             as logical   no-undo .
     1856   define variable v-diasize-proc-name            as character no-undo .
     1857   define variable v-diasize-browse-handle        as handle    no-undo .
     1858   define variable v-diasize-browse-number        as integer   no-undo .
     1859   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1860   define temp-table temp-diasize-handle no-undo
     1861     field handle-value  as handle
     1862     field save-position as decimal
     1863     index xpk is primary unique handle-value
     1864     .
     1865   define temp-table temp-browse-handle no-undo
     1866     field browse-type   as character
     1867     field browse-number as integer
     1868     field browse-handle as handle
     1869     field original-size as decimal
     1870     index xpk is primary unique browse-type browse-number
     1871     index xie browse-type browse-handle
     1872   .
     1873   procedure diasize_change-height :
     1874     define input  parameter p-change-value  as decimal   no-undo .
     1875     define input  parameter p-move-resize   as logical   no-undo .
     1876     define variable v-field-group-handle    as handle    no-undo .
     1877     define variable v-object-handle         as handle    no-undo .
     1878     define variable v-frame-height          as decimal   no-undo .
     1879     define variable v-frame-virtual-height  as decimal   no-undo .
     1880     define variable v-browse-height         as decimal   no-undo .
     1881     define variable v-window-height         as decimal   no-undo .
     1882     define variable v-window-virtual-height as decimal   no-undo .
     1883     define variable v-change-sign           as integer   no-undo .
     1884     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1885     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1886     if p-change-value > 0
     1887     then do:
     1888       if frame Dialog-Frame :height + p-change-value
     1889           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1890       then do:
     1891         assign
     1892           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1893                           - (frame Dialog-Frame :height-chars)
     1894         .
     1895         if p-change-value <= 0
     1896         then do:
     1897           run diasize_position-resize-button in this-procedure .
     1898           return .
     1899         end.
     1900       end.
     1901     end.
     1902     if p-change-value < 0
     1903     then do:
     1904       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1905       then do:
     1906         assign
     1907           p-change-value = v-diasize-orig-frame-height
     1908                          - (frame Dialog-Frame :height-chars)
     1909         .
     1910         if p-change-value >= 0
     1911         then do:
     1912           run diasize_position-resize-button in this-procedure .
     1913           return .
     1914         end.
     1915       end.
     1916     end.
     1917     if p-change-value >= 0
     1918     then do:
     1919       assign
     1920         v-change-sign = 1
     1921       .
     1922     end.
     1923     else do:
     1924       assign
     1925         v-change-sign = -1
     1926       .
     1927     end.
     1928     assign
     1929       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1930     .
     1931     if p-change-value = 0
     1932     then do:
     1933       run diasize_position-resize-button in this-procedure .
     1934       return .
     1935     end.
     1936     move_block:
     1937     do
     1938     on error undo move_block, retry move_block
     1939     :
     1940       if retry
     1941       then do:
     1942         do
     1943         on error undo move_block, leave move_block
     1944         :
     1945           if p-change-value > 0
     1946           then do:
     1947             for each buf_temp-diasize-handle
     1948             on error undo, next
     1949             :
     1950               assign
     1951                 v-object-handle = buf_temp-diasize-handle.handle-value
     1952               .
     1953               if v-object-handle <> v-diasize-resize-button
     1954               then do:
     1955                 assign
     1956                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1957                 .
     1958               end.
     1959             end.
     1960             assign
     1961               v-diasize-browse-handle :height = v-browse-height
     1962             .
     1963             for each buf_temp-browse-handle
     1964               where buf_temp-browse-handle.browse-type = 'height':u
     1965             on error undo, next
     1966             :
     1967               assign
     1968                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1969               .
     1970             end.
     1971             assign
     1972               frame Dialog-Frame :height = v-frame-height
     1973             .
     1974             if frame Dialog-Frame :scrollable = true
     1975             then do:
     1976               assign
     1977                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1978               .
     1979             end.
     1980             run diasize_position-resize-button in this-procedure .
     1981           end.
     1982           else do:
     1983             if frame Dialog-Frame :scrollable = true
     1984             then do:
     1985               assign
     1986                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1987               .
     1988             end.
     1989             assign
     1990               frame Dialog-Frame :height = v-frame-height
     1991             .
     1992             assign
     1993               v-diasize-browse-handle :height = v-browse-height
     1994             .
     1995             for each buf_temp-browse-handle
     1996               where buf_temp-browse-handle.browse-type = 'height':u
     1997             on error undo, next
     1998             :
     1999               assign
     2000                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2001               .
     2002             end.
     2003             for each buf_temp-diasize-handle
     2004             on error undo, next
     2005             :
     2006               assign
     2007                 v-object-handle = buf_temp-diasize-handle.handle-value
     2008               .
     2009               if v-object-handle <> v-diasize-resize-button
     2010               then do:
     2011                 assign
     2012                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2013                 .
     2014               end.
     2015             end.
     2016             run diasize_position-resize-button in this-procedure .
     2017           end.
     2018           assign
     2019             v-diasize-change-size = false
     2020           .
     2021           leave move_block .
     2022         end.
     2023       end.
     2024       assign
     2025         v-diasize-need-full-display = true
     2026       .
     2027       if v-diasize-change-size = false
     2028       then do:
     2029         assign
     2030           v-diasize-change-size = true
     2031         .
     2032       end.
     2033       else do:
     2034         return .
     2035       end.
     2036       assign
     2037         v-frame-height = frame Dialog-Frame :height
     2038         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2039         v-browse-height = v-diasize-browse-handle :height
     2040       .
     2041       for each buf_temp-browse-handle
     2042         where buf_temp-browse-handle.browse-type = 'height':u
     2043       :
     2044         assign
     2045           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2046         .
     2047       end.
     2048       for each buf_temp-diasize-handle
     2049       :
     2050         delete buf_temp-diasize-handle .
     2051       end.
     2052       assign
     2053         v-field-group-handle = frame Dialog-Frame :first-child
     2054       .
     2055       do while valid-handle(v-field-group-handle)
     2056       :
     2057         assign
     2058           v-object-handle = v-field-group-handle :first-child
     2059         .
     2060         do while valid-handle(v-object-handle)
     2061         :
     2062           if  v-object-handle <> v-diasize-browse-handle :handle
     2063           and can-query(v-object-handle, "row")
     2064           and can-query(v-object-handle, "height")
     2065           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2066           then do:
     2067             find first buf_temp-browse-handle
     2068               where buf_temp-browse-handle.browse-type   = 'height':u
     2069                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2070               no-error .
     2071             if available buf_temp-browse-handle
     2072             then do:
     2073             end.
     2074             else do:
     2075               create buf_temp-diasize-handle .
     2076               assign
     2077                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2078                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2079               .
     2080             end.
     2081           end.
     2082           assign
     2083             v-object-handle = v-object-handle :next-sibling
     2084           .
     2085         end.
     2086         assign
     2087           v-field-group-handle = v-field-group-handle :next-sibling
     2088         .
     2089       end.
     2090       do with frame Dialog-Frame
     2091       :
     2092         hide v-diasize-resize-button .
     2093         assign
     2094           v-diasize-resize-button :row    = 1
     2095           v-diasize-resize-button :column = 1
     2096         .
     2097       end.
     2098       if p-change-value > 0
     2099       then do:
     2100         if frame Dialog-Frame :scrollable = true
     2101         then do:
     2102           assign
     2103             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2104             no-error .
     2105           if error-status :error
     2106           or error-status :get-message(1) <> ""
     2107           then do:
     2108             undo move_block, retry move_block .
     2109           end.
     2110         end.
     2111         assign
     2112           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2113           no-error .
