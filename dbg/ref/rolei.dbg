        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode as character no-undo .
        4   define input parameter p-psn-code like ub.person.psn-code no-undo .
        5   define input parameter p-role as character no-undo .
        6   define input parameter p-role-level as character no-undo .
        7   define input-output parameter p-rid as recid no-undo .
        8   define temp-table tt0-staff no-undo like ub.staff.
        9   DEFINE INPUT-OUTPUT PARAMETER TABLE FOR tt0-staff.
       10   define variable vss-revision    as character no-undo init "$Revision: 9d0726b3ce11, 2757, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       12   define variable vss-date        as character no-undo init "$Date: Сб фев 20 15:59:21 2021 +0300 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: rolei.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/rolei.p $":U .
       15   define variable vss-description as character no-undo init "Заведение и редактирование ролей".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
       87                                                       ,input p-range-type as character
       88                                                       ,input p-code as integer):
       89   define variable v-seq-val as integer no-undo .
       90   define buffer buf_code-range for ub.code-range.
       91   find first buf_code-range no-lock where
       92             buf_code-range.db-num = p-db-num
       93       and  buf_code-range.range-type = p-range-type
       94       and  buf_code-range.stts = 'u'
       95       and buf_code-range.first-code <= p-code
       96       and buf_code-range.last-code >= p-code no-error .
       97   if available buf_code-range then return yes.
       98   CASE p-range-type:
       99     when 'pngb':U then do:
      100       v-seq-val = current-value(s-pngb-code, ub).
      101     end.
      102     when 'fmgb':U then do:
      103       v-seq-val = current-value(s-fmgb-code, ub).
      104     end.
      105   END CASE.
      106   if p-code <= v-seq-val then do:
      107     find first buf_code-range no-lock where
      108               buf_code-range.db-num = p-db-num
      109         and  buf_code-range.range-type = p-range-type
      110         and  buf_code-range.stts = 'a'
      111         and buf_code-range.first-code <= p-code
      112         no-error .
      113    if available buf_code-range then return yes.
      114   end.
      115   find first buf_code-range no-lock where
      116             buf_code-range.db-num = p-db-num
      117       and  buf_code-range.range-type = p-range-type
      118       and  buf_code-range.stts = 'f'
      119       and buf_code-range.first-code <= p-code
      120       and buf_code-range.last-code >= p-code
      121       no-error .
      122   if available buf_code-range then return yes.
      123   return no.
      124   END FUNCTION.
      125   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      126                                                       ,input p-range-type as character
      127                                                       ,input p-code as integer):
      128   define variable v-seq-val as integer no-undo .
      129   define buffer buf_code-range for ub.code-range.
      130   CASE p-range-type:
      131     when 'pngb':U then do:
      132       v-seq-val = current-value(s-pngb-code, ub).
      133     end.
      134     when 'fmgb':U then do:
      135       v-seq-val = current-value(s-fmgb-code, ub).
      136     end.
      137   END CASE.
      138   if p-code <= v-seq-val then do:
      139     find first buf_code-range no-lock where
      140               buf_code-range.db-num = p-db-num
      141         and  buf_code-range.range-type = p-range-type
      142         and buf_code-range.first-code <= p-code
      143         and buf_code-range.last-code >= p-code no-error .
      144     if available buf_code-range then return yes.
      145   end.
      146   return no.
      147   END FUNCTION.
      148   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      149                                                       ,input p-db-num as integer
      150                                                       ,input p-staff-code as integer
      151                                                       ,input p-date as date
      152                                                        ):
      153   define buffer buf_staff for ub.staff.
      154   if p-date = ? then do:
      155     p-date = today .
      156   end.
      157   find first buf_staff no-lock where
      158             buf_staff.role = p-role
      159         and buf_staff.role-level = 'db':U
      160         and buf_staff.db-num = p-db-num
      161         and buf_staff.staff-code = p-staff-code
      162         and buf_staff.date-end >= p-date use-index pi  no-error .
      163   if available buf_staff then do:
      164     return buf_staff.psn-code.
      165   end.
      166   return 0.
      167   end FUNCTION.
      168   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      169                                                             ,input p-db-num as integer
      170                                                             ,input p-date as date
      171                                                                 ):
      172   define buffer buf_staff for ub.staff.
      173   define buffer buf2_staff for ub.staff.
      174   if p-date = ? then do:
      175     p-date = today .
      176   end.
      177   for each  buf_staff no-lock where
      178             buf_staff.role = p-role
      179         and buf_staff.db-num = p-db-num,
      180   first buf2_staff no-lock where
      181         buf2_staff.role = p-role
      182     and buf2_staff.role-level = 'db':U
      183     and buf2_staff.staff-code = buf_staff.staff-code
      184     and buf2_staff.date-start <= p-date
      185     and buf2_staff.date-end >= p-date
      186   by buf_staff.staff-code
      187   by date-start descending:
      188     return buf_staff.staff-code.
      189   end.
      190   end FUNCTION.
      191   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      192                                                  ,input p-db-num as integer
      193                                                  ,input p-psn-code as integer
      194                                                  ,input p-date as date
      195                                                  ,output p-c-password as character
      196                                                        ):
      197   define buffer buf_staff for ub.staff.
      198   if p-date = ? then do:
      199     p-date = today .
      200   end.
      201   find first buf_staff no-lock where
      202             buf_staff.role = p-role
      203         and buf_staff.role-level = 'db':U
      204         and buf_staff.db-num = p-db-num
      205        and buf_staff.date-end >= p-date
      206        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      207   if available buf_staff
      208   then do:
      209     assign
      210     p-c-password = buf_staff.password.
      211     return buf_staff.staff-code.
      212   end.
      213   p-c-password = ''.
      214   return 0.
      215   end FUNCTION.
      216   FUNCTION gbclcode-is-psn-role returns integer (
      217                                                 input p-role as character
      218                                                 ,input p-psn-code as integer
      219                                                 ,input p-date as date
      220                                                     ):
      221   define buffer buf_staff for ub.staff.
      222   if p-date = ? then do:
      223     p-date = today .
      224   end.
      225   for each buf_staff no-lock where
      226             buf_staff.psn-code = p-psn-code
      227        and  buf_staff.role = p-role
      228   by buf_staff.role-level
      229   by buf_staff.date-start
      230        :
      231     if  buf_staff.date-start <= p-date and
      232     buf_staff.date-end >= p-date  then do:
      233       return buf_staff.staff-code.
      234     end.
      235   end.
      236   return 0.
      237   end FUNCTION.
      238   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      239   define variable v-role-name as character no-undo .
      240   assign
      241   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      242   no-error .
      243   return v-role-name.
      244   END.
      245   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      246   FUNCTION gbclcode-get-position returns character ( input p-role as character
      247                                                     ,input p-role-level as character
      248                                                     ,input p-work-place as character
      249                                                     ,input p-staff-code as integer
      250                                                                ):
      251   define variable v-role-name as character no-undo .
      252   define variable v-role-level as character no-undo .
      253   define variable v-staff-code as integer no-undo .
      254   assign
      255   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      256   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      257   v-staff-code = p-staff-code
      258   no-error .
      259   return substitute("&1, &2, Код &3"
      260                   ,v-role-name
      261                   ,v-role-level
      262                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      263   END.
      264   FUNCTION gbclcode-get-work-place returns character (
      265                                                   input p-role as character
      266                                                  ,input p-role-level as character
      267                                                  ,input p-db-num as integer
      268                                                  ,input p-host-code as integer
      269                                                  ,input p-obj-type as character
      270                                                  ,input p-obj-code as integer
      271                                                  ) :
      272   define variable v-work-place as character no-undo .
      273   define variable v-obj-type as character no-undo .
      274     case p-role-level:
      275       when 'db':U then do:
      276         v-work-place = string(p-db-num, "99999").
      277       end.
      278       when 'firm':U then do:
      279         v-work-place = string(p-host-code, "99999").
      280       end.
      281       when 'object':U then do:
      282         assign
      283         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      284         .
      285       end.
      286     END CASE.
      287     return v-work-place.
      288   END FUNCTION.
      289   FUNCTION gbclcode-get-level-last-code returns integer (
      290                                                           input p-role as character
      291                                                         , input p-role-level as character
      292                                                         , input p-work-place as character
      293                                                         , input p-date-start as date
      294                                                         ):
      295   DEFINE VARIABLE v-today as date no-undo .
      296   define buffer buf_staff for ub.staff.
      297   if p-work-place = chr(63) then return ?.
      298   if p-date-start = ? then do:
      299     v-today = today .
      300   end.
      301   else do:
      302     v-today = p-date-start.
      303   end.
      304   find last buf_staff no-lock where
      305             buf_staff.role = p-role
      306        and  buf_staff.role-level = p-role-level
      307        and  buf_staff.work-place = p-work-place
      308        and  buf_staff.date-start <= v-today + 1
      309        and  buf_staff.date-end >= v-today + 1
      310        use-index pi  no-error .
      311   if available buf_staff
      312   then return buf_staff.staff-code.
      313   return 0.
      314   end FUNCTION.
      315   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   procedure cur-time :
      317      define output parameter p-today as date      no-undo .
      318      define output parameter p-time  as integer   no-undo .
      319     do
      320     on error undo, return error
      321     :
      322       define variable v-date1 as date      no-undo .
      323       define variable v-date2 as date      no-undo .
      324       define variable v-time  as integer   no-undo .
      325       assign
      326         v-date1 = today
      327         v-time  = time
      328         v-date2 = today
      329       .
      330       if v-date1 <> v-date2
      331       then do:
      332         assign
      333           v-date1 = today
      334           v-time  = v-time
      335         .
      336       end.
      337       assign
      338         p-today = v-date1
      339         p-time  = v-time
      340       .
      341     end.
      342   end.
      343   function cur-time-date returns character
      344   :
      345     return string(today, '99/99/9999':U) .
      346   end.
      347   function cur-time-mjd returns decimal
      348   :
      349     define variable v-date as date      no-undo .
      350     define variable v-time as integer   no-undo .
      351     run cur-time in this-procedure
      352       (output v-date
      353       ,output v-time
      354       ) .
      355     return integer(v-date) - 2400002 + (v-time / 86400) .
      356   end.
      357   function cur-time-get-ending-index returns integer
      358   (input p-number as integer
      359   )
      360   :
      361     if p-number < 0
      362     or p-number = ?
      363     then do:
      364       return 1 .
      365     end.
      366     define variable v-rest as integer   no-undo .
      367     assign
      368       p-number = p-number modulo 100
      369     .
      370     if p-number < 20
      371     then do:
      372       assign
      373         v-rest = p-number
      374       .
      375     end.
      376     else do:
      377       assign
      378         v-rest = p-number modulo 10
      379       .
      380     end.
      381     case v-rest :
      382       when 1
      383       then do:
      384         return 2 .
      385       end.
      386       when 2 or
      387       when 3 or
      388       when 4
      389       then do:
      390         return 3 .
      391       end.
      392       otherwise do:
      393         return 1 .
      394       end.
      395     end case .
      396   end.
      397   procedure cur-time-mjd-to-date :
      398      define input  parameter i-mjd-diff as decimal no-undo.
      399      define output parameter o-Date     as date    no-undo.
      400      define output parameter o-Time     as integer no-undo.
      401      define variable v-day-number as integer   no-undo .
      402      if    i-mjd-diff < 0
      403         or i-mjd-diff = ?
      404      then do:
      405         return "?" .
      406      end.
      407      assign
      408         v-day-number = truncate(i-mjd-diff,0).
      409         o-Date = date(v-day-number + 2400002).
      410         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      411     .
      412   end.
      413   function cur-time-mjd-to-string returns character
      414   (input p-mjd-diff as decimal
      415   )
      416   :
      417     define variable v-day-number as integer   no-undo .
      418     define variable v-seconds    as integer   no-undo .
      419     define variable v-hour       as integer   no-undo .
      420     define variable v-min        as integer   no-undo .
      421     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      422     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      423     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      424     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      425     if p-mjd-diff < 0
      426     or p-mjd-diff = ?
      427     then do:
      428       return "?" .
      429     end.
      430     assign
      431       v-day-number = integer(truncate(p-mjd-diff,0))
      432       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      433     .
      434     if v-seconds > 86400
      435     then do:
      436       assign
      437         v-seconds = 86400 - 1
      438       .
      439     end.
      440     if v-seconds < 0
      441     then do:
      442       assign
      443         v-seconds = 0
      444       .
      445     end.
      446     assign
      447       v-hour = truncate(v-seconds / 3600, 0)
      448     .
      449     assign
      450       v-seconds = v-seconds modulo 3600
      451     .
      452     assign
      453       v-min = truncate(v-seconds / 60, 0)
      454     .
      455     assign
      456       v-seconds = v-seconds modulo 60
      457     .
      458     return
      459         (if v-day-number <> 0
      460           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      461           else ""
      462         )
      463       + (if v-day-number <> 0 or v-hour <> 0
      464           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      465           else ""
      466         )
      467       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      468           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      469           else ""
      470         )
      471       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      472       .
      473   end.
      474   function cur-time-string returns character
      475   :
      476     define variable v-date as date      no-undo .
      477     define variable v-time as integer   no-undo .
      478     run cur-time in this-procedure
      479       (output v-date
      480       ,output v-time
      481       ) .
      482     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      483   end.
      484   function cur-time-string-sec returns character
      485   :
      486     define variable v-date as date      no-undo .
      487     define variable v-time as integer   no-undo .
      488     run cur-time in this-procedure
      489       (output v-date
      490       ,output v-time
      491       ) .
      492     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      493   end.
      494   function cur-time-custom  returns character
      495   (input p-prefix as character
      496   ,input p-date-format as character
      497   ,input p-delimiter as character
      498   ,input p-time-format as character
      499   ,input p-suffix as character
      500   )
      501   :
      502     define variable v-date as date      no-undo .
      503     define variable v-time as integer   no-undo .
      504     run cur-time in this-procedure
      505       (output v-date
      506       ,output v-time
      507       ) .
      508     return
      509       p-prefix
      510       + string(v-date, p-date-format)
      511       + p-delimiter
      512       + string(v-time, p-time-format)
      513       + p-suffix
      514       .
      515   end.
      516   function cur-time-print  returns character
      517   :
      518     define variable v-date as date      no-undo .
      519     define variable v-time as integer   no-undo .
      520     run cur-time in this-procedure
      521       (output v-date
      522       ,output v-time
      523       ) .
      524     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      525   end.
      526   function cur-time-datetime returns datetime
      527   :
      528     define variable v-char as character no-undo .
      529     define variable v-datetime as datetime no-undo .
      530     v-char = cur-time-string().
      531     v-datetime = datetime(v-char).
      532     return  v-datetime.
      533   end.
      534   function cur-time-string-msec returns character
      535   :
      536     define variable v-date as datetime  no-undo .
      537     v-date = now.
      538     return string(v-date) .
      539   end.
      540   define variable ref-list as character no-undo .
      541   define variable to-grp  as integer no-undo .
      542   define variable v-level as character no-undo .
      543   define variable v-db-num like ub.db.db-num no-undo .
      544   define variable v-host-code like ub.sysconf.host-code no-undo .
      545   define variable v-obj-type like ub.clients.obj-type no-undo .
      546   define variable v-obj-code like ub.clients.obj-code no-undo .
      547   define variable v-title as character no-undo .
      548   define variable v-staff-code-label as character no-undo .
      549   define variable v-staff-code-format as character no-undo .
      550   define variable v-password-option as integer no-undo .
      551   define variable v-password-label as character no-undo .
      552   define variable v-password-format as character no-undo .
      553   define variable v-notes as character no-undo .
      554   define variable v-cashier-code as integer no-undo .
      555   define variable v-seller-code as integer no-undo .
      556   define variable v-password as character no-undo .
      557   define variable v-staff-code as integer no-undo .
      558   define variable ri as recid no-undo .
      559   define variable v-ok as logical no-undo .
      560   define variable glog as logical no-undo .
      561   define variable v-id-string as character no-undo .
      562   define variable v-work-place as character no-undo .
      563   define variable v-omron as logical no-undo .
      564   define variable v-ncr as logical no-undo .
      565   define variable v-servis as logical no-undo .
      566   define variable v-date-start as date no-undo .
      567   define variable v-date-end as date no-undo .
      568   DEFINE VARIABLE v-today as date no-undo .
      569   DEFINE VARIABLE v-time as integer no-undo .
      570   define buffer buf_cli-grp for ub.cli-grp.
      571   define buffer buf_clients for ub.clients.
      572   define buffer tt-staff for tt0-staff.
      573   define buffer buf_staff for ub.staff.
      574   define buffer buf_cash-desk for ub.cash-desk.
      575   do
      576   on error undo, return error return-value
      577   :
      578     CASE p-mode :
      579       when 'ДОБАВЛЕНИЕ':U then do:
      580         if p-psn-code = 0 then do:
      581           run ref/cli-grps.w (
      582                         input parparentproc
      583                       , input "b-sel,b-mark"
      584                       , input-output ref-list ) .
      585           if ref-list <> "" then do:
      586             FIND buf_cli-grp where recid( buf_cli-grp ) = integer( ref-list ) .
      587             if can-find( FIRST ub.cli-grp where ub.cli-grp.upper-code = buf_cli-grp.node-code ) then do:
      588               message
      589               "Добавлять можно только в группы," skip
      590               "у которых нет подгрупп." skip
      591               "Выбирайте другую группу !" view-as alert-box WARNING .
      592               undo, return error .
      593             end.
      594             assign
      595             to-grp = buf_cli-grp.node-code
      596             .
      597             run ref/personi.w (
      598                            INPUT parparentproc
      599                           ,input 'ДОБАВЛЕНИЕ':U
      600                           ,input 0
      601                           ,input to-grp
      602                           ,input p-role
      603                           ,input-output p-rid ) no-error .
      604             if error-status:error then return error return-value .
      605           end.
      606           else do:
      607             return.
      608           end.
      609         end.
      610         if p-psn-code = ? then do:
      611           run ref/cli-all.w (
      612                            input parparentproc
      613                           ,input "b-sel"
      614                           ,input 'чел':U
      615                           ,input 'все':U
      616                           ,input 'текущие':U
      617                           ,input ?
      618                           ,input ",,,,,,NO,,"
      619                           ,input "lock-cli-type":U
      620                           ,output ref-list).
      621           if ref-list = "" then return.
      622           ri = integer(entry(1, ref-list)) .
      623           FIND first buf_clients no-lock WHERE recid( buf_clients ) = ri  .
      624           if g#db-num > 0 then do:
      625             if p-role = 'C':U then do:
      626               assign
      627               v-cashier-code = gbclcode-get-db-role (
      628                                                       input 'C':U
      629                                                      ,input g#db-num
      630                                                      ,input buf_clients.obj-code
      631                                                      ,input ?
      632                                                      ,output v-password)
      633               no-error .
      634               if v-cashier-code > 0 then do:
      635                 message
      636                 substitute("Данное физическое лицо уже является кассиром в БД &1!"  +
      637                            "Вы уверены, что хотите дать ему еще один код кассира?&1" +
      638                            "Это может привести к ошибкам при разборе чеков"
      639                          , g#db-num)
      640                 view-as alert-box QUESTION buttons YES-NO update glog.
      641                 if not glog then  undo, return.
      642               end.
      643             end.
      644             if p-role = 'S':U then do:
      645               assign
      646               v-seller-code = gbclcode-get-db-role ( input 'S':U
      647                                                     ,input g#db-num
      648                                                     ,input buf_clients.obj-code
      649                                                     ,input ?
      650                                                     ,output v-password)
      651               no-error .
      652               if v-seller-code > 0 then do:
      653                 message
      654                 substitute("Данное физическое лицо уже является продавцом в БД &1!"  +
      655                            "Вы уверены, что хотите дать ему еще один код продавца?&1" +
      656                            "Это может привести к ошибкам при разборе чеков"
      657                          , g#db-num)
      658                 view-as alert-box QUESTION buttons YES-NO update glog.
      659                 if not glog then  undo, return.
      660               end.
      661             end.
      662           end.
      663           assign
      664           p-psn-code = buf_clients.obj-code
      665           .
      666         end.
      667       end.
      668     END CASE.
      669     do
      670     on error undo, return error
      671     on stop undo, return error :
      672       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      673         find first buf_staff exclusive-lock where
      674                 recid(buf_staff) = p-rid.
      675       end.
      676       if p-mode = 'ПРОСМОТР':U then do:
      677         find first buf_staff no-lock where
      678                   recid(buf_staff) = p-rid.
      679       end.
      680     end.
      681     if not (p-mode = 'ДОБАВЛЕНИЕ':U
      682             and
      683             p-psn-code = 0)
      684     or p-mode = 'ИЗМЕНЕНИЕ':U
      685     or p-mode = ('ДОБАВЛЕНИЕ':U + chr(44) + 'temp') then do:
      686       assign
      687       v-db-num = (if p-mode = 'ИЗМЕНЕНИЕ':U
      688                       or p-mode = 'ПРОСМОТР':U
      689                       then buf_staff.db-num
      690                       else (if g#db-num = 0 then ? else g#db-num))
      691       .
      692       find first buf_cash-desk no-lock where
      693               buf_cash-desk.db-num = v-db-num
      694           and buf_cash-desk.pos-type = 'OMRON-NEW':U no-error.
      695       if available buf_cash-desk then do:
      696         v-omron = yes.
      697       end.
      698       find first buf_cash-desk no-lock where
      699               buf_cash-desk.db-num = v-db-num
      700           and buf_cash-desk.pos-type = 'NCR-GM':U no-error.
      701       if available buf_cash-desk then do:
      702         v-ncr = yes.
      703       end.
      704       find first buf_cash-desk no-lock where
      705               buf_cash-desk.db-num = v-db-num
      706           and buf_cash-desk.pos-type = 'NCR-AS@R':U no-error.
      707       if available buf_cash-desk then do:
      708         v-ncr = yes.
      709       end.
      710       run cur-time in this-procedure ( output v-today, output v-time).
      711       case p-role:
      712         when 'C':U then do:
      713           assign
      714           v-staff-code = (if p-mode = 'ПРОСМОТР':U
      715                           or p-mode = 'ИЗМЕНЕНИЕ':U
      716                           then buf_staff.staff-code
      717                           else 0)
      718           v-level = 'db':U
      719           v-host-code = 0
      720           v-obj-type = '':U
      721           v-obj-code = 0
      722           v-title = "Данные кассира"
      723           v-staff-code-label = "Код кассира"
      724           v-staff-code-format = (if v-omron = yes or v-ncr = yes then ">>>9" else ">>9")
      725           v-password-option = 2
      726           v-password-label = "Пароль кассира"
      727           v-password-format = "X(5)"
      728           v-notes = substitute("Внимание!&1Диапазон значений <КОДA КАССИРА> и <ПАРОЛЯ> различен для касс и POS разного типа&1"  +
      729                               "Перед вводом кода и пароля кассира проконсультируйтесь с Вашим администратором"
      730                               , chr(10))
      731           v-password = (if p-mode = 'ИЗМЕНЕНИЕ':U
      732                         or p-mode = 'ПРОСМОТР':U
      733                         then  buf_staff.password
      734                         else '':U)
      735           v-date-start = (if p-mode = 'ИЗМЕНЕНИЕ':U
      736                         or p-mode = 'ПРОСМОТР':U
      737                         then  buf_staff.date-start
      738                         else v-today + 1)
      739           v-date-end   = (if p-mode = 'ИЗМЕНЕНИЕ':U
      740                         or p-mode = 'ПРОСМОТР':U
      741                         then  buf_staff.date-end
      742                         else 12/31/9999)
      743           .
      744         end.
      745         when 'S':U then do:
      746           assign
      747           v-staff-code = (if p-mode = 'ПРОСМОТР':U
      748                           or p-mode = 'ИЗМЕНЕНИЕ':U
      749                           then buf_staff.staff-code
      750                           else 0)
      751           v-level = 'db':U
      752           v-host-code = 0
      753           v-obj-type = '':U
      754           v-obj-code = 0
      755           v-title = "Данные продавца (официанта)"
      756           v-staff-code-label = "Код продавца (официанта)"
      757           v-staff-code-format = (if v-omron = yes or v-ncr = yes then ">>>9" else ">>9")
      758           v-password-option = 1
      759           v-password-label = "Пароль продавца (официанта)"
      760           v-password-format = "X(3)"
      761           v-notes = substitute("Внимание!&1Диапазон значений <КОДA ПРОДАВЦА> и <ПАРОЛЯ> различен для касс и POS разного типа&1"  +
      762                               "Пароль ПРОДАВЦА для некоторых касс и POS не требуется&1" +
      763                               "Перед вводом кода и пароля продавца (официанта) проконсультируйтесь с Вашим администратором&1"
      764                               , chr(10))
      765           v-password = (if p-mode = 'ИЗМЕНЕНИЕ':U
      766                         or p-mode = 'ПРОСМОТР':U
      767                         then  buf_staff.password
      768                         else '':U)
      769           v-date-start = (if p-mode = 'ИЗМЕНЕНИЕ':U
      770                         or p-mode = 'ПРОСМОТР':U
      771                         then  buf_staff.date-start
      772                         else v-today + 1)
      773           v-date-end   = (if p-mode = 'ИЗМЕНЕНИЕ':U
      774                         or p-mode = 'ПРОСМОТР':U
      775                         then  buf_staff.date-end
      776                         else 12/31/9999)
      777           .
      778         end.
      779         otherwise do:
      780           assign
      781           v-host-code =  (if p-mode = 'ИЗМЕНЕНИЕ':U
      782                          or p-mode = 'ПРОСМОТР':U
      783                          then buf_staff.host-code
      784                          else 0)
      785           v-obj-type =  (if p-mode = 'ИЗМЕНЕНИЕ':U
      786                         or p-mode = 'ПРОСМОТР':U
      787                         then buf_staff.obj-type
      788                         else '':U)
      789           v-obj-code =  (if p-mode = 'ИЗМЕНЕНИЕ':U
      790                         or p-mode = 'ПРОСМОТР':U
      791                         then buf_staff.obj-code
      792                         else 0)
      793             .
      794         end.
      795       END CASE.
      796       run ref/staffi.w (
      797                        INPUT parparentproc
      798                       ,INPUT this-procedure
      799                       ,input p-role
      800                       ,INPUT p-mode
      801                       ,input v-level
      802                       ,INPUT-OUTPUT v-db-num
      803                       ,INPUT-OUTPUT v-host-code
      804                       ,INPUT-OUTPUT v-obj-type
      805                       ,INPUT-OUTPUT v-obj-code
      806                       ,INPUT v-title
      807                       ,INPUT v-staff-code-label
      808                       ,INPUT v-staff-code-format
      809                       ,INPUT v-password-option
      810                       ,INPUT v-password-label
      811                       ,INPUT v-password-format
      812                       ,INPUT v-notes
      813                       ,INPUT-OUTPUT v-staff-code
      814                       ,INPUT-OUTPUT v-password
      815                       ,input-output v-date-start
      816                       ,input-output v-date-end
      817                       ,OUTPUT v-ok
      818                       ) no-error.
      819       if not v-ok then undo, return.
      820       if p-mode = 'ИЗМЕНЕНИЕ':U
      821       or (p-mode = 'ДОБАВЛЕНИЕ':U and p-psn-code > 0)
      822       then do:
      823         run ref/staff01.p (
      824                        input-output p-rid
      825                       ,input p-mode
      826                       ,input no
      827                       ,input p-role
      828                       ,input v-staff-code
      829                       ,input p-psn-code
      830                       ,input v-level
      831                       ,input v-date-start
      832                       ,input v-date-end
      833                       ,input v-db-num
      834                       ,input v-host-code
      835                       ,input v-obj-type
      836                       ,input v-obj-code
      837                       ,input (if p-mode = 'ИЗМЕНЕНИЕ':U then buf_staff.work-place else v-work-place)
      838                       ,input v-password) no-error .
      839         if error-status:error then do:
      840           message
      841           substitute("Ошибка при сохранении записи &1&2&3&2&4"
      842                      , entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      843                      , chr(10)
      844                      , error-status:get-message(1)
      845                      , return-value )
      846           view-as alert-box error .
      847           undo, return error return-value .
      848         end.
      849       end.
      850       if p-mode = 'ДОБАВЛЕНИЕ':U + chr(44) + 'temp':U then do:
      851          CASE v-level:
      852            when 'db':U then do:
      853               assign
      854               v-work-place = string(v-db-num, '99999').
      855            end.
      856            when 'firm':U then do:
      857               assign
      858               v-work-place = string(v-host-code, '99999').
      859            end.
      860            when 'object':U then do:
      861               assign
      862               v-work-place = v-obj-type + string(v-obj-code, '999999999').
      863            end.
      864          END CASE.
      865          find first tt-staff where
      866                     tt-staff.role = p-role
      867                and  tt-staff.role-level = p-role-level
      868                and  tt-staff.work-place = v-work-place
      869                and tt-staff.staff-code  = v-staff-code
      870                and tt-staff.date-start  = v-date-start  no-error.
      871         if not available tt-staff then do:
      872           create tt-staff.
      873           assign
      874           tt-staff.db-num     = v-db-num
      875           tt-staff.role       = p-role
      876           tt-staff.role-level = p-role-level
      877           tt-staff.work-place = v-work-place
      878           tt-staff.staff-code  = v-staff-code
      879           tt-staff.psn-code = p-psn-code
      880           tt-staff.date-start = v-date-start
      881           .
      882         end.
      883         tt-staff.password = v-password.
      884       end.
      885     end.
      886   end.
