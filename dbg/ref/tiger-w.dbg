        1   define input parameter p-db-num like ub.scales-attr.db-num no-undo.
        2   define input parameter p-scales-num like ub.scales-attr.scales-num no-undo.
        3   define input-output parameter p-value as character no-undo.
        4   def var vss-revision    as character no-undo init "$Revision$":U .
        5   def var vss-author      as character no-undo init "$Author$":U .
        6   def var vss-date        as character no-undo init "$Date$":U .
        7   def var vss-workfile    as character no-undo init "$Workfile$":U .
        8   def var vss-archive     as character no-undo init "$Archive$":U .
        9   def var vss-description as character no-undo init "Справочник весов и кодов тары".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define temp-table temp-tare no-undo
      116   field tare-id as integer format "99"
      117   field weight as decimal format ">,>>9.999"
      118   index pi is unique
      119   primary
      120   tare-id
      121   .
      122   DEFINE BUTTON B-add
      123        LABEL "&Добавить"
      124        SIZE 10 BY 1.
      125   DEFINE BUTTON B-del
      126        LABEL "&Удалить"
      127        SIZE 10 BY 1.
      128   DEFINE BUTTON B-exit AUTO-GO
      129        LABEL "&Ввод"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON B-Help
      133        LABEL "Помо&щь"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON b-quit AUTO-END-KEY
      137        LABEL "&Отмена"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE VARIABLE v-tare-id AS INTEGER FORMAT ">9":U INITIAL 0
      141        LABEL "Код тары"
      142        VIEW-AS FILL-IN
      143        SIZE 8.88 BY 1 NO-UNDO.
      144   DEFINE QUERY BR-kat FOR
      145         temp-tare SCROLLING.
      146   DEFINE BROWSE BR-kat
      147     QUERY BR-kat DISPLAY
      148         temp-tare.tare-id COLUMN-LABEL "Код тары"
      149   temp-tare.weight COLUMN-LABEL "Вес тары"
      150   ENABLE temp-tare.weight
      151       WITH NO-ROW-MARKERS SEPARATORS SIZE 20.75 BY 10.63.
      152   DEFINE FRAME Dialog-Frame
      153        b-quit AT ROW 1 COL 1
      154        B-exit AT ROW 1 COL 11
      155        B-Help AT ROW 1 COL 21
      156        v-tare-id AT ROW 2.29 COL 1.75
      157        BR-kat AT ROW 3.38 COL 1.75
      158        B-add AT ROW 3.58 COL 22.75
      159        B-del AT ROW 5.58 COL 22.75
      160        SPACE(0.62) SKIP(7.66)
      161       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      162            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      163            TITLE "Веса и коды тары"
      164            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      165   ASSIGN
      166          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      167          FRAME Dialog-Frame:HIDDEN           = TRUE.
      168   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      169   DO:
      170     APPLY "END-ERROR":U TO SELF.
      171   END.
      172   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      173   DO:
      174   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   if lookup(self :type
      176            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      177            ) = 0
      178   then do:
      179     message
      180       "$Workfile$"
      181       "Указанному интерфейсному элементу фокус не может быть передан" skip
      182       "Интерфейсный элемент" self :name  skip
      183       "Тип" self :type  skip
      184       "Процедура" this-procedure :file-name skip
      185       view-as alert-box .
      186   end.
      187   else do:
      188     apply "entry":u to self  .
      189     if focus :handle <> self :handle  then do:
      190       return no-apply .
      191     end.
      192   end.
      193     define variable v-rec as recid no-undo.
      194     define buffer buf_temp-tare for temp-tare.
      195       assign
      196       v-tare-id
      197       .
      198       if v-tare-id = 0 or
      199          v-tare-id > 16 or
      200          can-find(first buf_temp-tare no-lock where
      201                         buf_temp-tare.tare-id = v-tare-id) then do:
      202           bell.
      203           return no-apply.
      204       end.
      205       create buf_temp-tare.
      206       assign
      207        buf_temp-tare.tare-id = v-tare-id
      208        v-rec = recid(buf_temp-tare)
      209        .
      210        release buf_temp-tare.
      211        assign
      212              v-tare-id = 0
      213              .
      214              display
      215              v-tare-id
      216              with frame Dialog-Frame.
      217        OPEN QUERY BR-kat FOR EACH temp-tare.
      218        reposition br-kat to recid  v-rec no-error.
      219        apply "ENTRY" to br-kat.
      220   END.
      221   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      222   DO:
      223   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      224   if lookup(self :type
      225            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      226            ) = 0
      227   then do:
      228     message
      229       "$Workfile$"
      230       "Указанному интерфейсному элементу фокус не может быть передан" skip
      231       "Интерфейсный элемент" self :name  skip
      232       "Тип" self :type  skip
      233       "Процедура" this-procedure :file-name skip
      234       view-as alert-box .
      235   end.
      236   else do:
      237     apply "entry":u to self  .
      238     if focus :handle <> self :handle  then do:
      239       return no-apply .
      240     end.
      241   end.
      242     define buffer buf_temp-tare for temp-tare.
      243     if not avail temp-tare then return no-apply.
      244     find first buf_temp-tare where
      245               recid(buf_temp-tare) = recid(temp-tare) no-error.
      246     if avail buf_temp-tare then do:
      247        delete buf_temp-tare.
      248     end.
      249     OPEN QUERY BR-kat FOR EACH temp-tare.
      250     APPLY "ENTRY" to br-kat.
      251   END.
      252   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      253   DO:
      254   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255   if lookup(self :type
      256            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      257            ) = 0
      258   then do:
      259     message
      260       "$Workfile$"
      261       "Указанному интерфейсному элементу фокус не может быть передан" skip
      262       "Интерфейсный элемент" self :name  skip
      263       "Тип" self :type  skip
      264       "Процедура" this-procedure :file-name skip
      265       view-as alert-box .
      266   end.
      267   else do:
      268     apply "entry":u to self  .
      269     if focus :handle <> self :handle  then do:
      270       return no-apply .
      271     end.
      272   end.
      273     run proc-go in this-procedure no-error.
      274       if error-status:error then do:
      275       message error-status:error error-status:get-message(1) view-as alert-box .
      276       return no-apply.
      277     end.
      278   END.
      279   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      280   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      281   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      282   on help of frame Dialog-Frame
      283   do:
      284     run gbl/app_help.p
      285       (input this-procedure :file-name
      286       ,input ''
      287       ,input ?
      288       ) no-error.
      289     if error-status :error then do:
      290       message
      291         "Ошибка при вызове помощи"
      292         error-status :get-message(1)
      293         view-as alert-box .
      294     end.
      295   end.
      296   run minbtn-set in this-procedure .
      297   on choose of b-help in frame Dialog-Frame
      298   do:
      299     apply "help":u to frame Dialog-Frame .
      300   end.
      301   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      302   procedure minbtn-set :
      303       do
      304           on error undo, return error return-value
      305           :
      306           define variable ii              as integer       no-undo .
      307           define variable fh              as widget-handle no-undo .
      308           define variable hh              as widget-handle no-undo .
      309           define variable v-h             as handle        extent 4 no-undo .
      310           define variable v-name-button   as character     no-undo .
      311           define variable v-help-old-x    as decimal       no-undo .
      312           define variable v-help-old-y    as decimal       no-undo .
      313           define variable v-help-old-size as decimal       no-undo .
      314           define variable v-frame-width   as decimal       no-undo .
      315           define variable jj              as integer       no-undo .
      316           do
      317               on error undo, return error
      318               :
      319               assign
      320                   v-frame-width = frame Dialog-Frame:width - 0.3
      321                   fh            = frame Dialog-Frame:first-child
      322                   hh            = fh:first-child
      323                   ii            = 1
      324                   .
      325               do while valid-handle(hh):
      326                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      327                   do:
      328                       case lc(hh:name) :
      329                           when "b-help" then
      330                               do:
      331                                   hh:load-image-up("cmp/b-help.bmp":u) .
      332                                   hh:load-image-down("cmp/b-help.bmp":u) .
      333                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      334                                   hh:TOOLTIP = "Помощь" .
      335                                   v-help-old-x = hh:column .
      336                                   v-help-old-y = hh:row    .
      337                                   v-help-old-size = hh:width .
      338                                   hh:width-chars = 2.5 .
      339                               end.
      340                           when "b-print" then
      341                               do:
      342                                   hh:load-image("cmp/b-print.bmp":u) .
      343                                   hh:TOOLTIP = "Печать" .
      344                                   v-h[ii] = hh:handle .
      345                                   ii = ii + 1 .
      346                                   hh:width-chars = 3 .
      347                               end.
      348                           when "b-history" or
      349                           when "b-hist" then
      350                               do:
      351                                   hh:load-image("cmp/b-hist.bmp":u) .
      352                                   hh:TOOLTIP = "История" .
      353                                   v-h[ii] = hh:handle .
      354                                   ii = ii + 1 .
      355                                   hh:width-chars = 3 .
      356                               end.
      357                           when "b-sch" then
      358                               do:
      359                                   hh:load-image("cmp/b-sch.bmp":u) .
      360                                   hh:TOOLTIP = "Установка Фильтра" .
      361                                   v-h[ii] = hh:handle .
      362                                   ii = ii + 1 .
      363                                   hh:width-chars = 3 .
      364                               end.
      365                           when "b-hist-user" then
      366                               do:
      367                                   hh:load-image("cmp/b-hist.bmp":u) .
      368                                   hh:TOOLTIP = "История пользователя" .
      369                                   ii = ii + 1 .
      370                               end.
      371                       end case.
      372                   end.
      373                   hh = hh:next-sibling.
      374               end.
      375               b-help:column = v-frame-width - b-help:width-chars.
      376               jj = 0.
      377               repeat ii = 4 to 1 by -1 :
      378                   if valid-handle (v-h[ii] ) then
      379                   do:
      380                       jj  = jj + 1 .
      381                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      382                       v-h[ii]:row    = v-help-old-y .
      383                   end.
      384               end.
      385           end.
      386       end.
      387   end procedure.
      388   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      389   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      390   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      391   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      392   define variable v-diasize-current-frame-width  as decimal   no-undo .
      393   define variable v-diasize-current-frame-height as decimal   no-undo .
      394   define variable v-diasize-change-size          as logical   no-undo .
      395   define variable v-diasize-resize-button        as handle    no-undo .
      396   define variable v-diasize-wndmax               as logical   no-undo .
      397   define variable v-diasize-wndstore             as logical   no-undo .
      398   define variable v-diasize-proc-name            as character no-undo .
      399   define variable v-diasize-browse-handle        as handle    no-undo .
      400   define variable v-diasize-browse-number        as integer   no-undo .
      401   define variable v-diasize-need-full-display    as logical   no-undo init false .
      402   define temp-table temp-diasize-handle no-undo
      403     field handle-value  as handle
      404     field save-position as decimal
      405     index xpk is primary unique handle-value
      406     .
      407   define temp-table temp-browse-handle no-undo
      408     field browse-type   as character
      409     field browse-number as integer
      410     field browse-handle as handle
      411     field original-size as decimal
      412     index xpk is primary unique browse-type browse-number
      413     index xie browse-type browse-handle
      414   .
      415   procedure diasize_change-height :
      416     define input  parameter p-change-value  as decimal   no-undo .
      417     define input  parameter p-move-resize   as logical   no-undo .
      418     define variable v-field-group-handle    as handle    no-undo .
      419     define variable v-object-handle         as handle    no-undo .
      420     define variable v-frame-height          as decimal   no-undo .
      421     define variable v-frame-virtual-height  as decimal   no-undo .
      422     define variable v-browse-height         as decimal   no-undo .
      423     define variable v-window-height         as decimal   no-undo .
      424     define variable v-window-virtual-height as decimal   no-undo .
      425     define variable v-change-sign           as integer   no-undo .
      426     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      427     define buffer buf_temp-browse-handle  for temp-browse-handle .
      428     if p-change-value > 0
      429     then do:
      430       if frame Dialog-Frame :height + p-change-value
      431           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      432       then do:
      433         assign
      434           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      435                           - (frame Dialog-Frame :height-chars)
      436         .
      437         if p-change-value <= 0
      438         then do:
      439           run diasize_position-resize-button in this-procedure .
      440           return .
      441         end.
      442       end.
      443     end.
      444     if p-change-value < 0
      445     then do:
      446       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      447       then do:
      448         assign
      449           p-change-value = v-diasize-orig-frame-height
      450                          - (frame Dialog-Frame :height-chars)
      451         .
      452         if p-change-value >= 0
      453         then do:
      454           run diasize_position-resize-button in this-procedure .
      455           return .
      456         end.
      457       end.
      458     end.
      459     if p-change-value >= 0
      460     then do:
      461       assign
      462         v-change-sign = 1
      463       .
      464     end.
      465     else do:
      466       assign
      467         v-change-sign = -1
      468       .
      469     end.
      470     assign
      471       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      472     .
      473     if p-change-value = 0
      474     then do:
      475       run diasize_position-resize-button in this-procedure .
      476       return .
      477     end.
      478     move_block:
      479     do
      480     on error undo move_block, retry move_block
      481     :
      482       if retry
      483       then do:
      484         do
      485         on error undo move_block, leave move_block
      486         :
      487           if p-change-value > 0
      488           then do:
      489             for each buf_temp-diasize-handle
      490             on error undo, next
      491             :
      492               assign
      493                 v-object-handle = buf_temp-diasize-handle.handle-value
      494               .
      495               if v-object-handle <> v-diasize-resize-button
      496               then do:
      497                 assign
      498                   v-object-handle :row = buf_temp-diasize-handle.save-position
      499                 .
      500               end.
      501             end.
      502             assign
      503               v-diasize-browse-handle :height = v-browse-height
      504             .
      505             for each buf_temp-browse-handle
      506               where buf_temp-browse-handle.browse-type = 'height':u
      507             on error undo, next
      508             :
      509               assign
      510                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      511               .
      512             end.
      513             assign
      514               frame Dialog-Frame :height = v-frame-height
      515             .
      516             if frame Dialog-Frame :scrollable = true
      517             then do:
      518               assign
      519                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      520               .
      521             end.
      522             run diasize_position-resize-button in this-procedure .
      523           end.
      524           else do:
      525             if frame Dialog-Frame :scrollable = true
      526             then do:
      527               assign
      528                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      529               .
      530             end.
      531             assign
      532               frame Dialog-Frame :height = v-frame-height
      533             .
      534             assign
      535               v-diasize-browse-handle :height = v-browse-height
      536             .
      537             for each buf_temp-browse-handle
      538               where buf_temp-browse-handle.browse-type = 'height':u
      539             on error undo, next
      540             :
      541               assign
      542                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      543               .
      544             end.
      545             for each buf_temp-diasize-handle
      546             on error undo, next
      547             :
      548               assign
      549                 v-object-handle = buf_temp-diasize-handle.handle-value
      550               .
      551               if v-object-handle <> v-diasize-resize-button
      552               then do:
      553                 assign
      554                   v-object-handle :row = buf_temp-diasize-handle.save-position
      555                 .
      556               end.
      557             end.
      558             run diasize_position-resize-button in this-procedure .
      559           end.
      560           assign
      561             v-diasize-change-size = false
      562           .
      563           leave move_block .
      564         end.
      565       end.
      566       assign
      567         v-diasize-need-full-display = true
      568       .
      569       if v-diasize-change-size = false
      570       then do:
      571         assign
      572           v-diasize-change-size = true
      573         .
      574       end.
      575       else do:
      576         return .
      577       end.
      578       assign
      579         v-frame-height = frame Dialog-Frame :height
      580         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      581         v-browse-height = v-diasize-browse-handle :height
      582       .
      583       for each buf_temp-browse-handle
      584         where buf_temp-browse-handle.browse-type = 'height':u
      585       :
      586         assign
      587           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      588         .
      589       end.
      590       for each buf_temp-diasize-handle
      591       :
      592         delete buf_temp-diasize-handle .
      593       end.
      594       assign
      595         v-field-group-handle = frame Dialog-Frame :first-child
      596       .
      597       do while valid-handle(v-field-group-handle)
      598       :
      599         assign
      600           v-object-handle = v-field-group-handle :first-child
      601         .
      602         do while valid-handle(v-object-handle)
      603         :
      604           if  v-object-handle <> v-diasize-browse-handle :handle
      605           and can-query(v-object-handle, "row")
      606           and can-query(v-object-handle, "height")
      607           and ( v-object-handle :row > v-diasize-browse-handle :row )
      608           then do:
      609             find first buf_temp-browse-handle
      610               where buf_temp-browse-handle.browse-type   = 'height':u
      611                 and buf_temp-browse-handle.browse-handle = v-object-handle
      612               no-error .
      613             if available buf_temp-browse-handle
      614             then do:
      615             end.
      616             else do:
      617               create buf_temp-diasize-handle .
      618               assign
      619                 buf_temp-diasize-handle.handle-value  = v-object-handle
      620                 buf_temp-diasize-handle.save-position = v-object-handle :row
      621               .
      622             end.
      623           end.
      624           assign
      625             v-object-handle = v-object-handle :next-sibling
      626           .
      627         end.
      628         assign
      629           v-field-group-handle = v-field-group-handle :next-sibling
      630         .
      631       end.
      632       do with frame Dialog-Frame
      633       :
      634         hide v-diasize-resize-button .
      635         assign
      636           v-diasize-resize-button :row    = 1
      637           v-diasize-resize-button :column = 1
      638         .
      639       end.
      640       if p-change-value > 0
      641       then do:
      642         if frame Dialog-Frame :scrollable = true
      643         then do:
      644           assign
      645             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      646             no-error .
      647           if error-status :error
      648           or error-status :get-message(1) <> ""
      649           then do:
      650             undo move_block, retry move_block .
      651           end.
      652         end.
      653         assign
      654           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      655           no-error .
      656         if error-status :error
      657         or error-status :get-message(1) <> ""
      658         then do:
      659           undo move_block, retry move_block .
      660         end.
      661         assign
      662           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      663           no-error .
      664         if error-status :error
      665         or error-status :get-message(1) <> ""
      666         then do:
      667           undo move_block, retry move_block .
      668         end.
      669         for each buf_temp-browse-handle
      670           where buf_temp-browse-handle.browse-type = 'height':u
      671         on error undo move_block, retry move_block
      672         :
      673           assign
      674             buf_temp-browse-handle.browse-handle :height
      675               = buf_temp-browse-handle.browse-handle :height + p-change-value
      676             no-error .
      677           if error-status :error
      678           or error-status :get-message(1) <> ""
      679           then do:
      680             undo move_block, retry move_block .
      681           end.
      682         end.
      683         for each buf_temp-diasize-handle
      684         on error undo move_block, retry move_block
      685         :
      686           assign
      687             v-object-handle = buf_temp-diasize-handle.handle-value
      688           .
      689           if v-object-handle <> v-diasize-resize-button
      690           then do:
      691             assign
      692               v-object-handle :row = v-object-handle :row + p-change-value
      693               no-error .
      694             if error-status :error
      695             or error-status :get-message(1) <> ""
      696             then do:
      697               undo move_block, retry move_block .
      698             end.
      699           end.
      700         end.
      701       end.
      702       else do:
      703         for each buf_temp-diasize-handle
      704         on error undo move_block, retry move_block
      705         :
      706           assign
      707             v-object-handle = buf_temp-diasize-handle.handle-value
      708           .
      709           if v-object-handle <> v-diasize-resize-button
      710           then do:
      711             assign
      712               v-object-handle :row = v-object-handle :row + p-change-value
      713               no-error .
      714             if error-status :error
      715             or error-status :get-message(1) <> ""
      716             then do:
      717               undo move_block, retry move_block .
      718             end.
      719           end.
      720         end.
      721         assign
      722           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      723           no-error .
      724         if error-status :error
      725         or error-status :get-message(1) <> ""
      726         then do:
      727           undo move_block, retry move_block .
      728         end.
      729         for each buf_temp-browse-handle
      730           where buf_temp-browse-handle.browse-type = 'height':u
      731         on error undo move_block, retry move_block
      732         :
      733           assign
      734             buf_temp-browse-handle.browse-handle :height
      735               = buf_temp-browse-handle.browse-handle :height + p-change-value
      736             no-error .
      737           if error-status :error
      738           or error-status :get-message(1) <> ""
      739           then do:
      740             undo move_block, retry move_block .
      741           end.
      742         end.
      743         assign
      744           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      745           no-error .
      746         if error-status :error
      747         or error-status :get-message(1) <> ""
      748         then do:
      749           undo move_block, retry move_block .
      750         end.
      751         if frame Dialog-Frame :scrollable = true
      752         then do:
      753           assign
      754             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      755             no-error .
      756           if error-status :error
      757           or error-status :get-message(1) <> ""
      758           then do:
      759             undo move_block, retry move_block .
      760           end.
      761         end.
      762       end.
      763       if p-move-resize = true
      764       then do:
      765         run diasize_position-resize-button in this-procedure .
      766       end.
      767       if v-diasize-wndstore = true
      768       then do:
      769         if connected("ub") = true
      770         then do:
      771           define variable v-cntxt-db-num        as integer   no-undo .
      772           define variable v-cntxt-userid        as character no-undo .
      773           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      774                                             , OUTPUT v-cntxt-userid
      775                                             ) .
      776           run gbl/wndsizew.p
      777             (input  v-cntxt-db-num
      778             ,input  v-cntxt-userid
      779             ,input  v-diasize-proc-name
      780             ,input  'height':u
      781             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      782             ) .
      783         end.
      784       end.
      785     end.
      786     assign
      787       v-diasize-change-size = false
      788     .
      789   end procedure.
      790   procedure diasize_set-height :
      791     define input  parameter p-new-height  as decimal   no-undo .
      792     define input  parameter p-move-resize as logical   no-undo .
      793     do
      794     on error undo, return error return-value
      795     :
      796       run diasize_change-height in this-procedure
      797         (input  (p-new-height - frame Dialog-Frame :height)
      798         ,input  p-move-resize
      799         ) .
      800     end.
      801   end procedure.
      802   procedure diasize_change-width :
      803     define input  parameter p-change-value as decimal   no-undo .
      804     define input  parameter p-move-resize  as logical   no-undo .
      805     define variable v-field-group-handle   as handle    no-undo .
      806     define variable v-object-handle        as handle    no-undo .
      807     define variable v-frame-width          as decimal   no-undo .
      808     define variable v-frame-virtual-width  as decimal   no-undo .
      809     define variable v-browse-width         as decimal   no-undo .
      810     define variable v-window-width         as decimal   no-undo .
      811     define variable v-window-virtual-width as decimal   no-undo .
      812     define variable v-change-sign          as integer   no-undo .
      813     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      814     define buffer buf_temp-browse-handle  for temp-browse-handle .
      815     if p-change-value > 0
      816     then do:
      817       if frame Dialog-Frame :width + p-change-value >
      818           session :width-chars
      819       then do:
      820         assign
      821           p-change-value = session :width-chars - frame Dialog-Frame :width
      822         .
      823         if p-change-value <= 0
      824         then do:
      825           run diasize_position-resize-button in this-procedure .
      826           return .
      827         end.
      828       end.
      829     end.
      830     if p-change-value < 0
      831     then do:
      832       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      833       then do:
      834         assign
      835           p-change-value = v-diasize-orig-frame-width
      836                          - frame Dialog-Frame :width
      837         .
      838         if p-change-value >= 0
      839         then do:
      840           run diasize_position-resize-button in this-procedure .
      841           return .
      842         end.
      843       end.
      844     end.
      845     if p-change-value >= 0
      846     then do:
      847       assign
      848         v-change-sign = 1
      849       .
      850     end.
      851     else do:
      852       assign
      853         v-change-sign = -1
      854       .
      855     end.
      856     assign
      857       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      858     .
      859     if p-change-value = 0
      860     then do:
      861       run diasize_position-resize-button in this-procedure .
      862       return .
      863     end.
      864     move_block:
      865     do
      866     on error undo move_block, leave move_block
      867     :
      868       if retry
      869       then do:
      870         do
      871         on error undo move_block, leave move_block
      872         :
      873           if p-change-value > 0
      874           then do:
      875             for each buf_temp-diasize-handle
      876             on error undo, next
      877             :
      878               assign
      879                 v-object-handle = buf_temp-diasize-handle.handle-value
      880               .
      881               if v-object-handle <> v-diasize-resize-button
      882               then do:
      883                 assign
      884                   v-object-handle :col = buf_temp-diasize-handle.save-position
      885                 .
      886               end.
      887             end.
      888             assign
      889               v-diasize-browse-handle :width = v-browse-width
      890             .
      891             for each buf_temp-browse-handle
      892               where buf_temp-browse-handle.browse-type = 'width':u
      893             on error undo, next
      894             :
      895               assign
      896                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      897               .
      898             end.
      899             assign
      900               frame Dialog-Frame :width = v-frame-width
      901             .
      902             if frame Dialog-Frame :scrollable = true
      903             then do:
      904               assign
      905                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      906               .
      907             end.
      908             run diasize_position-resize-button in this-procedure .
      909           end.
      910           else do:
      911             if frame Dialog-Frame :scrollable = true
      912             then do:
      913               assign
      914                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      915               .
      916             end.
      917             assign
      918               frame Dialog-Frame :width = v-frame-width
      919             .
      920             for each buf_temp-browse-handle
      921               where buf_temp-browse-handle.browse-type = 'width':u
      922             on error undo, next
      923             :
      924               assign
      925                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      926               .
      927             end.
      928             assign
      929               v-diasize-browse-handle :width = v-browse-width
      930             .
      931             for each buf_temp-diasize-handle
      932             on error undo, next
      933             :
      934               assign
      935                 v-object-handle = buf_temp-diasize-handle.handle-value
      936               .
      937               if v-object-handle <> v-diasize-resize-button
      938               then do:
      939                 assign
      940                   v-object-handle :col = buf_temp-diasize-handle.save-position
      941                 .
      942               end.
      943             end.
      944             run diasize_position-resize-button in this-procedure .
      945           end.
      946           assign
      947             v-diasize-change-size = false
      948           .
      949           leave move_block .
      950         end.
      951       end.
      952       assign
      953         v-diasize-need-full-display = true
      954       .
      955       if v-diasize-change-size = false
      956       then do:
      957         assign
      958           v-diasize-change-size = true
      959         .
      960       end.
      961       else do:
      962         return .
      963       end.
      964       assign
      965         v-frame-width = frame Dialog-Frame :width
      966         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      967         v-browse-width = v-diasize-browse-handle :width
      968       .
      969       for each buf_temp-browse-handle
      970         where buf_temp-browse-handle.browse-type = 'width':u
      971       :
      972         assign
      973           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      974         .
      975       end.
      976       for each buf_temp-diasize-handle
      977       :
      978         delete buf_temp-diasize-handle .
      979       end.
      980       assign
      981         v-field-group-handle = frame Dialog-Frame :first-child
      982       .
      983       do while valid-handle(v-field-group-handle)
      984       :
      985         assign
      986           v-object-handle = v-field-group-handle :first-child
      987         .
      988         do while valid-handle(v-object-handle)
      989         :
      990           if  v-object-handle <> v-diasize-browse-handle :handle
      991           and v-object-handle <> v-diasize-resize-button
      992           and can-query(v-object-handle, "row")
      993           and can-query(v-object-handle, "height")
      994           and ( v-object-handle :col + v-object-handle :width
      995                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      996               )
      997           then do:
      998             find first buf_temp-browse-handle
      999               where buf_temp-browse-handle.browse-type   = 'width':u
     1000                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1001               no-error .
     1002             if available buf_temp-browse-handle
     1003             then do:
     1004             end.
     1005             else do:
     1006               create buf_temp-diasize-handle .
     1007               assign
     1008                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1009                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1010               .
     1011             end.
     1012           end.
     1013           assign
     1014             v-object-handle = v-object-handle :next-sibling
     1015           .
     1016         end.
     1017         assign
     1018           v-field-group-handle = v-field-group-handle :next-sibling
     1019         .
     1020       end.
     1021       do with frame Dialog-Frame
     1022       :
     1023         hide v-diasize-resize-button .
     1024         v-diasize-resize-button :row = 1.
     1025         v-diasize-resize-button :column = 1.
     1026       end.
     1027       if p-change-value > 0
     1028       then do:
     1029         if frame Dialog-Frame :scrollable = true
     1030         then do:
     1031           assign
     1032             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1033             no-error .
     1034           if error-status :error
     1035           or error-status :get-message(1) <> ""
     1036           then do:
     1037             undo move_block, retry move_block.
     1038           end.
     1039         end.
     1040         assign
     1041           frame Dialog-Frame :width = v-frame-width + p-change-value
     1042           no-error .
     1043         if error-status :error
     1044         or error-status :get-message(1) <> ""
     1045         then do:
     1046           undo move_block, retry move_block.
     1047         end.
     1048         assign
     1049           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1050         no-error .
     1051         if error-status :error
     1052         or error-status :get-message(1) <> ""
     1053         then do:
     1054           undo move_block, retry move_block.
     1055         end.
     1056         for each buf_temp-browse-handle
     1057           where buf_temp-browse-handle.browse-type = 'width':u
     1058         on error undo move_block, retry move_block
     1059         :
     1060           assign
     1061             buf_temp-browse-handle.browse-handle :width
     1062               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1063             no-error .
     1064           if error-status :error
     1065           or error-status :get-message(1) <> ""
     1066           then do:
     1067             undo move_block, retry move_block .
     1068           end.
     1069         end.
     1070         for each buf_temp-diasize-handle
     1071         on error undo move_block, retry move_block
     1072         :
     1073           assign
     1074             v-object-handle = buf_temp-diasize-handle.handle-value
     1075           .
     1076           if v-object-handle <> v-diasize-resize-button
     1077           then do:
     1078             assign
     1079               v-object-handle :col = v-object-handle :col + p-change-value
     1080               no-error .
     1081             if error-status :error
     1082             or error-status :get-message(1) <> ""
     1083             then do:
     1084               undo move_block, retry move_block .
     1085             end.
     1086           end.
     1087         end.
     1088       end.
     1089       else do:
     1090         for each buf_temp-diasize-handle
     1091         on error undo move_block, retry move_block
     1092         :
     1093           assign
     1094             v-object-handle = buf_temp-diasize-handle.handle-value
     1095           .
     1096           if v-object-handle <> v-diasize-resize-button
     1097           then do:
     1098             assign
     1099               v-object-handle :col = v-object-handle :col + p-change-value
     1100               no-error .
     1101             if error-status :error
     1102             or error-status :get-message(1) <> ""
     1103             then do:
     1104               undo move_block, retry move_block .
     1105             end.
     1106           end.
     1107         end.
     1108         for each buf_temp-browse-handle
     1109           where buf_temp-browse-handle.browse-type = 'width':u
     1110         on error undo move_block, retry move_block
     1111         :
     1112           assign
     1113             buf_temp-browse-handle.browse-handle :width
     1114               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1115             no-error .
     1116           if error-status :error
     1117           or error-status :get-message(1) <> ""
     1118           then do:
     1119             undo move_block, retry move_block .
     1120           end.
     1121         end.
     1122         assign
     1123           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1124           no-error .
     1125         if error-status :error
     1126         or error-status :get-message(1) <> ""
     1127         then do:
     1128           undo move_block, retry move_block.
     1129         end.
     1130         assign
     1131           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1132         no-error .
     1133         if error-status :error
     1134         or error-status :get-message(1) <> ""
     1135         then do:
     1136           undo move_block, retry move_block.
     1137         end.
     1138         if frame Dialog-Frame :scrollable = true
     1139         then do:
     1140           assign
     1141             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1142           no-error .
     1143           if error-status :error
     1144           or error-status :get-message(1) <> ""
     1145           then do:
     1146             undo move_block, retry move_block.
     1147           end.
     1148         end.
     1149       end.
     1150       if p-move-resize
     1151       then do:
     1152         run diasize_position-resize-button in this-procedure .
     1153       end.
     1154       if v-diasize-wndstore = true
     1155       then do:
     1156         if connected("ub") = true
     1157         then do:
     1158           define variable v-cntxt-db-num        as integer   no-undo .
     1159           define variable v-cntxt-userid        as character no-undo .
     1160           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1161                                             , OUTPUT v-cntxt-userid
     1162                                             ) .
     1163           run gbl/wndsizew.p
     1164             (input  v-cntxt-db-num
     1165             ,input  v-cntxt-userid
     1166             ,input  v-diasize-proc-name
     1167             ,input  'width':u
     1168             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1169             ) .
     1170         end.
     1171       end.
     1172     end.
     1173     assign
     1174       v-diasize-change-size = false
     1175     .
     1176   end procedure.
     1177   procedure diasize_set-width :
     1178     define input  parameter p-new-width  as decimal   no-undo .
     1179     define input  parameter p-move-resize as logical   no-undo .
     1180     do
     1181     on error undo, return error return-value
     1182     :
     1183       run diasize_change-width in this-procedure
     1184         (input  (p-new-width - frame Dialog-Frame :width)
     1185         ,input  p-move-resize
     1186         ) .
     1187     end.
     1188   end procedure.
     1189   procedure diasize_position-resize-button :
     1190     do with frame Dialog-Frame
     1191     :
     1192       hide v-diasize-resize-button .
     1193       assign
     1194         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1195                     - 1
     1196                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1197         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1198                     - 1
     1199                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1200       .
     1201       view v-diasize-resize-button .
     1202     end.
     1203   end procedure.
     1204   on alt-right anywhere
     1205   do:
     1206     run diasize_change-width in this-procedure
     1207       (input 1
     1208       ,input true
     1209       ) .
     1210     return no-apply .
     1211   end.
     1212   on alt-left anywhere
     1213   do:
     1214     run diasize_change-width in this-procedure
     1215       (input -1
     1216       ,input true
     1217       ) .
     1218     return no-apply .
     1219   end.
     1220   on alt-down anywhere
     1221   do:
     1222     run diasize_change-height in this-procedure
     1223       (input 1
     1224       ,input true
     1225       ) .
     1226     return no-apply .
     1227   end.
     1228   on alt-up anywhere
     1229   do:
     1230     run diasize_change-height in this-procedure
     1231       (input -1
     1232       ,input true
     1233       ) .
     1234     return no-apply .
     1235   end.
     1236   on alt-enter of frame Dialog-Frame
     1237   do:
     1238     run diasize_maximize in this-procedure
     1239       (input  ?
     1240       ).
     1241     return no-apply .
     1242   end.
     1243   procedure diasize_end-move :
     1244     do
     1245     on error undo, return error return-value
     1246     :
     1247       define variable v-row-delta as decimal   no-undo .
     1248       define variable v-col-delta as decimal   no-undo .
     1249       define variable v-new-row as decimal   no-undo .
     1250       define variable v-new-col as decimal   no-undo .
     1251       assign
     1252         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1253         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1254       .
     1255       assign
     1256         v-row-delta = v-new-row - frame Dialog-Frame :height
     1257         v-col-delta = v-new-col - frame Dialog-Frame :width
     1258       .
     1259       run diasize_change-height in this-procedure
     1260         (input v-row-delta
     1261         ,input true
     1262         ) .
     1263       run diasize_change-width in this-procedure
     1264         (input v-col-delta
     1265         ,input true
     1266         ) .
     1267     end.
     1268   end procedure.
     1269   procedure diasize_maximize :
     1270     define input  parameter p-action as logical   no-undo .
     1271     do
     1272     on error undo, return error return-value
     1273     :
     1274       if p-action = ?
     1275       then do:
     1276         if v-diasize-need-maximize = true
     1277         then do:
     1278           assign
     1279             p-action = true
     1280           .
     1281         end.
     1282         else do:
     1283           assign
     1284             p-action = false
     1285           .
     1286         end.
     1287       end.
     1288       if p-action = true
     1289       then do:
     1290         run diasize_change-height in this-procedure
     1291           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1292               - frame Dialog-Frame :height-chars
     1293           ,input true
     1294           ) .
     1295         run diasize_change-width in this-procedure
     1296           (input session :width-chars
     1297               - frame Dialog-Frame :width-chars
     1298           ,input true
     1299           ) .
     1300         assign
     1301           v-diasize-need-maximize = false
     1302         .
     1303       end.
     1304       else do:
     1305         run diasize_change-width in this-procedure
     1306           (input v-diasize-orig-frame-width
     1307               - frame Dialog-Frame :width-chars
     1308           ,input true
     1309           ) .
     1310         run diasize_change-height in this-procedure
     1311           (input v-diasize-orig-frame-height
     1312               - frame Dialog-Frame :height-chars
     1313           ,input true
     1314           ) .
     1315         assign
     1316           v-diasize-need-maximize = true
     1317         .
     1318       end.
     1319     end.
     1320   end procedure.
     1321   procedure diasize_restore-orig-size :
     1322     do
     1323     on error undo, return error return-value
     1324     :
     1325       assign
     1326         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1327         v-diasize-current-frame-height = frame Dialog-Frame :height
     1328       .
     1329       run diasize_set-height in this-procedure
     1330         (input  v-diasize-orig-frame-height
     1331         ,input  true
     1332         ) .
     1333       run diasize_set-width in this-procedure
     1334         (input  v-diasize-orig-frame-width
     1335         ,input  true
     1336         ) .
     1337     end.
     1338   end procedure.
     1339   procedure diasize_restore-current-size :
     1340     do
     1341     on error undo, return error return-value
     1342     :
     1343       run diasize_set-height in this-procedure
     1344         (input  v-diasize-current-frame-height
     1345         ,input  true
     1346         ) .
     1347       run diasize_set-width in this-procedure
     1348         (input  v-diasize-current-frame-width
     1349         ,input  true
     1350         ) .
     1351     end.
     1352   end procedure.
     1353   procedure diasize_set-browse-handle :
     1354     define input  parameter p-browse-handle as handle   no-undo .
     1355     define buffer buf_temp-browse-handle for temp-browse-handle .
     1356     do
     1357     on error undo, return error return-value
     1358     :
     1359       assign
     1360         v-diasize-browse-handle = p-browse-handle
     1361       .
     1362       for each buf_temp-browse-handle
     1363       on error undo, return error return-value
     1364       :
     1365         delete buf_temp-browse-handle .
     1366       end.
     1367     end.
     1368   end procedure.
     1369   procedure diasize_add_browse :
     1370     define input  parameter p-browse-type   as character no-undo .
     1371     define input  parameter p-browse-handle as handle    no-undo .
     1372     define buffer buf_temp-browse-handle for temp-browse-handle .
     1373     do
     1374     on error undo, return error return-value
     1375     :
     1376       assign
     1377         v-diasize-browse-number = v-diasize-browse-number + 1
     1378       .
     1379       create buf_temp-browse-handle .
     1380       assign
     1381         buf_temp-browse-handle.browse-type   = p-browse-type
     1382         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1383         buf_temp-browse-handle.browse-handle = p-browse-handle
     1384       .
     1385     end.
     1386   end procedure.
     1387   procedure diasize_init :
     1388     define variable v-default-value    as logical   no-undo .
     1389     define variable v-restore-saved    as logical   no-undo .
     1390     define variable v-resize-value-str as character no-undo .
     1391     do
     1392     on error undo, return error return-value
     1393     :
     1394       do with frame Dialog-Frame
     1395       :
     1396         assign
     1397           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1398           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1399           v-diasize-browse-handle     = browse BR-kat :handle
     1400         .
     1401         create button v-diasize-resize-button
     1402         assign
     1403           parent        = frame Dialog-Frame :first-child
     1404           label         = "s"
     1405           height-pixels = 16
     1406           width-pixels  = 16
     1407           visible       = true
     1408           sensitive     = true
     1409           movable       = true
     1410           triggers:
     1411             on end-move persistent run diasize_end-move in this-procedure .
     1412           end triggers.
     1413         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1414         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1415         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1416         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1417         assign
     1418           v-diasize-wndmax = false
     1419         .
     1420         if connected("ub") = true
     1421         then do:
     1422           define variable v-cntxt-db-num        as integer   no-undo .
     1423           define variable v-cntxt-userid        as character no-undo .
     1424           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1425                                             , OUTPUT v-cntxt-userid
     1426                                             ) .
     1427           run gbl/wndpar_r.p
     1428             (input  v-cntxt-db-num
     1429             ,input  v-cntxt-userid
     1430             ,input  'wndmax':U
     1431             ,output v-diasize-wndmax
     1432             ,output v-default-value
     1433             ) .
     1434         end.
     1435         assign
     1436           v-diasize-wndstore = false
     1437         .
     1438         if connected("ub") = true
     1439         then do:
     1440           run gbl/wndpar_r.p
     1441             (input  v-cntxt-db-num
     1442             ,input  v-cntxt-userid
     1443             ,input  'wndstore':U
     1444             ,output v-diasize-wndstore
     1445             ,output v-default-value
     1446             ) .
     1447         end.
     1448         assign
     1449           v-diasize-proc-name = entry(1, program-name(2), '.')
     1450         .
     1451         if v-diasize-wndstore = true
     1452         then do:
     1453           assign
     1454             v-restore-saved = false
     1455           .
     1456           if connected("ub") = true
     1457           then do:
     1458             run gbl/wndsizer.p
     1459               (input  v-cntxt-db-num
     1460               ,input  v-cntxt-userid
     1461               ,input  v-diasize-proc-name
     1462               ,input  'height':u
     1463               ,output v-resize-value-str
     1464               ) .
     1465             if v-resize-value-str <> '':U
     1466             then do:
     1467               run diasize_change-height in this-procedure
     1468                 (input  integer(v-resize-value-str)
     1469                 ,input  true
     1470                 ) .
     1471               assign
     1472                 v-restore-saved = true
     1473               .
     1474             end.
     1475           end.
     1476           if connected("ub") = true
     1477           then do:
     1478             run gbl/wndsizer.p
     1479               (input  v-cntxt-db-num
     1480               ,input  v-cntxt-userid
     1481               ,input  v-diasize-proc-name
     1482               ,input  'width':u
     1483               ,output v-resize-value-str
     1484               ) .
     1485             if v-resize-value-str <> '':U
     1486             then do:
     1487               run diasize_change-width in this-procedure
     1488                 (input  integer(v-resize-value-str)
     1489                 ,input  true
     1490                 ) .
     1491               assign
     1492                 v-restore-saved = true
     1493               .
     1494             end.
     1495           end.
     1496           if v-restore-saved <> true
     1497           then do:
     1498             if v-diasize-wndmax = true
     1499             then do:
     1500               run diasize_maximize in this-procedure
     1501                 (input  true
     1502                 ) .
     1503             end.
     1504           end.
     1505         end.
     1506         else do:
     1507           if v-diasize-wndmax = true
     1508           then do:
     1509             run diasize_maximize in this-procedure
     1510               (input  true
     1511               ) .
     1512           end.
     1513         end.
     1514       end.
     1515     end.
     1516   end procedure.
     1517   procedure diasize_need-full-display :
     1518     define output parameter p-need-full-display as logical   no-undo .
     1519     do
     1520     on error undo, return error return-value
     1521     :
     1522       assign
     1523         p-need-full-display = v-diasize-need-full-display
     1524       .
     1525       assign
     1526         v-diasize-need-full-display = false
     1527       .
     1528     end.
     1529   end procedure.
     1530   procedure get-context :
     1531      define output parameter p-db-num as integer          no-undo.
     1532      define output parameter p-user-id as character        no-undo.
     1533      define variable v-login               as character    no-undo.
     1534      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1535      define buffer buf_user-login  for ub.user-login .
     1536      do
     1537      on error undo, return error
     1538      :
     1539            FIND FIRST buf_sys-ctrl no-lock.
     1540            ASSIGN
     1541               v-login = USERID("ub")
     1542               p-db-num = buf_sys-ctrl.db-num
     1543            .
     1544            FIND FIRST buf_user-login
     1545                 WHERE buf_user-login.db-num = p-db-num
     1546                   AND buf_user-login.user-login = v-login
     1547                 no-lock
     1548                 no-error
     1549                 .
     1550            IF AVAILABLE buf_user-login
     1551            THEN DO:
     1552               assign
     1553                  p-user-id = buf_user-login.user-id
     1554               .
     1555            END.
     1556      end.
     1557   end procedure.
     1558       run diasize_init in this-procedure .
     1559   MAIN-BLOCK:
     1560   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1561      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1562      run fill-table in this-procedure.
     1563     RUN enable_UI.
     1564     WAIT-FOR GO OF FRAME Dialog-Frame.
     1565   END.
     1566   RUN disable_UI.
     1567   PROCEDURE disable_UI :
     1568     HIDE FRAME Dialog-Frame.
     1569   END PROCEDURE.
     1570   PROCEDURE enable_UI :
     1571     DISPLAY v-tare-id
     1572         WITH FRAME Dialog-Frame.
     1573     ENABLE b-quit B-exit B-Help v-tare-id BR-kat B-add B-del
     1574         WITH FRAME Dialog-Frame.
     1575     VIEW FRAME Dialog-Frame.
     1576     OPEN QUERY BR-kat FOR EACH temp-tare.
     1577   END PROCEDURE.
     1578   PROCEDURE fill-table :
     1579   define variable dops as character no-undo.
     1580   define variable dopst as character no-undo.
     1581   define variable v-host-code like ub.sysconf.host-code no-undo.
     1582   define variable ii as integer no-undo.
     1583   define variable v-tare-id as integer no-undo.
     1584   define variable v-weight as decimal no-undo.
     1585   define variable v-dop as character no-undo.
     1586   for each temp-tare:
     1587       delete temp-tare.
     1588   end.
     1589   if p-value = "":U then do:
     1590     do ii = 1 to 16:
     1591       create temp-tare.
     1592       assign
     1593       temp-tare.tare-id = ii
     1594       temp-tare.weight = 0
     1595       .
     1596     end.
     1597   end.
     1598   if p-value <> "":U then dops = p-value.
     1599   do ii = 1 to num-entries(dops, ";":U):
     1600       assign
     1601       v-dop = entry(ii, dops, ";":U)
     1602       v-tare-id = 0
     1603       v-tare-id = integer(entry(1, v-dop, "=":U))
     1604       v-weight = 0
     1605       v-weight =  decimal(entry(2, v-dop, "=":U))
     1606       no-error
     1607       .
     1608       if error-status:error then do:
     1609       end.
     1610       else do:
     1611           create temp-tare.
     1612           assign
     1613           temp-tare.tare-id = v-tare-id
     1614           temp-tare.weight = v-weight
     1615           .
     1616       end.
     1617   end.
     1618   END PROCEDURE.
     1619   PROCEDURE fill-table-zero :
     1620   define variable ii as integer no-undo.
     1621   do ii = 1 to 10:
     1622     create temp-tare.
     1623       assign
     1624       temp-tare.tare-id = ii
     1625       temp-tare.weight = 0
     1626       .
     1627   end.
     1628   END PROCEDURE.
     1629   PROCEDURE proc-go :
     1630   define variable v-value as character no-undo.
     1631   define variable v-dop as character no-undo.
     1632   define variable ii as integer no-undo.
     1633   for each temp-tare no-lock:
     1634     assign
     1635     v-dop = string(temp-tare.tare-id) + "=":U + string(temp-tare.weight)
     1636     v-value = v-value + (if v-value = "":U then "":U else ";":U) + v-dop
     1637     .
     1638     ii = ii + 1 .
     1639   end.
     1640   if ii > 16 then  do:
     1641     message
     1642     "Нельзя задать более 16 соответствий"
     1643     view-as alert-box error .
     1644     return error.
     1645   end.
     1646   assign
     1647   p-value = v-value.
     1648   END PROCEDURE.
