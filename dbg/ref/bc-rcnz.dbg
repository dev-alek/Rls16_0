      777   end procedure.
      778   procedure diasize_set-height :
      779     define input  parameter p-new-height  as decimal   no-undo .
      780     define input  parameter p-move-resize as logical   no-undo .
      781     do
      782     on error undo, return error return-value
      783     :
      784       run diasize_change-height in this-procedure
      785         (input  (p-new-height - frame b-bc-rcnz :height)
      786         ,input  p-move-resize
      787         ) .
      788     end.
      789   end procedure.
      790   procedure diasize_change-width :
      791     define input  parameter p-change-value as decimal   no-undo .
      792     define input  parameter p-move-resize  as logical   no-undo .
      793     define variable v-field-group-handle   as handle    no-undo .
      794     define variable v-object-handle        as handle    no-undo .
