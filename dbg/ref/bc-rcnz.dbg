      602             then do:
      603             end.
      604             else do:
      605               create buf_temp-diasize-handle .
      606               assign
      607                 buf_temp-diasize-handle.handle-value  = v-object-handle
      608                 buf_temp-diasize-handle.save-position = v-object-handle :row
      609               .
      610             end.
      611           end.
      612           assign
      613             v-object-handle = v-object-handle :next-sibling
      614           .
      615         end.
      616         assign
      617           v-field-group-handle = v-field-group-handle :next-sibling
      618         .
      619       end.
      620       do with frame b-bc-rcnz
      621       :
      622         hide v-diasize-resize-button .
      623         assign
      624           v-diasize-resize-button :row    = 1
      625           v-diasize-resize-button :column = 1
      626         .
      627       end.
      628       if p-change-value > 0
      629       then do:
      630         if frame b-bc-rcnz :scrollable = true
      631         then do:
      632           assign
      633             frame b-bc-rcnz :virtual-height = frame b-bc-rcnz :virtual-height + p-change-value
      634             no-error .
      635           if error-status :error
      636           or error-status :get-message(1) <> ""
      637           then do:
      638             undo move_block, retry move_block .
      639           end.
      640         end.
      641         assign
      642           frame b-bc-rcnz :height = frame b-bc-rcnz :height + p-change-value
      643           no-error .
