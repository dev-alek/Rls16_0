     1154             ,input  v-diasize-proc-name
     1155             ,input  'width':u
     1156             ,input  string(frame b-bc-rcnz :width - v-diasize-orig-frame-width)
     1157             ) .
     1158         end.
     1159       end.
     1160     end.
     1161     assign
     1162       v-diasize-change-size = false
     1163     .
     1164   end procedure.
     1165   procedure diasize_set-width :
     1166     define input  parameter p-new-width  as decimal   no-undo .
     1167     define input  parameter p-move-resize as logical   no-undo .
     1168     do
     1169     on error undo, return error return-value
     1170     :
     1171       run diasize_change-width in this-procedure
     1172         (input  (p-new-width - frame b-bc-rcnz :width)
     1173         ,input  p-move-resize
     1174         ) .
     1175     end.
     1176   end procedure.
     1177   procedure diasize_position-resize-button :
     1178     do with frame b-bc-rcnz
     1179     :
     1180       hide v-diasize-resize-button .
     1181       assign
     1182         v-diasize-resize-button :row = frame b-bc-rcnz :height - v-diasize-resize-button :height
     1183                     - 1
     1184                     - (frame b-bc-rcnz :border-bottom-pixels / session :pixels-per-row)
     1185         v-diasize-resize-button :col = frame b-bc-rcnz :width - v-diasize-resize-button :width
     1186                     - 1
     1187                     - (frame b-bc-rcnz :border-right-pixels / session :pixels-per-column)
     1188       .
     1189       view v-diasize-resize-button .
     1190     end.
     1191   end procedure.
     1192   on alt-right anywhere
     1193   do:
     1194     run diasize_change-width in this-procedure
     1195       (input 1
     1196       ,input true
     1197       ) .
     1198     return no-apply .
     1199   end.
     1200   on alt-left anywhere
     1201   do:
     1202     run diasize_change-width in this-procedure
     1203       (input -1
     1204       ,input true
     1205       ) .
     1206     return no-apply .
     1207   end.
     1208   on alt-down anywhere
     1209   do:
     1210     run diasize_change-height in this-procedure
     1211       (input 1
     1212       ,input true
     1213       ) .
     1214     return no-apply .
     1215   end.
     1216   on alt-up anywhere
     1217   do:
     1218     run diasize_change-height in this-procedure
     1219       (input -1
     1220       ,input true
     1221       ) .
     1222     return no-apply .
     1223   end.
     1224   on alt-enter of frame b-bc-rcnz
     1225   do:
     1226     run diasize_maximize in this-procedure
     1227       (input  ?
     1228       ).
     1229     return no-apply .
     1230   end.
     1231   procedure diasize_end-move :
     1232     do
     1233     on error undo, return error return-value
     1234     :
     1235       define variable v-row-delta as decimal   no-undo .
     1236       define variable v-col-delta as decimal   no-undo .
     1237       define variable v-new-row as decimal   no-undo .
     1238       define variable v-new-col as decimal   no-undo .
     1239       assign
     1240         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1241         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1242       .
     1243       assign
     1244         v-row-delta = v-new-row - frame b-bc-rcnz :height
     1245         v-col-delta = v-new-col - frame b-bc-rcnz :width
     1246       .
     1247       run diasize_change-height in this-procedure
     1248         (input v-row-delta
     1249         ,input true
     1250         ) .
     1251       run diasize_change-width in this-procedure
     1252         (input v-col-delta
     1253         ,input true
     1254         ) .
     1255     end.
     1256   end procedure.
     1257   procedure diasize_maximize :
     1258     define input  parameter p-action as logical   no-undo .
     1259     do
     1260     on error undo, return error return-value
     1261     :
     1262       if p-action = ?
     1263       then do:
     1264         if v-diasize-need-maximize = true
     1265         then do:
     1266           assign
     1267             p-action = true
     1268           .
     1269         end.
     1270         else do:
     1271           assign
     1272             p-action = false
     1273           .
     1274         end.
     1275       end.
     1276       if p-action = true
     1277       then do:
     1278         run diasize_change-height in this-procedure
     1279           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1280               - frame b-bc-rcnz :height-chars
     1281           ,input true
     1282           ) .
     1283         run diasize_change-width in this-procedure
     1284           (input session :width-chars
     1285               - frame b-bc-rcnz :width-chars
     1286           ,input true
     1287           ) .
     1288         assign
     1289           v-diasize-need-maximize = false
     1290         .
     1291       end.
     1292       else do:
     1293         run diasize_change-width in this-procedure
     1294           (input v-diasize-orig-frame-width
     1295               - frame b-bc-rcnz :width-chars
     1296           ,input true
     1297           ) .
     1298         run diasize_change-height in this-procedure
     1299           (input v-diasize-orig-frame-height
     1300               - frame b-bc-rcnz :height-chars
     1301           ,input true
     1302           ) .
     1303         assign
     1304           v-diasize-need-maximize = true
     1305         .
     1306       end.
     1307     end.
     1308   end procedure.
     1309   procedure diasize_restore-orig-size :
     1310     do
     1311     on error undo, return error return-value
     1312     :
     1313       assign
     1314         v-diasize-current-frame-width  = frame b-bc-rcnz :width
     1315         v-diasize-current-frame-height = frame b-bc-rcnz :height
     1316       .
     1317       run diasize_set-height in this-procedure
     1318         (input  v-diasize-orig-frame-height
     1319         ,input  true
     1320         ) .
     1321       run diasize_set-width in this-procedure
     1322         (input  v-diasize-orig-frame-width
     1323         ,input  true
     1324         ) .
     1325     end.
     1326   end procedure.
     1327   procedure diasize_restore-current-size :
     1328     do
     1329     on error undo, return error return-value
     1330     :
     1331       run diasize_set-height in this-procedure
     1332         (input  v-diasize-current-frame-height
     1333         ,input  true
     1334         ) .
     1335       run diasize_set-width in this-procedure
     1336         (input  v-diasize-current-frame-width
     1337         ,input  true
     1338         ) .
     1339     end.
     1340   end procedure.
     1341   procedure diasize_set-browse-handle :
     1342     define input  parameter p-browse-handle as handle   no-undo .
     1343     define buffer buf_temp-browse-handle for temp-browse-handle .
     1344     do
     1345     on error undo, return error return-value
     1346     :
     1347       assign
     1348         v-diasize-browse-handle = p-browse-handle
     1349       .
     1350       for each buf_temp-browse-handle
     1351       on error undo, return error return-value
     1352       :
     1353         delete buf_temp-browse-handle .
     1354       end.
     1355     end.
     1356   end procedure.
     1357   procedure diasize_add_browse :
     1358     define input  parameter p-browse-type   as character no-undo .
     1359     define input  parameter p-browse-handle as handle    no-undo .
     1360     define buffer buf_temp-browse-handle for temp-browse-handle .
     1361     do
     1362     on error undo, return error return-value
     1363     :
     1364       assign
     1365         v-diasize-browse-number = v-diasize-browse-number + 1
     1366       .
     1367       create buf_temp-browse-handle .
     1368       assign
     1369         buf_temp-browse-handle.browse-type   = p-browse-type
     1370         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1371         buf_temp-browse-handle.browse-handle = p-browse-handle
     1372       .
     1373     end.
     1374   end procedure.
     1375   procedure diasize_init :
     1376     define variable v-default-value    as logical   no-undo .
     1377     define variable v-restore-saved    as logical   no-undo .
     1378     define variable v-resize-value-str as character no-undo .
     1379     do
     1380     on error undo, return error return-value
     1381     :
     1382       do with frame b-bc-rcnz
     1383       :
     1384         assign
     1385           v-diasize-orig-frame-height = frame b-bc-rcnz :height
     1386           v-diasize-orig-frame-width  = frame b-bc-rcnz :width
     1387           v-diasize-browse-handle     = browse br-dpl :handle
     1388         .
     1389         create button v-diasize-resize-button
     1390         assign
     1391           parent        = frame b-bc-rcnz :first-child
     1392           label         = "s"
     1393           height-pixels = 16
     1394           width-pixels  = 16
     1395           visible       = true
     1396           sensitive     = true
     1397           movable       = true
     1398           triggers:
     1399             on end-move persistent run diasize_end-move in this-procedure .
     1400           end triggers.
     1401         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1402         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1403         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1404         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1405         assign
     1406           v-diasize-wndmax = false
     1407         .
     1408         if connected("ub") = true
     1409         then do:
     1410           define variable v-cntxt-db-num        as integer   no-undo .
     1411           define variable v-cntxt-userid        as character no-undo .
     1412           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1413                                             , OUTPUT v-cntxt-userid
     1414                                             ) .
     1415           run gbl/wndpar_r.p
     1416             (input  v-cntxt-db-num
     1417             ,input  v-cntxt-userid
     1418             ,input  'wndmax':U
     1419             ,output v-diasize-wndmax
     1420             ,output v-default-value
     1421             ) .
     1422         end.
     1423         assign
     1424           v-diasize-wndstore = false
     1425         .
     1426         if connected("ub") = true
     1427         then do:
     1428           run gbl/wndpar_r.p
     1429             (input  v-cntxt-db-num
     1430             ,input  v-cntxt-userid
     1431             ,input  'wndstore':U
     1432             ,output v-diasize-wndstore
     1433             ,output v-default-value
     1434             ) .
     1435         end.
     1436         assign
     1437           v-diasize-proc-name = entry(1, program-name(2), '.')
     1438         .
     1439         if v-diasize-wndstore = true
     1440         then do:
     1441           assign
     1442             v-restore-saved = false
     1443           .
     1444           if connected("ub") = true
     1445           then do:
     1446             run gbl/wndsizer.p
     1447               (input  v-cntxt-db-num
     1448               ,input  v-cntxt-userid
     1449               ,input  v-diasize-proc-name
     1450               ,input  'height':u
     1451               ,output v-resize-value-str
     1452               ) .
     1453             if v-resize-value-str <> '':U
     1454             then do:
     1455               run diasize_change-height in this-procedure
     1456                 (input  integer(v-resize-value-str)
     1457                 ,input  true
     1458                 ) .
     1459               assign
     1460                 v-restore-saved = true
     1461               .
     1462             end.
     1463           end.
     1464           if connected("ub") = true
     1465           then do:
     1466             run gbl/wndsizer.p
     1467               (input  v-cntxt-db-num
     1468               ,input  v-cntxt-userid
     1469               ,input  v-diasize-proc-name
     1470               ,input  'width':u
     1471               ,output v-resize-value-str
     1472               ) .
     1473             if v-resize-value-str <> '':U
     1474             then do:
     1475               run diasize_change-width in this-procedure
     1476                 (input  integer(v-resize-value-str)
     1477                 ,input  true
     1478                 ) .
     1479               assign
     1480                 v-restore-saved = true
     1481               .
     1482             end.
     1483           end.
     1484           if v-restore-saved <> true
     1485           then do:
     1486             if v-diasize-wndmax = true
     1487             then do:
     1488               run diasize_maximize in this-procedure
     1489                 (input  true
     1490                 ) .
     1491             end.
     1492           end.
     1493         end.
     1494         else do:
     1495           if v-diasize-wndmax = true
     1496           then do:
     1497             run diasize_maximize in this-procedure
     1498               (input  true
     1499               ) .
     1500           end.
     1501         end.
     1502       end.
     1503     end.
     1504   end procedure.
     1505   procedure diasize_need-full-display :
     1506     define output parameter p-need-full-display as logical   no-undo .
     1507     do
     1508     on error undo, return error return-value
     1509     :
     1510       assign
     1511         p-need-full-display = v-diasize-need-full-display
     1512       .
     1513       assign
     1514         v-diasize-need-full-display = false
     1515       .
     1516     end.
     1517   end procedure.
     1518   procedure get-context :
     1519      define output parameter p-db-num as integer          no-undo.
     1520      define output parameter p-user-id as character        no-undo.
     1521      define variable v-login               as character    no-undo.
     1522      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1523      define buffer buf_user-login  for ub.user-login .
     1524      do
     1525      on error undo, return error
     1526      :
     1527            FIND FIRST buf_sys-ctrl no-lock.
     1528            ASSIGN
     1529               v-login = USERID("ub")
     1530               p-db-num = buf_sys-ctrl.db-num
     1531            .
     1532            FIND FIRST buf_user-login
     1533                 WHERE buf_user-login.db-num = p-db-num
     1534                   AND buf_user-login.user-login = v-login
     1535                 no-lock
     1536                 no-error
     1537                 .
     1538            IF AVAILABLE buf_user-login
     1539            THEN DO:
     1540               assign
     1541                  p-user-id = buf_user-login.user-id
     1542               .
     1543            END.
     1544      end.
     1545   end procedure.
     1546       run diasize_init in this-procedure .
     1547   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1548   do:
     1549     br-dpl :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1550   end.
     1551   on find of ub.bar-code do:
     1552     find ub.gds-obj where ub.gds-obj.obj-type  = p-curr-obj-type
     1553                    and ub.gds-obj.obj-code  = p-curr-obj-code
     1554                    and ub.gds-obj.gds-code  = ub.bar-code.gds-code
     1555                    no-lock no-error.
     1556     if available ub.gds-obj then
     1557       gds-price  = ub.gds-obj.price-sale.
     1558     else
     1559       gds-price = 0.
     1560   end.
     1561   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME b-bc-rcnz:PARENT eq ?
     1562   THEN FRAME b-bc-rcnz:PARENT = ACTIVE-WINDOW.
     1563   MAIN-BLOCK:
     1564   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1565      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1566     duplicate-str = d-str.
     1567     RUN enable_UI.
     1568     if c-point <> 'ИЗМЕНЕНИЕ':U then
     1569       disable b-on with frame b-bc-rcnz.
     1570     if c-point <> "choose" then do:
     1571       b-sel:sensitive = no.
     1572     end.
     1573     if r-price <> ? and
     1574        r-price <> 0 then do:
     1575       find ub.prod-bc where recid (ub.prod-bc) = rid no-lock.
     1576       if not ub.prod-bc.bc-on then do:
     1577         rid = ?.
     1578         return.
     1579       end.
     1580       run get-bc-price  in parparentproc (output v-bc-price) no-error .
     1581       if v-bc-price then do:
     1582         find ub.bar-code where
     1583              ub.bar-code.b-code = ub.prod-bc.b-code no-lock.
     1584         find ub.gds-obj where ub.gds-obj.obj-type = p-curr-obj-type
     1585                        and ub.gds-obj.obj-code = p-curr-obj-code
     1586                        and ub.gds-obj.gds-code = ub.bar-code.gds-code
     1587                        no-lock no-error.
     1588         if available ub.gds-obj and
     1589            ub.gds-obj.price-sale = r-price and
     1590            ub.prod-bc.bc-on then
     1591           return.
     1592       end.
     1593       else
     1594         if ub.prod-bc.bc-on then return.
     1595       req-price = r-price.
     1596       disp req-price with frame b-bc-rcnz.
     1597     end.
     1598     else hide req-price in frame b-bc-rcnz.
     1599     assign ub.goods.gds-name:resizable in browse br-dpl = yes
     1600            ub.goods.gds-name:width-chars in browse br-dpl = 35  .
     1601     apply "value-changed" to br-dpl in frame b-bc-rcnz.
     1602     reposition br-dpl to recid rid no-error.
     1603     WAIT-FOR GO OF FRAME b-bc-rcnz focus br-dpl.
     1604   END.
     1605   RUN disable_UI.
     1606   PROCEDURE disable_UI :
     1607     HIDE FRAME b-bc-rcnz.
     1608   END PROCEDURE.
     1609   PROCEDURE enable_UI :
     1610     DISPLAY duplicate-str
     1611         WITH FRAME b-bc-rcnz.
     1612     IF AVAILABLE ub.gds-prt THEN
     1613       DISPLAY ub.gds-prt.f-name
     1614         WITH FRAME b-bc-rcnz.
     1615     IF AVAILABLE ub.parts THEN
     1616       DISPLAY ub.parts.part-code ub.parts.in-code
     1617         WITH FRAME b-bc-rcnz.
     1618     ENABLE b-quit b-sel b-on b-help br-dpl
     1619         WITH FRAME b-bc-rcnz.
     1620     VIEW FRAME b-bc-rcnz.
     1621     OPEN QUERY br-dpl FOR EACH ub.prod-bc       WHERE prod-bc.b-str = duplicate-str NO-LOCK,       EACH ub.bar-code OF ub.prod-bc NO-LOCK,       EACH ub.goods OF ub.bar-code NO-LOCK     BY ub.goods.artic.
     1622   END PROCEDURE.
