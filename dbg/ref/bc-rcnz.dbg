      800     define variable v-change-sign          as integer   no-undo .
      801     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      802     define buffer buf_temp-browse-handle  for temp-browse-handle .
      803     if p-change-value > 0
      804     then do:
      805       if frame b-bc-rcnz :width + p-change-value >
      806           session :width-chars
      807       then do:
      808         assign
      809           p-change-value = session :width-chars - frame b-bc-rcnz :width
      810         .
      811         if p-change-value <= 0
      812         then do:
      813           run diasize_position-resize-button in this-procedure .
      814           return .
      815         end.
      816       end.
      817     end.
      818     if p-change-value < 0
      819     then do:
      820       if frame b-bc-rcnz :width + p-change-value < v-diasize-orig-frame-width
      821       then do:
      822         assign
      823           p-change-value = v-diasize-orig-frame-width
      824                          - frame b-bc-rcnz :width
      825         .
      826         if p-change-value >= 0
      827         then do:
      828           run diasize_position-resize-button in this-procedure .
      829           return .
      830         end.
      831       end.
      832     end.
      833     if p-change-value >= 0
      834     then do:
      835       assign
      836         v-change-sign = 1
      837       .
      838     end.
      839     else do:
      840       assign
      841         v-change-sign = -1
      842       .
      843     end.
      844     assign
      845       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      846     .
      847     if p-change-value = 0
      848     then do:
      849       run diasize_position-resize-button in this-procedure .
      850       return .
      851     end.
