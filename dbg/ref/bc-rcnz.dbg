        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define input param d-str as char no-undo.
        5   define input param r-price as decimal no-undo.
        6   define input param c-point as char no-undo.
        7   define input-output param rid as recid no-undo.
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   procedure proc-alt-shift-f2:
       13     if not ibs.th.gbl.gbl-var:rcode
       14   then
       15     run gbl\inidebug.p .
       16   end.
       17   procedure proc-alt-shift-f3:
       18     run gbl/prvssinf.p
       19       ( input this-procedure
       20       ) .
       21   end.
       22   define variable v-inform-launched as logical no-undo initial false .
       23   procedure proc-alt-shift-f4:
       24     define variable v-action as character no-undo .
       25     if v-inform-launched = false then do:
       26       assign
       27         v-inform-launched = true
       28       .
       29       run gbl/d-inform.w
       30         (  input self
       31         ,  input this-procedure
       32         , output v-action
       33         ) no-error .
       34       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       35       assign
       36         v-inform-launched = false
       37       .
       38     end.
       39   end.
       40   procedure proc-alt-f1:
       41     run gbl/corrhelp.p
       42       (input this-procedure
       43       ) .
       44   end .
       45   on alt-shift-f2 anywhere do:
       46     run proc-alt-shift-f2.
       47   end.
       48   on alt-shift-f3 anywhere do:
       49     run proc-alt-shift-f3 in this-procedure .
       50   end.
       51   on alt-shift-f4 anywhere do:
       52     run proc-alt-shift-f4 in this-procedure.
       53   end.
       54   on alt-f1 anywhere do:
       55     run proc-alt-f1 in this-procedure .
       56   end.
       57   define new global shared variable g#library  as handle no-undo .
       58   define new global shared variable g#library2 as handle no-undo .
       59   define variable gds-price as decimal no-undo.
       60   define variable v-bc-price as logical no-undo .
