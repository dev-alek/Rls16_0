      594           and can-query(v-object-handle, "height")
      595           and ( v-object-handle :row > v-diasize-browse-handle :row )
      596           then do:
      597             find first buf_temp-browse-handle
      598               where buf_temp-browse-handle.browse-type   = 'height':u
      599                 and buf_temp-browse-handle.browse-handle = v-object-handle
      600               no-error .
