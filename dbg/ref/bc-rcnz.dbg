       87   DEFINE BUTTON b-help
       88        LABEL "Помо&щь"
       89        SIZE 10 BY 1
       90        BGCOLOR 8 .
       91   DEFINE BUTTON b-on
       92        LABEL "&Вкл/выкл"
       93        SIZE 10 BY 1.
       94   DEFINE BUTTON b-quit AUTO-END-KEY
       95        LABEL "&Выход"
       96        SIZE 10 BY 1
       97        BGCOLOR 8 .
       98   DEFINE BUTTON b-sel AUTO-GO
       99        LABEL "Вы&бор "
      100        SIZE 10 BY 1
      101        BGCOLOR 8 .
      102   DEFINE VARIABLE duplicate-str AS CHARACTER FORMAT "X(40)":U
      103        LABEL "Бар-код"
      104        VIEW-AS FILL-IN
      105        SIZE 41.5 BY 1
      106        FGCOLOR 4  NO-UNDO.
      107   DEFINE VARIABLE req-price AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL 0
      108        LABEL "Цена"
      109        VIEW-AS FILL-IN
      110        SIZE 24.25 BY 1 NO-UNDO.
      111   DEFINE QUERY br-dpl FOR
      112         ub.prod-bc,
      113         ub.bar-code,
      114         ub.goods SCROLLING.
      115   DEFINE BROWSE br-dpl
      116     QUERY br-dpl NO-LOCK DISPLAY
      117         ub.prod-bc.bc-on FORMAT "+/":U
      118         ub.goods.artic FORMAT "X(16)":U
      119         ub.goods.gds-name
      120         gds-price COLUMN-LABEL "Цена" FORMAT "->>>,>>>,>>>.<<":U
      121         ub.goods.engl-name FORMAT "X(40)":U
      122       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.75 BY 9.21.
      123   DEFINE FRAME b-bc-rcnz
      124        b-quit AT ROW 1 COL 1
      125        b-sel AT ROW 1 COL 11
      126        b-on AT ROW 1 COL 21
      127        b-help AT ROW 1 COL 31
      128        duplicate-str AT ROW 2.25 COL 10 COLON-ALIGNED
      129        req-price AT ROW 3.5 COL 10 COLON-ALIGNED
      130        br-dpl AT ROW 5.29 COL 2.88
      131        ub.gds-prt.f-name AT ROW 14.63 COL 60.38 COLON-ALIGNED
      132             VIEW-AS FILL-IN
      133             SIZE 16 BY 1
      134             FGCOLOR 4
      135        ub.parts.part-code AT ROW 14.67 COL 10.25 COLON-ALIGNED
      136             LABEL "Партия"
      137             VIEW-AS FILL-IN
      138             SIZE 25.75 BY 1
      139             FGCOLOR 4
      140        ub.parts.in-code AT ROW 15.71 COL 10.25 COLON-ALIGNED
      141             LABEL "Номер ПН"
      142             VIEW-AS FILL-IN
      143             SIZE 25.75 BY 1
      144             FGCOLOR 4
      145        SPACE(45.48) SKIP(0.82)
      146       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      147            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      148            TITLE "Повторные дополнительные бар-коды"
      149            DEFAULT-BUTTON b-sel.
      150   ASSIGN
      151          FRAME b-bc-rcnz:SCROLLABLE       = FALSE
      152          FRAME b-bc-rcnz:HIDDEN           = TRUE.
      153   ASSIGN
      154          br-dpl:NUM-LOCKED-COLUMNS IN FRAME b-bc-rcnz     = 2.
      155   ON WINDOW-CLOSE OF FRAME b-bc-rcnz
      156   DO:
      157     rid = ?.
      158     APPLY "END-ERROR":U TO SELF.
      159   END.
      160   ON CHOOSE OF b-on IN FRAME b-bc-rcnz
      161   DO:
      162   define variable glog as logical no-undo .
      163   define variable v-rep-rec as recid no-undo .
      164   define variable l-prod-bc-pgweight as logical no-undo .
      165   define buffer prod-on for ub.prod-bc.
      166   define buffer bc-on   for ub.bar-code.
      167     if not available ub.prod-bc then do:
      168       message "Неправильно выбран дополнительный бар-код.".
      169       return no-apply.
      170     end.
      171     find ub.units where ub.units.unit-name = ub.bar-code.unit-cli no-lock.
      172     if lookup('вес':U, ub.units.type) > 0 then do:
      173       message "Нельзя выключить весовой код.".
      174       return no-apply.
      175     end.
      176     if lookup('шту':U, ub.units.type) > 0 then do:
      177   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
      179     (buffer prod-on
      180     ,input  'pgweight=request':u
      181     ,output l-prod-bc-pgweight
      182     ) no-error .
      183         if error-status:error then return no-apply.
      184         if l-prod-bc-pgweight then do:
      185           message "Нельзя выключить штучный код для весов.".
      186           return no-apply.
      187         end.
      188     end.
      189     define variable v-current-db-num as integer no-undo .
      190     define variable v-current-userid as character no-undo .
      191     run get-db-num in parparentproc ( output v-current-db-num).
      192     run get-userid in parparentproc ( output v-current-userid).
      193   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      194   do:
      195     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      196       (input  v-current-db-num
      197       ,input  v-current-userid
      198       ,input  0
      199       ,input  'actn_alt-barcode_turn-on':U
      200       ,input  'global':U
      201       ,input  0
      202       ,input  '':U
      203       ,input  0
      204       ,input  0
      205       ,input  ub.goods.grp-code
      206       ,input  0
      207       ,input  true
      208       ,output glog
      209       )  .
      210   end.
      211     if not glog then return no-apply.
      212     v-rep-rec = recid(prod-bc).
      213     run trg/bc-upd.p (
      214                   input parparentproc
      215                  ,input prod-bc.b-code
      216                  ,input prod-bc.b-str
      217                  ,input (NOT prod-bc.bc-on)
      218                  ,input no
      219                  ,input send-ref
      220                  ,input ?
      221                  ,input ?
      222                  ) no-error  .
      223     if error-status:error then do:
      224       if return-value <> "":U then do:
      225         message
      226         return-value
      227         view-as alert-box .
      228       end.
      229       return no-apply.
      230     end.
      231     run enable_ui.
      232     apply "entry" to br-dpl in frame b-bc-rcnz.
      233     reposition br-dpl to recid v-rep-rec no-error.
      234   END.
      235   ON CHOOSE OF b-quit IN FRAME b-bc-rcnz
      236   DO:
      237     rid = ?.
      238   END.
      239   ON CHOOSE OF b-sel IN FRAME b-bc-rcnz
      240   DO:
      241     if c-point = "choose" then rid = recid (ub.prod-bc).
      242   END.
      243   ON MOUSE-SELECT-DBLCLICK OF br-dpl IN FRAME b-bc-rcnz
      244   DO:
      245     apply "choose" to b-sel in frame b-bc-rcnz.
      246     return no-apply.
      247   END.
      248   ON RETURN OF br-dpl IN FRAME b-bc-rcnz
      249   DO:
      250     apply "choose" to b-sel in frame b-bc-rcnz.
      251     return no-apply.
      252   END.
      253   ON VALUE-CHANGED OF br-dpl IN FRAME b-bc-rcnz
      254   DO:
      255   find first ub.parts where
      256              ub.parts.artic     = ub.goods.artic and
      257              ub.parts.prod-type = ub.goods.prod-type and
      258              ub.parts.prod-code = ub.goods.prod-code and
      259              ub.parts.part-code = ub.bar-code.part-code and
      260              ub.parts.in-code   = ub.bar-code.in-code no-lock no-error.
      261   if available ub.parts then
      262     disp ub.parts.part-code ub.parts.in-code with frame b-bc-rcnz.
      263   else
      264     disp "" @ ub.parts.part-code "" @ ub.parts.in-code with frame b-bc-rcnz.
      265   find ub.gds-prt where
      266        ub.bar-code.node-code = ub.gds-prt.node-code no-lock.
      267   disp ub.gds-prt.f-name with frame b-bc-rcnz.
      268   END.
      269   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      270   on help of frame b-bc-rcnz
      271   do:
      272     run gbl/app_help.p
      273       (input this-procedure :file-name
      274       ,input ''
      275       ,input ?
      276       ) no-error.
      277     if error-status :error then do:
      278       message
      279         "Ошибка при вызове помощи"
      280         error-status :get-message(1)
      281         view-as alert-box .
      282     end.
      283   end.
      284   run minbtn-set in this-procedure .
      285   on choose of b-help in frame b-bc-rcnz
      286   do:
      287     apply "help":u to frame b-bc-rcnz .
      288   end.
      289   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      290   procedure minbtn-set :
      291       do
      292           on error undo, return error return-value
      293           :
      294           define variable ii              as integer       no-undo .
      295           define variable fh              as widget-handle no-undo .
      296           define variable hh              as widget-handle no-undo .
      297           define variable v-h             as handle        extent 4 no-undo .
      298           define variable v-name-button   as character     no-undo .
      299           define variable v-help-old-x    as decimal       no-undo .
      300           define variable v-help-old-y    as decimal       no-undo .
      301           define variable v-help-old-size as decimal       no-undo .
      302           define variable v-frame-width   as decimal       no-undo .
      303           define variable jj              as integer       no-undo .
      304           do
      305               on error undo, return error
      306               :
      307               assign
      308                   v-frame-width = frame b-bc-rcnz:width - 0.3
      309                   fh            = frame b-bc-rcnz:first-child
      310                   hh            = fh:first-child
      311                   ii            = 1
      312                   .
      313               do while valid-handle(hh):
      314                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      315                   do:
      316                       case lc(hh:name) :
      317                           when "b-help" then
      318                               do:
      319                                   hh:load-image-up("cmp/b-help.bmp":u) .
      320                                   hh:load-image-down("cmp/b-help.bmp":u) .
      321                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      322                                   hh:TOOLTIP = "Помощь" .
      323                                   v-help-old-x = hh:column .
      324                                   v-help-old-y = hh:row    .
      325                                   v-help-old-size = hh:width .
      326                                   hh:width-chars = 2.5 .
      327                               end.
      328                           when "b-print" then
      329                               do:
      330                                   hh:load-image("cmp/b-print.bmp":u) .
      331                                   hh:TOOLTIP = "Печать" .
      332                                   v-h[ii] = hh:handle .
      333                                   ii = ii + 1 .
      334                                   hh:width-chars = 3 .
      335                               end.
      336                           when "b-history" or
      337                           when "b-hist" then
      338                               do:
      339                                   hh:load-image("cmp/b-hist.bmp":u) .
      340                                   hh:TOOLTIP = "История" .
      341                                   v-h[ii] = hh:handle .
      342                                   ii = ii + 1 .
      343                                   hh:width-chars = 3 .
      344                               end.
      345                           when "b-sch" then
      346                               do:
      347                                   hh:load-image("cmp/b-sch.bmp":u) .
      348                                   hh:TOOLTIP = "Установка Фильтра" .
      349                                   v-h[ii] = hh:handle .
      350                                   ii = ii + 1 .
      351                                   hh:width-chars = 3 .
      352                               end.
      353                           when "b-hist-user" then
      354                               do:
      355                                   hh:load-image("cmp/b-hist.bmp":u) .
      356                                   hh:TOOLTIP = "История пользователя" .
      357                                   ii = ii + 1 .
      358                               end.
      359                       end case.
      360                   end.
      361                   hh = hh:next-sibling.
      362               end.
      363               b-help:column = v-frame-width - b-help:width-chars.
      364               jj = 0.
      365               repeat ii = 4 to 1 by -1 :
      366                   if valid-handle (v-h[ii] ) then
      367                   do:
      368                       jj  = jj + 1 .
      369                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      370                       v-h[ii]:row    = v-help-old-y .
      371                   end.
      372               end.
      373           end.
      374       end.
      375   end procedure.
      376   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      377   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      378   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      379   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      380   define variable v-diasize-current-frame-width  as decimal   no-undo .
      381   define variable v-diasize-current-frame-height as decimal   no-undo .
      382   define variable v-diasize-change-size          as logical   no-undo .
      383   define variable v-diasize-resize-button        as handle    no-undo .
      384   define variable v-diasize-wndmax               as logical   no-undo .
      385   define variable v-diasize-wndstore             as logical   no-undo .
      386   define variable v-diasize-proc-name            as character no-undo .
      387   define variable v-diasize-browse-handle        as handle    no-undo .
      388   define variable v-diasize-browse-number        as integer   no-undo .
      389   define variable v-diasize-need-full-display    as logical   no-undo init false .
      390   define temp-table temp-diasize-handle no-undo
      391     field handle-value  as handle
      392     field save-position as decimal
      393     index xpk is primary unique handle-value
      394     .
      395   define temp-table temp-browse-handle no-undo
      396     field browse-type   as character
      397     field browse-number as integer
      398     field browse-handle as handle
      399     field original-size as decimal
      400     index xpk is primary unique browse-type browse-number
      401     index xie browse-type browse-handle
      402   .
      403   procedure diasize_change-height :
      404     define input  parameter p-change-value  as decimal   no-undo .
      405     define input  parameter p-move-resize   as logical   no-undo .
      406     define variable v-field-group-handle    as handle    no-undo .
      407     define variable v-object-handle         as handle    no-undo .
      408     define variable v-frame-height          as decimal   no-undo .
      409     define variable v-frame-virtual-height  as decimal   no-undo .
      410     define variable v-browse-height         as decimal   no-undo .
      411     define variable v-window-height         as decimal   no-undo .
      412     define variable v-window-virtual-height as decimal   no-undo .
      413     define variable v-change-sign           as integer   no-undo .
      414     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      415     define buffer buf_temp-browse-handle  for temp-browse-handle .
      416     if p-change-value > 0
      417     then do:
      418       if frame b-bc-rcnz :height + p-change-value
      419           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      420       then do:
      421         assign
      422           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      423                           - (frame b-bc-rcnz :height-chars)
      424         .
      425         if p-change-value <= 0
      426         then do:
      427           run diasize_position-resize-button in this-procedure .
      428           return .
      429         end.
      430       end.
      431     end.
      432     if p-change-value < 0
      433     then do:
      434       if frame b-bc-rcnz :height + p-change-value < v-diasize-orig-frame-height
      435       then do:
      436         assign
      437           p-change-value = v-diasize-orig-frame-height
      438                          - (frame b-bc-rcnz :height-chars)
      439         .
      440         if p-change-value >= 0
      441         then do:
      442           run diasize_position-resize-button in this-procedure .
      443           return .
      444         end.
      445       end.
      446     end.
      447     if p-change-value >= 0
      448     then do:
      449       assign
      450         v-change-sign = 1
      451       .
      452     end.
      453     else do:
      454       assign
      455         v-change-sign = -1
      456       .
      457     end.
      458     assign
      459       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      460     .
      461     if p-change-value = 0
      462     then do:
      463       run diasize_position-resize-button in this-procedure .
      464       return .
      465     end.
      466     move_block:
      467     do
      468     on error undo move_block, retry move_block
      469     :
      470       if retry
      471       then do:
      472         do
      473         on error undo move_block, leave move_block
      474         :
      475           if p-change-value > 0
      476           then do:
      477             for each buf_temp-diasize-handle
      478             on error undo, next
      479             :
      480               assign
      481                 v-object-handle = buf_temp-diasize-handle.handle-value
      482               .
      483               if v-object-handle <> v-diasize-resize-button
      484               then do:
      485                 assign
      486                   v-object-handle :row = buf_temp-diasize-handle.save-position
      487                 .
      488               end.
      489             end.
      490             assign
      491               v-diasize-browse-handle :height = v-browse-height
      492             .
      493             for each buf_temp-browse-handle
      494               where buf_temp-browse-handle.browse-type = 'height':u
      495             on error undo, next
      496             :
      497               assign
      498                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      499               .
      500             end.
      501             assign
      502               frame b-bc-rcnz :height = v-frame-height
      503             .
      504             if frame b-bc-rcnz :scrollable = true
      505             then do:
      506               assign
      507                 frame b-bc-rcnz :virtual-height = v-frame-virtual-height
      508               .
      509             end.
      510             run diasize_position-resize-button in this-procedure .
      511           end.
      512           else do:
      513             if frame b-bc-rcnz :scrollable = true
      514             then do:
      515               assign
      516                 frame b-bc-rcnz :virtual-height = v-frame-virtual-height
      517               .
      518             end.
      519             assign
      520               frame b-bc-rcnz :height = v-frame-height
      521             .
      522             assign
      523               v-diasize-browse-handle :height = v-browse-height
      524             .
      525             for each buf_temp-browse-handle
      526               where buf_temp-browse-handle.browse-type = 'height':u
      527             on error undo, next
      528             :
      529               assign
      530                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      531               .
