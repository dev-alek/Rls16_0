     2102     :
     2103       run diasize_change-height in this-procedure
     2104         (input  (p-new-height - frame Dialog-Frame :height)
     2105         ,input  p-move-resize
     2106         ) .
     2107     end.
     2108   end procedure.
     2109   procedure diasize_change-width :
     2110     define input  parameter p-change-value as decimal   no-undo .
     2111     define input  parameter p-move-resize  as logical   no-undo .
