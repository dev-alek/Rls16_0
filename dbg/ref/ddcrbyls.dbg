      886   function disdcrul-get-disc-role-label returns character ( input p-discnt-role as character):
      887   define variable v-rule-label as character no-undo .
      888   return entry (lookup (p-discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u).
      889   end function.
      890   procedure disdcrul-write :
      891     do
      892     on error undo, return error
      893     :
      894       define input parameter p-d-card         like ub.dis-dc-rule.d-card     no-undo .
      895       define input parameter p-host-code      like ub.dis-dc-rule.host-code  no-undo .
      896       define input parameter p-obj-type       like ub.dis-dc-rule.obj-type   no-undo .
      897       define input parameter p-obj-code       like ub.dis-dc-rule.obj-code   no-undo .
      898       define input parameter p-pos-type       like ub.dis-dc-rule.pos-type   no-undo .
      899       define input parameter p-discnt-role    like ub.dis-dc-rule.discnt-role no-undo .
      900       define input parameter p-templ-rl-root  like ub.dis-dc-rule.templ-rl-root  no-undo .
      901       define input parameter p-time-templ-rl-root  like ub.dis-dc-rule.time-templ-rl-root  no-undo .
      902       define input parameter p-rule-num       like ub.dis-dc-rule.rule-num    no-undo .
      903       define input parameter p-nonunique      like ub.dis-dc-rule.nonunique   no-undo .
      904       define buffer buf_dis-rule for ub.dis-rule.
      905       define buffer buf_dis-dc-rule for ub.dis-dc-rule .
      906       define buffer lock_dis-dc-rule for ub.dis-dc-rule .
      907       define variable v-label          as character no-undo .
      908       define variable v-discnt-role as character no-undo .
      909       run discfgru-check in this-procedure (
      910                                             input 'dis-dc-rule':U
      911                                            ,input p-templ-rl-root
      912                                            ,input p-time-templ-rl-root
      913                                            ,input p-pos-type
      914                                            ,output v-discnt-role
      915                                             ) no-error .
      916       if error-status :error then do:
      917         undo, return error return-value .
      918       end.
      919       if p-discnt-role = ? then do:
      920         p-discnt-role = v-discnt-role.
      921       end.
      922       if p-discnt-role <> v-discnt-role then do:
      923         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7не может быть по шаблону &8 и расписанию &9"
      924                                 ,p-d-card
      925                                 ,p-host-code
      926                                 ,p-obj-type
      927                                 ,p-obj-code
      928                                 ,p-pos-type
      929                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      930                                 ,chr(10)
      931                                 ,p-templ-rl-root
      932                                 ,p-rule-num).
      933       end.
      934       if p-pos-type = ? then do:
      935   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      936   define variable v-param-type10 as character no-undo .
      937   define variable v-value-date10 as date no-undo .
      938   define variable v-value-decimal10 as decimal no-undo .
      939   define variable v-value-integer10 as INTEGER no-undo .
      940   define variable v-value-logical10 AS LOGICAL no-undo .
      941   define variable v-tth10 as handle no-undo .
      942   run adm/shattri.p (
      943       input "get":U
      944       ,input  p-obj-type
      945       ,input  p-obj-code
      946       ,input  'cd-sending':U
      947       ,input  'dflt-cd':U
      948       ,output p-pos-type
      949       ,output v-value-date10
      950       ,output v-value-decimal10
      951       ,output v-value-integer10
      952       ,output v-value-logical10
      953       ,output v-param-type10
      954       ,INPUT-OUTPUT table-handle v-tth10
      955       )  .
      956   delete object v-tth10 no-error.
      957       end.
      958       find first buf_dis-rule no-lock where
      959                 buf_dis-rule.rule-num = p-rule-num no-error.
      960       if not available buf_Dis-rule then do:
      961         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7не найдено правило скидки &8"
      962                                 ,p-d-card
      963                                 ,p-host-code
      964                                 ,p-obj-type
      965                                 ,p-obj-code
      966                                 ,p-pos-type
      967                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      968                                 ,chr(10)
      969                                 ,p-rule-num).
      970       end.
      971       if buf_dis-rule.root <> yes then do:
      972         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
      973                                 ,p-d-card
      974                                 ,p-host-code
      975                                 ,p-obj-type
      976                                 ,p-obj-code
      977                                 ,p-pos-type
      978                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      979                                 ,chr(10)
      980                                 ,p-rule-num).
      981       end.
      982       if not (p-host-code = buf_dis-rule.host-code
      983           and p-obj-type = buf_dis-rule.obj-type
      984           and p-obj-code = buf_dis-rule.obj-code)
      985       then do:
      986         undo, return error (substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
      987                                 ,p-d-card
      988                                 ,p-host-code
      989                                 ,p-obj-type
      990                                 ,p-obj-code
      991                                 ,p-pos-type
      992                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      993                                 ,chr(10)
      994                                 )
      995                             +
      996                             substitute("Правило скидки &1 определено для &2&3" +
      997                                        "а привязка к ДК для &4"
      998                                        ,buf_dis-rule.rule-num
      999                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1000                                        ,chr(10)
     1001                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
     1002                                        ))
     1003                                 .
     1004       end.
     1005       find first buf_dis-dc-rule exclusive-lock where
     1006                  buf_dis-dc-rule.d-card  = p-d-card
     1007              AND buf_dis-dc-rule.obj-type  = p-obj-type
     1008              AND buf_dis-dc-rule.host-code = p-host-code
     1009              AND buf_dis-dc-rule.obj-code  = p-obj-code
     1010              AND buf_dis-dc-rule.pos-type  = p-pos-type
     1011              AND buf_dis-dc-rule.discnt-role = p-discnt-role
     1012              and buf_dis-dc-rule.nonunique = p-nonunique
     1013              no-error .
     1014       if not available buf_dis-dc-rule then do:
     1015         create buf_dis-dc-rule .
     1016         assign
     1017         buf_dis-dc-rule.d-card  = p-d-card
     1018         buf_dis-dc-rule.host-code  = p-host-code
     1019         buf_dis-dc-rule.obj-type  = p-obj-type
     1020         buf_dis-dc-rule.obj-code  = p-obj-code
     1021         buf_dis-dc-rule.pos-type = p-pos-type
     1022         buf_dis-dc-rule.discnt-role = v-discnt-role
     1023         buf_dis-dc-rule.rule-num = p-rule-num
     1024         buf_dis-dc-rule.nonunique = p-nonunique
     1025         no-error
     1026         .
     1027       end.
     1028       ASSIGN
     1029       buf_dis-dc-rule.time-templ-rl-root = p-time-templ-rl-root
     1030       buf_dis-dc-rule.rule-num = p-rule-num
     1031       buf_dis-dc-rule.rl-root = buf_Dis-rule.rl-root
     1032       buf_dis-dc-rule.templ-rl-root = p-templ-rl-root
     1033       buf_dis-dc-rule.nonunique = p-nonunique
     1034       no-error.
     1035     end.
     1036   end procedure.
     1037   procedure disdcrul-edit :
     1038   define input parameter p-mode as character no-undo .
     1039   define input parameter p-d-card   like ub.dis-dc-rule.d-card no-undo .
     1040   define input parameter p-host-code like ub.dis-dc-rule.host-code no-undo .
     1041   define input parameter p-obj-type like ub.dis-dc-rule.obj-type no-undo .
     1042   define input parameter p-obj-code like ub.dis-dc-rule.obj-code no-undo .
     1043   define input parameter p-pos-type like ub.dis-dc-rule.pos-type no-undo .
     1044   define input parameter p-discnt-role like ub.dis-dc-rule.discnt-role no-undo .
     1045   define input parameter p-templ-rl-root like ub.dis-dc-rule.templ-rl-root no-undo .
     1046   define input parameter p-time-templ-rl-root like ub.dis-dc-rule.time-templ-rl-root no-undo .
     1047   define input parameter p-cfg-nonunique as character no-undo .
     1048   define input parameter p-check as integer no-undo .
     1049   define input-output parameter p-rule-num as integer no-undo .
     1050   define input-output parameter p-NONUNIQUE like ub.dis-cfg-rule.NONUNIQUE no-undo .
     1051   define output parameter p-setted as logical no-undo .
     1052   DEFINE VARIABLE v-value as character no-undo .
     1053   define variable v-sts as integer no-undo .
     1054   define variable v-rid-list as character no-undo .
     1055   DEFINE VARIABLE v-rule-num as integer no-undo .
     1056   define variable v-cd-dr-correct  as logical no-undo .
     1057   define variable jj as integer no-undo .
     1058   define variable conf-par as character no-undo .
     1059   define variable conf-attr as character no-undo .
     1060   define variable par-type as character no-undo .
     1061   define variable dflt-cd as character no-undo .
     1062   define variable v-cd-list as character no-undo .
     1063   define variable v-is-time-rule as logical no-undo .
     1064   define variable v-label as character no-undo .
     1065   define variable v-nonunique as character no-undo .
     1066   define variable v-mode as character no-undo .
     1067   define buffer buf_dis-rule for ub.dis-rule.
     1068   define buffer buf_dis-time-rule for ub.dis-time-rule .
     1069   define buffer term_dis-rule for ub.dis-rule.
     1070   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
     1071   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1072   define buffer buf_temp-disc for temp-disc.
     1073   assign
     1074   v-rule-num = p-rule-num.
     1075   v-sts = integer('0':U).
     1076   if v-rule-num <> 0
     1077   and v-rule-num <> ?
     1078   then do:
     1079     find first buf_dis-rule no-lock where
     1080               buf_dis-rule.rule-num = v-rule-num no-error .
     1081     if error-status:error then do:
     1082       message
     1083       "Ошибка при поиске правила с номером" v-rule-num
     1084       view-as alert-box error .
     1085       return .
     1086     end.
     1087     assign
     1088     v-rid-list = string(recid(buf_dis-rule))
     1089     .
     1090   end.
     1091   run disdcrul-name in this-procedure (
     1092                                 input p-templ-rl-root
     1093                                 ,output v-label) no-error.
     1094   if p-pos-type = ?
     1095   or p-pos-type = '':U then do:
     1096   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1097   define variable v-param-type11 as character no-undo .
     1098   define variable v-value-date11 as date no-undo .
     1099   define variable v-value-decimal11 as decimal no-undo .
     1100   define variable v-value-integer11 as INTEGER no-undo .
     1101   define variable v-value-logical11 AS LOGICAL no-undo .
     1102   define variable v-tth11 as handle no-undo .
     1103   run adm/shattri.p (
     1104       input "get":U
     1105       ,input  p-obj-type
     1106       ,input  p-obj-code
     1107       ,input  'cd-sending':U
     1108       ,input  'dflt-cd':U
     1109       ,output dflt-cd
     1110       ,output v-value-date11
     1111       ,output v-value-decimal11
     1112       ,output v-value-integer11
     1113       ,output v-value-logical11
     1114       ,output v-param-type11
     1115       ,INPUT-OUTPUT table-handle v-tth11
     1116       )  .
     1117   delete object v-tth11 no-error.
     1118   end.
     1119   else do:
     1120     dflt-cd = p-pos-type.
     1121   end.
     1122   v-mode =  ('dis-dc-rule':U + "=" + p-discnt-role).
     1123   run ref/dis-ruls.w (
     1124               input parparentproc
     1125               ,input p-host-code
     1126               ,input p-obj-type
     1127               ,input p-obj-code
     1128               ,input "b-add,b-sel":U
     1129               ,input v-mode
     1130               ,input p-templ-rl-root
     1131               ,input p-time-templ-rl-root
     1132               ,input 0
     1133               ,input-output v-sts
     1134               ,input-output v-rid-list ) no-error .
     1135   do
     1136   on error undo, return error return-value
     1137   :
     1138     if v-rid-list <> "":U then do:
     1139       find first buf_dis-rule exclusive-lock where
     1140                   recid(buf_dis-rule) = integer(v-rid-list) no-wait no-error .
     1141       if not available buf_dis-rule
     1142       then do:
     1143         message
     1144         "Ошибка при поиске правила с recid" v-rid-list
     1145         view-as alert-box error .
     1146         return .
     1147       end.
     1148       if buf_dis-rule.sts <> integer('0':U) then do:
     1149         message
     1150         "Правило скидки имеет статус" entry (lookup (string(buf_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U) skip
     1151         "Нельзя привязать к нему скидку на ДК"
     1152         view-as alert-box error .
     1153         return .
     1154       end.
     1155       find first buf_dis-cfg-rule no-lock where
     1156                buf_dis-cfg-rule.templ-rl-root =  buf_dis-rule.templ-rl-root
     1157            and buf_dis-cfg-rule.time-templ-rl-root = (if buf_dis-rule.time-templ-rl-root = 0
     1158                                                       then 0
     1159                                                       else buf_dis-rule.time-templ-rl-root)
     1160           and buf_dis-cfg-rule.pos-type = dflt-cd
     1161           and buf_Dis-cfg-rule.table-name = 'dis-dc-rule':U
     1162           no-error.
     1163       if available buf_dis-cfg-rule then do:
     1164         assign
     1165         v-cd-dr-correct = yes
     1166         .
     1167       end.
     1168       if not v-cd-dr-correct
     1169       then do:
     1170         message
     1171         substitute("Правило скидки &1 неприменимо для касс &2.&3" +
     1172                   "(АРМ АДМИНИСТРАТОР-Магазины(Фирмы)-Параметры-Общие опции коммуникации с кассами)"
     1173                   ,buf_dis-rule.rule-num
     1174                   ,dflt-cd
     1175                   ,chr(10)
     1176                   )
     1177         view-as alert-box error .
     1178         undo, return error .
     1179       end.
     1180       assign
     1181       v-nonunique = if p-cfg-nonunique = '':U
     1182                     then '':U
     1183                     else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value).
     1184       if p-check = 0
     1185       or p-check = 2
     1186       then do:
     1187         find first buf_dis-dc-rule no-lock where
     1188                     buf_dis-dc-rule.obj-type = p-obj-type
     1189                 and buf_dis-dc-rule.obj-code = p-obj-code
     1190                 and buf_dis-dc-rule.host-code = p-host-code
     1191                 and buf_dis-dc-rule.d-card = p-d-card
     1192                 and buf_dis-dc-rule.pos-type = p-pos-type
     1193                 and buf_dis-dc-rule.discnt-role = p-discnt-role
     1194                 and buf_dis-dc-rule.nonunique = v-nonunique no-error .
     1195         if available buf_dis-dc-rule
     1196         and p-mode <> 'ИЗМЕНЕНИЕ':U
     1197         then do:
     1198           message
     1199           "Скидка такого типа на данную ДК уже существует"
     1200           view-as alert-box error .
     1201           return error.
     1202         end.
     1203       end.
     1204       if p-check = 1
     1205       or p-check = 2
     1206       then do:
     1207         find first buf_temp-disc no-lock where
     1208                     buf_temp-disc.obj-type = p-obj-type
     1209                 and buf_temp-disc.obj-code = p-obj-code
     1210                 and buf_temp-disc.host-code = p-host-code
     1211                 and buf_temp-disc.pos-type = p-pos-type
     1212                 and buf_temp-disc.templ-rl-root = p-templ-rl-root
     1213                 and buf_temp-disc.nonunique = v-nonunique no-error .
     1214         if available buf_temp-disc
     1215         and buf_temp-disc.rule-num <> 0
     1216         and p-mode <> 'ИЗМЕНЕНИЕ':U
     1217         then do:
     1218           message
     1219           "Скидка такого типа на данную ДК уже существует"
     1220           view-as alert-box error .
     1221           return error.
     1222         end.
     1223       end.
     1224       if p-rule-num <> buf_dis-rule.rule-num then do:
     1225         assign
     1226         p-setted = yes
     1227         p-rule-num = buf_dis-rule.rule-num
     1228         p-nonunique = v-nonunique
     1229         .
     1230       end.
     1231     end.
     1232   end.
     1233   end procedure.
     1234   define variable add-option as char no-undo.
     1235   DEFINE VARIABLE add-obj-type like ub.clients.obj-type no-undo .
     1236   DEFINE VARIABLE add-obj-code like ub.clients.obj-code no-undo .
     1237   define variable updated as logical no-undo.
     1238   define variable temp-doc-rec as recid no-undo.
     1239   define buffer del_temp-disc for temp-disc.
     1240   define variable glog as logical no-undo .
     1241   define variable v-tab-order AS character no-undo.
     1242   define variable loc-glob as logical no-undo .
     1243   define variable loc-firm as logical no-undo .
     1244   define variable loc-object as logical no-undo .
     1245   define variable dflt-cd as character no-undo .
     1246   FUNCTION dis-dc-rule-name RETURNS CHARACTER
     1247     ( INPUT p-discnt-role AS character )  FORWARD.
     1248   DEFINE MENU MENU-b-add
     1249          MENU-ITEM m_pos-type     LABEL "m_pos-type"
     1250          MENU-ITEM m_no-pos       LABEL "По накладной"
     1251          MENU-ITEM m_bo           LABEL "Бэкофис"       .
     1252   DEFINE MENU MENU-b-add-2
     1253          MENU-ITEM m_pos-type-2   LABEL "m_pos-type-2"
     1254          MENU-ITEM m_no-pos-2     LABEL "По накладной"
     1255          MENU-ITEM m_bo-2         LABEL "Бэкофис"       .
     1256   DEFINE BUTTON b-add
     1257        LABEL "&Добавить":L
     1258        SIZE 10 BY 1 TOOLTIP "Выбрать скидку для добавления".
     1259   DEFINE BUTTON b-add-2
     1260        LABEL "&Добавить":L
     1261        SIZE 10 BY 1 TOOLTIP "Выбрать скидку для удаления".
     1262   DEFINE BUTTON B-chg
     1263        LABEL "&Изменить"
     1264        SIZE 10 BY 1.
     1265   DEFINE BUTTON B-chg-2
     1266        LABEL "&Изменить"
     1267        SIZE 10 BY 1.
     1268   DEFINE BUTTON B-del
     1269        LABEL "&Удалить"
     1270        SIZE 10 BY 1.
     1271   DEFINE BUTTON B-del-2
     1272        LABEL "&Удалить"
     1273        SIZE 10 BY 1.
     1274   DEFINE BUTTON B-exit
     1275        LABEL "&Ввод"
     1276        SIZE 10 BY 1 TOOLTIP "Установить/изменить/удалить скидки по списку"
     1277        BGCOLOR 8 .
     1278   DEFINE BUTTON B-Help
     1279        LABEL "Помо&щь"
     1280        SIZE 3 BY 1
     1281        BGCOLOR 8 .
     1282   DEFINE BUTTON B-list
     1283        LABEL "&Список"
     1284        SIZE 10 BY 1 TOOLTIP "Создание списка".
     1285   DEFINE BUTTON B-obj
     1286        IMAGE-UP FILE "btn-down-arrow":U
     1287        IMAGE-DOWN FILE "btn-down-arrow":U
     1288        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1289        LABEL "Btn 1"
     1290        SIZE 3 BY 1.
     1291   DEFINE BUTTON b-quit AUTO-END-KEY
     1292        LABEL "&Отмена"
     1293        SIZE 10 BY 1
     1294        BGCOLOR 8 .
     1295   DEFINE VARIABLE f-obj-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1296        VIEW-AS FILL-IN
     1297        SIZE 7 BY 1 NO-UNDO.
     1298   DEFINE VARIABLE F-obj-name AS CHARACTER FORMAT "X(256)":U
     1299         VIEW-AS TEXT
     1300        SIZE 52.5 BY .67
     1301        FGCOLOR 4  NO-UNDO.
     1302   DEFINE VARIABLE Rs-obj-type AS CHARACTER
     1303        VIEW-AS RADIO-SET HORIZONTAL
     1304        RADIO-BUTTONS
     1305             "Item 1", "1",
     1306   "Item 2", "2"
     1307        SIZE 16.5 BY 1 NO-UNDO.
     1308   DEFINE VARIABLE T-delete-ok AS LOGICAL INITIAL no
     1309        LABEL "Удалять записи списка в случае удачного изменения"
     1310        VIEW-AS TOGGLE-BOX
     1311        SIZE 52 BY 1 NO-UNDO.
     1312   DEFINE QUERY BR-add FOR
     1313         temp-disc SCROLLING.
     1314   DEFINE QUERY BR-del FOR
     1315         del_temp-disc SCROLLING.
     1316   DEFINE BROWSE BR-add
     1317     QUERY BR-add DISPLAY
     1318         entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) column-label "Место использ."  format "X(15)"
     1319   dis-dc-rule-name (temp-disc.discnt-role) column-label "Тип скидки" FORMAT "X(255)":U WIDTH 35
     1320   temp-disc.templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!шаблона"
     1321   disdcrul-get-disc-label( INPUT temp-disc.templ-rl-root) FORMAT "X(255)":U WIDTH 45
     1322   temp-disc.rule-num COLUMN-LABEL "Код правила" FORMAT ">>>>>>>>9"
     1323   get-region(temp-disc.host-code, temp-disc.obj-type, temp-disc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)"
     1324       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8
     1325            TITLE "Будут добавлены/изменены скидки".
     1326   DEFINE BROWSE BR-del
     1327     QUERY BR-del DISPLAY
     1328         entry (lookup (del_temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) column-label "Место использ."  format "X(15)"
     1329   dis-dc-rule-name ( DEL_temp-disc.discnt-role) column-label "Тип скидки" FORMAT "X(255)":U WIDTH 35
     1330   del_temp-disc.templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!шаблона"
     1331   disdcrul-get-disc-label( INPUT del_temp-disc.templ-rl-root) FORMAT "X(255)":U WIDTH 45
     1332   del_temp-disc.rule-num COLUMN-LABEL "Код правила" FORMAT ">>>>>>>>9"
     1333   get-region(del_temp-disc.host-code, del_temp-disc.obj-type, del_temp-disc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)"
     1334       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8
     1335            TITLE "Будут удалены скидки".
     1336   DEFINE FRAME Dialog-Frame
     1337        B-exit AT ROW 1 COL 1
     1338        b-quit AT ROW 1 COL 11
     1339        B-list AT ROW 1 COL 41
     1340        B-Help AT ROW 1 COL 95
     1341        Rs-obj-type AT ROW 2.25 COL 1 NO-LABEL
     1342        f-obj-code AT ROW 2.25 COL 16 COLON-ALIGNED NO-LABEL
     1343        B-obj AT ROW 2.25 COL 27
     1344        T-delete-ok AT ROW 3.5 COL 1.5
     1345        b-add AT ROW 4.75 COL 1
     1346        B-chg AT ROW 4.75 COL 11
     1347        B-del AT ROW 4.75 COL 21
     1348        BR-add AT ROW 5.75 COL 1
     1349        b-add-2 AT ROW 14 COL 1
     1350        B-chg-2 AT ROW 14 COL 11 WIDGET-ID 2
     1351        B-del-2 AT ROW 14 COL 21
     1352        BR-del AT ROW 15 COL 1
     1353        F-obj-name AT ROW 2.25 COL 30 COLON-ALIGNED NO-LABEL
     1354        SPACE(14.50) SKIP(20.08)
     1355       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1356            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1357            TITLE "<insert dialog title>"
     1358            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1359   ASSIGN
     1360          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1361          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1362   ASSIGN
     1363          b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE.
     1364   ASSIGN
     1365          b-add-2:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add-2:HANDLE.
     1366   ON WINDOW-CLOSE OF FRAME Dialog-Frame
