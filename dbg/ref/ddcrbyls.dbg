      656   procedure userobjs_transfer :
      657     define input  parameter p-callback-handle as handle no-undo .
      658     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      659     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      660     do
      661     on error undo, return error return-value
      662     :
      663       if valid-handle(p-callback-handle) <> true
      664       then do:
      665         message
      666           vss-workfile vss-revision vss-description skip
      667           "Ошибка задания входных параметров" skip
      668           "Неизвестный указатель на процедуру" skip
      669           view-as alert-box error .
      670         undo, return error return-value .
      671       end.
      672       if p-callback-handle :get-signature("userobjs_append") = ""
      673       then do:
      674         message
      675           vss-workfile vss-revision vss-description skip
      676           "Ошибка задания входных параметров" skip
      677           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      678                     ,p-callback-handle :file-name
      679                     ) skip
      680           view-as alert-box error .
      681         undo, return error return-value .
      682       end.
      683       for each buf_userobjs_temp-user-obj
      684       on error undo, return error return-value
      685       :
      686         run userobjs_append in p-callback-handle
      687           (input  buf_userobjs_temp-user-obj.obj-type
      688           ,input  buf_userobjs_temp-user-obj.obj-code
      689           ) .
      690       end.
      691     end.
      692   end procedure.
