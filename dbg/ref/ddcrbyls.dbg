     1437     "Вы уверены, что хотите удалить скидку" "<" del_temp-disc.label_ ">" skip
     1438     "из списка атрибутов, подлежащих удалению?" skip
     1439      view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     1440     if NOT loc#log then return no-apply.
     1441       run temp-dsc-delete in this-procedure (
     1442                                                input del_temp-disc.pos-type
     1443                                               ,input del_temp-disc.discnt-role
     1444                                               ,input del_temp-disc.nonunique
     1445                                               ,input del_temp-disc.host-code
     1446                                               ,input del_temp-disc.obj-type
     1447                                               ,input del_temp-disc.obj-code
     1448                                               ,input del_temp-disc.action
     1449                                               ,output loc#log) no-error .
     1450       if error-status:error or not loc#log then do:
     1451           return no-apply.
     1452       end.
