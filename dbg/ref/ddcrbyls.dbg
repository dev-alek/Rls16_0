     2484   procedure diasize_set-width :
     2485     define input  parameter p-new-width  as decimal   no-undo .
     2486     define input  parameter p-move-resize as logical   no-undo .
     2487     do
     2488     on error undo, return error return-value
     2489     :
     2490       run diasize_change-width in this-procedure
     2491         (input  (p-new-width - frame Dialog-Frame :width)
     2492         ,input  p-move-resize
     2493         ) .
     2494     end.
     2495   end procedure.
     2496   procedure diasize_position-resize-button :
     2497     do with frame Dialog-Frame
     2498     :
     2499       hide v-diasize-resize-button .
     2500       assign
     2501         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2502                     - 1
     2503                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2504         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2505                     - 1
     2506                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2507       .
     2508       view v-diasize-resize-button .
     2509     end.
     2510   end procedure.
     2511   on alt-right anywhere
     2512   do:
     2513     run diasize_change-width in this-procedure
     2514       (input 1
     2515       ,input true
     2516       ) .
     2517     return no-apply .
     2518   end.
     2519   on alt-left anywhere
     2520   do:
     2521     run diasize_change-width in this-procedure
     2522       (input -1
     2523       ,input true
     2524       ) .
     2525     return no-apply .
     2526   end.
     2527   on alt-down anywhere
     2528   do:
     2529     run diasize_change-height in this-procedure
     2530       (input 1
     2531       ,input true
     2532       ) .
     2533     return no-apply .
     2534   end.
     2535   on alt-up anywhere
     2536   do:
     2537     run diasize_change-height in this-procedure
     2538       (input -1
     2539       ,input true
     2540       ) .
     2541     return no-apply .
     2542   end.
     2543   on alt-enter of frame Dialog-Frame
     2544   do:
     2545     run diasize_maximize in this-procedure
     2546       (input  ?
     2547       ).
     2548     return no-apply .
     2549   end.
     2550   procedure diasize_end-move :
     2551     do
     2552     on error undo, return error return-value
     2553     :
     2554       define variable v-row-delta as decimal   no-undo .
     2555       define variable v-col-delta as decimal   no-undo .
     2556       define variable v-new-row as decimal   no-undo .
     2557       define variable v-new-col as decimal   no-undo .
     2558       assign
     2559         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2560         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2561       .
     2562       assign
     2563         v-row-delta = v-new-row - frame Dialog-Frame :height
     2564         v-col-delta = v-new-col - frame Dialog-Frame :width
     2565       .
     2566       run diasize_change-height in this-procedure
     2567         (input v-row-delta
     2568         ,input true
     2569         ) .
     2570       run diasize_change-width in this-procedure
     2571         (input v-col-delta
     2572         ,input true
     2573         ) .
     2574     end.
     2575   end procedure.
     2576   procedure diasize_maximize :
     2577     define input  parameter p-action as logical   no-undo .
     2578     do
     2579     on error undo, return error return-value
     2580     :
     2581       if p-action = ?
     2582       then do:
     2583         if v-diasize-need-maximize = true
     2584         then do:
     2585           assign
     2586             p-action = true
     2587           .
     2588         end.
     2589         else do:
     2590           assign
     2591             p-action = false
     2592           .
     2593         end.
     2594       end.
     2595       if p-action = true
     2596       then do:
     2597         run diasize_change-height in this-procedure
     2598           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2599               - frame Dialog-Frame :height-chars
     2600           ,input true
     2601           ) .
     2602         run diasize_change-width in this-procedure
     2603           (input session :width-chars
     2604               - frame Dialog-Frame :width-chars
     2605           ,input true
     2606           ) .
     2607         assign
     2608           v-diasize-need-maximize = false
     2609         .
     2610       end.
     2611       else do:
     2612         run diasize_change-width in this-procedure
     2613           (input v-diasize-orig-frame-width
     2614               - frame Dialog-Frame :width-chars
     2615           ,input true
     2616           ) .
     2617         run diasize_change-height in this-procedure
     2618           (input v-diasize-orig-frame-height
     2619               - frame Dialog-Frame :height-chars
     2620           ,input true
     2621           ) .
     2622         assign
     2623           v-diasize-need-maximize = true
     2624         .
     2625       end.
     2626     end.
     2627   end procedure.
     2628   procedure diasize_restore-orig-size :
     2629     do
     2630     on error undo, return error return-value
     2631     :
     2632       assign
     2633         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2634         v-diasize-current-frame-height = frame Dialog-Frame :height
     2635       .
     2636       run diasize_set-height in this-procedure
     2637         (input  v-diasize-orig-frame-height
     2638         ,input  true
     2639         ) .
     2640       run diasize_set-width in this-procedure
     2641         (input  v-diasize-orig-frame-width
     2642         ,input  true
     2643         ) .
     2644     end.
     2645   end procedure.
     2646   procedure diasize_restore-current-size :
     2647     do
     2648     on error undo, return error return-value
     2649     :
     2650       run diasize_set-height in this-procedure
     2651         (input  v-diasize-current-frame-height
     2652         ,input  true
     2653         ) .
     2654       run diasize_set-width in this-procedure
     2655         (input  v-diasize-current-frame-width
     2656         ,input  true
     2657         ) .
     2658     end.
     2659   end procedure.
     2660   procedure diasize_set-browse-handle :
     2661     define input  parameter p-browse-handle as handle   no-undo .
     2662     define buffer buf_temp-browse-handle for temp-browse-handle .
     2663     do
     2664     on error undo, return error return-value
     2665     :
     2666       assign
     2667         v-diasize-browse-handle = p-browse-handle
     2668       .
     2669       for each buf_temp-browse-handle
     2670       on error undo, return error return-value
     2671       :
     2672         delete buf_temp-browse-handle .
     2673       end.
     2674     end.
     2675   end procedure.
     2676   procedure diasize_add_browse :
     2677     define input  parameter p-browse-type   as character no-undo .
     2678     define input  parameter p-browse-handle as handle    no-undo .
     2679     define buffer buf_temp-browse-handle for temp-browse-handle .
     2680     do
     2681     on error undo, return error return-value
     2682     :
     2683       assign
     2684         v-diasize-browse-number = v-diasize-browse-number + 1
     2685       .
     2686       create buf_temp-browse-handle .
     2687       assign
     2688         buf_temp-browse-handle.browse-type   = p-browse-type
     2689         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2690         buf_temp-browse-handle.browse-handle = p-browse-handle
     2691       .
     2692     end.
     2693   end procedure.
     2694   procedure diasize_init :
     2695     define variable v-default-value    as logical   no-undo .
     2696     define variable v-restore-saved    as logical   no-undo .
     2697     define variable v-resize-value-str as character no-undo .
     2698     do
     2699     on error undo, return error return-value
     2700     :
     2701       do with frame Dialog-Frame
     2702       :
     2703         assign
     2704           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2705           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2706           v-diasize-browse-handle     = browse BR-add :handle
     2707         .
     2708         create button v-diasize-resize-button
     2709         assign
     2710           parent        = frame Dialog-Frame :first-child
     2711           label         = "s"
     2712           height-pixels = 16
     2713           width-pixels  = 16
     2714           visible       = true
     2715           sensitive     = true
     2716           movable       = true
     2717           triggers:
     2718             on end-move persistent run diasize_end-move in this-procedure .
     2719           end triggers.
     2720         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2721         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2722         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2723         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2724         assign
     2725           v-diasize-wndmax = false
     2726         .
     2727         if connected("ub") = true
     2728         then do:
     2729           define variable v-cntxt-db-num        as integer   no-undo .
     2730           define variable v-cntxt-userid        as character no-undo .
     2731           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2732                                             , OUTPUT v-cntxt-userid
     2733                                             ) .
     2734           run gbl/wndpar_r.p
     2735             (input  v-cntxt-db-num
     2736             ,input  v-cntxt-userid
     2737             ,input  'wndmax':U
     2738             ,output v-diasize-wndmax
     2739             ,output v-default-value
     2740             ) .
     2741         end.
     2742         assign
     2743           v-diasize-wndstore = false
     2744         .
     2745         if connected("ub") = true
     2746         then do:
     2747           run gbl/wndpar_r.p
     2748             (input  v-cntxt-db-num
     2749             ,input  v-cntxt-userid
     2750             ,input  'wndstore':U
     2751             ,output v-diasize-wndstore
     2752             ,output v-default-value
     2753             ) .
     2754         end.
     2755         assign
     2756           v-diasize-proc-name = entry(1, program-name(2), '.')
     2757         .
     2758         if v-diasize-wndstore = true
     2759         then do:
     2760           assign
     2761             v-restore-saved = false
     2762           .
     2763           if connected("ub") = true
     2764           then do:
     2765             run gbl/wndsizer.p
     2766               (input  v-cntxt-db-num
     2767               ,input  v-cntxt-userid
     2768               ,input  v-diasize-proc-name
     2769               ,input  'height':u
     2770               ,output v-resize-value-str
     2771               ) .
     2772             if v-resize-value-str <> '':U
     2773             then do:
     2774               run diasize_change-height in this-procedure
     2775                 (input  integer(v-resize-value-str)
     2776                 ,input  true
     2777                 ) .
     2778               assign
     2779                 v-restore-saved = true
     2780               .
     2781             end.
     2782           end.
     2783           if connected("ub") = true
     2784           then do:
     2785             run gbl/wndsizer.p
     2786               (input  v-cntxt-db-num
     2787               ,input  v-cntxt-userid
     2788               ,input  v-diasize-proc-name
     2789               ,input  'width':u
     2790               ,output v-resize-value-str
     2791               ) .
     2792             if v-resize-value-str <> '':U
     2793             then do:
     2794               run diasize_change-width in this-procedure
     2795                 (input  integer(v-resize-value-str)
     2796                 ,input  true
     2797                 ) .
     2798               assign
     2799                 v-restore-saved = true
     2800               .
     2801             end.
     2802           end.
     2803           if v-restore-saved <> true
     2804           then do:
     2805             if v-diasize-wndmax = true
     2806             then do:
     2807               run diasize_maximize in this-procedure
     2808                 (input  true
     2809                 ) .
     2810             end.
     2811           end.
     2812         end.
     2813         else do:
     2814           if v-diasize-wndmax = true
     2815           then do:
     2816             run diasize_maximize in this-procedure
     2817               (input  true
     2818               ) .
     2819           end.
     2820         end.
     2821       end.
     2822     end.
     2823   end procedure.
     2824   procedure diasize_need-full-display :
     2825     define output parameter p-need-full-display as logical   no-undo .
     2826     do
     2827     on error undo, return error return-value
     2828     :
     2829       assign
     2830         p-need-full-display = v-diasize-need-full-display
     2831       .
     2832       assign
     2833         v-diasize-need-full-display = false
     2834       .
     2835     end.
     2836   end procedure.
     2837   procedure get-context :
     2838      define output parameter p-db-num as integer          no-undo.
     2839      define output parameter p-user-id as character        no-undo.
     2840      define variable v-login               as character    no-undo.
     2841      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2842      define buffer buf_user-login  for ub.user-login .
     2843      do
     2844      on error undo, return error
     2845      :
     2846            FIND FIRST buf_sys-ctrl no-lock.
     2847            ASSIGN
     2848               v-login = USERID("ub")
     2849               p-db-num = buf_sys-ctrl.db-num
     2850            .
     2851            FIND FIRST buf_user-login
     2852                 WHERE buf_user-login.db-num = p-db-num
     2853                   AND buf_user-login.user-login = v-login
     2854                 no-lock
     2855                 no-error
     2856                 .
     2857            IF AVAILABLE buf_user-login
     2858            THEN DO:
     2859               assign
     2860                  p-user-id = buf_user-login.user-id
     2861               .
     2862            END.
     2863      end.
     2864   end procedure.
     2865       run diasize_init in this-procedure .
     2866   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2867   ON RETURN ANYWHERE
     2868   DO:
     2869   define variable ii as integer no-undo .
     2870   define variable fh as widget-handle no-undo .
     2871   define variable hh as widget-handle no-undo .
     2872   define variable v-next-widget-name as character no-undo .
     2873     if v-tab-order <> '' then do:
     2874       assign
     2875       ii = lookup(self:name, v-tab-order).
     2876       if ii = num-entries(v-tab-order) then do:
     2877           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2878           return no-apply.
     2879       end.
     2880       if self:type <> "BUTTON" and
     2881         self:type <> "EDITOR"  then do:
     2882         run proc-move-forward in this-procedure .
     2883         return no-apply.
     2884       end.
     2885       if self:type = "BUTTON" then do:
     2886         APPLY "CHOOSE" to self.
     2887       end.
     2888       if self:type = "TOGGLE-BOX" then
     2889       self:BGCOLOR = ?.
     2890       assign
     2891       ii = ii + 1
     2892       v-next-widget-name = entry(ii, v-tab-order)
     2893       no-error .
     2894       if error-status:error then do:
     2895         assign
     2896         ii = 1
     2897         v-next-widget-name = entry( ii, v-tab-order)
     2898         .
     2899       end.
     2900       assign
     2901       fh = frame Dialog-Frame:first-child
     2902       hh = fh:first-child
     2903       .
     2904       do while valid-handle(hh):
     2905         if hh:name = v-next-widget-name then do:
     2906           if hh:sensitive  = yes
     2907           AND hh:visible = yes then do:
     2908             if hh:type = "TOGGLE-BOX":U then do:
     2909               assign
     2910               hh:BGcolor = 1
     2911               .
     2912             end.
     2913             APPLY "ENTRY" to hh.
     2914             return no-apply.
     2915           end.
     2916           else do:
     2917             APPLY "TAB" to hh.
     2918             return no-apply.
     2919           end.
     2920         end.
     2921         hh = hh:next-sibling.
     2922       end.
     2923     end.
     2924   END.
     2925   procedure proc-move-forward :
     2926   define variable ii as integer no-undo .
     2927   define variable fh as widget-handle no-undo .
     2928   define variable hh as widget-handle no-undo .
     2929   define variable v-next-widget-name as character no-undo .
     2930   do
     2931   on error undo, return error
     2932   :
     2933     if v-tab-order <> '' then do:
     2934       if self:type = "TOGGLE-BOX" then
     2935       self:BGCOLOR = ?.
     2936       assign
     2937       ii = lookup(self:name, v-tab-order).
     2938       assign
     2939       ii = ii + 1
     2940       v-next-widget-name = entry(ii, v-tab-order)
     2941       no-error .
     2942       if error-status:error then do:
     2943         assign
     2944         ii = 1
     2945         v-next-widget-name = entry( ii, v-tab-order)
     2946         .
     2947       end.
     2948       assign
     2949       fh = frame Dialog-Frame:first-child
     2950       hh = fh:first-child
     2951       .
     2952       do while valid-handle(hh):
     2953         if hh:name = v-next-widget-name then do:
     2954           if hh:sensitive  = yes
     2955           AND hh:visible = yes then do:
     2956             if hh:type = "TOGGLE-BOX":U then do:
     2957               assign
     2958               hh:BGcolor = 1
     2959               .
     2960             end.
     2961             APPLY "ENTRY" to hh.
     2962             return.
     2963           end.
     2964           else do:
     2965             assign
     2966             ii = ii + 1
     2967             v-next-widget-name = entry(ii, v-tab-order)
     2968             no-error .
     2969             if error-status:error then do:
     2970               assign
     2971               ii = 1
     2972               v-next-widget-name = entry( ii, v-tab-order)
     2973               .
     2974             end.
     2975           end.
     2976         end.
     2977         hh = hh:next-sibling.
     2978       end.
     2979     end.
     2980   end.
     2981   end procedure.
     2982   MAIN-BLOCK:
     2983   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2984      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2985   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
