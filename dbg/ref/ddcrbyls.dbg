     1406   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1407   DO:
     1408     define variable loc#log as logical no-undo.
     1409     if not avail temp-disc then return no-apply.
     1410    loc#log = no.
     1411     message "Вы уверены, что хотите удалить скидку"  "<" temp-disc.label_ ">" skip
     1412                        "из списка скидок подлежащих установке/изменению?"  skip
     1413             view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     1414     if NOT loc#log then return no-apply.
     1415       run temp-dsc-delete in this-procedure (
     1416                                                input temp-disc.pos-type
     1417                                               ,input temp-disc.discnt-role
     1418                                               ,input temp-disc.nonunique
     1419                                               ,input temp-disc.host-code
     1420                                               ,input temp-disc.obj-type
     1421                                               ,input temp-disc.obj-code
     1422                                               ,input temp-disc.action
     1423                                               ,output loc#log) no-error .
     1424       if error-status:error or not loc#log then do:
     1425           return no-apply.
     1426       end.
     1427        updated = yes.
     1428       run init-proc in this-procedure .
     1429       APPLY "ENTRY" to br-add.
     1430   END.
     1431   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
