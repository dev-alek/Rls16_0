      767   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768   FUNCTION get-region RETURNS CHARACTER
      769     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      770     define variable par-region as character no-undo.
      771     if parhost-code = 0 and
      772          parobj-type = "":U and
      773          parobj-code = 0 then do:
      774          par-region = "Глобально".
      775          return par-region.
      776       end.
      777       if parobj-type = 'орг':U then do:
      778          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      779          return par-region.
      780       end.
      781       if parobj-type = 'регион':U
      782       then do:
      783          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      784          return par-region.
      785       end.
      786       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      787       return par-region.
      788   END FUNCTION.
      789   FUNCTION get-objregion RETURNS CHARACTER
      790     (  input parobj-type as character, input parobj-code as integer ) :
      791     define variable par-region as character no-undo.
      792     if  parobj-type = "":U and
      793         parobj-code = 0
      794     then do:
      795        par-region = "Глобально".
      796     end.
      797     else if parobj-type = 'орг':U
      798     then do:
      799        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      800     end.
      801     else if parobj-type = 'регион':U
      802     then do:
      803        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      804     end.
      805     else
      806        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      807     return par-region.
      808   END FUNCTION.
