      830   procedure discfgru-check :
      831   define input parameter p-table-name as character no-undo .
      832   define input parameter p-templ-rl-root as integer no-undo .
      833   define input parameter p-time-templ-rl-root as integer no-undo .
      834   define input parameter p-pos-type as character no-undo .
      835   define output parameter p-disnct-role as character no-undo .
      836   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      837     do
      838     on error undo, return error return-value
      839     :
      840       find first buf_dis-cfg-rule no-lock where
      841               buf_dis-cfg-rule.table-name = p-table-name
      842           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      843           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      844           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      845       if not available buf_dis-cfg-rule
      846       or p-pos-type = "":U
      847       then do:
      848          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      849                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      850                                  , p-templ-rl-root
      851                                  , (if p-time-templ-rl-root = ?
      852                                     then '':U
      853                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      854                                     )
      855                                  ).
      856       end.
      857       assign
      858       p-disnct-role = buf_dis-cfg-rule.discnt-role
      859       .
      860     end.
      861   end procedure.
      862   procedure disdcrul-name :
      863   define buffer buf_dis-rule for ub.dis-rule.
      864   do
      865     on error undo, return error
      866     :
      867     define input  parameter p-templ-rl-root  as integer no-undo .
      868     define output parameter p-label          as character no-undo .
      869     find first buf_dis-rule no-lock where
      870               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      871     if available buf_dis-rule then do:
      872       if buf_dis-rule.rule-num > 0 then
      873       p-label = buf_dis-rule.des.
      874     end.
      875     else do:
      876       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      877     end.
      878   end.
      879   end procedure.
      880   function disdcrul-get-disc-label returns character ( input p-templ-rl-root as integer):
