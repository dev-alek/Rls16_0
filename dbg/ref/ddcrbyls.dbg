     3071       END.
     3072     END CASE.
     3073     find first X_clients-obj no-lock where
     3074                 X_clients-obj.obj-type = p-obj-type AND
     3075                 X_clients-obj.obj-code = p-obj-code no-error .
     3076     if not avail X_clients-obj then do:
     3077       message vss-workfile vss-revision vss-description skip
     3078       "Неверное значение параметра p-obj-type и/или p-obj-code" p-obj-type p-obj-code
     3079       view-as alert-box error.
     3080       return error.
     3081     end.
     3082     RUN enable_UI in this-procedure .
     3083     RUN MYenable in this-procedure .
     3084     WAIT-FOR GO OF FRAME Dialog-Frame.
     3085   END.
     3086   RUN disable_UI in this-procedure .
     3087   PROCEDURE check-obj :
     3088   define buffer buf_clients for ub.clients.
     3089   find first buf_clients no-lock where
     3090                 buf_clients.obj-code = input frame Dialog-Frame f-obj-code
     3091            and buf_clients.obj-type = input frame Dialog-Frame RS-obj-type no-error.
     3092   if not available buf_clients then do:
     3093     if input frame Dialog-Frame f-obj-code <> ?  then
     3094       message "Неправильный код или тип объекта" .
     3095     apply "entry" to f-obj-code in frame Dialog-Frame.
     3096     return error.
     3097   end.
     3098   find first X_clients-obj no-lock where recid(X_clients-obj) = recid(buf_clients).
     3099   assign
     3100   p-obj-type = buf_clients.obj-type
     3101   p-obj-code = buf_clients.obj-code
     3102   RS-obj-type = buf_clients.obj-type
     3103   f-obj-code = buf_clients.obj-code
     3104   f-obj-name = buf_clients.obj-name
     3105   .
     3106   display
     3107   RS-obj-type
     3108   f-obj-code
     3109   f-obj-name
     3110   with frame Dialog-Frame.
     3111   RUN proc-title IN THIS-PROCEDURE.
     3112   END PROCEDURE.
     3113   PROCEDURE choose-to-add :
     3114   define input parameter p-attr-code as character no-undo .
     3115   assign
     3116   add-option = p-attr-code
     3117   .
     3118    APPLY "CHOOSE" to b-add in frame Dialog-Frame .
     3119   END PROCEDURE.
     3120   PROCEDURE choose-to-delete :
     3121   define input parameter p-attr-code as character no-undo .
     3122   assign
     3123   add-option = p-attr-code
     3124   .
     3125   APPLY "CHOOSE" to b-add-2 in frame Dialog-Frame .
     3126   END PROCEDURE.
     3127   PROCEDURE disable_UI :
     3128     HIDE FRAME Dialog-Frame.
     3129   END PROCEDURE.
     3130   PROCEDURE enable_UI :
     3131     DISPLAY Rs-obj-type f-obj-code T-delete-ok F-obj-name
     3132         WITH FRAME Dialog-Frame.
     3133     ENABLE B-exit b-quit B-list B-Help Rs-obj-type f-obj-code B-obj T-delete-ok
     3134            b-add B-chg B-del BR-add b-add-2 B-chg-2 B-del-2 BR-del F-obj-name
     3135         WITH FRAME Dialog-Frame.
     3136     VIEW FRAME Dialog-Frame.
     3137     OPEN QUERY BR-add FOR EACH temp-disc where temp-disc.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-disc where del_temp-disc.action = no NO-LOCK.
     3138   END PROCEDURE.
     3139   PROCEDURE init-proc :
     3140   assign
     3141   add-option = ""
     3142   add-obj-type = "":U
     3143   add-obj-code = 0
     3144   .
     3145   OPEN QUERY BR-add FOR EACH temp-disc where temp-disc.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-disc where del_temp-disc.action = no NO-LOCK.
     3146   END PROCEDURE.
     3147   PROCEDURE MyEnable :
     3148   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3149   DEFINE VARIABLE ch AS WIDGET-HANDLE NO-UNDO.
     3150   ch = br-add:FIRST-COLUMN IN FRAME Dialog-Frame.
     3151   DO ii = 1 TO br-add:NUM-COLUMNS IN FRAME Dialog-Frame:
     3152       ASSIGN
     3153       ch:RESIZABLE = YES.
     3154       ch = ch:NEXT-COLUMN.
     3155   END.
     3156   assign
     3157   b-add:MENU-MOUSE in frame Dialog-Frame = 1
     3158   b-add-2:MENU-MOUSE in frame Dialog-Frame = 1
     3159   .
     3160   ASSIGN
     3161   RS-obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     3162                                       "Скл" + chr(44) + 'скл':U
     3163   RS-obj-type = p-obj-type
     3164   f-obj-code = p-obj-code
     3165   f-obj-name = X_clients-obj.obj-name
     3166   .
     3167   DISPLAY
     3168   RS-obj-type
     3169   f-obj-code
     3170   f-obj-name
     3171   WITH FRAME Dialog-Frame.
     3172   RUN proc-title IN THIS-PROCEDURE.
     3173   END PROCEDURE.
     3174   PROCEDURE proc-b-add :
     3175   define input parameter p-pos-type as character no-undo.
     3176   DEFINE VARIABLE v-deleted as logical no-undo .
     3177   define variable v-rid-list as character no-undo .
     3178   define variable dflt-cd as character no-undo .
     3179   define variable v-rec as recid no-undo .
     3180   define variable v-obj-type as character no-undo .
     3181   define variable v-obj-code as integer no-undo .
     3182   define variable v-host-code as integer no-undo .
     3183   define buffer buf_temp-disc for temp-disc.
     3184   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     3185   do
     3186   on error undo, return error :
     3187     run ref/dis-pos.w ( INPUT parparentproc
     3188                         ,INPUT "b-sel":U
     3189                         ,INPUT "cd-type-list"
     3190                         ,INPUT (if v-cntxt-db-num = 0 and loc-glob then 1 else 0)
     3191                         ,INPUT (if v-cntxt-db-num = 0 and loc-firm then 1 else 0)
     3192                         ,INPUT 1
     3193                         ,input 'dis-dc-rule':U
     3194                         ,input '':U
     3195                         ,input ?
     3196                         ,INPUT p-pos-type
     3197                         ,input '':U
     3198                         ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     3199     IF ERROR-STATUS:ERROR
     3200     OR v-rid-list = '':U THEN DO:
     3201       RETURN.
     3202     END.
     3203     FIND FIRST buf_dis-cfg-rule NO-LOCK where
     3204               recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
     3205     run set-region in this-procedure ( buffer buf_dis-cfg-rule
     3206                                      , output v-host-code
     3207                                      , output v-obj-type
     3208                                      , output v-obj-code
     3209                                      ).
     3210     run temp-dsc-write in this-procedure (
     3211                                            input yes
     3212                                           ,input buf_dis-cfg-rule.pos-type
     3213                                           ,input buf_dis-cfg-rule.templ-rl-root
     3214                                           ,input buf_dis-cfg-rule.time-templ-rl-root
     3215                                           ,input buf_dis-cfg-rule.discnt-role
     3216                                           ,input buf_dis-cfg-rule.nonunique
     3217                                           ,input v-host-code
     3218                                           ,input v-obj-type
     3219                                           ,input v-obj-code
     3220                                           ,input 0
     3221                                           ,input yes
     3222                                           ,input-output v-rec
     3223                                     ) no-error .
     3224     IF ERROR-STATUS:ERROR THEN DO:
     3225       if return-value = "not-set" then do:
     3226       end.
     3227       else do:
     3228         message "Ошибка при определении названия и типа скидки !"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3229       end.
     3230       undo,  return error.
     3231     END.
     3232     updated = yes.
     3233     find first buf_temp-disc no-lock where
     3234               recid(buf_temp-disc) = v-rec no-error.
     3235     if avail buf_temp-disc then
     3236     temp-doc-rec = recid(buf_temp-disc).
     3237     else temp-doc-rec = ?.
     3238     Run init-proc in this-procedure no-error.
     3239     if error-status:error then do:
     3240       undo, return error.
     3241     end.
     3242     REPOSITION br-add to recid temp-doc-rec no-error.
     3243     run proc-b-chg in this-procedure ( input "":U) no-error.
     3244     if error-status:error then do:
     3245         run temp-dsc-delete in this-procedure (
     3246                                                  input buf_dis-cfg-rule.pos-type
     3247                                                 ,input buf_dis-cfg-rule.discnt-role
     3248                                                 ,input buf_dis-cfg-rule.nonunique
     3249                                                 ,input v-host-code
     3250                                                 ,input v-obj-type
     3251                                                 ,input v-obj-code
     3252                                                 ,input yes
     3253                                                 ,output v-deleted
     3254                                                 ) no-error .
     3255       Run init-proc in this-procedure no-error.
     3256       undo, return error.
     3257     end.
     3258     APPLY "ENTRY" to br-add in frame Dialog-Frame.
     3259   end.
     3260   END PROCEDURE.
     3261   PROCEDURE proc-b-add-2 :
     3262   define input parameter p-pos-type as character no-undo.
     3263   DEFINE VARIABLE v-deleted as logical no-undo .
     3264   define variable loc#log as logical no-undo.
     3265   define variable loc-action as logical no-undo.
     3266   define variable v-rid-list as character no-undo .
     3267   define variable dflt-cd as character no-undo .
     3268   define variable v-rule-num as integer no-undo .
     3269   define variable v-nonunique as character no-undo .
     3270   define variable v-rec as recid no-undo .
     3271   define variable v-obj-type as character no-undo .
     3272   define variable v-obj-code as integer no-undo .
     3273   define variable v-host-code as integer no-undo .
     3274   define buffer buf_temp-disc for temp-disc.
     3275   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     3276   CASE par-subject :
     3277     WHEN 'dis-dc-rule':U THEN DO:
     3278       run ref/dis-pos.w ( INPUT parparentproc
     3279                           ,INPUT "b-sel":U
     3280                           ,INPUT "cd-type-list"
     3281                           ,INPUT (if v-cntxt-db-num = 0 then 1 else 0)
     3282                           ,INPUT (if v-cntxt-db-num = 0 then 1 else 0)
     3283                           ,INPUT 1
     3284                           ,input 'dis-dc-rule':U
     3285                           ,input '':U
     3286                           ,input ?
     3287                           ,INPUT p-pos-type
     3288                           ,input '':U
     3289                           ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     3290       IF ERROR-STATUS:ERROR
     3291       OR v-rid-list = '':U THEN DO:
     3292         RETURN.
     3293       END.
     3294       FIND FIRST buf_dis-cfg-rule NO-LOCK where
     3295                 recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
     3296       run set-region in this-procedure ( buffer buf_dis-cfg-rule
     3297                                       , OUTPUT v-host-code
     3298                                       , output v-obj-type
     3299                                       , output v-obj-code).
     3300       run temp-dsc-write in this-procedure (
     3301                                               input yes
     3302                                              ,input buf_dis-cfg-rule.pos-type
     3303                                              ,input buf_dis-cfg-rule.templ-rl-root
     3304                                              ,input buf_dis-cfg-rule.time-templ-rl-root
     3305                                              ,input buf_dis-cfg-rule.discnt-role
     3306                                              ,input buf_dis-cfg-rule.nonunique
     3307                                              ,input v-host-code
     3308                                              ,input v-obj-type
     3309                                              ,input v-obj-code
     3310                                              ,input v-rule-num
     3311                                              ,input no
     3312                                              ,input-output v-rec
     3313                                                  )  no-error.
     3314        IF ERROR-STATUS:ERROR THEN DO:
     3315         if return-value = "not-set" then do:
     3316         end.
     3317         else do:
     3318           message "Ошибка при определении названия и типа скидки !"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3319           return error.
     3320         end.
     3321       END.
     3322     END.
     3323   END CASE.
     3324   updated = yes.
     3325   find first buf_temp-disc no-lock where
     3326             recid(buf_temp-disc) = v-rec no-error .
     3327   if avail buf_temp-disc then
     3328     temp-doc-rec = recid(buf_temp-disc).
     3329     else temp-doc-rec = ?.
     3330   Run init-proc in this-procedure .
     3331   reposition BR-del to recid temp-doc-rec no-error.
     3332   if error-status:error then return error.
     3333   run proc-b-chg-2 in this-procedure ( input "":U) no-error.
     3334   if error-status:error then do:
     3335       run temp-dsc-delete in this-procedure (
     3336                                                input buf_dis-cfg-rule.pos-type
     3337                                               ,input buf_dis-cfg-rule.discnt-role
     3338                                               ,input buf_dis-cfg-rule.nonunique
     3339                                               ,input v-host-code
     3340                                               ,input v-obj-type
     3341                                               ,input v-obj-code
     3342                                               ,input no
     3343                                               ,output v-deleted
     3344                                               ) no-error .
     3345     Run init-proc in this-procedure no-error.
     3346     undo, return error.
     3347   end.
     3348   APPLY "ENTRY" to br-del in frame Dialog-Frame .
     3349   END PROCEDURE.
     3350   PROCEDURE proc-b-chg :
     3351   define input parameter p-mode as character no-undo .
     3352   define variable v-rule-num as integer no-undo .
     3353   define variable v-nonunique as character no-undo .
     3354   define variable v-rec as recid no-undo .
     3355   if not avail temp-disc then return error.
     3356     RUN temp-dsc-VALUE IN THIS-PROCEDURE (
     3357                                          input temp-disc.pos-type
     3358                                         ,input temp-disc.templ-rl-root
     3359                                         ,input temp-disc.time-templ-rl-root
     3360                                         ,input temp-disc.discnt-role
     3361                                         ,input temp-disc.cfg-nonunique
     3362                                         ,input temp-disc.host-code
     3363                                         ,input temp-disc.obj-type
     3364                                         ,input temp-disc.obj-code
     3365                                         ,input 'ДОБАВЛЕНИЕ':U
     3366                                         ,input p-mode
     3367                                         ,input recid(temp-disc)
     3368                                         ,OUTPUT v-rule-num
     3369                                         ,output v-nonunique
     3370                                         ) NO-ERROR.
     3371     IF ERROR-STATUS:ERROR THEN DO:
     3372       if return-value <> "not-set":U then do:
     3373         message "Ошибка при определении значения скидки !"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3374         RETURN error.
     3375       end.
     3376       RETURN error.
     3377     END.
     3378     if return-value = "not-set":U
     3379     and p-mode <> "change":U then do:
     3380       delete temp-disc.
     3381       glog = br-add:refresh() in frame Dialog-Frame no-error .
     3382       return .
     3383     end.
     3384     v-rec = recid(temp-disc).
     3385     run temp-dsc-write (
     3386                          input no
     3387                         ,input temp-disc.pos-type
     3388                         ,input temp-disc.templ-rl-root
     3389                         ,input temp-disc.time-templ-rl-root
     3390                         ,input temp-disc.discnt-role
     3391                         ,input temp-disc.cfg-nonunique
     3392                         ,input temp-disc.host-code
     3393                         ,input temp-disc.obj-type
     3394                         ,input temp-disc.obj-code
     3395                         ,input v-rule-num
     3396                         ,input temp-disc.action
     3397                         ,input-output v-rec
     3398                         ) no-error.
     3399     IF not error-status:error then do:
     3400       assign
     3401       updated = yes
     3402       .
     3403     END.
     3404     glog = br-add:refresh() in frame Dialog-Frame no-error .
     3405     APPLY "ENTRY" to br-add.
     3406   END PROCEDURE.
     3407   PROCEDURE proc-b-chg-2 :
     3408   define input parameter p-mode as character no-undo .
     3409   define variable v-rule-num as integer no-undo .
     3410   define variable v-nonunique as character no-undo .
     3411   define variable v-rec as recid no-undo .
     3412   if not avail del_temp-disc then return error.
     3413     RUN temp-dsc-VALUE IN THIS-PROCEDURE (
     3414                                          input del_temp-disc.pos-type
     3415                                         ,input del_temp-disc.templ-rl-root
     3416                                         ,input del_temp-disc.time-templ-rl-root
     3417                                         ,input del_temp-disc.discnt-role
     3418                                         ,input del_temp-disc.cfg-nonunique
     3419                                         ,input del_temp-disc.host-code
     3420                                         ,input del_temp-disc.obj-type
     3421                                         ,input del_temp-disc.obj-code
     3422                                         ,input 'удаление':U
     3423                                         ,input p-mode
     3424                                         ,input recid(del_temp-disc)
     3425                                         ,OUTPUT v-rule-num
     3426                                         ,output v-nonunique
     3427                                         ) NO-ERROR.
     3428     IF ERROR-STATUS:ERROR THEN DO:
     3429       if return-value <> "not-set":U then do:
     3430         message "Ошибка при определении значения скидки !"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3431         RETURN error.
     3432       end.
     3433       RETURN error.
     3434     END.
     3435     if return-value = "not-set":U
     3436     and p-mode <> "change":U then do:
     3437       delete del_temp-disc.
     3438       glog = br-del:refresh() in frame Dialog-Frame no-error .
     3439       return .
     3440     end.
     3441     v-rec = recid(del_temp-disc).
     3442     run temp-dsc-write (
     3443                          input no
     3444                         ,input del_temp-disc.pos-type
     3445                         ,input del_temp-disc.templ-rl-root
     3446                         ,input del_temp-disc.time-templ-rl-root
     3447                         ,input del_temp-disc.discnt-role
     3448                         ,input del_temp-disc.cfg-nonunique
     3449                         ,input del_temp-disc.host-code
     3450                         ,input del_temp-disc.obj-type
     3451                         ,input del_temp-disc.obj-code
     3452                         ,input v-rule-num
     3453                         ,input del_temp-disc.action
     3454                         ,input-output v-rec
     3455                         ) no-error.
     3456     IF not error-status:error then do:
     3457       assign
     3458       updated = yes
     3459       .
     3460     END.
     3461     glog = br-del:refresh() in frame Dialog-Frame no-error .
     3462     APPLY "ENTRY" to br-del.
     3463   END PROCEDURE.
     3464   PROCEDURE proc-b-exit :
     3465   define variable loc#log as logical no-undo .
     3466   define variable v-not-all-ok as logical no-undo .
     3467   define variable v-host-code as integer no-undo .
     3468   define buffer buf_dis-rule for ub.dis-rule.
     3469   define buffer buf_temp-disc for temp-disc.
     3470   if not can-find(first temp-disc) then do:
     3471       message "Вы не определили список скидок для изменения (добавления, удаления)"
     3472       view-as alert-box.
     3473       return no-apply.
     3474   end.
     3475   ASSIGN
     3476   FRAME Dialog-Frame t-delete-ok.
     3477   CASE par-subject:
     3478     when 'dis-dc-rule':U then do:
     3479       if not can-find(first dc-list) then do:
     3480         message "Вы не определили список ДК"
     3481         view-as alert-box.
     3482         return no-apply.
     3483       end.
     3484   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3485   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3486     (input  p-obj-type
     3487     ,input  p-obj-code
     3488     ,output v-host-code
     3489     )  .
     3490       for each buf_temp-disc:
     3491         if buf_temp-disc.action = yes then do:
     3492           find first buf_dis-rule no-lock where
     3493                     buf_Dis-rule.rule-num = buf_temp-disc.rule-num no-error.
     3494           if not available buf_dis-rule
     3495           or (buf_Dis-rule.obj-code > 0
     3496           and not (
     3497                   buf_dis-rule.obj-type = p-obj-type
     3498                   and
     3499                   buf_dis-rule.obj-code = p-obj-code)
     3500                 )
     3501           or (buf_Dis-rule.host-code > 0
     3502           and not (
     3503                   buf_dis-rule.host-code = v-host-code)
     3504                 )
     3505           or not (buf_dis-rule.sts = integer('0':U)) then do:
     3506                 if buf_dis-rule.obj-code > 0 then do:
     3507               message
     3508               substitute("&1 &2&3: значение кода правила скидки должно указывать&4" +
     3509                           "на существующее правило в статусе &5 и принадлежащее &2&3"
     3510                           ,entry (lookup (buf_temp-disc.discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u)
     3511                           ,p-obj-type
     3512                           ,p-obj-code
     3513                           ,chr(10)
     3514                           ,entry (lookup ('0':U, '0,1,50,99':U), 'тек,удал,блок,удаление':U)
     3515                           )
     3516               view-as alert-box error .
     3517               undo, return error .
     3518             end.
     3519             else do:
     3520               message
     3521               substitute("&1 фирма &2: значение кода правила скидки должно указывать&3" +
     3522                           "на существующее правило в статусе &4 и принадлежащее фирме &2"
     3523                           ,entry (lookup (buf_temp-disc.discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u)
     3524                           ,v-host-code
     3525                           ,chr(10)
     3526                           ,entry (lookup ('0':U, '0,1,50,99':U), 'тек,удал,блок,удаление':U)
     3527                           )
     3528               view-as alert-box error .
     3529               undo, return error .
     3530             end.
     3531           end.
     3532         end.
     3533       end.
     3534       message
     3535       "Вы уверены, что Вы хотите провести изменение (добавление, удаление) скидок по отдельным ДК" SKIP
     3536       "всего определенного Вами списка?"
     3537       view-as alert-box QUESTION buttons YES-NO update loc#log.
     3538       if loc#log then do:
     3539         run str/diallog.w (
     3540                 input parparentproc
     3541               , input this-procedure
     3542               , input "ref/ddcr-lst.p":U
     3543               , input (string(p-host-code) + chr(4) + p-obj-type + chr(4) + string(p-obj-code) + chr(4) + string(t-delete-ok))
     3544               , input no
     3545               , input "&Стоп":U
     3546               , input substitute("Изменение скидок на отдельные ДК (фирма &1 объект &2&3) по списку ДК"
     3547                                   , p-host-code
     3548                                   , p-obj-type
     3549                                   , p-obj-code
     3550                                   )
     3551           ) no-error.
     3552         assign
     3553         v-not-all-ok = can-find(first dc-list).
     3554       end.
     3555     end.
     3556   END CASE.
     3557   if v-not-all-ok and t-delete-ok then do:
     3558     assign
     3559     b-list:width = 30
     3560     b-list:label = "Список неизменившихся".
     3561   end.
     3562   END PROCEDURE.
     3563   PROCEDURE proc-b-obj :
     3564   define variable v-user-select as logical   no-undo .
     3565   define variable v-obj-type    as character no-undo .
     3566   define variable v-obj-code    as integer   no-undo .
     3567   define variable v-host-code as integer   no-undo .
     3568   define buffer buf_clients-obj for ub.clients.
     3569   define buffer buf_temp-disc for temp-disc.
     3570   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3572     (input  p-obj-type
     3573     ,input  p-obj-code
     3574     ,output v-host-code
     3575     )  .
     3576   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3577   run userobjs_select-one in this-procedure
     3578     (input  parparentproc
     3579     ,input  v-cntxt-db-num
     3580     ,input  v-cntxt-userid
     3581     ,input  v-host-code
     3582     ,input  p-obj-type
     3583     ,input  p-obj-code
     3584     ,output v-user-select
     3585     ,output v-obj-type
     3586     ,output v-obj-code
     3587     )  .
     3588   if v-user-select <> true
     3589   then do:
     3590     message
     3591     "Объект не выбран"
     3592     view-as alert-box information .
     3593     undo, return error return-value .
     3594   end.
     3595   find first buf_clients-obj no-lock
     3596     where buf_clients-obj.obj-type = v-obj-type
     3597       and buf_clients-obj.obj-code = v-obj-code
     3598       no-error.
     3599   if not avail buf_clients-obj
     3600   then do:
     3601     message
     3602       "Не найден объект!" skip
     3603       view-as alert-box error.
     3604     return no-apply.
     3605   end.
     3606   find first X_clients-obj no-lock where recid(X_clients-obj) = recid(buf_clients-obj).
     3607   assign
     3608   p-obj-type =  X_clients-obj.obj-type
     3609   p-obj-code = X_clients-obj.obj-code
     3610   RS-obj-type = X_clients-obj.obj-type
     3611   f-obj-code = X_clients-obj.obj-code
     3612   f-obj-name  = X_clients-obj.obj-name
     3613   .
     3614   display
     3615   rs-obj-type
     3616   f-obj-code
     3617   f-obj-name
     3618   with frame Dialog-Frame.
     3619   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3621     (input  p-obj-type
     3622     ,input  p-obj-code
     3623     ,output v-host-code
     3624     )  .
     3625   for each buf_temp-disc :
     3626     if (buf_temp-disc.obj-type = 'маг':U
     3627     or buf_temp-disc.obj-type = 'скл':U )
     3628     and not (buf_temp-disc.obj-type = p-obj-type
     3629              and
     3630              buf_temp-disc.obj-code = p-obj-code)
     3631     then do:
     3632       delete buf_temp-disc.
     3633       next.
     3634     end.
     3635     if buf_temp-disc.host-code <> v-host-code then delete buf_temp-disc.
     3636   end.
     3637   RUN proc-title IN THIS-PROCEDURE.
     3638   OPEN QUERY BR-add FOR EACH temp-disc where temp-disc.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-disc where del_temp-disc.action = no NO-LOCK.
     3639   END PROCEDURE.
     3640   PROCEDURE proc-title :
     3641   IF p-obj-type = 'маг':U THEN DO:
     3642   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3643   define variable v-param-type26 as character no-undo .
     3644   define variable v-value-date26 as date no-undo .
     3645   define variable v-value-decimal26 as decimal no-undo .
     3646   define variable v-value-integer26 as INTEGER no-undo .
     3647   define variable v-value-logical26 AS LOGICAL no-undo .
     3648   define variable v-tth26 as handle no-undo .
     3649   run adm/shattri.p (
     3650       input "get":U
     3651       ,input  p-obj-type
     3652       ,input  p-obj-code
     3653       ,input  'cd-sending':U
     3654       ,input  'dflt-cd':U
     3655       ,output dflt-cd
     3656       ,output v-value-date26
     3657       ,output v-value-decimal26
     3658       ,output v-value-integer26
     3659       ,output v-value-logical26
     3660       ,output v-param-type26
     3661       ,INPUT-OUTPUT table-handle v-tth26
     3662       )  .
     3663   delete object v-tth26 no-error.
     3664   END.
     3665   if p-obj-type = 'скл':U then do:
     3666     dflt-cd = '-':U.
     3667   end.
     3668   ASSIGN
     3669   MENU-ITEM m_pos-type:LABEL IN MENU menu-b-add  = dflt-cd
     3670   MENU-ITEM m_pos-type:sensitive IN MENU menu-b-add  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     3671   MENU-ITEM m_pos-type-2:LABEL IN MENU menu-b-add-2  = dflt-cd
     3672   MENU-ITEM m_pos-type-2:sensitive IN MENU menu-b-add-2  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     3673   .
     3674   CASE par-subject:
     3675     WHEN 'dis-dc-rule':U THEN DO:
     3676       frame Dialog-Frame:title = substitute("Изменение скидок на отдельные ДК &1&2 по списку ДК"
     3677                                             ,p-obj-type
     3678                                             ,p-obj-code) .
     3679       assign
     3680       v-tab-order = "b-exit,b-quit,b-list,b-help,rs-obj-type,f-obj-code,b-obj,T-delete-ok,b-add,b-add-2".
     3681     END.
     3682   END CASE.
     3683   APPLY "ENTRY" TO b-add IN FRAME Dialog-Frame.
     3684   END PROCEDURE.
     3685   PROCEDURE proc-write :
     3686   END PROCEDURE.
     3687   PROCEDURE set-region :
     3688   DEFINE PARAMETER BUFFER buf_dis-cfg-rule FOR ub.dis-cfg-rule.
     3689   DEFINE OUTPUT PARAMETER v-host-code AS integer NO-UNDO.
     3690   DEFINE OUTPUT PARAMETER v-obj-type AS CHARACTER NO-UNDO.
     3691   DEFINE OUTPUT PARAMETER v-obj-code AS integer NO-UNDO.
     3692   define variable v-sel-vals as character no-undo .
     3693   define variable v-sel-labels as character no-undo .
     3694   define variable var-region as character no-undo .
     3695     if (buf_dis-cfg-rule.has-global +
     3696         buf_dis-cfg-rule.has-host +
     3697         buf_dis-cfg-rule.has-obj) > 1 then do:
     3698       assign
     3699       v-sel-vals = v-sel-vals +
     3700                     (if buf_dis-cfg-rule.has-global = 1
     3701                     then (fill(chr(32), 3)  + string(0) + chr(44))
     3702                     else "":U)
     3703       v-sel-labels = v-sel-labels +
     3704                     (if buf_dis-cfg-rule.has-global  = 1
     3705                     then ("Глобально" + chr(44))
     3706                     else "":U)
     3707       .
     3708       assign
     3709       v-sel-vals = v-sel-vals +
     3710                     (if buf_dis-cfg-rule.has-host = 1
     3711                     then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(44))
     3712                     else "":U)
     3713       v-sel-labels = v-sel-labels +
     3714                     (if buf_dis-cfg-rule.has-host = 1
     3715                     then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(44))
     3716                     else "":U)
     3717       .
     3718       assign
     3719       v-sel-vals = v-sel-vals +
     3720                     (if buf_dis-cfg-rule.has-obj = 1
     3721                     then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     3722                     else "":U)
     3723       v-sel-labels = v-sel-labels +
     3724                     (if buf_dis-cfg-rule.has-obj = 1
     3725                     then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     3726                     else "":U)
     3727       .
     3728       run gbl/d-list.w (
     3729                           input "b-sel":U
     3730                           ,input "Выберите область действия"
     3731                           ,input v-sel-vals
     3732                           ,input v-sel-labels
     3733                           ,input chr(44)
     3734                           ,input "":U
     3735                           ,output var-region) no-error.
     3736       if error-status:error then do:
     3737         return error.
     3738       end.
     3739       assign
     3740       v-obj-type = substring(var-region, 1, 3)
     3741       v-obj-code = integer(substring(var-region, 4))
     3742       v-host-code = (IF v-obj-type = "" THEN 0 ELSE v-obj-code)
     3743       v-obj-code = (IF v-obj-type = 'маг':U
     3744                      OR v-obj-type = 'скл':U
     3745                      THEN p-obj-code
     3746                      ELSE 0)
     3747       v-obj-type = (IF v-obj-type = 'маг':U
     3748                      OR v-obj-type = 'скл':U
     3749                      THEN p-obj-type
     3750                      ELSE '':U)
     3751       .
     3752     end.
     3753     else do:
     3754       if buf_dis-cfg-rule.has-obj = 1 then do:
     3755         assign
     3756         v-obj-type = p-obj-type
     3757         v-obj-code = p-obj-code
     3758         .
     3759   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3760   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3761     (input  p-obj-type
     3762     ,input  p-obj-code
     3763     ,output v-host-code
     3764     )  .
     3765       end.
     3766       if buf_dis-cfg-rule.has-host = 1 then do:
     3767   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3768   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3769     (input  p-obj-type
     3770     ,input  p-obj-code
     3771     ,output v-host-code
     3772     )  .
     3773         assign
     3774         v-obj-type = "":U
     3775         v-obj-code = 0
     3776         .
     3777       end.
     3778       if buf_dis-cfg-rule.has-glob = 1 then do:
     3779         assign
     3780         v-host-code = 0
     3781         v-obj-type = '':U
     3782         v-obj-code = 0
     3783         .
     3784       end.
     3785     end.
     3786   END PROCEDURE.
     3787   FUNCTION dis-dc-rule-name RETURNS CHARACTER
     3788     ( INPUT p-discnt-role AS character ) :
     3789   DEFINE variable v-dis-dc-rule-name AS CHARACTER NO-UNDO.
     3790   v-dis-dc-rule-name = entry (lookup (p-discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u).
     3791   RETURN v-dis-dc-rule-name.
     3792   END FUNCTION.
