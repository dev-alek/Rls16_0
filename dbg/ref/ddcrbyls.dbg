     1487   ON LEAVE OF f-obj-code IN FRAME Dialog-Frame
     1488   DO:
     1489   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1490   if lookup(self :type
     1491            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1492            ) = 0
     1493   then do:
     1494     message
     1495       "$Workfile$"
     1496       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1497       "Интерфейсный элемент" self :name  skip
     1498       "Тип" self :type  skip
     1499       "Процедура" this-procedure :file-name skip
     1500       view-as alert-box .
     1501   end.
     1502   else do:
     1503     apply "entry":u to self  .
     1504     if focus :handle <> self :handle  then do:
     1505       return no-apply .
     1506     end.
     1507   end.
     1508     if   input frame Dialog-Frame f-obj-code <> 0 then do:
     1509       run check-obj in this-procedure no-error.
     1510       if error-status:error then do:
     1511          return no-apply.
     1512       end.
     1513     end.
     1514   END.
