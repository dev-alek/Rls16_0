      155   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      156   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      157   def var vl_bin as char no-undo init "".
      158   if vl_int < 0 OR vl_int = ? then return ?.
      159   do while vl_int > 0:
      160     assign
      161     vl_bin = (if vl_int modulo 2 = 0
      162                 then "0":U
      163                 else "1":U) + vl_bin
      164     vl_int = truncate(vl_int / 2,0).
      165   end.
      166   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      167   END FUNCTION.
      168   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      169                                    input vl_binm as character):
      170   DEFINE VARIABLE vl_bin as character no-undo.
      171   DEFINE VARIABLE ii as integer no-undo.
      172   DEFINE VARIABLE ii-len as integer no-undo.
      173   DEFINE VARIABLE ii-lenm as integer no-undo.
      174   DEFINE VARIABLE mchar as character no-undo.
      175   DEFINE VARIABLE ichar as character no-undo.
      176   if vl_binm = ? then return ?.
      177   vl_bin = CIntBinS(vl_int).
      178   if vl_bin = ? then return ?.
      179   assign
      180   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      181   ii-lenm = LENGTH(vl_binm)
      182   ii-len = LENGTH(vl_bin) - ii-lenm
      183   .
      184   if II-LENM > 32 THEN RETURN ?.
      185   DO II = 1 to II-LENm:
      186     assign
      187     mchar = SUBSTR(vl_binm, ii, 1)
      188     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      189     .
      190     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      191     IF ichar <> mchar AND mchar <> "X":U then return no.
      192   END.
      193   return yes.
      194   END FUNCTION.
      195   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   define NEW SHARED temp-table temp-disc no-undo
      197   field rule-num as integer
      198   field host-code as integer
      199   field obj-type as character
      200   field obj-code as integer
      201   field templ-rl-root as integer
      202   field time-templ-rl-root as integer
      203   field discnt-role as character
      204   field nonunique as character
      205   field cfg-nonunique as character
      206   field pos-type as character
      207   field action as logical
      208   field label_ as character
      209   index pi is  unique primary
      210   pos-type discnt-role nonunique host-code obj-type obj-code action ASCENDING
      211   index action
      212   action
      213   index ipos
      214   pos-type discnt-role
      215   .
      216   procedure temp-dsc-value :
      217   define input  parameter p-pos-type  as character  no-undo .
      218   define input  parameter p-templ-rl-root as integer  no-undo .
      219   define input  parameter p-time-templ-rl-root as integer no-undo .
      220   define input  parameter p-discnt-role  as character  no-undo .
      221   define input  parameter p-cfg-nonunique as character no-undo .
      222   define input  parameter p-host-code as integer no-undo .
      223   define input  parameter p-obj-type  as character no-undo .
      224   define input  parameter p-obj-code as integer no-undo .
      225   define input  parameter p-0mode as character no-undo .
      226   define input  parameter p-mode      as character no-undo .
      227   define input  parameter p-rec as recid no-undo .
      228   define output parameter p-rule-num    as integer no-undo .
      229   define output parameter p-nonunique   as character no-undo .
      230   define buffer buf_temp-disc for temp-disc .
      231   define variable v-discnt-role as character no-undo .
      232   define variable v-rule-num as integer no-undo .
      233   define variable v-nonunique as character no-undo .
      234   define variable v-templ-rl-root as integer no-undo .
      235   define variable v-time-templ-rl-root as integer no-undo .
      236   define variable v-setted         as logical   no-undo .
      237   define variable choice as integer no-undo .
      238   do
      239   on error undo, return error
      240   :
      241     case 'dis-dc-rule':U:
      242       when 'dis-gds-rule':U
      243       then do:
      244         run discfgru-check  in this-procedure (
      245                                                  input 'dis-gds-rule':U
      246                                                 ,input p-templ-rl-root
      247                                                 ,input p-time-templ-rl-root
      248                                                 ,input p-pos-type
      249                                                 ,output v-discnt-role) no-error.
      250       end.
      251       when 'dis-dc-rule':U then do:
      252         run discfgru-check  in this-procedure (
      253                                                  input 'dis-dc-rule':U
      254                                                 ,input p-templ-rl-root
      255                                                 ,input p-time-templ-rl-root
      256                                                 ,input p-pos-type
      257                                                 ,output v-discnt-role) no-error.
      258       end.
      259       when 'dis-cp-rule':U then do:
      260         run discfgru-check  in this-procedure (
      261                                                  input 'dis-cp-rule':U
      262                                                 ,input p-templ-rl-root
      263                                                 ,input p-time-templ-rl-root
      264                                                 ,input p-pos-type
      265                                                 ,output v-discnt-role) no-error.
      266       end.
      267       otherwise do:
      268         undo, return error .
      269       end.
      270     end case.
      271     if error-status :error
      272     then do:
      273       undo, return error return-value .
      274     end.
      275     if p-mode = "change":U
      276     then do:
      277       if p-rec <> ? then do:
      278         find first buf_temp-disc no-lock where
      279               recid(buf_temp-disc) = p-rec
      280           no-error .
      281       end.
      282       else do:
      283         find first buf_temp-disc no-lock where
      284                   buf_temp-disc.pos-type = p-pos-type
      285               and buf_temp-disc.discnt-role = p-discnt-role
      286               and buf_temp-disc.nonunique  = p-nonunique
      287               and buf_temp-disc.host-code = p-host-code
      288               and buf_temp-disc.obj-type = p-obj-type
      289               and buf_temp-disc.obj-code = p-obj-code
      290           no-error .
      291       end.
      292       if avail buf_temp-disc then do:
      293         assign
      294         v-rule-num =  buf_temp-disc.rule-num
      295         v-nonunique = buf_temp-disc.nonunique
      296         v-templ-rl-root = buf_temp-disc.templ-rl-root
      297         v-time-templ-rl-root = buf_temp-disc.time-templ-rl-root
      298         .
      299       end.
      300     end.
      301     CASE 'dis-dc-rule':U:
      302       when 'dis-dc-rule':U then do:
      303         run disdcrul-edit in this-procedure (
      304                                      input 'ИЗМЕНЕНИЕ':U
      305                                     ,input '':U
      306                                     ,input p-host-code
      307                                     ,input p-obj-type
      308                                     ,input p-obj-code
      309                                     ,INPUT p-pos-type
      310                                     ,input p-discnt-role
      311                                     ,input p-templ-rl-root
      312                                     ,input p-time-templ-rl-root
      313                                     ,input p-cfg-nonunique
      314                                     ,input 1
      315                                     ,input-output v-rule-num
      316                                     ,input-output v-nonunique
      317                                     ,output v-setted ) no-error.
      318         if error-status :error then do:
      319           undo, return error substitute("Ошибка при получения значения скидки по отдельной ДК:&1" +
      320                                         "место использ. &2 тип скидки &3"
      321                                         , chr(10)
      322                                         , p-pos-type
      323                                         , entry (lookup (p-discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u)).
      324         end.
      325       end.
      326     END CASE.
      327     if v-setted = no then do:
      328       return "not-set":U.
      329     end.
      330     p-rule-num = v-rule-num.
      331     p-nonunique = v-nonunique.
      332   end.
      333   end procedure.
      334   procedure temp-dsc-write :
      335     do
      336     on error undo, return error
      337     :
      338       define input parameter p-add      as logical no-undo .
      339       define input parameter p-pos-type as character  no-undo .
      340       define input parameter p-templ-rl-root as integer  no-undo .
      341       define input parameter p-time-templ-rl-root as integer  no-undo .
      342       define input parameter p-discnt-role as character  no-undo .
      343       define input parameter p-cfg-nonunique as character no-undo .
      344       define input parameter p-host-code as integer no-undo .
      345       define input parameter p-obj-type as character no-undo .
      346       define input parameter p-obj-code as integer no-undo .
      347       define input parameter p-rule-num  as integer no-undo .
      348       define input parameter p-action   like temp-disc.action no-undo .
      349       define input-output parameter p-rec as recid no-undo .
      350       define buffer buf_temp-disc for temp-disc .
      351       define variable v-discnt-role as character no-undo .
      352       define variable varhost-code like ub.clients.host-code no-undo.
      353       define variable varobj-type like ub.clients.obj-type no-undo.
      354       define variable varobj-code like ub.clients.obj-code no-undo.
      355       define variable choice as integer no-undo .
      356       define var loc#log as logical no-undo.
      357       define variable loc-action as logical no-undo.
      358       define variable v-nonunique as character no-undo .
      359       define buffer buf_dis-rule for ub.dis-rule.
      360       case 'dis-dc-rule':U:
      361         when 'dis-gds-rule':U
      362         then do:
      363           run discfgru-check  in this-procedure (
      364                                                   input 'dis-gds-rule':U
      365                                                  ,input p-templ-rl-root
      366                                                  ,input p-time-templ-rl-root
      367                                                  ,input p-pos-type
      368                                                  ,output v-discnt-role) no-error.
      369         end.
      370         when 'dis-dc-rule':U
      371         then do:
      372           run discfgru-check  in this-procedure (
      373                                                   input 'dis-dc-rule':U
      374                                                  ,input p-templ-rl-root
      375                                                  ,input p-time-templ-rl-root
      376                                                  ,input p-pos-type
      377                                                  ,output v-discnt-role) no-error.
      378         end.
      379         when 'dis-cp-rule':U
      380         then do:
      381           run discfgru-check  in this-procedure (
      382                                                   input 'dis-cp-rule':U
      383                                                  ,input p-templ-rl-root
      384                                                  ,input p-time-templ-rl-root
      385                                                  ,input p-pos-type
      386                                                  ,output v-discnt-role) no-error.
      387         end.
      388         otherwise do:
      389           undo, return error .
      390         end.
      391       END CASE.
      392       if error-status :error then do:
      393         undo, return error return-value .
      394       end.
      395       if p-cfg-nonunique <> '':U
      396       and p-rule-num <> 0
      397       and p-rule-num <> ?
      398       then do:
      399         find first buf_dis-rule no-lock where
      400                 buf_dis-rule.rule-num = p-rule-num no-error.
      401         if not available buf_dis-rule then do:
      402           undo, return error substitute("Не найдено правило скидок &1", p-rule-num).
      403         end.
      404         assign
      405         v-nonunique = (if p-cfg-nonunique = '':U
      406                       then '':U
      407                       else (if p-cfg-nonunique begins "@"
      408                             then left-trim(p-cfg-nonunique, "@")
      409                             else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value)
      410                             ))
      411         .
      412       end.
      413       if p-rec <> ? then do:
      414         find first buf_temp-disc exclusive-lock where
      415                   recid(buf_temp-disc) = p-rec no-error .
      416       end.
      417       else do:
      418         find first buf_temp-disc exclusive-lock where
      419                   buf_temp-disc.pos-type = p-pos-type
      420                 and buf_temp-disc.discnt-role = p-discnt-role
      421                 and buf_temp-disc.host-code = p-host-code
      422                 and buf_temp-disc.obj-type = p-obj-type
      423                 and buf_temp-disc.obj-code = p-obj-code
      424                 and buf_temp-disc.nonunique = v-nonunique
      425                 no-error .
      426       end.
      427       if not available buf_temp-disc then do:
      428         create buf_temp-disc .
      429         assign
      430         buf_temp-disc.host-code = p-host-code
      431         buf_temp-disc.obj-type = p-obj-type
      432         buf_temp-disc.obj-code = p-obj-code
      433         buf_temp-disc.rule-num = p-rule-num
      434         buf_temp-disc.action = p-action
      435         buf_temp-disc.pos-type = p-pos-type
      436         buf_temp-disc.discnt-role = p-discnt-role
      437         buf_temp-disc.cfg-nonunique = p-cfg-nonunique
      438         buf_temp-disc.rule-num = p-rule-num
      439         buf_temp-disc.nonunique = v-nonunique
      440         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
      441         buf_temp-disc.templ-rl-root = p-templ-rl-root
      442         p-rec = recid(buf_temp-disc)
      443         no-error
      444         .
      445       end.
      446       ELSE do:
      447         if p-add then do:
      448            message
      449            substitute("Такая скидка уже добавлена&1"
      450                       ,chr(10)
      451                   )
      452            view-as alert-box error .
      453           undo, return error "not-set" .
      454         end.
      455         ASSIGN
      456         buf_temp-disc.rule-num = p-rule-num
      457         buf_temp-disc.nonunique = v-nonunique
      458         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
      459         buf_temp-disc.templ-rl-root = p-templ-rl-root
      460         p-rec = recid(buf_temp-disc)
      461         no-error.
      462       end.
      463     end.
      464   end procedure.
      465   procedure temp-dsc-exist :
      466   define input parameter p-pos-type as character  no-undo .
      467   define input parameter p-templ-rl-root as integer  no-undo .
      468   define input parameter p-time-templ-rl-root as integer no-undo .
      469   define input parameter p-discnt-role as character  no-undo .
      470   define input parameter p-nonunique as character no-undo .
      471   define input parameter p-host-code as integer no-undo .
      472   define input parameter p-obj-type as character no-undo .
      473   define input parameter p-obj-code as integer no-undo .
      474   define output parameter p-exist    as logical no-undo .
      475   define output parameter p-action as logical no-undo .
      476   define variable v-discnt-role as character no-undo .
      477   define buffer buf_temp-disc for temp-disc .
      478     do
      479     on error undo, return error
      480     :
      481       case 'dis-dc-rule':U:
      482         when 'dis-gds-rule':U then do:
      483           run discfgru-check  in this-procedure (
      484                                                   input 'dis-gds-rule':U
      485                                                  ,input p-templ-rl-root
      486                                                  ,input p-time-templ-rl-root
      487                                                  ,input p-pos-type
      488                                                  ,output v-discnt-role) no-error.
      489         end.
      490         when 'dis-dc-rule':U then do:
      491           run discfgru-check  in this-procedure (
      492                                                   input 'dis-dc-rule':U
      493                                                  ,input p-templ-rl-root
      494                                                  ,input p-time-templ-rl-root
      495                                                  ,input p-pos-type
      496                                                  ,output v-discnt-role) no-error.
      497         end.
      498         otherwise do:
      499           undo, return error .
      500         end.
      501       end case.
      502       if error-status :error
      503       then do:
      504         undo, return error return-value .
      505       end.
      506       find first buf_temp-disc no-lock where
      507                  buf_temp-disc.pos-type = p-pos-type
      508               and buf_temp-disc.discnt-role = p-discnt-role
      509               and buf_temp-disc.host-code = p-host-code
      510               and buf_temp-disc.obj-type = p-obj-type
      511               and buf_temp-disc.obj-code = p-obj-code
      512               and buf_temp-disc.nonunique = p-nonunique no-error .
      513       if available buf_temp-disc then do:
      514         P-EXIST = YES.
      515         p-action = buf_temp-disc.action.
      516       end.
      517     end.
      518   end procedure.
      519   procedure temp-dsc-delete :
      520   define input parameter p-pos-type as character  no-undo .
      521   define input parameter p-discnt-role as character no-undo .
      522   define input parameter p-nonunique as character no-undo .
      523   define input parameter p-host-code  as integer no-undo .
      524   define input parameter p-obj-type as character no-undo .
      525   define input parameter p-obj-code as integer no-undo .
      526   define input parameter p-action as logical no-undo .
      527   define output parameter p-deleted  as logical no-undo .
      528   define buffer buf_temp-disc for temp-disc .
      529     do
      530     on error undo, return error :
      531       case 'dis-dc-rule':U:
      532         when 'dis-gds-rule':U
      533         then do:
      534           error-status:error = no.
      535         end.
      536         when 'dis-dc-rule':U
      537         then do:
      538           error-status:error = no.
      539         end.
      540         when 'dis-cp-rule':U
      541         then do:
      542           error-status:error = no.
      543         end.
      544         otherwise do:
      545           undo, return error .
      546         end.
      547       END CASE.
      548       if error-status :error then do:
      549         undo, return error return-value .
      550       end.
      551       find first buf_temp-disc exclusive-lock where
      552                  buf_temp-disc.pos-type = p-pos-type
      553              and buf_temp-disc.discnt-role = p-discnt-role
      554              and buf_temp-disc.host-code = p-host-code
      555              and buf_temp-disc.obj-type = p-obj-type
      556              and buf_temp-disc.obj-code = p-obj-code
      557              and buf_temp-disc.nonunique = p-nonunique
      558              and buf_temp-disc.action = p-action
      559              no-error .
      560       if not available buf_temp-disc then do:
      561         P-DELETED = NO.
      562       end.
      563       ELSE DO:
      564          delete buf_temp-disc.
      565          P-DELETED = YES.
      566       END.
      567     end.
      568   end procedure.
