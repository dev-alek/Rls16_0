      416   end.
      417   procedure proc-alt-shift-f3:
      418     run gbl/prvssinf.p
      419       ( input this-procedure
      420       ) .
      421   end.
      422   define variable v-inform-launched as logical no-undo initial false .
      423   procedure proc-alt-shift-f4:
      424     define variable v-action as character no-undo .
      425     if v-inform-launched = false then do:
      426       assign
      427         v-inform-launched = true
      428       .
      429       run gbl/d-inform.w
      430         (  input self
      431         ,  input this-procedure
      432         , output v-action
      433         ) no-error .
      434       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      435       assign
      436         v-inform-launched = false
      437       .
      438     end.
      439   end.
      440   procedure proc-alt-f1:
      441     run gbl/corrhelp.p
      442       (input this-procedure
      443       ) .
      444   end .
      445   on alt-shift-f2 anywhere do:
      446     run proc-alt-shift-f2.
      447   end.
      448   on alt-shift-f3 anywhere do:
      449     run proc-alt-shift-f3 in this-procedure .
      450   end.
      451   on alt-shift-f4 anywhere do:
      452     run proc-alt-shift-f4 in this-procedure.
      453   end.
      454   on alt-f1 anywhere do:
      455     run proc-alt-f1 in this-procedure .
      456   end.
      457   FUNCTION func-get-cost-price-rubl RETURNS CHARACTER
      458     ( p-gds-code as integer )  FORWARD.
      459   FUNCTION func-get-goods-artic RETURNS CHARACTER
      460     ( p-gds-code as integer )  FORWARD.
      461   DEFINE BUTTON b-change
      462        LABEL "&Изменить"
      463        SIZE 10 BY 1.
      464   DEFINE BUTTON b-exit
      465        LABEL "В&ыход"
      466        SIZE 10 BY 1
      467        BGCOLOR 8 .
      468   DEFINE BUTTON b-help
      469        LABEL "Помощ&ь"
      470        SIZE 10 BY 1
      471        BGCOLOR 8 .
      472   DEFINE VARIABLE ed-recipe-design AS CHARACTER
      473        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      474        SIZE 60.25 BY 2.04 NO-UNDO.
      475   DEFINE VARIABLE ed-recipe-quality AS CHARACTER
      476        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      477        SIZE 60.25 BY 2.04 NO-UNDO.
      478   DEFINE VARIABLE fi-d AS CHARACTER FORMAT "X(256)":U INITIAL "Показатели качества готовой продукции"
      479        VIEW-AS FILL-IN
      480        SIZE 49 BY 1 NO-UNDO.
      481   DEFINE VARIABLE fi-d-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Способ оформления блюда"
      482        VIEW-AS FILL-IN
      483        SIZE 49 BY 1 NO-UNDO.
      484   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Учетные цены ингредиентов для оценочной калькуляции"
      485        VIEW-AS FILL-IN
      486        SIZE 60.5 BY 1 NO-UNDO.
      487   DEFINE QUERY br-ingr-cost FOR
      488         recipe-gds SCROLLING.
      489   DEFINE BROWSE br-ingr-cost
      490     QUERY br-ingr-cost NO-LOCK DISPLAY
      491         recipe-gds.artic FORMAT "X(16)":U
      492         func-get-cost-price-rubl( gds-code ) COLUMN-LABEL "Цена" FORMAT "X(17)":U
      493       WITH NO-ROW-MARKERS SEPARATORS SIZE 60.5 BY 11.5 EXPANDABLE.
      494   DEFINE FRAME Dialog-Frame
      495        b-exit AT ROW 1.17 COL 2
      496        b-help AT ROW 1.17 COL 52.5
      497        fi-d AT ROW 2.63 COL 2.25 NO-LABEL
      498        ed-recipe-quality AT ROW 3.71 COL 2.25 NO-LABEL
      499        fi-d-2 AT ROW 5.92 COL 2.38 NO-LABEL
      500        ed-recipe-design AT ROW 7.04 COL 2.25 NO-LABEL
      501        FILL-IN-1 AT ROW 9.25 COL 2 NO-LABEL
      502        b-change AT ROW 10.5 COL 2
      503        br-ingr-cost AT ROW 11.75 COL 2
      504        SPACE(0.49) SKIP(0.24)
      505       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      506            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      507            TITLE "Дополнительные данные рецепта".
      508   ASSIGN
      509          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      510          FRAME Dialog-Frame:HIDDEN           = TRUE.
      511   ASSIGN
      512          FILL-IN-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      513   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      514   DO:
      515     APPLY "END-ERROR":U TO SELF.
      516   END.
      517   ON CHOOSE OF b-change IN FRAME Dialog-Frame
      518   DO:
      519       define variable v-attr-value        as character    no-undo.
      520       define variable v-new-attr-value    as character    no-undo.
      521       define variable v-new-cost-price    as decimal      no-undo.
      522       if available recipe-gds
      523       then do:
      524           assign
      525               v-attr-value        = func-get-cost-price-rubl( recipe-gds.gds-code )
      526               v-new-attr-value    = v-attr-value
      527           .
      528           define variable v-attr-type           as character no-undo .
      529           define variable v-attr-format         as character no-undo .
      530           define variable v-attr-label          as character no-undo .
      531           define variable v-attr-user-can-edit  as logical   no-undo .
      532           define variable v-attr-output-display as logical   no-undo .
      533           define variable v-attr-other          as character no-undo .
      534           run gdsoattr-name in this-procedure
      535             (input  'fbr-cost-rubl':U
      536             ,output v-attr-type
      537             ,output v-attr-format
      538             ,output v-attr-label
      539             ,output v-attr-user-can-edit
      540             ,output v-attr-output-display
      541             ,output v-attr-other
      542             ) .
      543           run gbl/d-prompt.w (
      544               input 'title=':u + "Изменение атрибута товара на объекте" + '\':u
      545                   + 'text1=':u + v-attr-label + '\':u
      546                   + 'format=' + v-attr-format + '\':u
      547                   + 'type=' + v-attr-type + '\':u
      548                   + 'fillin_row=2\':u
      549                   + 'fillin_col=4\':u
      550                   + 'fillin_width=20\':u
      551                   + 'fillin_height=1\':u
      552                   + 'max-chars=70\':u
      553                   + 'readonly=' + 'no':u + '\':u
      554               , input-output v-new-attr-value
      555           ).
      556           if return-value = 'false':u
      557           then do:
      558           end.
      559           else do:
      560               if v-new-attr-value <> v-attr-value
      561               then do:
      562                   assign
      563                       v-new-cost-price = decimal( v-new-attr-value )
      564                   no-error.
      565                   if error-status :error
      566                   then do:
      567                       assign
      568                           v-new-cost-price = 0.0
      569                           v-new-attr-value = v-attr-value
      570                       .
      571                   end.
      572                   else do:
      573                       run gdsoattr-write in this-procedure (
      574                             input recipe-gds.gds-code
      575                           , input p-store-type
      576                           , input p-store-code
      577                           , input 'fbr-cost-rubl':U
      578                           , input v-new-attr-value
      579                       ).
      580                       OPEN QUERY br-ingr-cost FOR EACH recipe-gds       WHERE recipe-gds.recipe-code = p-recipe-code NO-LOCK INDEXED-REPOSITION.
      581                   end.
      582               end.
      583           end.
      584       end.
      585   END.
      586   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      587   DO:
      588       assign
      589           p-out-recipe-quality = ed-recipe-quality :screen-value
      590           p-out-recipe-design  = ed-recipe-design  :screen-value
      591       .
      592       apply "GO" TO FRAME Dialog-Frame .
      593   END.
      594   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   on help of frame Dialog-Frame
      596   do:
      597     run gbl/app_help.p
      598       (input this-procedure :file-name
      599       ,input ''
      600       ,input ?
      601       ) no-error.
      602     if error-status :error then do:
      603       message
      604         "Ошибка при вызове помощи"
      605         error-status :get-message(1)
      606         view-as alert-box .
      607     end.
      608   end.
      609   run minbtn-set in this-procedure .
      610   on choose of b-help in frame Dialog-Frame
      611   do:
      612     apply "help":u to frame Dialog-Frame .
      613   end.
      614   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   procedure minbtn-set :
      616       do
      617           on error undo, return error return-value
      618           :
      619           define variable ii              as integer       no-undo .
      620           define variable fh              as widget-handle no-undo .
      621           define variable hh              as widget-handle no-undo .
      622           define variable v-h             as handle        extent 4 no-undo .
      623           define variable v-name-button   as character     no-undo .
      624           define variable v-help-old-x    as decimal       no-undo .
      625           define variable v-help-old-y    as decimal       no-undo .
      626           define variable v-help-old-size as decimal       no-undo .
      627           define variable v-frame-width   as decimal       no-undo .
      628           define variable jj              as integer       no-undo .
      629           do
      630               on error undo, return error
      631               :
      632               assign
      633                   v-frame-width = frame Dialog-Frame:width - 0.3
      634                   fh            = frame Dialog-Frame:first-child
      635                   hh            = fh:first-child
      636                   ii            = 1
      637                   .
      638               do while valid-handle(hh):
      639                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      640                   do:
      641                       case lc(hh:name) :
      642                           when "b-help" then
      643                               do:
      644                                   hh:load-image-up("cmp/b-help.bmp":u) .
      645                                   hh:load-image-down("cmp/b-help.bmp":u) .
      646                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      647                                   hh:TOOLTIP = "Помощь" .
      648                                   v-help-old-x = hh:column .
      649                                   v-help-old-y = hh:row    .
      650                                   v-help-old-size = hh:width .
      651                                   hh:width-chars = 2.5 .
      652                               end.
      653                           when "b-print" then
      654                               do:
      655                                   hh:load-image("cmp/b-print.bmp":u) .
      656                                   hh:TOOLTIP = "Печать" .
      657                                   v-h[ii] = hh:handle .
      658                                   ii = ii + 1 .
      659                                   hh:width-chars = 3 .
      660                               end.
      661                           when "b-history" or
      662                           when "b-hist" then
      663                               do:
      664                                   hh:load-image("cmp/b-hist.bmp":u) .
      665                                   hh:TOOLTIP = "История" .
      666                                   v-h[ii] = hh:handle .
      667                                   ii = ii + 1 .
      668                                   hh:width-chars = 3 .
      669                               end.
      670                           when "b-sch" then
      671                               do:
      672                                   hh:load-image("cmp/b-sch.bmp":u) .
      673                                   hh:TOOLTIP = "Установка Фильтра" .
      674                                   v-h[ii] = hh:handle .
      675                                   ii = ii + 1 .
      676                                   hh:width-chars = 3 .
      677                               end.
      678                           when "b-hist-user" then
      679                               do:
      680                                   hh:load-image("cmp/b-hist.bmp":u) .
      681                                   hh:TOOLTIP = "История пользователя" .
      682                                   ii = ii + 1 .
      683                               end.
      684                       end case.
      685                   end.
      686                   hh = hh:next-sibling.
      687               end.
      688               b-help:column = v-frame-width - b-help:width-chars.
      689               jj = 0.
      690               repeat ii = 4 to 1 by -1 :
      691                   if valid-handle (v-h[ii] ) then
      692                   do:
      693                       jj  = jj + 1 .
      694                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      695                       v-h[ii]:row    = v-help-old-y .
      696                   end.
      697               end.
      698           end.
      699       end.
      700   end procedure.
      701   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      702   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      703   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      704   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      705   define variable v-diasize-current-frame-width  as decimal   no-undo .
      706   define variable v-diasize-current-frame-height as decimal   no-undo .
      707   define variable v-diasize-change-size          as logical   no-undo .
      708   define variable v-diasize-resize-button        as handle    no-undo .
      709   define variable v-diasize-wndmax               as logical   no-undo .
      710   define variable v-diasize-wndstore             as logical   no-undo .
      711   define variable v-diasize-proc-name            as character no-undo .
      712   define variable v-diasize-browse-handle        as handle    no-undo .
      713   define variable v-diasize-browse-number        as integer   no-undo .
      714   define variable v-diasize-need-full-display    as logical   no-undo init false .
      715   define temp-table temp-diasize-handle no-undo
      716     field handle-value  as handle
      717     field save-position as decimal
      718     index xpk is primary unique handle-value
      719     .
      720   define temp-table temp-browse-handle no-undo
      721     field browse-type   as character
      722     field browse-number as integer
      723     field browse-handle as handle
      724     field original-size as decimal
      725     index xpk is primary unique browse-type browse-number
      726     index xie browse-type browse-handle
      727   .
      728   procedure diasize_change-height :
      729     define input  parameter p-change-value  as decimal   no-undo .
      730     define input  parameter p-move-resize   as logical   no-undo .
      731     define variable v-field-group-handle    as handle    no-undo .
      732     define variable v-object-handle         as handle    no-undo .
      733     define variable v-frame-height          as decimal   no-undo .
      734     define variable v-frame-virtual-height  as decimal   no-undo .
      735     define variable v-browse-height         as decimal   no-undo .
      736     define variable v-window-height         as decimal   no-undo .
      737     define variable v-window-virtual-height as decimal   no-undo .
      738     define variable v-change-sign           as integer   no-undo .
      739     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      740     define buffer buf_temp-browse-handle  for temp-browse-handle .
      741     if p-change-value > 0
      742     then do:
      743       if frame Dialog-Frame :height + p-change-value
      744           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      745       then do:
      746         assign
      747           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      748                           - (frame Dialog-Frame :height-chars)
      749         .
      750         if p-change-value <= 0
      751         then do:
      752           run diasize_position-resize-button in this-procedure .
      753           return .
      754         end.
      755       end.
      756     end.
      757     if p-change-value < 0
      758     then do:
      759       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      760       then do:
      761         assign
      762           p-change-value = v-diasize-orig-frame-height
      763                          - (frame Dialog-Frame :height-chars)
      764         .
      765         if p-change-value >= 0
      766         then do:
      767           run diasize_position-resize-button in this-procedure .
      768           return .
      769         end.
      770       end.
      771     end.
      772     if p-change-value >= 0
      773     then do:
      774       assign
      775         v-change-sign = 1
      776       .
      777     end.
      778     else do:
      779       assign
      780         v-change-sign = -1
      781       .
      782     end.
      783     assign
      784       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      785     .
      786     if p-change-value = 0
      787     then do:
      788       run diasize_position-resize-button in this-procedure .
      789       return .
      790     end.
      791     move_block:
      792     do
      793     on error undo move_block, retry move_block
      794     :
      795       if retry
      796       then do:
      797         do
      798         on error undo move_block, leave move_block
      799         :
      800           if p-change-value > 0
      801           then do:
      802             for each buf_temp-diasize-handle
      803             on error undo, next
      804             :
      805               assign
      806                 v-object-handle = buf_temp-diasize-handle.handle-value
      807               .
      808               if v-object-handle <> v-diasize-resize-button
      809               then do:
      810                 assign
      811                   v-object-handle :row = buf_temp-diasize-handle.save-position
      812                 .
      813               end.
      814             end.
      815             assign
      816               v-diasize-browse-handle :height = v-browse-height
      817             .
      818             for each buf_temp-browse-handle
      819               where buf_temp-browse-handle.browse-type = 'height':u
      820             on error undo, next
      821             :
      822               assign
      823                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      824               .
      825             end.
      826             assign
      827               frame Dialog-Frame :height = v-frame-height
      828             .
      829             if frame Dialog-Frame :scrollable = true
      830             then do:
      831               assign
      832                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      833               .
      834             end.
      835             run diasize_position-resize-button in this-procedure .
      836           end.
      837           else do:
      838             if frame Dialog-Frame :scrollable = true
      839             then do:
      840               assign
      841                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      842               .
      843             end.
      844             assign
      845               frame Dialog-Frame :height = v-frame-height
      846             .
      847             assign
      848               v-diasize-browse-handle :height = v-browse-height
      849             .
      850             for each buf_temp-browse-handle
      851               where buf_temp-browse-handle.browse-type = 'height':u
      852             on error undo, next
      853             :
      854               assign
      855                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      856               .
      857             end.
      858             for each buf_temp-diasize-handle
      859             on error undo, next
      860             :
      861               assign
      862                 v-object-handle = buf_temp-diasize-handle.handle-value
      863               .
      864               if v-object-handle <> v-diasize-resize-button
      865               then do:
      866                 assign
      867                   v-object-handle :row = buf_temp-diasize-handle.save-position
      868                 .
      869               end.
      870             end.
      871             run diasize_position-resize-button in this-procedure .
      872           end.
      873           assign
      874             v-diasize-change-size = false
      875           .
      876           leave move_block .
      877         end.
      878       end.
      879       assign
      880         v-diasize-need-full-display = true
      881       .
      882       if v-diasize-change-size = false
      883       then do:
      884         assign
      885           v-diasize-change-size = true
      886         .
      887       end.
      888       else do:
      889         return .
      890       end.
      891       assign
      892         v-frame-height = frame Dialog-Frame :height
      893         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      894         v-browse-height = v-diasize-browse-handle :height
      895       .
      896       for each buf_temp-browse-handle
      897         where buf_temp-browse-handle.browse-type = 'height':u
      898       :
      899         assign
      900           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      901         .
      902       end.
      903       for each buf_temp-diasize-handle
      904       :
      905         delete buf_temp-diasize-handle .
      906       end.
      907       assign
      908         v-field-group-handle = frame Dialog-Frame :first-child
      909       .
      910       do while valid-handle(v-field-group-handle)
      911       :
      912         assign
      913           v-object-handle = v-field-group-handle :first-child
      914         .
      915         do while valid-handle(v-object-handle)
      916         :
      917           if  v-object-handle <> v-diasize-browse-handle :handle
      918           and can-query(v-object-handle, "row")
      919           and can-query(v-object-handle, "height")
      920           and ( v-object-handle :row > v-diasize-browse-handle :row )
      921           then do:
      922             find first buf_temp-browse-handle
      923               where buf_temp-browse-handle.browse-type   = 'height':u
      924                 and buf_temp-browse-handle.browse-handle = v-object-handle
      925               no-error .
      926             if available buf_temp-browse-handle
      927             then do:
      928             end.
      929             else do:
      930               create buf_temp-diasize-handle .
      931               assign
      932                 buf_temp-diasize-handle.handle-value  = v-object-handle
      933                 buf_temp-diasize-handle.save-position = v-object-handle :row
      934               .
      935             end.
      936           end.
      937           assign
      938             v-object-handle = v-object-handle :next-sibling
      939           .
      940         end.
      941         assign
      942           v-field-group-handle = v-field-group-handle :next-sibling
      943         .
      944       end.
      945       do with frame Dialog-Frame
      946       :
      947         hide v-diasize-resize-button .
      948         assign
      949           v-diasize-resize-button :row    = 1
      950           v-diasize-resize-button :column = 1
      951         .
      952       end.
      953       if p-change-value > 0
      954       then do:
      955         if frame Dialog-Frame :scrollable = true
      956         then do:
      957           assign
      958             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      959             no-error .
      960           if error-status :error
      961           or error-status :get-message(1) <> ""
      962           then do:
      963             undo move_block, retry move_block .
      964           end.
      965         end.
      966         assign
      967           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      968           no-error .
      969         if error-status :error
      970         or error-status :get-message(1) <> ""
      971         then do:
      972           undo move_block, retry move_block .
      973         end.
      974         assign
      975           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      976           no-error .
      977         if error-status :error
      978         or error-status :get-message(1) <> ""
      979         then do:
      980           undo move_block, retry move_block .
      981         end.
      982         for each buf_temp-browse-handle
      983           where buf_temp-browse-handle.browse-type = 'height':u
      984         on error undo move_block, retry move_block
      985         :
      986           assign
      987             buf_temp-browse-handle.browse-handle :height
      988               = buf_temp-browse-handle.browse-handle :height + p-change-value
      989             no-error .
      990           if error-status :error
      991           or error-status :get-message(1) <> ""
      992           then do:
      993             undo move_block, retry move_block .
      994           end.
      995         end.
      996         for each buf_temp-diasize-handle
      997         on error undo move_block, retry move_block
      998         :
      999           assign
     1000             v-object-handle = buf_temp-diasize-handle.handle-value
     1001           .
     1002           if v-object-handle <> v-diasize-resize-button
     1003           then do:
     1004             assign
     1005               v-object-handle :row = v-object-handle :row + p-change-value
     1006               no-error .
     1007             if error-status :error
     1008             or error-status :get-message(1) <> ""
     1009             then do:
     1010               undo move_block, retry move_block .
     1011             end.
     1012           end.
     1013         end.
     1014       end.
     1015       else do:
     1016         for each buf_temp-diasize-handle
     1017         on error undo move_block, retry move_block
     1018         :
     1019           assign
     1020             v-object-handle = buf_temp-diasize-handle.handle-value
     1021           .
     1022           if v-object-handle <> v-diasize-resize-button
     1023           then do:
     1024             assign
     1025               v-object-handle :row = v-object-handle :row + p-change-value
     1026               no-error .
     1027             if error-status :error
     1028             or error-status :get-message(1) <> ""
     1029             then do:
     1030               undo move_block, retry move_block .
     1031             end.
     1032           end.
     1033         end.
     1034         assign
     1035           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1036           no-error .
     1037         if error-status :error
     1038         or error-status :get-message(1) <> ""
     1039         then do:
     1040           undo move_block, retry move_block .
     1041         end.
     1042         for each buf_temp-browse-handle
     1043           where buf_temp-browse-handle.browse-type = 'height':u
     1044         on error undo move_block, retry move_block
     1045         :
     1046           assign
     1047             buf_temp-browse-handle.browse-handle :height
     1048               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1049             no-error .
     1050           if error-status :error
     1051           or error-status :get-message(1) <> ""
     1052           then do:
     1053             undo move_block, retry move_block .
     1054           end.
     1055         end.
     1056         assign
     1057           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1058           no-error .
     1059         if error-status :error
     1060         or error-status :get-message(1) <> ""
     1061         then do:
     1062           undo move_block, retry move_block .
     1063         end.
     1064         if frame Dialog-Frame :scrollable = true
     1065         then do:
     1066           assign
     1067             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1068             no-error .
     1069           if error-status :error
     1070           or error-status :get-message(1) <> ""
     1071           then do:
     1072             undo move_block, retry move_block .
     1073           end.
     1074         end.
     1075       end.
     1076       if p-move-resize = true
     1077       then do:
     1078         run diasize_position-resize-button in this-procedure .
     1079       end.
     1080       if v-diasize-wndstore = true
     1081       then do:
     1082         if connected("ub") = true
     1083         then do:
     1084           define variable v-cntxt-db-num        as integer   no-undo .
     1085           define variable v-cntxt-userid        as character no-undo .
     1086           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1087                                             , OUTPUT v-cntxt-userid
     1088                                             ) .
     1089           run gbl/wndsizew.p
     1090             (input  v-cntxt-db-num
     1091             ,input  v-cntxt-userid
     1092             ,input  v-diasize-proc-name
     1093             ,input  'height':u
     1094             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1095             ) .
     1096         end.
     1097       end.
     1098     end.
     1099     assign
     1100       v-diasize-change-size = false
     1101     .
     1102   end procedure.
     1103   procedure diasize_set-height :
     1104     define input  parameter p-new-height  as decimal   no-undo .
     1105     define input  parameter p-move-resize as logical   no-undo .
     1106     do
     1107     on error undo, return error return-value
     1108     :
     1109       run diasize_change-height in this-procedure
     1110         (input  (p-new-height - frame Dialog-Frame :height)
     1111         ,input  p-move-resize
     1112         ) .
     1113     end.
     1114   end procedure.
     1115   procedure diasize_change-width :
     1116     define input  parameter p-change-value as decimal   no-undo .
     1117     define input  parameter p-move-resize  as logical   no-undo .
     1118     define variable v-field-group-handle   as handle    no-undo .
     1119     define variable v-object-handle        as handle    no-undo .
     1120     define variable v-frame-width          as decimal   no-undo .
     1121     define variable v-frame-virtual-width  as decimal   no-undo .
     1122     define variable v-browse-width         as decimal   no-undo .
     1123     define variable v-window-width         as decimal   no-undo .
     1124     define variable v-window-virtual-width as decimal   no-undo .
     1125     define variable v-change-sign          as integer   no-undo .
     1126     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1127     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1128     if p-change-value > 0
     1129     then do:
     1130       if frame Dialog-Frame :width + p-change-value >
     1131           session :width-chars
     1132       then do:
     1133         assign
     1134           p-change-value = session :width-chars - frame Dialog-Frame :width
     1135         .
     1136         if p-change-value <= 0
     1137         then do:
     1138           run diasize_position-resize-button in this-procedure .
     1139           return .
     1140         end.
     1141       end.
     1142     end.
     1143     if p-change-value < 0
     1144     then do:
     1145       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1146       then do:
     1147         assign
     1148           p-change-value = v-diasize-orig-frame-width
     1149                          - frame Dialog-Frame :width
     1150         .
     1151         if p-change-value >= 0
     1152         then do:
     1153           run diasize_position-resize-button in this-procedure .
     1154           return .
     1155         end.
     1156       end.
     1157     end.
     1158     if p-change-value >= 0
     1159     then do:
     1160       assign
     1161         v-change-sign = 1
     1162       .
     1163     end.
     1164     else do:
     1165       assign
     1166         v-change-sign = -1
     1167       .
     1168     end.
     1169     assign
     1170       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1171     .
     1172     if p-change-value = 0
     1173     then do:
     1174       run diasize_position-resize-button in this-procedure .
     1175       return .
     1176     end.
     1177     move_block:
     1178     do
     1179     on error undo move_block, leave move_block
     1180     :
     1181       if retry
     1182       then do:
     1183         do
     1184         on error undo move_block, leave move_block
     1185         :
     1186           if p-change-value > 0
     1187           then do:
     1188             for each buf_temp-diasize-handle
     1189             on error undo, next
     1190             :
     1191               assign
     1192                 v-object-handle = buf_temp-diasize-handle.handle-value
     1193               .
     1194               if v-object-handle <> v-diasize-resize-button
     1195               then do:
     1196                 assign
     1197                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1198                 .
     1199               end.
     1200             end.
     1201             assign
     1202               v-diasize-browse-handle :width = v-browse-width
     1203             .
     1204             for each buf_temp-browse-handle
     1205               where buf_temp-browse-handle.browse-type = 'width':u
     1206             on error undo, next
     1207             :
     1208               assign
     1209                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1210               .
     1211             end.
     1212             assign
     1213               frame Dialog-Frame :width = v-frame-width
     1214             .
     1215             if frame Dialog-Frame :scrollable = true
     1216             then do:
     1217               assign
     1218                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1219               .
     1220             end.
     1221             run diasize_position-resize-button in this-procedure .
     1222           end.
     1223           else do:
     1224             if frame Dialog-Frame :scrollable = true
     1225             then do:
     1226               assign
     1227                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1228               .
     1229             end.
     1230             assign
     1231               frame Dialog-Frame :width = v-frame-width
     1232             .
     1233             for each buf_temp-browse-handle
     1234               where buf_temp-browse-handle.browse-type = 'width':u
     1235             on error undo, next
     1236             :
     1237               assign
     1238                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1239               .
     1240             end.
     1241             assign
     1242               v-diasize-browse-handle :width = v-browse-width
     1243             .
     1244             for each buf_temp-diasize-handle
     1245             on error undo, next
     1246             :
     1247               assign
     1248                 v-object-handle = buf_temp-diasize-handle.handle-value
     1249               .
     1250               if v-object-handle <> v-diasize-resize-button
     1251               then do:
     1252                 assign
     1253                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1254                 .
     1255               end.
     1256             end.
     1257             run diasize_position-resize-button in this-procedure .
     1258           end.
     1259           assign
     1260             v-diasize-change-size = false
     1261           .
     1262           leave move_block .
     1263         end.
     1264       end.
     1265       assign
     1266         v-diasize-need-full-display = true
     1267       .
     1268       if v-diasize-change-size = false
     1269       then do:
     1270         assign
     1271           v-diasize-change-size = true
     1272         .
     1273       end.
     1274       else do:
     1275         return .
     1276       end.
     1277       assign
     1278         v-frame-width = frame Dialog-Frame :width
     1279         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1280         v-browse-width = v-diasize-browse-handle :width
     1281       .
     1282       for each buf_temp-browse-handle
     1283         where buf_temp-browse-handle.browse-type = 'width':u
     1284       :
     1285         assign
     1286           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1287         .
     1288       end.
     1289       for each buf_temp-diasize-handle
     1290       :
     1291         delete buf_temp-diasize-handle .
     1292       end.
     1293       assign
     1294         v-field-group-handle = frame Dialog-Frame :first-child
     1295       .
     1296       do while valid-handle(v-field-group-handle)
     1297       :
     1298         assign
     1299           v-object-handle = v-field-group-handle :first-child
     1300         .
     1301         do while valid-handle(v-object-handle)
     1302         :
     1303           if  v-object-handle <> v-diasize-browse-handle :handle
     1304           and v-object-handle <> v-diasize-resize-button
     1305           and can-query(v-object-handle, "row")
     1306           and can-query(v-object-handle, "height")
     1307           and ( v-object-handle :col + v-object-handle :width
     1308                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1309               )
     1310           then do:
     1311             find first buf_temp-browse-handle
     1312               where buf_temp-browse-handle.browse-type   = 'width':u
     1313                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1314               no-error .
     1315             if available buf_temp-browse-handle
     1316             then do:
     1317             end.
     1318             else do:
     1319               create buf_temp-diasize-handle .
     1320               assign
     1321                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1322                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1323               .
     1324             end.
     1325           end.
     1326           assign
     1327             v-object-handle = v-object-handle :next-sibling
     1328           .
     1329         end.
     1330         assign
     1331           v-field-group-handle = v-field-group-handle :next-sibling
     1332         .
     1333       end.
     1334       do with frame Dialog-Frame
     1335       :
     1336         hide v-diasize-resize-button .
     1337         v-diasize-resize-button :row = 1.
     1338         v-diasize-resize-button :column = 1.
     1339       end.
     1340       if p-change-value > 0
     1341       then do:
     1342         if frame Dialog-Frame :scrollable = true
     1343         then do:
     1344           assign
     1345             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1346             no-error .
     1347           if error-status :error
     1348           or error-status :get-message(1) <> ""
     1349           then do:
     1350             undo move_block, retry move_block.
     1351           end.
     1352         end.
     1353         assign
     1354           frame Dialog-Frame :width = v-frame-width + p-change-value
     1355           no-error .
     1356         if error-status :error
     1357         or error-status :get-message(1) <> ""
     1358         then do:
     1359           undo move_block, retry move_block.
     1360         end.
     1361         assign
     1362           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1363         no-error .
     1364         if error-status :error
     1365         or error-status :get-message(1) <> ""
     1366         then do:
     1367           undo move_block, retry move_block.
     1368         end.
     1369         for each buf_temp-browse-handle
     1370           where buf_temp-browse-handle.browse-type = 'width':u
     1371         on error undo move_block, retry move_block
     1372         :
     1373           assign
     1374             buf_temp-browse-handle.browse-handle :width
     1375               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1376             no-error .
     1377           if error-status :error
     1378           or error-status :get-message(1) <> ""
     1379           then do:
     1380             undo move_block, retry move_block .
     1381           end.
     1382         end.
     1383         for each buf_temp-diasize-handle
     1384         on error undo move_block, retry move_block
     1385         :
     1386           assign
     1387             v-object-handle = buf_temp-diasize-handle.handle-value
     1388           .
     1389           if v-object-handle <> v-diasize-resize-button
     1390           then do:
     1391             assign
     1392               v-object-handle :col = v-object-handle :col + p-change-value
     1393               no-error .
     1394             if error-status :error
     1395             or error-status :get-message(1) <> ""
     1396             then do:
     1397               undo move_block, retry move_block .
     1398             end.
     1399           end.
     1400         end.
     1401       end.
     1402       else do:
     1403         for each buf_temp-diasize-handle
     1404         on error undo move_block, retry move_block
     1405         :
     1406           assign
     1407             v-object-handle = buf_temp-diasize-handle.handle-value
     1408           .
     1409           if v-object-handle <> v-diasize-resize-button
     1410           then do:
     1411             assign
     1412               v-object-handle :col = v-object-handle :col + p-change-value
     1413               no-error .
     1414             if error-status :error
     1415             or error-status :get-message(1) <> ""
     1416             then do:
     1417               undo move_block, retry move_block .
     1418             end.
     1419           end.
     1420         end.
     1421         for each buf_temp-browse-handle
     1422           where buf_temp-browse-handle.browse-type = 'width':u
     1423         on error undo move_block, retry move_block
     1424         :
     1425           assign
     1426             buf_temp-browse-handle.browse-handle :width
     1427               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1428             no-error .
     1429           if error-status :error
     1430           or error-status :get-message(1) <> ""
     1431           then do:
     1432             undo move_block, retry move_block .
     1433           end.
     1434         end.
     1435         assign
     1436           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1437           no-error .
     1438         if error-status :error
     1439         or error-status :get-message(1) <> ""
     1440         then do:
     1441           undo move_block, retry move_block.
     1442         end.
     1443         assign
     1444           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1445         no-error .
     1446         if error-status :error
     1447         or error-status :get-message(1) <> ""
     1448         then do:
     1449           undo move_block, retry move_block.
     1450         end.
     1451         if frame Dialog-Frame :scrollable = true
     1452         then do:
     1453           assign
     1454             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1455           no-error .
     1456           if error-status :error
     1457           or error-status :get-message(1) <> ""
     1458           then do:
     1459             undo move_block, retry move_block.
     1460           end.
     1461         end.
     1462       end.
     1463       if p-move-resize
     1464       then do:
     1465         run diasize_position-resize-button in this-procedure .
     1466       end.
     1467       if v-diasize-wndstore = true
     1468       then do:
     1469         if connected("ub") = true
     1470         then do:
     1471           define variable v-cntxt-db-num        as integer   no-undo .
     1472           define variable v-cntxt-userid        as character no-undo .
     1473           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1474                                             , OUTPUT v-cntxt-userid
     1475                                             ) .
     1476           run gbl/wndsizew.p
     1477             (input  v-cntxt-db-num
     1478             ,input  v-cntxt-userid
     1479             ,input  v-diasize-proc-name
     1480             ,input  'width':u
     1481             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1482             ) .
     1483         end.
     1484       end.
     1485     end.
     1486     assign
     1487       v-diasize-change-size = false
     1488     .
     1489   end procedure.
     1490   procedure diasize_set-width :
     1491     define input  parameter p-new-width  as decimal   no-undo .
     1492     define input  parameter p-move-resize as logical   no-undo .
     1493     do
     1494     on error undo, return error return-value
     1495     :
     1496       run diasize_change-width in this-procedure
     1497         (input  (p-new-width - frame Dialog-Frame :width)
     1498         ,input  p-move-resize
     1499         ) .
     1500     end.
     1501   end procedure.
     1502   procedure diasize_position-resize-button :
     1503     do with frame Dialog-Frame
     1504     :
     1505       hide v-diasize-resize-button .
     1506       assign
     1507         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1508                     - 1
     1509                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1510         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1511                     - 1
     1512                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1513       .
     1514       view v-diasize-resize-button .
     1515     end.
     1516   end procedure.
     1517   on alt-right anywhere
     1518   do:
     1519     run diasize_change-width in this-procedure
     1520       (input 1
     1521       ,input true
     1522       ) .
     1523     return no-apply .
     1524   end.
     1525   on alt-left anywhere
     1526   do:
     1527     run diasize_change-width in this-procedure
     1528       (input -1
     1529       ,input true
     1530       ) .
     1531     return no-apply .
     1532   end.
     1533   on alt-down anywhere
     1534   do:
     1535     run diasize_change-height in this-procedure
     1536       (input 1
     1537       ,input true
     1538       ) .
     1539     return no-apply .
     1540   end.
     1541   on alt-up anywhere
     1542   do:
     1543     run diasize_change-height in this-procedure
     1544       (input -1
     1545       ,input true
     1546       ) .
     1547     return no-apply .
     1548   end.
     1549   on alt-enter of frame Dialog-Frame
     1550   do:
     1551     run diasize_maximize in this-procedure
     1552       (input  ?
     1553       ).
     1554     return no-apply .
     1555   end.
     1556   procedure diasize_end-move :
     1557     do
     1558     on error undo, return error return-value
     1559     :
     1560       define variable v-row-delta as decimal   no-undo .
     1561       define variable v-col-delta as decimal   no-undo .
     1562       define variable v-new-row as decimal   no-undo .
     1563       define variable v-new-col as decimal   no-undo .
     1564       assign
     1565         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1566         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1567       .
     1568       assign
     1569         v-row-delta = v-new-row - frame Dialog-Frame :height
     1570         v-col-delta = v-new-col - frame Dialog-Frame :width
     1571       .
     1572       run diasize_change-height in this-procedure
     1573         (input v-row-delta
     1574         ,input true
     1575         ) .
     1576       run diasize_change-width in this-procedure
     1577         (input v-col-delta
     1578         ,input true
     1579         ) .
     1580     end.
     1581   end procedure.
     1582   procedure diasize_maximize :
     1583     define input  parameter p-action as logical   no-undo .
     1584     do
     1585     on error undo, return error return-value
     1586     :
     1587       if p-action = ?
     1588       then do:
     1589         if v-diasize-need-maximize = true
     1590         then do:
     1591           assign
     1592             p-action = true
     1593           .
     1594         end.
     1595         else do:
     1596           assign
     1597             p-action = false
     1598           .
     1599         end.
     1600       end.
     1601       if p-action = true
     1602       then do:
     1603         run diasize_change-height in this-procedure
     1604           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1605               - frame Dialog-Frame :height-chars
     1606           ,input true
     1607           ) .
     1608         run diasize_change-width in this-procedure
     1609           (input session :width-chars
     1610               - frame Dialog-Frame :width-chars
     1611           ,input true
     1612           ) .
     1613         assign
     1614           v-diasize-need-maximize = false
     1615         .
     1616       end.
     1617       else do:
     1618         run diasize_change-width in this-procedure
     1619           (input v-diasize-orig-frame-width
     1620               - frame Dialog-Frame :width-chars
     1621           ,input true
     1622           ) .
     1623         run diasize_change-height in this-procedure
     1624           (input v-diasize-orig-frame-height
     1625               - frame Dialog-Frame :height-chars
     1626           ,input true
     1627           ) .
     1628         assign
     1629           v-diasize-need-maximize = true
     1630         .
     1631       end.
     1632     end.
     1633   end procedure.
     1634   procedure diasize_restore-orig-size :
     1635     do
     1636     on error undo, return error return-value
     1637     :
     1638       assign
     1639         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1640         v-diasize-current-frame-height = frame Dialog-Frame :height
     1641       .
     1642       run diasize_set-height in this-procedure
     1643         (input  v-diasize-orig-frame-height
     1644         ,input  true
     1645         ) .
     1646       run diasize_set-width in this-procedure
     1647         (input  v-diasize-orig-frame-width
     1648         ,input  true
     1649         ) .
     1650     end.
     1651   end procedure.
     1652   procedure diasize_restore-current-size :
     1653     do
     1654     on error undo, return error return-value
     1655     :
     1656       run diasize_set-height in this-procedure
     1657         (input  v-diasize-current-frame-height
     1658         ,input  true
     1659         ) .
     1660       run diasize_set-width in this-procedure
     1661         (input  v-diasize-current-frame-width
     1662         ,input  true
     1663         ) .
     1664     end.
     1665   end procedure.
     1666   procedure diasize_set-browse-handle :
     1667     define input  parameter p-browse-handle as handle   no-undo .
     1668     define buffer buf_temp-browse-handle for temp-browse-handle .
     1669     do
     1670     on error undo, return error return-value
     1671     :
     1672       assign
     1673         v-diasize-browse-handle = p-browse-handle
     1674       .
     1675       for each buf_temp-browse-handle
     1676       on error undo, return error return-value
     1677       :
     1678         delete buf_temp-browse-handle .
     1679       end.
     1680     end.
     1681   end procedure.
     1682   procedure diasize_add_browse :
     1683     define input  parameter p-browse-type   as character no-undo .
     1684     define input  parameter p-browse-handle as handle    no-undo .
     1685     define buffer buf_temp-browse-handle for temp-browse-handle .
     1686     do
     1687     on error undo, return error return-value
     1688     :
     1689       assign
     1690         v-diasize-browse-number = v-diasize-browse-number + 1
     1691       .
     1692       create buf_temp-browse-handle .
     1693       assign
     1694         buf_temp-browse-handle.browse-type   = p-browse-type
     1695         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1696         buf_temp-browse-handle.browse-handle = p-browse-handle
     1697       .
     1698     end.
     1699   end procedure.
     1700   procedure diasize_init :
     1701     define variable v-default-value    as logical   no-undo .
     1702     define variable v-restore-saved    as logical   no-undo .
     1703     define variable v-resize-value-str as character no-undo .
     1704     do
     1705     on error undo, return error return-value
     1706     :
     1707       do with frame Dialog-Frame
     1708       :
     1709         assign
     1710           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1711           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1712           v-diasize-browse-handle     = browse br-ingr-cost :handle
     1713         .
     1714         create button v-diasize-resize-button
     1715         assign
     1716           parent        = frame Dialog-Frame :first-child
     1717           label         = "s"
     1718           height-pixels = 16
     1719           width-pixels  = 16
     1720           visible       = true
     1721           sensitive     = true
     1722           movable       = true
     1723           triggers:
     1724             on end-move persistent run diasize_end-move in this-procedure .
     1725           end triggers.
     1726         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1727         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1728         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1729         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1730         assign
     1731           v-diasize-wndmax = false
     1732         .
     1733         if connected("ub") = true
     1734         then do:
     1735           define variable v-cntxt-db-num        as integer   no-undo .
     1736           define variable v-cntxt-userid        as character no-undo .
     1737           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1738                                             , OUTPUT v-cntxt-userid
     1739                                             ) .
     1740           run gbl/wndpar_r.p
     1741             (input  v-cntxt-db-num
     1742             ,input  v-cntxt-userid
     1743             ,input  'wndmax':U
     1744             ,output v-diasize-wndmax
     1745             ,output v-default-value
     1746             ) .
     1747         end.
     1748         assign
     1749           v-diasize-wndstore = false
     1750         .
     1751         if connected("ub") = true
     1752         then do:
     1753           run gbl/wndpar_r.p
     1754             (input  v-cntxt-db-num
     1755             ,input  v-cntxt-userid
     1756             ,input  'wndstore':U
     1757             ,output v-diasize-wndstore
     1758             ,output v-default-value
     1759             ) .
     1760         end.
     1761         assign
     1762           v-diasize-proc-name = entry(1, program-name(2), '.')
     1763         .
     1764         if v-diasize-wndstore = true
     1765         then do:
     1766           assign
     1767             v-restore-saved = false
     1768           .
     1769           if connected("ub") = true
     1770           then do:
     1771             run gbl/wndsizer.p
     1772               (input  v-cntxt-db-num
     1773               ,input  v-cntxt-userid
     1774               ,input  v-diasize-proc-name
     1775               ,input  'height':u
     1776               ,output v-resize-value-str
     1777               ) .
     1778             if v-resize-value-str <> '':U
     1779             then do:
     1780               run diasize_change-height in this-procedure
     1781                 (input  integer(v-resize-value-str)
     1782                 ,input  true
     1783                 ) .
     1784               assign
     1785                 v-restore-saved = true
     1786               .
     1787             end.
     1788           end.
     1789           if connected("ub") = true
     1790           then do:
     1791             run gbl/wndsizer.p
     1792               (input  v-cntxt-db-num
     1793               ,input  v-cntxt-userid
     1794               ,input  v-diasize-proc-name
     1795               ,input  'width':u
     1796               ,output v-resize-value-str
     1797               ) .
     1798             if v-resize-value-str <> '':U
     1799             then do:
     1800               run diasize_change-width in this-procedure
     1801                 (input  integer(v-resize-value-str)
     1802                 ,input  true
     1803                 ) .
     1804               assign
     1805                 v-restore-saved = true
     1806               .
     1807             end.
     1808           end.
     1809           if v-restore-saved <> true
     1810           then do:
     1811             if v-diasize-wndmax = true
     1812             then do:
     1813               run diasize_maximize in this-procedure
     1814                 (input  true
     1815                 ) .
     1816             end.
     1817           end.
     1818         end.
     1819         else do:
     1820           if v-diasize-wndmax = true
     1821           then do:
     1822             run diasize_maximize in this-procedure
     1823               (input  true
     1824               ) .
     1825           end.
     1826         end.
     1827       end.
     1828     end.
     1829   end procedure.
     1830   procedure diasize_need-full-display :
     1831     define output parameter p-need-full-display as logical   no-undo .
     1832     do
     1833     on error undo, return error return-value
     1834     :
     1835       assign
     1836         p-need-full-display = v-diasize-need-full-display
     1837       .
     1838       assign
     1839         v-diasize-need-full-display = false
     1840       .
     1841     end.
     1842   end procedure.
     1843   procedure get-context :
     1844      define output parameter p-db-num as integer          no-undo.
     1845      define output parameter p-user-id as character        no-undo.
     1846      define variable v-login               as character    no-undo.
     1847      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1848      define buffer buf_user-login  for ub.user-login .
     1849      do
     1850      on error undo, return error
     1851      :
     1852            FIND FIRST buf_sys-ctrl no-lock.
     1853            ASSIGN
     1854               v-login = USERID("ub")
     1855               p-db-num = buf_sys-ctrl.db-num
     1856            .
     1857            FIND FIRST buf_user-login
     1858                 WHERE buf_user-login.db-num = p-db-num
     1859                   AND buf_user-login.user-login = v-login
     1860                 no-lock
     1861                 no-error
     1862                 .
     1863            IF AVAILABLE buf_user-login
     1864            THEN DO:
     1865               assign
     1866                  p-user-id = buf_user-login.user-id
     1867               .
     1868            END.
     1869      end.
     1870   end procedure.
     1871       run diasize_init in this-procedure .
     1872   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1873   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1874   MAIN-BLOCK:
     1875   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1876      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1877     run init-fields in this-procedure.
     1878     RUN enable_UI.
     1879     case p-mode
     1880     :
     1881       when 'ПРОСМОТР':U
     1882       then do:
     1883           assign
     1884               ed-recipe-quality :fgcolor = 4
     1885               ed-recipe-design  :fgcolor = 4
     1886           .
     1887           assign
     1888               ed-recipe-quality :read-only in frame Dialog-Frame = yes
     1889               ed-recipe-design  :read-only in frame Dialog-Frame = yes
     1890           .
     1891       end.
     1892     end case.
     1893     WAIT-FOR GO OF FRAME Dialog-Frame.
     1894   END.
     1895   RUN disable_UI.
     1896   PROCEDURE disable_UI :
     1897     HIDE FRAME Dialog-Frame.
     1898   END PROCEDURE.
     1899   PROCEDURE enable_UI :
     1900     DISPLAY fi-d ed-recipe-quality fi-d-2 ed-recipe-design FILL-IN-1
     1901         WITH FRAME Dialog-Frame.
     1902     ENABLE b-exit b-help ed-recipe-quality ed-recipe-design b-change br-ingr-cost
     1903         WITH FRAME Dialog-Frame.
     1904     VIEW FRAME Dialog-Frame.
     1905     OPEN QUERY br-ingr-cost FOR EACH recipe-gds       WHERE recipe-gds.recipe-code = p-recipe-code NO-LOCK INDEXED-REPOSITION.
     1906   END PROCEDURE.
     1907   PROCEDURE get-goods-artic :
     1908   define input parameter p-gds-code   as integer    no-undo.
     1909   define output parameter p-artic     as character  no-undo.
     1910   define buffer buf_goods for goods.
     1911   do
     1912   for buf_goods
     1913   on error undo, return error
     1914   :
     1915       find first buf_goods no-lock
     1916            where buf_goods.gds-code = p-gds-code
     1917       .
     1918       assign
     1919           p-artic = buf_goods.artic
     1920       .
     1921   end.
     1922   END PROCEDURE.
     1923   PROCEDURE init-fields :
     1924   do
     1925   on error undo, return error
     1926   :
     1927       assign
     1928           ed-recipe-quality   = p-in-recipe-quality
     1929           ed-recipe-design    = p-in-recipe-design
     1930       .
     1931   end.
     1932   END PROCEDURE.
     1933   FUNCTION func-get-cost-price-rubl RETURNS CHARACTER
     1934     ( p-gds-code as integer ) :
     1935   define variable v-attr-value as character no-undo.
     1936   define variable v-attr-type  as character no-undo.
     1937       run gdsoattr-value in this-procedure (
     1938             input 'fbr-cost-rubl':U
     1939           , input p-gds-code
     1940           , input p-store-type
     1941           , input p-store-code
     1942           , output v-attr-value
     1943           , output v-attr-type
     1944       ).
     1945     RETURN v-attr-value.
     1946   END FUNCTION.
     1947   FUNCTION func-get-goods-artic RETURNS CHARACTER
     1948     ( p-gds-code as integer ) :
     1949   define variable v-artic as character no-undo.
     1950       run get-goods-artic in this-procedure (
     1951             input p-gds-code
     1952           , output v-artic
     1953       ).
     1954       return v-artic.
     1955   END FUNCTION.
