        1   DEFINE BUFFER X_goods FOR goods.
        2   DEFINE BUFFER X_pl-gds FOR pl-gds.
        3   DEFINE BUFFER X_place FOR place.
        4   define temp-table tt-com-place
        5     field pl-code as integer
        6   .
        7   define input  parameter in-pl-codes  as character   no-undo .
        8   define output parameter out-pl-code  like ub.pl-gds.pl-code   no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":u .
       10   define variable vss-author      as character no-undo init "$Author$":u .
       11   define variable vss-date        as character no-undo init "$Date$":u .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       13   define variable vss-archive     as character no-undo init "$Archive$":u .
       14   define variable vss-description as character no-undo init "Товары на складских местах" .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure placelib_write-attr:
       74   define input  parameter p-code     like ub.place-attr.attr-code .
       75   define input  parameter p-obj-code like ub.place-attr.obj-code .
       76   define input  parameter p-obj-type like ub.place-attr.obj-type .
       77   define input  parameter p-pl-code  like ub.place-attr.pl-code .
       78   define input  parameter p-value    like ub.place-attr.attr-value .
       79   define output parameter p-ok       as logical.
       80   define buffer buf_place-attr for ub.place-attr .
       81     do on error undo, return error return-value :
       82        p-ok = false.
       83        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
       84                                                   and buf_place-attr.obj-code    = p-obj-code
       85                                                   and buf_place-attr.obj-type    = p-obj-type
       86                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
       87        if not available buf_place-attr then do :
       88           create buf_place-attr.
       89           assign
       90             buf_place-attr.attr-code   = p-code
       91             buf_place-attr.attr-value  = p-value
       92             buf_place-attr.obj-code    = p-obj-code
       93             buf_place-attr.obj-type    = p-obj-type
       94             buf_place-attr.pl-code     = p-pl-code
       95           .
       96           p-ok = true.
       97        end.
       98        else do:
       99           buf_place-attr.attr-value  = p-value .
      100           p-ok = true.
      101        end.
      102     end.
      103   end.
      104   procedure placelib_get-attr:
      105   define input  parameter  p-code     like ub.place-attr.attr-code .
      106   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      107   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      108   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      109   define output parameter  p-value    like ub.place-attr.attr-value .
      110   define output parameter  p-ok       as logical.
      111   define buffer buf_place-attr for ub.place-attr .
      112     do on error undo, return error return-value :
      113        p-ok = false.
      114        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      115                                                   and buf_place-attr.obj-code    = p-obj-code
      116                                                   and buf_place-attr.obj-type    = p-obj-type
      117                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      118        if available buf_place-attr then do :
      119          p-value = buf_place-attr.attr-value.
      120          p-ok = true.
      121        end.
      122        else do :
      123          p-ok = false.
      124        end.
      125     end.
      126   end.
      127   procedure placelib_del-attr:
      128   define input parameter  p-code     like ub.place-attr.attr-code .
      129   define input parameter  p-obj-code like ub.place-attr.obj-code .
      130   define input parameter  p-obj-type like ub.place-attr.obj-type .
      131   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      132   define input parameter  p-value    like ub.place-attr.attr-value .
      133   define output parameter p-ok       as logical.
      134   define buffer buf_place-attr for ub.place-attr .
      135     do on error undo, return error return-value :
      136        p-ok = false.
      137        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      138                                                   and buf_place-attr.obj-code    = p-obj-code
      139                                                   and buf_place-attr.obj-type    = p-obj-type
      140                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      141        if available buf_place-attr then do :
      142           delete buf_place-attr.
      143           p-ok = true.
      144        end.
      145     end.
      146   end.
      147   define buffer b-goods for goods.
      148   define buffer b-place for place.
      149   define variable glog         as logical   no-undo .
      150   define variable v-value      as character no-undo .
      151   define variable v-ok         as logical   no-undo .
      152   define variable ii           as integer   no-undo .
      153   DEFINE BUTTON B-exit AUTO-GO
      154        LABEL "&Выход"
      155        SIZE 10 BY 1
      156        BGCOLOR 8 .
      157   DEFINE BUTTON B-Help
      158        LABEL "Помо&щь"
      159        SIZE 3 BY 1
      160        BGCOLOR 8 .
      161   DEFINE BUTTON B-sel AUTO-GO
      162        LABEL "Вы&бор"
      163        SIZE 10 BY 1.
      164   DEFINE QUERY BR-pl-gds FOR
      165         tt-com-place,
      166         X_pl-gds,
      167         X_goods,
      168         X_place SCROLLING.
      169   DEFINE BROWSE BR-pl-gds
      170     QUERY BR-pl-gds NO-LOCK DISPLAY
      171   X_pl-gds.pl-code COLUMN-LABEL "Склд.место" FORMAT ">>>>>>>>>>9":U
      172   X_place.pl-name FORMAT "X(40)":U
      173   X_place.loc1 FORMAT "X(8)":U
      174   X_place.loc2 FORMAT "X(8)":U
      175   X_place.loc3 FORMAT "X(8)":U
      176   X_place.loc4 FORMAT "X(8)":U
      177   X_pl-gds.gds-code FORMAT "99999999999":U
      178   X_goods.artic FORMAT "X(16)":U
      179   X_goods.gds-name FORMAT "X(48)":U
      180   X_goods.prod-type FORMAT "X(3)":U
      181   X_goods.prod-code FORMAT ">>>>>>>>9":U
      182   X_pl-gds.free-qnty FORMAT "->>,>>>,>>9.999":U
      183   X_pl-gds.fact-qnty FORMAT "->>,>>>,>>9.999":U
      184   X_pl-gds.cli-free-qnty FORMAT "->>,>>>,>>9.999":U
      185   X_pl-gds.cli-fact-qnty FORMAT "->>,>>>,>>9.999":U
      186   X_pl-gds.tolerance COLUMN-LABEL "Допуст.отклонение" FORMAT "->>,>>>,>>9.<<<":U
      187   X_pl-gds.status_ FORMAT "X(8)":U
      188   ENABLE
      189   X_pl-gds.tolerance
      190       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.
      191   DEFINE FRAME Dialog-Frame
      192        B-exit AT ROW 1 COL 1.2
      193        B-sel AT ROW 1 COL 11
      194        B-Help AT ROW 1 COL 95
      195        BR-pl-gds AT ROW 3.95 COL 1
      196        SPACE(0.00) SKIP(0.17)
      197       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      198            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      199            TITLE "Товары на складских местах"
      200            DEFAULT-BUTTON B-exit.
      201   ASSIGN
      202          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      203          FRAME Dialog-Frame:HIDDEN           = TRUE.
      204   ASSIGN
      205          BR-pl-gds:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
      206   ON GO OF FRAME Dialog-Frame
      207   DO:
      208   END.
      209   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      210   DO:
      211     APPLY "END-ERROR":U TO SELF.
      212   END.
      213   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      214   DO:
      215   END.
      216   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      217   DO:
      218       if available X_pl-gds
      219       then
      220         out-pl-code = X_pl-gds.pl-code
      221       .
      222   END.
      223   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      224   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      225   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      226   on help of frame Dialog-Frame
      227   do:
      228     run gbl/app_help.p
      229       (input this-procedure :file-name
      230       ,input ''
      231       ,input ?
      232       ) no-error.
      233     if error-status :error then do:
      234       message
      235         "Ошибка при вызове помощи"
      236         error-status :get-message(1)
      237         view-as alert-box .
      238     end.
      239   end.
      240   run minbtn-set in this-procedure .
      241   on choose of b-help in frame Dialog-Frame
      242   do:
      243     apply "help":u to frame Dialog-Frame .
      244   end.
      245   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      246   procedure minbtn-set :
      247       do
      248           on error undo, return error return-value
      249           :
      250           define variable ii              as integer       no-undo .
      251           define variable fh              as widget-handle no-undo .
      252           define variable hh              as widget-handle no-undo .
      253           define variable v-h             as handle        extent 4 no-undo .
      254           define variable v-name-button   as character     no-undo .
      255           define variable v-help-old-x    as decimal       no-undo .
      256           define variable v-help-old-y    as decimal       no-undo .
      257           define variable v-help-old-size as decimal       no-undo .
      258           define variable v-frame-width   as decimal       no-undo .
      259           define variable jj              as integer       no-undo .
      260           do
      261               on error undo, return error
      262               :
      263               assign
      264                   v-frame-width = frame Dialog-Frame:width - 0.3
      265                   fh            = frame Dialog-Frame:first-child
      266                   hh            = fh:first-child
      267                   ii            = 1
      268                   .
      269               do while valid-handle(hh):
      270                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      271                   do:
      272                       case lc(hh:name) :
      273                           when "b-help" then
      274                               do:
      275                                   hh:load-image-up("cmp/b-help.bmp":u) .
      276                                   hh:load-image-down("cmp/b-help.bmp":u) .
      277                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      278                                   hh:TOOLTIP = "Помощь" .
      279                                   v-help-old-x = hh:column .
      280                                   v-help-old-y = hh:row    .
      281                                   v-help-old-size = hh:width .
      282                                   hh:width-chars = 2.5 .
      283                               end.
      284                           when "b-print" then
      285                               do:
      286                                   hh:load-image("cmp/b-print.bmp":u) .
      287                                   hh:TOOLTIP = "Печать" .
      288                                   v-h[ii] = hh:handle .
      289                                   ii = ii + 1 .
      290                                   hh:width-chars = 3 .
      291                               end.
      292                           when "b-history" or
      293                           when "b-hist" then
      294                               do:
      295                                   hh:load-image("cmp/b-hist.bmp":u) .
      296                                   hh:TOOLTIP = "История" .
      297                                   v-h[ii] = hh:handle .
      298                                   ii = ii + 1 .
      299                                   hh:width-chars = 3 .
      300                               end.
      301                           when "b-sch" then
      302                               do:
      303                                   hh:load-image("cmp/b-sch.bmp":u) .
      304                                   hh:TOOLTIP = "Установка Фильтра" .
      305                                   v-h[ii] = hh:handle .
      306                                   ii = ii + 1 .
      307                                   hh:width-chars = 3 .
      308                               end.
      309                           when "b-hist-user" then
      310                               do:
      311                                   hh:load-image("cmp/b-hist.bmp":u) .
      312                                   hh:TOOLTIP = "История пользователя" .
      313                                   ii = ii + 1 .
      314                               end.
      315                       end case.
      316                   end.
      317                   hh = hh:next-sibling.
      318               end.
      319               b-help:column = v-frame-width - b-help:width-chars.
      320               jj = 0.
      321               repeat ii = 4 to 1 by -1 :
      322                   if valid-handle (v-h[ii] ) then
      323                   do:
      324                       jj  = jj + 1 .
      325                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      326                       v-h[ii]:row    = v-help-old-y .
      327                   end.
      328               end.
      329           end.
      330       end.
      331   end procedure.
      332   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      333   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      334   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      335   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      336   define variable v-diasize-current-frame-width  as decimal   no-undo .
      337   define variable v-diasize-current-frame-height as decimal   no-undo .
      338   define variable v-diasize-change-size          as logical   no-undo .
      339   define variable v-diasize-resize-button        as handle    no-undo .
      340   define variable v-diasize-wndmax               as logical   no-undo .
      341   define variable v-diasize-wndstore             as logical   no-undo .
      342   define variable v-diasize-proc-name            as character no-undo .
      343   define variable v-diasize-browse-handle        as handle    no-undo .
      344   define variable v-diasize-browse-number        as integer   no-undo .
      345   define variable v-diasize-need-full-display    as logical   no-undo init false .
      346   define temp-table temp-diasize-handle no-undo
      347     field handle-value  as handle
      348     field save-position as decimal
      349     index xpk is primary unique handle-value
      350     .
      351   define temp-table temp-browse-handle no-undo
      352     field browse-type   as character
      353     field browse-number as integer
      354     field browse-handle as handle
      355     field original-size as decimal
      356     index xpk is primary unique browse-type browse-number
      357     index xie browse-type browse-handle
      358   .
      359   procedure diasize_change-height :
      360     define input  parameter p-change-value  as decimal   no-undo .
      361     define input  parameter p-move-resize   as logical   no-undo .
      362     define variable v-field-group-handle    as handle    no-undo .
      363     define variable v-object-handle         as handle    no-undo .
      364     define variable v-frame-height          as decimal   no-undo .
      365     define variable v-frame-virtual-height  as decimal   no-undo .
      366     define variable v-browse-height         as decimal   no-undo .
      367     define variable v-window-height         as decimal   no-undo .
      368     define variable v-window-virtual-height as decimal   no-undo .
      369     define variable v-change-sign           as integer   no-undo .
      370     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      371     define buffer buf_temp-browse-handle  for temp-browse-handle .
      372     if p-change-value > 0
      373     then do:
      374       if frame Dialog-Frame :height + p-change-value
      375           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      376       then do:
      377         assign
      378           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      379                           - (frame Dialog-Frame :height-chars)
      380         .
      381         if p-change-value <= 0
      382         then do:
      383           run diasize_position-resize-button in this-procedure .
      384           return .
      385         end.
      386       end.
      387     end.
      388     if p-change-value < 0
      389     then do:
      390       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      391       then do:
      392         assign
      393           p-change-value = v-diasize-orig-frame-height
      394                          - (frame Dialog-Frame :height-chars)
      395         .
      396         if p-change-value >= 0
      397         then do:
      398           run diasize_position-resize-button in this-procedure .
      399           return .
      400         end.
      401       end.
      402     end.
      403     if p-change-value >= 0
      404     then do:
      405       assign
      406         v-change-sign = 1
      407       .
      408     end.
      409     else do:
      410       assign
      411         v-change-sign = -1
      412       .
      413     end.
      414     assign
      415       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      416     .
      417     if p-change-value = 0
      418     then do:
      419       run diasize_position-resize-button in this-procedure .
      420       return .
      421     end.
      422     move_block:
      423     do
      424     on error undo move_block, retry move_block
      425     :
      426       if retry
      427       then do:
      428         do
      429         on error undo move_block, leave move_block
      430         :
      431           if p-change-value > 0
      432           then do:
      433             for each buf_temp-diasize-handle
      434             on error undo, next
      435             :
      436               assign
      437                 v-object-handle = buf_temp-diasize-handle.handle-value
      438               .
      439               if v-object-handle <> v-diasize-resize-button
      440               then do:
      441                 assign
      442                   v-object-handle :row = buf_temp-diasize-handle.save-position
      443                 .
      444               end.
      445             end.
      446             assign
      447               v-diasize-browse-handle :height = v-browse-height
      448             .
      449             for each buf_temp-browse-handle
      450               where buf_temp-browse-handle.browse-type = 'height':u
      451             on error undo, next
      452             :
      453               assign
      454                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      455               .
      456             end.
      457             assign
      458               frame Dialog-Frame :height = v-frame-height
      459             .
      460             if frame Dialog-Frame :scrollable = true
      461             then do:
      462               assign
      463                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      464               .
      465             end.
      466             run diasize_position-resize-button in this-procedure .
      467           end.
      468           else do:
      469             if frame Dialog-Frame :scrollable = true
      470             then do:
      471               assign
      472                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      473               .
      474             end.
      475             assign
      476               frame Dialog-Frame :height = v-frame-height
      477             .
      478             assign
      479               v-diasize-browse-handle :height = v-browse-height
      480             .
      481             for each buf_temp-browse-handle
      482               where buf_temp-browse-handle.browse-type = 'height':u
      483             on error undo, next
      484             :
      485               assign
      486                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      487               .
      488             end.
      489             for each buf_temp-diasize-handle
      490             on error undo, next
      491             :
      492               assign
      493                 v-object-handle = buf_temp-diasize-handle.handle-value
      494               .
      495               if v-object-handle <> v-diasize-resize-button
      496               then do:
      497                 assign
      498                   v-object-handle :row = buf_temp-diasize-handle.save-position
      499                 .
      500               end.
      501             end.
      502             run diasize_position-resize-button in this-procedure .
      503           end.
      504           assign
      505             v-diasize-change-size = false
      506           .
      507           leave move_block .
      508         end.
      509       end.
      510       assign
      511         v-diasize-need-full-display = true
      512       .
      513       if v-diasize-change-size = false
      514       then do:
      515         assign
      516           v-diasize-change-size = true
      517         .
      518       end.
      519       else do:
      520         return .
      521       end.
      522       assign
      523         v-frame-height = frame Dialog-Frame :height
      524         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      525         v-browse-height = v-diasize-browse-handle :height
      526       .
      527       for each buf_temp-browse-handle
      528         where buf_temp-browse-handle.browse-type = 'height':u
      529       :
      530         assign
      531           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      532         .
      533       end.
      534       for each buf_temp-diasize-handle
      535       :
      536         delete buf_temp-diasize-handle .
      537       end.
      538       assign
      539         v-field-group-handle = frame Dialog-Frame :first-child
      540       .
      541       do while valid-handle(v-field-group-handle)
      542       :
      543         assign
      544           v-object-handle = v-field-group-handle :first-child
      545         .
      546         do while valid-handle(v-object-handle)
      547         :
      548           if  v-object-handle <> v-diasize-browse-handle :handle
      549           and can-query(v-object-handle, "row")
      550           and can-query(v-object-handle, "height")
      551           and ( v-object-handle :row > v-diasize-browse-handle :row )
      552           then do:
      553             find first buf_temp-browse-handle
      554               where buf_temp-browse-handle.browse-type   = 'height':u
      555                 and buf_temp-browse-handle.browse-handle = v-object-handle
      556               no-error .
      557             if available buf_temp-browse-handle
      558             then do:
      559             end.
      560             else do:
      561               create buf_temp-diasize-handle .
      562               assign
      563                 buf_temp-diasize-handle.handle-value  = v-object-handle
      564                 buf_temp-diasize-handle.save-position = v-object-handle :row
      565               .
      566             end.
      567           end.
      568           assign
      569             v-object-handle = v-object-handle :next-sibling
      570           .
      571         end.
      572         assign
      573           v-field-group-handle = v-field-group-handle :next-sibling
      574         .
      575       end.
      576       do with frame Dialog-Frame
      577       :
      578         hide v-diasize-resize-button .
      579         assign
      580           v-diasize-resize-button :row    = 1
      581           v-diasize-resize-button :column = 1
      582         .
      583       end.
      584       if p-change-value > 0
      585       then do:
      586         if frame Dialog-Frame :scrollable = true
      587         then do:
      588           assign
      589             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      590             no-error .
      591           if error-status :error
      592           or error-status :get-message(1) <> ""
      593           then do:
      594             undo move_block, retry move_block .
      595           end.
      596         end.
      597         assign
      598           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      599           no-error .
      600         if error-status :error
      601         or error-status :get-message(1) <> ""
      602         then do:
      603           undo move_block, retry move_block .
      604         end.
      605         assign
      606           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      607           no-error .
      608         if error-status :error
      609         or error-status :get-message(1) <> ""
      610         then do:
      611           undo move_block, retry move_block .
      612         end.
      613         for each buf_temp-browse-handle
      614           where buf_temp-browse-handle.browse-type = 'height':u
      615         on error undo move_block, retry move_block
      616         :
      617           assign
      618             buf_temp-browse-handle.browse-handle :height
      619               = buf_temp-browse-handle.browse-handle :height + p-change-value
      620             no-error .
      621           if error-status :error
      622           or error-status :get-message(1) <> ""
      623           then do:
      624             undo move_block, retry move_block .
      625           end.
      626         end.
      627         for each buf_temp-diasize-handle
      628         on error undo move_block, retry move_block
      629         :
      630           assign
      631             v-object-handle = buf_temp-diasize-handle.handle-value
      632           .
      633           if v-object-handle <> v-diasize-resize-button
      634           then do:
      635             assign
      636               v-object-handle :row = v-object-handle :row + p-change-value
      637               no-error .
      638             if error-status :error
      639             or error-status :get-message(1) <> ""
      640             then do:
      641               undo move_block, retry move_block .
      642             end.
      643           end.
      644         end.
      645       end.
      646       else do:
      647         for each buf_temp-diasize-handle
      648         on error undo move_block, retry move_block
      649         :
      650           assign
      651             v-object-handle = buf_temp-diasize-handle.handle-value
      652           .
      653           if v-object-handle <> v-diasize-resize-button
      654           then do:
      655             assign
      656               v-object-handle :row = v-object-handle :row + p-change-value
      657               no-error .
      658             if error-status :error
      659             or error-status :get-message(1) <> ""
      660             then do:
      661               undo move_block, retry move_block .
      662             end.
      663           end.
      664         end.
      665         assign
      666           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      667           no-error .
      668         if error-status :error
      669         or error-status :get-message(1) <> ""
      670         then do:
      671           undo move_block, retry move_block .
      672         end.
      673         for each buf_temp-browse-handle
      674           where buf_temp-browse-handle.browse-type = 'height':u
      675         on error undo move_block, retry move_block
      676         :
      677           assign
      678             buf_temp-browse-handle.browse-handle :height
      679               = buf_temp-browse-handle.browse-handle :height + p-change-value
      680             no-error .
      681           if error-status :error
      682           or error-status :get-message(1) <> ""
      683           then do:
      684             undo move_block, retry move_block .
      685           end.
      686         end.
      687         assign
      688           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      689           no-error .
      690         if error-status :error
      691         or error-status :get-message(1) <> ""
      692         then do:
      693           undo move_block, retry move_block .
      694         end.
      695         if frame Dialog-Frame :scrollable = true
      696         then do:
      697           assign
      698             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      699             no-error .
      700           if error-status :error
      701           or error-status :get-message(1) <> ""
      702           then do:
      703             undo move_block, retry move_block .
      704           end.
      705         end.
      706       end.
      707       if p-move-resize = true
      708       then do:
      709         run diasize_position-resize-button in this-procedure .
      710       end.
      711       if v-diasize-wndstore = true
      712       then do:
      713         if connected("ub") = true
      714         then do:
      715           define variable v-cntxt-db-num        as integer   no-undo .
      716           define variable v-cntxt-userid        as character no-undo .
      717           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      718                                             , OUTPUT v-cntxt-userid
      719                                             ) .
      720           run gbl/wndsizew.p
      721             (input  v-cntxt-db-num
      722             ,input  v-cntxt-userid
      723             ,input  v-diasize-proc-name
      724             ,input  'height':u
      725             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      726             ) .
      727         end.
      728       end.
      729     end.
      730     assign
      731       v-diasize-change-size = false
      732     .
      733   end procedure.
      734   procedure diasize_set-height :
      735     define input  parameter p-new-height  as decimal   no-undo .
      736     define input  parameter p-move-resize as logical   no-undo .
      737     do
      738     on error undo, return error return-value
      739     :
      740       run diasize_change-height in this-procedure
      741         (input  (p-new-height - frame Dialog-Frame :height)
      742         ,input  p-move-resize
      743         ) .
      744     end.
      745   end procedure.
      746   procedure diasize_change-width :
      747     define input  parameter p-change-value as decimal   no-undo .
      748     define input  parameter p-move-resize  as logical   no-undo .
      749     define variable v-field-group-handle   as handle    no-undo .
      750     define variable v-object-handle        as handle    no-undo .
      751     define variable v-frame-width          as decimal   no-undo .
      752     define variable v-frame-virtual-width  as decimal   no-undo .
      753     define variable v-browse-width         as decimal   no-undo .
      754     define variable v-window-width         as decimal   no-undo .
      755     define variable v-window-virtual-width as decimal   no-undo .
      756     define variable v-change-sign          as integer   no-undo .
      757     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      758     define buffer buf_temp-browse-handle  for temp-browse-handle .
      759     if p-change-value > 0
      760     then do:
      761       if frame Dialog-Frame :width + p-change-value >
      762           session :width-chars
      763       then do:
      764         assign
      765           p-change-value = session :width-chars - frame Dialog-Frame :width
      766         .
      767         if p-change-value <= 0
      768         then do:
      769           run diasize_position-resize-button in this-procedure .
      770           return .
      771         end.
      772       end.
      773     end.
      774     if p-change-value < 0
      775     then do:
      776       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      777       then do:
      778         assign
      779           p-change-value = v-diasize-orig-frame-width
      780                          - frame Dialog-Frame :width
      781         .
      782         if p-change-value >= 0
      783         then do:
      784           run diasize_position-resize-button in this-procedure .
      785           return .
      786         end.
      787       end.
      788     end.
      789     if p-change-value >= 0
      790     then do:
      791       assign
      792         v-change-sign = 1
      793       .
      794     end.
      795     else do:
      796       assign
      797         v-change-sign = -1
      798       .
      799     end.
      800     assign
      801       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      802     .
      803     if p-change-value = 0
      804     then do:
      805       run diasize_position-resize-button in this-procedure .
      806       return .
      807     end.
      808     move_block:
      809     do
      810     on error undo move_block, leave move_block
      811     :
      812       if retry
      813       then do:
      814         do
      815         on error undo move_block, leave move_block
      816         :
      817           if p-change-value > 0
      818           then do:
      819             for each buf_temp-diasize-handle
      820             on error undo, next
      821             :
      822               assign
      823                 v-object-handle = buf_temp-diasize-handle.handle-value
      824               .
      825               if v-object-handle <> v-diasize-resize-button
      826               then do:
      827                 assign
      828                   v-object-handle :col = buf_temp-diasize-handle.save-position
      829                 .
      830               end.
      831             end.
      832             assign
      833               v-diasize-browse-handle :width = v-browse-width
      834             .
      835             for each buf_temp-browse-handle
      836               where buf_temp-browse-handle.browse-type = 'width':u
      837             on error undo, next
      838             :
      839               assign
      840                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      841               .
      842             end.
      843             assign
      844               frame Dialog-Frame :width = v-frame-width
      845             .
      846             if frame Dialog-Frame :scrollable = true
      847             then do:
      848               assign
      849                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      850               .
      851             end.
      852             run diasize_position-resize-button in this-procedure .
      853           end.
      854           else do:
      855             if frame Dialog-Frame :scrollable = true
      856             then do:
      857               assign
      858                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      859               .
      860             end.
      861             assign
      862               frame Dialog-Frame :width = v-frame-width
      863             .
      864             for each buf_temp-browse-handle
      865               where buf_temp-browse-handle.browse-type = 'width':u
      866             on error undo, next
      867             :
      868               assign
      869                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      870               .
      871             end.
      872             assign
      873               v-diasize-browse-handle :width = v-browse-width
      874             .
      875             for each buf_temp-diasize-handle
      876             on error undo, next
      877             :
      878               assign
      879                 v-object-handle = buf_temp-diasize-handle.handle-value
      880               .
      881               if v-object-handle <> v-diasize-resize-button
      882               then do:
      883                 assign
      884                   v-object-handle :col = buf_temp-diasize-handle.save-position
      885                 .
      886               end.
      887             end.
      888             run diasize_position-resize-button in this-procedure .
      889           end.
      890           assign
      891             v-diasize-change-size = false
      892           .
      893           leave move_block .
      894         end.
      895       end.
      896       assign
      897         v-diasize-need-full-display = true
      898       .
      899       if v-diasize-change-size = false
      900       then do:
      901         assign
      902           v-diasize-change-size = true
      903         .
      904       end.
      905       else do:
      906         return .
      907       end.
      908       assign
      909         v-frame-width = frame Dialog-Frame :width
      910         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      911         v-browse-width = v-diasize-browse-handle :width
      912       .
      913       for each buf_temp-browse-handle
      914         where buf_temp-browse-handle.browse-type = 'width':u
      915       :
      916         assign
      917           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      918         .
      919       end.
      920       for each buf_temp-diasize-handle
      921       :
      922         delete buf_temp-diasize-handle .
      923       end.
      924       assign
      925         v-field-group-handle = frame Dialog-Frame :first-child
      926       .
      927       do while valid-handle(v-field-group-handle)
      928       :
      929         assign
      930           v-object-handle = v-field-group-handle :first-child
      931         .
      932         do while valid-handle(v-object-handle)
      933         :
      934           if  v-object-handle <> v-diasize-browse-handle :handle
      935           and v-object-handle <> v-diasize-resize-button
      936           and can-query(v-object-handle, "row")
      937           and can-query(v-object-handle, "height")
      938           and ( v-object-handle :col + v-object-handle :width
      939                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      940               )
      941           then do:
      942             find first buf_temp-browse-handle
      943               where buf_temp-browse-handle.browse-type   = 'width':u
      944                 and buf_temp-browse-handle.browse-handle = v-object-handle
      945               no-error .
      946             if available buf_temp-browse-handle
      947             then do:
      948             end.
      949             else do:
      950               create buf_temp-diasize-handle .
      951               assign
      952                 buf_temp-diasize-handle.handle-value  = v-object-handle
      953                 buf_temp-diasize-handle.save-position = v-object-handle :col
      954               .
      955             end.
      956           end.
      957           assign
      958             v-object-handle = v-object-handle :next-sibling
      959           .
      960         end.
      961         assign
      962           v-field-group-handle = v-field-group-handle :next-sibling
      963         .
      964       end.
      965       do with frame Dialog-Frame
      966       :
      967         hide v-diasize-resize-button .
      968         v-diasize-resize-button :row = 1.
      969         v-diasize-resize-button :column = 1.
      970       end.
      971       if p-change-value > 0
      972       then do:
      973         if frame Dialog-Frame :scrollable = true
      974         then do:
      975           assign
      976             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      977             no-error .
      978           if error-status :error
      979           or error-status :get-message(1) <> ""
      980           then do:
      981             undo move_block, retry move_block.
      982           end.
      983         end.
      984         assign
      985           frame Dialog-Frame :width = v-frame-width + p-change-value
      986           no-error .
      987         if error-status :error
      988         or error-status :get-message(1) <> ""
      989         then do:
      990           undo move_block, retry move_block.
      991         end.
      992         assign
      993           v-diasize-browse-handle :width = v-browse-width + p-change-value
      994         no-error .
      995         if error-status :error
      996         or error-status :get-message(1) <> ""
      997         then do:
      998           undo move_block, retry move_block.
      999         end.
     1000         for each buf_temp-browse-handle
     1001           where buf_temp-browse-handle.browse-type = 'width':u
     1002         on error undo move_block, retry move_block
     1003         :
     1004           assign
     1005             buf_temp-browse-handle.browse-handle :width
     1006               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1007             no-error .
     1008           if error-status :error
     1009           or error-status :get-message(1) <> ""
     1010           then do:
     1011             undo move_block, retry move_block .
     1012           end.
     1013         end.
     1014         for each buf_temp-diasize-handle
     1015         on error undo move_block, retry move_block
     1016         :
     1017           assign
     1018             v-object-handle = buf_temp-diasize-handle.handle-value
     1019           .
     1020           if v-object-handle <> v-diasize-resize-button
     1021           then do:
     1022             assign
     1023               v-object-handle :col = v-object-handle :col + p-change-value
     1024               no-error .
     1025             if error-status :error
     1026             or error-status :get-message(1) <> ""
     1027             then do:
     1028               undo move_block, retry move_block .
     1029             end.
     1030           end.
     1031         end.
     1032       end.
     1033       else do:
     1034         for each buf_temp-diasize-handle
     1035         on error undo move_block, retry move_block
     1036         :
     1037           assign
     1038             v-object-handle = buf_temp-diasize-handle.handle-value
     1039           .
     1040           if v-object-handle <> v-diasize-resize-button
     1041           then do:
     1042             assign
     1043               v-object-handle :col = v-object-handle :col + p-change-value
     1044               no-error .
     1045             if error-status :error
     1046             or error-status :get-message(1) <> ""
     1047             then do:
     1048               undo move_block, retry move_block .
     1049             end.
     1050           end.
     1051         end.
     1052         for each buf_temp-browse-handle
     1053           where buf_temp-browse-handle.browse-type = 'width':u
     1054         on error undo move_block, retry move_block
     1055         :
     1056           assign
     1057             buf_temp-browse-handle.browse-handle :width
     1058               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1059             no-error .
     1060           if error-status :error
     1061           or error-status :get-message(1) <> ""
     1062           then do:
     1063             undo move_block, retry move_block .
     1064           end.
     1065         end.
     1066         assign
     1067           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1068           no-error .
     1069         if error-status :error
     1070         or error-status :get-message(1) <> ""
     1071         then do:
     1072           undo move_block, retry move_block.
     1073         end.
     1074         assign
     1075           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1076         no-error .
     1077         if error-status :error
     1078         or error-status :get-message(1) <> ""
     1079         then do:
     1080           undo move_block, retry move_block.
     1081         end.
     1082         if frame Dialog-Frame :scrollable = true
     1083         then do:
     1084           assign
     1085             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1086           no-error .
     1087           if error-status :error
     1088           or error-status :get-message(1) <> ""
     1089           then do:
     1090             undo move_block, retry move_block.
     1091           end.
     1092         end.
     1093       end.
     1094       if p-move-resize
     1095       then do:
     1096         run diasize_position-resize-button in this-procedure .
     1097       end.
     1098       if v-diasize-wndstore = true
     1099       then do:
     1100         if connected("ub") = true
     1101         then do:
     1102           define variable v-cntxt-db-num        as integer   no-undo .
     1103           define variable v-cntxt-userid        as character no-undo .
     1104           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1105                                             , OUTPUT v-cntxt-userid
     1106                                             ) .
     1107           run gbl/wndsizew.p
     1108             (input  v-cntxt-db-num
     1109             ,input  v-cntxt-userid
     1110             ,input  v-diasize-proc-name
     1111             ,input  'width':u
     1112             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1113             ) .
     1114         end.
     1115       end.
     1116     end.
     1117     assign
     1118       v-diasize-change-size = false
     1119     .
     1120   end procedure.
     1121   procedure diasize_set-width :
     1122     define input  parameter p-new-width  as decimal   no-undo .
     1123     define input  parameter p-move-resize as logical   no-undo .
     1124     do
     1125     on error undo, return error return-value
     1126     :
     1127       run diasize_change-width in this-procedure
     1128         (input  (p-new-width - frame Dialog-Frame :width)
     1129         ,input  p-move-resize
     1130         ) .
     1131     end.
     1132   end procedure.
     1133   procedure diasize_position-resize-button :
     1134     do with frame Dialog-Frame
     1135     :
     1136       hide v-diasize-resize-button .
     1137       assign
     1138         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1139                     - 1
     1140                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1141         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1142                     - 1
     1143                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1144       .
     1145       view v-diasize-resize-button .
     1146     end.
     1147   end procedure.
     1148   on alt-right anywhere
     1149   do:
     1150     run diasize_change-width in this-procedure
     1151       (input 1
     1152       ,input true
     1153       ) .
     1154     return no-apply .
     1155   end.
     1156   on alt-left anywhere
     1157   do:
     1158     run diasize_change-width in this-procedure
     1159       (input -1
     1160       ,input true
     1161       ) .
     1162     return no-apply .
     1163   end.
     1164   on alt-down anywhere
     1165   do:
     1166     run diasize_change-height in this-procedure
     1167       (input 1
     1168       ,input true
     1169       ) .
     1170     return no-apply .
     1171   end.
     1172   on alt-up anywhere
     1173   do:
     1174     run diasize_change-height in this-procedure
     1175       (input -1
     1176       ,input true
     1177       ) .
     1178     return no-apply .
     1179   end.
     1180   on alt-enter of frame Dialog-Frame
     1181   do:
     1182     run diasize_maximize in this-procedure
     1183       (input  ?
     1184       ).
     1185     return no-apply .
     1186   end.
     1187   procedure diasize_end-move :
     1188     do
     1189     on error undo, return error return-value
     1190     :
     1191       define variable v-row-delta as decimal   no-undo .
     1192       define variable v-col-delta as decimal   no-undo .
     1193       define variable v-new-row as decimal   no-undo .
     1194       define variable v-new-col as decimal   no-undo .
     1195       assign
     1196         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1197         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1198       .
     1199       assign
     1200         v-row-delta = v-new-row - frame Dialog-Frame :height
     1201         v-col-delta = v-new-col - frame Dialog-Frame :width
     1202       .
     1203       run diasize_change-height in this-procedure
     1204         (input v-row-delta
     1205         ,input true
     1206         ) .
     1207       run diasize_change-width in this-procedure
     1208         (input v-col-delta
     1209         ,input true
     1210         ) .
     1211     end.
     1212   end procedure.
     1213   procedure diasize_maximize :
     1214     define input  parameter p-action as logical   no-undo .
     1215     do
     1216     on error undo, return error return-value
     1217     :
     1218       if p-action = ?
     1219       then do:
     1220         if v-diasize-need-maximize = true
     1221         then do:
     1222           assign
     1223             p-action = true
     1224           .
     1225         end.
     1226         else do:
     1227           assign
     1228             p-action = false
     1229           .
     1230         end.
     1231       end.
     1232       if p-action = true
     1233       then do:
     1234         run diasize_change-height in this-procedure
     1235           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1236               - frame Dialog-Frame :height-chars
     1237           ,input true
     1238           ) .
     1239         run diasize_change-width in this-procedure
     1240           (input session :width-chars
     1241               - frame Dialog-Frame :width-chars
     1242           ,input true
     1243           ) .
     1244         assign
     1245           v-diasize-need-maximize = false
     1246         .
     1247       end.
     1248       else do:
     1249         run diasize_change-width in this-procedure
     1250           (input v-diasize-orig-frame-width
     1251               - frame Dialog-Frame :width-chars
     1252           ,input true
     1253           ) .
     1254         run diasize_change-height in this-procedure
     1255           (input v-diasize-orig-frame-height
     1256               - frame Dialog-Frame :height-chars
     1257           ,input true
     1258           ) .
     1259         assign
     1260           v-diasize-need-maximize = true
     1261         .
     1262       end.
     1263     end.
     1264   end procedure.
     1265   procedure diasize_restore-orig-size :
     1266     do
     1267     on error undo, return error return-value
     1268     :
     1269       assign
     1270         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1271         v-diasize-current-frame-height = frame Dialog-Frame :height
     1272       .
     1273       run diasize_set-height in this-procedure
     1274         (input  v-diasize-orig-frame-height
     1275         ,input  true
     1276         ) .
     1277       run diasize_set-width in this-procedure
     1278         (input  v-diasize-orig-frame-width
     1279         ,input  true
     1280         ) .
     1281     end.
     1282   end procedure.
     1283   procedure diasize_restore-current-size :
     1284     do
     1285     on error undo, return error return-value
     1286     :
     1287       run diasize_set-height in this-procedure
     1288         (input  v-diasize-current-frame-height
     1289         ,input  true
     1290         ) .
     1291       run diasize_set-width in this-procedure
     1292         (input  v-diasize-current-frame-width
     1293         ,input  true
     1294         ) .
     1295     end.
     1296   end procedure.
     1297   procedure diasize_set-browse-handle :
     1298     define input  parameter p-browse-handle as handle   no-undo .
     1299     define buffer buf_temp-browse-handle for temp-browse-handle .
     1300     do
     1301     on error undo, return error return-value
     1302     :
     1303       assign
     1304         v-diasize-browse-handle = p-browse-handle
     1305       .
     1306       for each buf_temp-browse-handle
     1307       on error undo, return error return-value
     1308       :
     1309         delete buf_temp-browse-handle .
     1310       end.
     1311     end.
     1312   end procedure.
     1313   procedure diasize_add_browse :
     1314     define input  parameter p-browse-type   as character no-undo .
     1315     define input  parameter p-browse-handle as handle    no-undo .
     1316     define buffer buf_temp-browse-handle for temp-browse-handle .
     1317     do
     1318     on error undo, return error return-value
     1319     :
     1320       assign
     1321         v-diasize-browse-number = v-diasize-browse-number + 1
     1322       .
     1323       create buf_temp-browse-handle .
     1324       assign
     1325         buf_temp-browse-handle.browse-type   = p-browse-type
     1326         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1327         buf_temp-browse-handle.browse-handle = p-browse-handle
     1328       .
     1329     end.
     1330   end procedure.
     1331   procedure diasize_init :
     1332     define variable v-default-value    as logical   no-undo .
     1333     define variable v-restore-saved    as logical   no-undo .
     1334     define variable v-resize-value-str as character no-undo .
     1335     do
     1336     on error undo, return error return-value
     1337     :
     1338       do with frame Dialog-Frame
     1339       :
     1340         assign
     1341           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1342           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1343           v-diasize-browse-handle     = browse BR-pl-gds :handle
     1344         .
     1345         create button v-diasize-resize-button
     1346         assign
     1347           parent        = frame Dialog-Frame :first-child
     1348           label         = "s"
     1349           height-pixels = 16
     1350           width-pixels  = 16
     1351           visible       = true
     1352           sensitive     = true
     1353           movable       = true
     1354           triggers:
     1355             on end-move persistent run diasize_end-move in this-procedure .
     1356           end triggers.
     1357         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1358         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1359         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1360         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1361         assign
     1362           v-diasize-wndmax = false
     1363         .
     1364         if connected("ub") = true
     1365         then do:
     1366           define variable v-cntxt-db-num        as integer   no-undo .
     1367           define variable v-cntxt-userid        as character no-undo .
     1368           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1369                                             , OUTPUT v-cntxt-userid
     1370                                             ) .
     1371           run gbl/wndpar_r.p
     1372             (input  v-cntxt-db-num
     1373             ,input  v-cntxt-userid
     1374             ,input  'wndmax':U
     1375             ,output v-diasize-wndmax
     1376             ,output v-default-value
     1377             ) .
     1378         end.
     1379         assign
     1380           v-diasize-wndstore = false
     1381         .
     1382         if connected("ub") = true
     1383         then do:
     1384           run gbl/wndpar_r.p
     1385             (input  v-cntxt-db-num
     1386             ,input  v-cntxt-userid
     1387             ,input  'wndstore':U
     1388             ,output v-diasize-wndstore
     1389             ,output v-default-value
     1390             ) .
     1391         end.
     1392         assign
     1393           v-diasize-proc-name = entry(1, program-name(2), '.')
     1394         .
     1395         if v-diasize-wndstore = true
     1396         then do:
     1397           assign
     1398             v-restore-saved = false
     1399           .
     1400           if connected("ub") = true
     1401           then do:
     1402             run gbl/wndsizer.p
     1403               (input  v-cntxt-db-num
     1404               ,input  v-cntxt-userid
     1405               ,input  v-diasize-proc-name
     1406               ,input  'height':u
     1407               ,output v-resize-value-str
     1408               ) .
     1409             if v-resize-value-str <> '':U
     1410             then do:
     1411               run diasize_change-height in this-procedure
     1412                 (input  integer(v-resize-value-str)
     1413                 ,input  true
     1414                 ) .
     1415               assign
     1416                 v-restore-saved = true
     1417               .
     1418             end.
     1419           end.
     1420           if connected("ub") = true
     1421           then do:
     1422             run gbl/wndsizer.p
     1423               (input  v-cntxt-db-num
     1424               ,input  v-cntxt-userid
     1425               ,input  v-diasize-proc-name
     1426               ,input  'width':u
     1427               ,output v-resize-value-str
     1428               ) .
     1429             if v-resize-value-str <> '':U
     1430             then do:
     1431               run diasize_change-width in this-procedure
     1432                 (input  integer(v-resize-value-str)
     1433                 ,input  true
     1434                 ) .
     1435               assign
     1436                 v-restore-saved = true
     1437               .
     1438             end.
     1439           end.
     1440           if v-restore-saved <> true
     1441           then do:
     1442             if v-diasize-wndmax = true
     1443             then do:
     1444               run diasize_maximize in this-procedure
     1445                 (input  true
     1446                 ) .
     1447             end.
     1448           end.
     1449         end.
     1450         else do:
     1451           if v-diasize-wndmax = true
     1452           then do:
     1453             run diasize_maximize in this-procedure
     1454               (input  true
     1455               ) .
     1456           end.
     1457         end.
     1458       end.
     1459     end.
     1460   end procedure.
     1461   procedure diasize_need-full-display :
     1462     define output parameter p-need-full-display as logical   no-undo .
     1463     do
     1464     on error undo, return error return-value
     1465     :
     1466       assign
     1467         p-need-full-display = v-diasize-need-full-display
     1468       .
     1469       assign
     1470         v-diasize-need-full-display = false
     1471       .
     1472     end.
     1473   end procedure.
     1474   procedure get-context :
     1475      define output parameter p-db-num as integer          no-undo.
     1476      define output parameter p-user-id as character        no-undo.
     1477      define variable v-login               as character    no-undo.
     1478      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1479      define buffer buf_user-login  for ub.user-login .
     1480      do
     1481      on error undo, return error
     1482      :
     1483            FIND FIRST buf_sys-ctrl no-lock.
     1484            ASSIGN
     1485               v-login = USERID("ub")
     1486               p-db-num = buf_sys-ctrl.db-num
     1487            .
     1488            FIND FIRST buf_user-login
     1489                 WHERE buf_user-login.db-num = p-db-num
     1490                   AND buf_user-login.user-login = v-login
     1491                 no-lock
     1492                 no-error
     1493                 .
     1494            IF AVAILABLE buf_user-login
     1495            THEN DO:
     1496               assign
     1497                  p-user-id = buf_user-login.user-id
     1498               .
     1499            END.
     1500      end.
     1501   end procedure.
     1502       run diasize_init in this-procedure .
     1503   MAIN-BLOCK:
     1504   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1505      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1506     assign
     1507     X_pl-gds.tolerance:read-only in browse BR-pl-gds = true.
     1508     do ii = 1 to num-entries(in-pl-codes) :
     1509       for first b-place no-lock where b-place.pl-code = integer(entry(ii, in-pl-codes)) :
     1510         create tt-com-place .
     1511         assign tt-com-place.pl-code = b-place.pl-code .
     1512       end .
     1513     end .
     1514     RUN MyENable.
     1515     RUN OpenBR in this-procedure  ( input yes, input no, input '':U).
     1516     APPLY "ENTRY" to br-pl-gds.
     1517     WAIT-FOR GO OF FRAME Dialog-Frame.
     1518   END.
     1519   RUN disable_UI.
     1520   PROCEDURE disable_UI :
     1521     HIDE FRAME Dialog-Frame.
     1522   END PROCEDURE.
     1523   PROCEDURE enable_UI :
     1524     ENABLE B-exit B-sel B-Help BR-pl-gds
     1525         WITH FRAME Dialog-Frame.
     1526     VIEW FRAME Dialog-Frame.
     1527   END PROCEDURE.
     1528   PROCEDURE Myenable :
     1529   ASSIGN
     1530   br-pl-gds:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1.
     1531   ENABLE
     1532   B-exit
     1533   B-sel
     1534   B-Help
     1535   BR-pl-gds
     1536   WITH FRAME Dialog-Frame .
     1537   VIEW FRAME Dialog-Frame .
     1538   END PROCEDURE.
     1539   PROCEDURE OpenBr :
     1540   define input  parameter p-open-query     as logical   no-undo .
     1541   define input  parameter p-find-next      as logical   no-undo .
     1542   define input  parameter p-find-condition as character no-undo .
     1543   define variable l-query-was-opened as logical no-undo .
     1544   define buffer buf_clients for ub.clients.
     1545   open query BR-pl-gds
     1546   for each tt-com-place,
     1547       each X_pl-gds where X_pl-gds.pl-code = tt-com-place.pl-code no-lock,
     1548       each X_goods where X_goods.gds-code = X_pl-gds.gds-code no-lock,
     1549       each X_place where X_place.obj-code = X_pl-gds.obj-code
     1550                      and X_place.obj-type = X_pl-gds.obj-type
     1551                      and X_place.pl-code  = X_pl-gds.pl-code
     1552                      no-lock
     1553   .
     1554   if avail X_pl-gds then
     1555   APPLY "VALUE-CHANGED":U to br-pl-gds in frame Dialog-Frame.
     1556   END PROCEDURE.
