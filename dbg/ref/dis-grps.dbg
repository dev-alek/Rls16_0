      410   procedure fltfield-clear :
      411     define output parameter loc-fld as character no-undo.
      412     define output parameter loc-lab as character no-undo .
      413     define output parameter loc-spr as character no-undo .
      414     define output parameter loc-dim as character no-undo .
      415     assign
      416       loc-fld = ""
      417       loc-lab = ""
      418       loc-spr = ""
      419       loc-dim = "0"
      420     .
      421   end procedure .
      422   procedure fltfield-add :
      423     define input        parameter par-fld as character no-undo.
      424     define input        parameter par-lab as character no-undo .
      425     define input        parameter par-spr as character no-undo .
      426     define input-output parameter loc-fld as character no-undo.
      427     define input-output parameter loc-lab as character no-undo .
      428     define input-output parameter loc-spr as character no-undo .
      429     define input-output parameter loc-dim as character no-undo .
      430     do
      431     on error undo, return error
      432     :
      433       assign
      434       loc-fld = if loc-dim = '0'
      435                 then par-fld
      436                 else (loc-fld + chr(44) + par-fld)
      437       loc-lab = if loc-dim = '0'
      438                 then par-lab
      439                 else (loc-lab + chr(44) + par-lab)
      440       loc-spr = if loc-dim = '0'
      441                 then par-spr
      442                 else (loc-spr + chr(44) + par-spr)
      443       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      444                 string(integer(if num-entries(loc-dim) > 1
      445                               then entry(2, loc-dim)
      446                               else entry(1, loc-dim)
      447                               ) + 1)
      448       no-error
      449       .
      450     end.
      451   end procedure.
      452   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      453   define  stream PrnLibStream.
      454   procedure prn-lib-prn-file :
      455     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      456     define input parameter p-DIsabledoptions as integer no-undo .
      457     define variable v-report-name as character no-undo .
      458     define variable v-user-action as character no-undo .
      459     define variable v-printed     as logical   no-undo .
      460     define variable v-exist       as logical   no-undo .
      461     do
      462       on error undo, return error
      463       :
      464       run prn-lib-get-report-name  in this-procedure (
      465         input parParentProc
      466         ,output v-report-name
      467         ).
      468   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      469   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      470     (input  v-report-name
      471     ,input  2
      472     ,output v-exist
      473     )  .
      474       if NOT v-exist then
      475       DO:
      476         Message
      477           "Нет заданий на печать ! "
      478           view-as alert-box .
      479         Return  .
      480       End.
      481       run gbl/prnfilen.w
      482         (input  ""
      483         ,input  p-DisabledOptions
      484         ,input  string(v-report-name )
      485         ,input  7
      486         ,output v-user-action
      487         ,output v-printed
      488         ) .
      489       if v-printed then
      490       do:
      491         return "YES" .
      492       end.
      493       else
      494       do:
      495         return "NO" .
      496       end.
      497     end.
      498   end procedure.
      499   procedure prn-lib-open-stream :
      500     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      501     define input parameter p-page-size    as integer no-undo .
      502     define input parameter p-is-stream    as logical no-undo .
      503     define input parameter p-append       as logical no-undo .
      504     define variable v-report-name as character no-undo .
      505     do
      506       on error undo, return error
      507       :
      508       run prn-lib-get-report-name  in this-procedure (
      509         input parParentProc
      510         ,output v-report-name
      511         ).
      512       if p-is-stream then
      513       do:
      514         if p-append then
      515         do:
      516           output stream PrnLibStream to value( v-report-name )
      517             page-size value(p-page-size) append .
      518         end.
      519         if not p-append then
      520         do:
      521           output stream PrnLibStream to value( v-report-name )
      522             page-size value(p-page-size) .
      523         end.
      524       end.
      525       if not p-is-stream then
      526       do:
      527         if p-append then
      528         do:
      529           output to value( v-report-name )
      530             page-size value(p-page-size) append .
      531         end.
      532         if not p-append then
      533         do:
      534           output to value( v-report-name )
      535             page-size value(p-page-size) .
      536         end.
      537       end.
      538     end.
      539   end procedure.
      540   procedure prn-lib-open-exp :
      541     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      542     define input parameter p-is-stream    as logical no-undo .
      543     define input parameter p-is-append    as logical no-undo .
      544     define output parameter p-ReportFileName as char init "report" no-undo.
      545     define output parameter p-process as logical no-undo .
      546     define variable glog as logical no-undo .
      547     do
      548       on error undo, return error
      549       :
      550       SYSTEM-DIALOG GET-FILE p-ReportFileName
      551         TITLE      "Укажите путь"
      552         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      553         ASK-OVERWRITE
      554         CREATE-TEST-FILE
      555         SAVE-AS
      556         USE-FILENAME
      557         DEFAULT-EXTENSION "txt"
      558         UPDATE glog
      559         .
      560       if not glog then  return.
      561       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      562       if p-is-stream then
      563       do:
      564         if p-is-append then
      565         do:
      566           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      567         end.
      568         else
      569         do:
      570           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      571         end.
      572       end.
      573       else
      574       do:
      575         if p-is-append then
      576         do:
      577           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      578         end.
      579         else
      580         do:
      581           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      582         end.
      583       end.
      584       p-process = yes.
      585     end.
      586   end procedure.
      587   procedure prn-lib-get-report-name :
      588     define input parameter parParentProc  as widget-handle no-undo.
      589     define output parameter p-report-name as character no-undo .
      590     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      591   end procedure.
      592   procedure prn-lib-reportviewer-report-name :
      593     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      594     define input parameter p-report-name-html as character no-undo .
      595     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      596   end procedure.
      597   procedure prn-lib-reportviewer :
      598     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      599     define input parameter p-report-name-html as character no-undo .
      600     define input parameter p-param        as character no-undo .
      601     define variable v-excel           as character no-undo init 'TRUE' .
      602     define variable v-value-character as character no-undo .
      603     define variable v-value-integer   as character no-undo .
      604     define variable v-value-date      as date      no-undo .
      605     define variable v-value-decimal   as decimal   no-undo .
      606     define variable rep-excel         as logical   no-undo .
      607     define variable excel-string      as character no-undo .
      608     define variable v-param-type      as character no-undo .
      609     define variable v-tth             as handle    no-undo .
      610     run adm/shattri.p (
      611       input "get":U
      612       ,input  ""
      613       ,input  0
      614       ,input  'report-glob':U
      615       ,input  'rep-excel':U
      616       ,output v-value-character
      617       ,output v-value-date
      618       ,output v-value-decimal
      619       ,output v-value-integer
      620       ,output rep-excel
      621       ,output v-param-type
      622       ,INPUT-OUTPUT table-handle v-tth
      623       )  .
      624     if rep-excel then v-excel = "TRUE" .
      625     else v-excel = "FALSE" .
      626     if p-param eq ""
      627     then
      628        p-param = "EXCEL:" + v-excel.
      629     else
      630        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      631     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      632   end procedure.
      633   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      634   FUNCTION mark-string RETURNS CHARACTER
      635     ( input p-recid as recid, input mark-list as character  ) :
      636     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      637   END FUNCTION.
      638   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      639   procedure cur-time :
      640      define output parameter p-today as date      no-undo .
      641      define output parameter p-time  as integer   no-undo .
      642     do
      643     on error undo, return error
      644     :
      645       define variable v-date1 as date      no-undo .
      646       define variable v-date2 as date      no-undo .
      647       define variable v-time  as integer   no-undo .
      648       assign
      649         v-date1 = today
      650         v-time  = time
      651         v-date2 = today
      652       .
      653       if v-date1 <> v-date2
      654       then do:
      655         assign
      656           v-date1 = today
      657           v-time  = v-time
      658         .
      659       end.
      660       assign
      661         p-today = v-date1
      662         p-time  = v-time
      663       .
      664     end.
      665   end.
      666   function cur-time-date returns character
      667   :
      668     return string(today, '99/99/9999':U) .
      669   end.
      670   function cur-time-mjd returns decimal
      671   :
      672     define variable v-date as date      no-undo .
      673     define variable v-time as integer   no-undo .
      674     run cur-time in this-procedure
      675       (output v-date
      676       ,output v-time
      677       ) .
      678     return integer(v-date) - 2400002 + (v-time / 86400) .
      679   end.
      680   function cur-time-get-ending-index returns integer
      681   (input p-number as integer
      682   )
      683   :
      684     if p-number < 0
      685     or p-number = ?
      686     then do:
      687       return 1 .
      688     end.
      689     define variable v-rest as integer   no-undo .
      690     assign
      691       p-number = p-number modulo 100
      692     .
      693     if p-number < 20
      694     then do:
      695       assign
      696         v-rest = p-number
      697       .
      698     end.
      699     else do:
      700       assign
      701         v-rest = p-number modulo 10
      702       .
      703     end.
      704     case v-rest :
      705       when 1
      706       then do:
      707         return 2 .
      708       end.
      709       when 2 or
      710       when 3 or
      711       when 4
      712       then do:
      713         return 3 .
      714       end.
      715       otherwise do:
      716         return 1 .
      717       end.
      718     end case .
      719   end.
      720   procedure cur-time-mjd-to-date :
      721      define input  parameter i-mjd-diff as decimal no-undo.
      722      define output parameter o-Date     as date    no-undo.
      723      define output parameter o-Time     as integer no-undo.
      724      define variable v-day-number as integer   no-undo .
      725      if    i-mjd-diff < 0
      726         or i-mjd-diff = ?
      727      then do:
      728         return "?" .
      729      end.
      730      assign
      731         v-day-number = truncate(i-mjd-diff,0).
      732         o-Date = date(v-day-number + 2400002).
      733         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      734     .
      735   end.
      736   function cur-time-mjd-to-string returns character
      737   (input p-mjd-diff as decimal
      738   )
      739   :
      740     define variable v-day-number as integer   no-undo .
      741     define variable v-seconds    as integer   no-undo .
      742     define variable v-hour       as integer   no-undo .
      743     define variable v-min        as integer   no-undo .
      744     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      745     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      746     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      747     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      748     if p-mjd-diff < 0
      749     or p-mjd-diff = ?
      750     then do:
      751       return "?" .
      752     end.
      753     assign
      754       v-day-number = integer(truncate(p-mjd-diff,0))
      755       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      756     .
      757     if v-seconds > 86400
      758     then do:
      759       assign
      760         v-seconds = 86400 - 1
      761       .
      762     end.
      763     if v-seconds < 0
      764     then do:
      765       assign
      766         v-seconds = 0
      767       .
      768     end.
      769     assign
      770       v-hour = truncate(v-seconds / 3600, 0)
      771     .
      772     assign
      773       v-seconds = v-seconds modulo 3600
      774     .
      775     assign
      776       v-min = truncate(v-seconds / 60, 0)
      777     .
      778     assign
      779       v-seconds = v-seconds modulo 60
      780     .
      781     return
      782         (if v-day-number <> 0
      783           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      784           else ""
      785         )
      786       + (if v-day-number <> 0 or v-hour <> 0
      787           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      788           else ""
      789         )
      790       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      791           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      792           else ""
      793         )
      794       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      795       .
      796   end.
      797   function cur-time-string returns character
      798   :
      799     define variable v-date as date      no-undo .
      800     define variable v-time as integer   no-undo .
      801     run cur-time in this-procedure
      802       (output v-date
      803       ,output v-time
      804       ) .
      805     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      806   end.
      807   function cur-time-string-sec returns character
      808   :
      809     define variable v-date as date      no-undo .
      810     define variable v-time as integer   no-undo .
      811     run cur-time in this-procedure
      812       (output v-date
      813       ,output v-time
      814       ) .
      815     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      816   end.
      817   function cur-time-custom  returns character
      818   (input p-prefix as character
      819   ,input p-date-format as character
      820   ,input p-delimiter as character
      821   ,input p-time-format as character
      822   ,input p-suffix as character
      823   )
      824   :
      825     define variable v-date as date      no-undo .
      826     define variable v-time as integer   no-undo .
      827     run cur-time in this-procedure
      828       (output v-date
      829       ,output v-time
      830       ) .
      831     return
      832       p-prefix
      833       + string(v-date, p-date-format)
      834       + p-delimiter
      835       + string(v-time, p-time-format)
      836       + p-suffix
      837       .
      838   end.
      839   function cur-time-print  returns character
      840   :
      841     define variable v-date as date      no-undo .
      842     define variable v-time as integer   no-undo .
      843     run cur-time in this-procedure
      844       (output v-date
      845       ,output v-time
      846       ) .
      847     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      848   end.
      849   function cur-time-datetime returns datetime
      850   :
      851     define variable v-char as character no-undo .
      852     define variable v-datetime as datetime no-undo .
      853     v-char = cur-time-string().
      854     v-datetime = datetime(v-char).
      855     return  v-datetime.
      856   end.
      857   function cur-time-string-msec returns character
      858   :
      859     define variable v-date as datetime  no-undo .
      860     v-date = now.
      861     return string(v-date) .
      862   end.
      863   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      864   procedure cli-grplib-get-full-name :
      865      define input parameter  p-node-code  as integer      no-undo.
      866      define output parameter p-full-name as character    no-undo.
      867   do
      868   on error undo, return error
      869   :
      870       define variable v-upper-code    as integer           no-undo.
      871       define buffer buf_cli-grp       for ub.cli-grp.
      872       define buffer buf_upper_cli-grp for ub.cli-grp.
      873       find first buf_cli-grp no-lock
      874            where buf_cli-grp.node-code = p-node-code
      875       no-error.
      876       if not available buf_cli-grp
      877       then do:
      878           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      879       end.
      880       assign
      881           p-full-name  = ""
      882           v-upper-code = 1
      883       .
      884       do while buf_cli-grp.upper-code <> 0
      885       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      886       :
      887           assign
      888               p-full-name  = buf_cli-grp.node-name
      889                            + (if p-full-name <> "" then chr(47) else "")
      890                            + p-full-name
      891               v-upper-code = buf_cli-grp.upper-code
      892           .
      893           find first buf_cli-grp no-lock
      894                where buf_cli-grp.node-code = v-upper-code
      895           no-error.
      896           if not available buf_cli-grp
      897           then do:
      898               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      899                                   + string( v-upper-code )
      900                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      901           end.
      902       end.
      903       assign
      904       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      905       .
      906   end.
      907   end .
      908   procedure cgrplib-get-node-from-full-name :
      909   define input parameter p-full-name as character no-undo .
      910   define output parameter p-node-code as integer no-undo .
      911   define variable v-ii as integer no-undo .
      912   define variable v-upper-code as integer no-undo .
      913   define variable v-root-code as integer no-undo .
      914   define variable v-entry as character no-undo .
      915   define buffer buf_cli-grp       for ub.cli-grp.
      916   do
      917   on error undo, return error
      918   :
      919     find first buf_cli-grp no-lock
      920         where buf_cli-grp.upper-code = 0
      921     no-error .
      922     if not available buf_cli-grp
      923     then do:
      924         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      925     end.
      926     else do:
      927       assign
      928       v-root-code = buf_cli-grp.node-code
      929       .
      930     end.
      931     v-upper-code = v-root-code.
      932     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      933       assign
      934       v-entry = entry(v-ii, p-full-name, chr(47)).
      935       if v-entry = '' then leave.
      936       find first buf_cli-grp no-lock where
      937                 buf_cli-grp.node-name = v-entry
      938             and buf_cli-grp.upper-code = v-upper-code
      939             no-error.
      940       if not available buf_cli-grp then do:
      941         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      942       end.
      943       else do:
      944         p-node-code = buf_cli-grp.node-code.
      945         v-upper-code = buf_cli-grp.node-code.
      946       end.
      947     end.
      948   end.
      949   end .
      950   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      952   procedure fltopend_fltopend :
      953   define input parameter p-parent-handle as handle no-undo .
      954   define input parameter p-qh as handle no-undo .
      955   define input parameter p-flt-open-open-query  as character no-undo .
      956   define input parameter p-where-cond as character no-undo .
      957   define input parameter p-use-indFIRST-query-tail as character no-undo .
      958   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      959   define input parameter p-indexed-reposition as character no-undo .
      960     do
      961     on error undo, return error
      962     :
      963   define variable v-prepare-string as character no-undo .
      964   define variable glog as logical no-undo .
      965   assign
      966   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      967                      p-where-cond + chr(32)  +
      968                      p-use-indFIRST-query-tail + chr(32) +
      969                      p-use-ind-sort-clmn-by + chr(32) +
      970                      p-indexed-reposition
      971   .
      972   assign
      973   glog = p-qh:query-prepare(v-prepare-string) no-error .
      974   if not glog
      975   or error-status:error then do:
      976     message error-status:get-message(1) view-as alert-box .
      977     undo, return error .
      978   end.
      979   assign
      980   glog = p-qh:query-open no-error .
      981   if not glog
      982   or error-status:error then do:
      983     message error-status:get-message(1) view-as alert-box .
      984     undo, return error .
      985   end.
      986     end.
      987   end procedure.
      988   procedure fltopend_fltfindd :
      989   define input parameter p-parent-handle as handle no-undo .
      990   define input parameter p-qh as handle no-undo .
      991   define input parameter p-rowid as rowid no-undo .
      992   define input parameter p-next as logical no-undo .
      993   define input parameter p-lock as integer no-undo .
      994   define input parameter p-bh as handle no-undo .
      995   define input parameter p-where-cond as character no-undo .
      996   define input parameter p-use-index-phrase as character no-undo .
      997   define variable glog as logical no-undo .
      998   define variable v-qh as handle no-undo .
      999   define variable v-bh as handle no-undo .
     1000   define variable v-recid as recid no-undo .
     1001   define variable v-prepare-string as character no-undo .
     1002   do
     1003   on error undo, return error
     1004   on stop undo, return error
     1005   :
     1006     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1007     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1008     create query v-qh.
     1009     v-qh:set-buffers(v-bh).
     1010     v-prepare-string = substitute("for each &1 &2 &3"
     1011                                     ,v-bh:name
     1012                                     ,p-where-cond
     1013                                     ,p-use-index-phrase).
     1014     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1015     if not glog then do:
     1016       delete object v-qh.
     1017       delete object v-bh.
     1018       undo, return error .
     1019     end.
     1020     glog = v-qh:query-open no-error .
     1021     if not glog then do:
     1022       delete object v-qh.
     1023       delete object v-bh.
     1024       undo, return error .
     1025     end.
     1026     if p-next then do:
     1027       v-qh:reposition-to-rowid(p-rowid) no-error .
     1028       glog = v-qh:get-next( p-lock) no-error .
     1029       glog = v-qh:get-next( p-lock) no-error .
     1030       if not glog or v-qh:query-off-end = yes then do:
     1031         glog = v-qh:get-first( p-lock) no-error .
     1032       end.
     1033     end.
     1034     else do:
     1035       glog = v-qh:get-first( p-lock) no-error .
     1036     end.
     1037     v-recid = v-bh:recid no-error .
     1038     delete object v-qh.
     1039     delete object v-bh.
     1040     return string(v-recid) .
     1041   end.
     1042   end procedure.
     1043   procedure fltopend_fltfindq :
     1044   define input parameter p-parent-handle as handle no-undo .
     1045   define input parameter p-qh as handle no-undo .
     1046   define input parameter p-next as logical no-undo .
     1047   define input parameter p-lock as integer no-undo .
     1048   define input parameter p-flt-open-open-query  as character no-undo .
     1049   define input parameter p-where-cond as character no-undo .
     1050   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1051   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1052   define input parameter p-indexed-reposition as character no-undo .
     1053   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1054   define variable glog as logical no-undo .
     1055   define variable v-qh as handle no-undo .
     1056   define variable v-bh as handle no-undo extent 18.
     1057   define variable v-rowid as rowid no-undo extent 18.
     1058   define variable v-ii as integer no-undo .
     1059   define variable v-prepare-string as character no-undo .
     1060   do
     1061   on error undo, return error
     1062   on stop undo, return error
     1063   :
     1064     create query v-qh.
     1065     do v-ii = 1 to p-qh:num-buffers:
     1066       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1067       assign
     1068       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1069       no-error.
     1070       v-qh:add-buffer(v-bh[v-ii]).
     1071     end.
     1072     assign
     1073     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1074                       p-where-cond + chr(32)  +
     1075                       p-use-indFIRST-query-tail + chr(32) +
     1076                       p-use-ind-sort-clmn-by + chr(32) +
     1077                       p-indexed-reposition
     1078     .
     1079     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1080     if not glog then do:
     1081       delete object v-qh.
     1082       do v-ii = 1 to p-qh:num-buffers:
     1083         delete object v-bh[v-ii].
     1084       end.
     1085       undo, return error .
     1086     end.
     1087     glog = v-qh:query-open no-error .
     1088     if not glog then do:
     1089       delete object v-qh.
     1090       do v-ii = 1 to p-qh:num-buffers:
     1091         delete object v-bh[v-ii].
     1092       end.
     1093       undo, return error .
     1094     end.
     1095     if p-next then do:
     1096       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1097       glog = v-qh:get-next( p-lock) no-error .
     1098       glog = v-qh:get-next( p-lock) no-error .
     1099       if not glog or v-qh:query-off-end = yes then do:
     1100         glog = v-qh:get-first( p-lock) no-error .
     1101       end.
     1102     end.
     1103     else do:
     1104       glog = v-qh:get-first( p-lock) no-error .
     1105     end.
     1106     do v-ii = 1 to p-qh:num-buffers:
     1107       assign
     1108       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1109       no-error.
     1110     end.
     1111     delete object v-qh.
     1112     do v-ii = 1 to p-qh:num-buffers:
     1113       delete object v-bh[v-ii].
     1114     end.
     1115   end.
     1116   end procedure.
     1117   DEFINE VARIABLE gds-rec AS RECID NO-UNDO.
     1118   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1119   define variable filter-point as character no-undo init "dis-gprs" .
     1120   define variable filter-point0 as character no-undo init "dis-grps" .
     1121   define variable filter-label as character no-undo init "Скидки на группы" .
     1122   define variable filter-label0 as character no-undo init "Скидки на группы" .
     1123   define variable sort-column-name as character no-undo .
     1124   define variable v-rid-list as character no-undo .
     1125   DEFINE BUFFER par_dis-rule FOR ub.dis-rule.
     1126   DEFINE BUFFER par_dis-cfg-rule FOR ub.dis-cfg-rule.
     1127   FUNCTION full-grp-name RETURNS CHARACTER
     1128     ( INPUT p-classif-type AS CHARACTER
     1129       ,INPUT p-node-code AS integer
     1130       ,INPUT p-host-code AS INTEGER
     1131       ,INPUT p-obj-type AS CHARACTER
     1132       ,INPUT p-obj-code AS INTEGER)  FORWARD.
     1133   DEFINE BUTTON b-dis-rule
     1134        LABEL "Правило"
