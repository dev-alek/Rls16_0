     1167   DEFINE BROWSE BR-dis-grp-rule
     1168     QUERY BR-dis-grp-rule NO-LOCK DISPLAY
     1169         mark-string(recid(X_dis-grp-rule), v-rid-list) COLUMN-LABEL '*' FORMAT "X(1)"
