     1211     run ref/show-dr.p ( INPUT parparentproc
     1212                        ,INPUT X_dis-grp-rule.rule-num) NO-ERROR.
     1213     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1214   END.
     1215   ON CHOOSE OF b-grp IN FRAME Dialog-Frame
     1216   DO:
     1217   DEFINE VARIABLE v-ref-rec AS RECID NO-UNDO.
     1218   define buffer buf_sum-grp for ub.sum-grp.
     1219   CASE p-classif-type:
     1220     when 'sum-grp':U then do:
     1221       FIND FIRST buf_sum-grp No-LOCK WHERE
     1222                   buf_sum-grp.grp-code = X_dis-grp-rule.node-code no-error .
     1223       if error-status:error then  return no-apply.
     1224       v-ref-rec = recid( buf_sum-grp ) .
     1225       run ref/sum-grpi.w (  input parparentproc
     1226                           , input 'ПРОСМОТР':U
     1227                           , input-output v-ref-rec).
     1228     end.
     1229     when 'gds-grp':U then do:
     1230     end.
     1231   end case.
     1232   apply "entry" to br-dis-grp-rule in frame Dialog-Frame.
     1233   END.
     1234   ON CHOOSE OF b-history IN FRAME Dialog-Frame
     1235   DO:
     1236   define variable v-loc-rid-list as character no-undo .
     1237   if not available X_dis-grp-rule then return no-apply.
     1238     CASE X_dis-grp-rule.classif-type:
     1239       when 'sum-grp':U then do:
     1240         run ref/csumgrps.w (
     1241                        INPUT parparentproc
     1242                       ,INPUT '':U
     1243                       ,INPUT 'subject':U
     1244                       ,INPUT X_sum-grp.grp-code
     1245                       ,input 'dis-grp-rule':U
     1246                       ,INPUT-OUTPUT v-loc-rid-list) NO-ERROR.
     1247       end.
     1248     end case.
     1249   APPLY "ENTRY" to br-dis-grp-rule.
     1250   END.
     1251   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1252   DO:
     1253     RUN proc-b-mark IN THIS-PROCEDURE NO-ERROR.
     1254     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1255   END.
     1256   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1257   DO:
     1258     run proc-b-print in this-procedure no-error.
     1259     if error-status:error then do:
     1260       return no-apply.
     1261     end.
     1262     APPLY "ENTRY" to br-dis-grp-rule.
     1263   END.
     1264   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1265   DO:
     1266     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1267     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1268   END.
     1269   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1270   DO:
     1271       if ( available X_dis-grp-rule ) then do:
     1272       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1273       then
     1274       v-rid-list = string( recid( X_dis-grp-rule ) ) .
     1275     end.
     1276   END.
     1277   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1278   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1279   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1280   on help of frame Dialog-Frame
     1281   do:
     1282     run gbl/app_help.p
     1283       (input this-procedure :file-name
     1284       ,input ''
     1285       ,input ?
     1286       ) no-error.
     1287     if error-status :error then do:
     1288       message
     1289         "Ошибка при вызове помощи"
     1290         error-status :get-message(1)
     1291         view-as alert-box .
     1292     end.
     1293   end.
     1294   run minbtn-set in this-procedure .
     1295   on choose of b-help in frame Dialog-Frame
     1296   do:
     1297     apply "help":u to frame Dialog-Frame .
     1298   end.
     1299   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1300   procedure minbtn-set :
     1301       do
     1302           on error undo, return error return-value
     1303           :
     1304           define variable ii              as integer       no-undo .
     1305           define variable fh              as widget-handle no-undo .
     1306           define variable hh              as widget-handle no-undo .
     1307           define variable v-h             as handle        extent 4 no-undo .
     1308           define variable v-name-button   as character     no-undo .
     1309           define variable v-help-old-x    as decimal       no-undo .
     1310           define variable v-help-old-y    as decimal       no-undo .
     1311           define variable v-help-old-size as decimal       no-undo .
     1312           define variable v-frame-width   as decimal       no-undo .
     1313           define variable jj              as integer       no-undo .
     1314           do
     1315               on error undo, return error
     1316               :
     1317               assign
     1318                   v-frame-width = frame Dialog-Frame:width - 0.3
     1319                   fh            = frame Dialog-Frame:first-child
     1320                   hh            = fh:first-child
     1321                   ii            = 1
     1322                   .
     1323               do while valid-handle(hh):
     1324                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1325                   do:
     1326                       case lc(hh:name) :
     1327                           when "b-help" then
     1328                               do:
     1329                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1330                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1331                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1332                                   hh:TOOLTIP = "Помощь" .
     1333                                   v-help-old-x = hh:column .
     1334                                   v-help-old-y = hh:row    .
     1335                                   v-help-old-size = hh:width .
     1336                                   hh:width-chars = 2.5 .
     1337                               end.
     1338                           when "b-print" then
     1339                               do:
     1340                                   hh:load-image("cmp/b-print.bmp":u) .
     1341                                   hh:TOOLTIP = "Печать" .
     1342                                   v-h[ii] = hh:handle .
     1343                                   ii = ii + 1 .
     1344                                   hh:width-chars = 3 .
     1345                               end.
     1346                           when "b-history" or
     1347                           when "b-hist" then
     1348                               do:
     1349                                   hh:load-image("cmp/b-hist.bmp":u) .
     1350                                   hh:TOOLTIP = "История" .
     1351                                   v-h[ii] = hh:handle .
     1352                                   ii = ii + 1 .
     1353                                   hh:width-chars = 3 .
     1354                               end.
     1355                           when "b-sch" then
     1356                               do:
     1357                                   hh:load-image("cmp/b-sch.bmp":u) .
     1358                                   hh:TOOLTIP = "Установка Фильтра" .
     1359                                   v-h[ii] = hh:handle .
     1360                                   ii = ii + 1 .
     1361                                   hh:width-chars = 3 .
     1362                               end.
     1363                           when "b-hist-user" then
     1364                               do:
     1365                                   hh:load-image("cmp/b-hist.bmp":u) .
     1366                                   hh:TOOLTIP = "История пользователя" .
     1367                                   ii = ii + 1 .
     1368                               end.
     1369                       end case.
     1370                   end.
     1371                   hh = hh:next-sibling.
     1372               end.
     1373               b-help:column = v-frame-width - b-help:width-chars.
     1374               jj = 0.
     1375               repeat ii = 4 to 1 by -1 :
     1376                   if valid-handle (v-h[ii] ) then
     1377                   do:
     1378                       jj  = jj + 1 .
     1379                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1380                       v-h[ii]:row    = v-help-old-y .
     1381                   end.
     1382               end.
     1383           end.
     1384       end.
     1385   end procedure.
     1386   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1387   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1388   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1389   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1390   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1391   define variable v-diasize-current-frame-height as decimal   no-undo .
     1392   define variable v-diasize-change-size          as logical   no-undo .
     1393   define variable v-diasize-resize-button        as handle    no-undo .
     1394   define variable v-diasize-wndmax               as logical   no-undo .
     1395   define variable v-diasize-wndstore             as logical   no-undo .
     1396   define variable v-diasize-proc-name            as character no-undo .
     1397   define variable v-diasize-browse-handle        as handle    no-undo .
     1398   define variable v-diasize-browse-number        as integer   no-undo .
     1399   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1400   define temp-table temp-diasize-handle no-undo
     1401     field handle-value  as handle
     1402     field save-position as decimal
     1403     index xpk is primary unique handle-value
     1404     .
     1405   define temp-table temp-browse-handle no-undo
     1406     field browse-type   as character
     1407     field browse-number as integer
     1408     field browse-handle as handle
     1409     field original-size as decimal
     1410     index xpk is primary unique browse-type browse-number
     1411     index xie browse-type browse-handle
     1412   .
     1413   procedure diasize_change-height :
     1414     define input  parameter p-change-value  as decimal   no-undo .
     1415     define input  parameter p-move-resize   as logical   no-undo .
     1416     define variable v-field-group-handle    as handle    no-undo .
     1417     define variable v-object-handle         as handle    no-undo .
     1418     define variable v-frame-height          as decimal   no-undo .
     1419     define variable v-frame-virtual-height  as decimal   no-undo .
     1420     define variable v-browse-height         as decimal   no-undo .
     1421     define variable v-window-height         as decimal   no-undo .
     1422     define variable v-window-virtual-height as decimal   no-undo .
     1423     define variable v-change-sign           as integer   no-undo .
     1424     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1425     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1426     if p-change-value > 0
     1427     then do:
     1428       if frame Dialog-Frame :height + p-change-value
     1429           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1430       then do:
     1431         assign
     1432           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1433                           - (frame Dialog-Frame :height-chars)
     1434         .
     1435         if p-change-value <= 0
     1436         then do:
     1437           run diasize_position-resize-button in this-procedure .
     1438           return .
     1439         end.
     1440       end.
     1441     end.
     1442     if p-change-value < 0
     1443     then do:
     1444       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1445       then do:
     1446         assign
     1447           p-change-value = v-diasize-orig-frame-height
     1448                          - (frame Dialog-Frame :height-chars)
     1449         .
     1450         if p-change-value >= 0
     1451         then do:
     1452           run diasize_position-resize-button in this-procedure .
     1453           return .
     1454         end.
     1455       end.
     1456     end.
     1457     if p-change-value >= 0
     1458     then do:
     1459       assign
     1460         v-change-sign = 1
     1461       .
     1462     end.
     1463     else do:
     1464       assign
     1465         v-change-sign = -1
     1466       .
     1467     end.
     1468     assign
     1469       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1470     .
     1471     if p-change-value = 0
     1472     then do:
     1473       run diasize_position-resize-button in this-procedure .
     1474       return .
     1475     end.
     1476     move_block:
     1477     do
     1478     on error undo move_block, retry move_block
     1479     :
     1480       if retry
     1481       then do:
     1482         do
     1483         on error undo move_block, leave move_block
     1484         :
     1485           if p-change-value > 0
     1486           then do:
     1487             for each buf_temp-diasize-handle
     1488             on error undo, next
     1489             :
     1490               assign
     1491                 v-object-handle = buf_temp-diasize-handle.handle-value
     1492               .
     1493               if v-object-handle <> v-diasize-resize-button
     1494               then do:
     1495                 assign
     1496                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1497                 .
     1498               end.
     1499             end.
     1500             assign
     1501               v-diasize-browse-handle :height = v-browse-height
     1502             .
     1503             for each buf_temp-browse-handle
     1504               where buf_temp-browse-handle.browse-type = 'height':u
     1505             on error undo, next
     1506             :
     1507               assign
     1508                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1509               .
     1510             end.
     1511             assign
     1512               frame Dialog-Frame :height = v-frame-height
     1513             .
     1514             if frame Dialog-Frame :scrollable = true
     1515             then do:
     1516               assign
     1517                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1518               .
     1519             end.
     1520             run diasize_position-resize-button in this-procedure .
     1521           end.
     1522           else do:
     1523             if frame Dialog-Frame :scrollable = true
     1524             then do:
     1525               assign
     1526                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1527               .
     1528             end.
     1529             assign
     1530               frame Dialog-Frame :height = v-frame-height
     1531             .
     1532             assign
     1533               v-diasize-browse-handle :height = v-browse-height
     1534             .
     1535             for each buf_temp-browse-handle
     1536               where buf_temp-browse-handle.browse-type = 'height':u
     1537             on error undo, next
     1538             :
     1539               assign
     1540                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1541               .
     1542             end.
     1543             for each buf_temp-diasize-handle
     1544             on error undo, next
     1545             :
     1546               assign
     1547                 v-object-handle = buf_temp-diasize-handle.handle-value
     1548               .
     1549               if v-object-handle <> v-diasize-resize-button
     1550               then do:
     1551                 assign
     1552                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1553                 .
     1554               end.
     1555             end.
     1556             run diasize_position-resize-button in this-procedure .
     1557           end.
     1558           assign
     1559             v-diasize-change-size = false
     1560           .
     1561           leave move_block .
     1562         end.
     1563       end.
     1564       assign
     1565         v-diasize-need-full-display = true
     1566       .
     1567       if v-diasize-change-size = false
     1568       then do:
     1569         assign
     1570           v-diasize-change-size = true
     1571         .
     1572       end.
     1573       else do:
     1574         return .
     1575       end.
     1576       assign
     1577         v-frame-height = frame Dialog-Frame :height
     1578         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1579         v-browse-height = v-diasize-browse-handle :height
     1580       .
     1581       for each buf_temp-browse-handle
     1582         where buf_temp-browse-handle.browse-type = 'height':u
     1583       :
     1584         assign
     1585           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1586         .
     1587       end.
     1588       for each buf_temp-diasize-handle
     1589       :
     1590         delete buf_temp-diasize-handle .
     1591       end.
     1592       assign
     1593         v-field-group-handle = frame Dialog-Frame :first-child
     1594       .
     1595       do while valid-handle(v-field-group-handle)
     1596       :
     1597         assign
     1598           v-object-handle = v-field-group-handle :first-child
     1599         .
     1600         do while valid-handle(v-object-handle)
     1601         :
     1602           if  v-object-handle <> v-diasize-browse-handle :handle
     1603           and can-query(v-object-handle, "row")
     1604           and can-query(v-object-handle, "height")
     1605           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1606           then do:
     1607             find first buf_temp-browse-handle
     1608               where buf_temp-browse-handle.browse-type   = 'height':u
     1609                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1610               no-error .
     1611             if available buf_temp-browse-handle
     1612             then do:
     1613             end.
     1614             else do:
     1615               create buf_temp-diasize-handle .
     1616               assign
     1617                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1618                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1619               .
     1620             end.
     1621           end.
     1622           assign
     1623             v-object-handle = v-object-handle :next-sibling
     1624           .
     1625         end.
     1626         assign
     1627           v-field-group-handle = v-field-group-handle :next-sibling
     1628         .
     1629       end.
     1630       do with frame Dialog-Frame
     1631       :
     1632         hide v-diasize-resize-button .
     1633         assign
     1634           v-diasize-resize-button :row    = 1
     1635           v-diasize-resize-button :column = 1
     1636         .
     1637       end.
     1638       if p-change-value > 0
     1639       then do:
     1640         if frame Dialog-Frame :scrollable = true
     1641         then do:
     1642           assign
     1643             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1644             no-error .
     1645           if error-status :error
     1646           or error-status :get-message(1) <> ""
     1647           then do:
     1648             undo move_block, retry move_block .
     1649           end.
     1650         end.
     1651         assign
     1652           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1653           no-error .
     1654         if error-status :error
     1655         or error-status :get-message(1) <> ""
     1656         then do:
     1657           undo move_block, retry move_block .
     1658         end.
     1659         assign
     1660           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1661           no-error .
     1662         if error-status :error
     1663         or error-status :get-message(1) <> ""
     1664         then do:
     1665           undo move_block, retry move_block .
     1666         end.
     1667         for each buf_temp-browse-handle
     1668           where buf_temp-browse-handle.browse-type = 'height':u
     1669         on error undo move_block, retry move_block
     1670         :
     1671           assign
     1672             buf_temp-browse-handle.browse-handle :height
     1673               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1674             no-error .
     1675           if error-status :error
     1676           or error-status :get-message(1) <> ""
     1677           then do:
     1678             undo move_block, retry move_block .
     1679           end.
     1680         end.
     1681         for each buf_temp-diasize-handle
     1682         on error undo move_block, retry move_block
     1683         :
     1684           assign
     1685             v-object-handle = buf_temp-diasize-handle.handle-value
     1686           .
     1687           if v-object-handle <> v-diasize-resize-button
     1688           then do:
     1689             assign
     1690               v-object-handle :row = v-object-handle :row + p-change-value
     1691               no-error .
     1692             if error-status :error
     1693             or error-status :get-message(1) <> ""
     1694             then do:
     1695               undo move_block, retry move_block .
     1696             end.
     1697           end.
     1698         end.
     1699       end.
     1700       else do:
     1701         for each buf_temp-diasize-handle
     1702         on error undo move_block, retry move_block
     1703         :
     1704           assign
     1705             v-object-handle = buf_temp-diasize-handle.handle-value
     1706           .
     1707           if v-object-handle <> v-diasize-resize-button
     1708           then do:
     1709             assign
     1710               v-object-handle :row = v-object-handle :row + p-change-value
     1711               no-error .
     1712             if error-status :error
     1713             or error-status :get-message(1) <> ""
     1714             then do:
     1715               undo move_block, retry move_block .
     1716             end.
     1717           end.
     1718         end.
     1719         assign
     1720           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1721           no-error .
     1722         if error-status :error
     1723         or error-status :get-message(1) <> ""
     1724         then do:
     1725           undo move_block, retry move_block .
     1726         end.
     1727         for each buf_temp-browse-handle
     1728           where buf_temp-browse-handle.browse-type = 'height':u
     1729         on error undo move_block, retry move_block
     1730         :
     1731           assign
     1732             buf_temp-browse-handle.browse-handle :height
     1733               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1734             no-error .
     1735           if error-status :error
     1736           or error-status :get-message(1) <> ""
     1737           then do:
     1738             undo move_block, retry move_block .
     1739           end.
     1740         end.
     1741         assign
     1742           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1743           no-error .
     1744         if error-status :error
     1745         or error-status :get-message(1) <> ""
     1746         then do:
     1747           undo move_block, retry move_block .
     1748         end.
     1749         if frame Dialog-Frame :scrollable = true
     1750         then do:
     1751           assign
     1752             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1753             no-error .
     1754           if error-status :error
     1755           or error-status :get-message(1) <> ""
     1756           then do:
     1757             undo move_block, retry move_block .
     1758           end.
     1759         end.
     1760       end.
     1761       if p-move-resize = true
     1762       then do:
     1763         run diasize_position-resize-button in this-procedure .
     1764       end.
     1765       if v-diasize-wndstore = true
     1766       then do:
     1767         if connected("ub") = true
     1768         then do:
     1769           define variable v-cntxt-db-num        as integer   no-undo .
     1770           define variable v-cntxt-userid        as character no-undo .
     1771           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1772                                             , OUTPUT v-cntxt-userid
     1773                                             ) .
     1774           run gbl/wndsizew.p
     1775             (input  v-cntxt-db-num
     1776             ,input  v-cntxt-userid
     1777             ,input  v-diasize-proc-name
     1778             ,input  'height':u
     1779             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1780             ) .
     1781         end.
     1782       end.
     1783     end.
     1784     assign
     1785       v-diasize-change-size = false
     1786     .
     1787   end procedure.
     1788   procedure diasize_set-height :
     1789     define input  parameter p-new-height  as decimal   no-undo .
     1790     define input  parameter p-move-resize as logical   no-undo .
     1791     do
     1792     on error undo, return error return-value
     1793     :
     1794       run diasize_change-height in this-procedure
     1795         (input  (p-new-height - frame Dialog-Frame :height)
     1796         ,input  p-move-resize
     1797         ) .
     1798     end.
     1799   end procedure.
     1800   procedure diasize_change-width :
     1801     define input  parameter p-change-value as decimal   no-undo .
     1802     define input  parameter p-move-resize  as logical   no-undo .
     1803     define variable v-field-group-handle   as handle    no-undo .
     1804     define variable v-object-handle        as handle    no-undo .
     1805     define variable v-frame-width          as decimal   no-undo .
     1806     define variable v-frame-virtual-width  as decimal   no-undo .
     1807     define variable v-browse-width         as decimal   no-undo .
     1808     define variable v-window-width         as decimal   no-undo .
     1809     define variable v-window-virtual-width as decimal   no-undo .
     1810     define variable v-change-sign          as integer   no-undo .
     1811     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1812     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1813     if p-change-value > 0
     1814     then do:
     1815       if frame Dialog-Frame :width + p-change-value >
     1816           session :width-chars
     1817       then do:
     1818         assign
     1819           p-change-value = session :width-chars - frame Dialog-Frame :width
     1820         .
     1821         if p-change-value <= 0
     1822         then do:
     1823           run diasize_position-resize-button in this-procedure .
     1824           return .
     1825         end.
     1826       end.
     1827     end.
     1828     if p-change-value < 0
     1829     then do:
     1830       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1831       then do:
     1832         assign
     1833           p-change-value = v-diasize-orig-frame-width
     1834                          - frame Dialog-Frame :width
     1835         .
     1836         if p-change-value >= 0
     1837         then do:
     1838           run diasize_position-resize-button in this-procedure .
     1839           return .
     1840         end.
     1841       end.
     1842     end.
     1843     if p-change-value >= 0
     1844     then do:
     1845       assign
     1846         v-change-sign = 1
     1847       .
     1848     end.
     1849     else do:
     1850       assign
     1851         v-change-sign = -1
     1852       .
     1853     end.
     1854     assign
     1855       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1856     .
     1857     if p-change-value = 0
     1858     then do:
     1859       run diasize_position-resize-button in this-procedure .
     1860       return .
     1861     end.
     1862     move_block:
     1863     do
     1864     on error undo move_block, leave move_block
     1865     :
     1866       if retry
     1867       then do:
     1868         do
     1869         on error undo move_block, leave move_block
     1870         :
     1871           if p-change-value > 0
     1872           then do:
     1873             for each buf_temp-diasize-handle
     1874             on error undo, next
     1875             :
     1876               assign
     1877                 v-object-handle = buf_temp-diasize-handle.handle-value
     1878               .
     1879               if v-object-handle <> v-diasize-resize-button
     1880               then do:
     1881                 assign
     1882                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1883                 .
     1884               end.
     1885             end.
     1886             assign
     1887               v-diasize-browse-handle :width = v-browse-width
     1888             .
     1889             for each buf_temp-browse-handle
     1890               where buf_temp-browse-handle.browse-type = 'width':u
     1891             on error undo, next
     1892             :
     1893               assign
     1894                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1895               .
     1896             end.
     1897             assign
     1898               frame Dialog-Frame :width = v-frame-width
     1899             .
     1900             if frame Dialog-Frame :scrollable = true
     1901             then do:
     1902               assign
     1903                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1904               .
     1905             end.
     1906             run diasize_position-resize-button in this-procedure .
     1907           end.
     1908           else do:
     1909             if frame Dialog-Frame :scrollable = true
     1910             then do:
     1911               assign
     1912                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1913               .
     1914             end.
     1915             assign
     1916               frame Dialog-Frame :width = v-frame-width
     1917             .
     1918             for each buf_temp-browse-handle
     1919               where buf_temp-browse-handle.browse-type = 'width':u
     1920             on error undo, next
     1921             :
     1922               assign
     1923                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1924               .
     1925             end.
     1926             assign
     1927               v-diasize-browse-handle :width = v-browse-width
     1928             .
     1929             for each buf_temp-diasize-handle
     1930             on error undo, next
     1931             :
     1932               assign
     1933                 v-object-handle = buf_temp-diasize-handle.handle-value
     1934               .
     1935               if v-object-handle <> v-diasize-resize-button
     1936               then do:
     1937                 assign
     1938                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1939                 .
     1940               end.
     1941             end.
     1942             run diasize_position-resize-button in this-procedure .
     1943           end.
     1944           assign
     1945             v-diasize-change-size = false
     1946           .
     1947           leave move_block .
     1948         end.
     1949       end.
     1950       assign
     1951         v-diasize-need-full-display = true
     1952       .
     1953       if v-diasize-change-size = false
     1954       then do:
     1955         assign
     1956           v-diasize-change-size = true
     1957         .
     1958       end.
     1959       else do:
     1960         return .
     1961       end.
     1962       assign
     1963         v-frame-width = frame Dialog-Frame :width
     1964         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1965         v-browse-width = v-diasize-browse-handle :width
     1966       .
     1967       for each buf_temp-browse-handle
     1968         where buf_temp-browse-handle.browse-type = 'width':u
     1969       :
     1970         assign
     1971           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1972         .
     1973       end.
     1974       for each buf_temp-diasize-handle
     1975       :
     1976         delete buf_temp-diasize-handle .
     1977       end.
     1978       assign
     1979         v-field-group-handle = frame Dialog-Frame :first-child
     1980       .
     1981       do while valid-handle(v-field-group-handle)
     1982       :
     1983         assign
     1984           v-object-handle = v-field-group-handle :first-child
     1985         .
     1986         do while valid-handle(v-object-handle)
     1987         :
     1988           if  v-object-handle <> v-diasize-browse-handle :handle
     1989           and v-object-handle <> v-diasize-resize-button
     1990           and can-query(v-object-handle, "row")
     1991           and can-query(v-object-handle, "height")
     1992           and ( v-object-handle :col + v-object-handle :width
     1993                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1994               )
     1995           then do:
     1996             find first buf_temp-browse-handle
     1997               where buf_temp-browse-handle.browse-type   = 'width':u
     1998                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1999               no-error .
     2000             if available buf_temp-browse-handle
     2001             then do:
     2002             end.
     2003             else do:
     2004               create buf_temp-diasize-handle .
     2005               assign
     2006                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2007                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2008               .
     2009             end.
     2010           end.
     2011           assign
     2012             v-object-handle = v-object-handle :next-sibling
     2013           .
     2014         end.
     2015         assign
     2016           v-field-group-handle = v-field-group-handle :next-sibling
     2017         .
     2018       end.
     2019       do with frame Dialog-Frame
     2020       :
     2021         hide v-diasize-resize-button .
     2022         v-diasize-resize-button :row = 1.
     2023         v-diasize-resize-button :column = 1.
     2024       end.
     2025       if p-change-value > 0
     2026       then do:
     2027         if frame Dialog-Frame :scrollable = true
     2028         then do:
     2029           assign
     2030             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2031             no-error .
     2032           if error-status :error
     2033           or error-status :get-message(1) <> ""
     2034           then do:
     2035             undo move_block, retry move_block.
     2036           end.
     2037         end.
     2038         assign
     2039           frame Dialog-Frame :width = v-frame-width + p-change-value
     2040           no-error .
     2041         if error-status :error
     2042         or error-status :get-message(1) <> ""
     2043         then do:
     2044           undo move_block, retry move_block.
     2045         end.
     2046         assign
     2047           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2048         no-error .
     2049         if error-status :error
     2050         or error-status :get-message(1) <> ""
     2051         then do:
     2052           undo move_block, retry move_block.
     2053         end.
     2054         for each buf_temp-browse-handle
     2055           where buf_temp-browse-handle.browse-type = 'width':u
     2056         on error undo move_block, retry move_block
     2057         :
     2058           assign
     2059             buf_temp-browse-handle.browse-handle :width
     2060               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2061             no-error .
     2062           if error-status :error
     2063           or error-status :get-message(1) <> ""
     2064           then do:
     2065             undo move_block, retry move_block .
     2066           end.
     2067         end.
     2068         for each buf_temp-diasize-handle
     2069         on error undo move_block, retry move_block
     2070         :
     2071           assign
     2072             v-object-handle = buf_temp-diasize-handle.handle-value
     2073           .
     2074           if v-object-handle <> v-diasize-resize-button
     2075           then do:
     2076             assign
     2077               v-object-handle :col = v-object-handle :col + p-change-value
     2078               no-error .
     2079             if error-status :error
     2080             or error-status :get-message(1) <> ""
     2081             then do:
     2082               undo move_block, retry move_block .
     2083             end.
     2084           end.
     2085         end.
     2086       end.
     2087       else do:
     2088         for each buf_temp-diasize-handle
     2089         on error undo move_block, retry move_block
     2090         :
     2091           assign
     2092             v-object-handle = buf_temp-diasize-handle.handle-value
     2093           .
     2094           if v-object-handle <> v-diasize-resize-button
     2095           then do:
     2096             assign
     2097               v-object-handle :col = v-object-handle :col + p-change-value
     2098               no-error .
     2099             if error-status :error
     2100             or error-status :get-message(1) <> ""
     2101             then do:
     2102               undo move_block, retry move_block .
     2103             end.
     2104           end.
     2105         end.
     2106         for each buf_temp-browse-handle
     2107           where buf_temp-browse-handle.browse-type = 'width':u
     2108         on error undo move_block, retry move_block
     2109         :
     2110           assign
     2111             buf_temp-browse-handle.browse-handle :width
     2112               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2113             no-error .
     2114           if error-status :error
     2115           or error-status :get-message(1) <> ""
     2116           then do:
     2117             undo move_block, retry move_block .
     2118           end.
     2119         end.
     2120         assign
     2121           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2122           no-error .
     2123         if error-status :error
     2124         or error-status :get-message(1) <> ""
     2125         then do:
     2126           undo move_block, retry move_block.
     2127         end.
     2128         assign
     2129           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2130         no-error .
     2131         if error-status :error
     2132         or error-status :get-message(1) <> ""
     2133         then do:
     2134           undo move_block, retry move_block.
     2135         end.
     2136         if frame Dialog-Frame :scrollable = true
     2137         then do:
     2138           assign
     2139             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2140           no-error .
     2141           if error-status :error
     2142           or error-status :get-message(1) <> ""
     2143           then do:
     2144             undo move_block, retry move_block.
     2145           end.
     2146         end.
     2147       end.
     2148       if p-move-resize
     2149       then do:
     2150         run diasize_position-resize-button in this-procedure .
     2151       end.
     2152       if v-diasize-wndstore = true
     2153       then do:
     2154         if connected("ub") = true
     2155         then do:
     2156           define variable v-cntxt-db-num        as integer   no-undo .
     2157           define variable v-cntxt-userid        as character no-undo .
     2158           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2159                                             , OUTPUT v-cntxt-userid
     2160                                             ) .
     2161           run gbl/wndsizew.p
     2162             (input  v-cntxt-db-num
     2163             ,input  v-cntxt-userid
     2164             ,input  v-diasize-proc-name
     2165             ,input  'width':u
     2166             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2167             ) .
     2168         end.
     2169       end.
     2170     end.
     2171     assign
     2172       v-diasize-change-size = false
     2173     .
     2174   end procedure.
     2175   procedure diasize_set-width :
     2176     define input  parameter p-new-width  as decimal   no-undo .
     2177     define input  parameter p-move-resize as logical   no-undo .
     2178     do
     2179     on error undo, return error return-value
     2180     :
     2181       run diasize_change-width in this-procedure
     2182         (input  (p-new-width - frame Dialog-Frame :width)
     2183         ,input  p-move-resize
     2184         ) .
