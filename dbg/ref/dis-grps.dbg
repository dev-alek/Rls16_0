     4690       define variable  parameter-5-40 as character no-undo .
     4691       define variable  parameter-6-40 as character no-undo .
     4692       define variable  parameter-7-40 as character no-undo .
     4693         assign
     4694         parameter-3-40 =
     4695                                 "FOR EACH X_dis-grp-rule"
     4696         parameter-4-40 =
     4697           (
     4698             if (" X_dis-grp-rule.classif-type = p-classif-type                           and X_dis-grp-rule.discnt-role = p-discnt-role " + " " + where-phrase-40) <> ""
     4699             then  substitute('X_dis-grp-rule.classif-type = &1&2&1                           and X_dis-grp-rule.discnt-role = &1&3&1 ', chr(34), p-classif-type, p-discnt-role) + " " + where-phrase-40
     4700             else "true"
     4701           )
     4702         parameter-5-40 = (" " + "" + " " + "")
     4703         parameter-6-40 = if sort-phrase-40 = ''
     4704                              then
     4705           (
     4706           " " + "  " +
     4707             " " + sort-column-phrase +
     4708           " " + "  "
     4709           )
     4710                              else
     4711           (
     4712           " " + "  " +
     4713             " " + sort-column-phrase +
     4714           " " + sort-phrase-40
     4715           )
     4716         parameter-7-40 =
     4717           " indexed-reposition  "
     4718       .
     4719       do
     4720       on stop undo, leave
     4721       on error undo, leave
     4722       :
     4723         assign
     4724           l-disable-where-40 =
     4725             (" X_dis-grp-rule.classif-type = p-classif-type                           and X_dis-grp-rule.discnt-role = p-discnt-role " + " " + where-phrase-40 = "")
     4726         .
     4727         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4728                             ,input QUERY br-dis-grp-rule:handle
     4729                             ,input parameter-3-40
     4730                             ,input parameter-4-40
     4731                             ,input parameter-5-40
     4732                             ,input parameter-6-40
     4733                             ,input parameter-7-40
     4734                             )
     4735         .
     4736         assign
     4737           l-filter-open-40 = true
     4738         .
     4739       end.
     4740       if l-filter-open-40 = false then do:
     4741         message
     4742           "Ошибка при фильтрации / сортировке" skip
     4743           "Будут показаны записи без учета фильтра" skip
     4744           view-as alert-box .
     4745       end.
     4746       else do:
     4747           assign
     4748             l-query-was-opened = true
     4749           .
     4750       end.
     4751     end.
     4752     if l-filter-open-40 = false then do:
     4753       OPEN QUERY br-dis-grp-rule FOR EACH X_dis-grp-rule
     4754         where  X_dis-grp-rule.classif-type = p-classif-type                           and X_dis-grp-rule.discnt-role = p-discnt-role
     4755         indexed-reposition
     4756     .
     4757         assign
     4758           l-query-was-opened = true
     4759         .
     4760     end.
     4761   end.
     4762   else do:
     4763     assign
     4764       v-doc-rec = recid( X_dis-grp-rule )
     4765     .
     4766     do
     4767     on stop undo, leave
     4768     on error undo, leave
     4769     :
     4770       if QUERY br-dis-grp-rule:handle:get-buffer-handle(1) = (buffer X_dis-grp-rule:handle) then do:
     4771         assign
     4772         parameter-2-40 = (if p-find-next then "true":u else "false":u )
     4773         parameter-4-40 =
     4774           "where ":u +  substitute('X_dis-grp-rule.classif-type = &1&2&1                           and X_dis-grp-rule.discnt-role = &1&3&1 ', chr(34), p-classif-type, p-discnt-role) + " ":u + where-phrase-40 + " ":u + p-find-condition + " " + ""
     4775         parameter-5-40 = "  "
     4776       .
     4777         run fltopend_fltfindd in this-procedure  (
     4778                             input this-procedure:handle
     4779                             ,input QUERY br-dis-grp-rule:handle
     4780                             ,input rowid(X_dis-grp-rule)
     4781                             ,input logical(parameter-2-40)
     4782                             ,input no-lock
     4783                             ,input (buffer X_dis-grp-rule:handle)
     4784                             ,input parameter-4-40
     4785                             ,input parameter-5-40
     4786                             ) no-error.
     4787         .
     4788         assign
     4789           v-doc-rec = integer(return-value)
     4790           v-fltopend-rowid[1] = ?
     4791         .
     4792       end.
     4793       else do:
     4794         assign
     4795         parameter-2-40 = (if p-find-next then "true":u else "false":u )
     4796         parameter-3-40 =  "FOR EACH X_dis-grp-rule"
     4797         parameter-4-40 =
     4798           (
     4799             if (" X_dis-grp-rule.classif-type = p-classif-type                           and X_dis-grp-rule.discnt-role = p-discnt-role " + " " + where-phrase-40) <> ""
     4800             then  substitute('X_dis-grp-rule.classif-type = &1&2&1                           and X_dis-grp-rule.discnt-role = &1&3&1 ', chr(34), p-classif-type, p-discnt-role) + " " + where-phrase-40
     4801             else "true"
     4802           )
     4803         parameter-5-40 = (" " + "" + " " + "" + " " + p-find-condition)
     4804         parameter-6-40 = if sort-phrase-40 = ''
     4805                              then
     4806           (
     4807           " " + "  " +
     4808             " " + sort-column-phrase +
     4809           " " + "  "
     4810           )
     4811                              else
     4812           (
     4813           " " + "  " +
     4814             " " + sort-column-phrase +
     4815           " " + sort-phrase-40
     4816           )
     4817         parameter-7-40 =
     4818           " indexed-reposition  "
     4819       .
     4820         run fltopend_fltfindq in this-procedure  (
     4821                             input this-procedure:handle
     4822                             ,input QUERY br-dis-grp-rule:handle
     4823                             ,input logical(parameter-2-40)
     4824                             ,input no-lock
     4825                             ,input parameter-3-40
     4826                             ,input parameter-4-40
     4827                             ,input parameter-5-40
     4828                             ,input parameter-6-40
     4829                             ,input parameter-7-40
     4830                             ,output v-fltopend-rowid
     4831                             ) no-error.
     4832         .
     4833         v-doc-rec = ?.
     4834       end.
     4835       assign
     4836         l-query-was-opened = true
     4837       .
     4838     end.
     4839   end.
     4840     run waitfram-hide in this-procedure .
     4841     END.
     4842   END CASE.
     4843   if not p-open-query then
     4844   REPOSITION br-dis-grp-rule to recid v-doc-rec No-ERROR.
     4845   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4846   query br-dis-grp-rule:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4847   if error-status:error then do:
     4848     REPOSITION br-dis-grp-rule to row 1 No-ERROR.
     4849   end.
     4850   run waitfram-hide in this-procedure.
     4851   APPLY "VALUE-CHANGED" TO br-dis-grp-rule in frame Dialog-Frame.
     4852   APPLY "ENTRY" TO br-dis-grp-rule.
     4853   END PROCEDURE.
     4854   PROCEDURE proc-b-mark :
     4855   define variable loc#log as logical no-undo .
     4856   if available X_dis-grp-rule then do:
     4857   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4858   define variable v-str-recid42 as character no-undo .
     4859   define variable v-num-entry42 as integer   no-undo .
     4860   assign
     4861     v-str-recid42 = trim( string( recid( X_dis-grp-rule ) , "->>>>>>>>>>>9":U ) )
     4862     v-num-entry42 = lookup( v-str-recid42 , v-rid-list )
     4863   .
     4864   if v-num-entry42 > 0 then do:
     4865     assign
     4866       entry( v-num-entry42, v-rid-list ) = "":U
     4867       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4868     .
     4869   end.
     4870   else do:
     4871     assign
     4872       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid42
     4873     .
     4874   end.
     4875     loc#log = br-dis-grp-rule:refresh() IN FRAME Dialog-Frame .
     4876     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     4877         loc#log = br-dis-grp-rule:select-next-row ().
     4878         apply "VALUE-CHANGED" to br-dis-grp-rule in frame Dialog-Frame.
     4879     end.
     4880     if num-entries( v-rid-list ) = 0
     4881     then
     4882         hide mark-num in frame Dialog-Frame.
     4883     else
     4884         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     4885   end.
     4886   apply "entry" to br-dis-grp-rule in frame Dialog-Frame.
     4887   END PROCEDURE.
     4888   PROCEDURE proc-b-print :
     4889   define variable Line                as char         no-undo.
     4890   define variable v-rec as recid no-undo .
     4891   define variable ii as integer no-undo .
     4892   define variable v-mark as character no-undo .
     4893   define variable v-prod as character no-undo .
     4894   define variable v-d-name as character no-undo .
     4895   define variable v-pos-type as character no-undo .
     4896   Line = fill( "-" , 140 ) .
     4897   define frame list
     4898   v-mark COLUMN-LABEL '*' FORMAT "X(1)"
     4899   X_dis-grp-rule.node-code COLUMN-LABEL 'Код группы' FORMAT ">>>>9"
     4900   X_dis-grp-rule.templ-rl-root COLUMN-LABEL 'Тип правила' FORMAT ">>>>>>>>9"
     4901   v-pos-type COLUMN-LABEL 'Место использ.'
     4902   X_dis-grp-rule.obj-type COLUMN-LABEL 'Тип объ' FORMAT "X(3)"
     4903   X_dis-grp-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>>>>>9"
     4904   v-d-name COLUMN-LABEL 'Тип скидки' FORMAT "X(20)"
     4905   X_dis-grp-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     4906   X_dis-grp-rule.rl-root COLUMN-LABEL '№ корн.правила' FORMAT ">>>>>>>>9"
     4907   HEADER
     4908   cur-time-print() AT 5 format "X(35)"
     4909   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     4910   AT 86 format "X(15)" SKIP
     4911   Line format "x(130)" AT 1
     4912   with width 235 down use-text stream-io no-box .
     4913   v-rec = recid(X_dis-grp-rule).
     4914   DO WHILE available X_dis-grp-rule :
     4915     GET prev br-dis-grp-rule NO-LOCK .
     4916   END.
     4917   GET next br-dis-grp-rule NO-LOCK .
     4918   run prn-lib-open-stream  in this-procedure (
     4919                                                input parParentProc
     4920                                               ,input 43
     4921                                               ,input yes
     4922                                               ,input no
     4923                                               ).
     4924   FORM HEADER
     4925   Line format "X(130)" SKIP
     4926   "Продолжение - на следующей странице" AT 30 SKIP
     4927   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     4928   VIEW stream PrnLibStream FRAME CliBottomFrame .
     4929   PUT stream PrnLibStream space(30)
     4930   frame Dialog-Frame:title format "X(100)" SKIP(2) .
     4931   FORM with frame List .
     4932   DO WHILE available X_dis-grp-rule :
     4933     DISPLAY stream PrnLibStream
     4934     mark-string(recid(X_dis-grp-rule), v-rid-list) @ v-mark
     4935     entry (lookup (p-classif-type, 'sum-grp,cli-grp':u) + 1, ',' + 'Группы товаров (на кассе),Группа клиентов':u)
     4936     X_dis-grp-rule.node-code
     4937     X_dis-grp-rule.templ-rl-root
     4938     entry (lookup (X_dis-grp-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) @ v-pos-type
     4939     X_dis-grp-rule.obj-type
     4940     X_dis-grp-rule.obj-code
     4941     (if p-classif-type = 'sum-grp':U then entry (lookup (X_dis-grp-rule.discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u) else entry (lookup (X_dis-grp-rule.discnt-role, 'cli-grp-pcnt':u) + 1, ',' + '% скидка на группу клиентов':u)) @ v-d-name
     4942     X_dis-grp-rule.rule-num
     4943     X_dis-grp-rule.rl-root
     4944     with frame List .
     4945     DOWN stream PrnLibStream 1 with frame List .
     4946     ii =  ii + 1 .
     4947     if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     4948     run waitfram-show in this-procedure ( input ("Просмотрено строк : " + string( ii )) ) .
     4949     GET next br-dis-grp-rule .
     4950   END.
     4951   run waitfram-hide in this-procedure .
     4952   PUT stream PrnLibStream Line format "X(130)" SKIP.
     4953   HIDE stream PrnLibStream FRAME BottomFrame .
     4954   output stream PrnLibStream close .
     4955   run prn-lib-prn-file in this-procedure (
     4956                                             input parParentProc
     4957                                             ,input 0
     4958                                             ).
     4959   reposition br-dis-grp-rule to recid v-rec no-error.
     4960   if error-status:error then do:
     4961     reposition br-dis-grp-rule to row 1 no-error.
     4962   end.
     4963   APPLy "ENTRY" to br-dis-grp-rule.
     4964   END PROCEDURE.
     4965   PROCEDURE proc-b-sch :
     4966   assign
     4967     tbl = 'dis-grp-rule'
     4968     join-tbl = 'X_dis-grp-rule'
     4969     fld = ""
     4970     lab = ""
     4971     spr = ""
     4972     dim = '0'
     4973     .
     4974     run fltfield-add in this-procedure('templ-rl-root', 'Номер типа(шаблона) правила', '',
     4975     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4976     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     4977     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4978     run fltfield-add in this-procedure('rule-num', '№ правила', '',
     4979     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4980     run fltfield-add in this-procedure('rl-root', '№ корн.правила', '',
     4981     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4982     run fltfield-add in this-procedure('pos-type', 'Место использ.', 'cd-types-discnt',
     4983     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4984     run fltfield-add in this-procedure('discnt-role', 'Тип скидки', '',
     4985     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4986     run fltfield-add in this-procedure('node-code', 'Код группы', '',
     4987     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4988   Filter-Block:
     4989   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4990       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4991       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4992     run gbl/filter.w ( INPUT parparentproc
     4993                        ,INPUT filter-point + chr(4) + filter-label
     4994                        ,INPUT tbl
     4995                        ,INPUT join-tbl
     4996                        ,INPUT fld
     4997                        ,INPUT lab
     4998                        ,INPUT spr
     4999                        ,INPUT dim ).
     5000     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input p-classif-type).
     5001   END.
     5002   END PROCEDURE.
     5003   FUNCTION full-grp-name RETURNS CHARACTER
     5004     ( INPUT p-classif-type AS CHARACTER
     5005       ,INPUT p-node-code AS integer
     5006       ,INPUT p-host-code AS INTEGER
     5007       ,INPUT p-obj-type AS CHARACTER
     5008       ,INPUT p-obj-code AS INTEGER) :
     5009   DEFINE VARIABLE v-node-name AS CHARACTER NO-UNDO.
     5010   DEFINE BUFFER buf_sum-grp FOR ub.sum-grp.
     5011   DEFINE BUFFER buf_cli-grp FOR ub.cli-grp.
     5012   CASE p-classif-type:
     5013       WHEN 'sum-grp':U THEN DO:
     5014          FIND FIRST buf_sum-grp NO-LOCK WHERE
     5015                    buf_sum-grp.grp-code = p-node-code NO-ERROR.
     5016         IF NOT AVAILABLE buf_sum-grp  THEN RETURN substitute("[НЕИЗВЕСТНАЯ ГРУППА &1]", p-node-code).
     5017         RETURN buf_sum-grp.grp-name.
     5018       END.
     5019       WHEN 'cli-grp':U THEN DO:
     5020           FIND FIRST buf_cli-grp NO-LOCK WHERE
     5021                     buf_cli-grp.node-code = p-node-code NO-ERROR.
     5022          IF NOT AVAILABLE buf_cli-grp  THEN RETURN substitute("[НЕИЗВЕСТНАЯ ГРУППА &1]", p-node-code).
     5023          RUN cli-grplib-get-full-name  IN THIS-PROCEDURE ( INPUT p-node-code, OUTPUT v-node-name) NO-ERROR.
     5024          IF ERROR-STATUS:ERROR THEN RETURN substitute("[НЕИЗВЕСТНАЯ ГРУППА &1]", p-node-code).
     5025          RETURN v-node-name.
     5026       END.
     5027   END CASE.
     5028     RETURN "".
     5029   END FUNCTION.
