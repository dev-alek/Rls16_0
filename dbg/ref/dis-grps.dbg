     2187   procedure diasize_position-resize-button :
     2188     do with frame Dialog-Frame
     2189     :
     2190       hide v-diasize-resize-button .
     2191       assign
     2192         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2193                     - 1
     2194                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2195         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2196                     - 1
     2197                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2198       .
     2199       view v-diasize-resize-button .
     2200     end.
     2201   end procedure.
     2202   on alt-right anywhere
     2203   do:
     2204     run diasize_change-width in this-procedure
     2205       (input 1
     2206       ,input true
     2207       ) .
     2208     return no-apply .
     2209   end.
     2210   on alt-left anywhere
     2211   do:
     2212     run diasize_change-width in this-procedure
     2213       (input -1
     2214       ,input true
     2215       ) .
     2216     return no-apply .
     2217   end.
     2218   on alt-down anywhere
     2219   do:
     2220     run diasize_change-height in this-procedure
     2221       (input 1
     2222       ,input true
     2223       ) .
     2224     return no-apply .
     2225   end.
     2226   on alt-up anywhere
     2227   do:
     2228     run diasize_change-height in this-procedure
     2229       (input -1
     2230       ,input true
     2231       ) .
     2232     return no-apply .
     2233   end.
     2234   on alt-enter of frame Dialog-Frame
     2235   do:
     2236     run diasize_maximize in this-procedure
     2237       (input  ?
     2238       ).
     2239     return no-apply .
     2240   end.
     2241   procedure diasize_end-move :
     2242     do
     2243     on error undo, return error return-value
     2244     :
     2245       define variable v-row-delta as decimal   no-undo .
     2246       define variable v-col-delta as decimal   no-undo .
     2247       define variable v-new-row as decimal   no-undo .
     2248       define variable v-new-col as decimal   no-undo .
     2249       assign
     2250         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2251         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2252       .
     2253       assign
     2254         v-row-delta = v-new-row - frame Dialog-Frame :height
     2255         v-col-delta = v-new-col - frame Dialog-Frame :width
     2256       .
     2257       run diasize_change-height in this-procedure
     2258         (input v-row-delta
     2259         ,input true
     2260         ) .
     2261       run diasize_change-width in this-procedure
     2262         (input v-col-delta
     2263         ,input true
     2264         ) .
     2265     end.
     2266   end procedure.
     2267   procedure diasize_maximize :
     2268     define input  parameter p-action as logical   no-undo .
     2269     do
     2270     on error undo, return error return-value
     2271     :
     2272       if p-action = ?
     2273       then do:
     2274         if v-diasize-need-maximize = true
     2275         then do:
     2276           assign
     2277             p-action = true
     2278           .
     2279         end.
     2280         else do:
     2281           assign
     2282             p-action = false
     2283           .
     2284         end.
     2285       end.
     2286       if p-action = true
     2287       then do:
     2288         run diasize_change-height in this-procedure
     2289           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2290               - frame Dialog-Frame :height-chars
     2291           ,input true
     2292           ) .
     2293         run diasize_change-width in this-procedure
     2294           (input session :width-chars
     2295               - frame Dialog-Frame :width-chars
     2296           ,input true
     2297           ) .
     2298         assign
     2299           v-diasize-need-maximize = false
     2300         .
     2301       end.
     2302       else do:
     2303         run diasize_change-width in this-procedure
     2304           (input v-diasize-orig-frame-width
     2305               - frame Dialog-Frame :width-chars
     2306           ,input true
     2307           ) .
     2308         run diasize_change-height in this-procedure
     2309           (input v-diasize-orig-frame-height
     2310               - frame Dialog-Frame :height-chars
     2311           ,input true
     2312           ) .
     2313         assign
     2314           v-diasize-need-maximize = true
     2315         .
     2316       end.
     2317     end.
     2318   end procedure.
     2319   procedure diasize_restore-orig-size :
     2320     do
     2321     on error undo, return error return-value
     2322     :
     2323       assign
     2324         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2325         v-diasize-current-frame-height = frame Dialog-Frame :height
     2326       .
     2327       run diasize_set-height in this-procedure
     2328         (input  v-diasize-orig-frame-height
     2329         ,input  true
     2330         ) .
     2331       run diasize_set-width in this-procedure
     2332         (input  v-diasize-orig-frame-width
     2333         ,input  true
     2334         ) .
     2335     end.
     2336   end procedure.
     2337   procedure diasize_restore-current-size :
     2338     do
     2339     on error undo, return error return-value
     2340     :
     2341       run diasize_set-height in this-procedure
     2342         (input  v-diasize-current-frame-height
     2343         ,input  true
     2344         ) .
     2345       run diasize_set-width in this-procedure
     2346         (input  v-diasize-current-frame-width
     2347         ,input  true
     2348         ) .
     2349     end.
     2350   end procedure.
     2351   procedure diasize_set-browse-handle :
     2352     define input  parameter p-browse-handle as handle   no-undo .
     2353     define buffer buf_temp-browse-handle for temp-browse-handle .
     2354     do
     2355     on error undo, return error return-value
     2356     :
     2357       assign
     2358         v-diasize-browse-handle = p-browse-handle
     2359       .
     2360       for each buf_temp-browse-handle
     2361       on error undo, return error return-value
     2362       :
     2363         delete buf_temp-browse-handle .
     2364       end.
     2365     end.
     2366   end procedure.
     2367   procedure diasize_add_browse :
     2368     define input  parameter p-browse-type   as character no-undo .
     2369     define input  parameter p-browse-handle as handle    no-undo .
     2370     define buffer buf_temp-browse-handle for temp-browse-handle .
     2371     do
     2372     on error undo, return error return-value
     2373     :
     2374       assign
     2375         v-diasize-browse-number = v-diasize-browse-number + 1
     2376       .
     2377       create buf_temp-browse-handle .
     2378       assign
     2379         buf_temp-browse-handle.browse-type   = p-browse-type
     2380         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2381         buf_temp-browse-handle.browse-handle = p-browse-handle
     2382       .
     2383     end.
     2384   end procedure.
     2385   procedure diasize_init :
     2386     define variable v-default-value    as logical   no-undo .
     2387     define variable v-restore-saved    as logical   no-undo .
     2388     define variable v-resize-value-str as character no-undo .
     2389     do
     2390     on error undo, return error return-value
     2391     :
     2392       do with frame Dialog-Frame
     2393       :
     2394         assign
     2395           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2396           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2397           v-diasize-browse-handle     = browse br-dis-grp-rule :handle
     2398         .
     2399         create button v-diasize-resize-button
     2400         assign
     2401           parent        = frame Dialog-Frame :first-child
     2402           label         = "s"
     2403           height-pixels = 16
     2404           width-pixels  = 16
     2405           visible       = true
     2406           sensitive     = true
     2407           movable       = true
     2408           triggers:
     2409             on end-move persistent run diasize_end-move in this-procedure .
     2410           end triggers.
     2411         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2412         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2413         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2414         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2415         assign
     2416           v-diasize-wndmax = false
     2417         .
     2418         if connected("ub") = true
     2419         then do:
     2420           define variable v-cntxt-db-num        as integer   no-undo .
     2421           define variable v-cntxt-userid        as character no-undo .
     2422           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2423                                             , OUTPUT v-cntxt-userid
     2424                                             ) .
     2425           run gbl/wndpar_r.p
     2426             (input  v-cntxt-db-num
     2427             ,input  v-cntxt-userid
     2428             ,input  'wndmax':U
     2429             ,output v-diasize-wndmax
     2430             ,output v-default-value
     2431             ) .
     2432         end.
     2433         assign
     2434           v-diasize-wndstore = false
     2435         .
     2436         if connected("ub") = true
     2437         then do:
     2438           run gbl/wndpar_r.p
     2439             (input  v-cntxt-db-num
     2440             ,input  v-cntxt-userid
     2441             ,input  'wndstore':U
     2442             ,output v-diasize-wndstore
     2443             ,output v-default-value
     2444             ) .
     2445         end.
     2446         assign
     2447           v-diasize-proc-name = entry(1, program-name(2), '.')
     2448         .
     2449         if v-diasize-wndstore = true
     2450         then do:
     2451           assign
     2452             v-restore-saved = false
     2453           .
     2454           if connected("ub") = true
     2455           then do:
     2456             run gbl/wndsizer.p
     2457               (input  v-cntxt-db-num
     2458               ,input  v-cntxt-userid
     2459               ,input  v-diasize-proc-name
     2460               ,input  'height':u
     2461               ,output v-resize-value-str
     2462               ) .
     2463             if v-resize-value-str <> '':U
     2464             then do:
     2465               run diasize_change-height in this-procedure
     2466                 (input  integer(v-resize-value-str)
     2467                 ,input  true
     2468                 ) .
     2469               assign
     2470                 v-restore-saved = true
     2471               .
     2472             end.
     2473           end.
     2474           if connected("ub") = true
     2475           then do:
     2476             run gbl/wndsizer.p
     2477               (input  v-cntxt-db-num
     2478               ,input  v-cntxt-userid
     2479               ,input  v-diasize-proc-name
     2480               ,input  'width':u
     2481               ,output v-resize-value-str
     2482               ) .
     2483             if v-resize-value-str <> '':U
     2484             then do:
     2485               run diasize_change-width in this-procedure
     2486                 (input  integer(v-resize-value-str)
     2487                 ,input  true
     2488                 ) .
     2489               assign
     2490                 v-restore-saved = true
     2491               .
     2492             end.
     2493           end.
     2494           if v-restore-saved <> true
     2495           then do:
     2496             if v-diasize-wndmax = true
     2497             then do:
     2498               run diasize_maximize in this-procedure
     2499                 (input  true
     2500                 ) .
     2501             end.
     2502           end.
     2503         end.
     2504         else do:
     2505           if v-diasize-wndmax = true
     2506           then do:
     2507             run diasize_maximize in this-procedure
     2508               (input  true
     2509               ) .
     2510           end.
     2511         end.
     2512       end.
     2513     end.
     2514   end procedure.
     2515   procedure diasize_need-full-display :
     2516     define output parameter p-need-full-display as logical   no-undo .
     2517     do
     2518     on error undo, return error return-value
     2519     :
     2520       assign
     2521         p-need-full-display = v-diasize-need-full-display
     2522       .
     2523       assign
     2524         v-diasize-need-full-display = false
     2525       .
     2526     end.
     2527   end procedure.
     2528   procedure get-context :
     2529      define output parameter p-db-num as integer          no-undo.
     2530      define output parameter p-user-id as character        no-undo.
     2531      define variable v-login               as character    no-undo.
     2532      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2533      define buffer buf_user-login  for ub.user-login .
     2534      do
     2535      on error undo, return error
     2536      :
     2537            FIND FIRST buf_sys-ctrl no-lock.
     2538            ASSIGN
     2539               v-login = USERID("ub")
     2540               p-db-num = buf_sys-ctrl.db-num
     2541            .
     2542            FIND FIRST buf_user-login
     2543                 WHERE buf_user-login.db-num = p-db-num
     2544                   AND buf_user-login.user-login = v-login
     2545                 no-lock
     2546                 no-error
     2547                 .
     2548            IF AVAILABLE buf_user-login
     2549            THEN DO:
     2550               assign
     2551                  p-user-id = buf_user-login.user-id
     2552               .
     2553            END.
     2554      end.
     2555   end procedure.
     2556   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2557   on f5 of frame Dialog-Frame anywhere
     2558   do:
     2559      v-doc-rec = recid(X_dis-grp-rule).  Run OpenBR in this-procedure ( input yes, input no, input '':U, input p-classif-type).  REPOSITION br-dis-grp-rule to recid v-doc-rec No-ERROR.               apply 'value-changed' to br-dis-grp-rule.
     2560       apply "VALUE-CHANGED" to BR-dis-grp-rule.
     2561   end.
     2562   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2563   on F9 of frame Dialog-Frame anywhere do:
     2564     if not available ub.goods then
     2565       return no-apply.
     2566     gds-rec = recid (ub.goods).
     2567     run ref/gds-form.w ( input parparentproc
     2568                         ,input 'ПРОСМОТР':U
     2569                         ,input ?
     2570                         ,input ?
     2571                         ,input ?
     2572                         ,input-output gds-rec).
     2573     apply "entry" to br-dis-grp-rule in frame Dialog-Frame.
     2574     return no-apply.
     2575   end.
     2576   on SHIFT-F9 of frame Dialog-Frame anywhere do:
     2577     if not available X_sum-grp then
     2578       return no-apply.
     2579     gds-rec = recid (X_sum-grp).
     2580     run ref/gds-form.w ( input parparentproc
     2581                         ,input 'ПРОСМОТР':U
     2582                         ,input ?
     2583                         ,input ?
     2584                         ,input ?
     2585                         ,input-output gds-rec).
     2586     apply "entry" to br-dis-grp-rule in frame Dialog-Frame.
     2587     return no-apply.
     2588   end.
     2589   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2590   procedure set-filter-name :
     2591   define input parameter p-filter-name as character no-undo .
     2592     do with frame Dialog-Frame:
     2593       if p-filter-name > "" then do:
     2594         assign
     2595           frame Dialog-Frame:title
     2596             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2597         .
     2598         assign
     2599           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2600         .
     2601       end.
     2602       else do:
     2603         assign
     2604           b-sch :tooltip = ""
     2605         .
     2606       end.
     2607     end.
     2608   end procedure.
     2609   def var sort-labelbr-dis-grp-rule   as character no-undo .
     2610   def var sort-clmnbr-dis-grp-rule    as handle    no-undo .
     2611   def var cur-clmnbr-dis-grp-rule     as handle    no-undo .
     2612   def var cur-clmn-locbr-dis-grp-rule as integer   no-undo .
     2613   def var re-querybr-dis-grp-rule     as logical   initial no no-undo .
     2614   on start-search, ctrl-o of br-dis-grp-rule in frame Dialog-Frame do:
     2615      run sort-brbr-dis-grp-rule
     2616        (input (if available X_dis-grp-rule
     2617                then recid(X_dis-grp-rule)
     2618                else ?
     2619               )
     2620        ).
     2621   end.
     2622   PROCEDURE sort-brbr-dis-grp-rule :
     2623     define input parameter p-recid as recid no-undo .
     2624     if re-querybr-dis-grp-rule = no then do:
     2625       assign
     2626          cur-clmnbr-dis-grp-rule = br-dis-grp-rule:current-column in frame Dialog-Frame
     2627       .
     2628       if sort-clmnbr-dis-grp-rule <> ? then sort-clmnbr-dis-grp-rule:column-fgcolor = 0.
     2629       if cur-clmnbr-dis-grp-rule = sort-clmnbr-dis-grp-rule then do:
     2630         assign
     2631            sort-labelbr-dis-grp-rule = ""
     2632            sort-clmnbr-dis-grp-rule = ?
     2633         .
     2634        end.
     2635        else do:
     2636          assign
     2637            sort-labelbr-dis-grp-rule = cur-clmnbr-dis-grp-rule:label
     2638            sort-clmnbr-dis-grp-rule  = cur-clmnbr-dis-grp-rule
     2639            sort-clmnbr-dis-grp-rule:column-fgcolor = 4
     2640          .
     2641        end.
     2642      end.
     2643     assign
     2644       cur-clmn-locbr-dis-grp-rule = 1
     2645     .
     2646     def var column-handle as handle no-undo .
     2647     column-handle = br-dis-grp-rule:first-column.
     2648     do while valid-handle(column-handle) :
     2649       if column-handle = cur-clmnbr-dis-grp-rule then do:
     2650         leave .
     2651       end.
     2652       column-handle = column-handle:NEXT-COLUMN.
     2653       assign
     2654         cur-clmn-locbr-dis-grp-rule = cur-clmn-locbr-dis-grp-rule + 1
     2655       .
     2656     end.
     2657     case sort-labelbr-dis-grp-rule:
     2658           when '*'  then DO:    assign       sort-column-name = "mark-string(recid(X_dis-grp-rule), v-rid-list)"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2659           when 'Тип классификатора'  then DO:    assign       sort-column-name = "entry (lookup (X_dis-grp-rule.classif-type, 'sum-grp,cli-grp':u) + 1, ',' + 'Группы товаров (на кассе),Группа клиентов':u)"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2660           when 'Код группы'  then DO:    assign       sort-column-name = "X_dis-grp-rule.node-code"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2661           when 'Тип правила'  then DO:    assign       sort-column-name = "X_dis-grp-rule.templ-rl-root"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2662           when 'Место использ.'  then DO:    assign       sort-column-name = "entry (lookup (X_dis-grp-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2663           when 'Тип объ'  then DO:    assign       sort-column-name = "X_dis-grp-rule.obj-type"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2664           when 'Код объ'  then DO:    assign       sort-column-name = "X_dis-grp-rule.obj-code"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2665           when 'Тип скидки'  then DO:    assign       sort-column-name = "(if p-classif-type = 'sum-grp':U then entry (lookup (X_dis-grp-rule.discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u) else entry (lookup (X_dis-grp-rule.discnt-role, 'cli-grp-pcnt':u) + 1, ',' + '% скидка на группу клиентов':u))"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2666           when '№ правила'  then DO:    assign       sort-column-name = "X_dis-grp-rule.rule-num"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2667           when 'Название группы'  then DO:    assign       sort-column-name = "full-grp-name(X_dis-grp-rule.classif-type, X_dis-grp-rule.node-code, X_dis-grp-rule.host-code, X_dis-grp-rule.obj-type, X_dis-grp-rule.obj-code)"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2668           when '№ корн.правила'  then DO:    assign       sort-column-name = "X_dis-grp-rule.rl-root"     .     run OpenBr in this-procedure ( input yes, input no, input no, input p-classif-type).   . END.
     2669       otherwise do:
     2670         assign
     2671           sort-column-name = ""
     2672         .
     2673         run OpenBr in this-procedure ( input yes, input no, input no, p-classif-type).
     2674         if sort-labelbr-dis-grp-rule <> "" then do:
     2675           assign
     2676             cur-clmnbr-dis-grp-rule:column-fgcolor = 0
     2677           .
     2678         end.
     2679         assign
     2680           cur-clmn-locbr-dis-grp-rule = ?
     2681         .
     2682       end.
     2683     end case.
     2684     if p-recid <> ? then do:
     2685       reposition br-dis-grp-rule to recid p-recid no-error.
     2686       apply "value-changed" to br-dis-grp-rule in frame Dialog-Frame.
     2687     end.
     2688     apply "entry" to br-dis-grp-rule in frame Dialog-Frame.
     2689   END PROCEDURE.
     2690   procedure re-open-query-srt-clmnbr-dis-grp-rule:
     2691   if cur-clmnbr-dis-grp-rule = ? then do:
     2692      run OpenBr in this-procedure ( input yes, input no, input no, p-classif-type).
     2693   end.
     2694   else do:
     2695      assign re-querybr-dis-grp-rule = yes.
     2696      run sort-brbr-dis-grp-rule
     2697        (input (if available X_dis-grp-rule
     2698                then recid(X_dis-grp-rule)
     2699                else ?
     2700               )
     2701        ).
     2702      assign re-querybr-dis-grp-rule = no.
     2703   end.
     2704   end.
     2705   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2706   do:
     2707     BR-dis-grp-rule :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2708   end.
     2709   MAIN-BLOCK:
     2710   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2711      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2712   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2713     run mainmenu_getcntxt in parparentproc
     2714       (output v-cntxt-db-num
     2715       ,output v-cntxt-userid
     2716       ,output v-cntxt-level
     2717       ,output v-cntxt-host-code-obj
     2718       ,output v-cntxt-obj-type
     2719       ,output v-cntxt-obj-code
     2720       ,output v-cntxt-db-num-obj
     2721       ,output v-cntxt-is-admin
     2722       ) .
     2723     IF LOOKUP(p-classif-type, 'sum-grp,cli-grp':u) = 0 THEN DO:
     2724         MESSAGE
     2725         vss-workfile vss-revision vss-description skip
     2726         "Неверный параметр вызова p-classif-type " p-classif-type
     2727         VIEW-AS ALERT-BOX ERROR.
     2728         UNDO, RETURN ERROR.
     2729     END.
     2730     IF lookup(p-list-mode, ('все':U + chr(4) +
     2731                             "pos" + chr(4) +
     2732                             "templ-rl-root" + chr(4) +
     2733                             "discnt-role" + chr(4) +
     2734                             'объект':U + chr(4) +
     2735                             ('объект':U + chr(44) + "pos-type":U) + chr(4) +
     2736                             ('объект':U + chr(44) + "templ-rl-root":U) + chr(4) +
     2737                             ('объект':U + chr(44) + "discnt-role":U) + chr(4) +
     2738                             "rule-num":U + chr(4) +
     2739                             "rl-root":U) , chr(4)) = 0
     2740     THEN DO:
     2741        MESSAGE
     2742        vss-workfile vss-revision vss-description skip
     2743        "Неверный параметр вызова p-list-mode " p-list-mode
     2744        VIEW-AS ALERT-BOX ERROR.
     2745        UNDO, RETURN ERROR.
     2746     END.
     2747     IF lookup('объект':U , p-list-mode) > 0 THEN DO:
     2748       IF p-curr-obj-type <> 'скл':U
     2749       AND p-curr-obj-type <> 'маг':U THEN DO:
     2750           MESSAGE
     2751           vss-workfile vss-revision vss-description skip
     2752           "Неверный параметр вызова p-curr-obj-type " p-curr-obj-type
     2753           VIEW-AS ALERT-BOX ERROR.
     2754           UNDO, RETURN ERROR.
     2755       END.
     2756       FIND FIRST X_clients-obj NO-LOCK WHERE
     2757                 X_clients-obj.obj-type = p-curr-obj-type
     2758            AND  X_clients-obj.obj-code = p-curr-obj-code NO-ERROR.
     2759       IF NOT AVAILABLE X_clients-obj THEN DO:
     2760           MESSAGE
     2761           vss-workfile vss-revision vss-description skip
     2762           "Неверные параметры вызова p-curr-obj-type p-curr-obj-code" p-curr-obj-type p-curr-obj-code
     2763           VIEW-AS ALERT-BOX ERROR.
     2764           UNDO, RETURN ERROR.
     2765       END.
     2766     end.
     2767     IF LOOKUP( "templ-rl-root", p-list-mode) > 0 THEN DO:
     2768         FIND FIRST PAR_dis-rule NO-LOCK WHERE
     2769                   par_dis-rule.rule-num = p-templ-rl-root no-error.
     2770         IF NOT AVAILABLE par_Dis-rule THEN DO:
     2771             MESSAGE
     2772             vss-workfile vss-revision vss-description skip
     2773             "Неверный параметр вызова p-templ-rl-root" p-templ-rl-root
     2774             VIEW-AS ALERT-BOX ERROR.
     2775             UNDO, RETURN ERROR.
     2776         END.
     2777     END.
     2778     IF LOOKUP( "pos-type", p-list-mode) > 0
     2779     AND lookup(p-pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U) = 0  THEN DO:
     2780         MESSAGE
     2781         vss-workfile vss-revision vss-description skip
     2782         "Неверный параметр вызова p-pos-type" p-pos-type
     2783         VIEW-AS ALERT-BOX ERROR.
     2784         UNDO, RETURN ERROR.
     2785     END.
     2786     IF LOOKUP( "discnt-role", p-list-mode) > 0 THEN DO:
     2787       FIND FIRST par_dis-cfg-rule NO-LOCK WHERE
     2788                 par_dis-cfg-rule.discnt-role = p-discnt-role
     2789             AND par_dis-cfg-rule.TABLE-name = 'dis-grp-rule':U NO-ERROR.
     2790       IF NOT AVAILABLE par_dis-cfg-rule  THEN DO:
     2791         MESSAGE
     2792         vss-workfile vss-revision vss-description skip
     2793         "Неверный параметр вызова p-discnt-role" p-discnt-role
     2794         VIEW-AS ALERT-BOX ERROR.
     2795         UNDO, RETURN ERROR.
     2796       END.
     2797     END.
     2798     v-rid-list = p-rid-list.
     2799     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     2800     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2801     WAIT-FOR GO OF FRAME Dialog-Frame.
     2802   END.
     2803   RUN disable_UI.
     2804   PROCEDURE disable_UI :
     2805     HIDE FRAME Dialog-Frame.
     2806   END PROCEDURE.
     2807   PROCEDURE enable_UI :
     2808     DISPLAY mark-num
     2809         WITH FRAME Dialog-Frame.
     2810     ENABLE b-quit B-mark B-sel b-grp b-dis-rule B-sch B-print b-history B-Help
     2811            BR-dis-grp-rule mark-num
     2812         WITH FRAME Dialog-Frame.
     2813     VIEW FRAME Dialog-Frame.
     2814     OPEN QUERY BR-dis-grp-rule FOR EACH X_dis-grp-rule NO-LOCK  INDEXED-REPOSITION.
     2815   END PROCEDURE.
     2816   PROCEDURE MyEnable :
     2817   DEFINE variable v-h as handle no-undo .
     2818   define variable v-ii as integer no-undo .
     2819   v-h = BR-dis-grp-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     2820   DO while valid-handle(v-h)
     2821   and  v-ii < BR-dis-grp-rule:num-COLUMNs IN FRAME Dialog-Frame
     2822   :
     2823     v-ii = v-ii + 1.
     2824     if v-h:LABEL = 'Тип скидки'
     2825     OR v-h:LABEL = 'Название группы'
     2826         then do:
     2827       v-h:RESIZABLE = YES.
     2828     end.
     2829     ELSE DO:
     2830       v-h = v-h:NEXT-COLUMN.
     2831     END.
     2832   END.
     2833   DISPLAY
     2834   mark-num
     2835   WITH FRAME Dialog-Frame.
     2836   ENABLE
     2837   b-quit
     2838   B-mark WHEN LOOKUP("b-mark", bttn) > 0
     2839   B-sel WHEN LOOKUP("b-mark", bttn) > 0
     2840   b-grp
     2841   B-sch
     2842   B-print
     2843   b-history
     2844   B-Help
     2845   b-dis-rule
     2846   br-dis-grp-rule
     2847   WITH FRAME Dialog-Frame.
     2848   VIEW FRAME Dialog-Frame.
     2849   hide b-grp
     2850   in frame Dialog-Frame .
     2851   RUn Openbr in this-procedure ( input yes, input no, input '':U, INPUT p-classif-type).
     2852   END PROCEDURE.
     2853   PROCEDURE OpenBr :
     2854   define input  parameter p-open-query     as logical   no-undo .
