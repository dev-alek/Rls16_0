     1172   X_dis-grp-rule.templ-rl-root COLUMN-LABEL 'Тип правила' FORMAT ">>>>>>>>9"
     1173   entry (lookup (X_dis-grp-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) COLUMN-LABEL 'Место использ.' FORMAT "X(20)"
     1174   X_dis-grp-rule.obj-type COLUMN-LABEL 'Тип объ' FORMAT "X(3)"
     1175   X_dis-grp-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>9"
     1176   (if p-classif-type = 'sum-grp':U then entry (lookup (X_dis-grp-rule.discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u) else entry (lookup (X_dis-grp-rule.discnt-role, 'cli-grp-pcnt':u) + 1, ',' + '% скидка на группу клиентов':u)) COLUMN-LABEL 'Тип скидки' FORMAT "X(70)"
     1177   X_dis-grp-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     1178   X_dis-grp-rule.rl-root COLUMN-LABEL '№ корн.правила' FORMAT ">>>>>>>>9"
     1179       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20 FIT-LAST-COLUMN.
     1180   DEFINE FRAME Dialog-Frame
     1181        b-quit AT ROW 1 COL 1
     1182        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1183        B-sel AT ROW 1 COL 21 WIDGET-ID 10
     1184        b-grp AT ROW 1 COL 41 WIDGET-ID 14
     1185        b-dis-rule AT ROW 1 COL 51 WIDGET-ID 16
     1186        B-sch AT ROW 1 COL 86 WIDGET-ID 8
     1187        B-print AT ROW 1 COL 89 WIDGET-ID 6
     1188        b-history AT ROW 1 COL 92 WIDGET-ID 2
     1189        B-Help AT ROW 1 COL 95
     1190        BR-dis-grp-rule AT ROW 3 COL 1 WIDGET-ID 100
     1191        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 12
     1192        SPACE(78.59) SKIP(21.22)
     1193       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1194            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1195            TITLE "Скидки на группы товаров"
     1196            CANCEL-BUTTON b-quit.
     1197   ASSIGN
     1198          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1199          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1200   ON GO OF FRAME Dialog-Frame
     1201   DO:
     1202     p-rid-list = v-rid-list.
     1203   END.
     1204   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1205   DO:
     1206     APPLY "END-ERROR":U TO SELF.
     1207   END.
     1208   ON CHOOSE OF b-dis-rule IN FRAME Dialog-Frame
     1209   DO:
