      558   procedure prn-lib-reportviewer :
      559     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      560     define input parameter p-report-name-html as character no-undo .
      561     define input parameter p-param        as character no-undo .
      562     define variable v-excel           as character no-undo init 'TRUE' .
      563     define variable v-value-character as character no-undo .
      564     define variable v-value-integer   as character no-undo .
      565     define variable v-value-date      as date      no-undo .
      566     define variable v-value-decimal   as decimal   no-undo .
      567     define variable rep-excel         as logical   no-undo .
      568     define variable excel-string      as character no-undo .
      569     define variable v-param-type      as character no-undo .
      570     define variable v-tth             as handle    no-undo .
      571     run adm/shattri.p (
      572       input "get":U
      573       ,input  ""
      574       ,input  0
      575       ,input  'report-glob':U
      576       ,input  'rep-excel':U
      577       ,output v-value-character
      578       ,output v-value-date
      579       ,output v-value-decimal
      580       ,output v-value-integer
      581       ,output rep-excel
      582       ,output v-param-type
      583       ,INPUT-OUTPUT table-handle v-tth
      584       )  .
      585     if rep-excel then v-excel = "TRUE" .
      586     else v-excel = "FALSE" .
      587     if p-param eq ""
      588     then
      589        p-param = "EXCEL:" + v-excel.
      590     else
      591        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      592     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      593   end procedure.
      594   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   define variable v-waitfram-action01         as character   no-undo .
      596   define variable v-waitfram-action02         as character   no-undo .
      597   define variable v-waitfram-action03         as character   no-undo .
      598   define variable mWaitFramTextBeg            as character   no-undo.
      599   define variable mWaitFramTextEnd            as character   no-undo.
      600   define variable mWaitFramView               as logical     no-undo.
      601   define variable mWaitProcEvent              as logical     no-undo init yes.
      602   define variable mWaitFramInterval           as integer     no-undo init 1 .
      603   define variable mWaitFramStop               as logical     no-undo.
      604   define variable mWaitFramStopUser           as logical     no-undo.
      605   define variable mWaitFramStopTimeOut        as logical     no-undo.
      606   define variable mWaitFramStartProc          as datetime-tz no-undo.
      607   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      608   define button B-WaitFramStop auto-end-key
      609        label "Стоп"
      610        size 10 by 1 tooltip "Остоновить процесс".
      611   define button B-viewProcInfo
      612        label "Информация"
      613        size 15 by 1 tooltip "Информация о процесс".
      614   define frame waitfram
      615     v-waitfram-action01 format "x(72)" no-label skip
      616     v-waitfram-action02 format "x(72)" no-label skip
      617     v-waitfram-action03 format "x(72)" no-label skip
      618     B-viewProcInfo
      619     B-WaitFramStop at row 4 col 30
      620     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      621     .
      622   define new global shared variable mBatchMode as logical no-undo init ?.
      623   define variable mFramBachModHandle as handle no-undo.
      624   mFramBachModHandle = frame waitfram:handle.
      625   define variable mFameOldVis as logical no-undo.
      626   define variable mVisCUrentVin as logical no-undo.
      627   if session:batch-mode
      628   then
      629      mBatchMode = yes.
      630   if mBatchMode = ? then do:
      631     mVisCUrentVin = current-window:visible.
      632     mFameOldVis = mFramBachModHandle:visible.
      633     mFramBachModHandle:visible  = yes.
      634     mBatchMode = mFramBachModHandle:visible ne yes.
      635     mFramBachModHandle:visible = mFameOldVis.
      636     current-window:visible = mVisCUrentVin.
      637   end.
      638    if  log-manager:logfile-name ne ?
      639     then DO:
      640         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      641         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      642         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      643     end.
      644   on choose of B-WaitFramStop in frame waitfram
      645   do:
      646     mWaitFramStop = yes.
      647     mWaitFramStopUser = yes.
      648   end.
      649   function waitfram-check-timeout returns logical():
      650      define variable vtime as int64 no-undo.
      651      if mWaitFramStopTimeOut
      652      then
      653         return yes.
      654      vtime = ( now - mWaitFramStartProc ) / 1000 .
      655      if     mWaitFramTimeOut ne ?
      656         and mWaitFramTimeOut ne 0
      657         and mWaitFramTimeOut lt vtime
      658      then do:
      659         mWaitFramStopTimeOut = yes.
      660      end.
      661      return mWaitFramStopTimeOut.
      662   end.
      663   procedure waitfram-hide :
      664     if not session:batch-mode
      665     then do
      666     on error undo, return error return-value
      667     :
      668       pause 0 before-hide .
      669       if not mBatchMode then
      670         hide frame waitfram .
      671     if     not mWaitFramView
      672        and mWaitProcEvent
      673     then
      674       process events .
      675     end.
      676   end procedure.
      677   procedure waitfram-show :
      678     define input  parameter p-message as character no-undo .
      679     define variable v-left-margin as integer   no-undo .
      680     if not session:batch-mode
      681     then do
      682     on error undo, return error return-value
      683     :
      684       if length(p-message) <= 70 then do:
      685         assign
      686           v-left-margin = integer((70 - length(p-message)) / 2)
      687         .
      688         assign
      689           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      690         .
      691         assign
      692           v-waitfram-action01 = " "
      693           v-waitfram-action02 = " "
      694                                    + fill(" ", v-left-margin)
      695                                    + p-message
      696           v-waitfram-action03 = " "
      697         .
      698       end.
      699       else do:
      700         define variable vRindex1 as integer no-undo.
      701         define variable vRindex2 as integer no-undo.
      702         vRindex1 = r-index(p-message," ",70).
      703         if vRindex1 = 0
      704         then
      705            vRindex1 = 70.
      706         if length(p-message)  <= vRindex1 + 70 then do:
      707           assign
      708             v-waitfram-action01 = " "
      709             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      710             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      711           .
      712         end.
      713         else do:
      714           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      715           if vRindex2 <= vRindex1
      716           then
      717              vRindex2 = vRindex1 + 70.
      718           assign
      719             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      720             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      721             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      722           .
      723         end.
      724       end.
      725       B-viewProcInfo:visible   in frame waitfram = no.
      726       B-viewProcInfo:sensitive in frame waitfram = no.
      727       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      728       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      729       if  (   mWaitFramView
      730          or  mWaitProcEvent)
      731          and not mBatchMode
      732       then
      733          display
      734             v-waitfram-action01 skip
      735             v-waitfram-action02 skip
      736             v-waitfram-action03 skip
      737          with frame waitfram .
      738       if     mWaitFramView
      739          then do:
      740             if     mWaitFramInterval ne ?
      741                and not mBatchMode
      742             then
      743                wait-for go of frame waitfram pause mWaitFramInterval.
      744          end.
      745          else
      746             if     mWaitProcEvent
      747                and not mBatchMode
      748             then
      749                process events .
      750     end.
      751   end procedure.
      752      procedure waitfram-show-this:
      753         define input  parameter iInterval as int64 no-undo.
      754         define variable vtime as int64 no-undo.
      755         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      756         mWaitFramInterval = iInterval.
      757         run waitfram-show (substitute("&1&2 &3&4" ,
      758                                       mWaitFramTextBeg ,
      759                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      760                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      761                                       mWaitFramTextEnd
      762                                      )
      763                           ).
      764      end.
      765      procedure WaitFramRunPause:
      766         define input  parameter iInterval as dec no-undo.
      767         define variable vStart  as datetime-tz no-undo.
      768         define variable vend    as datetime-tz no-undo.
      769         define variable vint as int64 no-undo.
      770         define variable vOk as logical no-undo.
      771         vStart = now.
      772         vend   = vStart.
      773         publish "WaitFramPause" (iInterval,output vOk).
      774         vend   =  now.
      775         vint = vend - vStart.
      776         vint = iInterval - vint / 1000.
      777         if     not mWaitFramStop
      778            and (   vint > 0
      779                 or (    not vOk
      780                     and iInterval eq ?
      781                     )
      782                 )
      783         then
      784            run waitfram-show-this (iInterval).
      785         vend   =  now.
      786         vint = vend - vStart.
      787         vint = iInterval - vint / 1000.
      788         if     not mWaitFramStop
      789            and vint > 0
      790         then do:
      791            run gbl/pause.p (vint * 1000).
      792         end.
      793         if iInterval ne ?
      794         then
      795            publish "WaitFramStop".
      796         waitfram-check-timeout().
      797      end.
      798      procedure WaitFramWaitFor:
      799         define input  parameter iInterval as dec no-undo.
      800         assign
      801            mWaitFramStartProc   = now
      802            mWaitFramStopUser    = no
      803            mWaitFramStopTimeOut = no
      804         .
      805         block-wait:
      806         do while not mWaitFramStop:
      807            run WaitFramRunPause (iInterval).
      808            if  waitfram-check-timeout()
      809            then do:
      810               leave block-wait.
      811            end.
      812         end.
      813         run waitfram-hide.
      814      end.
      815   procedure waitfram-join :
      816     define input  parameter p-line-1  as character no-undo .
      817     define input  parameter p-line-2  as character no-undo .
      818     define input  parameter p-line-3  as character no-undo .
      819     define output parameter p-message as character no-undo .
      820     do
      821     on error undo, return error return-value
      822     :
      823       assign
      824         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      825                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      826                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      827       .
      828     end.
      829   end procedure.
      830   function waitfram-join-function returns character
      831     (input p-line-1 as character
      832     ,input p-line-2 as character
      833     ,input p-line-3 as character
      834     ).
      835     define variable v-message as character no-undo .
      836     run waitfram-join in this-procedure
      837       (input  p-line-1
      838       ,input  p-line-2
      839       ,input  p-line-3
      840       ,output v-message
      841       ) .
      842     return v-message .
      843   end function .
      844   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      846   procedure fltopend_fltopend :
      847   define input parameter p-parent-handle as handle no-undo .
      848   define input parameter p-qh as handle no-undo .
      849   define input parameter p-flt-open-open-query  as character no-undo .
      850   define input parameter p-where-cond as character no-undo .
      851   define input parameter p-use-indFIRST-query-tail as character no-undo .
      852   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      853   define input parameter p-indexed-reposition as character no-undo .
      854     do
      855     on error undo, return error
      856     :
      857   define variable v-prepare-string as character no-undo .
      858   define variable glog as logical no-undo .
      859   assign
      860   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      861                      p-where-cond + chr(32)  +
      862                      p-use-indFIRST-query-tail + chr(32) +
      863                      p-use-ind-sort-clmn-by + chr(32) +
      864                      p-indexed-reposition
      865   .
      866   assign
      867   glog = p-qh:query-prepare(v-prepare-string) no-error .
      868   if not glog
      869   or error-status:error then do:
      870     message error-status:get-message(1) view-as alert-box .
      871     undo, return error .
      872   end.
      873   assign
      874   glog = p-qh:query-open no-error .
      875   if not glog
      876   or error-status:error then do:
      877     message error-status:get-message(1) view-as alert-box .
      878     undo, return error .
      879   end.
      880     end.
      881   end procedure.
      882   procedure fltopend_fltfindd :
      883   define input parameter p-parent-handle as handle no-undo .
      884   define input parameter p-qh as handle no-undo .
      885   define input parameter p-rowid as rowid no-undo .
      886   define input parameter p-next as logical no-undo .
      887   define input parameter p-lock as integer no-undo .
      888   define input parameter p-bh as handle no-undo .
      889   define input parameter p-where-cond as character no-undo .
      890   define input parameter p-use-index-phrase as character no-undo .
      891   define variable glog as logical no-undo .
      892   define variable v-qh as handle no-undo .
      893   define variable v-bh as handle no-undo .
      894   define variable v-recid as recid no-undo .
      895   define variable v-prepare-string as character no-undo .
      896   do
      897   on error undo, return error
      898   on stop undo, return error
      899   :
      900     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      901     create buffer v-bh for table p-bh buffer-name p-bh:name.
      902     create query v-qh.
      903     v-qh:set-buffers(v-bh).
      904     v-prepare-string = substitute("for each &1 &2 &3"
      905                                     ,v-bh:name
      906                                     ,p-where-cond
      907                                     ,p-use-index-phrase).
      908     glog = v-qh:query-prepare(v-prepare-string) no-error.
      909     if not glog then do:
      910       delete object v-qh.
      911       delete object v-bh.
      912       undo, return error .
      913     end.
      914     glog = v-qh:query-open no-error .
      915     if not glog then do:
      916       delete object v-qh.
      917       delete object v-bh.
      918       undo, return error .
      919     end.
      920     if p-next then do:
      921       v-qh:reposition-to-rowid(p-rowid) no-error .
      922       glog = v-qh:get-next( p-lock) no-error .
      923       glog = v-qh:get-next( p-lock) no-error .
      924       if not glog or v-qh:query-off-end = yes then do:
      925         glog = v-qh:get-first( p-lock) no-error .
      926       end.
      927     end.
      928     else do:
      929       glog = v-qh:get-first( p-lock) no-error .
      930     end.
      931     v-recid = v-bh:recid no-error .
      932     delete object v-qh.
      933     delete object v-bh.
      934     return string(v-recid) .
      935   end.
      936   end procedure.
      937   procedure fltopend_fltfindq :
      938   define input parameter p-parent-handle as handle no-undo .
      939   define input parameter p-qh as handle no-undo .
      940   define input parameter p-next as logical no-undo .
      941   define input parameter p-lock as integer no-undo .
      942   define input parameter p-flt-open-open-query  as character no-undo .
      943   define input parameter p-where-cond as character no-undo .
      944   define input parameter p-use-indFIRST-query-tail as character no-undo .
      945   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      946   define input parameter p-indexed-reposition as character no-undo .
      947   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      948   define variable glog as logical no-undo .
      949   define variable v-qh as handle no-undo .
      950   define variable v-bh as handle no-undo extent 18.
      951   define variable v-rowid as rowid no-undo extent 18.
      952   define variable v-ii as integer no-undo .
      953   define variable v-prepare-string as character no-undo .
      954   do
      955   on error undo, return error
      956   on stop undo, return error
      957   :
      958     create query v-qh.
      959     do v-ii = 1 to p-qh:num-buffers:
      960       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      961       assign
      962       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      963       no-error.
      964       v-qh:add-buffer(v-bh[v-ii]).
      965     end.
      966     assign
      967     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      968                       p-where-cond + chr(32)  +
      969                       p-use-indFIRST-query-tail + chr(32) +
      970                       p-use-ind-sort-clmn-by + chr(32) +
      971                       p-indexed-reposition
      972     .
      973     glog = v-qh:query-prepare( v-prepare-string) no-error .
      974     if not glog then do:
      975       delete object v-qh.
      976       do v-ii = 1 to p-qh:num-buffers:
      977         delete object v-bh[v-ii].
      978       end.
      979       undo, return error .
      980     end.
      981     glog = v-qh:query-open no-error .
      982     if not glog then do:
      983       delete object v-qh.
      984       do v-ii = 1 to p-qh:num-buffers:
      985         delete object v-bh[v-ii].
      986       end.
      987       undo, return error .
      988     end.
      989     if p-next then do:
      990       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      991       glog = v-qh:get-next( p-lock) no-error .
      992       glog = v-qh:get-next( p-lock) no-error .
      993       if not glog or v-qh:query-off-end = yes then do:
      994         glog = v-qh:get-first( p-lock) no-error .
      995       end.
      996     end.
      997     else do:
      998       glog = v-qh:get-first( p-lock) no-error .
      999     end.
     1000     do v-ii = 1 to p-qh:num-buffers:
     1001       assign
     1002       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1003       no-error.
     1004     end.
     1005     delete object v-qh.
     1006     do v-ii = 1 to p-qh:num-buffers:
     1007       delete object v-bh[v-ii].
     1008     end.
     1009   end.
     1010   end procedure.
     1011   define variable filter-point  as character no-undo init "История Групп кол-в для ценообразовани" .
     1012   define variable filter-point0 as character no-undo init "История_Групп_кол-в_для_ценообразовани" .
     1013   define variable sort-column-name as character no-undo .
     1014   define variable print-type as character no-undo.
     1015   define variable del-type as character no-undo.
     1016   define variable deleted as logical no-undo init no.
     1017   DEFINE VARIABLE change-type as character init "" no-undo .
     1018   DEFINE  var br-handle as handle no-undo.
     1019   define buffer find_code for ub.c-qnty-group .
     1020   DEFINE BUFFER buf_c-qnty-group FOR ub.c-qnty-group .
     1021   define temp-table temp-changes no-undo
     1022   field f_name as character
     1023   field l_name as character
     1024   field v_old as character
     1025   field v_new as character
     1026   index pi is unique primary
     1027   f_name.
     1028   DEFINE BUTTON B-Cancel AUTO-END-KEY
     1029        LABEL "Выход"
     1030        SIZE 10 BY 1
     1031        BGCOLOR 8 .
     1032   DEFINE BUTTON B-Help
     1033        LABEL "Помощь"
     1034        SIZE 10 BY 1
     1035        BGCOLOR 8 .
     1036   DEFINE BUTTON B-sch
     1037        LABEL "Фильтр"
     1038        SIZE 10 BY 1 TOOLTIP "Фильтрация списка"
     1039        BGCOLOR 8 .
     1040   DEFINE QUERY BR-changes FOR
     1041         temp-changes SCROLLING.
     1042   DEFINE QUERY BR-docs FOR
     1043         buf_c-qnty-group SCROLLING.
     1044   DEFINE BROWSE BR-changes
     1045     QUERY BR-changes DISPLAY
     1046         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(30)"
     1047         temp-changes.v_old COLUMn-LABEL "Было" format "X(35)"
     1048         temp-changes.v_new COLUMn-LABEL "Стало" format "X(35)"
     1049       WITH NO-ROW-MARKERS SEPARATORS SIZE 90.75 BY 11.08.
     1050   DEFINE BROWSE BR-docs
     1051     QUERY BR-docs DISPLAY
     1052   buf_c-qnty-group.chip-num   FORMAT ">>>>>>>>>9"
     1053   buf_c-qnty-group.name      COLUMN-LABEL "Наименование группы ! " FORMAT "x(30)"
     1054   buf_c-qnty-group.sys-date   COLUMN-LABEL "Дата"
     1055   buf_c-qnty-group.sys-time-chr COLUMN-LABEL "Время" FORMAT "x(5)"
     1056   buf_c-qnty-group.corr-date  COLUMN-LABEL "Дата!изм"    LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1057   STRING(buf_c-qnty-group.corr-time, "HH:MM")    @ buf_c-qnty-group.corr-time COLUMN-LABEL "Время!изм" LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1058   buf_c-qnty-group.corr-user-name   COLUMN-LABEL "Кто менял" FORMAT "x(10)"   LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1059   buf_c-qnty-group.corr-user-db-num COLUMN-LABEL "В !БД"  FORMAT ">>>>9"  LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     1060       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 90 BY 10.04.
     1061   DEFINE FRAME Dialog-Frame
     1062        B-Cancel AT ROW 1 COL 1
     1063        B-sch AT ROW 1 COL 11
     1064        B-Help AT ROW 1 COL 81.5
     1065        BR-docs AT ROW 2.21 COL 1.25
     1066        BR-changes AT ROW 12.5 COL 1
     1067        SPACE(0.00) SKIP(0.01)
     1068       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1069            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1070            TITLE "История Группы кол-в для ценообразования"
     1071            CANCEL-BUTTON B-Cancel.
     1072   ASSIGN
     1073          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1074          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1075   ASSIGN
     1076          BR-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1077   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1078   DO:
     1079     APPLY "END-ERROR":U TO SELF.
     1080   END.
     1081   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1082   DO:
     1083     run proc-b-sch in this-procedure no-error.
     1084     if not available buf_c-qnty-group then run OpenBr (yes, no, '':U).
     1085   END.
     1086   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1087   DO:
     1088   if available buf_c-qnty-group then do:
     1089     run proc-view-changes in this-procedure no-error.
     1090   end.
     1091   END.
     1092   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1093   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1094   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095   on help of frame Dialog-Frame
     1096   do:
     1097     run gbl/app_help.p
     1098       (input this-procedure :file-name
     1099       ,input ''
     1100       ,input ?
     1101       ) no-error.
     1102     if error-status :error then do:
     1103       message
     1104         "Ошибка при вызове помощи"
     1105         error-status :get-message(1)
     1106         view-as alert-box .
     1107     end.
     1108   end.
     1109   run minbtn-set in this-procedure .
     1110   on choose of b-help in frame Dialog-Frame
     1111   do:
     1112     apply "help":u to frame Dialog-Frame .
     1113   end.
     1114   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   procedure minbtn-set :
     1116       do
     1117           on error undo, return error return-value
     1118           :
     1119           define variable ii              as integer       no-undo .
     1120           define variable fh              as widget-handle no-undo .
     1121           define variable hh              as widget-handle no-undo .
     1122           define variable v-h             as handle        extent 4 no-undo .
     1123           define variable v-name-button   as character     no-undo .
     1124           define variable v-help-old-x    as decimal       no-undo .
     1125           define variable v-help-old-y    as decimal       no-undo .
     1126           define variable v-help-old-size as decimal       no-undo .
     1127           define variable v-frame-width   as decimal       no-undo .
     1128           define variable jj              as integer       no-undo .
     1129           do
     1130               on error undo, return error
     1131               :
     1132               assign
     1133                   v-frame-width = frame Dialog-Frame:width - 0.3
     1134                   fh            = frame Dialog-Frame:first-child
     1135                   hh            = fh:first-child
     1136                   ii            = 1
     1137                   .
     1138               do while valid-handle(hh):
     1139                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1140                   do:
     1141                       case lc(hh:name) :
     1142                           when "b-help" then
     1143                               do:
     1144                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1145                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1146                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1147                                   hh:TOOLTIP = "Помощь" .
     1148                                   v-help-old-x = hh:column .
     1149                                   v-help-old-y = hh:row    .
     1150                                   v-help-old-size = hh:width .
     1151                                   hh:width-chars = 2.5 .
     1152                               end.
     1153                           when "b-print" then
     1154                               do:
     1155                                   hh:load-image("cmp/b-print.bmp":u) .
     1156                                   hh:TOOLTIP = "Печать" .
     1157                                   v-h[ii] = hh:handle .
     1158                                   ii = ii + 1 .
     1159                                   hh:width-chars = 3 .
     1160                               end.
     1161                           when "b-history" or
     1162                           when "b-hist" then
     1163                               do:
     1164                                   hh:load-image("cmp/b-hist.bmp":u) .
     1165                                   hh:TOOLTIP = "История" .
     1166                                   v-h[ii] = hh:handle .
     1167                                   ii = ii + 1 .
     1168                                   hh:width-chars = 3 .
     1169                               end.
     1170                           when "b-sch" then
     1171                               do:
     1172                                   hh:load-image("cmp/b-sch.bmp":u) .
     1173                                   hh:TOOLTIP = "Установка Фильтра" .
     1174                                   v-h[ii] = hh:handle .
     1175                                   ii = ii + 1 .
     1176                                   hh:width-chars = 3 .
     1177                               end.
     1178                           when "b-hist-user" then
     1179                               do:
     1180                                   hh:load-image("cmp/b-hist.bmp":u) .
     1181                                   hh:TOOLTIP = "История пользователя" .
     1182                                   ii = ii + 1 .
     1183                               end.
     1184                       end case.
     1185                   end.
     1186                   hh = hh:next-sibling.
     1187               end.
     1188               b-help:column = v-frame-width - b-help:width-chars.
     1189               jj = 0.
     1190               repeat ii = 4 to 1 by -1 :
     1191                   if valid-handle (v-h[ii] ) then
     1192                   do:
     1193                       jj  = jj + 1 .
     1194                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1195                       v-h[ii]:row    = v-help-old-y .
     1196                   end.
     1197               end.
     1198           end.
     1199       end.
     1200   end procedure.
     1201   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1202   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1203   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1204   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1205   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1206   define variable v-diasize-current-frame-height as decimal   no-undo .
     1207   define variable v-diasize-change-size          as logical   no-undo .
     1208   define variable v-diasize-resize-button        as handle    no-undo .
     1209   define variable v-diasize-wndmax               as logical   no-undo .
     1210   define variable v-diasize-wndstore             as logical   no-undo .
     1211   define variable v-diasize-proc-name            as character no-undo .
     1212   define variable v-diasize-browse-handle        as handle    no-undo .
     1213   define variable v-diasize-browse-number        as integer   no-undo .
     1214   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1215   define temp-table temp-diasize-handle no-undo
     1216     field handle-value  as handle
     1217     field save-position as decimal
     1218     index xpk is primary unique handle-value
     1219     .
     1220   define temp-table temp-browse-handle no-undo
     1221     field browse-type   as character
     1222     field browse-number as integer
     1223     field browse-handle as handle
     1224     field original-size as decimal
     1225     index xpk is primary unique browse-type browse-number
     1226     index xie browse-type browse-handle
     1227   .
     1228   procedure diasize_change-height :
     1229     define input  parameter p-change-value  as decimal   no-undo .
     1230     define input  parameter p-move-resize   as logical   no-undo .
     1231     define variable v-field-group-handle    as handle    no-undo .
     1232     define variable v-object-handle         as handle    no-undo .
     1233     define variable v-frame-height          as decimal   no-undo .
     1234     define variable v-frame-virtual-height  as decimal   no-undo .
     1235     define variable v-browse-height         as decimal   no-undo .
     1236     define variable v-window-height         as decimal   no-undo .
     1237     define variable v-window-virtual-height as decimal   no-undo .
     1238     define variable v-change-sign           as integer   no-undo .
     1239     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1240     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1241     if p-change-value > 0
     1242     then do:
     1243       if frame Dialog-Frame :height + p-change-value
     1244           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1245       then do:
     1246         assign
     1247           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1248                           - (frame Dialog-Frame :height-chars)
     1249         .
     1250         if p-change-value <= 0
     1251         then do:
     1252           run diasize_position-resize-button in this-procedure .
     1253           return .
     1254         end.
     1255       end.
     1256     end.
     1257     if p-change-value < 0
     1258     then do:
     1259       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1260       then do:
     1261         assign
     1262           p-change-value = v-diasize-orig-frame-height
     1263                          - (frame Dialog-Frame :height-chars)
     1264         .
     1265         if p-change-value >= 0
     1266         then do:
     1267           run diasize_position-resize-button in this-procedure .
     1268           return .
     1269         end.
     1270       end.
     1271     end.
     1272     if p-change-value >= 0
     1273     then do:
     1274       assign
     1275         v-change-sign = 1
     1276       .
     1277     end.
     1278     else do:
     1279       assign
     1280         v-change-sign = -1
     1281       .
     1282     end.
     1283     assign
     1284       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1285     .
     1286     if p-change-value = 0
     1287     then do:
     1288       run diasize_position-resize-button in this-procedure .
     1289       return .
     1290     end.
     1291     move_block:
     1292     do
     1293     on error undo move_block, retry move_block
     1294     :
     1295       if retry
     1296       then do:
     1297         do
     1298         on error undo move_block, leave move_block
     1299         :
     1300           if p-change-value > 0
     1301           then do:
     1302             for each buf_temp-diasize-handle
     1303             on error undo, next
     1304             :
     1305               assign
     1306                 v-object-handle = buf_temp-diasize-handle.handle-value
     1307               .
     1308               if v-object-handle <> v-diasize-resize-button
     1309               then do:
     1310                 assign
     1311                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1312                 .
     1313               end.
     1314             end.
     1315             assign
     1316               v-diasize-browse-handle :height = v-browse-height
     1317             .
     1318             for each buf_temp-browse-handle
     1319               where buf_temp-browse-handle.browse-type = 'height':u
     1320             on error undo, next
     1321             :
     1322               assign
     1323                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1324               .
     1325             end.
     1326             assign
     1327               frame Dialog-Frame :height = v-frame-height
     1328             .
     1329             if frame Dialog-Frame :scrollable = true
     1330             then do:
     1331               assign
     1332                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1333               .
     1334             end.
     1335             run diasize_position-resize-button in this-procedure .
     1336           end.
     1337           else do:
     1338             if frame Dialog-Frame :scrollable = true
     1339             then do:
     1340               assign
     1341                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1342               .
     1343             end.
     1344             assign
     1345               frame Dialog-Frame :height = v-frame-height
     1346             .
     1347             assign
     1348               v-diasize-browse-handle :height = v-browse-height
     1349             .
     1350             for each buf_temp-browse-handle
     1351               where buf_temp-browse-handle.browse-type = 'height':u
     1352             on error undo, next
     1353             :
     1354               assign
     1355                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1356               .
     1357             end.
     1358             for each buf_temp-diasize-handle
     1359             on error undo, next
     1360             :
     1361               assign
     1362                 v-object-handle = buf_temp-diasize-handle.handle-value
     1363               .
     1364               if v-object-handle <> v-diasize-resize-button
     1365               then do:
     1366                 assign
     1367                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1368                 .
     1369               end.
     1370             end.
     1371             run diasize_position-resize-button in this-procedure .
     1372           end.
     1373           assign
     1374             v-diasize-change-size = false
     1375           .
     1376           leave move_block .
     1377         end.
     1378       end.
     1379       assign
     1380         v-diasize-need-full-display = true
     1381       .
     1382       if v-diasize-change-size = false
     1383       then do:
     1384         assign
     1385           v-diasize-change-size = true
     1386         .
     1387       end.
     1388       else do:
     1389         return .
     1390       end.
     1391       assign
     1392         v-frame-height = frame Dialog-Frame :height
     1393         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1394         v-browse-height = v-diasize-browse-handle :height
     1395       .
     1396       for each buf_temp-browse-handle
     1397         where buf_temp-browse-handle.browse-type = 'height':u
     1398       :
     1399         assign
     1400           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1401         .
     1402       end.
     1403       for each buf_temp-diasize-handle
     1404       :
     1405         delete buf_temp-diasize-handle .
     1406       end.
     1407       assign
     1408         v-field-group-handle = frame Dialog-Frame :first-child
     1409       .
     1410       do while valid-handle(v-field-group-handle)
     1411       :
     1412         assign
     1413           v-object-handle = v-field-group-handle :first-child
     1414         .
     1415         do while valid-handle(v-object-handle)
     1416         :
     1417           if  v-object-handle <> v-diasize-browse-handle :handle
     1418           and can-query(v-object-handle, "row")
     1419           and can-query(v-object-handle, "height")
     1420           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1421           then do:
     1422             find first buf_temp-browse-handle
     1423               where buf_temp-browse-handle.browse-type   = 'height':u
     1424                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1425               no-error .
     1426             if available buf_temp-browse-handle
     1427             then do:
     1428             end.
     1429             else do:
     1430               create buf_temp-diasize-handle .
     1431               assign
     1432                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1433                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1434               .
     1435             end.
     1436           end.
     1437           assign
     1438             v-object-handle = v-object-handle :next-sibling
     1439           .
     1440         end.
     1441         assign
     1442           v-field-group-handle = v-field-group-handle :next-sibling
     1443         .
     1444       end.
     1445       do with frame Dialog-Frame
     1446       :
     1447         hide v-diasize-resize-button .
     1448         assign
     1449           v-diasize-resize-button :row    = 1
     1450           v-diasize-resize-button :column = 1
     1451         .
     1452       end.
     1453       if p-change-value > 0
     1454       then do:
     1455         if frame Dialog-Frame :scrollable = true
     1456         then do:
     1457           assign
     1458             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1459             no-error .
     1460           if error-status :error
     1461           or error-status :get-message(1) <> ""
     1462           then do:
     1463             undo move_block, retry move_block .
     1464           end.
     1465         end.
     1466         assign
     1467           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1468           no-error .
     1469         if error-status :error
     1470         or error-status :get-message(1) <> ""
     1471         then do:
     1472           undo move_block, retry move_block .
     1473         end.
     1474         assign
     1475           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1476           no-error .
     1477         if error-status :error
     1478         or error-status :get-message(1) <> ""
     1479         then do:
     1480           undo move_block, retry move_block .
     1481         end.
     1482         for each buf_temp-browse-handle
     1483           where buf_temp-browse-handle.browse-type = 'height':u
     1484         on error undo move_block, retry move_block
     1485         :
     1486           assign
     1487             buf_temp-browse-handle.browse-handle :height
     1488               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1489             no-error .
     1490           if error-status :error
     1491           or error-status :get-message(1) <> ""
     1492           then do:
     1493             undo move_block, retry move_block .
     1494           end.
     1495         end.
     1496         for each buf_temp-diasize-handle
     1497         on error undo move_block, retry move_block
     1498         :
     1499           assign
     1500             v-object-handle = buf_temp-diasize-handle.handle-value
     1501           .
     1502           if v-object-handle <> v-diasize-resize-button
     1503           then do:
     1504             assign
     1505               v-object-handle :row = v-object-handle :row + p-change-value
     1506               no-error .
     1507             if error-status :error
     1508             or error-status :get-message(1) <> ""
     1509             then do:
     1510               undo move_block, retry move_block .
     1511             end.
     1512           end.
     1513         end.
     1514       end.
     1515       else do:
     1516         for each buf_temp-diasize-handle
     1517         on error undo move_block, retry move_block
     1518         :
     1519           assign
     1520             v-object-handle = buf_temp-diasize-handle.handle-value
     1521           .
     1522           if v-object-handle <> v-diasize-resize-button
     1523           then do:
     1524             assign
     1525               v-object-handle :row = v-object-handle :row + p-change-value
     1526               no-error .
     1527             if error-status :error
     1528             or error-status :get-message(1) <> ""
     1529             then do:
     1530               undo move_block, retry move_block .
     1531             end.
     1532           end.
     1533         end.
     1534         assign
     1535           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1536           no-error .
     1537         if error-status :error
     1538         or error-status :get-message(1) <> ""
     1539         then do:
     1540           undo move_block, retry move_block .
     1541         end.
     1542         for each buf_temp-browse-handle
     1543           where buf_temp-browse-handle.browse-type = 'height':u
     1544         on error undo move_block, retry move_block
     1545         :
     1546           assign
     1547             buf_temp-browse-handle.browse-handle :height
     1548               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1549             no-error .
     1550           if error-status :error
     1551           or error-status :get-message(1) <> ""
     1552           then do:
     1553             undo move_block, retry move_block .
     1554           end.
     1555         end.
     1556         assign
     1557           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1558           no-error .
     1559         if error-status :error
     1560         or error-status :get-message(1) <> ""
     1561         then do:
     1562           undo move_block, retry move_block .
     1563         end.
     1564         if frame Dialog-Frame :scrollable = true
     1565         then do:
     1566           assign
     1567             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1568             no-error .
     1569           if error-status :error
     1570           or error-status :get-message(1) <> ""
     1571           then do:
     1572             undo move_block, retry move_block .
     1573           end.
     1574         end.
     1575       end.
     1576       if p-move-resize = true
     1577       then do:
     1578         run diasize_position-resize-button in this-procedure .
     1579       end.
     1580       if v-diasize-wndstore = true
     1581       then do:
     1582         if connected("ub") = true
     1583         then do:
     1584           define variable v-cntxt-db-num        as integer   no-undo .
     1585           define variable v-cntxt-userid        as character no-undo .
     1586           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1587                                             , OUTPUT v-cntxt-userid
     1588                                             ) .
     1589           run gbl/wndsizew.p
     1590             (input  v-cntxt-db-num
     1591             ,input  v-cntxt-userid
     1592             ,input  v-diasize-proc-name
     1593             ,input  'height':u
     1594             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1595             ) .
     1596         end.
     1597       end.
     1598     end.
     1599     assign
     1600       v-diasize-change-size = false
     1601     .
     1602   end procedure.
     1603   procedure diasize_set-height :
     1604     define input  parameter p-new-height  as decimal   no-undo .
     1605     define input  parameter p-move-resize as logical   no-undo .
     1606     do
     1607     on error undo, return error return-value
     1608     :
     1609       run diasize_change-height in this-procedure
     1610         (input  (p-new-height - frame Dialog-Frame :height)
     1611         ,input  p-move-resize
     1612         ) .
     1613     end.
     1614   end procedure.
     1615   procedure diasize_change-width :
     1616     define input  parameter p-change-value as decimal   no-undo .
     1617     define input  parameter p-move-resize  as logical   no-undo .
     1618     define variable v-field-group-handle   as handle    no-undo .
     1619     define variable v-object-handle        as handle    no-undo .
     1620     define variable v-frame-width          as decimal   no-undo .
     1621     define variable v-frame-virtual-width  as decimal   no-undo .
     1622     define variable v-browse-width         as decimal   no-undo .
     1623     define variable v-window-width         as decimal   no-undo .
     1624     define variable v-window-virtual-width as decimal   no-undo .
     1625     define variable v-change-sign          as integer   no-undo .
     1626     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1627     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1628     if p-change-value > 0
     1629     then do:
     1630       if frame Dialog-Frame :width + p-change-value >
     1631           session :width-chars
     1632       then do:
     1633         assign
     1634           p-change-value = session :width-chars - frame Dialog-Frame :width
     1635         .
     1636         if p-change-value <= 0
     1637         then do:
     1638           run diasize_position-resize-button in this-procedure .
     1639           return .
     1640         end.
     1641       end.
     1642     end.
     1643     if p-change-value < 0
     1644     then do:
     1645       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1646       then do:
     1647         assign
     1648           p-change-value = v-diasize-orig-frame-width
     1649                          - frame Dialog-Frame :width
     1650         .
     1651         if p-change-value >= 0
     1652         then do:
     1653           run diasize_position-resize-button in this-procedure .
     1654           return .
     1655         end.
     1656       end.
     1657     end.
     1658     if p-change-value >= 0
     1659     then do:
     1660       assign
     1661         v-change-sign = 1
     1662       .
     1663     end.
     1664     else do:
     1665       assign
     1666         v-change-sign = -1
     1667       .
     1668     end.
     1669     assign
     1670       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1671     .
     1672     if p-change-value = 0
     1673     then do:
     1674       run diasize_position-resize-button in this-procedure .
     1675       return .
     1676     end.
     1677     move_block:
     1678     do
     1679     on error undo move_block, leave move_block
     1680     :
     1681       if retry
     1682       then do:
     1683         do
     1684         on error undo move_block, leave move_block
     1685         :
     1686           if p-change-value > 0
     1687           then do:
     1688             for each buf_temp-diasize-handle
     1689             on error undo, next
     1690             :
     1691               assign
     1692                 v-object-handle = buf_temp-diasize-handle.handle-value
     1693               .
     1694               if v-object-handle <> v-diasize-resize-button
     1695               then do:
     1696                 assign
     1697                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1698                 .
     1699               end.
     1700             end.
     1701             assign
     1702               v-diasize-browse-handle :width = v-browse-width
     1703             .
     1704             for each buf_temp-browse-handle
     1705               where buf_temp-browse-handle.browse-type = 'width':u
     1706             on error undo, next
     1707             :
     1708               assign
     1709                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1710               .
     1711             end.
     1712             assign
     1713               frame Dialog-Frame :width = v-frame-width
     1714             .
     1715             if frame Dialog-Frame :scrollable = true
     1716             then do:
     1717               assign
     1718                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1719               .
     1720             end.
     1721             run diasize_position-resize-button in this-procedure .
     1722           end.
     1723           else do:
     1724             if frame Dialog-Frame :scrollable = true
     1725             then do:
     1726               assign
     1727                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1728               .
     1729             end.
     1730             assign
     1731               frame Dialog-Frame :width = v-frame-width
     1732             .
     1733             for each buf_temp-browse-handle
     1734               where buf_temp-browse-handle.browse-type = 'width':u
     1735             on error undo, next
     1736             :
     1737               assign
     1738                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1739               .
     1740             end.
     1741             assign
     1742               v-diasize-browse-handle :width = v-browse-width
     1743             .
     1744             for each buf_temp-diasize-handle
     1745             on error undo, next
     1746             :
     1747               assign
     1748                 v-object-handle = buf_temp-diasize-handle.handle-value
     1749               .
     1750               if v-object-handle <> v-diasize-resize-button
     1751               then do:
     1752                 assign
     1753                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1754                 .
     1755               end.
     1756             end.
     1757             run diasize_position-resize-button in this-procedure .
     1758           end.
     1759           assign
     1760             v-diasize-change-size = false
     1761           .
     1762           leave move_block .
     1763         end.
     1764       end.
     1765       assign
     1766         v-diasize-need-full-display = true
     1767       .
     1768       if v-diasize-change-size = false
     1769       then do:
     1770         assign
     1771           v-diasize-change-size = true
     1772         .
     1773       end.
     1774       else do:
     1775         return .
     1776       end.
     1777       assign
     1778         v-frame-width = frame Dialog-Frame :width
     1779         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1780         v-browse-width = v-diasize-browse-handle :width
     1781       .
     1782       for each buf_temp-browse-handle
     1783         where buf_temp-browse-handle.browse-type = 'width':u
     1784       :
     1785         assign
     1786           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1787         .
     1788       end.
     1789       for each buf_temp-diasize-handle
     1790       :
     1791         delete buf_temp-diasize-handle .
     1792       end.
     1793       assign
     1794         v-field-group-handle = frame Dialog-Frame :first-child
     1795       .
     1796       do while valid-handle(v-field-group-handle)
     1797       :
     1798         assign
     1799           v-object-handle = v-field-group-handle :first-child
     1800         .
     1801         do while valid-handle(v-object-handle)
     1802         :
     1803           if  v-object-handle <> v-diasize-browse-handle :handle
     1804           and v-object-handle <> v-diasize-resize-button
     1805           and can-query(v-object-handle, "row")
     1806           and can-query(v-object-handle, "height")
     1807           and ( v-object-handle :col + v-object-handle :width
     1808                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1809               )
     1810           then do:
     1811             find first buf_temp-browse-handle
     1812               where buf_temp-browse-handle.browse-type   = 'width':u
     1813                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1814               no-error .
     1815             if available buf_temp-browse-handle
     1816             then do:
     1817             end.
     1818             else do:
     1819               create buf_temp-diasize-handle .
     1820               assign
     1821                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1822                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1823               .
     1824             end.
     1825           end.
     1826           assign
     1827             v-object-handle = v-object-handle :next-sibling
     1828           .
     1829         end.
     1830         assign
     1831           v-field-group-handle = v-field-group-handle :next-sibling
     1832         .
     1833       end.
     1834       do with frame Dialog-Frame
     1835       :
     1836         hide v-diasize-resize-button .
     1837         v-diasize-resize-button :row = 1.
     1838         v-diasize-resize-button :column = 1.
     1839       end.
     1840       if p-change-value > 0
     1841       then do:
     1842         if frame Dialog-Frame :scrollable = true
     1843         then do:
     1844           assign
     1845             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1846             no-error .
     1847           if error-status :error
     1848           or error-status :get-message(1) <> ""
     1849           then do:
     1850             undo move_block, retry move_block.
     1851           end.
     1852         end.
     1853         assign
     1854           frame Dialog-Frame :width = v-frame-width + p-change-value
     1855           no-error .
     1856         if error-status :error
     1857         or error-status :get-message(1) <> ""
     1858         then do:
     1859           undo move_block, retry move_block.
     1860         end.
     1861         assign
     1862           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1863         no-error .
     1864         if error-status :error
     1865         or error-status :get-message(1) <> ""
     1866         then do:
     1867           undo move_block, retry move_block.
     1868         end.
     1869         for each buf_temp-browse-handle
     1870           where buf_temp-browse-handle.browse-type = 'width':u
     1871         on error undo move_block, retry move_block
     1872         :
     1873           assign
     1874             buf_temp-browse-handle.browse-handle :width
     1875               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1876             no-error .
     1877           if error-status :error
     1878           or error-status :get-message(1) <> ""
     1879           then do:
     1880             undo move_block, retry move_block .
     1881           end.
     1882         end.
     1883         for each buf_temp-diasize-handle
     1884         on error undo move_block, retry move_block
     1885         :
     1886           assign
     1887             v-object-handle = buf_temp-diasize-handle.handle-value
     1888           .
     1889           if v-object-handle <> v-diasize-resize-button
     1890           then do:
     1891             assign
     1892               v-object-handle :col = v-object-handle :col + p-change-value
     1893               no-error .
     1894             if error-status :error
     1895             or error-status :get-message(1) <> ""
     1896             then do:
     1897               undo move_block, retry move_block .
     1898             end.
     1899           end.
     1900         end.
     1901       end.
     1902       else do:
     1903         for each buf_temp-diasize-handle
     1904         on error undo move_block, retry move_block
     1905         :
     1906           assign
     1907             v-object-handle = buf_temp-diasize-handle.handle-value
     1908           .
     1909           if v-object-handle <> v-diasize-resize-button
     1910           then do:
     1911             assign
     1912               v-object-handle :col = v-object-handle :col + p-change-value
     1913               no-error .
     1914             if error-status :error
     1915             or error-status :get-message(1) <> ""
     1916             then do:
     1917               undo move_block, retry move_block .
     1918             end.
     1919           end.
     1920         end.
     1921         for each buf_temp-browse-handle
     1922           where buf_temp-browse-handle.browse-type = 'width':u
     1923         on error undo move_block, retry move_block
     1924         :
     1925           assign
     1926             buf_temp-browse-handle.browse-handle :width
     1927               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1928             no-error .
     1929           if error-status :error
     1930           or error-status :get-message(1) <> ""
     1931           then do:
     1932             undo move_block, retry move_block .
     1933           end.
     1934         end.
     1935         assign
     1936           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1937           no-error .
     1938         if error-status :error
     1939         or error-status :get-message(1) <> ""
     1940         then do:
     1941           undo move_block, retry move_block.
     1942         end.
     1943         assign
     1944           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1945         no-error .
     1946         if error-status :error
     1947         or error-status :get-message(1) <> ""
     1948         then do:
     1949           undo move_block, retry move_block.
     1950         end.
     1951         if frame Dialog-Frame :scrollable = true
     1952         then do:
     1953           assign
     1954             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1955           no-error .
     1956           if error-status :error
     1957           or error-status :get-message(1) <> ""
     1958           then do:
     1959             undo move_block, retry move_block.
     1960           end.
     1961         end.
     1962       end.
     1963       if p-move-resize
     1964       then do:
     1965         run diasize_position-resize-button in this-procedure .
     1966       end.
     1967       if v-diasize-wndstore = true
     1968       then do:
     1969         if connected("ub") = true
     1970         then do:
     1971           define variable v-cntxt-db-num        as integer   no-undo .
     1972           define variable v-cntxt-userid        as character no-undo .
     1973           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1974                                             , OUTPUT v-cntxt-userid
     1975                                             ) .
     1976           run gbl/wndsizew.p
     1977             (input  v-cntxt-db-num
     1978             ,input  v-cntxt-userid
     1979             ,input  v-diasize-proc-name
     1980             ,input  'width':u
     1981             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1982             ) .
     1983         end.
     1984       end.
     1985     end.
     1986     assign
     1987       v-diasize-change-size = false
     1988     .
     1989   end procedure.
     1990   procedure diasize_set-width :
     1991     define input  parameter p-new-width  as decimal   no-undo .
     1992     define input  parameter p-move-resize as logical   no-undo .
     1993     do
     1994     on error undo, return error return-value
     1995     :
     1996       run diasize_change-width in this-procedure
     1997         (input  (p-new-width - frame Dialog-Frame :width)
     1998         ,input  p-move-resize
     1999         ) .
     2000     end.
     2001   end procedure.
     2002   procedure diasize_position-resize-button :
     2003     do with frame Dialog-Frame
     2004     :
     2005       hide v-diasize-resize-button .
     2006       assign
     2007         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2008                     - 1
     2009                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2010         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2011                     - 1
     2012                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2013       .
     2014       view v-diasize-resize-button .
     2015     end.
     2016   end procedure.
     2017   on alt-right anywhere
     2018   do:
     2019     run diasize_change-width in this-procedure
     2020       (input 1
     2021       ,input true
     2022       ) .
     2023     return no-apply .
     2024   end.
     2025   on alt-left anywhere
     2026   do:
     2027     run diasize_change-width in this-procedure
     2028       (input -1
     2029       ,input true
     2030       ) .
     2031     return no-apply .
     2032   end.
     2033   on alt-down anywhere
     2034   do:
     2035     run diasize_change-height in this-procedure
     2036       (input 1
     2037       ,input true
     2038       ) .
     2039     return no-apply .
     2040   end.
     2041   on alt-up anywhere
     2042   do:
     2043     run diasize_change-height in this-procedure
     2044       (input -1
     2045       ,input true
     2046       ) .
     2047     return no-apply .
     2048   end.
     2049   on alt-enter of frame Dialog-Frame
     2050   do:
     2051     run diasize_maximize in this-procedure
     2052       (input  ?
     2053       ).
     2054     return no-apply .
     2055   end.
     2056   procedure diasize_end-move :
     2057     do
     2058     on error undo, return error return-value
     2059     :
     2060       define variable v-row-delta as decimal   no-undo .
     2061       define variable v-col-delta as decimal   no-undo .
     2062       define variable v-new-row as decimal   no-undo .
     2063       define variable v-new-col as decimal   no-undo .
     2064       assign
     2065         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2066         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2067       .
     2068       assign
     2069         v-row-delta = v-new-row - frame Dialog-Frame :height
     2070         v-col-delta = v-new-col - frame Dialog-Frame :width
     2071       .
     2072       run diasize_change-height in this-procedure
     2073         (input v-row-delta
     2074         ,input true
     2075         ) .
     2076       run diasize_change-width in this-procedure
     2077         (input v-col-delta
     2078         ,input true
     2079         ) .
     2080     end.
     2081   end procedure.
     2082   procedure diasize_maximize :
     2083     define input  parameter p-action as logical   no-undo .
     2084     do
     2085     on error undo, return error return-value
     2086     :
     2087       if p-action = ?
     2088       then do:
     2089         if v-diasize-need-maximize = true
     2090         then do:
     2091           assign
     2092             p-action = true
     2093           .
     2094         end.
     2095         else do:
     2096           assign
     2097             p-action = false
     2098           .
     2099         end.
     2100       end.
     2101       if p-action = true
     2102       then do:
     2103         run diasize_change-height in this-procedure
     2104           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2105               - frame Dialog-Frame :height-chars
     2106           ,input true
     2107           ) .
     2108         run diasize_change-width in this-procedure
     2109           (input session :width-chars
     2110               - frame Dialog-Frame :width-chars
     2111           ,input true
     2112           ) .
     2113         assign
     2114           v-diasize-need-maximize = false
     2115         .
     2116       end.
     2117       else do:
     2118         run diasize_change-width in this-procedure
     2119           (input v-diasize-orig-frame-width
     2120               - frame Dialog-Frame :width-chars
     2121           ,input true
     2122           ) .
     2123         run diasize_change-height in this-procedure
     2124           (input v-diasize-orig-frame-height
     2125               - frame Dialog-Frame :height-chars
     2126           ,input true
     2127           ) .
     2128         assign
     2129           v-diasize-need-maximize = true
     2130         .
     2131       end.
     2132     end.
     2133   end procedure.
     2134   procedure diasize_restore-orig-size :
     2135     do
     2136     on error undo, return error return-value
     2137     :
     2138       assign
     2139         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2140         v-diasize-current-frame-height = frame Dialog-Frame :height
     2141       .
     2142       run diasize_set-height in this-procedure
     2143         (input  v-diasize-orig-frame-height
     2144         ,input  true
     2145         ) .
     2146       run diasize_set-width in this-procedure
     2147         (input  v-diasize-orig-frame-width
     2148         ,input  true
     2149         ) .
     2150     end.
     2151   end procedure.
     2152   procedure diasize_restore-current-size :
     2153     do
     2154     on error undo, return error return-value
     2155     :
     2156       run diasize_set-height in this-procedure
     2157         (input  v-diasize-current-frame-height
     2158         ,input  true
     2159         ) .
     2160       run diasize_set-width in this-procedure
     2161         (input  v-diasize-current-frame-width
     2162         ,input  true
     2163         ) .
     2164     end.
     2165   end procedure.
     2166   procedure diasize_set-browse-handle :
     2167     define input  parameter p-browse-handle as handle   no-undo .
     2168     define buffer buf_temp-browse-handle for temp-browse-handle .
     2169     do
     2170     on error undo, return error return-value
     2171     :
     2172       assign
     2173         v-diasize-browse-handle = p-browse-handle
     2174       .
     2175       for each buf_temp-browse-handle
     2176       on error undo, return error return-value
     2177       :
     2178         delete buf_temp-browse-handle .
     2179       end.
     2180     end.
     2181   end procedure.
     2182   procedure diasize_add_browse :
     2183     define input  parameter p-browse-type   as character no-undo .
     2184     define input  parameter p-browse-handle as handle    no-undo .
     2185     define buffer buf_temp-browse-handle for temp-browse-handle .
     2186     do
     2187     on error undo, return error return-value
     2188     :
     2189       assign
     2190         v-diasize-browse-number = v-diasize-browse-number + 1
     2191       .
     2192       create buf_temp-browse-handle .
     2193       assign
     2194         buf_temp-browse-handle.browse-type   = p-browse-type
     2195         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2196         buf_temp-browse-handle.browse-handle = p-browse-handle
     2197       .
     2198     end.
     2199   end procedure.
     2200   procedure diasize_init :
     2201     define variable v-default-value    as logical   no-undo .
     2202     define variable v-restore-saved    as logical   no-undo .
     2203     define variable v-resize-value-str as character no-undo .
     2204     do
     2205     on error undo, return error return-value
     2206     :
     2207       do with frame Dialog-Frame
     2208       :
     2209         assign
     2210           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2211           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2212           v-diasize-browse-handle     = browse BR-changes :handle
     2213         .
     2214         create button v-diasize-resize-button
     2215         assign
     2216           parent        = frame Dialog-Frame :first-child
     2217           label         = "s"
     2218           height-pixels = 16
     2219           width-pixels  = 16
     2220           visible       = true
     2221           sensitive     = true
     2222           movable       = true
     2223           triggers:
     2224             on end-move persistent run diasize_end-move in this-procedure .
     2225           end triggers.
     2226         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2227         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2228         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2229         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2230         assign
     2231           v-diasize-wndmax = false
     2232         .
     2233         if connected("ub") = true
     2234         then do:
     2235           define variable v-cntxt-db-num        as integer   no-undo .
     2236           define variable v-cntxt-userid        as character no-undo .
     2237           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2238                                             , OUTPUT v-cntxt-userid
     2239                                             ) .
     2240           run gbl/wndpar_r.p
     2241             (input  v-cntxt-db-num
     2242             ,input  v-cntxt-userid
     2243             ,input  'wndmax':U
     2244             ,output v-diasize-wndmax
     2245             ,output v-default-value
     2246             ) .
     2247         end.
     2248         assign
     2249           v-diasize-wndstore = false
     2250         .
     2251         if connected("ub") = true
     2252         then do:
     2253           run gbl/wndpar_r.p
     2254             (input  v-cntxt-db-num
     2255             ,input  v-cntxt-userid
     2256             ,input  'wndstore':U
     2257             ,output v-diasize-wndstore
     2258             ,output v-default-value
     2259             ) .
     2260         end.
     2261         assign
     2262           v-diasize-proc-name = entry(1, program-name(2), '.')
     2263         .
     2264         if v-diasize-wndstore = true
     2265         then do:
     2266           assign
     2267             v-restore-saved = false
     2268           .
     2269           if connected("ub") = true
     2270           then do:
     2271             run gbl/wndsizer.p
     2272               (input  v-cntxt-db-num
     2273               ,input  v-cntxt-userid
     2274               ,input  v-diasize-proc-name
     2275               ,input  'height':u
     2276               ,output v-resize-value-str
     2277               ) .
     2278             if v-resize-value-str <> '':U
     2279             then do:
     2280               run diasize_change-height in this-procedure
     2281                 (input  integer(v-resize-value-str)
     2282                 ,input  true
     2283                 ) .
     2284               assign
     2285                 v-restore-saved = true
     2286               .
     2287             end.
     2288           end.
     2289           if connected("ub") = true
     2290           then do:
     2291             run gbl/wndsizer.p
     2292               (input  v-cntxt-db-num
     2293               ,input  v-cntxt-userid
     2294               ,input  v-diasize-proc-name
     2295               ,input  'width':u
     2296               ,output v-resize-value-str
     2297               ) .
     2298             if v-resize-value-str <> '':U
     2299             then do:
     2300               run diasize_change-width in this-procedure
     2301                 (input  integer(v-resize-value-str)
     2302                 ,input  true
     2303                 ) .
     2304               assign
     2305                 v-restore-saved = true
     2306               .
     2307             end.
     2308           end.
     2309           if v-restore-saved <> true
     2310           then do:
     2311             if v-diasize-wndmax = true
     2312             then do:
     2313               run diasize_maximize in this-procedure
     2314                 (input  true
     2315                 ) .
     2316             end.
     2317           end.
     2318         end.
     2319         else do:
     2320           if v-diasize-wndmax = true
     2321           then do:
     2322             run diasize_maximize in this-procedure
     2323               (input  true
     2324               ) .
     2325           end.
     2326         end.
     2327       end.
     2328     end.
     2329   end procedure.
     2330   procedure diasize_need-full-display :
     2331     define output parameter p-need-full-display as logical   no-undo .
     2332     do
     2333     on error undo, return error return-value
     2334     :
     2335       assign
     2336         p-need-full-display = v-diasize-need-full-display
     2337       .
     2338       assign
     2339         v-diasize-need-full-display = false
     2340       .
     2341     end.
     2342   end procedure.
     2343   procedure get-context :
     2344      define output parameter p-db-num as integer          no-undo.
     2345      define output parameter p-user-id as character        no-undo.
     2346      define variable v-login               as character    no-undo.
     2347      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2348      define buffer buf_user-login  for ub.user-login .
     2349      do
     2350      on error undo, return error
     2351      :
     2352            FIND FIRST buf_sys-ctrl no-lock.
     2353            ASSIGN
     2354               v-login = USERID("ub")
     2355               p-db-num = buf_sys-ctrl.db-num
     2356            .
     2357            FIND FIRST buf_user-login
     2358                 WHERE buf_user-login.db-num = p-db-num
     2359                   AND buf_user-login.user-login = v-login
     2360                 no-lock
     2361                 no-error
     2362                 .
     2363            IF AVAILABLE buf_user-login
     2364            THEN DO:
     2365               assign
     2366                  p-user-id = buf_user-login.user-id
     2367               .
     2368            END.
     2369      end.
     2370   end procedure.
     2371       run diasize_init in this-procedure .
     2372   MAIN-BLOCK:
     2373   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2374      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2375   define variable p-file-label as character no-undo .
     2376     p-file-label =  "История Группы кол-в для ценообразования".
     2377   temp-changes.l_name:RESIZABLE in browse BR-changes = true .
     2378   temp-changes.v_old:RESIZABLE  in browse BR-changes = true .
     2379   temp-changes.v_new:RESIZABLE  in browse BR-changes = true .
     2380   define buffer buf_clients for  ub.clients .
     2381     RUN my-enable_UI.
     2382     RUn OpenBR(yes, no, '':U).
     2383     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     2384     wait-for go of frame Dialog-Frame.
     2385   END.
     2386   RUN disable_UI.
     2387   PROCEDURE disable_UI :
     2388     HIDE FRAME Dialog-Frame.
     2389   END PROCEDURE.
     2390   PROCEDURE enable_UI :
     2391     ENABLE B-Cancel B-Help BR-docs BR-changes
     2392         WITH FRAME Dialog-Frame.
     2393     VIEW FRAME Dialog-Frame.
     2394     OPEN QUERY BR-docs FOR EACH buf_c-qnty-group no-lock.
     2395   END PROCEDURE.
     2396   PROCEDURE my-enable_UI :
     2397     ENABLE B-Cancel
     2398            B-sch
     2399            B-Help
     2400            BR-docs
     2401            BR-changes
     2402         WITH FRAME Dialog-Frame.
     2403     VIEW FRAME Dialog-Frame.
     2404   END PROCEDURE.
     2405   PROCEDURE OpenBr :
     2406   define input  parameter p-open-query     as logical   no-undo .
     2407   define input  parameter p-find-next      as logical   no-undo .
     2408   define input  parameter p-find-condition as character no-undo .
     2409   def var l-query-was-opened as logical no-undo .
     2410   define variable title0 as character no-undo.
     2411   title0 = caps(p-file-label) + chr(32).
     2412   def var sort-column-phrase as character no-undo .
     2413   case sort-column-name :
     2414     when "" then do:
     2415       assign
     2416         sort-column-phrase = ""
     2417       .
     2418     end.
     2419     otherwise do:
     2420       assign
     2421         sort-column-phrase = "by " + sort-column-name
     2422       .
     2423     end.
     2424   end case.
     2425   define variable l-open-query as logical   no-undo .
     2426          filter-point = filter-point0 .
     2427   ASSIGN frame Dialog-Frame:TITLE = title0 .
     2428   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2429   define variable  l-disable-where-13  as logical   no-undo .
     2430   define variable  l-filter-open-13    as logical   .
     2431   define variable  flt-rec-13       as recid     no-undo .
     2432   define variable  filter-name-13      as character no-undo .
     2433   define variable  where-phrase-13     as character no-undo .
     2434   define variable  sort-phrase-13      as character no-undo .
     2435   define variable  where-phrase-rus-13 as character no-undo .
     2436   define variable  sort-phrase-rus-13  as character no-undo .
     2437   run gbl/flt-get.p
     2438     (input filter-point
     2439     ,output flt-rec-13
     2440     ,output filter-name-13
     2441     ,output where-phrase-13
     2442     ,output sort-phrase-13
     2443     ,output where-phrase-rus-13
     2444     ,output sort-phrase-rus-13
     2445     ).
     2446   if p-open-query then do:
     2447       run set-filter-name in this-procedure
     2448         (INPUT filter-name-13
     2449         ) no-error .
     2450     assign
     2451       l-filter-open-13 = false
     2452     .
     2453     if flt-rec-13 <> ?
     2454       or sort-column-phrase > ""
     2455     then do:
     2456       define variable  parameter-2-13 as character no-undo .
     2457       define variable  parameter-3-13 as character no-undo .
     2458       define variable  parameter-4-13 as character no-undo .
     2459       define variable  parameter-5-13 as character no-undo .
     2460       define variable  parameter-6-13 as character no-undo .
     2461       define variable  parameter-7-13 as character no-undo .
     2462         assign
     2463         parameter-3-13 =
     2464                                 "FOR EACH buf_c-qnty-group"
     2465         parameter-4-13 =
     2466           (
     2467             if (" buf_c-qnty-group.qgr-id = par-qgr-id and buf_c-qnty-group.qgr-db-num = par-qgr-db-num " + " " + where-phrase-13) <> ""
     2468             then  substitute (' buf_c-qnty-group.qgr-id = &1 and buf_c-qnty-group.qgr-db-num = &2 ', par-qgr-id, par-qgr-db-num )  + " " + where-phrase-13
     2469             else "true"
     2470           )
     2471         parameter-5-13 = (" " + "" + " " + "")
     2472         parameter-6-13 = if sort-phrase-13 = ''
     2473                              then
     2474           (
     2475           " " + "  " +
     2476             " " + sort-column-phrase +
     2477           " " + "  "
     2478           )
     2479                              else
     2480           (
     2481           " " + "  " +
     2482             " " + sort-column-phrase +
     2483           " " + sort-phrase-13
     2484           )
     2485         parameter-7-13 =
     2486           " indexed-reposition  "
     2487       .
     2488       do
     2489       on stop undo, leave
     2490       on error undo, leave
     2491       :
     2492         assign
     2493           l-disable-where-13 =
     2494             (" buf_c-qnty-group.qgr-id = par-qgr-id and buf_c-qnty-group.qgr-db-num = par-qgr-db-num " + " " + where-phrase-13 = "")
     2495         .
     2496         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2497                             ,input query br-docs:handle
     2498                             ,input parameter-3-13
     2499                             ,input parameter-4-13
     2500                             ,input parameter-5-13
     2501                             ,input parameter-6-13
     2502                             ,input parameter-7-13
     2503                             )
     2504         .
     2505         assign
     2506           l-filter-open-13 = true
     2507         .
     2508       end.
     2509       if l-filter-open-13 = false then do:
     2510         message
     2511           "Ошибка при фильтрации / сортировке" skip
     2512           "Будут показаны записи без учета фильтра" skip
     2513           view-as alert-box .
     2514       end.
     2515       else do:
     2516           assign
     2517             l-query-was-opened = true
     2518           .
     2519       end.
     2520     end.
     2521     if l-filter-open-13 = false then do:
     2522       OPEN QUERY br-docs FOR EACH buf_c-qnty-group
     2523         where  buf_c-qnty-group.qgr-id = par-qgr-id and buf_c-qnty-group.qgr-db-num = par-qgr-db-num
     2524         indexed-reposition
     2525     .
     2526         assign
     2527           l-query-was-opened = true
     2528         .
     2529     end.
     2530   end.
     2531   else do:
     2532     assign
     2533       doc-rec = recid( buf_c-qnty-group )
     2534     .
     2535     do
     2536     on stop undo, leave
     2537     on error undo, leave
     2538     :
     2539       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_c-qnty-group:handle) then do:
     2540         assign
     2541         parameter-2-13 = (if p-find-next then "true":u else "false":u )
     2542         parameter-4-13 =
     2543           "where ":u +  substitute (' buf_c-qnty-group.qgr-id = &1 and buf_c-qnty-group.qgr-db-num = &2 ', par-qgr-id, par-qgr-db-num )  + " ":u + where-phrase-13 + " ":u + p-find-condition + " " + ""
     2544         parameter-5-13 = "  "
     2545       .
     2546         run fltopend_fltfindd in this-procedure  (
     2547                             input this-procedure:handle
     2548                             ,input query br-docs:handle
     2549                             ,input rowid(buf_c-qnty-group)
     2550                             ,input logical(parameter-2-13)
     2551                             ,input no-lock
     2552                             ,input (buffer buf_c-qnty-group:handle)
     2553                             ,input parameter-4-13
     2554                             ,input parameter-5-13
     2555                             ) no-error.
     2556         .
     2557         assign
     2558           doc-rec = integer(return-value)
     2559           v-fltopend-rowid[1] = ?
     2560         .
     2561       end.
     2562       else do:
     2563         assign
     2564         parameter-2-13 = (if p-find-next then "true":u else "false":u )
     2565         parameter-3-13 =  "FOR EACH buf_c-qnty-group"
     2566         parameter-4-13 =
     2567           (
     2568             if (" buf_c-qnty-group.qgr-id = par-qgr-id and buf_c-qnty-group.qgr-db-num = par-qgr-db-num " + " " + where-phrase-13) <> ""
     2569             then  substitute (' buf_c-qnty-group.qgr-id = &1 and buf_c-qnty-group.qgr-db-num = &2 ', par-qgr-id, par-qgr-db-num )  + " " + where-phrase-13
     2570             else "true"
     2571           )
     2572         parameter-5-13 = (" " + "" + " " + "" + " " + p-find-condition)
     2573         parameter-6-13 = if sort-phrase-13 = ''
     2574                              then
     2575           (
     2576           " " + "  " +
     2577             " " + sort-column-phrase +
     2578           " " + "  "
     2579           )
     2580                              else
     2581           (
     2582           " " + "  " +
     2583             " " + sort-column-phrase +
     2584           " " + sort-phrase-13
     2585           )
     2586         parameter-7-13 =
     2587           " indexed-reposition  "
     2588       .
     2589         run fltopend_fltfindq in this-procedure  (
     2590                             input this-procedure:handle
     2591                             ,input query br-docs:handle
     2592                             ,input logical(parameter-2-13)
     2593                             ,input no-lock
     2594                             ,input parameter-3-13
     2595                             ,input parameter-4-13
     2596                             ,input parameter-5-13
     2597                             ,input parameter-6-13
     2598                             ,input parameter-7-13
     2599                             ,output v-fltopend-rowid
     2600                             ) no-error.
     2601         .
     2602         doc-rec = ?.
     2603       end.
     2604       assign
     2605         l-query-was-opened = true
     2606       .
     2607     end.
     2608   end.
     2609   if not p-open-query then
     2610   REPOSITION br-docs to recid doc-rec No-ERROR.
     2611   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     2612   APPLY "ENTRY" TO br-docs.
     2613   END PROCEDURE.
     2614   PROCEDURE proc-b-sch :
     2615   assign
     2616     tbl = 'c-qnty-group'
     2617     join-tbl = 'buf_c-qnty-group'
     2618     fld = ""
     2619     lab = ""
     2620     spr = ""
     2621     dim = '0'
     2622     .
     2623   run fltfield-add in this-procedure('qgr-id', 'Внутр.№', '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2624   run fltfield-add in this-procedure('who', '', 'usr', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2625   run fltfield-add in this-procedure('corr-user-name', '', 'usr', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2626   Filter-Block:
     2627   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     2628       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     2629       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     2630     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     2631     run openbr (yes, no, '':u).
     2632   END.
     2633   END PROCEDURE.
     2634   PROCEDURE proc-find-code :
     2635   define input parameter par-next as logical no-undo.
     2636   define input parameter parqgr-id as char no-undo.
     2637   END PROCEDURE.
     2638   PROCEDURE proc-view-changes :
     2639   define buffer old_c-qnty-group   for ub.c-qnty-group.
     2640   define buffer current_qnty-group for ub.qnty-group.
     2641   define variable v-chg-fields as character no-undo.
     2642   define variable v-old-fields as character no-undo.
     2643   define variable v-new-fields as character no-undo.
     2644   define variable ii as integer no-undo.
     2645   for each temp-changes:
     2646       delete temp-changes.
     2647   END.
     2648   if not available buf_c-qnty-group then do:
     2649     open query br-changes for each temp-changes.
     2650     return.
     2651   end.
     2652   find first old_c-qnty-group no-lock where
     2653              old_c-qnty-group.qgr-id      = buf_c-qnty-group.qgr-id and
     2654              old_c-qnty-group.qgr-db-num  = buf_c-qnty-group.qgr-db-num and
     2655              old_c-qnty-group.chip-num  <   buf_c-qnty-group.chip-num no-error.
     2656   if not available old_c-qnty-group then do:
     2657           find first current_qnty-group no-lock where
     2658                      current_qnty-group.qgr-id      = buf_c-qnty-group.qgr-id and
     2659                      current_qnty-group.qgr-db-num  = buf_c-qnty-group.qgr-db-num
     2660                      no-error.
     2661           if not available current_qnty-group then do:
     2662               return error.
     2663           end.
     2664           buffer-compare current_qnty-group  to buf_c-qnty-group
     2665           save result in v-chg-fields.
     2666   end.
     2667   else do:
     2668       buffer-compare old_c-qnty-group except chip-num corr-date corr-time corr-user-name corr-user-db-num to buf_c-qnty-group
     2669       save result in v-chg-fields.
     2670   end.
     2671   if num-entries(v-chg-fields) > 0 then do:
     2672   do ii = 1 to num-entries(v-chg-fields):
     2673   CASE entry(ii, v-chg-fields):
     2674    when "db-num-chg":U then do:     create temp-changes.       assign         temp-changes.f_name = "db-num-chg":U         temp-changes.l_name = "БД изм."         temp-changes.v_new  = string(buf_c-qnty-group.db-num-chg)         temp-changes.v_old  = (if available old_c-qnty-group                                  then string(old_c-qnty-group.db-num-chg)                                  else "Создание шапки" )         .   end.
     2675   when "name":U then do:     create temp-changes.       assign         temp-changes.f_name = "name":U         temp-changes.l_name = "Наименование"         temp-changes.v_new  = string(buf_c-qnty-group.name)         temp-changes.v_old  = (if available old_c-qnty-group                                  then string(old_c-qnty-group.name)                                  else "Создание шапки" )         .   end.
     2676    when "qgr-db-num":U then do:     create temp-changes.       assign         temp-changes.f_name = "qgr-db-num":U         temp-changes.l_name = "ДБ "         temp-changes.v_new  = string(buf_c-qnty-group.qgr-db-num)         temp-changes.v_old  = (if available old_c-qnty-group                                  then string(old_c-qnty-group.qgr-db-num)                                  else "Создание шапки" )         .   end.
     2677    when "qgr-id":U then do:     create temp-changes.       assign         temp-changes.f_name = "qgr-id":U         temp-changes.l_name = "№ группы"         temp-changes.v_new  = string(buf_c-qnty-group.qgr-id)         temp-changes.v_old  = (if available old_c-qnty-group                                  then string(old_c-qnty-group.qgr-id)                                  else "Создание шапки" )         .   end.
     2678    when "stts":U then do:     create temp-changes.       assign         temp-changes.f_name = "stts":U         temp-changes.l_name = "Статус"         temp-changes.v_new  = string(buf_c-qnty-group.stts)         temp-changes.v_old  = (if available old_c-qnty-group                                  then string(old_c-qnty-group.stts)                                  else "Создание шапки" )         .   end.
     2679    when "sys-date":U then do:     create temp-changes.       assign         temp-changes.f_name = "sys-date":U         temp-changes.l_name = "Дата"         temp-changes.v_new  = string(buf_c-qnty-group.sys-date)         temp-changes.v_old  = (if available old_c-qnty-group                                  then string(old_c-qnty-group.sys-date)                                  else "Создание шапки" )         .   end.
     2680    when "sys-time-chr":U then do:     create temp-changes.       assign         temp-changes.f_name = "sys-time-chr":U         temp-changes.l_name = "Время"         temp-changes.v_new  = string(buf_c-qnty-group.sys-time-chr)         temp-changes.v_old  = (if available old_c-qnty-group                                  then string(old_c-qnty-group.sys-time-chr)                                  else "Создание шапки" )         .   end.
     2681    when "sys-time":U then do:     create temp-changes.       assign         temp-changes.f_name = "sys-time":U         temp-changes.l_name = "Время (int)"         temp-changes.v_new  = string(buf_c-qnty-group.sys-time)         temp-changes.v_old  = (if available old_c-qnty-group                                  then string(old_c-qnty-group.sys-time)                                  else "Создание шапки" )         .   end.
     2682    when "who":U then do:     create temp-changes.       assign         temp-changes.f_name = "who":U         temp-changes.l_name = "Кто"         temp-changes.v_new  = string(buf_c-qnty-group.who)         temp-changes.v_old  = (if available old_c-qnty-group                                  then string(old_c-qnty-group.who)                                  else "Создание шапки" )         .   end.
     2683   END CASE.
     2684   end.
     2685   end.
     2686   define buffer old_c-qnty-in-qnty-group for ub.c-qnty-in-qnty-group  .
     2687   for each ub.c-qnty-in-qnty-group where
     2688            ub.c-qnty-in-qnty-group.qgr-id      = buf_c-qnty-group.qgr-id     and
     2689            ub.c-qnty-in-qnty-group.qgr-db-num  = buf_c-qnty-group.qgr-db-num and
     2690            ub.c-qnty-in-qnty-group.chip-num    = buf_c-qnty-group.chip-num
     2691            :
     2692        find first old_c-qnty-in-qnty-group no-lock where
     2693            old_c-qnty-in-qnty-group.qgr-id      = ub.c-qnty-in-qnty-group.qgr-id    and
     2694            old_c-qnty-in-qnty-group.qgr-db-num  = ub.c-qnty-in-qnty-group.qgr-db-num and
     2695            old_c-qnty-in-qnty-group.ggr-qnty  = ub.c-qnty-in-qnty-group.ggr-qnty     and
     2696            old_c-qnty-in-qnty-group.chip-num    < ub.c-qnty-in-qnty-group.chip-num
     2697            use-index pi no-error .
     2698            if available old_c-qnty-in-qnty-group then do:
     2699               buffer-compare old_c-qnty-in-qnty-group except chip-num corr-date corr-time corr-user-name corr-user-db-num  to ub.c-qnty-in-qnty-group
     2700               save result in v-chg-fields.
     2701            end.
     2702     IF num-entries(v-chg-fields) = 0 THEN DO:
     2703       create temp-changes.
     2704         assign
     2705           temp-changes.f_name = "Summa" + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "ADD":U
     2706           temp-changes.l_name = "Доб.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty )
     2707           temp-changes.v_new  = ""
     2708           temp-changes.v_old  = ""
     2709         .
     2710     END.
     2711       do ii = 1 to num-entries(v-chg-fields):
     2712         CASE entry(ii, v-chg-fields):
     2713                           when "ggr-qnty":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "ggr-qnty":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "Кол-во"         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.ggr-qnty)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.ggr-qnty)                                  else "" )       .   end.
     2714                           when "qgr-db-num":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "qgr-db-num":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "БД "         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.qgr-db-num)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.qgr-db-num)                                  else "" )       .   end.
     2715                           when "qgr-id":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "qgr-id":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "№ "         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.qgr-id)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.qgr-id)                                  else "" )       .   end.
     2716                           when "stts":U then do:     if ub.c-qnty-in-qnty-group.stts = 1 then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "stts":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "Статус строки"         temp-changes.v_new = "удален"         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then "текущий"                                 else "" )       .      end.     if ub.c-qnty-in-qnty-group.stts = 0 then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "stts":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "Статус строки"         temp-changes.v_new = "текущий"         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then "удален"                                 else "" )       .      end.   end.
     2717                           when "db-num-chg":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "db-num-chg":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "БД"         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.db-num-chg)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.db-num-chg)                                  else "" )       .   end.
     2718                           when "method-round":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "method-round":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "Метод округления"         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.method-round)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.method-round)                                  else "" )       .   end.
     2719                           when "discnt-pc":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "discnt-pc":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "% скидки"         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.discnt-pc)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.discnt-pc)                                  else "" )       .   end.
     2720                           when "sys-date":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "sys-date":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "Дата"         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.sys-date)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.sys-date)                                  else "" )       .   end.
     2721                           when "sys-time-chr":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "sys-time-chr":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "Время"         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.sys-time-chr)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.sys-time-chr)                                  else "" )       .   end.
     2722                           when "sys-time":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "sys-time":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "Время (int)"         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.sys-time)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.sys-time)                                  else "" )       .   end.
     2723                           when "use-discnt":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "use-discnt":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "Есть скидка"         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.use-discnt)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.use-discnt)                                  else "" )       .   end.
     2724                           when "who":U then do:     create temp-changes.       assign         temp-changes.f_name ="Summa"  + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + "who":U         temp-changes.l_name ="Изм.Кол-во-"   + string(ub.c-qnty-in-qnty-group.ggr-qnty ) + " " + "Кто"         temp-changes.v_new = string(ub.c-qnty-in-qnty-group.who)         temp-changes.v_old =  (if available old_c-qnty-in-qnty-group                                  then string(old_c-qnty-in-qnty-group.who)                                  else "" )       .   end.
     2725         end case.
     2726       end.
     2727   end.
     2728   Open QUery br-changes for each temp-changes.
     2729   END PROCEDURE.
     2730   PROCEDURE set-filter-name :
     2731   define input parameter p-filter-name as character no-undo .
     2732     do with frame Dialog-Frame:
     2733       if p-filter-name > "" then do:
     2734         assign
     2735           frame Dialog-Frame:title
     2736             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2737         .
     2738         assign
     2739           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     2740         .
     2741       end.
     2742       else do:
     2743         assign
     2744           b-sch :TOOLTIP = ""
     2745         .
     2746       end.
     2747     end.
     2748   END PROCEDURE.
