     1347         (input  (p-new-height - frame Dialog-Frame :height)
     1348         ,input  p-move-resize
     1349         ) .
     1350     end.
     1351   end procedure.
     1352   procedure diasize_change-width :
     1353     define input  parameter p-change-value as decimal   no-undo .
     1354     define input  parameter p-move-resize  as logical   no-undo .
     1355     define variable v-field-group-handle   as handle    no-undo .
