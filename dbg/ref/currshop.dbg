      787   ON VALUE-CHANGED OF br-currency IN FRAME Dialog-Frame
      788   DO:
      789     define variable v-today as date      no-undo.
      790     define variable v-time  as integer   no-undo.
      791     define buffer buf_curr-bank for ub.curr-bank.
      792     OPEN QUERY BR-curr-shop FOR EACH X_curr-shop       WHERE X_curr-shop.obj-type = p-obj-type  AND X_curr-shop.obj-code = p-obj-code  AND X_curr-shop.curr-code = X_currency.curr-code NO-LOCK     BY X_curr-shop.exch-date DESCENDING      BY X_curr-shop.exch-time DESCENDING INDEXED-REPOSITION.
      793     if not avail X_curr-shop then do:
      794     END.
      795     if available X_curr-shop then do:
      796       assign
      797      log-res = br-curr-shop:select-row( 1 )
      798       .
      799     end.
      800   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      802     (input  p-obj-type
      803     ,input  p-obj-code
      804     ,output v-today
      805     )  .
      806     FIND LAST buf_curr-bank WHERE
      807              buf_curr-bank.curr-code = X_curr-shop.curr-code
      808          AND buf_curr-bank.exch-date <= v-today No-LOCK NO-ERROR.
      809     IF avail buf_curr-bank then do:
      810       assign
      811       f-curr-bank-rate = buf_curr-bank.exch-rate
      812       f-curr-bank-scale = buf_curr-bank.exch-scale
      813       .
      814       DISPLAY
      815       f-curr-bank-rate
      816       f-curr-bank-scale
      817       with frame Dialog-Frame.
      818     end.
      819     else do:
      820       assign
      821       f-curr-bank-rate = 0
      822       f-curr-bank-scale = 0
      823       .
      824       HIDE
      825       f-curr-bank-rate f-curr-bank-scale
      826       in frame Dialog-Frame.
      827     end.
      828   END.
      829   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      830   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      831   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   on help of frame Dialog-Frame
      833   do:
      834     run gbl/app_help.p
      835       (input this-procedure :file-name
      836       ,input ''
      837       ,input ?
      838       ) no-error.
      839     if error-status :error then do:
      840       message
      841         "Ошибка при вызове помощи"
      842         error-status :get-message(1)
      843         view-as alert-box .
      844     end.
      845   end.
      846   run minbtn-set in this-procedure .
      847   on choose of b-help in frame Dialog-Frame
      848   do:
      849     apply "help":u to frame Dialog-Frame .
      850   end.
      851   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852   procedure minbtn-set :
      853       do
      854           on error undo, return error return-value
      855           :
      856           define variable ii              as integer       no-undo .
      857           define variable fh              as widget-handle no-undo .
      858           define variable hh              as widget-handle no-undo .
      859           define variable v-h             as handle        extent 4 no-undo .
      860           define variable v-name-button   as character     no-undo .
      861           define variable v-help-old-x    as decimal       no-undo .
      862           define variable v-help-old-y    as decimal       no-undo .
      863           define variable v-help-old-size as decimal       no-undo .
      864           define variable v-frame-width   as decimal       no-undo .
      865           define variable jj              as integer       no-undo .
      866           do
      867               on error undo, return error
      868               :
      869               assign
      870                   v-frame-width = frame Dialog-Frame:width - 0.3
      871                   fh            = frame Dialog-Frame:first-child
      872                   hh            = fh:first-child
      873                   ii            = 1
      874                   .
      875               do while valid-handle(hh):
      876                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      877                   do:
      878                       case lc(hh:name) :
      879                           when "b-help" then
      880                               do:
      881                                   hh:load-image-up("cmp/b-help.bmp":u) .
      882                                   hh:load-image-down("cmp/b-help.bmp":u) .
      883                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      884                                   hh:TOOLTIP = "Помощь" .
      885                                   v-help-old-x = hh:column .
      886                                   v-help-old-y = hh:row    .
      887                                   v-help-old-size = hh:width .
      888                                   hh:width-chars = 2.5 .
      889                               end.
      890                           when "b-print" then
      891                               do:
      892                                   hh:load-image("cmp/b-print.bmp":u) .
      893                                   hh:TOOLTIP = "Печать" .
      894                                   v-h[ii] = hh:handle .
      895                                   ii = ii + 1 .
      896                                   hh:width-chars = 3 .
      897                               end.
      898                           when "b-history" or
      899                           when "b-hist" then
      900                               do:
      901                                   hh:load-image("cmp/b-hist.bmp":u) .
      902                                   hh:TOOLTIP = "История" .
      903                                   v-h[ii] = hh:handle .
      904                                   ii = ii + 1 .
      905                                   hh:width-chars = 3 .
      906                               end.
      907                           when "b-sch" then
      908                               do:
      909                                   hh:load-image("cmp/b-sch.bmp":u) .
      910                                   hh:TOOLTIP = "Установка Фильтра" .
      911                                   v-h[ii] = hh:handle .
      912                                   ii = ii + 1 .
      913                                   hh:width-chars = 3 .
      914                               end.
      915                           when "b-hist-user" then
      916                               do:
      917                                   hh:load-image("cmp/b-hist.bmp":u) .
      918                                   hh:TOOLTIP = "История пользователя" .
      919                                   ii = ii + 1 .
      920                               end.
      921                       end case.
      922                   end.
      923                   hh = hh:next-sibling.
      924               end.
      925               b-help:column = v-frame-width - b-help:width-chars.
      926               jj = 0.
      927               repeat ii = 4 to 1 by -1 :
      928                   if valid-handle (v-h[ii] ) then
      929                   do:
      930                       jj  = jj + 1 .
      931                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      932                       v-h[ii]:row    = v-help-old-y .
      933                   end.
      934               end.
      935           end.
      936       end.
      937   end procedure.
      938   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      939   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      940   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      941   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      942   define variable v-diasize-current-frame-width  as decimal   no-undo .
      943   define variable v-diasize-current-frame-height as decimal   no-undo .
      944   define variable v-diasize-change-size          as logical   no-undo .
      945   define variable v-diasize-resize-button        as handle    no-undo .
      946   define variable v-diasize-wndmax               as logical   no-undo .
      947   define variable v-diasize-wndstore             as logical   no-undo .
      948   define variable v-diasize-proc-name            as character no-undo .
      949   define variable v-diasize-browse-handle        as handle    no-undo .
      950   define variable v-diasize-browse-number        as integer   no-undo .
      951   define variable v-diasize-need-full-display    as logical   no-undo init false .
      952   define temp-table temp-diasize-handle no-undo
      953     field handle-value  as handle
      954     field save-position as decimal
      955     index xpk is primary unique handle-value
      956     .
      957   define temp-table temp-browse-handle no-undo
      958     field browse-type   as character
      959     field browse-number as integer
      960     field browse-handle as handle
      961     field original-size as decimal
      962     index xpk is primary unique browse-type browse-number
      963     index xie browse-type browse-handle
      964   .
      965   procedure diasize_change-height :
      966     define input  parameter p-change-value  as decimal   no-undo .
      967     define input  parameter p-move-resize   as logical   no-undo .
      968     define variable v-field-group-handle    as handle    no-undo .
      969     define variable v-object-handle         as handle    no-undo .
      970     define variable v-frame-height          as decimal   no-undo .
      971     define variable v-frame-virtual-height  as decimal   no-undo .
      972     define variable v-browse-height         as decimal   no-undo .
      973     define variable v-window-height         as decimal   no-undo .
      974     define variable v-window-virtual-height as decimal   no-undo .
      975     define variable v-change-sign           as integer   no-undo .
      976     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      977     define buffer buf_temp-browse-handle  for temp-browse-handle .
      978     if p-change-value > 0
      979     then do:
      980       if frame Dialog-Frame :height + p-change-value
      981           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      982       then do:
      983         assign
      984           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      985                           - (frame Dialog-Frame :height-chars)
      986         .
      987         if p-change-value <= 0
      988         then do:
      989           run diasize_position-resize-button in this-procedure .
      990           return .
      991         end.
      992       end.
      993     end.
      994     if p-change-value < 0
      995     then do:
      996       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      997       then do:
      998         assign
      999           p-change-value = v-diasize-orig-frame-height
     1000                          - (frame Dialog-Frame :height-chars)
     1001         .
     1002         if p-change-value >= 0
     1003         then do:
     1004           run diasize_position-resize-button in this-procedure .
     1005           return .
     1006         end.
     1007       end.
     1008     end.
     1009     if p-change-value >= 0
     1010     then do:
     1011       assign
     1012         v-change-sign = 1
     1013       .
     1014     end.
     1015     else do:
     1016       assign
     1017         v-change-sign = -1
     1018       .
     1019     end.
     1020     assign
     1021       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1022     .
     1023     if p-change-value = 0
     1024     then do:
     1025       run diasize_position-resize-button in this-procedure .
     1026       return .
     1027     end.
     1028     move_block:
     1029     do
     1030     on error undo move_block, retry move_block
     1031     :
     1032       if retry
     1033       then do:
     1034         do
     1035         on error undo move_block, leave move_block
     1036         :
     1037           if p-change-value > 0
     1038           then do:
     1039             for each buf_temp-diasize-handle
     1040             on error undo, next
     1041             :
     1042               assign
     1043                 v-object-handle = buf_temp-diasize-handle.handle-value
     1044               .
     1045               if v-object-handle <> v-diasize-resize-button
     1046               then do:
     1047                 assign
     1048                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1049                 .
     1050               end.
     1051             end.
     1052             assign
     1053               v-diasize-browse-handle :height = v-browse-height
     1054             .
     1055             for each buf_temp-browse-handle
     1056               where buf_temp-browse-handle.browse-type = 'height':u
     1057             on error undo, next
     1058             :
     1059               assign
     1060                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1061               .
     1062             end.
     1063             assign
     1064               frame Dialog-Frame :height = v-frame-height
     1065             .
     1066             if frame Dialog-Frame :scrollable = true
